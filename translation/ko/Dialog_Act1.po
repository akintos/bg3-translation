msgctxt "h572b168agcd0eg45a8g8606gf874f155f59b"
msgid "Something's rotten about this."
msgstr "뭔가 구린 냄새가 나는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton
#. Speaker = Barton
#. NodeID = 2cc320c9-ad75-4fd3-88c6-79e1de1c925e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_A = True
#. SetFlags:
#.   Local:
#.     - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton:2cc320c9-ad75-4fd3-88c6-79e1de1c925e
msgctxt "h8aa4aae0g1773g4c62g8a75g88c64f2bce08"
msgid "Whoever's skulking about - show yourself!"
msgstr "누군진 몰라도 이제 그만 나타나시지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton
#. Speaker = Barton
#. NodeID = 9b407f7b-d874-4e84-a8b0-6aa469d384e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_B = True
#. SetFlags:
#.   Local:
#.     - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton:9b407f7b-d874-4e84-a8b0-6aa469d384e9
msgctxt "h06a1261cg28dcg4821ga492gff94e8921855"
msgid "Hells. Where's Gimblebock and the others?"
msgstr "망할. 김블보크랑 딴 녀석들은 어디로 샌 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton
#. Speaker = Barton
#. NodeID = b3083cbe-76d0-4a84-8b32-a34aa0803a5a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton:b3083cbe-76d0-4a84-8b32-a34aa0803a5a
msgctxt "h6b5ee901g6941g4420g8c8cgb7266a5f15f2"
msgid "Something's wrong."
msgstr "뭔가 잘못됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton
#. Speaker = Barton
#. NodeID = b38bd0a6-74fd-4f6c-b7bb-ad263b68b4ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_C = True
#. SetFlags:
#.   Local:
#.     - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_B = False
#.     - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_C = False
#.     - b2a52f0b-5fa8-d275-f080-0fc8edbe1faf_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert_OnlyBarton:b38bd0a6-74fd-4f6c-b7bb-ad263b68b4ed
msgctxt "h2ff8383cgcce5g4787g8f5fg691cdf52b5c8"
msgid "Got to keep my eyes peeled."
msgstr "두 눈 똑똑히 뜨고 있어야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalInsideTomb
#. Speaker = Richly Adorned Sarcophagus
#. NodeID = 763d2f35-7479-ce8d-eeb4-0db9955a256c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalInsideTomb:763d2f35-7479-ce8d-eeb4-0db9955a256c
msgctxt "h676d86afge43fg4236gae60g3c18ab06bf3a"
msgid "Dost thou think to rush fate? See to the dead first."
msgstr "어이하여 운명을 그리 서두르는가? 먼저 죽은 이를 처리토록 하여라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering
#. Speaker = Withers
#. NodeID = 74e50b8a-810f-eea7-d239-b9650fa3030c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bcbd9a44-62a4-994e-5a04-748aa51666e4_B = True
#. SetFlags:
#.   Local:
#.     - bcbd9a44-62a4-994e-5a04-748aa51666e4_A = False
#.     - bcbd9a44-62a4-994e-5a04-748aa51666e4_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering:74e50b8a-810f-eea7-d239-b9650fa3030c
msgctxt "h7b9cf2e1g6181g4d0aga022g2cb0beb3b6f8"
msgid "What a mess the ages cause."
msgstr "세월이 참 엉망으로 만들어놓았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering
#. Speaker = Withers
#. NodeID = a9949721-327b-4ada-1596-25a1dca5826e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CHA_Crypt_Event_JergalTalksToSkeleton(0) = True
#. SetFlags:
#.   Object:
#.     - CHA_Crypt_Event_JergalTalksToSkeleton(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering:a9949721-327b-4ada-1596-25a1dca5826e
msgctxt "h56e21a45g9e03g4448g9f9cga5a84c9a9084"
msgid "These chambers are much changed."
msgstr "방들의 모습이 무척 많이 바뀌었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering
#. Speaker = Withers
#. NodeID = b36e908a-e2fc-3c18-f60e-d26a64d6cdcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bcbd9a44-62a4-994e-5a04-748aa51666e4_A = True
#. SetFlags:
#.   Local:
#.     - bcbd9a44-62a4-994e-5a04-748aa51666e4_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering:b36e908a-e2fc-3c18-f60e-d26a64d6cdcb
msgctxt "h700e7fb9g895cg4596gbf37ge5c98d349655"
msgid "Parchment and bone dust. Still comforting after all this time."
msgstr "양피지와 뼛가루라. 시간이 이리 흘렀어도 마음이 포근해지는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering
#. Speaker = Withers
#. NodeID = c36fa8f0-659b-e0b9-b062-829d8e33aee0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - bcbd9a44-62a4-994e-5a04-748aa51666e4_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_JergalWandering:c36fa8f0-659b-e0b9-b062-829d8e33aee0
msgctxt "h2ab8d1c5ga9e4g4964ga847g58bd9601d9ff"
msgid "How long <i>has</i> it been?"
msgstr "시간이 <i>얼마나</i> 흐른 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_UpDownDoorInvestigation
#. Speaker = Player
#. NodeID = 0ebde151-56c3-d8cb-d537-8ee1cd4042f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_UpDownDoorInvestigation:0ebde151-56c3-d8cb-d537-8ee1cd4042f6
msgctxt "h8f3d14f9g8103g4ea5ga358g11d718627536"
msgid "No lock, no handle. How does it open?"
msgstr "자물쇠도, 손잡이도 없어. 이걸 어떻게 열지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 0061e997-bcf2-d455-5695-5ba83c99a92d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:0061e997-bcf2-d455-5695-5ba83c99a92d
msgctxt "h6bf7a06cg4ce0g4f51g8055ge409481dc78c"
msgid "Coward. Stand and fight me!"
msgstr "겁쟁이 자식. 나랑 맞서 싸워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 08b8c780-6aca-49e8-aca7-d421840929ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:08b8c780-6aca-49e8-aca7-d421840929ff
msgctxt "he67f0ca3g6d1ag4d00gba2fg9ee37dc8ce13"
msgid "'So he has spoken'? What 'he' are you talking about?"
msgstr "'그가 말했던 대로' 라니? '그'가 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 10f63860-fca0-c1ce-fa7c-08a990b1d163
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:10f63860-fca0-c1ce-fa7c-08a990b1d163
msgctxt "h5af3fd08gea03g4382g9013gbe8c12a4ef9c"
msgid "Because that would be senseless."
msgstr "그건 무의미한 짓이기 때문이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 12119c3a-6744-119d-0bd9-e00ffdb9c1e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:12119c3a-6744-119d-0bd9-e00ffdb9c1e0
msgctxt "h46b39982gf9f2g40a2g83dbg12d082d6f143"
msgid "Fate has not declared mine injury. Therefore, it shall not occur."
msgstr "운명은 내가 위해를 받으리라 선언치 않았다. 그러니, 그런 일은 생기지 않을 터."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 1fccb943-9230-83b3-324e-b55454edb155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:1fccb943-9230-83b3-324e-b55454edb155
msgctxt "hcdd9891agc650g48fegaaa9gabd64a4bd15d"
msgid "We have met and I know thy face."
msgstr "우리는 만났고, 나는 그대의 얼굴을 익혔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 24d4ff76-70d8-f818-2c78-e561033335a4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_KELEMVOR or PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:24d4ff76-70d8-f818-2c78-e561033335a4
msgctxt "h17ffe960g9719g4050g90d3g904c57025df2"
msgid "You feel familiar. Do I know you?"
msgstr "댁이 익숙하게 느껴지는데. 내가 댁을 아는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 2880eb83-b740-fbdc-950d-919f1502e428
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:2880eb83-b740-fbdc-950d-919f1502e428
msgctxt "h13b86794ge13ag4625ga61ega545db3eb601"
msgid ""
"Now I have a question for thee: what is the worth of a single mortal's life?"
msgstr "그대에게 질문이 있다. 필멸자 하나의 생명은 가치가 얼마나 된다고 여기는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 2a4b5ddf-80a8-4c7b-d164-e785df44c3ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CHA_Jergal_Event_AttemptedAttack(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:2a4b5ddf-80a8-4c7b-d164-e785df44c3ec
msgctxt "hf5e5d006g4b32g45bfg8b17ga13928a0477e"
msgid "I don't owe you answers."
msgstr "내가 굳이 답해줄 의무는 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 35ed348b-9883-98c2-66ec-2b7d786473d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:35ed348b-9883-98c2-66ec-2b7d786473d6
msgctxt "hc840964dga69cg4878g9563g61c66aefbacc"
msgid "Some do, yes."
msgstr "어떤 이들은 그렇지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 3eef52aa-39c8-36d8-347b-4ec83db59757
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:3eef52aa-39c8-36d8-347b-4ec83db59757
msgctxt "h7ee49cfcg8a88g4571g93d4gc4e1f65e9c04"
msgid "Quite the question. What's the reason for it?"
msgstr "꽤나 거창한 질문인걸. 그런 건 왜 묻는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 43cff3af-da7a-506c-7b75-12f27cc91729
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:43cff3af-da7a-506c-7b75-12f27cc91729
msgctxt "hd5a33550g2800g43dagb444g21c73f0b8b6a"
msgid "See what thou hast seen. Know what thou knowest."
msgstr "그대가 본 것을 마주 보고, 안 것을 마주 알거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 4a758527-ac43-b03f-fdac-805d78705c84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:4a758527-ac43-b03f-fdac-805d78705c84
msgctxt "hdaac285egdaeeg426dg8e5cg6a4f99675657"
msgid "Little spooked by the crawling out of the tomb bit. What are you?"
msgstr "무덤에서 기어 나오길래 조금 겁먹었는데 말이야. 당신은 대체 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 4bd30ff7-0fd4-6429-d2ce-5c48e158882e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:4bd30ff7-0fd4-6429-d2ce-5c48e158882e
msgctxt "h121bc434g01ffg47b4gb273g435aabc94a84"
msgid "Wilt thou answer my question?"
msgstr "그대는 내 질문에 답하겠는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 4db773a7-1465-dc64-ae3e-6ea98c44f0ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:4db773a7-1465-dc64-ae3e-6ea98c44f0ca
msgctxt "he97ec26eg269cg4d04g8285gac84968441c7"
msgid "What an imbalance."
msgstr "참으로 부조리하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 4fbba46f-fcc2-6c74-acc1-7eaea566ec09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:4fbba46f-fcc2-6c74-acc1-7eaea566ec09
msgctxt "h229db061ge847g48ecgad6egac178dca8069"
msgid "That depends on a person's deeds."
msgstr "그 사람이 어떤 일을 했느냐에 달렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 5814b9a0-39b8-d8e9-dfdd-de085092cde6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:5814b9a0-39b8-d8e9-dfdd-de085092cde6
msgctxt "h372b9c99gc646g4ce6g85a7g4b8b0a262955"
msgid "In my experience, that depends on what the mortal looks like."
msgstr "내 경험상, 그 필멸자가 어떤 생김새를 하고 있느냐에 달렸더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 66219158-9d45-50da-4cb6-bcf2f7a3df47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:66219158-9d45-50da-4cb6-bcf2f7a3df47
msgctxt "h08fdb493g9089g4c65gad3dg5de63d7d6401"
msgid "That depends on the virtue of the life that is lived."
msgstr "그 생명이 어떤 미덕을 지키며 살았느냐에 달렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 66ba3b47-bf84-15fa-8820-49ea4beaf61f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:66ba3b47-bf84-15fa-8820-49ea4beaf61f
msgctxt "hdfb915f0ga9e6g4ab8g9155g8bbd79465692"
msgid "Can you not be harmed? What magic is this?"
msgstr "해칠 수 없는 존재라도 되는 거야? 대체 뭔 마법을 부린 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 6dd8a66a-e449-4b3d-31b6-7ba6d5191f95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:6dd8a66a-e449-4b3d-31b6-7ba6d5191f95
msgctxt "h3ca486f7gffe8g4145ga34fg8996b1cb5353"
msgid "I am sure thou believest as such."
msgstr "그대라면 확실히 그리 여길 터."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 720a6d3f-3839-149b-447e-6615af8459ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:720a6d3f-3839-149b-447e-6615af8459ea
msgctxt "h6f6cb962g4a9cg4ccfg9760g700b871676a6"
msgid "Some mortals live much longer than others. I can't compare them."
msgstr "어떤 필멸자들은 남들보다 훨씬 오래 살지. 가치를 대조할 부분이 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 7486d0f2-8ae1-3b25-c66a-8b8a856c6f4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:7486d0f2-8ae1-3b25-c66a-8b8a856c6f4a
msgctxt "h18e33c5dg7b10g437bg8ab8g8eab375396be"
msgid "Each life is of infinite value and merits sacrificing everything for."
msgstr "모든 생명은 무궁한 가치를 지니고 있지. 모든 걸 바칠 만한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 762de025-e497-2f89-57b5-b36f1d3aa141
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CHA_Jergal_Event_AttemptedAttack(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:762de025-e497-2f89-57b5-b36f1d3aa141
msgctxt "hfd2db9a0gceadg4f09g8863gb95136186321"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 7ad86e69-e2f3-bfda-9c12-c98c2355162f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYRKUL or PALADIN_MYRKUL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:7ad86e69-e2f3-bfda-9c12-c98c2355162f
msgctxt "h76862e11gfd66g4354gaf3fgd8417ab12272"
msgid "You feel familiar. Do I know you?"
msgstr "댁이 익숙하게 느껴지는데. 내가 댁을 아는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 7db6d0c8-c8c4-db73-07b3-75885a44871a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CHA_Jergal_HasMet(1) = True
#.      - CHA_Jergal_Event_AttemptedAttack(0) = True
#. SetFlags:
#.   Object:
#.     - CHA_Jergal_Event_AttemptedAttack(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:7db6d0c8-c8c4-db73-07b3-75885a44871a
msgctxt "hd5aafa9fgde54g454cg9184g133b7c60f4d7"
msgid "Hast thou finished?"
msgstr "다 끝났는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 7e23fd6b-bc30-733f-1607-a07971d5b92d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:7e23fd6b-bc30-733f-1607-a07971d5b92d
msgctxt "h2f691adegab26g4be4gb2eeg2eca31a78aeb"
msgid "And thus balance is achieved. If all are at war, none can win."
msgstr "그러한 마음가짐이 안정을 이루지. 모두가 전쟁을 벌이면, 승자는 없는 법이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 83cd1b7c-d66a-0a77-f569-79d2758b95b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:83cd1b7c-d66a-0a77-f569-79d2758b95b6
msgctxt "h0cf42654ge74bg4e3dga8d6ge6cc0d8485f0"
msgid "An arbiter of certain matters. But that is not important now."
msgstr "특정한 사안의 중재자다. 하지만 지금 중요한 건 그게 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 84da0526-8016-d71b-9bb6-aead2b59aedd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:84da0526-8016-d71b-9bb6-aead2b59aedd
msgctxt "h45cfe7f3g423dg4859g9101g8b81a328c48a"
msgid "At this particular junction, perhaps that is not so far from the truth."
msgstr "이 특수한 교차점에선, 제법 진리에 가까운 답일지도 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 86f6e73a-930a-fc6a-0901-391821f8685e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:86f6e73a-930a-fc6a-0901-391821f8685e
msgctxt "h2a4ef8e5ge2fag417dg9be1g42765ff09b05"
msgid "A peaceful undead. Interesting. Why aren't you attacking me?"
msgstr "평화로운 언데드라니, 흥미로운데. 왜 나를 공격하지 않는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 874e6c98-6f34-7127-2cc5-8b3723aff178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:874e6c98-6f34-7127-2cc5-8b3723aff178
msgctxt "h81d07a38g8ee8g40bdga5b7gd1c63efde225"
msgid ""
"I am not the same as those thou hast slain, if that is what thou askest."
msgstr "나는 그대가 해치웠던 것들과 같은 존재가 아니니라. 그게 궁금한 거라면 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 8c0b3130-df29-89f6-b799-7960a4b98885
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:8c0b3130-df29-89f6-b799-7960a4b98885
msgctxt "hef5f0d7fg93ceg481ag8500g5de9f2a2d6bf"
msgid "Depends on the mortal."
msgstr "그건 어떤 필멸자인지에 따라 다르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 93ad882a-6a80-40f4-69e2-7a300e80aa3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:93ad882a-6a80-40f4-69e2-7a300e80aa3a
msgctxt "hb9d1f2begc603g4b3agbf0ag84d62513a593"
msgid "What manner of undead are you to ask such a question?"
msgstr "대체 무슨 언데드가 이런 질문을 다 하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 957efc6c-428b-8232-2f90-a3af4d9fb37b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_KELEMVOR or PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:957efc6c-428b-8232-2f90-a3af4d9fb37b
msgctxt "ha9de3dc5g3d19g4079g871ag1fada14b74a5"
msgid ""
"Thou walk with death, child of Kelemvor. That is enough for an understanding "
"between us."
msgstr "그대는 죽음과 함께 거닐잖느냐, 켈렘보르의 아이야. 그 측면에서 헤아리면 족할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 957efc6c-428b-8232-2f90-a3af4d9fb37b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_MYRKUL or PALADIN_MYRKUL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:957efc6c-428b-8232-2f90-a3af4d9fb37b
msgctxt "h0b533354g50b1g463aga2e1g33eab630e6bf"
msgid ""
"Thou walk with death, child of Myrkul. That is enough for an understanding "
"between us."
msgstr "그대는 죽음과 함께 거닐잖느냐, 머큘의 아이야. 그 측면에서 헤아리면 족할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 95c4a7b2-6225-85d3-f755-c50db2ec6c7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:95c4a7b2-6225-85d3-f755-c50db2ec6c7b
msgctxt "hc75f26e6ge41bg40f4g9b37g444aabe39ac4"
msgid "A life is only valuable in service to Vlaakith."
msgstr "오직 블라키스 님을 받드는 생명만이 가치 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 95e5aae1-a024-db8c-50e1-ca8ef009c60a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:95e5aae1-a024-db8c-50e1-ca8ef009c60a
msgctxt "h2d133737g0713g478bg9e18g011c6b122e28"
msgid "Mortals live to die. To be slaughtered."
msgstr "필멸자는 죽기 위해 살아. 살해당하기 위해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 96ad5c00-0e8b-4f7a-d3ea-639618ae71a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:96ad5c00-0e8b-4f7a-d3ea-639618ae71a0
msgctxt "hdeb23960g2b82g4634ga930g9c6d28109404"
msgid "I am curious by what standards thou shalt judge."
msgstr "그대가 어떤 기준으로 그것을 판단할는지 궁금하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = 9a61b0c7-43aa-e374-09f4-0356795fefe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:9a61b0c7-43aa-e374-09f4-0356795fefe4
msgctxt "h085f733egc5f4g4a91gbd74gc8548f4c3772"
msgid "Curiosity. Nothing more."
msgstr "호기심이지. 그저 그뿐이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = 9deabc02-6e5a-e0e8-e12f-ab4761a7b9f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:9deabc02-6e5a-e0e8-e12f-ab4761a7b9f9
msgctxt "h7662b471gb483g46c6g8bb4gbb2769f19a26"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = a0712e60-86f4-4859-6480-dde2e7256557
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:a0712e60-86f4-4859-6480-dde2e7256557
msgctxt "hcfd24bd8g4705g478ag8bb1g4dafa78c1d71"
msgid "Life's only value is as currency. Doesn't matter to me otherwise."
msgstr "내게 생명은 그저 돈으로만 가치 있어. 그 밖에는 아무 의미 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = a162c311-ccf1-0ebd-1ccf-09033efb3f36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:a162c311-ccf1-0ebd-1ccf-09033efb3f36
msgctxt "hb00292deg7f59g4243g98bcg1cc22b1c8b6c"
msgid "A life is worth only as much as the legends remember it."
msgstr "생명의 가치는 얼마나 대단한 전설을 남기느냐에 달려 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = a39b9856-0750-5773-1237-591d720e6cb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:a39b9856-0750-5773-1237-591d720e6cb6
msgctxt "h038193f9g546bg497dg8dbeg3338d5eed6a7"
msgid "Life only has value where Lolth decrees it."
msgstr "생명은 롤쓰께서 점지하신 대로만 가치 있을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = a7ce7610-99c2-88ac-53e2-4dcf87f28d21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:a7ce7610-99c2-88ac-53e2-4dcf87f28d21
msgctxt "h48d8fa1eg0168g4534ga0a9g3454679e7154"
msgid "In death, that is so."
msgstr "죽음 앞에선 실로 그렇지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = ad549213-7e5a-8016-e5b8-4154fa1e509a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:ad549213-7e5a-8016-e5b8-4154fa1e509a
msgctxt "hd9766273g9c5ag41abgacd5g52a65b0badd6"
msgid ""
"Mortal lives are not 'single'. They are part of a greater whole - a path to "
"enlightenment."
msgstr "필멸자의 생명은 '하나'로 취급될 수 없어. 모든 삶은 위대한 전체, 즉 깨달음으로 향하는 여정의 일부지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = afa1bc4c-b15d-ea81-f077-9a644c0022c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:afa1bc4c-b15d-ea81-f077-9a644c0022c3
msgctxt "heb72ee5fg000fg4c94ga71cga071f7263fab"
msgid "<i>Lower your weapon and apologise.</i>"
msgstr "<i>무기를 내리고 사과한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = b003a963-6cca-62cb-263d-5eb3c46d52dc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_Crypt_Event_JergalAppears = True
#.     - GLO_Jergal_State_OutOfTomb = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:b003a963-6cca-62cb-263d-5eb3c46d52dc
msgctxt "hc7cfb6f5g3b4bg4924gb060g05143cee7874"
msgid "So he has spoken, and so thou standest before me. Right as always."
msgstr "그가 말했던 대로, 내 앞에 그대가 서 있구나. 언제나처럼 정확하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = b3f22f54-f0d6-d30d-0061-70fe5f3802d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:b3f22f54-f0d6-d30d-0061-70fe5f3802d1
msgctxt "h3aaa9c08g7444g4b81g944fg3fbed0cbbcdd"
msgid "So I ask again: what is the worth of a single mortal life?"
msgstr "하면 다시 묻겠다. 필멸자 하나의 생명은 얼마나 가치 있는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = babf65d9-01e5-5522-56dc-df03102aefe7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:babf65d9-01e5-5522-56dc-df03102aefe7
msgctxt "hd6bb829eg2880g4863g9e8fg71feb8a92cb3"
msgid "Neither thy outburst nor thy apology is relevant."
msgstr "그대의 돌발 행동도, 사과도 별 의미는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = bb278d60-4f18-f343-a8c8-c8fa5123432d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:bb278d60-4f18-f343-a8c8-c8fa5123432d
msgctxt "hf4a38bf2ga769g49e5gbadfg73e68f86d354"
msgid "Very well. I am satisfied."
msgstr "좋다. 만족스럽구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = bf386621-8897-3435-79cf-10b7b69e82ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - CHA_Chapel.Exit(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:bf386621-8897-3435-79cf-10b7b69e82ae
msgctxt "hadb77fadgaf6ag43cegb3d8gb98c2652e6f3"
msgid "We will see each other again at the proper time and place. Farewell."
msgstr "우리는 적절한 때와 장소에서 다시 만나게 될 것이다. 그럼 이만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = cac59ddf-78ba-5b84-78cf-330f0f902d34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CHA_Jergal_Event_AttemptedAttack(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:cac59ddf-78ba-5b84-78cf-330f0f902d34
msgctxt "h279f4795g1afag44b2gb62eg0e0d5bd2d6fe"
msgid "Dull your weapons as you wish."
msgstr "어디 질릴 만큼 무기를 휘둘러보거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = cfeba90c-ceb4-48d6-df9e-1163cce7706a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:cfeba90c-ceb4-48d6-df9e-1163cce7706a
msgctxt "hb2f53e26g27c2g4f84g92acg91507d240be7"
msgid "Yes, but I imagine it is not the way thee believe."
msgstr "그렇다. 하지만 그대가 여기는 방향으론 아닌 듯싶구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = d70957f1-fdfd-8f99-e977-987423dcf177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:d70957f1-fdfd-8f99-e977-987423dcf177
msgctxt "he2c500fcgc0fbg4badg8590g11c7102d1292"
msgid "Ah, but thou lack a voice to speak. No matter. I have seen enough."
msgstr "아, 그대에겐 낼 목소리가 없군. 상관없다. 본 것만으로도 족하니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = dbda0a7e-c207-ae9e-b47f-9afdb9c2508b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:dbda0a7e-c207-ae9e-b47f-9afdb9c2508b
msgctxt "h1e10eae7g998dg41d2g8304g410f86376eeb"
msgid "It is mortality just the same."
msgstr "그래봤자 필멸자인 건 다 똑같다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = dd03d625-347f-20e7-f753-fb68dc0ce503
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:dd03d625-347f-20e7-f753-fb68dc0ce503
msgctxt "hdd3f573dgecbcg48eagb136g2aa567a60dde"
msgid "What a curious way to awaken."
msgstr "참으로 별난 식으로 깨어나게 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = dd71a0fb-3b3d-3b04-1241-94b4fce59a48
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - CHA_Chapel.Exit(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:dd71a0fb-3b3d-3b04-1241-94b4fce59a48
msgctxt "ha578dbe3gbc34g4b97ga121g2ba19b77ebab"
msgid "We will see each other again at the proper time and place. Farewell."
msgstr "우리는 적절한 때와 장소에서 다시 만나게 될 것이다. 그럼 이만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = e2d6b085-8c79-6668-591f-7841db1a8f1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:e2d6b085-8c79-6668-591f-7841db1a8f1a
msgctxt "h329f52cega7d6g48bcg81f1g40a91174056d"
msgid "The only life that matters is mine."
msgstr "내게 중요한 생명은 오직 내 생명 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = e5ed83a4-ef70-a9f7-ba93-e7661fdda30d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:e5ed83a4-ef70-a9f7-ba93-e7661fdda30d
msgctxt "he9c74f6bg9e59g4182gba91g4b79b74647f4"
msgid "Few strive for such balance. Fewer still achieve it."
msgstr "일부만이 그런 조화를 갈구한다. 그걸 성취하는 이는 더욱 드물고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = e6c04d80-884d-6045-2cb4-975ad1097d1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:e6c04d80-884d-6045-2cb4-975ad1097d1e
msgctxt "h3c954326g5cddg42f3ga23eg75c5369002b7"
msgid "That is true, but matters not."
msgstr "그렇긴 하지. 그래도 상관은 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = e859c93f-ee6d-7f2e-cf03-19046e23de08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:e859c93f-ee6d-7f2e-cf03-19046e23de08
msgctxt "h1b9391e9g6a1cg461ag8e2ag1ca2d0cfcafa"
msgid "A life and how it is lived are different equations."
msgstr "하나의 생명과, 그 삶의 형태는 서로 별개의 문제이니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = ecec4686-8063-a4f0-8b09-8022ead61372
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:ecec4686-8063-a4f0-8b09-8022ead61372
msgctxt "h0011ef07gcf3cg4b9bga0eeg90f1b06f1905"
msgid "Mine seems worth little, as my blood calls me to harm others."
msgstr "내 생명은 별로 가치가 없을 듯하군. 내 혈기가 자꾸 남을 해치라고 시키거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = ee38738c-9a69-8a67-5cd5-6389ad433ed6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CHA_Jergal_Event_AttemptedAttack(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:ee38738c-9a69-8a67-5cd5-6389ad433ed6
msgctxt "hd8890e36g39fcg4a3ag9837gee07d5915198"
msgid "Yes. Ask away."
msgstr "좋아. 물어보시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Player
#. NodeID = fdb89e4e-fb01-6a88-d449-8c4c160f6a05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:fdb89e4e-fb01-6a88-d449-8c4c160f6a05
msgctxt "h96d66d7eg3cebg469fgb6f2gccd70a6bd790"
msgid "No one life is worth more than any other. We are all equal."
msgstr "생명에 경중 따윈 존재하지 않아. 우린 모두 동등한 존재야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal
#. Speaker = Withers
#. NodeID = fe85225c-f2ad-8b90-8ce2-e7001a2f45e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_Jergal:fe85225c-f2ad-8b90-8ce2-e7001a2f45e6
msgctxt "he2e9fcd4g46aeg4b88g8393g949adeac5845"
msgid "To some, it is the only currency."
msgstr "어떤 이들에겐, 생명은 돈일 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = 0576ff8b-04b2-7eb8-e4d5-dece08b9acbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:0576ff8b-04b2-7eb8-e4d5-dece08b9acbe
msgctxt "ha4adef90g082dg4151g818eg8227842fa539"
msgid ""
"The mechanics of fate would be difficult to explain to one such as thyself."
msgstr "운명의 역학은 그대와 같은 이에게 설명해주기 어려운 것이니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Player
#. NodeID = 0fd2d734-d375-5b07-f8f7-4206a2fac655
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1bddcc22-dadd-92c9-4186-4e10ebbfee68_CHA_Crypt_Jergal_DontFollow = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:0fd2d734-d375-5b07-f8f7-4206a2fac655
msgctxt "h1e59d446ge530g4ccbg8908g4d5497148de1"
msgid "You better not follow me. There would be consequences."
msgstr "날 쫓아올 생각은 말라고. 안 그럼 신상에 이롭지 못할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = 188a9dee-c023-868e-7e6b-fc1f92602d32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CHA_Jergal_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:188a9dee-c023-868e-7e6b-fc1f92602d32
msgctxt "h03680065g0b27g4d38gb0ceg770c20ba88fd"
msgid ""
"We have nothing more to discuss. Continue on thy way, as if I were not here."
msgstr "우린 더 논의할 사안이 없다. 그대의 여정을 계속하여라. 나는 없는 것으로 치고 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = 4ca3ac8f-9761-3bbb-7601-c9a57c5d1d49
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1bddcc22-dadd-92c9-4186-4e10ebbfee68_CHA_Crypt_Jergal_DontFollow = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:4ca3ac8f-9761-3bbb-7601-c9a57c5d1d49
msgctxt "hd520fdf7g313ag43b2ga7e4g497cc37bf97b"
msgid ""
"I had no intention of following thee. We will find one another regardless."
msgstr "그대의 뒤를 쫓을 생각은 없다. 우리는 결국 다시 만나게 되어 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Player
#. NodeID = 5b1125ef-027c-0b19-cdad-4df1c454bab6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:5b1125ef-027c-0b19-cdad-4df1c454bab6
msgctxt "h6e0993b8g4e0ag4ee2g80a0g742be89365a5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = 5fd7554e-4a07-2316-94c9-04ae4cf1aa50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:5fd7554e-4a07-2316-94c9-04ae4cf1aa50
msgctxt "h710f3455gedb1g426egb81cg49dca2a41dee"
msgid "Regardless, it will occur."
msgstr "어찌 되었든, 우린 또 만날 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Player
#. NodeID = 6b17b41d-8d2a-4a62-d613-aec522ac05af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1bddcc22-dadd-92c9-4186-4e10ebbfee68_CHA_Crypt_Jergal_SeeAgain = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:6b17b41d-8d2a-4a62-d613-aec522ac05af
msgctxt "he7689ca1ge9d4g4e3fg8818g17817f0701c9"
msgid "'Soon' is rather vague. When, exactly?"
msgstr "'곧'은 너무 모호한걸. 그게 정확히 언제인데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = 76af2cf6-8d19-4170-5c15-9c7aa7581e57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:76af2cf6-8d19-4170-5c15-9c7aa7581e57
msgctxt "he933292eg6d3fg45e0ga1a4ge90c2fbe693e"
msgid ""
"But I do know that the longer thou standest here, the farther away our "
"second meeting becomes."
msgstr "다만 그대가 여기 오래 머무를 수록, 우리의 두 번째 만남이 더욱 늦춰지리란 건 안다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Player
#. NodeID = 82802e44-4939-ee7e-5bc0-0846c55835fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:82802e44-4939-ee7e-5bc0-0846c55835fe
msgctxt "hc4036c4fg73e9g4688g832bgb88df189fbc8"
msgid "You seem very certain of that. How?"
msgstr "아주 확신하는 모양인데. 어째서지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = 83f135d4-435c-2f45-7fc2-a019a1836d05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:83f135d4-435c-2f45-7fc2-a019a1836d05
msgctxt "hfd1d9deagb45bg42ceg8806gfb767ea1f941"
msgid "Inevitability is a wheel that turns of its own accord."
msgstr "필연은 저절로 굴러가는 수레바퀴와 같노라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = 900f7808-e9f4-11aa-0c88-caa1f5620bd1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1bddcc22-dadd-92c9-4186-4e10ebbfee68_CHA_Crypt_Jergal_SeeAgain = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:900f7808-e9f4-11aa-0c88-caa1f5620bd1
msgctxt "h8a3fea0ag22aeg433fg96c9gb4531e7c442a"
msgid ""
"When the time is proper. I do not know that hour any more than dost thou."
msgstr "시기가 적절해질 때겠지. 정확한 시일은 나도 그대만큼이나 잘 알지 못한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Player
#. NodeID = cab25c8a-bbd1-b910-98cb-077e1f4c59ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:cab25c8a-bbd1-b910-98cb-077e1f4c59ca
msgctxt "h135840d6gec73g444egaff8g008dc7846af6"
msgid "Seems you've read ahead in our little story."
msgstr "미래의 우리 이야기를 미리 읽어보기라도 한 말투인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = d3c7cbfb-3e57-140a-f4e4-96879306661d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CHA_Jergal_HasMet(1) = False
#. SetFlags:
#.   Object:
#.     - CHA_Jergal_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:d3c7cbfb-3e57-140a-f4e4-96879306661d
msgctxt "hc3fb09a7gd03ag4426g8a99g62b4fe6e2876"
msgid "Ah, thou as well? It is noted."
msgstr "아, 그대도 일행인가? 기억해 두겠노라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering
#. Speaker = Withers
#. NodeID = e7dd532d-41cc-8923-7c4b-c4bd855dbeb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_JergalWandering:e7dd532d-41cc-8923-7c4b-c4bd855dbeb9
msgctxt "h8d697447g7063g42d6gb34ag4d8c146fde0d"
msgid ""
"I must attend this place, after so many years away. We will see each other "
"again soon."
msgstr "나는 이곳을 살펴봐야 하느니라. 너무나 많은 세월이 흘렀어. 우린 곧 다시 만나게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked
#. Speaker = Player
#. NodeID = 9a0597d4-851d-f214-cc31-218fabc18b84
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked:9a0597d4-851d-f214-cc31-218fabc18b84
msgctxt "hbd844dcfg9f99g4638gbaf0g3b6da943945e"
msgid "It won't move. How disappointing."
msgstr "미동도 없네. 실망스러운걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked
#. Speaker = Player
#. NodeID = 9a0597d4-851d-f214-cc31-218fabc18b84
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked:9a0597d4-851d-f214-cc31-218fabc18b84
msgctxt "hcd3833dbge945g4548g90ccgd05dd86fc27d"
msgid "Doesn't budge. Maybe the mechanism's broken."
msgstr "꿈쩍도 안 해. 장치가 고장 난 걸지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked
#. Speaker = Player
#. NodeID = 9a0597d4-851d-f214-cc31-218fabc18b84
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked:9a0597d4-851d-f214-cc31-218fabc18b84
msgctxt "h09816ff1gb54dg4fb0g96dcgbf8d807bb893"
msgid "Won't budge."
msgstr "꿈쩍도 안 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked
#. Speaker = Player
#. NodeID = 9a0597d4-851d-f214-cc31-218fabc18b84
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked:9a0597d4-851d-f214-cc31-218fabc18b84
msgctxt "h1b21e846ge910g46f7gb420g08fd507c982f"
msgid "Stuck. Must be broken."
msgstr "끼었어. 고장 났나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked
#. Speaker = Player
#. NodeID = 9a0597d4-851d-f214-cc31-218fabc18b84
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked:9a0597d4-851d-f214-cc31-218fabc18b84
msgctxt "h603e7bcfg58c3g484agb657gb1d99d9be912"
msgid "And... nothing. How thrilling."
msgstr "어디... 별일 없네. 김 새는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked
#. Speaker = Player
#. NodeID = 9a0597d4-851d-f214-cc31-218fabc18b84
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked:9a0597d4-851d-f214-cc31-218fabc18b84
msgctxt "h3cfd7744gb52ag44d2gbfdfg4df4bae22d96"
msgid "Stuck. Is this thing broken, or what?"
msgstr "끼었잖아. 고장 나기라도 한 거야, 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked
#. Speaker = Player
#. NodeID = 9a0597d4-851d-f214-cc31-218fabc18b84
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_ButtonBlocked:9a0597d4-851d-f214-cc31-218fabc18b84
msgctxt "h60f5ba5ag53f0g4dbeg8241g74e2fb5c0001"
msgid "Hmm. It won't move."
msgstr "흠. 미동도 없는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins
#. Speaker = Player
#. NodeID = 260a7e2b-9008-f8d5-6290-7b233e9a4fef
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins:260a7e2b-9008-f8d5-6290-7b233e9a4fef
msgctxt "hcf8d31d9ga9e7g442agaf57g612e7405ca68"
msgid "An iron coin? I'd prefer gold, but I'll take it."
msgstr "무쇠 동전이라? 금이었다면 좋았겠지만, 그래도 챙겨야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins
#. Speaker = Player
#. NodeID = 260a7e2b-9008-f8d5-6290-7b233e9a4fef
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins:260a7e2b-9008-f8d5-6290-7b233e9a4fef
msgctxt "hcd29b9cbgab07g49e9g8ccdga3a492dcfa28"
msgid "Never seen a coin like this before. Most peculiar."
msgstr "이런 동전은 처음 보는군. 아주 특이해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins
#. Speaker = Player
#. NodeID = 260a7e2b-9008-f8d5-6290-7b233e9a4fef
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins:260a7e2b-9008-f8d5-6290-7b233e9a4fef
msgctxt "h29bf2599gbdd5g4583g9f4agbd240113fcae"
msgid "Soul coin! Yes! I can use this."
msgstr "영혼 동전이다! 좋았어! 요긴하겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins
#. Speaker = Player
#. NodeID = 260a7e2b-9008-f8d5-6290-7b233e9a4fef
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins:260a7e2b-9008-f8d5-6290-7b233e9a4fef
msgctxt "h4d22df04gb2bcg410ega939g9b7c349670c6"
msgid "Odd. What merchant would accept such a coin?"
msgstr "이상하군. 이런 동전을 받아주는 상인이 있긴 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins
#. Speaker = Player
#. NodeID = 260a7e2b-9008-f8d5-6290-7b233e9a4fef
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins:260a7e2b-9008-f8d5-6290-7b233e9a4fef
msgctxt "h8094c83ag485eg455dgb36ag3f05692296c6"
msgid "Is this... iron? What kind of currency is this?"
msgstr "이거... 무쇠야? 뭔 화폐를 이런 걸로 만들어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins
#. Speaker = Player
#. NodeID = 260a7e2b-9008-f8d5-6290-7b233e9a4fef
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins:260a7e2b-9008-f8d5-6290-7b233e9a4fef
msgctxt "h6cab110bg7531g4b2bg96a1g2706f5e7fede"
msgid "Never saw a coin quite like this. Fancy."
msgstr "이런 동전은 처음 보는데. 멋지군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins
#. Speaker = Player
#. NodeID = 260a7e2b-9008-f8d5-6290-7b233e9a4fef
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_FoundCoins:260a7e2b-9008-f8d5-6290-7b233e9a4fef
msgctxt "h399355e9gbcc8g457ega187ga6558df9ed69"
msgid "A strange coin. I wonder what it's worth."
msgstr "이상한 동전인걸. 어떤 가치의 물건일지 궁금하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_GasPit
#. Speaker = Player
#. NodeID = 7a9c0650-6c3b-d7d2-d1e3-e276d6d6e9c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_GasPit:7a9c0650-6c3b-d7d2-d1e3-e276d6d6e9c5
msgctxt "h809a7ff8g079cg4709g88d4g28c6b855bc42"
msgid "I can't see any way to disarm it."
msgstr "해제할 방법을 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 0380d5d1-7963-47a4-db89-7c4dbca66cb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:0380d5d1-7963-47a4-db89-7c4dbca66cb8
msgctxt "hd5428f0eg5f96g4213gb8c6g1fbfadf59616"
msgid "Even gods get left to rot in the dark."
msgstr "신도 망각 속에서 썩어가는 신세가 되는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 0380d5d1-7963-47a4-db89-7c4dbca66cb8
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:0380d5d1-7963-47a4-db89-7c4dbca66cb8
msgctxt "h96c4e241g725fg48f4ga2fegad8f40b074e8"
msgid "Who's this supposed to be? Statue looks ancient."
msgstr "이건 누굴 묘사한 거지? 고대 시절 조각상처럼 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 0380d5d1-7963-47a4-db89-7c4dbca66cb8
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:0380d5d1-7963-47a4-db89-7c4dbca66cb8
msgctxt "h06755a32gf650g4d76gadeeg7e51284a6f27"
msgid "A monument to a forgotten god. How quaint."
msgstr "잊힌 신에 관한 기념물이라. 참으로 진기하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 0380d5d1-7963-47a4-db89-7c4dbca66cb8
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:0380d5d1-7963-47a4-db89-7c4dbca66cb8
msgctxt "h35d8b1b0g8d54g4cb8gb3b3g85646a8b8f07"
msgid "Nice statue. Can't place the face."
msgstr "멋진 조각상이네. 누구 얼굴인지는 몰라도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 0380d5d1-7963-47a4-db89-7c4dbca66cb8
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:0380d5d1-7963-47a4-db89-7c4dbca66cb8
msgctxt "hc1de979cga74fg4a06g8066g66b0ed97970a"
msgid "Old statue. Don't recognise the mug."
msgstr "오래된 조각상이네. 누구 면상인지는 모르겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 0380d5d1-7963-47a4-db89-7c4dbca66cb8
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:0380d5d1-7963-47a4-db89-7c4dbca66cb8
msgctxt "he0624607g33d6g427fg9e4eg68be330d1486"
msgid "This must be the god they worshipped here. Can't say I recognise him."
msgstr "저건 여기서 섬기던 신인 게 분명해. 다만 누군진 모르겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 0380d5d1-7963-47a4-db89-7c4dbca66cb8
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:0380d5d1-7963-47a4-db89-7c4dbca66cb8
msgctxt "hbb460a73g0f0eg4907gae25g4a075fa050ca"
msgid "That statue. It seems they worshipped some kind of... scholar?"
msgstr "저 조각상. 여기 사람들이 섬기던 존재는... 학자였나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 373ae375-602a-2445-71a0-c8c9b4e95af6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:373ae375-602a-2445-71a0-c8c9b4e95af6
msgctxt "h363f48e5g78f3g4ec1ga0a0gd8629154359f"
msgid ""
"Jergal? This must be ancient - no one worships the Final Scribe anymore."
msgstr "제르갈? 여긴 진짜 고대에 지어졌나 보네. 최후의 필경사 신도는 이젠 아무도 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 373ae375-602a-2445-71a0-c8c9b4e95af6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:373ae375-602a-2445-71a0-c8c9b4e95af6
msgctxt "h0a1cf350ge0e5g4b51ga321g7af1495ad569"
msgid "Jergal? I didn't think anyone worshipped the Scribe of the Dead."
msgstr "제르갈? 죽음의 필경사 신도들은 이젠 없어진 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 373ae375-602a-2445-71a0-c8c9b4e95af6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:373ae375-602a-2445-71a0-c8c9b4e95af6
msgctxt "hdc24b3f3g878fg4d72g87afgf057ff2ed051"
msgid "A statue to Jergal, if my lessons were true. The Final Scribe."
msgstr "내가 배웠던 대로라면, 저건 제르갈의 조각상이군. 최후의 필경사 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 373ae375-602a-2445-71a0-c8c9b4e95af6
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:373ae375-602a-2445-71a0-c8c9b4e95af6
msgctxt "h73818bf6gd089g4ac7gb76bgdf6e015edfa6"
msgid "That's Jergal, 'Scribe of the Dead', walked right out of a legend!"
msgstr "저건 제르갈이잖아. '죽음의 필경사'. 전설 속의 존재가 튀어나왔군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 373ae375-602a-2445-71a0-c8c9b4e95af6
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:373ae375-602a-2445-71a0-c8c9b4e95af6
msgctxt "h4f2ffcb9gcb6cg4dcagbd7cg8462e2f5eddc"
msgid "Jergal, Scribe of the Dead. Must be one ancient chapel."
msgstr "제르갈, 죽음의 필경사군. 여긴 고대 시절 예배당인 게 분명하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 373ae375-602a-2445-71a0-c8c9b4e95af6
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:373ae375-602a-2445-71a0-c8c9b4e95af6
msgctxt "h2dd71ce0gfe14g41ccga9edg03090dcb00cb"
msgid ""
"Look at that! Jergal, the Scribe of the Dead. This chapel must be ancient."
msgstr "이것 봐라. 제르갈, 죽음의 필경사잖아. 이 예배당은 고대에 지어진 게 분명하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction
#. Speaker = Player
#. NodeID = 373ae375-602a-2445-71a0-c8c9b4e95af6
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_JergalStatueReaction:373ae375-602a-2445-71a0-c8c9b4e95af6
msgctxt "h2663f69bg4e47g49fag835bg62eaeeb2705a"
msgid ""
"That's Jergal, Scribe of the Dead. I didn't think anyone still worshipped "
"him."
msgstr "저건 죽음의 필경사, 제르갈이잖아. 이젠 신도가 없어진 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 0af85feb-41cd-4aa9-ad70-a8068568aa10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_AllSkeletonDead = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:0af85feb-41cd-4aa9-ad70-a8068568aa10
msgctxt "h5af47a40gcdb9g4eadg94a5gda2aff84bd28"
msgid "Fools. Rising from the dead just to protect some dusty old baubles."
msgstr "멍청하긴. 고작 어떤 케케묵은 보물 지키겠다고 영면에서 깨어나다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 0af85feb-41cd-4aa9-ad70-a8068568aa10
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_AllSkeletonDead = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:0af85feb-41cd-4aa9-ad70-a8068568aa10
msgctxt "hb751ebcdg2a17g443bgbc64g9c87bd94346f"
msgid ""
"They were fighting to protect something dear to them. I can always tell."
msgstr "뭔가 자기네한테 소중한 걸 지키려고 덤벼든 거야. 딱 보면 안다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 0af85feb-41cd-4aa9-ad70-a8068568aa10
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_AllSkeletonDead = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:0af85feb-41cd-4aa9-ad70-a8068568aa10
msgctxt "hffb4baa8gec4fg477dgbc34gb8ab82543f89"
msgid ""
"The corpses are better fighters than many who draw breath in this world. "
"Curious."
msgstr "이 세계에선 살아있는 웬만한 놈들보다 시체가 더 잘 싸우는군. 흥미로운데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 0af85feb-41cd-4aa9-ad70-a8068568aa10
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_AllSkeletonDead = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:0af85feb-41cd-4aa9-ad70-a8068568aa10
msgctxt "hbce1756cgde89g451dg89e4g2587f9d87f43"
msgid "Well that was pathetic. Sorry bones, guarding dusty old trinkets."
msgstr "거 참 처량하네. 같잖은 뼈다귀들이 케케묵은 노리개 지키는 꼴이라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 0af85feb-41cd-4aa9-ad70-a8068568aa10
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_AllSkeletonDead = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:0af85feb-41cd-4aa9-ad70-a8068568aa10
msgctxt "h7f54b809ge58bg4211g8784g7734785c8747"
msgid "Something here must've been worth protecting."
msgstr "이리 지키려 들 만한 뭔가가 있는 모양이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 0af85feb-41cd-4aa9-ad70-a8068568aa10
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_AllSkeletonDead = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:0af85feb-41cd-4aa9-ad70-a8068568aa10
msgctxt "h69d99697g8aaeg4de2g996cgf836b9df3572"
msgid ""
"Those undead did not surrender their secrets lightly. Something drove them "
"to resist."
msgstr "저 언데드들은 자기네 비밀을 순순히 내주려들지 않았어. 뭔가가 놈들을 맞서 싸우게 만든 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 0af85feb-41cd-4aa9-ad70-a8068568aa10
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_AllSkeletonDead = True
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:0af85feb-41cd-4aa9-ad70-a8068568aa10
msgctxt "he0e86190geb30g4892g8c80gd58ec73f9f5b"
msgid "They didn't want to surrender their valuables, even after death."
msgstr "자기네 보물을 포기할 생각이 없었나 보네. 죽은 후에도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 299af825-ff5f-4ab1-aba9-59a36624ce98
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:299af825-ff5f-4ab1-aba9-59a36624ce98
msgctxt "h2178a630g459fg433cga1c1gde6e97d60f76"
msgid ""
"Who lets their guards' eyes rot away? Honestly, it would've been a crime "
"<i>not </i>to steal that treasure."
msgstr "경비들 눈이 썩게 냅둔 건 뭔 정신머리래? 정말이지, 보물을 <i>안</i> 훔치면 오히려 범죄인 수준이었다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 299af825-ff5f-4ab1-aba9-59a36624ce98
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:299af825-ff5f-4ab1-aba9-59a36624ce98
msgctxt "h51644d62geb07g43c5gb9degc74278165f76"
msgid ""
"I might have preferred strife to stealth - but I'll not deny the spoils."
msgstr "은신보다는 전투를 선호하는 편이지만, 전리품 챙긴 건 괜찮군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 299af825-ff5f-4ab1-aba9-59a36624ce98
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:299af825-ff5f-4ab1-aba9-59a36624ce98
msgctxt "h070a4123g5a7cg49ecgbd51gc4f2520c3829"
msgid ""
"They looked formidable enough. Lucky they didn't catch us with their loot."
msgstr "만만찮게 보이는 놈들이었어. 걸리지 않고 털어서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 299af825-ff5f-4ab1-aba9-59a36624ce98
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:299af825-ff5f-4ab1-aba9-59a36624ce98
msgctxt "h55cdffa5gca93g41dfg9864ge3615e4be811"
msgid "Too close a call, and for what - a handful of baubles?"
msgstr "뭘 위해 이런 위태로운 짓을 한 거람? 싸구려 보석 한 줌?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 299af825-ff5f-4ab1-aba9-59a36624ce98
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:299af825-ff5f-4ab1-aba9-59a36624ce98
msgctxt "he456e489g531fg4149gbd1bg328068e01beb"
msgid "Good sneaking."
msgstr "몰래 잘 끝냈네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 299af825-ff5f-4ab1-aba9-59a36624ce98
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:299af825-ff5f-4ab1-aba9-59a36624ce98
msgctxt "he828eccdgff1ag4675gab19g2041c8b00d15"
msgid "Bad form, isn't it? Grave robbing?"
msgstr "대놓곤 못할 짓이긴 해. 무덤 도굴인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 299af825-ff5f-4ab1-aba9-59a36624ce98
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:299af825-ff5f-4ab1-aba9-59a36624ce98
msgctxt "h30dd5f44g6692g4480gacadg7d1091d24cca"
msgid ""
"I pity anyone caught by those things. We were lucky to get out with the loot."
msgstr "저것들한테 걸렸으면 험한 꼴 봤겠어. 놈들을 털어먹고 잘 빠져나와서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
msgctxt "hebf5587dg38cfg48begba4bg3aa690c216f3"
msgid "How about we slip out of here, before the next bone party starts?"
msgstr "다음 뼈다귀 파티 시작되기 전에 여기서 빠져나가는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
msgctxt "hfc617abdgaba7g4bc9ga882gb7f72e2d17b9"
msgid ""
"Let us fill our packs and depart. The dead need no trinkets - but we might "
"make use of them."
msgstr "가방을 채우고 여길 떠나자. 죽은 것들은 장신구가 필요 없지만, 우린 써먹을 데가 있을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
msgctxt "h83c2de16g657dg424fg9242g9b61d53c4f5a"
msgid ""
"They're unthinking cadavers. I may as well feel sorry for a bread basket."
msgstr "생각 없는 송장 쪼가리들일 뿐이잖아. 난 쥐뿔만큼도 불쌍하단 생각 안 들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
msgctxt "h0a7a3869g716ag47c4gb4c2g455b8f80bca9"
msgid "Fools. Rising from the dead just to protect some dusty old baubles."
msgstr "멍청하긴. 고작 어떤 케케묵은 보물 지키겠다고 영면에서 깨어나다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
msgctxt "h3f1571f7g8070g44bfg86dcg525b40309144"
msgid "Let's get what we want and get out."
msgstr "필요한 거 챙기고, 여기서 나가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
msgctxt "hd84cd902g6a2cg4c73g81b6g478fd1627a7f"
msgid "Let's have a look at the loot. It isn't for your pockets only."
msgstr "전리품을 살펴보자고. 겨우 주머니 채울 수준은 아니겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:2c87929c-b1aa-4a7e-9bf8-a6347df1cba4
msgctxt "h9e1a0f9ag5ee3g479fgb69fg8edcf7979676"
msgid "Relics are wasted on bones. We can make much better use of them."
msgstr "유물을 뼈다귀들이랑 썩히느니 우리가 써먹는 게 훨씬 더 낫지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 675b6b4f-d529-4797-ac67-bda2310fed99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_CombatWithSkeletonHappened = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:675b6b4f-d529-4797-ac67-bda2310fed99
msgctxt "h1a03ea1ag04fag4ae7g93eeg5ec9bdee2d34"
msgid "I can't believe we ran from clacking old bones."
msgstr "저런 삐걱대는 뼈다귀들 상대로 도망치다니 믿기지가 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 675b6b4f-d529-4797-ac67-bda2310fed99
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_CombatWithSkeletonHappened = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:675b6b4f-d529-4797-ac67-bda2310fed99
msgctxt "h5ff43cd4g1e60g4ee3gb57eg08b8f4e64f94"
msgid "Retreat is the <i>coward's</i> way - but I'll not deny our gains."
msgstr "후퇴는 <i>겁쟁이들</i>의 방식이지만, 챙긴 게 아주 없진 않으니 됐다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 675b6b4f-d529-4797-ac67-bda2310fed99
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_CombatWithSkeletonHappened = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:675b6b4f-d529-4797-ac67-bda2310fed99
msgctxt "ha1008816g33c8g44fbg80a6gc9ad9674dad2"
msgid ""
"They fought hard, for bone piles. We were lucky to escape with their loot."
msgstr "뼈 무더기치곤 사납게 덤벼들던걸. 놈들 물건 챙긴 채 탈출하다니 운이 좋았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 675b6b4f-d529-4797-ac67-bda2310fed99
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_CombatWithSkeletonHappened = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:675b6b4f-d529-4797-ac67-bda2310fed99
msgctxt "h44d80f49g9f22g41e9gbbdag8e3403883134"
msgid "All that trouble, and for what - a handful of baubles?"
msgstr "그 고생을 해놓고 대체 뭘 건진 거지? 싸구려 보석 한 줌?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 675b6b4f-d529-4797-ac67-bda2310fed99
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_CombatWithSkeletonHappened = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:675b6b4f-d529-4797-ac67-bda2310fed99
msgctxt "h4447960fg36ceg4ffagb587ga823037af36e"
msgid "We could've taken 'em. But hey, what do I know?"
msgstr "싸웠으면 이길 수 있었을 텐데. 그래도 뭐, 사람 일 누가 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 675b6b4f-d529-4797-ac67-bda2310fed99
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_CombatWithSkeletonHappened = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:675b6b4f-d529-4797-ac67-bda2310fed99
msgctxt "h335a4317g2847g45c3g99a4g4ed2e2a55f32"
msgid ""
"Ah, fleeing from battle. And I thought desecrating those graves was a low "
"point."
msgstr "아, 전투 중 도망이라. 무덤 털이 보다 더 창피한 짓을 겪을 줄은 몰랐는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = 675b6b4f-d529-4797-ac67-bda2310fed99
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL0_State_CombatWithSkeletonHappened = True
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:675b6b4f-d529-4797-ac67-bda2310fed99
msgctxt "h3e21a7cagb7d3g41b0g9411g164481df76b3"
msgid ""
"A lucky escape. Judging by how they fought, those things weren't happy with "
"our looting."
msgstr "운 좋게 벗어났네. 덤벼드는 모습을 보니, 자기네 걸 터는 게 참 거슬렸던 모양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = a3ea4637-cac4-435a-9633-15064f5aac27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:a3ea4637-cac4-435a-9633-15064f5aac27
msgctxt "h39ced750g4679g4523gbac2g228699b2992a"
msgid "Let's just slip out of here - the chill's getting to me."
msgstr "얼른 이곳을 뜨자. 으스스한 게 심해지고 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = a3ea4637-cac4-435a-9633-15064f5aac27
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:a3ea4637-cac4-435a-9633-15064f5aac27
msgctxt "h3c4dd030g8928g4ef1gb48age54792caf1a8"
msgid "They have no use for such trinkets. We can make use of them instead."
msgstr "놈들에게 장신구 따윈 필요 없지. 우리가 대신 잘 써주도록 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = a3ea4637-cac4-435a-9633-15064f5aac27
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:a3ea4637-cac4-435a-9633-15064f5aac27
msgctxt "he41f1802g38ffg41eeg8576g02f911354cb5"
msgid "Next time we'll grind their bones to make our bread."
msgstr "다음에 만나면 놈들 뼈를 갈아다 빵으로 만들어버리자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = a3ea4637-cac4-435a-9633-15064f5aac27
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:a3ea4637-cac4-435a-9633-15064f5aac27
msgctxt "hb4f8d88fgd6e6g498bgbff8geeb3edfc2410"
msgid "Their trinkets may be worth a few coins, all the same."
msgstr "그래도 놈들 장신구를 팔면 동전 몇 푼은 건지겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = a3ea4637-cac4-435a-9633-15064f5aac27
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:a3ea4637-cac4-435a-9633-15064f5aac27
msgctxt "h6ebfa0a2g5cb1g4e49gb805g470eb1ab2134"
msgid "Let's beast an exit - this place is... blech."
msgstr "얼른 출구로 가자고. 여긴 정말이지... 으휴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = a3ea4637-cac4-435a-9633-15064f5aac27
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:a3ea4637-cac4-435a-9633-15064f5aac27
msgctxt "he0bde046ge8c9g4f05ga8a4g5d7b11daad66"
msgid "Now let's have a look at the loot. It isn't for your pockets only."
msgstr "이제 전리품을 살펴보자고. 겨우 주머니 채울 수준은 아니겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing
#. Speaker = Player
#. NodeID = a3ea4637-cac4-435a-9633-15064f5aac27
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Chapel/CHA_Crypt_PAD_SuccessfulGraverobbing:a3ea4637-cac4-435a-9633-15064f5aac27
msgctxt "hca744285g9be0g4f3cgadd0gcc5f546cb84a"
msgid "Relics are wasted on bones. We can make much better use of them."
msgstr "유물을 뼈다귀들이랑 썩히느니 우리가 써먹는 게 훨씬 더 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Artefact_1
#. Speaker = Player
#. NodeID = 3b30057e-1ab5-4616-29f5-70bc53c6c2f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Artefact_1:3b30057e-1ab5-4616-29f5-70bc53c6c2f8
msgctxt "h3f9ccbeagadecg4a10g8cebgf2e1832e9dd6"
msgid "A lot of effort to hide one sarcophagus."
msgstr "고작 석관 하나 숨기겠다고 공 참 많이 들였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "h79bed77fgaaa0g4d27gb692ge9fc6529d14c"
msgid "Oh, I like it. Homely."
msgstr "와, 맘에 드는데. 마치 집 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "h6e4c9f05gaa70g4f89gb72egdcf937343233"
msgid "Yes, I'm getting a distinct whiff of crypt. Undisturbed too, until now."
msgstr "그래, 묘실 특유의 냄새가 나는군. 지금까진 침범된 적 없는 거 같기도 하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "ha0457b5dg4bd2g4891gb822g28a2dcd8ee0c"
msgid "Old undisturbed crypt. Nice."
msgstr "침범된 적 없는 옛 묘실이라. 좋은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "hac83cd40ge61ag4306gb3c0g5eab50f6440f"
msgid "A crypt. What riches might it contain?"
msgstr "묘실이라. 과연 어떤 보물을 품고 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "h70b00753gd13bg4f00g800dgb6b56a4d2297"
msgid "Looks like nobody's ventured this far down in years..."
msgstr "여기까지 내려온 사람은 근 수년간 우리 말곤 없었나 보네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "h54d2e312g7a8bg407fg8638gc822e2e86648"
msgid "Nobody's been here in an elf's age."
msgstr "엘프 한 평생만큼 방문자가 없었나 본데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "hd3434781g9438g49e7gbb3eg36ad1bf95995"
msgid "This whole place reeks of necromancy."
msgstr "강령술의 악취가 진동을 하는 곳이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1
#. Speaker = Player
#. NodeID = 1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_LowerFloor_1:1f6f8bd8-233f-4b2f-bdfe-89782b633ca5
msgctxt "h95dc8887g0ed1g4637g9afcg01cb8ad33c5f"
msgid "This place wasn't built for the living."
msgstr "여긴 산 자를 위해 지어진 곳이 아니군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "h5960cc53gd20cg48c0ga4f6g58bffa99be81"
msgid "The air's so stale. It feels more like a tomb than a temple."
msgstr "공기가 너무 탁하네. 신전이라기보단 무덤 같은 느낌인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "hac538214g73a2g4e21g91ebg8bb5c4bc00c4"
msgid "Such oppressive silence. Must be lonesome to be a forgotten god."
msgstr "숨 막히게 고요한걸. 잊힌 신이란 건 참 고독한 존재겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "hc1ff1289gdce5g4d04g83bbg32211134ded2"
msgid "Any old bones in here?"
msgstr "여긴 뭐 삭은 뼈다귀 같은 거 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "haa86e197g507eg46fcg85bag4ba93b865a4e"
msgid ""
"Nothing but dust. Perhaps the faithful abandoned their god. Or their god "
"abandoned them."
msgstr "먼지밖에 없군. 신도들이 자기네 신을 버린 모양이야. 아니면 신이 신도들을 버렸거나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "hfdb30d67g704eg43e1g8f4dg5418041d6287"
msgid ""
"Abandoned. Whatever god this place was built for can't be in great demand."
msgstr "버려진 곳이네. 여기 모셔진 신이 누군진 몰라도, 인기가 시원찮았나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "h9329c565g0e51g41d8g982dg99034981c67a"
msgid "Dust everywhere and not a prayer to be heard."
msgstr "먼지투성이에 기도 소리는 들리지 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "h6f84f031gac58g476cg8f65g59ede6802d86"
msgid "I sense another undead presence here. Powerful, but not malevolent."
msgstr "다른 언데드의 존재가 느껴져. 강력하지만, 악의를 품고 있진 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1
#. Speaker = Player
#. NodeID = b198e4f5-4c9a-d3af-abb6-c4d201a67acb
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1:b198e4f5-4c9a-d3af-abb6-c4d201a67acb
msgctxt "h7afc57d6g745fg477dgb3b1g6cc7afbb7904"
msgid "No more prayers... only silence and dust."
msgstr "기도 소리는 끊긴 채... 침묵과 먼지만 맴도는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1_WithMystic
#. Speaker = Player
#. NodeID = 3345e72a-4e43-5877-c12b-3f235f821e42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1_WithMystic:3345e72a-4e43-5877-c12b-3f235f821e42
msgctxt "h4f421c0ag91deg4981gbbfbg3344c7fecade"
msgid "Something divine lingers here - but I don't recognise this presence."
msgstr "뭔가 신성한 기운이 감돌긴 하는데, 이게 어떤 존재인지는 모르겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1_WithShadowheart
#. Speaker = Shadowheart
#. NodeID = 0cf8e493-abaa-1147-5c75-385f5ee86810
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_1_WithShadowheart:0cf8e493-abaa-1147-5c75-385f5ee86810
msgctxt "hf78294bbg987bg4050g8306g2f9d8f64633d"
msgid "I don't recognise this. Who was worshipped here?"
msgstr "이게 뭔지 모르겠는데. 여긴 대체 누굴 섬긴 거람?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithMysticShadowheart
#. Speaker = Shadowheart
#. NodeID = 05c5c180-f46b-9cdf-9511-9d68926a4674
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithMysticShadowheart:05c5c180-f46b-9cdf-9511-9d68926a4674
msgctxt "h18c578fdg4711g4c6cg8becg7b66d13ba11a"
msgid "Whoever that even is. No intact symbols here, no dedications - nothing."
msgstr "누군지 아예 모르겠네. 알아볼 만한 상징도, 공물도 전혀 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithMysticShadowheart
#. Speaker = Player
#. NodeID = 1e2a35b8-5209-c681-6c78-45b6a9d54a80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithMysticShadowheart:1e2a35b8-5209-c681-6c78-45b6a9d54a80
msgctxt "ha026a470g0b61g46c3gab53gcc10b66879bf"
msgid "I feel a presence here - a power. The patron god of this place?"
msgstr "여기서 어떤 존재감이 느껴져. 힘 말이야. 이곳의 수호신인 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Player
#. NodeID = 17f7db39-6bb3-715b-3464-8d5bebc0e4b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:17f7db39-6bb3-715b-3464-8d5bebc0e4b6
msgctxt "hfac7f02eg7313g41d2ga8aag89d48705a12d"
msgid "The air's stale. It's been centuries since any prayers disturbed it."
msgstr "공기가 탁하네. 기도 올리는 사람들 발길 끊긴 지 수 세기는 지났나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Player
#. NodeID = 17f7db39-6bb3-715b-3464-8d5bebc0e4b6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:17f7db39-6bb3-715b-3464-8d5bebc0e4b6
msgctxt "he6978cd0g7edag47d8g90e3g44efc622ed51"
msgid "No more prayers, only silence. Must be lonesome to be a forgotten god."
msgstr "기도 소리는 끊긴 채, 침묵만 맴도는군. 잊힌 신이란 건 참 고독한 존재겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Player
#. NodeID = 17f7db39-6bb3-715b-3464-8d5bebc0e4b6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:17f7db39-6bb3-715b-3464-8d5bebc0e4b6
msgctxt "h8819150dg984ag4b59g8a87g9812be38879c"
msgid "No one's prayed here in an aeon."
msgstr "기도하는 사람 끊긴 지 겁나 오래됐나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Player
#. NodeID = 17f7db39-6bb3-715b-3464-8d5bebc0e4b6
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:17f7db39-6bb3-715b-3464-8d5bebc0e4b6
msgctxt "h533b5ba1ga058g46b8ga06cg2477af298914"
msgid "Long abandoned. No more worship, no more prayers."
msgstr "버려진 지 오래됐군. 신도도, 기도 소리도 이젠 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Player
#. NodeID = 17f7db39-6bb3-715b-3464-8d5bebc0e4b6
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:17f7db39-6bb3-715b-3464-8d5bebc0e4b6
msgctxt "h59e5e119gce2bg4e2bg83a5gc13976262774"
msgid ""
"Whoever was worshipped here hasn't been paid homage in some time, by the "
"look of it."
msgstr "누구의 신전인지는 몰라도, 상태를 보니 경배받지 못한 지 한참 됐나 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Player
#. NodeID = 17f7db39-6bb3-715b-3464-8d5bebc0e4b6
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:17f7db39-6bb3-715b-3464-8d5bebc0e4b6
msgctxt "hc2717057g5410g4c93g8046ge9a138fb1799"
msgid "Dust everywhere. Been a while since the last prayer was said."
msgstr "먼지투성이야. 기도 올리는 사람 끊긴 지 한참 지났나 본데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Player
#. NodeID = 17f7db39-6bb3-715b-3464-8d5bebc0e4b6
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:17f7db39-6bb3-715b-3464-8d5bebc0e4b6
msgctxt "he8155b07g160cg4477g8730gfb273f82494f"
msgid "No more prayers... only dust and silence."
msgstr "기도 소리는 끊긴 채... 먼지와 침묵만 맴도는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart
#. Speaker = Shadowheart
#. NodeID = 7cc5fb11-288f-9346-ccb3-2b7dbbd0bcd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Sanctum_2_WithShadowheart:7cc5fb11-288f-9346-ccb3-2b7dbbd0bcd1
msgctxt "hb8ba6267g8139g4bbdg9cc6g5c90aba068dd"
msgid ""
"Who were those prayers for? Normally the patron god is obvious - not here."
msgstr "여긴 누굴 섬기던 걸까? 보통은 모시는 신을 알아보기 쉬운데, 여긴 아닌걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h5238101ag78d2g4d45g9052gbebbbf3d38ee"
msgid "A chained book? Oh, that's just begging to be read."
msgstr "단단히 잠긴 책이라? 제발 읽어달라는 거나 다름없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h998d401fg0cfag46c2gb932g9de97e603306"
msgid ""
"A chained-up book in a long-abandoned temple. Temptation, old friend, we "
"meet again."
msgstr "오랫동안 버려진 사원 속에 단단히 잠겨 있는 책이라. 내 오랜 친구 유혹이여, 다시 만나는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h72620568gfe83g4d48gb598geb49256f0c5d"
msgid "Danger book. Let's read it."
msgstr "위험해 보이는 책이네. 읽어봐야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h35f93227gb4a0g4dd4gba01g499f12dea166"
msgid "Locked - as if that were enough to keep me out."
msgstr "잠겨 있군. 이런다고 내가 못 읽을 성싶으냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "hda4ff10cg4bd6g47beg9194g976edf9113eb"
msgid "What could a book contain that requires it to be bound with chains...?"
msgstr "책에 대체 뭔 내용이 담겨 있길래 이렇게 단단히 잠가둔 거지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "hc0af824dg4fd1g4205g8623gb9868650d3f3"
msgid "Chained and locked. A banished evil? Or a hidden truth?"
msgstr "책이 단단히 잠겨 있군. 사악한 게 봉인된 건가? 아님 뭔 진실을 숨겼거나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h783b0c1dg46a2g4487gb280ga6af5a7e78f4"
msgid "Forbidden knowledge - without a doubt."
msgstr "딱 봐도 금단의 지식서군. 보나마나지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "hbf457e4fg144eg4736gb8a0gd68f871a84fe"
msgid "Locked to keep the evil in, or the prying eyes out? Let's see."
msgstr "사악한 걸 봉인해 잠근 걸까, 아님 뭔가를 숨긴 걸까? 어디 알아보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: CLERIC and PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h2b6c0524gca67g47f8gba59g144f2b12bb95"
msgid "That's locked for a reason. Let's not disturb it."
msgstr "이유가 있으니 책을 잠근 거겠지. 괜히 건들지 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h707cd227g4ac8g4a9cgab69g6e87768a06b7"
msgid "Now that's a lock that screams 'pick me'."
msgstr "저런 자물쇠는 되려 '날 따줘'라고 비는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1
#. Speaker = Player
#. NodeID = 2878d8a7-cfaf-6de1-cd1f-86653055c2e2
#. HandlePath = TaggedText[10].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_SideChamber_1:2878d8a7-cfaf-6de1-cd1f-86653055c2e2
msgctxt "h1bc93adbgd429g4f68gb93dg0a07b39b06fc"
msgid "Looks like someone wanted to bury their secrets."
msgstr "누군가 자기 비밀을 단단히 묻어두려고 한 모양새인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1
#. Speaker = Player
#. NodeID = 745c7b97-82f7-a730-501a-09ce9ca30632
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1:745c7b97-82f7-a730-501a-09ce9ca30632
msgctxt "hbe379646g6e13g41a1g9420g319f226cec27"
msgid "Scribes with swords? So much for the quill being mightier."
msgstr "검을 지닌 서기들이라? 펜은 칼보다 강하단 말이 참 무색하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1
#. Speaker = Player
#. NodeID = 745c7b97-82f7-a730-501a-09ce9ca30632
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1:745c7b97-82f7-a730-501a-09ce9ca30632
msgctxt "ha2f71828g1222g4b42g8933gd2b4142cfbf3"
msgid ""
"Sword-carrying scribes... What was so subversive about their words that they "
"commanded protection?"
msgstr "검을 지닌 서기라니... 도대체 얼마나 불온한 말을 퍼뜨렸길래 이런 호신용품이 필요했던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1
#. Speaker = Player
#. NodeID = 745c7b97-82f7-a730-501a-09ce9ca30632
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1:745c7b97-82f7-a730-501a-09ce9ca30632
msgctxt "he7e13bf9ga06dg44bfg982dgbdf9f313ea6b"
msgid "These guys are armed to the teeth. Why? What's down here?"
msgstr "이 시체들 완전무장 되어있는걸. 왜지? 이 지하에 뭐가 있길래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1
#. Speaker = Player
#. NodeID = 745c7b97-82f7-a730-501a-09ce9ca30632
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1:745c7b97-82f7-a730-501a-09ce9ca30632
msgctxt "h60c09ac0ga94eg4aacg9f51g254d73938ee4"
msgid "These scribes were armed, for all the good it did them."
msgstr "이 서기들은 무장되어 있군. 별 쓸모는 없었나 보지만 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1
#. Speaker = Player
#. NodeID = 745c7b97-82f7-a730-501a-09ce9ca30632
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1:745c7b97-82f7-a730-501a-09ce9ca30632
msgctxt "hcbe98558gb22ag46begbc32gd54659ff868c"
msgid "They look like scribes, despite the weapons. No wonder they're dead."
msgstr "이 시체들, 서기처럼 보이네. 무기를 지녔지만 말이지. 왜 당했는지 알 만한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1
#. Speaker = Player
#. NodeID = 745c7b97-82f7-a730-501a-09ce9ca30632
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1:745c7b97-82f7-a730-501a-09ce9ca30632
msgctxt "hefe4d78ag8cfcg43dfgb6cbgfd128d7d2b42"
msgid "Well-armed for scribes, I reckon. Wonder what happened."
msgstr "서기 치곤 무장이 탄탄하단 말이지. 무슨 일이 있었던 걸까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1
#. Speaker = Player
#. NodeID = 745c7b97-82f7-a730-501a-09ce9ca30632
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_1:745c7b97-82f7-a730-501a-09ce9ca30632
msgctxt "h75195108ga140g4f08g9438g222ae6289db1"
msgid "Armed scribes - but no sign of a struggle."
msgstr "서기들이 무장되어 있군. 하지만 싸운 흔적은 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = 53fc8e2f-6323-6efa-6ac3-d684a6e3da62
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:53fc8e2f-6323-6efa-6ac3-d684a6e3da62
msgctxt "h9b98acfega8d0g46e1gbdd3g7d9c606a8b57"
msgid "Scribes with swords? So much for the quill being mightier."
msgstr "검을 지닌 서기들이라? 펜은 칼보다 강하단 말이 참 무색한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = 53fc8e2f-6323-6efa-6ac3-d684a6e3da62
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:53fc8e2f-6323-6efa-6ac3-d684a6e3da62
msgctxt "h7eed4a07g56bbg4392gb268g7829f4f42aa8"
msgid ""
"Sword-carrying scribes... What was so subversive about their words that they "
"commanded protection?"
msgstr "검을 지닌 서기라니... 도대체 얼마나 불온한 말을 퍼뜨렸길래 이런 호신용품이 필요했던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = 53fc8e2f-6323-6efa-6ac3-d684a6e3da62
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:53fc8e2f-6323-6efa-6ac3-d684a6e3da62
msgctxt "h24907c63g7294g4b0fg9700g2a1faa8d87a8"
msgid "These guys are armed to the teeth. Why?"
msgstr "이 시체들 완전무장 되어있는걸. 왜지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = 53fc8e2f-6323-6efa-6ac3-d684a6e3da62
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:53fc8e2f-6323-6efa-6ac3-d684a6e3da62
msgctxt "hd67b1bf2gab58g46adga6d5g242437d8f1e8"
msgid "These scribes were armed, for all the good it did them."
msgstr "이 서기들은 무장되어 있군. 별 쓸모는 없었나 보지만 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = 53fc8e2f-6323-6efa-6ac3-d684a6e3da62
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:53fc8e2f-6323-6efa-6ac3-d684a6e3da62
msgctxt "h4e52527fg2421g40bbg9aa1ge2b28aed4f9a"
msgid ""
"They look like scribes, despite the weapons. No surprise that they died, "
"then..."
msgstr "이 시체들, 서기처럼 보이네. 무기를 지녔지만 말이지. 왜 당했는지 알 만한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = 53fc8e2f-6323-6efa-6ac3-d684a6e3da62
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:53fc8e2f-6323-6efa-6ac3-d684a6e3da62
msgctxt "h248ae178g43c4g4a47g80fbg475e7b93acf7"
msgid "Unfortunate scribes. They never stood a chance in the fight, did they?"
msgstr "서기들이 불쌍하군. 승산 없는 싸움이었을 테니 말이야. 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = 53fc8e2f-6323-6efa-6ac3-d684a6e3da62
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:53fc8e2f-6323-6efa-6ac3-d684a6e3da62
msgctxt "h75466e2fg0bdag4e14gb8b9g87e01050325f"
msgid "Armed scribes - but no sign of a struggle."
msgstr "서기들이 무장되어 있군. 하지만 싸운 흔적은 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
msgctxt "h712333fcgdceag492cg8fc1g9651c7becc1f"
msgid "The bones are intact. Would not scavengers have disturbed them?"
msgstr "뼈가 멀쩡히 남아있군. 청소 동물들이 이걸 건드리지 않았다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
msgctxt "ha7c99578g3feeg42b5g9d8eg84d288a8ff78"
msgid "I'd love to know the full story."
msgstr "어떤 내막이 있는 건지 궁금하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
msgctxt "heb73dce0g4f51g4666g9142g1e17224e1a98"
msgid "Let's move before we meet the same fate."
msgstr "이들이랑 똑같은 신세가 되기 전에 얼른 가자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2
#. Speaker = Player
#. NodeID = c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
#. HandlePath = TaggedText[3].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_Skeleton_2:c02a876e-36a5-ae2b-0f32-fa434bcd7d2a
msgctxt "hfec311deg9d57g4054gb01eg1bc2c03e6c5a"
msgid ""
"I wonder what was so subversive about their words that they commanded "
"protection."
msgstr "도대체 얼마나 불온한 말을 퍼뜨렸길래 이런 호신용품이 필요했을까 궁금하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_1
#. Speaker = Player
#. NodeID = 9e51df19-5da0-783c-c56a-93e9d91f0938
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_1:9e51df19-5da0-783c-c56a-93e9d91f0938
msgctxt "h3165da20g544fg4788g9f97gcca48d0024e7"
msgid "Oh, hells. Something just woke up..."
msgstr "오, 망할. 방금 뭔가 깨어난 모양인데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_1_WithShadowheart
#. Speaker = Shadowheart
#. NodeID = 5ac7dd1d-bf4a-43e2-b496-d418bddcfe62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_1_WithShadowheart:5ac7dd1d-bf4a-43e2-b496-d418bddcfe62
msgctxt "h7dc1acbag4fc5g407bgb0e3ge42b1e74b33a"
msgid "Trying to frighten me with cheap tricks? Darkness is my element."
msgstr "같잖은 수작질로 날 겁 먹이려는 건가? 어둠은 내 세상이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_2_WithShadowheart
#. Speaker = Player
#. NodeID = 44a944b9-d9ed-08b3-f283-95cb26b358a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_2_WithShadowheart:44a944b9-d9ed-08b3-f283-95cb26b358a7
msgctxt "hedf6725dg8916g442fga98agd2ba801375a4"
msgid "Hells... something just woke up down here."
msgstr "망할... 방금 뭔가가 여기서 깨어난 모양인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_2_WithShadowheart
#. Speaker = Shadowheart
#. NodeID = 4e52cdbe-942f-1906-ec02-d71eca4a900c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_VB_TakingTheArtefact_2_WithShadowheart:4e52cdbe-942f-1906-ec02-d71eca4a900c
msgctxt "h61152197g999ag4a49g8420g20c412b279b2"
msgid "Let them come. The darkness can be to our advantage."
msgstr "어디 덤벼보라지. 어둠이 우리 편이 되어줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap
#. Speaker = Player
