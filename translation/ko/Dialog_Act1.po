msgctxt "heedac519g0c1cg4c9ega223gd8d7e6f17190"
msgid "*Clatter.*"
msgstr "*철컥*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD
#. Speaker = Player
#. NodeID = 63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD:63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
msgctxt "h1274bd1bgaaf9g40a9ga115ga84935203e10"
msgid "The earth's been charred. Ominous."
msgstr "대지가 그을려 있군. 불길한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD
#. Speaker = Player
#. NodeID = 63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD:63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
msgctxt "hf5e47d6fge505g4f09g9a7dg472c28eb7e8e"
msgid "Scorch marks. Hints of Weave too. There might just be trouble afoot."
msgstr "그을린 자국에 위브의 흔적까지. 이 앞에 골칫거리가 있을것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD
#. Speaker = Player
#. NodeID = 63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD:63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
msgctxt "h683a3d8fgfc40g4433g95a8g1f501d117643"
msgid "Scorch marks. And it's not me this time."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD
#. Speaker = Player
#. NodeID = 63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD:63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
msgctxt "h37555dc1g32b3g4f89ga635g4ae3dc613c3c"
msgid "Scorch marks. Eyes keen and ears open."
msgstr "그을음이라. 눈 크게 뜨고, 귀 세우고 있자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD
#. Speaker = Player
#. NodeID = 63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD:63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
msgctxt "h9d44e2f6g3489g454dga211g987a71341af0"
msgid "Burn marks, and not from someone's campfire either. Best be careful."
msgstr "불탄 자국이야, 어디 모닥불에서 난 흔적도 아니고. 조심해야겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD
#. Speaker = Player
#. NodeID = 63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD:63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
msgctxt "h91fa438fgc7bbg4d05ga49cgbadea4d08502"
msgid "Scorch marks? Watch your step, caution, tread lightly, and so forth."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD
#. Speaker = Player
#. NodeID = 63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_ArcaneTurrets_PAD:63d0d1b1-ef3f-e831-9c3c-2d156b0c02ae
msgctxt "h2773f0c9g5c81g4b80g95e6g51370db5267e"
msgid "Scorched ground - better watch out."
msgstr "그을린 땅이야 - 조심하는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BooooalRocks_AD
#. Speaker = Narrator
#. NodeID = 0b5982a4-d5ca-e776-ca07-3309a61bef3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BooooalRocks_AD:0b5982a4-d5ca-e776-ca07-3309a61bef3c
msgctxt "h892ea034gac16g4a5fga925ga485301ccbfd"
msgid "*A crude hand has scratched the word 'BOOOAL' into the stone.*"
msgstr "*세련되지 못한 손이 '부알'이라는 단어를 돌에 긁어 넣었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BroodingMyconid_AD_DuergarDead
#. Speaker = Sovereign Glut
#. NodeID = 4b25d786-fd1e-4637-90be-d32d94989298
#. HandlePath = TaggedText[0].TagText[0]
