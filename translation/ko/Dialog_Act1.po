#.   Global:
#.      - UND_FearfulRothe_Event_AgreedToHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:007c04af-035a-fedc-a4c0-1d19bab1ab24
msgctxt "hd67404dfg4db8g41eag95deg450e51c9de59"
msgid "You gonna cane 'em or what? Time those rothé got to work."
msgstr "그래서 채찍질을 할 거야 뭐야? 이제 저 로테들이 일할 시간이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Narrator
#. NodeID = 05612d2a-3384-38d1-48ae-5313aab033fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:05612d2a-3384-38d1-48ae-5313aab033fd
msgctxt "h32239ccbg1d7dg4dd9g9ac4g88b22a2759ed"
msgid ""
"*You remember blacksmiths speaking of it in hushed awe - the hardest "
"substance known to exist, used for the finest weapons and armour.*"
msgstr ""
"*대장장이들이 조용한 경외감 속에서 언급하던 것을 기억해 냅니다. 알려진 물질 중 가장 단단하며, 최고의 무기와 갑옷에 사용합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 05fde624-1c7d-8ce8-b46e-2252cf50ee9f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_ConvincedTaskmasterToHurtRothe = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:05fde624-1c7d-8ce8-b46e-2252cf50ee9f
msgctxt "ha3d3bbf2g29fbg46bfgb8a8gf2053cb773e4"
msgid ""
"<i>Gh'rack </i>- you <i>knew</i> I'd rile them up. I'll split you from head "
"to hole for this!"
msgstr "<i>그락</i>, 너 내가 이놈들 화를 돋굴 줄 <i>알고</i> 있었지. 머리부터 똥구멍까지 갈라 주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 08535f8e-e892-030f-777a-aa61d724cbc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:08535f8e-e892-030f-777a-aa61d724cbc6
msgctxt "h2e7cb0a4g9bb9g453dgbc9cgf1410dbe0a84"
msgid "<i>NgghhHA!</i>"
msgstr "<i>이야아아!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 0a6fd0b4-ec0f-7313-d443-63b5c491de5f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_AdamantineForge_Knows_Adamantine = True
#.     - UND_FurnaceSearch_Event_DuergarMentionsForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:0a6fd0b4-ec0f-7313-d443-63b5c491de5f
msgctxt "h7d22df93gb2e5g40fbg98dbg9fd2d97c2542"
msgid "There's an adamantine forge back there, sure as shittin'."
msgstr "저 너머에 아다만틴 대장간이 있어. 존나 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Narrator
#. NodeID = 0e029c6c-7ef1-132d-a227-7e8ff53ae905
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRotheGuard1_Event_PassedAdamantineCheck(1) = True
#.   Global:
#.     - UND_AdamantineForge_Knows_Adamantine = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:0e029c6c-7ef1-132d-a227-7e8ff53ae905
msgctxt "h219b2113gd62cg43b0g9445ge1ed74dca01d"
msgid ""
"*Your eye finds the source of the gleam: a small mote of black metal. "
"Adamantine.*"
msgstr "*광채의 근원인 검은 금속의 작은 티끌이 눈에 띕니다. 아다만틴입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 0e058f1f-2b26-4066-08ef-a96e6804bb3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_SawForge = False
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_AttackedDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:0e058f1f-2b26-4066-08ef-a96e6804bb3c
msgctxt "hd52466f0ge142g42b3g9950g435c0482f465"
msgid "Thanks for the tip. Once you're dead, I'll have that forge to myself."
msgstr "조언 고마워. 네가 죽고 나면, 그 대장간을 차지할 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 14acb1fe-e14e-b13c-0c7e-df752a9c261d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:14acb1fe-e14e-b13c-0c7e-df752a9c261d
msgctxt "h7aa00a01geddbg40edgada2g589ab7e482f0"
msgid "A brute? Is that what you see?"
msgstr "야수? 너한텐 그래 보이나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 19907d57-196c-4ee6-fdc3-d05de099d27c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRotheGuard1_Event_MentionedLashing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:19907d57-196c-4ee6-fdc3-d05de099d27c
msgctxt "h2e5a29e1g4080g44a0g87c9g608dbdbb16d1"
msgid "Now get to the canin', before I thrash <i>you</i> instead."
msgstr "내가 대신 <i>널</i> 때려눕히기 전에 어서 채찍질해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 199efef8-da64-5963-75fe-46f0c909abbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:199efef8-da64-5963-75fe-46f0c909abbf
msgctxt "h1443ba10g3ecfg4b3bga660gf742d14a9ed1"
msgid "Shit. Sooner give a lurker a lickjob."
msgstr "씨발. 차라리 럴커 고추를 빨겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 1b55e195-e5e1-09f8-ecf4-c550c98c800e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:1b55e195-e5e1-09f8-ecf4-c550c98c800e
msgctxt "hd08caa42gd3aeg4d1ag8cafgb5740832932e"
msgid "What's behind the rubble?"
msgstr "잔해 뒤에 뭐가 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 1bbdd7aa-85c9-8c31-a621-d81e2ba37b4e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BESTIAL or HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:1bbdd7aa-85c9-8c31-a621-d81e2ba37b4e
msgctxt "h167e6b09g3e9dg4639g9ee9g1b8f6c751c74"
msgid "Shouldn't be trouble for a brute like you."
msgstr "너 같은 야수한텐 일도 아니겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Wyll
#. NodeID = 1ddfaa00-f298-8fce-dc07-66dadacbc11d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:1ddfaa00-f298-8fce-dc07-66dadacbc11d
msgctxt "hb7199116g632fg434agb323g706a78a923bf"
msgid ""
"Hold your tongue. Those rothé are ready to blow - and you'll be lighting the "
"fuse."
msgstr "말 조심해. 저 로테들은 폭발하기 직전이라고. 도화선에 불을 붙이는 짓일지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 1ff443f4-73b8-fecc-c19e-ed4c70c7e5df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_Event_ShowedAdamantine = True
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#.     - UND_AdamantineForge_Knows_Adamantine = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:1ff443f4-73b8-fecc-c19e-ed4c70c7e5df
msgctxt "heeac8fcfgc757g4c7dg8244g5ecb1df12612"
msgid "Adamantine is precious, <i>jargh</i>. And I'm not the sharing type."
msgstr "아다만틴은 값비싼 물건이야, <i>자그</i>. 그리고 난 나눠줄 생각 같은 건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 2b550e5f-1748-0f74-9b20-6f8cb5932a4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:2b550e5f-1748-0f74-9b20-6f8cb5932a4d
msgctxt "h380aec04gd9a0g4764g95b1ga3f0d44ef756"
msgid "Show the animals some respect. Then you may get results."
msgstr "동물을 존중해. 그러면 대가가 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 3126c058-ab97-33d8-8481-22be443b54b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_ShowedAdamantine = True
#.     - UND_AdamantineForge_Knows_Adamantine = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:3126c058-ab97-33d8-8481-22be443b54b4
msgctxt "hf3f42b75gebdcg4d43g9237g62a412380eed"
msgid ""
"Adamantine. Stuff's no joke. Stronger than steel, rarer than mithral. It "
"ain't mined - it's <i>made.</i>"
msgstr ""
"아다만틴이야. 이건 보통 물건이 아니지. 강철보다 강하고, 미스랄보다 희귀해. 이건 캐내는 게 아니야, <i>만들어지는 거지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 315f5d67-e300-6e2f-c135-2ee507ce07fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:315f5d67-e300-6e2f-c135-2ee507ce07fe
msgctxt "he92dd2ffgf887g453fg88c6gf42614fc8059"
msgid "<i>Drugnin' </i>hoon. I'll split you from head to hole!"
msgstr "<i>드루그닌</i> <i>훈</i>. 널 머리부터 똥구멍까지 반쪽을 내 주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 32d57ecd-0b30-b550-4910-290f3fbe0451
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_Adamantine = True
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:32d57ecd-0b30-b550-4910-290f3fbe0451
msgctxt "h1d9fe39dg3536g4b7fgae27g1758dea6b77d"
msgid ""
"You're after adamantine? That stuff's too fine for your lot. Best you stick "
"to scrap iron."
msgstr "아다만틴을 찾고 있나? 그건 너 같은 족속이 가지기엔 너무 비싼 물건이라고. 고철이나 모으는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 37fc00cf-5dcc-5017-9a01-1f1541694133
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:37fc00cf-5dcc-5017-9a01-1f1541694133
msgctxt "h23e0161fg2784g486fga774gf27834ef624a"
msgid ""
"Think if you respect a turd it'll smell any sweeter? Waste of bloody time."
msgstr "똥을 존중해주면 어디 단내라도 나나? 시간만 낭비했군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 386c64a1-49bf-f039-fb45-4548ac666e1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:386c64a1-49bf-f039-fb45-4548ac666e1c
msgctxt "h82e50becg8b6dg44c5ga3f7gea6e49deba92"
msgid ""
"Sure as shittin' you could deal with some stubborn rothe. Go on, get 'em "
"moving."
msgstr "똥싸듯이 저 고집덩어리 로테들도 다룰 수 있겠지. 시작해, 저것들을 움직여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Karlach
#. NodeID = 3a762a36-08f3-4734-9bbf-10e823602834
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:3a762a36-08f3-4734-9bbf-10e823602834
msgctxt "hbbd120acga543g4610g87f7g3801bab313b6"
msgid ""
"Adamantine. Bet we're near the forge. Wonder if I could melt that stuff..."
msgstr "아다만틴이야. 대장간에 가까워졌어. 내가 녹일 수 있을지 궁금하네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Lae'zel
#. NodeID = 3a8ff63e-0b84-4c40-a85e-65ecd1451643
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:3a8ff63e-0b84-4c40-a85e-65ecd1451643
msgctxt "hb60f7f9bge15ag4037gb2c5g5e0d9d47e15a"
msgid ""
"I saw it too - adamantine. The forge is behind the rubble. And the duergar "
"mean to lay claim to it."
msgstr "나도 봤다, 아다만틴이군. 잔해 뒤에 대장간이 있어. 그리고 듀에르가는 그걸 차지할 셈이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Lae'zel
#. NodeID = 405f2110-7356-ee2e-3057-c1b2581c7c50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:405f2110-7356-ee2e-3057-c1b2581c7c50
msgctxt "h54d3f57bg41a0g4fe9g89fcgfdff6116fcdd"
msgid ""
"Watch it - take the cane to those beasts again and this standoff turns to "
"slaughter."
msgstr "조심해. 저 야수들을 매질하는 순간, 이 대치상황은 살육으로 바뀔 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 4137de0e-b640-f75e-e000-c5843fd34611
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = False
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:4137de0e-b640-f75e-e000-c5843fd34611
msgctxt "h8916b780ge1c8g40a4g8318g7f2c946333b8"
msgid ""
"Well look here - Nere's killer in the flesh. Make yourself useful, grab a "
"cane and whip these <i>drugnin' </i>beasts into shape."
msgstr ""
"이거 봐라, 니어 살해자가 나타나셨네. 회초리를 하나 집어서 이 <i>드루그닌</i> 짐승 놈들을 좀 두들겨 패서 쓸모를 보여 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 41e30ca5-4f41-98c2-97cc-3caca433219d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:41e30ca5-4f41-98c2-97cc-3caca433219d
msgctxt "h30d8beb3ge63dg41f9gbd76g61e126fa2da9"
msgid ""
"You got no need to know, and I got no need to tell. So get to caning, or to "
"leaving."
msgstr "그건 네가 알 필요 없고 나도 말할 필요가 없어. 그러니 이제 채찍질을 하든가, 떠나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Narrator
#. NodeID = 48518d9a-ff50-70b3-f833-d004a48debd9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRotheGuard1_Event_PassedRubble(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:48518d9a-ff50-70b3-f833-d004a48debd9
msgctxt "hfb91ebd8g0036g472eg8d17gcc9840132366"
msgid "*A slight glint catches your eye.*"
msgstr "*작은 반짝임이 눈에 띕니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Gale
#. NodeID = 4ab9de86-0471-0dda-d761-776d5a6ce903
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:4ab9de86-0471-0dda-d761-776d5a6ce903
msgctxt "hb3ea5215g67ddg47c9g9d31g9d0b75c96707"
msgid "Another lick of the cane and those rothés are going on a rampage."
msgstr "채찍이 한 번 더 닿으면 이 로테들이 난동을 부릴 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 51648653-be9a-ad84-71e9-62c5b6b1cf36
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:51648653-be9a-ad84-71e9-62c5b6b1cf36
msgctxt "hdb777478gee37g4222g87e6g3f06814fa2cb"
msgid "You'll be feeling even worse in a moment."
msgstr "그 기분, 곧 더 나빠질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 566fabf9-29a9-25a8-cfd2-2d205e0d0edb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:566fabf9-29a9-25a8-cfd2-2d205e0d0edb
msgctxt "h8020783egc3ceg44a3g9d09g518edd1cac39"
msgid "Best if you stop whinging and get those whiskers trimmed."
msgstr "징징대지 말고 그 털이나 정리하시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 5b615b87-76be-4741-bbf5-b803e6ad33b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:5b615b87-76be-4741-bbf5-b803e6ad33b9
msgctxt "h0b8eaa11g59e3g42beg8159g3cced1f15e11"
msgid ""
"Oh aye, maybe say pretty please as well? Throw in a curtsy? Don't be soft."
msgstr "아 그래, 아양도 좀 떨고 그지? 절도 좀 해주고? 약한 소리 하지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 5c947954-eb89-6a16-c023-f3a174585ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:5c947954-eb89-6a16-c023-f3a174585ae1
msgctxt "h3e6d074ag3d28g4994g89e1gbaf14229eef2"
msgid ""
"Gettin' cramps in my arm from trying to whip the <i>drugnin</i>' beasts back "
"to work."
msgstr "<i>드루그닌</i> 짐승들에게 다시 일하라고 채찍질하다간 내 팔에 쥐가 난다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 5dead5db-0329-2fb5-e98a-e30c43d3d943
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:5dead5db-0329-2fb5-e98a-e30c43d3d943
msgctxt "h3b7c5669g2feeg4af8g9ad0g68b2895e3058"
msgid "Rest your arm. I'll put these beasts to work."
msgstr "너의 팔은 쉬고 있어. 내가 이 짐승들을 일하게 만들어줄 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 5f8a857d-565a-9124-8afa-8e158c17d423
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:5f8a857d-565a-9124-8afa-8e158c17d423
msgctxt "he8134247g4d61g495ega1a2g18be653153b1"
msgid "You want my help? Then you <i>will</i> tell me what's back there."
msgstr "내 도움이 필요해? 그럼 저 뒤에 뭐가 있는지 <i>말해야 할</i> 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 5fe83cd5-6c4d-4911-380e-7c2cbcf11eb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:5fe83cd5-6c4d-4911-380e-7c2cbcf11eb9
msgctxt "hb73e55d4gfa94g4e72g82f9g52aca41453de"
msgid "Please. Are you so feeble you can't deliver a single lash?"
msgstr "이봐. 너무 나약해서 채찍질 한 번도 못하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 60bb1f69-f30b-a9d9-196c-7d8ce6223d3e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_AgreedToHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:60bb1f69-f30b-a9d9-196c-7d8ce6223d3e
msgctxt "ha1c20bf6ge54ag4d26g83e2g99fb9e094a86"
msgid "Let's see what I can do."
msgstr "내가 뭘 할 수 있는지 보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 6657e43b-19e1-b7b7-a402-3cb27809b103
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:6657e43b-19e1-b7b7-a402-3cb27809b103
msgctxt "ha9ce61bfg89d1g4067g8e43g2361c51c8b93"
msgid ""
"Don't get any smart ideas - that forge is clan property. But get the beasts "
"moving and I'll toss some coin your way."
msgstr "잔머리 굴릴 생각하지 마. 그 대장간은 우리 일족 소유니까. 하지만 이 짐승 놈들을 움직이면 동전 몇 푼은 던져주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 69bafbe3-bd12-1bfd-79ec-0f944c3f5673
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRotheGuard1_Event_MentionedLashing(1) = True
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_AttackedDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:69bafbe3-bd12-1bfd-79ec-0f944c3f5673
msgctxt "h0ab14dbcg1731g4990g85f5g939449f53fa5"
msgid "You want to thrash me? Go on, then."
msgstr "날 때리고 싶어? 마음대로 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 6c09ab6c-93b4-ab39-3799-daa305760b12
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRotheGuard1_Event_HasMetMid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:6c09ab6c-93b4-ab39-3799-daa305760b12
msgctxt "he0634253g2cfag47ccg95dcgdb9f533d37a2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 6d7353cb-04d3-c519-4124-b072c51fe697
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:6d7353cb-04d3-c519-4124-b072c51fe697
msgctxt "h7a5b502cg9245g4eddgb957gd81fadc9f7d5"
msgid "You <i>what</i>, now?"
msgstr "지금 <i>뭐라고</i> 했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 6e64773a-9823-6798-9aa6-d1fde1ba2f70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_LearnedAboutProblem = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:6e64773a-9823-6798-9aa6-d1fde1ba2f70
msgctxt "he303472dg1dc8g42b1g8616g37799188856a"
msgid ""
"That rubble needs clearing, and my patience is hanging on by an arse whisker."
msgstr "저 잔해를 치워야 하는데, 내 인내심이 똥꼬털에 간신히 매달려 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 6ee1ce04-ebc2-7ab2-0bc7-483798ebbcd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:6ee1ce04-ebc2-7ab2-0bc7-483798ebbcd3
msgctxt "hc8b30ec0gfb05g428bga3a9g7a64ce128de9"
msgid "<i>Drugh. </i>Should'a told you to piss off when I had the chance."
msgstr "<i>드루그.</i> 진작 꺼지라고 했어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 71aa8fb5-897d-b59c-3f21-89d1b1ce4f14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#.      - DUERGARDWARF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:71aa8fb5-897d-b59c-3f21-89d1b1ce4f14
msgctxt "he26e6f29gb25cg4226g8ea7g03e3bb413d33"
msgid "A duergar asking a dwarf for help? Never thought I'd see the day."
msgstr "듀에르가가 드워프에게 도움을 청한다고? 이런 광경을 보게 될 줄은 몰랐군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 75a4e2e8-e7f2-29b0-d682-ad0b3b13e2dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:75a4e2e8-e7f2-29b0-d682-ad0b3b13e2dd
msgctxt "h9aa44d13g6493g41feg99adgc2d4e11c60ce"
msgid "Leave it to me. I'll show these deep rothé who's in charge."
msgstr "맡겨둬. 이 로테들에게 누가 대장인지 잘 알려줄 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Wyll
#. NodeID = 779c691f-145a-4e44-a0e6-d6c63a856c9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:779c691f-145a-4e44-a0e6-d6c63a856c9a
msgctxt "h7ed5bea7g8225g4522g8b97g3bb3978c5231"
msgid "Adamantine. That forge must be within spitting distance."
msgstr "아다만틴이군. 대장간이 매우 가까운 곳에 있는 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 79c961e2-16c4-cc12-f6e9-67ee3c4f7d2f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_DeclinedtoHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:79c961e2-16c4-cc12-f6e9-67ee3c4f7d2f
msgctxt "hbbd809f5g6860g4aefgbd98g9e8f5f6d8264"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 7a9285c6-9983-3f46-c0a8-277d56af15d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:7a9285c6-9983-3f46-c0a8-277d56af15d9
msgctxt "h592a532fg5dc2g4edag8b11g629ac14b05f6"
msgid "I almost feel bad about this."
msgstr "거의 기분이 나쁠 지경이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 812dcc2c-8ee5-c03c-f44e-060e17eb7972
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_SawForge = True
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_AttackedDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:812dcc2c-8ee5-c03c-f44e-060e17eb7972
msgctxt "h57c16e92g23e0g43b9g95b8g405d8d53cea7"
msgid "You want to access the forge, is that it? I've already been there."
msgstr "대장간에 도달하고 싶은 건가? 거기라면 내가 이미 다녀왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 813ad94d-d8d1-80ae-316f-4dd0e28ecb42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:813ad94d-d8d1-80ae-316f-4dd0e28ecb42
msgctxt "h921be42eg8a8fg4c73g9514g8d040f9da622"
msgid "You got your orders. I'm not taking one more whack."
msgstr "너는 명령을 받았다. 나는 더 때리지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 82bd13f7-501c-fc6d-0822-a0962024b328
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_SawForge = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:82bd13f7-501c-fc6d-0822-a0962024b328
msgctxt "h2ceaf0e3g49a7g41c0gb6d7g5b5ad419737d"
msgid "I know what you're after. There's adamantine back there, isn't there?"
msgstr "너희가 뭘 찾고 있는지 알아. 저 뒤에 아다만틴이 있는 거지, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 86bbd015-7523-f224-d3ac-f9bce66b7feb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:86bbd015-7523-f224-d3ac-f9bce66b7feb
msgctxt "h6d26203dg1968g478cg9790g35e08479823a"
msgid "Out of my way. I'll take care of the rothé."
msgstr "비켜. 내가 로테를 처리할 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 88806de4-b81a-cbed-9b87-687f9ee6db31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:88806de4-b81a-cbed-9b87-687f9ee6db31
msgctxt "hfe92834cgeedag48e1g8bfbg2abfc2deab35"
msgid ""
"Just because we don't waste time prettifying things doesn't mean we can't "
"make use of good ore."
msgstr "미사여구에 시간 낭비를 안 한다고 해서 그게 좋은 원석을 못 쓴다는 말은 아니거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 8b99d8dd-bbbb-f374-d01f-c78fb0eadb38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = False
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = False
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:8b99d8dd-bbbb-f374-d01f-c78fb0eadb38
msgctxt "hdd2a7e54gc7f7g4729g98b3g860af8e7d8a4"
msgid "Let 'em clear the rubble. Then you'll get what's coming to you.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 8bce2866-6162-16a0-4d70-c6aa8f69dd9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BESTIAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:8bce2866-6162-16a0-4d70-c6aa8f69dd9b
msgctxt "h86425bd8g0808g4b80g9a96g482e62a1dfeb"
msgid "A brute? Is that what you see?"
msgstr "야수? 너한텐 그래 보이나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 8c0f8689-270f-afc5-f8d9-7e5bfe9111bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:8c0f8689-270f-afc5-f8d9-7e5bfe9111bc
msgctxt "hc38163b3g41b9g4662g8893gbfe5c220db9f"
msgid "Fine. Look at this."
msgstr "좋아. 이걸 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 8c7c94f9-1b7a-b59d-2f9f-c2b8c70faf8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = True
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:8c7c94f9-1b7a-b59d-2f9f-c2b8c70faf8e
msgctxt "hc038824dg1b11g4a48g9180g3b9c5744f119"
msgid "Not enough caning for my tastes, but you got the job done."
msgstr "내 기준엔 못 미치지만, 어쨌든 일을 끝마쳤군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 8e2bc820-b856-8c53-5c57-2cc9d84b0807
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:8e2bc820-b856-8c53-5c57-2cc9d84b0807
msgctxt "h2ee71deegb9ceg46c9ga2e5g0ec0d4401d0e"
msgid "What in the hells? I helped you, and now you want me dead?"
msgstr "뭐야? 내가 널 도와줬더니, 이제 날 죽이겠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Karlach
#. NodeID = 91b9f6f1-f0b7-7707-d40e-6012345c9484
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:91b9f6f1-f0b7-7707-d40e-6012345c9484
msgctxt "hbde8c350ge345g4a4ag8372g92a845aa5be5"
msgid ""
"If he winds up, I'm gonna snap his neck - if the rothé don't stomp his "
"lights out first."
msgstr "계속 저러면, 내가 목을 부러뜨리겠어. 로테가 먼저 저 놈을 걷어차서 혼절시키지 않는 한."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 92212b29-e864-f5cb-94d5-e789676b3c86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:92212b29-e864-f5cb-94d5-e789676b3c86
msgctxt "h57e82461g56bbg4771gb00fg0c2229963273"
msgid ""
"There's no denying the blood-call. And there's no shame in it. Now go on, "
"brute, and get these beasts moving."
msgstr "피의 부름은 거부할 수 없지. 부끄러운 일도 아니고. 이제 시작해, 야수, 요 짐승들을 움직여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 948fdcf9-701a-464e-459e-b0df1b2ef3a4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRotheGuard1_Event_MentionedLashing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:948fdcf9-701a-464e-459e-b0df1b2ef3a4
msgctxt "hb8135a13g92e7g4b79ga27fg3b7bf774964e"
msgid "Don't think I won't thrash you harder than the rothé."
msgstr "내가 너를 로테보다 약하게 때릴 거라고 생각하지는 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 96320a5e-07ab-5b1f-b287-5e572160386a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:96320a5e-07ab-5b1f-b287-5e572160386a
msgctxt "h7de3ede4gda0cg4c41g8b49g47afb6f2b681"
msgid "What's behind the rubble, anyway?"
msgstr "이 잔해 뒤에는 대체 뭐가 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Astarion
#. NodeID = 9753a597-54a1-1bd4-51a4-c6952c947ff3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:9753a597-54a1-1bd4-51a4-c6952c947ff3
msgctxt "he17938f2gdff1g4e6dg9a82gee4a8ee10b19"
msgid "Just as well, perhaps. Beat anything for long enough and it'll snap."
msgstr "오히려 잘 됐는지도 몰라. 뭐든 오래 때리면 부러지는 법이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 992d6e6b-eb5f-16cc-6ac7-18f23eaad5a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = False
#.   Global:
#.      - UND_FearfulRothe_State_PlayerAttackedRubbleBeforeTalkingToTaskmaster = True
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:992d6e6b-eb5f-16cc-6ac7-18f23eaad5a0
msgctxt "hb01d8a8egf801g47c9g8892g4cc0925d38ad"
msgid ""
"How about you stop making messes? Grab a cane and whip these beasts into "
"shape."
msgstr "말썽 좀 그만 피우지? 회초리를 하나 집어서 이 짐승 놈들을 좀 두들겨 패줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 99963171-ee83-9c4e-1af9-a1e33a8e3fbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:99963171-ee83-9c4e-1af9-a1e33a8e3fbc
msgctxt "h0c62339eg64b6g4ff5ga337gc524255b87b1"
msgid ""
"Stuff's no joke. Stronger than steel, rarer than mithral. It ain't mined - "
"it's <i>made.</i>"
msgstr "이건 보통 물건이 아니지. 강철보다 강하고, 미스랄보다 희귀해. 이건 캐내는 게 아니야, <i>만들어지는 거지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = 9e1149e8-e45b-79a7-388a-acbb96bdf4c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:9e1149e8-e45b-79a7-388a-acbb96bdf4c8
msgctxt "hb2cd2ea0g8355g43cfgab01ge7895c7ed76f"
msgid "Just splittin' then? Suit your damn self."
msgstr "그냥 간다고? 맘대로 하셔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = 9f92bad9-3caa-264c-db16-ac0ee922bccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:9f92bad9-3caa-264c-db16-ac0ee922bccd
msgctxt "hd0cdbcd9g48e0g4719gb680g53318e00bd41"
msgid "Do your own dirty work."
msgstr "네 잡일은 네가 알아서 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = a1497376-0be0-ff4c-57a3-68cc13c4404e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRotheGuard1_Event_HasMetMid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:a1497376-0be0-ff4c-57a3-68cc13c4404e
msgctxt "h52eca486gfec5g4c8agba91g9041abf94a52"
msgid "Go on, get 'em moving."
msgstr "어서, 놈들을 움직여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = a214d8b3-cd09-c0c3-879d-bd5f2a3214ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:a214d8b3-cd09-c0c3-879d-bd5f2a3214ff
msgctxt "h0f4d5baag9597g4ac8gb5a3g8eed6b196019"
msgid "Damned right I do."
msgstr "그렇고말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = a341db46-2a51-6c30-90da-c354862cf748
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:a341db46-2a51-6c30-90da-c354862cf748
msgctxt "h1ddd4128gaba9g489cga97fg97167d57c1fd"
msgid "What in the hells are you turning on <i>me</i> for?"
msgstr "대체 어째서 <i>나를</i> 공격하려는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = a44b4511-0df1-9efa-3716-4181abb38404
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = False
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_001(1) = True
#. TagRule: GNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:a44b4511-0df1-9efa-3716-4181abb38404
msgctxt "he86be47eg30cbg45a8g9b90g75b769eff2fe"
msgid ""
"I saw you scuttling over, <i>urop</i>. Grab a cane and whip the beasts into "
"shape."
msgstr "뽈뽈거리는 거 다 봤다, <i>우롭</i>. 회초리를 하나 집어서 이 짐승 놈들을 두들겨 패라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = a44b4511-0df1-9efa-3716-4181abb38404
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = False
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:a44b4511-0df1-9efa-3716-4181abb38404
msgctxt "h9d7c1196g7f3eg403fg8db2g229282bed241"
msgid "You - grab a cane and whip these <i>drugnin' </i>beasts into shape."
msgstr "거기 너, 회초리를 하나 집어서 이 <i>드루그닌</i> 짐승 놈들을 좀 두들겨 패줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = a67ed0c7-09c1-9627-a152-b2bfe4b1424f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:a67ed0c7-09c1-9627-a152-b2bfe4b1424f
msgctxt "h3c391a23g72edg4ca9g863fgbf98501232a6"
msgid "Grab a cane and get these rothé moving!"
msgstr "회초리 집어서 이 로테 녀석들 좀 움직여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Shadowheart
#. NodeID = a6963675-75af-44bc-8cec-a393b950b138
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:a6963675-75af-44bc-8cec-a393b950b138
msgctxt "hb1f9a035g6d03g48d3gabf9g4614c37ab25f"
msgid "Adamantine. We must be nearing the forge."
msgstr "아다만틴이군. 대장간이 근처에 있는 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = aac60d15-ff6d-5c46-63f5-aa8e7080e4dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:aac60d15-ff6d-5c46-63f5-aa8e7080e4dd
msgctxt "h632d02eege6d4g41e9ga548g576695e0c1d7"
msgid ""
"Sure as shittin'. One look from you'd send half this place runnin'. Bloody "
"handy, that."
msgstr "두말하면 똥을 싸지. 한 번 보면 여기 있는 절반이 줄행랑을 칠걸. 거 아주 좋구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = aadcbcfe-abbf-f71b-21c8-43d233be0d60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet2_Guard01(1) = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:aadcbcfe-abbf-f71b-21c8-43d233be0d60
msgctxt "haa807bf5gab0fg45b4g8df4gba45093197eb"
msgid "Get to caning, or to leaving."
msgstr "매질을 하던지, 여기서 꺼지던지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = aadcbcfe-abbf-f71b-21c8-43d233be0d60
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet2_Guard01(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:aadcbcfe-abbf-f71b-21c8-43d233be0d60
msgctxt "ha9b13694g26d3g4dd0gbb3egbb6c50c0f9f8"
msgid "Get to caning or to leaving, <i>hoon.</i>"
msgstr "매질하든지, 아니면 꺼져라, <i>훈.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = aff36193-4583-ca81-85c3-23d732e7159b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRotheGuard1_Event_PassedRubble(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:aff36193-4583-ca81-85c3-23d732e7159b
msgctxt "h01382220g8137g423cg93acg893780a9b4f9"
msgid "<i>Focus on the glint.</i>"
msgstr "<i>반짝임에 집중한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = b10853ad-f1f6-f4ea-4dd4-e623b1831445
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:b10853ad-f1f6-f4ea-4dd4-e623b1831445
msgctxt "h6cfd5202g3c1dg4ab5ga056g71da378b1e26"
msgid "Go on, then - light a fire under the buggers."
msgstr "그럼 진행해. 이 녀석들에게 불을 피워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = b144606c-2263-ebf0-73e0-d79b21cc711b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = False
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = True
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:b144606c-2263-ebf0-73e0-d79b21cc711b
msgctxt "h58b66f60g87bdg4ebeg9c85g7b5f3274fd93"
msgid "Well lookie there - and not one crack of the cane."
msgstr "이것 좀 보라지, 채찍 자국 하나 안 났네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = b9b586d7-9e70-96f1-16b5-d0e6d9e488e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRotheGuard1_Event_MentionedLashing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:b9b586d7-9e70-96f1-16b5-d0e6d9e488e8
msgctxt "hcdc0f488gf214g4b4bgb9ebgb801f76da38e"
msgid ""
"And it sounds like your arse wants for a lashing, the way you talk out of it."
msgstr "그리고 등신 같은 넌 말투를 보아하니 채찍을 맞고 싶은가 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Gale
#. NodeID = bc65729b-f255-402e-ae94-5dc94c9f3516
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:bc65729b-f255-402e-ae94-5dc94c9f3516
msgctxt "h77c83c3cg6cbeg4cbbg81d1g6193964ca1eb"
msgid ""
"You saw it too? The fabled adamantine forge is around the bend. We just have "
"a few snags to untangle."
msgstr "너도 봤어? 전설적인 아다만틴 대장간 근처까지 왔다고. 실밥 몇 개만 풀어내면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = bf2d910c-afe6-db62-5ba4-731f7272611d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_001(1) = True
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:bf2d910c-afe6-db62-5ba4-731f7272611d
msgctxt "hb0525a5ag6926g40afgbfb4g9512ace93d6d"
msgid "Just you wait for what happens next."
msgstr "무슨 일이 일어날지 기다리기나 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = c3d7bfaa-5c86-7016-c2fe-65da1a2deb0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:c3d7bfaa-5c86-7016-c2fe-65da1a2deb0a
msgctxt "h09caf98cge00dg46acg9eb6g7e60ef1946cc"
msgid "Almost sounds like you're asking for help, if I ignore your tone."
msgstr "네 말투만 아니었다면, 부탁하는 걸로 들어줬을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = c46010da-b2df-f51f-dbbb-ae7ef30f73a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:c46010da-b2df-f51f-dbbb-ae7ef30f73a9
msgctxt "h197dc8a8g65bfg4ceegbc89g83e08172ffe4"
msgid "You want me to cane these poor beasts?"
msgstr "이 불쌍한 야수들에게 채찍을 휘두르라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = c552cf24-4152-5ff8-1ab7-72cae2a1a375
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:c552cf24-4152-5ff8-1ab7-72cae2a1a375
msgctxt "hcaa4d95bgcf24g4a6bg9d15g374e1a323ccf"
msgid ""
"<i>Call on the parasite, connect with the taskmaster. What does he seek?</i>"
msgstr "<i>기생충을 불러내, 작업 감독의 정신을 들여다본다. 그가 뭘 찾고 있는 것일까?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = c6ae4442-efa1-b5ab-eb73-49475dbccf94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:c6ae4442-efa1-b5ab-eb73-49475dbccf94
msgctxt "he0c4d812g2498g463aga7aeg56a98ae5a884"
msgid "Perhaps you should just try asking them instead."
msgstr "그냥 부탁을 하는 편이 나을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Narrator
#. NodeID = c6e1fdb0-ddad-a6bd-a1ac-301dda65b09b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:c6e1fdb0-ddad-a6bd-a1ac-301dda65b09b
msgctxt "h467eb5ddgfbb8g47d0g8a0cg3d424213e6cb"
msgid "*The glint fades before your eye finds its source.*"
msgstr "*근원을 찾아내지 못하고, 반짝임이 사라져 버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = c80baec0-841c-cbc5-ef4d-ab73b51ebcc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_SawForge = True
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_AttackedDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:c80baec0-841c-cbc5-ef4d-ab73b51ebcc4
msgctxt "hd5155ff9g81f3g4a66ga2c0gcf8433d2ea9c"
msgid "You can't keep me from the forge - I've already found it."
msgstr "날 대장간에서 떼 놓을 순 없어. 이미 찾았거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = c822340f-60b1-a963-3b13-afa13358a0c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:c822340f-60b1-a963-3b13-afa13358a0c8
msgctxt "hd3765922gb984g4cf1g8e73g87f39e841119"
msgid "Sure as shittin'. That orc blood makes you damn near feral."
msgstr "두말하면 똥을 싸지. 그 오크 피가 널 거진 흉포하게 하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = ccb960e9-ff33-fabf-e0d3-700342ccfd16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:ccb960e9-ff33-fabf-e0d3-700342ccfd16
msgctxt "h9f2f275ag8d88g45a2g8f5dgfdbd42bbea93"
msgid "Shit. You calling me weak, <i>jargh?</i>"
msgstr "제길. 약하다고 했냐, <i>자그?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = cdca64e0-6c6a-b3a7-bffa-580425b706dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:cdca64e0-6c6a-b3a7-bffa-580425b706dc
msgctxt "h93854d1eg0a42g4bfeg9c6dgf465ce953b6f"
msgid ""
"Something's spooked the dumbshits. So stop your jawin', and get to workin'."
msgstr "이 등신들이 왠지 모르겠지만 겁에 질렸어. 그러니 아가리 그만 털고, 일을 하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Astarion
#. NodeID = cde10876-a23b-4a07-b727-458eb0bc722b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:cde10876-a23b-4a07-b727-458eb0bc722b
msgctxt "h9d42a77cg7b67g42fegb748g82ab8975d5b7"
msgid "Well would you look at that. The forge can't be far now."
msgstr "저것 좀 보라고. 대장간이 가까이에 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = d12e0767-5011-bae6-cb63-450066a81cea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_Event_DeclinedtoHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:d12e0767-5011-bae6-cb63-450066a81cea
msgctxt "hd60af770g1a0ag4f18g8626g05d0df6cd629"
msgid "If you ain't helping, piss off."
msgstr "도와줄 게 아니라면, 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = d27c4423-ecfb-098d-aa0f-4cda74371bcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:d27c4423-ecfb-098d-aa0f-4cda74371bcd
msgctxt "hae172d94g5ce0g4902gb67fgd29d71dfb04f"
msgid "You want my help? Then you <i>will</i> tell me what's back there."
msgstr "내 도움이 필요해? 그럼 저 뒤에 뭐가 있는지 <i>말해야 할</i> 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Narrator
#. NodeID = d549127f-72a6-2cb1-5d58-0c3133d31f27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:d549127f-72a6-2cb1-5d58-0c3133d31f27
msgctxt "h8af17ce2g50ddg4c8bg93ccg06dedf99c36d"
msgid "*You see only the most mundane of rocks and minerals.*"
msgstr "*평범한 암석과 광물밖에 보이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = d767fd85-bfe3-b95b-8b3c-f7c9487bc1b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_DeclinedtoHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:d767fd85-bfe3-b95b-8b3c-f7c9487bc1b2
msgctxt "hbff8ac37g08fdg4879g9e6agdd57bdd5c80c"
msgid "Sounds like your problem. Figure it out yourself."
msgstr "네 문제인 것 같은데. 알아서 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = d7ab71c9-69a0-4cc1-b702-3888a8f59c46
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRotheGuard1_Event_ExaminedRubble(1) = False
#.   Tag:
#.      - DUERGARDWARF(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRotheGuard1_Event_ExaminedRubble(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:d7ab71c9-69a0-4cc1-b702-3888a8f59c46
msgctxt "haba63d52g5988g4cd9g8247g09286b3f4e00"
msgid "<i>Examine the rubble for anything unusual.</i>"
msgstr "<i>잔해에 이상한 점은 없는지 관찰해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = dacd73c4-23e4-0591-3777-e67d2366fac0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet2_Guard01(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:dacd73c4-23e4-0591-3777-e67d2366fac0
msgctxt "hf73dbd8eg68acg4811g86b2g5112c4eaab55"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = e4b7f778-0660-12e2-230f-dc8564d5721e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:e4b7f778-0660-12e2-230f-dc8564d5721e
msgctxt "hbd1f4157gaa20g4239ga953g792055d4d317"
msgid "Keep this between us or you'll never see another day - got it?"
msgstr "다른 이들에게 이 사실을 말했다간 목이 달아날 줄 알아, 알겠냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = e5e0722d-6b2f-b163-f5b2-9fc70d9036cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:e5e0722d-6b2f-b163-f5b2-9fc70d9036cb
msgctxt "h80ff7f36g0391g40efgb31fg7f0481aa9b23"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Player
#. NodeID = e946d8a5-4263-c3dd-312d-9a2b5f193e96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:e946d8a5-4263-c3dd-312d-9a2b5f193e96
msgctxt "h82b301e7g0b25g49e8ga996gfae976481c94"
msgid ""
"I know these creatures well. You should give them another lash of the cane."
msgstr "난 이 생물들에 대해 잘 알고 있어. 그 회초리로 한방 더 먹여줘야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = eae36be2-a05c-b44d-891f-2a3641e4115d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:eae36be2-a05c-b44d-891f-2a3641e4115d
msgctxt "hbfc73359gd111g420agb7a2g35891e330432"
msgid ""
"You're one of Nere's, eh? Don't go bursting those head-veins - I ain't "
"joined your bat-brained cult."
msgstr "넌 니어와 한패로군 그래? 머리를 들쑤시고 다니지 말라고, 난 너희 정신 나간 교단과 상관없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = f3712f30-22e1-c5c8-e0f9-ba7103a37525
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#.     - UND_AdamantineForge_Knows_Adamantine = True
#.     - UND_FurnaceSearch_Event_DuergarMentionsForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:f3712f30-22e1-c5c8-e0f9-ba7103a37525
msgctxt "h63eeed43g3d1cg4925gb906ga8cf46985078"
msgid ""
"There's an adamantine forge back there, <i>jargh. </i>And I'm not the "
"sharing type."
msgstr "저 뒤에 아다만틴 대장간이 있다, <i>자그. </i>그리고 난 공유하는 성격은 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Shadowheart
#. NodeID = f9510684-f980-2a55-3344-098b30153e95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:f9510684-f980-2a55-3344-098b30153e95
msgctxt "h5f33b767g4f64g4bd6g9919gefa37b84059f"
msgid ""
"Fool. He should've used the threat of the cane over the cane itself. Now "
"those beasts are ready to charge."
msgstr "멍청하기는. 그는 회초리 자체보다 회초리의 위협을 이용했어야 했어. 지금 이 야수들은 돌진할 준비가 됐을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001
#. Speaker = Herdmaster Skarjall
#. NodeID = fc2a6079-48ef-4f49-3355-5f68e4462093
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001:fc2a6079-48ef-4f49-3355-5f68e4462093
msgctxt "h9a089ec8g1cc0g430egbffbg2d1817c7ef9a"
msgid ""
"Volunteering, are you? Well we ain't getting paid to flirt. Might not get "
"paid at all, with this mess."
msgstr "정리해 준다고? 작업 건다고 우리한테 돈 안 나와. 이 꼬락서니론 한 푼도 못 받을 테고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Player
#. NodeID = 0a46f6d9-4de2-40ec-a143-9d81e2c6a3b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:0a46f6d9-4de2-40ec-a143-9d81e2c6a3b7
msgctxt "h4f0e8708gd4f1g43dfgb421g4d79210f53e0"
msgid "How long have you been here?"
msgstr "여기 얼마나 오래 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Player
#. NodeID = 1429e483-5222-0fd7-f95d-5c9d703fbc61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRotheGuard001_Event_MentionedForge(1) = True
#.   Global:
#.      - UND_TheDrowNere_Event_HadMindMeld = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:1429e483-5222-0fd7-f95d-5c9d703fbc61
msgctxt "h17131575gf7b4g496cg9638g8a52353282f1"
msgid "Did True Soul Nere send you after the forge?"
msgstr "참된 영혼 니어가 대장간을 찾으라고 너를 보냈나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Player
#. NodeID = 1b2763db-0a8d-41b8-aa4b-4ef893fec5e8
