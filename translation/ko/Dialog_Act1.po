msgctxt "h3d24b51fg76b6g4e14gb0c1ge5ec3838eb25"
msgid "Open it up then! It's <i>all yours</i>."
msgstr "그럼 열어 봐! <i>다 네거야</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 2efbf880-edb3-38b7-1e79-566d87b8b767
