msgctxt "h13f4739ag3c0ag49b5g9198g9013f44e3d96"
msgid "The Absolute? Not bloody likely. Get her, fellas!"
msgstr "절대자라고? 아닌 것 같은데. 얘들아, 저년을 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 69b54eec-8831-817a-01e0-fc7368561428
