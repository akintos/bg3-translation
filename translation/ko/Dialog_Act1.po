msgctxt "hea2aed39g4c03g4abdgad11g0eb8eff80dd8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_DuergarBoatAtCave
#. Speaker = Narrator
#. NodeID = 8594330b-c91f-4dca-be6c-a765cd397d77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_DuergarBoatAtCave:8594330b-c91f-4dca-be6c-a765cd397d77
msgctxt "hebeda21dg590fg45ebga07fg31c0e9526c81"
msgid "*The boat is ready to sail.*"
msgstr "*배가 항해할 준비를 마쳤습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_DuergarBoatAtCave
#. Speaker = Player
#. NodeID = 9e50491c-2432-4cad-8070-56bdff45de41
