msgctxt "h544210a5g699eg4e88g9629g7bcc4ed15a7f"
msgid "A dragon-rider - my kin are near."
msgstr "드래곤 라이더다. 동족이 근처에 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
