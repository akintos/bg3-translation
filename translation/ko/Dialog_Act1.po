msgid "Squished the mutineers flat. What I like to see."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalNervous
#. Speaker = Drar
#. NodeID = 2fb4da77-1b8b-d9d7-3ac9-87e2b969e5ac
