msgctxt "h6175e8f1g4b00g4af2gaa0cg48c435d38909"
msgid "A shrine to Selûne in a grotto like this?"
msgstr "이렇게 작은 동굴에 셀루네의 성소가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = bed9db99-9a77-2def-4952-17de1d7364b8
