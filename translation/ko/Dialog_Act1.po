#.      - UND_FurnaceSearch_State_DisguisedJournalIllusionDropped = False
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:859e3f8b-95cb-e792-be1f-1de91a4c7736
msgctxt "h80fae677g4785g44d4g8b8bg9b7dd0013ccb"
msgid "<i>Recall what you know of this title.</i>"
msgstr "<i>이 제목에 대해 아는 바를 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = c9e04e07-77a4-5223-ef29-96285ff98fd2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_State_DisguisedJournalIllusionDropped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:c9e04e07-77a4-5223-ef29-96285ff98fd2
msgctxt "h2afc12fcgee64g4a83gb373g9b7b36fb192e"
msgid ""
"*The scrutiny proves too much. The lurid text melts away before your eyes - "
"an illusion.*"
msgstr "*정밀한 검토 끝에 진실이 드러납니다. 교미 의식에 대한 선정적인 글이 눈앞에서 사라집니다. 환영이었던 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = d0444fd4-bf55-1fff-7af9-64dad5ea3e4c
#. HandlePath = TaggedText[0].TagText[0]
