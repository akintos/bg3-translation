msgctxt "hf49afb88gfff8g4ad0gab82gd5e2f64b7f04"
msgid "Your mind is <i>mine</i>."
msgstr "네 정신은 <i>내 것이다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_AD_TemplarCombatSecondLine
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 3106d930-03f2-4f5c-9eda-37e77426447e
#. HandlePath = TaggedText[0].TagText[0]
