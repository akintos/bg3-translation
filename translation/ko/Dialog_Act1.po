msgctxt "h124f05e0gab1ag449cga879gc5add24ca63e"
msgid "A bone. Dry and brittle."
msgstr "뼈야. 건조하고 금방 부서질 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
#. Speaker = Player
#. NodeID = 7a77eca7-ed85-87f3-b85d-b638eb2623f0
