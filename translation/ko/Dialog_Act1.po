msgctxt "hb8482bf6g24ffg46c9gb7adgacc874a4f0df"
msgid "I could run the shop again. That is - help Derryth."
msgstr "상점을 다시 운영할 수도 있어. 그렇게, 데리스를 돕는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 8cd3fc66-669b-a99c-0daa-183e8fe50341
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:8cd3fc66-669b-a99c-0daa-183e8fe50341
msgctxt "h988b446agcc2fg4b33g9cbbg759b2202d782"
msgid "<i>Help </i>me? My - yes, my mind isn't what it used to be."
msgstr "날 <i>돕는다고</i>? 내 - 그래, 내 정신이 예전 같지 않지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 92d10751-d214-1bda-bf1c-4c471b470ee0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:92d10751-d214-1bda-bf1c-4c471b470ee0
msgctxt "hccfa8c92gfb50g4fe0g9502g4eb63065c307"
msgid "My bag. Please!"
msgstr "내 배낭. 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 947051bc-dcc5-404d-2539-a16e0112b7bb
#. HandlePath = TaggedText[0].TagText[0]
