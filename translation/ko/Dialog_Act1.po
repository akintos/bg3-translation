msgctxt "h6601f658g0255g435fg884bg5403a6592876"
msgid ""
"A concealing spell, is it? Still, this is the book the dead drow mentioned."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_DisguisedJournal
