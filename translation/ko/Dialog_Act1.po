msgctxt "h4d7812d8g50a4g4706gb415g8f383d031c3e"
msgid "Don't worry. I won't harm you."
msgstr "걱정 마. 나는 널 해치지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Scared Boar
#. NodeID = 12e9b87b-43fe-bb90-c0cb-f03b5078361e
