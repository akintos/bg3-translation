msgctxt "hebdb8dcfg78a9g447agb92cgb635904fd2b1"
msgid "Drop your weapons!"
msgstr "무기를 버려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Gauntlet Dion
#. NodeID = 8b706313-317a-2991-f022-720aa209eca6
