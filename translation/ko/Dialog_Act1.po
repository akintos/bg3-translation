msgctxt "he3419cf2gb438g4410g9cf4g79861069eaf4"
msgid "I couldn't be more ready to leave."
msgstr "당장이라도 여기 뜰 준비 되어 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_2
#. Speaker = Bex
