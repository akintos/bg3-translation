msgctxt "h53036dc7ga41bg4124ga686g1264791ee233"
msgid "Now, who <i>actually </i>got me out of here?"
msgstr "자, 누가 <i>진짜로</i> 나를 여기서 꺼내 준 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarGuardSergeantAndTheDrow_AD
