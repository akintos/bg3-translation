msgctxt "h626bd74bg76f2g4256gb021gc1e94df66d10"
msgid "Hmm. Got the metal, got the mould... but missing something."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = 9f1df3e0-76fe-b5d4-ee81-3b13d33a9b2d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
