msgctxt "ha5664458g4988g4011g9a7eg4081d13dc9f4"
msgid "What were you doing in the forest?"
msgstr "숲에서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Brynna
#. NodeID = 347e682e-75cf-cf4f-181d-303277afca35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:347e682e-75cf-cf4f-181d-303277afca35
msgctxt "hcd01283eg2cb7g4c04gabbcgc4c372b5c299"
msgid "Serving... the Absolute... following... Her True Souls..."
msgstr "절대자를... 섬기고... 그분의 참된 영혼들을... 따르며..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Narrator
#. NodeID = 447c156d-8d50-3391-da34-38a4977ebb32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:447c156d-8d50-3391-da34-38a4977ebb32
msgctxt "h9f37736ag949bg44b8g9306g8bc53b6da324"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Player
#. NodeID = 4b8521cc-c456-6eda-a414-e2622086919e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - fa6e2ce0-64f3-bfb8-fb47-10f50f02cadf_TrueSoulMentioned = True
#.     - fa6e2ce0-64f3-bfb8-fb47-10f50f02cadf_AbsoluteMentioned = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:4b8521cc-c456-6eda-a414-e2622086919e
msgctxt "h03d4aec3g303cg4698ga868g8ee8e7516c07"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Narrator
#. NodeID = 60ff9f1c-7822-e66e-9e79-304609b245b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:60ff9f1c-7822-e66e-9e79-304609b245b0
msgctxt "h842716e2geca9g41c2gb3c0g78ae592eae2d"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Player
#. NodeID = 89698a55-f07d-d370-86a0-32898873d912
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fa6e2ce0-64f3-bfb8-fb47-10f50f02cadf_AbsoluteMentioned = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:89698a55-f07d-d370-86a0-32898873d912
msgctxt "h9a9138cbg1682g43c1g93cag57af35c6dc27"
msgid "Tell me about the Absolute."
msgstr "절대자에 대해 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Brynna
#. NodeID = 9cec2a98-1112-0b68-0c16-e1cfce23ca5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:9cec2a98-1112-0b68-0c16-e1cfce23ca5a
msgctxt "h4f583c9egbe5eg4b26g9029gb1db054f9a46"
msgid "The Absolute's... chosen few... my brother... they hear... Her words..."
msgstr "절대자에게 선택받은... 소수의 사람들... 나의 형제... 그들은... 그분의 목소리를 들어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Player
#. NodeID = be3263b9-9ba9-2b7e-686a-091060c5e326
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:be3263b9-9ba9-2b7e-686a-091060c5e326
msgctxt "hcf3d562cgd4c3g4098ga7cag42ad6027e21c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Brynna
#. NodeID = c45e72e5-3117-d3b7-c85c-e76b3136a967
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:c45e72e5-3117-d3b7-c85c-e76b3136a967
msgctxt "he53f27bfga4dag4e2bgb990g7f71255e8707"
msgid "Brynna... a faithful... servant to... the Absolute..."
msgstr "브리나... 절대자의... 신실한... 충복..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Brynna
#. NodeID = c85cdff8-3603-9ad7-a3f1-0201fa50c66b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:c85cdff8-3603-9ad7-a3f1-0201fa50c66b
msgctxt "h01b9c347gddf1g4cf0gb294g0a049139d0a1"
msgid "Our leader... our goddess... our future... bow to her... or die..."
msgstr "우리의 지도자... 우리의 여신... 우리의 미래... 그분께 절하거나... 아니면 죽어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Narrator
#. NodeID = d0d905a2-27d8-606e-67a9-c22933146d9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:d0d905a2-27d8-606e-67a9-c22933146d9d
msgctxt "h882f0c18g8b18g4893g95c1gcc603cd4e679"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
#. Speaker = Narrator
#. NodeID = f4faa226-cc24-4bc6-3b6e-e00463d75d31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead:f4faa226-cc24-4bc6-3b6e-e00463d75d31
msgctxt "h1e0a9516gf737g4b06ga986g08315a15e211"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 0076ab6f-8c2c-08cb-2c94-1ea202bc5e06
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:0076ab6f-8c2c-08cb-2c94-1ea202bc5e06
msgctxt "hdf00156ag67a0g4e35g87deg07307b9430a7"
msgid "What would you have of us now, sir?"
msgstr "이제 뭘 하면 되겠습니까, 나리?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 0076ab6f-8c2c-08cb-2c94-1ea202bc5e06
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:0076ab6f-8c2c-08cb-2c94-1ea202bc5e06
msgctxt "h457eadeegde1dg4bb0gad61ge4174ee74b17"
msgid "What would you have of us now, madam?"
msgstr "이제 뭘 하면 되겠습니까, 마님?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 0076ab6f-8c2c-08cb-2c94-1ea202bc5e06
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:0076ab6f-8c2c-08cb-2c94-1ea202bc5e06
msgctxt "h85e6448fge5a7g4cb4g9abfg8e78cbb3316c"
msgid "What would you have of us now, True Soul?"
msgstr "이제 어떻게 할까요, 참된 영혼님?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = 01ec8530-128f-7245-6cf0-25cc22669238
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:01ec8530-128f-7245-6cf0-25cc22669238
msgctxt "haacd537fg0165g4ba7ga40ag9c9f2235cd91"
msgid "Continue your duties in the area - whatever those are."
msgstr "뭐였든 간에, 너희가 이 지역에서 진행 중이던 임무를 계속하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 020f0a03-1ff1-827c-bb33-11e35028abe8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_PriestsConqueringGod_GoToGoblinCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:020f0a03-1ff1-827c-bb33-11e35028abe8
msgctxt "hb1618588g3c4fg43a5g99c5gc5afbf4ae2ea"
msgid "Go safely, True Soul."
msgstr "안전히 가십시오, 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = 0c85a3a4-34d3-1d76-7317-234679b589a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:0c85a3a4-34d3-1d76-7317-234679b589a2
msgctxt "hd2e511f2g3789g4da4gba01g5cb5ef0c57a4"
msgid "That's right. He's safe now. Blessed."
msgstr "맞아요. 이제 그는 안전해요. 축복을 받은 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Andrick
#. NodeID = 134f8f24-eecb-42db-3a0e-d25af54f0be3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:134f8f24-eecb-42db-3a0e-d25af54f0be3
msgctxt "ha690c1d1gd322g4530ga211g55d44b4ef5db"
msgid "Yes, we'll praise you in our prayers, True Soul."
msgstr "알겠습니다. 당신을 찬양하며 기도하겠습니다, 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = 14cce963-1776-c21c-b658-3aa8f3359dd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:14cce963-1776-c21c-b658-3aa8f3359dd6
msgctxt "hdcc9d17cg5b3dg4213ga4a9g6ed561e934df"
msgid "What were you doing before the owlbear attacked?"
msgstr "아울베어에게 공격받기 전에는 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Andrick
#. NodeID = 239e8269-e5a5-7c64-5846-6de0b068f546
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:239e8269-e5a5-7c64-5846-6de0b068f546
msgctxt "hf9d009a7g79d2g4c9ag9315g5347b42ddfc3"
msgid ""
"What? <i>You...?</i> But that means... I have to stop you. For the Absolute!"
msgstr "뭐라고요? <i>당신이...?</i> 그렇다는 건... 제가 당신을 막아야 한다는 거군요. 절대자님을 위해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 3485093f-6aa9-7267-61e3-5ff7e68d052b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_PriestsConqueringGod_GoToGoblinCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:3485093f-6aa9-7267-61e3-5ff7e68d052b
msgctxt "h06031555g080eg4f39gbbe8g93c08eedc146"
msgid "Absolute protect you."
msgstr "절대자님이 당신을 보호하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 3baab6aa-0f39-fed0-2613-83aa87f01508
