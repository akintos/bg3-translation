#. CheckFlags:
#.   Dialog:
#.      - GOB_ConcubineLush_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinLush:aefc5b9c-e8fe-ee34-6a4f-514b4d1f0cdf
msgctxt "hca0ff27fg86f1g4ac9g9bacg6a45704598d3"
msgid "I'm workin'."
msgstr "일하고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriestOgre
#. Speaker = Polma
#. NodeID = 69e64410-b525-213d-8f11-c9eb96ae1596
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Quest_PlayersChainedAlone = True
#.   Object:
#.      - GOB_GoblinPriest_Quest_WasChained(1) = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriestOgre:69e64410-b525-213d-8f11-c9eb96ae1596
msgctxt "hdb183f28g3718g4327ga8bagb2e8a7f874f4"
msgid "You. Not supposed to be here. Leave!"
msgstr "너. 여기 있으면 안 된다. 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriestOgre
#. Speaker = Polma
#. NodeID = d2003778-d024-dfc3-d05d-45735d2cc17c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Quest_WasChained(1) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriestOgre:d2003778-d024-dfc3-d05d-45735d2cc17c
msgctxt "h91d2628fgf90eg48f1g94b8g057e32c7c610"
msgid "You broke free? You die!"
msgstr "빠져나오다니? 너 죽는다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 0d56e903-7419-c8b9-263b-6c4411a53cc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:0d56e903-7419-c8b9-263b-6c4411a53cc9
msgctxt "hf0f35914gd33fg4f1ag8813gab4627c06eb3"
msgid "Why should I let you brand me?"
msgstr "어째서 내게 표식을 새기게 둬야 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 0dc1afba-898e-1c7b-1e76-7b59e5e6f4e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:0dc1afba-898e-1c7b-1e76-7b59e5e6f4e1
msgctxt "hbbef41dfg1b94g4cf2gb7b5g52c87f71d101"
msgid "Ready for the fire, are you?"
msgstr "불에 지져질 준비가 된 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 12159faa-1ebf-b422-0001-446b5787e467
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_RefusedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:12159faa-1ebf-b422-0001-446b5787e467
msgctxt "h09aec415gffbeg484fga9eeg4a5e211a98ff"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 15e1ef81-9bf1-e142-478d-ed857914a51b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:15e1ef81-9bf1-e142-478d-ed857914a51b
msgctxt "h61dc3ca5g9e3dg4042gace4gacc2f8cf6e5d"
msgid "Maybe you don't need it. After all, you're special, ain't you? Like me."
msgstr "너는 이게 필요 없을지도 모르겠구나. 결국은 너도 특별하니까, 그렇지? 나처럼 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 18a5087b-251e-48c8-1d40-32b2eafecf41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:18a5087b-251e-48c8-1d40-32b2eafecf41
msgctxt "h90d07fb9ga290g432cgae19g4c68c1f90f9c"
msgid "Eh? Ain't nothin' wrong with me. You're the one who's sick in the head."
msgstr "뭐라? 난 아무 문제 없어. 머리가 아픈 건 너야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 1a72726e-9dac-e6c4-4085-1644bc076fd5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:1a72726e-9dac-e6c4-4085-1644bc076fd5
msgctxt "h622633beg07deg4cc0gbb29g239dae86d745"
msgid ""
"Shows our devotion to the Absolute. These maggots see how strong we are with "
"Her guidance."
msgstr "절대자님에 대한 우리의 헌신을 보여준다. 구더기들은 우리가 절대자님의 인도로 얼마나 강해질 수 있는지 볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Wyll
#. NodeID = 1c226c42-1ba4-6f8e-7a38-304bd1761ea0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:1c226c42-1ba4-6f8e-7a38-304bd1761ea0
msgctxt "hf93e3d15ge636g4e2fg8e68gd8246b8bfd9c"
msgid ""
"A priestess. One of the leaders, no doubt about it. Let's make her squeal."
msgstr "여사제군. 지도자 중 하나야, 의심할 여지가 없어. 찍소리도 못하게 뭉개버리자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Astarion
#. NodeID = 1d2ac608-512a-a376-305d-9e9fb6d839ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:1d2ac608-512a-a376-305d-9e9fb6d839ca
msgctxt "ha17b5adbgaa52g4830g9007g1864b8339a05"
msgid "<i>Yes!</i> And I thought you weren't any fun."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 1f721482-47ee-2a7a-c3e0-af33de8bf563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:1f721482-47ee-2a7a-c3e0-af33de8bf563
msgctxt "h5dff114dg56cag4c21gb2a4g20fadecbc8ad"
msgid "I've been looking for a healer. Think you can help?"
msgstr "힐러를 찾아다녔어. 네가 도울 수 있을 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 212a4830-3631-a0ba-25b5-7895ef5b4889
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_HasMet(1) = True
#.   Global:
#.     - GOB_GoblinPriest_State_PlayerKnowsofBranding = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:212a4830-3631-a0ba-25b5-7895ef5b4889
msgctxt "hcf92a0c9g1028g44b9g8306g21e8109be348"
msgid "Now, here's somebody special. The Absolute has touched you, hasn't She?"
msgstr "자, 여기 특별한 녀석이 왔군. 절대자께서 널 어루만지셨지, 그렇지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 2248e5c2-61f2-e4b7-5ed3-ee6a54c5177d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:2248e5c2-61f2-e4b7-5ed3-ee6a54c5177d
msgctxt "h2f9cdfe5g71c8g4967g882ag33717f35e412"
msgid "Ready to figure out what's goin' on with those shadows in your head?"
msgstr "네 머릿속 어둠에 무슨 일이 일어나고 있는지 알아낼 준비는 됐나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Narrator
#. NodeID = 25565123-79ed-51d0-339b-1e0b695f6e3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:25565123-79ed-51d0-339b-1e0b695f6e3d
msgctxt "hf53ca2b9gd0bag40d1gb085gf1d12e3a541a"
msgid ""
"*She probes your mind, tangling your thoughts with hers. A familiar "
"sensation - she, too, carries a parasite.*"
msgstr ""
"*그녀가 당신의 정신을 탐색하여, 당신의 생각과 그녀의 생각이 뒤엉킵니다. 익숙한 감각입니다. 그녀도 기생충을 가지고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 26927e8c-d7b9-9b98-a75b-9d3ca525f8e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_RefusedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:26927e8c-d7b9-9b98-a75b-9d3ca525f8e6
msgctxt "he3e35c46g6e53g485cg860bgcc3a8a0e10e7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Narrator
#. NodeID = 26d20b29-6f8f-c0db-6a66-556fcc3a6dc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:26d20b29-6f8f-c0db-6a66-556fcc3a6dc4
msgctxt "hd5e9c196g09a8g4a61g81e4g640d0b7b46b5"
msgid ""
"*Her faith floods into you - a tide of shuddering ecstasy. Her tadpole "
"nestles within that mania, secure... hidden.*"
msgstr ""
"*그녀의 신앙심이 전율하는 황홀경의 물결처럼 당신에게 밀려듭니다. 그녀의 올챙이는 그 광란 속에 자리 잡아, 안전하게... 숨겨져 "
"있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 2abaefb6-dceb-e814-50f2-31ec047d3dac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:2abaefb6-dceb-e814-50f2-31ec047d3dac
msgctxt "hd0db8694g7448g4627gb24dg2cde9fb19767"
msgid ""
"My oath is to the verdant trees and ancient paths, I will not accept your "
"brand of flame. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 2abaefb6-dceb-e814-50f2-31ec047d3dac
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:2abaefb6-dceb-e814-50f2-31ec047d3dac
msgctxt "h2cfc084eg531ag4a4dg8dabg16c45836ae1a"
msgid ""
"My loyalty is already spoken for - brand me and I'll burn your heart out. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 2abaefb6-dceb-e814-50f2-31ec047d3dac
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:2abaefb6-dceb-e814-50f2-31ec047d3dac
msgctxt "hfc51de6bg8266g4e4fgbf40gadc8f2ad255c"
msgid "I serve only my oath, I will not bear your brand."
msgstr "난 오직 내 맹세만을 따른다, 네 표식 따위는 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 2d4397b5-b049-99fa-f333-c9cfc27ae701
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:2d4397b5-b049-99fa-f333-c9cfc27ae701
msgctxt "h359c9b7bg21eag4324g8c7eg2b975dbf7911"
msgid ""
"Lets the faithful recognise one another quick-sharp. That way, nobody'll "
"mess with you."
msgstr "신도들이 서로를 재빨리 알아볼 수 있다. 그렇게 되면, 아무도 너를 방해하지 않을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Karlach
#. NodeID = 323ce20d-f662-811a-9962-6f5cb388ac7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:323ce20d-f662-811a-9962-6f5cb388ac7c
msgctxt "hd6e2d5a6g7b90g4073gba6eg0aecf1b2edf5"
msgid ""
"We're fighting the whole tribe at once? Subtle. Next time, let <i>me</i> do "
"the talking."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Lae'zel
#. NodeID = 353352a4-74db-2628-a896-e8a77394a203
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:353352a4-74db-2628-a896-e8a77394a203
msgctxt "h258d8e33gf1d7g42cagb0ecg53e200488719"
msgid "One of the leaders. Split her skull and be done with it."
msgstr "지도자들 중 하나야. 그녀의 두개골을 쪼개버리고 나아가자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 35a15c1d-8783-12f0-7c23-f1eaaf498181
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_MentionedParasite(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:35a15c1d-8783-12f0-7c23-f1eaaf498181
msgctxt "h67e9a895gd2e9g4465g8317g031f894ba9ad"
msgid "I'm pretty sure you're infected, too."
msgstr "너도 감염된 것이 확실하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 39536eb8-1937-2392-7bc8-28f663fb7cf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:39536eb8-1937-2392-7bc8-28f663fb7cf1
msgctxt "h6865575bg99f6g425ega058g2834cfb66a56"
msgid "A <i>creature</i>? There's definitely something rotten in there."
msgstr "<i>생명체</i>? 네 머리에 분명 썩은 뭔가가 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 39785b6e-0ce2-ae97-7f80-0ceb576a7939
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:39785b6e-0ce2-ae97-7f80-0ceb576a7939
msgctxt "hd0c41582g69f1g455cgae25g178f5a53f431"
msgid "Do you think you can fix whatever's causing those shadows?"
msgstr "이 어둠의 원인이 무엇이든 고칠 수 있다고 생각하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 3d8a4ff1-ca93-d595-6453-5af8dcd5e392
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:3d8a4ff1-ca93-d595-6453-5af8dcd5e392
msgctxt "h3bac3724g78d3g497agb9e9g9ef1c905e84f"
msgid "Can we talk privately? This is a sensitive matter."
msgstr "조용한 곳으로 가서 이야기할 수 있을까? 민감한 문제라서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 3e939887-c576-531f-dfa1-21651d007616
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:3e939887-c576-531f-dfa1-21651d007616
msgctxt "h24968fc6g53f9g44aeg98b0ge6b32dd316b9"
msgid "I'm here to spill your guts across the floor."
msgstr "난 너희로 여길 피바다로 만들려고 왔는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 44a01d65-95d3-acb2-ce35-9cb1eb6f6152
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_AcceptedHelp(1) = True
#.   Global:
#.     - GOB_GoblinPriest_State_LeftBranding = True
#.     - GOB_GoblinPriest_AskedForPrivacy = True
#.     - GOB_GoblinPriest_AnotherPlayerProblem = True
#.   Object:
#.     - GOB_GoblinPriest_Event_StopBranding(0) = True
#.     - GOB_GoblinPriest_Event_StartMovingToChapel(0) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.GotBranded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:44a01d65-95d3-acb2-ce35-9cb1eb6f6152
msgctxt "had4f5b19gbdb6g443egb20bg9cee2fb34ecc"
msgid ""
"Of course. Don't want this rabble interfering with True Soul business. Let's "
"go to my chapel."
msgstr "물론이지. 이 하찮은 것들에게 참된 영혼 관련 일을 방해받는 건 원치 않아. 내 예배당으로 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 46440178-4c94-1fd2-2ade-c414198d2883
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:46440178-4c94-1fd2-2ade-c414198d2883
msgctxt "h1dc3799egcf35g496bg8878gaeedf578fff8"
msgid "I'm ready to kill you."
msgstr "널 죽일 준비는 됐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 47440e5c-0f92-4c71-84d2-c5da5220ff52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:47440e5c-0f92-4c71-84d2-c5da5220ff52
msgctxt "hbb41d6a3g2d83g49afgb339g5edfd19c00a2"
msgid "I <i>have </i>always wanted to smell my own burning flesh."
msgstr "<i>난</i> 항상 내 살이 타는 냄새를 맡고 싶었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 4a5578e6-4c7a-36f7-c493-df4dcfe6fdb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_NotFollower(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:4a5578e6-4c7a-36f7-c493-df4dcfe6fdb0
msgctxt "he8261025g86c3g4bbag8e3cg2118accd59db"
msgid "I only deal with those what have faith. Clear off."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 4c35d920-fe09-15c6-e4a7-6d695c5f0d06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:4c35d920-fe09-15c6-e4a7-6d695c5f0d06
msgctxt "hfe4ff12cg8ea9g4588gbb84ga21fb417e3af"
msgid "No need to panic, though."
msgstr "하지만 걱정할 것 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 4ea9b34d-db37-b8bd-8d7c-ad42287efab3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_ToldAboutTadpole(1) = True
#.      - GOB_GoblinPriest_HasMet(1) = True
#.      - GOB_GoblinPriest_RefusedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:4ea9b34d-db37-b8bd-8d7c-ad42287efab3
msgctxt "h42915641g8322g4069g8294g28673b5c7210"
msgid ""
"Good to see you still standing. Ready to figure out what that critter in "
"your head is doing?"
msgstr "네가 아직 서 있는 걸 보니 좋네. 네 머릿속 생명체가 뭔 짓을 꾸미는지 알아낼 준비 됐어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 596819e8-03fd-8ba5-f25f-cc1657fafd7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:596819e8-03fd-8ba5-f25f-cc1657fafd7f
msgctxt "hc17fc21egcfb3g48f1g9a33g1856dcf3b3bb"
msgid "Actually, I'd rather not go through with this."
msgstr "실은, 그러지 않는 편이 낫겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Lae'zel
#. NodeID = 5c7de68d-477f-79d9-75d4-09e140114eb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:5c7de68d-477f-79d9-75d4-09e140114eb8
msgctxt "he4e46033g6682g4db2g9208g67e7c1c14af2"
msgid "Yes - <i>give in to your bloodlust</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 5e6793ef-21d8-090f-5cbc-30c02905eb8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:5e6793ef-21d8-090f-5cbc-30c02905eb8a
msgctxt "h97202dbeg553ag4b9cgb006gace27572e991"
msgid "You think you can hurt me? This'll be good!"
msgstr "날 해칠 수 있을 거라고 생각해? 이것 참 재밌겠군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 652545bc-4d30-3b96-a2f6-2342080a2476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:652545bc-4d30-3b96-a2f6-2342080a2476
msgctxt "hd3d95616gac10g4f4dgaf3ag1011eb8406c5"
msgid "You've come to the right place."
msgstr "넌 제대로 찾아온 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Wyll
#. NodeID = 66154bc7-44b6-cbf7-c114-809c521cafee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:66154bc7-44b6-cbf7-c114-809c521cafee
msgctxt "h6f253647g1bd0g40e6gaee2gb03295e729b4"
msgid "You want to fight <i>all</i> of them? So be it - I have your back."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Narrator
#. NodeID = 7515b0da-64f1-6652-1f78-265486c933d4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Symbol = True
#.   Tag:
#.     - BRANDED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:7515b0da-64f1-6652-1f78-265486c933d4
msgctxt "h831cefb1g7d41g4f9egb91agd5389ee8db6f"
msgid ""
"*As the pain muddles your thoughts, your minds become entangled. A familiar "
"sensation - she, too, carries a parasite.*"
msgstr "*고통이 당신의 생각을 헝클어뜨리자, 당신의 마음도 뒤엉킵니다. 익숙한 감각입니다. 그녀도 기생충을 가지고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 781ff4c5-80f8-5e9d-7838-61fa53ade6cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:781ff4c5-80f8-5e9d-7838-61fa53ade6cc
msgctxt "h349c3358g3113g47a4gace8g16b951a3bb2f"
msgid "I feel you in there, digging around."
msgstr "네가 내 정신을 파고드는 것이 느껴진다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 78ab4769-e6b9-16f2-e75c-d3a7991a38f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:78ab4769-e6b9-16f2-e75c-d3a7991a38f7
msgctxt "h505c1890gca59g4988g9cb4gd7a8dded63e5"
msgid ""
"An' it's charged with magic. Ordinary slobs can't see it; only us that "
"follow the Absolute."
msgstr "그리고 이는 마법으로 충전되어 있다. 평범한 게으름뱅이들은 볼 수 없고, 절대자를 따르는 우리만 볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 792e5a37-6947-bd98-ae26-64944b73b63d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_CantHelp(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:792e5a37-6947-bd98-ae26-64944b73b63d
msgctxt "hd809bf2cg73b0g4beag9f2egee9c9d48a5cb"
msgid ""
"Still lookin' to get yer head fixed? Best ask the Absolute for help - I "
"can't figure it out."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 7b154d9b-21db-753f-7698-5b388f07e048
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:7b154d9b-21db-753f-7698-5b388f07e048
msgctxt "h985a8fe3ge86dg4e3ag83c1gc2890c1acfe9"
msgid ""
"Priestess Gut needs to touch you, too - hold out your arm so I can mark your "
"flesh."
msgstr "여사제 거트께서도 널 만져야겠어. 표식을 새겨줄 테니, 팔을 뻗어봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 8ad0d099-f51f-89ff-270f-c375ce7a9ed2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:8ad0d099-f51f-89ff-270f-c375ce7a9ed2
msgctxt "hb7b7ed6eg53f4g40eeg9ecdga656044add16"
msgid "Hold still."
msgstr "가만히 있거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 9325a098-f21c-ba9e-a590-7a67a44d5739
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:9325a098-f21c-ba9e-a590-7a67a44d5739
msgctxt "h24e97b05gf647g4cf2gb959gf9593c228556"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Narrator
#. NodeID = 9746f211-e037-39ae-a105-487f332a21a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:9746f211-e037-39ae-a105-487f332a21a5
msgctxt "hd5650bf0g88a5g4f59ga8adga5942c656eba"
msgid ""
"*The vision dissolves away. You stand before the goblin priestess in the "
"temple once again.*"
msgstr "*환영이 사라집니다. 당신은 다시 신전의 고블린 여사제 앞에 섭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 98221cf9-16dc-78ff-1687-f172648f943a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:98221cf9-16dc-78ff-1687-f172648f943a
msgctxt "h02a64995gc194g499dg9169gd5da5d2435aa"
msgid "<i>Sever the connection.</i>"
msgstr "<i>연결을 끊는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 9c480f1d-1c73-e205-b0d8-c67bf9580e68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:9c480f1d-1c73-e205-b0d8-c67bf9580e68
msgctxt "h9115a126gaf19g4bc2gb680gbf8a1017bbfd"
msgid "Any help would be appreciated. I need a healer."
msgstr "어떤 도움이라도 감사히 받겠다. 나는 치유사가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = 9c57db52-b700-c26c-57c0-a6d28a7b5208
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:9c57db52-b700-c26c-57c0-a6d28a7b5208
msgctxt "he877bd6dg7b4dg4488gb25eg6bd0ddab5064"
msgid ""
"Don't wanna get intimate in front of the novices? Fair enough. Got some "
"weird shadows in your head."
msgstr "수사들이 앞에 있는데도 친해지길 원치 않나? 알겠다. 너의 머릿속에 이상한 그림자가 있더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Gale
#. NodeID = 9d9a2bd3-2246-7452-e29a-b67e35f69383
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:9d9a2bd3-2246-7452-e29a-b67e35f69383
msgctxt "h1281523cg901fg4ce6gb592g8ebd00610020"
msgid ""
"Charged with magic? Perhaps that explains the ease with which these goblins "
"submit to True Souls."
msgstr "마법으로 충전되어 있다고? 그래서 고블린이 참된 영혼에게 쉽게 복종하는 것일지도 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = 9e83e685-0e15-7aa4-4d12-9b2dff421e0f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_ToldAboutTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:9e83e685-0e15-7aa4-4d12-9b2dff421e0f
msgctxt "hab92a7ddg1192g4fcfgaf71gaf997e3d1abc"
msgid "There's a creature inside my head. Can you help with that?"
msgstr "내 머릿속에 생명체가 있다. 그것에 관해 도와줄 수 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = a2635fa4-cd24-0e49-e2bb-1b7f023fc521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:a2635fa4-cd24-0e49-e2bb-1b7f023fc521
msgctxt "hdcdc3a68ge8bbg43begb81fg2c5c409cba30"
msgid "You'll never see anything like it again - time to die."
msgstr "이런 걸 다시 보게될 일도 없을 거야 - 죽을 시간이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = a4ceb15a-ab63-b819-60c7-feea6e077277
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinPriest_Event_PlayerAttacked = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:a4ceb15a-ab63-b819-60c7-feea6e077277
msgctxt "h0cfd5cb4gb139g4cb7g890dgbb2e2185da82"
msgid "Lads - rip 'em apart!"
msgstr "얘들아, 놈들을 조각내버려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = a57d477d-f86e-0dc3-7e6a-882d54fe188c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:a57d477d-f86e-0dc3-7e6a-882d54fe188c
msgctxt "hea4ea02dgbe08g4f93gad07g87b6de4197aa"
msgid ""
"What's that? Tell your friend to keep quiet, or he'll lose his good eye."
msgstr "뭐지? 너의 친구에게 조용히 하라고 말해라. 그렇지 않으면 그는 멀쩡한 눈도 잃게 될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = a9b7b276-c253-78ea-2ad7-485c30114c07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_AnotherPlayerProblem = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:a9b7b276-c253-78ea-2ad7-485c30114c07
msgctxt "h6cd7792bgf21ag4a90g9906g012b885fc105"
msgid ""
"Already spoke to one of your mates - a True Soul, just like you. Said I'd "
"help them, and that goes for you as well."
msgstr "이미 너와 같은 참된 영혼인 네 친구와 말했다. 돕겠다고 했고, 그건 네게도 마찬가지야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = aa70a547-15b6-65a6-d350-5a6f308fb27c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:aa70a547-15b6-65a6-d350-5a6f308fb27c
msgctxt "ha845b6e2g427cg402fg9094g2ab8262dc5fa"
msgid ""
"Works both ways. And I saw some weird shadows swimming around in your head "
"just now."
msgstr "그건 나도 할 줄 알거든. 그리고 방금 네 머리에서 기이한 그림자가 떠다니는 걸 봤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = aa734c04-4650-8f35-7405-683e75ee1842
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:aa734c04-4650-8f35-7405-683e75ee1842
msgctxt "hd5e00739g50bcg4804gb550g98869da4a176"
msgid "<i>Push deeper into her mind.</i>"
msgstr "<i>그녀의 정신을 더 깊이 파고든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Shadowheart
#. NodeID = af71665a-af15-481d-4576-68ef710ab1e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:af71665a-af15-481d-4576-68ef710ab1e0
msgctxt "hb9342012g1fbag4b9bg8979g912b865e88d7"
msgid ""
"That's a bigger fight than we needed to pick - not the subtlest of "
"assassins, are you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = af79339d-1c4f-1f2a-6835-e260c064f686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:af79339d-1c4f-1f2a-6835-e260c064f686
msgctxt "hd3172230ga101g4181gbc0ag13a12f1566e8"
msgid "I'll not let your unnatural magic in my head - instead, you die here. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = af79339d-1c4f-1f2a-6835-e260c064f686
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
