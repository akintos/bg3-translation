msgctxt "h3e7cbb0dgd479g49f7ga9b9gf2c848ea1083"
msgid "You ain't clan - you got no business here."
msgstr "우리 일족이 아니잖아, 여기 끼어들 생각하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = 49e3ffb6-5812-7983-1938-1385371b3364
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelBored_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:49e3ffb6-5812-7983-1938-1385371b3364
msgctxt "h56d7ea8cga50ag49cbg9270gbf0c62c74c7b"
msgid "You ain't so bad, I figure."
msgstr "그렇게 약해빠진 놈은 아닌 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = 6534af00-ed59-2535-1f3b-07aea4f4ee25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardBored_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarGuardBored_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:6534af00-ed59-2535-1f3b-07aea4f4ee25
msgctxt "h74924cceg8110g46aeg84fdgeeeb6efbeccc"
msgid "Joys - another under-elf."
msgstr "신난다, 지하 엘프 하나 더 왔네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = 72f6473c-2d3f-aa72-e7b4-b331aacc3d2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardBored_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarGuardBored_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:72f6473c-2d3f-aa72-e7b4-b331aacc3d2b
msgctxt "hebe1d2f3g5759g424cgbe58g614b93556a47"
msgid "<i>Drugnin</i>' outsiders. You've got no business here."
msgstr "<i>드러그닌</i> 외부인이군. 여기 일에 참견하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = 79b03124-376e-f065-ece0-375c872b4eb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Quest_KillEye = True
#.      - UND_ScryingEye_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:79b03124-376e-f065-ece0-375c872b4eb9
msgctxt "heac7e86agca41g4155g9e43g0b66702f71dc"
msgid "Time you freed Nere. That drow head needs crackin'."
msgstr "니어를 구해줄 시간이야, 그다음 대가리를 깨버리자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = 81a702a1-a08f-adc7-9233-ec0e98cd9e94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelBored_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:81a702a1-a08f-adc7-9233-ec0e98cd9e94
msgctxt "h6326ad16g92d3g490fg8d84gfc9fb5405c3a"
msgid "Can't believe I'm saying it, but you're all right I guess."
msgstr "내가 이런 말을 하다니 믿기지 않지만, 넌 꽤 괜찮은 녀석인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = b7661dd6-6d1f-da2a-80e5-c7830bb6c68d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Quest_KillEye = True
#.      - UND_ScryingEye_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:b7661dd6-6d1f-da2a-80e5-c7830bb6c68d
msgctxt "h5ee4b399g3c68g4995g9a34ge2bde9babd85"
msgid "Eye's still patrolling. Ain't you s'posed to smash it?"
msgstr "눈깔이 아직 돌아다니잖아. 네가 저걸 부숴버려야 하는 게 아니었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = e1550ab2-3fe7-f182-228a-2ccaaa50ffe3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardBored_HasMet(1) = False
#.   Tag:
#.      - DEEPGNOME(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarGuardBored_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:e1550ab2-3fe7-f182-228a-2ccaaa50ffe3
msgctxt "h63b09f31gf246g4d7ag8743gcebc7941eda3"
msgid "You can crack rocks with your kind - or I can crack you."
msgstr "너네 동족이랑 바위나 쪼개, 아니면 내가 네 머릴 쪼개줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored
#. Speaker = Stone Guard Kur
#. NodeID = e3098357-8dcf-99f0-131e-4b400ff294c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardBored_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelBored:e3098357-8dcf-99f0-131e-4b400ff294c6
msgctxt "h78c1d228gb481g4418g9168gaad53258d4f6"
msgid "Get goin'."
msgstr "움직여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 0af53a9a-b793-b0f2-8cba-180e9baac5f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_RecruitedMutineers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:0af53a9a-b793-b0f2-8cba-180e9baac5f5
#, fuzzy
msgctxt "hec99b350g4f97g4d54g8b2cgb05111b2718f"
msgid "Pull Nere from the rubble. Time Nere gets what's coming."
msgstr "잔해에서 니어를 꺼내. 놈에게 한 방 먹일 때가 됐다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 1855d74e-d8f6-d603-470e-c36bc952007a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:1855d74e-d8f6-d603-470e-c36bc952007a
msgctxt "h01a83500ge4e2g455eg9bf0g60f1dfa9029b"
msgid ""
"Good. Drop it near the rubble when it's time. Flaming arrow or some such'll "
"set it off."
msgstr "좋아. 준비되면 잔해 근처에 그걸 놓도록 해. 불화살이나 뭐 그런 걸 쏘면 점화할 수 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 22a4d837-55bf-35a8-f2a4-94a1fbd016a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:22a4d837-55bf-35a8-f2a4-94a1fbd016a3
msgctxt "h2c3e17bdg764bg4645gbc34g75238ba43646"
msgid "Whatever you think you heard, you thought wrong."
msgstr "무슨 얘기를 들었는지는 모르겠지만, 잘못 들은 거라고 쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 35686260-99a2-530b-6d31-2065819020be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:35686260-99a2-530b-6d31-2065819020be
msgctxt "h8c3cf72bge231g45fdgb88ag8ad26f329839"
msgid ""
"Bet her crew know more than they're letting on - see if you can get 'em to "
"talk."
msgstr "하지만 그녀의 동료들은 알고 있는 만큼 털어놓지 않아. 네가 그들의 입을 열 방법을 찾아봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 3a200c19-6f34-4bc1-8da2-40293d43aa9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Quest_KillEye = True
#.      - UND_ScryingEye_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_State_RecruitedMutineers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:3a200c19-6f34-4bc1-8da2-40293d43aa9a
msgctxt "hde45cb7bg4d7bg4b31g9220g0f90724560af"
msgid "The eye's clobbered - good work. Time to bust Nere out and shred him."
msgstr "그 좆만한 눈깔을 뭉갰구만. 잘했어. 이제 니어를 꺼내서 조질 시간이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 4bd0c026-e55f-1db8-fc3e-8f9df61022b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Quest_Refused = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:4bd0c026-e55f-1db8-fc3e-8f9df61022b0
msgctxt "hb7b73884ge48ag443eg8bb0g8465a2ea0b1e"
msgid "If you can't help, shove off."
msgstr "못 도와줄 거면 그냥 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 605806c1-2bc4-d619-3ab5-2a32c755d102
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:605806c1-2bc4-d619-3ab5-2a32c755d102
msgctxt "h96ecd037g9edcg40c5gba55g04ec5a7e84e3"
msgid "Damn - Nere's Corpse is already stinkin' up the place."
msgstr "젠장, 니어의 시체가 벌써 악취를 풍기기 시작하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 6536b0b0-e12c-afac-3763-6fc17c529673
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:6536b0b0-e12c-afac-3763-6fc17c529673
msgctxt "hbf5b0d3dg96f4g4c5cgacccg7b060228d304"
msgid "Once Nere's out, we'll pound him to powder and take our dues."
msgstr "일단 니어를 꺼내고 나면, 놈을 족쳐버리고 우리 몫을 챙긴다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 6a5de95a-6569-9009-58af-b212b0f374e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:6a5de95a-6569-9009-58af-b212b0f374e7
msgctxt "h2da62b91geefag48abga1bfge327a1f2849f"
msgid "Off with you. Private conversation."
msgstr "저리 꺼져. 사적인 대화 중이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = 716e80b0-69a7-445d-0b8e-cdc29bc6d146
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:716e80b0-69a7-445d-0b8e-cdc29bc6d146
msgctxt "h0d130272gbd02g4475g908cg5173ca28b253"
msgid "Some days back, a slave gnome bolted with smokepowder. Handy stuff."
msgstr "며칠 전에, 한 노움 노예가 화약을 들고 도망쳤지. 편리한 물건인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Player
#. NodeID = 9996fc06-9604-40a4-50ec-2597933f0422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:9996fc06-9604-40a4-50ec-2597933f0422
msgctxt "h2be22c98g0f9fg4e9dgabaage559264b0a0c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Player
#. NodeID = ab5ea09a-4eab-e0fc-dbe0-dfd93d7ea495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:ab5ea09a-4eab-e0fc-dbe0-dfd93d7ea495
msgctxt "ha9a03334gb968g4329gae87gce44652cc66d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = ae03de7a-6a67-8cf8-1808-57bdffdd21b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarMutineers_Event_Threatened = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:ae03de7a-6a67-8cf8-1808-57bdffdd21b1
msgctxt "h195fad5fgc4a7g482ag9425gdb838ab26d84"
msgid "I got big plans for us. Ain't no one stopping Clan Flameshade."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Player
#. NodeID = b0504aed-8b8a-ea1f-2a8c-e28b736a389c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_Mutineers_AskedAboutLead(1) = False
#.   Object:
#.      - UND_HiddenGnome_HasVial(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_Mutineers_AskedAboutLead(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:b0504aed-8b8a-ea1f-2a8c-e28b736a389c
msgctxt "h1e91cc24gba16g44e2g84f5g878be5e148a4"
msgid "Any ideas on how I might do that?"
msgstr "내가 어떻게 하면 좋을지 생각 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Player
#. NodeID = b55d67b8-41b8-634d-b6f1-b4b73df17798
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_Mutineers_AskedAboutLead(1) = False
#.      - UND_DuergarCamp_Mutineers_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_Mutineers_AskedAboutLead(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:b55d67b8-41b8-634d-b6f1-b4b73df17798
msgctxt "h1190f12eg93ccg4afdga481g8f79ac2bf98b"
msgid "I heard you before. Someone fled who could blast Nere free?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Player
#. NodeID = b766def7-e63c-8c80-b1c4-55f67ee0afcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarRebelGreedy_Event_ToldHasExplosives = False
#.   Object:
#.      - HasTaggedItem_EXPLOSIVES(1) = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarRebelGreedy_Event_ToldHasExplosives = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:b766def7-e63c-8c80-b1c4-55f67ee0afcd
msgctxt "h63afadbeg7c5dg4e03g8a5fgd57cb19438a9"
msgid "I've obtained explosive powder."
msgstr "폭약 가루를 얻었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = c30d5b54-4938-557a-4388-c2188791dbab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Quest_KillEye = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:c30d5b54-4938-557a-4388-c2188791dbab
msgctxt "h137ff263g37d4g48a0g94e3g75b9289e1ca7"
msgid ""
"Close the eye-thing for good, then spring Nere. Time we got what was coming "
"to us."
msgstr "외짝 눈깔 얼른 감고 니어를 데려 와. 할 일을 해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = c9e52277-bee3-e31f-670a-c1b311b5e6b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:c9e52277-bee3-e31f-670a-c1b311b5e6b3
msgctxt "h62425be4g6cf2g43b2g9080gcffe2f1f50b5"
msgid "No clue where the stump's hiding. But she's got what you need."
msgstr "그 노움이 어디 숨어 있는지는 몰라. 하지만 필요한 걸 갖고 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = de44ef06-2944-2213-afb6-1af4f971177e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:de44ef06-2944-2213-afb6-1af4f971177e
msgctxt "h3ccee614ge3d4g4fd6g8d38gf2da621f3336"
msgid "You gone barmy? I hear the ears are first to go."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy
#. Speaker = Elder Brithvar
#. NodeID = f63819e3-8839-64e0-8c8f-386658663b17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGreedy:f63819e3-8839-64e0-8c8f-386658663b17
msgctxt "h60504f35g7b74g4556g9f16gff27db349d7c"
msgid "Now move. You're hogging my air."
msgstr "이제 움직여. 네가 내 공기를 독차지하고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03
#. Speaker = Thudd
#. NodeID = 59b6df4a-fafd-b5e6-8894-d04898229acd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelFrantic_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03:59b6df4a-fafd-b5e6-8894-d04898229acd
msgctxt "h987478d2g0dd3g483dg89c5g5f56d03a3ffa"
msgid "Good riddance. <i>Hoon</i> caused nothing but trouble."
msgstr "속이 다 후련하군. 저 <i>훈</i> 자식은 망할 골칫거리였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03
#. Speaker = Thudd
#. NodeID = ac6e8c59-e9a9-3e39-4e9c-1552b8b6e198
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardFrantic_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03:ac6e8c59-e9a9-3e39-4e9c-1552b8b6e198
msgctxt "h4a9ddcf7gf5dfg49efg8684g1f472a6fe9fd"
msgid "Get a <i>drugnin</i>' move on."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03
#. Speaker = Thudd
#. NodeID = b246d210-98a3-50ba-1469-684da4b724a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelFrantic_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03:b246d210-98a3-50ba-1469-684da4b724a5
msgctxt "h514e7640g684ag4fbfga638gcbab4441e954"
msgid "Shouldn't go saying it, but the clan owes you."
msgstr "이런 말 하면 안 되지만, 우리 일족이 네게 빚졌네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03
#. Speaker = Thudd
#. NodeID = e4aee09c-5b68-ccdd-c07c-f8ef54c6ac7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardFrantic_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarGuardFrantic_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03:e4aee09c-5b68-ccdd-c07c-f8ef54c6ac7c
msgctxt "ha96dcb9ag3949g4ddcgbee0g0cecabea7a51"
msgid ""
"<i>Drugnin</i>' True Soul getting himself trapped. Let him suffocate, if the "
"Absolute can't save him."
msgstr "<i>드루그닌</i> 참된 영혼이 스스로 함정에 걸렸군. 절대자께서 구해주실 수 없다면, 그냥 질식하게 내버려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03
#. Speaker = Thudd
#. NodeID = e87ceac5-1b14-5efd-0ad1-0df7fd1e0c94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardFrantic_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03:e87ceac5-1b14-5efd-0ad1-0df7fd1e0c94
msgctxt "h76b29b0agd3fag41cdgb66eg791515ff7e54"
msgid "Get a <i>drugnin</i>' move on, 'fore they start pointin' fingers."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03
#. Speaker = Thudd
#. NodeID = ee5930c8-9c87-360a-f10c-2479fa1305a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_SidedMutineers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelGuard_03:ee5930c8-9c87-360a-f10c-2479fa1305a6
msgctxt "h2d93ff90gd910g42feg9bf7ga5e769648c26"
msgid ""
"<i>Drugnin' </i>drow, messing with minds. The <i>hoon</i> deserves what's "
"coming."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 02b1ff00-386e-471f-a4af-0cd422257c1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarMason_01_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarMason_01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:02b1ff00-386e-471f-a4af-0cd422257c1c
msgctxt "h2a3e3e3eg94feg4522ga085gd5c4f11252b5"
msgid ""
"How peculiar. Smooth face, cobbled edges. They're a sign - they must be."
msgstr "아주 독특하군. 매끄러운 표면에, 자갈로 수리된 모서리라. 어떤 흔적인 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 03be544e-972f-4ffc-c58f-50e17e1b0505
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:03be544e-972f-4ffc-c58f-50e17e1b0505
msgctxt "h911d63d0gf25cg48a5g8861g6b108be090f1"
msgid "The rock. The rubble. All of it, if I may be so bold."
msgstr "바위. 자갈. 대담하게 말하자면, 전부 다 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = 041563cf-e340-c2ba-d6d1-6ab9bd0ebd1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:041563cf-e340-c2ba-d6d1-6ab9bd0ebd1e
msgctxt "hcb269351gc5b2g4d56gb208g467a813d0e7e"
msgid "*Nothing odd catches your eye.*"
msgstr "*이상한 점은 하나도 발견하지 못했습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 08dc4599-3789-fc16-ade7-1a66e5799dfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:08dc4599-3789-fc16-ade7-1a66e5799dfc
msgctxt "he4c6a01eg9ec9g4071ga1bdg3dff2fb128f9"
msgid "What do you think?"
msgstr "어떻게 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 08eda54b-e77c-1f8b-4e43-4cad2ddd98c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:08eda54b-e77c-1f8b-4e43-4cad2ddd98c4
msgctxt "he42028f6gaef7g4628gbdd4ga1c5098bae38"
msgid ""
"There is nothing <i>fancy </i>about good work. Respect the stone, or it may "
"crush you."
msgstr "좋은 작업에는 <i>고상함</i>이고 뭐고 없어. 바위를 존중해, 그게 널 뭉개버릴지도 모르니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = 09dfb742-e239-e352-db25-34583ef1d4fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:09dfb742-e239-e352-db25-34583ef1d4fa
msgctxt "h1d0dd995g4412g4a8fg9d5ega1640076f1d4"
msgid ""
"*You recall the tale of a Sharran fortress armed with impenetrable "
"adamantine - a metal created by a gnomish mage.*"
msgstr "*무적의 아다만틴으로 무장한 샤 요새에 대한 이야기가 떠오릅니다. 노움 마법사가 만들어낸 금속 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 0a85ec64-c3ca-1ec7-60fc-bb6c956bd262
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarRebelMason01_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:0a85ec64-c3ca-1ec7-60fc-bb6c956bd262
msgctxt "h418d0598g4283g4ccfg9b81g8adbe0d8176f"
msgid "The past is nearer than we think. We simply must dig."
msgstr "과거는 우리 생각보다 가까이 있어. 그냥 파내기만 하면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 11f1736e-3c91-49f7-88ee-ab4a413522b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:11f1736e-3c91-49f7-88ee-ab4a413522b5
msgctxt "h259a7de9g5e27g4ca0gb5b5g9fa5cac499e1"
msgid "You don't talk like the rest of your crew. Fancy britches, are you?"
msgstr "넌 네 동족과 말투가 다르군. 고상한 편인가 봐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 20070ff6-40bb-4407-5f0e-1944876b8069
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_TriedCheckThree(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_TriedCheckThree(1) = True
#.     - UND_DuergarRebelMason_Event_TriedOneCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:20070ff6-40bb-4407-5f0e-1944876b8069
msgctxt "h7781cbf7gc2b3g4b4cg9f22gfcca40e1f238"
msgid "<i>Survey the area for unseen curiosities.</i>"
msgstr "<i>아직 발견하지 못한 점은 없는지 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 2a52df4c-04c5-bceb-2e5b-ea4d2bcb98c8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:2a52df4c-04c5-bceb-2e5b-ea4d2bcb98c8
msgctxt "hd3b4d854gae09g4f77gb832g7218c46b4932"
msgid ""
"<i>Clan-sen</i>, my friend - my sore eyes have seen what they're able. Care "
"to offer yours in their stead?"
msgstr "<i>클란센</i>, 친구여. 내 시린 눈으로는 볼 만큼 봤다네. 자네 눈으로도 좀 봐 주겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 2a52df4c-04c5-bceb-2e5b-ea4d2bcb98c8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:2a52df4c-04c5-bceb-2e5b-ea4d2bcb98c8
msgctxt "h9a3406ebg7fedg4738gb246g6f183cf02e84"
msgid ""
"What luck. Look here, <i>hoon</i> - I seek fresh eyes. Care to lend yours to "
"a weary mason?"
msgstr "운이 좋군. 어이, <i>훈</i>, 신선한 시각이 필요해. 이 늙은 석공을 대신해 도움을 좀 주겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 2a52df4c-04c5-bceb-2e5b-ea4d2bcb98c8
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:2a52df4c-04c5-bceb-2e5b-ea4d2bcb98c8
msgctxt "h849ebbdbg5730g4e68g9a48gb19ae738f447"
msgid ""
"A sundweller in these parts? Look here, my top-side friend - I need fresh "
"eyes. And I doubt I'll find fresher."
msgstr "이곳에 태양 활보자라? 여길 한번 봐, 지상인 친구. 신선한 시각이 필요하거든. 그리고 그 점에서 네가 아주 완벽할 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 2d9441e3-9583-d514-144f-8b7699c621af
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarRebelMason_State_LearnedHistory = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.UND_DuergarCamp_Stonemason_SucceededChecks(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:2d9441e3-9583-d514-144f-8b7699c621af
msgctxt "hec1c54bbg9a18g4eb4g9969gf719512f4e19"
msgid "How fascinating. I told my kinfolk that book-learning has its benefits."
msgstr "아주 흥미롭군. 난 항상 친척들에게 책으로 배우는 것보단 직접 보는 편이 배우는 점이 많다고 이야기했었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = 2f14fef0-3178-189b-ced2-cd86c50d4c70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:2f14fef0-3178-189b-ced2-cd86c50d4c70
msgctxt "h14fc4467g25bbg46acg9099g496440c2acd0"
msgid ""
"*The duergar listens to your tall tale. Though sceptical of the more suspect "
"details, they seem amused enough by the story.*"
msgstr "*듀에르가가 당신의 긴 이야기를 듣습니다. 일부 의심스러운 세부 사항에는 회의적이지만 이야기에 충분히 흥미를 보이는 듯합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 2ff5656d-8114-5278-5a7e-f3a50c5d44aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:2ff5656d-8114-5278-5a7e-f3a50c5d44aa
msgctxt "h40c78f6fg3578g4c5fg9a48g9a6c1c5685be"
msgid ""
"... until a great hellbeast charges through, toppling the walls and crushing "
"the people!"
msgstr "... 거대한 지옥의 야수가 돌진해 성벽을 무너뜨리고 사람들을 짓밟기 전까지는 말이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 3286ba2c-4fae-9c4e-9a70-b2456a181eef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:3286ba2c-4fae-9c4e-9a70-b2456a181eef
msgctxt "h5e555440g3fc4g4558g9e34g02368a138fff"
msgid ""
"A crafty gnome helping forge a fortress that would last an aeon.  Mythic "
"metal atop stone hewn by the devoted."
msgstr "영겁의 세월을 견뎌낼 요새 건설을 돕는 손재주 좋은 노움. 헌신적인 이들이 다듬어 돌 위에 얹은 신화 속 금속."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = 3eed73a7-96d2-d23a-b2ad-c1491ff335ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:3eed73a7-96d2-d23a-b2ad-c1491ff335ac
msgctxt "h31fc4549gf80bg44bcg9b73g0cf0295e1b02"
msgid ""
"*Two styles, two eras. The statue was carved from newer stone and erected by "
"late-comers to this ancient fortress.*"
msgstr "*두 가지 양식, 두 가지 시대입니다. 이 조각상은 후대에 이 고대 요새에 도착한 사람들이 새 돌로 조각하여 세운 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 41ea85f9-f3e5-43b6-9359-33f972b36460
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:41ea85f9-f3e5-43b6-9359-33f972b36460
msgctxt "ha6085b0fg4655g4996ga70fg6a27867148d2"
msgid ""
"That's to say nothing of this tale of an invulnerable protector - it's "
"unfortunate the Sharran's successors found no proof."
msgstr "무적의 수호자 이야기까지 가면 말할 것도 없지. 샤 신도의 후계자들이 아무 증거도 못 찾았다니 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = 43bec0ee-65b2-1621-0100-c5b8ff720981
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:43bec0ee-65b2-1621-0100-c5b8ff720981
msgctxt "hdecb45bag3d9dg4aaeg9ae9g43125103903b"
msgid ""
"*The book's style was not particularly gripping, and as such, its contents "
"are tough to remember.*"
msgstr "*책의 양식이 그다지 매력적이기 않았기에, 세부 사항을 기억하기가 어렵습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 43fcac51-9e2c-d1e2-6702-f5c20d17bb3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:43fcac51-9e2c-d1e2-6702-f5c20d17bb3b
msgctxt "h65a648ddg8f72g4883ga966gddd2b47c736e"
msgid "As you need."
msgstr "필요한 만큼 기다리지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 4f72c3a0-763a-ffd8-79c1-b5164fc63a7c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Local:
#.      - 6cf0c1f2-d8ea-34f2-e612-c0df2cb4aeb6_BardLied = False
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarRebelMason01_HasMet2 = True
#.   Local:
#.     - 6cf0c1f2-d8ea-34f2-e612-c0df2cb4aeb6_BardLied = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:4f72c3a0-763a-ffd8-79c1-b5164fc63a7c
msgctxt "h8ca0b392g925ag4ac5g8cfdg6058de337748"
msgid ""
"I know everything about this place. In fact, it was hand-forged by a flumph "
"called Grym..."
msgstr "난 이곳에 대해 모든 걸 알아. 사실, 그림이라는 플럼프가 전부 수작업으로 만든 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 52550657-cf57-aeae-5b62-f549cb294986
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:52550657-cf57-aeae-5b62-f549cb294986
msgctxt "h01b6da7bg2c75g4978gbdd3g3efd4a1723e8"
msgid ""
"Untold centuries later, a new tribe revives it. Fresh walls, fresh "
"sculptures..."
msgstr "알 수 없는 시간이 흐르고, 새로운 부족이 도시를 재건한 거야. 벽을 새로 세우고, 조각상도 새로 조각했겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 55e77c9b-11e4-a39a-47f4-f741caec6214
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason01_HasMet3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:55e77c9b-11e4-a39a-47f4-f741caec6214
msgctxt "h0bdac97bg2666g470dg8f24gba192f8b841c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 57abfae9-254f-3ef6-bc81-80c79d8eb2ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarMason_01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:57abfae9-254f-3ef6-bc81-80c79d8eb2ce
msgctxt "hc27a775ag5666g4637gaf91g18ea2d368dbf"
msgid "Please - a quick look, if you don't mind."
msgstr "부탁이야, 잠깐만 보면 되네, 자네가 괜찮다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 59fc09aa-f333-0934-3ca0-102ce2d7f555
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:59fc09aa-f333-0934-3ca0-102ce2d7f555
msgctxt "h00f8e812g8b5ag4b83g9ee0gf44cd0df8701"
msgid "Peering into cracks and crevasses in hope to find history's morsels."
msgstr "역사의 조각들을 찾고자 균열과 틈새를 들여다보는 중이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 5b4d45ff-0597-b826-af2c-cc7e1df30152
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_TriedCheckOne(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_TriedCheckOne(1) = True
#.     - UND_DuergarRebelMason_Event_TriedOneCheck(1) = True
#. TagRule: RANGER or REALLY_DEEPGNOME or REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:5b4d45ff-0597-b826-af2c-cc7e1df30152
msgctxt "h40d1e43eg829eg4d4egab88gb1a36b74fc43"
msgid "<i>Examine the fallen rubble.</i>"
msgstr "<i>자갈 파편을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 5d4e50f0-c214-2a78-29f2-f5ab5851da3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:5d4e50f0-c214-2a78-29f2-f5ab5851da3d
msgctxt "h43221882g60f4g4865g9bd5gead90f9a2d40"
msgid "Take a look. Tell me what you see. And be thorough."
msgstr "한번 봐봐. 뭐가 보이는지 알려주게. 최대한 자세히 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 60fa3247-ad73-4391-96b4-29dc47cd73e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason01_HasMet3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:60fa3247-ad73-4391-96b4-29dc47cd73e2
msgctxt "h9e97243dg5b0dg4aadgae67g82fb4b142daa"
msgid "How fares your investigation?"
msgstr "조사는 어디까지 진행했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 64f4c10b-9be9-81e8-975e-2ff5170d8c17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:64f4c10b-9be9-81e8-975e-2ff5170d8c17
msgctxt "h84141313g5889g41e7ga4d7gc5601c84af51"
msgid "And you have been thorough?"
msgstr "확실히 준비했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 6aea770b-280a-5e9f-4a98-f66ab8de2c2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:6aea770b-280a-5e9f-4a98-f66ab8de2c2c
msgctxt "h9adcbc68g3d37g41eaga748g297431e6110e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 6e6f7999-36e2-cc49-7b25-3d913de440a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:6e6f7999-36e2-cc49-7b25-3d913de440a8
msgctxt "he4b208f7gd810g4b45g9500ga35d6b80bd22"
msgid ""
"I have come up regrettably short. I hope you might see truths where I cannot."
msgstr "하지만 난 유감스럽게도 한계에 도달한 것 같군. 자네라면 내가 보지 못한 진실을 볼 수 있기를 바랄 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 71bbfebd-a394-d8ef-862f-76f2ca56defe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason01_HasMet3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:71bbfebd-a394-d8ef-862f-76f2ca56defe
msgctxt "hcfc9815fge9a8g4c17g8a75g9f3f07850c5a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 73e2b930-7c2a-b965-949c-0be9cdb9c372
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:73e2b930-7c2a-b965-949c-0be9cdb9c372
msgctxt "h49e8985cg049eg4d2bgbfffgf21e6904e063"
msgid ""
"Fascinating... What begat such a powerful flumph? Does it still live here to "
"this day?"
msgstr "환상적이군... 어떤 강력한 힘이 이런 결과를 만들어 낸 거지? 아직도 살아 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 75cbea80-5c72-323c-695c-810a868ea75f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - UNDERDARK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:75cbea80-5c72-323c-695c-810a868ea75f
msgctxt "h3302fcc1gb8c5g4e8fgb793gfb08cf24109e"
msgid ""
"Ease your suspicions - I've got no mind for slaving. My passion is stone, "
"and my god is the chisel."
msgstr "의심할 것 없네. 난 노예를 부릴 생각은 전혀 없으니까. 내 열정은 돌이고 내가 섬기는 신은 끌이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 8f498580-3cea-5929-f5fd-c68d8e64c25e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:8f498580-3cea-5929-f5fd-c68d8e64c25e
msgctxt "hc9c405d3g107fg4e38g9687gecee2d1c8876"
msgid ""
"But these learned eyes reach their limits. And so I must humbly request "
"yours."
msgstr "하지만 이 늙은 눈도 한계에 도달한 것 같군. 그래서 난 자네에게 겸손하게 부탁하고 싶네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = 95d25def-2aeb-0450-359c-93b8fda3dec2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_TriedCheckOne(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_TriedCheckOne(1) = True
#.     - UND_DuergarRebelMason_Event_TriedOneCheck(1) = True
#. TagRule: !(RANGER and REALLY_DEEPGNOME and REALLY_DWARF)
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:95d25def-2aeb-0450-359c-93b8fda3dec2
msgctxt "hdaa4ddc9ge925g4b58gaa7fgd78cce2a19d0"
msgid "<i>Examine the fallen rubble.</i>"
msgstr "<i>자갈 파편을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 9829ebff-f7a0-2e55-a304-42e36b819484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:9829ebff-f7a0-2e55-a304-42e36b819484
msgctxt "h201b0dd2g7848g442bg89e4g02b89ed46616"
msgid "Anything standing out?"
msgstr "특이한 점은 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = 9a59901a-98e4-f006-5c95-f82ca36daa82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:9a59901a-98e4-f006-5c95-f82ca36daa82
msgctxt "h993f0b19g77b8g4a00g9d2bgf3b4494c3a08"
msgid ""
"The True Soul, the battle - too many distractions. There is still truth to "
"uncover."
msgstr "참된 영혼, 전투 - 방해물이 너무 많아. 아직 밝혀내야 할 진실이 남아 있는데 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = a0ddb65c-892c-b58d-90bb-508696ed2011
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:a0ddb65c-892c-b58d-90bb-508696ed2011
msgctxt "ha12b9baagca7fg4a95g9c2fgf35092622839"
msgid "Fine. What should I be looking at?"
msgstr "좋아. 뭘 보라는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = a2c4b141-9a11-26c4-c190-9599f1b53a3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:a2c4b141-9a11-26c4-c190-9599f1b53a3b
msgctxt "h82949041g2976g424eg9aebge74d1e35d435"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = a3a90b35-ab52-65d4-20f1-b5f6aa3cf218
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:a3a90b35-ab52-65d4-20f1-b5f6aa3cf218
msgctxt "h6b68b8a2ge9dcg4bfbg8f79gd12975e8e4ac"
msgid "<i>Try to remember the tome 'Fables of Forges Grym'.</i>"
msgstr "<i>'그림 포지의 우화'에 담긴 내용을 기억하려 노력한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = a478e5c5-a7f4-a42d-9afe-4c434b05dcfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:a478e5c5-a7f4-a42d-9afe-4c434b05dcfd
msgctxt "h47bd9666ga593g4e77ga6d2g47a307aac834"
msgid "*You consider the differences, but they mean nothing to you.*"
msgstr "*차이점을 알아보려 노력하지만, 당신에겐 아무 의미도 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = a6ea9639-cecb-e369-f665-fd972c48ef3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:a6ea9639-cecb-e369-f665-fd972c48ef3e
msgctxt "h7a913b1agdcfdg42dbgbfd1ge6175a8bea4c"
msgid ""
"*The hottest of flames smoothed the stone and left sulphuric crystals "
"behind. The fires of the Hells have touched Grymforge.*"
msgstr "*엄청난 불길이 돌을 매끄럽게 만들고 유황 결정을 남겨 놓았습니다. 지옥의 불길이 그림포지에 닿은 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = aa1078dc-2c02-0f41-a07b-55c0065735e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6cf0c1f2-d8ea-34f2-e612-c0df2cb4aeb6_BardRememberedTale = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:aa1078dc-2c02-0f41-a07b-55c0065735e9
msgctxt "h3877c8ffgdbfag45e6ga7d9g0f74fbad61f7"
msgid ""
"*There was also whispers of the gnome's secret project - an invincible "
"guardian - though its existence was never proven.*"
msgstr "*무적의 수호자라는 노움의 비밀 계획에 대한 소문도 있었지만, 그 존재는 증명된 적이 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = afd83a83-1121-ffd1-7037-ae24db91ac9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:afd83a83-1121-ffd1-7037-ae24db91ac9f
msgctxt "heb540b51gacaag4b66gb3a3ge3faeeb231ce"
msgid "That's all, then."
msgstr "그럼, 그게 다군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = aff50b03-e33a-6f48-0a09-86ffaf32d7cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:aff50b03-e33a-6f48-0a09-86ffaf32d7cd
msgctxt "h53709a79g8433g4defgbc19g38574b1c92f6"
msgid "How exactly does a flumph hand-forge anything?"
msgstr "대체 플럼프 손으로 어떻게 무언가를 단조해 내는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = b1df479d-c880-1995-b0fb-c1a875192bda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:b1df479d-c880-1995-b0fb-c1a875192bda
msgctxt "h88325636g7aa6g4f1bg90c3gcf76a91bb98c"
msgid ""
"Alas, you've left me with more questions than answers. My survey continues."
msgstr "아아, 아쉽게도 해답보다는 많은 의문을 남겨 줬군. 조사를 계속해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = ba25d0c6-f9d8-dcba-c6da-cc81c665ce04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_PassedRubbleCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:ba25d0c6-f9d8-dcba-c6da-cc81c665ce04
msgctxt "ha9129259g376dg4c2bgace9g5c48b0a6d746"
msgid ""
"Yes, the rubble - it was a great beast that tore these walls down. I should "
"have known."
msgstr "그래, 이 잔해. 이 벽을 무너뜨린 건 거대한 짐승이었군. 왜 몰랐을까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = bdcb099f-8c0e-d279-f4a0-0ce80b43c0cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:bdcb099f-8c0e-d279-f4a0-0ce80b43c0cf
msgctxt "he1873626g93b5g4da5g961eg9f8f7d4f3abf"
msgid "I would like to trade."
msgstr "거래를 하고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = c1d20429-6fe2-e334-ed04-a9b0b1989eeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:c1d20429-6fe2-e334-ed04-a9b0b1989eeb
msgctxt "h53474e54g8f77g41b6g9d5fge87cb8637617"
msgid ""
"An ancient city, hewn from the stone by disciples of Shar, later abandoned."
msgstr "샤의 신봉자들이 돌을 깎아 만든 고대 도시가 있었는데, 후에 버려졌던 게지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = c39c4139-b255-2967-d331-234f605c69ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_PassedRubbleCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:c39c4139-b255-2967-d331-234f605c69ea
msgctxt "h5d15a8f4ga845g4838g963bg241e0ca50dbb"
msgid ""
"*Boulders and stone bricks of various sizes clutter the corridor, many split "
"cleanly in two. Yet some walls remain fully intact.*"
msgstr ""
"*다양한 크기의 바위와 돌 벽돌이 복도를 어지럽히고 있으며, 일부는 깔끔하게 둘로 갈라져 있습니다. 하지만 일부 벽은 온전히 남아 "
"있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = c716d29d-5973-43ec-83a9-ad159ad68b4c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarRebelMason01_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:c716d29d-5973-43ec-83a9-ad159ad68b4c
msgctxt "h72aa4aeag9784g49dfg8131g041ffb5d6f08"
msgid "<i>Deliver your report.</i>"
msgstr "<i>어떻게 생각하는지 말해준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = c8cd1244-0cf7-a7a3-1620-0bf60d35a99c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:c8cd1244-0cf7-a7a3-1620-0bf60d35a99c
msgctxt "h976f7378gbd4dg4219gaae1gae01bce5c747"
msgid "I could use more time."
msgstr "시간이 좀 더 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = c8f4a4f4-60eb-aae5-9978-41fe5952a733
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:c8f4a4f4-60eb-aae5-9978-41fe5952a733
msgctxt "h7de6db57gb621g41begb332g520f616f1b57"
msgid ""
"But my work has only begun. There is more still to find. I must get to it!"
msgstr "하지만 내 작업은 이제 시작에 불과해. 아직 찾아야 할 것들이 많이 남았어. 반드시 찾아야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = cc85b554-360f-178e-9ee2-ac33acedde81
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_TriedCheckTwo(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_TriedCheckTwo(1) = True
#.     - UND_DuergarRebelMason_Event_TriedOneCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:cc85b554-360f-178e-9ee2-ac33acedde81
msgctxt "ha1c4c62fg6abeg402egb861g4275a76f1c9d"
msgid "<i>Assess the statue for technique and composition.</i>"
msgstr "<i>조각상의 기법과 구도를 평가한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = cf3e75c1-fd54-260b-0f82-ff22d613ebac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:cf3e75c1-fd54-260b-0f82-ff22d613ebac
msgctxt "h3a7e9001g2827g4cd8g9f7fgdf7d882a5263"
msgid "Let's see what you've got."
msgstr "어떤 걸 가지고 있는지 한 번 볼까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = d02c0f91-b148-e04a-533a-0cbcaa388fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:d02c0f91-b148-e04a-533a-0cbcaa388fc6
msgctxt "ha304deefg5e98g4a58ga57agdbd8b11bb757"
msgid "What are you doing, exactly?"
msgstr "정확히 뭘 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = d5984e63-56d3-3e24-e70d-241d52fef4d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:d5984e63-56d3-3e24-e70d-241d52fef4d6
msgctxt "he0945c39gf72ag4c70g9638g58b94b71331b"
msgid ""
"*No quake brought these rocks down - they were smashed through in an "
"instant. Something big charged through here. Something very big.*"
msgstr ""
"*흔들림에 의해 바위가 무너진 것이 아닙니다. 순식간에 박살 난 것으로 보입니다. 커다란 무언가가 이곳을 뚫고 돌진했습니다. 아주 거대한 "
"무언가가 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = d5e92113-7be7-8a60-a706-3808af6f0c4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:d5e92113-7be7-8a60-a706-3808af6f0c4c
msgctxt "hc810e63fg663fg41e8g8c2agd9c6f1cbc87d"
msgid ""
"As rare as a smile in Sschindylryn, you might say. But I've no skill for "
"slaving - I prefer chisel to cane."
msgstr ""
"쉰딜린에서 미소를 보는 것만큼이나 희귀한 일이라고 해도 되겠지. 하지만 난 노예를 부리는 일에는 관심 없어, 채찍보단 끌을 좋아하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = d8df4b0c-ad14-5434-a5e3-da44e1f1fb59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_TriedOneCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:d8df4b0c-ad14-5434-a5e3-da44e1f1fb59
msgctxt "hac2c490cg4d47g424dgba24gfe8653af6860"
msgid "I am ready to report my observations."
msgstr "내 조사 결과를 알려줄 준비가 되었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = de79b726-6336-ca23-2dfa-1ba15417e56e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:de79b726-6336-ca23-2dfa-1ba15417e56e
msgctxt "h7560f419g4759g4b2bgb745gc4ae824647ad"
msgid "*What this pattern signifies, you can't fathom.*"
msgstr "*이 양식이 뭘 의미하는지는 헤아릴 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = df9bf25f-63eb-755c-afd1-3cbe9f951c9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InfernalPlate_HasPlate(0) = True
#. SetFlags:
#.   Object:
#.     - UND_InfernalPlate_GivePlate(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:df9bf25f-63eb-755c-afd1-3cbe9f951c9d
msgctxt "ha819141dgb6bdg46d9ga4c7g5b07fd452187"
msgid ""
"Doesn't explain this infernal plate I found, though. Here, take it, perhaps "
"you'll be able to figure it out why it's here."
msgstr "내가 찾은 지옥 합금은 설명하지 못하는군. 여기, 가져가, 자네라면 이게 여기 왜 있는 건지 알아낼 수도 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = e0fba046-8961-dd74-2a88-ad215abcc613
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_PassedAreaCheck(1) = True
#.      - UND_DuergarRebelMason_Event_PassedStatueCheck(1) = True
#.      - UND_DuergarRebelMason_Event_PassedRubbleCheck(1) = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarRebelMason_State_LearnedHistory = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.UND_DuergarCamp_Stonemason_SucceededChecks(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:e0fba046-8961-dd74-2a88-ad215abcc613
msgctxt "hb2ea3789gbb84g44eega8eagba3d44bf086d"
msgid "Incredible - an entire history, risen from dirt and debris! Picture it:"
msgstr "환상적이군, 이 진흙과 잔해 속에서 역사 전체를 발견할 수 있어! 상상해 봐:"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = e3c1b01c-be0e-ead8-066d-cd6534a76086
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_PassedStatueCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:e3c1b01c-be0e-ead8-066d-cd6534a76086
msgctxt "h0828be28gd296g4a54g97d1g6ca6906c7791"
msgid ""
"The statue is newer than the fortress, you say? So obvious in hindsight."
msgstr "요새가 조각상보다 오래되었다는 뜻인가? 생각해 보니 굉장히 뻔한 거였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = e8aeb788-feaa-4a81-94f3-597c3ef7c0c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InfernalPlate_HasPlate(0) = True
#. SetFlags:
#.   Object:
#.     - UND_InfernalPlate_GivePlate(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:e8aeb788-feaa-4a81-94f3-597c3ef7c0c6
msgctxt "ha4c7d36fg7c01g4986gb269gb4ec07310f59"
msgid ""
"Heh - that explains the infernal plate I found. Perhaps you might have use "
"of it."
msgstr "허. 그렇게 생각하니 내가 찾은 지옥 합금이 설명되는군. 자네가 가지는 게 나을지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = eabacbe6-5b35-6cd1-66f0-e4bddbd13ed2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_PassedAreaCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:eabacbe6-5b35-6cd1-66f0-e4bddbd13ed2
msgctxt "h980dab44gecedg4f6dg9368gcbb2494ed580"
msgid ""
"*Several glassy stones stand out in the debris. Their borders are coated "
"with tiny yellow crystals.*"
msgstr "*잔해 속에서 유리 같은 바위 몇 개가 눈에 띕니다. 돌의 테두리는 조그마한 노란색 결정으로 코팅되어 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Narrator
#. NodeID = eb69238f-3411-e3fd-c60a-45e0c86b9219
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_PassedStatueCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:eb69238f-3411-e3fd-c60a-45e0c86b9219
msgctxt "hf71aa576g301dg4ccbga5fag1f537ba5ab05"
msgid ""
"*The statue's meandering curves and golden edges stand out against the "
"weathered masonry behind it.*"
msgstr "*조각상의 구불구불한 곡선과 황금빛 가장자리가 풍화된 석조와 대비되어 더욱 돋보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = ef96c7d3-df4a-db72-debb-217a0b0d76fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6cf0c1f2-d8ea-34f2-e612-c0df2cb4aeb6_BardRememberedTale = True
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarRebelMason01_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:ef96c7d3-df4a-db72-debb-217a0b0d76fd
msgctxt "hea6100f7g7f82g4a70gb382g15dd3c2b2638"
msgid "<i>Recite the tale you remembered from your reading</i>."
msgstr "<i>당신이 읽었던 내용을 기억나는 대로 암송한다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = fc1f89ec-69fc-8e00-a343-499d2e27452d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:fc1f89ec-69fc-8e00-a343-499d2e27452d
msgctxt "hac9109a5gd988g43a2g8be3g2a3dd11cf987"
msgid ""
"I prefer evidence, hard as stone. Look again, what can you <i>see</i> before "
"you?"
msgstr "난 바위처럼 단단한 증거를 선호한다네. 다시 살펴보게, <i>뭐가</i> 보이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Stonemason Kith
#. NodeID = fc33feb7-cfcc-26d2-d6f0-90b8680d2dbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_PassedAreaCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:fc33feb7-cfcc-26d2-d6f0-90b8680d2dbe
msgctxt "hfdf699feg4c31g44b4g813bgd689a3a32dc2"
msgid "Sulphur. Of course! The rocks have been altered by hellfire."
msgstr "유황이라. 그렇군! 지옥의 불길로 바위가 변형된 게야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = fcee5fac-d989-9c57-dffc-87a97fb752e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:fcee5fac-d989-9c57-dffc-87a97fb752e7
msgctxt "hf51808a5gdb44g4f88gb2f0gc018f1db3174"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = ff65c291-0978-1ce4-53d7-d0e491046b8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_MentionedWelcome(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_MentionedWelcome(1) = True
#. TagRule: UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:ff65c291-0978-1ce4-53d7-d0e491046b8e
msgctxt "h72ad9296g98fbg435cg80b0g7e35577f3f8e"
msgid "A suspiciously eager welcome from a duergar."
msgstr "듀에르가 치고는 수상할 정도로 열정적인 환영 인사군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01
#. Speaker = Player
#. NodeID = ff65c291-0978-1ce4-53d7-d0e491046b8e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason_Event_MentionedWelcome(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarRebelMason_Event_MentionedWelcome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_01:ff65c291-0978-1ce4-53d7-d0e491046b8e
msgctxt "hff111e52gfb22g4a96g8addg66593e8479eb"
msgid "A friendly welcome? A rarity in the Underdark."
msgstr "친근한 환영이라? 언더다크에선 흔치 않은 경험이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02
#. Speaker = Stonemason Gergerann
#. NodeID = 295f2562-589d-5181-0d1f-bab70f58a296
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarRebelMason02_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02:295f2562-589d-5181-0d1f-bab70f58a296
msgctxt "h2f5913e1g7454g443eg994dg8d58a3998747"
msgid "Whatever that look is - don't give it to me."
msgstr "뭔 생각인지는 모르겠지만, 그런 눈으로 쳐다보지 좀 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02
#. Speaker = Stonemason Gergerann
#. NodeID = 44728fc8-6aca-9c6b-b739-d655eab486eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarMason_02_HasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02:44728fc8-6aca-9c6b-b739-d655eab486eb
msgctxt "hcffacf1cg4cdcg440aga287g418ff314cbbc"
msgid "Stop breathin' down my back."
msgstr "그만 방해해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02
#. Speaker = Stonemason Gergerann
#. NodeID = 7617ca24-85aa-27b7-decf-634187d8b88a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarRebelMason_State_LearnedHistory = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02:7617ca24-85aa-27b7-decf-634187d8b88a
msgctxt "hb366d9e0g1d0cg443cg9e7fge4afc414c6b4"
msgid ""
"I'll give you one thing - you got a keen eye. Even <i>jarghs</i> have their "
"uses."
msgstr "이것 하나는 인정하지, 예리한 눈을 가졌구만. <i>자그</i> 놈들도 쓸모가 있을 때가 있다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02
#. Speaker = Stonemason Gergerann
#. NodeID = 84559caa-1ecf-e96f-335a-a522db398ebc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarMason_02_HasMet = False
#. SetFlags:
#.   Global:
#.     - UND_DuergarMason_02_HasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02:84559caa-1ecf-e96f-335a-a522db398ebc
msgctxt "he1caf489gd8f9g4bb5g982fgbb848dcc6ab3"
msgid "If you aren't here to inspect the stonework, then get lost."
msgstr "석조물을 살펴보러 온 게 아니라면, 저리 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02
#. Speaker = Stonemason Gergerann
#. NodeID = 9ee2fd41-c584-46f0-83a1-1775864df2a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02:9ee2fd41-c584-46f0-83a1-1775864df2a6
msgctxt "h4f60a7b1g8e2cg46e5ga144gf79b691c1d15"
msgid "And if you are... well, I doubt you've got anythin' useful to say."
msgstr "그리고 살펴보러 온 거라면... 글쎄, 네가 딱히 도움이 될 것 같진 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarRebelMason_02
