msgctxt "h0264c287g93a9g4030g9897g10ab2ad8d2d7"
msgid "You... stinkin' <i>thief</i>. I'll rip your fingers off."
msgstr "이... 더러운 <i>도둑놈</i>. 그 손가락을 뜯어주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Gale
#. NodeID = be1cc248-879c-09a8-b8aa-e220d2363812
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:be1cc248-879c-09a8-b8aa-e220d2363812
msgctxt "hffef7a2cg0e7dg4fdcg8cf8g145572426197"
msgid "Well! I've never seen sleight of tongue quite like that before."
msgstr "이야! 혀놀림이 예사롭지 않은데 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Gale
#. NodeID = bef76aa0-707d-dbc5-72c4-29e0ce1b005f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:bef76aa0-707d-dbc5-72c4-29e0ce1b005f
msgctxt "hc9c41076ge355g49f5g806bg5cc56ae82609"
msgid ""
"Don't take this the wrong way, but I think I've just lost all respect for "
"you."
msgstr "오해하지는 않았으면 좋겠는데, 방금 너에 대한 존중이 사라진 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = bf012644-4a60-a4e2-fa4f-c4937ccdf85d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(4) = False
#.   Tag:
#.      - TRUESOUL(4) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:bf012644-4a60-a4e2-fa4f-c4937ccdf85d
msgctxt "h043b2d58g9d14g451cgbb25g422afb1214cc"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c0362fd9-ab65-4489-2ae3-7edb39f8373d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c0362fd9-ab65-4489-2ae3-7edb39f8373d
msgctxt "h95436a95g3123g4db4g933cga3f40838642f"
msgid "Fine. A fist to yer mouth it is."
msgstr "좋아. 네 입에 주먹 날아간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c07cac76-3b89-e456-95a3-14d2632b2c21
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_ShowedBrand(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c07cac76-3b89-e456-95a3-14d2632b2c21
msgctxt "hbf3e66d5g37d8g45a5g8aa2g5284b2f1c166"
msgid ""
"I'll let you off this once, but don't interrupt me again. Gotta learn to "
"respect yer elders."
msgstr "이번엔 봐주겠지만 다신 날 방해하지 마. 연장자를 존중할 줄 알아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = c169623d-597a-2e2c-84a2-ff8e68676ec7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(4) = False
#.   Tag:
#.      - TRUESOUL(4) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c169623d-597a-2e2c-84a2-ff8e68676ec7
msgctxt "h1b437882g6e23g499fg9631g30cbcb4724aa"
msgid "You <i>will </i>obey me. Kneel."
msgstr "내게 <i>복종해야</i> 할 거다. 무릎 꿇어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Lae'zel
#. NodeID = c26da22b-5698-4986-b1de-91c63fe6ea30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c26da22b-5698-4986-b1de-91c63fe6ea30
msgctxt "hb83df4a6g13e0g4b5bgacc5gacc1101308b1"
msgid "End him or leave him. But don't you dare grovel to this slug."
msgstr "그놈을 끝장내거나 내버려둬라. 다만 이 달팽이에게 굽실거릴 생각은 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c37f214f-18d0-ae90-c588-78fec0d732b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#. TagRule: ELF or HALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c37f214f-18d0-ae90-c588-78fec0d732b7
msgctxt "h6efc4c65g2a03g4bfag80f7g1742b391ea2b"
msgid "Or I'll wipe that nasty look right off yer pretty face."
msgstr "안 그럼 너의 이쁜 얼굴에서 그 재수 없는 표정을 씻어내주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c37f214f-18d0-ae90-c588-78fec0d732b7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
