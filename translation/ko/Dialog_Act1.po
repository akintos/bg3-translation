msgctxt "h37ca7558g72b3g40dfgbfd2g57c9da034723"
msgid "*Around his neck is a collar, etched with a name - 'Scratch'.*"
msgstr "*채워진 목걸이에 이름이 쓰여 있습니다- '스크래치'.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 4ede21df-0560-0b20-7754-acd9aa7d8aff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
