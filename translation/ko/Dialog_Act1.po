#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = True
#. TagRule: !UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:185df249-df48-92f3-96cd-1701ee9a8234
msgctxt "h8194fa32g43dbg413agb1adg262cef30fda7"
msgid "Nicely handled. For sun-scum."
msgstr "잘 했아. 태양 쓰레기 자식치고는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = 185df249-df48-92f3-96cd-1701ee9a8234
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
