msgctxt "h79365ebag0402g40bcg987bg18c0e195597d"
msgid "I'm a hired sword - employer's inside. Stand aside. <i>Now.</i>"
msgstr "나는 고용된 용병이다. 고용주가 안쪽에 있어. 비켜. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
