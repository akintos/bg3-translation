msgctxt "h698b3e75g56ffg4c53gbf3dgf4e4bd8c7725"
msgid "Still blocked. A little extra force should clear the way."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked
#. Speaker = Player
#. NodeID = a2554fa0-4fb3-40ca-acc5-3262b7def704
