msgctxt "hec33b1c3g11f9g4288g95a6g6283765e4044"
msgid "Enough - draw your weapon!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Brawler Rancer
#. NodeID = 22bbe93c-e72f-9462-ab56-84ce74161d44
