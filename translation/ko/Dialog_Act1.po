msgid "That thing could swallow each of us whole."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 9453a72f-f132-52d5-edef-3711829517f0
