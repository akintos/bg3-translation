msgctxt "h5d1a6ce9g924bg45d7g9ec4g7c696c0648e1"
msgid "This is gonna be my ninth... no - <i>tenth </i>cup."
msgstr "이게 내 아홉 번째... 아니 - <i>열 번째</i> 잔이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_002
#. Speaker = Tracker Tak
#. NodeID = b054f479-a5df-369d-da2c-be95f65236af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_002:b054f479-a5df-369d-da2c-be95f65236af
msgctxt "hcbd9d9b7gf25cg40dfgbe7fg410058ba7f20"
msgid "Outta my way!"
msgstr "내 앞에서 비켜!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_003
#. Speaker = Brawler Rot
#. NodeID = e832a226-b77f-1cd7-6794-b1c0acc134e6
