msgctxt "h71f3d48ag3939g4004g9da0g4b5f4859cdba"
msgid "I-I-I didn't realise. Very sorry, your grace. <i>Very </i>sorry."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = Narrator
#. NodeID = b74bbfd9-93c9-68dd-d813-4d190ad4788e
