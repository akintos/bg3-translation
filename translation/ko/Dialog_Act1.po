msgctxt "hf8b8acb1g7295g4457ga0b5gc61d7aa22e6e"
msgid "A prayer, and a symbol. Hidden for a reason, perhaps."
msgstr "기도문과 문양이군. 숨겨둔 데에는 분명 이유가 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_PickupPrayerSheet
