#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:d8e2e5bd-6d95-4e5e-915f-f123c43b1768
msgctxt "hf4c676e2g5d75g4e94g99bag115507a270f2"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Herdmaster Skarjall
#. NodeID = e4b796d7-ad5a-4ffe-bd37-cda649e11c1b
#. HandlePath = TaggedText[0].TagText[0]
