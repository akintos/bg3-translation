msgctxt "h5241ebccgf0c5g4a10g87f0ge41437aef18d"
msgid "Mountains..."
msgstr "산..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Narrator
#. NodeID = f0adfdae-1bc4-4cfe-9359-3130b3cfcf1d
