msgctxt "he0340e10gfce7g4d3fgb588g380d47911719"
msgid "Oh, you fool. We'll destroy you."
msgstr "오, 바보 같으니. 우리가 박살내주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = f4b2f232-41c2-411d-8f9a-1f9abf581ecd
