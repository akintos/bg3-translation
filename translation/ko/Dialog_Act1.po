#. NodeID = f132ec18-c38f-5810-7ecb-629c6ee12e2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene:f132ec18-c38f-5810-7ecb-629c6ee12e2d
msgctxt "hdacf4ba8gaea1g46cfgb52fg62a824d3217a"
msgid "A walk would cheer me up."
msgstr "좀 걸으면 기운이 날 것 같은데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HusbandGrave
