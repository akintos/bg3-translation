msgctxt "h0704a773g02e6g4e6fga197g1280ed6178ef"
msgid "No. Free me."
msgstr "아니. 날 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Brawler Birka
#. NodeID = a78f83c4-e43b-c2ab-27ed-ee00a6255639
