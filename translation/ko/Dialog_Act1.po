msgctxt "hdd560c1eg6a56g4379g9471gfb2372e5b82e"
msgid "Could there truly be a temple of Shar <i>here...?</i>"
msgstr "이곳에 진짜로 샤님을 섬기는 사원이 <i>있을까...?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Mural
