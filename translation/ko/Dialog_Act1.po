#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:acabd21e-1730-9d6a-00f3-498754fb3dbb
msgctxt "h29049cc7g5ed8g4490ga20cg280d89434d48"
msgid ""
"You're wasting your time with this one. There are corpses outside with far "
"more loot."
msgstr "시간 낭비하는 거야. 밖에는 전리품이 훨씬 많은 시체가 잔뜩 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = bb11babb-bd2a-548f-994f-8aa5c623161e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Festivities_Event_KidsRun = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:bb11babb-bd2a-548f-994f-8aa5c623161e
msgctxt "hbdb60ed2g02f6g47deg8534g7f256ff9bc56"
msgid "I'll - I'll leave him to you, uh, your highness."
msgstr "그, 이건 당신에게 드리겠습니다, 어, 폐하."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Narrator
#. NodeID = cae98231-c81a-2e8e-b7ac-b1ecf07ea031
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:cae98231-c81a-2e8e-b7ac-b1ecf07ea031
msgctxt "h2ea77e29g4c1dg423cgb583g41e5516c0a4f"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Player
#. NodeID = ccf11a45-c0b1-e2fa-4b2d-fb6640658b3c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:ccf11a45-c0b1-e2fa-4b2d-fb6640658b3c
msgctxt "h24368855g373fg428eg8348g6d6229df37fd"
msgid "Boss' orders. I'm collecting his loot."
msgstr "대장의 명령이야. 전리품을 가져가야겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Player
#. NodeID = d2359176-38cd-ba0c-d9db-b9aaada871fb
