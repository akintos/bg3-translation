#. CheckFlags:
#.   Dialog:
#.      - FOR_GoblinAmbush_PatrollingGoblin_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_GoblinAmbush_PatrollingGoblin_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PatrollingGoblin:87da663b-0bbf-d0e7-d916-476c06a33f3e
msgctxt "hb27467adg7e6dg41ddg89b4g777c9c3f8853"
msgid "Hello, yer high and mightiness. Welcome to Bogrot."
msgstr "안녕하십니까, 당신의 고귀한 위엄을 뵙습니다. 보그로트에 오신 것을 환영합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_Warning
#. Speaker = Goblin Booyahg
#. NodeID = 1413f8ce-b05e-43cf-a1f4-21000a6dd94d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GoblinAmbush_GoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_Warning:1413f8ce-b05e-43cf-a1f4-21000a6dd94d
msgctxt "hf2b920c1ga10dg49b8ga251g07193f8b8ff6"
msgid "More of our crowd inside, but we'll send word you're all right."
msgstr "안쪽에 우리 무리들이 더 있지만, 너희들이 무사하다는 소식을 전할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_Warning
#. Speaker = Goblin Booyahg
#. NodeID = da444c04-80b7-4fde-4e13-a517d63743fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_Warning:da444c04-80b7-4fde-4e13-a517d63743fb
msgctxt "hf73fdb8bg7e56g4c35gba9dg306098463426"
msgid "You'd best get running the other way, mate."
msgstr "어서 반대쪽으로 도망치는 게 나을걸, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_IncompleteMasterwork_AD_ForgeWeapon
#. Speaker = Player
#. NodeID = 14983975-ffb9-08ba-c291-a18dd8c2820a
