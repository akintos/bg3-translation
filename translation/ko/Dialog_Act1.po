#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop1 = False
#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop3 = True
#. SetFlags:
#.   Local:
#.     - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop2 = False
#.     - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop1 = False
#.     - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop3 = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AstarionRecruitment_Recruitment_AD:6eec7d24-c41f-887b-cda2-aaa1fb082102
msgctxt "hd8fb1deag911ag45d8gb39cg8c1f20435935"
msgid "Please? Please come and help me?"
msgstr "제발. 나 좀 도와주지 않을래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AstarionRecruitment_Recruitment_AD
#. Speaker = Astarion
#. NodeID = aa517f34-1eeb-adef-44b4-8f3fad42c303
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop2 = False
#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop1 = True
#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop3 = False
#. SetFlags:
#.   Local:
#.     - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop2 = True
