msgctxt "h3c3a6dffg88ceg42cfg903cg89db7da555bd"
msgid "He's still breathing. That's more than Kanon can say."
msgstr "적어도 숨은 쉬고 있군. 카논보단 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = d59a04fa-c988-5754-12b9-61d0d4ebba49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_AdventurerLeft = False
#.      - DEN_AdventurerLeader_State_PermaDefeated = False
#.   Local:
#.      - c68c5474-226f-4b47-b327-a22274e360a0_C = True
#. SetFlags:
#.   Local:
#.     - c68c5474-226f-4b47-b327-a22274e360a0_C = False
#.     - c68c5474-226f-4b47-b327-a22274e360a0_B = False
#.     - c68c5474-226f-4b47-b327-a22274e360a0_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro:d59a04fa-c988-5754-12b9-61d0d4ebba49
msgctxt "h7d30f6c4gc957g4732ga381gb0e9b9852759"
msgid "This mess won't help us with the druids."
msgstr "이런 난장판은 드루이드와의 관계를 나쁘게 할 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = d80d813b-3c5a-2d91-7426-7133a9d086ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c68c5474-226f-4b47-b327-a22274e360a0_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro:d80d813b-3c5a-2d91-7426-7133a9d086ef
msgctxt "h2c8f9fe2g20e9g4f74ga013g86e8c3d3152c"
msgid "Time to pack. We need to leave."
msgstr "짐을 싸야겠어. 여길 떠나야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = e4df08c4-7730-6314-86e6-f829d46a3311
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c68c5474-226f-4b47-b327-a22274e360a0_A = True
#. SetFlags:
#.   Local:
#.     - c68c5474-226f-4b47-b327-a22274e360a0_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro:e4df08c4-7730-6314-86e6-f829d46a3311
msgctxt "hf5248b55gcb23g4daag8539g7cc423395fce"
msgid "That was close. Far, far too close."
msgstr "너무 아슬아슬했어. 너무, 너무 나도 아슬아슬했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = f0d95045-250a-208d-4bff-4a8ee5f33059
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c68c5474-226f-4b47-b327-a22274e360a0_C = True
#. SetFlags:
#.   Local:
#.     - c68c5474-226f-4b47-b327-a22274e360a0_C = False
#.     - c68c5474-226f-4b47-b327-a22274e360a0_B = False
#.     - c68c5474-226f-4b47-b327-a22274e360a0_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro:f0d95045-250a-208d-4bff-4a8ee5f33059
msgctxt "h319b39fegfb98g4fb8gbc6fg6226307b222c"
msgid "Another grave to dig. We're getting far too much practice at that."
msgstr "또 무덤을 파야겠군. 이제 점점 무뎌지는 느낌이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_Victory
#. Speaker = Zevlor
#. NodeID = 9554a2e6-551e-4cf2-a678-e75ade6573f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0a5293d-bd64-44eb-c408-274b9993abbb_B = True
#. SetFlags:
#.   Local:
#.     - d0a5293d-bd64-44eb-c408-274b9993abbb_A = False
#.     - d0a5293d-bd64-44eb-c408-274b9993abbb_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_Victory:9554a2e6-551e-4cf2-a678-e75ade6573f9
msgctxt "h1823d4d1ga84dg4eedgae5cgf3fe6c29bf98"
msgid "We're leaving. Now!"
msgstr "떠납시다. 당장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_Victory
#. Speaker = Zevlor
#. NodeID = b117e0c6-80e6-41f4-8213-eb20859f7c19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0a5293d-bd64-44eb-c408-274b9993abbb_A = True
#. SetFlags:
#.   Local:
#.     - d0a5293d-bd64-44eb-c408-274b9993abbb_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_Victory:b117e0c6-80e6-41f4-8213-eb20859f7c19
msgctxt "h045a4677gb8a0g40edg8d3fgaeb383da39cf"
msgid "It's time, everyone. Let's go!"
msgstr "시간이 됐소, 여러분. 갑시다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_Victory
#. Speaker = Zevlor
#. NodeID = ee7ef739-370b-4f53-a4e1-96caa9457eb6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d0a5293d-bd64-44eb-c408-274b9993abbb_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_Victory:ee7ef739-370b-4f53-a4e1-96caa9457eb6
msgctxt "h23daddd4gba35g4629g8803gf3c97795d04d"
msgid "Grab your bags. We're moving!"
msgstr "가방을 챙기시오. 이제 출발합니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = 29133727-e7de-b535-a280-124f75dac7db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:29133727-e7de-b535-a280-124f75dac7db
msgctxt "h6379efccg6e01g48dfga4ebg351aa9fc7555"
msgid "Just Zevlor, Tilly. We're civilians now, remember?"
msgstr "그냥 제블로어라고 부르게, 틸리. 우린 이제 민간인이잖나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Tilses
#. NodeID = 2c46f7d6-e50d-f8a9-d823-401eb8bfdbc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:2c46f7d6-e50d-f8a9-d823-401eb8bfdbc3
msgctxt "h607843afg246dg451cgb8cbgffdd86475403"
msgid "With respect, sir - being a Hellrider is for life. They can't take -"
msgstr "외람된 말씀이지만, 한 번 지옥기수는 영원한 지옥기수입니다. 그놈들이 멋대로 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = 39925ef0-6c98-eb6f-e0c4-78a431157eed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_C = True
#. SetFlags:
#.   Local:
#.     - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_C = False
#.     - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_A = False
#.     - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:39925ef0-6c98-eb6f-e0c4-78a431157eed
msgctxt "h7e72b50dgcdb7g49ffgb262gc3f6bd223edf"
msgid "I hardly need a bodyguard, Tilses. This isn't Avernus."
msgstr "날 굳이 경호할 필요는 없어, 틸세스. 여긴 아베르누스가 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = 3b9cd0af-3d00-bd17-7fde-456745961a43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:3b9cd0af-3d00-bd17-7fde-456745961a43
msgctxt "hc09b11c7g7cccg43c8gbaabg094de72e2d4d"
msgid "But go with the Watch. You're too honest to be a mercenary."
msgstr "자네는 워치에 지원해보게. 용병이 되기엔 너무 올곧잖나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Tilses
#. NodeID = 45ea48ed-79e9-9a78-24cd-2df26ce7c4a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:45ea48ed-79e9-9a78-24cd-2df26ce7c4a2
msgctxt "h7b998ae3gf158g4517g98c0gc52c41bf3fda"
msgid "No sir. At least the monsters there <i>looked </i>like monsters."
msgstr "아닙니다. 거기 괴물들은 적어도 딱 보면 <i>괴물 티라도</i> 나잖습니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = 6ffcaea7-5bb2-7471-b58c-2fd23bb376b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:6ffcaea7-5bb2-7471-b58c-2fd23bb376b5
msgctxt "h0d2e0736g0941g4b79gb50agc64d4962ac74"
msgid "They can, and did. Avernus changed things - best we get used to that."
msgstr "그럴 수 있고, 실제로 그리됐지. 아베르누스가 모든 걸 바꿔놨어. 이만 익숙해지게나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Tilses
#. NodeID = 772c7c43-97a8-f6bd-b5ff-63a316721c49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:772c7c43-97a8-f6bd-b5ff-63a316721c49
msgctxt "h0745357fg1313g4cfbg87b9gcb6568d13441"
msgid ""
"No sir. But if there's a clear path past those goblins, they'll find it."
msgstr "없습니다. 하지만 고블린 놈들을 우회할 길이 있다면, 그들이 꼭 찾아낼 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Tilses
#. NodeID = 9b48e02b-5d21-3878-4fc7-1f6b243ebb1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_B = True
#. SetFlags:
#.   Local:
#.     - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:9b48e02b-5d21-3878-4fc7-1f6b243ebb1a
msgctxt "h71969e93g9710g4604gbe69g7646633c1d54"
msgid "The Watch or the Flaming Fist?"
msgstr "워치가 좋을까요? 아니면 플레이밍 피스트?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = 9c1c240e-1c9e-50c5-ec4a-2604ff4a6119
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:9c1c240e-1c9e-50c5-ec4a-2604ff4a6119
msgctxt "hf6f217bcgcac9g4378gbabfgdb9825c46d45"
msgid "Yes. Of course."
msgstr "그래. 그렇겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Tilses
#. NodeID = b31d47f4-9f83-6d11-8040-6cf15ae07382
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:b31d47f4-9f83-6d11-8040-6cf15ae07382
msgctxt "hce9606deg401bg45d5g9b78g72fbb6878a0b"
msgid "When we get to Baldur's Gate. Where are we enlisting?"
msgstr "발더스 게이트에 도착하면요. 어디에 들어가야겠습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = bfead7fb-5b9a-19a5-07d3-b2625ea79968
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:bfead7fb-5b9a-19a5-07d3-b2625ea79968
msgctxt "hc92030cdg30b7g4047g9bfbg618c28978924"
msgid "No word from the scouts yet?"
msgstr "정찰대 쪽 소식은 아직 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = cb94325e-6c91-a6a6-5f06-01f8488d5a6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:cb94325e-6c91-a6a6-5f06-01f8488d5a6b
msgctxt "hd137527dgb0deg4ff1g86f2g6cf6b1bd2b11"
msgid "Pardon?"
msgstr "뭔 소린가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Tilses
#. NodeID = e491d8e2-5ecb-4d93-ad08-abbb833f011e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_A = True
#. SetFlags:
#.   Local:
#.     - 9e5bdd1f-e1ea-38d5-ccd5-c8f36ef11874_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:e491d8e2-5ecb-4d93-ad08-abbb833f011e
msgctxt "hbe9f9d50g01c6g4375g886ag69cbfb2add12"
msgid "Commander -"
msgstr "사령관님 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Tilses
#. NodeID = ee8174c3-45ba-a556-6769-97a29a50c1ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:ee8174c3-45ba-a556-6769-97a29a50c1ec
msgctxt "hbccb36fbgfff3g4dd4gb0d2gfec892ce1055"
msgid "... yes, Zevlor."
msgstr "... 예, 제블로어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard
#. Speaker = Zevlor
#. NodeID = f76646c8-3aec-e93f-293d-513eadbad201
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_WithGuard:f76646c8-3aec-e93f-293d-513eadbad201
msgctxt "h4339eaf7g47f1g4606g8f8agdf3892628201"
msgid "I'm done soldiering, Tilly. I'd like a clean start."
msgstr "군인 노릇은 질렸어, 틸리. 난 새 출발을 했으면 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 0483e04a-367c-c5d4-7bc9-f77c3e304d9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:0483e04a-367c-c5d4-7bc9-f77c3e304d9e
msgctxt "he0604443g37d4g4b3egbb10g3a0c67ffc4ae"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 04c97c80-e43e-f212-fbc2-d20d265e60c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:04c97c80-e43e-f212-fbc2-d20d265e60c6
msgctxt "he6090050g1d2cg4d2fg91e7g7bd36931b9c7"
msgid "Aradin ran off."
msgstr "아라딘은 튀었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 04e9160b-0378-8a65-404c-0adcf9939a1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:04e9160b-0378-8a65-404c-0adcf9939a1b
msgctxt "h4d19dbcfg0652g4950gbfeegccf678d00272"
msgid ""
"Indeed - I'll survive a sore jaw. This grove has bigger problems right now."
msgstr "그래. 턱 아픈 것쯤은 감내할 만하지. 지금 이 숲은 더 큰 문제를 안고 있으니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 05cf2454-9612-299f-9d40-249384236010
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:05cf2454-9612-299f-9d40-249384236010
msgctxt "he91fe379g01ecg4bb7gb7f4gefcfcb35c529"
msgid ""
"I wouldn't have looked to a drow for help, but I'm grateful all the same. "
"I'm Zevlor."
msgstr "드로우에게 도움을 받으리라곤 생각지도 못했지만, 어쨌든 정말 고맙네. 난 제블로어일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 08778f18-c404-a07b-9f9e-f48f204667b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:08778f18-c404-a07b-9f9e-f48f204667b2
msgctxt "hfffeed9agff55g406dg8c2eg8e3df981616b"
msgid "I can see that. You're lucky your little display scared him off."
msgstr "나도 안다. 자네의 그 망할 과시로 놈이 내빼게 됐으니 이번은 봐주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 094ebeb6-44d6-346d-a4a1-53663be3dd59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:094ebeb6-44d6-346d-a4a1-53663be3dd59
msgctxt "h0925b1b8gb16ag4764g8e2agf1a6371495e7"
msgid ""
"Zevlor. Now unless you plan on striking me again, I have other problems to "
"attend to."
msgstr "난 제블로어다. 이제, 또 후려갈길 작정이 아니라면, 난 이만 다른 문제에 신경을 쏟아야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Shadowheart
#. NodeID = 0a99c9f2-c4f9-18b6-b174-bea97aa1b069
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:0a99c9f2-c4f9-18b6-b174-bea97aa1b069
msgctxt "he4188183ga379g49cdg82b3g527cc6697245"
msgid ""
"Let's not forget why we're here. No point in wasting precious time on a lost "
"cause."
msgstr "우리가 여기 왜 왔는지 잊지 마. 가망 없는 일에 귀중한 시간 낭비할 의미는 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 0b3f413a-2e44-0d45-df05-62f3960694aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = False
#.   Tag:
#.      - DROWHALFELF(1) = False
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:0b3f413a-2e44-0d45-df05-62f3960694aa
msgctxt "h1aa3a1beg17bag4940ga433g1b7f0258fedf"
msgid "A cheap shot. I should've expected that."
msgstr "다짜고짜 갈기다니. 미처 예상도 못했군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 0dba1c60-431f-79a0-076d-a3c6a8f9c0c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:0dba1c60-431f-79a0-076d-a3c6a8f9c0c5
msgctxt "h8732b9b4g2923g488dg8748gc810aaaf86c7"
msgid "I need a healer."
msgstr "난 치유사를 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 119ae5db-802b-2766-f5f5-a1e680d27cff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:119ae5db-802b-2766-f5f5-a1e680d27cff
msgctxt "h81b3eeabg76abg4684g8aa9g93d4ed562a5e"
msgid ""
"Let me guess: Your old neighbours called you 'devilkin' and acted like they "
"never knew you."
msgstr "알 만하네. 옛 이웃들이 당신들을 '악마족'이라고 매도하면서 안면몰수 해댔겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 1334798a-d24f-d359-be45-c510c31306bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:1334798a-d24f-d359-be45-c510c31306bb
msgctxt "hb40a55c4gb5d6g44eegbf5cg5432422d6a43"
msgid ""
"Very noble of you. Now unless you plan on striking me again, I have other "
"problems to attend to."
msgstr "거 참 고결하시군. 이제, 또 후려갈길 작정이 아니라면, 난 이만 다른 문제에 신경을 쏟아야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Narrator
#. NodeID = 133cc8de-c32d-61f1-e7fe-0e17d34d342a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:133cc8de-c32d-61f1-e7fe-0e17d34d342a
msgctxt "ha1d9a3a1g1178g4440g9729g24fbb35ae827"
msgid ""
"*You remember it. Elturel and all its citizens were dragged into Avernus - "
"then back out again.*"
msgstr "*기억이 납니다. 엘투렐 전체가 주민들과 함께 아베르누스로 끌려왔다가 도로 빠져나간 사건이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 14cada6b-c631-e082-f02a-27ab6d413373
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:14cada6b-c631-e082-f02a-27ab6d413373
msgctxt "hfc8f26fdgf139g4aacg8195gdbc2c8d3be52"
msgid "Is there a place for tieflings anywhere?"
msgstr "티플링을 위한 곳이 존재하기는 한가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 153104f5-122e-e989-37a5-bac54518706d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_TieflingLeader_Event_GaveName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:153104f5-122e-e989-37a5-bac54518706d
msgctxt "h292b37bdg177cg4c55g81d3g5d3b16ec1205"
msgid "I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53](이)야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 186e9a64-738b-254c-4047-3f5e0a401fab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:186e9a64-738b-254c-4047-3f5e0a401fab
msgctxt "hbf01b917gead2g4543gbafcgd4df7e29f980"
msgid ""
"I'll survive a sore jaw. What I won't tolerate is a stranger waltzing in "
"here and interfering in our business."
msgstr "턱 아픈 것 빼곤 괜찮다. 이방인이 우리 일에 멋대로 끼어들어 설치는 건 참아넘기지 못하겠지만 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 214eb4bd-2737-7bc2-f27d-ae187a30b7d1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:214eb4bd-2737-7bc2-f27d-ae187a30b7d1
msgctxt "h57b77e8fg2e54g4503gbb82g39047ede9b96"
msgid ""
"A cheap shot - to be expected from a drow. But you helped us, so instead of "
"killing you, I'll just ask:"
msgstr "다짜고짜 갈기다니. 딱 드로우다운 짓거리군. 그래도 우릴 도와줬으니, 죽여버리는 대신 질문부터 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 21784e05-f0e7-cfb2-d481-06c2fdc8e8f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_ReassuredDrow(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_ReassuredDrow(1) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:21784e05-f0e7-cfb2-d481-06c2fdc8e8f6
msgctxt "hb4f10aedg534cg47b2ga4b7ge95eb3b8a9a9"
msgid ""
"We're raised to fear the drow, but you've earned your place here. I'll make "
"sure everyone here knows that."
msgstr "드로우는 공포의 대상이지만, 자네라면 여기 있어도 괜찮아. 다른 사람들에게도 미리 얘기를 해두지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 242ca471-49d1-3c29-bfd8-0ce160161c95
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:242ca471-49d1-3c29-bfd8-0ce160161c95
msgctxt "h14c55e9fgf237g41aagb18bg3d3ea3bad8c9"
msgid ""
"If it's not too serious, you could try his apprentice, Nettie. She's with "
"the other druids, in the inner grove."
msgstr "심각한 부상이 아니면, 그의 제자인 네티에게 가 봐도 될 걸세. 숲 안쪽에 다른 드루이드들과 함께 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 2713876a-0d80-b04d-6423-61ec0c547d13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:2713876a-0d80-b04d-6423-61ec0c547d13
msgctxt "h389ab9ebgc80eg4c1bga4a6gcc5c2b45e3bf"
msgid "Aradin ran off."
msgstr "아라딘은 튀었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 27bca69c-ecc5-04f6-ac53-2fbc7f375a8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:27bca69c-ecc5-04f6-ac53-2fbc7f375a8e
msgctxt "h3ddbc451g80e5g4134ga544gd29a61d15384"
msgid "Who in the Nine Hells do you think you are?"
msgstr "대체 네가 뭐라고 이딴 짓을 벌인 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 284c77ce-4f94-8e28-02fc-2d739e61d0c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:284c77ce-4f94-8e28-02fc-2d739e61d0c2
msgctxt "h47a01209g2947g4361gb9f7ge1f713376cf6"
msgid "Outsiders, perhaps. But not me."
msgstr "외부인이라면 몰라도, 난 아니니 걱정 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 294a0175-a8ef-ef73-6f32-d7210fa0eca2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:294a0175-a8ef-ef73-6f32-d7210fa0eca2
msgctxt "hf668069ag7649g4396gb525gb48cb1fc9dfb"
msgid "I'll find her. And I'll speak to Kagha while I'm there."
msgstr "찾아가 봐야겠군. 간 김에 카그하랑도 얘기 해보겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 2c195d99-0d41-64ea-38c3-23bafa0ca039
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:2c195d99-0d41-64ea-38c3-23bafa0ca039
msgctxt "h8e2ebc5cgfa18g415dgb274g4bc783138324"
msgid "Found sanctuary here, did you?"
msgstr "여기라면 안식처가 되겠다 싶었어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 30044bfa-244c-830c-9ff1-e726d542a0e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:30044bfa-244c-830c-9ff1-e726d542a0e3
msgctxt "h7a7d83e8gcd01g4d6cg9409g5005de378d8e"
msgid "Did I, now? It makes no matter - this grove has problems enough."
msgstr "내 탓이라고? 이 얘긴 됐으니 관두지. 이 숲은 안 그래도 뒤숭숭한 판이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 3119ef2c-310e-2a14-2d32-0972d7cc27c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:3119ef2c-310e-2a14-2d32-0972d7cc27c1
msgctxt "h001302a0gac0fg48ecg8d7cg9dc85e6ed90c"
msgid "But we can't get there with those beasts blocking our path."
msgstr "저 짐승들이 길을 막고 있는 이상, 알아보러 갈 수도 없지만 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 313dc9b3-288b-3843-fa9e-3979c7b25d72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:313dc9b3-288b-3843-fa9e-3979c7b25d72
msgctxt "he6a84a3cg6f93g4e5cga112g5e0d9bcf2dbf"
msgid "This attack will only strengthen their resolve."
msgstr "이번 공세 때문에 더욱 강경하게 굴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 3150ec66-3847-ee9f-52d0-a18cb20e1b2b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_HeardAboutRitual = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:3150ec66-3847-ee9f-52d0-a18cb20e1b2b
msgctxt "h573bbaa6gc52eg4adag9745gd33efdc5e018"
msgid "They've started a ritual to cut the grove off from the world outside."
msgstr "그들은 이 숲을 외부와 단절시키는 의식을 시작해버리고 말았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 31dda480-1f36-68e7-dc5e-0618e973ecc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:31dda480-1f36-68e7-dc5e-0618e973ecc0
msgctxt "h87304944g6294g4bd4g83bbg5719aab824f1"
msgid ""
"We thought we'd found sanctuary here, but the druids have determined to turn "
"us out."
msgstr "여기에 이르러 안식처를 찾았다고 생각했건만, 드루이드들도 우릴 내몰기로 작심해버리더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 343e0119-869f-36cd-a562-2806d99a710b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:343e0119-869f-36cd-a562-2806d99a710b
msgctxt "he37e1670ge988g435fgb08eg799fe78cf623"
msgid "If your people survived that, they'll survive anything."
msgstr "그런 사건을 겪고도 잘 살아남았잖아. 앞으로도 잘 이겨낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 34e36f0d-5af3-5261-4905-4c113af8beae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b9b70f98-c95a-b05c-4594-e5a28a4b80ed_DEN_TieflingLeader_DenIntro_MentionedDebt = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:34e36f0d-5af3-5261-4905-4c113af8beae
msgctxt "hcb0610bbg23cdg4621ga039ga99f4641743f"
msgid ""
"We'd owe you a great debt. What little we have, we'll scrape together. It "
"isn't coin we need - it's <i>time</i>."
msgstr "그래준다면 큰 신세지. 가진 게 변변찮지만, 모조리 긁어모아 주겠네. 우리에게 필요한 건 돈이 아니라 <i>시간</i>이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 38b22f18-7152-0d39-767c-cc97fb3bbb4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:38b22f18-7152-0d39-767c-cc97fb3bbb4c
msgctxt "h2c9a1e26g3262g4e49gb351geea450318624"
msgid ""
"Whatever your business, I'd see to it quickly - the druids are forcing "
"everyone out."
msgstr "뭔 일로 왔는지 몰라도, 빨리 해결하는 게 좋을 걸세. 드루이드들이 모두를 내쫓고 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 3ad19a47-eb45-c4ca-1e42-314e5e474c56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:3ad19a47-eb45-c4ca-1e42-314e5e474c56
msgctxt "hf941a647g39f8g4b2aga1aag5aaaba26675d"
msgid ""
"There have been several attacks by different monsters. The druids blame us "
"'outsiders' for drawing them here. Nobody's welcome anymore."
msgstr ""
"다양한 괴물이 수차례 공격을 해왔다네. 드루이드들은 우리 '외부인'이 놈들을 끌어들인다고 몰아세우고 있지. 이젠 아무도 환영받지 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 3f2ceb1d-a9c8-1bfb-bd2e-b30ff0991ee5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:3f2ceb1d-a9c8-1bfb-bd2e-b30ff0991ee5
msgctxt "heb2e924dg0ed5g4197g9256g45ef28229450"
msgid "Why are they forcing you out?"
msgstr "왜 당신들을 내쫓으려 드는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 444a103b-2667-b52e-b9ae-b972d26afdfb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_TieflingLeader_Event_GaveName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:444a103b-2667-b52e-b9ae-b972d26afdfb
msgctxt "h37a01c94g15c6g4614g92c0g5d45ac01654c"
msgid "I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53](이)야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 4aebf4cf-6a1e-1da3-2588-81d3230e23b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:4aebf4cf-6a1e-1da3-2588-81d3230e23b4
msgctxt "h26c5a4b0g1ba2g4d5bg9337gf71f7f9b51a7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 4cb43a07-53ac-f678-e4f3-3f959774fdea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:4cb43a07-53ac-f678-e4f3-3f959774fdea
msgctxt "h3fa64d52gef1eg489cg9d78g7fa91542afc6"
msgid "Those goblins - have there been many attacks like that?"
msgstr "그 고블린들 말인데, 이런 공격을 자주 겪었어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Astarion
#. NodeID = 4da4e8a4-7659-231b-79d0-6b3991b94700
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:4da4e8a4-7659-231b-79d0-6b3991b94700
msgctxt "h2f51d009g8888g4777g990bg2da29e1c78d2"
msgid ""
"Turning your back on the needy to save your own skin? Maybe we'll get along "
"after all."
msgstr "남의 곤경 따윈 못 본 체하고 자기 앞가림만 치중하겠다? 아무래도 우린 서로 잘 맞겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 4f6d1e72-4777-c3c2-793f-605d27244a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:4f6d1e72-4777-c3c2-793f-605d27244a56
msgctxt "h32df1d6cg44cag4798g9bc8gb61f6a321fe9"
msgid ""
"Then you'll have better luck looting the goblins outside - this is a druids' "
"grove."
msgstr "그거라면 바깥의 고블린 시체 터는 편이 벌이가 나을 게야. 여긴 드루이드의 숲이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Narrator
#. NodeID = 51ef72f5-ebcd-aa1d-71f7-6bd68f53583b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:51ef72f5-ebcd-aa1d-71f7-6bd68f53583b
msgctxt "h7c41bb81g7aa6g4153g8feag5b61d1a9d42f"
msgid ""
"*'The Descent' - an infernal conspiracy that had seen the entire city of "
"Elturel briefly dragged to the Hells.*"
msgstr "* '하강' - 지옥의 음모로 엘투렐 도시 전체가 한순간에 지옥으로 끌려 가게 된 사건이었죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 53780acc-523b-9592-8b97-38b7c3d83651
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#.   Global:
#.     - DEN_TieflingLeader_Event_PostConfrontationDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:53780acc-523b-9592-8b97-38b7c3d83651
msgctxt "h65d7fcc8g805cg4c87g80d8gcd8826525590"
msgid ""
"Forgive that display. Aradin's a blowhard, but that's no cause for me to "
"join him."
msgstr "방금 일은 미안하네. 아라딘이 거슬리게 굴긴 해도, 나까지 어울릴 이유는 없었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 55ae9a59-7e1d-6c9a-1da6-817e175098f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b9b70f98-c95a-b05c-4594-e5a28a4b80ed_DEN_TieflingLeader_DenIntro_MentionedDebt = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:55ae9a59-7e1d-6c9a-1da6-817e175098f2
msgctxt "hda56c77ag9bd3g430dgacb1g926059e58828"
msgid ""
"We'd owe you a great debt. If we're forced to leave now, we won't make it to "
"the city."
msgstr "자네에게 큰 빚을 지는군. 만약 이대로 쫓겨나면, 우린 살아서 도시까지 갈 수 없을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 5c91ba66-81fa-d55e-1da6-b5c2d7470a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:5c91ba66-81fa-d55e-1da6-b5c2d7470a68
msgctxt "h67b392b3ge492g4ecbgb0f2g9946c168299f"
msgid "What are you offering for my aid?"
msgstr "도와주는 대가로 뭘 줄 생각이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 5ed274df-1947-3a27-7002-366dca4dd91f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:5ed274df-1947-3a27-7002-366dca4dd91f
msgctxt "hd5233665ge5d5g4eccgb44eg64c94b693bdd"
msgid ""
"So I hoped. But we've lost so many already - and more will die if we're "
"forced out again."
msgstr "그러길 바랐지. 허나 우린 너무나 많은 이를 잃었어. 여기서 쫓겨나면 더 많이 죽어 나갈 거고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 62748b01-7375-053f-1182-22688d9182b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:62748b01-7375-053f-1182-22688d9182b5
msgctxt "hbb820982g5d1dg4b55gb18cg2dd6386dd629"
msgid ""
"I meant no insult. It's simply that yours are a people at war with "
"themselves - I've never known them to care for outsiders."
msgstr "모욕할 의도는 없었네. 그저 자네 종족은 한창 내전 중인 상황이잖나. 외부 일에 베풀 신경이 있단 얘긴 못 들어봤거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 64df09f2-edf8-349e-afd1-2f18da514db7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = False
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#.   Global:
#.     - DEN_TieflingLeader_Event_PostConfrontationDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:64df09f2-edf8-349e-afd1-2f18da514db7
msgctxt "h6c3ac707g12aag422dg8f0dg7e808068c852"
msgid "Now <i>that's</i> settled."
msgstr "<i>직성</i>이 다 풀리는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 6bd31cd9-dd7d-ef97-0245-be2a7f80261a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:6bd31cd9-dd7d-ef97-0245-be2a7f80261a
msgctxt "hb5ece63fgb0ebg4d17g846fgf4c6fba66f7d"
msgid ""
"You, though... I know it's not your business, but she owes you for saving "
"this place."
msgstr "허나 자네라면... 자네랑 상관 없는 일이라지만, 자네가 여길 구해서 그 여자가 빚을 진 셈이잖나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 6cd70ca6-8f28-546e-78f7-20b44775f4e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.MetZevlor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:6cd70ca6-8f28-546e-78f7-20b44775f4e7
msgctxt "h8a549adbg7afbg44b4gb402g1b3ad1d93227"
msgid ""
"Perhaps you could persuade her. For more time to prepare, if nothing else."
msgstr "자네라면 설득이 가능할지도 몰라. 하다못해 채비할 시간이라도 벌 수 있을 게야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 6dee7390-71d3-a889-0280-74c9246ebe0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:6dee7390-71d3-a889-0280-74c9246ebe0b
msgctxt "h3f19b8eegf8c2g4b60gb0b9ged562229cb79"
msgid ""
"Lucky for you, you seem to have spooked that adventurer trash into leaving."
msgstr "그나마 자네 때문에 그 쓰레기 모험가 놈들이 내뺀 모양이니 이번은 봐주겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 6f993919-e28a-6136-740b-2590cc5ab68a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:6f993919-e28a-6136-740b-2590cc5ab68a
msgctxt "h1a58b588ga301g4c19g93bcg60637c81ef04"
msgid ""
"What I <i>didn't</i> expect was help out there from a drow. Thank you - I'm "
"Zevlor."
msgstr "드로우에게 도움을 받을 줄도 예상치 못했지만 말이야. 고맙네. 난 제블로어일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 70b614d7-2634-737f-8f3e-30e8820b0c68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:70b614d7-2634-737f-8f3e-30e8820b0c68
msgctxt "hbfee3241gb374g492ag89ebg3e2d6191f27f"
msgid "Perhaps if you could help me find a healer."
msgstr "치유사를 찾는 걸 도와준다면 생각해보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 70b614d7-2634-737f-8f3e-30e8820b0c68
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:70b614d7-2634-737f-8f3e-30e8820b0c68
msgctxt "hf73e47e7g6489g4415gb43bga59f335ab2f2"
msgid "I have my own temporal concerns. I need a healer."
msgstr "난 당장 더 급한 일이 있어서 말이야. 치유사가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 78e62950-833f-b246-0168-3134dcc15635
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:78e62950-833f-b246-0168-3134dcc15635
msgctxt "hf29fc92bgb7dcg456bg90fcg99d940256730"
msgid "My head's a wreck. I've got too much else to deal with right now."
msgstr "지금 내 머리가 맛이 갔어서 말이야. 당장은 딴 데 신경 쓸 여력이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 78e62950-833f-b246-0168-3134dcc15635
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:78e62950-833f-b246-0168-3134dcc15635
msgctxt "hca9ba578g8065g422dg8b92ge3349bda5a14"
msgid "I'm sorry. I've got my own problems."
msgstr "미안한데 난 따로 해야 할 일이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 7a00dec9-589f-926a-214e-df1dfcff897d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:7a00dec9-589f-926a-214e-df1dfcff897d
msgctxt "h16dadc22g6eeeg460dga480g0a12aad85b1c"
msgid ""
"Goblin got you? The druid Halsin's a renowned healer, but he didn't make it "
"back from Aradin's <i>expedition</i>."
msgstr "고블린한테 당했나? 드루이드 할신이 치유사로 명망 높긴 한데, 아라딘 놈의 <i>원정</i>에 따라나갔다 못 돌아왔다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 7e5f2aab-6910-2e25-a556-0377077459b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:7e5f2aab-6910-2e25-a556-0377077459b0
msgctxt "h6a34ac09g23e8g455dgbde8g94544fd2bff8"
msgid "Thank you for your help out there. I'm Zevlor."
msgstr "관문에서 도와줘서 고맙네. 난 제블로어일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 7e935d64-38ee-3a0d-b8ae-b5ce7d3b9455
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:7e935d64-38ee-3a0d-b8ae-b5ce7d3b9455
msgctxt "hcd15897fg0039g48d5g8d4cg8421dfffd78c"
msgid ""
"It seems you're of a mind with our hosts here. But their ritual will force "
"<i>you</i> out, too."
msgstr "어째 생각하는 게 이 숲 주인들과 똑같군. 하지만 저들의 의식은 <i>자네</i>도 내쫓고 말 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 7ef5af1a-ab56-688b-34b8-d5b76330f02f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:7ef5af1a-ab56-688b-34b8-d5b76330f02f
msgctxt "ha8a7d779g4ac7g4dbegb785g25be7a624aa2"
msgid "What is this place?"
msgstr "여기는 어디지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 824841b3-05e6-5b2c-843f-e44cc7b59bbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:824841b3-05e6-5b2c-843f-e44cc7b59bbe
msgctxt "hb1425151gfd2bg42d4gbfa0gbcdc9aa452d7"
msgid ""
"How easily such a nasty word slips through the mouth of someone you thought "
"you knew."
msgstr "지인이라고 여겼던 이들의 입에서 어찌나 그런 모욕적인 말이 쉽게 나오던지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 840c530b-bc73-1b2f-c211-f7b0e5ae140d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:840c530b-bc73-1b2f-c211-f7b0e5ae140d
msgctxt "h214cdb27g4a23g4208g8ddagdfed6344d172"
msgid ""
"Afterwards, people looked at us and just saw 'devilkin'. No different from "
"the druids here, really."
msgstr "그 사건의 여파로, 세간은 우릴 '데빌족'으로 그저 취급한다네. 여기 드루이드들도 딱히 다르지 않더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 85f944eb-0af3-e43c-a37d-19c8c391cb75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tieflings_Knows_DescentIntoAvernus = False
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:85f944eb-0af3-e43c-a37d-19c8c391cb75
msgctxt "h66d3b199gd94eg4dd8g93d1g2b8590a7d283"
msgid "'The Descent'? What is that?"
msgstr "'하강'? 그게 뭔데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 86225ec1-f25e-a385-1f8e-09e27b3afd68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:86225ec1-f25e-a385-1f8e-09e27b3afd68
msgctxt "h7eaf08c9g5cbeg4a7fga0a4g5927f4ba7db8"
msgid ""
"You'll find the druids at the heart of the grove. Please - make them see "
"sense, before more lives are lost."
msgstr "숲의 중심부에서 드루이드들을 찾을 수 있을 게야. 제발, 그들을 진정시켜주게나. 더 많은 목숨을 잃기 전에 말이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 8b2b10d0-bfc3-13bf-f039-9a1a9b0ac71f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutTiefling = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:8b2b10d0-bfc3-13bf-f039-9a1a9b0ac71f
msgctxt "hadf40b5fg68d5g4c6fgb06bg3267408eed42"
msgid ""
"This place is in enough turmoil. It will be smart for both of us to make "
"allies of enemies."
msgstr "여긴 안 그래도 뒤숭숭한 판이야. 적보단 아군으로 지내는 편이 우리 모두에게 현명하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 8c63b352-961d-1c7d-c363-6eec462e1144
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:8c63b352-961d-1c7d-c363-6eec462e1144
msgctxt "h03a2fcd0g5b1cg4932gbff7g6845039d396e"
msgid "I was there, you know. I'd hoped you'd had a happy ending."
msgstr "나도 그때 그 자리에 있었어. 당신들의 앞날이 부디 괜찮길 바랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 8cc6692e-2212-b691-708b-6c7b5f69d77b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:8cc6692e-2212-b691-708b-6c7b5f69d77b
msgctxt "h82c64b5egf6eeg4cbbg98e5g5737043ce58b"
msgid ""
"Hah - a fair point. We can only hope the citizens of Baldur's Gate are more "
"open-minded."
msgstr "하, 좋은 지적이군. 부디 발더스 게이트 시민들은 편견이 덜한 이들이길 바랄 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = 8e8a3baf-04dd-279f-4bf1-d4e944e197e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:8e8a3baf-04dd-279f-4bf1-d4e944e197e9
msgctxt "h234e1435gc28ag4881g8c27gc22550f0ce95"
msgid "You had that coming."
msgstr "댁이 자초한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 90aaa586-6d59-4930-ee74-233f3bdf12aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:90aaa586-6d59-4930-ee74-233f3bdf12aa
msgctxt "h53acbc35gd1e3g4702g86f3g3d8178743f64"
msgid "Lucky you."
msgstr "거 다행이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 985065b4-e32c-cc9c-1657-df5537c2d034
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:985065b4-e32c-cc9c-1657-df5537c2d034
msgctxt "h066bf558ge6abg4a4eg9321g4c16195a5b8c"
msgid "If you'll excuse me - I'd best get my people moving."
msgstr "이만 실례하지. 내 사람들에게 떠날 채비를 시켜야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 99ea2134-1846-d7cd-22e3-f68568b0172f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:99ea2134-1846-d7cd-22e3-f68568b0172f
msgctxt "hb7c669f0g2b68g48feg8e34gafed87ba2322"
msgid ""
"Oh, and if it's of any concern... you're brave to walk around without hiding "
"your heritage. I'll make sure everyone knows that you helped us at the gate."
msgstr ""
"아, 그리고 괜한 참견이 아니라면... 자네 출신성분을 그리 드러내고 다니는 건 대담한 행위야. 오해가 없도록 자네가 관문에서 우리를 "
"도왔다고 모두에게 일러두겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = 9c5a7a90-6768-cd62-a801-5bb1bc1d8bee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:9c5a7a90-6768-cd62-a801-5bb1bc1d8bee
msgctxt "hb05c1f18g1fe4g44e8g8fbcgd14aa53b3042"
msgid ""
"Lucky for us, a group of adventurers found a way to bring the city back."
msgstr "다행히도 어느 모험가 무리가 도시를 다시 지상으로 올릴 방법을 찾아줬지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Wyll
#. NodeID = 9c7ede6d-5e81-5a03-394b-5cc2c92dd959
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:9c7ede6d-5e81-5a03-394b-5cc2c92dd959
msgctxt "ha1fde936g4536g4451gae7egee84a2e629e7"
msgid "Kagha's a piece of work. Let's see if your wit surpasses your might."
msgstr "카그하는 보통내기가 아니지. 힘보단 재치로 상대해야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = a47c0ce9-5420-acaa-79b1-c26af3986243
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:a47c0ce9-5420-acaa-79b1-c26af3986243
msgctxt "he59759c2gd826g486bga3adg29d421d1aba9"
msgid "I want to try and help. I'll do what I can."
msgstr "나도 끼어 거들고 싶군. 할 수 있는 건 해 볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = a47c0ce9-5420-acaa-79b1-c26af3986243
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:a47c0ce9-5420-acaa-79b1-c26af3986243
msgctxt "h42bfc64dg067ag4288ga0c0g6edac5295949"
msgid "I'll see what I can do."
msgstr "한번 나서보도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = a67ff840-0ce1-543d-2b18-ccc8a2fffc75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:a67ff840-0ce1-543d-2b18-ccc8a2fffc75
msgctxt "hc82c4189ge1c2g4b92g89begba698d165c3d"
msgid "You had that coming."
msgstr "댁이 자초한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = a781d890-cb0a-d1fd-b9ea-7661d38ebf49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:a781d890-cb0a-d1fd-b9ea-7661d38ebf49
msgctxt "hc8c2c5c4g55b3g4b21gbdc4gcbfae62f8504"
msgid "Thank you again for your help out there."
msgstr "우릴 도와준 것, 거듭 감사하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = a9ace75f-bf6f-e4e9-97ac-5c203a65e487
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:a9ace75f-bf6f-e4e9-97ac-5c203a65e487
msgctxt "h80347339g081bg4f63ga014gd7e93375e5fd"
msgid "I've tried. Kagha - their new First Druid - won't even see me."
msgstr "노력은 해봤지. 새 최고 드루이드인 카그하가 날 만나주지도 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = aa87d229-5f7d-133c-ff75-a3b679b45dff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:aa87d229-5f7d-133c-ff75-a3b679b45dff
msgctxt "hdefc3892gdf10g40f1g8971gfbb5868b41e9"
msgid "Enough about the ritual. I have my own problems."
msgstr "의식 얘기는 그만하지. 난 나대로 신경 쓸 문제가 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = aaf6ba7d-9470-88c1-8c98-7b7b3cbe84d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurerLeader_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#.   Global:
#.     - DEN_TieflingLeader_Event_PostConfrontationDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:aaf6ba7d-9470-88c1-8c98-7b7b3cbe84d5
msgctxt "h87de96f7g78afg4148g9a98g90fffeb4a618"
msgid ""
"Aradin didn't make it? Pity - but he might've got more of my people killed, "
"if not for you."
msgstr "아라딘은 살아남지 못했나? 안됐군. 하지만 자네가 없었다면 그놈 탓에 우리까지 더 죽어나갔겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = ab656137-95e6-6f6d-a369-2473532bdd75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:ab656137-95e6-6f6d-a369-2473532bdd75
msgctxt "h64552e04g2aaeg467bg9536gfcffdde6f946"
msgid ""
"And so will you, if you ever lay hands on me again. <i>That </i>I promise "
"you."
msgstr "또 날 건드리면, 자네 역시 화를 자초할 거다. <i>그것만은</i> 내 장담하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = ae288f0d-d9e3-a37b-72f3-0a0f73129632
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:ae288f0d-d9e3-a37b-72f3-0a0f73129632
msgctxt "hcd293878g5e1fg4a94g9ee7g9ed5c2219bc8"
msgid "Just keep your fists to yourself, yes?"
msgstr "그냥 주먹만 함부로 쓰지 말게나. 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = ae7face7-5c74-e372-b64b-fb33452062c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:ae7face7-5c74-e372-b64b-fb33452062c4
msgctxt "hc4666288gbd76g4effga765gfd794b049360"
msgid "You were heading for bloodshed. I avoided that."
msgstr "더 심한 꼴이 터질 상황이었어. 난 그걸 막은 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = afab7d46-bd78-81d3-fd7a-7acc3b50f96d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:afab7d46-bd78-81d3-fd7a-7acc3b50f96d
msgctxt "h1d5d35e8g4c33g4b3bg8044g51d9561f837f"
msgid "I'll survive a sore jaw. Particularly if it's rid the grove of Aradin."
msgstr "턱 아픈 것 빼곤 괜찮네. 특히 아라딘 놈을 치우게 됐으니 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Wyll
#. NodeID = b3d33101-f316-35c3-352e-8100038b03fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:b3d33101-f316-35c3-352e-8100038b03fc
msgctxt "h7f403eb2gebb7g4dfdgaa85gbfdff5157c45"
msgid "These poor souls seek a champion - and you turn your back?"
msgstr "이 불쌍한 사람들이 용사를 찾는데, 그냥 못 본 체하겠단 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = b65fa961-08b2-a007-9eec-8e2265f80d59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:b65fa961-08b2-a007-9eec-8e2265f80d59
msgctxt "h1c52937fgfab4g437agb4d0gf9b43394c829"
msgid "I take my thanks in coin."
msgstr "감사 인사는 돈으로 받고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = b688ab13-5ea5-2a60-e99e-47541f62f711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:b688ab13-5ea5-2a60-e99e-47541f62f711
msgctxt "h5f353193g4739g4234g92d1gf438decd9758"
msgid ""
"Well met, by whatever name. Though I'm afraid that's all the welcome we can "
"give you."
msgstr "반갑네, 이름이 어떻든 말이지. 다만 미안하게도 환영 인사 이상의 대접은 해줄 수가 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = b6fdeb33-febc-e5f0-a540-3600df5c7351
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurerLeader_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:b6fdeb33-febc-e5f0-a540-3600df5c7351
msgctxt "heaff6c23g3680g4dedgaa7eg68f36ea6bf42"
msgid ""
"You're wounded? The druid Halsin's a renowned healer, but he went with those "
"adventurers. It seems they left him behind."
msgstr "부상을 당했나? 드루이드 할신이 치유사로 명망 높긴 한데, 모험가 놈들을 따라나갔다 못 돌아왔네. 버리고 온 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Karlach
#. NodeID = b7438019-9fcb-bfff-2c80-5d3172541369
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:b7438019-9fcb-bfff-2c80-5d3172541369
msgctxt "hc1c5e09bgc34eg43bag98a2g200d1ca51e8c"
msgid "Excuse you."
msgstr "말조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Karlach
#. NodeID = b86950a7-5280-75e3-e327-b6495329bc18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:b86950a7-5280-75e3-e327-b6495329bc18
msgctxt "hffa049e0gd7bcg4e5bg9e70g922c66bacca6"
msgid "We can't abandon all these people. Right?"
msgstr "이 사람들을 싹 저버릴 순 없는 노릇이잖아. 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Shadowheart
#. NodeID = bad387de-e2b0-244c-ed5a-35ddc86d04c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:bad387de-e2b0-244c-ed5a-35ddc86d04c8
msgctxt "hb95897cagce14g446eg8496ga032b796c3bb"
msgid "You chose well. We have enough burdens as it is without taking on more."
msgstr "잘 생각했어. 우린 지금 남의 사정까지 신경 써줄 정도로 여유 넘치지 않잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Karlach
#. NodeID = bb591615-fa94-f9f6-653a-9f9eb7d4cc38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:bb591615-fa94-f9f6-653a-9f9eb7d4cc38
msgctxt "h09e8b204g5df9g4b0fgbb12gcfb7ba624f9e"
msgid ""
"Gods, these are <i>those </i>tiefs? Their whole city was dragged into "
"Avernus for a while. Zariel was <i>delighted. </i>When they made it back "
"out, I'd hoped they got their happy ending."
msgstr ""
"세상에, 그때 <i>그</i> 티플링들이라고? 도시 전체가 아베르누스로 끌려 내려와 한동안 있었지. 자리엘이 아주 <i>좋아라</i> "
"했어. 그 사람들이 탈출했을 때 부디 괜찮길 바랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Lae'zel
#. NodeID = bd64823a-4bf5-43d9-4a67-76a7af6dd255
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:bd64823a-4bf5-43d9-4a67-76a7af6dd255
msgctxt "hb8e6bfdeg7157g4b1agabc4g522a7b59ed25"
msgid "Bah. We've no time to offer aid to every whimpering pup."
msgstr "하. 애처롭게 구는 것들 일일이 도와줄 시간 따윈 없단 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = c13154df-7901-fca7-887b-f0e2482baac4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#.   Global:
#.     - DEN_TieflingLeader_Event_PostConfrontationDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:c13154df-7901-fca7-887b-f0e2482baac4
msgctxt "h99eba437gca5ag41e1gabe8ga77670f7915a"
msgid "You acted quickly. I'm just sorry I didn't get there first."
msgstr "행동이 재빠르더군. 내가 먼저 갈기지 못해 아쉬울 따름이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Gale
#. NodeID = c13e5d62-08cb-d000-81b1-55efabba9e55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:c13e5d62-08cb-d000-81b1-55efabba9e55
msgctxt "h88042dbbg22bag4b9cgbda5gff907d53797c"
msgid "I think you should, yes. No harm in trying the diplomatic route."
msgstr "나도 동의하는 바야. 외교적 방안은 시도해봐도 나쁠 게 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = cc4233d3-208b-cf51-0204-10fff56ee567
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:cc4233d3-208b-cf51-0204-10fff56ee567
msgctxt "hddf35137g1504g4d4egb669g31f807ad4c12"
msgid "Are you all right?"
msgstr "괜찮은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = ce05260a-abe1-50a5-ca22-2445fe755c81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:ce05260a-abe1-50a5-ca22-2445fe755c81
msgctxt "h28b33410g252cg4189g9507g62e11fc49ea0"
msgid "Better that than further bloodshed."
msgstr "더 심한 사태는 피했으니 다행이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = ce3bd39c-019c-ece7-3fc1-c2a4731caf50
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_TieflingLeader_Event_GaveName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:ce3bd39c-019c-ece7-3fc1-c2a4731caf50
msgctxt "h8a1e6094gfb11g4aa6gaa7bgacab558ec66c"
msgid "Please - it's just Wyll."
msgstr "그냥 편하게 윌이라고 불러줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = cffa74f6-b813-a557-1829-a8addccfe306
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:cffa74f6-b813-a557-1829-a8addccfe306
msgctxt "hff1d7b6ag12a3g4d03gadc9g66ac7bc7d733"
msgid ""
"We were bound for Baldur's Gate, and it was too late to turn back. Elturel "
"had no place for tieflings after the Descent."
msgstr "행선지는 발더스 게이트였고, 인제 와서 되돌아갈 순 없는 처지야. 하강 사건 이후로 티플링은 엘투렐에서 살 수 없게 됐으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = d06a7871-e6c8-0dde-6e50-6f46b7f451a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_TieflingLeader_Knows_Elturel = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d06a7871-e6c8-0dde-6e50-6f46b7f451a7
msgctxt "h201987d5ga442g4d59g93a2gf8b926078108"
msgid "What brought you here?"
msgstr "어쩌다 이곳까지 온 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = d174fbbf-3467-8c59-5572-ebfd8310d9c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d174fbbf-3467-8c59-5572-ebfd8310d9c5
msgctxt "h25710e93g77dag461bga007gb46265c3987b"
msgid "True to form, and good riddance. This grove has troubles enough."
msgstr "그럴 줄 알았고, 오히려 잘된 거야. 이 숲은 골칫거리가 차고 넘쳐나거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = d18edb7a-a887-d3cb-42fb-11a9eeafdd3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d18edb7a-a887-d3cb-42fb-11a9eeafdd3d
msgctxt "he682157agf9bcg46cbg8733g89d19efdb2cd"
msgid "This ritual - is there no way to convince the druids to stop it?"
msgstr "그 의식 말인데, 드루이드들을 설득해 멈출 가망은 없는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = d313e4f1-e38b-b696-0d21-77c4e557ec2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d313e4f1-e38b-b696-0d21-77c4e557ec2e
msgctxt "hb5410355ga5a2g429dga3e6gdcea2ed3a8ed"
msgid "I have no quarrel with druids."
msgstr "난 드루이드들이랑 척질 일이 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = d347f47f-e5f4-a4b2-121e-ed71e5ee46b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d347f47f-e5f4-a4b2-121e-ed71e5ee46b2
msgctxt "h97ae073dg1e78g41f5gae73g05c73f1276a1"
msgid "Maybe your people should have stayed in Hell."
msgstr "당신네는 그냥 지옥에 남는 편이 나았을 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = d4448d20-8257-caa9-24f3-db584b386693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d4448d20-8257-caa9-24f3-db584b386693
msgctxt "h98723c8dgcca4g40f7gaa4cgbdd526ae0de4"
msgid "They've withdrawn there to prepare this damn ritual of theirs."
msgstr "그자들은 그 망할 의식을 준비하려고 거기로 물러난 상태라네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = d579b6fb-d9cc-2957-82f9-c91ccc917c1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d579b6fb-d9cc-2957-82f9-c91ccc917c1c
msgctxt "h5fd2d342g0bbdg48e8g98ccg4d4a6d9c4b9f"
msgid ""
"We'll live to tell another tale, if we can just convince these druids not to "
"turn us out on our backsides."
msgstr "우릴 내몰려는 저 드루이드들의 생각을 바꿀 수만 있다면, 계속해서 살아남을 수 있을 텐데 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = d5d2e6e7-f178-8a02-a3a4-17ba3f3455f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d5d2e6e7-f178-8a02-a3a4-17ba3f3455f9
msgctxt "h8e5b3c0ega970g41a3gb9a3ge2686a980e59"
msgid ""
"Well met. I should warn you - visitors are no longer welcome in this grove."
msgstr "반갑네. 미리 말해두겠는데, 이 숲은 이제 방문자를 반기지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Lae'zel
#. NodeID = d6c43e50-296d-a620-968c-a2062689b1a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d6c43e50-296d-a620-968c-a2062689b1a4
msgctxt "h32458cfagb699g4f32g894dg34527330885c"
msgid "A rational choice. We mustn't stray from our path."
msgstr "현명한 판단이다. 딴 데 한눈파는 일 따윈 안 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = d92e65ed-b342-f859-e60c-1467d16d60e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_ReassuredDrow(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_ReassuredDrow(1) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d92e65ed-b342-f859-e60c-1467d16d60e8
msgctxt "hb54001e9g6cf1g4a27g8358g5c37f5489020"
msgid ""
"You'll find the druids at the heart of the grove. Please - make them see "
"sense."
msgstr "숲의 중심부에서 드루이드들을 찾을 수 있을 게야. 제발, 그들을 진정시켜주게나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = d99ad656-8971-57cf-0565-801ff85c3424
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:d99ad656-8971-57cf-0565-801ff85c3424
msgctxt "he2af0291gde0cg42f0gbd55gd9d6686f8e66"
msgid ""
"I'd ask who you are, but I've heard of the Blade of Frontiers. I'd heard he "
"was a hero, though - not a thug."
msgstr "원래라면 누군지 물었겠지만, 변경의 칼날에 관해선 익히 들어봤지. 다만 영웅이라고 들었지, 깡패란 얘긴 못 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = dbbfba38-793f-7550-7a53-b385e06ac945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:dbbfba38-793f-7550-7a53-b385e06ac945
msgctxt "hc0f7e4cega180g4c0bgbb4bg8aa0c49e95b7"
msgid ""
"We can't stay, but we'll be slaughtered if we leave - we're no fighters."
msgstr "이젠 머물 수 없다지만, 이대로 여길 뜨면 도륙날 판이야. 우린 전사가 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = dc955dfc-4947-8806-893f-83d949d2c4d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:dc955dfc-4947-8806-893f-83d949d2c4d6
msgctxt "h2113aa0eg81e9g4b86g87b7g3df3f3051c70"
msgid ""
"A druids' grove, dedicated to the Oak Father, Silvanus. You'll find its "
"keepers just as thorny, I fear."
msgstr "드루이드의 숲이네. 참나무 아버지, 실바누스의 성소지. 곧 알 테지만, 여기 수호자들이 영 살갑잖게 굴 게야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = dcca6cbf-42c5-8b0d-39ed-12a9bc84d293
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:dcca6cbf-42c5-8b0d-39ed-12a9bc84d293
msgctxt "h81e3e125gddd4g4754g86c4g3ecf4b89647e"
msgid ""
"Lay hands on me again, however, and every tiefling in this encampment will "
"fall on you like a tide."
msgstr "하지만 만약 또 날 건드리면, 이 숙영지 내의 모든 티플링이 파도처럼 덮쳐들 거란 걸 염두에 두게나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = e34b15af-b283-1d84-aabb-439f4f3c9076
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:e34b15af-b283-1d84-aabb-439f4f3c9076
msgctxt "hadbaee0ag06fbg4706ga162gdd8c59f7072c"
msgid "And if I'm not mistaken, <i>you're </i>the Blade of Frontiers."
msgstr "내가 잘못 본 게 아니라면, <i>자네는</i> 바로 그 변경의 칼날 아닌가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = e57ff460-65fb-92a7-614a-6b0aa17d93c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:e57ff460-65fb-92a7-614a-6b0aa17d93c2
msgctxt "hb6021aa7g8178g48c3g8bafge1bf82e2072f"
msgid "I'm surprised you haven't heard of it."
msgstr "그 사건을 여태 몰랐다니 놀랍군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Astarion
#. NodeID = e819be97-4a49-49e2-f4d0-87ed6d60479f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:e819be97-4a49-49e2-f4d0-87ed6d60479f
msgctxt "h360a0d22g6373g430aga321gde717ee92411"
msgid "Really? We're messengers, now?"
msgstr "진심이야? 이젠 심부름꾼 짓까지 하자고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = e9493941-b903-3215-5dfc-f0f7115bb7b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:e9493941-b903-3215-5dfc-f0f7115bb7b0
msgctxt "hce5cde4agdf64g424cgba95gb6a0b2ed4b0a"
msgid ""
"The High Overseer - <i>our grand protector</i> - signed a pact with devils. "
"It dragged Elturel straight to Hell."
msgstr "고위 감독관, 바로 <i>우리 대 수호자</i>가 데빌과 계약을 맺어버렸다네. 그로 인해 엘투렐이 지옥으로 떨어졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = e9d0cd23-d37c-5557-84a9-a01eeff8e77f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:e9d0cd23-d37c-5557-84a9-a01eeff8e77f
msgctxt "h98091f45g49dbg456dga6d4g37e109781e8b"
msgid "Do you have something against drow?"
msgstr "내가 드로우인 게 무슨 문제라도 돼?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Karlach
#. NodeID = ec6848b0-d04e-f44d-d027-174303813d38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:ec6848b0-d04e-f44d-d027-174303813d38
msgctxt "h4128d4fbgade4g4571ga657g95fc546e5725"
msgid "I knew I liked you."
msgstr "역시 넌 마음에 쏙 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = ecaab328-0297-622e-575a-922711d031b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutTiefling = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#.   Global:
#.     - DEN_TieflingLeader_Event_PostConfrontationDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:ecaab328-0297-622e-575a-922711d031b2
msgctxt "hc685d6cag5c6ag403dg95cdgdc4fe2e9724a"
msgid "Ngh. <i>Mragreshem.</i>"
msgstr "으으. <i>므라그레셤.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = f0c179fb-8fdf-7f25-0f73-6fcb97464613
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:f0c179fb-8fdf-7f25-0f73-6fcb97464613
msgctxt "hb569c950gce04g4540gb003gb4f294d1e156"
msgid "Are you all right?"
msgstr "괜찮은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = f22f107d-9b8b-867c-4ccb-46cb01987b75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:f22f107d-9b8b-867c-4ccb-46cb01987b75
msgctxt "he4bd4a3cge33cg4410g9540g2e81a3c259b0"
msgid ""
"We got out alive. That's what matters. And you did too, by the looks of "
"things."
msgstr "살아서 거길 벗어났으니, 그거면 됐지. 그건 자네도 마찬가지인 모양이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Gale
#. NodeID = f2b983e7-b762-5c2d-9f8c-9668002bdebc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:f2b983e7-b762-5c2d-9f8c-9668002bdebc
msgctxt "h756e1b3egb415g48c5gadacgb5f17355c01d"
msgid ""
"We've our problems, granted, but there might be some merit in shutting down "
"a local conflict, no?"
msgstr "딴은 그렇긴 하지만, 이 동네 분쟁을 해소해준다면 그것대로 얻는 게 생기지 않을까 싶은데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Player
#. NodeID = f392192a-42b9-6fa8-183c-39b8c138ba8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:f392192a-42b9-6fa8-183c-39b8c138ba8c
msgctxt "hd24f6a8bg81ceg4359ga672g25abbe5f3c43"
msgid "I won't be staying long - I just need to find a healer."
msgstr "오래 머무르진 않을 거야. 치유사를 찾으러 들른 것뿐이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = f4e9aa7e-f97d-f24b-6a1d-bb28ce038a03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:f4e9aa7e-f97d-f24b-6a1d-bb28ce038a03
msgctxt "h8675c263g5ae8g4b96gb94bgebe9d0fc39ea"
msgid "I understand. I can only thank you for the help you've already given."
msgstr "이해하네. 이미 도와준 것만으로도 감지덕지할 따름이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro
#. Speaker = Zevlor
#. NodeID = f713482b-1f21-6113-c6cd-4f883f51ce72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_DenIntro:f713482b-1f21-6113-c6cd-4f883f51ce72
msgctxt "h922533e8g34e2g46d5g885bg66d63e6e118f"
msgid ""
"We're refugees from Elturel - we took shelter here after gnolls attacked us "
"on the road."
msgstr "우린 엘투렐에서 온 난민일세. 길을 가던 중에 놀에게 공격받고 여기로 피신했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_HeadedToCave
#. Speaker = Zevlor
#. NodeID = 0258f4dc-f8b6-f39b-d733-c31065d6c0f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_HasMet_Introduction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_HeadedToCave:0258f4dc-f8b6-f39b-d733-c31065d6c0f7
msgctxt "h29ef4f2fg0f09g4631g8b04g4c8d7153cd21"
msgid "Find me in the caves. I need to let people know we're moving."
msgstr "용건이 있다면 동굴로 찾아오게. 우리 동족에게 이곳에서 벗어나자고 알려야 하니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_HeadedToCave
#. Speaker = Zevlor
#. NodeID = 205549e1-4812-aaba-deb2-11ec79bde896
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_HeadedToCave:205549e1-4812-aaba-deb2-11ec79bde896
msgctxt "h99515d6fg1f19g4607g9f6dge79dd535d26c"
msgid "Hm? Come introduce yourself in the caves. I need to get people moving."
msgstr "음? 동굴로 와서 인사나 나누세. 난 일행에게 떠날 채비를 하라고 해야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 547a6061-ed14-ac4c-76af-8eb2c00de316
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:547a6061-ed14-ac4c-76af-8eb2c00de316
msgctxt "h2d4c7ea5g38a8g4484gb906g308604b4062f"
msgid ""
"Those symbols show where gnolls and goblins were sighted. Plenty of trouble "
"along the way."
msgstr "저 그림은 고블린과 놀이 목격된 곳을 표시해 둔 것 같은데. 가는 길에 골칫거리가 많겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 547a6061-ed14-ac4c-76af-8eb2c00de316
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:547a6061-ed14-ac4c-76af-8eb2c00de316
msgctxt "hf8fb09c1g0653g45cega195gc5630afffd77"
msgid "Someone marked gnolls and goblins on the road, too. Oh boy."
msgstr "누가 놀이랑 고블린도 지도에 표시해 뒀네. 맙소사."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 547a6061-ed14-ac4c-76af-8eb2c00de316
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:547a6061-ed14-ac4c-76af-8eb2c00de316
#, fuzzy
msgctxt "h9b10e0d8g65adg44e1ga70ag72f2050e8b91"
msgid ""
"Goblins and gnolls are marked on here, too. In us, they'll meet their match."
msgstr "고블린과 놀도 표시되어 있어. 칼날에겐 상대도 되지 않지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 547a6061-ed14-ac4c-76af-8eb2c00de316
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:547a6061-ed14-ac4c-76af-8eb2c00de316
msgctxt "h16f8de77g6bf8g45baga85fgd99429ecab52"
msgid ""
"Goblins and gnolls are marked on here. A good opportunity for bloodshed."
msgstr "고블린과 놀도 표시되어 있군. 피를 흘릴 좋은 기회겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 547a6061-ed14-ac4c-76af-8eb2c00de316
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:547a6061-ed14-ac4c-76af-8eb2c00de316
msgctxt "ha438cacbg4dfbg47bdgab31g68cf910522fe"
msgid "These little markings look like goblins and gnolls - right in our path."
msgstr "이 작은 표시는 고블린과 놀인 것 같은데, 정확히 우리 경로에 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 547a6061-ed14-ac4c-76af-8eb2c00de316
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:547a6061-ed14-ac4c-76af-8eb2c00de316
msgctxt "h082c2179g02aeg49cbg8431gaa0959d27647"
msgid ""
"Goblin and gnoll markers on the map too. Looks like they're mostly... "
"everywhere."
msgstr "지도에 고블린과 놀도 표시되어 있어. 보아하니 대부분... 온갖 곳에 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 547a6061-ed14-ac4c-76af-8eb2c00de316
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:547a6061-ed14-ac4c-76af-8eb2c00de316
msgctxt "h704b2e94g21afg4357g93ecgd30d0ecb2734"
msgid "Gnolls and goblins marked on the map. Travel won't be easy."
msgstr "지도에 놀과 고블린들이 표시되어 있어. 쉬운 여정이 되진 않겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "h53bd3d5cgf5bag4d83gbff6g1ecc734d89c2"
msgid "We're in Elturgard? Baldur's Gate is bloody leagues away."
msgstr "엘투르가르드라고? 망할 발더스 게이트까지 한참 남았잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "h3c728775g26d9g4b47gb92agf3aa33529095"
msgid ""
"So we're in Elturgard. That means Baldur's Gate lies west - rather far west "
"even."
msgstr "이곳은 엘투르가르드였군. 그렇다는 건 발더스 게이트는 서쪽 방향이라는 거야, 서쪽으로 아주 멀리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "hdf3a513egdc10g4df0ga38cg2e812138cd1a"
msgid "Ah, all right, we're in Elturgard. Far enough from Baldur's Gate..."
msgstr "좋아, 여긴 엘투르가르드였군. 발더스 게이트와는 한참 떨어져 있지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "h5c185c0dga2b4g4bdcg8b43g1e8cad5e7f77"
msgid ""
"If this map is accurate, this is Elturgard. Baldur's Gate is some ways still."
msgstr "이 지도가 정확하다면, 여긴 엘투르가르드야. 아직 발더스 게이트까진 거리가 멀군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "he3e2f9b1gd48bg49f8g9d1bgbda65c1f744c"
msgid ""
"Elturgard? A lot of territory to cover before Baldur's Gate - and any cure "
"found there."
msgstr "엘투르가르드? 발더스 게이트까지 긴 여정이 남았군, 그동안 치유할 방법을 찾을 기회도 남았고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "h8ec09b27g3763g4200g89bcgeaaff6cf44b2"
msgid "Elturgard? Should've known. Still a good ways from Baldur's Gate."
msgstr "엘투르가르드라고? 진작 알았어야 했는데. 아직 발더스 게이트까진 거리가 멀군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: BALDURIAN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "h6069ba13g8d55g4687g9b0cgfa927702af66"
msgid "Elturgard. Further from Baldur's Gate than I'd hoped."
msgstr "엘투르가르드. 내 기대보다 발더스 게이트에서 먼 곳이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:68b92ee4-4c13-1b14-a5fc-5fa4d3b37bb7
msgctxt "h0288774cg25a7g40d6g93acg7f3817bf4a48"
msgid "Looks like we're in Elturgard. East of the city of Baldur's Gate."
msgstr "우린 엘투르가르드에 있는 것 같군. 발더스 게이트의 동쪽이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "h055df54egb19fg470dgb3a8g800857f2c7bd"
msgid "We're in Elturgard? Ugh. Baldur's Gate is still leagues away."
msgstr "우리가 엘투르가르드에 있었어? 윽. 발더스 게이트까진 아직 한참 남았네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "had22640dg744cg4074ga860g412d2cf8b9de"
msgid ""
"So we're in Elturgard. That means Baldur's Gate lies west - rather far west "
"even."
msgstr "이곳은 엘투르가르드였군. 그렇다는 건 발더스 게이트는 서쪽 방향이라는 거야, 서쪽으로 아주 멀리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "h35f9cbccg1f3dg45b6g9a9ag9066bd5d7a68"
msgid "Ah, all right, we're in Elturgard. Far enough from Baldur's Gate..."
msgstr "좋아, 여긴 엘투르가르드였군. 발더스 게이트와는 한참 떨어져 있지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "h60ba56a2g3a67g43aag8eecg78244bbb75cb"
msgid ""
"If this map is accurate, we are in Elturgard. Baldur's Gate is some ways "
"still."
msgstr "이 지도가 정확하다면, 우린 엘투르가르드에 있어. 발더스 게이트까지는 아직 길이 멀군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "h6a371444g2c49g4f5dgb09bgfe909318ce96"
msgid ""
"Elturgard? A lot of territory to cover before Baldur's Gate - and any cure "
"found there."
msgstr "엘투르가르드? 발더스 게이트까지 긴 여정이 남았군, 그동안 치유할 방법을 찾을 기회도 남았고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "h0f732dc6gc711g4768gb025g00efa072e9e8"
msgid "Elturgard? Should've known. We're a good ways from Baldur's Gate."
msgstr "엘투르가르드? 진작 알았어야 했는데. 발더스 게이트까지 긴 여정이 남았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: BALDURIAN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "h2f6f9e06g6926g43f7gae9ag8f1b6797b81f"
msgid "Elturgard. Further from Baldur's Gate than I'd hoped."
msgstr "엘투르가르드. 내 기대보다 발더스 게이트에서 먼 곳이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap
#. Speaker = Player
#. NodeID = 7aa5b908-0567-4ad1-4f11-d84dd709ecdd
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_PAD_ZevlorsMap:7aa5b908-0567-4ad1-4f11-d84dd709ecdd
msgctxt "hb4879b1eg1205g4134g8407g6b9a86ef2246"
msgid ""
"Looks like we're in Elturgard. Some distance from the city of Baldur's Gate."
msgstr "우린 엘투르가르드에 있는 것 같네. 발더스 게이트까지는 거리가 꽤 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 0160b5ca-104b-69b9-c9f6-fa488dafb420
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:0160b5ca-104b-69b9-c9f6-fa488dafb420
msgctxt "h5ba8fd08g5ee2g4abdg8572g489e19fc8268"
msgid "Casts a silencing spell on little monsters who back talk their parents."
msgstr "부모에게 말대꾸하는 우리 꼬마 괴물들에게 침묵 주문을 걸거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 02f8d519-7e9e-0b05-b961-99ed2494fe83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:02f8d519-7e9e-0b05-b961-99ed2494fe83
msgctxt "hd31f7010g10a5g409fgad42gd521314c95fa"
msgid "That lot could give the Thieves' Guild a run for their money. "
msgstr "도둑 길드에도 지지 않을 녀석들이야. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 0408b8ae-88ec-40f0-eb1b-913f9461f415
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:0408b8ae-88ec-40f0-eb1b-913f9461f415
msgctxt "hafa598a7ge78fg44a6g8356g54df323f7890"
msgid ""
"He built prettier things, but I always told him <i>this </i>was his best "
"work."
msgstr "더 예쁜 것도 만든 적 있지만, 난 <i>이게</i> 가장 멋진 작품이라고 늘 남편에게 말했었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 0461a78e-7048-3469-bb4d-53b1fe3a423d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:0461a78e-7048-3469-bb4d-53b1fe3a423d
msgctxt "h54637aeagddcdg4f8dga7ceg648c159c7d26"
msgid "You make all tieflings look bad. Have you no shame?"
msgstr "티플링 얼굴에 먹칠을 하는군. 부끄럽지도 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 05a91e7b-3a61-fdd9-da53-81fa9ae68ba6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:05a91e7b-3a61-fdd9-da53-81fa9ae68ba6
msgctxt "hd086b5dcg9d5bg4790gb2acg7f01c38cf6d0"
msgid ""
"You can't eat shame, kin. Better to learn that <i>before </i>your belly "
"starts growling."
msgstr "체면이 밥 먹여 준다니? 너도 <i>빨리</i> 뻔뻔하게 구는 법을 배워 두는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 0b11a7df-e395-3344-a5e0-08e433044858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:0b11a7df-e395-3344-a5e0-08e433044858
msgctxt "h0f8a0430g356ag418dga420gc2564bd47ded"
msgid "What are you doing?"
msgstr "뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 0f06283a-6df9-5e70-9e68-b114017a8a53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:0f06283a-6df9-5e70-9e68-b114017a8a53
msgctxt "hb5feb0ecg182fg4221gbbf1g3c9f46409125"
msgid "You're right. I know that. I just..."
msgstr "그 말이 맞아. 나도 알고. 근데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 100119cc-1a88-b43c-3659-dbe36beaad4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:100119cc-1a88-b43c-3659-dbe36beaad4d
msgctxt "h0a1aa0d7g8c33g42fcgb41ag3ae1b510f26f"
msgid ""
"That's worth a tip, I suppose - if you're looking for the <i>real </"
"i>swindlers here, keep an eye on the children. "
msgstr "대신에 조언 하나는 해 줄게. 여기선 아이들을 조심해. 걔들이 <i>진짜</i> 사기꾼이니까. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 13e6bf70-3e79-5eb8-d57b-9bdc853864d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:13e6bf70-3e79-5eb8-d57b-9bdc853864d0
msgctxt "h727574degc4b7g48ceg8685g50d1fd11e865"
msgid ""
"I used to hate this tune - told my husband as much when he made the bloody "
"thing."
msgstr "예전엔 나도 이 소리가 싫었어. 이 망할 것을 만들었을 때 남편에게 그렇게 자주 말했었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 17da10be-47ee-0a74-c356-a95a8dceac5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:17da10be-47ee-0a74-c356-a95a8dceac5b
msgctxt "h4a6196f5g5d48g47a7gb79ag6c3bcc668507"
msgid ""
"It's easy to forget that there are people like you in the world. Thank you "
"for reminding me."
msgstr "당신 같은 사람이 있다는 걸 잊고 살기 십상이지. 다시 떠올리게 해줘서 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 19084bca-9d26-110f-158e-bcc6fa78aa04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:19084bca-9d26-110f-158e-bcc6fa78aa04
msgctxt "h7feb05bag1f53g4532gae79g1d63a0c9b40d"
msgid ""
"Oh! Of course, how thoughtless. I beg your pardon - I'm not fan of it "
"myself, truth be told."
msgstr "아! 그럴게, 생각 없이 굴었네. 미안해 - 나도 듣기 싫긴 마찬가지야, 솔직히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 196d971b-0f1f-87cf-57fc-b5c78aee4a00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bd0401d4-e236-9a38-631b-f6b33c4bb1bb_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:196d971b-0f1f-87cf-57fc-b5c78aee4a00
msgctxt "hfe9d832fga288g44a9g9d65gaaa0d56d4537"
msgid "If you give me that box I won't expose you."
msgstr "그 상자를 넘기면 입 다물어 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 1aa800ce-3d51-33f0-d0da-88332ac1df08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:1aa800ce-3d51-33f0-d0da-88332ac1df08
msgctxt "h6a8528e2g1c17g4d5ag896cg7de99aab0314"
msgid "<i>Worthless? </i>How could you say -"
msgstr "<i>쓸모 없다니?</i> 어떻게 그런 말을 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 1ebea3af-6ea1-8489-20ce-68d38edc4c71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:1ebea3af-6ea1-8489-20ce-68d38edc4c71
msgctxt "h003cbf88g03ffg4543g80bage19d082c5656"
msgid "Why do you want to sell it?"
msgstr "그걸 왜 팔려고 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 20a8c37d-10e0-e402-135d-909bb63fca7d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:20a8c37d-10e0-e402-135d-909bb63fca7d
msgctxt "hc835dfb7ga86dg4d78ga510gcb27367337d9"
msgid "You're not conning anyone else. Hand it over."
msgstr "어디서 사기를 치려고. 이리 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Shadowheart
#. NodeID = 20fee60c-9869-0bf6-5bec-5beb9cf8ba57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:20fee60c-9869-0bf6-5bec-5beb9cf8ba57
msgctxt "h4b5c81e9g393fg476cgb271g0f42fef11016"
msgid "The next time you want to pay gold to be called a fool, come see me."
msgstr "이렇게 등신같이 주머니 털리고 싶거든 나한테 맡기지 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 23d976fd-124c-db20-c69e-1f2ec1c0d076
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:23d976fd-124c-db20-c69e-1f2ec1c0d076
msgctxt "h91fd91e1g7c66g4da9g8deage2f386f1072b"
msgid ""
"Well... I was hoping for more than that. My husband was carrying all our "
"coin."
msgstr "그래... 그보단 더 받고 싶었는데. 남편이 우리 돈을 다 갖고 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 2915fb54-3701-dfe3-5fe4-912e39e58583
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:2915fb54-3701-dfe3-5fe4-912e39e58583
msgctxt "h99aa2141g1726g48d1g97aeg8f877c9620ab"
msgid "What's say you take them elsewhere, hm?"
msgstr "그 밝은 눈깔을 이만 다른 데로 돌리는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 2a730e18-ec4d-784b-7c7b-b092e0257c87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:2a730e18-ec4d-784b-7c7b-b092e0257c87
msgctxt "hb679653fg71ffg4a89ga0d4gc82fe6689f9f"
msgid "You're no monster. I'm sorry you had to go through that."
msgstr "괴물이라니, 아냐. 그런 일을 겪었다니 유감이군"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 2b655691-214b-9596-ffe8-e69c2355839c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - bd0401d4-e236-9a38-631b-f6b33c4bb1bb_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:2b655691-214b-9596-ffe8-e69c2355839c
msgctxt "h15cf7a18g6114g45deg8ea6gfe58caef3252"
msgid "<i>Probe her thoughts. </i>"
msgstr "<i>생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 2b6d4cae-d2db-ca82-f61a-76c1c4cdca54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:2b6d4cae-d2db-ca82-f61a-76c1c4cdca54
msgctxt "hc3da8a8eg493bg43e4g8519gc0940d1c456e"
msgid "... I'll wait for the next idiot with <i>gold</i>, thanks."
msgstr "...고맙지만, <i>돈을</i> 줄 머저리를 찾아야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 2da230ee-870e-b9d2-3d27-c793c67b15ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:2da230ee-870e-b9d2-3d27-c793c67b15ea
msgctxt "h3ab87084g1ef7g4e1dgb907g21514c31ef64"
msgid ""
"That's worth a tip, I suppose - if you're looking for the <i>real </"
"i>swindlers, keep an eye on the children. "
msgstr "대신에 조언 하나는 해 줄게. 아이들을 조심해. 걔들이 <i>진짜</i> 사기꾼이니까. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 336173dd-6f41-ba0d-b374-6951f0ec70df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:336173dd-6f41-ba0d-b374-6951f0ec70df
msgctxt "h047ca61fgbca2g4c3ag8392g447ca0ff9a00"
msgid "Why <i>thank you</i>. Always nice to have to an appreciative audience."
msgstr "어머, <i>고마워라</i>. 안목 있는 관객은 언제나 환영이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 343ab6b9-b794-41cc-1524-fa59fccda7f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:343ab6b9-b794-41cc-1524-fa59fccda7f9
msgctxt "h2c48b4acga139g4d37g89d4g3c0082d8fe00"
msgid "That box is a cheap trinket - fit only to feed the forge."
msgstr "싸구려 허접쓰레기군. 풀무에 던지면 딱이겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 39dcb43d-b37b-2770-f898-701acb884ab9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:39dcb43d-b37b-2770-f898-701acb884ab9
msgctxt "hee2610a1gf8c2g42ebgab24g5aedaf1ed898"
msgid ""
"Same way <i>you</i> weren't going to stop and listen without a sob story."
msgstr "<i>너</i>도 똑같이 구슬픈 사연이 없었다면 내 말을 듣지도 않았을 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 39f95f6d-c239-7b92-579d-5128b1a20f6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:39f95f6d-c239-7b92-579d-5128b1a20f6c
msgctxt "he3413cb7gb9eag4ff6ga75fg8d89c5cb64c4"
msgid "Gods, <i>relax.</i>"
msgstr "젠장, <i>진정 좀 해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 40287f4c-2ced-2771-388b-2deb0b16b849
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_Event_TalkedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:40287f4c-2ced-2771-388b-2deb0b16b849
msgctxt "h804e2b27gb3b3g4c88g866dg2e09ac72f7c8"
msgid ""
"I'm sorry, I just... I don't know what else to <i>do</i>. They say you need "
"coin to enter the city. For bribes."
msgstr "미안해, 달리 <i>어떡해야</i> 할지 모르겠어. 도시로 들어가려면 뇌물로 돈을 줘야 한다고 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 42f8f975-b8eb-3743-db80-21b487ab7c6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:42f8f975-b8eb-3743-db80-21b487ab7c6a
msgctxt "hb54512fagf746g42dbg8c7cgddfcf00a5fe9"
msgid "<i>Gold?</i>  That was barely worth a copper."
msgstr "<i>금?</i> 구리도 아까울 것 같은 물건인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 430b3b7b-6bb3-63a4-d0ff-49439a4df961
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:430b3b7b-6bb3-63a4-d0ff-49439a4df961
msgctxt "hfa7b42f0gb598g480fg92c8g5d8f0af521eb"
msgid "<b>HAND IT OVER.</b>"
msgstr "<b>당장 내놔.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Narrator
#. NodeID = 4458c6c1-8325-3420-78e9-0e0de294083a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_Event_FoundOutLies(1) = True
#.   Global:
#.     - DEN_TieflingScam_Knows_Scam = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:4458c6c1-8325-3420-78e9-0e0de294083a
msgctxt "h07e3d8b3gf078g4a51gb0dfgbaa10a66ec21"
msgid ""
"*It's no masterpiece. Her gaze flicks between the box and you. You realise "
"she's lying.*"
msgstr "*걸작이라고 보긴 힘듭니다. 여자의 눈길이 상자와 당신 사이를 빠르게 오갑니다. 당신은 거짓말이라는 걸 알아챕니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 46603a56-ec9a-7cd0-89e4-e06fce73e0c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_Event_GaveMoney(1) = True
#.   Global:
#.     - DEN_TieflingScam_State_GotMoney = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:46603a56-ec9a-7cd0-89e4-e06fce73e0c2
msgctxt "h7234ea40g650bg467dgb423g14ee171a9b83"
msgid "Don't worry. You can keep the gold."
msgstr "걱정 마. 돈은 가져도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 4721a261-feb2-803d-09df-d845067a39cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:4721a261-feb2-803d-09df-d845067a39cd
msgctxt "hc61de53fg0538g4574g94d6gbad6e494fd17"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 487a3e82-80d7-01a6-7f69-6f464a427ef6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:487a3e82-80d7-01a6-7f69-6f464a427ef6
msgctxt "hcc70a3d0g839dg4169g8526g3a3bb3dcfd4a"
msgid "What makes this box his best?"
msgstr "뭐 때문에 그렇게 생각한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 4a0eb4de-b73c-1bfd-c124-0886eee2dfbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:4a0eb4de-b73c-1bfd-c124-0886eee2dfbb
msgctxt "hcf668d42ge293g4801g9cc4g5ae1267707b6"
msgid ""
"... how much do you think it's worth? Old Ethel said she'd offer me gold for "
"it."
msgstr "... 얼마 정도 할 거라고 봐? 늙은 에텔은 팔면 금을 주겠다고 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 4af8f554-a7b5-cd95-27ab-9bf622e2e12d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:4af8f554-a7b5-cd95-27ab-9bf622e2e12d
msgctxt "h34af43aagb3f9g40fbgbb11gb5acc7f6df03"
msgid "I'll just find another box and work another idiot. Like always. "
msgstr "새 상자를 찾아서 다른 호구를 물면 그만이니까. 식은 죽 먹기지. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Narrator
#. NodeID = 4cbf3d1c-4c25-1637-1224-6d08532598b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:4cbf3d1c-4c25-1637-1224-6d08532598b6
msgctxt "ha4ee28a6g3fe9g4e18g8538g91edb6d93a5e"
msgid ""
"*The wood is warped, its joints loose - likely done by assembly in some grim "
"workhouse. You realise she's lying.*"
msgstr "*목재는 뒤틀려 있고, 이음새는 느슨합니다 - 허술한 작업실에서 조립되었을 법하죠. 당신은 여자의 거짓말을 알아챕니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 4d1a287d-82af-bb23-735a-e5254e695ae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:4d1a287d-82af-bb23-735a-e5254e695ae7
msgctxt "hbfaee61agd7e3g476dg9132gca9407aa6b1d"
msgid "Hm. Noted. But if nuggets of wisdom are all you have to offer..."
msgstr "흠. 기억해 둘게. 근데 훈수만 둘 생각이라면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 5217e55f-e6c3-276d-6bed-f1c9e3bd1c28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:5217e55f-e6c3-276d-6bed-f1c9e3bd1c28
msgctxt "h755a9f81gfb61g4ae5gb32dg40514ee6f52d"
msgid ""
"I don't... where'd it <i>go?</i> Looks like someone swiped it before you. "
"All that fuss for nothing."
msgstr "잠깐... 어디 <i>갔지</i>? 누가 이미 털어 갔나 봐. 괜히 헛수고만 했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 52f5c8be-a33f-b9c7-b5de-f332f7e73199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:52f5c8be-a33f-b9c7-b5de-f332f7e73199
msgctxt "hc02ddf6fg8908g4e60g9e73g28cf800a5a1f"
msgid ""
"Gods, where is it? Someone's taken it! I'm sorry, I don't know how this "
"happened."
msgstr "신이시여, 어디로 간 거지? 누가 가져갔어! 미안해, 어쩌다 이렇게 됐나 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 544a9d79-1ea1-6d25-d654-47523ba47735
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:544a9d79-1ea1-6d25-d654-47523ba47735
msgctxt "h11fa14e1g5b02g45f0g813fgfcbda3d2180b"
msgid "What? How did you... no, it wasn't <i>all </i>a lie."
msgstr "뭐? 어떻게... 아냐, <i>전부</i> 거짓은 아니었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 550c4813-e799-2174-f72a-73ab9dca1c26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:550c4813-e799-2174-f72a-73ab9dca1c26
msgctxt "hd4bc73f5g95b4g4cf0ga2a5g3c6f29e3bbcd"
msgid ""
"We tried to travel light, but... when the gnolls found us, we couldn't... "
"they couldn't <i>run- </i>"
msgstr "짐을 가볍게 꾸리려고 했지만... 놀을 마주쳤을 때, 우린... 두 사람은 <i>뛸 수가</i> 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 55510f19-ff8f-4f7d-529c-8bae90988e8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:55510f19-ff8f-4f7d-529c-8bae90988e8a
msgctxt "h929325c6g9d9ag4742gb021g0c6552ba8016"
msgid "It's magic."
msgstr "여기 담긴 마법 때문이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 56b065ff-c6ce-0311-eb05-f75ed3aa2406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:56b065ff-c6ce-0311-eb05-f75ed3aa2406
msgctxt "heb42bb83g9091g4442ga403g0e58d2e1356c"
msgid ""
"All right, fine. This little swindle is meant for soft hearts, not keen eyes."
msgstr "아니다, 됐어. 마음 약한 녀석들이나 등쳐먹어야지. 넌 눈이 너무 밝네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 576b0a61-b574-87a4-2783-64f8fc9010c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:576b0a61-b574-87a4-2783-64f8fc9010c3
msgctxt "h41d18b08gd287g4563gae59g58eda61741e0"
msgid ""
"Though my little con pales in comparison to the children. Could give the "
"Thieves' Guild a run for their money that lot. "
msgstr "애들에 비하면 이건 아무것도 아니야. 걔들은 아마 도둑 길드에서도 알아 모실걸. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 591c65fe-ca10-d109-cb54-37e48c674fa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:591c65fe-ca10-d109-cb54-37e48c674fa1
msgctxt "h1959f1ddg1a4dg465agbed8gf7f86a8a490c"
msgid "Hah. If my husband could hear that."
msgstr "하. 남편이 그 소릴 들었어야 하는 건데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 591d3606-cf73-92e6-fa74-fb43c63582d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_RefusedToHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:591d3606-cf73-92e6-fa74-fb43c63582d8
msgctxt "hf0704febgb0a4g4723gbf45g7eeb7c0ec62d"
msgid ""
"... you're right. I'm sure you don't want to listen to my prattling. Sorry."
msgstr "... 맞아. 내 헛소리를 듣고 싶진 않겠지. 미안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 5d3c536f-d843-de43-82bd-74344a114afd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - bd0401d4-e236-9a38-631b-f6b33c4bb1bb_MindHasBeenRead = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:5d3c536f-d843-de43-82bd-74344a114afd
msgctxt "h411d6627g1a03g40b1ga378gf827fc952b27"
msgid ""
"<i>Nowhere else to go if he tells. Can't let that happen - just keep "
"calm.</i>"
msgstr "<i>이 녀석이 여기저기 떠벌리기라도 하면 갈 데도 없어. 그렇겐 안 되지. 침착하자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 5d3c536f-d843-de43-82bd-74344a114afd
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - bd0401d4-e236-9a38-631b-f6b33c4bb1bb_MindHasBeenRead = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:5d3c536f-d843-de43-82bd-74344a114afd
msgctxt "h709ba5b9ga67bg4189g918ag94470496a74b"
msgid ""
"<i>Nowhere else to go if she tells. Can't let that happen - just keep "
"calm.</i>"
msgstr "<i>이 녀석이 여기저기 떠벌리기라도 하면 갈 데도 없어. 그렇겐 안 되지. 침착하자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 5d3c536f-d843-de43-82bd-74344a114afd
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - bd0401d4-e236-9a38-631b-f6b33c4bb1bb_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:5d3c536f-d843-de43-82bd-74344a114afd
msgctxt "h72e0d086g8a5bg44e3g952fg0c0fa702eb86"
msgid ""
"<i>Nowhere else to go if they tell. Can't let that happen - just keep "
"calm.</i>"
msgstr "<i>이 녀석이 여기저기 떠벌리기라도 하면 갈 데도 없어. 그렇겐 안 되지. 침착하자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 5df167fc-7ce3-4b12-5d55-9943a2a8468c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:5df167fc-7ce3-4b12-5d55-9943a2a8468c
msgctxt "hff1088c1g97e7g44a5g868fg9939832c3a17"
msgid "Thank you. I hope... I hope it brings you joy."
msgstr "고마워. 부디... 네게 기쁨을 가져다 주길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 609336ea-a6a5-cbc6-b37d-f923f534cdcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:609336ea-a6a5-cbc6-b37d-f923f534cdcb
msgctxt "h6b30e4bdg32c3g4f16ga34egeecda78292e9"
msgid "Had <i>all </i>of that been a lie?"
msgstr "<i>모든 게</i> 거짓말이었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 60cd727a-9921-0ebd-3126-bb19b7024a35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:60cd727a-9921-0ebd-3126-bb19b7024a35
msgctxt "h8d6203bdg3740g4495g9885g6fdbf851cb99"
msgid "Why, you heartless -"
msgstr "이런, 냉혈한 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 68acba54-b145-a2ef-9cf4-4fe423f7a857
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:68acba54-b145-a2ef-9cf4-4fe423f7a857
msgctxt "hdcc9427dg81d1g4d8egb60aga2f4dfd76030"
msgid ""
"It's beautifully crafted. How about I double Ethel's offer? "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr "아름답게 만든 공예품이군. 에텔이 약속한 것보다 두 배를 더 주면 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 6a7899ff-3c2a-c0e9-0933-7f440443aff2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:6a7899ff-3c2a-c0e9-0933-7f440443aff2
msgctxt "hed7a42ddg46a4g4c45gaf84g640e345d1551"
msgid "... truly? I don't know what to say."
msgstr "... 정말? 무슨 말을 해야 할지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 6b7833b4-21a2-d3e0-6519-9c94d96d6b9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingScam_HasMet(1) = True
#.      - DEN_TieflingScam_Event_TalkedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:6b7833b4-21a2-d3e0-6519-9c94d96d6b9f
msgctxt "h925ff487g6237g45a8ga856gbd23f3376cd6"
msgid "I know I need to sell it. I know that."
msgstr "이걸 팔아야 한다는 거 알아. 알고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Narrator
#. NodeID = 6c9086fa-af01-a3db-6b30-9d93132e13c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:6c9086fa-af01-a3db-6b30-9d93132e13c0
msgctxt "h1b5d8abegea95g4913g933egd92854f8378d"
msgid ""
"*You note that it likely isn't worth much, but that she held it as if it was "
"a great treasure.*"
msgstr "*당신은 그게 별 가치 없는 물건이란 걸 알게 됐지만, 여자는 마치 위대한 보물인 것처럼 붙들고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 6da66049-cb69-0111-d8b8-eddf2b357e67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:6da66049-cb69-0111-d8b8-eddf2b357e67
msgctxt "hf4da2cf3g52d1g4534g8941g59bc59354300"
msgid ""
"If we... if <i>I</i> don't, it... then they'll have died for <i>nothing.</i>"
msgstr "만약... <i>내가</i> 해내지 못하면... 모두 <i>헛되이</i>죽은 게 되잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 7005c78d-fe64-832d-a964-219a90eb1f69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:7005c78d-fe64-832d-a964-219a90eb1f69
msgctxt "heed6018fg879dg4b9dg868bg5f4a8e991656"
msgid ""
"No, she would <i>not</i>. Near screamed our ears off when my husband tried "
"to leave it in Elturel."
msgstr "<i>그랬겠지</i>. 남편이 엘투렐에 두고 오려고 했을 때는 귀청이 떨어지도록 소리를 질렀었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Shadowheart
#. NodeID = 70da1ad4-d755-176b-7f54-9faa3babce8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:70da1ad4-d755-176b-7f54-9faa3babce8b
msgctxt "h74a77590g1f07g4636gbe34g26491d63b5cd"
msgid ""
"Next time you feel like wasting gold, I'll happily unburden you of it myself."
msgstr "돈이 아주 썩어 넘치나 본데, 멀리 갈 거 없어. 다음부턴 내게 맡기라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 77d6fd7b-b336-b8f7-2ba5-bc9f9508af13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:77d6fd7b-b336-b8f7-2ba5-bc9f9508af13
msgctxt "h9b19c58egc9bag4f37g84b1g09f36042f12a"
msgid ""
"My daughter, sh-she thought they were just big <i>dogs.</i> I tried to get "
"to her... I <i>tried</i>, but-"
msgstr "내 딸, 걔는 놀이 그냥 큰 <i>개</i>인 줄 알았던 거야. 아이를 <i>잡으려고</i> 했어, 그랬는데-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 7911e284-4248-15c2-1f15-5e7eb3ffedcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:7911e284-4248-15c2-1f15-5e7eb3ffedcb
msgctxt "h786d1987g914dg4676g9f88g9a1e9110e826"
msgid "Are you - "
msgstr "이게 무슨... "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 79f52245-0d35-c52b-f3e6-6b1543a69b9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:79f52245-0d35-c52b-f3e6-6b1543a69b9d
msgctxt "hc838351dg4e6dg4ad9gb470gf5e63ecae257"
msgid "That lot could give the Thieves' Guild a run for their money. "
msgstr "도둑 길드에도 지지 않을 녀석들이야. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 7bffde47-1551-13af-f608-7bedec45fe65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:7bffde47-1551-13af-f608-7bedec45fe65
msgctxt "he17c1e7dg8554g4972ga8cdgc2c1e82bd728"
msgid "Lose the sob story. Less is more."
msgstr "뻔한 신파는 버려. 너무 장황해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 7ddf8478-6496-aee4-26b8-56fd46d84a9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:7ddf8478-6496-aee4-26b8-56fd46d84a9a
msgctxt "h810df367g7527g42c2g876agf4d43ce0b36a"
msgid "How - "
msgstr "그걸 어떻게... "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 896dab14-552f-8ab5-cfd6-a6977f85ae5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment_2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:896dab14-552f-8ab5-cfd6-a6977f85ae5c
msgctxt "h1e144c7egd779g4140g9435gf0efe7dc1778"
msgid ""
"That was masterful performance. Here. A token of appreciation. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""
"훌륭한 구경거리였어. 자, 감사의 의미야. ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 89ec781d-276e-57c1-bbaf-73fc15c4ea7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:89ec781d-276e-57c1-bbaf-73fc15c4ea7f
msgctxt "h93951cdcge12cg4a47g8431g8d6a2a933250"
msgid "That's a pleasant tune."
msgstr "듣기 좋은 선율이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 8bb1a46d-cd70-97d9-0173-94eb937c5bb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:8bb1a46d-cd70-97d9-0173-94eb937c5bb1
msgctxt "hae2809cagdb4ag4493g8667g5d08faa8ae78"
msgid ""
"I <i>do </i>need the coin. The guards in Baldur's Gate aren't going to let "
"us in without a little encouragement."
msgstr "<i>정말</i> 돈이 필요한 건 맞아. 약간의 격려금 없이는 발더스 게이트의 경비원이 우릴 들여보내 주지 않을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 8cdd177a-d54d-5d37-ecbf-79efe6aefcd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingScam_State_HasMusicBox(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_TieflingScam_Event_GiveMusicBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:8cdd177a-d54d-5d37-ecbf-79efe6aefcd8
msgctxt "h0e9fcdbbg48cdg4c58gbfdbg0b29015e4eaa"
msgid ""
"If I had a little coin, I could afford to be self-righteous too. Take it."
msgstr "돈만 있었으면 나도 너처럼 독선적으로 굴 여유가 있었겠지. 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 8ef939ae-1422-e985-fe02-9ebc58b8eabe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:8ef939ae-1422-e985-fe02-9ebc58b8eabe
msgctxt "hcab43282g79abg4829g9fa3g2d69c588d4be"
msgid "Sell it? I don't think your 'little monster' would like that."
msgstr "그걸 판다고? '작은 꼬마 괴물들'이 좋아하지 않을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 8f12718f-96a9-ca16-c2fe-f31708c79b11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingScam_State_HasMusicBox(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_Event_GaveMoney(1) = True
#.   Global:
#.     - DEN_TieflingScam_State_GotMoney = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:8f12718f-96a9-ca16-c2fe-f31708c79b11
msgctxt "h1ae2a354g73d7g41e3g9b84gd56e8e8ea0ce"
msgid "You would... truly?"
msgstr "정말... 그래 주겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 92329045-9b4c-17a3-89f7-2c63c16f2e10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:92329045-9b4c-17a3-89f7-2c63c16f2e10
msgctxt "hd2985f06gfc3eg4f29gb917g7a9df3158ed5"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 93c4c448-43e6-0c17-ae6e-d7c06602b153
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:93c4c448-43e6-0c17-ae6e-d7c06602b153
msgctxt "h948adb93gb8a7g4f2fga513g14beb23d8363"
msgid ""
"I'd like to say I don't need the charity, but... just promise me you'll take "
"care of it."
msgstr "동정은 필요 없다고 거절하고 싶지만, 그래도... 잘 간직하겠다고 약속해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 93d15da3-0108-73f3-81c2-09e1bd501f80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:93d15da3-0108-73f3-81c2-09e1bd501f80
msgctxt "h83e77ddcg0606g42eagad5fg12f08c09b3f2"
msgid "I... of course, I understand. Th-thank you."
msgstr "그렇겠지... 이해해. 고-고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Shadowheart
#. NodeID = 95dcfa01-b1ed-f274-abb0-0c2a2b20d4e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:95dcfa01-b1ed-f274-abb0-0c2a2b20d4e4
msgctxt "h2c97d37cg66b6g47e6g8606g63030d0173c6"
msgid "People like you indeed. Idiots, I assume she means."
msgstr "너 같은 사람이라니. 아마도 멍청이란 뜻이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = 9e427a84-d880-48b4-f954-b4f28149e438
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingScam_State_KeptMusicBox = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:9e427a84-d880-48b4-f954-b4f28149e438
msgctxt "h69b079b5g85dag419ag85a1g6775977d5c53"
msgid "How about you hang onto it - for safe-keeping."
msgstr "계속 갖고 있는 게 어때 - 안전하게 보관해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = 9f8c2194-7448-088e-7a90-11320b8a8d07
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:9f8c2194-7448-088e-7a90-11320b8a8d07
msgctxt "haca8b23dg4cd2g4a87g86efgb8d17a049c3c"
msgid "No. <i>No</i>. You do <i>not </i>get to do that."
msgstr "아니. <i>안 되지</i>. 그런 짓은 하지 <i>말았어야지</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = a08cabfb-e7ae-9fe6-e9e6-a87f82a3bb42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a08cabfb-e7ae-9fe6-e9e6-a87f82a3bb42
msgctxt "h35ddd5b9g05ecg4235g8b89g53a26957cfcd"
msgid ""
"I... don't have anything else. My husband was carrying our packs when the "
"gnolls found us."
msgstr "가진 게... 아무것도 없어. 놀이 우릴 덮쳤을 때 짐은 모조리 남편이 지고 있었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = a386f111-378d-d9f2-7799-678988ff2e93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingScam_Event_FoundOutLies(1) = True
#.   Global:
#.      - DEN_TieflingScam_Knows_Scam = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a386f111-378d-d9f2-7799-678988ff2e93
msgctxt "hd15f0d95g75a8g4d0eg9374g3a68b3bfa369"
msgid "No need for this to get ugly, is there? Bye-bye, now."
msgstr "서로 얼굴 붉힐 필요 없겠지, 응? 나중에 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = a481a8b8-59ac-20be-5e55-03b60b775dd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a481a8b8-59ac-20be-5e55-03b60b775dd8
msgctxt "hbf194027g1518g4b93ga0bagfc917fd6ed1a"
msgid ""
"...<i>seriously? </i>I'll take any fool's coin. Call it charity if it makes "
"you feel better about it."
msgstr "...<i>진심이야</i>? 그럼 눈먼 돈이라 생각하고 받을게. 아니, 기부라고 해야 보람을 느끼려나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = a6d7da15-13b9-e620-6f47-4fd75e7257c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a6d7da15-13b9-e620-6f47-4fd75e7257c2
msgctxt "h1b47d95cg1fa1g4ea8g9806g9702f7f92108"
msgid "You're quite the actor. You almost had me."
msgstr "연기가 훌륭한걸. 깜빡 속을 뻔했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = a7c43a2d-4acc-18da-9dfe-0e3e1897d1e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a7c43a2d-4acc-18da-9dfe-0e3e1897d1e8
msgctxt "h3ec68907geb07g4238gb5c4ge66296aa057e"
msgid ""
"It's easy to forget that there are people like you in the world. Thank you "
"for reminding me."
msgstr "당신 같은 사람이 있다는 걸 잊고 살기 십상이지. 다시 떠올리게 해줘서 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = a7d63729-4153-01f6-cd35-b7956cbaf262
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a7d63729-4153-01f6-cd35-b7956cbaf262
msgctxt "hf9f40cc2gfaf8g4422gae53g8ae0ac94d48c"
msgid "<i>Actor?</i>  How could you say -"
msgstr "<i>연기라고?</i> 어떻게 그런 말을 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = a7fa8aeb-1af5-ba75-2c3d-fd06b1d6c57d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a7fa8aeb-1af5-ba75-2c3d-fd06b1d6c57d
msgctxt "h877aff37gb3b1g485dga339g3f13730a70eb"
msgid "That box is worthless."
msgstr "그 상자는 쓸모 없는 물건이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = a835d3d4-5b3f-7b56-68c0-35a6dd9c8dbd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:a835d3d4-5b3f-7b56-68c0-35a6dd9c8dbd
msgctxt "hf75f47a7g3106g4743gaf64g54117f5b2252"
msgid "I'm not leaving without that atrocity you call craftsmanship."
msgstr "걸작은 개뿔. 그 끔찍한 상자를 넘기기 전에는 한 발짝도 못 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = aadce993-0071-48ec-8a31-71bdce265f95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:aadce993-0071-48ec-8a31-71bdce265f95
msgctxt "h9ec9c8c7g0427g4785g8a04gcb5adc9e7def"
msgid ""
"You're kind, but I - I <i>can't </i>think about that now. We promised one "
"another we'd get there, whatever it took."
msgstr ""
"친절한 사람이구나. 그래도 지금은 그 일을 생각할 때가 <i>아냐</i>. 우린 무슨 일이 있어도 발더스 게이트로 가기로 약속했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = acb9a3fd-6185-3bcf-9f42-fff2e29e33ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:acb9a3fd-6185-3bcf-9f42-fff2e29e33ac
msgctxt "h0a7f7459g8ac5g434dgb6cfg724d35d1e9ae"
msgid "Oh, try listening to it a hundred times a day."
msgstr "하루에 백 번이 넘도록 들어보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = b3fe4aca-0c0d-6daf-1227-5944bb771928
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:b3fe4aca-0c0d-6daf-1227-5944bb771928
msgctxt "hf0e7464fgf003g4fd3gaa29gc77684682499"
msgid "Thank you. I hope... I hope it brings you joy.\n"
msgstr "고마워. 부디... 네게 기쁨을 가져다 주길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = b9606702-ba0a-5d3d-ca0d-0a5384c8a4dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:b9606702-ba0a-5d3d-ca0d-0a5384c8a4dc
msgctxt "h1b064c74gca8ag4db5gbd7agdd58d42e3054"
msgid "You've lost so much. I'm sorry."
msgstr "많은 걸 잃었구나. 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = b99f694a-d02a-8282-d73e-412108b90e98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:b99f694a-d02a-8282-d73e-412108b90e98
msgctxt "h2a536812g3182g4553gb363g6e822c8c522b"
msgid "Close that box. The music is grating."
msgstr "그 상자 닫아. 귀에 거슬리잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = b9e0d1af-bea9-bd59-fadc-64746f22c8b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:b9e0d1af-bea9-bd59-fadc-64746f22c8b5
msgctxt "h15b42d54gc291g45dbgb76cg33413b2f788b"
msgid "Not so - it's <i>magic.</i>"
msgstr "그렇지 않아 - <i>마법</i>이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = ba3befa9-67bb-6fa9-04b8-62c3cdbccac5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingScam_Event_InspectedBox(1) = False
#.   Tag:
#.      - REALLY_DWARF(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_TieflingScam_Event_InspectedBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ba3befa9-67bb-6fa9-04b8-62c3cdbccac5
msgctxt "hcd1b4466g5cb9g4c2agb395g84be5a36d39f"
msgid "<i>Inspect the craftsmanship.</i>"
msgstr "<i>만듦새를 살펴본다</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = bdd4d9fd-4fbb-d8ba-eedb-5556150143ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:bdd4d9fd-4fbb-d8ba-eedb-5556150143ae
msgctxt "hbae8a33bg7e23g42d1g999bg4b678b41dc50"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = bde0af18-2094-fef6-8336-712cd502a6c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_Event_TalkedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:bde0af18-2094-fef6-8336-712cd502a6c8
msgctxt "hc7d583d8g2019g4949ga742g9f859fa9d122"
msgid ""
"You must - you must think I'm a <i>monster</i>.  But they say you need coin "
"to enter the city. Bribes."
msgstr "분명 나를 <i>괴물</i>같은 여자라 생각하고 있겠지. 그래도 도시에 들어가려면, 뇌물이 좀 필요하다고 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = c2110a75-eee8-5544-5386-e608c0db9372
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:c2110a75-eee8-5544-5386-e608c0db9372
msgctxt "hdc64f37fg6803g486dg9e70g74fac2881293"
msgid "Bah, fine. Let's not waste any more of one another's time, hm?"
msgstr "쳇, 됐어. 좌우간 시간 낭비는 이쯤 해 두자고, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = c22165a3-7729-0f3e-8b8c-6912c94c97cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. TagRule: !(GITHYANKI and REALLY_GITHYANKI)
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:c22165a3-7729-0f3e-8b8c-6912c94c97cc
msgctxt "he1b4ac6dgf0d9g4103g9173g58ea69ca4a22"
msgid "<i>Hum along. </i>"
msgstr "<i>음을 따라 흥얼거린다</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = c2fb1743-d3c0-2636-977a-7ed3e1228667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:c2fb1743-d3c0-2636-977a-7ed3e1228667
msgctxt "he1ac5912g04f5g44cfgaea1g60248215840c"
msgid "Take Ethel's offer. Your family would want you to live."
msgstr "에텔의 제안을 받아들여. 가족들은 당신이 살길 바랐을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = c45d3876-6580-6bcf-5603-6762b1b409a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:c45d3876-6580-6bcf-5603-6762b1b409a0
msgctxt "h2173caedga010g4f50g8c60g428700ea8476"
msgid "Here. It's no work of art, but I hope -"
msgstr "여기 받아. 명품은 못 되지만 그래도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = c53bb0e2-fe7c-2368-447d-6812fa5795c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingScam_Event_GaveMoney(1) = False
#.   Global:
#.      - DEN_TieflingScam_State_GotMoney = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:c53bb0e2-fe7c-2368-447d-6812fa5795c3
msgctxt "h0de54225gef7bg4c69g8c35gf58adaab0d21"
msgid "The one you're travelling with? You're lucky to know them."
msgstr "너랑 같이 다니던 사람들? 알고 지낸 걸 행운으로 알라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = c75e0784-9cd8-6aae-b48a-03d0e314d60f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingScam_State_IsScamming(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:c75e0784-9cd8-6aae-b48a-03d0e314d60f
msgctxt "h40ec4dfag7e16g42a8gbf22g7183fead642d"
msgid "Please, I'd... I'd like a moment alone."
msgstr "부탁해, 혼자 있고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = c9bc5565-1262-c176-4203-f9d33cfa3539
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment_2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:c9bc5565-1262-c176-4203-f9d33cfa3539
msgctxt "h2e392b36g55b7g4c9agbde3g90a4a62b9a8c"
msgid ""
"You must be in dire need to lie like that. Here. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""
"그런 거짓말을 하는 걸 보니 상황이 많이 절박한가 보군. 자, ([GEN_CheckMagicPocketGold_2_463b0f43-5410"
"-412d-aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = cb68815b-1887-4710-8d3a-b9a1eba5a30d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:cb68815b-1887-4710-8d3a-b9a1eba5a30d
msgctxt "hc74cd0ebg0d8eg4d3ag9feag6c66f36fdc91"
msgid ""
"We... we met gnolls on the road. I got away, but my husband... my "
"<i>daughter</i>-"
msgstr "길에서 놀을 만났거든... 나는 빠져나왔지만, 남편하고 <i>딸</i>은-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = ccd1a741-b727-32fe-1843-1c54221b98e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ccd1a741-b727-32fe-1843-1c54221b98e7
msgctxt "h7febead7g7bedg49b1g9975g81c7e07e647b"
msgid "I... thank you. Just... <i>thank you.</i>"
msgstr "그게... 고마워. 아무튼 <i>고마워.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = ce8e9c3c-9c6a-a305-780a-09b2e3d9b4cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_TieflingScam_Event_GiveMusicBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ce8e9c3c-9c6a-a305-780a-09b2e3d9b4cd
msgctxt "he7a02a7bg0d52g4dd1gb722g5c1e281edeb6"
msgid "I'll look after it. Don't worry."
msgstr "잘 보관할게. 걱정 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = d639679b-e48b-db9a-088c-be97ca4bd5ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_Event_TalkedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:d639679b-e48b-db9a-088c-be97ca4bd5ef
msgctxt "h80842955gedb2g4026gadb7g21c566829aa5"
msgid ""
"I don't... what else can I do? They say you need coin to enter the city. For "
"<i>bribes.</i>"
msgstr "달리 내가 뭘 어쩔 수 있지? 도시에 들어가려면 돈이 필요하다고 했어. <i>뇌물</i>말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = da2361a8-43ed-28d3-b2b8-9ff2a60e5e14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:da2361a8-43ed-28d3-b2b8-9ff2a60e5e14
msgctxt "h9f3d3710g45dbg4222g9748ga4bdfd779f95"
msgid ""
"Don't sell the box. I'll get you the money. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr "상자를 팔지 마. 돈을 좀 구해다 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = da2cf884-ae44-90ea-b2a7-9d50b5bac61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:da2cf884-ae44-90ea-b2a7-9d50b5bac61e
msgctxt "h41b17d74g62c4g4dc8gb902g7b4948ebe9fd"
msgid "Said as much to my husband when he made the bloody thing."
msgstr "이 망할 것을 만들었을 때 나도 남편에게 그 말 많이 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = da7aabd1-1a1d-0809-4f55-0a1d9587a763
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:da7aabd1-1a1d-0809-4f55-0a1d9587a763
msgctxt "h1ea372ccg539dg4133gb5bfgb53f322ff448"
msgid "What can I say? Not much of a tiefling who can't play the victim."
msgstr "그렇지만 어쩌겠어? 불쌍한 척하는 게 티플링의 특기인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = ddb67714-af63-ad0a-d975-bf7a127cbc67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ddb67714-af63-ad0a-d975-bf7a127cbc67
msgctxt "h35373f2bgc850g4711g8576gc71b6e7495fc"
msgid "Watch yourself - they're not as kind as I am. "
msgstr "조심해. 걔들은 나처럼 착하지 않으니까. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = ddc7ad88-c39c-71de-c725-86c4b95795e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingScam_Event_GaveMoney(1) = True
#.   Global:
#.     - DEN_TieflingScam_State_GotMoney = True
#.     - DEN_TieflingScam_State_KeptMusicBox = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ddc7ad88-c39c-71de-c725-86c4b95795e5
msgctxt "hc574c242gce29g439ag9996g7de6cb6f96cb"
msgid ""
"You don't need to sell it. In fact, I'll pay you not to. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr "그걸 팔지 않아도 돼. 대신 내가 돈을 좀 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = deb1ee8e-c54d-5f3f-04f7-dca39a675d49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingScam_Event_FoundOutLies(1) = False
#.   Global:
#.      - DEN_TieflingScam_Knows_Scam = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:deb1ee8e-c54d-5f3f-04f7-dca39a675d49
msgctxt "h4409855ag99c4g42c4g9119g5c40406e0973"
msgid "Thought you'd come and gloat, did you? Well, piss off - I'm working."
msgstr "와서 고소해 할 줄 알았어, 그치? 자, 이제 꺼져 - 일하는 중이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = dff43b2a-6feb-ef25-93b0-7ad197a435e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:dff43b2a-6feb-ef25-93b0-7ad197a435e2
msgctxt "h8ec0ce8eg0d66g4a4fga92dga80324352e64"
msgid "This isn't my problem."
msgstr "이건 내 문제가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = e03cfcdb-d45b-cd96-2827-46308f4866b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:e03cfcdb-d45b-cd96-2827-46308f4866b3
msgctxt "h60230ba6g58ebg4fe9g9070gb0029aa22d1e"
msgid "I..."
msgstr "흠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = e3a50d4a-c7b6-421e-f7d9-e3207b70c7cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:e3a50d4a-c7b6-421e-f7d9-e3207b70c7cd
msgctxt "h4820461bgc879g4f66g9cbcg67d12cd08b72"
msgid ""
"But it kept our little monster quiet. Reason to love it if nothing else, "
"trust me."
msgstr "우리 꼬마 괴물들을 조용하게 만들어 줬어. 사실 그거 말곤 좋아할 이유가 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = e434e62e-f0ff-04d2-5147-914220ac652d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:e434e62e-f0ff-04d2-5147-914220ac652d
msgctxt "h78526ba0gc18eg4d95ga32egfea0346ed582"
msgid "You're cute. But you're taking up space for the next idiot."
msgstr "귀엽네. 근데 다른 호구 잡아야 하니까 좀 비켜 줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = ef5127a7-66c3-e4e0-cd2d-603350235c9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingScam_State_HasMusicBox(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_TieflingScam_Event_GiveMusicBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ef5127a7-66c3-e4e0-cd2d-603350235c9c
msgctxt "h1c17d42cg69beg4adbga0d6gd5363ea4ad77"
msgid "<i>All right,</i> you win. Just... take it."
msgstr "<i>그래,</i> 네가 이겼어. 그냥... 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = ef8a1bba-bb6b-af81-895e-e6db052123ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ef8a1bba-bb6b-af81-895e-e6db052123ce
msgctxt "hf6a33ab2g25d3g4f96gb851gd1f9d0a215f5"
msgid "Oh! Sorry, I'm just... I'm just listening."
msgstr "아, 미안, 그냥... 듣고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = f004d733-2c78-08e1-7a91-60d5c144f4a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:f004d733-2c78-08e1-7a91-60d5c144f4a3
msgctxt "hf4e24c58g6e05g4878g8f9agc7fdfa79e82b"
msgid "I'll speak to her. In a little while."
msgstr "다시 찾아가 볼게. 나중에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = f0534ab8-258a-1d11-24f4-b484f06d1449
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:f0534ab8-258a-1d11-24f4-b484f06d1449
msgctxt "h3cf17a03g5bd5g4c66gafd8g4ab2697faa85"
msgid ""
"Gods, look, I don't have it anymore. See? Now take your freakshow elsewhere."
msgstr "젠장, 보여? 난 이제 빈털터리 신세야. 그 괴물 같은 짓은 다른 데서 하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = f2b4d923-b94b-75e4-d8f8-36a3fd0807ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:f2b4d923-b94b-75e4-d8f8-36a3fd0807ea
msgctxt "hef900bfbg0af5g4e49g8b09g2395029c9d55"
msgid "All right, fine. One artist knows another. "
msgstr "그래, 그만하자. 선수끼리 누가 누굴 속이겠어. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = f2bae0e5-2a85-120a-8e9e-521d0e0a1010
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingScam_Event_GaveMoney(1) = True
#.   Global:
#.      - DEN_TieflingScam_State_GotMoney = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:f2bae0e5-2a85-120a-8e9e-521d0e0a1010
msgctxt "he22ab3b8g2543g4af6g87f2gb8c01013a692"
msgid "Heh. I still can't seem to get that song out of my head."
msgstr "그 노래를 머릿속에서 지울 수가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = fc262e0d-379c-5175-073d-1d468cb49509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:fc262e0d-379c-5175-073d-1d468cb49509
msgctxt "hb87fd289gb492g4e38g9cedge0d5e3470d50"
msgid "No box, no deal."
msgstr "물건이 없으면 거래도 끝이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = fe9c2ed5-2cc6-b11e-8c36-91cfca75bdd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:fe9c2ed5-2cc6-b11e-8c36-91cfca75bdd0
msgctxt "h2a87d390g132ag4e7dga9d0g42394f750fcc"
msgid "It's nothing special."
msgstr "특별할 것 없어 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Player
#. NodeID = ff4738e8-03aa-78be-312b-e038c2f82646
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingScam_Event_InspectedBox(1) = False
#.   Tag:
#.      - REALLY_DWARF(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_TieflingScam_Event_InspectedBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ff4738e8-03aa-78be-312b-e038c2f82646
msgctxt "h9aaffec8gc36eg496dgbb9cg2fdcef41df1c"
msgid "<i>Inspect the box.</i>"
msgstr "<i>상자를 살펴본다</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = ff83f2f8-4e96-887f-6b8e-96324e1741eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ff83f2f8-4e96-887f-6b8e-96324e1741eb
msgctxt "h44f016f4gcec5g4de5gafb0gee90f61620ef"
msgid ""
"My husband made it to keep our little monster quiet - traded one headache "
"for another, really."
msgstr "내 남편이 아이들을 조용히 시키려고 만든 건데 - 사실 두통 하나 없애려고 하나 더 만든 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam
#. Speaker = Nerela
#. NodeID = ffd0286d-3cb3-6896-c809-54a78c6fbb6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingScam:ffd0286d-3cb3-6896-c809-54a78c6fbb6d
msgctxt "h67862911g53b1g469fgb008g024dfd9b65d0"
msgid ""
"Well, I suppose I'm not going anywhere. But don't trouble yourself for me, "
"really."
msgstr "그럼 꼼짝없이 기다려야겠네. 그래도 괜히 나 때문에 애쓰지는 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TorturedAdventurer_Resting
#. Speaker = Narrator
#. NodeID = 439e6c50-a0ec-b70c-6019-e946c7ecbf8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TorturedAdventurer_Resting:439e6c50-a0ec-b70c-6019-e946c7ecbf8c
msgctxt "hf4090d32g1924g407agaf8fg86eb4583ec8a"
msgid ""
"*The adventurer sleeps soundly, his breath steady, his wounds expertly "
"bandaged.*"
msgstr "*곯아떨어져 있는 모험가의 호흡은 안정적이고 상처엔 능숙한 솜씨로 붕대가 감아져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Trainer_AD_GreetingPlayer
#. Speaker = Asharak
#. NodeID = 78359bfc-c180-b9cf-72a3-d8325c72b5bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Trainer_AD_GreetingPlayer:78359bfc-c180-b9cf-72a3-d8325c72b5bb
msgctxt "h3a7f11b2g28d4g43a1gba3agc327c1b18547"
msgid "Children! Look who's here!"
msgstr "얘들아! 누가 왔는지 보렴!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret
#. Speaker = Player
#. NodeID = 8fd24e9b-2a46-44c4-97e3-04f1bdf41952
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret:8fd24e9b-2a46-44c4-97e3-04f1bdf41952
msgctxt "hd853b30egd535g4b80ga122g9f8410822727"
msgid "Glowing eyes are so rarely a good sign. Best tread carefully."
msgstr "빛나는 눈은 대부분 좋은 신호가 아니지. 조심하는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret
#. Speaker = Player
#. NodeID = 8fd24e9b-2a46-44c4-97e3-04f1bdf41952
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret:8fd24e9b-2a46-44c4-97e3-04f1bdf41952
msgctxt "h148bb9ddg98efg4575ga374g2bdb3c4215cc"
msgid "Druid magic. Better tread carefully."
msgstr "드루이드의 마법이야. 조심하는 편이 낫겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret
#. Speaker = Player
#. NodeID = 8fd24e9b-2a46-44c4-97e3-04f1bdf41952
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret:8fd24e9b-2a46-44c4-97e3-04f1bdf41952
msgctxt "hae51a131g54a5g44c4g87d3g2d0fde96d1d3"
msgid "Fire in those eyes. I smell a trap."
msgstr "눈에서 불길이 타오르고 있어. 함정 냄새가 나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret
#. Speaker = Player
#. NodeID = 8fd24e9b-2a46-44c4-97e3-04f1bdf41952
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret:8fd24e9b-2a46-44c4-97e3-04f1bdf41952
msgctxt "h8a910a7fge799g43ddgb8b2gcf525a52ae44"
msgid "Glowing eyes? How outrageously obvious - the totem's a trap."
msgstr "빛나는 눈이라고? 어쩜 저리 뻔할까 - 저 토템은 함정이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret
#. Speaker = Player
#. NodeID = 8fd24e9b-2a46-44c4-97e3-04f1bdf41952
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret:8fd24e9b-2a46-44c4-97e3-04f1bdf41952
msgctxt "h4feba019g6293g4517gba03gdbf585dbfb70"
msgid ""
"I don't think that statue's eyes are glowing to provide illumination. Best "
"be careful."
msgstr "그 석상의 눈이 빛나는 게 주위를 밝히는 용도는 아닌거 같아. 조심해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret
#. Speaker = Player
#. NodeID = 8fd24e9b-2a46-44c4-97e3-04f1bdf41952
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret:8fd24e9b-2a46-44c4-97e3-04f1bdf41952
msgctxt "h7177ffe2gd10ag49b3gbc8dg527c3a60006c"
msgid "Glowing eyes? I know a trap when I see one."
msgstr "빛나는 눈이라고? 안 봐도 함정이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret
#. Speaker = Player
#. NodeID = 8fd24e9b-2a46-44c4-97e3-04f1bdf41952
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Tunnel_PAD_TunnelTurret:8fd24e9b-2a46-44c4-97e3-04f1bdf41952
msgctxt "ha2893213g0fdfg498eg8ae2g939b4ba28495"
msgid "Glowing eyes are rarely a good sign. Best be careful."
msgstr "빛나는 눈은 대게 좋은 신호가 아니지. 조심해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Victory_Transition
#. Speaker = Gerson the Bent
#. NodeID = 09d78dff-0171-42e2-dc66-997ef20b229a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Victory_Transition:09d78dff-0171-42e2-dc66-997ef20b229a
msgctxt "h58fb4dd1g93fbg4e3ag9e7cgbe679b34658c"
msgid ""
"Have you heard? Scouts have just reported the goblins have been neutralised. "
"The way is clear!"
msgstr "소식 들었어? 정찰대원 말로는 고블린들이 소탕됐대. 길이 열린 거라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Victory_Transition
#. Speaker = Gerson the Bent
#. NodeID = 7b6bdfe1-1c6b-4101-ead0-572ab4ccc874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Victory_Transition:7b6bdfe1-1c6b-4101-ead0-572ab4ccc874
msgctxt "h812a4f48ge265g480cgb167ge1f303494e58"
msgid "The others are gathering near the gate - come on!"
msgstr "다들 입구로 모이고 있어, 가자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 04bfcbc2-9e4f-3165-2893-87ca9024df76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:04bfcbc2-9e4f-3165-2893-87ca9024df76
msgctxt "h87511466gba10g4e99ga027gcd9fe9e71d0a"
msgid "Wait. About our conversation earlier - why the dragon?"
msgstr "잠깐. 우리가 아까 했던 대화 말인데, 왜 하필 드래곤이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 0647e45b-41d3-7ff1-ae52-1be4fd416f62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Background_Entertainer_Act1_VoloTale(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:0647e45b-41d3-7ff1-ae52-1be4fd416f62
msgctxt "h811a2318g6506g4ee6g889dg5c7760c2034c"
msgid "Neither! It was a gold dragon, scales glittering and wings gleaming."
msgstr "둘 다 아니야! 그건 화려한 비늘과 찬란한 날개의 골드 드래곤이었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 0fa82ea8-9720-a448-f369-b873bc96ebf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:0fa82ea8-9720-a448-f369-b873bc96ebf6
msgctxt "hd41798c3gd9a9g4916ga5e5ge2c84295d73d"
msgid ""
"Aha! I've always preferred <i>experience </i>to the second-hand accounts of "
"lesser men. But to each their own!"
msgstr "아하! 난 항상 직접 <i>경험하는</i> 편을 선호한다네. 하지만 각자 자신만의 방식이 있는 법이지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 129513e6-f3af-6588-4ff1-ab0533dba506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:129513e6-f3af-6588-4ff1-ab0533dba506
msgctxt "h457737f0gc1e7g42feg9913g4aed986256ad"
msgid "Dragon...? There wasn't any <i>dragon</i>."
msgstr "드래곤...? <i>드래곤</i>은 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 132b06ab-981e-c69a-ecf8-d3485abf95a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:132b06ab-981e-c69a-ecf8-d3485abf95a2
msgctxt "hf485f239ge240g4290gac34g438654ca60dc"
msgid "Be careful. Goblins aren't known for mercy."
msgstr "조심해. 고블린들은 자비를 모르니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 18c8cdf4-753d-89f4-6979-63346ea0420c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:18c8cdf4-753d-89f4-6979-63346ea0420c
msgctxt "h5916cc49g166eg4550g9d06g8085bfc7d97c"
msgid "Ye gods! Can it be? How terribly... compelling..."
msgstr "신이시여! 그럴 수가 있는가? 정말이지... 그럴 듯 하군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 1d1f211f-e319-46f3-a53e-2a3d69b81948
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:1d1f211f-e319-46f3-a53e-2a3d69b81948
msgctxt "h7f848bceg41c8g4ad3g87aeg384b2ef1bc97"
msgid "My! A scholar after my own heart. Spent much time among goblins?"
msgstr "세상에! 내 마음을 닮은 학자로군. 고블린들 사이에서 많은 시간을 보냈나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 1e54413c-57a5-cfe6-9a2c-7ec038c778ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:1e54413c-57a5-cfe6-9a2c-7ec038c778ca
msgctxt "h1d44771bg5d64g42e5g8fffg95569c60bad2"
msgid ""
"'Witnesses... noticed... <i>red</i>... dragon... marching... at... rear...'"
msgstr "'목격자가... <i>레드</i>... 드래곤이... 뒤에서... 날아오는... 것을... 목격함...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 1ea65ebb-d7b0-454f-cde2-3df8acd8d330
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:1ea65ebb-d7b0-454f-cde2-3df8acd8d330
msgctxt "hfce04625g1714g41e4gb797gd5fe4b603ec2"
msgid "Fine - ask your questions."
msgstr "좋아, 질문해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 1ff1fd9f-0d0b-6015-0b53-c78089d92cc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:1ff1fd9f-0d0b-6015-0b53-c78089d92cc8
msgctxt "h9075aa4dg66ebg4bfdga210g551c5f66cd9e"
msgid "They did, didn't they? Oh-ho, curious. Curious <i>indeed</i>."
msgstr "그랬겠지, 안 그랬겠나? 오-호, 궁금하군. <i>실로</i> 궁금해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 21b2524d-baee-9f13-87ad-f51de5d7f128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:21b2524d-baee-9f13-87ad-f51de5d7f128
msgctxt "hf57cc79ag6eceg43cdg9e33g4e061a025430"
msgid "Oh, I'd imagine him <i>quite</i> displeased."
msgstr "오, 내 생각엔 <i>꽤나</i> 불쾌했겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 2253d3a4-8169-569b-e273-1ef4e80db017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:2253d3a4-8169-569b-e273-1ef4e80db017
msgctxt "hdbae30cbg85cag47e3gab62g13ab667294eb"
msgid ""
"Thank heaven you were here to specify, or I might have recorded a boldfaced "
"lie!"
msgstr "그대가 설명해 줄 수 있어서 정말 다행이군, 그렇지 않았다면 뻔뻔한 거짓말을 적어야 했을 걸세!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 23c75f56-0a00-75c0-cca5-5584b5b1c7f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:23c75f56-0a00-75c0-cca5-5584b5b1c7f6
#, fuzzy
msgctxt "hf96108a5gc06bg488ag809dg61cf7f10679e"
msgid "Common variety goblins, led by a lasher and flanked by booyahgs."
msgstr "래셔가 무리를 이끌고 부야그들이 측면에 배치된 흔한 종류의 고블린들이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 27f9f3e0-900b-3d24-defa-1eaf64f36f4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_Background_Entertainer_Act1_VoloTale(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:27f9f3e0-900b-3d24-defa-1eaf64f36f4f
msgctxt "ha36ddb99gc0d6g4c69g8608gec4810d077c4"
msgid "Goblins? Hardly. They were shapeshifted devas!"
msgstr "고블린? 아닐걸. 그들은 형상 변환한 데바였어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 296e9102-52f9-4ecb-5037-c56f46a42762
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Background_Entertainer_Act1_VoloTale(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:296e9102-52f9-4ecb-5037-c56f46a42762
msgctxt "h2b99df76gb35bg4cfbg879fgc849a6d429bc"
msgid "Heh - it was brass. No doubt about it."
msgstr "헤, 브라스 드래곤이었어. 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 2a68e948-8918-d150-3cf2-25ae2c5ed46b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:2a68e948-8918-d150-3cf2-25ae2c5ed46b
msgctxt "h1b43138fg8219g4330ga365g7c69965343b0"
msgid ""
"Really? Well, this does complicate things... but then again... well, never "
"mind."
msgstr "정말인가? 이거 원, 일이 복잡해지는군... 그래도 어쩌면... 아니네, 신경 쓰지 말게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 2aa9a0b7-c39a-78c1-a6eb-54fae545d86c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:2aa9a0b7-c39a-78c1-a6eb-54fae545d86c
msgctxt "hd10fec30g0cebg41b8gb979gc036bb723eaa"
msgid "Until we meet again!"
msgstr "다시 만나길!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 3014152d-a541-195b-c1a7-cf829829f4be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:3014152d-a541-195b-c1a7-cf829829f4be
msgctxt "h326d1ebbgdcaeg4022g8e3dg7c61a7df76b4"
msgid "<i>Glory!</i> Now, then:"
msgstr "<i>영광이군!</i> 자, 그럼:"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 31818335-c2cb-1c7b-5026-9aad441a8a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:31818335-c2cb-1c7b-5026-9aad441a8a49
msgctxt "hf1fc4401g7b4dg40d7gbce9ga56bde0641bc"
msgid "Where are you heading?"
msgstr "어디로 향하려고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 3249d730-74b1-5203-e9a1-4db1b8e4f263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:3249d730-74b1-5203-e9a1-4db1b8e4f263
msgctxt "hffb8ca51g1fbcg403eg9853gbc69940aa932"
msgid ""
"Shocking little creatures, aren't they? Still, there's quite a bit more to "
"them than most accounts allow."
msgstr "아주 작지만 충격적인 생물들이지 않나? 그런데도, 그들에겐 대부분의 이들이 말하는 것보다 많은 특징이 있다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 34a522f4-e2f4-43de-d983-b51d1894a1cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:34a522f4-e2f4-43de-d983-b51d1894a1cf
msgctxt "h6db69ae6g500eg4e34g8264ge7774119bb08"
msgid ""
"And the... <i>dragon</i> they had marching in the rear. Was it of the brass "
"or silver variety?"
msgstr "그리고... <i>드래곤</i>이 후방에서 행진하고 있었지. 종류는 브라스였나, 실버였나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 36cc2db4-614c-ea0f-d8f2-3ae94be6a39c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:36cc2db4-614c-ea0f-d8f2-3ae94be6a39c
msgctxt "hb684d961gd060g430dg98f9gc6058647515d"
msgid "What brought you to the wilds in the first place?"
msgstr "애초에 이 야생엔 왜 온 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 36d1db6a-b794-a733-1a28-7f639925c3f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:36d1db6a-b794-a733-1a28-7f639925c3f6
msgctxt "h52d76e96g140eg4993ga203g54fd213ab219"
msgid "Dragons? Really? How <i>gauche</i>."
msgstr "드래곤이라고? 정말로? 아주 <i>어색하군</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 388f3bf3-8be1-2ab4-49ff-9418d12a1fcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:388f3bf3-8be1-2ab4-49ff-9418d12a1fcf
msgctxt "hdb52ad45ga3ebg4a54gac96g60ba25ba8dd4"
msgid "<i>Give an exact description.</i>"
msgstr "<i>정확히 설명해준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 3942ddde-eb82-a3f7-42ec-aa6640c1b7ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Background_Entertainer_Act1_VoloTale(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:3942ddde-eb82-a3f7-42ec-aa6640c1b7ce
msgctxt "h6ca1d1a0g442dg4a80gad49g628965139558"
msgid ""
"Didn't you see the tentacled ship? It was an illithid invasion force - the "
"goblins were being controlled!"
msgstr "그 촉수 달린 함선을 보지 못했나? 그건 일리시드 침략자들이었어. 고블린들이 그들에게 통제당하고 있는 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 3e6c2b54-bc14-41c1-2284-1f69d1f43983
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:3e6c2b54-bc14-41c1-2284-1f69d1f43983
msgctxt "hbbebad31g8d7bg4d9dg952cgaefc6c5cd242"
msgid "I don't think so. I was concentrating on not dying."
msgstr "아닌 것 같아. 나는 죽지 않는 데에 집중하고 있었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 3ff2b767-2ba5-9ab2-ac3a-34e740e50229
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:3ff2b767-2ba5-9ab2-ac3a-34e740e50229
msgctxt "hcd2a7862gb684g4e1egb413g4204a917b8a4"
msgid "Pardon me! Must prepare to travel - good day, my friend!"
msgstr "실례하겠네! 여행 준비를 해야 하네 - 좋은 하루 되시게, 친구여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 41d924c7-06fe-166c-7e84-64d5d897d798
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:41d924c7-06fe-166c-7e84-64d5d897d798
msgctxt "hfb7b5ee6gf21eg4586gb16dgebcf36cdd548"
msgid "I'm not unfamiliar with their kind, certainly."
msgstr "확실히 그들의 종은 익숙해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 4471cda6-47b2-0c7d-294a-29a8d76bd71b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:4471cda6-47b2-0c7d-294a-29a8d76bd71b
msgctxt "had6e5e23g5b9eg4676g9dc0gd2634fb8c0b3"
msgid "My friend, <i>every </i>story benefits from a dragon."
msgstr "친구여, <i>모든 </i>이야기에는 드래곤의 도움이 필요하다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 478800f0-0769-a812-7729-893166563db7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:478800f0-0769-a812-7729-893166563db7
msgctxt "he7935589g04ceg4ab1g8376gae13a59828df"
msgid ""
"Never you mind. Who needs mercy when you've a quick tongue? (And an "
"invisibility potion stashed in your back pocket.)"
msgstr "신경 쓰지 말게. 혀가 빠른데 누가 자비를 필요로 하겠나? (뒷주머니에 투명화 물약도 숨겨놨고.)"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 4830bd22-c82d-4c38-9cde-e25fb8149da1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:4830bd22-c82d-4c38-9cde-e25fb8149da1
msgctxt "h91c4f78dg8563g4d09g8578gb9e319a62d3e"
msgid ""
"'Goblins... struck... fear... and... awe... in... heart... of... wilting... "
"witness...'"
msgstr "'고블린이... 목격자의... 심장에... 공포를... 심음...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Narrator
#. NodeID = 48bf163f-2f0d-f928-bc39-8d9c1d657782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:48bf163f-2f0d-f928-bc39-8d9c1d657782
msgctxt "h41009e28g8c0dg4b24g8387g10796b7400a2"
msgid ""
"*You search your mind, but remember nothing useful about goblin social order "
"or behaviour.*"
msgstr "*당신은 기억을 더듬어보지만, 고블린의 사회 질서나 행동에 대한 유용한 정보는 기억하지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 4d9cdfbd-c2c1-1a29-eefa-7d56891580fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:4d9cdfbd-c2c1-1a29-eefa-7d56891580fc
msgctxt "h2b5ed5d8g1dcag497cg9be1gd7c257c3634c"
msgid "A few questions, if you please. There's no overstating my interest."
msgstr "괜찮다면, 몇 가지 질문을 하고 싶네. 나의 관심은 한도 끝도 없다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 4de449f2-19d9-d8a3-8f07-e6a7e55c4f41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:4de449f2-19d9-d8a3-8f07-e6a7e55c4f41
msgctxt "hea90e50dg33d9g4203g9484g75c04b14b7cf"
msgid "The truth, my friend! Not a jot more or less!"
msgstr "진실이라네, 친구여! 그 이상도 이하도 말고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 52b8f048-551b-cfad-c350-0f3b0b2b9346
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:52b8f048-551b-cfad-c350-0f3b0b2b9346
msgctxt "h6d2b5d8agc048g4cd5g9502g72d568998bbe"
msgid ""
"Whoever this 'Absolute' they're worshipping might be, I'll be the first to "
"write about it."
msgstr "그들이 숭배하는 '절대자'가 누구든, 내가 가장 먼저 글을 쓸 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 551ab2b4-4dad-f5a4-32a6-bf4181fde8e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:551ab2b4-4dad-f5a4-32a6-bf4181fde8e9
msgctxt "h9ff50580g6706g4b2bg82cbg77d6024f3368"
msgid "<i>Hold your tongue.</i>"
msgstr "<i>말을 아낀다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 566f0f9b-bc6e-465f-f9e8-86408df4edbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:566f0f9b-bc6e-465f-f9e8-86408df4edbd
msgctxt "h283d947eg2739g4b9bg91e1g61f5bf51ccb1"
msgid "Goblin superstition - not worth the ink and parchment."
msgstr "고블린 미신 따위는 잉크와 양피지의 가치도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 58958eb8-98a6-4e5f-b2ea-275fcd21b673
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:58958eb8-98a6-4e5f-b2ea-275fcd21b673
msgctxt "h8ae08ff9ge59fg49fcg8236gd045e030214c"
msgid ""
"And there's no overstating my <i>disinterest</i>. I've no time for questions."
msgstr "나의 <i>무관심</i>도 한도 끝도 없다네. 질문이나 받고 있을 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 5909c72a-01cb-9df4-36bc-1d5b2d5bb5ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:5909c72a-01cb-9df4-36bc-1d5b2d5bb5ff
msgctxt "hcfc0e286gbeb7g4867g8344gc9829b3cfd1e"
msgid "Quite so. They sang the phrase like a battle-hymn."
msgstr "그래. 그들은 그 구절을 마치 전투 찬송가처럼 불렀어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 59c86536-e779-43ff-281d-7dbf6c97a0d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:59c86536-e779-43ff-281d-7dbf6c97a0d1
msgctxt "had053394g1b47g44cdgbc9dg67318a0a8f01"
msgid "They were goblins, same as all the others: lowly and vile."
msgstr "그들은 다른 고블린들과 마찬가지였어. 천하고 사악했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 5cedf623-36b5-55c0-db20-8e45f5b714e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:5cedf623-36b5-55c0-db20-8e45f5b714e9
msgctxt "he662becfg2f0bg4cc3g8733g7a021e8817d6"
msgid "Dramatic. How has Maglubiyet responded?"
msgstr "극적이군. 마글루비예트는 어떻게 답했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 64fea284-c051-7f5f-09e2-db1dde47a77c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF or DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:64fea284-c051-7f5f-09e2-db1dde47a77c
msgctxt "h6db5463ag4256g4fdag9287gf7dbd647d621"
msgid ""
"Forgive my surprise. It's rare to find your kind above ground. Rare and "
"intriguing on a day already <i>packed </i>with intrigue!"
msgstr ""
"내 놀람을 용서해 주게. 지상에서 자네 같은 종족을 발견하는 것은 드문 일일세. 가뜩이나 음모로 <i>가득한 </i>날에 희귀하고 "
"흥미진진하군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 66cc8abc-a36b-b2b8-9cff-9ce6ea6e70dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRAGONBORN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:66cc8abc-a36b-b2b8-9cff-9ce6ea6e70dd
msgctxt "h66f930e6g1ffag45a5g8f88g3ebef5ffb291"
msgid ""
"A brass or silver dragon would die a million deaths before allying with "
"goblins."
msgstr "브라스나 실버 드래곤은 고블린과 편을 먹을 바에는 백만 번이라도 죽을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 691bf222-71d1-2507-a27e-792c6b8e5931
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:691bf222-71d1-2507-a27e-792c6b8e5931
msgctxt "h8f083033g6941g4de9g86e9gb58b7cb0c061"
msgid "You seem more familiar with githyanki than most around here."
msgstr "당신은 기스양키에 대해 여기 있는 대부분의 이들보다 익숙한 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 6a2603dd-5ab7-ba64-36a1-79a640613940
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:6a2603dd-5ab7-ba64-36a1-79a640613940
msgctxt "h5e02be88g8757g46e2g8a17g8d4a9214fe12"
msgid "Now I've a few more questions, if you don't mind."
msgstr "아직 질문이 몇 가지 더 있다네. 그대가 개의치 않으면 더 물어보고 싶네만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 6b3a2661-f6da-9871-9eb4-60db885e4db5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = False
#. SetFlags:
#.   Global:
#.     - GLO_Volo_HasMet = True
#.   Object:
#.     - GLO_Volo_HasMet_Personally(1) = True
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:6b3a2661-f6da-9871-9eb4-60db885e4db5
msgctxt "h8934c95bgf68cg46dbg93cfg952f3c34bbcb"
msgid "Can it be? A githyanki? What a delight!"
msgstr "이럴 수가? 기스양키? 이렇게 기쁠 수가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 6b3a2661-f6da-9871-9eb4-60db885e4db5
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = False
#. SetFlags:
#.   Global:
#.     - GLO_Volo_HasMet = True
#.   Object:
#.     - GLO_Volo_HasMet_Personally(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:6b3a2661-f6da-9871-9eb4-60db885e4db5
msgctxt "hf9474932g1f97g4aebg838cg7b097b6c01d1"
msgid "Do my eyes deceive me? A drow? <i>Here?</i>"
msgstr "내 눈이 나를 속이고 있는 건가? 드로우가? <i>여기에?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 6b3a2661-f6da-9871-9eb4-60db885e4db5
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = False
#. SetFlags:
#.   Global:
#.     - GLO_Volo_HasMet = True
#.   Object:
#.     - GLO_Volo_HasMet_Personally(1) = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:6b3a2661-f6da-9871-9eb4-60db885e4db5
msgctxt "hfddf34f1g4e26g4bacga28eg0bed487edf58"
msgid "Do my eyes deceive me? A duergar? <i>Here?</i>"
msgstr "내 눈이 나를 속이고 있는 건가? 듀에르가가? <i>여기에?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 6b3a2661-f6da-9871-9eb4-60db885e4db5
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = False
#. SetFlags:
#.   Global:
#.     - GLO_Volo_HasMet = True
#.   Object:
#.     - GLO_Volo_HasMet_Personally(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:6b3a2661-f6da-9871-9eb4-60db885e4db5
msgctxt "hd9e0cc4eg238fg468dg9989g32f8642f87cb"
msgid "Ah, my good friend!"
msgstr "아, 내 친애하는 친구여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 6ff68b57-95b0-4ce3-be47-1d329eb987ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:6ff68b57-95b0-4ce3-be47-1d329eb987ff
msgctxt "hcf12a97egc654g477dgb6cbg28ad0b398303"
msgid "'Witness... mistook... obvious... silver... dragon... for... brass...'"
msgstr "'목격자는... 명백한... 실버... 드래곤을... 브라스로... 착각함...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 74061306-1bc9-5da6-4fb6-24921641995b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_TalkedToVoloAboutAbsolute(1) = True
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:74061306-1bc9-5da6-4fb6-24921641995b
msgctxt "h800601ddgc517g47d7ga62bgadcdc827acb3"
msgid ""
"I've interrogated one - a captive in this very camp. She reports they've "
"abandoned their god Maglubiyet in favour of someone called 'the Absolute'."
msgstr ""
"나는 바로 이 야영지에서 포로 하나를 심문했네. 그녀는 그들이 자신들의 신인 마글루비예트를 등지고 '절대자'라 불리는 누군가를 섬긴다고 "
"하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 74c6b473-b645-504b-60c8-e97b1a5ce1f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:74c6b473-b645-504b-60c8-e97b1a5ce1f4
msgctxt "hb76de60bgdf97g40e1g90f9gcb664765de85"
msgid "I'll make it very quick, hand to heart."
msgstr "가슴에 손을 얹고, 아주 빠르게 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 75bf56aa-beff-1b33-254e-4adb8d69a489
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:75bf56aa-beff-1b33-254e-4adb8d69a489
msgctxt "hfab9e754g2b04g47f3g87ffg237e64dd48b0"
msgid "Naturally. I wouldn't pry, no matter the temptation. It's just..."
msgstr "물론이오. 아무리 궁금하다 해도 캐물으면 실례니까. 다만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 77437486-c8c7-c780-e9c8-7874ca48ddc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:77437486-c8c7-c780-e9c8-7874ca48ddc1
msgctxt "h68c34cf8gcc65g40e9gb74fge3fe360dbf0f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 77a4ef73-98ce-e385-fd04-095ca36b7f8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:77a4ef73-98ce-e385-fd04-095ca36b7f8e
msgctxt "hf2fe617bg1cbeg42aagaaa4g3c215905a65d"
msgid "A classic raid gang, complete with lasher and smattering of booyahgs."
msgstr "래셔와 몇몇 부야그들로 이루어진 전형적인 습격 갱단이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 785a37c1-01bd-5716-2d17-44e71abae282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:785a37c1-01bd-5716-2d17-44e71abae282
msgctxt "h1a5267f4g2d4bg4023gadc1ga59da2167967"
msgid ""
"'Goblins... were... of... rare... gem-coloured... hue... and... wielded... "
"magic... blowguns...' Right!"
msgstr "'고블린들은... 희귀한... 보석... 빛깔을... 띠었고... 마법... 바람총을... 사용함...' 좋았어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 7866bc2d-4944-1698-4ee1-b1f97470eb1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:7866bc2d-4944-1698-4ee1-b1f97470eb1e
msgctxt "hdcdaa106g69c1g4b97ga649g55884002fdf8"
msgid ""
"You were at the gates just now, no? When the goblins came? You saw them up "
"close?"
msgstr "자넨 방금 전 관문에 있었지? 고블린들이 쳐들어왔을 때, 그들을 가까이서 봤는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 7c797dad-94f0-2125-a6f0-9dcbf95fe902
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:7c797dad-94f0-2125-a6f0-9dcbf95fe902
msgctxt "h4dcedb2ege0c4g4795g8b94ga52d5178fa6d"
msgid ""
"'Witness... believes himself... to be... dragon... possibly... deluded...'"
msgstr "'목격자는... 자신을... 드래곤이라... 믿고 있음... 아마도... 착각한...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 7c797dad-94f0-2125-a6f0-9dcbf95fe902
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:7c797dad-94f0-2125-a6f0-9dcbf95fe902
msgctxt "h4b542f9fg21bcg45b2g8ee4g6d09aaff06a1"
msgid ""
"'Witness... believes herself... to be... dragon... possibly... deluded...'"
msgstr "'목격자는... 자신을... 드래곤이라... 믿고 있음... 아마도... 착각한...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 7c797dad-94f0-2125-a6f0-9dcbf95fe902
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:7c797dad-94f0-2125-a6f0-9dcbf95fe902
msgctxt "h3b5a1514g01deg4095g8188gebe3db0f2948"
msgid ""
"'Witness... believes themselves... to be... dragon... possibly... deluded...'"
msgstr "'목격자는... 자신을... 드래곤이라... 믿고 있음... 아마도... 착각한...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 7d9e4206-6066-efcc-635f-60cfcb480103
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:7d9e4206-6066-efcc-635f-60cfcb480103
msgctxt "hd012e214gdf1eg459dgb39cg3cdcfb090c2c"
msgid "But! He's been quite captured by them already. Ironic, really."
msgstr "하지만! 그는 이미 고블린들에게 완전히 붙잡혔다더군. 참으로 아이러니한 일일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 7eae5520-9fbe-3780-d427-22001bc8754b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:7eae5520-9fbe-3780-d427-22001bc8754b
msgctxt "h708c4fe4gecacg4176g9c08g80e7a7263ae3"
msgid "'Witnesses... failed... to... notice the... obvious... dragon...'"
msgstr "'목격자는... 명백한... 드래곤을... 알아차리지... 못함...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 82148b43-e8fa-452f-fb71-abf4e2e2963f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:82148b43-e8fa-452f-fb71-abf4e2e2963f
msgctxt "h11abc560g7060g47f6g99cfg07515d571eda"
msgid ""
"I myself plan to record the world's most extensive catalogue of their means "
"and habits. A blue ocean of information, I daresay."
msgstr ""
"나는 그들의 방식과 관습에 대해 세계에서 가장 광범위한 일련의 자료를 기록할 계획이네. 가히 정보의 블루 오션이라고 할 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 838d19a2-84c0-32ce-1c4b-982281e8cc29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:838d19a2-84c0-32ce-1c4b-982281e8cc29
msgctxt "hd42e0684gebf3g4da7g816dg2c1b558950b8"
msgid "What I'm doing is none of your concern."
msgstr "내가 뭘 하는지는 당신이 알 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 8da9ddcc-d2dc-2b7c-ce07-acd05bc49d25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_DRACONIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:8da9ddcc-d2dc-2b7c-ce07-acd05bc49d25
msgctxt "he594caf8g5c7dg4d38g8c11ga065b1d900af"
msgid ""
"There's dragon blood in my veins. I'd know if one of my forebears had been "
"there."
msgstr "내 혈관에 드래곤의 피가 흐르고 있어. 내 선조 중 한 명이 그곳에 있었다면 내가 알았을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 91662e43-bbaa-8871-8588-8ad9543cee41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:91662e43-bbaa-8871-8588-8ad9543cee41
msgctxt "h69b7c3c9g5124g4da7g86cagcb97ebbe6269"
msgid ""
"Why, <i>goblins</i>, obviously. Someone ought to chronicle these curious "
"events."
msgstr "왜냐니, 당연히 <i>고블린</i> 때문이지. 누군가는 이 흥미로운 사건들을 연대기로 기록해야 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 924df2f3-2e0c-acd9-fb05-ca6a62886f01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:924df2f3-2e0c-acd9-fb05-ca6a62886f01
msgctxt "h8daf7bd1g8c12g4c44ga53dg3d3d080db90f"
msgid ""
"If I were less educated, I'd presume to ask what you're doing on the Sword "
"Coast."
msgstr "내가 덜 배웠다면, 소드 코스트에서 뭐하고 있는 건지 물어봤을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 94926721-7292-1796-b3df-caddf7092235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:94926721-7292-1796-b3df-caddf7092235
msgctxt "h840ec3ebgd86eg4f04g97c2gac00af652690"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = 94d46206-45b6-daed-66f2-9f7d36ff9abe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:94d46206-45b6-daed-66f2-9f7d36ff9abe
msgctxt "h5527cb7cg23c2g45fag9946ge3852573c78b"
msgid "Then, for your own sake, your education is fortunate indeed."
msgstr "그럼 너 자신을 위해서도, 교육받은 게 참으로 행운이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = 9a6be22e-a8b6-f1cd-2384-07be22a78608
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:9a6be22e-a8b6-f1cd-2384-07be22a78608
msgctxt "h822286fag391dg49f5ga4e6gf62e19a91c03"
msgid ""
"I'm just preparing to head to their camp as we speak. In fact... if you'll "
"excuse me, I ought not to dawdle."
msgstr "나는 방금 말한 대로 그들의 야영지에 갈 준비를 하고 있네. 실은... 실례가 안 된다면... 지체 없이 갈 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = a194974a-6772-bf56-24a2-f76226ba37b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:a194974a-6772-bf56-24a2-f76226ba37b5
msgctxt "h449d151fg1b89g49c6gba97g5144c2dae962"
msgid ""
"Since their change in allegiance, these goblins are informed by a kind of "
"strategy anathema to their kind."
msgstr "충성의 대상을 바꾼 이후 그 고블린들은 동족들로부터 일종의 전략적 파문을 통보받았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = a36dc0c8-c709-af5b-414c-7798a6c7d903
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:a36dc0c8-c709-af5b-414c-7798a6c7d903
msgctxt "he3179702g3788g4d8ag92ddgd63af3c0a28f"
msgid "The time was spent among books. I'm a student of the page."
msgstr "책들 사이에서 시간을 보냈어. 난 책장의 학생이라고 할 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = a6e1025b-c4e9-be25-3639-65bcac18cf23
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:a6e1025b-c4e9-be25-3639-65bcac18cf23
msgctxt "h868a23d2gd81fg421agbaa9g9c2b92c65dcc"
msgid "What do you think Maglubiyet makes of this change?"
msgstr "마글루비예트는 이걸 어떻게 생각할 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = a7f0bd74-3fef-f507-8932-0abe757a429e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:a7f0bd74-3fef-f507-8932-0abe757a429e
msgctxt "h1733cdd1gcb72g4383ga0b3g85d567b73613"
msgid ""
"Ah, but is superstition all? These goblins are informed by a kind of "
"strategy anathema to their kind."
msgstr "아, 과연 미신일 뿐일까? 이 고블린들은 다른 동족들이 이단으로 여길 만한 전략을 따르고 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = aa147113-33c3-3532-ac7d-9ac1b110e71a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_TalkedToVoloAboutAbsolute(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:aa147113-33c3-3532-ac7d-9ac1b110e71a
msgctxt "he3fac378g000bg4ac5gafe5g5da948b2b295"
msgid ""
"To the goblins camped nearby, of course. I've been tracing their doings with "
"great care."
msgstr "물론, 근처의 고블린 야영지로 향해야지. 그들의 행적을 아주 주의 깊게 관찰해 왔다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = aa8afbd4-def6-8e81-5e5e-72656e6f1d31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:aa8afbd4-def6-8e81-5e5e-72656e6f1d31
msgctxt "h71d9b26fg8a4eg497fgbc61gc7fe34875c6b"
msgid "I think there's been a misunderstanding. What do you want, exactly?"
msgstr "오해가 있는 것 같은데. 정확히 원하는 게 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = b0052192-b8cc-e32e-56b5-2ed549e2a3df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:b0052192-b8cc-e32e-56b5-2ed549e2a3df
msgctxt "h39b435b6gd4d8g4600g8774g0499b44e3167"
msgid "A gold dragon! How marvellous."
msgstr "골드 드래곤이라! 아주 멋지군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = b54094b5-31de-49b8-3182-2a4c692550de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:b54094b5-31de-49b8-3182-2a4c692550de
msgctxt "h3c30ef12g9589g406egb43bg927187b8b7d0"
msgid ""
"How would you describe that particular batch of goblins? Size? Nature? "
"Distinguishing qualities?"
msgstr "그 고블린 무리를 어떻게 묘사하겠나? 크기는? 행동 양식은? 눈에 띄는 특징은?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = b5971cc5-31b6-8e7d-f672-e55084f81581
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:b5971cc5-31b6-8e7d-f672-e55084f81581
msgctxt "h03d1d9c4g7458g4344ga72ega4922f2f4a0c"
msgid ""
"I'd heard the master of this place - a druid called Halsin - might be able "
"to point me in the right direction."
msgstr "나는 이 장소의 주인, 할신이라 불리는 드루이드에 대해 들어봤네. 나에게 올바른 방향을 알려줄 수도 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = b9570a63-21fb-3871-04c4-2de3d0b93444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:b9570a63-21fb-3871-04c4-2de3d0b93444
msgctxt "h1d2c5350ga089g4419gb0e5g611f982a0247"
msgid ""
"'Witness... declined... to... comment... on... nature... of... dragon...'"
msgstr "'목격자는... 드래곤에... 대해... 말하길... 거부함...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = bd016b15-6709-120d-43f9-6e55888dfcbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:bd016b15-6709-120d-43f9-6e55888dfcbb
msgctxt "hf92bd543g2ce1g445ag8c8agd3e58c56a41d"
msgid ""
"Far be it from me to pry! Now, as you were saying... <i>lasher... "
"booyahg...</i>"
msgstr "케물을 수 없겠군! 자, 그대가 말하길... <i>래셔... 부야그...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = c745f2c7-eacb-f822-f7a7-ef2f7afb3e29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:c745f2c7-eacb-f822-f7a7-ef2f7afb3e29
msgctxt "h33daed9dgdbfeg4262g9698g8356e8e2c646"
msgid ""
"Last question, then you'll be quite free. Did the attackers rally to 'the "
"Absolute' when they fell upon the gates?"
msgstr "마지막 질문이네. 이것만 끝나면 그대는 자유일세. 공격자들이 성문을 습격했을 때 '절대자'의 이름 아래 모였나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = cc3dad2e-dda6-721e-b2ac-5551324ff64a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:cc3dad2e-dda6-721e-b2ac-5551324ff64a
msgctxt "h69b96a20g7040g4401gb0b9g16f557114c82"
msgid ""
"You're hardly my first, my friend. With a curious mind and a good pair of "
"walking shoes, one makes many an acquaintance."
msgstr "엄밀히 따지자면 기스양키는 이미 보았다네, 친구. 호기심과 튼튼한 신발과 함께라면 많은 사람들을 조우하곤 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = d5d19231-7ed2-5f63-d4c9-e4386a0aa3d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_TalkedToVoloAboutAbsolute(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:d5d19231-7ed2-5f63-d4c9-e4386a0aa3d5
msgctxt "h67d4340egf756g4545g8729g66adad1d9959"
msgid ""
"...I'll tell you, if you'd be so good as to answer a few questions "
"pertaining to the goblins you encountered at the gates."
msgstr "...말해 주겠네. 그대가 성문에서 마주친 고블린에 관한 몇 가지 질문에 대답해줄 만큼 친절하다면 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = d7f08e48-b69d-3548-58b6-600a99e25164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:d7f08e48-b69d-3548-58b6-600a99e25164
msgctxt "hbc8806e2g1d10g4bdcgafdbgd8ff8b9ae636"
msgid "The scandal!"
msgstr "이건 특종이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = d7fe445c-c675-0ccd-7472-7f17c284be9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:d7fe445c-c675-0ccd-7472-7f17c284be9a
msgctxt "ha9dd06ddg3cc6g42e5g9d51g1e5d57c388f8"
msgid "Indeed! Some merciless kin of yours made sure of that, some years ago."
msgstr "그렇지! 그대의 무자비한 동족들이 그걸 확실히 각인시켜 주었다네, 바로 몇 년 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = d8073347-fade-3db7-4145-21b889fa4571
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:d8073347-fade-3db7-4145-21b889fa4571
msgctxt "h12ffa31agfca3g4202g9088g1c0fb7f316f3"
msgid ""
"Though, at present, my curiosity lies elsewhere than the vagaries of the "
"children of Gith."
msgstr "하지만, 지금 내 호기심은 기스의 자식들의 괴팍함보다는 다른 곳에 가 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = d854f1d6-65ea-c176-92e8-cb8b62a4214d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:d854f1d6-65ea-c176-92e8-cb8b62a4214d
msgctxt "hcd1af981g7661g4570g8757gb25e8ec5dc59"
msgid "Yes - they called out the name like a war cry."
msgstr "그래. 마치 전투 함성처럼 그 이름을 외치더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = d99ad34b-5ec7-bd8e-3196-82630aa9322e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:d99ad34b-5ec7-bd8e-3196-82630aa9322e
msgctxt "h84fe11b6g591dg4464g95d2gac70fc3ff3e3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Narrator
#. NodeID = d9cef5b6-5a5b-e01b-da42-d6a6c12d575c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:d9cef5b6-5a5b-e01b-da42-d6a6c12d575c
msgctxt "h9b5e3e53g8cdcg4485ga7d0g42b7f99b747d"
msgid ""
"*You search your mind, successfully recalling various details of goblin "
"behaviour.*"
msgstr "*당신은 기억을 더듬어서, 고블린 행동에 대한 세부사항들을 기억해내는 데 성공합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Lae'zel
#. NodeID = de92e4b1-7988-1a75-3b1c-de836eb2e65b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:de92e4b1-7988-1a75-3b1c-de836eb2e65b
msgctxt "ha6a4b093g4dd2g4db6gb998gd234e2e120d4"
msgid "A myth-weaver. This man has no respect for truth."
msgstr "헛소문 제조기로군. 이 사람은 사실엔 관심이 전혀 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = dea1d866-355b-6b09-66e8-f9607d42cf7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:dea1d866-355b-6b09-66e8-f9607d42cf7e
msgctxt "hf534d71bgc7b8g43c7ga7f3g1f61c81bf7d9"
msgid "Are you drunk or merely stupid?"
msgstr "취한 거야 아니면 단지 멍청한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Player
#. NodeID = ea2c727c-92fb-dcc2-0222-cdf4977def4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:ea2c727c-92fb-dcc2-0222-cdf4977def4e
msgctxt "h7e57024cg3bb7g4eaegb68dgc2f1dba83205"
msgid "I'd rather not say. Are we done here?"
msgstr "말하지 않겠어. 이제 끝났나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = f032c14f-5a61-aa3d-177f-fe99bc022d15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:f032c14f-5a61-aa3d-177f-fe99bc022d15
msgctxt "hb65e6a0cge5d7g43b0ga640g937df8fa295f"
msgid "I, for one, intend to get to the bottom of it."
msgstr "나로서는 그 진상을 파헤치려고 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel
#. Speaker = Volo
#. NodeID = f8c11e7b-fd4e-be50-ff56-06df9d4755ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel:f8c11e7b-fd4e-be50-ff56-06df9d4755ef
msgctxt "h5e055db9g31e3g4c4eg930fgf4d662e51caf"
msgid ""
"Never you mind. I'm on my way to their camp as we speak. I always knew my "
"studies in Ghukliak would come to some use."
msgstr ""
"신경 쓰지 말게. 나는 지금 우리가 말한 고블린들의 야영지에 가려고 하네. 구클리아크에서 공부한 게 언젠가 쓸모가 있을 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = 0a4f10a4-1d02-94ce-9631-da6d04486e67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:0a4f10a4-1d02-94ce-9631-da6d04486e67
msgctxt "hfedf4cc1g5178g441fg8ff6g1aedab3264ee"
msgid "Yes, yes, I see. And is that 'grr' with two 'r's or one?"
msgstr "그래, 그래, 알겠어. 그렇다면 '그르르'에서 '르'가 몇 개인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Bosk
#. NodeID = 0e3246a1-61a8-3f99-e2ea-2aa8a61e6227
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:0e3246a1-61a8-3f99-e2ea-2aa8a61e6227
msgctxt "he80ae759g5fa2g4f04gaaafg80945c49fa84"
msgid "*Roar!*"
msgstr "*으르렁!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = 179c2a7d-8f5c-2cf5-3e9b-b9439bcbcb4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_C = True
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_B = True
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_A = True
#. SetFlags:
#.   Local:
#.     - d16a96e6-8496-879f-8ef3-8228934492e0_C = False
#.     - d16a96e6-8496-879f-8ef3-8228934492e0_B = False
#.     - d16a96e6-8496-879f-8ef3-8228934492e0_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:179c2a7d-8f5c-2cf5-3e9b-b9439bcbcb4a
msgctxt "h3e7bdb57g0497g4f89ga276g7fff24c926b7"
msgid "Would that we could speak freely, my ursine friend!"
msgstr "우리가 자유롭게 말할 수 있으면 좋겠군, 곰 친구여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = 4815ba73-34bc-04a0-f866-81d59df28af8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_C = False
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_B = True
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_A = True
#. SetFlags:
#.   Local:
#.     - d16a96e6-8496-879f-8ef3-8228934492e0_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:4815ba73-34bc-04a0-f866-81d59df28af8
msgctxt "h8708aa55gfa28g489dga78egfceac7181cbb"
msgid "I smell drama amongst these so-called adventurers. What have you heard?"
msgstr "이 자칭 모험가들에게서 대단한 이야깃거리의 냄새가 난다네. 들은 거 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Bosk
#. NodeID = 641c6e5c-4024-8c32-eb37-0aaabdc9e99f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_C = False
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_B = False
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_A = True
#. SetFlags:
#.   Local:
#.     - d16a96e6-8496-879f-8ef3-8228934492e0_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:641c6e5c-4024-8c32-eb37-0aaabdc9e99f
msgctxt "h38d977bcgd1bdg4576g9882ge1866053e2c4"
msgid "*Hrr...*"
msgstr "*흐르르...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = 68eb6558-3ecf-a04b-7f29-284697927759
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:68eb6558-3ecf-a04b-7f29-284697927759
msgctxt "hf1a89ec1gb965g4d3ag9fb1g98127ec951ce"
msgid "Yes... yes I see."
msgstr "그래... 그래 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = 75d6df8a-1190-03fe-0012-2d2bbc70fd0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:75d6df8a-1190-03fe-0012-2d2bbc70fd0c
msgctxt "h2e74aca7gc6b5g4b03gab48g9a0d7e1dea00"
msgid "Keep their confidence, if you insist."
msgstr "정 저들의 비밀을발설하기 싫다면 어쩔 수 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = 7df00401-b93c-79ed-ddb3-39eb4096fab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:7df00401-b93c-79ed-ddb3-39eb4096fab3
msgctxt "hae4df944g6f65g41f6g97f9g78073149fed5"
msgid "Alas, I've never learned to converse with your kind."
msgstr "아아, 난 자네 종족과 대화하는 법을 배운 적이 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = 94ba3db9-3b06-9bc4-8054-4e18f8670340
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:94ba3db9-3b06-9bc4-8054-4e18f8670340
msgctxt "ha87a9894g1c8fg4571ga6b2gdbb5b3c25175"
msgid "Ah, I do wish I could understand you!"
msgstr "아, 내가 자네 말을 이해할 수만 있었어도!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Bosk
#. NodeID = c19d5e88-af52-3d2b-f036-3a58e884acf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:c19d5e88-af52-3d2b-f036-3a58e884acf2
msgctxt "h7d431c94gca29g4ceeg8787g260485fc69b7"
msgid "..."
msgstr "..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Bosk
#. NodeID = cbb348ea-2f37-7672-b280-55f9d88921c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:cbb348ea-2f37-7672-b280-55f9d88921c5
msgctxt "h18585afeg5148g4fb7g8675ga66ebf36122f"
msgid "*Huff!*"
msgstr "*크흥!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Bosk
#. NodeID = dde8efdf-ca8f-7f43-1efc-a26a516f97c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:dde8efdf-ca8f-7f43-1efc-a26a516f97c0
msgctxt "hf25d8e8dg4ae7g4940g876fg22212567ca39"
msgid "*Grr...*"
msgstr "*그르르...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = fe97a860-5a7f-a2e0-ca95-f9679926a941
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:fe97a860-5a7f-a2e0-ca95-f9679926a941
msgctxt "h7f5da343gf959g405ag8654g928991e453f3"
msgid "Yes, I'm quite aware."
msgstr "그래, 나도 잘 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD
#. Speaker = Volo
#. NodeID = ff2a14b7-2ff0-e922-8cf5-b68f5c70e181
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_C = False
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_B = False
#.      - d16a96e6-8496-879f-8ef3-8228934492e0_A = False
#. SetFlags:
#.   Local:
#.     - d16a96e6-8496-879f-8ef3-8228934492e0_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_AD:ff2a14b7-2ff0-e922-8cf5-b68f5c70e181
msgctxt "h1bbffc8dg65ccg431egbe4bg61c3dbbd5272"
msgid "Ah, my grizzled friend! What can you tell me about this place?"
msgstr "아, 우리 털복숭이 친구! 이곳에 대해 알려줄 게 있는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 07c6dd8c-80e7-1fb6-3bf0-5a77e8ea50fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:07c6dd8c-80e7-1fb6-3bf0-5a77e8ea50fe
msgctxt "hcfc39f2cg2d98g414dg800ag4815794ee5c3"
msgid "I. Travelled. A. Long. Way."
msgstr "나는. 먼. 길을. 여행했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 266495a1-7851-55b7-2d69-da64a01ce69c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_VoloTravel_HasMet_Bear(1) = False
#.   Tag:
#.      - HUMAN(2) = True
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_VoloTravel_HasMet_Bear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:266495a1-7851-55b7-2d69-da64a01ce69c
msgctxt "h33eb6b2cgda8eg4c64g97a9g70cef27aab1a"
msgid "Just a moment - this man is recording my story."
msgstr "잠깐만. 이 사람이 내 이야기를 기록하고 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Narrator
#. NodeID = 38d022a9-eb3d-a9a4-41cd-ab94bfb6bce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:38d022a9-eb3d-a9a4-41cd-ab94bfb6bce4
msgctxt "h02b11656g9a56g4291g9f80g6acb40e81fcb"
msgid "*He listens, rapt, hanging on every word.*"
msgstr "*곰은 이야기에 잔뜩 빠져, 한 마디도 놓치지 않고 귀를 기울입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 41c13c1a-ec34-4541-ca51-d32979dff6ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_VoloTravel_HasMet_Bear_PostVolo(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_VoloTravel_HasMet_Bear_PostVolo(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:41c13c1a-ec34-4541-ca51-d32979dff6ab
msgctxt "h4ddb5fd3g539cg470cg8b02g00d0ae11a9f0"
msgid ""
"You're curious - you've got a great many odours about you. What happened to "
"you?"
msgstr "너 참 신기하네. 너한테서 온갖 냄새가 많이 나. 무슨 일 있었어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 437afaf0-dd43-5161-631c-969097dc5469
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:437afaf0-dd43-5161-631c-969097dc5469
msgctxt "h36caeac1g798ag49a8gb0cegb3e6880d753c"
msgid "*Huff!*"
msgstr "*크흥!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 51b01e8a-92e2-595d-3f52-10bfddc64982
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:51b01e8a-92e2-595d-3f52-10bfddc64982
msgctxt "h3ebdd8a9g1d54g4363g8970g9914b763c734"
msgid ""
"That's frightening. I'm glad you made it here. Things are strange right now, "
"but it's no - what did you call it? - Blood War."
msgstr "그거 무섭구만. 여기까지 온 게 다행이야. 지금 상황은 좀 이상하지만, 그래도 그, 뭐랬지? 피의 전쟁만큼은 아니잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = 6dd930fa-61ae-24b4-0c3a-d636f7e01d01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:6dd930fa-61ae-24b4-0c3a-d636f7e01d01
msgctxt "h4c08fb02ge6b2g4f5dg8246g97d147b14c43"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 73983cbf-2424-cd45-6513-ccd3e3ed6450
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:73983cbf-2424-cd45-6513-ccd3e3ed6450
msgctxt "h7330e772g76f6g454dgbff4gfe9045aaa12d"
msgid ""
"You ate... a big orb? Curious. It's best not to overindulge, no matter how "
"delectable the morsel."
msgstr "네가... 큰 보주를 통째로 삼켰다고? 흥미롭네. 아무리 음식이 맛있어도 과식하면 못 써."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 77229c9f-14ac-6622-ef3a-f4e067d5c1b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:77229c9f-14ac-6622-ef3a-f4e067d5c1b7
msgctxt "h8b0f99a6g7bf0g42e4g8331g3192805211e8"
msgid "The city sounds like rot. You're better off right here."
msgstr "듣자하니 도시는 썩은 것 같네. 여기 있는 게 더 낫겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 8469e2e8-030f-45da-949e-9fd178195490
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:8469e2e8-030f-45da-949e-9fd178195490
msgctxt "haf7a33c4g22e8g4c8dgac91g3d85c3ccf73d"
msgid ""
"You've got spirit, doing all that for a goddess. I hope she returns your "
"efforts in kind."
msgstr "그렇게까지 하다니 용기가 대단한걸. 여신님이 네 노력에 보답을 해주셨으면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 89cbbcf8-5dc2-14ef-be26-57716439044b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:89cbbcf8-5dc2-14ef-be26-57716439044b
msgctxt "h1648a521g4efag4271g9f35gd342280e389f"
msgid "I didn't mean to pry."
msgstr "캐물을 생각은 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = 8a3bf1fd-7941-27b3-0ea0-49c4536e260e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:8a3bf1fd-7941-27b3-0ea0-49c4536e260e
msgctxt "hbb5eb44eg76ddg4188gb3bfgb7f839788ac0"
msgid "Selûne's Tears... it must be beautiful to live there."
msgstr "셀루네의 눈물... 거기 살다니, 분명 아름다운 곳이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = a32672ba-2a3e-d4c8-447b-9d2e2f44af47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:a32672ba-2a3e-d4c8-447b-9d2e2f44af47
msgctxt "hb1f0ea99g2f93g4e92gabbaga9bc720cec72"
msgid "You'll learn, boy. Give it some time."
msgstr "시간이 지나면, 자연스레 알게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Narrator
#. NodeID = acf8bd12-c6c4-4564-160d-3aa840d886ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_VoloTravel_HasMet_Bear_PostVolo(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:acf8bd12-c6c4-4564-160d-3aa840d886ff
msgctxt "h2042302cg8bc4g40d8gb280ga7587ba2059b"
msgid ""
"*The bear is preoccupied with a shiny pebble. Your presence goes unnoticed.*"
msgstr "*곰은 반짝이는 조약돌에 정신이 팔려있습니다. 당신의 존재를 눈치채지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = bf305fe9-a11d-357c-073d-64b55d553d74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_VoloTravel_HasMet_Bear(1) = True
#.   Tag:
#.      - HUMAN(2) = True
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:bf305fe9-a11d-357c-073d-64b55d553d74
msgctxt "hcc321126g8b96g49bbgae25gbd9cd6473193"
msgid ""
"Come on... all the druids can understand me, you can - why can't the man "
"with the pen?"
msgstr "정말이지... 드루이드들은 전부 내 말을 이해하거든, 너도 그렇고. 근데 저 필기구 든 남자는 왜 못 알아듣는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Narrator
#. NodeID = c0557c75-3bf0-1c43-2806-2d12b8c25e80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:c0557c75-3bf0-1c43-2806-2d12b8c25e80
msgctxt "h4207dd6ag507cg4b8eg9863ga7634028fdb3"
msgid ""
"*As you near the end of your tale, you see his attention drift as he licks "
"his lips, thinking about something else entirely.*"
msgstr "*이야기가 거의 끝나갈 무렵엔, 곰은 입술을 핥으며 완전 딴 생각을 하느라 집중이 흐트러지는 것이 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = c08a5229-0d29-4937-312e-4cb32db31cd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:c08a5229-0d29-4937-312e-4cb32db31cd9
msgctxt "hffa0f46bg81b9g436eg875fg38d09bbcd278"
msgid "That's a complicated story. I doubt you'd understand."
msgstr "복잡한 이야기야. 이해할 수 있을지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = c5034b47-83a6-ea95-3cf6-caf251d0bab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:c5034b47-83a6-ea95-3cf6-caf251d0bab1
msgctxt "hd3d89159g5790g4feaga681g1d62e179fa56"
msgid "I. Am. Far. From. Home."
msgstr "난. 집에서. 멀리. 떠나왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Bosk
#. NodeID = ccfb403d-006f-0869-4cd4-f530171fc8b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ccfb403d-006f-0869-4cd4-f530171fc8b5
msgctxt "ha23beec6g6881g48b4gbde5g6ed978a7141e"
msgid "That sounds... cold. I'm glad you're here now, in the sun."
msgstr "그것 참... 오싹하네. 이렇게 햇빛 받으며 서있을 수 있어서 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Narrator
#. NodeID = d8da955d-7684-84ea-8150-2491e3072831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:d8da955d-7684-84ea-8150-2491e3072831
msgctxt "hb2fd245cg194cg4e51g9d35g7b455f4a7334"
msgid ""
"*His brow furrows. Incomprehensible squiggles surround a crude sketch: a "
"bear disembowelling a clutch of tieflings.*"
msgstr ""
"*그의 이마에 주름이 잡힙니다. 뭔지 모를 구불구불한 선들이 조잡한 그림을 둘러싸고 있습니다. 곰이 티플링 무리의 내장을 흩뿌리는 "
"모습입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Narrator
#. NodeID = e2ffd758-fef5-29c1-bc69-05919f8051e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:e2ffd758-fef5-29c1-bc69-05919f8051e7
msgctxt "h276b8c67gd1c6g4e58gb0a5g4bb75e606a21"
msgid ""
"*As the colourful man starts scribbling, the bear sneaks a quick look at the "
"page.*"
msgstr "*화려한 복장의 남자가 휘갈기기 시작하자, 곰은 종이를 슬쩍 들여다봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Narrator
#. NodeID = e6045902-e377-686e-d410-85e9066bcf24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:e6045902-e377-686e-d410-85e9066bcf24
msgctxt "h17041492g1807g4d36g85f0gcb0e6199c026"
msgid ""
"*The man nods thoughtfully and adds another dismembered limb to his sketch.*"
msgstr "*남자는 사려깊게 고개를 주억거리며 그림에 잘려나간 팔을 하나 더 추가합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "h53a9707bg628ag4803gbda4g7e187677bda1"
msgid "<i>Tell him your tale - wealth, power, vampires, crypt...</i>"
msgstr "<i>이야기를 들려준다. 부, 권력, 뱀파이어, 지하실...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "h4eab2779gf86bg4d64gaa3agb5c0e9079d6b"
msgid ""
"<i>Speak of discipline, secrecy, reverence - fighting for the glory of your "
"blessed goddess.</i>"
msgstr "<i>규율, 비밀, 존경, 그리고 축복받은 여신님의 영광을 위해 싸우는 일에 대해 이야기한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "h16f6d66ag648bg4d15gbb29ga6e8cb1eb78f"
msgid ""
"<i>Tell him about the horrors of the Blood War and your escape from "
"Avernus.</i>"
msgstr "<i>피의 전쟁이 만든 참혹한 공포와 아베르누스에서 탈출한 일에 대해 이야기한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "hf2e600cbgfbe2g487fg88b2gcc7004ade76a"
msgid ""
"<i>Describe the cold beauty of Crèche K'liir, orbiting high above Toril.</i>"
msgstr "<i>토릴 위를 돌고 있는, 클리르 양성소의 차가운 아름다움을 묘사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "hfa3bd5dcgd5f0g4cc4gb110gb5a7e2b612c3"
msgid "<i>Tell him how you got involved with an angry Netherese orb.</i>"
msgstr "<i>그에게 어쩌다 성난 네더릴 보주와 엮이게 되었는지 말한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "hd419fe96gd8ddg41d5g8d96g4a7be5d31255"
msgid ""
"<i>Speak of Baldur's Gate - and tell  him how your father cast you out.</i>"
msgstr "<i>발더스 게이트에 대해 이야기한다. 아버지가 어떻게 날 쫓아냈는지도.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "h40668f64g6354g4e9agb485gada22d7eafd5"
msgid ""
"<i>Tell him about the intrigues of the Underdark and how you ended up "
"here.</i>"
msgstr "<i>언더다크에서 벌어지는 여러 음모와, 어떻게 여기까지 오게 되었는지를 이야기한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "h0a4a0fb7g1a12g4ca9g817ag52cfa37b5f10"
msgid ""
"<i>Tell him about the treasures and wars of the Underdark and how you ended "
"up here.</i>"
msgstr "<i>언더다크의 보물과 전쟁, 그리고 어떻게 여기까지 왔는지에 대해 이야기한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "hddb12482gd6f7g4c2agb764g2adb8438cafc"
msgid ""
"<i>Tell him about the gems and rocks of the Underdark and how you ended up "
"here.</i>"
msgstr "<i>언더다크의 보석과 바위들, 그리고 어떻게 여기까지 오게 되었는지에 대해 이야기한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "hccdc1315g718fg4345g96aage025d801cdc0"
msgid ""
"<i>Tell him about your crèche and the monsters that snatched you away.</i>"
msgstr "<i>나고 자란 양성소와 당신을 사로잡은 괴물들에 대해 이야기한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear
#. Speaker = Player
#. NodeID = ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
#. HandlePath = TaggedText[10].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_VoloTravel_Bear:ef7e4a9f-932f-cb24-b38b-84ecdd5d2ed8
msgctxt "h7e63b39dg3d41g4089ga2cdg704a5a23d3df"
msgid "<i>Tell him about your journey.</i>"
msgstr "<i>당신의 여행에 대해 이야기한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_AD_GreetingPlayer
#. Speaker = Volo
#. NodeID = 20d50cfc-444d-4089-2028-d4e6c031e48e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_AD_GreetingPlayer:20d50cfc-444d-4089-2028-d4e6c031e48e
msgctxt "h2d1c26d2g6b9eg40d1g896bg6f04cacc83ae"
msgid "You there! Hello!"
msgstr "거기 보게! 안녕하신가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 05c95e69-3841-41f8-9dde-0cb0fe46c98c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:05c95e69-3841-41f8-9dde-0cb0fe46c98c
msgctxt "he339905egc5b7g4557gb22cg7233f2cf93a0"
msgid "Do you have any unfinished business?"
msgstr "아직 마치지 못한 일이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 1179f467-6ca0-4301-a534-a1d35cb3cb91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:1179f467-6ca0-4301-a534-a1d35cb3cb91
msgctxt "h279fe63bg763eg447cga573gb3d3ecd05327"
msgid "Do you have any advice for me?"
msgstr "나에게 해 줄 조언이라도 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 13475bf1-5251-423b-b3a8-bc924b770623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:13475bf1-5251-423b-b3a8-bc924b770623
msgctxt "ha249adbag26c9g44ffg8ef2g728908c4b44e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 150678f5-dfe8-9379-7ad9-87cb28c55d59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b8094afc-e35e-b1e9-5608-2eeb84c0d32e_SaidGlimmering = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:150678f5-dfe8-9379-7ad9-87cb28c55d59
msgctxt "h6efc4f11gbfb8g49b7g996dg95efb1026961"
msgid "'Transforming'? 'Glimmering'? What do you mean?"
msgstr "'변화의 과정'? 빛이 아른거려? 그게 무슨 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = 17d53728-e02e-4f94-9df8-7e66e5d89867
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b8094afc-e35e-b1e9-5608-2eeb84c0d32e_SaidGlimmering = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:17d53728-e02e-4f94-9df8-7e66e5d89867
msgctxt "h3f25d321gef22g4423g880cgcf93ce9c452d"
msgid "Transforming... glimmering..."
msgstr "변화의 과정이오... 빛이 아른거리면서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = 1c2a7f16-34ca-45e7-b888-ddf5bdd4d47e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:1c2a7f16-34ca-45e7-b888-ddf5bdd4d47e
msgctxt "h8ec78955g7278g4602g997fg154cb7de65e4"
msgid "To be heard..."
msgstr "주목 받는 것..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 20d94206-2b3a-489a-8381-e412e3a24af0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:20d94206-2b3a-489a-8381-e412e3a24af0
msgctxt "hab5a51e9g4ccag46d6gbdd0g1b9070b31439"
msgid "What is it like to die?"
msgstr "죽는다는 건 어떤 기분이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 31e35a5e-d7f5-44c4-b3d3-f5c1a9fe1b8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:31e35a5e-d7f5-44c4-b3d3-f5c1a9fe1b8e
msgctxt "h9ba99798g3ee6g4193g941dg34a8d6792818"
msgid "What was your greatest desire in life?"
msgstr "생전에 가장 바라던 게 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = 547cd43b-f4b3-453a-b41e-9e9b5f0d662f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:547cd43b-f4b3-453a-b41e-9e9b5f0d662f
msgctxt "hb1f72a8bg3643g472dg9c98g30ec4ce8aafa"
msgid "Use your voice... always..."
msgstr "항상... 그대의 목소리를 내시오..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 5af6e0a0-3ed8-4d2b-9b38-52b4681c4f51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:5af6e0a0-3ed8-4d2b-9b38-52b4681c4f51
msgctxt "hc98af00ag0f30g4680g9d24gb468076314a0"
msgid "Do you have anything of value?"
msgstr "값어치가 있는 것을 지니고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = 5beccc00-f753-b037-1bfe-72c85bc552cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b8094afc-e35e-b1e9-5608-2eeb84c0d32e_SaidGlimmering = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:5beccc00-f753-b037-1bfe-72c85bc552cd
msgctxt "h88fda4e6ga640g44a5g8af7g72b046fea73c"
msgid "The story... never told. The passing... beautiful..."
msgstr "한번도... 들어 보지 못한... 이야기. 찰나의... 아름다움..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = 7fdfff58-412c-40a8-b96e-5b03e44eb891
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b8094afc-e35e-b1e9-5608-2eeb84c0d32e_AskedAbsolute = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:7fdfff58-412c-40a8-b96e-5b03e44eb891
msgctxt "h34fab60dg1f70g4b7aga9f9g0a7769a7b15b"
msgid "Who is the Absolute?"
msgstr "절대자가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = a8314920-46f8-4c9a-9064-f5af374b0441
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:a8314920-46f8-4c9a-9064-f5af374b0441
msgctxt "hf86771beg071ag4d36g940eg6e56adcc9de4"
msgid "What were you doing here?"
msgstr "여기서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = cee0ad05-67b0-4d82-94aa-bafdb0542da5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b8094afc-e35e-b1e9-5608-2eeb84c0d32e_AskedAbsolute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:cee0ad05-67b0-4d82-94aa-bafdb0542da5
msgctxt "h888aca3fgf2d8g4372g8204g174444150b48"
msgid ""
"Manuscript. Story of... goblins... Absolute. Don't know... how it ends..."
msgstr "원고. 고블린과... 절대자... 이야기. 어떻게 끝나는지... 몰라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = d2eb2b8f-491f-4844-88a9-22d824c1b202
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:d2eb2b8f-491f-4844-88a9-22d824c1b202
msgctxt "h88a6d22fg2723g4bc7g993fg5902d1fd7fc8"
msgid "Volothamp... Geddarm. My mother's... son..."
msgstr "볼로댐프... 게담... 우리 어머니의... 아들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Narrator
#. NodeID = d82b7836-86a3-40dd-bc3b-cc1e100a10fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:d82b7836-86a3-40dd-bc3b-cc1e100a10fc
msgctxt "hd555372eg0817g47ccga33fgd97530340c24"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Narrator
#. NodeID = dc86d7ee-b139-43b2-a139-406797740246
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:dc86d7ee-b139-43b2-a139-406797740246
msgctxt "h12cb2175gd97eg4d82g875cgb9f458a5b6ba"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Player
#. NodeID = e381402a-bd6f-4dce-a69e-27b620d9a14f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:e381402a-bd6f-4dce-a69e-27b620d9a14f
msgctxt "hcb2379dfgd16ag46efg9affg32d035a1d493"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = e7247b32-0c03-4ed1-9aa0-5eb70c9a6104
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b8094afc-e35e-b1e9-5608-2eeb84c0d32e_AskedAbsolute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:e7247b32-0c03-4ed1-9aa0-5eb70c9a6104
msgctxt "h9c5ca87bg7391g4b37ga5f2g7a64db0a6fda"
msgid "Investigating... the Absolute. Goblins'... new god..."
msgstr "절대자를... 조사했어... 고블린의... 새로운 신..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Narrator
#. NodeID = e733de7c-f539-4a71-9817-16b35e983c34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:e733de7c-f539-4a71-9817-16b35e983c34
msgctxt "h6e0a99abg4a70g42d2g8461g0c6c50d89ad5"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = ee7f2861-4dcd-475d-9d9b-68022844e8ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:ee7f2861-4dcd-475d-9d9b-68022844e8ab
msgctxt "hddefa1ebg51ffg4084gb4e5gddf72e6b8f1f"
msgid "Quick mind... silver tongue..."
msgstr "명석한 두뇌와... 뛰어난 말주변..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Narrator
#. NodeID = f00f7553-9197-45cd-b177-8e5174671863
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:f00f7553-9197-45cd-b177-8e5174671863
msgctxt "h8c319f16g2b04g4105ga1bfg11f4f7274211"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead
#. Speaker = Volo
#. NodeID = f7b8f3ec-ee14-48ae-9584-4be7f3862684
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Volo_Dead:f7b8f3ec-ee14-48ae-9584-4be7f3862684
msgctxt "h20eb65b7ga56bg4c0cg9c73g2cff05d6fb96"
msgid "Unreal god... unheard of... spread like a plague..."
msgstr "역병처럼 퍼져 나가는... 들어본 적 없는... 가짜 신..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_AD
#. Speaker = Dammon
#. NodeID = 763b8f85-8854-a9dd-3606-c79c3918d8ba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 85cdcae0-20b0-6753-5b7a-37cd82e6db17_b = False
#.     - 85cdcae0-20b0-6753-5b7a-37cd82e6db17_a = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_AD:763b8f85-8854-a9dd-3606-c79c3918d8ba
msgctxt "h0aab0512ga376g499dga94eg9070080a7d77"
msgid "*Sigh.* I miss my forge."
msgstr "*하아.* 내 대장간이 그리워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_AD
#. Speaker = Dammon
#. NodeID = cc03e2d4-2d61-d899-ee3e-f93f17a4c815
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 85cdcae0-20b0-6753-5b7a-37cd82e6db17_a = False
#. SetFlags:
#.   Local:
#.     - 85cdcae0-20b0-6753-5b7a-37cd82e6db17_a = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_AD:cc03e2d4-2d61-d899-ee3e-f93f17a4c815
msgctxt "h631436d5g6593g4a10g9d37g328f4aa45283"
msgid "Hells take me. What I wouldn't do for better tools."
msgstr "지옥에 떨어질. 제대로 된 도구만 있다면 뭐든 할 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_AD
#. Speaker = Dammon
#. NodeID = ea27a767-32d0-7f1b-5075-ef7039b2afbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 85cdcae0-20b0-6753-5b7a-37cd82e6db17_b = False
#.      - 85cdcae0-20b0-6753-5b7a-37cd82e6db17_a = True
#. SetFlags:
#.   Local:
#.     - 85cdcae0-20b0-6753-5b7a-37cd82e6db17_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_AD:ea27a767-32d0-7f1b-5075-ef7039b2afbb
msgctxt "hfbd680dag3e3ag4e00g90d8g857e421a28ec"
msgid "Damned druids. Who uses wooden tools?"
msgstr "망할 드루이드 놈들. 나무 도구 따윌 누가 써?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 08107c80-1912-4ad9-a3ed-f7d72b247351
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Weaponsmith_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:08107c80-1912-4ad9-a3ed-f7d72b247351
msgctxt "h06564fabg927dg412dg8be3gb697b5eb2b9d"
msgid "I'm packing for Baldur's Gate, but anything you need? You've got it."
msgstr "발더스 게이트로 갈 짐을 싸고 있긴 한데, 필요한 물건 있나요? 다 가지고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 15550f45-407f-47b0-a8fe-316ef45f87c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:15550f45-407f-47b0-a8fe-316ef45f87c5
msgctxt "h60dbb8f0g6c26g4999g85e1gc4cb3ff8ef10"
msgid ""
"My selection's pretty slim. I had to leave most of my equipment in Elturel."
msgstr "판매 물품은 별로 없어요. 엘투렐에 제 장비 대부분을 두고 왔거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = 18c190e5-1285-4806-8903-ba1c8b4228b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:18c190e5-1285-4806-8903-ba1c8b4228b3
msgctxt "hc7156c2dg068eg4e9dga5e1geef92d88ce32"
msgid "Let me see your wares."
msgstr "뭘 파는지 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 2fdafada-d21e-4186-b9d2-2dcb1bc03105
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_DammonWorkedInHell = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:2fdafada-d21e-4186-b9d2-2dcb1bc03105
msgctxt "he35e8232g3546g440bg9bd8gb476bd6012cf"
msgid ""
"Learned a lot in my time in the Hells. Hope to forget most of it, but "
"between you and me, there's nothing in all the realms like the utter power "
"of infernal machinery."
msgstr ""
"지옥에서 사는 동안 많은 걸 배웠죠. 대부분은 잊고 싶은 기억이지만, 우리끼리니까 하는 얘긴데, 지옥 기계장치의 순수한 힘과 비교될 만한 "
"건 온 세상을 통틀어도 없답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 386fed62-7292-061f-6f83-56ffbd1271df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:386fed62-7292-061f-6f83-56ffbd1271df
msgctxt "h133c675ag3b39g4650g9211gc50972ac764d"
msgid ""
"Hold on to it for now. I haven't quite worked out a schematic for a new "
"design. Might take me a bit of crunching to figure out something suitable... "
"if it can even be done."
msgstr ""
"일단은 잘 간수하도록 해요. 새로운 설계도를 구상 중이거든요. 제대로 만들어 내려면 시간이 제법 걸릴지도... 물론, 완성할 수 있다면 "
"말이지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 3dc5a4b7-7b23-b7a2-91ee-fdfe52129982
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:3dc5a4b7-7b23-b7a2-91ee-fdfe52129982
msgctxt "he58c5b8fga672g4d30gbe48gbcc437a85f44"
msgid ""
"But it's my top priority, believe me. Anything to take my mind off, well, "
"<i>everything</i>."
msgstr "좌우간 최대한 서두를 생각이니 염려 마세요. 어딘가에 몰두하면 <i>근심 걱정</i>도 몰아낼 수 있겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 42283841-cc81-467a-98bd-7af4d6c61154
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Weaponsmith_HasMet(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = False
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:42283841-cc81-467a-98bd-7af4d6c61154
msgctxt "h7a8a5badg8d02g4572gbab2g84973f2c3fe6"
msgid "Looking for steel? I have... well, something close."
msgstr "강철이 필요하신가요? 제게... 뭐, 비슷한 건 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = 50f802cd-5043-468b-b6ca-f1ca3361f6d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Weaponsmith_Knows_Elturel(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:50f802cd-5043-468b-b6ca-f1ca3361f6d0
msgctxt "hc6222151gf44fg4851g92d0g0a304ffa6885"
msgid "That forge is holding on by a thread. Are you a smith?"
msgstr "대장간이 겨우 버티고 있는 것 같은데. 대장장이인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 70cb672b-bab6-5d97-a53b-a7e22c693640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:70cb672b-bab6-5d97-a53b-a7e22c693640
msgctxt "h93fb9259g7c58g4135gaf8fg876d99c9cde9"
msgid "Alas - my offerings are far more humble these days."
msgstr "휴우, 요즘에는 훨씬 초라한 물건만 만들고 있네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 7c094b32-3020-405c-8d11-386ab7cac5ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Weaponsmith_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Weaponsmith_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:7c094b32-3020-405c-8d11-386ab7cac5ad
msgctxt "hf64de210geb9bg44d0g8595gb229671abb42"
msgid ""
"Thanks for fighting off those goblins. If you need to replace any gear, just "
"ask."
msgstr "고블린들을 물리쳐 줘서 감사합니다. 장비를 바꿀 일이 있다면, 언제든 말만 하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 95cba5e5-4a81-4132-a4a4-0f171a5259dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:95cba5e5-4a81-4132-a4a4-0f171a5259dc
msgctxt "hb0c8d544g0d6cg4debgafc8g1952683eabb5"
msgid "Might have to teach the rest of us that trick, then."
msgstr "그렇다면 우리들에게도 그 기술 좀 가르쳐주시면 좋겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = c1be2ab9-d319-4486-a8ee-aec63a4e6dde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:c1be2ab9-d319-4486-a8ee-aec63a4e6dde
msgctxt "hbe550f51gf886g4eb1gabc4gd668ce65f21a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = e25a6dfb-e660-4982-a98a-58cb08c3e75a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:e25a6dfb-e660-4982-a98a-58cb08c3e75a
msgctxt "hfaf75975g7d84g4172ga63cg95d0b73a0c85"
msgid "I was trained to fight bare-handed. Not really one for weapons."
msgstr "난 맨손으로 싸우는 법을 배웠지. 무기를 쓰는 법은 잘 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = effcabca-3339-39fc-b783-28a3dfdffe38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachUpgraded = True
#.   Object:
#.      - GLO_ForgingOfTheHeart_State_HasInfernalMetal_A(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:effcabca-3339-39fc-b783-28a3dfdffe38
msgctxt "h88d504a6gdb6dg485ega268gdef477c15379"
msgid "I found another piece of infernal iron - can you make another upgrade?"
msgstr "지옥 철을 하나 더 찾았어. 추가 작업을 부탁해도 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = fa19312e-359b-44fb-a4ca-4264d95e5a4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Weaponsmith_Knows_Elturel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:fa19312e-359b-44fb-a4ca-4264d95e5a4a
msgctxt "hcbfd5d98gd688g4fdbgbf44g03856433135c"
msgid ""
"Of sorts. Used to be a bread-and-butter tinsmith before Elturel fell into "
"Avernus. These days my talents are more... eclectic."
msgstr "그런 셈이죠. 엘투렐이 아베르누스로 떨어지기 전에는 생계형 양철공이었습니다. 요즘엔 제 재능이 좀 더... 다채로워졌지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = fa2dd2ca-1c94-4bd3-ab2b-32025667a60c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Weaponsmith_PostEA:fa2dd2ca-1c94-4bd3-ab2b-32025667a60c
msgctxt "h4ef31774g2ae3g4267g9812gc28150696f4c"
msgid ""
"Expect half these blades will break the first time they strike a goblin "
"skull. I've had to make do with what I could scavenge."
msgstr "고블린 두개골에 닿자마자 절반 이상의 검이 부서질 거예요. 급한 대로 고철들을 긁어모아 모양이라도 내야 했거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = 01161b92-f0d1-a825-30cd-2b08e863a4a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_WeepingTree_HasMet_Bear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:01161b92-f0d1-a825-30cd-2b08e863a4a9
msgctxt "hc2d208f1g418eg481ag9565g53c95fc0f565"
msgid "He didn't come back, did he? His smell is gone. He's gone..."
msgstr "그는 안 돌아오는 거지? 냄새가 사라졌어. 영영 안 돌아와..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = 06ae3927-8f3a-91bf-30b3-bd3a0d5f85a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:06ae3927-8f3a-91bf-30b3-bd3a0d5f85a7
msgctxt "h67bcf094g7096g41c2gbdbbg13c0e1951920"
msgid "No... it can't be! He wouldn't. Even... even with all the monsters..."
msgstr "아니야... 그럴 리가 없어! 아무리... 아무리 그 괴물들이 많아도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = 0eb53897-c8ff-fd7d-edff-37db415cd488
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_ZenBear_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:0eb53897-c8ff-fd7d-edff-37db415cd488
msgctxt "h25e7b8d9g1e69g4b6dg9f5dg539f72f83f95"
msgid "He's back! You brought him back!"
msgstr "돌아왔어! 네가 도와준 덕분에!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Player
#. NodeID = 42b073da-ea00-fba7-d739-1c35f17b235d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:42b073da-ea00-fba7-d739-1c35f17b235d
msgctxt "h61cffa95gd782g4902g8c5bg771ff52d29f7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Player
#. NodeID = 521c0401-3773-741e-fe31-9b527ea39cd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:521c0401-3773-741e-fe31-9b527ea39cd5
msgctxt "ha96d3570g0d22g4159g81c6g6ee50c6add21"
msgid "You look strong. Why not go after him?"
msgstr "넌 강해 보이는데. 직접 가서 찾아보는 게 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = 58600f35-fb53-654d-db86-17547da2c715
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_WeepingTree_HasMet_Bear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:58600f35-fb53-654d-db86-17547da2c715
msgctxt "h7fea16b0g652fg4123g88d6g7d3832608140"
msgid "Still nothing... still nothing..."
msgstr "아직도 없어... 아직도 없어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Player
#. NodeID = 5991c279-a384-8d4b-e965-0d0136c2a968
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:5991c279-a384-8d4b-e965-0d0136c2a968
msgctxt "h8ea57c5eg79b5g4500g9e85gb297f1a51825"
msgid "Sounds like he's dead."
msgstr "아무래도 죽은 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = 785f8b8a-b9fa-a614-a209-4cfa8023e596
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:785f8b8a-b9fa-a614-a209-4cfa8023e596
msgctxt "heb9a4ffeg04e3g4a4eg9b9cgcc3ebb125fb7"
msgid ""
"No... the woods have gone dark. There's too many predators lately - even for "
"Master."
msgstr "아냐... 이 숲은 어둠에 빠졌어. 요즘 포식자들이 너무 많아. 마스터도 그 대상이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = 7ee47c84-0d1b-debe-43dd-1c64aff36210
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:7ee47c84-0d1b-debe-43dd-1c64aff36210
msgctxt "hc0bbfe1eg70f1g463eg8eebgda293bffbe71"
msgid ""
"But I can smell them - the weaponed ones. And I cannot smell him... he's not "
"coming back..."
msgstr "난 무기를 지닌 자들의 냄새를 맡을 수 있어. 그런데 그의 냄새는 안 느껴져... 돌아오지 않을 건가 봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = a146a6f1-efd2-e33b-b03b-3a8052af3e36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:a146a6f1-efd2-e33b-b03b-3a8052af3e36
msgctxt "ha6b430aeg9229g4722ga47cga6a929a170e9"
msgid "...Then leave."
msgstr "...그럼 저리 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Narrator
#. NodeID = b5abe37e-0b97-a7fe-7dae-dc6344e7c2f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_WeepingTree_Bear_Upset = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:b5abe37e-0b97-a7fe-7dae-dc6344e7c2f5
msgctxt "h2665c5a6gd98fg4968g8707g087500c553a0"
msgid "*The bear whines, lonely and afraid.*"
msgstr "*곰은 겁을 먹고 외로이 낑낑거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = c05e9f5c-2b92-58b8-82f6-b4080d1f8672
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_WeepingTree_Bear_Upset = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:c05e9f5c-2b92-58b8-82f6-b4080d1f8672
msgctxt "h2a514372g6d0ag4ac0ga9eegf0720c857a11"
msgid "He's gone... you were right, he's gone. His scent is growing fainter."
msgstr "정말로 죽었구나... 네 말대로야. 그의 체취가 갈수록 옅어져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = c155ddd8-f5c8-b36a-3dfd-0d22e052b005
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:c155ddd8-f5c8-b36a-3dfd-0d22e052b005
msgctxt "h597bbc84gfde8g47abga0b6ga21dfe0646d7"
msgid ""
"No... the woods have gone dark. There's too many predators lately - and I "
"was never the strong one."
msgstr "아냐... 이 숲은 어둠에 빠졌어. 요즘 포식자들이 너무 많아. 난 결코 강한 존재가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Player
#. NodeID = c2f0d419-8ee6-8a52-3992-d87edfe7bf3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:c2f0d419-8ee6-8a52-3992-d87edfe7bf3c
msgctxt "h487083b2g796ag48d4ga25egc5ac0eaed341"
msgid "Who are you looking for?"
msgstr "누구를 찾고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = d0f91371-87ab-1cb9-70dd-c6a7d8d80b9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:d0f91371-87ab-1cb9-70dd-c6a7d8d80b9a
msgctxt "h21a238b2g140dg4347g97efgc73583e61f8e"
msgid "*Moan.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Player
#. NodeID = e0dd5773-239a-ba47-129c-923451a38ba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:e0dd5773-239a-ba47-129c-923451a38ba8
msgctxt "h17b4cff2g2e3cg4e6egb3c0g314638a1e266"
msgid "Don't worry - he'll be back."
msgstr "걱정 마. 그는 돌아올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Ormn
#. NodeID = e13c1947-b188-16a3-978d-dccaba8ff13d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:e13c1947-b188-16a3-978d-dccaba8ff13d
#, fuzzy
msgctxt "h74889856ga8afg494agb49dga467a2535f0e"
msgid "Master. He left with the weaponed two-legs. He said he'd be back."
msgstr "마스터 말이야. 그는 무기를 든 두 발 달린 것과 떠났어. 돌아오겠다고 말했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear
#. Speaker = Player
#. NodeID = f1fcda8c-20de-3208-bb0f-f7a4291ba447
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WeepingTree_Bear:f1fcda8c-20de-3208-bb0f-f7a4291ba447
msgctxt "h0cb0772bg2a3eg46e6ga0e1gd82ebfe32c74"
msgid "You're the saddest bear I've ever seen. This is depressing."
msgstr "내가 본 곰 중에서 가장 슬픈 곰이네. 나도 우울해질 지경이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = 02f4f9ad-14f9-b838-daa7-f0bb95fc3690
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:02f4f9ad-14f9-b838-daa7-f0bb95fc3690
msgctxt "h80b088e1ga932g4a25gb82agc1b11d7224c9"
msgid "Grind your feet into the ground. Really lock 'em in."
msgstr "발에 힘 딱 주고 땅 위에 서 있으렴. 아주 단단히 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = 0ae1e746-94f4-1466-c707-aa519713c4cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:0ae1e746-94f4-1466-c707-aa519713c4cb
msgctxt "he7df8b97g7ba6g4101g911bg966d3ceb9ebb"
msgid "Now hold the left arm across your face - and jab with the right."
msgstr "이제 왼팔로 얼굴을 막고 오른손으로 잽싸게 찔러."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 0c4dff8a-01b5-4923-8bd9-64dfae21e32e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:0c4dff8a-01b5-4923-8bd9-64dfae21e32e
msgctxt "hc5fe6ef7ga04fg434eg9b7cgbfb7c3e70460"
msgid "Yah! Yah!"
msgstr "이얏! 이얏!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 2ef28ab8-85a4-1e0a-bb78-a296120af029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1f335eb8-71e7-bde6-4209-70d764e90704_BladeOfFrontiers = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:2ef28ab8-85a4-1e0a-bb78-a296120af029
msgctxt "h0ee4b394g76e9g48dcg9da1g2f85ad0fc8c1"
msgid "How many goblins have you fought?"
msgstr "고블린하고 얼마나 많이 싸워 봤어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 4a493601-c026-0f53-6579-96a7c1b2fb84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:4a493601-c026-0f53-6579-96a7c1b2fb84
msgctxt "h9f98ec4fgfff2g49bagb539g2a269f956208"
msgid "That's not true."
msgstr "에이, 거짓말!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 51d30dca-bfd7-7d54-4dd9-2252802b6c28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:51d30dca-bfd7-7d54-4dd9-2252802b6c28
msgctxt "h245a7b30g069fg4b88g8da6gca1386557b05"
msgid "Let me try! Yah!"
msgstr "제가 해 볼게요! 이얏!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 5a6abe16-f0ed-9301-8d5e-27903d2ac6c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:5a6abe16-f0ed-9301-8d5e-27903d2ac6c7
msgctxt "hfbf10d02g2150g4447g8038g5a99f663dac3"
msgid "I'm trying, I'm trying."
msgstr "하고 있어요. 하고 있다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = 63a46d7e-67f1-7231-3a88-1401e6c7e404
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:63a46d7e-67f1-7231-3a88-1401e6c7e404
msgctxt "h32a5e403g4d1eg4108g870fg9c3b365ebef7"
msgid ""
"A bard started calling me that after I'd saved him from gnolls, and the name "
"stuck!"
msgstr "전에 놀 떼한테서 구해줬던 바드가 붙여준 이름이란다. 그때부터 그렇게 불렸지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Ide
#. NodeID = 6750afab-6d29-6c56-fd53-3f7b93e04005
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:6750afab-6d29-6c56-fd53-3f7b93e04005
msgctxt "h98246d11g44e0g4254gb006g59b6dd2a103b"
msgid "All right. Now what?"
msgstr "했어요. 그리고요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Ide
#. NodeID = 6cd132bc-bed1-9b11-2e61-664b586c5baf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:6cd132bc-bed1-9b11-2e61-664b586c5baf
msgctxt "h4c63f8c1gdfd3g46efg885cg83361dba9656"
msgid "Like this? Yah! Yah!"
msgstr "이렇게요? 이얏! 이얏!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = 84f5204a-4c08-24ef-ea5c-15f97d271528
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:84f5204a-4c08-24ef-ea5c-15f97d271528
msgctxt "h2015f5ecg5040g4e1cg8c51ge31301b6eb5c"
msgid "Almost there. Keep your hips square, and I think you'll have it."
msgstr "잘하고 있어. 골반을 곧게 유지해. 너희라면 할 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 8caf4a6d-c2a7-6e3c-ca8f-e661b4447d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:8caf4a6d-c2a7-6e3c-ca8f-e661b4447d2d
msgctxt "h7b788b4bgd49bg4b77g8ee1gebaa7085ad72"
msgid "And that's the best name they could think up?"
msgstr "작명 감각이 그게 최선이었대요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = 8dbf775c-fde0-e7b9-92cc-e6a49be696a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1f335eb8-71e7-bde6-4209-70d764e90704_BladeOfFrontiers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:8dbf775c-fde0-e7b9-92cc-e6a49be696a7
msgctxt "hd8266f5bgcdfdg4674gb2dbg912abffe60ac"
msgid "As many as there are stars in the sky."
msgstr "밤하늘에 뜬 별의 수만큼이나 싸웠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = 948b8eca-ed49-2289-fdfa-48b103c20a53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:948b8eca-ed49-2289-fdfa-48b103c20a53
msgctxt "h6708d272g669eg42d9ga790g69f8403a32f1"
msgid "Almost there. Keep your hips square, and I think you'll have it!"
msgstr "잘하고 있어. 골반을 곧게 유지해. 너라면 할 수 있을 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = a35e5151-72d4-dfde-d85f-b1754d9c85f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:a35e5151-72d4-dfde-d85f-b1754d9c85f4
msgctxt "hff93b7aeg47eeg4670g8313g91dda186c90e"
msgid "As true as mithral, kid."
msgstr "미스랄에 걸고 사실이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = b04f3507-91ba-1ab6-f5c2-30d13e3f6414
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:b04f3507-91ba-1ab6-f5c2-30d13e3f6414
msgctxt "h77214eddge39eg40b5gba00g412b0b458493"
msgid "Head up high, kid. To fight your enemy, you need to see 'em."
msgstr "고개 들어라, 얘야. 적과 싸우려면 상대를 똑바로 봐야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = be84b09e-8d03-26fb-8c5e-8155f3a34e49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1f335eb8-71e7-bde6-4209-70d764e90704_BladeOfFrontiers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:be84b09e-8d03-26fb-8c5e-8155f3a34e49
msgctxt "h2d861c64g4a69g4f20ga95ag79d1953fc9cf"
msgid "How'd you become the Blade of Frontiers?"
msgstr "어떻게 변경의 칼날이라 불리게 됐어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = e05f4403-f2a7-ce30-baa6-ad5c6554cfca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:e05f4403-f2a7-ce30-baa6-ad5c6554cfca
msgctxt "h6e908d64g96a8g4f93g8a52g0a11e66577f9"
msgid "Better."
msgstr "더 낫구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Ide
#. NodeID = ef95e5a7-1c65-41b3-1f68-4fd5cae52634
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:ef95e5a7-1c65-41b3-1f68-4fd5cae52634
msgctxt "h49cd4d74gb765g487ag90adg1af5035fd688"
msgid "Yah!"
msgstr "이얏!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses
#. Speaker = Wyll
#. NodeID = fe16b4fe-7b2e-4628-96f5-3439c73da0a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee1Responses:fe16b4fe-7b2e-4628-96f5-3439c73da0a5
msgctxt "h311dad51g3514g43degaf16ge822bf16c690"
msgid "Head up high, kid. To fight your enemy, you need to see 'em."
msgstr "고개 들어라, 얘야. 적과 싸우려면 상대를 똑바로 봐야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Wyll
#. NodeID = 02834a96-abc1-d0e2-30e1-4a7cf13ace40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:02834a96-abc1-d0e2-30e1-4a7cf13ace40
msgctxt "hb6c573d5gc9c1g4fb6g88abg6c6db927996d"
msgid "Pretty good, pretty good."
msgstr "제법인걸. 꽤 괜찮네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Wyll
#. NodeID = 12758791-414b-7af5-5b7a-3e2bde14168a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:12758791-414b-7af5-5b7a-3e2bde14168a
msgctxt "hf8415b95gdb57g4456g9afegefb4e7210ded"
msgid "Now try ducking after the first swing."
msgstr "이제 먼저 베기를 한 다음 몸을 숙여 피해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = 234effce-dedd-1a56-021e-66cebaaff8fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:234effce-dedd-1a56-021e-66cebaaff8fe
msgctxt "h214907c6g2abcg4ddfg8030gee1b702a18f2"
msgid "Swing, duck, and... swing!"
msgstr "베고, 피하고, 다시... 베기!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Wyll
#. NodeID = 3770aec9-b30c-36bf-d477-3686cd7f19ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:3770aec9-b30c-36bf-d477-3686cd7f19ff
msgctxt "h57364274ge58fg45d0g892ag8e14b332421b"
msgid "Good try. But don't just swing all pell-mell."
msgstr "시도는 좋았어. 하지만 그냥 막 휘둘러선 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = 3f0d4673-d42f-9260-1eb1-41d1debb94c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:3f0d4673-d42f-9260-1eb1-41d1debb94c4
msgctxt "hf674da3ag79a4g4b1fga330g255c4b8980fc"
msgid "Swing, and... swing!"
msgstr "베고, 다시... 베기!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = 569c21a4-5076-a7f5-7b68-6abd826e1692
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:569c21a4-5076-a7f5-7b68-6abd826e1692
msgctxt "h53e7a0fdg0399g48a6g83b5g82dfb6342b60"
msgid "How long before I can fight a real goblin?"
msgstr "진짜 고블린이랑은 언제 싸울 수 있어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Wyll
#. NodeID = 830fe606-a642-0f03-d243-4784e2c1bb8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:830fe606-a642-0f03-d243-4784e2c1bb8b
msgctxt "h59d9881eg809eg48c4gb089g979ca66455f1"
msgid "Swing, count a beat, and swing again."
msgstr "베고, 한 박자 쉬고, 다시 베는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = bc691484-caf1-3108-c2ea-8a13b84caba2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:bc691484-caf1-3108-c2ea-8a13b84caba2
msgctxt "h943ad4f3gca4bg4cafgb67bg45b81c65d486"
msgid "Lower. Bend at your knees, not your waist."
msgstr "더 낮게. 손목이 아니라 무릎을 구부리기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses
#. Speaker = Wyll
#. NodeID = be2b4296-f579-4bb8-063e-e3549cdd5ecb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee2Responses:be2b4296-f579-4bb8-063e-e3549cdd5ecb
msgctxt "h68a133acg327eg4358g832egf10c1eeea82b"
msgid "Don't get ahead of yourself. You can't even hold a real sword yet."
msgstr "너무 앞서가지 말거라. 아직 진짜 검도 못 쥐어 봤잖니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 00207f1f-8e60-75f7-b1a4-4b0150293dd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:00207f1f-8e60-75f7-b1a4-4b0150293dd4
msgctxt "h5c76bcaegbe99g4fe1gb0f8gec0e3d5eab11"
msgid "Those goblins don't stand a chance."
msgstr "고블린 놈들, 맥도 못 추겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 0b4e85c7-0f7e-36d3-1df3-53def357341e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:0b4e85c7-0f7e-36d3-1df3-53def357341e
msgctxt "ha2930b70g1030g46beg91acg41cc3a421584"
msgid "It's too hard..."
msgstr "너무 어려운데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 0fb8b73d-28aa-6fec-b0b7-a3b1c4612d2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:0fb8b73d-28aa-6fec-b0b7-a3b1c4612d2f
msgctxt "h71604524g0665g4ee5gbbfagc64bb8666840"
msgid "Co-what-er-ate?"
msgstr "혀-업-력?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 164f1cf3-731e-6290-4aa7-2e2925116e4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:164f1cf3-731e-6290-4aa7-2e2925116e4c
msgctxt "hb60ecb12g372fg40ebg83bbg89eac91b7599"
msgid "Nngh... WHACK!"
msgstr "끄응... 이얍!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 213dfaca-7506-2053-b3c9-41df63e87aec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:213dfaca-7506-2053-b3c9-41df63e87aec
msgctxt "h247dbcd1gd803g43b2ga4d9g5360128924c7"
msgid "Children."
msgstr "얘들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 2b03a06f-9e9b-3c6a-e4b3-fecf51e8f866
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:2b03a06f-9e9b-3c6a-e4b3-fecf51e8f866
msgctxt "h453afd9agca4bg4b6dgbdeagc42baf4fc430"
msgid "I said it first!"
msgstr "내가 먼저 말했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 2c33ee10-a5d4-55ed-fde5-9e9a161d9292
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:2c33ee10-a5d4-55ed-fde5-9e9a161d9292
msgctxt "h3a2056f1gfefdg457dgb9d6g0d43bc0c2706"
msgid "<i>Goblinbane.</i>"
msgstr "<i>고블린파멸.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 3266e291-4827-2772-3cea-0b90b0ad5367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:3266e291-4827-2772-3cea-0b90b0ad5367
msgctxt "h6b1f4d9ege587g4ad1g87b6gc7ecbc360e08"
msgid "You can do it. Just have to believe!"
msgstr "할 수 있어. 자신을 믿기만 하면 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 46d8a575-14d3-2b2a-8057-dc5e8fb6a695
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:46d8a575-14d3-2b2a-8057-dc5e8fb6a695
msgctxt "h0348aef9g2c34g4f6dgae90gea1f02a2e324"
msgid "You got it!"
msgstr "그거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 49c97da1-39c5-abed-1104-9d7d3dd02ad8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:49c97da1-39c5-abed-1104-9d7d3dd02ad8
msgctxt "h613ccc63g1d57g4dabg96ebg19baa31e43bc"
msgid "Ahah!"
msgstr "이얍!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 56010f21-395f-4c82-3f73-f3ef6db4a932
#. HandlePath = TaggedText[0].TagText[0]
