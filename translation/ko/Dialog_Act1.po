msgctxt "h512263cfgabaeg430cg825ag9d5ff1933adb"
msgid "*The chains snap as you expand your chest.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains
#. Speaker = Player
#. NodeID = cbb0e514-3ba2-2c4e-d4e8-c5165f9f023f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains:cbb0e514-3ba2-2c4e-d4e8-c5165f9f023f
msgctxt "hac4ba490g56a7g427dg8585g3384ac30a9a8"
msgid "<i>Dislocate your wrist and wriggle free.</i>"
msgstr "<i>손목을 탈구시키고 꼼지락거려서 풀려난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains
#. Speaker = Narrator
#. NodeID = d7a401ac-26d3-266a-b9cb-e70da196976c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_ChainsFailed(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains:d7a401ac-26d3-266a-b9cb-e70da196976c
msgctxt "h26183db1gd594g4a0agb6f2gf2f908f2920b"
msgid "*You test the weight of the chains, looking for weak points.*"
msgstr "*당신은 사슬의 강도를 시험하며 약점을 찾고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains
#. Speaker = Narrator
#. NodeID = d881d2d9-1b26-d6ef-6b42-ab27c50816af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_ChainsFailed(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains:d881d2d9-1b26-d6ef-6b42-ab27c50816af
msgctxt "h29b3ad66gfa98g4c7egb333gb742001171f0"
msgid "*You've tried everything - the chains still hold you.*"
msgstr "*당신은 모든 것을 시도해봤지만, 사슬은 여전히 당신을 속박하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains
#. Speaker = Narrator
#. NodeID = de6550ec-b24c-14c9-00de-b0b8684d4754
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_FreedFromChains(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains:de6550ec-b24c-14c9-00de-b0b8684d4754
msgctxt "hfa41924dg4601g434ega671g6b018f4166ea"
msgid "*You slip free of the chains.*"
msgstr "*당신은 사슬에서 풀려납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 0092c893-be74-22e6-f02f-c8f29dae9b89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:0092c893-be74-22e6-f02f-c8f29dae9b89
msgctxt "hbaa17624g0cb7g4464gadafg51866a356aa8"
msgid "I'm not letting you burn my flesh."
msgstr "네가 내 살점을 태우게 둘 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 02617fb7-9228-9270-648a-fffa66e1ec8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:02617fb7-9228-9270-648a-fffa66e1ec8b
msgctxt "hb18a707bg40cag4f31g90bdge358d7bdebfc"
msgid ""
"Time's the one thing you don't have. We've gotta get this thing out "
"<i>now</i>."
msgstr "너에게 시간은 없다. 우린 이 일을 <i>당장</i> 시작해야 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 034f42a4-514a-a455-53d4-d89ad5e90c47
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DROWELF or REALLY_ELF or REALLY_HALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:034f42a4-514a-a455-53d4-d89ad5e90c47
msgctxt "hd947bf4egeeaeg4d76gaff8g03536625cc06"
msgid "<i>Drink the potion.</i>"
msgstr "<i>물약을 마신다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 058272eb-d58c-a2c5-0b2a-a25d6089915a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:058272eb-d58c-a2c5-0b2a-a25d6089915a
msgctxt "hfd1e41c4g3133g4161g9d00g2701313a7871"
msgid "That'll put me to sleep - are you trying to trick me?"
msgstr "그건 나를 잠에 빠뜨릴 텐데. 넌 나를 속이려는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 0593ade1-e350-1741-5bc5-be50589ae301
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:0593ade1-e350-1741-5bc5-be50589ae301
msgctxt "h59442e4dgba4dg424bg89e9gba428cfeab1e"
msgid ""
"*Psionic feelers creep across your mind, like a pickpocket's fingers seeking "
"flaws in fabric.*"
msgstr "*마치 소매치기의 손가락이 옷의 빈틈을 찾는 것처럼, 사이오닉 촉수들이 당신의 정신에 천천히 다가옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 0a843268-13f2-42fe-6cb3-9ae4d8ab484f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:0a843268-13f2-42fe-6cb3-9ae4d8ab484f
msgctxt "h5b9212c2gaa8fg4f5eg9150g66f320105908"
msgid "Eh, most of my brain is a wreck. Just do what you will."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 0b5e5e30-d266-168b-ccd6-a96925153557
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:0b5e5e30-d266-168b-ccd6-a96925153557
msgctxt "hc7b715f0g3852g4a84g99e6gbe4f0c76848e"
msgid "Let me show you just <i>how</i> dangerous I am, True Soul. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Shadowheart
#. NodeID = 0b953398-5575-1a7e-89c5-ab69788e8537
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:0b953398-5575-1a7e-89c5-ab69788e8537
msgctxt "h07cb04b4g07d1g4d85gb9d7g097854f1c279"
msgid ""
"None of her friends around... Perfect time for a little discreet knifework."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 15c94940-f646-8a73-35d4-cf9b70a7d348
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:15c94940-f646-8a73-35d4-cf9b70a7d348
msgctxt "h2a58af51ga929g4425ga368gcb6f3172add3"
msgid "I'm here to kill you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 16a5cf72-e649-d275-4640-0aced2dadb23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:16a5cf72-e649-d275-4640-0aced2dadb23
msgctxt "h20180879g2159g4573g8ce8g23feecb9f9b0"
msgid "I've been searching for a healer - can you help?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 1dce4aaa-d483-79ea-21cc-67f8be2e4bc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:1dce4aaa-d483-79ea-21cc-67f8be2e4bc4
msgctxt "h0e518d31g95c9g4538g8028gf69c8e8ac3b0"
msgid "I needed a quiet corner to slaughter you in."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 24155ee3-c2da-ac29-9a87-68e6f93c9ef5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_MentionedParasite(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:24155ee3-c2da-ac29-9a87-68e6f93c9ef5
msgctxt "hf3c8d39cg78dcg4218g8294g796397355f01"
msgid "Pretty sure one of those parasites is squirming in your head, too."
msgstr "그 기생충들 중 한 마리가 네 머릿속에도 들어간 게 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 2532e2d2-e4f7-6f03-1f16-f96376523cd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:2532e2d2-e4f7-6f03-1f16-f96376523cd6
msgctxt "hab70e727g88beg433cg8ca1g4d05797984ab"
msgid "I've heard enough - time to die."
msgstr "그만 떠들어 - 죽을 시간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 26096e14-d8a3-e6ba-cf6c-b0e872439857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:26096e14-d8a3-e6ba-cf6c-b0e872439857
msgctxt "h24bc7b53g62b4g46d7g962bg5d56a3ab33f9"
msgid "<i>Relax your mind, directing her to the memory of your infection.</i>"
msgstr "<i>마음을 편안하게 하고, 감염의 기억으로 그녀를 안내한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 274fa0fd-5418-9313-d158-c90d51829006
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:274fa0fd-5418-9313-d158-c90d51829006
msgctxt "hd8127147gfbd0g4510ga2a3gef581cd71bc7"
msgid ""
"It's a liquid blessing. It'll cleanse you - and it tastes better than the "
"rotgut at the party."
msgstr "이건 축복하는 액체다. 널 정화해줄 거야. 그리고 그 파티의 저질 술보다는 맛이 괜찮을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 2757cc42-322d-b20b-b54a-b8a7638f951d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_AcceptedHelp(1) = True
#.     - GOB_GoblinPriest_RefusedHelp(1) = False
#.   Object:
#.     - GOB_GoblinPriest_PlayerAcceptedHelp(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:2757cc42-322d-b20b-b54a-b8a7638f951d
msgctxt "h51a469c0ga171g4d61g9e51g6963864cf3d1"
msgid ""
"Don't you worry. I've got everythin' I need to fix you. Might get a bit "
"messy though."
msgstr "걱정 마. 난 널 고쳐주기 위해 필요한 수단을 다 갖추고 있어. 좀 지저분할 순 있지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 27d60139-b4b0-ca56-6332-5537e3fe307a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:27d60139-b4b0-ca56-6332-5537e3fe307a
msgctxt "h04979e7eg3b68g4f53g8d95gcd7ed5a62101"
msgid "*You repel her mental probes, concealing your memories.*"
msgstr "*당신은 그녀의 정신조사를 저지하여 기억을 감춥니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Wyll
#. NodeID = 28fa4527-37cd-1fee-db03-6013f16624f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:28fa4527-37cd-1fee-db03-6013f16624f4
#, fuzzy
msgctxt "h6fcf1402g44e9g4042g9b66gcead29567a3d"
msgid "Weapon at the ready - now's the time."
msgstr "무기를 준비해, 대장. 지금이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 297eac3a-a8f1-4454-2dac-aff225b15ce8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_AcceptedHelp(1) = True
#.   Object:
#.      - GOB_GoblinPriest_PlayerAcceptedHelp(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:297eac3a-a8f1-4454-2dac-aff225b15ce8
msgctxt "h2f0e63c0g559ag4f28gb750g07a13a584c26"
msgid "Ready to clear your head?"
msgstr "머리를 비울 준비 됐나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Lae'zel
#. NodeID = 2a77f21d-40d9-acb2-6b46-505f7044e6f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:2a77f21d-40d9-acb2-6b46-505f7044e6f0
msgctxt "h514bdb9dg37bbg4690gaaefg575ed41bdf5c"
msgid "Enough stalling. Finish her, and be quick about it."
msgstr "그만 끌고 좀 빨리 끝장내버리라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 2afe804d-cff8-b776-0f17-1c42e0236a7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:2afe804d-cff8-b776-0f17-1c42e0236a7d
msgctxt "hae97e927g84aeg493bgb88egcbf775ff2cb6"
msgid "Fine. Brand me."
msgstr "좋아. 표식을 새겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 2b42c614-1050-17ed-caae-fa58ea79d16c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:2b42c614-1050-17ed-caae-fa58ea79d16c
msgctxt "h4f078c8eg511cg413agbf74g838f9727cb0d"
msgid "I ain't deceiving nobody. I'm tryin' to help!"
msgstr "내가 속이긴 뭘 속여. 난 도와주려는 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 2bdae375-5e0a-50d2-92c6-def3a46c359f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:2bdae375-5e0a-50d2-92c6-def3a46c359f
msgctxt "h466c857age36bg4771g9173gf03b3411a286"
msgid ""
"Lets the faithful recognise one another quick-sharp. That way, nobody'll "
"mess with you."
msgstr "신도들이 서로를 재빨리 알아볼 수 있다. 그렇게 되면, 아무도 너를 방해하지 않을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 2edf6d47-47f9-6316-ff5f-3c81bdc7e70f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:2edf6d47-47f9-6316-ff5f-3c81bdc7e70f
msgctxt "hd1142cffg0f7eg465dgb766g74deb14c696e"
msgid "*An image of the mind flayer reaches out to her from your memories.*"
msgstr "*당신의 기억에 있는 마인드 플레이어의 모습이 그녀에게 전파됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 3261e5a2-ab0f-92a5-da55-6dd1cb027407
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_AcceptedHelp(1) = False
#.      - GOB_GoblinPriest_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:3261e5a2-ab0f-92a5-da55-6dd1cb027407
msgctxt "h6892d5aag24a9g4cfegac5fg68d6531b07c6"
msgid "Ready to figure out what's going on with those shadows in your head?"
msgstr "네 머릿속 어둠에 무슨 일이 일어나고 있는지 알아낼 준비는 됐나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 3322cc29-041f-b314-b875-f82288a4f284
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_AcceptedHelp(1) = False
#.     - GOB_GoblinPriest_RefusedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:3322cc29-041f-b314-b875-f82288a4f284
msgctxt "h4f1d7956g9e1dg4a54ga1f6g72741e5d9b3f"
msgid ""
"No. You ain't leaving until we get to the bottom of this. You could be "
"<i>dangerous</i>."
msgstr "안 돼, 진상을 파악할 때까지는 못 나가. 넌 <i>위험한 존재</i>일 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 336d0325-e8d4-7f5c-ee5c-75977dd5d9b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_AcceptedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:336d0325-e8d4-7f5c-ee5c-75977dd5d9b4
msgctxt "h0b5e4aa0g2971g47a5g949bg21f5ce8f3f50"
msgid "At this point, I'll take anything. Do what you can."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 35bd6c93-b736-e29d-c945-1ac1224f6f36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:35bd6c93-b736-e29d-c945-1ac1224f6f36
msgctxt "h57b81c61g3b8dg433dg93f1g8f8fcf3f97e9"
msgid "Maybe I can help with that... Didn't realise you were a True Soul."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 368ca74c-1c8c-1c9d-c6e2-2a2d10323991
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_HasSleepPotion(0) = True
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.ReachedQuarters(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:368ca74c-1c8c-1c9d-c6e2-2a2d10323991
msgctxt "h5adfb25dgf960g47d4ga312g03db8985be68"
msgid "So drink this. It'll purify ya."
msgstr "그러니 이걸 마셔. 이게 널 정화해줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 3810cb1a-f408-e0eb-69cf-96c911cbf230
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:3810cb1a-f408-e0eb-69cf-96c911cbf230
msgctxt "hfe60aa67g743ag4042g94a8g787941dc9c16"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 39d8fec0-73c7-d1f4-36a1-7ebd940a5bb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_AnotherPlayerProblem = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:39d8fec0-73c7-d1f4-36a1-7ebd940a5bb5
msgctxt "h1d4e3b6bg722fg4887g8934gb12bf7cb96f7"
msgid ""
"I already said I'd help your mate, but I'll fix you one at a time, right "
"here in the chapel. Send 'em through."
msgstr "이미 네 친구를 돕겠다고 말했지만, 예배당 바로 이곳에서 한 번에 한 명씩 고쳐줄게. 친구들에게도 오라고 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 3d1cebc2-e5f8-0719-cba6-249d9c5fa4d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:3d1cebc2-e5f8-0719-cba6-249d9c5fa4d2
msgctxt "h72812734gfe55g4ff2ga08cg7d8553d8c3d0"
msgid "Absolutely - can you help?"
msgstr "물론. 도와줄 수 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 3e9b1e0c-cd8d-5a74-590b-d9e1c7d365a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinPriest _HearVoiceOfGod = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:3e9b1e0c-cd8d-5a74-590b-d9e1c7d365a0
msgctxt "h3ad0f6d1g0138g455eg9809g34b45b986d07"
msgid ""
"Whatever the Absolute tells me to. Don't worry - She loves you. I can tell."
msgstr "절대자께서 내게 명하시는 무엇이든. 걱정 마라. 그분은 널 사랑하신다. 난 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 407bf480-8e86-048f-2043-3e31b81b21db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:407bf480-8e86-048f-2043-3e31b81b21db
msgctxt "hf61f3653g2ce1g4cacg8ccdgc9df3f77f381"
msgid ""
"*She prises your mental barriers apart... and sees the mind flayer from the "
"ship.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 41f0c18d-ed41-c998-556a-2e898146fe2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_CantHelp(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:41f0c18d-ed41-c998-556a-2e898146fe2f
msgctxt "h473ea9a4g8607g4b60gbab7g9aa2ad344bcc"
msgid "I can't fix what's wrong with you. Best pray to the Absolute for help."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 42fb804a-2482-f8bf-8fe0-7e4602fb903e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Event_DoorClosed(0) = False
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_TryCloseDoor(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:42fb804a-2482-f8bf-8fe0-7e4602fb903e
msgctxt "h0a2eb8dfgafcfg4d9fg9f77ga7567b725c37"
msgid "Don't want anyone peepin' on private matters, so..."
msgstr "누가 사적인 일을 엿보는 건 원치 않으니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 440d6589-a5b6-4070-7237-329545779a9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:440d6589-a5b6-4070-7237-329545779a9a
msgctxt "hb26122dbg79d5g4120ga151ge4c7ff97aef7"
msgid ""
"Hells. That is <i>horrible</i>. Can see why you'd want to keep it secret."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 443cd882-34f3-b5ee-5bb6-75c3d53b3834
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_HasSleepPotion(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:443cd882-34f3-b5ee-5bb6-75c3d53b3834
msgctxt "hd01a931ega6eag4850g89a2g7457dc9e288d"
msgid "Hang on - somebody's nabbed my potion."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 45897dca-5702-b776-30fe-4ea75be9689f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:45897dca-5702-b776-30fe-4ea75be9689f
msgctxt "h332224c6gade5g4677ga0dfgd5d07b8fa1fd"
msgid "I don't think so. Time to die."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 45d7e7cb-4d84-8ba3-6447-794cd5f078e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:45d7e7cb-4d84-8ba3-6447-794cd5f078e6
msgctxt "hed71bc0fg033ag4d67g9926g568e82544323"
msgid "*Your minds brush against one another but are swiftly parted.*"
msgstr "*두 사람의 정신이 서로 스치지만 금세 헤어집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 470e3d10-e772-19f9-d30b-434b586c8640
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_ToldAboutTadpole(1) = True
#.      - GOB_GoblinPriest_RefusedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:470e3d10-e772-19f9-d30b-434b586c8640
msgctxt "h1557a2c9g759eg4185ga8e1ga511637df062"
msgid ""
"Surprised to see you still standing. You ready to figure out what that "
"critter's doing to your head? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 49192a59-615a-5275-4f5b-3d6a26c323f7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Symbol = True
#.   Tag:
#.     - BRANDED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:49192a59-615a-5275-4f5b-3d6a26c323f7
msgctxt "h087246c2g8e0bg413bg93d2ga1a676517d5d"
msgid ""
"*As the pain muddles your thoughts, your minds become entangled. A familiar "
"sensation - she, too, carries a parasite.*"
msgstr "*고통이 당신의 생각을 헝클어뜨리자, 당신의 마음도 뒤엉킵니다. 익숙한 감각입니다. 그녀도 기생충을 가지고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 4cb2dd82-0f07-8e10-b75b-d4df4bca850b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:4cb2dd82-0f07-8e10-b75b-d4df4bca850b
msgctxt "h4d5c9d20g85bcg45a1g91a3g0fe73cbb58a8"
msgid "Stand aside; I'm leaving."
msgstr "저리 비켜. 나는 떠날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 4cf2bd57-355c-51b0-7d9d-37098a4797e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:4cf2bd57-355c-51b0-7d9d-37098a4797e9
msgctxt "h6dba94a4gd3eag4cafg821fg636c4c8cf716"
msgid "I'm ready to kill you, actually."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 50b8c24a-6831-6c65-a58b-e90695e6b414
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:50b8c24a-6831-6c65-a58b-e90695e6b414
msgctxt "h4dcb97e4g345eg4ea7g8591g151f6654b685"
msgid "What's the potion for?"
msgstr "이 포션의 용도는 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 50fb3dd5-98c6-090e-dc0c-50831a40cc8b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:50fb3dd5-98c6-090e-dc0c-50831a40cc8b
msgctxt "h269a8305gb757g4467gb685gfe9aec211862"
msgid "You can't! The Absolute will <i>crush</i> you!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 511ecd0b-285d-a276-86ab-debd0cfc18fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:511ecd0b-285d-a276-86ab-debd0cfc18fc
msgctxt "hfcdbd89egb8feg4639g80b4g4f5ea935e6c7"
msgid "Then get it out of me."
msgstr "그렇다면 그것을 내게서 꺼내줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 546bcc2f-11be-1943-4098-ee092663dae5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - GOB_GoblinPriest_Event_DrinkPotion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:546bcc2f-11be-1943-4098-ee092663dae5
msgctxt "h98f07db0g4cbcg4baegb4cfg7e697ffa8157"
msgid "Sweet dreams. I'll see your ugly mug on the other side."
msgstr "좋은 꿈 꾸렴. 저쪽에서 네 못생긴 면상을 봐줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 594cfa1c-3549-1e8b-fd84-b186627c52f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:594cfa1c-3549-1e8b-fd84-b186627c52f4
msgctxt "h003eccd9g67e9g4c73gad99gbf3d4f21ecd2"
msgid "I still have my senses. I'll find another way to deal with it."
msgstr "나는 아직 제정신을 차리고 있어. 해결할 다른 방법을 찾아봐야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 5c1917d4-c9fa-059c-1336-4d5b3d8366e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:5c1917d4-c9fa-059c-1336-4d5b3d8366e4
msgctxt "he70eb08dg8295g484fg9cf1ga9030c6aa505"
msgid "I don't think so. You're finished."
msgstr "아닌 것 같군. 넌 끝이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 5c730e48-f6b1-938d-3a8a-88164e6004c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:5c730e48-f6b1-938d-3a8a-88164e6004c8
msgctxt "h5c0a4041g9406g4ab6gbde3gf36b2c485bef"
msgid ""
"No. It's messing with your brain. You're seeing things - probably hearing "
"voices too, yeah?"
msgstr "아니. 그건 네 뇌를 망가뜨리고 있어. 너에게 환각이 보이고, 아마 환청도 들리겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 5c9b6601-e1a3-7da2-4aed-e670bcc9c0bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_PrivateMeeting(1) = True
#.      - GOB_GoblinPriest_AcceptedHelp(1) = False
#.   Global:
#.      - GOB_GoblinPriest_AskedForPrivacy = True
#.   Object:
#.      - GOB_GoblinPriest_PlayerAcceptedHelp(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:5c9b6601-e1a3-7da2-4aed-e670bcc9c0bc
msgctxt "h67f665efg87fbg4a36g9093g2ef89edce7c6"
msgid "You wanted to talk privately, so here we are. What's botherin' you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 5ea6057b-e543-3b36-8b98-efe5bf9a3c6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:5ea6057b-e543-3b36-8b98-efe5bf9a3c6a
msgctxt "h59e9a4edg658bg4654ga3e8g6fe44c515cc9"
msgid ""
"*Sifting deeper, she sees the mind flayer holding a wriggling tadpole to "
"your eye.*"
msgstr "*그녀는 더 깊이 살피더니, 마인드 플레이어가 꿈틀거리는 올챙이를 당신의 눈에 넣고 있는 모습을 발견합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 60bf60c5-b8be-fe30-aedd-f72fe5e3060c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:60bf60c5-b8be-fe30-aedd-f72fe5e3060c
msgctxt "h9d2249dfga5d8g4a02g920fgb7fd23adf10e"
msgid ""
"*And then the vision lurches, and you are looking through <i>her</i> eyes as "
"a tadpole squirms into her skull.*"
msgstr ""
"*그 후 시야가 흐려지고, 당신은 <i>그녀의</i> 눈을 통해 올챙이가 그녀 머리 속으로 꿈틀거리며 들어가는 것을 보고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 61782509-6544-7310-8a0c-03e862773312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:61782509-6544-7310-8a0c-03e862773312
msgctxt "h7ad1a1d8gbe86g4fbbga1ecg3900b27c6cb3"
msgid "A <i>creature</i>? There's definitely something rotten in there."
msgstr "<i>생명체</i>? 네 머리에 분명 썩은 뭔가가 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Karlach
#. NodeID = 628315fa-59b5-79b9-6fc5-45cf6aa4f8b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:628315fa-59b5-79b9-6fc5-45cf6aa4f8b7
msgctxt "hca5bc39cg235dg4ba1g8235gbd296544d5d5"
msgid ""
"If we're quick about it, we can cut her throat before she calls for "
"reinforcements."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 6756a990-86a6-05a6-9c29-ed8b8348d105
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:6756a990-86a6-05a6-9c29-ed8b8348d105
msgctxt "h3941877ag32e1g48f3g94a6g6f84b16bc5a4"
msgid "What exactly are you going to do?"
msgstr "정확히 뭘 할 셈이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 68f4dda4-ccba-ba84-09db-ca1831aad5b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:68f4dda4-ccba-ba84-09db-ca1831aad5b8
msgctxt "hf0c24973g3ae1g4ff5g8d26g917a5c578577"
msgid "Give me a little time to prepare."
msgstr "준비할 시간을 조금 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 6993086c-546b-8833-dbba-bc0bcb8b25e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:6993086c-546b-8833-dbba-bc0bcb8b25e9
msgctxt "ha0fe8c70g673eg4a64gbe9ag70f3041f9b24"
msgid "What's the mark for?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 69f77fca-6f2e-a2dd-5d3f-f90f97bc344c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:69f77fca-6f2e-a2dd-5d3f-f90f97bc344c
msgctxt "h7710c6a7g5977g4072gad37g90ae3b848c94"
msgid ""
"Hells. We need to fish that thing out before it eats any <i>important </"
"i>parts of your brain."
msgstr "젠장. 저 괴물이 네 뇌의 <i>중요한</i> 부분을 먹기 전에 낚아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 6bdc427d-b34b-f1f0-ae73-087063ef838c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:6bdc427d-b34b-f1f0-ae73-087063ef838c
msgctxt "h52173323ge9d4g48f9g8addg5a33294959ac"
msgid ""
"Maybe you don't need me to. After all, you're special, ain't you? Like me."
msgstr "너는 내 과정이 필요 없을지도 모르겠구나. 결국은 너도 특별하니까, 그렇지? 나처럼 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 6cd66f3f-643f-b918-587d-27afb3c184d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:6cd66f3f-643f-b918-587d-27afb3c184d1
msgctxt "hff95d2c2g125dg4b3bga37dgf39f6b4927ff"
msgid "The Absolute will protect me - you don't stand a chance."
msgstr "절대자님이 나를 보호하신다. 너는 상대도 안돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 6cf5355d-b2d1-6f57-3d59-fced02b47509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:6cf5355d-b2d1-6f57-3d59-fced02b47509
msgctxt "hf53f4e1dg71e4g4e65gbb61g76b19e9f74f5"
msgid "I'm ready."
msgstr "준비됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 6d86c9da-3dff-1ccd-59f0-ad13180f2677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:6d86c9da-3dff-1ccd-59f0-ad13180f2677
msgctxt "hc2cc1286gd4f0g419fgaeeag94f0e4ded7b6"
msgid "It's all slippery in there. What are you hiding?"
msgstr "머릿속을 전혀 파악하지 못하겠어. 뭘 숨기고 있는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 70dc2803-dfe6-8202-2adb-4cbd330fcc4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:70dc2803-dfe6-8202-2adb-4cbd330fcc4a
msgctxt "h3ca3ba9ag3f88g44c4g8b02gd6b8d35e121d"
msgid ""
"Smart. All you need to do is open yourself to the Absolute, and I'll do the "
"rest."
msgstr "현명하군. 네가 해야 할 일은 절대자님께 마음을 여는 것뿐이다. 나머지 일은 내가 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 7256f7b3-1055-d4fd-7657-f3812d8b09e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7256f7b3-1055-d4fd-7657-f3812d8b09e2
msgctxt "h427d5512g7eedg4519g9a08g05465bb95921"
msgid "Hold still."
msgstr "가만히 있거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 73599a5f-3178-acb1-5031-653ec37cfab7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:73599a5f-3178-acb1-5031-653ec37cfab7
msgctxt "ha62c06c1gf243g4c1dg8229g780c6ec22b47"
msgid "You can help me by dying quietly."
msgstr "조용히 죽어준다면 도움이 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 74773c64-8dcc-2b8c-6668-7af4cf6aae06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:74773c64-8dcc-2b8c-6668-7af4cf6aae06
msgctxt "h3fc217d8g9146g4630gaa10ge2633733bf4e"
msgid ""
"Being a True Soul, you know the Absolute don't like to touch nothin' unclean."
msgstr "넌 참된 영혼이니, 절대자께서 부정한 것을 만지길 좋아하지 않는다는 사실은 알고 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 7821f4ad-bcc2-7a58-29ec-ee1980be9e40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_HasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7821f4ad-bcc2-7a58-29ec-ee1980be9e40
msgctxt "h859d0c13g4fa0g4675g9f4dgfff23b3bf78e"
msgid ""
"Only those that have faith are welcome here. Clear off before I cut you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 7a29907b-2f57-b629-a26b-3a8680cc3150
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_ToldAboutTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7a29907b-2f57-b629-a26b-3a8680cc3150
msgctxt "h8107d1b1g07d7g4a5ag9532g9117b168c852"
msgid "There's a creature inside my head. Can you do anything about that?"
msgstr "내 머릿속에 생명체가 있다. 그것을 어떻게 해볼 수 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 7dcda069-9414-d036-556c-accff918bb8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFELF(1) = False
#.      - REALLY_DROWELF(1) = False
#.      - REALLY_ELF(1) = False
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - GOB_GoblinPriest_Event_CastSleep(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7dcda069-9414-d036-556c-accff918bb8d
msgctxt "hf86b148fg9c1cg49a8g9684g3f6067192314"
msgid "Sweet dreams."
msgstr "좋은 꿈 꾸렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 7e04f37a-d2a5-a896-84ea-932f4795138d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7e04f37a-d2a5-a896-84ea-932f4795138d
msgctxt "hcf1d144ag6463g4b27g9aadge2fd1e0b2e5b"
msgid "I'm ready to avenge all those your cult has slain. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 7e04f37a-d2a5-a896-84ea-932f4795138d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7e04f37a-d2a5-a896-84ea-932f4795138d
msgctxt "h6d9bd002g8a11g4d18g8e1bgc30522029a3c"
msgid ""
"Your faith is a pillar of this cult, True Soul. I'm afraid that means you "
"have to die. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 7e04f37a-d2a5-a896-84ea-932f4795138d
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7e04f37a-d2a5-a896-84ea-932f4795138d
msgctxt "h6488f37dgc29eg4095g9b03gd76c2627675f"
msgid ""
"The cult you've built is a blight upon nature, True Soul. Prepare to die. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 7e04f37a-d2a5-a896-84ea-932f4795138d
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Knows_PriestLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:7e04f37a-d2a5-a896-84ea-932f4795138d
msgctxt "hc3761b89g7cb3g4c89g8915g5bcfa841c1d6"
msgid "I'm ready to destroy your hold over this cult. Are you ready to die?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 8424c6d9-eb2d-ee34-5c1f-a4ee2d18eb2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Event_CloseDoorFailed(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:8424c6d9-eb2d-ee34-5c1f-a4ee2d18eb2f
msgctxt "h804de5e2g5999g4bd8g87e5g61836c13cd00"
msgid "There we go. Secret and safe. Well... secret."
msgstr "이제 됐다. 비밀스럽고 안전하군. 음... 비밀스러워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 8931e857-b6ee-eeba-fe1f-e5ac222d6461
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_RefuseDrinkPotion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:8931e857-b6ee-eeba-fe1f-e5ac222d6461
msgctxt "ha55ecfc6gdc8fg48d7gb65bg14a91bfd76e2"
msgid "I'm not drinking that."
msgstr "마시지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 8a3ff62d-4e89-5e8c-6061-a379484e7888
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_CantHelp(1) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.RefusedHelpGut(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:8a3ff62d-4e89-5e8c-6061-a379484e7888
msgctxt "hb40c94cbgb57eg4cfega377g5da2053bceaf"
msgid ""
"There's something wicked burrowed in your brain. I can't get a grip on it. "
"Best start praying for help."
msgstr "네 머릿속에 어떤 사악한 것이 파고들고 있어. 도저히 이해할 수가 없군. 도움을 비는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 8aa688df-4223-a628-df5a-0943e269ad5f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_CountPlayers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:8aa688df-4223-a628-df5a-0943e269ad5f
msgctxt "hd3098606g26b6g434dg99c5gf7aa2cc4b10d"
msgid "Yes. I'm ready."
msgstr "그래. 준비 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = 8aea2a92-a740-2491-079e-0004f1127bbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:8aea2a92-a740-2491-079e-0004f1127bbc
msgctxt "hca9eb0e0g3c1bg4c82gb498g8a1b8d699157"
msgid ""
"And it's charged with magic. Ordinary slobs can't see it; only us that "
"follow the Absolute."
msgstr "그리고 이는 마법으로 충전되어 있다. 평범한 게으름뱅이들은 볼 수 없고, 절대자를 따르는 우리만 볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = 8f53ad97-739f-c75e-1930-8ea73b163ad9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:8f53ad97-739f-c75e-1930-8ea73b163ad9
msgctxt "h8dd6abd6gf377g4c24gb1c5gb8e93d78f82f"
msgid ""
"*Her faith floods into you - a tide of shuddering ecstasy. Her tadpole "
"nestles within that mania, secure... hidden.*"
msgstr ""
"*그녀의 신앙심이 전율하는 황홀경의 물결처럼 당신에게 밀려듭니다. 그녀의 올챙이는 그 광란 속에 자리 잡아, 안전하게... 숨겨져 "
"있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 97bf6340-2b01-b000-6716-8586608d241b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:97bf6340-2b01-b000-6716-8586608d241b
msgctxt "h8c1d4ed4g1f4bg41f8g97d9g7b3f6c2cd0d1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 9ae4ff2d-3690-0af8-57b6-d51a45d25d8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:9ae4ff2d-3690-0af8-57b6-d51a45d25d8d
msgctxt "hbd6d3c3fge3dag4787gb578gcb1b5b657b54"
msgid "I already know what causes them - a creature in my brain."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = 9cee1815-f49d-f802-ca18-de498d9104a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_MentionedParasite(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:9cee1815-f49d-f802-ca18-de498d9104a2
msgctxt "he11b5697g43ccg4225g8321g7925d2dce095"
msgid "One of those things is inside you too, you know."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Astarion
#. NodeID = a1a291dd-87dd-0c87-38fc-4c53bc3b4da3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:a1a291dd-87dd-0c87-38fc-4c53bc3b4da3
msgctxt "h42c927e1g4f96g49f1gbb2bg91d0b7ebb9fe"
msgid ""
"There's no one here. Can we <i>please </i>kill her and get on with our day?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = a3664685-7ea9-acbc-e95c-1617572e5e08
