msgstr "그대를 추방하노라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_KaghaInCombat
#. Speaker = Kagha
#. NodeID = c9ee812c-a50e-2a1d-ccf8-60436ee6996d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 20416f57-255f-4580-772d-5fe899841826_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_KaghaInCombat:c9ee812c-a50e-2a1d-ccf8-60436ee6996d
msgctxt "h920754dcg8441g4d44g8efcgf5bbd6a658d7"
msgid "Nature's wrath be upon you!"
msgstr "자연이 네게 분노하리라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 02c0cf6f-c840-0834-d8c5-4eca672e19f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_C = True
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_B = False
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_A = False
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:02c0cf6f-c840-0834-d8c5-4eca672e19f7
msgctxt "h5eae0415g4b94g42e9g8e3agfefd7ae9472e"
msgid "What have I done? Dearest Rath..."
msgstr "내가 무슨 짓을 한 거지? 라스..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 28dbbef8-a4aa-414c-111b-699eba7be1f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:28dbbef8-a4aa-414c-111b-699eba7be1f2
msgctxt "h48d3ff93g475dg4626g9a88g64519ffa5f39"
msgid "Rath is... gone. Treefather forgive me, I acted a fool."
msgstr "라스가... 죽었어. 나무 아버지여 용서하소서, 제가 어리석었나이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 565a8eca-a776-23da-2153-e791f9909522
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_A = True
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:565a8eca-a776-23da-2153-e791f9909522
msgctxt "hcf30f026gcd9ag4a7fgb3cbga8788409bbed"
msgid "Rath. I'm sorry. So sorry..."
msgstr "라스. 미안하다. 정말 미안해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 59ad9e2f-d151-e86a-5883-b7e7e5ee2020
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_A = True
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:59ad9e2f-d151-e86a-5883-b7e7e5ee2020
msgctxt "h6ff729ecg08b9g43c0g8ba3g63e8cb846064"
msgid "Rath, may you find peace in the great silence."
msgstr "라스, 자네가 위대한 침묵 속에서 평안하기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 7c379036-1e55-cb17-d4ad-8f4c24ada0e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:7c379036-1e55-cb17-d4ad-8f4c24ada0e0
msgctxt "hb8ab5500g85ccg44ceg9b1fgc0177ef74e54"
msgid "Dearest Rath. You deserved so much better."
msgstr "라스. 이렇게 갈 사람이 아니었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 86ec5f75-4ee6-798f-a846-5a3b363f80db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_B = True
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:86ec5f75-4ee6-798f-a846-5a3b363f80db
msgctxt "h597e5090gfa6ag46fbgb16dg4b191262e292"
msgid "May they find peace in the great silence."
msgstr "이들이 위대한 침묵 속에서 평안하길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 922dbb7a-4111-8fb9-561d-8e1d07c50152
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_C = True
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_B = False
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_A = False
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:922dbb7a-4111-8fb9-561d-8e1d07c50152
msgctxt "h5716896fgf473g41d6gaf18g25618a0cc1a6"
msgid "How could I be so weak?"
msgstr "난 어찌 그리 나약했던거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = d607beee-ce87-1a66-dd36-f4b10ab25c5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_B = True
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:d607beee-ce87-1a66-dd36-f4b10ab25c5b
msgctxt "h178944c0g0946g4401ga6aeg09000ab96e6e"
msgid "How could I...? Silvanus have mercy."
msgstr "내가 이런 짓을...? 실바누스시여 자비를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = d8c97485-52c8-79f5-0813-57b9ea85a2b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:d8c97485-52c8-79f5-0813-57b9ea85a2b8
msgctxt "h3c2ade7bge8b6g4d45g8feag29bee4f8e6a3"
msgid "I've been a fool."
msgstr "내가 어리석었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = ed5091c0-bd97-abc7-9ccb-6851cba579b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Local:
#.     - 2db3f94c-be41-6bb6-c007-70ff9672a9ed_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_LeaderPersuaded:ed5091c0-bd97-abc7-9ccb-6851cba579b9
msgctxt "h8054e0bfg306cg476cg9933gc189b6ca4be8"
msgid "First the child. Now Rath..."
msgstr "처음엔 아이를 죽이고. 이젠 라스까지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Rath
#. NodeID = 280c306f-3bcd-2537-c40a-4b829ea6bafb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:280c306f-3bcd-2537-c40a-4b829ea6bafb
msgctxt "h31ecc1a3gc0d7g4c79g8650g3b07d57b4bb9"
msgid ""
"I do not hate you. I am ashamed at how far I let your machinations spread."
msgstr "당신이 싫은 게 아닙니다. 계략이 퍼질 때까지 손 놓고 있던 내 자신이 수치스러운 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Rath
#. NodeID = 2fa4b967-4529-e7a1-a442-9e45008cd408
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_B = True
#. SetFlags:
#.   Local:
#.     - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:2fa4b967-4529-e7a1-a442-9e45008cd408
msgctxt "h527bc768g7ee1g4a5egb4c0gdf7b0e30a33e"
msgid "When did this start?"
msgstr "어디서부터 잘못된거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Rath
#. NodeID = 39fb49a1-e2bf-b9f9-aa9d-3cad988047b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_C = True
#. SetFlags:
#.   Local:
#.     - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_B = False
#.     - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_C = False
#.     - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:39fb49a1-e2bf-b9f9-aa9d-3cad988047b4
msgctxt "h2d800decg3641g45f8ga9f6g7967bc0992da"
msgid "I was blind not to see it. Too trusting. A fool."
msgstr "이럴 줄 몰랐다니 내가 눈이 멀어도 한참 멀었지. 그리 믿으면 안됐는데. 멍청하게시리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Kagha
#. NodeID = 55500270-b4bb-86fe-d6ee-9d5b722a764c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:55500270-b4bb-86fe-d6ee-9d5b722a764c
msgctxt "h2786dd2cgb7d4g4f4bgbb32g2a79e34e2144"
msgid "I should have resisted. It should have... been different."
msgstr "거절해야 했는데. 달라질 수도... 있었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Kagha
#. NodeID = 55f089a8-3ccb-81d4-aa11-8f1efdb9e31b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:55f089a8-3ccb-81d4-aa11-8f1efdb9e31b
msgctxt "h91fdbc99ge030g4599g827agd5b692e67562"
msgid "The first letter from Cloakwood came a season ago."
msgstr "클록우드로부터 편지가 처음 온 건 지난 계절의 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Kagha
#. NodeID = 71da1f14-10d1-018b-329a-b9659a9862aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:71da1f14-10d1-018b-329a-b9659a9862aa
msgctxt "hb7c2e5c6g74f8g4a29g9519gc42c9f099e12"
msgid "Whatever the Treefather's judgement, I will accept it in full."
msgstr "나무 아버지의 판결이 무엇이든, 전적으로 받아들이겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Kagha
#. NodeID = 7b732c7c-8bce-6d8f-0373-10b0ae224cb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:7b732c7c-8bce-6d8f-0373-10b0ae224cb4
msgctxt "h4db9103dgece1g4d70gbeeagb0ef74e44610"
msgid "Not a fool. A friend. Would that I'd realised it..."
msgstr "멍청한 게 아니야. 친구여서 그런거지. 내가 보기엔 그래...."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Kagha
#. NodeID = 931eccc4-480e-a5d6-4450-32473d87a130
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:931eccc4-480e-a5d6-4450-32473d87a130
msgctxt "h2aad4f1fg0f00g404agb84ag23f28145e600"
msgid "If it's an argument you seek, you won't find it here."
msgstr "말싸움을 원하는 거라면, 나는 할 말이 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Kagha
#. NodeID = 9b496eb0-cc07-88a7-6fb7-4cad929d654b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_A = True
#. SetFlags:
#.   Local:
#.     - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:9b496eb0-cc07-88a7-6fb7-4cad929d654b
msgctxt "hfa4aac41gb514g41e3g8adfgb8a525f46b84"
msgid "I see it on your face. You hate me. And I don't blame you."
msgstr "네 얼굴에 써 있지. 날 싫어한다고 말이야. 그걸로 비난하지 않으마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Kagha
#. NodeID = e39ac6eb-a0c8-b8d0-51ef-896863f1eedd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:e39ac6eb-a0c8-b8d0-51ef-896863f1eedd
msgctxt "ha2edb779g8460g4b3ag9eefg1b3dd06013a1"
msgid "But when Halsin departed... the shadows truly took root."
msgstr "하지만 할신이 출발했을 때는.... 이미 그림자가 뿌리를 내린 후였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce
#. Speaker = Rath
#. NodeID = e63d92bc-5472-a38f-2d79-197ff4fd13d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cfd41e2d-43eb-dcb1-4abc-c3be2bcae1d1_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedDenounce:e63d92bc-5472-a38f-2d79-197ff4fd13d8
msgctxt "he9c139bbg824eg42f9gb1ecgd6f110bf591d"
msgid "You will face Silvanus' justice."
msgstr "당신은 실바누스의 심판을 받을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = 159abdd4-a82d-42ae-dfdd-6ad9a0bbfc41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 197833f4-6311-684a-9304-ee9b39aa9d75_A = True
#. SetFlags:
#.   Local:
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:159abdd4-a82d-42ae-dfdd-6ad9a0bbfc41
msgctxt "h38ce7b47g4c27g428dg8f8dg5a3d320f84e6"
msgid "So much death. So little justice."
msgstr "죽음이 만연함에도, 정의라곤 이리도 없구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = 3379b2f7-cb27-6cf0-239d-2b7a0ae0ec1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0e071aa7-cb91-6420-5e54-01d23d74c829_C = True
#. SetFlags:
#.   Local:
#.     - 197833f4-6311-684a-9304-ee9b39aa9d75_A = False
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_B = False
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:3379b2f7-cb27-6cf0-239d-2b7a0ae0ec1a
msgctxt "h1d772ddagb315g497bga973g37d3b93efd3c"
msgid "How could I have been so blind?"
msgstr "어찌 나는 아무것도 눈치채지 못했는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = 3573d3a1-7f99-2376-2195-154d5e79a817
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 197833f4-6311-684a-9304-ee9b39aa9d75_A = True
#. SetFlags:
#.   Local:
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:3573d3a1-7f99-2376-2195-154d5e79a817
msgctxt "h89e99cfdgb8bfg47dbg99e8g4aab225627af"
msgid "I should have seen the signs. She had gone too far."
msgstr "전조를 눈치 챘어야 했어. 카그하는 이미 선을 넘은지 오래였거늘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = 5e72937a-a4ba-3577-d3a2-a79d61d9cbfe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 0e071aa7-cb91-6420-5e54-01d23d74c829_B = True
#. SetFlags:
#.   Local:
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:5e72937a-a4ba-3577-d3a2-a79d61d9cbfe
msgctxt "hdcf4ced2gdec6g4fecga67cg83bbc5733d8c"
msgid "Halsin will find us in ruin. We have lost so much."
msgstr "할신에게 보일 건 다 무너진 모습 뿐이겠어. 너무나 많이도 잃었구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = 89945a49-6731-f969-0b1d-065cacd2cb2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 197833f4-6311-684a-9304-ee9b39aa9d75_A = True
#. SetFlags:
#.   Local:
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:89945a49-6731-f969-0b1d-065cacd2cb2d
msgctxt "h6c66aee2g53efg4677ga657g79ab611dcdcf"
msgid "If only you had said something, Kagha. I would have helped you."
msgstr "뭐라고 말이라도 해 주었더라면, 카그하. 내가 널 도와주었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = 94fcab3b-9a54-3172-14c0-c3338bb1cb8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Local:
#.     - 197833f4-6311-684a-9304-ee9b39aa9d75_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:94fcab3b-9a54-3172-14c0-c3338bb1cb8a
msgctxt "h007a3f66gcfeeg461fgb280g54488c3f8bde"
msgid ""
"May Silvanus' grace teach you in death what you did not learn in life, Kagha."
msgstr "부디 실바누스님의 은총이 그대가 삶에서 배우지 못한 가르침을 죽음 속에서 내려주길, 카그하여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = 9a8d67e3-faa3-f30b-dce4-6679f5ceaff4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 0e071aa7-cb91-6420-5e54-01d23d74c829_C = True
#. SetFlags:
#.   Local:
#.     - 197833f4-6311-684a-9304-ee9b39aa9d75_A = False
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_B = False
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:9a8d67e3-faa3-f30b-dce4-6679f5ceaff4
msgctxt "h987095b6g9160g450fg981fgcee2da9378b3"
msgid "Treefather watch over you."
msgstr "나무 아버지가 그대를 굽어 살피리라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = cb216541-b7d0-d65e-b2d6-c747e5c7de21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0e071aa7-cb91-6420-5e54-01d23d74c829_B = True
#. SetFlags:
#.   Local:
#.     - 0e071aa7-cb91-6420-5e54-01d23d74c829_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:cb216541-b7d0-d65e-b2d6-c747e5c7de21
msgctxt "hc3685d47g15e1g443fg8820g52c3a602629a"
msgid "Halsin would have stopped this."
msgstr "할신이라면 이런 사태는 막았을 것을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified
#. Speaker = Rath
#. NodeID = f78d9ee3-5437-51ae-66ce-a5ec6de154a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 197833f4-6311-684a-9304-ee9b39aa9d75_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_OpposedPacified:f78d9ee3-5437-51ae-66ce-a5ec6de154a1
msgctxt "hcbd37be9ge368g4a47g8508g7666fd75654a"
msgid "Such is betrayal: a poison that destroys its wielder."
msgstr "이러한 것이 배반이라. 쥔 자를 파멸시키는 독이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ReactToDeadKid
#. Speaker = Rath
#. NodeID = 296a5502-5e9f-d97d-6995-cacf24eb38d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_Event_ReactionDone(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ReactToDeadKid:296a5502-5e9f-d97d-6995-cacf24eb38d8
msgctxt "h5d847f64gf0a4g4751g886eg3f1d1d209a5a"
msgid "She's dead. Kagha, we are guardians, <i>not</i> killers!"
msgstr "그녀가 죽었습니다. 카그하, 우리는 수호자입니다, 살인자가 <i>아니라</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ReactToDeadKid
#. Speaker = Kagha
#. NodeID = 52b36ddd-e2df-195e-0d52-06a79d2a662f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ReactToDeadKid:52b36ddd-e2df-195e-0d52-06a79d2a662f
msgctxt "h98ad8f9bge608g44bagbf36gbb10baf72d96"
msgid "Spare your tears."
msgstr "눈물을 거둬라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ReactToDeadKid
#. Speaker = Kagha
#. NodeID = f62311eb-2b11-0bff-7f29-b8ff71e6509e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_Event_ReactionDone(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ReactToDeadKid:f62311eb-2b11-0bff-7f29-b8ff71e6509e
msgctxt "h10bf8883ge7bag4454g8c1bgccb09f832709"
msgid "She knew the danger. She still tried to run."
msgstr "그녀는 위험을 알고 있었다. 그런데도 도망치려 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ShadowDruid_001_DruidLeaderDied_Combat
#. Speaker = Olodan
#. NodeID = 53114ae4-ab19-56cd-678a-38f07532327a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ShadowDruid_001_DruidLeaderDied_Combat:53114ae4-ab19-56cd-678a-38f07532327a
msgctxt "he240bc27g7d06g4cc7g9b99gbfe788fe2fa1"
msgid "Nature's ruination! You have spoiled everything!"
msgstr "자연이여 비통하도다! 네놈이 전부 망쳐버렸다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ShadowDruid_001_TakingTurn_Combat
#. Speaker = Olodan
#. NodeID = b83ebbd3-50d9-4fb1-9711-6c1f74f977c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_ShadowDruid_001_TakingTurn_Combat:b83ebbd3-50d9-4fb1-9711-6c1f74f977c7
msgctxt "hc820bed9g3132g4718ga507g4ca7f19db373"
msgid "Shadows, take your prize!"
msgstr "그림자들아, 너희의 포상을 받아가거라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt
#. Speaker = Kagha
#. NodeID = 783f89df-d029-7c91-d490-2eed9fb0b708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt:783f89df-d029-7c91-d490-2eed9fb0b708
msgctxt "h709eb740g9006g4db3ga01cgd51862782858"
msgid "Let the devil be an example: we will tolerate outlanders no longer."
msgstr "이 데빌을 본보기로 삼아라. 더는 이방인들을 용인할 수 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt
#. Speaker = Kagha
#. NodeID = 7be54cb6-80a5-43d7-1cfa-d2c1e6af55a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt:7be54cb6-80a5-43d7-1cfa-d2c1e6af55a0
msgctxt "hfaa7a354gf484g4d9bg833eg337adbd67f8f"
msgid "She stole the Idol of Silvanus. She must pay the price."
msgstr "이것은 실바누스님의 우상을 훔쳤다. 대가를 치러야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt
#. Speaker = Kagha
#. NodeID = 7defaa10-4960-5079-7f43-c5be59ae7b03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt:7defaa10-4960-5079-7f43-c5be59ae7b03
msgctxt "h7d28a7a6g254cg47a3g9556g41d649381a39"
msgid "The grove will be made safe. The circle will be closed!"
msgstr "숲은 안전해지고, 회합은 닫힐 것이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt
#. Speaker = Kagha
#. NodeID = a537940d-8b35-37f9-6186-10491ac9f0c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt:a537940d-8b35-37f9-6186-10491ac9f0c8
msgctxt "h08531cf2gf169g4e64gb787gd7cb6720811a"
msgid "When we cast out the rest, she may join them."
msgstr "우리가 나머지를 쫓아내면, 그녀가 그들에게 합류할 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt
#. Speaker = Rath
#. NodeID = e6f74c74-ea63-a757-724d-118c722a7f99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt:e6f74c74-ea63-a757-724d-118c722a7f99
msgctxt "h9843138bg5b8ag41c8ga024g900e4fc3908b"
msgid "Have you lost your senses, Kagha? Release her!"
msgstr "제정신입니까, 카그하 님? 아이를 풀어주십시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt
#. Speaker = Arabella
#. NodeID = e7a26654-de62-0b2b-e875-d9926fb0564a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt:e7a26654-de62-0b2b-e875-d9926fb0564a
msgctxt "h00356d1cg1426g4291g938dga0eb29ec5a15"
msgid "I'm sorry, I'm sorry!"
msgstr "미안해요, 미안해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt
#. Speaker = Kagha
#. NodeID = ebf91610-7686-999c-ea44-740001e16952
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_AD_SnakesCourt:ebf91610-7686-999c-ea44-740001e16952
msgctxt "hc2e93baeg38cag4ab8g8b88g8d410d73365a"
msgid "We will imprison the thief under guard of my serpent."
msgstr "이 도둑을 내 뱀의 감시 아래 가두겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Rath
#. NodeID = 0109c3e3-e661-389d-5a01-71600866372c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:0109c3e3-e661-389d-5a01-71600866372c
msgctxt "h4c9cc8efgc9cdg4c03g838eg992679803159"
msgid "Shadow Druids? Kagha, have you lost your mind?!"
msgstr "그림자 드루이드들이라고요? 카그하, 정신이 나간 겁니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 01278a31-0eec-ebc7-c70d-51950bd4362e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:01278a31-0eec-ebc7-c70d-51950bd4362e
msgctxt "hb5655e89ga3d0g444fgad9agac1a36f1cf22"
msgid "I know these druids' ways. In their hands, this grove will decay."
msgstr "나는 이 드루이드들의 방식을 알고 있다. 그들의 손에서, 이 숲은 부패할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 0445f291-6a23-595d-c8ad-3d6ec157735a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_DenouncingWithFindal = False
#.      - DEN_ShadowDruid_State_DenouncingWithLoic = False
#.      - DEN_ShadowDruid_State_DenouncingWithMarcoryl = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:0445f291-6a23-595d-c8ad-3d6ec157735a
msgctxt "hca629652g3369g4947g82dagb269d3f86555"
msgid ""
"Olodan speaks truth. Do you disagree, Rath? You would see this grove in "
"<i>ruin</i>?"
msgstr "올로단께선 진실을 말씀하고 계신다. 너도 동의하지 않나, 라스? 이 숲이 <i>파멸</i>하는 것을 보고만 있을 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 04ae3974-0dda-f5bc-9872-54bd59606ac3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:04ae3974-0dda-f5bc-9872-54bd59606ac3
msgctxt "hb747fbe4g5ed0g4640g8a8bg274e4c090939"
msgid ""
"You are not strong enough to embrace the shadows. You will only become "
"corrupted in the eyes of your peers. <i>Cease</i>."
msgstr "넌 그림자를 받아들일 만큼 강하지 않아. 다만 동료들의 눈에나 타락한 존재로 보일 따름이지. <i>멈춰</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 04ae3974-0dda-f5bc-9872-54bd59606ac3
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:04ae3974-0dda-f5bc-9872-54bd59606ac3
msgctxt "h370cdf92g35b2g45a3g889cg4ed57c6fdf25"
msgid "The shadows will only corrupt - you don't need them."
msgstr "그림자는 타락시킬 뿐이야 - 너에게는 그들이 필요하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 04c658c1-d27f-b19f-1b19-dff4b528542b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:04c658c1-d27f-b19f-1b19-dff4b528542b
msgctxt "hb0d3cb2agc84bg41e6gb789gc07e9addc477"
msgid "Get out of my mind!"
msgstr "내 마음 속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 052ea231-7c30-ee6e-c5f7-091a497bdb23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_ShadowDruid_State_HasRecruitmentLetter(3) = True
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_Event_GiveRecruitmentLetter(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:052ea231-7c30-ee6e-c5f7-091a497bdb23
msgctxt "h4ccc8badg5ebeg4201ga08cg3467ed714237"
msgid "Take this letter, Rath. It will explain everything."
msgstr "이 편지 받아, 라스. 이걸로 모든 게 설명될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 05fd83c3-f4c1-3524-2eca-fb7abe014462
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:05fd83c3-f4c1-3524-2eca-fb7abe014462
msgctxt "h256b0587gb8adg45cag8c21g2a0c7568f1a1"
msgid ""
"It... it trembles in shame. It knows that in harmony, we perish. In shadow, "
"we are <i>pure</i>."
msgstr ""
"이것은... 이것은 부끄러움에 떨고 있다. 조화 속에서, 우리가 소멸할 것을 아는 것이다. 어둠 속에서, 우리는 <i>순수하다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 0cb4e17c-ce5f-3cbf-8a30-cbbac4587693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:0cb4e17c-ce5f-3cbf-8a30-cbbac4587693
msgctxt "h8110b148g87f4g403cg891bg9f499f9580b9"
msgid "As you say, Olodan."
msgstr "분부대로, 올로단 님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Narrator
#. NodeID = 10ab5558-4975-5a02-5f62-7da403996f7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsClearedForest = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:10ab5558-4975-5a02-5f62-7da403996f7c
msgctxt "h83f08a7bg61ceg4ffcgbb84gdb3c99209e16"
msgid ""
"<i>*'The forest rose with claw and tooth\n"
"To tear the darkness from its roots.'*</i>"
msgstr "<i>*'이 숲은 어둠을 뿌리에서부터 찢어내기 위해 발톱과 이빨과 함께 일어났다.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 11406cfb-d2a7-912f-0778-4cada0e10118
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:11406cfb-d2a7-912f-0778-4cada0e10118
msgctxt "h2b6d55d9gd8deg45a2ga190gb925e0721757"
msgid ""
"No one <i>joins</i> the Shadow Druids. Oh, no - their presence is requested."
msgstr "그림자 드루이드는 <i>가입</i>하는 게 아니란다. 오, 거절하지. 자신의 영혼을 증명해야 하거늘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 17d497a3-ecf8-87ad-8fff-497419ef5222
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:17d497a3-ecf8-87ad-8fff-497419ef5222
msgctxt "h8792f7c2g9367g4582ga081g2d81ca30583b"
msgid "Shh-shh. No need. It couldn't be helped."
msgstr "쉬, 쉬. 나서지 마라. 네가 낄 자리가 아니니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 1cc1dd0e-bf49-cbd9-d743-96988cc68cf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:1cc1dd0e-bf49-cbd9-d743-96988cc68cf1
msgctxt "h7f07fbdeg52ccg4f6bgac95g8539036d8f0d"
msgid "Oh? Then come get it."
msgstr "오? 그럼 덤벼봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 230571be-4567-8876-fe9e-9a21a0035aa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:230571be-4567-8876-fe9e-9a21a0035aa1
msgctxt "h312c34cfgfd30g4721g8da3g7be794e6267f"
msgid ""
"Halsin's always welcomed <i>untouchables</i> to your midst. Defiled the "
"grove for the sake of 'harmony'."
msgstr "할신은 언제나 <i>불가촉천민</i>을 보금자리에 환영했다. '조화'를 위해서 숲을 더럽혔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 26b46602-f3b6-7511-fe38-89b2de13c1e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:26b46602-f3b6-7511-fe38-89b2de13c1e9
msgctxt "hb4684d30g909eg49cag8903g9a0c3f3702a3"
msgid ""
"The grove may thrive only when the great vine strangles those who imperil it."
msgstr "거대한 덩굴이 숲을 위태롭게 하는 자들을 휘감아야만 숲이 번영할 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Rath
#. NodeID = 26be75f8-bc1a-2bbc-b281-030b149ee421
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:26be75f8-bc1a-2bbc-b281-030b149ee421
msgctxt "h89dcd6adg9baeg46f5gb5fdgd89a45216a59"
msgid "A Shadow Druid? Kagha, have you lost your mind?!"
msgstr "그림자 드루이드라고요? 카그하, 정신이 나간 겁니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 2d2e85fe-7e2a-41c9-f010-516bac44f91d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = True
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = True
#.   Tag:
#.      - DRUID(3) = False
#.      - REALLY_WOODHALFELF(3) = False
#.      - REALLY_WOODELF(3) = False
#.      - BARD(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:2d2e85fe-7e2a-41c9-f010-516bac44f91d
msgctxt "hc0bb3c8bge8b2g4fb3g8f1agd607e02f3b96"
msgid ""
"<i>Recite the frescoes you have read. Instil her with pride in the grove's "
"legacy.</i>"
msgstr "<i>자신이 읽은 벽화의 내용을 암송한다. 이 숲의 유산이 가진 자부심을 그녀에게 주입한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 2dc864ad-fb44-c815-f441-0d10e36ef1b7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DRUID(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:2dc864ad-fb44-c815-f441-0d10e36ef1b7
msgctxt "hf5e1a3fbg97c8g4d6dg90d3g2eec9e95ab31"
msgid ""
"Harmony is not weakness - it is balance. <i>Strength.</i> Silvanus calls on "
"you to preserve it."
msgstr "조화는 약함이 아니라 균형이야. <i>강함이지.</i> 실바누스께서 이를 보존하라고 너에게 명하셨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Rath
#. NodeID = 2e73cb0a-a141-263e-ee21-c7411c876bfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:2e73cb0a-a141-263e-ee21-c7411c876bfe
msgctxt "hbdc112aag1132g4081gb98eg8ea0854db687"
msgid "Cloakwood... Shadow Druids? Kagha, have you lost your mind?!"
msgstr "클록우드... 그림자 드루이드들이라고요? 카그하, 정신이 나간 겁니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 3001e9f6-3bef-5d20-df21-404937cb724d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:3001e9f6-3bef-5d20-df21-404937cb724d
msgctxt "h2187d8b7gdcd7g43e7gb33dgb0c9bb12ad8e"
msgid "How - how was I so blind?"
msgstr "어떻게 - 어떻게 내가 이리도 눈이 멀었던 것이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 30ce8b7a-e56a-71d1-dede-3efb0dee43c5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 6a27ef05-540d-9c55-a25a-12fe3a76641b_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_4 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:30ce8b7a-e56a-71d1-dede-3efb0dee43c5
msgctxt "haddad6f9gcf14g4b28g8ab7gbbf9e1bc41f1"
msgid "<i>Probe Kagha's mind.</i>"
msgstr "<i>카그하의 마음을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 33dd4a16-a955-71aa-8f13-2d43dd8d38c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:33dd4a16-a955-71aa-8f13-2d43dd8d38c3
msgctxt "h78be977ag7cf2g453cg8a81gf727bffbbb04"
msgid "We've come from Cloakwood to correct his mistakes."
msgstr "우리는 그의 실수를 바로잡기 위해 클록우드에서 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Narrator
#. NodeID = 44f2bd43-35d3-889e-08cf-1dc288ed1514
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_FoundingGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:44f2bd43-35d3-889e-08cf-1dc288ed1514
msgctxt "h110a8c48g39d6g4807gb41eg4290895d49fe"
msgid ""
"<i>*'By claw and tooth, from root to thorn,\n"
"The Old Oak's grove, to wildlings sworn.'*</i>"
msgstr ""
"<i>*'발톱과 송곳니로, 뿌리에서 가시까지,\n"
"야생과 맹세로 결속된 오래된 떡갈나무의 숲.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 45463868-9a9a-ecb4-9621-964ebd66db33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:45463868-9a9a-ecb4-9621-964ebd66db33
msgctxt "h137156ceg2e96g4aaag9519g2e042af2cf0a"
msgid "The shadows don't corrupt us - they cleanse us."
msgstr "그림자는 우리를 타락시키지 않는다 - 우리를 정화한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Narrator
#. NodeID = 48433cf8-5a66-67eb-8b36-a2409562f1b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:48433cf8-5a66-67eb-8b36-a2409562f1b4
msgctxt "hcc75b6d2g5ebeg4f8cgb880gaf8fe56e8697"
msgid ""
"*Kagha eyes you intently as you speak the text etched into the frescoes.*"
msgstr "*당신이 벽화에 새겨진 문구를 말하자, 카그하가 당신을 집중해서 바라봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Narrator
#. NodeID = 4a2ddfc5-5e53-e835-b5f7-c3578cb3ae59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsAlliance = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:4a2ddfc5-5e53-e835-b5f7-c3578cb3ae59
msgctxt "haadaf5a4g9122g4a03g956bg36f6fdbda7ec"
msgid ""
"<i>*'In darkest hour, a concord made,\n"
"'Twixt harp and wild against the shade.'*</i>"
msgstr ""
"<i>*'가장 어두운 시기에 이루어진 화합,\n"
"'하프와 야생이 어둠에 맞서.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 4f11827b-aadb-cbe9-1c89-92e184aaca43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:4f11827b-aadb-cbe9-1c89-92e184aaca43
msgctxt "h1b637efag26b8g4e08g84d5gba1fd5907d28"
msgid ""
"No! You... you don't know what you say. In shadow, we are <i>purified</i>."
msgstr "아냐! 네놈은... 네놈은 자신이 무슨 말을 하는지 모르잖아. 어둠 속에서, 우리는 <i>정화될</i> 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 530b6b9e-8450-a0a5-a31e-40554fd0b607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:530b6b9e-8450-a0a5-a31e-40554fd0b607
msgctxt "h39b463ecgdaa6g4b23gb5f1g8e4dae1fc214"
msgid ""
"When... when the darkest hour fell, it was <i>us</i> that brought light."
msgstr "가장 어두운 시기가 찾아왔을 때... 빛을 가져온 것은 바로 <i>우리</i>였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 5dbd0cae-3640-d2da-9874-4040e69782f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:5dbd0cae-3640-d2da-9874-4040e69782f0
msgctxt "h28ff4da5ga640g4994g8513g289b209c2d36"
msgid "Olodan, strike. We take this grove for the shadows!"
msgstr "올로단, 공격하십시오. 이 숲을 그림자로 점령합시다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 6cba4029-3f3f-5df7-99de-91df7badeaeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:6cba4029-3f3f-5df7-99de-91df7badeaeb
msgctxt "hb6e34f26gb5b5g44f5g9b2bg33c16c01fd18"
msgid "Careful, Kagha. The shadows don't forgive."
msgstr "잘 생각해라, 카그하. 그림자는 용서하지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 70e01c4e-9a75-c13d-dbc5-195351b4ed25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_DenouncingWithFindal = True
#.      - DEN_ShadowDruid_State_DenouncingWithLoic = True
#.      - DEN_ShadowDruid_State_DenouncingWithMarcoryl = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:70e01c4e-9a75-c13d-dbc5-195351b4ed25
msgctxt "h28809738g8f38g4c13ga7a7g1661cfb4fed5"
msgid ""
"Olodan speaks truth. Who among you disagrees? Who would see this grove in "
"<i>ruin</i>?"
msgstr ""
"올로단께선 진실을 말씀하고 계신다. 너희 중 누가 반대할 수 있지? 이 숲이 <i>파멸</i>하는 것을 보고만 있을 자가 있는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Rath
#. NodeID = 7f76146a-de40-00cc-023d-576d798b0c85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:7f76146a-de40-00cc-023d-576d798b0c85
msgctxt "hc5d5d6d4g3f92g4d3fg9b91g5feeb61587a6"
msgid "What in the... Cloakwood? Kagha - have you lost your mind?!"
msgstr "이럴 수가... 클록우드에서? 카그하, 당신 정신이 나갔습니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 82848807-b482-fa50-7c7b-f4392f5608dd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:82848807-b482-fa50-7c7b-f4392f5608dd
msgctxt "hf896fb14gfff2g4093g8f1ag647bbc410b5a"
msgid "Tsk. That flat nose of yours has gone poking in our <i>business</i>."
msgstr "쳇. 네놈들의 납작한 코가 우리 <i>계획</i> 냄새를 맡았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 82848807-b482-fa50-7c7b-f4392f5608dd
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:82848807-b482-fa50-7c7b-f4392f5608dd
msgctxt "h2d47901cg7ffbg4f22g95f4g02ca7e93b1c0"
msgid "Tsk. That damned nose of yours has gone poking in our <i>business</i>."
msgstr "쳇. 네놈들의 빌어먹을 코가 우리 <i>사업</i> 냄새를 맡았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 83038d94-6e93-6528-a0fa-591727f8c667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:83038d94-6e93-6528-a0fa-591727f8c667
msgctxt "ha51ba744ga663g4facg8d9egb1bfec1dbb6d"
msgid ""
"No! You... you twist the teachings. In harmony, we perish. In shadow, we are "
"<i>pure</i>."
msgstr ""
"아냐! 네놈은... 네놈은 가르침을 왜곡하고 있어. 조화 속에서, 우리는 소멸할 것이다. 어둠 속에서, 우리는 <i>순수하다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 867e8771-d3e1-26e6-3998-6771a21cf796
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:867e8771-d3e1-26e6-3998-6771a21cf796
msgctxt "h57baf4d3g1a51g4b7cgbfcdgb3ef8176568a"
msgid "Kagha's a Shadow Druid. She means to convert the circle."
msgstr "카그하는 그림자 드루이드야. 그녀는 회합을 전복시키려 하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 8836ec75-bbdc-df65-bbb8-ee184db30630
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:8836ec75-bbdc-df65-bbb8-ee184db30630
msgctxt "h1181ac91g76b7g4a67g938dg3dfaf2ab81ac"
msgid ""
"You would question my power? Mother Earth, hear me. Grant me your wrath!"
msgstr "내 힘에 거역하겠다는 것이냐? 어머니 대지시여, 들어주소서. 당신의 분노를 제게 허락하소서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 893b64ac-afe9-2757-4155-a93122f8ffba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:893b64ac-afe9-2757-4155-a93122f8ffba
msgctxt "hd2e68ba4g6866g4a26gaa3dgc3d53ed1925b"
msgid "I tried reasoning with you. Looks like it'll take blood to settle this."
msgstr "나는 설득을 하려 했지만, 이 문제를 해결하려면 피를 흘려야 할 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 90ff196f-e637-608a-600e-b3e604fd944d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:90ff196f-e637-608a-600e-b3e604fd944d
msgctxt "h8853debeg38f9g4ca4g8712gdc386faa7a92"
msgid ""
"Halsin is weak, Rath. But in the shadows, we are strong, we are safe. There "
"is no other way."
msgstr "할신은 약해, 라스. 하지만 어둠 속에서 우리는 강하고 안전해. 다른 방법이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 932f3e32-ac8e-0b4c-53c3-902f280a477f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:932f3e32-ac8e-0b4c-53c3-902f280a477f
msgctxt "hc1686636gc041g49c6ga668g0a0535d2c064"
msgid ""
"Empty ramblings, all of them. While you obsess over yesterday, I will be "
"making our <i>tomorrow</i>."
msgstr "모두 공허한 횡설수설이야. 너희가 어제에 집착하는 동안, 나는 우리의 <i>내일</i>을 만들 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 946258e7-2c22-891d-a792-1a9a53745783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:946258e7-2c22-891d-a792-1a9a53745783
msgctxt "h09700d35g94cag454fgb219g26ac9a7de537"
msgid "You'd decline the honour? Very well."
msgstr "영광을 거부하겠다는 거냐? 아주 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = 9a88f582-9272-36cd-dd68-ea3861ffe2ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = False
#.   Tag:
#.      - DRUID(3) = True
#. SetFlags:
#.   Local:
#.     - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:9a88f582-9272-36cd-dd68-ea3861ffe2ca
msgctxt "hb15602c1g2d34g406dg8bc6g99eec1edd853"
msgid "Spare my life, so I might join the Cloakwood druids."
msgstr "목숨을 살려줘. 그러면 클록우드 드루이드에 합류할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 9c908098-d3b2-36c9-edf8-863d8ed8ea57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:9c908098-d3b2-36c9-edf8-863d8ed8ea57
msgctxt "hf46c1bd6g6037g439ag8b46g11182b8212a8"
msgid "Silvanus calls on me to shield the circle, balance be damned."
msgstr "실바누스께서 균형이 무너진 회합을 보호하라고 명하셨다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = 9d77c55d-0540-864d-bfc6-79c674998a65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:9d77c55d-0540-864d-bfc6-79c674998a65
msgctxt "h818812e0g9654g4d3bgb3c8g1383332710ab"
msgid "End them, Kagha. Unless you have... lost your nerve."
msgstr "저들을 끝장내라, 카그하. 네가... 용기를 잃은 게 아니라면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = 9dc88fc8-acaf-5145-47b8-8898f9f61425
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_DenouncingWithLoic = True
#.      - DEN_ShadowDruid_State_DenouncingWithMarcoryl = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:9dc88fc8-acaf-5145-47b8-8898f9f61425
msgctxt "h2aec0fd1g50e0g41afg802cg701a35d8e414"
msgid ""
"Olodan speaks truth. Who among you disagrees? Who would see this grove in "
"<i>ruin</i>?"
msgstr ""
"올로단께선 진실을 말씀하고 계신다. 너희 중 누가 반대할 수 있지? 이 숲이 <i>파멸</i>하는 것을 보고만 있을 자가 있는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = a005e89c-d299-124e-9774-43f813d14c1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:a005e89c-d299-124e-9774-43f813d14c1a
msgctxt "h0a7d1c7cgcf70g4bc1gbf8age8866d9a6f4a"
msgid ""
"The choice is made. Kagha: burn the tainted away. Start with the snitch."
msgstr "결정은 내려졌다. 카그하, 오염된 자들을 태워버려라. 이 밀고자부터 시작해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = a0a746f0-905d-f830-ef16-46eade02c67e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:a0a746f0-905d-f830-ef16-46eade02c67e
msgctxt "h29aacb01g87c9g4b71gacfbg9ea1211bc65d"
msgid "Forget it, rat. You can explain it yourself."
msgstr "꿈도 꾸지 마라, 쥐새끼야. 스스로 설명하시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Narrator
#. NodeID = a55a92a2-fa25-865f-30dd-fc630efc3cc4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:a55a92a2-fa25-865f-30dd-fc630efc3cc4
msgctxt "hc5767890g32d4g42d9g9233gccce953e287a"
msgid ""
"*Kagha's voice breaks and her lips tremble. She heard reason in your words.*"
msgstr "*카그하의 목소리가 갈라지고 그녀의 입술이 떨립니다. 그녀는 당신의 말에서 이치를 들었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = a9120d1d-430d-b94c-151b-e74f4693b5ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:a9120d1d-430d-b94c-151b-e74f4693b5ea
msgctxt "hbb736982gcdd0g415fg84bcg65d7ba701688"
msgid ""
"Olodan speaks truth. Do you disagree? Would you see this grove in "
"<i>ruin</i>?"
msgstr "올로단께선 진실을 말씀하고 계신다. 너도 동의하지 않나? 이 숲이 <i>파멸</i>하는 것을 보고만 있을 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = aa9735fc-a603-f696-973e-c6fdd8973ae0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:aa9735fc-a603-f696-973e-c6fdd8973ae0
msgctxt "h0642aac2gf113g4a9bg9be8gfb4509e21bc4"
msgid "You think yourself quite the spy, don't you? Go on - <i>tell him</i>."
msgstr "네가 훌륭한 첩자라고 생각하지? 좋아, <i>녀석에게 알려줘라</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = ad32734a-841b-e074-cff4-00b5e9cffc42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:ad32734a-841b-e074-cff4-00b5e9cffc42
msgctxt "hd02803bcg217ag4038ga915gbf1340e90e5e"
msgid "You seem intent on forcing me to take your life. So be it."
msgstr "내가 널 죽이도록 강요할 생각인 것 같군. 그렇게 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = af1143d5-a6c6-7c38-e35e-b1a4fe0e5721
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:af1143d5-a6c6-7c38-e35e-b1a4fe0e5721
msgctxt "h24b68280gc835g48dfgad24g36dbad362768"
msgid "Mistress Olodan, I can explain..."
msgstr "미스트리스 올로단, 제가 설명할 수..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = b4ed044c-7fd6-ccb0-f1d4-b955526929ff
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:b4ed044c-7fd6-ccb0-f1d4-b955526929ff
msgctxt "hca197702g5e3eg484fg81c6gacda95f66a05"
msgid "I know these druids' ways. All they touch is fated to decay."
msgstr "나는 이 드루이드들의 방식을 알고 있다. 그들이 손대는 모든 것은 부패할 운명에 처하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Narrator
#. NodeID = bd1055b9-e453-e384-c65f-1a249edb06a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:bd1055b9-e453-e384-c65f-1a249edb06a9
msgctxt "h6bd39897g3472g4658g9d1cgd4fee9eeaef6"
msgid ""
"<i>*'The towers seized, the battle done, \n"
"The moonrise broke the Darkest One.'*</i>"
msgstr ""
"<i>\n"
"*'탑이 포위되고, 전투가 벌어졌네, \n"
"문라이즈가 가장 어두운 존재를 무너뜨렸다네.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = be840219-df43-ce47-1e82-8a6cad93d2ef
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = True
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = False
#.   Tag:
#.      - DRUID(3) = False
#.      - REALLY_WOODHALFELF(3) = False
#.      - REALLY_WOODELF(3) = False
#.      - BARD(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:be840219-df43-ce47-1e82-8a6cad93d2ef
msgctxt "h918563d4g1a27g4203g8794g014cfd32b7dc"
msgid ""
"<i>Recite the frescoes you have read. Remind Kagha of the grove's legacy.</i>"
msgstr "<i>자신이 읽은 벽화를 암송한다. 카그하에게 이 숲의 유산을 상기시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = c2285b8e-d965-c3e0-9633-93a767e8cbce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:c2285b8e-d965-c3e0-9633-93a767e8cbce
msgctxt "hdd64efbcg7235g4970g9c16g0348cf4a9cb6"
msgid "And I don't recall sending an invitation."
msgstr "그리고 나는 초대장을 보낸 기억이 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = c5150428-a34f-4eeb-e0f8-04c9037102a2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_PassedPassive = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:c5150428-a34f-4eeb-e0f8-04c9037102a2
msgctxt "h2fd97c63gef34g4ab2g9c3eg4c049c5b45ea"
msgid "You know I'm right. Don't let the shadows corrupt you."
msgstr "내 말이 옳다는 것 알잖아. 그림자가 너를 타락시키게 두지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = c63254b9-3795-ca4b-b3f5-6739b1fe1d14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:c63254b9-3795-ca4b-b3f5-6739b1fe1d14
msgctxt "hf449fef6gece9g45b7gb16fgbf27540c10b9"
msgid ""
"I - yes. When the darkest hour fell, it was <i>us</i> that brought light."
msgstr "나는 - 그래. 가장 어두운 시기가 찾아왔을 때, 빛을 가져온 것은 바로 <i>우리</i>였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = c8a6c2b3-7f4d-4171-0af8-5814fec0aca5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:c8a6c2b3-7f4d-4171-0af8-5814fec0aca5
msgctxt "h91e27559g8bc2g4c34g92aegf96003ec899e"
msgid "I belong to the shadows no longer. You've no power over me!"
msgstr "나는 더 이상 그림자에 속하지 않는다. 넌 날 지배할 수 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = cec288e8-3462-43b2-f776-d316af633c85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = True
#. TagRule: BARD or DRUID or REALLY_WOODELF or REALLY_WOODHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:cec288e8-3462-43b2-f776-d316af633c85
msgctxt "h15192a11g880bg4836g822bg5eb9bb3dfaa2"
msgid ""
"<i>Recite the frescoes you have read. Remind Kagha of the grove's legacy.</i>"
msgstr "<i>자신이 읽은 벽화를 암송한다. 카그하에게 이 숲의 유산을 상기시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Narrator
#. NodeID = cf3ce41c-1645-f199-7e52-0dada4468d03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:cf3ce41c-1645-f199-7e52-0dada4468d03
msgctxt "h3789fd7dg1ab9g4af1gba0dg6d6468b2e2ab"
msgid ""
"*You watch Kagha closely. If she is moved by your plea, she gives no sign.*"
msgstr "*당신은 카그하를 자세히 바라봅니다. 당신의 간청이 카그하에게 통했는지, 그녀는 아무 반응도 보이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = d3a983f5-8ed0-3150-afe2-7b4d4870f419
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = False
#. SetFlags:
#.   Local:
#.     - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:d3a983f5-8ed0-3150-afe2-7b4d4870f419
msgctxt "h76f1c0b8g8a3dg4cecg9cdcg127c035ba7b6"
msgid "Take the grove - I won't stand in your way."
msgstr "이 숲 가져 - 나는 방해하지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = d64c5c47-bf09-03ea-cd91-3c98f14bd7ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = False
#.   Tag:
#.      - OATHBREAKER(3) = True
#. SetFlags:
#.   Local:
#.     - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = True
#. TagRule: OATHBREAKER_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:d64c5c47-bf09-03ea-cd91-3c98f14bd7ee
msgctxt "hdc41ad64g1ef4g4eedg9dc2gb0b62a7c40cd"
msgid ""
"I've trimmed old weed for new life to flourish before. I won't interfere."
msgstr "전에도 새 생명이 꽃피울 수 있도록 오래된 잡초를 다듬은 적이 있지. 간섭하지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = d64c5c47-bf09-03ea-cd91-3c98f14bd7ee
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = False
#.   Tag:
#.      - OATHBREAKER(3) = True
#. SetFlags:
#.   Local:
#.     - b856f9a7-2439-9386-81f4-df5333a7f34b_Question = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:d64c5c47-bf09-03ea-cd91-3c98f14bd7ee
msgctxt "h7d73c98cg2a76g4c77gb0d5gd4aad366f6f1"
msgid "Sometimes the old must burn for the new to flourish. I won't interfere."
msgstr "때로는 새로운 것을 꽃피우기 위해 오래된 것을 태울 필요가 있지. 나는 간섭하지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = d7357e62-f8cf-d2cf-4292-17aadb921dc5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DRUID(3) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:d7357e62-f8cf-d2cf-4292-17aadb921dc5
msgctxt "h6343a619g1cdag45d2ga070gf310c690eda8"
msgid ""
"You are not strong enough to embrace the shadows. You will only become "
"corrupted in the eyes of your peers. <i>Cease</i>."
msgstr "넌 그림자를 받아들일 만큼 강하지 않아. 다만 동료들의 눈에나 타락한 존재로 보일 따름이지. <i>멈춰</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = d7357e62-f8cf-d2cf-4292-17aadb921dc5
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DRUID(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:d7357e62-f8cf-d2cf-4292-17aadb921dc5
msgctxt "h19e9df14gc228g4fd5g8694g616767416e3b"
msgid ""
"The shadows won't save you - they'll corrupt you. Stop this, while you can."
msgstr "그림자는 너를 지켜주지 않아 - 타락시킬 뿐이야. 멈출 수 있을 때 멈춰."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = d92b6e09-0b66-57ea-7a4e-c45efc4c02d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:d92b6e09-0b66-57ea-7a4e-c45efc4c02d6
msgctxt "he2c82986g60b4g4502gae65g5eda2ce2415d"
msgid "Oh, but you already have. Or does my memory fail so completely?"
msgstr "오, 하지만 이미 방해했잖니. 아니면 내 기억이 완전히 잘못됐나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = dbb61423-34a4-8add-cee0-360cd4f47d95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:dbb61423-34a4-8add-cee0-360cd4f47d95
msgctxt "hd1c150fcgacd4g44d4ga4b2g31b91c4d23b7"
msgid "You defile the grove for the sake of 'harmony'."
msgstr "너희는 '조화'를 위해서 숲을 더럽혔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = dd7481d3-d832-ba15-d339-a44d9b1641f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:dd7481d3-d832-ba15-d339-a44d9b1641f5
msgctxt "h3ef1aa48gffd8g48f1g8d7dg7a25b9b99674"
msgid "I take this grove for the shadows!"
msgstr "내가 이 숲을 그림자로 뒤덮을 것이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = e70384d4-1f1a-43fc-9277-906dd824e239
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:e70384d4-1f1a-43fc-9277-906dd824e239
msgctxt "h38bbf6dfg9d18g49b6gad1fg09a83dcf9895"
msgid "Silvanus demands we illuminate shadow, not hide within it."
msgstr "실바누스께서는 우리에게 그림자 속에 숨을 것이 아니라, 그림자를 밝힐 것을 명하셨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = e7b50b35-dfc6-47f3-19a0-6ba9d4d730b1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DRUID(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:e7b50b35-dfc6-47f3-19a0-6ba9d4d730b1
msgctxt "h30ba628bg429dg4d62g8508g645e6a3db0ee"
msgid ""
"Can't you feel how the prayer disturbs the soil and air? The grove trembles "
"in fear."
msgstr "기도가 얼마나 흙과 공기를 불안하게 만드는지 너는 못 느끼나? 이 숲이 두려움에 떨고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Kagha
#. NodeID = eddbb055-d310-9468-a7d5-b1380e88fd0e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6a27ef05-540d-9c55-a25a-12fe3a76641b_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:eddbb055-d310-9468-a7d5-b1380e88fd0e
msgctxt "habd379b6gb64fg4ab5ga68fg4d4c2240e922"
msgid ""
"<i>With the grove taken for Cloakwood, the circle will see that I'm right. "
"The Great Mother will guard us from all danger.</i>"
msgstr ""
"<i>클록우드를 위해 숲을 점령하면, 회합은 내가 옳다는 걸 알게 될 거야. 위대한 어머니께서 모든 위험으로부터 우리를 지켜주실 "
"거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = edfe4695-f452-f131-33da-0e9e810d296b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a27ef05-540d-9c55-a25a-12fe3a76641b_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:edfe4695-f452-f131-33da-0e9e810d296b
msgctxt "h670b810egb051g4ae7g8ac4gb191a1b250cc"
msgid ""
"You're so desperate to be proven right - it's made you forget who you really "
"are."
msgstr "자신이 옳다는 것을 증명하고 싶은 마음이 너무 간절해서 - 자신이 누구인지도 잊어버렸나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = f5f1aa3b-a7e0-c65a-2dbb-2f9f666ef7be
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(3) = True
#.      - OATHBREAKER(3) = False
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:f5f1aa3b-a7e0-c65a-2dbb-2f9f666ef7be
msgctxt "hb664eadcgfe51g440agb6d9gaea82c45b21c"
msgid ""
"Harmony cannot 'defile'. It is nature's will, and you would pervert it, "
"Kagha."
msgstr "조화는 '더럽힐' 수 없어. 이는 자연의 뜻이고, 너는 이를 망치려 하고 있어, 카그하."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = f5f1aa3b-a7e0-c65a-2dbb-2f9f666ef7be
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(3) = True
#.      - OATHBREAKER(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:f5f1aa3b-a7e0-c65a-2dbb-2f9f666ef7be
msgctxt "h9149f7edgedd9g431egb007g2dc125caa2ed"
msgid ""
"You are <i>druids</i>. You've an oath to uphold nature's harmony, its "
"strength - stand by it."
msgstr "너는 <i>드루이드</i>야. 자연의 조화와 강인함을 지키겠다는 맹세를 하고 그 곁에 서 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Rath
#. NodeID = f64f1a5b-4790-4948-a669-a37a1ed09274
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:f64f1a5b-4790-4948-a669-a37a1ed09274
msgctxt "h83edb30cg8586g4466ga78cg2ddcb1534b95"
msgid "Kagha! What is the meaning of this?"
msgstr "카그하! 이게 다 무슨 짓입니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Olodan
#. NodeID = f83f18ec-3f86-c2fd-4863-6c46a1246ba9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:f83f18ec-3f86-c2fd-4863-6c46a1246ba9
msgctxt "h027c398cg8c6eg4e1cg8aafg3285cae80600"
msgid "You and Halsin welcome <i>untouchables</i> to your midst."
msgstr "너와 할신은 언제나 <i>불가촉천민</i>을 보금자리에 환영했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing
#. Speaker = Player
#. NodeID = fd0ae491-783c-8f74-106b-c55ae36876ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Denouncing:fd0ae491-783c-8f74-106b-c55ae36876ab
msgctxt "h9c9983a7g282ag4df1gba56gcacd841b2897"
msgid "The Shadow Druids are taking over - the circle is overdue some change."
msgstr "그림자 드루이드들이 회합을 장악했다. 너희 공동체가 약간의 변화를 맞이해야 할 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = 0aa6e22a-f892-8248-0a6c-646ae0e804aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentBIsDead = True
#.      - IMPOSSIBLE = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:0aa6e22a-f892-8248-0a6c-646ae0e804aa
msgctxt "h9a7af9f3gfd47g476egb706gb8dded14e3ae"
msgid "I can't believe she's gone. I can't believe they'd do this to us!"
msgstr "엄마가 돌아가셨다니, 믿을 수 없어요. 우리한테 이런 짓을 했다니 믿기지 않는다구요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = 0c9ced70-a55f-1df5-861d-6e68ad6dd52b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:0c9ced70-a55f-1df5-861d-6e68ad6dd52b
msgctxt "h17aeeec9g891eg43d4g924dg35afd9564c93"
msgid "Why can't we just stay until it's safe?"
msgstr "우리가 안전해질 때까지 머무르기만 하는 게 뭐가 잘못됐죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Player
#. NodeID = 0d7d8a8f-1482-ea56-a52d-bfe75e9987bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:0d7d8a8f-1482-ea56-a52d-bfe75e9987bb
msgctxt "h62ed4ba0g10ecg43b8g96b3g97169ec0ce26"
msgid "What kind of hero did you expect to be?"
msgstr "무슨 영웅이 되길 기대했지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = 38124cfe-11a4-2435-5b01-d8ca515a87f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:38124cfe-11a4-2435-5b01-d8ca515a87f2
msgctxt "h308fa3a0gd6fag4d73gb1e3gaed6f6784a0a"
msgid ""
"Mol said we had to do something, because the old folks weren't doing "
"anything."
msgstr "몰은 우리가 무엇이든 해야 한다고 말했어요. 어른들은 아무것도 안하니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = 55c58bb7-97b6-0587-ec1a-fbf76342448d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_KidIsBack = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:55c58bb7-97b6-0587-ec1a-fbf76342448d
msgctxt "hf77752d6g1d2eg493bgb981gd3b4eb9e50cf"
msgid "Not now, I have to get back!"
msgstr "지금 말고요, 전 돌아가야 해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Player
#. NodeID = 5dbe0b25-c6a0-f840-c851-25490d4c9478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:5dbe0b25-c6a0-f840-c851-25490d4c9478
msgctxt "hde359693gf819g427fga1f6g6c4276e1e5d7"
msgid "You were caught, and you could have been killed."
msgstr "너는 붙잡혔고, 살해될 수도 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = 6e51e0f3-2a22-be6f-ed43-1acf505e1ce3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Kid(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Kid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:6e51e0f3-2a22-be6f-ed43-1acf505e1ce3
msgctxt "hb84904cdg9764g4d1eg979cg1118703c92d9"
msgid "Ugh. I'm never gonna hear the end of this."
msgstr "으. 잔소리를 한없이 듣겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = 75d64fdf-5cd8-d3a6-8ee0-7769ca8aace7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:75d64fdf-5cd8-d3a6-8ee0-7769ca8aace7
msgctxt "h8c525620gc2c2g4729gb900g9fd6e49f42b0"
msgid "Least I tried. No one else was doing anything!"
msgstr "적어도 저는 노력했잖아요. 다른 사람들은 아무것도 안하고 있었어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = 9117f8b0-56b3-5dc3-b314-7888dc91bce2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentAIsDead = True
#.      - IMPOSSIBLE = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:9117f8b0-56b3-5dc3-b314-7888dc91bce2
msgctxt "hba07251fg1ddcg4bacgae22g78bea62321a1"
msgid "I can't believe he's gone. I can't believe they'd do this to us!"
msgstr "아빠가 돌아가셨다니, 믿을 수 없어요. 우리한테 이런 짓을 했다니 믿을 수가 없다구요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = b2646aa9-8e51-1fc2-9ab7-c6e8a9dff990
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_BothParentsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:b2646aa9-8e51-1fc2-9ab7-c6e8a9dff990
msgctxt "ha57c9128gbfb1g491eg9d9eg01cf0d4f38d6"
msgid "They're dead. What'll I do now..."
msgstr "두 분 다 죽었어요. 나 이제 어떡해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = cfb6c135-5ec4-4a5f-524c-87202fc865c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:cfb6c135-5ec4-4a5f-524c-87202fc865c5
msgctxt "h7aedf0b2g0360g45deg92d8g94c540b4c712"
msgid "They were talking when the druids were getting ready to throw us out."
msgstr "드루이드들이 우릴 내쫓으려 하는데도 대화하려고 했잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Player
#. NodeID = d7ac1616-293d-af76-988d-a530cf0fda84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:d7ac1616-293d-af76-988d-a530cf0fda84
msgctxt "h8b25814dgc3c5g4649g9a5ag6c08edb512b2"
msgid "No, you'd be a thief."
msgstr "아니, 너는 도둑이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = df037664-cce9-71bb-639e-32776f9700cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:df037664-cce9-71bb-639e-32776f9700cb
msgctxt "heb2db90fg14b1g4985g9232g59260cf96b4b"
msgid "If I'd got that stupid idol, I'd be a hero."
msgstr "제가 그 멍청한 우상을 얻었다면, 영웅이 될 수 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = f52e6188-b3ec-d4a7-f2b9-081ba3326810
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:f52e6188-b3ec-d4a7-f2b9-081ba3326810
msgctxt "h4cc53f3fgca91g47bagbf37gd818d5ca3e59"
msgid "A heroic thief! Mum, Dad, Mol - they all would've been so impressed."
msgstr "영웅적인 도둑이죠! 엄마, 아빠, 몰 - 모두 감명 받았을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed
#. Speaker = Arabella
#. NodeID = fd00f956-9a22-0779-fd38-76fa8945567d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Kid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_KidFreed:fd00f956-9a22-0779-fd38-76fa8945567d
msgctxt "h7f9a1dd6g55eeg4183g9f73g2375cf1dc88b"
msgid "We're not gonna be safe. Not now, not ever."
msgstr "우리는 안전하지 못할 거야. 지금은 물론, 앞으로도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 02f98110-66d7-97b2-751b-bb654f345ca6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:02f98110-66d7-97b2-751b-bb654f345ca6
msgctxt "h59a44a0cg134eg4f88gbc01g4cc21ee30571"
msgid "What does forcing them out achieve? They've done nothing."
msgstr "난민들을 쫓아내서 무슨 득이 있는 거야? 아무 잘못도 안 했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 03348476-16ae-0b68-718e-7755a930ea92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:03348476-16ae-0b68-718e-7755a930ea92
msgctxt "ha3929239g0ce9g4c21g9d09gd63ca752dbbe"
msgid ""
"Don't we? I've studied duergar culture. You have an instinct for survival."
msgstr "그런가? 난 듀에르가 문화를 연구했어. 너희는 생존 본능이 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 04ef1d63-ad37-8542-a81c-96a642bb1c71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:04ef1d63-ad37-8542-a81c-96a642bb1c71
msgctxt "hb05f6f44gfc22g4ca0gb66dga8532fa8f61a"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 05cc07d1-5252-f384-6a14-c3c0e01ef729
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:05cc07d1-5252-f384-6a14-c3c0e01ef729
msgctxt "h4622cbc7g1830g41b1g8371g1b3d66b2f2cb"
msgid "You are like the devils. Where they tread, chaos follows."
msgstr "그대는 데빌과 같다. 데빌이 밟는 길에는 혼돈이 따르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Lae'zel
#. NodeID = 05e7cd4b-3fa1-860f-9b33-7bbcce6aa415
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:05e7cd4b-3fa1-860f-9b33-7bbcce6aa415
msgctxt "h5d08ae89g60fcg4ec2g9eafg3f3c47bc8ffa"
msgid "Stay your hand. This is neither the time nor the place."
msgstr "가만히 있어라. 때와 장소 둘 다 적절치 않다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 064ef53e-0b7a-6190-d5a8-6449b1c97caf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:064ef53e-0b7a-6190-d5a8-6449b1c97caf
msgctxt "h323f3eb6g885cg4d35g9b9cga517bce9ae04"
msgid "I'm nothing like you - I don't kill children."
msgstr "난 당신과 달라 - 난 아이를 죽이지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 0ea7a6da-7a10-e08f-fd09-227bb92a499c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:0ea7a6da-7a10-e08f-fd09-227bb92a499c
msgctxt "hcf348b33g6b1dg416cg8183g9598b723fbaf"
msgid "<i>She made her choice.</i>"
msgstr "<i>그녀가 택한 일이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 0ee5e5b2-027b-f16e-ba62-dae27f923e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:0ee5e5b2-027b-f16e-ba62-dae27f923e3b
msgctxt "h177f7bb9gdab8g40d6g8134g019c27466c97"
msgid ""
"'A disease of the flower must not reach the root. Pluck the petals. Sever "
"the branch if you must. But cut out the rot before it infects the whole of "
"the wood.'"
msgstr ""
"'꽃의 질병이 뿌리까지 퍼져서는 안 된다. 필요하다면 꽃잎을 뽑고, 가지를 절단해라. 나무 전체가 감염되기 전에 썩은 부분을 잘라내야 "
"한다.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 0fd98895-6305-0923-e525-5e57a2d6f280
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_HasMet_ReactedToSnakeCourt = False
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:0fd98895-6305-0923-e525-5e57a2d6f280
msgctxt "h59fc3fd4g7d07g4ab6ga6b2g685d5fb66481"
msgid ""
"A deep elf - in our grove, on this day. A sign. Or rather, a <i>gift</i>."
msgstr "지하 엘프라니, 우리 숲에, 바로 이 날에. 징조로다. 아니면, <i>선물</i>이거나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 11edaa6c-96ac-109c-1fbd-d73b0cd5b920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:11edaa6c-96ac-109c-1fbd-d73b0cd5b920
msgctxt "h17a8713ag660cg4d21ga29cgbe47032c5cb0"
msgid "I'll see what can be done about them."
msgstr "취할 수 있는 조치가 있는지 살펴보도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 131145e1-30f6-ab07-ab80-3f0506e138e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:131145e1-30f6-ab07-ab80-3f0506e138e1
msgctxt "had2a640dgf3d2g42d4gbabag30100c8d7ac8"
msgid "Then I was wise to grant you entry. And you'd be wise to heed my words."
msgstr "역시 그대에게 출입을 허락한 내 결정은 현명했다. 그리고 그대는 내 말에 귀 기울이는 편이 현명할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 158dbefa-d622-638f-7de4-7f4e156b4637
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_RecruitmentLetter = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:158dbefa-d622-638f-7de4-7f4e156b4637
msgctxt "h2b18c632g83fbg4762g846agbcfc6cfb2347"
msgid "I know the truth. You mean to take the grove for the Shadow Druids."
msgstr "나는 진실을 알고 있어. 네가 그림자 드루이드에게 이 숲을 바치려 한다는 것을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 19c0557b-245a-d3f7-4a14-7ae7a1c00aea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:19c0557b-245a-d3f7-4a14-7ae7a1c00aea
msgctxt "h2a8a420dg1aceg4d99gaf89gc5c6acecb095"
msgid "You'd leave them to die on the road."
msgstr "넌 그들이 길가에서 죽게 만들 셈이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 19f490bd-2294-7982-a6d8-a507ff548284
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:19f490bd-2294-7982-a6d8-a507ff548284
msgctxt "h03205028g629ag4693gb5e5gf67069fbf753"
msgid "So you say. Yet the child walks free."
msgstr "말은 그렇게 하지만, 도둑 꼬마를 데려가는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 1a31e511-b24a-59cb-5161-b5beadb47318
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_KaghaToldRite(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_KaghaToldRite(1) = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:1a31e511-b24a-59cb-5161-b5beadb47318
msgctxt "h01bc2e94g62eeg4a08g97ecg4ba125611384"
msgid "Is this rite druidic? I have never witnessed such magic."
msgstr "의식이 드루이드식이긴 한가? 나는 이런 마법을 본 적이 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 1a31e511-b24a-59cb-5161-b5beadb47318
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_KaghaToldRite(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_KaghaToldRite(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:1a31e511-b24a-59cb-5161-b5beadb47318
msgctxt "h22ac67f5g6a25g48b1g876bg284291e2ce81"
msgid "This rite must be born of powerful magic."
msgstr "이 의식에는 강력한 마법이 필요하겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 1b25ad01-695d-4e52-8717-f41fca72a41b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:1b25ad01-695d-4e52-8717-f41fca72a41b
msgctxt "hb8fe8126gc927g475agb31eg25bd81d7caa5"
msgid "Teachings of the Treefather. Do you agree?"
msgstr "나무 아버지의 가르침이다. 동의하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 1c2c22fd-dce8-e1d6-e4e8-efb159f89ecc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:1c2c22fd-dce8-e1d6-e4e8-efb159f89ecc
msgctxt "h072d33c2g60eag4429g8cc3gc975a9a40de0"
msgid ""
"But if your treatment is meant to outlast the rite, you'll be removed with "
"the rest."
msgstr "허나 네 치료가 의식을 마치고도 안 끝난다면, 나머지 것들과 마찬가지로 쫓겨날 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 1e004981-9cac-cf74-aca9-837fb8698588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:1e004981-9cac-cf74-aca9-837fb8698588
msgctxt "h951c0fafg2761g4991gac44gd0115827be71"
msgid ""
"A viper bares her fangs defending her brood. I call her mother. You call her "
"monster."
msgstr "독사는 송곳니를 드러내며 새끼를 지킨다. 나는 그녀를 어머니라고 부른다. 그대는 괴물이라고 부르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 2179ec95-9d94-d5b4-1464-4e7869cf9e2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Tag:
#.      - DRUID(1) = False
#.      - REALLY_WOODELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:2179ec95-9d94-d5b4-1464-4e7869cf9e2d
msgctxt "h052468aagd8aeg4e72ga689gb8cdeb3d2bfe"
msgid "Turning your back on the needy - is this truly the way of Silvanus?"
msgstr "도움이 필요한 사람에게 등을 돌리는 것이 진정 실바누스의 방식인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 223ffda9-88bf-bcb2-8060-e99362c955ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:223ffda9-88bf-bcb2-8060-e99362c955ac
msgctxt "h9aa49069gd9eag4ea8ga932g9d6da4deb406"
msgid "Indeed? But you do exhibit a talent for self-preservation."
msgstr "그러한가? 하지만 너는 자기 보존의 재능을 유감없이 발휘하고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 23c02534-1082-3091-60f1-6f2c63db078b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLeader_Event_ToldCrime = False
#. SetFlags:
#.   Global:
#.     - DEN_DruidLeader_Event_ToldCrime = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:23c02534-1082-3091-60f1-6f2c63db078b
msgctxt "h6dd4244egee37g48a3g883egdcd23000e9b5"
msgid "That child - what was her crime?"
msgstr "저 아이, 죄목이 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 23cfad5d-fd7b-5c7f-d6ef-2f02c90c5a7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidFreed = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_CalledSaghaMonster(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:23cfad5d-fd7b-5c7f-d6ef-2f02c90c5a7d
msgctxt "ha9f75734g7527g486fg8e4fg65db16e6d3b1"
msgid "Only a monster would threaten a child."
msgstr "괴물만이 아이를 위협하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 23fbf919-afda-6f8d-163c-8a4f7b6dd046
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:23fbf919-afda-6f8d-163c-8a4f7b6dd046
msgctxt "he1354df1gb391g4ab8gb40bg53d909356d47"
msgid "Indeed? Then above all, you must have a talent for self-preservation."
msgstr "그러한가? 그러면 무엇보다도, 자기보존의 재능이 있어야만 하겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 24689429-86c1-ca30-b378-4cf1774e914a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Leader(1) = True
#.   Global:
#.      - DEN_GroveConflict_Quest_DeniedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:24689429-86c1-ca30-b378-4cf1774e914a
msgctxt "hb909defegfd5dg4010g8046g414c21c8c3c5"
msgid "Away. I have no more need of you."
msgstr "가라. 너는 더 이상 필요 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 255024ef-356b-5eed-02c6-f2d6c0bae9e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:255024ef-356b-5eed-02c6-f2d6c0bae9e7
msgctxt "h869505fdgdbe6g4499gb744g2368c03010da"
msgid ""
"A shame the grace period ends. The viper's fangs have been bared. She must "
"guard her brood."
msgstr "아쉽지만 자비의 시간은 이제 끝이야. 독사는 이미 송곳니를 드러냈다. 자신의 새끼를 지켜야 하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Karlach
#. NodeID = 280bcee5-c955-515c-f311-4be27bc4c4a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:280bcee5-c955-515c-f311-4be27bc4c4a5
msgctxt "h6966f282gb737g4aacg9159gf397d8ca3651"
msgid ""
"Hang on. If we play this right, we might be able to stop this before it "
"starts."
msgstr "잠깐만. 우리가 잘만 하면, 시작도 하기 전에 막을 수 있을지 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 28a1df78-1ff4-51a6-eae9-2fa9b773bd08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:28a1df78-1ff4-51a6-eae9-2fa9b773bd08
msgctxt "h41788fcag634ag4a92gbceag9cd39b4b5e99"
msgid ""
"Who better to understand a watchful broodmother than a beloved child of "
"Lolth?"
msgstr "조심스러운 무리 어미의 마음가짐을 롤쓰의 사랑스러운 자식보다 더 잘 이해할 이가 누가 있단 말인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 2b045d31-e2be-611e-97ed-3c64588dd3cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:2b045d31-e2be-611e-97ed-3c64588dd3cb
msgctxt "hbe365b59g7116g4e2dg8e9fg494823d93b28"
msgid "I'd have killed the thief outright."
msgstr "나였다면 그 도둑을 바로 죽여버렸을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 2ce84628-a809-0d04-b921-8a01bf3a1faf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_KaghaToldRite(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_KaghaToldRite(1) = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:2ce84628-a809-0d04-b921-8a01bf3a1faf
msgctxt "hf78e8035gf4f4g48c6g91a6g1f0380acd36b"
msgid "Is this rite druidic? I have never witnessed such magic."
msgstr "의식이 드루이드식이긴 한가? 나는 이런 마법을 본 적이 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 2ce84628-a809-0d04-b921-8a01bf3a1faf
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_KaghaToldRite(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_KaghaToldRite(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:2ce84628-a809-0d04-b921-8a01bf3a1faf
msgctxt "hdb3203a9g5efcg4165ga45dgb5ccc53bea53"
msgid "This rite must be born of powerful magic."
msgstr "이 의식에는 강력한 마법이 필요하겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 2d6ffbc2-07fe-2fcb-8240-ea0d3117d122
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_SaghaMentionedArmy(1) = True
#.   Global:
#.     - DEN_GroveConflict_Knows_KaghaSentToZevlor = True
#.   Quest:
#.     - DEN_Conflict.MetKagha(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:2d6ffbc2-07fe-2fcb-8240-ea0d3117d122
msgctxt "ha9c32817g481dg4350g92bcge460894a5604"
msgid ""
"I want you to provide your services to the tiefling leader - Zevlor, he's "
"called. Offer to guide the outlanders out of the grove. I'm sure they'll "
"reward you well."
msgstr "네가 제블로어라는 티플링 지도자를 도와주길 바란다. 그 외지인들을 숲 밖으로 인도해줄 거라 제안해. 그들이 보상을 잘 쳐줄테다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 32c614f5-76d7-9ef2-738b-007b87bb71c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_SnakesCourt_Event_TriedtoPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:32c614f5-76d7-9ef2-738b-007b87bb71c6
msgctxt "haa38bb7cg673ag4c89g97b1gcabdac17c3d9"
msgid ""
"And still you petitioned on her behalf. Your words are vicious, yet you "
"showed mercy."
msgstr "그런데도 그 도둑 편에서 청원했구나. 사악한 말을 뱉고서는 자비를 보였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 33642984-ad7d-9364-c328-1caf1914ef6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Quest_AgreedToMurder = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:33642984-ad7d-9364-c328-1caf1914ef6c
msgctxt "h5aa795bag0b1fg4099ga408gf9bf31745062"
msgid "Zevlor wants you removed. I'm here to see it done."
msgstr "제블로어는 너를 제거하길 원한다. 나는 이를 이루기 위해 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 33c97a10-653e-1d77-49a9-39956a2b2ab5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: CLERIC_EILISTRAEE or PALADIN_EILISTRAEE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:33c97a10-653e-1d77-49a9-39956a2b2ab5
msgctxt "he7522796g4c7cg4a66ga99cg1bf276458af9"
msgid "I worship Eilistraee - <i>not</i> the Queen of Spiders."
msgstr "나는 에일리스트레이를 섬긴다. 거미 여왕 <i>말고</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 34500da3-3688-1553-61d5-51d1baab600b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_CalledSaghaMonster(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:34500da3-3688-1553-61d5-51d1baab600b
msgctxt "h780946bcgf9eeg45d5gaae4g0c09c8a11c9c"
msgid "Do you expect pity? You killed a child in cold blood."
msgstr "동정을 기대하나? 넌 냉혈하게 아이를 죽였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 3524cec4-4567-95a5-3bcd-3fa378255b29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaKnowsZevlorDead = False
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_KaghaKnowsZevlorDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:3524cec4-4567-95a5-3bcd-3fa378255b29
msgctxt "hb115d034g9604g4357g893aga7b483d73804"
msgid "Zevlor is dead."
msgstr "제블로어는 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 3c5bdf9e-4e4e-842c-c7f7-33f1fd085b4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#.      - DEN_GroveConflict_Quest_DeniedKagha = False
#.      - DEN_GroveConflict_Quest_AcceptedKagha = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:3c5bdf9e-4e4e-842c-c7f7-33f1fd085b4e
msgctxt "hefdc0916gfe6cg4c4eg9150g69f4d1e93958"
msgid "Zevlor's people need refuge. You can't deny them that."
msgstr "제블로어의 난민들은 피난처가 필요해. 그걸 부정할 순 없을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 3ee96dd2-f75b-2cbe-c188-cbede0cb961b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:3ee96dd2-f75b-2cbe-c188-cbede0cb961b
msgctxt "h8975f22ag3937g4529gbe6dg51fef9136cbc"
msgid "Monsters both, then. Viper to viper."
msgstr "우리 둘 다 괴물인 것 같군. 독사 대 독사야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 40be5134-aa64-258c-a134-015924b58533
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:40be5134-aa64-258c-a134-015924b58533
msgctxt "hf5d5d6afg4416g41degb545gf7d83c681020"
msgid ""
"Who better to understand a watchful broodmother than one who hails from... "
"<i>below</i>?"
msgstr "조심스러운 무리어미의 마음가짐을 <i>아래</i>에서 온 자가 아니면 누가 더 잘 이해할 수 있단 말인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 411501be-09e8-7d07-ecc2-48f1c1d39637
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.ToldKaghaZevlorDead_After(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:411501be-09e8-7d07-ecc2-48f1c1d39637
msgctxt "hcf62f955gde43g4c17g9690g85bc8160f1fa"
msgid "Indeed? Then when the lightning comes, it has one fewer to strike."
msgstr "그러한가? 그러면 번개가 칠 때 맞을 자가 한 명 줄었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 439b533c-5ef6-cccb-08bc-57a8e21fd9cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:439b533c-5ef6-cccb-08bc-57a8e21fd9cc
msgctxt "hd5262d5dg1d26g4a59gb65fg6ccf4bc9b18f"
msgid "She stole the Idol of Silvanus during prayer, and interrupted the rite."
msgstr "그 아이는 기도 중에 실바누스 님의 우상을 훔쳤고, 의식을 방해했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 44e87cfd-bac2-71fb-ef30-ebdc64a77ca5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WOODELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:44e87cfd-bac2-71fb-ef30-ebdc64a77ca5
msgctxt "ha6b53102gf2a0g4f6cga540gcd5bb86f375c"
msgid "Teachings of Silvanus, you must agree."
msgstr "실바누스님의 가르침이다, 너는 따라야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 464677fe-eea8-b8ab-3464-132222e26309
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e7d06055-c350-1740-92a0-7deb7b9744c0_ZevlorSent = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:464677fe-eea8-b8ab-3464-132222e26309
msgctxt "hce3d413dg425bg4b3bg803agd650c3890d0f"
msgid "A clear choice, I would say."
msgstr "당연한 선택이라고 할 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 47d2f374-e763-4cbc-ad38-55915d0a11ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:47d2f374-e763-4cbc-ad38-55915d0a11ec
msgctxt "h4ed8ad4ag53aag48bdga74bg17085254d1c9"
msgid ""
"You showed great mettle at the gate - the mettle of a skilled sword for hire."
msgstr "그대는 관문 앞에서 숙련된 용병의 강한 패기를 보여주었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 48860188-0804-b496-eafb-b5b258e75913
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BESTIAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:48860188-0804-b496-eafb-b5b258e75913
msgctxt "h205eb139g6071g4901g83bcg630e3b648c10"
msgid "Monsters both, then. Viper to viper. Beast to beast."
msgstr "우리 둘 다 괴물인 것 같군. 독사 대 독사, 짐승 대 짐승이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 4cdd65fe-cd2b-0f5a-c9a0-f218e6d325ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:4cdd65fe-cd2b-0f5a-c9a0-f218e6d325ec
msgctxt "h975aab4bg4297g4327gabb3g190e5d097dd0"
msgid "You will do more than 'see'."
msgstr "'알아보기' 이상의 일을 해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 4ea14700-07af-ff2a-b326-3fdb3d749e38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:4ea14700-07af-ff2a-b326-3fdb3d749e38
msgctxt "hf1e92941gd1f2g47fcg87ecg2aab95b3427c"
msgid "I don't make a habit of threatening children."
msgstr "난 아이들을 위협하는 걸 좋아하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 4fca7a31-86e9-9930-2f4c-344610380633
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Leader(1) = True
#.   Global:
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:4fca7a31-86e9-9930-2f4c-344610380633
msgctxt "h3b21a5e6g23c7g4d36ga177g1c02671c4186"
msgid "Why are you here? I sent you to Zevlor."
msgstr "왜 여기 있느냐? 내가 제블로어에게 보냈을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 56841814-f5c5-395f-d8c7-a10eda4848b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Event_RemoveWildShape = True
#.     - DEN_ShadowDruid_Event_StartDenouncingScene = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:56841814-f5c5-395f-d8c7-a10eda4848b2
msgctxt "hb0bb07acgf6b7g4d90g9b73g42abc7160249"
msgid "<i>What?</i>"
msgstr "<i>뭐?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 588fb06e-b146-4aba-51dd-6052fa5abdc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Leader(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaKnowsZevlorDead = True
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:588fb06e-b146-4aba-51dd-6052fa5abdc6
msgctxt "h4e927c4dg5e6fg4488ga1f5g99879d2bb2c1"
msgid "Why are you here?"
msgstr "여긴 왜 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 590ea579-8bc1-0620-ef11-58b798b0f2e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:590ea579-8bc1-0620-ef11-58b798b0f2e9
msgctxt "h2e9b78f3gf660g4be4g99f8gf3bb81cecb9c"
msgid "Ah - you don't see a monster. You just look at me through one's eyes."
msgstr "아, 그대는 괴물을 보지 못하는구나. 그저 누군가의 시선을 통해서 나를 바라볼 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 5955fbe8-16f9-6dcc-eb97-7fd97014f0c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLeader_Event_ToldCrime = False
#. SetFlags:
#.   Global:
#.     - DEN_DruidLeader_Event_ToldCrime = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:5955fbe8-16f9-6dcc-eb97-7fd97014f0c4
msgctxt "hab15e851g48b4g4de0gb301g973a3114f468"
msgid "Free from the threat of little children?"
msgstr "작은 어린이의 위협에서도 벗어나고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 5a4c1c02-a806-3c2e-cd59-4a9b1ba8d35d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:5a4c1c02-a806-3c2e-cd59-4a9b1ba8d35d
msgctxt "h33cdcb0ega86dg4057g995egff90db8b08db"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 5ab0c360-cd50-b9e8-8e90-c26f6371bfb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_HasMet_ReactedToSnakeCourt = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:5ab0c360-cd50-b9e8-8e90-c26f6371bfb3
msgctxt "h65756d57g0843g47a3g9e37gc0b6e6b05bf0"
msgid "Go on. Say it. You think I'm a monster."
msgstr "어서, 말해 봐라. 그대가 날 괴물이라 생각한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 5af3c980-c4ac-a07b-4482-2d7c516e9e3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_PlayerKeptSilent = False
#.   Tag:
#.      - TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:5af3c980-c4ac-a07b-4482-2d7c516e9e3b
msgctxt "he1515d9bg583bg4c03gacb5gb4929c79c57f"
msgid ""
"First you urge grace. Then you speak truth. You've surprised me twice over."
msgstr "처음에는 나에게 자비를 촉구하더니 그 다음에는 진실을 말하는군. 그대는 나를 두 번 놀라게 하는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 5d02f147-7944-575b-771b-fa3a82d6d497
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_KnowsPlayerDruid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:5d02f147-7944-575b-771b-fa3a82d6d497
msgctxt "hf784fd28g0bd5g4746ga5fdgd31bd178095c"
msgid "I know your kind from other circles. You see only villains and victims."
msgstr "나는 다른 회합의 그대 같은 부류를 잘 알고 있다. 오직 악당과 희생양밖에 보지 못하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Wyll
#. NodeID = 611f3488-abee-47af-827c-b2d71616e230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:611f3488-abee-47af-827c-b2d71616e230
msgctxt "h79869e45g690ag444ag940cgd19fbcec4708"
msgid "Think it through. Anger Kagha, and the whole grove could suffer."
msgstr "잘 생각해. 카그하를 화나게 하면, 숲 전체가 고통받을 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 62457980-177b-6dd5-0288-d08dacd60871
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:62457980-177b-6dd5-0288-d08dacd60871
msgctxt "hcbc4f56ag0e0dg494eg922eg386caf2d01c1"
msgid "Please - we have <i>nothing</i> in common."
msgstr "제발 - 우린 비슷한 점이 <i>하나도 </i>없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 63b431ff-cfab-a13e-383d-9f178e0a0e7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:63b431ff-cfab-a13e-383d-9f178e0a0e7a
msgctxt "ha9d748d6g0432g4c88g8532gfb1fd1e7c680"
msgid "So you say. Yet you share their infernal blood."
msgstr "그렇게 말하는구나. 하지만 너는 그들과 지옥의 피를 나눴지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 645e21ec-3434-fee3-e567-32dcb600ea99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BESTIAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:645e21ec-3434-fee3-e567-32dcb600ea99
msgctxt "h8123e050gea2fg4cc6gadf5gaad66e3c0e51"
msgid "You've the skin of a beast. If only your heart was so bold."
msgstr "넌 짐승의 피부를 가졌구나. 너의 마음도 그리 대담했더라면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 64864add-2ccc-98eb-9682-b3914f260df2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:64864add-2ccc-98eb-9682-b3914f260df2
msgctxt "h51bcbb6fge961g47a5gbc20g73053fcbf8e3"
msgid "Speak, while there's time."
msgstr "시간이 있을 때 말해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 67e24e24-66df-06a2-78b0-ef56c31425a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#.   Tag:
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:67e24e24-66df-06a2-78b0-ef56c31425a7
msgctxt "h08f1ac69ge038g4f73gb1b1g32c73b8d8521"
msgid "What does forcing them out achieve? They've done nothing."
msgstr "난민들을 쫓아내서 무슨 득이 있는 거야? 아무 잘못도 안 했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 6a5001ed-4043-e079-ce11-3f00689a267f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#.      - DEN_GroveConflict_Quest_AcceptedKagha = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:6a5001ed-4043-e079-ce11-3f00689a267f
msgctxt "h47e7d08dge448g40ceg8e05g8fb1beed0f48"
msgid ""
"I came on Zevlor's behalf. His people could perish if you force them out."
msgstr "나는 제블로어를 대신해서 왔어. 당신이 그의 난민들을 내쫓으면 그들이 몰살당할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 6aeacfce-6ce6-90d2-4c07-e26a502a710b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:6aeacfce-6ce6-90d2-4c07-e26a502a710b
msgctxt "h6b849e46g696ag4aa7gb1b6g06cc37babb91"
msgid "Nothing? They've done <i>everything</i>."
msgstr "잘못한 게 없어? 놈들이 <i>온갖</i> 만행을 저질렀다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 6d9a0141-27b5-4c2b-a710-244449f21935
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Tag:
#.      - DRUID(1) = False
#.      - REALLY_WOODHALFELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:6d9a0141-27b5-4c2b-a710-244449f21935
msgctxt "h3d4a867dg4752g4ce8ga88dg1710e1c56bc9"
msgid "Turning your back on the needy - is this truly the way of Silvanus?"
msgstr "도움이 필요한 사람에게 등을 돌리는 것이 진정 실바누스의 방식인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 6ee49310-b8ca-d895-c360-87bac2e4aa74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaKnowsZevlorDead = False
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_KaghaKnowsZevlorDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:6ee49310-b8ca-d895-c360-87bac2e4aa74
msgctxt "h06c3aa4bg61b1g4a70g8adbg53158a5f76f1"
msgid "The viper can stand down. Zevlor is already dead."
msgstr "독사는 나설 것 없겠어. 제블로어는 이미 죽었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 70553541-c6b8-abde-1237-b161074d03c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Local:
#.      - e7d06055-c350-1740-92a0-7deb7b9744c0_Crimetrack = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:70553541-c6b8-abde-1237-b161074d03c9
msgctxt "hb4ff9cecg171bg4b15gac06gf3486fcf02a6"
msgid "Do what you want. It's none of my concern."
msgstr "하고 싶은 대로 해. 내가 상관할 바 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 70fd604c-85f6-7d43-e98a-bab6cc890a23
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_AcceptedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:70fd604c-85f6-7d43-e98a-bab6cc890a23
msgctxt "h90b54f1fgbf13g4a3cga2b0g2ebec83bbe64"
msgid "You will do more than speak."
msgstr "대화만으로는 안될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 710686fb-a25e-7460-bfb8-829addfba760
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_HasMet_ReactedToSnakeCourt = False
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:710686fb-a25e-7460-bfb8-829addfba760
msgctxt "heb363d9agc8abg483bga132g98057d376c9a"
msgid ""
"A grey dwarf - in our grove, on this day. A sign. Or rather, a <i>gift</i>."
msgstr "오늘 같은 날에, 우리 숲에 회색 드워프라니. 징조로다. 아니면, <i>선물</i>이거나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 72a991fa-02f8-e4f8-1293-6b889ced41df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:72a991fa-02f8-e4f8-1293-6b889ced41df
msgctxt "h1e648a08gc7aeg4f6ega7bagbfb1e8881460"
msgid ""
"This tale ends but one way: with the outlander rot cleansed and the grove "
"forever shrouded."
msgstr "이 이야기엔 단 하나의 결말만이 있다. 이방인의 부패는 정화되고 숲은 영원히 숨겨져 보호받을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 77a50722-82ff-9402-1c51-4b8f41215da4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruidLeader_Event_AttackAfterConvince = False
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruidLeader_Event_AttackAfterConvince = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:77a50722-82ff-9402-1c51-4b8f41215da4
msgctxt "h8188b74agcefeg4ea2ga2d0g83f47dab407b"
msgid "<i>Reach for your weapon.</i>"
msgstr "<i>무기에 손을 뻗는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 78b4f5b8-1a0b-5a10-b42b-b034264c3912
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:78b4f5b8-1a0b-5a10-b42b-b034264c3912
msgctxt "h1eae6a58g54afg4e92gbe1age593d3eb0b04"
msgid "I am First Druid now. I protect the circle, whatever the cost."
msgstr "나는 이제 최고 드루이드가 되었다. 무슨 대가를 치러서라도 이 회합을 보호하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 7be533e7-ad17-80b2-a7a5-e7b36bfa9639
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_State_CourtHostile(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:7be533e7-ad17-80b2-a7a5-e7b36bfa9639
msgctxt "h0893d4ecg8de1g46c4g902fg4fc08e2eedad"
msgid "The outlander serves Zevlor! Circle - to arms. Let no parasite live!"
msgstr "이방인이 제블로어를 섬긴다! 회합이여, 무장하라. 기생충을 살려보내지 마라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 7dd3b3a1-470d-c554-0e37-23f005f777a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Leader(1) = True
#.   Global:
#.     - DEN_ShadowDruid_HasMet_ReactedToSnakeCourt = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:7dd3b3a1-470d-c554-0e37-23f005f777a1
msgctxt "h66961df3gdb72g46fcgb93bg1c9f4f52cdbb"
msgid ""
"Now the Idol of Silvanus is returned and the rite has resumed. We will seal "
"the grove. Free from harm. Free of <i>intruders</i>."
msgstr ""
"이제 실바누스님의 우상이 돌아왔고 의식은 재개될 것이다. 우리는 숲을 봉쇄하여 위험으로부터, <i>침입자들</i>로부터 벗어날 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 7e44f32c-5e31-f203-f74d-a42c4d67c32b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_HeardAboutRitual = True
#.   Object:
#.     - DEN_ShadowDruid_Knows_KaghaExplainedRite(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:7e44f32c-5e31-f203-f74d-a42c4d67c32b
msgctxt "h6f5538a0gaf1fg424bg9cc8g849b3043b02f"
msgid ""
"The Rite of Thorns. It is the Treefather's gift, that none come to harm. "
"When we speak the final prayer, the Great Vine will sprout forth."
msgstr ""
"가시의 의식이다. 아무도 해를 끼치러 오지 못하게 막아주는 나무 아버지의 선물이지. 우리가 마지막 기도를 드리면 거대한 덩굴이 싹을 틔울 "
"것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 7e485b3e-0b65-5617-eec8-57b6b3d3ca0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:7e485b3e-0b65-5617-eec8-57b6b3d3ca0d
msgctxt "h088a049fga1c9g45fcgb3d2g6f104e352d3e"
msgid ""
"The devilspawn imperilled my brood. I bared my fangs to defend it. Choice. "
"Consequence."
msgstr "저 데빌스폰이 내 무리를 위협했지. 난 송곳니를 드러내서 막았고. 선택에 따른 결과야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 7effed31-3ad0-3dca-4e80-58b541e10d98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:7effed31-3ad0-3dca-4e80-58b541e10d98
msgctxt "hab7e366ag8720g402aga20cga6cda1b2fe78"
msgid ""
"The others might consider this sacrilege. But we know the truth: it is "
"necessity."
msgstr "다른 자들은 이를 신성모독이라고 생각하겠지. 하지만 우리는 진실을 알고 있다. 이는 필요한 일이었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 825bc576-8cb7-b5d0-acbd-214fbf697d64
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e7d06055-c350-1740-92a0-7deb7b9744c0_Crimetrack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:825bc576-8cb7-b5d0-acbd-214fbf697d64
msgctxt "hbec781fbge6aag409dg99cegae6d26ee87e0"
msgid "Why, I don't know or care."
msgstr "왜 그랬는지는 나도 모르고 신경 쓰지도 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 83365619-fc70-cd70-8f48-c3ecfca05636
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_MeanAnswer(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:83365619-fc70-cd70-8f48-c3ecfca05636
msgctxt "ha8676206g52b1g4997g89aag17af1d7b5a21"
msgid ""
"Ah yes. You like to meddle. See what happens. So let me tell you what "
"happens next."
msgstr "아 그래. 너는 참견하길 좋아하지. 무슨 일이 일어날지 보고 싶어하고. 그러니 내가 다음에 무슨 일이 일어날지 말해주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 84f5a881-e37f-5adf-e022-2f8b99d4be33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:84f5a881-e37f-5adf-e022-2f8b99d4be33
msgctxt "hba600d3age215g4bf9ga507g3ae250c2113f"
msgid "You are like all the rest. Where devils tread, chaos follows."
msgstr "그대는 나머지 모두와 마찬가지다. 데빌이 밟는 길에는 혼돈이 따르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 85fa6528-178c-75ab-4afe-0f5de836ed19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:85fa6528-178c-75ab-4afe-0f5de836ed19
msgctxt "hb05cd929g333fg42f1g90f5g4c828e48c7e0"
msgid ""
"Yes - you <i>would</i> say so. I know your kind. You see only villains and "
"victims."
msgstr "그래 - 그대는 그리 <i>말하겠지</i>. 나는 그대 같은 부류를 잘 알고 있다. 오직 악당과 희생양밖에 보지 못하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 86b5e1ae-50b9-eb1b-6636-f3ebe5ea12b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_PlayerKeptSilent = False
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:86b5e1ae-50b9-eb1b-6636-f3ebe5ea12b1
msgctxt "h638c62b5gbe60g44eaga2e6ga29d97c59642"
msgid ""
"First you urge grace. Then you speak truth. To think a devil could surprise "
"me twice over."
msgstr "처음에는 나에게 자비를 촉구하더니 그 다음에는 진실을 말하는군. 데빌의 발상은 나를 두 번 놀라게 하는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 8c4e7996-71a4-f0d7-7de3-931732d0fdc2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#.      - TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:8c4e7996-71a4-f0d7-7de3-931732d0fdc2
msgctxt "h6efe0882g7a53g4a30ga0f2gf00fcbdbef9c"
msgid "You must let them stay. They've done nothing to harm you."
msgstr "난민들이 계속 머무르게 둬. 잘못한 게 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 8de137a6-1430-43e8-96db-f3b9c225f08b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:8de137a6-1430-43e8-96db-f3b9c225f08b
msgctxt "he783f9adg63b7g42e9g9465g5cc4a380a77c"
msgid ""
"None of this can happen while outlanders infect us. Silvanus <i>demands</i> "
"that we choke them out."
msgstr "우릴 오염시키는 불경한 이방인들이 물러가야 의식이 성공해. 실바누스께선 그들의 숨통을 짓누르길 <i>원하신다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 905bde68-7f3c-82e6-144f-e42706d40ef8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_TalkedProperUse(1) = False
#.   Global:
#.      - DEN_ShadowDruid_State_HadSelfReflection = True
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_TalkedProperUse(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:905bde68-7f3c-82e6-144f-e42706d40ef8
msgctxt "h6148440bg80ecg42e0g8789g47c31b927c18"
msgid "The Rite of Thorns is risky magic. Is it not banned in your circle?"
msgstr "가시의 의식은 위험한 마법이야. 당신의 회합에서도 금지된 것 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 91e17df6-4602-ad0d-b86a-6e0d6863e720
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:91e17df6-4602-ad0d-b86a-6e0d6863e720
msgctxt "he6729721g3854g47c5gacd4g09bc7a300c7a"
msgid "<i>Stand down.</i>"
msgstr "<i>물러난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 971a3141-8ade-5f3d-1c7c-ab15bcf99dac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:971a3141-8ade-5f3d-1c7c-ab15bcf99dac
msgctxt "h2496bc3eg1d6bg48bdg9087g6b8578bbe2f7"
msgid "I know your kind. You see only victims and villains."
msgstr "나는 그대 같은 부류를 알고 있다. 오직 악당과 희생양밖에 보지 못하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 98ff796c-bf1c-2fc4-9ef4-ad724774925a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:98ff796c-bf1c-2fc4-9ef4-ad724774925a
msgctxt "h5ebd2b8ag7257g4063g9606g4bb18e1597d2"
msgid "Accidents do not exist. There is only choice and consequence."
msgstr "사고라는 것은 존재하지 않는다. 선택과 결과만이 있을 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = 9a3dca97-8f38-6b40-82e1-7ee54c7edba9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Leader(1) = True
#.   Global:
#.     - DEN_ShadowDruid_HasMet_ReactedToSnakeCourt = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:9a3dca97-8f38-6b40-82e1-7ee54c7edba9
msgctxt "hc8403792g27bfg4307ga33fg827e771dfd58"
msgid ""
"I took back the Idol of Silvanus and the rite has resumed. We will seal the "
"grove. Free from harm. Free of <i>intruders</i>."
msgstr ""
"나는 실바누스님의 우상을 되찾았고 의식은 재개될 것이다. 우리는 숲을 봉쇄하여 해로부터 벗어날 것이다. <i>침입자들</i>로부터 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 9c01c41f-8064-3dcb-a613-dcd9472c07eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:9c01c41f-8064-3dcb-a613-dcd9472c07eb
msgctxt "hcb71ef9bg4872g406aga379ga62de73dffb7"
msgid "Your iron will is impressive - if a touch inflexible."
msgstr "네 강철 같은 의지는 인상적이군. 유연함이라곤 전혀 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = 9ceaa385-ebba-618c-a631-969ec29ec272
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:9ceaa385-ebba-618c-a631-969ec29ec272
msgctxt "h5dd77df6g59efg41efgacf4g4f91b90ce93e"
msgid "Words you have twisted to justify your cruelty."
msgstr "너는 잔혹함을 정당화하기 위해 말씀을 왜곡하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = a1f3f5d8-136b-547f-69ec-ebbb5a3ca733
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_SaghaMentionedArmy(1) = True
#.   Global:
#.     - DEN_GroveConflict_Knows_KaghaSentToZevlor = True
#.   Quest:
#.     - DEN_Conflict.MetKagha(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:a1f3f5d8-136b-547f-69ec-ebbb5a3ca733
msgctxt "h9ca51a81g5179g4798g8672g7c8d1220ffd3"
msgid ""
"You will offer your services to the tieflings' leader - Zevlor, he's called. "
"And you will guide the outlanders out of the grove."
msgstr "티플링 지도자, 제블로어라고 불리더군. 그에게 봉사해라. 그리고 이방인들을 숲 밖으로 안내해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = a21ea2ef-a95a-5739-2b45-4c6a97689764
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:a21ea2ef-a95a-5739-2b45-4c6a97689764
msgctxt "h6831fecdg8872g451bg826cgaff62543fb86"
msgid "Prattle all you want. The refugees aren't my concern."
msgstr "마음껏 떠들어. 난민들은 내 관심사가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = a428c114-b614-967a-d3e9-c7366ac47dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:a428c114-b614-967a-d3e9-c7366ac47dd3
msgctxt "h4ad5ab2agb479g4b79g9974g913b49041a70"
msgid "I hardly know every line of doctrine."
msgstr "가르침의 모든 구절을 알 수는 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = a4b03b85-4d91-6e5b-81e9-d7e22903174c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:a4b03b85-4d91-6e5b-81e9-d7e22903174c
msgctxt "hbb0b283bgb773g4770g84fag8ff8af0f6ff7"
msgid "Then it seems I'd best speak to Zevlor."
msgstr "제블로어와 얘기하는 게 좋을 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = a53803ad-47e7-40f8-3050-b23a46655b03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:a53803ad-47e7-40f8-3050-b23a46655b03
msgctxt "h46bb72a5g04b9g46d5ga772g8598fdc17b03"
msgid ""
"A viper bares her fangs defending her brood. Is it not her nature to strike "
"at invaders?"
msgstr "독사는 송곳니를 드러내며 새끼를 지킨다. 침입자를 공격하는 것이 그녀의 본성이 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = a7e3c5b1-4243-1eec-7c45-4422cd862f1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_DeniedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:a7e3c5b1-4243-1eec-7c45-4422cd862f1a
msgctxt "h065984e1g6179g4bcfg9d9ag4d0ab3369e75"
msgid "Then they soon know the sting of my venom."
msgstr "그렇다면 그들은 곧 내 독의 따끔거림을 알게 될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = ad7149eb-08b8-37cf-c83c-40b5eb2c791f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:ad7149eb-08b8-37cf-c83c-40b5eb2c791f
msgctxt "h6a3d12a8gc14dg4fc0g9916g40084c93e18b"
msgid ""
"Then you know I heed his wisdom. I protect the circle, whatever the cost."
msgstr "그렇다면 내가 그분의 지혜에 귀를 기울인다는 것도 알겠지. 어떤 대가를 치르더라도 이 회합을 지킬 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = b29abd91-93d2-efdc-8e35-22fb1bc49ac6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#.      - DEN_GroveConflict_Quest_DeniedKagha = False
#.      - DEN_GroveConflict_Quest_AcceptedKagha = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:b29abd91-93d2-efdc-8e35-22fb1bc49ac6
msgctxt "he709d76bg88f8g40f6ga0e0g4f5b712ceece"
msgid "Zevlor believes his people will perish on the road."
msgstr "제블로어는 그의 난민들이 길 위에서 몰살당할 것이라고 생각하던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = b5539742-3b9c-d3b2-d4cf-7f297240ca28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:b5539742-3b9c-d3b2-d4cf-7f297240ca28
msgctxt "h7aeff334g4a74g48abgb564gdeb1aa6523ef"
msgid "I know the Treefather's teachings as well as you."
msgstr "나도 너처럼 나무 아버지의 가르침을 잘 알고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = b664b921-daa7-8143-5e88-4da719e4dce4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#.   Local:
#.      - e7d06055-c350-1740-92a0-7deb7b9744c0_ZevlorSent = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:b664b921-daa7-8143-5e88-4da719e4dce4
msgctxt "h0affaa4fg5cc1g422bg9b3eg885012c9f731"
msgid "Zevlor sent me. His people won't survive out there."
msgstr "제블로어가 나를 보냈어. 그의 난민들은 그곳에서 살아남지 못할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = bc53c6d7-2273-3141-8966-36e219d5dfff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:bc53c6d7-2273-3141-8966-36e219d5dfff
msgctxt "hdbac06ffg71dag44b4g8e6dg343ca3dca28f"
msgid "You cast out the guiltless. You shame your order."
msgstr "너는 죄없는 자들을 내쫓으려 하고 있어. 너의 단체를 먹칠하는 행동이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = bcdf4f5f-8cb0-7657-56df-e44174842e7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:bcdf4f5f-8cb0-7657-56df-e44174842e7e
msgctxt "hc78fe039gf720g43ecg96e5g8d8ba40f7d3f"
msgid ""
"You speak in paradox. I care not for steel, but I know if it bends - it "
"breaks. I will not allow this grove to be broken."
msgstr ""
"넌 모순을 말하고 있다. 나는 강철에는 신경 쓰지 않지만, 그걸 구부리면 부러진다는 사실은 알고 있다. 나는 이 숲이 부러지도록 두지 "
"않을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = c03e45af-6026-0893-162a-5ff8f7c60a36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c03e45af-6026-0893-162a-5ff8f7c60a36
msgctxt "h587d6513ga7b6g4b57g9ca5gf6472891194c"
msgid ""
"Bah. I'd thought one like you might understand. When a threat makes itself "
"known, you <i>remove</i> it."
msgstr "하. 너라면 이해할 줄 알았는데. 위협이 나타나면 그걸 <i>제거</i>해야 하는 법이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = c1e35958-d69e-4d9d-4107-450340835d6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruidLeader_Event_AttackAfterConvince = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c1e35958-d69e-4d9d-4107-450340835d6b
msgctxt "hea0e8684g092ag4f6cgb39egab7aa899bae3"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = c20e93cd-d3f7-60b6-02fb-1ac224ead0ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c20e93cd-d3f7-60b6-02fb-1ac224ead0ea
msgctxt "h6618caa6g6419g468cgaa46g4a65ea94c848"
msgid ""
"So you say. Yet you share their infernal blood. And the child walks free."
msgstr "그렇게 말하는구나. 하지만 너는 그들과 지옥의 피를 나눴지. 아이는 자유롭게 걸어다니고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = c34c0060-0ce3-4dc1-b496-c3e5114045ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c34c0060-0ce3-4dc1-b496-c3e5114045ce
msgctxt "h3a75be9fg4f6eg4b41g8dd9g3ba103a02a61"
msgid "Yes?"
msgstr "뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Narrator
#. NodeID = c54ecf92-cd99-e98f-b197-4ebf2decdbaa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_HadSelfReflection = False
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c54ecf92-cd99-e98f-b197-4ebf2decdbaa
msgctxt "h4c4e8c96g0689g49edgbeb8gda7354fce679"
msgid ""
"*Past teachings come into focus. The Rite of Thorns is a rare practice, "
"outlawed in most circles for causing more harm than it eases.*"
msgstr ""
"*과거의 가르침이 떠오릅니다. 가시의 의식은 거의 볼 수 없는 의식입니다. 완화 효과보다 피해가 더 커서, 대부분의 회합에서 "
"금지되었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = c70e3aa5-98e5-9f7f-c704-65d455651822
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c70e3aa5-98e5-9f7f-c704-65d455651822
msgctxt "hb0918666g5d52g4010g9ff2g626f75c36d74"
msgid ""
"A viper bares her fangs defending her brood. Is it not her nature to strike "
"at invaders?"
msgstr "독사는 송곳니를 드러내며 새끼를 지킨다. 침입자를 공격하는 것이 그녀의 본성이 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = c77a0124-9202-1b3a-a0a7-952321d90586
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c77a0124-9202-1b3a-a0a7-952321d90586
msgctxt "h106714d2g5893g4f53g90d5g48e949b5d35c"
msgid "Have you finished your chatter? Then you will give me your ear."
msgstr "대화는 다 마쳤나? 그러면 내게 귀 기울여라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = c7d4e340-e6bf-2f71-d30c-dd779666f118
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_ToldSaghaOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c7d4e340-e6bf-2f71-d30c-dd779666f118
msgctxt "h9fbc961bgde31g467bg86b2g81f07dde97e9"
msgid "You can't just force these people out."
msgstr "이들을 그렇게 쫒아내버려선 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = c901b415-0f5f-d8b4-87f2-f997f806745c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:c901b415-0f5f-d8b4-87f2-f997f806745c
msgctxt "h7b3b5900g04eeg4344ga62eg55657e7d0f97"
msgid ""
"Don't we? I've studied drow culture. You have a talent for self-preservation."
msgstr "그런가? 난 드로우 문화를 연구했어. 너희는 자기 보존에 재능이 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = cc8705b8-fe72-972f-2c83-6993dd5e4642
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:cc8705b8-fe72-972f-2c83-6993dd5e4642
msgctxt "h636f2cefg729fg4a22gb1b7gc202de0f275a"
msgid "...the viper must strike."
msgstr "...독사가 물 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = ce29ba52-e032-71f9-2857-8566311b86d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:ce29ba52-e032-71f9-2857-8566311b86d0
msgctxt "hdacabf93gdcc1g4625gbf5ag855a2957c586"
msgid "Indeed? Then removing his people should provide you little challenge."
msgstr "정말인가? 그렇다면 그자의 족속들을 제거하는 것도 그대에겐 어렵지 않겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = cf981109-a5d1-a9f2-d4c2-736979683868
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_EILISTRAEE(1) = False
#.      - CLERIC_EILISTRAEE(1) = False
#.      - REALLY_LOLTHDROWELF(1) = False
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:cf981109-a5d1-a9f2-d4c2-736979683868
msgctxt "hc624431bg7079g406ag9654g4de48c7ac8df"
msgid "I have no love for the Queen of Spiders."
msgstr "난 거미 여왕을 좋아하지 않는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = d027e2e9-7902-5105-4002-bccb5e606635
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d027e2e9-7902-5105-4002-bccb5e606635
msgctxt "hf2079f8ega813g4713g9776g1f94a344b8e3"
msgid ""
"And if it is? Strangers are the scourge; the rite is the remedy. No laws can "
"change that."
msgstr "그렇다면? 이방인들은 재앙이고, 그 의식이 치료법이다. 어떤 법률도 그 사실을 바꿀 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Wyll
#. NodeID = d0df8317-aaa1-9ef5-7964-f87488042932
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e7d06055-c350-1740-92a0-7deb7b9744c0_DEN_ShadowDruid_Event_WyllInclusion = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d0df8317-aaa1-9ef5-7964-f87488042932
msgctxt "hb2f97df3ge991g4e4fga7ffg1819f6bd27d5"
msgid "Monster? Too kind. A demon, more like."
msgstr "괴물? 너무 순화했군. 데몬에 더 가깝지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = d100de5a-5b0e-8c43-cf4b-c43b3392e196
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_SaghaMentionedArmy(1) = True
#.   Global:
#.     - DEN_GroveConflict_Knows_KaghaSentToZevlor = True
#.   Quest:
#.     - DEN_Conflict.MetKagha(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d100de5a-5b0e-8c43-cf4b-c43b3392e196
msgctxt "hf78e1742g8a88g4a7bga907g49764955e28d"
msgid ""
"I want you to provide your services to Zevlor. Offer to guide the outlanders "
"out of the grove. I'm sure they'll reward you well."
msgstr "그대가 제블로어에게 도움을 주길 원한다. 이방인들을 숲 밖에서 안내해 주겠다고 제안해라. 분명 보상을 잘 해줄 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = d13c73e1-2822-46bb-0671-e3434f05901d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_PlayerKeptSilent = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d13c73e1-2822-46bb-0671-e3434f05901d
msgctxt "h1e12ecdag8f58g45d9ga7b5g928bf6ba7c95"
msgid "Not at all. That was quite a show."
msgstr "전혀 아니야. 꽤 좋은 볼거리였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = d236c9ef-649f-262f-fb98-d45b38f5269e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d236c9ef-649f-262f-fb98-d45b38f5269e
msgctxt "hf6e345cag932dg428dga5d7gd95a6b86bf84"
msgid ""
"First, you stay silent. Then, you speak truth. To think an outsider could "
"surprise me twice over."
msgstr "처음에는 침묵을 유지하더니, 이제는 진실을 말하는군. 외부인의 발상은 나를 두 번 놀라게 하는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = d23d5593-e3f7-b14a-2784-ca201a1c30c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d23d5593-e3f7-b14a-2784-ca201a1c30c7
msgctxt "h3f801038g9edcg4f45gb016g581c78b21a9d"
msgid "You're protecting your own - sometimes cruelty is required."
msgstr "당신은 자신의 것을 보호하고 있어. 때로는 잔인함이 요구되는 법이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = d25e3006-5a1f-3c10-171e-93cb9e41dba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d25e3006-5a1f-3c10-171e-93cb9e41dba8
msgctxt "ha46323d5g7102g456agac52g6b84241427ff"
msgid "You protected your own without hesitation - my compliments."
msgstr "당신은 망설임 없이 동족을 보호했어. 그건 칭찬할 만하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = d2de9afc-0e0f-160b-5d8b-b17b5e9a13b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d2de9afc-0e0f-160b-5d8b-b17b5e9a13b9
msgctxt "h48a607dbgbf69g49bfg8735gefd2c3522d29"
msgid "I've done enough. They're your problem, not mine."
msgstr "난 할 만큼 했어. 그자들은 네 문제지 내 문제는 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = d4944653-83cd-4a63-8dc0-dacda3c6d658
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_SnakesCourt_Event_TriedtoPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d4944653-83cd-4a63-8dc0-dacda3c6d658
msgctxt "h02b347b8gf424g4f56g9395gcdb2ac6f08f1"
msgid ""
"And yet you petitioned on the thief's behalf. A curious display of mercy."
msgstr "그런데도 도둑 편에서 청원했단 말이지. 자비를 표하는 방식이 흥미롭구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Gale
#. NodeID = d5cb5e67-d24b-9829-4714-75bf13ada7b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d5cb5e67-d24b-9829-4714-75bf13ada7b2
msgctxt "h345523a9g7f5cg459fg971egb00565cbac1d"
msgid "Hold. Give diplomacy a chance to do its job.<i></i>"
msgstr "잠깐, 외교적인 해결책에 기회를 좀 줘 보는 게 어때.<i></i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = d750193f-3358-5657-780f-3a91bfbd6e6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d750193f-3358-5657-780f-3a91bfbd6e6d
msgctxt "h5b4c5ba8ge3feg4586g97d4gf88d45b62d48"
msgid "They're to be gone before final prayer. If they are not..."
msgstr "저들은 마지막 기도 전에 떠나야 한다. 만약 그렇지 않으면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = d77a2ebe-5a16-ba42-bdb0-2f97225144ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:d77a2ebe-5a16-ba42-bdb0-2f97225144ab
msgctxt "he85f322ag5cfcg4e50g8960g11a5ef5f116a"
msgid ""
"Then we agree. Preservation is not luxury, it is not zealotry. It is "
"necessity."
msgstr "그렇다면 우린 생각이 같군. 생존이란 사치도, 신앙도 아니다. 필요지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Astarion
#. NodeID = dc506142-92aa-5f7e-e941-4504dbaf6239
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:dc506142-92aa-5f7e-e941-4504dbaf6239
msgctxt "hd6a8dd8cg14acg484eg9b8cg429f3fbb45c6"
msgid "Finally. Let's have some fun."
msgstr "드디어. 어디 재미 좀 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = debfb643-d803-84cb-1394-cd0a334ee8a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:debfb643-d803-84cb-1394-cd0a334ee8a7
msgctxt "h2fe80e7fga962g48d6ga733g4bd02069e27c"
msgid "Words I heed to the letter to keep my brood safe."
msgstr "무리를 안전하게 지키기 위해 내가 문자 그대로 따르는 말씀이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = dfcdc0e2-6d86-4993-6f02-0936e487aed4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:dfcdc0e2-6d86-4993-6f02-0936e487aed4
msgctxt "h16ac70c7gf502g46f8g8f1bga7b4b8037f11"
msgid "Yes. <i>Yes.</i> This could be the true way of Silvanus."
msgstr "그래. <i>그거지.</i> 그 방법이 진정한 실바누스님의 길이거늘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = e0cf1e4d-96f0-e7d2-ebc8-052413776968
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:e0cf1e4d-96f0-e7d2-ebc8-052413776968
msgctxt "h203e260bg033ag40c3ga239g42d6bb22b91f"
msgid "And mine perish if he stays."
msgstr "그가 계속 남아있으면 내 동족들도 몰살당할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = e1c925e2-f851-c071-ed54-7394fea92bb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:e1c925e2-f851-c071-ed54-7394fea92bb3
msgctxt "h1c2af52dg2c9bg4e8cgbb4eg8135cc25c330"
msgid "They may die on the road."
msgstr "이동 중에 죽을 수도 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = e31f327a-f2a1-ee4e-4801-45ea709942a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:e31f327a-f2a1-ee4e-4801-45ea709942a9
msgctxt "hcd351875g0484g45b9g983cg307c37f06ce9"
msgid "That depends. It was an accident - wasn't it?"
msgstr "상황에 따라 다르지. 사고였던 것 아니야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = e64ca4c1-ded9-2fde-759f-35c836eb2fbd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_SaghaMentionedArmy(1) = True
#.   Global:
#.     - DEN_GroveConflict_Knows_KaghaSentToZevlor = True
#.   Quest:
#.     - DEN_Conflict.MetKagha(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:e64ca4c1-ded9-2fde-759f-35c836eb2fbd
msgctxt "ha5d95381g84ebg4ae3g8a83g9273a97b7a8e"
msgid ""
"You will offer your services to Zevlor, guide the outlanders out of the "
"grove."
msgstr "제블로어에게 봉사하여, 이방인들을 숲 밖으로 안내해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = e8490584-596a-c605-918c-99a5726540b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:e8490584-596a-c605-918c-99a5726540b1
msgctxt "hb5d3ec04g1a80g43f2g9400g2b5a457c3ae5"
msgid ""
"The grove will be cloaked in bramble and thorn. No one enters, no one "
"leaves. <i>Sanctuary.</i>"
msgstr ""
"이 숲은 덤불과 가시에 가려질 것이다. 누구도 들어올 수 없고, 누구도 떠날 수 없게 말이다. 진정한 <i>성역</i>이 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = ea12fcac-5eb1-dab5-5fb2-5ae2fe61549b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:ea12fcac-5eb1-dab5-5fb2-5ae2fe61549b
msgctxt "h777698c2g6430g4b6cgac0dgf161ed8c02c4"
msgid "Get out. We have no more business."
msgstr "나가거라. 우리가 더 나눌 이야기는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = eb296d07-2c2f-20ac-83c8-c2742681355c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:eb296d07-2c2f-20ac-83c8-c2742681355c
msgctxt "hfe31cf4egcdf7g49fdg82fag822ce2c3b6e0"
msgid "Nettie, yes. She's bumbling about somewhere."
msgstr "그래, 네티 말이군. 어디서 또 허둥대고 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = ed966aaa-b103-0c03-5207-70ded2f30959
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_PlayerKeptSilent = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_MeanAnswer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:ed966aaa-b103-0c03-5207-70ded2f30959
msgctxt "hd74395d2g9d7bg4839g9f0ag58b4f8e18d5d"
msgid "Honestly, I just wanted to see what would happen."
msgstr "솔직히 말해서, 나는 단지 무슨 일이 벌어질지 보고 싶었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = f001f14e-ebe2-7bb6-27ee-98dd9c6ab7c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:f001f14e-ebe2-7bb6-27ee-98dd9c6ab7c1
msgctxt "hd221997cg366eg45fcg9dcdgde736726316b"
msgid ""
"The viper bares her fangs defending her brood. It is only right that <i>she</"
"i> strike the killing blow."
msgstr "독사는 송곳니를 드러내며 새끼를 지킨다. <i>그녀</i>가 치명적인 일격을 가하는 것은 당연한 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = f05509fe-5298-942e-0d80-84d162366bd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:f05509fe-5298-942e-0d80-84d162366bd7
msgctxt "hfb13aaf4gcc65g4b7egb2b0gc35ae381eb44"
msgid "They <i>will</i> die if they stay."
msgstr "남는다면 <i>확실히</i> 죽을 것이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = f1b18d09-a596-e231-09e6-4579897cb4a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:f1b18d09-a596-e231-09e6-4579897cb4a2
msgctxt "ha6cb09d3g0a75g46e0gb7c7g1160a733ed8c"
msgid ""
"You showed great mettle at the gate - the mettle of a skilled sword for hire."
msgstr "그대는 관문 앞에서 숙련된 용병의 강한 패기를 보여주었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Shadowheart
#. NodeID = f459ba31-7836-d729-8920-753e75933f47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:f459ba31-7836-d729-8920-753e75933f47
msgctxt "h1d9b6e94gb39dg4bd9gafeeg5520d9dfe107"
msgid "Keep talking. Nothing to be gained in picking a fight with a fanatic."
msgstr "계속 대화해. 광신도와 싸워서 얻을 건 아무 것도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = f66dd5d8-f4d9-72e7-47dc-f4e6feab7054
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_Event_AskedHealer(1) = False
#.   Global:
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_Knows_HeardAboutNettie_PartialInfo = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_AskedHealer(1) = True
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:f66dd5d8-f4d9-72e7-47dc-f4e6feab7054
msgctxt "hdd116d8cgab0fg45fagb452gd51da40cbc4f"
msgid "I'm told there is a healer here. Where is she?"
msgstr "여기 치유사가 있다고 들었는데. 어디 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = faaf2c92-b576-449c-3ff7-9986cf8b554c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Leader(1) = True
#.   Global:
#.     - DEN_ShadowDruid_HasMet_ReactedToSnakeCourt = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:faaf2c92-b576-449c-3ff7-9986cf8b554c
msgctxt "h21d3dbe2gd696g4f8eg9645g9ea450cf6fb3"
msgid ""
"No matter. I took back the Idol of Silvanus and the rite has resumed. We "
"will seal the grove. Free from harm. Free of <i>intruders</i>."
msgstr ""
"어쨌든, 나는 실바누스님의 우상을 되찾았고 의식은 재개될 것이다. 우리는 숲을 봉쇄하여 해로부터 벗어날 것이다. <i>침입자들</"
"i>로부터 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = fabedf49-1a38-85a6-6942-a1c89ee9a76c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:fabedf49-1a38-85a6-6942-a1c89ee9a76c
msgctxt "heb1cdf1bg45a9g49ccgbaa5g08d0a407c9e8"
msgid ""
"I do hope you didn't come expecting my thanks. That would be most perplexing."
msgstr "내 감사를 기대하며 온 것은 아니길 바란다. 그랬다면 무척 당황스러웠을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Kagha
#. NodeID = fcf81938-fce2-7b59-0d80-e3be7fd70f6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:fcf81938-fce2-7b59-0d80-e3be7fd70f6c
msgctxt "h0ed34b02gcfe3g43bbg8853g544aa70f5b8a"
msgid "Then why do you doubt my acts and intent?"
msgstr "그렇다면 어째서 내 행동과 목적을 의심하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader
#. Speaker = Player
#. NodeID = ff7cd734-e613-94ca-dbd5-cee556404cd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaKnowsZevlorDead = False
#.      - DEN_GroveConflict_Quest_DeniedKagha = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_KaghaKnowsZevlorDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Leader:ff7cd734-e613-94ca-dbd5-cee556404cd6
msgctxt "he4284589g4c63g487ag9cf3gbb518c108be8"
msgid "Zevlor is dead."
msgstr "제블로어는 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = 00c33c35-344a-7a89-d95e-4b2e976f827b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:00c33c35-344a-7a89-d95e-4b2e976f827b
msgctxt "h2450bad5gb467g4959g8896gce076eb4e858"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 014fe66c-fef4-097e-5b00-c7a4e1998037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:014fe66c-fef4-097e-5b00-c7a4e1998037
msgctxt "h41d2af77g0c22g432dgaf2dg013ec36966e2"
msgid "It began with a letter. There was no messenger - it simply... appeared."
msgstr "그건 한 편지에서 시작됐습니다. 발신인이 표시되어 있지 않았고 단순히... 나타났습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 0d36fa2e-640d-aae8-9038-1173e524a5f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:0d36fa2e-640d-aae8-9038-1173e524a5f9
msgctxt "h8241ddfdg08d0g4bf9g89b9g9e1b9a0f873a"
msgid "You burn like fire, you howl like wind. You are <i>Faithwarden</i>."
msgstr "당신은 불꽃처럼 타오르고, 바람처럼 울부짖습니다. 당신은 <i>믿음지기</i>십니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 106258a5-f186-983a-c0b6-3f07cd8157f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:106258a5-f186-983a-c0b6-3f07cd8157f4
msgctxt "hca65b420g8a33g45eaga9e2gb536d187fb2d"
msgid "I betrayed Silvanus himself, led the circle to shadow."
msgstr "저는 실바누스님을 배신하고, 회합을 그림자로 이끌었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 1bdd32f3-1dc7-9092-d231-37e3f5def450
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:1bdd32f3-1dc7-9092-d231-37e3f5def450
msgctxt "ha524ffe0gd45eg4f63gb7dcg80c19da4732c"
msgid ""
"I won't forget the wounds I've inflicted. I pray Halsin returns to heal them "
"in full."
msgstr "제가 가한 상처는 잊지 않겠습니다. 할신 님이 돌아와서 그들을 완전히 치료해 주시길 기도합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 1fcd72c2-31c7-6b2b-8b1a-f5b08589938e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruidLeader_State_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:1fcd72c2-31c7-6b2b-8b1a-f5b08589938e
msgctxt "ha3bc0512gc500g4249g99b9g062139413f95"
msgid ""
"We will stop the rite and I will stand trial. My fate lies with the "
"Treefather, may He have mercy."
msgstr "우리는 의식을 멈추고, 저는 법정에 설 것입니다. 나무 아버지께서 제 운명을 결정하시겠지요. 그분께서 자비를 베푸시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 2a1e4006-033e-ef24-dc39-e2e15822d25d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:2a1e4006-033e-ef24-dc39-e2e15822d25d
msgctxt "h6e87b06dgeb96g46adg9ca8g635959d3189f"
msgid ""
"When you speak, the circles will listen. Among druids, your words will shine "
"brighter than sun."
msgstr "그대가 말씀하시면 회합이 들을 것입니다. 드루이드 사이에서 그대의 말은 태양보다 밝게 빛날 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 31c61a83-a52c-604b-11c3-fec1a2ddbe2f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Event_SetFaithwarden = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:31c61a83-a52c-604b-11c3-fec1a2ddbe2f
msgctxt "h96029016gd30ag47fbg8123g67f109dc4f31"
msgid "Take our gift and be known. May I not be the last monster you vanquish."
msgstr "우리의 선물을 받고 널리 이름을 떨치십시오. 부디 당신이 무찌른 마지막 괴물이 제가 되지 않길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 37185e02-377f-9a45-640c-3282aa377fbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:37185e02-377f-9a45-640c-3282aa377fbb
msgctxt "h39bb0d88ge5ebg42f9g88bbg14e5a216993f"
msgid ""
"There was but one druid who guarded the circle, who protected our ways. We "
"are forever in your debt."
msgstr "회합을 보전하고, 우리의 길을 보호했던 드루이드는 오직 한 분뿐이었습니다. 우리는 당신께 영영 빚을 졌습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 40912f7d-f24b-10b5-013f-043a10885fcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:40912f7d-f24b-10b5-013f-043a10885fcc
msgctxt "h40d6f688g7747g4ed7g824fga5f65bc44d44"
msgid ""
"Olodan came soon after. An army was coming, she said. Goblins, drow, and "
"more still - legions upon legions."
msgstr "올로단이 곧이어 찾아왔습니다. 그녀는 군대가 오고 있다고 말했습니다. 고블린, 드로우, 그리고 보다 더 많은 군단이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 40d64319-5c54-f99e-5c1a-0c585e198ea3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:40d64319-5c54-f99e-5c1a-0c585e198ea3
msgctxt "h13639d32g580bg4ac7gb074gd4c87784a926"
msgid ""
"I won't forget the wounds I've inflicted. I trust Silvanus will heal them in "
"time."
msgstr "제가 가한 상처는 잊지 않겠습니다. 실바누스께서 그들을 제때 치료해 주시길 것이라 믿습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 41c8ef17-5e0c-7bd4-ad62-812d3a5e6896
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:41c8ef17-5e0c-7bd4-ad62-812d3a5e6896
msgctxt "ha12fea24g7f65g4207g974cgc75160568de8"
msgid "Rath thought me a danger. Seems I've proven him right."
msgstr "라스는 저를 위험이라 생각했습니다. 제가 그의 말이 옳음을 증명한 것 같습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 484cc31b-9c03-d058-8dfc-15df830f37d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:484cc31b-9c03-d058-8dfc-15df830f37d9
msgctxt "h59fd74a4gfecbg4c3fgb7aeg19cdd7f96baf"
msgid ""
"Meanwhile, help us contend with the goblins. Perhaps we can dissuade them "
"from attacking."
msgstr "그동안 우리가 고블린과 싸울 수 있도록 도와주십시오. 어쩌면 우리가 고블린의 공격을 막을 수 있을지도 모릅니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = 4a7e689d-5919-fba3-c6b9-64c6209ac210
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:4a7e689d-5919-fba3-c6b9-64c6209ac210
msgctxt "h591d8518g6c5bg43ddgb6cdge0344de2ed40"
msgid "You were ready to give up the circle to Cloakwood. It's unthinkable."
msgstr "당신은 기꺼이 회합을 클록우드에 넘기려고 했어. 상상도 못할 일인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 4f3d4a40-4fc6-a512-40d2-0523946df6ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:4f3d4a40-4fc6-a512-40d2-0523946df6ef
msgctxt "h318ca535g6f12g4594ga0e9g238b76850536"
msgid ""
"I can hardly deny it. I was so cloaked in shadow, little light could pierce "
"through."
msgstr "부인하기 힘들군요. 어둠에 너무 잠식된 나머지, 작은 빛줄기조차 알아보지 못했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = 54d3650e-2344-1eb7-b348-2396f3fa9c32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruidPersuaded_Event_AskedHow(1) = False
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruidPersuaded_Event_AskedHow(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:54d3650e-2344-1eb7-b348-2396f3fa9c32
msgctxt "hec110a22gc54ag4132gba5dg9c028330640d"
msgid "And what of Zevlor's people?"
msgstr "그리고 제블로어의 사람들은 어떻게 할 것이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 57e7318c-b500-e987-34f5-458ec2fe8ddf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:57e7318c-b500-e987-34f5-458ec2fe8ddf
msgctxt "h9d46c664gbb16g4bbag9015g2c03415cea5d"
msgid "...well. You know the rest. I would turn the grove over to them."
msgstr "... 나머지는 그대도 아시겠죠. 저는 그들에게 이 숲을 넘기려 했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 5e2f7744-2998-ae6c-bf87-a21291988550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:5e2f7744-2998-ae6c-bf87-a21291988550
msgctxt "h1f4798ffgc753g4a6egad45g55a709f4bf03"
msgid ""
"Olodan taught me to harness the Treefather's power to wall us in. In "
"return..."
msgstr "올로단은 나무 아버지의 힘을 이용해 우리를 가두는 법을 가르쳐줬습니다. 그 대가로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 63a8347d-a730-8dda-c0f1-5a346330b787
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Leader(1) = True
#.      - DEN_ShadowDruid_Event_CalledSaghaMonster(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:63a8347d-a730-8dda-c0f1-5a346330b787
msgctxt "h2ac51f60g5419g4aa8gb980g427beed3a542"
msgid "You once called me a monster. Seems I've proven you right."
msgstr "그대는 저를 괴물이라 부른 적이 있습니다. 제가 그대의 말이 옳음을 증명한 것 같습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = 6b28c964-b441-7e34-bffa-5c6d72c9dccf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:6b28c964-b441-7e34-bffa-5c6d72c9dccf
msgctxt "h6ebce085gf4aag4aeeg821dg084a4d626697"
msgid "What happens now?"
msgstr "이제 어떻게 되는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 6d30eacc-3717-aa77-2493-e4f43b27b424
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruidLeader_State_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:6d30eacc-3717-aa77-2493-e4f43b27b424
msgctxt "h0db1b52cg3662g4b67gab96g0741e95246af"
msgid ""
"We will stop the rite and I will stand trial. My fate lies with the "
"Treefather, may He have mercy."
msgstr "우리는 의식을 멈추고, 저는 법정에 설 것입니다. 나무 아버지께서 제 운명을 결정하시겠지요. 그분께서 자비를 베푸시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = 6f4330b7-c7cd-4302-6c33-ffab47141a8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:6f4330b7-c7cd-4302-6c33-ffab47141a8e
msgctxt "h110f6072gb353g4f01g8170gf1eab5429997"
msgid "You don't deserve mercy."
msgstr "당신은 자비를 받을 자격이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = 770efecc-6886-51fc-b423-2264d3ccb053
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:770efecc-6886-51fc-b423-2264d3ccb053
msgctxt "h1e44bceagff7fg4e12gbaccgdc145033b989"
msgid "What does it mean to be Faithwarden?"
msgstr "믿음지기가 된다는 것은 무엇을 의미하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = 799df747-724d-00c1-3b0d-7bdca1f8c065
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:799df747-724d-00c1-3b0d-7bdca1f8c065
msgctxt "h6dc957dcg8d1cg4c79ga6e6g6fb4eacea0dd"
msgid "What about Zevlor - can his people stay?"
msgstr "제블로어는 - 그의 사람들은 계속 있을 수 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 7cd878aa-5c14-11bc-ff63-f838c773c7d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:7cd878aa-5c14-11bc-ff63-f838c773c7d5
msgctxt "ha9ad5782g3b79g4faagb313gdf74b981cf8e"
msgid "However He judges, I will comply."
msgstr "그분이 어떻게 심판하든, 저는 따르겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 83ab44ee-a4da-bd4d-99ee-813a4a415e01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:83ab44ee-a4da-bd4d-99ee-813a4a415e01
msgctxt "hc40b3d48g10d5g4a2fg9606gee817ebce8fa"
msgid "We will grant them safe harbour until they depart."
msgstr "우리는 그들이 떠날 때까지 그들에게 안전한 거처를 제공할 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 8d643f79-36d8-158a-2513-c754d4fb1973
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:8d643f79-36d8-158a-2513-c754d4fb1973
msgctxt "h3a505ca0g76d6g4ddbga04bg3a8643fb5144"
msgid ""
"Yet I led a child to her death, betrayed the circle to shadow. We will stop "
"the rite and I will stand trial."
msgstr "하지만 저는 한 아이를 죽음으로 몰고, 회합의 신뢰를 저버렸습니다. 저희는 의식을 멈추고, 저는 법정에 설 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 912f3a0c-7389-c343-d862-413ac41cb528
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:912f3a0c-7389-c343-d862-413ac41cb528
msgctxt "h5eb4711cg2c86g4459g8ed7g98b6d62c59f2"
msgid ""
"A child is dead. I betrayed the circle's trust. We will stop the rite and I "
"will stand trial."
msgstr "한 아이가 죽었고, 저는 회합의 신뢰를 저버렸습니다. 저희는 의식을 멈추고, 저는 법정에 설 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 92452283-feba-41ce-7a7d-a2020734feb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:92452283-feba-41ce-7a7d-a2020734feb7
msgctxt "h05f2eef3g4b18g44c3ga645g3190d8e32654"
msgid ""
"Silvanus bid me to protect my people from harm. Yet I was the one to inflict "
"it."
msgstr "실바누스님은 제게 백성들을 위험으로부터 보호해 달라고 부탁하셨습니다. 하지만 해를 입힌 건 저였습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 970c989b-ccc5-be67-97c2-b35ebf8c44ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:970c989b-ccc5-be67-97c2-b35ebf8c44ce
msgctxt "he9504409g83fdg4cc9g91bag53ccc897c83e"
msgid ""
"I endangered a child. I betrayed the circle's trust. We will stop the rite "
"and I will stand trial."
msgstr "저는 한 아이를 위험에 빠뜨렸고, 회합의 신뢰를 저버렸습니다. 우리는 의식을 멈추고 저는 법정에 설 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = 9e0156db-93bc-e25e-f61c-554298860579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:9e0156db-93bc-e25e-f61c-554298860579
msgctxt "h279d4f28g303bg4bacga52fgbcc360386e07"
msgid ""
"Yet I betrayed Silvanus himself, led the circle to shadow. We will stop the "
"rite and I will stand trial."
msgstr "하지만 저는 실바누스님을 배신하고 회합을 그림자로 이끌었습니다. 저희는 의식을 멈출 것이고, 저는 법정에 설 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = a2a447ce-1248-d0ea-ac5a-435936582af8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:a2a447ce-1248-d0ea-ac5a-435936582af8
msgctxt "hf0b2a5e8g63b7g4853g9b0eg6d2ad648fd55"
msgid "Rath thought me a danger. Seems I've proven him right."
msgstr "라스는 저를 위험이라 생각했습니다. 제가 그의 말이 옳음을 증명한 것 같습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = b39bccf7-c701-35bb-2d06-68c0b34c5452
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:b39bccf7-c701-35bb-2d06-68c0b34c5452
msgctxt "h2ddb708eg2fddg4053gb5f0g8326ec19cae0"
msgid ""
"Silvanus may very well grant your wish. Traitors have died for lesser "
"offences."
msgstr "실바누스께서 그대의 소망을 들어주셔도 마땅할 것입니다. 이보다 가벼운 죄목으로 죽은 반역자들도 있으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = b4fd8897-6271-38f5-03e6-a41d4b8ece21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:b4fd8897-6271-38f5-03e6-a41d4b8ece21
msgctxt "h1902f3e7gabfdg4213g923bg614bac40d69e"
msgid ""
"I won't forget the wounds I've inflicted. I trust First Druid Halsin will "
"heal them in time."
msgstr "제가 가한 상처는 잊지 않겠습니다. 저는 최고 드루이드 할신 님이 그들을 제때 치료해 주실 것이라 믿습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = b56a0d6c-4093-28e7-cf8f-d69b7ea90298
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:b56a0d6c-4093-28e7-cf8f-d69b7ea90298
msgctxt "h10190c07g9a6dg4909g92dbgd39fa866c3b7"
msgid ""
"I was thinking I could make us safe. A foolish notion, to think we'd find "
"comfort in shadow."
msgstr "제가 우리를 안전하게 만들 수 있다고 생각했습니다. 우리가 어둠에서 안정을 찾을 수 있다고 생각한 건 멍청한 발상이었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = c7903787-e16f-6112-4c5f-e102fd8f6ab5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruidLeader_State_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:c7903787-e16f-6112-4c5f-e102fd8f6ab5
msgctxt "ha6744e43gec5cg4ce4gba94g91e2e5f659c1"
msgid "My fate lies with Silvanus, may He have mercy."
msgstr "제 운명은 실바누스께서 결정하실 것입니다. 그분이 자비를 베푸시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = c96bbc49-f198-edf5-8b9e-cf8914dc162f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:c96bbc49-f198-edf5-8b9e-cf8914dc162f
msgctxt "hdc7e4189g608fg45c2g91d6ge1a03cab0bea"
msgid "Power's lure is strong. I know it well."
msgstr "힘의 유혹은 강하지. 나도 잘 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = d03285e1-1430-68bb-598f-acb4abfa7482
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:d03285e1-1430-68bb-598f-acb4abfa7482
msgctxt "h90c4ace0gb19eg464fg819bg835929238865"
msgid "Protecting the circle was natural - but you chose the wrong path."
msgstr "회합을 보호하는 건 자연스러운 일이지. 하지만 너는 잘못된 길을 택했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = d76a23f1-332e-8e75-4b04-8a35a697551f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:d76a23f1-332e-8e75-4b04-8a35a697551f
msgctxt "hf1044036g9779g406dg8157g70fd59f06a44"
msgid "You're damned right. Joining the Shadow Druids? What were you thinking?"
msgstr "맞는 말이야. 그림자 드루이드에 붙는다고? 대체 무슨 생각을 했던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = de05dee5-d3d0-4694-3f8f-1aa0741ccef3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:de05dee5-d3d0-4694-3f8f-1aa0741ccef3
msgctxt "h64731da3g7fbcg476cga700gd82735df589b"
msgid ""
"You speak more kindly than I deserve. I led a child to her death, betrayed "
"the circle to shadow."
msgstr "당신은 자격 없는 저에게조차 친절을 베푸는군요. 저는 아이를 죽음으로 내몰고, 그림자에 물들어 회합을 배신했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = e3455f07-cb1e-17af-426b-e330d716d5c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:e3455f07-cb1e-17af-426b-e330d716d5c8
msgctxt "h43985416g5284g4d24g8d00g5b493d1e3eab"
msgid "It was through power that I would keep us safe. Or so I thought."
msgstr "권력을 빌어서만 우리를 안전하게 지킬 수 있다고 생각했습니다. 착오였죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = e54e73f5-c07d-0352-7c44-8951c7240336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:e54e73f5-c07d-0352-7c44-8951c7240336
msgctxt "h392a6b59gacbdg4cfbg8975gc1ef775a20bd"
msgid "Joining the Shadow Druids? What were you thinking?"
msgstr "그림자 드루이드들 편에 서다니? 무슨 생각이었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = ec85af90-0d9a-cb47-b30f-b16f0bf325ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:ec85af90-0d9a-cb47-b30f-b16f0bf325ff
msgctxt "h057e0ce2gedc9g4fadgbc56g70086553055b"
msgid "You were lured by power. I've faced the same struggle."
msgstr "당신은 권력에 이끌렸지. 나도 같은 난관을 겪어 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = edaf725c-bc34-ad30-e20e-3a40018bd287
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:edaf725c-bc34-ad30-e20e-3a40018bd287
msgctxt "h95feef65g591fg4123g96feg69124140921f"
msgid ""
"The druids of Cloakwood knew the dangers this would bring. They ordained "
"that all circles cast the rite to shelter from the storm."
msgstr ""
"클록우드의 드루이드들은 이것이 가져올 위험을 알고 있었습니다. 그들은 폭풍을 피하기 위해 모든 회합에게 의식을 행할 것을 명했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = f21de903-1e1e-9401-da57-08808890c0ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:f21de903-1e1e-9401-da57-08808890c0ca
msgctxt "h51f7ff61gd66ag4845ga47fge4f05d7abfa2"
msgid "How grateful I am that yours shone so brightly."
msgstr "당신이라는 빛줄기가 환히 내려와 어찌나 감사한지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Player
#. NodeID = fd94c22e-0425-6aa0-7bc8-bf28f14a34b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruidPersuaded_Event_AskedShadows(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruidPersuaded_Event_AskedShadows(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:fd94c22e-0425-6aa0-7bc8-bf28f14a34b8
msgctxt "hdf8fc413ga815g48cdgafe0ge90c41db2805"
msgid "How did the Shadow Druids even find you?"
msgstr "그림자 드루이드가 어떻게 당신을 찾았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded
#. Speaker = Kagha
#. NodeID = ff722458-1e65-3869-fd9a-d6bdc209cc30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruidLeader_State_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPersuaded:ff722458-1e65-3869-fd9a-d6bdc209cc30
msgctxt "ha5292df9gfa3eg4e7fg9356g3656ed036752"
msgid "Treefather keep us all."
msgstr "나무 아버지께서 우리 모두를 지켜 주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Player
#. NodeID = 10036149-28ea-4a0c-39e8-e3eec8f00aee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_RecruitmentLetter = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.   Local:
#.      - e223fd36-c236-f2d3-d812-25ed88e2702a_ConfrontedKagha = False
#. SetFlags:
#.   Local:
#.     - e223fd36-c236-f2d3-d812-25ed88e2702a_ConfrontedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:10036149-28ea-4a0c-39e8-e3eec8f00aee
msgctxt "h34dab272g1933g4757g8a03gb14ad4e937ad"
msgid "I've discovered the truth. You're allied with Shadow Druids."
msgstr "진실을 알아냈어. 당신 그림자 드루이드들과 한패더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Player
#. NodeID = 1545c286-9449-6c4f-a3d8-7e82337ed258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:1545c286-9449-6c4f-a3d8-7e82337ed258
msgctxt "h6b01572fgd69ag4bc9gb7b7g828eae336750"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = 195764c6-f003-7c77-928d-a3538a129867
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:195764c6-f003-7c77-928d-a3538a129867
msgctxt "hb90570dbg7c50g4cbcg8de6ga98a1c24f5cc"
msgid ""
"Well. A broodmother looks forward, never back. I am First Druid now. And I "
"<i>will</i> keep my children safe."
msgstr "뭐. 무리 어미는 앞을 보지, 뒤를 보지 않아. 이제는 내가 최고 드루이드고, 나는 내 아이들을 지킬 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Player
#. NodeID = 3035ab8c-6bff-0ca6-9bca-b8d467cb3eff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruidLeader_State_KaghaKnowsHalsinDead = False
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruidLeader_State_KaghaKnowsHalsinDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:3035ab8c-6bff-0ca6-9bca-b8d467cb3eff
msgctxt "h521d3c65g2525g43b5g85a3gfa227cc3d3e0"
msgid "Halsin is dead. I thought you should know."
msgstr "할신이 죽었어. 너도 알아야 할 것 같아서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = 40f77a0f-ddf3-cbc7-db54-26c11a25949f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruidLeaderPostGoblins_State_HasMet(1) = True
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:40f77a0f-ddf3-cbc7-db54-26c11a25949f
msgctxt "h41a17639g2fa5g4300gb429g2389bf7dc10a"
msgid "Silvanus keep you."
msgstr "실바누스께서 보호하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = 5fbbb902-225f-0728-ef7b-20d43011311f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:5fbbb902-225f-0728-ef7b-20d43011311f
msgctxt "hb5f19d7cgaff8g4d0bgb420g9a9f6615505a"
msgid "Oh, hells - the prayer can wait. I'm... I'm going to miss him."
msgstr "아, 젠장. 기도는 됐어. 그가... 그가 그리울 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Player
#. NodeID = 628843fe-d247-ac78-1fbb-fb19075dc3cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:628843fe-d247-ac78-1fbb-fb19075dc3cd
msgctxt "h475d1e04g8b32g4487gb9c7g7b4be13cb238"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Player
#. NodeID = 7aa05020-1718-479c-86ef-5cccfc8c00b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:7aa05020-1718-479c-86ef-5cccfc8c00b7
msgctxt "h22877456g3b95g4b98g8128gb8b4f94e0b48"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = 7f1afdb3-dc2a-15b8-b8ad-c4e952cbf5e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:7f1afdb3-dc2a-15b8-b8ad-c4e952cbf5e3
msgctxt "h551c00b3gd4deg4594g98d4gfde4dc59229a"
msgid ""
"The last prayer will be spoken and the rite will conclude. When the coming "
"army swarms, the brambles will keep us safe."
msgstr "마지막 기도를 읊고, 의식을 마무리할 거다. 군대가 몰려와도, 가시 덤불이 우리를 지켜줄테지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = 8e1dc67d-ff30-78ca-670d-5200d7e04bf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:8e1dc67d-ff30-78ca-670d-5200d7e04bf8
msgctxt "h13daf7adg5275g4f25g8c42ge0bbed24bf82"
msgid "He's... he's really gone, then. That means..."
msgstr "정말... 정말로 죽은 거군. 그렇다는 건..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = 9cd02c92-3ecb-84f6-e844-b0d4c41c8811
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruidLeaderPostGoblins_State_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:9cd02c92-3ecb-84f6-e844-b0d4c41c8811
msgctxt "h4b5502a0g7f17g41d6gbe47g6bdb0bda6515"
msgid "The tieflings are grateful for your efforts, as well should they be."
msgstr "티플링들이 그대에게 고마워하더군. 물론 그래야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Player
#. NodeID = a78dcc69-11e6-e923-1606-9f3ac8e687d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:a78dcc69-11e6-e923-1606-9f3ac8e687d7
msgctxt "hdd077f59gd7deg456fg847cgf62d8f899a31"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = aca2fda9-3c7e-5441-c0b5-2c9b91b8fd3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruidLeaderPostGoblins_State_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:aca2fda9-3c7e-5441-c0b5-2c9b91b8fd3b
msgctxt "h81ce96d0g4f21g438dg8e72g035e5b5b442b"
msgid "Finally, we'll be rid of the outlanders' infernal stench."
msgstr "드디어, 저 지옥 냄새 나는 외부인들을 치워버릴 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = ae143f38-1a44-c378-8f25-c5f9fe403235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:ae143f38-1a44-c378-8f25-c5f9fe403235
msgctxt "h834d5416g65c4g4169g88f5g651f71f14f4d"
msgid ""
"We will execute the Rite of Thorns, and you will give no more complaint. In "
"fact..."
msgstr "우리는 가시의 의식을 수행할 거고, 더 이상의 불평은 듣지 않겠다. 그리고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = bff4716b-47a4-9600-ee4d-0748f6bba53e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:bff4716b-47a4-9600-ee4d-0748f6bba53e
msgctxt "h2d48ef4cgdca1g4b3bga89dg07065af25acb"
msgid "...you will be gone before the sun next sets on the grove."
msgstr "...너는 해가 다음번 지기 전에 숲을 떠나야 할 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Player
#. NodeID = cc336ac7-0414-fc70-173a-2452906e6df2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruidLeader_State_KaghaKnowsHalsinDead = False
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruidLeader_State_KaghaKnowsHalsinDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:cc336ac7-0414-fc70-173a-2452906e6df2
msgctxt "hd0e80001gf059g415fg844dgfeb830f2d9a5"
msgid "I'm afraid Halsin is dead."
msgstr "유감이지만 할신은 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = ce7b8734-734c-d888-f90f-bfd6a6179cd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:ce7b8734-734c-d888-f90f-bfd6a6179cd6
msgctxt "hca5d56c6g1f52g43dfg825eg0321f1eb15f6"
msgid ""
"The grove is forever in your debt. Walk freely among us for as long as the "
"sun sets and rises."
msgstr "이 숲은 그대에게 빚을 졌어. 해가 뜨고 지는 한, 우리 곁을 원하는 대로 걸어도 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = ceeed300-e38d-436c-b365-e6f1cd834f34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruidLeaderPostGoblins_State_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:ceeed300-e38d-436c-b365-e6f1cd834f34
msgctxt "he0bc80f5g40a6g4eaegbbe3gff9b0d69b878"
msgid "There is cause for celebration. Master Halsin would approve."
msgstr "이건 축하할 만한 일이다. 마스터 할신께서도 인정하시겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = d25817c9-cc6d-1ab5-721d-7c5d374f0e55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:d25817c9-cc6d-1ab5-721d-7c5d374f0e55
#, fuzzy
msgctxt "ha0815e36gffebg448aga0c1gf50b1d28b5fa"
msgid "There is cause for celebration. Master Halsin would approve of this."
msgstr "이건 축하할 만한 일이야. 마스터 할신도 인정하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = d5ad135a-0bbe-2eab-3104-18c8dbd767a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:d5ad135a-0bbe-2eab-3104-18c8dbd767a3
msgctxt "h16004969gbca4g45efg8f7agf34ac9aec025"
msgid "Treefather, make us tall as the ash and stout as the spruce. I..."
msgstr "나무 아버지, 우리를 물푸레만큼 크고 가문비만큼 강하게 하소서. 저는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = dfb56097-4180-3c9e-ffbb-0aad1a710e01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:dfb56097-4180-3c9e-ffbb-0aad1a710e01
msgctxt "h635ffcfegb034g43e0g8172gfd144a11f2f0"
msgid ""
"He turned his back on the circle to stumble after the past. How fitting that "
"it's consumed him."
msgstr "그는 회합에 등을 돌리고 과거를 찾으러 떠났지. 거기에 잡아먹히다니 걸맞는 최후야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = e201fb23-5923-4365-812d-d91794397ab0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:e201fb23-5923-4365-812d-d91794397ab0
msgctxt "h38aa0d75g07d1g4ec0gbdcbgc8a422c1af56"
msgid "Have you now? And you thought you should <i>tell</i> me?"
msgstr "그러셨어? 그리고 나한테 <i>말해 줘야겠다</i>고 생각한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = e2e4c097-ffb8-86fb-c098-a28de5d2753c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:e2e4c097-ffb8-86fb-c098-a28de5d2753c
msgctxt "h82c03b7dgfff7g46bdga086g5e8ebf7c2d7b"
msgid "Master Halsin would approve. I pray he still returns, Silvanus willing."
msgstr "마스터 할신도 인정했을 거야. 실바누스께서 도우사, 지금이라도 할신이 돌아오길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = e508091b-4141-a64a-09c0-4d984eca7df8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:e508091b-4141-a64a-09c0-4d984eca7df8
msgctxt "h9e687061g991dg4f4dgb790gc151a6faf349"
msgid "I suppose you want thanks. I'm sure the tieflings have plenty."
msgstr "감사 인사를 바라고 있겠군. 티플링들이 충분히 해주리라 믿지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = ea3e5e8e-6860-e685-bb4b-67fcdf220a71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_DeadInGOB = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruidLeaderPostGoblins_State_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:ea3e5e8e-6860-e685-bb4b-67fcdf220a71
msgctxt "h14adf1b9gfe32g475dgbc49gc6e4ecdb9d2a"
msgid "We're grateful for your efforts - though none more than the refugees."
msgstr "그대의 노력에는 감사한다. 난민들만큼은 아니지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = ed6c9ace-6fbe-f63a-26f0-5b9ee864f828
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruidLeaderPostGoblins_State_HasMet(1) = True
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:ed6c9ace-6fbe-f63a-26f0-5b9ee864f828
msgctxt "hcfdade38g0ee2g4f2dg9465gf785f3b2fde3"
msgid "Peace. Enjoy it while it lasts."
msgstr "평화로군. 지속되는 동안은 즐기거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins
#. Speaker = Kagha
#. NodeID = f2346f6a-a3cf-2bc4-dc0b-70301074f36c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderPostGoblins:f2346f6a-a3cf-2bc4-dc0b-70301074f36c
msgctxt "h38bcf689g1d97g48ebga440gc60874891849"
msgid "Halsin, gone."
msgstr "할신이, 죽었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 0000b1db-6004-0e1a-f571-7c8b2600d35a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:0000b1db-6004-0e1a-f571-7c8b2600d35a
msgctxt "h386f1ec7gb823g4fd2g94bcg3bb21997b5dc"
msgid "'Mercy'. You carry it with you. And now I must carry it with me."
msgstr "'자비'. 그대와 함께하는 것이지. 이제 나 또한 그렇게 해야만 하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 04196006-a322-14da-7445-feb94a0c3033
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:04196006-a322-14da-7445-feb94a0c3033
msgctxt "h202a6fa1g92cfg4996g913fg8734d9be56b9"
msgid ""
"Halsin's cancelled the rite and I will face judgement. My fate belongs with "
"the Treefather."
msgstr "할신께서 의식을 취소하셨고 나는 심판을 마주할 것이야. 내 운명은 나무 아버지께 달려있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Player
#. NodeID = 0f0af671-178a-61df-21ad-aeec8ac50071
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:0f0af671-178a-61df-21ad-aeec8ac50071
msgctxt "h0b1c95f7g0824g4e85ga928g95ca361b5378"
msgid "May the sun rise in the valley..."
msgstr "골짜기 위로 태양이 떠오르길…"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 15717227-fd0b-28a8-e7f5-8fbcdf5a2597
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:15717227-fd0b-28a8-e7f5-8fbcdf5a2597
msgctxt "hcd2c819bg0d10g402aga3e0geba92b12246c"
msgid ""
"Halsin's cancelled the rite and I will face judgement. My fate belongs with "
"the Treefather."
msgstr "할신께서 의식을 취소하셨고 나는 심판을 마주할 것이야. 내 운명은 나무 아버지께 달려있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 269cce18-a58b-2ab4-e1d3-8ffac57ddf94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:269cce18-a58b-2ab4-e1d3-8ffac57ddf94
msgctxt "h8f227d14g2daeg4daag9152g5254931e0fd7"
msgid "I'll use it to heal blight wherever it reaches."
msgstr "어둠이 닿는 곳마다 그 빛으로 밝히도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 278888e0-5b63-fa58-54de-c3c7ebf53d45
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:278888e0-5b63-fa58-54de-c3c7ebf53d45
msgctxt "ha87aebd0gc00eg44c8g9611g85168f10eb64"
msgid ""
"I sought the shadows and imperilled the grove. Thanks to you, I've seen "
"light."
msgstr "난 그림자를 찾았고 숲을 위험에 빠뜨렸다. 네 덕분에, 나는 다시 빛을 보았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Player
#. NodeID = 3555d773-2544-498b-e1fd-4993f722706e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:3555d773-2544-498b-e1fd-4993f722706e
msgctxt "hdbb1961ag1c3fg45ccg8466g9da7ed0c8ef6"
msgid "Don't let me think about it too long. I'll start having regrets."
msgstr "오래 생각하게 하지 마. 후회할 것 같으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 5570acde-df74-9f14-99e5-6c6d2681d278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:5570acde-df74-9f14-99e5-6c6d2681d278
msgctxt "h133fe5d0g1542g4408g931bg4a7393647bcf"
msgid "I will cancel the rite and subject myself to the circle for judgement."
msgstr "의식을 중지하고, 자발적으로 회합에 몸을 맡겨 판결을 따르도록 하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Player
#. NodeID = 5e4aa6dc-f240-d147-41eb-d67c9077038d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:5e4aa6dc-f240-d147-41eb-d67c9077038d
msgctxt "h25dfd518gfedbg466bgb816g9f5d57bf1994"
msgid "This wasn't for you. It was to spare that girl's parents."
msgstr "당신 때문에 한 일이 아니야. 아라벨라의 부모님을 지키기 위해서였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Player
#. NodeID = 5ea49d49-c82c-9faf-f0af-81bf5a627e92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:5ea49d49-c82c-9faf-f0af-81bf5a627e92
msgctxt "h154c1bd2g5f6dg4f18gb74eg34776d79580e"
msgid "Saving you was one matter. Forgiving you is another."
msgstr "당신을 살리는 것과 용서하는 건 별개의 문제지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 6129196c-7d66-b15f-ca9d-71d5b96aa8b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:6129196c-7d66-b15f-ca9d-71d5b96aa8b0
msgctxt "h17a0e711g5483g4bbdg9e14gd783dc4d5de2"
msgid "Don't saddle yourself with that loathing. I will carry it for us both."
msgstr "증오를 짊어지고 갈 필요는 없어. 내가 두 명의 몫을 가지고 갈 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 64d319af-16ce-1f73-1d4a-9f09db4f88a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:64d319af-16ce-1f73-1d4a-9f09db4f88a5
msgctxt "h2f207d7ag7835g4e11g8622g35edc81e6858"
msgid ""
"And I'll remember a serpent lives within me, waiting to strike. Treefather "
"guide me, that I choose my targets more wisely."
msgstr ""
"그리고 내 안에 공격할 순간을 기다리는 뱀이 있음을 기억하리. 나무 아버지여, 제가 싸울 상대를 보다 지혜롭게 고르도록 이끄소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 88993bb4-fee8-b18d-e072-67f7f8b01b8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:88993bb4-fee8-b18d-e072-67f7f8b01b8e
msgctxt "h92cbeffcg70dbg4e60g9412gb5c621682d74"
msgid "Peace. Enjoy it while it lasts."
msgstr "평화로군. 지속되는 동안은 즐기거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Player
#. NodeID = 948f5ece-c9c1-20d9-f45d-d4a5253cf695
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:948f5ece-c9c1-20d9-f45d-d4a5253cf695
msgctxt "ha0c7db81g1665g4d56g8097g149369f2fdc5"
msgid "The light welcomes even those who have strayed."
msgstr "빛은 길을 벗어난 이들도 환영하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = 9acde2f5-292e-d93a-ae8f-7a0af14b8c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:9acde2f5-292e-d93a-ae8f-7a0af14b8c95
msgctxt "h55fc63e6gc844g48efga70bge96df87e0578"
msgid ""
"...<i>and may the wind carry you to mount's peak.</i> Until we meet again."
msgstr "...<i>바람이 산봉우리까지 그대를 태워다 주기를.</i>안녕히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = a22378f7-28f7-daa3-b81d-2bcec6465910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:a22378f7-28f7-daa3-b81d-2bcec6465910
msgctxt "h7a29ded4ge91ag44b9g9ec3g0e37aba2a176"
msgid "You can trust that Silvanus will punish me for it twice over."
msgstr "실바누스께서 나를 몇 번이고 벌하실 테니, 그 점은 의심하지 않아도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = a5f56014-18e9-ca67-e6a9-2e80e5f29771
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:a5f56014-18e9-ca67-e6a9-2e80e5f29771
msgctxt "h8282386bg2525g41f7g94c0gc2ee1e622a54"
msgid "Then trust when I say I bear their burden along with my own."
msgstr "그렇다면 내가 그들의 짐까지 짊어질 것이라는 말을 믿어다오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = a646f2b4-0277-c5e1-54f0-04dc7191c894
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:a646f2b4-0277-c5e1-54f0-04dc7191c894
msgctxt "heac61435gdfe1g493cg91c5g0e26604f6268"
msgid "Then I won't stretch your patience. But do allow me one last word:"
msgstr "내 그대의 인내심을 더 시험하지 않으리. 하지만 마지막으로 한 마디만 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = a85e5e9e-5f5d-b34c-6a2e-787e1b221769
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SavedKagha = True
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruidLeader_State_SavedHasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:a85e5e9e-5f5d-b34c-6a2e-787e1b221769
msgctxt "h43484c4dgd543g4c0ag982fg66607b90c648"
msgid ""
"I have been so blind, that an outsider would show me the way of Silvanus."
msgstr "외부인이 내게 실바누스의 길을 보여줄 만큼 그동안 눈이 멀었었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Player
#. NodeID = bf900911-5e1d-750b-7580-5e87e1c9e52b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:bf900911-5e1d-750b-7580-5e87e1c9e52b
msgctxt "he6f87cbcg55a0g4b63g8013g350a590af169"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = c4937c3e-480d-d5c0-ef35-0fa2377a37dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:c4937c3e-480d-d5c0-ef35-0fa2377a37dd
msgctxt "hb23d2d20ge6ffg48a0g8838g4572b0837b21"
msgid ""
"Justice will be done - the circle will see to that. Cold comfort for them, "
"but comfort nonetheless."
msgstr "정의는 실현될 것이네. 드루이드 회합이 그리할 것이야. 차가운 위안 정도밖엔 되지 못하겠지만, 그래도 위안은 위안이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = ee569ca2-9c12-7f44-e5a0-715178b5bc01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:ee569ca2-9c12-7f44-e5a0-715178b5bc01
msgctxt "h961b3d9eg8b4dg452cg8083gcd42a9340153"
msgid ""
"The grove is forever in your debt. Walk freely among us for as long as the "
"sun sets and rises."
msgstr "숲은 영원히 네게 빚을 졌다. 해가 뜨고 질 동안 자유롭게 우리 사이를 거닐게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = f6fff009-6d0f-9aca-91ff-f604e6c2ed8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruidLeader_State_SavedHasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:f6fff009-6d0f-9aca-91ff-f604e6c2ed8e
msgctxt "hae8ef93eg893eg470ag9ba8gc3eaef3de7f1"
msgid "You saved my life. I won't forget it."
msgstr "넌 내 목숨을 구했다. 이를 잊지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved
#. Speaker = Kagha
#. NodeID = fe61a9db-ed77-7e7e-526a-4c5948aec586
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_LeaderSaved:fe61a9db-ed77-7e7e-526a-4c5948aec586
msgctxt "h4038a25dgae9fg41a6ga8a0g64f744c7dc22"
msgid ""
"After all I've done, you've no reason to believe me, but... I'm grateful."
msgstr "내가 저지른 일을 보고도 네가 날 믿을 이유는 없지만... 감사하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 0028f6e4-248c-4ba6-ede6-201db691b687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:0028f6e4-248c-4ba6-ede6-201db691b687
msgctxt "hb88bd748g55c2g4ee0g97ceg0bb3e0108ba6"
msgid ""
"Nothing befitting a child. Nothing befitting any of our world's creatures."
msgstr "어떤 어린이나 생명체에게도 일어나서는 안 될 일이 발생했겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 05a1a96c-3770-2691-d206-7f3f1e9520ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:05a1a96c-3770-2691-d206-7f3f1e9520ef
msgctxt "h315d089ag88adg444bgbd1dg6f135e084c83"
msgid ""
"You may be right. We've let a <i>snake</i> replace our leader. And the "
"result... By the Treefather, that girl..."
msgstr ""
"당신 말이 맞을 수도 있습니다. 우리는 <i>뱀</i>이 우리 지도자를 대신하게 두었습니다. 그 결과는... 나무 아버지시여, 그 "
"소녀가...."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 09006ade-d53c-730b-0922-afcf363e44fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Knows_RathMentionedReward = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:09006ade-d53c-730b-0922-afcf363e44fc
msgctxt "hb1f741fbg3fcdg4de6g9ad3g03390b725814"
msgid ""
"Please, do whatever you must to get him home. The grove <i>needs</i> him."
msgstr "부디, 할신이 집으로 돌아올 수 있도록 무엇이든 해주세요. 숲에는 그가 <i>필요합니다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 0d646692-39c9-02e0-db3b-024d90452d9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = True
#.      - GLO_Halsin_Knows_IsFound = True
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Knows_RathLearnedHalsinDeath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:0d646692-39c9-02e0-db3b-024d90452d9f
msgctxt "hd94a59e0gf62dg45bdg80e9g0ede1e0e8616"
msgid "I found Halsin in the goblin camp, but he didn't survive."
msgstr "고블린 야영지에서 할신을 찾았지만, 살아남지 못했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 1fa9766a-6a11-c8e5-0240-6a1b54cfd5c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_AgreedToHelp(1) = True
#.      - DEN_ShadowDruid_HasMet_Opposed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:1fa9766a-6a11-c8e5-0240-6a1b54cfd5c8
msgctxt "h3a7dbccdgcc88g4b6bg90a9g1a97944e4cca"
msgid ""
"I wish I could offer more assistance. For now, I must keep a close watch on "
"Kagha."
msgstr "제가 더 도움을 드릴 수 있으면 좋겠습니다만, 당분간은 카그하를 엄중히 감시해야 합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 202c2f0d-ba97-676a-4740-b7e9c1449dac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:202c2f0d-ba97-676a-4740-b7e9c1449dac
msgctxt "hb2e94238gdf12g438cgafeeg76e5ca9e57f9"
msgid "And if I hadn't spoken up? What would have happened?"
msgstr "내가 나서지 않았다면? 그 때는 무슨 일이 생겼을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 22f6c60f-6d02-5df3-c59c-d3037343d462
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:22f6c60f-6d02-5df3-c59c-d3037343d462
msgctxt "h6b03a394g1219g4fb1ga858g7ae9651ae52c"
msgid "I hope to see both you and Halsin again soon."
msgstr "당신과 할신 님 모두 다시 볼수 있으면 좋겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 243b3c8f-b713-545b-d964-de983fd5805d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:243b3c8f-b713-545b-d964-de983fd5805d
msgctxt "h7a74b3d3gb4c6g4b68ga7a7g69febd8f0eef"
msgid "Kagha seems happy to rule the roost. Who's your real leader?"
msgstr "카그하는 내심 이곳을 다스리는걸 좋아하는 것 같군. 당신들의 진짜 지도자는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 2af8c8ae-c5e3-89a3-bdd0-4c785b6526c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - DEN_Conflict_SUB_Halsin.LearnedHalsinMissing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:2af8c8ae-c5e3-89a3-bdd0-4c785b6526c4
msgctxt "h04665478ge929g4c50g8be1g163a5f1e919d"
msgid ""
"Master Halsin. Perhaps goblin-caught, perhaps dead. He'd set... <i>Mistress "
"</i>Kagha back in line. Hold her to task. Stop this damned ritual."
msgstr ""
"마스터 할신입니다. 고블린에게 잡혀 있을 수도, 죽었을 수도 있습니다. 그는 자신의 부재 시 <i>미스트리스 </i>카그하가 임시로 일을 "
"맡도록 했습니다. 이 망할 의식을 멈춰주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 2b68e306-8422-397d-24b2-53205b66963a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:2b68e306-8422-397d-24b2-53205b66963a
msgctxt "h30ca8fdfgb7ccg40ffgaa6cgb2846bb3940e"
msgid ""
"If only justice soothed my heart. A grove drenched in blood is no sanctuary "
"at all."
msgstr "내 정의심이 내 심장을 달래주길. 숲이 피로 흠뻑 젖는 건 안식처가 전혀 아니니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 2c98de01-00ab-1d25-9398-6fd4c6e2de6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:2c98de01-00ab-1d25-9398-6fd4c6e2de6f
msgctxt "h4ba35c70ga263g4c3ag9100g49b3e8e3c048"
msgid "...I apologise. I must have some time to myself."
msgstr "...실례합니다. 혼자만의 시간이 좀 필요합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 2dcd7a59-ab5e-d6df-3916-3269e82f2b9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:2dcd7a59-ab5e-d6df-3916-3269e82f2b9b
msgctxt "h19d9f4fdgd00ag4043gb5bdg8b3ab06034ce"
msgid ""
"We've let a <i>snake </i>replace our leader. She will see the tieflings "
"driven out, or worse."
msgstr "우리는 <i>뱀</i>이 우리 지도자를 대신하게 두었습니다. 그녀는 티플링들을 쫒아내거나, 더 심한 짓도 할 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 36a440a4-e98c-9744-a579-d010f921e1a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - DEN_Conflict_SUB_Halsin.LearnedHalsinMissing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:36a440a4-e98c-9744-a579-d010f921e1a0
msgctxt "he878b920gc500g41a5gbaecg0bf9195ad6a4"
msgid ""
"She is First Druid in Halsin's absence. With him caught - or dead - by "
"goblins, none may gainsay her."
msgstr "그녀는 할신이 부재할 시의 최고 드루이드입니다. 그가 고블린들에게 붙잡혀 있거나 죽은 이상, 아무도 그녀를 견제할 수 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 3e9785d3-f2b0-6845-544e-d6ec5cf948d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:3e9785d3-f2b0-6845-544e-d6ec5cf948d9
msgctxt "h5a78dc89g5f57g421cg9859g8dfbdae71846"
msgid "I'd like a more solid offer than 'anything'."
msgstr "'무엇'보다 더 확실한 제의가 있었으면 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 421a1c3e-1f17-5221-d700-a4cb57581c37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:421a1c3e-1f17-5221-d700-a4cb57581c37
msgctxt "h1c72784cg24b9g4fccg801dg25f98c2f869a"
msgid "You have saved Kagha from herself. I cannot thank you enough."
msgstr "당신은 카그하를 본인에게서 구해내셨습니다. 어떻게 감사해야 할지 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 42c52dbe-8e23-e77d-9d68-3afe488d46c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:42c52dbe-8e23-e77d-9d68-3afe488d46c6
msgctxt "hcf93feadgd12fg4b16gbb04gdcbcbb8c18d1"
msgid "I'll take my chances on Nettie."
msgstr "네티에게 운을 맡겨야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 45339d21-96b6-bff9-c013-663e0047109c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:45339d21-96b6-bff9-c013-663e0047109c
msgctxt "h1ee627bag29b8g4429gb33ag1e92953ee13f"
msgid "The child is to blame. She shouldn't have stolen in the first place."
msgstr "아이에게 책임이 있어. 애초에 훔치지 말았어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 497fddd0-8042-bee6-d8ed-228a280717d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - DEN_Conflict_SUB_Halsin.LearnedHalsinMissing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:497fddd0-8042-bee6-d8ed-228a280717d2
msgctxt "h597a4498gd42cg4564gbcebg55a62007f85d"
msgid "If no one's looking for Halsin, I could do it."
msgstr "아무도 할신을 찾으려 하지 않는다면, 내가 할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 4af0c041-956a-56c0-eb3f-af5921311941
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:4af0c041-956a-56c0-eb3f-af5921311941
msgctxt "h192b4aacg1bc4g41d5ga6b2g85511e69de36"
msgid "How did Kagha take over the whole grove?"
msgstr "어떻게 카그하가 숲 전체를 장악할 수 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 4edca169-8b4a-e2ae-01d7-ef4c30d3dc6c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Opposed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:4edca169-8b4a-e2ae-01d7-ef4c30d3dc6c
msgctxt "h0d95c0a8g3f7cg4a81g9302g22f9efc9a64f"
msgid "Mercy on us, Silvanus - mercy, mercy, mercy."
msgstr "우리에게 자비를 베풀어주십시오, 실바누스님 - 자비를, 자비를, 자비를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 4ef2b99b-a105-a5f7-819e-1152107f3eb2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:4ef2b99b-a105-a5f7-819e-1152107f3eb2
msgctxt "h8fc9387bg5a7ag4958g9a15gddd24580de90"
msgid ""
"Halsin is an elf with the presence of a bear. He left west, with the "
"adventurers."
msgstr "할신은 곰의 형상을 한 엘프입니다. 그는 모험가들과 함께 서쪽으로 떠났습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 526d6f6b-1ff0-8dca-5a62-be4f58735ba5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:526d6f6b-1ff0-8dca-5a62-be4f58735ba5
msgctxt "hb6821588g17c1g4de8g904fg78321519debb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 543a4ab1-bcdc-a416-1643-687c5482a764
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:543a4ab1-bcdc-a416-1643-687c5482a764
msgctxt "hb3420e47gcbafg43cfgbc7agd06ea8efea14"
msgid ""
"More will die if the rite is finished. So many more, sent into a world gone "
"mad..."
msgstr "의식이 완료되면 더 많은 이들이 죽을 것입니다. 그리고 훨씬 더 많은 이들이 미쳐버린 세상에 내던져질 것입니다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 5756d21c-ff04-f9ee-42bd-d756e94f143d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_GuardedEntrance_HasMet_Parents(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:5756d21c-ff04-f9ee-42bd-d756e94f143d
msgctxt "h7951a193g577dg4db3gbfd7g45eb6f1c966a"
msgid "The girl's parents will want vengeance."
msgstr "소녀의 부모가 복수를 원하겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 591ff734-eb36-d378-fe33-0d50a399fbe6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#.   Global:
#.      - DEN_ShadowDruid_Knows_RathLearnedHalsinDeath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:591ff734-eb36-d378-fe33-0d50a399fbe6
msgctxt "he1e85b1eg17a1g4fb6ga578g3b4f300198fb"
msgid "May he rest in Summeroak forever. I..."
msgstr "할신 님, 깊은 숲에서 영면하시길. 저는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 5ae643b9-7293-ccc1-bb4b-90b398dbacf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:5ae643b9-7293-ccc1-bb4b-90b398dbacf3
msgctxt "h7e87db85g1621g40bfg9845ged073addf38f"
msgid "We let this happen. We let this snake replace our leader."
msgstr "우리가 이를 방관한 것입니다. 이 뱀이 우리 지도자를 대신하도록 내버려뒀습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 5b7dabf7-9735-7f38-4675-f65444c14ef3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Knows_RathMentionedReward = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:5b7dabf7-9735-7f38-4675-f65444c14ef3
msgctxt "h9df2bec9geb2eg47f0ga4a8gdf526c2de7a8"
msgid "Would you? I would give anything to see Halsin return home."
msgstr "그러시겠습니까? 할신이 집에 돌아올 수만 있다면 무엇이든 드리겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 620ad712-b073-c96b-9521-db748e6f396f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:620ad712-b073-c96b-9521-db748e6f396f
msgctxt "h48c54a88g6d8fg4e01g9b2ag3d63a10c38fa"
msgid "It was a terrible accident."
msgstr "끔찍한 사건이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 62eca89f-39ac-0a8d-5174-60516ff92292
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:62eca89f-39ac-0a8d-5174-60516ff92292
msgctxt "h15704462g84bbg4afag8110gc69a6c284539"
msgid "Never mind. I'm not interested."
msgstr "됐어. 나는 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 631d5831-665b-1c4f-118e-8e54edb067a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:631d5831-665b-1c4f-118e-8e54edb067a1
msgctxt "h3bbfbb72g0c4ag4afega2e4gc8d502eca644"
msgid "That Kagha seems dangerous."
msgstr "카그하라는 자는 위험해 보이는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 63670a2e-6138-4f44-3f48-6d6437a0d7b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:63670a2e-6138-4f44-3f48-6d6437a0d7b8
msgctxt "h3b207118g4d6cg41c7gad03g6a5d4c5600a4"
msgid "Perhaps his eyes are on Master Halsin now."
msgstr "아마 그분의 눈은 지금 마스터 할신을 향해 있겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 666a2571-929d-b079-781a-9a2773ac553a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:666a2571-929d-b079-781a-9a2773ac553a
msgctxt "hd8d7aeccg8997g40efga6f5g71979bf68f8b"
msgid ""
"Yet for her to die like this, under the Treefather's gaze... perhaps it is "
"justice."
msgstr "하지만 그녀가 나무 아버지의 시선 아래서 이런 최후를 맞이했다는 것은... 어쩌면 정의일지도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 6ac13ef1-5d98-9d51-250e-bdf66d1453f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:6ac13ef1-5d98-9d51-250e-bdf66d1453f4
msgctxt "h5f207d73g829eg4301g8b11g2020bcc59459"
msgid "By every star, by every vein on every leaf, she must."
msgstr "모든 별과 모든 잎사귀의 잎맥에 걸고, 반드시 책임져야 합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 6b216d5e-6b26-e72c-c022-8eec7b1a6cf2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:6b216d5e-6b26-e72c-c022-8eec7b1a6cf2
msgctxt "h2f6b8cd8g1181g48c5gb97dg8ba16d11e13f"
msgid "The adventurers say they lost track of him in a temple to the west."
msgstr "모험가들이 말하길 그들은 서쪽에 있는 한 신전에서 그를 놓쳤다고 합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 6be17b1a-c6fc-3a84-8b05-3c7fb0da4388
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:6be17b1a-c6fc-3a84-8b05-3c7fb0da4388
msgctxt "h02cf842dgc135g4047g90ffgd985ae2a0745"
msgid ""
"Should you change your mind, head west. Halsin is an elf with the presence "
"of a bear."
msgstr "마음이 바뀐다면 서쪽으로 향하십시오. 할신은 곰의 형상을 한 엘프입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 73c8d551-8a86-661d-0031-9d1b9706f253
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:73c8d551-8a86-661d-0031-9d1b9706f253
msgctxt "hba700d5dg67b5g4771gb771g6debb3e08f49"
msgid ""
"You don't deserve the Treefather's mercy - you failed him. Failed your "
"<i>duty</i>."
msgstr "넌 나무 아버지의 자비를 받을 자격이 없다. 넌 네<i>의무</i>를, 그를 저버렸다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 73c8d551-8a86-661d-0031-9d1b9706f253
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:73c8d551-8a86-661d-0031-9d1b9706f253
msgctxt "h5243fa85g5f80g4599gbc16g94ee46cad539"
msgid ""
"You let Kagha befoul this sacred place with a child's blood, yet you plead "
"'mercy'? <i>Coward</i>."
msgstr "카그하가 어린 아이의 피로 이 신성한 곳을 더럽히도록 내버려두면서 '자비'를 구하는 건가? <i>겁쟁이</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 7af1390a-dc01-2cd0-6d21-6bf6ea24a977
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:7af1390a-dc01-2cd0-6d21-6bf6ea24a977
msgctxt "hd472b711gb68eg43efg89cbg2ce410858a94"
msgid "I hope to see Halsin return so he can help us heal."
msgstr "저는 할신이 돌아와 우릴 치유해 주길 원합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 7e36fd67-e486-aa79-4a03-1e015455144c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:7e36fd67-e486-aa79-4a03-1e015455144c
msgctxt "h4815585cg758fg4c1dg80d0g36f14c517deb"
msgid ""
"We need Master Halsin. Without him, Kagha's ritual will divide this grove "
"forever."
msgstr "우리는 마스터 할신이 필요합니다. 그가 없으면, 카그하의 의식이 이 숲을 영원히 갈라 놓을 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 8320e691-6ba4-f9a1-eeb0-2c82531e8545
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:8320e691-6ba4-f9a1-eeb0-2c82531e8545
msgctxt "h11530ae4gfc68g4a1fgb706g9122e7a26af6"
msgid "A child is dead. You don't deserve mercy."
msgstr "어린 아이가 죽었어. 너희는 자비를 받을 자격이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 8c90e25a-67fd-6106-2abf-67fad7a5277c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_GuardedEntrance_HasMet_Parents(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:8c90e25a-67fd-6106-2abf-67fad7a5277c
msgctxt "h96d88e85g4642g41c0gb849g164a71c89c88"
msgid "That girl's parents want vengeance - and they deserve it."
msgstr "소녀의 부모는 복수를 원하고, 그럴 자격이 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = 8da34989-4bd1-0980-487f-e55894b51cc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:8da34989-4bd1-0980-487f-e55894b51cc4
msgctxt "h3b4bec55g6829g456dg87fag3267eb30609b"
msgid "That snake must be held accountable."
msgstr "그 뱀은 반드시 책임을 져야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 976c34cc-f98d-1ea7-9c62-a01bcd28d003
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:976c34cc-f98d-1ea7-9c62-a01bcd28d003
msgctxt "h390e34cbg91d5g42c2ga4d8g0724da06e198"
msgid "Ah, I see. You will find her deeper in the caves."
msgstr "아, 그러시군요. 이 동굴로 더 들어가면 그녀를 만날 수 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = 9dd11bd2-bcd1-58f5-188a-b2490b5462cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:9dd11bd2-bcd1-58f5-188a-b2490b5462cc
msgctxt "hbb62a39fgeb6ag43fcg8ef4g9e197b961b19"
msgid ""
"I pray the Treefather nourishes Kagha's wounded soul, now that she is dead."
msgstr "카그하는 죽었으니, 이제 나무 아버지께서 그 상처입은 영혼을 보살펴 주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = a5e64790-263b-9677-d5a0-670a90b87e1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:a5e64790-263b-9677-d5a0-670a90b87e1d
msgctxt "h258237afgae2bg4a1fgb2f5g43e1b65fccfd"
msgid "I pray she can heal what ails you."
msgstr "그녀가 당신의 병을 치료하길 기원합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = a5fef305-a2b7-027c-a3e8-72d8457fed52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruidOpposed_AskedAboutHealing(1) = False
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruidOpposed_AskedAboutHealing(1) = True
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:a5fef305-a2b7-027c-a3e8-72d8457fed52
msgctxt "h8bd424ccg7d3bg494aga7dcgf2522e0cc4b8"
msgid "I'm in need of a healer. Badly."
msgstr "안타깝게도 나는 치유사가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = a7527d7d-b69f-9d58-ce22-40628c474122
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:a7527d7d-b69f-9d58-ce22-40628c474122
msgctxt "hee493b54gb94dg4595ga69eg0c44b4e52774"
msgid ""
"Like many, you seek Halsin's craft. But you'll have to settle for Nettie."
msgstr "많은 이들이 그렇듯, 당신도 할신의 기술을 찾고 계시는군요. 하지만 네티로 만족하셔야 될 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = a94c2fe2-af36-553c-7d77-cceeae17ee53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:a94c2fe2-af36-553c-7d77-cceeae17ee53
msgctxt "hce80d205g87e2g4deagae82g2055e34581d6"
msgid "This is how a terrible cycle begins. All is out of balance."
msgstr "이렇게 끔찍한 악순환이 시작되는 것입니다. 모든 것이 균형에서 벗어나 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = a9c16db7-5912-e9a3-32c7-95fc25bc6e9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_Opposed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:a9c16db7-5912-e9a3-32c7-95fc25bc6e9c
msgctxt "hf60efd2fg17f1g4aceg83eeg686bbd54f2a2"
msgid ""
"You did well to speak up for the girl. That snake is <i>fickle</i>. A "
"tragedy prevented."
msgstr "그 소녀를 변호하신 건 잘한 일입니다. 그 뱀은 <i>변덕이 심합니다</i>. 비극은 막았군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = a9e37a83-97fd-02a2-0ea4-fecb52ed9eab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:a9e37a83-97fd-02a2-0ea4-fecb52ed9eab
msgctxt "h69cde3d6gd528g4d28g9316g3bbd43d1a069"
msgid "Well seen. Well spotted. We've let a <i>snake</i> replace our leader."
msgstr "잘 보셨습니다. 잘 아시는군요. 우리는 <i>뱀</i>이 우리 지도자를 대신하게 두었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = adda4319-fa7f-e75f-93dd-63c01bea243a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:adda4319-fa7f-e75f-93dd-63c01bea243a
msgctxt "h81ef2537g584fg4ed7g93b6gbde5986d5bc8"
msgid ""
"Find her further in the cave. Her gift is great, too - you can trust her."
msgstr "이 동굴의 안으로 더 들어가서 그녀를 찾아보십시오. 그녀의 재능도 뛰어납니다. 그녀는 믿을 수 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = b3228d42-37cd-e3b9-7ca1-70c766134aab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:b3228d42-37cd-e3b9-7ca1-70c766134aab
msgctxt "h127bdff4g4fd5g4786g81f9ge8a2f6576d7c"
msgid ""
"But more will die if her ritual is finished. I doubt those exiled by the "
"rite will survive long outside."
msgstr ""
"하지만 그녀의 의식이 완료되면 더 많은 이들이 죽을 것입니다. 의식에 의해 추방된 이들이 바깥에서 살아남을 수 있을지 의문입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = bc1861dd-99ef-6675-68cc-47d53bc023e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:bc1861dd-99ef-6675-68cc-47d53bc023e2
msgctxt "h67a8fbb9g878cg49fcga9d9ge9b8f6c2dd01"
msgid ""
"Your dismissal is no shield. Kagha will ensure all outsiders are driven from "
"the grove."
msgstr "거절이 능사가 아닙니다. 카그하는 모든 외부인들을 숲에서 몰아 낼 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = bd8698ed-9f5e-46db-8a38-72e3859ef5e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_AgreedToHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:bd8698ed-9f5e-46db-8a38-72e3859ef5e1
msgctxt "h2a8f8948g2426g44b3g97f7gf698f5a3c41c"
msgid "No need to fret. I'll find him."
msgstr "걱정할 필요 없어. 내가 그를 찾아낼 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = c2c4c329-819a-c6ae-c855-0b5677f8aef2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruidOpposed_AskedAboutHealing(1) = False
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = True
#.      - DEN_Apprentice_UserShortcut = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:c2c4c329-819a-c6ae-c855-0b5677f8aef2
msgctxt "h8e9e7a97g3bf7g4390gaf1eg824556df4f68"
msgid "I'm looking for Nettie."
msgstr "네티를 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = c3cb4588-b4d1-a664-c231-b9a4fe1b3f24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:c3cb4588-b4d1-a664-c231-b9a4fe1b3f24
msgctxt "hbf264f8cg87dbg423fgb364g9d8f2164ba33"
msgid "This has only happened because our true leader was taken from us."
msgstr "이게 다 우리의 진정한 지도자를 빼앗겼기 때문에 벌어진 일입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = c51e98a3-d166-27d5-4da8-f2813826dc4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ShadowDruid_HasMet_Opposed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:c51e98a3-d166-27d5-4da8-f2813826dc4a
msgctxt "h03a9fbf7gea5eg4175g8cebg590e7f6f9a04"
msgid "Until Master Halsin returns, my eyes must stay on Kagha."
msgstr "할신께서 돌아오실 때까지, 저는 카그하를 계속 지켜보고 있어야 합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = caac6240-769b-7968-8991-38c3cd15abb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:caac6240-769b-7968-8991-38c3cd15abb5
msgctxt "h5ef5743cg1a1cg477agb915ge5475eb933f5"
msgid "It is what Kagha desires. I doubt it is what Silvanus wants."
msgstr "카그하가 바라는 바입니다. 저는 이것이 실바누스께서 원하시는 일인지 의심스럽습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = d184d157-9dba-6153-3977-cd84c0fedb66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:d184d157-9dba-6153-3977-cd84c0fedb66
msgctxt "h01cb0d7eg0596g4246g9d6bg81262560354b"
msgid "Preventable. The sickening result of sickening beliefs."
msgstr "막을 수 있었습니다. 병적인 믿음의 병적인 결과입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = d758bd0b-816b-30ed-dc8f-037a6a8b22b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:d758bd0b-816b-30ed-dc8f-037a6a8b22b4
msgctxt "haf618a2fg2000g4c10gb3f3g7dede41d42d0"
msgid ""
"One meant to seal us in. Meant to seal them out. <i>Blasphemous.</i> The "
"Treefather <i>must</i> see what's happening in his holy grove."
msgstr ""
"우리를 안에 봉인하는 것입니다. 저들을 바깥으로 추방시키고요. <i>불길합니다.</i> 나무 아버지가 그분의 신성한 숲에서 무슨 일이 "
"벌어지고 있는지 <i>보셔야</i> 됩니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = d852ab62-e7af-d52c-ce4f-8b7ed45a1304
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:d852ab62-e7af-d52c-ce4f-8b7ed45a1304
msgctxt "h562f8de3gf121g4337g9ffegff046dfb2240"
msgid ""
"Our need is great. I will open the treasures of this grove to you, even if "
"the circle forbids it."
msgstr "우리의 열망은 큽니다. 설령 회합이 금지하더라도 당신께 숲의 보물고를 열어드리겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = da77a414-5590-d37b-4dda-c9246ffe8fbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:da77a414-5590-d37b-4dda-c9246ffe8fbc
msgctxt "h7adec3ceg67b0g4b1ag8b2cg17e8fe2fc830"
msgid "Sounds like Halsin might be the better bet. Where is he?"
msgstr "할신이 더 좋은 선택일 같군. 그는 어디 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = e067485b-ba37-57e8-aaa8-cea3169984f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:e067485b-ba37-57e8-aaa8-cea3169984f0
msgctxt "h7c93099cge636g4744ga7e3g1b165c25120d"
msgid ""
"My oath often aligns with the Treefather's will. He would not abide child-"
"slaughter."
msgstr "내 맹세는 나무 아버지의 뜻과 많이 일치한다. 그는 아동 살해를 용납하지 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = e067485b-ba37-57e8-aaa8-cea3169984f0
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:e067485b-ba37-57e8-aaa8-cea3169984f0
msgctxt "h99f92241gdfc5g416bgbb03g32743c15bdb5"
msgid ""
"I swore an oath to stop terrible deeds like that. Monsters like <i>her.</i>"
msgstr "나는 <i>그녀</i>와 같은 괴물이 그런 끔찍한 일을 하는 것을 막기로 서약에 맹세했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = e371c08d-f5f9-a554-1284-4ad00db7444e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:e371c08d-f5f9-a554-1284-4ad00db7444e
msgctxt "h7060ebd6gc48eg4a81g9dc4g418f1292b5bf"
msgid "Please, if you find him, let me know."
msgstr "부탁합니다. 그를 찾으면 제게 알려주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = e38e0cb1-9c6a-e6cf-46be-5d5716d29146
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:e38e0cb1-9c6a-e6cf-46be-5d5716d29146
msgctxt "h3448aa9cgd826g4ab6gaae1gbff4c1a73a5a"
msgid ""
"To think Kagha had turned to the ways of shadow. Her corruption ran so deep."
msgstr "카그하가 그림자의 길로 돌아섰다는 게 믿기지 않는군요. 이렇게나 깊이 오염되었다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = ee6cad13-a9bb-2e49-2cca-17ee9f07c482
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_HeardAboutRitual = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:ee6cad13-a9bb-2e49-2cca-17ee9f07c482
msgctxt "hbc74f545g2dfag47efg9289ge86a0aed4748"
msgid "I've heard there's some sort of ritual going on."
msgstr "어떤 의식이 진행된다고 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = eed8b55f-29f2-c5e8-673f-017f781bcc67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:eed8b55f-29f2-c5e8-673f-017f781bcc67
msgctxt "h00c605a8g2c32g4d77g8d04gd5bfb6490a50"
msgid ""
"Would that I could track himself myself. But I cannot leave with Kagha doing "
"as she wills."
msgstr "제가 직접 그를 추적할 수 있다면 좋겠습니다만, 저는 카그하가 자신의 뜻대로 하도록 내버려둘 수 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = f93fb593-ba1f-64da-7e9c-c14148d2e8ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:f93fb593-ba1f-64da-7e9c-c14148d2e8ff
msgctxt "hf597ab70g2bb1g4dd6g8b05g41e19ee17450"
msgid "Silvanus' blessing upon you. And my gratitude as well."
msgstr "저의 감사한 마음과 함께 당신에게 실바누스님의 축복이 깃들기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Rath
#. NodeID = fadf5fef-b07f-fe12-a8de-beb46934a412
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:fadf5fef-b07f-fe12-a8de-beb46934a412
msgctxt "hd303211ag1e89g4c69g9c9dgaf6c8c716440"
msgid "You won't mistake the First Druid for anyone else."
msgstr "당신이 최고 드루이드를 다른 누구와 혼동하지는 않을 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = fd442563-95d9-c1d8-1b9c-732b0290fd1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:fd442563-95d9-c1d8-1b9c-732b0290fd1d
msgctxt "h8edd760fg059dg48fbg8462g5615ce8bf885"
msgid "Sounds like I'd better leave."
msgstr "나는 떠나는 것이 좋을 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed
#. Speaker = Player
#. NodeID = fe868a8e-499d-5ce5-933f-35968ccdc08b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_Halsin_Knows_IsFound = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_Opposed:fe868a8e-499d-5ce5-933f-35968ccdc08b
msgctxt "h99ab49cfgb7d4g48a9gab8bg4fc9e876fed0"
msgid "I found Halsin in the goblin camp, but he can't return yet."
msgstr "고블린 야영지에서 할신을 찾았지만, 아직 이곳으로 돌아오지 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden
#. Speaker = Rath
#. NodeID = 178087e8-228e-5b84-db35-31c535572353
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden:178087e8-228e-5b84-db35-31c535572353
msgctxt "h11b7b5d1ge280g4a2ag8beag2369653d5431"
msgid ""
"When Kagha shirked her duty, you upheld it in her stead. Let this gift be "
"our thanks."
msgstr "카그하가 의무를 회피했을 때 당신이 대신 도와주셨죠. 감사의 뜻으로 이 선물을 드리지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden
#. Speaker = Rath
#. NodeID = 3755aaeb-9cf9-3f54-609f-7e97b8695cfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden:3755aaeb-9cf9-3f54-609f-7e97b8695cfb
msgctxt "h0c77154cg768ag422cg983eg489094693e09"
msgid ""
"I pray the Treefather nourishes Kagha's wounded soul, now that she is dead."
msgstr "카그하는 죽었으니, 이제 나무 아버지께서 그 상처입은 영혼을 보살펴 주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden
#. Speaker = Rath
#. NodeID = 3acf0a1c-8fd1-0eb4-5c0d-b50fd9c2fddb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_Event_SetFaithwarden = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden:3acf0a1c-8fd1-0eb4-5c0d-b50fd9c2fddb
msgctxt "hc5778da9g7e0eg42d9gbe69g999207363ecf"
msgid "You burn like fire, you howl like wind. You are <i>Faithwarden.</i>"
msgstr "당신은 불과 같이 타오르고, 바람과 같이 울부짖죠. 당신은 <i>믿음지기</i>입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden
#. Speaker = Rath
#. NodeID = 8dd05746-e611-1b75-94d6-2e060668a4c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden:8dd05746-e611-1b75-94d6-2e060668a4c1
msgctxt "h54c54bcfg494bg4e09g9600g2749561ec95e"
msgid ""
"A Faithwarden speaks with the authority of the four elements. When you "
"speak, the circles will listen."
msgstr "믿음지기의 말에는 사대 원소의 권위가 실려있습니다. 당신이 말씀에 회합은 귀를 기울일 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden
#. Speaker = Rath
#. NodeID = 964a5c8f-08fb-c806-7bf9-46b0d7d31cb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden:964a5c8f-08fb-c806-7bf9-46b0d7d31cb3
msgctxt "hba96fb74g8662g4978gbcdeg4d50ce9d1d97"
msgid "You have saved Kagha from herself. I cannot thank you enough."
msgstr "당신은 카그하를 본인에게서 구해내셨습니다. 어떻게 감사해야 할지 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden
#. Speaker = Rath
#. NodeID = a9ccb2f0-9029-656e-acc9-64064e128585
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_HasMet_OpposedPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden:a9ccb2f0-9029-656e-acc9-64064e128585
msgctxt "he7c93cfcg73ddg46e7g921cgfad24486601f"
msgid ""
"A tragedy, that Kagha would turn her back on shadow, only to succumb to it."
msgstr "비극입니다. 카그하가 그림자에 등을 돌렸으나, 결국 그것에 굴복하고 말았군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden
#. Speaker = Rath
#. NodeID = d27f001e-ce07-51f6-9d4d-a28f9a5f1509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_OpposedFaithwarden:d27f001e-ce07-51f6-9d4d-a28f9a5f1509
msgctxt "h05edea4dg7272g4f2cgafd6gbb1e33e7dd74"
msgid "Go forth, and let your might be known."
msgstr "당신의 힘을 세상에 보이십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "hec20a6c9gab09g400fga488g3bab2a0350dd"
msgid "Really? She's more interesting than I gave her credit for."
msgstr "정말로? 내가 생각했던 것보다 훨씬 재미있는 여자였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "h3f61c216g909ag45ffg87d3gc5bb43399cda"
msgid "No one in the grove will suspect their true enemy walks among them."
msgstr "숲에 있는 그 누구도 진정한 적이 내부에 있을 거란 생각은 못 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "h86cad381g5138g4113gae9eg029a3efbfb22"
msgid "I say we have a chat with ol' snake-eyes."
msgstr "뱀 눈깔하고 얘기 좀 해야겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "h67ac7009g970eg4303gba7bg6efeb078a0d2"
msgid "A pitiless druid harbours a deep secret? Shocking."
msgstr "냉혹한 드루이드가 깊은 비밀을 품고 있다라? 충격적이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "hd9af5bf5g6a4eg4ee5gbcc9gf80619811e3e"
msgid "Useful information. Or dangerous. Both, likely."
msgstr "유용한 정보군. 위험하기도 하고. 아마 둘 다겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "ha64ee3aeg1ea5g46d3g90fbgeaf30c3042e0"
msgid "The woman's a menace. I say it's time for a chat."
msgstr "참 위험한 여자로군. 이제 대화를 나눠볼 때인것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "h866a7472gcdb3g4e96g8a21gccf610eaab7e"
msgid "The circle will fall into darkness if we don't intervene."
msgstr "우리가 개입하지 않으면 회합은 어둠 속으로 빠질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 29592715-c9f6-8ef5-3594-3784891d5726
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:29592715-c9f6-8ef5-3594-3784891d5726
msgctxt "h34d6645dg6510g44dfg984bg3f0822877724"
msgid "It's time we had a talk with her, don't you think?"
msgstr "이제 그녀와 대화를 나눠 볼 때인것 같은데, 어떻게 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "h06a066dcg7adfg4973g89a6g12ec188a3d47"
msgid "Shadow Druids? Kagha's more interesting than I gave her credit for."
msgstr "그림자 드루이드라고? 카그하는 내가 생각 했던 것 보다 더 흥미로운 사람인 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "h50c6013dg7162g4ae1gb1d5g5601d82c6324"
msgid ""
"So Kagha is involved with the Shadow Druids. That certainly explains things."
msgstr "그러니까 카그하가 그림자 드루이드랑 연관이 있다는 거네. 그럼 어느정도 말이 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "hfb39329ag805eg4eecgb841ga1d3675a24d0"
msgid "Kagha's rubbing shoulders with Shadow Druids. Explains a lot."
msgstr "카그하가 그림자 드루이드랑 어울리고 있네. 많은 것이 설명 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "h8db6649eg0b36g4cb6g94degce4c9419c96c"
msgid "Kagha does not just protect the circle. She means to turn it."
msgstr "카그하는 회합을 지키려는 게 아니라, 바꾸려고 하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "h2161baffg3bbcg419eg9e81g88ab9cc52451"
msgid "Shadow Druids... it seems Kagha's been keeping secrets."
msgstr "그림자 드루이드라... 카그하가 비밀을 품고 있었나 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "h378af1a6ge666g4608g98e4g7b59921baef7"
msgid "Kagha, a Shadow Druid. How did I not see it coming?"
msgstr "카그하가 그림자 드루이드였군. 왜 눈치채지 못했을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "h48ca5542g7f69g4cc5ga9b7g4a9107fd203e"
msgid "Shadow Druids? Kagha means to turn the circle."
msgstr "그림자 드루이드라고? 카그하가 회합을 뒤바꿔 놓으려 하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 44de0c27-0f23-3935-c436-8ff44b1aa5a9
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_SawKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:44de0c27-0f23-3935-c436-8ff44b1aa5a9
msgctxt "he8ac9f42g65b2g4788g8815gfffed02496d8"
msgid "Shadow Druids? There's more to Kagha than meets the eye."
msgstr "그림자 드루이드? 카그하는 겉으로 보이는 것보다 많은 비밀이 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "hae6984a3gd7f8g4d42gbc3dgd07e67060d42"
msgid "This 'Kagha' sounds interesting. A shame she'll probably have to die."
msgstr "이 '카그하'라는 사람에게 흥미가 생기는군. 죽여야 할 것 같아서 안타깝네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "hf3a59fbbgaca3g46d2g976dg00ef66b1791d"
msgid ""
"Shadow Druids have taken root in these parts, and whoever Kagha is, she's "
"their agent."
msgstr "그림자 드루이드가 이곳에 뿌리를 내렸군. 카그하가 누구건 간에 그자들의 수족인 건 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "h6023632cge306g4cf9gad85gde5351c35f35"
msgid "Are there Shadow Druids here? Who's Kagha?"
msgstr "여기에 그림자 드루이드가 있다고? 카그하는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "hdc2ce1b9g355cg4a95gae0bg4427dccb30cc"
msgid "Shadow Druids? This Kagha could prove an obstacle."
msgstr "그림자 드루이드라고? 이 카그하라는 녀석이 걸림돌이 될 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "h97ae7c5cgbda5g47fega631g5fd624ae61f1"
msgid ""
"Seems like some Shadow Druids turned someone called 'Kagha' to their cause."
msgstr "그림자 드루이드들이 '카그하'라는 자를 대의에 이용하고 있는 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "h87ea1cedg0399g4fa3gaf67gd5a505a07dbe"
msgid "Shadow Druids? A bad sign indeed. Watch out for this 'Kagha.'"
msgstr "그림자 드루이드라고? 확실히 나쁜 징조인걸. 이 '카그하'라는 자를 조심하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "h8d071849g15d2g49e7g8bf6g2e0c63faa9ba"
msgid "Shadow Druids? This Kagha is <i>not</i> to be trusted."
msgstr "그림자 드루이드라고? 이 카그하라는 자를 믿어선 <i>안 되겠어</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter
#. Speaker = Player
#. NodeID = 778576a1-9fa3-75a0-e1e5-46760cfae8fd
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundRecruitmentLetter:778576a1-9fa3-75a0-e1e5-46760cfae8fd
msgctxt "h20219219g1e42g4703gb0deg7b6a341776d8"
msgid "Shadow Druids at work - and this Kagha is their newest recruit."
msgstr "그림자 드루이드들이 활개를 치고 있고, 이 카그하라는 자가 새로 들어온 모양이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
msgctxt "h8dacb16cg7c74g4f36g86e4g62bb5d5bb065"
msgid "Hello. Someone's taken a knife to that tree."
msgstr "이것 봐. 누군가 이 나무에 칼을 댄 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
msgctxt "hf1b5dec1g05f8g4e2dg8a43g968f26b0781e"
msgid "There's a mark on that tree. How... intriguing."
msgstr "저 나무에 표식이 있어. 이거... 흥미롭군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
msgctxt "h508b63dbgc3a2g41b9g9fcfgf8d5c0322792"
msgid "Someone notched this tree. Wonder why."
msgstr "누군가 이 나무에 홈을 파놨어. 왜 그랬을까.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
msgctxt "hd419a419g4b08g4e92ga71fg8efb3034c83d"
msgid "That tree's been marked. Hardly nature's work."
msgstr "저 나무에 표식이 남아있다. 자연의 솜씨로 보긴 어렵군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
msgctxt "h069a0f9dgfaf0g493dgb7ebg71a09f21985e"
msgid "There's a hollow in that tree... looks hand-carved."
msgstr "저 나무에 움푹한 홈이 있어... 손으로 파낸 것 같아.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
msgctxt "h7aec5426g4379g45e9g9b0cg603e09546553"
msgid "There's a cleft in that tree. Squirrels, I suppose."
msgstr "저 나무에 갈라진 틈이 있다. 다람쥐겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:b25e72e1-49cd-dcc7-7a6f-5bef7fc628c5
msgctxt "hcd9f9b75g4c60g49fbgba3cga0c92dede267"
msgid "Odd - someone's cut a notch in the tree there."
msgstr "이상하군. 누가 저기 있는 나무에 홈을 파 놨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = bbf214cc-152a-e53a-053a-b53f83f724e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_MeetingLocation = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:bbf214cc-152a-e53a-053a-b53f83f724e7
msgctxt "h218650d5g040cg46fdg9612g5e00ef927562"
msgid "That seems to be Kagha's tree. And the Shadow Druids' mark."
msgstr "저게 카그하의 나무인 것 같아. 그림자 드루이드의 표식도 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = bbf214cc-152a-e53a-053a-b53f83f724e7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_MeetingLocation = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:bbf214cc-152a-e53a-053a-b53f83f724e7
msgctxt "h8be70470g3cfag4241ga15ag27226c4fcae3"
msgid "A marked tree. Could be the one Kagha mentioned in her correspondence."
msgstr "표시된 나무야. 카그하가 서신에 언급한 나무일 수도 있겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = bbf214cc-152a-e53a-053a-b53f83f724e7
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_MeetingLocation = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:bbf214cc-152a-e53a-053a-b53f83f724e7
msgctxt "h8a545e40g2d17g4b0cg8c27gbbcb92f2658f"
msgid "That's a marked tree. Maybe the one from Kagha's letter."
msgstr "표식이 남겨진 나무다. 어쩌면 카그하의 편지에 적힌 그거 아닐까.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = bbf214cc-152a-e53a-053a-b53f83f724e7
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_MeetingLocation = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:bbf214cc-152a-e53a-053a-b53f83f724e7
msgctxt "h4891fbd6g59dag49d0gbb91g15336f856761"
msgid "An odd tree. That note to Kagha mentioned something like this."
msgstr "기이한 나무로군. 카그하 앞으로 적힌 쪽지에 이런 게 언급되었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = bbf214cc-152a-e53a-053a-b53f83f724e7
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_MeetingLocation = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:bbf214cc-152a-e53a-053a-b53f83f724e7
msgctxt "h238be6e0gdb4fg4f76ga78cg973e925065d0"
msgid "This looks like the tree mentioned in Kagha's note."
msgstr "이게 카그하의 쪽지에 언급된 그 나무같은데.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = bbf214cc-152a-e53a-053a-b53f83f724e7
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_MeetingLocation = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:bbf214cc-152a-e53a-053a-b53f83f724e7
msgctxt "hc85d6441g2a81g4107ga693g99335f62e7ab"
msgid "That note mentioned a swamp-tree. This could be the one."
msgstr "그 쪽지에 늪지 나무가 언급됐지. 이게 그거일 수도 있겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation
#. Speaker = Player
#. NodeID = bbf214cc-152a-e53a-053a-b53f83f724e7
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_MeetingLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_FoundSecretLocation:bbf214cc-152a-e53a-053a-b53f83f724e7
msgctxt "h15b6f7feg4188g4f4fgbc1fga9581e9e62a6"
msgid "Hm - must be the tree from the note to Kagha. What's that cleft there?"
msgstr "흠, 카그하에게 보낸 쪽지에 있던 나무인 것 같아. 저 틈은 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = ae12cb2d-1901-4a30-9af5-a083efad12c1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:ae12cb2d-1901-4a30-9af5-a083efad12c1
msgctxt "h89d520dcgea52g495bg9a5ag8f0fc84445a8"
msgid "Such cruelty among druids. I've never seen the likes of it."
msgstr "드루이드가 이렇게 잔인할 수 있다니. 난생 처음 보는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = ae12cb2d-1901-4a30-9af5-a083efad12c1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:ae12cb2d-1901-4a30-9af5-a083efad12c1
msgctxt "h70da0743gcc7eg46b1g9f8bg2b610f52467e"
msgid "Another dead refugee. What a sorry bunch of souls."
msgstr "죽은 피난민이 또 늘었네. 정말이지 안타까운 영혼들이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = ae12cb2d-1901-4a30-9af5-a083efad12c1
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:ae12cb2d-1901-4a30-9af5-a083efad12c1
msgctxt "h99f73d04g0f94g48d2g9d36g479ba3015742"
msgid ""
"They killed a child, for that...? Let's get in and out of this place before "
"any vipers decide to bare their fangs at us."
msgstr "그저 저런 이유로... 아이를 죽이다니? 독사가 우리에게 송곳니를 드러내기 전에 빨리 볼일을 보고 떠나자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = ae12cb2d-1901-4a30-9af5-a083efad12c1
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:ae12cb2d-1901-4a30-9af5-a083efad12c1
msgctxt "hae12a5a2g1484g4275g885ag040ec609484e"
msgid ""
"The girl was a fool to cross Kagha. No offence is so minor that it should "
"escape judgement."
msgstr "카그하를 거스르다니. 바보 같군. 사소한 잘못이라고 심판을 피할 수는 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = ae12cb2d-1901-4a30-9af5-a083efad12c1
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:ae12cb2d-1901-4a30-9af5-a083efad12c1
msgctxt "h022bb648g8c4cg4e9agaec3g508556eacd9f"
msgid "I can't believe what I just watched."
msgstr "방금 내가 뭘 본 건지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = ae12cb2d-1901-4a30-9af5-a083efad12c1
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:ae12cb2d-1901-4a30-9af5-a083efad12c1
msgctxt "h334a2a06g66aeg40a4gb7e5g526ee59f43d2"
msgid ""
"If the errors of youth deserve an early grave, none of us would live to see "
"a dozen summers. There is no justification for this tragedy."
msgstr ""
"어린 시절의 잘못을 이른 죽음으로 갚아야 한다면, 우리 중 누구도 살아서 열두 번의 여름을 보지 못할 거야. 이 비극에 정당성은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = ae12cb2d-1901-4a30-9af5-a083efad12c1
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:ae12cb2d-1901-4a30-9af5-a083efad12c1
msgctxt "h20122e31gc489g4c30ga2f9ga8f51632c2e0"
msgid ""
"The snake killed that girl in front of everyone. Is this grove worth a dead "
"child?"
msgstr "그 아이는 모두가 보는 앞에서 뱀에게 죽었어. 이 숲이 아이들을 죽일 만큼 가치가 있는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = d5541bcc-832a-4b46-b327-111568ad5d22
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:d5541bcc-832a-4b46-b327-111568ad5d22
msgctxt "h0214e296g2a78g4536g8caeg7515dd7e82c6"
msgid "The girl had her whole life ahead of her. Gods, such wanton cruelty."
msgstr "그 아이는 아직 제대로 살아 보지도 못했다고. 젠장, 이런 만행이 있나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = d5541bcc-832a-4b46-b327-111568ad5d22
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:d5541bcc-832a-4b46-b327-111568ad5d22
msgctxt "h4f482527g46ceg4e8dg8a47g8e91b91b3436"
msgid "Enough. The child is dead. No need to prolong the matter."
msgstr "그만. 꼬마는 죽었다. 말썽을 늘릴 필요는 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = d5541bcc-832a-4b46-b327-111568ad5d22
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:d5541bcc-832a-4b46-b327-111568ad5d22
msgctxt "hce9a024fgb117g4cb4gafabgbe33a565d463"
msgid ""
"Let's get on, before the druids decide we're on their list of enemies, too."
msgstr "서두르자구. 저 드루이드 놈들이 괜히 우리한테 애꿎은 화살을 돌릴라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = d5541bcc-832a-4b46-b327-111568ad5d22
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:d5541bcc-832a-4b46-b327-111568ad5d22
msgctxt "h17cb8d04ga492g432ag9461gc70395b8ddfb"
msgid "We... can't help everyone. Even if we want to."
msgstr "우리가... 모두를 도울 순 없어. 그러고 싶더라도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = d5541bcc-832a-4b46-b327-111568ad5d22
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:d5541bcc-832a-4b46-b327-111568ad5d22
msgctxt "h98412deega2b2g4919gac86g9bf2e575c1b7"
msgid "Poor thing. Poor baby. Gods!"
msgstr "가엾어라. 불쌍한 녀석. 젠장!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = d5541bcc-832a-4b46-b327-111568ad5d22
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:d5541bcc-832a-4b46-b327-111568ad5d22
msgctxt "h00482b9eg9cabg4e7bg996bg6fb12cf53c76"
msgid ""
"This place is a snake pit in more ways than one. That poor girl... Such "
"sudden madness..."
msgstr "여긴 여러모로 뱀 구덩이야. 그 불쌍한 소녀... 이렇게 갑작스런 광기..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied
#. Speaker = Player
#. NodeID = d5541bcc-832a-4b46-b327-111568ad5d22
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_PAD_KidDied:d5541bcc-832a-4b46-b327-111568ad5d22
msgctxt "hd53260degce83g41ddgbfa1g1b5992ce56ea"
msgid "The longer we stay here, the closer we come to reaching the same fate."
msgstr "이곳에 오래 머무르면 머무를수록 우리 역시 같은 운명에 가까워질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Narrator
#. NodeID = 15aa305b-afbb-6468-5ff7-d4179016461e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:15aa305b-afbb-6468-5ff7-d4179016461e
msgctxt "h3949d476g8333g40b5g9e5eg520ab46e587e"
msgid ""
"*Those within are isolated and those without, rejected. Isolation breeds "
"violence. Few circles survive it.*"
msgstr ""
"*내부에 있는 사람은 고립되고, 바깥에 있는 사람은 거부됩니다. 고립은 폭력을 낳습니다. 여기서 살아남을 회합은 거의 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Player
#. NodeID = 1a96e272-916e-5b60-338f-5602f116bc55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:1a96e272-916e-5b60-338f-5602f116bc55
msgctxt "h1d21560ag65c6g4964gb6d9g4cf25f9ec795"
msgid ""
"<i>Free your mind. The nature of Kagha's magic is not yours to question.</i>"
msgstr "<i>마음 쓰지 않는다. 카그하의 마법의 본질은 아무래도 상관 없다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Player
#. NodeID = 3c2c9c82-9152-cb02-8e0e-53a06610c03a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:3c2c9c82-9152-cb02-8e0e-53a06610c03a
msgctxt "he49c9d1cgf18cg4aa2gb759g641f922c6db1"
msgid "<i>Ponder Kagha's passion. You heard truth in her words.</i>"
msgstr "<i>카그하의 열정을 높이 평가한다. 그녀의 말에는 진실이 담겨 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Narrator
#. NodeID = 3d7d8191-d999-f668-bd2c-6448d7dba789
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:3d7d8191-d999-f668-bd2c-6448d7dba789
msgctxt "h04fbdb8cga7b3g4b1dg8bc5ga1daa623b599"
msgid "*There is more to Kagha's tale. The grove must hide her secrets.*"
msgstr "*카그하의 이야기 외에 더 많은 내막이 있습니다. 숲이 그녀의 비밀을 숨기고 있는 게 분명합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Narrator
#. NodeID = 6114405f-e923-291b-3e6e-486f20bd0ae0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:6114405f-e923-291b-3e6e-486f20bd0ae0
msgctxt "hdf2eaab7gd691g4d97g8197gef1cf5fef0b3"
msgid ""
"*A circle in danger closes ranks. Yet Kagha alone could not draw on the "
"rite's power.*"
msgstr "*위험에 처한 회합은 스스로를 닫습니다. 카그하 혼자서는 의식의 힘을 끌어낼 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Narrator
#. NodeID = 76906bb3-f210-5f33-1f68-ed59a82182f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:76906bb3-f210-5f33-1f68-ed59a82182f5
msgctxt "h72eabb90gd4d0g4325gaf7fgbee2e1dece46"
msgid "*Nature seeks balance, yet in Kagha you see more shadow than light.*"
msgstr "*자연은 균형을 추구하지만, 카그하는 빛보다 어둠을 우선시하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Player
#. NodeID = 7b73c6f1-3fa9-1db6-70ab-b156c71d4ae4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:7b73c6f1-3fa9-1db6-70ab-b156c71d4ae4
msgctxt "h64153f3dgf9b4g4930gbbe9gb62416278521"
msgid "<i>Lament Kagha's anger. She treads a dangerous path.</i>"
msgstr "<i>카그하의 분노를 한탄한다. 그녀는 위험한 길을 걷고 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Player
#. NodeID = abff0f08-c89c-255e-b88d-6c3f4f3ba2a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:abff0f08-c89c-255e-b88d-6c3f4f3ba2a2
msgctxt "h91223905gef03g4a04g8a4dg746d2e00a316"
msgid "<i>Think back to your teachings. What are the rite's perils?</i>"
msgstr "<i>자신이 배운 것을 상기한다. 이 의식의 위험은 무엇인가?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Narrator
#. NodeID = bd3bcdf8-fab1-f09e-36ec-787b03d8edd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:bd3bcdf8-fab1-f09e-36ec-787b03d8edd9
msgctxt "h1f55d693g95a3g457bgba80g14859d5f444e"
msgid ""
"*When the prayer ends, vines curl upwards from the earth and thorns sprout "
"forth.*"
msgstr "*기도가 끝나면, 땅속에서 덩굴이 감겨 위로 올라가고, 덩굴에서 가시가 돋아납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Narrator
#. NodeID = db9110f2-8228-39a6-2cfd-0b054757c31b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_HadSelfReflection = True
#.   Quest:
#.     - DEN_Conflict_SUB_Ritual.ReflectedKagha(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:db9110f2-8228-39a6-2cfd-0b054757c31b
msgctxt "h0ca746abge6c1g47bag817bg15f561cfd160"
msgid ""
"*You consider the Rite of Thorns. A rare art, plucked from illicit domains.*"
msgstr "*당신은 가시의 의식을 생각합니다. 금단의 영역에서 가져온 희귀한 마법입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection
#. Speaker = Narrator
#. NodeID = e34bc208-5174-4b0e-0ea1-854ab2879d72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SelfReflection:e34bc208-5174-4b0e-0ea1-854ab2879d72
msgctxt "h010b5c84g18fag4681ga0bcgef44c10ca269"
msgid "*Your mind rests, but the circle's prayer still resonates in the air.*"
msgstr "*당신의 마음은 편하지만, 회합의 기도가 지금도 공기 중에 울려 퍼집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 00883fa8-c425-c8cc-ce17-4547d023d7e2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - MONK(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:00883fa8-c425-c8cc-ce17-4547d023d7e2
msgctxt "h762e5b23g0f2fg4574g892dg7d27c6c937d6"
msgid ""
"You act rashly - as a cornered viper would. Free the child or more tieflings "
"will interrupt you."
msgstr "경솔하게 행동하는군. 아이를 풀어주지 않으면 더 많은 티플링들이 당신을 방해할 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 0502531d-48ab-4f02-10fc-8aad8ee7e75b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:0502531d-48ab-4f02-10fc-8aad8ee7e75b
msgctxt "h1ca9de80g952cg4972g8b68g7cc579456d76"
msgid "Not cruelty. Justice."
msgstr "잔인한 게 아니야. 정의지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 06ce3e85-b177-45cb-dd6a-4648f374e640
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_KaghaIsEvil = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:06ce3e85-b177-45cb-dd6a-4648f374e640
msgctxt "h331cd1ddgfe97g46a0gbe65g7f74c3f83929"
msgid "<i>Aithyas!</i> Teela, to me."
msgstr "<i>Aithyas!</i> 틸라, 내게로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 08cefaa7-a4c1-29de-be24-7908428d51eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:08cefaa7-a4c1-29de-be24-7908428d51eb
msgctxt "hf2b5c340gd8a4g489dg93b0g1b439f9f94ab"
msgid "Rath - lock her up. She remains here until the rite is complete."
msgstr "라스, 그녀를 가둬라. 의식이 끝날 때까지 이곳에 머무를 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 0b5ca4a6-aadb-9e7a-4971-3dc8d1663ce6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:0b5ca4a6-aadb-9e7a-4971-3dc8d1663ce6
msgctxt "h7d10364ag0e93g4c79gbe10gd9668ceff618"
msgid "The words of the Treefather, spoken plain."
msgstr "나무 아버지의 말씀을 인용하다니, 입바른 소리로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 0cff5d6a-ef88-bda1-4360-acc99327e0e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:0cff5d6a-ef88-bda1-4360-acc99327e0e8
msgctxt "hd6dc11ddg9a27g4190g8facgbe524a031a18"
msgid ""
"The parasite eats our food, drinks our water. Then steals our most holy idol "
"in thanks!"
msgstr "이 기생충은 우리 음식을 먹고, 물을 마신다. 그에 대한 감사 표시로 신성한 우상을 훔칠 줄이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 0e2c2198-e7b5-4fb5-8f7c-6fce01de5f68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:0e2c2198-e7b5-4fb5-8f7c-6fce01de5f68
msgctxt "h43912074g6e5ag497aga3bbgb37d2b0e6fa8"
msgid ""
"*But was it truly <i>nothing?  </i>The pain gripped you tight, robbing you "
"of all composure for a moment...*"
msgstr "*하지만 정말 <i>아무 것도</i> 아니었을까요? 고통은 당신을 꽉 휘어잡았고, 한순간 평정심을 잃을 정도였습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 0f72a557-4b7c-a8e7-be2b-6a360e2589d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1d54942c-e707-2b27-c461-bc033d258d04_ResistedDarkUrge = False
#.   Tag:
#.      - REALLY_DARK_URGE(5) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:0f72a557-4b7c-a8e7-be2b-6a360e2589d6
msgctxt "h464e3c83ga147g4b39gb34bg541ecf13bd88"
msgid "<i>Flick your eyes to the exit so the child will try to run.</i>"
msgstr "<i>출구로 눈짓을 해서 아이가 달아나게끔 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 1079155f-35ed-c8b1-e753-02f51baa3cf3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:1079155f-35ed-c8b1-e753-02f51baa3cf3
msgctxt "h10ff415bg4991g4aeaga1b8g91a877ac834a"
msgid "<b>CALL OFF YOUR WORM.</b>"
msgstr "<b>네 지렁이를 당장 치워.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 12272a0a-855a-b21c-0b98-09b20ad8e18d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_SnakesCourt_FailedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:12272a0a-855a-b21c-0b98-09b20ad8e18d
msgctxt "h09e20706gd546g46dfg85fdgd0eb1b89ddaf"
msgid "No - the tiefling remains until the rite is complete."
msgstr "아니. 이 티플링은 의식이 끝날 때까지 여기 남을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 141234b7-1eb4-8f90-b1ba-a07c6bd751f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:141234b7-1eb4-8f90-b1ba-a07c6bd751f0
msgctxt "he9a69208gea6dg4bf2gb600g17b038f42d8f"
msgid ""
"My circle has offered grace to these outsiders. We gave them shelter from "
"storm, we nourished their bellies."
msgstr "내 회합은 이 이방인들에게 은혜를 베풀었다. 그들에게 피난처를 제공하고, 배를 채워줬지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 1431f7aa-7d11-dc63-ca8d-8a134bc653a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:1431f7aa-7d11-dc63-ca8d-8a134bc653a5
msgctxt "hca1d3e6cg9d8bg41d7g9799g813a34f3158f"
msgid "Well, paladin - what say you?"
msgstr "그렇다면, 팔라딘. 그대의 결정은 무엇이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 156af777-890f-be1b-7e8d-defdf2d4c15b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:156af777-890f-be1b-7e8d-defdf2d4c15b
msgctxt "h43405cb9g8bb2g4ae8g8f94g81d692f6e0c7"
msgid "Cage the girl. It's a fitting response to the crime she committed."
msgstr "아이를 가둬라. 본인이 저지른 범죄에 걸맞은 대가인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Teela
#. NodeID = 1574ba46-f58d-86ba-a5cf-f8fc60019097
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:1574ba46-f58d-86ba-a5cf-f8fc60019097
msgctxt "hc4c7ae8cg8483g449agaed9ge0498c36e439"
msgid "<i>Kagha si nay. Wux geou fulla wer fanol.</i>"
msgstr "<i>카그하 시 네이. 욱스 기요 풀라 우르 판올.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 1737500c-0692-c10e-7f84-8f3ac6074a36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:1737500c-0692-c10e-7f84-8f3ac6074a36
msgctxt "h7b849022g8fa2g4e01gbfd2gd9e3ac08c1ba"
msgid ""
"Very well - she may go. Break your word, and my serpent shall feed. "
"<i>Ssifisv</i> - Teela, to me."
msgstr "좋다. 그녀를 보내줘라. 약속을 어기면, 내 독사가 가만히 있지 않을 것이다. <i>Ssifisv</i> - 틸라, 내게로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 18dc424b-dd4e-3eb0-e5e2-20a63674b272
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:18dc424b-dd4e-3eb0-e5e2-20a63674b272
msgctxt "he87ca12cg27afg42fcg842fg2999bc1f1f75"
msgid "<b>RELEASE HER. <i>NOW.</i></b>"
msgstr "<b>그녀를 풀어줘. <i>당장.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Arabella
#. NodeID = 19c6b037-b3a2-25e0-dea4-35d2a5247fe0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:19c6b037-b3a2-25e0-dea4-35d2a5247fe0
msgctxt "h055a6bc5gf076g4d2ag8f96g0b5aef58fdc4"
msgid "I - I was scared. They said when the rite was over, we'd have to leave."
msgstr "전 - 전 무서웠어요. 의식이 끝나면, 우리가 떠나야 한다고 했다구요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 19dc8756-c8df-43cf-2174-1effcd8fe7a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:19dc8756-c8df-43cf-2174-1effcd8fe7a0
msgctxt "h5a57041dg9c0fg47c9ga331gb37cb54df98e"
msgid "I've treated with beasts with more etiquette than you."
msgstr "짐승도 너보단 예의가 바를 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 1cb04bb9-7643-d395-826f-a7dec3c21959
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:1cb04bb9-7643-d395-826f-a7dec3c21959
msgctxt "h4c7ec277gd937g422eg9f44g11ed1a563a0e"
msgid "Imprisonment is an appropriate punishment for theft. Lock her up."
msgstr "도둑질에 대한 벌이라면 감금형이 적절하겠군. 아이를 구금해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 1d7e225f-3456-dd43-fd43-c14b85c4fc0e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:1d7e225f-3456-dd43-fd43-c14b85c4fc0e
msgctxt "hb0a8f405g3db0g4d54g96d5g2bb6a2cb2b03"
msgid "Free the whelp, or I run your belly through with a blade."
msgstr "핏덩어리를 풀어 주지 않으면 창자에 칼날을 박아 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 1dd7c3e5-6bce-255a-b240-0277a55f32bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:1dd7c3e5-6bce-255a-b240-0277a55f32bb
msgctxt "h494ccdf8g2036g4c7ag85a6g6f4ce64046d4"
msgid ""
"She eats our food, drinks our water. Then steals our most holy idol in "
"thanks!"
msgstr "이 녀석은 우리 음식을 축내고, 물을 동냥하지. 그에 대한 감사 표시로 신성한 우상을 훔칠 줄이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Teela
#. NodeID = 2073cd6b-dde2-9feb-2c41-cd76571f6efe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2073cd6b-dde2-9feb-2c41-cd76571f6efe
msgctxt "h8edb8715gdee4g4420g9172gc0d1437cf886"
msgid "A new hatchling? Yes. They can be foolish."
msgstr "새로 부화한 새끼인가? 그래. 어리석을 수도 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Rath
#. NodeID = 2332fe66-c311-d1a6-2242-b0e8f3021193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2332fe66-c311-d1a6-2242-b0e8f3021193
msgctxt "h98de5ea9g4b37g4fcdg9735g36539670f837"
msgid "Thank you, Kagha. Master Halsin would..."
msgstr "감사합니다, 카그하. 할신 님도 분명..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Arabella
#. NodeID = 23451c8b-59df-3aff-a648-df936d084036
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:23451c8b-59df-3aff-a648-df936d084036
msgctxt "h595f5c2bg65feg416bg80cfgdd617c8995e6"
msgid "Thank you thank you thank you!"
msgstr "감사합니다. 감사합니다. 감사합니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 235caa65-9d39-4f1b-725f-b13265c17988
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = True
#.      - TIEFLING(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.     - DEN_ShadowDruid_Event_KnowsPlayerDruid(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:235caa65-9d39-4f1b-725f-b13265c17988
msgctxt "h4371938fga74dg4facg95cdgaedcb813a735"
msgid "A seed nobly sown renders the sweetest fruit. Be noble - set her free."
msgstr "숭고하게 뿌린 씨앗이 가장 달콤한 열매를 맺는 법이지. 그녀를 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 2497d0f1-ecb4-bcf9-fb2f-396c14396239
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2497d0f1-ecb4-bcf9-fb2f-396c14396239
msgctxt "hc23c670bg4b4dg4d12g85c5g6bb58fd13c71"
msgid "<i>Do nothing.</i>"
msgstr "<i>아무것도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 24b27aac-e882-7be0-c47b-286c456b9d6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:24b27aac-e882-7be0-c47b-286c456b9d6e
msgctxt "h386d84aagb699g4a83g88ebg28b7548c34b9"
msgid "<i>Ssifisv</i> - Teela, to me."
msgstr "<i>Ssifisv</i> - 틸라, 내게로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 27ce4132-914f-26b5-7537-93a0309f8c0a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_State_CourtHostile(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:27ce4132-914f-26b5-7537-93a0309f8c0a
msgctxt "h26fe8669gf7dfg46f4gb7begf3bfb871dfb9"
msgid "Teela - attack!"
msgstr "틸라 - 공격해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Shadowheart
#. NodeID = 292f65d9-5ed7-2ddc-c037-b48e5c875c2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(8) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_SnakesCourt_SHWarnsAgainstCombat(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:292f65d9-5ed7-2ddc-c037-b48e5c875c2b
msgctxt "h4227307cgdb4cg4a3agab5bg3dbae3ec6b51"
msgid "<i>Leave it. </i>Remember why we're here."
msgstr "<i>내버려 둬. </i>우리가 여기 왜 왔는지 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Astarion
#. NodeID = 294a7eeb-519b-3594-25a7-de0a08684337
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_ASTARION(10) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:294a7eeb-519b-3594-25a7-de0a08684337
msgctxt "had7e3219g4aeag419bgbab6g400a5a0d69a3"
msgid "Don't be a coward. We could take them. We could kill them all."
msgstr "겁쟁이처럼 굴지 마. 놈들은 별것 아니야. 싹 다 죽여버릴 수도 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 2a042717-38d2-5bf4-077e-42a82c9d7320
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2a042717-38d2-5bf4-077e-42a82c9d7320
msgctxt "hc644b38eg3739g429cg9b2dg693c6c2047a7"
msgid "A <i>what</i>, Rath? A thief? A poison? <i>A threat?</i>"
msgstr "<i>뭐지</i>, 라스? 도둑? 독? <i>위협?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 2ad51cae-dd59-4d4b-a613-3766b2e0b462
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(5) = False
#.      - REALLY_SHADOWHEART(5) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2ad51cae-dd59-4d4b-a613-3766b2e0b462
msgctxt "h708addd4gb207g49ebg9bc4g9140ddf45432"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 2ae629b6-219c-f98b-beee-ff1567ec8582
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2ae629b6-219c-f98b-beee-ff1567ec8582
msgctxt "h2ce2dc68g7119g4958g9e2cg94716fc24c48"
msgid ""
"We've taken back our relic. But I will keep the fiend caged 'til our "
"protection rite is complete."
msgstr "우리 유물은 되찾았다. 하지만 우리 보호 의식이 완료될 때까지 이 마족은 가둬두도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 2b8209b2-578d-5f9c-1b52-5d7d23cd3bf5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_ResistedDarkUrge = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2b8209b2-578d-5f9c-1b52-5d7d23cd3bf5
msgctxt "hf07fadefgda1fg4083g8576gc23e2c2e4dd1"
msgid ""
"*Her life matters more than satiating your dark fantasies. You focus and "
"they're gone. But clearly, this child's life is in danger.*"
msgstr ""
"*소녀의 목숨은 당신의 어두운 욕망을 충족시키는 것보다 더 소중한 것입니다. 당신의 집중과 함께 충동은 사라집니다. 하지만 이 소녀의 "
"목숨이 경각에 달했다는 것은 분명합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 2e9f4880-8d5f-f1ab-144c-c626f3f79cfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:2e9f4880-8d5f-f1ab-144c-c626f3f79cfe
msgctxt "heb69f1d8g5611g4f9fga8d7g31fb49b5a060"
msgid "I have heard quite <i>enough</i>."
msgstr "이제 <i>충분히</i> 들은 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 30bd0321-120c-c700-e8b2-5ab9769649da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:30bd0321-120c-c700-e8b2-5ab9769649da
msgctxt "h0438cd4fgf10cg46beg85adg0a833263563e"
msgid "<i>Tsk.</i> A gathered herd of the devils would indeed be disruptive."
msgstr "<i>쯧.</i> 데빌 무리가 모이면 참으로 혼란스럽긴 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 312b5259-183c-cab6-4ea2-f2ef28d5a550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:312b5259-183c-cab6-4ea2-f2ef28d5a550
msgctxt "hda959412gac7dg4113g8347gfce54000aaab"
msgid "She's not a disease - she's a child."
msgstr "그녀는 질병이 아니야. 그녀는 아이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 313e5750-c476-6472-98c4-3ebf70220bc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:313e5750-c476-6472-98c4-3ebf70220bc5
msgctxt "hc820dd40g4c45g4816g9d90g4aef709365fa"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 3289271f-a6e1-ea6a-193c-b00bc5ad5da8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:3289271f-a6e1-ea6a-193c-b00bc5ad5da8
msgctxt "h1a731a00g6e38g4525g9953g1e80db3ce31a"
msgid "Very well. I'll defer to your ruling."
msgstr "좋다. 그대의 판결을 따르겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 3381a141-c93e-e10a-73f1-6c2450d62cf2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = False
#.      - TIEFLING(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:3381a141-c93e-e10a-73f1-6c2450d62cf2
msgctxt "h5ac2e6cag65bdg4127g8da0g3e001e85cbb3"
msgid "Release her. I'll see that she stays out of trouble."
msgstr "그녀를 풀어줘. 그녀가 말썽을 부리지 못하도록 내가 감시하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 349b4d2d-85b2-4c66-aa6b-8d89a736fc9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:349b4d2d-85b2-4c66-aa6b-8d89a736fc9e
msgctxt "h025fc265g33a1g41c5g8f8cg09d3c6001c09"
msgid "<i>It was nothing. Put it out of your mind.</i>"
msgstr "<i>아무 일도 아니었다. 마음 속에서 치워 버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 35a2a015-55e9-eeed-8117-adc1f4ec3274
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:35a2a015-55e9-eeed-8117-adc1f4ec3274
msgctxt "hb20c2ba8g6f0dg41b3g8229gd226b736594e"
msgid "Justice means nothing without mercy. Let her go."
msgstr "자비 없이는 정의도 빛이 바래는 법. 아이를 풀어 줘라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 39974aa4-58c5-279d-1d3d-d8aed236c232
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = True
#.      - PETPAL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:39974aa4-58c5-279d-1d3d-d8aed236c232
msgctxt "hd8de037eg2c5eg4e42ga918gdaf02d7bc63b"
msgid ""
"<i>Tell the snake to put Kagha at ease. The girl belongs with her own "
"brood.</i>"
msgstr "<i>뱀에게 카그하를 안심시키라고 한다. 소녀는 자기 가족과 함께해야 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 39d9e865-e21b-64bc-447e-6618724d4723
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:39d9e865-e21b-64bc-447e-6618724d4723
msgctxt "h8eda744eg2801g49d6g9ffcg3e3b5f7b7080"
msgid "You're no healer. And you're no judge either. Let her go."
msgstr "당신은 치유사가 아니야. 판사도 아니지. 그녀를 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 3a8d4e14-3251-92fc-11a0-807e6a08bce8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:3a8d4e14-3251-92fc-11a0-807e6a08bce8
msgctxt "h34d82d91gec8ag417bg81d5gb29e4d35990d"
msgid ""
"Your snake is prepared to kill this child. Do you want her death on your "
"hands?"
msgstr "네 뱀이 이 아이를 죽이기 직전이야. 그녀의 죽음을 당신 책임으로 남기고 싶나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 3b076c5f-8185-cfee-d1e5-abbee85291ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:3b076c5f-8185-cfee-d1e5-abbee85291ac
msgctxt "hc90b3a29g7a0ag4df6ga40ag2431a1e86dcc"
msgid ""
"You know, then, that Silvanus spoke further. 'The parasite must be removed "
"for new seed to grow.'"
msgstr "그렇다면, 실바누스께서 더 하신 말씀이 있다는 것도 알겠군. '새 씨앗이 자라기 위해서는 기생충을 제거해야 한다.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Rath
#. NodeID = 4117390c-fc40-154c-92fa-8e6eb4516319
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:4117390c-fc40-154c-92fa-8e6eb4516319
msgctxt "h41611233g43f9g4ca2gb5bbg4cefe7271047"
msgid "Kagha, I..."
msgstr "카그하, 저는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 430694e9-5ed2-2f52-0598-898cde99d376
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:430694e9-5ed2-2f52-0598-898cde99d376
msgctxt "h09adfd82g5e0eg4466g895eg46aad33ddf84"
msgid "And keep still, devil. Teela is restless."
msgstr "그리고 얌전히 있어라, 데빌. 틸라를 자극하지 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 4325f0ae-30a6-05fe-3045-0a271e5c9bb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_SnakesCourt_State_WildShapedPlayer = False
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:4325f0ae-30a6-05fe-3045-0a271e5c9bb9
msgctxt "h0b64277fg7c82g4531g8435g3724eeec0740"
msgid "I will imprison the devil. <i>And I will cast out the rest.</i>"
msgstr "저 데빌을 감옥에 가두겠다. <i>그리고 다른 이들은 내쫓을 것이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 4325f0ae-30a6-05fe-3045-0a271e5c9bb9
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_SnakesCourt_State_WildShapedPlayer = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:4325f0ae-30a6-05fe-3045-0a271e5c9bb9
msgctxt "h634a01aag85acg414bg8544g7bf5fad537a8"
msgid "I will imprison the devil. <i>And I will cast out every stranger.</i>"
msgstr "저 데빌을 감옥에 가두겠다. <i>그리고 모든 이방인들을 내쫓을 것이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 438909d8-d854-3d93-0261-205304cef9c4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(5) = True
#.      - BERSERKER(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:438909d8-d854-3d93-0261-205304cef9c4
msgctxt "h75764e68g0677g4b00g8e4cg3aa36af4a567"
msgid "She's just a cub. Let her go, or tangle with me."
msgstr "그녀는 어린 아이에 불과해. 그녀를 풀어주든가, 날 상대해야 할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 45e2fcb0-aca3-87f1-6f11-6fd3616bac0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:45e2fcb0-aca3-87f1-6f11-6fd3616bac0c
msgctxt "hce028860gcf5fg48fbga1aag107e2fdc92e7"
msgid ""
"In return, these devils lured in a horde of goblins, and their spawn stole "
"the one relic that might keep us safe."
msgstr "이 데빌놈들은 보답으로 고블린 무리를 데려왔고, 놈들의 자식은 우리를 지켜줄 유물을 훔치기나 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 471ff6de-1dc4-b0e5-f678-505de455ab83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(5) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:471ff6de-1dc4-b0e5-f678-505de455ab83
msgctxt "h6d674662g939cg4039g9470g0711ba45734a"
msgid ""
"*A death viper. You have milked their poison before. A single drop of it "
"could kill that child in a heartbeat.*"
msgstr "*독사입니다. 당신은 저 뱀의 독을 짜내본 적이 있습니다. 한 방울만 있어도 저 아이를 죽일만한 맹독입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 4849d630-a2d4-a993-6de3-d22f1d3702c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1d54942c-e707-2b27-c461-bc033d258d04_ResistedDarkUrge = False
#.   Tag:
#.      - REALLY_DARK_URGE(5) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_ResistedUrge(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:4849d630-a2d4-a993-6de3-d22f1d3702c7
msgctxt "hb58c2dddg4434g4d0eg910fg9d744e134b45"
msgid ""
"<i>Your mind wants the snake to kill the child. But your heart doesn't. Snap "
"out of it.</i>"
msgstr "<i>정신은 저 뱀이 아이를 죽이길 원한다. 하지만 마음은 그렇지 않다. 떨쳐버리자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Arabella
#. NodeID = 4e7a0665-1945-7a35-f8fe-bce9729022d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:4e7a0665-1945-7a35-f8fe-bce9729022d1
msgctxt "hb441010bg6eb3g49c7g94a1g6864e42b9c89"
msgid "Please, let me go. I'll be good, I swear."
msgstr "제발, 절 보내주세요. 착하게 살게요. 맹세해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 53526aab-5199-4c6e-0923-ea555067fcfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:53526aab-5199-4c6e-0923-ea555067fcfe
msgctxt "he0cc6a9dg4ab3g4499ga0b3g516de43723a2"
msgid "Tell me, Blade. Is the healer cruel for ridding the sick of disease?"
msgstr "말해 봐라, 칼날. 치유사가 환자의 질병을 없애는 것이 잔인한 행동인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 5362aeb4-0b82-688a-4469-6f0fe39fb974
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = False
#.      - PETPAL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:5362aeb4-0b82-688a-4469-6f0fe39fb974
msgctxt "hbdbcbe49g36d2g40f8ga661gc9aaa15ed2ab"
msgid "<i>Tell the snake to be at ease. The girl must not be harmed.</i>"
msgstr "<i>뱀에게 진정하라고 말한다. 이 소녀가 다쳐서는 안된다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 59c4d9ad-5522-12ae-bfb0-3c5c00c80436
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_PlayerKeptSilent = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:59c4d9ad-5522-12ae-bfb0-3c5c00c80436
msgctxt "h42272df0g9296g4248gb8degc81a497235aa"
msgid "<i>Keep silent.</i>"
msgstr "<i>침묵을 유지한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 5a72c58e-a8fa-4eff-61cf-626edbe7fbf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:5a72c58e-a8fa-4eff-61cf-626edbe7fbf8
msgctxt "hafb3afebga34cg4f66gaef6g7a92355066dd"
msgid "I am ready to pass judgement."
msgstr "결정을 내릴 준비가 됐다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 5f5ba4ba-0c07-9d90-cc0d-7d9582c2fd37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:5f5ba4ba-0c07-9d90-cc0d-7d9582c2fd37
msgctxt "hcaabef8cg9a32g4199ga7d3g9f55deb8949e"
msgid ""
"Perhaps you don't know that Silvanus spoke further. 'The parasite must be "
"removed for new seed to grow.'"
msgstr "실바누스께서 더 하신 말씀이 있다는 건 모르나 보군. '새 씨앗이 자라기 위해서는 기생충을 제거해야 한다.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Gale
#. NodeID = 5f64ed7c-c8fb-02cd-2251-7d93d723d489
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_GALE(12) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:5f64ed7c-c8fb-02cd-2251-7d93d723d489
msgctxt "hf4df8f31g2982g425dg84begac9495a10ab3"
msgid "Hold on! It's not too late to settle this without bloodshed."
msgstr "잠깐! 아직 피를 흘리지 않고 이 상황을 해결할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 601e75fd-aa8f-8cf4-4cec-d574a76847f0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:601e75fd-aa8f-8cf4-4cec-d574a76847f0
msgctxt "h93d24fa8gc2d7g491fg861agc7526cd55252"
msgid ""
"I am versed in the ways of justice. Make your case, and I will pass "
"judgement."
msgstr "나는 조예 깊은 정의의 사도다. 서로 주장을 펼치면 판결을 내려 주도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 61012382-c6fc-97e2-ee0e-c6145e734218
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_SnakesCourt_FailedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:61012382-c6fc-97e2-ee0e-c6145e734218
msgctxt "hd69447e3gac77g46cbg9129g930bc820607f"
msgid "The devil sowed chaos. She remains until the rite is complete!"
msgstr "그 데빌이 혼돈의 씨앗을 심었다. 그녀는 의식이 끝날 때까지 이곳에 머무를 것이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 6176cad5-deec-8fc8-0ad5-29d0d9a23a2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:6176cad5-deec-8fc8-0ad5-29d0d9a23a2e
msgctxt "hf565f4bfga54fg483ag984cgcafb7f08309f"
msgid "Unfortunate, but temporary. Detain her for only as long as necessary."
msgstr "안타깝게 됐지만, 금방 지나갈 거다. 아이를 구금하되 필요 이상으로 가두지 말도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 61d2668e-9cab-dbd2-1bf4-5af4e22d5d62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:61d2668e-9cab-dbd2-1bf4-5af4e22d5d62
msgctxt "h5a60a97cg75deg480dg8e69g4716602bddb8"
msgid "The Treefather's words. Your circle taught well."
msgstr "나무 아버지의 가르침이라. 그대의 회합이 잘 가르쳤군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 6442f3e1-b7da-c49b-5692-b833b4a1cc21
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:6442f3e1-b7da-c49b-5692-b833b4a1cc21
msgctxt "hdf80654cgd598g4e0egaab0g5d138dc97073"
msgid ""
"Don't druids cherish harmony? Jailing the girl disrupts nature's balance."
msgstr "드루이드는 조화를 소중히 여기지 않나? 그녀를 가두면 자연의 균형이 방해 받을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 6479eb99-b6e5-32cd-6ca6-2cab2a996aef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:6479eb99-b6e5-32cd-6ca6-2cab2a996aef
msgctxt "hff5d441fg1f46g49bbg9281g7c71f8e3d0c6"
msgid "You dare speak of Teela in this manner?"
msgstr "감히 틸라에 대해 그런 식으로 말을 해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Lae'zel
#. NodeID = 659e5833-a829-2a80-d3b6-8eb1af38d0b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_LAEZEL(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:659e5833-a829-2a80-d3b6-8eb1af38d0b9
msgctxt "hc33b9cb1g7becg40a6g912fg64a37cde831a"
msgid "Let judgement be cast. Spill blood after, if you must."
msgstr "심판을 내리도록 해라. 필요하다면 피칠갑은 나중에 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 686717f8-8eed-4385-9b63-0f710553a71a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:686717f8-8eed-4385-9b63-0f710553a71a
msgctxt "h55a00946g3176g4176gb195g2486d1d35c30"
msgid "*She offers you nothing.*"
msgstr "*여신은 아무 것도 내려 주지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 6a9d84d8-4ca3-43bd-930d-e3046956710e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:6a9d84d8-4ca3-43bd-930d-e3046956710e
msgctxt "head01f6bgdc88g47d0gb8eag09d1ea2605fa"
msgid ""
"*Is Lady Shar punishing you? Or perhaps testing you? Is it the tadpole, or a "
"curse? You cannot say.*"
msgstr ""
"*샤 여신님이 당신을 벌하고 있는 걸까요? 아니면 시험하고 있는 걸까요? 올챙이 때문일까요, 아니면 저주 때문일까요? 당신은 대답하지 "
"못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 6d5396f8-de61-1042-5cdb-52e982ee502c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:6d5396f8-de61-1042-5cdb-52e982ee502c
msgctxt "h239e77bfg8c61g4f81ga92bgd0abc0b8a0d2"
msgid "Let the child go, so she can spread word to the others of your might."
msgstr "아이를 풀어주고, 당신의 힘을 널리 알리도록 하는 건 어떤가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 6f6c3f14-9ae4-d07e-9ad5-86b4f6188e61
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(5) = True
#.      - BERSERKER(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:6f6c3f14-9ae4-d07e-9ad5-86b4f6188e61
msgctxt "h5997a144g5df2g4b3fgada0g497db014cba9"
msgid "Call off your snake or it goes in my dinner pot tonight."
msgstr "네 뱀을 당장 치우지 않으면 내 저녁 밥솥에 들어갈 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Rath
#. NodeID = 709c463d-bcc1-0c94-3c8c-ed294b929328
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:709c463d-bcc1-0c94-3c8c-ed294b929328
msgctxt "h49ba1b77g432dg43b8g8432gce514a35b3a4"
msgid "And the parents? They're just outside..."
msgstr "아이의 부모는요? 그들이 바로 바깥에 있습니다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 70fa3588-2a8c-e52b-665c-a96390a8171b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:70fa3588-2a8c-e52b-665c-a96390a8171b
msgctxt "he5b4fd0eg6ff5g421cgbf06g1ddf0d94bdd1"
msgid ""
"Imprisoning her empowers the refugees. Are you willing to risk insurrection?"
msgstr "그녀를 가두면 피난민들을 자극할 뿐이야. 내란이 일어나도 상관 없다는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 7257668e-41e1-97ee-6b33-81017cb534bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1d54942c-e707-2b27-c461-bc033d258d04_ResistedDarkUrge = True
#.   Tag:
#.      - REALLY_DARK_URGE(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:7257668e-41e1-97ee-6b33-81017cb534bd
msgctxt "h41b93cfdg4c33g4089g9b06g39836cbd44be"
msgid ""
"*The corpse is frozen in her final moment of agony. Well, at least you "
"tried.*"
msgstr "*시신은 마지막 순간의 고통을 간직한 채 굳어 있습니다. 뭐, 적어도 시도는 해 봤으니까요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 73ea9ed5-e52d-1187-8ac4-d8ae9fec33dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:73ea9ed5-e52d-1187-8ac4-d8ae9fec33dc
msgctxt "h5fd4d210g9a94g4883g93a9g593ea108d9da"
msgid "<i>Change your mind.</i>"
msgstr "<i>생각을 바꾼다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Rath
#. NodeID = 74fd3079-1fa3-e0c5-4e70-8c9d2952d9fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:74fd3079-1fa3-e0c5-4e70-8c9d2952d9fb
msgctxt "hf4391452g27abg4a19g9ec0gd867d58a67a8"
msgid "Gone. By the gods, Kagha, what have you <i>done</i>?"
msgstr "죽었어. 신이시여, 카그하, <i>무슨 짓을 </i>한 겁니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 7898d481-af25-3696-4b7b-2a1fdb0db3cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ShadowDruid_Event_KnowsPlayerDruid(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:7898d481-af25-3696-4b7b-2a1fdb0db3cf
msgctxt "hb0fc719dg4148g4ce2gb355gd9d91102b853"
msgid "To reject the helpless is to reject Silvanus himself."
msgstr "힘없는 자를 내치는 것은 실바누스 본인을 거부하는 것과 같지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 7cc0ff8e-3bb3-7e7c-71c9-2bc2854c15a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:7cc0ff8e-3bb3-7e7c-71c9-2bc2854c15a5
msgctxt "hb3284bb2g7774g487fg80cdg31fd6f037f1e"
msgid "Unfortunate, but temporary. Detain her for only as long as necessary."
msgstr "안타깝게 됐지만, 금방 지나갈 거다. 아이를 구금하되 필요 이상으로 가두지 말도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 7e55ea81-ba60-9cf3-55f0-c8a39ef50f1a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = True
#.      - TIEFLING(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.     - DEN_ShadowDruid_Event_KnowsPlayerDruid(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:7e55ea81-ba60-9cf3-55f0-c8a39ef50f1a
msgctxt "h1f7981f4g3022g40dfg99a8g46b3133d840c"
msgid "A seed nobly sown renders the sweetest fruit. Be noble - set her free."
msgstr "숭고하게 뿌린 씨앗이 가장 달콤한 열매를 맺는 법이지. 그녀를 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 7e6f44bc-6d2a-d70f-9912-9bee51eb1f60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(5) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:7e6f44bc-6d2a-d70f-9912-9bee51eb1f60
msgctxt "haf7aa790g0ff7g446fg9135gabed70ba265e"
msgid "*The death of a child. A timeless tragedy that never grows old.*"
msgstr "*아이의 죽음이라. 이 끝없는 비극은 봐도 봐도 질리지 않죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 7fff3b63-1dea-e811-77d2-f6d618158138
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_KidFreed = True
#.   Object:
#.     - DEN_ShadowDruid_Event_Gale_FreedChildApproval(5) = True
#.     - DEN_ShadowDruid_State_FreedChild(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:7fff3b63-1dea-e811-77d2-f6d618158138
msgctxt "hc61f9502ga0ebg4ce0gadd4g8f2c71843619"
msgid "Out, thief. My grace has its limits."
msgstr "사라져라, 도둑. 내 은총에는 한계가 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 807d76a6-d832-5e15-e323-175314ca5d50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:807d76a6-d832-5e15-e323-175314ca5d50
msgctxt "h0d23d09cg4ffcg4464g87a2g2be76c830d2b"
msgid ""
"Return the girl to her family. She's made amends, and you have your relic."
msgstr "가족에게 돌려 보내라. 아이는 뉘우침을 얻었고, 그대는 유물을 되찾았으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 811e55e6-96ad-277e-dbfc-2b0c550f91b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_SnakesCourt_FailedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:811e55e6-96ad-277e-dbfc-2b0c550f91b5
msgctxt "h49c0f6d7g61dag4292g9f60g17ff3aa5bb3b"
msgid "I've heard enough. The devil remains until the rite is complete!"
msgstr "충분히 들었다. 이 데빌은 의식이 끝날 때까지 머무를 것이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 81d1cf46-835c-304e-239f-2e7c2114e7a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_KaghaRequestedPlayers = True
#.      - DEN_GuardedEntrance_State_ClearToPass = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:81d1cf46-835c-304e-239f-2e7c2114e7a2
msgctxt "h3700dbe0gbd38g4267ga255g174d48efdb78"
msgid "One of your guards outside said you wanted to see me. Here I am."
msgstr "당신 경비 중 한 명이 당신이 날 보고 싶다고 했다더군. 자, 무슨 일이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 82ec9ed3-32ff-1ff9-ca1c-5eded423f699
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1d54942c-e707-2b27-c461-bc033d258d04_MindHasBeenRead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:82ec9ed3-32ff-1ff9-ca1c-5eded423f699
msgctxt "hd420f753gb512g407fg853ag2051d433737a"
msgid "You've proven your authority. Now prove your mercy."
msgstr "당신의 권위는 충분히 증명한 것 같군. 이제 자비를 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Karlach
#. NodeID = 82fb2e0f-dafa-3717-8cb6-ff85ee30fd9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_KARLACH(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:82fb2e0f-dafa-3717-8cb6-ff85ee30fd9b
msgctxt "h3346b1a4g1293g4e0eg8878g5e236e96e10e"
msgid "That's it. You're calm, I'm calm, snake's calm."
msgstr "그렇지. 너도 침착하고, 나도 침착하고, 뱀도 침착하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 84ed2f07-fa47-952a-c974-3038d231c578
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:84ed2f07-fa47-952a-c974-3038d231c578
msgctxt "h341b90f3g18e5g436ag9137gdc47630eea2e"
msgid "<i>Now</i>, Rath."
msgstr "라스, <i>당장</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 85b6e690-cf1f-8633-742b-746faa5cadf3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_SnakesCourt_FailedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:85b6e690-cf1f-8633-742b-746faa5cadf3
msgctxt "hb0c71d8cga0e1g4327ga2d5g948cf154bf5d"
msgid ""
"I did not ask for counsel. The devil remains until the rite is complete!"
msgstr "조언을 부탁한 기억은 없는데. 이 데빌은 의식이 끝날 때까지 이곳에 머무를 것이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 8656dd1a-77c0-13bc-a196-57b2d8b5de3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLeader_Event_ToldCrime = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:8656dd1a-77c0-13bc-a196-57b2d8b5de3d
msgctxt "h928c21f2ga602g4db1g98b2g1b67acb1951e"
msgid "Thief? Poison? What's this girl's <i>actual </i>crime?"
msgstr "도둑? 독? 저 아이가 저지른 죄목이 <i>뭐지</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 87ea6c04-1804-bfcd-24b4-f8b750c0f1ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:87ea6c04-1804-bfcd-24b4-f8b750c0f1ec
msgctxt "h04094d25gcd14g4b3bg8e57g95d1e44f8d42"
msgid "I... Very well."
msgstr "전... 알겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Arabella
#. NodeID = 8878bc56-9b6d-6120-5649-624d1f20ab82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:8878bc56-9b6d-6120-5649-624d1f20ab82
msgctxt "ha8e36970g8decg41c4g8c79g3ae23463e16a"
msgid "P-please. Can't I say anything...?"
msgstr "제-제발요. 아무 말도 하면 안 되나요...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 887cbc1f-5bfa-8144-8190-8a3f8f87a3fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:887cbc1f-5bfa-8144-8190-8a3f8f87a3fd
msgctxt "hd430b443gec54g4831ga37egbe3a9e1cf1b4"
msgid "All right. Speak, child."
msgstr "좋다. 말해 보거라, 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 8888f585-006f-6f7b-3029-1ddd09b307c0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 1d54942c-e707-2b27-c461-bc033d258d04_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_6 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:8888f585-006f-6f7b-3029-1ddd09b307c0
msgctxt "hba452d4eg874dg4b7fg8322gd8bfd38aee05"
msgid "<i>Read Kagha's mind.</i>"
msgstr "<i>카그하의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 89e12728-f29f-906c-e215-5777f8723e32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:89e12728-f29f-906c-e215-5777f8723e32
msgctxt "hd27c6faegb7fbg4b07ga0a3g09111c3d6881"
msgid "This isn't justice, this is cruelty. Let the child go."
msgstr "이건 정의가 아니야, 잔인함이지. 아이를 보내줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 8f62a798-4950-453a-bc86-6f33b667fb54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:8f62a798-4950-453a-bc86-6f33b667fb54
msgctxt "h044bf17eg425eg4ac2ga0d9g7ae45c393071"
msgid "Girl? You mean <i>parasite</i>."
msgstr "아이라고? <i>기생충</i>이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Arabella
#. NodeID = 8f94622a-f3bb-d361-3c54-7f8a3044e555
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:8f94622a-f3bb-d361-3c54-7f8a3044e555
msgctxt "ha30590f7gd44bg417eg9636g7ce6eae72f70"
msgid ""
"But there's goblins out there, and worse. And it's nice here, so I - I took "
"the idol. I thought maybe then we could stay."
msgstr ""
"하지만 밖에는 고블린들이 있다구요, 더한 것도 있구요. 그리고 여기 있는 게 좋아서, 그래서... 그래서 우상을 훔쳤어요. 그렇게 하면 "
"여기 남을 수 있을 줄 알았거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 8fa92550-cabc-008d-f8cd-588a8a5b9c68
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 12
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = False
#.      - TIEFLING(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:8fa92550-cabc-008d-f8cd-588a8a5b9c68
msgctxt "h4721113eg52b6g4d45g8e9eg38a799d00681"
msgid ""
"Don't druids cherish harmony? Jailing the girl disrupts nature's balance."
msgstr "드루이드는 조화를 소중히 여기지 않나? 그녀를 가두면 자연의 균형이 방해 받을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 9411f5d1-af1c-f2fc-446c-a0cf66fa2c78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:9411f5d1-af1c-f2fc-446c-a0cf66fa2c78
msgctxt "hac0d3589g3944g4ee7g97ccg5f33eecfb44c"
msgid "This isn't my kind of justice... but I won't stand in your way."
msgstr "이건 내 방식의 정의가 아니지만... 네 일을 방해하지는 않도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = 9595c8df-358b-6cee-6970-0cd93e4ce827
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_FailedNatureCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:9595c8df-358b-6cee-6970-0cd93e4ce827
msgctxt "h51661a70gc263g4350g9f69g2b51ec217149"
msgid "*The snake hisses, its intentions unclear.*"
msgstr "*뱀이 쉬익 하는 소리를 냅니다. 의도는 알 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 9684a400-b5fc-60be-5440-e156e85371e6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:9684a400-b5fc-60be-5440-e156e85371e6
msgctxt "h4f88c4cega549g492bga5aagd528431c8abb"
msgid ""
"This <i>outsider </i>will take word once I've spoken to him. We must focus "
"on the rite."
msgstr "이 <i>외부인</i>이 내가 한 말을 이행할 것이다. 우리는 의식에 집중해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 9684a400-b5fc-60be-5440-e156e85371e6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:9684a400-b5fc-60be-5440-e156e85371e6
msgctxt "hb9cb77d9g9658g4a77g95a2g87f76bd76698"
msgid ""
"This <i>outsider </i>will take word once I've spoken to her. We must focus "
"on the rite."
msgstr "이 <i>외부인</i>이 내가 한 말을 이행할 것이다. 우리는 의식에 집중해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = 9684a400-b5fc-60be-5440-e156e85371e6
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:9684a400-b5fc-60be-5440-e156e85371e6
msgctxt "h44dd2935g52d6g49cag948egfb0f2287e190"
msgid ""
"This <i>outsider </i>will take word once I've spoken to them. We must focus "
"on the rite."
msgstr "이 <i>외부인</i>이 내가 한 말을 이행할 것이다. 우리는 의식에 집중해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 988a8142-e98e-1edf-b550-f0295b9604b0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = True
#.      - TIEFLING(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.     - DEN_ShadowDruid_Event_KnowsPlayerDruid(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:988a8142-e98e-1edf-b550-f0295b9604b0
msgctxt "hf49f7afag97aag4103g9171g2bdcc62fb4e1"
msgid "Release her. I'll see that she stays out of trouble."
msgstr "그녀를 풀어줘. 그녀가 말썽을 부리지 못하도록 내가 감시하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = 9b954052-6d86-428e-a243-64f76e7bd61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:9b954052-6d86-428e-a243-64f76e7bd61e
msgctxt "ha9bcf16bg2425g4278ga4c7g530c03f7799e"
msgid "<i>Try to understand what's happening.</i>"
msgstr "<i>무슨 일이 일어나는지 이해하려 애쓴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Wyll
#. NodeID = 9fa73005-a0c2-f272-5b55-fd4642e1b1ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.   Tag:
#.      - REALLY_WYLL(11) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:9fa73005-a0c2-f272-5b55-fd4642e1b1ab
msgctxt "hac96f61ag7ebdg4861g945ag4591463c4998"
msgid "This Kagha's barbaric. Know this: I've got your back."
msgstr "이 카그하라는 자는 아주 야만적이군. 맡겨 둬, 난 네 편이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = a4c1a474-3b92-b4ff-ef19-5ec787951067
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:a4c1a474-3b92-b4ff-ef19-5ec787951067
msgctxt "h3b90a378g71fdg4798g9477gbb9974eaa6f4"
msgid "Let the child go, so she can spread word to the others of your might."
msgstr "아이를 풀어주고, 당신의 힘을 널리 알리도록 하는 건 어떤가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = a90b4b80-2538-c581-f637-ab5870db38b6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARD(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:a90b4b80-2538-c581-f637-ab5870db38b6
msgctxt "hd3b4ca34g08f1g4cefgb317g1812409e5019"
msgid ""
"Silvanus was more concerned with 'nobly sown seeds' than punishing children, "
"was He not?"
msgstr "실바누스께서 걱정하시는 건 아이를 벌주는 것이 아니라 '숭고하게 뿌린 씨앗'이지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = a9674c0d-a510-11e3-682f-720917ede73d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:a9674c0d-a510-11e3-682f-720917ede73d
msgctxt "hf67dc4d5gebc9g4c4fgb837gc0f112329361"
msgid "<i>Do it.</i>"
msgstr "<i>어서 해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Shadowheart
#. NodeID = ab482122-6d22-b817-ebb2-c4465103d8ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:ab482122-6d22-b817-ebb2-c4465103d8ae
msgctxt "ha6c1c157g7f6bg4d03gbf27g380b6afdeb57"
msgid "Good. Play nice until we get what we need."
msgstr "좋아. 우리가 원하는 걸 얻을 때까지 얌전히 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = ac6859f5-d912-c30c-84b1-66cbf744916c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_AlmostAttackedSnakeCourt = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:ac6859f5-d912-c30c-84b1-66cbf744916c
msgctxt "hf0404a38g68d2g4ccag8ca0gc72b732c9435"
msgid "<i>Prepare to attack.</i>"
msgstr "<i>공격할 준비를 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Rath
#. NodeID = adfdfb63-2be6-09da-83e4-3a053f7cd15b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_KidDied = True
#.     - GLO_ShadowDruid_SnakesCourt_SawKidDie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:adfdfb63-2be6-09da-83e4-3a053f7cd15b
msgctxt "h252d8c47g9e59g4b87ga715gd9ceb4e9994a"
msgid "No!"
msgstr "안 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = afd2dcc0-b863-d69b-ea46-5a6853960fca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:afd2dcc0-b863-d69b-ea46-5a6853960fca
msgctxt "h432dd2f8g5518g4640gacb5g5e9ff6827852"
msgid "The girl has made her amends. Return her to her family."
msgstr "아이는 이미 속죄를 마쳤다. 그녀의 가족에게 돌려보내도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Arabella
#. NodeID = b00e5f4d-d121-e172-bb63-b2c4823bd87e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:b00e5f4d-d121-e172-bb63-b2c4823bd87e
msgctxt "h264ac287g7965g4b0cg823cg0c7a317715c7"
msgid "Please. <i>I'm sorry!</i>"
msgstr "제발. <i>잘못했어요!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = b1525bdc-612b-c151-7594-9f151cb08d60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:b1525bdc-612b-c151-7594-9f151cb08d60
msgctxt "ha9121c6egdcaeg467eg9486g3b027d3341f3"
msgid "We will speak soon enough. First, judgement must be passed."
msgstr "곧 대화를 나눌 수 있을 것이다. 먼저, 판결이 내려져야만 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = b4820c51-b209-2571-a2a3-5ffc3f0d1a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:b4820c51-b209-2571-a2a3-5ffc3f0d1a4f
msgctxt "hdad07d17g5680g4c4fgb9b6g7081594b57fd"
msgid "<i>Carry out your attack.</i>"
msgstr "<i>계속 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = b6c2c909-f8ed-ea64-0873-f8b7df3f3bb8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DRUID(5) = True
#.      - TIEFLING(5) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.     - DEN_ShadowDruid_Event_KnowsPlayerDruid(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:b6c2c909-f8ed-ea64-0873-f8b7df3f3bb8
msgctxt "hfd7bf86eg45a5g43ddg9bb5gc9c3b6724216"
msgid "The girl is no threat. Jailing her disrupts nature's balance."
msgstr "아이는 위협이 되지 못해. 그녀를 가두는 건 자연의 균형을 무너뜨릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = bd3b7c4e-546c-12e0-0714-fae7662e6b85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:bd3b7c4e-546c-12e0-0714-fae7662e6b85
msgctxt "h6918c7efgb7a2g4b0egabacge9743a9045ce"
msgid "Bury the remains. Continue the rite."
msgstr "유해를 묻어라. 의식을 계속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = c0bc72b4-9c38-57a5-df37-42255338db14
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLeader_Event_ToldCrime = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:c0bc72b4-9c38-57a5-df37-42255338db14
msgctxt "h7edc97ccg3a8dg484fg99d5g5c0f5d73ecc3"
msgid ""
"Yet behold: the parasite lives! She eats our food, drinks our water. Then "
"steals our most holy idol in thanks!"
msgstr ""
"하지만 봐라. 기생충이 아직 살아 있구나! 이 녀석은 우리 음식을 축내고, 물을 동냥하지. 그에 대한 감사 표시로 신성한 우상을 훔칠 "
"줄이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = c21f76df-8373-52a9-b5d4-ce82709f3412
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:c21f76df-8373-52a9-b5d4-ce82709f3412
msgctxt "h4f073ba5g3e2dg4909g88acga732f7d3be51"
msgid "What do you have to say for yourself, child?"
msgstr "자신을 변호할 말이 있느냐, 아이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = c9501092-d8c3-58a9-a82b-8deb2663ff22
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_SnakesCourt_FailedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:c9501092-d8c3-58a9-a82b-8deb2663ff22
msgctxt "h9079ec86g06f4g4ee0gabffgf75b828db165"
msgid "More proof that outsiders must never be trusted."
msgstr "외부인을 믿지 않아야 할 근거가 또 늘어났군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = c98a8ebf-da4c-e637-75a9-7b721d297c68
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(5) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_SnakesCourt_Event_TriedtoPersuade(5) = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:c98a8ebf-da4c-e637-75a9-7b721d297c68
msgctxt "h52421ca0g8ceag4bbdgb24age84feaea650f"
msgid "Release her. I'll see that she stays out of trouble."
msgstr "그녀를 풀어줘. 그녀가 말썽을 부리지 못하도록 내가 감시하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = c9d59161-0f2a-4763-ad07-3a5de29a644f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(5) = True
#.      - REALLY_SHADOWHEART(5) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:c9d59161-0f2a-4763-ad07-3a5de29a644f
msgctxt "hda510765g3a66g4404g96e7g41afb737f9ea"
msgid ""
"*A hot spike of pain overcomes you, and a strange image is thrust upon your "
"mind's eye. You are a frightened little girl, in a dark chamber. A hooded "
"figure approaches, brandishing a rod...*"
msgstr ""
"*뜨거운 고통이 당신을 덮치며, 낯선 심상에 내면의 눈을 찔리는 듯합니다. 당신은 어두컴컴한 방에 갇혀 벌벌 떨고 있는 소녀입니다. "
"두건을 뒤집어쓴 형체가 다가와 회초리를 휘두릅니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = cbc6450c-2275-74fb-52a8-f8278a5f13c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:cbc6450c-2275-74fb-52a8-f8278a5f13c7
msgctxt "hb8a1db78g3e28g4c4egad17g6eb8bd62a9ba"
msgid "Remand the thief. I will <i>not</i> say it again."
msgstr "도둑을 석방해라.<i> 다시</i> 말하지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Wyll
#. NodeID = d07520cf-aee1-e062-e6d3-fce4eb0dcc04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.   Tag:
#.      - REALLY_WYLL(11) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:d07520cf-aee1-e062-e6d3-fce4eb0dcc04
msgctxt "h44d4aa99gf4bdg4baeg9b17g6afdb4863bb3"
msgid "A fickle one, aren't you? I hope you know what you're doing."
msgstr "변덕스럽기는, 안 그래? 네가 무슨 짓을 벌이고 있는지 깨닫길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Shadowheart
#. NodeID = d16a28e8-c7da-4e02-b6cc-364dff93c9d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:d16a28e8-c7da-4e02-b6cc-364dff93c9d9
msgctxt "hbc6caa89g0510g4a52g8ac3g859c9c18569a"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = d3ee4158-c200-f3e5-b904-5b08cc6a3d90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(5) = True
#. SetFlags:
#.   Global:
#.     - DEN_DruidLeader_Event_ToldCrime = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:d3ee4158-c200-f3e5-b904-5b08cc6a3d90
msgctxt "h420c04b2g69f2g4dceg8ae9geaadd79dbfbc"
msgid "Explain this cruelty!"
msgstr "이 잔인한 행동을 설명해 보시지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = d4734403-e1f4-9054-ad1f-7ee5b9682994
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:d4734403-e1f4-9054-ad1f-7ee5b9682994
msgctxt "hbda401e1g7949g4aa8ga8feg6bfd6107124d"
msgid "The Treefather's words spoken with a devil's forked tongue."
msgstr "데빌의 갈라진 혓바닥에서 나무 아버지의 말씀을 듣게 되다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = d506e93c-acc2-027c-68af-972472ce3839
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLeader_Event_ToldCrime = True
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_Interfere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:d506e93c-acc2-027c-68af-972472ce3839
msgctxt "h638411ffg4186g4a91gb2aagf12697841571"
msgid "Imprison her? She's just a child."
msgstr "그녀를 가둔다고? 그녀는 아이일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = d8368b4c-576f-fde2-4afc-8495daa56b00
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_State_CourtHostile(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:d8368b4c-576f-fde2-4afc-8495daa56b00
msgctxt "h12783940g384fg4e78ga5dfgc941cc6035d9"
msgid "*It's no use - the rage clouds all.*"
msgstr "*소용이 없습니다. 격노가 머릿속을 흐리게 만듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = d858bc41-b48b-ca5e-6ef2-f1b4eed6a220
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:d858bc41-b48b-ca5e-6ef2-f1b4eed6a220
msgctxt "hec207f92g87c0g4bfbga690g0407a084c924"
msgid ""
"The blight must be cut away for healing to begin. First, the spawn. The rest "
"will follow."
msgstr "치료의 시작은 환부를 도려내는 거다. 새끼를 시작으로 나머지도 처리해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Gale
#. NodeID = dc904b9e-ef69-6886-1f53-b4a7411f4885
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_GALE(12) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:dc904b9e-ef69-6886-1f53-b4a7411f4885
msgctxt "h117375cdga5ceg46b6g9e8ag94b940f09196"
msgid ""
"Good. Let's focus on the girl first. We can settle with the snake later."
msgstr "좋아. 먼저 아이부터 어떻게든 해 보자. 저 뱀과는 나중에 담판 짓고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Astarion
#. NodeID = ddfa95d1-61b5-c944-e8f7-3fc353233c4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_ASTARION(10) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:ddfa95d1-61b5-c944-e8f7-3fc353233c4b
msgctxt "ha668b1bagd020g4600g966dg43e25406867b"
msgid "Yes! Let's have some fun."
msgstr "좋아! 재미 좀 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = de3dca5b-7b9d-2350-cf85-ce958bca987b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:de3dca5b-7b9d-2350-cf85-ce958bca987b
msgctxt "h030d329cged85g44a3g829ag5d1b9407a47f"
msgid "Halsin isn't here. Keep his name off your tongue, lest Teela pierce it."
msgstr "할신은 여기 없다. 그의 이름을 혀에 올리지 말도록, 틸라가 그 혀를 꿰뚫을지도 모르니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = de3ee47e-7dd5-2d2c-fbb9-e4139d20d5e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:de3ee47e-7dd5-2d2c-fbb9-e4139d20d5e2
msgctxt "hbe3e80beg3ffbg4034g9b42gdde00a0bb7c1"
msgid ""
"They are a blight, each and all. If I cannot choke it out, I will burn it "
"away."
msgstr "그들은 모두 해충이야, 한 마리도 빠짐없이. 내쫓을 수 없다면, 불태워서라도 치워버리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = df6ba99a-99fb-e858-8659-308b48a0a621
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:df6ba99a-99fb-e858-8659-308b48a0a621
msgctxt "had82500fg0d22g4a5fg997fg2bc7ff344219"
msgid "It is as you say. <i>Ssifisv</i> - Teela, to me."
msgstr "그대 말대로 하지. <i>쉬익</i>. 틸라, 내게로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Lae'zel
#. NodeID = dfc989b8-e857-3f8f-ff5d-582cdc40f4a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_LAEZEL(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:dfc989b8-e857-3f8f-ff5d-582cdc40f4a5
msgctxt "h3b307f78g4e04g4b01ga348g818dc47d1af3"
msgid "Wise. To <i>know</i>, we must first <i>observe</i>."
msgstr "현명하군. 사실을 <i>알기</i> 위해선, 먼저 <i>관찰을 </i>해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = e379c35e-6979-0637-f6ba-ace6049a0281
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:e379c35e-6979-0637-f6ba-ace6049a0281
msgctxt "h235075e5gea8ag463eg93dfg67bdf0efb610"
msgid ""
"<i>Halsin is gone - I am First Druid now. I will take control and prove my "
"authority.</i>"
msgstr "<i>할신은 없다. 이제 내가 최고 드루이드다. 내가 상황을 통제하고 권위를 증명하겠어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Player
#. NodeID = e511aaf5-ced4-4c08-a45a-c8c191bddb43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:e511aaf5-ced4-4c08-a45a-c8c191bddb43
msgctxt "h53d1a74ag77a5g4b1ag95d9g422e6dea12e1"
msgid "<i>Silently petition Lady Shar for guidance.</i>"
msgstr "<i>조용히 샤 여신의 인도를 청원한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Narrator
#. NodeID = e6e711b7-6260-345e-0fec-1c1006c2edd1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1d54942c-e707-2b27-c461-bc033d258d04_PassedNatureCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:e6e711b7-6260-345e-0fec-1c1006c2edd1
msgctxt "h734c66adg21dag4c5dg9733gf3b351527940"
msgid ""
"*The snake's hiss of approval reveals its intentions. Should the child "
"struggle, it is poised to strike.*"
msgstr "*뱀이 쉭쉭거리는 소리로 녀석의 의도를 알 수 있습니다. 아이가 몸부림치거든 바로 공격할 준비가 되어 있는 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Karlach
#. NodeID = ed910f35-677f-78f5-10f2-93ee38838623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_KARLACH(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:ed910f35-677f-78f5-10f2-93ee38838623
msgctxt "h4921323fge58cg406bgb0d8gc744a5e73f96"
msgid "Wait! Don't spook the gods-damn snake!"
msgstr "잠깐! 이 망할 뱀을 너무 겁주지 말라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = ee042a08-0972-fc48-abb1-2ec7c01e9f58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:ee042a08-0972-fc48-abb1-2ec7c01e9f58
msgctxt "hae02e8dfg3e5dg49acg8aa9g4fa555034bd0"
msgid "<i>She's a parasite.</i>"
msgstr "<i>그녀는 기생충이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = ee1d2765-2530-4f7a-a4c5-44f8d2c09ba4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ShadowDruid_State_KidFreed = True
#.   Object:
#.     - DEN_ShadowDruid_Event_Gale_FreedChildApproval(5) = True
#.     - DEN_ShadowDruid_State_FreedChild(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:ee1d2765-2530-4f7a-a4c5-44f8d2c09ba4
msgctxt "hab57f3e2g32d6g4884g80e2gd6b148412395"
msgid ""
"Fair words. Child, take to the others word of my grace. <i>Ssifisv</i> - "
"Teela, to me."
msgstr "일리가 있군. 아이야, 내 자비를 다른 이들에게 전하거라. <i>Ssifisv</i>. 틸라, 내게로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = eeb2c62d-af19-e293-093a-a730b4d5c81b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:eeb2c62d-af19-e293-093a-a730b4d5c81b
msgctxt "h35afd76cgad61g450cg9fdegbf4480c332ee"
msgid ""
"Yes. She is more valuable out there than in here. <i>Ssifisv</i> - Teela, to "
"me."
msgstr "그래. 여기 있는 것 보단 밖에 있는 편이 가치가 있겠지. <i>Ssifisv</i>. 틸라, 내게로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Rath
#. NodeID = f10b14d0-f534-a0ad-4a7d-d70ff72d9c4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f10b14d0-f534-a0ad-4a7d-d70ff72d9c4a
msgctxt "h909eb8e9g5364g40c7gad57g995154443fa7"
msgid "Come, Kagha. We took back the idol. Surely..."
msgstr "제발요, 카그하 님. 우상도 되찾지 않았습니까. 분명..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Rath
#. NodeID = f10c3888-c482-5b93-d4d7-fc807830e633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f10c3888-c482-5b93-d4d7-fc807830e633
msgctxt "h4ff105fcgbe29g4145gaa23gad2e47b4f5c9"
msgid "This is madness, Kagha. She's just a..."
msgstr "카그하 님, 이건 미친 짓입니다. 이 아이는 그저..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = f2058cc8-54fb-eeb8-086a-bddbe7e042ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f2058cc8-54fb-eeb8-086a-bddbe7e042ee
msgctxt "hbf09ead6gc80bg4eb9ga7acgb4506ca37346"
msgid "You intrude on the circle. You intrude on my <i>mind</i>."
msgstr "우리 회합에 간섭하더니. 내 <i>정신</i>에도 간섭하는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = f665bfbf-94f8-a9a6-12bc-8bec358eb278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f665bfbf-94f8-a9a6-12bc-8bec358eb278
msgctxt "h807f76b8ga99dg4f49gb6f3g51c8cef0fb70"
msgid "I hear the Treefather's spirit in your words."
msgstr "네 말에서 나무 아버지의 말씀이 들리는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = f7efecb8-0e31-a221-9284-e45d640f157c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f7efecb8-0e31-a221-9284-e45d640f157c
msgctxt "h24068a40ge9adg4802g90e5g3375c14d85e0"
msgid ""
"It is as I feared - the tiefling strikes on Zevlor's behalf! Call the circle "
"to arms - we will cleanse the grove of parasites, once and for all."
msgstr "내가 걱정한 대로구나. 티플링이 제블로어의 명령으로 공격하고 있어! 회합를 무장시켜라, 숲에서 기생충을 완전히 정화할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = f7efecb8-0e31-a221-9284-e45d640f157c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f7efecb8-0e31-a221-9284-e45d640f157c
msgctxt "h3d18f24cgcb20g4911g808dg9f92a5ba63a0"
msgid ""
"The outlander must strike on Zevlor's behalf! Call the circle to arms - we "
"will cleanse the grove of parasites, once and for all."
msgstr "이방인이 제블로어의 명령을 따라 공격하는 것이 분명하다! 회합을 무장시켜라. 숲에서 기생충들을 완전히 박멸할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Arabella
#. NodeID = f8040ec7-b8dd-9536-348f-ba56f7601ffc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f8040ec7-b8dd-9536-348f-ba56f7601ffc
msgctxt "h59f4f6bag45f0g415eg8b22g7d4ded3aa4c7"
msgid "No. P-please - you can't..."
msgstr "안 돼. 제-제발요... 그럴 수는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Kagha
#. NodeID = f977e930-b28f-2111-0cf4-6e7726e01a9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:f977e930-b28f-2111-0cf4-6e7726e01a9b
msgctxt "hd6e42ce5gdd7bg4f55gba83gddb5fec3f379"
msgid "<i>Ssifisv</i> - it is as you say, Teela. Come to me."
msgstr "<i>Ssifisv</i> - 동의한다. 틸라, 내게로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt
#. Speaker = Teela
#. NodeID = fc73c2c0-142d-be9c-8f13-2ed7298c8d0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_SnakesCourt:fc73c2c0-142d-be9c-8f13-2ed7298c8d0c
msgctxt "ha9f91593g6ad9g48bbg8729g93d06502c865"
msgid "Silence. I answer only to mistress."
msgstr "조용히 해라. 나는 내 주인님의 말씀만 듣는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 132554a4-a4b2-4d6f-1a1b-dee4b71f562b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_B = True
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_C = True
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_A = True
#. SetFlags:
#.   Local:
#.     - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_B = False
#.     - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_C = False
#.     - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD:132554a4-a4b2-4d6f-1a1b-dee4b71f562b
msgctxt "h59548ceaga5a3g4a3cg8033g6fc4bd1e1e7d"
msgid "Ugh, no matter. As long as I keep the damn thing safe."
msgstr "으으, 상관 없어. 이 망할 물건을 안전하게 지키기만 하면 되니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 1b43c534-f21c-8bda-7fcf-8e798c34a22c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_B = True
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_C = False
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_A = True
#. SetFlags:
#.   Local:
#.     - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD:1b43c534-f21c-8bda-7fcf-8e798c34a22c
msgctxt "h5ff76a14g303cg496bga447gbbff5a2829da"
msgid "There must be something I can learn from it."
msgstr "분명 뭔가 알아낼 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 4aee3291-4c9f-538f-edac-c077d78fac16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_B = False
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_C = False
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_A = False
#. SetFlags:
#.   Local:
#.     - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD:4aee3291-4c9f-538f-edac-c077d78fac16
msgctxt "h39606471g20fdg4a94g84aag1ea94d1834c5"
msgid "Blasted thing... how do you open it? Does it even open?"
msgstr "이런 망할... 어떻게 여는 거야? 애초에 열리긴 해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = e76dd780-d591-dc40-acdb-ff33ac89801e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_B = False
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_C = False
#.      - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_A = True
#. SetFlags:
#.   Local:
#.     - a5e963d3-f6d3-8d94-5b14-cbc2b9d1553a_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowHeartRecruitment_AD:e76dd780-d591-dc40-acdb-ff33ac89801e
msgctxt "hd823ba5dg2e01g4e12gbeacg69867920351b"
msgid "These glyphs aren't any language I recognise..."
msgstr "이 문양은 처음 보는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead
#. Speaker = Player
#. NodeID = 00f06fd7-8b2d-4103-b2e5-9b73d9738079
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Quest_ToldAboutMoonrise = True
#.      - GLO_Halsin_State_PermaDefeated = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_State_NettieMournsHalsin = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead:00f06fd7-8b2d-4103-b2e5-9b73d9738079
msgctxt "hb85d33b6g05adg4108g89a3g6c6b2ac4dec3"
msgid "Halsin's dead. I thought you'd want to know."
msgstr "할신이 죽었어. 알고 싶을 것 같아서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead
#. Speaker = Nettie
#. NodeID = 03d1c901-2036-6be6-5411-e2683f1bf396
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead:03d1c901-2036-6be6-5411-e2683f1bf396
msgctxt "h0afa6375g0c69g4d82g95ebg4a7382511fde"
msgid "Absolute... Moonrise Towers..."
msgstr "절대자... 문라이즈 타워..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead
#. Speaker = Player
#. NodeID = 0e3cadaf-2c61-78ee-ff37-3b219cf3a051
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_Dead_MentionedMoonrise(1) = False
#.   Global:
#.      - GLO_Halsin_Quest_ToldAboutMoonrise = False
#.      - GLO_Halsin_State_PermaDefeated = True
#.      - GLO_Halsin_Knows_StudiedTadpole = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_Dead_MentionedMoonrise(1) = True
#.   Global:
#.     - DEN_Apprentice_State_NettieMournsHalsin = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead:0e3cadaf-2c61-78ee-ff37-3b219cf3a051
msgctxt "h91706258gdd6cg413bg87f9gc216c2257b0b"
msgid ""
"Halsin's dead. Is there any other way to get rid of a mind flayer parasite?"
msgstr "할신이 죽었어. 마인드 플레이어 기생충을 제거할 다른 방법은 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead
#. Speaker = Nettie
#. NodeID = 10ae15dc-67a3-d4aa-bc8b-3f79e1dbd2ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_DiedInTadpoleScene = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_Apprentice_Dead:10ae15dc-67a3-d4aa-bc8b-3f79e1dbd2ae
msgctxt "h5673d0c4gdeb9g4574ga99bg4058f57c5b2f"
msgid "Wanted to protect... wanted to give... mercy..."
msgstr "보호하고 싶었어... 주고 싶었어... 자비..."

