#.     - GOB_GoblinWily_HasMet(1) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily:50254d64-ce2e-0622-fb75-5fd64c063b40
msgctxt "ha9a19c06g13a0g4e95gbefcgda503e94474a"
msgid "It's true wot they say - you lot <i>do</i> stink like hell."
msgstr "그놈들 말이 사실이군. 너네 <i>전부</i> 지옥의 악취를 풍기는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
#. Speaker = Tracker Tozad
#. NodeID = 50254d64-ce2e-0622-fb75-5fd64c063b40
