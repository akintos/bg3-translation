msgctxt "h62437836g6f80g430bg8693g17290b875a3b"
msgid ""
"Wait! A nautiloid crashed on your doorstep. People are getting infected by "
"mind flayers. I need help."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 151405cf-27e4-8225-9111-3dcb886d7816
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
