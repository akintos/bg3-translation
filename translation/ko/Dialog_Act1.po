msgctxt "h32c764fag33feg4371g990ag0f7e8acbd69e"
msgid "<i>*</i>Brawwww...*"
msgstr "*꾸우우우우...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Owlbear Cub
#. NodeID = 7d211c36-1ec8-f264-096d-240d582f0e40
