#.     - GOB_Scrying_RecognisedMindFlayer(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0069909d-a0d1-fef8-c48b-2130d7524cbb
msgctxt "hf7f96bf9ge019g48c7g8853g158cf35725ec"
msgid ""
"*This mind flayer's build is smaller, its garb plainer - a fearsome creature "
"even in death, but not the one that tormented you.*"
msgstr ""
"*이 마인드 플레이어는 체구가 더 작고, 의복이 더 평범합니다. 죽은 상태임에도 무시무시한 생명체이지만, 당신에게 고통을 안겨준 놈은 "
"아닙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 008837be-bb81-11e4-28c6-8780237c0cc1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:008837be-bb81-11e4-28c6-8780237c0cc1
msgctxt "hfd6ce1f5g8352g4379ga05ag7163c63502f9"
msgid ""
"The Absolute's got room for everyone long as you don't defy Her. And "
"nobody's that stupid."
msgstr "절대자님은 그녀를 거역하지만 않으면 모두를 수용하신다. 그리고 아무도 그 정도로 멍청하진 않지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 01b2bd85-8ddf-b228-c3f4-1fdbeed1f4a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Scrying_RecognisedMindFlayer(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:01b2bd85-8ddf-b228-c3f4-1fdbeed1f4a7
msgctxt "h9f3e4281g5cfeg41c4g974cg21445b9be790"
msgid "<i>Study the mind flayer. Could it be...?</i>"
msgstr "<i>마인드 플레이어를 관찰한다. 혹시...?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 01f09b2e-2694-d123-5e3d-0611f3562cca
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:01f09b2e-2694-d123-5e3d-0611f3562cca
msgctxt "h3af9ff16g6877g4da3g8659g1c4438ca24d5"
msgid "<i>Penetrate Ragzlin's mind and take control.</i>"
msgstr "<i>라그즐린의 정신을 꿰뚫어 그를 조종한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 0330e20e-8d4f-af9a-4e8a-6bcebe5a12e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0330e20e-8d4f-af9a-4e8a-6bcebe5a12e0
msgctxt "h4f7207f5g2207g458ag923fgb12910b9d311"
msgid "And there's no True Soul yet who turned their back on the Absolute."
msgstr "그리고 지금까지 참된 영혼 중엔 그 누구도 절대자님을 배신한 적이 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 03d883fb-d6f4-4a54-b726-91be58099298
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:03d883fb-d6f4-4a54-b726-91be58099298
msgctxt "h6bd82ef2g7d9ag4358gac59g7d6736e02456"
msgid "*Ragzlin frowns in confusion at a question he would never have asked.*"
msgstr "*그라면 절대 하지 않았을 질문에 혼란스러워하며 라그즐린이 얼굴을 찌푸립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 0520b641-a0f5-9b64-f86c-b7e53dbf8474
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0520b641-a0f5-9b64-f86c-b7e53dbf8474
msgctxt "ha12060f7g4c8dg434cgb16eg844d698fb27b"
msgid "One failure to the next. Absolute'll have my damned head."
msgstr "또 실패잖아. 절대자님이 내 머리를 가져가실 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 07a728a5-1c6e-8365-efca-239ba7e209c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:07a728a5-1c6e-8365-efca-239ba7e209c0
msgctxt "h799b7021gd434g49f4g9cbag52149fbf6cde"
msgid "Then take it. Absolute knows I'm not getting anywhere."
msgstr "그렇다면 가져가. 절대자님은 내가 아무것도 알아내지 못한 걸 아시니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 0b6b4ee3-edf4-5650-0d9e-1f8ffde3ed9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0b6b4ee3-edf4-5650-0d9e-1f8ffde3ed9f
msgctxt "h13d870acg6b86g4eb5g8f99g3ea6c959c4a7"
msgid "It seems to me you've got an audience already."
msgstr "이미 관람객이 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 0ba42fc2-2464-9b68-23af-81c1d5629abb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0ba42fc2-2464-9b68-23af-81c1d5629abb
msgctxt "he362b5c3g7b85g4336gba8cg8bb5c3f1f697"
msgid ""
"*He is suspicious, confused by the question that fell from his lips. You "
"proceed carefully...*"
msgstr "*의심하는 눈치입니다. 그의 입에서 나온 질문에 혼란스러워하고 있습니다. 당신은 조심스럽게 계속 진행합니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 0c223811-5c68-4dcc-3c5c-b8fccc66241e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinKing_Event_Surprise = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0c223811-5c68-4dcc-3c5c-b8fccc66241e
msgctxt "hcd766893g57c5g4544g9edfg198d755f65cb"
msgid "<i>Attack the hobgoblin.</i>"
msgstr "<i>홉고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 0c4989c3-d348-9b67-438c-b194a815ff8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0c4989c3-d348-9b67-438c-b194a815ff8a
msgctxt "hacae21f5g4da1g4296g8f04g37fb4cfc0929"
msgid "You're right. You're a real True Soul. I felt it."
msgstr "네 말이 맞아. 넌 진정한 참된 영혼이야. 느껴지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 0e4e6dd9-55ce-b7e5-054c-b8c402ff1499
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Scrying_AskedDeath(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Scrying_AskedDeath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:0e4e6dd9-55ce-b7e5-054c-b8c402ff1499
msgctxt "h0690d1a0g6291g410agb023g78c229f5f72c"
msgid "Who killed you?"
msgstr "누가 너를 죽였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 1099869e-70dc-c0b5-5548-0c04f917e7aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1099869e-70dc-c0b5-5548-0c04f917e7aa
msgctxt "h238a5067gb45dg4e16ga00dgfb5db34a14cb"
msgid "*Doubt clouds Ragzlin's skull. Does he feel your guidance?*"
msgstr "*라그즐린의 머릿속에 의심이 피어오릅니다. 당신이 조종하고 있다는 사실을 깨달은 걸까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 11d270b7-ef81-ad2d-efa4-3acd9cdbbc43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Scrying_AskedRob(2) = False
#.      - GOB_Scrying_AskedMission(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Scrying_AskedRob(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:11d270b7-ef81-ad2d-efa4-3acd9cdbbc43
msgctxt "hf6c7fce7g538fg4633g83c2g5b61433bd5e2"
msgid "'What did the killer want?'"
msgstr "'살해자가 뭘 원했지?'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 124f8723-90a6-f2b7-0e34-f7a9b52d7732
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Scrying_AskedAbsolute(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:124f8723-90a6-f2b7-0e34-f7a9b52d7732
msgctxt "he195db83gc1f0g4d27gb229g270798bd21e3"
msgid "It's <i>you</i>."
msgstr "<i>너</i>로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
