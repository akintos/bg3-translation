msgctxt "h594a11a0gdec1g4a1ag8d59g64efc8644701"
msgid "Like it hasn't been touched in a millenium. Incredible."
msgstr "천년 동안 손대지 않은 것처럼 보이는데. 놀라워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet
#. Speaker = Player
#. NodeID = 4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
