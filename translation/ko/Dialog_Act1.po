msgctxt "h9dabb5cag2067g4919ga7ecg05c6bd42c0db"
msgid "Look here you little shits, I said STOP."
msgstr "말이 말같이 안 들려? 내가 멈추랬잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
