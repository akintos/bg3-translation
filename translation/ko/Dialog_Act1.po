#.     - CHA_LaezelRecruitment_Event_PersuadedKillLaezel = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:a379a495-db35-3db0-e469-3122deb77b0f
msgctxt "h838e56a7gf946g4b0agb3e2gef297694d5fb"
msgid "She's right. No one's safe if that thing goes loose. Not even us."
msgstr "맞는 말이군. 저게 도망이라도 치면 모두가 위험해지겠지. 우리도 그렇고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = a379a495-db35-3db0-e469-3122deb77b0f
