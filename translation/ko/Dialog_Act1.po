#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Global:
#.     - UND_DwarvenAlchemist_Knows_LossOfMemory = True
#.   Local:
#.     - 09983dce-d7d0-c108-506f-dcadc4044b0a_Derryth_SwD_BaelenSafe = True
#.   Object:
#.     - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:cbbb4f5e-64c4-ea66-a485-e9e95993252c
msgctxt "hdec80661g9926g4471ga62egbfbf39999fa6"
msgid "Why is Baelen so confused?"
msgstr "베일렌은 왜 그렇게 허둥대는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Player
#. NodeID = e6c7c587-2e5d-b026-d2f9-5875ead3b46d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = False
