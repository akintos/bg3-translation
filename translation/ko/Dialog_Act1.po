#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 026bbd31-df3a-805b-ef72-a729a958e76c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:026bbd31-df3a-805b-ef72-a729a958e76c
msgctxt "h07caa692gc849g4300ga40ag415e5b4d52db"
msgid "A fine offer - we are back in business."
msgstr "훌륭한 제안입니다. 다시 동업 관계로 돌아가죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 05311856-65d7-a280-6a2b-5a2b546b156f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:05311856-65d7-a280-6a2b-5a2b546b156f
msgctxt "hf76d2d0cgeffeg4a31gaa6cg5bcd033cfc43"
msgid "Our bargain is at an end - unless, perhaps, you've a spicier deal?"
msgstr "우리의 동업도 이제 끝인 듯합니다. 혹 더 구미 당기는 제안이 있다면 모르지만?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 0d0fc1c4-ad38-86cc-1db1-12c8d56110be
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedThrice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:0d0fc1c4-ad38-86cc-1db1-12c8d56110be
msgctxt "h280437feg2bb8g4324ga361gd55f913762fa"
msgid "Consider me satisfied."
msgstr "만족스럽군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 0d617de3-5768-2fad-3aea-b4c519abac3b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedThrice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:0d617de3-5768-2fad-3aea-b4c519abac3b
msgctxt "h7888536ega614g4585gb123g4c567aff26c1"
msgid ""
"A lick of that mouth-watering meat of yours. A parting gift, as it were."
msgstr "당신의 그 군침 도는 고기를 핥아보고 싶습니다. 작별 선물이라고나 할까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 0dd380b6-3ed0-845a-e968-0cb66b84ec4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:0dd380b6-3ed0-845a-e968-0cb66b84ec4f
msgctxt "h3f3fda26g908bg46c9gb677g942ef0539f24"
msgid ""
"I'll increase your fee - to be paid <i>after </i>the next fight. ([5dac5eea-"
"faeb-459c-b675-46c51519b784])"
msgstr ""
"돈을 올려주겠다. 단, 다음 전투가 <i>끝난 다음에.</i> ([5dac5eea-faeb-459c-b675-46c51519b784])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 0ea0a168-e5af-2835-89e1-23682632ba04
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Knows_FailedPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:0ea0a168-e5af-2835-89e1-23682632ba04
msgctxt "h473eaee5g186eg4d4bgb0c6gefaef94ebc89"
msgid "Come now - an ogre feasts not on promises."
msgstr "이런, 오우거는 약속을 먹고 살지 않는다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 107bd19b-3de7-ffc5-89be-5aa87b68149f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:107bd19b-3de7-ffc5-89be-5aa87b68149f
msgctxt "h3a594052g9befg4f5fgad32g1c3e20fabe00"
msgid "A fine agreement, my morsel!"
msgstr "좋은 합의군요, 나의 한입거리!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 1c2f87d5-ff9a-d821-005f-708eabe5134c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:1c2f87d5-ff9a-d821-005f-708eabe5134c
msgctxt "heb12df6dg874dg4a17g99a7gdfd7f352b335"
msgid "Fine. One lick."
msgstr "좋아. 한 번만이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Wyll
#. NodeID = 203480b8-6f1c-85a9-f887-b38ee7825751
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:203480b8-6f1c-85a9-f887-b38ee7825751
msgctxt "hc30b5d37gc5e4g4caag868fg10ddd8165f37"
msgid "You didn't think this through, did you?"
msgstr "아무 생각도 없었던 거구나, 맞지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lae'zel
#. NodeID = 204dbadd-443c-f033-ca86-e1339b3d1a78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:204dbadd-443c-f033-ca86-e1339b3d1a78
msgctxt "h00e8a436gce34g4527g9a1eg168351681fa5"
msgid "It's as I feared. You've lost your senses."
msgstr "걱정한 대로야. 드디어 머리가 어떻게 됐구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 2353470f-5792-7183-631d-209d4ba28c40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedTwice = False
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:2353470f-5792-7183-631d-209d4ba28c40
msgctxt "hba3a15a8gd50ag4b24g9610gbd9f402aefaf"
msgid ""
"All right. I'll pay now, and you come when I call. ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr "알았어. 지금 돈을 줄 테니, 부르면 오도록 해. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 235a50d6-ecd8-4061-4c15-ba93703ff2b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_AggroOnPlayer = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:235a50d6-ecd8-4061-4c15-ba93703ff2b2
msgctxt "h38b620bbgaedbg4130g864bg5336076cf13b"
msgid ""
"Why you succulent schemer! Good thing I've a hankering for <i>horns.</i>"
msgstr "이런 맛좋은 사기꾼을 보았나! 마침 제가 <i>뿔</i>을 갈망했었는데 잘됐군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 235a50d6-ecd8-4061-4c15-ba93703ff2b2
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_AggroOnPlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:235a50d6-ecd8-4061-4c15-ba93703ff2b2
msgctxt "hbc08fddfg7583g4996gbe16gc0d73673e984"
msgid ""
"Why you succulent schemer! I know <i>just</i> the thing to sate my appetite."
msgstr "이런 맛좋은 사기꾼을 보았나! 마침 제 식욕을 만족시킬 <i>완벽한</i> 방법이 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 2a4a966c-d6ad-4c94-6925-926aa43752a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:2a4a966c-d6ad-4c94-6925-926aa43752a8
msgctxt "ha1a99862gf6eag4c5egb57cge277e8d7bb59"
msgid ""
"I'm afraid I've but one last battle in me. Shall we renew our contract once "
"more?"
msgstr "아쉽게도 내게 남은 싸움은 하나뿐입니다. 우리 계약을 다시 한 번 갱신할까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 31aa5f99-3c0a-883d-3416-ab1ff15895bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:31aa5f99-3c0a-883d-3416-ab1ff15895bf
msgctxt "hc63e32fdg0da8g4883g81a9g429854ff8ced"
msgid "You summon, you pay. That's the bargain."
msgstr "부르면, 돈을 내는 것. 그게 거래의 기본이지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 32d5a1cb-c09f-8336-fea7-70cedf46f882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:32d5a1cb-c09f-8336-fea7-70cedf46f882
msgctxt "h9b429c07g4589g42fbg9319gae634bf07bb0"
msgid "Well I'll be. I almost expected you to back out of our bargain."
msgstr "이거, 이거. 거의 우리 거래를 취소할 줄로만 알았는데 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 33e7eeb3-e24c-8ad7-1da0-642a9f021da9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedOnce = True
#.      - FOR_SchoolOgres_State_SummonedTwice = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:33e7eeb3-e24c-8ad7-1da0-642a9f021da9
msgctxt "h4904f570gf44eg4085gadcdg5b78145318f5"
msgid "Well that's that! I've but one last battle in me."
msgstr "그거면 됐습니다! 내게 남은 싸움은 하나 뿐입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 3643dc67-3d77-4d7a-4a55-1fe3017aafe0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:3643dc67-3d77-4d7a-4a55-1fe3017aafe0
msgctxt "hd84fd6d8g641fg4529g8ea8gdbac20fb098a"
msgid "Consider it a deal, my morsel."
msgstr "거래 성사입니다, 나의 한입거리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 3fc6f7f7-9b75-bdcc-b01d-dc2ac3dddc00
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedThrice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:3fc6f7f7-9b75-bdcc-b01d-dc2ac3dddc00
msgctxt "hd182449bg4996g40bag9766gf6d54dc4f982"
msgid "<i>Now show me the gold.</i>"
msgstr "<i>이제 금화를 보여주시죠.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 40fdbb7f-ad4f-c2bb-2bba-db476e7b45d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedOnce = True
#.      - FOR_SchoolOgres_State_AfterSummoning_10XDeal = True
#.      - FOR_SchoolOgres_State_SummonedTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:40fdbb7f-ad4f-c2bb-2bba-db476e7b45d0
msgctxt "h47a6d4dbg5e3bg4674g8232gf069b34ed0b2"
msgid "I've done my part."
msgstr "내 몫은 다 했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 48e7d932-d592-7762-704c-c4dddb2a1f4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_4 = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_AfterSummoning_10XDeal = False
#.   Object:
#.     - GEN_TransferNPCPayment_4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:48e7d932-d592-7762-704c-c4dddb2a1f4b
msgctxt "h8d5cbab7g1d61g4464g9c7ag3ae0fb4bdd62"
msgid "<i>Pay what you promised. ([5dac5eea-faeb-459c-b675-46c51519b784])</i>"
msgstr "<i>약속한 금액을 지불한다. ([5dac5eea-faeb-459c-b675-46c51519b784])</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 4a2d5fe5-092d-8320-d6d4-ea1ca8681d31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:4a2d5fe5-092d-8320-d6d4-ea1ca8681d31
msgctxt "he0342765gaee9g4fd6gb739gab190e883203"
msgid ""
"Is gold not the pilot of our world-vessel? I am a proud glutton - and not "
"just for meat."
msgstr "금이야말로 이 세계라는 배의 조타수가 아니겠습니까? 저 같은 뛰어난 탐식가는 고기만 찾는 게 아니랍니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 4a9532db-38b7-bd24-9fab-e6b5978a4481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:4a9532db-38b7-bd24-9fab-e6b5978a4481
msgctxt "h3889b336gfe6ag4e1cg9e6fgb15222a1ca87"
msgid "A feast for the ages, then!"
msgstr "세기의 만찬이 되겠군요, 그렇게 되면!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 5a4844da-3af4-9522-0ef0-39873df29bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:5a4844da-3af4-9522-0ef0-39873df29bb6
msgctxt "h54377e12g684dg4746gacb6g72db034ce48e"
msgid ""
"Oh-ho! I appreciate your zeal - but I think we've all learned a lesson here "
"about <i>risk</i>, yes?"
msgstr "오호! 열정 넘치는 제안은 좋습니다. 하지만 우리 둘 다 <i>위험 부담</i>이 뭔지 제대로 배워서 말이죠. 안 그렇습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lae'zel
#. NodeID = 5b6c5a84-4aa6-4d4b-8669-b3cdd21998ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:5b6c5a84-4aa6-4d4b-8669-b3cdd21998ef
msgctxt "hb19c34d4g6b18g4b15ga87bga1b209d768a6"
msgid "It's as I feared. You've lost your senses."
msgstr "걱정한 대로야. 드디어 머리가 어떻게 됐구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 5d717983-adb3-845b-39c4-45e2e9400aa9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_AfterSummoning_5XDeal = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:5d717983-adb3-845b-39c4-45e2e9400aa9
msgctxt "h332b235agd5fbg4467g8414g14f5fab1c3f3"
msgid "That's that, then. Let's see the gold."
msgstr "그렇다면 좋습니다. 금화를 보도록 하지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 68488795-014e-2c39-1c1f-6e3c83addf25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:68488795-014e-2c39-1c1f-6e3c83addf25
msgctxt "h83577a8bgfe28g438bgae35gd2d829a55ffa"
msgid "No. Our deal is done."
msgstr "아니. 거래는 끝이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 6ec91c20-f108-b230-2d0a-0fd23cbf36d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:6ec91c20-f108-b230-2d0a-0fd23cbf36d9
msgctxt "h118ba875g01e6g45bcga32cga751cb057587"
msgid "Let's see the gold."
msgstr "금화를 보도록 하지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 6f19ee66-1bca-8d14-9de0-dcfead0d500d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:6f19ee66-1bca-8d14-9de0-dcfead0d500d
msgctxt "h9be26336g38a6g4d8fg89d1g7c33e2b41edf"
msgid ""
"Fine. Your fee now, to fight for me when I call. ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr ""
"좋아. 이게 네 보수다. 내가 부르면 나를 위해 싸워라. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 7002798f-84ef-8f10-ed39-bd59a9ffc4a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_3 = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_AfterSummoning_5XDeal = False
#.   Object:
#.     - GEN_TransferNPCPayment_3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:7002798f-84ef-8f10-ed39-bd59a9ffc4a1
msgctxt "hed32a2d0g0dd2g4f43g8f0bg569e5161a9d8"
msgid "<i>Pay what you promised. ([01f129ea-b4dc-44b6-8154-9a948f876a82])</i>"
msgstr "<i>약속한 금액을 지불한다. ([01f129ea-b4dc-44b6-8154-9a948f876a82])</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 7443e1c3-0db0-7d6c-3ac4-b626c8d2199e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:7443e1c3-0db0-7d6c-3ac4-b626c8d2199e
msgctxt "hfd81fc28g3528g40cbga3cdgfb215b1f8153"
msgid "Now pay up."
msgstr "이제 돈을 내시지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lae'zel
#. NodeID = 76a95bd6-72b6-674f-83c5-20a3283f0c12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:76a95bd6-72b6-674f-83c5-20a3283f0c12
msgctxt "h77bb255fge72eg4254g8d70g34e9293ed7f5"
msgid "It's as I feared. You've lost your senses."
msgstr "걱정한 대로야. 드디어 머리가 어떻게 됐구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lae'zel
#. NodeID = 77b38fbb-bea4-fc2d-01e2-0dcbe7ff1838
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:77b38fbb-bea4-fc2d-01e2-0dcbe7ff1838
msgctxt "h1d62145eg7338g4428ga372g20b5a375edcd"
msgid "I have no words..."
msgstr "할 말이 없군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 79e61780-9543-5b36-d0a7-47e7f23b8899
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedThrice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:79e61780-9543-5b36-d0a7-47e7f23b8899
msgctxt "hd80235b4g7f06g4b4dga213gb43cb7643919"
msgid "A pity for us both. Until later."
msgstr "우리 둘에게 유감이군요. 나중에 뵙죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 79f7c4ea-f7c4-d6c8-2244-bb08151888e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_AfterSummoning_5XDeal = True
#.     - FOR_SchoolOgres_State_AfterSummoning_2xDeal = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:79f7c4ea-f7c4-d6c8-2244-bb08151888e9
msgctxt "hf250fa7dg5096g4da6g99fbge6ba6c433596"
msgid "You've got my mouth watering. We are agreed, morsel."
msgstr "입에 군침이 돌게 하시는군요. 거래 성사입니다, 한입거리 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 7c90aeba-c833-874c-c65c-7bde487a58c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:7c90aeba-c833-874c-c65c-7bde487a58c9
msgctxt "h93a23360g208cg47b1gb708gbafb455aad22"
msgid "No, our deal's done."
msgstr "아니, 우리 거래는 끝이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 7d47807e-80eb-3a50-fa1e-58f5a0e22992
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:7d47807e-80eb-3a50-fa1e-58f5a0e22992
msgctxt "h6e3eb4b1g3da0g4c1egbfeeg2be067038922"
msgid "You know my terms. Sound the horn when you are ready."
msgstr "제 조건을 알고 계시겠죠. 준비가 되면 나팔을 불어주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 7fb6e7eb-8e0c-afb6-dd4d-429f6ae726e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:7fb6e7eb-8e0c-afb6-dd4d-429f6ae726e1
msgctxt "hf1d78e5agf59ag4de6g849ege85ba96ac4f5"
msgid "Our deal is done. I wish you well."
msgstr "우리 거래는 끝났어. 잘 지내."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 83cdc931-cb1b-dfe9-989b-5c0f463f233c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_AggroOnPlayer = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:83cdc931-cb1b-dfe9-989b-5c0f463f233c
msgctxt "h36690cc6ged4fg4671g9900g30738420ab49"
msgid "Good thing I've a hankering for <i>horns.</i>"
msgstr "내가 그렇게 <i>뿔</i>을 갈망했었는데 잘됐군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 83cdc931-cb1b-dfe9-989b-5c0f463f233c
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_AggroOnPlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:83cdc931-cb1b-dfe9-989b-5c0f463f233c
msgctxt "hda75bb7fgae42g4ab2ga8b8g82fd1b4c77cf"
msgid "But I know <i>just</i> the thing to sate my appetite."
msgstr "하지만 내 식욕을 만족시킬 <i>완벽한</i> 방법이 있다는 것을 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 881c6248-3509-d19e-302b-d059024aaa81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_AfterSummoning_2xDeal = False
#.   Object:
#.     - GEN_TransferNPCPayment_2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:881c6248-3509-d19e-302b-d059024aaa81
msgctxt "h125c3dd0g90b0g4f01ga84cgd683bdc6662a"
msgid "<i>Pay what you promised. ([463b0f43-5410-412d-aba3-875cf81c38ca])</i>"
msgstr "<i>약속한 금액을 지불한다. ([463b0f43-5410-412d-aba3-875cf81c38ca])</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 88989e97-a2a7-395d-477f-4779755a7ee6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedOnce = True
#.      - FOR_SchoolOgres_State_SummonedTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:88989e97-a2a7-395d-477f-4779755a7ee6
msgctxt "hc3ad9094gc1abg4254ga76eg2d07707496bd"
msgid ""
"So our terms have concluded, my little morsel. But there's one last favour I "
"might ask:"
msgstr "우리 계약은 여기서 끝이군요. 나의 작은 한입거리. 마지막으로 부탁 하나만 해도 되겠습니까:"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 8afca9c5-db44-cdaa-beaf-cfda0aaece4d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:8afca9c5-db44-cdaa-beaf-cfda0aaece4d
msgctxt "h50641739gaddbg4f54g8bbeg81e116a68917"
msgid ""
"My battles aren't done. Hold out until the next, and it'll be worth your "
"while. ([5dac5eea-faeb-459c-b675-46c51519b784])"
msgstr ""
"내 싸움은 끝나지 않았어. 전투를 다음으로 미뤄둬. 그러면 그만한 가치가 있을 거야. ([5dac5eea-faeb-"
"459c-b675-46c51519b784])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 8b324e33-45b6-4dde-3af3-3bbdc740ad3e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:8b324e33-45b6-4dde-3af3-3bbdc740ad3e
msgctxt "h444dc1eage94dg4a06gaa9dg0d8be981d18e"
msgid "Shall we extend our bargain?"
msgstr "우리 거래를 연장할까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Narrator
#. NodeID = 8d9b635d-5c27-db4c-3245-a19849380437
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:8d9b635d-5c27-db4c-3245-a19849380437
msgctxt "hc2cc3117g587ag488egad87g8e7666d9654f"
msgid "*Reality dawns. You've been outsmarted by an ogre.*"
msgstr "*불현듯, 이 오우거가 당신보다 더 똑똑했다는 사실을 깨닫습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Wyll
#. NodeID = 8de433aa-4bcf-df0d-1844-c45e10631ab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:8de433aa-4bcf-df0d-1844-c45e10631ab3
msgctxt "h3a538342g3f2eg4a93g93a1g6e9e5c1baa1b"
msgid "You didn't think this through, did you?"
msgstr "아무 생각도 없었던 거구나, 맞지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 8ea9c30b-0463-7d95-6f48-6768d25a3646
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedOnce = True
#.      - FOR_SchoolOgres_State_AfterSummoning_2xDeal = True
#.      - FOR_SchoolOgres_State_SummonedTwice = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:8ea9c30b-0463-7d95-6f48-6768d25a3646
msgctxt "h0bc38043g1ff7g4c9fg9930gada7e08e35d2"
msgid "That's that, then."
msgstr "그럼 된거군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 93ce23a2-0dba-6d5c-5ac6-4bb9bd480657
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:93ce23a2-0dba-6d5c-5ac6-4bb9bd480657
msgctxt "h190f2b68g3c68g45c7g8482ge49a18dd7aa7"
msgid "<i>Attack the ogre.</i>"
msgstr "<i>오우거를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = 957d3cb9-15f1-e719-0b89-7b2a18e1682b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:957d3cb9-15f1-e719-0b89-7b2a18e1682b
msgctxt "h67ca8701g24a1g4959g8247g3fd5382cf2a8"
msgid "I'm calling your bluff. Pay up. <i>Now.</i>"
msgstr "허풍은 그만 떠시지요. 돈 내놔. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Wyll
#. NodeID = 9889878b-02a7-d908-0b66-052ab3a93d83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:9889878b-02a7-d908-0b66-052ab3a93d83
msgctxt "h356e7659g92beg48f8g9abegd8912c9984c0"
msgid "Really? I mean - really?"
msgstr "정말? 내 말은, 정말?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 9d702771-b2d4-ceba-dc07-37515bd97250
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:9d702771-b2d4-ceba-dc07-37515bd97250
msgctxt "h4449a385g1602g4663ga7efg37c487c3ac75"
msgid "<i>Attack the ogre.</i>"
msgstr "<i>오우거를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 9ea513a0-af73-c36c-61b5-b1e416d63761
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:9ea513a0-af73-c36c-61b5-b1e416d63761
msgctxt "hd18f5563g2317g4081ga78cg4cb7588cfe31"
msgid "Not even a lick."
msgstr "핥는 것도 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = 9eec3466-e76c-9efc-c1f4-28bbeb74fc63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedTwice = True
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:9eec3466-e76c-9efc-c1f4-28bbeb74fc63
msgctxt "hc9c4bd6bg4763g475cgb32eg1a63b1f41dff"
msgid ""
"All right. I'll pay now, and you come when I call. ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr "알았어. 지금 돈을 줄 테니, 부르면 오도록 해. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = a2d72417-5701-ea38-2067-3cd3fd689a84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:a2d72417-5701-ea38-2067-3cd3fd689a84
msgctxt "h6e691122gef7fg4828g98d5g5996ae66f596"
msgid "Well I'll be. I almost expected you to back out of our bargain."
msgstr "이거, 이거. 거의 우리 거래를 취소할 줄로만 알았는데 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = a4b1c007-00b2-f1ce-5771-f394d473f3c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:a4b1c007-00b2-f1ce-5771-f394d473f3c6
msgctxt "hc047ff6agf4aeg44b5gaffeg5087144105cc"
msgid ""
"Agreed. I'll have need of you again. ([6057ad05-9492-4630-9f0a-"
"be548b134c54])."
msgstr "동의해. 네가 다시 필요하게 될 테니까. ([6057ad05-9492-4630-9f0a-be548b134c54])."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = a5989cbc-4a1e-2a4b-7a8d-a56d34da7b18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:a5989cbc-4a1e-2a4b-7a8d-a56d34da7b18
msgctxt "hc3f20764g3f69g47caga0dcg62bb82840308"
msgid "It was an absolute <i>pleasure</i> doing business."
msgstr "정말 완벽하게 <i>즐거운</i> 거래였습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = a7a0201e-e817-d0e0-18ee-5cd28b4e94ad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:a7a0201e-e817-d0e0-18ee-5cd28b4e94ad
msgctxt "ha181ea9eg20fdg4144gad2dgff8c05afed29"
msgid ""
"Have patience. The spoils of the next battle will be far greater. ([01f129ea-"
"b4dc-44b6-8154-9a948f876a82])"
msgstr ""
"기다려봐. 다음 전투에서의 전리품은 훨씬 더 많을 거야. ([01f129ea-b4dc-44b6-8154-9a948f876a82])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = b44589e1-1a41-6c49-bba7-eb1fbcabec07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:b44589e1-1a41-6c49-bba7-eb1fbcabec07
msgctxt "h9058386bg395dg40f2gb269g8f3de50cd1d0"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = b4bcbc02-d9ef-caf5-99ff-4abbaa146d16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:b4bcbc02-d9ef-caf5-99ff-4abbaa146d16
msgctxt "h7d73aca6g72b5g4025g9c34g1e70f9660642"
msgid ""
"Lets. Take this and be ready when I call again. ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr ""
"그러자. 이거 가져가고 내가 다시 부를 걸 대비하고 있어. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Narrator
#. NodeID = b5244057-4ec9-2600-29b2-bbf1a607d26b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:b5244057-4ec9-2600-29b2-bbf1a607d26b
msgctxt "h038688cegb287g4fe9g900bg254ee73362ee"
msgid "*Reality hits. You've been outsmarted by an ogre.*"
msgstr "*현실을 깨달았습니다. 당신은 오우거에게 농락당한 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = b6c603de-d113-3aa4-5bbc-39478af4c06b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:b6c603de-d113-3aa4-5bbc-39478af4c06b
msgctxt "h4bd22b54g2789g44d1gbc18g5afee3d4fcbd"
msgid ""
"Agreed. You'll be paid for another battle - <i>after</i> it's done. "
"([5dac5eea-faeb-459c-b675-46c51519b784])"
msgstr ""
"동의하지. 너희는 다음 전투에서 보상을 받을 거야 - 전투가 끝난 <i>후에</i>. ([5dac5eea-faeb-"
"459c-b675-46c51519b784])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = b814e2f3-d23b-ab98-0d5c-df895f3a8987
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_AfterSummoning_2xDeal = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:b814e2f3-d23b-ab98-0d5c-df895f3a8987
msgctxt "h19a63ce5gab69g4ae1g9f69g6bc654c2dbc6"
msgid "A fine offer - we are back in business."
msgstr "훌륭한 제안입니다. 다시 동업 관계로 돌아가죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Wyll
#. NodeID = baa91ce5-b9e7-6173-29d3-f5f8fd4ed7bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:baa91ce5-b9e7-6173-29d3-f5f8fd4ed7bd
msgctxt "hb453cec7g0e64g4b9eg9280ga48c5723f957"
msgid "Really? I mean - really?"
msgstr "정말? 내 말은, 정말?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = baaf82ce-b523-6a70-f3f5-c6963093d4ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedOnce = False
#.      - FOR_SchoolOgres_State_SummonedTwice = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:baaf82ce-b523-6a70-f3f5-c6963093d4ee
msgctxt "h2dc63221g80cag4411g94f8g26bcdb82aa73"
msgid "The deal is done."
msgstr "거래는 완료되었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = bd7cc95d-ddc2-8a1a-816a-ad88c735edc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:bd7cc95d-ddc2-8a1a-816a-ad88c735edc7
msgctxt "hdfea1e86ge8e1g45abgbd12g81887eb73635"
msgid "Call when you're ready, my morsel - and not a <i>moment</i> before."
msgstr "준비되면 다시 부르세요, 나의 한입거리. 한 <i>순간도</i> 먼저 부르지 마시고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Narrator
#. NodeID = bf50bc95-2412-1cee-60cf-39b4b8810500
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:bf50bc95-2412-1cee-60cf-39b4b8810500
msgctxt "h9f6b83a2g1560g458dg8f2dg8ae32ddb3444"
msgid "*Reality dawns. You've been outsmarted by an ogre.*"
msgstr "*불현듯, 이 오우거가 당신보다 더 똑똑했다는 사실을 깨닫습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = c07d0356-30ab-39e9-65fc-d5f96d57f52a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:c07d0356-30ab-39e9-65fc-d5f96d57f52a
msgctxt "he4fc8dffg7344g4183g9828gea1dc521f35c"
msgid ""
"Yet I'm afraid I've but one last battle in me. Shall we renew our contract "
"once more?"
msgstr "하지만 안타깝게도 내게 남은 싸움은 하나 뿐입니다. 우리의 계약을 다시 한 번 갱신할까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = c346a87e-e06e-243f-5833-d3c290bbc9cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:c346a87e-e06e-243f-5833-d3c290bbc9cd
msgctxt "h203a8ac9gcc93g4027gb498ga4bd0fe1488a"
msgid "Without so much as a lick of that mouth-watering meat of yours?"
msgstr "가기 전에 그 군침 도는 당신의 살을 한 번 핥아만 봐도 되겠습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = c7491f55-1b12-7cba-5674-d0235bffb41c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:c7491f55-1b12-7cba-5674-d0235bffb41c
msgctxt "h1065e8e5g494ag494eg8a72g0c0af982e6fc"
msgid ""
"If you'll help me in another battle, I'll pay ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr "다음 전투에서도 도와주면, 보수를 지불해줄게 ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = c80325a2-800e-ffe6-d0e1-2746809a18ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:c80325a2-800e-ffe6-d0e1-2746809a18ee
msgctxt "h1ffd4631g41a2g4be1g92ddg7298eb804161"
msgid "Shall we extend our contract?"
msgstr "우리 계약을 연장하지 않겠습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lae'zel
#. NodeID = cd272e04-cd44-5926-b2d3-8624f15bdf89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:cd272e04-cd44-5926-b2d3-8624f15bdf89
msgctxt "hfa47a357gc5cfg4bf9g86cfg4cb271da3b03"
msgid "I have no words..."
msgstr "할 말이 없군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = d106f27d-beca-c7d1-006f-411daf6d2106
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:d106f27d-beca-c7d1-006f-411daf6d2106
msgctxt "h02f01b1eg6aa3g4471g91b3g79e01fef3701"
msgid "I don't have your money."
msgstr "네게 줄 돈이 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = d318a289-5f1a-5c1d-0843-025ee002ff9d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_AggroOnPlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:d318a289-5f1a-5c1d-0843-025ee002ff9d
msgctxt "h3e5ada03ga3e8g44f5g8ebfgb43ab7cfba5b"
msgid "<i>Delicious!</i>"
msgstr "<i>맛있겠다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = d72cb17d-2893-833b-e517-9dac39ea02e0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:d72cb17d-2893-833b-e517-9dac39ea02e0
msgctxt "h348790c0gd821g40e9ga24eg6e57337170cc"
msgid ""
"I'll pay generously - after the next fight. ([463b0f43-5410-412d-"
"aba3-875cf81c38ca])"
msgstr "보수를 후하게 지불해줄게 - 다음 전투 후에. ([463b0f43-5410-412d-aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = d77cf9d4-ca77-a67a-6e77-6a773afbefb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:d77cf9d4-ca77-a67a-6e77-6a773afbefb8
msgctxt "hfc4b59cag32e7g46e1ga006g15b19c585722"
msgid ""
"How about a lick of that mouth-watering meat of yours. A parting gift, as it "
"were."
msgstr "그 군침 도는 당신이라는 고기를 한 번만 핥아 보는 건 어떨까요. 말하자면, 이별 선물이라고나 할까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = da9d994f-5ca1-6215-ce22-ad67e7d9fb5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:da9d994f-5ca1-6215-ce22-ad67e7d9fb5d
msgctxt "h0cdaef58g5aeag4198gaf06g0717db51a258"
msgid "Instead, I propose a renewal. What say you?"
msgstr "대신에 갱신을 제안하죠. 어떻게 생각하시나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = de95e861-2c39-22a3-5512-e0d8ecdc9a62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_OfferedLatePayment = True
#.      - FOR_SchoolOgres_State_SummonedOnce = False
#.      - FOR_SchoolOgres_State_SummonedTwice = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:de95e861-2c39-22a3-5512-e0d8ecdc9a62
msgctxt "hc6f7da9dgab75g4512g9ac8g3b9513776d03"
msgid "The deal is done."
msgstr "거래는 완료되었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = e65d437a-f42c-1cf7-b684-276030d480bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4c2cfa9f-ce57-1292-07ab-dd0c016f8421_FOR_SchoolOgres_State_AskedWhyGold = False
#. SetFlags:
#.   Local:
#.     - 4c2cfa9f-ce57-1292-07ab-dd0c016f8421_FOR_SchoolOgres_State_AskedWhyGold = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:e65d437a-f42c-1cf7-b684-276030d480bd
msgctxt "ha676fdf9g4e7fg40bdg9015g21492ee62a88"
msgid "What use does an ogre have for gold?"
msgstr "오우거는 금을 무슨 용도로 쓰지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = e8e62629-6a13-f699-b349-081575deb13a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_SummonedThrice = False
#.      - FOR_SchoolOgres_State_SummonedOnce = False
#.      - FOR_SchoolOgres_State_SummonedTwice = False
#.      - FOR_SchoolOgres_State_OfferedMeat = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:e8e62629-6a13-f699-b349-081575deb13a
msgctxt "hb756a205g8c98g42b4gb986g2b91e6beca1f"
msgid "No more than a few pecks? I'm afraid this spread is most inadequate."
msgstr "먹을게 이것 밖에 없나요? 안타깝게도 이 정도 양의 음식은 부적절하군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = ebead2c0-0df7-51ab-9542-27ad503c7398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:ebead2c0-0df7-51ab-9542-27ad503c7398
msgctxt "h8305313eg3c15g45b2ga526g07b21edaa057"
msgid "Too good to be true, my morsel. Now pay up."
msgstr "너무 좋아서 믿을 수가 없군, 나의 한입거리. 이제 돈을 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = f05f1eab-d948-f035-bb4e-b2cc6406db01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_AfterSummoning_5XDeal = False
#.     - FOR_SchoolOgres_State_AfterSummoning_2xDeal = False
#.     - FOR_SchoolOgres_State_AfterSummoning_10XDeal = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:f05f1eab-d948-f035-bb4e-b2cc6406db01
msgctxt "h9dc60a1agaf65g4478g9f76g00018e286f5b"
msgid "Indeed? A risky bargain - but one I must accept."
msgstr "정말인가요? 위험하긴 하지만, 받아들일 수밖에 없는 제안이로군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = f8e92f8c-2460-587a-7921-49fe666e4c7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:f8e92f8c-2460-587a-7921-49fe666e4c7c
msgctxt "h2a378d50g306bg42a6gb07bgf12b1b6d62c0"
msgid ""
"Oh-ho! I appreciate your zeal - but I think we've all learned a lesson here "
"about <i>risk</i>, yes?"
msgstr "오호! 열정 넘치는 제안은 좋습니다. 하지만 우리 둘 다 <i>위험 부담</i>이 뭔지 제대로 배워서 말이죠. 안 그렇습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Wyll
#. NodeID = f9902206-615f-d175-5086-f0d8c053b3e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:f9902206-615f-d175-5086-f0d8c053b3e4
msgctxt "hab511ea0g1097g4923gbfeeg9789fa9f0ccc"
msgid "You didn't think this through, did you?"
msgstr "아무 생각도 없었던 거구나, 맞지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Player
#. NodeID = fa567c38-9319-c80e-14cc-d7050221089b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_KilledNoone = True
#.   Local:
#.      - 4c2cfa9f-ce57-1292-07ab-dd0c016f8421_FOR_SchoolOgres_State_CommentedOnNotFighting = False
#. SetFlags:
#.   Local:
#.     - 4c2cfa9f-ce57-1292-07ab-dd0c016f8421_FOR_SchoolOgres_State_CommentedOnNotFighting = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:fa567c38-9319-c80e-14cc-d7050221089b
msgctxt "h85811d22gf475g4ea8g9490gb5f74a1d8e94"
msgid "You didn't even kill anyone!"
msgstr "아직 아무도 죽이지 않았잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon
#. Speaker = Lump the Enlightened
#. NodeID = fae2cf29-ebb3-b49a-44cd-98905598cb18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_KilledNoone = True
#.      - FOR_SchoolOgres_State_SummonedThrice = False
#.      - FOR_SchoolOgres_State_SummonedOnce = False
#.      - FOR_SchoolOgres_State_SummonedTwice = False
#.      - FOR_SchoolOgres_State_OfferedMeat = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AfterSummon:fae2cf29-ebb3-b49a-44cd-98905598cb18
msgctxt "hd07dbb82g3f5dg48f9gad48g6a6065aacbc8"
msgid "Why you succulent schemer! You promised meat, but offer nary a scrap!"
msgstr "왜 이렇게 맛있어 보이는 사기꾼인가요! 고기를 준다고 해놓고선, 쓰레기밖에 주지 않다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "h4070046bga0c6g4e3agacd5g0b2e7edbfdbc"
msgid "Useless. The ogres are dead."
msgstr "무용지물이야. 오우거는 이미 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "hd477a50ag247cg4ffbg80dfg806caae7bfa4"
msgid "A waste of time."
msgstr "시간낭비야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "h2151593dg1ffbg484egac07g3825089ec206"
msgid "What was I thinking? I can't summon a dead ogre!"
msgstr "내가 대체 뭔 생각을 한 거지? 죽은 오우거를 불러올 수는 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[1].TagText[1]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "h02f1ac1ag1487g41a0g8cfdgf55af2c1b801"
msgid ""
"It's like I always sometimes say - you can't summon dead ogres no matter how "
"hard you blow."
msgstr "몇 번이나 얘기했지만, 아무리 뿔나팔을 세게 불어도 죽은 오우거들이 오진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "had36e4c4g676dg40b0g9dacg182065bed331"
msgid ""
"Can't summon any ogres now. Not unless this horn has necromantic "
"properties..."
msgstr "이 뿔나팔이 사령술이라도 부리지 않는 이상, 오우거를 불러올 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[2].TagText[1]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "h97834412g948ag4f97gb96fg9a920b37ff8f"
msgid "Doesn't matter how loud the horn's blown - dead ogres can't hear it."
msgstr "얼마나 뿔나팔을 세게 불던, 죽은 오우거가 이걸 들을 수는 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#, fuzzy
msgctxt "h8a045fbbgeafeg4f3cga43bg2afd10f92e34"
msgid "Oh well. Worth a toot."
msgstr "그래, 정말 쥐꼬리만큼 쓸모 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[3].TagText[1]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#, fuzzy
msgctxt "h1741c418g7388g4f2eg8a9egbdd8befda075"
msgid "They won't be summoned from beyond the grave. Lazy."
msgstr "바보같군, 오우거들이 무덤에서 부터 소환되지는 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "h50df0570g7b18g4d37g95d6g490d9b75b792"
msgid ""
"The ogres are dead. It's a mercy I didn't summon their shambling corpses."
msgstr "오우거는 죽었어. 그 엉망진창인 시체들을 다시 보지 않게 돼서 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
msgctxt "h0afe3062gbb53g4792ga9c8ga46197ea0e51"
msgid "Why bother? The dead can't hear my summons."
msgstr "죽은 자들을 소환할 수는 없으니 더는 괴롭히지 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = 4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#. HandlePath = TaggedText[5].TagText[1]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Dead = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Dead = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:4c81d4b1-ed4e-85d6-909f-4c7250cb710b
#, fuzzy
msgctxt "h04875c21gb228g4158g8b79g8f8a5bb19b31"
msgid ""
"All this horn is good for now, is to sound a last farewell for those ogres."
msgstr "이제 이 뿔나팔 소리는 오우거들에게 하는 마지막 인사밖에 안 될 거야."

