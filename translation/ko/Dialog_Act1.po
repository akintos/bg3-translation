#.     - UND_FurnaceSearch_State_InteractedWithDisguisedJournal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:e5e0f07e-907d-7270-9e35-453cf0c2c9e6
msgctxt "h5c0a255cgc7c3g456dg8176g23e67d6ae194"
msgid ""
"*The cover proudly announces this book to be: <i>'Flumph Mating "
"Rituals'.*</i>"
msgstr "*표지는 당당히 이 책의 내용이 다음과 같음을 밝히고 있습니다: <i>'플럼프 교미 의식'.*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = ef8c21b9-a634-7a72-aa06-b5eefee615d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:ef8c21b9-a634-7a72-aa06-b5eefee615d3
msgctxt "h1037f451g2e29g47d6g8933ge9f704334637"
msgid "*If the drow's corpse is to be believed, it's something else entirely.*"
msgstr "*만약 죽은 드로우가 한 말이 사실이라면, 이 책의 내용물은 전혀 다른 내용일 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = fc6a8a29-8e50-2d3a-b527-2e64dcd740a2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
