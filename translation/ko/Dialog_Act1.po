msgctxt "hbf2c8fc2g3c49g4b2dgaf0cgcd1e41692137"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
