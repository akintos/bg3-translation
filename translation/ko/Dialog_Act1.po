msgctxt "h8ada565dg7c5bg4500gbed0gbc91bb31afd0"
msgid "An expert kill - and a painful one."
msgstr "전문가의 솜씨군, 아주 고통스럽게 죽였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmush_PAD_FoundBrothersAfterLongRest
