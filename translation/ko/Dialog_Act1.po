msgctxt "hdbf6bb7dgeb53g4433g9199g9e91f53766dc"
msgid "HEH!"
msgstr "헤!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2_AD_Mocking
#. Speaker = Worg
#. NodeID = d448eb14-e2e0-05d7-af4a-b0c9a3cb7f64
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2_AD_Mocking:d448eb14-e2e0-05d7-af4a-b0c9a3cb7f64
msgctxt "hb6fef557g2210g4ee1g8a10g091575fcac30"
msgid "Spin. Spin good."
msgstr "돌아라. 돌아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = 06c707ce-360e-d54a-50e8-6d830342b043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:06c707ce-360e-d54a-50e8-6d830342b043
msgctxt "h6503eed4g903fg4f41g8cbeg968539aee383"
msgid "Got a set on you, all right. Almost makes me like you."
msgstr "당돌하군, 좋아. 네가 마음에 들지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = 13cfdb90-60db-62f9-7f24-b7c5debbe954
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_Event_StopSpotting = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:13cfdb90-60db-62f9-7f24-b7c5debbe954
msgctxt "h5020adeag3518g4586g8d3fgfaa30956b46a"
msgid ""
"Looks like we got ourselves another brave one. Lads! You know what to do."
msgstr "우리 또 용감한 녀석을 하나 잡았군. 얘들아! 뭘 해야 할지 알겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Player
#. NodeID = 1521362a-3d62-7d98-c142-3b296ba5ce75
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:1521362a-3d62-7d98-c142-3b296ba5ce75
msgctxt "he9438dbdg8e75g4205g859fgf77c8ccd4677"
msgid "Out of my way, or I'll cut you down first."
msgstr "물러서지 않으면, 베어버리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = 1c214a6e-e85b-8afd-8c2f-2c6027fb8f75
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_Event_StopSpotting = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
