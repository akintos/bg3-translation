msgctxt "h42e35871g469dg46e0g9845gb27d5cf13d58"
msgid "Go back to whatever hole you slithered out of."
msgstr "네가 기어 나온 구멍으로 돌아가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
