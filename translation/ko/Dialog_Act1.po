msgctxt "h73bb2e65g17dcg4483g8bfcgc83811aca3de"
msgid "What do you know about this 'weapon'?"
msgstr "그 '무기'라는 것에 대해 뭘 알고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Player
#. NodeID = b16d768f-4fed-9767-7b42-b21d38a59547
