msgstr "움직여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingHardy
#. Speaker = Brawler Gurd
#. NodeID = 13e1bdb9-a0e7-f157-10e9-c2630bab381b
#. HandlePath = TaggedText[0].TagText[0]
