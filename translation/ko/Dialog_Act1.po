msgctxt "hd94f3b9cg52e4g49b1g879ag6746bb78d3d6"
msgid "Why did my kin attack your ship?"
msgstr "왜 내 동족이 네 함선을 공격했지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
