msgctxt "h85bd937egb455g47begb3a2gabc82659449c"
msgid "I will split your corpse and roast the pieces!"
msgstr "네 시체를 반으로 쪼개어 통으로 구워주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Squad_Sniper
