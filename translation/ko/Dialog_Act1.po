#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Lance_State_WasActive = True
#.   Local:
#.      - 56163215-6b43-f84b-e4de-f19de11ce0e2_A = True
#. SetFlags:
#.   Local:
#.     - 56163215-6b43-f84b-e4de-f19de11ce0e2_B = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_MageHandKid02PlayingShove:edc21f68-502e-dfb2-e727-1043ac3456a8
msgctxt "hf3ed95b5gdde8g43d8g9d35g2d4c6eca90cf"
msgid "I don't like it, Zel'i. It doesn't feel right..."
msgstr "마음에 안 들어, 젤리. 느낌이 이상해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_MageHandKid02PlayingShove
#. Speaker = Ra'jak
#. NodeID = f2aea5b9-a9e1-4f73-bfb2-20e0e5acda38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 56163215-6b43-f84b-e4de-f19de11ce0e2_A = True
#.   Object:
#.     - CRE_General_Event_MageHandKid_UseShove(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_MageHandKid02PlayingShove:f2aea5b9-a9e1-4f73-bfb2-20e0e5acda38
msgctxt "h69fc1075gd9b7g4d03gb610ge957be809cb7"
msgid "Aim, breathe, and..."
msgstr "조준, 심호흡, 그리고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_MageHandKidLaughingAtPlayer
#. Speaker = Zel'i
#. NodeID = 076300ca-d6f0-a72d-9248-fa1243bd915e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_General_Event_MageHandBoxSpellCast = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_MageHandKidLaughingAtPlayer:076300ca-d6f0-a72d-9248-fa1243bd915e
msgctxt "hd528ddabgd0e4g44d0ga71ag93da9587104b"
msgid "Ahahahaha! Your <i>face</i>, <i>k'chakhi</i>!"
msgstr "아하하하하! <i>니 얼굴</i>, <i>크차키</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_MageHandKidLaughingAtPlayer
#. Speaker = Zel'i
#. NodeID = 2e074044-540c-cda4-0f46-19001bb20a2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_General_Event_MageHandBoxSpellCast = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_MageHandKidLaughingAtPlayer:2e074044-540c-cda4-0f46-19001bb20a2d
msgctxt "h3f0b46c7g6526g41f8gab9bg76d502cea7dc"
msgid "Look what you <i>did</i>, <i>k'chakhi</i>! <i>Look!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_PortraitKidReaction
#. Speaker = Youth Vis'kiir
#. NodeID = 07ad8f9b-da12-4c67-a374-cc870289f5b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_General_state_VlaakithPortrait_VandalismNoticed = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_PortraitKidReaction:07ad8f9b-da12-4c67-a374-cc870289f5b2
msgctxt "h38c74c8fg507ag4fb2ga156ge0d6a97c7744"
msgid "Oh, <i>tsk'va</i>, what did you do? What did you <i>do</i>?!"
msgstr "헉, <i>츠크바</i>, 무슨 짓을 한 거야? 무슨 짓을 <i>한 거야</i>?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_PortraitKidReaction
#. Speaker = Youth Vis'kiir
#. NodeID = ac085117-482d-42c9-951c-5e7e2d161e5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_PortraitKidReaction:ac085117-482d-42c9-951c-5e7e2d161e5b
msgctxt "h096eee3ag4119g4da5ga4e0g285e8a5fa9fc"
msgid ""
"What is <i>this</i>? <i>Tsk'va!</i> I need to get rid of it before the "
"Inquisitor sees!"
msgstr "<i>이게</i> 뭐야? <i>츠크바!</i> 심문관이 보기 전에 이걸 치워야겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_VlaakithPortraitVandalized
#. Speaker = Narrator
#. NodeID = 2576b018-2491-4d84-a13b-c87a23f57877
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_VlaakithPortraitVandalized:2576b018-2491-4d84-a13b-c87a23f57877
msgctxt "h7e4a5a2fgae7fg4a3eg9302g715d32b172a9"
msgid ""
"*This imperious portrait of the githyanki warrior queen seems somewhat less "
"so when adorned with your embellishments.*"
msgstr "*당신이 색다르게 꾸미고 나니 이 위압적인 기스양키 전사 왕의 초상화는 더는 위압적으로 보이지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 06ca20b2-d394-1d22-ed0b-97f3bd55bac8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeChrai = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:06ca20b2-d394-1d22-ed0b-97f3bd55bac8
msgctxt "h7b23b6ddg4b99g4b99gb73cgc73140815375"
msgid "It's like being watched over by Queen Vlaakith herself."
msgstr "블라키스 여왕님이 직접 살피시는 셈이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 080ca2bd-58b9-5e63-c907-06b990eaef3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CorridorTeens(2) = True
#.   Local:
#.      - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeChrai = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:080ca2bd-58b9-5e63-c907-06b990eaef3b
msgctxt "h34d53f42g322fg4f4dga6c1g47addd5c214f"
msgid ""
"If you have news to discuss with the <i>ch'r'ai</i>, head down the corridor "
"to the eastern wing."
msgstr "<i>츠라이</i>와 의논할 사안이 있다면, 복도를 따라 동쪽 건물로 가세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 0c2aac81-fa46-fd01-c035-7111ca4f1581
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CorridorTeens(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:0c2aac81-fa46-fd01-c035-7111ca4f1581
msgctxt "hd3598afegb638g4f2egbb7dg0ef32b71ad86"
msgid "What if they don't find the weapon? Do we even know it -"
msgstr "만약 무기를 찾지 못하면? 우리가 무기에 대해 아는 게..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 0de29b2b-c6f1-7a6a-650f-4938a4f14dc1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeChrai = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:0de29b2b-c6f1-7a6a-650f-4938a4f14dc1
msgctxt "h2b04ae72g91a8g4957g96c1gc74f27a2ea10"
msgid ""
"When they find the weapon, they'll go. And things here can be <i>normal</i> "
"again."
msgstr "무기를 찾으면 떠날 테지요. 그러면 이곳은 다시 <i>원래대로</i> 돌아올 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = 0e1425f2-0131-1e00-8b08-6cd60626c3cf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:0e1425f2-0131-1e00-8b08-6cd60626c3cf
msgctxt "hecc0f502gf809g4a5bgacf8g6c567a2d9ea3"
msgid ""
"Tell me the Inquisition's purpose, or I'll make mince-pulp of you younglings."
msgstr "심문의 목적을 말해라. 아니면 너희 애새끼들을 간 고기로 만들어 주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = 1088f95e-3a37-9bc7-8bf6-954e1c3d52f8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:1088f95e-3a37-9bc7-8bf6-954e1c3d52f8
msgctxt "h32ea73c2g3906g45fdgb46ag0c83e686dbca"
msgid "Why are the Inquisition here? Tell me, or I'll beat it out of you."
msgstr "왜 심문관들이 여기 있지? 말해라, 쥐어패기 전에 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 1ca66ba6-8fde-464e-ae66-261ef832cffc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:1ca66ba6-8fde-464e-ae66-261ef832cffc
msgctxt "h2a596b87g49f8g426eg8253gf6c2bc824600"
msgid ""
"Our queen's eyes and ears. They're her will, incarnate. And right now, "
"they're <i>here</i>."
msgstr "우리 여왕님의 눈이자 귀요. 여왕님의 의지이자, 현신. 그리고 바로 지금, <i>여기</i>에 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 20347030-858b-e6aa-92b5-6e737526391e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:20347030-858b-e6aa-92b5-6e737526391e
msgctxt "h7349691dg8e7bg4e7dg873ag851d2c9d6fc4"
msgid ""
"If you want to know more, speak to the <i>kith'rak</i>. But don't tell her "
"we sent you."
msgstr "좀 더 자세히 알고 싶으시면, <i>키스락</i> 님과 대화해 보세요. 저희가 그랬다고 하진 마시고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = 2255c05f-4ba5-1f7f-68a1-0dfbc33eefa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e904524c-9f20-5a29-4b26-1126d7a6e35c_ConvincedInquisition = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:2255c05f-4ba5-1f7f-68a1-0dfbc33eefa3
msgctxt "hd14df159g014eg4b0cg9945g477005b51369"
msgid "No, definitely don't keep your mouth shut - what else do you know?"
msgstr "아니, 계속해서 말해... 알고 있는 다른 건?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 3683b4be-7c71-a963-97c5-c095368266fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:3683b4be-7c71-a963-97c5-c095368266fc
msgctxt "h9dfad190g4000g433fg8d10g5e5fddcd85d3"
msgid ""
"The Inquisition are here on Queen Vlaakith's orders. They're searching for a "
"weapon that could finally destroy the <i>ghaik</i>."
msgstr "심문관들은 블라키스 여왕님의 명령을 받고 여기로 왔어요. 마침내 <i>게이크</i>를 파괴할 수 있는 무기를 찾고 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 3a2ae70f-ce09-0128-48e5-880e5b6966fb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:3a2ae70f-ce09-0128-48e5-880e5b6966fb
msgctxt "h35815503g36f0g4530g8be0gbd8c5389dc41"
msgid ""
"Most of them are out searching for the weapon. But Ch'r'ai W'wargaz is here."
msgstr "대부분은 무기를 찾으러 나갔지만, 츠라이 와르가즈는 여기 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 3a2ae70f-ce09-0128-48e5-880e5b6966fb
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:3a2ae70f-ce09-0128-48e5-880e5b6966fb
msgctxt "h8618eb76g3db6g4a47g9506gc609735d0d2d"
msgid ""
"They're already searching for the weapon. You should report to Inquisitor "
"W'wargaz first."
msgstr "이미 무기를 찾는 중이에요. 일단 먼저 심문관 와르가즈에게 보고해야 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 3d4a54d8-002c-ad2b-897d-cc725381e8ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeKithrak = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:3d4a54d8-002c-ad2b-897d-cc725381e8ef
msgctxt "h90321459g9fe0g4a0cgaaa7gcf1e93afbb49"
msgid ""
"<i>We</i>?<i> </i>Don't bring me into it - I know when to keep my mouth shut."
msgstr "<i>저희</i>?<i> </i>날 끼워 넣지 마... 난 내 입을 다물어야 하는 때를 안다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 4067dd8b-27c6-31de-731a-b1755c66dce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:4067dd8b-27c6-31de-731a-b1755c66dce3
msgctxt "hfd0b636ag0868g420bga963g70a2e5a8239e"
msgid ""
"You think we're scared of your threats? They're nothing compared to the "
"Inquisitor's wrath."
msgstr "당신 지금 우리가 당신 협박에 굴할 거로 생각한 거야? 심문관의 분노에 비하면 아무것도 아닌걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 44a143c4-7c97-796a-b0b3-3a68f03278e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:44a143c4-7c97-796a-b0b3-3a68f03278e7
msgctxt "hb7ad6e35gc708g4ce7gbb79g950d3c8d259a"
msgid ""
"<i>Qun'irel!</i> The Inquisition have more to worry about than who you talk "
"to in the corridors."
msgstr "<i>퀴니렐!</i> 심문관들은 네가 복도에서 누구와 떠드는지보다 더 신경 써야 할 일이 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = 48133147-f2b1-1d13-ff22-838830106bcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e904524c-9f20-5a29-4b26-1126d7a6e35c_ConvincedInquisition = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:48133147-f2b1-1d13-ff22-838830106bcb
msgctxt "h76615550g316dg43c8g91beg718e10498b59"
msgid "Where can I find the other Inquisitors?"
msgstr "다른 심문관들은 어디에 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 4bceb415-68c0-844a-3890-df0da88a087f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeKithrak = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:4bceb415-68c0-844a-3890-df0da88a087f
msgctxt "h500dfcffg469cg48fegb0d0ge4ecc47464ba"
msgid ""
"Why don't you try your pretence on the <i>kith'rak</i>? She's down the "
"corridor in the east wing. I'm sure she'll enjoy the performance."
msgstr ""
"<i>키스락</i>께 모습을 보이는 건 어때요? 동쪽 건물의 복도를 따라 내려가면 만날 수 있어요. 당신의 등장에 꽤 즐거워하실 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = 526dc19c-e201-87ed-2bdb-75734a3ca006
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:526dc19c-e201-87ed-2bdb-75734a3ca006
msgctxt "ha0994746gc0ebg4feag801aga18973666202"
msgid "Inquisition? What are you talking about?"
msgstr "심문관? 무슨 말이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 5a070c4b-a6de-a56a-cb10-110391e03eae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:5a070c4b-a6de-a56a-cb10-110391e03eae
msgctxt "h3b54df7dgc2d0g44b9g865dgd35d5edd6c48"
msgid ""
"Forgive me, <i>jhe'stil</i>. I wasn't complaining. I'm honoured to help "
"search -"
msgstr "실례합니다, <i>제스틸</i>. 불평하던 건 아니었습니다. 탐색을 도울 수 있어 영광입니다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 63f1e860-a52b-2270-75ab-e7d812f602d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:63f1e860-a52b-2270-75ab-e7d812f602d5
msgctxt "h409da291gce3ag458agb7dbg9d94088fd80c"
msgid ""
"An <i>istik</i>? But - but - you can't be here! I can't be seen with you! "
"The <i>ch'r'ai</i> -"
msgstr ""
"<i>이스틱</i>이? 하, 하지만... 넌 여기 있으면 안 돼! 난 너랑 있는 모습을 보이면 안 되고! <i>츠라이</i>가 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 6784bc3d-f30f-25e2-e4f2-7da4862c85dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:6784bc3d-f30f-25e2-e4f2-7da4862c85dc
msgctxt "h34374612g6897g405cg95d6gf87d51c90b45"
msgid ""
"We heard the <i>kith'rak</i> say... the Inquisition is wasting her time with "
"this search for a weapon..."
msgstr "저희는 <i>키스락</i>께서... 심문 때문에 무기 탐색을 위한 시간이 낭비되고 있다고 말씀하시는 걸 들었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 6f5223e0-6738-074a-2242-a9b8e78f4ec2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CorridorTeens(2) = True
#.   Local:
#.      - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeKithrak = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:6f5223e0-6738-074a-2242-a9b8e78f4ec2
msgctxt "h5cdccd49ga36dg452cgbc3dg75fd5a14b26b"
msgid ""
"The <i>kith'rak</i> will welcome news from beyond the crèche. Good news, at "
"least."
msgstr "<i>키스락</i>께서 양성소 저편에서 새로운 소식을 고대하고 계실 거예요. 좋은 뉴스라면 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 710f3da1-3470-7240-caed-3c2b72cb5bcf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ConvincedInquisition = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:710f3da1-3470-7240-caed-3c2b72cb5bcf
msgctxt "hdfc86479gfc4ag40a7g96d9ga5a6a3f9ec36"
msgid "Nothing, <i>jhe'stil.</i>"
msgstr "아무것도 아녜요, <i>제스틸.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 710f3da1-3470-7240-caed-3c2b72cb5bcf
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ConvincedInquisition = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:710f3da1-3470-7240-caed-3c2b72cb5bcf
msgctxt "hb8eeda25g79dbg45f5gac3fg37fce1c7bb37"
msgid "Nothing, <i>ra'stil.</i>"
msgstr "아무것도 아녜요, <i>라스틸.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 738900a9-c796-a5b4-48e4-36b1deef847c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:738900a9-c796-a5b4-48e4-36b1deef847c
msgctxt "h38e23db3g1f3fg4cf4gaef5g88fcc69fca95"
msgid "Keep your mouth shut - you're going to get us in deep <i>tsk'va</i>."
msgstr "입 닥치고 있어... 너 때문에 상황이 <i>츠크바</i> 같아지고 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 7951c991-265e-a75e-33e6-c1eca4f68d28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:7951c991-265e-a75e-33e6-c1eca4f68d28
msgctxt "hd481a373ga30cg49c5ga892g126ee4fef3b3"
msgid ""
"We were only talking about what you already know. About the weapon. The one "
"the <i>kith'rak</i> can't find."
msgstr "이미 알고 있으신 내용에 관해 이야기하던 중이었어요. 무기 말이에요. <i>키스락</i>께서 못 찾고 계신 그거요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = 8d146a1a-83a9-f7e3-a6f5-235e92150554
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeKithrak = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:8d146a1a-83a9-f7e3-a6f5-235e92150554
msgctxt "h1995fc82g2b14g4c8cgb48ag89636c1fa723"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = 8d5a9a85-1ce6-c6b3-5bd5-dd62c54132ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:8d5a9a85-1ce6-c6b3-5bd5-dd62c54132ab
msgctxt "h0b45db33g52dbg445cg9219gd46a23705fc4"
msgid ""
"He's down the corridor in the eastern wing, on the other side of the "
"captain's quarters."
msgstr "복도를 따라 동쪽 건물로 가면, 대장님이 계신 방의 반대편에 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = 9557ddb0-4d4a-d315-9abb-3f971b9a8912
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:9557ddb0-4d4a-d315-9abb-3f971b9a8912
msgctxt "h9d16c166g72a9g4dcfga3cbg67e1a7f888c6"
msgid "See? I <i>told </i>you. Nothing to worry about."
msgstr "봐? 내가 <i>말했잖아</i>. 걱정할 거 없다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = adb36306-318c-214e-0803-46bc9c2f0cde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e904524c-9f20-5a29-4b26-1126d7a6e35c_ConvincedInquisition = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:adb36306-318c-214e-0803-46bc9c2f0cde
msgctxt "h4976f6e0g5d78g45d1gb02fg34b78c565857"
msgid "You sound pretty afraid of the Inquisition - why?"
msgstr "심문관을 아주 무서워하는 것 같은데, 왜지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = b418cb47-6c96-6be2-786d-d205230376e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:b418cb47-6c96-6be2-786d-d205230376e9
msgctxt "h01287d43ga4dbg4b11gbdaag2e964021006d"
msgid ""
"The <i>kith'rak </i>is very worried about the <i>ghaik </i>threat. Before "
"you came here, discovering what is happening in Moonrise Towers was our main "
"focus."
msgstr ""
"<i>키스락</i>께서는 <i>게이크</i>의 위험성을 아주 걱정하고 계세요. 당신이 여기 오시기 전까지, 저희는 문라이즈 타워에서 무슨 "
"일이 있었는 지 알아내려고 하고 있었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = bd6a58ab-677b-77ba-d587-cad1dc6d3256
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e904524c-9f20-5a29-4b26-1126d7a6e35c_ToldToSeeKithrak = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:bd6a58ab-677b-77ba-d587-cad1dc6d3256
msgctxt "hcdfc5e5bge1dag4ddeg916cg00e756e9ee4b"
msgid "She's in her quarters, through those doors."
msgstr "대장님의 방에 계세요. 저 문들을 통해 가면 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = c3bdf75c-e4bf-bf4e-a17e-47c378a96096
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:c3bdf75c-e4bf-bf4e-a17e-47c378a96096
msgctxt "hb9d6f4dcgb840g4125g9489gc6482e1f46ac"
msgid ""
"<i>Qun'irel! </i>Look at him. He's <i>clearly</i> not with the Inquisition."
msgstr "<i>퀴니렐!</i> 저 남자 봐봐. 심문관 쪽 사람은 <i>전혀</i> 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = c3bdf75c-e4bf-bf4e-a17e-47c378a96096
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:c3bdf75c-e4bf-bf4e-a17e-47c378a96096
msgctxt "hef87459dg3f47g4fceg8155gb1ef8ddfafa4"
msgid ""
"<i>Qun'irel! </i>Look at her. She's <i>clearly</i> not with the Inquisition."
msgstr "<i>퀴니렐!</i> 저 여자 봐봐. 심문관 쪽 사람은 <i>전혀</i> 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = c3bdf75c-e4bf-bf4e-a17e-47c378a96096
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:c3bdf75c-e4bf-bf4e-a17e-47c378a96096
msgctxt "h9dd57285g4830g47d6g978cgd01a0f5e2ea2"
msgid ""
"<i>Qun'irel! </i>Look at them. They're <i>clearly</i> not with the "
"Inquisition."
msgstr "<i>퀴니렐!</i> 저 사람 봐봐. 심문관 쪽 사람은 <i>전혀</i> 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = c7a69265-05bd-52bc-b67a-f47790fddf0a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:c7a69265-05bd-52bc-b67a-f47790fddf0a
msgctxt "he8d78c63gef1bg4077g9b17g5e2fc523e2e6"
msgid "Inquisitor W'wargaz. The <i>ch'r'ai</i>."
msgstr "심문관 와르가즈요. <i>츠라이</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Qun'irel
#. NodeID = c7a69265-05bd-52bc-b67a-f47790fddf0a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:c7a69265-05bd-52bc-b67a-f47790fddf0a
msgctxt "he04a9a2egfe7dg4702gac0bg855408c8073c"
msgid "Ch'r'ai W'wargaz."
msgstr "츠라이 와르가즈요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = ceb158cc-4496-67f2-b485-6e07e540486f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:ceb158cc-4496-67f2-b485-6e07e540486f
msgctxt "hc14a546fg09fdg4be2g9ce1g4406331d3e8c"
msgid "At ease. I'm just looking for your captain."
msgstr "진정하렴. 너희 대장을 찾고 있을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = d150e0d4-3dcc-6f47-e1a2-0331f968d916
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:d150e0d4-3dcc-6f47-e1a2-0331f968d916
msgctxt "h5fae48c9g796dg430bg86eagb3d822e8b75e"
msgid ""
"I'm with the Inquisition. Tell me what you were gossiping about. <i>Now.</i>"
msgstr "난 심문관 쪽 사람이다. 뭘 쑥덕거리고 있었는지 말해. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = d538993d-827f-ee53-ca70-8f74c30c107a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e904524c-9f20-5a29-4b26-1126d7a6e35c_ConvincedInquisition = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:d538993d-827f-ee53-ca70-8f74c30c107a
msgctxt "h241885d4g2b54g400bgac99g1376656222a8"
msgid "Who's in charge of the inquisition?"
msgstr "심문은 누가 담당하고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = da9c45e4-9349-4d75-1725-40feb7b77011
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:da9c45e4-9349-4d75-1725-40feb7b77011
msgctxt "h1774c454g35e5g4927gb4abg826f5c5511ea"
msgid ""
"They're the darkness at the edge of Queen Vlaakith's light. It's easy to "
"get... <i>lost</i> in their shadow<i>.</i>"
msgstr ""
"그들은 블라키스 여왕님의 빛, 그 경계의 어둠이니까요. 까딱하면... <i>저들의 그림자 속에서</i> 길을 잃을 수 있죠<i>.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Player
#. NodeID = e17e2f50-67d6-e02c-10c0-6a778d715a77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:e17e2f50-67d6-e02c-10c0-6a778d715a77
msgctxt "h1a9e48e5gcd49g4a2dgb544g57985221b845"
msgid "And I'm not here to harm you, either. Can you tell me more?"
msgstr "그리고 너희를 해치려고 하는 것도 아냐. 좀 더 자세히 말해줄 수 있겠니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers
#. Speaker = Youth Tra'an
#. NodeID = f989ea6d-a2f8-b79a-b651-a7f2ecfd15ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_CorridorTeenagers:f989ea6d-a2f8-b79a-b651-a7f2ecfd15ce
msgctxt "hbe0af95ag76cbg484dgac9eg3723106ae441"
msgid "<i>Qun'irel!</i>"
msgstr "<i>퀴니렐!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 0d9d7a76-9838-9c03-25b9-b24b301d2180
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:0d9d7a76-9838-9c03-25b9-b24b301d2180
msgctxt "h1d0ddaf3geefdg4132ga972g9a261e62c1aa"
msgid "I'll show you the meaning of fear, you little <i>mrags</i>."
msgstr "공포가 뭔지 알려주지, 이 좆만한 <i>므락스</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 0d9d7a76-9838-9c03-25b9-b24b301d2180
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:0d9d7a76-9838-9c03-25b9-b24b301d2180
msgctxt "he7a03061gca67g473bg9108g415e49d40c0a"
msgid "I'll show you the meaning of fear, you little <i>shka'keths</i>."
msgstr "공포가 뭔지 알려주지, 이 좆만한 <i>스카케스</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 0d9d7a76-9838-9c03-25b9-b24b301d2180
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:0d9d7a76-9838-9c03-25b9-b24b301d2180
msgctxt "heb7fe0a8g7400g41e7ga130g3e66b550fe03"
msgid "I'll show you the meaning of fear, you snivelling little toe-rags."
msgstr "공포가 뭔지 알려주지, 이 훌쩍이는 거지새끼야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 0e41258e-e756-aba6-6dc5-48e95ba96cee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 24124369-4e10-034f-351c-aff4c861ba26_AskedWhatsInChest = True
#. SetFlags:
#.   Local:
#.     - 24124369-4e10-034f-351c-aff4c861ba26_AskedWhatsInChest = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:0e41258e-e756-aba6-6dc5-48e95ba96cee
msgctxt "hf4044ee9g77f8g4f97ga6a4ga942da22d6a4"
msgid ""
"Whatever it is, I think you should stop. It's clearly not having a good time."
msgstr "뭔진 모르겠지만, 그만해야 할 것 같아. 분명히 즐기고 있는 것 같진 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 11666461-d72c-adfe-b6f7-eb067494a50b
