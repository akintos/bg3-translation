msgctxt "h189b1a7egc2d6g4be7gbedeg81e86f3a6acf"
msgid "*Reee?*"
msgstr "*리이이?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = f429ac93-d195-e55c-7dee-f9ae99aaa1c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:f429ac93-d195-e55c-7dee-f9ae99aaa1c1
msgctxt "hab03a7b1g9193g4124g9c1cgd19ddacaf51c"
msgid "Fie!"
msgstr "쳇!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = f60f2f57-efb0-01cc-eb34-3851c7efa056
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:f60f2f57-efb0-01cc-eb34-3851c7efa056
msgctxt "h39fde39fgcd11g428cg82c4g3041681471fe"
msgid ""
"*These spiders aren't wild - they've been raised by local duergar and are "
"fiercely loyal to them.*"
msgstr "*이 거미들은 야생이 아닙니다 - 지역 듀에르가에게 길러졌고 그들에게 맹렬히 충성합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = f9d29785-f787-8b77-176c-2854efe31f50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:f9d29785-f787-8b77-176c-2854efe31f50
msgctxt "h6c438d14ge706g40f2gbd4dg3f849410a0a5"
msgid "Ungrateful!"
msgstr "은혜도 모르는!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = fac9ddb4-675b-98ca-9265-a03a23775e6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:fac9ddb4-675b-98ca-9265-a03a23775e6c
msgctxt "h06dd0d71g4c75g4df6g9f33gf0e9c3166426"
msgid "Father Murmath is our past - Lolth is our future!"
msgstr "파더 무르마스는 이제 과거야, 롤쓰님이 미래라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = fca4411e-d16b-cf58-0ac2-91fbeb97ecf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:fca4411e-d16b-cf58-0ac2-91fbeb97ecf4
msgctxt "he5a574f2gcd5fg4c04g87aag22a1b3a0ff65"
msgid "He is all he is and all he is not!"
msgstr "그는 그 자체이기도 하고 아니기도 하다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_Spider02
#. Speaker = Lur Jox
#. NodeID = 2dc814e7-ad6b-489e-b6cb-c6ac6e869487
