#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:01df7530-8595-4eb4-9129-47e5854b95aa
msgctxt "h7549db66g61a9g4b05ga33bg6d93074103df"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = 08e05ab5-739f-b7e6-9a21-97ebac585a56
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidDrowDead_State_ToldFurnaceSearch = True
#.     - UND_MyconidDrowDead_State_MentionedOthers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:08e05ab5-739f-b7e6-9a21-97ebac585a56
msgctxt "he543b932gd453g4a24g9c61g10703bc686e5"
msgid "Glory... we search... for the Adamantine Forge..."
msgstr "영광... 우리는... 아다만틴 대장간을... 찾는다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 11494c9a-8272-409e-b9ed-83c643c46ec3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidDrowDead_State_ToldFurnaceSearch = True
#.      - UND_AdamantineForge_Knows_SawForge = False
#.      - UND_AdamantineForge_Knows_WhatForgeIs = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:11494c9a-8272-409e-b9ed-83c643c46ec3
msgctxt "h0ed74a49g981ag4bcag9358ge26f587d9cac"
msgid "Do you know where to find the Forge?"
msgstr "대장간을 어디서 찾을 수 있을지 아나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 1ae7ba81-3e9c-accf-fe45-1160d6754ee0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidDrowDead_State_ToldFurnaceSearch = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:1ae7ba81-3e9c-accf-fe45-1160d6754ee0
msgctxt "h67ea3d4bgae49g494cg8298gb175147756a2"
msgid "What was your business down here?"
msgstr "이 아래에서 무슨 일을 하던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 31fe2a33-9027-47ec-a584-494ef2cf73a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:31fe2a33-9027-47ec-a584-494ef2cf73a7
msgctxt "ha3b32c0ag57d4g4664g8333ga584e9bbe731"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = 3bed0658-1cd8-4f4c-569a-36bcbe099f19
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
