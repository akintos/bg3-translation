msgctxt "h85316ea4g600bg4c59g93e4g35b6ae286b55"
msgid "You'd turn on Spaw, who gave you shelter?"
msgstr "피난처를 준 스포를 배신한다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 0a5c03e0-dc94-9a58-5b70-253f938b5e84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:0a5c03e0-dc94-9a58-5b70-253f938b5e84
msgctxt "h1fbb1c98g26f3g49abg809fgafb82de5a9a6"
msgid ""
"((*Spaw was a coward, but in one thing it was correct - the drow Nere must "
"<b>die</b>*))"
msgstr "((*스포는 겁쟁이였지만, 하나는 옳았지 - 그 드로우, 니어는 <b>죽어야</b> 한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = 0a77fd41-cf32-aa52-2caf-602bf3d4b194
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:0a77fd41-cf32-aa52-2caf-602bf3d4b194
msgctxt "h3c8acf1ag1525g4d46gb181gbc9b3fdb1f27"
msgid "*It shivers in resonance with your remembered pain.*"
msgstr "*그는 당신의 기억 속 고통에 공감하며 몸을 떱니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 0abf5549-c98d-8e66-d321-e12c9db5c4fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:0abf5549-c98d-8e66-d321-e12c9db5c4fe
msgctxt "h22fcda12g4f9cg4147gba45g3b2b2ae5fda4"
msgid ""
"((*in death, your foe becomes your ally. I will raise it; you may command "
"it*))"
msgstr "((*죽음을 통해, 네 적은 곧 너의 아군이 될 것이다. 내가 그들을 되살리겠다, 그리하면 네가 그들에게 명령을 내리리라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 0c030043-2039-b34f-6b6e-2568dd81069f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:0c030043-2039-b34f-6b6e-2568dd81069f
msgctxt "h7749aea5g0f2fg4fe8ga0e8g10c688b08005"
msgid "A tricky concept - but home is wherever you can make it. Family, too."
msgstr "까다로운 질문이군. 내가 원하면 어디든지 집이 될 수 있소. 가족도 마찬가지지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 12aa9421-139c-ce71-4dfa-29cea74ef2c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:12aa9421-139c-ce71-4dfa-29cea74ef2c4
msgctxt "hfba8364fg9d9bg4291g9c47g9d5bca723598"
msgid ""
"((*choose, smooth-mind. help me grow a mighty Circle and reap the "
"reward...*))"
msgstr "((*선택해라, 부드러운-정신. 내가 강대한 공동체를 키우는 것을 돕고 보상을 수확해라...*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = 1d56e414-f3f2-0693-3301-5a0e46010b62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:1d56e414-f3f2-0693-3301-5a0e46010b62
msgctxt "h1388ab31gca5bg4029ga5dag0ad48159af6f"
msgid "*It shivers, overwhelmed by alien sights.*"
msgstr "*외계의 광경에 압도된 듯, 포자 군주가 몸을 떱니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 1e531162-dd0d-9223-b128-af41371569b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_DeclinedBroodingSovereign = True
