msgid "<i>Pet him.</i>"
msgstr "<i>쓰다듬어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = 8255ee6e-dcf3-26a4-3c47-219b94edddee
