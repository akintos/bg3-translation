msgctxt "h627455ceg0cd5g4760g8e15ge8ee3c143544"
msgid "I'd like you to return Minsc."
msgstr "민스크를 되살려주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 57dc07cc-da9a-b30e-c3f0-eacb78bfa3dc
