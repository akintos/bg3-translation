msgctxt "hbf0dfe76g0b1ag4f8dgb080g294dccc05f62"
msgid "Whoa - what the <i>fuck</i>, Astarion?!"
msgstr "무슨.. <i>씨발</i> 뭐야, 아스타리온?!"

