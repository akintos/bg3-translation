#.      - CAMP_GoblinHunt_HasMet_Shadowheart(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:ca84fd57-d2f8-98a2-a435-e89e2eb2fff6
msgctxt "hf8da6f7eg067cg4a3cgbb74gdd873ef350e6"
msgid "Entertain yourself elsewhere."
msgstr "재미를 보고싶으면 다른 사람을 찾아봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Narrator
#. NodeID = cf42b123-595a-2d9e-8e61-191f90c632c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:cf42b123-595a-2d9e-8e61-191f90c632c0
msgctxt "h75ba3950g4f71g4f43gb315gb09678f6cd98"
msgid "*Your head swims, nausea burning in your gut.*"
msgstr "*머리가 빙빙돌고, 배에서 매스꺼움이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = d41ce278-081b-dbb8-91ed-56766c5974db
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_ShadowheartRejected(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:d41ce278-081b-dbb8-91ed-56766c5974db
msgctxt "h10711463g3a4fg47ddgb1e2g8958d0f621b5"
msgid "Thank you. The offer's kind, but it's not a kindness I can afford."
msgstr "고마워. 아주 친절한 제안이지만 받아줄 수 없을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Player
#. NodeID = da291dab-103e-76ec-adf3-a7f25bfb2e77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:da291dab-103e-76ec-adf3-a7f25bfb2e77
msgctxt "h98c5bcb9gce4fg467cgb711g5443cff5d652"
msgid "Pull yourself together. Your behaviour is unbecoming."
msgstr "정신차려. 이런 태도는 참아주기 힘들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = daf963c0-2158-83b5-2070-7a0915c23c2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:daf963c0-2158-83b5-2070-7a0915c23c2a
msgctxt "ha30a5e0ag4014g4299g83c1g696abdfd999d"
msgid "Guilty? Ridiculous. What's there to be guilty for?"
msgstr "죄책감이라고? 말도 안 돼. 죄책감을 느낄 이유가 뭐가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = dbdbb985-72e6-493b-e6e5-62dae10a49a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:dbdbb985-72e6-493b-e6e5-62dae10a49a6
msgctxt "hdf6e81eeg6168g4109gb532g5def4f6c3638"
msgid "At least you've spared them the hangover tomorrow."
msgstr "적어도 내일 숙취로 고통받진 않게 해 줬잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Player
#. NodeID = de6d8787-5c9c-cda2-a488-bf6819530129
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF or REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:de6d8787-5c9c-cda2-a488-bf6819530129
msgctxt "h7cf21433g4017g4e8bg8d8agec3f60b2ecbb"
msgid "I'm not sure what to say. I've never done any of this... comforting."
msgstr "뭐라 말해 줘야 할지 모르겠네. 이런... 위로는 해본 적이 없어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Player
#. NodeID = e37e0d5e-2389-58d9-a222-200edd016165
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DETECTTHOUGHTS(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:e37e0d5e-2389-58d9-a222-200edd016165
msgctxt "h57681750g2885g4d1bg8adfg38920fbe45bc"
msgid "<i>Will your magic to pierce Shadowheart's thoughts.</i>"
msgstr "<i>의지를 강화해 섀도하트의 생각을 엿본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = ebef77c3-4a07-ef5a-380e-4fee12b6e336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:ebef77c3-4a07-ef5a-380e-4fee12b6e336
msgctxt "hbe81ab1bg8431g4176ga6adg7ad4f47c3fab"
msgid "Careful that she doesn't take a piece of you as a souvenir."
msgstr "그녀가 네 일부를 기념품으로 챙겨가지 않도록 조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = ecde2968-ddd9-4ee0-cc28-2731d8d27fde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:ecde2968-ddd9-4ee0-cc28-2731d8d27fde
msgctxt "hee0652f9g3859g41b9ga87cg3a79f3ffb8d1"
msgid "Ah, sitting. Such an engaging activity."
msgstr "아, 앉아있기라. 그것 참 매력적인 활동이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = f2d4eeae-0972-bab4-ee08-7c9fd8485d60
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_HasMet_Shadowheart(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:f2d4eeae-0972-bab4-ee08-7c9fd8485d60
msgctxt "heb984b50g5ac2g4fbfg8bf2g50fb04b0dc31"
msgid "What a glorious celebration. Hip-deep in gore."
msgstr "다들 재밌게 노네. 몸에 다른 사람 피를 잔뜩 묻힌 채."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Player
#. NodeID = f396b6e5-a851-7010-8036-6993403c37fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:f396b6e5-a851-7010-8036-6993403c37fd
msgctxt "hd8ee0ba7g292dg49c2g904fgfa044e55a7c9"
msgid "You're tearing through that bottle. Is something wrong?"
msgstr "병을 통째로 들이키고 있잖아. 무슨 일 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Player
#. NodeID = fa58f87c-6416-58da-eb96-d5cae9c6d66d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_HALFORC or SELDARINEDROWELF
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:fa58f87c-6416-58da-eb96-d5cae9c6d66d
msgctxt "h881f4186g78d3g4d28gab02g1924294ba441"
msgid "How about a warsong? Something to celebrate your triumph."
msgstr "군가를 부르는 건 어때? 네 승리를 기념하기 위해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = fb3130b7-3ac0-8fed-ab99-3100aa4ddf61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_Knows_Vampireness = True
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:fb3130b7-3ac0-8fed-ab99-3100aa4ddf61
msgctxt "h79a88c7dg130dg47d2ga0f5g6b095a1ed96f"
msgid "Not interested in a vampire's leftovers, I'm afraid."
msgstr "미안하지만, 뱀파이어의 연애편지엔 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = fdbd10e9-dbc6-e5a2-baef-928fe711951f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_State_DrowBetrayalOver = True
#.   Object:
#.      - CAMP_GoblinHuntCelebration_HasMet_ShadowheartAfterBetrayal(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:fdbd10e9-dbc6-e5a2-baef-928fe711951f
msgctxt "h5adf321egd11dg45f1gb70eg64f4c59b2105"
msgid "Ugh. Later. Ground's spinning."
msgstr "웩. 나중에. 땅이 빙글빙글 도네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = ffb8779d-7f4a-9b32-536c-9bc5af3616a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:ffb8779d-7f4a-9b32-536c-9bc5af3616a6
msgctxt "h9f239a4bg8b44g4fdag9f1eg4e543b30c88c"
msgid "Not exactly an ambush for the ages."
msgstr "무슨 대단한 일을 해냈다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = ffea0390-2eb3-52e6-058b-6a99aabbe011
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:ffea0390-2eb3-52e6-058b-6a99aabbe011
msgctxt "h736e6748gd2aag4c86gb015gb041d6cb2588"
msgid "What's wrong with enjoying a gift from our guests?"
msgstr "손님이 마시라고 준 술 마시는 게 뭐가 문젠데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 022bbbd4-08a4-8724-9e50-10b3a672cd90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:022bbbd4-08a4-8724-9e50-10b3a672cd90
msgctxt "hd527ea2ag08e4g48aag8a05g508c1ca04549"
msgid "I'm looking forward to it. It'll be fun."
msgstr "기대 중이야. 아주 재밌겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 04dbfd66-b48d-df5e-f8fd-16c42f380aad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:04dbfd66-b48d-df5e-f8fd-16c42f380aad
msgctxt "h7a0acfccg6e71g48c5ga62fgd0a6a207c8cd"
msgid "See what I mean? Awful."
msgstr "무슨 뜻인지 알겠어? 끔찍해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 066d7aca-1f77-37f5-bb79-fece7882f6c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_HasMet_Astarion(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_HasMet_Astarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:066d7aca-1f77-37f5-bb79-fece7882f6c9
msgctxt "h7c6b3c36g68afg4573g8213g691f1933841e"
msgid "You know, I never pictured myself as a hero."
msgstr "있잖아, 난 내가 영웅이 될 거라곤 한 번도 생각해 본 적 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 104aadf1-7946-a967-a0b8-eb9dac86cff8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_KarlachPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:104aadf1-7946-a967-a0b8-eb9dac86cff8
msgctxt "hb1c5bc66g3398g4a0eg9421gd9cc94c74626"
msgid "Ha! No, my love, I'm not jealous of the tiefling."
msgstr "하! 아니, 내 사랑, 난 티플링한테 질투가 난 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 11a7078e-78d1-3aa8-020e-324cf1fcbc42
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_AstarionRefused(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:11a7078e-78d1-3aa8-020e-324cf1fcbc42
msgctxt "h73a8f9bdg65d6g437agb02eg2859b83a5106"
msgid "True, I'd rather lie with them."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 11f6caba-0540-8e2e-b61c-cd7b8105d3fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DoubleDating(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:11f6caba-0540-8e2e-b61c-cd7b8105d3fc
msgctxt "h74e8ef17g772fg4db7gb0cagce1af9fbab22"
msgid "Living in constant peril isn't exciting enough for you?"
msgstr "위험한 모험을 계속하는 것만 해도 충분한 거 아니야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 14bdaed6-25c4-6d60-ae10-116dfb8d9e32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_WyllPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:14bdaed6-25c4-6d60-ae10-116dfb8d9e32
msgctxt "h9b896f24gc029g48c2g9109g52c94603beb2"
msgid "Do you think Wyll would approve? I saw how he looked at you earlier."
msgstr "윌이 뭐라고 하지 않을까? 아까 너를 보는 눈빛이 어떤지 봤거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 1588e9ae-8374-3c6c-6c3c-807d6eb55a79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:1588e9ae-8374-3c6c-6c3c-807d6eb55a79
msgctxt "hf4f1e6c6g5d7eg4cd1g8312ge3e21671cc92"
msgid "That had better not mean 'I want to kill something'."
msgstr "그 말이 '뭔가 죽이고 싶어'라는 뜻이 아니길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 213a5619-5bc1-5d6e-bc13-3912299c2429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:213a5619-5bc1-5d6e-bc13-3912299c2429
msgctxt "h3bbf4451gc697g4622g9090g724b0be71ce0"
msgid "No, absolutely not."
msgstr "아니, 절대 그럴 일 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 25e393d8-a554-60c2-9565-9b91b10412ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:25e393d8-a554-60c2-9565-9b91b10412ba
msgctxt "h3b443794g0539g4e09g8518gdec46ec22a01"
msgid "I hope you're not here to beg. It's so unbecoming."
msgstr "네가 간청하러 온 게 아니길 바라. 너답지 않으니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 26988932-bd46-3f2e-b1e7-215aa5bdd061
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:26988932-bd46-3f2e-b1e7-215aa5bdd061
msgctxt "h9c3efcdagfb91g439bg8379ge0c9f4e5e9c6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 27f6b605-8292-7058-295c-c75515c2e546
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:27f6b605-8292-7058-295c-c75515c2e546
msgctxt "h17628d7fg2affg49c7gad74g19ea61b29119"
msgid ""
"I just hope she leaves you in one piece. We can't take a tenday for you to "
"recover from whatever her idea of 'fun' is."
msgstr ""
"그녀가 네 사지를 멀쩡하게만 놔두길 바랄 뿐이야. 그녀가 '재미'를 보고 난 다음 네가 회복하는 걸 열흘 동안 기다릴 순 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Narrator
#. NodeID = 28543b5d-fec4-d09e-64ba-4af9fddec1a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:28543b5d-fec4-d09e-64ba-4af9fddec1a7
msgctxt "hfd03a08ag7b9eg4d1bgb210ga2306423e5a8"
msgid "*It's a heavy, rich red - dry and sharp.*"
msgstr "*무겁고, 묵직한 적포도주입니다. 건조하고 날카롭습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 2a70d2a4-64a7-1ba6-9bf7-9f02a866ff87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:2a70d2a4-64a7-1ba6-9bf7-9f02a866ff87
msgctxt "hda2007d8g0549g4946ga66dg6591e2a0c3c8"
msgid "I mean, can you imagine? Urgh. No."
msgstr "내 말은, 상상이 가? 으. 싫어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 2ada58a3-8717-a3a2-9417-37097e3de954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:2ada58a3-8717-a3a2-9417-37097e3de954
msgctxt "h95260213g74e3g462fgbd37g1c4f376e1819"
msgid ""
"But what do I get for all my hard work? A pat on the head and vinegar for "
"wine."
msgstr "그래서 내 힘든 노동의 대가로 얻은 게 뭐야? 칭찬 몇 마디에 식초 같은 포도주뿐이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 2b8853f7-4c2e-31f5-1e11-739285762852
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:2b8853f7-4c2e-31f5-1e11-739285762852
msgctxt "h7fb1fd7bged34g4281ga58cg0ebd8b36c022"
msgid "And what's your idea of 'a little fun'?"
msgstr "네가 생각하는 '약간의 재미'라는 게 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 308b1d81-405b-c25b-c994-f2102a5d6b48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:308b1d81-405b-c25b-c994-f2102a5d6b48
msgctxt "hdaf095c0g131eg4579gb139g95f1ebc94e40"
msgid "Watch, maybe, but never intrude."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 30c38768-9e6a-0fe8-161a-61a1e4d5fba5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_KarlachPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:30c38768-9e6a-0fe8-161a-61a1e4d5fba5
msgctxt "he3f40e3eg5be9g4aefgb106g146d24f540b1"
msgid ""
"It's easy for some, of course. You and Karlach seem to be getting on very "
"well."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 343eedab-6143-8e87-68eb-9a5bdf47f52f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:343eedab-6143-8e87-68eb-9a5bdf47f52f
msgctxt "h2c013409gca2eg4c9dg9461g7f59e7275014"
msgid "It's easy for some. I see Lae'zel's marked you as her territory."
msgstr "누군가에겐 쉬운 일인 것 같네. 보아하니 레이젤이 널 점찍은 거 같던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 34780cbc-3356-d9d0-5a32-f9dcb18b469d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:34780cbc-3356-d9d0-5a32-f9dcb18b469d
msgctxt "h5e21f221gaf95g4da7gbe03gb04acf9afaa1"
msgid "You did a good thing. Suck it up and enjoy yourself."
msgstr "넌 좋은 일을 한 거야. 받아들이고 즐겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 389fc18d-9692-3395-4236-c85e50f0f17a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:389fc18d-9692-3395-4236-c85e50f0f17a
msgctxt "hf5bb97e1g3919g4833gaf79g2de8a9afcbce"
msgid "Well, that'd certainly spice up this evening."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 3a0c8923-cdcc-461c-2504-6e06a7e01d54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:3a0c8923-cdcc-461c-2504-6e06a7e01d54
msgctxt "h6ffce71cg6f11g4ad1g87b8g50cf9013ce81"
msgid ""
"I don't know what her idea of a good time is, but it seems to involve you. "
"I'd hate to intrude."
msgstr "그녀가 생각하는 좋은 시간이 무엇인지는 잘 모르겠지만 거기에 네가 포함된 것 같아. 난 끼어들고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 3be692d0-2202-758c-c230-7758f6bb8aad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:3be692d0-2202-758c-c230-7758f6bb8aad
msgctxt "h93e68c44gbc15g41abg9806g4ee578bc24bd"
msgid "It's just sex. Nothing serious."
msgstr "그냥 섹스일 뿐, 진지한 관계는 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 3c34bbd6-e2df-146f-c09a-6e9ad075215e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:3c34bbd6-e2df-146f-c09a-6e9ad075215e
msgctxt "he0ea5cadgc6a4g4eb4g8045g4a4b790d6b46"
msgid ""
"Never thought I'd be the one they toast for saving so many lives. And now "
"that I'm here..."
msgstr "내가 수많은 생명을 구하고, 그 일로 그들이 나에 대한 건배를 외치게 될 줄은 몰랐지. 그런데 막상 그렇게 되고 나니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 3dca05dd-2957-7a58-08e4-127f071b12e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DoubleDating(1) = True
#.      - ORI_State_DatingAstarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:3dca05dd-2957-7a58-08e4-127f071b12e8
msgctxt "hbaeca972gaadeg48bcg8b41g1bbeffaeda67"
msgid "Living in constant peril isn't exciting enough for you?"
msgstr "위험한 모험을 계속하는 것만 해도 충분한 거 아니야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 40216f2d-51bc-cbbb-0e1b-99302428f3ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:40216f2d-51bc-cbbb-0e1b-99302428f3ac
msgctxt "hb8ff9844g3877g4f30g9410g411b3de1b727"
msgid "True, the goblins would have thrown a wilder party."
msgstr "맞는 말이야, 고블린들이었다면 더 신나는 파티를 벌였을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 420cd23c-97b9-41c7-1383-16846ddcd997
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:420cd23c-97b9-41c7-1383-16846ddcd997
msgctxt "hc77b448age890g4f0dg8c7agbcc3fe949279"
msgid "True. That was fun."
msgstr "사실이야. 재밌긴 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 4357e3c9-b506-f88c-5cfd-cca6ad65a7d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:4357e3c9-b506-f88c-5cfd-cca6ad65a7d7
msgctxt "h9d25362agbfa1g498cg8a3fgc00acc5ee4ac"
msgid "Relax, all your problems will still be there in the morning."
msgstr "진정해, 어차피 자고 일어나도 그 문제들은 그대로 있을 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 4dbba99e-ff42-b757-85b3-33b4e4adf5e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:4dbba99e-ff42-b757-85b3-33b4e4adf5e3
msgctxt "h26987f8dg1ef1g4b50gab55g412c827571cd"
msgid "Don't be so sour. I like a good time as much as anyone."
msgstr "너무 까탈스럽게 굴지 마. 나도 다른 사람들처럼 즐거운 시간을 좋아한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 51329f16-a0bb-1b97-885f-f2c0d74bdbd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:51329f16-a0bb-1b97-885f-f2c0d74bdbd5
msgctxt "h6de3acd4g38adg4f8agae76gcfcd29e3f543"
msgid "What?"
msgstr "뭐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 540de809-1b2d-55f5-bce3-37dc6432933b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_ShadowheartPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:540de809-1b2d-55f5-bce3-37dc6432933b
msgctxt "ha6a295c2g7f11g4e3ag942fgd9c9f981f357"
msgid ""
"It's easy for some. You and Shadowheart seem to have a connection. It looks "
"very sweet."
msgstr "누군가에겐 쉬운 일인 것 같네. 너랑 섀도하트가 그렇잖아. 정말 달달해 보이던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 5dc4b077-9be5-e19f-6e98-18a6543c651d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:5dc4b077-9be5-e19f-6e98-18a6543c651d
msgctxt "hf6b2ea97g9e83g4c34ga986ge0c8e2510b76"
msgid "Really? Saving lives is awful?"
msgstr "정말? 생명을 구하는 게 끔찍하다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 5f917adf-dcf7-a248-e246-a4553d6cf961
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DoubleDating(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:5f917adf-dcf7-a248-e246-a4553d6cf961
msgctxt "hf340a1e9g502cg401agbedcg6e6855323f98"
msgid "Interested in sharing a bed tonight?"
msgstr "나랑 하룻밤 같이 보낼 생각 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 5fa3a697-8c00-f40d-3cf7-6d024adef700
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_WyllPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:5fa3a697-8c00-f40d-3cf7-6d024adef700
msgctxt "h85dc3128g4bcag4dafgb1cbga0c8945113f3"
msgid "Just so you know, I'm spending tonight with Wyll."
msgstr "너도 알다시피, 난 윌이랑 하룻밤을 보낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 5fbb4369-6ce0-b7c9-8a18-e23fdf6eefaf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_HasPartner(1) = True
#.     - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:5fbb4369-6ce0-b7c9-8a18-e23fdf6eefaf
msgctxt "hf7ba084ag411dg4b01ga5b1gab0e818d1afe"
msgid "Cheeky little pup. I'll see you later."
msgstr "건방진 새끼 고양이 같으니. 좀 있다 만날게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 64348e36-77dc-1044-a5f2-13dabdfb9273
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:64348e36-77dc-1044-a5f2-13dabdfb9273
msgctxt "h5f09d760g8665g47edg9709gef45e7348c37"
msgid ""
"Let's wait until things quieten down. Once the others are asleep, we'll find "
"each other. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 654e3047-83f1-c43d-4a16-bca1926707ea
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:654e3047-83f1-c43d-4a16-bca1926707ea
msgctxt "h801155adg95deg4dddgb3efg637fab84924a"
msgid "Say 'please'."
msgstr "'제발' 이라고 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 660bb96a-0d99-f457-4ba9-f8087d5fd5a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:660bb96a-0d99-f457-4ba9-f8087d5fd5a6
msgctxt "hd119f134gb442g4e89g9963gab6bec875bd3"
msgid ""
"Still, I would've liked more for my trouble than a pat on the head and "
"vinegar for wine."
msgstr "그래도, 칭찬 한마디와 식초 같은 와인보단 고생한 대가가 더 컸으면 좋았을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 67a62151-4dea-3c75-401e-677c1b21b017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:67a62151-4dea-3c75-401e-677c1b21b017
msgctxt "hcf6fa748ge328g44d9ga395g84ba5caf501f"
msgid "That's a 'no' to fun, then?"
msgstr "'싫다'는 뜻으로 받아들이면 되겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 67eea55e-1e9e-0b54-5ff4-2e4a167b7be0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DoubleDating(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:67eea55e-1e9e-0b54-5ff4-2e4a167b7be0
msgctxt "hacceba7bg7b1cg4539gba00ge144932ce7e5"
msgid "We could have fun? We could spend some 'quality time' together."
msgstr "함께 즐거움을 나누는 건 어때? '즐거운 시간'을 함께 보낼 수도 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 67f72561-d3b3-130f-191c-b0328c84d2a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:67f72561-d3b3-130f-191c-b0328c84d2a8
msgctxt "h44b288cbg7e32g4a74gb51dg525cfb926b37"
msgid "<i>Take his bottle and try the wine.</i>"
msgstr "<i>그의 병을 받고 포도주를 마셔본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 691515ed-7903-3913-afee-b20dfb9f581b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:691515ed-7903-3913-afee-b20dfb9f581b
msgctxt "h01695a07g1ca0g440bg83beg30bab4579044"
msgid ""
"Will you now? Don't take too long. You're not the only tasty morsel here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 6aaaadb7-ab62-1648-8fe1-2b7ab075d726
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:6aaaadb7-ab62-1648-8fe1-2b7ab075d726
msgctxt "h9cdae993g8b2bg4b2bgaf8cgfd2410d42c4a"
msgid "It's none of my business, of course. I wouldn't want to intrude."
msgstr "물론, 내가 상관할 일은 아니지. 방해할 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 721b932a-8b37-39b8-448a-fff11c06ba33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:721b932a-8b37-39b8-448a-fff11c06ba33
msgctxt "hc2c7ed50g1f0dg4c6cg861bg4f080a551c62"
msgid "It's not that bad. Think of all the all goblins you killed."
msgstr "그렇게 나쁘진 않아. 네가 죽인 그 모든 고블린을 생각해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 753a8882-6399-1b77-3c1b-9a84fff22346
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:753a8882-6399-1b77-3c1b-9a84fff22346
msgctxt "h91ea400bg6bfdg40b6gb701ga7997dae93f6"
msgid "No, Astarion. It's not happening."
msgstr "아니, 아스타리온. 그럴 일은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 76d92a2f-4dfa-1126-ec15-7f1f386e2c07
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_AstarionRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:76d92a2f-4dfa-1126-ec15-7f1f386e2c07
msgctxt "h04852622g2684g49ccg8a59g91600bc85b7e"
msgid ""
"Anyway, don't let me keep you. I'm sure you have someone else to sniff "
"around. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 776359d7-027e-15b0-01b1-88e8c05b7583
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_HasPartner(1) = True
#.     - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:776359d7-027e-15b0-01b1-88e8c05b7583
msgctxt "hba49502eg285dg437bgaf43g7b95018d5242"
msgid "Indeed you will, my love. Indeed you will."
msgstr "물론이지, 내 사랑. 당연히 그래야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 77c149db-74e0-2fb8-6a3d-ee9611bfe878
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:77c149db-74e0-2fb8-6a3d-ee9611bfe878
msgctxt "h9a071395g5c8cg41b3ga75bgfa9201b855eb"
msgid "I'm not sure. Let me get back to you."
msgstr "아직 잘 모르겠어. 다시 돌아와서 얘기해 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 7aa6e9b6-0ff2-9cd0-a935-f745c71a1af8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:7aa6e9b6-0ff2-9cd0-a935-f745c71a1af8
msgctxt "ha0017736g803ag4deag9581g7ff53b631926"
msgid "By the hells. Sex. Passion. <i>Fun.</i>"
msgstr "이런 세상에. 당연히 섹스. 열정. <i>재미지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 7ae3c729-2111-ec30-6e8e-9c92b786a054
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:7ae3c729-2111-ec30-6e8e-9c92b786a054
msgctxt "h62b170dfgbea2g4686ga18dg1bf84cf56966"
msgid "Maybe. If you say 'please.'"
msgstr "'제발'이라고 말하면 생각해볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 7d08ebe4-eb46-2062-ba65-63d1205d0137
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:7d08ebe4-eb46-2062-ba65-63d1205d0137
msgctxt "h554b6904g2d5cg4b17g9c7dgaa97a4c809c5"
msgid "You're eager, aren't you? But we need to wait a little longer."
msgstr "아주 안달이 났구나? 하지만 좀 더 기다려야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 7e03ded4-3e41-b93f-65ba-15d4364e2388
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:7e03ded4-3e41-b93f-65ba-15d4364e2388
msgctxt "he15d5f50g7a43g4efegbf62gbe5e5f9db605"
msgid "A bed and so much more."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 7e68ff18-0c72-cfe4-7737-6dd23cb10d01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:7e68ff18-0c72-cfe4-7737-6dd23cb10d01
msgctxt "h405a0f23g40c4g4f2dgbf38gc2411ca589c6"
msgid ""
"All right, but don't take too long. You're not the only tasty morsel around "
"here."
msgstr "알겠어, 하지만 너무 오래 기다리게 하진 마. 이 근처에 내 식욕을 당기게 하는 건 너만이 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 80faabd6-53a2-8ef0-1bea-9cb56dcb925d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:80faabd6-53a2-8ef0-1bea-9cb56dcb925d
msgctxt "h815cdde7gb298g4983gbdadgc618f3b12f3b"
msgid "Serious or not, it's something."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 91557ef6-1a49-b34a-da88-dafc536c51d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:91557ef6-1a49-b34a-da88-dafc536c51d7
msgctxt "h35216675g4be1g469agaf2eg2d99fcffbedd"
msgid "You are an insolent little pup, aren't you?"
msgstr "넌 아주 무례한 새끼 강아지구나, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 91ac487a-f4e5-37d1-1c4a-9badc6b848c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:91ac487a-f4e5-37d1-1c4a-9badc6b848c2
msgctxt "h459fc0bdg4c72g4cfdg9941gcea3b75793ef"
msgid "I'm just looking for a little more excitement. A little more fun."
msgstr "그냥 더 흥미로운 걸 찾고 있을 뿐이야. 약간의 재미 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 92b924eb-0833-c578-51cf-09ef06a0b785
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_HasPartner(1) = True
#.     - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:92b924eb-0833-c578-51cf-09ef06a0b785
msgctxt "h026aef4eg90ddg46dfgb8fdg07de57b38cf4"
msgid "Cheeky. I'll see you then."
msgstr "건방져라. 그럼, 그때 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 93967316-30b0-8eb4-6d25-2173bea3d00b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:93967316-30b0-8eb4-6d25-2173bea3d00b
msgctxt "hf43165f6g8be7g41b0g83bfg12c0d8a2763c"
msgid ""
"I'm kidding. Once everyone's asleep, I'll find you and we can have some fun."
msgstr "농담이야. 모두가 잠들면, 널 찾아갈게. 재미있게 놀자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 93d89494-3486-5679-d735-034a3bac39c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:93d89494-3486-5679-d735-034a3bac39c6
msgctxt "h6d6f8c69gc11ag4418g8ddfg9d88d160f307"
msgid "Funny, but unbecoming."
msgstr "재밌지만, 너답지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 945760e9-a4db-0daa-3de7-57d94f8de8b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:945760e9-a4db-0daa-3de7-57d94f8de8b0
msgctxt "hf7401377g8dbag43afg9fd6g2a31409c3c9c"
msgid "Never listen to your second thoughts. They always spoil the fun."
msgstr "다시 생각해 보는 건 앞으로 그만둬. 그건 재미를 망치는 일이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 94d4dfa5-1861-098e-7072-1798babd2ee4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_HasMet_Astarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:94d4dfa5-1861-098e-7072-1798babd2ee4
msgctxt "he665d4ecgf0a5g435egb398g072858ee02d8"
msgid "Do you mind? I'm very busy."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 95665dc9-8cb3-c0d2-1988-f964ee869263
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:95665dc9-8cb3-c0d2-1988-f964ee869263
msgctxt "hf546d1f8ga9c7g4b5eg808ag64a958d40782"
msgid ""
"Not at all! I was hoping for companionship and - well, maybe a little death. "
"Figuratively speaking."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 96eaf711-4226-e1f5-11a2-26c525f055ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:96eaf711-4226-e1f5-11a2-26c525f055ed
msgctxt "h79942740gea8cg4e44gbae7g97212fb52f0d"
msgid ""
"We killed some goblins to save some tieflings. The tally of lives didn't "
"change much."
msgstr "티플링들을 구하겠다고 고블린들을 죽였잖아. 결국 이러나저러나 죽을 숫자는 별반 다르지 않았을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 96eb0372-b36c-7575-a476-727254f76b28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_GalePartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:96eb0372-b36c-7575-a476-727254f76b28
msgctxt "h985fbb4dgfc28g4a45gb71cg64336f991be1"
msgid "Ha! No, my love, I'm not jealous of the walking encyclopaedia."
msgstr "하! 아니, 내 사랑, 난 걸어다니는 백과사전한테 질투가 난 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 99e93af2-7e5b-67fd-06d5-fe7a095c393e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:99e93af2-7e5b-67fd-06d5-fe7a095c393e
msgctxt "h3144d2abg8d14g4eaeg90aega7591355223f"
msgid "I'm flattered, but I think not. It's not you, you understand, it's me."
msgstr "제안은 기쁘지만, 그러지 않는 편이 좋겠어. 너 때문은 아니니, 이해해 줘. 나 때문이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 9ac265da-da6f-1b2c-fe20-00c792cc04eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_WyllPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:9ac265da-da6f-1b2c-fe20-00c792cc04eb
msgctxt "h0ac1bcdfge377g4ad3g86d6gd30235f0c78d"
msgid ""
"It's easy for some, of course. You and Wyll seem to be getting on very well."
msgstr "물론 누구한테는 쉬운 일이겠지. 윌이랑 아주 사이가 가까워 보이던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 9b719927-0aac-0ce9-38a9-f5d6402a88c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:9b719927-0aac-0ce9-38a9-f5d6402a88c8
msgctxt "h31d3125dg0a16g49e4g955bgb21dbad18b4c"
msgid "I'm sure it'll be adequate."
msgstr "물론 너희에겐 적절할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 9c74aa73-c8b8-da6c-b9bc-4feefde3db5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:9c74aa73-c8b8-da6c-b9bc-4feefde3db5d
msgctxt "h47968554gb271g46d7ga8d3g6c312bc7076d"
msgid "By all means, go and enjoy yourself."
msgstr "하, 꼭 재밌게 즐기길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 9cb21637-20a0-54ad-0bf2-5d6fb7527408
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
