msgctxt "h95918ae8ga7a7g440agb89fg2b324be1d4b2"
msgid "You misunderstand - I don't care about her at all."
msgstr "오해했구나. 난 걔는 아무런 관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 880bf83e-7ecf-576d-c625-89818ad0c0f9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteMinthara = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:880bf83e-7ecf-576d-c625-89818ad0c0f9
msgctxt "h5bc45e32g1759g4a6cgbf02g8a3da878ffb6"
msgid "You've judged my affections wrongly - I am much closer to Minthara!"
msgstr "내 감정을 잘못 재단했군. 난 민타라와 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 89c386ae-72ee-80d7-8a53-c20608780741
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:89c386ae-72ee-80d7-8a53-c20608780741
msgctxt "h6de2d019gd5d6g4e8dg98a5g5a9121cf0e21"
msgid "We are indomitable together. You underestimate us."
msgstr "우리가 함께하면 그 누구에게도 지지 않아. 넌 우리 힘을 무시하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8a161b7f-04ba-8dbc-9a5c-2b8ca40696d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8a161b7f-04ba-8dbc-9a5c-2b8ca40696d0
msgctxt "h675c451dgb245g4386ga7e0g9ada9753ea57"
msgid "What in the hells do you mean you're my <i>Butler</i>?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
msgctxt "h5cbbd404g1a0cg4daagb89eg722191e4dd12"
msgid ""
"Hate you? The coast would sooner be swallowed whole by the Sea of Swords."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
msgctxt "ha54494ebge83fg4a86g9206g1ebb660d03f5"
msgid "Pfft. Hate you? I love the <i>drama</i>. Bring it on."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
msgctxt "he14a97f8gf809g4e6cgbb96g3325cb8a856c"
msgid "Hate's too easy for my liking. Let's take the high road on this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
msgctxt "h8c6e92d1g03f3g41f0gb829g9fc5b516abf4"
msgid "I don't hate you. Because this is not you."
msgstr "널 싫어하진 않아. 이건 네가 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
msgctxt "h577fe917ge776g43f1gbf1eg2369a0124c5b"
msgid "Hate you? Don't be ridiculous. If I hated you, you'd already be dead."
msgstr "널 미워해? 헛소리 하지 마라. 내가 널 증오했다면 넌 이미 죽었을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8bbadd3e-64d6-b51c-4a2c-536aa4a356cb
msgctxt "h2cbc6ca9ga317g46a3g9a9eg256c1e967d9a"
msgid "Let's save the hate for those who deserve it. This isn't your fault."
msgstr "증오는 미움을 받아 마땅한 놈에게 해야지. 이건 네 잘못이 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 8bf26155-befe-3597-c3c6-8a8d05725d1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8bf26155-befe-3597-c3c6-8a8d05725d1b
msgctxt "h1278fc78g2cc3g42eeg9f74g71ab740ace90"
msgid "I promise I will be the person you see in me."
msgstr "네가 좋게 봐주는 만큼 나도 그런 사람이 될게. 약속해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 924fdc32-621d-9448-5859-dfdcf16ddf4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:924fdc32-621d-9448-5859-dfdcf16ddf4b
msgctxt "h38135916ge856g4328ga85cg2b9462fb6960"
msgid ""
"I do not doubt you will act with the decorum befitting one of your rank."
msgstr "신분과 지위에 걸맞는 몸가짐과 행동을 보여주리라 믿어 의심치 않겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 929d3ca1-8663-0378-0686-81fc6cfb361d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:929d3ca1-8663-0378-0686-81fc6cfb361d
msgctxt "ha8d27b9egb26bg4ce6ga2ccg41d3ac544258"
msgid "You don't have to shoulder this burden alone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 929d3ca1-8663-0378-0686-81fc6cfb361d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:929d3ca1-8663-0378-0686-81fc6cfb361d
msgctxt "h7fa3f4bege4a0g4764gb4f7g6782a926dd95"
msgid ""
"We'll get through this. Like two roaches in an apocalypse, mind, but still. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 929d3ca1-8663-0378-0686-81fc6cfb361d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:929d3ca1-8663-0378-0686-81fc6cfb361d
msgctxt "hf4cd3d1eg4c97g427fga56dgeb3c4265d99b"
msgid "Chin up. We'll best this... well, whatever it is."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 929d3ca1-8663-0378-0686-81fc6cfb361d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:929d3ca1-8663-0378-0686-81fc6cfb361d
msgctxt "h2504a2b6gdf76g47b7gadc2g4b7c95af517d"
msgid ""
"But whatever this is, you will get through it. And I'll be here to make sure "
"you do."
msgstr "아무튼, 이게 뭐든지 넌 떨쳐낼 거야. 난 옆에서 그걸 도울 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 929d3ca1-8663-0378-0686-81fc6cfb361d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:929d3ca1-8663-0378-0686-81fc6cfb361d
msgctxt "ha87e2a8bg7d3ag4ce2g8218gcbe1c908b6d4"
msgid "Now - a new dawn has come, with new victories to claim."
msgstr "자, 이제 새로운 날이 밝았다. 새로운 승리를 쟁취할 시간이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 929d3ca1-8663-0378-0686-81fc6cfb361d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:929d3ca1-8663-0378-0686-81fc6cfb361d
msgctxt "h4a864033g53bfg499bg9bdcgb1966e3c341d"
msgid ""
"We'll best this - just think positively. Or at least... don't think "
"murderously."
msgstr "우린 이 문제를 해결할 거니까, 그냥 긍정적인 생각을 해. 아니면 적어도... 살인 생각만 하지 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 92fbf8c1-3bdb-b180-760c-93496c172a46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:92fbf8c1-3bdb-b180-760c-93496c172a46
msgctxt "h2308d5c1g422dg4b1egab1eg8069f1cfec56"
msgid "*You return to your bedroll, and sleep like the dead.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 92ff056b-461f-e62c-ffae-8f0eeabb86f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:92ff056b-461f-e62c-ffae-8f0eeabb86f0
msgctxt "h3d146581g8434g4da0gb7a5ga3006f98ee23"
msgid ""
"Why not whisper it while you twist a knife? Or have a love confession be the "
"final words between you?"
msgstr "칼을 비틀면서 속삭이면 되지 않습니까? 아니면 죽기 전 마지막 한 마디로 사랑을 고백한다든지요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9512b079-86d8-5f53-7b7c-0fd8306968e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9512b079-86d8-5f53-7b7c-0fd8306968e4
msgctxt "h2bd4e899g12c8g4f25gbb39g5a2afca19cbf"
msgid "<i>Ready yourself to attack.</i>"
msgstr "<i>공격을 준비한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 955f242a-bcec-48af-9f0c-de414119eef0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:955f242a-bcec-48af-9f0c-de414119eef0
msgctxt "ha3c5574eg4d69g4165gbb75g81e990b05e98"
msgid ""
"You are a champion. If this foe demands blood, then tear off its limbs and "
"let it drink its own!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 955f242a-bcec-48af-9f0c-de414119eef0
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:955f242a-bcec-48af-9f0c-de414119eef0
msgctxt "h54d968c3g97ffg416eg9457g373bd2c7e232"
msgid "Bloodlust has made a poet of you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 955f242a-bcec-48af-9f0c-de414119eef0
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:955f242a-bcec-48af-9f0c-de414119eef0
msgctxt "h783659bcg6134g480ag9b5fg1040081d6e7a"
msgid ""
"No, no clotting. I like my blood flowing in my veins, thank you most kindly."
msgstr "어허, 엉기는 건 안 돼. 난 피가 혈관 따라 흐르는 게 좋다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 955f242a-bcec-48af-9f0c-de414119eef0
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:955f242a-bcec-48af-9f0c-de414119eef0
msgctxt "h3e980815g0c4eg4bb4gaaa4g17b9499b7590"
msgid "A little late, but good effort. Now just relax, dawn will be here soon."
msgstr "좀 늦긴 했지만 아주 열심이네. 이제 곧 새벽이 밝아 올 테니, 긴장 풀어도 돼. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 955f242a-bcec-48af-9f0c-de414119eef0
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:955f242a-bcec-48af-9f0c-de414119eef0
msgctxt "hfea56671g27a6g473fga809g806b6fca4b12"
msgid ""
"Spill one drop of my blood, and yours will flow like a river. Now get it "
"together!"
msgstr "내 피를 한 방울이라도 흘렸다간 네 피가 강처럼 흐를 거다. 그러니까 정신 차려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 955f242a-bcec-48af-9f0c-de414119eef0
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:955f242a-bcec-48af-9f0c-de414119eef0
msgctxt "heb3e1dccg1720g47b2g895age586457f4d43"
msgid ""
"Quite an imagination. Try applying it to some <i>peaceful </i>thoughts. I "
"know you can."
msgstr "상상력이 풍부하네. 그걸로 대신 <i>평화로운</i> 생각을 떠올려 봐. 할 수 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 99d5bb5c-06e5-5740-b13c-458eec0f8da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:99d5bb5c-06e5-5740-b13c-458eec0f8da0
msgctxt "h59fbb48dga7f4g4c81gbb4ag5d139cea8923"
msgid "I've been cursed. When I fall asleep, I will try to murder you."
msgstr "난 저주받았어. 내가 잠드는 순간, 널 죽이려 들 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9c6d3513-1230-a364-5f08-f522906d0030
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9c6d3513-1230-a364-5f08-f522906d0030
msgctxt "h8992931bg96a3g4f50g921ag4e35e1852fc9"
msgid "It is. You are my greatest adventure -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9c6d3513-1230-a364-5f08-f522906d0030
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9c6d3513-1230-a364-5f08-f522906d0030
msgctxt "hfa7d1c7dg32b8g43d0ga620ge7d62d974b2f"
msgid ""
"To be honest, the thought of holding you down while you try to rip my throat "
"out is kind of wonderful."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9c6d3513-1230-a364-5f08-f522906d0030
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9c6d3513-1230-a364-5f08-f522906d0030
msgctxt "h3fe55e2ege22dg42b6g9dcfg752a6350d679"
msgid ""
"Let's not throw the murderous baby out with the bathwater - it's not <i>all "
"right</i>, but it's what I'm willing to do. For you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9c6d3513-1230-a364-5f08-f522906d0030
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9c6d3513-1230-a364-5f08-f522906d0030
msgctxt "hc8f6f045gee9bg4b88gbd28gaff0c0f2a851"
msgid "Well no, you tried to kill me, of course it's not all right."
msgstr "음, 아니. 날 죽이려 했잖아. 괜찮진 않지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9c6d3513-1230-a364-5f08-f522906d0030
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9c6d3513-1230-a364-5f08-f522906d0030
msgctxt "hcd234f55gc0e6g47c1ga846g8f37c5ea3fb8"
msgid "Certainly not. But you didn't leave any unwanted bruises last night."
msgstr "그럴 리가. 하지만 밤새 내게 원하지 않는 상처를 입히진 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9c6d3513-1230-a364-5f08-f522906d0030
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9c6d3513-1230-a364-5f08-f522906d0030
msgctxt "h45d95934g69eag4e02g80f8gf1223b7b8615"
msgid ""
"I won't quite say that - far from it. But you and I have a bond. I can't let "
"a little bloodlust ruin that."
msgstr "그 정도까지는 아니지. 괜찮을 리가. 하지만 우린 서로 인연이잖아. 살의가 조금 생겼다고 그걸 망칠 수는 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9d73f2cd-0a53-0a21-5069-78406ecf7259
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9d73f2cd-0a53-0a21-5069-78406ecf7259
msgctxt "h592b8256g842ag4fc6g924eg026c9db77a78"
msgid ""
"Your clever mind is penning tragedy as we speak. Your repressed Urge yearns "
"to kill."
msgstr "주인님의 영특한 정신은 우리가 말하고 있는 지금도 비극을 써내려가고 있답니다. 주인님의 억눌린 충동이 살육을 원하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9e1a1956-c82f-97e5-f99d-ab722adfa7c5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9e1a1956-c82f-97e5-f99d-ab722adfa7c5
msgctxt "h981085ddg179dg4625g91d0g91193382873a"
msgid "<i>Try to bite him.</i>"
msgstr "<i>눈앞의 남자를 물어뜯는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9e1a1956-c82f-97e5-f99d-ab722adfa7c5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9e1a1956-c82f-97e5-f99d-ab722adfa7c5
msgctxt "hd5b7b2dcgbebbg4dc0ga456g1e1d1f3364ba"
msgid "<i>Try to bite her.</i>"
msgstr "<i>눈앞의 여자를 물어뜯는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9f1ae732-6b2f-36b1-f522-4a184a420067
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9f1ae732-6b2f-36b1-f522-4a184a420067
msgctxt "h54a4e083ga4aag4891g975ag909b2f1208de"
msgid ""
"There comes a time where every precious young Master must triumph over "
"scrutiny."
msgstr "어린 주인님이라면 응당 면밀한 검토를 거쳐 합격해야 하는 관문이 있습죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 9ff73f14-86f6-aab0-e8cd-0237a67e770d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:9ff73f14-86f6-aab0-e8cd-0237a67e770d
msgctxt "h9c5f3e91g9b4bg4585g8b3ag398f265c8b2e"
msgid "<i>Spend a while admiring the pretty corpse of your dead darling.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a413a2a9-4ac0-8dd8-3122-73538d1c07d1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a413a2a9-4ac0-8dd8-3122-73538d1c07d1
msgctxt "hcfaed499g0adeg4a6dgb45eg5e15bb1a53a1"
msgid ""
"You are not the before. You are the now, you are the later. If your past is "
"so diseased, let it wither and plant something new."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a413a2a9-4ac0-8dd8-3122-73538d1c07d1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a413a2a9-4ac0-8dd8-3122-73538d1c07d1
msgctxt "h5052d6a1g99d0g4e97ga8a6g924486421269"
msgid ""
"It's bad. I won't say it isn't. But... I've done worse. Powers beyond our "
"control picked us to do their dirty work - that isn't our fault."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a413a2a9-4ac0-8dd8-3122-73538d1c07d1
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a413a2a9-4ac0-8dd8-3122-73538d1c07d1
msgctxt "h40f5a64ag76b1g4644gb365g4c259726c971"
msgid ""
"Few have an unblemished history. You must better yourself, not condemn "
"yourself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a413a2a9-4ac0-8dd8-3122-73538d1c07d1
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a413a2a9-4ac0-8dd8-3122-73538d1c07d1
msgctxt "hf0a185d1g842eg4f61gbe90g03bae5d4d2a1"
msgid ""
"If anyone understands an internal voice forcing your hand, I do. But that's "
"not who we are now. We make our own choices, and you made the right one last "
"night."
msgstr ""
"머릿속의 목소리가 강제로 행동하게 하는 거라면, 나도 잘 알아. 하지만 우린 이제 그럴 일 없잖아. 우리 스스로 결정을 내릴 수 있어. "
"넌 어젯밤 옳은 결정을 한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a413a2a9-4ac0-8dd8-3122-73538d1c07d1
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a413a2a9-4ac0-8dd8-3122-73538d1c07d1
msgctxt "h4698a726g734ag4d7bgb4f4g03b43e1c3a20"
msgid ""
"You craved for blood. There needn't be shame in that. You may even carry a "
"grain of pride."
msgstr "넌 피를 갈구했지. 그걸 부끄러워할 필요는 없어. 차라리 자부심을 가져라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a413a2a9-4ac0-8dd8-3122-73538d1c07d1
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a413a2a9-4ac0-8dd8-3122-73538d1c07d1
msgctxt "hd205d90ege732g4dbdg9edcg3e5a39f48ff6"
msgid "That person's a stranger to me. Don't torment yourself with the past."
msgstr "내가 아는 너는 그 사람이 아니야. 과거로 자책하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = a43a34ac-4cf9-5e52-897d-bcc87c84ae12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a43a34ac-4cf9-5e52-897d-bcc87c84ae12
msgctxt "h5b58bf5cg4b50g4207g92a1ga5e5283960d6"
msgid "She came all the way to this world, just to die here."
msgstr "이 세계까지 먼 길을 와서, 이런 곳에서 죽게 되다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a61f709a-5f00-8324-b869-1e90cf8f70b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a61f709a-5f00-8324-b869-1e90cf8f70b0
msgctxt "h29242aa6g0079g4018ga239g0dcbbaefe5c4"
msgid "I can control myself."
msgstr "난 내 자신을 통제할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = a6858676-8fd5-75e9-ab43-c3457f6f606d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a6858676-8fd5-75e9-ab43-c3457f6f606d
msgctxt "h841f93fageac2g4413g94e4g975502e701de"
msgid "<i>Sob over the body.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = a802c153-9aef-957b-2a70-475ed24d9a0e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteShadowheart = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:a802c153-9aef-957b-2a70-475ed24d9a0e
msgctxt "h97781d0eg9563g4344g8786g3327c256ff29"
msgid "You've judged my affections wrongly - I am much closer to Shadowheart!"
msgstr "내 감정을 잘못 재단했군. 난 섀도하트와 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = aa7ee7f3-4bbf-c34e-dfb4-a0928a27cb53
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:aa7ee7f3-4bbf-c34e-dfb4-a0928a27cb53
msgctxt "haed82315g7feeg4eb8g9f62g3f1e9fc98e9a"
msgid "You've judged my affections wrongly - I am much closer to Wyll!"
msgstr "내 감정을 잘못 재단했군. 난 윌과 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ab046deb-7eae-20be-7e36-252e79a5cbbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ab046deb-7eae-20be-7e36-252e79a5cbbc
msgctxt "h4161be8bg5529g4b5bg8546ga9fe16c4ddd7"
msgid ""
"There was much disappointment at your reluctance to kill the little "
"Moonmaiden."
msgstr "그 꼬마 달처녀를 죽이는 것을 망설이신 것에 다들 어찌나 실망했는지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ab6ef305-85f7-6d96-30cc-d32b31f13d82
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ab6ef305-85f7-6d96-30cc-d32b31f13d82
msgctxt "h1902449fg149dg4652g9611g9e3c47513bc5"
msgid ""
"Harming me will not aid him in the slightest. Nothing will at this point."
msgstr "절 해친다 해도 저 남자에게는 아무런 도움이 안 될 겁니다. 이제는 그 무엇도 구할 수 없죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ab6ef305-85f7-6d96-30cc-d32b31f13d82
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ab6ef305-85f7-6d96-30cc-d32b31f13d82
msgctxt "hd3b122dega346g45f6g9a85g0dec99f5b320"
msgid ""
"Harming me will not aid her in the slightest. Nothing will at this point."
msgstr "절 해친다 해도 저 여자에게는 아무런 도움이 안 될 겁니다. 이제는 그 무엇도 구할 수 없죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ad2b6802-de70-4a04-6d36-33bcd453768a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ad2b6802-de70-4a04-6d36-33bcd453768a
msgctxt "h2c34401cg1505g4dc4g8cd5g41c913b68d80"
msgid ""
"Master, I am a professional. I've seen the two of you together. Every one of "
"your darkest desires craves him."
msgstr "주인님, 전 전문가랍니다. 두 분이 같이 있는 모습을 봤어요. 당신의 깊고 어두운 욕망이 저 남자를 원하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ad2b6802-de70-4a04-6d36-33bcd453768a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ad2b6802-de70-4a04-6d36-33bcd453768a
msgctxt "h39457d55ge787g4a22g98cag459524f64bff"
msgid ""
"Master, I am a professional. I've seen the two of you together. Every one of "
"your darkest desires craves her."
msgstr "주인님, 전 전문가랍니다. 두 분이 같이 있는 모습을 봤어요. 당신의 깊고 어두운 욕망이 저 여자를 원하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = adcf7f31-a63c-66a8-1658-3bca6c83ca2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:adcf7f31-a63c-66a8-1658-3bca6c83ca2d
msgctxt "hf290e87bg2dafg4571g94a8g8e2ba950f36c"
msgid "<i>Growl.</i>"
msgstr "<i>으르르.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = adfd2d88-b956-2a91-9579-fa35697a370e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:adfd2d88-b956-2a91-9579-fa35697a370e
msgctxt "hb1ef2788g23bcg44d4g9f67g802ec5bbd42a"
msgid "That's it. Gather your might, slaughter the fiend that stalks you!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = adfd2d88-b956-2a91-9579-fa35697a370e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:adfd2d88-b956-2a91-9579-fa35697a370e
msgctxt "hcc0ac6c8ge02eg41b8gb7a1g9a811dfdf7c0"
msgid "GRRROOOAAAARRR!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = adfd2d88-b956-2a91-9579-fa35697a370e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:adfd2d88-b956-2a91-9579-fa35697a370e
msgctxt "hf116244dg674fg45d5g908cg5b56eeb23551"
msgid "All right, let that anger out however you see fit."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = adfd2d88-b956-2a91-9579-fa35697a370e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:adfd2d88-b956-2a91-9579-fa35697a370e
msgctxt "h4f51e622ga097g4947gbc12g22e347df5646"
msgid "Growl all you want, it won't stop the dawn. This will be over soon."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = adfd2d88-b956-2a91-9579-fa35697a370e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:adfd2d88-b956-2a91-9579-fa35697a370e
msgctxt "h159cb63dgf1bag4bd7ga99cg5954317df42a"
msgid "Enough. I am not your enemy!"
msgstr "그만. 난 네 적이 아니야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = adfd2d88-b956-2a91-9579-fa35697a370e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:adfd2d88-b956-2a91-9579-fa35697a370e
msgctxt "h10fa4d3dg9be8g49b7g8083g4784f696e533"
msgid ""
"Growling? Come on, at least use words. You're better than this - fight it."
msgstr "으르렁대? 적어도 사람 말로 하자. 넌 할 수 있잖아. 싸워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ae6721b9-d1be-b884-d607-2eecd210a893
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ae6721b9-d1be-b884-d607-2eecd210a893
msgctxt "h5ddf85e8g1adcg40e3gb5adgeb038b89835d"
msgid "Perhaps I might be stronger without such sentimental attachments."
msgstr "이런 감정적인 방해물이 없다면 내가 더 강해질지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = af9ef819-2ffc-9383-817e-8023c9572be9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:af9ef819-2ffc-9383-817e-8023c9572be9
msgctxt "h640e32e6g82a9g4f63gaa7dg9dd3b615c56a"
msgid "You are in a lot of danger. We need to act fast."
msgstr "넌 지금 위험에 처해 있어. 빨리 행동해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = b05d513a-1a97-c4c7-8429-8646277cba4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:b05d513a-1a97-c4c7-8429-8646277cba4d
msgctxt "h046ba3b4g2db1g4373g89a3g42f222754d74"
msgid "*Thoughts flittering, you prepare to be hated.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = b15de3f2-3e6a-ec44-0722-f0a51bd297e1
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:b15de3f2-3e6a-ec44-0722-f0a51bd297e1
msgctxt "h217d38a1g937bg479agab4eg202ee4e9b2a3"
msgid "You're in a romance with this character."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = b15de3f2-3e6a-ec44-0722-f0a51bd297e1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:b15de3f2-3e6a-ec44-0722-f0a51bd297e1
msgctxt "h74961d57gc255g4e36g865dgdbcbfb8d2c2d"
msgid "You misunderstand - I don't care about him at all."
msgstr "오해했구나. 난 걔는 아무런 관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = b15de3f2-3e6a-ec44-0722-f0a51bd297e1
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:b15de3f2-3e6a-ec44-0722-f0a51bd297e1
msgctxt "h6c54a28cg1392g41bbgbbc7gee620b2bb81b"
msgid "You misunderstand - I don't care about her at all."
msgstr "오해했구나. 난 걔는 아무런 관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = b6ed9948-26c0-b19a-7658-def625e29f71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:b6ed9948-26c0-b19a-7658-def625e29f71
msgctxt "hcdf187dcg5b0eg450fgbcf5g11b5821f3378"
msgid "I will scoop out those watchful eyes and toss them to the dogs."
msgstr "그 깔보는 눈깔을 뽑아내 개에게 던져주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = b8613051-4974-c23d-4933-5750b026e2b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:b8613051-4974-c23d-4933-5750b026e2b5
msgctxt "h29f87644g8ca5g42e2ga954g1fdee23453f8"
msgid "You must be joking."
msgstr "장난하자는 거냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = bbb46e81-50f3-fe02-d6b7-5f60c23fe16c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:bbb46e81-50f3-fe02-d6b7-5f60c23fe16c
msgctxt "h960055d2g31d5g493bgabc2g6d10f0e3aa9b"
msgid "Now isn't the time. I need to protect you."
msgstr "그럴 시간 없어. 널 지켜야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = bbf344f5-c336-f2ca-3d5b-915b98fa8466
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:bbf344f5-c336-f2ca-3d5b-915b98fa8466
msgctxt "h8344806fg87e3g4612g9d83g7e6c521d2a1a"
msgid "Oh... sorry. I just had a bad dream. Go back to sleep."
msgstr "아... 미안. 안좋은 꿈을 꿨네. 도로 자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = bc287e87-e0e6-fcb3-9061-29c2152348de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:bc287e87-e0e6-fcb3-9061-29c2152348de
msgctxt "h5816650fg4acbg4fc3ga3bfg1f611b2d1650"
msgid "*Your companion rests blissfully, without a fear in the world.*"
msgstr "*당신의 동료는 완전히 마음을 놓은 채 편안히 잠들어 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = bc35453f-35e9-be7d-0424-c6c948273d08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:bc35453f-35e9-be7d-0424-c6c948273d08
msgctxt "h2b6109d3ge3ccg4650gbd53g7ed1c43bddb3"
msgid "I think I'll slit your throat."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = bdae77d2-b7df-de63-7ca0-ca9f60870dcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - ORI_DarkUrge_State_ConvincedSHToSpareNightsong = True
#.      - MOO_Isobel_State_AtMoonrise = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:bdae77d2-b7df-de63-7ca0-ca9f60870dcb
msgctxt "h516a0817g6481g46fbgb887g51f772b879d0"
msgid ""
"You convinced me to spare Nightsong. You and I are both capable of resisting "
"the darkness that compels us."
msgstr "밤의 노래를 살려주라고 날 설득했었지. 우리 둘 다 억압하는 어둠에 맞서 이겨낼 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = bedfd1a7-8503-8d27-7930-cf5a71ecd0d4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteGale = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:bedfd1a7-8503-8d27-7930-cf5a71ecd0d4
msgctxt "h4e65999bgfb09g4092g9cc8g3ae2c0a9e5ea"
msgid "You've judged my affections wrongly - I am much closer to Gale!"
msgstr "내 감정을 잘못 재단했군. 난 게일에게 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = bf12d134-06cc-21e7-7b53-046dcfec72a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:bf12d134-06cc-21e7-7b53-046dcfec72a8
msgctxt "hd629c6bfge23fg4894gb617g5f7bc43911c6"
msgid ""
"You must have killed me <i>hundreds </i>of times since you were a youngling. "
"I hope there will be hundreds more..."
msgstr ""
"주인님은 아주 어릴 때부터 저를 분명 <i>수백 번은</i> 넘게 죽이셨을 겁니다. 앞으로도 수백 번 더 죽을 수 있다면 좋겠군요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c14e5faa-9765-ef7b-eee6-8ef3af97f464
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c14e5faa-9765-ef7b-eee6-8ef3af97f464
msgctxt "he2833bdfgd362g44e2g826ag8b9894a6bae2"
msgid ""
"Madness - or a curse, perhaps? There must be some cure, some potion for you "
"to take."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c14e5faa-9765-ef7b-eee6-8ef3af97f464
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c14e5faa-9765-ef7b-eee6-8ef3af97f464
msgctxt "hc0c6fce9gf599g4abcga62dg4de43dc2d947"
msgid ""
"That's so sweet. And fucked up. As for whether I can stop you, I wouldn't "
"worry about that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c14e5faa-9765-ef7b-eee6-8ef3af97f464
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c14e5faa-9765-ef7b-eee6-8ef3af97f464
msgctxt "he35787c8g8340g4e67g8147g0b973d8c4a0d"
msgid "I... see? Sweet that you care enough to murder me. Mind if you don't?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c14e5faa-9765-ef7b-eee6-8ef3af97f464
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c14e5faa-9765-ef7b-eee6-8ef3af97f464
msgctxt "h7d13ae2egc957g417ag999bg63b81e4e8c01"
msgid "How flattering. And disturbing."
msgstr "우쭐해지는걸. 불안해지기도 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c14e5faa-9765-ef7b-eee6-8ef3af97f464
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c14e5faa-9765-ef7b-eee6-8ef3af97f464
msgctxt "h7e8a66d2g1c7cg4cf3ga52dg8d1f946d3b3d"
msgid "Nonsense. Bloodshed is for battle, and flattery for the triumph after."
msgstr "무슨 짓이냐. 피는 전투에서 흘리는 것이고, 아첨은 그 후의 승리 때 해야 하는 것이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c14e5faa-9765-ef7b-eee6-8ef3af97f464
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c14e5faa-9765-ef7b-eee6-8ef3af97f464
msgctxt "hbf7e47beg2b70g4dc1g88dbgba838b52aed0"
msgid "I suppose I'm flattered - and alarmed."
msgstr "그렇다고 하니 좋긴 하네. 걱정도 되고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = c1b735fb-be31-61ed-5d5b-0c3fdfc1215e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c1b735fb-be31-61ed-5d5b-0c3fdfc1215e
msgctxt "h1111a61dgcf15g421cg8e89gbd9a77b70b61"
msgid "*You drink in the sight until the dawn.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = c1dc004a-171b-012a-4d60-08daeec2762e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = False
#.      - NIGHT_DarkUrge_ButlerIntro = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c1dc004a-171b-012a-4d60-08daeec2762e
msgctxt "h55171c15g1ad8g4475g88b0g5f6a3102716b"
msgid ""
"At last! I've found the prodigal! And in what a sorry state, without your "
"Butler to guide you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = c1fca043-c5b4-5ff9-6f72-7be245f257be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c1fca043-c5b4-5ff9-6f72-7be245f257be
msgctxt "h5948fc96g03b8g46fbg8f32ge1b12dd99f39"
msgid ""
"*In the heat of the night, these last gasps are those of disappointment.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = c3827481-1c0c-d30c-bd01-ba205096c9b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c3827481-1c0c-d30c-bd01-ba205096c9b6
msgctxt "hfe63e9a9g3939g4478gb752g2ed32a31193e"
msgid ""
"I tried time again to find you, after you became indisposed. Your "
"inheritance is waiting, and I am waiting to grant it to you, if you do one "
"little thing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c3fec33a-bd4b-db0e-14ae-8f6ace0bc306
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c3fec33a-bd4b-db0e-14ae-8f6ace0bc306
msgctxt "h90a0c887gc151g48ceg93b5g798324046308"
msgid "I wish nothing more than to cut you up and eat you raw!"
msgstr "널 토막내서 생으로 먹었으면 소원이 없겠다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c6317dc7-7d17-2d18-e092-1585d4b158ee
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c6317dc7-7d17-2d18-e092-1585d4b158ee
msgctxt "h9f27d286g5f0bg429cg8824gc46b3e1b5335"
msgid "Hey. Hey! Stay with me!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c6317dc7-7d17-2d18-e092-1585d4b158ee
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c6317dc7-7d17-2d18-e092-1585d4b158ee
msgctxt "h7c5c745ag2cc5g4579gb40cgebe47413fe11"
msgid ""
"Attention, soldier! You do <i>not </i>have permission to freak the fuck out "
"right now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c6317dc7-7d17-2d18-e092-1585d4b158ee
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c6317dc7-7d17-2d18-e092-1585d4b158ee
msgctxt "h4f78a52dg7a5dg46cbg9d0bg50f46dda0a1a"
msgid ""
"Easy there... Your mind is your own, as are your limbs. Don't do anything "
"rash."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c6317dc7-7d17-2d18-e092-1585d4b158ee
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c6317dc7-7d17-2d18-e092-1585d4b158ee
msgctxt "hf32dde6dgc525g4991g9166g1be20d2b4078"
msgid "Keep it together, or so help me..."
msgstr "정신 똑바로 차려라. 안 그러면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c6317dc7-7d17-2d18-e092-1585d4b158ee
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c6317dc7-7d17-2d18-e092-1585d4b158ee
msgctxt "hc1b12f0egae71g4b99g80b6g104afa2cc1c9"
msgid "Keep calm. Breathe. Come back to me."
msgstr "진정해. 숨 쉬고. 내게 돌아와 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c6317dc7-7d17-2d18-e092-1585d4b158ee
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c6317dc7-7d17-2d18-e092-1585d4b158ee
msgctxt "h43a3a613ge1cag406eg9503gd9b8afdec594"
msgid "This thing won't have you. It won't win."
msgstr "이게 널 삼킬 순 없어. 넌 이겨낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = c640303b-47c9-c3b0-5cc6-cdd118103d18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c640303b-47c9-c3b0-5cc6-cdd118103d18
msgctxt "h5913c5b3gb05fg4221ga9a1gb321ee7dedbb"
msgid "He thinks he might end the world. But you and I could do far worse."
msgstr "자신이 세상을 끝낼 것이라고 생각하지만, 우리라면 훨씬 더 심한 짓도 할 수 있잖습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c75cf749-0acd-8df1-be4b-08c70ff29930
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c75cf749-0acd-8df1-be4b-08c70ff29930
msgctxt "h8458c97eg48bfg40b3gbae9g67a313953d3c"
msgid "He is my closest friend. It could never happen."
msgstr "내 친구야. 그럴 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c75cf749-0acd-8df1-be4b-08c70ff29930
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c75cf749-0acd-8df1-be4b-08c70ff29930
msgctxt "h9fac49f8gefe9g4bdeg9008g5c836f389866"
msgid "She is my closest friend. It could never happen."
msgstr "내 친구야. 그럴 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c793559a-6290-ea9a-216d-b7acf38f579f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c793559a-6290-ea9a-216d-b7acf38f579f
msgctxt "h14c61dc9g4999g44c4g9452gfd0e8946e4fe"
msgid ""
"And what is an adventure without monsters to slay, and toasts to be made "
"after?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c793559a-6290-ea9a-216d-b7acf38f579f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c793559a-6290-ea9a-216d-b7acf38f579f
msgctxt "hfc2ae8b4gdb76g4789g91d0gb58dfa5b0aa4"
msgid "I can take you at your worst. With pleasure."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c793559a-6290-ea9a-216d-b7acf38f579f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c793559a-6290-ea9a-216d-b7acf38f579f
msgctxt "h3c8b8f01g75bcg4805gace9g31cb69f4257e"
msgid ""
"This is a rather high-risk romance we've embarked upon, isn't it? Brings new "
"meaning to the term 'strange bedfellows'."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c793559a-6290-ea9a-216d-b7acf38f579f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c793559a-6290-ea9a-216d-b7acf38f579f
msgctxt "h054d1133gb473g4d9agbde9ga42b48cd87ce"
msgid ""
"But nothing is ruined either. After all, what's a little attempted murder "
"between friends?"
msgstr "하지만 그렇다고 감정이 상하거나 한 건 아니야. 뭐, 친구 사이에 살인 미수도 있고 하는 거지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c793559a-6290-ea9a-216d-b7acf38f579f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c793559a-6290-ea9a-216d-b7acf38f579f
msgctxt "h50277b6bg388bg460cgb065g0b4a1f653684"
msgid "<i>Consensual</i> bruises? Those can be negotiated."
msgstr "하지만 <i>원해서 만드는</i> 상처라면? 그건 상황을 봐서 가능해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = c793559a-6290-ea9a-216d-b7acf38f579f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:c793559a-6290-ea9a-216d-b7acf38f579f
msgctxt "h4c516be4g89c0g4654g9937gc765e80fbe7c"
msgid ""
"I'm sure someone will write a romantic ballad about this one day - hopefully "
"not a tragic one."
msgstr "이거 나중에 누가 사랑 노래를 쓰기 딱 좋은 소재같은데... 슬픈 사랑 노래만 아니었으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ca8ef0d2-f496-87b5-04ff-dc8eec234c36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ca8ef0d2-f496-87b5-04ff-dc8eec234c36
msgctxt "h58c0145ag6b98g4aa8gbae7gd28f1273ae71"
msgid ""
"It will be the most perfect, most brutal death in your long career. Even "
"from before your little indisposition."
msgstr "주인님의 기나긴 생애에서 가장 완벽하고도 잔혹한 죽음이 될 겁니다. 그 불편한 질환을 앓기 전의 업적까지 포함해서 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ccf8d862-93b4-cde6-1f0e-54f29409344f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ccf8d862-93b4-cde6-1f0e-54f29409344f
msgctxt "h5049bd44g6504g4411g9bf5ge41186176e93"
msgid ""
"I also tend to your grounds, manage your estate, arrange murder victims for "
"you to systematically brutalise, and serve dinner."
msgstr ""
"저는 집사 노릇을 하면서 주인님의 터전도 보살피고, 영지도 관리하고, 주인님께서 체계적으로 잔악무도하게 살인을 벌이실 수 있게 피해자들을 "
"마련하고, 저녁 식사 시중도 든답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = cf095938-c386-5fdf-673f-ce6ef658ec30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:cf095938-c386-5fdf-673f-ce6ef658ec30
msgctxt "h0c0eb415g185cg46acgba29g080fbd32613b"
msgid "I think I will..."
msgstr "그래야겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = d0404cd2-dfc1-5fd9-c356-32567db11536
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d0404cd2-dfc1-5fd9-c356-32567db11536
msgctxt "ha1563d4dg5cb9g4503ga354gbba51e08365a"
msgid "*You are not yourself. All control is gone.*"
msgstr "*이제 더는 당신의 몸이 아닙니다. 통제가 불가능합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = d07f124e-a52b-3175-34ef-1a0c63ecc717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d07f124e-a52b-3175-34ef-1a0c63ecc717
msgctxt "h48200ff1gd5ddg470fg902dge70cc8502f4a"
msgid "I am here to watch your moment of triumph, my loathly Master."
msgstr "당신이 승리하는 순간을 목격하러 왔습죠, 경멸스러운 주인이시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d16f77a1-52ca-f12c-eff6-ebba193d9103
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d16f77a1-52ca-f12c-eff6-ebba193d9103
msgctxt "h2e8d1be8g8733g40b2gb3f9g6fb2d8b2ef11"
msgid "You wouldn't - you <i>couldn't</i>. Could you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d16f77a1-52ca-f12c-eff6-ebba193d9103
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d16f77a1-52ca-f12c-eff6-ebba193d9103
msgctxt "h45fd999ag280dg44c2ga376g506701c4c2a7"
msgid "Driving you that mad, am I?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d16f77a1-52ca-f12c-eff6-ebba193d9103
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d16f77a1-52ca-f12c-eff6-ebba193d9103
msgctxt "h7f43a21fg472fg42b2g93a1g8b9c1618ef88"
msgid ""
"Why, I've shared my heart with you. And I'd truly rather you didn't skewer "
"it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d16f77a1-52ca-f12c-eff6-ebba193d9103
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d16f77a1-52ca-f12c-eff6-ebba193d9103
msgctxt "h29b490a7g7ac2g4c9bg8c17gbcfd37188da2"
msgid ""
"I'd rather be the only dark power inside your body, if it's all the same to "
"you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d16f77a1-52ca-f12c-eff6-ebba193d9103
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d16f77a1-52ca-f12c-eff6-ebba193d9103
msgctxt "hbb13a28ag3ffbg4d5fgae94g6638e6a8e84d"
msgid ""
"Raise a hand against me, and even a lover would not live to speak the tale."
msgstr "날 공격했다간, 아무리 연인이라도 목숨을 부지하지 못할 거라는 걸 명심해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d16f77a1-52ca-f12c-eff6-ebba193d9103
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d16f77a1-52ca-f12c-eff6-ebba193d9103
msgctxt "h7c61325cg44e8g43ddg8e6dg47df2d752bb3"
msgid "Hells, what I wouldn't give for a boring lover sometimes."
msgstr "어휴, 좀 시시하고 지루한 연인이면 좀 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d1d4aa05-c415-f2f1-72b2-151c7ad4c469
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d1d4aa05-c415-f2f1-72b2-151c7ad4c469
msgctxt "h24502538g1320g4d1egadd4g371d1d5a1226"
msgid ""
"And next time you're in a killing mood, let me know. I'll point you in the "
"right direction."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d1d4aa05-c415-f2f1-72b2-151c7ad4c469
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d1d4aa05-c415-f2f1-72b2-151c7ad4c469
msgctxt "h2bb2ac7cg41f1g4189gad32g0f30d34901d7"
msgid "You sure keep me on my toes, don't you? S'why I keep you around."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d1d4aa05-c415-f2f1-72b2-151c7ad4c469
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d1d4aa05-c415-f2f1-72b2-151c7ad4c469
msgctxt "hb6859c5cgd877g426dga841g6048b1b95a5c"
msgid ""
"At least there's no shortage of enemies out there for you to kill. A "
"veritable feast for the violent-at-heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d1d4aa05-c415-f2f1-72b2-151c7ad4c469
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d1d4aa05-c415-f2f1-72b2-151c7ad4c469
msgctxt "h9715b6d2g2d1fg465dg9b0fg83de7a8fc88b"
msgid ""
"Anyway, it's a brand-new day. I'm sure we'll find <i>lots </i>of people for "
"you to kill."
msgstr "이제 새로운 날이잖아. 분명 네가 죽일 사람도 <i>잔뜩</i> 만나겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d1d4aa05-c415-f2f1-72b2-151c7ad4c469
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d1d4aa05-c415-f2f1-72b2-151c7ad4c469
msgctxt "h67f6ec38g4a1ag4504g9417g36b022b25fff"
msgid "So let's get to claiming them, before someone else beats us to it."
msgstr "그러니 어서 쟁취하러 나서자. 다른 놈에게 빼앗기기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d1d4aa05-c415-f2f1-72b2-151c7ad4c469
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d1d4aa05-c415-f2f1-72b2-151c7ad4c469
msgctxt "h4cd75fbcg8011g446agb4aag22410e1767f8"
msgid ""
"Besides, there's plenty of foes out there for you to vent your impulses on."
msgstr "그리고, 어차피 저 밖에는 네가 충동을 풀 적들이 많이 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = d665bfed-f34a-fb89-b4f1-44f06d48dc67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d665bfed-f34a-fb89-b4f1-44f06d48dc67
msgctxt "h73206e79g23d0g4c26g8d86g34e332eba251"
msgid "*This is far more thrilling than your nights together ever could be.*"
msgstr "*둘이 아무리 같이 밤을 보낸다 한들, 이만한 환희는 결코 느낄 수 없었을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d6aa5260-0e68-da19-cc56-500b79090baa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d6aa5260-0e68-da19-cc56-500b79090baa
msgctxt "he39c91e6g11aag4738gba8dg468a072339be"
msgid "The bruises I will give you shall gorge themselves on your blood."
msgstr "네가 피투성이가 될 때까지 멍들게 해주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d77e272a-b381-0fe5-dff4-74c9b234126e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d77e272a-b381-0fe5-dff4-74c9b234126e
msgctxt "hc875126fgca3fg4db2g97f7g648cd0ad2055"
msgid "I will save him, whatever it takes."
msgstr "꼭 구할 거야. 무슨 수를 써서라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = d77e272a-b381-0fe5-dff4-74c9b234126e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d77e272a-b381-0fe5-dff4-74c9b234126e
msgctxt "hc3e4e8f5g6247g4bdag9728g33564eb2fc2d"
msgid "I will save her, whatever it takes."
msgstr "꼭 구할 거야. 무슨 수를 써서라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = d9dd784e-36be-2830-25b4-077cf7c53ba4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteAstarion = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:d9dd784e-36be-2830-25b4-077cf7c53ba4
msgctxt "hd76adcc5gfbccg4d5ag8b2egcd9c17ff23ca"
msgid "You've judged my affections wrongly - I am much closer to Astarion!"
msgstr "내 감정을 잘못 재단했군. 난 아스타리온과 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = db7713ad-f37f-df32-6ff3-d5f523b5efee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Isobel_State_AtMoonrise = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:db7713ad-f37f-df32-6ff3-d5f523b5efee
msgctxt "h2c3f88cdgb949g417eg80d0gfb5a1f2f64a3"
msgid "I am planning to kidnap Isobel. Alive."
msgstr "이소벨을 납치할 생각이야. 산 채로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = e04d7fd1-7aba-1281-9e5f-d714329edded
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e04d7fd1-7aba-1281-9e5f-d714329edded
msgctxt "h2456b202g9f9eg4d6agaf9fgaa72976a016d"
msgid "*You once again inhabit your own mind.*"
msgstr "*당신은 다시 본래 정신을 되찾습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = e23a71b4-46a8-8fde-e5b7-40766730fee5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e23a71b4-46a8-8fde-e5b7-40766730fee5
msgctxt "haa4ce663g626ag4b31gb9e1gc4da1c97fd8b"
msgid "I trust you. Gods only know if I should - but I do."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = e23a71b4-46a8-8fde-e5b7-40766730fee5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e23a71b4-46a8-8fde-e5b7-40766730fee5
msgctxt "h52f9a162gd95ag4795g9f84g1960ce6f7a2e"
msgid ""
"I've killed people too. Innocence is for the lucky. Life is dirty, and we've "
"got the stain of it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = e23a71b4-46a8-8fde-e5b7-40766730fee5
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e23a71b4-46a8-8fde-e5b7-40766730fee5
msgctxt "h6a24cf7bgc4a6g4fc1ga4e2g248ad8909ef5"
msgid ""
"That's capitulation, not a solution. Let's search for less drastic means."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = e23a71b4-46a8-8fde-e5b7-40766730fee5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e23a71b4-46a8-8fde-e5b7-40766730fee5
msgctxt "h2fc63c58g8f49g46d8g87dega152f3510336"
msgid ""
"Oh please, how many lives have you taken? Dozens? I must have brought "
"Cazador a thousand souls."
msgstr "에이, 무슨. 네가 죽인 사람이 얼마나 된다고? 열몇 명? 내가 카사도어에게 데려간 영혼을 세 보면 천 명은 나오겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = e23a71b4-46a8-8fde-e5b7-40766730fee5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e23a71b4-46a8-8fde-e5b7-40766730fee5
msgctxt "h01a34310g8a27g4becg9a74g1470faee6278"
msgid ""
"That's one solution. Someone else, I'd consider it. But you're not someone "
"else, so we'll have to find another."
msgstr "그것도 해결책이지. 다른 사람이었다면 고려했을 법한. 하지만 넌 다른 사람이 아니야. 그러니 다른 방법을 찾는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = e23a71b4-46a8-8fde-e5b7-40766730fee5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e23a71b4-46a8-8fde-e5b7-40766730fee5
msgctxt "h2550c8dcg2381g4e9agbc8eg75269bcc5415"
msgid ""
"Well, it's always an option if we're out of ideas... but let's at least try "
"to save you before it comes to that, hmm?"
msgstr "뭐, 정 수가 없으면 그것도 방법이긴 한데... 적어도 그러기 전에 다른 방법으로 널 구하려 해 보자, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = e2979ffa-64d5-bcf2-808c-3f1df1e599a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e2979ffa-64d5-bcf2-808c-3f1df1e599a4
msgctxt "h22df6278g8a6ag4407g98eagd21f224d1441"
msgid ""
"Your inheritance of your estate depends on you maintaining a healthy stream "
"of kills."
msgstr "주인님이 유산을 물려받으려면 꾸준하게 살인하는 습관을 건강하게 유지하셔야 한단 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = e3dc7149-5215-4efc-69f4-adbd5db455ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e3dc7149-5215-4efc-69f4-adbd5db455ef
msgctxt "h44eb4137g635dg41a2g83bbg7731b511336c"
msgid ""
"Have you forgotten? Whenever this frail carcass perishes, you shall always "
"be sent a fresh Sceleritas."
msgstr "혹시 잊으셨나요? 이 허약한 몸뚱아리가 아무리 여러 번 죽는들, 매번 새로운 스켈레리타스가 주인님 앞에 나타난다는 것을요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = e73d6fe8-bd56-ff9b-2c5e-f18a7f62686c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:e73d6fe8-bd56-ff9b-2c5e-f18a7f62686c
msgctxt "h79c7004cg0f8cg4579g87e2g2858de415cc6"
msgid "<i>Remain for a while in the company of the corpse.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ea71ca4c-484a-93d0-ad67-97720cdd232c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ea71ca4c-484a-93d0-ad67-97720cdd232c
msgctxt "h8c0144c0g8059g4a08ga26dg1e632b9b346a"
msgid "What in the - oh!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ea71ca4c-484a-93d0-ad67-97720cdd232c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ea71ca4c-484a-93d0-ad67-97720cdd232c
msgctxt "hb6afd474g61ebg464bga7b3g881e548e85a5"
msgid "Whoa - everything all right, soldier?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ea71ca4c-484a-93d0-ad67-97720cdd232c
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ea71ca4c-484a-93d0-ad67-97720cdd232c
msgctxt "h05729fddgdd9ag44e5g8aa0ge23301f2e636"
msgid ""
"Mmm... mmmph? Ah! What're you...? This is a truly disgusting hour to seek a "
"chin-wag, you know."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ea71ca4c-484a-93d0-ad67-97720cdd232c
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ea71ca4c-484a-93d0-ad67-97720cdd232c
msgctxt "h5532d272g4fa7g4d63g9e42gdc6981ae0dc2"
msgid "Please tell me this is important. You need my beauty sleep."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ea71ca4c-484a-93d0-ad67-97720cdd232c
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ea71ca4c-484a-93d0-ad67-97720cdd232c
msgctxt "h0a102453g00e9g4ffcg80d3gd397cdad93cf"
msgid ""
"<i>Tsk'va. </i>Don't wake a sleeping warrior without expecting a blade "
"through your belly."
msgstr "<i>츠크바. </i>잠든 전사를 그렇게 깨웠다간 배에 칼날이 박히는 수가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ea71ca4c-484a-93d0-ad67-97720cdd232c
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ea71ca4c-484a-93d0-ad67-97720cdd232c
msgctxt "h2da65bc6g8260g4f50g9ddfg7f5287563e3d"
msgid ""
"What the...? Hells, don't wake me like that. I was almost reaching for a "
"weapon."
msgstr "무슨...? 으, 그런 식으로 깨우지 좀 마. 무기를 집어들 뻔 했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ead0d78a-de54-abae-1aea-e8bf5fb16009
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ead0d78a-de54-abae-1aea-e8bf5fb16009
msgctxt "h6351907dg5f5fg4093g97e0g457df19f2908"
msgid "Whatever fiend's got hold of you, it's made a battlefield of your mind."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ead0d78a-de54-abae-1aea-e8bf5fb16009
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ead0d78a-de54-abae-1aea-e8bf5fb16009
msgctxt "hf6056bf5gf670g4deaga92fg6edbdd28b950"
msgid ""
"Whatever's happening to you will pass. It doesn't scare me. Stay with me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ead0d78a-de54-abae-1aea-e8bf5fb16009
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ead0d78a-de54-abae-1aea-e8bf5fb16009
msgctxt "h5631bb59g5eeeg4129g819bg0c846ffa1b81"
msgid "Spare me the gory details - I know you're still in there. Hold fast."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ead0d78a-de54-abae-1aea-e8bf5fb16009
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ead0d78a-de54-abae-1aea-e8bf5fb16009
msgctxt "h7817e1c2ge1a3g43e0g8fcbg2435b4acdea7"
msgid "You're cute, you know. In another life we might have been friends."
msgstr "귀엽네. 다른 삶에선 우리가 친구가 됐을지도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ead0d78a-de54-abae-1aea-e8bf5fb16009
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ead0d78a-de54-abae-1aea-e8bf5fb16009
msgctxt "h18217318g6da8g4b83g9dedg3e086ca659e4"
msgid "Deliciously feral. Now hold that Urge and save it for the battlefield."
msgstr "야생의 날 것 모습 그대로군. 이제 그 충동은 자제해 두고 전투 때 분출해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = ead0d78a-de54-abae-1aea-e8bf5fb16009
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ead0d78a-de54-abae-1aea-e8bf5fb16009
msgctxt "h27cf960bgaa13g4462g92c9gdda1d32e969b"
msgid ""
"If you've energy to flirt, you've energy to fight this thing. Stay with me, "
"I know you can."
msgstr "그렇게 작업 걸 기운이 있으면 싸워낼 기운도 있겠네. 버텨. 같이 있어 줘. 할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ed6d10e4-a393-72a7-9c36-53ec32664f8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ed6d10e4-a393-72a7-9c36-53ec32664f8d
msgctxt "h4e7663dagf9adg4584gbc48ge537ece20f5e"
msgid "Now, on to the matter at hand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = ef260575-cf85-25d7-81b8-9677fa3ee496
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteLaezel = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ef260575-cf85-25d7-81b8-9677fa3ee496
msgctxt "h00ed252bg98efg4393g9bacg8daaa5581f58"
msgid "You've judged my affections wrongly - I am much closer to Lae'zel!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = f27cc1f8-3f90-5d47-c24c-e3673e6c081c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f27cc1f8-3f90-5d47-c24c-e3673e6c081c
msgctxt "h5953f4ccgf30eg48fbg8c1dge295990488b3"
msgid ""
"It is precisely because you didn't touch her, that you are <i>insatiable</"
"i>. Your Dark Urge will have death, one way or another. Tonight."
msgstr "바로 그렇기 때문에 이렇게 <i>갈증을</i> 느끼는 겁니다. 어두운 충동은 죽음을 원해요. 바로 오늘밤 취할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f4607046-44ac-8b1b-40ef-b2b4d050fb3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f4607046-44ac-8b1b-40ef-b2b4d050fb3a
msgctxt "hbff94186g9132g457dga131g840249da92c8"
msgid "Consider it done."
msgstr "그렇게 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = f4ca5c3e-75b5-595a-8e84-e87c3c7ee0db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f4ca5c3e-75b5-595a-8e84-e87c3c7ee0db
msgctxt "haf8b5f71g0a1ag420aga7f3g3c2aaf950a54"
msgid "She thinks she is finally away from the monsters. Poor fool."
msgstr "드디어 괴물의 손아귀에서 탈출했다고 여기는군요. 딱한 바보 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = f4d3d0f1-625a-83a6-ce51-f2f2f427619d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f4d3d0f1-625a-83a6-ce51-f2f2f427619d
msgctxt "hb581df33g3605g498egb999g784bbaed313c"
msgid "*The maiming twitches consume you. You cannot talk.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f57e268b-9de8-08b2-9219-eb12a99af7f0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f57e268b-9de8-08b2-9219-eb12a99af7f0
msgctxt "h4dfca87bg5ca7g460bgbb5cga48117bc100c"
msgid "Rise up, meet its gaze. Show it no fear, and grant it no mercy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f57e268b-9de8-08b2-9219-eb12a99af7f0
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f57e268b-9de8-08b2-9219-eb12a99af7f0
msgctxt "h292bedf6g76a7g44d5g8fd5g53d06b1dcf3e"
msgid "You can do this. I've got you, and I'm not letting you go."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f57e268b-9de8-08b2-9219-eb12a99af7f0
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f57e268b-9de8-08b2-9219-eb12a99af7f0
msgctxt "hd5dbefacge19ag4ba4g966bgeb04f271b459"
msgid "Steady. You can rein this in - nobody's getting hurt."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f57e268b-9de8-08b2-9219-eb12a99af7f0
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f57e268b-9de8-08b2-9219-eb12a99af7f0
msgctxt "h55aff2c8ge5a1g4c77g9afdg6ef27610977b"
msgid "Easy now, darling. You've got this. And I've got you."
msgstr "괜찮아, 자기. 해낼 수 있어. 내가 옆에 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f57e268b-9de8-08b2-9219-eb12a99af7f0
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f57e268b-9de8-08b2-9219-eb12a99af7f0
msgctxt "hc8146140g849dg43cdgaa7egf4ded56c760d"
msgid ""
"Listen to me. Whatever this lunacy, defy it - or you will answer to my blade."
msgstr "내 말 들어. 이 미친 것이 뭐든, 거부해라. 안 그러면 내 칼에 맞을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f57e268b-9de8-08b2-9219-eb12a99af7f0
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f57e268b-9de8-08b2-9219-eb12a99af7f0
msgctxt "h613b57c9gdd7dg4a5cg9e7cg6b5c0bb74f88"
msgid "Easy. You're in control. Bloodlust won't win tonight."
msgstr "침착하게. 넌 아직 생각할 수 있어. 살의에 지지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f9347cf3-3521-080a-23ce-d307a15525f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f9347cf3-3521-080a-23ce-d307a15525f2
msgctxt "hc1920588gfb64g4f47ga564g5a5dc70ac859"
msgid "It's really all right?"
msgstr "다 괜찮은 거 맞아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = f9e388b6-b8b5-e4a5-770d-53a27ad75456
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:f9e388b6-b8b5-e4a5-770d-53a27ad75456
msgctxt "h726e585dg883fg4035gafdfg190fecea626d"
msgid "<i>Wake up the others - you may be a danger to all of them.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = fae01b65-6174-ea84-4f15-5deb0930bb0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fae01b65-6174-ea84-4f15-5deb0930bb0c
msgctxt "h3264f9beg4c84g4716gafd4gfdea094678dc"
msgid "I've killed so many people. You should end me here and now."
msgstr "난 사람을 너무 많이 죽였어. 그냥 날 이 자리에서 죽여야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = fafa4920-34f5-7cbf-a940-15eb4f37f897
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fafa4920-34f5-7cbf-a940-15eb4f37f897
msgctxt "h7262316cgc04ag4bc5gabd1g0a75f9252375"
msgid "*You grant one last caress to your dead companion.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
msgctxt "h8ce47ed2gf0dag4ee2ga4a6ge6ddd6c030a5"
msgid ""
"This is what happened with Alfira, isn't it? By Balduran's helm, if only I'd "
"known."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
msgctxt "h78e8e7afg31dag44f1gad6dgb9f16747489f"
msgid ""
"Maybe then... Alfira would still be here? But - we're <i>here </i>now. And "
"we're going to fix this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
msgctxt "hcbadfa1dg207ag446eg9d02g4624ffb9cee3"
msgid ""
"This certainly casts the butchery of Alfira in a new light... but we'll find "
"a solution for this, you and I. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
msgctxt "h4a012bf5g5032g44f5g8ac9g5ea99e1632bf"
msgid ""
"It certainly puts the death of dear, sweet Alfira into some perspective."
msgstr "불쌍한 알피라가 왜 죽었는지 이제야 이해가 좀 가네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
msgctxt "h5abda0a3g6b45g4c9eg8630g998200aca6c6"
msgid ""
"<i>Chk</i> - it might have been your hand that struck Alfira. But it was "
"this madness that guided it."
msgstr "<i>츠크</i>, 네가 알피라를 공격했던 것도, 그걸 주도한 것은 이 광기였군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb2a9359-c4e5-3e5b-3cdd-6ea63343a1fd
msgctxt "h4c1e11b5g7a75g4914gab52ge139656b387c"
msgid ""
"Suddenly Alfira's death makes a lot more sense... We're going to figure this "
"out, understand? We <i>have </i>to."
msgstr "알피라가 죽었던 게 갑자기 이해가 되네... 같이 해결하자, 알겠어? <i>반드시</i> 해결해야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = fb308ec1-9e97-9294-3a30-567c43c2fcbf
#. HandlePath = RollAdvantageReason
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb308ec1-9e97-9294-3a30-567c43c2fcbf
msgctxt "h9100f0cfgc26fg4f5egac55g814063f57d4b"
msgid "Shadowheart has faith in you"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = fb308ec1-9e97-9294-3a30-567c43c2fcbf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fb308ec1-9e97-9294-3a30-567c43c2fcbf
msgctxt "h471a7582g5bc7g4b9bga085gf5283eb9eb2c"
msgid "<i> Resist and try to express understanding.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc4d6663-4f0d-a25c-e87a-cc24457a19a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fc4d6663-4f0d-a25c-e87a-cc24457a19a6
msgctxt "heb91463eg2bedg4091g934fg747cbe501d3e"
msgid "He adores you so blindly. Like a pup. Don't you find it sickening?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc4d6663-4f0d-a25c-e87a-cc24457a19a6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fc4d6663-4f0d-a25c-e87a-cc24457a19a6
msgctxt "h925af0eegb3deg4c4bg823fgfed95bd1ef5e"
msgid ""
"She's as good as dead anyway. She won't be saved by the power of love. Not "
"yours."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc4d6663-4f0d-a25c-e87a-cc24457a19a6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fc4d6663-4f0d-a25c-e87a-cc24457a19a6
#, fuzzy
msgctxt "h700432bbg3169g492cgb69cgb65f175aedbd"
msgid ""
"You like him for more than his looks, but he will never believe that. Why "
"not make him a pretty corpse?"
msgstr ""
"주인님이 빠져든 건 그의 얼굴뿐만이 아니지만, 그 남자는 그걸 절대 믿지 않을 거예요. 그냥 예쁜 시체로 만들어 버리는 것이 어떨까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc4d6663-4f0d-a25c-e87a-cc24457a19a6
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fc4d6663-4f0d-a25c-e87a-cc24457a19a6
msgctxt "hdc474ac2g0311g4ae6gb34cgebf25d528c1b"
msgid "She is only using you. Don't you know that?"
msgstr "저 여자는 주인님을 이용하고 있을 뿐이랍니다. 모르셨나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc4d6663-4f0d-a25c-e87a-cc24457a19a6
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fc4d6663-4f0d-a25c-e87a-cc24457a19a6
msgctxt "h3155489agd78ag41a4ga22bg4845138c8a24"
msgid "He would forget his god for you. But you won't for him, of that I know."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc4d6663-4f0d-a25c-e87a-cc24457a19a6
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fc4d6663-4f0d-a25c-e87a-cc24457a19a6
msgctxt "h274f5422g17b3g4940g8842g36fb86b43409"
msgid ""
"She was starting to trust you. The only one she ever has. Pity it's coming "
"to an end."
msgstr "이제야 주인님을 믿기 시작했는데. 저 여자가 믿어본 유일한 사람이죠. 이제 그것도 끝이라니 안타깝군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fcafbf53-1088-9830-490d-24b97c687784
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fcafbf53-1088-9830-490d-24b97c687784
msgctxt "hbbdccad8g126cg4b7agb4abg940cfe11ddc8"
msgid "It is too late. You ignored your Urge, and now it is <i>insatiable</i>."
msgstr "이미 늦었습니다. 충동을 무시하셨으니, 이제 그 <i>갈증을</i> 버틸 수 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fcedb2d9-fcf5-ef11-8601-2ff7fc967a3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:fcedb2d9-fcf5-ef11-8601-2ff7fc967a3c
msgctxt "hf14ad866g95f0g4a1bga832g8d4092515b51"
msgid "I did! It felt wonderful."
msgstr "그랬습죠! 환상적인 기분이었답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = ff1063bf-53e7-3524-e3d8-00287e5ba6d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:ff1063bf-53e7-3524-e3d8-00287e5ba6d1
msgctxt "h50f7a2e3ge026g44a6ga041g61d7e1be4a82"
msgid ""
"But worry not, your loyal Butler Sceleritas Fel is here, ready to get you "
"back to behaving like a fellow of your fine breeding ought."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 01468e7f-918c-8da7-08bd-7b2474446ae9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:01468e7f-918c-8da7-08bd-7b2474446ae9
msgctxt "h0a74c5a3g47fcg4224g8f1dg1b1dd97e06f3"
msgid ""
"<i>Then... well. We live. Every second until the last. That's all there is "
"to it.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 13ebac19-fb29-9e53-78e2-f1e08ede6d4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:13ebac19-fb29-9e53-78e2-f1e08ede6d4e
msgctxt "hbcf758ddg80feg457bga49bg208e26e68fd0"
msgid "<i>Things haven't gotten </i>that <i>bad. Not yet, at least.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 1a1d5bfe-e931-cedb-3d05-90a8401efca0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitment_State_DammonUnavailable = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:1a1d5bfe-e931-cedb-3d05-90a8401efca0
msgctxt "hd879b5c0g1c81g4512g90a8g86aa663bf3fb"
msgid ""
"<i>Without a mechanic, I might need to get used to the feeling of slowly "
"burning to ash.</i>"
msgstr "<i>기계공이 없다면, 천천히 재로 타들어가는 느낌에 익숙해 질 필요가 있을 것 같아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 3fbac5ec-d28b-a3ca-5769-ea446b345c9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:3fbac5ec-d28b-a3ca-5769-ea446b345c9a
msgctxt "h6645e46cg8e41g48ebg8ac3g95cef33e4b32"
msgid "<i>Gods dammit, Zariel. Gortash. Why'd you have to pick me?</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Player
#. NodeID = 42c4d487-1543-3926-2600-ab4fdbf9a200
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:42c4d487-1543-3926-2600-ab4fdbf9a200
msgctxt "h1913836bg84ceg4252ga2ebg8dc52d1f4bbf"
msgid "It feels... awful."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 55631c46-c690-da38-b13b-cdae279628f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:55631c46-c690-da38-b13b-cdae279628f7
msgctxt "h8280d7aegdd6cg4b28gb1f4ge0aedb084a15"
msgid "<i>Better yet, I'll get my axe to ask his brain, directly.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 6b1710ce-97a0-a550-ddcd-3e3c240895a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:6b1710ce-97a0-a550-ddcd-3e3c240895a4
msgctxt "h6e0698c3gaff1g42eag9af0g6f4f3fbfc8f6"
msgid ""
"<i>But I guess it doesn't matter. Can't change the past, and right now, the "
"only thing that matters is how fucking hot this thing is getting.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 77d3903b-2bd9-0be9-d272-2a46f5a79f3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:77d3903b-2bd9-0be9-d272-2a46f5a79f3a
msgctxt "hece6b3b9gf0ceg4aceg8976geb70e3daf842"
msgid ""
"<i>I need to catch up with that mechanic. And pray he's extremely good.</i>"
msgstr "<i>그 기계공을 따라잡아야 해. 그리고 그가 엄청난 실력이 있길 빌어야지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Player
#. NodeID = 781a6fa0-3621-2849-336b-1e32f91ea4bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:781a6fa0-3621-2849-336b-1e32f91ea4bc
msgctxt "hd20af726g7a4dg42a6ga85cgaf11f1b53444"
msgid ""
"Maybe Gortash is still knocking around the city. Maybe I can <i>ask </i>him."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Player
#. NodeID = 86653774-baf8-9a4b-c22f-abe1be8f0f36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:86653774-baf8-9a4b-c22f-abe1be8f0f36
msgctxt "h77cfce08g6ad5g412fg93c9g7f51613a9b62"
msgid "I'm sure it'll be fine. It'll be fine! It'll be fine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 886a9c75-86b7-f4a3-b8b6-df2e40e8289a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:886a9c75-86b7-f4a3-b8b6-df2e40e8289a
msgctxt "h5abe074ag8890g45a9gbc57g2a5468a5db6a"
msgid "<i>My gods. That's hot. My engine's really cooking with fire.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Player
#. NodeID = 90c0f746-997f-3835-bdfd-d76907d047d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:90c0f746-997f-3835-bdfd-d76907d047d3
msgctxt "h01e6b23bg8a68g4791ga765g732bf7cc985e"
msgid "No reason. Wrong place, wrong time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 96f8700b-01b6-2008-dcfd-56666ab00a9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:96f8700b-01b6-2008-dcfd-56666ab00a9f
msgctxt "h628bce38gc9bfg4b85gae7bga9a5b6971cff"
msgid "<i>Sometimes I wish I weren't.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = 9941be08-8601-9d02-b5b2-cae89173415a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:9941be08-8601-9d02-b5b2-cae89173415a
msgctxt "h44461784g7e02g48f5g883bg0efbd21e5a97"
msgid ""
"<i>If I'd done things just a little different... if I'd seen the signs...</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Player
#. NodeID = b50b7a47-0063-c09f-44b4-4297c6d605aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:b50b7a47-0063-c09f-44b4-4297c6d605aa
msgctxt "h7d31600ag6041g46f4ga6ecg971be409d03d"
msgid "Cause I'm tough enough to take it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = b5f69edb-2449-75c4-2f26-1931669162ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachUpgraded = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:b5f69edb-2449-75c4-2f26-1931669162ec
msgctxt "h1f0dcda8gaac8g493fgb270g0eb44ffbf373"
msgid ""
"<i>I need to catch up with Dammon. See if he's thought of a way to fix this "
"thing. If it </i>can <i>be fixed.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Player
#. NodeID = bceaf53e-de4e-109f-ad9e-ef771e968b6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:bceaf53e-de4e-109f-ad9e-ef771e968b6d
msgctxt "h9c406458g4207g46b9g9105gac282a95a6f6"
msgid "Might not hurt to say a prayer or two."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = c3cc51e1-dcde-d837-7606-b9bf4182de2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:c3cc51e1-dcde-d837-7606-b9bf4182de2b
msgctxt "h7c751e5cg2127g4477g80b4g48f01f976e7d"
msgid "<i>Gods, this thing's hot. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = d50707d4-1f93-d954-8bfb-b175fff36a52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:d50707d4-1f93-d954-8bfb-b175fff36a52
msgctxt "h0dcfbdb9g9899g48e3gbc58gf87fa0489717"
msgid ""
"<i>I need to find a mechanic. A good one, or this thing's going boom.</i>"
msgstr "<i>기계공을 찾아야 해. 실력 좋은 기계공을. 아니면 큰일날거야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = d8017e0b-4144-6edc-7ca6-f8bd2dae1f40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:d8017e0b-4144-6edc-7ca6-f8bd2dae1f40
msgctxt "h48f2fa9dgdefcg49c1ga9fega9c1bb485560"
msgid ""
"<i>But if I keep thinking that way, this thing's going to burn me clean out "
"before dawn.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = dfda3504-07a0-ad4d-f5e7-7b48b82d32b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:dfda3504-07a0-ad4d-f5e7-7b48b82d32b9
msgctxt "h927cada9gb3e6g40fdgb163g1a08706f1279"
msgid ""
"<i>But I'll need to live long enough to make it to the city. That means "
"surviving a little longer.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Karlach
#. NodeID = e409269b-adb6-420d-9f07-41fdce847475
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:e409269b-adb6-420d-9f07-41fdce847475
msgctxt "h0401c023gb08eg487bga257g98ca986215ff"
msgid ""
"<i>And it might not get better. But you know what? I'm not done here yet. "
"Not yet.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach
#. Speaker = Player
#. NodeID = f63b9afb-6b48-1fe4-9d25-e03828afacbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_EngineProblems_SD_Karlach:f63b9afb-6b48-1fe4-9d25-e03828afacbe
msgctxt "h229954eegd6f0g47e3gbe77gd2ab5c2b3f8c"
msgid "There might not be a fix at all. What then?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 03a49b0c-b979-b062-e676-767751994dae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:03a49b0c-b979-b062-e676-767751994dae
msgctxt "hacf02f2dg92b1g4008g8820gcb419653484e"
msgid ""
"*Elminster's visit weighs heavy on your mind. His is a face you did not "
"expect to see again.*"
msgstr "*엘민스터의 방문이 마음 속에 무겁게 남아 있습니다. 다시 보리라 기대하지 않았던 얼굴이었지요.* "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 04b2fa2b-8027-43c6-1936-57c40c4b647a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:04b2fa2b-8027-43c6-1936-57c40c4b647a
msgctxt "h4a743260gf887g4e59gb2d5g2919613a70e1"
msgid ""
"*Whatever lies at the Heart of the Absolute, it's powerful enough to inspire "
"the fear of the gods themselves. What else could it be capable of?*"
msgstr "*절대자의 심장부에 무엇이 있든간에, 신들의 두려움을 불러일으킬 정도로 강력합니다. 다른 어떤 걸 더 할 수 있을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 0560f9b0-ab2f-a97e-4163-48b441dabe16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:0560f9b0-ab2f-a97e-4163-48b441dabe16
msgctxt "h6b4b968dg7d85g4451g9014g9cac7a7e8bac"
msgid ""
"*Elminster has served Mystra loyally for centuries. If he has any doubts, "
"he's keeping them close to his chest.*"
msgstr "*엘민스터는 몇 백년간 미스트라를 충성스럽게 섬겼습니다. 어떤 의심이 생겼다면, 가슴 속에 묻어두고 있겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = 0796b079-41f5-197e-106b-d90c0f37ef1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:0796b079-41f5-197e-106b-d90c0f37ef1e
msgctxt "h8bfd1b4fg6facg4a0fga97fg96057c5dbbcf"
msgid ""
"<i>You think on the Netherese magic affecting your tadpole. A magic Mystra "
"abhors...</i>"
msgstr "<i>올챙이에 영향을 미치고 있는 네더릴 마법에 대해 생각한다. 미스트라가 혐오하는 마법이다...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 0a7e7dad-ab2e-8e9f-b246-c14a18a40e72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:0a7e7dad-ab2e-8e9f-b246-c14a18a40e72
msgctxt "h314cc131gfcceg4ad3g9493g40796defd7fb"
msgid ""
"*While most know of Elminster the legend, few know him as you have. He "
"plucked you from obscurity. Offered you his guidance. His faith. And most "
"recently, his pity.*"
msgstr ""
"*많은 이들이 엘민스터의 전설을 알지만, 당신만큼 그를 아는 이는 드뭅니다. 엘민스터는 당신을 무지에서 건져냈습니다. 그의 지도를 "
"받았지요. 신뢰를 얻었습니다. 그리고 최근엔, 동정을 받았죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 0e52f2ee-c833-a3c9-1478-10d8ab532e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:0e52f2ee-c833-a3c9-1478-10d8ab532e03
msgctxt "hb52d420ag6c84g4d43ga27dg3e7f9b7ccda6"
msgid ""
"*'The Heart of the Absolute'... You will find it where it beats, and learn "
"<i>exactly </i>what she's afraid of.*"
msgstr ""
"*'절대자의 심장부'... 당신은 그 심장이 뛰는 곳을 찾아내어,  미스트라가 <i>정확히</i> 무엇을 두려워하는지 알아낼 것입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 16358406-81d3-dabe-2ad1-9d1b80a8da25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:16358406-81d3-dabe-2ad1-9d1b80a8da25
msgctxt "h8b5d5836ge7a1g434fgac5cg788854c1dacf"
msgid ""
"*The stakes of the task ahead are clear. The Absolute threatens more than "
"Faerûn. It threatens the goddess of magic herself.*"
msgstr ""
"*앞으로 해낼 임무의 위험은 명백합니다. 절대자는 페이룬보다 더 큰 위협을 가하고 있습니다. 마법의 여신 자신도 위협하고 있지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 44cc39f0-b68c-eb8a-d2f9-391ca23e46dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:44cc39f0-b68c-eb8a-d2f9-391ca23e46dd
msgctxt "hbb60dcffgd94fg4180gbe09g8ed0da09ca31"
msgid ""
"*Destroy the Heart of the Absolute, and you may yet turn your greatest "
"mistake into your greatest triumph.*"
msgstr "*절대자의 심장부를 파괴하면, 당신은 최악의 실수를 최고의 승리로 바꿀 수 있을지도 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 4aff4c8e-da20-0b9f-263c-33218202365c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:4aff4c8e-da20-0b9f-263c-33218202365c
msgctxt "h77fb149cg3561g443bg8d00g68965b809fdb"
msgid ""
"*Or, perhaps it's Mystra who fears she will be erased. The Heart of the "
"Absolute not only threatens mortal life. It threatens her too.*"
msgstr ""
"*아니면, 지워질까 두려워하는 쪽은 미스트라일지도 모릅니다. 절대자의 심장부는 필멸자의 삶만을 위협하지 않습니다. 미스트라도 위협하고 "
"있죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = 4e6ebfa8-0b82-93cc-643d-834260ac874c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:4e6ebfa8-0b82-93cc-643d-834260ac874c
msgctxt "h70096c3ag3dbdg4e22g8781gc4fa86b5b849"
msgid ""
"<i>His disappointment cuts deeper even than Mystra's. He was your hero...</i>"
msgstr "<i>엘민스터의 실망이 미스트라 때보다 훨씬 상처를 준다. 그는 당신의 영웅이었다...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 550ccc03-981c-5308-8244-be1c2021a367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:550ccc03-981c-5308-8244-be1c2021a367
msgctxt "h94513f32gce88g4059g8a35g64bfae215938"
msgid ""
"*When you last saw him, you were in your prime. No orb. No tadpole. A mage "
"of growing renown, all power, pride and potential - beloved by the goddess "
"of magic herself.*"
msgstr ""
"*엘민스터를 마지막으로 보았을 때, 당신은 전성기를 누리고 있었습니다. 보주 없이. 올챙이 없이. 커가는 명성, 모든 힘, 자신감과 "
"잠재력을 가지고, 마법의 여신에게까지 사랑받은 마법사였죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 6355fa77-94d8-f783-7084-1cbfabf86606
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:6355fa77-94d8-f783-7084-1cbfabf86606
msgctxt "h2a3052b3g59d7g4842gbe20g6aa3da229b97"
msgid ""
"*Mystra would no more forgive Elminster for defying her than she was willing "
"to forgive you. His hands are tied. As, it seems, are yours.*"
msgstr ""
"*미스트라는 당신을 용서하는 행위보다도 더욱 엘민스터가 거역하는 행위를 용납하지 못할 것입니다. 그의 손은 묶여 있습니다. 당신의 손도, "
"마찬가지인 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = 70654028-b626-a358-6d3d-777bc4fcbebe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:70654028-b626-a358-6d3d-777bc4fcbebe
msgctxt "habef3cceg0585g426ag9f55g975d717136c6"
msgid "<i>You wonder, did he even try to intervene on your behalf?</i>"
msgstr "<i>궁금합니다, 날 대신해 엘민스터가 개입하려고 하기는 했을까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 7b5b70e4-b69b-3709-5441-b57447e63d29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:7b5b70e4-b69b-3709-5441-b57447e63d29
#, fuzzy
msgctxt "h31729ae6gc644g402bg9b68gf6d6c0742335"
msgid ""
"*Elminster's a relic concerned only with preserving his own legend. He "
"couldn't care less if this mission would rob you of your own legacy.*"
msgstr ""
"*엘민스터는 자기 전설을 보존하는 일만 생각하는 유물 같은 사람입니다. 설령 이 임무가 당신의 과거 영광을 빼앗는대도 신경 쓰지 않겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 7e457ef7-96e5-5351-c892-00ee2744ae6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:7e457ef7-96e5-5351-c892-00ee2744ae6c
msgctxt "haf9293bagd88dg4ae0g9672gc06b71e4e2bf"
msgid ""
"*The last great threat to Mystra's role as protector of the Weave was at the "
"hands of the Netherese wizard, Karsus.*"
msgstr "*위브의 수호자라는 미스트라의 역할에 있어 마지막 큰 위협은 네더릴의 위저드, 카서스의 손 안에 있었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = 8a895f48-cd08-6fd6-f1b5-d79de215d2ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:8a895f48-cd08-6fd6-f1b5-d79de215d2ec
msgctxt "hc8508306g9e2fg4aafg97c1g49440b35c6be"
msgid "<i>You failed her once. You will not fail her again.</i>"
msgstr "<i>미스트라를 한 번 실망시켰다. 다시는 그러지 않을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 8e433ee7-8f69-6dfe-21ee-7bab6802805a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:8e433ee7-8f69-6dfe-21ee-7bab6802805a
msgctxt "haab3da5dg270dg4a7bg913cg35dd85e138da"
msgid ""
"*You'd die too, of course, but your name would live on. 'Gale of Waterdeep, "
"the Light of Faerûn.' If only you might live to see it.*"
msgstr ""
"*물론 당신도 죽겠지만, 당신의 이름은 살아남겠지요. '워터딥의 게일, 페이룬의 빛.' 당신이 살아남아 그 광경을 볼 수만 있다면.*   "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = 8edd497b-7bb8-229d-f8c4-c80f094cd4a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:8edd497b-7bb8-229d-f8c4-c80f094cd4a3
msgctxt "h02e6d042g67fbg49ebgb78cgd08f02edf8f7"
msgid ""
"<i>He would never inflict such cruel terms on you. Mystra must have forced "
"his hand.</i>"
msgstr "<i>엘민스터가 절대 그런 잔인한 조건을 내걸 리 없다. 미스트라가 억지로 시켰으리라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 98be5157-bd4c-da83-4ed4-db09c7c1ae60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:98be5157-bd4c-da83-4ed4-db09c7c1ae60
msgctxt "h825d990eg1ff5g4fcdg8339ge062d4c4a8b3"
msgid ""
"*Something stirs within you. Hope. There may yet be a chance of redemption "
"for Gale of Waterdeep after all.*"
msgstr "*당신 안에 무언가가 꿈틀거립니다. 희망입니다. 워터딥의 게일에게도 구원받을 기회가 있을지 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = 99d65870-201d-1ed3-7542-87f379c21753
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:99d65870-201d-1ed3-7542-87f379c21753
msgctxt "hf4c4e9d9g839eg4fadg9b9eg3cf265339245"
msgid ""
"<i>To wield enough power to threaten a god. That would be quite "
"something...</i>"
msgstr "<i>신을 위협할 정도의 힘을 휘두른다. 그건 참 굉장한 일이겠지...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = 9b89eab1-dff7-2eb5-2c1c-f0f27777806e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:9b89eab1-dff7-2eb5-2c1c-f0f27777806e
msgctxt "h73c969cdg094ag4332g9991g1b2a7e4af615"
msgid ""
"*It's one thing to have fallen from such heights, but to have Elminster "
"himself now witness your humilation is almost unbearable.*"
msgstr "*그런 높은 위치에서 추락한 것도 모자라, 이젠 엘민스터가 당신의 굴욕을 목격하기까지 하다니 정말이지 버티기 어렵습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = b30173f0-a645-bddf-edce-4b5a52e65c27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:b30173f0-a645-bddf-edce-4b5a52e65c27
msgctxt "hc5dd299aged5eg4658ga2a3ge6e940bb68b3"
msgid ""
"*His empire, Netheril, has long since crashed and burned, but traces of its "
"magic still remain, if you know what to look for. Spells. Artefacts. "
"Weapons...*"
msgstr ""
"*그의 제국, 네더릴은 부서지고 불탄 지 오래 되었으나, 찾고자 한다면 그 마법의 흔적은 아직도 남아 있습니다. 주문, 유물, 무기...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = b677d46b-96bc-d902-a45d-4e1f5675e9de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:b677d46b-96bc-d902-a45d-4e1f5675e9de
msgctxt "h06d6f1c4gfff0g4cf3g8dabg4c72fa13def2"
msgid ""
"*You've witnessed first-hand the Absolute's depravity. It's quite something "
"to know you now have the power to wipe it from existence with a snap of your "
"fingers.*"
msgstr ""
"*당신은 절대자의 타락을 처음 목격했습니다. 당신에게 손가락 하나만 까딱하면 절대자의 존재 자체를 지워버릴 수 있는 힘이 있다니 대단한 "
"일이지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Narrator
#. NodeID = d039d20b-12a8-8cab-3daf-45afdafc5634
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:d039d20b-12a8-8cab-3daf-45afdafc5634
msgctxt "h7e8e9e87ge70cg43e6gb0a6g587784e69963"
msgid ""
"*Somewhere in these shadow-cursed lands lies a power great enough that "
"Mystra dare not speak its true name.*"
msgstr "*이 그림자 저주가 내린 땅 어딘가에 미스트라가 감히 이름을 입에 담지도 못할 만큼 커다란 힘이 숨어 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = d2d0c8ed-3c7e-1147-dc8f-a114d8c64901
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:d2d0c8ed-3c7e-1147-dc8f-a114d8c64901
msgctxt "hc45f7476g39efg404dgae57g4b24a2d123f5"
msgid "<i>Doddering old fool. Trust him to leave the hard work to you.</i>"
msgstr "<i>늙어빠진 멍청이. 믿었는데도 힘든 일을 다 떠맡기다니.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit
#. Speaker = Player
#. NodeID = d39d2c53-25b2-49ec-4d68-fd90840d1890
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_AfterElminsterVisit:d39d2c53-25b2-49ec-4d68-fd90840d1890
msgctxt "hbfea1484g8f08g465cg8b69g7b5d6de0c333"
msgid "<i>The Absolute must be stopped. If this is the only way, so be it.</i>"
msgstr "<i>절대자를 막아야만 한다. 만약 이게 유일한 방법이라면, 그리 해야지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Player
#. NodeID = 1af6f7df-d7ec-95e8-75bb-be929bc34b42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:1af6f7df-d7ec-95e8-75bb-be929bc34b42
msgctxt "h5cf72196g5c97g4d8egaeabg332ee42dc7c0"
msgid "<i>Such power leads to only one outcome. Corruption...</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 2f9f16be-0d7e-8389-39e0-a28c93bada51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:2f9f16be-0d7e-8389-39e0-a28c93bada51
msgctxt "h11418118g745bg47e3gabe1g4cc19d794b2d"
msgid ""
"*If there is more to discover about Karsus' creations, their shelves are "
"your best hope of finding it. And once you've learned his secrets, your "
"prayers may finally be answered.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 30bc9602-2961-1246-285d-4ddda725b853
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:30bc9602-2961-1246-285d-4ddda725b853
msgctxt "h03cf67b3g26eag4c4dga1e1gc1b679e35354"
msgid ""
"*In taking control of the Crown, the Dead Three's Chosen enslaved an elder "
"brain, infecting half the Sword Coast with tadpoles. And that was without a "
"true understanding of Karsus' powers.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 5357a1b6-63b3-daaf-0411-ab13381ad683
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:5357a1b6-63b3-daaf-0411-ab13381ad683
msgctxt "hf345160dg8d8dg4aaegb888gc182ece831ea"
msgid ""
"*Whatever secrets Mystra keeps from you, she will surrender them. She has no "
"choice, now the Crown of Karsus is almost within your reach.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 696b3f3d-42e3-ac1b-4ff4-3d3006ca6240
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_ReadKarsusNotes = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:696b3f3d-42e3-ac1b-4ff4-3d3006ca6240
msgctxt "h828287bdg9c06g4fe6ga226g9a6153078274"
msgid ""
"*You read the words, written in Karsus' own hand, and yet you can still "
"scarcely believe it.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 892a3d0c-218d-a8ed-ff59-45cc8bebf1bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:892a3d0c-218d-a8ed-ff59-45cc8bebf1bd
msgctxt "h473185f0ga53cg4e87ga53cg4c58ed553398"
msgid ""
"*Whatever the Crown's potential, for now it is impossible to detach from its "
"wearer. So long as the elder brain lives, Karsus' Crown will never be yours.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Player
#. NodeID = 91ca8166-8971-8ef5-141d-46bb5a813395
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:91ca8166-8971-8ef5-141d-46bb5a813395
msgctxt "h73213e4fgd462g4acbga2d4g5acc3cb55917"
msgid "<i>Nothing, unless you can find a way to defeat the elder brain...</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 952b0a3b-b119-7352-6dee-0538e196903b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_HouseOfHope_State_ContractIsDestroyed = False
#.      - GLO_Monitor_State_MadeDeal = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:952b0a3b-b119-7352-6dee-0538e196903b
msgctxt "h8ae68e68gf0acg428cg8df3g97e76008ffa7"
msgid ""
"*Destroy the crown without first destroying your contract with Raphael, and "
"there will be hells to pay. The devil will make sure of that.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 96f88977-af6d-5d22-1ed7-cb4d99ea50c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_ReadKarsusNotes = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:96f88977-af6d-5d22-1ed7-cb4d99ea50c6
msgctxt "hf7a6cdadg12bdg4850g9658g25ac0a64c853"
msgid ""
"*Reforge it, and you would carry the most powerful artefact in the realms. A "
"better fate than the one Mystra offered you.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = 9816afd5-e234-50b6-d787-e3371181fd5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:9816afd5-e234-50b6-d787-e3371181fd5a
msgctxt "h1157409ag01c7g49f5ga168g1d71d48cf9a9"
msgid ""
"*This could be the answer to your prayers. A gift unlike any your goddess "
"has been willing to give.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = a1b51fca-bc8a-6592-730b-226191f69b55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:a1b51fca-bc8a-6592-730b-226191f69b55
msgctxt "h1d09182fg856bg40cbg8cc8g99b09de0a8f6"
msgid ""
"*It's time you sought out her shrine. There, she will acknowledge the "
"secrets she's kept from you. And this time, she will not deny you anything.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = c1291805-fd70-25b0-012c-d3d71e1bd094
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:c1291805-fd70-25b0-012c-d3d71e1bd094
msgctxt "h584cfc2dg8586g4bc5gaad9g34cd8040d47a"
msgid ""
"*The Crown of Karsus... You've read of such an artefact, but always in "
"veiled terms, couched in myth and rumour. Never as a reality.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = cc92d437-3611-8b61-0252-9ac11014d4ad
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_SentToFindBook = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:cc92d437-3611-8b61-0252-9ac11014d4ad
msgctxt "h2a79323bg4c9dg43ccg8c79g380b892d38a1"
msgid "*Sorcerous Sundries must be your next port of call.* "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = d495a164-256f-39a0-749b-10545331a1d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_Met_ElminsterInWYR = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:d495a164-256f-39a0-749b-10545331a1d2
msgctxt "h372ed63cga383g4746gb4f2g9e328d9e226b"
msgid ""
"*It's time the Mother of All Magic heard what you have to say. Time for you "
"to find her shrine, and claim a long-witheld audience.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = dee0d46f-fd8d-cc2c-f8f0-7bfdf39604c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:dee0d46f-fd8d-cc2c-f8f0-7bfdf39604c2
msgctxt "hac98953dg32a1g42d3gbaabg3178ce14573c"
msgid ""
"*Could this truly be the crown you saw on the brain, surging with corrupted "
"Netherese magic? If it is indeed Karsus' fabled creation, what else could it "
"be capable of?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = e6a837f7-ee33-4ec1-b2ad-80a81bbb5267
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_HouseOfHope_State_ContractIsDestroyed = False
#.      - GLO_Monitor_State_MadeDeal = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:e6a837f7-ee33-4ec1-b2ad-80a81bbb5267
msgctxt "h564ffce8g90eeg48b9ga30bge872695d8a82"
msgid ""
"*Between the Heavens and the Hells, the fate of the Crown hangs in the "
"balance, and you will be the one to decide it.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = ea19b660-841a-5270-3582-b64265a7807d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:ea19b660-841a-5270-3582-b64265a7807d
msgctxt "hdb972c98ga97fg4eb2gbf9eg62e9a70bd05f"
msgid ""
"*The orb, the parasite, and now the Crown... Netherese magic haunts you at "
"every turn. It's time you understood its full potential.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = ec910e53-2fca-a9b0-cb18-9bd5bb412c7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_ReadKarsusNotes = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:ec910e53-2fca-a9b0-cb18-9bd5bb412c7d
msgctxt "hb72e5766g45b3g4aa3gb104g89d3e4fae37d"
msgid ""
"*Destroy it, and the world would be a safer place. No doubt this is the "
"course Mystra hoped you would follow, while keeping you ignorant of your "
"true purpose.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Player
#. NodeID = edb54546-7f88-719b-f9ac-65059c3549f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:edb54546-7f88-719b-f9ac-65059c3549f3
msgctxt "ha1177cd9g17e1g4920g8242g97d210bbd7ae"
msgid "<i>A familiar feeling rises within you. Temptation...</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus
#. Speaker = Narrator
#. NodeID = fd0f4118-9b2d-af64-dbb3-ee5cec658608
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_Met_ElminsterInWYR = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_KnowCrownKarsus:fd0f4118-9b2d-af64-dbb3-ee5cec658608
msgctxt "h5c7022a1g47f4g443bg8836gce03cd963087"
msgid ""
"*She's aware of your discoveries - Elminster's visit betrays that much. What "
"else does she know? What else hasn't she told you?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 056e1d79-1888-e367-5c31-c7869478065c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:056e1d79-1888-e367-5c31-c7869478065c
msgctxt "h997aadbeg7b16g4db4g947fg43c472793e69"
msgid ""
"*None can truly know what goes on beneath Elminster's tattered old hat. Just "
"because he has centuries worth of wisdom, doesn't mean he's direct, or "
"honest, in sharing it.*"
msgstr ""
"*엘민스터의 해진 모자 아래서 무슨 일이 일어나는지는 아무도 알 수 없겠지요. 그가 몇 백년에 걸친 지혜를 갖고 있다는 사실이, 이를 "
"곧이곧대로, 정직하게 공유한다는 뜻은 아닙니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 0a7fb1b9-3847-7459-2e0e-c5c8d818621a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:0a7fb1b9-3847-7459-2e0e-c5c8d818621a
msgctxt "h38e54d5eg0ba1g4b91gaf82g75d8d081be2e"
msgid "<i>You are.</i>"
msgstr "<i>준비되었다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 0aaa2143-8915-c90c-2f53-ce87597a7bcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:0aaa2143-8915-c90c-2f53-ce87597a7bcb
msgctxt "h77880cabg6237g4bb0g8a49gf92701569eb7"
msgid ""
"<i>Useless trifles. She still keeps the Weave's true power for herself.</i>"
msgstr "<i>쓸모없는 것들이다. 그 여신은 아직 자신을 위해 위브의 진정한 힘을 아껴 두고 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 1745cb3c-90cd-728b-60e9-dd075c9b2274
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:1745cb3c-90cd-728b-60e9-dd075c9b2274
msgctxt "hbc316f0bg1f54g40d7g8907g476326629a69"
msgid ""
"*Mystra's fate is none of your concern. But you will not allow mortal "
"innocents to die by the Absolute's hand. Not when it lies in your power to "
"prevent it.*"
msgstr ""
"*미스트라의 운명은 당신이 알 바 아닙니다. 그러나 절대자의 손에 무고한 필멸자들이 죽는 걸 용납할 수 없습니다. 당신이 막을 힘을 "
"가지고 있는 한 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 18628f50-5fb4-7d4c-5da2-ccf5792b20bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:18628f50-5fb4-7d4c-5da2-ccf5792b20bc
msgctxt "h52b9dac6g7942g4cc1ga2f5g4203ab0bb794"
msgid ""
"*Following your curiosity, wielding unknown magic... You feel more like "
"yourself than you have in months. And who knows how long your 'self' has "
"left?*"
msgstr ""
"*당신의 호기심을 따라서, 알 수 없는 마법을 휘두르고... 몇 달간의 행보에 비하면 더욱 당신 자신다운 느낌이 듭니다. 그리고 당신 "
"'자신'이 얼마나 남았을지 누가 알까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 1c818c7c-4a4a-f9e3-6fbc-a3753f947fb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:1c818c7c-4a4a-f9e3-6fbc-a3753f947fb0
msgctxt "hdf8b48e7g0b0cg488eg83a1gfbe116db4d0f"
msgid "<i>You've been indulging yourself. No harm in that.</i>"
msgstr "<i>계속 탐닉해 온 힘이다. 아무 해도 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 1f2b3e96-2797-fe65-9497-21a52f20d6a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:1f2b3e96-2797-fe65-9497-21a52f20d6a7
msgctxt "h0166395dg4f93g4d7cg9985g9301645600dc"
msgid ""
"*If the orb is the only way to ensure victory, you'll have no choice but to "
"use it.*"
msgstr "*보주만이 승리를 확정짓는 유일한 방법이라면, 쓸 수밖에 도리가 없겠지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 204c5d6a-c1f8-faae-1d04-927eb0bd9f06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:204c5d6a-c1f8-faae-1d04-927eb0bd9f06
msgctxt "he4cca083g5aabg4eb4g8db9gaa5583ac0b1c"
msgid "*Your own, for example.*"
msgstr "*예를 들면, 당신 손 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 237fecd3-8a51-100a-ba3f-f8de722dd90b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:237fecd3-8a51-100a-ba3f-f8de722dd90b
msgctxt "h30c23a9dg5fcfg4f4aga5fbge438a08f7b11"
msgid "*<i>Power.</i>*"
msgstr "*<i>힘입니다.</i>*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 2c8be6f8-baf8-1b03-8f15-1795190c020f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:2c8be6f8-baf8-1b03-8f15-1795190c020f
msgctxt "hcd8ec2e1g4cabg40c6g9f1agc4de8249b7d7"
msgid ""
"*She offers you only the chance, the hope of redemption. Would you really "
"give your life on such flimsy promises?*"
msgstr "*그 여신은 당신에게 구원의 희망이라는 기회만을 제시합니다. 그런 얄팍한 약속에 정말 당신의 생명을 걸 생각인가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 33d19bea-4463-c678-7a1c-d9fb95e5738c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:33d19bea-4463-c678-7a1c-d9fb95e5738c
msgctxt "h65246a43gf85fg4e59gb5acgffb53152a24b"
msgid ""
"*Even at the height of your powers, you'd never have dreamed of commanding "
"such a creature, or using its will to amplify your own. It's exhilirating, "
"and in Mystra's eyes, <i>dangerous</i>.*"
msgstr ""
"*당신의 힘이 전성기였을 때조차, 이런 생명체를 조종하거나 올챙이를 이용해 당신의 의지를 증폭하는 일은 꿈도 꾸지 못했습니다. "
"짜릿합니다. 미스트라의 시선에선 <i>위험하지만요</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 38e522f2-b143-7b46-ec1c-5fc565292e2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_CraftedDarkLantern = False
#.      - ORI_Gale_State_HasTadpolePowers = False
#.      - ORI_Gale_State_AbsorbedTWNBossPower = False
#. SetFlags:
#.   Local:
#.     - 98c88024-7966-48d9-3de9-c0b66f83e239_FallbackTriggered = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:38e522f2-b143-7b46-ec1c-5fc565292e2c
msgctxt "h366fadf1g249bg44b4ga789g56bd4d18ef91"
msgid ""
"*Another restless night beckons. Your mind flits from memory to memory, the "
"deeds you've done and left undone in the wake of Mystra's instruction.*"
msgstr ""
"*또 다른 불안한 밤이 다가옵니다. 당신의 마음은 기억에서 기억으로, 미스트라의 지시에 따라 당신이 행한 일과 아직 하지 않은 일 사이를 "
"오갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 3d6d6748-97bf-8253-165b-3f3f14fa7bd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:3d6d6748-97bf-8253-165b-3f3f14fa7bd2
msgctxt "h9aca4a3bge89dg4fd8gac9dg6a78e26584a6"
msgid "<i>Elminster's an enigma. Who knows what games he's playing.</i>"
msgstr "<i>엘민스터는 수수께끼다. 무슨 일을 꾸미고 있는지 알 수 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 404f5ae5-ee34-83c2-f6a0-d7744387012d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:404f5ae5-ee34-83c2-f6a0-d7744387012d
msgctxt "h9229fed3g7fe8g457eg9be9gb6be7a18c0c5"
msgid ""
"*Still, there is time yet to set your course straight. All may be forgiven, "
"if you serve her as Elminster instructed.*"
msgstr "*아직, 당신의 길을 바로잡을 시간이 있습니다. 모두 용서받을 수 있겠죠, 엘민스터가 말해 준 대로 여신을 섬기기만 한다면요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 4217768a-ce53-49e3-c14b-dfd5fd526c11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:4217768a-ce53-49e3-c14b-dfd5fd526c11
msgctxt "haf3078d5ge859g42edga405g9c7184cbe85d"
msgid ""
"<i>Her gifts have their uses, but she still leaves the hard work to you.</i>"
msgstr "<i>미스트라의 선물은 유용하지만, 여전히 힘든 일을 떠맡기고 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 45f7b5db-fdd5-26a9-fd59-754e5b1e1a22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_FollowedMystra = True
#.      - ORI_Gale_State_HasTadpolePowers = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:45f7b5db-fdd5-26a9-fd59-754e5b1e1a22
msgctxt "hd0f1f7d8g0321g413ag82b8g1dd26339d64c"
msgid ""
"*Though the night is still, your heart feels quite the opposite. Elminster's "
"letter has given you much to digest.*"
msgstr "*밤은 고요할지언정, 당신의 마음은 정반대입니다. 엘민스터의 편지는 곱씹어볼 것을 많이 남겨주었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 4ab0efb9-86d1-21e3-390d-64c0d89afd5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:4ab0efb9-86d1-21e3-390d-64c0d89afd5a
msgctxt "h515ae232gff96g4ae9g9a93g1b47fc88c758"
msgid "<i>Dangerous or not, you need all the help you can get.</i>"
msgstr "<i>위험하든 아니든, 가능한 한 모든 도움이 필요하다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 4d9c6591-71b3-12fb-50a1-65f79a0cd936
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:4d9c6591-71b3-12fb-50a1-65f79a0cd936
msgctxt "h1f35d8ceg6243g47c2g839egff3d210e5e0e"
msgid "<i>She's going to be disappointed. You've no intention of dying.</i>"
msgstr "<i>그 여신은 실망할 것이다. 죽고 싶은 생각이 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 500e6337-29ca-82f5-c2c6-88c755374dac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:500e6337-29ca-82f5-c2c6-88c755374dac
msgctxt "h8cc5cfa2g217bg4b7dgb012ge74dc93ea483"
msgid "<i>She gives what she can. And you receive her aid gratefully.</i>"
msgstr "<i>여신은 줄 수 있는 것을 주었으며, 그 도움을 감사히 받았다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 52a4a5fd-adf7-0c18-759f-c338e485db9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:52a4a5fd-adf7-0c18-759f-c338e485db9e
msgctxt "hf5ed6e16g9a5ag4b1bgb5a0ge241706b63bb"
msgid "<i>You'll learn more about the Heart. Only then will you decide.</i>"
msgstr "<i>심장부에 대해 더 알아낼 예정이다. 그 다음에 결정할 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 53e4bcda-7b9b-1e15-29df-4996cf8d018c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:53e4bcda-7b9b-1e15-29df-4996cf8d018c
msgctxt "h3b9f481bg7653g4309gaf9dgb9db1bafea08"
msgid ""
"*That you still live and breathe is a miracle in itself. A sign that Mystra "
"may be unwilling to directly intervene.*"
msgstr "*당신이 아직도 살아 숨쉬는 그 자체로 기적입니다. 미스트라가 직접 개입을 꺼리고 있다는 신호입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 574714eb-e279-756d-46cd-c28ffc24cba6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_AbsorbedTWNBossPower = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:574714eb-e279-756d-46cd-c28ffc24cba6
msgctxt "h7984b7b8g026ag4d33g98bcga7e0f2b4f483"
msgid ""
"*Though the shadow magic you consumed is nothing compared to your old "
"mastery of the Weave, it is novel. Exciting. And in Mystra's eyes, "
"<i>dangerous</i>.*"
msgstr ""
"*당신이 흡수한 그림자 마법은 과거 당신이 다루었던 위브에 비하면 아무 것도 아니지만, 새롭습니다. 흥미롭습니다. 그리고 미스트라의 "
"시선에선, <i>위험합니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 5a00cb37-15d2-ea2a-d89c-d30127adaded
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:5a00cb37-15d2-ea2a-d89c-d30127adaded
msgctxt "hfdf85516g5ec9g4628g8175g98a3124d9685"
msgid ""
"*Though the powers you gained are not savoury in their origin, that will "
"matter little if they keep you, and the orb, in one piece.*"
msgstr "*비록 당신이 얻은 힘이 썩 훌륭한 기원을 갖고 있지는 않지만, 당신과 보주를 멀쩡하게 지켜 준다면 별 문제는 아니겠지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 5cfe3b74-a101-444c-889c-ab193435ca90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:5cfe3b74-a101-444c-889c-ab193435ca90
msgctxt "hc7ca66eag4719g433fg979egd9eb04552f52"
msgid ""
"*In all the years you've known Elminster, he's never once questioned his "
"goddess' wisdom. For him to do so now... there must be something to this.*"
msgstr ""
"*당신이 엘민스터를 알고 지낸 세월 내내, 그는 단 한 번도 여신의 지혜에 의문을 표하지 않았습니다. 그런 그가 이제와서 이런 행동을 "
"한다면... 틀림없이 뭔가 있겠지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 5d062005-86c4-fd0d-f75d-1bbd0baab029
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:5d062005-86c4-fd0d-f75d-1bbd0baab029
msgctxt "h87cbb106gef17g45b0gaa35g65ff509ea482"
msgid "<i>Impossible. Elminster's utterly devoted to her.</i>"
msgstr "<i>그럴 리 없다. 엘민스터는 완전히 미스트라에게 헌신하고 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 661d8881-a117-8063-81d4-44b67b062e45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:661d8881-a117-8063-81d4-44b67b062e45
msgctxt "hcaf98bd5gc7cbg40c1g9109g7dccd76f1425"
msgid ""
"*What that alternative may be, you have yet to discover. But you <i>will</i> "
"discover it. Whether Mystra wants you to or not.*"
msgstr ""
"*그 대안이 무엇인지, 아직 당신은 발견하지 못했습니다. 하지만 당신은 <i>발견할</i> 것입니다. 미스트라가 원하든 원하지 "
"않든간에요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 70bec723-47f6-4d89-86b6-d36c9d37fd90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:70bec723-47f6-4d89-86b6-d36c9d37fd90
msgctxt "hf9209adbg8551g429cgb170gef1d9ced800a"
msgid "<i>Not for her, but for everyone else.</i>"
msgstr "<i>그 여신이 아닌, 다른 모두를 위해서이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 71e10f26-0e73-ce03-8864-e586eda93c77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_CraftedDarkLantern = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:71e10f26-0e73-ce03-8864-e586eda93c77
msgctxt "h58dddecegccb8g4e56ga104g47603543aac0"
msgid ""
"*For the first time since the orb sank its claws into your chest, you feel "
"your pulse quicken with a familiar sensation.*"
msgstr "*보주가 당신의 가슴에 손톱을 찔러넣은 그 날 이후 처음으로, 당신은 맥박이 빨라지는 친숙한 감각을 느낍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 7595168a-3e6b-5bb6-d0b2-a03217937e41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:7595168a-3e6b-5bb6-d0b2-a03217937e41
msgctxt "h96c6faf9gdb7bg48bcg80edg3bdc8b135b55"
msgid "*You may yet have cause to remind her.*"
msgstr "*그 여신에게 상기시켜 줄 이유가 있을지도 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 7b3e9d7d-fda5-8d78-2479-53f1b62da63e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:7b3e9d7d-fda5-8d78-2479-53f1b62da63e
msgctxt "hd8b33dc6g40e1g4675g994fg57de58749a91"
msgid "*Are you truly ready to sacrifice yourself for her?*"
msgstr "*당신은 정말로 미스트라를 위해 자신을 희생할 준비가 되었습니까?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 7b72f1e3-58cd-335d-2bee-8384ed4859d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:7b72f1e3-58cd-335d-2bee-8384ed4859d8
msgctxt "h5f000dfdg6460g484fg99f7g77189158e825"
msgid ""
"<i>He defies Mystra himself in saying so. He wouldn't do that without good "
"reason.</i>"
msgstr "<i>그렇게 말하면 미스트라를 거역하는 일이다. 확실한 이유 없이는 그럴 리 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 7eb9d3f0-cfeb-e16d-4c2f-347e94d8bfbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:7eb9d3f0-cfeb-e16d-4c2f-347e94d8bfbe
msgctxt "h03596274gbe2dg4c66g97f5g65d87d2f96ab"
msgid ""
"*It brings you comfort, knowing that Mystra's hand rests on your shoulder. "
"Though she remains aloof, she does not send you to your fate alone.*"
msgstr ""
"*미스트라의 손이 당신의 어깨에 얹혀 있다는 사실에 위안을 받습니다. 쌀쌀맞은 채로 있을지언정, 당신의 운명에 당신을 혼자 보내지는 "
"않으니까요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 8209a4fa-afd2-4455-6254-156ad02606b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:8209a4fa-afd2-4455-6254-156ad02606b8
msgctxt "he1d74346g6e0bg46cagaa05g62bd6b0cc450"
msgid "*You will not fail. Not again.*"
msgstr "*당신은 실패하지 않을 것입니다. 다시는.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 8b2f06cd-6daf-a7bd-2967-0d72149cc2a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:8b2f06cd-6daf-a7bd-2967-0d72149cc2a5
msgctxt "hf047ee41g8650g4c8dg8224ge3927bebfe61"
msgid ""
"*Your resolve is steady. It is not just Mystra you save with your sacrifice. "
"Faerûn itself depends on you.*"
msgstr "*당신의 결의는 변치 않습니다. 당신의 희생으로 구하는 것은 미스트라만이 아닙니다. 페이룬 전체가 당신에게 달려 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 90431270-5799-83ae-0814-562c5e0e5893
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:90431270-5799-83ae-0814-562c5e0e5893
msgctxt "hc3497130g0ac4g4878ga8bcg29e5a86d4cfe"
msgid ""
"*You must learn more about the Heart of the Absolute. After all, such power "
"could come in useful, in the right hands.*"
msgstr ""
"*당신은 절대자의 심장부에 대해 더 알아내야만 합니다. 결국, 그런 힘은 올바른 사람 손에 들어가면 유용하게 쓸 수 있을 테니까요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 908cf450-8b07-513d-bae5-d37320b74cfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:908cf450-8b07-513d-bae5-d37320b74cfc
msgctxt "h4b6f56a6gb7c0g406cg9082g0bd06028d015"
msgid ""
"*Mystra chose you for this task, not Elminster. Could jealousy lie at the "
"heart of his insistence that you intentionally fail in your duty?*"
msgstr ""
"*미스트라는 이 일을 위해 엘민스터가 아닌 당신을 선택했습니다. 맡은 임무를 일부러 실패하라 하는 그의 주장 한가운데에는 질투심이 숨어 "
"있는 것일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 91f195a7-705d-d138-9ffb-1991e332b471
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:91f195a7-705d-d138-9ffb-1991e332b471
msgctxt "hca9b4e32g8dfcg4cc2gb843g6124c22dd310"
msgid "<i>No. If Elminster believes there's another way, so do you.</i>"
msgstr "<i>아니다. 엘민스터가 다른 방법이 있다 믿는다면, 그리 믿는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = 91f501b9-ef12-b740-f6fb-c51d9c56b4b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:91f501b9-ef12-b740-f6fb-c51d9c56b4b6
msgctxt "hfeba9c44g3979g4512g99cagc42b7f00e023"
msgid ""
"<i>It could be sabotage, an attempt to deny you your chance at "
"redemption...</i>"
msgstr "<i>이건 구원의 기회를 놓치게 하려는 방해공작일 수도 있다...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 96476bf5-245b-e5cb-a529-4746d9511eab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_CraftedDarkLantern = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:96476bf5-245b-e5cb-a529-4746d9511eab
msgctxt "h6a06ef46ga75fg4ccdgbd1fge0aabe82b975"
msgid ""
"*In crafting the shadow lantern, you recaptured a taste of what you once had "
"- the power to create, to compel, to imagine. It was exhilarating. And in "
"Mystra's eyes, <i>dangerous</i>.*"
msgstr ""
"*그림자 등불을 만들면서, 당신은 한 때 갖고 있었던 힘을 다시 맛보았습니다. 만들고, 부리고, 상상하는 힘 말이죠. 짜릿했습니다. "
"미스트라의 시선에선, <i>위험했죠</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = 9b741812-cdcc-9346-c227-fe0791ced015
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:9b741812-cdcc-9346-c227-fe0791ced015
msgctxt "hd22b0aa6gaf9bg43b7g8a39gf498f75f9934"
msgid ""
"*Elminster's life has been spent in unwavering service to Mystra. He "
"worships her devoutly, as you once did. So why would he plant such doubts in "
"you now?*"
msgstr ""
"*엘민스터는 평생 미스트라에게 아낌없이 봉사하며 살아왔습니다. 당신이 그랬듯, 엘민스터는 미스트라를 경건한 마음으로 숭배하고 있습니다. "
"그런데 이제와서 왜 당신에게 이런 의심을 심을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = a143e12c-4af7-d8bc-9845-291bc6563d36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:a143e12c-4af7-d8bc-9845-291bc6563d36
msgctxt "h837a2780ge129g4988gba6egd81b79af7e8c"
msgid ""
"*Mystra's conclusion is based on a flawed assumption. The orb cannot be the "
"only means of destroying the Absolute, though she may think it the most "
"convenient.*"
msgstr ""
"*미스트라의 결론은 흠결이 있는 가정에 근거합니다. 보주는 절대자를 파괴할 유일한 수단일 수 없습니다. 그 여신은 그게 가장 편리하다 "
"생각할지 모르겠지만요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = a652309e-7202-d12a-e57b-4ff452b8fec3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:a652309e-7202-d12a-e57b-4ff452b8fec3
msgctxt "hcb10ec43g3427g48a0gb2fcg57333063da4d"
msgid ""
"*You finally appear to be winning back Mystra's favour, even her blessings. "
"But appearances are not everything, and after all - she does not give "
"without expecting in return.*"
msgstr ""
"*당신은 마침내 미스트라의 총애, 더 나아가 미스트라의 축복까지 얻어낸 듯 보입니다. 그러나 보이는 모습만이 전부는 아니며, 어쨌거나 "
"미스트라는 대가 없이는 베풀지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = a752476b-704c-cfde-2b6a-26037a6d8c79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:a752476b-704c-cfde-2b6a-26037a6d8c79
msgctxt "h8cea55b7g82f6g457cgbd10g6a8041cb2900"
msgid ""
"<i>You will reward her faith in you. When the time comes, you will be "
"ready.</i>"
msgstr "<i>여신의 믿음에 보답하리라. 때가 오면, 준비되었을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = ac1cf0d5-a1e4-a9f4-7f54-9796277c5e55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:ac1cf0d5-a1e4-a9f4-7f54-9796277c5e55
msgctxt "h92c21e17gb7c7g4b2agb636g004176e0ba65"
msgid "<i>She has no right to interfere. You don't answer to her.</i>"
msgstr "<i>그 여신은 끼어들 권리가 없다. 대답하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = b25f4f4c-e2d3-c20a-6d6e-8ea14cf356ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:b25f4f4c-e2d3-c20a-6d6e-8ea14cf356ee
msgctxt "h0dfa2925gdd34g474bgb810g39621ee1159a"
msgid ""
"*Her presence haunts your every decision - the ones she would endorse, and "
"those she would disdain. Defy her doctrines while she watches, and you would "
"not be merely disobedient. You would be <i>dangerous</i>.*"
msgstr ""
"*그 여신의 존재가 당신의 결정 하나하나에 서려 있습니다. 지지할 결정과, 경멸할 결정에 말이죠. 여신이 지켜보는 가운데 교리를 "
"거역한다면, 그저 불복종으로만 끝나지 않습니다. <i>위험할</i> 수도 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = b4d4f4f3-7039-1756-b927-ba87fcbd9e43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:b4d4f4f3-7039-1756-b927-ba87fcbd9e43
msgctxt "hb4d54f19g191dg4290gbd80g20922b6af771"
msgid ""
"*Perhaps these favours are intended to appease you. To make you hunger for "
"the even greater reward she will bestow if you continue to obey.*"
msgstr ""
"*어쩌면 이 총애는 당신을 달래기 위한 의도로 내렸을지도 모릅니다. 당신이 계속 순종하면 하사해 줄 훨씬 커다란 보상에 굶주리도록 "
"말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = b8a82635-d686-136a-b6b4-534a664a9ca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:b8a82635-d686-136a-b6b4-534a664a9ca8
msgctxt "hb1fb80d0g5145g47ccga3afg047ea542b4c1"
msgid "<i>She forced her favours upon you. You owe her nothing.</i>"
msgstr "<i>미스트라는 억지로 총애를 내렸다. 그 여신에게는 아무 빚도 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = c98a16f3-12bf-1a7f-37a1-2412d2ae51a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:c98a16f3-12bf-1a7f-37a1-2412d2ae51a0
msgctxt "hf1bb53dage72cg4066gb63cg009e0bb69d8a"
msgid ""
"*Each day brings you closer to finding the Heart of the Absolute. The source "
"of Mystra's fear. And, for you, perhaps her forgiveness...*"
msgstr ""
"*하루하루 당신은 절대자의 심장부에 가까워져 갑니다. 미스트라가 느끼는 공포의 근원입니다. 그리고 당신에게는, 용서의 근원일지도 "
"모르죠...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = cc508028-e39b-fe41-4542-b0e899204d4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:cc508028-e39b-fe41-4542-b0e899204d4f
msgctxt "h08ebf6c6g6464g40e2ga617g3426db4acdf1"
msgid ""
"*Or is her silence merely the hope that you may yet follow the self-"
"destructive path she desires, without the need to force your hand?*"
msgstr ""
"*혹은 여신의 침묵이란 그저 당신의 손을 억지로 잡아끄는 일 없이, 당신 스스로 여신의 뜻대로 자멸하는 길을 따르길 바라는 것일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = cd452bf3-cd47-2706-4e13-eab039a7cabf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:cd452bf3-cd47-2706-4e13-eab039a7cabf
msgctxt "h1e211773g3e75g4c73g8d20g2479ffe31978"
msgid ""
"*The magic you called on will have its uses, but you can't shake the feeling "
"you lost something of yourself in the bargain.*"
msgstr "*당신이 불러낸 마법은 쓸모가 있겠지만, 그 거래에서 자신의 무언가를 잃어버렸다는 느낌을 떨쳐낼 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = d33d97a4-ea51-043e-642b-ad91cacb747c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:d33d97a4-ea51-043e-642b-ad91cacb747c
msgctxt "ha8067b30g6781g448bga089g886192fa1b8e"
msgid ""
"*You would not simply destroy something so valuable. To do so would be "
"foolish, <i>irresponsible</i> even.*"
msgstr "*당신은 그렇게 귀중한 것을 그저 파괴하지는 않을 것입니다. 그런 행위는 멍청하며, <i>무책임</i>하기까지 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = db61a6ef-ec49-f0bc-204e-b9ac30bbc28f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:db61a6ef-ec49-f0bc-204e-b9ac30bbc28f
msgctxt "h45e07d02g43e4g4fb8ga4dfgf14477f91a77"
msgid ""
"*Mystra has forgotten how carefully mortals tend to their brief and fragile "
"lives. And what lengths they will go to to protect them.*"
msgstr ""
"*미스트라는 필멸자들이 짧고 연약한 삶을 지키려 얼마나 노력하는지 잊었습니다. 무슨 수를 써서든 그 삶을 지키려 한다는 사실도요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = db949e65-6a30-69fb-0863-26db2fe61f78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 98c88024-7966-48d9-3de9-c0b66f83e239_FallbackTriggered = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:db949e65-6a30-69fb-0863-26db2fe61f78
msgctxt "h86abb744gacd8g4098g9009gfed6460da7c1"
msgid "<i>She might be right. You've drawn powers from a grim source.</i>"
msgstr "<i>그 여신이 맞을지도 모른다. 사악한 근원에서 힘을 불러내었다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = dbf74398-7fdb-d2d3-bcef-86ad33079893
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:dbf74398-7fdb-d2d3-bcef-86ad33079893
msgctxt "h27458cadg9979g494bgbeb5g22bffe9ac23c"
msgid ""
"*Can it really be true? Does he believe Mystra's instruction is "
"<i>wrong</i>?*"
msgstr "*정말 그럴까요? 엘민스터는 미스트라의 지시가 <i>잘못됐다고</i> 믿는 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = e2eb79fc-1e83-16b0-5f00-f3b87de2cb85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:e2eb79fc-1e83-16b0-5f00-f3b87de2cb85
msgctxt "h81241320g4188g4fd0g8c41g6e78b59001fe"
msgid "<i>You'll die on nobody's orders. Especially not hers.</i>"
msgstr "<i>아무도 죽으라 명할 수 없다. 하물며 그 여신은 더더욱.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Player
#. NodeID = e9c6f83f-7c97-9415-74ca-e4f9cf575e77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:e9c6f83f-7c97-9415-74ca-e4f9cf575e77
msgctxt "h5c9592a7gbd92g4047ga42age0fbfc082142"
msgid ""
"<i>You will destroy the Absolute. Not for her, but for everyone else.</i>"
msgstr "<i>절대자를 파괴할 것이다. 그 여신이 아니라, 모두를 위해서.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = eae8cfab-7c04-1227-6901-70146cf2abd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:eae8cfab-7c04-1227-6901-70146cf2abd9
msgctxt "h5680d09ege6d2g43dbgad34g90628c28eef0"
msgid ""
"*If the Heart of the Absolute is within reach, it's not because of her "
"intervention. It's because of your efforts. Your struggle. Your life being "
"put on the line.*"
msgstr ""
"*만약 절대자의 심장부에 가까이 갈 수 있다면, 이는 미스트라의 개입 덕분이 아닙니다. 당신의 노력 덕분입니다. 당신의 투쟁 덕분입니다. "
"당신이 목숨을 건 덕분입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = f700c942-0212-88f3-1597-59bab75a4918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:f700c942-0212-88f3-1597-59bab75a4918
msgctxt "hfc9578e7g0f1cg477eg955dg322188f57ced"
msgid ""
"*Your obedience cannot be guaranteed by such piecemeal rewards as Mystra "
"deigns to give.*"
msgstr "*미스트라가 마지못해 조금씩 내주는 그런 보상으로는 당신의 복종을 보장할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive
#. Speaker = Narrator
#. NodeID = fa4dc705-d08f-9e27-2cda-abb9399d2692
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_CraftedDarkLantern = False
#.      - ORI_Gale_State_HasTadpolePowers = True
#.      - ORI_Gale_State_AbsorbedTWNBossPower = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Gale_SD_LastNightAlive:fa4dc705-d08f-9e27-2cda-abb9399d2692
msgctxt "ha6e4a3abg1135g4781g9fd6g13b96cb204a1"
msgid ""
"*You try to rest, but the tadpole within you has other plans. It writhes and "
"stretches, comfortable within your skull. As comfortable as you've become "
"wielding it.*"
msgstr ""
"*당신은 쉬려 하지만, 당신 안의 올챙이는 다른 계획이 있습니다. 요동치고 뻗어나가며, 당신의 머릿속에서 편안해하고 있습니다. 당신이 "
"올챙이를 받아들였을 때처럼요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 01cc299f-be08-413f-8680-d60efa81cc4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:01cc299f-be08-413f-8680-d60efa81cc4b
msgctxt "hfe45e1ccg08dcg4f07g823dg10b304871cdc"
msgid "What's the book?"
msgstr "저 책은 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 087db3f9-c7a3-315c-7ed4-d3496e623e2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:087db3f9-c7a3-315c-7ed4-d3496e623e2a
msgctxt "h17e71d57g4c08g4972gbe76gfbf1fa08fd4c"
msgid ""
"I am terrified - I will not claim otherwise. My face could scarcely conceal "
"it even if my words sought to deny it."
msgstr "난 완전히 겁에 질렸어. 부정하지 않겠어. 말로써 부인해도 내 얼굴은 숨길 수 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 0bb3c800-7bc4-85f4-2637-0463b6f798bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Partnered(5) = False
#.      - ORI_State_DatingGale(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:0bb3c800-7bc4-85f4-2637-0463b6f798bd
msgctxt "hb8334440gf952g4977gb99bgf7bbd8f7ecce"
msgid ""
"One moment with you could sate me for a lifetime, and prise the fear from my "
"heart. I'm so very glad you came, to share this with me."
msgstr ""
"너와 함께하는 단 한 순간으로, 난 평생 만족할 수 있어. 그 순간 마음속에서 공포가 사라져. 와줘서 정말 고마워. 이 순간을 함께해서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 10dddf1c-c193-c9cc-c8ce-b2276d057813
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:10dddf1c-c193-c9cc-c8ce-b2276d057813
msgctxt "hade47eaeg176cg4d48g996agf067d476ebda"
msgid ""
"This one here is called 'The Art of the Night'. It details the first "
"thousand nights of a newlywed king and queen."
msgstr "이건 '밤의 예술'이라는 책이야. 신혼을 맞은 왕과 왕비의 첫 천 일 밤이 자세히 담겨 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 15364978-a4df-2aa7-4e32-54601c2c753e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:15364978-a4df-2aa7-4e32-54601c2c753e
msgctxt "hc74693d7g41b0g4dc2gafd7g5ad57ecc897e"
msgid ""
"I know this is all unreal, but I created it for you. You must know that "
"you're... That you're very special to me."
msgstr "비록 현실은 아니지만, 널 위해 만든 거야. 네가... 네가 내게 얼마나 특별한지 너도 잘 알 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 1585e183-e990-5206-b824-085dfc2cf861
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:1585e183-e990-5206-b824-085dfc2cf861
msgctxt "h368caf63g093eg4d9aga71bge2ad0b153359"
msgid "The stars will be our bed. Come here."
msgstr "별들이 우리의 침대가 돼줄 거야. 이리 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 16f26af7-4097-78ac-e9d0-d0be2ac700cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:16f26af7-4097-78ac-e9d0-d0be2ac700cd
msgctxt "h83382fa1g3bcfg41cag8757g46febef7b130"
msgid ""
"If there is a way - any way - to save all that's grown dear to me, I want to "
"seize it. I just cannot fathom what that might be, other than to fail Mystra "
"and condemn the world."
msgstr ""
"나에게 소중해진 이 모든 것들을 구할 방법이 있다면, 어떻게든 지키고 싶어. 하지만 미스트라를 실망시키고 이 세계를 파멸시키는 것 말고는 "
"가늠 조차 할 수가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 1aaf1594-bb94-2cc8-9eb6-6af2cbf501df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:1aaf1594-bb94-2cc8-9eb6-6af2cbf501df
msgctxt "h0a960113ge8c8g4f78ga1c7g2ac47b80c00e"
msgid ""
"They turned everything they did into an art. The art of conversation. The "
"art of taste, time honoured and newly acquired."
msgstr "그들은 모든 행위를 예술로 바꿔놓았어. 대화의 예술. 오랜 세월을 거치며 새롭게 터득한 맛의 예술이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 1acb80cd-28ff-0198-3316-9c7e7df06cbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:1acb80cd-28ff-0198-3316-9c7e7df06cbf
msgctxt "h1d0b39e2g3f4bg437dgb419g92b3521568e9"
msgid ""
"I can only hope that there are few innocents within the Absolute's reach, "
"when the time comes... and that you will seek safety, far away from me."
msgstr ""
"때가 되면 절대자의 손이 닿는 곳에 무고한 이가 많지 않기를 바랄 뿐이지... 네가 내게서 멀리 떨어져 안전한 곳에 있길 바랄 뿐이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 1d650540-3640-ed78-fa70-4bd98a024399
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:1d650540-3640-ed78-fa70-4bd98a024399
msgctxt "h923e63f3gfc6bg4006g83deg2e69e12db65b"
msgid ""
"On the contrary. No one is lonely when they have books - except perhaps the "
"illiterate."
msgstr "그렇지 않아. 책이 있다면, 그 누구도 쓸쓸할 겨를이 없지. 문맹이 아니라면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 1f448083-331f-e483-f285-561f21bc855d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithGale(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:1f448083-331f-e483-f285-561f21bc855d
msgctxt "hdc260c8cga8b0g4d45g9754gb459fd3c57f8"
msgid "I'm in love with you too."
msgstr "나도 널 사랑해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 254940ad-48bf-e0c1-2e7a-91723daf1f15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:254940ad-48bf-e0c1-2e7a-91723daf1f15
msgctxt "h2728a309g9655g486cg87f0g2f6da0037568"
msgid ""
"There's an almost reverent silence that accompanies the peak of darkness, "
"when you'd almost believe the dawn will never break."
msgstr "아침이 오지 않을 것만 같은 어둠의 절정에는 경건한 침묵이 흐르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 25acd684-52bd-0a98-b9d0-ff05eda6f3e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:25acd684-52bd-0a98-b9d0-ff05eda6f3e3
msgctxt "h84b59876g063fg4b29g82f2g20072aea9f6a"
msgid "I hope that wasn't a parting kiss."
msgstr "이별의 키스가 아니길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 288d0725-a7af-c023-8504-5629c49dbad8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:288d0725-a7af-c023-8504-5629c49dbad8
msgctxt "h4ab33b25g0ccfg4005gbbd1g20dbb5a966d7"
msgid "You don't need to impress me, Gale. I'm no goddess."
msgstr "내게 잘 보이려고 노력할 필요 없어, 게일. 난 여신이 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 288d0725-a7af-c023-8504-5629c49dbad8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:288d0725-a7af-c023-8504-5629c49dbad8
msgctxt "ha29c3d0agfe30g4eb4ga8cegdce7fee90612"
msgid "You don't need to impress me, Gale. I'm no god."
msgstr "내게 잘 보이려고 노력할 필요 없어, 게일. 난 신이 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 288d0725-a7af-c023-8504-5629c49dbad8
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:288d0725-a7af-c023-8504-5629c49dbad8
msgctxt "hfd85bac4g7ef8g4aa7g91fdg9e3d1679ea1d"
msgid "You don't need to impress me, Gale. I'm no deity."
msgstr "내게 잘 보이려고 노력할 필요 없어, 게일. 난 신이 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Narrator
#. NodeID = 2abe0b7a-60a6-d5b9-638a-c3c2071a14a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:2abe0b7a-60a6-d5b9-638a-c3c2071a14a0
msgctxt "h785d3b8fg460bg409cgaf0ag13f125cc232d"
msgid ""
"*Your bodies and minds weave together in a masterpiece of intimacy. Never "
"have you felt such wonder, such love - as vast as the universe itself, and "
"just as heavenly.*"
msgstr ""
"*당신의 몸과 마음은 하나의 걸작으로 촘촘히 짜입니다. 당신은 이토록 우주만큼 광활하고 천상과도 같은 경이로움과 사랑을 느껴본 적이 "
"없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 2e0160e0-df00-8d12-9805-ed55f84748a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:2e0160e0-df00-8d12-9805-ed55f84748a1
msgctxt "h00476363g34a8g4d90ga8aeg2bf692821402"
msgid "Show me more. Show me it all."
msgstr "더 보여줘. 전부 다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 30c5f981-081e-87a0-d15a-fb00d724c9d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:30c5f981-081e-87a0-d15a-fb00d724c9d6
msgctxt "h22e5f5d0g3edag4069g8d75g669514c7237e"
msgid ""
"The grand piano plays the Lliirian Suites all by itself, and as we look out "
"beyond the arches that lead to the terrace, we see the weary sun take its "
"daily dive into the sea."
msgstr ""
"그랜드 피아노에서 리어라의 모음곡이 저절로 연주되고, 테라스로 이어지는 아치 너머를 바라보면 지친 태양이 매일 바닷속으로 가라앉는 모습을 "
"볼 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 3e841c21-2343-e1ea-7a80-0071f15369fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:3e841c21-2343-e1ea-7a80-0071f15369fe
msgctxt "hf21dd879ga182g49d9g91bcgdd7a15494798"
msgid ""
"Thank you, for spending this time with me. I think I want to be alone now."
msgstr "고마워, 곁에 있어줘서. 이젠 나 혼자 있고 싶은 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 3fd04b28-440a-cfdb-3bc6-87d5f15c7e0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:3fd04b28-440a-cfdb-3bc6-87d5f15c7e0d
msgctxt "hea605186g785ag40a4g81dbg971079985891"
msgid "You're remarkably upfront about your intentions. I like it."
msgstr "네가 이렇게 직설적일 줄은 몰랐는걸. 마음에 들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 407727eb-1d84-ceec-851f-88cfa7d2433a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:407727eb-1d84-ceec-851f-88cfa7d2433a
msgctxt "h5190d3a1g18a1g41cag9c40g0cdc80b27b54"
msgid ""
"It's beautiful, but its you I want to be with. The man, not the illusion."
msgstr "아름다워. 하지만 내가 함께하고 싶은 사람은 너야. 환영이 아니라 진짜 너."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 41ad41aa-425f-4906-2b27-f87d3f18def4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:41ad41aa-425f-4906-2b27-f87d3f18def4
msgctxt "h66ee32b7ga066g45d7gaa5dgfd5d8008cf06"
msgid "Show me."
msgstr "보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 44eae838-5881-1be7-4283-f682aff7f14e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:44eae838-5881-1be7-4283-f682aff7f14e
msgctxt "ha0e2fc1bgec7ag4f52g8d35g22b5f15c227a"
msgid ""
"Yes, you are. Trust me, I would know. Let's do it your way then. So long as "
"it's with you."
msgstr "아니, 넌 신성해. 그건 내가 잘 알지. 그럼 네 방식대로 하자. 난 너만 곁에 있다면 상관없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 49331edb-98c9-89c0-f8d4-18a5a196f435
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:49331edb-98c9-89c0-f8d4-18a5a196f435
msgctxt "h7f762e2cg4050g4c0bg9480g9ad7afb4673b"
msgid ""
"This is a pleasant fantasy, but no more. Time to return to the real world."
msgstr "정말 기분 좋은 환상이지만, 이제 그만해. 현실로 돌아갈 시간이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 49342304-c4f6-0bba-0a48-8e4de14a119a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:49342304-c4f6-0bba-0a48-8e4de14a119a
msgctxt "hf31e1abagd224g414cga800g82f21edcd5fa"
msgid "The old ways then. If that is what you wish, so be it."
msgstr "그러면 구식으로, 네가 원한다면 그렇게 하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 4ac40950-5312-6e5f-5a1c-aac304e401c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:4ac40950-5312-6e5f-5a1c-aac304e401c1
msgctxt "hfe6baad1gcb93g475fg9881g2cda91244182"
msgid ""
"I am trying. Believe me, I am. The path is set, and I will not stray from it "
"- even as my heart quakes."
msgstr ""
"노력 중이야. 정말로, 믿어줘. 내가 가야 할 길은 정해졌고 난 달아나지 않을 거야. 비록 내 심장은 공포로 전율하고 있지만서도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 4c8455be-d876-85bd-cefa-7b3a2cdf8851
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:4c8455be-d876-85bd-cefa-7b3a2cdf8851
msgctxt "h4b832ff7g2c96g4336ga814gd6653b360fd1"
msgid "You sound sure in your course of action then."
msgstr "네 행동에 확신을 가진 것처럼 들리네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 4d6ca1c5-9842-39e2-c85a-1c47ac395636
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithGale(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:4d6ca1c5-9842-39e2-c85a-1c47ac395636
msgctxt "h77f5049bg1d54g4358gb77fg54d1dc83f4b9"
msgid "I'm in love with you too."
msgstr "나도 널 사랑해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 4f0e9369-a35f-0f69-5c1f-a47ac83f33a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:4f0e9369-a35f-0f69-5c1f-a47ac83f33a4
msgctxt "h2037c959gfd7ag45f0g922eg57a9d314f49a"
msgid "It's breathtaking, Gale. Is this starry sky your doing?"
msgstr "숨이 멎을 정도로 아름다워. 게일, 저 별하늘이 네 작품이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 4f49a3f3-4009-bf3a-2091-0d051cb2c11e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_-10_For_Sp6(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:4f49a3f3-4009-bf3a-2091-0d051cb2c11e
msgctxt "had6f881eg4d15g4d98gae03g88be418cc72b"
msgid ""
"Heartening words - if only they came from the lips of another. This is no "
"time for delusion - we are not close, you and I."
msgstr ""
"따듯한 말이네. 그 말이 다른 이의 입에서 나왔다면 좋았을 텐데. 지금은 망상에 빠질 때가 아니지. 너와 난 가까운 사이가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 50b7aeb2-da20-0c31-5819-f020e8aa22d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:50b7aeb2-da20-0c31-5819-f020e8aa22d6
msgctxt "h14084a6dg6e12g409dga769gd9997e80adec"
msgid "Allow me to live dangerously while I still can."
msgstr "살아있는 동안 위험하게라도 살 수 있게 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 543313a3-30b8-7fd1-2fa3-b1af5f3f574f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:543313a3-30b8-7fd1-2fa3-b1af5f3f574f
msgctxt "h3c6ed226g1b04g432cgb4f8gac478ec38837"
msgid "I refuse to believe this is the end. We'll find another way, I promise."
msgstr "이게 끝이라고 인정하지 않겠어. 우린 다른 방법을 찾을 거야, 약속해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 5b57e3bb-9ab9-ce27-f658-b58a0ebebac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:5b57e3bb-9ab9-ce27-f658-b58a0ebebac8
msgctxt "h8f45ddc4g1903g4415g8cfeg8baa0023e7ae"
msgid "A small gesture towards your comfort."
msgstr "네가 편안해질 수 있다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 5b646f4b-9636-143d-398e-4b542cf137c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:5b646f4b-9636-143d-398e-4b542cf137c6
msgctxt "h64a01ac1gb723g4a01gad61g3ad5fff55b8d"
msgid ""
"Those bonds will soon break. But you were a worthy ally, and could have "
"become much more, in other circumstances. Let us just enjoy the view "
"together. We will leave the world a better place than it is tonight."
msgstr ""
"그 유대는 곧 부서질 거야. 하지만 넌 소중한 동료였어. 그리고 상황이 달랐다면 훨씬 더 소중한 존재가 됐을지도 모르지. 그냥 이 경치를 "
"함께 즐기자. 우리가 떠나고 나면, 세상은 지금보다 좋은 곳이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 5b6d3fac-d369-35b3-6c46-28a410390d0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:5b6d3fac-d369-35b3-6c46-28a410390d0c
msgctxt "h08154ed2g9425g471dga472gf79f3aed4879"
msgid "Then we'll start writing the prequel."
msgstr "그럼 우리가 함께 속편을 쓰자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 5c0cc6a6-126b-1810-464e-38e32d6c99b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:5c0cc6a6-126b-1810-464e-38e32d6c99b3
msgctxt "h0114daa1g98c6g48c2g8fa9g76d8a6c68192"
msgid ""
"The art of the body. The exploration and acceptance of the self and the "
"other. The art of the night itself."
msgstr "그리고 육체의 예술도 있어. 스스로와 타인에 대한 탐구와 수용. 밤이 선사하는 예술 그 자체 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 5ce5f66d-6eb0-9ec9-6356-99e3cbd3244b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithGale(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:5ce5f66d-6eb0-9ec9-6356-99e3cbd3244b
msgctxt "h04476d93gb13cg4efcg8f17ga7a5a2d898b3"
msgid "<i>Lean in for a kiss.</i>"
msgstr "<i>기대어 키스한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 60576e1a-d6e5-0783-e2e8-082c52ae0c31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:60576e1a-d6e5-0783-e2e8-082c52ae0c31
msgctxt "hc545032cg6a7ag4f22g8efdgb7e7ab931228"
msgid ""
"Are you sure...? I could conjure up any sight that you could dream of, and a "
"few you could not. I could use the Weave to make us feel sensations beyond "
"reckoning. I could do more than woo you. I could wow you."
msgstr ""
"정말...? 난 네가 상상할 수 있는 어떤 광경도 만들어낼 수 있어. 어쩌면 상상할 수 없는 것 조차도. 위브를 이용하면 상상을 초월하는 "
"감각을 느낄 수 있어. 내가 널 구애하든 십애하든 그 이상으로 널 놀라게 할 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 6919c71d-4ff9-5c76-672c-1c6c02b941b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:6919c71d-4ff9-5c76-672c-1c6c02b941b2
msgctxt "heb0ddd79ga1bcg4bd9g8ba8gecac26de300a"
msgid ""
"I'd give a lot to be able to kiss you right now. But your presence itself is "
"more than enough. A night stargazing with you is the greatest gift I could "
"ask for."
msgstr ""
"지금 너에게 키스할 수 있었다면 정말 좋겠지만, 너의 존재만으로도 충분해. 너와 함께 별을 바라보는 이 밤은 내가 바랄 수 있는 가장 큰 "
"선물이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 6a5a1af9-8270-e1a1-180f-1069d11b6912
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:6a5a1af9-8270-e1a1-180f-1069d11b6912
msgctxt "hbec8449dg109ag41d3ga206g5c6a3e029149"
msgid ""
"Why confine ourselves to the pleasures of mortal flesh? It is but one stitch "
"in a vast tapestry. Let me show you more."
msgstr "필멸자의 육신에 우리의 쾌락을 가둘 필요는 없잖아? 그건 광대한 태피스트리에 있는 하나의 매듭에 불과해. 내가 보여줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 6b03877b-5907-3e94-2c38-515c6df6ac7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:6b03877b-5907-3e94-2c38-515c6df6ac7a
msgctxt "hd62bb3d5g1f4eg4642g86acge207d2753378"
msgid ""
"There is no point in running from the inevitable. Better to meet it, on my "
"own terms."
msgstr "불가피한 운명에서 도망치는 건 무의미해. 내 의지로 대면하는 게 나아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 6c9e25b7-fbf6-fb14-9228-a0af4d71f845
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:6c9e25b7-fbf6-fb14-9228-a0af4d71f845
msgctxt "h87a1eae7gc359g478ega0d3g856d936ca0bd"
msgid ""
"How about the perfect night in Waterdeep? Yes... Let's imagine how it would "
"be."
msgstr "워터딥에서의 완벽한 밤은 어때? 그래... 그런 밤이 어떨런지 한번 상상해 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 6cbb05f1-01b4-c1e2-0d92-1db9ed1508ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:6cbb05f1-01b4-c1e2-0d92-1db9ed1508ca
msgctxt "h13c4bbd5ge1ebg4292gb1bcgcafe5ad6c158"
msgid "You're a good kisser."
msgstr "키스를 잘 하는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 6d49f78c-ca4a-c8aa-11b0-10b34cf9736f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:6d49f78c-ca4a-c8aa-11b0-10b34cf9736f
msgctxt "h50dfbb42g1fadg49b6gb377geb7fcf95b7fa"
msgid "You seem especially philosophical this evening. Are you all right?"
msgstr "오늘 밤엔 유독 철학적인 것 같네. 괜찮아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 72e5f625-1eb2-cf36-5663-a1dbb223989c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GalesLastNightAlive_SD_ROM_Event_CollateralDamage(5) = False
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushTowardsDeath(5) = True
#.     - CAMP_GalesLastNightAlive_SD_ROM_Event_CollateralDamage(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:72e5f625-1eb2-cf36-5663-a1dbb223989c
msgctxt "h2c944885g151eg40b1gbc09gbbddb4713039"
msgid ""
"You speak as if this affects you alone. How many will die if you unleash "
"what's inside you?"
msgstr "넌 이게 너만의 일인 것처럼 말하네. 네가 네 안의 그걸 터뜨리면, 몇 명이나 죽게 될 것 같아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 75390c98-d36b-8ed4-2f6e-65a5d9731083
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:75390c98-d36b-8ed4-2f6e-65a5d9731083
msgctxt "hf47385b1g2d03g4167g9c98gdd90b1eba9fb"
msgid ""
"Is this truly what you want, to die for the promise of Mystra's forgiveness?"
msgstr "용서해주겠다는 미스트라의 약속을 위해 죽는 게 네가 진정으로 원하는 바야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 79079919-c358-c25d-a6f2-d385bf44ee92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(5) = False
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithGale(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:79079919-c358-c25d-a6f2-d385bf44ee92
msgctxt "h9430fedag911eg43fag9895g9e0640b95f04"
msgid "<i>Lean in for a kiss.</i>"
msgstr "<i>기대어 키스한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 79a0c48b-bfcc-4d44-78ea-03dc8dfd64b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:79a0c48b-bfcc-4d44-78ea-03dc8dfd64b2
msgctxt "h6e1c0775g3841g4fadgabc5gbca54aaba656"
msgid ""
"Why are you so sure it's inevitable? We haven't even found this 'Heart of "
"the Absolute' yet."
msgstr "왜 피할 수 없는 운명이라고 그리 확신해? 아직 그 '절대자의 심장'이란 게 뭔지 찾아내지도 못했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 7a766723-349c-6f2c-78b1-0425d93e5671
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:7a766723-349c-6f2c-78b1-0425d93e5671
msgctxt "h32635012ge76fg4301ga2a6g7cb9ec9a14f3"
msgid ""
"This may be my last night alive. I wanted it to be under a canopy of beauty "
"and wonder..."
msgstr "지금이 어쩌면 살아서 지내는 마지막 밤일지도 모르지. 그렇다면 아름다움과 경이 아래서 보내고 싶었어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 7add09f6-d1a1-3284-fa6e-fc1afc6ede84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:7add09f6-d1a1-3284-fa6e-fc1afc6ede84
msgctxt "hb24483a8ge0d9g456ag99aag356567cb07b2"
msgid ""
"I thought this place might bring me peace. I thought it might make the "
"weight of what I must do feel a little lighter... but I am not so sure."
msgstr "여기선 내가 평온함을 얻을 거라고 생각했어. 내가 짊어진 숙명의 무게가 조금은 가벼워질 거라 생각했는데... 잘 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 7bdf84c1-e335-8e7c-ac54-658115afa052
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:7bdf84c1-e335-8e7c-ac54-658115afa052
msgctxt "ha311c257g0274g400cg92f6ga7aec7cc1d4f"
msgid ""
"I'm not going anywhere, Gale. I'll be by your side, whatever dawn brings."
msgstr "난 아무 데도 안 가, 게일. 새벽이 뭘 불러오던, 난 네 곁에 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 7e7169a7-06e0-d246-ba4e-f0b5f31d7706
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:7e7169a7-06e0-d246-ba4e-f0b5f31d7706
msgctxt "he137cc33g678cg4609g85e8g9c72d1b11881"
msgid ""
"It's a heavy burden, yes - but one you're able for. Think of the good your "
"sacrifice will do."
msgstr "분명 무거운 짐이지, 그래. 하지만 너만이 짊어질 수 있어. 네 희생으로 얼마나 많은 목숨을 구할 수 있을지 생각해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 80fa083c-683c-c1c5-8598-0f412c441d8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:80fa083c-683c-c1c5-8598-0f412c441d8e
msgctxt "h84277aa4g45e2g4f83gb3a9g1cf89a12decd"
msgid "So it is. But a very fine one."
msgstr "그렇긴 하지. 하지만 아주 훌륭한 환상이라고. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 817385f0-d4e1-b417-8aac-918feb9f490c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:817385f0-d4e1-b417-8aac-918feb9f490c
msgctxt "h23b28122gf3a1g4a68ga3f9ged5f26c9fe94"
msgid "You're out of practice."
msgstr "연습 좀 해야겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 82f73c63-835b-cdd2-c3ef-bf46f2c2a1a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushAwayFromDeath(5) = True
#.     - CAMP_GalesLastNightAlive_SD_ROM_Event_CollateralDamage(5) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:82f73c63-835b-cdd2-c3ef-bf46f2c2a1a9
msgctxt "h668e4f23g19ceg4fd9gb8dfg4935542d5b20"
msgid ""
"Nothing is inevitable. Not when we face it together. You don't have to die."
msgstr "우리가 함께 상대한다면 불가피한 건 없어. 넌 죽지 않아도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 8506fe14-f44b-4171-fb8a-45b86959744d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:8506fe14-f44b-4171-fb8a-45b86959744d
msgctxt "heb8d5528gfca8g432bg99b8g687ed239f4a5"
msgid ""
"Babe or crone, coward or hero, death is assured. Mystra's forgiveness is "
"not. If you knew the end was near, would you not want to ensure it had "
"meaning?"
msgstr ""
"갓난아이와 노파, 겁쟁이와 영웅, 죽음은 그 모두에게 똑같이 약속되어 있지. 미스트라의 용서는 아니야. 만약 끝이 임박했다는 걸 안다면 "
"적어도 그게 의미가 있기를 바라지 않겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 8658f5b8-e3bb-6212-6b69-264385d10bc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:8658f5b8-e3bb-6212-6b69-264385d10bc7
msgctxt "h75470003gfa44g400bg9abagc44d5b06008a"
msgid "The cradle of eternity."
msgstr "영원의 요람이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 8691c4fe-ab69-6e50-84ab-871f162c5fe8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:8691c4fe-ab69-6e50-84ab-871f162c5fe8
msgctxt "hd4768117g88c9g4d79g8f22gc05cb2c17391"
msgid "I wanted to see you. While I still could."
msgstr "널 보고 싶었어. 아직 그럴 수 있는 동안."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 8a3b9199-39bc-6d43-587e-fd8d590d5f02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:8a3b9199-39bc-6d43-587e-fd8d590d5f02
msgctxt "h20def50cgae80g4525g994dg349b5dfe9554"
msgid ""
"My favourite spot. Many times, evening turned to night and back to daybreak "
"once more while I sat here, lost in words."
msgstr ""
"내가 가장 좋아하는 곳이야. 이곳에 앉아 있는 동안, 저녁이 밤이 되고, 다시 새벽이 찾아오곤 했지. 아무런 말도 없이, 계속해서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 8ae0073c-baf3-5c55-b9a1-a50ded48e464
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp6(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:8ae0073c-baf3-5c55-b9a1-a50ded48e464
msgctxt "h265b52c5gbc04g475fg8e7agbf0767e9c643"
msgid ""
"Yes... but there is so much to live for, and so few moments in which to "
"house it all."
msgstr "그래... 하지만 살아갈 가치는 너무도 많아. 하지만 그것을 담을 순간은 너무나 짧지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 8c0c346b-ecaa-c6d2-038e-12c31a6d592a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:8c0c346b-ecaa-c6d2-038e-12c31a6d592a
msgctxt "h513998abg35f4g4570g9891ga2ee5bc3c891"
msgid ""
"That's a relief. It would be a shame to spend my final hours making an ass "
"of myself."
msgstr "정말 다행이다. 마지막 순간을 거절당하면서 보냈다면, 정말 비참했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 8d06f4e6-d710-135f-2789-c45b3f03ef5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:8d06f4e6-d710-135f-2789-c45b3f03ef5b
msgctxt "h2010c3f1gc797g44a6gb405g1fd4542afcdc"
msgid "Why did you summon me here?"
msgstr "왜 여기로 부른 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 90309541-8f2b-b69f-dd14-3deaa237bcbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:90309541-8f2b-b69f-dd14-3deaa237bcbf
msgctxt "h5a5a826egce97g43bfg95bfgb262f005bb08"
msgid "<i>Stay with him and watch the stars in silence.</i>"
msgstr "<i>그와 함께 조용히 별을 바라본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 906092f0-ae93-aef0-f8fd-59d0ae883eaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:906092f0-ae93-aef0-f8fd-59d0ae883eaa
msgctxt "h77234d2dgc2f5g4fb5g9242g0edcf93b49f3"
msgid "Leave it to you to seduce someone with a book."
msgstr "책으로 누군가를 유혹하는 건 역시 네가 전문이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 912bb8a1-bda7-df00-1e8a-6a7566f8ed05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:912bb8a1-bda7-df00-1e8a-6a7566f8ed05
msgctxt "h8d662d18g1a81g4d43ga81dg72eb381c8cbe"
msgid "I don't need illusions. I want the Gale standing right in front of me."
msgstr "환영은 필요 없어. 난 내 앞에 서 있는 게일을 원해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 931ca3c1-6991-2fea-b430-6e7b472ebe1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:931ca3c1-6991-2fea-b430-6e7b472ebe1d
msgctxt "ha993fe6cg9d85g4cc6ga8efgdb11ceefeda5"
msgid ""
"I see... well perhaps this is for the best. Should my time be short, you "
"will not be wounded too deeply by my absence."
msgstr "그렇구나... 어쩌면 그게 최선일지도 모르지. 내 시간이 짧더라도, 내가 없어서 지나치게 상처받을 일은 없을 테니까 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 94321f4c-7042-2e48-ddf5-f90e975707fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(5) = False
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithGale(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:94321f4c-7042-2e48-ddf5-f90e975707fb
msgctxt "hf4e2460eg91e3g4967g99a2g00486004eedc"
msgid "I'm in love with you too."
msgstr "나도 널 사랑해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 94349000-0e08-ba51-6fc0-8a19d58abe35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:94349000-0e08-ba51-6fc0-8a19d58abe35
msgctxt "hf8e15613g20bdg4790ga0cag7900968a55d1"
msgid "I love this time of night."
msgstr "난 이 밤 때가 참 좋더라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 98d0c6e8-72f8-95b8-5126-a74356b25be3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:98d0c6e8-72f8-95b8-5126-a74356b25be3
msgctxt "hc244a645g09aeg4a6bg80c7gddb99287df3b"
msgid ""
"Stay with me a while, will you? Day will come all too soon, even in this "
"place."
msgstr "잠깐 내 곁에 있어줄 수 있을까? 이런 장소에서도 아침은 너무나 빨리 찾아오거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 9b20c2f4-b26d-6bee-d938-7e7d3d8a68b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Gale_State_WasInLastNightAlive(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:9b20c2f4-b26d-6bee-d938-7e7d3d8a68b6
msgctxt "h364df565g97a3g4306ga5f0gd2d3ae360d87"
msgid "That most beautiful of fantasies."
msgstr "그건 가장 아름다운 환상이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 9b7c4ab5-cfa2-82b4-85d6-8a3390c0ff6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:9b7c4ab5-cfa2-82b4-85d6-8a3390c0ff6e
msgctxt "h4350cb8ega030g46d0gbc56g39aaf352022f"
msgid "...but we shall try."
msgstr "...그래도 시도는 해봐야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 9c037525-e469-52db-d532-43c7afe9c5f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:9c037525-e469-52db-d532-43c7afe9c5f3
msgctxt "h82ac6d98g2f02g4832ga8dfga3d16309bfb0"
msgid "Not if I have any say in the matter."
msgstr "내가 결정할 수 있는 일이라면 그렇게 되진 않을거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 9db92ec7-eb67-178f-aacb-8699d615fb7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Partnered(5) = False
#.      - ORI_State_DatingGale(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:9db92ec7-eb67-178f-aacb-8699d615fb7e
msgctxt "he3645519g3735g4c3agb004g83be7f9876ab"
msgid "...and with company to match."
msgstr "...그에 걸맞는 사람과 함께 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = 9dc305b6-d250-88a4-3e7e-09ac7f56d17e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:9dc305b6-d250-88a4-3e7e-09ac7f56d17e
msgctxt "h5a4a1706gdf84g4136g932fg3b10bd7011aa"
msgid "What do you say?"
msgstr "어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = 9dcc335d-7896-31e2-78ea-e2bdc1055540
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:9dcc335d-7896-31e2-78ea-e2bdc1055540
msgctxt "h38c2323cg260bg4d23g9f25g8ef5c26fb80b"
msgid "I want to be with the real Gale - the man, not the fantasy."
msgstr "난 진짜 게일과 함께하고 싶어. 게일의 환상이 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = a08c020f-89e6-9cd4-5592-055d78f0f928
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a08c020f-89e6-9cd4-5592-055d78f0f928
msgctxt "h293e728fg0476g46fbgb7abgb3b32444c77c"
msgid ""
"Thank you. But even if we do find another way, perhaps this is the <i>right</"
"i> way. The end fate wishes for me."
msgstr ""
"고마워. 하지만 다른 방법을 찾아내더라도, 이게 유일한, <i>올바른</i> 방법일지도 몰라. 내게 내려진 최후의 운명인 셈이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = a252a191-cf32-8708-16bb-d14920e92608
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a252a191-cf32-8708-16bb-d14920e92608
msgctxt "h20a8a269g3767g4d7cg8ee3g58e482226ce1"
msgid ""
"The scene is this: you and I stand in the room that is the centre of my "
"universe."
msgstr "이 장면은 이런 거야. 너와 나는 내 우주의 중심에 있는 방에 서 있는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = a59a1772-0d40-8010-8fec-5674356dbb4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a59a1772-0d40-8010-8fec-5674356dbb4b
msgctxt "hfc071669g9f2ag4d21g876dg4b7eb616d698"
msgid "Up all night reading? I do love that rebellious streak of yours..."
msgstr "밤새 책을 읽자고? 너의 그 반항적인 행보가 좋긴 하네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = a5a412d0-ebd4-8f8f-7597-cf5362fcc4e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a5a412d0-ebd4-8f8f-7597-cf5362fcc4e1
msgctxt "hcb571b59ge691g4016ga605g8d75b6abe06a"
msgid "I'm many things, but coy's not one of them."
msgstr "내겐 많은 특징이 있지만, 내숭을 떠는 편은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = a5dc22a0-f48d-0f34-d730-c716f6d50f59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp6(0) = False
#.      - Approval_AtLeast_-10_For_Sp6(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a5dc22a0-f48d-0f34-d730-c716f6d50f59
msgctxt "h5c770a56g8fc8g4365gb637gc65f81f0fdde"
msgid ""
"Your words are those of a dear friend, or a lover even. But this is no time "
"for delusions - fate threw us together, and mutual survival kept us together."
msgstr ""
"너의 말소리는 소중한 친구나 연인의 말처럼 다가와. 하지만 지금은 망상에 빠져 있을 때가 아니야. 운명이 우리를 함께하게 했고, 우린 "
"살아남기 위해 하나로 뭉쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = a766f4f8-4317-fe55-c32b-8851b3c96742
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a766f4f8-4317-fe55-c32b-8851b3c96742
msgctxt "h6b3294e7g6d41g4a4cg95f6g2522c96b105e"
msgid "I'll remind you we're newly acquainted, not newlyweds."
msgstr "우린 만난 지 얼마 되지 않은 사이야, 신혼부부가 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = a787ea05-3f03-148a-9f7d-5c4f183db2cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a787ea05-3f03-148a-9f7d-5c4f183db2cb
msgctxt "h456150bdgbcf8g42a6gaa7eg8c01dc55dbb7"
msgid ""
"Afraid? No, I am <i>terrified</i>. But fear or courage or reason cannot "
"change the charge I've been given."
msgstr "불안? 아니, 난 지금 <i>무서워</i>. 하지만 두려움이나 용기, 또는 이성으론 내 운명을 바꿀 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = a975127b-f46d-c9f4-a7f8-5e7e3213e3b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:a975127b-f46d-c9f4-a7f8-5e7e3213e3b6
msgctxt "hb11ca966g7f95g40beg93f5g8678799ed4bc"
msgid ""
"The sculptures, the paintings, the walls enlivened by the spines of a "
"thousand books."
msgstr "조각상들, 그림들, 천 권의 책들이 벽을 가득 채우는 모습."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = ad4448eb-1592-3fcc-0349-38913913e6d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:ad4448eb-1592-3fcc-0349-38913913e6d6
msgctxt "he781d798gd0a3g4813gbe73gd7b4376babe7"
msgid "That's your perfect? It seems... lonely."
msgstr "이게 네가 말한 완벽이야? 좀... 쓸쓸해 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = ade91b17-7450-c7ad-085c-00747c8819d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:ade91b17-7450-c7ad-085c-00747c8819d6
msgctxt "h6f30d85fg0afeg41e9gbb44g486b5d48f589"
msgid "Are you not afraid?"
msgstr "불안하지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = aed08a6c-3a47-b512-4919-4fb74d901e72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:aed08a6c-3a47-b512-4919-4fb74d901e72
msgctxt "hb52f49c8gc723g4611ga9edgfb4cc7c1ec7e"
msgid "I think that sounds delightful - but I don't see a bed."
msgstr "즐거울 것 같네. 그런데 침대는 안 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = b1f1cc6f-fce8-a6c9-42e7-d3bcca8f0d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:b1f1cc6f-fce8-a6c9-42e7-d3bcca8f0d2d
msgctxt "he88be8f9g068dg4377g8d56g8d192183a56c"
msgid "A good night indeed. The fairest I can imagine..."
msgstr "그래, 정말 좋은 밤이야. 내가 상상할 수 있는 가장 아름다운 밤이야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = b32f64e5-cd67-367d-db29-bdb3eee2424b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:b32f64e5-cd67-367d-db29-bdb3eee2424b
msgctxt "he8a3e3a9g522ag4977gbb72g2113f9beecfc"
msgid ""
"And you're a bad liar. I lived the life of a hermit for some time before I "
"met you - safer for all, but not conducive to pleasures of the flesh."
msgstr ""
"그리고 넌 거짓말에 소질이 없구나. 널 만나기 전에는 한동안 은둔자의 삶을 살았어. 모두에게 안전했지만, 육체적인 쾌락을 누리는데는 "
"도움이 안 됐지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = b6dfd321-1767-6bfb-9d0f-1375ddbc7435
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:b6dfd321-1767-6bfb-9d0f-1375ddbc7435
msgctxt "h0babc431g9a57g4a8ag8473g7563195ccd21"
msgid ""
"Then let's set the book aside an be blank slates on blank sheets, "
"delightfully new."
msgstr "그럼 책은 제쳐두고, 우리가 새하얀 종이가 되어 그 위에 우리만의 새로운 역사를 써 내려가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = b8799dfe-5cc6-7dd0-5cdd-07f4da886c33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:b8799dfe-5cc6-7dd0-5cdd-07f4da886c33
msgctxt "h50193e0fgca29g40f8g8aa6g506adb935fb7"
msgid ""
"Resigned to it, rather. But that is not to say I am without fear. Far from "
"it."
msgstr "아니, 체념한 거에 가깝지. 하지만 그렇다고 두렵지 않은 건 아니야. 엄청 두렵지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = bb56ce18-00c2-d779-87be-229c5effb27a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:bb56ce18-00c2-d779-87be-229c5effb27a
msgctxt "haaf24735gee72g44c8g9a26g2d6eabcda88e"
msgid "I'm afraid all of this is just a fantasy."
msgstr "미안하지만 이건 전부 환상에 불과해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = d24612d1-57aa-0904-5ec3-f7e596a14887
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:d24612d1-57aa-0904-5ec3-f7e596a14887
msgctxt "h14cfe573gd44bg48b1gb191g389f7cd9d755"
msgid ""
"If things were different, if we were home, I'd have taken the time to do "
"things properly. To say it all better. But time is short."
msgstr "상황이 달랐더라면, 고향에 있었더라면, 시간을 들여서 제대로 준비했을 거야. 나은 고백을 하려고. 하지만 시간이 많지 않으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = d3f5bdd5-1c12-a01e-1e28-8a178a06c561
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:d3f5bdd5-1c12-a01e-1e28-8a178a06c561
msgctxt "h5dd3be92g2184g44b6g8ecfg49b6f6952c27"
msgid "All right then. Wow me."
msgstr "좋아. 날 놀라게 해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = d6673773-82af-dd0a-f9c4-a4fc5316e951
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:d6673773-82af-dd0a-f9c4-a4fc5316e951
msgctxt "hd1bb4556g9923g4442gb498g6532cacd83bd"
msgid ""
"But it will not matter, soon enough. Let us just enjoy the view, in silence. "
"We will leave the world a better place than it is tonight."
msgstr "하지만 곧 아무 의미도 없어지겠지. 그저 조용히 이 경치를 즐기자고. 우리가 떠나고 나면, 세상은 지금보다 좋은 곳이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = d8bf8e67-8436-0afd-988e-dc08d43c0af1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GalesLastNightAlive_SD_ROM_Event_CollateralDamage(5) = False
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushTowardsDeath(5) = True
#.     - CAMP_GalesLastNightAlive_SD_ROM_Event_CollateralDamage(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:d8bf8e67-8436-0afd-988e-dc08d43c0af1
msgctxt "h4b024c41g44edg4cfeg9955g4f98c1f50e53"
msgid ""
"You're right. At least this way, you might take the Absolute down with you."
msgstr "네 말이 맞아. 그 방법을 쓰면 절대자도 같이 데려갈 수 있을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = dae5e0a9-7dbb-dd54-0a79-798a25ece662
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:dae5e0a9-7dbb-dd54-0a79-798a25ece662
msgctxt "hb6baae0ega9b0g4156g96f2gb2901386a72c"
msgid ""
"Stay with me, will you? I don't want to think of it any more, but I don't "
"want to be alone either."
msgstr "나랑 같이 있어 줄래? 더는 고민하고 싶지 않지만, 그렇다고 혼자 있는 건 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = db9ed752-3d55-569c-df46-20257310407b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:db9ed752-3d55-569c-df46-20257310407b
msgctxt "he29d4db6ge168g48c0gb07eg9e8564ffa53f"
msgid ""
"I can feel it - ever since we set foot in this strange, corrupted land. The "
"closer we get, the heavier my own heart becomes."
msgstr "느낄 수 있어. 이 기괴하고 썩은 땅에 발을 들인 순간부터 느낄 수 있었어. 가까워질수록 내 심장이 점점 더 무겁게 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = dd5b3f8b-d351-403c-a2c7-587ab94b13a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:dd5b3f8b-d351-403c-a2c7-587ab94b13a2
msgctxt "hd56a2500g58b5g4083g9359gd57cc7440cd6"
msgid ""
"When you wake, it will be back at our camp, back in our small, dirty, bloody "
"patch of existence. But stay with me now. There are endless worlds out "
"there. Countless ways to declare love. Infinite ways to express it. Too much "
"for one night..."
msgstr ""
"눈을 뜨면, 우린 다시 야영지로 돌아갈 거야. 그 작고 더러운 우리의 존재로. 이 순간 나와 함께 있어 줘. 거기엔 끝없는 세계가 있어. "
"사랑을 선언하고 표현할 무궁무진한 방법이. 하룻밤으로는 부족할 정도로..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = ddb6710c-7c11-946e-8ce7-28de8462add3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingGale(5) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:ddb6710c-7c11-946e-8ce7-28de8462add3
msgctxt "h46e99ed8gabdag477dgb084gde51e5ab819c"
msgid "I don't feel the same way."
msgstr "난 그렇게 느끼지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Player
#. NodeID = e29bfd51-e484-6a81-8d3b-c705e90c483f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:e29bfd51-e484-6a81-8d3b-c705e90c483f
msgctxt "hbadebfebg0c0fg47c3gae08g6438b91c0d7c"
msgid "I'd rather not listen to you wallowing in self-pity. Good night, Gale."
msgstr "자기연민에 젖어서 중얼거리는 걸 들어주지는 않는 게 좋겠어. 좋은 밤 보내, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = e4a35a3d-4915-ce99-f781-670cd1cb8d6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:e4a35a3d-4915-ce99-f781-670cd1cb8d6d
msgctxt "hfa083ff3g38b4g4fcbgb895g0b7026d33372"
msgid ""
"Indeed. The curse is still present of course - just veiled and at arm's "
"length for now. Not a trick I can repeat often, but tonight? Tonight is "
"different."
msgstr ""
"그래. 저주는 여전히 존재하지만, 지금은 얄팍한 장막에 가린 채 잠시 떨어져 있어. 자주 보여줄 수 있는 건 아니지만, 오늘은... "
"오늘은 달라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = e75e3a5c-a381-130e-2967-4ca18e212acc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:e75e3a5c-a381-130e-2967-4ca18e212acc
msgctxt "hb81c1c98g9656g4246gacccg7b3b190bbfd3"
msgid "A fair assessment - I wish we had more time to practice together."
msgstr "합당한 평가야. 같이 연습할 시간이 더 많았으면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = e7c356a9-72f5-dac9-05ea-0a909b4dbfe8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:e7c356a9-72f5-dac9-05ea-0a909b4dbfe8
msgctxt "h381df915g6e84g4ed2g9148g29e931954ceb"
msgid ""
"As you like. Thank you, for spending this time with me. If only there was "
"more."
msgstr "그래. 고마워. 이 시간을 나와 함께해 줘서. 시간이 좀 더 많았다면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = e841b573-15a8-cb07-0efe-aab08c3c5a55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:e841b573-15a8-cb07-0efe-aab08c3c5a55
msgctxt "hacfd9aaeg5c90g451cgaeabgbb3ef0e66528"
msgid ""
"It's called 'The Art of the Night', and it details the first thousand nights "
"of a newlywed king and queen."
msgstr "'밤의 예술'이라는 책이야. 신혼을 맞은 왕과 왕비의 첫 천 일 밤이 자세히 담겨 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = ee25edbd-837b-8cb2-38eb-498cbfd89422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:ee25edbd-837b-8cb2-38eb-498cbfd89422
msgctxt "h761c3ed7g483eg4435g960cg5ba106112cf7"
msgid ""
"Fewer than if the Absolute goes unchecked. I don't want to kill, and I don't "
"want to die... but inaction will lead to bloodshed all the same."
msgstr ""
"절대자를 막지 못했을 때 죽게 될 이들보다는 적겠지. 나도 죽이고 싶지 않아. 죽고 싶지도 않고... 하지만 행동하지 않아도 피를 본다는 "
"건 변하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = f29b57c3-d1f5-33ac-5eb4-0b8d3a480e18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:f29b57c3-d1f5-33ac-5eb4-0b8d3a480e18
msgctxt "hd47298e7g933bg4db6g971bg00dcbd1b71d5"
msgid "I say we take a page from their book."
msgstr "그 책을 우리가 실행에 옮겨 보는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = f2ed30dc-b5ec-69ef-812a-42f74e1a8c1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:f2ed30dc-b5ec-69ef-812a-42f74e1a8c1b
msgctxt "h372bb96cgae63g45c7g8ecege7af8d9ce113"
msgid "The timelessness of lovers."
msgstr "시간을 초월한 연인들의 사랑이기도 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = f6ea188e-4e93-3a96-4901-316e662454e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:f6ea188e-4e93-3a96-4901-316e662454e2
msgctxt "he9230e84g9cbeg41a9g8983ga3ebbe370c47"
msgid "I'm in love with you."
msgstr "너를 사랑해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = f9a9a027-d679-41ce-a0d6-44658e0aca2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:f9a9a027-d679-41ce-a0d6-44658e0aca2e
msgctxt "hf0fca314gd190g4391g9608g07a44f0807ea"
msgid ""
"Damn you. Damn you for giving me so much to care about. Our friends, our "
"adventures... this would have been so much easier if it was just me. But it "
"isn't."
msgstr ""
"젠장. 너 때문이야. 너 때문에 소중한 게 너무 많이 생겼어. 친구도, 모험도... 나 혼자였다면 훨씬 쉬웠을 텐데. 그렇지 않게 됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = fa097aad-ab46-721d-d7d8-49a68587e623
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:fa097aad-ab46-721d-d7d8-49a68587e623
msgctxt "hcf523f1cgf8c9g469egbf74gc1c04758e1a1"
msgid ""
"I want it to be perfect - to bond with you in the way that gods do... "
"intertwining our spirits in visions of the Weave."
msgstr "완벽했으면 좋겠어. 신들이 그랬던 것처럼 너와 하나가 되고 싶어... 위브의 환상 속에서 우리의 영혼을 하나로 엮고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM
#. Speaker = Gale
#. NodeID = fbef7c10-5726-f490-fcbb-8d179ed7fea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_GalesLastNightAlive_SD_ROM:fbef7c10-5726-f490-fcbb-8d179ed7fea6
msgctxt "hebdf758egb92fg479dga32eg2360362a9924"
msgid ""
"I will be, soon. I am perhaps just one hard day away from being without any "
"troubles at all."
msgstr "곧 괜찮아질 거야. 하루만 더 노력하면 골치 아픈 문제에서 완전히 벗어날 수 있을지도 모르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 0b7916b4-50ab-cff0-ab79-3bdeedc44cec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:0b7916b4-50ab-cff0-ab79-3bdeedc44cec
msgctxt "h1d23ac49g39fdg430ega425g02a10c6d7eb0"
msgid "Do not misunderstand me. I want this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 1d28d08a-2030-15b0-828a-96f42076e367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:1d28d08a-2030-15b0-828a-96f42076e367
msgctxt "h52072a5ag5801g46bbgbd34g41ba437e51e5"
msgid "You're not wrong. This was a mistake."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 1e5f4e2c-afff-949c-faa2-e9c2f58a34e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:1e5f4e2c-afff-949c-faa2-e9c2f58a34e1
msgctxt "he1281666gaae2g4873gaf3dg096d49125adf"
msgid ""
"Perhaps a little. Do you know how hard it's been for me to contain myself?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 211391ce-8c18-d383-98e2-af4d0dc8fe5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:211391ce-8c18-d383-98e2-af4d0dc8fe5e
msgctxt "h929ae370ga2e8g4078g86b4g9d49633fa868"
msgid "I'm not here to talk."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 270c8a81-1a5f-1bad-2a02-b071784035af
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Event_SexElfForm = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:270c8a81-1a5f-1bad-2a02-b071784035af
msgctxt "h0dad614cg9f7fg4660g8d50gba7e7dc2a680"
msgid "I need no further encouragement..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 2756eb5f-05b9-53bd-330b-4f423a1328a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:2756eb5f-05b9-53bd-330b-4f423a1328a2
msgctxt "h0e1cbc95gdcbeg4298ga18ag224d4600e040"
msgid "I'm flattered I have that effect on you. Now come here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 2a2421d2-7b38-abdf-44c4-694d6e82d19d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:2a2421d2-7b38-abdf-44c4-694d6e82d19d
msgctxt "h8b801bc2ga9aeg4d61g812fgc3daecec2eb9"
msgid "Oh. If that's what you prefer, so be it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 3618351b-5f74-d975-a76e-f6db4ab147a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:3618351b-5f74-d975-a76e-f6db4ab147a4
msgctxt "hf97bde6cg1846g4ef5g9bd3g347fe53704ab"
msgid "Just as nature intended. Come here to me -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 3f731130-b2fb-02d2-cd0b-b442f3bc7c63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:3f731130-b2fb-02d2-cd0b-b442f3bc7c63
msgctxt "h7c445f9bg70c1g4283gaca7g28aadf1d4e21"
msgid "You... like it?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 42b18a91-7c2c-9db4-9eda-b931c3d8e506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:42b18a91-7c2c-9db4-9eda-b931c3d8e506
msgctxt "h0893ae0bg4a80g4702g92c4g958f8c5b9065"
msgid "Now that you say it, perhaps this was a mistake. I should leave."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 4e724aa1-6aba-8de6-cba2-563597b5f9b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:4e724aa1-6aba-8de6-cba2-563597b5f9b3
msgctxt "hbef3e645g4b7eg4fcegb26eg0b70f3764b1f"
msgid "Don't be frightened."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 4e8728f4-7f36-69cf-ca61-b4b07b430749
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:4e8728f4-7f36-69cf-ca61-b4b07b430749
msgctxt "h2100b8d3ge689g4139g8524g623d69bf5eaf"
msgid "Yes you are. And you're perfect."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 5f10707d-607a-8a86-c976-113d8ca31315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:5f10707d-607a-8a86-c976-113d8ca31315
msgctxt "h8f4b57bcg1330g4417g839bg66acf9c125ee"
msgid "Come. Feel for yourself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 62740113-ae59-441b-8abe-fe05f56f1e2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:62740113-ae59-441b-8abe-fe05f56f1e2a
msgctxt "h1d282821g2bb7g47b7g91acg8e0942adaa62"
msgid ""
"You came. I was concerned you might have had doubts. Or that this might have "
"all been too soon..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 6e271f03-15df-b91e-488a-22ee22687591
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:6e271f03-15df-b91e-488a-22ee22687591
msgctxt "hc639ffcege49cg431dg9dfege0274d6c11a2"
msgid "Of course. What else do you think I'm here for?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 6fb542c4-9fd6-e2f7-8c72-7a264af53f39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:6fb542c4-9fd6-e2f7-8c72-7a264af53f39
msgctxt "h851b725fg0c1fg4376gb0c9g944a29b07b36"
msgid ""
"Are you certain? It will be untamed, vigorous, and, well... <i>large</i>. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 77243c5c-4c90-4792-4f40-7a4bcff2678b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Event_DeclinedSex = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:77243c5c-4c90-4792-4f40-7a4bcff2678b
msgctxt "h8bcb7892g36b8g4d09ga00cg807de72e51a0"
msgid "Ah... I see. Well, of course. Back to camp then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 78b4a8cc-e225-a7e9-5f85-77a17eb102ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:78b4a8cc-e225-a7e9-5f85-77a17eb102ac
msgctxt "hbf94c3c8gaee3g4a9cgbe79g487b12ede2f4"
msgid "More?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 7c914fc2-34c0-9c43-cf22-98e0c8f4cabe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:7c914fc2-34c0-9c43-cf22-98e0c8f4cabe
msgctxt "h45d75f81gf010g4d19ga54ag10358ed40f26"
msgid "Nevertheless, I will be gentle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 812ac82f-d700-4a94-bf1d-0aa8d8a8ab9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:812ac82f-d700-4a94-bf1d-0aa8d8a8ab9c
msgctxt "h254481e4gc19cg425egb735g33f9091c11df"
msgid "Or at least I will try."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 8144e082-ef7b-3dfb-3b0d-d2fe60ca28ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:8144e082-ef7b-3dfb-3b0d-d2fe60ca28ad
msgctxt "hda9e91d6g124ag462bga89cg96a3df0e160c"
msgid "Yes. Change back again. Let me have the beast... and the beast have me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 83727a34-7f0c-d93c-e7e9-c346089612d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:83727a34-7f0c-d93c-e7e9-c346089612d9
msgctxt "hbd9ee2degd467g441dg91c2g36403159b57d"
msgid ""
"Forgive me. I... lost the run of myself. Sometimes, if blood runs hot "
"enough, it's difficult to tame the beast."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 8873367b-d95d-9a3b-1abb-44609f47fa65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:8873367b-d95d-9a3b-1abb-44609f47fa65
msgctxt "h9b54de74g0c80g4cbcg93bag4267cc40f815"
msgid "I trust you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 89b55255-d3bd-2ec0-b0ae-b76e7c8bae53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:89b55255-d3bd-2ec0-b0ae-b76e7c8bae53
msgctxt "h086b0004gdea8g4d2cgbbb5gde2bf719ac01"
msgid "Something to keep in mind for another night. But for now, come here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 8d41355f-18ee-8598-b0db-8c557f28f987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:8d41355f-18ee-8598-b0db-8c557f28f987
msgctxt "h0b0311b4g3b33g4ff4gb373g139fdc1b90e2"
msgid "More?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 8dc11788-3214-eb97-80ed-d9137b9e0ed0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:8dc11788-3214-eb97-80ed-d9137b9e0ed0
msgctxt "h16b8b981g1485g445eg84f8gad94da0340e5"
msgid "Why, is the big, strong Archdruid Halsin nervous? Adorable."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = 8f228a58-90c8-8e3c-f2a6-8650ae2a45a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:8f228a58-90c8-8e3c-f2a6-8650ae2a45a0
msgctxt "he0eaa81agd38bg4540gad53g6da43109061a"
msgid "Actually... I spoke in haste. I think I should leave."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 97aa1db2-0cf2-db3d-ff6a-c0be0411abdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:97aa1db2-0cf2-db3d-ff6a-c0be0411abdc
msgctxt "h6520238bgd9deg4f88g99e6g83c47090d159"
msgid "Almost frightened. If you feel my heart quicken, it's not from fear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = 981edb82-e1cd-837a-6e3b-ea3617173b11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:981edb82-e1cd-837a-6e3b-ea3617173b11
msgctxt "he63d787fgd677g4907g9bf0gdcde63edab9d"
msgid "As have I. It's been worth the wait."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = aa9fa62e-21f8-35cc-4bb5-ea3d040b4c3b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Event_SexWithBearForm = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:aa9fa62e-21f8-35cc-4bb5-ea3d040b4c3b
msgctxt "h25e5330cg6a2ag467eg9c8aga9cc45668562"
msgid "Just imagine we're back in the woods... and I'm your prey."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = b04fee62-76d3-887a-edac-aadac1c7dc9b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Event_SexWithBearForm = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:b04fee62-76d3-887a-edac-aadac1c7dc9b
msgctxt "h6bea035cgf79eg40c4g938bge02c8fa498a4"
msgid "Large is what I'm here for."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = b5890af3-5616-2a9e-dbb1-313db0e29954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:b5890af3-5616-2a9e-dbb1-313db0e29954
msgctxt "h3f3bb96agb459g4f7eg99e6g215d9a5f4fcf"
msgid "As I do you. But nevertheless, I will be gentle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = b8620917-b229-62be-b11f-663ad1eea2d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:b8620917-b229-62be-b11f-663ad1eea2d4
msgctxt "h2d37b1a6gbd69g4297g9566gaf5e9dc480b3"
msgid "As do you, I think."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = c1b9200a-66ab-3e53-9194-f8f7a1958531
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:c1b9200a-66ab-3e53-9194-f8f7a1958531
msgctxt "h66c533c7gf93eg40a2g87e2g8f6c1d720075"
msgid "Don't apologise. I like it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = c558a567-9b26-a174-f4e8-b5b3eb45405e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:c558a567-9b26-a174-f4e8-b5b3eb45405e
msgctxt "h856baa2dg2bdbg4603gb11agea8c8f3c6640"
msgid "Another time then, perhaps. Now come here..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = c616a28a-b9d0-1058-7507-e13d00e3be85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:c616a28a-b9d0-1058-7507-e13d00e3be85
msgctxt "h26dc70eega2c7g43e9g92e2ga93c9f4bef7b"
msgid ""
"I'm almost frightened to touch you - if I give in, I may not be able to stop "
"until I have devoured you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = d7c91a29-1bb0-7c1a-e8a3-2254e04dd7ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:d7c91a29-1bb0-7c1a-e8a3-2254e04dd7ad
msgctxt "haadb9f70gf2a2g4b3agae41gf4b038c63aa1"
msgid "This was a mistake. I think I'd better get dressed..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = ed7ff5b6-bbb1-1284-d4c8-9ce56f3f5e1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:ed7ff5b6-bbb1-1284-d4c8-9ce56f3f5e1c
msgctxt "h529f1fd0g4dd9g4832gaaacgeec5e6a413c4"
msgid "Too soon? No - I've been waiting a long time for this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = edda7bb0-d81a-d378-f2fb-868fd206cf73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:edda7bb0-d81a-d378-f2fb-868fd206cf73
msgctxt "hd8858ca9g937eg4a77g8d5bg488e61d8b08d"
msgid "Put your doubts aside. I'm here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Player
#. NodeID = f56fc401-95fc-c95d-f743-38a217501ad9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:f56fc401-95fc-c95d-f743-38a217501ad9
msgctxt "h981ef9f6g91ecg4eb3g89a8gde69de4295f2"
msgid "You don't have to do this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM
#. Speaker = Halsin
#. NodeID = f82f2230-642d-43b2-7d62-12ec9ec292b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_HalsinRomanceAct3_SD_ROM:f82f2230-642d-43b2-7d62-12ec9ec292b8
msgctxt "h2fc0350bgdbadg475agb19eg3f40ecf28acb"
msgid "Nor am I."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation
#. Speaker = Lae'zel
#. NodeID = 1f78d667-d220-eb8a-7783-fd4b6cf6848d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation:1f78d667-d220-eb8a-7783-fd4b6cf6848d
msgctxt "h0c05f148gaff6g44b1ga3cfg49fab161cd86"
msgid "I've come to sate you, and be sated."
msgstr "내가 널 만족시키러 왔으니, 만족하겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation
#. Speaker = Lae'zel
#. NodeID = 4fa23218-5df0-bcaf-4121-813c283d18d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation:4fa23218-5df0-bcaf-4121-813c283d18d1
msgctxt "hb0143c64gac1dg4e42ga618g45477d31f855"
msgid "So you think. Let's see if you're right."
msgstr "확신하는군. 어디 확인해 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = 56478d2a-8dfa-6df1-798b-ae7272303033
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Laezel_Event_PlayRomance1_AfterCelebration(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation:56478d2a-8dfa-6df1-798b-ae7272303033
msgctxt "h5f4b6b02ge84bg4a23g921egd1618c733b37"
msgid "I am ready."
msgstr "준비됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation
#. Speaker = Lae'zel
#. NodeID = 5b282420-016f-8fc5-333f-ead0511169f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation:5b282420-016f-8fc5-333f-ead0511169f5
msgctxt "h5ab52de2g1bbcg461dga186g342ba64a468c"
msgid "Rest well. We will convene at dawn."
msgstr "푹 쉬어라. 우린 동틀녘에 집결할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation
#. Speaker = Lae'zel
#. NodeID = 70a8b15b-8fd7-090d-f6de-8c7b389dad6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation:70a8b15b-8fd7-090d-f6de-8c7b389dad6a
msgctxt "hd9a2df38g81dbg4c6bga22eg7451808a6b60"
msgid "I lead. You follow."
msgstr "내가 주도한다. 넌 따라라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation
#. Speaker = Lae'zel
#. NodeID = 72dc5476-c10d-93c2-9cc5-1fcd7c2feeff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation:72dc5476-c10d-93c2-9cc5-1fcd7c2feeff
msgctxt "had4bf73eg9d82g41bdg84fegbeca68126f91"
msgid "Disappointing."
msgstr "실망스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = dc4c63a8-7378-e13b-ff74-2c32d0290c3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Laezel_Event_Act1RomanceRefuse(1) = True
#.     - ORI_State_DatingLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_Romance1_SD_Invitation:dc4c63a8-7378-e13b-ff74-2c32d0290c3d
msgctxt "h91caa8c6g919eg4c87gb1f5gfcfd6827bc54"
msgid "I've changed my mind."
msgstr "생각이 바뀌었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = 6ca510fc-1808-454b-a426-1ad0e695c8dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:6ca510fc-1808-454b-a426-1ad0e695c8dc
msgctxt "h09970f09gae13g4becgb71egdbd5b6ffd25d"
msgid ""
"*You should return to the crèche. You have yet to insert the artefact into "
"the planecaster.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = 70135a24-fbb2-4e7a-1bd3-9c137e7d1afe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_UsedDevice = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:70135a24-fbb2-4e7a-1bd3-9c137e7d1afe
msgctxt "hfb410afegf058g41e3g80fbg6f64f528173d"
msgid ""
"*The <i>zaith'isk</i> failed you. You should return to the githyanki crèche "
"and speak with the inquisitor.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = 76aca882-5fa8-4b1b-b40e-a408969b8848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:76aca882-5fa8-4b1b-b40e-a408969b8848
msgctxt "h409a06dcg67deg4730g8aafgac2756c292c0"
msgid ""
"*You should find a githyanki crèche and enter its <i>zaith'isk</i>. It is "
"imperative that your infection is cleansed.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = bf14fa17-01b0-af39-3c2a-44f6b23f7f20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#.      - CRE_Templar_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:bf14fa17-01b0-af39-3c2a-44f6b23f7f20
msgctxt "hc3fee53fg7238g46dbgaedbg42038757d2a2"
msgid ""
"*You should return to the githyanki crèche and face the inquisitor who "
"turned against you.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = cd5a907d-9a41-7edf-6046-db4b33b3e496
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:cd5a907d-9a41-7edf-6046-db4b33b3e496
msgctxt "h289a61d3g9a2fg44fag99bcg8434f7734522"
msgid "*The thought fades, and you cross the border between waking and dream.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = da675552-c082-4080-1618-4977baefdd85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Knows_CrecheLocation = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:da675552-c082-4080-1618-4977baefdd85
msgctxt "h242238a1g219eg4d16g9b8egdb707a450886"
msgid ""
"*You should return to the githyanki crèche and access the <i>zaith'isk</i>. "
"It is imperative that your infection is cleansed.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = ea15c1bc-8e6d-3a39-4022-8328e8bb161f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:ea15c1bc-8e6d-3a39-4022-8328e8bb161f
msgctxt "h60f1e15ag6afag497bgb6f0g74d48134c7ef"
msgid ""
"*Your eyelids grow heavy and your heart begins to slow. In the fog of your "
"mind, a single thought sparks:*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection
#. Speaker = Narrator
#. NodeID = ed33306a-978c-9871-2ebb-39f327478ffb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Knows_FoundCreche = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Laezel_SD_ReturnToCrecheReflection:ed33306a-978c-9871-2ebb-39f327478ffb
msgctxt "h150cf654g2339g4fe0g94d4gff477284c397"
msgid ""
"*You should return to the githyanki crèche and enter the <i>zaith'isk</i>. "
"It is imperative that your infection is cleansed.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 05c53ddb-7e9a-fabe-246f-9452acfb7fe5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:05c53ddb-7e9a-fabe-246f-9452acfb7fe5
msgctxt "he86fcd5eg085eg4da4g8c8dgbea32ef6e8d8"
msgid ""
"You feel it, don't you? Primal hunger, irrepressible decadence. Forget the "
"heavens - <i>this</i> is paradise."
msgstr "느껴지지? 원초적인 욕망으로 허덕이게 되고, 타락하고 싶어 미칠 것 같잖아. 천국 따위는 잊어. <i>여기</i>가 낙원이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 0688b937-bcce-e3f4-e985-b51bfc516793
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:0688b937-bcce-e3f4-e985-b51bfc516793
msgctxt "h6f6da953g5324g465eg85dcg448d86752e98"
msgid "I can take it."
msgstr "난 감당할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 087d3799-2975-1bb3-a0fd-9c49412920b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:087d3799-2975-1bb3-a0fd-9c49412920b8
msgctxt "hc5a14ec0g7003g4d46g9b05g43ccc788e56f"
msgid ""
"To think how you've starved yourself up to this moment. To think how you "
"chose the sweet over the bitter."
msgstr "여태껏 네가 얼마나 자기 욕망을 억눌러 왔는지 생각해 봐. 항상 쉬운 길보다 어려운 길만 택해 왔잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 0e79bd2a-894e-9c77-b712-bbb4155eed3b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Minauros(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:0e79bd2a-894e-9c77-b712-bbb4155eed3b
msgctxt "ha2901ad9g0d44g4495gaed4g341d5aff7c75"
msgid "The polluted swamps of Minauros."
msgstr "미나우로스의 오염된 늪으로 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 0ea54df7-c48d-f065-f095-54951fbb4548
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_MizoraRomance_Event_Malbolge(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:0ea54df7-c48d-f065-f095-54951fbb4548
msgctxt "h3481c8ecg2367g4b31gae8bgff084b8049f8"
msgid ""
"*In Mizora's infernal embrace, you are lost to Malbolge. Her flesh is an "
"endless landscape of craggy hills and deep valleys to survey.*"
msgstr ""
"*지옥처럼 뜨거운 미조라의 품에 안기자, 당신은 말볼제로 떨어져 길을 잃습니다. 미조라의 몸은 끝없이 펼쳐진 봉긋한 언덕과 깊숙한 "
"골짜기의 향연입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 0fe404ba-9fbf-043e-711d-9dbe91530d61
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Dis(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:0fe404ba-9fbf-043e-711d-9dbe91530d61
msgctxt "h21da8377g508dg46e5gbfb3g0618b195e7c7"
msgid "The barren wastes of Dis."
msgstr "디스의 불모지로 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 10f19208-af61-658f-7d11-0a4d11d4d11c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_MizoraRomance_Event_Minauros(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:10f19208-af61-658f-7d11-0a4d11d4d11c
msgctxt "h6adfb0e9g698dg4f4agb62fg9bf1a672b614"
msgid ""
"*She smells of the ashes of Avernus and the thick Minauros bogs. You could "
"want for nothing more.*"
msgstr "*미조라에게서는 아베르누스의 재와 빽빽한 미나우로스 습지의 냄새가 납니다. 이보다 더 환상적일 수는 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 1154d9ab-5f31-2dd1-afba-5750b59a0921
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:1154d9ab-5f31-2dd1-afba-5750b59a0921
msgctxt "h65edb3c1gb764g4d25ga076g6591ed6b4776"
msgid "With pleasure. As long as you're willing to give in."
msgstr "얼마든지. 네가 포기하고 싶을 때까지 해 줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 1df9af7f-eae0-a99b-710d-990cfd0b627f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:1df9af7f-eae0-a99b-710d-990cfd0b627f
msgctxt "h005748e5g34abg4077g8045g69bb65836875"
msgid "<i>Bask in the powerful sensations rising from the circle.</i>"
msgstr "<i>마법진 안에서 일어나는 강렬한 감각 속으로 빠져든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 1f80151c-8531-be7b-1208-9bbb6a7a2086
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:1f80151c-8531-be7b-1208-9bbb6a7a2086
msgctxt "h55656a3bg288dg41f3gb5a2g68c70371fd34"
msgid ""
"*Pure lust courses through your veins and plucks at your flesh. You don't "
"know what you want, only that you want it.*"
msgstr ""
"*몸을 타고 흐르는 이 순수한 정욕에 살갗이 뜯겨 나갈 것만 같습니다. 당신은 이 감각이 뭔지도 모르지만, 간절히 원하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 213131ee-e55b-3122-157c-cef1c38debae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_CalledOffRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:213131ee-e55b-3122-157c-cef1c38debae
msgctxt "h158f429ag8c60g49d0gbbf8g824084615136"
msgid "<i>Pull away.</i>"
msgstr "<i>밀어낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 214138a5-f3df-366b-0219-47c0aff829ba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_CalledOffRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:214138a5-f3df-366b-0219-47c0aff829ba
msgctxt "hfc0c106bg0c5cg4648ga64fg2dfdafeb2388"
msgid "Whatever you're offering, I want none of it."
msgstr "뭘 준다고 하든 관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 26bbd0ea-ebbb-c3ce-16b6-31ba076a6ff3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:26bbd0ea-ebbb-c3ce-16b6-31ba076a6ff3
msgctxt "h798e0febg01b4g4eacg8fe7g3a7a153a18ac"
msgid "Ta-ta for now."
msgstr "일단 오늘은 여기까지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 2854f4ec-6571-c97f-adbe-cd7249558f7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:2854f4ec-6571-c97f-adbe-cd7249558f7b
msgctxt "h6231913dgb2d0g465fg84c6g8621cd692a29"
msgid ""
"Malbolge, the desolation. The forgotten ruins of Maladomini. Cania and its "
"mountains of ice. Or Nessus, the seat of infernal power."
msgstr "말볼제, 황폐한 땅. 말라도미니의 잊힌 폐허. 카니아의 얼음 산맥. 네서스, 지옥의 힘이 자리 잡은 곳."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 28b7c282-397f-39a5-f9ca-ee37dc859e67
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:28b7c282-397f-39a5-f9ca-ee37dc859e67
msgctxt "h5db1f2d4g516fg4496ga3a3g5b5da23baa3d"
msgid ""
"'Til now, I've tossed you the Hells' scraps. Tonight, pup? Tonight, you "
"binge."
msgstr "그동안은 내가 너무 찌꺼기들만 먹여줬지, 멍멍아? 오늘 밤엔, 실컷 먹어 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 28b7c282-397f-39a5-f9ca-ee37dc859e67
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:28b7c282-397f-39a5-f9ca-ee37dc859e67
msgctxt "hcab60f02gd070g45f5ga7c1g7a2b78c2a17b"
msgid "Let me show you."
msgstr "내가 보여줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 291c332c-02e4-3e76-b6f1-74678b1fd0fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:291c332c-02e4-3e76-b6f1-74678b1fd0fc
msgctxt "h6819d3aagd7feg4cb3g9d8cg9821a86b1467"
msgid ""
"<i>Tsk. </i>I'll just have to <i>imagine</i> the pup's horrified look if "
"we'd done it."
msgstr "<i>하아</i>. 우리 둘이 했으면 멍멍이가 얼마나 기겁했을지 <i>보고 싶었는데</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 2a5913ff-e8e5-239c-626b-9e7e4b7acd34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_CalledOffRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:2a5913ff-e8e5-239c-626b-9e7e4b7acd34
msgctxt "h1ec7a083g7020g44eag847eg0012a7c7455f"
msgid "Revolting. Get out of here, Mizora."
msgstr "혐오스럽군. 이쯤 하지, 미조라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 39ad2192-2d55-8d84-ad98-aa2938c93416
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:39ad2192-2d55-8d84-ad98-aa2938c93416
msgctxt "h784e85f6gb4f1g42faga478gab2a61258d4a"
msgid "Where your rightful mistress shoulders the burdens of perpetual war."
msgstr "네가 모셔야 할 여제님께서 영원한 전쟁의 짐을 짊어지고 계시는 곳이기도 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 3a89adad-391a-d722-0df7-00754dd83c83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:3a89adad-391a-d722-0df7-00754dd83c83
msgctxt "h81a1343cg3484g4907gbfddgfb54f64de475"
msgid ""
"<i>Tsk. </i>I'll just have to <i>imagine</i> your friends' horrified looks "
"if we'd done it."
msgstr "<i>쯧</i>. 우리 둘이 했으면 네 친구가 얼마나 기겁했을지 <i>보고 싶었는데</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 3b51a4cc-e7a7-2ee9-72de-38b8f3dc9739
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_MizoraRomance_Event_Cania(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:3b51a4cc-e7a7-2ee9-72de-38b8f3dc9739
msgctxt "hfa10bed2g3ac2g473fgac40g844b169a8729"
msgid ""
"*Mizora's body burns, but when your lips meet hers, they are cold as Cania "
"itself. She is void, she is nothingness. She is here to be lost in.*"
msgstr ""
"*미조라의 몸은 불타고 있지만, 입술을 미조라에게 포개어 보니, 카니아처럼 차갑다는 걸 알게 됩니다. 그녀는 공허이자, 무 그 "
"자체입니다. 그녀는 사라지기 위해 존재합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 3be7729a-436c-a846-80c4-6bf345aec495
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#. TagRule: WYLL_DEVIL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:3be7729a-436c-a846-80c4-6bf345aec495
msgctxt "hcfb0f5c0gfcc7g474dg80e2gc8c91ecebca0"
msgid ""
"*You are undone and reformed - a devil in both form and spirit. For one "
"depraved night, you feast on the sins of the body, the mind, and the soul.*"
msgstr ""
"*당신은 파괴되고 새로 태어나, 몸과 영혼 모두 데빌이 되었습니다. 단 하룻밤 타락하는 동안, 당신은 육신과 정신, 그리고 영혼의 죄들을 "
"모조리 맛보았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 3be7729a-436c-a846-80c4-6bf345aec495
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:3be7729a-436c-a846-80c4-6bf345aec495
msgctxt "hfaf48e69g9518g46bfga19fg1a1a4c21c4cb"
msgid ""
"*Yet in a wink, you are reformed - a devil in spirit, if not body. For one "
"depraved night, you feast on the sins of the body, the mind, and the soul.*"
msgstr ""
"*당신은 눈 깜짝할 사이에 새로 태어났습니다. 몸은 아닐지언정 영혼은 데빌이 되었습니다. 단 하룻밤 타락하는 동안, 당신은 육신과 정신, "
"그리고 영혼의 죄들을 모조리 맛보았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 3c2f6bf7-9433-85a1-823c-5dac72a19eb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:3c2f6bf7-9433-85a1-823c-5dac72a19eb0
msgctxt "h033ef546g56ceg4a69ga0c7gf0dbdb406547"
msgid "Choose a Hell. Have your fill."
msgstr "하나 골라 봐. 네 맘대로 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 42aca36b-7637-a844-e5b9-0697eb2d26f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Malbolge(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:42aca36b-7637-a844-e5b9-0697eb2d26f1
msgctxt "h069b1f49gbbc7g46ebg80b7ga73e4c05267b"
msgid "Malbolge, craggy and cavernous."
msgstr "험준하고 웅장한 말볼제로 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 442ac3c1-dcf4-afbc-b02b-70ec6488716d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#. TagRule: WYLL_DEVIL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:442ac3c1-dcf4-afbc-b02b-70ec6488716d
msgctxt "h3d4c2d09g3456g476bga291g4ea979349aed"
msgid ""
"*Yet in a wink, you are reformed as the devil you are. For one depraved "
"night, you feast on the sins of the body, the mind, and the soul.*"
msgstr ""
"*당신은 눈 깜짝할 사이에 데빌로서 새로 태어났습니다. 단 하룻밤 타락하는 동안, 당신은 육신과 정신, 그리고 영혼의 죄들을 모조리 "
"맛보았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 442ac3c1-dcf4-afbc-b02b-70ec6488716d
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:442ac3c1-dcf4-afbc-b02b-70ec6488716d
msgctxt "hbf391ecfga6abg46dbg93c2g9700a338d657"
msgid ""
"*Yet in a wink, you are reformed - a devil in spirit, if not body. For one "
"depraved night, you feast on the sins of the body, the mind, and the soul.*"
msgstr ""
"*당신은 눈 깜짝할 사이에 새로 태어났습니다. 몸은 아닐지언정 영혼은 데빌이 되었습니다. 단 하룻밤 타락하는 동안, 당신은 육신과 정신, "
"그리고 영혼의 죄들을 모조리 맛보았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 471f7730-2439-2b33-0818-4d3e85f45a9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:471f7730-2439-2b33-0818-4d3e85f45a9a
msgctxt "hab38daf8gcc77g4dc2g8d12g0f2fb40051fd"
msgid "*An inferno engulfs you. Your lust blazes hot.*"
msgstr "*지옥의 불길이 당신을 삼킵니다. 정욕이 뜨겁게 타오릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 48a8df5d-218b-f7c1-2f05-269e96346164
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_MizoraRomance_Event_Phlegetho(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:48a8df5d-218b-f7c1-2f05-269e96346164
msgctxt "h721572c1gaecbg4bcdgb195g51a54689e13d"
msgid ""
"*Your hunger pulls you toward her. The hunger for the twin heats of Avernus "
"and Phlegethos.*"
msgstr "*당신의 욕망이 당신을 미조라의 앞으로 확 떠밉니다. 아베르누스와 플레게토스의 두 열기 때문에 생겨난 욕망입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 4a3e14b2-de32-8c7f-a6f5-c1851930842f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Phlegetho(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:4a3e14b2-de32-8c7f-a6f5-c1851930842f
msgctxt "he8b8df03g6888g4d94gad10ge752b4e9cae4"
msgid "The roiling lava of Phlegethos."
msgstr "플레게토스의 끓어오르는 용암이 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 4a933cfc-ac9d-9722-d45e-09fcbad68404
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_RomancedMizora(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:4a933cfc-ac9d-9722-d45e-09fcbad68404
msgctxt "h44434968gd97fg4a42ga8b3g0593f0749a8f"
msgid "<i>Step into Mizora's outstretched wings.</i>"
msgstr "<i>미조라의 펼쳐진 날개 안으로 들어선다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 4b06e1d2-93ff-12c4-3ae1-070f87d6a630
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:4b06e1d2-93ff-12c4-3ae1-070f87d6a630
msgctxt "he7ca47fcg2958g4882ga59dgfb9237a5b668"
msgid "Ta-ta for now."
msgstr "일단 오늘은 여기까지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 4c602ade-64c8-41e5-82cc-8dc42ce86532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:4c602ade-64c8-41e5-82cc-8dc42ce86532
msgctxt "h24d4a345g0bbdg49fcgbf32ga7e86d08d548"
msgid "<i>Take a tentative sip.</i>"
msgstr "<i>한 모금만 마셔본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 4c9b8643-a684-c8c7-0158-b312a63a6ef4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:4c9b8643-a684-c8c7-0158-b312a63a6ef4
msgctxt "hfbd2e14eg2b40g4517gb35bge721054c90df"
msgid "Show me more."
msgstr "더 느끼게 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 4d478852-75df-a76d-9dce-4348e3bf081d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Malodomini(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:4d478852-75df-a76d-9dce-4348e3bf081d
msgctxt "hd72f216dgc2bdg4b1ag9065gdbb754c80660"
msgid "Maladomini, the shattered kingdom."
msgstr "조각난 왕국, 말라도미니로 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 5391fa06-7433-60ff-6bf5-1aeb4726cbf0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Cania(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:5391fa06-7433-60ff-6bf5-1aeb4726cbf0
msgctxt "hf3051b0fg5b1dg4da2ga080gcec37d3f9c3a"
msgid "Cania, realm of glaciers."
msgstr "빙하의 영역, 카니아가 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 590f501a-0fb7-f671-fc5e-058c29148314
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:590f501a-0fb7-f671-fc5e-058c29148314
msgctxt "h15febfb5gcfeag439eg90c8g69438d099b35"
msgid ""
"*A touch of bitter nips at your tongue. It is vile, it is luscious - apples "
"and ashes, fresh honey and bonedust. You ache for another taste.*"
msgstr ""
"*약간의 쓴맛에 당신의 혀가 살짝 따끔합니다. 지독하고, 매혹적인 맛입니다. 사과와 재, 신선한 꿀과 뼛가루의 조합 같습니다. 당신은 더 "
"맛보고 싶어 안달이 납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 5c89ecdc-d67c-e116-dfe9-3525a3a8bcaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:5c89ecdc-d67c-e116-dfe9-3525a3a8bcaf
msgctxt "he24941bdgaac9g48aeg8c07gddba309bf7fc"
msgid ""
"Dis, the blackened elysium. Minauros, the rotting bog. The molten seas and "
"soil of Phlegethos. Stygia, the frozen ocean."
msgstr "디스, 칠흑의 이상향. 미나우로스, 부패한 습지. 플레게토스의 용암 바다와 땅. 스티지아, 얼어붙은 바다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 6181300e-09dd-4127-a0f2-0b83f87cce9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:6181300e-09dd-4127-a0f2-0b83f87cce9a
msgctxt "h9207f318g1fbdg4ac9g92a8ga5a77e4fee3f"
msgid "What exactly will this entail?"
msgstr "그럼, 정확히 어떻게 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 640c01d3-1518-e80d-0a88-1982d71fb684
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:640c01d3-1518-e80d-0a88-1982d71fb684
msgctxt "h735a4c51g9d93g4aa3gb9feg4ebbb7a8c4df"
msgid "The Nine Hells of Baator. The ultimate torment, some souls would say."
msgstr "베이아터의 아홉 지옥들. 어떤 영혼들은 여기서 궁극의 고통을 겪게 된다고 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 64e41924-f3f2-83a4-578e-e67bc7eb4a7b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Nessus(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:64e41924-f3f2-83a4-578e-e67bc7eb4a7b
msgctxt "hf7366721ge200g4e1agaf5bgde4169bac8db"
msgid "Nessus, where the Hells' overlord reigns supreme."
msgstr "지옥의 대군주가 군림한다는 네서스로 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 696d6a1b-6bbc-9c1e-13fd-312e9ed8af1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:696d6a1b-6bbc-9c1e-13fd-312e9ed8af1e
msgctxt "h108bb7f5g7f61g4f32gaaa4g0d99c7663c9a"
msgid "I'm going to show you the true wages of your sin."
msgstr "진짜 죄의 대가가 뭔지 보여줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 69e35edc-be0c-2530-e46f-1aaf632df3c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:69e35edc-be0c-2530-e46f-1aaf632df3c2
msgctxt "hce80a825gc53bg4829ga125g86b604c1ec51"
msgid ""
"*Ice. Its embrace is tighter than any you've known. It is cold, but you want "
"colder. You want total zero.*"
msgstr ""
"*얼음입니다. 이것의 정기는 당신이 아는 그 어떤 것보다 단단합니다. 차갑지만, 당신은 더 차가운 것을 원합니다. 절대 영도를요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 71c92205-af11-b503-6ed9-b3a0061a1ecd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IRN_Ravengard_State_Saved = True
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:71c92205-af11-b503-6ed9-b3a0061a1ecd
msgctxt "hdc84a587g9fedg43e2g9544g5a418c9fd32e"
msgid ""
"<i>Tsk. </i>I'll just have to <i>imagine</i> your father's horrified look if "
"we'd done it."
msgstr "<i>칫</i>. 우리 둘이 했으면 너희 아빠가 얼마나 기겁했을지 <i>보고 싶었는데</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 764e8113-2005-2f4d-f2f4-7c955336cbe4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizoraRomance_Event_Stygia(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:764e8113-2005-2f4d-f2f4-7c955336cbe4
msgctxt "h7991a5e2gd79dg41a3g92dcg364de3fa2b1c"
msgid "The icy seas of Stygia."
msgstr "스티지아의 얼음 바다로 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 78cd7819-aa89-a760-9b50-54f0d8b5a7bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:78cd7819-aa89-a760-9b50-54f0d8b5a7bd
msgctxt "hba362deaga4f9g4babga0d0gb4fca364b7b9"
msgid "<i>Tsk. </i>Those souls lack imagination."
msgstr "<i>훗</i>. 고작 그거뿐이겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 7938947c-48bd-7c98-c259-3a52ed15664a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:7938947c-48bd-7c98-c259-3a52ed15664a
msgctxt "h4fa7ccb6ge71dg4944g9f29g70dea1b5f657"
msgid ""
"*You are flush with untold power. You could rip apart mountains and bring "
"gods to their knees. This is the ultimate you: the commander of planes, the "
"director of fate.*"
msgstr ""
"*알려지지 않은 힘이 당신을 가득 채웁니다. 산맥을 뜯어내고 신조차 무릎 꿇릴 수 있을 것 같습니다. 이게 당신이 가질 수 있는 궁극의 "
"모습입니다. 차원계의 지배자, 운명의 감독관.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 7a61c0ef-023c-5ff3-554e-5ee9f4ca19a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:7a61c0ef-023c-5ff3-554e-5ee9f4ca19a0
msgctxt "h08d53183g656dg4078g8ca1g3a53519d0c3a"
msgid ""
"I'd hoped for more from you, sister. I'd hoped you were ready to come home."
msgstr "네가 이거밖에 안 되는 줄은 몰랐네, 칼라크. 너도 집에 올 준비가 된 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 8025afaf-31de-86b8-e53b-8c6d40f6bc9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:8025afaf-31de-86b8-e53b-8c6d40f6bc9e
msgctxt "hbc17118dgf369g4a9fgb382g70d7a2c7123b"
msgid "<i>Give in to the infernal sensations.</i>"
msgstr "<i>지옥의 감각 앞에 몸을 맡긴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 82241bd8-e5c2-057e-37b0-16158f9aba8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:82241bd8-e5c2-057e-37b0-16158f9aba8a
msgctxt "h1f811b3fg269cg4c7fg9310gdf0af2c403a8"
msgid "What's happening? What are you doing to me?"
msgstr "뭐가 어떻게 돌아가는 거지? 나한테 무슨 짓을 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 86e6f02c-b6b4-4e89-f588-9711e61d4cc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:86e6f02c-b6b4-4e89-f588-9711e61d4cc6
msgctxt "he41d1de4g0548g43cegb1e4g32f66888e93c"
msgid "What a laugh, to deprive yourself of the Hells' lavish vices."
msgstr "너 진짜 웃긴다. 이렇게 질펀하게 놀 수 있는 기회를 포기하겠다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 873ddb4e-bf0f-5d72-cb36-000b270f19e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:873ddb4e-bf0f-5d72-cb36-000b270f19e1
msgctxt "haf0bac33gcd5bg4270g88f6g3aa3db6874b2"
msgid ""
"*You inhale the oily clouds of Minauros' stink. It is the stench of dead "
"lovers and sour romances. It is the unwantable - but you still lust for "
"more.*"
msgstr ""
"*당신은 미나우로스의 악취 나는 기름진 구름을 들이마십니다. 죽은 연인과 시큼한 사랑의 냄새가 납니다. 이런 걸 원하는 자는 "
"없겠지만... 아직 뭔가가 더 필요합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 88a4ebc9-8abc-6a6d-1264-8b8a9d9d3fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:88a4ebc9-8abc-6a6d-1264-8b8a9d9d3fc6
msgctxt "h77fc012cg46a5g48edg8673g0acdb75dd2ac"
msgid "Reach out. Have a taste."
msgstr "어서. 한 번 먹어 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 8913748f-5886-36db-fc94-f9396ddb975e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:8913748f-5886-36db-fc94-f9396ddb975e
msgctxt "he7f2a5b7g7a47g4a53gbe14ga833c96c689e"
msgid ""
"*You are immersed in a cold ocean blanketed by twilight. Lightning strikes "
"you, energising and illuminating. Now that you know the thrill of its shock, "
"you yearn for more.*"
msgstr ""
"*당신은 황혼으로 덮인 차가운 대양에 잠겨 있습니다. 당신에게 번개가 내리꽃히자, 활기가 돌고 명쾌해진 기분이 듭니다. 이 충격의 "
"짜릿함을 알고 나니, 더 많은 걸 경험하고 싶어집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 8db38948-206c-15bf-af7c-019f90a790cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_Event_StartedRomanceScene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:8db38948-206c-15bf-af7c-019f90a790cd
msgctxt "h0c0a9a88g5d4fg45ffg98bfg9d7741ba4d9c"
msgid ""
"*You are enveloped in myriad sensations, all at once. Flaming desire and icy "
"despair; the strength of iron and the haze of thick swamp mist.*"
msgstr ""
"*오만 가지 감각들이 당신을 빙 둘러싸더니, 한꺼번에 들이닥칩니다. 활활 타오르는 욕망과 얼음장 같은 절망, 강철 같은 힘과 늪의 "
"안개처럼 짙은 몽롱함이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 92bf2cb4-e822-a4dd-9128-18bd980054d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:92bf2cb4-e822-a4dd-9128-18bd980054d0
msgctxt "hd4192737ge5dbg4234gad89g680ec7f4c626"
msgid "<i>Gorge on the River of Blood. Relish its flavour.</i>"
msgstr "<i>피의 강물을 쭉 들이키고, 그 맛을 음미한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 936e51f6-75fd-ff07-43e0-3e1e19109228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:936e51f6-75fd-ff07-43e0-3e1e19109228
msgctxt "h029d7298g1118g4db3g9b4egb8cbe8ad94c4"
msgid "<i>Sigh and brace yourself.</i>"
msgstr "<i>한숨을 푹 내쉬고는 일단 대비를 갖춘다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = 9ad40c8b-692c-2bd5-b49f-f0a42598f4f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:9ad40c8b-692c-2bd5-b49f-f0a42598f4f9
msgctxt "h844679f9g69a2g4d43g9ec0gc9bbfd81ef39"
msgid "Give it to me."
msgstr "해보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = 9b1a6455-2888-2979-2d75-fdde2abf7643
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:9b1a6455-2888-2979-2d75-fdde2abf7643
msgctxt "h1a5af6eag8998g45dfga3e6gbbfcb1b60154"
msgid ""
"*You feel a spark between the two of you - Stygia's spark, ignited by "
"Avernus' heat.*"
msgstr "*당신은 둘의 몸 사이에서 불꽃이 튀는 걸 느낍니다. 아베르누스의 열로 점화된 스티지아의 불꽃입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = 9b662231-0447-0a89-b0de-5fdaafce6215
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:9b662231-0447-0a89-b0de-5fdaafce6215
msgctxt "hae5d06a2g7f71g4816gaaa7g98adb5917725"
msgid "One last choice, and starve no longer."
msgstr "마지막으로 딱 한 번만, 억누르지 말자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = a4057e72-e6fc-635c-9867-0e436c346a2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:a4057e72-e6fc-635c-9867-0e436c346a2d
msgctxt "h42e03d86g155bg40e6g9e1ega4da195be59a"
msgid "What a laugh, to deprive yourself of the Hells' lavish vices."
msgstr "너 진짜 웃긴다. 이렇게 질펀하게 놀 수 있는 기회를 포기하겠다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = a67b4dd4-2e4e-93f9-823f-d010f3ba6a74
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_CalledOffRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:a67b4dd4-2e4e-93f9-823f-d010f3ba6a74
msgctxt "h25684636g69b6g4a09ga7b9g2a7b10e67d44"
msgid "No, I shouldn't. I don't want any part of this."
msgstr "아니. 이제 여기서 손 떼겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = a7c4fb26-7afd-95e7-1b8c-d59a0d35349d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:a7c4fb26-7afd-95e7-1b8c-d59a0d35349d
msgctxt "hbac913ecg1759g4056g9409g7192a16388bb"
msgid ""
"<i>Tsk. </i>I'll just have to <i>imagine</i> your friends' horrified looks "
"if we'd done it."
msgstr "<i>쯧</i>. 우리 둘이 했으면 네 친구가 얼마나 기겁했을지 <i>보고 싶었는데</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = aedc50cc-a6af-ac3b-3247-2281be82f95d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:aedc50cc-a6af-ac3b-3247-2281be82f95d
msgctxt "h31ba9088g5354g40d6gaca5g2fec650a0d7a"
msgid "I'm ready. Bring me the pleasures of the Hells."
msgstr "준비됐어. 지옥의 쾌락들을 맛보게 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = b0a2c3d0-17d2-ce71-3d97-55eb35b5c922
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:b0a2c3d0-17d2-ce71-3d97-55eb35b5c922
msgctxt "h849e8d3cg28bag4972gbc91g1ab1987d24c4"
msgid "I know you can, sister. You know just how much the Hells can hurt."
msgstr "나도 알아, 칼라크. 넌 지옥이 얼마나 고통스러운 곳인지 아는 애니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = b2bb8335-9425-73f9-5d46-c1bd329fe013
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_CalledOffRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:b2bb8335-9425-73f9-5d46-c1bd329fe013
msgctxt "h1cf5e639g5639g4872gb397g5e544c22e424"
msgid "None of the above. This is horrific."
msgstr "죄다 별로군. 정말 끔찍해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = b5b8d764-268b-cac2-958e-02dd799bf0c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:b5b8d764-268b-cac2-958e-02dd799bf0c4
msgctxt "h28aaa083g6a8ag42e7g8204g5cec53ece571"
msgid ""
"*Decaying cities, cinder forests. All that was once whole has collapsed into "
"memories. Your body and mind dissolve into fragments, each as pure as the "
"next. You are the perfection of form.*"
msgstr ""
"*도시는 썩어가고, 숲은 잿더미가 되었습니다. 한때 온전했던 것들은 기억 저편으로 사라졌습니다. 당신의 몸과 마음이 조각나 녹아내리지만, "
"모두 순수합니다. 당신이야말로 완벽한 형태입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = bebffaa2-23ca-9913-0825-de47a6ca7ffa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:bebffaa2-23ca-9913-0825-de47a6ca7ffa
msgctxt "h2ee9d4e0gf5e4g43abg888dgf46b43d043ed"
msgid "What a laugh, to deprive yourself of the Hells' lavish vices."
msgstr "너 진짜 웃긴다. 이렇게 질펀하게 놀 수 있는 기회를 포기하겠다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = c47232b1-aad0-a391-f94b-0a32484ee91f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_MizoraRomance_Event_Malodomini(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:c47232b1-aad0-a391-f94b-0a32484ee91f
msgctxt "hc54c1562g5633g421bga98eg8bbdbedbc6b4"
msgid ""
"*Mizora's wings squeeze tight and you are shattered once more, your atoms "
"strewn by the winds of Malodimini.*"
msgstr "*미조라의 날개가 꽉 조여오자, 당신은 한 번 더 산산조각 납니다. 당신의 원자들이 말로디미니의 바람에 흩날립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = c58337c2-946d-7a7b-19d2-930bd6047cdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:c58337c2-946d-7a7b-19d2-930bd6047cdc
msgctxt "h5f9da080g4e05g4473gbab0g467639a5ef61"
msgid "Take me. And know the essence of the Hells."
msgstr "날 범해 줘. 그리고 지옥의 정수를 깨닫는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = c5fdbc49-11ff-8efe-cf2f-0731fdf3042e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:c5fdbc49-11ff-8efe-cf2f-0731fdf3042e
msgctxt "hf6103ac6g6a20g41c8g9d6fg6dc045f78c0e"
msgid ""
"*The endlessness of everything and nothing. Black stones, grey cliffs, and "
"the condemned held in cages. A place to lose yourself for a blissful "
"eternity.*"
msgstr ""
"*모든 것이 끝없이 펼쳐져 있지만 동시에 아무것도 없습니다. 검은 돌과 회색 절벽들이 있고, 죄인들이 우리에 갇혀 있습니다. 환희에 가득 "
"찬 영원 속에서 자신을 잃어버리고 싶은 사람을 위한 장소입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = c71c087f-2e3f-6e1c-3b49-0e156f3aa736
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:c71c087f-2e3f-6e1c-3b49-0e156f3aa736
msgctxt "h4e57f98ag33cbg495agab66g8e63693067b4"
msgid ""
"*The flavour is exquisite as spiced wine, terrible as rotting offal. It does "
"not quench your lust - it only stokes it.*"
msgstr ""
"*그 맛은 향을 첨가한 포도주처럼 우아하면서도, 썩은 내장만큼이나 끔찍합니다. 이런 건 정욕을 해소해 주지 않습니다. 오히려 부추길 "
"뿐이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = c83f2b5e-f9e3-5a96-18ce-00dc206d1b27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:c83f2b5e-f9e3-5a96-18ce-00dc206d1b27
msgctxt "h45679bfegd1f0g4061g8f7dg61eecb5b37a5"
msgid ""
"*Magma flows around you and into you, and the devil in you is awakened. The "
"heat is unbearable, yet somehow not nearly <i>enough</i>. You crave still "
"more.*"
msgstr ""
"*용암이 당신 주위에서 안으로 흐르고, 내면의 데빌이 깨어납니다. 견딜 수 있는 열기가 아니지만, 이걸로는 <i>충분하지</i> "
"않습니다. 당신은 여전히 더 많은 걸 갈망합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = c9526b06-21a3-fdd4-850b-40b2d7fb9a64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:c9526b06-21a3-fdd4-850b-40b2d7fb9a64
msgctxt "he770123bg31afg4f3fg99e0g68166ab8406d"
msgid "What a laugh, to deprive yourself of the Hells' lavish vices."
msgstr "너 진짜 웃긴다. 이렇게 질펀하게 놀 수 있는 기회를 포기하겠다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = cfa715a9-7e6a-e137-9369-22a5df2134d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:cfa715a9-7e6a-e137-9369-22a5df2134d3
msgctxt "h40488539gf3c1g46ebga57ag830ff6bc8b2a"
msgid ""
"<i>Tsk. </i>I'll just have to <i>imagine</i> the pup's horrified look if "
"we'd done it."
msgstr "<i>쯧</i>. 우리 둘이 했으면 멍멍이가 얼마나 기겁했을지 <i>보고 싶었는데</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = d087f1aa-f236-7353-0754-5fd295a1c193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:d087f1aa-f236-7353-0754-5fd295a1c193
msgctxt "he7301ee1gc69fg4a1bgac73g28629c648a16"
msgid "I'm not so sure about this, Mizora."
msgstr "그렇게 썩 내키진 않는군, 미조라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = d0d6ad90-453a-9476-4bc2-4527d49dd19b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:d0d6ad90-453a-9476-4bc2-4527d49dd19b
msgctxt "hbfa8b6b9g963bg4ecfg8dc5g388bdc0a6127"
msgid "What's the matter. Don't you trust me?"
msgstr "왜 그래. 나 못 믿어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = d348dea0-87df-c198-3d32-79017e742917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:d348dea0-87df-c198-3d32-79017e742917
msgctxt "h67c24720g10e5g45dfgaf87g3cc338dbdd4a"
msgid ""
"*Mizora's lips meet yours, and Nessus rises. You are locked in torrid "
"struggle, each fighting to conquer the other.*"
msgstr ""
"*미조라와 당신의 입술이 맞닿는 순간, 네서스가 일어섭니다. 둘은 자기들만의 격렬한 씨름에 흠뻑 빠진 채, 상대를 굴복시키기 위한 "
"몸싸움을 벌입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Player
#. NodeID = d61c7832-aa02-b364-7e5a-f7548a82d509
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_CalledOffRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:d61c7832-aa02-b364-7e5a-f7548a82d509
msgctxt "h761c5a86gae29g4f97gbba3g7c2483c1d40b"
msgid "No. I'm ending this here."
msgstr "아니. 여기서 그만두겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = dc14db71-cc10-7662-1ce2-bb2e071eec4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:dc14db71-cc10-7662-1ce2-bb2e071eec4b
msgctxt "h06dd8158ga8bdg4e11gb3b8g068bef5a4a55"
msgid ""
"Do you feel it? Avernus. Where Hells' legions march, screaming their rage. "
"Where the Styx collects the blood of the fallen."
msgstr "느껴져? 아베르누스야. 지옥의 군단이 분노에 차 울부짖으며 행군하고, 스틱스강이 망자들의 피를 모으는 곳이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = e2ad9861-ff41-e50f-08ec-9f3a212d972d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_MizoraRomance_Event_Dis(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:e2ad9861-ff41-e50f-08ec-9f3a212d972d
msgctxt "h80d19071g5c53g41cfgaee1gb69e84d3fd3d"
msgid ""
"*Black and red, agony and flame - Avernus and Dis, united. They feed you, "
"they sustain you.*"
msgstr "*흑색과 적색, 고통과 불꽃. 아베르누스와 디스가 하나가 되었습니다. 이것들이 당신의 원동력이고, 당신을 살아가게 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = ebd3b855-c4a9-29d7-2d89-b41a9de17fe9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:ebd3b855-c4a9-29d7-2d89-b41a9de17fe9
msgctxt "hda8da079g96fcg414cg9cd4g88f6ee00bacb"
msgid "A banquet lies before you. Why should you not gorge?"
msgstr "진수성찬이 눈앞에 있잖아. 왜 안 먹고 빼려고 해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Narrator
#. NodeID = ee104288-f26b-4862-5457-656cd56f5da7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:ee104288-f26b-4862-5457-656cd56f5da7
msgctxt "h23f72851g2b5cg4e2dg8a2bg9e3367fc53e1"
msgid ""
"*Suffering. It rises from the foul ichor of the vast plains of Dis. The pain "
"of the damned is your pleasure. Your soul cries for more, more, <i>more</i>.*"
msgstr ""
"*고통. 고통이 디스의 광활한 평원 속 부패한 신들의 피에서 솟아오릅니다. 망자들의 고통은 당신의 쾌락입니다. 당신의 영혼은 이것을 더, "
"더, <i>더 많이</i> 바라고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = f3ff0b00-20a1-596b-f628-8366ec310263
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IRN_Ravengard_State_Saved = True
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:f3ff0b00-20a1-596b-f628-8366ec310263
msgctxt "h742a924eg3218g4b86ga073g9e07e1e942d4"
msgid ""
"<i>Tsk. </i>I'll just have to <i>imagine</i> the your father's horrified "
"look if we'd done it."
msgstr "<i>칫</i>. 우리 둘이 했으면 너희 아빠가 얼마나 기겁했을지 <i>보고 싶었는데</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM
#. Speaker = Mizora
#. NodeID = ff27a398-99db-ad98-5cfd-5c4cc86d0eee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Mizora_SD_ROM:ff27a398-99db-ad98-5cfd-5c4cc86d0eee
msgctxt "h173e94a1g85c7g4319gbacbg149316a6c0de"
msgid "Don't worry, pet. I won't leave 'til you're fully satisfied."
msgstr "걱정하지 마, 멍멍아. 네가 완전히 만족하기 전까지는 어디 안 갈 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = 1b4ac266-b522-4127-ba76-b572429ae2c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:1b4ac266-b522-4127-ba76-b572429ae2c0
msgctxt "hf7cc7c59g3133g4f3bg94b3g1b42c7d87fbe"
msgid "<i>Banish such doubts - they only distract from your faith.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = 1df96326-fdec-4952-8998-e4f87f5694f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:1df96326-fdec-4952-8998-e4f87f5694f1
msgctxt "h7596dde2gf0aeg4520g8854g7fc859b45f5c"
msgid "*A small sacrifice, compared to the infinite glories that await.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = 222799d3-0cfc-4ad4-b72f-d23d5a899ad0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:222799d3-0cfc-4ad4-b72f-d23d5a899ad0
msgctxt "hfb53d892g988eg42a2gbd17gd64bc683c5c9"
msgid "<i>She must be purged. The Dark Lady demands it.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = 25554677-13d0-488a-beae-9c15b1650866
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Partnered(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:25554677-13d0-488a-beae-9c15b1650866
msgctxt "h04c909b3g01c4g4698gaa7cg793e1d764319"
msgid ""
"*Yet what of your lover? Would Lady Shar approve of <i>that </i>distraction? "
"Perhaps you can earn the right to share your heart, if you excel in all "
"other areas of service.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = 40565b89-aa9f-4c66-8530-2b24914621b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:40565b89-aa9f-4c66-8530-2b24914621b5
msgctxt "h363e4990gc71dg426ag8468gb53223de78fe"
msgid ""
"<i>You cannot lie. Part of you regrets the cost in life. Yet it was Lady "
"Shar's will.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = 456bfa0e-b425-47e7-a700-9b8f5d6bb9b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:456bfa0e-b425-47e7-a700-9b8f5d6bb9b3
msgctxt "hbac19a2egd18eg4305g8248gc03d1fd10d01"
msgid ""
"<i>She saved your life, and made you who you are today. You owe her much.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = 4bf708b8-5b3f-4208-adaf-dfd62c9799df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:4bf708b8-5b3f-4208-adaf-dfd62c9799df
msgctxt "h9a0aaeb3g6fe1g457fga58dg51e6eee0dbbb"
msgid ""
"*Lady Shar's favour is worth everything. You would have gladly done what she "
"asked a thousand times over.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = 50265c62-2940-497d-99de-a7c776d17730
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:50265c62-2940-497d-99de-a7c776d17730
msgctxt "hde5b897fgc1e9g484cga53cg808c5cc2e884"
msgid ""
"<i>The Mother Superior always hindered your ambitions. Yet now you will "
"unseat her. Ironic.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = 6b8e08f8-eb6a-4fe6-b69c-f05d921d614d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:6b8e08f8-eb6a-4fe6-b69c-f05d921d614d
msgctxt "h4d5f5551g883cg4526g9d6cgdfd20272413e"
msgid ""
"*Your dedication has already brought you far already. Who is to say what "
"greatness awaits?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = 6f096317-3c97-4832-a0d1-d713615ac472
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:6f096317-3c97-4832-a0d1-d713615ac472
msgctxt "hb20aba00gc7c3g4de7g9f0dg1628bad3a4b6"
msgid ""
"*Like your Mother Superior. She marked the wound on your hand. She sent you "
"on a mission that nearly cost you everything.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = 797304bf-cc26-4b3b-ad38-24df4b334711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:797304bf-cc26-4b3b-ad38-24df4b334711
msgctxt "h41a4ea0cg2213g4b00gac1fg2c4ab1271e6f"
msgid ""
"*She will become a footnote, once you take her place. Your glory will be "
"unparalleled.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = 9b2d0ba8-d751-419e-ab83-7d8f36c37ed2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - Shadowheart_InParty_State_PreparingHairChange = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:9b2d0ba8-d751-419e-ab83-7d8f36c37ed2
msgctxt "h2bda09d0g4f64g4439gb327gca950705837d"
msgid ""
"<i>You still wear your hair like a trainee. Time for something more... "
"commanding.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = a781c96c-10e7-4cb6-9f3e-917bc68e86d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:a781c96c-10e7-4cb6-9f3e-917bc68e86d0
msgctxt "hd4430a5cg4762g439bga34bg3794e50a31f7"
msgid "*The oblivion of sleep awaits. You hasten towards it.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = b076ced1-a239-4acb-960f-f658f4947622
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:b076ced1-a239-4acb-960f-f658f4947622
msgctxt "hf1161991gbb15g4ab4ga1c0g5f9e3206c3ee"
msgid ""
"<i>Of course it was worth it. Your whole life has been leading to this.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Player
#. NodeID = b27a9eec-3a2c-40d7-ba55-de3a1f49d137
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:b27a9eec-3a2c-40d7-ba55-de3a1f49d137
msgctxt "h308cda8dgc56fg4480g9572gcab1bdc98963"
msgid ""
"<i>That will come in time - your actions will speak for themselves. Now, "
"rest.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = b988ea0b-e853-4da1-b3e8-3f29eaf1e2c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:b988ea0b-e853-4da1-b3e8-3f29eaf1e2c0
msgctxt "hc142749fg2654g4542ga9c4g8e5d49c9ffb9"
msgid ""
"*Your glory, bought with the blood of others. It <i>was </i>worth it, was it "
"not...?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = cf4bde2c-c8d7-4e37-ba67-ef9979d68db2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:cf4bde2c-c8d7-4e37-ba67-ef9979d68db2
msgctxt "h4418af95g1814g4a99gb3bfgdc09f5c5e13d"
msgid ""
"*So be it. There will be no rest for you yet, but come dawn, you will even "
"closer to Lady Shar, in image and spirit.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = d4e5d1ca-f251-4145-898b-aede3aae0c2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:d4e5d1ca-f251-4145-898b-aede3aae0c2d
msgctxt "he50d7b95g9eedg49d8gbaa0g3bee2a6d1908"
msgid ""
"*No matter. Anything owed belongs to the Nightsinger, ultimately. The loss "
"of your mentor will herald your own triumph.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = d7490181-df5e-4515-8b4b-a25f4e0a1cd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:d7490181-df5e-4515-8b4b-a25f4e0a1cd2
msgctxt "h19bbc5deg7f91g4095gb0fegf418048fafc0"
msgid ""
"*You are destined to be at Lady Shar's right hand, while others lose her "
"favour.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = e719712e-a2d9-42b7-bb9c-10949e15866f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:e719712e-a2d9-42b7-bb9c-10949e15866f
msgctxt "hb95d433bge918g443cgb199g854ac2f379ac"
msgid ""
"*Fatigue creeps through your limbs, and presses on your mind. Yet it is a "
"pleasurable sort of weariness - one founded in accomplishment.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = f0c4d373-1801-42e5-9c62-88a8697bb795
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:f0c4d373-1801-42e5-9c62-88a8697bb795
msgctxt "he6b2dc15g7d31g4bb4g8243g2635ad790845"
msgid ""
"*Yet you still feel like a novice, at times. To be the Chosen of Shar "
"demands certain... gravitas.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = f947c449-2af5-4f03-ace6-0911ef1ca02b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:f947c449-2af5-4f03-ace6-0911ef1ca02b
msgctxt "h8fe2fcb6g012fg41d1g9877g95c161ebe856"
msgid ""
"*You slew the daughter of Selûne for the Dark Lady. Now you are her Chosen.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD
#. Speaker = Narrator
#. NodeID = faf8bf24-0fe0-b9e2-789c-8d84bfe4daee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_DestroyedHaven = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_ChosenOfShar_SD:faf8bf24-0fe0-b9e2-789c-8d84bfe4daee
msgctxt "h605d4b82g0f0ag4ea9g950fgef4c28bdee89"
msgid ""
"*You slew the Nightsong. You caused the Selûnite enclave at Last Light to "
"fall. All for the Dark Lady. Now you are her Chosen.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 023ff9e1-e4b6-4aa5-afbf-38fb6825908c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:023ff9e1-e4b6-4aa5-afbf-38fb6825908c
msgctxt "hce7bec08g1cc9g4628g8ba9gf3ec896fe01b"
msgid "And do you feel anything?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 02639c8c-fe85-7160-7180-f8cf59152e6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:02639c8c-fe85-7160-7180-f8cf59152e6a
msgctxt "haf0eb5b7g6c8ag4598gbf95g8f781709d0b6"
msgid ""
"Perhaps not for long. The Absolute may yet put us out of our misery. I may "
"see my parents again sooner than you think..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 02b67bb4-bddc-d422-797f-99473df849f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:02b67bb4-bddc-d422-797f-99473df849f3
msgctxt "h29611898g98f2g4ed5gbf01gf14def691c84"
msgid "<i>Try to dampen emotion with reason. You barely knew them.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 08933fbf-4bc8-a1db-ba90-32ee7669100e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:08933fbf-4bc8-a1db-ba90-32ee7669100e
msgctxt "h965bce55ge95ag480ag9c57gf0e1660f8fc0"
msgid ""
"We carry on - it's all we can do. I'll follow in a while, but I think I want "
"to stay here a little longer, firstly. This place isn't familiar, but it's "
"peaceful."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 09cbfa77-50d7-c618-74cc-d525de7c4043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:09cbfa77-50d7-c618-74cc-d525de7c4043
msgctxt "hdce060bag61a7g4ce1gb789g20e3df20920d"
msgid "Dry your eyes. Until we've saved ourselves, tears are a luxury."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 109efc1e-1546-46a4-7911-e4c9546de2e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:109efc1e-1546-46a4-7911-e4c9546de2e2
msgctxt "h789089cega81bg4c9fgacc0gf13dee8171f1"
msgid ""
"*Shame, joy, regret, relief, and a host of other emotions jostle for your "
"attention. It's too much. You feel hot tears flood your eyes.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 10a8cd1a-7657-f5c3-a856-ff8002f771bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:10a8cd1a-7657-f5c3-a856-ff8002f771bf
msgctxt "h1a101616g4c4ag4c74g88e6g6aea14cc0ede"
msgid "It does?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 11d19698-dec9-491e-af8d-b2e113a1259f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:11d19698-dec9-491e-af8d-b2e113a1259f
msgctxt "hd22d97b6gd3c4g4e95g96dcgf620583bbefb"
msgid ""
"That's a dead girl's name. I don't deserve it - I had to look up how it was "
"<i>spelled</i>, for pity's sake."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 14c2ae8b-2da1-3043-fde8-b6c6cb41526a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:14c2ae8b-2da1-3043-fde8-b6c6cb41526a
msgctxt "hf291520bg5c57g4861g9319g964854e914e5"
msgid ""
"*You silently fumble for the right words. No doubt your parents could have "
"guided you in what to say. Tears blur your eyes...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = 14e801ca-2ca9-44d0-bcab-e48630b0f938
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:14e801ca-2ca9-44d0-bcab-e48630b0f938
msgctxt "hae8e5974g4d07g4e78g8840g470b5c6b110d"
msgid ""
"The Moonmaiden guides, and helps us find our true selves, Shadowheart. "
"Daughter."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 1753d89b-b48a-dcbe-1dbe-07cc9f104e5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:1753d89b-b48a-dcbe-1dbe-07cc9f104e5a
msgctxt "h14f98a31gaddcg4f15ga3abg10cb89362094"
msgid ""
"But yes, Shadowheart. It speaks to both sides of you. After all, you cannot "
"cast a shadow without some light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 1e2c06d0-673a-c269-212a-1a6e8d527a13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:1e2c06d0-673a-c269-212a-1a6e8d527a13
msgctxt "h1cfbe4eagf054g484ag8a64g73892e17026b"
msgid "You're putting too much pressure on yourself. Give it time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 2485ea1d-f872-8ce5-b76b-87c5397b71a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:2485ea1d-f872-8ce5-b76b-87c5397b71a9
msgctxt "h4181342dgdd2cg4a0cgbac3g025f9fb42711"
msgid ""
"*All you know is you feel better for it - lighter. You know where you came "
"from. You know you were loved. And where you go now is in your hands.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 26a02192-e566-88fb-1697-0ae57efa648b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:26a02192-e566-88fb-1697-0ae57efa648b
msgctxt "hb3cf59f8g5939g49d0g80d1gc331689c9c9a"
msgid "It's what I'm used to, that's all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 2712fcf7-9a19-17eb-d691-2d8a1e168f5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:2712fcf7-9a19-17eb-d691-2d8a1e168f5d
msgctxt "h6fba7471g5928g424fg92b0g2a5566cd74a5"
msgid "It's been a long time since I shed a tear. I don't even know how long."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 292498ce-b412-a885-21a6-eb20256a7c96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:292498ce-b412-a885-21a6-eb20256a7c96
msgctxt "h8066b5efgd874g4779gba64g8ccba447623d"
msgid ""
"But why does freedom have to feel like I've lost everything? Perhaps I could "
"have saved them, or perhaps Shar would have helped me forget them. Instead, "
"I've neither..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 2ea57c4f-d304-0974-022a-43a5c2b34b4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:2ea57c4f-d304-0974-022a-43a5c2b34b4e
msgctxt "hd570a60cg577cg4b4bg9a37g60baf457f93f"
msgid ""
"*You realise you cannot remember when you last shed tears. Could it be "
"possible that you never cried before?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 2f265d42-c7b4-411d-9379-abe173de325a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:2f265d42-c7b4-411d-9379-abe173de325a
msgctxt "h526f8ba8g603ag4647ga6b0g7c8eda95f162"
msgid ""
"It doesn't look like anyone's been here in a while. Perhaps people lost "
"faith. Or... forgot about it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 2ff50ace-68e5-dca0-bf67-85bf60fb6306
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:2ff50ace-68e5-dca0-bf67-85bf60fb6306
msgctxt "h4102b3b2g08acg40f1gb097g9fd1bf31c7da"
msgid ""
"*The old you may have believed that once, but no more. Your vision blurs "
"with hot tears...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 326cb03e-ee66-369d-d448-c4c1a59fa721
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:326cb03e-ee66-369d-d448-c4c1a59fa721
msgctxt "he9f415d6g3baag4f2ag86a0g946fe1b68d80"
msgid "That's it, let it all out. This has been a long time coming."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 3641372e-04d2-40d7-a4e3-c306459e9aec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:3641372e-04d2-40d7-a4e3-c306459e9aec
msgctxt "hfc2ccc5fg81d8g4517g94f8g3ee134273bc2"
msgid ""
"I have my family back, and now I can't even look them in the eye. I don't "
"deserve to be anyone's daughter."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 36463fb3-8576-47ea-8e59-37c996376adf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:36463fb3-8576-47ea-8e59-37c996376adf
msgctxt "hd76c425fgea63g4c21gbd04gd8824f47020f"
msgid ""
"*You stare up at the statue of Selûne. Her placid stone face was once that "
"of the enemy, but no longer...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 379692f9-f9f8-6edc-767f-de1d4b2c2a2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:379692f9-f9f8-6edc-767f-de1d4b2c2a2d
msgctxt "h00e68c86g0859g49d8gae99g8b7302a35199"
msgid "You made your choice - now you have to live with it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 3b377c99-f35f-4ce6-8557-bb8a477f3ac2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_RejectShar_KilledParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:3b377c99-f35f-4ce6-8557-bb8a477f3ac2
msgctxt "h00db06dbg7737g438dgae4cg019e1e706424"
msgid "*They're with her now. Thanks to you.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 3bbc8efc-1b1c-9133-8d59-088edb20a008
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:3bbc8efc-1b1c-9133-8d59-088edb20a008
msgctxt "hd1e3eeb3g938eg4b82gab35g98393f654c19"
msgid "You did what was necessary. You freed them, and yourself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 3ff808ba-2bc0-0e9a-ed39-cc97517e3bcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:3ff808ba-2bc0-0e9a-ed39-cc97517e3bcf
msgctxt "h0cd3da0fg99dcg4192gb861ga6b3b6548e6b"
msgid "Jenevelle... I can't be her. I'm sorry."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = 41b4291d-70f2-4adf-a7b2-d78c74d845fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:41b4291d-70f2-4adf-a7b2-d78c74d845fa
msgctxt "h1e39ee3ag34b8g4079g919fg66879fe289a2"
msgid "Of course you can..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 41d42d11-8981-a9c3-8021-7537ca920123
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:41d42d11-8981-a9c3-8021-7537ca920123
msgctxt "he4c64fe3gcb54g4f14g893bg2e70039d5b7d"
msgid "I can't be your Jenevelle. Not as you remember her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 43b8d981-3a15-a29f-9ea9-437cd12413f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_AbortedSkinnydipping = False
#.      - NIGHT_Shadowheart_Skinnydipping = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:43b8d981-3a15-a29f-9ea9-437cd12413f4
msgctxt "hde6036d5g7e5bg4defgb413g65e1b03b9f66"
msgid "Good thing I taught you how to swim, then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 43bf9478-59e8-9e5e-18b9-e81785abb7bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:43bf9478-59e8-9e5e-18b9-e81785abb7bd
msgctxt "h727f3d2bg7277g444dg8ae0g885768785ba9"
msgid ""
"I wanted to come here. To see if I felt anything that I hadn't done before. "
"Now that I know what I know. Now that I know who I am."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 47813fea-e1f3-b7ef-f47e-84a4d47e3086
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_DaughterTears_SD_Event_QueriedName(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:47813fea-e1f3-b7ef-f47e-84a4d47e3086
msgctxt "hf264d85dgb045g4d30g90f2gb6f10e64454f"
msgid ""
"So it's still Shadowheart, then? Sounds like you're not keen on Jenevelle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 4839757a-8171-191c-db46-1320a106c0dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_RejectShar_SavedParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:4839757a-8171-191c-db46-1320a106c0dc
msgctxt "hf8f1142dgde6cg4b7cgb93fg3ee813ee31ae"
msgid ""
"I... I don't know. For so long I only felt what <i>she </i>wanted me to. Now "
"I have to do it for myself, and I feel like I'm drowning."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 4955d6a1-c3a4-497f-bf3a-3ba308e9af43
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_DaughterTears_SD_Event_QueriedName(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:4955d6a1-c3a4-497f-bf3a-3ba308e9af43
msgctxt "haa1bd4c7g2e77g4a55gbf25g6eaf11465b6e"
msgid "Who you are? You mean Jenevelle?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 4bb10f30-0613-1b0b-58ab-ae78ba4e5fb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:4bb10f30-0613-1b0b-58ab-ae78ba4e5fb4
msgctxt "hd4f19b2dg379fg4ac7g80b7g5016df39051f"
msgid ""
"Alive? Free? <i>Feeling? </i>I've dreamt for years of seeing you like this. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 4d7295a3-4012-90c4-4790-671cafb423ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:4d7295a3-4012-90c4-4790-671cafb423ac
msgctxt "ha332034ag9b40g4736g9c37g48244b0c46cf"
msgid "They're not truly gone - remember the moon motes."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 51350ce1-38f1-c83a-9745-74579f5e620c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:51350ce1-38f1-c83a-9745-74579f5e620c
msgctxt "h90e535bbg1a28g4d16gae0dg523c0ae78889"
msgid "Hush dear, we've had enough excitement to last a good while..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 51d86ebb-e45e-8b09-c260-481558f30cc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:51d86ebb-e45e-8b09-c260-481558f30cc0
msgctxt "h0303dc11gb78bg4f94g9f18g190d09e1822e"
msgid "<i>Offer a prayer for them - to Selûne.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 52f27e5a-6117-40a6-9ca9-a2efbf4345d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:52f27e5a-6117-40a6-9ca9-a2efbf4345d8
msgctxt "h36040c2cg6199g47b7g8b2fg132eeacc051a"
msgid ""
"My darling girl. The last time I saw you cry, you cut your knee while "
"chasing a frog."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = 5413db76-5cdd-43f4-ac87-564a27543bf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:5413db76-5cdd-43f4-ac87-564a27543bf8
msgctxt "h913769e6ge962g4b1cgb03bg19858e0ca91f"
msgid "Jenevelle. Jen."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 5acc1979-ad76-7e5f-2d6e-f7a0771c2261
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:5acc1979-ad76-7e5f-2d6e-f7a0771c2261
msgctxt "h23964b27gb07ag4a7aga3b2g430d909e6e8c"
msgid ""
"*You cannot swallow your own lie. You knew them, and you miss them. Your "
"vision blurs with hot tears...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 5e416238-045c-9485-416c-415cdfcb4804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:5e416238-045c-9485-416c-415cdfcb4804
msgctxt "hf19751c4gbef4g40c8g9620gfb28370fa7ff"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 5f0c1c8d-499e-aba4-2d2b-bf0d2e998f00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:5f0c1c8d-499e-aba4-2d2b-bf0d2e998f00
msgctxt "hb9b92d93gf388g47b5g86ebgb146ad58044e"
msgid ""
"Wait, Arnell. Don't you see? Our daughter's not a little girl anymore. She's "
"a woman - one who's lived a whole lifetime without us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 60fc516c-1995-a311-b3c9-a9b7f90984a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:60fc516c-1995-a311-b3c9-a9b7f90984a4
msgctxt "h7f27c305g4111g421egbbd3gf043029f3aaa"
msgid "I'm all right now. Or... close enough, anyway."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 62d6fc63-0902-4846-9ffe-07b9f8b4f087
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_Shar_SavedParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:62d6fc63-0902-4846-9ffe-07b9f8b4f087
msgctxt "h77465401g6a6dg4d0ag96eeg8931749a8916"
msgid ""
"*Parents. You rejected Shar for these strangers you share blood with, but "
"you also did terrible things to them. And yet, they profess to love you all "
"the same.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 65cdd679-e007-759f-2b88-f81d84c44f38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:65cdd679-e007-759f-2b88-f81d84c44f38
msgctxt "h60c0c69fgef8fg4d53g91acgdd44282f5857"
msgid ""
"*While you are left behind, once again. You feel a lump rise in your throat.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 686d85ad-e3f4-4c9d-b2a0-20c3404e220b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_NamePreference = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:686d85ad-e3f4-4c9d-b2a0-20c3404e220b
msgctxt "h4bb98bceg9c31g4c19g90f3g43b1cba37d5e"
msgid ""
"No. I'd be turning my back on too much. Shadowheart is as much a part of who "
"I am as Jenevelle; I can't just forget her - that's not what I do anymore."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 6c790843-94f7-ba35-63fc-15518f05a73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:6c790843-94f7-ba35-63fc-15518f05a73c
msgctxt "h1deb3324g1456g4511gbba7g916b3367e604"
msgid ""
"Of course we do. We're two halves of you. And we'll love you all the same, "
"no matter what you're called. Arnell?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 6edb4a4c-bfe6-143e-3434-b9708349866f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:6edb4a4c-bfe6-143e-3434-b9708349866f
msgctxt "h716586dcgf447g4476ga46dg24cfe31ec98f"
msgid "Hush, we're here now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 7593be61-5103-3c3a-d856-f42d87dcba30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:7593be61-5103-3c3a-d856-f42d87dcba30
msgctxt "h3b01336cga9aeg4904ga012gb3f18641fb2f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = 775ef366-e7e4-597c-aa9e-caa0d4069fa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:775ef366-e7e4-597c-aa9e-caa0d4069fa9
msgctxt "hefe4ce2cgbd69g4a86g87c0g9b7fec92a59d"
msgid "Your mother's right, Jen. We're here for you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 7777fc9a-954d-53d7-1ef9-ea45c9b05235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:7777fc9a-954d-53d7-1ef9-ea45c9b05235
msgctxt "ha458928cge843g4e5cga91dg3d8dbbff98a2"
msgid ""
"So much time's been lost already. Most of it, I can't even remember. And "
"what I do remember... it would have been so much easier to just become a "
"monster."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = 781d3694-c27d-d1bb-0227-e4339ac476e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:781d3694-c27d-d1bb-0227-e4339ac476e5
msgctxt "hd05db022g2c48g4f32gbdb1gf643e07ec40a"
msgid ""
"*Now you see a benevolent stranger. An unasked-for patron. And a guiding "
"light for your parents.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 7888d2a4-8fdd-fb02-0b48-3f94a4e7149d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_EVIL(0) = True
#.      - CLERIC_EVIL(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:7888d2a4-8fdd-fb02-0b48-3f94a4e7149d
msgctxt "h7107bef8g548bg4998g8a73gc0485b1fd8fc"
msgid "As a traitor to your goddess, you should feel shame - shame and dread."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 7a6ef221-23fb-4483-8382-d7c8c7919025
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:7a6ef221-23fb-4483-8382-d7c8c7919025
msgctxt "h35f77befg0456g474dg8c23g3a708f7fc97a"
msgid ""
"True. But too much freedom can be frightening... lonely. There's a reason "
"why so many are eager to bow."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = 7a8d0c3c-737b-4c55-ac52-25286ef46cbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:7a8d0c3c-737b-4c55-ac52-25286ef46cbc
msgctxt "h9a6d75bcg5a47g4136g8fa6g700022a217cb"
msgid ""
"Banish those thoughts. You deserve a lifetime of happiness that was taken "
"from you. Now we have to make up for lost time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 7b312206-fa58-9a08-2c94-7ed9f4b295ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:7b312206-fa58-9a08-2c94-7ed9f4b295ad
msgctxt "hce7a953ag3eb5g4f57gb33ag28a957b510db"
msgid "What's next?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 808b4bc7-e249-1192-b1c7-de9f9f1b86f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:808b4bc7-e249-1192-b1c7-de9f9f1b86f6
msgctxt "hae84e53eg4758g4b53ga20ag618b67ef3918"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 84557f8e-962c-5443-04b4-9a0b4f894d26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:84557f8e-962c-5443-04b4-9a0b4f894d26
msgctxt "ha5db62b8g5dbag4562gb32cg55c9404eeccb"
msgid ""
"Besides, Shadowheart still suits me - even better than before, perhaps. You "
"can't cast a shadow without some light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = 89ab1f25-5aab-0570-6167-53daffc95e90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:89ab1f25-5aab-0570-6167-53daffc95e90
msgctxt "hf6d94b61gd4f8g4d48g890bgbae977b9b0fa"
msgid ""
"No. Your mother's right - she always is. Do not bend to the past. Look only "
"to the future - on your own terms."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 93bd9ea7-bcdf-6321-7a12-fc040c2c9ab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:93bd9ea7-bcdf-6321-7a12-fc040c2c9ab1
msgctxt "h0be5d2bfga538g499egaad3g49fcf67f8e69"
msgid "<i>Remain silent.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = 9881997d-0c4b-b926-c2e3-c0ee85b5fe57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:9881997d-0c4b-b926-c2e3-c0ee85b5fe57
msgctxt "h4dbeef0dg532bg499fga3d9ga2ab61286df1"
msgid "I've known some who'd argue with you on that..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 9a61426b-9df7-7864-1ec6-a8da7fcf771d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:9a61426b-9df7-7864-1ec6-a8da7fcf771d
msgctxt "h14d570e9g5cf2g4568g92c1gac9d280c4c68"
msgid ""
"All about the mission. You sound like how I used to sound. I'm all right "
"now. Or... close enough, anyway."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = 9bf6abe9-b955-f613-a91c-31a6cee9f32a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:9bf6abe9-b955-f613-a91c-31a6cee9f32a
msgctxt "h0c4d6b82gd806g4f7fg8b9cg704c51edb849"
msgid ""
"Besides, Shadowheart still suits me - even better than before, perhaps. You "
"can't cast a shadow without some light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = 9f88bcce-af14-aba6-d8d4-612a97ee753f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:9f88bcce-af14-aba6-d8d4-612a97ee753f
msgctxt "h41997828g7af2g40f0gb4c4g84a5552099cd"
msgid "Of course you can..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = a2ed8b3d-da45-4c22-55a9-ffba378481eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:a2ed8b3d-da45-4c22-55a9-ffba378481eb
msgctxt "h58ad9e49gf684g48f1gbbfdg283dfc4a784f"
msgid "Perhaps I can try. Perhaps I can get used to the name."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Narrator
#. NodeID = aac9a698-3d0d-4aee-a13c-89461e9e642c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_RejectShar_SavedParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:aac9a698-3d0d-4aee-a13c-89461e9e642c
msgctxt "ha0e095a1g8d11g49f7g8a9cg9e8338a6c54a"
msgid ""
"*You succeeded, but at what cost? Your pain endures. Your past is lost - "
"save for the very worst memories. How can your parents bear to even look at "
"you, never mind love you?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = ac061cd4-b73e-45e0-8c23-242ba7904e72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:ac061cd4-b73e-45e0-8c23-242ba7904e72
msgctxt "had522fc3g97f3g4a39gaf20g8e473d0680ba"
msgid ""
"You've turned from Shar. Doesn't necessarily oblige you to come here and "
"embrace Selûne."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = acc73817-c742-2d55-709b-f7cda30d0be4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:acc73817-c742-2d55-709b-f7cda30d0be4
msgctxt "he0d2d02cgb210g4249ga18cg89def7d9bf0d"
msgid ""
"I remember. But they can't comfort me. They can't give me advice. They can't "
"tell me what I was like as a little girl."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = ae8435f5-36aa-89c8-435f-076fcbb104f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:ae8435f5-36aa-89c8-435f-076fcbb104f0
msgctxt "h89ee9657g941ag43d4gad5fg032001a7c4b7"
msgid "<i>Shadowheart. </i>Our daughter. It suits you. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = b2110d49-cfb8-58f2-7e49-d4f35688ab66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:b2110d49-cfb8-58f2-7e49-d4f35688ab66
msgctxt "he3917751ge728g4a3bg9996gb9341739f743"
msgid ""
"Wait, Arnell. Don't you see? She's not a little girl anymore. That name "
"stays with the child. Our daughter is a woman who's lived a whole lifetime "
"away from us, and her name is Shadowheart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = b3243c89-ba5b-60aa-009a-485945788437
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:b3243c89-ba5b-60aa-009a-485945788437
msgctxt "h034cbbeegf979g4385gb3b4g5d88ada7624e"
msgid ""
"Of course. It speaks to both sides of you. After all, you cannot cast a "
"shadow without some light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = b48a38c8-60de-4b3a-a8be-7d6b706d076e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_RejectShar_KilledParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:b48a38c8-60de-4b3a-a8be-7d6b706d076e
msgctxt "h3e256f81g1880g4a63g8157g5136ede5c17a"
msgid ""
"Loss. Actual loss, not Shar's oblivion. I had my family, for too short a "
"moment. Now they're gone. By my hand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = b7853e1b-2cb4-c0eb-b8ac-3134abb0823d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:b7853e1b-2cb4-c0eb-b8ac-3134abb0823d
msgctxt "h3a225160gf0fcg45afg80eegc0560d1850f1"
msgid "Don't worry. I'm still your daughter... if you want me to be."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = b8703400-f5d3-8789-fad8-b39d1b673476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:b8703400-f5d3-8789-fad8-b39d1b673476
msgctxt "hece32f8bgd2c0g4de7g9f67g202155d902fe"
msgid ""
"Your mother's right - she always is. Do not bend to the past. Look only to "
"the future - on your own terms."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = ba46c188-dd97-d6dc-4637-4317e194630b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:ba46c188-dd97-d6dc-4637-4317e194630b
msgctxt "h565864dbga9d0g4be9g83b5g5396fdf3c8f2"
msgid "That's not true."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = c37c5a2e-ce30-b45e-491c-07aca0da4dde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:c37c5a2e-ce30-b45e-491c-07aca0da4dde
msgctxt "ha808ea25g021eg4c15g8e5cg3af4b83f3148"
msgid "<i>Silently rebuke yourself. Weeping is what others do.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = c4921d00-ac42-03b2-1802-0893fca49669
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:c4921d00-ac42-03b2-1802-0893fca49669
msgctxt "h2e79a616g4adag43aegbe31g18f458ac61d9"
msgid ""
"You helped bring me to this point - you're as much a traitor as anyone. "
"Besides, the betrayal was Shar's, not mine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = c5460f83-c7f3-1c53-3804-1d7ff04e6742
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_NamePreference = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:c5460f83-c7f3-1c53-3804-1d7ff04e6742
msgctxt "hdcf4a867g0580g4ca6g8012gb3020b31c3d6"
msgid ""
"Shadowheart. She's as much a part of who I am as Jenevelle; I can't just "
"forget her - that's not what I do anymore."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = c56b21f5-563f-cc41-7869-c012389ce34f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:c56b21f5-563f-cc41-7869-c012389ce34f
msgctxt "ha662f321g0306g4973gb222gd3cde5dc25f6"
msgid "You've punished yourself enough. Let's head back."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = caf6df64-ef68-145c-13dc-8f303c5416ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:caf6df64-ef68-145c-13dc-8f303c5416ed
msgctxt "h13a42bb9g28d0g473egb9e9g800f1075bb8d"
msgid "Not even close."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = cd34ca63-24d1-1026-e8d6-2b0be74ae6bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_RejectShar_KilledParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:cd34ca63-24d1-1026-e8d6-2b0be74ae6bc
msgctxt "h13ccf996g4b53g4496g9fbag0b79538533ad"
msgid "I had my family, for too short a moment. Now they're gone. By my hand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = cf368ffe-7644-a750-8b77-dd9d1d99cd13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_Shar_SavedParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:cf368ffe-7644-a750-8b77-dd9d1d99cd13
msgctxt "hb6bc042age6f7g4885ga455gfffe9dbaf431"
msgid ""
"Shame. More than I ever knew it was possible to feel. Shar left me with all "
"the memories I need to punish myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = d0d52e0e-d255-db4c-f1d6-5d4f41c20c9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:d0d52e0e-d255-db4c-f1d6-5d4f41c20c9e
msgctxt "h1bd02c72gaac2g4e18g8ce0g484aebabe819"
msgid ""
"I'll follow. But I think I want to stay here a little longer, firstly. This "
"place isn't familiar, but it's peaceful."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = d32f8c22-aff9-5be4-59a6-ea244be10319
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_DaughterTears_SD_Event_QueriedName(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:d32f8c22-aff9-5be4-59a6-ea244be10319
msgctxt "he6fdc100g8245g4e89ga6c7g27e16c238223"
msgid "So what is it now - Shadowheart or Jenevelle?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = d3b6d54a-9137-dac1-10d0-be8702bb3f96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:d3b6d54a-9137-dac1-10d0-be8702bb3f96
msgctxt "hcf6d7d6fg9fe1g46e9gbf25g8522247c4e8a"
msgid "You point them towards me - I'll sort their bacon in no time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = d810a9eb-0ea3-ce62-9b56-04dd5da6471d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:d810a9eb-0ea3-ce62-9b56-04dd5da6471d
msgctxt "h231e9a22gcb1cg4311ga7f8g211b0849b225"
msgid "I'm sorry. You shouldn't have to see me like this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = d963a5ce-37ea-86fa-03f8-b6fc9a2a4192
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:d963a5ce-37ea-86fa-03f8-b6fc9a2a4192
msgctxt "hc34a7719gc0b9g43b8g8b2cgf35862e3642c"
msgid "No, Jen. That's what <i>they </i>called you - forced on you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = da6994d1-d1e5-dd70-eee5-4c03b5900aff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:da6994d1-d1e5-dd70-eee5-4c03b5900aff
msgctxt "hb00f2a95g01feg40d4g9437ga386b6e032b6"
msgid "It's Shadowheart, please."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = de701066-c5e1-5e29-b920-13fc17bbb9d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:de701066-c5e1-5e29-b920-13fc17bbb9d2
msgctxt "hc4c91205g18aag4a7dgb726gd77b1ba8d427"
msgid ""
"It's more than that. It speaks to both sides of you. After all, you cannot "
"cast a shadow without some light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = e29cb189-c715-e8bd-3d7e-a61f8f088186
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:e29cb189-c715-e8bd-3d7e-a61f8f088186
msgctxt "h2250bb34g26bcg4920g930cgbe27478f7f51"
msgid "Seeing you as yourself again, Jen. It kept us going, all this time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = e37c5ed5-9575-88c0-e614-19ea56ef0d72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:e37c5ed5-9575-88c0-e614-19ea56ef0d72
msgctxt "h410d5d63g045dg478dg9497g069d175a22c4"
msgid "I didn't think you'd understand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = e638beba-9fb8-7d0c-f049-4861a6717336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:e638beba-9fb8-7d0c-f049-4861a6717336
msgctxt "h70cbeea7gd6bbg4117g8c95gecf1ab349313"
msgid "I don't deserve you. Not after all I did to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = e839f2f6-108a-1aa1-5f58-a11d4f481920
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:e839f2f6-108a-1aa1-5f58-a11d4f481920
msgctxt "hf47b2168ga0e5g4946g9617gedab8f139b0c"
msgid "The Moonmaiden guides, but discreetly. Give it time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Player
#. NodeID = eb15826c-8acd-9717-5c2c-10e1436b3e0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:eb15826c-8acd-9717-5c2c-10e1436b3e0e
msgctxt "hef8b331ag4ac5g48a3g8765g01dc89913164"
msgid "<i>Tears are coming. Let them flow.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Shadowheart
#. NodeID = f1d2fbbc-bdb3-7032-f0fc-0c8b4dd07921
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:f1d2fbbc-bdb3-7032-f0fc-0c8b4dd07921
msgctxt "h275c31d3g03a7g4bfagae15g4785e18825bf"
msgid ""
"A very good thing. I don't know what I did to trick you into thinking I was "
"worthy of you, but I'm glad it worked."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Arnell Hallowleaf
#. NodeID = f6e93673-9c58-0032-69ad-eea940a86c29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:f6e93673-9c58-0032-69ad-eea940a86c29
msgctxt "h77e2e3d5g3a43g4ae5ga6e7g488ddbd386c9"
msgid "And we're not going anywhere, Jenevelle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD
#. Speaker = Emmeline Hallowleaf
#. NodeID = ffdd1be2-6ff4-ae01-3721-328f559ce61d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DaughterTears_SD:ffdd1be2-6ff4-ae01-3721-328f559ce61d
msgctxt "h97411749g6ee0g4acdga6b9gfa44ed741c64"
msgid "I'll call you whatever you like, so long as you're happy. Arnell?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = 083a77c0-5d7c-4167-8b38-2d5ce4eab5b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:083a77c0-5d7c-4167-8b38-2d5ce4eab5b9
msgctxt "h11d56545g8aa7g456egb797g29b43a8a9217"
msgid "<i>Accept the pain.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = 12845697-cd11-25fe-5b64-d83efab96f06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:12845697-cd11-25fe-5b64-d83efab96f06
msgctxt "hf8a133f2gedb6g4959ga22eg6c177a354545"
msgid ""
"<i>The pain must be a test. To embrace Lady Shar completely is to leave all "
"pain and sorrow behind.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 152614cc-7aeb-7e76-2888-b6ce9b6c2470
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:152614cc-7aeb-7e76-2888-b6ce9b6c2470
msgctxt "hd69ab72eg6411g47fdg84afg67ea18885d94"
msgid ""
"*What does the Dark Lady want of you? At times, it feels like she is "
"punishing you, while other times, she shields you. You feel lost - a "
"sensation that is not new to you...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 1a97b1dd-6de0-421f-80a2-46294b73ccb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:1a97b1dd-6de0-421f-80a2-46294b73ccb9
msgctxt "h00d503d4g1c97g4598gaf13g0c9197c8eb39"
msgid ""
"*Useless. The pain floods your nerves no matter what. You clench your jaw "
"until it eases.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 1b34c11b-9a7a-e355-dbd6-28503eefffd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:1b34c11b-9a7a-e355-dbd6-28503eefffd1
msgctxt "hb42a0dbag46edg4f78g8cf5ge5422c3dec67"
msgid ""
"*That memory of the woods, nearly dying, being saved... it's all you have of "
"your childhood. Lady Shar guards the rest.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = 1c01680b-6f6c-4c69-93d3-45bf6434e402
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:1c01680b-6f6c-4c69-93d3-45bf6434e402
msgctxt "h315e60f5g260ag456fgbb70g211f3a03e06a"
msgid "<i>Resist the pain.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 2467e1aa-cb30-a3ad-9b18-602c71443da1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:2467e1aa-cb30-a3ad-9b18-602c71443da1
msgctxt "h7d467c55gc35cg4a5dg98a9gf5b2e94a5a5f"
msgid ""
"*Lady Shar aids you in the dark, and punishes you when you stray. She is "
"guiding you towards something.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 2f4a74e3-8acd-4dbb-8887-2a845a582e7c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_BecomeJusticiar = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:2f4a74e3-8acd-4dbb-8887-2a845a582e7c
msgctxt "h769b339fg8e2eg4b8dga1e1g0024bdd04e7c"
msgid ""
"*This cannot be a coincidence. Dare you dream of joining the ranks of her "
"elite...?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 31ce49a3-f892-474a-b139-8976a7575f73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:31ce49a3-f892-474a-b139-8976a7575f73
msgctxt "h64f1594eg367cg4318gb9c4g0ebf64db31d2"
msgid ""
"*It is impossible to think straight. Only the pain fills your head, until it "
"starts to ebb away...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = 37c5f1f2-3416-45f4-a613-be4129be6a68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_ExperiencedWound = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:37c5f1f2-3416-45f4-a613-be4129be6a68
msgctxt "ha05c82fdgac9cg430fgbd09g5d89b486ad7e"
msgid ""
"<i>The pain guides. It teaches. Only when you stray from the Nightsinger's "
"path, does it bite.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 43c742b5-e216-8fb5-f3b9-e1ca312c6640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:43c742b5-e216-8fb5-f3b9-e1ca312c6640
msgctxt "ha9375e3bg015eg41ecg9a13g23a7ed30b237"
msgid ""
"*What does the Dark Lady want of you? At times, it feels like you are "
"without guidance, while other times, she shields you. You feel lost - a "
"sensation that is not new to you...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 4b73ec11-070c-4a01-ac92-f9329a72e7e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_WoundSuspicion = True
#.      - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#.      - ORI_Shadowheart_Knows_IncurableWound = False
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_ExperiencedWound = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:4b73ec11-070c-4a01-ac92-f9329a72e7e7
msgctxt "hf559bf44g4e11g46caga8e8g30ae44cf6342"
msgid ""
"*You feel the pain swell in your right hand. Invisible agony that rises from "
"nowhere.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 52233615-69c8-aa67-295a-db0b3aea1440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:52233615-69c8-aa67-295a-db0b3aea1440
msgctxt "h88bb37ccg881eg4012g8f63gd15ac5211b6e"
msgid ""
"*And yet... Lady Shar herself seems to guide you elsewhere. Surely you "
"cannot resist her influence. Perhaps Baldur's Gate can come later...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 53b0b6fe-0c79-9f38-01e2-e57692425c14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:53b0b6fe-0c79-9f38-01e2-e57692425c14
msgctxt "hcd366a76ge88dg4925g9e89g1721f667ba00"
msgid ""
"*The possibilities are countless. You could have been lost, abandoned, "
"orphaned, or even offered as a sacrifice to the gods.* "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 5828cfdb-4cc2-e12c-b50a-855ba9878494
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:5828cfdb-4cc2-e12c-b50a-855ba9878494
msgctxt "hfb17956eg3587g4762g9a8agd08028899008"
msgid ""
"*Rest eludes you. All you can think of is this strange new place, where  "
"even the stars themselves have been smothered by Lady Shar's embrace.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 61813321-7994-fd95-4e52-0cfbe4ffc4fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:61813321-7994-fd95-4e52-0cfbe4ffc4fe
msgctxt "hc8389691gca2fg432bg9460ga6d1748b80b3"
msgid "*This cannot be a coincidence. She must have a plan for you.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 78a73187-ffe6-0c24-953e-56b1d55e8992
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:78a73187-ffe6-0c24-953e-56b1d55e8992
msgctxt "h559609c5g2158g4890g8806geb3e6469b4f6"
msgid ""
"*Some druids force children to live off the land. Selûnites leave their "
"young in the wilds and challenge them to find their way home. Followers of "
"Talos are said to sacrifice innocents to lightning.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = 7ad84784-46b0-4598-9dea-72fa2d98f184
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:7ad84784-46b0-4598-9dea-72fa2d98f184
msgctxt "ha5961fd5g6260g4b41g8b10g9f8b9448e9dd"
msgid "<i>Focus. What could be the cause of this?</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = 93f5cca3-a252-ea92-7108-bd41018af35b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:93f5cca3-a252-ea92-7108-bd41018af35b
msgctxt "hb1e582eege75cg45bcgbf32gc004e995d637"
msgid ""
"*But it was Lady Shar who embraced you, whatever your past. You serve her, "
"and now she guides you towards something.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = b85693ae-640c-45d8-ab5e-b0433d56f089
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_IncurableWound = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:b85693ae-640c-45d8-ab5e-b0433d56f089
msgctxt "h14c071adgc517g4ef8g91f2g97097b2b8968"
msgid ""
"*Rest eludes you. All you can think of is this strange new place, where  "
"even the stars themselves have been smothered by Lady Shar's embrace.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = c05e34a5-9624-72ca-bfe4-c4ea1fedb3ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:c05e34a5-9624-72ca-bfe4-c4ea1fedb3ab
msgctxt "h7bd2a29fgc826g4cd3g820eg63813ec10b77"
msgid ""
"*Whatever awaits you in these lands is important, and must be found. The "
"Dark Lady wills it... in her own way.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = c200f65b-3d31-4cce-a502-efb54b96f233
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_DarkJusticiarSuspicion = True
#.      - ORI_Shadowheart_Knows_JusticiarDream = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:c200f65b-3d31-4cce-a502-efb54b96f233
msgctxt "hf3cfae93g1977g46bfg8dd4gf2315cd0cd10"
msgid ""
"<i>There were Dark Justiciars here once - you saw the signs. You should heed "
"them - learn more.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = c4a3dc16-f0ba-b38b-3462-338d7e385bc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:c4a3dc16-f0ba-b38b-3462-338d7e385bc2
msgctxt "h3a750db9g7c15g4d7agb6c7gba6232d57d3d"
msgid ""
"*Such feelings serve no purpose - you must cast them aside. Lady Shar will "
"reveal all, in time. Even now, you sense she is guiding you towards "
"something.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = c6e35ef7-eeb4-4b4f-932b-9d0f52bb527b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_WoundSuspicion = False
#.      - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_ExperiencedWound = True
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:c6e35ef7-eeb4-4b4f-932b-9d0f52bb527b
msgctxt "h1ab53d7fg79b8g4763g92bdg01afa83f132d"
msgid ""
"*As you lose yourself in the fragments of a past you barely recognise, you "
"feel a dull ache spread from your right hand.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = d26835c4-67bc-d613-e96d-74221d5f46e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_JusticiarDream = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:d26835c4-67bc-d613-e96d-74221d5f46e1
msgctxt "hb46f961cg0259g4a0bga4a0gff1a4c75ecdc"
msgid ""
"<i>There were Dark Justiciars here once - you saw the signs. There must be a "
"temple - somewhere dedicated to Lady Shar.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = e1fe6447-e7b5-4854-a619-9cad27e702ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_DarkJusticiarSuspicion = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:e1fe6447-e7b5-4854-a619-9cad27e702ec
msgctxt "h2fa5f3fag5b45g4341g91a1g22194939de6d"
msgid ""
"<i>This land is under the Lady Shar's sway. Maybe answers lie where her "
"power is strongest.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = e8b78bf6-7fee-4546-9448-6a7345e35d72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:e8b78bf6-7fee-4546-9448-6a7345e35d72
msgctxt "h73f9c267g90d6g4ea4gb8efg6d75488d58c3"
msgid ""
"*In fact, one of the few memories you can still lay claim to is of being "
"lost. Lost and afraid...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = f2db525c-9546-6df8-2062-74cd061b2b2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:f2db525c-9546-6df8-2062-74cd061b2b2f
msgctxt "h20b67217g6402g4e9bga05eg74a656bcd1b4"
msgid ""
"<i>Concentrate on your mission. The Mother Superior awaits your return to "
"Baldur's Gate.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Player
#. NodeID = f50f092b-b1bb-2181-2f26-d28a1a9639af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:f50f092b-b1bb-2181-2f26-d28a1a9639af
msgctxt "h1970e2f5gf386g4795g8985g4b25196ac31b"
msgid ""
"<i>Why were you alone in those woods? The gaps in your memories are vast, "
"unnerving...</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD
#. Speaker = Narrator
#. NodeID = f8e3ac07-ec93-d8ad-5446-2b4c722d4598
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_DreamReflection_SD:f8e3ac07-ec93-d8ad-5446-2b4c722d4598
msgctxt "h0b0412deg1e2cg48dag818ag1cb2ba5a45f8"
msgid ""
"*Perhaps this is a test. Mother Superior would have you make for Baldur's "
"Gate without delay... but the call of the Dark Shar cannot go ignored.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 020cda78-05c5-0d3d-c2fe-b8ae4972857f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:020cda78-05c5-0d3d-c2fe-b8ae4972857f
msgctxt "hfb08f8d0g8b00g49c1g8c3ag0f2615374af2"
msgid "Yes. But I'm afraid I forgot to bring any food..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 0cd380bc-916f-79fb-affc-2207017ba654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:0cd380bc-916f-79fb-affc-2207017ba654
msgctxt "h4a70777eg0da0g4313gb42ag73402b5d8627"
msgid "Let's see what comfort we can offer a grieving mother."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 101af10d-34da-c685-c990-a829bc71b881
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:101af10d-34da-c685-c990-a829bc71b881
msgctxt "h861402d0g88bbg437bg8293g6c5f982ae442"
msgid "Of course. I'm clearly better at wickedness than you are."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 10a7a0b3-cb14-a63a-d3fb-07ff3705b303
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:10a7a0b3-cb14-a63a-d3fb-07ff3705b303
msgctxt "hb59d546dg8157g41baga871ge94ed4342cf9"
msgid "Oh yes? Show me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 11b485b3-fa51-23d0-3b67-783896e9cedb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_CRD_NightfallRomance_Event_SHExplains_UnconventionaRomance(0) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_CRD_NightfallRomance_Event_SHExplains_UnconventionaRomance(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:11b485b3-fa51-23d0-3b67-783896e9cedb
msgctxt "h1d7a4e93g35f0g4727gb427g73fd108170e2"
msgid ""
"I thought you had no time for lovers anymore - what does this mean for us?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 11e52494-dd84-4d02-9e92-ea33e33bb792
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:11e52494-dd84-4d02-9e92-ea33e33bb792
msgctxt "h30ade1cag5624g45ccg8856g34f0db9a09e7"
msgid ""
"Physically? No... that part is already done. This will wound the spirit. "
"Most deeply, I should hope."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 156f9f04-1148-0f8d-ef6a-9b164e1b1d0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:156f9f04-1148-0f8d-ef6a-9b164e1b1d0e
msgctxt "hf2a38a18g00cfg4be6gbc54gb65ca1025779"
msgid "A little healthy competition. Nothing to fear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 2e59932d-79c9-78d9-9f69-c809a829b703
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:2e59932d-79c9-78d9-9f69-c809a829b703
msgctxt "hac96e215ga0d9g4326g9a6fg4933d75c0e32"
msgid "Gods, what I wouldn't give to kiss you right now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3398670f-b142-eb7d-7fab-62e59cd4a406
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_AbortedNightfall = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:3398670f-b142-eb7d-7fab-62e59cd4a406
msgctxt "hd1fae5e8gaae1g40e4gb927g5e977d81d632"
msgid "Go, then. Maybe you can do better by yourself, though I doubt it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 35aa74ba-f185-5e4b-e490-4323a45ab2ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:35aa74ba-f185-5e4b-e490-4323a45ab2ea
msgctxt "h010f5368gb4a6g4a4dg99f9g97408dc00576"
msgid "I've changed my mind."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3993687b-d353-7b04-8170-fd4a6f05cc95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:3993687b-d353-7b04-8170-fd4a6f05cc95
msgctxt "h3de76e06ga154g482fg82a9geb5ced7ad49d"
msgid ""
"First the act of wickedness, then the feast... but I think this will count "
"as both at once."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3a1af616-3532-f5ff-5219-2c2d60f49df3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:3a1af616-3532-f5ff-5219-2c2d60f49df3
msgctxt "h241634a8g7863g4a2dg85b3g8591e227de92"
msgid "Stop being so gentle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 43a04cf0-825d-42f0-eea1-cc5ce07e6374
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:43a04cf0-825d-42f0-eea1-cc5ce07e6374
msgctxt "h531a4c18g3542g4199gb871gcadb5777f9d6"
msgid ""
"It means nothing. Shar owns my heart. But luckily she's willing to share the "
"rest of me, just this once."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 5aa3dc85-21c9-0f2f-a738-b82c5472618e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:5aa3dc85-21c9-0f2f-a738-b82c5472618e
msgctxt "h42fa3de2g5049g4546gb527g73db87a8493e"
msgid "That's what makes it so good."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 623a5de2-d51c-1339-f591-647f5309e782
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_AbortedNightfall = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:623a5de2-d51c-1339-f591-647f5309e782
msgctxt "hf8d1ede3g7f92g4ec1ga7edg2f4e18938696"
msgid "Go, then. Lady Shar's blessings can be for me alone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 63a57fca-bb63-96ba-1859-937d119dca53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:63a57fca-bb63-96ba-1859-937d119dca53
msgctxt "h5aa08a94g8a49g4616gb15fg2dbf19d7eb4f"
msgid "Fine suggestions, all. Perhaps another time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 6be7b686-911d-92fc-905d-9443becd642c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_Act3RomanceEnded = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:6be7b686-911d-92fc-905d-9443becd642c
msgctxt "h64759e4ag97cag4600gaf98g93a0d58cbb0c"
msgid "<i>Kiss her.</i>"
msgstr "<i>그녀에게 키스한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 72820ec7-571d-2626-4282-43cff6b34b8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:72820ec7-571d-2626-4282-43cff6b34b8f
msgctxt "h70dea590g5364g4b79gbcf9gddcdd7f1d3b8"
msgid "I'm not afraid. Far from it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 7a8d1333-5b8a-aa6b-2ff3-1fa5fde24327
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:7a8d1333-5b8a-aa6b-2ff3-1fa5fde24327
msgctxt "hcdd1c918g7055g45c2g84c7g35f658f96a98"
msgid "So what shall we be doing? Theft? Arson? Murder? Foul language?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = 84cfbe9f-b127-027e-24a8-6548b41e9b66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:84cfbe9f-b127-027e-24a8-6548b41e9b66
msgctxt "h3b79fc7eg9769g4a09g9ebcg64722b75bbf3"
msgid "Not at all. So now we feast?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 8c955470-209d-9741-eff6-a5c523682061
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:8c955470-209d-9741-eff6-a5c523682061
msgctxt "h0bc6fed1g7878g43e3gb9b1ga6cb2e6778c3"
msgid "Indeed? And what else might you be willing to do...?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 94f1fdab-811d-4b93-ba1a-e4dce8b57c53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:94f1fdab-811d-4b93-ba1a-e4dce8b57c53
msgctxt "h174b9c94gcbbdg4dd2g9aadgd23eb0038764"
msgid "This is the spot. Looks like someone's left poor Selûne untended..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = a4eb533e-b5dc-7ea7-f2a0-ec0a64d544f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:a4eb533e-b5dc-7ea7-f2a0-ec0a64d544f5
msgctxt "h5ad93a79g00d7g4040gbc28g6f477aff913d"
msgid "A little. I like it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = b1184771-600f-0915-eeec-edec3771782b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:b1184771-600f-0915-eeec-edec3771782b
msgctxt "hc0400440g294fg4561g9b66g0724220dc902"
msgid "What's that? More wine?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = b20081f1-3385-51e4-3213-cb87201fb6b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:b20081f1-3385-51e4-3213-cb87201fb6b7
msgctxt "hf84ce362gfed3g485ag94ccgfd342b525fa0"
msgid "This act of wickedness - it isn't going to hurt anyone, is it?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = bb3493d8-845c-1837-b593-c4697b3134ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:bb3493d8-845c-1837-b593-c4697b3134ce
msgctxt "h03195e66gfa9bg4f40g9791g557e63242405"
msgid ""
"After I offered up the Nightsong to Lady Shar, her blood was on the spear, "
"on my hands, on my clothing. I wrung out every drop I could. Saved it for a "
"special occasion."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = bba89eeb-74b4-7713-2fb2-5849cfab55c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:bba89eeb-74b4-7713-2fb2-5849cfab55c2
msgctxt "hcf7028a7g08cfg4708gbcdagf8409e07ada4"
msgid "Why, feeling threatened?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = bd038cb2-096d-8a19-4215-e33dc944c713
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_Act3RomanceEnded = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:bd038cb2-096d-8a19-4215-e33dc944c713
msgctxt "hf3aa3c55g72afg4acfga101g0556e79533e6"
msgid "<i>Kiss her.</i>"
msgstr "<i>그녀에게 키스한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = c6fcee95-8a9a-6666-cd16-2e92b1ac8666
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:c6fcee95-8a9a-6666-cd16-2e92b1ac8666
msgctxt "hd7eac856g3ed0g4f6egbf4bg816b910b671c"
msgid "No. It ends here. Farewell."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = c93dabd7-0f8a-2703-a904-45e3f9e91744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:c93dabd7-0f8a-2703-a904-45e3f9e91744
msgctxt "h60fd8714g45fag4241gb3f4g8800a493f4c3"
msgid "Stop being so gentle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = d5640384-3631-1495-abd2-32eb66c35342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:d5640384-3631-1495-abd2-32eb66c35342
msgctxt "hc2674b00g64d2g4436g935fg2131d7b6528a"
msgid "But whatever you have to give... it's not enough, is it?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = d6674868-f2e7-fa37-93ff-997a9527bbbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:d6674868-f2e7-fa37-93ff-997a9527bbbc
msgctxt "h35a7f78cg659cg407eg8043g8b2a6f5698f8"
msgid ""
"Selûne will forgive me. I did what I had to, for the sake of our partnership."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = de503ea3-44d5-d7ed-ecd7-c40877e51191
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:de503ea3-44d5-d7ed-ecd7-c40877e51191
msgctxt "h9a7f888egcbb6g4128gb420g1816a049e5e9"
msgid ""
"Something of a much rarer vintage. After I offered up the Nightsong to Lady "
"Shar, her blood was on the spear, on my hands, on my clothing. I wrung out "
"every drop I could. Saved it for a special occasion."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Player
#. NodeID = e276b3a1-5228-0816-74b7-edecde39360a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:e276b3a1-5228-0816-74b7-edecde39360a
msgctxt "h11fbfbf8gbd02g4137g803agb6d30fb626d2"
msgid "This is wrong."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = e4d92ab1-a76c-51a0-adec-229bff6baa4e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_AbortedNightfall = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:e4d92ab1-a76c-51a0-adec-229bff6baa4e
msgctxt "h3a2afb37g5365g4cfcga3b0gddd00514c872"
msgid ""
"A shame. I wanted to show you just how rewarding the embrace of darkness "
"could be... but perhaps it is not meant for you. Good night."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM
#. Speaker = Shadowheart
#. NodeID = e7724952-12c3-5fb8-8384-2432caad1227
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Nightfall_SD_ROM:e7724952-12c3-5fb8-8384-2432caad1227
msgctxt "hc514c2ddg1b4ag4ba6gbb1ega831ea619a01"
msgid ""
"You did well. I hope you're not trying to surpass me in Lady Shar's graces."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation
#. Speaker = Shadowheart
#. NodeID = 139505d8-ad8d-4489-0691-a34f070b880b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation:139505d8-ad8d-4489-0691-a34f070b880b
msgctxt "hff1c8253g3e4bg45b8g905cg9f3ad91a468c"
msgid ""
"Oh. A pity - I've been missing out on beauty sleep, just to wait up on you. "
"Good night."
msgstr "아. 아쉽네. 널 기다리느라 잠도 못 자고 있었는데 . 잘 자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation
#. Speaker = Shadowheart
#. NodeID = 7783b346-cf2f-4baf-2e69-5335ca7fc945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation:7783b346-cf2f-4baf-2e69-5335ca7fc945
msgctxt "h0a09568cg4464g4821g95d7g268fb3a35935"
msgid ""
"It seems to be the perfect night to spend a little time together, just you "
"and I... assuming you haven't changed your mind, of course?"
msgstr "우리 둘만의 시간을 보내기에 완벽한 밤인 것 같네... 물론 네 마음이 바뀌지 않았다는 전제하에, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = a6aa531e-d907-cba5-9eb4-f9d172642783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation:a6aa531e-d907-cba5-9eb4-f9d172642783
msgctxt "h4ad0f3c1gdd6cg4c92g8957g9f446348a672"
msgid "I'm sorry, but I don't think we should do this."
msgstr "미안한데, 우리 이렇게 하면 안 될 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = adb83ae7-4993-5701-d49e-44885ef05974
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Shadowheart_Event_PlayRomance1_AfterCelebration(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_Romance1_SD_Invitation:adb83ae7-4993-5701-d49e-44885ef05974
msgctxt "hde8bcc1ag4eb1g4213g9a2fgf28cf2bdfa53"
msgid "Lead the way."
msgstr "앞장 서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 0403b053-4b6c-9cfb-7b95-007c6024509b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:0403b053-4b6c-9cfb-7b95-007c6024509b
msgctxt "h1ca9a875g7858g4c99g92adg1739fcf0e0f7"
msgid "I never said I was coming in with you."
msgstr "너와 함께 물에 들어가겠다고 하진 않았는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 0f0c1d31-6bd6-192a-e2ec-aa99b0acb6c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:0f0c1d31-6bd6-192a-e2ec-aa99b0acb6c9
msgctxt "he6381b8bg0d3ag4403g961fg7b9437346990"
msgid "Just a pebble."
msgstr "그냥 조약돌이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 0f3894ec-9699-2491-62cf-7319f2724185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:0f3894ec-9699-2491-62cf-7319f2724185
msgctxt "hb0091120gbc4eg440dg82c9g8ab89dd927ae"
msgid "Just joking."
msgstr "장난이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 0f5efd93-83a5-465d-9730-d052b56fbde9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:0f5efd93-83a5-465d-9730-d052b56fbde9
msgctxt "h656e5a0dg8d68g4483g8d17g68a7cef38d0f"
msgid ""
"Thank you. I needed that. I needed to know I can face things without Shar."
msgstr "고마워. 이게 필요했어. 샤 없이 혼자서도 해낼 수 있는지 알아야 했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 1088174b-9d23-990a-4978-037df327a1b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:1088174b-9d23-990a-4978-037df327a1b9
msgctxt "h2372ed03gcf94g4575gbc56gd748ae7b936c"
msgid "Come here..."
msgstr "이리 와..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 125177b2-4865-efb9-7b32-31638c0be797
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_Act3RomanceEnded = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:125177b2-4865-efb9-7b32-31638c0be797
msgctxt "hd7fb6c86g1284g42a6g8c14g5cd4594bf6fa"
msgid "You first."
msgstr "너 먼저."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 133de80e-5f3d-8778-8898-5c459389bcb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:133de80e-5f3d-8778-8898-5c459389bcb2
msgctxt "h7e48307egadb4g4b0cg9c2fg41da3bff20b6"
msgid ""
"I'd drag you into the sand if I thought I'd survive it. Then again, I "
"suppose I can think of worse ways to die."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 1532f65b-a107-ac19-5ec5-1f91a672aa79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:1532f65b-a107-ac19-5ec5-1f91a672aa79
msgctxt "h8aee4ba5ge989g4e47gbfecg21157715e26c"
msgid ""
"Don't just stare while you're still dressed, I mean. Come on, I kept up my "
"end of the bargain - will you keep up yours?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 180e96dc-c4fc-f393-8278-291296707cea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRAGONBORN(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:180e96dc-c4fc-f393-8278-291296707cea
msgctxt "h6b57bf6eg4f16g44d6gbc7eg64cb6f82e6a5"
msgid "Now don't you dare stop."
msgstr "이제 멈출 생각도 하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 1be30f29-1f4c-4ac4-ef91-ca4183c9fe9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:1be30f29-1f4c-4ac4-ef91-ca4183c9fe9e
msgctxt "ha92695b6g3da0g42b0g928dg507c92a8d0c6"
msgid "Fine. Well don't just stand there, turn around."
msgstr "알았어. 저기, 그렇게 서있지만 말고 돌아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 1f7fe1ed-356b-480a-b24b-241a783e4d3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:1f7fe1ed-356b-480a-b24b-241a783e4d3a
msgctxt "h42eb6eddg8f16g44f6gaf74g6d9becbbdb3a"
msgid "This will do. Take off your clothes."
msgstr "여기면 될 거야. 옷을 벗어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 209a6af4-1a79-cbe3-665e-63c03a31db0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:209a6af4-1a79-cbe3-665e-63c03a31db0c
msgctxt "h5bf613f7g87aag4022gadfag6c63f8d96838"
msgid "Now don't you dare stop."
msgstr "이제 절대 멈추지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 2239641b-fbf0-cfdf-0396-b06807919e51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:2239641b-fbf0-cfdf-0396-b06807919e51
msgctxt "hb84da343gce44g466agb931g10a8f278f95b"
msgid "I know. Your turn."
msgstr "알고 있어. 네 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 240f2dec-89fa-e34a-0ac2-71c32bb9dca7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:240f2dec-89fa-e34a-0ac2-71c32bb9dca7
msgctxt "hef56ba45g1e6cg47bfgae91geb7845620801"
msgid "This will do. Get in the water."
msgstr "여기면 될 거야. 물에 들어가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 24fc54d4-26a0-4552-35da-d532a3adf968
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:24fc54d4-26a0-4552-35da-d532a3adf968
msgctxt "h48e3dbd3g63dcg4566g9db2g01ef500296a8"
msgid "I... I don't know if I can do this. Now that I'm here."
msgstr "나... 막상 여기까지 오니까 할 수 있을지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 305900fc-6f1e-4a93-8038-fa28dadebba3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:305900fc-6f1e-4a93-8038-fa28dadebba3
msgctxt "hd59008afg0869g4215g87ddgb319d98a9399"
msgid "Neither did I."
msgstr "나도 마찬가지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 31b1b69b-0fbb-35a1-7a0e-4b222b0c06ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:31b1b69b-0fbb-35a1-7a0e-4b222b0c06ce
msgctxt "h3edcb705g95f8g4277ga3b5g0f95c69fef4e"
msgid ""
"My feet aren't touching the bottom anymore - it's <i>terrifying</i>. Do "
"people really enjoy this?"
msgstr "발이 더 이상 바닥에 닿지 않아. 이거 <i>정말 무서워</i>. 사람들이 정말 이런 걸 즐기는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 34940b93-a851-62d9-335c-78ddad72b21d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:34940b93-a851-62d9-335c-78ddad72b21d
msgctxt "h630ef23fge279g4a38ga79bg5d8fcaaefd57"
msgid "A little misdirection. Couldn't resist."
msgstr "약간의 일탈이야. 거부할 수가 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 390a676b-2b7d-a9d6-c22f-0d5c0c135f31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:390a676b-2b7d-a9d6-c22f-0d5c0c135f31
msgctxt "hdab87d53g7e31g43ceg963egbe8f1abee599"
msgid "All the things we've faced, and you're afraid of getting a little wet?"
msgstr "지금까지 겪어온 게 있는데 조금 젖는 걸 무서워하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3a871af3-534a-8c43-9ea9-57bac7dba55f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:3a871af3-534a-8c43-9ea9-57bac7dba55f
msgctxt "h5d6e749eg4c26g41b1gb2e7ga8db38ee3e9d"
msgid "Now come on, get those clothes off. You've made me wait long enough."
msgstr "이제 적당히 하고 옷 좀 벗어. 나 충분히 오래 기다렸단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3c78e6db-d620-1c70-850e-2c181f3595df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:3c78e6db-d620-1c70-850e-2c181f3595df
msgctxt "h198bdddeg81f6g44e8gb556g2a14b27740d0"
msgid "What...? Wait!"
msgstr "뭐야...? 기다려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3d89f23e-0d16-2e03-31b9-bd9b3b82c6e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:3d89f23e-0d16-2e03-31b9-bd9b3b82c6e8
msgctxt "ha0852e50ga691g488bg82d8ge7e5f2c64d39"
msgid "No."
msgstr "싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3ebad58e-f584-7491-848e-685b5416dcc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:3ebad58e-f584-7491-848e-685b5416dcc3
msgctxt "hd9e88687g4564g4e8bgadfeg80deaa4c0d97"
msgid ""
"Well you can't be of much help to me from the shoreline, can you? Shouting "
"moral support while I drown?"
msgstr "뭍에서는 날 딱히 도와줄 수 없잖아, 안 그래? 내가 가라앉는 동안 응원이라도 해주려는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 3f1636fc-8ace-b430-d371-611e3b26a7c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:3f1636fc-8ace-b430-d371-611e3b26a7c1
msgctxt "ha3813a1ag9209g4740g9469g385ce634a91b"
msgid "You first."
msgstr "너 먼저."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 3fc6e8cf-c3a4-b36e-0bc5-ba5bb0936c0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:3fc6e8cf-c3a4-b36e-0bc5-ba5bb0936c0e
msgctxt "h8c6446e8g01cbg4eecg92b7g9b34277b7626"
msgid "Now don't you dare stop."
msgstr "이제 절대 멈추지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 410ce122-273f-6be7-7b11-7e7704478e4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:410ce122-273f-6be7-7b11-7e7704478e4e
msgctxt "h7f79ad66gcd8fg42dcg9754g792daac1258a"
msgid "Let's get on with it, before I lose my nerve."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 45b93976-c611-89c0-9546-41fb7996be5a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_AbortedSkinnydipping = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:45b93976-c611-89c0-9546-41fb7996be5a
msgctxt "h37f2f072g12d6g49a0gbe85gd6842c8fb617"
msgid "Yes. A silent one, if you have any sense."
msgstr "그래. 침묵 속에서 걷게 되겠네, 네가 눈치가 조금이라도 있다면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 46ccf94a-dd50-e23d-fdee-62d7329531ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:46ccf94a-dd50-e23d-fdee-62d7329531ae
msgctxt "h0e87450cgba52g4f6egad00g6913fa7ae11e"
msgid "We'd better get warmed up then. Come on."
msgstr "그럼 몸을 풀어야겠는걸. 이리 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 4efd35a6-fa0a-29ae-4607-856e5c114afe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:4efd35a6-fa0a-29ae-4607-856e5c114afe
msgctxt "h0dc94cc5g8ac0g4effg8bceg04266fc2579c"
msgid "You haven't even attempted to peek. I'm a little offended."
msgstr "엿보려는 시도조차 안하다니. 나 약간 상처받으려고 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 5468f58e-d121-cfbf-c360-fc732017fd0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:5468f58e-d121-cfbf-c360-fc732017fd0a
msgctxt "h618b18d2g8814g45e6ga781g9b98723959cd"
msgid "You can hold onto me if you're afraid."
msgstr "무서우면 내게 매달려도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 57c46703-137f-87e7-b019-fbd7f69700ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:57c46703-137f-87e7-b019-fbd7f69700ae
msgctxt "h3f44e238g8f22g456agb9dfg87f9c8187beb"
msgid "The air's a little cold."
msgstr "공기가 약간 쌀쌀하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 5e5a9953-4814-8853-b8ee-833e25b05af8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:5e5a9953-4814-8853-b8ee-833e25b05af8
msgctxt "haa44305bg4e26g46ccg8efbg09b3740cd88d"
msgid "Forget it. Let's head back."
msgstr "됐어. 그만 돌아가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 5ed450de-3345-0107-c63f-2925c0f71737
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:5ed450de-3345-0107-c63f-2925c0f71737
msgctxt "he5544debgdcaag4474g91abg16353e6f1ed3"
msgid "Go on, you're not afraid of getting a little wet, are you?"
msgstr "어서. 설마 조금 젖는 걸 무서워하는 건 아니겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 6a2822d9-9c68-ece4-b6b1-85a26f77864c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRAGONBORN(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:6a2822d9-9c68-ece4-b6b1-85a26f77864c
msgctxt "h202c9044g1a03g4c66g9dbcg48f530df081a"
msgid "Now don't you dare stop."
msgstr "이제 그만할 생각은 하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 6cb27610-514b-7f5d-11a0-8d3b6832181c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:6cb27610-514b-7f5d-11a0-8d3b6832181c
msgctxt "h1a4f10a4g8a94g479agb896ge5cd7118941b"
msgid "That's one word for it, I suppose. You can turn around again."
msgstr "그렇게 말할 수도 있겠네. 이제 다시 돌아서도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 73bb4d40-3566-7286-179d-fae9064e1979
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:73bb4d40-3566-7286-179d-fae9064e1979
msgctxt "hde33f7bcgb700g4afdgbe7bgf6cb2ecd6e92"
msgid "What? Don't just stare."
msgstr "왜? 멀뚱멀뚱 쳐다보기만 하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 7a6f6793-9df4-c925-847d-2bf276fa943e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:7a6f6793-9df4-c925-847d-2bf276fa943e
msgctxt "h9fb54eabgfdefg44d8gabdagc2fed1c5ccd0"
msgid "<i>Splash her, playfully.</i>"
msgstr "<i>장난스럽게 그녀에 물을 뿌린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 7beb3129-3efd-1f30-ceee-d7981cacb311
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:7beb3129-3efd-1f30-ceee-d7981cacb311
msgctxt "hf9a82645g3f16g4fecg8ee6gae0b284bd71f"
msgid "We can go back to shore if you're uncomfortable."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 84119a71-94b7-f909-d1aa-ba306fffe759
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:84119a71-94b7-f909-d1aa-ba306fffe759
msgctxt "h767e2e46gb280g4c32g873bgad69ac982aaa"
msgid ""
"You're lucky I didn't have anything more dangerous to throw than "
"undergarments."
msgstr "내게 속옷말고 던질만한 더 위험한 물건이 없는 걸 다행으로 여겨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 842a51fd-5738-6a2d-9482-cbf3b1535a91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:842a51fd-5738-6a2d-9482-cbf3b1535a91
msgctxt "hc2fda58dg8913g48f8g9c78g69e5c20d1eb8"
msgid "You know you didn't need to wait until I was in the water to hold me."
msgstr "있잖아, 날 안으려고 물에 들어올 때까지 기다릴 필요는 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 85c87d4f-7e3d-540a-b14c-934bcba31e32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:85c87d4f-7e3d-540a-b14c-934bcba31e32
msgctxt "h2a36d8a7ge7f5g4243g9483g7a715faa3239"
msgid "All right. Just stay close..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 8a5292c9-2dba-c31f-5a0d-9af6462e3c81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_Act3RomanceEnded = True
