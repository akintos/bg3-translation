#.     - 5c7da982-bc01-dcdb-bc8c-e9bc3ef5baea_GaveReward = True
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:6e7a705b-b220-c72a-659e-bdab8c0ba88e
msgctxt "h2dda523fg4bbdg4698g8ed0g66cfaf1a0987"
msgid ""
"I know you have more than some bloodied instrument. Empty out your pockets."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Goblin Brawler
#. NodeID = 6ec59070-bb5c-3938-4e0c-15d146ed1551
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:6ec59070-bb5c-3938-4e0c-15d146ed1551
msgctxt "h6b9e1fcfg03f9g4dbcgb24dgd521e368415f"
msgid "Had to cut off the stiff's fingers to get to it."
msgstr "그걸 가져오기 위해 시체의 손가락을 잘라야 했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Goblin Brawler
#. NodeID = 836b825e-40f7-d273-f265-e9dab6063629
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_Goblin001(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:836b825e-40f7-d273-f265-e9dab6063629
msgctxt "h917891aag08e2g459bg9be4g83d5b10a4aaf"
msgid "My True Soul."
msgstr "나의 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Narrator
#. NodeID = 84bd1902-b327-d01a-4664-602b98e66ebb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:84bd1902-b327-d01a-4664-602b98e66ebb
msgctxt "hcae40147gd136g4b71g8787gb49f2b734041"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Player
#. NodeID = 92f3acb9-5e92-6b64-d0b0-6692789fbfcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHuntCelebration_State_HasStolenInstrument(0) = True
