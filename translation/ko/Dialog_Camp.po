msgctxt "h8394e979g6063g4bb9g99e4g3a222f8036c0"
msgid "<i>Jableeda.</i>"
msgstr "<i>자블리다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = acc67144-9521-222e-47fa-eb0b63a4ba02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:acc67144-9521-222e-47fa-eb0b63a4ba02
msgctxt "h7927c1fbg3eabg4a82g9615g9f830b967c47"
msgid "I'm not sure I can pretend I don't already love you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = acfea4ba-d52a-aa99-451a-a6b8ecff0931
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:acfea4ba-d52a-aa99-451a-a6b8ecff0931
msgctxt "h641f04f8g2de8g4bcbgb9d7g30618c76a584"
msgid ""
"I'm afraid I'm doomed to repeat past mistakes, no matter how I try to avoid "
"them."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = ad9213cd-7806-2c6b-6eef-eadf731b9898
#. HandlePath = TaggedText[0].TagText[0]
