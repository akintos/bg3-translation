msgctxt "had2655f7gc831g49e3g9b37g48e5019d20a1"
msgid "We can use my glass. To us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = af6d292a-ac27-615b-5cec-0c71fabe894c
