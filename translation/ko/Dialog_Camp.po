msgctxt "h9ba43599g9c94g4bfcg9ec5g1df7af846353"
msgid "Careful! Hurts!"
msgstr "조심! 아파!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Owlbear Cub
#. NodeID = c4be48d5-9906-b72c-90c9-cc46098223a4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
