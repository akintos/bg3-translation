#.      - MONK(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:4abed3ca-117f-852e-533e-55c72512d02d
msgctxt "h734df3e8g2195g46c7gb070g6e49f999d02a"
msgid "Calm yourself - save your anger for your queen's enemies."
msgstr "진정해, 분노는 네 여왕의 적들을 위해 남겨둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 4fa94feb-e6fa-60ee-560d-1c05586018dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:4fa94feb-e6fa-60ee-560d-1c05586018dc
msgctxt "he87b7f4eg8bb9g46f9g9ea1g33d589aa9021"
msgid ""
"The <i>kith'rak</i> demands the fugitives' heads. I should have given him "
"yours."
msgstr "그 <i>키스락</i>은 도망자들의 머리를 요구했다. 네 것을 줬어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 5448fc4d-045e-a14f-299e-6744dd3da465
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:5448fc4d-045e-a14f-299e-6744dd3da465
msgctxt "hdda7d22eg2e03g490dg9116g8a70b4d573d4"
msgid ""
"The <i>kith'rak </i>is consumed by his hunt. He'd have taken my head, given "
"the chance."
msgstr "<i>키스락</i>은 스스로의 사냥에 사로 잡혀 있다. 기회가 주어졌다면 그는 나의 목숨을 앗아갔을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 5ea43341-6e6a-b74e-182b-a150aa8da8f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:5ea43341-6e6a-b74e-182b-a150aa8da8f8
msgctxt "h76296d18g25eeg47f2g8840g6d51488728fd"
msgid "And then - then I will skewer the heretic with his own silver sword."
msgstr "그리고 나서... 그리고 나서 그 이단자를 그의 은검으로 꿰뚫어 버릴 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 708b6b98-be15-af69-ab3a-0600d22a90ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Quest_GithLeave = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:708b6b98-be15-af69-ab3a-0600d22a90ee
msgctxt "h15e0b6c5g3ba3g4c39g8401gb96f0b2196ae"
msgid "A <i>kith'rak </i>demanded my head. <i>He'd deny me a cure.</i>"
msgstr "<i>키스락</i>이 내 머리를 요구했다. <i>치료받을 기회마저 앗아가다니.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 74aecff4-0c98-0e98-b748-5c975fa1e0d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:74aecff4-0c98-0e98-b748-5c975fa1e0d5
#, fuzzy
msgctxt "h01825eecg0cf3g4b5fg843dg1bb361496d71"
msgid ""
"How <i>dare</i> he speak my queen's name!  How <i>dare</i> he dishonour her "
"child!"
msgstr "<i>감히</i> 내 여왕님의 존함을 언급하다니!  <i>감히</i> 그녀의 자식의 명예를 더럽히다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 7c7defb5-1452-25c6-6c02-263a3afbbbcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:7c7defb5-1452-25c6-6c02-263a3afbbbcc
msgctxt "h803ad7d8g4a06g4e86g9b86ge9bc3b026c93"
msgid "I will remove the parasite. I will see the <i>kith'rak</i> dead."
msgstr "나는 기생충을 제거할 것이다. 그리고 그 <i>키스락</i>의 죽음을 목도할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = 7d936dae-2f64-85ae-efb1-2ea77fc70893
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:7d936dae-2f64-85ae-efb1-2ea77fc70893
msgctxt "h4449a0f5g60ddg4e7bg8419g2c4d4d6283e6"
msgid "<i>Respond with silence.</i>"
msgstr "<i>침묵으로 응답한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = 7fb1cade-27b4-3410-98ea-3e7f9450fdbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:7fb1cade-27b4-3410-98ea-3e7f9450fdbd
msgctxt "h4499602dgdbfeg410agba5bg25fdbaa26352"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 81216a61-b2f0-02eb-b9ea-903eb2ddc3d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:81216a61-b2f0-02eb-b9ea-903eb2ddc3d9
msgctxt "h8216abd4gbb6bg4750g9857g76ebd3454ad4"
msgid ""
"I will remove the parasite. I will see the <i>kith'rak</i> dead, and present "
"his corpse to Vlaakith herself."
msgstr "난 기생충을 제거할 것이다. 그리고 그 <i>키스락</i>도 죽여 그의 시체를 블라키스 님께 바치겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 81529484-8f76-b75b-2320-fbfb688a4224
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:81529484-8f76-b75b-2320-fbfb688a4224
msgctxt "h10a76b74gfb90g47f9g91e5gc02efa5cdc6a"
msgid "And I <i>will</i> offer his head to Vlaakith herself."
msgstr "그리고 블라키스 님께 놈의 머리를 <i>직접</i> 바치고 말겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 82ada82e-de06-c4b3-eef8-23192eba8d4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:82ada82e-de06-c4b3-eef8-23192eba8d4f
msgctxt "h03d9f18dg4b83g4785ga1a1g631a2a607339"
msgid ""
"I am a child of Gith. l will abide by protocol and seek the crèche "
"<i>ghustil</i>, as Vlaakith has taught."
msgstr "나는 기스의 아이다. 나는 블라키스께서 가르쳐주신 대로, 원칙에 따라 양성소의 <i>거스틸</i>을 찾을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 88bb295e-84be-9b33-cebb-51050ebd59ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:88bb295e-84be-9b33-cebb-51050ebd59ca
msgctxt "h7ed15a42g3517g4d7dg9832g42c3cd0a6caa"
msgid "Then we will see the queen's justice done."
msgstr "그러면 여왕님의 정의가 실현될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 8c527ec6-3af6-858e-cc37-5ad2b5c63804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:8c527ec6-3af6-858e-cc37-5ad2b5c63804
msgctxt "h72eef291g3adcg4e98gb565g88fd6bc01eab"
msgid ""
"And I will leave behind this wretched realm to stand at my queen's right "
"hand."
msgstr "그리고 이 비참한 렐름을 떠나 여왕님의 오른팔이 될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = 8fae9ffa-1201-0324-5e57-f53dcbfc30c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:8fae9ffa-1201-0324-5e57-f53dcbfc30c9
msgctxt "ha0cf6380g3020g40a5g8d39g90b88331f531"
msgid "What the hells happened back there?"
msgstr "아까는 대체 무슨 일이 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = 917b1e21-3763-7886-7d37-aff636c56bea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:917b1e21-3763-7886-7d37-aff636c56bea
msgctxt "h4de2fbf2g60ceg443ag92a0g34fdb9cb6344"
msgid "<i>Reach out to comfort her.</i>"
msgstr "<i>그녀에게 손을 뻗어 안심시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 95c4552e-15b0-c88f-25a7-4b7a739dac97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_PlayerAnnoyerLaezel = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:95c4552e-15b0-c88f-25a7-4b7a739dac97
msgctxt "he85aa25eg3d93g49f6g88d7g600db1d96975"
msgid "You want my respect? <i>Earn it.</i>"
msgstr "내가 널 존중하길 바라나? 그럼 너 자신을 <i>증명해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 9b325feb-740f-aaad-e340-75ec31711e0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Quest_GithLeave = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:9b325feb-740f-aaad-e340-75ec31711e0d
msgctxt "h46d4255fgc2d8g4cb0gb939gbda5124ac1b5"
msgid "He demanded our heads. <i>He'd deny us a cure.</i>"
msgstr "그가 우리의 머리를 요구했다. <i>그가 우리를 치유해 주는 것을 거부했어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = 9e0023d5-b7ad-4384-cf27-4db88c127c02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:9e0023d5-b7ad-4384-cf27-4db88c127c02
msgctxt "h08112135gba5fg4a83g9c16g66f52de1c13d"
msgid "<i>Shka'keth! </i>Keep your hands off me."
msgstr "<i>Shka'keth! </i>내게 손대지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = 9f4d7a27-73d5-885f-7ab7-0ce77215ddbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:9f4d7a27-73d5-885f-7ab7-0ce77215ddbd
msgctxt "h008a8b55gb98fg4fadg9be2g72c28919ee39"
msgid "Calm yourself - save your anger for our queen's enemies."
msgstr "진정해. 우리 여왕님의 적들을 위해 분노를 아껴둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = 9f4d7a27-73d5-885f-7ab7-0ce77215ddbd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:9f4d7a27-73d5-885f-7ab7-0ce77215ddbd
msgctxt "h070b86a9g8925g4e00gadc9gedce745b1bf0"
msgid "Calm yourself - save your anger for your queen's enemies."
msgstr "진정해, 분노는 네 여왕의 적들을 위해 남겨둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = a00026fe-48e6-6c41-3ccb-6bc43a85fd63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:a00026fe-48e6-6c41-3ccb-6bc43a85fd63
msgctxt "hf5ae7f86gbcdbg401cg86d3gbb22bcde5105"
msgid "Show me pity again, and I will present <i>your</i> corpse instead."
msgstr "내게 다시 동정을 보인다면, <i>너의</i> 시체를 대신 내어주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = b098ac79-42b5-0497-e93a-f5a8c3957300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:b098ac79-42b5-0497-e93a-f5a8c3957300
msgctxt "h8afba4d3g5a6bg47cag9e46gd8eb0c9115b6"
msgid "Do. Not. <i>Test </i>me."
msgstr "나를. <i>시험</i>. 하지. 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = b9ceff75-9820-110a-092c-a64c20ab77ca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:b9ceff75-9820-110a-092c-a64c20ab77ca
msgctxt "hb3fb5a64gf3b1g490fgb728g0a753730314c"
msgid ""
"How <i>dare</i> he speak our queen's name!  How <i>dare</i> he dishonour her "
"children!"
msgstr "<i>감히</i> 내 여왕님의 존함을 언급하다니!  <i>감히</i> 그분의 자식들의 명예를 더럽히다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = b9ceff75-9820-110a-092c-a64c20ab77ca
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:b9ceff75-9820-110a-092c-a64c20ab77ca
#, fuzzy
msgctxt "hd2523383g78b1g442cg8c82g9383b04fd8ee"
msgid ""
"How <i>dare</i> he speak my queen's name!  How <i>dare</i> he dishonour her "
"child!"
msgstr "<i>감히</i> 내 여왕님의 존함을 언급하다니!  <i>감히</i> 그녀의 자식의 명예를 더럽히다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = bcc89ea2-58fa-2b0f-840f-1c704611717b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:bcc89ea2-58fa-2b0f-840f-1c704611717b
msgctxt "ha5449abbg5d7bg4b30ga14fgacc9747e6212"
msgid ""
"Bah - this is a distraction. The <i>kith'rak</i> deserves the whole of my "
"scorn."
msgstr "흥, 거슬리는군. 그 <i>키스락</i>은 내 경멸을 한껏 받아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = bec83bf8-cb1d-13e3-7e77-6dc2bc304d12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:bec83bf8-cb1d-13e3-7e77-6dc2bc304d12
msgctxt "h4a92cb40g7a88g45fbg82b5ge23180deabfa"
msgid "<i>Tas'ki! </i>My rage is endless, I assure you."
msgstr "<i>Tas'ki! </i>내 분노는 끝이 없다, 그 점은 확실히 해 두지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = c2dfd532-745c-343b-ea3f-249244cf8737
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:c2dfd532-745c-343b-ea3f-249244cf8737
msgctxt "h829123d1gd5edg40d3g9ec9g8889caf76fca"
msgid "I required your silence, and you made me a mockery!"
msgstr "내가 너에게 조용히 하라고 했건만, 너는 나를 웃음거리로 만들었어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = cb7af051-1a04-c7c8-2971-5eebd22a9dec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:cb7af051-1a04-c7c8-2971-5eebd22a9dec
msgctxt "ha8ab0cbagbd8cg4fc3g83c9ga2f0e16bcc91"
msgid "Cool off and show me some respect or we're done here."
msgstr "진정하고 날 존중하는 태도를 보이지 않으면 우린 여기서 끝이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = ce145d75-9661-6239-d502-2f7d905664c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:ce145d75-9661-6239-d502-2f7d905664c2
msgctxt "h02944f08g5486g4db4ga3a1gcbb5299b528f"
msgid "You are right to be angry. The <i>kith'rak</i> is a danger."
msgstr "화나는 게 당연해. 그 <i>키스락</i>은 위협이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = de2b5d59-d6b9-86d0-5d39-2fc07d050034
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:de2b5d59-d6b9-86d0-5d39-2fc07d050034
#, fuzzy
msgctxt "h4319181ag7b6ag43a6g93b3gb98771b1ee3e"
msgid "Wasn't he acting on your queen's command?"
msgstr "네 여왕의 명령에 따라 행동하고 있었던 것 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = fc4aff18-d7b3-0d8d-88a7-211bfd47f26b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel:fc4aff18-d7b3-0d8d-88a7-211bfd47f26b
msgctxt "h51d3fa20g60f4g4e00gb8cfgbd088a9c1634"
msgid ""
"Do not be naive. I. Followed. <i>Protocol.</i> I've <i>earned</i> Vlaakith's "
"favour."
msgstr "순진한 소리 마라. <i>규약</i>에 충실한 자는 나다. 블라키스 님의 총애는 <i>내 것</i>이란 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/SFX_CAMP_Night3_CRD_Wyll
#. Speaker = Wyll
#. NodeID = e4ac8fe4-a5d8-376e-e0a3-e9fa3554d359
