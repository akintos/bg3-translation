msgctxt "hca175ce0g163eg4c23gaed7gb4851c848e6b"
msgid "<i>Zhak vo'n'ash duj</i>. There is only one way for you to prove it."
msgstr "<i>Zhak vo'n'ash duj</i>. 네가 이를 증명할 길은 하나뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
#. NodeID = 91539400-6403-c3c2-f401-edbb2c4256a0
#. HandlePath = TaggedText[0].TagText[0]
