msgctxt "ha0a31227g725cg46aag9d15gfe07e833b65a"
msgid "Now perhaps we might try a more - intimate style."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 17217812-83b4-6c09-1148-b58412cbee45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:17217812-83b4-6c09-1148-b58412cbee45
msgctxt "h5e7b4419gf682g4b2fg863ag643a0bf0f7a8"
msgid "I'm not interested, Wyll."
msgstr "관심 없어, 윌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 1b8da7cc-bdb5-0f2b-744d-896ce7eb7638
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:1b8da7cc-bdb5-0f2b-744d-896ce7eb7638
msgctxt "h53ff1391g5a22g4052gb53cg1965652dd9d5"
msgid "You don't have to be. Just follow my lead."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 1bc883d9-d3ed-b9c6-14fb-af5c83386b1a
