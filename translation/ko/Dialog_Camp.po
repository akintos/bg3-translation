#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub:be19eae7-5390-593b-6f7c-1b5a9a1faa45
msgctxt "hb23db1eeg286fg41fag99aagc57356a3d2a3"
msgid "Captors here. Why?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub
#. Speaker = Owlbear Cub
#. NodeID = d76d923e-e35c-3898-a432-c3368f9d4f56
