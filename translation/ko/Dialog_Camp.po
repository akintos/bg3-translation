msgctxt "h7dd1d06dg41cbg4451gbf76gfe8f6c633928"
msgid "<i>Attack him.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Player
#. NodeID = df641b09-1ebb-c228-1771-72cf5b982240
