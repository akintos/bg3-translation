msgctxt "hf6bea628gd425g4695gaf95g7556ec439ed5"
msgid "Wait, what do you need me to do?"
msgstr "잠깐, 내가 뭘 해야 하는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyMissionStatement_AvD
#. Speaker = Player
#. NodeID = 05be8018-3236-b0bc-a7bd-b23be1806ee9
#. HandlePath = TaggedText[0].TagText[0]
