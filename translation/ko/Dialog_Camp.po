#, fuzzy
msgctxt "h3dd12307ge8dfg488cg9f23gd090df92137d"
msgid "Well, it can be true, if only for tonight."
msgstr "글쎄, 오늘 밤에 한해서는 진실일지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight
#. Speaker = Astarion
#. NodeID = 13009f2d-e142-454c-b5ee-712237a7bf51
