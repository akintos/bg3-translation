msgctxt "h44f827bbg53b0g4b4ag88bfg12b3e5c5bc8e"
msgid "Mother? No! No hurt! Help!"
msgstr "엄마? 안 돼! 아픈 거 싫어! 도와줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
