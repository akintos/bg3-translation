msgctxt "h87402ad0g9ba7g40c4ga589g3084366e5363"
msgid "It was just the one. "
msgstr "딱 한 잔 마셔 본 거야. "

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
#. NodeID = fae7a80b-b77d-8a2e-08fa-c111cb958a6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:fae7a80b-b77d-8a2e-08fa-c111cb958a6c
msgctxt "haa6a35c9g23ccg465cgbb1fg7de89fe1a964"
msgid "Someone, wine! Quick!"
msgstr "누가 포도주 좀 줘! 빨리!"

