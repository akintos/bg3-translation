msgctxt "h90c5a698ge355g45eeg93ebg71877d888f9b"
msgid "<i>Do nothing.</i>"
msgstr "<i>아무것도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 6b6cf51d-b694-7b65-ce2c-f310df631c90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:6b6cf51d-b694-7b65-ce2c-f310df631c90
msgctxt "h762e1d89g1123g4c95gb4c3gc8d48d09bf09"
msgid "The blood is on my hands, in the end. No more."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = 76b38e23-2ba8-ad8a-76a3-e18133e3440a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:76b38e23-2ba8-ad8a-76a3-e18133e3440a
msgctxt "hf0c7b954g9362g49c9ga498g675dcbeceb0c"
msgid "How can you be sure? I feel no such corruption."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 776e2d2a-5b91-4185-2f5c-a526cbdc3354
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:776e2d2a-5b91-4185-2f5c-a526cbdc3354
msgctxt "h12189dd3ge729g4954g8948gff4cca89c67d"
msgid "I shall - trust me. But heed my words. This city is <i>doomed</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 83601507-0ba8-d8e1-9c98-4194d77f07e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:83601507-0ba8-d8e1-9c98-4194d77f07e6
msgctxt "ha89b931dge966g43cbga61cgad0c539840c9"
msgid "*ROAR.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 84fc969c-7207-0461-2637-d5aade75899f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:84fc969c-7207-0461-2637-d5aade75899f
msgctxt "h4a6c9fb5g8c70g48d3g8f1ag19255a562914"
msgid "Oak Father forgive me... I can explain, I swear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 8b1061c8-b0a4-3ece-907e-70b4b4b21283
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:8b1061c8-b0a4-3ece-907e-70b4b4b21283
msgctxt "h87934ea5gb677g4ac4gb43dg9d386d67276d"
msgid ""
"My body is trying to fight the corruption... but it's losing. And my mind "
"will succumb soon after."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = 9631d960-c2e8-20eb-251f-e9a501ac071c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:9631d960-c2e8-20eb-251f-e9a501ac071c
msgctxt "hadeca582g1b05g429bg8d6ag549d18e10ff6"
msgid "You're an archdruid. Whatever's affecting you, resist it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 98aad125-31c0-1c5f-276a-57725cb01f4f
#. HandlePath = TaggedText[0].TagText[0]
