#, fuzzy
msgctxt "h36e78db9g2347g4ae7g93b2g5b8d87486e62"
msgid ""
"<i>Hold Scratch's gaze and incline your head towards the cub - everything "
"all right?</i>"
msgstr "<i>스크래치의 시선을 잡아두고 새끼 아울베어에게 머리를 기울인다. 다 괜찮은 거지?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Scratch
#. NodeID = 8dae68a5-9cbf-b880-0b66-b0897ca97e26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:8dae68a5-9cbf-b880-0b66-b0897ca97e26
msgctxt "hdb24a57bg3507g4495gb8a3g6e5793831e5c"
msgid ""
"I... I suppose I did. You've been good to us - to both of us. Gomwick would "
"be happy I'm with you, I think."
msgstr "어... 그랬네. 넌 우리한테 잘 해줬어. 우리 둘 다한테. 내가 너랑 있어서 곰윅도 아마 기뻐할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Narrator
#. NodeID = 91cadf63-9d30-d015-6c54-787f1c133bbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:91cadf63-9d30-d015-6c54-787f1c133bbc
msgctxt "hf927c9a4g786cg44dcgb66cgd78dee4d0277"
msgid "*Nothing. Both animals look fine, watching you expectantly.*"
msgstr "*둘 모두 아무렇지 않게, 당신을 기대에 차 쳐다봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Owlbear Cub
#. NodeID = 9485aa1c-3a94-3bf9-4af5-26be53afc9b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:9485aa1c-3a94-3bf9-4af5-26be53afc9b5
msgctxt "h16213f01ged76g45b3gbeaagba6ce9858a09"
msgid "Used to. Mother ate him."
msgstr "있었어. 엄마가 먹었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 9862e9c7-e470-91b8-078b-f674c5fdee3e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
