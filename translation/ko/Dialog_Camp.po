#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:302ecdd3-1a4b-6371-09e3-c06c3d723158
msgctxt "hd07e9fb0g1313g44a1gb551gd7a50ab6f468"
msgid "Relax, this is just a bad dream."
msgstr "진정해. 단지 악몽일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 30b8730c-1b1b-4d7b-4bf4-e044829076d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
