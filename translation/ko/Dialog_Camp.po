#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:9bfc38b2-1b14-b5b1-52dc-dd916053f2bc
msgctxt "h58738386gb0d3g4b7agb2d4g61583e56c582"
msgid "It's just a test - I wasn't trying to kill you!"
msgstr "이건 일종의 시험이었어. 죽이려는 마음은 없었다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Astarion
#. NodeID = 9ca0a1c6-6476-9c7e-1bc6-6fa22f447319
