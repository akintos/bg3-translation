#.     - CAMP_Astarion_TheHungerA_Recognized(1) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:8f044eb0-5ef9-6c52-a944-13c2a541d54c
msgctxt "h2725d5e8g8684g49a2gbc5dgf3d4747db7cb"
msgid ""
"Fine. You sound sincere. But no more of this - next time it'll be a stake in "
"the heart. ."
msgstr "좋아. 진심인 것 같군. 하지만 다음은 없어. 또 그러면 심장에 말뚝을 박아 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 92999e41-08a0-e9ea-92bd-2b01a4ee0d10
