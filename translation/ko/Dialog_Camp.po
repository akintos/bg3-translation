#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:7f3dde1c-58cc-e99d-df2a-66533ed25c0a
msgctxt "hb3c7f6afged99g46cdg9cadgb42db2ef2e0c"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 7ff03d35-54e7-ce34-1556-2e689cde28f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:7ff03d35-54e7-ce34-1556-2e689cde28f0
msgctxt "ha8caebd9g979dg43d8g9667g51f50889854d"
msgid "My fellow travellers don't seem to like me enough..."
msgstr "내 친구들이 날 별로 좋아하지 않는 것 같군요…"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 80fe9c9b-1f4e-0bf9-544c-a10ae540ad15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_State_UsedWithersWardrobe = False
#.      - CAMP_Jergal_State_DismissedDeadAvatar = True
#.      - CAMP_Jergal_Knows_AskedAboutDismissedDeadAvatar = False
#. SetFlags:
#.   Global:
#.     - CAMP_Jergal_Knows_AskedAboutDismissedDeadAvatar = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:80fe9c9b-1f4e-0bf9-544c-a10ae540ad15
msgctxt "h6b4a0eefg07a3g428dg81bbgbdf59c512d2b"
msgid "I dismissed one of my adventuring companions - where are they?"
msgstr "제 동료중 한 명을 해고했습니다. 그 동료는 어디에 있나요? "

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 812f79d3-9db3-6ee2-939e-ce0e75821906
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_Event_ResurrectedSomeoneOnce = True
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
