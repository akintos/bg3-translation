#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 0257f860-e8ed-0656-611b-6e04a9a573b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:0257f860-e8ed-0656-611b-6e04a9a573b6
msgctxt "habb8ed38g102bg41c2ga9c4g56fa6f9a306f"
msgid "I'm not going to make you go away."
msgstr "널 쫓아내지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 049cdab4-afd1-4d2e-bb10-b5348e40b269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:049cdab4-afd1-4d2e-bb10-b5348e40b269
msgctxt "haabc6752ga3e6g42c8g903dg0c607aa7c047"
msgid "I am not a 'skellie'. Thou shalt call me Withers."
msgstr "난 '뼈다귀'가 아니다. 나를 위더스라 부르거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 08060670-34b1-768a-0ed8-11bd66a49227
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:08060670-34b1-768a-0ed8-11bd66a49227
msgctxt "hf8b16184g4ba0g41bcg8204g3f6c38c3496b"
msgid ""
"Arabella will depart, once thou dost leave these accursed lands. She will "
"find her way safely; thus it is fated."
msgstr "그대가 이 저주받은 대지를 떠날 때, 아라벨라도 떠나갈 걸세. 운명에 정해진 대로, 안전히 자신의 길을 찾아가겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 09c8ccf7-ec32-1407-fed5-dd463c0b950a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:09c8ccf7-ec32-1407-fed5-dd463c0b950a
msgctxt "hae7ec725gfd37g48cega658gc868523a81e4"
msgid ""
"But it is unbalanced. Her yoke is already heavy; if she walks thy path, it "
"will surely break."
msgstr "허나 그 힘은 매우 불균형하다네. 소녀의 짐은 이미 무거워. 자네의 길을 걷다가는, 필시 부서지고 말테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 0c34d224-7ac6-58ec-a5f6-52a463f6092a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:0c34d224-7ac6-58ec-a5f6-52a463f6092a
msgctxt "hb0f297f6g1977g473dg99d6gc6233af8b8b1"
msgid "Thy parents have left for the Fugue Plane. They are, in a word, dead."
msgstr "그대 부모는 배회 차원으로 떠났다네. 한마디로, 죽었다는 뜻이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 0d86619c-e26c-cf68-1077-17d50fc85366
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:0d86619c-e26c-cf68-1077-17d50fc85366
msgctxt "h30328292gaa8ag4ab5g974dg5cc985b05bf1"
msgid "THOU MUST."
msgstr "<b>쫓아내야만 하네.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 13cca824-db48-9263-7b03-1229203fdaf0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ArabellaPowers_State_JergalToldToLeave = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:13cca824-db48-9263-7b03-1229203fdaf0
msgctxt "h5def2f70g3735g4c24gb797g1a3d8f245b94"
msgid ""
"The girl must learn the ways of the arcane - but she shan't remain here."
msgstr "소녀는 비전의 길을 익혀야만 한다네. 허나 이곳에 머물러서는 안 되네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 199a25a5-4006-6665-a176-334fd210b4aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:199a25a5-4006-6665-a176-334fd210b4aa
msgctxt "h3d0872d0g727ag4e5fg85ccgc4c99403dafc"
msgid ""
"You can trust Withers. If he says you'll be safe, you should believe him."
msgstr "위더스는 믿어도 돼. 그가 안전하다고 했다면, 믿기만 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 1a3731f4-7671-4471-939e-0fa815576a46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:1a3731f4-7671-4471-939e-0fa815576a46
msgctxt "h81a78b34gb102g4680gb70bgc6655e8306e7"
msgid "Awh... boooring."
msgstr "에이... 시시해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 1e27f5f4-7c56-d455-2705-6890c62c9e88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:1e27f5f4-7c56-d455-2705-6890c62c9e88
msgctxt "hfac98114g0116g4a89g85beg2f12dd968c76"
msgid ""
"If there are people like you around, perhaps everything will be all right."
msgstr "아저씨 같은 사람들이 주변에 있으면, 어떻게든 될지도 모르겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 2255e708-7e85-483e-89a8-0f9df197e1ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:2255e708-7e85-483e-89a8-0f9df197e1ff
msgctxt "ha6745654g8003g4e45g974eg611d531123b6"
msgid "NO!"
msgstr "아니야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 289d0448-04ee-7a39-16b0-4d9f4beac5a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:289d0448-04ee-7a39-16b0-4d9f4beac5a8
msgctxt "h3a8abd6fg41e8g4099gb898ga8754ba0dc27"
msgid "Bone Man, you're making me leave?"
msgstr "뼈 아저씨, 절 쫓아내려는 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 36eec2d7-ff20-4ece-9e29-f1174f109e93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:36eec2d7-ff20-4ece-9e29-f1174f109e93
msgctxt "h677000f9g49a8g4b1cg9912gc236d4315215"
msgid "Thou shan't leave. The girl must know the truth."
msgstr "그대는 떠나지 말지어다. 소녀는 진실을 알아야만 한다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 3819ec1b-10ac-4f5a-a696-3a13a822760f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_ToldParentsDead = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:3819ec1b-10ac-4f5a-a696-3a13a822760f
msgctxt "h19aa52aag9fa7g43cdg8ce0gfe7ea78da620"
msgid "No..."
msgstr "아니야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 39bf69b9-a4ba-869c-2965-9f51c80c6c59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:39bf69b9-a4ba-869c-2965-9f51c80c6c59
msgctxt "h593a4281ge132g426dg9ddag499af9a21387"
msgid "It's wonderful..."
msgstr "환상적이네요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 3aa97c99-67bd-0b87-61e8-f52f99216e29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:3aa97c99-67bd-0b87-61e8-f52f99216e29
msgctxt "hc7e66008g7b02g41b1ga246g42242344be9b"
msgid ""
"Arabella holds a power beyond reckoning. That of the decaying forest, and "
"the seedling that bore it."
msgstr "아라벨라는 헤아릴 수도 없는 힘을 지녔네. 썩어가는 숲의 힘과, 바로 그 숲을 낳은 묘목의 힘 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 3aea9a6e-0efc-480d-9e05-362d736de522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:3aea9a6e-0efc-480d-9e05-362d736de522
msgctxt "h1b115c85gcb93g44dbg9371gca2269e6391d"
msgid "Thou mayest deny truth. I do not."
msgstr "그대는 진실을 부정할지라도, 난 아닐세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 3dd55efa-b1bf-4d75-8aee-41fe23a39da0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_CommentedOnPlay = False
#. SetFlags:
#.   Local:
#.     - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_CommentedOnPlay = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:3dd55efa-b1bf-4d75-8aee-41fe23a39da0
msgctxt "h5c613d4ag813eg4d28g8518gf77d644f2762"
msgid "I'm glad to see you're getting along."
msgstr "잘 지내는 것 같아 다행이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 40e7ab58-fb3c-120c-9c1e-4dc4e38cf8d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_WeavePurpose = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:40e7ab58-fb3c-120c-9c1e-4dc4e38cf8d7
msgctxt "h5b6dd752gafe6g450fg9664ge051d921a92a"
msgid "The Weave knows her purpose. It will guide her plainly, if she listens."
msgstr "위브가 그녀의 쓰임새를 안다네. 소녀가 귀만 기울인다면, 제대로 이끌어줄 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 43eed789-2c7d-1815-d16b-e6105dbdb7fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:43eed789-2c7d-1815-d16b-e6105dbdb7fd
msgctxt "hf47577c8g6219g4e6eg8565g6e6e54afe405"
msgid "<i>Balance.</i>"
msgstr "<i>균형이란다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 453aff0a-4660-4856-b9d9-400f38cd2e7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:453aff0a-4660-4856-b9d9-400f38cd2e7c
msgctxt "ha5e5e4abga577g43d0gb706gb15e43cbb11a"
msgid "The truth? Wait. What do you mean?"
msgstr "진실이라뇨? 저기요. 무슨 말이에요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 454c1ee0-6393-bf69-cf7a-1c1e6d7fd46f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:454c1ee0-6393-bf69-cf7a-1c1e6d7fd46f
msgctxt "h9a99cf85g301bg411ag8320g10061455687e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 487655d3-490a-7708-0cc8-b4b6b9e60c56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:487655d3-490a-7708-0cc8-b4b6b9e60c56
msgctxt "h56d5f3dfg7222g4cbeg8639g7e2b48cfe16d"
msgid ""
"She will tame it in time. The Weave would not see one like her abandoned."
msgstr "곧 있으면 길들일 수 있을 걸세. 위브는 그런 재능이 버려지는 걸 보고만 있지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 48c48162-d807-438b-bbbb-d1db209c9e56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:48c48162-d807-438b-bbbb-d1db209c9e56
msgctxt "hdd4c7a70gb6cfg46d1g9748gad56634c055d"
msgid "'Withers'? I'm not going to remember that! I'm calling you 'Bone Man'."
msgstr "'위더스'라구요? 그런 건 기억 못해요! 그냥 '뼈 아저씨'라고 부를게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 4f986a23-958f-f28d-463e-aafa0c3b8014
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:4f986a23-958f-f28d-463e-aafa0c3b8014
msgctxt "h217ac53dgedf3g4790ga4a5g3c1a3168d7fc"
msgid ""
"Listen. Dost thou not hear it? Where creation meets ruin, where morning "
"meets midnight - the root of all being."
msgstr "듣게나. 그대는 들리지 않는가? 창조가 파멸과 마주치는 곳, 아침과 자정이 어우러지는 곳, 모든 것의 근원이 되는 곳이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 510a5e05-edfc-9260-b792-78e7af83ff46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:510a5e05-edfc-9260-b792-78e7af83ff46
msgctxt "h216ad2cbg7d75g402agbe3ag63ba2527b8db"
msgid "Balance."
msgstr "균형이라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 5a3c173a-f930-4cfd-a075-059a7a1004a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:5a3c173a-f930-4cfd-a075-059a7a1004a4
msgctxt "hab04fcbegae52g4141gb303g65b1ca1fbe67"
msgid "She is ready. I have deemed it so."
msgstr "소녀는 준비되었다. 난 그렇게 확신하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 6175585b-40ff-81f4-acae-024f7f1bac02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:6175585b-40ff-81f4-acae-024f7f1bac02
msgctxt "hbb5f41a0g2c73g4229gb855gc08779f172b3"
msgid "Breathe, child. Resist not the winds of change. Let them carry thee."
msgstr "숨쉬거라, 아이야. 변화의 바람에 저항하지 말지어다. 흐르는대로 두어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 62ab273a-7ded-0273-ce06-b821ec8ef5c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:62ab273a-7ded-0273-ce06-b821ec8ef5c9
msgctxt "h84f3b4d0ge9dag487agbdbagde87e17a43e3"
msgid "I'd rather thou didst not."
msgstr "그대가 그리하지 않았으면 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 65f7b28c-9c38-4c07-56e1-139dbf3ada91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:65f7b28c-9c38-4c07-56e1-139dbf3ada91
msgctxt "h3dad68c1g0090g4debg8e57g3b55b569fd72"
msgid "I... *Sob.*"
msgstr "전... *훌쩍*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 68cf69e5-f18f-535c-0153-250baef06869
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:68cf69e5-f18f-535c-0153-250baef06869
msgctxt "h5da1468egb765g4179g91c7g49f33ccc74bf"
msgid "Hey Bone Man, can you make your teeth chatter?"
msgstr "뼈 아저씨, 이로 딸그락 소리 낼 수 있어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 6907bbb6-2919-4c77-abf9-56e3e5e1ece1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ToldParentsDead = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:6907bbb6-2919-4c77-abf9-56e3e5e1ece1
msgctxt "h954357b2g9503g49b9g9b7fgce004798c6fd"
msgid "Hey - you never said you were friends with a skellie!"
msgstr "우와, 뼈다귀랑 친구란 얘기는 못 들었는데요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 6d5a04f7-80d7-b52c-0af2-f03b18901011
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_WILDMAGIC(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:6d5a04f7-80d7-b52c-0af2-f03b18901011
msgctxt "h8078cbb6gcb9ag4971g88d3ga35d91ec7a0b"
msgid "Where will she go, then?"
msgstr "그럼 어디로 가야하나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 6fd5338a-02f4-9363-0e42-d678b93e49e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ToldParentsDead = True
#. SetFlags:
#.   Local:
#.     - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_StartedAngry = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:6fd5338a-02f4-9363-0e42-d678b93e49e3
msgctxt "h4d1e43a5g8a30g4c4cgbc68g541ad045b418"
msgid "I don't believe it. They can't be..."
msgstr "말도 안돼. 그럴리가 없어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 70bb8b89-597c-6db6-d817-2fa121b03bb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:70bb8b89-597c-6db6-d817-2fa121b03bb2
msgctxt "hca4eb2f3g034ag4187g81bbg6247c69cfb2f"
msgid "Speak, and let it be done."
msgstr "말하게, 마무리 짓게나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Narrator
#. NodeID = 7c41b218-9533-512b-0984-ab90bc5f9401
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:7c41b218-9533-512b-0984-ab90bc5f9401
msgctxt "ha6e8f492g74abg4064ga891g6055226af3b5"
msgid ""
"*A single image haunts your mind - a tiefling corpse, carelessly mauled in "
"the so-called House of Healing.*"
msgstr "*소위 치유의 집이란 곳에 놓여있던 무자비하게 찢긴 티플링 시체의 모습이 당신의 머릿속에서 떠나지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 7d3e6536-0859-4f93-9359-0027e1ba97f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:7d3e6536-0859-4f93-9359-0027e1ba97f0
msgctxt "h80fff27agaa7dg49a2g9a80g5ba9cc912755"
msgid "I can, but I will not."
msgstr "할 수 있으나, 하지 않을 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 7dfcb34c-32f7-4877-1d74-8d8512cd9d06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_WeavePurpose = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:7dfcb34c-32f7-4877-1d74-8d8512cd9d06
msgctxt "hd1e8750ag8d6ag46ddg80a4g434d5769e9bd"
msgid "Fear not, girl. Abandon not the Weave, and it shall not abandon thee."
msgstr "소녀여, 두려워 말게. 그대가 위브를 저버리지 않는 한, 위브도 그대를 저버리지 않는다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 85f9e1d3-4487-4fd0-c403-bf3228670f93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:85f9e1d3-4487-4fd0-c403-bf3228670f93
msgctxt "h171f3523g040eg4422g9866g6b7b5654320e"
msgid "Thank you, Bone Man. For being... nice."
msgstr "뼈 아저씨, 고마워요. 저한테... 잘해주셔서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Narrator
#. NodeID = 87b1da5a-6178-1409-4f16-8bcd4107abbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:87b1da5a-6178-1409-4f16-8bcd4107abbb
msgctxt "hf0f6f098g95ebg4d9cga01eg635171f9bcca"
msgid ""
"*You feel her grief fade as if it were your own - there is a lightness in "
"her now, veiling the power within, soothing it.*"
msgstr ""
"*그녀의 슬픔이 사라져 가는 것이, 마치 당신의 감정인 것처럼 느껴집니다. 이제 그녀 안의 홀가분함이 힘을 숨기고, 달래고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = 8b448349-cf9b-e3c7-404a-1ecb1c5c51c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:8b448349-cf9b-e3c7-404a-1ecb1c5c51c1
msgctxt "h008fdc3cgb02bg42beg8d98g83da74c0a7bd"
msgid "As I would expect."
msgstr "예상대로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 90f9e305-acdb-4340-b92f-62fb1952feac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_ToldParentsDead = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:90f9e305-acdb-4340-b92f-62fb1952feac
msgctxt "haf0e0e58g1402g4867ga5c7gd38969ab518c"
msgid "Your parents are dead, Arabella."
msgstr "너희 부모님은 돌아가셨어, 아라벨라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 96cc4dc0-8b96-b14f-614f-aab761d85aa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:96cc4dc0-8b96-b14f-614f-aab761d85aa8
msgctxt "h9c9bd2acgd4edg43dfg98d0g457451796987"
msgid "Fine with me. She's already outstayed her welcome."
msgstr "저야 좋죠. 슬슬 가줬으면 했거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = 991108ca-2059-765b-766c-469fe6364a47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:991108ca-2059-765b-766c-469fe6364a47
msgctxt "h5ac81bb0g78d2g480dga3d3g3aec7252ad93"
msgid "Why not? I'm not sending her out there alone."
msgstr "왜죠? 혼자 보낼 순 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = a7e44361-d45a-4b7d-aeb0-6487621baa73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_RefusedToTell = False
#. SetFlags:
#.   Local:
#.     - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_RefusedToTell = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:a7e44361-d45a-4b7d-aeb0-6487621baa73
msgctxt "h7e6a5649gb57cg4cacgb4ebg4e950029fed1"
msgid "No. It isn't the right time."
msgstr "아뇨. 적절한 때가 아닌 것 같습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = a8cc49cd-5a25-3048-25eb-b2de06d3c18a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_WeavePurpose = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:a8cc49cd-5a25-3048-25eb-b2de06d3c18a
msgctxt "hb6020e50g8368g4e68gae2fgf2bcd2e58fde"
msgid ""
"Fear not, girl. The Weave knows thy purpose. It will guide thee, if thou "
"dost listen."
msgstr "소녀여, 두려워 말게. 위브가 그대의 쓰임새를 아니, 귀만 기울이면 그대를 인도해 줄 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = b4b378db-4f3e-f085-c1c6-9473057f7b1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:b4b378db-4f3e-f085-c1c6-9473057f7b1b
msgctxt "h8877585dgf39cg4748g8f7dgcbc1a1661269"
msgid "You will not. You cannot."
msgstr "그러지 않을 걸세. 그리 하지도 못하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = b64d71d8-9212-4a5f-8599-55edc2f69f10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:b64d71d8-9212-4a5f-8599-55edc2f69f10
msgctxt "h7966800agda6fg449eg88d5g4b470437f53b"
msgid "He's funny - like my grandpa when he didn't get his nap."
msgstr "엄청 웃겨요. 낮잠 못 잔 우리 할아버지 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = b6a634c0-af59-7099-db38-7085cc6bea41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:b6a634c0-af59-7099-db38-7085cc6bea41
msgctxt "h45286f76g2c21g4ed7g9153gb3d90f110f95"
msgid "Very well."
msgstr "좋네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Narrator
#. NodeID = b979af17-0a04-5c3c-bde3-f766771eb7b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_TaughtSpell = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:b979af17-0a04-5c3c-bde3-f766771eb7b3
msgctxt "hf155fbd3g2d8bg45aeg9619g9428923253b1"
msgid ""
"*Your very soul is tangled in shadow. Arabella's magic, wild as cursed "
"briar. Her talent is now yours, too.*"
msgstr ""
"*당신의 영혼 그 자체가 그림자와 뒤얽혔습니다. 저주받은 찔레나무와 같이 거친 아라벨라의 마법 때문입니다. 그리고 이제 그 마법의 힘도 "
"당신의 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = be2d525a-940e-7be0-34d5-ece4f429bfee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:be2d525a-940e-7be0-34d5-ece4f429bfee
msgctxt "ha38dc24cg3ce5g4162g8da2g3a25486ae5ef"
msgid "Tell her yourself, if it means that much."
msgstr "그렇게 중요한 거라면, 직접 말씀하시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = be569fab-f979-f500-65ab-503f56dbfbd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:be569fab-f979-f500-65ab-503f56dbfbd4
msgctxt "h0cdb62fdgd428g4734ga7deg826ed915cba0"
msgid "Is that my future? Is that why they died?"
msgstr "이게 저의 미래인가요? 이것 때문에 부모님이 돌아가신 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = c298bca1-7e97-b560-8929-eb983784d3f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_WILDMAGIC(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:c298bca1-7e97-b560-8929-eb983784d3f2
msgctxt "hf8cadc54g59cfg407dgaacegf8ae1c46cf8b"
msgid "Who could teach the girl? Her magic is even wilder than mine."
msgstr "누가 가르칠 수 있겠어요? 제 마법보다도 거친 걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = c4c963fd-549f-e541-a154-859cbb70309a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:c4c963fd-549f-e541-a154-859cbb70309a
msgctxt "h1a75f9f3g84deg4e5fgb2b8gb6883d05de33"
msgid "I will teach her. I will help her channel the Weave."
msgstr "제가 가르칠게요. 위브와 소통하도록 돕겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = ca6845ff-dc81-42d1-87d0-5a77ee1b1234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:ca6845ff-dc81-42d1-87d0-5a77ee1b1234
msgctxt "hcae3c878g1172g482ag8a2fg7e01b9223a36"
msgid "I need Withers' services."
msgstr "위더스 님의 도움을 받고자합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = d1744c84-d8e5-4f4d-82bc-6774d4ceff94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:d1744c84-d8e5-4f4d-82bc-6774d4ceff94
msgctxt "h7185c180g2774g4911gadf0g1f82f65b926c"
msgid ""
"Soon enough. But first, thou must tend to the girl. It is time she learns "
"the truth."
msgstr "그리 될 거다. 허나, 아이 일이 먼저네. 진실을 알려줄 시간일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = d1850a0d-c434-4dc9-a108-9eb55dbcbeec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_CommentedOnPlay = False
#. SetFlags:
#.   Local:
#.     - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_CommentedOnPlay = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:d1850a0d-c434-4dc9-a108-9eb55dbcbeec
msgctxt "hc92e4faegeb36g4093g9516g8167b420d294"
msgid "'Bone Man', huh? I like it."
msgstr "'뼈 아저씨'? 괜찮은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = d2496bac-77e0-de0e-0f4e-42ebdc2c50b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:d2496bac-77e0-de0e-0f4e-42ebdc2c50b3
msgctxt "h2213d9ceg93e1g4ba6g9d60g7a2e10083f87"
msgid "I'm sorry. I wish it could be different."
msgstr "유감이야. 다른 방법이 있었으면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = d4d12e39-e4e4-b91a-5e3d-aece254da84b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:d4d12e39-e4e4-b91a-5e3d-aece254da84b
msgctxt "h4d92d729g7b45g4a91g9359gca95a68edca7"
msgid "It is."
msgstr "그렇다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = d6637bdd-e819-4f53-89cc-c572d7644126
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:d6637bdd-e819-4f53-89cc-c572d7644126
msgctxt "haa391d65gba4eg4344gb4bdg7ddc28e1f433"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = e94adebf-79e8-4946-8ce4-02d2cd240878
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:e94adebf-79e8-4946-8ce4-02d2cd240878
msgctxt "h785262acgccebg416aga7d2g010ec20ed971"
msgid "Bad news, Arabella. Your parents are dead."
msgstr "안 좋은 소식이야, 아라벨라. 너희 부모님이 돌아가셨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Player
#. NodeID = ee33dde5-cae1-4b60-9ef2-f034da9d6878
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ff072896-19e8-d622-eeb2-d10eb3ccb5d4_RefusedToTell = True
#. SetFlags:
#.   Global:
#.     - TWN_ArabellaPowers_State_HandledNews_Jergal = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:ee33dde5-cae1-4b60-9ef2-f034da9d6878
msgctxt "h53ffe90cg9d02g4620gae5egbe45e29ffb02"
msgid "What about 'no' don't you understand?"
msgstr "'싫다'는 말을 이해하지 못하나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Withers
#. NodeID = f66b3b07-c10d-abd5-6fba-cc42c673f348
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:f66b3b07-c10d-abd5-6fba-cc42c673f348
msgctxt "had0f150dg40b0g4a9dgba9fg756d5ce78708"
msgid "I speak not with malice, but with prudence."
msgstr "난 악의 없이 신중을 기하여 말하는 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal
#. Speaker = Arabella
#. NodeID = f8329f1e-db70-0de1-7c45-3246a0c10bdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_ThreeWay_ArabellaJergal:f8329f1e-db70-0de1-7c45-3246a0c10bdc
msgctxt "h792622e4g8ab8g45edg94cdg4a8c5caa0f09"
msgid "They're dead... I can't..."
msgstr "그치만... 모두 돌아가신걸요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Astarion
#. NodeID = 092c0a79-f51a-4ae1-b4db-92cff140d7d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0b99aea0-f5d5-b00d-614a-76c06f4a72ff_A = False
#. SetFlags:
#.   Local:
#.     - 0b99aea0-f5d5-b00d-614a-76c06f4a72ff_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:092c0a79-f51a-4ae1-b4db-92cff140d7d7
msgctxt "h208e5bcfg52ccg4a46g9df0gfc473975093f"
msgid "I do hope you'll be comfortable in our little camp."
msgstr "네가 우리 작은 야영지에서 편히 쉬었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = 0554b5e6-49e8-1378-2987-6cd35993aa79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = False
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = False
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:0554b5e6-49e8-1378-2987-6cd35993aa79
msgctxt "h53c20477ga304g49edg8629g071ebf1296b8"
msgid "Of all the people I could run into."
msgstr "하필이면 이 사람이랑."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Astarion
#. NodeID = f054e41e-ecfe-4375-b69a-77f23ad988c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0b99aea0-f5d5-b00d-614a-76c06f4a72ff_A = True
#. SetFlags:
#.   Local:
#.     - 0b99aea0-f5d5-b00d-614a-76c06f4a72ff_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:f054e41e-ecfe-4375-b69a-77f23ad988c4
msgctxt "ha37d7171gf6aeg46dbg9807g71cd99ddc1c1"
msgid "I feel safer already, having a bard around the camp."
msgstr "야영지에 바드가 있으니, 벌써 더 안전한 느낌인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = 096f459a-fb56-cea3-7606-f4c6d501a035
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DarkUrge_Event_RecruitAlfira = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = True
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = False
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:096f459a-fb56-cea3-7606-f4c6d501a035
msgctxt "hd08860f4g5095g4e51g8915gf36ae73be676"
msgid "I hope I do a good job."
msgstr "내가 잘할 수 있으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = 23f6d3c7-a0d0-4f2b-910a-88284fc6fb1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DarkUrge_Event_RecruitAlfira = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = False
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = False
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:23f6d3c7-a0d0-4f2b-910a-88284fc6fb1e
msgctxt "haa70d8f1gae64g4199g9eaag6e37ae8efb72"
msgid "This is so exciting."
msgstr "이거 진짜 신나는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = 2c36cce3-7f5e-a8c2-4822-c7557b1e2810
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = True
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = False
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:2c36cce3-7f5e-a8c2-4822-c7557b1e2810
msgctxt "h58f020c0gff07g4ef9g85d6g998a5288b4ac"
msgid "Gods, I'm exhausted."
msgstr "피곤해 죽겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = 3ff1abea-2007-6425-db23-03c53512f126
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = True
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = True
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:3ff1abea-2007-6425-db23-03c53512f126
msgctxt "hbc7af53fg3069g48f0g9628g3b6486a111b9"
msgid "The sooner I get out of here, the better."
msgstr "최대한 빨리 여길 벗어나는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = a9662c85-9328-00c1-da2a-9682add2b8ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = False
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = True
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:a9662c85-9328-00c1-da2a-9682add2b8ed
msgctxt "h488d4304g3088g4e90g87b6g9bcccb0058e8"
msgid "It's just one night."
msgstr "딱 하룻밤만이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = c1899109-70a7-87fe-6a7c-d0b94b046057
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DarkUrge_Event_RecruitAlfira = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = True
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = True
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:c1899109-70a7-87fe-6a7c-d0b94b046057
msgctxt "h8d015372g3ba3g4a90g89e1g8e26d49afd9b"
msgid "I wonder where we'll go first? Waterdeep? Neverwinter?"
msgstr "우리 어디부터 갈까요? 워터딥? 네버윈터?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD
#. Speaker = Alfira
#. NodeID = d50ac458-2092-4e6a-a570-f7eeb487af75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DarkUrge_Event_RecruitAlfira = True
#.   Local:
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = False
#.      - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_A = True
#. SetFlags:
#.   Local:
#.     - 919b4b3b-d631-7ee0-3107-cf4f60b60c21_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD:d50ac458-2092-4e6a-a570-f7eeb487af75
msgctxt "he8c95031g4a4ag4d7dg9fbbg67cd2dcc462c"
msgid "Should I write a song? No, they'd probably find it annoying."
msgstr "노래를 써야 하나? 아냐. 아마 거슬려 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Alfira
#. NodeID = 0fc5e99f-b8f5-b42f-94c5-7ce279700c5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:0fc5e99f-b8f5-b42f-94c5-7ce279700c5a
msgctxt "hf63aeb72gdecfg4325gb945g51112ce831c0"
msgid ""
"Your tent? Oh - OH. I, ah, I'm quite all right, but thanks ever so much."
msgstr "당신 텐트에요? 음 - 어, 저, 저는 괜찮아요. 하지만 정말 고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Astarion
#. NodeID = 2c694c70-f547-acf5-cf9b-754a0f74c5b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:2c694c70-f547-acf5-cf9b-754a0f74c5b6
msgctxt "h8addf835g6782g4688g985eg6384aaec2e09"
msgid "Your expertise is noted."
msgstr "네 전문성에 주목해야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Astarion
#. NodeID = 3b9f8c06-2003-44a6-a336-fbfcba136a22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:3b9f8c06-2003-44a6-a336-fbfcba136a22
msgctxt "hcc8bd6ddg4a9dg4829ga901g5baa6579e5e5"
msgid "Would you like a tour? We can start with my tent, if you like."
msgstr "한번 둘러보고 싶어? 원한다면 내 텐트부터 시작하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Alfira
#. NodeID = 4f61d522-3315-1416-93d7-edbfda59babc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:4f61d522-3315-1416-93d7-edbfda59babc
msgctxt "h1c26c619g1a22g4912g9947gdefc0273b375"
msgid ""
"I'm not sure, but a lute to the skull would fell a mouthy elf pretty easily."
msgstr "잘 모르겠어요. 하지만 말 많은 엘프는 머리통에 류트 한 방 갈기는 걸로 간단히 쓰러질걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Astarion
#. NodeID = 59cba38e-08ce-814c-9557-c7cfab556545
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:59cba38e-08ce-814c-9557-c7cfab556545
msgctxt "hcbb75e8bg3907g4e87g8da9g6df275a35925"
msgid ""
"Not at all! I just wonder, which is better at felling a goblin - a ballad or "
"a jig?"
msgstr "전혀! 그냥 궁금해서 그러는데, 고블린을 쓰러뜨리는 데 어느 게 더 나을까? 발라드? 아님 지그?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Alfira
#. NodeID = 66bd932b-89e0-462b-9f93-8a45cfa8a4e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:66bd932b-89e0-462b-9f93-8a45cfa8a4e6
msgctxt "h2448cdc4gc523g427dgb1bfg1b7aa677a6ee"
msgid "Thank you, it's just a relief to be somewhere safe."
msgstr "고마워요. 안전한 곳에 있으니 안심이 되네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Alfira
#. NodeID = 7cfa4c57-0519-4c90-8a85-ca9c38569512
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:7cfa4c57-0519-4c90-8a85-ca9c38569512
msgctxt "hd630fd4dgdd00g456dg9900gf3c2d0571a2b"
msgid "Are you making fun of me?"
msgstr "지금 저 놀리는 거예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion
#. Speaker = Astarion
#. NodeID = 99192414-b01b-a5cd-b583-fba0786e4a33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Astarion:99192414-b01b-a5cd-b583-fba0786e4a33
msgctxt "h1e24fcf2g4dc9g4422g9009gaee134b66401"
msgid "Very well. There's no accounting for taste."
msgstr "좋아. 사람마다 취향은 다를 수 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Alfira
#. NodeID = 17101c01-ecb8-4317-9627-6a39e9598e14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 538f7741-b423-9658-0c3e-1fc9ceb58c05_A = False
#. SetFlags:
#.   Local:
#.     - 538f7741-b423-9658-0c3e-1fc9ceb58c05_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:17101c01-ecb8-4317-9627-6a39e9598e14
msgctxt "hf59cb4b8g757bg4e68gb5c8g097189bb92b3"
msgid ""
"I don't mean this in a bad way but - are you the <i>real</i> 'Blade of "
"Frontiers'?"
msgstr "나쁜 뜻은 없는데 - 당신이 <i>진짜</i> '변경의 칼날' 이에요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym
#. Speaker = Alfira
#. NodeID = 05da712a-1f4a-4a71-982d-0e0ec555c08b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 612a9ca9-148f-fba3-7083-66e367fa39ba_A = False
#. SetFlags:
#.   Local:
#.     - 612a9ca9-148f-fba3-7083-66e367fa39ba_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym:05da712a-1f4a-4a71-982d-0e0ec555c08b
msgctxt "h7386dd31gb9d3g4b80gad50gbea879755f47"
msgid "Aren't you the most beautiful kitty ever?"
msgstr "세상에서 가장 아름다운 야옹이 아니야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Alfira
#. NodeID = 337cf416-ce21-4765-82cf-06a7432fcfd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:337cf416-ce21-4765-82cf-06a7432fcfd6
msgctxt "h189f5a7fg3f54g4ac7g88b2gc7361ee677e6"
msgid ""
"I've heard so many songs about you. 'Endless Blade' might be my favourite."
msgstr "당신에 대한 노래를 많이 들었어요. 그 중 '끝없는 칼날'이 제일 좋더라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym
#. Speaker = Alfira
#. NodeID = 3f0451a8-368f-45a3-a662-a2af32ef4a4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym:3f0451a8-368f-45a3-a662-a2af32ef4a4d
msgctxt "h6dc8ce15g3f43g4239g8c30g3bc168e4b1df"
msgid "Oh, uh - good kitty?"
msgstr "오, 앗. 착하지 야옹아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym
#. Speaker = Alfira
#. NodeID = 58de7e00-7181-f592-4ca5-d83b2e27c71b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym:58de7e00-7181-f592-4ca5-d83b2e27c71b
msgctxt "h403c0e55gefc9g4eaega5bbgad9f39c1a7ab"
msgid "Lucky Gale."
msgstr "부러워 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Wyll
#. NodeID = 4b78ff15-9632-415a-aef8-5bd7dcf0d102
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:4b78ff15-9632-415a-aef8-5bd7dcf0d102
msgctxt "hf1c5a89ag1b4cg45d6gbd6ag53f95d4c5a99"
msgid "That's what they call me."
msgstr "많이 듣는 소리지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = 7b2fa583-964a-4e9c-91f9-4dbd792d6520
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym:7b2fa583-964a-4e9c-91f9-4dbd792d6520
msgctxt "hbba2062egcfb6g405egb0bbgf653533c7a8c"
msgid "*Hiss.*"
msgstr "*하악.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Alfira
#. NodeID = 66499e14-6ba4-4ae0-8bfc-b4d074f85bc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:66499e14-6ba4-4ae0-8bfc-b4d074f85bc3
msgctxt "h76528478g9be0g4b5fg82e4g45f66c88dbd8"
msgid "I don't think so? But I suppose I'll know better once we hit the road."
msgstr "아니, 없는 것 같아요. 본격적으로 길을 떠나게 되면 또 모르겠지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = 7e4ae581-73a5-43cf-b484-717d46c4b550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym:7e4ae581-73a5-43cf-b484-717d46c4b550
msgctxt "hea33dc90g7388g4b65g976bg9bfe75065840"
msgid "Mrawr."
msgstr "야옹."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = e54185c2-6546-4dcb-a402-792142ce7da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym:e54185c2-6546-4dcb-a402-792142ce7da0
msgctxt "h4faec78bg04a2g41d8g8704ga15c2a8622da"
msgid "*HISS.*"
msgstr "*<b>하악</b>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Wyll
#. NodeID = f30a5353-e13e-4991-a437-a263a752ba73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 538f7741-b423-9658-0c3e-1fc9ceb58c05_A = True
#. SetFlags:
#.   Local:
#.     - 538f7741-b423-9658-0c3e-1fc9ceb58c05_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:f30a5353-e13e-4991-a437-a263a752ba73
msgctxt "ha3a74629g8446g4be4g9d57g6718603d6fcc"
msgid "Just checking in - is there anything you need?"
msgstr "혹시나 해서, 뭐 필요한 거 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym
#. Speaker = Alfira
#. NodeID = e7374f22-a58b-4b8c-8060-bbbb03f9cbcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 612a9ca9-148f-fba3-7083-66e367fa39ba_A = True
#. SetFlags:
#.   Local:
#.     - 612a9ca9-148f-fba3-7083-66e367fa39ba_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_GaleTressym:e7374f22-a58b-4b8c-8060-bbbb03f9cbcb
msgctxt "h6cc391d1g26b1g4a6bga35cg3960f69f40f6"
msgid ""
"I'm not going to pet you, Tara - don't worry. Though I really, really want "
"to..."
msgstr "쓰다듬지 않을 테니까 걱정하지 마, 타라. 진짜로, 진짜로 쓰다듬고 싶긴 한데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Alfira
#. NodeID = 7135a6e3-bd11-41fd-411d-4b48e8ab3d2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:7135a6e3-bd11-41fd-411d-4b48e8ab3d2e
msgctxt "hdbc657b9g93a1g47cegb748g60902698926d"
msgid "Sorry. I didn't mean to snap."
msgstr "죄송해요. 화내지 않으려고 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Volo
#. NodeID = b2417fa7-0df6-ece5-03ec-2c9f850717f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:b2417fa7-0df6-ece5-03ec-2c9f850717f5
msgctxt "hc68f3c79g0691g4d6dgb8dfgffb2c5c27418"
msgid "Are you quite sure?"
msgstr "확실한가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Volo
#. NodeID = c89f0dda-f480-4225-a230-2700d0b095f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:c89f0dda-f480-4225-a230-2700d0b095f1
msgctxt "h0488c4acg05adg4180ga57egaf7a9141b770"
msgid ""
"Come now, its spotted hat is most distinctive. And the flames of Avernus - "
"would you describe them as <i>execrable?</i>"
msgstr ""
"그러지 말고, 그 뾰족한 모자를 보면 기억 못하기가 힘들다니까. 그리고 그 아베르누스의 불길하며! <i>지독하다</i> 정도로 표현하면 "
"되겠나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Volo
#. NodeID = dd877ee9-25b0-b059-df2b-001532d2958b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:dd877ee9-25b0-b059-df2b-001532d2958b
msgctxt "h18964b10g7a14g4e2eg8c1fgad57cfbc15c1"
msgid ""
"No, no. The fault is mine. I chased the story at the cost of its "
"protagonist. Forgive me."
msgstr "아니, 아니. 내 잘못일세. 주인공 없는 이야기가 무슨 소용인가. 용서해 주시게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Alfira
#. NodeID = e1d17c0b-0373-145a-ceea-e082a5408ced
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:e1d17c0b-0373-145a-ceea-e082a5408ced
msgctxt "h399f33fcg3e6eg4e3bg9ebbgfc1ed10a5762"
msgid "They were hot enough to burn my mother alive. Does that help?"
msgstr "어머니를 산 채로 불태운 놈들이에요. 이제 알겠어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Alfira
#. NodeID = 3283e491-b43b-4062-92f5-044c3caf87ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 823ab5b4-ea29-e775-dc78-d0490e517d4d_A = False
#. SetFlags:
#.   Local:
#.     - 823ab5b4-ea29-e775-dc78-d0490e517d4d_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:3283e491-b43b-4062-92f5-044c3caf87ed
msgctxt "h737401e6gb563g47eagae3bg92f107a65681"
msgid "You're here to chronicle our adventures, is it?"
msgstr "그러니까 우리 모험을 기록하러 왔다, 그거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Alfira
#. NodeID = 6d786d75-cb72-42bb-8b93-87ae25d7b35f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:6d786d75-cb72-42bb-8b93-87ae25d7b35f
msgctxt "hb9fbf16fge769g4af6ga698g7dcb6e4a660c"
msgid "It's Alfira."
msgstr "전 '알피라'예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Wyll
#. NodeID = 3f8f758f-6c04-f70c-46a6-587c5eb721de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:3f8f758f-6c04-f70c-46a6-587c5eb721de
msgctxt "hd79a18c1g59b3g4e9bg9c9ag09e9ef4cc67a"
msgid "There is. Though I'm not about to sing it for you."
msgstr "있지. 그렇다고 여기서 불러주겠다는 건 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Volo
#. NodeID = 72e98fa4-eea2-42ee-876d-f2f17f5af4af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:72e98fa4-eea2-42ee-876d-f2f17f5af4af
msgctxt "hf8d2787eg7669g4403gaba2g128d3df947bb"
msgid ""
"Indeed! I have travelled the Realms seeking daring and danger. Stick with "
"me, Amira, and you shall be safe as a vault."
msgstr "물론! 여러 렐름을 여행하며 산전수전 다 겪어봤다네. 나와 붙어다니면 안심해도 될 걸세, 아미라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Wyll
#. NodeID = 6488d9b6-60c6-adbb-3003-6e06c6832209
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:6488d9b6-60c6-adbb-3003-6e06c6832209
msgctxt "h2fa7ddb3gd31ag4331g9bd5geb5e7cd6d978"
msgid "That's what they called me - at least, 'til I grew these pesky horns."
msgstr "그렇게 불리곤 했지. 적어도, 이 망할 뿔들이 자라나기 전까지 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Alfira
#. NodeID = 7ed10f5b-f2a9-4789-8e69-18ebb0040449
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo:7ed10f5b-f2a9-4789-8e69-18ebb0040449
msgctxt "h484c3007g0b24g4448gb404gccd145987a8a"
msgid "I don't know anything about such a creature, I'm afraid."
msgstr "그런 생물은 몰라요, 죄송해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Wyll
#. NodeID = 869b802f-d8b2-e078-6da1-f31f9fd241dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:869b802f-d8b2-e078-6da1-f31f9fd241dd
msgctxt "h6f587b01g6ed1g4436gb0c9g3b6d17384da1"
msgid "Ah - is that the one with the, er, bawdy lyrics?"
msgstr "아, 음... 그 외설적인 가사가 있는 노래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Alfira
#. NodeID = bb9ed7f9-f1ef-0824-ec0f-1aa3d624c94a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:bb9ed7f9-f1ef-0824-ec0f-1aa3d624c94a
msgctxt "h5c9f931dg50dbg4d68g8c9dg2c4dd1c27a95"
msgid "There's a <i>bawdy</i> one?"
msgstr "<i>외설적인</i> 가사도 있어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Alfira
#. NodeID = d5301541-bd59-2c9b-058e-0e2c09aa84c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:d5301541-bd59-2c9b-058e-0e2c09aa84c3
msgctxt "h637f06a5ga317g42begbf26g109ec073b83b"
msgid "Thanks so much - everyone's been so lovely."
msgstr "정말 고마워요. 다들 아주 멋지시네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll
#. Speaker = Wyll
#. NodeID = e87f6557-3579-1861-9ecd-c7876b6c5015
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Wyll:e87f6557-3579-1861-9ecd-c7876b6c5015
msgctxt "h01abe685g82b8g4294g834egc039fa40963b"
msgid "If that changes, don't be afraid to pipe up. I'll get you sorted."
msgstr "만약 생기면, 주저하지 말고 알려줘. 내가 해결해 줄 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Bard_AD_Volo
#. Speaker = Volo
#. NodeID = e0da1b0c-e6cb-410e-8ad1-03a0a81d05dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
