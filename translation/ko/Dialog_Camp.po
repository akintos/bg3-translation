msgctxt "h27a71b9ag60dcg4c6egaeddg0257827142d6"
msgid ""
"<i>I've killed in her name before. Why now? Why isn't the wine helping?</i>"
msgstr "<i>그분의 이름으로 전에도 살인을 해본 적 있어. 그런데 왜? 왜 포도주를 마셔도 기분이 나아지지 않는 거지?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
#. NodeID = a50a2a15-828f-91df-9915-2162c6fec8ac
#. HandlePath = TaggedText[0].TagText[0]
