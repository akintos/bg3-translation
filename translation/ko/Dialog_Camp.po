msgctxt "h757f87eeg3721g4e29g8dfcgd517f8efcae9"
msgid ""
"I replaced a cousin's sword with a toy blade. A beholder devoured her - "
"pretty funny, all in all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
