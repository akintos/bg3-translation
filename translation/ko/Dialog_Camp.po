msgctxt "h0cd196c9g485eg4697gb43fga8f960e299c1"
msgid "True Soul, ma'am. A present, straight from the battlefield."
msgstr "참된 영혼 마님. 전장에서 바로 가져온 선물입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Goblin Brawler
#. NodeID = 5a956df8-baa4-68c0-06dd-ed7fcf3b944b
