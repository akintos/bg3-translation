#. NodeID = 33ff0d7a-4954-4d8d-a814-89f3a6c5fb6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:33ff0d7a-4954-4d8d-a814-89f3a6c5fb6e
msgctxt "h58cd3222g8b4bg421eg98b2ge0681a49ab80"
msgid ""
"Still though - not everyone wishes for a dead bird or mouse to be laid on "
"their bedroll as a gift."
msgstr "그렇긴 하지만, 잠에서 깨어 보니 침낭 곁에 죽은 새나 쥐가 선물로 놓여 있는 걸 달가워하지 않는 사람도 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Gale
#. NodeID = 3aa77025-f40d-455e-86ea-43fbd24638f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:3aa77025-f40d-455e-86ea-43fbd24638f0
#, fuzzy
msgctxt "h273c184eg2b61g4112g87eag36dc50125c12"
msgid "The vittles are... adequate."
msgstr "식료품은… 충분하기는 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 49eef693-0f77-4639-8528-300bc2fb9b93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:49eef693-0f77-4639-8528-300bc2fb9b93
#, fuzzy
msgctxt "hb4be8fe2g0cf5g4dbdg9ddbg162880459184"
msgid "My nature is what it is."
msgstr "제 본능은 어쩔 수가 없답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7116c7c2-49ac-74cb-726e-52b8e6747532
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - OWLBEARCUB = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:7116c7c2-49ac-74cb-726e-52b8e6747532
msgctxt "hc1f5e2f1g4ac7g4859gb24dge9bdede11094"
msgid ""
"I have done nothing wrong. Besides, surely the young owlbear would be as "
"likely a culprit as any."
msgstr "전 아무것도 잘못한 게 없어요. 게다가 그 아울베어 꼬마 녀석이 범인일 수도 있잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7f62f538-6955-7020-1dea-f0755cf90925
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - OWLBEARCUB = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:7f62f538-6955-7020-1dea-f0755cf90925
#, fuzzy
msgctxt "h24044495ge36eg4a36ga990g4e79a16ed6ef"
msgid "You condemn me though I did nothing. I could not find any such prize."
msgstr "제가 하지도 않은 일로 절 비난하시다니. 그리고 그렇게 귀한 것들은 찾지도 못했다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Gale
#. NodeID = acee86c1-0817-f30a-41f3-332960315ae6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:acee86c1-0817-f30a-41f3-332960315ae6
#, fuzzy
msgctxt "h3bf08f8egcb35g47ffg9488g122979e8ab43"
msgid ""
"I have not failed to notice. I truly do not deserve such loyal companionship."
msgstr "내가 알아차리질 못했네. 난 이렇게 충실한 우정을 가질 자격이 없는 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Gale
#. NodeID = c80cc4ae-128e-47b2-a3fa-e337a5efe352
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 40a86032-d46c-b71a-9776-ee58e3730541_B = False
#.     - 40a86032-d46c-b71a-9776-ee58e3730541_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:c80cc4ae-128e-47b2-a3fa-e337a5efe352
msgctxt "h8a05eb2fg3bddg42bdg87d9gedb04218f83a"
msgid ""
"Now I trust you won't give in to your more predatory instincts while you're "
"here, shall you?"
msgstr "네가 여기 머무르는 동안에는, 포식 동물로서의 본능을 억누를 거라 믿어도 되겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c9dafe59-cb19-40a0-a23d-2030cd44b40c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:c9dafe59-cb19-40a0-a23d-2030cd44b40c
msgctxt "h93c55d9bgd60bg40d4gbcfcg6316d71cd979"
msgid "Ah, adequate. My mouth waters."
msgstr "아, 충분하다고요. 입에 침이 고이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Gale
#. NodeID = d5122f84-5e43-e003-8e94-a3effbb5f010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:d5122f84-5e43-e003-8e94-a3effbb5f010
#, fuzzy
msgctxt "h6d4431f3g9e89g4b95g8c10ge16888f518f0"
msgid ""
"No harm - unpretentious grub for intrepid adventurers. After all, you never "
"read what heroes of yore had for their supper, do you?"
msgstr "나쁘진 않아. 용감한 모험가들의 소박한 식사랄까. 옛 영웅들이 어떤 식사를 했는가에 대한 책은 읽어본 적이 없겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = e4a06520-51a9-dd9e-894b-5f15492e7c8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:e4a06520-51a9-dd9e-894b-5f15492e7c8d
#, fuzzy
msgctxt "hf65d749bg6565g4a2dg8694gc14d2546b93c"
msgid "True enough. That's why I came looking - to help, if I could."
msgstr "그런 것 같네요. 그래서 제가 가능한 한 도움을 드리려고 온 거죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = eb2e93ff-5086-b068-9539-9f89320a4b30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:eb2e93ff-5086-b068-9539-9f89320a4b30
msgctxt "hd6da7e42g0b80g4429g96dfg7692b00aaac6"
msgid "You and I have different tastes in books, clearly..."
msgstr "확실히 우리 둘의 독서 취향은 매우 다르군요…."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f66d10b3-7f0e-4bcd-8af9-771188457cc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 40a86032-d46c-b71a-9776-ee58e3730541_B = False
#. SetFlags:
#.   Local:
#.     - 40a86032-d46c-b71a-9776-ee58e3730541_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:f66d10b3-7f0e-4bcd-8af9-771188457cc1
msgctxt "h0682cfafg4309g4187g9339ge5f21d2971f0"
msgid "This camp - is there much in the way of food?"
msgstr "이 야영지에 음식은 많이 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym
#. Speaker = Tara the Tressym
#. NodeID = fa64e37f-a184-6f6e-426b-ed8ba2840e99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Gale_AD_Tressym:fa64e37f-a184-6f6e-426b-ed8ba2840e99
msgctxt "hd86143c7gab18g4a0bgb12dg12c751b0bee4"
msgid "Yes you do."
msgstr "아뇨, 그렇지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 046676f0-d512-729c-d6ad-fbee8a0b2127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:046676f0-d512-729c-d6ad-fbee8a0b2127
msgctxt "he4b912fcg2a08g484ag8efag2e3267162111"
msgid "I feel awful. We won't be doing that again."
msgstr "끔찍해. 다신 그거 안 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Lae'zel
#. NodeID = 07e84d7c-5ab8-af4d-ab9b-db5d9be496b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:07e84d7c-5ab8-af4d-ab9b-db5d9be496b9
msgctxt "hfb61a975g1780g4a99g9685g119bdd872bae"
msgid ""
"Fine - he stays, 'til he's no longer of use. Besides, my flesh is not so "
"easily tasted."
msgstr "좋아, 머물러. 더 이상 쓸모가 없어질 때까지. 게다가 내 살은 그렇게 쉽게 맛이 나지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Karlach
#. NodeID = 08414d63-d573-41c5-91a9-72fe2ed15301
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:08414d63-d573-41c5-91a9-72fe2ed15301
msgctxt "h1fbba1eeg4136g4f82gbd9ag0884322917c1"
msgid ""
"A vamp, huh? Interesting. Keep your teeth to yourself, Astarion, and we "
"won't have any issues."
msgstr "뱀파이어? 재미있네. 이빨 간수만 잘한다면, 아스타리온. 별 문제 없겠지 뭐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 0af28beb-2830-0c56-41fc-096e4a06f050
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:0af28beb-2830-0c56-41fc-096e4a06f050
msgctxt "hb3aec910gb068g4e3ag82c1g5c0562331cd8"
msgid "What's causing this? The mind flayer's parasite?"
msgstr "뭐 때문에 이런 일이 일어나는 거지? 마인드 플레이어 기생충 때문인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 0d631f28-4d6e-fd51-7f23-b375b1dd2930
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:0d631f28-4d6e-fd51-7f23-b375b1dd2930
msgctxt "h94b53ae1g7241g4c94ga38bgc6a6a879c75d"
msgid "No, but I have questions. How are you standing in the sun?"
msgstr "괜찮아, 하지만 질문이 있어. 어떻게 태양빛 아래 서 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Wyll
#. NodeID = 0f385318-f324-e233-74eb-0ad751f218fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:0f385318-f324-e233-74eb-0ad751f218fc
msgctxt "hedd7002dg78ddg4112ga277g9f0cd91ae471"
msgid "I just better not wake with any holes in my neck."
msgstr "그저 내 목에서 어떤 구멍도 나지 않은 채 일어나는 게 좋겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 0f404f48-9d4a-de67-05ce-46ee8227463c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:0f404f48-9d4a-de67-05ce-46ee8227463c
msgctxt "h3c39efd2g8175g4ef4g8de9g40a4bf1e47a0"
msgid ""
"I'm just glad you're being sensible about these revelations. I was worried "
"people might turn up with torches and pitchforks."
msgstr "네가 진실을 알고도 분별력이 있어서 다행이야. 난 횃불과 갈퀴를 든 사람들이 나타나지 않을까 걱정했었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 0f67c7c7-51c6-23a3-6e5e-57174b6a2377
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:0f67c7c7-51c6-23a3-6e5e-57174b6a2377
#, fuzzy
#| msgid "We need him, like it or not."
msgctxt "hbedadf19gdf09g4a11ga71ag185bf0fd236b"
msgid "Enough. We need him, like it or not."
msgstr "우리에겐 그가 필요해. 좋든 싫든 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 0fffe487-0176-52fb-10ec-2d951565e18c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:0fffe487-0176-52fb-10ec-2d951565e18c
msgctxt "hb89a27e0gefb9g45b2g8e88g1a4358f3994e"
msgid ""
"Perhaps I am. For two hundred years, the sun would have turned me to "
"cinders. Now I stand here like it's nothing."
msgstr "어쩌면 그럴지도. 지난 이백년 간, 태양은 날 잿더미로 만들었을 텐데. 그리고 난 지금 아무렇지도 않다는 듯이 서있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 18f826bf-1119-4786-9919-3ebeeae4d80c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_TheHungerC_Bite = True
#.   Object:
#.      - CAMP_Astarion_State_VictimOfAstarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:18f826bf-1119-4786-9919-3ebeeae4d80c
msgctxt "h61bf70f7g2ff9g4613g8efdgd73c7d187027"
msgid "Good morning. How do you feel?"
msgstr "좋은 아침이야. 기분이 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Lae'zel
#. NodeID = 1a949530-c2e9-46fb-9c94-5bc83087fa3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:1a949530-c2e9-46fb-9c94-5bc83087fa3d
msgctxt "hafad6e8dg68fcg450dg824ag11771eff2e9e"
msgid "For his sake, he best not develop an appetite for githyanki."
msgstr "그는 스스로를 위해서라도, 기스양키에 식욕을 돋우지 않는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 1f6ddefb-6492-7725-e8bb-8db1ff2df446
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:1f6ddefb-6492-7725-e8bb-8db1ff2df446
msgctxt "h1a13401cg6391g4064gbdbcgee32f34de3dc"
msgid ""
"Is that how you could stand in the sun? Because you're not a 'true' vampire?"
msgstr "그래서 네가 햇빛 아래 서 있을 수 있던 거야? '진짜' 뱀파이어가 아니어서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 244d6a14-80e0-48e2-aac2-8e2d11d7471f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:244d6a14-80e0-48e2-aac2-8e2d11d7471f
msgctxt "h37fef8c1ge9abg464dga667g5c365fbcb834"
msgid "Oh you're such a sweetheart."
msgstr "오, 넌 마음씨가 정말 다정하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Shadowheart
#. NodeID = 2a7ef039-16d0-436c-ac03-f5e793afc592
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:2a7ef039-16d0-436c-ac03-f5e793afc592
msgctxt "h395aa3d5gd152g42c8g92efge1e5d3c930f0"
msgid "I'd just better not wake in the night to find fangs at my throat."
msgstr "밤에 잠에서 깼을 때 내 목에 송곳니가 들어와 있지 않기를 바랄 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 2ad0da68-28ee-122a-eed8-ad74846a95bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:2ad0da68-28ee-122a-eed8-ad74846a95bb
msgctxt "h18c57afag370ag46c8g81f0g1a4263fcce9b"
msgid "My neck hurts, how do you think I feel?"
msgstr "목 아파 죽을 것 같아. 내 기분이 어떨 것 같은데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Gale
#. NodeID = 2d648735-0477-2f2f-3abb-b92efbf6f3fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:2d648735-0477-2f2f-3abb-b92efbf6f3fa
msgctxt "ha6c67389g1824g41f0g928cg6235154eafc1"
msgid ""
"You say all the right words, but I'm not so sure you mean the right things. "
"Still, I will respect the decision that was made."
msgstr "타당한 말을 했지만, 네 말이 진심인지는 잘 모르겠어. 그래도 내려진 결정은 존중할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 320912dc-b90b-b18f-3c03-1065a6600d5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:320912dc-b90b-b18f-3c03-1065a6600d5f
msgctxt "hf73bc0f7gddcbg47a2gbff9g4b0aa9de3ed6"
msgid "Not at all. Having a vampire on our side could be useful."
msgstr "괜찮아. 우리 편에 뱀파이어가 있다면 쓸만할지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Gale
#. NodeID = 348a0cbf-48df-42f2-9521-490d360dce54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:348a0cbf-48df-42f2-9521-490d360dce54
msgctxt "h054d9a05g1834g430cg9448g339b93e4c5e5"
msgid "So we're travelling with a vampire, are we?"
msgstr "그럼 우리는 뱀파이어와 함께 여행하고 있는 것이군, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 3a32feca-3edc-03cb-8e78-880d68f62b7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:3a32feca-3edc-03cb-8e78-880d68f62b7b
msgctxt "he6085308g39a7g463dgb033g6d33dcfcb575"
msgid ""
"But now that the air's clear, we should probably get moving. There's a long "
"day ahead of us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 3a967f5a-4e86-0bc1-50a0-2482e94740a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:3a967f5a-4e86-0bc1-50a0-2482e94740a6
msgctxt "h50c1a2aeg54ebg4bb1gae78gde553482e6d1"
msgid "Well. I hope there are no bad feelings."
msgstr "그러니까. 나쁜 감정이 남지 않았길 바랄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 40f3da95-d277-7011-2143-24d31efb5d66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:40f3da95-d277-7011-2143-24d31efb5d66
msgctxt "h739742d1gf429g4526ga746g4ea61ac5e259"
msgid "Figure them out quickly. I don't want any more surprises."
msgstr "빨리 알아내는 편이 좋을 거야. 더 이상 깜짝 놀라긴 싫으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 425f8c11-252f-2458-757a-a9d707042b9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:425f8c11-252f-2458-757a-a9d707042b9d
msgctxt "h2166173dg6f97g49c6g9f64gc5d99d9e4cd1"
msgid "I wouldn't recommend it. I won't get you, but the mind flayers might."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Gale
#. NodeID = 4acd8104-2860-4fe7-9b25-0523ff462b99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_Bomb = False
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:4acd8104-2860-4fe7-9b25-0523ff462b99
msgctxt "h09d7d0f2ga2dfg45e0g88c0g53a71210a70c"
msgid ""
"Oh, and a quick word of warning, Astarion: I taste absolutely <i>awful</i>. "
"Keep your distance."
msgstr "오, 그리고 경고 한마디 할게, 아스타리온: 내 피맛은 굉장히 <i>끔찍해</i>. 거리를 뒀으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 4c175747-8b18-0ec9-98cf-9cfa8b9646be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:4c175747-8b18-0ec9-98cf-9cfa8b9646be
msgctxt "h4e120fc6gb7eag4b22gade6g849d47501a61"
msgid "There now. We're all friends again."
msgstr "그만 됐어. 우린 다시 친구야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 4c3117f7-3d54-ec4b-21b8-40fb05131cec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:4c3117f7-3d54-ec4b-21b8-40fb05131cec
msgctxt "hdf2814e2gf6e0g457dgb999g85f1d5955e94"
msgid "As for my other quirks - well, we can figure those out in time."
msgstr "내게 다른 특이한 일은 - 글쎄, 시간이 지나면 알 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Lae'zel
#. NodeID = 503ec0e6-4292-e63f-9f1c-77b50684ff71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:503ec0e6-4292-e63f-9f1c-77b50684ff71
msgctxt "h955d92a3g604fg46f6g8792gc9421922a508"
msgid "Unless, of course, I have offered it."
msgstr "물론, 내 스스로 내줬을 경우에만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 540a3ec3-71fa-6d13-aa93-18d307962f44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:540a3ec3-71fa-6d13-aa93-18d307962f44
msgctxt "h98817d06g757dg4f35g97acgcba8c4a93881"
msgid "I'm fine, I just feel a little woozy."
msgstr "괜찮아, 조금 멍할 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Karlach
#. NodeID = 5577482b-7f8c-4bf6-a3d4-a01ab3d9167f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:5577482b-7f8c-4bf6-a3d4-a01ab3d9167f
msgctxt "h786e3ee8ga5a9g458dgb877g9faf276e0360"
msgid "Yeah. And I'm <i>way </i>too hot to touch."
msgstr "그래. 그리고 난 만지기엔 <i>너무</i> 뜨겁거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 55f3c89b-5fbf-ec83-24bd-e82ae701a465
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:55f3c89b-5fbf-ec83-24bd-e82ae701a465
msgctxt "he3dae185g709cg4763g8a0bgd49b3bb11531"
msgid ""
"Oh no, I should be cinders in this light. I hadn't seen the sun for two "
"hundred years before we crashed here."
msgstr "오, 아니지. 나는 이 빛 아래서 재가 돼야 해. 여기 추락하기 전 200년 동안은 태양을 본 적이 없었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 59dd5dbb-e242-fa8f-2800-7a0f0e496529
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:59dd5dbb-e242-fa8f-2800-7a0f0e496529
msgctxt "h4b5b6821g06f4g4265gbff7gc7c9131edc47"
msgid "Someone - or something - wants me alive. They've changed the rules."
msgstr "누군가 - 아니면 무언가가 내가 살아있길 바라고 있어. 그것이 법칙을 바꾸었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Karlach
#. NodeID = 5db94ba7-438a-1923-9490-d8aa72467236
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:5db94ba7-438a-1923-9490-d8aa72467236
msgctxt "hc020df0fgca6cg45b8g99b9gef42e1813472"
msgid "Anyway, you'd burn your tongue off if you went for <i>this </i>neck."
msgstr "근데 네가 <i>이</i> 목을 노리는 순간 혀가 불타 버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 635178ff-f1f1-65e5-52b9-09a2e216667e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:635178ff-f1f1-65e5-52b9-09a2e216667e
msgctxt "h14f2ce90g0f18g4daeg80f6gfd644cab00e7"
msgid "You're lucky I didn't kill you."
msgstr "내가 널 죽이지 않은 걸 다행으로 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 6ceaf9af-4a2a-a083-f4dd-03d74f82de5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:6ceaf9af-4a2a-a083-f4dd-03d74f82de5f
msgctxt "hcd2fb315gc9e0g45bfgb7c4g3125dfed93f5"
msgid "That's my theory, but who knows?"
msgstr "그게 내 가설이지만, 누가 알겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 6ef5c430-66a6-844e-01bd-548f4b081257
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_MorningAfter_AtLeastOnceCompanionPresent = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:6ef5c430-66a6-844e-01bd-548f4b081257
msgctxt "hfee2c9eeg63ceg43a8gb3a9g625864c58a0b"
msgid ""
"I'm just glad you're being sensible about this. I was worried you might wake "
"up and grab your torch and pitchfork."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 70d249f8-0313-79aa-4c1a-6fc1e7dcb178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:70d249f8-0313-79aa-4c1a-6fc1e7dcb178
msgctxt "h6549a562gb199g43c2gb01ag0474e3dd615a"
msgid "Alas, I'm just a spawn. All of the hunger, few of the powers."
msgstr "아아, 난 그냥 스폰일 뿐이야. 갈증은 같지만, 힘은 다르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Wyll
#. NodeID = 71f289c5-31aa-4ae1-9ca5-ef21b8f7327e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:71f289c5-31aa-4ae1-9ca5-ef21b8f7327e
msgctxt "h56de64d9gf788g454fgab6fgb1cc808fcc8a"
msgid "Fine - as long as he keeps his fangs off our necks."
msgstr "좋아, 그가 우리 목에 송곳니를 들이대지만 않으면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Lae'zel
#. NodeID = 71f5a99b-1b6f-3467-6846-3a2655137db7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:71f5a99b-1b6f-3467-6846-3a2655137db7
msgctxt "hcbb4484fg408dg4a24ga54fg32a121a27980"
msgid ""
"But should I wake with so much as a drop of blood on my neck, I will <i>end</"
"i> him."
msgstr "하지만 내 목에 한 방울의 피라도 묻은 채 깨어 난다면, <i>끝장내</i> 줄 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 740dbe0b-7fb1-fe0f-bfce-99e82f9cb28d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:740dbe0b-7fb1-fe0f-bfce-99e82f9cb28d
msgctxt "hc32f2c0ag65edg4d81g992bgf0ee225118d2"
msgid ""
"And you're lucky I'm not a 'true' vampire. Last night could have gone very "
"differently if I'd magically summoned a pack of wolves."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 74b75238-c35b-ed43-dea5-948c664f8036
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:74b75238-c35b-ed43-dea5-948c664f8036
msgctxt "hda712fbag2999g4100g9bbag7cfc90cf53be"
msgid "No more surprises. You have my word."
msgstr "더 이상 놀랄 일은 없을 거야. 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 76b1f538-f90e-33d8-2e61-c74e0093c564
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:76b1f538-f90e-33d8-2e61-c74e0093c564
msgctxt "hc3a99ae7gf395g486cg93f9g9be6aa1e5bf7"
msgid "If you don't like it, you can leave."
msgstr "마음에 들지 않는다면, 떠나도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Gale
#. NodeID = 79e35825-9259-6f5a-3023-b7a669e47a94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:79e35825-9259-6f5a-3023-b7a669e47a94
msgctxt "h30104cacg9ab0g4ce1ga4f1g06426ea943c2"
msgid ""
"A word of warning, Astarion: I taste absolutely <i>awful</i>. Keep your "
"distance."
msgstr "경고 한마디 할게, 아스타리온: 내 맛은 굉장히 <i>끔찍해</i>. 거리를 뒀으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Shadowheart
#. NodeID = 7bc6a85a-f50b-e90c-fd51-dd30436f5d1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:7bc6a85a-f50b-e90c-fd51-dd30436f5d1e
msgctxt "h824667bcg494bg45e0g8839gc7d964e11632"
msgid ""
"Given our group's nature, I don't see much harm. We're each monsters in the "
"making, after all."
msgstr "우리 일행 성격상, 큰 해는 없어 보여. 어쨌거나 우린 전부 괴물화 진행중이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 7dd1814a-beed-c273-5e51-a23836aeaf14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:7dd1814a-beed-c273-5e51-a23836aeaf14
msgctxt "h09612ff4g7931g43efgbb66g52f4d75bea3a"
msgid "Although there's still time."
msgstr "앞으로도 괜찮을지는 아직 모르겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 7f7b2aae-13aa-e42f-781b-ee8e85affacc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:7f7b2aae-13aa-e42f-781b-ee8e85affacc
msgctxt "ha5eebaa1g11d4g418dgad82gb4425bafcb6f"
msgid "Shall we go? There's a long day ahead of us."
msgstr "출발할까? 우리 앞에는 긴 하루가 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 829f5c16-b09f-87c7-ad8c-14d5e21b7af2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:829f5c16-b09f-87c7-ad8c-14d5e21b7af2
msgctxt "hc21c9ec6g7178g447bg9f2ag1d49aff9b473"
msgid "Be grateful I'm not a 'true' vampire, then."
msgstr "그럼 내가 '진짜' 뱀파이어가 아닌 것에 감사하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Shadowheart
#. NodeID = 8395e04e-d77c-441a-b535-490f83772e30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:8395e04e-d77c-441a-b535-490f83772e30
msgctxt "h1db595a8g1304g4ebcgb314gd97b90bcc06c"
msgid "A vampire? Well that explains the pallor."
msgstr "뱀파이어라고? 그럼 창백한 이유가 설명이 되네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 870c29e8-3891-420a-d717-295c1440e0bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_TheHungerC_Bite = False
#.   Object:
#.      - CAMP_Astarion_State_VictimOfAstarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:870c29e8-3891-420a-d717-295c1440e0bd
msgctxt "he9188c5dge986g419cgaffbg38e4eabd8002"
msgid ""
"Morning. I hope last night's little unpleasantness hasn't left a bad taste "
"in your-"
msgstr "좋은 아침. 어젯밤에 있었던 불쾌한 일이 네 입에 안 좋은 맛을 남기지-"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Wyll
#. NodeID = 8bc9107b-f54c-b030-ee7d-bfc8df37a11b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:8bc9107b-f54c-b030-ee7d-bfc8df37a11b
msgctxt "h00dd2aadge3ecg4ad4g8f1eg78680656e52f"
msgid ""
"Very well - but I'm keeping an eye on you. And no wisecracks about having us "
"for supper."
msgstr "좋아, 하지만 널 지켜보겠어. 그리고 우릴 저녁식사로 삼겠다는 농담은 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Karlach
#. NodeID = 8cc06568-311a-48a5-baed-cf369ff6527c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:8cc06568-311a-48a5-baed-cf369ff6527c
msgctxt "h8b1d9802g84bbg4750gaa5cgbb3d71f12bae"
msgid "Vamps don't scare me. As long as they keep their teeth to themselves."
msgstr "뱀파이어가 날 무서워할 일은 없겠지. 나한테 이빨을 들이대지만 않는다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 8ef5aa89-b3fe-144d-2b26-72c3919b2558
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:8ef5aa89-b3fe-144d-2b26-72c3919b2558
msgctxt "he7b324f9g12a4g4905g971eg17726c562e0c"
msgid ""
"Of course, I can't summon wolves or turn to mist like a 'true' vampire. "
"Being a spawn has its drawbacks."
msgstr "물론, 나는 '진짜' 뱀파이어처럼 늑대를 소환하거나 안개로 변신할 수 없어. 뱀파이어 스폰의 단점이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 905a7474-7f0b-b308-f875-690dcd9cff67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:905a7474-7f0b-b308-f875-690dcd9cff67
msgctxt "h0783e027g7809g4e3dgb2b6gb54b9f4f2ab6"
msgid "Pity. I thought you'd be more powerful."
msgstr "안됐네. 네가 더 강력할 거라고 생각했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = 96f3f5a6-4277-05a7-f64d-b39073b59c27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:96f3f5a6-4277-05a7-f64d-b39073b59c27
msgctxt "ha23d378fg101eg4242g865ege398973491ad"
msgid ""
"Is that how you can stand in the sun? Because you're not a 'true' vampire?"
msgstr "그게 네가 햇빛 아래 서 있을 수 있는 이유야? '진짜' 뱀파이어가 아니어서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 9a16648b-bcb3-3f76-daf0-956dafc923c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:9a16648b-bcb3-3f76-daf0-956dafc923c3
msgctxt "hf856ccf3g131ag4c56gb6c2g25951b1ea22a"
msgid "Indeed it could. These are very helpful in a fight."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 9f83acae-f6f5-95bb-c7ce-0798c779de0f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:9f83acae-f6f5-95bb-c7ce-0798c779de0f
msgctxt "hfeaa61e9gcfb3g44bdga6bbg3d467dee8b4f"
msgid "He's not wrong. We're bound together, no matter what comes."
msgstr "틀린 말은 아니야. 무슨 일이 닥치든, 우리는 다 같은 일행이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 9f83acae-f6f5-95bb-c7ce-0798c779de0f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:9f83acae-f6f5-95bb-c7ce-0798c779de0f
msgctxt "h67794f71gb053g4a9eg8644g980f06428c7f"
msgid "She's not wrong. We're bound together, no matter what comes."
msgstr "틀린 말은 아니야. 무슨 일이 닥치든, 우리는 다 같은 일행이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = 9f83acae-f6f5-95bb-c7ce-0798c779de0f
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:9f83acae-f6f5-95bb-c7ce-0798c779de0f
msgctxt "h9c6b1a46gd5c0g4942g8916gd2becb1850e4"
msgid "They're not wrong. We're bound together, no matter what comes."
msgstr "틀린 말은 아니야. 무슨 일이 닥치든, 우리는 다 같은 일행이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Karlach
#. NodeID = a259f59d-fae9-e202-77c1-24a30e135917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:a259f59d-fae9-e202-77c1-24a30e135917
msgctxt "h3b2a739eg2945g4ca8gaf50g610e558eed40"
msgid "No sense judging someone for who they are. Except devils, obviously."
msgstr "누군가를 겉모습만 보고 판단하는 건 의미 없는 짓이긴 해. 아, 물론 데빌 놈들은 빼고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = a3fbd3b4-55dc-bb87-7850-bc79ceb6b197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:a3fbd3b4-55dc-bb87-7850-bc79ceb6b197
msgctxt "hf3afaa06ge27eg46bfg9079ga6593a11b4df"
msgid ""
"A bite from them and you might wake up as a vampire spawn, like my good "
"self. All of a vampire's hunger, but few of their powers."
msgstr ""
"그들에게 물렸으면 나같은 뱀파이어 스폰이 돼서 일어났을 거야. 뱀파이어의 허기는 그대로지만, 그 능력은 극히 일부만 받은 채 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Shadowheart
#. NodeID = a6a182dd-9bb0-149a-3bd1-b914a5e4cdbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:a6a182dd-9bb0-149a-3bd1-b914a5e4cdbc
msgctxt "h58176fbfg91f5g44cfgb173gf2fcc37b1610"
msgid ""
"Maybe we could get him to wear a bell - dissuade any night-time prowling."
msgstr "그에게 방울을 달 수도 있어. 밤에 배회하지 못하게 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = ab4bb3f6-673e-d852-3f4b-e5926e1a7627
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:ab4bb3f6-673e-d852-3f4b-e5926e1a7627
msgctxt "h0c9efa5bgfe5fg4345g9178g1bc8405c5abf"
msgid "A pity. Just be grateful I'm not a 'true' vampire."
msgstr "안됐네. 내가 '진짜' 뱀파이어가 아닌걸 다행으로 여기라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = beb79fff-053c-ee7d-1d66-1dc64d1cfca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:beb79fff-053c-ee7d-1d66-1dc64d1cfca8
msgctxt "ha1018eefg6957g4b15ga4b9g2daee699f7a5"
msgid ""
"Oh, I have no idea. By rights I should be cinders in this light. But someone "
"- or something - is keeping me alive."
msgstr ""
"오, 그건 나도 전혀 모르겠어. 당연히 이런 빛 아래에선 잿더미가 되었어야겠지. 하지만 누군가, 아니면 무엇인가 날 살려두고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Gale
#. NodeID = c2275a91-f0bc-40cd-9ca3-903bf5af6aa0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:c2275a91-f0bc-40cd-9ca3-903bf5af6aa0
msgctxt "hd88a27e6g987dg444dg87ecgd856e1dd3235"
msgid "So we're travelling with a vampire, are we? Of course we are."
msgstr "그럼 우리는 뱀파이어와 함께 여행하고 있는 것이군, 그렇지? 그렇고말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = c415ef2c-6e97-3a58-7f0d-152dae27688c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:c415ef2c-6e97-3a58-7f0d-152dae27688c
msgctxt "h53735371gbc64g44e8gb08ag20017bf60ea6"
msgid "If I can help, just ask. We're in this together."
msgstr "내가 도움이 될 수 있으면, 언제든 요청해. 우리는 함께니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = d671cc2a-7b0e-dd91-1922-b4cd59684b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:d671cc2a-7b0e-dd91-1922-b4cd59684b9c
msgctxt "h0c586ff8ge90ag431agbedbg891fcda13c7d"
msgid ""
"Quite the opposite. I'm here in the spirit of openness and honesty, to work "
"together as a team."
msgstr "그 반대지. 나는 여기서 개방성과 정직함의 기조로 한 팀으로 같이 일할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Player
#. NodeID = dbab3495-6273-155d-837e-f6ea42a75450
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:dbab3495-6273-155d-837e-f6ea42a75450
msgctxt "h9269a912g70a0g4ae4ga6b2g63cbe9548727"
msgid "Any other drawbacks I should know about?"
msgstr "내가 알아야 할 다른 결점들도 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Wyll
#. NodeID = dc9a4359-fc5d-4086-9de4-8b33756071c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:dc9a4359-fc5d-4086-9de4-8b33756071c3
msgctxt "hff82d459g024bg453bg8a6cg919c4d56a948"
msgid "Hunting with vampires? Never thought I'd see the day."
msgstr "뱀파이어와 함께 사냥하다니? 이런 날이 오게 될 줄은 몰랐군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Astarion
#. NodeID = e188c0f7-4f53-d729-9f09-1a706b9c2d48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:e188c0f7-4f53-d729-9f09-1a706b9c2d48
msgctxt "h6a00475bg8d97g43d4ga149gd4daaf9b7cd3"
msgid ""
"Oh, I've no idea. For two hundred years, the sun would have turned me to "
"cinders. Until the crash, when I woke up bathed in its light."
msgstr ""
"오, 그건 나도 전혀 모르겠어. 이백 년 동안이나, 태양 아래에 서면 난 잿더미가 되었을 거야. 추락 이후로 내가 이 빛 아래에서 "
"깨어나기 전까지는 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Karlach
#. NodeID = e5b2f94e-5656-f8fe-c65d-77b8b2c6b41e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:e5b2f94e-5656-f8fe-c65d-77b8b2c6b41e
msgctxt "h8e287a26ge693g4947gb4bag5a647be2e214"
msgid "Some of us more than others, but - yes."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Lae'zel
#. NodeID = e7fef34b-68ae-4dee-959e-7ea86d675f81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:e7fef34b-68ae-4dee-959e-7ea86d675f81
msgctxt "h56560057g9ab4g417fgb9a0gf7fca458c1f6"
msgid "A vampire among us? So be it."
msgstr "우리 중에 뱀파이어가 있다고? 그러라고 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
#. Speaker = Gale
#. NodeID = e9df6490-f31d-66bc-e24e-138938c7d9bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter:e9df6490-f31d-66bc-e24e-138938c7d9bb
msgctxt "ha1be9e13g73e4g4552g8417g471eeaf33ece"
msgid "A word of warning, Astarion: I taste absolutely <i>awful</i>."
msgstr "경고 한마디 할게, 아스타리온: 내 맛은 굉장히 <i>끔찍해</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_AstarionHungerC_CRD_Astarion_MorningAfter
