msgctxt "hacd6f448g4b6cg491agac3ag585571a2255a"
msgid ""
"<i>Pay him what you promised.</i> ([01f129ea-b4dc-44b6-8154-9a948f876a82])"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 0193b5e2-dc64-c062-bd26-348cdd041c32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:0193b5e2-dc64-c062-bd26-348cdd041c32
msgctxt "hd74af99egedeeg4bb7gb1e6ge679f62ad78c"
msgid "Don't look at me like that. I can't... no."
msgstr "날 그렇게 보지 마. 난... 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 08d1f61a-a9ec-b3f9-3167-e606563f7470
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:08d1f61a-a9ec-b3f9-3167-e606563f7470
msgctxt "he8ce5ba8g6b96g48f9gb0e3g7eb4ac5cc8e7"
msgid "<i>Use your connection to her. Delve into her thoughts.</i>"
msgstr "<i>그녀와의 연결을 이용한다. 그녀의 정신 속으로 들어간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 092b07d1-19bc-acbf-1fff-a63ae2849955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:092b07d1-19bc-acbf-1fff-a63ae2849955
msgctxt "h7685e39ega4b5g45f3g85c0g45c708a9ea24"
msgid "Rest where? I can't leave. The whispers won't let me leave."
msgstr "어디서 쉬라고? 난 떠날 수 없어. 속삭임들이 가만히 내버려 두질 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 09e24698-3265-30a9-cc0c-0b2dec4d3723
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:09e24698-3265-30a9-cc0c-0b2dec4d3723
msgctxt "h2b85f229g5548g4c70gb263gb74d30dd6225"
msgid "<i>Stare her down.</i>"
msgstr "<i>그녀를 응시한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 09f9b58c-c4a0-861e-b312-807ed152c33c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:09f9b58c-c4a0-861e-b312-807ed152c33c
msgctxt "hc6c3d1f4gaccfg4239ga53bgb24090a92898"
msgid "<i>Is the parasite compelling her to do this? Delve into her mind.</i>"
msgstr "<i>기생충이 그녀를 유혹하고 있는 건가? 그녀의 정신 속으로 파고든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 0bc4f1de-820f-ab62-e455-221f71ef9d17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:0bc4f1de-820f-ab62-e455-221f71ef9d17
msgctxt "h2d3d24e8gfc91g4174g8cabg287b4a3d13f0"
msgid "You're here. Just like it told me."
msgstr "여기 있구나. 그게 알려준 대로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 105c0d14-6c9c-48b7-71ec-18797626a020
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:105c0d14-6c9c-48b7-71ec-18797626a020
msgctxt "h96d1ca3cg5797g486bgbbe8gbe514f385c3f"
msgid "Oh, you've risked plenty."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Narrator
#. NodeID = 1205165d-bddd-8ae6-6944-657acd7e2a30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_CM_Ultimatum_MindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:1205165d-bddd-8ae6-6944-657acd7e2a30
msgctxt "hdd08feb1g3693g4216g9986gbbfe2e47e6ea"
msgid ""
"*A strange miasma clings to her thoughts. Not the tadpole, but your "
"interruption fazes her.*"
msgstr "*그녀의 정신에 기묘한 기운이 매달려 있습니다. 기생충은 아니지만, 당신의 개입이 그녀를 당황시킵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 143e7cb3-59e5-7683-c062-c809519a3a23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_CM_Ultimatum_MindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:143e7cb3-59e5-7683-c062-c809519a3a23
msgctxt "h6c2d3cddga40dg4cb1g968fg6ef9bae93a89"
msgid "There's something controlling your mind. I can feel it."
msgstr "뭔가 네 정신을 통제하고 있어. 그게 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 16c36501-888a-3737-4828-efb9f103df36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = False
#.   Local:
#.      - 1e628214-dde8-dd7e-d072-c7718e8697a9_ShadowheartUltimatum_WhoIsShe = False
#. SetFlags:
#.   Local:
#.     - 1e628214-dde8-dd7e-d072-c7718e8697a9_ShadowheartUltimatum_WhoIsShe = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:16c36501-888a-3737-4828-efb9f103df36
msgctxt "h7f95730ag7c3bg4d1cg8de4g2be76e003ad3"
msgid "Who are you?"
msgstr "넌 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 1fdbed15-0288-1241-54b2-63576f1db153
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:1fdbed15-0288-1241-54b2-63576f1db153
msgctxt "h253fd219gd0f9g44d7g8007g06abbaeca3df"
msgid "It's not? What are these voices doing to me?"
msgstr "아니라고? 이 목소리들이 내게 뭘 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 2b481e3d-02f2-4ad9-e78b-3c88d45f3d49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:2b481e3d-02f2-4ad9-e78b-3c88d45f3d49
msgctxt "hbca923a4g4a49g4267gac8cgec9945411a44"
msgid "You're here. Just like it told me you'd be, gith."
msgstr "여기 있구나. 그게 알려준 대로야, 기스."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 3601241f-42ba-d374-9dec-129c3563662c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:3601241f-42ba-d374-9dec-129c3563662c
msgctxt "h732b4d7cg4119g4edegbda4g83937baae6bc"
msgid "You can stay here. I'll watch over you."
msgstr "여기 머물러도 좋아. 내가 네 뒤를 지켜줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 362e2dbb-21f3-5fa7-904e-4549672e2da9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1e628214-dde8-dd7e-d072-c7718e8697a9_SH_SleepPushing_LineSpoken = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:362e2dbb-21f3-5fa7-904e-4549672e2da9
msgctxt "hb27039b4g6367g4a17g87d9g838ee05bc370"
msgid ""
"I can't sleep. The whispering won't let me. It keeps pushing me - to you."
msgstr "잠을 잘 수가 없어. 속삭임이 날 가만히 내버려 두질 않아. 그게 계속 날 네게로 밀어붙이고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 3ae09b08-1e37-e1c8-df2b-c55b6e9484c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:3ae09b08-1e37-e1c8-df2b-c55b6e9484c6
msgctxt "h7a88eac9g2183g423egac9cg93c2df818fe6"
msgid "You can stay here. I'll watch over you."
msgstr "여기 머물러도 좋아. 내가 네 뒤를 지켜줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 3bd44a37-2533-a97a-5b67-b573809611c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:3bd44a37-2533-a97a-5b67-b573809611c1
msgctxt "h2aa821b7g15a1g46dag9c79g308fd592f734"
msgid "Your stance is off. Lower the blade before I take it from you."
msgstr "네 태도가 이상하군. 그 칼날을 내가 직접 빼앗기 전에, 내려놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Gale
#. NodeID = 3d8c07ee-2250-b0d4-de82-9dce6dd69593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_GALE(5) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:3d8c07ee-2250-b0d4-de82-9dce6dd69593
msgctxt "he2199212gc803g41a1gbabfg213c05b770bb"
msgid "Careful! She's about to lash out."
msgstr "조심해! 그녀가 공격하기 직전이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 3d9eb2ae-2df0-fb9d-fe79-21d70c0fb7b1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:3d9eb2ae-2df0-fb9d-fe79-21d70c0fb7b1
msgctxt "had814695gbc5fg4e72g8ef4gadad1da28f45"
msgid "Threaten me again, and it'll be the last thing you do."
msgstr "다시 날 위협하면, 그게 네 마지막일 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 3de27b21-a856-3dde-4b1b-84aace4276f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:3de27b21-a856-3dde-4b1b-84aace4276f9
msgctxt "h1b7e86beg032eg48b3g8afcg097dd5716e51"
msgid "What is this? Have you been tracking me?"
msgstr "무슨 짓이야? 날 추적한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 3e5e1776-a916-4e0f-5ec8-789b3aa25e60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:3e5e1776-a916-4e0f-5ec8-789b3aa25e60
msgctxt "h90553c46g4f9eg40bcgb634ga2119dedf26d"
msgid "I can't risk having you around."
msgstr "네가 주변에 머무르는 건 위험할 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 408e9d93-31c9-1e9e-0dcb-21243f942778
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:408e9d93-31c9-1e9e-0dcb-21243f942778
msgctxt "h20189425geeb7g49abg9558gde5bcd71bc67"
msgid ""
"They've been in my head ever since... it doesn't matter. They brought me "
"here."
msgstr "그때부터 내 머릿속에 계속 맴돌고 있었어... 그건 중요한 게 아니야. 그게 날 이곳으로 이끌었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Narrator
#. NodeID = 40c0f227-8df9-aa3c-b50e-26bc45214bb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_HasMet = False
#.      - ORI_Astarion_HasMet = False
#.      - ORI_ShadowHeart_HasMet = False
#.      - ORI_Wyll_HasMet = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:40c0f227-8df9-aa3c-b50e-26bc45214bb4
msgctxt "h20e0ce3bg8aceg4fa8gbb65g9c09297b9901"
msgid ""
"*Your mind rushes into hers - a storm of desperation, confusion and a will "
"other than her own.*"
msgstr "*당신의 정신이 그녀의 머릿속으로 파고듭니다 - 절박함과 혼란스러움의 폭풍, 그리고 그녀가 아닌 다른 이의 의지가 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 42008e28-55bb-6dad-c116-ce157d74905d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:42008e28-55bb-6dad-c116-ce157d74905d
msgctxt "h649d1fbbg276cg426cgb745g6859adfdcf6a"
msgid "<i>Attack her.</i>"
msgstr "<i>그녀를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 42ce3263-c796-da7e-c990-201de9ec9f64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:42ce3263-c796-da7e-c990-201de9ec9f64
msgctxt "h60706147g5db0g40c0g8a22gd03d76882bc0"
msgid "Then how do I make them stop? What do I do?"
msgstr "그럼 멈추려면 어떻게 해야 하는 거야? 뭘 해야 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 434193f5-f473-7e93-f764-90a3e59b61b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:434193f5-f473-7e93-f764-90a3e59b61b1
msgctxt "h45d61e41g52afg4164g99c8gc4e1763abbb2"
msgid "It's a little quieter now. Is that what they wanted?"
msgstr "이제 조금 조용해졌어. 이게 그들이 원했던 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 434967b3-cc9c-b988-8b8c-a87f2eba3559
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:434967b3-cc9c-b988-8b8c-a87f2eba3559
msgctxt "h2d2ad8abga4c3g444cg8992g4e4401bab9a3"
msgid "I'm not pushing. Let's just talk this over."
msgstr "널 압박하는 게 아니야. 말로 해결하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 4358bfae-62df-b2c2-b18c-5deade473733
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:4358bfae-62df-b2c2-b18c-5deade473733
msgctxt "h58b62a26g464fg4cdbga897g1df57e98f4f9"
msgid "Say what you have to say."
msgstr "하고 싶은 말을 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 4ad5334d-7ab8-9147-7a51-c4c6f6e6d317
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:4ad5334d-7ab8-9147-7a51-c4c6f6e6d317
msgctxt "he1452b7dgd937g4a89g8b78g5ef013773822"
msgid "You're infected, same as me. How did you get here?"
msgstr "너도 나처럼 감염되었군. 여긴 어떻게 온 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Narrator
#. NodeID = 4d12a40c-5022-82a6-6690-357a8cc3d521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:4d12a40c-5022-82a6-6690-357a8cc3d521
msgctxt "ha4f96cacg5afag4a09g8b54gaebdb8049a9b"
msgid ""
"*There is a knife hidden in her belt. Her fingers twitch towards the hilt, "
"ready to draw the blade.*"
msgstr "*그녀의 허리띠 아래 칼이 숨겨져 있습니다. 그녀의 손가락이 손잡이를 향하며 칼을 뽑을 준비를 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 4d7e5b79-46e1-a38d-111a-c51a463a18d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:4d7e5b79-46e1-a38d-111a-c51a463a18d0
msgctxt "h27cdf129ge79dg4cd9gabafg6cf855c4b228"
msgid "Then how do I make them stop? What do I do?"
msgstr "그럼 멈추려면 어떻게 해야 하는 거야? 뭘 해야 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 4fb5ebc0-19de-81cd-62c6-bf2439c9ebcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:4fb5ebc0-19de-81cd-62c6-bf2439c9ebcd
msgctxt "hf099d4degaf52g4360gbbc0g6ce314d70fb8"
msgid "You're here. Just like it told me."
msgstr "여기 있구나. 그게 알려준 대로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 58fc59ff-ec72-4599-78f5-7cc9f80eb49c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:58fc59ff-ec72-4599-78f5-7cc9f80eb49c
msgctxt "h61cb9f92gad83g4b74g90cag92422df18c49"
msgid "<i>Say nothing and observe Shadowheart closely.</i>"
msgstr "<i>아무 말도 하지 않고 가까이서 섀도하트를 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 59afaf2a-1fa7-96a6-4e8b-1bb091a03ec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:59afaf2a-1fa7-96a6-4e8b-1bb091a03ec4
msgctxt "h766504fcg7033g4d79gaf10gefb68a3ac26e"
msgid "<i>Attack her.</i>"
msgstr "<i>그녀를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 5dd6a9f3-4d31-2e42-1c16-ec43010fd392
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:5dd6a9f3-4d31-2e42-1c16-ec43010fd392
msgctxt "h3e5cf58agb0a9g4d65g8772g14783ad93823"
msgid "You're hallucinating. The blade isn't real."
msgstr "넌 환각을 보고 있는 거야. 그 칼날은 진짜가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 5f1a4434-fec5-0404-ec55-d238b7ff9829
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:5f1a4434-fec5-0404-ec55-d238b7ff9829
msgctxt "hd172287cgff01g4ae7gb8fcg5e59bc787e45"
msgid "What's wrong? You seem different than before."
msgstr "뭐가 문제야? 전에 봤을 때랑 뭔가 달라진 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 6884141c-7fa5-e4be-c9b8-385add4d5320
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_IsInParty = True
#.   Tag:
#.      - AVATAR(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:6884141c-7fa5-e4be-c9b8-385add4d5320
msgctxt "h7ed8d327gd5fcg46ccg9dcag0359ae1b24cd"
msgid ""
"You're here. Just like it told me. And with a gith - I should have figured."
msgstr "여기 있구나. 그게 알려준 대로야. 기스와 함께 말이지, 진작 알았어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 6afc05f2-ea7e-ae31-29dd-a3474013f32c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:6afc05f2-ea7e-ae31-29dd-a3474013f32c
msgctxt "h7bd28d8dg8710g4d55g8c7ag11e86f72566d"
msgid "But if you're dead... maybe it'll go away."
msgstr "하지만 네가 죽고 나면... 이 속삭임이 사라질지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 6ddd631b-c273-722e-c985-f711fbaf28cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:6ddd631b-c273-722e-c985-f711fbaf28cb
msgctxt "hf79d433ag2a98g4b2egab03g3b09597e72cc"
msgid "You can't kill me just because some 'whispers' told you to."
msgstr "그저 '속삭임'이 그러라고 했다고 날 죽여버릴 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 7dcc819f-ebf3-7c4a-9369-759f35d2e477
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1e628214-dde8-dd7e-d072-c7718e8697a9_SH_SleepPushing_LineSpoken = False
#. SetFlags:
#.   Local:
#.     - 1e628214-dde8-dd7e-d072-c7718e8697a9_SH_SleepPushing_LineSpoken = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:7dcc819f-ebf3-7c4a-9369-759f35d2e477
msgctxt "hf1f6d5a5g84c8g4228gb559gb25248dee96d"
msgid "The whispering won't let me sleep. It keeps pushing me - to you."
msgstr "속삭임 때문에 잠을 잘 수가 없어. 그게 계속 날 네게로 밀어붙이고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Wyll
#. NodeID = 805bd75b-7790-42c0-85cc-eee0dc648bcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_WYLL(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:805bd75b-7790-42c0-85cc-eee0dc648bcb
msgctxt "hb1a84415g63e2g4751gbfb7g0ff140015290"
msgid "Are you feeling all right, miss? Maybe a lie-down's in order..."
msgstr "아가씨, 괜찮은 거야? 누워서 쉬는 게 먼저일 것 같은데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 815d7c16-24d8-8a61-323c-889b57eaa6d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:815d7c16-24d8-8a61-323c-889b57eaa6d7
msgctxt "hea20cc9fgdd18g49f1g8c95g063f94176bb4"
msgid "Don't do anything rash. There has to be an explanation for this."
msgstr "성급한 일을 벌이지 마. 분명 뭔가 설명할 길이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 876525e4-8735-3582-3e5a-ea096586cb3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:876525e4-8735-3582-3e5a-ea096586cb3c
msgctxt "h7bf1ab3dg916fg481fgbc02g1e3a898aef3c"
msgid "Stay. I can stay."
msgstr "머무른다라. 여기 머무를 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 8b54e59a-87fe-f278-8bc9-56edae6a27e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:8b54e59a-87fe-f278-8bc9-56edae6a27e9
msgctxt "h5bdd1cb9g2faag4286ga8aeg7698dd7cf847"
msgid "Bleed for me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 8b752880-555b-6025-8e0b-255156950127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:8b752880-555b-6025-8e0b-255156950127
msgctxt "h4d0532edg31ebg4dbcga6b8g994f79b3792d"
msgid "No. Enough talk. Enough voices."
msgstr "아니. 그만. 목소리는 그만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 8d13a5e2-c85b-632c-d2da-7946b88a4eef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:8d13a5e2-c85b-632c-d2da-7946b88a4eef
msgctxt "h3c9d437ag926ag4cd0gbec2g49acb83803b0"
msgid "Now... now what do I do?"
msgstr "이제... 이제 어떻게 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 906741e7-b88f-0773-0a37-ee387b89810f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:906741e7-b88f-0773-0a37-ee387b89810f
msgctxt "h24330a4ag4932g49e2g9ebdg9cf93bbef94a"
msgid ""
"Quiet! I can't... concentrate with all these voices! Just <i>listen</i>."
msgstr "조용히 해! 이... 목소리들 때문에 집중할 수가 없어! 그냥 <i>들어봐</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 978b13e5-750a-4437-d6b4-be0e78409176
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:978b13e5-750a-4437-d6b4-be0e78409176
msgctxt "h227e7b01g0dedg4175g845dg5653c7e1c575"
msgid "I can't see anything else! I can't shake it."
msgstr "다른 걸 볼 수가 없어! 떨쳐낼 수가 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 982d8fd6-b3d1-618f-db45-222d025f2ac0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:982d8fd6-b3d1-618f-db45-222d025f2ac0
msgctxt "hce42ab63gcc90g4f10ga0dag2fd6fe0181a9"
msgid "<i>Say nothing and watch the intruder closely.</i>"
msgstr "<i>아무 말도 하지 않고 침입자를 자세히 지켜본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 98b3877d-7412-ec3b-96f2-8f283883462b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:98b3877d-7412-ec3b-96f2-8f283883462b
msgctxt "hc43da2b6gae05g47deg8af0g6800ea5ca69a"
msgid "Get out of my head! <i>All of you!</i>"
msgstr "내 머릿속에서 나가! <i>너희 모두!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 9ac39ae6-dd63-7df1-2b70-8a974c4413a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:9ac39ae6-dd63-7df1-2b70-8a974c4413a4
msgctxt "h3a659ca1g514bg44d3g98c9gd35b3eb7584c"
msgid "What else do I do? My head is splitting open. I can't leave. I can't!"
msgstr "내가 달리 뭘 수 있어? 내 머리가 갈라지기 직전이라고. 떠날 순 없어. 그럴 순 없다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Lae'zel
#. NodeID = 9c4f78b8-06d5-3b13-3511-3398ff0ac9a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:9c4f78b8-06d5-3b13-3511-3398ff0ac9a4
msgctxt "h3109256dg4f09g4367g8e08g83d4a3cb063f"
msgid "The ravings of a lunatic. Strike her down."
msgstr "광인의 헛소리군. 그녀를 쓰러뜨려."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = 9d167008-25d7-3069-be4e-cc5d37534d42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:9d167008-25d7-3069-be4e-cc5d37534d42
msgctxt "hf83e94b4g0196g4fc3g8648gad4aa60ec425"
msgid ""
"I keep thinking about the knife going deep. It's the only thing they want me "
"to see."
msgstr "계속 칼이 파고드는 생각이 들어. 그들이 내게 보여주길 원하는 건 그것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = 9fca837f-c2ca-a283-8848-8bf2f8115f38
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:9fca837f-c2ca-a283-8848-8bf2f8115f38
msgctxt "h0d98b0f5ge2f0g4c3bg82d7g51e967fa6f19"
msgid "Threaten me again, and it'll be the last thing you do."
msgstr "날 다시 위협하면, 그게 네 마지막이 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = a0616acb-c73c-c54f-b38b-22d08c647592
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:a0616acb-c73c-c54f-b38b-22d08c647592
msgctxt "hf8ef72d4gb971g4f0agaaa9gaef18830931d"
msgid "I'm tired of being <i>pushed.</i>"
msgstr "압박 받는 건 질렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = a794f4e1-1878-9dbd-c389-6493365ca09d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_CM_Ultimatum_MindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:a794f4e1-1878-9dbd-c389-6493365ca09d
msgctxt "h78ce4e69g1af3g400aga394g538336a64cb9"
msgid ""
"You're not yourself - something's interfering with your thoughts. I can feel "
"it."
msgstr "넌 지금 네 자신이 아니야, 뭔가 네 정신에 관여하고 있어. 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Gale
#. NodeID = aa9460bc-8311-e6f4-d141-c8039d20489a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_GALE(5) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:aa9460bc-8311-e6f4-d141-c8039d20489a
msgctxt "h9c98d4f5ga8dfg452bgb17fg9b9375c17fde"
msgid "She needs sleep. And she needs to be closely guarded."
msgstr "그녀는 수면이 필요해. 그리고 가까이서 지켜봐야 할 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = aaac78e4-34cf-41db-4eb6-d38096c8c99d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:aaac78e4-34cf-41db-4eb6-d38096c8c99d
msgctxt "h2f27a563g165bg4d29gbf55g48a1b53a7f47"
msgid "You're exhausted - not thinking straight. You need to rest."
msgstr "넌 지친 거야, 그래서 제대로 생각하지를 못하고 있군. 휴식을 좀 취해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = b15503b6-75b0-34e3-9d6d-a6d3008e2918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:b15503b6-75b0-34e3-9d6d-a6d3008e2918
msgctxt "hededa973gf86ag494cgb532g30d7114048b4"
msgid ""
"No questions! I can't... concentrate with all these voices! Just "
"<i>listen</i>."
msgstr "질문은 하지 마! 난... 머릿속의 목소리들 때문에 집중할 수가 없어! 그냥, <i>들어봐</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = b31ba055-d1d6-74cb-202d-5e062fc44ea9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:b31ba055-d1d6-74cb-202d-5e062fc44ea9
msgctxt "h47bd7e63gb1d6g4b93ga13fgf9c2c8ae7db9"
msgid "Maybe you're right. But the whispers won't stop."
msgstr "네가 맞을지도 모르지. 하지만 속삭임이 멈추질 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = b5bbd4c6-45f0-75f3-3350-7ac681c75be4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:b5bbd4c6-45f0-75f3-3350-7ac681c75be4
msgctxt "hcb8fb34eg1ddag448egb2ebged28109a298e"
msgid "Slow down - what whispering?"
msgstr "진정해 - 무슨 속삭임에 대해서 말하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = baeb8c09-ab33-56e0-77ff-ab5ce5073071
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_ShadowHeart_HasMet = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:baeb8c09-ab33-56e0-77ff-ab5ce5073071
msgctxt "hcd90a785g5083g4389gabd3g485862de2269"
msgid ""
"You know who I am - you saw inside my head. <i>Shadowheart</i>. We were on "
"the ship together."
msgstr "너도 내가 누군지 알잖아, 내 머릿속을 들여다 봤으니. <i>섀도하트</i>. 우린 그 함선에 함께 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Astarion
#. NodeID = c20c3eb7-63e9-655a-d1e4-2f4de70907a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:c20c3eb7-63e9-655a-d1e4-2f4de70907a6
msgctxt "h0a972525gfc99g48dcgb8edgadbd9f45d0f4"
msgid "It sounds like death would be a mercy. Let's deliver it."
msgstr "들어보니, 죽음이 자비로운 길이겠네. 그걸 선사해 주자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Astarion
#. NodeID = c29e8e62-d76d-9686-3665-ce11d991acec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:c29e8e62-d76d-9686-3665-ce11d991acec
msgctxt "h54a6cfa4g557fg416fg8f9dg98bc9423e32f"
msgid ""
"Some day that soft heart of yours is going to be torn out of your chest."
msgstr "언젠가 네 그 부드러운 심장이 가슴에서 뜯겨질 날이 올 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = c3355207-564d-8721-bd44-e60d43a9e178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:c3355207-564d-8721-bd44-e60d43a9e178
msgctxt "h6a85ba50g09c9g44d2ga9ddg7abf580f0e0b"
msgid "You can certainly try."
msgstr "시도해 보는 건 자유야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Wyll
#. NodeID = c48e835b-b3b3-b19d-3752-761c14625806
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_WYLL(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:c48e835b-b3b3-b19d-3752-761c14625806
msgctxt "h3c4a24a0g35f8g47e0ga56dgf124a480354d"
msgid "Whispering? Her brain's been bugged too."
msgstr "속삭임이라고? 그녀의 머릿속에도 벌레가 있나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = c490ac9f-b80a-df24-4695-3b9aca99c92b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = False
#.   Local:
#.      - 1e628214-dde8-dd7e-d072-c7718e8697a9_ShadowheartUltimatum_WhoIsShe = False
#. SetFlags:
#.   Local:
#.     - 1e628214-dde8-dd7e-d072-c7718e8697a9_ShadowheartUltimatum_WhoIsShe = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:c490ac9f-b80a-df24-4695-3b9aca99c92b
msgctxt "h6c6cce0aga11cg46acg8f57g7791b558628b"
msgid "Hold up - who are you?"
msgstr "잠깐, 넌 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = c6287406-ca3e-66e3-a751-edafe9edd484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:c6287406-ca3e-66e3-a751-edafe9edd484
msgctxt "ha0aca5fcg26eag45a7gad62gf8f93ba13014"
msgid "Even when I'm awake, I dream. There's blood, there's so much blood."
msgstr "눈을 뜨고 있을 때도, 꿈을 꿔. 피가 보여, 너무나 많은 피가."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = cb01de24-78b1-de16-9111-6ff806738019
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:cb01de24-78b1-de16-9111-6ff806738019
msgctxt "h9c6fe611g8d24g46d7g8791g7d6c174b72c9"
msgid "The whispers won't let me sleep. They keep pushing me - to you."
msgstr "속삭임 때문에 잠을 잘 수가 없어. 그것들이 계속 날 네게로 밀어내고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = ce5a7d5a-beb6-18f7-f0ee-536c8f6035ae
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:ce5a7d5a-beb6-18f7-f0ee-536c8f6035ae
msgctxt "h21f32e6cg188cg450dga14bg2fa7f53e6800"
msgid "Hurting me won't help you. Put down the blade."
msgstr "날 해친다고 네 문제가 해결되진 않아. 그 칼날을 내려놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = d567a6cf-ac18-cfdb-8995-c378b334565e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:d567a6cf-ac18-cfdb-8995-c378b334565e
msgctxt "he8ca9f5agd832g4911ga9a4g552d88497afe"
msgid "<i>Stare her down.</i>"
msgstr "<i>그녀를 응시한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = d6328719-2a2c-2693-b0d9-48aefc4bd030
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_HasMet = False
#.   Local:
#.      - 1e628214-dde8-dd7e-d072-c7718e8697a9_ShadowheartUltimatum_WhoIsShe = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:d6328719-2a2c-2693-b0d9-48aefc4bd030
msgctxt "hf03b6131g797eg46bega1d1ge3e6acd05ba7"
msgid "I said who are you? Tell me right now."
msgstr "네가 누구냐고 물었잖아? 당장 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = d83fad3e-d749-deed-aa40-79704ffe319b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:d83fad3e-d749-deed-aa40-79704ffe319b
msgctxt "h2a6bfcd5g8d2fg4d37g8ab5g78601a000f8c"
msgid "You're not dealing with anyone. You're leaving - now."
msgstr "널 상대해줄 사람은 없어. 지금 당장 떠나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = d926c94d-7f7b-7caf-178d-3cf44013d1b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:d926c94d-7f7b-7caf-178d-3cf44013d1b9
msgctxt "h3fc73f00g31f5g4fedg8e9eg5ef373d4d4fd"
msgid "Keep your hands away from that blade."
msgstr "그 칼에서 손때."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = d9402272-206a-276b-82b8-9cd976ea8286
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:d9402272-206a-276b-82b8-9cd976ea8286
msgctxt "h9b1a1046gaabfg4d97ga6fcge25100279ced"
msgid ""
"The whispering's already quieter here. Once you're dead, it'll be gone "
"entirely."
msgstr "이곳에 온 것 만으로 속삭임이 줄어들었어. 네가 죽고 나면, 완전히 사라지겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = dc37ef53-d86d-03c4-3a82-0c1616945c98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:dc37ef53-d86d-03c4-3a82-0c1616945c98
msgctxt "h79bc0ed5g987bg49a7ga3d9gbff7ca1a2879"
msgid "And I think they'll stop once I deal with you."
msgstr "그리고 널 해치우고 나면 멈추겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = dcf7e95f-7d6d-0d50-a78b-17040bde31c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:dcf7e95f-7d6d-0d50-a78b-17040bde31c8
msgctxt "h49e1535eg786bg4f98g8166g737fb634b959"
msgid "Liar. <i>Liar.</i> Liar!"
msgstr "거짓말. <i>거짓말.</i> 거짓말!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = ddd10661-91e3-5461-3154-d696006cae35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:ddd10661-91e3-5461-3154-d696006cae35
msgctxt "h8e10222bgd497g4595g99a5g91d5f8045f11"
msgid "No. I'm where I need to be."
msgstr "아니. 난 내가 있어야 할 곳에 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = e32ab7e5-bc98-cc7e-8898-91b2d6cbe360
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:e32ab7e5-bc98-cc7e-8898-91b2d6cbe360
msgctxt "h20048de7g1c13g4e33gbc20g5ec03f67fad8"
msgid "There we go. Clean and deep."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = e78a9946-10f1-8e44-890a-de2bfe1984fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:e78a9946-10f1-8e44-890a-de2bfe1984fe
msgctxt "ha57ac191g4cf4g4ec5ga545gc8d5adf68c1d"
msgid "I don't want explanations. I want sleep."
msgstr "난 설명이 필요한 게 아니야. 수면이 필요하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = ec6dead7-24f4-b79e-4540-d079512238a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:ec6dead7-24f4-b79e-4540-d079512238a7
msgctxt "h69cb01c3g2863g4935g8002g0f76904734e4"
msgid "It took me so long to find you."
msgstr "널 찾는 데 아주 오랜 시간이 걸렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Shadowheart
#. NodeID = f397e376-fa1c-e35e-ea60-edce407f2e48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:f397e376-fa1c-e35e-ea60-edce407f2e48
msgctxt "hccd646a9g1972g4f89gbaadgd17099450989"
msgid "I <i>can't</i>."
msgstr "그럴 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Lae'zel
#. NodeID = f9bb3cd8-24b6-c296-841c-db6fec135025
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:f9bb3cd8-24b6-c296-841c-db6fec135025
msgctxt "h2a85cd55gb187g4ee6gacbcg024ccdd69b82"
msgid "I am surrounded by <i>madness.</i>"
msgstr "난 <i>광기에 휩싸였어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Narrator
#. NodeID = fa98f82c-7481-7450-e657-e5f8a5f458ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_CM_Ultimatum_MindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:fa98f82c-7481-7450-e657-e5f8a5f458ac
msgctxt "hdb22dc77gf224g437fg920dg373b7e0434cd"
msgid "*Not her tadpole - a chorus of harsh, relentless whispers in her head.*"
msgstr "*기생충이 아닙니다. 거칠고 가차 없는 속삭임의 합창이 그녀의 머릿속을 맴돌고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum
#. Speaker = Player
#. NodeID = fb7b9bc4-8b1a-a7c6-91fd-e19d5d891879
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_CM_Ultimatum_MindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_CFM_Ultimatum:fb7b9bc4-8b1a-a7c6-91fd-e19d5d891879
msgctxt "h72155248geff2g48b5g8723ga1f56c3bb923"
msgid "There's something controlling your mind. I can feel it."
msgstr "뭔가 네 정신을 통제하고 있어. 그게 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 004c28a1-50ab-1426-39ea-962ecfcea8f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:004c28a1-50ab-1426-39ea-962ecfcea8f7
msgctxt "hde016b39g0aafg4a32gb94eg25cd0f463d76"
msgid "Nothing. What is this thing?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 02d1bc02-af97-4caa-70b2-ce7755469f78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:02d1bc02-af97-4caa-70b2-ce7755469f78
msgctxt "h43cad035g374cg4e5cg9447g93dba657897c"
msgid "Interesting? The company's the worst part, as I see it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 033ea648-925c-4665-b545-f76e19204cba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:033ea648-925c-4665-b545-f76e19204cba
msgctxt "h4ecd9f68g2c2ag4634gb197g65a194742235"
msgid "Better than I'd have expected, all things considered."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 0433c207-8f33-fdb6-c0e9-125c64d608a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:0433c207-8f33-fdb6-c0e9-125c64d608a4
msgctxt "h2fb282ccg346cg4e34gb064g4213e5841274"
msgid ""
"Then go read a book, or pray to your god of choice - just leave me alone."
msgstr "그럼 가서 독서라도 하지 그래, 아니면 좋아하는 신에게 기도라도 드리던가. 그만 날 좀 내버려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 04a5ac23-14ca-a40d-c7a1-6146b3e6f884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:04a5ac23-14ca-a40d-c7a1-6146b3e6f884
msgctxt "hfed1949ag8c02g49b3g9081g69a3ecc6405d"
msgid "You should get some rest. Things will seem better come morning. I hope."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 0739efb6-57cc-4fb6-3f2a-cee53620f594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:0739efb6-57cc-4fb6-3f2a-cee53620f594
msgctxt "h5ec83fe3g874cg4f6bgbbb2g842d8de59a04"
msgid ""
"Exactly. I'm just waiting for you to get <i>really </i>desperate before "
"naming my price."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 07c52570-0921-9803-1d8f-90c3f2cf7b0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:07c52570-0921-9803-1d8f-90c3f2cf7b0c
msgctxt "hbb107757ga263g423dg835fg8b34a23de442"
msgid ""
"Quite right. On that note, I think I'd like some time alone, if you don't "
"mind. To meditate. We'll talk soon."
msgstr "동의해. 그래서 말인데, 괜찮다면 이제 혼자 좀 있고 싶네. 명상할 시간이거든. 다음에 또 얘기하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 08643589-1027-0b1f-f23f-ffbac258a061
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:08643589-1027-0b1f-f23f-ffbac258a061
msgctxt "h0551f873g8030g4655g90bag23e84e495d21"
msgid ""
"*There are no openings, but for a brief moment, you think you feel something "
"stir within.*"
msgstr "*드나드는 구멍 따윈 보이지 않는데도, 순간 내부에서 무언가 움찔거리는 것이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 0d4f0387-8ed8-3932-04f3-346fc402564a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:0d4f0387-8ed8-3932-04f3-346fc402564a
msgctxt "h6d8ab1abgd11ag4e3bg960fg29c0b17636ee"
msgid "No. Especially not when I have you around."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 0e11a5ec-5c73-ce94-a242-25a9e5337f24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:0e11a5ec-5c73-ce94-a242-25a9e5337f24
msgctxt "h091267f9gd0adg4a87gaeb8ge90331b82786"
msgid "I'm sorry. I can't give you that. Not right now."
msgstr "미안해. 알려줄 수 없어. 지금은 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 0e6c26ee-f1d4-3c60-6f40-fa1e0652642d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:0e6c26ee-f1d4-3c60-6f40-fa1e0652642d
msgctxt "h04776b54ga917g449dg9a26g2fa02e92a251"
msgid ""
"I've told you all I'm going to tell you. Now please don't pry any further, "
"or you might force me to become less polite."
msgstr "너에게 말해줄 만큼은 다 해 줬어. 이제 더 캐묻지 마, 아니면 나도 지금보다는 더 무례해질 수밖에 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 1a96577b-8a09-09ac-795c-61443f5b0f26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:1a96577b-8a09-09ac-795c-61443f5b0f26
msgctxt "h354a6492g9a51g4ae6g9948g01e553852962"
msgid "No need to be so secretive. You can trust me."
msgstr "그렇게 비밀스럽게 굴 필요 없잖아. 난 믿어도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 208d7594-1670-4274-45c5-4fa71bcfd6d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:208d7594-1670-4274-45c5-4fa71bcfd6d3
msgctxt "h9a73d172g5630g4610gbe36g9f33d72af40b"
msgid "Don't change the subject - tell me about the artefact."
msgstr "주제 바꾸지 마. 그 아티팩트에 대해 말하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 2120afd4-b08f-b8d9-4052-3bb0e1b27ba1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:2120afd4-b08f-b8d9-4052-3bb0e1b27ba1
msgctxt "hf5bb379ag3492g4829ga75fga68f422a86b5"
msgid "I do. But I won't. I can't."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 2734d6ef-d085-5c2a-78da-7b758dff5bad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:2734d6ef-d085-5c2a-78da-7b758dff5bad
msgctxt "h5076a2d2g04b8g474bg860eg74d94734e4eb"
msgid "Too much silence is... unsettling."
msgstr "그렇다고 너무 조용하면... 불안한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 28bfca69-ca95-bb18-c4cb-5cbaab9d6c4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:28bfca69-ca95-bb18-c4cb-5cbaab9d6c4f
msgctxt "hd1f118f2g9e91g4b8bga208g8bbd3e275913"
msgid "*The box is inscribed with unfamiliar glyphs.*"
msgstr "*상자에는 알 수 없는 문양들이 새겨져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 2e936827-a3bd-7cbc-0c46-f8288faf926a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:2e936827-a3bd-7cbc-0c46-f8288faf926a
msgctxt "hae0f6e47g87ccg46fbga90eg77a06e8dc4d3"
msgid ""
"I almost let you get away with changing the subject. Tell me about the "
"artefact."
msgstr "화제를 돌리는 솜씨가 기가 막히네. 이제 그 유물에 대해 털어놔 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 31fae93e-1976-5e0d-f5e2-0a6f01721f03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Dialog:
#.     - Shadowheart_Recruitment_Den_AskedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:31fae93e-1976-5e0d-f5e2-0a6f01721f03
msgctxt "h8b9e1d40g515eg4c29ga55cg70c9e10b9a06"
msgid "I could crack open that little thing in one fist, if you want me to."
msgstr "네가 원하면 그 작은 놈을 한주먹에 부숴 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 33df9a52-7f4a-9caa-9ac6-66ef76450364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:33df9a52-7f4a-9caa-9ac6-66ef76450364
msgctxt "hae6cbdcfg6d37g4fc3ga3d9g31047dfe06b1"
msgid "If you don't want to talk anymore, I'll respect that."
msgstr "더 이야기하고 싶지 않다면 알겠어, 존중해 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 37d08cad-3122-f6b9-ebee-4bb9dec3e62f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:37d08cad-3122-f6b9-ebee-4bb9dec3e62f
msgctxt "hddd86e8bg7da4g4e58g9b0cg85367b2ccb77"
msgid "Oh. You don't say that because of the company, I hope?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 39ff73f3-52cb-68ac-1e6d-7c834423646a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:39ff73f3-52cb-68ac-1e6d-7c834423646a
msgctxt "hc45351b4g68f8g4149gaaebg76a7fc299df4"
msgid ""
"Honestly, the parasite frightens me more than anything else we've "
"encountered."
msgstr "솔직히 말해서, 지금까지 마주쳤던 그 어떤 것보다도 이 기생충이 더 두려워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 3aeacd4a-fb68-eca3-f466-87642c9ffa6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:3aeacd4a-fb68-eca3-f466-87642c9ffa6f
msgctxt "h9ba6a77bg9f5eg4d2egbfdcgd4f4a048cb9d"
msgid ""
"Oh stop, you can hardly be that miserable if you have energy for flirting."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 45eec233-3cfd-4f53-cf0d-a80ff21616be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:45eec233-3cfd-4f53-cf0d-a80ff21616be
msgctxt "h3df8c94bg037ag4771g834bg5144b85bea72"
msgid "Good. Now I believe I was asking you how you were this evening?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 4e709117-210c-8554-e692-3230661dda42
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:4e709117-210c-8554-e692-3230661dda42
msgctxt "h47d61053gd080g4a17gb90egeecc88ad7f3f"
msgid ""
"The evening's aesthetics do not matter. Why are you toying with an heirloom "
"of my people?"
msgstr "저녁의 미학을 논하고 싶지는 않은데. 어째서 우리 동족의 보물을 가지고 장난질을 치는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 4e709117-210c-8554-e692-3230661dda42
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:4e709117-210c-8554-e692-3230661dda42
msgctxt "h78e6e902g5cf0g45d0gbfa0g75b8d8fb4eff"
msgid "Why're you so keen to dodge questions about that thing?"
msgstr "왜 그 물건에 대한 질문을 그리 집요하게 회피하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 4ea1df7c-b692-5598-8564-0be2b464c0c4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:4ea1df7c-b692-5598-8564-0be2b464c0c4
msgctxt "ha5c6f092g8164g4cebgba65g029107655716"
msgid "Very well. When you are ready to speak your mind, I shall listen."
msgstr "알겠어. 네가 솔직하게 이야기해 줄 준비가 되면, 그때 듣도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 4ea1df7c-b692-5598-8564-0be2b464c0c4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:4ea1df7c-b692-5598-8564-0be2b464c0c4
msgctxt "h87b04e45g2a36g499ega3d8g57798b4b0ca1"
msgid "All right, I can respect that. But if you want to talk, I'm here."
msgstr "좋아, 충분히 이해해. 하지만 언제라도 얘기하고 싶으면, 내게 오라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 4ee1d5e5-246c-8625-15c5-e6fc7a09b880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:4ee1d5e5-246c-8625-15c5-e6fc7a09b880
msgctxt "hbd8c5fa3g9df7g4744g82b1gbae656c89adc"
msgid "What's the matter?"
msgstr "무슨 일이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 4f2df3e1-4776-f050-9ef3-9528c15421a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = False
#.      - Approval_AtLeast_10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:4f2df3e1-4776-f050-9ef3-9528c15421a9
msgctxt "h0a837206g2621g411dga0ffg9be5e4f1ea50"
msgid ""
"It's nothing, trust me. Interesting choice of camp we have here, isn't it? "
"Peaceful."
msgstr "장담하는데 아무것도 아냐. 참 흥미로운 야영지를 골랐구나, 그치? 평화롭네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 5124f149-f9f9-6862-182a-38655e6196d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - Shadowheart_Recruitment_Den_AskedAboutBox(1) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:5124f149-f9f9-6862-182a-38655e6196d4
msgctxt "hb48978c3g03beg41feg9648gd546ca5052ad"
msgid "My kin's heirlooms should not be in your hands."
msgstr "우리 동포들의 가보를 손에 들고 있다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 51a8333f-cce3-208f-bee9-522b21b3689c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:51a8333f-cce3-208f-bee9-522b21b3689c
msgctxt "h783955adg8591g4b8cg89d8g4800c0f4a0ed"
msgid "I said keep out of it. In fact, forget it entirely."
msgstr "신경 쓰지 말라고 했잖아. 아니, 그냥 아예 잊어버리라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 55c6814f-b51b-54f7-d7b0-38812b8a91fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:55c6814f-b51b-54f7-d7b0-38812b8a91fc
msgctxt "h37d3ec20g45ceg497ega759gc1bb2ce262a4"
msgid "*In an instant, Shadowheart hides the box from view.*"
msgstr "*눈 깜짝할 사이, 섀도하트가 상자를 보이지 않게 숨깁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 5652e3b2-0e24-b90f-ca33-6c4bf9e93b4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:5652e3b2-0e24-b90f-ca33-6c4bf9e93b4b
msgctxt "hb9eded66g5e13g4345g8cafg95a226625ee5"
msgid "I do like the dark. It's peaceful."
msgstr "난 어둠이 좋아. 평화롭거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 5a70cbb7-b8e0-aa05-5cb1-576de9e20e10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:5a70cbb7-b8e0-aa05-5cb1-576de9e20e10
msgctxt "h0d5b0c53g3684g4707gaddegdc0493ae2642"
msgid "Admit it - there's a cure for ceremorphosis in that thing, isn't there?"
msgstr "인정하라고. 그 물건 안에 뇌변이를 치료할 방법이 있지, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 5d434aa0-340a-4da3-d1de-6faef829430d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:5d434aa0-340a-4da3-d1de-6faef829430d
msgctxt "hf95bd477gb9f5g4564gade2g796217a33e9c"
msgid ""
"You can really appreciate the darkness out here in the wilds. Not like in "
"the city, where they keep lamps burning all hours. It's not natural."
msgstr "이곳 야생에서는 어둠을 진정으로 감상할 수 있어. 언제나 등불이 켜져있는 도시와는 다르게. 그건 자연스럽지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 5ec990e4-c0a1-2aed-591c-8e1ceb2037cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:5ec990e4-c0a1-2aed-591c-8e1ceb2037cf
msgctxt "h5d9c2735g190eg4b6fgb171g81f45fabe73e"
msgid ""
"*The box is inscribed with glyphs similar to those used by the githyanki.*"
msgstr "*상자에는 기스양키의 것과 비슷한 문양들이 새겨져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 6046f63c-4201-cdcc-5384-faad61a70903
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - Shadowheart_Recruitment_Den_AskedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:6046f63c-4201-cdcc-5384-faad61a70903
msgctxt "h89146356g1e52g4f64g8b5bgb9e7df9f6c37"
msgid "What is that you have there?"
msgstr "뭘 들고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 6250eaf8-1272-cac5-266c-9229e3c48464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:6250eaf8-1272-cac5-266c-9229e3c48464
msgctxt "h8a97f3fag3957g4e06g8cbfg34e6ec908d70"
msgid ""
"That's not for you to decide. There's a world beyond us. I'd like to be "
"alone now, please."
msgstr "네가 결정한 일이 아냐. 세상엔 우리의 사고를 뛰어넘는 일들도 있다고. 부탁인데 이제 혼자 있고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 6538d171-6fc5-ea81-7c80-6753387b3ebf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:6538d171-6fc5-ea81-7c80-6753387b3ebf
msgctxt "h68a48698g1f6dg439bga25cgd29fe2ab3cb7"
msgid "Don't be so cynical. It won't help us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 6867e8a1-16b2-98e1-00a9-8e0fe46c6312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:6867e8a1-16b2-98e1-00a9-8e0fe46c6312
msgctxt "h2fab78c8g6417g416dga631gb2bb2175d69e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 687d26cf-a574-75f5-c12a-545253e11f7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:687d26cf-a574-75f5-c12a-545253e11f7f
msgctxt "h79df1152g7a18g4299g8f8fg257d6f35d20c"
msgid ""
"To you, perhaps. For me, it's perfect. I think I'll enjoy it by myself for a "
"while, if you don't mind."
msgstr "너한테나 그렇겠지. 나에겐 완벽해. 이제 혼자 남아 즐기고 싶네. 너만 괜찮다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 6bc97122-a153-7701-0459-4fbb07073199
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - ORI_Shadowheart_CaughtTryingMindMeld(1) = False
#. SetFlags:
#.   Dialog:
#.     - ORI_Shadowheart_CaughtTryingMindMeld(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:6bc97122-a153-7701-0459-4fbb07073199
msgctxt "h654441dbg4247g48b9gb582ge958495bc84f"
msgid ""
"I felt that - are you really surprised I won't open up when you try to "
"fumble in my head? Leave me alone."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 6ce780d6-35c6-eced-2013-2d194e7cb885
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:6ce780d6-35c6-eced-2013-2d194e7cb885
msgctxt "hf6ad6da7g966eg4954g9a09g31aac66c8b13"
msgid ""
"*The runes engraved on the black metal mean nothing to you. You keep "
"examining it.*"
msgstr "*어두운 금속에 새겨진 룬은 아무 의미도 없어 보입니다. 당신은 계속해서 조사해 봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 7607e712-d954-6c0b-38a5-6deefcf8cab8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:7607e712-d954-6c0b-38a5-6deefcf8cab8
msgctxt "h6b9d0546g573bg4dedgb1a2g9dec72fae847"
msgid "A poor answer. I expected more openness from you."
msgstr "형편없는 답변이군. 좀 더 솔직한 태도를 기대했건만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 7607e712-d954-6c0b-38a5-6deefcf8cab8
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:7607e712-d954-6c0b-38a5-6deefcf8cab8
msgctxt "h3512aa1ag7d67g418egb065g33ef34bf655d"
msgid "Not much of an answer. I'd hoped for more openness."
msgstr "실망스럽네. 좀 더 솔직한 답변을 기대했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 7783c9dd-710b-4e7d-0ddb-3b5447e3a2a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:7783c9dd-710b-4e7d-0ddb-3b5447e3a2a7
msgctxt "he38e0e9bg1609g4510gb637g3fbf17d3ee5b"
msgid ""
"My, quite charming when you want to be, aren't you? Maybe save some for the "
"next time we have to talk our way past a sentry or the like."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 7bc06ad5-b4fc-8ab5-1e6d-8475b19ccb27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#. SetFlags:
#.   Dialog:
#.     - Shadowheart_Recruitment_Den_AskedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:7bc06ad5-b4fc-8ab5-1e6d-8475b19ccb27
msgctxt "h23caba8dgf43bg4b0bgb40agd5a0e9d669c3"
msgid "Let me try - I always enjoy opening up what I'm not supposed to."
msgstr "이리 줘 봐. 난 항상 들여다보면 안 되는 상자를 들여다보는 걸 즐기거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 7f816456-e593-d6f0-381e-c6c2231bbab1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:7f816456-e593-d6f0-381e-c6c2231bbab1
msgctxt "hb3f5b612geb91g4868g8a67geaa2bfa4a898"
msgid ""
"You can really appreciate the quiet here. Not like in the city, where noise "
"and life scarcely ever falls silent. It's not natural."
msgstr "이곳에서는 온전히 고요함을 느낄 수 있어. 도시와는 다르지. 거긴 소음이 일상이니까. 인위적이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 81552f32-401c-2def-7f13-8b297e957712
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:81552f32-401c-2def-7f13-8b297e957712
msgctxt "h593ef9c3g08cag4339g8261g60606667c5e7"
msgid "The company's the worst part."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 8504a4e5-f475-f6d2-ae88-60f2c4894075
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:8504a4e5-f475-f6d2-ae88-60f2c4894075
msgctxt "h52f16a43gec0eg46c6g8526g87c56891f2c5"
msgid "I do. But I won't. Not yet."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 8939ab38-5665-3283-27d7-14633f441301
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:8939ab38-5665-3283-27d7-14633f441301
msgctxt "h438330f1g0162g4b3dga9fag479c866e3e7d"
msgid ""
"It won't. But I prefer it to just being frightened. I'd like to be alone "
"now, please."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 8bd78f98-00ca-5784-0032-6e4afa844321
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:8bd78f98-00ca-5784-0032-6e4afa844321
msgctxt "h64d620f7g21e1g4249gb677g879db908d0e1"
msgid "I'd like some time alone now. We'll talk soon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 8bf8198d-bf6d-3644-5aa6-1cdf1e55cf08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_0_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:8bf8198d-bf6d-3644-5aa6-1cdf1e55cf08
msgctxt "h29723ab6g4a84g4abcg8d84gf9d1fa041828"
msgid "Keep out of it."
msgstr "물러나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 8c15079a-ac50-d06e-bf57-4ff08d6dee9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:8c15079a-ac50-d06e-bf57-4ff08d6dee9a
msgctxt "hc40e491dg1080g4f1bg8f17g02ce2453c968"
msgid "Speak plainly. What are you doing with a gith artefact?"
msgstr "솔직히 털어놔. 기스 놈들 아티팩트로 뭘 하려는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 8d1b99da-b0ab-b674-668e-5741674953bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:8d1b99da-b0ab-b674-668e-5741674953bc
msgctxt "h093b43adg2b2cg47a0g8ae6g9c90ce1dccaf"
msgid "Nothing like a little calm and quiet after all we've been through."
msgstr "이 모든 일이 지나가고 나면 고요함과 차분함을 되찾고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 8ed37c3c-8690-450c-664e-2774b46edf62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:8ed37c3c-8690-450c-664e-2774b46edf62
msgctxt "hc46896d1g027bg45e5ga7b8g7159282586ba"
msgid ""
"Honestly? Miserable. I'd rather spend the night just about anywhere else but "
"here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 90f8fbe0-761c-40dc-b54f-55d9819ca6fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:90f8fbe0-761c-40dc-b54f-55d9819ca6fb
msgctxt "h3d6986d2g05e2g42dfgb947gd349eecf5263"
msgid "Hmm. In that case, let me spare you the worst. Good night."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 92aaa3fb-e342-b6c1-f0c6-4f7332cb826a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_SeenWithBox = True
#. TagRule: !REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:92aaa3fb-e342-b6c1-f0c6-4f7332cb826a
msgctxt "he3b17179g6989g42aag9f43g44596c5ee56e"
msgid ""
"*Shadowheart's attention is consumed by a strange box that she turns over in "
"her hands.*"
msgstr "*섀도하트가 이상한 상자를 손에 든 채 온 신경을 집중하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 930949dc-3537-4e68-0a95-b57c72688105
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - ORI_COM_ShadowHeart.SawBox(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:930949dc-3537-4e68-0a95-b57c72688105
msgctxt "h889a8c0dg26d5g405cga046g050f3298fee4"
msgid "Damn thing... it has to open, surely. It has to do <i>something</i>."
msgstr "망할 물건 같으니... 분명 열 방법이 있을 텐데. 뭔가 기능이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 9b352880-c5a5-0d6f-ab65-ba426b8dcbe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9b352880-c5a5-0d6f-ab65-ba426b8dcbe1
msgctxt "hf25e647fg20d4g4632gb0cfgfa97054e81ac"
msgid ""
"To some, perhaps. But I'll enjoy the dark while I can. Alone, if you don't "
"mind."
msgstr "누군가에겐, 어쩌면. 하지만 난 어둠을 즐길 수 있을 때 즐길 거야. 괜찮다면 나 혼자서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 9b69394d-2983-bdbf-3353-33b575e8fe8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9b69394d-2983-bdbf-3353-33b575e8fe8d
msgctxt "hc6202162g10aeg413dg88f7gba6a27401be2"
msgid "I suppose you're right - I'm glad I met you, for one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 9c38e111-c095-0620-a214-9a9ea422a085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9c38e111-c095-0620-a214-9a9ea422a085
msgctxt "h8b7c6107gecf4g4ee2gbc58gf654ea86f276"
msgid "No harm in brightening up the gloom. It's comforting, safe."
msgstr "어둠을 밝히는 건 나쁜 일이 아니야. 편안하고 안전한 기분을 주잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 9ccd576b-ac64-be09-92d2-ba5b32e627fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9ccd576b-ac64-be09-92d2-ba5b32e627fe
msgctxt "hb7d239eage942g4c0cg9215gcc05b130cf08"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 9d26a606-68a9-4d9f-c96d-72ac901e8d52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9d26a606-68a9-4d9f-c96d-72ac901e8d52
msgctxt "hd3731668gc5f3g4003ga490g4e63724efb28"
msgid "A bold statement, if not an accurate one. Leave me be."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = 9d4610d9-c318-c2d0-997a-1bea2ab557f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9d4610d9-c318-c2d0-997a-1bea2ab557f8
msgctxt "h69f2f108gb6eeg4356gb060g69e31abe24d0"
msgid ""
"I wish that was true. But I've seen plenty of blood spilled for just those "
"kinds of things. The world will keep on scheming, no matter what happens to "
"us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 9e4cffcf-eeb2-d216-0aa3-565ba7adebc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9e4cffcf-eeb2-d216-0aa3-565ba7adebc6
msgctxt "h4f5cea6cgaa08g48a0gaaa2gf42a750662c9"
msgid ""
"*You feel Shadowheart's deep protectiveness of the artefact. Though she "
"doesn't understand it, she believes that her fate is entwined with it "
"somehow.*"
msgstr ""
"*섀도하트가 아티팩트를 보호하려는 깊은 감정이 느껴집니다. 그녀가 이해하진 못하지만, 자신과 아티팩트의 운명이 어떻게든 뒤얽혀 있다고 "
"믿고 있습니다.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = 9f60bf9b-ca64-9785-0d19-5a23679305ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_SeenWithBox = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9f60bf9b-ca64-9785-0d19-5a23679305ec
msgctxt "hdfe16cf8g9003g4473g99aeg397e15c2cda2"
msgid ""
"*Shadowheart's attention is consumed by a strange box that she turns over in "
"her hands.*"
msgstr "*섀도하트가 이상한 상자를 손에 든 채 온 신경을 집중하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = 9f63ed80-d5eb-4168-72e7-3fe9b15fc440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:9f63ed80-d5eb-4168-72e7-3fe9b15fc440
msgctxt "h9fbf7f7eg1462g44b7g8a69g02d62d4c4d3f"
msgid "I suppose it is."
msgstr "그런 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = a11e9e07-88a1-736b-96db-ebe8ce736b28
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:a11e9e07-88a1-736b-96db-ebe8ce736b28
msgctxt "hf2678462g7adcg4653g853dg2d65fa89c7b1"
msgid "*It bears engravings resembling githyanki scripture.*"
msgstr "*그 상자는 기스양키 경전과 유사한 조각을 지니고 있군.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = aaf34665-4264-d3a9-cb08-4427d4da3325
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:aaf34665-4264-d3a9-cb08-4427d4da3325
msgctxt "h05561c26g39c8g4301gb3d0g45dd1fdcdac8"
msgid ""
"We should get some rest. I doubt tomorrow will be any easier than today."
msgstr "우리 모두 좀 쉬어야 할 거야. 내일이 오늘보다 덜 힘든 날이 될 거라고는 생각되지 않거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = ac18221e-b6d1-b3d9-0c91-8c58b8f3c41c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:ac18221e-b6d1-b3d9-0c91-8c58b8f3c41c
msgctxt "h74bb7b42g667ag44c7gab5age3b3e518d8c7"
msgid ""
"*You discreetly take the box from where you'd hidden it and turn it over in "
"your hands.*"
msgstr "*당신은 숨겨 두었던 상자를 꺼내 들고, 조심스럽게 뒤집어 봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = ac260b2d-8b07-5fb7-2f14-b720ad82fa17
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:ac260b2d-8b07-5fb7-2f14-b720ad82fa17
msgctxt "he5a66b7dgea70g47c5ga51fgfc06e059cca9"
msgid "<i>Use the parasite - see what she's hiding.</i>"
msgstr "<i>기생충을 이용해 그녀가 뭘 숨기고 있는지 알아본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = b1efea8b-739b-08a9-bd3d-c878a0997039
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:b1efea8b-739b-08a9-bd3d-c878a0997039
msgctxt "h61040be5g4cb3g46e1ga6fegbd5ae173841c"
msgid "Tired. Good night."
msgstr "피곤하네. 잘 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = b405c57f-dd70-5dda-0ee0-45ddfb7bf6bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:b405c57f-dd70-5dda-0ee0-45ddfb7bf6bf
msgctxt "he6c93cf0g1974g4335g8ba4g995ecf227c2c"
msgid "I'm being interrupted, that's what. We can talk later."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = bc230599-49b7-ac1b-867e-5e6177bd7ad9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_0_For_Sp2(0) = True
#.      - Approval_AtLeast_10_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:bc230599-49b7-ac1b-867e-5e6177bd7ad9
msgctxt "h2d7fabcagbc3eg49dagbe6fg8f748626bcc4"
msgid "Never mind. Private matter, that's all."
msgstr "신경 쓰지 마. 개인적인 문제일 뿐이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = bf575246-3411-1d7f-abf1-d323dee09551
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:bf575246-3411-1d7f-abf1-d323dee09551
msgctxt "h60ce6197g84bag4509gb851ga227b9b13684"
msgid ""
"Remember, our fates are entwined now. Relics and secrets don't matter with "
"what we're facing."
msgstr "잊었나 본데, 우리 운명은 지금 복잡하게 얽혀 있어. 우리가 처한 상황에 비하면 유물과 비밀 따위는 중요하지 않다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Narrator
#. NodeID = bff3a720-15a1-0bef-53c7-1a8ebe8ee8c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:bff3a720-15a1-0bef-53c7-1a8ebe8ee8c8
msgctxt "ha68abafagf3cag4902g9a28gadaeb0ea207f"
msgid ""
"*You tuck it away again. Your duty is to deliver it - not understand it.*"
msgstr "*당신은 상자를 도로 집어넣습니다. 당신의 임무는 그것을 이해하는 것이 아니라 전달하는 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = c1d7283f-cfe3-0372-3456-caf5e047c345
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:c1d7283f-cfe3-0372-3456-caf5e047c345
msgctxt "hab2416ffgae37g46f6g8fbag1398be8f20ed"
msgid ""
"The company's fine. It's the constant danger and thought of becoming a "
"monster that bothers me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = c4a6ff8d-41ca-a7f1-4c9b-349d6c7e2cb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:c4a6ff8d-41ca-a7f1-4c9b-349d6c7e2cb2
msgctxt "h39f5534cge5b9g4653gbd9agd4bd65affd88"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = d1207de4-ce46-c7cc-c61f-e214a99068d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:d1207de4-ce46-c7cc-c61f-e214a99068d3
msgctxt "h9abcc607ge1d9g455bg8165g35ed4014b4f8"
msgid "Keep focused. Whatever that thing is, it's not important."
msgstr "정신 차려. 상자의 정체가 무엇이든, 그건 별로 중요한 문제가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = d6610bc7-1809-f417-1630-f40e678856ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:d6610bc7-1809-f417-1630-f40e678856ce
msgctxt "ha74ff34fg6e12g42afgb1d1g39c73844ae28"
msgid "I can't promise that'll be any time soon, but thank you, all the same."
msgstr "언제가 될지 장담할 순 없지만, 그래도 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = d6aeb8ee-bd4d-b97f-a514-6ac3f2ac91b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#.      - Approval_AtLeast_10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:d6aeb8ee-bd4d-b97f-a514-6ac3f2ac91b7
msgctxt "hc9ed5bceg5c2eg403egb851g49f72381bf6f"
msgid "It's nothing, trust me. Beautiful evening, isn't it?"
msgstr "장담하는데 아무것도 아냐. 근사한 저녁이네, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = d753e8f0-0004-f1ac-c7b7-5962d450e036
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - Shadowheart_Recruitment_Den_AskedAboutBox(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:d753e8f0-0004-f1ac-c7b7-5962d450e036
msgctxt "hb2477750g83a6g4cd8g8639gc4ceaa452cb8"
msgid "A githyanki artefact. How did you come by that?"
msgstr "기스양키 아티팩트잖아. 어떻게 이걸 손에 넣은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = d9913dae-6040-f0b1-5ad3-57e0a9304bc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:d9913dae-6040-f0b1-5ad3-57e0a9304bc7
msgctxt "hc68a7fafg09e5g4ddcg95b3gbc503cd96a47"
msgid "For someone so secretive, you really seem like you want to open up."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = e86526aa-ed44-ec77-5250-78a93a45bc9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:e86526aa-ed44-ec77-5250-78a93a45bc9d
msgctxt "h85595ba2ge890g48b1gb71bgda55d19b1929"
msgid "Not good enough. I want answers."
msgstr "그걸론 부족해. 해명이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = e8fcc1cb-b98b-3467-5f8d-7aa851af46d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:e8fcc1cb-b98b-3467-5f8d-7aa851af46d8
msgctxt "he18f94e8gbbbbg4ce4ga63cg4c70ddd54213"
msgid ""
"I know how you feel, trust me. But there's not much we can do until morning."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = eafd2c07-eadb-49be-be6d-0393395aadf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:eafd2c07-eadb-49be-be6d-0393395aadf0
msgctxt "h00532aeagb21cg4ad6gbc66gc928fa0f0dd7"
msgid ""
"The nomad's life has its charms. You get to meet such interesting people - "
"and sometimes they don't even try to kill you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = ef931419-4b8f-74f3-6e4a-b339ea9d8c0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - ORI_Shadowheart_CaughtTryingMindMeld(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:ef931419-4b8f-74f3-6e4a-b339ea9d8c0d
msgctxt "h6663fe19g19fag4de2gaac6g31de47497e45"
msgid ""
"I felt that - are you really surprised I won't open up when you keep trying "
"to fumble in my head? Leave me alone."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = ef99644d-e54e-eb1d-2317-75ff5e8f8d4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:ef99644d-e54e-eb1d-2317-75ff5e8f8d4b
msgctxt "h840c5e28gdf73g4cd1gad6agb7703d288a08"
msgid "Now, how're you faring this evening?"
msgstr "자, 오늘 저녁은 좀 어떤 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = f3bf57ad-1da4-5d7e-bc62-0d8eb6f31b5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_-10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:f3bf57ad-1da4-5d7e-bc62-0d8eb6f31b5d
msgctxt "h4a510777g8264g4b78gbb7fgb060ec25a562"
msgid ""
"Our mutual... <i>respect </i>only entitles you to so much. Now, if you don't "
"mind."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Player
#. NodeID = f4c5e78a-3ae5-abdb-944e-a7de1dcc638c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:f4c5e78a-3ae5-abdb-944e-a7de1dcc638c
msgctxt "hec8077edg36ddg4d70ga7d9g4d7911f262ec"
msgid "All right, as you like."
msgstr "알겠어, 그렇게 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = f5400c7e-1b2c-71de-b429-77ab88deae99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:f5400c7e-1b2c-71de-b429-77ab88deae99
msgctxt "hf2ce45aag40feg4576gbcffg1af2f254cd8b"
msgid "You deserve honesty more than most... but please, don't ask."
msgstr "너라면 진실을 들을 자격이 있지... 그치만 부탁할게. 묻지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = ff5cc7e1-336f-85ed-9b25-3cbee2e0bea4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:ff5cc7e1-336f-85ed-9b25-3cbee2e0bea4
msgctxt "h7e834aecg306ag4955g91f4g864e101655d1"
msgid "Thank you. We can talk again soon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box
#. Speaker = Shadowheart
#. NodeID = ff7b926a-8b28-90c8-4565-02c2d04eb84d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#. SetFlags:
#.   Quest:
#.     - ORI_COM_ShadowHeart.SawBox(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_Box:ff7b926a-8b28-90c8-4565-02c2d04eb84d
msgctxt "h56414fdag0ae6g4ebagb8d5g02f8f528f3e1"
msgid "Damn thing... it has to open, surely. It has to do <i>something</i>."
msgstr "망할 물건 같으니... 분명 열 방법이 있을 텐데. 뭔가 기능이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 00c574ee-3100-61ad-0ef3-64f397c43b3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:00c574ee-3100-61ad-0ef3-64f397c43b3e
msgctxt "h6957efa0g02a7g4faeg8aa1g790d9034068f"
msgid "She carries an heirloom of our people. She must explain herself."
msgstr "그녀는 우리 동족의 보물을 가지고 있어. 좋은 설명이 필요할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 033f593f-ad97-fbb9-84e1-91d6ee3a5bbb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_InfernalBox_State_LaezelKnows = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:033f593f-ad97-fbb9-84e1-91d6ee3a5bbb
msgctxt "hf58e663fg1d0fg4d34g8753g657dede2679a"
msgid "You carry a githyanki relic. I will have an explanation - or your head."
msgstr "기스양키 유물을 가지고 다니는군. 좋은 설명이 필요할 거다, 아니면 목이 달아날 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 06c6b1d9-ae7e-95ac-7a32-43d3f2a654fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:06c6b1d9-ae7e-95ac-7a32-43d3f2a654fa
#, fuzzy
msgctxt "h0d2ae057gc247g4b16g94e5g9a05b4fec077"
msgid ""
"But there will come a time when I must attend to the artefact's occupant. "
"You'd be a fool to intervene."
msgstr "하지만 아티팩트의 소유자가 문제가 될 때가 올 것이다. 그때는 방해하지 않았으면 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 09860081-5460-e50d-b035-f3bc563c5672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:09860081-5460-e50d-b035-f3bc563c5672
msgctxt "h4bd248fdgdbd9g4d7dga53fg573021da2f65"
msgid "Keep it. Do what you will with it."
msgstr "갖고 있어라. 그걸로 할 일을 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 0a161350-d2be-9b9c-4919-3305b7f88b6c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:0a161350-d2be-9b9c-4919-3305b7f88b6c
msgctxt "h071125f8gdc6eg4312g93f4g345ed228f7cc"
msgid ""
"Your petty quarrels disturbed my rest. Stop at once, or I will <i>make </"
"i>you stop."
msgstr "네놈들의 하찮은 다툼이 내 휴식을 방해했다. 당장 그만둬, 아니면 그만두게 <i>만들어</i>주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 0b12b818-a0de-1fab-d1d8-51843b387734
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:0b12b818-a0de-1fab-d1d8-51843b387734
msgctxt "hecbb52f2g561fg40e5ga784g400cfdd49cbd"
msgid ""
"I'll kill you if necessary. But explaining your corpse would be a chore."
msgstr "필요하다면 죽이겠어. 하지만 네 시체를 설명하기 귀찮겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 0b8b817e-065a-5ffa-ac48-ebda42abd4ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:0b8b817e-065a-5ffa-ac48-ebda42abd4ea
msgctxt "hd4196b9eg7347g4ab0g871eg1227f6e68d01"
msgid "Get some rest, Lae'zel - you'll need it."
msgstr "잠 좀 자둬, 레이젤. 휴식이 필요할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 0e35caa4-94c5-2641-fbe0-6e47265ac83b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:0e35caa4-94c5-2641-fbe0-6e47265ac83b
msgctxt "ha622de5dga290g4ab7gb48eg64914c405679"
msgid "Good. This little venture would be duller without you, I'll admit."
msgstr "좋아. 인정하겠어, 너 없이 이 작은 모험은 더 지루했을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 102d7339-ae9b-9fe4-b62e-644a27518adc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:102d7339-ae9b-9fe4-b62e-644a27518adc
msgctxt "h77c69f72g47b6g4514gb51fgabeb8defc460"
msgid "The gith you took this from will hunt you down and kill you. Slowly."
msgstr "네가 이 물건을 뺏은 기스는 널 추적해 죽이겠지. 천천히."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 10ba9cd1-b7e1-c5b5-72c6-8f3d72b1505d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:10ba9cd1-b7e1-c5b5-72c6-8f3d72b1505d
msgctxt "h7a0fe308gf689g46e9gb88bgce5dd7a056c8"
msgid ""
"My Creed forbids such weakness. Explain yourself - and <i>then</i> try to "
"kill me."
msgstr "우리 신조는 그런 약점을 용납하지 않는다. 설명해라. <i>그 뒤에</i> 날 죽여라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 11599c36-e4a1-0ef8-6c72-013dec8f9dc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:11599c36-e4a1-0ef8-6c72-013dec8f9dc3
msgctxt "he342f86dga91cg456eg8d3agc4786db21261"
msgid "No others. Just you and me."
msgstr "'우리'가 아니야. 단지 너와 나지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 13bab06c-5cfc-d948-646d-d102cadafb73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:13bab06c-5cfc-d948-646d-d102cadafb73
msgctxt "hc0f2583eg9f29g4045g9751g94f353935c72"
msgid ""
"Fine. You can accept you're wrong, or we'll be rid of you permanently. "
"Either way, I win."
msgstr "좋아. 네가 틀렸다는 사실을 받아들이거나, 앞으로 영영 볼 일 없게 되겠네. 어느 쪽이든 이득이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 13fb96cd-d62f-2b0f-83c0-2e15016999d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:13fb96cd-d62f-2b0f-83c0-2e15016999d6
msgctxt "hf47ad9e0g4b86g4da0g9853gc3c176b1eb5a"
msgid ""
"The artefact you possess contains someone important - someone my queen "
"demands to be slain."
msgstr "네가 갖고 있는 아티팩트는 중요한 누군가를 담고 있다. 여왕께서 죽기를 원하시는 자다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 16b2f776-9c0b-d44a-757d-f4f0044d585a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:16b2f776-9c0b-d44a-757d-f4f0044d585a
#, fuzzy
msgctxt "h52cf2498g447cg4361g9500g1ed8b720724d"
msgid "She is deluded - as are you, should you show her your allegiance."
msgstr "오해하는 거야. 너도 레이젤 편을 들지 않는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 183f7747-72a4-63c0-f8bf-93717bd66399
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:183f7747-72a4-63c0-f8bf-93717bd66399
msgctxt "hac352c2ag8266g4e73g90b7geaaa1073908e"
msgid ""
"But beware. My kin undoubtedly hunt you. If caught, your death will be slow, "
"exquisite."
msgstr "허나 조심해라. 내 동족은 틀림없이 널 사냥할 테니. 만약 잡히면, 섬세하고 느린 죽음을 맞겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 19ec7451-4770-0e6e-c74a-526e7f4a0959
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:19ec7451-4770-0e6e-c74a-526e7f4a0959
msgctxt "hdc200d8egc1cfg4e16gb45dg7a4a4e3a29d0"
msgid "Now why would you ask me a question like that?"
msgstr "왜 하필 지금 그런 걸 묻는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 1a258d80-13e4-66c2-9e66-60ca29004f0f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:1a258d80-13e4-66c2-9e66-60ca29004f0f
msgctxt "hfb563d08g95bfg4be1g91d3g247d4e69f1d3"
msgid "<i>Use the parasite. Probe her thoughts.</i>"
msgstr "<i>기생충을 사용한다. 섀도하트의 생각을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 1c059c27-39e9-431c-3e19-01bdecd0d0e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:1c059c27-39e9-431c-3e19-01bdecd0d0e6
msgctxt "h106d28a0g0f57g4c69g96e4g5a14f9e570de"
msgid ""
"But it is not my mission to collect your head. The <i>ghaik </i>parasites "
"come first."
msgstr "하지만 내 임무는 네 머리 수집이 아니다. <i>게이크</i> 기생충이 먼저다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Narrator
#. NodeID = 1dcfc31a-97b0-a7d3-256e-1db551849177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:1dcfc31a-97b0-a7d3-256e-1db551849177
msgctxt "h230a8b99g38d8g46a4g8a16gae11fb8c9ec9"
msgid "*Shadowheart keeps one hand on something hidden beneath her clothing.*"
msgstr "*섀도하트는 뭔가 쥔 한쪽 손을 옷 속에 숨기고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 1f0805e1-2b79-707a-164f-fbe7acf2e072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:1f0805e1-2b79-707a-164f-fbe7acf2e072
msgctxt "hc3f4e464gc45fg46c2ga3dcgdcfb1c23aea8"
msgid "Let's not get ahead of ourselves."
msgstr "너무 앞서 나가지는 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 1f1740ac-d0e2-c4f9-c1f2-2e7eb6b8e8ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:1f1740ac-d0e2-c4f9-c1f2-2e7eb6b8e8ce
msgctxt "h9b794425g3a27g4d40gadd3gf525af21eca0"
msgid "Stand down, Lae'zel. You've gotten what you wanted."
msgstr "이제 진정해, 레이젤. 원하는 건 얻었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 1f637d6c-36c3-6d49-a827-3517ec3112fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_AgainstShadowheart = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Kill(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:1f637d6c-36c3-6d49-a827-3517ec3112fd
#, fuzzy
msgctxt "h99d509e5gc94eg4976g8385g9bac77e2e9e7"
msgid "For you, my queen: a thief's blood!"
msgstr "여왕이시여, 도둑의 피를 받아주소서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 1f649318-53ff-6fbe-05c2-0f52d0a4fd54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:1f649318-53ff-6fbe-05c2-0f52d0a4fd54
msgctxt "h3e708919g419fg4061gbf6agd8cc70653690"
msgid "<i>Keep quiet.</i>"
msgstr "<i>침묵을 유지한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 213ea57f-5230-aa22-75f4-2a6dbd70881d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:213ea57f-5230-aa22-75f4-2a6dbd70881d
msgctxt "hf443df0bg753fg4877gb3e0gd758c220a144"
msgid ""
"I do not wish to spill blood here. Come daylight, we will find a place to "
"end this."
msgstr "여기서 피를 쏟고 싶지는 않다. 아침이 밝거든 이 분쟁을 끝낼 장소를 찾도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 222288cf-fd82-2643-37ea-d9e39143c261
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:222288cf-fd82-2643-37ea-d9e39143c261
msgctxt "h8e9aba1eg7c92g4df8gbcaagbfc2750a73e8"
msgid ""
"I know the gith heirloom you possess must be important to my kin. As I know "
"they would not yield it willingly to you."
msgstr "네가 갖고 있는 기스 보물은 우리 동족에게 아주 중요한 물건이지. 그걸 네 손에 얌전히 넘겨줬을 리 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 2272dbf6-787d-c3bf-2aa5-4d0a1822de7b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_AgainstShadowheart = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Fight(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2272dbf6-787d-c3bf-2aa5-4d0a1822de7b
#, fuzzy
msgctxt "hb2c4134egd2d2g4020gb8f9gd9a62d8f3cd3"
msgid "Shar take you both, then."
msgstr "샤께서 너희 둘 모두를 데려가시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 22883581-18cb-d513-bcec-e8fdb8b320dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:22883581-18cb-d513-bcec-e8fdb8b320dd
msgctxt "hd05c92f5g4718g43f5g96d2ge5ee24537791"
msgid "I'm merely being practical."
msgstr "그저 실용적으로 행동할 뿐이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 24d79df2-7bf7-6594-bb89-d54afe49e7ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:24d79df2-7bf7-6594-bb89-d54afe49e7ae
#, fuzzy
msgctxt "h67896842gad93g48f6ga6a0g0f455a95f59d"
msgid "Never. Thieves aren't afforded such luxury."
msgstr "아니. 도둑에게 그런 사치는 허용되지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 24e987ee-76a6-06a3-456f-85efa9be50c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = False
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_EndDuringEvening = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:24e987ee-76a6-06a3-456f-85efa9be50c1
msgctxt "heebe65a9gb63eg4de9ga406g514dad4897c1"
msgid ""
"In time, I will slay the occupant of that artefact. You'd be foolish indeed "
"to intervene."
msgstr "언젠가, 그 아티팩트의 거주자를 죽일 것이다. 끼어드는 멍청한 짓은 말아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 25a56f36-1b30-bec4-4e96-50fb2f518d31
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(-1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:25a56f36-1b30-bec4-4e96-50fb2f518d31
msgctxt "h94bf13efg8866g4d73ga52fg0df2449d374e"
msgid "Relic? This is about that artefact, isn't it?"
msgstr "유물? 그 아티팩트 얘기를 하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 264b42ce-2555-174e-ddd2-1896715080d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:264b42ce-2555-174e-ddd2-1896715080d5
#, fuzzy
msgctxt "hd0bca0e7g18e6g4da3ga98cg9948d0e0ecd5"
msgid "<i>Come to Shadowheart's defence.</i>"
msgstr "<i>섀도하트를 방어한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 27c79715-9c8a-44eb-17be-9c3c940dc4d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:27c79715-9c8a-44eb-17be-9c3c940dc4d9
msgctxt "h3d4afffdgeb22g4f1dga4dbgea171456f037"
msgid ""
"A sorry tale. Barely worth interrogating you over. Show me the heirloom."
msgstr "한심한 이야기야. 널 심문할 가치도 없었군. 유물을 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 2a5101e3-b926-35b9-3e7c-aefbb92c5f87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2a5101e3-b926-35b9-3e7c-aefbb92c5f87
msgctxt "hbd695b91g789ag4784ga8bdg0858043a1e8c"
msgid "Tell me what you are doing with it."
msgstr "그걸로 뭘 하려는 건지 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 2bf7fbfe-06f5-10c4-3004-63121248422c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2bf7fbfe-06f5-10c4-3004-63121248422c
msgctxt "h2d377360gac27g4338g8d2cg94f5e5e47825"
msgid "Go, rest. But do not consider this matter settled."
msgstr "가서 쉬어라. 하지만 이걸로 끝일 거라는 생각은 말도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 2c5940c8-8c65-9177-ac25-23b82d8ee789
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2c5940c8-8c65-9177-ac25-23b82d8ee789
msgctxt "hb4d5653bg79fag430cg9ffagef10130b36b8"
msgid "What's this even about?"
msgstr "뭐 때문에 싸우는 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 2d8ca33c-a0ee-28e1-dc66-f876dedc3e02
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_ShadowHeart_Knows_CityGoal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2d8ca33c-a0ee-28e1-dc66-f876dedc3e02
msgctxt "h59fa1910g2979g410cg883bg151c8160af91"
msgid ""
"I don't know what it is, what it does... I just have to get it to Baldur's "
"Gate."
msgstr "나도 그게 뭔지, 뭐하는 물건인지 몰라... 그저 발더스 게이트로 가져가야 한다는 걸 빼면."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 2de00b72-d2d3-bff1-65fc-eb7a34fb7008
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2de00b72-d2d3-bff1-65fc-eb7a34fb7008
msgctxt "h49a674eegd181g4f1cga77agf4626c156214"
msgid "Another time, I'm terribly tired. You should get some rest, Lae'zel."
msgstr "나중에 보여줄게, 지금은 정말 지쳤어. 너도 좀 쉬어야지, 레이젤."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 2f38ccce-d039-a337-d6fc-88761b03dd2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2f38ccce-d039-a337-d6fc-88761b03dd2e
msgctxt "he03140c3g0f33g406cg801cga6e6bbb5024d"
msgid ""
"So. Can you let the matter drop, or should I put you back to sleep "
"permanently?"
msgstr "그럼. 이 일을 마무리할까, 아니면 도로 영원히 재워 줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 2fd35d32-e0f4-9463-c50e-36ec95ca4057
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp3(2) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:2fd35d32-e0f4-9463-c50e-36ec95ca4057
msgctxt "h7576729fgdb49g48a4g8973g593a44a49236"
msgid "Shadowheart - <i>stop</i>. You don't have to do this."
msgstr "섀도하트, <i>멈춰</i>. 이럴 필요는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 3061b172-40e9-eee5-05eb-d4cfa272f60c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:3061b172-40e9-eee5-05eb-d4cfa272f60c
msgctxt "ha4e379c4g8badg46c3gaf41ge267e3a6d551"
msgid ""
"For now. Perhaps we can put our differences aside, out of mutual self-"
"interest."
msgstr "당장은 그렇지. 우리 각자의 이익을 위해, 우리의 차이는 무시할 수도 있을 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 316258d3-ea30-e5ce-5d65-499de6d05920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:316258d3-ea30-e5ce-5d65-499de6d05920
msgctxt "h64f60f05geb7ag4ad9g8f3cgc7582d978303"
msgid "None of your concern."
msgstr "네 알 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 32d0c8c1-58bc-a36c-8a3d-80fa10a79c17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:32d0c8c1-58bc-a36c-8a3d-80fa10a79c17
msgctxt "h308eea90geb06g4d99ga95cgc9206998a947"
msgid ""
"Heirloom? Plunder from some conquered realm, more like. This artefact is the "
"only thing keeping us from becoming slaves to our parasites. Be glad I have "
"it."
msgstr ""
"보물? 정복한 차원에서 약탈해 온 거겠지. 이 아티팩트는 우리가 기생충의 노예가 되는 걸 막아주고 있어. 내가 가지고 있는 걸 다행으로 "
"여기라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 3327ed95-b572-2194-3e0a-0dc8f2c82fc1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:3327ed95-b572-2194-3e0a-0dc8f2c82fc1
msgctxt "h123a5a2eg8d4eg4635g9202ge1ecf6a5090d"
msgid "Should that fail... at least I know you are a deep sleeper."
msgstr "그러지 않는다면... 적어도 네가 잠이 깊다는 건 알고 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 3350fc04-9500-dd4f-ba0d-9e98dea58c66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:3350fc04-9500-dd4f-ba0d-9e98dea58c66
msgctxt "h6e50338fg0991g49c4gb7abg983c652b8a43"
msgid ""
"Persistent, aren't you? Under different circumstances, I'm sure we'd get on "
"quite well."
msgstr "정말 끈질기구나? 다른 상황이었다면, 분명 우린 꽤 잘 지냈을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 35433d45-d1e6-a78a-f523-6380d0e7db60
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_AgainstLaezel = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Fight(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:35433d45-d1e6-a78a-f523-6380d0e7db60
msgctxt "h09df06f2g444fg4f58gb79bg3b6982dce0a6"
msgid "May your death be slow, and your agony great!"
msgstr "너에게 느린 죽음과, 큰 고통이 있기를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 36a277f9-cd7e-6603-6065-45251a4720d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:36a277f9-cd7e-6603-6065-45251a4720d1
msgctxt "h45156aa1g5e12g4f4bg9848g76ecbe280994"
msgid ""
"You have something precious to my kin - an heirloom. I will have it back."
msgstr "우리 종족의 보물을 가지고 있군. 돌려 받겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 371fac13-6159-340c-64c0-96567f10ad22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezelFight_intervene = False
#. SetFlags:
#.   Local:
#.     - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezelFight_intervene = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:371fac13-6159-340c-64c0-96567f10ad22
msgctxt "hde10fd8ag6dcag4078g9e52g3daa4072501b"
msgid "<i>Watch the argument unfold.</i>"
msgstr "<i>말다툼을 지켜본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 3917c4df-13c0-47cc-d7b6-fe4304f7cc2f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_EndDuringEvening = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:3917c4df-13c0-47cc-d7b6-fe4304f7cc2f
msgctxt "hb40ab25dg6dfag47ecgbd64gecbfb4c1d5e1"
msgid "I am content. Go, rest. Dawn breaks all too soon."
msgstr "나는 불만 없다. 가서 쉬어라. 새벽이 곧 밝을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 39f5b12e-7345-f9f2-225a-dac4b0767050
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:39f5b12e-7345-f9f2-225a-dac4b0767050
msgctxt "h0a9623eag3511g4632g8b50gd37aaf14e7c3"
msgid "But if that comes into doubt, I'll kill you. Sleep well."
msgstr "하지만 의심이 들면, 널 죽여버릴 거야. 잘 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 3c1e079d-603d-fe57-cad0-b3a7ce562077
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:3c1e079d-603d-fe57-cad0-b3a7ce562077
msgctxt "h734199bag022bg4385ga1edge84f41c67bb0"
msgid "<i>Confess everything you know.</i>"
msgstr "<i>알고 있는 사실을 모두 고백한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 3c94fdf2-6361-269e-8262-fa022be75308
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:3c94fdf2-6361-269e-8262-fa022be75308
msgctxt "h102cc423g70e9g4359ga2a8g333f045f2ae7"
msgid "You're not angry?"
msgstr "화 안 났어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 43204af4-133c-393c-6ed1-8c8a4bdce366
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_AgainstShadowheart = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Fight(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:43204af4-133c-393c-6ed1-8c8a4bdce366
#, fuzzy
msgctxt "h66679679g6ed7g4fddg8b3fgc2f7bc8df704"
msgid "Shar take you both, then."
msgstr "샤께서 너희 둘 모두를 데려가시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 43ab2e58-cad8-c826-e980-86f2048a123b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:43ab2e58-cad8-c826-e980-86f2048a123b
msgctxt "hcaa8ea00gfb95g4bfeg8b7fg107fea59df12"
msgid "I can't."
msgstr "못 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 46952843-0e5c-9f69-45a7-bee969161ef9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:46952843-0e5c-9f69-45a7-bee969161ef9
msgctxt "h4f856be0gaca2g4f99ga254gb484e561a6ae"
msgid ""
"The artefact you possess contains someone important - someone I may need to "
"free."
msgstr "네가 갖고 있는 아티팩트 안엔 중요한 누군가 들어 있다. 내가 풀어줘야 할 사람이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 488ea008-dbbf-c7d4-4c6b-199b6cab9c17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:488ea008-dbbf-c7d4-4c6b-199b6cab9c17
msgctxt "h8c230288g9810g4b02gac0cg181ec40aedf0"
msgid "<i>Side with Shadowheart.</i>"
msgstr "<i>섀도하트의 편에 선다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 4cef25c3-9c22-6aae-054c-e3dfcc994aea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:4cef25c3-9c22-6aae-054c-e3dfcc994aea
msgctxt "h11067c62g3adbg4266g900bgc8a904fabee9"
msgid "Do your worst. I won't tell you anything."
msgstr "어디 최악을 보여 봐. 난 아무 말도 않을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 50c33675-c9e3-1037-2226-74b9a73bdcce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:50c33675-c9e3-1037-2226-74b9a73bdcce
msgctxt "hf06d95e3g8016g41f9g8bd8g87e03ed7303e"
msgid ""
"Do you hear this tripe? Our lives are at stake, and she wants us to turn on "
"each other."
msgstr "얘 헛소리 하는 것 좀 봐. 모두의 목숨이 걸려 있는데, 우리가 서로에게 등을 돌리길 원하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 519fa7cc-df88-1e95-01fd-7c9d25ebb428
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:519fa7cc-df88-1e95-01fd-7c9d25ebb428
msgctxt "h1e02b342gce4cg4e77gbbc9g50e8ed1b4eda"
msgid "You mean I'd get to prove you wrong <i>and </i>thrash you? I love it."
msgstr "네가 틀렸다는 걸 증명하고 <i>때려 눕힐</i> 수도 있다는 거야? 마음에 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 51cca3fc-8b69-0631-f608-cc2bb251cbd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:51cca3fc-8b69-0631-f608-cc2bb251cbd9
msgctxt "he21eadf9g3013g4d1fgbb71g3e2c3f6d941a"
msgid "I can't tell what I don't know. My goddess willed it, so I obeyed."
msgstr "나도 몰라서 말할 수 없어. 내 여신께서 원하셔서, 순종한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 52d8050d-75cb-4517-c63b-b9eade87abb6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:52d8050d-75cb-4517-c63b-b9eade87abb6
msgctxt "hdc784a4dgf149g4103ga5e1g804d4e5b44f7"
msgid "It's nothing. A lucky keepsake I found in some ruins."
msgstr "별 거 아냐. 폐허에서 운 좋게 찾은 기념품이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 5356aa1d-583b-4278-57a9-ba3538c84a10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_CFM_LaezelFight_State_VoicedSupport(2) = False
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_CFM_LaezelFight_State_VoicedSupport(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5356aa1d-583b-4278-57a9-ba3538c84a10
msgctxt "h7508fe96g56f1g43d0g9401ge53d56e98d02"
msgid ""
"I agree with Shadowheart - the artefact is protecting us. We need it with us."
msgstr "섀도하트 말이 맞아. 이 아티팩트가 우릴 보호하고 있어. 가까이 두어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 53a54618-64e1-8935-12c9-4426f4764d60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:53a54618-64e1-8935-12c9-4426f4764d60
msgctxt "h7dce7f40g2e16g4a37gb15egdc707dd345e6"
msgid "So. Any ideas on how we settle this?"
msgstr "자, 어떻게 해결하면 좋겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 56e4ce06-4416-71af-5a57-4bcceff1da11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:56e4ce06-4416-71af-5a57-4bcceff1da11
msgctxt "h57fc1c06gb54cg4a37gb631g39472d493db8"
msgid ""
"It is for other gith to hunt and punish you. And they will, knowing my kin."
msgstr "네 사냥과 처벌은 다른 기스의 몫이다. 내가 아는 한, 내 동족은 그리 하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 5791be11-7182-b2df-efaa-a8ffe2aa42ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_InfernalBox_State_LaezelKnows = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5791be11-7182-b2df-efaa-a8ffe2aa42ba
msgctxt "h7833bddcge012g4f83gad0bg185d6a7e8074"
msgid "What do you want?"
msgstr "뭘 원해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 5892a97e-eb3a-5359-ba01-be8b87c6fba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5892a97e-eb3a-5359-ba01-be8b87c6fba8
#, fuzzy
msgctxt "hd80ed68agd099g4015g90c0gd8855beafd9a"
msgid ""
"You think this can be settled with just words? No. Honour demands I take "
"<i>something </i>from you."
msgstr "말만으로 해결할 수 있다고 생각하는 건가? 아니, 명예를 위해선 너에게서 <i>뭔가</i>를 가져가야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 5a733056-2d8d-2009-b6db-360dd6a12dca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5a733056-2d8d-2009-b6db-360dd6a12dca
msgctxt "h6a898554gf967g441ag9279g76d137894aa5"
msgid ""
"Spare your indignity. Every word that spills from your mouth is worth less "
"than the last."
msgstr "스스로를 창피하게 하지 마. 네가 뱉어내는 말은 점점 더 들을 가치가 없어지니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 5ac2fc14-4818-92b0-e4d5-f45d024f241a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_EndDuringEvening = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5ac2fc14-4818-92b0-e4d5-f45d024f241a
msgctxt "hb1c3fd66g0bd6g4829gb8feg0065d91eccf0"
msgid ""
"In time, I will free the occupant of that artefact. You'd be foolish indeed "
"to intervene."
msgstr "언젠가, 그 아티팩트에 든 자를 풀어줄 것이다. 끼어드는 멍청한 짓은 말아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 5b20c185-c231-b37a-e56f-0d4d197b1085
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5b20c185-c231-b37a-e56f-0d4d197b1085
msgctxt "h12002093g9287g4ad8gb1efg4039431ebbbd"
msgid ""
"I don't care about the relic, only the occupant inside it. Keep it with you."
msgstr "난 유물엔 관심 없고, 안에 든 자에만 관심이 있다. 네가 간직하고 있어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 5db1d06d-e2ab-155e-1436-c0e739ae5acb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5db1d06d-e2ab-155e-1436-c0e739ae5acb
msgctxt "hf21d12c7gaa55g4431g834dgb1c4abd70cd9"
msgid ""
"I needn't have woken you at all. I could've just buried this dagger in your "
"throat."
msgstr "널 깨울 필요도 없었어. 그냥 네 목에 이 단검을 박아넣을 수도 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 5fdf3eea-47ac-49b7-8c83-6a4f1eea129d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:5fdf3eea-47ac-49b7-8c83-6a4f1eea129d
msgctxt "hfd573e22gbbf7g4ac6gbd05g811f9df05aee"
msgid "<i>Side with Shadowheart.</i>"
msgstr "<i>섀도하트의 편에 선다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 60c04bd3-76d0-51cd-a120-af42ee842d3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:60c04bd3-76d0-51cd-a120-af42ee842d3c
msgctxt "hf8f37101g6668g45d9g99ddg7a5e29800455"
msgid ""
"Lae'zel. You're not really the type for idle chatter. Don't develop the "
"habit now."
msgstr "레이젤. 너는 느긋하게 대화하는 성격이 아니잖아. 지금 그런 습관 들이지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 60ee01f0-bfba-cf2e-4d20-c491772eff97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:60ee01f0-bfba-cf2e-4d20-c491772eff97
msgctxt "h7319bfd7g61beg4041gba90gf4b499d786bd"
msgid ""
"I don't know what qualifies as manners with your kind, but in Faerûn it's "
"rude to stare."
msgstr "너희 종족 매너가 어떤지는 모르겠는데, 페이룬에서는 빤히 쳐다보면 실례야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 616fccc7-d232-e30e-987e-f22f5bde8979
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:616fccc7-d232-e30e-987e-f22f5bde8979
msgctxt "h13c7492cgd13cg4b79g8578g4e1bec128913"
msgid "Keep it, for now."
msgstr "갖고 있어라, 일단."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 617d574c-b0f2-a07f-e135-067e7f1a3916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:617d574c-b0f2-a07f-e135-067e7f1a3916
msgctxt "h8dcce39bge5e0g4accg9f15g4aba070aed29"
msgid ""
"Your lies are not as cunning as you think, <i>istik</i>. Show me this "
"'keepsake'."
msgstr "넌 남을 속일 만큼 교활하지 못하다, <i>이스틱</i>. 그 '기념품'이라는 걸 내보여라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 62f77c50-84e6-5af8-2910-4d58f6163050
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_CFM_LaezelFight_State_VoicedSupport(2) = False
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_CFM_LaezelFight_State_VoicedSupport(2) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:62f77c50-84e6-5af8-2910-4d58f6163050
msgctxt "h6d96ca9ag8afeg4afdgb54dg08160b2f4fd8"
msgid "Lae'zel is right. I don't need my own kin as enemies."
msgstr "레이젤의 말이 맞아. 동족을 적으로 돌릴 필요는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 62f77c50-84e6-5af8-2910-4d58f6163050
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_CFM_LaezelFight_State_VoicedSupport(2) = False
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_CFM_LaezelFight_State_VoicedSupport(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:62f77c50-84e6-5af8-2910-4d58f6163050
msgctxt "h6e4eb400ga096g4d21ga4e5g75003957d664"
msgid "Lae'zel is right. We don't need the githyanki as enemies."
msgstr "레이젤의 말이 맞아. 기스양키를 적으로 돌릴 필요는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 638b7256-e23f-615b-25a4-f496d2066d9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:638b7256-e23f-615b-25a4-f496d2066d9a
msgctxt "h6a819f99gde65g4f10g8788g3d2932e4568f"
msgid "Not yet, <i>kainyank.</i>"
msgstr "아직 아니다, <i>케인얀크.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 63dd7f79-81a0-3912-3a85-2f80bf19e3c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:63dd7f79-81a0-3912-3a85-2f80bf19e3c8
msgctxt "hfa7b4f0cg1c82g47fegb6a5g029fb3cfd5d5"
msgid "Rest. Dawn breaks all too soon."
msgstr "쉬어라. 새벽은 금방 밝아온다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 64548937-cbd6-a2e5-fc28-ca01e48de476
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Event_LaezelFirst = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:64548937-cbd6-a2e5-fc28-ca01e48de476
msgctxt "h7b1a4d8ag3c35g4e67ga59bgbd51251ed42f"
msgid "The truth, now. Or vermin will feast on your carcass."
msgstr "당장 진실을 말해. 아니면 쥐떼가 네 시체를 먹어 치울 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 67e66434-364d-e990-1461-a52451323c0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:67e66434-364d-e990-1461-a52451323c0b
msgctxt "hd3e2d053g1b31g47cbg9ed3g28bfb63cc3fb"
msgid "I do not believe you."
msgstr "네 말은 믿을 수 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 68273f85-c67f-008a-839f-f1fc6175a87a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:68273f85-c67f-008a-839f-f1fc6175a87a
msgctxt "h7a76e8cdga1aag4e8eg8e92g0a62f2e44419"
msgid "Keep it. Do what you will with it."
msgstr "갖고 있어라. 그걸로 할 일을 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 68a36a16-2cce-d2c5-6843-da623e62a147
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:68a36a16-2cce-d2c5-6843-da623e62a147
msgctxt "hcbdff82dg81e2g4edeg972ag9e2e1c48a508"
msgid ""
"But imagine what we might achieve if we channelled some of that hostility "
"back at our real foes instead of each other. They wouldn't stand a chance."
msgstr ""
"하지만 우리가 서로에게가 아닌, 우리의 진짜 적들에게 그 분노를 돌린다면 어떤 일이 일어날지 상상해 봐. 그들은 살아남지 못할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 6a83d880-6b81-8540-24f0-97a2618c6544
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:6a83d880-6b81-8540-24f0-97a2618c6544
msgctxt "h29d704e7gb0ecg40cag918bg5d8fbc7c4da1"
msgid "<i>Tuck the relic away and turn to leave.</i>"
msgstr "<i>유물을 집어넣고 돌아서서 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 6bb76c18-0330-90a4-6417-3dc1d9038187
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:6bb76c18-0330-90a4-6417-3dc1d9038187
msgctxt "h398d1f32gcc1bg40cdga3acg7100597c5554"
msgid "<i>Leave them to settle their differences and go to sleep.</i>"
msgstr "<i>알아서 해결하게 두고 자러 간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 6c88fae6-1851-3e35-13dd-692e94e98cb4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp3(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:6c88fae6-1851-3e35-13dd-692e94e98cb4
msgctxt "h37dc1014ge000g466bg95c4g7b128c93ee96"
msgid "Lae'zel - <i>stop</i>. Before you do something you'll regret."
msgstr "레이젤, <i>멈춰</i>. 스스로 후회할 짓을 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 6e144d03-bfb4-41e6-2eec-88bf5c6913eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:6e144d03-bfb4-41e6-2eec-88bf5c6913eb
msgctxt "hdba6fd80g95dag4862gafdcg19da8e4ef02a"
msgid "This matter concerns both of us, kin. Shadowheart has deceived us."
msgstr "이건 우리 모두에게 중요한 문제다, 동족이여. 섀도하트가 우리를 속였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 6f98ca4f-2d68-5ceb-c17e-4727cafb520f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:6f98ca4f-2d68-5ceb-c17e-4727cafb520f
msgctxt "h4e9e730dge4b0g41eeg9fecg00c5d1f31b18"
msgid ""
"The artefact is closed to me. But its protection is an advantage - as is "
"having a skilful cleric at my side."
msgstr "아티팩트는 내게 닫혀 있다. 하지만 그 보호는 이점이지. 내 곁에 있는 노련한 클레릭처럼 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 7052bc13-43e4-79d0-9a4c-d1a7db9acdd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezel_AskThemtToStop = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7052bc13-43e4-79d0-9a4c-d1a7db9acdd6
msgctxt "h6fdc0ec1g8dbag4349ga00eg093ae06eee97"
msgid "Stop this. No sense in us fighting with each other."
msgstr "그만둬. 우리끼리 싸워서 좋을 게 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 7120d42c-b674-a1c8-1ffe-0af4df80b3f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7120d42c-b674-a1c8-1ffe-0af4df80b3f5
msgctxt "h0f4bfff5g1d13g4023g8feegf704ccb9a06b"
msgid "I doubt this one's wits will be any sharper by then."
msgstr "아침이 된다고 얘가 갑자기 똑똑해질 것 같진 않은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 73065467-6b66-45dc-d176-5abf3c30a5f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:73065467-6b66-45dc-d176-5abf3c30a5f7
msgctxt "h936e9142ga23bg4861g94b5g70e9c3c1f290"
msgid "What exactly were you doing before the <i>ghaik</i> seized you?"
msgstr "<i>게이크</i>에게 납치당하기 전, 정확히 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 740474dc-c3ec-8875-62c3-f3a533190632
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:740474dc-c3ec-8875-62c3-f3a533190632
msgctxt "h5f5f6345g0180g49bcg9ff5g633ff50b5dc4"
msgid "You know your choices."
msgstr "네가 자초한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 745e27ec-a2dd-3a44-3415-f097de0a91c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:745e27ec-a2dd-3a44-3415-f097de0a91c6
msgctxt "h280b2445gf9cbg4817gb5c8geee579237c12"
msgid "The bad blood must be purged. A duel, come first light."
msgstr "증오는 제거해야한다. 아침이 오면, 결투를 하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 74b8d479-c17f-bedb-e214-b352a7bab1d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_AgainstLaezel = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Kill(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:74b8d479-c17f-bedb-e214-b352a7bab1d3
msgctxt "hd81f5cf2gbf0cg43c3g87eagd8b2a05d6c59"
msgid ""
"Take this slain foe as a gift, blessed Nightsinger. Usher her into your "
"darkness."
msgstr "죽인 이 적을 제물로 받으소서, 축복받은 나이트싱어여. 이 자를 당신의 어둠으로 안내하시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 76a3dbec-9ca2-d656-c36f-2f40948d1eae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:76a3dbec-9ca2-d656-c36f-2f40948d1eae
msgctxt "h79118e6ag0903g4133g900dgef5e51e7f7c9"
msgid "<i>Do nothing.</i>"
msgstr "<i>아무것도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 76a4f0cf-6b99-a2bd-ab4e-d76e3eaecd8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:76a4f0cf-6b99-a2bd-ab4e-d76e3eaecd8b
msgctxt "h7228d91fg9ab8g4854g91b0g54dda6e78438"
msgid ""
"I don't know what you're talking about. I suspect <i>you </i>don't know what "
"you're talking about."
msgstr "무슨 소리 하는지 모르겠네. <i>너도</i> 네가 무슨 소릴 하는지 모르는 듯한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 77a2ad0a-117c-d18d-ae7f-d1bf141ad741
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:77a2ad0a-117c-d18d-ae7f-d1bf141ad741
msgctxt "had9f35f7gd0dcg4513gadd4g781a94d96470"
msgid "I'm not going to regret this - I'm going to enjoy it."
msgstr "후회는 하지 않아. 오히려 즐겁겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 795cb014-03e5-4b21-75c4-f048dcc40612
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:795cb014-03e5-4b21-75c4-f048dcc40612
msgctxt "hcc491e7fg474ag4c5dg9a69g50c32fe6d8b3"
msgid "Keep it, for now."
msgstr "갖고 있어라, 일단."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 79ab6d14-7747-1b42-942e-fff85e4829b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:79ab6d14-7747-1b42-942e-fff85e4829b3
msgctxt "hb2c78a44g8e4cg4622ga81dg22badc80b059"
msgid "Can I do that, Lae'zel? Can I turn my back on you?"
msgstr "그래도 돼, 레이젤? 네게 내 등을 보여도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 7c9bdb5a-25f1-0c12-57bb-bbb4b6092009
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7c9bdb5a-25f1-0c12-57bb-bbb4b6092009
msgctxt "h57958a0bgdf59g42c3gbad0gd10128108bee"
msgid "Simply vexed. Anger would be impractical."
msgstr "신경 쓰였을 뿐이다. 분노는 비효율적인 감정이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 7d594b5b-ff48-4493-8cb6-72b049f23e5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7d594b5b-ff48-4493-8cb6-72b049f23e5b
msgctxt "h605771cegbbafg489ag8daeg02ffc9259372"
msgid "<i>Move to attack Shadowheart.</i>"
msgstr "<i>섀도하트를 공격하려 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 7e2513f2-4284-13a0-7104-01f9c12b5072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7e2513f2-4284-13a0-7104-01f9c12b5072
msgctxt "hf9bd5f90gd0f4g4ac5g8d4ag9a2fc557248d"
msgid "You're welcome to try. Otherwise, back off."
msgstr "시도해보든가. 아니라면, 물러서."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 7e74f531-7362-d4ef-747c-8f7c562d739a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7e74f531-7362-d4ef-747c-8f7c562d739a
msgctxt "h464907eeged89g4721g8774gfb2e2b3662da"
msgid "Lies. She carries an heirloom of my people. I must know why."
msgstr "거짓말. 그녀는 내 종족의 보물을 지니고 있다. 이유를 알아야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 7f0c29dd-af92-8b28-4262-96be36f7284c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7f0c29dd-af92-8b28-4262-96be36f7284c
msgctxt "h8c66fe67gee8eg4419gba3cgeaed06b963e8"
msgid "You would have me surrender, kin? A disgusting notion."
msgstr "내가 항복하게 두겠다고, 동족이여? 역겨운 생각이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 7f0c29dd-af92-8b28-4262-96be36f7284c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:7f0c29dd-af92-8b28-4262-96be36f7284c
msgctxt "h173b73dbg61a9g43fdgafe5g43ff78c0cc32"
msgid "Surrender? A disgusting notion."
msgstr "항복이라고? 역겨운 생각이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 8020d05b-c2e0-0cf2-b50d-3761e123f8d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8020d05b-c2e0-0cf2-b50d-3761e123f8d5
msgctxt "h93e6a45bge87cg4dd1gaa41g5c555707ea47"
msgid "Walk away. <i>Now</i>. I won't warn you again."
msgstr "떨어져. <i>당장</i>. 두 번 경고하지 않을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 82c37242-2457-cae9-86a3-c28c02da2e67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:82c37242-2457-cae9-86a3-c28c02da2e67
msgctxt "h896919b6g7c3fg40d8gbe66gd726c62949d9"
msgid "That's all? There has to be more."
msgstr "그게 다야? 더 있을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 856556c4-86e3-943f-feaf-982f47330754
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:856556c4-86e3-943f-feaf-982f47330754
#, fuzzy
msgctxt "h4cc54912g3616g4f3dg8c07gddd17fcf776e"
msgid ""
"This suffices for now. Perhaps we can put our differences aside, out of "
"mutual self-interest."
msgstr "지금은 이걸로 충분하다. 우리 각자의 이익을 위해, 우리의 차이는 무시할 수도 있을 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 871daa66-0cd9-764b-e9d4-1cf3a5eee086
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_AgainstLaezel = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Fight(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:871daa66-0cd9-764b-e9d4-1cf3a5eee086
msgctxt "h8fe70707g46f2g43d6ga708g7dea31a2d059"
msgid "You should have taken your own advice."
msgstr "내가 할 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Narrator
#. NodeID = 8a7e2c70-1c91-1e23-0fcd-71a92db58efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8a7e2c70-1c91-1e23-0fcd-71a92db58efb
msgctxt "h72668b4dg46d5g46e0gabeagdf3a223eaf39"
msgid "*There is no way to prevent bloodshed. You have to choose.*"
msgstr "*유혈사태를 막을 방법은 없습니다. 당신은 선택해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 8a940621-8b13-4bea-68f8-0ef6b1477b03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8a940621-8b13-4bea-68f8-0ef6b1477b03
msgctxt "h16b9df44gd4deg410bg8313g7b5d41f7a8d7"
msgid "You've been misinformed. By who, I wonder?"
msgstr "네가 잘못 알고 있는 거야. 누구한테 들은 얘기지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 8b17df86-8ff6-017d-24d8-63c91f32bb54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8b17df86-8ff6-017d-24d8-63c91f32bb54
msgctxt "hb7fa1abegb884g4a12gbe66gad33115be81d"
msgid "I know you have something precious to my kin. Explain yourself."
msgstr "우리 동족의 중요한 물건을 갖고 있더군. 설명해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 8b5bb8fe-68da-cb88-5417-6b4c4965b3f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8b5bb8fe-68da-cb88-5417-6b4c4965b3f2
msgctxt "h0afa930age3b7g4cfbgad3age8f1b3526f60"
msgid "I can't tell what I don't know. Shar willed it, so I obeyed."
msgstr "나도 몰라서 말할 수 없어. 샤께서 원하셔서, 순종한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 8c816411-4d47-28d6-0243-3527aa24bb5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8c816411-4d47-28d6-0243-3527aa24bb5c
msgctxt "hc01f3973gb828g4419g85aag62ec77d08e2f"
msgid "I should have seen this coming, coward."
msgstr "예상했어야 했는데. 이 겁쟁이."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 8cee802d-e771-98c2-a3bb-08dc87efb1e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8cee802d-e771-98c2-a3bb-08dc87efb1e4
msgctxt "h1e1bf60bg996cg4734g928bgbc7af3b21cc1"
msgid "Perhaps this is so. Show me the heirloom."
msgstr "그럴 수 있겠군. 유물을 보여 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 8d562907-c6fd-0205-e3f5-09b9a7c52431
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8d562907-c6fd-0205-e3f5-09b9a7c52431
msgctxt "h4cf46e7eg841eg4d2dg94f9g74dc8095532a"
msgid ""
"A relic of my people. An ancient one. Curious, that the one I'm to kill "
"should be living inside it."
msgstr "우리 종족의 고대 유물이로군. 흥미로워, 내가 죽여야 할 자가 이 안에 살아있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 8d5c7332-1107-bf99-d806-2e9e7dcc2ccc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8d5c7332-1107-bf99-d806-2e9e7dcc2ccc
msgctxt "ha430ab85gcfc9g4558gad92g538df7e83c34"
msgid "Wait. You held a blade to my throat over this, and now you don't care?"
msgstr "잠깐, 내 목에 칼까지 들이대놓고는, 이제 와서 신경 끄겠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 8ef555f8-db9f-bb24-bbbc-3707bc1b2749
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8ef555f8-db9f-bb24-bbbc-3707bc1b2749
msgctxt "h3a68addfgf62ag4093g985fg6683ccf69e0e"
msgid "You must. Or you will take your secrets to the grave."
msgstr "말하지 않으면 비밀을 무덤까지 가지고 가게 해주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 8f36b359-f664-ff8a-bcd5-3ec222b1b513
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:8f36b359-f664-ff8a-bcd5-3ec222b1b513
msgctxt "hbad4f53dgfbd4g4e99ga7c1g196caff89a3f"
msgid "A keepsake. Very well. Perhaps I was misinformed."
msgstr "기념품이라. 좋아. 내가 잘못 안 모양이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 90b80f8b-f5b1-221a-8c64-b81f9bcbc768
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = False
#.   Local:
#.      - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezelFight_intervene = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = True
#.   Local:
#.     - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezelFight_intervene = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:90b80f8b-f5b1-221a-8c64-b81f9bcbc768
msgctxt "h69a03c52g577bg433fga4a0g1b52a45840e2"
msgid "What's going on? Why're you two arguing?"
msgstr "무슨 일이야? 왜 논쟁하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 923c8c4f-c631-587d-1390-30e83740172b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:923c8c4f-c631-587d-1390-30e83740172b
msgctxt "h26e416eeg9af8g4076ga600g37f95f10b864"
msgid "Many of us were sent to take it from your kin. I'm the last one left."
msgstr "너희로부터 이걸 얻기 위해 많은 사람이 파견되었어. 그 중 나만 남았고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 92a62eaa-8d2d-5773-6d76-3c0959f92e0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:92a62eaa-8d2d-5773-6d76-3c0959f92e0d
msgctxt "hba7a6b6eg3a43g45begaf2dg729ffe77b8a8"
msgid "<i>Refuse.</i>"
msgstr "<i>거절한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 92f58ca3-8b77-d5ba-52c8-baede4ff0ebf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:92f58ca3-8b77-d5ba-52c8-baede4ff0ebf
msgctxt "h031ec7cfgffefg4380gaf2agfd316a7e60e7"
msgid "<i>Sssh... </i>don't call out. Don't move."
msgstr "<i>쉬이... </i> 조용히 해. 움직이지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 9493f765-5a65-8caa-9552-a14637ec1ecb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9493f765-5a65-8caa-9552-a14637ec1ecb
msgctxt "h6c1b7ba8g8365g463fgb06eg7b77fea975c3"
msgid ""
"Loosen the grip on your pride for one blasted moment, won't you? We needn't "
"be enemies - there's plenty of those to go around already."
msgstr "잠시나마 네 자존심을 내려놓지 않을래? 우린 적이 될 필요가 없어 - 적은 이미 넘쳐난다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 95f36276-bc9a-e66e-1243-6db56f5f2195
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:95f36276-bc9a-e66e-1243-6db56f5f2195
#, fuzzy
msgctxt "he238e2dfgc2d6g4a2dg9becg5d07151a711f"
msgid "Should've kept your focus on me."
msgstr "나한테 집중하지 그랬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 965958c6-5a98-c67e-0dcb-7ce95a12fa29
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp3(2) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:965958c6-5a98-c67e-0dcb-7ce95a12fa29
msgctxt "hb9401f2fgfa8bg4a42gac11gda1301e64130"
msgid "Lae'zel - <i>stop</i>. Before you do something you'll regret."
msgstr "레이젤, <i>멈춰</i>. 스스로 후회할 짓을 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 981b3bff-cb2a-89d5-c341-d9b939ca58d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:981b3bff-cb2a-89d5-c341-d9b939ca58d2
msgctxt "h5251dafdg6591g4097ga8d8ge9c25e292d49"
msgid ""
"But make no mistake - I will slay the Prism's occupant, as Vlaakith's "
"commanded. Perhaps your mission can still be fulfilled... but it will not "
"come at the cost of mine."
msgstr ""
"하지만 오해하지 마라. 난 블라키스 님의 명대로, 프리즘의 거주자를 죽일 것이다. 아마 네 임무도 수행할 수 있겠지만...내 일을 끝내기 "
"전에는 안 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 9a5a38bd-45c9-8beb-0a8d-0160f509565f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9a5a38bd-45c9-8beb-0a8d-0160f509565f
msgctxt "h7cc01ca3gc1d7g443ag8fbfg18ec0ea68d18"
msgid ""
"But I will attend to the Prism's occupant, in time. Perhaps your mission can "
"still be fulfilled... but it will not come at the cost of mine."
msgstr "하지만 언젠가는 프리즘의 거주자를 방문할 것이다. 아마 네 임무도 수행할 수 있겠지만...내 일을 끝내기 전에는 안 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 9c308333-7930-e02e-53d1-c0272c3f8f3a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9c308333-7930-e02e-53d1-c0272c3f8f3a
msgctxt "h04a9cd6ag4feeg47e8g855bgac30596ba25c"
msgid ""
"Nonsense. You're just finally showing what you really are - a reaver to the "
"bone."
msgstr "헛소리. 그냥 네가 뼛속까지 약탈자인 걸 드러내는 것뿐이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 9c308333-7930-e02e-53d1-c0272c3f8f3a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9c308333-7930-e02e-53d1-c0272c3f8f3a
msgctxt "h5a128a43g2c05g4231gbacage03fe986c614"
msgid ""
"Nonsense. You're just finally showing us what you really are - a reaver to "
"the bone."
msgstr "헛소리. 그냥 네가 뼛속까지 약탈자인 걸 드러내는 것뿐이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 9d739da6-df20-1f6f-0141-9d75324e8957
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9d739da6-df20-1f6f-0141-9d75324e8957
msgctxt "h2e410a69g3740g479ag88a4ge7f5ae833dfc"
msgid ""
"You had better warm to that notion very rapidly, or your journey ends here. "
"We needn't be enemies - there's plenty of those to go around already."
msgstr "제안을 빨리 받아들이지 않으면 네 여정은 여기서 끝날거야. 우린 적이 될 필요가 없어 - 적은 이미 넘쳐난다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = 9e07cd38-a04a-811b-7d27-bf87da5079df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9e07cd38-a04a-811b-7d27-bf87da5079df
msgctxt "hc3937903g9eeeg43f1ga458g2d19b5f7d6c7"
msgid "Unfortunate. I thought you may have some honour."
msgstr "유감이군. 조금이나마 명예가 있는 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = 9ed535c8-d9fb-13b8-0da5-dbe61dd4bcdc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_LaezelFight_WhatsGoingOn(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9ed535c8-d9fb-13b8-0da5-dbe61dd4bcdc
msgctxt "h71cd6bc9gc0ffg4d1dga873g3d225a78377b"
msgid "Rest - both of you. Tempers will be cooler in the morning."
msgstr "둘 다 어서 눈 좀 붙여. 내일 아침이면 감정도 가라앉겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 9f0d166d-48fe-91f5-1988-7c1cf2050e4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9f0d166d-48fe-91f5-1988-7c1cf2050e4c
msgctxt "h0d0a029fgb082g48f5g8d6bg7482a359be4b"
msgid "There. Is that worth your life?"
msgstr "자. 이게 네 목숨을 걸 가치가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = 9f31b2ac-2629-9a16-534c-1d304185aea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:9f31b2ac-2629-9a16-534c-1d304185aea2
#, fuzzy
msgctxt "h1e591a75g6750g4ae1g9adeg243d926eb749"
msgid ""
"It's too late - you can't appease them. We have to do what's right for "
"<i>us</i>. The artefact stays with me."
msgstr "너무 늦었어, 기스양키를 달래는 건 불가능해. 우린 <i>우리</i>한테 맞는 일을 해야 해. 아티팩트는 내가 가지고 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = a05a1c50-671d-5f23-0c8e-9a515b3150a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Shadowheart_Event_Wound = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a05a1c50-671d-5f23-0c8e-9a515b3150a3
msgctxt "hadc7f184g43b9g4ff6g96d8g65a0fad39876"
msgid ""
"I am certain you did. And now I shall find it in turn, on a dead half-elf."
msgstr "그러셨겠지. 그리고 이제 곧 내가 죽은 하프엘프에게서 발견할 테고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = a088364d-e5eb-e431-85e8-afb03d4183a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a088364d-e5eb-e431-85e8-afb03d4183a9
msgctxt "ha4579f3cg6462g4a32g93a9gd4877c72f091"
msgid "And yet here I stand. Concerned."
msgstr "그럼에도 난 여기에 있다. 신경 쓰고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = a26fd3e1-a877-9a6b-f208-a46d7c694740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a26fd3e1-a877-9a6b-f208-a46d7c694740
msgctxt "h22c6925dg1debg43ceg85e3g97490e58a9b8"
msgid "You should have stayed out of this!"
msgstr "네 행동을 후회하게 될 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = a4e85e64-d23e-e6f4-5993-b8d4e5af0277
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a4e85e64-d23e-e6f4-5993-b8d4e5af0277
#, fuzzy
msgctxt "hc7f6bf6fg433eg4bd0ga4c6g4962914b6e65"
msgid "She's a liability - it's the artefact we need, not her -"
msgstr "얘를 데리고 있어서 좋을 게 없어. 우리한테 필요한 건 아티팩트지, 얘가 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = a62e8058-f717-6cf6-0f9e-bde2ff52d092
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Event_LaezelFirst = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a62e8058-f717-6cf6-0f9e-bde2ff52d092
msgctxt "h47811d48ge72ag4892ga78bgaea3cd8662e9"
msgid ""
"You had every chance to look the other way, but here we are. You chose this."
msgstr "그냥 모른 척 넘어갈 수 있었을 텐데, 결국 이렇게 돼 버렸네. 네가 자초한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = a6891031-58b8-c2e0-902e-47567bb1bb89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#. SetFlags:
#.   Global:
#.     - GLO_InfernalBox_State_LaezelKnows = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a6891031-58b8-c2e0-902e-47567bb1bb89
msgctxt "h48ff70e5gdf7eg4680gb6aegad3dd6edaef4"
msgid "Rest must wait, Shadowheart."
msgstr "쉬기 전에 답해라, 섀도하트."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = a8bf91b0-3dfe-7a49-955c-7c59e36ac08e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a8bf91b0-3dfe-7a49-955c-7c59e36ac08e
msgctxt "hfe8a0ce7gfadeg443cgb4e0g8b93b008f851"
msgid ""
"The relic is gith, but means nothing to me. You can do with it as you like."
msgstr "유물은 기스 것이지만, 내겐 의미가 없다. 원하는 대로 해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = a94a2fe8-2192-ef43-9887-3208eac89c5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:a94a2fe8-2192-ef43-9887-3208eac89c5b
msgctxt "hf3689a56gc58fg4f5bg9740ge9b63cba906a"
msgid "I am merely curious about my travelling companion."
msgstr "함께 여행하는 동료에 관심있을 뿐이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = aa3e123c-3081-4783-b6e8-2f6d88686638
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:aa3e123c-3081-4783-b6e8-2f6d88686638
msgctxt "h2028e57bg0330g442bgbd1fg46cd3c33a959"
msgid "We shall see. Now let us rest."
msgstr "두고 보면 알겠지. 이제 쉬도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = aa84056f-ae03-cb4f-b0ef-92c07d4ef3de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:aa84056f-ae03-cb4f-b0ef-92c07d4ef3de
msgctxt "hb4d7d62fg04fbg4b49g95ceg0a3533e6be29"
msgid "<i>Side with Lae'zel.</i>"
msgstr "<i>레이젤의 편에 선다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = ab2c17bb-7ac1-594c-02d8-7d769f822d4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:ab2c17bb-7ac1-594c-02d8-7d769f822d4e
msgctxt "h865a7441gc9c1g4a8ag8f07gba511d6aeae3"
msgid "<i>Produce the artefact.</i>"
msgstr "<i>아티팩트를 꺼내 보인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = ab327f89-f33e-9bf8-8a85-80b82eb02448
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:ab327f89-f33e-9bf8-8a85-80b82eb02448
#, fuzzy
msgctxt "hfb65f975gb309g4045g9a9egc4b07ed8889f"
msgid "You too? Shar take you both, then!"
msgstr "너까지? 그렇다면, 샤께서 너희를 둘 다 데려가시기를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = b0c10245-541d-b219-570c-694c79fcdc5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:b0c10245-541d-b219-570c-694c79fcdc5d
msgctxt "h1f34b463g863dg4c62ga6f8g77e9b937a5e0"
msgid ""
"Purification is my mission - not your contraband. I am content for the time "
"being."
msgstr "내 임무는 정화이지, 네 밀반출 처리가 아니다. 지금으로선 문제없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = b579b3fa-2c54-213b-7817-836620afe214
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezel_AskThemtToStop = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:b579b3fa-2c54-213b-7817-836620afe214
msgctxt "h1957487cg112bg49b1ga163gf58ad89cf060"
msgid "Again, stop this. No sense in us fighting with each other."
msgstr "다시 말하는데, 멈춰. 서로 싸울 이유는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = b7135f06-9f10-6f10-dd6c-e0d1f203907a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:b7135f06-9f10-6f10-dd6c-e0d1f203907a
msgctxt "hc7668d6eg0a84g4a9ag843cge7b4c899af70"
msgid ""
"A relic of my people. An ancient one. Curious, that the one I'm to kill "
"should be living inside it."
msgstr "우리 종족의 고대 유물이로군. 흥미로워, 내가 죽여야 할 자가 이 안에 살아있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = b7e97910-7fdb-035e-7d99-e20d6ce1330b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:b7e97910-7fdb-035e-7d99-e20d6ce1330b
msgctxt "hd3670aabg1f9eg4812gbe4ag033a29816fdb"
msgid "A moment."
msgstr "잠깐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = bae2d5d3-d2dc-8ff6-ac3a-7f09f721f485
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:bae2d5d3-d2dc-8ff6-ac3a-7f09f721f485
msgctxt "h6ecbbf8agb187g4014g9c45g2f20ee24b658"
msgid "Unimportant."
msgstr "그건 중요치 않다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = bf3b8021-ae9d-cd55-c5db-61abfa30c126
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:bf3b8021-ae9d-cd55-c5db-61abfa30c126
msgctxt "h8d498a0agb426g414bg839bg8f870a351efe"
msgid "They are more than welcome to try."
msgstr "얼마든지 해 보라고 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = bfab3e1c-0263-d180-657e-125ef7b896fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:bfab3e1c-0263-d180-657e-125ef7b896fe
msgctxt "h737fb755gf76ag4239gb330gd5f37c4b440b"
msgid "We need her, Shadowheart. Give her a chance."
msgstr "우린 그녀가 필요해, 섀도하트. 그녀에게 기회를 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = bfdce24a-7842-2d94-1cdb-b8366404ff9a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_AgainstLaezel = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Fight(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:bfdce24a-7842-2d94-1cdb-b8366404ff9a
msgctxt "h003fa001ged5bg4415gb7a3g05e808816129"
msgid "May your death be slow, and your agony great!"
msgstr "너에게 느린 죽음과, 큰 고통이 있기를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = c1130294-6324-b225-f912-feacf15a67d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_CFM_LaezelFight_state_AvatarLaezelArgues(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_CFM_LaezelFight_state_AvatarLaezelArgues(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c1130294-6324-b225-f912-feacf15a67d7
msgctxt "h7051bc69gf300g4609gb461g0335dd8aeee1"
msgid "That heirloom is as much my affair as it is yours."
msgstr "그 보물은 네게 중요한 만큼 내 일이기도 하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c2df4624-7f9e-29c9-1751-a87701bcb387
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c2df4624-7f9e-29c9-1751-a87701bcb387
msgctxt "h8b522c5dg1696g414ag8d80g0d351578a152"
msgid ""
"Hm. A creation of my people, though I cannot decipher writing this ancient."
msgstr "흠. 내 동족들의 작품이군, 하지만 너무 고대의 글자라 이름은 알아볼 수가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = c2ffbbd3-f577-0962-98e5-186fe5ba23db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c2ffbbd3-f577-0962-98e5-186fe5ba23db
msgctxt "hc19fb245ge188g42efg9dbcgb4c73b6b5a8d"
msgid "<i>Do nothing.</i>"
msgstr "<i>아무것도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c4875831-7af3-e9f6-87c0-c3522e33ba9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c4875831-7af3-e9f6-87c0-c3522e33ba9c
msgctxt "h9ec1bf14gf6d9g43bbg8ac6g80b1549f7a3b"
msgid "Let me up, and I'll show you."
msgstr "날 일으켜 주면, 내 필요를 보여 주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c49cc0d4-ecf0-1daa-6d7f-372ab0801b3b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Shadowheart_Event_Wound = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c49cc0d4-ecf0-1daa-6d7f-372ab0801b3b
msgctxt "h9a206dc1g91acg41bbg8acaga96eb151041a"
msgid "My worst is for worthy foes. This will have to suffice."
msgstr "내 최악은 그럴 가치가 있는 적에게 쓰지. 이거면 충분하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = c5218dc5-9c2f-5f9e-a434-8f5d0bb0db60
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_WolfDreamPoint_LaezelFight = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c5218dc5-9c2f-5f9e-a434-8f5d0bb0db60
msgctxt "h8e4bff5dg565fg4c28gac7cg8cdbdbeeccd4"
msgid "But if you break your promise, I'll kill you. Sleep well."
msgstr "하지만 약속을 어기면, 죽일 거야. 잘 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c55f5144-578e-112c-3ded-12ebb009a602
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c55f5144-578e-112c-3ded-12ebb009a602
msgctxt "hfd4053e5g00abg4385g828dg9f41648c76bc"
msgid ""
"That <i>artefact </i>is an heirloom of my people. Likely she spilled "
"githyanki blood in order to steal it. This cannot stand."
msgstr "그 <i>아티팩트</i>는 우리 종족의 보물이다. 아마 그걸 얻기 위해 기스양키의 피를 흘렸겠지. 눈 감아줄 수 없는 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c57fee88-eaff-0c29-3629-a91522eb547e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c57fee88-eaff-0c29-3629-a91522eb547e
msgctxt "hb4f66f7ag6b5eg4d3dgb440g6444921c8a04"
msgid ""
"But I will attend to the Prism's occupant, in time. Perhaps your mission can "
"still be fulfilled... but it will not come at the cost of mine."
msgstr "하지만 언젠가는 프리즘의 거주자를 방문할 것이다. 아마 네 임무도 수행할 수 있겠지만...내 일을 끝내기 전에는 안 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c5b18473-d38e-4650-8a3a-7a7eccbf6e90
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Shadowheart_Event_Wound = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c5b18473-d38e-4650-8a3a-7a7eccbf6e90
msgctxt "hc8da6e2fg8dfbg4ecdgb44cg37b9c954b2fc"
msgid ""
"No matter. I can examine it for myself. Be still and this will be quick."
msgstr "상관없지. 나 혼자서도 조사할 수 있으니. 가만히 있으면 빨리 끝날 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c6f13fff-1360-19f7-eef2-cba92cb3cb00
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c6f13fff-1360-19f7-eef2-cba92cb3cb00
msgctxt "h0730f15dgddeag42d9g8ea4g1a827feef2e0"
msgid ""
"You're lucky I respect him. One more chance, then - tell me about the relic."
msgstr "내가 이 자를 존중하는 걸 행운으로 여겨라. 그럼 한 번 더 기회를 주지. 유물에 대해 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c6f13fff-1360-19f7-eef2-cba92cb3cb00
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c6f13fff-1360-19f7-eef2-cba92cb3cb00
msgctxt "h0c336255g811fg4438gbc9cgbd306feaf1cc"
msgid ""
"You're lucky I respect her. One more chance, then - tell me about the relic."
msgstr "내가 이 자를 존중하는 걸 행운으로 여겨라. 그럼 한 번 더 기회를 주지. 유물에 대해 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c6f13fff-1360-19f7-eef2-cba92cb3cb00
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c6f13fff-1360-19f7-eef2-cba92cb3cb00
msgctxt "hc61c6f0fgec72g48e2gb45eg675e8ad0f657"
msgid ""
"You're lucky I respect them. One more chance, then - tell me about the relic."
msgstr "내가 이 자를 존중하는 걸 행운으로 여겨라. 그럼 한 번 더 기회를 주지. 유물에 대해 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = c743342a-c612-8742-98d1-795323712194
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c743342a-c612-8742-98d1-795323712194
msgctxt "h14fcb0beg0e71g4a77g8c2eg217b3899859d"
msgid ""
"Remove yourself, if you are so easily offended. This is not your concern."
msgstr "이 정도로도 불쾌하다면 빠져라. 네 알 바가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = c7a38cef-8a4e-ba30-b526-82e1bcd23d51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:c7a38cef-8a4e-ba30-b526-82e1bcd23d51
msgctxt "hd457349eg29d4g46afgad91g3ffc79648fe5"
msgid "<i>Produce the artefact.</i>"
msgstr "<i>아티팩트를 꺼내 보인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = ca764e85-5941-29b2-a640-c644c32e7698
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:ca764e85-5941-29b2-a640-c644c32e7698
msgctxt "h4e072f15gedd3g489dgb0ffg6f14bc5b9cc2"
msgid "Show it to me."
msgstr "내게 보여라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = caf53daf-507f-8bb6-6e62-3998727cbf16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:caf53daf-507f-8bb6-6e62-3998727cbf16
msgctxt "h1f3aad8fg82a2g4b7fgaa8bg5db8da7c727b"
msgid ""
"If I knew you weren't a threat to me - to my mission - then perhaps we could "
"make peace."
msgstr "네가 나와 내 임무에 위협이 아니라는 사실을 알았더라면, 평화롭게 지낼 수 있었겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = cbd69e84-3a3c-bec8-a234-333af3c9cc93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezel_AskThemtToStop = False
#.      - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezelFight_intervene = False
#. SetFlags:
#.   Local:
#.     - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezel_AskThemtToStop = True
#.     - 3ca45cdd-50eb-1a35-db75-a7cb30ec5705_ShadowheartLaezelFight_intervene = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:cbd69e84-3a3c-bec8-a234-333af3c9cc93
msgctxt "h6c6a5b87gf31bg424bga270gfcbec28b598a"
msgid "Stop squabbling - both of you."
msgstr "둘 다 그만 다퉈."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = cc3317cf-a495-14a3-45b1-e04394431263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:cc3317cf-a495-14a3-45b1-e04394431263
msgctxt "h2ae5cb48gea79g4038g82b3g1d32f287a121"
msgid "If you explain yourself, perhaps I will allow you to keep the heirloom."
msgstr "설명을 제대로 해준다면, 그 유물을 네가 계속 들고 있게 해주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = cda3dedc-de1c-972b-9a83-21f683ee31ab
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:cda3dedc-de1c-972b-9a83-21f683ee31ab
msgctxt "h750f84c0g9d96g460eg9992gca86300307b6"
msgid "<i>Offer her a half-truth. Say you found it on a dead gith.</i>"
msgstr "<i>반쪽짜리 진실을 알려 준다. 죽은 기스에게서 발견했다 말한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = cded6a72-25af-3d65-ed1f-f2318d614483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:cded6a72-25af-3d65-ed1f-f2318d614483
#, fuzzy
msgctxt "h31051824g8cd3g4602g8693g7ec6a8b82c81"
msgid "It's already done."
msgstr "늦었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = ce999e63-b31f-6866-c699-142395b39d6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:ce999e63-b31f-6866-c699-142395b39d6a
msgctxt "ha63bbdecg8edcg4e08g99a5g7c6884613b0f"
msgid "You hear that, Lae'zel? It's called common sense."
msgstr "들었어, 레이젤? 상식이란 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = cefabc6c-7068-e9a5-00a9-3602d27ca295
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:cefabc6c-7068-e9a5-00a9-3602d27ca295
msgctxt "hf288ecb0g97fdg487dg951agc7bcca4e68b5"
msgid "Agh... I felt that. Get away from me, gith!"
msgstr "윽... 수작 부리는군. 저리 떨어져, 기스년아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = d04fb6af-58a3-18d1-9bc2-c6dee6257ab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d04fb6af-58a3-18d1-9bc2-c6dee6257ab3
msgctxt "h69eb305dgbd0ag4076ga6aag321a13ad1524"
msgid "<i>Let the matter drop for now.</i>"
msgstr "<i>그 문제는 잠시 제쳐두자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = d0dbaf78-e870-6259-b885-846c027ffe40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d0dbaf78-e870-6259-b885-846c027ffe40
msgctxt "h5b96ceddgc4a4g45bbgb53dgd5ab1859af4d"
msgid "Lies upon more lies."
msgstr "거짓말에 또 거짓말이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = d0fe2c93-ddc4-fc46-f34d-639934d45769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d0fe2c93-ddc4-fc46-f34d-639934d45769
msgctxt "hc55be993gaebfg442bga5d2g11218744d761"
msgid ""
"Lae'zel thinks I have something important to her people. She's deluded, "
"clearly."
msgstr "레이젤은 그녀 종족에게 중요한 무언가를 내가 갖고 있다고 여기는 모양이야. 분명히 오해한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = d130f7d4-a554-22b8-b669-981106b9fa00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d130f7d4-a554-22b8-b669-981106b9fa00
msgctxt "h7e160f9cgd018g4740gbea1g4fb612585ffe"
msgid "Consider the matter resolved then."
msgstr "그럼 사태 해결이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = d28573ca-1251-b875-2901-6bded0848dfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d28573ca-1251-b875-2901-6bded0848dfe
msgctxt "h2bde650fg757fg4ae0gb318g9709f2ab25a8"
msgid "No."
msgstr "안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = d5f5f7cf-ec2a-c79d-ce0e-24b634258372
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d5f5f7cf-ec2a-c79d-ce0e-24b634258372
msgctxt "h01e2465cgc76bg4eccg9594g7fcc38044387"
msgid ""
"A relic of my people. An ancient one. Curious, that the one Voss wants me to "
"free should live inside it."
msgstr "우리 종족의 고대 유물이로군. 흥미로워, 보스가 찾던 풀어줘야 할 자가 이 안에 살아있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = d61d6871-e270-dd89-0ea0-aa35d75a1c6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d61d6871-e270-dd89-0ea0-aa35d75a1c6d
msgctxt "haa214fbcg63a5g4b45gb698gf198a88d281f"
msgid ""
"If anyone asks, I'll say you were transforming. Don't expect to be mourned."
msgstr "누가 묻거든, 네가 변이하고 있었다고 할게. 네 죽음을 슬퍼할 거라 기대하진 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = d7aefe9b-15f0-327d-975c-2960690b36de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d7aefe9b-15f0-327d-975c-2960690b36de
msgctxt "h30e475c8gff59g46d8gba9fg33e4c3d96aa5"
msgid "<i>Tsk.</i> You seek reason in dishonour."
msgstr "<i>Tsk.</i> 불명예에서 이성을 찾는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = d7f66c69-32aa-0d2c-609c-0952e2acbf98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d7f66c69-32aa-0d2c-609c-0952e2acbf98
msgctxt "h08ddfbeag1b52g4476gb8e7g6cc0cb6a23df"
msgid ""
"Incorrect. Judicious bloodletting settles feuds and roots out the weak - the "
"<i>deceitful</i>."
msgstr "틀렸어. 적절한 피흘림으로는 분쟁을 멈추고 약한 자를 솎아낼 수 있다. <i>거짓말하는 이들</i>을 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = d93a5a39-ffee-d422-922d-9af0a6ae6d42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:d93a5a39-ffee-d422-922d-9af0a6ae6d42
msgctxt "h545d9817g91b6g48a2gb949g33936ccaa4b2"
msgid ""
"A relic of my people. An ancient one. Curious, that the one Voss wants me to "
"free should live inside it."
msgstr "우리 종족의 고대 유물이로군. 흥미로워, 보스가 찾던 풀어줘야 할 자가 이 안에 살아있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = db04bd0b-a6f0-932a-adb1-91457fb12722
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:db04bd0b-a6f0-932a-adb1-91457fb12722
msgctxt "h1e191fddg2bffg4312g9fcdgb763edf0d207"
msgid ""
"The artefact is closed to me. But its protection is an advantage - as is "
"having a skilful cleric at my side."
msgstr "아티팩트는 내게 닫혀 있다. 하지만 그 보호는 이점이지. 내 곁에 있는 노련한 클레릭처럼 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = db8de703-bdfd-dfd6-b959-1581ef2d3904
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_CFM_LaezelFight_state_AvatarLaezelArgues(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_CFM_LaezelFight_state_AvatarLaezelArgues(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:db8de703-bdfd-dfd6-b959-1581ef2d3904
msgctxt "hccdb0570g5920g4d0bga197ga9e3350f2bda"
msgid ""
"You talk a great deal for a would-be murderer. Get on with it, if you dare "
"try."
msgstr "잠재적 살인자에게 대담한 거래를 하는군. 할 수 있다면 다시 해 보시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = dd8a4c15-9840-bd9e-89d5-431675bcc256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:dd8a4c15-9840-bd9e-89d5-431675bcc256
msgctxt "h9ff95225g327cg454cg86b4ga432e01d0d2c"
msgid "<i>Side with Lae'zel.</i>"
msgstr "<i>레이젤의 편에 선다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = de6b6d12-169b-ac2d-7dbc-046252023cbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:de6b6d12-169b-ac2d-7dbc-046252023cbb
msgctxt "hd661a84bg6b67g49b2gb2b8g443a36200555"
msgid ""
"Hm. A creation of my people, though I cannot decipher writing this ancient."
msgstr "흠. 내 동족들의 작품이군, 하지만 너무 고대의 글자라 이름은 알아볼 수가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = def4c1f5-300f-1ed3-7a95-46c0361bbde3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:def4c1f5-300f-1ed3-7a95-46c0361bbde3
msgctxt "h8df5f1b4g9abag48b3g9c1bg755dc1f69bde"
msgid "Spare me the justifications, coward."
msgstr "변명은 집어치우시지, 겁쟁이."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = df56ad8d-5100-76ca-b840-03296c68d62f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:df56ad8d-5100-76ca-b840-03296c68d62f
msgctxt "h472cc85agef6dg4845gbd4ag37f9a4048d38"
msgid "I will have an explanation from you, or I will have your head."
msgstr "제대로 된 설명을 내놓지 않으면, 네 목을 베겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = e33031af-deee-408b-6d73-c2f37539e27e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:e33031af-deee-408b-6d73-c2f37539e27e
msgctxt "h05fc0ee9g6cc7g4818g8d12g5f4d75cfab59"
msgid "I still could. Then no more Lae'zel to pry into my affairs..."
msgstr "아직 찌를 수도 있어. 그럼 내 신상을 캘 레이젤은 더 이상 없겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = e53f34e7-954a-f856-e637-61b640d3a03d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:e53f34e7-954a-f856-e637-61b640d3a03d
#, fuzzy
msgctxt "h38ecea7eg3e39g44aagb152g2634936e0e0e"
msgid "<i>Attack .</i>"
msgstr "<i>반격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = e76cb610-fe1f-b22a-39c3-34d9045bf6db
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp3(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:e76cb610-fe1f-b22a-39c3-34d9045bf6db
msgctxt "h36b4949bg2cfcg43d4g8debg5d1de7281443"
msgid "Shadowheart - <i>stop</i>. You don't have to do this."
msgstr "섀도하트, <i>멈춰</i>. 이럴 필요는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = e7ff9e42-654f-8ebf-9a1e-1e3a38149ed4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:e7ff9e42-654f-8ebf-9a1e-1e3a38149ed4
msgctxt "hee7ea58dga9b6g452ag8172g691e095e82c9"
msgid "Fine. It's a lucky keepsake, nothing more. I found it in a flea market."
msgstr "좋아. 이건 그냥 행운의 부적일 뿐이야. 노점상에서 구했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = e9982dfd-34c1-4cb2-5316-1c491b8d4562
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:e9982dfd-34c1-4cb2-5316-1c491b8d4562
msgctxt "h16bf6d70g2d48g4f34g8389ga26ed80334fb"
msgid ""
"Hmm. You seem sincere, oddly enough. Let's say we have an understanding."
msgstr "흐음. 이상할 정도로 진정성 있어 보이네. 합의한 걸로 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = e9b300dc-2ec4-68dc-ab4c-9a43f9a2cdce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_AgainstLaezel = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Fight(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:e9b300dc-2ec4-68dc-ab4c-9a43f9a2cdce
msgctxt "h508e28deg4b67g4becg9240g0a4f6a3a1222"
msgid "Ha! Very well, let us make this interesting."
msgstr "하! 아주 좋아, 재밌게 해 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Narrator
#. NodeID = ea17ac17-a13c-03bb-3a32-ad4b162cd711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:ea17ac17-a13c-03bb-3a32-ad4b162cd711
msgctxt "h052c692egb2cbg4172gb072g208896c1adb9"
msgid "*You sense her fear - that you will try to take the heirloom.*"
msgstr "*그녀의 두려움이 느껴집니다. 당신이 유물을 빼앗으려 하기 때문입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = ecd7ea49-2ab6-1920-d4a3-f308d24287b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:ecd7ea49-2ab6-1920-d4a3-f308d24287b3
msgctxt "h16646b88g1c8cg4379g91e6g32d7741a9f30"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = edb911e3-7273-8a27-1b6d-a0c973932f73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:edb911e3-7273-8a27-1b6d-a0c973932f73
msgctxt "h29c8a53eg420fg4735g9434g009ee56f8f45"
msgid "If that is true, you will have no qualms with showing it to me."
msgstr "그게 사실이라면, 굳이 감출 필요 없이 내게 보여줬어야 할 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = f52c07c0-e5df-d5ea-5b50-2fad77d884dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:f52c07c0-e5df-d5ea-5b50-2fad77d884dd
msgctxt "h9bad65efg1c34g4d83g8a0cg8cdedded733f"
msgid ""
"You have lied about the heirloom. I will have the truth, or I will have your "
"life."
msgstr "유물에 대해 거짓말했군. 진실을 알려주지 않으면 목숨을 가져가겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = f544a21a-4578-e85e-220c-243375e42615
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:f544a21a-4578-e85e-220c-243375e42615
msgctxt "h5a539e41g84bdg43f8g92eag654dd49f13c4"
msgid ""
"But make no mistake - I will slay the Prism's occupant, as Vlaakith's "
"commanded. Perhaps your mission can still be fulfilled... but it will not "
"come at the cost of mine."
msgstr ""
"하지만 오해하지 마라. 난 블라키스 님의 명대로, 프리즘의 거주자를 죽일 것이다. 아마 네 임무도 수행할 수 있겠지만...내 일을 끝내기 "
"전에는 안 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = f67d3893-f8a1-c5ea-4b93-ef826b8791b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_EndDuringEvening = True
#.     - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:f67d3893-f8a1-c5ea-4b93-ef826b8791b4
msgctxt "hfa1f47c7g15bcg48fbg80c0ga104c9652a81"
msgid ""
"Your contraband does not concern me, but it may concern my kin. Assume you "
"are being hunted."
msgstr "네 밀반출품은 내가 아니라, 내 동족이 신경 쓸 것이다. 널 사냥할 테지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = f7a1e8d9-1d9c-f0f6-3c6f-12d2332d1452
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:f7a1e8d9-1d9c-f0f6-3c6f-12d2332d1452
msgctxt "h725189e0gb000g45c2g9d71gbc38a2ba8fde"
msgid "It's my prize. I'll die to protect it."
msgstr "내가 얻어낸 보상이야. 목숨 걸고 지키겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Narrator
#. NodeID = f7b49801-2006-2578-3c10-481297ce7fcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:f7b49801-2006-2578-3c10-481297ce7fcf
msgctxt "h9bb12828gc49eg442ag9dbagfa34962057bf"
msgid "*There is no way to prevent bloodshed. You must choose.*"
msgstr "*유혈사태를 막을 방법은 없습니다. 당신은 선택해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = fa30b2df-1d3a-d282-ce5f-c4f328ec1639
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_ShadowheartLaezelFight_State_AgainstShadowheart = True
#.   Object:
#.     - CAMP_Shadowheart_Event_Fight(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:fa30b2df-1d3a-d282-ce5f-c4f328ec1639
#, fuzzy
msgctxt "h7bbde0c3g43a4g49b0g920egccea378388e5"
msgid "Offer yourself first, <i>kainyank.</i>"
msgstr "먼저 들어와라, <i>케인얀크.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = fd7b88df-9156-06d9-62f7-741e0df9cdc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:fd7b88df-9156-06d9-62f7-741e0df9cdc4
msgctxt "h881f3920gc403g4254gb076g295edd843789"
msgid "Cooperate, Lae'zel. For your own sake."
msgstr "협조해, 레이젤. 네 자신을 위해 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Player
#. NodeID = fdd09e26-3f8e-9865-e141-4c810536fd62
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:fdd09e26-3f8e-9865-e141-4c810536fd62
msgctxt "h7dea6643gfb9ag4175gbc6fg7ca35c328c2f"
msgid ""
"Your petty quarrels disturbed my rest. Stop at once, or I will <i>make </"
"i>you stop."
msgstr "네놈들의 하찮은 다툼이 내 휴식을 방해했다. 당장 그만둬, 아니면 그만두게 <i>만들어</i>주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = fddb4960-5d56-64ba-463e-0b973d147ae4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:fddb4960-5d56-64ba-463e-0b973d147ae4
msgctxt "hd44f96edg6553g448eg925bgef2b0e96c341"
msgid "Sssh... do not move. Do not cry out. Or I will open your neck."
msgstr "쉬... 움직이지 마. 소리 지르지도 말고. 안 그럼 목을 따버리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Shadowheart
#. NodeID = feca9e1d-3d93-57b5-9684-67dfd87fd0f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:feca9e1d-3d93-57b5-9684-67dfd87fd0f6
msgctxt "h2b04f599ga5d8g4cb8gafc6gf1edc722e564"
msgid "I don't care what you believe, Lae'zel. Go to sleep."
msgstr "네가 믿건 말건 내 알 바 아냐, 레이젤. 잠이나 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight
#. Speaker = Lae'zel
#. NodeID = fee08802-12c9-df02-8204-ab26cb67a5cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Shadowheart_IVB_CFM_LaezelFight:fee08802-12c9-df02-8204-ab26cb67a5cb
msgctxt "h49e35085g6fc0g4622g897ag8f46fcf8c24e"
msgid "<i>Tsk</i>. What would you have, that we be<i> friends?</i>"
msgstr "<i>Tsk</i>. 뭘 원하는 거지? <i>친구</i>라도 되자는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 0145bcb3-e096-4f91-e0fb-44bf9ee4b899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:0145bcb3-e096-4f91-e0fb-44bf9ee4b899
msgctxt "hf57b8c3dgc253g469cg9df1g955cdc3c91dc"
msgid "Friends? I've gathered quite the collection."
msgstr "친구 할까? 나 친구 모으는 데 꽤나 열성이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 02d95858-36be-5dc5-ce4a-f178e71d4126
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_ResolvedPeacefuly = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:02d95858-36be-5dc5-ce4a-f178e71d4126
msgctxt "h0ae441bagd1feg4738gb56dgff54509f1096"
msgid "Gods, you're stubborn. Karlach's not a devil, and you know it."
msgstr "망할, 고집불통이 따로없네. 칼라크는 데빌이 아니라니까. 너도 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 03ad9faa-437d-f6e9-edd5-9bd0e232d67d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:03ad9faa-437d-f6e9-edd5-9bd0e232d67d
msgctxt "h0dabc64cg1411g4a47gacb4g6b7852e3f0ca"
msgid "I've tried to tell you - I'm not what you think I am."
msgstr "내 말 좀 들으라니까. 난 네가 여기는 그런 게 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 068bb992-2f05-3cf9-51ca-5fba9215cff2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:068bb992-2f05-3cf9-51ca-5fba9215cff2
msgctxt "h350b2773g8465g42c8g8237g2da04e1f12c1"
msgid "Truce then, hey?"
msgstr "그럼 휴전할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 088ddb72-3e3a-cb45-0ada-8a9fd6221f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:088ddb72-3e3a-cb45-0ada-8a9fd6221f59
msgctxt "hb5c6df98gfce6g410dgb86dgac13a32107a0"
msgid ""
"I'm asking you to <i>live</i>, Wyll. I don't want to hurt you. And, to be "
"frank, I'd rather not find out how the Blade got his name."
msgstr ""
"난 <i>살 길</i>을 요구하는 거야, 윌. 난 널 해치고 싶지 않아. 내 쪽도 솔직히 '변방의 칼날’이 어떻게 명성을 얻은 건지 "
"체험하고 싶지 않고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 0b446527-ad93-72ac-ffb4-2e4df5892ba0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:0b446527-ad93-72ac-ffb4-2e4df5892ba0
msgctxt "h1a969fe8ge52eg4b46g9d0bg8412a9c909f4"
msgid "Let's start at allies and work from there."
msgstr "우선은 동료부터 관계를 시작해보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 0bb93ab7-8999-f982-14dd-a1b274a9b86b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:0bb93ab7-8999-f982-14dd-a1b274a9b86b
msgctxt "h7b0a1fbdg11d3g4c0fgbf6dg9664af306ced"
msgid ""
"Karlach. The archdevil Zariel's gladiator, come to burn the Sword Coast to "
"ash."
msgstr "칼라크. 아크데빌 자리엘의 검투사. 소드 코스트를 잿더미로 만들러 온 자여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 0c4a1dc8-04cc-b4fb-c3f5-6ac4eb14a9f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:0c4a1dc8-04cc-b4fb-c3f5-6ac4eb14a9f8
msgctxt "h5925f1b1g4c47g4df3gae68g10ad72a2ba02"
msgid ""
"Proof, clear as summer sky. It's over, Karlach. It's time you feel the sting "
"of the Blade."
msgstr "증명됐군. 여름 하늘처럼 말끔하게. 끝이다, 칼라크. 이제 이 칼날의 날카로움을 느껴봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 0dbb9809-f4e6-7261-a6c2-75eb9d3e3828
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:0dbb9809-f4e6-7261-a6c2-75eb9d3e3828
msgctxt "hbb9fffe3g3aa7g4090gb9cbgf5e1cee711fc"
msgid ""
"Well I'll be godsdamned - the Blade of Frontiers. Thought I'd shaken you for "
"good. That'll teach me to underestimate you."
msgstr "이런 우라질 노릇이 있나. 변경의 칼날이라니. 널 떨쳐내 버린 줄 알았는데. 과소평가 못 할 놈인 건 확실해졌군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 0e0e9df4-8234-8154-1487-93826c0015b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:0e0e9df4-8234-8154-1487-93826c0015b5
msgctxt "h84ea9796g2e45g48a0g9075g747688940c47"
msgid "I've hunted you to the Hells and beyond. It ends here, Karlach."
msgstr "널 지옥과 그 너머까지 추격했지. 이제 끝을 보자, 칼라크."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 0ee294a4-9c58-f39a-175a-2db8daa3cbad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:0ee294a4-9c58-f39a-175a-2db8daa3cbad
msgctxt "hb2bdd45ag4fe3g42edg9dbfg274b93e60afc"
msgid "Don't you fucking dare."
msgstr "지랄하고 자빠졌네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 16189057-e3f8-ede2-c83c-e4fe23bf6708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:16189057-e3f8-ede2-c83c-e4fe23bf6708
msgctxt "h534ce2d5g31e1g4834ga22ag088c895c81fa"
msgid "I brought you your target, Wyll. Why don't you do the honours?"
msgstr "여기 네 사냥감 대령해놨어, 윌. 나머지 일은 네가 맡는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 188cac26-e812-b35a-ad14-b3ab9dac5bb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:188cac26-e812-b35a-ad14-b3ab9dac5bb0
msgctxt "ha4cbe90cg2336g4d6ag8e73gb5ca7ad8dea7"
msgid ""
"You don't know what this means. You don't know what you're asking me to do."
msgstr "넌 그 말이 뭘 의미하는지 몰라. 내게 뭘 요구하는 건지 모른다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 1971530e-ca15-d11d-b5c9-a0b1db1aef6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:1971530e-ca15-d11d-b5c9-a0b1db1aef6a
msgctxt "h92af76b3g820cg4db1g9412g2c6040887c46"
msgid ""
"Too bad. I thought maybe you could be a friend. I could've done with one of "
"those."
msgstr "안타깝네. 어쩌면 친구가 될 수 있을 줄 알았는데. 그런 게 하나라도 간절한데 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 19c62c9f-183e-d202-b8bc-c1332bdc1844
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_ResolvedPeacefuly = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:19c62c9f-183e-d202-b8bc-c1332bdc1844
msgctxt "h9d0cd74fga5cfg4256g8980gf456ff224032"
msgid ""
"Thank the gods, he sees sense! Look, Blade - Wyll - I know you love bashing "
"evil - we have that in common."
msgstr "맙소사, 이제야 정신 차렸네! 이봐, 칼날. '윌'. 넌 악을 박살내는 걸 좋아하잖아. 그 점은 나도 똑같다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 1b12471f-860c-364b-d27b-0a262cf0af8b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_WyllLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:1b12471f-860c-364b-d27b-0a262cf0af8b
msgctxt "h5b7eccbaga6dcg4863gb26fg1c5c29717170"
msgid "But I do. The Blade of Frontiers will be only a memory come tomorrow."
msgstr "난 죽이고 싶은데. 변경의 칼날은 이제 과거의 기억으로만 남게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 1b1578f5-3708-72c7-5c97-41e6a7973312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:1b1578f5-3708-72c7-5c97-41e6a7973312
msgctxt "h9da43798g99a5g4bedg8145g4666a16507a0"
msgid ""
"Shut it, devil - I know your kind. A heart darker than a shadow's "
"nightmares. You'd cut a child's throat just to taste the blood."
msgstr ""
"닥쳐, 데빌. 난 너희 족속을 잘 알아. 그림자의 악몽보다 속내가 더 시커먼 것들. 피를 맛 보겠다고 아이의 목을 거리낌없이 벨 놈들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 212bee23-445f-2eef-d1bd-e988a1ce6b30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:212bee23-445f-2eef-d1bd-e988a1ce6b30
msgctxt "h1bb7ed61g222eg4677gb857g5d845a6e417e"
msgid "Well - not counting the fuckers that need a good hurting."
msgstr "글쎄. 맞아야 정신 차릴 새끼는 예외인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 293bb63a-d873-bd7f-f332-c9a20dbf823d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#. SetFlags:
#.   Global:
#.     - GLO_WyllConfrontation_Event_WyllConfrontedKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:293bb63a-d873-bd7f-f332-c9a20dbf823d
msgctxt "h934365beg1a45g4445g966fg97e579bb5924"
msgid ""
"Well I'll be godsdamned - the Blade of Frontiers. Thought I'd shaken you for "
"good. That'll teach me to underestimate you."
msgstr "이런 우라질 노릇이 있나. 변경의 칼날이라니. 널 떨쳐내 버린 줄 알았는데. 과소평가 못 할 놈인 건 확실해졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 2ab9ca04-0c05-daba-3808-77bf6049e5e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:2ab9ca04-0c05-daba-3808-77bf6049e5e0
msgctxt "h8e95bc79ge40ag470dgb9fcgbf49ff2a3deb"
msgid "Thank the gods. Thought I was going to have to take your head."
msgstr "거 참 다행이네. 이러다 네 모가지를 따버리는 거 아닌가 싶었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 2b76c7e3-ba7c-d408-7786-250aa81a0971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:2b76c7e3-ba7c-d408-7786-250aa81a0971
msgctxt "hd9a9cb14gad26g48eagb518g45ee881a7dd0"
msgid "<i>No. </i>Devils can <i>not</i> be trusted!"
msgstr "<i>아니. </i>데빌은 믿을 수 <i>없어</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 2edeecd6-2203-9400-cd80-a57e9a4c859f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_WyllLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:2edeecd6-2203-9400-cd80-a57e9a4c859f
msgctxt "h27576cfeg7d36g4fc7gbcceg8f8fa225707f"
msgid "It's over, 'Blade'."
msgstr "얘기는 끝이다, '칼날'."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 35cc0497-d920-d54a-a475-b43a62589d26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:35cc0497-d920-d54a-a475-b43a62589d26
msgctxt "h6b8078d2ga9f5g46e6gbf72g0c226cd2db78"
msgid "Well, Wyll. I tried."
msgstr "에휴, 윌. 난 노력했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 365b6026-65aa-e3b1-6047-e328bc34ffb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:365b6026-65aa-e3b1-6047-e328bc34ffb5
msgctxt "h3ecc53dfg1d37g4383gb3acgb1f66b7b5e1e"
msgid "How can I make peace with the monster I was sent to kill?"
msgstr "내가 죽여야 하는 괴물과 화해라니 그게 가당한 말이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 395c0141-e063-0a67-d770-722318504f7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:395c0141-e063-0a67-d770-722318504f7a
msgctxt "h1e4f7898g994ag498dg8b91g80fec8d7a369"
msgid "The two of you have met before, I see."
msgstr "보아하니 너희 둘은 구면인 모양이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 3b67639c-f351-ceeb-4123-442359260618
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:3b67639c-f351-ceeb-4123-442359260618
msgctxt "hdd76ce0cgec09g4cb1g9f6ega0b08506fc43"
msgid "You've got it all wrong, Wyll. Karlach's not about to hurt anyone."
msgstr "잘못 알고 있어, 윌. 칼라크는 아무도 해칠 생각 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = 3b7c0564-5455-0830-a071-fa870f898051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:3b7c0564-5455-0830-a071-fa870f898051
msgctxt "hf6722734gd6e6g417cg8073g2a2e2d1830f6"
msgid ""
"*Wyll catches his breath, and his lips straighten. Sheer dread twists his "
"face.*"
msgstr "*윌이 숨을 고르며 입을 앙다뭅니다. 극도의 불안감에 표정이 일그러집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = 3dd41677-770e-4142-34f9-ac5ba4988b4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:3dd41677-770e-4142-34f9-ac5ba4988b4e
msgctxt "hbb356898gdccag425fga11eg1f6514fc3fd8"
msgid ""
"*Two souls hang in the balance. Kill Karlach, fulfil your contract - and "
"condemn a possible innocent to the Hells. Or spare her and face the "
"repercussions with Mizora.*"
msgstr ""
"*두 영혼이 저울에 타 있습니다. 칼라크를 죽여 계약을 이행하면, 무고할지도 모를 영혼을 지옥에 보내고 말 테죠. 반대로 살려주면 당신이 "
"미조라의 후폭풍을 맞고 말 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 3e1b2eed-0b3b-1d2b-0725-75d3623caec5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:3e1b2eed-0b3b-1d2b-0725-75d3623caec5
msgctxt "h10299ab0g0516g4eb2g9f08g806a8620d75a"
msgid "To the Hells with you, then - and may you all forever burn."
msgstr "지옥에나 떨어져. 너희 다 영원히 불에 타길 비마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 40ae8acc-d866-0c0e-b406-b6a8c7bc8858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:40ae8acc-d866-0c0e-b406-b6a8c7bc8858
msgctxt "ha3d06fa7g769dg41cbga915g53846c5fc48c"
msgid ""
"You know monsters better than anyone. Can't you look in my eyes and see I'm "
"not a devil?"
msgstr "넌 누구보다 괴물에 대해 잘 알 테지. 내 눈만 봐도 내가 데빌이 아니란 거 보이지 않냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Lae'zel
#. NodeID = 4340647b-b378-45dc-a95f-7b1b586f0f20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:4340647b-b378-45dc-a95f-7b1b586f0f20
msgctxt "hda970305g3447g4cb5g87d4g479830eb102f"
msgid "I see you've met. Saves me the trouble of introductions."
msgstr "아는 사이인가 보군. 소개에 들일 수고를 덜어 잘됐구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Shadowheart
#. NodeID = 44815a00-0f3d-e865-c100-d3b0a1697223
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:44815a00-0f3d-e865-c100-d3b0a1697223
msgctxt "hcbf1284dgc8bag4173g923eg569916a2c0b6"
msgid ""
"Let's take things down a notch, shall we? She's no devil, Wyll. You'll have "
"to look elsewhere to find fodder for your blade."
msgstr "우리 일단 진정 좀 해 보는 게 어때? 쟤는 데빌이 아니야, 윌. 네 칼날을 맛보여줄 사냥감은 다른 데서 찾아보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = 4f1f0383-16bd-7be7-74e1-142d3d9e5b90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:4f1f0383-16bd-7be7-74e1-142d3d9e5b90
msgctxt "ha19d8b8bg0cbcg4647gbbebge500a831378a"
msgid "*A great fire roars through you - the fire of the First Hell.*"
msgstr "*거대한 불길이 내면을 휩씁니다. 첫 번째 지옥의 그 불길이 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 4f682216-8446-462c-00d8-aaacd839ed52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:4f682216-8446-462c-00d8-aaacd839ed52
msgctxt "h82b71f7fgc589g4cd9g99f0g6019e7316e3c"
msgid ""
"You fight in the Blood War for Zariel. You'll bring the Blood War to the "
"Coast."
msgstr "넌 자리엘을 위해 피의 전쟁에서 싸우잖아. 그 전쟁을 소드 코스트로 끌고 오고 말 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 517bd546-8997-0abc-3d45-bb1bdfd84c7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:517bd546-8997-0abc-3d45-bb1bdfd84c7e
msgctxt "hee86ba78gf754g41f5g9a04g3eac79a470c5"
msgid "Stand down. You saw what I saw - Karlach is not a danger."
msgstr "물러서. 너도 나랑 같은 걸 봤잖아. 칼라크는 위험한 자가 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = 597c9c0a-c620-c5db-aa40-8e526cb86bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:597c9c0a-c620-c5db-aa40-8e526cb86bb6
msgctxt "h0c83464bgd7f4g47c5g8918g42b09d5899a6"
msgid ""
"*Another vision. Karlach's blade raised, slicing through devils - Zariel's "
"servants - as her eyes dart around, seeking escape.*"
msgstr "*또 다른 환영. 칼라크가 도끼날로 자리엘의 데빌 하수인들을 썰어넘기며, 탈출로를 찾아 눈을 바삐 굴리는 모습이 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 5c0a8df3-a84a-69a4-a54d-e654f09b9226
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:5c0a8df3-a84a-69a4-a54d-e654f09b9226
msgctxt "h1649c5fegf7f3g4d14g880ege69f6ad47d62"
msgid "It will mean my undoing, but... I believe you."
msgstr "이러면 내겐 화근이 될 테지만... 널 믿어보겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 60d5601d-4e92-19fe-5d63-97a9eb63742b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:60d5601d-4e92-19fe-5d63-97a9eb63742b
msgctxt "h99b53f93g2ed3g4132g9dc5g0cdbbbb120e6"
msgid ""
"If by 'met' you mean hoofing it through the Hells with this fucker on my "
"tail."
msgstr "이 새끼가 내 꽁무니 쫓아 지옥 헤집고 다닌 것도 구면이라면 구면이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 65648dcb-0732-723f-1c0e-046bdccbddfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:65648dcb-0732-723f-1c0e-046bdccbddfc
msgctxt "hb26d8f1cgce3bg4afag9661g39fafe60bf6a"
msgid ""
"Touchy, touchy. But hey, I spent a decade in Avernus surrounded by imps and "
"devils. Winning you over will be child's play."
msgstr ""
"까칠하셔라. 근데 난 아베르누스에서 임프랑 데빌들하고 10년을 부대껴 살았다 이 말씀이야. 네 마음 돌리는 건 식은 죽 먹기일걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 66868010-0f21-fb88-1c9b-95ad3baf5c0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:66868010-0f21-fb88-1c9b-95ad3baf5c0e
msgctxt "h45f7053cgc07ag4f39gb1ebg39fb4e7f6f45"
msgid "Fine, but he needs to stand down. We saw the truth for ourselves."
msgstr "좋아. 얘는 성질 좀 죽여야겠지만. 우리 모두 진실을 봤잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 6d78475e-9f24-1b80-3beb-719fe48b6899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:6d78475e-9f24-1b80-3beb-719fe48b6899
msgctxt "h8fa1cf5fg2a04g4e67ga1d5geeb47b884ed6"
msgid "Aye. Truce."
msgstr "그래. 휴전하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 6e4a235c-4038-db0f-f053-f2f50204af82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:6e4a235c-4038-db0f-f053-f2f50204af82
msgctxt "h39109e73g1288g4094g9464g8f2927c1ea45"
msgid ""
"Look, whatever else it may be, the tadpole isn't a liar. I never wanted to "
"serve Zariel, and I escaped the first chance I could. So stand down."
msgstr ""
"이봐, 딴 건 몰라도 올챙이가 거짓을 지어내진 않아. 난 절대 좋아서 자리엘을 섬기지 않았고, 기회를 잡자마자 튀었다고. 그러니 그만 좀 "
"해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 6fb8ff1b-4147-e1ba-261e-aa6245638338
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:6fb8ff1b-4147-e1ba-261e-aa6245638338
msgctxt "h2e1db239g300ag48d1ga3c2g0294d90071f3"
msgid "Friends it is."
msgstr "친구 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 73c71cae-a151-47ce-0e9c-772eb3e307ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:73c71cae-a151-47ce-0e9c-772eb3e307ff
msgctxt "h69012218gfc42g4697gbf7bgb411de77f07d"
msgid ""
"How about we all take a nice deep breath and calm the fuck down. Just cause "
"I want to live doesn't mean I want him dead."
msgstr "다들 깊게 심호흡하고 씨발 진정 좀 해보는 게 어때? 내가 살고 싶다고 해서 저 녀석이 죽어야겠단 얘기는 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Lae'zel
#. NodeID = 7446e7f3-3036-a1bf-6521-7211db6abc99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7446e7f3-3036-a1bf-6521-7211db6abc99
msgctxt "h5d44fd25gad3dg4f26g93d3gb4e5d61d2104"
msgid ""
"Control yourself, Wyll. I understand bloodthirst. But this is no time to "
"quench it."
msgstr "자제해라, 윌. 피의 갈증은 이해한다만, 지금은 그걸 해소할 상황이 아니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 7673c7bc-f589-55bc-1009-d9b7852feccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7673c7bc-f589-55bc-1009-d9b7852feccd
msgctxt "hbfff41dfgc6eeg4160g81a0g812b9387a426"
msgid "I swear to you, on all I am, I'm not what you think."
msgstr "내 모든 걸 걸고 맹세컨대, 난 네가 여기는 존재가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 774700c1-4fce-e1e6-ba54-0cd68789be19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:774700c1-4fce-e1e6-ba54-0cd68789be19
msgctxt "h673d163cgedd1g4e97gb3b1g1f236cdc7848"
msgid "Dammit. This is an unwelcome complication."
msgstr "젠장. 일이 달갑잖게 복잡해지고 말았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 7824848b-0fd3-ff2d-9a9c-a0f73f70c5f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7824848b-0fd3-ff2d-9a9c-a0f73f70c5f1
msgctxt "h1d54b96agf39eg40c6g98a6ge297a6a72975"
msgid "A devil? I didn't take the Blade for a fool. I'm - <i>ngh! </i>"
msgstr "데빌? 변경의 칼날이 바보인 줄은 몰랐는데. 나는 - <i>윽!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 7ab29781-92d2-fcb5-35e7-51d52e65dcb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7ab29781-92d2-fcb5-35e7-51d52e65dcb1
msgctxt "haa5bbabdgccfbg410fg9fc3g2146c97d3cf2"
msgid "Shit. <i>Shit.</i>"
msgstr "젠장. <i>젠장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 7b87f38e-146c-ffc8-426e-7dc24367650c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7b87f38e-146c-ffc8-426e-7dc24367650c
msgctxt "h798f42eeg2e26g4e48g8ff5gcdf50ad34417"
msgid "If you'd just hear me out -"
msgstr "일단 내 얘기 좀 들어보면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = 7be7528f-757c-f6b7-9b3d-5cd41c19c97d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7be7528f-757c-f6b7-9b3d-5cd41c19c97d
msgctxt "h532231b7g9e20g4639g9f26gc65373d8b236"
msgid "*A great fire roars through you - the fire of the First Hell.*"
msgstr "*거대한 불길이 내면을 휩씁니다. 첫 번째 지옥의 그 불길이 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 7d87be35-81ca-dfcf-101f-fc874e3aef1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7d87be35-81ca-dfcf-101f-fc874e3aef1d
msgctxt "h39f46939ga197g4f93g8c2eg5fa4950edaa0"
msgid "<i>And yet you served.</i>"
msgstr "<i>섬긴 건 섬긴 거지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = 7f6892e6-df18-3ce5-25fc-f51637b9577e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Threat = False
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Threat = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:7f6892e6-df18-3ce5-25fc-f51637b9577e
msgctxt "h9174361agcdaeg45d6gb315g97bd24b7d58a"
msgid "It's you I don't trust, Wyll. You wanted a fight? You've got it."
msgstr "못믿을 놈은 너지, 윌. 그렇게 싸우고 싶냐? 나랑 붙어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 81d197fe-ed0d-47bd-9be8-187691cba4d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = False
#. SetFlags:
#.   Global:
#.     - GLO_WyllConfrontation_Event_WyllConfrontedKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:81d197fe-ed0d-47bd-9be8-187691cba4d1
msgctxt "h46e4890egd255g4dabg8c3cg2bfe8f4ffd0f"
msgid "One horn. The stink of Avernus. <i>Advocatus diaboli.</i>"
msgstr "외뿔년. 아베르누스의 고약한 악취. <i>아드보카투스 디아볼리.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 87681d07-5a9e-5423-6e75-981da53d4ca9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:87681d07-5a9e-5423-6e75-981da53d4ca9
msgctxt "h67d051e8g00f5g4264ga15bgba373969379b"
msgid ""
"You saw the truth. I may be an effective soldier, but I never wanted to "
"serve Zariel. Legged it <i>away </i>from her the first chance I got."
msgstr ""
"진실을 봤잖아. 자리엘의 병사로 특출나긴 했지만, 절대 좋아서 그년을 섬긴 게 아니야. 기회가 생기자마자 바로 <i>도망쳤다고</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Gale
#. NodeID = 8a061112-6033-8002-60b0-3ef4f90143be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(6) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:8a061112-6033-8002-60b0-3ef4f90143be
msgctxt "hc9b346b5gba88g4ecfgbd74g2f2c71e55021"
msgid "Easy, Wyll. She's no devil. There's no fight to be had here."
msgstr "진정해, 윌. 저쪽은 데빌이 아니야. 싸울 이유가 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = 8b9ddff8-f409-ccf5-8e8a-59a23ffbb014
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:8b9ddff8-f409-ccf5-8e8a-59a23ffbb014
msgctxt "hfcecf662g5faag47bdg8d27g226f5471a367"
msgid ""
"*Her rage and desperation seep into you. She is a victim of the Blood War, "
"not an agent of it.*"
msgstr "*여자의 분노와 절박감이 스며듭니다. 그녀는 피의 전쟁의 수행자가 아닌, 피해자였던 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = 8da7bd4d-7833-0bba-6f22-6655a52c6bb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:8da7bd4d-7833-0bba-6f22-6655a52c6bb4
msgctxt "h0d73d5a6gd68fg4ed3ga338g4c41240f36bc"
msgid ""
"I see the good in you, Karlach. I promise not to lose sight of it, even when "
"the Hells burn hottest."
msgstr "난 네 선한 면을 봤다, 칼라크. 지옥이 아무리 뜨겁게 눈앞을 아른거려도 그 면을 잊지 않겠노라 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = 977262e2-8dbc-b1a4-0ed3-dbf7a67012ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:977262e2-8dbc-b1a4-0ed3-dbf7a67012ca
msgctxt "hf47d47f6gdec9g462dga6ceg2ee3a2a7f8b1"
msgid ""
"I'm asking you to <i>live</i>, Wyll. I don't want to hurt you. And, to be "
"frank, I'd rather not find out how the Blade got his name."
msgstr ""
"난 <i>살 길</i>을 요구하는 거야, 윌. 난 널 해치고 싶지 않아. 내 쪽도 솔직히 '변방의 칼날’이 어떻게 명성을 얻은 건지 "
"체험하고 싶지 않고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = 98c821c7-b3b0-0086-2c4f-7605106e34c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:98c821c7-b3b0-0086-2c4f-7605106e34c9
msgctxt "hd76710c5ge956g4d30g8d31ge223b388eefb"
msgid ""
"*You are Karlach, tearing through demons across a blood-red landscape of "
"fire and volcanic cinder.*"
msgstr "*당신은 칼라크입니다. 불과 화산재로 뒤덮인 핏빛 풍경을 누비고 다니며 데몬들을 찢어발기고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Astarion
#. NodeID = 9ccec3b8-34ad-31b6-da7b-bd471d335bfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:9ccec3b8-34ad-31b6-da7b-bd471d335bfa
msgctxt "h67a68b14gc2dfg49e0gbfc3g0597b40fe819"
msgid ""
"Now, now, children - let's not lose our heads. Figuratively or literally."
msgstr "자, 자, 얘들아. 괜히 머리 뚜껑 터뜨리진 말자고. 비유적으로든, 문자 그대로든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = a2325e2d-678c-32f2-6cfd-310544eb7184
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_ResolvedPeacefuly = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:a2325e2d-678c-32f2-6cfd-310544eb7184
msgctxt "h19b34d4egcdd0g4883ga3e8ge4a243e0e088"
msgid "You saw Karlach's thoughts. She poses no threat to the Sword Coast."
msgstr "칼라크의 생각을 읽었잖아. 소드 코스트에 해를 끼칠 사람이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = a46a5373-34dc-0878-3b03-63081d99af36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:a46a5373-34dc-0878-3b03-63081d99af36
msgctxt "hdb5c6e32g31b5g4604g88e4g9655ebc36c75"
msgid ""
"*Wyll shudders with Karlach's desperation. She is a victim of the Blood War, "
"not an agent of it.*"
msgstr "*윌이 칼라크의 절박감에 몸서리칩니다. 그녀는 피의 전쟁의 수행자가 아닌, 피해자였던 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = a82aa312-46d0-df8f-4ffe-be7ae41ae495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:a82aa312-46d0-df8f-4ffe-be7ae41ae495
msgctxt "hb0fecee0gd836g4cccgbed5gd017971b9bc5"
msgid ""
"Yeah, I stowed away on a <i>mind flayer ship </i>so I could bring the war "
"home. Makes perfect sense."
msgstr "그래, 그래서 내가 고향 전쟁터로 만들려고 골라 탄 게 <i>마인드 플레이어 함선</i>이다? 거 참 끝내주는 논리네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Shadowheart
#. NodeID = ac4fdb34-9285-42df-b9d3-8929a4936204
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:ac4fdb34-9285-42df-b9d3-8929a4936204
msgctxt "he493e71bga95dg4c73g9f87gf75e2bcd0e53"
msgid "You two have met before, I take it?"
msgstr "어째 서로 아는 사이인 눈치인걸?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = ae995c8c-ce0e-b66b-d9c6-8016d9a526c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:ae995c8c-ce0e-b66b-d9c6-8016d9a526c6
msgctxt "h9032fc35ge3c4g40eegbbb1gf3ffd91a7af9"
msgid ""
"If by 'met' you mean hoofing it through the Hells with this fucker on my "
"tail."
msgstr "이 새끼가 내 꽁무니 쫓아 지옥 헤집고 다닌 것도 구면이라면 구면이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = b3f9d9b7-59cb-1f57-5c7f-39ff49e1652a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:b3f9d9b7-59cb-1f57-5c7f-39ff49e1652a
msgctxt "h59fea6b8g316eg471eg9b4eg7e8fe5c87282"
msgid "For fuck's sake, you must be half troll to have a skull that thick."
msgstr "미치고 팔짝 뛰겠네. 대가리 수준 보니 하프 트롤이 따로 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = b55a6cb0-3267-8aab-3bcb-b1e58b9cf812
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:b55a6cb0-3267-8aab-3bcb-b1e58b9cf812
msgctxt "h12d52244g656bg4984gbfb0g2b561811e08f"
msgid ""
"Well met. Now let's kick some arse while there's still arse to be kicked."
msgstr "반가워. 이제 혼꾸멍 내줄 놈들 찾아다 혼꾸멍을 내주자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = ba489ca5-3688-0191-417e-04b207252aa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:ba489ca5-3688-0191-417e-04b207252aa5
msgctxt "h3e6de05cg90f1g4ec2g9b67gbcddb9b1db67"
msgid ""
"Would you listen to sense? This doesn't have to end badly - for either of us."
msgstr "좀 이성적으로 굴지 그래? 꼭 험한 결말 맞을 필요는 없다고. 너나 나 어느 쪽이든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = ba6f8400-3b44-17f0-b409-df44cec0aca1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:ba6f8400-3b44-17f0-b409-df44cec0aca1
msgctxt "h8df83f88g43f0g4b02g971dgbb8f72df860e"
msgid "I can live with that. Besides, I enjoy winning hard cases over."
msgstr "그 정도면 충분해. 게다가, 난 어려운 과제 해내는 걸 좋아하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = bed32631-11c1-8842-4873-3e48f16e31fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:bed32631-11c1-8842-4873-3e48f16e31fa
msgctxt "h68209bd3g7928g47fbg935bg542abe939e65"
msgid "You really are no devil, are you? I've... I've been deceived."
msgstr "넌 정말 데빌이 아니구나? 내가... 내가 속고 있었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = bfc03d18-6a9a-a0ef-66da-f5fd4c37a77c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_ResolvedPeacefuly = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:bfc03d18-6a9a-a0ef-66da-f5fd4c37a77c
msgctxt "hebff9ad9g7980g4849gbfc2gd2ae24583f7a"
msgid "Fine, but he needs to stand down. We saw the truth for ourselves."
msgstr "좋아. 얘는 성질 좀 죽여야겠지만. 우리 모두 진실을 봤잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = c0b44b97-1ffe-8af0-1978-79be75064b55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:c0b44b97-1ffe-8af0-1978-79be75064b55
msgctxt "h3b9023cdg0f08g4258g86dfgb9379a50f439"
msgid "You know, I could've used a few friends. Pity that won't be any of you."
msgstr "있잖아, 난 친구가 좀 있었으면 했거든. 너네는 아니라 참 아쉽게 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = c461610e-5dc9-6239-fb91-3be197887362
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_KarlachLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:c461610e-5dc9-6239-fb91-3be197887362
msgctxt "h4ac38488g14a2g4372g9c76gb741c654cb13"
msgid "Save your breath. Let's see if this devil bleeds."
msgstr "더 떠들 필요 없다. 데빌도 어디 피를 흘리는지 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = c4b56d85-1a21-40f1-0168-840ef04294b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:c4b56d85-1a21-40f1-0168-840ef04294b6
msgctxt "h5bd9018dg372cg41a3g8c5eg1283f198381e"
msgid "Fuck. I'll never get used to that."
msgstr "씨발, 진짜 적응 안 된다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = c7e464e4-a590-7184-b9f1-0b8313d58311
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_KarlachLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:c7e464e4-a590-7184-b9f1-0b8313d58311
msgctxt "h99460286g3c18g4c72ga267g65548a7df203"
msgid "I'm sorry, Karlach. There's too much at stake."
msgstr "미안하군, 칼라크. 봐주기엔 너무 많은 게 걸려있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Gale
#. NodeID = ca6c248d-3719-460f-81a0-6ae13d256a80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(6) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:ca6c248d-3719-460f-81a0-6ae13d256a80
msgctxt "h40cf8ae8g25e8g48d3g8d70g460336140ac3"
msgid "You two have met before, I take it?"
msgstr "어째 서로 아는 사이인 눈치인걸?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = cc66f53b-268e-5702-ec95-e0144c58589b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:cc66f53b-268e-5702-ec95-e0144c58589b
msgctxt "h57a2f4beg8b22g4a3bg836eg36c1c6a0d210"
msgid "By Balduran's helm, I - no. I will not be tricked!"
msgstr "발더란 맙소사, 나는... 아니야! 네 수작엔 안 넘어가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = cd6d11d3-15c2-5502-1721-99eae18b74f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:cd6d11d3-15c2-5502-1721-99eae18b74f4
msgctxt "h3f3240c4g07e1g4e4dg8056g2892151f45e4"
msgid ""
"You know monsters, right? Better than anyone. Look into my eyes. Can't you "
"see I'm not what you think?"
msgstr "넌 괴물에 대해 잘 알지? 누구보다 잘 알 텐데. 내 눈 똑바로 봐. 정말 내가 그런 것들로 보여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = ceadf50e-1741-5f24-a21a-1ec5d71d7373
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:ceadf50e-1741-5f24-a21a-1ec5d71d7373
msgctxt "h9f4b1ce3g9de4g46c3gb9f1ge2af48ba1669"
msgid "It's done, Karlach. By my living soul, you will forever <i>burn.</i>"
msgstr "끝이군, 칼라크. 내 영혼에 맹세코, 넌 영원히 <i>불탈 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = d132fe33-f211-01d9-4cf1-ed714f5ed46e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Threat = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:d132fe33-f211-01d9-4cf1-ed714f5ed46e
msgctxt "h916b19d5g2eafg47cag84fdgde605dab6d9c"
msgid "You want a fight Wyll? I'll give you one."
msgstr "그렇게 싸우고 싶냐, 윌? 그럼 나랑 붙어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = d4671b77-f4e5-6b45-931f-c1bae6ece660
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:d4671b77-f4e5-6b45-931f-c1bae6ece660
msgctxt "h78925f85gd99cg4f5fgb9fdgceb2a4f41587"
msgid "I don't need more friends."
msgstr "난 친구 더 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = da3a729b-df69-252e-12f5-efb3bdf3ab34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_KarlachLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:da3a729b-df69-252e-12f5-efb3bdf3ab34
msgctxt "h6cf740cbg1505g4439gaca3gc831fa31f546"
msgid "I should never have trusted you, Karlach. You're as good as dead."
msgstr "애초에 믿을 만한 녀석이 아니었군, 칼라크. 넌 이만 죽어줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = dfb038ea-219d-e818-6147-6039e3c95fbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:dfb038ea-219d-e818-6147-6039e3c95fbc
msgctxt "h60c036d7g3200g45fbg8906ge1fdfe4da43b"
msgid "My sources say otherwise. Not a devil? Prove it."
msgstr "내 정보원은 맞다고 했어. 데빌이 아니시다? 증명해 보시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = e06b70e8-5ffd-e1a1-abe9-28459ea0c78d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:e06b70e8-5ffd-e1a1-abe9-28459ea0c78d
msgctxt "hb9979d6eg149dg4fa8ga8cag233737ddeed4"
msgid "Be practical. She's infected, same as us. We need allies, not enemies."
msgstr "현실적으로 생각해. 쟤나 우리나 감염된 상태잖아. 우리에게 필요한 건 동료지, 적이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Astarion
#. NodeID = e148c131-f8be-46a4-bd42-83fc4d176a9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Local:
#.     - b82d65b0-54ad-0156-4c5b-92c0a6f47937_Inclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:e148c131-f8be-46a4-bd42-83fc4d176a9a
msgctxt "h3f13bbf0gde1cg47f9g8238g9de6c1ed6965"
msgid "Oh marvellous, you've already met."
msgstr "오, 신기해라. 아는 사이인가 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Wyll
#. NodeID = e252f847-df28-de95-24d1-37db4b4958a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:e252f847-df28-de95-24d1-37db4b4958a8
msgctxt "ha341504bg9b36g4388gadadg39a83f3ea4fd"
msgid ""
"You would've died in the attempt. But - there have been enough threats today."
msgstr "그랬다면 죽는 건 너였을걸. 하지만 날 세우는 건 충분히 했으니 그만하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = e433dff7-ddda-b669-e45e-29d151cebe32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:e433dff7-ddda-b669-e45e-29d151cebe32
msgctxt "h449e7213g69a4g409eg92d5g118f8d55544c"
msgid "You know, I could've used a few friends. Pity that won't be any of you."
msgstr "있잖아, 난 친구가 좀 있었으면 했거든. 너네는 아니라 참 아쉽게 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = e8c0212f-7a34-06c4-68f3-1ba75a71b4df
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_KarlachLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:e8c0212f-7a34-06c4-68f3-1ba75a71b4df
msgctxt "h7aa8a96bgf85bg4ee1gb464gc07dc850a217"
msgid "No. No second-guessing. The devil dies - now."
msgstr "아니. 다른 여지 따윈 없어. 저 데빌은 죽을 거다. 지금."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = ef8dd2f5-211b-3a9b-9b8d-6b3b0d6d0e59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:ef8dd2f5-211b-3a9b-9b8d-6b3b0d6d0e59
msgctxt "h95e43245g0208g4e29gb34fg7c88092278ce"
msgid ""
"How should I do that exactly? Carve out my soul to serve with a nice side of "
"turnips?"
msgstr "뭘 정확히 어쩌란 얘기야? 내 영혼 뽑아다 때깔 좋은 순무랑 곁들여 바치기라도 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = f374d302-0cbe-4c97-6803-3b4cf471a570
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:f374d302-0cbe-4c97-6803-3b4cf471a570
msgctxt "h8150fddcga757g4ebega603g5f501d79d001"
msgid ""
"You don't know what this means. You don't know what you're asking me to do."
msgstr "넌 이게 뭘 의미하는지 몰라. 내게 뭘 요구하는 건지 모른다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = f494277e-5d6a-ecbc-657d-38e29546e2d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:f494277e-5d6a-ecbc-657d-38e29546e2d7
msgctxt "h651f6220g4e58g432bga4a0g9bd426fd0731"
msgid "I swear to you, on all I am, I'm not what you think."
msgstr "내 모든 걸 걸고 맹세컨대, 난 네가 여기는 존재가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Karlach
#. NodeID = f5bee0e6-1a5a-293f-1edb-f6b00e5a8177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:f5bee0e6-1a5a-293f-1edb-f6b00e5a8177
msgctxt "hecca22deg7cc8g493ag8248g2c68eb412dcf"
msgid ""
"Look - it's an honour to be chased by a famed hero. I'm no devil, though. "
"Not by a long shot."
msgstr "야, 유명한 영웅한테 쫓기는 건 나름 영광이긴 해. 난 데빌이 아니지만. 전혀 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Player
#. NodeID = f979cb5a-3688-5bfe-c40b-f89a5261a18a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_KarlachLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:f979cb5a-3688-5bfe-c40b-f89a5261a18a
msgctxt "h92268988ga3c7g480dga65fg368b4087f3e1"
msgid "You're right. Let's cut her down before she causes any trouble."
msgstr "맞는 말이네. 문제 일으키기 전에 이 자리에서 베어버리도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM
#. Speaker = Narrator
#. NodeID = fa49cd1e-37d4-9e6f-88e2-29964f577dd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_IVB_CFM:fa49cd1e-37d4-9e6f-88e2-29964f577dd4
msgctxt "h98e34771g52d8g487bgb3abga6250b42ad8d"
msgid ""
"*The front lines of the Blood War. With every swing of her axe, Karlach "
"fulfils mistress Zariel's purpose.*"
msgstr "*피의 전쟁의 최전선. 칼라크가 도끼를 휘두를 때마다 여군주 자리엘의 목적이 완수됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 00ba8495-8280-49fa-8d98-6555ac0e196e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:00ba8495-8280-49fa-8d98-6555ac0e196e
msgctxt "h63798b6cg4939g48f8g8929g9a36aa47cca8"
msgid ""
"You would've died in the attempt. But - there have been enough threats today."
msgstr "그랬다면 죽는 건 너였을걸. 하지만... 날 세우는 건 충분히 했으니 그만하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 01ef245c-da1e-28fd-a714-e60194e28d22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Wyll = False
#.      - Wyll_Recruitment_Event_RecruitedOnce = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:01ef245c-da1e-28fd-a714-e60194e28d22
msgctxt "h824cee38g36b3g4a4ega845g90db874abfca"
msgid "Truce."
msgstr "휴전하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 048cd273-822f-3fe7-8ba2-9a3aab5a0220
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:048cd273-822f-3fe7-8ba2-9a3aab5a0220
msgctxt "h7ee3496bgf901g4cc4gbc9agf8fe5b7625ec"
msgid "You seem like a good crew."
msgstr "넌 동료로 훌륭할 것 같은걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 049fbac2-f8d8-7dd5-626d-99b0493a5be5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:049fbac2-f8d8-7dd5-626d-99b0493a5be5
msgctxt "h31627fe9g7cc2g4295gbaa2gfa242835946f"
msgid "You really are no devil, are you? I've... I've been deceived."
msgstr "넌 정말 데빌이 아니구나? 내가... 내가 속고 있었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 0b78dec9-3bad-9f71-8e97-3f4367530122
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:0b78dec9-3bad-9f71-8e97-3f4367530122
msgctxt "h58e9d949gaa4eg4000ga490g8abb3a1b8ec0"
msgid "You two know each other, I see."
msgstr "보아하니 너희 둘은 구면인 모양이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 11949bc1-089b-a120-00a1-53ed5fea2be8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c89b23bf-d6a3-8d58-11e1-ee036cdac588_Threat = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:11949bc1-089b-a120-00a1-53ed5fea2be8
msgctxt "hde8f3a21gf4f4g4c42g86b0ga9b19d1d61d1"
msgid ""
"You invade my camp and threaten my friend? You're the one dying tonight."
msgstr "우리 야영지에 쳐들어와선 내 친구를 위협해? 오늘 밤 죽는 건 너다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 12204f46-715c-6282-b3d8-96b331aa99cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:12204f46-715c-6282-b3d8-96b331aa99cd
msgctxt "h21c838dbg936dg4958gb8a1g0823ebf29eb4"
msgid "The more the merrier, as they say."
msgstr "다다익선이란 말도 있으니 좋지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 125ec371-f3b5-5b63-15a1-3159b8b662ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:125ec371-f3b5-5b63-15a1-3159b8b662ff
msgctxt "h46bc0218gda3cg474cga21fg5a1b149a307d"
msgid "You've got it all wrong, Wyll. Karlach's not about to hurt anyone."
msgstr "잘못 알고 있어, 윌. 칼라크는 아무도 해칠 생각 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 13cd0464-8157-cad8-f656-415437e332dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:13cd0464-8157-cad8-f656-415437e332dd
msgctxt "h986bbaa7gf85dg4936g8c26ge631b9828fce"
msgid "The devil's way, isn't it? So casually cruel. I -"
msgstr "딱 데빌답게 구는군. 피 보는 게 상식이지. 나는..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 15657bfa-8a5b-44b2-e72f-7dc5516ac655
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:15657bfa-8a5b-44b2-e72f-7dc5516ac655
msgctxt "h5420ae47g1b2dg401fg8078g55ee9e863d31"
msgid "Thank the gods. I thought I was going to have to take your head."
msgstr "거 참 다행이네. 이러다 네 모가지를 따버리는 거 아닌가 싶었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 17e41a06-bbd3-7898-e8be-d7b378b27db1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:17e41a06-bbd3-7898-e8be-d7b378b27db1
msgctxt "h404175b9gae0fg414eg8c41g80e07f0080e6"
msgid ""
"We're looking to get rid of these parasites for good - and ruin some "
"bastards' days while we're at it. Sounds like your kind of venture."
msgstr ""
"우린 기생충을 떼어내버릴 방법을 찾고 있거든. 그러면서 마주치는 망할 놈들 인생도 박살내고. 너 같은 사람한테 딱 어울리는 모험일걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 18122011-b1a0-aa15-c3c3-a5f5f131f636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:18122011-b1a0-aa15-c3c3-a5f5f131f636
msgctxt "h4bf8dbccgcd46g4b83gb9cfg1f41f1a7b4e8"
msgid "Yes, you have my blade - not to mention, a thousand sorries. "
msgstr "좋아, 내 힘을 빌려줄게. 그리고 말인데, 정말 진심으로 미안해. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 18fe0c30-822b-0511-2d56-e2f2516f1189
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_WyllLeft = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:18fe0c30-822b-0511-2d56-e2f2516f1189
msgctxt "h4857392eg05ceg4e68gba93gfd8676b25577"
msgid ""
"I see the good in you, Karlach. I promise not to lose sight of it, even when "
"the Hells burn hottest."
msgstr "난 네 선한 면을 봤다, 칼라크. 지옥이 아무리 뜨겁게 눈앞을 아른거려도 그 면을 잊지 않겠노라 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 1ac0f35b-366f-83c2-94b8-82ee076fe2e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Wyll_GlobalHasMet = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:1ac0f35b-366f-83c2-94b8-82ee076fe2e3
msgctxt "h57ebeb48g6444g48f2g8439g67f73df90de6"
msgid "Karlach. <i>Advocatus diaboli.</i> The stink of Avernus."
msgstr "칼라크. <i>아드보카투스 디아볼리.</i> 아베르누스의 고약한 악취."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 1bafc8ab-10f9-e17f-e2a0-4dda75848be7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:1bafc8ab-10f9-e17f-e2a0-4dda75848be7
msgctxt "h9a022abeg16aag411cgb969g73c35846d308"
msgid "It's about time. Shall I put the kettle on?"
msgstr "드디어 납셨네. 그럼 슬슬 한 판 붙어볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 1fe13e77-f4ac-3353-b781-a029b2f24b22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:1fe13e77-f4ac-3353-b781-a029b2f24b22
msgctxt "h5ebe45f5gf6cdg40e8g87e8g1d6493615443"
msgid ""
"I see the good in you, Karlach. I promise not to lose sight of it, even when "
"the Hells burn hottest."
msgstr "난 네 선한 면을 봤다, 칼라크. 지옥이 아무리 뜨겁게 눈앞을 아른거려도 그 면을 잊지 않겠노라 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 210cfbc5-10e8-5601-8976-de0285a8f3f8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_KarlachLeftHostile = True
#.   Object:
#.     - CAMP_Wyll_Event_KarlachHostile(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:210cfbc5-10e8-5601-8976-de0285a8f3f8
msgctxt "h021256bdg814bg4a96ga0efg5ddd91c560b0"
msgid "You know, I could've used a few friends. Pity that won't be any of you."
msgstr "있잖아, 난 친구가 좀 있었으면 했거든. 너네는 아니라 참 아쉽게 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 227ce4bb-4538-2710-42db-e936d9b68157
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Wyll = False
#.      - Wyll_Recruitment_Event_RecruitedOnce = True
#.   Tag:
#.      - AVATAR(0) = False
#. SetFlags:
#.   Global:
#.     - GLO_WyllConfrontation_Event_WyllConfrontedKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:227ce4bb-4538-2710-42db-e936d9b68157
msgctxt "h34cb8bfcg18c4g4b8fg96dbg1694065841a8"
msgid "One horn. The stink of Avernus. <i>Advocatus diaboli.</i>"
msgstr "외뿔년. 아베르누스의 고약한 악취. <i>아드보카투스 디아볼리.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 22f2550b-bb0d-b8a5-19c5-08ba9591a4ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c89b23bf-d6a3-8d58-11e1-ee036cdac588_Trust = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:22f2550b-bb0d-b8a5-19c5-08ba9591a4ea
msgctxt "h25e6880ag041cg4670gab5dg781e17e3816e"
msgid ""
"I've pledged my life to protecting the meek from monsters - but tonight, I "
"was the rampaging beast."
msgstr "괴물로부터 양민들을 지키는데 내 삶을 바치겠다 맹세했건만. 오늘은 내가 미쳐날뛰는 짐승이었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 23ce1c12-3bb0-aa55-737c-649335c7230b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:23ce1c12-3bb0-aa55-737c-649335c7230b
msgctxt "hece310e8g6d9cg4670gacf9g2007be5f00f0"
msgid ""
"*You are Karlach, tearing through demons across a blood-red landscape of "
"fire and volcanic cinder.*"
msgstr "*당신은 칼라크입니다. 불과 화산재로 뒤덮인 핏빛 풍경을 누비고 다니며 데몬들을 찢어발기고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 24aaf1aa-7f76-4033-ff80-76fa052573a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:24aaf1aa-7f76-4033-ff80-76fa052573a6
msgctxt "h247c8c13g64ccg4718gb4b1g315bb3fe76c5"
msgid "Then I live up to my repute. And you - "
msgstr "그럼 기대에 부응해줘야겠군. 넌 이제... "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 27967d06-207e-ac95-504d-ff46a4cecc29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:27967d06-207e-ac95-504d-ff46a4cecc29
msgctxt "hf17b5326g77fcg4211gb62egb3b061467f4f"
msgid "Truce. But I think it's best if you get on your way."
msgstr "휴전하자. 다만 넌 이만 네 갈 길 가는 편이 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 2d4db993-df69-a40d-ee45-a285f1a3948f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:2d4db993-df69-a40d-ee45-a285f1a3948f
msgctxt "h1370d608g9333g4812gb726gb1e99559fe7f"
msgid ""
"I've tried to tell you - I'm not what you think I am. I'm - <i>ngh! </i>"
msgstr "내 말 좀 들으라니까. 난 네가 여기는 그런 게 아니라고. 나는... <i>으윽! </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 2e3280d5-73e3-d2e0-1e0a-d8c64761e4ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:2e3280d5-73e3-d2e0-1e0a-d8c64761e4ac
msgctxt "h00039766g9af0g496eg8024g3b3da11cdde5"
msgid "*A great fire roars through you - the fire of the First Hell.*"
msgstr "*거대한 불길이 내면을 휩씁니다. 첫 번째 지옥의 그 불길이 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 30505e98-c3f4-6f2f-6010-c63464e9af95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:30505e98-c3f4-6f2f-6010-c63464e9af95
msgctxt "hfb73f6efgdcd8g44b7gbaa3gfc4ef5a7b2fc"
msgid "I hope he can count you in that number."
msgstr "그 용사에 너희도 포함된다면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 3146c702-f534-3bf6-1b1d-9e799886d3c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:3146c702-f534-3bf6-1b1d-9e799886d3c2
msgctxt "hcf07742dg5faag4087g8eefga2b549cd967b"
msgid "By Balduran's helm, I - no. I will not be tricked!"
msgstr "발더란 맙소사, 나는... 아니야! 네 수작엔 안 넘어가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 34a145a4-cfe0-00ee-79e3-a4aceaeff425
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:34a145a4-cfe0-00ee-79e3-a4aceaeff425
msgctxt "hef29b140g166cg41dbgbbe3g323fe6ca5513"
msgid ""
"*The man catches his breath, and his lips straighten. Sheer dread twists his "
"face.*"
msgstr "*남자가 숨을 고르며 입을 앙다뭅니다. 극도의 불안감에 표정이 일그러집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 365cc264-fbb8-b400-94b4-aa85b8681d22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:365cc264-fbb8-b400-94b4-aa85b8681d22
msgctxt "hf357de84ga30eg4a08ga4d3g5cb4c9a23238"
msgid ""
"*The man shudders with Karlach's desperation. She is a victim of the Blood "
"War, not an agent of it.*"
msgstr "*남자가 칼라크의 절박감에 몸서리칩니다. 그녀는 피의 전쟁의 수행자가 아닌, 피해자였던 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 3a3eb903-980e-7321-11ea-545dc56dda9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:3a3eb903-980e-7321-11ea-545dc56dda9c
msgctxt "h5c6143e6g42d3g4516g8bc6ga98a56bf256a"
msgid ""
"Be practical. You're infected, same as me. You need allies, not enemies."
msgstr "현실적으로 생각해. 넌 나처럼 감염된 상태잖아. 네게 필요한 건 동료지, 적이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 3b0ccf6c-1369-6683-8230-9cdbb9db114b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:3b0ccf6c-1369-6683-8230-9cdbb9db114b
msgctxt "h0230679dg9d82g4721g9224g81784112ca19"
msgid "Fair is fair. Tonight, I lost the right to be called 'hero'."
msgstr "어쩔 수 없지. 오늘 난 '영웅'이라고 불릴 자격도 없이 굴었으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 3b822f3b-5508-a3c4-46c1-1889d70f183e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:3b822f3b-5508-a3c4-46c1-1889d70f183e
msgctxt "h74410929g0bc3g4f7cgb67dg532943915f96"
msgid ""
"Shut it, devil - I know your kind. A heart darker than a shadow's "
"nightmares. You'd cut a child's throat just to taste the blood."
msgstr ""
"닥쳐, 데빌. 난 너희 족속을 잘 알아. 그림자의 악몽보다 속내가 더 시커먼 것들. 피를 맛 보겠다고 아이의 목을 거리낌없이 벨 놈들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 3c379125-a79f-083d-289a-7690f0492688
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:3c379125-a79f-083d-289a-7690f0492688
msgctxt "hf8b839a2g1676g427bg9afcg1be88965c1f8"
msgid ""
"If by 'met' you mean hoofing it through the Hells with this fucker on my "
"tail."
msgstr "이 새끼가 내 꽁무니 쫓아 지옥 헤집고 다닌 것도 구면이라면 구면이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 3cd49238-ee4a-ff8b-81c0-d8aa0a84346e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:3cd49238-ee4a-ff8b-81c0-d8aa0a84346e
msgctxt "h113774f8g67f9g47a0gaf2fga69659ba51ed"
msgid "By Balduran's helm, I - no. I will not be tricked!"
msgstr "발더란 맙소사, 나는... 아니야! 네 수작엔 안 넘어가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 40adb355-e940-5654-a1de-6244981ccf0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:40adb355-e940-5654-a1de-6244981ccf0e
msgctxt "h14a8a843g8694g4522ga661gba810af58c77"
msgid "Fine, but he needs to stand down. We saw the truth for ourselves."
msgstr "좋아. 저치는 성질 좀 죽여야겠지만. 우리 모두 진실을 봤잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 43cce1dd-d9ee-86d9-31f5-78a089fd88a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:43cce1dd-d9ee-86d9-31f5-78a089fd88a5
msgctxt "hf9e921abg2e87g451cg9decgde2af7e69c04"
msgid "You ally with an archdevil's chosen, and -"
msgstr "아크데빌의 선택받은 자와 동료인 주제에..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 442d73d7-fd85-5e07-98ec-490a3b7ed20f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:442d73d7-fd85-5e07-98ec-490a3b7ed20f
msgctxt "h6a0d8b3dgc9c4g41b1gaec7gae6f1428d48e"
msgid "My blade's found its prey. Zariel's chosen -"
msgstr "내 검은 사냥감을 겨눌 거다. 자리엘 년이 택한..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 46d2a57e-8759-7eda-184e-03eb5e4194ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:46d2a57e-8759-7eda-184e-03eb5e4194ac
msgctxt "h2287ab29gf514g4a7fg86f2g800dd39f5498"
msgid "Stand down. You saw what I saw - Karlach is not a danger."
msgstr "물러서. 너도 나랑 같은 걸 봤잖아. 칼라크는 위험한 자가 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 46fd6446-5373-7a08-6706-e7b9c50e68ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:46fd6446-5373-7a08-6706-e7b9c50e68ee
msgctxt "h3a271edcgf4f2g4c80g87eag7b10e19122a8"
msgid "Let my deeds to come prove my worth."
msgstr "내 가치를 행동으로 증명해보이겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 474be9bf-5b01-6d6f-8d1f-cd655721b0b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:474be9bf-5b01-6d6f-8d1f-cd655721b0b4
msgctxt "h3223c2cdg7c24g4fedga054g5d6e695b0b1b"
msgid "It's over, 'Blade'."
msgstr "얘기는 끝이다, '칼날'."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 474f1532-1bd9-dc8e-f4ab-b29ed66b598e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:474f1532-1bd9-dc8e-f4ab-b29ed66b598e
msgctxt "hbab72183g3a92g41dbg8cbdg0287babe71cb"
msgid "It's done, Karlach. By my living soul, you will forever <i>burn.</i>"
msgstr "끝이군, 칼라크. 내 영혼에 맹세코, 넌 영원히 <i>불탈 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 4ad61583-7021-0245-58f2-3356cf795114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:4ad61583-7021-0245-58f2-3356cf795114
msgctxt "h19bfa68fg29ffg4552gbca9g44c70a114a1c"
msgid "I'll do you one better: allies."
msgstr "더 나은 제안을 하지. 동료가 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 4b0c1696-bc62-5c22-209a-212cd838c244
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:4b0c1696-bc62-5c22-209a-212cd838c244
msgctxt "h1b3b9f0agb07eg4d74gb14egdbb42e5343c4"
msgid "I know exactly what you are. Zariel's -"
msgstr "난 네가 어떤 년인지 잘 알아. 자리엘의..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 4bde3f32-7f2a-43f5-152a-85a1e91aa93d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:4bde3f32-7f2a-43f5-152a-85a1e91aa93d
msgctxt "h2015adfdg00e0g4bcfgab14g5113a59777fa"
msgid "Shit."
msgstr "젠장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Shadowheart
#. NodeID = 4e2dc165-1523-24a1-6054-fe6afa7c46db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:4e2dc165-1523-24a1-6054-fe6afa7c46db
msgctxt "h49fc5d1egf0c9g43b3g9838g07063974fbb8"
msgid "Excellent. If we ever become friends, I'll know what to call you."
msgstr "그러셔. 만약에라도 친구가 된다면, 알려준 대로 불러줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 4f9efab3-616f-10f1-f0a7-0a57ee0f3c70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_ResolvedPeacefuly = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:4f9efab3-616f-10f1-f0a7-0a57ee0f3c70
msgctxt "h3f65ed6cg2e02g4233g89fcgbcbc449c89c6"
msgid ""
"I've not grown any tentacles yet, thank Balduran - but luck won't be on our "
"side forever."
msgstr "발더란이 보우하사, 내 몸에 촉수 돋아난 적은 아직 없었지. 하지만 그 운도 영원하진 않을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 50115011-5fe8-e20b-2ade-16401d61b7fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c89b23bf-d6a3-8d58-11e1-ee036cdac588_Gale = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:50115011-5fe8-e20b-2ade-16401d61b7fb
msgctxt "h59cc0566g45e5g4281g909ag514b97ac1f33"
msgid ""
"How about 'teammates'? Find a cure for these parasites, smash some skulls "
"together."
msgstr "같은 편 해먹는 건 어때? 같이 기생충 치료할 방법 찾고, 몇몇 놈 대가리도 박살 내자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 502e1564-ab22-6688-500e-136021af0cf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:502e1564-ab22-6688-500e-136021af0cf4
msgctxt "h7388f601g1276g453eg8bc6g3b822f323314"
msgid "Yes, you have my blade - your leader willing, of course."
msgstr "좋아, 내 힘을 빌려주겠어. 너희 리더가 허락한다면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 5212b143-62a5-c6c5-b09e-6688c1b36de2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:5212b143-62a5-c6c5-b09e-6688c1b36de2
msgctxt "h6d1c26dbg9467g4b5fgade8g6bdca6bf6208"
msgid ""
"*The man shudders with your desperation, and sees the naked truth: you are a "
"victim of the Blood War, not an agent of it.*"
msgstr "*남자가 당신의 절박감에 몸서리치며, 적나라한 진실을 마주합니다. 당신이 피의 전쟁의 수행자가 아닌, 피해자란 사실을 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 5713ae49-4893-a0d6-3c25-2ca3bce1e5b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:5713ae49-4893-a0d6-3c25-2ca3bce1e5b2
msgctxt "h4abf3bc9ge5d8g40b9gb3e0gc597d7528957"
msgid "Pride of the Coast, in the flesh. And you've got -"
msgstr "소드 코스트의 긍지가 직접 납셨다. 그리고 너는..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 5be4b6f9-a44c-a2db-f94f-ae62465abc90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:5be4b6f9-a44c-a2db-f94f-ae62465abc90
msgctxt "h339a1f59gf257g48bfg9fc9g344b24fad116"
msgid ""
"Infernal soldier, Zariel's lickspittle. I will not let you burn the Sword "
"Coast to ash."
msgstr "지옥의 병사, 자리엘의 졸개야. 네가 소드 코스트를 불태우게 두지 않을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 5c0d5f4d-6ffc-1b2d-84e0-f6b59a779ec6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:5c0d5f4d-6ffc-1b2d-84e0-f6b59a779ec6
msgctxt "h7651cb6eg6c80g45e3gad49ged8e97f4cef1"
msgid ""
"*The front lines of the Blood War. With every swing of her axe, Karlach "
"fulfils mistress Zariel's purpose.*"
msgstr "*피의 전쟁의 최전선. 칼라크가 도끼를 휘두를 때마다 여군주 자리엘의 목적이 완수됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 60042084-9d7d-d003-2f40-6d797afc9796
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_ResolvedPeacefuly = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:60042084-9d7d-d003-2f40-6d797afc9796
msgctxt "heccc461bg9103g4801gb471g3fe88923ee20"
msgid ""
"Would you listen to sense? This doesn't have to end badly - for either of us."
msgstr "좀 이성적으로 굴지 그래? 꼭 험한 결말 맞을 필요는 없다고. 너나 나 어느 쪽이든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 62ee008a-0e89-8faf-2874-62b5f89fbf4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Wyll_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:62ee008a-0e89-8faf-2874-62b5f89fbf4b
msgctxt "h31fcf182g82a6g4a0fgb933g00018ca43444"
msgid ""
"*You are the Blade of Frontiers, racing through the wastes of Avernus. Just "
"ahead, a familiar figure - red skin, single curled horn - blazes with flame, "
"bloodied greataxe held high.*"
msgstr ""
"*당신은 아베르누스의 폐허를 휘젓고 다니는 변경의 칼날이 됩니다. 그 코앞엔 붉은 피부에 구부러진 외뿔을 단 낯익은 형상이 불꽃에 "
"타오르며 피 묻은 그레이트엑스를 치켜들고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 638cb9b7-71b8-f31a-ad53-d507b742e6c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:638cb9b7-71b8-f31a-ad53-d507b742e6c9
msgctxt "h0158028cg03ddg4a18ga181g6ef5b76891e1"
msgid "Well, Wyll. I tried."
msgstr "에휴, 윌. 난 노력했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 644268ee-e5d0-6951-c59c-a1b2e999d149
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c89b23bf-d6a3-8d58-11e1-ee036cdac588_Threat = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:644268ee-e5d0-6951-c59c-a1b2e999d149
msgctxt "h0fcee018gfc80g4cabg9b6dg978448d61936"
msgid "The only one dying tonight's the Blade of Frontiers."
msgstr "오늘 밤에 죽는 건 변경의 칼날뿐일 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 6537bdf5-ba9d-81e3-ea76-aaf31f9e16f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c89b23bf-d6a3-8d58-11e1-ee036cdac588_Gale = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:6537bdf5-ba9d-81e3-ea76-aaf31f9e16f0
msgctxt "h04e37b38g7058g485eg8482g6a2f62a818e4"
msgid ""
"Great idea. You could join up with us - find a cure for these parasites, "
"smash some skulls."
msgstr "좋은 생각이네. 우리한테 합류해도 좋아. 같이 기생충 치료할 방법 찾고, 몇몇 놈 대가리도 박살 내자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 65c315d3-2e82-5a2d-3552-fd0eec9e4708
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_WyllConfrontation_Event_WyllConfrontedKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:65c315d3-2e82-5a2d-3552-fd0eec9e4708
msgctxt "h7224daa3g441ag40e9ga8c2gc3201e2e58ff"
msgid ""
"The Blade of Frontiers. Thought I'd shaken you for good after the mind "
"flayer ship. But you just can't get enough of me, can you."
msgstr "변경의 칼날이 납셨군. 그 마인드 플레이어 함선에서 떨쳐내버린 줄 알았는데. 정말이지 질리지도 않고 들러붙는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 69b4022e-3d0e-7523-0980-c20ac3abd57f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:69b4022e-3d0e-7523-0980-c20ac3abd57f
msgctxt "heda03ba6gf5a9g4940gb3b9g64244d3f0fc5"
msgid ""
"*He chases the fiend, ignited with rancour. She is an infernal wardevil, a "
"threat to the living - evil incarnate.*"
msgstr "*윌은 적의를 불태우며, 그 마족을 추격합니다. 그녀는 지옥의 워데빌이자, 산 자들에 대한 위협, 악의 화신입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 6cc703bb-e396-ad52-b997-50beba473ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:6cc703bb-e396-ad52-b997-50beba473ff4
msgctxt "hdb626e17g0882g4f5cg8ff7g5711307ee97f"
msgid "As you say."
msgstr "그렇게 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 6cf96976-2404-e458-e13a-753ba5e725f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:6cf96976-2404-e458-e13a-753ba5e725f4
msgctxt "h54c8a6cbg6f86g42e3g8326ge247d3c64ebf"
msgid ""
"*A great fire roars through you - the fire of the Hells you've escaped.*"
msgstr "*거대한 불길이 내면을 휩씁니다. 당신이 빠져나온 그 지옥의 불길이 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 6d4ebd39-7205-19f3-2195-0da6d22f878e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:6d4ebd39-7205-19f3-2195-0da6d22f878e
msgctxt "h77e629b3g7fccg45adg8b2dg79520b6db6f1"
msgid "A devil? I didn't take the Blade for a fool. I'm - <i>ngh! </i>"
msgstr "데빌? 변경의 칼날이 바보인 줄은 몰랐는데. 나는 - <i>윽!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 6faf6e5e-04ad-6d68-e8b0-a435a071d6ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Wyll_GlobalHasMet = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:6faf6e5e-04ad-6d68-e8b0-a435a071d6ba
msgctxt "h0a059885gf7c6g45b6g9fe4g9078dbcc2614"
msgid ""
"*You are the Blade of Frontiers, racing through the wastes of Avernus. Just "
"ahead, a diabolical figure - red skin, single curled horn - blazes with "
"flame, bloodied greataxe held high.*"
msgstr ""
"*당신은 아베르누스의 폐허를 휘젓고 다니는 변경의 칼날이 됩니다. 그 코앞엔 붉은 피부에 구부러진 외뿔을 단 사악한 형상이 불꽃에 "
"타오르며 피 묻은 그레이트엑스를 치켜들고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 6fc368b9-96c8-d0ff-4ae3-0a829bff41f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:6fc368b9-96c8-d0ff-4ae3-0a829bff41f0
msgctxt "h1fc6d5b9ga02bg4257g9aadgddf7546bd686"
msgid "You better lower that blade if you know what's good for you."
msgstr "사리 판단을 할 줄 안다면 그 검 치우는 게 좋을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 70fee4ac-3f12-fc5e-b8e5-76bc19a4fd1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:70fee4ac-3f12-fc5e-b8e5-76bc19a4fd1e
msgctxt "h9dc62d5agaa85g452dga823gb31a08156c97"
msgid "'The Blade of Frontiers'... Sounds familiar, but I'm not sure why."
msgstr "'변경의 칼날'이라... 왠지 귀에 익은데. 어째선지는 몰라도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 70fee4ac-3f12-fc5e-b8e5-76bc19a4fd1e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:70fee4ac-3f12-fc5e-b8e5-76bc19a4fd1e
msgctxt "head004c1g1294g49e3gae2fg4837b916afb7"
msgid "The Blade of Frontiers, hero of the Sword Coast. Have I got that right?"
msgstr "변경의 칼날이라. 소드 코스트의 영웅 말이지. 내 기억이 맞나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 71f77c89-fdb9-e118-bba1-81f1e4d5c487
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:71f77c89-fdb9-e118-bba1-81f1e4d5c487
msgctxt "h1fafb58cg5b6dg40d8g9d15gbd0a52e7a0ce"
msgid ""
"Karlach. The archdevil Zariel's gladiator, come to burn the Sword Coast to "
"ash."
msgstr "칼라크. 아크데빌 자리엘의 검투사. 소드 코스트를 잿더미로 만들러 온 자여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 729c5fb5-797e-059e-04ff-5bccd4ab1e1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:729c5fb5-797e-059e-04ff-5bccd4ab1e1a
msgctxt "h51d430c7g16c5g43c9g9f54g584efd364f8d"
msgid "I remember you, from the goblin fight at the grove. What do you want?"
msgstr "숲에서 같이 고블린 놈들과 맞서 싸웠던 사람이로군. 무슨 볼일로 온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 73db32cc-a657-d7fd-74d1-3e6cd198b13d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:73db32cc-a657-d7fd-74d1-3e6cd198b13d
msgctxt "h4256525ag3e6bg4fb8g8507g97e626adee89"
msgid "You saw the truth. I'm not a danger to the Coast."
msgstr "진실을 봤잖아. 난 소드 코스트에 대한 위협이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 74a7ce31-df2a-c456-38cc-e64e04abb67d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:74a7ce31-df2a-c456-38cc-e64e04abb67d
msgctxt "h909a1256gf2f5g4b0ega489gea02e6d3fc98"
msgid "I've heard enough! I - <i>ugh!</i>"
msgstr "그만 지껄여! 난... <i>으윽!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 74dc203c-1226-c808-477f-297fdd967949
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:74dc203c-1226-c808-477f-297fdd967949
msgctxt "h2d976c61g9ca5g4c27g8554g123f68ac099a"
msgid "The hero from the druid's grove. What do you want?"
msgstr "드루이드 숲의 영웅이시군. 무슨 볼일로 온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 769661be-8fb1-6f19-8df0-e7fdbaf30394
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:769661be-8fb1-6f19-8df0-e7fdbaf30394
msgctxt "h9f564025g2eecg4486g85acg365999fddc7a"
msgid "<i>No. </i>Devils can <i>not</i> be trusted!"
msgstr "<i>아니. </i>데빌은 믿을 수 <i>없어</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 77878200-c918-09e3-f909-a6b0748fe1ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:77878200-c918-09e3-f909-a6b0748fe1ae
msgctxt "hc57df9d1g4655g42f0g8f38g96faca52f3a1"
msgid "*A great fire roars through you - the fire of the First Hell.*"
msgstr "*거대한 불길이 내면을 휩씁니다. 첫 번째 지옥의 그 불길이 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Gale
#. NodeID = 788bf16e-fea8-9602-5463-3d892509c310
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(4) = True
#. SetFlags:
#.   Local:
#.     - c89b23bf-d6a3-8d58-11e1-ee036cdac588_Gale = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:788bf16e-fea8-9602-5463-3d892509c310
msgctxt "h4649d54eg5023g46d2g84begaaded60deade"
msgid ""
"Stormy introduction aside, might I suggest a partnership instead? The Blade "
"of Frontiers would make a formidable ally."
msgstr "폭풍 같았던 첫만남은 이만 잊고, 대신 동료가 되는 건 어떻겠어? 변경의 칼날이라면 든든한 동료가 되어줄 거 같은데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 79410950-35cc-ea39-b04e-4c98479a5313
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:79410950-35cc-ea39-b04e-4c98479a5313
msgctxt "h42907535g12a2g4aa5gb44ag14bcf32d5244"
msgid "I can only hope you won't have to find out."
msgstr "네가 알게 될 일이 영영 없길 바랄 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 7cd5f77f-1e2d-6438-fde9-715acc196fdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:7cd5f77f-1e2d-6438-fde9-715acc196fdf
msgctxt "hea25be75geb3eg496cga4f2gd57d6b00dc5b"
msgid ""
"For shit's sake, you really don't know how Zariel 'recruits' her soldiers, "
"do you?"
msgstr "이런 우라질. 너 자리엘 년이 어떤 식으로 자기 병사를 '모으는지' 전혀 모르는구나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 7e7214a5-741f-fe00-52c8-ca57d3c8a315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:7e7214a5-741f-fe00-52c8-ca57d3c8a315
msgctxt "hf61c19fdgbbd6g4b10g8429gb9bfe2bbf9f5"
msgid ""
"I see the good in you, Karlach. I promise not to lose sight of it, even when "
"the Hells burn hottest."
msgstr "난 네 선한 면을 봤다, 칼라크. 지옥이 아무리 뜨겁게 눈앞을 아른거려도 그 면을 잊지 않겠노라 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 803cdf4b-25fb-be1f-448f-5c165efb583d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:803cdf4b-25fb-be1f-448f-5c165efb583d
msgctxt "h5c9749b6ge30cg4670g9276g13fac1753741"
msgid "Thank the gods. Thought I was going to have to take your head."
msgstr "거 참 다행이네. 이러다 네 모가지를 따버리는 거 아닌가 싶었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 80b5bd11-b7c1-0a0e-6266-d2ed594f5ebc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:80b5bd11-b7c1-0a0e-6266-d2ed594f5ebc
msgctxt "h21fe805cgb889g4574gbe37gaa98d0a9143d"
msgid "I'm returning to the grove. Zevlor's people need champions."
msgstr "이만 숲으로 돌아가야겠어. 제블로어네 사람들은 용사가 필요하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 82323a73-9534-49be-ba56-d320c69f68e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:82323a73-9534-49be-ba56-d320c69f68e7
msgctxt "h3162405agb9c0g4392g97ddgb5f2a9268af5"
msgid "Heyy!"
msgstr "아싸!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 826b7e50-60a8-2ac3-5d49-21e80e86c630
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:826b7e50-60a8-2ac3-5d49-21e80e86c630
msgctxt "h79f3a0d5g8419g42a5g89f8g7f76839d6690"
msgid "I captured your target, Wyll. Why don't you do the honours?"
msgstr "여기 네 사냥감을 잡아놨어, 윌. 나머지 일은 네가 맡는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 83d3e4ff-5e93-55c9-15e2-399ca0209831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:83d3e4ff-5e93-55c9-15e2-399ca0209831
msgctxt "hac58f626ga8c6g4c78g9d40g25115d4b1d5f"
msgid "Stand back. The first strike is mine."
msgstr "물러서. 선공은 내가 가져가도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 856d3bc7-bbf8-961f-7845-31eae4e79f1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:856d3bc7-bbf8-961f-7845-31eae4e79f1e
msgctxt "h8fa2b68bge3b2g4f7cgba33gfd68ac63136e"
msgid "Aw, come on."
msgstr "아, 좀 봐줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 893612f7-3ca8-bb55-bcd4-59d31220cb4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:893612f7-3ca8-bb55-bcd4-59d31220cb4b
msgctxt "h94365d5egedb6g4152g9209ge91f69e2d22d"
msgid "Karlach. The stink of Avernus."
msgstr "칼라크. 아베르누스의 고약한 악취."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 89eb1ec3-54b2-cbae-cd73-404bb87ab7ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:89eb1ec3-54b2-cbae-cd73-404bb87ab7ae
msgctxt "h85e44bdcgc2d9g4075ga3b2g504ab30cf82d"
msgid "Oh, here we go."
msgstr "아오. 또 시작이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 8a848c03-308e-0bd1-0616-1d29c0888b1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:8a848c03-308e-0bd1-0616-1d29c0888b1b
msgctxt "ha933e9cag5f1bg4125gb138gbcc883fc7ac4"
msgid "I had my reasons to hope I was right. But I can't deny the truth."
msgstr "데빌이라 믿어야 할 나름의 이유가 있었어. 하지만 진실을 부정할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 8e20b82b-903f-3b5b-3508-254287eacbdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:8e20b82b-903f-3b5b-3508-254287eacbdf
msgctxt "he416add4ga244g4f62gb1cdgf96ad7402764"
msgid "Gods, you're stubborn. Karlach's not a devil, and you know it."
msgstr "망할, 고집불통이 따로없네. 칼라크는 데빌이 아니라니까. 너도 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 8ec24be4-86ce-5f9b-8c56-c2eeaccd6bfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:8ec24be4-86ce-5f9b-8c56-c2eeaccd6bfa
msgctxt "h19832288gb755g4943gb7c4gd2efccc16b3f"
msgid "<i>And yet you served.</i>"
msgstr "<i>섬긴 건 섬긴 거지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 91f02fd7-f3cd-4659-a355-999c3cc868e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:91f02fd7-f3cd-4659-a355-999c3cc868e2
msgctxt "h101a2a8fg8108g48ebgb622gd7f295ed02be"
msgid "Don't you fucking dare."
msgstr "지랄하고 자빠졌네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = 94f7f008-8f6a-a3e5-6612-bd570c680663
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:94f7f008-8f6a-a3e5-6612-bd570c680663
msgctxt "h3569cc95g9effg42e3g9f64g8aa4b144497e"
msgid ""
"*The front lines of the Blood War. With every swing of her axe, Karlach "
"fulfils mistress Zariel's purpose.*"
msgstr "*피의 전쟁의 최전선. 칼라크가 도끼를 휘두를 때마다 여군주 자리엘의 목적이 완수됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Shadowheart
#. NodeID = 958e8ad1-ef40-3b34-aa9b-bc21f3d7db3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:958e8ad1-ef40-3b34-aa9b-bc21f3d7db3a
msgctxt "h7769466cg37d5g438egaab9g7cbf11ee2b21"
msgid ""
"Hmph - the famous Blade of Frontiers, in the flesh. Clever, this hero act "
"you've got going."
msgstr "흠. 그 유명한 변경의 칼날을 직접 만나게 되다니. 영웅놀이가 제법 능숙해 보이는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 9937b1c4-8aa2-fc5a-06c7-c852f7f284d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:9937b1c4-8aa2-fc5a-06c7-c852f7f284d2
msgctxt "h9b755e26g2c39g4ceag9c0dg5a5db812b006"
msgid "I'm not going to hurt anyone, and I'm certainly no devil."
msgstr "난 아무도 해칠 생각 없고, 데빌은 확실히 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = 997cef12-3542-f0cb-2bc5-fbe64f6d8ff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:997cef12-3542-f0cb-2bc5-fbe64f6d8ff8
msgctxt "h26657d96g79f1g4e4eg86cageddf31842822"
msgid "Fine, but he needs to stand down. We saw the truth for ourselves."
msgstr "좋아. 저치는 성질 좀 죽여야겠지만. 우리 모두 진실을 봤잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = 9c86171b-01cc-b15c-25ed-4daf8442ea38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:9c86171b-01cc-b15c-25ed-4daf8442ea38
msgctxt "h3a2ee0cbgc888g48f0g8e00g0772c85e87c0"
msgid ""
"Pfft. Everyone on this team is nothing but trouble. But I'm sure we can all "
"agree to keep it down to a simmer.<i></i>"
msgstr "참 나. 어차피 여기 있는 녀석들은 죄다 사고뭉치잖아. 그래도 되도록 분란 일어날 소지는 억누르는 게 낫겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = 9e38f7c6-395a-a921-74d9-7e90a85f3c44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:9e38f7c6-395a-a921-74d9-7e90a85f3c44
msgctxt "h9123123cg446cg4423g8d47ga44fa69033eb"
msgid "Truce?"
msgstr "휴전할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = a13f70ee-23df-7640-809d-2fe79fb64575
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:a13f70ee-23df-7640-809d-2fe79fb64575
msgctxt "hb4e1f8a8ga26cg48c6gb1ebg9205124dd1ff"
msgid ""
"*Another vision. Karlach's blade raised, slicing through devils - Zariel's "
"servants - as her eyes dart around, seeking escape.*"
msgstr "*또 다른 환영. 칼라크가 도끼날로 자리엘의 데빌 하수인들을 썰어넘기며, 탈출로를 찾아 눈을 바삐 굴리는 모습이 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = a2afb3e8-363c-beef-0c4c-48e509e40413
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:a2afb3e8-363c-beef-0c4c-48e509e40413
msgctxt "h2ea3d8c6gafefg4de1g99a6g9ecd7e8ee5c1"
msgid ""
"I've not grown any tentacles yet, thank Balduran - but luck won't be on our "
"side forever."
msgstr "발더란이 보우하사, 내 몸에 촉수 돋아난 적은 아직 없었지. 하지만 그 운도 영원하진 않을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = a424b570-2912-bcab-890a-eb9ae9f45918
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_WyllLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:a424b570-2912-bcab-890a-eb9ae9f45918
msgctxt "ha76c807dg2684g48e0gba6egfd141bdc4ce1"
msgid "To the Hells with you devil - and may you forever burn."
msgstr "지옥에 떨어져라, 데빌. 네년이 영원히 불타길 빌지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = a4859cc6-17ee-5656-cf5b-d339a264590a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:a4859cc6-17ee-5656-cf5b-d339a264590a
msgctxt "hb5386689g40d3g4fdfg874eg06832bf18310"
msgid "'Hero,' 'Blade' - names strangers gave me. My friends call me 'Wyll'."
msgstr "'영웅', '칼날'은 남이 붙여준 이름이지. 내 친구들은 나를 '윌'이라 불러."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = a6661437-06ce-faa7-1c22-6d275ce47d3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:a6661437-06ce-faa7-1c22-6d275ce47d3b
msgctxt "h305aff75gbb39g492fg8f17g959c719ddc50"
msgid "Well met. And - a thousand sorries."
msgstr "반가워. 또 정말 진심으로 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = a996c3dd-dcba-2c73-ea4c-aab33d1f4ee4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:a996c3dd-dcba-2c73-ea4c-aab33d1f4ee4
msgctxt "hc1b3b3d5g8b41g45cag9f01ge1997f1dcb44"
msgid "Lies, lies, lies! I - <i>ungh!</i>"
msgstr "거짓말, 거짓말, 거짓말! 난... <i>윽!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = af565511-6d9a-6716-edbc-40941c496053
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:af565511-6d9a-6716-edbc-40941c496053
msgctxt "hd9a29dfbg5c77g4866g8144gf4d7021f8cf4"
msgid ""
"The parasite links us - it showed me you with the fiend. Her death is my "
"first priority, as it has always been."
msgstr "기생충이 우릴 연결했어. 네가 마족과 한 패란 걸 보여줬지. 저년의 죽음은 그 어느 때든 내 최우선 목표야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = b02eeb8a-a1fe-4eb2-aafa-3025674d39e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:b02eeb8a-a1fe-4eb2-aafa-3025674d39e3
msgctxt "hb5b74a67g8fbfg4966gbb05g9e020fc54c92"
msgid ""
"*He sees through your eyes. You slice through one devil after another - "
"Zariel's servants - as your eyes dart around, seeking escape.*"
msgstr ""
"*윌과 당신의 시야가 연결됩니다. 당신은 자리엘의 종복인 데빌들을 하나하나 베어 넘겨가며 탈출로를 찾아 눈을 바삐 굴리고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = b0c6c04d-0f06-d0ba-2dbe-ffdd8b9d8965
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:b0c6c04d-0f06-d0ba-2dbe-ffdd8b9d8965
msgctxt "h1242a64fgcfccg4dcagb294g6fa334eafdc9"
msgid ""
"*He chases you across the Hells' battlefields, ignited with rancour. He sees "
"you as an infernal wardevil, a threat to the living - evil incarnate.*"
msgstr ""
"*윌은 적의를 불태우며 당신을 쫓아 지옥의 전장을 돌파합니다. 그에게 당신은 지옥의 워데빌이자, 산 자들에 대한 위협, 악의 화신입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = b0c74bb5-3aec-df0f-c1d3-1a7fdd0f8137
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:b0c74bb5-3aec-df0f-c1d3-1a7fdd0f8137
msgctxt "h3fa18e96g95afg487dga02dgdc6bef9b41a8"
msgid "Deceived by who?"
msgstr "누구한테 속았단 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = b2ed56c4-a6d5-6237-dd2e-029f70a87f3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:b2ed56c4-a6d5-6237-dd2e-029f70a87f3e
msgctxt "ha7a453dcga405g4356gb0e1ga0d6c8f2f5dd"
msgid "You better lower that blade if you know what's good for you."
msgstr "사리 판단을 할 줄 안다면 그 검 치우는 게 좋을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = b42d3e74-112c-52bd-2bef-9766c0e66033
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:b42d3e74-112c-52bd-2bef-9766c0e66033
msgctxt "h776fd4e2gefb5g4a8dg9dc3g147ffa9bde43"
msgid "I never did trust you, Karlach. You're as good as dead."
msgstr "난 애초에 널 믿지 않았다, 칼라크. 이만 죽어줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = b7b1f03c-b251-6673-18ce-768ae5f9aa4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:b7b1f03c-b251-6673-18ce-768ae5f9aa4f
msgctxt "hcf22a848gf8d8g4bc8gbf21g80152e08c5d1"
msgid ""
"You know monsters, right? Better than anyone. Look into my eyes. Can't you "
"see I'm not what you think?"
msgstr "넌 괴물에 대해 잘 알지? 누구보다 잘 알 텐데. 내 눈 똑바로 봐. 정말 내가 그런 것들로 보여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = ba7c2e5e-909b-1db7-6ba9-756eca8e054e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:ba7c2e5e-909b-1db7-6ba9-756eca8e054e
msgctxt "hfb2127ebga886g4616g99d5g9f2b6b8b7f46"
msgid "You're right. Let's cut her down before she causes any trouble."
msgstr "맞는 말이네. 문제 일으키기 전에 이 자리에서 베어버리도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = be89e10a-0d5e-a90b-0500-c1ac9816e37b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:be89e10a-0d5e-a90b-0500-c1ac9816e37b
msgctxt "h548df20fgbdafg48c1g823dg0c8b2158d195"
msgid "'The Blade of Frontiers'. Did I hear that right?"
msgstr "'변경의 칼날'? 내가 똑바로 들은 거 맞나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = beec99fe-f381-9304-b9e4-d7be76403eaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:beec99fe-f381-9304-b9e4-d7be76403eaa
msgctxt "h374d83e3g884ag45fcg82ceg7b7d6ba875bf"
msgid "You saw Karlach's thoughts. She poses no threat to the Sword Coast."
msgstr "칼라크의 생각을 읽었잖아. 소드 코스트에 해를 끼칠 사람이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = bf01f103-f7e9-79f0-562a-9e01925ef02c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:bf01f103-f7e9-79f0-562a-9e01925ef02c
msgctxt "h6a47f745gf1f3g4fd4g81c0g6d1be71bfc2d"
msgid "Not on your life. I want him out of here."
msgstr "어림도 없지. 이만 떠나줬으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = c0d56bba-b6a3-2bbe-89c1-face7f6fe4fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_WyllLeaves = True
#.      - DEN_AttackOnDen_State_DenVictory = False
#.      - DEN_AttackOnDen_State_DenLost = False
#.   Tag:
#.      - AVATAR(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:c0d56bba-b6a3-2bbe-89c1-face7f6fe4fa
msgctxt "hfb8f1aa8g0e79g4513g9560gf4e0da882302"
msgid "I thought you were waiting at the grove. What are you doing here?"
msgstr "숲에서 대기 중일 거로 생각했는데. 여긴 어쩐 일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = c4ea583d-f165-84f1-4974-a79e0d5ad335
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:c4ea583d-f165-84f1-4974-a79e0d5ad335
msgctxt "h8748ef13gdca6g4444gb822ga67f9e7f1e40"
msgid "Yes, I served Zariel. But I had no bloody choice."
msgstr "그래, 난 자리엘을 섬겼지. 하지만 좋아서 그런 게 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = c521d294-9107-f826-ed18-fbe12fd9390b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:c521d294-9107-f826-ed18-fbe12fd9390b
msgctxt "hea761131g825eg42f1ga2d7g2824e91822cf"
msgid ""
"You saw the truth. I may be an effective soldier, but I never wanted to "
"serve Zariel. Legged it <i>away </i>from her the first chance I got."
msgstr ""
"진실을 봤잖아. 자리엘의 병사로 특출나긴 했지만, 절대 좋아서 그년을 섬긴 게 아니야. 기회가 생기자마자 바로 <i>도망쳤다고</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = ccb03a34-6118-fed9-474b-376852a3a7f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:ccb03a34-6118-fed9-474b-376852a3a7f3
msgctxt "ha526284dg2797g4225g9488g3df1d8d82726"
msgid "Like a hammer knows an untouchable nail. Look, I'm not -"
msgstr "상종해서 좋을 게 없는 빌어먹을 관계이지. 야, 난 네가 여기는...."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = ceadb2f6-ca8b-e299-ae1d-71f01a06cae3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:ceadb2f6-ca8b-e299-ae1d-71f01a06cae3
msgctxt "hd2a3303cg0a9fg4de6gace9g60e4f34cd2f4"
msgid "Well, soldier? What's the word?"
msgstr "자, 신참? 어떻게 할래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = cf7ea98b-f53f-e95d-27b4-051022fff4cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Wyll_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:cf7ea98b-f53f-e95d-27b4-051022fff4cf
msgctxt "h61730810gd2dcg48a4gaacag3796f74062ed"
msgid ""
"*You have a flash of recognition. This is the Blade of Frontiers - hero of "
"the Sword Coast, and the hunter who chased you through the Hells.*"
msgstr ""
"*당신은 그를 순식간에 알아봅니다. 바로 그 변경의 칼날이로군요. 소드 코스트의 영웅이자 지옥에서 당신을 추격해 댄 사냥꾼 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = d3c4d72a-f523-b914-aec1-e2b46362b11d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:d3c4d72a-f523-b914-aec1-e2b46362b11d
msgctxt "h063d0b83gbb1dg4269g9dd1g8298c30495b1"
msgid "Ding ding ding. You got there in the end."
msgstr "딩동댕. 이제야 겨우 알아차리셨네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = d5f4e28e-0025-53b0-8021-3dfad1cfb768
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_WyllLeftHostile = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:d5f4e28e-0025-53b0-8021-3dfad1cfb768
msgctxt "h939de9c3g5037g4474gbe0eg8518cc580bc2"
msgid "To the Hells with you, then - and may you all forever burn."
msgstr "지옥에나 떨어져. 너희 다 영원히 불에 타길 비마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = d7888b85-c975-84ab-2e9b-56f88705277a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:d7888b85-c975-84ab-2e9b-56f88705277a
msgctxt "hdaa6a84dg02b0g444agbcaegda43925b8c42"
msgid ""
"Proof, clear as summer sky. It's over, Karlach. It's time you feel the sting "
"of the Blade."
msgstr "증명됐군. 여름 하늘처럼 말끔하게. 끝이다, 칼라크. 이제 이 칼날의 날카로움을 느껴봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = d8a09592-83fa-f4f4-9007-76ecb45ee3b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:d8a09592-83fa-f4f4-9007-76ecb45ee3b0
msgctxt "h4f60284bg2881g41cag86aeg7e449ff0ffe7"
msgid ""
"*He catches his breath, and his lips straighten. Sheer dread twists his "
"face.*"
msgstr "*그가 숨을 고르며 입을 앙다뭅니다. 극도의 불안감에 표정이 일그러집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = d956d789-48b7-e9c9-48ed-b2ca61feffb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:d956d789-48b7-e9c9-48ed-b2ca61feffb2
msgctxt "h9bde23e9g1768g4a38g98deg90c47679b7be"
msgid "All right. But you're both out of here at the first sign of trouble."
msgstr "좋아. 하지만 사고 칠 낌새 조금이라도 보이면 둘 다 쫓아버릴 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = db9cff59-3896-75df-ed81-56afc63a9440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:db9cff59-3896-75df-ed81-56afc63a9440
msgctxt "h010ee214g0dd2g426agb242g141292059856"
msgid "You want a fight? Let's see what the Blade can do."
msgstr "싸우고 싶냐? 어디 변방의 칼날 실력 좀 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = e11374c3-9813-9cd0-4ef1-44a68a50a098
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:e11374c3-9813-9cd0-4ef1-44a68a50a098
msgctxt "h0443e7f6gfd95g4850g924dg979f6931797b"
msgid "The devil's head. And yours, if you so much as -"
msgstr "저 데빌의 머리지. 어쩌면 네 것도. 방해를 하면 말이..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = e123dc7d-9442-7354-2e05-4fcd802812b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:e123dc7d-9442-7354-2e05-4fcd802812b2
msgctxt "hb46f1a32g77edg4aaeg84dbg5ceebb04a3a0"
msgid ""
"*Wyll shudders with Karlach's desperation. She is a victim of the Blood War, "
"not an agent of it.*"
msgstr "*윌이 칼라크의 절박감에 몸서리칩니다. 그녀는 피의 전쟁의 수행자가 아닌, 피해자였던 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = e2e978ca-9a54-365b-9965-fe1e296f2768
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:e2e978ca-9a54-365b-9965-fe1e296f2768
msgctxt "hb8e35525ged56g495bga38cgf7ff8e9505a8"
msgid ""
"Your ally's a fraud - a soldier in the archdevil Zariel's army. Either I cut "
"her down, or she burns the Sword Coast to ash."
msgstr "넌 네 동료에게 속고 있어. 저년은 아크데빌 자리엘의 병사야. 내가 없애지 않으면, 소드 코스트를 잿더미로 만들 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = e2f6cb56-b410-a2c8-136c-ebc39df606a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:e2f6cb56-b410-a2c8-136c-ebc39df606a7
msgctxt "h73649842g85e6g4ae9ga8e3g7792674f7a43"
msgid "But I do. The Blade of Frontiers will be only a memory come tomorrow."
msgstr "난 죽이고 싶은데. 변경의 칼날은 이제 과거의 기억으로만 남게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = e3b302f0-8516-e1f0-83fd-046a7a3e11fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:e3b302f0-8516-e1f0-83fd-046a7a3e11fb
msgctxt "h6bda79b3gda26g4b89gbfd9g144eaaa39f76"
msgid "Get out. And don't show your face again."
msgstr "꺼져. 다시는 내 앞에 얼굴 비치지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = e721d680-a599-690e-0612-5048b89fb5a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:e721d680-a599-690e-0612-5048b89fb5a6
msgctxt "hc95057dfg5357g4c87g851eg6e7880811239"
msgid "The two of you have met before, I see."
msgstr "보아하니 너희 둘은 구면인 모양이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = eaf6361e-26a6-5d03-32bb-5d577719c09b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Wyll_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:eaf6361e-26a6-5d03-32bb-5d577719c09b
msgctxt "h6c63834egf054g4f8fg99f2g4488557d5d26"
msgid "I figured you'd show up. The Blade of Frontiers is a man of his word."
msgstr "네가 나타날 줄 알고 있었지. 변경의 칼날은 자기가 뱉은 말은 지키는 자니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = ec897f51-581f-f220-0df1-202659d8d5f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:ec897f51-581f-f220-0df1-202659d8d5f7
msgctxt "hf113ba59g99edg4a78gb24cgf21302717deb"
msgid ""
"How about we all take a nice deep breath and calm the fuck down. Just cause "
"I want to live doesn't mean I want him dead."
msgstr "다들 깊게 심호흡하고 씨발 진정 좀 해보는 게 어때? 내가 살고 싶다고 해서 저 녀석이 죽어야겠단 얘기는 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = edc8a1a9-8e86-e0b2-7399-3f97d395913a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c89b23bf-d6a3-8d58-11e1-ee036cdac588_Trust = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:edc8a1a9-8e86-e0b2-7399-3f97d395913a
msgctxt "h007f6372g44f2g40afg99d9g342ee09a57e8"
msgid "I'll consider it. How do I know I can trust you?"
msgstr "생각은 해 볼게. 내가 널 뭔 수로 믿어야 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = f1a4b2f0-e329-9917-fd1f-98db5f4be5ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:f1a4b2f0-e329-9917-fd1f-98db5f4be5ec
msgctxt "h68f9d972g3c64g402cgad5fg87f1b4a534ea"
msgid "You better lower that blade if you know what's good for you."
msgstr "사리 판단을 할 줄 안다면 그 검 치우는 게 좋을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = f225415c-cb2a-a374-2e43-86116c0e066c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:f225415c-cb2a-a374-2e43-86116c0e066c
msgctxt "h7b2638d4gfdc2g416dg9c9egfc885c42e337"
msgid "You're a problem. And I'm thinking violence is the solution."
msgstr "골치 아픈 자식. 아무래도 폭력으로 해결하는 게 정답 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = f3cd0b85-4168-5196-a658-864ee6b9e637
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:f3cd0b85-4168-5196-a658-864ee6b9e637
msgctxt "ha950d318g67b8g4dbfga88fga7a8aafef3c5"
msgid "<i>And yet you served.</i> I - <i>ngh!</i>"
msgstr "<i>섬긴 건 섬긴 거지.</i> 나는... <i>으윽!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Wyll
#. NodeID = f7250015-f502-9809-90c9-a491f00c3c25
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_WyllConfrontation_State_WyllLeft = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:f7250015-f502-9809-90c9-a491f00c3c25
msgctxt "ha6aa65abg8d6dg4144gbc47g680c4a70e087"
msgid ""
"I see the good in you, Karlach. I promise not to lose sight of it, even when "
"the Hells burn hottest."
msgstr "난 네 선한 면을 봤다, 칼라크. 지옥이 아무리 뜨겁게 눈앞을 아른거려도 그 면을 잊지 않겠노라 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = f749af64-a9f1-03e0-75c3-f22995ae258b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Wyll_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:f749af64-a9f1-03e0-75c3-f22995ae258b
msgctxt "h9064d2f6g7076g447eg94e6ge3d283bbb06d"
msgid "Ah, the legend lives. I figured you'd show up eventually."
msgstr "아, 전설이 살아계셨군. 네가 언젠간 내 앞에 나타날 줄 알고 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = f8893e90-a63f-4fe2-b55d-3c5861b2325d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:f8893e90-a63f-4fe2-b55d-3c5861b2325d
msgctxt "hf747e2bcga3bag4bd9gbb91g86985f5d11ff"
msgid "Give it up already, I'm not the monster you think I am."
msgstr "그만 좀 괴롭혀라. 난 네가 생각하는 그런 괴물이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Karlach
#. NodeID = fb03ea27-f6bb-a61f-718c-ad4db1180b3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:fb03ea27-f6bb-a61f-718c-ad4db1180b3b
msgctxt "h6a54a9c2g8848g4e53g9618gaaa2364a0c41"
msgid "Well - not counting the fuckers that need a good hurting."
msgstr "글쎄. 맞아야 정신 차릴 새끼는 예외인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Narrator
#. NodeID = fb344d4e-5777-756d-545e-54d782ef08c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:fb344d4e-5777-756d-545e-54d782ef08c5
msgctxt "h3b598ae3gfa39g4063g9ed8g0c92cecfa529"
msgid ""
"*You are Karlach, tearing through demons across a blood-red landscape of "
"fire and volcanic cinder.*"
msgstr "*당신은 칼라크입니다. 불과 화산재로 뒤덮인 핏빛 풍경을 누비고 다니며 데몬들을 찢어발기고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM
#. Speaker = Player
#. NodeID = fbaff613-c81e-b70b-4224-a382190422c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllConfrontation_NotRecruited_CFM:fbaff613-c81e-b70b-4224-a382190422c1
msgctxt "h38d26cdcg9e34g4b6ag96d8g0a1120075f21"
msgid ""
"Be practical. You're infected, same as us. You need allies, not enemies."
msgstr "현실적으로 생각해. 넌 우리처럼 감염된 상태잖아. 네게 필요한 건 동료지, 적이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 0033423f-cc8b-da33-75c3-3a43985e1a58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:0033423f-cc8b-da33-75c3-3a43985e1a58
msgctxt "hc84cdeb5gc65fg4590g9242g5dbf19bae215"
msgid ""
"*A calm settles over you. The elder brain is a menace - but you are the "
"Blade of Frontiers. No abomination is too powerful for you to overcome.*"
msgstr ""
"*평온이 찾아옵니다. 엘더 브레인은 위협적이지만, 당신은 변경의 칼날입니다. 그 어떤 끔찍한 존재도 정복할 만큼 당신은 강력합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Player
#. NodeID = 00ffaac3-b6a3-815d-1257-78065c5804e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(0) = True
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:00ffaac3-b6a3-815d-1257-78065c5804e8
msgctxt "hca65998dg145ag4c8aga7a7g110f9c99e80b"
msgid ""
"<i>You are no aristocrat. You will be the Blade of Avernus, hunter of fiends "
"and foul beasts.</i>"
msgstr "<i>넌 귀족이 아니야. 넌 아베르누스의 칼날이 되어, 마족과 사악한 짐승들을 사냥할 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 04951039-f8ea-218f-5040-fb56c7533fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:04951039-f8ea-218f-5040-fb56c7533fb2
msgctxt "hbde1bc6eg265eg4ccdg9c7cg4ae277db6c38"
msgid ""
"*You fought to right the wrongs of the Coast, to slay the men and monsters "
"that hunt the helpless.*"
msgstr "*당신은 소드 코스트의 잘못을 바로잡고, 힘없는 자들을 사냥하는 인간과 괴물을 처치하기 위해 싸웠습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 0f2c66e9-3d76-b807-20dc-44b806662193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:0f2c66e9-3d76-b807-20dc-44b806662193
msgctxt "h5ad8815bgddf0g45d1ga778g76c73ee60097"
msgid ""
"*A calm settles over you. The elder brain is a menace - but you are the "
"Blade of Avernus. No abomination is too powerful for you to overcome.*"
msgstr ""
"*평온이 찾아옵니다. 엘더 브레인은 위협적이지만, 당신은 아베르누스의 칼날입니다. 그 어떤 혐오스러운 존재도 정복할 만큼 당신은 "
"강력합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 136b40a2-70be-a622-7b62-c209a7c56b12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:136b40a2-70be-a622-7b62-c209a7c56b12
msgctxt "h1aab612bgc6beg4921gbd3age4b120bfe1d3"
msgid ""
"*Courage. Insight. Strategy. Justice. These were the lessons your father "
"taught you, and the ones by which you will guide your fair city.*"
msgstr "*용기. 통찰. 전략. 정의. 아버지가 당신에게 가르쳐준 교훈이며, 당신은 이에 따라 공정한 도시를 만들 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 21473fb5-49cd-dc18-3472-8a7327fa2b48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:21473fb5-49cd-dc18-3472-8a7327fa2b48
msgctxt "h0499156eg4737g4b65gbc81g06b7c3404833"
msgid ""
"*Even though you bear the horns of a devil, the patriars and people will "
"recognise your claim.*"
msgstr "*데빌의 뿔이 돋아 있다고 해도, 호족과 사람들은 당신의 정당성을 인정할 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 2d1b5c35-2bdf-7ea4-992d-381503b92a44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:2d1b5c35-2bdf-7ea4-992d-381503b92a44
msgctxt "h723337c8g6c92g43cag8810g3a2bd3530ed0"
msgid ""
"*It is in the wilds that you find your courage, not in the florid halls of "
"Upper City estates.*"
msgstr "*당신의 용기는 상부 도시의 화려한 저택이 아닌, 야생에서 찾아야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 2ec5dd82-d621-5ed4-5f24-73407325967c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:2ec5dd82-d621-5ed4-5f24-73407325967c
msgctxt "ha9cddb23gaba4g4a8dg9747ge699eb3a8e83"
msgid ""
"*When the elder brain has fallen, you could even claim your father's own "
"ducal title and carry his banner.*"
msgstr "*엘더 브레인을 무너뜨리고 나면, 당신은 아버지의 공작 작위를 물려받고 그의 뜻을 이을 수도 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 347204fc-6ab9-4821-443a-f34064416827
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:347204fc-6ab9-4821-443a-f34064416827
msgctxt "h85ec16edgc689g409ag97bbg97ee9783c058"
msgid ""
"*You will tread the same halls as your father and command the same marshals.*"
msgstr "*당신은 아버지가 걸었던 복도를 걸으며 그가 부렸던 사령관들을 지휘하게 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 34f7ce57-9c19-7868-a4f3-35696a45c718
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:34f7ce57-9c19-7868-a4f3-35696a45c718
msgctxt "hd617ee3dg3976g4f9ega859g8d98f8146143"
msgid ""
"*Uncertainty grips you. You have reached a fork in your path. In which "
"direction will you travel?*"
msgstr "*불확실성에 사로잡힙니다. 당신은 갈림길에 서 있습니다. 어느 방향으로 가야 하는 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 3b7aec47-b3ff-67c5-186c-a03dbf6b5ce7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:3b7aec47-b3ff-67c5-186c-a03dbf6b5ce7
msgctxt "h96572c68gb79eg43d8gb170ga05ce88d61a6"
msgid ""
"*Baldur's Gate is your home, and you are its servant, relentless in your "
"pursuit of the greatest good.*"
msgstr "*발더스 게이트는 당신의 집이고, 당신은 그 충실한 하인으로서 거침없이 최대의 선을 추구해 나갈 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Player
#. NodeID = 3fa40838-8cc8-a602-50e6-aa14204e0592
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(0) = False
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_BladeOfFrontiers = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:3fa40838-8cc8-a602-50e6-aa14204e0592
msgctxt "hf78fd9begaef8g4f9cg8b62g2ffa376cad59"
msgid ""
"<i>You are no aristocrat. You are forever the Blade of Frontiers, hunter of "
"foul beasts.</i>"
msgstr "<i>넌 귀족이 아니야. 넌 영원히 변경의 칼날, 사악한 짐승들을 사냥하는 자다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 40b81bcc-b0d4-b443-d4b6-53711b88013c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:40b81bcc-b0d4-b443-d4b6-53711b88013c
msgctxt "h81fd625dg966eg4818gb781gd78fe36c2dec"
msgid ""
"*There will be no great tempest roaring through the skies, no dragon "
"redeemer to help save the city.*"
msgstr "*하늘을 가르며 포효하는 거대한 폭풍도, 도시를 구원해 줄 용도 없을 것입니다.*\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 47161c85-3388-0c3d-99e8-8c5e71f04f06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:47161c85-3388-0c3d-99e8-8c5e71f04f06
msgctxt "h9e4dfc18g01adg47e1g87fag52f410c36db6"
msgid "*You should have known. You should always have known.*"
msgstr "*알았어야 했습니다. 항상 알고 있었어야 했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Player
#. NodeID = 473c7ec6-6647-9ca5-f042-fbdbc090eb8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:473c7ec6-6647-9ca5-f042-fbdbc090eb8b
msgctxt "hf2294269g162bg4ebbg8691ge0676dfed1b0"
msgid ""
"<i>You can't be Grand Duke. Mizora would wield too much over Baldur's "
"Gate.</i>"
msgstr "<i>넌 대공이 될 수 없어. 미조라가 발더스 게이트를 휘두르려 할 테니까.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 4dc26dc6-40e7-3189-6e0f-9f4ef70eaed4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:4dc26dc6-40e7-3189-6e0f-9f4ef70eaed4
msgctxt "h850ce88fg8e4ag4646ga6d0g33659abe84b3"
msgid ""
"*For as long as demons and devils imperil the Sword Coast, they will be your "
"prey.*"
msgstr "*데몬과 데빌이 소드 코스트를 위협하는 한, 그들은 당신의 사냥감입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 4dfea5d8-6151-bd94-957e-fb9461b68e52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:4dfea5d8-6151-bd94-957e-fb9461b68e52
msgctxt "hb02dd982g840fg4a53gb0e7gbcf81a60391b"
msgid ""
"*There will be no Grand Duke Wyll Ravengard. And there will be no Blade of "
"Frontiers.*"
msgstr "*윌 레이븐가드 대공은 없을 것입니다. 변경의 칼날도 마찬가지입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 5da5d636-e452-aabe-7100-e274b64efd2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:5da5d636-e452-aabe-7100-e274b64efd2f
msgctxt "h9c425ce5g4fdag4318g8f13g6fda0d5fa2ec"
msgid ""
"*You are overcome with visions of grand battles and ducal intrigue. Your "
"future looks bright indeed.*"
msgstr "*공작이 되어 부릴 술책과 웅장한 전투에 대한 환상이 당신을 사로잡습니다. 당신의 미래는 참으로 밝아 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 8308283f-c619-0a1b-2f7d-176b5d2f5169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:8308283f-c619-0a1b-2f7d-176b5d2f5169
msgctxt "h65d43851gbe97g4733gb890ge7903a61081b"
msgid "*You are the Blade of Frontiers.*"
msgstr "*당신은 변경의 칼날입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Player
#. NodeID = 8abd101e-b305-2260-67f7-56bbaa54b325
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:8abd101e-b305-2260-67f7-56bbaa54b325
msgctxt "h813af55fg5f62g4d4bg8cecga8bb8693e2f9"
msgid ""
"<i>The power is irresistible. You will be a Grand Duke, and the people will "
"cheer your name.</i>"
msgstr "<i>이 힘은 거스를 수 없다. 넌 대공이 되고, 사람들은 네 이름을 환호할 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 8d5e60dc-dc19-b540-ec8c-d5226468d798
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:8d5e60dc-dc19-b540-ec8c-d5226468d798
msgctxt "h73a5954bg55c3g4a1cgbe8dgd20abb501b68"
msgid ""
"*No manner of duke should be tied to a devil's leash. No manner of duke "
"should save a city, only to open a gate to the Hells.*"
msgstr ""
"*그 어떤 공작도 데빌의 목줄에 묶여 있어선 안 됩니다. 그 어떤 공작도 도시를 구해놓고선, 정작 지옥의 문을 열어선 안 되겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 8e52f7e0-0a99-dd9a-6473-27dff7899ee7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_PartySize_AtLeast2 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:8e52f7e0-0a99-dd9a-6473-27dff7899ee7
msgctxt "h1b61eacfgc546g41c5g8905g3d3bfd386a09"
msgid ""
"*Your parasite trembles. Even in sleep, your companions know your path, and "
"cry out in victory.*"
msgstr "*당신의 기생충이 떨립니다. 꿈속이지만 동료들은 당신의 길을 알게 되자, 승리의 환호성을 지릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 8ededb9f-47be-2ad5-2999-237e15dc92cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:8ededb9f-47be-2ad5-2999-237e15dc92cb
msgctxt "h80e0f128g09f3g47f6ga5e2gc3d09f37823f"
msgid ""
"*You are the warrior who will slay the Absolute. You are the guardian who "
"will defend Baldur's Gate.*"
msgstr "*당신이 절대자를 죽일 전사라는 것을요. 당신이 바로 발더스 게이트를 지킬 수호자입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 973ce251-3a80-b397-d490-b583e2942038
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:973ce251-3a80-b397-d490-b583e2942038
msgctxt "h8f6ade85gec1dg4ec2g9410g17af15362217"
msgid ""
"*Your parasite shudders for a moment. Your companions know your path, but "
"none celebrate it.*"
msgstr "*기생충이 잠시 몸을 떱니다. 동료들은 당신의 길을 알게 되었지만, 아무도 축하해 주지 않는군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Player
#. NodeID = 9796b357-3c70-c044-f9d8-b7efcf917386
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:9796b357-3c70-c044-f9d8-b7efcf917386
msgctxt "h62bf3210g603ag4c72g95b6ge74dadb8b587"
msgid ""
"<i>The Blade is dead. You will be Wyll Ravengard, proud and just Duke of "
"Baldur's Gate.</i>"
msgstr "<i>변경의 칼날은 죽었다. 넌 윌 레이븐가드, 발더스 게이트의 당당하고 정의로운 공작이 될 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = 9b8acf8b-3263-dec2-ba70-48d84832b84d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:9b8acf8b-3263-dec2-ba70-48d84832b84d
msgctxt "h4a4f3386gb9f4g4cbfgab40g7b816673af93"
msgid ""
"*Yet you will labour under Mizora's shadow. What fiendish plans could she be "
"concocting?*"
msgstr "*하지만 당신은 미조라의 그림자 아래서 시달릴 것입니다. 그녀는 또 어떤 사악한 계획을 꾸미고 있을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = b5b786ee-254b-147e-2b7f-4f33f990018e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:b5b786ee-254b-147e-2b7f-4f33f990018e
msgctxt "ha2154bb1gfa0eg421ag82ffg19d42e80b45f"
msgid ""
"*Your father's memory will fade, and you will be the Ravengard the histories "
"remember.*"
msgstr "*아버지의 기억은 사라지고, 당신은 역사가 기억하는 레이븐가드가 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = be9d8487-127c-f83e-094b-92f9dfd04fe8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:be9d8487-127c-f83e-094b-92f9dfd04fe8
msgctxt "h859553cfgbfaag43d7g93afg97f5c8ca0cd1"
msgid "*Ansur is dead.*"
msgstr "*안수르는 죽었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = c2708211-5a2f-e35b-7e49-0d2150368d2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:c2708211-5a2f-e35b-7e49-0d2150368d2a
msgctxt "hf8633a22g872bg4240gbe79gad426c80147f"
msgid ""
"*To bend the will of the citizens with a single decree, to turn the heads of "
"your adorers and twist the arms of your opponents: affairs of state are your "
"calling.*"
msgstr ""
"*당신의 명령 한 마디로 시민의 뜻을 굽히고, 추종자의 시선을 돌리며, 반대자의 팔을 비틀어버릴 수 있습니다. 정치야말로 당신의 "
"소명입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = de1c42a9-331c-bc52-a3ad-8ff53390b8be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:de1c42a9-331c-bc52-a3ad-8ff53390b8be
msgctxt "hd42af039g1620g42b3gb40bg32c1804b62f7"
msgid ""
"*The Blade of Frontiers is dead. You will be Wyll Ravengard, son of Ulder, "
"proud Duke of Baldur's Gate.*"
msgstr "*변경의 칼날은 죽었습니다. 당신은 윌 레이븐가드, 얼더 공작의 아들이자 발더스 게이트의 자랑스러운 공작이 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = e13b2b0d-2ace-4067-8dc0-ab043bbc55f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:e13b2b0d-2ace-4067-8dc0-ab043bbc55f1
msgctxt "h2082931egcad0g4084g9889g0b43a25d9622"
msgid ""
"*Baldur's Gate is your home, and you are its servant, relentless in your "
"pursuit of the greatest good. You would sooner die by Mizora's hand than "
"endanger the city.*"
msgstr ""
"*발더스 게이트는 당신의 집이고, 당신은 그 충실한 하인으로서 거침없이 최대의 선을 추구해 나갈 것입니다. 도시를 위험에 빠뜨리느니, "
"차라리 미조라의 손에 죽는 편이 낫습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = e8a8e8fe-aea0-786d-4537-583fc4933c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:e8a8e8fe-aea0-786d-4537-583fc4933c2f
msgctxt "ha3c4db87g7bdcg4edbgbedbgb2def0db0fa4"
msgid ""
"*You will make a name for yourself, you will conquer all of the city's ills. "
"The people will know you forever as the Heart of the Gate.*"
msgstr ""
"*당신은 이름을 드날리고, 도시의 모든 병폐를 정복할 것입니다. 사람들은 당신을 영원히 발더스 게이트의 심장으로 기억할 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = f037d204-0a95-69ae-1fbc-589721c088ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:f037d204-0a95-69ae-1fbc-589721c088ef
msgctxt "hde1b3510g8348g4541g918agb49fa92a8b43"
msgid "*You are <i>the Blade of Avernus</i>.*"
msgstr "*당신은 <i>아베르누스의 칼날</i>입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = f7f3a387-d9e3-a8f5-c05b-e8e54e53dc63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:f7f3a387-d9e3-a8f5-c05b-e8e54e53dc63
msgctxt "h82b350a1g0fbag4e46gaf5dg2871e6a52b27"
msgid ""
"*Your parasite shudders for a moment. Your companions know your path, but "
"only one celebrates it.*"
msgstr "*기생충이 잠시 몸을 떱니다. 동료들은 당신의 길을 알게 되었지만, 오직 한 명만이 축하해 주는군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM
#. Speaker = Narrator
#. NodeID = fb8b1678-7dca-da15-1b48-4d5e9cc33e9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_WyllHelmetOfBalduran_CFM:fb8b1678-7dca-da15-1b48-4d5e9cc33e9f
msgctxt "h5f895708g01eag4b1cgbcb3g4b25b41487f1"
msgid ""
"*When evil's shadow darkened the Sword Coast, you brought your light. You "
"are the people's protector. To fell monsters and guard the meek is your "
"calling.*"
msgstr ""
"*악의 그림자가 소드 코스트를 어둠으로 뒤덮었을 때, 당신은 빛을 가져왔습니다. 당신은 사람들의 수호자입니다. 괴물을 쓰러뜨리고 평범한 "
"자들을 지키는 것이 당신의 소명입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_ZevlorsAppeal_CFM
#. Speaker = Narrator
#. NodeID = 01499136-5a44-d205-626c-137b4dc1d48a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_ZevlorsAppeal_CFM:01499136-5a44-d205-626c-137b4dc1d48a
msgctxt "h51b01e8fg0744g410fg8805g99e1cfcb23e8"
msgid ""
"*In the candlelight, Zevlor might almost be sleeping. But his empty eyes "
"stare, his lips slack around a curl of parchment, poking through like a "
"yellowed tongue.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_ZevlorsAppeal_CFM
#. Speaker = Narrator
#. NodeID = 25d9b931-e02f-fded-0c1f-a921492e9610
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_ZevlorsAppeal_CFM:25d9b931-e02f-fded-0c1f-a921492e9610
msgctxt "hbddc3a72g8dbfg4cffgb7f6ge98cee3cb2d1"
msgid "*A message.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_ZevlorsAppeal_CFM
#. Speaker = Narrator
#. NodeID = 3a8deff4-19be-0d90-029c-86ea480a7b51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_ZevlorsAppeal_CFM:3a8deff4-19be-0d90-029c-86ea480a7b51
msgctxt "h2191e4c6g36b4g4ff0g9f49gf44d23f600c1"
msgid ""
"*It is the smell that strikes you first. Spiced ceremonial oils, cut through "
"with the copper tang of blood.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 0216e450-d9f5-4bd5-12c2-c41317db1345
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:0216e450-d9f5-4bd5-12c2-c41317db1345
msgctxt "h12c9b4e2gf2d1g45a2g9367g93fbc5e872c6"
msgid ""
"But there is only one who truly counts, no? One whose favour you crave. One "
"who knows the catastrophe that lurks 'twixt your ribs."
msgstr ""
"그러나 진정으로 생각하는 건 한명이지 않나. 아닌가? 자네가 애정을 갈구하는 존재. 자네의 갈빗대 속에 숨어있는 불행을 알고 있는 존재 "
"말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 05474950-84ec-02f8-4d6d-24961dc7e027
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:05474950-84ec-02f8-4d6d-24961dc7e027
msgctxt "hd093e7a1g85fag4aa6g99d4g66e41461242f"
msgid ""
"The ill effects may linger, I'm afraid. Not enough to hamper your mission, I "
"hope."
msgstr "안타깝게도 악영향은 계속 남아있을 것 같네. 자네 임무를 방해하지 않을 정도길 빌어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 05de7205-a417-7e71-e019-9bb4cefa1bd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:05de7205-a417-7e71-e019-9bb4cefa1bd4
msgctxt "h577a0c38gf1eeg494egad9egb900fe0df972"
msgid ""
"Alas, not the role I've been given in this particular tale. I am but a bare "
"cameo compared to the part that you must play. You and the orb."
msgstr ""
"아아, 그건 이 이야기에서 내가 받은 역할이 아니라네. 나는 자네 역할에 비하면 잠깐의 단역에 불과하지. 자네와 그 보주가 주인공이 될 "
"걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 0881e9a9-4274-7b95-fe8e-a41c00232aae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:0881e9a9-4274-7b95-fe8e-a41c00232aae
msgctxt "h7247eec4g113cg4a71gb2c7gec69a14e75fb"
msgid ""
"Like moons make swell and wane the nescient seas, so too the sky-strewn gods "
"ordain the tidal fates of mortal days."
msgstr "달이 모든 바다의 밀물과 썰물을 만드는 것처럼, 하늘에 있는 신들도 필멸할 운명들의 차고 기울어짐을 규율한다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 0f4c26ae-28b3-591e-d4d0-c13170820477
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:0f4c26ae-28b3-591e-d4d0-c13170820477
msgctxt "hc59cf072g6a16g48a7g9c5eg980ae9711c2c"
msgid "<i>Remain silent.</i>"
msgstr "<i>침묵을 유지한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 16bda23f-adc0-8e3c-b6ba-1bbc034db726
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:16bda23f-adc0-8e3c-b6ba-1bbc034db726
msgctxt "h676d25e2g0a9bg48c9gaba7g2987e0806aef"
msgid ""
"You know where you went wrong, Gale. We needn't dwell on that here and now. "
"But even so, you're to be given a chance of redemption."
msgstr ""
"게일 자네도 자신이 무엇을 잘못했는지는 알고 있겠지. 지금은 굳이 그 일을 언급하지 않겠네. 다만 자네에겐 이제 만회의 기회가 주어졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 1bf136cc-ac8a-0422-14e7-7d3cc0799c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:1bf136cc-ac8a-0422-14e7-7d3cc0799c2f
msgctxt "h2a00a6fdgb584g46e3gbb16g6676b4c7f3c3"
msgid "She would consider what she considers to be forgiveness."
msgstr "자신이 나름 용서라고 생각하는 것을 내리셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 2094e3bc-70dd-b595-b241-4618f69b408a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:2094e3bc-70dd-b595-b241-4618f69b408a
msgctxt "h7ee32997g064eg49c0gacbag424092ca4ad2"
msgid ""
"I was bid to spare neither time nor my own self to find you. <i>She</i> sent "
"me, Gale. You know of whom I speak."
msgstr "시간도, 내 몸도 아끼지 말고 자네를 찾아달라는 부탁을 받았다네. <i>그녀가</i> 직접. 누구를 말하는지는 알겠지, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 209f9dbb-f108-4f5f-9689-fbaa2497a05f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:209f9dbb-f108-4f5f-9689-fbaa2497a05f
msgctxt "h99d3f6d8gb212g4882g9ba7gb170c4e102c1"
msgid ""
"Don't just gawp at me like the dregs of the fishmonger's stall - I've worn "
"out quite some boot leather in order to track you down."
msgstr "날 생선팔이 가판대 찌꺼기 마냥 멍하니 보지 말게나. 자네를 추적하느라 신발 가죽이 꽤 닳았단 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 2fc5e1b8-44e5-6306-daa0-e99608f01bd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:2fc5e1b8-44e5-6306-daa0-e99608f01bd6
msgctxt "hdfebabe8gcb36g4376g9ddbg2e1a677d5bb3"
msgid "I am Mystra's servant. If this is what she asks of me, so be it."
msgstr "저는 미스트라의 종복입니다. 이것이 그녀가 저에게 요구하는 것이라면, 그렇게 하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 315f1b8c-ef3b-08d8-0221-c92ad1f0c4b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:315f1b8c-ef3b-08d8-0221-c92ad1f0c4b2
msgctxt "hdddf9d26g69c5g494fga002g078ff2e021df"
msgid "Even the waves of fate can break upon the shores of will."
msgstr "운명의 파도조차도 의지의 제방 앞에선 부서질 수 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 31639340-2316-5ea7-d3ad-1cf8b4186102
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:31639340-2316-5ea7-d3ad-1cf8b4186102
msgctxt "h49a5025bg85adg48adg8997gac8fe6dc6e04"
msgid "What other choice do I have?"
msgstr "저한테 다른 선택지는 없습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 341850f9-f9d9-464c-18fb-b215cc99738d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:341850f9-f9d9-464c-18fb-b215cc99738d
msgctxt "h7ddb3ab7ga945g43d5g81aag1d7fadae0472"
msgid "Elminster?"
msgstr "엘민스터 님?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 394390ce-a277-b5ff-5ae3-3f2debd8e9f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:394390ce-a277-b5ff-5ae3-3f2debd8e9f8
msgctxt "h65930ee9g84f0g498fga285g0f8e8343e5de"
msgid "You mean the orb. You mean I sacrifice myself."
msgstr "보주를 말씀하시는 거군요. 제가 희생해야 한다는 의미고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 39eca435-af5e-bb97-7383-00b64a174872
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:39eca435-af5e-bb97-7383-00b64a174872
msgctxt "h853bd8d9g408fg430bga67cg2e46c0afd73c"
msgid "It is done. Both charge and charm have been committed into your care."
msgstr "다 되었네. 임무와 주문은 모두 자네에게 맡겨졌네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 3d85b614-26fb-9f0e-9715-085c248129be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:3d85b614-26fb-9f0e-9715-085c248129be
msgctxt "h4c79b10cgc86bg4c9fga784g58c029809c40"
msgid ""
"With that, I've said my sorry piece, and need only bestow unto thee the "
"charm I was bid."
msgstr "이걸로 유감스러운 소식은 다 전했군. 이제 자네에게 아까 말한 주문을 걸어주는 일만 남았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 3e63f575-ba2b-f553-da5b-bcd6b948ed31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:3e63f575-ba2b-f553-da5b-bcd6b948ed31
msgctxt "h7fc8d02dg8b83g4133g82adg1af027f63967"
msgid ""
"Mystra is aware of the misadventures that have befallen you both. She knows "
"of your strife with the Absolute, that most insidious of evils."
msgstr "미스트라께서도 자네들이 겪은 모험에 대해 잘 알고 계신다네. 음흉하기 그지없는 위험인 절대자와 싸우고 있다는 것도 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 3f4fee27-b074-ffca-2fae-4e57b2cbfc14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:3f4fee27-b074-ffca-2fae-4e57b2cbfc14
msgctxt "h6841b930g3d6fg4682g8c0eg2159142a5768"
msgid ""
"That's more magnanimous of her than I've grown accustomed to. The catch "
"being?"
msgstr "제가 알고 있던 미스트라보다 훨씬 더 관대한데요. 대신에 할 일이 있겠죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 401d044a-d563-5aba-c226-28e1d3872a1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:401d044a-d563-5aba-c226-28e1d3872a1a
msgctxt "hfe808537g0110g4292gbdeegfe4e7f5eaad9"
msgid ""
"Mystra has granted me the power to stop the clock, as it were, on the orb's "
"rush to overpower you. Instead, you will be able to unleash its lethal "
"combustion at will."
msgstr ""
"미스트라께선 내게 자네를 집어삼키려는 그 보주의... '시계'를 멈출 힘을 내려주셨네. 이제 자네는 그 위험한 폭발의 힘을 원하는 때에 "
"발산할 수 있게 될 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 40313a8a-e641-49af-c323-1553877737d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:40313a8a-e641-49af-c323-1553877737d4
msgctxt "h2225d770ge748g4d26g85eeg36af62d2f8ba"
msgid ""
"Whatever she can grant unto you is infinitely better than whatever you cling "
"to now."
msgstr "무엇이든간에 미스트라가 자네에게 내려줄 것들이 지금 자네가 매달려 있는 것들보다 무한히 좋을 게야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 4258286b-3f00-4d1e-86bc-ad05e1896741
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:4258286b-3f00-4d1e-86bc-ad05e1896741
msgctxt "hdc3d0fc1g81aeg46c6g8d47g30d9e2581b34"
msgid "Hmm, yes. This shall suffice."
msgstr "흐음, 그래. 이거면 충분하겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 4470509e-37c1-9947-f354-4a4aeda20add
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:4470509e-37c1-9947-f354-4a4aeda20add
msgctxt "h5c9b2bbeg7b74g441bgafebgb5eb6111f77b"
msgid ""
"The very same, Gale. And a fair bit miffed he is, too, finding himself "
"forced to expose his best pair of boots to so many miles of country road on "
"your behalf."
msgstr ""
"바로 그렇네, 게일. 뿐만 아니라 이 엘민스터 님께선 상당히 심통이 나기도 했지. 가장 아끼는 신발이 자네를 찾아 정처 없이 시골길을 "
"걷느라 엉망이 되었으니 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 47469169-46ea-e9d5-da83-130f2ee52a71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:47469169-46ea-e9d5-da83-130f2ee52a71
msgctxt "hf2004695gc553g428egaf02g00467767d443"
msgid ""
"You promised me plain talk, Elminster. Make it plainer still, or we're done "
"here."
msgstr "간략하게 말씀하신다 하셨잖아요, 엘민스터. 더 간략히 해 주세요. 아니면 그만 듣겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 5521e1ba-01c0-4f37-a839-144e6d15ef8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_ElminsterFallbackNight = False
#.      - ORI_Gale_State_ElminsterWasDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:5521e1ba-01c0-4f37-a839-144e6d15ef8e
msgctxt "h2a85e151g697cg4bb3ga635gd3847ab03041"
msgid ""
"Ah, finally he stirs. True adventurers get up with the lark, I always say, "
"but if there are larks to be found in these lands, they must fancy "
"themselves akin to nightingales."
msgstr ""
"아, 드디어 일어나는구나. 진정한 모험가는 일찍 일어나는 새와도 같다고 내 늘 말하지만, 아무래도 이곳에 사는 새들은 밤에 벌레를 잡는 "
"모양일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 566666aa-7147-91b5-3a1b-8021e3b65aed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Event_BombDisarmed = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:566666aa-7147-91b5-3a1b-8021e3b65aed
msgctxt "hf9188d7cg7dabg4575ga667g5deba15cf976"
msgid "My'Nahastra Mystra'Ryl. E'Deelion Thras'Anas'Tthra."
msgstr "마이나하스트라 미스트라릴. 이달리온 쓰라스아나스티쓰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Gale
#. NodeID = 68e3a8b3-4d72-2352-c197-b492de19fdf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:68e3a8b3-4d72-2352-c197-b492de19fdf6
msgctxt "hb0a85fc0g60f0g4340g9800g60a695043623"
msgid "Mystra would consider... forgiveness?"
msgstr "미스트라가... 용서를 내린다고요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 831632ef-4332-f746-acdd-d7a783bdabb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:831632ef-4332-f746-acdd-d7a783bdabb1
msgctxt "hf1034f2eg85ddg4ad6ga70eg21a17027f42f"
msgid ""
"Gale, m'boy, I've come to address a most pressing matter. I'll speak as "
"plainly as I can, forswearing the accustomed frills that decorate my speech."
msgstr ""
"게일, 이 친구야. 나는 참으로 시급한 문제를 논의하러 왔다네. 내 발언을 으레 장식하는 미사여구들을 다 버리고 내 할 수 있는 최대한 "
"간략하게 말하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 8a0f450e-796f-41a8-c475-8cb9cbb94e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:8a0f450e-796f-41a8-c475-8cb9cbb94e3b
msgctxt "h79338b6egeda8g4540g8a0egd3b44db8a9e3"
msgid "<i>Keep listening.</i>"
msgstr "<i>계속 듣는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 938d6c64-5860-673e-e882-e49a7faa1078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:938d6c64-5860-673e-e882-e49a7faa1078
msgctxt "h6b63c41fg8277g4b97g8506ga2bb23500cf5"
msgid "Farewell, my friend."
msgstr "안녕히, 친구여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = 9a5b1670-f009-54e7-6728-dbc8ffbf4f27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:9a5b1670-f009-54e7-6728-dbc8ffbf4f27
msgctxt "h85d3e223g4abbg43fcgb992g0c85ffc90968"
msgid "That's the cost of Mystra's good graces? <i>Martyrdom?</i>"
msgstr "그게 미스트라가 내리는 은혜의 대가입니까? <i>순교요?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 9a751648-3784-abf8-80af-05516c817021
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:9a751648-3784-abf8-80af-05516c817021
msgctxt "he0dd28c2g157ag4e2dga354g708194fb645b"
msgid ""
"Young man, has your sojourn away from Waterdeep washed away your decorum as "
"well as your patience?"
msgstr "젊은 친구, 워터딥을 떠나있는 동안 자네는 참을성은 물론이요 예의마저 사라지고 말았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 9bb8e7e1-be51-f3a8-65cc-534d5020e7e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:9bb8e7e1-be51-f3a8-65cc-534d5020e7e6
msgctxt "h437f750agbc6eg4ffagbff3gd4e85f561ae6"
msgid ""
"The orb. That constant reminder of your past failings. The instrument of "
"your slow, sad, <i>inevitable </i>destruction. It can instead redeem you."
msgstr ""
"보주. 자네의 과거 실패를 끊임없이 상기시키는 그것 말일세. 느리지만, 슬프고, <i>피할 수 없는</i> 파멸의 도구 말이야. 그게 "
"자네를 구원할 수 있을 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 9dad92e3-fa29-0431-7ae4-f5b8b384630f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:9dad92e3-fa29-0431-7ae4-f5b8b384630f
msgctxt "h89c18e07g843fg4410g903fgfce59086bbea"
msgid ""
"But I suppose, after all the calamity that's been laid at your feet, you can "
"be forgiven raw nerves and a sharp tongue..."
msgstr "하지만 자네가 짊어진 그 모든 재앙을 생각한다면, 짜증나는 말투와 날이 선 혀 정도는 용서할 수 있네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = 9f33ecb1-c327-1a7d-8a1f-343dfa149cbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:9f33ecb1-c327-1a7d-8a1f-343dfa149cbc
msgctxt "hf44ed8f5ge5f0g45e4g87c1g43b3ecfa2b43"
msgid ""
"It brings me no pleasure saying this, my friend, but such is Mystra's will. "
"Yours must be the sacrifice that will undo the Absolute. And for your "
"sacrifice, you will be redeemed - such is Mystra's promise."
msgstr ""
"이런 말을 하게 되어 유감이지만, 이것이 미스트라님의 뜻이네. 자네가 절대자를 쓰러트릴 희생양이 되어야 하네. 그리고 자네는 그 희생으로 "
"구원받을 것이네. 이것이 미스트라의 약속일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = a1913041-d0e9-0afa-0db1-b40bf5140d55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:a1913041-d0e9-0afa-0db1-b40bf5140d55
msgctxt "h2291b878g79a7g424ag8edfgf33bb081beae"
msgid "<i>Say nothing. Wait for him to explain himself.</i>"
msgstr "<i>아무것도 말하지 않는다. 엘민스터가 스스로 말하길 기다린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = a1dff9e9-505e-a907-81dd-7527a6b057eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:a1dff9e9-505e-a907-81dd-7527a6b057eb
msgctxt "h526bc1e6gd518g4835g8721gdb5dabe24a1f"
msgid ""
"You must find the Heart of the Absolute, whatever that may be, and use "
"yourself as the catalyst that will burn it from this world."
msgstr ""
"게일 자네는 반드시 이 절대자의 심장부를 찾아내야 하네. 그것이 무엇이든, 자네 스스로를 화약 삼아 이 세계에 흔적조차 남지 않도록 태워 "
"없애버리게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = af6a63e6-5df9-2fe7-6017-636988b45731
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:af6a63e6-5df9-2fe7-6017-636988b45731
msgctxt "h5d92f027gb8f4g4c31ga091g4f2f08b9f179"
msgid ""
"Remember who she is, Gale. Mortal death is but a passing chapter to a "
"goddess - and to those who win her favour."
msgstr ""
"미스트라가 어떤 자인지를 기억하게, 게일. 필멸자의 죽음이란 여신에게는 그저 지나가는 과정일 뿐이야. 여신의 호의를 받는 자에게도 "
"마찬가지라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = b1d298f5-8b95-e344-72ed-8d640d7bf5d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:b1d298f5-8b95-e344-72ed-8d640d7bf5d2
msgctxt "h931df2d2g8a51g4754gaa37g455c6821b625"
msgid "Mystra would consider... forgiveness?"
msgstr "미스트라가... 용서를 내린다고요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Narrator
#. NodeID = b3bc19ce-6dec-462d-c03c-0baec802e2c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:b3bc19ce-6dec-462d-c03c-0baec802e2c6
msgctxt "h851dedb6g734dg4c86g8feag0b9de2c82322"
msgid ""
"*Your previous encounter with the old wizard seems to have left him "
"unflustered - and unmarked.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = b5c19a9c-549f-935b-45e0-e8493418a629
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:b5c19a9c-549f-935b-45e0-e8493418a629
msgctxt "h803e5f67gfefcg4732g9bb5g3dd17a914260"
msgid "Mystra sent you? Why?"
msgstr "미스트라가 보냈다고요? 왜죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = ba1d0d32-31ee-b329-79e4-6813288b37a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:ba1d0d32-31ee-b329-79e4-6813288b37a7
msgctxt "h96adfa18g4d80g4d20g9dfdg330671abbcf0"
msgid "Your clear-mindedness is a testament to yourself, Gale."
msgstr "명료한 정신이야말로 자네 그 자체일세, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = bb8cdd5f-5c7a-8cc2-3203-e286494ea9c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:bb8cdd5f-5c7a-8cc2-3203-e286494ea9c7
msgctxt "he680b726g9820g4addgba9agc9f3be35f394"
msgid ""
"The catch being the exact definition of redemption in Mystra's eyes, and the "
"labour you must undertake in order to attain it."
msgstr "그 할 일이야말로 미스트라의 시점에서 명확히 정의한 구원이며, 자네가 구원을 얻기 위해 치러야 할 노력이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = bce29de6-52a0-8a54-7410-dc24b46539d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:bce29de6-52a0-8a54-7410-dc24b46539d7
msgctxt "hcb945a2dg5331g4da6ga953gec564f259fa3"
msgid ""
"That is why I have come here to charge you, Gale, with its destruction. It "
"is Mystra's belief that only you can."
msgstr "그래서 이 일을 맡기려 내가 온 거라네, 게일. 절대자의 파괴를. 미스트라께서는 오직 자네만이 그걸 해낼 수 있다고 믿는다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = c21a67af-d179-9dc7-7b8c-1587f5f7e2c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:c21a67af-d179-9dc7-7b8c-1587f5f7e2c2
msgctxt "h09956029gda0eg4908gaac4g60ff8af4eae2"
msgid ""
"You must know that the Absolute is more dangerous than you can possibly "
"conceive. It threatens all who live - even those who are undying. It "
"threatens the gods, the Weave, the very fabric of the universe itself."
msgstr ""
"절대자는 자네가 상상할 수 있는 그 이상으로 위험하다는 걸 알아야 하네. 모든 산 자들을 위협하고, 살아있지 않은 자들까지 위협하지. "
"신들과, 우주를 구성하는 직조 그 자체인 위브마저 위협한단 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = c21b0f77-5948-81fa-6b1f-6bb9f2680c54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:c21b0f77-5948-81fa-6b1f-6bb9f2680c54
msgctxt "h35c44c46g654fg46c0gb85ag699fc487edd7"
msgid "As you say."
msgstr "자네가 말한 대로네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = c682f1c7-ecdf-134e-5f2a-f278f924c331
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:c682f1c7-ecdf-134e-5f2a-f278f924c331
msgctxt "h33223c6dgf627g4787gbb5ag2b695a334f4f"
msgid "Mystra - the message and the charge I bring you are hers."
msgstr "미스트라, 내가 자네에게 가져온 전언과 임무는 그녀가 보낸 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Gale
#. NodeID = c6ae4a7b-69ef-4ad5-c03e-32f29bf2fb7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:c6ae4a7b-69ef-4ad5-c03e-32f29bf2fb7e
msgctxt "hd2712300gc0fbg4ddega582g3b8e206db175"
msgid "You mean the orb. You mean I sacrifice myself."
msgstr "보주를 말씀하시는 거군요. 제가 희생해야 한다는 의미고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = ca23c0c7-1013-b795-9dfd-e2233d85f96f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:ca23c0c7-1013-b795-9dfd-e2233d85f96f
msgctxt "h0b0bdc74gd09fg4fafg80e4ga10d5a9c0788"
msgid ""
"You underestimate me, Elminster. 'She' could be any number of acquaintances."
msgstr "절 과소평가 하시는군요. 엘민스터 님. 그 '그녀'의 후보가 꽤 여러 명이거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = d3ebce64-aece-42cb-a0ae-2fddef813623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:d3ebce64-aece-42cb-a0ae-2fddef813623
msgctxt "h436a8046g5586g4924ga635ga5201b0c7b48"
msgid ""
"Gale, m'boy, I've come to address a most pressing matter. I'll speak as "
"plainly as I can, forswearing the accustomed frills that decorate my speech."
msgstr ""
"게일, 이 친구야. 나는 참으로 시급한 문제를 논의하러 왔다네. 내 발언을 으레 장식하는 미사여구들을 다 버리고 내 할 수 있는 최대한 "
"간략하게 말하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = d73e9d8b-dfc0-364b-1c6b-3c231f7743c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_ElminsterFallbackNight = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:d73e9d8b-dfc0-364b-1c6b-3c231f7743c7
msgctxt "hdcd1bea7g0006g42c0g93a7g6bc9543f9759"
msgid ""
"I took the liberty of enlisting your cadaverous co-traveller to revive you. "
"You truly should take much better care of yourself, m'boy."
msgstr "힘들어 보이는 자네 동료에게 자네를 되살려 달라 부탁했다네. 자네는 진정 자신을 더 잘 돌봐야 할 걸세, 이 친구야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = db8753e0-a31e-f407-6d15-0dfcbc780f85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:db8753e0-a31e-f407-6d15-0dfcbc780f85
msgctxt "h2e1337b0gdb1fg4e6ag9b36gb3c43d61c229"
msgid ""
"And yet - a notion born in lonely hours - come ebb, come flow, come all that "
"is beyond the breadth of our dominion: be a moon unto yourself."
msgstr ""
"그러나 얼마나 고독한 생각이란 말인가. 밀물, 썰물, 모든 것의 일어남이 우리의 영역 너머에 있다는 것은. 그대는 스스로의 달이 되도록 "
"하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Player
#. NodeID = deddf11a-71e2-ad35-f68c-27009a824cfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:deddf11a-71e2-ad35-f68c-27009a824cfa
msgctxt "h48e10ca1g148cg4515gaf49gbaf6a78315f8"
msgid "I could possibly put an end to the Absolute - if you aided me."
msgstr "제가 절대자를 끝장낼 수도 있을 거예요. 도와주시기만 하면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = f8a8a9c9-f2a9-ccea-6032-19ac48e86abb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:f8a8a9c9-f2a9-ccea-6032-19ac48e86abb
msgctxt "hc293514fg9118g45acg874cgf45db4dc8305"
msgid ""
"You could flee from Mystra's calling. Live the life of a hermit once again, "
"and succumb to the orb all the same. Only, it will be a death without "
"purpose."
msgstr ""
"자네는 미스트라의 부름에서 도망칠 수도 있을 게야. 다시 한 번 은둔자의 삶을 살고, 결국 보주에 굴하겠지. 그저 의미 없는 죽음일 "
"뿐이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Narrator
#. NodeID = fad8c295-8ef1-726a-b555-c201afed7772
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:fad8c295-8ef1-726a-b555-c201afed7772
msgctxt "hb5bde461gdbe3g4c6bgb2c1gd9cf9ca0056c"
msgid ""
"*Your previous encounter with the old wizard was most likely a simulacrum - "
"the figure before you may well be too.*"
msgstr "*지난번 만남에서의 이 노마법사는 아마 시뮬라크럼 환영이었던 모양입니다. 지금 눈앞의 형상도 마찬가지겠군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone
#. Speaker = Weary Traveller
#. NodeID = fc4c1421-14cd-5a83-42c8-49d39bbc274c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotOneMagicItem = False
#.      - ORI_Gale_State_EnoughRegionsToAskMagicItem2 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleAlone:fc4c1421-14cd-5a83-42c8-49d39bbc274c
msgctxt "h9de12168g9a35g46d4gb344g632e43997945"
msgid ""
"A shame that we did not cross paths sooner. The orb's thirst for magic is "
"now quenched, yet it already inflicted some damage while you tried to forge "
"ahead."
msgstr ""
"좀 더 빨리 만났더라면 좋았으련만. 보주의 마법에 대한 갈증은 해소했지만, 자네가 뭔가 해 보려고 하는 동안 이미 약간 피해를 입혔다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 00481cac-df83-41fe-ae44-299fa53328b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:00481cac-df83-41fe-ae44-299fa53328b9
msgctxt "h7e21bfd9gd049g4e9fga714gf21d921dcc6d"
msgid ""
"Mmm, yes, what a delightful wedge of Old Elturian that was. Doesn't do to "
"parley on an empty stomach, you know. Makes one's words frivolous when they "
"should be grave."
msgstr ""
"으음, 좋구나. 엘투렐 치즈가 참으로 진미였어. 알다시피 빈 속에 회담하는 것은 좋지 않다네. 진중한 말을 해야 하는데 장난이 튀어나온단 "
"말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 03b1a8b7-570a-4b22-8cdc-90357e6b2d4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:03b1a8b7-570a-4b22-8cdc-90357e6b2d4a
msgctxt "h437a645fgc6ffg41e3ga82agdaa048332fea"
msgid ""
"Why, some bread, cheese, and a cup of wine would appear unto me a feast! "
"Surely you won't begrudge me a mite of rest and repast before I get 'out "
"with it'?"
msgstr ""
"그러니, 지금의 나에겐 빵과 치즈, 포도주 한 잔이면 잔치와도 같다네! 혹시 자네는 내가 '털어놓기' 전에 잠깐의 휴식과 식사 시간 "
"정도도 못 양보하는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 064cf9c8-2a87-40d0-a49d-50b80e9dfab2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:064cf9c8-2a87-40d0-a49d-50b80e9dfab2
msgctxt "h4fe2c54dg59d1g485egafb3gfd9279616839"
msgid ""
"And yet - a notion born in lonely hours - come ebb, come flow, come all that "
"is beyond the breadth of our dominion: be a moon unto yourself."
msgstr ""
"그러나 얼마나 고독한 생각이란 말인가. 밀물, 썰물, 우리에게 일어나는 모든 것들이 우리의 영역 너머에 있다는 것은. 그대는 스스로의 "
"달이 되도록 하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 07fe164c-0faf-44c8-ac75-293440a98a67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:07fe164c-0faf-44c8-ac75-293440a98a67
msgctxt "h5b32bbe2gbfa4g468eg8e3bg20a91863092f"
msgid ""
"I may be slow to anger, but I will <i>not</i> have you sully this moment of "
"most sorrowful import with ill-considered levity!"
msgstr ""
"내 쉬이 화를 내는 성정은 아니네만, 자네가 이런 비애의 순간을 경솔한 언행으로 망치는 것을 <i>결코</i> 두고 보진 않을 걸세!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 08857604-67a1-4161-bc4a-d9a7bfaa949c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:08857604-67a1-4161-bc4a-d9a7bfaa949c
msgctxt "hea7ba3f4g1912g452dg977dg960ceeba12a6"
msgid ""
"The long-awaited question. Now - if you please, Elminster - for the too-long-"
"awaited answer."
msgstr "한참을 기다린 질문이네. 엘민스터 님, 그럼 이제 한참을 기다린 답을 해주시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 09dd405d-cf0a-4316-972b-0bf29098e9cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:09dd405d-cf0a-4316-972b-0bf29098e9cb
msgctxt "h90681ca4gf0e3g4dfcgbbe8g692af09d970a"
msgid "Mystra would consider... forgiveness?"
msgstr "미스트라가... 용서를 내린다고요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 0ae255a7-eda4-4a89-ab48-0c2e4f3ca1eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:0ae255a7-eda4-4a89-ab48-0c2e4f3ca1eb
msgctxt "hbf78cd0bgb0a0g4ba8g8cf0gffab580b9741"
msgid "Precisely."
msgstr "바로 그걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 0f866fe8-3a73-4af9-8255-ffd1ee267472
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:0f866fe8-3a73-4af9-8255-ffd1ee267472
msgctxt "h0a4448e1g6e2fg4c5egb6e7g08b9e2f7e018"
msgid "If even the gods know, why are we facing these threats alone?"
msgstr "신조차도 아는 일이라면, 어째서 이 위협을 우리 혼자서 맞서는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 10c2b476-9d5d-4b80-8a12-aec0928bb54b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:10c2b476-9d5d-4b80-8a12-aec0928bb54b
msgctxt "h995f6c7eg8ff7g4f85gac12gc7476da4c0d9"
msgid "The very purpose of my presence - in a roundabout sort of way."
msgstr "그것이 바로 내가 이곳에 있는 이유지... 다소 간접적인 방식이긴 하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 131e0289-c93e-435b-9796-dba8b47561e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:131e0289-c93e-435b-9796-dba8b47561e7
msgctxt "h67a90835gd796g48feg914cg72a045a0bbf5"
msgid "Right. Ahem. You see..."
msgstr "그래. 으흠. 그러니까..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 13bb3587-e45a-4242-8b7b-5c38111a9c7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:13bb3587-e45a-4242-8b7b-5c38111a9c7d
msgctxt "hba477cd6g054ag457cg8e3fg7f3eeccf701c"
msgid ""
"Gale, m'boy, I've come to address a most pressing matter. I'll speak as "
"plainly as I can, forswearing the accustomed frills that decorate my speech."
msgstr ""
"게일, 이 친구야. 나는 참으로 시급한 문제를 논의하러 왔다네. 내 발언을 으레 장식하는 미사여구들을 다 버리고 내 할 수 있는 최대한 "
"간략하게 말하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 178e2965-88d4-4055-a4d4-87bdf6f3bfd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:178e2965-88d4-4055-a4d4-87bdf6f3bfd2
msgctxt "hb25022edg5a01g4c10g99b2gcec6b22961fb"
msgid "The orb."
msgstr "보주 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 1b85f895-76bf-45ac-9128-259f90d0884e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:1b85f895-76bf-45ac-9128-259f90d0884e
msgctxt "h31d612f8g950cg4c73gb9e5g154582d3654d"
msgid "There's still a long journey ahead. We'll find another way."
msgstr "아직 이 여정은 깁니다. 우린 다른 방법을 찾을 수도 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 1d257a89-b412-4474-b988-28fa8374632f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:1d257a89-b412-4474-b988-28fa8374632f
msgctxt "h3c101ea3g63ecg4c60gbfb5g532bf2dab3cf"
msgid ""
"It brings me no pleasure saying this, my friend, but such is Mystra's will. "
"Yours must be the sacrifice that will undo the Absolute. And for your "
"sacrifice, you will be redeemed - such is Mystra's promise."
msgstr ""
"이런 말을 하게 되어 유감이지만, 이것이 미스트라님의 뜻이네. 자네가 절대자를 쓰러트릴 희생양이 되어야 하네. 그리고 자네는 그 희생으로 "
"구원받을 것이네. 이것이 미스트라의 약속일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 1d44745f-6577-4586-a938-c743f1472bbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:1d44745f-6577-4586-a938-c743f1472bbf
msgctxt "hc40a5589g2115g4f60g8fedg41ce17dd751b"
msgid "I can't say that so far I've volunteered the entire truth."
msgstr "사실 완전한 진실을 털어놓았다고는 할 수 없겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 1ef0b7d0-8565-4eea-8ec1-43634b97f447
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:1ef0b7d0-8565-4eea-8ec1-43634b97f447
msgctxt "ha677515fg1cd0g4002gb673g8f787190d934"
msgid ""
"Do not discount yourself, and by the same token, do not discount your enemy."
msgstr "스스로를 과소평가하지 말게. 마찬가지로 자네의 적 또한 과소평가해선 안 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 2083de03-5570-4580-999e-39f4021cf539
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:2083de03-5570-4580-999e-39f4021cf539
msgctxt "h92edce26g5219g4cb5gb039g56993bbed040"
msgid ""
"That which I speak of, as Gale well knows, is neither idle nor false. Rather "
"it is... unnatural."
msgstr "내가 말하는 것은, 게일도 잘 알듯이, 나태하지도 거짓되지도 않았다네. 그보다는 되려... 비자연적인 물건이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 243c9389-2357-400d-859f-58a88a0dd913
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:243c9389-2357-400d-859f-58a88a0dd913
msgctxt "he209c9b0g1495g40c1g9935g95a0e479a2c5"
msgid ""
"His acts were misguided, yes, but I assure you that deep down he has a heart "
"of - let's say at least silver. Which is more than can be said for the foe "
"you face."
msgstr ""
"그래, 이 친구의 행동이 잘못되긴 했지. 하지만 마음 속 깊은 곳에는 순수한... 적어도 선한 마음을 지니고 있을 거라네. 자네가 맞서는 "
"적과는 달리 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 275129ed-3310-4a0c-98e6-11bc7525f540
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:275129ed-3310-4a0c-98e6-11bc7525f540
msgctxt "h6d0b4770gacacg458eg8141g62511060f42d"
msgid "Say what you will, but you can't force Gale to go through with this."
msgstr "뭐라고 하시든, 게일에게 이런 일을 강제로 시킬 수는 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 278e1bea-ac61-40ce-8f8f-bcb0822f12fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:278e1bea-ac61-40ce-8f8f-bcb0822f12fd
msgctxt "haed08436g487cg4be4gaff4g5a598deede08"
msgid ""
"The very same, Gale. And a fair bit miffed he is, too, finding himself "
"forced to expose his best pair of boots to so many miles of country road on "
"your behalf."
msgstr ""
"바로 그렇네, 게일. 뿐만 아니라 엘민스터 님께선 상당히 심통이 나기도 했지. 가장 아끼는 신발이 자네를 찾아 정처없이 시골길을 걷느라 "
"엉망이 되었으니 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 286728c0-de63-4aa5-aab9-2049f2172ec5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:286728c0-de63-4aa5-aab9-2049f2172ec5
msgctxt "h49a7b2d5g2bf1g42cbgbc2cg8761bc7fb8d9"
msgid "You were sent here as an actual divine messenger?"
msgstr "정말로 신의 전령으로서 왔단 말입니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 2957fad1-6f85-46a2-9235-d69ffd981f69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:2957fad1-6f85-46a2-9235-d69ffd981f69
msgctxt "hf0481daegf459g4cb8gbe1dgcac875fa2d12"
msgid ""
"You must find the Heart of the Absolute, whatever that may be, and use "
"yourself as the catalyst that will burn it from this world."
msgstr ""
"게일 자네는 반드시 이 절대자의 심장부를 찾아내야 하네. 그것이 무엇이든, 자네 스스로를 화약 삼아 이 세계에 흔적조차 남지 않도록 태워 "
"없애버리게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 2dd15218-c610-45bc-b876-5efbe71adf87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:2dd15218-c610-45bc-b876-5efbe71adf87
msgctxt "h1242af4fg66d2g4aaeg99d0g5d88ab53601b"
msgid ""
"Mystra is aware of the misadventures that have befallen you both. She knows "
"of your strife with the Absolute, that most insidious of evils."
msgstr "미스트라께서도 자네들이 겪은 모험에 대해 잘 알고 계신다네. 음흉하기 그지없는 위험인 절대자와 싸우고 있다는 것도 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 35f20219-7497-4cfd-ab61-8b1e45c8446c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:35f20219-7497-4cfd-ab61-8b1e45c8446c
msgctxt "hedf2c94agc05bg4997ga1e9g425b90ec27be"
msgid "That's monstrous! You're tasking him to kill himself."
msgstr "무슨 끔찍한 소립니까! 지금 게일더러 자살하라는 거 아닌가요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 3639176d-b781-4985-97f9-abdc9fdd87ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:3639176d-b781-4985-97f9-abdc9fdd87ba
msgctxt "h866d6e3eg22afg4d53gb5dbg8da5083563c2"
msgid ""
"Alas, such luxuries require the beneficence of time, and time, as I'm sure "
"our friend here will attest, is the very luxury of which we're all too "
"bereft."
msgstr ""
"안타깝게도, 그런 사치는 시간의 호의를 필요로 하는 법이니. 여기 있는 우리 친구가 아주 잘 알겠지만, 시간이야말로 우리에게 부족한 "
"사치품이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 36a3c9f9-c7a0-446e-8369-637c8ca8f847
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:36a3c9f9-c7a0-446e-8369-637c8ca8f847
msgctxt "hc809d86cgf2bfg4c38g9cffgfee5fd4cbd39"
msgid ""
"You must know that the Absolute is more dangerous than you can possibly "
"conceive. It threatens all who live - even those who are undying. It "
"threatens the gods, the Weave, the very fabric of the universe itself."
msgstr ""
"절대자는 자네가 상상할 수 있는 그 이상으로 위험하다는 걸 알아야 하네. 모든 산 자들을 위협하고, 살아있지 않은 자들까지 위협하지. "
"신들과, 우주를 구성하는 직조 그 자체인 위브마저 위협한단 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 37249e9a-4da0-4066-b9be-ea770400a258
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_ElminsterFallbackNight = False
#.      - ORI_Gale_Event_PlayersWithElminsterToCamp = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:37249e9a-4da0-4066-b9be-ea770400a258
msgctxt "he4f54ccbg257ag4a8egbf44g51807789b20b"
msgid ""
"Ah! There you are. I hope you don't mind my having ingratiated myself into "
"the most palatable graces of your provisions. You find me quite sated indeed."
msgstr ""
"아! 이제 오는군. 내가 자네 식량 주머니에서 맛좋은 음식을 찾아낸 것을 양해해 주길 바라네. 과연, 참으로 만족스러운 식사였지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 37f6828d-1cb9-47a3-b052-51b718daeeea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:37f6828d-1cb9-47a3-b052-51b718daeeea
msgctxt "h1426a8a9ge825g4a19gb998gddbdd47c2ad6"
msgid ""
"In short, Gale - through his own doing - has become a living explosive that "
"could wipe from this world this very gathering, and much more besides."
msgstr ""
"요는, 여기 게일은 자신이 자초한 일의 결과 걸어다니는 폭발물이 되었고, 그 힘은 여기 있는 이 모두와 그 주변을 이 세상에서 지워버릴 "
"수 있을 정도로 강력하다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 3acecc96-efcd-42cd-93a0-898c077f1eaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:3acecc96-efcd-42cd-93a0-898c077f1eaa
msgctxt "h1ed5712fge36dg427bg8bc3g7579188a7896"
msgid "But why? Out with it, Elminster. Please!"
msgstr "하지만 이유가 뭡니까? 빨리 좀 털어놓으시죠, 엘민스터 님!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 3bb1306a-9b8a-4b31-b965-0dc1689e6a5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:3bb1306a-9b8a-4b31-b965-0dc1689e6a5b
msgctxt "h9546eebcg7c8cg41b7gb659g0d661a0daea4"
msgid "Even the waves of fate can break upon the shores of will."
msgstr "운명의 파도조차도 의지의 제방 앞에선 부서질 수 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 45657e9c-0e09-4668-b092-0c934be9150d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:45657e9c-0e09-4668-b092-0c934be9150d
msgctxt "h47386f75g9029g4919g9b77ga5a88824f302"
msgid ""
"To you, I commit into care Gale himself. I count on you to shepherd him well "
"on this strangest of journeys."
msgstr "자네에게 게일을 부탁하지. 자네가 이 낯선 여정에서 게일을 잘 이끌어주길 믿네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 484e8c8f-787d-435f-bd1d-8e90abed715d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:484e8c8f-787d-435f-bd1d-8e90abed715d
msgctxt "h89d7f824g0c0eg4034g9b55ga4bf4ca3adef"
msgid "Oh, for the love of..."
msgstr "하, 제발 좀..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 4dfd11fd-d9a4-4551-ab0a-bf61a9599790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:4dfd11fd-d9a4-4551-ab0a-bf61a9599790
msgctxt "h46e43101g3501g40d8gabc7g9118696207a5"
msgid "I suppose we could part with a few of our rations."
msgstr "저희 식량 조금은 나눠드릴 수 있을 것 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 51272f68-1fab-47ea-8080-2491a7397b90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:51272f68-1fab-47ea-8080-2491a7397b90
msgctxt "h2a7e2d2egc9a2g4fdbg8678g28e94c8a297a"
msgid "Thank you for that most considerate reminder."
msgstr "그 일을 친절하게도 상기시켜 주어 고맙네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 515abf4f-2121-477f-bf06-6a6e9f7bde5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:515abf4f-2121-477f-bf06-6a6e9f7bde5f
msgctxt "had1c6a2fge2d2g400bga6d6gd9c67bc36135"
msgid ""
"It's all right, Elminster. If ever gallows humour were appropriate, this is "
"its grim-smiling hour."
msgstr "전 괜찮습니다, 엘민스터 님. 아무리 죽음을 가지고 농담하는 것이 부적절하다 해도, 이럴 때 아니면 언제 해 보겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 52341a9b-e90f-4764-a785-55ee8b1d16ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:52341a9b-e90f-4764-a785-55ee8b1d16ee
msgctxt "hf61e9935g9724g4479gb135ge8c5e5d640c4"
msgid "Surely you could have conjured any feast you liked."
msgstr "원하시는 음식은 무엇이든 조형술 마법으로 만드실 수 있었을 텐데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 5a1c3b72-699a-4ada-a3f9-bc8db29e3193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:5a1c3b72-699a-4ada-a3f9-bc8db29e3193
msgctxt "heff71095g5115g4c47gbd20g5a09361477b6"
msgid "Or some other fortune altogether."
msgstr "아니면 완전히 다른 미래를 찾을지도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 5a9a525f-3b8f-4248-916c-4ef124723d94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:5a9a525f-3b8f-4248-916c-4ef124723d94
msgctxt "h1ddc2173g7976g473egbd0fg95384d863c61"
msgid ""
"For his folly, Mystra forsook him, but now she has decreed he is to be given "
"a chance of redemption."
msgstr "미스트라께서는 그 죄를 물어 게일을 내쳤으나, 이제 이를 만회할 기회를 내리겠다고 선언하셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 5c65f713-a169-46c9-9124-3dba326368be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:5c65f713-a169-46c9-9124-3dba326368be
msgctxt "h87d733f0gb125g42dcg889cgca76beec7d97"
msgid ""
"Like moons make swell and wane the nescient seas, so too the sky-strewn gods "
"ordain the tidal fates of mortal days."
msgstr "달이 모든 바다의 밀물과 썰물을 만드는 것처럼, 하늘에 있는 신들도 필멸할 운명들의 차고 기울어짐을 규율한다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 5e6d04b8-3cb7-4439-b9aa-711d0f299402
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:5e6d04b8-3cb7-4439-b9aa-711d0f299402
msgctxt "hf952f5f2g4348g4ca6g87f3g5bcc126ae367"
msgid "We'll be rid of both the Absolute and Gale in one fell swoop. Win-win."
msgstr "절대자하고 게일을 한 방에 없애버린다니, 이거 일석이조네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 5f40e139-74dd-4f6a-82f0-1b2701c14994
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:5f40e139-74dd-4f6a-82f0-1b2701c14994
msgctxt "h6022977bgd964g4319gb586g4148f18134ad"
msgid ""
"Come, come, up you both stand. I, for one, am dying to find out what's for "
"breakfast."
msgstr "자, 자, 그럼 둘 다 일어나게나. 과연 무슨 조반이 나를 기다리고 있을지 목이 빠지게 고대하고 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 5f9b3da3-882e-4397-ae1a-9ed1df42d608
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:5f9b3da3-882e-4397-ae1a-9ed1df42d608
msgctxt "hd8564855g971fg4419g97ffgb7972a8e1202"
msgid ""
"I'm surprised that Mystra demands such a sacrifice. This is hardly her way."
msgstr "미스트라가 이런 희생을 요구한다는 게 의외입니다. 이건 그분 방식이 아닐 텐데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 62d50ee5-18f3-477d-8402-5c85212cd109
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:62d50ee5-18f3-477d-8402-5c85212cd109
msgctxt "h423332b1ge529g470dgac54ge1b3f6d7d041"
msgid "She would consider what she considers to be forgiveness."
msgstr "자신이 나름 용서라고 생각하는 것을 내리셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 63272152-65f1-4e31-8f57-2a0141574e93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:63272152-65f1-4e31-8f57-2a0141574e93
msgctxt "hb95e57aeg736ag4a2ag9089gaa07ee7f5ec9"
msgid ""
"Alas. The creature that afflicts you, the ill-begotten magic that it weaves, "
"is inextricably conjoined with both the greater purpose and the greater "
"master that it serves."
msgstr ""
"아아, 자네를 괴롭히는 그 생물과, 그것이 직조하는 악에서 유래된 마법. 안타깝지만 그들은 강대한 주인과 그자의 거대한 목표에 단단히 "
"엮여 하나로 되었다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 64ef4d71-4908-349c-2907-0a1436fa2878
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_ElminsterWasDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:64ef4d71-4908-349c-2907-0a1436fa2878
msgctxt "h0e56eeb7gece9g4009ga277ga64546cf33ad"
msgid ""
"Must have been his simulacrum you bested. He always was a cautious traveller."
msgstr "네가 쓰러뜨린 건 시뮬라크럼이었을 거야. 이분은 항상 조심성 있는 여행자셨으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 6b98d1a5-79d6-4579-9ccf-dd7657debe19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_LearnedBackstory = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:6b98d1a5-79d6-4579-9ccf-dd7657debe19
msgctxt "hbc60a38eg7e4dg41bcg87e0g0e7f66cc2f67"
msgid ""
"You know where you went wrong, Gale, and I trust you've told your fellow "
"traveller here the nature of your ills."
msgstr "게일 자네도 자신이 무엇을 잘못했는지는 알고 있겠지. 분명 그 잘못의 내용을 여기 이 여행자 친구에게도 말했을 것이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 6be9d5e5-e0b9-48d0-b2c7-8294f8d043b7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:6be9d5e5-e0b9-48d0-b2c7-8294f8d043b7
msgctxt "h1ba82351ga12cg4452g90cag11160378cd64"
msgid "She'd do well to place her trust in me in equal measure."
msgstr "그런 신임을 제게도 똑같이 보이셔야 옳을 텐데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 6c397cdc-5f5d-485f-922a-bb1b0b26b1c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:6c397cdc-5f5d-485f-922a-bb1b0b26b1c6
msgctxt "h0141603agb63cg4e4bg87e0g056466627e65"
msgid "Then you two have much to discuss after I'll have taken my leave."
msgstr "그렇다면 내가 떠난 후에도 자네들이 나눌 이야기가 많겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 6c72e57a-09e3-40c1-bbeb-f4cfdd4ca3a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:6c72e57a-09e3-40c1-bbeb-f4cfdd4ca3a6
msgctxt "he3920d41gf784g422eg9a7bg8dff770c905c"
msgid "On my honour, I'm not sure yet I can say the same."
msgstr "제 명예를 걸고, 아직은 저도 그러하겠다고 말할 수가 없군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 6dc5ebd1-3ae5-4691-9249-c357627452a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:6dc5ebd1-3ae5-4691-9249-c357627452a8
msgctxt "h6866aa80g1fb3g4069ga67cg571b9d4da291"
msgid "It is done. Both charge and charm have been committed into your care."
msgstr "다 되었네. 임무와 주문은 모두 자네에게 맡겨졌네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 6fee18e0-88f4-45c0-adbd-b05b29c64ee1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:6fee18e0-88f4-45c0-adbd-b05b29c64ee1
msgctxt "h4b952e80g6bcag4eeegb44ag9972b12e78c0"
msgid "I'm not in the habit of taking in vagabonds."
msgstr "전 떠돌이는 안 받습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 7345997e-3672-4fb7-890f-e48aa77cd131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:7345997e-3672-4fb7-890f-e48aa77cd131
msgctxt "hb7517348ge81cg4b5ag9e1dg1c85f527eba8"
msgid "I doubt not your conviction. But Gale has an unnatural advantage."
msgstr "자네의 결의를 의심하는 건 아닐세. 다만 게일에겐 비자연적인 이점이 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = 7647418b-c711-4013-9576-952cffc82392
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:7647418b-c711-4013-9576-952cffc82392
msgctxt "h7004c8ddg1977g4578g92fbg9ded493eedbf"
msgid "Elminster?"
msgstr "엘민스터 님?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 775eafc3-4519-43d8-8532-2c55c7826a96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:775eafc3-4519-43d8-8532-2c55c7826a96
msgctxt "ha33736b0g1066g45bbg8604g8898291fbea2"
msgid ""
"Oh? And what is he, then, wandering these forlorn barrens over seven hundred "
"miles from home?"
msgstr "오? 그럼 저 친구는 뭔가. 집에서 칠백 마일 떨어진 황야를 돌아다니고 있는데 말일세?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 7804e1d9-7348-4a52-8e7f-8dc9d140f9a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:7804e1d9-7348-4a52-8e7f-8dc9d140f9a8
msgctxt "hf1c0d7ebg7d61g489dg96cage3c173351237"
msgid "Speak fast, then, for none of this pertains to me."
msgstr "어차피 나와는 관계가 없는 일이니 빨리 말하시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 79d12b75-f166-42a4-89b9-4b047f8034e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:79d12b75-f166-42a4-89b9-4b047f8034e9
msgctxt "h5fe627fdgb8ffg43f3g9d19g3cd9b9f97933"
msgid ""
"With that, I've said my sorry piece, and need only bestow unto thee the "
"charm I was bid."
msgstr "이걸로 유감스러운 소식은 다 전했군. 이제 자네에게 방금 말한 주문을 걸어주는 일만 남았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 7d615559-57e6-4421-b97e-ffc31858708e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:7d615559-57e6-4421-b97e-ffc31858708e
msgctxt "h4e4e2683g2731g4af5g9f5agdd732032952e"
msgid "Mystra is mistaken. I will be the Absolute's destroyer."
msgstr "미스트라가 잘못 생각한 거예요. 제가 절대자를 파괴할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 947ae7d2-997d-4fc4-9ba4-105c6cbd5f35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Elminster_State_DeniedGale(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:947ae7d2-997d-4fc4-9ba4-105c6cbd5f35
msgctxt "ha4fbb3aage53ag4209g8661gdb26e3f78077"
msgid ""
"Your friend here denied having the pleasure of your acquaintance, Gale, but "
"I'll assume this feigned ignorance was committed with more or less noble "
"intentions."
msgstr ""
"여기 있는 이 친구가 자네를 만나게 허락하지 않더군, 게일. 하지만 이 무지한 연기는 어느 정도 숭고한 의도로 행했으리라 믿도록 하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 9624dd58-8d43-4902-b6af-039a3f75f049
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_PlayersWithElminsterToCamp = True
#.      - ORI_Gale_Event_PlayersWithElminsterToCampWithGale = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:9624dd58-8d43-4902-b6af-039a3f75f049
msgctxt "h3867ad80ga559g41ddgafe1g71719ade9a8a"
msgid ""
"My thanks for your excellent guidance. Ah! And yonder I spy the object of my "
"pursuit."
msgstr "자네의 훌륭한 안내에 감사하네. 아! 그리고 저기 내가 추적하던 대상이 보이는구려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 9b54018d-4072-48c3-b640-538435cee2f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:9b54018d-4072-48c3-b640-538435cee2f8
msgctxt "hc2718b12gd394g47beg9735g794740c7de3f"
msgid "What message and what charge would that be?"
msgstr "그 전언과 임무가 뭐죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = 9d4e7856-e6cb-439f-b638-d25e24a1408d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:9d4e7856-e6cb-439f-b638-d25e24a1408d
msgctxt "h16eb264egc701g4fdbg85bag68482ce32828"
msgid ""
"That is why I have come here to charge you, Gale, with its destruction. It "
"is Mystra's belief that only you can."
msgstr "그래서 이 일을 맡기려 내가 온 거라네, 게일. 절대자의 파괴를. 미스트라께서는 오직 자네만이 그걸 해낼 수 있다고 믿는다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = 9ea6dadf-4696-4e8a-b80b-23de751b530d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_LearnedBackstory = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:9ea6dadf-4696-4e8a-b80b-23de751b530d
msgctxt "h6ec3fb01g0447g4249g8532g5f013cfe33e2"
msgid "It sounds like the most insidious of evils was actually Gale all along."
msgstr "이제보니 정말로 음흉하기 그지없는 위험은 사실 게일이었던 것 같은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = a49e30d9-b2b9-43ed-ba18-ec0003790acb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:a49e30d9-b2b9-43ed-ba18-ec0003790acb
msgctxt "h845a5b1egfa02g4e17g953ag40ff4a22fecd"
msgid ""
"Fine, fine, I'll turn a deaf ear to the clarion calls with which my scorned "
"stomach beseeches me. Graver matters are at hand."
msgstr ""
"거 참, 알겠네. 이 천대받는 주린 배가 애원하고 간청하는 것을 내 잠시 외면하도록 하지. 더 심각한 문제를 논의해야 하니 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = aa564c1b-4f0f-4051-b2b8-ab7aaeed693a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:aa564c1b-4f0f-4051-b2b8-ab7aaeed693a
msgctxt "h4daf32a5gec54g403bg8b2egf57d2c471c28"
msgid "He is not. But it seems that Mystra is."
msgstr "이분이 그러는 게 아니지. 미스트라가 내린 임무야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = aab1df53-6d3c-4537-918d-775821b68b28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:aab1df53-6d3c-4537-918d-775821b68b28
msgctxt "h733c4329g1243g4909ga2e2g99566e8cdd67"
msgid "No indeed. But I think she trusts me to."
msgstr "그렇지. 하지만 미스트라는 내가 따르리라 믿고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = ad1a4c1c-c2cf-4ffc-b5f5-205ad58563bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:ad1a4c1c-c2cf-4ffc-b5f5-205ad58563bd
msgctxt "h9c384550g91bbg4270gb41bgc631fcc246dd"
msgid ""
"I was bid to spare neither time nor my own self to find you. <i>She</i> sent "
"me, Gale. You know of whom I speak."
msgstr "시간도, 내 몸도 아끼지 말고 자네를 찾아달라는 부탁을 받았다네. <i>그분이</i> 직접. 누구를 말하는지는 알겠지, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = b220d8b2-96dd-4a93-affb-6ac9dd846275
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:b220d8b2-96dd-4a93-affb-6ac9dd846275
msgctxt "hf403c97ag51f4g4a52gafccg1b5d02d6fcb6"
msgid ""
"If the goddess herself is aware, I wouldn't say no to some divine "
"intervention."
msgstr "여신마저도 알고 있는 일이라면, 신의 개입으로 좀 도와주면 좋겠는데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = b3f2b7d1-14ad-4b3e-9897-d5870c475b47
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Event_BombDisarmed = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:b3f2b7d1-14ad-4b3e-9897-d5870c475b47
msgctxt "haaa75bc5g072cg4ee9gb983g34289b31e244"
msgid "My'Nahastra Mystra'Ryl. E'Deelion Thras'Anas'Tthra."
msgstr "마이나하스트라 미스트라릴. 이달리온 쓰라스아나스티쓰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = b6f227d5-27a7-4b5b-826a-d72d0fccf74a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:b6f227d5-27a7-4b5b-826a-d72d0fccf74a
msgctxt "hf87406dcgf9c1g44adg8d9eg71c8e7118d1b"
msgid ""
"Plenty to digest, after all. A good deal to stew over, if you will. Words "
"ladled with import should be savoured so as to better absorb their meaning, "
"wouldn't you agree?"
msgstr ""
"뭐, 참으로 소화하기 힘든 주제이기도 하니까. 푹 고아내야 한단 말이지. 자고로 이토록 중요한 전언은 한 술 한 술 천천히 음미해야 그 "
"뜻을 제대로 삼킬 수 있단 말일세. 안 그런가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = b879843d-884d-44e2-9319-fe275f63fe9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:b879843d-884d-44e2-9319-fe275f63fe9e
msgctxt "h19b277dbgb74cg4985g87d2gfaa30598b1e4"
msgid "Yes, Gale. Where <i>is</i> your decorum?"
msgstr "맞아, 게일. 예의는 대체 <i>어디다</i> 둔 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = b936caef-5bef-420c-895b-61346c813e4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:b936caef-5bef-420c-895b-61346c813e4d
msgctxt "hb10fb216g3cffg4473g89e6g18f33e6415d8"
msgid "Hogwash. Idle beliefs and false hopes."
msgstr "헛소리구만. 나태한 믿음과 잘못된 희망이겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = bdac79bc-12e7-439d-bb83-9d97dc950b56
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:bdac79bc-12e7-439d-bb83-9d97dc950b56
msgctxt "h579daab1g6b45g4e9egb942ga3f41a73d174"
msgid "If this is truly Mystra's will, I will do my best to see it done."
msgstr "이것이 진정 미스트라님의 뜻이라면, 최선을 다해 그 뜻을 이루겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = bdac79bc-12e7-439d-bb83-9d97dc950b56
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:bdac79bc-12e7-439d-bb83-9d97dc950b56
msgctxt "hb440182egeab3g4154gafe3gaf1c36eade01"
msgid "On my honour, it shall be done."
msgstr "제 명예를 걸고, 그렇게 하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = bfe5954d-6de1-4e6c-a674-49e14debfe00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:bfe5954d-6de1-4e6c-a674-49e14debfe00
msgctxt "h9218a163ga54bg4b96g9ac6g3ff35b33ceae"
msgid "Not in so many words, no."
msgstr "자세하게 명시하지는 않았습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = c32adfee-e779-4934-b4f7-b7e6e4049d91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:c32adfee-e779-4934-b4f7-b7e6e4049d91
msgctxt "h45933073gc996g4440gbc9fg90e5bc192c8f"
msgid "Gale alone? How so?"
msgstr "게일이 혼자서요? 어떻게 그럴 수가 있죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = c46a80c1-a2d4-4023-92d2-81d49ed974f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:c46a80c1-a2d4-4023-92d2-81d49ed974f8
msgctxt "h48e0d71dg3ac1g4dcfg988cg94c94ca3be29"
msgid ""
"By circumstance, but not by purpose, I swear. I never intended you any harm."
msgstr "의도적이 아니라 상황 때문이었다고 내가 장담할 수 있어. 네게 해를 끼치려는 의도는 전혀 없었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = c67d47ac-2296-4153-9ac5-1f91c4cd0a28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:c67d47ac-2296-4153-9ac5-1f91c4cd0a28
msgctxt "h47e123ddgbcb7g4f76g9b65gcdcfa3efbfa5"
msgid ""
"Do you mean to say you never bothered to disclose how dangerous you are?"
msgstr "설마 자네가 얼마나 위험한지 여태껏 한번도 언급하지 않았단 말인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = ca6d8471-89bf-4a9b-8261-fc68ff1e0135
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:ca6d8471-89bf-4a9b-8261-fc68ff1e0135
msgctxt "h24e39842gf93bg4596g9d0bg61ad36d97c87"
msgid ""
"And a great kindness that would be! See, Gale? Even in these barren parts, "
"the art of hospitality begets inspired new works if one only keeps up the "
"practice."
msgstr ""
"참으로 자애롭군! 보았나, 게일? 아무리 이런 황야에 나와 있더라도, 환대라는 기술을 꾸준히 갈고닦으면 새로운 작품이 탄생하는 법이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = cc8f3ccb-3237-4431-8732-a8585d9bc8e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_LearnedBackstory = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:cc8f3ccb-3237-4431-8732-a8585d9bc8e1
msgctxt "hdb3cb217g9a99g457fga409g8e57e7fdcf10"
msgid ""
"That which renders him so dangerous is an orb of Netherese origin that is "
"buried within his chest. And that, Gale, is how we arrive at the heart of my "
"directive."
msgstr ""
"이 친구가 그토록 위험한 것은 바로 가슴에 지닌 네더릴 마법의 보주 때문이지. 게일, 바로 그것이야말로 내가 가져온 전언의 핵심이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = cd480fc7-e10b-48c4-b087-39599dbae743
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:cd480fc7-e10b-48c4-b087-39599dbae743
msgctxt "h5efc871dgd496g4027g9ae3g8895df6c1746"
msgid "I, er... ahem. That is to say..."
msgstr "난, 어, 으흠... 말하자면야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = GROUP_Daisy
#. NodeID = cf148547-ff0d-4cbe-91a8-2fc210888fe4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:cf148547-ff0d-4cbe-91a8-2fc210888fe4
msgctxt "hc03ecaeeg9923g4a43gb54dg4a16a5fe96f7"
msgid "Interesting. This could be help or hindrance - we shall have to see."
msgstr "흥미롭군요. 도움이 될지, 방해가 될지는 두고 볼 일이겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = GROUP_Daisy
#. NodeID = cf148547-ff0d-4cbe-91a8-2fc210888fe4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:cf148547-ff0d-4cbe-91a8-2fc210888fe4
msgctxt "h95b16d34g9419g4524gbc43ga450f6d85a32"
msgid "Interesting. This could be help or hindrance - we shall have to see."
msgstr "흥미롭군요. 도움이 될지, 방해가 될지는 두고 볼 일이겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = d18f1317-5e60-407d-b837-3506ebf4b5bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_LearnedBackstory = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:d18f1317-5e60-407d-b837-3506ebf4b5bb
msgctxt "h5adbc35ega7e6g4c7cg9b02g7e752f987a72"
msgid ""
"You know where you went wrong, Gale. We needn't dwell on that here and now. "
"But even so, you're to be given a chance of redemption."
msgstr ""
"게일 자네도 자신이 무엇을 잘못했는지는 알고 있겠지. 지금은 굳이 그 일을 언급하지 않겠네. 다만 자네에겐 이제 만회의 기회가 주어졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = d198ce14-9a92-41a5-b444-1d471afe2c56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:d198ce14-9a92-41a5-b444-1d471afe2c56
msgctxt "h05dc8f8bg3491g494egb9feg3c4b6675fa5f"
msgid "I don't understand. How so on my behalf?"
msgstr "이해가 안 되는군요. 왜 저를 위해서 그렇게까지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = d357d2fc-9f69-4e84-883c-57aa13f26c78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:d357d2fc-9f69-4e84-883c-57aa13f26c78
msgctxt "h9457f34eg1c2eg43e2g9baag7c7cdd5c4ee0"
msgid ""
"I'm here on behalf of Mystra. The message and the charge I bring you are "
"hers."
msgstr "나는 미스트라님을 대신해서 왔다네. 지금 자네에게 전하는 전언과 임무는 그분이 내리는 것이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = d39bc976-7782-4629-93f2-1db1c67e9b30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:d39bc976-7782-4629-93f2-1db1c67e9b30
msgctxt "h695b95e8g11f5g4fffgb1acg643dcc2e0bea"
msgid "Nor would I expect you to. It is too bleak a task to demand of anyone."
msgstr "나도 네가 그러길 바라지 않아. 그건 누구한테 요구하기에는 너무 냉정한 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = d467f15d-7b92-4f86-9039-6501a821d77e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:d467f15d-7b92-4f86-9039-6501a821d77e
msgctxt "h85f72242g3faag48a4g9e54g9a9eae15d96b"
msgid "It must be a great honour to be so entrusted by your god."
msgstr "자신이 섬기는 신에게 선택받는다는 것은 큰 영광이겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = db3a96de-5581-417b-8dbd-0fb282574cb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:db3a96de-5581-417b-8dbd-0fb282574cb0
msgctxt "h2c02418dgccceg4d9bg8bc1g61ac88fa5c35"
msgid "I am not his keeper, and I do not accept your charge."
msgstr "전 게일의 보호자가 아닙니다. 그리고 그 임무도 받지 않을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = dc90cd19-d8a0-4e21-b707-aedfdb7ba4f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:dc90cd19-d8a0-4e21-b707-aedfdb7ba4f3
msgctxt "h4ba8b633gec93g46ecgbf45ga39f962c815a"
msgid "Farewell, Elminster. I'm glad she chose you."
msgstr "안녕히 가세요, 엘민스터. 그녀가 당신을 보내줘서 기쁘군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = dcc4af4d-4dde-426a-ac48-bdd696d5fee5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:dcc4af4d-4dde-426a-ac48-bdd696d5fee5
msgctxt "h3afe74f5gb3ddg4953gbcb3gdaa941644d33"
msgid "I could debate you on that."
msgstr "글쎄, 꼭 그렇진 않을 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = de27bf5f-2c85-460a-b898-e9a686e07521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:de27bf5f-2c85-460a-b898-e9a686e07521
msgctxt "h3e057162g8e0cg457bg872egd32d19aa05b5"
msgid ""
"They choose the instruments of their will with great precision. Sometimes "
"the single drops we think we are do not realise what waves we are building "
"up to be."
msgstr ""
"신들은 자신의 의지를 행할 도구를 신중히 택한다네. 아무리 우리가 물방울처럼 하찮게 느껴진다 하여도, 단순히 그 한 줌이 거대한 파도로 "
"나아가고 있는 것을 눈치채지 못한 것일 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = de73e714-8c0e-45e0-97ac-88f2ae59640d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_LearnedBackstory = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:de73e714-8c0e-45e0-97ac-88f2ae59640d
msgctxt "ha7515776g65cbg4356g8567geb90ad8a06ff"
msgid "I'm surprised she sent you in the first place after Gale's... debacle."
msgstr "게일이 그런... 사고를 친 후에도 그녀가 당신을 보냈다는 게 놀랍네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = de886ccd-74c2-4d5d-9ca0-1a782c5079a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:de886ccd-74c2-4d5d-9ca0-1a782c5079a3
msgctxt "hc813041fg7905g4334gb88cg0cee9f4f682f"
msgid ""
"Mystra has granted me the power to stop the clock, as it were, on the orb's "
"rush to overpower you. Instead, you will be able to unleash its lethal "
"combustion at will."
msgstr ""
"미스트라께선 내게 자네를 집어삼키려는 그 보주의... '시계'를 멈출 힘을 내려주셨네. 이제 자네는 그 위험한 폭발의 힘을 원하는 때에 "
"발산할 수 있게 될 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = ec4a03b7-755f-4fa7-9bb4-b7aab8b8fa95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:ec4a03b7-755f-4fa7-9bb4-b7aab8b8fa95
msgctxt "h3d82403cg2441g48c6g82eeg79b97eef0d52"
msgid "I'm glad it's not just me."
msgstr "나만 그렇게 생각하는 게 아니라 다행이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = ed76290b-40f0-408c-93ac-54f33a821aa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:ed76290b-40f0-408c-93ac-54f33a821aa2
msgctxt "h78910649gf44fg443ag988dg9252c05c2999"
msgid ""
"Nigh a tenday I've gone without honest fare worthy of the name - drank "
"naught but what the sky entitled my thirst."
msgstr ""
"거의 열흘째 내 명성에 걸맞게 제대로 된 대접 없이 돌아다녔지. 하늘에서 떨어지는 비가 내 갈증을 달래줄 뿐, 그 밖에 아무것도 마시지 "
"못했다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = f142cbdd-6c1d-46e7-bf58-1c210dd94625
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_ElminsterFallbackNight = True
#.      - ORI_Gale_Event_PlayersWithElminsterToCamp = False
#.      - ORI_Gale_Event_ElminsterToCamp = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:f142cbdd-6c1d-46e7-bf58-1c210dd94625
msgctxt "h58ae7edcg7046g4ca0g9fa1g1055e46c8dda"
msgid ""
"Ah, finally they stir. True adventurers get up with the lark, I always say, "
"but if there are larks to be found in these lands, they must fancy "
"themselves akin to nightingales."
msgstr ""
"아, 드디어 일어나는구나. 진정한 모험가는 일찍 일어나는 새와도 같다고 내 늘 말하지만, 아무래도 이곳에 사는 새들은 밤에 벌레를 잡는 "
"모양일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = f303b831-b3bb-47fa-9396-4fec2b68fea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:f303b831-b3bb-47fa-9396-4fec2b68fea6
msgctxt "h20aec304g87ccg43f4ga6c2g97da57b0b47d"
msgid "<i>Elminster.</i>"
msgstr "<i>엘민스터 님.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = f8ea898d-e4cb-4ed3-82a8-af9ef04dbf67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:f8ea898d-e4cb-4ed3-82a8-af9ef04dbf67
msgctxt "h8fc17930gc8cbg45d8gae28ga55384267710"
msgid ""
"Young man, has your sojourn away from Waterdeep washed away your decorum as "
"well as your patience?"
msgstr "젊은 친구, 워터딥을 떠나있는 동안 자네는 참을성은 물론이요 예의마저 사라지고 말았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Player
#. NodeID = fd22b536-0b7d-4cb9-8da0-8b7a11cb8390
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:fd22b536-0b7d-4cb9-8da0-8b7a11cb8390
msgctxt "hafcf38c5g6547g43acgb1cbg2bb735229020"
msgid ""
"You wouldn't happen to know of a cure, would you? Some all-powerful, "
"parasite-withering spell, perhaps?"
msgstr "저기, 혹시 치료법 아는 거 없습니까? 뭔가 엄청 전능하고 강력한 기생충 박멸 주문 같은 거 말이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Weary Traveller
#. NodeID = fe407a19-7d42-4df9-95e1-62a14bf4886d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:fe407a19-7d42-4df9-95e1-62a14bf4886d
msgctxt "h06bac4b4g0b3fg463agb654g1e7a9f884804"
msgid "Farewell, my friend."
msgstr "안녕히, 친구여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom
#. Speaker = Gale
#. NodeID = ff48b35e-9579-4b5c-a08c-177ae6f7b1d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/GLO_Elminster_CFM_GaleCom:ff48b35e-9579-4b5c-a08c-177ae6f7b1d9
msgctxt "hc6fd7d2egd168g4f7fg9956ga0f29682f016"
msgid "Mystra's delicate feet are ill-suited for the hardships of the road."
msgstr "미스트라는 연약한 발을 자갈투성이 길에서 혹사하고 싶지 않은 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance
#. Speaker = Oathbreaker Knight
#. NodeID = 04cf4c16-2cf2-4157-870f-226ab793737a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance:04cf4c16-2cf2-4157-870f-226ab793737a
msgctxt "h1f18f0d4gc927g4737gb604g511bc3d024e3"
msgid "At the close of day, I will be waiting for you."
msgstr "오늘이 끝날 무렵, 너를 기다리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance
#. Speaker = Oathbreaker Knight
#. NodeID = 56a0bb92-b396-7117-6f8f-4a5ef08a7070
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance:56a0bb92-b396-7117-6f8f-4a5ef08a7070
msgctxt "h50f45eb7g2c94g4634gb25bgdf5aeeaf9cb6"
msgid "You have broken your oath, paladin."
msgstr "너는 맹세를 어겼다, 팔라딘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance
#. Speaker = Oathbreaker Knight
#. NodeID = a58f1868-e161-b608-bca4-7d8f345b17c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance:a58f1868-e161-b608-bca4-7d8f345b17c3
msgctxt "h2a3c6b37g27fbg4356ga4cbg3fa9788c002d"
msgid "At the day's end, we must speak again."
msgstr "오늘 하루가 끝나면, 나와 다시 대화해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance
#. Speaker = Narrator
#. NodeID = ba44e865-b798-18c0-bc27-8f415efc9e35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance:ba44e865-b798-18c0-bc27-8f415efc9e35
msgctxt "h6a5f3135g792dg4f69g9af4gdfa5aa4c8c16"
msgid ""
"*A spasms grips your chest. Your strength falters. An emptiness grows within "
"you, paladin. Something has been lost.*"
msgstr "*경련이 가슴을 움켜쥡니다. 힘이 흔들립니다. 팔라딘인 당신의 마음속에서 공허함이 커집니다. 무언가가 사라졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance
#. Speaker = Oathbreaker Knight
#. NodeID = bc9ee116-3111-abdd-8631-65493ece2f64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance:bc9ee116-3111-abdd-8631-65493ece2f64
msgctxt "h05c46e30g3d9ag4ad8g868cg6c4bd9247db0"
msgid "We have much to discuss."
msgstr "우리가 논의할 것이 많다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance
#. Speaker = Narrator
#. NodeID = ce6a0fb3-00bb-bb0c-b4d5-a17db3b125dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/GLO_OathbreakerKnight_FirstAppearance:ce6a0fb3-00bb-bb0c-b4d5-a17db3b125dc
msgctxt "h83738a10g9f49g4bf0g971dg932df5d8fba0"
msgid ""
"*Something shifts within you once more, paladin. You feel an emptiness "
"within you, a void where your purpose used to lie.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty
#. Speaker = Alfira
#. NodeID = 05165c54-3aba-cc6f-bb25-d0a85f9a1bd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DarkUrge_Event_AlfiraJoined = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_DarkUrge_Event_AlfiraHappy(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty:05165c54-3aba-cc6f-bb25-d0a85f9a1bd7
msgctxt "h8e9d685age2bdg4858g8c9bg8b45545d804f"
msgid ""
"I can't wait to hit the road. Where will we go? Neverwinter? Oh! Can we go "
"to Waterdeep?"
msgstr "같이 여행하고 싶어서 못 참겠어요. 어디 갈까요? 네버윈터? 아! 혹시 워터딥도 갈 수 있을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty
#. Speaker = Alfira
#. NodeID = 1f51e7e1-077a-5c23-862a-41e23d8749fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_DarkUrge_Event_AlfiraHappy(1) = True
#.   Global:
#.      - CAMP_DarkUrge_Event_AlfiraJoined = True
#: Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty:1f51e7e1-077a-5c23-862a-41e23d8749fa
msgctxt "h94c66b2ag36cbg4fafg9decgbd3f033b843d"
msgid ""
"We should probably hit the hay, although I don't think I'll sleep a wink. I "
"can't wait to start travelling!"
msgstr "기대돼서 잠이 안 올 것 같긴 한데 그래도 이제 자야겠네요. 얼른 여행 가고 싶어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty
#. Speaker = Alfira
#. NodeID = 787ff45f-529f-4f5a-2004-257543246f25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_DarkUrge_Event_AlfiraUpset(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty:787ff45f-529f-4f5a-2004-257543246f25
msgctxt "he46d9aaag48f9g4858ga58bg41dd1584a4b6"
msgid ""
"The sooner we go to sleep, the sooner I'll get out of your sight. Just... "
"leave me be."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty
#. Speaker = Alfira
#. NodeID = a23a74b8-cdf2-f289-2f59-7f7ff663874f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty:a23a74b8-cdf2-f289-2f59-7f7ff663874f
msgctxt "h78247de5g47f4g491cga023g280acd8ebba5"
msgid ""
"Hah, sorry - I'm getting ahead of myself. Let's take it one note at a time, "
"as my teacher would say."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty
#. Speaker = Alfira
#. NodeID = c3fd0830-99bf-75e0-acc1-8348394dd1ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_DarkUrge_Event_AlfiraHappy(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/DEN_Bard_InParty:c3fd0830-99bf-75e0-acc1-8348394dd1ed
msgctxt "hdb83bb64ga330g4966gabddg5ccd5448a7cd"
msgid ""
"I'm afraid I don't have your stamina - I'll be turning in soon. Thank you "
"again for letting me stay."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp
#. Speaker = Weary Traveller
#. NodeID = 187a1afe-c3b3-4e6b-8b6c-00cb23a74ada
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_A = True
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_B = False
#. SetFlags:
#.   Local:
#.     - 31b9b257-7403-8eca-15fb-458743cebe65_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp:187a1afe-c3b3-4e6b-8b6c-00cb23a74ada
msgctxt "hbaaabaabg5258g4ef7g9e27gce1572fccdf2"
msgid "How will he react? He has a stout heart, but <i>this</i>...?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp
#. Speaker = Weary Traveller
#. NodeID = 8e8ad893-8121-4783-a2a2-04036b6556f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_A = True
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_B = True
#. SetFlags:
#.   Local:
#.     - 31b9b257-7403-8eca-15fb-458743cebe65_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp:8e8ad893-8121-4783-a2a2-04036b6556f4
msgctxt "hfdaed2dfg5b81g4585gbd56gc3275b17c443"
msgid "Perhaps another way will present itself. But perhaps not..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp
#. Speaker = Weary Traveller
#. NodeID = ca6956a4-32a4-4282-9b35-2009586415d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_A = False
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_B = False
#. SetFlags:
#.   Local:
#.     - 31b9b257-7403-8eca-15fb-458743cebe65_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp:ca6956a4-32a4-4282-9b35-2009586415d1
msgctxt "he714b112g57feg487egba48g6d8f633d3a90"
msgid "I can't say I'm relishing this, but it must be done."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp
#. Speaker = Weary Traveller
#. NodeID = d8254d6e-39cc-44c4-b5dc-6c67a9d6b749
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_A = False
#.      - 31b9b257-7403-8eca-15fb-458743cebe65_B = True
#. SetFlags:
#.   Local:
#.     - 31b9b257-7403-8eca-15fb-458743cebe65_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Camp:d8254d6e-39cc-44c4-b5dc-6c67a9d6b749
msgctxt "hc084e8cfg1617g4d5cg916bgbe22d494a5e8"
msgid "I do wish this was over with."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = 0a9a94ed-ce00-eab6-e8ec-1bf0ef841881
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:0a9a94ed-ce00-eab6-e8ec-1bf0ef841881
msgctxt "hdcde3b0dg515ag4660gb0b4g5bd266cdc9d1"
msgid "Another stopgap, then. He deserves better than this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Weary Traveller
#. NodeID = 2d91ce0c-9bb8-496e-955b-18c381aff387
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_A = False
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_B = False
#. SetFlags:
#.   Local:
#.     - f66c8ee0-0b72-05a7-7932-24994b1cc891_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:2d91ce0c-9bb8-496e-955b-18c381aff387
msgctxt "hf3a402b2gd8f6g47c2gad6cg6edff286233d"
msgid "So, Gale has his faithful feline in tow. I am glad."
msgstr "그래, 게일이 그 충성스러운 고양이와 함께 다니는구만. 마음이 놓여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = 2e2b97d9-b0a6-8dd7-9326-71895871b90a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_A = False
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_B = True
#. SetFlags:
#.   Local:
#.     - f66c8ee0-0b72-05a7-7932-24994b1cc891_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:2e2b97d9-b0a6-8dd7-9326-71895871b90a
msgctxt "h57df1011gd77cg4590g8e7cg4772f3ee1a59"
msgid ""
"Heavy is the heart that bears the orb. My friend is well, but for how long?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Weary Traveller
#. NodeID = 5bdf3c4a-0e16-46f5-840b-35e970f3f6c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:5bdf3c4a-0e16-46f5-840b-35e970f3f6c3
msgctxt "h9dffdfb2gc457g4a93gb333g3073605116e2"
msgid "Good."
msgstr "잘됐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = 67b578b2-6b9f-450b-a3c9-5dd60109db48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:67b578b2-6b9f-450b-a3c9-5dd60109db48
msgctxt "hdb409f0eg945eg45e0g8238g630ce63350e5"
msgid "I'd been looking for you myself. You're a very hard man to find."
msgstr "저도 사실 당신을 찾아다녔답니다. 아주 찾기 힘드신 분이더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Weary Traveller
#. NodeID = 7b4ac7ae-a825-4e86-b261-f398b0bc937e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:7b4ac7ae-a825-4e86-b261-f398b0bc937e
msgctxt "h9d148e93g98b4g4555gb8b4g8c4c1ef67352"
msgid "How has he been holding up? "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Weary Traveller
#. NodeID = a66e0385-3563-4f53-8932-671457a7beb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:a66e0385-3563-4f53-8932-671457a7beb0
msgctxt "hda0ea298gd861g4a6ag8807ge4a374d25d5b"
msgid "I am here to... <i>enlighten </i>him."
msgstr "정확히는... <i>계몽시키러</i> 왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = b2be0e5a-7238-4123-b27f-bd6e14a1f6a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:b2be0e5a-7238-4123-b27f-bd6e14a1f6a1
msgctxt "hef12dc50gde61g4d73gb22eg6cd4635cfbb4"
msgid "Of course I do. Better than anyone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Weary Traveller
#. NodeID = b5394ccb-93e3-4580-8f3b-b1ed4c7b8f62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_A = True
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_B = True
#. SetFlags:
#.   Local:
#.     - f66c8ee0-0b72-05a7-7932-24994b1cc891_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:b5394ccb-93e3-4580-8f3b-b1ed4c7b8f62
msgctxt "hd2940929gf6adg407bg9095g94e6dbf61d79"
msgid ""
"There is nothing simple about our friend's predicament. I think you know "
"that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = dd077be8-efa4-4fc1-9750-c9cbb410ac02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:dd077be8-efa4-4fc1-9750-c9cbb410ac02
msgctxt "h3aa39992g433bg4b98ga82dg9dd27239af45"
msgid "No such thing as a simple question with you people, hm?"
msgstr "위자드 분들은 말을 쉽게 하는 법이 없으시군요, 그렇죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Weary Traveller
#. NodeID = ecd58bf9-9201-c68a-db3e-5e68b860fa69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:ecd58bf9-9201-c68a-db3e-5e68b860fa69
msgctxt "h5f33624agf010g4a0bga2b9gbd170958e978"
msgid "In that regard, I can help. For a time, at least."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym
#. Speaker = Tara the Tressym
#. NodeID = f47ec8cf-062d-4436-9306-a91445c76ae7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_A = True
#.      - f66c8ee0-0b72-05a7-7932-24994b1cc891_B = False
#. SetFlags:
#.   Local:
#.     - f66c8ee0-0b72-05a7-7932-24994b1cc891_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_GaleTressym:f47ec8cf-062d-4436-9306-a91445c76ae7
msgctxt "hdaafef31g5c2cg4945g8440g8afb79f6ba35"
msgid "You <i>are </i>here to help him, aren't you?"
msgstr "그분을 도우려고 <i>여기</i>계신거잖습니까, 안그래요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Weary Traveller
#. NodeID = 326d4b0f-e493-4772-8151-c88622586ada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:326d4b0f-e493-4772-8151-c88622586ada
msgctxt "h4429a07cgf321g4f3cg9062gc061ac315baf"
msgid ""
"It is important to cherish every conversation as if it were the last - for "
"it could very well be the last."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Volo
#. NodeID = 0b1d406b-7bde-4c26-896d-d6bda731ee6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:0b1d406b-7bde-4c26-896d-d6bda731ee6b
msgctxt "hd7565703g6f07g430cgb336g006fc8b99884"
msgid "I see. Well luckily I cannot claim to know any such unfortunate."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Weary Traveller
#. NodeID = 42ad72b3-a0a8-4672-ba09-0dfe37dc1ebd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_A = False
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_B = False
#. SetFlags:
#.   Local:
#.     - 1a536e7b-3812-8245-7263-21c2ad3b50ef_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:42ad72b3-a0a8-4672-ba09-0dfe37dc1ebd
msgctxt "hd61d52c7g57c4g4647ga7a1g0898068d6a4e"
msgid "It took some doing, finding you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Weary Traveller
#. NodeID = 1857bf85-61f9-47b9-85fa-b29f86c1c9cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_B = False
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_A = False
#. SetFlags:
#.   Local:
#.     - f2bfa062-4d14-9d5c-f104-79b5a5f91227_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:1857bf85-61f9-47b9-85fa-b29f86c1c9cd
msgctxt "hef997c93gfde3g4e66g9dbeg7e9679fcac16"
msgid "Volo. Still spinning your tall tales, I take it?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Weary Traveller
#. NodeID = 5612a591-b79e-480e-9a13-cd62d8a392dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_A = False
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_B = True
#. SetFlags:
#.   Local:
#.     - 1a536e7b-3812-8245-7263-21c2ad3b50ef_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:5612a591-b79e-480e-9a13-cd62d8a392dd
msgctxt "h87ba8499g2f46g4178gbe79g3754be63a85f"
msgid "I am glad to talk to you again, m'boy. Even under such circumstances."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Volo
#. NodeID = 191efe98-92b8-4cc9-9d71-6cc8ea55c4ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_B = True
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_A = False
#. SetFlags:
#.   Local:
#.     - f2bfa062-4d14-9d5c-f104-79b5a5f91227_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:191efe98-92b8-4cc9-9d71-6cc8ea55c4ec
msgctxt "hc0a4af45g5d56g4ddfgb87cgdfb16973bb1b"
msgid "Preposterous! There's no harm in <i>sharing </i>knowledge, my good man."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Weary Traveller
#. NodeID = 63e64053-d78f-4653-a08b-8f0855660653
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:63e64053-d78f-4653-a08b-8f0855660653
msgctxt "h9d3e7fb4g664eg43begb5b8g3c7714bb4060"
msgid "Have mercy on these old bones, m'boy. A short respite will not harm us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Weary Traveller
#. NodeID = 2310cd4a-d005-4be5-98ef-142c1d116b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:2310cd4a-d005-4be5-98ef-142c1d116b6b
msgctxt "h22ca8077ge918g4a44g9ad5gf712af38cc95"
msgid ""
"Are you quite sure? Perhaps you could try just a little harder to ignore it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Gale
#. NodeID = 73077492-b6cc-49f0-b612-da4a6747d850
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:73077492-b6cc-49f0-b612-da4a6747d850
msgctxt "h02b74019g4918g49d6ga320gcc25786ab0ce"
msgid "Well now you've found me, perhaps you can share your purpose."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Volo
#. NodeID = 33d222f0-0769-41f6-a501-ba4c23728031
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:33d222f0-0769-41f6-a501-ba4c23728031
msgctxt "h802f57b5g00b0g4f6dg89f3g6e0c5c6043b7"
msgid ""
"Why of course, my good man! Storytelling with my particular panache is a "
"calling one cannot ignore."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Weary Traveller
#. NodeID = 8ea34cd1-1b8b-481d-82cd-e116dfed0e52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:8ea34cd1-1b8b-481d-82cd-e116dfed0e52
msgctxt "h551af52egd8b4g45a6g8d37g37714fc25d59"
msgid "Very well. Not everyone finds such matters as fascinating as I do..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Weary Traveller
#. NodeID = 48515515-c5f9-4ed3-b40a-dfb563e70804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:48515515-c5f9-4ed3-b40a-dfb563e70804
msgctxt "h2a1c8c5eg45b7g4abcgbe86g3b3746c60cf5"
msgid ""
"Moisten whatever you like, so long as you do not share dangerous secrets."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Weary Traveller
#. NodeID = 91842d6f-e287-4bdf-959c-c1e9d9faa6d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:91842d6f-e287-4bdf-959c-c1e9d9faa6d2
msgctxt "h39913564gccefg48d0g8dd5g13af0d1d1f91"
msgid ""
"I know what you mean. Trust me - for the moment, all is well. Or at least "
"<i>acceptable</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Weary Traveller
#. NodeID = 505ad2b3-cee5-439c-a4e3-08c5d94e678e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:505ad2b3-cee5-439c-a4e3-08c5d94e678e
msgctxt "h27d983d3gcbacg45fag9558gf1efcdb9db91"
msgid ""
"I suppose I instilled some discipline in your style - a task as unenviable "
"as emptying the sea with a leaking bucket."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Gale
#. NodeID = a59f896a-9674-416a-8f74-ddfbb6e2fd94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:a59f896a-9674-416a-8f74-ddfbb6e2fd94
msgctxt "hfcac765ag4809g4357g9751gb5dfefc8a6bf"
msgid ""
"Please, I do not need to hear of your joint aches and privy sorties again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Volo
#. NodeID = 96ad5448-8651-45f0-8304-945bb3a14604
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:96ad5448-8651-45f0-8304-945bb3a14604
msgctxt "hbfd50fd6g51f5g4dd7g823cgb9262144eefe"
msgid ""
"Well... discretion <i>guides</i> me. But so does my duty to enthral the "
"reader - to swell their hearts and dampen their cheeks!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Weary Traveller
#. NodeID = c1f1dd5a-d39d-4b69-97b1-224361ce16a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_A = True
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_B = True
#. SetFlags:
#.   Local:
#.     - 1a536e7b-3812-8245-7263-21c2ad3b50ef_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:c1f1dd5a-d39d-4b69-97b1-224361ce16a0
msgctxt "ha49dc072g440cg44acgbc0ag617267c54e9d"
msgid "It comes with age. Along with some less-desirable traits..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Weary Traveller
#. NodeID = ae932f04-c2c5-4235-b06a-a18e7bc1dd9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_B = True
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_A = True
#. SetFlags:
#.   Local:
#.     - f2bfa062-4d14-9d5c-f104-79b5a5f91227_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:ae932f04-c2c5-4235-b06a-a18e7bc1dd9d
msgctxt "h52ea7586g0c5cg40e0g8f00g495ecac2aa07"
msgid ""
"Wonderful. And I trust you remain more... <i>discreet </i>about sharing "
"sensitive knowledge?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Gale
#. NodeID = e6725bd1-b077-41da-99a7-936de519ac5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:e6725bd1-b077-41da-99a7-936de519ac5a
msgctxt "h86bebe7dg2aa4g45b9g95a4gab9ab8ce2c98"
msgid "Oh to have but a thimbleful of your confidence at my disposal..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Volo
#. NodeID = b0fc9bba-b2fc-4c65-a823-c3fd1d478b60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:b0fc9bba-b2fc-4c65-a823-c3fd1d478b60
msgctxt "h1418645cg00deg43b5ga491ge87a694ae96f"
msgid "You <i>do </i>have a way with words, my friend."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Gale
#. NodeID = ec3381e1-6500-4b7d-ab1e-2d2dea9e55dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:ec3381e1-6500-4b7d-ab1e-2d2dea9e55dd
msgctxt "h815010b8g88a5g4b9eg808ag30b83634c711"
msgid "As am I."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Weary Traveller
#. NodeID = c323a91d-5129-4d1f-8301-352534d153d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:c323a91d-5129-4d1f-8301-352534d153d9
msgctxt "he018aeb5gf121g47f8gaaddg6b1867e2c946"
msgid ""
"The harm could be great. Few things are more dangerous than a fool who "
"thinks himself enlightened."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale
#. Speaker = Gale
#. NodeID = fb7e9cc0-b46b-4eb7-87e3-c68233d610e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_A = True
#.      - 1a536e7b-3812-8245-7263-21c2ad3b50ef_B = False
#. SetFlags:
#.   Local:
#.     - 1a536e7b-3812-8245-7263-21c2ad3b50ef_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Gale:fb7e9cc0-b46b-4eb7-87e3-c68233d610e7
msgctxt "hba130e10gfe0fg4d61g95e6g70bd4993c9a7"
msgid "You may be proven incorrect - time is not on my side, I fear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo
#. Speaker = Volo
#. NodeID = f8c6e12f-8bb8-4856-b66d-cf2abec3fd6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_B = False
#.      - f2bfa062-4d14-9d5c-f104-79b5a5f91227_A = True
#. SetFlags:
#.   Local:
#.     - f2bfa062-4d14-9d5c-f104-79b5a5f91227_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/GLO_Elminster_AD_Volo:f8c6e12f-8bb8-4856-b66d-cf2abec3fd6e
msgctxt "h9fedc405gc5efg42c3g8326g6ea9e6b5ee3f"
msgid ""
"Oh-ho, you scallawag! Why, your editor's quill made me into the sterling "
"scribe I am today."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02
