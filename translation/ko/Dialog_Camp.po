#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2:f61a3d53-98b9-d51e-e139-3a6e57bbf2a7
msgctxt "h4b0fcfe2gc6bag46cfg9ea6gfdee53f01ae4"
msgid "Let me see, or the leg will fall off and I'll eat it for dinner."
msgstr "한 번 보자, 안 그럼 다리가 떨어져서 내가 저녁 식사로 먹을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Player
#. NodeID = f9d5ff09-04ea-8f22-389f-c4e800731146
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2:f9d5ff09-04ea-8f22-389f-c4e800731146
msgctxt "h9ea2b2c3gdb69g48edgbf40g040c066d9823"
msgid "I can help you. Just stay calm."
msgstr "내가 도와줄게. 진정해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Player
#. NodeID = fa484c7a-e5c8-7d2a-1e43-b7f3765229f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_OwlbearCub_Event_Fight = True
#.     - CAMP_OwlbearCub_State_Friend = False
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2:fa484c7a-e5c8-7d2a-1e43-b7f3765229f6
msgctxt "hbf32e6d6gc9c3g4ef7g943fg7f70bef66a00"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 0104b80b-247b-1f90-ba6f-53c9ac3c12b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:0104b80b-247b-1f90-ba6f-53c9ac3c12b0
msgctxt "h5d1bef35g004bg420ag95b5ge1227ebc17a6"
msgid "What's that?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 0df1584e-1e40-ab73-475b-76eba04ce825
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:0df1584e-1e40-ab73-475b-76eba04ce825
msgctxt "h80473443g6d8ag43a2g8cedg2c000cfe87ce"
msgid ""
"Allow me to be frank - we can't presume we'll get to share another night "
"like this; there's a battle coming. Not everyone is going to make it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 1d8a2dfc-9a80-6412-38d3-a6ae6c8f1d0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:1d8a2dfc-9a80-6412-38d3-a6ae6c8f1d0b
msgctxt "h0592d0a2gcbfcg4664g8cfbg87df60ab1b31"
msgid ""
"A Nightfall ritual - an act of wickedness and decadence in Lady Shar's name?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 1e246e6b-6ef7-f751-c22c-0d4b6d7e3671
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_WasPartneredWithShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:1e246e6b-6ef7-f751-c22c-0d4b6d7e3671
msgctxt "h5c7d4ff0g4738g470dg890eg2f875260d322"
msgid "I thought we were finished, you and I."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 298261e9-7042-94b2-c6fe-2db90e3fe8ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:298261e9-7042-94b2-c6fe-2db90e3fe8ec
msgctxt "heb548490g8384g47a6g8ac1gecbd63d66cdc"
msgid ""
"You expect me to participate in some Sharran ritual? Clearly you don't know "
"me well."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 4272fd9a-e10c-358d-4f31-33638880887c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_CRD_NightfallRomance_Event_SHExplains_UnconventionaRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:4272fd9a-e10c-358d-4f31-33638880887c
msgctxt "hc84bc76bgd797g4387g8499g80a339d0d448"
msgid ""
"Lady Shar demands my heart, and I give it to her freely. But there's more to "
"me than a heart, and I'd like to indulge you. Just this once."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 45d54be1-06a6-210a-2745-0c04abee0ef4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:45d54be1-06a6-210a-2745-0c04abee0ef4
msgctxt "h7dcde0cfg8a4ag4d7egb872g49ba8ce5d7d7"
msgid ""
"We should make an offering to Lady Shar, to seek her blessing and protection "
"against what lies ahead. A Nightfall ritual."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 47cd3372-af0f-f101-7387-8bb24eae5ce1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:47cd3372-af0f-f101-7387-8bb24eae5ce1
msgctxt "hc3f27276g3decg449bg803agbf0903897b21"
msgid "Help me do this. You will not regret it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 4acc91e7-3759-c89a-fbb7-cf84064e4d14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:4acc91e7-3759-c89a-fbb7-cf84064e4d14
msgctxt "hfe5612c9gecc0g42dfgb368g88e2873b3736"
msgid ""
"Not fatalistic - pragmatic. We should do everything we can to tilt the odds "
"in our favour. That's what I wanted to talk to you about."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 4b2b5c6e-4e3c-703a-41c8-4fb7053b5583
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:4b2b5c6e-4e3c-703a-41c8-4fb7053b5583
msgctxt "hb0795fb1g1de3g4b89gb6bag6312d8cee9d2"
msgid ""
"We are finished. But that doesn't mean I don't have uses for you... and "
"perhaps you for me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 4c7b7e0c-7d26-3a11-79a9-e76d1a88d618
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:4c7b7e0c-7d26-3a11-79a9-e76d1a88d618
msgctxt "hf86f551dg8272g44edg9085gabda255eb9e5"
msgid ""
"And my... company. But no matter; there's willing flesh elsewhere. Sleep "
"well, if you can."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 5358b682-38fc-8cb5-1035-07a88f0401ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:5358b682-38fc-8cb5-1035-07a88f0401ad
msgctxt "h39dd4724gbd88g4276g824dg77d18387d21a"
msgid ""
"I'm glad you feel the same. We should do everything we can to tilt the odds "
"in our favour. That's what I wanted to talk to you about."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 583d4e37-4348-f3dd-3471-a28ce49dfb2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:583d4e37-4348-f3dd-3471-a28ce49dfb2d
msgctxt "h37e08211g05eag436eg8e7fg0e8e49b26c6a"
msgid ""
"Lady Shar's followers honour her with an act of wickedness, carried out in "
"her name. Then, they feast, knowing they carry the Nightsinger's blessing "
"anew."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 702e44fd-e5a7-4a5c-878e-07106e85e37f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:702e44fd-e5a7-4a5c-878e-07106e85e37f
msgctxt "heac9fcc3g8cf6g4cadgb4edgae5eeac7c9bf"
msgid "As you wish."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 776247c7-822e-e014-298d-9352691f2859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:776247c7-822e-e014-298d-9352691f2859
msgctxt "hd778cebcg3ff7g4cd5g8249ga930ef0a56e3"
msgid "Precisely. Care to show your devotion? Just say the word."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 898ef2a5-76e1-0f8b-520c-81a9eb822edf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_WasPartneredWithShadowheart(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:898ef2a5-76e1-0f8b-520c-81a9eb822edf
msgctxt "h3624c4d0g504dg4e27ga265g946d106b5b40"
msgid "Why me?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 89ab3950-369f-a07e-3f01-627af2aa8e75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:89ab3950-369f-a07e-3f01-627af2aa8e75
msgctxt "h7e92484cg9469g41bcga10fg096b5c01ba4e"
msgid "I suppose you might be right."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = 8c42a792-93c8-f7c6-e18f-4e2a644f356d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:8c42a792-93c8-f7c6-e18f-4e2a644f356d
msgctxt "h12b6446fg5e0eg4d42ga560gba7d9c3f9331"
msgid ""
"Do I truly need to explain? You made me who I am. Now I'd like to show you "
"the fruits of your labour."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 95faa2a0-2291-fd5b-b148-c06da432a8b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:95faa2a0-2291-fd5b-b148-c06da432a8b5
msgctxt "h004fb92cgef2dg4d26ga14egbb2b3ae6965a"
msgid "Don't be so fatalistic."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 98944a24-fc66-3db1-0877-feaa5dd37696
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:98944a24-fc66-3db1-0877-feaa5dd37696
msgctxt "h4fec6a0cgbdf1g4fbagb709g7616dc01d99b"
msgid ""
"If I don't have much time left I'd rather spend it enjoying myself than "
"praying."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = 99f4239a-54ab-b1fd-9986-587fccd18f4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:99f4239a-54ab-b1fd-9986-587fccd18f4d
msgctxt "h56916ff6g9be5g4c6dgbfcdg18835249c72f"
msgid "Not interested."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = b4d63bf7-6a28-4f49-b889-2b050d59b5ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Shadowheart_Event_NightfallRomanceScene(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:b4d63bf7-6a28-4f49-b889-2b050d59b5ff
msgctxt "h9356c276g28b6g4f32gb441g558e6aabe41d"
msgid ""
"Wait until the others are asleep, then come with me. It might just save your "
"life..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = bb96c9dd-8166-51c9-7981-8c2bd02b6220
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:bb96c9dd-8166-51c9-7981-8c2bd02b6220
msgctxt "ha6c5e59fg0b2bg44f3g83b3gf019eea1cf7b"
msgid ""
"Faith is one thing I have in plentiful supply. In fact, it's what I wanted "
"to talk to you about."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = c166c4fb-a8a9-402b-9536-2f022ddec03b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:c166c4fb-a8a9-402b-9536-2f022ddec03b
msgctxt "h06893360g8015g4ba3g9722g7061389464f0"
msgid ""
"A beautiful night. Not even a hint of moon to sully Lady Shar's dark sky."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = daab21ee-2a7e-abb0-7c0b-83e6d0271a94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:daab21ee-2a7e-abb0-7c0b-83e6d0271a94
msgctxt "h6c14b8e4g52d5g4329gbd9eg67a885b5e264"
msgid ""
"I know you <i>perfectly</i>. You helped usher me into being who I am. "
"Indulge your darker side - with me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = e1805bac-5432-023b-b617-b807a4f6e92e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:e1805bac-5432-023b-b617-b807a4f6e92e
msgctxt "h7b7c920eg7a26g4e32g8644ge729a69401cc"
msgid ""
"We can leave the kneeling and praying to the rest. The Nightsinger prefers a "
"more active form of devotion. An act of wickedness, carried out in her name, "
"followed by a feast."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Player
#. NodeID = f9fdfd6e-8596-0773-8a4e-cbfe4b9c84e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:f9fdfd6e-8596-0773-8a4e-cbfe4b9c84e1
msgctxt "hcab2a3c7gf803g4923g80a6gba3c7842defc"
msgid "We've made it this far. Have a little faith."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance
#. Speaker = Shadowheart
#. NodeID = fc8f1345-d724-10e6-7524-49bb75262d00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_NightfallRomance:fc8f1345-d724-10e6-7524-49bb75262d00
msgctxt "h1322d131g42c6g4541g98ceg89f14f931e67"
msgid ""
"Your loss then. If you're struck down in the battles to come, remember that "
"you refused Lady Shar's shield."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 0620e780-0c97-7b4e-390d-e221f4fe6038
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:0620e780-0c97-7b4e-390d-e221f4fe6038
msgctxt "h9704354cgc9b5g4708g9864g65adc654d2b3"
msgid ""
"This is no cavern - this is true darkness. Perhaps Lady Shar will show you a "
"path to her embrace, if you are worthy."
msgstr "이건 동굴이 아니야. 진정한 어둠이지. 네가 그럴 자격이 있다면, 샤님의 품에 안길 수 있는 길을 보여주실거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 0b257611-d62b-8e04-931a-86aaa86a6ddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:0b257611-d62b-8e04-931a-86aaa86a6ddb
msgctxt "h96eb7373g0236g49fdg9711ga37206d47b88"
msgid ""
"Don't be concerned. Perhaps she'll present you with an opportunity to prove "
"yourself. If I can find myself in her graces, you must have at least an "
"equal chance."
msgstr ""
"걱정하지 마. 어쩌면 그분께서 너에게 자신을 증명할 기회를 주실지도 몰라. 내가 그분의 은총을 얻었다면, 너도 최소한 동등한 기회를 가질 "
"수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = 0ba6c982-6ae2-2797-ab0d-f7fd5f4eb222
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:0ba6c982-6ae2-2797-ab0d-f7fd5f4eb222
msgctxt "hea223ad2g065eg4776ga0acgc40a44322c23"
msgid "Why you? I honour the Dark Lady, but the shadows do not spare me."
msgstr "왜 너지? 나는 어둠의 여신을 존경하지만, 그림자는 내게 자비롭지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 0d868624-d04d-491d-01a2-658b46d007a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:0d868624-d04d-491d-01a2-658b46d007a7
msgctxt "h6821e36egdeb3g4360gba42g9fffe1571b14"
msgid "She loves me. She must do."
msgstr "날 사랑하셔. 틀림없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 10dc9158-5850-7f8b-b39a-8a6512c6f2ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:10dc9158-5850-7f8b-b39a-8a6512c6f2ed
msgctxt "he8b1cc94g0c03g412fgae37gfb1fc579a076"
msgid ""
"This must mean <i>she </i>is protecting me - she favours me... and you don't "
"even know what I mean, do you? Time to come clean I suppose."
msgstr ""
"이건 분명 <i>그분</i>께서 지켜 주고 있다는 징조야. 날 총애하시는 게 틀림없어... 뭐가 어떻게 된 건지 모르겠다는 표정이네? "
"이제 진실을 밝혀도 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = 19d801af-114f-c70b-c0dc-cf156c907789
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:19d801af-114f-c70b-c0dc-cf156c907789
msgctxt "h72a433fbg2d43g4287gaeb1gc7c3a69983d4"
msgid "So what does all this mean?"
msgstr "그래서 이게 다 뭘 의미하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = 2e0e1908-3bd6-fb4e-bb02-ac671834c408
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - Shadowheart_InParty_Event_LearnedSharWorshipperAfterCurse(1) = True
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:2e0e1908-3bd6-fb4e-bb02-ac671834c408
msgctxt "hf10df44agee33g491cg9b3dg8fab3ec3a4c5"
msgid ""
"You worship the Dark Lady? So do I - you could have confided in me, sister."
msgstr "어둠의 여신을 섬긴다고? 나도 그래. 나한테 비밀을 털어놓을 수도 있었어, 자매여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = 2e0e1908-3bd6-fb4e-bb02-ac671834c408
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - Shadowheart_InParty_Event_LearnedSharWorshipperAfterCurse(1) = True
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#. TagRule: SELUNE
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:2e0e1908-3bd6-fb4e-bb02-ac671834c408
msgctxt "h4155016dg04acg4ed3gbe1egf1ec8c71ab8d"
msgid "A Shar worshipper. I really should have guessed."
msgstr "샤 숭배자라. 진작 알아봤어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = 2e0e1908-3bd6-fb4e-bb02-ac671834c408
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - Shadowheart_InParty_Event_LearnedSharWorshipperAfterCurse(1) = True
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:2e0e1908-3bd6-fb4e-bb02-ac671834c408
msgctxt "h72ae5a84gf4a3g4924g9be7gba0780487a61"
msgid "You worship Shar? Why have you been keeping this from me?"
msgstr "샤를 숭배하는 거야? 왜 나한테 숨기고 있었던 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 5428c839-c1ab-5efc-9b51-739f2829618a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:5428c839-c1ab-5efc-9b51-739f2829618a
msgctxt "h0976190eg8f61g4a1agae95g4f05b1757c60"
msgid ""
"Lady Shar wouldn't bless me like this for no reason - there must be "
"something she wants of me."
msgstr "아무 이유 없이 이러실 리 없어. 내게 바라시는 뭔가가 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 639f1e39-8f72-1a36-1f4e-309113fded71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_WoundSuspicion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:639f1e39-8f72-1a36-1f4e-309113fded71
msgctxt "h1f37d7e1g405fg4e41g8637g7cced79b18d6"
msgid ""
"This isn't the first sign we've come across of a Sharran presence. I'm not "
"sure I can keep ignoring them."
msgstr "샤님의 존재감을 알아차리게 된게 이번이 처음이 아니야. 계속 무시할 수 있을지는 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = 6ad25fd1-be15-83b8-199f-e4beeb74c1fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:6ad25fd1-be15-83b8-199f-e4beeb74c1fb
msgctxt "h973d954fg5d20g4b7dg92dag0bd29577135c"
msgid "But what about me?"
msgstr "하지만 나는?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 761d53eb-36e3-365f-4ba9-103487105f7d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:761d53eb-36e3-365f-4ba9-103487105f7d
msgctxt "h275eb651g14fbg4bafga121g0c09026c2fc4"
msgid ""
"I suspected that might have been the case, but there was no harm in being "
"cautious. And besides, now you know"
msgstr "그럴지도 모른다고 생각했지만, 조심하는 게 나쁠 건 없었어. 게다가, 이제 알게 됐잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 761d53eb-36e3-365f-4ba9-103487105f7d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: SELUNE
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:761d53eb-36e3-365f-4ba9-103487105f7d
msgctxt "h983bc9ecg4dc2g431ag8cf9g9be03e5b58e7"
msgid ""
"Yes, you probably should have. Perhaps your moonwitch's guidance isn't as "
"revealing as you believe it to be."
msgstr "그래, 알아봤어야 했겠지. 아마도 네 달마녀의 인도가 네가 생각하는 만큼 명확하지 않은 것일지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 761d53eb-36e3-365f-4ba9-103487105f7d
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:761d53eb-36e3-365f-4ba9-103487105f7d
msgctxt "h7d495706g15a1g40abg9aeeg93ebe3415092"
msgid "Why? Safety, discretion, to keep us focused... need I go on?"
msgstr "왜냐고? 안전함, 신중함, 우리 문제에 집중하기... 더 설명할 필요가 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 7df6abef-d284-5655-f8e8-2135aa375324
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:7df6abef-d284-5655-f8e8-2135aa375324
msgctxt "hc8b03177g57b0g4a2ega8e9g723f3f8f825f"
msgid ""
"Carried away? Hardly - the proof is right there. Just be grateful someone "
"can handle this place."
msgstr "흥분했다고? 전혀. 증거는 바로 여기 있는 걸. 누군가 이 장소를 통제할 수 있음에 감사하도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 7e4651e4-6f43-4ab4-9123-66417b2cccf5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - Shadowheart_InParty_DiscussedShadowCurse(1) = True
#.   Global:
#.     - ORI_Shadowheart_Knows_CurseResistant = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:7e4651e4-6f43-4ab4-9123-66417b2cccf5
msgctxt "hab9b152dg6269g4949g843bgba2bce251cd7"
msgid ""
"This place... these shadows. I don't seem to be affected. Not as badly, "
"anyway."
msgstr "이 장소... 이 그림자. 난 영향을 받지 않는 것 같아. 어쨌든, 심할 정돈 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 83e600bf-1ac8-1505-e663-01229059cbbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:83e600bf-1ac8-1505-e663-01229059cbbe
msgctxt "h1dc3c4a0g6457g48b4gafb4g59d56b6d657e"
msgid ""
"And this means I must have her blessing. Lady Shar is protecting me where "
"others are left to face her wrath."
msgstr "이건 내가 그분의 축복을 받았단 의미야. 다른 이들이 그분의 분노를 마주하는 와중에 샤 여신님은 날 지켜주고 계셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 8ab5dbbc-0247-1e5a-1fa7-7000bf355ad3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:8ab5dbbc-0247-1e5a-1fa7-7000bf355ad3
msgctxt "h57a426a3g4cecg41e4g8571gdd01eafc2e45"
msgid ""
"In any case, we can talk about it later. It's the protection I have that "
"matters right now."
msgstr "어쨌든, 나중에 얘기하자. 지금 당장 중요한 건 내가 보호받는다는 사실이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 91cc4cf8-3a97-73c2-541c-647fc28c95b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:91cc4cf8-3a97-73c2-541c-647fc28c95b3
msgctxt "hc827aea7g711bg48b8g8c01gb86b5da3d392"
msgid ""
"Perhaps I shouldn't put it to the test, but compared to everyone else, I "
"feel fine. Better than fine."
msgstr "테스트해 보는 건 좋지 않을 것 같지만, 다른 사람들과 비교하면, 괜찮은 것 같아. 괜찮은 수준 이상이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = 9f57d6c8-c96b-6bf4-24b1-baabfea554fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:9f57d6c8-c96b-6bf4-24b1-baabfea554fa
msgctxt "h8b542ac8g0b63g4454g99f3g28eb56703be2"
msgid ""
"The darkness is the truth, Selûnite. In the end, there will only be endless "
"black, and those that Lady Shar has embraced."
msgstr "어둠은 진실이야, 셀루네 신도. 결국에는 끝없는 어둠과, 샤님이 품은 자들만이 남게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = a722a8e2-65c1-1cff-eacd-b94c8c81499f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:a722a8e2-65c1-1cff-eacd-b94c8c81499f
msgctxt "h7960268fg9e6cg449egaa98g22677c1a7c78"
msgid ""
"You're resourceful - you'll find a way. Don't give me that look. It's a good "
"thing that I'm resistant to the shadows - this way I can help you."
msgstr "넌 순발력이 있으니 잘 헤쳐 나가겠지. 왜 그런 눈으로 쳐다봐? 나까지 그림자에 시달리면 누가 너희를 돕겠니? 좋은 일이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = ab60f300-a753-e8bf-3c80-8423d52ecc0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:ab60f300-a753-e8bf-3c80-8423d52ecc0d
msgctxt "h8a3410e5g7fceg4f31gb545gcf39983c782f"
msgid ""
"Your mistress rewards you with survival against her own corrupt power? "
"That's not love."
msgstr "너의 여신 스스로가 만든 부정한 힘에 맞서 살아남는 은혜를 줬다고? 그건 사랑이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = acd06e18-57de-bbb1-a675-af093b39a022
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:acd06e18-57de-bbb1-a675-af093b39a022
msgctxt "h9d02fbf7g3f3fg487aga38egf5411bf4555c"
msgid "First time I've been out of my element in the dark."
msgstr "내가 어둠 속에서 불편함을 느낀 건 처음이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = b31e9993-ef0b-7196-502b-eede983a45fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - Shadowheart_InParty_Event_LearnedSharWorshipperAfterCurse(1) = True
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:b31e9993-ef0b-7196-502b-eede983a45fc
msgctxt "h375d651fga12dg4169g999fg72e2e20ee6af"
msgid ""
"I worship Shar, the Dark Lady, Mistress of the Night. Though honestly I'm "
"surprised you didn't figure it out by yourself already..."
msgstr "난 샤님을 섬겨. 어둠의 여신이자 밤의 여주인이시지. 솔직히 아직도 네가 알아채지 못한 게 놀라울 지경이네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = c7bef839-6c57-d9e7-7ccb-02672572c4a6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_BecomeJusticiar = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:c7bef839-6c57-d9e7-7ccb-02672572c4a6
msgctxt "h112ee7e4g8db3g4fa5ga641g529553372c21"
msgid ""
"I need to watch for any place dedicated to Lady Shar. A temple, perhaps. I "
"need to know if there's more to this."
msgstr "샤님을 섬기는 곳이 있는지 잘 살펴봐야겠어. 있다면 사원이겠지. 뭔가 더 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = cf40e3b0-55e0-d237-62a5-cd609a67da03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:cf40e3b0-55e0-d237-62a5-cd609a67da03
msgctxt "h9e11ffdbgc6a3g47feg9878g48afdda991f4"
msgid ""
"Do you know what this means? I must be blessed. Lady Shar is protecting me "
"where others are left to face her wrath."
msgstr "이건 무슨 의미일까? 축복받은 거야. 이곳에 샤님의 노여움이 가득한데도, 나만은 지켜주고 계셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = e602a4c8-0c74-ddcc-ab02-2bd7ce2af404
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_JusticiarDream = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_BecomeJusticiar = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:e602a4c8-0c74-ddcc-ab02-2bd7ce2af404
msgctxt "hbd025406gf9e4g4f5bgb304gc7da89ea11d1"
msgid ""
"Those signs we found, about Dark Justiciars... perhaps they were no "
"coincidence. In either case, I need to watch for any place dedicated to Lady "
"Shar. A temple, perhaps."
msgstr ""
"다크 저스티시어의 징표를 발견한 것은… 우연이 아닐지도 몰라. 아무튼, 샤님을 섬기는 곳이 있는지 잘 살펴야겠어. 있다면 사원이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Player
#. NodeID = eb056845-15e0-200d-0b33-e0cd0cdfc94a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:eb056845-15e0-200d-0b33-e0cd0cdfc94a
msgctxt "h936b5de9g17d5g4e9fga615g1390f673e674"
msgid "Don't get carried away - this could be something else."
msgstr "너무 흥분하지 마. 다른 것일 수도 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = eb071f60-0912-689e-ccdb-222f8ba1f599
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:eb071f60-0912-689e-ccdb-222f8ba1f599
msgctxt "ha52cf251g69b9g4a43gb245ga65916e1cae7"
msgid ""
"Cling to your torches and memories of the sun if you like - see how long you "
"last without me."
msgstr "원한다면 횃불과 태양에 대한 기억에 집착해 봐. 나 없이 얼마나 오래 버틸지 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = ee80754b-f8e2-0138-5dc8-bb37d98f84ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:ee80754b-f8e2-0138-5dc8-bb37d98f84ee
msgctxt "h40165451gb8a6g497ag9fecg27af72f7f890"
msgid ""
"Have you ever heard of the Dark Justiciars? They were Lady Shar's most elite "
"warriors. I can't explain why, but something about this reminds me of them."
msgstr "다크 저스티시어에 대해서 들어본 적 있어? 샤님의 최정예 전사들이었지. 설명할 순 없지만, 이걸 보면 그들을 떠올리게 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = f2e12e24-a86d-0aa5-f159-71ed938d236e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:f2e12e24-a86d-0aa5-f159-71ed938d236e
msgctxt "h48c81a8fg76ebg47e2g8428g807f6808d8f2"
msgid ""
"I... I don't know. I'm sorry. It's not for me to guess what value Lady Shar "
"places on each servant."
msgstr "나... 나도 모르겠어. 미안해. 샤 여신께서 종복마다 어떤 가치를 부여하시는지는 내가 알 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse
#. Speaker = Shadowheart
#. NodeID = faec6be7-bf03-15c2-7569-a05a66f8e2d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_BecomeJusticiar = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_ShadowCurse:faec6be7-bf03-15c2-7569-a05a66f8e2d3
msgctxt "hd14ac7d3gfa01g44e9gb412g0804ffc0a58a"
msgid ""
"The Shadowfell, her domain, has power here. Whatever the Dark Lady needs of "
"me, I'll wager the answer lies wherever her power is strongest. I need to "
"find that place, and see what awaits me."
msgstr ""
"어둠의 여신의 영역인 섀도펠이 이곳에서 힘을 발휘하고 있어. 어둠의 여신이 내게서 무엇을 원하는지, 그녀의 힘이 가장 강한 곳에서 답을 "
"찾아야겠어. 그곳을 찾아서, 내가 마주하게 될 것이 무엇인지를 알아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 06dbf995-9dd2-cd29-4705-9ec4ff39968e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:06dbf995-9dd2-cd29-4705-9ec4ff39968e
msgctxt "h4969f7e4g0d2bg449fgb0aag35c54bbc17f5"
msgid "Honing skills? What do you mean?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 0844f96d-5280-ab58-2299-51bd2e0367e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:0844f96d-5280-ab58-2299-51bd2e0367e9
msgctxt "h6d983bfcgbb87g431bgb946g924671f44241"
msgid ""
"I remember plenty - just not everything. I might not recall everything from "
"my past, but I know my name. I can still walk and talk. I know words of "
"devotion to Lady Shar and where to strike a leg in order to sever the main "
"artery."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 08e57bf7-2924-02ce-5a66-81b41b5bff2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:08e57bf7-2924-02ce-5a66-81b41b5bff2b
msgctxt "had60c5eegcd40g45d5ga5fagd7afc188c576"
msgid ""
"I don't know what to say... we're already together as much as Lady Shar "
"allows. Is that not enough for you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 13e9a065-fd9f-5e9e-9719-26798e2f35cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:13e9a065-fd9f-5e9e-9719-26798e2f35cb
msgctxt "h3a09b24fg0523g4d44gb974g457814640fc8"
msgid "Don't you? It might be more interesting than you realise..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 180cd8c8-e9cc-2aaf-23ff-e0555bef2cff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:180cd8c8-e9cc-2aaf-23ff-e0555bef2cff
msgctxt "h4ade4d37g7332g4112g8b19ga0cdb8b19778"
msgid ""
"And making a lover wait...? Well, there's few finer torments, if you know "
"what you're doing..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 1c9dd428-5f30-2ef9-30d8-a3bb58a5f293
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:1c9dd428-5f30-2ef9-30d8-a3bb58a5f293
msgctxt "h3fe8f895geca6g4da4gae1cgeaa948690a75"
msgid "I know you do... but I'm not going to let you. Not just yet..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 2a3f8427-85ec-3d36-85aa-d7e737cdaf4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:2a3f8427-85ec-3d36-85aa-d7e737cdaf4c
msgctxt "ha9fb117eg5f2bg4b3fgbe1cg4ed8349719f2"
msgid ""
"As you mentioned Shar... is she truly going to prevent us from being "
"together?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 2bfa97b6-ad76-b9f5-c6df-1473a1f662ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:2bfa97b6-ad76-b9f5-c6df-1473a1f662ac
msgctxt "h80df8364g70cbg48ccg9d7cg8f3c24665477"
msgid "Is this where you tell me all about your former flames?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 351477dd-01fe-fe61-e31a-823071748e20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:351477dd-01fe-fe61-e31a-823071748e20
msgctxt "h869620f2g0bd9g487bga75bge396307663b6"
msgid ""
"In all seriousness, I want to talk about us. Help me understand exactly what "
"you and I have - and what we don't."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 3a85b78f-b3b0-fc79-497b-25254c0764a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:3a85b78f-b3b0-fc79-497b-25254c0764a1
msgctxt "h90054a80ged41g47e2ga465g318bae12691b"
msgid ""
"Don't worry. Even if I could remember them, none could withstand comparison "
"to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 3b9ad538-ac6a-a211-14aa-1918a1f33695
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:3b9ad538-ac6a-a211-14aa-1918a1f33695
msgctxt "h173a4767gc369g4478gac8bgc08ec9043954"
msgid "I think I understand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 3be96453-5c91-936e-56f3-ccbeed84ef82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:3be96453-5c91-936e-56f3-ccbeed84ef82
msgctxt "hb76d2631g8c2bg492bga329g3f1c382a5f5b"
msgid "Pity."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 4c709293-6d26-ac08-0855-ace3cb34d6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:4c709293-6d26-ac08-0855-ace3cb34d6ea
msgctxt "h52504f5bgc157g4705gbdc3gf4afc779a0c9"
msgid "I don't know. What do we even have?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 61550509-9b7a-0e11-0bc0-b980f6bd12ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:61550509-9b7a-0e11-0bc0-b980f6bd12ab
msgctxt "h44169a45g65a3g4499g9777g7af8250600a9"
msgid ""
"It's only a half-measure if you don't allow yourself to consider it "
"otherwise."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 6983ddc7-d346-6ad0-b410-a550639357c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:6983ddc7-d346-6ad0-b410-a550639357c9
msgctxt "h2b0f76e6gb4fdg4692ga689g9be5bfed7516"
msgid ""
"About Shar... she isn't <i>truly </i>going to prevent us from being "
"together, is she?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 6f000c7a-6227-33b6-15d7-4b7a47a529ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:6f000c7a-6227-33b6-15d7-4b7a47a529ce
msgctxt "h1931af62ge4dbg46f9g989ag8db41095bf95"
msgid "Perhaps not. This feels like a half-measure."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 7835f487-a8d2-100d-3121-3684b58fc1d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:7835f487-a8d2-100d-3121-3684b58fc1d8
msgctxt "h356f418fgf707g447ag90afgf0466448b038"
msgid ""
"It can be difficult to explain, if you don't worship the Nightsinger "
"yourself... but I'll try."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 834264ea-d86e-af7a-7f2b-b32cf7811e57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:834264ea-d86e-af7a-7f2b-b32cf7811e57
msgctxt "h67bca919gad31g41e7gbff2g97b516374d15"
msgid ""
"Imagine how much of a chore I'd be to have around if I truly remembered "
"nothing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 853c6198-654f-5dda-a6aa-632eeba33534
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:853c6198-654f-5dda-a6aa-632eeba33534
msgctxt "hb659873egdf7fg4e26ga232gd70e8ed9e0bc"
msgid ""
"Lady Shar's initiates... we weren't supposed to have relationships. Or "
"flings. Not even stray trysts. And yet... we found a way."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 85b94e27-a4db-7206-20e4-49dad57190f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:85b94e27-a4db-7206-20e4-49dad57190f8
msgctxt "he30c31c4g895cg45a8ga153gd271354cef59"
msgid "Don't worry - I won't paw at you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 88166078-e59a-aa63-5c66-3149c747080a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:88166078-e59a-aa63-5c66-3149c747080a
msgctxt "hd8708ec0gba88g4b33gab18g8d1f5cc81bd3"
msgid ""
"You can - if you understand how to reconcile certain... <i>eccentricities </"
"i>in our relationship."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = 8a365a1d-3d00-b0e2-216b-92cc5e08b7c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:8a365a1d-3d00-b0e2-216b-92cc5e08b7c7
msgctxt "h5dc8ca8eg31aeg4b3bgad09gcaa669bd4113"
msgid "I can be very discreet. Shar won't know a thing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 8d583dde-d287-bed8-7921-098323aa76a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:8d583dde-d287-bed8-7921-098323aa76a5
msgctxt "hbca68d43g1e3ag4793gb9efg02723d5bd599"
msgid ""
"What's that look you're giving me? I feel like a mouse cornered by a cat."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 96dd7960-31c3-bbeb-58ad-4da2ecd47d36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:96dd7960-31c3-bbeb-58ad-4da2ecd47d36
msgctxt "h264d6df8gbdd4g41e2g9c5dgdc5a2e629e32"
msgid ""
"As long as my actions can be thought of as honouring Shar, or honing skills "
"in her service... there is a great deal of flexibility to be had."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = 9d85a613-6052-ab0f-2b14-a27c7861b857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:9d85a613-6052-ab0f-2b14-a27c7861b857
msgctxt "h24ab8876ge402g429agb1f7ge734ef634735"
msgid ""
"But you need to understand the limitations. I can't truly love you. Not like "
"most define it. I'll always have to keep a place for Lady Shar."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = a2e8c303-14e0-7d31-23e8-90586f3f0b37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:a2e8c303-14e0-7d31-23e8-90586f3f0b37
msgctxt "h146ea09agaa45g46b0g94bfgdeb00ed2b93c"
msgid "How?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = a9cbd450-ca69-2fa7-52d6-acda9f8f7998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:a9cbd450-ca69-2fa7-52d6-acda9f8f7998
msgctxt "hbfb87ce2gedd3g4c9fg8d71g764e86bf3312"
msgid "I really want to kiss you right now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = b0e4f7d6-cb17-a12f-5ae9-b8101514e548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:b0e4f7d6-cb17-a12f-5ae9-b8101514e548
msgctxt "ha13300d5g7b17g4a04g9085gc58e8909ebfc"
msgid "Good. Then hopefully you'll understand exactly what I mean..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = b42dfcdf-8f9a-d8fa-2ad9-ffbd6d56479e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:b42dfcdf-8f9a-d8fa-2ad9-ffbd6d56479e
msgctxt "h4a1edd9ag251ag4089g9d6cge2eede22e1b4"
msgid ""
"You and me... it's an odd sort of love that we share. Help me understand it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = b451b0ee-17bb-837c-b925-e5916baff0dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:b451b0ee-17bb-837c-b925-e5916baff0dc
msgctxt "h8bd976dbgabb6g4a2bga6e7g70948e17ac61"
msgid "I don't want to feel like some teenager, sneaking around."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = be3f18d2-04f7-2b1c-8da2-2222ffd65121
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:be3f18d2-04f7-2b1c-8da2-2222ffd65121
msgctxt "hb3fd7d74gccf8g4046g9817g08eb029f6804"
msgid "I'll give you all that I can. Just don't call it love."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = c93932ca-a287-07f6-a2c9-2cc22561f68c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:c93932ca-a287-07f6-a2c9-2cc22561f68c
msgctxt "h980c9c75g1c1ag4d32gbad1g1d93c109a5b1"
msgid "What's the catch?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = cc159965-67b7-7e42-79ff-f6a0e7cc0119
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:cc159965-67b7-7e42-79ff-f6a0e7cc0119
msgctxt "ha6d549a4g8817g4d10gb7a4g4a6ee5955c3a"
msgid ""
"The catch is this: I can't truly love you. Not like most define it. I'll "
"always have to keep a place for Lady Shar."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = cdbabd60-bbd2-12cd-da08-58a8af9f3cab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:cdbabd60-bbd2-12cd-da08-58a8af9f3cab
msgctxt "h96792c25g916eg41eagb0abg0bd0d52b4958"
msgid ""
"Perhaps you do, but let's leave no doubt - I can't truly love you. Not like "
"most define it. I'll always have to keep a place for Lady Shar."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = d3c96a7f-7b69-67c4-5fce-42f6f14229f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:d3c96a7f-7b69-67c4-5fce-42f6f14229f6
msgctxt "h89fa21e9gea7dg4b27gbfb6g73551e0cb3df"
msgid ""
"You can frame many acts as service to the Dark Lady, if you put your mind to "
"it. Seduction can be a worthy form of subterfuge. A snatched moment can "
"practise the art of stealth. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = d3ef92d0-cc4e-f58b-ba2c-9d640836b73d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:d3ef92d0-cc4e-f58b-ba2c-9d640836b73d
msgctxt "h9c1e4e5dgbcfcg4b78ga5fcgb0ed35be7976"
msgid ""
"But you're clever, willing, and flexible... you needn't feel left wanting."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = e1507a63-6d87-01ff-640e-aae27a4b2aa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:e1507a63-6d87-01ff-640e-aae27a4b2aa7
msgctxt "hf09ce023g9857g4cd7gb590gf58767b213ca"
msgid ""
"Lady Shar respects cunning. And that's exactly what you and I will need to "
"demonstrate, if you want this to continue."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = e508a75f-d952-0272-e174-9c8fb52f102e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:e508a75f-d952-0272-e174-9c8fb52f102e
msgctxt "h2176a65agb9b1g478egbe87g06da7244a223"
msgid "You remember all of this?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = e6fb0dec-e0b6-9b5f-96d6-6f81cf8822b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:e6fb0dec-e0b6-9b5f-96d6-6f81cf8822b0
msgctxt "he9f9208ag6d5fg4d8bgbd84g5892cd1dba44"
msgid "<i>Few finer torments.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = e754cb8f-c751-5971-ac85-cd9b5a6b9215
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:e754cb8f-c751-5971-ac85-cd9b5a6b9215
msgctxt "h7ac28425ga9a4g4beag9ed3gcb2d82544e9d"
msgid ""
"Rules are perhaps not always meant to be broken, but they are always "
"intended to be <i>bent</i>. That kiss we shared wasn't my first, you know. "
"Far from it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Player
#. NodeID = e7d0ec72-e337-e924-0914-61f60ebed169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:e7d0ec72-e337-e924-0914-61f60ebed169
msgctxt "h640a2c82g9ba6g42cfgabbfgc3521a32557d"
msgid "If I can be with you, it is."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = e98275c8-2bbf-4b09-88ce-87ccece186a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:e98275c8-2bbf-4b09-88ce-87ccece186a4
msgctxt "h6df7d349gb7afg494fg8096g407170de4fc7"
msgid "Lady Shar's blessings be upon you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance
#. Speaker = Shadowheart
#. NodeID = ef444160-8800-adea-38ba-b86353a2e548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharRomance:ef444160-8800-adea-38ba-b86353a2e548
msgctxt "h53e3ea36g6641g43c3g9303gb9ab1b69a4d5"
msgid ""
"Well... let's just say I can play the innocent when needed, have a lighter "
"touch than you might expect, and can untie many knots with just my mouth. "
"Practical skills, learned in service of Lady Shar."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 0ae96d3a-27b0-2fa4-42cd-5a987b18836b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:0ae96d3a-27b0-2fa4-42cd-5a987b18836b
msgctxt "h3e7a2ab7g678ag4fd6g89adg6e808c331498"
msgid ""
"Then sounds like I have everything I need - more of life than I'd ever "
"imagined possible, without Shar."
msgstr "그렇다면 더 이상 바랄 게 없겠네. 샤에게서 벗어난 삶이 이렇게나 풍족할 줄은 몰랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 17339d7c-f0fd-69f3-fa66-08da3592a85c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:17339d7c-f0fd-69f3-fa66-08da3592a85c
msgctxt "h6f355327gfd8ag4ba3g8aa5g024624327c2f"
msgid ""
"I want to grow flowers. I want to be surrounded by colours, every day. I'm "
"tired of darkness."
msgstr "꽃을 가꾸면서 하루하루를 다양한 색채들 사이에서 보내고 싶어. 어둠은 이제 질색이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 245d5163-4cd6-0528-9a21-0a0916248b66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:245d5163-4cd6-0528-9a21-0a0916248b66
msgctxt "h83f5b826g1c5eg4df2gb30cg8dc5f0e90b8b"
msgid "Fair. What else do you have in mind?"
msgstr "일리 있네. 또 다른 계획은 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 26d82675-85f4-6600-5bd1-0f4b01565e53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_CRD_SharedFuture_State_PlayerAsksAboutThemselves(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:26d82675-85f4-6600-5bd1-0f4b01565e53
msgctxt "h38f07b1bg4ea6g445fg9ab5g27a2cb3f1398"
msgid ""
"What more could I need? If I had all that, and I had you... that's more of a "
"life that I ever dared to dream of."
msgstr "더 이상 바랄 게 있을까? 그 모든 것과 너만 있다면... 내가 바라던 삶 그 이상일 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 2f6078cc-d18b-0fda-a8e6-aa139e9ffdd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:2f6078cc-d18b-0fda-a8e6-aa139e9ffdd0
msgctxt "ha2c4633fg4d0dg4cb4g941agba1b7b3dde3d"
msgid "Anything else?"
msgstr "다른 건 더 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 35486be6-213a-0788-e6b8-ba52db67ed9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:35486be6-213a-0788-e6b8-ba52db67ed9b
msgctxt "hd9337786g03a2g4eeeg9efbg6b083b23b624"
msgid ""
"I've never been able to write my own future. I wouldn't even know where to "
"begin."
msgstr "내 손으로 직접 미래를 그려 본 적이 없거든. 어디서부터 시작해야 좋을지 모르겠어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 3871bc6f-eaef-2811-d6b7-e728011cbf51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:3871bc6f-eaef-2811-d6b7-e728011cbf51
msgctxt "h5582523bg80b6g4d31gb4dag8491b4fccd66"
msgid ""
"I was going to save the best until last, but to put your mind at ease - yes. "
"I want to share everything that lies ahead of me with you. If you're "
"willing, of course."
msgstr ""
"원래는 마지막까지 아껴 두려고 했지만, 이걸로 네 마음이 놓인다면... 그래, 내 앞날을 너와 함께하고 싶어. 물론, 너만 괜찮다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 3d2434b6-fe62-a30b-a8a1-496118031038
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:3d2434b6-fe62-a30b-a8a1-496118031038
msgctxt "h79515426g7c33g41cagb140g7d4888f1c5a8"
msgid ""
"That's not even all - there's the githyanki to consider, whatever Raphael is "
"cooking up, the refugee crisis..."
msgstr "어디 그뿐이겠어. 프리즘 안의 기스양키 문제도 해결해야 하고, 라파엘의 속셈, 난민 사태까지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 4225108f-c7ab-bfb1-5336-ce9a46c185d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:4225108f-c7ab-bfb1-5336-ce9a46c185d9
msgctxt "h92b4465fge620g411cgbee6g7e6f677b6ff3"
msgid ""
"I don't think it's what happens if we fail that concerns me - we'll be "
"beyond our worries at that point. I think what bothers me is what happens if "
"we succeed..."
msgstr ""
"우리가 실패했을 때를 걱정하는 게 아니야. 그땐 걱정할 겨를도 없을 테니까. 걱정되는 건 도리어 우리가 성공하고 난 뒤인 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 4a4a0a70-610d-c5db-5df9-c373cc64d8a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:4a4a0a70-610d-c5db-5df9-c373cc64d8a6
msgctxt "h349c874egc6b9g4205g91d2ga29f4635da87"
msgid ""
"Well, we've plenty to be anxious about. The tadpoles, the armies of the "
"Absolute..."
msgstr "걱정거리가 많긴 하지. 올챙이들에, 절대자의 군대까지 있으니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 508ee510-38aa-4805-0e10-725be0cbf639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:508ee510-38aa-4805-0e10-725be0cbf639
msgctxt "hba39cb2agddafg4606g9a6eg0d1325271d3a"
msgid "There's nothing wrong with the city. You grew up here."
msgstr "도시를 떠날 필요는 없어. 네가 자란 곳이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 5b2562a6-f25e-1d83-668b-1f0f29a2aaf7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:5b2562a6-f25e-1d83-668b-1f0f29a2aaf7
msgctxt "h4f93136fg9926g4683g9261g32af524f68a4"
msgid ""
"Please stop reminding me of things to worry about. I'd like to get <i>some </"
"i>sleep tonight."
msgstr "걱정거리들 좀 그만 상기시켜 주지 그래. 오늘 밤엔 잠 <i>좀 </i>자고 싶으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 65986cff-4aa3-6dc8-241e-8bc686d7acd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:65986cff-4aa3-6dc8-241e-8bc686d7acd1
msgctxt "h499810bagb645g4185gbba5ge7eeb3761d67"
msgid ""
"It doesn't have to be a daunting prospect. Just dream about what you'd like."
msgstr "너무 어렵게 생각하지 마. 네가 바라는 걸 떠올리면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 75b302c6-6287-6f03-a3c3-6818c4fc7e81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:75b302c6-6287-6f03-a3c3-6818c4fc7e81
msgctxt "h92bca95agd85cg4851gb480g775d810ded92"
msgid "Go on..."
msgstr "계속 해 봐..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 7c1a06dc-d846-291c-78b1-971841187479
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:7c1a06dc-d846-291c-78b1-971841187479
msgctxt "he75de8f1g0729g47ffg97bag171f0888e804"
msgid ""
"I think I'd like to put Shar behind me, and find somewhere peaceful. Away "
"from the city, perhaps."
msgstr "샤를 뒤로 하고, 어딘가 평화로운 장소를 찾고 싶어. 최대한 도시에서 멀리 떨어진 곳이었으면 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 7ca72698-4adb-6ed7-f633-17eb17e44ce9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_RejectShar_SavedParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:7ca72698-4adb-6ed7-f633-17eb17e44ce9
msgctxt "h25baa0dfg1100g4b13gbd88g1eae279a5785"
msgid ""
"I'd like to find somewhere peaceful, with my parents close by. Away from the "
"city, perhaps."
msgstr "부모님과 머무를 수 있는, 평화로운 장소를 찾고 싶어. 도시에서 멀리 떨어진 곳이 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 8bd69722-38e8-85e7-4506-d1222c7c83c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:8bd69722-38e8-85e7-4506-d1222c7c83c1
msgctxt "he80c2abdgc732g4753gb754gabe668631a79"
msgid "Don't stop now. What else?"
msgstr "계속해 봐. 또 다른 건?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = 9298cd4d-9c02-04a7-dcdb-883ee696b587
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:9298cd4d-9c02-04a7-dcdb-883ee696b587
msgctxt "hc6386cddgd6d6g458cg9432gdb4b3c681bd3"
msgid "Let's see how we fare. Perhaps I'll get a better offer."
msgstr "차차 두고 보자고. 내게 더 좋은 조건이 생길지도 모르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = 9d959512-e17f-a478-eef0-9db081397618
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:9d959512-e17f-a478-eef0-9db081397618
msgctxt "h0b895274g94a5g400egaf1eg0f48280e88a1"
msgid ""
"I'd like room for animals. Lots of them - all shapes and sizes, so long as "
"they appreciate a warm fire and more affection than they know what to do "
"with."
msgstr "동물들을 키울 공간이 있음 좋겠어. 따뜻한 불자리와 애정을 나누길 꺼리지 않는 동물이라면 모양이나 크기는 상관 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = a362145f-2260-e29a-92af-8b955e3cad7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_CRD_SharedFuture_State_PlayerAsksAboutThemselves(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:a362145f-2260-e29a-92af-8b955e3cad7e
msgctxt "h32913079gb218g4772gb4adg8d49fc4ece0a"
msgid "And what about me?"
msgstr "나는 어쩌고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = af3fa6d3-f481-5dc6-3a43-b26e78cc5425
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_CRD_SharedFuture_State_PlayerAsksAboutThemselves(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:af3fa6d3-f481-5dc6-3a43-b26e78cc5425
msgctxt "ha835ebe5g762eg48cfga5b9g1340778789f9"
msgid "Is there room for me in this fresh start?"
msgstr "그 새로운 삶에 나도 끼워 주는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = af8abf40-1bc2-7e4e-3744-213c825e39e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:af8abf40-1bc2-7e4e-3744-213c825e39e2
msgctxt "hd6d329d6g75e7g4545g9e7fg75748a7dc27c"
msgid "Of course I'm willing."
msgstr "기꺼이 그렇게 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = b2acdf64-7c5f-dbc7-1143-70e08daf05e3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:b2acdf64-7c5f-dbc7-1143-70e08daf05e3
msgctxt "h42879407g83f0g42ffgb9e0ga33203b5143b"
msgid ""
"A <i>better offer? </i>You're lucky you're handsome and that I know you're "
"joking."
msgstr "<i>더 좋은 조건이라고? </i>운 좋은 줄 알아. 잘생긴 게 농담도 할 줄 안다고 생각하고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = b2acdf64-7c5f-dbc7-1143-70e08daf05e3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:b2acdf64-7c5f-dbc7-1143-70e08daf05e3
msgctxt "h9215b9f4g99d9g4433gb4b3g4d5bb62f9926"
msgid ""
"A <i>better offer? </i>You're lucky you're pretty and that I know you're "
"joking."
msgstr "<i>더 좋은 조건이라고? </i>운 좋은 줄 알아. 예쁜 게 농담도 할 줄 안다고 생각하고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = b2acdf64-7c5f-dbc7-1143-70e08daf05e3
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:b2acdf64-7c5f-dbc7-1143-70e08daf05e3
msgctxt "h1d422a32g1f94g419fgaeb9g8799059e40d2"
msgid ""
"A <i>better offer? </i>You're lucky you're dashing and that I know you're "
"joking."
msgstr "<i>더 좋은 조건이라고? </i>운 좋은 줄 알아. 매력덩어리 같은 게 농담도 할 줄 안다고 생각하고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = c3cec9e1-5596-ea81-2b91-93931a68d825
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_CRD_SharedFuture_State_PlayerAsksAboutThemselves(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_CRD_SharedFuture_State_PlayerAsksAboutThemselves(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:c3cec9e1-5596-ea81-2b91-93931a68d825
msgctxt "hf81177efgdb87g4e8cg83a0g4e5f55932a55"
msgid "Yes... I want to share it all with you, if you're willing."
msgstr "있어... 너만 괜찮다면, 그 모든 걸 너와 함께하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = cbe5e51c-d496-8d42-c02d-9842b2eaa7e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:cbe5e51c-d496-8d42-c02d-9842b2eaa7e4
msgctxt "h4d2879edg7834g42e1g8e07gd0dffce606d9"
msgid "I know, just teasing. Tell me what's on your mind."
msgstr "알아, 장난쳐 본 거야. 뭐 때문에 그러는지 말해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = d24ed4dd-7ad1-4d60-af41-5177480dbddf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:d24ed4dd-7ad1-4d60-af41-5177480dbddf
msgctxt "h846f41abg4865g41f4ga24ega2293f4c27dc"
msgid ""
"Since we arrived in the city, I can't help but feel a little... anxious. But "
"I'm not sure I know why."
msgstr "도시에 도착한 이후로 뭐랄까... 약간 불안한 기분이 드는데 왜인지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = d2a25ad6-6808-c1d4-146b-c3d450886065
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:d2a25ad6-6808-c1d4-146b-c3d450886065
msgctxt "haa76cd02g3966g49d5gb44ege6f901d91070"
msgid ""
"Well, I want to save my parents, of course. Take them away, far from Shar's "
"influence. Someplace peaceful - away from the city, perhaps."
msgstr ""
"글쎄, 일단 부모님을 구해야지. 그다음, 샤의 영향력이 미치지 않게 멀리, 평화로운 곳으로 모시고 싶어. 도시에서 떨어진 곳으로 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = d6a9f4f6-0ea2-4098-01df-6a525518dec0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:d6a9f4f6-0ea2-4098-01df-6a525518dec0
msgctxt "h1ddb9bf0g85e2g41dfg9187gadf2605ce0f6"
msgid ""
"Thank you. Now I have plenty of specifics to worry about. That wasn't what I "
"meant, though..."
msgstr "고맙기도 해라. 걱정거리가 더 늘었네. 어쨌든 그런 의도로 말한 건 아니었어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = d8b132a1-ee37-6ecd-bbad-3fc5f5e21ec6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:d8b132a1-ee37-6ecd-bbad-3fc5f5e21ec6
msgctxt "h84dfbbcegf3a4g444dgbf9ag60e21cf84c37"
msgid "How can I help?"
msgstr "어떻게 도와줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Player
#. NodeID = d91d844a-6fc5-016c-05fd-473667013620
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:d91d844a-6fc5-016c-05fd-473667013620
msgctxt "h20ae3543g8cafg445bg83e8g9fe5bee51627"
msgid ""
"Start at the beginning. Imagine it's the day after we defeat Absolute. What "
"then?"
msgstr "이렇게 가정해 보자. 절대자를 물리치고 다음날이 밝았어. 뭘 하고 싶어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = e405f9c6-67ef-4a83-2f62-c9408ba6fd2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_RejectShar_KilledParents = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:e405f9c6-67ef-4a83-2f62-c9408ba6fd2c
msgctxt "h60876a1cgaaf6g4733g8900g434dea1ec987"
msgid ""
"I'd like to find somewhere peaceful. Somewhere I can feel close to my "
"parents' spirits. Away from the city, perhaps."
msgstr "평화로운 장소를 찾고 싶어. 부모님의 영혼을 느낄 수 있도록. 기왕이면 도시에서 멀리 떨어진 곳으로 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture
#. Speaker = Shadowheart
#. NodeID = f2f3853b-e240-908b-36ef-3d487a6aab48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SharedFuture:f2f3853b-e240-908b-36ef-3d487a6aab48
msgctxt "hf2e18054g8b4ag4953g9823ge5cc1669a0f3"
msgid ""
"I did... after I was abducted. Perhaps if we survive all of this, a fresh "
"start would be for the best."
msgstr "그랬지... 하지만 납치되고 나서잖아. 모든 걸 극복하고 살아남는다면, 새로운 삶을 시작하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 02b98e6e-8f06-d3f3-62e2-bbb03e8076cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:02b98e6e-8f06-d3f3-62e2-bbb03e8076cf
msgctxt "hea90237ag66ecg4232g882eg3eeaf135833b"
msgid "Not quite. You'll see when we get there."
msgstr "그렇진 않아. 그곳에 도착하면 알게될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 0e71e2b8-37fb-4e65-9db0-42e4e871f217
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:0e71e2b8-37fb-4e65-9db0-42e4e871f217
msgctxt "h3bf640b2g3bd5g4ae0g8b6ag2a0bc2cb8755"
msgid "You made your choice."
msgstr "네가 선택한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 12f33004-e2f6-a6e3-1080-208555c0ab43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:12f33004-e2f6-a6e3-1080-208555c0ab43
msgctxt "hf3500792gf9edg4a52g9e5ag2972eb6f5575"
msgid ""
"I seem to recall you encouraging me to spare Nightsong. Perhaps you're more "
"like me than you care to admit. Help me, or don't."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 14111426-c510-822b-5de1-3c1792b78b53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:14111426-c510-822b-5de1-3c1792b78b53
msgctxt "h2ed71f55g920ag4e08gbe04g3edc356b6627"
msgid ""
"I hope that's true, but I'm not so sure. She has a far reach, and a long "
"memory."
msgstr "그게 사실이면 좋겠지만, 잘 모르겠어. 그녀는 멀리까지 영향력을 행사하고 쉽게 잊는 법이 없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 14dd36eb-f453-6781-07f5-52542b5607c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:14dd36eb-f453-6781-07f5-52542b5607c8
msgctxt "hf9b92748gf994g4b53gac8bg77a46b9259d7"
msgid ""
"You've nothing to be sorry for. Far from it, in fact. Without your help, "
"things could have ended very differently for me."
msgstr "네가 미안해할 건 없어. 오히려 감사를 받아야 마땅한걸. 네 도움이 없었다면 난 매우 다른 상황에 처했을 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 2005010d-d941-2308-fc43-080ddf0950b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:2005010d-d941-2308-fc43-080ddf0950b6
msgctxt "hc33e5a18g2330g48c4g8213gd53d17332834"
msgid "You mean Shar? Forget it - her spite can't hurt you now."
msgstr "샤 말이야? 신경 쓰지 마. 이제 그녀의 악의는 널 해칠 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 34c4ae30-8ed4-26f7-b887-7fa277f06a96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:34c4ae30-8ed4-26f7-b887-7fa277f06a96
msgctxt "hecf8da62g4e79g4f15gb50agf5c4ea093eb3"
msgid ""
"Shar? Not <i>Lady </i>Shar? Once you'd have bitten your own tongue rather "
"than speak like that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 395edeb2-3336-bbca-c123-12d2387f8898
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:395edeb2-3336-bbca-c123-12d2387f8898
msgctxt "hea8664f7g1b81g47b8gaa50gb21f545b4d88"
msgid "You blaspheme. I ought to kill you for that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 39ee6397-5f4b-d528-7873-2de4fc99b182
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:39ee6397-5f4b-d528-7873-2de4fc99b182
msgctxt "hd0161ceeg7107g4f10g9adfgb55ab9e0769b"
msgid "I need to take back control. Seize what I've been denied."
msgstr "주도권을 되찾고 내게 허락되지 않았던 것을 차지해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 3ebfa57e-0718-55bb-a59f-20a2d5d9605d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:3ebfa57e-0718-55bb-a59f-20a2d5d9605d
msgctxt "hf24b7f97g0264g42f9g9dd1g4e067f27d432"
msgid "You want to go swimming? I was expecting something dangerous."
msgstr "수영하러 가고 싶다고? 위험한 거 하려는 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 4d6163fb-8e79-5901-f70b-c98b3bed3d12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:4d6163fb-8e79-5901-f70b-c98b3bed3d12
msgctxt "h8ec30bb1g5fe0g401ag98b8gb8964f7c8d31"
msgid "With <i>your </i>encouragement, remember?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 4feb19e6-99ac-3511-f5cc-60ffb6141448
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:4feb19e6-99ac-3511-f5cc-60ffb6141448
msgctxt "hbb0e468cgb5ccg43e0g98d9g884dd9c5dd5f"
msgid ""
"I see. In that case you'd better go get some rest. Wouldn't want your focus "
"to slip."
msgstr "그렇구나. 그럼 넌 가서 좀 쉬어야겠네. 네 <i>집중력을</i> 낭비해선 안될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 54faeb09-bab5-4f65-9a21-becd6c615072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:54faeb09-bab5-4f65-9a21-becd6c615072
msgctxt "hf9e2219cg7256g4928g8c15gf383475c6cbb"
msgid ""
"Well... don't laugh, but one thing I do remember about myself is that I "
"can't swim. I think it's time I remedied that. And washed off Shar's bile at "
"the same time."
msgstr ""
"그게 말야... 비웃지 않기야. 내 자신에 대해 기억나는 건 바로 수영을 할 줄 모른다는 사실이야. 내 생각엔 그걸 바로잡으면서 샤의 "
"분노도 씻어낼 시간이 온 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 55b6815d-e3c2-2f4b-0219-997f6a512f50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:55b6815d-e3c2-2f4b-0219-997f6a512f50
msgctxt "hefcbc98bga9b3g49e8gb81dg2f4a42d5e750"
msgid ""
"A lot's changed since then. More than I ever thought was possible. And "
"besides, she's no lady."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 56348e03-0de6-a416-a952-8b0b82e8887c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:56348e03-0de6-a416-a952-8b0b82e8887c
msgctxt "hf94e13cfgecbbg4795g92cagba386d2e0596"
msgid "You wouldn't say that if you ever saw me in the water."
msgstr "내가 물속에서 어떤지 봤으면 그런 말 안 나올 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 621c68e3-1fb2-fcc0-8983-ea78c98a1ee1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:621c68e3-1fb2-fcc0-8983-ea78c98a1ee1
msgctxt "h027dc268g587dg4040gac70g0afff5a1e5bc"
msgid "If that's what you want, I'll be ready."
msgstr "그게 네가 원하는 거라면 준비해놓을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 67e41174-9042-0047-e7ea-2dab79c7b470
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:67e41174-9042-0047-e7ea-2dab79c7b470
msgctxt "h5d671741g772cg48c3gbfa3g9c6a42b473ff"
msgid "Down the coast? Are we going fishing?"
msgstr "해변을 따라 내려가? 우리 낚시하러 가는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 68d7425a-586a-f6fc-c1c0-1e0df6317abe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:68d7425a-586a-f6fc-c1c0-1e0df6317abe
msgctxt "ha1cae98dge7c2g4cc1gab09g54f7e7d7879f"
msgid "I have an idea, but I'll need your help."
msgstr "좋은 생각이 있는데 네 협조가 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 6d18f5c5-ad30-4421-8e46-756c16588e2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:6d18f5c5-ad30-4421-8e46-756c16588e2b
msgctxt "h14229d2eg49e0g4c4fg8b39g87f9155d2d7c"
msgid "So what do you want to do about it?"
msgstr "그에 대해 어떻게 하고 싶은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 70bbef02-4b17-b5de-da7d-c56935fc3faf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:70bbef02-4b17-b5de-da7d-c56935fc3faf
msgctxt "hfe5e19f8g834dg436bgaaa5g6ef9f04820fd"
msgid "I'm sorry."
msgstr "유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 7aeeb726-f814-affe-407d-f6240cba8c8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:7aeeb726-f814-affe-407d-f6240cba8c8a
msgctxt "h2f898e2cg89b0g4316g870eg8532f4ebc55b"
msgid "I'm no swimming teacher, just so you're aware."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 7e998c39-12ca-d37e-b886-7881ec24d028
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:7e998c39-12ca-d37e-b886-7881ec24d028
msgctxt "hf081ef92g8f85g43c0gbd58gf31b773635fe"
msgid ""
"I have an idea. Something I've wanted to do for a while. Something that "
"might help me put <i>her </i>in the past... but I'll need your help."
msgstr ""
"내게 좋은 생각이 있어. 오랫동안 하고 싶었던 거야. <i>그녀를</i> 과거로 남길 수 있게 도와줄 무언가지... 하지만 네 협조가 "
"필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 86667e66-2a69-f840-743e-d0ebd87382b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Shadowheart_Event_SkinnyDippingRomanceScene(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:86667e66-2a69-f840-743e-d0ebd87382b6
msgctxt "h3ea4423fg0b2ag4a4dg9133g84da165b3496"
msgid "Good. Until then. Get some rest while you can."
msgstr "좋아. 그때 보자. 시간 있을 때 좀 쉬어둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 8ff3423c-478c-4d2a-a1d2-4aead0f04772
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Shadowheart_Event_SkinnyDippingRomanceScene(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:8ff3423c-478c-4d2a-a1d2-4aead0f04772
msgctxt "h5abac5c3g8c71g41degb6c2g9be207cf97d2"
msgid ""
"Wait until the others are asleep, then come with me. There's a place we can "
"go, down the coast a little."
msgstr "다른 애들이 잠들기를 기다렸다가 날 따라와. 해변을 따라 조금 내려가면 우릴 위한 장소가 하나 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = 9330c8d9-cd67-668c-d73a-01cb1b10b7fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:9330c8d9-cd67-668c-d73a-01cb1b10b7fa
msgctxt "h730546a3g1ba7g4bd0gabbfgfd26c7367761"
msgid ""
"I sacrificed my memory's for Shar- to preserve my mission. But one thing I "
"do remember about myself is that I can't swim. I think it's time I remedied "
"that. And washed off Shar's bile at the same time."
msgstr ""
"난 샤와 내 임무를 위해 기억을 희생했어. 하지만 내가 헤엄을 치지 못한다는 사실 하나만은 기억나. 내 생각엔 그걸 바로잡고 샤의 분노 "
"또한 씻어낼 시간이 된 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = 9eae8212-3437-b146-276b-25872c2cf5d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:9eae8212-3437-b146-276b-25872c2cf5d0
msgctxt "hb88194b4g7976g4873g8bdfgadf5bc034ae7"
msgid "There's no time for this."
msgstr "이럴 시간 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = a44d86d6-e77f-a902-88d3-3e3ca6faaa07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:a44d86d6-e77f-a902-88d3-3e3ca6faaa07
msgctxt "h18e1ea8ag98d0g4d3ag8633gf5dac901c547"
msgid ""
"Understood. Just keep me from drowning, and don't laugh while I flail about "
"in waist-high water. That's all I ask."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = a8b02626-9f31-2f4a-d11e-4695dacecfc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:a8b02626-9f31-2f4a-d11e-4695dacecfc6
msgctxt "hc871b72bg0086g4795g8298g145ff870fa70"
msgid "I want to wash it away. All of it..."
msgstr "씻어내고 싶어. 전부 다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = ad91a0a7-5a77-194a-ede3-2af3ef85d1c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:ad91a0a7-5a77-194a-ede3-2af3ef85d1c8
msgctxt "hdab828b6gd17fg4be7gb332g5b5fbea0e542"
msgid ""
"Just wait until the others are asleep, then come with me. There's a place we "
"can go, down the coast a little."
msgstr "다른 애들이 잠들기를 기다렸다가 날 따라와. 해변을 따라 조금 내려가면 우릴 위한 장소가 하나 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = adc8d32b-0987-4835-a46f-dccea26e1d87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:adc8d32b-0987-4835-a46f-dccea26e1d87
msgctxt "h6400c619g95dcg4c85gb26fg9e0a177698a7"
msgid ""
"I can still feel the Shadowfell all over me... still hear her words in my "
"ear. I feel... unclean."
msgstr "여전히 섀도펠이 날 감싸고 있는 게 느껴져... 지금도 그녀의 목소리가 맴돌아. 난... 불결해진 느낌이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = aeef6416-b7bf-4966-723f-2d3064efb957
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:aeef6416-b7bf-4966-723f-2d3064efb957
msgctxt "h9b010c8bg2d98g47afgba7bgaf8a6b6af056"
msgid "Of course."
msgstr "말만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = aefd9208-6e6b-5d33-4659-42cc281a7885
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:aefd9208-6e6b-5d33-4659-42cc281a7885
msgctxt "h69186bfcg5d0cg4e6fg8a7bgb501b5a70e46"
msgid "No. This is no time for distractions - we need to keep focused."
msgstr "아니, 지금은 한눈팔 시간이 아니야. 우린 계속 목표에 집중해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = c0526981-eaee-955e-ff23-b017d91a2dda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:c0526981-eaee-955e-ff23-b017d91a2dda
msgctxt "h63ce3aafg5037g4925gb609g0769df61930a"
msgid "What do I need to do?"
msgstr "뭘 해줘야 해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = cd026843-7ae9-c997-3393-c5bcfa662b05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:cd026843-7ae9-c997-3393-c5bcfa662b05
msgctxt "h4bb02624g062bg4875gb47eg179df591f143"
msgid ""
"I did, and its too late for regrets... but I wish I felt a little more "
"comfortable in my own skin."
msgstr "그래, 그리고 후회하기엔 너무 늦었지만... 내게 자신감이 더 있었다면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = d94be717-42da-bb30-d9fc-cead5ada8a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:d94be717-42da-bb30-d9fc-cead5ada8a68
msgctxt "ha26e5d4bgaee2g4eb8g837ag6035e908051d"
msgid ""
"Strictly speaking you should have killed me the moment Shar banished me. But "
"you didn't, for whatever reason. Help me, or don't."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = dd0a9c9c-8f58-6782-b7e6-69da4a7521c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:dd0a9c9c-8f58-6782-b7e6-69da4a7521c1
msgctxt "h38baa36fgd865g4cd5g83cdgb4dd7395e1a4"
msgid "Do you expect sympathy from me? You turned your back on the Dark Lady."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Player
#. NodeID = ea7134e2-8b0c-a2cd-68a7-bc38a55b015d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:ea7134e2-8b0c-a2cd-68a7-bc38a55b015d
msgctxt "h74fc1677gfce0g4b75ga7b3g57bea4ae058a"
msgid "But what then? Come on, let's not start keeping secrets again."
msgstr "그런 다음엔? 어서 말해, 다시 비밀을 만들진 말자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = f6a28513-0ddd-8e50-6a6b-39f88ca6d76f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:f6a28513-0ddd-8e50-6a6b-39f88ca6d76f
msgctxt "h10802c21g7bb3g49f1g8449gc1ea9ca0d483"
msgid ""
"Don't be so quick to judge - she didn't ask anything of you. Who's to say "
"you'd have handled it any differently?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = f87d078c-c5de-ddc3-9e33-6a74171188b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:f87d078c-c5de-ddc3-9e33-6a74171188b9
msgctxt "hfe6e0b52g2cc2g4dc6ga039gadf00ba3aa70"
msgid ""
"What's done is done, but I have an idea that might help me... if you're "
"willing to play a part."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = fe4e2f3c-30f6-84b2-fbdd-bda36f6dbc71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:fe4e2f3c-30f6-84b2-fbdd-bda36f6dbc71
msgctxt "hdfe71dc1g0317g4bdcgafbagd69f9807bee6"
msgid ""
"Do you remember what I told you before, about how I can't swim? Well, I "
"think it's time I remedied that. And washed off Shar's bile at the same time."
msgstr ""
"전에 내가 한 말, 헤엄칠 줄 모른다고 했던 거 기억나? 내 생각엔 그걸 바로잡을 시간이 온 것 같아. 샤의 분노 또한 씻어낼 겸 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance
#. Speaker = Shadowheart
#. NodeID = ff67135f-3481-4c27-0a58-187a405f0552
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Shadowheart_CRD_SkinnyDippingRomance:ff67135f-3481-4c27-0a58-187a405f0552
msgctxt "haec1b46ag5a57g42d6ga98ag128f7e3468c2"
msgid ""
"I had thought you would <i>want </i>to make time for me... I suppose I was "
"wrong. Rest well then."
msgstr "날 위해 시간을 내고 <i>싶어할 줄</i> 알았는데... 잘못 생각했나 보네. 그럼 편히 쉬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_TieflingCelebration_CompanionChoice
#. Speaker = Player
#. NodeID = 0f3fdb16-360a-42aa-957a-92e8be7b1bfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_KarlachPartner(-1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_TieflingCelebration_CompanionChoice:0f3fdb16-360a-42aa-957a-92e8be7b1bfc
msgctxt "h7bfc61a6g47bbg4f64g82b1gc6079826c228"
msgid "<i>Karlach.</i>"
msgstr "<i>칼라크.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_TieflingCelebration_CompanionChoice
#. Speaker = Player
#. NodeID = 16b923cc-d6ac-28c8-b216-4667c6b8b444
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
