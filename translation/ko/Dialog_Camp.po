msgid ""
"<i>Pay him what you promised.</i> ([5dac5eea-faeb-459c-b675-46c51519b784])"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Lump the Enlightened
#. NodeID = 5fe5590f-dcff-1dfa-ca05-ba1bbbbd9ed8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:5fe5590f-dcff-1dfa-ca05-ba1bbbbd9ed8
msgctxt "h06f303b5g5e79g4808ga15cg6ab9386a3f59"
msgid ""
"Can I lick that mouth-watering meat of yours? A parting gift, as it were."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Lump the Enlightened
#. NodeID = 61bb95e9-6cca-1ecc-f24e-60cfe58897b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_SummonedThrice = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:61bb95e9-6cca-1ecc-f24e-60cfe58897b6
msgctxt "h29fef136g022cg453dgaf03gfe71831ea4e3"
msgid "Alas, I must find another's bones to crack."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Player
#. NodeID = 78bec906-74be-3f56-dc0c-74bcbe92aef1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
