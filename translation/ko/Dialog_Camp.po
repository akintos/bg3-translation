msgctxt "hfa03dcdfg40a6g4c6cg9acdg45c4737c28a9"
msgid ""
"*There is a beautiful blush on his cheeks that was never there while he was "
"alive.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
