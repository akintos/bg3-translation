msgctxt "h3a95b2c8g2c13g4739g9e6dgb3b79c5b2163"
msgid ""
"*You can smell the sweetness of his skin - hear the beat of his pulse...*"
msgstr "*피부에서 달콤한 냄새가 풍깁니다. 맥박 소리에 귀를 기울여 보세요...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 372b6523-9be6-7dd8-0725-95436bbef2fb
#. HandlePath = TaggedText[0].TagText[0]
