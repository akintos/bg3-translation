msgctxt "h5dd5e4aeg3a33g4a42g80abg7faaeb69cef2"
msgid "You grace my stool? I'm honoured."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
