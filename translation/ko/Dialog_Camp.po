msgctxt "hfd31930fge5eag4b7bg808dg0bacb17b883d"
msgid "*Screech!*"
msgstr "*키이익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub
#. Speaker = Owlbear Cub
#. NodeID = a4f332a5-63ca-206f-ed90-7798dd0359a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_OwlbearCub_HasMet_GoblinHuntCelebration(1) = True
