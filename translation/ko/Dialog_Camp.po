#. NodeID = 1a4cc3e8-84b8-a222-53aa-516d06cf497e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1a4cc3e8-84b8-a222-53aa-516d06cf497e
msgctxt "hb95549e8gfc14g4d4agb289g0503d0ddee28"
msgid "I love you too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 1ac62a55-0a17-917d-f8f0-eb4c6d671dd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1ac62a55-0a17-917d-f8f0-eb4c6d671dd0
msgctxt "h05248422gdd5eg4c93gbe0ag544367029e09"
msgid "We'll have to make some new secrets between us, then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 1ac849cf-169f-927c-e000-d322d9825bcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1ac849cf-169f-927c-e000-d322d9825bcc
msgctxt "h9ccb58b1g67bdg47b6ga905gf77c4991e7da"
msgid "What do you want to do now?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 1bee57a6-c6b2-59fd-45b8-18ed40fbde3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1bee57a6-c6b2-59fd-45b8-18ed40fbde3b
msgctxt "ha543a833g365bg4be4gafe6g73bc45a8c44f"
msgid ""
"Aw. Well, if you ever want to learn, I'd love to take you to a little pond I "
"know outside the city. Shallow, safe, and I'd be there to help you float."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 1c3f4a2d-a195-8a0b-0e1d-707af031b77f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1c3f4a2d-a195-8a0b-0e1d-707af031b77f
msgctxt "h42234df7g95cbg4625g84adg17ad3cce8657"
msgid ""
"I'm not sure. I feel like I saw the heart of you from the very beginning. "
"And I've had a piece of you with me ever since."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 1d53bacd-3a5f-951f-2fbb-7487cd5ccb1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1d53bacd-3a5f-951f-2fbb-7487cd5ccb1e
msgctxt "h935b9df6g2af4g4c7dgbf4eg7f6ab7f214d4"
msgid "You are terrifying. I love it so much."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 1d593625-1d90-8c6f-e0b4-98a80302e8dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1d593625-1d90-8c6f-e0b4-98a80302e8dc
msgctxt "h610f54adg447fg4094gbdd3gd2754d5b337c"
msgid "That's true. We ought to behave like we've only just met."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 1e51271e-8a18-cdf3-0ea7-01c9339cba40
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Karlach_Event_AgreedGoingOnADate(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1e51271e-8a18-cdf3-0ea7-01c9339cba40
msgctxt "h2ab9b772g2781g4989gb543gfdd87438d9bb"
msgid "I'd love to go out with you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 1f4548a3-3bad-e401-2d78-8905fb9bbbe6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:1f4548a3-3bad-e401-2d78-8905fb9bbbe6
msgctxt "h6b394d14g07c2g4cb8g8040gd590286d9743"
msgid "I'm from Baldur's Gate, too. I wonder if we ever crossed paths."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 2023b012-8381-d147-af9e-27552a00bfe6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Karlach_PlayerDumpedKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:2023b012-8381-d147-af9e-27552a00bfe6
msgctxt "h6b8462a5ga0d9g42b3g979cga6d67bdf48b9"
msgid "I need a minute. I need a lot of minutes. Please."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 2190db97-ed9b-f7ab-06df-65593834b916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:2190db97-ed9b-f7ab-06df-65593834b916
msgctxt "hc984310cgd031g4e45ga0a1g0f135dfb0f8e"
msgid "...and two cups of tea."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 23426600-89c1-c443-08ea-1353096509c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:23426600-89c1-c443-08ea-1353096509c4
msgctxt "h26087637g7c99g419cga28ag53352de87caf"
msgid ""
"You might be your own greatest fear, but you're your own greatest strength, "
"too. I see that every time I look at you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 23f91586-061f-7426-ca96-7c8fd1c25f58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:23f91586-061f-7426-ca96-7c8fd1c25f58
msgctxt "h8059d8c1g545fg4ff2gaf93g0e06369b5cba"
msgid "After you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 27b2f472-b502-f49c-4907-d4cadd7c90f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:27b2f472-b502-f49c-4907-d4cadd7c90f7
msgctxt "hef1674b1gec94g4944g9bdbgdb9c304e7916"
msgid ""
"I refuse to find out you're an arsehole at this late juncture, so I'm going "
"to pretend I didn't hear that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 295d7888-b8fa-2e6d-d8c0-604a3d5dc3f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:295d7888-b8fa-2e6d-d8c0-604a3d5dc3f4
msgctxt "h7dd39f67g18f3g41b0g9d40gec1dfa71d78b"
msgid ""
"Oh. All right. Well - good night. I had a great time with you. <i>Really </"
"i>great. I... hope you did too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 2cb0509d-b5fc-91bd-ccb0-9dd2d505442a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:2cb0509d-b5fc-91bd-ccb0-9dd2d505442a
msgctxt "h1e654ffag393eg42a1g94d5gce17bb085633"
msgid "Two pumpkin stews, my good man. And two glasses of..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 2d638090-3ca8-c9a8-00e8-02d3dd12eddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:2d638090-3ca8-c9a8-00e8-02d3dd12eddc
msgctxt "hf1cf7d1egb126g4c96g9bdbge35f36670455"
msgid ""
"Right here in Baldur's Gate, more or less. My folks are long gone now, but "
"they raised me in the Outer City. Dad was a porter in town, mum did laundry. "
"Still think of her when I smell clean sheets."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 2ebe0a7e-0ac4-91a5-55a8-6602dffdbd38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:2ebe0a7e-0ac4-91a5-55a8-6602dffdbd38
msgctxt "ha0ae0a0eg0beag4d73g9899g741118a95c93"
msgid ""
"If this is it for us, I accept that. But I'd like to find someone who's keen "
"to have a nice meal with me while I still can."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 309cbd8c-12b4-3806-dd4c-b09bee06741e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:309cbd8c-12b4-3806-dd4c-b09bee06741e
msgctxt "h3c30d6ddg0c6fg431bgb4bbgc39dbfadb1f1"
msgid ""
"I stole some of my father's cigars and blamed a servant. Got my arse whipped "
"for it, too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 316cd040-96c0-c6d2-ef66-e081c081a837
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:316cd040-96c0-c6d2-ef66-e081c081a837
msgctxt "hddc1b72dg4713g42c2g9050geb27b1971ae3"
msgid "You're right. So... erm... where did you grow up?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 31730a8a-1984-9f30-7cf6-34a87d274159
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Karlach_PlayerDumpedKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:31730a8a-1984-9f30-7cf6-34a87d274159
msgctxt "h3f4bde81g8ff6g4009g9d9dg760a5cb11d7c"
msgid "I need to be alone, all right? I'm very fucking confused right now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 34bbe17e-4855-5984-3dc3-b7f11334bbf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:34bbe17e-4855-5984-3dc3-b7f11334bbf4
msgctxt "hb634bd1eg7d77g4ea2g9669g7330cf963da6"
msgid "I grew up in the Underdark - not for the faint of heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Tender Honk
#. NodeID = 37f82ddf-6ebf-c21d-09c5-b5fb8df26d68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:37f82ddf-6ebf-c21d-09c5-b5fb8df26d68
msgctxt "h2916c49bg2f52g4941g83dbg3172e347c23d"
msgid "Hmph."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 3896bdfc-d3e8-435c-ad3e-4dd7c9aec201
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:3896bdfc-d3e8-435c-ad3e-4dd7c9aec201
msgctxt "h6e65af5bgf501g4514g8eeag7864abeeae8d"
msgid ""
"Whatever do you mean? We're just two normal people living normal lives very, "
"very normally."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 3e970701-9198-4fb1-c07d-d5f41f7b0479
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_RefusedGoingOnADate = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:3e970701-9198-4fb1-c07d-d5f41f7b0479
msgctxt "h1f4f77eegb15eg4c98g9db0g72ecc1f87f6c"
msgid "Can we go as friends?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 403aae9b-a75c-58a5-265d-cfaa24822987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:403aae9b-a75c-58a5-265d-cfaa24822987
msgctxt "h31eb41b5g3f82g4e82g8a39g1bb28086ce95"
msgid ""
"Why's that even on the menu? Then again, if it's good enough for you, I "
"suppose it's good enough for me too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 43072bc3-c227-ed7a-0e33-16a886c5ecce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:43072bc3-c227-ed7a-0e33-16a886c5ecce
msgctxt "h218589ceg5d0fg4b64gbc1ag669b8eab3c57"
msgid ""
"Hmm. Partially. On the one hand, you're dangerous temptation itself. On the "
"other, there's something very frank about you. Something familiar."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 4347b95a-cdf0-c45c-9622-80dd2cfd8f34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:4347b95a-cdf0-c45c-9622-80dd2cfd8f34
msgctxt "h7dc35c0eg95ccg4f12g8565g5a02188a905f"
msgid "Cut from the same cloth, some might say."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 44c5c568-bed4-c301-1aaa-16827095c736
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:44c5c568-bed4-c301-1aaa-16827095c736
msgctxt "h1d04a46bgaec7g41e1g8df7g320894ca3acd"
msgid "I don't think I can."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 45fdf6e4-36cd-9392-da51-082275a30c37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:45fdf6e4-36cd-9392-da51-082275a30c37
msgctxt "h31f951bag6bd3g4762g86a1gfa67f8dba52d"
msgid "My past is a little like yours. No wonder we get along."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 4d1a26c5-70ba-8795-13dc-53230731187f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Karlach_CRD_ROM_ANightOnTheTown_Stew = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:4d1a26c5-70ba-8795-13dc-53230731187f
msgctxt "hbb83dedfg4ac7g4055g80f7gca6a5c686146"
msgid "I actually think the seafood stew sounds nice."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 4d59979b-59ec-1a3b-a5e2-74c4aabab8ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:4d59979b-59ec-1a3b-a5e2-74c4aabab8ae
msgctxt "h6f74e501gbc25g4d43gac38g4124e3c074f2"
msgid ""
"You speak true! And now I'll claim my reward for my labours escaping the "
"evil archdevil: <i>you</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 4e38d77d-253f-82be-8cb0-aba56d77e776
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:4e38d77d-253f-82be-8cb0-aba56d77e776
msgctxt "ha7a18875gb800g4b26g9df2ge0939adad9eb"
msgid ""
"Hmm. Baldurian seafood stew. No thank you. What do you think you'll have?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 4fa99515-6fd9-2d28-4793-bd23a6829085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:4fa99515-6fd9-2d28-4793-bd23a6829085
msgctxt "h0e1c4135gf929g4975ga0d7gedff05b66b19"
msgid ""
"Impossible. You leave your stamp everywhere you go. Just look at me - "
"absolutely besotted."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 51a93fbd-ca90-f77d-ccfa-3331d9b31fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:51a93fbd-ca90-f77d-ccfa-3331d9b31fc6
msgctxt "hb920a657g5dcbg456dg8169gc75bf03f8f44"
msgid "Lovely having a normal evening amid the chaos."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 51d8f860-0a88-ab9d-ced8-f8b0feefa4c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:51d8f860-0a88-ab9d-ced8-f8b0feefa4c5
msgctxt "h17729663g5490g403aga256ged4d1b3507c4"
msgid "Maybe I shouldn't knock what I haven't tried."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 52c883d9-7bf0-90eb-f37e-8e2ce44b556a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:52c883d9-7bf0-90eb-f37e-8e2ce44b556a
msgctxt "hf16e0108g224fg43a8ga8c6g6d2c145d1b79"
msgid "I feel you could've made a bit more of an effort."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 535f5c5d-c282-0055-fce5-a43785fe9681
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:535f5c5d-c282-0055-fce5-a43785fe9681
msgctxt "h003ac50dg3b13g40abg9403g88182d48636c"
msgid "Even crazier than that, if you can believe it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 53e1940a-ad2e-0340-19e1-71b9ec7362c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:53e1940a-ad2e-0340-19e1-71b9ec7362c3
msgctxt "ha4f9c8e6g1e47g45e9g88d7g07b30909608a"
msgid "Just what I had in mind."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5560572a-6ee1-b00f-8021-82fea3500975
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5560572a-6ee1-b00f-8021-82fea3500975
msgctxt "h2e91a366gc002g4693ga747g54c9d4989b4a"
msgid ""
"Kill the monsters, save the townsfolk, sweep the local hellbeast off her "
"feet?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 558fe94b-833a-0502-f171-0dc8a01a1665
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:558fe94b-833a-0502-f171-0dc8a01a1665
msgctxt "heacb6dcag5899g4901ga08eg1fbdd0af61d2"
msgid ""
"You hear me? <i>You're</i> all I could ever ask for. I love you. And I know "
"that whatever else this city will throw at us, we can handle it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 58035680-893b-351b-ff50-e9b8fd24918c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:58035680-893b-351b-ff50-e9b8fd24918c
msgctxt "h120d4570gf4cbg4d8cgb2f0g9c73d77bf791"
msgid "I've figured it out. Exactly what I want to do with you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Tender Honk
#. NodeID = 58464f96-35a6-3242-3fbf-d5302f626941
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:58464f96-35a6-3242-3fbf-d5302f626941
msgctxt "h77022423gad27g4353ga755g0b89fec20c08"
msgid "Ugh."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 58890596-ad1b-f36b-1346-c8af3f5dfc29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:58890596-ad1b-f36b-1346-c8af3f5dfc29
msgctxt "h0fbbafbcg3813g40abg9bb0g16a7bf941657"
msgid ""
"I understand. The people who hurt us have an annoying habit of lingering, "
"one way or another. I'm sorry for what he did to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 58bb72ef-3250-936c-6923-567ca5a2ff18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:58bb72ef-3250-936c-6923-567ca5a2ff18
msgctxt "h47d8e68cgab29g4b0dgbb76gac4cbe1d3d20"
msgid "You oaf!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 598a8e7a-2570-2326-093f-b03c24d15072
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:598a8e7a-2570-2326-093f-b03c24d15072
msgctxt "ha95d224ag270fg4558g810fg8ef270c42a1d"
msgid ""
"It's very faint... but I think that a foster family looked after me before I "
"ended up in the Temple of Bhaal."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 5a426be2-365c-ff6b-7460-9e74412e1c7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5a426be2-365c-ff6b-7460-9e74412e1c7e
msgctxt "h93e4e1cag42edg4369g9193ga3fb9f129e09"
msgid "The grilled rothé ribs sound good."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5a9ed8e7-19d6-71bc-a89a-088221cd0197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5a9ed8e7-19d6-71bc-a89a-088221cd0197
msgctxt "hdb451d43g61a2g463cgab76g24b44093774a"
msgid ""
"Wonder if they're still out there somewhere. No chance they could've "
"forgotten someone like you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5aa42dea-403f-5906-b11e-a81494d7a5b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5aa42dea-403f-5906-b11e-a81494d7a5b3
msgctxt "hc0e18039g3e72g4813ga6a0g6f005c21adf1"
msgid ""
"Gods, we're terrible at this. This was supposed to be a first date, but it's "
"all I can do to keep my hands to myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5b2a3237-c45f-53b8-7451-89383b2a0c6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5b2a3237-c45f-53b8-7451-89383b2a0c6c
msgctxt "haa5d418bgeb91g4f0bgb34fg25a2161e1e03"
msgid "Worst guy I ever met. Anyway, how about a toast? Oh - shit!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5d600369-e19e-08a0-1542-542f37c302be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5d600369-e19e-08a0-1542-542f37c302be
msgctxt "ha8d2050eg33beg4a1ag8bfbg31cce6937629"
msgid "I'm sure. You've probably killed scarier things blind and bleeding."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5dc392fc-36a8-478b-e0c6-1a3f3e760a38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5dc392fc-36a8-478b-e0c6-1a3f3e760a38
msgctxt "h349093b5gc69dg41ccgb36eg6f1e87e06849"
msgid ""
"I want to go on a date. A first date. No weapons, no monsters, no mysterious "
"voices... just you and me and dinner."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5e5b8fa7-2cfe-f0ad-b320-50bc083469be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5e5b8fa7-2cfe-f0ad-b320-50bc083469be
msgctxt "h65dd1abfgb848g46d0gbcdeg304d023996fc"
msgid "Hmm. Ask me a question, maybe. A getting-to-know-you type question."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 5f5a0ffa-2c98-208c-3c9a-a576fb9aa493
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5f5a0ffa-2c98-208c-3c9a-a576fb9aa493
msgctxt "h142feb86gde13g4dfbg9b5cgb4f37d5cc7a3"
msgid ""
"I was half-hoping some bandits would burst in and give us something to do."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 5f9bd8bb-e428-1bc7-b8fc-cd2b3e48412c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:5f9bd8bb-e428-1bc7-b8fc-cd2b3e48412c
msgctxt "h4f908832ga2eag4db1gbd60g740c88930ec4"
msgid "'Cause you never know when your last will come."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 630acd34-2afb-4f64-e4e6-d24fbe999e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:630acd34-2afb-4f64-e4e6-d24fbe999e8f
msgctxt "h9a1a24e7g7d9bg45feg8601g1e1a7b008ac0"
msgid "Let's get out of here. I need you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 64cc57ec-bc7e-208a-5639-da731d9dfa90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:64cc57ec-bc7e-208a-5639-da731d9dfa90
msgctxt "habc7a76dg5906g499egaad2g738ed842dfff"
msgid "Please say yes."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 652095f5-3a99-972f-6bbf-7039d2ed058e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:652095f5-3a99-972f-6bbf-7039d2ed058e
msgctxt "h6681bd4bgb2f7g4f70gba73g9b023a55dac9"
msgid ""
"There's a little spot I know in town. Out of the way, but the view of the "
"city is <i>incredible</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 65878278-ed24-c806-03ac-b70f55065a54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = False
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:65878278-ed24-c806-03ac-b70f55065a54
msgctxt "hd8c5b141ga171g4309gbdf4g79c3cc43fa5a"
msgid ""
"My queen's rejection. To be denied my true worth, after all I've given her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 663c7b00-8f44-c71d-7224-5fd1d820a2d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:663c7b00-8f44-c71d-7224-5fd1d820a2d6
msgctxt "h150e2e7bgdbf6g462dga637g6cc645204d27"
msgid ""
"We've been through so much, and the worst is yet to come. I have every "
"reason to feel terrified... hopeless... like giving up."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 6728f164-46f3-72eb-90f4-91c3867ea616
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6728f164-46f3-72eb-90f4-91c3867ea616
msgctxt "h68dacb71g0d97g4c64gb543g7f27defc86e2"
msgid "Wait, what?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 681430e0-49a4-e151-aa24-2b1455ec8a48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:681430e0-49a4-e151-aa24-2b1455ec8a48
msgctxt "he3351f0eg8310g43c8gaac1g2a5cb8a754fe"
msgid ""
"You belong here. With me. I know I'm not a forever kind of investment, but "
"right here, right now, you are <i>it</i>. You are <i>everything</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 69626b63-d2d7-d792-4abf-31cb8506110a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:69626b63-d2d7-d792-4abf-31cb8506110a
msgctxt "h267ea171g1ca7g4ab2g8a4bg3c472e6a9ff0"
msgid "Hey, uh, Henk, I think we ordered the -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 69da4289-437a-5fc5-af5a-4a98f1a3caa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:69da4289-437a-5fc5-af5a-4a98f1a3caa9
msgctxt "h44acc40cga8f5g4e26g9a0agab8a64a364f8"
msgid "Speak for yourself! I'm being very good indeed."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 6ae7de2c-6155-6592-f586-cc72f06e064c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6ae7de2c-6155-6592-f586-cc72f06e064c
msgctxt "he177585fgbc9ag4cd4gaa04g0309f364ecf2"
msgid ""
"I fear death. They say the gods will claim us in the afterlife, but there's "
"no guarantee."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 6b50a0d7-fe81-6df9-95ed-041b0e50521e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6b50a0d7-fe81-6df9-95ed-041b0e50521e
msgctxt "hef1deb79gf31cg4f39g937ag5d9d53139e8a"
msgid ""
"No. Particularly not for sinners like us. But if push comes to shove, I'll "
"meet you in the City of Judgement. We'll paint it red."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 6d749775-c971-f15c-0107-8d4fbb504507
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6d749775-c971-f15c-0107-8d4fbb504507
msgctxt "hda0ad970g2b28g4934g885dg80c5de999736"
msgid "So! You're an <i>adventurer</i>, right? How's that going?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 6debfeb4-8208-a666-937e-4d88290a39a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6debfeb4-8208-a666-937e-4d88290a39a8
msgctxt "h5b6a62fcg8973g432ag9b52g44e6bcb2b1b6"
msgid "Tea."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 6e92f6b9-3e81-666e-f739-025007f54d09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6e92f6b9-3e81-666e-f739-025007f54d09
msgctxt "hacfd5421g7676g4579g9910g3153869cd936"
msgid ""
"You know, it does. There's always a bit of a veil about you - I guess it's "
"the magic, but there's something else, too. Something I want to discover "
"first-hand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 6ea5a962-4f21-4a3c-bef0-e6435f8b1114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6ea5a962-4f21-4a3c-bef0-e6435f8b1114
msgctxt "hed212a68gd27eg4579g9738g5274a499ef04"
msgid ""
"Give me a beat to run ahead - I want to make sure everything's absolutely "
"perfect. See you there!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 6fc140d3-cc11-aff8-979c-a65963ddb8a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:6fc140d3-cc11-aff8-979c-a65963ddb8a9
msgctxt "hd0ae5e80gd29ag413cg9b0bga4cda838c505"
msgid "So, where did you grow up?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 7043ae57-7629-0572-1ff9-157665b9e5dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:7043ae57-7629-0572-1ff9-157665b9e5dc
msgctxt "h3456a174g71f6g498dg84b5g50f8d07d2e66"
msgid "Blamed it on an imp and never told a soul the truth. Beat that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 7293e992-f324-4389-65bd-6a268fdfb7ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:7293e992-f324-4389-65bd-6a268fdfb7ce
msgctxt "hd3923b31g840cg42efg9600gf8fb129b133a"
msgid "That means going after the things I love. Including you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 72e591b7-44a9-2c93-70f2-91381edaf3c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:72e591b7-44a9-2c93-70f2-91381edaf3c6
msgctxt "h8fa521b1gf9e0g4d91g9f96gf124af2d82f5"
msgid "...and two glasses of wine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 730005d5-55c6-513f-624f-56f045cbde59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:730005d5-55c6-513f-624f-56f045cbde59
msgctxt "hff30d950g11cfg47ecg9c93gdb6bdd4edb50"
msgid ""
"Everything about you is new to me, honey. You're the first gith I've met, "
"sure, but you're also singular in the world for so many other reasons."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 74557989-d94e-54a0-31c4-1f8367a78cc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:74557989-d94e-54a0-31c4-1f8367a78cc9
msgctxt "had7ba7c5gd7cfg48fcg89d7gc3c908e3dbbd"
msgid "Looks like I need to find a more active way to entertain you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 756fd211-4dc8-1917-b7fe-3fe8e9e05590
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:756fd211-4dc8-1917-b7fe-3fe8e9e05590
msgctxt "he24679fbg52c0g42e4g9093g3ba0065067a0"
msgid "What is it?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 7986bcb1-54fc-1bb0-b878-acf92eec8eb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:7986bcb1-54fc-1bb0-b878-acf92eec8eb5
msgctxt "h93d020a4g1313g4810gb338g98656ae67c56"
msgid "Thank you - so do you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 7a800b65-6ad2-20c8-953a-6a007d064243
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:7a800b65-6ad2-20c8-953a-6a007d064243
msgctxt "hb69397a7g52c4g4340gafbagfff8ba1554c5"
msgid "I think I should say goodnight here, Karlach."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Tender Honk
#. NodeID = 8018dea8-047a-f048-6c4d-34684e021cd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8018dea8-047a-f048-6c4d-34684e021cd7
msgctxt "h41d0d282g3e7ag47eeg9de0gcd44c939970a"
msgid "<i>Jablooda.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 8067e756-722c-ee81-2026-916ea16b5506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8067e756-722c-ee81-2026-916ea16b5506
msgctxt "h81e43234g31eag4682g9bf0gd5effc14802a"
msgid "Tell me a secret."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 80935ac6-51a4-5b10-bfcb-f6da881634a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:80935ac6-51a4-5b10-bfcb-f6da881634a5
msgctxt "h0d3401e6gabf8g496egac07g56bc8595f890"
msgid "You're right. What should we do?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 844d2312-1f64-0edf-c878-b53ea7abdceb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:844d2312-1f64-0edf-c878-b53ea7abdceb
msgctxt "h636e66dag712bg4d18ga519g3821f0159917"
msgid "We were poorer than dirt, but my gods we had fun. What about you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 863fae4a-10eb-adb5-a2c8-bb8c800977df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:863fae4a-10eb-adb5-a2c8-bb8c800977df
msgctxt "h85781387g3e84g4310gbd32g1735c692ce61"
msgid "Right you are."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 8680ce70-e5ba-138d-b30b-b8497996a59b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8680ce70-e5ba-138d-b30b-b8497996a59b
msgctxt "hfa26d4f7g9119g4437g8cb1g03ea9995854e"
msgid ""
"You're right. Small talk is for small people. And we loom large. But still - "
"first date. So let's make with the first-dating."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 895ff74c-ef2e-6af2-9378-6af13ec2d453
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:895ff74c-ef2e-6af2-9378-6af13ec2d453
msgctxt "h6679abecg9d23g4b16g8151g0d4d42d7ee42"
msgid ""
"Yeah, I'm very sure. I'd ask for a real secret, but I suppose besides the "
"whole <i>child of Bhaal</i> thing, you've always been an open book."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 8a366efb-3e78-a4f5-9d21-f76e5c004dad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8a366efb-3e78-a4f5-9d21-f76e5c004dad
msgctxt "hefe4facag1c3fg4140gb8f8g3966f137117b"
msgid ""
"Yes! Amazing. Put on your least bloody tunic and meet me back here. Eee, I'm "
"so excited!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 8b4eb565-223e-2ba5-69ed-2c16ccb52765
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8b4eb565-223e-2ba5-69ed-2c16ccb52765
msgctxt "h0df690fag5becg46d2g962dg966d6ac23dcb"
msgid "True! Then let's say you... brought me to my knees."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 8bccc7c6-2aa2-8f59-02df-cfd57e823aa3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8bccc7c6-2aa2-8f59-02df-cfd57e823aa3
msgctxt "h7a04ffbag3827g41b6g9230g22ab43bbdfc3"
msgid "I just need a little while to prepare."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 8c4a5079-5af1-c71b-0aca-b57d914eca7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8c4a5079-5af1-c71b-0aca-b57d914eca7c
msgctxt "ha93932a7g1d9ag408fg92f1g00a73eab9c11"
msgid ""
"No! Yes. No - we came to have a nice date, and that's what we're going to "
"do. Go on: date me. I dare you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 8ca83413-d351-f898-0b05-cb9e5754e173
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8ca83413-d351-f898-0b05-cb9e5754e173
msgctxt "haa25d68bg339ag4297g9719g82b203c21a3d"
msgid ""
"Pretty straightforward: kill the monsters, save the townsfolk, bish bash "
"bosh."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 8edd2cea-83eb-0181-858d-251f749b3c07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8edd2cea-83eb-0181-858d-251f749b3c07
msgctxt "hfc5438acg8ce7g4e18ga2f2g85be96acb911"
msgid ""
"I still dream of my old master sometimes. I don't know if I'll ever be rid "
"of him."
msgstr "아직도 가끔은 내 옛 주인 꿈을 꾸곤 해. 언제쯤 되어야 떨쳐낼지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 8f04d57d-125f-7251-3ec2-889a34d9a37d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8f04d57d-125f-7251-3ec2-889a34d9a37d
msgctxt "h57ba2fa2ga5e9g4e32ga407g26574f370e68"
msgid ""
"A little inn in the city - the Singing Lute, it's called. If it's anything "
"like it used to be, we'll have the place all to ourselves."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 8f55283f-5e6f-a363-54b2-5f1fd280a146
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:8f55283f-5e6f-a363-54b2-5f1fd280a146
msgctxt "hd92f2a67ge48cg4c56g901cg0a33ea7746c8"
msgid ""
"I get it. I didn't mean to overstep. There's just so much I want to do in "
"the little time I have left."
msgstr "알겠어. 선 넘을 생각은 없었어. 얼마 남지 않은 시간 동안 하고 싶은 것들이 너무 많거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 923f168f-05de-856a-f7f8-28f4d307eda2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:923f168f-05de-856a-f7f8-28f4d307eda2
msgctxt "h88ff1f44g3ee8g48c3gb1f0g91122f7b4098"
msgid "You read my mind."
msgstr "내 말이 그 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 92f209fa-1d8f-35df-04d5-9edfa3b2efea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:92f209fa-1d8f-35df-04d5-9edfa3b2efea
msgctxt "ha7ba3a38g3bebg4c9cg8c69gc69c080008ab"
msgid "They'll be fine, I promise."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 93c83761-ee86-7213-5ef3-af19dedf8fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:93c83761-ee86-7213-5ef3-af19dedf8fc6
msgctxt "hf2a32d1bgd6bcg4b91gb2e6g114e96d94b28"
msgid "Don't keep me waiting too long!"
msgstr "나 너무 오래 기다리게 하지는 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 946ab2ad-75f9-7007-22ee-acbc9b105028
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:946ab2ad-75f9-7007-22ee-acbc9b105028
msgctxt "h2d46d2bfg85a4g4784ga9c4ga7d293c3cae7"
msgid "Myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 9737771d-c984-30ae-19a2-4ae804ff92c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:9737771d-c984-30ae-19a2-4ae804ff92c5
msgctxt "hf2f93dd0g2b85g43f1ga1f2ge4043fb3e0ad"
msgid "Not my good kirtle!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 9749a3f4-5d12-0b18-ab89-3d1995d3d66b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:9749a3f4-5d12-0b18-ab89-3d1995d3d66b
msgctxt "hbd9676a9g4dfcg4842g93c5g6a55206b1c5a"
msgid "No problem. So, what's something you've never told anyone before?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 99c0e602-9792-f105-7425-844f3fe3af17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:99c0e602-9792-f105-7425-844f3fe3af17
msgctxt "h6754c3ccg1cb9g4e87g8eb6gfc57c87058f5"
msgid "I need another minute."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 9aaebe45-7fa9-5e85-09e5-9978627bd038
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:9aaebe45-7fa9-5e85-09e5-9978627bd038
msgctxt "h34a2e24bg9da4g404bg8fc0g9c5796c1d843"
msgid "All right, try this on for size: what's your biggest fear?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 9c112eec-da7c-c441-4d7f-f0b65427cf97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:9c112eec-da7c-c441-4d7f-f0b65427cf97
msgctxt "h1986d9d8gc7a7g40abg9579g131ebaa7108d"
msgid ""
"I know what you mean. Changing is hard. Every time I think I've figured it "
"out, boom, there I am again, behaving like some version of me that never "
"learned a damn thing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = 9c322bf7-e619-8b3d-b7f4-7f723d843689
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:9c322bf7-e619-8b3d-b7f4-7f723d843689
msgctxt "h211d1558g4b03g4ac1ga431gb5529a3fb6e3"
msgid "May we live every day like it's our last."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = 9e8d7035-4f23-3e6a-8d6d-c0812b22b134
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Karlach_State_WentToDate(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:9e8d7035-4f23-3e6a-8d6d-c0812b22b134
msgctxt "h2b4906a0gc9c3g4467gbddbg339d8e4cef05"
msgid "Let's go."
msgstr "가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = a277fee5-af96-3def-2b2d-87c85e983b26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:a277fee5-af96-3def-2b2d-87c85e983b26
msgctxt "ha3ab1287g3e08g4792gb7b3gd52d407fca32"
msgid ""
"Honestly, I don't like to talk about my past. I'm far more interested in our "
"future."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = a3d69c5e-6c8b-6e74-1ecd-b437d6b9b5fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:a3d69c5e-6c8b-6e74-1ecd-b437d6b9b5fd
msgctxt "h46b03614g3ed1g49adga502ge04100eaa09b"
msgid ""
"You don't have to explain, if you don't want to. But whatever time I have "
"left, I'd like to spend getting to know you, exactly as you are."
msgstr "설명하기 싫으면 안 해도 돼. 하지만 내게 남은 시간이 얼마든, 난 그 시간을 너를 알아가는 데 쓰고 싶어. 바로 너처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = a5c9724d-40e6-5adf-4076-a1fe48c1f5bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:a5c9724d-40e6-5adf-4076-a1fe48c1f5bc
msgctxt "h40682ac9ge91ag4528gb4ecg23b34d9a2b54"
msgid "I don't think I could knock you off your feet if I tried."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
