#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:8770b81a-5b22-dc02-ce75-2041bb3705e5
msgctxt "h5823e810g6426g46dbgb47dg74926b27aec0"
msgid "You misunderstand - I don't care about him at all."
msgstr "오해했구나. 난 걔는 아무런 관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 8770b81a-5b22-dc02-ce75-2041bb3705e5
