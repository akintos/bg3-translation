msgctxt "h58f199dbg3d4dg4c90g8b18gdc07e5725a78"
msgid "Oh. Was it?"
msgstr "아, 그렇게 컸나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
#. NodeID = 6a8650ec-0466-bb6d-4208-3fd36fc44b4b
