msgctxt "h1bb1aab0g6d87g4b11gb1a3g010f0305799f"
msgid "Did I see you drinking ale?"
msgstr "너 방금 에일주 마신 거 같은데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = 7a2015ab-8f71-b750-e206-5cae159ebb1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - a59bb4ec-5906-2106-1d28-bcd4c8bdc8f0_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:7a2015ab-8f71-b750-e206-5cae159ebb1a
msgctxt "h5bee457eg4c0fg446cg9111g606fe54ca6ea"
msgid "How many of those have you had?"
msgstr "대체 몇 잔이나 마셔댄 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
#. NodeID = 7cb3ee84-6ec3-6d05-67cc-83c63c3a0aec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a59bb4ec-5906-2106-1d28-bcd4c8bdc8f0_B = True
#. SetFlags:
#.   Local:
#.     - a59bb4ec-5906-2106-1d28-bcd4c8bdc8f0_C = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:7cb3ee84-6ec3-6d05-67cc-83c63c3a0aec
msgctxt "ha016485fg95bbg40d7g881dg23c1e8694c90"
msgid "You could stand to relax a bit, mate."
msgstr "너도 조금은 느긋이 풀어져 봐, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
#. NodeID = 7ddb87ef-a017-3f1b-d155-b945bdd31d15
#. HandlePath = TaggedText[0].TagText[0]
