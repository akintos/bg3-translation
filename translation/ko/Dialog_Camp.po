msgctxt "h5ec4431cgbdeag49a3gb9a8g335750d1baff"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = 631f0f2b-c31a-0f43-6dec-2b7986f8c649
#. HandlePath = TaggedText[0].TagText[0]
