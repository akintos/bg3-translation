msgctxt "h7cb052d9g5aeeg4832g8df8g7f1aee7d6800"
msgid "Too much honey-wine can do that. You should watch yourself."
msgstr "꿀와인을 너무 많이 마시면 그럴 수 있어. 조심하는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = c379a6ae-7832-d699-b1b2-99f3fb6346ba
#. HandlePath = TaggedText[0].TagText[0]
