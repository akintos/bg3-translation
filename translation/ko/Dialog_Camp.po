msgctxt "h9f698051gc015g4993g8deag72054eb4ab45"
msgid "You know what I want to do."
msgstr "내가 뭘 하고 싶은지 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = b424b337-15a4-630b-1686-00c8cb920a0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:b424b337-15a4-630b-1686-00c8cb920a0b
msgctxt "h66b94806g5ec8g430eg8628gb7ee26c38eea"
msgid ""
"It's all I can do to keep my hands to myself, anyway. We're terrible at this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = b52e47ec-4e83-1629-6f01-d3d40441ef00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:b52e47ec-4e83-1629-6f01-d3d40441ef00
msgctxt "h2f32f2e9gf535g46ddg93b6g875f13a21cd3"
msgid "Yes, we can. Together."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Player
#. NodeID = b596038d-1c65-7b37-d077-5b7a355369a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:b596038d-1c65-7b37-d077-5b7a355369a9
msgctxt "h47f08024gba2bg4261gb65fg436f8ca39ca8"
msgid "Wine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Tender Henk
#. NodeID = b662ed9d-af28-d9fe-1e72-72ea511f1442
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
