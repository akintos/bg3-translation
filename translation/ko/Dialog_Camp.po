msgctxt "h25a90a18gd134g4affga154g4a083c7dc90f"
msgid "Oh - thank you. That's... that's nice."
msgstr "아아... 고마워. 기분이... 참 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
