msgctxt "h5bfa499eg6334g4212gb9b3g7bc5fad02e80"
msgid "Yes! More wine! "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Zae
#. NodeID = c65ed698-1b82-426f-fc1f-f6fdcd61b100
