#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 0145de00-a405-6c22-dd9a-6009fbf51e47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0145de00-a405-6c22-dd9a-6009fbf51e47
msgctxt "h241006ffg07d7g4bc5g8b8egfc474b22116b"
msgid "*Your head tingles. Memories flow through your mind, seeking escape.*"
msgstr "*머리가 욱신거립니다. 기억이 탈출구를 찾으며 마음속을 흐릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 0180c949-dd0b-3aea-835b-a4c0efbfa77e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0180c949-dd0b-3aea-835b-a4c0efbfa77e
msgctxt "hbd7094bag5d58g452cg8b5aga1cd5b35d0b9"
msgid "There's nothing to forgive. You only wanted to protect the city."
msgstr "용서할 게 뭐가 있겠어요. 도시를 지키고 싶으셨던 것뿐이잖아요. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 026117e3-d0d7-7c91-5b70-90d67ba3ee11
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_ComWyllSpoke = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:026117e3-d0d7-7c91-5b70-90d67ba3ee11
msgctxt "hbd7b7fc7gc7bdg489agbf47g5c594735001e"
msgid "It isn't what you think. It never was."
msgstr "오해입니다. 절대 그렇지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 02f2d30d-b265-ee4e-41c1-6b19fdac0337
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:02f2d30d-b265-ee4e-41c1-6b19fdac0337
msgctxt "hd5d78ab8g9509g4449g925age04e547c8207"
msgid ""
"Ansur was a myth, father. I will be the one to defeat the Absolute - and the "
"city will hail me as a Grand Duke."
msgstr "안수르는 신화였어요, 아버지. 절대자는 제가 무찌르겠습니다. 그러면 도시는 저를 대공으로 환영해 주겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 03aa274c-2c9a-f840-f060-2ebca7164d8f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_LeftWyrmConvoEarl = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:03aa274c-2c9a-f840-f060-2ebca7164d8f
msgctxt "hc4a73785gac55g4cf9ga3bdg9219191b3565"
msgid "Go on."
msgstr "계속하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 04a3e5fb-3da4-d36a-8b81-d71dba805252
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:04a3e5fb-3da4-d36a-8b81-d71dba805252
msgctxt "h8d54b5d9ge4f2g4fe3g95d0g6995e598dd47"
msgid ""
"Then try again. Tell her I'm safe, tell her my mind is freed. I swear to "
"you, she will listen."
msgstr "그럼 다시 해보게. 내가 안전하다고, 내 정신이 자유로워졌다고 말해주게. 틀림없이 들을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 05418083-879d-5f39-2dec-238945e7f228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:05418083-879d-5f39-2dec-238945e7f228
msgctxt "hf348a94fg3bddg4bcbg971bg516eaa993695"
msgid "I don't understand."
msgstr "이해가 안 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Minsc
#. NodeID = 0545f8e3-a137-da42-890e-456518504550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0545f8e3-a137-da42-890e-456518504550
msgctxt "h3f7000b1g05a3g4066gaeb6g875173f23ad2"
msgid "Duke Wyll Ravengard!"
msgstr "윌 레이븐가드 공작!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 05b780c5-ad93-c33c-b04c-e316d3cb108d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:05b780c5-ad93-c33c-b04c-e316d3cb108d
msgctxt "h73acab59gb6beg492cg8b27g0b5466e29ab2"
msgid "There will be no Grand Duke Wyll Ravengard."
msgstr "그렇다면 윌 레이븐가드 대공은 없을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 0626e0ca-48cb-f7d0-3ec4-da69f1777e5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0626e0ca-48cb-f7d0-3ec4-da69f1777e5e
msgctxt "h7d692df4gf1f4g4556g8833g99c8f732aeb0"
msgid "Well, the rest goes without saying."
msgstr "음, 나머지는 말할 필요도 없겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 06f0e5f4-3df5-4783-1bca-3609633ad013
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:06f0e5f4-3df5-4783-1bca-3609633ad013
msgctxt "h419d9a74g41d9g4649gac5fgc608c7a9edf1"
msgid ""
"I, too, have been touched by Avernus, my boy. A tale for other places, other "
"days."
msgstr "나 역시 아베르누스의 손길에 더럽혀졌다, 아들아. 이 얘긴 다른 날, 다른 곳에서 하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 08656bd0-750b-3a07-be20-efeeb33e7258
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfFrontiers = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:08656bd0-750b-3a07-be20-efeeb33e7258
msgctxt "ha74c38adg2ad3g458bga81eg979971546476"
msgid "I trust you, Wyll. Follow your heart, wherever it leads."
msgstr "널 믿어, 윌. 마음이 이끄는 대로 가도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 08d56706-47ff-e48a-df6b-5700f2efe085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:08d56706-47ff-e48a-df6b-5700f2efe085
msgctxt "he8fbceebgcc73g4d78g849ag61a7bf08c433"
msgid ""
"I fought to right the wrongs of the Coast, to slay the men and monsters that "
"hunt the helpless."
msgstr "난 소드 코스트의 잘못을 바로잡고, 힘없는 자들을 사냥하는 인간과 괴물을 처치하기 위해 싸웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 0a442417-1d47-a9d1-5db2-b42d8bc1ab16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0a442417-1d47-a9d1-5db2-b42d8bc1ab16
msgctxt "h647f3cb3gac5bg4801g82a8g4b4763d9da13"
msgid "*Ravengard's tadpole clenches as Wyll's memories flow into him.*"
msgstr "*윌의 기억이 레이븐가드에게 흘러들어오자, 올챙이가 꿈틀거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 0acbd44a-3e37-6123-e17b-05c278f73438
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0acbd44a-3e37-6123-e17b-05c278f73438
msgctxt "h35674a74g58f1g4153gbc7dg5d0045844dc0"
msgid "So the bastard's gone? A shame I never... <i>ngh</i>..."
msgstr "그 개자식이 죽었다고? 내가 직접 못한 게... <i>으윽</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 0af29cb1-066c-94e2-2716-2094c499a9a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_WyrmRockPrison_State_FlorrickEscaped = False
#.      - WYR_WyrmRockPrison_Florrick_Event_TookQuest = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0af29cb1-066c-94e2-2716-2094c499a9a9
msgctxt "h5ea61602ge801g4deega81agbcc0e2f842b1"
msgid "I'll go to Wyrm's Rock and take her to safety."
msgstr "고룡 바위로 가서 그녀를 안전하게 데려오겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 0cff9178-e51b-d285-3a90-43a493e4690f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0cff9178-e51b-d285-3a90-43a493e4690f
msgctxt "hd057aa28g62b6g420agaf0agf9aa0662f114"
msgid ""
"You are a hero, not an aristocrat. The Blade is a champion. 'Duke Wyll "
"Ravengard' is not."
msgstr "넌 영웅이지 귀족이 아니야. 변경의 칼날은 투사이지만 '윌 레이븐가드 공작'은 그렇지 않지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 0dbc9f44-faba-b848-b593-e9fae1326cbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0dbc9f44-faba-b848-b593-e9fae1326cbd
msgctxt "h109d0d59gd565g4a84g82f2g5e83f74e1dc0"
msgid "So you do. And I thought you'd abandoned them, more fool me."
msgstr "그랬었지. 네가 그 교훈들을 저버린 줄 알았단다. 면목이 없구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 0dc9c06f-03b4-e8c6-21f5-8b04c5208481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0dc9c06f-03b4-e8c6-21f5-8b04c5208481
msgctxt "h4e84b73bgecdbg4ef8g9752g707c27f32d01"
msgid ""
"I have been touched by Avernus, been a plaything for demons. A tale for "
"other places, other days."
msgstr "나 역시 아베르누스의 손에 더럽혀졌네, 데몬의 장난감이 되었지. 이 얘긴 다른 날, 다른 곳에서 하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 0e1f4fe5-3eab-db83-776c-c2db43db3222
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Wyll = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Ravengard_Event_WyllDefeatedHasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0e1f4fe5-3eab-db83-776c-c2db43db3222
msgctxt "hc957e65dg9d0bg41bdg9f33g7683eba77104"
msgid "*Your mind intertwines with Ravengard's, then disentangles.*"
msgstr "*당신의 정신이 레이븐가드의 정신과 서로 얽혔다가, 풀어집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 0e828def-99e8-f465-d870-261357b68527
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfAvernus = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:0e828def-99e8-f465-d870-261357b68527
msgctxt "h430eda74gb626g4517g9d97g12bfdce711e5"
msgid ""
"The devil's stench lingers. But Wyll is yet a champion of the people. I had "
"hoped he'd join me on the Council, but - he is his own man. I couldn't be "
"prouder."
msgstr ""
"데빌의 악취는 여전히 가시지 않았지만, 그래도 윌은 여전히 민중의 투사다. 나와 평의회에 함께 하길 바랐건만, 자신의 길을 가려고 "
"하는군. 이보다 더 자랑스러울 수 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1111ac6c-480b-8ef6-b66d-9bbf177010a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#.   Tag:
#.      - AVATAR(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1111ac6c-480b-8ef6-b66d-9bbf177010a0
msgctxt "hbcb247f3g0ee0g4fceg90f8g3b88e8bd1438"
msgid ""
"I had hoped you'd join me on the Council - but the Blade's spirit is "
"indomitable. You are destined for greatness."
msgstr "네가 평의회에서 나와 함께하길 바랐지만, 칼날의 정신을 꺾을 수가 없군. 넌 위대해질 운명이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1111ac6c-480b-8ef6-b66d-9bbf177010a0
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#.   Tag:
#.      - AVATAR(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1111ac6c-480b-8ef6-b66d-9bbf177010a0
msgctxt "hf45991eeg7e95g44a3g8a3bg41597da9ff92"
msgid ""
"I had hoped Wyll would join me on the Council - but the Blade's spirit is "
"indomitable. He is destined for greatness."
msgstr "윌이 평의회에서 나와 함께하길 바랐지만, 칼날의 정신을 꺾을 수가 없군. 윌은 위대해질 운명이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 13ccc468-0ea3-3044-6db1-12d02a29a6f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:13ccc468-0ea3-3044-6db1-12d02a29a6f8
msgctxt "hf356c077g739cg49a0gaf9fgcbff1d57fa2d"
msgid ""
"My son, you sold your soul to save Baldur's Gate - and I cast you out for it."
msgstr "아들아, 발더스 게이트를 위해 네 영혼을 거래하다니... 그럼에도 난 널 내쫓았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = The Emperor
#. NodeID = 15ee8907-6b5b-d57a-0036-7abaafc20d6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:15ee8907-6b5b-d57a-0036-7abaafc20d6a
msgctxt "h6e4b6301g0d8eg4e31g8e34gaa629bd671f9"
msgid "<i>How misguided you are.</i>"
msgstr "<i>이 어찌나 어리석은 판단인지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 16db0fee-1bd9-1f2c-4239-da61e67677be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_Event_LeftWyrmConvoEarl = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_HasMetWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:16db0fee-1bd9-1f2c-4239-da61e67677be
msgctxt "h98f0c739g3d48g4c78g9b8eg2e625c0e9d07"
msgid "We must act. I know a way to purge the Absolute from the city."
msgstr "행동해야 해. 도시에서 절대자를 쓸어버릴 방법을 알고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 1722dbd8-8c7f-f72a-00ed-c41b58d1e766
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1722dbd8-8c7f-f72a-00ed-c41b58d1e766
msgctxt "hb675c802ga999g4556g9681gbfacaeb26ada"
msgid "You exiled me from my own home. I can't forgive you."
msgstr "저를 집에서 내쫓으셨잖아요. 용서할 수 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1789664e-c0ba-5ffd-94e9-3b04fc92fbca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1789664e-c0ba-5ffd-94e9-3b04fc92fbca
msgctxt "hf7511cafgedd0g4426g8e6fg435c6b315016"
msgid "To start with, a reckoning."
msgstr "청산부터 시작해야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 17ad9814-9a29-2e8b-999e-63d075668444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:17ad9814-9a29-2e8b-999e-63d075668444
msgctxt "hf90f9d5fg1ebbg41e4ga350gc591358ee362"
msgid "I sacrificed my soul to save yours. I had no choice."
msgstr "아버지를 구하기 위해서 제 영혼을 희생했어요. 선택의 여지가 없었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 18905556-255f-6a8c-4d23-5a788d1f8e03
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:18905556-255f-6a8c-4d23-5a788d1f8e03
msgctxt "hb49112c9g65f1g4f1cga8ffg2c7e4fb675d5"
msgid "Father, Ansur is fallen."
msgstr "아버지, 안수르가 죽었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Minsc
#. NodeID = 18e7e49c-818c-0bfd-61df-8195c0011533
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:18e7e49c-818c-0bfd-61df-8195c0011533
msgctxt "hb08512f9g42dfg412agbad5g8796dc82d7ff"
msgid "The Blade of Frontiers!"
msgstr "변경의 칼날!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1a07e503-7674-867e-da93-28aa1ccc1f01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1a07e503-7674-867e-da93-28aa1ccc1f01
msgctxt "h88704d9ag9fabg40e3gb8afg223edaa67177"
msgid "Bring me my son. I must speak with him."
msgstr "내 아들을 데려오게. 꼭 할 얘기가 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1a519a23-580a-e356-6add-61133b9705b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_Event_RavengardWyrmwayQuest = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1a519a23-580a-e356-6add-61133b9705b3
msgctxt "h053509c1g7a1dg418dga039g614ff220d7ad"
msgid "Hail, my boy."
msgstr "만세, 나의 아들. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1aab2eb6-efab-adcc-06cb-54e2d2ef5ff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1aab2eb6-efab-adcc-06cb-54e2d2ef5ff1
msgctxt "ha9804a58g0a0cg4e36gb50fg9996ab7395f2"
msgid "But what, Wyll?"
msgstr "하지만 무엇이냐, 윌?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 1b500513-30cd-f711-a508-f2dd11ef80d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_WyrmRockPrison_State_FlorrickEscaped = True
#.      - GLO_Florrick_State_PermaDefeated = False
#.   Object:
#.      - CAMP_Ravengard_Event_ToldFlorrickFreed(2) = False
#.      - CAMP_Ravengard_Event_AskedToFreeFlorrick(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_ToldFlorrickFreed(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1b500513-30cd-f711-a508-f2dd11ef80d1
msgctxt "h2c743cadg5bc0g47f6gaaabg59781ee9104f"
msgid "Florrick is free. She's gathering allies as we speak."
msgstr "플로릭이 풀려났어요. 지금 이 순간에도 아군을 모으고 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1b55024c-51a0-fc04-3d95-c67e3f3c72fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1b55024c-51a0-fc04-3d95-c67e3f3c72fd
msgctxt "hfc2b08e9g2d6ag43b2g9026gea03f604e52c"
msgid ""
"My own son, still the she-devil's toy. Is this my fate - to be freed from "
"Gortash's hell only to be trapped in yours?"
msgstr "내 아들은 여전히 그 데빌 여자의 놀잇감이다. 이것이 내 운명이냐? 고타쉬의 지옥에서 풀려나 네가 만든 지옥에 갇히는 게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1bcf97a3-b1a6-2d6c-c694-799d339af871
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1bcf97a3-b1a6-2d6c-c694-799d339af871
msgctxt "h32ef2234g821ag4c2eg8e8ag6f2a9f519a3e"
msgid "I understand. I'm not sure I can forgive myself."
msgstr "이해한다. 나도 내 자신을 용서할 수 있을지 모르겠구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 1daa5084-5e3e-3f03-1c1d-8c5f9f43d3a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1daa5084-5e3e-3f03-1c1d-8c5f9f43d3a2
msgctxt "h443f0d1bg8578g4887g99e1g94d0c2e9c8db"
msgid "*The world spins as Ravengard's dizziness flows into you.*"
msgstr "*레이븐가드의 어지러움이 당신에게 흘러 들어오자, 세상이 빙글빙글 돌기 시작합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 1db3403c-4bbb-4a3f-5d95-213df0332c27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1db3403c-4bbb-4a3f-5d95-213df0332c27
msgctxt "hd20c391eg9691g4803g8a4dge8c404fbbfcc"
msgid "<i>Refuse the Emperor and tell Ravengard to trust you.</i>"
msgstr "<i>황제를 거부하고 레이븐가드에게 당신을 믿으라고 말한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1e5c935e-44ff-a7a1-5cc5-d21925076d1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1e5c935e-44ff-a7a1-5cc5-d21925076d1e
msgctxt "hc6ec7e26g335eg4ccaga987g9c25b103fc36"
msgid "Then I pray that time mends the rift between us."
msgstr "그렇다면 시간이 우리 사이의 균열을 치유해 주길 기도하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 1e6df963-053e-c2b0-0a2b-a0f3ae949a4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1e6df963-053e-c2b0-0a2b-a0f3ae949a4c
msgctxt "h0d40a72ege523g493ag9151ge8e9e7d413d1"
msgid ""
"A bronze dragon, yes. He sleeps beneath us even now, awaiting a hero to "
"rouse him."
msgstr "그래, 브론즈 드래곤 말이네. 지금도 우리 발밑에 잠든 채 영웅을 기다리고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 1f97a4a9-2d4a-b2f5-0f1a-efa2526e796b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = True
#.   Tag:
#.      - REALLY_KARLACH(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:1f97a4a9-2d4a-b2f5-0f1a-efa2526e796b
msgctxt "hbb86b7begb948g4fa1gb0b4gcd29eff51177"
msgid "Gortash is done for. It was not a pleasant end for him."
msgstr "고타쉬는 끝났어요. 그에게 유쾌한 결말은 아니었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 20db6dcf-4b7f-fe97-1504-c275ae4d63ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_WyllDecision = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:20db6dcf-4b7f-fe97-1504-c275ae4d63ee
msgctxt "h388871c3ga021g42dag98d5g5949efa391bf"
msgid ""
"*Uncertainty fills the air. Wyll has reached a fork in his path. In which "
"direction will he travel?*"
msgstr "*불확실성이 가득합니다. 윌은 갈림길에 섰습니다. 어느 방향으로 가게 될까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 21c854af-0cee-79ec-3017-1347185a856f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:21c854af-0cee-79ec-3017-1347185a856f
msgctxt "h81961941g363dg4c03gb4c2ge264c4086ff9"
msgid ""
"I had hoped Wyll would join me on the Council - but the Blade's spirit is "
"indomitable. He is destined for greatness."
msgstr "윌이 평의회에서 나와 함께하길 바랐지만, 칼날의 정신을 꺾을 수가 없군. 윌은 위대해질 운명이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 229f6342-269a-639b-f1e1-283c97fa29b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_HasMetWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:229f6342-269a-639b-f1e1-283c97fa29b9
msgctxt "h7b7a46ccg909bg41d2gbe45g466437b40907"
msgid ""
"*Wyll's tadpole resonates with Ravengard's. The exhausted Grand Duke is a "
"flurry of emotion - gratitude and relief, anger and deep pain.*"
msgstr "*윌의 올챙이가 레이븐가드의 올챙이와 공명합니다. 지친 대공은 감사와 안도, 분노와 깊은 고통의 소용돌이에 휩싸입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 23962954-74c7-89f6-95af-4ec34a02b2f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Ravengard_Event_HasMet_Final(2) = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:23962954-74c7-89f6-95af-4ec34a02b2f4
msgctxt "h891ee0f2g54f6g41a0gad08ga501f4f2d825"
msgid "I have faith in Wyll. He is a conqueror - as are you."
msgstr "윌을 믿네. 윌은 정복자이고, 자네도 마찬가지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 239c3fc5-06e1-c559-9d69-a02c43258c71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:239c3fc5-06e1-c559-9d69-a02c43258c71
msgctxt "h32aac9deg7b05g4d71g8cfeg3204c6f71c33"
msgid ""
"*When evil's shadow darkened the Sword Coast, you brought your light. You "
"are the people's protector. To fell monsters and guard the meek is your "
"calling.*"
msgstr ""
"*악의 그림자가 소드 코스트를 어둠으로 뒤덮었을 때, 당신은 빛을 가져왔습니다. 당신은 사람들의 수호자입니다. 괴물을 쓰러뜨리고 평범한 "
"자들을 지키는 것이 당신의 소명입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 253f30e1-a020-3cd8-000b-c3b82558d7be
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:253f30e1-a020-3cd8-000b-c3b82558d7be
msgctxt "h5f5a1e63g0279g4bd7g814dg4f1f040c5973"
msgid ""
"There's nothing to forgive. You wanted to protect the city. I only ever "
"wanted the same."
msgstr "용서랄 게 없는걸요. 아버지는 도시를 지켜내려 하셨고, 저도 같은 걸 바랐을 뿐이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 254f502b-5de1-fe45-f845-f3512a993e63
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:254f502b-5de1-fe45-f845-f3512a993e63
msgctxt "h80b867e0gfc6dg4d2dg83a7g9bfd94f17f59"
msgid "Father, please - there's something I must show you."
msgstr "아버지, 제발... 보여드리고 싶은 게 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 26638e22-d761-89fa-8410-d3aaa96699f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:26638e22-d761-89fa-8410-d3aaa96699f3
msgctxt "h7e954ae0g6adfg4e83ga815g8987dc1c1139"
msgid ""
"*Wyll's courage and enthusiasm warms the air. With him at your side, the "
"road ahead doesn't look so insurmountable.*"
msgstr "*윌의 용기와 열정이 공기를 따뜻하게 합니다. 그와 함께라면, 앞으로의 여정이 그리 험난해 보이지는 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 29351ef9-b839-5d80-3df0-9a7f7f4d9f05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:29351ef9-b839-5d80-3df0-9a7f7f4d9f05
msgctxt "hbc526f7fg931eg4c10g81f7ga02544274091"
msgid "I am Ulder Ravengard! I will not stand by while... <i>ngh</i>..."
msgstr "난 얼더 레이븐가드다! 나는 두고만 보지 않을 것이... <i>으윽</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 2ab234a5-98f2-bf6f-5b4b-ab9576da97de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2ab234a5-98f2-bf6f-5b4b-ab9576da97de
msgctxt "hcdb3c9f7g7ce0g4de3ga84cge78809610fe4"
msgid ""
"*Your tadpole resonates with your father's. The exhausted Grand Duke is a "
"flurry of emotion - gratitude and relief, anger and deep pain.*"
msgstr "*당신의 올챙이가 아버지의 것과 공명합니다. 지친 대공은 감사와 안도, 분노와 깊은 고통의 소용돌이에 휩싸입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 2b50f697-1f31-5a26-f65b-11b6ed36a703
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2b50f697-1f31-5a26-f65b-11b6ed36a703
msgctxt "h9962e9abg456dg4243g96edgd65a5d9209d2"
msgid "*Your father waits expectantly. It is time he knows your chosen path.*"
msgstr "*아버지가 기다리고 있습니다. 당신이 선택한 길을 알려드려야 할 시간입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 2b5ab555-9f7c-ab0c-27a0-c7557bbd1579
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Florrick_State_PermaDefeated = False
#.   Object:
#.      - CAMP_Ravengard_Event_AskedToFreeFlorrick(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2b5ab555-9f7c-ab0c-27a0-c7557bbd1579
msgctxt "hd6046550g421fg428egbe4cgf608a0a01966"
msgid "Counsellor Florrick will be relieved to hear that you're all right."
msgstr "당신이 무사하다는 소식을 들으면 플로릭이 안심하겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2bf25629-08a3-6989-da9f-0c2796a48eba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Ravengard_Event_WyllDefeatedHasMet(2) = True
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Wyll = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2bf25629-08a3-6989-da9f-0c2796a48eba
msgctxt "h1d8f1cf3g7d3dg4683gac3cgc0414b888d14"
msgid "Bring Wyll to me."
msgstr "윌을 데려오게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2cbe990d-450a-820a-97eb-b539b5d4b89f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2cbe990d-450a-820a-97eb-b539b5d4b89f
msgctxt "h0392097fg3b66g4f01gb3b1geedfbb5ced59"
msgid ""
"She was more than an ally. She was a friend, a confidante, a blessing to our "
"family. She deserved a better fate than death."
msgstr "그녀는 동료 이상이었다. 친구이자, 진실한 벗이자, 우리 가족에게는 축복이었지. 죽음보다 더 나은 운명을 누릴 자격이 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2cbe990d-450a-820a-97eb-b539b5d4b89f
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2cbe990d-450a-820a-97eb-b539b5d4b89f
msgctxt "hbe470490g9348g48cag8e1dgd65d1f3ee535"
msgid "My own family was never so true. She deserved a better fate than death."
msgstr "그녀는 내 가족보다도 더 진실했지. 죽음보다 더 나은 운명을 누릴 자격이 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Karlach
#. NodeID = 2d46227b-c1a9-1063-66ed-b7bb0655f6d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2d46227b-c1a9-1063-66ed-b7bb0655f6d5
msgctxt "hadc50bf1gdf05g40beg9204g7e1b7cee56b1"
msgid "The Blade of Frontiers!"
msgstr "변경의 칼날!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2dbc519f-9f1b-1113-eef6-ed4229120110
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2dbc519f-9f1b-1113-eef6-ed4229120110
msgctxt "h7376db9fg9fcdg493bg8890g0d5c22719d9c"
msgid ""
"The legend has it that Ansur will only answer to a proven hero of the city. "
"Until a moment ago, I thought that was me."
msgstr "안수르는 도시의 영웅임을 증명한 자에게만 대답한다는 전설이 있지. 조금 전까지만 해도, 그게 나라고 생각했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2ddd66c5-7838-c7df-9b7f-320c8476e196
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2ddd66c5-7838-c7df-9b7f-320c8476e196
msgctxt "hf5760fbag46ccg4f47gb683ge1dd97181e52"
msgid "But it is true - you are still under the she-devil's thumb..."
msgstr "하지만 네가 아직도 그 데빌 여자의 손아귀에 있는 것은 사실이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2e81752b-334b-2462-305f-1bb4780051c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2e81752b-334b-2462-305f-1bb4780051c3
msgctxt "hdbbbb867g3c22g40c9ga3f6g09a617626ca4"
msgid ""
"May the city know the truth of my only son. Pride of Ravengard, pride of "
"Baldur's Gate."
msgstr "나의 하나뿐인 아들의 진실을 발더스 게이트가 알게 되길. 레이븐가드의 긍지, 발더스 게이트의 긍지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2eac246a-c37c-95fc-a72a-0db4a8cbd5fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Ravengard_Event_HasMet_Final(2) = True
#.   Tag:
#.      - AVATAR(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2eac246a-c37c-95fc-a72a-0db4a8cbd5fe
msgctxt "h0a4f0415gfe53g435fg8b82g662e59719f5d"
msgid "Hail!"
msgstr "만세!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 2ee3225d-4d27-ad77-0aa2-129250217195
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2ee3225d-4d27-ad77-0aa2-129250217195
msgctxt "h025d309cg0fc9g4260gb10eg9c7c8ed491d2"
msgid "*Your father's tadpole clenches as your memories flow into him.*"
msgstr "*당신의 기억이 홍수처럼 밀려들면서 아버지의 올챙이가 꿈틀거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 2feeb5b9-b4fd-9c6a-5eb5-52d436239063
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:2feeb5b9-b4fd-9c6a-5eb5-52d436239063
msgctxt "hfbf71433g1a6fg4b5cg8d4fg36d71ef86c86"
msgid ""
"I didn't despair because the city has a secret guardian, a wyrm that sleeps "
"beneath. He can be called upon in times of great need."
msgstr "하지만 도시의 비밀 수호자, 즉 지하에 잠들어 있는 고룡이 있었기에 그리 염려하진 않았네. 필요한 순간에 나타나 주리라 믿었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 309308d8-fc97-f107-21f6-1fb51912a39f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_HasMetWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:309308d8-fc97-f107-21f6-1fb51912a39f
msgctxt "hf9e57e84g3c23g4a0cga84cg778db485cad1"
msgid ""
"- my duty is first and foremost to the city and its people. There's "
"something I must ask of you."
msgstr "내겐 도시와 시민들을 지켜야 할 의무가 있다. 그래서 꼭 부탁할 것이 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 3138b74c-f7e7-f868-473a-94612ce6765d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:3138b74c-f7e7-f868-473a-94612ce6765d
msgctxt "h53c30e64gb535g4914ga965ge872c6eea33f"
msgid ""
"In Ansur's defeat, I've found my spirit renewed. For as long as devils and "
"demons imperil the Sword Coast, they will by my prey."
msgstr ""
"안수르를 처치하면서 제 영혼이 다시 새로워지는 것을 느꼈어요. 데빌과 데몬이 소드 코스트를 위협하는 한, 전 그들을 사냥할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 314729a6-33d9-fa10-199a-ecf55a9b3a25
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:314729a6-33d9-fa10-199a-ecf55a9b3a25
msgctxt "h40ed4704g0f2fg48acg9956gce8d173b4547"
msgid ""
"Ansur was a pile of bones. It's up to us to save the city from the "
"Absolute's wrath."
msgstr "안수르는 뼈만 남아 있었어요. 절대자의 분노로부터 도시를 구하는 건 우리에게 달렸어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 328803d8-fce3-a45c-1c6e-a92270b1340a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:328803d8-fce3-a45c-1c6e-a92270b1340a
msgctxt "h20e62b44gf5a1g459agaf1fg918b61ec3a8c"
msgid "Hells, Florrick..."
msgstr "젠장, 플로릭..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 32d7c4bf-3110-2091-7e3b-daca302faa70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:32d7c4bf-3110-2091-7e3b-daca302faa70
msgctxt "h5de8828eg1094g431cg931bg02c2f0e8bfa5"
msgid ""
"Is this my fate - to rise from death into a hell of my own boy's making?"
msgstr "이것이 내 운명이냐? 죽음에서 일어나 내 아들이 만든 지옥으로 가는 게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 33596245-cb11-f1c0-05dd-49f6e8ab8e56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:33596245-cb11-f1c0-05dd-49f6e8ab8e56
msgctxt "h54b6156ag6cddg42bcgbb88g53007d1dbca7"
msgid "I'll make sure he gets what's coming to him."
msgstr "그가 반드시 대가를 치르도록 할게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 33f572bc-a11c-822d-f35e-c17613271ab1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:33f572bc-a11c-822d-f35e-c17613271ab1
msgctxt "h57ba88fbg0ccbg47eagb190gc8ead56faa7c"
msgid "You gave yourself to the Hells' eternal fires so I might walk free."
msgstr "넌 날 자유롭게 하려고 지옥의 영원한 불길에 네 자신을 바쳤다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 34420ab4-060b-6a5b-86f7-93bc1e264d6a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_LeftWyrmConvoEarl = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:34420ab4-060b-6a5b-86f7-93bc1e264d6a
msgctxt "h36936446gf8e9g4ebcg8a93g0933ccfdff19"
msgid "Go on."
msgstr "계속하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 344d9d23-1d53-1509-760e-54c66d8eed93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:344d9d23-1d53-1509-760e-54c66d8eed93
msgctxt "h34dd4f55gb323g4aa3ga252gbf996d28890e"
msgid ""
"Godsdamned Gortash - he'll suffer for this. I'll drive Balduran's sword "
"straight through his belly."
msgstr "빌어먹을 고타쉬, 이 일은 꼭 갚아주마. 발더란의 검으로 배를 꿰뚫어 버릴 테다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 346c46a1-e9f0-0db8-e1f1-648b3b7edfab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:346c46a1-e9f0-0db8-e1f1-648b3b7edfab
msgctxt "hbbee9c63gce39g4c7cg9122gc5e9b300cbb4"
msgid "Hail the Blade of Frontiers!"
msgstr "변경의 칼날 만세!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 350d3ede-a981-6a05-d067-48716910ebf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(2) = False
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:350d3ede-a981-6a05-d067-48716910ebf7
msgctxt "h197e0e78g3f26g4530g9db4gcb6f312e0f2b"
msgid ""
"The Blade of Frontiers is dead. I will be Wyll Ravengard, proud Duke of "
"Baldur's Gate."
msgstr "변경의 칼날은 죽었어요. 저는 윌 레이븐가드, 발더스 게이트의 자랑스러운 공작이 될 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 352705fa-ebaa-13b3-2311-8e8731f43cee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:352705fa-ebaa-13b3-2311-8e8731f43cee
msgctxt "hb78f9d9dgfb42g46b1g925bgc746f28b05e5"
msgid ""
"I will defeat the Absolute and defend this great city. You have my word."
msgstr "절대자를 물리치고 이 위대한 도시를 지키겠습니다. 약속하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 3541074e-fe08-516b-1ef5-3d25765990df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfAvernus = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:3541074e-fe08-516b-1ef5-3d25765990df
msgctxt "hb7420ca8g371ag479cga197g312165e6bd41"
msgid ""
"The devil's stench lingers, my son. But you are yet a champion of the "
"people. I had hoped you'd join me on the Council, but - you are your own "
"man. I couldn't be prouder."
msgstr ""
"데빌의 악취가 아직 남아있구나, 아들아. 그래도 넌 여전히 민중의 투사다. 나와 평의회에 함께 하길 바랐건만, 너만의 길을 가려고 "
"하는구나. 이보다 더 자랑스러울 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 371dee74-86e8-019e-050a-6a1bb0a9f407
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:371dee74-86e8-019e-050a-6a1bb0a9f407
msgctxt "h8587cec2gc02eg4ef0g8c3ag41858deeb197"
msgid ""
"I am no aristocrat. Call me the Blade of Avernus, hunter of fiends and foul "
"beasts."
msgstr "전 귀족이 아니에요. 악마와 사악한 짐승을 사냥하는 아베르누스의 칼날로 불러주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 390ec300-e0db-d6a2-2081-c81fba3d525a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:390ec300-e0db-d6a2-2081-c81fba3d525a
msgctxt "h5910d6ecg5e88g4ae0gaa1ag452c4d600790"
msgid "Grand Duke? My soul lies with the city. But..."
msgstr "대공이라고요? 제 영혼은 도시를 위한 것이긴 하지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 391c0c00-09c7-701e-47b7-a715a996cbae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:391c0c00-09c7-701e-47b7-a715a996cbae
msgctxt "h4dc42646g0e08g46c7g9ac6g05886debb4b8"
msgid ""
"A Grand Duke? You can't turn down an offer like that. Think of the power "
"you'll yield."
msgstr "대공? 그런 제안을 거절할 순 없지. 네가 누리게 될 권력을 생각해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 397e8590-c5cf-2f95-5b9c-a997e2afb49e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:397e8590-c5cf-2f95-5b9c-a997e2afb49e
msgctxt "h3e91a631g02b1g4c04g885fg8e0fcc469387"
msgid ""
"Nor should you. The self is the sum of its experiences. You are the man you "
"are because of them."
msgstr "하지 않아도 된다. 우리 자신은 우리가 한 경험이 쌓여서 만들어지는 것이니까. 그 경험들이 있기에 지금의 네가 된 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 3a231479-65e2-4fa6-6fe0-03f16a0d36e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:3a231479-65e2-4fa6-6fe0-03f16a0d36e1
msgctxt "hd1d362dfg1d74g4e3ag9163g9d8ce2d61457"
msgid ""
"This place is touched by the infernal. I can smell the she-devil. I can "
"smell my son."
msgstr "이곳은 지옥의 손길이 닿은 곳이군. 데빌 여자의 냄새가 나. 내 아들의 냄새도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 3a5e62e0-3d67-f857-dffd-d2f2b2e8ee1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:3a5e62e0-3d67-f857-dffd-d2f2b2e8ee1d
msgctxt "h6afe4ee6g7b80g48afgb26fg1bed30888114"
msgid "Please. You're staking the city's future on a fairy tale."
msgstr "말도 안 돼요. 그런 동화 같은 얘기에 도시의 미래를 걸다니요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 3b4e4097-4117-69b2-2d7d-41e414677bc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:3b4e4097-4117-69b2-2d7d-41e414677bc0
msgctxt "h9473eb83g0e54g48a5g9e1bg4e803322d4bc"
msgid "A great warrior knows when to contain the storm and when to release it."
msgstr "위대한 전사는 폭풍을 잠재울 때와 일으킬 때를 아는 법이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 3b645618-f4db-7c66-f67c-7824e039b342
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:3b645618-f4db-7c66-f67c-7824e039b342
msgctxt "hb5d04165g5625g438dg9a64g62ec5dafe2ae"
msgid "Become a Grand Duke. Imagine the power you'll yield."
msgstr "대공이 되는 거야. 네가 누릴 권력을 상상해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 3e314216-e3eb-efe8-a180-387268ea4cfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:3e314216-e3eb-efe8-a180-387268ea4cfe
msgctxt "hb048804fgdc2cg43d6g8795gd47c1f395a42"
msgid "I don't save cities for free."
msgstr "공짜로 도시를 구하지는 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 404c99c0-4891-4101-d4ec-6451c06070db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:404c99c0-4891-4101-d4ec-6451c06070db
msgctxt "h6ceb550fg1406g449egbfa9g56645cca6105"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = The Emperor
#. NodeID = 407d071c-8f41-e686-f282-1a3c3ac7ba93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:407d071c-8f41-e686-f282-1a3c3ac7ba93
#, fuzzy
msgctxt "h32ef085dg7bc3g4ed7gbdeega2dfcd3a0493"
msgid ""
"<i>You both know you owe your lives to me. I am not fallen - I am risen.</i>"
msgstr "<i>너희 둘 다 내게 목숨을 빚졌단 사실을 모르지 않겠지. 난 일리시드로 추락한 게 아니라, 일어선 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 41198a68-e2e1-0f3b-4ec8-ca7098bdaf98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:41198a68-e2e1-0f3b-4ec8-ca7098bdaf98
msgctxt "he71088e1g5166g4163g83cegd825203dd2d7"
msgid "<i>I am the Blade of Frontiers!</i>"
msgstr "<i>나는 변경의 칼날이다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 4128b695-92d3-3396-5647-4efb7766a9f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = False
#.      - GLO_Wyll_State_BladeOfFrontiers = False
#.      - GLO_Wyll_State_BladeOfAvernus = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4128b695-92d3-3396-5647-4efb7766a9f4
msgctxt "h20dd23a0ge624g4897g8e06g9af879188db5"
msgid "A wyrm? Are you saying there's a dragon living under the city?"
msgstr "고룡이라고요? 도시 지하에 용이 살고 있다는 말씀입니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 43850442-ba8d-9313-3afe-4cee86ea11a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:43850442-ba8d-9313-3afe-4cee86ea11a6
msgctxt "hf456548agb946g4f6cg9bb4gce52bb7f2499"
msgid ""
"You want my gratitude? Fine - take your fill. But I will <i>not</i> "
"celebrate this infernal resurrection."
msgstr "감사를 원하느냐? 좋다, 마음껏 즐겨라. 하지만 난 이 지옥 같은 부활을 자축하지 <i>않을</i> 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 4653f16d-ebd1-54d7-3a82-fc4bd7232f53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4653f16d-ebd1-54d7-3a82-fc4bd7232f53
msgctxt "h80045b33g5f74g47d4g838cg244e6555dd21"
msgid ""
"But is he who rejects his own child a hero? What of he who calls his brave "
"son a monster?"
msgstr "하지만 자기 자식을 거부한 사람이 영웅일까? 용감한 아들을 괴물이라 부르는 사람은 어떻고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 46ebfdd4-8efc-b2cb-ec5e-9666beb86430
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:46ebfdd4-8efc-b2cb-ec5e-9666beb86430
msgctxt "h121a7a18g1181g47fdg957aga5d6754d6b8d"
msgid ""
"The wyrm is dead, but his spirit lives within me. I am the Hells' nemesis, "
"the Blade of Avernus!"
msgstr "고룡은 죽었지만 그 정신은 제 안에 살아 있어요. 저는 지옥의 적, 아베르누스의 칼날입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 477e747a-60c8-5fec-626a-a6c0c8bd914c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Ravengard_Event_HasMet_Final(2) = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:477e747a-60c8-5fec-626a-a6c0c8bd914c
msgctxt "h44bb41dbgad3eg47ebg85f0gdff44d763a6a"
msgid "I know you will accomplish great deeds. So must we all."
msgstr "네가 위대한 일을 해낼 것이라는 걸 안다. 우리 모두도 마찬가지다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 47847e78-999d-090b-cdeb-0951d39d322d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Florrick_State_PermaDefeated = False
#.   Object:
#.      - CAMP_Ravengard_Event_AskedToFreeFlorrick(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:47847e78-999d-090b-cdeb-0951d39d322d
msgctxt "h78004477g24f0g4da0g8f5cgcaa1a2fe8596"
msgid "If only Florrick - oh hells, Florrick!"
msgstr "플로릭이 있었다면... 오 이런, 플로릭!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 47e7796f-4c36-08d8-3147-1dafa0bc9d8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:47e7796f-4c36-08d8-3147-1dafa0bc9d8e
msgctxt "hd6942e92g0bcdg43f4g9799gd8d60a52ed96"
msgid "It isn't what you think, father. It never was."
msgstr "오해입니다, 아버지. 절대 그렇지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 4811e7b7-ad68-6ab1-01e8-a20d95b59722
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4811e7b7-ad68-6ab1-01e8-a20d95b59722
msgctxt "hd088f004gee93g4017g99efg4c05ac28e9cf"
msgid ""
"The Absolute is the greatest threat Baldur's Gate ever faced. The wyrm must "
"be awakened - and the task falls to you."
msgstr "절대자는 발더스 게이트 역사상 가장 큰 위협이야. 고룡을 깨워야 하네. 임무의 성패가 자네 손에 달려 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 49ba21c0-5eb2-2219-27a1-e06ad9bb5da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:49ba21c0-5eb2-2219-27a1-e06ad9bb5da0
msgctxt "hac98210bgf710g49a8gaac0g465346af4ada"
msgid ""
"Dearest Florrick. May your journey to the Fugue Plane be a peaceful one."
msgstr "친애하는 플로릭. 배회 차원으로 가는 길이 평화롭기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 4a631190-8c09-9ccf-0d8b-7ad3aa589220
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4a631190-8c09-9ccf-0d8b-7ad3aa589220
msgctxt "ha9641369g6ec9g4aabg8b2cg5d6d276b7dec"
msgid ""
"I will blaze a path before me and behind me. Justice will prevail in the "
"Sword Coast."
msgstr "저는 제 앞의 길을 뚫고, 제 뒤의 길을 닦겠습니다. 소드 코스트에서 정의가 승리할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 4ae54a21-ebca-8bd5-b9c4-4494ac0cba46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4ae54a21-ebca-8bd5-b9c4-4494ac0cba46
msgctxt "h890edaddga34bg4596g86b0g8e3e36c6b3cf"
msgid ""
"*Ravengard gasps as his thoughts consume yours. He sees <i>everything</i> - "
"the nautiloid journey, the perilous path to Moonrise, the Astral Prism, and "
"the Emperor within.*"
msgstr ""
"*레이븐가드가 당신의 생각을 흡수하며 가쁜 숨을 내쉽니다. 그는 <i>모든 것</i>을 보고 있습니다. 노틸로이드에 얽힌 여정, "
"문라이즈로 향하는 위험한 길, 아스트랄 프리즘과 그 안의 황제까지.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 4b05ae01-6e4c-31e7-1352-ec0b3aca0b55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4b05ae01-6e4c-31e7-1352-ec0b3aca0b55
msgctxt "h29f1217dg20d3g420cgb69fg0c3119ac4ada"
msgid ""
"My son a monster, twisted almost beyond recognition. To think my blood flows "
"through those veins."
msgstr "내 아들이 괴물이 되었군. 알아볼 수 없을 정도야. 내 피가 저 혈관을 통해 흐른다고 생각하니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 4c112b99-9724-8560-3d6c-b2abcff76369
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_TurnedInQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4c112b99-9724-8560-3d6c-b2abcff76369
msgctxt "h3748a2efg9f2fg420cg91d4gc6090889311e"
msgid ""
"A terrible fate for Ansur, my son. Yet my hopes for the city's future have "
"never been higher."
msgstr "안수르는 끔찍한 운명을 맞았군. 하지만 이 도시의 미래에 대한 내 희망은 그 어느 때보다도 높아졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 4c456f11-391d-b402-9e6f-067b5757f619
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_HasMetWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4c456f11-391d-b402-9e6f-067b5757f619
msgctxt "h7ec608a8g67d9g455ega87dg001aee4bf8a6"
msgid "First you cleave my heart in twain. Now you shatter it into pieces."
msgstr "처음엔 내 마음을 둘로 쪼개더니, 이제 조각조각 찢기까지 하는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 4d5f9553-6aeb-f953-2eb8-aa7d0f14fc08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4d5f9553-6aeb-f953-2eb8-aa7d0f14fc08
msgctxt "hdb6cb21bge4ddg44c9gbb4dgd29182c8e085"
msgid ""
"Wyll, Mizora could be a dangerous influence. You can't accept your father's "
"offer."
msgstr "윌, 미조라가 위험한 영향력을 끼칠 수도 있어. 아버지의 제안을 받아들여선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 4eb4d7e9-2f75-c33d-51fc-5a670f3996be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4eb4d7e9-2f75-c33d-51fc-5a670f3996be
msgctxt "h0800d2cagb40cg414eg9f88gd0c039a62bf5"
msgid "What lessons do you mean?"
msgstr "용사의 길이라니 무슨 말씀이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 4f875fb8-328b-e111-5bb7-db3c02975f09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:4f875fb8-328b-e111-5bb7-db3c02975f09
msgctxt "h4c612191g965fg4d53ga9bbg8d467a301de2"
msgid ""
"It's the truth, Ravengard. Wyll has always been a faithful defender of "
"Baldur's Gate."
msgstr "사실입니다, 레이븐가드. 윌은 언제나 발더스 게이트의 충실한 수호자였어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 5099fe35-5682-a353-f8a7-b59d220e8a48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5099fe35-5682-a353-f8a7-b59d220e8a48
msgctxt "h738d5f12g9588g4f06gac57g6e4755379339"
msgid ""
"*A calm settles over you. The elder brain is a menace - but with the Blade "
"of Avernus at your side, you know you can triumph.*"
msgstr "*평온이 찾아옵니다. 엘더 브레인은 위협적이지만, 아베르누스의 칼날과 함께라면 승리할 수 있음을 알고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 517b817c-1de5-ce5e-7e07-ebfaa513513d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:517b817c-1de5-ce5e-7e07-ebfaa513513d
msgctxt "h24f14f2fgefecg4fcbg8352gef88ff69155a"
msgid ""
"You've done so much for me - I can't blame you for refusing. But I hope "
"you'll reconsider."
msgstr "이미 날 위해 많은 걸 해주었기에, 거절한다고 탓할 순 없지. 하지만 다시 생각해 주길 바라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 524cef45-de8e-f6bc-1822-43957143991b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#.   Tag:
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_AnsurNoWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:524cef45-de8e-f6bc-1822-43957143991b
msgctxt "h10266827g2ac4g4b6ag93d5g2c4f7053bdf1"
msgid "Ansur is dead? By the living gods."
msgstr "안수르가 죽었다고? 신이시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 52dad790-8f8f-2b8e-5b45-48158430f5fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:52dad790-8f8f-2b8e-5b45-48158430f5fd
msgctxt "h7bcb1ae2gdb8cg4710gbb93g6261fadfd723"
msgid ""
"We must make this a secret we carry beyond the grave. No name is more sacred "
"to the city than Balduran's. Not even mine."
msgstr "이 사실은 무덤까지 비밀로 간직해야 하네. 이 도시에서 발더란보다 신성한 이름은 없어. 내 이름조차도 거기엔 미치지 못하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 5349a40b-afbd-498e-d62d-a29a66f61ce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5349a40b-afbd-498e-d62d-a29a66f61ce3
msgctxt "h238515dcg0dabg4890gb2b9g9f3d67c255c2"
msgid ""
"You turned your back on me, on your city, to chase the she-devil and her "
"power. She stinks up this place even now."
msgstr "넌 데빌 여자와 그녀의 힘을 쫓기 위해 나와 내 도시에 등을 돌렸다. 그년은 지금도 여기서 악취를 풍기고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 53ebe031-c6b6-09a9-b4ab-dbbb52d5c000
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_Event_RavengardWyrmwayQuest = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:53ebe031-c6b6-09a9-b4ab-dbbb52d5c000
msgctxt "h77cfcb9dg51c5g40b7gbca6gffee2766263a"
msgid "You must awaken Ansur beneath the city, Wyll. Our future depends on it."
msgstr "도시 아래의 안수르를 깨워야 해, 윌. 우리의 미래가 걸린 일이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 54414630-afbc-0a41-0e19-ee476f37436c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_State_KnowsFlorrickDead = False
#.      - PLA_Desire_Event_HasMet = True
#.      - GLO_Florrick_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_State_KnowsFlorrickDead = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:54414630-afbc-0a41-0e19-ee476f37436c
msgctxt "h3307ade1g2642g4b63g82d5g6e9510144c9b"
msgid "Florrick is gone, father. I thought you should know."
msgstr "플로릭은 죽었어요, 아버지. 아셔야 할 것 같아서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 54414630-afbc-0a41-0e19-ee476f37436c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_State_KnowsFlorrickDead = False
#.      - PLA_Desire_Event_HasMet = True
#.      - GLO_Florrick_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_State_KnowsFlorrickDead = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:54414630-afbc-0a41-0e19-ee476f37436c
msgctxt "h2aba74dag95a7g482fgabaege84409042fa4"
msgid "Florrick is gone, Ravengard. I thought you should know."
msgstr "플로릭은 죽었습니다, 레이븐가드. 아셔야 할 것 같아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 54be7f02-8234-99b5-2e6f-51fe70762597
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:54be7f02-8234-99b5-2e6f-51fe70762597
msgctxt "h0bd2eab2g5551g42d1ga127g0923c419de56"
msgid ""
"*A calm settles over you. The elder brain is a menace - but with the Blade "
"of Frontiers at your side, you know you can triumph.*"
msgstr "*평온이 찾아옵니다. 엘더 브레인은 위협적이지만, 변경의 칼날과 함께라면 승리할 수 있음을 알고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 54fc0767-a745-ea1e-aa3d-c1d303da1823
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:54fc0767-a745-ea1e-aa3d-c1d303da1823
msgctxt "h6ae99201gc7bbg4fe5gbe46gab14b14ab949"
msgid ""
"*Your parasites link. Pain splits your head, and you hear a distant voice, a "
"whisper of a memory. It calls for you. <i>All</i> of you...*"
msgstr ""
"*기생충끼리 연결됩니다. 고통이 머리를 쪼개고, 멀리서 기억의 속삭임이 들립니다. 당신을 부르고 있습니다. 당신 <i>모두</i>를...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 54fdbf27-c413-5133-5335-ae76309f3993
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:54fdbf27-c413-5133-5335-ae76309f3993
msgctxt "h2c14a6d6gde30g4509g8024gd84f4f685752"
msgid "I will see it done, father. You have my word."
msgstr "그리하겠습니다, 아버지. 약속드리죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 55d299da-8f78-eafe-2b1b-408f22dcee1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_Event_AnsurNoWyll = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_TurnedInQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:55d299da-8f78-eafe-2b1b-408f22dcee1c
msgctxt "ha6279ce7g6173g4875ga6f0gd9e966c92c76"
msgid "My son, I have heard of Ansur's fate."
msgstr "아들아, 안수르의 운명에 대해 들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 561c1639-5352-2401-b6c5-ce361bf943a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(2) = False
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfFrontiers = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:561c1639-5352-2401-b6c5-ce361bf943a0
msgctxt "hd896efa1g6b9bg4861g962fg0be6b912c1a8"
msgid ""
"I am no aristocrat. I am the Blade of Frontiers, eternal protector of the "
"Sword Coast."
msgstr "전 귀족이 아니에요. 소드 코스트의 영원한 수호자, 변경의 칼날입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 57b53ba0-e327-5ce0-a5a4-a0aa7ff2847f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:57b53ba0-e327-5ce0-a5a4-a0aa7ff2847f
msgctxt "h057eed16g2347g4cf2g84edgcfd737abe154"
msgid "Tremendous news. She proves as loyal to you as she is to me."
msgstr "굉장한 소식이야. 나에게 충성하는 만큼 네게도 충성을 입증하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 583d6231-cf05-3576-f95d-eeb69cd4da96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:583d6231-cf05-3576-f95d-eeb69cd4da96
msgctxt "h5bc9e83eg2ee6g4babgb3f1g060623667b02"
msgid "Your son sacrificed his soul to save yours. He had no choice."
msgstr "당신의 아들은 당신을 위해 영혼을 거래했습니다. 선택의 여지가 없었다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 58c98f62-63e7-f053-6fcc-a9d5f441dc2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:58c98f62-63e7-f053-6fcc-a9d5f441dc2b
msgctxt "h93ac2a8fg255eg4d33ga821g4d3937a182fe"
msgid ""
"Is this my fate - to be freed from Gortash's hell only to be trapped in "
"yours?"
msgstr "이것이 내 운명이냐? 고타쉬의 지옥으로부터 풀려나 네 녀석의 지옥에 갇히는 게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 5965d437-ab4d-c3b3-0f65-76c5a3289c70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5965d437-ab4d-c3b3-0f65-76c5a3289c70
msgctxt "h7631fdf9ga91bg4c8bgbc66g6fe7bdeb02bb"
msgid ""
"Baldur's Gate is my home, and I am its servant. I will be relentless in my "
"pursuit of the greatest good."
msgstr "발더스 게이트는 제 집이고, 제가 섬길 곳입니다. 앞으로 최대의 선을 위해서는 거침없이 행동하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 5a533762-c586-e474-55c4-1d4eb9fc3fc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = True
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5a533762-c586-e474-55c4-1d4eb9fc3fc9
msgctxt "h9bb51efbg4349g4374g8e7bg8b590245eb99"
msgid "Gortash is done for. It was a long time coming."
msgstr "고타쉬는 끝났어요. 오랜 시간이 걸리긴 했지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 5a79a3e9-9623-8ab5-0ee6-2a2d4548064b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5a79a3e9-9623-8ab5-0ee6-2a2d4548064b
msgctxt "h08bd595eg6c41g4581gae7dgba7db3aae2cf"
msgid ""
"The wyrm is dead, father. Where we might have once found a friend, we found "
"only his bones, animated by an old grievance."
msgstr "고룡은 죽었어요, 아버지. 아군을 찾으러 간 자리엔, 오래된 원한만이 남아 그의 뼈를 움직이고 있었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 5bc0c2f2-b0b8-fa0c-fbfe-bb2f6271872d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5bc0c2f2-b0b8-fa0c-fbfe-bb2f6271872d
msgctxt "h5c288e4cgc318g4123g8ee4g5dc76246a041"
msgid ""
"The wyrm is dead, but his spirit lives within me. I've pledged to follow in "
"your footsteps, for the good of the Gate."
msgstr "고룡은 죽었지만 그 정신은 제 안에 살아있어요. 발더스 게이트를 위해 아버지의 발자취를 따르기로 맹세했어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 5ce00fa1-ce22-28b1-eba0-9041678e4a8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5ce00fa1-ce22-28b1-eba0-9041678e4a8c
msgctxt "hd6074e32gb4bdg49f3gbb5dg73371f28125a"
msgid ""
"I couldn't bear it if she died by my command. May the Triad guide her steps."
msgstr "내 명령을 따르다 그녀가 죽었다면 견딜 수 없었을 걸세. 삼선신이 그녀의 발걸음을 인도하길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 5d3ca3fa-597c-61ed-3455-2c3e3df20a78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5d3ca3fa-597c-61ed-3455-2c3e3df20a78
msgctxt "ha7e04d8fg91d4g4806gac3fg7c5c3f583366"
msgid "I <i>know</i> the story."
msgstr "알만 하지, 그 <i>이야기</i>라는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 5d7b8067-6497-89f6-a6c9-0eace13dfdb1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5d7b8067-6497-89f6-a6c9-0eace13dfdb1
msgctxt "h76eb35a5ga172g470bg888cgc231677f11c6"
msgid ""
"The wyrm is dead, but his spirit lives within me. I am the Heart of the "
"Gate, the Blade of Frontiers!"
msgstr "고룡은 죽었지만 그 정신은 제 안에 살아있어요. 제가 발더스 게이트의 심장, 변경의 칼날입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 5e929b2f-bffd-b78b-dd2f-8e9634fa8f76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5e929b2f-bffd-b78b-dd2f-8e9634fa8f76
msgctxt "h32ee1b20ge055g4cadgafdcg22f3c229efcd"
msgid "Wyll."
msgstr "윌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 5f14deee-31cd-7b05-4e36-7f46dab9ce56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5f14deee-31cd-7b05-4e36-7f46dab9ce56
msgctxt "hd1316ea8g250dg448agaaefg4a2747b11541"
msgid "It seems the fate of the city lies in your hands."
msgstr "도시의 운명이 자네 손에 달린 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 5f691437-8197-39c8-0d9b-ebbdecd004ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5f691437-8197-39c8-0d9b-ebbdecd004ce
msgctxt "h175ff9eag1d47g48c0g982dg61d34a083f58"
msgid ""
"I would sooner die by Mizora's hand than let her endanger the city. I'll "
"figure out a way."
msgstr "미조라가 도시를 위험에 빠뜨리게 두느니, 난 차라리 미조라의 손에 죽겠다. 방법을 찾아보마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 5f87ec60-a2b4-d078-45ac-127be82b6cad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5f87ec60-a2b4-d078-45ac-127be82b6cad
msgctxt "h2e57b230g2f52g4e8dga178g7cc5b88be966"
msgid ""
"They cheered as his automatons marched the streets, lauded his tyranny of "
"steel in the interest of security."
msgstr "고타쉬의 기계들이 거리를 행진할 때 손뼉을 치며, 안보를 위한답시고 강철의 폭정에 찬사를 보냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 5fbd7299-c39e-f4c2-8542-5f7b25c45cd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:5fbd7299-c39e-f4c2-8542-5f7b25c45cd6
msgctxt "hc459a1c1g5b9ag46a3gb7eeg632566befae3"
msgid "I'm beginning to think we should have let you drown."
msgstr "그냥 익사하게 두고 올 걸 그랬다는 생각이 드는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 605db3fc-10eb-2cf7-3e55-465cf46c63ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:605db3fc-10eb-2cf7-3e55-465cf46c63ec
msgctxt "hf8ec690dg67b8g466fga2f5ga2471a19055e"
msgid ""
"He promised Balduran he'd protect the city if ever its existence was "
"threatened. But just the once."
msgstr "그는 발더란과 약속했네. 단 한 번에 한해, 도시가 위기에 빠지거든 도시를 보호하겠다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Gale
#. NodeID = 60bfef2f-e3bd-85bc-4cd4-d93d021eefcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:60bfef2f-e3bd-85bc-4cd4-d93d021eefcf
msgctxt "he568c610g2ddbg4a05g9e25g85d326eb0434"
msgid "The Blade of Frontiers!"
msgstr "변경의 칼날!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 62954aef-f572-fad9-a8dd-a58af8627cfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:62954aef-f572-fad9-a8dd-a58af8627cfa
msgctxt "hcc3a59e6g6754g4631gb202g28ccf97c1057"
msgid "Wyll?"
msgstr "윌?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 633f74cc-37f8-63fb-55ff-7c56db832b35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:633f74cc-37f8-63fb-55ff-7c56db832b35
msgctxt "h9cee41cegc284g452fgaa15gc825ec42c21b"
msgid ""
"I saw your mind. That thing's still in me - and there's one in you. I don't "
"understand."
msgstr "자네의 정신을 보았네. 그게 아직 내 안에 있군, 자네 안에도 있고. 이해가 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 64af811c-4001-37bd-501e-34507b2655d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:64af811c-4001-37bd-501e-34507b2655d0
msgctxt "h3005e804g974bg45f1ga057gce87d55d63e4"
msgid "What makes you so sure the people will welcome me as a duke?"
msgstr "사람들이 저를 공작으로 환영할 거라고 어떻게 확신하시는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 67071896-e17e-22f3-cbf6-f025d683094e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:67071896-e17e-22f3-cbf6-f025d683094e
msgctxt "h05dbd40cga5eeg4ee7g9ef6g6b89cdab018c"
msgid "I wasn't planning on going that way, but I'll see what I can do."
msgstr "그쪽으로 가려고 했던 건 아니지만, 한번 알아볼게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 67076b40-cab7-63f2-5648-e4103e6f5921
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:67076b40-cab7-63f2-5648-e4103e6f5921
msgctxt "h92f56dedg48d0g4835ga204g453936234094"
msgid "I've devoted my life to using my power to keep the Sword Coast safe."
msgstr "소드 코스트의 안전을 지키기 위해 제힘을 쓰면서 헌신해 왔어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 675c0794-cfa9-1f56-7d89-9608b23f4d5d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_WyllDecision = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:675c0794-cfa9-1f56-7d89-9608b23f4d5d
msgctxt "ha6bc7b75g20acg43b4g9837g37279c69ad33"
msgid ""
"*Uncertainty fills the air. You have reached a fork in your path. In which "
"direction will you travel?*"
msgstr "*불확실성이 가득합니다. 당신은 갈림길에 섰습니다. 어느 방향으로 가게 될까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 67df48fe-0a1f-d380-51ec-dc4b50edf1c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:67df48fe-0a1f-d380-51ec-dc4b50edf1c2
#, fuzzy
msgctxt "hd217b78cgc539g424dgac6bgb4fbbe7bfd78"
msgid ""
"You will be the one to part the storms and lead the people through. You, not "
"Ansur, are the saviour we need."
msgstr "폭풍을 가르고 사람들을 이끌고 갈 자는 너다. 안수르가 아니라 네가, 우리에게 필요한 구원자다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 6a54b7ad-482b-f860-5139-8efdb4dd4ea4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6a54b7ad-482b-f860-5139-8efdb4dd4ea4
msgctxt "hc0b33477g49d7g4ebeg994dg3c7137ec39f5"
msgid ""
"It is in the wilds that I find my courage, not in the halls of Upper City "
"estates."
msgstr "내 용기는 상부 도시의 저택이 아닌, 야생에서 찾아지지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 6a86ff23-303c-a4a3-32ec-46ee0c51b7c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_Event_AnsurNoWyll = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6a86ff23-303c-a4a3-32ec-46ee0c51b7c0
msgctxt "h767eb021g7b4dg4dcbgbceegbcd04c793978"
msgid "Bring your leader to me, Wyll. I want to speak to both of you."
msgstr "너희 리더를 데려와라, 윌. 셋이 할 얘기가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 6b02c623-a4cc-269b-587b-2acff83104cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6b02c623-a4cc-269b-587b-2acff83104cf
msgctxt "hce9b31adg299fg47f6gbda3g2c61a43a28b1"
msgid ""
"There will be no Grand Duke Wyll Ravengard. And there will be no Blade of "
"Frontiers."
msgstr "윌 레이븐가드 대공은 없을 거야. 변경의 칼날도 마찬가지고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 6b1af640-3245-a881-fdc4-9d09eb4e7c71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6b1af640-3245-a881-fdc4-9d09eb4e7c71
msgctxt "h581bbb9dg4042g4bacga2bcg1a0800f4b90e"
msgid "A wyrm? Are you saying there's a dragon living under the city?"
msgstr "고룡이라고요? 도시 지하에 용이 살고 있다는 말씀입니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 6d40ebc7-5863-d4d9-2d81-9358ba3a774e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6d40ebc7-5863-d4d9-2d81-9358ba3a774e
msgctxt "h1ec73382gb650g4275ga268g640bf1d78069"
msgid ""
"Even before I was infected, the dukes and patriars applauded as Gortash took "
"control."
msgstr "내가 감염되기 전에도, 공작들과 호족들은 고타쉬의 집권에 환호했었네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 6d8d677c-c77f-3b1d-312d-a87ec78f7e8e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6d8d677c-c77f-3b1d-312d-a87ec78f7e8e
msgctxt "ha3c25b2cgec46g433fg955egb331688e140b"
msgid "A wyrm? Are you saying there's a dragon living under the city?"
msgstr "고룡이라고요? 도시 지하에 용이 살고 있다는 말입니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 6ef63b31-7a09-04cc-1964-a4e3e749b7fe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_TurnedInQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6ef63b31-7a09-04cc-1964-a4e3e749b7fe
msgctxt "h6617747agaa94g4b57gaa0cgba669110a87d"
msgid ""
"Do you mean Ansur? The wyrm is dead, father. Where we might have once found "
"a friend, we found only his bones, animated by an old grievance."
msgstr "안수르 말씀이세요? 그 고룡은 죽었어요, 아버지. 한때 친구가 있었던 자리엔 오랜 원한만이 남아 그의 뼈를 조종하고 있었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 6ff472f9-cf2f-13f6-4954-fd39f35173f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:6ff472f9-cf2f-13f6-4954-fd39f35173f6
msgctxt "h9a8fe96cge00bg4be4ga065ga3ec27de257f"
msgid "By Tyr's wounds - I'm in your mind..."
msgstr "티르의 상처여... 네 정신이 느껴진다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 701afca0-dac6-4b33-1f54-a314baf18dee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = False
#.      - GLO_Wyll_State_BladeOfFrontiers = False
#.      - GLO_Wyll_State_BladeOfAvernus = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:701afca0-dac6-4b33-1f54-a314baf18dee
msgctxt "h16c09f8eg3221g4777gbcf4gbd1b079657dd"
msgid "What lessons do you mean?"
msgstr "용사의 길이라니 무슨 말씀이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 706bad88-c908-488b-52a1-1ba9c3e7294c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:706bad88-c908-488b-52a1-1ba9c3e7294c
msgctxt "h2d50697bg5a66g4079g8246g5cb86fceef3e"
msgid "Wouldn't you rather wake the dragon yourself?"
msgstr "직접 용을 깨우시는 게 낫지 않을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 70eaf02d-227a-bea1-e6ff-4cdbde7e7175
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfAvernus = True
#.   Tag:
#.      - AVATAR(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:70eaf02d-227a-bea1-e6ff-4cdbde7e7175
msgctxt "h6f1ed549g0947g4a36ga9e9g56a578676cbd"
msgid ""
"The devil's stench lingers, my son. But you are yet a champion of the "
"people. I had hoped you'd join me on the Council, but - you are your own "
"man. I couldn't be prouder."
msgstr ""
"데빌의 악취가 아직 남아있구나, 아들아. 그래도 넌 여전히 민중의 투사다. 나와 평의회에 함께 하길 바랐건만, 너만의 길을 가려고 "
"하는구나. 이보다 더 자랑스러울 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 70eaf02d-227a-bea1-e6ff-4cdbde7e7175
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfAvernus = True
#.   Tag:
#.      - AVATAR(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:70eaf02d-227a-bea1-e6ff-4cdbde7e7175
msgctxt "h39cfd812g4aa7g493cg92d6g3b0744d5bc55"
msgid ""
"The devil's stench lingers. But Wyll is yet a champion of the people. I had "
"hoped he'd join me on the Council, but - he is his own man. I couldn't be "
"prouder."
msgstr ""
"데빌의 악취는 여전히 가시지 않았지만, 그래도 윌은 여전히 민중의 투사다. 나와 평의회에 함께 하길 바랐건만, 자신의 길을 가려고 "
"하는군. 이보다 더 자랑스러울 수 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 711c864e-b253-29fa-bae0-6099cb8b659b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:711c864e-b253-29fa-bae0-6099cb8b659b
msgctxt "h34a0d2b7g9a54g46ceg96dag6569eae1aaff"
msgid "By the gods, can you ever forgive me?"
msgstr "맙소사, 이런 나를 용서해 주겠느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = The Emperor
#. NodeID = 711ee8f5-0825-65f7-ce1a-dbbcfd0bdad0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:711ee8f5-0825-65f7-ce1a-dbbcfd0bdad0
msgctxt "h3dd37c97ge653g48f8gbc9fg522051cc3b20"
msgid ""
"<i>His mind is his own, but the elder brain touched him deeper than most. He "
"must stay here - he will need time to recover.</i>"
msgstr ""
"<i>그의 정신은 돌아왔지만, 엘더 브레인은 다른 이들보다 더 깊이 그를 감염시켰다. 그는 여기에 남아서 회복할 시간이 필요하다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7132160d-76c5-5ba4-2e5b-b3c6051de242
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_Event_AnsurNoWyll = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7132160d-76c5-5ba4-2e5b-b3c6051de242
msgctxt "h9f819958g3566g40a8g8110gad61bf640195"
msgid "Bring Wyll to me. I want to hear more about Ansur."
msgstr "윌을 데려오게. 안수르에 대해 더 듣고 싶네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 718bdf96-9c7c-1b92-9920-6bb947f8a86a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:718bdf96-9c7c-1b92-9920-6bb947f8a86a
msgctxt "h38a2a5d9g6923g44adga001ga856cfd7e236"
msgid ""
"I went to greet Elturel's High Overseer - only for the archdevil Zariel to "
"drag the city into the Hells."
msgstr "엘투렐의 고위 감독관을 맞이하러 갔었지만, 아크데빌 자리엘이 도시를 지옥으로 끌고 가버렸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 71b7392e-b17d-4e6a-ed1f-b786b7c53f3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:71b7392e-b17d-4e6a-ed1f-b786b7c53f3d
msgctxt "ha6ecca06g0468g4bc4g8517ga5e351922f4e"
msgid "There is <i>always</i> a choice."
msgstr "우린 <i>언제나</i> 선택할 수 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 720ecfee-aa46-40c0-6aac-125319296b4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:720ecfee-aa46-40c0-6aac-125319296b4d
msgctxt "h26ec0ca3ga6bdg4bacga6f6g8ce97429b788"
msgid "I can forgive you. But I can never forget."
msgstr "용서해 드릴 순 있지만, 절대 잊지는 못할 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 729dcdba-bee8-5c10-a1b0-3aa54b9cd50d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:729dcdba-bee8-5c10-a1b0-3aa54b9cd50d
msgctxt "h63ffc0eega9a8g463ega5d1g9222a004433b"
msgid "All too right."
msgstr "그러는 게 좋겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 73b10ae3-eb03-0cc8-3f42-5754ecd47ada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:73b10ae3-eb03-0cc8-3f42-5754ecd47ada
msgctxt "h9314963cg5032g44eagb437gac2ea8f9b75b"
msgid "You know nothing!"
msgstr "아무것도 모르시면서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 742843fd-36f4-9aee-fa3a-b71b1717847a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:742843fd-36f4-9aee-fa3a-b71b1717847a
msgctxt "h1782e34eg60b7g4fa3ga4bbgb4c5a356c6dc"
msgid "There is no wise use of the Hells' powers."
msgstr "지옥의 힘을 현명하게 사용하는 방법은 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 74ac3f28-e9ef-623c-79c2-2c167008e6b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:74ac3f28-e9ef-623c-79c2-2c167008e6b1
msgctxt "hb6da3fb4g0dceg4c85ga6efg80b453bb6db3"
msgid ""
"I was returning from Elturel. My travelling party stopped at an inn - "
"Waukeen's Rest - to lay our heads."
msgstr "엘투렐에서 돌아오는 길이었네. 우리 일행은 와우킨의 쉼터에 휴식차 들렀었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 74fff7d8-d5b3-1fa7-0815-1f1bd13a2cb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:74fff7d8-d5b3-1fa7-0815-1f1bd13a2cb0
msgctxt "h80c76848g38bdg4d2fg9b3ag564d98242971"
msgid "May the Triad guide you."
msgstr "삼선신이 인도해 주시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Karlach
#. NodeID = 75226c17-e82b-2847-6397-322158d4a358
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:75226c17-e82b-2847-6397-322158d4a358
msgctxt "h2608009cg1a79g4867g99a4g0e66614bee62"
msgid "Duke Wyll Ravengard!"
msgstr "윌 레이븐가드 공작!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 75c514ca-d954-a047-a9b5-6eab2efa4d2f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:75c514ca-d954-a047-a9b5-6eab2efa4d2f
msgctxt "h29b48ae3g7991g4c9fga60eg79d111606df8"
msgid ""
"You showed me that you may be the future of Baldur's Gate - and well beyond "
"it."
msgstr "네가 바로 발더스 게이트의 미래이자, 그 이상일 수도 있다는 걸 보여줬다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 75c514ca-d954-a047-a9b5-6eab2efa4d2f
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:75c514ca-d954-a047-a9b5-6eab2efa4d2f
msgctxt "hbdeb8047g4107g4bf6g851egf5d6994c8275"
msgid ""
"You showed me that Wyll may be the future of Baldur's Gate - and well beyond "
"it."
msgstr "자네는 윌이 발더스 게이트의 미래이자, 그 이상일 수도 있다는 걸 보여줬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 75c700dd-d683-5250-6d62-2a1b6f9aa5b1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_WyllWyrmEarly = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:75c700dd-d683-5250-6d62-2a1b6f9aa5b1
msgctxt "h1ad49985g3a2cg46b1g8304g2c1e1a6578e3"
msgid "Let's talk later."
msgstr "나중에 이야기하시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 76a4c55e-fc07-4bc6-fd9b-74e3c4318210
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Wyll = True
#.      - WYR_SkeletalDragon_State_Defeated = True
#.      - CAMP_Ravengard_Event_TurnedInQuest = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:76a4c55e-fc07-4bc6-fd9b-74e3c4318210
msgctxt "h76583973g8003g4a44gb01fg195c97db10a2"
msgid "<i>Tell him about your battle with Ansur.</i>"
msgstr "<i>안수르와의 전투에 대해 이야기한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = The Emperor
#. NodeID = 779274f3-8c6d-05fe-330b-7bad00b0556b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:779274f3-8c6d-05fe-330b-7bad00b0556b
msgctxt "hf1b9c1c0ge0cdg4da9g91f9g6a2b6fcfafd2"
msgid "<i>Relax your mind. I will show him.</i>"
msgstr "<i>마음을 가라앉혀라. 그에게 보여주겠다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7982f416-87a1-441f-2367-0be2ec27789f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_State_KnowsAboutWyrm = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7982f416-87a1-441f-2367-0be2ec27789f
msgctxt "hd1169293ge53bg4749ga57eg669d2cafcdc4"
msgid ""
"This is such a time. You've been trained in the ways of the great champions "
"and proven to be one of them. The wyrm will answer your call. You must seek "
"him out."
msgstr ""
"지금이 바로 그 순간이네. 자네는 위대한 용사가 되는 길을 스스로 익혔으며, 이미 그런 존재나 다름없다는 사실을 증명했네. 고룡은 자네의 "
"부름에 응답할 걸세. 그를 찾아내게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 799412b8-4a02-70fd-6dc9-9a53dfbef47b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:799412b8-4a02-70fd-6dc9-9a53dfbef47b
msgctxt "h4e8e69fdgf676g4219g9439g31aee09ff5c7"
msgid "No more useful than the rotting corpse he'll... <i>ngh</i>..."
msgstr "그놈은 썩는 시체가 되는 것이 가장 유용할... <i>으윽</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 79dc256a-03ed-6b84-ee2e-760610403716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:79dc256a-03ed-6b84-ee2e-760610403716
msgctxt "h2c632307g1e9fg4ae1gb0f8g8adcb54e064d"
msgid ""
"You and your allies slayed the undead terror that was once the great Ansur. "
"You are stronger than even the great wyrm."
msgstr "너와 네 동료들은 한때 위대한 안수르였던 언데드 흉물을 처단했다. 너희는 위대한 고룡보다도 더 강하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7a09da9c-82b6-842b-7bfc-5492a3d1fdcf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7a09da9c-82b6-842b-7bfc-5492a3d1fdcf
msgctxt "h65aff16bg93d0g4706gaf87g333273753ab9"
msgid "Thank you son. You are a gift to the city. If only I'd known it sooner."
msgstr "고맙다, 아들아. 넌 이 도시의 선물 같은 존재구나. 더 일찍 알았더라면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7a09da9c-82b6-842b-7bfc-5492a3d1fdcf
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7a09da9c-82b6-842b-7bfc-5492a3d1fdcf
msgctxt "hf5f4f14dgfe31g44b1gb9d5g81ea11cd5464"
msgid "Thank you. I will be forever in your debt."
msgstr "고맙네. 이 은혜 다 갚지 못할 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7a4e784d-40da-01ac-6f54-fe102b8661ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7a4e784d-40da-01ac-6f54-fe102b8661ca
msgctxt "h79f8a8deg25a3g4960ga377gdd0a811edb43"
msgid "She's... gone? Hells."
msgstr "플로릭이... 죽었다고? 이런."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 7c7be2ad-5455-a394-e512-4708d47c2bff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7c7be2ad-5455-a394-e512-4708d47c2bff
msgctxt "h73135a7cgd926g4ff2gae2bg7e9746de6bb3"
msgid ""
"*A calm settles over you. The elder brain is a menace - but you are the "
"Blade of Frontiers. No abomination is too powerful for you to overcome.*"
msgstr ""
"*평온이 찾아옵니다. 엘더 브레인은 위협적이지만, 당신은 변경의 칼날입니다. 그 어떤 혐오스러운 존재도 정복할 만큼 당신은 강력합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 7c9d1d28-159e-138b-ec12-0765dff4662b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Ravengard_Event_AskedAboutAbduction(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_AskedAboutAbduction(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7c9d1d28-159e-138b-ec12-0765dff4662b
msgctxt "h04e76454gdb6cg41f8gaae7g92f7f1877f81"
msgid "How did the Absolute cultists capture you?"
msgstr "절대자 광신도들에겐 어떻게 붙잡힌 겁니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 7d04a4da-5d60-6b72-e54b-9bad420b9783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7d04a4da-5d60-6b72-e54b-9bad420b9783
msgctxt "h2396e17dgc0c8g468fg820bgd5e1ceb3a970"
msgid ""
"That's a lot to ask. I'll do what I can, but I won't make promises I can't "
"keep."
msgstr "바라는 게 많군요. 할 수 있는 데까지 해보겠지만, 지킬 수 없는 약속은 하지 않겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 7ec3ba5b-3738-5e1b-81b3-afa99390b51d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7ec3ba5b-3738-5e1b-81b3-afa99390b51d
msgctxt "h6191fe94g1573g4f1dg8c0ag06f6accf45df"
msgid ""
"Ansur was a pile of bones. It's up to us to save the city from the "
"Absolute's wrath."
msgstr "안수르는 뼈만 남아 있었어요. 절대자의 분노로부터 도시를 구하는 건 우리에게 달렸어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7ed88476-6388-57ce-4d01-697b5455f242
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7ed88476-6388-57ce-4d01-697b5455f242
msgctxt "hafad0bd9g3c62g4e45gb7bfg97a3493e0e4b"
msgid ""
"By the Hells, my life hinges on a mind flayer's whim, and Baldur's Gate "
"hangs from its talons."
msgstr "맙소사, 내 목숨이 마인드 플레이어의 변덕에 달려있고, 발더스 게이트는 그놈의 발톱에 매달려 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7efbc0bc-fd84-d188-3151-61b04fdfb64f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7efbc0bc-fd84-d188-3151-61b04fdfb64f
msgctxt "h578a95fbg8305g4ac3ga8bcg4cae626d7727"
msgid "Hail Duke Wyll Ravengard!"
msgstr "윌 레이븐가드 공작 만세!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 7faef203-1761-0c4b-2617-0c2e004972bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7faef203-1761-0c4b-2617-0c2e004972bb
msgctxt "h8136163dgaecbg47a2gaabdgca548cfb26bb"
msgid "Heh. I bet you feel like a real bastard right about now."
msgstr "헤. 지금쯤 본인이 개자식처럼 느껴질 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 7fc2f3f7-e0d1-bd4d-9881-bf1a18b1121c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:7fc2f3f7-e0d1-bd4d-9881-bf1a18b1121c
msgctxt "h0dbe9f1fg3e5ag4cd2g9f70g79cea9f68e2a"
msgid ""
"Since then, the city has faced countless threats, but we always overcame. "
"There was never a need to call on the wyrm - until now."
msgstr "이후로 도시는 수많은 위협에 부딪혀 왔지만, 우린 항상 극복해 냈네. 지금까지는 고룡의 도움이 필요하지 않았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 804fdd23-aa23-41c0-aaf8-99043458f33a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:804fdd23-aa23-41c0-aaf8-99043458f33a
msgctxt "hb72fe853ge553g467fg99f6g84882e3831af"
msgid ""
"Courage. Insight. Strategy. Justice. The ones I made you recite every "
"morning. The ones you'll call on in the days to come."
msgstr "용기. 통찰. 전략. 정의. 매일 아침 너에게 읊게 했던 것들이지. 다가올 날에 필요한 것들이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 80660145-cae5-ac64-f286-e28780936669
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:80660145-cae5-ac64-f286-e28780936669
msgctxt "h3fd7cc93g809dg4bd0gab4dgd51fd1b07831"
msgid "Maybe."
msgstr "아마도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 807c40d5-a648-3b75-5f7f-cbac51eca16a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:807c40d5-a648-3b75-5f7f-cbac51eca16a
msgctxt "h8d0d3602g2566g4cf0g8d20g649b60e2a618"
msgid ""
"Ansur was a myth, father. It is up to me to save Baldur's Gate from the "
"Absolute."
msgstr "안수르는 신화였어요, 아버지. 절대자로부터 발더스 게이트를 구하는 건 저한테 달렸어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 809038a0-b0b3-b779-25c3-1d4558536826
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:809038a0-b0b3-b779-25c3-1d4558536826
msgctxt "h1eb914ddgb742g40e4g9c51g576af3953553"
msgid "Let the dragon sleep. I'll deal with the Absolute on my own terms."
msgstr "용은 계속 자게 두고, 제 방식대로 절대자를 상대하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 80ff92f8-f1aa-d800-4311-8a8d501aeda9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_TurnedInQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:80ff92f8-f1aa-d800-4311-8a8d501aeda9
msgctxt "h549857c1g5118g4a7eg9181gf51a4bdc8a22"
msgid ""
"A terrible fate for Ansur, my son. Yet my hopes for the city's future have "
"never been higher."
msgstr "안수르는 끔찍한 운명을 맞았군. 하지만 이 도시의 미래에 대한 내 희망은 그 어느 때보다도 높아졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 81c4fc86-459e-6e23-c8cb-35f0787e60ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:81c4fc86-459e-6e23-c8cb-35f0787e60ce
msgctxt "h1b861ce4g8538g4ad2g9a63g152811d4d345"
msgid ""
"*Baldur's Gate is your home, and you are its servant, relentless in your "
"pursuit of the greatest good.*"
msgstr "*발더스 게이트는 당신의 집이고, 당신은 그 충실한 하인으로서 거침없이 최대의 선을 추구해 나갈 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 81c80843-3daa-3957-df42-7dea24953913
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:81c80843-3daa-3957-df42-7dea24953913
msgctxt "h909fd882g4b8ag47efgaf22g9a0a05f165e1"
msgid ""
"The wyrm is dead, but his spirit lives within me. I am the Hells' nemesis, "
"the Blade of Avernus!"
msgstr "고룡은 죽었지만 그 정신은 제 안에 살아 있어요. 저는 지옥의 적, 아베르누스의 칼날입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 8281a636-b7ea-fb1b-6778-8181bf8cdc27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - WYR_AnsurGhost_State_HasAnsurBook(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8281a636-b7ea-fb1b-6778-8181bf8cdc27
msgctxt "hab832deag7e90g4d8eg9a1dg8657904fb96a"
msgid ""
"There is a tome - 'The Legend of Ansur'. An ancient epic, ill-remembered, "
"dismissed as a mere tale."
msgstr "오래된 고서가 하나 있다네. '안수르의 전설', 기억에서 밀려난 고대 서사시가 단순한 설화로 전락하고 말았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 82febfc3-12ca-2a7e-8e68-6dab4fa2d60c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:82febfc3-12ca-2a7e-8e68-6dab4fa2d60c
msgctxt "h772e5efegcc36g41beg92fag0259d248a03f"
msgid ""
"*Sigh.* Who would I be to question my saviour? Thanks to you, I think my own "
"thoughts and speak my own words."
msgstr "후. 어찌 내 구원자를 의심할 수 있겠나? 자네가 아니었다면, 나는 생각도, 말도 마음대로 할 수 없었을걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 836d66cd-5cf4-2476-33fb-62aead15717a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:836d66cd-5cf4-2476-33fb-62aead15717a
msgctxt "h4edff9b6g2878g448cg8274g455aa67c5055"
msgid "Bring him here. We can talk after."
msgstr "아들을 데려오게. 얘긴 그다음에 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 849332fb-7095-01ea-23d2-57bdf8e4b58d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_AnsurNoWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:849332fb-7095-01ea-23d2-57bdf8e4b58d
msgctxt "h39bdab0ag2e73g466ag9914gb692959ff3a9"
msgid "Can it be? Bring your leader to me. I would speak to you both."
msgstr "그럴 수가? 너희 리더를 데려와라. 셋이 얘기해야겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 84bdc512-d6c2-8f67-11c4-57948065a67c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:84bdc512-d6c2-8f67-11c4-57948065a67c
msgctxt "haba0f999g47bfg49d4g93c0gd7910b7a658b"
msgid ""
"When the people think his name or see his likeness, they must imagine a "
"hero, not a horror."
msgstr "사람들이 그의 이름을 듣거나 그의 초상화를 볼 때, 공포가 아니라 영웅을 떠올리게 해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 86eb86d1-75a8-8aee-78e2-0c264122067f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:86eb86d1-75a8-8aee-78e2-0c264122067f
msgctxt "h00e8a958gd938g4184g8bffg80a0e94a1be6"
msgid ""
"Ansur was a pile of bones. I will defeat the Absolute on my own terms, and "
"become a Grand Duke."
msgstr "안수르는 뼈만 남아 있었어요. 제 방식대로 절대자를 무찌르고 대공이 되겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 883c8e98-4601-bfc3-774b-2f29123ba4b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:883c8e98-4601-bfc3-774b-2f29123ba4b1
msgctxt "h23d9302bg9255g4574g9ffdg48ee6ed00c79"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 88cf6316-d742-e196-9a6f-8db1e9451b2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_Event_RavengardWyrmwayQuest = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:88cf6316-d742-e196-9a6f-8db1e9451b2b
msgctxt "hb76cbdfdg4ce1g4eddgaf0egfa3910080262"
msgid ""
"The Absolute's voice is gone, but I still hear its echoes - reflections of "
"reflections."
msgstr "절대자의 목소리는 사라졌지만, 아직도 그 메아리가 들려오는군. 잔향의 잔향이라고나 할까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 890dc51e-13f8-3e7a-a1a0-2219ab16b380
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Wyll = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:890dc51e-13f8-3e7a-a1a0-2219ab16b380
msgctxt "h49a2b48fg1f90g42f2g8cf1gcbb546d6ece9"
msgid "Bring Wyll to me. I need to speak with him."
msgstr "윌을 데려오게. 아들과 얘기를 나눠야겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 89117970-d33a-a326-2023-bb8a2071a8f4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_LeftWyrmConvoEarl = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:89117970-d33a-a326-2023-bb8a2071a8f4
msgctxt "hcc97c697g67f2g4cf7gb0a4g5621dd38ef0b"
msgid "Let's talk later."
msgstr "나중에 이야기하시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 89338fd2-1580-98f4-ef4a-8a869edf08b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:89338fd2-1580-98f4-ef4a-8a869edf08b6
msgctxt "hd76aea9eg3ebeg40deg91d4g9515950b1987"
msgid ""
"*Baldur's Gate is your home, and you are its servant, relentless in your "
"pursuit of the greatest good. You would sooner die by Mizora's hand than "
"endanger the city.*"
msgstr ""
"*발더스 게이트는 당신의 집이고, 당신은 그 충실한 하인으로서 거침없이 최대의 선을 추구해 나갈 것입니다. 도시를 위험에 빠뜨리느니, "
"차라리 미조라의 손에 죽는 편이 낫습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 8a6e6602-8d99-ac19-3add-812a278f5e02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8a6e6602-8d99-ac19-3add-812a278f5e02
msgctxt "h20cbb1e6gc2a5g4d4dg857ag79474c4e7d41"
msgid "Grand Duke? I look the part of a fiend."
msgstr "대공이라고요? 전 마족처럼 보일 텐데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 8b75d6b0-6cea-023c-627d-04e3400c158e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8b75d6b0-6cea-023c-627d-04e3400c158e
msgctxt "h59d266dcg0e59g4de3g9f19g8e1fb321f854"
msgid ""
"The voice is gone, but I still hear its echoes - reflections of reflections."
msgstr "목소리는 사라졌지만, 그 메아리가 여전히 들리는군. 잔향의 잔향이 남아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 8c42eb1f-ea7f-641b-ec37-cc40c627b97d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8c42eb1f-ea7f-641b-ec37-cc40c627b97d
msgctxt "hf8e5492dg7171g4fe7ga346g73a7a1b3e072"
msgid ""
"A Grand Duke? You can't turn down an offer like that. Think of the power "
"you'll yield."
msgstr "대공? 그런 제안을 거절할 순 없지. 네가 누리게 될 권력을 생각해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 8c798226-bd09-fde5-5861-e658f5b1118e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8c798226-bd09-fde5-5861-e658f5b1118e
msgctxt "he215b061gf588g4bb2g8bbdg1add13350ec9"
msgid "I know the truth."
msgstr "나도 진실을 알고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 8ccb75bb-7ae4-147b-d894-59563953e90a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8ccb75bb-7ae4-147b-d894-59563953e90a
#, fuzzy
msgctxt "h45d1a8a7ge560g407cga890g636f1aeec89c"
msgid ""
"Grand Duke? I look the part of a fiend. A half-devil possesses my very soul."
msgstr "대공이라고요? 마족처럼 생긴 저를요? 하프데빌이 제 영혼을 지배하고 있다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 8dd3ce4b-1b8a-bdc7-c019-df39ee90b256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8dd3ce4b-1b8a-bdc7-c019-df39ee90b256
msgctxt "h1393dde1gb121g485fgbdcegb40dc32845f9"
msgid "Wyll? What do you make of this?"
msgstr "윌? 네 생각은 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 8fdc0107-5d93-e1ed-a20b-efbd0615cb6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:8fdc0107-5d93-e1ed-a20b-efbd0615cb6d
msgctxt "h206b69dfg1cdeg4c47g8558g2daf4674c80e"
msgid ""
"Courage. Insight. Strategy. Justice. These were the lessons my father taught "
"me."
msgstr "용기. 통찰. 전략. 정의. 아버지께서 가르쳐주신 교훈입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 90ba75e8-079c-6130-68a8-55949b99216c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:90ba75e8-079c-6130-68a8-55949b99216c
msgctxt "h340a2a1fg9e50g415egbedfge9bdf10dc028"
msgid ""
"*There is no stopping it: the truth bubbles over, flooding first your mind, "
"then your father's.*"
msgstr "*걷잡을 수 없는, 진실의 거품이 일어 넘치듯 당신의 마음을, 그리고 아버지의 마음을 가득 채웁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 90be1a54-a6e9-5763-5637-88ad78bfd09b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:90be1a54-a6e9-5763-5637-88ad78bfd09b
msgctxt "h1b7f25aage485g45b4ga236ge6afad0f622f"
msgid ""
"First, you will fell the Absolute. Then, we will rebuild Baldur's Gate, we "
"will take back our city - together."
msgstr "우선 절대자를 쓰러뜨리고 난 다음, 우린 발더스 게이트를 재건하고, 도시를 되찾을 것이다. 함께."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 91983f02-8387-08e1-02d0-846ebe297d1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:91983f02-8387-08e1-02d0-846ebe297d1d
msgctxt "h50997be2g149dg4969g968dgd25f56a64671"
msgid ""
"For as long as demons and devils imperil the Sword Coast, they will be my "
"prey."
msgstr "데몬과 데빌이 소드 코스트를 위협하는 한, 그들은 내 사냥감이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 91b34a0c-d788-e51c-dfc0-12f8a86e1399
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:91b34a0c-d788-e51c-dfc0-12f8a86e1399
msgctxt "h480adb4bg8726g4151g885bg098d3426cb04"
msgid "I need Gortash alive. He could prove useful."
msgstr "고타쉬를 살려둬야 해요. 쓸모가 있을지도 모르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 91f78615-d09b-7905-efec-3fe749cf2522
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:91f78615-d09b-7905-efec-3fe749cf2522
msgctxt "ha1497531ga52dg438eg9efbg30746db6286a"
msgid ""
"Florrick's a great friend to our family and the city. She'll make a stalwart "
"ally for you."
msgstr "플로릭은 우리 가족과 도시의 훌륭한 친구야. 그녀는 네게 충실한 동맹이 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 91f78615-d09b-7905-efec-3fe749cf2522
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:91f78615-d09b-7905-efec-3fe749cf2522
msgctxt "h1884c77cg82deg4d02g8662g347102c739ef"
msgid ""
"Florrick's a great friend to me, and a great friend to the city. She'll make "
"a stalwart ally for you."
msgstr "플로릭은 나, 그리고 도시의 훌륭한 친구이네. 그녀는 자네에게 충실한 동맹이 될 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 95a47d1d-0c0c-aba1-9af3-ec34f1609e3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_WyrmRockPrison_State_FlorrickEscaped = False
#.      - WYR_WyrmRockPrison_Florrick_Event_TookQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:95a47d1d-0c0c-aba1-9af3-ec34f1609e3d
msgctxt "h78590248g06a0g4ed9g8c9ag0ecd9a6b04fa"
msgid "I've talked to Florrick already. I'll get her out of that prison."
msgstr "플로릭과는 이미 얘기해 봤어요. 감옥에서 꺼내주겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 96ee6508-9d1c-27f1-2ebb-7c97fb1601fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:96ee6508-9d1c-27f1-2ebb-7c97fb1601fc
msgctxt "h358e4699g45c7g4245g9603g20c0c40c1ad6"
msgid ""
"*The Grand Duke sees Mizora and her infernal sisters. He sees the agony in "
"Wyll's face as an impossible choice is set before him.*"
msgstr "*대공은 미조라와 지옥의 자매들을 봅니다. 그는 불가능한 선택을 앞두고 고통스러워하는 윌의 얼굴을 봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 9759f459-55aa-73e0-c1eb-d63c8d89726c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:9759f459-55aa-73e0-c1eb-d63c8d89726c
msgctxt "ha1bf0bd8g7a4fg4bcegbcb2ge5a27279538e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 978adedc-12b1-e1b1-c810-366a4a89200d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_HasMetWyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:978adedc-12b1-e1b1-c810-366a4a89200d
msgctxt "h54b1d8e6g5a36g4b28g86b0g212c2296f1fe"
msgid ""
"*Your tadpole resonates with Ravengard's. The exhausted Grand Duke is a "
"flurry of emotion - gratitude and relief, anger and deep pain.*"
msgstr "*당신의 올챙이가 레이븐가드의 것과 공명합니다. 지친 대공은 감사와 안도, 분노와 깊은 고통의 소용돌이에 휩싸입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 98044ab1-efca-326e-3f93-a48c172b626d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:98044ab1-efca-326e-3f93-a48c172b626d
msgctxt "h55ab4696gaa3eg4fc2g953dg4237695ebac0"
msgid ""
"I will name you Baldur's Gate's newest Grand Duke of the Council. You will "
"be hailed Heart of the Gate."
msgstr "너를 발더스 게이트의 새로운 대공으로 임명할 것이다. 넌 발더스 게이트의 심장이라 칭송받을 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 987ca986-5367-9220-e325-9c482b519bb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:987ca986-5367-9220-e325-9c482b519bb4
msgctxt "he16995b7g7567g4d48g9964gc2adc02143d5"
msgid ""
"My boy, my blood. Let it be known: the Blade is on the hunt. Feel his sting!"
msgstr "내 아들, 내 핏줄. 모두 들어라, 칼날이 사냥에 나섰다. 따끔한 맛을 보여주마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = 99c712bf-9a85-960a-0b60-fb8534fd6ba4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:99c712bf-9a85-960a-0b60-fb8534fd6ba4
msgctxt "h0f5b6cf6g1dc9g4234ga0cfg0abfe1388bef"
msgid "No, please. Father - let me show you."
msgstr "아니에요, 제발. 아버지... 직접 보여드릴게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 99c89b79-8929-ecb5-4e26-8eae176470cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:99c89b79-8929-ecb5-4e26-8eae176470cb
msgctxt "h04c26d09gbbcag42bfgb4cfg1e63a8365e8d"
msgid ""
"You turned your back on me, on your city, to chase the she-devil and her "
"power. She stinks up this place even now."
msgstr "넌 데빌 여자와 그녀의 힘을 쫓기 위해 나와 내 도시에 등을 돌렸다. 그년은 지금도 여기서 악취를 풍기고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 9a35d66a-519f-2f51-75b6-38c98dce345c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_SkeletalDragon_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:9a35d66a-519f-2f51-75b6-38c98dce345c
msgctxt "hc9e03975g8a8eg4227g8e83gcc03c46e65af"
msgid "<i>Tell your father about the battle with Ansur.</i>"
msgstr "<i>아버지에게 안수르와의 전투에 대해 이야기한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 9beeeafc-39e7-cac4-f057-71942fddf1be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:9beeeafc-39e7-cac4-f057-71942fddf1be
msgctxt "h3892f9e5g91f1g46degbbecg6f88ee5a0317"
msgid ""
"Sit in silence while those cultists enslave my city? I'd rather... <i>ugh!</"
"i> My damned head."
msgstr "저 광신도들이 내 도시를 노예로 만드는 걸 지켜보고만 있으라고? 차라리... <i>으윽!</i> 망할 머리가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = 9c83c55e-615f-a62f-185d-3408844cbcdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:9c83c55e-615f-a62f-185d-3408844cbcdb
msgctxt "h0657ec93g929eg48c5ga243gdc73e02cb78f"
msgid ""
"*Beneath your monstrous skin lives a hero. Some people may fear you, but to "
"protect the Sword Coast is your calling. You cannot turn your back.*"
msgstr ""
"*당신의 괴물 같은 피부 아래에는 영웅이 살고 있습니다. 누군가는 당신을 두려워할지도 모르지만, 소드 코스트를 지키는 것이 당신의 "
"사명입니다. 등을 돌릴 수는 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 9d664f8a-9be7-dff7-9138-6a43979e188a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:9d664f8a-9be7-dff7-9138-6a43979e188a
msgctxt "h124a227dgd222g410ag8ea5gc3ff9c2bfbd9"
msgid "Wyll - you are more valorous than Balduran himself."
msgstr "윌, 너는 발더란보다도 용감하구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = 9e50d328-6974-3a2a-73de-7f6c01ee0a44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:9e50d328-6974-3a2a-73de-7f6c01ee0a44
msgctxt "h254a61c4g44f7g4ddbgbba9g7424c2870278"
msgid ""
"He's already suffering in Bane's hands. A shame, too - he might have been "
"useful."
msgstr "그는 이미 베인의 손아귀에서 고통받고 있어요. 쓸모가 있었을 텐데, 아깝네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = 9e9a64cf-3f4c-47d8-ee81-b415df6757d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:9e9a64cf-3f4c-47d8-ee81-b415df6757d3
msgctxt "h3654671dgbd49g40b1g9460gab71c2354e0b"
msgid "I do. And I should."
msgstr "그렇다네. 그래야 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = a145dc98-93bd-33b4-aceb-6de2030a0ace
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a145dc98-93bd-33b4-aceb-6de2030a0ace
msgctxt "h66432d2dgd86dg44dbga9edgd945244a37a6"
msgid "Let the dragon sleep. We'll deal with the Absolute on our own terms."
msgstr "용은 계속 자게 두고, 우리 방식대로 절대자를 상대하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Karlach
#. NodeID = a245eb0a-8c86-4928-8c70-e4519b98d164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a245eb0a-8c86-4928-8c70-e4519b98d164
msgctxt "h4443c00eg3453g43a5g9607g59d29fe47fef"
msgid "The Blade of Avernus!"
msgstr "아베르누스의 칼날!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = a27960c9-f13d-dd1d-a201-3a3a4daca95e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a27960c9-f13d-dd1d-a201-3a3a4daca95e
msgctxt "h33b5fdf3gc424g42adg8104g5a327fe9cfde"
msgid "Waking a dragon doesn't sound like a good idea."
msgstr "드래곤을 깨우다니 그리 좋은 생각은 아닌 듯합니다만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = a2b3c40c-5384-d588-fbbf-c6d12ff6b73d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a2b3c40c-5384-d588-fbbf-c6d12ff6b73d
msgctxt "h3aa6e1b5g5dcbg4816g9b79g291ea12b7270"
msgid ""
"My son! Together, there is no army we cannot conquer and no wrong we cannot "
"right."
msgstr "아들아! 우리가 함께라면 정복하지 못할 군대가 어디 있겠으며, 바로 잡지 못할 잘못이 어디 있겠느냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = a2eb8cab-7c8a-b686-0be5-6c245ac10f98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a2eb8cab-7c8a-b686-0be5-6c245ac10f98
msgctxt "h46bb4c36gd850g4139g8828g653fba070dc1"
msgid "Wyll pulled you from death's grip, and this is how you thank him?"
msgstr "윌은 당신을 죽음의 손아귀에서 빼냈습니다. 아들의 수고를 이런 식으로 갚으시겠다는 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = a2fc497e-440c-b406-6229-980e85ac9fe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a2fc497e-440c-b406-6229-980e85ac9fe4
msgctxt "h0b20dc28g4074g49b7ga0d0g86dd9c7ca8af"
msgid ""
"Those who would give up the freedom of the people to purchase temporary "
"safety deserve neither power nor liberty."
msgstr "일시적인 안전을 얻으려고 시민의 자유를 포기한 자들은 권력도, 자유도 누릴 자격이 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = a3cf59e5-f698-b9b2-4937-cc36c50521ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a3cf59e5-f698-b9b2-4937-cc36c50521ab
msgctxt "hdd0879bcg46bbg4e2eg9758g8f4392f874c6"
msgid ""
"*The past becomes present. Your father sees you partner with Mizora to "
"defeat Tiamat's cultists before they could lay siege to Baldur's Gate.*"
msgstr ""
"*과거가 현재로 옮겨옵니다. 아버지는 당신이 미조라와 함께 티아마트의 교단이 발더스 게이트를 포위하기 전에 그들을 무찌르는 것을 봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = a44df32d-8b7c-9c38-5bbe-9b56af8154d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a44df32d-8b7c-9c38-5bbe-9b56af8154d1
msgctxt "hd661f06bg58c4g4685g8a2cg2f99be3f0f02"
msgid "<i>I am the Blade of Avernus!</i>"
msgstr "<i>저는 아베르누스의 칼날입니다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = a47fdb07-6a32-e8bf-3c64-c455521c62c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a47fdb07-6a32-e8bf-3c64-c455521c62c7
msgctxt "h407d9a66g030dg4ab3g95a1g1c5cb35f209f"
msgid ""
"You are a better man than most, and a better son than I deserve. I'll yet "
"make amends, but -"
msgstr "넌 사나이 중의 사나이고, 아버지보다 나은 아들이란다. 보답할 길이 까마득하다만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = a4cbc765-979a-8dd5-cd86-b95ebb201196
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_TurnedInQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a4cbc765-979a-8dd5-cd86-b95ebb201196
msgctxt "h624c1006g02f2g41cfga83egaa81b392fe91"
msgid ""
"A terrible fate for Ansur, my son. Yet my hopes for the city's future have "
"never been higher."
msgstr "안수르는 끔찍한 운명을 맞았군. 하지만 이 도시의 미래에 대한 내 희망은 그 어느 때보다도 높아졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = a5541f8f-d479-eec4-912c-ed3113d5d913
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a5541f8f-d479-eec4-912c-ed3113d5d913
msgctxt "h02b86a76g0658g489dgbdf3gfae2b72445ab"
msgid "I failed, father. The wyrm is fallen."
msgstr "실패했습니다, 아버지. 고룡이 쓰러졌어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = a7ecb196-54e8-d292-3da4-63ab7411fc76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a7ecb196-54e8-d292-3da4-63ab7411fc76
msgctxt "h04f1cbd1g339fg4d82g8087g8db1b62714f3"
msgid "Please. You're staking the city's future on a fairy tale."
msgstr "말도 안 돼요. 그런 동화 같은 얘기에 도시의 미래를 걸다니요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = a86ce408-cd7b-3fb4-ff80-f924da81427c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a86ce408-cd7b-3fb4-ff80-f924da81427c
msgctxt "hd2a1ad87g5a38g44d0g847dgf0e4fed0bdd8"
msgid ""
"And may the city know the truth of my only son. Pride of Ravengard, pride of "
"Baldur's Gate."
msgstr "그리고 나의 하나뿐인 아들의 진실을 발더스 게이트가 알게 되길. 레이븐가드의 긍지, 발더스 게이트의 긍지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = a883982b-8746-060c-0064-f72d0f214702
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a883982b-8746-060c-0064-f72d0f214702
msgctxt "h38e34c4bg58e9g4b3fga2e6g65b9dac16129"
msgid ""
"As you say - but not too much later. I know a way to defeat the Absolute. "
"And it lurks in the darkness below the city's streets."
msgstr ""
"자네 뜻대로 하지. 하지만 너무 늦진 말게. 절대자를 무찌를 방법을 알고 있으니. 그 답이 우리 발 아래 어둠 속에 도사리고 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = a9d28b6e-c894-c91c-fc90-4ebf123380c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:a9d28b6e-c894-c91c-fc90-4ebf123380c7
msgctxt "h3efaeb2eg4133g4479gbcadg3598afd5e15b"
msgid "<i>Connect with your father's mind. It's time he knew the truth.</i>"
msgstr "<i>아버지의 정신과 연결한다. 이제 진실을 알려드려야 할 때다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = aa4f2020-48c1-9861-ee66-0f9e90f27bbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:aa4f2020-48c1-9861-ee66-0f9e90f27bbd
msgctxt "hd316f319gb725g4391ga1bag411b12a28c32"
msgid ""
"<i>Call on the parasite, connect with father and son. Ravengard should know "
"the truth.</i>"
msgstr "<i>기생충의 힘으로 아버지와 아들과 연결시킨다. 레이븐가드는 진실을 알아야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = aa85e3f5-bbc9-a312-2e52-e7bb8e15ba6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:aa85e3f5-bbc9-a312-2e52-e7bb8e15ba6a
msgctxt "h9fe4e273gbbcdg4d61g8483gb644e4066adc"
msgid ""
"You showed me the truth. You showed me that <i>I</i> was the one who turned "
"his back."
msgstr "자네가 진실을 보여줬어. <i>내</i>가 바로 아들의 등을 돌린 사람이었다는 것을 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = aae7a187-844d-58f2-8927-2ae7f217c85c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:aae7a187-844d-58f2-8927-2ae7f217c85c
msgctxt "hd6609389g4ec7g405egac56g2da0f7376f51"
msgid ""
"A history told by Balduran himself, passed from Grand Duke to Grand Duke, "
"stretching a thousand years back. It is no fable - it is plain truth."
msgstr ""
"발더란 본인이 직접 얘기하여 대공에서 대공으로 전해져 온, 천 년 전까지 거슬러 올라가는 역사다. 허구가 아니라 명백한 사실이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = ad3264f7-bb68-7700-9793-52d1c17ae1e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ad3264f7-bb68-7700-9793-52d1c17ae1e1
msgctxt "h440a4d35g708ag4401g97a4gd85999d5df29"
msgid ""
"Fine. As long as you fell the Absolute. I will repair the cracks and craters "
"you leave behind."
msgstr "좋아. 절대자를 쓰러뜨려 주기만 한다면 상관없네. 자네가 남길 균열과 폐허는 내가 복구하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Gale
#. NodeID = ad3cfcd1-8ad8-4282-9d28-eb26fedb6ad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ad3cfcd1-8ad8-4282-9d28-eb26fedb6ad4
msgctxt "h46d81987g4cd3g465fg98e2g32c30626153c"
msgid "The Blade of Avernus!"
msgstr "아베르누스의 칼날!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = ad5afea7-de7a-6a36-0fb8-3438781df601
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ad5afea7-de7a-6a36-0fb8-3438781df601
msgctxt "hbc500c43gc151g4df1g9692gf524c1f0befa"
msgid "I came here to save my own skin, not this godsforsaken city."
msgstr "이 망할 도시를 구하러 온 게 아니라, 제 목숨을 구하러 온 건데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = addc91ef-aa81-d55f-8ec4-a2818e042f6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:addc91ef-aa81-d55f-8ec4-a2818e042f6c
msgctxt "hedacdf25gf2f1g423fga425g71a616e7b859"
msgid ""
"Wyll, Mizora could be a dangerous influence. You can't accept your father's "
"offer."
msgstr "윌, 미조라가 위험한 영향력을 끼칠 수도 있어. 아버지의 제안을 받아들여선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = adfb0f61-9765-ca19-1cae-3750c166902d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:adfb0f61-9765-ca19-1cae-3750c166902d
msgctxt "h5910b38fg2d55g493egbe0fgfd086c1d6854"
msgid ""
"I am Ulder Ravengard! As long as I draw breath, I will cut down... "
"<i>ngh</i>..."
msgstr "난 얼더 레이븐가드다! 숨이 붙어있는 한, 그놈을 죽일... <i>으윽</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = ae040206-9341-0d56-93d3-728738f12607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ae040206-9341-0d56-93d3-728738f12607
msgctxt "hc917f17egc781g41b3g865bga070ef1ad1b4"
msgid ""
"Gods, can it be - the man who raised the city's walls became an "
"<i>illithid</i>?"
msgstr "신들이시여, 그럴 수가... 발더스 게이트의 성벽을 세운 남자가 <i>일리시드</i>가 되었다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = ae538bf8-14c0-c496-a685-501a14e65639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ae538bf8-14c0-c496-a685-501a14e65639
msgctxt "h5de55c5ag3921g466dgaffdg679b54ae0ab5"
msgid ""
"There's nothing to forgive. You wanted to protect the city. I only ever "
"wanted the same."
msgstr "용서랄 게 없는걸요. 아버지는 도시를 지켜내려 하셨고, 저도 같은 걸 바랐을 뿐이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = afa1c077-905a-9523-47eb-2c857e0b7fd4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:afa1c077-905a-9523-47eb-2c857e0b7fd4
msgctxt "hcdb73b26gc8afg4307gb1a5g01cc142ffce9"
msgid "Become a Grand Duke. Think of the good you could do."
msgstr "대공이 되는 거야. 네가 할 수 있는 좋은 일들을 생각해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = b01a4a5f-f539-7047-3762-da75970f96e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b01a4a5f-f539-7047-3762-da75970f96e9
msgctxt "ha60f5edagddd4g4f5agbb6cge964955862e3"
msgid ""
"The wyrm is dead, but his spirit lives within me. I've pledged to follow in "
"your footsteps!"
msgstr "고룡은 죽었지만, 그 정신은 제 안에 살아있어요. 아버지의 발자취를 따르기로 맹세했습니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = b0b1bcbf-4415-1eed-7f92-5ee5a55511c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WYR_WyrmRockPrison_Florrick_Event_Discovered = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b0b1bcbf-4415-1eed-7f92-5ee5a55511c4
msgctxt "hc3de1f23g6063g4992ga56fg78ed82486f6e"
msgid ""
"While the Absolute commanded my mind, I condemned her to death and confined "
"her in Wyrm's Rock Prison."
msgstr "절대자가 내 정신을 지배하는 동안, 그녀에게 사형을 선고하고 고룡 바위 감옥에 가뒀네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = b2db8250-7721-05a0-e7d3-526e764a5ddd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b2db8250-7721-05a0-e7d3-526e764a5ddd
msgctxt "hb58f1615g3fe1g4da7g9163g29d67f680489"
msgid "No manner of duke should save a city, only to open a gate to the Hells."
msgstr "그 어떤 공작도 도시를 구해놓고선, 정작 지옥의 문을 열어선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = b39a5fa8-5f23-42bd-3235-834a873f182b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b39a5fa8-5f23-42bd-3235-834a873f182b
msgctxt "h46640003g2c0fg401dga91bge41c6c4c5797"
msgid ""
"Of course. The city is wealthy. If you save us, I shall raise a tax in your "
"name. And we shall erect a statue."
msgstr "물론이지. 이 도시는 부유하다네. 우릴 구해준다면, 자네 이름으로 세금을 거두겠네. 그리고 동상도 세울 것이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = b494ddbf-8d22-e06b-92fe-ab8b29a43d9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b494ddbf-8d22-e06b-92fe-ab8b29a43d9e
msgctxt "hb4831448g7a11g4858g8f3agc72dd03bbc61"
msgid ""
"In Ansur's defeat, I've found my spirit renewed. For as long as the Sword "
"Coast needs a champion, I've vowed to answer its call."
msgstr ""
"안수르를 처치하면서 제 영혼이 다시 새로워지는 것을 느꼈어요. 소드 코스트가 투사를 필요로 하는 한, 그 부름에 응하기로 맹세했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = b61d9a2e-66e4-209a-0c9b-14a24def8403
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b61d9a2e-66e4-209a-0c9b-14a24def8403
msgctxt "h7229277cgd63bg4df2g8451g18cbe1f19956"
msgid ""
"I will rebuild the city. But first, I will tear down the Council and start "
"anew."
msgstr "나는 도시를 재건할 것이네. 그러나 우선, 평의회를 해체하고 새롭게 시작할 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Gale
#. NodeID = b6a6d1fb-fdb9-313b-fd49-2929278225e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b6a6d1fb-fdb9-313b-fd49-2929278225e7
msgctxt "h16b191b7g2d58g4bfcgaf33gecb3f1584be1"
msgid "Duke Wyll Ravengard!"
msgstr "윌 레이븐가드 공작!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = b7082414-5a8b-927b-88b1-96918e266d9c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_Event_RavengardWyrmwayQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b7082414-5a8b-927b-88b1-96918e266d9c
msgctxt "h6fd382c7g92b2g420dg8f11g25f5638034d3"
msgid "Let it set the path before you."
msgstr "자네가 나아갈 길을 비춰줄 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = b75de52f-55db-b139-c1de-de98d6c2e41d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b75de52f-55db-b139-c1de-de98d6c2e41d
msgctxt "ha708d724gca01g4d95ga55ag21452ce3bb41"
msgid ""
"*Your father's courage is an inspiration. You will make a name for yourself, "
"you will conquer all of the city's ills. The people will know you forever as "
"the Heart of the Gate.*"
msgstr ""
"*아버지의 용기에 힘을 얻었습니다. 당신은 이름을 드날리고, 도시의 모든 병폐를 정복할 것입니다. 사람들은 당신을 영원히 발더스 게이트의 "
"심장으로 기억할 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = b76e7b9e-2a0f-e76d-fbd2-0ee2f8301a16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b76e7b9e-2a0f-e76d-fbd2-0ee2f8301a16
msgctxt "ha2c70e84g123eg485dga65dgb51bbafbd5ae"
msgid ""
"I will tell the citizens and the patriars of your good works. They will know "
"you carry your father's banner."
msgstr "네가 했던 의로운 일들을 시민과 호족들에게 알리겠다. 네가 아버지의 뜻을 따르고 있다는 걸 알게 될 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = b8d9fbb8-467b-3f5a-be3b-b8978618b916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b8d9fbb8-467b-3f5a-be3b-b8978618b916
msgctxt "hff2a34e0g4df8g4b7dga4e1g5c8ec3a4cf64"
msgid "Wyll - my son. I'm so sorry. I didn't know."
msgstr "윌, 내 아들. 정말 미안하구나. 몰랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = b8dab3d8-7f8f-394b-ae05-c5a5b307aa9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:b8dab3d8-7f8f-394b-ae05-c5a5b307aa9b
msgctxt "h030be088g401eg4854gac2eg71d43f142513"
msgid ""
"The wyrm is dead, but his spirit lives within me. I am the Heart of the "
"Gate, the Blade of Frontiers!"
msgstr "고룡은 죽었지만 그 정신은 제 안에 살아있어요. 제가 발더스 게이트의 심장, 변경의 칼날입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = babb0665-e5f9-42bd-d35f-a4029f4e582e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:babb0665-e5f9-42bd-d35f-a4029f4e582e
msgctxt "ha038597dgcef9g4770gb9f1g6521c4d418e4"
msgid ""
"Courage. Insight. Strategy. Justice. I remember them well. You made me "
"recite them every morning."
msgstr "용기. 통찰. 전략. 정의. 어떻게 잊을 수 있겠어요. 매일 아침마다 달달 외우도록 시키셨잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = bacaacb3-b69a-2189-02ed-f3cc40ff00f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - WYR_AnsurGhost_State_HasAnsurBook(0) = True
#. SetFlags:
#.   Object:
#.     - WYR_AnsurGhost_Event_GiveAnsurBook(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bacaacb3-b69a-2189-02ed-f3cc40ff00f1
msgctxt "h2e63b02bg77f9g4166ga755ga172a80a37df"
msgid ""
"Take this - 'The Legend of Ansur'. An ancient epic, ill-remembered, "
"dismissed as a mere tale."
msgstr "받게, '안수르의 전설'이네. 기억에서 밀려난 고대 서사시가 단순한 설화로 전락하고 말았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = bb805654-2506-9e48-c459-546682c46772
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Wyll = False
#.   Object:
#.      - CAMP_Ravengard_Event_AskedAboutFuture(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_AskedAboutFuture(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bb805654-2506-9e48-c459-546682c46772
msgctxt "h3963cc96gffa5g4573g8717ge09c7d99a0cc"
msgid "What happens to Baldur's Gate when the Absolute falls?"
msgstr "절대자가 무너지고 나면 발더스 게이트는 어떻게 되는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = bbd942d1-bdf2-6ece-d3ba-0372ca193e04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bbd942d1-bdf2-6ece-d3ba-0372ca193e04
msgctxt "hb1022982ge856g44e9g80b9g37064bec30d7"
msgid "I'm sorry, Grand Duke, but you're in no condition to fight."
msgstr "미안하지만, 대공님, 지금 싸울 상태가 아니십니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = bc3b8fd2-e3fa-0a1c-03d2-0ba95ff8a0f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bc3b8fd2-e3fa-0a1c-03d2-0ba95ff8a0f8
msgctxt "hdaefaad2gefefg4103gba30ge9b5f689d405"
msgid "Before I was captured, I was on a mission."
msgstr "포로로 붙잡히기 전에, 사실 어떤 임무를 수행하고 있었다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = bd70b5ef-1f9f-b95d-a14d-6689e5a96dfb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bd70b5ef-1f9f-b95d-a14d-6689e5a96dfb
msgctxt "h4c757d2bg5717g4503g9811ge3a83ebd5163"
msgid ""
"He's right and we both know it. No manner of duke should be tied to a "
"devil's leash."
msgstr "맞아, 우리 모두 알고 있지. 그 어떤 공작도 데빌의 목줄에 묶여 있어선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = bd70b5ef-1f9f-b95d-a14d-6689e5a96dfb
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bd70b5ef-1f9f-b95d-a14d-6689e5a96dfb
msgctxt "hf7e35ebegdffbg421egb75aga1eab368de8a"
msgid ""
"She's right and we both know it. No manner of duke should be tied to a "
"devil's leash."
msgstr "맞아, 우리 모두 알고 있지. 그 어떤 공작도 데빌의 목줄에 묶여 있어선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = bd70b5ef-1f9f-b95d-a14d-6689e5a96dfb
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bd70b5ef-1f9f-b95d-a14d-6689e5a96dfb
msgctxt "he60b6517g8624g437dgbfbbg4bd4d13d92d0"
msgid ""
"They're right and we both know it. No manner of duke should be tied to a "
"devil's leash."
msgstr "맞아, 우리 모두 알고 있지. 그 어떤 공작도 데빌의 목줄에 묶여 있어선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = bdc8ef88-01b0-8239-2c8f-5d8ebc86b214
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bdc8ef88-01b0-8239-2c8f-5d8ebc86b214
msgctxt "ha468b6efgc81ag4b2cg8e54gbe5f20a83fc2"
msgid ""
"Together, Wyll and I will make Baldur's Gate the brightest gem aside the "
"Sword Sea. The Heart of the Gate will prevail."
msgstr "윌과 함께 발더스 게이트를 소드 해역을 넘어 가장 빛나는 보석으로 만들 것이다. 발더스 게이트의 심장이 득세하리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = be4d3a06-b24f-ec2d-5574-c6f7d49980a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_SkeletalDragon_State_Defeated = False
#.      - GLO_State_KnowsAboutWyrm = True
#.      - CAMP_Ravengard_Event_TurnedInQuest = False
#.      - WYR_AnsurGhost_Knows_ReadAnsurBook = True
#.   Object:
#.      - CAMP_Ravengard_Event_AskedAboutLegend(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_AskedAboutLegend(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:be4d3a06-b24f-ec2d-5574-c6f7d49980a9
msgctxt "heda786bbg3e1cg417cgb5a8gdc30e72f62df"
msgid "I read 'The Legend of Ansur'. What do you make of it?"
msgstr "'안수르의 전설'을 읽었어요. 어떻게 생각하시나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = befb3425-eb5d-db8a-a2c2-4a0dc641577a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:befb3425-eb5d-db8a-a2c2-4a0dc641577a
msgctxt "hc536c398g258eg4890g89cbg06bf0ffada14"
msgid ""
"I awoke in Moonrise Towers, inside one of those damnable pods. The rest -"
msgstr "깨어나 보니 문라이즈 타워였고, 그 망할 포드 안에 있었지. 그리고,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = bf07d7cb-6cb7-577d-4e3c-5378b0618269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bf07d7cb-6cb7-577d-4e3c-5378b0618269
msgctxt "h9f402c47gefe5g4075ga639g572a67798733"
msgid "<i>I am the Blade of Frontiers!</i>"
msgstr "<i>저는 변경의 칼날입니다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = bf7d0c28-5a99-8f1a-b225-dd5f7969fbb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_Event_WyllDecision = True
#.   Object:
#.      - CAMP_Ravengard_Event_ToldAboutBalduran(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_ToldAboutBalduran(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bf7d0c28-5a99-8f1a-b225-dd5f7969fbb1
msgctxt "h2eed2fa7g7c3eg4366gaa56gf993b8dd21c5"
msgid ""
"Balduran is still with us. He is the mind flayer that protects our minds "
"from the Absolute."
msgstr "발더란은 여전히 우리와 함께합니다. 절대자로부터 우리의 정신을 지켜주는 마인드 플레이어가 발더란입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = bfd666d3-bade-e079-a448-d5b4bc64d5b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:bfd666d3-bade-e079-a448-d5b4bc64d5b2
msgctxt "hb2af714cg51b2g429dg94b5g2f1ee212f6d6"
msgid "But the Heart of the Gate still lives - in me, in my allies."
msgstr "하지만 발더스 게이트의 심장은 여전히 살아있어요, 제 안에, 제 동료들의 가슴 안에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c012ac7f-d8bc-bd50-4b50-812e6df3d221
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c012ac7f-d8bc-bd50-4b50-812e6df3d221
msgctxt "h92ab5308gb585g4b04gaba9g0823282e21c0"
msgid "Please."
msgstr "부탁이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c014cd22-49de-d750-734e-2f410618cdc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c014cd22-49de-d750-734e-2f410618cdc6
msgctxt "h40e681a8gd687g42aag8a99g27ac7aff7924"
msgid ""
"It's no legend. Ansur does sleep beneath the Rock and will come to the "
"city's aid when it is in need. He is oathbound to do so."
msgstr ""
"전설이 아니네. 안수르는 바위 아래 정말로 잠들어 있고 도시가 위기에 처했을 때 도움을 주러 올 거야. 그렇게 하기로 맹세했었지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c0fd2d41-9dcb-a392-8d61-173c445931aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c0fd2d41-9dcb-a392-8d61-173c445931aa
msgctxt "hbe5355d4geef5g4b6ag8d14gb8a75a6eba54"
msgid ""
"I had hoped you'd join me on the Council - but the Blade's spirit is "
"indomitable. You are destined for greatness."
msgstr "네가 평의회에서 나와 함께하길 바랐지만, 칼날의 정신을 꺾을 수가 없군. 넌 위대해질 운명이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c13d9971-1dcf-4c63-2d23-537ba31e1084
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c13d9971-1dcf-4c63-2d23-537ba31e1084
msgctxt "hfd3b4030g3b81g4dbcgbaafg971ae82da237"
msgid "Your best is all you can offer. I'll ask for nothing more."
msgstr "최선을 다해주기만을 바라네. 그 이상은 바라지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = c2920a0a-139e-a89b-6682-67e18e21c9dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c2920a0a-139e-a89b-6682-67e18e21c9dc
msgctxt "h6f74367ag6fb3g46bdg830ag6badf3dc60f8"
msgid "Let's talk more, shall we?"
msgstr "더 이야기할까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c2c51358-f203-037a-af37-6bd721c9fe50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c2c51358-f203-037a-af37-6bd721c9fe50
msgctxt "hfc0178f7ga12dg45a3g9e18ge27b787438b5"
msgid ""
"You showed me that you are the future of Baldur's Gate - and well beyond it."
msgstr "자네가 바로 발더스 게이트의 미래이자, 그 이상이라는 걸 보여줬네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c2e60036-a614-8c49-f8b4-fbdd6026096c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c2e60036-a614-8c49-f8b4-fbdd6026096c
msgctxt "hafd497d7g7558g4ec7g98beg8daf42a38f2f"
msgid "A complicated one."
msgstr "복잡한 일이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c3b080da-568f-fc5b-14c1-1601bd361fd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c3b080da-568f-fc5b-14c1-1601bd361fd9
msgctxt "h2d418506g7c9ag4d36g95d1ga377308988b3"
msgid ""
"Courage. Insight. Strategy. Justice. Let these be the lights that guide you, "
"my son. Hail the Blade of Avernus!"
msgstr "용기. 통찰. 전략. 정의. 이것들이 널 인도하는 빛이 되게 하여라, 아들아. 아베르누스의 칼날 만세!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = c3b2e3e0-f9a2-b83a-2b16-39c3b7f6346a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c3b2e3e0-f9a2-b83a-2b16-39c3b7f6346a
msgctxt "hc9d9d04bg69d5g46cega774g97c809d8728b"
msgid "I pulled you from death's grip, and this is how you thank me?"
msgstr "죽음의 손아귀에서 끌어내 줬는데, 이게 고마움의 표시인가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = c4ec394c-25e1-ebc7-9b0b-d24dc010c5d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c4ec394c-25e1-ebc7-9b0b-d24dc010c5d6
msgctxt "h4afd2a3egb888g42feg8cf8g3acddb33da84"
msgid "Gods, this is just like you to judge without knowing the whole story."
msgstr "세상에, 항상 이런 식이었죠. 전체 이야기도 모르면서 판단하시는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c77da9d1-d931-b7b9-4ef8-089914ab4745
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.   Tag:
#.      - AVATAR(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c77da9d1-d931-b7b9-4ef8-089914ab4745
msgctxt "h0b768a93g4676g4ab8gafc9g605e694e11da"
msgid ""
"Together, we will make Baldur's Gate the brightest gem aside the Sword Sea. "
"The Heart of the Gate will prevail."
msgstr "우린 함께 발더스 게이트를 소드 해역을 넘어 가장 빛나는 보석으로 만들 것이다. 발더스 게이트의 심장이 득세하리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c77da9d1-d931-b7b9-4ef8-089914ab4745
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.   Tag:
#.      - AVATAR(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c77da9d1-d931-b7b9-4ef8-089914ab4745
msgctxt "h837e9355gd622g4e4fg9e60g70998667e034"
msgid ""
"Together, Wyll and I will make Baldur's Gate the brightest gem aside the "
"Sword Sea. The Heart of the Gate will prevail."
msgstr "윌과 함께 발더스 게이트를 소드 해역을 넘어 가장 빛나는 보석으로 만들 것이다. 발더스 게이트의 심장이 득세하리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = c7eb8fd9-1cd6-8894-62ef-8f83d53ef425
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c7eb8fd9-1cd6-8894-62ef-8f83d53ef425
msgctxt "hc8ef308egd656g496bg99b3gcf49a93b5277"
msgid ""
"I have slain monsters, faced illithids, guarded the helpless. To be a duke - "
"is this the destiny I've awaited? Is the nobility my calling?"
msgstr ""
"전 괴물을 죽이고, 일리시드에 맞서고, 힘없는 자들을 지켜왔어요. 대공이 되는 건... 이것이 내가 기다려 온 운명인가? 귀족이 되는 "
"것이 나의 소명인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c8815380-8b57-4aa6-3ab7-e3661692b59c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#.      - ORI_Wyll_RavengardKnowsEnding = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_HasMet_Final(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c8815380-8b57-4aa6-3ab7-e3661692b59c
msgctxt "hb0c2adf1g5480g493cg9843g4ffd34689ff7"
msgid ""
"Together, we will make Baldur's Gate the brightest gem aside the Sword Sea. "
"The Heart of the Gate will prevail."
msgstr "우린 함께 발더스 게이트를 소드 해역을 넘어 가장 빛나는 보석으로 만들 것이다. 발더스 게이트의 심장이 득세하리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = c88f4bf4-0be7-4516-458b-d9c165e924ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c88f4bf4-0be7-4516-458b-d9c165e924ba
msgctxt "h2ca1e0f9g4902g4921gafccgf9ddf1463ec6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = c98366a3-49ea-7aaa-b3a8-9cbd7887380b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c98366a3-49ea-7aaa-b3a8-9cbd7887380b
msgctxt "h4592a70eg5323g452bg8409gb54b8b01bb5a"
msgid ""
"The wyrm goes by many names. Ansur. The Waiting Storm. The Heart of the Gate."
msgstr "이 고룡은 여러 가지 이름으로 불리지. 안수르. 잠들어 있는 폭풍. 발더스 게이트의 심장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Minsc
#. NodeID = c9ca8c64-c44b-46f0-9b52-10d746914c00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:c9ca8c64-c44b-46f0-9b52-10d746914c00
msgctxt "h2ac230e5g99d2g40c1gb019g75021f1ef704"
msgid "The Blade of Avernus!"
msgstr "아베르누스의 칼날!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = ca9c62d9-a781-401b-7863-708f872679ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ca9c62d9-a781-401b-7863-708f872679ac
msgctxt "hecb64214g2071g4b29gbf14g4d9e6156ffd2"
msgid "It is <i>exactly </i>what I think."
msgstr "내 생각은 <i>틀림없다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = cc805f16-0177-eabc-640c-161b925278fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:cc805f16-0177-eabc-640c-161b925278fa
msgctxt "h73adc21bgb17cg4288g97baga53045f79b17"
msgid "This is no ordinary dragon."
msgstr "평범한 드래곤이 아니라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = cebb3a73-5de9-f51f-3cbb-6abb8aae06fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:cebb3a73-5de9-f51f-3cbb-6abb8aae06fd
msgctxt "h8e4af93dgc0bbg4397g9a71g583e488d1de1"
msgid "It's time you two made up. We've got a city to save."
msgstr "서로 화해할 시간입니다. 구해야 할 도시가 있잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = cf9329b0-3b50-2fc8-c4dd-fc1af983f7b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_WyrmRockPrison_Florrick_Event_RefusedToHelp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:cf9329b0-3b50-2fc8-c4dd-fc1af983f7b2
msgctxt "hbc780253gdca8g4409g8adcg7471d96d19e1"
msgid "I tried, but she refused to leave. She's lost all hope."
msgstr "시도해 봤지만, 그녀는 떠나기를 거부했어요. 모든 희망을 잃은 듯했어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = d053bca9-0828-6a87-185f-f064bb979176
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d053bca9-0828-6a87-185f-f064bb979176
msgctxt "h2a65cb01g7c34g48a1g823ag8adac9fbace9"
msgid "No. My son -"
msgstr "안 돼. 내 아들아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = d0a67dde-3857-7201-0d40-c015cf2a8150
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d0a67dde-3857-7201-0d40-c015cf2a8150
msgctxt "hb91d8938g51dag4b91gb250g90f9f3f8bccd"
msgid "Wouldn't you rather wake the dragon yourself?"
msgstr "직접 용을 깨우시는 게 낫지 않을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = d1f18993-80eb-5624-0668-fc9a68eeb85e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d1f18993-80eb-5624-0668-fc9a68eeb85e
msgctxt "hfe0b6e74g9739g4c34g8f7fg597642ca56a0"
msgid "I'll seek the wyrm and ask for his help."
msgstr "고룡을 찾아서 도움을 구하겠습니다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = d388d03e-47a4-2d6f-ba1d-2b99386a3de8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d388d03e-47a4-2d6f-ba1d-2b99386a3de8
msgctxt "he265c1f7g5938g4000ga8d6g1f5f912824e7"
msgid "I trust you, Wyll. Follow your heart, wherever it leads."
msgstr "널 믿어, 윌. 마음이 이끄는 대로 가도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = d4d4b063-11a8-aab2-41c7-099baae74c24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Ravengard_Event_NoWyll_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d4d4b063-11a8-aab2-41c7-099baae74c24
msgctxt "hc0272d45g3f18g4e2dg88aag8dda906f953e"
msgid "Glad to see you, friend."
msgstr "와줘서 반갑군, 친구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = d74dc3c1-d7dc-8bd3-fe52-a2731b5355d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d74dc3c1-d7dc-8bd3-fe52-a2731b5355d6
msgctxt "h3eb1a3bdg53d1g49cdgb379g10b90244dfb1"
msgid ""
"Baldur's Gate stands on the brink of the abyss. My father was clear: we "
"awaken the wyrm, and take back the city."
msgstr "발더스 게이트는 심연의 끝자락에 놓여 있어. 아버지의 뜻은 명확하셨지. 우린 고룡을 깨우고, 도시를 되찾을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = d7e48248-d5f7-ed34-4191-d6da9a8e4212
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d7e48248-d5f7-ed34-4191-d6da9a8e4212
msgctxt "hee8a7a96g4257g400dgaa30ga5dee7d866ad"
msgid "Will the people even accept me as duke? I mean, look at me."
msgstr "사람들이 저를 공작으로 받아주기나 할까요? 절 보세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = d8ba4c52-fd23-9dac-5681-0253c84b1a7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(2) = True
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_State_GrandDuke = True
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d8ba4c52-fd23-9dac-5681-0253c84b1a7a
msgctxt "h271ca49fga290g46adg8ab4g93ccf374fd2a"
msgid ""
"The Blade of Frontiers is dead. I will be Wyll Ravengard, proud Duke of "
"Baldur's Gate."
msgstr "변경의 칼날은 죽었어요. 저는 윌 레이븐가드, 발더스 게이트의 자랑스러운 공작이 될 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = d8c6b7ec-4a63-8803-0854-0b35af47ce70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d8c6b7ec-4a63-8803-0854-0b35af47ce70
msgctxt "h9403d7c3ga81eg4d25gab01g5b907ef9db74"
msgid "You sold your soul to save Baldur's Gate - and I cast you out for it."
msgstr "발더스 게이트를 위해 네 영혼을 거래하다니... 그럼에도 내가 널 내쫓았구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = d96e09d9-4000-6208-1893-27f0581f61c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d96e09d9-4000-6208-1893-27f0581f61c1
msgctxt "h2b2296a4g8cb9g4d94g8fa1g0fc5f1420bfa"
msgid "Thank you."
msgstr "고맙군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = d9a358ce-13b3-dac4-73e1-67cc78f10469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:d9a358ce-13b3-dac4-73e1-67cc78f10469
msgctxt "h248feba7g7237g4c6ag9a7eg6fd228b1fa98"
msgid ""
"Your faith in Wyll is well-founded. We will seek the wyrm and ask for his "
"help."
msgstr "윌은 충분히 믿을 만한 사람이죠. 고룡을 찾아서 도움을 요청하겠습니다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = db51bd06-bdbf-c001-0e70-7fd2a495c49e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:db51bd06-bdbf-c001-0e70-7fd2a495c49e
msgctxt "h3c8f0022g0a50g4b5cg8bdfg7d356b3f7308"
msgid "May the Triad guide you."
msgstr "삼선신이 너를 인도하길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = db72a377-d979-70f9-3799-fd3ae1beaed9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:db72a377-d979-70f9-3799-fd3ae1beaed9
msgctxt "h7e0fde93ga7cfg4384g9ec9g8e98ea388a1b"
msgid ""
"Please - promise that you'll be the shield that defends, the sword that "
"slays, and the hammer that rebuilds. Be our champion."
msgstr "부디, 방패가 되어 방어하고, 검이 되어 살상하며, 망치가 되어 재건하겠다고 약속해 주게. 우리의 투사가 되어주게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = dc9fab20-a4fd-f9e5-bf41-6a9344083d2a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:dc9fab20-a4fd-f9e5-bf41-6a9344083d2a
msgctxt "haee0684agf684g4a8bg9e4ag3462d3bef4af"
msgid "Everything I did, I did for Baldur's Gate. I did for you."
msgstr "전부 발더스 게이트를 위한 선택들이었어요. 아버지를 위해서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = ddffdcaa-f9f7-ec05-f21c-79de5b944106
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ddffdcaa-f9f7-ec05-f21c-79de5b944106
msgctxt "h475fe5bcg7525g47adgaebfg1194a10dd8d9"
msgid ""
"Ansur was a myth, father. It is up to me to save Baldur's Gate from the "
"Absolute."
msgstr "안수르는 신화였어요, 아버지. 절대자로부터 발더스 게이트를 구하는 건 저한테 달렸어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = de9b2fdd-47d5-2e68-2ca7-6b67acce4012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:de9b2fdd-47d5-2e68-2ca7-6b67acce4012
msgctxt "h09f4ef38ge134g4049gb571gdee931a4c839"
msgid "<i>Let the Emperor reveal your memories.</i>"
msgstr "<i>황제가 당신의 기억을 내보이게 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = deea125d-0d38-ab14-f745-9d861f593a03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_Event_RavengardWyrmwayQuest = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:deea125d-0d38-ab14-f745-9d861f593a03
msgctxt "h66530170g87ebg4758g8831g671efb0feb0b"
msgid "Go. You must awaken the wyrm."
msgstr "가거라. 고룡을 깨워야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = df493582-bcd3-ee0f-f26f-72ff650ecf95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:df493582-bcd3-ee0f-f26f-72ff650ecf95
msgctxt "h111bd9f3gb1edg476dga130g7616c2bc0e79"
msgid ""
"You want my gratitude? Fine - take your fill. But I will <i>not</i> "
"celebrate this infernal resurrection."
msgstr "감사를 원하느냐? 좋다, 마음껏 즐겨라. 하지만 난 이 지옥 같은 부활을 자축하지 <i>않을</i> 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = dfa37106-481c-9d9b-ab51-42c318a3704d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Ravengard_Event_ComWyllSpoke = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:dfa37106-481c-9d9b-ab51-42c318a3704d
msgctxt "hc04f724eg3ba1g4431ga121g5cfcddd7476f"
msgid "It isn't what you think. It never was."
msgstr "오해입니다. 절대 그렇지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = dfd6086c-4893-ac80-daab-c96463c548a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_SkeletalDragon_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:dfd6086c-4893-ac80-daab-c96463c548a7
msgctxt "h246a8131gab2bg46f1g8822g4aae0e8866d7"
msgid "<i>Tell Ravengard about the battle with Ansur.</i>"
msgstr "<i>레이븐가드에게 안수르와의 전투를 이야기한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = e295f276-0bec-a5d1-6270-dbaf31354eb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:e295f276-0bec-a5d1-6270-dbaf31354eb4
msgctxt "h2d0fa0f9gea47g4d7bg8571gafc620c727b4"
msgid "I am now the Blade of Avernus."
msgstr "나는 이제 아베르누스의 칼날이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = e4a2d5d7-c524-a4be-ab7c-8419a2d5f2ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:e4a2d5d7-c524-a4be-ab7c-8419a2d5f2ac
msgctxt "he7d4cc13g3231g46cfg9a10g9f6559da2480"
msgid ""
"*Ravengard's tadpole clenches as your memories - and Wyll's - flow into him.*"
msgstr "*레이븐가드의 올챙이가 당신과 윌의 기억을 힘껏 움켜쥡니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = e622df58-e604-45ef-6a59-66a8e5e82c87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:e622df58-e604-45ef-6a59-66a8e5e82c87
msgctxt "h8ee52127gee13g48b7g9143gf77478c86804"
msgid "As you wish."
msgstr "원하는 대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = e716d94d-4aca-157b-6551-79115a9c75f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:e716d94d-4aca-157b-6551-79115a9c75f2
msgctxt "hb6dbeb0cg9385g4617gbd58g74f7758c849a"
msgid "Then go with my blessing. Be Faerûn's great defender."
msgstr "그렇다면 네가 가는 길에 축복을 내려주마. 페이룬의 위대한 수호자가 되거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = e7182bdd-4088-c4cb-e415-a746d38a0497
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:e7182bdd-4088-c4cb-e415-a746d38a0497
msgctxt "h706a2b90gc96bg41f7g8097g5db2fd1e4e3c"
msgid ""
"Returning from Elturel, I discovered the plans of the Absolutists. I "
"immediately realised the city couldn't defend itself against such an army."
msgstr ""
"엘투렐에서 돌아오자마자 절대자 교단의 계획을 발견했지. 난 도시의 방비 수준이 그와 같은 군세를 상대하기엔 턱없이 모자라다는 사실을 "
"깨달았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = e759b5a2-9180-aeb9-0f66-138d61e25d6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:e759b5a2-9180-aeb9-0f66-138d61e25d6a
msgctxt "hcf92fec9g5468g47dcg823bg88bedea1669c"
msgid ""
"In Ansur's defeat, I've found my spirit renewed. Once I've vanquished the "
"Absolute, I will walk in your footsteps and lead the city as a Grand Duke."
msgstr ""
"안수르를 처치하면서 제 영혼이 다시 새로워지는 것을 느꼈어요. 절대자를 정복하고 나면, 아버지의 발자취를 따라 대공이 되어 도시를 이끌고 "
"싶습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = e9de10eb-ab4e-1948-2965-ddd97cf330b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:e9de10eb-ab4e-1948-2965-ddd97cf330b3
msgctxt "hc101993ag33a4g4244gaa10g6ba36b842997"
msgid "Everything I did, I did for Baldur's Gate. I did for you."
msgstr "전부 발더스 게이트를 위한 선택들이었어요. 아버지를 위해서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = eabc524c-7107-f1a2-c622-bed5a7af3db0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:eabc524c-7107-f1a2-c622-bed5a7af3db0
msgctxt "h3bb16e9egfd9dg4cb3ga614g3dc9f222f948"
msgid ""
"It wasn't the heat that woke me - it was the scent. Cultists had set fire to "
"the place. I don't remember being taken, just the smoke burning my throat "
"before I fell."
msgstr ""
"나를 깨운 건 열기가 아니라, 냄새였어. 광신도들이 불을 질렀었네. 납치의 순간은 기억나지 않지만, 쓰러지기 전 연기에 목이 타틀어 가던 "
"느낌은 기억나네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = ead1e2cf-13ce-106c-9851-14c54bd5bdea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ead1e2cf-13ce-106c-9851-14c54bd5bdea
msgctxt "hbd9d8203g5b5dg4beeg9002g36406e2f3c75"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = eb1e1dde-102a-401a-10b6-c46768fe12da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:eb1e1dde-102a-401a-10b6-c46768fe12da
msgctxt "h7bc95778g823dg49bcgbf3egf04e4ae4f900"
msgid ""
"*Ravengard sees Mizora and her infernal sisters. He sees the agony in your "
"face as an impossible choice is set before you.*"
msgstr "*레이븐가드는 미조라와 지옥의 자매들을 봅니다. 불가능한 선택 앞에서 고통으로 일그러진 당신의 얼굴을 봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = eb57b5c2-1230-b0cf-fed6-34e41bab2ace
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:eb57b5c2-1230-b0cf-fed6-34e41bab2ace
msgctxt "h601cb413g4faeg4827g9288ge4e69f2739fa"
msgid "Hail, hail, and hail again."
msgstr "만세, 만세, 그리고 또 만세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = ece03330-c8ea-9c02-e642-0cf9007dd96c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ece03330-c8ea-9c02-e642-0cf9007dd96c
msgctxt "he82c357egf438g494bga0dagb3b5675e3e58"
msgid ""
"*And he sees everything beyond. The nautiloid journey, the perilous path to "
"Moonrise, the Astral Prism, and the Emperor within.*"
msgstr ""
"*그리고 그 너머의 모든 것 역시 봅니다. 노틸로이드에 얽힌 여정, 문라이즈로 향하는 위험한 길, 아스트랄 프리즘과 그 안에 있는 "
"황제까지.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = ed81aa51-4496-1d96-d06f-5b2553ed7299
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ed81aa51-4496-1d96-d06f-5b2553ed7299
msgctxt "h918b3fd0g292ag4742ga170g2ff6f57dc8c6"
msgid ""
"- my duty is first and foremost to the city and its people. There's "
"something I must ask of you."
msgstr "내겐 도시와 시민들을 지켜야 할 의무가 있다. 그래서 꼭 부탁할 것이 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = ed860e02-75d3-9a41-bf93-76d4735f39f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ed860e02-75d3-9a41-bf93-76d4735f39f4
msgctxt "h4e07f477gcbcbg49f6g9f0bgc927b76e8f88"
msgid ""
"*A calm settles over you. The elder brain is a menace - but you are the "
"Blade of Avernus. No abomination is too powerful for you to overcome.*"
msgstr ""
"*평온이 찾아옵니다. 엘더 브레인은 위협적이지만, 당신은 아베르누스의 칼날입니다. 그 어떤 혐오스러운 존재도 정복할 만큼 당신은 "
"강력합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = ef23c51c-f2f6-d1aa-9ea4-a23e9b839316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ef23c51c-f2f6-d1aa-9ea4-a23e9b839316
msgctxt "h3ce6aea6ge89fg4561g9204g97432ee81ba1"
msgid ""
"W-Wyll? It - it can't be. By Balduran's graces, have you fallen so far that "
"Avernus has taken you?"
msgstr "윌? 이... 이럴 수가. 발더란의 은총이시여, 네가 아베르누스에 잡혀갈 만큼 타락했었단 말이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = f051b78f-2bb4-3f2d-e23d-7db9a19c6d77
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Wyll_Event_RavengardWyrmwayQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f051b78f-2bb4-3f2d-e23d-7db9a19c6d77
msgctxt "ha705d4ffg8422g4591gb0acg18db9f20d211"
msgid ""
"I once held a copy, but it was stolen. Find it, let it set the path before "
"you."
msgstr "사본을 갖고 있었는데 도난당했다네. 그걸 찾아, 자네 앞길을 밝히도록 하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = f145432c-a04d-5c92-1e4d-1071423f388f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f145432c-a04d-5c92-1e4d-1071423f388f
msgctxt "hddea15d9g7761g4c0fgb499g0f9c93754534"
msgid ""
"Baldur's Gate stands on the brink of the abyss. It is clear: we awaken the "
"wyrm, and take back the city."
msgstr "발더스 게이트는 심연의 끝자락에 놓여 있어요. 우리가 할 일은 분명해요. 고룡을 깨우고, 도시를 되찾아야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = f3146328-e0dd-e39d-0f59-74b09135f82b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f3146328-e0dd-e39d-0f59-74b09135f82b
msgctxt "h224684c0g4278g420eg9b8ag4cc1c7ebed0d"
msgid "<i>I am Wyll Ravengard, son of Ulder!</i>"
msgstr "<i>저는 윌 레이븐가드, 얼더의 아들입니다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = f43d3850-b940-3893-eb89-d34b5b4882fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f43d3850-b940-3893-eb89-d34b5b4882fe
msgctxt "hf0112f63g97f1g4890g8e12gbe1dc7371c70"
msgid "Father, please - there's something I must show you."
msgstr "아버지, 제발... 보여드리고 싶은 게 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = f57d1712-b6a4-57df-167e-b3849758dded
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f57d1712-b6a4-57df-167e-b3849758dded
msgctxt "he0959bcfga482g4174ga9e8g952cfac41921"
msgid ""
"Wyll's devoted his life to protecting the Coast. He's used his power wisely."
msgstr "윌은 소드 코스트를 보호하기 위해 일생을 바쳤습니다. 그는 자신의 힘을 현명하게 사용해 왔어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = f66f1804-0fa4-1d22-9650-8974a3b2cd80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f66f1804-0fa4-1d22-9650-8974a3b2cd80
msgctxt "hbcb76fcfga171g4f6cg981bgfbc3801e0c09"
msgid "I am the defender of the weak, I am the stalker of devils -"
msgstr "나는 약자를 지키는 자, 데빌을 추적하는 자,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = f6d9700c-479e-95fc-b423-ddaf6e8d9d33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = False
#.      - GLO_Wyll_State_BladeOfFrontiers = False
#.      - GLO_Wyll_State_BladeOfAvernus = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f6d9700c-479e-95fc-b423-ddaf6e8d9d33
msgctxt "h7444170dgd26eg43d4gaffeg05604e4fb77b"
msgid "Waking a dragon doesn't sound like a good idea."
msgstr "드래곤을 깨우다니 그리 좋은 생각은 아닌 듯합니다만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Wyll
#. NodeID = f72457f3-fd84-6ae9-76b0-55e2359a9ad6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f72457f3-fd84-6ae9-76b0-55e2359a9ad6
msgctxt "he8429f01g98b5g4251g9064gd608cd5328c4"
msgid ""
"The Blade of Frontiers is no more. I will be Wyll Ravengard, son of Ulder, "
"proud Duke of Baldur's Gate."
msgstr "변경의 칼날은 이제 없어요. 전 윌 레이븐가드, 얼더의 아들, 발더스 게이트의 자랑스러운 공작이 될 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = f7bff0aa-c5e4-bda3-08cc-a68724d46e88
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_AskedToFreeFlorrick(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f7bff0aa-c5e4-bda3-08cc-a68724d46e88
msgctxt "h23f9a7e1gbc1fg437fgaf53g3713b8a98707"
msgid ""
"She stood by me even as the Hells' fires lapped at my feet. You must free "
"her."
msgstr "지옥의 불길이 발을 휘감을 때도 그녀는 내 곁을 지켜줬었다네. 반드시 그녀를 풀어주게나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = f7e0ea1c-7fac-92d8-4abe-21da61730c8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f7e0ea1c-7fac-92d8-4abe-21da61730c8a
msgctxt "h103ab209g6e77g4a08g8356g8e28ac95a9e2"
msgid ""
"My own son, still the she-devil's toy. Is this my fate - to rise from death "
"into a hell of my own boy's making?"
msgstr "내 아들은 여전히 그 데빌 여자의 놀잇감이다. 이것이 내 운명인가? 죽음에서 일어나 내 아들이 만든 지옥으로 가는 것이?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = f849be4c-0384-b773-1c3c-e8cb6dd59c63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Ravengard_Event_AskedAboutAbduction(2) = True
#.      - CAMP_Ravengard_Event_AskedAboutElturel(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_AskedAboutElturel(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:f849be4c-0384-b773-1c3c-e8cb6dd59c63
msgctxt "h5a470872g3e54g4a3ag80d6g55992477f785"
msgid "What was your business in Elturel?"
msgstr "엘투렐에는 무슨 일로 갔던 겁니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Narrator
#. NodeID = fa202066-2ab2-c9fb-e1ca-534e7d8b2193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:fa202066-2ab2-c9fb-e1ca-534e7d8b2193
msgctxt "hbc7a6933gc1a8g4d75g8afdgf5eac1618215"
msgid ""
"*The past becomes present, and Wyll's thoughts are laid bare. Ravengard sees "
"Wyll partnering with Mizora to defeat Tiamat's cultists before they could "
"lay siege to Baldur's Gate.*"
msgstr ""
"*과거의 시점이 현재로 옮겨오고, 윌의 생각이 드러납니다. 레이븐가드는 윌이 미조라와 협력하여 티아마트의 광신도들이 발더스 게이트를 "
"포위하기 전에 그들을 물리치는 것을 봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = fa730a43-593c-f703-ade9-cd1a92d39e8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:fa730a43-593c-f703-ade9-cd1a92d39e8a
msgctxt "h661e2d6dg8b83g4de6gafe4g4fc2e4215471"
msgid ""
"You are a better man than most, and a better son than I deserve. I'll yet "
"make amends, but -"
msgstr "넌 사나이 중의 사나이고, 아버지보다 나은 아들이란다. 보답할 길이 까마득하다만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = fbb7c787-9780-9f70-eee1-d41394a7e508
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_RavengardKnowsEnding = True
#.     - GLO_Wyll_State_BladeOfFrontiers = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:fbb7c787-9780-9f70-eee1-d41394a7e508
msgctxt "h66a29c34g105cg41d8g91c3g7e6b1b2e5c29"
msgid ""
"You are a hero, not an aristocrat. The Blade is a champion. 'Duke Wyll "
"Ravengard' is not."
msgstr "넌 영웅이지 귀족이 아니야. 변경의 칼날은 투사이지만 '윌 레이븐가드 공작'은 그렇지 않지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = fc853657-5bbb-e3f5-c896-971c8e6c7281
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:fc853657-5bbb-e3f5-c896-971c8e6c7281
msgctxt "h0df5d7c7g2b52g4801gb6a0g758c0cc3200e"
msgid "No. And I'm not about to."
msgstr "아니요. 그럴 생각도 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = fdcdf2f3-7759-1994-2350-426603d8f90f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Ravengard_Event_NoWyll_HasMet(2) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Ravengard_Event_NoWyll_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:fdcdf2f3-7759-1994-2350-426603d8f90f
msgctxt "h32a000begf937g4577gb128g8904b02585a3"
msgid "My friend, I -"
msgstr "친구여, 나는..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = fe7cba02-dd14-6eda-265c-186b8bcb2988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:fe7cba02-dd14-6eda-265c-186b8bcb2988
msgctxt "h6d9acbe5g228ag4616gaecagd8eda1fa0ff3"
msgid ""
"Today, you've earned my trust. I know you will do right by me when the time "
"comes."
msgstr "오늘, 자네들은 나의 신뢰를 얻었네. 때가 되면, 옳은 일을 할 거란 걸 알고 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Player
#. NodeID = ff1fe28f-91d2-29dd-717f-176bca0f4ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ff1fe28f-91d2-29dd-717f-176bca0f4ef1
msgctxt "h9471bafeg98b0g4f7egb105gae9b14e9e088"
msgid "I was forbidden to tell you before. But now, I can tell you the truth."
msgstr "전에는 금지되어 말할 수 없었지만, 이제 진실을 말씀드릴 수 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard
#. Speaker = Duke Ulder Ravengard
#. NodeID = ff9d52d9-1c4e-3b7c-a307-c20dc1f7fe9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Ravengard:ff9d52d9-1c4e-3b7c-a307-c20dc1f7fe9e
msgctxt "h86e2f197g9339g4c44gb5f5gb36d7627d0aa"
msgid "It is <i>exactly</i> what I think."
msgstr "내 생각은 <i>틀림없다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h16c7bc79gead9g47e9gaf00g123598cc9beb"
msgid "I need to rest. Sunset can't come quickly enough."
msgstr "좀 쉬어야겠어. 일몰이 빨리 왔음 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[0].TagText[1]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h8f632e39g7130g4fd5gaf6bgf4be72e24d27"
msgid "Ugh. There had better be a soft bedroll in my near future."
msgstr "으. 조금만 참으면 편안한 침낭에서 잘 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[0].TagText[2]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h2a2a2c1fg30aag4fb7g8e26gf91fca7ceee0"
msgid "I'm so tired. How do people do this all day?"
msgstr "완전 지쳤어. 사람들은 어떻게 하루 종일 이렇게 다닐 수 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h37528696g45d1g4951g83a4g561f3b0ba4f0"
msgid "I'm quite exhausted. A good night's sleep would do me wonders."
msgstr "꽤 지쳤어. 푹 자고 나면 훨씬 낫겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[1].TagText[1]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h3147d30bg6ea4g4861gbaa4g4758a3b672e1"
msgid "If I don't get my beauty sleep soon, I may just get a tad malcontent."
msgstr "빨리 단잠을 청하지 않으면, 심술궂은 불평꾼이 될지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[1].TagText[2]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "hedab0b63g23e3g4ddbg9919gb73da1a99fa6"
msgid ""
"A wizard's quite worthless with a tired mind. Sleep beckons, and I would "
"follow."
msgstr "피곤한 정신의 위저드는 쓸모가 없어. 잠이 손짓하면, 따라가야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "hd4e94a00ga7a6g4983g8b29g75da287064c6"
msgid "My dogs are barking. Can we rest?"
msgstr "발 아파 죽겠어. 좀 쉬지 않을래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[2].TagText[1]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h4e1bc71egb326g438cg8587g7168995ee339"
msgid "*Yawn!*"
msgstr "*하암!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[2].TagText[2]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h9e5e8f8eg40bfg4ee7gad63g17dc128e6104"
msgid "Time to take a load off, isn't it?"
msgstr "슬슬 짐 좀 내려놓을 시간 아냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[2].TagText[3]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h4f1f6809gb799g4133g8eabge6e517eb35fc"
msgid "I am ready to rest my weary head."
msgstr "지친 몸을 뉘일 준비가 됐다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "hc682654dgcd70g431fgb412g72982a9e9262"
msgid "Battle has taken its toll. I should rest."
msgstr "힘겨운 전투였다. 휴식이 필요하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[3].TagText[1]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h2968194bg6f38g44b0gaafdgac7551209392"
msgid "My energy wanes - time to rest."
msgstr "체력이 다했군. 쉴 시간이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[3].TagText[2]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h55b52989g9951g46f0gbe14g7a879e3f8fb3"
msgid "My eyes grow heavy. Best to make camp."
msgstr "눈이 무거워지는군. 야영지로 가야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h6054f512gf280g4b0eg9ba9gd0abd3c0bc4c"
msgid "It's been a long day. Better stop to rest soon."
msgstr "아주 힘든 하루였어. 곧 쉬어야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[4].TagText[1]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h67d796a1g16acg4d89g9f8cg7f0e359788f5"
msgid ""
"Better make camp soon. Might be a while before there's another chance to "
"rest."
msgstr "빨리 야영지를 차리는 게 좋겠어. 다음 휴식을 취할 때까지 시간이 얼마나 있을 지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[4].TagText[2]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h0e757328gd723g4a80g93d8g35a7a466bf8a"
msgid "Should get some rest - I need to keep sharp."
msgstr "휴식을 좀 취해야겠어, 날카로운 정신을 유지해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[4].TagText[3]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "hd94f043bg92abg45b8g9088g761bad0c6e84"
msgid "Time to pack it in for the day, I think."
msgstr "하루를 끝마칠 때가 된 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "hbb1bb8c0gb3d3g4157g9273g9d7826d6a826"
msgid "What a day. I could really use some shut-eye."
msgstr "정말 힘든 하루였어. 눈 좀 붙이고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[5].TagText[1]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "heb8ac3eaga1d3g497cg8136gbace7f632f24"
msgid "Whew - I'm spent. I should unwind in camp."
msgstr "휴 - 난 지쳤어. 야영지에서 긴장을 풀어야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[5].TagText[2]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h0dc6048ag9a81g4cc3g8ffeg27ecc28fb8ab"
msgid "What I wouldn't give for a good rest about now."
msgstr "지금 쉴 수 있다면, 뭐라도 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h37ff1804ged60g4277g8822g40f81a493305"
msgid "I'm exhausted. Better find somewhere to camp soon."
msgstr "완전히 지쳤어. 곧 야영지를 차리는 게 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[6].TagText[1]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "hfcd4c632gdc6dg44adg81e1g745777967040"
msgid "It's been a long day. I'll need to rest soon."
msgstr "아주 힘든 하루였어. 곧 쉬어야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD
#. Speaker = Player
#. NodeID = 1276de78-24e3-a364-8b36-2b96808e24e3
#. HandlePath = TaggedText[6].TagText[2]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_RestReminder_PAD:1276de78-24e3-a364-8b36-2b96808e24e3
msgctxt "h75d34badg6d8dg4099g90bcg42357b3696ea"
msgid "I'm done. I can't wait to sleep."
msgstr "완전히 지쳤어. 어서 잠들고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 0488b41c-50e5-6ba9-c611-271fe271e8f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:0488b41c-50e5-6ba9-c611-271fe271e8f0
msgctxt "h65460fb6gbd71g4eecgaab9gf910db77aa70"
msgid ""
"I should gather my strength. I've waited so long for this, a little longer "
"won't do any harm..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 0a878386-c26a-680a-f9aa-4d5408b5ff8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:0a878386-c26a-680a-f9aa-4d5408b5ff8c
msgctxt "hfaf4da8bgb677g4b73g83f5gac5f736ba244"
msgid ""
"Still, I am... unused to it. I can only hope she forgives a slip of the "
"tongue now and again, until I adapt."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 0aaa4a2f-3fc6-e5c0-a912-fe7027a1dc70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:0aaa4a2f-3fc6-e5c0-a912-fe7027a1dc70
msgctxt "h4781c4c6g9dc0g488cgbdf0gcd61dabcf77f"
msgid ""
"Yes. Now you know all that is worth knowing. Let us put this behind us, for "
"good."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 0cec9ef1-baff-00ed-8ac3-0433e34b3c1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:0cec9ef1-baff-00ed-8ac3-0433e34b3c1b
msgctxt "h16e930adg8e3bg4c8bg875fg33a4124c9ae6"
msgid ""
"Well it depends - do you find yourself more hirsute at certain times, "
"craving warm flesh? Actually no - spare your father the answer to that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 0d2ef272-ab28-63be-6c0f-03e59e59142d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:0d2ef272-ab28-63be-6c0f-03e59e59142d
msgctxt "h1355fbe1gbc10g42cfg84b9g08f79f806ddc"
msgid ""
"Very well... but I shall not wallow in ugly details. That is what <i>they </"
"i>would have wanted - to have let their physical torments live on in our "
"spirits. I will not allow that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 1859ee90-ca3a-8b79-fd29-6efe1b509bc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:1859ee90-ca3a-8b79-fd29-6efe1b509bc9
msgctxt "h0f330150gc1f4g4458g82a5ga2374e819710"
msgid "Shadowheart, my darling. All is well, I hope."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 185a727b-9969-194c-9a7b-419d6db414ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:185a727b-9969-194c-9a7b-419d6db414ac
msgctxt "hf2c608d3gac1cg4174g8d70g84fa72f72278"
msgid ""
"I had promised you we would catch up once I'd rested - perhaps there's "
"something you wish to ask about."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 1960cff9-e68e-167d-7053-6f0a21a1f6cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:1960cff9-e68e-167d-7053-6f0a21a1f6cf
msgctxt "h3d3b81f1g5a31g4991gaf8bg12c3ffc5b81e"
msgid ""
"You must not blame yourself. You were a child; your mother and I were "
"supposed to protect you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 1b359f97-0956-d5b2-eb98-70e9c04d537e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:1b359f97-0956-d5b2-eb98-70e9c04d537e
msgctxt "h11498a15g4c9cg4affga9e8g59f338631ac7"
msgid ""
"I'm starting to feel like my old self again. And Jen - I mean Shadowheart - "
"has been able to unbottle some of the feelings that Shar denied to her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 2181cccc-b98e-883e-96f5-48f5b3f2a175
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:2181cccc-b98e-883e-96f5-48f5b3f2a175
msgctxt "h7d18ac39ga529g4523ga4ceg8fb943246339"
msgid ""
"You are more than just a friend to her, aren't you? I saw the way she looked "
"at you. It reminded me of her mother, when we first met."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 25dba6d1-2cb7-8aa8-aacb-8018e033c507
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_PlayerAskedAboutCaptivity(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_PlayerAskedAboutCaptivity(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:25dba6d1-2cb7-8aa8-aacb-8018e033c507
msgctxt "h2ff0e18cgd6d2g4586gb968g695b23054de4"
msgid ""
"What happened during all those years? What did they make your daughter do to "
"you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 266cf696-b62e-22a9-42ac-a19ec1cec5c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:266cf696-b62e-22a9-42ac-a19ec1cec5c8
msgctxt "h612a67b7g8c63g42cfg9a1egcac53f66aba6"
msgid ""
"We grew complacent - underestimated the depths of Shar's bitterness, the "
"fanaticism of her followers. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 28b114a9-0a25-ba22-db6e-dc58495be925
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:28b114a9-0a25-ba22-db6e-dc58495be925
msgctxt "h8808a3dcgdcd6g42bbg9e22g8036ad45328f"
msgid ""
"We were still a family, in that room. Suffering. Enduring. But we did not "
"give up. Your mother and I swore we would see the look of recognition in "
"your eyes once again. And we did."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 2a2e1726-356a-a97f-4348-d5bc37e13ce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:2a2e1726-356a-a97f-4348-d5bc37e13ce4
msgctxt "he0c15ac1g819cg44bbg8520g16779a5055e3"
msgid ""
"Knowing you were out there still was enough to sustain us. And you are "
"stronger than us both, daughter. We merely had to endure - you had to choose "
"your path. One that brought you back to us, at last."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 2f35a154-893d-487a-8e46-dd60b262766b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:2f35a154-893d-487a-8e46-dd60b262766b
msgctxt "h73fe94e9gd318g4317g98bbgbe5373305602"
msgid ""
"You've shown great kindness, allowing my wife and I to remain with you. "
"Thank you. I'm glad Jenevelle found you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 344ae085-c211-18e3-7bc6-16923889365c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:344ae085-c211-18e3-7bc6-16923889365c
msgctxt "h3b17f42fg3ba4g48c6g82c8g57206f955031"
msgid ""
"But when I found you, you did not see your father, rushing to save you - you "
"only saw a wolf, hunting you in the darkness."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 37adeda0-5d0d-1d6a-0118-6021fd6d9783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:37adeda0-5d0d-1d6a-0118-6021fd6d9783
msgctxt "h732774d9g62c4g4642g8475ga6e531c265c9"
msgid "How is your wife - Emmeline?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 39b703f0-ec7c-ac2a-4cc5-3572b35d53b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:39b703f0-ec7c-ac2a-4cc5-3572b35d53b4
msgctxt "h43619b2eg40a7g49b8g827fg6a6ade1aa9aa"
msgid ""
"Perhaps... perhaps later, my girl. That is a hard thing to talk about. I "
"fear I do not have the strength for it just yet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 3f072379-513c-be8f-863b-f2b9482678f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_SHTortureHistoryDone(1) = False
#.      - CAMP_ShadowheartFather_Event_SHAskedAboutTorture(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_SHTortureHistoryDone(1) = True
#.     - CAMP_ShadowheartFather_Event_SHAskedAboutTorture(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:3f072379-513c-be8f-863b-f2b9482678f7
msgctxt "h1b19f620g249dg4558gab9cg9579506d81ea"
msgid ""
"They made me do things to you both, all those years. Please - I need to know."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 4f93095a-a7b4-6970-003f-7929bf1bc031
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:4f93095a-a7b4-6970-003f-7929bf1bc031
msgctxt "h935f0cbeg306fg4f9agbbdag2bae6a628a86"
msgid "How did you both go on like that? I could never have the strength..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 51541b23-dbe6-c9b5-b8dd-a47f1fda4a8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_NameFollowup(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_NameFollowup(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:51541b23-dbe6-c9b5-b8dd-a47f1fda4a8b
msgctxt "h3eb514edg29ffg4d49g955ag7f9715a8fe09"
msgid "You accept your daughter's choice of name?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 57290180-8b3e-48ca-8980-8c224d36ff7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:57290180-8b3e-48ca-8980-8c224d36ff7b
msgctxt "hb8df0ab6g6ba4g47b6g89fbgb879e439b02e"
msgid "Perhaps they did - ours was a small community, spread thin."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 5bf1438b-054f-23ac-6bc8-cc0be46f7644
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:5bf1438b-054f-23ac-6bc8-cc0be46f7644
msgctxt "hbe44a078gc5dcg4e4cg80a3g2f6fc6d9a631"
msgid "What comes next for you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 5c570f71-9c16-4a71-f39f-d9a6f057b1ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:5c570f71-9c16-4a71-f39f-d9a6f057b1ce
msgctxt "h3087a5a4g0968g40ddgaa21ga9983089d09a"
msgid "Why did nobody else help you? Or come to search for us?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 5c88b616-83b2-b81b-57f8-bb65e38833f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:5c88b616-83b2-b81b-57f8-bb65e38833f8
msgctxt "h2372917cgccbag41f8g9ab5g99ee96c16845"
msgid ""
"Both. They marked you before our eyes. They said it would discipline you for "
"straying, while extending our torment also. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 5f3e36f4-de70-cfa4-f352-63bc57ade1aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:5f3e36f4-de70-cfa4-f352-63bc57ade1aa
msgctxt "h8e45de5bgcb35g4538gb2ffg25816e90b472"
msgid ""
"Don't worry - I am truly glad she found you, and I have scant energy to play "
"the stern father."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 641032e7-ad4b-a594-40e0-8a08d5523884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:641032e7-ad4b-a594-40e0-8a08d5523884
msgctxt "h1a8b763egaf02g4062g8827ga450e432c123"
msgid ""
"And Shadowheart too may wish to join us perhaps, once she's helped you put "
"down this 'Absolute' threat."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 689769d1-fe80-c27a-2d98-9bc9cbbc0f8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:689769d1-fe80-c27a-2d98-9bc9cbbc0f8d
msgctxt "h4515a9bfg3c8bg4de6gad1bgd16cd658014d"
msgid ""
"You could have done nothing back then - not without putting yourself in "
"danger. The Moonmaiden guided you in her own time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 6b06ffd2-cf09-3adf-b4ce-564649cce6b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:6b06ffd2-cf09-3adf-b4ce-564649cce6b0
msgctxt "he27708e4ge25cg4d3cg9b22g6d88f391879f"
msgid ""
"But do not worry. We're together again - and we will make every moment count "
"all the more."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 6ca5bc62-d3a8-ca4a-3943-90defed78b43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:6ca5bc62-d3a8-ca4a-3943-90defed78b43
msgctxt "h56708733gac71g4bdfgbf5egbc2b58a12b8a"
msgid "All these years... you were so close by. And I did nothing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 6fe12653-7ccd-fd97-c561-862f60bbc6f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:6fe12653-7ccd-fd97-c561-862f60bbc6f1
msgctxt "hf55b665cgd3e7g4b53gb73bg7f8883c0acbf"
msgid "Some rest, perhaps, will make me better company."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 747eb7a3-90a1-1e9f-ff08-46acf6d595ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:747eb7a3-90a1-1e9f-ff08-46acf6d595ac
msgctxt "h93ed4833g7291g4d44g8e9eg929212e4db74"
msgid ""
"And Shadowheart too may wish to join us perhaps, with her fine paramour at "
"her side - once you've put down this 'Absolute' threat together."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 757b7abe-c410-afa4-05a9-2ff59c26544b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:757b7abe-c410-afa4-05a9-2ff59c26544b
msgctxt "hb54294c0gc7acg4d62g9d2age14161423b0e"
msgid ""
"Whatever we have left, I must make count for double - <i>triple</i>. But "
"later, perhaps. I still need time to recover my strength."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 75af2762-cd40-c3d9-3608-2dc499f3bc1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:75af2762-cd40-c3d9-3608-2dc499f3bc1e
msgctxt "he898e1b4gb751g46bag9bd6g5ef92f774c25"
msgid ""
"My wife will need care. I wish to find somewhere quiet, close to nature. "
"Where the sun can warm us, and the moon can watch over us as we sleep."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 760f53cd-c0a7-bfc2-6829-dcfcb8eabab8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:760f53cd-c0a7-bfc2-6829-dcfcb8eabab8
msgctxt "h84e042d6g16f0g4218gba30g389c80b670eb"
msgid ""
"When I awakened, you were gone, but your mother was with me. They were "
"spiriting us away to the city, hidden and bound."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 78c36f37-d161-9512-5205-8a531a7165f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:78c36f37-d161-9512-5205-8a531a7165f9
msgctxt "hd5117791g6d84g48aaga100gdb00456b3618"
msgid ""
"Whatever Jenevelle wishes of us. She still has other fights. But when she's "
"ready, we'll be there. To be a family again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 79429359-7135-44af-ea4a-6707246c6b20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_DiscussedMother(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_DiscussedMother(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:79429359-7135-44af-ea4a-6707246c6b20
msgctxt "h43cdeffagbb1cg4c8cga19bg44574b2d09a5"
msgid "How is mother coping?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 7a08df41-cfc1-a8f3-4918-d0ce12a6bf4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_DiscussedLycan(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_DiscussedLycan(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:7a08df41-cfc1-a8f3-4918-d0ce12a6bf4b
msgctxt "h41015762ga972g411bgb351g16ed894f95c8"
msgid "If you're a lycanthrope, does that mean I am also?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 7b34f5b6-dc39-d2a3-ea60-6d73e0a753a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:7b34f5b6-dc39-d2a3-ea60-6d73e0a753a5
msgctxt "hd72df333gd2d9g43b4ga580g4e21c4db6977"
msgid ""
"I'm sorry. This would never have happened if I hadn't been frightened, if I "
"hadn't ran."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 7d3546e4-40b3-a344-71ac-9813a3aea404
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:7d3546e4-40b3-a344-71ac-9813a3aea404
msgctxt "h367bc359gae70g4e9cg8a4cg01aa91c1845b"
msgid ""
"Instead, the Sharrans used us to teach you different lessons. Painful "
"lessons."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 7dfa182a-dc50-7e3c-7cc0-8b24d3d0fe76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:7dfa182a-dc50-7e3c-7cc0-8b24d3d0fe76
msgctxt "h20c1b98eg0a4eg4c76g9223ge59ff466d676"
msgid "What about the wound on my hand? Was that to hurt me, or you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 7e96217f-da25-c92f-40b1-1efa687f5c6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_DiscussedLycan(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_DiscussedLycan(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:7e96217f-da25-c92f-40b1-1efa687f5c6e
msgctxt "h215923cbge62ag497agb55egc9c106d614a6"
msgid ""
"So you're a lycanthrope? Shadowheart shared some of her memories with me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 7f1a93df-3dd0-e356-46c5-b29bbe514bd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:7f1a93df-3dd0-e356-46c5-b29bbe514bd2
msgctxt "hb7272478ga1e5g43ceg8ffeg81699bd86ce9"
msgid "I'm sorry."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 8073519d-9ba3-e4e2-a2ad-bd7bd1c9ec7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:8073519d-9ba3-e4e2-a2ad-bd7bd1c9ec7a
msgctxt "hadb75fa1gafd4g4096g877bg07dfca930fe8"
msgid ""
"We will talk again soon, my sweet. Once I've had some time to gather myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 81668c96-1830-cbdd-69c7-e6c4b9116d47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:81668c96-1830-cbdd-69c7-e6c4b9116d47
msgctxt "h0167f300gbb60g46ffgb14fg0a0b79009da2"
msgid ""
"She is strong... but she is also human. The years were harder on her than on "
"me, in both body and mind. Shar's pit robbed us of precious time we can "
"never have back."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 81ee151e-35be-3288-3fc5-debbe9d1fead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:81ee151e-35be-3288-3fc5-debbe9d1fead
msgctxt "h81ded4cag5380g4d36ga0bfge4956da5191f"
msgid ""
"Are you sure, Shadowheart...? Picking at old wounds may not serve any "
"purpose..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 8406ed2d-9614-0f78-b91d-f69655dd6205
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:8406ed2d-9614-0f78-b91d-f69655dd6205
msgctxt "ha3c537bcg7abeg40d8gab67g537834bb0182"
msgid ""
"Don't be. Knowing you were out there gave us the strength to hold on. And "
"you returned to us, just like you were supposed to, all that time ago."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 84dd5c60-e510-8556-1ac3-48b60314069d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:84dd5c60-e510-8556-1ac3-48b60314069d
msgctxt "hb330fe5dg1335g4ab5ga925g4cfcf7d685ca"
msgid ""
"I've heard enough about this 'Absolute' threat to understand it cannot be "
"ignored. Your mother and I can wait until you prevail - and I know you will."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 8dca6afa-4da7-81d3-78af-bc6eb3469c0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_SHAskedAboutTorture(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_SHAskedAboutTorture(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:8dca6afa-4da7-81d3-78af-bc6eb3469c0b
msgctxt "hd909e056ged63g4901g8601g70b3a01eb4e3"
msgid ""
"They made me do things to you both, all those years. Please - I need to know."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 8e29ed2f-229e-494d-ce22-afe2a15ae572
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:8e29ed2f-229e-494d-ce22-afe2a15ae572
msgctxt "h029f7ad3gee31g4733ga670g0a162c3cb3ee"
msgid ""
"I took on my wolf-form to cover the ground more quickly. And it worked - I "
"followed your scent, and reached you before the Sharrans could."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 93fd95d5-de89-343c-f2e2-7ce16a8d8dd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:93fd95d5-de89-343c-f2e2-7ce16a8d8dd2
msgctxt "h9349ac18g2f31g48bfgb864g183277e1b4fe"
msgid "Please. I need to understand, if I'm to move on."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 946d88da-2a8b-6fcf-ff8a-c06c18f72c6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:946d88da-2a8b-6fcf-ff8a-c06c18f72c6b
msgctxt "h28e8d063gaa52g47faga2c7g7888823345eb"
msgid ""
"She is strong... but she is also human. The years were harder on her than on "
"me, in both body and mind. Shar's pit robbed us of precious time we can "
"never have back."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 97154d0b-8fde-e44a-5e29-812735779012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:97154d0b-8fde-e44a-5e29-812735779012
msgctxt "hf3d10e0ag7d3cg4d2dgb035g8c2fefe715eb"
msgid "There's so much I want to ask about."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 975d0261-92e8-7763-be2f-4eb45779a51c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:975d0261-92e8-7763-be2f-4eb45779a51c
msgctxt "h2c296117g0d74g46b3gb354gd86e115da663"
msgid "The failing was mine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 98431286-3a30-8326-b48b-25d51f5a2967
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_DiscussedAbduction(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_DiscussedAbduction(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:98431286-3a30-8326-b48b-25d51f5a2967
msgctxt "had141674g90bdg4f67g84b7g9adc3962a7ca"
msgid "What really happened that night in the woods, when I was abducted?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 984af289-1956-e97b-28bb-4033a2085c5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:984af289-1956-e97b-28bb-4033a2085c5f
msgctxt "hd27a78d3g8a99g404ag95f8g43734c2e0a70"
msgid "How is it you could transform into a wolf at will?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 9874ab85-217a-1000-112e-f607b2b55cae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:9874ab85-217a-1000-112e-f607b2b55cae
msgctxt "h62d4dc08g0f5bg4e53ga4d9g769d375ac9b4"
msgid "What comes now?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = 9b608209-4017-a2b8-58de-e7402f36d217
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:9b608209-4017-a2b8-58de-e7402f36d217
msgctxt "h2f6ff72cg9109g4bfdg8ea1gdc268f19857d"
msgid ""
"They had you use us for... practice. All the techniques that the Sharrans "
"hold pride in. Trickery, interrogation... torture. They even had you, our "
"own daughter, try to <i>convert </i>us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = 9bba09fe-ff81-0fed-65ce-ab4763505a34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:9bba09fe-ff81-0fed-65ce-ab4763505a34
msgctxt "h820614b6gfd76g4225gb6a0g46287ddf3a2b"
msgid "What comes next for us? "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = a04d4497-c24f-94ac-dc49-38e452518593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:a04d4497-c24f-94ac-dc49-38e452518593
msgctxt "h0f79ca5dg2d1eg4b18g8d01g6b9ed3af9785"
msgid "Jen - I mean, Shadowheart, pardon. It warms my heart to see you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = a5a94d95-6db8-48e0-4a11-93cd1e4151cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:a5a94d95-6db8-48e0-4a11-93cd1e4151cb
msgctxt "h8d210194g6c32g4d37gb7f2g3f94663199d7"
msgid ""
"You panicked, and before I could explain, the Sharrans found us. Father and "
"daughter. Wolf and prey. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = a762fb47-1636-aa70-ac26-4c2722af538e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:a762fb47-1636-aa70-ac26-4c2722af538e
msgctxt "h75648220gc125g471cg9983g669a682d836b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = a93f4188-effd-0040-72b9-6dae71999415
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:a93f4188-effd-0040-72b9-6dae71999415
msgctxt "hbb40585agb594g4aa8ga96bg6377caac9e57"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = aa80c1a1-aa48-910f-2914-1d2de4daa091
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:aa80c1a1-aa48-910f-2914-1d2de4daa091
msgctxt "hca8e4ae2g938ag4353ga3e4g2bf5af471625"
msgid ""
"Somewhere quiet, close to nature. Where the sun can warm us, and the moon "
"can watch over us as we sleep."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = ad44a28f-44dc-296f-18d6-76d288dc390f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:ad44a28f-44dc-296f-18d6-76d288dc390f
msgctxt "h60f1699fg69c4g4b90ga382g88d415fd6e80"
msgid "They took us both."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = ae294ef8-462f-3e25-0602-ea06c5b1e9aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:ae294ef8-462f-3e25-0602-ea06c5b1e9aa
msgctxt "hec2eeeffgbf88g4e0cgb6e8g1c518c4ccbc7"
msgid "As am I."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = af631689-5272-492a-d48b-8b95c9e48798
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:af631689-5272-492a-d48b-8b95c9e48798
msgctxt "hbce3fe00g553dg4569g8cb0gffe2a1273ece"
msgid ""
"I can only imagine. It may take a little time before I'm fit to give many "
"answers though. Forty years in captivity have left my mind... cobwebbed. But "
"it will clear, given some rest."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = b05f9840-4d1d-79a7-8e9a-62425d1ab980
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:b05f9840-4d1d-79a7-8e9a-62425d1ab980
msgctxt "had12ebebg7564g4bb9g9ef1g7663392a57c0"
msgid "That name - I'm still not used to hearing it. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = b0ea6f07-ed37-40ac-b140-d57b655acc79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:b0ea6f07-ed37-40ac-b140-d57b655acc79
msgctxt "hb4b2a709gf221g42bbg8dcbgdf4938a32af4"
msgid ""
"Jenevelle. I still can't believe you freed us - that I'm standing here with "
"you. I'd ask you to slap me so I know it's real, but I don't think I'm yet "
"strong enough to bear it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = b125a503-01c9-4102-90b1-2f19c037ae61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_DiscussedName(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_DiscussedName(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:b125a503-01c9-4102-90b1-2f19c037ae61
msgctxt "hb69ec493gf8d0g46d6g97fbge833e9c58dc1"
msgid "That name. I don't know how I feel about it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = b41bccd1-30e5-37a9-35b7-734227abf115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:b41bccd1-30e5-37a9-35b7-734227abf115
msgctxt "h631c2164gbad1g45c8gabe2g70f113643932"
msgid ""
"That should have been the day you came of age, and into the Moonmaiden's "
"teachings. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = b61e5345-248c-bf9a-d812-c9e355156245
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:b61e5345-248c-bf9a-d812-c9e355156245
msgctxt "h1f8ab658g7e44g4250gbec6g8e48233463b6"
msgid "Selûne's blessings to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = b92632df-cc36-3513-a821-44e390da9647
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:b92632df-cc36-3513-a821-44e390da9647
msgctxt "hce3abb03g2b02g4949gabf7g4b47977a7e37"
msgid ""
"You have your mother's wisdom. Yes. I should gather my strength. I've waited "
"so long for this, a little longer won't do any harm..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = ba348ef5-ede6-3913-25f9-91fef63c2388
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_SHTortureHistoryDone(1) = False
#.      - CAMP_ShadowheartFather_Event_SHAskedAboutTorture(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_SHTortureHistoryDone(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:ba348ef5-ede6-3913-25f9-91fef63c2388
msgctxt "h754d67ccg0043g4cd3g98bdg0652364aa7c3"
msgid ""
"You promised you'd tell me what I did to you both. I'm ready to hear it now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = bc57369c-5d45-b7f0-649b-a943d6703a7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:bc57369c-5d45-b7f0-649b-a943d6703a7c
msgctxt "hd6a477d5g86c0g4724gbc5eg017f7970f97d"
msgid ""
"Nor is Jenevelle. Perhaps that is something I shall need to talk to her "
"about, when the time is right. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = c158a1b2-c692-d1a2-f7ce-5834aec0f8f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:c158a1b2-c692-d1a2-f7ce-5834aec0f8f1
msgctxt "hd477d029g9746g4f9dgbe6eg9be4949bb646"
msgid ""
"The Moonmaiden's blessings are many. She taught me to control the curse - "
"but she could not teach me to control my paternal instincts."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = c1de0c29-e80e-62cc-850c-dbedaae22f00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:c1de0c29-e80e-62cc-850c-dbedaae22f00
msgctxt "h19a6ce1cgabc7g44d8ga90ega6fe0fd88867"
msgid "A great deal of damage was done to our family, but we can still heal."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = ca276e7d-051d-b464-4365-bb8e1aff26b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:ca276e7d-051d-b464-4365-bb8e1aff26b4
msgctxt "h0f11f148gde1eg4fe6g8dd4ge5482da64c36"
msgid ""
"But perhaps this was always meant to be. Perhaps the Moonmaiden's path was "
"merely longer for you than we knew."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = cb68d9f9-3385-4c90-79f7-e705359ed810
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:cb68d9f9-3385-4c90-79f7-e705359ed810
msgctxt "hfbbf4ebag32e6g4bd5g9f85g50fdf6e14355"
msgid "You should rest. There'll be time to talk later."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = cc7480c4-2171-9606-60ab-1b835e3b75b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:cc7480c4-2171-9606-60ab-1b835e3b75b3
msgctxt "h4b1aece6gf116g4bbegbebdgf3215e2757e6"
msgid ""
"I've gleaned enough from word around this camp to know you're more than "
"capable. You will prevail."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = cfbf9b15-005e-2ce7-6b4b-c5482b1e3c29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:cfbf9b15-005e-2ce7-6b4b-c5482b1e3c29
msgctxt "h9d21029fg19a5g45a4gb8a2ge39d088240c4"
msgid ""
"The worst part was not anything you did to us - it is what they had done to "
"you. You didn't recognise us. Those eyes I had wiped tears from now looked "
"at me like a stranger."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = d3c2a458-90cc-04c9-1fb6-70f3268808b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:d3c2a458-90cc-04c9-1fb6-70f3268808b5
msgctxt "ha7f11260g6f4eg48d6gaf03gd1c256aa858c"
msgid ""
"I... I feared I would give in then, but your mother's strength bolstered me. "
"She never gave up calling you daughter, no matter what you said. Or did. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = d3fbdf34-8de1-f19b-3b63-e3b6022ff103
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:d3fbdf34-8de1-f19b-3b63-e3b6022ff103
msgctxt "h410eafd1g6b4dg4884g80e7g057b0d7eeb38"
msgid "If you have not changed after all this time, I believe you are safe."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = d51cf36d-77d1-4efa-d373-e64d62d21627
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:d51cf36d-77d1-4efa-d373-e64d62d21627
msgctxt "ha7022e3agc7ebg40aag835dge3d54879e36f"
msgid ""
"Beyond that, your mother will need my care - and yours too, if you wish to "
"join us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = d5305cf5-ddb7-331a-45c9-9326e386da24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:d5305cf5-ddb7-331a-45c9-9326e386da24
msgctxt "h22fd9901gbb8dg44dbg8cb1ge3f1d0ea3d34"
msgid "There must be stories you could tell... but perhaps another time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = d588134c-238e-78cb-8c63-103c5134560b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:d588134c-238e-78cb-8c63-103c5134560b
msgctxt "hac355e9dg0eb4g4240ga984g6c1520337e23"
msgid ""
"Of course. Only a fool would alienate his child over a name. Shadowheart "
"must determine her own path - that is what the Moonmaiden teaches."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = d6e5b9e5-6ecb-8388-fdef-cc84bd463253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:d6e5b9e5-6ecb-8388-fdef-cc84bd463253
msgctxt "h5b0b5dbfg1109g445dga95cg189511b15d29"
msgid ""
"Give it time. Give us time. This is a great deal to take on at once - for me "
"as well."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = d7aea618-1183-1310-6972-9bf61459d508
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:d7aea618-1183-1310-6972-9bf61459d508
msgctxt "h6b571c82gd373g411cg84fagdb31f7346325"
msgid ""
"I'm sorry, but what happened in that room... it must stay within the family. "
"Just know that we endured, and are grateful for your help."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = dac31d67-eb89-a723-a211-52f8a71e4d56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:dac31d67-eb89-a723-a211-52f8a71e4d56
msgctxt "h22074ab6gbb5cg4a22gaec5g9d39bacfadaa"
msgid ""
"I should have told you of my curse before that night. Then... everything "
"would have been different."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = e137789c-2900-1f90-3bfa-b24671916769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:e137789c-2900-1f90-3bfa-b24671916769
msgctxt "hc2fa288fg8f66g4b0fga633gf1be259cde12"
msgid "I've heard enough."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = e1b8f8e5-4ae6-5b02-0948-f97d5755589d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:e1b8f8e5-4ae6-5b02-0948-f97d5755589d
msgctxt "h39bbcfaegf326g4629g9705g720a5a0a570c"
msgid ""
"I had to find you - to bring you home - and I had to do it quickly. In my "
"haste, I made a terrible mistake."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = e26525ff-ee96-d89f-faab-17cb20a7d6d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_DiscussedPast(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_DiscussedPast(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:e26525ff-ee96-d89f-faab-17cb20a7d6d7
msgctxt "he4abf171ga0adg477bgbdb4g716c47e5fff3"
msgid ""
"What happened during all those years? What did they make your daughter do to "
"you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = e2b5ecca-0dcb-7209-5ac0-cc504d5be9fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:e2b5ecca-0dcb-7209-5ac0-cc504d5be9fd
msgctxt "h30a53ceeg2384g467ag8326ga8a455a6ca58"
msgid ""
"Forgive me, I am still weak - aching limbs, fogged mind. I'll prove better "
"company after I've rested, I assure you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = e38ebac9-a6a4-1f07-ac85-862d6ee09cf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:e38ebac9-a6a4-1f07-ac85-862d6ee09cf9
msgctxt "h0ec4ce29gc630g4929gb62bg59ee5ad45b52"
msgid ""
"But you were not alone in the woods. We caught a Sharran spy near our "
"village, and learned that his accomplices sought to abduct you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = e7ef8506-e92c-d403-ac8f-afed2cc8b804
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartFather_Event_NameFollowup(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartFather_Event_NameFollowup(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:e7ef8506-e92c-d403-ac8f-afed2cc8b804
msgctxt "h9b1ec731gcc8eg4b92ga535g66791642f8b2"
msgid "You're not upset, are you? About my name?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = e9523b02-cc56-0e9d-a392-3fc82a703408
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:e9523b02-cc56-0e9d-a392-3fc82a703408
msgctxt "hb6ae5e7fgfa6fg4ee7g8232gfbfe2de2fb1a"
msgid ""
"Not just with the pain, but with the knowledge that every time we felt it, "
"your true self was being punished, for trying to break through their "
"indoctrination."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = ecba92d7-4bd3-8c2c-c6e3-8ff88f5fbb03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:ecba92d7-4bd3-8c2c-c6e3-8ff88f5fbb03
msgctxt "h4a777ef2g215fg49e4g93f2g0f16f82d9946"
msgid ""
"You were to come of age that night - left alone in the woods, and using only "
"Selûne's guidance to find your way back to us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Player
#. NodeID = ef4ad73a-308a-4a9b-01d9-f0ec323a2104
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:ef4ad73a-308a-4a9b-01d9-f0ec323a2104
msgctxt "h7687f124g7c6fg43d7ga729gded9183b96c6"
msgid ""
"There is nothing old about these wounds - they've never been allowed to "
"heal. I would know."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = f0b57a3e-c836-0acf-d819-d6326bf5d97c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:f0b57a3e-c836-0acf-d819-d6326bf5d97c
msgctxt "he88fa6c5g1d6eg4549g9abdgab8e22b63f21"
msgid ""
"Unfortunately I was unable to stop what befell us, as neither elf nor wolf."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = f724cf04-9224-0d08-c083-d767c09272cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:f724cf04-9224-0d08-c083-d767c09272cb
msgctxt "h291ba6c7gc479g4e9dg8778ga8e8136c0328"
msgid ""
"A name is nothing. Your happiness is what matters. Just... forgive your "
"father the occasional slip of the tongue. I will adapt, given time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = f86912f0-ffc3-531b-2f67-d37b519aeb8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:f86912f0-ffc3-531b-2f67-d37b519aeb8d
msgctxt "hff72e05bgd6abg469cgb50cg76e3b4306e56"
msgid ""
"I am a lycanthrope, but your mother is not. It was a toss of the coin to "
"determine if you inherited that side of me. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = fa568280-b4f1-1cf1-fb07-58164e42c108
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:fa568280-b4f1-1cf1-fb07-58164e42c108
msgctxt "h75ffcce4g4907g4d34g86d5gb51f3477c89e"
msgid ""
"I am, but with Selûne's guidance, I learned how to control the beast long "
"ago - I only let it loose again when my family was threatened."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather
#. Speaker = Arnell Hallowleaf
#. NodeID = fe3ef73c-b883-2e2c-9fcb-47f14204d6b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartFather:fe3ef73c-b883-2e2c-9fcb-47f14204d6b4
msgctxt "hb5f616c1g207cg4c13g8166g5f287b38239c"
msgid ""
"I'm afraid my strength has not returned just yet. Decades in that place has "
"left me maimed, body and soul."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 0accda11-d98f-a676-20e7-3868f53a1f3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:0accda11-d98f-a676-20e7-3868f53a1f3e
msgctxt "h41d916c9g45b0g4672g95f7g3ffdfbecd3f5"
msgid "Apologies. Even the littlest thing wears me out."
msgstr "미안하구나. 이런 작은 일에도 지쳐서 그만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 10199a18-2c5d-12e9-af66-ce2c57699835
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:10199a18-2c5d-12e9-af66-ce2c57699835
msgctxt "h37078fc5g8165g4229gaf07g4bb1d386751a"
msgid "Much time was lost, but no more. Now we can be there for our daughter."
msgstr "오랜 세월을 헛되이 보냈지만, 더는 그럴 일 없어. 이제 딸아이와 함께할 수 있게 되었으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 1aa60971-0a50-72eb-f46b-e0b0a1b50dde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:1aa60971-0a50-72eb-f46b-e0b0a1b50dde
msgctxt "h2c883ed4g1582g46ccg8ed0ge6a414fd92e5"
msgid "I think I need to clear my head now, dear... we'll speak later."
msgstr "지금은 생각을 정리해야 할 듯하구나… 이야기는 나중에 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 1eb2f30a-a679-3d51-497f-abf7f6619c1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:1eb2f30a-a679-3d51-497f-abf7f6619c1d
msgctxt "hafcb3d58g9538g4a7ag9b0bg484d22db79c8"
msgid ""
"It comes and goes... and eventually, it will come more often than it goes."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 21eac5bb-f4a5-3f08-5b33-5b313eec8bfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:21eac5bb-f4a5-3f08-5b33-5b313eec8bfe
msgctxt "hba27a278g0a42g45e8g8567g167edc40f539"
msgid ""
"We shall remain here at camp and continue to recover whatever strength we "
"can. Then, perhaps, when all is said and done... we can be a family again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 229cc9ee-3d39-e5be-87bb-ad26ff25e794
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_DiscussedFeeling(1) = False
#.      - CAMP_ShadowheartMother_Event_MotherConfusedNames(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_DiscussedFeeling(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:229cc9ee-3d39-e5be-87bb-ad26ff25e794
msgctxt "h9dbe5221g65f0g4dedga05ag2fd81c3abd9e"
msgid "How do you feel now? You seemed... confused before."
msgstr "지금은 좀 어떠신가요? 저번에는… 혼란스러워 보이셨는데. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 239ecc20-27cb-4cf7-b144-e3c0cb55fdcc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:239ecc20-27cb-4cf7-b144-e3c0cb55fdcc
msgctxt "haaba008dgaf2dg46e8g9c51g488876342176"
msgid ""
"I heard birdsong, at dusk, coming here. You don't know what it's like to "
"hear that music again after so long without... thank you."
msgstr "해질녘에 새들의 노랫소리가 들려오더구나. 오랜 세월 끝에 그 노랫소리를 다시 듣게 될 줄이야… 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 2eb0fbab-a351-b23d-529e-d24ff0da867d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:2eb0fbab-a351-b23d-529e-d24ff0da867d
msgctxt "hd9114d7dg1fbdg488cgacaag0796fb69fadd"
msgid ""
"Better, in a sense... but you may need to prepare yourself, daughter. Shar "
"took a great deal from me... and time will eventually take the rest. Sooner "
"than you or your father would like, perhaps."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 3136c17b-b258-8ddb-da2f-a41a460b3973
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:3136c17b-b258-8ddb-da2f-a41a460b3973
msgctxt "hc696f777g2f8bg4a64ga1a8g4508e28bc8c5"
msgid "You surpassed those daydreams in every way."
msgstr "꿈에만 그리던 그 모습보다도 훨씬 아름답구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 38bffb06-c9a5-4320-11d5-59cfab001688
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:38bffb06-c9a5-4320-11d5-59cfab001688
msgctxt "he40046e6gfd66g4bcdg8195g01a1a6754240"
msgid ""
"Just one - take care of yourself. I know you have more struggles yet to come "
"out there, but I do not want to lose my daughter so soon after I found her "
"again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 3c843dda-e38d-b7f1-280d-6228893d07bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:3c843dda-e38d-b7f1-280d-6228893d07bc
msgctxt "hd3f9aaecg3b12g43begb91fg0ef8b8c832b0"
msgid ""
"Time is far crueller than Shar could ever be. I... do not think I will ever "
"get better. But I wish to make the most of the time I have left. With my "
"family."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 3d53d052-6625-a423-1b2e-36b05d5c1b33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:3d53d052-6625-a423-1b2e-36b05d5c1b33
msgctxt "hb73de09agfc24g452bgb631g09e18eb8cfdd"
msgid "You should rest. There'll be time to talk later."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 44497417-7d7e-4ca8-bf5c-cc6b3e4ad8d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:44497417-7d7e-4ca8-bf5c-cc6b3e4ad8d8
msgctxt "ha8ad4b04gbf2cg46eagb7b9g77652ed6dc83"
msgid ""
"Not yet. I think she's still trying to find the words. She still feels "
"responsible  I fear... I don't want her to punish herself."
msgstr ""
"아직은. 그 아이는 아직 무슨 말을 해야 할지 모르는 듯하더구나. 여전히 책임을 느끼는 것 같던데… 그 아이가 너무 자책하지는 말았으면 "
"한단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 4e1b15d5-02c2-113d-010d-e365b9de5dea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:4e1b15d5-02c2-113d-010d-e365b9de5dea
msgctxt "h4de97e8agdc0cg4620ga21dg0136364b9ffe"
msgid ""
"Old. I was a young woman when they seized me... Arnell and I had hoped Jen "
"would be joined by siblings... but that dream's gone now, and there's a "
"stranger in the mirror."
msgstr ""
"나이 든 기분이지. 막 갇혔을 때는 아가씨였는데… 아넬과 나는 젠에게 동생이 생겼으면 했는데… 그 꿈은 이제 온데간데없고, 거울 속엔 "
"낯선 모습만 있구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 507c79c7-bcb4-e764-d21e-4dfe6451c7d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:507c79c7-bcb4-e764-d21e-4dfe6451c7d2
msgctxt "hb31f391eg8995g45e3g83dbg7bacb4a6c99e"
msgid "Shadowheart. May Selûne guide you always, my daughter."
msgstr "섀도하트, 내 딸아. 셀루네 여신의 가호가 함께하기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 50a8239a-0016-ed11-68a8-3da97cc36619
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:50a8239a-0016-ed11-68a8-3da97cc36619
msgctxt "he4a25d8ag58cbg478agb8eeg8080cc05e2d0"
msgid "Shadowheart. I hope all is well, my dear."
msgstr "섀도하트. 잘 지냈느냐, 내 딸아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 512afac7-9a75-ec39-9a41-cab31b24ae89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowhert_Mother_Event_SHAsksHowMotherFeels(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowhert_Mother_Event_SHAsksHowMotherFeels(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:512afac7-9a75-ec39-9a41-cab31b24ae89
msgctxt "hfa43f115g49bdg497bg9749gbb3811d6cb93"
msgid "How do you feel?"
msgstr "기분이 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 58d064f6-03e2-3e07-6d04-1a440c90c4ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:58d064f6-03e2-3e07-6d04-1a440c90c4ca
msgctxt "hf629cb36g3708g4014g9213g55ccca62bd10"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 5b904550-ba05-4493-9a80-58cb36d12a7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartMother_Event_InsultedBySharran(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:5b904550-ba05-4493-9a80-58cb36d12a7b
msgctxt "h586a2caegc412g4247g92feg1f8af00fccf8"
msgid "Leave me. We have nothing more to discuss, Sharran."
msgstr "저리 가라. 더 이상 내가 해줄 말 따윈 없다, 샤의 신도여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 5cb9e87f-b12b-1cbc-b942-e39782a79e64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:5cb9e87f-b12b-1cbc-b942-e39782a79e64
msgctxt "hea301c8ag9368g46bag8facg3f4057c0585f"
msgid ""
"I... I knew this, even when I first fell for your father. He is destined to "
"outlive me, as are you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 5d598e3d-9959-6133-8687-5720c2cb6aca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:5d598e3d-9959-6133-8687-5720c2cb6aca
msgctxt "hb2b821a0g4d2cg4cc4ga714gc9213f8bee69"
msgid ""
"My hands... they're not my hands. And my reflection... I'm not used to that "
"woman yet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 60c7b829-9110-b1f6-e366-cd73d72ba7bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:60c7b829-9110-b1f6-e366-cd73d72ba7bd
msgctxt "h90aa4526g4dfcg429bg994fg4aa4b0246d4a"
msgid "You're too generous. I should have freed you sooner."
msgstr "어쩜 그리 마음씨 좋으신지… 이제야 풀어드려서 죄송해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 645683ad-d6ba-f2ae-a6bf-d60a572fc63d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartMother_Event_MotherMortalityDiscussed(1) = False
#.      - CAMP_Shadowhert_Mother_Event_SHAsksHowMotherFeels(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartMother_Event_MotherMortalityDiscussed(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:645683ad-d6ba-f2ae-a6bf-d60a572fc63d
msgctxt "hd228bb98gdc0ag4987gbb13gb3a6956208e8"
msgid "Are you feeling any better now?"
msgstr "지금은 좀 나아지셨는지요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 6b653fca-227b-2d95-2970-4d60e47e2492
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartMother_Event_MotherConfusedNames(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:6b653fca-227b-2d95-2970-4d60e47e2492
msgctxt "h5ee9e750geb2cg4807g87eeg8a52e5aa14af"
msgid "Have you spoken to Shadowheart since?"
msgstr "섀도하트와는 이야기해 보셨나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 77a92c9a-85fc-9d36-b724-722d0f136c73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:77a92c9a-85fc-9d36-b724-722d0f136c73
msgctxt "h8b8757dcg59a5g4d90g8cc4gbe667779a8ed"
msgid "Is there anything I can do for you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 7f434d88-0c67-7155-ac47-4a65a6666a89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:7f434d88-0c67-7155-ac47-4a65a6666a89
msgctxt "hf998b65dgbd90g4cb3ga5b6g10e7284c8c30"
msgid ""
"Besides, I'm tougher than I look - I'll fight on, now that I have something "
"to fight for."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 83a1f37e-e8ee-0975-631a-08d74b5593ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartMother_Event_MotherMortalityDiscussed(1) = False
#.      - CAMP_Shadowhert_Mother_Event_SHAsksHowMotherFeels(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartMother_Event_MotherMortalityDiscussed(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:83a1f37e-e8ee-0975-631a-08d74b5593ab
msgctxt "h02c5b133g7d13g4d88gab27g704b447503a2"
msgid "How do you feel?"
msgstr "기분이 어떠세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 84c53c31-04ae-7633-1665-d508a3516ded
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:84c53c31-04ae-7633-1665-d508a3516ded
msgctxt "h789f32cbg218fg49c2gbe5ag1d729e5d00b0"
msgid ""
"Oh. I see. More than a friend. Apologies, I forget my little girl is not so "
"little any more."
msgstr "아, 그렇지. 친구라고만 하면 안 되겠네. 실례했구나. 내 아이도 이제 다 컸지, 참."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 8beb5dd9-395f-a600-5bc7-5a2203227ed8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:8beb5dd9-395f-a600-5bc7-5a2203227ed8
msgctxt "h8ec1726bgea89g4e8aga767g300bfd42c7ac"
msgid ""
"Shed no tears - we've been blessed with a second chance - and who is to say "
"how long we'll have? More than I ever hoped for, certainly. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 8e0c4de3-58c1-9f99-b816-d8b5cab78e9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:8e0c4de3-58c1-9f99-b816-d8b5cab78e9d
msgctxt "h375744dagb66fg4d38g8041g889783b211b8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 8f67db5b-64cf-373f-e64d-30ce3a646e92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:8f67db5b-64cf-373f-e64d-30ce3a646e92
msgctxt "ha289ec3fgf848g4308g9041g2d8066800c37"
msgid ""
"Slow. Tired. It's strange... I feel like I've mislaid myself in some old "
"woman's body."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 9033ecc1-3339-a3ac-ab6b-f53fe59b0895
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9033ecc1-3339-a3ac-ab6b-f53fe59b0895
msgctxt "he8abe694g4a13g4c69g8becg2331c2ae2524"
msgid "Moonmaiden's blessings to you."
msgstr "달처녀의 축복이 있기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 91f01d7c-51c4-4ee0-3f92-55eb97ed7283
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:91f01d7c-51c4-4ee0-3f92-55eb97ed7283
msgctxt "ha34bed3bg55dcg483dg9336g9fa59d46f722"
msgid ""
"Some. I think she's still trying to find the words. She still feels "
"responsible  I fear... I don't want her to punish herself."
msgstr ""
"약간은. 그 아이는 아직 무슨 말을 해야 할지 모르는 듯하더구나. 여전히 책임을 느끼는 것 같던데… 그 아이가 너무 자책하지는 말았으면 "
"한단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 928644b1-feac-bd75-f0a1-2c7c2ac08f6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:928644b1-feac-bd75-f0a1-2c7c2ac08f6a
msgctxt "h65023054g67e5g4d7fg9177g2169497449c2"
msgid "We must not live in fear of loss. That is not truly living."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 94385072-8c73-3194-02c2-1175302ac75e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_DiscussedFuture(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_DiscussedFuture(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:94385072-8c73-3194-02c2-1175302ac75e
msgctxt "hcfa85ed5gf248g472cgb499g4f8832d7c79e"
msgid "What comes now?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 967b6970-5832-955d-4cca-4970d82c2309
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:967b6970-5832-955d-4cca-4970d82c2309
msgctxt "hb9627e6cg9b6fg4624gae29gde5eec13403a"
msgid ""
"You couldn't have. You knew nothing - just like they wanted. But it doesn't "
"matter now. It's all behind us."
msgstr "어쩔 수 없었잖니. 놈들이 바라던 대로, 넌 아무것도 몰랐으니까… 하지만 이제는 아무래도 좋단다. 다 지나간 일이니 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 96887f03-e3dc-261b-38ba-31ff7be5eda2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:96887f03-e3dc-261b-38ba-31ff7be5eda2
msgctxt "he5ca5560g31bdg4a1agba89g26d50d7d2b6b"
msgid ""
"We are a small family - smaller than I hoped for - but we are whole again."
msgstr "작은 식구이지만, 크지 못한 게 아쉽지만… 그래도 다시금 한자리에 모였구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 986bb0b1-0725-a146-2652-9b6904545874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:986bb0b1-0725-a146-2652-9b6904545874
msgctxt "h455fe2b6g63bbg4336ga1c4gfecfc5e4f38a"
msgid ""
"Though the ache in my bones would suggest otherwise. A little rest shall do "
"me wonders. Yes... then I'll feel more like myself once again."
msgstr ""
"관절에 느껴지는 아픔은 아직 완전히 지나간 건 아니지만, 조금 쉬고 나면 낫겠지. 그래… 그러면 내 몸은 다시 예전처럼 팔팔해질 게야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 9d0a8577-1299-aa56-b83c-cba5ae8bb190
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9d0a8577-1299-aa56-b83c-cba5ae8bb190
msgctxt "h8abc6f7dg5e5cg409egb2b4gdfd4e4bb41b7"
msgid ""
"Arnell is your husband. I'm "
"[GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 9d0a8577-1299-aa56-b83c-cba5ae8bb190
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9d0a8577-1299-aa56-b83c-cba5ae8bb190
msgctxt "hdc8bc495g7af0g4877g885cgf507c5d4199d"
msgid ""
"Jenevelle is your daughter. I'm "
"[GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = 9d0a8577-1299-aa56-b83c-cba5ae8bb190
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9d0a8577-1299-aa56-b83c-cba5ae8bb190
msgctxt "haf52bfb0gdc7cg451aga938g53b3299f3be2"
msgid ""
"I think you may be confused - I'm not Shadowheart, I'm "
"[GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 9de73cd9-fb00-a436-08b4-1a86e27f71ca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartMother_Event_MotherConfusedNames(1) = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9de73cd9-fb00-a436-08b4-1a86e27f71ca
msgctxt "h27bd6e96gb9dbg47fagaa5agbfda22754d96"
msgid "I should rest a little. We'll talk soon, Arnell."
msgstr "조금 쉬어야겠구나. 나중에 또 이야기하자, 아넬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 9de73cd9-fb00-a436-08b4-1a86e27f71ca
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartMother_Event_MotherConfusedNames(1) = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9de73cd9-fb00-a436-08b4-1a86e27f71ca
msgctxt "hbcf5475egbe53g404dg8a57g2ce57c16a62a"
msgid "I should rest a little. We'll talk soon, Jenevelle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 9de73cd9-fb00-a436-08b4-1a86e27f71ca
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartMother_Event_MotherConfusedNames(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9de73cd9-fb00-a436-08b4-1a86e27f71ca
msgctxt "h8e3377abg549bg4a59gaa97g8d63c820e216"
msgid "I should rest a little. We'll talk soon, Shadowheart."
msgstr "조금 쉬어야겠구나. 나중에 또 이야기하자, 섀도하트."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = 9e700c80-98f1-abb3-04f8-9e5e6cfb1920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:9e700c80-98f1-abb3-04f8-9e5e6cfb1920
msgctxt "h5af34045g6c5ag49e5gb302g9998899c0c16"
msgid ""
"My daughter found her way in the end. And found a good friend in you along "
"the way."
msgstr "내 딸이 마침내 길을 찾았구나. 그 과정에서 너라는 좋은 친구도 만났고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = aab83a4a-89b6-4055-6430-cf43804ff75f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_DiscussedFuture(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_DiscussedFuture(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:aab83a4a-89b6-4055-6430-cf43804ff75f
msgctxt "ha13af26dgd2c7g4d7cg848agbbecc9a7408c"
msgid "What comes for you now?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = b8f89706-1717-bf03-79aa-092d686feee6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartMother_Event_InsultedBySharran(1) = False
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:b8f89706-1717-bf03-79aa-092d686feee6
msgctxt "h37c97837g050eg46c1ga824g0c99c4cefad0"
msgid ""
"You shouldn't be here. You should still be rotting in the dark, at the "
"Nightsinger's pleasure."
msgstr "당신이 뭔데 여기 있어? 나이트싱어가 바라던 대로 어둠 속에서 썩고 있어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = b8f89706-1717-bf03-79aa-092d686feee6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartMother_Event_InsultedBySharran(1) = False
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:b8f89706-1717-bf03-79aa-092d686feee6
msgctxt "h1c3d3a60g7a18g47d4gbcdfgb9a3f1c49778"
msgid "You shouldn't be here. You should still be rotting away in the dark."
msgstr "당신이 뭔데 여기 있어? 어둠 속에서 썩고 있어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = b8f89706-1717-bf03-79aa-092d686feee6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_ShadowheartMother_Event_InsultedBySharran(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:b8f89706-1717-bf03-79aa-092d686feee6
msgctxt "h8064e19bgd521g4e78g91b9g27f0c35798e1"
msgid ""
"You shouldn't even be here. You're a liability and a distraction for "
"Shadowheart."
msgstr "당신이 뭘 잘했다고 여기 있어? 섀도하트의 걸림돌이자 애물단지인 주제에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = b9325b99-9f8b-7d41-175c-34cfefa3e57c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_ShadowheartMother_Event_InsultedBySharran(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:b9325b99-9f8b-7d41-175c-34cfefa3e57c
msgctxt "h020eefd6gc1b0g4e7fg9c49gd1eb52865d04"
msgid ""
"Such cruel, pointless words Shar forces upon your lips. Leave me - I won't "
"have my joy spoiled by her pawn."
msgstr "샤 여신이 시키는 그 말, 어쩜 그리 잔인하고 무의미할까. 저리 가라. 한낱 장기말 주제에 내 기분을 상하게 하지 말거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = c2d571af-423f-a4a3-ac70-6939feec5057
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:c2d571af-423f-a4a3-ac70-6939feec5057
msgctxt "hd1213644gb3b7g4ef9gb5e0g793cac791083"
msgid "How do you feel?"
msgstr "기분이 어떠세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = c4948ef9-213d-72b0-5eff-81d9a8b222eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:c4948ef9-213d-72b0-5eff-81d9a8b222eb
msgctxt "h2fe72ce1g4396g48f2gb4ccg7aaf90341912"
msgid "You won't need to daydream any more. I'm here, for real."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = c889e56c-d7ba-e174-1b60-b4aa03831f1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:c889e56c-d7ba-e174-1b60-b4aa03831f1f
msgctxt "h0ea42eafg13b5g4ab0gb88fgfcc4f9529c68"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = c975355f-0cb2-54be-645d-b8ab0190d939
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:c975355f-0cb2-54be-645d-b8ab0190d939
msgctxt "hba857fe4ge026g4160g866eg48cab1b04641"
msgid "I'm glad things worked out for you and your family."
msgstr "어머님께도 가족에게도, 일이 잘 풀려서 다행이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = d37c2b58-b866-9dd7-1d7e-fe67b5ea60ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:d37c2b58-b866-9dd7-1d7e-fe67b5ea60ba
msgctxt "ha3dc4553gd625g4463g8b32g91eb6a774c28"
msgid ""
"Don't worry - I shall pull my weight and help how I can. After so long in "
"captivity, it feels good to use my hands again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = d3e27eb0-5671-6640-6c03-86d1b8187b26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:d3e27eb0-5671-6640-6c03-86d1b8187b26
msgctxt "h782ee8a5ga68cg4f72g94b2g77b3b3fba276"
msgid ""
"Now this old lady will be getting in the way in your fine camp, I'm afraid. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = d7431f28-03a0-5b86-cb6f-ab0f8ec39315
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:d7431f28-03a0-5b86-cb6f-ab0f8ec39315
msgctxt "h0cd84763gc977g47cdg8e63g7b8a7afb8554"
msgid "I think I need to clear my head now, dear... we'll speak later."
msgstr "지금은 생각을 정리해야 할 듯하구나… 이야기는 나중에 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = d95e4579-58e6-da74-5b31-3124d25174db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_DiscussedFeeling(1) = False
#.      - CAMP_ShadowheartMother_Event_MotherConfusedNames(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_DiscussedFeeling(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:d95e4579-58e6-da74-5b31-3124d25174db
msgctxt "hf789ca99gb25fg469ag836cgf8446721f090"
msgid "How do you feel?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = d97d3402-90e9-c55a-619f-b63fa8138713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:d97d3402-90e9-c55a-619f-b63fa8138713
msgctxt "hb99a353bgf3a1g4019ga3bdg620de2ea6610"
msgid "Oh, I see. Do forgive me."
msgstr "아, 그랬지. 용서하려무나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = df339df3-4ff9-f119-240b-5a96caeb8653
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:df339df3-4ff9-f119-240b-5a96caeb8653
msgctxt "h3f7dd09eg8e03g4fa9ga17egd48009608fd0"
msgid ""
"But I shall persevere. A little rest shall do me wonders. Yes... then I'll "
"feel more like myself again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = e089901d-c67f-b6a7-fe22-1e2b62523fe3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_Mother_Event_Hasmet(1) = False
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:e089901d-c67f-b6a7-fe22-1e2b62523fe3
msgctxt "hee82663cg57c3g4c29g8113g8fc13e29e37d"
msgid "I think things will be better, now that we've talked to Shadowheart."
msgstr "섀도하트와도 이야기했으니, 일이 차차 잘 풀릴 게야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = e5ff0e74-8797-b487-5839-efbe6f1b7e8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:e5ff0e74-8797-b487-5839-efbe6f1b7e8d
msgctxt "ha6c8f33bg004bg4246ga8f6g06cd8f9e110c"
msgid "Rest, yes... we'll talk more later. Once I feel more like myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = eec04f28-1084-649c-5ebb-b2c170929ff0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:eec04f28-1084-649c-5ebb-b2c170929ff0
msgctxt "hacb21f79g32afg4cc4gbadag4e9cb8970c5f"
msgid ""
"Only you can say. It seems your father and I have returned to a world in "
"turmoil, and I sense you have a part to play in righting things."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = f5b88d43-4cbb-4f30-b6b2-a9f75f478ecf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Shadowheart_DaughterTears = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_Mother_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:f5b88d43-4cbb-4f30-b6b2-a9f75f478ecf
msgctxt "h0400db1cga8b2g437bg8b96ge587af811f8b"
msgid ""
"My girl. Let me look at you. For so long I had to imagine what you were like "
"- what you had grown up to be."
msgstr "내 새끼, 얼굴 좀 보자꾸나. 네가 어떤 모습일지 오랜 세월을 상상해 왔단다… 어른이 된 너는 어떤 모습일지를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = f879b59f-7b96-2d79-f4ab-ad6e15935052
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:f879b59f-7b96-2d79-f4ab-ad6e15935052
msgctxt "hdbf8e255g21f8g402agb7bag6f538c8f7592"
msgid "But I still have my teeth. That first apple was worth the wait."
msgstr "이빨이 남아있는 건 불행 중 다행이더구나. 처음으로 먹어본 사과의 그 맛이란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Emmeline Hallowleaf
#. NodeID = f90175ca-b968-75a0-a1ca-2b041fb319b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:f90175ca-b968-75a0-a1ca-2b041fb319b6
msgctxt "h1dac408fg20e7g4473gab74ge5fb13a0334c"
msgid ""
"I know you are. We have so much to catch up on... in a little while. After "
"I've had some rest. Once I feel more like myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother
#. Speaker = Player
#. NodeID = fa9e2ca9-6139-169f-5dce-ba2b08689a27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ShadowheartMother:fa9e2ca9-6139-169f-5dce-ba2b08689a27
msgctxt "h161d568fg2ceeg48b8g9c25g89a069934741"
msgid "You're welcome."
msgstr "천만에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 086c89f7-836b-878c-cd64-0967579156f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:086c89f7-836b-878c-cd64-0967579156f3
msgctxt "h3e922a88gd596g4a8ag8c74g47b69ec473e6"
msgid "Who says you have to feel anything?"
msgstr "네가 뭘 느껴야 한다고 누가 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 115adad0-fa3e-c9a9-e1df-3d042ebb0bbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:115adad0-fa3e-c9a9-e1df-3d042ebb0bbd
msgctxt "h22ec1d55g21d6g46d6g9167g46c23e463154"
msgid ""
"Don't thank me - I'm breaking Lady Shar's teachings just by doing so... but "
"sometimes you have to be practical."
msgstr "내게 고맙다고 하지 마. 난 지금 샤 여신의 가르침을 어긴 거니까... 그리고 때로는 너도 합리적일 필요가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 154a70ed-9fa4-81f6-4f7a-9ea838cdf9d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:154a70ed-9fa4-81f6-4f7a-9ea838cdf9d6
msgctxt "hf0ff6785g6f44g4405gab63g5ee936678136"
msgid "Fumble in my head again and I'll gut you."
msgstr "내 머릿속을 한 번이라도 더 들여다보면 네 내장을 꺼내주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 1c350c16-af19-d4ce-2c49-cfad690d409f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:1c350c16-af19-d4ce-2c49-cfad690d409f
msgctxt "he586b255gdecbg4ea7g834bg5b66d2d2bc97"
msgid ""
"I know that. I had just hoped you might show some more understanding. Leave "
"me alone, please."
msgstr "알아. 그냥 너가 조금만 더 이해해 줬으면 했을 뿐이야. 그냥 좀 혼자 있게 해줘. 부탁이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 1fe10919-30b5-b3f5-2976-14c134e91bd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_WildMagic_MindmeldSuccess(1) = True
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:1fe10919-30b5-b3f5-2976-14c134e91bd2
msgctxt "hcc68d560g28f9g47c4gba69g3ed6f40a14ef"
msgid "You're a Shar worshipper, aren't you?"
msgstr "너는 샤 여신의 신도지. 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 21cd97fb-f5dc-82e1-c709-4e4bd3c09e48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:21cd97fb-f5dc-82e1-c709-4e4bd3c09e48
msgctxt "h8f1ea62cgd69ag4e7ag9bc0ge025e45e41a6"
msgid "I didn't agree to join up with a Shar worshipper."
msgstr "샤 신봉자랑 같이 다니기로 동의한 적은 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 2222a5a9-3e37-2246-c97e-dd8dd571c454
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:2222a5a9-3e37-2246-c97e-dd8dd571c454
msgctxt "h8f26c878gfb22g4391g8381g13131ccb9f13"
msgid "I can't trust you. Best if we travel separately for now."
msgstr "널 믿을 수 없어. 지금부터는 따로 여행하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 2914efd3-07bb-3e10-ca37-164c4ac36644
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_0_For_Sp2(0) = True
#.      - Approval_AtLeast_10_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:2914efd3-07bb-3e10-ca37-164c4ac36644
msgctxt "h968fcf83g0004g49a4gaa48g02ec66e0d458"
msgid "It's nothing, I swear."
msgstr "아무것도 아니야. 맹세해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 29c48ff5-4681-0e30-c65e-fbeff1f2a1da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:29c48ff5-4681-0e30-c65e-fbeff1f2a1da
msgctxt "hc09badd8g02fag4348g8836g9981b0f3ce69"
msgid ""
"No... or at least, I don't think so. Perhaps Lady Shar is testing me "
"somehow. But if she is, then I have no idea what her purpose is."
msgstr "아니... 그건 아닐 거야. 아마 샤 여신께서 날 시험하는 걸 거야. 만약 그렇다면, 그분의 뜻이 무엇지는 전혀 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 2a5b4bdb-a731-2b81-6ebf-4991dee652aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SHAR(1) = False
#.      - PALADIN_SHAR(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:2a5b4bdb-a731-2b81-6ebf-4991dee652aa
msgctxt "h95343acfg8d3fg48f2gbaccg5537deaa8741"
msgid "Let's see how open-minded I can be then: tell me more."
msgstr "그럼 내 마음이 얼마나 열릴지 한번 보자. 더 자세히 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 2d92ad9b-bf6b-0217-9f8d-8389e79b3a46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:2d92ad9b-bf6b-0217-9f8d-8389e79b3a46
msgctxt "he0ac366bg7b46g4cdbg9d4egc8d3dd233ed9"
msgid ""
"I... yes, she must. I'll offer thanks to her in my prayers - and we should "
"speak more later. Alone, ideally."
msgstr "난... 그래, 분명 그럴 거야. 그분께 감사기도를 올릴게 나중에 더 얘기하자. 둘이서만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 30878861-a144-30d3-7795-f96208d8bb1a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:30878861-a144-30d3-7795-f96208d8bb1a
msgctxt "h699a3584g67d2g4645gbb71ge1557aed157f"
msgid ""
"Don't make a fuss, Selûnite - we may be at odds, but I have more important "
"concerns than you right now."
msgstr "호들갑 떨지 마 셀루네 신도. 우리가 서로 상충할 수도 있지만, 지금 나는 너보다 더 중요한 문제가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 366e06ca-6e5c-a762-c30c-2abe38af71f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_0_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:366e06ca-6e5c-a762-c30c-2abe38af71f2
msgctxt "h95d9e464gd0a6g46b9g9adcg618dcc6fef88"
msgid ""
"It's nothing. Even if it was <i>something</i>, I'm clearly not going to tell "
"you, am I? Let it go."
msgstr "이건 아무것도 아니야. 이게 뭔가 의미가 있다 하더라도 난 절대로 너한텐 말 안 할 거야. 그냥 신경 쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 3792f18a-4437-a1d0-d28f-c3e795c6f7b6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:3792f18a-4437-a1d0-d28f-c3e795c6f7b6
msgctxt "h4185bdc6ga6cdg44edgb42dg4b3ffdd97486"
msgid "Don't be sorry - just tell me what you're hiding."
msgstr "미안해하지 말고 그냥 너가 무엇을 숨기고 있는지 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 38047a3f-6842-2eb0-e701-343f13268158
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_WildMagic(1) = True
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#.   Local:
#.      - 53062fe4-b69b-87e2-7c3f-1804fe8c67cf_SharHint = False
#. SetFlags:
#.   Global:
#.     - Shadowheart_InParty_SharWorshipper_QuestioningAvailable = True
#.   Local:
#.     - 53062fe4-b69b-87e2-7c3f-1804fe8c67cf_SharHint = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:38047a3f-6842-2eb0-e701-343f13268158
msgctxt "h39edd26cg55beg46bbg8b34g539ff2d655c3"
msgid "'Darkness protect me'? What did you mean by that?"
msgstr "'어둠이여 절 보호하소서'? 그게 무슨 의미야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 3b4119f4-cec1-0f15-c3df-b78716c9a4f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:3b4119f4-cec1-0f15-c3df-b78716c9a4f2
msgctxt "ha1b7ec4fga235g45afgbf1fgf03d3262d386"
msgid "I don't need your tough love. I need to be left alone. <i>Now</i>."
msgstr "이상한 동료애 같은 건 필요 없어. 그냥 날 내버려둬. <i>지금</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 3ea61ace-19d2-c567-e8fe-a5d65656ab92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:3ea61ace-19d2-c567-e8fe-a5d65656ab92
msgctxt "h13bb06edg657ag4df7g9508g0f8a0ef46db5"
msgid "In future, I expect you to be honest. Let's leave it at that for now."
msgstr "앞으로는 네가 더 솔직하기를 기대할게. 지금은 여기까지만 말하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 45874e5c-7965-9068-4518-02392951ab0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:45874e5c-7965-9068-4518-02392951ab0c
msgctxt "h5047a764g36b5g407egaeedga632de03ce0f"
msgid "Talk to me later. The day's been long enough already."
msgstr "나중에 얘기해. 충분히 긴 하루였으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 48448405-26d5-a862-b1e7-7953cd598762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:48448405-26d5-a862-b1e7-7953cd598762
msgctxt "h612efcc9g07d3g4dc6g830fg1357dcfbfbf1"
msgid ""
"True. I didn't think you'd react so pragmatically. Perhaps I should have "
"told you sooner."
msgstr "맞아. 네가 그렇게 합리적으로 받아들일 줄은 몰랐어. 더 일찍 말하는 게 나았을지도 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 48683dcc-2558-e170-188b-df3e5691e378
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:48683dcc-2558-e170-188b-df3e5691e378
msgctxt "h2c32e711ged90g4598g9347g07255b53ceda"
msgid "I... it's difficult for me to talk about. I'm sorry."
msgstr "난... 말해주기 힘든 주제야. 미안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 4904d5b6-b549-1190-beba-b7c2cace83c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:4904d5b6-b549-1190-beba-b7c2cace83c4
msgctxt "h3b31fdaag3dc7g49a7gaa2dga4b4e0245288"
msgid "Gather your thoughts. Then, perhaps, we can talk some more."
msgstr "생각을 정리해. 그런 다음에 이야기하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 4a717575-9a8d-3ded-d590-9a6b83e8f1b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:4a717575-9a8d-3ded-d590-9a6b83e8f1b1
msgctxt "h917d5181g10e6g4453g9ba8g0e6dfee56ea2"
msgid ""
"...and stop looking at me like that. I'm not sprouting tentacles just yet."
msgstr "... 그리고 그만 그렇게 쳐다봐. 아직 촉수가 자라나진 않을 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 576b5756-0366-9c83-e8a0-b5606bf5a150
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_WildMagic_AltMindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:576b5756-0366-9c83-e8a0-b5606bf5a150
msgctxt "hb361b923g4cc2g4f51gb293gaf2412b0c3ff"
msgid "Don't worry. Whatever it is, we're in this together."
msgstr "걱정하지 마. 뭐였든 간에, 우린 함께야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Gale
#. NodeID = 5a7aac75-4e59-ee6a-4db6-05fa77be961f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:5a7aac75-4e59-ee6a-4db6-05fa77be961f
msgctxt "h4bec80e6g2222g459dgb639gb081c45f4372"
msgid ""
"You worship Shar? Blimey. She and my beloved Mystra are not exactly friends."
msgstr "샤를 섬기고 있었다고? 어이쿠. 내 사랑 미스트라와 샤는 좋은 사이가 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 5c3566a1-1e5d-9b99-e21a-308ed53d2315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:5c3566a1-1e5d-9b99-e21a-308ed53d2315
msgctxt "haf104df9g1b85g4b9cg8bcag0cb25d3fcab9"
msgid "I'm fine. It's passed, whatever it was..."
msgstr "난 괜찮아. 이미 지나갔어, 뭐였는진 모르겠지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 6308bc32-761d-3b54-1245-ef450f6afc0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:6308bc32-761d-3b54-1245-ef450f6afc0a
msgctxt "h7c13353eg9cabg4bc2gbc87g28e880df7244"
msgid ""
"A lie of omission at most. I'm sure you have some skeletons of your own "
"hidden away."
msgstr "기껏해야 누락된 거짓말일 뿐이지. 너도 자신만의 비밀을 숨겨놨을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 63476a00-0f4f-1637-87ab-a41ef5d27ef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:63476a00-0f4f-1637-87ab-a41ef5d27ef0
msgctxt "hb0fc6ad1g67ecg4f90ga99fgac895dedd472"
msgid ""
"We can discuss this later. But let's just try a little more honesty going "
"forward."
msgstr "이 부분에 대해서는 나중에 논의하자. 하지만 앞으로는 조금 더 솔직해지도록 노력해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 63964b6a-4fef-fe88-bc28-5d046ac0389d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SHAR(1) = False
#.      - PALADIN_SHAR(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:63964b6a-4fef-fe88-bc28-5d046ac0389d
msgctxt "h45653d74gfa27g4289ga77eg7d0640121c37"
msgid "Now that the truth's out, tell me more."
msgstr "이제 진실이 밝혀졌으니, 더 자세히 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Narrator
#. NodeID = 659693f7-a494-0c52-af23-2a927fcfbcd6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_WildMagic_AltMindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:659693f7-a494-0c52-af23-2a927fcfbcd6
msgctxt "h97c77fd3g3adcg47d9ga83bgc73cf7c04351"
msgid ""
"*Uncertainty. Shadowheart is wrestling with what this pain means. Perhaps it "
"is connected to Shar, she wonders, or perhaps not...*"
msgstr ""
"*불확실함. 섀도하트는 이 고통이 어떤 의미인지 고민하고 있습니다. 샤님과 연결된 것일지도 몰라, 그녀는 생각합니다, 그렇지 "
"않을지도...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 693adb67-b283-146b-2bd5-22d6af431512
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 53062fe4-b69b-87e2-7c3f-1804fe8c67cf_WhatJustHappened = False
#. SetFlags:
#.   Local:
#.     - 53062fe4-b69b-87e2-7c3f-1804fe8c67cf_WhatJustHappened = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:693adb67-b283-146b-2bd5-22d6af431512
msgctxt "h9eec80a6g640fg46f4g9997g691e0e4ca929"
msgid "What was that all about?"
msgstr "방금 그건 대체 뭐였어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 6d191599-dbaf-6731-ca38-a65dcb83a4ce
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:6d191599-dbaf-6731-ca38-a65dcb83a4ce
msgctxt "hab9ae124g5453g4003ga64agf43dceaa4fc1"
msgid "<i>Use your shared connection. Enter her thoughts.</i>"
msgstr "<i>연결된 정신을 통해 그녀의 마음 속을 들여다본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Karlach
#. NodeID = 6ebf4d9d-9b67-c295-7f8d-1e34644fdc77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:6ebf4d9d-9b67-c295-7f8d-1e34644fdc77
msgctxt "h3581f35ag47f8g4acagb118g6d40dfbc47bb"
msgid "Fantastic. Monsters in our minds, <i>and </i>around our campfire."
msgstr "환상적이네. 우리 머릿속에도 괴물이 있고, 우리 모닥불 근처에도 괴물이 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 7663f271-f890-f53e-62c2-3e577ac863f7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:7663f271-f890-f53e-62c2-3e577ac863f7
msgctxt "haccc52fbgc497g4de7g8edag4bf5f127bdc2"
msgid "<i>Use your shared connection. Enter her thoughts.</i>"
msgstr "<i>연결된 정신을 통해 그녀의 마음 속을 들여다본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 79058f6b-7abc-a729-c4cf-1db43ed18c5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_0_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:79058f6b-7abc-a729-c4cf-1db43ed18c5b
msgctxt "h6df7cc9ege1ccg4baeg9611g628218d0069e"
msgid "Never you mind."
msgstr "신경 쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 7943dab0-c027-e20b-c5f7-0f3e8729214b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:7943dab0-c027-e20b-c5f7-0f3e8729214b
msgctxt "he2aa00adg0edeg45c7g9b8agb9246f4cf2d1"
msgid "I'm not sorry I kept this from you. Not one bit."
msgstr "이 사실을 숨겨서 미안한 감정은 없어. 전혀."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 79941276-7345-8d11-2100-1c114b95c934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:79941276-7345-8d11-2100-1c114b95c934
msgctxt "h4f84a4aegb923g407cg8529g9670cd8395ab"
msgid "Though perhaps that might change, if you can show an open mind."
msgstr "하지만, 미안해질지도 모르지, 네가 열린 마음을 보여준다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 7a26f520-0f73-42f4-73e2-09f60f6db24c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:7a26f520-0f73-42f4-73e2-09f60f6db24c
msgctxt "h863344b2g8097g4c97gbb90gab225a25c6be"
msgid "I worship Shar, the Mistress of the Night."
msgstr "난 밤의 여주인, 샤님을 섬겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 7c4ba46c-de8e-a709-76f5-58a91c88629d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_0_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:7c4ba46c-de8e-a709-76f5-58a91c88629d
msgctxt "ha2b018e5g3a34g4f9bg9080ga8ff87cc6540"
msgid "Please, it's nothing. Just let it rest."
msgstr "제발, 아무것도 아니야. 그냥 무시해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 7dc82285-584b-7c3e-b654-0fa5120e203b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:7dc82285-584b-7c3e-b654-0fa5120e203b
msgctxt "hcf659c6dg4cfdg462cgb019g58d6f16d8f42"
msgid "You're not going to let this go, are you?"
msgstr "계속 물고 늘어질 거구나, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 7f21b5f5-60f8-a343-e5d7-b92a352593f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:7f21b5f5-60f8-a343-e5d7-b92a352593f0
msgctxt "h1163e7a3g1378g4ed2ga165g989527e7c500"
msgid ""
"Forever, ideally. And you assume too much about what I can and cannot tell."
msgstr "이상적으로는, 영원히. 그리고 내가 말해줄 수 있고, 그렇지 못한 것에 대해서 너무 쉽게 판단하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 82071f01-164b-917d-3c4b-d7dec0d5d1a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:82071f01-164b-917d-3c4b-d7dec0d5d1a8
msgctxt "h2567ea1eg005fg45dfg8f92gc1dbf5fc003c"
msgid "Gladly."
msgstr "기꺼이."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 85c8aa11-22db-b00c-4014-183c75080371
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:85c8aa11-22db-b00c-4014-183c75080371
msgctxt "hbb67d9aeg316fg421egb528g2a4d5e691b0d"
msgid "I don't care who you worship. We have bigger problems."
msgstr "네가 누구를 섬기건 알 바 아니야. 우리한텐 더 큰 문제들이 많아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 85f75351-e00d-06d1-b5c3-de01742eb26d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:85f75351-e00d-06d1-b5c3-de01742eb26d
msgctxt "h54dc8ad9g75c5g4713g84dagf367cac364f7"
msgid ""
"Your blindness as much as my deception, Selûnite. We can talk about this "
"later - if you're willing."
msgstr "넌 셀루네에 대한 신앙으로 눈이 멀어있네. 우리 나중에 다시 대화하자. 너가 원한다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 87f64c0f-e887-3969-b4e1-ab3b68eea0d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:87f64c0f-e887-3969-b4e1-ab3b68eea0d9
msgctxt "ha92f78fdgb1c3g45bfgaa26gd5eddc7876f0"
msgid "Now that you have the truth, please don't make a big fuss about it."
msgstr "이제 진실을 알았으니, 제발 너무 호들갑 떨지는 말아줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 8a17b93a-7345-1b9b-bb46-6e50fb3e9be3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:8a17b93a-7345-1b9b-bb46-6e50fb3e9be3
msgctxt "h723c1686g6f99g4155g9b6eg3cfb6bad518f"
msgid ""
"Of course I am. But we can talk about this later - I want to enjoy the still "
"of the night."
msgstr "당연하지. 하지만 이 이야기는 다음에 하자, 아직은 오늘 밤을 즐기고 싶으니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 8a7fbde3-bda9-0cf5-fb4a-5b1725dc0481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:8a7fbde3-bda9-0cf5-fb4a-5b1725dc0481
msgctxt "h78bd74dfg15bfg4ec9g9ebfg65f14ecb5952"
msgid "<i>Turn a blind eye and leave.</i>"
msgstr "<i>모른 척하고 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 8caa5077-245c-dc65-a685-8ffb84781bcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:8caa5077-245c-dc65-a685-8ffb84781bcc
msgctxt "ha1ee8cf4gbbe9g4685gb8f9g4b0271507105"
msgid "You could have told me. How long were you going to keep this secret?"
msgstr "나한테 말해줬어도 됐잖아. 언제까지 비밀로 하려고 했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 98876b9e-ec41-dcc6-5489-0abb49f8be25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:98876b9e-ec41-dcc6-5489-0abb49f8be25
msgctxt "h63121c27gff2fg4d15ga717g792c10178746"
msgid ""
"...I should have been more discreet around you, clearly. Yes, you're right."
msgstr "... 네 주변에선 더 신중했어야 하는데. 그래, 네 말이 맞아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = 9d2e5987-61f9-e9df-f682-9562ed795af6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:9d2e5987-61f9-e9df-f682-9562ed795af6
msgctxt "h13a82020g2e40g49a3g878bg53a770c00878"
msgid "I don't know how I feel about this."
msgstr "이걸 어떻게 받아들여야 할지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = a6342e89-70ff-ad49-c5a1-3fe30b77b1ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:a6342e89-70ff-ad49-c5a1-3fe30b77b1ed
msgctxt "h4d2308c9g083fg48f5g9318gc4a156eee034"
msgid "Then it's your own fault for not asking."
msgstr "그럼 묻지 않은 네 잘못이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = aa86af6d-fcbf-cfd5-1560-ffd68fa4d67f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:aa86af6d-fcbf-cfd5-1560-ffd68fa4d67f
msgctxt "he5aba1dbgd26cg41dbga01cgc2ef91db6740"
msgid "Not some sort of Sharran magic...?"
msgstr "뭔가 샤에 관련된 마법인가...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Lae'zel
#. NodeID = ac107461-b617-b190-d488-a41a23f05540
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:ac107461-b617-b190-d488-a41a23f05540
msgctxt "hfa51096dg4ee8g4b17g8d5agd320cc5c9cbc"
msgid "The goddess of secrets? How <i>telling.</i>"
msgstr "비밀의 여신? <i>솔직하네.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = b00245f2-e912-c335-4204-40a4e16189f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:b00245f2-e912-c335-4204-40a4e16189f7
msgctxt "h6bbf472dgdc2eg4b72ga790gdd62d564e0b1"
msgid ""
"I... thank you. But I'm sure it was nothing. I just... need a little space."
msgstr "난... 고마워. 하지만 분명 아무것도 아니었을 거야. 난 그저... 잠시 혼자 있을 시간이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = b2ab2430-a51f-9355-0547-75d23878f8c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 53062fe4-b69b-87e2-7c3f-1804fe8c67cf_AreYouHurt = False
#. SetFlags:
#.   Local:
#.     - 53062fe4-b69b-87e2-7c3f-1804fe8c67cf_AreYouHurt = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:b2ab2430-a51f-9355-0547-75d23878f8c3
msgctxt "h0be27368g9d5bg43fag814eg228a2b12d18e"
msgid "Are you hurt?"
msgstr "다쳤어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = b3c5a1d9-ca46-4b56-a94c-9acd4f9b3fdb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_WLD_Main_A = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:b3c5a1d9-ca46-4b56-a94c-9acd4f9b3fdb
msgctxt "h0d133e2eg96feg48fbgabb3gab0f6ce35f99"
msgid "Don't make a big fuss...? You've been lying to me!"
msgstr "호들갑 떨지 말라고...? 지금껏 나한테 거짓말을 해왔잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = c6bc1889-cf15-3907-6fc2-f1dcfbef42cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:c6bc1889-cf15-3907-6fc2-f1dcfbef42cb
msgctxt "h37a88fb0g8fa7g4b2bg845ag321fc9bf9514"
msgid "<i>Change the subject.</i>"
msgstr "<i>주제를 바꾼다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = c8a65a0d-9844-9a3e-d5f9-8fe53a762516
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Shadowheart_IVB_WildMagic_AltMindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:c8a65a0d-9844-9a3e-d5f9-8fe53a762516
msgctxt "hac3e5a81gd2e3g4cc4g9eaeg2547d0a74d07"
msgid "Pull yourself together. We've all got fears to wrestle with."
msgstr "마음 단단히 먹어. 우리 모두 싸워야 할 두려움이 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Narrator
#. NodeID = cdfcec37-d6b2-f2db-8287-b2c9ab061b1b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_WildMagic_MindmeldSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:cdfcec37-d6b2-f2db-8287-b2c9ab061b1b
msgctxt "h8ceeb5f7g196dg4152g9878g63550c5b2c99"
msgid ""
"*You sense her trying to understand what just happened. She silently begs "
"her goddess for guidance - <i>Shar</i>.*"
msgstr ""
"*그녀가 자신에게 어떤 일이 일어난 건지 알아내려고 노력하는 것이 느껴집니다. 그녀가 조용히 자신의 여신에게 인도를 요청하며 기도하고 "
"있습니다. <i>샤 에게 말입니다</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = d3980095-32b6-737b-c294-ca7bda1f4b8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:d3980095-32b6-737b-c294-ca7bda1f4b8a
msgctxt "hd125a89cg81a4g4d1ega73ag0f9be86218f9"
msgid ""
"<i>Stop! </i>If I want to tell you something, I'll use my mouth - understand?"
msgstr "<i>그만! </i>내가 네게 뭔가 알려주고 싶다면, 내 입으로 알려줄 거야. 알아들어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = d52d9723-0332-6821-b53a-9d163100eed7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:d52d9723-0332-6821-b53a-9d163100eed7
msgctxt "h381d7e8ag9729g4281ga115g04e456b0d807"
msgid "Shar is an abomination. You deceived me."
msgstr "샤는 혐오스러운 존재야. 날 속였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = d9a42bd8-75f4-635a-2779-e58cd8e3aa95
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - OriginRemoveFromPartyAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:d9a42bd8-75f4-635a-2779-e58cd8e3aa95
msgctxt "h4a76c37bg7d0bg4a71gbd86g0e27790c4862"
msgid "If you insist. Don't expect to fare well without me to save you."
msgstr "네가 원한다면. 하지만 내가 구해 주지 않아도 잘 지낼 수 있을 거라고 기대하진 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = da0b132d-c236-47fd-60c5-38b5fa64a446
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:da0b132d-c236-47fd-60c5-38b5fa64a446
msgctxt "hc7204f2cgc932g4b40g85dbg515f7e6394a0"
msgid "I said I <i>don't know</i>. Forget it."
msgstr "<i>모른다고 했잖아.</i> 잊어버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = e0a206f5-6ec6-b826-1135-cfbf95df9dbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_WLD_Main_A = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:e0a206f5-6ec6-b826-1135-cfbf95df9dbb
msgctxt "ha473ca67g5d01g43e9ga910gdeaa6a1cdefe"
msgid ""
"I'll decide whether to make a fuss or not. Hard to trust someone who's "
"holding out on me."
msgstr "호들갑 떨지 말지는 내가 결정해. 제대로 말해주지 않는 사람은 신뢰하기 어렵군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Astarion
#. NodeID = e1d55740-8783-d07e-d60d-c13dffdfb713
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:e1d55740-8783-d07e-d60d-c13dffdfb713
msgctxt "h5351914cg6f71g4dc7gb6dbg34cadfdefb8e"
msgid "Heavens forbid. We're all entitled to our secrets."
msgstr "그럴 일 없어. 우린 모두 자신만의 비밀을 지킬 권리가 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = e6d8c92d-319b-13f1-7462-1469f649a114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:e6d8c92d-319b-13f1-7462-1469f649a114
msgctxt "hfecc75eeg14e5g421ag8fb6g030748a256d7"
msgid "No... I'm fine. Forget it."
msgstr "아니... 난 괜찮아. 잊어버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = e6dda4cd-6c77-0857-7637-6df1c8ca9d84
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:e6dda4cd-6c77-0857-7637-6df1c8ca9d84
msgctxt "hf60aeefbg2991g46c7g9300gc036311e3e0a"
msgid ""
"I bow to Shar also. The Dark Lady must favour us, to have brought us "
"together."
msgstr "나도 샤 여신을 섬겨. 어둠의 여신께서 호의를 베푸신 게 분명해, 우릴 모이게 했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = e7cc80d0-3c77-ce12-c339-cfb24997aa4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:e7cc80d0-3c77-ce12-c339-cfb24997aa4d
msgctxt "hbb57f249g1f3bg4669ga205g1b643b6c6325"
msgid "<i>Could it be her tadpole? Ask how she feels.</i>"
msgstr "<i>그녀의 기생충 때문은 아닐까? 그녀의 기분을 묻는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = e9c6194e-39e2-8bcb-0ba5-b250c0475ad5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:e9c6194e-39e2-8bcb-0ba5-b250c0475ad5
msgctxt "hb2b301e9gef10g4278g955cgc0b3c6a9ce22"
msgid "I... I don't know."
msgstr "난... 나도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Wyll
#. NodeID = e9edbabe-1851-e188-a4cc-6835069309f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:e9edbabe-1851-e188-a4cc-6835069309f4
msgctxt "hc29c49fdg89feg4912gb506g1f4eddbf036a"
msgid "A Shar worshipper? Not my usual quarry - nor my usual ally."
msgstr "샤 숭배자? 내가 평소에 만나는 적도, 동료도 아니군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = ec2ee36c-d784-8eea-ac7b-ab8e5bdc22ef
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:ec2ee36c-d784-8eea-ac7b-ab8e5bdc22ef
msgctxt "hdfae9c63g4f23g4762g8ce9g90e7bcd42d00"
msgid ""
"It's been some time since I met another faithful of Shar. Are you versed in "
"her teachings?"
msgstr "다른 샤 여신의 신도를 만난 건 아주 오랜만이네. 그녀의 가르침에 대해 잘 알고 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = ed057d40-895f-efc7-7911-2a196388a360
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:ed057d40-895f-efc7-7911-2a196388a360
msgctxt "h8e203f8fg1e35g406eg88e9g2354127c636f"
msgid "All we can do is try, I suppose..."
msgstr "시도해볼 수 밖에 없겠지, 아마도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = ed84e22a-c4c1-f297-80bf-9480028948ab
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:ed84e22a-c4c1-f297-80bf-9480028948ab
msgctxt "h2d75cf7dga79fg4a0bgbc23ge496976faa07"
msgid "There's more to this. What aren't you telling me?"
msgstr "할 말이 더 있잖아. 왜 말 안 해주는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = eda1ade1-acb1-d017-d1bf-1e123b17211d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:eda1ade1-acb1-d017-d1bf-1e123b17211d
msgctxt "hf1472f6bg0a5ag4f77g9ba4g5c25b7eccd18"
msgid ""
"Secrecy is everything for Shar's children. It's our code, our creed, our "
"shield."
msgstr "샤의 자녀들에겐 비밀이 전부야. 그게 우리의 규약이자 신조이며 방패이기도 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = eed587db-1646-3af0-e843-cf1dab7bb532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:eed587db-1646-3af0-e843-cf1dab7bb532
msgctxt "h4d9559bfg81d0g4abdgb299g3c3ff0f8271a"
msgid "Thank you for telling me, at least."
msgstr "그래도 알려줘서 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = f135fffe-5cf6-4c2d-809f-2e7d98ee9015
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Shadowheart_IVB_WildMagic(1) = True
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#.     - Shadowheart_InParty_SharWorshipper_QuestioningAvailable = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:f135fffe-5cf6-4c2d-809f-2e7d98ee9015
msgctxt "h9ed0fdebg52d1g40bcg8e1bg2f94392e2123"
msgid "<i>Ngh</i>, it hurts... Darkness protect me..."
msgstr "<i>으</i>, 아파... 어둠이여 절 보호하소서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Player
#. NodeID = f80e0ad4-9e2c-9e90-cfe8-0804fabcae91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:f80e0ad4-9e2c-9e90-cfe8-0804fabcae91
msgctxt "h85da2f0bgc28cg4856g9d32g1526c533f0d0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 046e66b9-7ef9-4c18-8359-13a36e590230
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:046e66b9-7ef9-4c18-8359-13a36e590230
msgctxt "h47f9972ag9e52g4a69gba2dgd518ab499f1a"
msgid "Come over here, boy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 046e66b9-7ef9-4c18-8359-13a36e590230
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:046e66b9-7ef9-4c18-8359-13a36e590230
msgctxt "hcc349a1cg642bg43f0ga9d8ga4f2b5d355c3"
msgid "It's been a day, Scratch. Come here, boy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 046e66b9-7ef9-4c18-8359-13a36e590230
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:046e66b9-7ef9-4c18-8359-13a36e590230
msgctxt "hcc8bbf46gf353g44c2ga9b2g02613220293f"
msgid "Scratch - so called because you like a scratch behind the ear?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 046e66b9-7ef9-4c18-8359-13a36e590230
#. HandlePath = TaggedText[0].TagText[3]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:046e66b9-7ef9-4c18-8359-13a36e590230
msgctxt "h0db8fd38g6e50g4b97gaacbgefbb90501511"
msgid "What do you get up to all day without us, hmm?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 4872e060-c086-4880-846d-6ad765974cda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_OwlbearCub_State_BecameCampFollower = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:4872e060-c086-4880-846d-6ad765974cda
msgctxt "h9c2c4f8cg3b27g4007gb307gf0655502763e"
msgid ""
"Are you hungry? Better give you extra, so you don't nibble on me in the "
"night..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 4872e060-c086-4880-846d-6ad765974cda
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - CAMP_OwlbearCub_State_BecameCampFollower = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:4872e060-c086-4880-846d-6ad765974cda
msgctxt "hea8ca77cg730bg46d9gac5fgd2ecc9491d05"
msgid "I swear you've grown since I last saw you..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 4872e060-c086-4880-846d-6ad765974cda
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - CAMP_OwlbearCub_State_BecameCampFollower = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:4872e060-c086-4880-846d-6ad765974cda
msgctxt "h3889c00ege5d8g4ffcg92b6g305bf14d9259"
msgid "You'll be too much of a handful one day. But not yet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet
#. Speaker = Shadowheart
#. NodeID = 4872e060-c086-4880-846d-6ad765974cda
#. HandlePath = TaggedText[0].TagText[3]
#. CheckFlags:
#.   Global:
#.      - CAMP_OwlbearCub_State_BecameCampFollower = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_CallPet:4872e060-c086-4880-846d-6ad765974cda
msgctxt "he71beaa3g3fb2g4fedg88bcg51f6295b000e"
msgid "Now, play nice... claws and beak to yourself, please..."
msgstr ""

