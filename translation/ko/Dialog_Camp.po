#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:a26c1353-7c80-6bdd-8879-591eef5b3fa6
msgctxt "h244e213ag07c8g4bacga7cag4920f6165618"
msgid "You clearly have your secrets - I have mine."
msgstr "너만의 비밀 하나 갖고 있지? 나도 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = a5103c89-f014-a30c-a090-c106cce9a46f
