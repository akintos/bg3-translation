#.     - CAMP_GoblinHuntCelebration_HasMet_ParentA(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA:1fdd013c-f461-1100-6d5c-30eb5d239c5f
msgctxt "h89b610eegceacg4b85g9096g0d5f7ac5b35b"
msgid ""
"So much blood and death. If we ever meet again, I hope it's under better "
"circumstances. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA
#. Speaker = Locke
#. NodeID = 32e35fa0-9bac-3132-1473-ef7102ee413a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ParentA(1) = True
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SavedKagha = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA:32e35fa0-9bac-3132-1473-ef7102ee413a
msgctxt "h9f07fd30g5f01g4c17gb27eg23efb8730bde"
msgid ""
"I want to leave this place with my wife and start anew. I wish you the same."
msgstr "제 아내와 함께 이곳을 떠나 새 출발을 하고 싶어요. 당신도 그러시길 바라죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA
#. Speaker = Locke
#. NodeID = c0495448-5582-6aa1-af00-7436c6ff2cd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SavedKagha = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_ParentA(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA:c0495448-5582-6aa1-af00-7436c6ff2cd7
msgctxt "h7bfcf68egef47g41edg996eg8ca838b906fe"
msgid ""
"Thank you for intervening with Kagha. Don't know if she deserved the mercy, "
"but I hope something good comes of it. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA
#. Speaker = Locke
#. NodeID = d4c8cfae-7df8-1fb1-f111-f3b20c320659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA:d4c8cfae-7df8-1fb1-f111-f3b20c320659
msgctxt "h6a044e42ge666g412bg8110g8efe4b782438"
msgid "Go on - the hero of the party deserves to have some fun. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA
#. Speaker = Locke
#. NodeID = eb186662-cdac-ba07-091b-8ed640b63d12
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA:eb186662-cdac-ba07-091b-8ed640b63d12
msgctxt "hb0b87c83ga075g481aga680g9bc9c7ccafed"
msgid "While I hope you're enjoying the night, we'd like to be left alone. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB
#. Speaker = Komira
#. NodeID = 08fd936e-6099-025f-5c64-6b7d8c3acab7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB:08fd936e-6099-025f-5c64-6b7d8c3acab7
msgctxt "hb951cc2agf266g498cg8dc9g30cbb8e4be6e"
msgid ""
"Why didn't the goblins end me? Why did I survive and my little girl didn't? "
"<i>Damn it.</i>"
msgstr "왜 고블린들이 나를 죽이지 않은 걸까? 왜 내 어린 딸아이는 죽고 나는 살아남은 거야? <i>망할.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB
#. Speaker = Komira
#. NodeID = 1e7f64e0-d33d-a17d-5f23-3422157e0eea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB:1e7f64e0-d33d-a17d-5f23-3422157e0eea
msgctxt "h456b2324g67b0g4ac8gbfc2gdf0b57d19aff"
msgid "I hate this. I hate all of this."
msgstr "마음에 안 들어. 전부 다 싫어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB
#. Speaker = Komira
#. NodeID = 28543234-8803-c15a-6686-9d35ba4986ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SavedKagha = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB:28543234-8803-c15a-6686-9d35ba4986ee
msgctxt "h17ebf72cgd086g44b8g834fg72825d112e3e"
msgid "If that snake kills another it's on you - I hope you know that."
msgstr "그 뱀이 또 누군가를 죽이면 그건 이제 당신 책임이야. 그 정도는 알아두면 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB
#. Speaker = Komira
#. NodeID = 7cf99a10-6b54-cd25-ec19-109173a6f995
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SavedKagha = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB:7cf99a10-6b54-cd25-ec19-109173a6f995
msgctxt "h056daea5g8317g47a6g8642g63e9c3ed8649"
msgid ""
"I'm torn between thanking you and telling you to bugger off. But I will say "
"this -  I'm grateful not to have blood on my hands."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB
#. Speaker = Komira
#. NodeID = 8ed57025-413d-d2a2-a625-08e3a128b94f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB:8ed57025-413d-d2a2-a625-08e3a128b94f
msgctxt "h3c205f5dg07feg4242gb474g2e97c8ac076b"
msgid ""
"I did what I had to do. And I won't hear a word about it from you or anyone "
"else. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB
#. Speaker = Komira
#. NodeID = ed1f90e2-048d-35ea-e98e-b0d4bee350ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ParentB(1) = True
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentB:ed1f90e2-048d-35ea-e98e-b0d4bee350ec
msgctxt "hc4252596gbe0ag43abgb259g19756f914fc2"
msgid "I'll say it a little more clearly - bugger off. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = 09a14ae1-b8aa-a30d-5c97-594667162b33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:09a14ae1-b8aa-a30d-5c97-594667162b33
msgctxt "hbe2f6051g63c4g4ae7g9552gf6ab93e201e0"
msgid "Nnnngg..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 20576073-3ef2-aa96-7e03-1b7edab3a390
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:20576073-3ef2-aa96-7e03-1b7edab3a390
msgctxt "h94956b51gd7dag4855gad0cg9cdb04b3b6e6"
msgid "Do you feel better now? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 24f59877-4023-f354-a0df-954128b55260
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:24f59877-4023-f354-a0df-954128b55260
msgctxt "hffe25259g3fbdg4676g9facg6a821163b9c1"
msgid "Killing Kagha won't bring her back. Don't do it."
msgstr "카그하를 죽인다고 해서 돌아오지는 않아. 그만둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 279bffc9-dc07-04f9-4f5f-3e7d056f5f7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:279bffc9-dc07-04f9-4f5f-3e7d056f5f7d
msgctxt "h069c4a1bgdc98g45fag8110gb842cba72460"
msgid "I didn't ask you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 318351a5-18c2-645b-40ea-89021119c13b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:318351a5-18c2-645b-40ea-89021119c13b
msgctxt "hf287366bg7c8ag41d4g8218gb9e0bbc02459"
msgid "As if I'd let her draw breath. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Locke
#. NodeID = 378f2f1f-baa9-8d68-64a9-55e90c1d07c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:378f2f1f-baa9-8d68-64a9-55e90c1d07c0
msgctxt "h953ed078ga586g4208ga06fg08e52712849f"
msgid "Don't let her drag you down with her. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 39755ca4-44ec-0683-8b20-39a191e989e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:39755ca4-44ec-0683-8b20-39a191e989e3
msgctxt "hcf31fd56gebb7g459agbdb3ga16e7beb3492"
msgid "I want you to feel small. I want you to feel helpless. Just like her. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 4a2fdb28-3246-e896-2ba2-b2b75b024a85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:4a2fdb28-3246-e896-2ba2-b2b75b024a85
msgctxt "hba7bab30g5250g4901g914ag5fb7807875f0"
msgid "Let her die nice and slow, in agony."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = 53879b2f-99d9-e404-e450-4efca8566b2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:53879b2f-99d9-e404-e450-4efca8566b2e
msgctxt "h8fdbb78eg8073g42f7gb5c8g657219cb73b4"
msgid "I will bear no more accusations. Leave me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 5c85a9e4-ba15-930d-9d53-b5fc6fe0c6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:5c85a9e4-ba15-930d-9d53-b5fc6fe0c6ea
msgctxt "ha38aa706gbb8eg479cgb232g00cd8579a1c5"
msgid ""
"Her name was Arabella. Picture her. How scared she was. And know - this will "
"<i>hurt</i>. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = 61b84200-a39e-e0a2-7ea5-7e3c6a5a2871
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:61b84200-a39e-e0a2-7ea5-7e3c6a5a2871
msgctxt "h2a6053acg8e76g44fcgabffgd36d0ce6db64"
msgid "I am sorry, a hundred times over, and a hundred more yet."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 6fed26e4-86a2-75b1-4cd7-814da0f9c73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:6fed26e4-86a2-75b1-4cd7-814da0f9c73c
msgctxt "h809acbadg25d1g4af3gb2b9g3be26d50a34c"
msgid "<i>Quietly watch.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 77268077-32b0-7d2a-7a49-6aae067fdcda
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:77268077-32b0-7d2a-7a49-6aae067fdcda
msgctxt "h11ee989cg9ecag4e94gbbdbgce9b2b1843cc"
msgid "If you do this you are no better than her. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 791ce990-e707-e3fe-b8b6-161954a45476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:791ce990-e707-e3fe-b8b6-161954a45476
msgctxt "h6ad1c9aege0eag4de4g9208gc251d95d95f8"
msgid "Tell me - how's the wine? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 7eff6b38-b108-f9b0-c048-e75b9d8096c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:7eff6b38-b108-f9b0-c048-e75b9d8096c6
msgctxt "h9da34fdag8c9fg493ag9884ge8a801fa436e"
msgid "C'mon Locke. We're done. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 862dce5c-02fa-71fb-57f1-207802b401dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:862dce5c-02fa-71fb-57f1-207802b401dd
msgctxt "h58f65a57g84c3g4781gb3b6g2c3770bdef59"
msgid "That was a pointless waste of life. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 870e0fb4-de85-25bb-ed1e-9b85c10b60b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:870e0fb4-de85-25bb-ed1e-9b85c10b60b3
msgctxt "h9fd0818eg3742g428aga9b7g5d518d8a6abd"
msgid "<i>Walk away. </i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 8db2baaa-e9fd-b843-7633-33602cd42e23
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:8db2baaa-e9fd-b843-7633-33602cd42e23
msgctxt "hd62dff2egbbadg466dga4b0gafa491498cde"
msgid "Slit her throat, or she'll start screaming."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = 8db2baaa-e9fd-b843-7633-33602cd42e23
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:8db2baaa-e9fd-b843-7633-33602cd42e23
msgctxt "hcf474642gda65g4ad4g8b84g29468fe5c8b0"
msgid "Slit her throat, or she'll summon help."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 8e25e175-5862-a501-319b-7c489bb4de0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:8e25e175-5862-a501-319b-7c489bb4de0f
msgctxt "h79bdc3f0g5a7cg4753g81bfg1783690ff96d"
msgid "Not like I was sleeping at night anyway. C'mon Locke. We're done. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 98237c3e-0c4a-7ca5-0d4c-c9a0ec39450d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:98237c3e-0c4a-7ca5-0d4c-c9a0ec39450d
msgctxt "h1c6640e0g2808g4b00g8a18g00981f4cd382"
msgid "Hm. You make a good point. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 9c654c2e-ac0d-7faa-32c2-b95487390931
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:9c654c2e-ac0d-7faa-32c2-b95487390931
msgctxt "h8e22d07bgf77bg49c2g8557gd21462c7dd3f"
msgid "Let's go. Before I change my mind. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = b231429e-62c3-bd3d-b2b5-3520f6cdb841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:b231429e-62c3-bd3d-b2b5-3520f6cdb841
msgctxt "h0af964f0g8317g43b4g9fd4g57757ef011b8"
msgid "Death is too good for her. Let her suffer with what she's done. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = bc5b4293-88eb-23f1-438a-a8a6b04f9f09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:bc5b4293-88eb-23f1-438a-a8a6b04f9f09
msgctxt "h1fd7301eg8ec5g4127ga77ag9c40d45bd621"
msgid "I've prayed many times over that Silvanus return me to that moment."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = c3f4e9aa-5045-e232-a281-d13cca3bd6ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:c3f4e9aa-5045-e232-a281-d13cca3bd6ae
msgctxt "h9b791be2g5002g425agaf8fg32167d81fc18"
msgid "Then I guess Arabella and the snake now have something in common. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = c9694c23-59dd-9fa8-3f17-046875ba5cde
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_GoblinHuntCelebration_Event_SavedKagha = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:c9694c23-59dd-9fa8-3f17-046875ba5cde
msgctxt "h6e69549bgb3d3g4dd9g8d21g4fab367d307d"
msgid "She <i>murdered </i>my daughter."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = cc99eb55-572b-0ca1-f658-2c56f1bb142c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:cc99eb55-572b-0ca1-f658-2c56f1bb142c
msgctxt "hf0f1c0abgc9f4g43f0g9debg99825504f76b"
msgid "I'm sorry... I'm..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Locke
#. NodeID = ccbc6174-5ac3-bcc3-8d6c-fedd90f5cd6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:ccbc6174-5ac3-bcc3-8d6c-fedd90f5cd6b
msgctxt "h5a2f1465gfdc3g47d8ga813g6860b6166af0"
msgid "Mari - look at her. She's miserable. Alone. <i>Pathetic. </i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = d3a584d6-ea25-4afe-ffd9-f2a88b242c11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:d3a584d6-ea25-4afe-ffd9-f2a88b242c11
msgctxt "h1cce19f2g5c6fg4383gaa93g79b2350d038b"
msgid "It was never about feeling better. It was about justice."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Player
#. NodeID = e37fae2b-2f6a-ce48-7289-a3555cacfde3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:e37fae2b-2f6a-ce48-7289-a3555cacfde3
msgctxt "h21c1e333ga042g44c2g905fga98955331f33"
msgid "This will only cause more pain in the end."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = e6a8ecfc-9c73-26a3-de9f-05bc34f955dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:e6a8ecfc-9c73-26a3-de9f-05bc34f955dd
msgctxt "h68595db1g1608g40dbg9c0cg516b353d08a3"
msgid "Ngh!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = e95e283c-612e-6981-de6f-57f3bb3487b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:e95e283c-612e-6981-de6f-57f3bb3487b9
msgctxt "h5925644bgd814g4638gaf90g25499b5b249c"
msgid "Your daughter roused the nest. Did you expect the viper not to strike?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = f39305cd-5632-3b37-e0e5-e9fd7f97d76d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:f39305cd-5632-3b37-e0e5-e9fd7f97d76d
msgctxt "hc230b653gc7f6g4997g9561gefd95a6dc0bb"
msgid ""
"Remember this moment. Remember Arabella's cold, dead body. And live with the "
"blood of an innocent child on your hands."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = f4419e1b-a770-0332-db30-5885eb252a42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:f4419e1b-a770-0332-db30-5885eb252a42
msgctxt "h1f538748g72e4g47a8g9f42ga6220d162c5b"
msgid "I buried my daughter because of you. I'm going nowhere. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = fb897176-ba46-1ebc-195b-d14e43e9e728
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_GoblinHuntCelebration_Event_KaghaParalyzed = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentsAndDruidLeader:fb897176-ba46-1ebc-195b-d14e43e9e728
msgctxt "hb0b69f55g7f46g4935gbed7gcb7a16521777"
msgid "The wine? What did you..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Cal
#. NodeID = 052bc22f-838a-b4d0-bcd9-35bdbc06ef26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:052bc22f-838a-b4d0-bcd9-35bdbc06ef26
msgctxt "h44196c2bg13ddg49fdg8c1fg2ce21114e0e5"
msgid "Having performance issues, Rolan?"
msgstr "긴장되나 봐, 롤란?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Player
#. NodeID = 1507e496-9633-5758-9f30-b3e782becead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:1507e496-9633-5758-9f30-b3e782becead
msgctxt "hba24872ege2c7g409dgbcabga7caf5ddde13"
msgid "Is that it?"
msgstr "그게 다야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Rolan
#. NodeID = 3c2c9ab1-1820-fa31-bad4-979ef9033a16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:3c2c9ab1-1820-fa31-bad4-979ef9033a16
msgctxt "hf54fcb6fgb1cag4726gb12eg60e7a8f3ace6"
msgid "Never have I met such troglodytes. Now, pass the wine."
msgstr "이런 원시인 녀석들. 자, 포도주나 한잔 따라줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Cal
#. NodeID = 8f753b3f-4ae3-d817-7f1e-3210ee41badb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:8f753b3f-4ae3-d817-7f1e-3210ee41badb
msgctxt "h70bd1684ga5fdg4807g991eg380aed42217d"
msgid "I'll have you know he can also make them<i> blue.</i>"
msgstr "저걸 <i>파란색으로 할 수도 있대요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Rolan
#. NodeID = a4c4dbc2-c397-0db1-cfd1-ecc448edd2e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:a4c4dbc2-c397-0db1-cfd1-ecc448edd2e5
msgctxt "h118478f4g5307g40afg9c68g7e69edf158ec"
msgid "Patience. Have you no respect for showmanship?"
msgstr "기다려. 쇼맨십을 존중할 줄 모르는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Cal
#. NodeID = a97539eb-f267-914d-b36d-8662d758a6f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:a97539eb-f267-914d-b36d-8662d758a6f1
msgctxt "h69b114eag2f36g45ebg8ee4gad288b9a27c8"
msgid "They grow up so fast."
msgstr "너무 빨리 자란다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Lia
#. NodeID = ad7615e6-7443-ceaf-0758-7572748a7f74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:ad7615e6-7443-ceaf-0758-7572748a7f74
msgctxt "hb92d8af8g2681g4372gadbag527920bce939"
msgid "Remember when he could barely cast that?"
msgstr "시전도 제대로 못하던 시절, 기억나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Rolan
#. NodeID = c84d35a5-fcb5-a242-5706-76a22aa40b86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:c84d35a5-fcb5-a242-5706-76a22aa40b86
msgctxt "h283a5242ge42cg4ec0gba6cg9673c33496c5"
msgid "Adoring applause? You're too kind."
msgstr "이걸 박수 쳐준다고? 너무 착한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Rolan
#. NodeID = d0a693f9-dc4d-d8a5-b753-64659ef96f17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:d0a693f9-dc4d-d8a5-b753-64659ef96f17
msgctxt "hfc4f9f75g387cg4ebeg94bfg49f64892bfaa"
msgid "Hush, you. And..."
msgstr "시끄러워. 그럼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Player
#. NodeID = e2e11102-3b80-6af8-ad7d-3f8a55d8fdb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:e2e11102-3b80-6af8-ad7d-3f8a55d8fdb1
msgctxt "h3b354f43gcd05g4694gb5d5gd7407a3644dc"
msgid "<i>Clap.</i>"
msgstr "<i>박수친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies
#. Speaker = Rolan
#. NodeID = f25a931b-119d-95e5-f2cd-a8113e618f84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigies:f25a931b-119d-95e5-f2cd-a8113e618f84
msgctxt "h03881f60g0827g48b9g8b87g772227ae8fcd"
msgid "...behold!"
msgstr "...짜잔!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = 156ad2e2-e3c1-96cb-07d2-f076d1b56680
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:156ad2e2-e3c1-96cb-07d2-f076d1b56680
msgctxt "h01779f07g5616g4601gacecg7972019175a5"
msgid ""
"Not at all. But... perhaps Lia had a point. What is the point in blades and "
"spells if we don't use them? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Player
#. NodeID = 16f9433c-2f03-5c9e-f7f4-81eed195f2b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:16f9433c-2f03-5c9e-f7f4-81eed195f2b3
msgctxt "h0be3c115gb187g4471g8f5bg49c4307bf996"
msgid "I saw the magic show. I wouldn't call Lia and Cal an 'adoring crowd'."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = 2d1b594c-2a4a-2186-5f7f-a5e98d92f52e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:2d1b594c-2a4a-2186-5f7f-a5e98d92f52e
msgctxt "h258f0faag85f7g4ffeg932dgfc203be971af"
msgid ""
"Once my training with Lorroakan is complete, I'll put on a <i>real </i>show "
"for them."
msgstr "로로아칸 밑에서 받는 훈련이 끝나거든, 내 <i>제대로 된</i> 볼거리 한 번 보여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = 43851860-f9da-1466-2a3c-bf3fb1ceadb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:43851860-f9da-1466-2a3c-bf3fb1ceadb9
msgctxt "h06fa63a7g5880g431cgba40ge19aa44a8fa7"
msgid ""
"Only to the untrained eye. That was the <i>fifth</i> time they've asked for "
"'fireworks'. Heh. Glorified children, those two. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Player
#. NodeID = 4f73d0e3-38cf-4013-309e-f5884cad2e4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:4f73d0e3-38cf-4013-309e-f5884cad2e4f
msgctxt "h62a36008ga4d4g46e4g8be7g52e8c7d21bb2"
msgid ""
"I'm surprised you're still here. I thought you'd be halfway to Baldur's Gate "
"by now. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = 7549586a-380f-4a90-6fd3-f0d17b7a25fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:7549586a-380f-4a90-6fd3-f0d17b7a25fa
msgctxt "h7d1cf47dga05cg4886ga743g2daab693e82b"
msgid ""
"It isn't. But when one is forced among the common folk, it helps to lower "
"expectations. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Player
#. NodeID = 9d9dde71-8f88-693b-1ec7-02250ae08bf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:9d9dde71-8f88-693b-1ec7-02250ae08bf6
msgctxt "h8a328fcbg11bfg4622g8e1ag4fe1b0ba9984"
msgid "I take it you're happy you stayed to help?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = b34a3726-75c2-4246-bcb2-a48d655cd0ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_Prodigy(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:b34a3726-75c2-4246-bcb2-a48d655cd0ce
msgctxt "h0b88a69fg9122g4057g8785ge6ec79633cfe"
msgid ""
"I expect Lia and Cal to demand yet <i>another </i>showcase of "
"prestidigitation, so I'd like a moment to myself."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = c1afa07b-4e8e-78f2-9f56-6daae773e4c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_Prodigy(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:c1afa07b-4e8e-78f2-9f56-6daae773e4c5
msgctxt "h79b27c23gc531g4c12gb78fgd266fdadd518"
msgid "An adoring crowd, fine wine - I daresay this place is almost civilised."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = d6fed581-bd5f-4d90-0ca4-f62246a4fb13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:d6fed581-bd5f-4d90-0ca4-f62246a4fb13
msgctxt "hf79f3283gebd6g4da7g8a40g08ab5d6d1f54"
msgid ""
"Though they won't need either, soon. As Lorroakan's apprentice, I'll take "
"care of everything. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Rolan
#. NodeID = e4ebc065-99e9-940f-83f4-f9eafca02f1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:e4ebc065-99e9-940f-83f4-f9eafca02f1c
msgctxt "h9355bc4cg52e4g4425g9310g5b329900cf4c"
msgid ""
"As did I. But Lia and Cal were so excited for tonight, I thought it cruel to "
"leave."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy
#. Speaker = Player
#. NodeID = e7920c9a-eef8-27fe-b698-15417f9eacbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Prodigy:e7920c9a-eef8-27fe-b698-15417f9eacbe
msgctxt "h4892b0a0gf13ag435fgb1b7g95eb6ec6c015"
msgid "I didn't think a party beneath the stars was your idea of fun."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigyBrother
#. Speaker = Cal
#. NodeID = 6b50cf95-790d-463e-a81c-ddb67114de46
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_ProdigyBrother(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigyBrother:6b50cf95-790d-463e-a81c-ddb67114de46
msgctxt "h55a6225dge1a1g4f95gbbfbg0d2f8784ff65"
msgid ""
"Are Rolan and Lia <i>actually </i>getting along? I know you cut down a horde "
"of goblins, but is far more impressive."
msgstr "롤란과 리아가 <i>정말 </i>사이가 좋아진 걸까요? 당신이 고블린 무리 전체를 쓸어버린 건 알지만, 이게 더 놀랍네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigyBrother
#. Speaker = Cal
#. NodeID = dcb62bdf-70d2-456d-88de-e9bfbe85e306
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ProdigyBrother(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigyBrother:dcb62bdf-70d2-456d-88de-e9bfbe85e306
msgctxt "h278f0bd5g903cg4b2dg830dgdb1167a1e03d"
msgid ""
"Elturel was the last time the three of us talked like this. Let's hope it "
"lasts until Baldur's Gate."
msgstr "저희 셋이 이렇게 편하게 이야기를 나눈 건 엘투렐이 마지막이었어요. 발더스 게이트에 가서도 계속 이랬으면 좋겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = 0b0bc484-8d53-d26b-1a1a-190ddd2b8f65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:0b0bc484-8d53-d26b-1a1a-190ddd2b8f65
msgctxt "hd386d9dbg1887g40fcga684geba51fa7056a"
msgid "Heh. Then I'd best track down a bottle - before the rest polish it off."
msgstr "헤. 그럼 다른 사람들이 다 마셔버리기 전에 나도 한 병 챙겨야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = 0f724591-5a8f-5607-a957-ad7706cf4de3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:0f724591-5a8f-5607-a957-ad7706cf4de3
msgctxt "h307d184fg40b4g47e8g9973gf5040311e179"
msgid ""
"Heh. You sound like Rolan. But all right. Thanks for saving our skins, hero."
msgstr "헤. 당신 말하는 게 참 롤란 같네. 하지만 좋아. 우리를 구해 줘서 고마워, 영웅."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = 18cdbf1c-1f93-4d68-9e94-27937ef2a599
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_ProdigySister(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:18cdbf1c-1f93-4d68-9e94-27937ef2a599
msgctxt "h2823ce73g89a5g4acbg99c0g2eb908e1fc01"
msgid "Look at them. How happy they are. We did that."
msgstr "저들을 봐. 다들 행복해 하잖아. 우리 덕분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Player
#. NodeID = 360a6008-d0e0-0a5f-d2e3-e70fc4ba2ac9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:360a6008-d0e0-0a5f-d2e3-e70fc4ba2ac9
msgctxt "h0fd93f4cgc492g4ed1g839bg5036550af121"
msgid "I'm glad you stuck around."
msgstr "당신들이 남아줘서 기뻐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = 3968f144-f46d-a2c5-6e9e-fac7ce2d9f95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:3968f144-f46d-a2c5-6e9e-fac7ce2d9f95
msgctxt "h4005d074gbf3cg4197g9a83g6e2f66e68b17"
msgid "Look us up when you hit Baldur's Gate. Be nice to see a friendly face."
msgstr "발더스 게이트에 도착하면 우릴 찾아. 친근한 얼굴을 보면 기쁠 테니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = 4a2233d4-f67a-141c-cc5e-844e87a775d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:4a2233d4-f67a-141c-cc5e-844e87a775d6
msgctxt "ha8b68088gfd06g4b9bg8798g755b97acf8c8"
msgid "He'll make it big in Baldur's Gate. I know it."
msgstr "분명 발더스 게이트에 도착하면 크게 성공할 거야, 알 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Player
#. NodeID = 4d0b8688-24f9-c924-6e69-dd5d49263363
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:4d0b8688-24f9-c924-6e69-dd5d49263363
msgctxt "h95fdded3gedc6g4441g8977g5da839524565"
msgid "How about the three of you? Having fun?"
msgstr "너희 셋은 어때? 즐기는 중이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Player
#. NodeID = 565060dc-bc64-8e23-e0ca-0939ea5f984b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:565060dc-bc64-8e23-e0ca-0939ea5f984b
msgctxt "h0de4f405g77feg4c46ga0ccg628b882197b3"
msgid "I think the booze is doing more than we did."
msgstr "우리보단 술 덕분인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = a4bcab11-de3a-02cd-f5a6-12a698622782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:a4bcab11-de3a-02cd-f5a6-12a698622782
msgctxt "hdd3b0d0bg7300g4771g8dc2g4544b1f04e9e"
msgid "Me too. You're one of the good ones, you know that?"
msgstr "나도. 넌 참 좋은 사람이야, 알아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Player
#. NodeID = bef5dec8-a893-06ea-e0fa-b25891ba1d8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:bef5dec8-a893-06ea-e0fa-b25891ba1d8d
msgctxt "h0af50328g3421g442aga687gce9af231f723"
msgid "We? I did all the work."
msgstr "우리라고? 일은 내가 다 한 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = c61da8e9-19b3-4766-8cf8-1058779296fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ProdigySister(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:c61da8e9-19b3-4766-8cf8-1058779296fd
msgctxt "h573c29f3g42bbg4fd7g950fg97111e4614c8"
msgid "Cheers to a night we won't remember."
msgstr "기억하지 못할 밤을 위해 건배하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister
#. Speaker = Lia
#. NodeID = ea0a0497-5d93-cdba-6586-ff4b27e8aa46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ProdigySister:ea0a0497-5d93-cdba-6586-ff4b27e8aa46
msgctxt "had357597g6cbag4706ga692g7a3e5de3d48f"
msgid ""
"Yeah. Don't tell Rolan, but his magic show might be the highlight. He's been "
"doing them since we were little."
msgstr "물론. 롤란한텐 말하지 마, 하지만 그 녀석의 쇼가 오늘 밤의 하이라이트일지도 모르겠어. 우리가 어릴 때부터 하던 것이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = 10ec9508-8b6f-eba5-9c9a-801700c477c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_SonOfChef(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:10ec9508-8b6f-eba5-9c9a-801700c477c4
msgctxt "hd8c7f2bege72ag419cgb8dag656e4c3c4d8c"
msgid ""
"I won't be nursing their pounding heads and sick stomachs in the morning."
msgstr "아침에 저놈들이 숙취로 머리니 배니 아파하든 난 돌봐주지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = 1142b33d-5a21-4841-23db-0f5392d2d36b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:1142b33d-5a21-4841-23db-0f5392d2d36b
msgctxt "h2df5f4f8gad10g44f2gb648g5f2b0bb219d7"
msgid "Our dead deserve a sober tribute. Not this... <i>display.</i>"
msgstr "망자들은 맑은 정신으로 추모받아야 해. 이런... <i>놀자판</i>이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Player
#. NodeID = 161c5fc5-a53b-ca53-2a42-028546aa6fdc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:161c5fc5-a53b-ca53-2a42-028546aa6fdc
msgctxt "habc9a802g050eg4bc6g86dfg4f7868fae21e"
msgid "You should join them - have a pint or two."
msgstr "너도 끼지 그래? 한두 잔 걸쳐보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Player
#. NodeID = 178db53c-55ba-5d69-5a19-7abd65f5f1fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:178db53c-55ba-5d69-5a19-7abd65f5f1fe
msgctxt "h9df45d37g355dg4d8egafc5g2dba09ea800f"
msgid "You're right. This should be a somber occasion."
msgstr "네 말이 맞아. 엄숙히 추도하는 자리였어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = 389552a6-b07b-1d09-7f06-58ec8b270475
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:389552a6-b07b-1d09-7f06-58ec8b270475
msgctxt "h7e81cf74gbdfag423fgac89g166f3002ea1b"
msgid "I'm the only one showing proper, <i>sober</i> respect."
msgstr "여기서 제대로, <i>맨정신</i>으로 애도 중인 건 나뿐이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Player
#. NodeID = 43a6d9fa-7a5b-8921-7add-7062bcd04048
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:43a6d9fa-7a5b-8921-7add-7062bcd04048
msgctxt "hdee9ffe8g125cg447dg997dgee728a96734e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Player
#. NodeID = 638d22c2-6f10-3e12-11cd-7ecf4bb02f64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:638d22c2-6f10-3e12-11cd-7ecf4bb02f64
msgctxt "h207ffb18g5f9dg4a64ga0bbg3a506801beb5"
msgid "Are you this unpleasant by nature or choice?"
msgstr "원래 성격이 이리 뚱한 거야, 아님 이유가 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = 8e754f06-92ae-17a0-1c12-75c64a1fd5d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SonOfChefGotDrink = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_SonOfChef(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:8e754f06-92ae-17a0-1c12-75c64a1fd5d9
msgctxt "h1f807917g69b7g4397gbde8g65144964aca7"
msgid "Your friend already forced a pint on me, thanks."
msgstr "그쪽 친구가 하도 권해서 이미 한잔 마셨어. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = a0f749e3-e926-2945-846c-4e0e4ab0ccbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_Event_DrankWithSonOfChef(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:a0f749e3-e926-2945-846c-4e0e4ab0ccbd
msgctxt "h6e9b0107ge8fag4e46gaf41gdfc78ba13e59"
msgid "This party is a bit more bearable, thanks to that pint."
msgstr "이 잔치판이 조금은 참을 만해졌네. 술 좀 들어가니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = b2dcf793-4d8e-a443-9b99-1953a8c76b5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_Event_DrankWithSonOfChef(1) = True
#.   Global:
#.     - CAMP_GoblinHuntCelebration_Event_SonOfChefGotDrink = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:b2dcf793-4d8e-a443-9b99-1953a8c76b5c
msgctxt "h18a9a3c8gcec6g4971ga7b8g594b58281550"
msgid "Hm. Perhaps it'll make the evening more tolerable."
msgstr "흠. 술 좀 들어가면 이 꼴이 좀 더 참을 만해질 수도 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = bac0a34a-4740-2e20-3318-3732e423c08f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:bac0a34a-4740-2e20-3318-3732e423c08f
msgctxt "hda32edbagb73fg43f7gb313ga34a4606e048"
msgid "Not everyone. We lost people, and it's like they don't even care."
msgstr "다는 못 살았지. 사람들을 잃었는데, 쟤들은 전혀 신경 안 쓰는 듯 굴잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = c3ade085-de96-2d50-25df-459d7d606364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:c3ade085-de96-2d50-25df-459d7d606364
msgctxt "hfa645c65g4462g4765g8e5ag2953bef7abe6"
msgid "I'm perfectly fine without that poison, thanks."
msgstr "그딴 구정물 안 마셔도 난 아주 괜찮아. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = d600e941-b994-484f-e965-04ad100dfd8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:d600e941-b994-484f-e965-04ad100dfd8b
msgctxt "he23db17cg3068g4918ga8d4gaeee92a04749"
msgid "At least someone agrees with me."
msgstr "나랑 생각이 같은 사람이 있긴 하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = fc3da375-d669-623c-de9c-c871bb8766c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_SonOfChef(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:fc3da375-d669-623c-de9c-c871bb8766c8
msgctxt "h500475d1g849dg45c2g85e0g7bf3c649300d"
msgid "Look at them all, guzzling poison like we've the right to be happy."
msgstr "여기 꼴 좀 봐. 뭔 기쁜 자리라도 되는 양 구정물들 퍼마셔대네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = fdbadae7-a80d-4eaf-877d-205be361b3e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:fdbadae7-a80d-4eaf-877d-205be361b3e7
msgctxt "h9fe7e3aegd255g489eg845cg92909130ecb6"
msgid "We survived. Others didn't."
msgstr "우린 살았지만 아닌 이들도 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Ikaron
#. NodeID = fee3ffec-28b8-d272-5266-9a83f361ea12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef:fee3ffec-28b8-d272-5266-9a83f361ea12
msgctxt "h044f93dbgd23fg4b1dg8440g23eb5e759707"
msgid "But I care. And I won't drink myself into a stupor to change that."
msgstr "난 신경 쓰여. 그리고 그 느낌 지우려고 꽐라가 될 생각도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_SonOfChef
#. Speaker = Player
#. NodeID = ffdd7d61-f946-512c-4c37-5bcabca744b6
#. HandlePath = TaggedText[0].TagText[0]
