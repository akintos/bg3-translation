msgctxt "hd0c15403gf80fg4f06g9c7bga07e71c069fe"
msgid "<i>Approach [GEN_Playername4_703fdb8e-725b-280d-4ad0-a0881729ffa7].</i>"
msgstr "<i>[GEN_Playername4_703fdb8e-725b-280d-4ad0-a0881729ffa7]에게 다가간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 0f93ea84-487f-fe1c-e456-a70e50ea9df6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:0f93ea84-487f-fe1c-e456-a70e50ea9df6
msgctxt "h41ce9a5fg127dg424ag80d0g06a7ab88c698"
msgid "Thank the gods. I was ready to kill you. Crisis averted."
msgstr "천만다행이야. 까딱하면 널 죽일 뻔했어. 위기는 넘겼군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 0f93ea84-487f-fe1c-e456-a70e50ea9df6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:0f93ea84-487f-fe1c-e456-a70e50ea9df6
msgctxt "h329c84b9gd5fdg4dd5gab5cg20b4c62ff945"
msgid "<i>Chk</i>. My dreams can't be trusted..."
msgstr "<i>츠크</i>. 내 꿈은 도무지 믿을 수가 없군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 0f93ea84-487f-fe1c-e456-a70e50ea9df6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:0f93ea84-487f-fe1c-e456-a70e50ea9df6
msgctxt "h3451bb19gd553g4c9dg95d9gb9288566fdfe"
msgid ""
"Dream? But we're elves, we don't dream like these others do... bah, this "
"must be the tadpoles at play."
msgstr "꿈이라니? 우리는 엘프잖아. 다른 이들처럼 꿈을 꾸지는 않는다고... 쳇, 올챙이의 장난질이 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 0f93ea84-487f-fe1c-e456-a70e50ea9df6
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:0f93ea84-487f-fe1c-e456-a70e50ea9df6
msgctxt "h432009b3g068fg4338gbd55g006a32df76aa"
msgid "Ugh - the tadpole must be messing with my head."
msgstr "어휴, 올챙이가 내 정신을 흐뜨려놓는 것이 틀림없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 0fdd34f4-a1c4-733d-3aef-940a4b7c4577
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:0fdd34f4-a1c4-733d-3aef-940a4b7c4577
msgctxt "h1c82556agb919g4f95g987agbcb0a815368a"
msgid "*The thought of putting your fangs to her neck makes you feel sick.*"
msgstr "*그녀의 목덜미에 송곳니를 박아 넣을 생각만 해도 속이 메스껍습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 124435e5-0f32-c30f-48e4-d11348aa0366
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:124435e5-0f32-c30f-48e4-d11348aa0366
msgctxt "h95ab5bd5g51bbg4feag81ddg3045c440197b"
msgid "For your reference: bites hurt. Consider that a given."
msgstr "혹시 몰라서 말해 두는데, 물면 아파. 당연한 상식이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 124435e5-0f32-c30f-48e4-d11348aa0366
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:124435e5-0f32-c30f-48e4-d11348aa0366
msgctxt "hd07e3a02gefc3g4bd9g9c69gfcb7b39f5ee8"
msgid "Do you think I'm an idiot? You <i>bit </i>me!"
msgstr "내가 얼간이처럼 보여? 방금 날 <i>물었잖아</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 124435e5-0f32-c30f-48e4-d11348aa0366
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:124435e5-0f32-c30f-48e4-d11348aa0366
msgctxt "h16618d82gf2eag4273gae49gcc5ee35414a0"
msgid ""
"I woke to your <i>teeth </i>on my neck. Why should I not slice open yours?"
msgstr "네놈의 <i>이빨</i>이 목에 닿는 걸 느꼈다. 목을 베이기 전에 하고 싶은 말이라도 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 124435e5-0f32-c30f-48e4-d11348aa0366
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:124435e5-0f32-c30f-48e4-d11348aa0366
msgctxt "h95bcc58ag5ef9g4912g89e1g6369d26a26a3"
msgid "You didn't want to hurt me? I'm <i>bleeding</i>, you pasty ghoul!"
msgstr "다치게 할 생각은 없었다고? <i>피 흘리고</i> 있잖아, 이 창백한 식인귀 자식!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 124435e5-0f32-c30f-48e4-d11348aa0366
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:124435e5-0f32-c30f-48e4-d11348aa0366
msgctxt "h23e5f0dcgf11cg40f8g84c6gcff80138322f"
msgid "You're a vampire. I'm afraid <i>that </i>makes you a monster."
msgstr "넌 뱀파이어잖아. <i>그게</i> 널 괴물로 바꿔 놓진 않을지 염려스럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 14ccb1dd-fdd0-8b79-d266-8499a97c390b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.   Tag:
#.      - REALLY_KARLACH(3) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Astarion_TheHungerA_BiteSpeaker(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:14ccb1dd-fdd0-8b79-d266-8499a97c390b
msgctxt "h8380c672gf254g4e7ag9c3cga45d549a3d0e"
msgid "<i>Approach [GEN_Playername4_703fdb8e-725b-280d-4ad0-a0881729ffa7].</i>"
msgstr "<i>[GEN_Playername4_703fdb8e-725b-280d-4ad0-a0881729ffa7]에게 다가간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Astarion
#. NodeID = 1713baf9-9bcb-63b2-ebee-88570f1bbf61
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:1713baf9-9bcb-63b2-ebee-88570f1bbf61
msgctxt "h537aeaa6gb7efg4395gb18dg8790da26c145"
msgid "It won't happen again. You have my word."
msgstr "다신 그런 일 없을 거야. 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 185b1e3b-7613-705f-ca06-a5a48346b479
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerA_HalfDrain = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:185b1e3b-7613-705f-ca06-a5a48346b479
msgctxt "hcc4853e0ged95g4dddgafd0g00a57b12354b"
msgid ""
"*You creep back to your bed with a full belly and singing heart. For the "
"first time in centuries, you feel happy.*"
msgstr "*당신은 만복감을 안고 흥얼거리는 마음으로 잠자리에 기어듭니다. 수백 년 만에 처음으로, 행복한 기분이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 1afcf20c-0bbd-ca8a-236a-626bb0a79717
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:1afcf20c-0bbd-ca8a-236a-626bb0a79717
msgctxt "h1d205788g5336g46c4gb45cgd095167ec847"
msgid "I'm sorry - I didn't want to hurt you!"
msgstr "미안해. 다치게 할 생각은 없었어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Astarion
#. NodeID = 211749f9-b1dc-8982-5779-0777a643c46f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_AstarionAvatar_DrankGaleBlood = True
#.     - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:211749f9-b1dc-8982-5779-0777a643c46f
msgctxt "h87f20b82g3d1eg4f63gb0bfg0d17cada37b7"
msgid "Urgh!"
msgstr "우웩!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 22701e19-13e2-9abd-cc3c-d1c7791d677f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:22701e19-13e2-9abd-cc3c-d1c7791d677f
msgctxt "hb72af391g46b2g4707ga7d6g4372a36ed05a"
msgid ""
"*Blood gushes across your lips, but something's wrong. Very, very wrong.*"
msgstr "*피가 입술을 적시지만, 무언가 잘못되었습니다. 몹시, 매우 좋지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 22bc48a5-2c5d-e823-46d3-3dc90df8d7e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:22bc48a5-2c5d-e823-46d3-3dc90df8d7e9
msgctxt "hab922591ga750g4685gb265g7c94064c5b75"
msgid "You taste like bile! What the hell is wrong with you?"
msgstr "네 피는 담즙 맛이 나잖아! 대체 뭐가 문제지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 23e0e044-02cd-bd05-f2e4-cb05137dabb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:23e0e044-02cd-bd05-f2e4-cb05137dabb5
msgctxt "h76f25d23g98d7g4afegbbbag8c35351d264b"
msgid "*You try to wrench your head back, but your jaw refuses to obey.*"
msgstr "*당신은 머리를 뒤로 젖히려고 애쓰지만, 턱이 말을 듣지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 2529ecc6-3e60-c6fc-250f-4ff75caf9d44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:2529ecc6-3e60-c6fc-250f-4ff75caf9d44
msgctxt "hf2cc452fgf6dcg4237gbf82g9e36ca05765b"
msgid "*You fall back, glorious blood coating your throat.*"
msgstr "*당신은 뒤로 물러납니다. 영광스러운 피가 목구멍을 뒤덮습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 25a46395-7157-978a-9475-11f069dadd66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerA_Drain = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:25a46395-7157-978a-9475-11f069dadd66
msgctxt "hfd1e4105g47b2g4322gbdeegcc51f810677d"
msgid ""
"*You drink and drink and drink. Until, without even a whimper, it's all "
"over.*"
msgstr "*당신은 마시고 마시고 또 마십니다. 그러다 한순간, 신음 소리 하나 없이 모두 끝나버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 268f2d30-04bf-1a01-ee95-d44357c4ef48
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ELF or REALLY_ELF or REALLY_ELF
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:268f2d30-04bf-1a01-ee95-d44357c4ef48
msgctxt "h513cd95agc119g42cdgbecega47544019f63"
msgid ""
"*You look at your companions. Resting. Helpless. How badly do you need to "
"know?*"
msgstr "*당신은 동료들을 바라봅니다. 무방비하게 휴식을 취하고 있죠. 얼마나 간절히 알고 싶은가요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 268f2d30-04bf-1a01-ee95-d44357c4ef48
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:268f2d30-04bf-1a01-ee95-d44357c4ef48
msgctxt "h9bea1866gacdbg42fbg9729gc4178815e2fd"
msgid ""
"*You look at your companions. Sleeping. Helpless. How badly do you need to "
"know?*"
msgstr "*당신은 동료들을 바라봅니다. 무방비하게 잠들어 있죠. 얼마나 간절히 알고 싶은가요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 29fe5c07-308a-b6c5-c1bd-825c992c5fb3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerA_BiteAvatarFail = True
#.     - ORI_Astarion_Knows_Vampireness = True
#.   Object:
#.     - CAMP_Astarion_TheHungerA_Recognized(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:29fe5c07-308a-b6c5-c1bd-825c992c5fb3
msgctxt "hd11386fcg2efcg4abbg8165g584f570ddf7a"
msgid "*You stare, frozen, until they finally lock eyes with you.*"
msgstr "*당신은 얼어붙은 채 빤히 바라봅니다. 두 사람의 눈이 마침내 똑바로 마주칠 때까지.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 2b99b118-d669-7231-4960-29082a1cd123
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - aeffcfd5-d17f-12b2-954b-9cf82f734bcb_FemaleVictim = True
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerA_BiteAvatarFail = True
#.     - ORI_Astarion_Knows_Vampireness = True
#.   Object:
#.     - CAMP_Astarion_TheHungerA_Recognized(3) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:2b99b118-d669-7231-4960-29082a1cd123
msgctxt "h65641c49g9e73g4a2bgbae5g61aa8a842032"
msgid "*You stare, frozen, until she finally locks eyes with you.*"
msgstr "*당신은 얼어붙은 채 빤히 바라봅니다. 마침내 그녀가 당신을 똑바로 바라볼 때까지.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 2dc6aa7b-0802-93fa-0d56-80d762af02b4
#. HandlePath = TaggedText[0].TagText[0]
