#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:7ca0daa0-09fe-8851-a521-87e436eab479
msgctxt "had750f5fga900g4928ga4a2g48ed2ca3a824"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 7e0558b7-ac84-e8b0-45af-79b6e1f07b65
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYRKUL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:7e0558b7-ac84-e8b0-45af-79b6e1f07b65
msgctxt "h92114857g01cag4005gb134g7b9fdc4f2d5e"
msgid "Are you a herald of Myrkul? Death's shroud surrounds you."
msgstr "당신은 머큘님의 전령인가? 죽음이 당신을 휘감고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 7e0558b7-ac84-e8b0-45af-79b6e1f07b65
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: PALADIN_MYRKUL
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:7e0558b7-ac84-e8b0-45af-79b6e1f07b65
msgctxt "he7b9ce98g3345g4b7fg8897g682dd5bb2e50"
msgid "Are you a herald of my deity?"
msgstr "당신은 내가 모시는 신의 전령인 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
