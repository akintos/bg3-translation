#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:3849bd8d-d40c-70af-2a8e-5f25e95b22f1
msgctxt "h9cdba4aag8fb0g4cfcg8a24g59e19c7e8d05"
msgid "<i>Tell her everything - the dream, Cazador's orders - all of it.</i>"
msgstr "<i>모두 털어놓는다. 악몽과 카사도어의 명령은 물론이고 전부 다 숨김없이.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 3bd1046a-c93e-2809-bee1-fa07da483c62
