msgctxt "h0c832557g1059g4dfegb692g47f709e7e21b"
msgid ""
"Cazador's servants came for Astarion. He'll be in Cazador's clutches soon "
"enough."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_VampireAmbush_PAD_AstarionKidnapped
#. Speaker = Player
#. NodeID = c51dce40-7d7d-4875-d43e-56bc017b3a78
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(0) = False
#. TagRule: REALLY_SHADOWHEART
