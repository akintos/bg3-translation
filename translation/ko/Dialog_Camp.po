#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_VossCampConfrontation_PAD_PickupGithRadar:67394c3b-f573-4309-bf82-0c78a105d986
msgctxt "h9ac0fcd7g5c4eg432bg917eg477b08e112f1"
msgid "Hm. What manner of gadgetry did the gith carry?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_VossCampConfrontation_PAD_PickupGithRadar
#. Speaker = Player
#. NodeID = 67394c3b-f573-4309-bf82-0c78a105d986
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
