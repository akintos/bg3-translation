msgctxt "h19527aaagdab5g4146gbf52g51f51e41fbe3"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = a37f1a72-9c3a-f4cb-6212-ad117dcc00ac
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:a37f1a72-9c3a-f4cb-6212-ad117dcc00ac
msgctxt "h3fa127fbga06cg4cbbgbf29g697950933580"
msgid "<i>Slap the blade from his hand.</i>"
msgstr "<i>손에서 칼을 쳐낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = a4578d49-f818-ee16-e3b2-47288d91b5eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:a4578d49-f818-ee16-e3b2-47288d91b5eb
msgctxt "ha12145d9g84abg48fag883eg07001c677ad9"
msgid ""
"You almost figured it out. But almost won't save your friend. You had better "
"up your game if you hope to truly save him."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = ab5f51e0-829c-5318-0a85-8630ccdd4d5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:ab5f51e0-829c-5318-0a85-8630ccdd4d5c
msgctxt "h58d20db3gd7beg4e0ag8a9dg575cc80ad317"
msgid ""
"I can't... Whatever powers I have, they are dwarfed by the evil of this "
"place."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = aea35052-3a7b-6714-6d46-a6281362f41c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_State_HalsinAbduction_IsYenna = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:aea35052-3a7b-6714-6d46-a6281362f41c
msgctxt "h553a74ccg53e8g4cddg8c8fg89d5796ed401"
msgid "Get away from her - <i>now</i>."
msgstr "예나한테서 떨어져. <i>당장</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = bc1f0200-c0fa-0e99-9486-a1ea3c555d58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:bc1f0200-c0fa-0e99-9486-a1ea3c555d58
msgctxt "hec4891fdg148bg4478g9cf2g7dbc69344015"
msgid ""
"...Or is it? Perhaps if you're a little faster, you may yet save the big ox."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = bd2a6561-1cde-8353-6300-5183abb98362
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:bd2a6561-1cde-8353-6300-5183abb98362
msgctxt "he2230cf6g51f3g4095g95a8g6cbed92bf0df"
msgid "I don't understand. What does the city have to do with this?"
msgstr "무슨 말이야. 도시가 대체 뭘 어쨌는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = bea3f4ec-da30-231a-211d-7439c50b19ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:bea3f4ec-da30-231a-211d-7439c50b19ac
msgctxt "h322e56c7g969ag49bfgb4e0g09bf3222c1a8"
msgid "Please... wait. I did not want this. I could not stop it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = c16ed211-cc4f-38c4-ec24-5aa54589fed3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:c16ed211-cc4f-38c4-ec24-5aa54589fed3
msgctxt "h1e1563b5g4c96g4bb2g8a63g32fae109e886"
msgid ""
"There is only one god fit to be bowed to in this place. The last god who "
"will ever be knelt before... then all of this will tear itself apart -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = c22585da-e88b-a993-009e-2f4aab0ffd42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:c22585da-e88b-a993-009e-2f4aab0ffd42
msgctxt "h5caf6b7ag15a4g4a11g835fgcaf1298fe008"
msgid "Lower! Stick it in the guts, not the heart! <i>Make it last!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = c3903f8e-4dec-cb6a-31bb-2c26ec560174
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:c3903f8e-4dec-cb6a-31bb-2c26ec560174
msgctxt "h85e9080dg012bg42aagbea9gb22c5b952348"
msgid ""
"So close to grasping the problem, but you fell short all the same. You had "
"better sharpen those wits if you hope to spare your friend the <i>true</i> "
"blade."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = c48efb77-a3dd-d937-470e-1a6248bf019b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:c48efb77-a3dd-d937-470e-1a6248bf019b
msgctxt "hba6e23feg856dg4e3ag98e2gae889d7b3a74"
msgid "*Snarl.*"
msgstr "*으르렁*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = c763825f-1980-f24d-db22-d3b7eb4113e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:c763825f-1980-f24d-db22-d3b7eb4113e9
msgctxt "h848e3617gee0eg451egb3b2g66530968876a"
msgid ""
"Mmm. I feel like a new man. A sharp blade is a <i>true tonic</i>. Your "
"friend will find out for himself, soon enough..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = c85efc64-24ef-de5a-84ad-054ebdd7d1eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:c85efc64-24ef-de5a-84ad-054ebdd7d1eb
msgctxt "h0ab5566eg8647g478fgaec5g598577748a8a"
msgid ""
"Silvanus has abandoned this place. It's nothing but stone, grime, smoke, "
"<i>pain</i>. The trees choke here. The animals hang from butchers' hooks. "
"Nature is <i>dying in the gutter</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = d111d58a-5ee6-5f0c-3c03-55853223bb02
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:d111d58a-5ee6-5f0c-3c03-55853223bb02
msgctxt "hba019679g630ag4630g9282g46363e662c4e"
msgid "Wait - this must be Orin's doing. She's compromised our camp."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = d601975d-e01a-f812-7d0b-fb557146bef8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:d601975d-e01a-f812-7d0b-fb557146bef8
msgctxt "he279d0acgaee0g45cdga55bg2e9061894b62"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = dcf5839a-754f-6d10-5d75-50bb726a99cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:dcf5839a-754f-6d10-5d75-50bb726a99cf
msgctxt "hc5f25a81g1229g4080gac48g736970791500"
msgid "No. This is how it must be..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = e7316aa7-2ff2-99fe-ff03-200988952159
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:e7316aa7-2ff2-99fe-ff03-200988952159
msgctxt "hb21415e4g3cefg4f39gaccfg100663946947"
msgid "Halsin...? What have you done?!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = f37400f9-bd0c-b90b-533e-2b37f43ba782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:f37400f9-bd0c-b90b-533e-2b37f43ba782
msgctxt "h8fbd1990gc012g4bfag90c4gd07ba6c4d1ea"
msgid ""
"It has <i>everything </i>to do with this place. The rot is all around us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = fb82f2d7-6cc7-8907-bbd9-ebbc6f8f81a4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:fb82f2d7-6cc7-8907-bbd9-ebbc6f8f81a4
msgctxt "h1874ecdcg248fg4a61gb7e4g026fb2935f2d"
msgid ""
"<i>Think fast. There must be another explanation for this - some way to "
"treat Halsin.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 00e3d004-a685-4b66-ebb2-2722adc4950f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
