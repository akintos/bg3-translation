msgctxt "h69b7f413gc530g40dbg8f7bg9a814eac9819"
msgid "Show me your ways."
msgstr "앞장서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = aae19306-5cc2-182f-66f7-9c3a8dbef5c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:aae19306-5cc2-182f-66f7-9c3a8dbef5c4
msgctxt "hacc35189gefe3g4016gb9d9g22850ff01224"
msgid "And never forget it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Tender Henk
#. NodeID = abc6c688-1c4f-300c-63ca-7c90de5389fd
