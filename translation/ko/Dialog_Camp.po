msgctxt "hba57bfa1g46eag4819ga977g79b487cbb919"
msgid "It's a <i>wake</i>."
msgstr "<i>추도하는</i> 자리라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = c5789691-9883-3bde-67eb-7105b0a5e517
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:c5789691-9883-3bde-67eb-7105b0a5e517
msgctxt "heaca8b97g6a21g4d1bg810cg0ad7046087fe"
msgid "That was <i>so</i> loud."
msgstr "<i>귀청</i> 떨어지겠다."

