msgctxt "hfc6e553ag53afg4da6gac71g5a2016c870d3"
msgid "<i>Fetch a piece of food from your bag.</i>"
msgstr "<i>가방에서 음식 몇 조각을 챙긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 2bb02121-2f41-fd85-8f5a-20934b373d53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
