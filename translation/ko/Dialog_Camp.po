#. CheckFlags:
#.   Local:
#.      - 4fa781b1-5bf3-5873-4331-f56c0efa6476_A = True
#. SetFlags:
#.   Local:
#.     - 4fa781b1-5bf3-5873-4331-f56c0efa6476_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:c68a91c0-0912-8523-e9b4-881c05ef0e3b
msgctxt "h55ec7fddgd0f7g463fgb63eg69066b0aad87"
msgid "Your mug's as sour as this ale. We're supposed to be celebratin'!"
msgstr "에일주 맛 만큼 네 면상도 죽상이다 야. 즐기는 분위기에 좀 맞춰야지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = d3764b0a-070a-7f88-87a0-9d7974aadbab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:d3764b0a-070a-7f88-87a0-9d7974aadbab
msgctxt "h18cffb23g1ed9g4d93g98cagb9104b5c9058"
msgid "I am a bit light-headed."
msgstr "머리가 조금 띵하긴 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = d7f50364-02b9-e99e-1cf4-92191908015d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:d7f50364-02b9-e99e-1cf4-92191908015d
msgctxt "hdc9c2898gc1f4g4d91gb859g9d5aedc1f067"
msgid "I - all right."
msgstr "그건 좀... 맘대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = 08b31aee-58bd-d48e-7fc9-db45b51758eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:08b31aee-58bd-d48e-7fc9-db45b51758eb
msgctxt "hee649aa3g0a41g44d6g90f2g31755c40ecd5"
msgid "Yes."
msgstr "그럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 0b36977d-68de-3237-1a73-a618b25d6475
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:0b36977d-68de-3237-1a73-a618b25d6475
msgctxt "haa6bf37agca09g45cegaccdgbf06c92a5de3"
msgid "What for? It's all dark and muddy."
msgstr "뭐 하러? 컴컴하고 진흙투성이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = 0b9471d7-e354-f6ce-43ea-dbf23e2e47b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:0b9471d7-e354-f6ce-43ea-dbf23e2e47b5
msgctxt "h4a2bf394ge9bdg4662g9c6dg436c86bd1690"
msgid "Mm. No."
msgstr "음. 아니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 248698d6-ea62-7a34-5bef-93c8768a1ea1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:248698d6-ea62-7a34-5bef-93c8768a1ea1
msgctxt "h286b8598ga5fcg491agba64g66365b117cd7"
msgid "You're drunk."
msgstr "너 취했구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 2a1004bf-0d43-7346-383e-b39e0371e86f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:2a1004bf-0d43-7346-383e-b39e0371e86f
msgctxt "hb92380d5g355fg4761g88e7g21481ce09eb0"
msgid "Oh. <i>Ohhh.</i>"
msgstr "아. <i>아아아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 2e2a22db-9744-064e-9efe-7f6241beb82f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:2e2a22db-9744-064e-9efe-7f6241beb82f
msgctxt "he0f41350g2976g4984g992bg16c3bd8f95e7"
msgid "Without you? Nah."
msgstr "널 빼놓고 나만? 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 47a2e847-2f3a-be17-ae11-c4839de8fbb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:47a2e847-2f3a-be17-ae11-c4839de8fbb4
msgctxt "hca4012ddge2ebg4674g8e73ga5a6ca8a8991"
msgid "I love <i>you.</i>"
msgstr "나도 <i>사랑해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = 671fe0af-acf4-abd1-8977-ba24e47ecff3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:671fe0af-acf4-abd1-8977-ba24e47ecff3
msgctxt "h6f6a2ccdge252g406fg967bg951c3797658e"
msgid "I am."
msgstr "그렇지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 6797782b-4f51-1a18-b6d6-c079bb73c776
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 966616f6-f9a1-58cc-6369-867f4c00cd23_A = True
#.      - 966616f6-f9a1-58cc-6369-867f4c00cd23_C = False
#.      - 966616f6-f9a1-58cc-6369-867f4c00cd23_B = False
#. SetFlags:
#.   Local:
#.     - 966616f6-f9a1-58cc-6369-867f4c00cd23_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:6797782b-4f51-1a18-b6d6-c079bb73c776
msgctxt "h0a3ceebbgcb1dg4050gbfffg858231b27fed"
msgid "Maybe we should forget the city - live out here under the stars."
msgstr "도시로 가 사는 건 잊는 게 어떨까? 이렇게 별들 아래에서 사는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 7a2663fd-c5cb-bad8-801a-895b05663b7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:7a2663fd-c5cb-bad8-801a-895b05663b7e
msgctxt "h64c2f728gd598g4bccgb9c2gd99c8d9b6687"
msgid "So?"
msgstr "그래서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = 7e226e35-ebf4-34e4-042b-b4e5ac5f85b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:7e226e35-ebf4-34e4-042b-b4e5ac5f85b4
msgctxt "h480d7adag19c2g4289gb97eg832c4127882d"
msgid "Private, too."
msgstr "남들 눈에도 안 띄지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = 85f89b12-f58a-e70d-3306-c032ba446fa6
