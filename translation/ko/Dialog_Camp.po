#, fuzzy
msgctxt "h90765508g5a01g4727gb505g8d6b91884954"
msgid "Well, you're both welcome here."
msgstr "뭐, 너흰 둘 다 환영이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Scratch
#. NodeID = aaa9091d-03ea-6bf3-8abd-95541a364f2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:aaa9091d-03ea-6bf3-8abd-95541a364f2b
msgctxt "h3585e748g9089g4202g808bgfefcf235fe91"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = ad55edd8-dfe3-3c1b-9325-0469079abc6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:ad55edd8-dfe3-3c1b-9325-0469079abc6f
msgctxt "h96845996gfdd4g40c7g925fg94fcb0fab6b7"
msgid "All right then, so long as nobody's getting hurt."
msgstr "좋아, 아무도 안 다친다면야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
