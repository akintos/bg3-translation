msgctxt "h0224dd8bg57a8g4d3fgb264g5f18c3b6a6bf"
msgid "Impressive. Are there other ways you can help us?"
msgstr "흥미롭네. 혹시 그것 말고 다른 도움도 줄 수 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 4885592e-f5d1-cfd1-3f62-7c7ffb56a9c9
