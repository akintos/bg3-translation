msgctxt "h29971753g5735g4930gb29ag094a798db0c8"
msgid "We deserved that attack. And he deserved better."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_HalsinsRevenge_PAD
