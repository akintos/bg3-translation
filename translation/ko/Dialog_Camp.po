#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:5a956df8-baa4-68c0-06dd-ed7fcf3b944b
msgctxt "he31917e0gb03bg4229g8ce0gc0cd633cb501"
msgid "True Soul! A present, straight from the battlefield."
msgstr "참된 영혼이시여. 전장에서 바로 가져온 선물입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Goblin Brawler
#. NodeID = 620091a6-8da5-8340-2c42-967f986690da
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_Goblin001(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:620091a6-8da5-8340-2c42-967f986690da
msgctxt "h98cb1586g9c27g42c7g9ad1ge0011e486d77"
msgid "To think the Absolute sent you to us. We are truly blessed."
msgstr "절대자께서 당신을 우리에게 보내주셨다니. 축복이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Narrator
#. NodeID = 6c99d12e-5e79-ae04-0a41-c258f5e4f82c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:6c99d12e-5e79-ae04-0a41-c258f5e4f82c
msgctxt "hac5a76a9gc415g4bbcg8110gfcf7a3a0d7a0"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Player
#. NodeID = 6e7a705b-b220-c72a-659e-bdab8c0ba88e
