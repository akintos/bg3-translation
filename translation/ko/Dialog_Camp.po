#.      - AVATAR(3) = False
#.      - REALLY_GALE(3) = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:79d0475c-d702-2560-acc5-74b6a9703965
msgctxt "h029c0cfagf0deg4d7bg8e0cgbb65bec99efe"
msgid ""
"What the... Back off! And spit that out if you know what's good for you!"
msgstr "이건 무슨... 물러나! 제정신이라면 당장 도로 뱉어내도록 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 79dd33bd-4618-c9cf-ea1e-7f2c1d0ec486
