#, fuzzy
msgctxt "h5792275fg28b7g4bf4gb8a7g79459028b98b"
msgid "Up to old tricks again, are we?"
msgstr "예전의 그 짓을 또 하는구나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Gale
#. NodeID = bee4eb20-9ef5-f75d-eaa3-9950d4c5212a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Companion_Leave(0) = True
