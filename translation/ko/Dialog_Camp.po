msgctxt "hc42dadccg6559g4f58gbea5g85e48a52174c"
msgid "<i>Go to bed, hoping to dream of Wyll.</i>"
msgstr "<i>윌의 꿈을 꾸기를 바라며 잠자리로 간다.</i>"

