msgctxt "h223d9df4gfff4g4412g9839g8bd232354fe0"
msgid "Here you are."
msgstr "여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 29dfdee2-7ecb-d5b9-93f4-7fbf30a1b6e6
