#. NodeID = f14a4205-b1c1-d99b-2ad0-394512ced4fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:f14a4205-b1c1-d99b-2ad0-394512ced4fe
msgctxt "hb7090b3bg7cadg4088g96f3g5f1fc6c70761"
msgid ""
"I wonder if he uses magic in the bedroom? That could go very well or very "
"badly."
msgstr "그가 침대에서 마법을 쓸지 궁금하군? 완전 끝내주거나 아니면 완전 끔찍할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = f654cd64-2548-282c-35ce-5a8dab9cc9e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:f654cd64-2548-282c-35ce-5a8dab9cc9e1
msgctxt "h81149feagee86g4b83g9774g55f953ac7519"
msgid "Are you offering something better? Because I could be persuaded..."
msgstr "더 나은 제안 있어? 날 설득할 수도 있는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
