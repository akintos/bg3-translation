msgctxt "h2005d107gd3f7g4438g9ebagcf8465ed12c9"
msgid "You insolent little-"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = e245355b-c93f-3432-a21e-464134b240f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:e245355b-c93f-3432-a21e-464134b240f3
msgctxt "hd71d36bagdac2g41c5g8ba0g5ef6bdb4671c"
msgid "I hate it. This is awful."
msgstr "완전 별로야. 끔찍해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = e35ea515-6b49-4ec9-ab1b-59f8890b201d
