#.      - CAMP_OwlbearCub_HasMet_GoblinHuntCelebration(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub:5c8970fe-c606-0c2d-661d-ffb1760e76fb
msgctxt "h4bd044d2g0db8g48a2g8a0fgfbdd01cf9332"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub
#. Speaker = Owlbear Cub
#. NodeID = 72b482aa-1917-95a4-749e-19534dfbd21a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_OwlbearCub_HasMet_GoblinHuntCelebration(1) = True
