msgctxt "h23f0b149g0c1eg417fg982agec7151e45b92"
msgid "Farewell."
msgstr "안녕히."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Narrator
#. NodeID = bf4ae6eb-2eb4-6651-7b8f-a83285e30e6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale:bf4ae6eb-2eb4-6651-7b8f-a83285e30e6b
msgctxt "h18f42b8eg27acg4b8dg8e6cgaa653a5a3f70"
msgid ""
"*You flutter through his mind like a bat through the night and you see...*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Gale
#. NodeID = c26d4b6c-0bbf-c1b7-8fb8-2f22fea4ffe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale:c26d4b6c-0bbf-c1b7-8fb8-2f22fea4ffe6
msgctxt "hd7e1ab04g9384g4922gaabeg7a354e8c4f8d"
msgid "Good night."
msgstr "잘자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Player
#. NodeID = cac593f6-5567-3ac8-e320-fa22b72649a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale:cac593f6-5567-3ac8-e320-fa22b72649a7
msgctxt "h01df7177g466bg4da7g8f17gcd42f68346f7"
msgid "Gale, what did you do?"
msgstr "게일, 너 무슨 짓을 한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Narrator
#. NodeID = d43fcdd0-7491-c5a7-24b1-93f806434fce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale:d43fcdd0-7491-c5a7-24b1-93f806434fce
msgctxt "hbc7979e8gb089g4c3cga74fgd105054ad08f"
msgid "*... nothing but darkness.*"
msgstr "*…보이는 것은 어둠뿐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Player
#. NodeID = d48b285f-4e4d-7a44-176c-9d6147934a27
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Wisdom
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale:d48b285f-4e4d-7a44-176c-9d6147934a27
msgctxt "hf913df8dg5679g4bc3g8f1bg2a640053f2c4"
msgid "<i>Something's off. Try to connect with Gale without him noticing.</i>"
msgstr "<i>뭔가 수상하다. 게일에게 몰래 정신을 연결해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Gale
#. NodeID = d7cdd6f1-9b98-3284-aed3-49fac6a13734
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale:d7cdd6f1-9b98-3284-aed3-49fac6a13734
msgctxt "hadc349bbg8d73g4e47g89eageec375378fd4"
msgid "I no longer require assistance - neither yours, nor that of artefacts."
msgstr "난 더 이상 누군가의 도움이 필요하지 않아. 너든, 그 아티팩트든 간에."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale
#. Speaker = Player
#. NodeID = e275d204-001d-5550-e6e0-717a19bedfc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Betrayal_CRD_Gale:e275d204-001d-5550-e6e0-717a19bedfc6
msgctxt "h0a650e14g4467g4ff6gae52ge147aef9cf69"
msgid "Care to tell me why?"
msgstr "이유를 말해줄 수 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 02295dc2-a0f9-dc73-63a3-a2eea996a94b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:02295dc2-a0f9-dc73-63a3-a2eea996a94b
msgctxt "hcc06dc83g230eg43bbg922eg0619d4fe9283"
msgid ""
"*The ache builds as you squeeze your hands together. Were your fingers "
"always so thick, your skin always so sticky?*"
msgstr "*당신이 손을 쥐어 짤수록 통증이 심해집니다. 당신은 언제나 이렇게 손가락이 두껍고 피부가 끈적거렸나요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 0832c3d0-52a1-c705-cdab-79c1bee42d07
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_LaezelBeforeDream_Event_TakeBlade(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:0832c3d0-52a1-c705-cdab-79c1bee42d07
msgctxt "h3784df4eg1b56g46e8g86ffgd9d455be4871"
msgid "Take it. One motion. Across the neck."
msgstr "가져가라. 한 번에. 목을 그어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 0b6d5f40-dcbf-1320-782b-5400da0939f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:0b6d5f40-dcbf-1320-782b-5400da0939f3
msgctxt "h37db1b81g08ffg4581ga817gff6712d402ac"
msgid "<i>Wipe the sweat from your brow.</i>"
msgstr "<i>이마의 땀을 닦아낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 0dc8c714-3357-5fb4-43d9-0d37356c413e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - CAMP_Daisy1LaezelBeforeDream_Event_FailedPersuasion = False
#. SetFlags:
#.   Local:
#.     - 7d72b4c3-1a05-876a-708d-bc0ef1f84110_AttemptedCheck = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:0dc8c714-3357-5fb4-43d9-0d37356c413e
msgctxt "hf835a61egf0e0g4fdag9081g4addd42c50ce"
msgid ""
"Don't you see how far gone <i>you </i>are? Give me that blade - I'll make it "
"quick."
msgstr "<i>네가</i> 얼마나 막 나가는지 모르겠어? 그 칼 내놔. 내가 빨리 끝낼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 1680f93c-f728-46f1-ed33-b64ddd2a26ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_LaezelBeforeDream_Event_LaezelPersuaded = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:1680f93c-f728-46f1-ed33-b64ddd2a26ed
msgctxt "h0468c2b6gb4b1g40f2gbaa9g7095952acc75"
msgid ""
"I will wait. But know this: I am watching. If the sickness does not pass "
"come dawn..."
msgstr "기다려보겠지만 한 가지 알아둬라. 내가 지켜보고 있다. 만약 아침이 돼도 증상이 사라지지 않으면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 1a016497-864c-52ca-d57c-36539af9d825
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_LaezelBeforeDream_Event_AttackedLaezel = True
#.   Object:
#.     - GLO_Companion_Combat(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:1a016497-864c-52ca-d57c-36539af9d825
msgctxt "h819835afge773g4b66gbd8eg93a35dbb9185"
msgid "<i>Vlaakith gha'g shkath zai!</i>"
msgstr "<i>블라키스 가그 슈카스 자이!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 1a422b98-da45-1e12-f102-c0687330fa7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Daisy1LaezelBeforeDream_Event_PassedTadpole = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:1a422b98-da45-1e12-f102-c0687330fa7d
msgctxt "h7904cc75g7533g4aaeg8a85ga542fd5f0dbc"
msgid "Be strong. You will survive this. You will please your queen!"
msgstr "강해져야 해. 넌 살아남아서 여왕을 기쁘게 할 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 1c748422-59dd-d555-8017-b63e198da895
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:1c748422-59dd-d555-8017-b63e198da895
msgctxt "hb01a49d5g18abg4b4cga669g36743d435f98"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 28008a26-d8b4-eb20-4d22-ac886f9d8331
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:28008a26-d8b4-eb20-4d22-ac886f9d8331
msgctxt "h4e3d210dg9b90g4eedg9ba0g01ccd1a21e9d"
msgid ""
"*Your finger traces the arc of your lips. Wetness: sweat, blood, and saliva "
"mixed into one viscous liquid.*"
msgstr "*손가락이 입술의 호를 따라 움직입니다. 젖어있습니다. 땀, 혈액, 타액이 하나의 점성 액체로 섞인 상태입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 2b69c280-05fc-1871-7ab3-390f4f91a258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:2b69c280-05fc-1871-7ab3-390f4f91a258
msgctxt "h24bb28b6gb3a6g4855gaeb4g64f332618a54"
msgid "<i>Chk</i> - a splendid ruse. My anger is surpassed only by my respect."
msgstr "<i>츠크</i>, 훌륭한 계책이군. 내 분노를 능가하는 건 오직 존경심뿐이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 30bc9949-e4bb-be83-51ed-0d7d5d8bb468
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Origin_State_TiredOfTalkingTo(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:30bc9949-e4bb-be83-51ed-0d7d5d8bb468
msgctxt "h8b4fa6f3gb149g4261g9cffgc80ca3eec5a4"
msgid ""
"*Your minds intertwine. You sense a touch of uncertainty, a touch of "
"disgust.*"
msgstr "*서로의 정신이 뒤얽힙니다. 불신과 혐오의 손길이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 365dbf83-6132-b21a-3853-e71e75e5f8e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:365dbf83-6132-b21a-3853-e71e75e5f8e1
msgctxt "h2cb03994g0199g476dgbdfegf874308eb440"
msgid ""
"*The world swims as you close, then reopen your eyes. How long have you been "
"waiting here? A moment? A night? A tenday?*"
msgstr "*눈 앞의 세상이 흐릿해지고, 당신은 눈을 감았다 뜹니다. 여기 얼마나 오래 있었던 걸까요? 한 순간? 하룻밤? 열흘?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 3778fa72-09fc-dbf3-40fd-14078be77f9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7d72b4c3-1a05-876a-708d-bc0ef1f84110_AttemptedCheck = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:3778fa72-09fc-dbf3-40fd-14078be77f9a
msgctxt "h250e6a33gf04ag46d1ga868gbcc03ec5970a"
msgid ""
"I will not let the <i>ghaik</i> take me. I <i>will</i> earn Vlaakith's "
"honour."
msgstr "<i>게이크</i>가 나를 데려가게 두지는 않겠다. 나는 블라키스 님의 영광을 <i>얻을 것이다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 37db0f55-9ef5-9126-5116-69c46975d500
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:37db0f55-9ef5-9126-5116-69c46975d500
msgctxt "h31c31140g5c74g4140gafe0g68d1bff9eec7"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 38bb083b-ee64-4590-9d7b-89524aa7e8e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_LaezelBeforeDream_Event_ExecuteLaezel = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:38bb083b-ee64-4590-9d7b-89524aa7e8e6
msgctxt "h7fad0852gd60dg48b5g9193g8d395a47f0b4"
msgid "I will not be <i>ghaik</i>. <i>Vlaakith gha'g shkath zai!</i>"
msgstr "난 <i>게이크</i>가 되지 않을 것이다. <i>블라키스 가그 슈카스 자이!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 3bfd4ca6-8ec9-412d-b6f2-38bf797105fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Global_State_Daisy1BeforeDreamCom = False
#. SetFlags:
#.   Global:
#.     - CAMP_Global_State_Daisy1BeforeDreamCom = True
#.   Object:
#.     - GLO_AddNearbyPlayersToDialog(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:3bfd4ca6-8ec9-412d-b6f2-38bf797105fe
msgctxt "h2eb419b2g8a84g4d4ag88f5gc664b4a0aea7"
msgid ""
"*The air is heavy. Moisture drips down your forehead; pain shoots through "
"your fingers.*"
msgstr "*공기가 무겁습니다. 이마에 땀이 흘러내리고 손가락에 고통이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 3eb43dda-53b3-4425-0aa1-66a68016ee82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:3eb43dda-53b3-4425-0aa1-66a68016ee82
#, fuzzy
msgctxt "hd21543b0g513dg454bg953eg66cfddeaf505"
msgid ""
"*The great warrior Lae'zel, a failure to her kind. She will wield no silver "
"sword, ride no red dragon, forever unknown to the great lich queen Vlaakith.*"
msgstr ""
"*위대한 전사 레이젤은 그녀 종족의 실패자입니다. 그녀는 은검을 휘두를 수도, 레드 드래곤을 탈 수도 없으며, 위대한 리치 여왕 "
"블라키스에게 영원히 알려지지 못할 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 40d3af37-6872-6b69-d4ac-7291958f34bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:40d3af37-6872-6b69-d4ac-7291958f34bc
msgctxt "hb687f79bg1fecg42afg89eeg958b730fedf4"
msgid "<i>Blink away the discomfort.</i>"
msgstr "<i>눈을 깜빡여 불편함을 없애려 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 42875b84-90ab-e3ec-597c-d6ee1f9829f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:42875b84-90ab-e3ec-597c-d6ee1f9829f4
msgctxt "hf89ee1cegcacfg40aegbf19ga4e424f6562e"
msgid ""
"Can you feel it crawling through you? Tendrils squirming in your chest, "
"gripping your heart, piercing your belly? Your bones popping, your flesh "
"swelling?"
msgstr ""
"네 몸속을 기어다니는 것이 느껴지느냐? 촉수가 가슴에서 꿈틀거리고, 심장을 움켜쥐며, 배를 찌르는 느낌이 드느냐? 뼈가 터질 것 같고 "
"살이 부풀어 오르지 않느냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 4ec43a01-acc7-bf27-322e-231b37715c18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:4ec43a01-acc7-bf27-322e-231b37715c18
msgctxt "ha3244346g4b6fg4ebdga960gfd69694fe1c1"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 52b8be00-9ca0-9124-0076-427119de2fca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:52b8be00-9ca0-9124-0076-427119de2fca
msgctxt "h37468df7g1e46g4a5dgb83dgb39ca5fa412e"
msgid "This is not exhaustion. This is ceremorphosis."
msgstr "이건 지친 게 아니야. 뇌변이가 일어나는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 56ff97a2-7954-1007-40fd-babdd39336ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:56ff97a2-7954-1007-40fd-babdd39336ab
msgctxt "ha1e01810g11dag4421gac62g744565a6bd35"
msgid "Close your eyes. Submit."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 5ebbd042-6e33-aa65-7c1a-8c687867fd7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:5ebbd042-6e33-aa65-7c1a-8c687867fd7c
msgctxt "hc67e30b5g6f34g4208g841cg80930641bf58"
msgid "<i>Ch'k'l ghaik Vlaakith m' zath'ak!</i>"
msgstr "<i>츠킬 게이크 블라키스 므쟈터크!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 6059d497-0908-3ee5-09c8-010b97c8992b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_LaezelBeforeDream_Event_LaezelKilledPlayer = True
#.   Object:
#.     - GLO_Companion_Combat(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:6059d497-0908-3ee5-09c8-010b97c8992b
msgctxt "hb96ef52ag952bg4406gb2c9gccbcd5d4cb39"
msgid "Let it be so. <i>Vlaakith gha'g shkath zai!</i>"
msgstr "그리 되리라. <i>블라키스 가그 슈카스 자이!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 6ab4f360-af92-e98f-6d7e-76f30894a212
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:6ab4f360-af92-e98f-6d7e-76f30894a212
msgctxt "hb10eb4ecg7d4dg4613g9092g40c69818115d"
msgid "No one is dying tonight. We still have time."
msgstr "아무도 오늘밤에 죽지 않을 거야. 우리에게는 시간이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 72703bb4-c36e-51cd-5056-f6f83e0b7375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:72703bb4-c36e-51cd-5056-f6f83e0b7375
msgctxt "h3da12e16g39e2g4177ga665g6049fbb10910"
msgid "<i>Rub your aching hands.</i>"
msgstr "<i>아픈 손을 문지른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 733a1893-3b73-d28b-fd3d-2c2f3d76e073
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
