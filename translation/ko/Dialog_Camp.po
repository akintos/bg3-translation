#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:f3c82b14-33cd-9122-7908-1abb2c0b8ecd
msgctxt "h039ded09gb795g4b1aga077g690ce59b4b21"
msgid "<i>Give a twirl. A calm twirl.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = f70769e2-9ee8-2ec9-8ae3-92988a122068
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:f70769e2-9ee8-2ec9-8ae3-92988a122068
msgctxt "hebbd1249g2db3g4963g87c0g4514e79692b5"
msgid ""
"But I count you as a friend. My closest, in all honesty. Please - dance with "
"me. If we must burn with the Hells' fires, let us burn together."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = f737df05-b7d1-2f0a-7ee9-d3e291fdcd3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:f737df05-b7d1-2f0a-7ee9-d3e291fdcd3b
msgctxt "h0777cb6fgd40eg4be6g921cg7f8d79937fce"
msgid ""
"Oh! Sorry. I didn't see you standing there. Lost in the steps, truth be told."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = f7981c7f-6e05-fbeb-f383-735a69aa4a26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:f7981c7f-6e05-fbeb-f383-735a69aa4a26
msgctxt "h48af8ac6g9445g4051g963fg818b55dca255"
msgid "I'll show you everything I know, and then some - I promise."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = fa5581f5-deca-a63d-4e3a-701543971eb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:fa5581f5-deca-a63d-4e3a-701543971eb5
msgctxt "h91651f9fgbef9g4ef7gbd30g5f5485136f58"
msgid ""
"If you think you can put your hand in mine without singeing it off, I'm "
"willing to try."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = fdd98d89-606d-852e-229d-6092723a3859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:fdd98d89-606d-852e-229d-6092723a3859
msgctxt "h6c994f82gdefbg498eg9bb8g13dc66b680ef"
msgid "<i>Take a bow.</i>"
msgstr "<i>인사한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = ffadeeb5-ba20-6a88-eb2c-5cd81b9b632b
#. HandlePath = TaggedText[0].TagText[0]
