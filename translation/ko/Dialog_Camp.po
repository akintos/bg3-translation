msgctxt "h879a37e1g0db5g4884g85cfg81adce2dec46"
msgid "I'm sorry. You're right."
msgstr "미안해요. 당신 말이 옳아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 0bb0d10e-c051-3b29-14c7-9d4dc61957d2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:0bb0d10e-c051-3b29-14c7-9d4dc61957d2
msgctxt "he0d4eb0fg1175g4143g84c1gb3063c141a86"
msgid "I'm sorry. You're right."
msgstr "미안해요. 당신 말이 옳아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = Player
#. NodeID = 0c471bdc-d4f7-e265-5d50-7b70ca143f20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:0c471bdc-d4f7-e265-5d50-7b70ca143f20
msgctxt "h46a98deeg60e3g412fg8690gd291d606bac5"
msgid "I won't let that happen."
msgstr "그런 일이 일어나게 두지 않겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = Player
#. NodeID = 134125f2-da15-2861-35ab-38b467543ee7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:134125f2-da15-2861-35ab-38b467543ee7
msgctxt "h19dba2b1g271cg4edbg84c9g8883e41206b3"
msgid "Is there anything I can do to help you?"
msgstr "내가 도울 방법은 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 137b9586-5b51-173a-139a-b0cf7ec1a532
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:137b9586-5b51-173a-139a-b0cf7ec1a532
msgctxt "hb9d3ed2fgb06cg48a7g9ad0gc6a2843245f6"
msgid "I just hope my powers last long enough to see this through."
msgstr "다만 이 일을 끝마칠 때까지 내 힘이 온전히 남아 있길 바랄 뿐이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 137b9586-5b51-173a-139a-b0cf7ec1a532
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:137b9586-5b51-173a-139a-b0cf7ec1a532
msgctxt "h07987317gdb85g4ec8g9f52g5f5267fe89ba"
msgid "I just hope my powers last long enough to see this through."
msgstr "다만 이 일을 끝마칠 때까지 내 힘이 온전히 남아 있길 바랄 뿐이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = Narrator
#. NodeID = 13f416a9-f531-5059-210f-a4eec16a87cd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:13f416a9-f531-5059-210f-a4eec16a87cd
msgctxt "h8a4847cfg160eg442dg8f26g314752e1a6a6"
msgid "*The hurt runs deeper than he's willing to show you.*"
msgstr "*감추려고 애쓰고 있지만 상처가 보기보다 깊습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = Narrator
#. NodeID = 13f416a9-f531-5059-210f-a4eec16a87cd
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:13f416a9-f531-5059-210f-a4eec16a87cd
msgctxt "hbd182676gfad0g4470gb984gec2670bc19a1"
msgid "*The hurt runs deeper than she's willing to show you.*"
msgstr "*감추려고 애쓰고 있지만 상처가 보기보다 깊습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = Narrator
#. NodeID = 13f416a9-f531-5059-210f-a4eec16a87cd
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:13f416a9-f531-5059-210f-a4eec16a87cd
msgctxt "hb9c66755g50deg4ee7g96d7gf9d2d63355bf"
msgid "*The hurt runs deeper than they're willing to show you.*"
msgstr "*감추려고 애쓰고 있지만 상처가 보기보다 깊습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 176f41a2-793b-9a86-c1ca-7aabb4f27529
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:176f41a2-793b-9a86-c1ca-7aabb4f27529
msgctxt "h04c76f2ag1579g4dc1g8cf1g4f0530c08063"
msgid "You did a brave thing, saving those people in the grove."
msgstr "에메랄드 숲의 사람들을 구해 내다니, 용기 있는 일을 하셨어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 176f41a2-793b-9a86-c1ca-7aabb4f27529
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:176f41a2-793b-9a86-c1ca-7aabb4f27529
msgctxt "h0cdccdeagd581g410bgaad8gb59530e3bd04"
msgid "You did a brave thing, saving those people in the grove."
msgstr "에메랄드 숲의 사람들을 구해 내다니, 용기 있는 일을 하셨어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 177b3b77-6eb6-3f9e-e972-d98da3a5d060
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:177b3b77-6eb6-3f9e-e972-d98da3a5d060
msgctxt "h91a57c84g2156g4529g824bg8d1cd3ccae34"
msgid "Mind? I'm grateful."
msgstr "기분 나쁘다뇨? 감사한걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 177b3b77-6eb6-3f9e-e972-d98da3a5d060
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:177b3b77-6eb6-3f9e-e972-d98da3a5d060
msgctxt "h9fdb2a22g149cg4ae0ga6d5g55f65760e56c"
msgid "Mind? I'm grateful."
msgstr "기분 나쁘다뇨? 감사한걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = Player
#. NodeID = 1e663f92-6a31-f980-d390-638d2e9ad5e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:1e663f92-6a31-f980-d390-638d2e9ad5e5
msgctxt "hb7637adage88dg4df1g9628g869913089142"
msgid "I did what I had to to ensure our survival."
msgstr "살아남기 위해 해야 할 일을 했을 뿐이에요."

