msgctxt "h49d22204g8ee2g47a4g8afag9043fb27cfb8"
msgid "Stay. Tell me how you to earn your mind and body."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
#. NodeID = b9a88db4-639b-4bca-90f7-c70a91664131
#. HandlePath = TaggedText[0].TagText[0]
