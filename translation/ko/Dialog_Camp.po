#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:06ad88cb-a9f3-ecc0-812d-cfe0a92ba33d
msgctxt "hb0e695eega3b6g4e2bg991cga7077113f817"
msgid "I feel like I can breathe for the first time in months."
msgstr "몇 달 만에야 처음으로 숨이 탁 트이는 느낌이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Guex
#. NodeID = 097895de-865e-ef3b-1370-5a338a9c0c3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:097895de-865e-ef3b-1370-5a338a9c0c3e
msgctxt "hed010d8egb699g40c3ga62cg98993322ea49"
msgid "Ah, but I <i>know</i>."
msgstr "아, 그래도 다 <i>안다고</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Guex
#. NodeID = 27916b7e-ba73-3256-0613-1f629194aa69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:27916b7e-ba73-3256-0613-1f629194aa69
msgctxt "h0b07898agead6g4721g81begf184d68870bf"
msgid "One sight of the city, and you'll forget all about it."
msgstr "도시를 눈앞에 두고 나면 그 생각 쏙 사라지게 될걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Kivak
#. NodeID = 593db259-cbec-1063-ab90-4fa8344ba3eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:593db259-cbec-1063-ab90-4fa8344ba3eb
msgctxt "h40b70d51g51c0g4173g8acbg67d30085370f"
msgid "But the others..."
msgstr "하지만 다른 이들은..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Guex
#. NodeID = 712f5459-2b5a-b790-e197-7b3782f896f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_A = False
#.      - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_B = False
#. SetFlags:
#.   Local:
#.     - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:712f5459-2b5a-b790-e197-7b3782f896f8
msgctxt "h107653eag3232g4482g8d92g4cf4ab8c9ae6"
msgid "We're alive, Kivak. Alive!"
msgstr "우린 살아남았어, 키바크. 살았다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Kivak
#. NodeID = 78a2ccf3-66bf-bcad-1a0e-341d85548003
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_A = True
#.      - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_B = False
#. SetFlags:
#.   Local:
#.     - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:78a2ccf3-66bf-bcad-1a0e-341d85548003
msgctxt "h43b1db8bg3f6fg4cbega678g85a5d9eae7b5"
msgid "I can't lie - I'm going to miss this place a bit."
msgstr "까놓고 말해, 이곳도 나중엔 좀 그리워질 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Guex
#. NodeID = 87e1ecb7-d95f-81fb-09fb-741c8c9a6b4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:87e1ecb7-d95f-81fb-09fb-741c8c9a6b4a
msgctxt "he4b329dag6b63g4b08g86bcg9d7dd5093346"
msgid "Tonight we drink to them!"
msgstr "걔들을 위해 건배하잔 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Kivak
#. NodeID = b86e207d-cc4f-6ae2-853b-ecc5def26285
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:b86e207d-cc4f-6ae2-853b-ecc5def26285
msgctxt "h42bd58f2g98f5g4233g9ce0ge8737df2e823"
msgid "I thought you'd never been."
msgstr "너 거기 가 본 적도 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Guex
#. NodeID = fb4e5d04-12d4-281c-4ef6-2d6fdcb32995
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06:fb4e5d04-12d4-281c-4ef6-2d6fdcb32995
msgctxt "h4deb5dabg1de0g4d35g8f98g88f56eb28a92"
msgid "Less air, more ale!"
msgstr "숨 말고 에일이나 들이켜!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = 0683cc64-023c-d84c-f37b-e952adacb932
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SonOfChefGotDrink = True
#. SetFlags:
#.   Local:
#.     - 4fa781b1-5bf3-5873-4331-f56c0efa6476_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:0683cc64-023c-d84c-f37b-e952adacb932
msgctxt "h9deee81dg6f60g4bdcg9f74g31f0ac960209"
msgid "You'll have a drink, but not with me? <i>Betrayal.</i>"
msgstr "넌 한 잔 걸칠 거면서, 난 빼놓으려고? <i>그건 배신이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = 0c6e2a65-6f61-bbf9-f6c1-4708871c2e44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:0c6e2a65-6f61-bbf9-f6c1-4708871c2e44
msgctxt "h7b4f9329gf575g4497g8b4dg9a7ca76bfcd1"
msgid "Maybe you should drink some water."
msgstr "정신 차리게 물 좀 마시지 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = 243a90ba-4be0-51ba-a987-46267cc36357
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:243a90ba-4be0-51ba-a987-46267cc36357
msgctxt "h51e95557gb600g4247g936ege7af27bb5eff"
msgid "I'm fine. One more, that's all."
msgstr "난 괜찮아. 딱 한 잔만. 그거만 마실게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = 309228a1-5f33-d58f-fc51-fc8b9fd97798
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:309228a1-5f33-d58f-fc51-fc8b9fd97798
msgctxt "h2e8ec506g315fg4903gbd2fg8233804c1ce0"
msgid "Well go bother someone else then."
msgstr "그럼 딴 사람 찾아가 즐기라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = 35958401-2e8e-0266-f3d4-6cc081666c65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SonOfChefGotDrink = True
#.   Local:
#.      - 4fa781b1-5bf3-5873-4331-f56c0efa6476_A = True
#. SetFlags:
#.   Local:
#.     - 4fa781b1-5bf3-5873-4331-f56c0efa6476_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:35958401-2e8e-0266-f3d4-6cc081666c65
msgctxt "h47458160g51e3g4c38gbbbagd929466e5862"
msgid "You're looking flushed!"
msgstr "너 얼굴이 더 벌개졓는걸!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = 3e5ded7c-06e5-0a17-df0e-07f646c6ccb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:3e5ded7c-06e5-0a17-df0e-07f646c6ccb1
msgctxt "h1dda7d0bgdc29g4403gb376g4e401b000509"
msgid "Ah, loosen up, Ikaron!"
msgstr "아, 빼지 좀 마, 이카론!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = 5bab12fa-15ba-374d-81dd-d6b0965c681f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:5bab12fa-15ba-374d-81dd-d6b0965c681f
msgctxt "h188eb6abgc891g43e3gbfb5g4ed4a9c2805d"
msgid "It's not like that."
msgstr "그런 거 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = 6591cee9-810e-7fd3-7405-244146164f66
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4fa781b1-5bf3-5873-4331-f56c0efa6476_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:6591cee9-810e-7fd3-7405-244146164f66
msgctxt "h19636a72ge450g405egac84gc662700d0e2c"
msgid "Grab a drink!"
msgstr "한잔 걸치자고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = 6cae1e7a-fecc-d5d4-d452-106ef4d26c13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:6cae1e7a-fecc-d5d4-d452-106ef4d26c13
msgctxt "h829068b5gcf8fg4793gab78gd8e19cd9c201"
msgid "I'm fine."
msgstr "난 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = 7446eebb-7237-1b77-be0e-ec66b995e556
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SonOfChefGotDrink = True
#.   Local:
#.      - 4fa781b1-5bf3-5873-4331-f56c0efa6476_B = True
#. SetFlags:
#.   Local:
#.     - 4fa781b1-5bf3-5873-4331-f56c0efa6476_C = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:7446eebb-7237-1b77-be0e-ec66b995e556
msgctxt "hdafdaeadg110eg49a5g93a0g9bbb35bc436f"
msgid "Are you weaving, or is it me?"
msgstr "지금 휘청대는 거 너냐, 아님 나냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = 76985ab7-00a2-0583-c837-7ef19f11ab49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:76985ab7-00a2-0583-c837-7ef19f11ab49
msgctxt "h05ce4520gc602g484cgb079g81d147d0475a"
msgid "Bah! Nothing another ale won't fix!"
msgstr "하! 그럴 땐 에일주 한 잔 더하면 나아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = 83c9ed68-ecf0-3985-a9e3-9053db36fc87
#. HandlePath = TaggedText[0].TagText[0]
