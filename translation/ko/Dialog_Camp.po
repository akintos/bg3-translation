msgctxt "h43f19142g0ae9g448bgae83gc0a808d13eee"
msgid "Back! Hurt me!"
msgstr "물러서! 너 아파!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Owlbear Cub
#. NodeID = e9f755aa-dece-a578-ba3d-36648b055f08
