#.      - GLO_SafeRomance_Enabled(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date:af6d292a-ac27-615b-5cec-0c71fabe894c
msgctxt "h7ea8a4e5g52a2g4d34gac56gee19f37ae2eb"
msgid "Hope you like it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
#. Speaker = Karlach
#. NodeID = b307044b-bb1b-e143-546c-da5836194483
#. HandlePath = TaggedText[0].TagText[0]
