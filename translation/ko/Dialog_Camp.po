#. CheckFlags:
#.   Object:
#.      - ORI_State_DoubleDating(1) = True
#.      - ORI_State_DatingAstarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:e35ea515-6b49-4ec9-ab1b-59f8890b201d
msgctxt "h255e18eeg93c2g41abg9866g4810dad96300"
msgid "We could have fun? We could spend some 'quality time' together."
msgstr "함께 즐거움을 나누는 건 어때? '즐거운 시간'을 함께 보낼 수도 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = e473005d-f9fd-883e-b4af-9ad8248a74ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_AstarionRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:e473005d-f9fd-883e-b4af-9ad8248a74ee
msgctxt "h0d2df72fg18aag4348gb412g47cf679f664f"
msgid "I have standards."
msgstr "난 기준이 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = e491db80-d008-ae9c-86df-8c14c48414fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_AstarionRefused(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:e491db80-d008-ae9c-86df-8c14c48414fd
msgctxt "h8c9366fbg3014g44d5ga994g107897c6edb4"
msgid "Fine. Enjoy your night with whatever beast will have you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = e6606f18-ea94-1611-7003-d06157a2044e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:e6606f18-ea94-1611-7003-d06157a2044e
msgctxt "h1378cac0g7a0ag4a03gb426g56c034fb2c56"
msgid "That means I have to survive tonight. And this party."
msgstr "그러려면 오늘 밤을 살아남아야겠지. 이 파티도 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = e665adfc-69e7-7fb6-1546-1cb55635cb7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion:e665adfc-69e7-7fb6-1546-1cb55635cb7e
msgctxt "h0f030b6fg7affg4647gaadegb12ce3f3e609"
msgid "And here I mistook you for someone with taste. A pity."
msgstr ""

