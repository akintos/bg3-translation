#.   Local:
#.     - 966616f6-f9a1-58cc-6369-867f4c00cd23_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:85f89b12-f58a-e70d-3306-c032ba446fa6
msgctxt "ha53686e8g1cc0g4162gad4cged6256c02813"
msgid "You're handsome."
msgstr "자기 잘생겼다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = 9273efe7-7478-5126-f1f1-31aefea6a69f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:9273efe7-7478-5126-f1f1-31aefea6a69f
msgctxt "h387d6adag77e8g4049gaf58gfd0f26d8b249"
msgid "Are you planning to share the last of that wine?"
msgstr "그럼 마지막 남은 그 포도주 좀 나눠 줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = a849abd1-972f-2f6e-d87e-606b2f39d5da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:a849abd1-972f-2f6e-d87e-606b2f39d5da
msgctxt "h37f04601g447ag49a7gb975gbbda59d626f7"
msgid "I love you."
msgstr "사랑해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = bf48aff1-c041-4343-d529-9053e5a28d98
