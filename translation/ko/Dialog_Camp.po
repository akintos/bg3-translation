msgctxt "h958b799eg04afg4d08gb72bg9e4ea7a841ef"
msgid "<i>Bite down, careful not to disturb them.</i>"
msgstr "<i>휴식에 방해되지 않게 주의하며, 깨문다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 9dada34c-c777-acda-65d9-4a0ae1085139
#. HandlePath = TaggedText[0].TagText[0]
