msgctxt "hf4ce71a8g69bdg4e2agbe94ga02b49422dc6"
msgid "Interested in sharing a bed tonight?"
msgstr "나랑 하룻밤 같이 보낼 생각 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 61714039-4437-4d7b-25f7-fc01a9cb5a1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:61714039-4437-4d7b-25f7-fc01a9cb5a1e
msgctxt "h5d6b133fg219ag4617g99bfg775cc75af5bd"
msgid "Watch maybe, but not intrude."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 642e1395-1557-f50d-2421-6445e63a0cfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:642e1395-1557-f50d-2421-6445e63a0cfb
msgctxt "head5d4b0g105ag492cga683gb3e5f4145b2e"
msgid "You insolent little-"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 64ca604e-0d45-8969-caf9-d5d6e00d48f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
