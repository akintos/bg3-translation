msgctxt "ha5ce2c53g1ae6g4bf8g8515g6d29f55db1f9"
msgid ""
"This is the price of balance. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630"
"-9f0a-be548b134c54])"
msgstr ""
"이것이 균형의 대가이니라. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 290f458b-8cf7-7875-5ff5-8f1afd622100
