msgctxt "h963c7528g2226g4bd7g95efgfef373ffdbae"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 1563dd9b-1dee-5d13-fd40-30fbbed56d1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1563dd9b-1dee-5d13-fd40-30fbbed56d1f
msgctxt "h38aa0de6gb89eg4a56g8b6ag4dd27f50d498"
msgid "Actually, I've changed my mind."
msgstr "사실, 마음이 좀 바뀌었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 185cab31-2011-a8a4-0d65-a35e88948c36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:185cab31-2011-a8a4-0d65-a35e88948c36
msgctxt "hd602b278gfb29g4a60ga4a3g397d0be9cfd7"
msgid "She has left this place to hew a new path."
msgstr "그녀는 새로운 길을 개척하기 위해 이곳을 떠났다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 188b2bb0-7f15-56fe-6d1c-3119d0df0e3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:188b2bb0-7f15-56fe-6d1c-3119d0df0e3a
msgctxt "h4ce20264g89bdg4688g95cbg316f86a25cfb"
msgid "Actually, there's something else I need from you."
msgstr "사실, 다른 게 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 1a0db753-f2ca-ef8a-ac98-d356b8e642fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1a0db753-f2ca-ef8a-ac98-d356b8e642fb
msgctxt "h8efb1407gb590g48a0gb7a3g82a6f6aab1aa"
msgid "Changed my mind. They can stay dead for now."
msgstr "생각이 바뀌었어요. 지금은 죽어 있으라고 하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 1b15ea1b-36ac-31da-d24b-2eafc9c03142
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_State_CanResurrectLaezel = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1b15ea1b-36ac-31da-d24b-2eafc9c03142
msgctxt "hf4f4a426g2740g4435gbb4eg830d81a058c5"
msgid "I'd like you to return Lae'zel."
msgstr "레이젤을 되살려주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 1b5838c7-c9e9-3822-157f-c8a5a124d333
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Jergal_DiscussedRelationship(1) = False
#.   Global:
#.      - HAV_PartyProgress_EnteredHaven = True
#.   Object:
#.      - ORI_State_Dating(1) = True
#.      - CAMP_Jergal_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Jergal_DiscussedRelationship(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1b5838c7-c9e9-3822-157f-c8a5a124d333
msgctxt "he5fee72eg0452g402bg8e9eg8320e2fd2274"
msgid ""
"Thou hast now a bosom-companion. Take care that thou art not distracted on "
"thy quest, seeking the comforts of the flesh."
msgstr "그대는 이제 소중한 동반자가 생겼구나. 육체적인 쾌락에 휘둘려 그대의 임무를 소흘히 하지 않도록 조심하거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 1c0bfbf1-5074-d34a-1315-24c6f7010d9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1c0bfbf1-5074-d34a-1315-24c6f7010d9d
msgctxt "h9bbe393fge454g44b0g930bgdf753f97699c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 1e785583-357e-054e-5341-be3afc6864b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1e785583-357e-054e-5341-be3afc6864b7
msgctxt "h6f196d5cg8603g41f0gada8g0f26380d6bc7"
msgid "No."
msgstr "없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 1f021cf1-1cf3-a86e-4c1c-5c4e6ae52535
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - Hirelings_Event_RefreshHirelings(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1f021cf1-1cf3-a86e-4c1c-5c4e6ae52535
msgctxt "h45d30852gd704g4cb8g9c3cg861bd9291bf6"
msgid "<i>Dismiss a hireling.</i>"
msgstr "<i>용병을 떠나보낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 1f0ba037-141e-429c-12d1-c2a83aa40736
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1f0ba037-141e-429c-12d1-c2a83aa40736
msgctxt "h260186deg8e4cg4afcgb8d7g9f1cf7b9358f"
msgid "I riddle thee not. I speak only what requires telling."
msgstr "난 수수께끼 따위 안 낸다. 오로지 필요한 말을 할 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 1f891715-a0ed-5397-562b-7a5b8d161a6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1f891715-a0ed-5397-562b-7a5b8d161a6e
msgctxt "h0c7426abgfcc9g48e4g94c9gee7004e7a465"
msgid "I really don't want to talk to you about this."
msgstr "그 이야기는 별로 하고 싶지 않습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 1fc51a2e-7204-ed17-1577-e482b3c939d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - OATHBREAKER(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:1fc51a2e-7204-ed17-1577-e482b3c939d6
msgctxt "hb5dfe922gc6b7g4afbg9c69gac0a299f56fa"
msgid "Thou hast broken thy oath. Before I can aid thee, thou must atone."
msgstr "그대는 그대의 맹세를 어겼지. 내 도움을 받기 전에, 그 과오부터 청산해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 209d776b-3191-c3bb-8435-3ba6493dc765
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:209d776b-3191-c3bb-8435-3ba6493dc765
msgctxt "ha7cb7ccdg5663g4e46gb1bcg36d8e6813b7c"
msgid "Very well."
msgstr "알았다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 212ef953-12a3-68f3-f69f-cd6e2b1e3177
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_SparedIsobelWithWyll = True
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = True
#.      - ORI_DarkUrge_Event_AskedJergalAboutCompanionResurrection = False
#.      - NIGHT_DarkUrge_SparedIsobel = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:212ef953-12a3-68f3-f69f-cd6e2b1e3177
msgctxt "h21813c81g3e58g40bbg8c9fg9ef1fd089b12"
msgid "Please bring back Wyll. I can't live with what I did."
msgstr "제발 윌을 되살려 주세요. 이렇게 살 순 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 2372d453-ff60-481c-017f-88274d706e85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = True
#.      - ORI_DarkUrge_Event_AskedJergalAboutCompanionResurrection = False
#.      - NIGHT_DarkUrge_SparedIsobel = True
#.      - ORI_DarkUrge_State_SparedIsobelWithLaezel = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2372d453-ff60-481c-017f-88274d706e85
msgctxt "h0883002cg06d7g425fg8558g04172a339e59"
msgid "Please bring back Lae'zel. I can't live with what I did."
msgstr "제발 레이젤을 되살려 주세요. 이렇게 살 순 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 2413c509-c178-d944-62ab-a71ca849c8b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_BhaalResisted = True
#.   Object:
#.      - CAMP_Jergal_HasMet(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2413c509-c178-d944-62ab-a71ca849c8b4
msgctxt "h193634f1gfa94g4a71g9a42gaf1414e45cf6"
msgid "Walk in grace, soul of light."
msgstr "영광 속에서 걷도록, 빛의 영혼이여."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 24483fa4-d00d-be91-2fbf-c3192102080a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CHA_Jergal_HasMet(1) = True
#.      - CAMP_Jergal_HasMet(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Jergal_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:24483fa4-d00d-be91-2fbf-c3192102080a
msgctxt "h8da8bd60g1043g4339gb25eg9655a5b31cb0"
msgid "We meet again, as predicted."
msgstr "다시 만났구나. 예견대로 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 2481313b-9c15-8381-5858-45ec404a30db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Hirelings_State_FeatureAvailable = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2481313b-9c15-8381-5858-45ec404a30db
msgctxt "he2693f69gca34g4a1fga9c0g55f245f43698"
msgid "Dost thou require a new ally? Or mayhaps a resurrection, instead?"
msgstr "그대는 새 아군이 필요한가? 어쩌면 부활이 필요한 것이려나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 251d3fa3-a4ae-9e3e-30aa-9febaf5888f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_Event_ResurrectedSomeoneOnce = False
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - CAMP_Jergal_Event_ResurrectedSomeoneOnce = True
#.     - CAMP_Jergal_State_WillResurrectMinsc = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:251d3fa3-a4ae-9e3e-30aa-9febaf5888f2
msgctxt "heb578b8fg47a6g448ega415g90040e2179d2"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 260dd84a-77de-3051-4921-933429740f8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Hirelings_State_FeatureAvailable = False
#.      - CAMP_Jergal_State_PartyMemberDead = True
#.   Object:
#.      - GLO_Jergal_State_ElminsterDebtSettled(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:260dd84a-77de-3051-4921-933429740f8c
msgctxt "h81f846caga49eg437fg87f5g89c48e4c3055"
msgid "Dost thou require a resurrection?"
msgstr "그대는 부활을 필요로 하는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 2776db60-21fa-5172-9fcf-b83d0e24d491
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2776db60-21fa-5172-9fcf-b83d0e24d491
msgctxt "hff1941c5gfe50g42a2g8a8egdee326015b63"
msgid "I have better things to be doing."
msgstr "더 급한 일이 있어서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 27f51664-c92d-548d-4db5-d5ca7f2cea3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Hirelings_State_Hired_1 = False
#.      - Hirelings_State_Hired_3 = False
#.      - Hirelings_State_Hired_2 = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:27f51664-c92d-548d-4db5-d5ca7f2cea3d
msgctxt "h5ed388efgdc9bg4f6eg8b3ag00a5863662b7"
msgid "There is no one to dismiss."
msgstr "더 이상 내보낼 자가 없구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 283fea19-9acc-8a1c-6b20-dc2bb8b3cb59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:283fea19-9acc-8a1c-6b20-dc2bb8b3cb59
msgctxt "h785c3412g0218g4a6cg957bg2e8aef659cb7"
msgid ""
"Without the balance of a soul, a force to drive them, vessels like thine sit "
"limp like garments unworn."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
