#.     - FOR_Courier_Knows_DogName = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:590b01c2-e7ff-f4f0-206a-2b3b3a3c04ac
msgctxt "hd9c2ad3bg4c76g49fcgadacg220e826453e2"
msgid "I didn't introduce myself before. You can call me Scratch."
msgstr "내 소개를 하지 않았네. 스크래치라고 불러."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
