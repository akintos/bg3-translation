msgctxt "h582a74ecg7c6fg428ag91e1ge3acee4aa72a"
msgid "UGH."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02
#. Speaker = Chell
#. NodeID = 774960f2-cbac-9959-1aca-ba529643952a
