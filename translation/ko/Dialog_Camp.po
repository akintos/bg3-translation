msgctxt "h4802ba55g997ag457bgbbdege19b71dd5f86"
msgid "How about this one:"
msgstr "이건 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight
#. Speaker = Player
#. NodeID = 492bfa52-57c6-419a-9fe9-5123cdc2552b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight:492bfa52-57c6-419a-9fe9-5123cdc2552b
msgctxt "h4b4aecb9gfcabg4292g88a5g6b0d267388ea"
msgid "Very presumptuous. I'm undecided what I'll do tonight yet."
msgstr "아주 건방지네. 오늘 밤에 뭘 할지 아직 결정하지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight
#. Speaker = Astarion
#. NodeID = 49fe03c0-ef9b-4dda-8bd4-3a11498f5a9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight:49fe03c0-ef9b-4dda-8bd4-3a11498f5a9d
msgctxt "h2303d482gf5f9g4d83g92e2g68c81d4323d4"
msgid "Ah, you need a bit of enticing, let me see."
msgstr "아, 좀 더 유혹이 필요한 거군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight
#. Speaker = Player
#. NodeID = 4f6f3011-a4bf-42b2-a2a1-647a7b2044c3
#. HandlePath = TaggedText[0].TagText[0]
