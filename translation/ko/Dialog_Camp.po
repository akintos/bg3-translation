msgctxt "h4de8bd8bg4756g47dcg9dccg13df56dd61f9"
msgid "Tonight, you are the monster everyone claims you are."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = c4a009cf-13a3-152a-8c22-76644c9af7fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:c4a009cf-13a3-152a-8c22-76644c9af7fe
msgctxt "ha448d93eg1c1bg4f1fgb468ga37f50762357"
msgid "But your Father loves you dearly. You may reinherit yourself yet."
msgstr "하지만 아버지께서는 주인님을 몹시도 사랑하신답니다. 아직 물려받을 기회가 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = de3d0ddb-e163-dad0-0afd-8ef662c536d6
#. HandlePath = TaggedText[0].TagText[0]
