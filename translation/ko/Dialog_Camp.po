msgctxt "hef6de992g239dg4a59g9caag4e53f628e259"
msgid "Come here. I'll clean it for you."
msgstr "이리 와. 소독해 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Owlbear Cub
#. NodeID = c551bec0-4d25-df2a-abea-0dbe33ac2db8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
