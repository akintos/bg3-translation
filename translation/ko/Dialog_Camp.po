msgctxt "hc204a813g7f04g4d20gb014gb7956fdbdd49"
msgid "*Hoo-hoot!*"
msgstr "*후-훗!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub
#. Speaker = Owlbear Cub
#. NodeID = be19eae7-5390-593b-6f7c-1b5a9a1faa45
