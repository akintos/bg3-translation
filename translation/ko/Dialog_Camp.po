msgctxt "h4679084ag2fcdg4e64gacedga6775cce3bae"
msgid "Wonder if they meant Dammon - a tiefling weaponsmith."
msgstr "티플링 무기장이, 대먼 말하는 걸지도 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_PaladinsOfTyrAndEngine
