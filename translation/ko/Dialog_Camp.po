#. NodeID = e80ffc01-f3b8-d0b5-4356-35c5db09b2b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_OwlbearCub_State_Friend = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2:e80ffc01-f3b8-d0b5-4356-35c5db09b2b8
msgctxt "hc114074agd4b5g4776g86d4ge6ba11e016d9"
msgid "Run. Hide!"
msgstr "도망쳐. 숨어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Player
#. NodeID = e873fa12-7904-1d28-cb75-b6c9f4cb4308
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
