msgctxt "hd59da339g91b2g4101gab09g1109c415f486"
msgid "<i>Look him over for any signs of injury from the owlbear cub.</i>"
msgstr "<i>아울베어 새끼에게 입은 상처는 없는지 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = b3f40bba-a63c-c8c4-9fdd-6b24c4e93545
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:b3f40bba-a63c-c8c4-9fdd-6b24c4e93545
msgctxt "ha9c11ba8g13e4g4681g9800gdc9de14ee0b6"
msgid "I'm glad you're back where you belong."
msgstr "네가 제자리로 돌아와서 기뻐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
