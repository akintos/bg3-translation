#.     - CAMP_Astarion_TheHungerA_Recognized(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:6bcef7b1-cc9a-073d-66ac-e1af817f72f9
msgctxt "h80b7758agc5c7g4af7ga472ge58d93957ea3"
msgid "*You stare, frozen, until he finally locks eyes with you.*"
msgstr "*당신은 얼어붙은 채 빤히 쳐다봅니다. 그가 마침내 당신을 똑바로 바라볼 때까지.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Astarion
#. NodeID = 7020c4c0-01f1-db7b-c91f-588a0fabf2c3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:7020c4c0-01f1-db7b-c91f-588a0fabf2c3
msgctxt "he722548cg520bg4540g9e7eg0cb4e06da6ae"
msgid "It's just a test - I wasn't trying to kill you!"
msgstr "이건 일종의 시험이었어. 죽이려는 마음은 없었다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 714f6221-3893-f7c9-0dff-ad373c8a88ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:714f6221-3893-f7c9-0dff-ad373c8a88ee
msgctxt "hbbabfc5dg27e9g4676gba79ga7a045b9b4da"
msgid "*You drift into the forest, hunting for anything with a pulse.*"
msgstr "*당신을 숲을 떠돌아다니며, 맥박만 뛴다면 무엇이든 사냥합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 752e1c76-fa65-ffe6-1478-7da81657f003
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(3) = True
#. TagRule: REALLY_KARLACH
