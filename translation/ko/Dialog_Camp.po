msgid "Don't you think we owe the dead a pint or two?"
msgstr "죽은 이들한테 한두 잔 올려야겠단 생각 들진 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = c8440c2e-c64b-b5e6-cba1-371201c43eba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:c8440c2e-c64b-b5e6-cba1-371201c43eba
msgctxt "h38a63cf3g5792g4c40gb989g18708ecb4651"
msgid "I <i>am</i> relaxed."
msgstr "나 <i>지금</i> 느긋하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = e485d714-d88e-dbca-25bf-bc44955c0ea9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:e485d714-d88e-dbca-25bf-bc44955c0ea9
