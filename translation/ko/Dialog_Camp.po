msgctxt "h67a08702g51b4g48eagabb2gb59d281a8cbf"
msgid "<i>Approach [GEN_PlayerName2_85df4a15-4d9b-4f68-0512-d104305d8dac].</i>"
msgstr "<i>[GEN_PlayerName2_85df4a15-4d9b-4f68-0512-d104305d8dac]에게 다가간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 3cfc45f9-fc4a-971b-7a6c-72065450a66f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:3cfc45f9-fc4a-971b-7a6c-72065450a66f
msgctxt "hc88c4f13g4fc7g4da3g96ecg0c8c914f0d26"
msgid ""
"*Blood gushes into your mouth. You can feel it filling the maw inside you - "
"filling your soul.*"
msgstr "*피가 입 안 가득 흘러듭니다. 당신 안의 굶주린 아귀가 만족스럽게 채워지는 듯합니다. 영혼이 충만해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 3ee8d208-176f-ad3c-60ee-ce5ecf2f791c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerA_HalfDrain = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:3ee8d208-176f-ad3c-60ee-ce5ecf2f791c
msgctxt "h00276431g348ag476eg841dg1d322074686d"
msgid ""
"*You creep back to your bed with a full belly and singing heart. For the "
"first time in centuries, you feel happy.*"
msgstr "*당신은 만복감을 안고 흥얼거리는 마음으로 잠자리에 기어듭니다. 수백 년 만에 처음으로, 행복한 기분이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 3f0c6e3d-3dc9-4811-48ed-d5ebd015f402
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Astarion_TheHungerA_BiteSpeaker(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Astarion_TheHungerA_Recognized(2) = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:3f0c6e3d-3dc9-4811-48ed-d5ebd015f402
msgctxt "h3614f64ega6b7g4c8dgb013g12c165c831b8"
msgid ""
"Let my blood be a warning to you: there's more to me than meets the eye. I "
"am <i>not</i> for eating."
msgstr "내 피에서 교훈을 좀 얻었길 바라지. 이래 봬도 많은 비밀을 간직하고 있거든. 먹어선 <i>안 되는</i> 몸이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Player
#. NodeID = 3f6573d1-334d-8b61-64ef-35e2c057cc34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerA_HuntAnimal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:3f6573d1-334d-8b61-64ef-35e2c057cc34
msgctxt "h20d12b62g55a4g4822g99a1ge71baac93f34"
msgid "<i>No, not them. Leave and find an animal to feed on.</i>"
msgstr "<i>아니, 이들은 안 된다. 야영지를 떠나 먹이로 삼을 동물을 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 3fb854ab-3536-f37b-47d9-d9f75f168800
