#.      - CAMP_OwlbearCub_HasMet_GoblinHuntCelebration(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub:d76d923e-e35c-3898-a432-c3368f9d4f56
msgctxt "h799db223g1605g4e6fg833ag2c9beb8a5be0"
msgid "Bite them. <i>Kill </i>them?"
msgstr "물어. <i>죽여</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA
#. Speaker = Locke
#. NodeID = 03f78572-5350-2f10-b473-72c8c5d01a0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_ParentA(1) = True
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA:03f78572-5350-2f10-b473-72c8c5d01a0a
msgctxt "hc38f05ebg6883g4373g86c4gd8556b6d5e54"
msgid ""
"While I'm sorry you got dragged into things with Kagha, now is not the time. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_ParentA
#. Speaker = Locke
#. NodeID = 1fdd013c-f461-1100-6d5c-30eb5d239c5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#. SetFlags:
