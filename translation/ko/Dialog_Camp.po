msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup003
#. Speaker = Kavil
#. NodeID = 9a71ca43-a1f0-bfbb-e109-b662a7e1d639
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup003(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup003:9a71ca43-a1f0-bfbb-e109-b662a7e1d639
msgctxt "hd41e680cg7365g466ag8abfgc36aecce1400"
msgid "Grab a drink! I'm fairly certain it's all yours anyway."
msgstr "한잔 해! 차피 네 꺼 같으니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup004
#. Speaker = Vatas
#. NodeID = 112dd746-f0e5-3ae6-bf4d-9e6b858fe6f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup004(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup004:112dd746-f0e5-3ae6-bf4d-9e6b858fe6f2
msgctxt "ha5e07050g7f21g4206g9686gbdacaa3c6681"
msgid "Cheers."
msgstr "건배."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup004
#. Speaker = Vatas
#. NodeID = 610e1ad9-c6fd-5bd1-62d4-12226f0ad093
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup004(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup004:610e1ad9-c6fd-5bd1-62d4-12226f0ad093
msgctxt "hb308eec4g237fg424cgbd29gb24472d8ab96"
msgid ""
"Kind of you to open your camp to us. We'll have to return the favour in "
"Baldur's Gate."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005
#. Speaker = Rhy
#. NodeID = 23230e7d-2582-5d1d-8898-01b63bc92076
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup005(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005:23230e7d-2582-5d1d-8898-01b63bc92076
msgctxt "hd05b06dcga954g43cbg9030gdda2e08b0ff7"
msgid "Let's raise our glasses to the future - Baldur's Gate!"
msgstr "미래를 위해 잔을 듭시다 - 발더스 게이트로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005
#. Speaker = Rhy
#. NodeID = 91280095-23a5-e8bc-d159-14ebd5025199
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005:91280095-23a5-e8bc-d159-14ebd5025199
msgctxt "hb1c0c8a0ge0f0g4e79ga466gf17a67e538bc"
msgid "Damn the druids, and to the hells with goblins!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005
#. Speaker = Rhy
#. NodeID = a97e40e0-7475-eca6-bc42-7164a684d122
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005:a97e40e0-7475-eca6-bc42-7164a684d122
msgctxt "hb71f9be7g2d2cg4094g8ca8gdc4ba86a669f"
msgid "Forget Elturel, and to the hells with goblins!"
msgstr "엘투렐은 잊고, 고블린들은 지옥에나 가라고 합시다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005
#. Speaker = Rhy
#. NodeID = ceb4a554-40dd-68ad-14bc-2c16e8db1b25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup005(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup005:ceb4a554-40dd-68ad-14bc-2c16e8db1b25
msgctxt "h6d799fd5g33f7g46f9gbea8g5474ccd2ca00"
msgid "We can worry about the road tomorrow. Tonight, we drink!"
msgstr "걱정은 내일 합시다. 오늘 밤은 술이나 마시자구요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006
#. Speaker = Kivak
#. NodeID = 41688fac-99b8-5a1a-fbe5-37206a38476b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup006(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006:41688fac-99b8-5a1a-fbe5-37206a38476b
msgctxt "hd912edf2g22abg4512g9f8ag3da54297d8d8"
msgid "Your courage is an inspiration to us all!"
msgstr "네 용기가 우리 모두에게 영감이 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006
#. Speaker = Kivak
#. NodeID = 4fc6b4cc-9faa-bc7e-a80d-7152d46904fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup006(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup006(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006:4fc6b4cc-9faa-bc7e-a80d-7152d46904fb
msgctxt "hf44d5e7cga46dg4002g890bg379c0a10f423"
msgid "You - you're the one who saved us. It's an honour, madam!"
msgstr "당신 - 당신이 저희를 구해주신 분이군요. 정말 영광입니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006
#. Speaker = Kivak
#. NodeID = 4fc6b4cc-9faa-bc7e-a80d-7152d46904fb
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup006(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup006(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006:4fc6b4cc-9faa-bc7e-a80d-7152d46904fb
msgctxt "h0b9e6cc6g2785g41eegb37agf6901eb9f945"
msgid "You - you're the one who saved us. It's an honour, sir!"
msgstr "당신 - 당신이 저희를 구해주신 분이군요. 정말 영광입니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006
#. Speaker = Kivak
#. NodeID = 4fc6b4cc-9faa-bc7e-a80d-7152d46904fb
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup006(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_TieflingBackup006(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingBackup006:4fc6b4cc-9faa-bc7e-a80d-7152d46904fb
msgctxt "h7abc3e9fg0828g4040gbb09g388bcbfc497d"
msgid "You - you're the one who saved us. It's an honour!"
msgstr "당신 - 당신이 저희를 구해주신 분이군요. 정말 영광입니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 64b0cdf7-bc35-d695-0ff6-6e9b924fdf63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingLeader:64b0cdf7-bc35-d695-0ff6-6e9b924fdf63
msgctxt "h5a83d023g48fag4e96g9227g2ab8e40cf4a5"
msgid ""
"The <i>singing</i> we could probably do without, but even so. Thank you."
msgstr "<i>노래는</i> 좀 빼도 괜찮겠지만, 그래도 좋아. 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b1410746-e8bc-8d1d-f3f0-e8914cfaead0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingLeader:b1410746-e8bc-8d1d-f3f0-e8914cfaead0
msgctxt "hdeec17b6gdfd3g44e1g8c76g72f4c6893aa1"
msgid ""
"Go on, do your rounds. But if they hand you something purple, <i>don't</i> "
"drink it - I think they got into Ethel's potions."
msgstr "가 보게, 실컷 즐기게나. 하지만 보라색을 띠는 건 <i>마시지 말게</i>, 에텔의 물약이 들어간 것 같으니 말이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d0d7b109-17f3-8328-fffe-9ee7d23661bf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_TieflingLeader:d0d7b109-17f3-8328-fffe-9ee7d23661bf
msgctxt "h466c5c59g0d5eg4a4egad34gddb806365fc5"
msgid "You have no idea how good it feels to see these people smiling."
msgstr "이 사람들이 미소 짓는 모습이 얼마나 행복한지 모르네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Trainer
#. Speaker = Asharak
#. NodeID = 15c79a48-c1a6-7ed9-e860-9bb049c2eaaf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Trainer:15c79a48-c1a6-7ed9-e860-9bb049c2eaaf
msgctxt "h7611a582gb528g47f4gb936g510d11888b01"
msgid "It's nice out here - your own little patch of paradise."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Trainer
#. Speaker = Asharak
#. NodeID = 4b09b9c3-7836-326a-bd94-83b09721585e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Trainer:4b09b9c3-7836-326a-bd94-83b09721585e
msgctxt "he38a8542g9027g45eag93c6g89367331ab51"
msgid "Wait. Bollocks."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Trainer
#. Speaker = Asharak
#. NodeID = a46d5a63-dc46-d0c1-299d-61a7f99bd339
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_Leader(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Trainer:a46d5a63-dc46-d0c1-299d-61a7f99bd339
msgctxt "h9122260ega647g4e80ga2b5g08933432e64c"
msgid ""
"Mind the g-word - every time you say 'goblin', you have to take a drink. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 079304a2-7dd2-34ea-5d60-7894cd1f7fed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_UnfortunateGnome_SawArrows(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:079304a2-7dd2-34ea-5d60-7894cd1f7fed
msgctxt "ha8829fbcg8b5ag46d4g869bgf56d25ad4cb5"
msgid "And arrows will?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 07ec5e75-b1d7-6d1e-5f9d-61e4128bcb7b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_UnfortunateGnome(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:07ec5e75-b1d7-6d1e-5f9d-61e4128bcb7b
msgctxt "h19f569a4gb12cg470bgb026g20cdc805a3ce"
msgid "Hmm."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 113f9518-0188-229b-fc58-d03083dd848e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:113f9518-0188-229b-fc58-d03083dd848e
msgctxt "he07411e2gf0d8g426dgbe80g76df792eae49"
msgid ""
"Celebrate? I appreciate that you're proud of your victory, but it's just "
"that. Yours."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 129bf662-301f-5555-c352-809d0d0d109d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:129bf662-301f-5555-c352-809d0d0d109d
msgctxt "h6241224agfb39g4d64ga49dgd621d75b5525"
msgid "Do you mind? I am <i>trying </i>to work."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 12dd559e-ff21-b92d-a943-b1023b226180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:12dd559e-ff21-b92d-a943-b1023b226180
msgctxt "h9a36a576g8ceag4a03g8125gce3554385fe9"
msgid "Your friends are as good as dead. You might as well relax."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 171d8698-0ad8-d42d-f121-9340e814b8ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:171d8698-0ad8-d42d-f121-9340e814b8ba
msgctxt "h9d330649ge485g47a1g91b5gfa718757feec"
msgid "Working."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 1a0d975e-6733-8244-e1de-175de6265826
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:1a0d975e-6733-8244-e1de-175de6265826
msgctxt "h115182a1gded4g4b4egb81cg5320fe7c93c6"
msgid "<i>Lean in close to inspect what he is making.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2a1cdd31-5f30-58ee-6227-a4be65be21de
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHuntCelebration_UnfortunateGnome_GivePlayerArrow(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:2a1cdd31-5f30-58ee-6227-a4be65be21de
msgctxt "h133ad545g4aecg4745g873fg3757b5850f1a"
msgid "Explosive arrows. Here, take one of my old stock and begone."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2b8f4e1d-dabd-ba9e-e20b-1fda6a0430df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:2b8f4e1d-dabd-ba9e-e20b-1fda6a0430df
msgctxt "h28e120ebgae2eg4d36gb233g03d42d3a53c9"
msgid "Yes, thank you. Now please...?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Narrator
#. NodeID = 2f12b31f-3baf-672d-70f3-11bf67d7a36e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_UnfortunateGnome_SawArrows(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:2f12b31f-3baf-672d-70f3-11bf67d7a36e
msgctxt "h12b796a8g7ef7g4a6eg91cag1d7ea2fbd6ab"
msgid ""
"*A choking sulphur stench wafts from the twigs Barcus is cautiously "
"assembling - explosive arrows.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3af4b4d1-993f-c91c-39d2-8683aa476b1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_UnfortunateGnome(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:3af4b4d1-993f-c91c-39d2-8683aa476b1c
msgctxt "ha0c2bb4dg293bg4b01gadadg3e9cd5754219"
msgid ""
"After all you did, I pegged you as a person of good standing. Guess I was "
"wrong."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4ca22339-5772-e336-e0d1-7735dfb4526b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:4ca22339-5772-e336-e0d1-7735dfb4526b
msgctxt "h4f2b1d53gb0e0g4b06g9623g3aa415173913"
msgid "Hmph. I thought you'd understand. Guess not."
msgstr "흠. 네가 이해하리라 생각했는데. 아니었나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 57c01b71-15a8-cb6c-a157-d665e0e00a1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:57c01b71-15a8-cb6c-a157-d665e0e00a1e
msgctxt "hb1a65fa8gf9e2g4185g88e6g8f0548ac2b20"
msgid "Suit yourself, but you should join us when you're done."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 588f7dd2-9eb4-9cee-cc84-169e48517e2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:588f7dd2-9eb4-9cee-cc84-169e48517e2a
msgctxt "h8178a3e0g5490g413ag9d41ga868b0065540"
msgid "<i>Hand him a drink.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 62003ff9-beaf-a529-ff4f-746c841f6e71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:62003ff9-beaf-a529-ff4f-746c841f6e71
msgctxt "ha21180a4gf62ag41adg8b46gd631b21403e5"
msgid "You can take that back. It's in the way."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 6a1f34ee-c232-d173-e77c-1f53b5757fa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:6a1f34ee-c232-d173-e77c-1f53b5757fa0
msgctxt "h7fb3aec3gd140g4b23g8b0dgb84e4068d3bd"
msgid "That's the thing - you're working when you should be celebrating."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 6cc1ed66-8c09-726b-1389-218a5bc9bd0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:6cc1ed66-8c09-726b-1389-218a5bc9bd0f
msgctxt "hd6453672g2e52g4c46g8a19gc0c211eee995"
msgid "Interesting. You're quite the craftsman."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 7279f712-f221-37ef-5583-580d38c8bc2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:7279f712-f221-37ef-5583-580d38c8bc2a
msgctxt "h854daf43g9cccg43e6gb061g0a96b7b77e07"
msgid ""
"I appreciate that you're proud of your victory, but it's just that. Yours.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 72d847e2-d71a-42a8-4b28-f529f6570510
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_UnfortunateGnome(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:72d847e2-d71a-42a8-4b28-f529f6570510
msgctxt "hdcaaf8bbg1cd0g4ad8gb8ccgfef53308b9e5"
msgid "Oh, go enjoy your party."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 75276fe5-b3e5-bd8b-72c0-832f72952295
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:75276fe5-b3e5-bd8b-72c0-832f72952295
msgctxt "hdbb8176cgda48g4254g898bg2ae4b399b1bd"
msgid ""
"Good luck with your new friends. They'll stab you in your sleep, but at "
"least you'll be remembered as a real bastard."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = 8c52aac9-00a3-a60e-90f4-dc024d64749e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_UnfortunateGnome_SawArrows(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:8c52aac9-00a3-a60e-90f4-dc024d64749e
msgctxt "h97d58262g916ag42a1gae21g081d9e8702d8"
msgid "Fair enough. So what are you making?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 904a35aa-0ad7-4723-1269-906f1b418b5b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHuntCelebration_UnfortunateGnome_GivePlayerArrow(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:904a35aa-0ad7-4723-1269-906f1b418b5b
msgctxt "h74076085gd873g46a3ga592g68aad6617c68"
msgid ""
"But... here. Take one of my old stock. I'm sure you'll find a good use for "
"it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = aaba7509-aa18-11e9-b3f2-a8825392d1e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:aaba7509-aa18-11e9-b3f2-a8825392d1e2
msgctxt "hff7ac094ge0fcg4604g9c34g5167c94e4019"
msgid ""
"Wulbren is still missing, and there are gnomes trapped in Moonrise Towers."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = b14468fe-c664-7907-9a8f-f1ba9f135df5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:b14468fe-c664-7907-9a8f-f1ba9f135df5
msgctxt "h244e8534g8695g496bg8500gb196b7dd95b3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = b82e19e7-d624-c59f-3220-91eb89ce73db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:b82e19e7-d624-c59f-3220-91eb89ce73db
msgctxt "h22ac3aacg8ef0g4debg9c2egc17074129aa0"
msgid "No, but a break might help your concentration."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d535f665-44ce-98dc-e3a7-9613e814c576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:d535f665-44ce-98dc-e3a7-9613e814c576
msgctxt "h0ebf2609g49cbg4587g9a5age5e38289f3d6"
msgid "But if you insist..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = e343bafe-45b1-01c0-d25e-19b443b803a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:e343bafe-45b1-01c0-d25e-19b443b803a6
msgctxt "h0c518e24gef5eg47f9g9e2egbf4ae840f271"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = ee3ec880-37c7-2f0f-4275-d37df6f98cd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:ee3ec880-37c7-2f0f-4275-d37df6f98cd0
msgctxt "h054e2b7eg442dg487ag9b78gad34f11587b3"
msgid "I understand. I'm sorry."
msgstr "이해해. 정말 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f40eb435-6845-b498-6cfa-98c572672a31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:f40eb435-6845-b498-6cfa-98c572672a31
msgctxt "h4661f5f4gfd1cg4252ga3cdg32a3540f9e0b"
msgid "Do you? ...You can't solve the world's problems. I don't expect you to."
msgstr "그래? ...네가 세상의 문제를 해결할 순 없어. 그러길 바라지도 않고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Player
#. NodeID = f56ec3af-2639-514d-af90-1622caf0f19d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:f56ec3af-2639-514d-af90-1622caf0f19d
msgctxt "h8e2b310agd3e6g42f2g9a76g467c5399a4c6"
msgid "What are you doing?"
msgstr "뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f7973f30-869b-9399-6980-ef149f48203a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:f7973f30-869b-9399-6980-ef149f48203a
msgctxt "h6b0480e7g6261g435dgb433g5d9af10096cf"
msgid "Me drinking beer won't save them."
msgstr "내가 술을 마신다고 그들을 구하진 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = fde4f511-6251-8cc5-c482-2f31bc213af3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:fde4f511-6251-8cc5-c482-2f31bc213af3
msgctxt "ha46672d2g82c3g4c1ag9c5egf3553626add7"
msgid "There. Celebration."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = fdfa4464-f0f4-9d48-1aa8-c84b2a434c25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_UnfortunateGnome:fdfa4464-f0f4-9d48-1aa8-c84b2a434c25
msgctxt "h6dadee81g6c5ag4ed4gafabg58d0fb5391d9"
msgid "You leaving would help my concentration."
msgstr "네가 떠나준다면 내 집중에 도움이 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 06362cea-6b3c-b6f3-7304-c35313ee6644
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:06362cea-6b3c-b6f3-7304-c35313ee6644
msgctxt "h2ae9a47dg8de2g461bg81c2g597ee263f1bb"
msgid "I'm writing an account of your glorious victory."
msgstr "그대의 영광스러운 승리에 대한 기록을 쓰고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 06491fef-ca8d-3a1d-15d1-df18ae4eda09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:06491fef-ca8d-3a1d-15d1-df18ae4eda09
msgctxt "he0d670b6ga9bcg4765gae83g61e31809d7c6"
msgid "I didn't ask anyone to write my story."
msgstr "내 이야기를 써 달라고 부탁한 적은 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 097084b8-9b8b-f916-1ce4-0fd23646a1cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:097084b8-9b8b-f916-1ce4-0fd23646a1cc
msgctxt "h43a63918g8c20g4957g841dg267e3644c239"
msgid "You have something in mind?"
msgstr "생각해둔 게 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 0a3cf1f9-9d1b-cac6-319e-fbca84520acb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_State_DrowBetrayalOver = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_VoloAfterBetrayal(1) = True
#.   Global:
#.     - GLO_Volo_HasMet = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:0a3cf1f9-9d1b-cac6-319e-fbca84520acb
msgctxt "h7613b7d3g290fg441agb0e4g35a034a669d5"
msgid ""
"Quite a display that was - usually I'm the one providing the drama on nights "
"such as these."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 0aed683b-6c73-75fd-cf8e-ac57590871d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:0aed683b-6c73-75fd-cf8e-ac57590871d1
msgctxt "h769186f5g0650g4f2fg8199g9959c320b710"
msgid "Who locked you up?"
msgstr "누가 너를 가뒀지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 0c568676-e221-33ca-fc7d-4e07ed9b0a3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_HasVoloGoblinManuscriptCopy(0) = True
#. SetFlags:
#.   Object:
#.     - GOB_GiveVoloGoblinManuscriptCopy(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:0c568676-e221-33ca-fc7d-4e07ed9b0a3f
msgctxt "h6514530cg8711g45f9ga0cegc790a6513ade"
msgid ""
"Here - you can keep that copy. The details are very much burned into my "
"memory."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 0ca37827-e75e-b64f-ac0c-a1d6e6893eb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:0ca37827-e75e-b64f-ac0c-a1d6e6893eb9
msgctxt "hb8efef94g1ccfg4ed7gbe00g7ae5f64e6a0f"
msgid "I need the goblins to believe I'm on their side."
msgstr "고블린들에게 내가 그들의 편이라는 확신을 줘야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 11214725-7ddf-1aa5-7619-be42f43667ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:11214725-7ddf-1aa5-7619-be42f43667ff
msgctxt "h11f3b4f1g90a3g446ega046g10f73cd9c379"
msgid ""
"No, your actions in the grove were most heroic, but I am afraid this a "
"matter of style, not <i>sentiment.</i>"
msgstr "아니, 숲에서 그대가 한 행동은 영웅적이었지만, 이건 <i>감성</i>의 문제가 아니라, 표현의 문제야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 13666086-a0f1-d77f-dd0b-0832ec87ca90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:13666086-a0f1-d77f-dd0b-0832ec87ca90
msgctxt "h02788961g445eg4067g9cb1g24f64a2eb8e9"
msgid ""
"I must deliberate. Go - enjoy your evening! I shall have work for you in the "
"days to come."
msgstr "숙고해 봐야겠군. 가서 그대의 저녁을 즐기게! 나중에 그대를 귀찮게 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 178514e5-a0fa-051d-2e36-43dc970bc9a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:178514e5-a0fa-051d-2e36-43dc970bc9a2
msgctxt "h0e59c274g07c5g4833g8dc5g3715efc4f021"
msgid "First - you'll need a name."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 1854dc51-3c13-cd2d-23b8-954cf3c5cf0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:1854dc51-3c13-cd2d-23b8-954cf3c5cf0b
msgctxt "h001b0106g21f9g428bg8018gff73117c9ee6"
msgid ""
"My friend, I am engaged in celebration in its purest form - "
"<i>commemoration. </i>"
msgstr "내 친구여, 나는 가장 순수한 형태의 축하 행사인 <i>기념식</i>에 참여하고 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 1aab8df1-2c56-a38c-d1bb-27e15d60561c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:1aab8df1-2c56-a38c-d1bb-27e15d60561c
msgctxt "hfe5cf5f4g1d0eg4fa5g81c0gd922aa1ac4a9"
msgid "Why - your naming, quite obviously."
msgstr "이런, 당연히 그대의 작명이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 1b4c4038-71dd-ac53-e3ba-00e59f203565
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:1b4c4038-71dd-ac53-e3ba-00e59f203565
msgctxt "h7b9bb0dcg2ff3g46d5g9a45gfffc3b6f010c"
msgid ""
"'Worth'? Volothamp Geddarm takes the matters of names <i>most</i> seriously."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 1d41c145-5563-93c1-8a5c-702884a3c341
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:1d41c145-5563-93c1-8a5c-702884a3c341
msgctxt "h15a3c67cgb214g472ag85a1gf4260113a705"
msgid "Ah, well - no need to involve your guests, I should think."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 1e3e25bc-e8f2-897e-db15-25880a3fec2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:1e3e25bc-e8f2-897e-db15-25880a3fec2b
msgctxt "h89f204a1g4911g4189ga0eeg9d58e570dc79"
msgid ""
"Not to belittle your achievements to date, of course! But besting a dragon, "
"a giant, a <i>god</i> perhaps... hmm."
msgstr "물론 그대의 지금까지 업적을 폄하하려는 것은 아니라네! 하지만 드래곤, 거인, 어쩌면 <i>신</i>까지 이기면... 흠."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 2091857a-66fe-ee21-ac0e-c64db704cda3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:2091857a-66fe-ee21-ac0e-c64db704cda3
msgctxt "h1e1637f3gbed8g44cegbb97g2516e4e56226"
msgid ""
"...Perhaps I spoke in haste. Your insights would, of course, be most welcome."
msgstr "...내가 너무 성급하게 말한 것 같군. 자네의 식견이라면 당연히 환영이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 21c26416-dd7d-cfa1-be74-6f2d35c158c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:21c26416-dd7d-cfa1-be74-6f2d35c158c6
msgctxt "h24c8e04eg8410g405egb9e3ge296b0f84b98"
msgid "<i>Open the cage.</i>"
msgstr "<i>우리를 연다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 222581d2-a4fb-962c-7dc2-4dacdb89febd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:222581d2-a4fb-962c-7dc2-4dacdb89febd
msgctxt "h12b43906ga499g49dfga5b3g22d07ed682a0"
msgid ""
"It seems that following one story has tipped me head-long into another - "
"<i>yours.</i> And I truly can't wait to write it."
msgstr ""
"한 이야기를 따라가다 보니 어느새 또다른 이야기로 엮여들어간 모양이군. <i>자네</i> 이야기 말이지. 어서 적고 싶어 안달이 나는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 2437e8c7-087b-48e0-79c8-047dda8baaa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:2437e8c7-087b-48e0-79c8-047dda8baaa7
msgctxt "h5b8470cfg5bc3g4d92gb7ceg354c4fc8c87f"
msgid ""
"And yet I found it nonetheless. Such is the nature of Volothamp Geddarm, "
"author and interrogator of mysteries."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 2ac8ccc6-fb77-47f5-aa69-33f3889372b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:2ac8ccc6-fb77-47f5-aa69-33f3889372b8
msgctxt "h78a51f8bg1240g4696gaef4g17aa684c0f12"
msgid ""
"I am simply saying that you are a creature of ambition. Drive. <i>Intent.</i>"
msgstr "난 그저 그대가 야망 있는 생물이라 말하려던 것뿐일세. 목적 의식. <i>집요함.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 2adfc207-1019-f5c0-1c5e-e8bca978ccc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:2adfc207-1019-f5c0-1c5e-e8bca978ccc8
msgctxt "h6405b283gb502g474dg8e40g7ca81f2160ac"
msgid "Excuse me - who are you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 2f7ed707-3ae9-a80f-352f-bb9d4d11d6df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:2f7ed707-3ae9-a80f-352f-bb9d4d11d6df
msgctxt "h63cb2055gc9f3g4540gb518g782d332cff7c"
msgid "Don't you have anything of actual worth to work on?"
msgstr "진짜로 의미 있는 일을 할 생각은 없는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 30eb9e4d-6f62-e2bd-6b7b-c785b0ee3ee4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:30eb9e4d-6f62-e2bd-6b7b-c785b0ee3ee4
msgctxt "h43d99445gd493g48e6ga20dgd497496c84d3"
msgid "...<i>Actually</i> slaying a dragon would prove quite helpful, mind."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 313f614c-760e-79e2-badb-ffcd4d044056
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:313f614c-760e-79e2-badb-ffcd4d044056
msgctxt "hc758bdefg764fg41abg89a8gfe776fa860ea"
msgid "'Goblinsbane' has a nice ring to it."
msgstr "'고블린의 파멸'이 괜찮은 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 31b1b6e5-4290-478a-6ca4-c7f620117b44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:31b1b6e5-4290-478a-6ca4-c7f620117b44
msgctxt "hbba10f18g0c05g4d5fg8b09gae5c1fc987cf"
msgid ""
"I can't rightly document your deeds from the bottom of a goblin cookpot, "
"after all. Ha ha."
msgstr "내가 결국 고블린 냄비에 들어가면, 그대의 행동을 제대로 기록할 수 없잖나. 하 하."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 3429b691-adba-6ec1-f534-f27d19271b14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:3429b691-adba-6ec1-f534-f27d19271b14
msgctxt "hfb04e51dg58c2g4123gb7aag73119f103a38"
msgid ""
"A wonderful one indeed - but your deeds loom larger than life now, my "
"friend. You simply must have a title to match."
msgstr ""
"실로 멋진 이름이지만, 이제 그대의 업적은 일생보다 더 크게 기억될 걸세, 친구여. 그대에게는 업적에 걸맞는 칭호가 있어야 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 34f66788-961b-d96d-b4cd-f185fbd0ef2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:34f66788-961b-d96d-b4cd-f185fbd0ef2c
msgctxt "h57b3ac63g2369g4843gb041gd9702c7ae923"
msgid ""
"Of course you didn't. History is but a series of accidents, after all, both "
"happy and heinous."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 378018ad-cf6c-f404-4489-dd485243588d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_HasVoloGoblinManuscriptCopy(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:378018ad-cf6c-f404-4489-dd485243588d
msgctxt "h4778fb4fg0736g4bd5g94fag35847b6f2f1d"
msgid "Maybe I'll keep you in this cage for good."
msgstr "확 널 이 우리에 영원히 가둬둘 수도 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 39c4ccf5-c673-2805-2955-2eec2fc25876
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:39c4ccf5-c673-2805-2955-2eec2fc25876
msgctxt "h68fc5251gf4ccg4617gb968g49e6cbd37db1"
msgid "Fine. Keep your scribbles."
msgstr "됐어. 그 낙서는 혼자 잘 간직해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 3a8a06b8-23fa-f415-3206-19882437ae3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:3a8a06b8-23fa-f415-3206-19882437ae3d
msgctxt "h0ea11d98gf34dg4fbbgae50g54d396512ebc"
msgid ""
"But how am I to ensure your most-deserved renown without a suitably "
"thrilling title?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 3e9805ef-908e-4eeb-0086-141e1013c265
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:3e9805ef-908e-4eeb-0086-141e1013c265
msgctxt "h6be959b6g1a0fg45dagb5b4gd40415100550"
msgid ""
"<i>I</i> know you had a purpose. Though I'll grant that I'm quite in the "
"dark as to what it was. Might you elaborate?"
msgstr "<i>나만큼은</i> 그대가 목적이 있었다는 걸 알고 있네. 그게 무엇이었는지는 모르겠지만. 자세히 설명해 주겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 40d3dc25-8d0c-efb3-22b8-cade51ca99ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:40d3dc25-8d0c-efb3-22b8-cade51ca99ac
msgctxt "h8ac95f0dg6d38g4febgb051g6ab40e06421f"
msgid "Ah, a ruse! You've played the part admirably, if I may say so."
msgstr "아, 계략이었군! 내가 이런 말해도 될지 모르겠지만, 그대는 감탄스러울 정도로 역할을 잘 수행했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 4a236526-ad7a-bebe-d6ae-3f1166d59272
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:4a236526-ad7a-bebe-d6ae-3f1166d59272
msgctxt "h6d71d8e4g7402g4522ga0c6gae4cefc89284"
msgid "What about 'Grovekeeper'?"
msgstr "'숲 수호자'는 어떤가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 4c6186dc-13f4-99a9-43a9-5adf7cdd67c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:4c6186dc-13f4-99a9-43a9-5adf7cdd67c0
msgctxt "h594de0efgc1c9g44c9gb663g8de9c3151d5c"
msgid ""
"But I'd rather talk about <i>you. </i>If I'm to write an account of the "
"battle, I'll need details while they're still sticky."
msgstr ""
"그보다는 그대에 대해 이야기하고 싶네. 전투에 대한 설명을 쓰려면 아직 그대의 기억이 생생할 때 세부적인 사항을 들을 필요가 있으니 "
"말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 4c9fcbc1-8ef7-438c-bae0-00944b5cca4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:4c9fcbc1-8ef7-438c-bae0-00944b5cca4e
msgctxt "h0a68b672gbfcag4423gade9g1cda69893eff"
msgid ""
"After all, I'm quite certain I once saw one expire from the strain of "
"spelling his own name."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 4dae8926-dbe3-689a-7fdf-eed931234152
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:4dae8926-dbe3-689a-7fdf-eed931234152
msgctxt "h736a565fgedd6g49c9g9c68g0db85773011e"
msgid ""
"No, no - it is for you to slay the dragons, and for me to worry about the "
"accolades."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 4e8d760f-cac5-a2d4-f91f-49d5f2102ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:4e8d760f-cac5-a2d4-f91f-49d5f2102ce5
msgctxt "h3d990bf6g8c67g4c4ag9e6cgc98e01121ab4"
msgid ""
"No, I'm afraid that won't do. You shall simply have to go out and slay "
"something decidedly more dramatic."
msgstr "미안하지만, 그 이름은 적절하지 않네. 그보다는 훨씬 대단한 것들을 학살해야 할 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 4eaf35e7-15eb-36a0-aa95-d0be50010359
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:4eaf35e7-15eb-36a0-aa95-d0be50010359
msgctxt "hd0f38293g700cg4c16g939dgb8b721c3102d"
msgid "I don't remember inviting you to my camp."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 512cea8c-bb24-0f70-9586-f77b5273d70f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_VoloAfterBetrayal(1) = True
#.   Global:
#.      - CAMP_GoblinHuntCelebration_State_DrowBetrayalOver = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:512cea8c-bb24-0f70-9586-f77b5273d70f
msgctxt "h302453c3g80f4g4bcfga371g44b8b776db67"
msgid "You should get some rest. You've had <i>such</i> a big day."
msgstr "편히 쉬게나. <i>엄청난</i> 하루를 보냈으니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 5397d1c5-5124-57ac-3eb8-e29a249fc877
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_DrowPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:5397d1c5-5124-57ac-3eb8-e29a249fc877
msgctxt "h98ace61eg1542g47b9g9b65g6e8891a9b940"
msgid ""
"I do hope you didn't catch anything. I'm sure an itching conscience is "
"<i>quite</i> enough."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 5a6d21d9-d5ba-a565-24b7-983df44e5037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:5a6d21d9-d5ba-a565-24b7-983df44e5037
msgctxt "hec604c04gc9f5g4850g91aag9975e3b97439"
msgid ""
"Something iconic, but not too much of a mouthful. We don't want to exclude "
"the common-folk, after all. I intend this tale to enrapture <i>all.</i>"
msgstr ""
"상징적이지만 너무 복잡하지 않아야 하네. 결국, 일반 대중을 배제하면 안되니 말일세. 나는 이 이야기를 통해 <i>모두</i>를 "
"매료시키고자 한다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 5c04ef3b-fd0a-4317-d680-a1b8e2b45eaf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:5c04ef3b-fd0a-4317-d680-a1b8e2b45eaf
msgctxt "he78e558cgffc7g451aga981g3601e0d31612"
msgid "How did you get here?"
msgstr "어쩌다가 거기에 갇힌 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 60875800-1f5a-91fd-1177-5a6fa03750cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:60875800-1f5a-91fd-1177-5a6fa03750cd
msgctxt "h46a35eadg8801g4438g866dg95cd9aa30fa8"
msgid "That way, perhaps we'll both survive the night."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 628c5572-877b-f87a-3187-95605384cd8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:628c5572-877b-f87a-3187-95605384cd8a
#, fuzzy
msgctxt "ha73508e8gfe8fg41b9ga886gea93d9b18820"
msgid ""
"These beasts appear quite convinced that you're a comrade in arms. Just as "
"the tieflings were, I expect."
msgstr "이 짐승들은 그대가 전우라고 꽤나 확신하는 것 같네. 티플링들이 그랬던 것처럼 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 6ccefec3-cb35-8f07-6c45-1b7a4ac2ce34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = False
#.      - GOB_VoloBallad_State_PlayersMetVolo = False
#. SetFlags:
#.   Global:
#.     - GLO_Volo_HasMet = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:6ccefec3-cb35-8f07-6c45-1b7a4ac2ce34
msgctxt "h4aab62ddge1b3g4467g9715g2f4eb1f268cd"
msgid ""
"Volothamp Geddarm - realm-renowned author, auteur and now, it appears, very "
"much your captive."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 6fa0f281-ed1a-d28c-225a-28b6ff31d567
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:6fa0f281-ed1a-d28c-225a-28b6ff31d567
msgctxt "hd3be0edagca03g4860gaed7g4999e8353047"
msgid "I have other things to do."
msgstr "지금은 다른 일을 해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 700db189-e551-4e2e-615a-17527812a3a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:700db189-e551-4e2e-615a-17527812a3a1
msgctxt "hf544452fg2751g4f11ga384gfbad5127e8f4"
msgid ""
"It's simply that, for the life of me, I cannot imagine what that purpose "
"<i>was</i>. Could you elaborate?"
msgstr "단지 그 목적이 <i>무엇이었는지</i>를 나로서는 도저히 상상할 수 없을 뿐이네. 자세히 설명해 주겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 70ecad64-08f3-0715-deb1-41f4bea1f22a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:70ecad64-08f3-0715-deb1-41f4bea1f22a
msgctxt "h3bd6ebd1ga733g4b3agbe54g3e9b026be8d1"
msgid ""
"Far too much - this is the very problem. If you could set aside your many "
"triumphs, carry out one <i>defining</i> act..."
msgstr "너무 많다는 게 문제일세. 그대의 많은 승리를 제쳐두고, 한 가지 <i>결정적인</i> 업적을 꼽자면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 726e0535-c3ad-b4b6-3837-0f07a690e181
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:726e0535-c3ad-b4b6-3837-0f07a690e181
msgctxt "h7b609c1cgb517g4e80g826eg3dc9fd570d2c"
msgid ""
"The very heart of my dilemma! You are the do-er of deeds, I the mere "
"chronicler. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 7381ade5-c3f3-e936-597e-ed6e6e39f7eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:7381ade5-c3f3-e936-597e-ed6e6e39f7eb
msgctxt "h14a92c0eg6cbfg4dc3ga46egf5bce747d915"
msgid "I get it. Something flashy and made up, like 'Volothamp Geddarm'."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 7407b61b-6ef0-c968-5867-86ba85822092
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_Volo(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:7407b61b-6ef0-c968-5867-86ba85822092
msgctxt "hc93a3d01g1dd7g4635g9b3age2bb75b4e029"
msgid ""
"See your guests aren't bored. The last thing we want is for them to make "
"their own fun."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 753edd1d-ab94-5ef5-a0a1-80af3a5b499b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:753edd1d-ab94-5ef5-a0a1-80af3a5b499b
msgctxt "h5f124791g3009g4ec4ga380gd66567b70ff0"
msgid ""
"But I daresay you're committed now, my friend. So chin up, look around, and "
"remember your role, hm?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 7683505e-ea19-aa4c-c48c-574acadc7dfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_Volo(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:7683505e-ea19-aa4c-c48c-574acadc7dfd
msgctxt "he5fe70e1g5d26g4620ga4dfg71b30e29eeff"
msgid ""
"Ah, the guest of honour arrives! I've been observing the festivities from a "
"<i>sensible </i>distance."
msgstr "아, 주인공께서 오셨군! 나는 <i>적당히</i> 거리를 두고 축제를 지켜보던 중일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 796c67d7-d2a9-57b5-7c35-9f303ff04803
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:796c67d7-d2a9-57b5-7c35-9f303ff04803
msgctxt "h53936794gbff8g4d67gaed0ge18673dfa3c1"
msgid ""
"Back to your revelry, then - when I have crafted your legend for you, no "
"doubt you shall hear of it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 804e8a39-ae79-0031-8835-8cc26c6c7d55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:804e8a39-ae79-0031-8835-8cc26c6c7d55
msgctxt "h4f6f6c5fg561dg49cfg84e0g85cbcf3b23c0"
msgid "You make that sound like a threat."
msgstr "위협하는 것처럼 말하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 816a7131-3589-41ca-2a38-e95dcfd767ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:816a7131-3589-41ca-2a38-e95dcfd767ce
msgctxt "hee166224gc8e2g4b66g9ecagfe42529dd930"
msgid ""
"I'd heard tell of a goblin camp that had been overtaken by some new upstart "
"god."
msgstr "무슨 새로 생긴 신을 믿는 고블린 야영지가 있다는 이야기를 들었다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 8a4d0ab3-5b1b-a51d-16a1-76c372c39139
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:8a4d0ab3-5b1b-a51d-16a1-76c372c39139
msgctxt "h141e6abfg2d96g47a2g93fbgb3b81f357805"
msgid ""
"<i>'Grovekeeper'? </i>Are you a gardener? We aim to cultivate mystery, "
"not... shrubbery."
msgstr "<i>'숲 수호자'? </i>그대가 정원사인가? 우리는 신비를 가꾸고자 하네… 관목이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 8a5fb22d-0c41-97ea-114f-9f476fcaa63b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:8a5fb22d-0c41-97ea-114f-9f476fcaa63b
msgctxt "h9aa39a39g8cfdg4eaeg9513g1623725e0e42"
msgid "I'd rather no one knew."
msgstr "아무도 몰랐으면 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 8ee0a7de-3e82-7c0f-3a3c-d339f921139a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:8ee0a7de-3e82-7c0f-3a3c-d339f921139a
msgctxt "hf2b1f9fegeaf2g401cgb934g87c8eea94542"
msgid ""
"Ye gods, then let us add ignorance to your list of crimes. I am Volothamp "
"Geddarm, realm-renowned author, auteur, and tastemaker."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 8f9b4e1f-80cd-10a1-2ea9-504f14d5bfc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_HasVoloGoblinManuscriptCopy(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:8f9b4e1f-80cd-10a1-2ea9-504f14d5bfc4
msgctxt "hcc816167ge194g4990ga816g3cdeebefd93d"
msgid "And the goblins? Should I tell them what you're writing?"
msgstr "그럼 고블린은? 내가 가서 네가 뭘 쓰는지 말할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 91d47419-7d84-6f61-a920-185cf70cba4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:91d47419-7d84-6f61-a920-185cf70cba4a
msgctxt "hf156c165g834fg488fgb530g6c5f5d7d4ca1"
msgid "And he has an arsenal of choice names for those who don't. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 9353c495-50df-22e8-2375-1b6e02dcf41c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:9353c495-50df-22e8-2375-1b6e02dcf41c
msgctxt "h0d2d42d5g8e22g40dbgb9a3gab04c178901e"
msgid ""
"If you are to repay what you owe, then there is no time to waste. Start at "
"the beginning."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 94a45d55-9e8d-3ae4-53fe-3b47e1f413d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:94a45d55-9e8d-3ae4-53fe-3b47e1f413d8
msgctxt "h558d7173ga024g46e5gb7eeg80aed8eebd85"
msgid ""
"If we are to write your legend in the stars, then we must first give you a "
"name."
msgstr "그대의 전설을 별에 기록하려면, 먼저 그대에게 이름을 붙여야겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 9d4127cf-8f45-a084-fa30-9e0d54433bba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_Volo(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:9d4127cf-8f45-a084-fa30-9e0d54433bba
msgctxt "h6a34f52eg885ag4d33g8cb2gb64f72542598"
msgid "Aha, there you are! Come now, settle in."
msgstr "아하, 여기 있었구만! 자, 와서 자리를 잡으시게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = 9f353375-e427-54c5-ad03-06f2788fef78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:9f353375-e427-54c5-ad03-06f2788fef78
msgctxt "hc96d734egb8e1g495agbff1g95d9cf68bf4f"
msgid "I didn't mean for any of this to happen."
msgstr "나는 이런 일이 벌어지길 의도한 건 아니었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = 9f6cc104-9b05-5a35-4d3d-b722a04e4e56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:9f6cc104-9b05-5a35-4d3d-b722a04e4e56
msgctxt "hdfc0a45agb290g4e29gbd23g65ef79f294d1"
msgid ""
"It is for Kelemvor to judge you, when the time comes. May he do so justly."
msgstr "때가 되면, 켈렘보르께서 그대를 심판하시겠지. 그가 정당하게 심판하시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = a5c5bc62-b911-d7f4-9438-defd22bc34cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:a5c5bc62-b911-d7f4-9438-defd22bc34cb
msgctxt "haaf2c763gf01bg4ab9ga2cdga6f6911564fb"
msgid ""
"The unenlightened might see your actions there as no more than aimless "
"slaughter."
msgstr "무지몽매한 자들은 그곳에서 그대가 한 행동을 목적 없는 살육으로 여길지도 모른다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = a70add9a-07a5-d7cb-471c-6b5829aaf302
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:a70add9a-07a5-d7cb-471c-6b5829aaf302
msgctxt "h3af49a9cg217dg47c5ga914g1d27b8bfbab6"
msgid ""
"I do hope you have partaken of something bracing? This may well take us all "
"night."
msgstr "그대가 든든히 먹었다고 생각해도 되겠나? 이 일이 밤새도록 걸릴지도 몰라서 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = a7468dbf-b71a-f22a-7503-30cfccc04a26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:a7468dbf-b71a-f22a-7503-30cfccc04a26
msgctxt "h5667ccfdg795eg4bceg9297g6f1f3b5001c7"
msgid ""
"But rest assured that your story is in safe hands. Volothamp Geddarm knows "
"<i>exactly</i> what you are."
msgstr "하지만 그대의 이야기는 충실하게 쓰여질 것이라 믿어도 좋네. 볼로뎀프 게담은 그대가 누구인지 <i>정확히</i> 알고 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = a9aa9198-eadc-ce67-ee5d-4a94110e4be5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:a9aa9198-eadc-ce67-ee5d-4a94110e4be5
msgctxt "h025e35ecgdc8eg4933gabbdg289da239ad39"
msgid ""
"When I came to investigate, they invited me to stay. Rather permanently."
msgstr "내가 조사하러 찾아가자, 그들이 머무르라고 초대했지. 좀 영구적으로 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = a9ecf50f-1bee-4aac-bd11-e42be5706190
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:a9ecf50f-1bee-4aac-bd11-e42be5706190
msgctxt "hbc27b955gcac0g4641gb7fag7cc18510c2f6"
msgid ""
"Back to the revelry with you! I'll give the matter some thought in small "
"council."
msgstr "파티로 돌아가서 즐거운 시간을 보내시게! 나는 혼자만의 자문회를 열어서 이 문제에 대해 좀 고민해 보겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = abb79e95-f55b-ad79-50be-b7bb345716d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:abb79e95-f55b-ad79-50be-b7bb345716d9
msgctxt "h4474d8d9gc083g4cbag8accg724eaccb8f48"
msgid ""
"Not to meddle in your side of this partnership, but slaying goblins is not "
"exactly the stuff of <i>legends, </i>is it?"
msgstr ""
"이 일에 대해서 그대에게 참견하고 싶진 않지만, 고블린을 학살하는 걸 <i>전설</i>이라고 부르기엔 썩 안 어울린다고 생각하지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = ad2012dc-dd02-e29e-cab5-165117622952
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:ad2012dc-dd02-e29e-cab5-165117622952
msgctxt "h5361e41cg7f0bg4d70g8b62g58d2afca2973"
msgid ""
"What you did at the grove... I rather think the world should remember, don't "
"you?"
msgstr "그대가 숲에서 한 일은... 온 세상이 기억해야 한다고 생각하네, 그렇지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = b1ae882d-ef23-bee9-10b0-a135c491bc3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:b1ae882d-ef23-bee9-10b0-a135c491bc3a
msgctxt "h3597f309g1068g4547gbdd6gb9eec4eecd80"
msgid "You stole a story from me. Courtesy demands I get yours in return. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = b31ec992-ab36-0de4-38f4-ed5b474ae68e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:b31ec992-ab36-0de4-38f4-ed5b474ae68e
msgctxt "h47428604gb358g49c0g824egd9ed24cb0baf"
msgid "I don't need to justify myself to you."
msgstr "나는 당신에게 나 자신을 정당화할 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = b6d8af50-a31a-8e6f-b062-168a667554e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:b6d8af50-a31a-8e6f-b062-168a667554e3
msgctxt "h06472602g34d0g498ag948ag3ef7bec37bc4"
msgid ""
"I appreciate your editorial instincts, but Deneir himself does not get a "
"peek at my early drafts."
msgstr "그 편집자로서의 본능은 감사하네만, 데네이르께서 오신다 해도 내 초안은 보여줄 수 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = bd0d5e9d-26d0-b159-fd51-edaaad4bde47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:bd0d5e9d-26d0-b159-fd51-edaaad4bde47
msgctxt "h6bf54f40g8148g48bbg8e49ge30eb031df9a"
msgid "And by 'this', you mean...?"
msgstr "'이 일'이란 건...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = be6857ba-0a11-3975-2507-e7e964b671e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:be6857ba-0a11-3975-2507-e7e964b671e0
msgctxt "ha30116ecg2040g4304g897dg74a47727b49e"
msgid ""
"Now, back to your revels. I have some details of your victory to rearrange."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = be8fc504-d309-22ed-0211-d1354ae24bee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:be8fc504-d309-22ed-0211-d1354ae24bee
msgctxt "h7f7688e3g7859g4ef6gb392g5308fe200c04"
msgid "Don't you want to join in the celebrations?"
msgstr "축하연에 참여하고 싶진 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = c12d9905-2d93-d641-cb39-95ed43d0d16a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:c12d9905-2d93-d641-cb39-95ed43d0d16a
msgctxt "h6ada57f8g84a5g4157g96f9gf8f6abbf830b"
msgid "Shouldn't we be celebrating?"
msgstr "축하해야 하지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = c9d28c1a-f4c8-4d34-5789-d93a1dfb79b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:c9d28c1a-f4c8-4d34-5789-d93a1dfb79b2
msgctxt "he13d6dcfg22e2g4e62g8582g2058997d2d0d"
msgid ""
"And do you think Volothamp Geddarm got where he did by waiting to be "
"<i>asked?</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = cdba3d9c-1b5a-1bbe-91c4-45f878226949
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:cdba3d9c-1b5a-1bbe-91c4-45f878226949
msgctxt "hcdc7a5fag12e6g45b5g8aaeg94ae6c2a27fe"
msgid "Of course not! I am only here to bear witness."
msgstr "없고 말고! 나는 증인이 되기 위해 여기 있는 것뿐이라네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = cdfd2fbe-22c5-fa14-2203-899ada65b425
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:cdfd2fbe-22c5-fa14-2203-899ada65b425
msgctxt "h031d25beg72a7g4ce0ga8f9ga4fa570bd4df"
msgid ""
"My next piece was meant to be an exposé on the local goblins and their "
"'Absolute'. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = ceab4cda-47f5-686e-4ae4-c70a3cb05a97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:ceab4cda-47f5-686e-4ae4-c70a3cb05a97
msgctxt "h25ea8a18gf83eg4801ga89bge86616e755b1"
msgid ""
"Fear not! I am content - and quite forgotten - where I am. Better in a cell "
"than in a stew, what?"
msgstr "걱정 말게! 나는 내가 있는 곳에 만족하고 있네. 스튜에 들어가는 것보단 감옥에 들어가는 게 낫지 않은가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = d1de74aa-6f43-0252-1f29-cf8187df6648
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:d1de74aa-6f43-0252-1f29-cf8187df6648
msgctxt "h628823begeb3dg4251gbe78g20cc8f29ecb3"
msgid "What a fun friend you've made."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = d52ac560-86eb-5119-d21f-306bc77ed8f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:d52ac560-86eb-5119-d21f-306bc77ed8f9
msgctxt "h7ab60f14ge80ag4d76g9cfbg620347d98a80"
msgid ""
"The grove, for example. Its destruction was quite necessary to your purpose, "
"I have no doubt."
msgstr "숲이 그 예일세. 그것의 파괴가 그대의 목적에 필연적이었다는 건 의심의 여지가 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = d542c3d9-21ee-eb38-f623-64515de3c34a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = False
#.      - GOB_VoloBallad_State_PlayersMetVolo = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_HasMet_Volo(1) = True
#.   Global:
#.     - GLO_Volo_HasMet = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:d542c3d9-21ee-eb38-f623-64515de3c34a
msgctxt "hcb2b311ag296fg4aceg9328g4e8aafa39f38"
msgid "Aha, there you are! Come now, settle in."
msgstr "아하, 여기 있었구만! 자, 와서 자리를 잡으시게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = d71c316a-7ea7-a5d8-397c-4afcbdb968f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:d71c316a-7ea7-a5d8-397c-4afcbdb968f5
msgctxt "h4af781e7gcf84g44cegb34agd5937d0cb6df"
msgid ""
"Should my writing favour facts over form, it is only to keep pace with "
"events."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = d873439f-cb40-ea88-a374-2bc0fa162e42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:d873439f-cb40-ea88-a374-2bc0fa162e42
msgctxt "h8441d0abg8d67g4ba1gba5fg0e1dc486fbd7"
msgid "You have been <i>quite</i> busy, after all."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = dcffc4a9-0f90-cec1-d1b5-ad2b87780923
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:dcffc4a9-0f90-cec1-d1b5-ad2b87780923
msgctxt "h36e476a5gea7cg4756gb3e6g5e15f2bba62b"
msgid ""
"I have no doubt! But such grand deeds as yours often require... "
"interpretation. The grove, for example."
msgstr "나도 의심치 않네! 그러나 그대가 한 일과 같이 위대한 행동에는 종종... 해석이 필요하지. 숲이 그 예일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = e11849f8-bac2-0c4c-e467-e0084a1243ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:e11849f8-bac2-0c4c-e467-e0084a1243ab
msgctxt "h861a6cefg671dg42b2g97d6g621306c47cd0"
msgid "Volothamp Geddarm - realm-renowned author, auteur, and tastemaker. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = e4ce3795-287c-ed36-20e7-cd5da2cad190
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:e4ce3795-287c-ed36-20e7-cd5da2cad190
msgctxt "hbaf2f537g897fg454ega034gb165b2f2675b"
msgid "Give me your notes. I'll decide what you write."
msgstr "그 책 이리 내. 뭘 쓸지는 내가 정할 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = e61ffbf4-6529-5fda-20ce-063fbe6e3d69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:e61ffbf4-6529-5fda-20ce-063fbe6e3d69
msgctxt "h9343321dg1cb6g4c95g9679g84b3969c124a"
msgid "I already have a name."
msgstr "나는 이미 이름이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = eb04cdec-d488-15e4-c64e-75cc87221128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:eb04cdec-d488-15e4-c64e-75cc87221128
msgctxt "h98cd6851gad86g40cdg9e31gdd48dbb778fa"
msgid ""
"Exac-tly wrong, my friend! I urge you to leave the fact-finding to experts, "
"hmm?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = ee177c69-1e09-d6a0-a531-4c6f104f1e09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:ee177c69-1e09-d6a0-a531-4c6f104f1e09
msgctxt "h55cae8e4gaaa1g4e5bg90e5gd05f98dcdd04"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = ee7eb590-2f06-594b-fc6b-9808790b35c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:ee7eb590-2f06-594b-fc6b-9808790b35c2
msgctxt "hbd43bbf7gb691g4ebcg8a45g99988157aa18"
msgid ""
"That ballad was but a crude preview, a frame without its crowning jewel - "
"your <i>nom de guerre.</i>"
msgstr "그 발라드는 조잡한 예고편에 불과했고, 최고의 보석이 없는 장면이었네. 그 보석은 바로 그대의 <i>가명</i>이라네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = ef62f60f-f9f3-d0d1-7011-7b850a72e56f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:ef62f60f-f9f3-d0d1-7011-7b850a72e56f
msgctxt "hc4088167ge502g4ce8gb67cg8a301e101071"
msgid ""
"NO! I mean to say - I am quite content behind bars. A precautionary measure, "
"you understand."
msgstr "안 돼! 그러니까 - 나는 감옥에서 꽤 만족하고 있다네. 예방 조치이니, 이해해 주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = f1ba33ae-4716-0f45-529f-e51d92f24779
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:f1ba33ae-4716-0f45-529f-e51d92f24779
msgctxt "h40604b33g7449g4a82ga3b2g71f91a9c3c10"
msgid "The world will know my name. I don't need you for that."
msgstr "온 세상이 내 이름을 알게 될 거야. 너의 도움 없이도."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Player
#. NodeID = f27f2e04-9eda-7810-f21a-66e73c6cdcbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:f27f2e04-9eda-7810-f21a-66e73c6cdcbb
msgctxt "h2b8dc7a3gd945g4f62gbcf2g24276fae85f4"
msgid "What I owe? What are you talking about?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = f4b4c84a-2e98-a851-72f1-0a18834e078e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:f4b4c84a-2e98-a851-72f1-0a18834e078e
msgctxt "h94899fa3g70c3g4879gb5a4g666928bf6021"
msgid ""
"Your modesty does you credit, my fine friend. But bards and biographers need "
"sordid <i>details.</i>"
msgstr "그대의 겸손함은 칭찬받을 만하네, 훌륭한 친구여. 하지만 바드와 전기 작가에게는 지저분한 <i>세부 사항</i>들이 필요하다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = f60d3b98-0a65-5722-e04b-8c6cd66816c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:f60d3b98-0a65-5722-e04b-8c6cd66816c6
msgctxt "ha001b807g9c35g4d81gaab1g568013ca057f"
msgid ""
"But I am engaged in celebration of the purest form - <i>commemoration.</i>"
msgstr "하지만 나는 가장 순수한 형태의 축하 행사인 <i>기념식</i>에 참여하고 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = f999a7af-e1ea-9890-734c-8a42d7d16cfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_HasMet_Volo(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:f999a7af-e1ea-9890-734c-8a42d7d16cfc
msgctxt "hdd17fea0gd44cg4986g9408g0d6b8771f43f"
msgid "Away and have your fun! I have a myth to make."
msgstr "저리 가서 충분히 즐기게나! 난 신화를 써야 하니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo
#. Speaker = Volo
#. NodeID = fa46a0a7-398d-ec74-4e3b-236b8ffaacbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Volo:fa46a0a7-398d-ec74-4e3b-236b8ffaacbe
msgctxt "hcf347acagd157g483ag8e86g669cf42b3c55"
msgid ""
"They're quite dead now, as you know. Too dead to provide a single meaningful "
"quote."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 04dbae0b-2e96-d16a-ed01-ff75d0c53034
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:04dbae0b-2e96-d16a-ed01-ff75d0c53034
msgctxt "h859cf602g8537g4943ga373g62f197e0feed"
msgid "But do not deceive yourself: our bond runs no deeper."
msgstr "하지만 오해하진 마라: 우리 유대가 더 깊어지진 않을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 05e96a38-4f24-e3b6-9e2b-d8fc50d6a8af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:05e96a38-4f24-e3b6-9e2b-d8fc50d6a8af
msgctxt "h637f05e8g1b58g4e0fg9909g013ad8d677e2"
msgid "Do you think we could make love again soon?"
msgstr "곧 다시 사랑을 나눌 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 07b2bee9-24c7-55a6-6b43-90e815740034
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:07b2bee9-24c7-55a6-6b43-90e815740034
msgctxt "h417d3bf1g8a87g4896gaa6fg99867e7f392d"
msgid "I've changed my mind."
msgstr "생각이 바뀌었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 08dae218-d828-9809-bfbf-de08f4f63ea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:08dae218-d828-9809-bfbf-de08f4f63ea6
msgctxt "h0207f1c6ge446g44eeg9b2fg86ee6675a20f"
msgid "Hmm - you do look peaked."
msgstr "흠, 확실히 피곤해 보이는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Narrator
#. NodeID = 0a961abf-8393-419b-0995-e890227a36f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:0a961abf-8393-419b-0995-e890227a36f8
msgctxt "h5c715852g6846g43b4ga285gb70f353af3db"
msgid ""
"*Every breath, every blink proves exhausting. Perhaps the morning will bring "
"relief.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 0b4d1e75-a3ca-ea93-0c43-088976a1d191
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:0b4d1e75-a3ca-ea93-0c43-088976a1d191
msgctxt "hebab6207g50d4g461cg968cg3d5ecc73acfe"
msgid "What comes next for us?"
msgstr "이제 다음은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 0e52a971-0956-b5b8-6991-dbfd5556d46a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:0e52a971-0956-b5b8-6991-dbfd5556d46a
msgctxt "hc9cf344cga045g4e43gbb39ge49403c198a3"
msgid "Say 'yes', and you brave turbulent waters."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 0e8329c5-5134-c3bd-5c27-836f4ecc904e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:0e8329c5-5134-c3bd-5c27-836f4ecc904e
msgctxt "h336aec88gd5fbg48edga387gb3217ff8af86"
msgid "<i>Shake off the ache and go to sleep.</i>"
msgstr "<i>고통을 털어버리고 잠자리에 든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 10dda096-c228-0427-3566-605132f24191
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:10dda096-c228-0427-3566-605132f24191
msgctxt "hd9194d8bgb5f1g4cffg98b9gcd5676973764"
msgid "Submit? What do you intend to do?"
msgstr "굴복하라고? 뭘 하려는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 174d9790-7bb5-f2f3-f062-9e2a0f21de4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:174d9790-7bb5-f2f3-f062-9e2a0f21de4a
msgctxt "h9fa107d3g827cg475dg925egebed2f531b86"
msgid "Of course. I'm as extraordinary a lover as I am warrior."
msgstr "물론이지. 난 뛰어난 전사인 동시에 사랑을 나누는 데에도 능숙하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 1a8e2b93-da32-b063-72a4-87e34607fcca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:1a8e2b93-da32-b063-72a4-87e34607fcca
msgctxt "h8497e0f3gd675g4852ga18fg2b83d8070b23"
msgid "What comes next for us?"
msgstr "이제 다음은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 211db6be-97c3-a751-5677-2abcc886a273
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:211db6be-97c3-a751-5677-2abcc886a273
msgctxt "hc5169fe9gd2d5g4c6dg89feg2bb6d1c096ad"
msgid "<i>Grimace at her arrogance.</i>"
msgstr "<i>그녀의 오만에 얼굴을 찌푸린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 23759a9d-48bf-4b86-ad36-045118486e2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:23759a9d-48bf-4b86-ad36-045118486e2e
msgctxt "h48f706d5ga305g43cegb842gf64803b406fb"
msgid "Yes. Take me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 27acc90a-c6f2-21b4-2bf5-66062e1ced04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:27acc90a-c6f2-21b4-2bf5-66062e1ced04
msgctxt "hb7244225gf374g49b3gbd7fg6594a24ace74"
msgid "Close your eyes - <i>and submit</i>."
msgstr "눈을 감고 - <i>굴복해라</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 36537d71-d96a-b8c5-9dcb-1121dabcf40d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:36537d71-d96a-b8c5-9dcb-1121dabcf40d
msgctxt "haacd0b00g7f88g4b84g974bge7faa0dbdf04"
msgid ""
"You are a fit specimen yourself, kin. Fit enough to wield a silver sword of "
"your own, should Vlaakith be so generous."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Narrator
#. NodeID = 396d5836-0105-bf5b-0aa0-afe5548a258f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:396d5836-0105-bf5b-0aa0-afe5548a258f
msgctxt "h43d5fd27g3999g4c05g887cg2d05c0bfc98c"
msgid ""
"*You are a lapdog, Lae'zel's to command. Never has domination tasted so good "
"and felt so freeing.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Narrator
#. NodeID = 397489ef-3f1f-3257-c6f1-4526b86be4a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:397489ef-3f1f-3257-c6f1-4526b86be4a0
msgctxt "h22081e74gc7d1g49f1ga0efgfc96e3f7e939"
msgid "*A pause. And then the flicker of a tongue across your neck.*"
msgstr "*잠시 침묵이 흐릅니다. 그러더니 목을 따라 혀의 감촉이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 3ab72c69-e236-dbd3-9d0b-45ed777b59cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:3ab72c69-e236-dbd3-9d0b-45ed777b59cd
msgctxt "hbed2ae2bg036fg4b83g8cbag20ddf99dcf4a"
msgid "Go to sleep. Our hunt resumes at sunup."
msgstr "잠자리에 들어라. 해가 뜨면 사냥을 재개하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Narrator
#. NodeID = 3c63fd42-8519-6edf-8cea-9f560214d6b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#.     - ORI_Laezel_State_Romance1HadSex = True
#.   Object:
#.     - ORI_HadSexWithLaezel(1) = True
#.     - ORI_HadSexWithCompanion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:3c63fd42-8519-6edf-8cea-9f560214d6b4
msgctxt "h3da8ca67g9a44g4e6agb2e1gc727774c5ca0"
msgid "*You awake in pain. Your back, your hands, even your tongue ache.*"
msgstr "*일어나니 온몸이 쑤십니다. 등, 손, 심지어 혓바닥마저 아려옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 45749471-1dbe-70d3-6d00-3656b3d8be10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:45749471-1dbe-70d3-6d00-3656b3d8be10
msgctxt "h4222a8e8ga15fg4864g8848gb0bc1ce70fbc"
msgid "Have it your way. We depart come dawn, and no later."
msgstr "네 뜻대로 하지. 새벽이 밝으면 떠나자. 더 이상 지체는 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 45f7580f-ac66-be2f-0742-adac170f9c20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:45f7580f-ac66-be2f-0742-adac170f9c20
msgctxt "h4d816ea6gc161g4fd3g818fgfdb1479436db"
msgid "Hold on - I need a moment to recover."
msgstr "잠시만, 회복할 시간이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 4964d2ab-0ba4-3fa2-976a-26f640df7c15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:4964d2ab-0ba4-3fa2-976a-26f640df7c15
msgctxt "h419e57d3g0b2fg4eb2g90e3g4131c42b8ac0"
msgid "It's time to rise. Dawn is upon us."
msgstr "일어날 시간이다. 새벽이 밝았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 4a0469f4-e743-1728-810c-5b90491ee8e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:4a0469f4-e743-1728-810c-5b90491ee8e3
msgctxt "h2258fc36g2de3g41c7g87a6g0b7e14adb6f2"
msgid "<i>Do as she asks. Taste.</i>"
msgstr "<i>그녀가 바라는 대로 한다. 맛본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 4ad52a8a-7805-7ce3-da04-dd50991e356b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:4ad52a8a-7805-7ce3-da04-dd50991e356b
msgctxt "h8aeabd3cg9f45g42b6g8712g8794d040e01c"
msgid "Up, now. Your moment's over."
msgstr "이제 일어나라. 휴식은 끝이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 4b9aab2f-1d9e-74b9-73cc-fdb1ef55598a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:4b9aab2f-1d9e-74b9-73cc-fdb1ef55598a
msgctxt "hc349b38fg782fg4de7gbaa5gc4c07792a103"
msgid "Come back to bed. It's early yet."
msgstr "침대로 돌아와. 아직 시간이 이르잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 4f813599-603f-65fb-930f-bd42bf25737f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:4f813599-603f-65fb-930f-bd42bf25737f
msgctxt "h42918d9ege10dg432bgac32gc1c512a3b11d"
msgid "But I won't give you love."
msgstr "허나 너와 사랑을 나눌 일은 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 50802ed1-948a-a9b0-ed46-07b3e772c21b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:50802ed1-948a-a9b0-ed46-07b3e772c21b
#, fuzzy
msgctxt "hcb0f55a2gf9d1g48d9g8f67g15cc2beb5352"
msgid ""
"Of course you did. I'm as extraordinary in bed as I am on the battlefield."
msgstr "물론 그랬겠지. 난 침대에서도, 전장에서도 뛰어난 전사거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 51ff2578-c609-965f-ef07-eef35c687c36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:51ff2578-c609-965f-ef07-eef35c687c36
msgctxt "hc98de26cgd0a1g4787g9c3egafc10bc4dc22"
msgid "Yes, of course. We will leave at first light."
msgstr "그래, 물론이지. 해가 뜨면 바로 출발하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 5351f32d-8aff-b13c-bba3-5a3be9cff8ff
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - REALLY_DRAGONBORN(1) = False
#.      - REALLY_HALFORC(1) = False
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:5351f32d-8aff-b13c-bba3-5a3be9cff8ff
msgctxt "hd0b5bad8ga10fg4c53ga9a4g2a6c0bb9dc2a"
msgid ""
"You misunderstand. I will not submit to you, but <i>you</i> to <i>me</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 56fba889-57a6-9900-7d2a-7eab5fe11380
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:56fba889-57a6-9900-7d2a-7eab5fe11380
msgctxt "h16ab84d9g0873g42ebgb8aaga9985758c399"
msgid "You made a fine partner. You will be an effective <i>kith'rak</i>."
msgstr "넌 아주 좋은 파트너군. 뛰어난 <i>키스락</i>이 될 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 59ee1d6d-967b-641e-276a-5fe7f380e571
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:59ee1d6d-967b-641e-276a-5fe7f380e571
msgctxt "hefc7416cga014g48feg8dc5gaee7dcb02f4e"
msgid ""
"A final chance, then, to find bliss. Close your eyes. <i>Submit to me.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 5a2c4132-977e-8f05-403d-e2abc9d77291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:5a2c4132-977e-8f05-403d-e2abc9d77291
msgctxt "hd2908571ga4e2g4a02g9f7egb828035c9930"
msgid "Good. Lower."
msgstr "좋아. 더 아래."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 5daf1566-6f85-322e-ab75-66b4078a1374
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:5daf1566-6f85-322e-ab75-66b4078a1374
msgctxt "h65829b60g2210g46f1g9770g76df2ac494c9"
msgid "Hold on. I need a moment to recover."
msgstr "잠시만. 회복할 시간이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 5ec54514-efff-7c05-33dc-162252a4a3bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:5ec54514-efff-7c05-33dc-162252a4a3bb
msgctxt "hd3af4eceg78e8g4f17g8bcfg9d10775cd557"
msgid "<i>Shake off the ache and return to sleep.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 5f38ea64-fbe3-f873-b9fd-310d7e291541
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:5f38ea64-fbe3-f873-b9fd-310d7e291541
msgctxt "hbb3293c3g3056g4f8fgb6dcg7a4e4fea595e"
msgid "Last night was wonderful. I really enjoyed myself."
msgstr "어젯밤은 정말 환상적이었어. 진심으로 행복했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 61ba13a6-b561-1b94-598f-d1dc7c9e6515
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:61ba13a6-b561-1b94-598f-d1dc7c9e6515
msgctxt "h33011e7ag43a0g4731gb27cg0f2ae0e532ff"
msgid ""
"I am sure you learned much from my mastery, Gith-child. Your training "
"continues apace."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 6352bc59-a1cb-68c3-5c5b-5bee0ef63ad7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - REALLY_DRAGONBORN(1) = False
#.      - REALLY_HALFORC(1) = False
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:6352bc59-a1cb-68c3-5c5b-5bee0ef63ad7
msgctxt "h7e31ed75g3abdg46e3g8d93g9c0395f028fd"
msgid "That isn't how it's going to go. <i>You</i> submit to <i>me</i>."
msgstr "아니, 그렇게 두진 않겠어. <i>네가</i> <i>나한테</i> 굴복해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 6536afb9-2c8f-2290-3753-381e79e97969
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:6536afb9-2c8f-2290-3753-381e79e97969
msgctxt "h5828e164gf343g48a2gb22dg45fc70563980"
msgid "<i>Shake off the ache and rise.</i>"
msgstr "<i>고통을 털어버리고 일어난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 6a34c0c3-725e-6733-54f1-fea03297c051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:6a34c0c3-725e-6733-54f1-fea03297c051
msgctxt "h0fb5af0cg218eg474fgaeb2gc4d3dcc951dd"
msgid "No. I've changed my mind."
msgstr "아니. 마음이 바뀌었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 6c608bc5-5243-59c5-3b61-8e6d0bcd44e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:6c608bc5-5243-59c5-3b61-8e6d0bcd44e1
msgctxt "h2d84c70dg59d6g4332gb5c0gb339fa9345e7"
msgid "<i>Close your eyes. You are hers.</i>"
msgstr "<i>눈을 감는다. 당신은 그녀의 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 7530e2ca-f8b2-a2d8-3146-783898c52bd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:7530e2ca-f8b2-a2d8-3146-783898c52bd0
msgctxt "haca21680g5cccg4344g9d0egfcba44ff7941"
msgid "Open."
msgstr "열어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 76c79883-6075-535f-0b79-c329eb86477a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:76c79883-6075-535f-0b79-c329eb86477a
msgctxt "he0b8f0e8gd6e1g42b4ga0bcgf0c73c52475d"
msgid ""
"Time for pleasure has passed. I might take more later, should my whims so "
"carry me."
msgstr "즐길 시간은 지났다. 그럴 마음이 든다면, 다음에 다시 널 안을지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 79065e85-836d-8c22-4123-214613214f77
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:79065e85-836d-8c22-4123-214613214f77
msgctxt "h967e31edg4c9fg4282g9ba6gc309096c7df9"
msgid "I've changed my mind."
msgstr "생각이 바뀌었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 7ec65f8e-3e7c-5f1c-6216-fce9a2e82691
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:7ec65f8e-3e7c-5f1c-6216-fce9a2e82691
msgctxt "h6e7cfe18g0aa6g4e41gb8fcga535c3ce6b7c"
msgid "You would deny yourself further pleasure?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 7f7ec5ba-a978-3360-da9d-f4f173d864df
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#. TagRule: REALLY_DRAGONBORN or REALLY_HALFORC or REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:7f7ec5ba-a978-3360-da9d-f4f173d864df
msgctxt "hccde1cc0gdeb5g490agab3ag75fd25722389"
msgid "No. You submit to <i>me</i>. After, you can take whatever you desire."
msgstr "아니. 네가 <i>나에게</i> 굴복해라. 그러고 나서 원하는 걸 차지해도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 7fbf07ed-ec0d-ee69-a1db-e54e1119aa99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:7fbf07ed-ec0d-ee69-a1db-e54e1119aa99
msgctxt "hc851f8e7g27fcg4a47g973dge610176c31a6"
msgid "You made a fine partner. You will be an effective <i>kith'rak</i>."
msgstr "넌 아주 좋은 파트너군. 뛰어난 <i>키스락</i>이 될 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 7ffbfa02-52e5-afef-54cd-b7e804c714d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:7ffbfa02-52e5-afef-54cd-b7e804c714d4
msgctxt "hc19e9a54gc746g48c7gbb41g6f17fb1ffe94"
msgid "You misunderstand. Allow me to be plain."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 80610cb6-312a-3594-cfdd-d4524372657d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:80610cb6-312a-3594-cfdd-d4524372657d
msgctxt "h64f56b7ag0e2cg49fega3cfg575a51564cd6"
msgid "It is time I take what's mine."
msgstr "이젠 내가 차지할 때다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 870a4f55-d1c2-7420-21c7-b83c64ab19a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:870a4f55-d1c2-7420-21c7-b83c64ab19a9
msgctxt "h195e58cegc0acg4527g9ce3g2eef63be98cb"
msgid "Why in such a hurry? Relax, come rest."
msgstr "왜 그렇게 서둘러? 긴장 풀고, 와서 좀 쉬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 8af41a89-0870-4849-7a88-66aa7922cac3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:8af41a89-0870-4849-7a88-66aa7922cac3
msgctxt "ha0206eb8g7936g45aagbbe9gb6fd1914c126"
msgid ""
"I intend to take my pleasure. Say the word 'no', and you will go untasted."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 8c2f092c-efe2-25f8-5427-65a69c07bd70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:8c2f092c-efe2-25f8-5427-65a69c07bd70
msgctxt "h70a33e7egd467g4771g9e51g2c27e7720bfb"
msgid "You are here for my pleasure."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 8ce3c4ed-aa8d-7d61-cca7-c85ac072928c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:8ce3c4ed-aa8d-7d61-cca7-c85ac072928c
msgctxt "h43ea40c1g8577g4113g89ffg751c10119d3e"
msgid "It's time I return to my bunk."
msgstr "이제 내 침소로 돌아갈 시간이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 8d759c2a-10cd-f8e1-25b2-3b3845d1f734
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:8d759c2a-10cd-f8e1-25b2-3b3845d1f734
msgctxt "hb5fb5e01gfab6g4d37g969eg7358f670ba9d"
msgid "My hunger is sated for now, yes."
msgstr "그래, 당장은 내 굶주림이 채워졌다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 91e9fbdf-c35e-72d3-367d-fd984eca34bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#. TagRule: REALLY_DRAGONBORN or REALLY_HALFORC or REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:91e9fbdf-c35e-72d3-367d-fd984eca34bc
msgctxt "h7fdf8001gbd94g42c9g8cfdg740e26e18ed1"
msgid ""
"You misunderstand. I will not submit to you, but <i>you</i> to <i>me</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 954841c7-b46f-9b4a-2770-bbaa708b4af7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:954841c7-b46f-9b4a-2770-bbaa708b4af7
msgctxt "he95cec4eg872eg461aga431gc21572217a3a"
msgid "Let me show you. Close your eyes - <i>and submit</i>."
msgstr "내가 보여주지. 눈을 감고, <i>내게 굴복해라</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 98824f53-331f-e13b-ec59-0e165af0591a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:98824f53-331f-e13b-ec59-0e165af0591a
msgctxt "h453fe3eege961g4c83gb6abg63eb22aead5e"
msgid "What comes next for us?"
msgstr "이제 우린 어떻게 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = 999af137-b56d-fdb2-403f-96227db85202
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:999af137-b56d-fdb2-403f-96227db85202
msgctxt "h31bcca97gc3a4g4565g99e2g2f50fce91c39"
msgid "Yes. I am yours."
msgstr "그래. 난 네 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = 9abed229-31f9-0495-f473-864fb82f9f14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:9abed229-31f9-0495-f473-864fb82f9f14
msgctxt "h26500e71g09e1g444bg93b7g2cf3d1f279cf"
msgid "Love? I might give you a lay, should my whims so take me."
msgstr "사랑이라? 내가 내킬 때면 다시 잠자리를 같이 할지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = a5eced96-4b96-d1b5-fe89-ab14eba8ba0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DRAGONBORN(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_GoblinHuntCelebration_SD_ROM_NightWithLaezel_State_Happened = True
#. TagRule: REALLY_DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:a5eced96-4b96-d1b5-fe89-ab14eba8ba0a
msgctxt "hb4571cc0g269dg4cdcgbb44g5d47d58b71b9"
msgid "A dragon's heart beats inside you. A dragon's blood heats your flesh."
msgstr "드래곤의 심장이 네 안에 뛰고, 드래곤의 피가 네 살갗을 달구고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = aa60cb6e-b2d1-8fba-caa9-3c50fd20acd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:aa60cb6e-b2d1-8fba-caa9-3c50fd20acd3
msgctxt "h346e5377g017ag453agbd8bg588eec385eb4"
msgid "Very well. Take your moment."
msgstr "좋아. 잠시 쉬어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = b191fe4f-b696-0e3a-c920-81dae29c917f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:b191fe4f-b696-0e3a-c920-81dae29c917f
msgctxt "h339e170fg5ea4g4439g901dgac30aba9e087"
msgid "Taste."
msgstr "맛봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = b5c6dff4-a972-7d9b-b896-80c8bcb50378
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:b5c6dff4-a972-7d9b-b896-80c8bcb50378
msgctxt "h394fa166g5d6ag48e1gb895g15e6e8988c3a"
msgid "It is time you knew mine."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = bac295bc-bd4c-92b2-3d83-89ee942c9ef6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:bac295bc-bd4c-92b2-3d83-89ee942c9ef6
msgctxt "h9d844aebgff9ag4d3bg9064g15529ab54ccd"
msgid ""
"You are a fit specimen. You might wield a silver sword of your own, should "
"Vlaakith be so generous."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = bb65e7e3-c86e-af9a-e19c-f064496fa580
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:bb65e7e3-c86e-af9a-e19c-f064496fa580
msgctxt "h2cf5534dg8352g442bg8f5bg33dd4fe1cf3b"
msgid "<i>Shake off the ache and rise.</i>"
msgstr "<i>고통을 털어버리고 일어난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = be187dfe-6807-952d-11d4-cb4cf69e8a3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:be187dfe-6807-952d-11d4-cb4cf69e8a3c
msgctxt "h94ec95d9ga747g4b26g82d2ge96c3b501b70"
msgid "Are you so offended by truth? You will find no better lay."
msgstr "내 진실이 그렇게도 불편한가? 나만큼 능숙한 자는 없을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = bf21426f-c8f6-ac26-03eb-eb8bd243e9a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:bf21426f-c8f6-ac26-03eb-eb8bd243e9a9
msgctxt "h6196dec8gda1ag437dga127gb8829bc697a1"
msgid "Do you think we could make love again soon?"
msgstr "곧 다시 사랑을 나눌 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = c4963ab2-c2e2-33f0-fd71-c0dea93c9abe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:c4963ab2-c2e2-33f0-fd71-c0dea93c9abe
msgctxt "h17c550fagc4ddg4a1cgac16gb613cd78da6b"
msgid "I might even lay you again, should my whims so take me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = c6d738b3-a643-1890-5a4a-6cfbec8179fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:c6d738b3-a643-1890-5a4a-6cfbec8179fa
msgctxt "hb9c544cdg1f85g4916gbbd2gb81d1c2f0aeb"
msgid "Do you think we could make love again soon?"
msgstr "곧 다시 사랑을 나눌 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = c7376ae1-3ae3-e8f1-b8b9-5e1467f2fe91
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_GoblinHuntCelebration_SD_ROM_NightWithLaezel_State_Happened = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:c7376ae1-3ae3-e8f1-b8b9-5e1467f2fe91
msgctxt "h5a80cc6egbcd7g4cf6g9383g941b34669edf"
msgid ""
"You are a child of Gith. You train relentlessly. You know your body inside "
"and out."
msgstr "너는 기스의 아이다. 너는 끊임없이 훈련하지. 너는 자신의 몸을 안팎으로 잘 알고 있을 터."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = c7376ae1-3ae3-e8f1-b8b9-5e1467f2fe91
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_GoblinHuntCelebration_SD_ROM_NightWithLaezel_State_Happened = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:c7376ae1-3ae3-e8f1-b8b9-5e1467f2fe91
msgctxt "h67e9aaf9g1b62g4a88g938bgb0614240f17a"
msgid "Gith train relentlessly. We know our bodies inside and out."
msgstr "기스는 끊임없이 훈련한다. 우리는 자신의 몸을 안팎으로 잘 알고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = c8805ec9-31d5-0b06-d21b-7c2a8f4ff7a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:c8805ec9-31d5-0b06-d21b-7c2a8f4ff7a2
msgctxt "h4072a46dg53c6g4216g9039ge219c134667f"
msgid ""
"'Next'? We seek purification. I might even lay you again, should my whims so "
"take me."
msgstr "'다음'? 정화를 찾아야지. 그럴 기분이 든다면, 널 다시 안을 수도 있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = ca4feca5-3170-90be-74f0-ecb224e43da9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:ca4feca5-3170-90be-74f0-ecb224e43da9
msgctxt "h348497dag2a47g4019g8e3dga04d1fbeba65"
msgid "Enough. I want no more of this."
msgstr "그만. 이제 못하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = cde40ec5-a073-66b1-bbf4-66efac74d883
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:cde40ec5-a073-66b1-bbf4-66efac74d883
msgctxt "h91245bf4gb88cg49d7gb36fg0f675c59bce1"
msgid "Good night, then."
msgstr "그럼, 잘 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = ced99db5-18c0-22dc-09f3-c742b07c9443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:ced99db5-18c0-22dc-09f3-c742b07c9443
msgctxt "h9f9f8e9agda60g4f49gab67gc87e4c008155"
msgid "Up, now. The sun soon rises."
msgstr "이제 일어나라. 곧 해가 뜬다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = cf3ab63e-ee1f-e521-e4e5-dc2b1006e1c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:cf3ab63e-ee1f-e521-e4e5-dc2b1006e1c9
msgctxt "h964fa680gf228g4e92g9ba8g0415167fbfc5"
msgid "Do you think we could make love again soon?"
msgstr "곧 다시 사랑을 나눌 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = cf77932a-1d99-55c0-7fee-ed1257da3ba4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:cf77932a-1d99-55c0-7fee-ed1257da3ba4
msgctxt "hc216837egdfcdg4d1dg9d02ge3acd09a4b57"
msgid "<i>Grimace at her arrogance.</i>"
msgstr "<i>그녀의 오만에 얼굴을 찌푸린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = d258342e-5716-5c60-6872-b57013173777
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:d258342e-5716-5c60-6872-b57013173777
msgctxt "hbf904029g8482g4d50g9df2gde0f6863577e"
msgid "What comes next for us?"
msgstr "이제 다음은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = d29c5fc8-e34b-1b2e-6a32-0452ed67c540
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:d29c5fc8-e34b-1b2e-6a32-0452ed67c540
msgctxt "h7e66e683gbbd4g44bagb10eg42ed53b83d65"
msgid "Are you satisfied as well?"
msgstr "너도 만족스러워?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Narrator
#. NodeID = d3c6b5be-f7c5-9c3a-7eaf-d35278684301
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:d3c6b5be-f7c5-9c3a-7eaf-d35278684301
msgctxt "h5230edcdg8d3fg4cabg88d2g7d3db400219a"
msgid "*Every breath, every blink proves exhausting. A long day awaits you...*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = d70cf2fa-d2de-8c5d-3dd1-f011e08aa545
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:d70cf2fa-d2de-8c5d-3dd1-f011e08aa545
msgctxt "h90cf173dg27f2g4414ga8b4g39401b68099e"
msgid "Why in such a hurry? Relax, come rest."
msgstr "왜 그렇게 서둘러? 긴장 풀고, 와서 좀 쉬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = d898e45b-fcd7-3046-b90d-3ee43357cc9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:d898e45b-fcd7-3046-b90d-3ee43357cc9b
msgctxt "hd06d81c6g7738g4776g95d5g02ded7bf590b"
msgid "Tonight was wonderful. I really enjoyed myself."
msgstr "오늘 밤은 아주 환상적이었어. 정말 즐거웠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = dab13a53-02f6-9c9a-78c7-63962cb7e19f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:dab13a53-02f6-9c9a-78c7-63962cb7e19f
msgctxt "h99a499f5g279fg4d8cga4c4gc41b7400da61"
msgid "I am ready."
msgstr "준비됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = e2025e87-4d96-5aee-ab3d-2ff3e34fa38d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:e2025e87-4d96-5aee-ab3d-2ff3e34fa38d
msgctxt "hc80497bfg2a82g4361g9eebgae3436c9ea70"
msgid "Tell me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = e2e86e25-d222-bc21-8691-3e0ea6d02910
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:e2e86e25-d222-bc21-8691-3e0ea6d02910
msgctxt "heb8af2f7gd0c5g47b6g8e45g7ddbcaa9b25e"
msgid "<b>Make me submit. SHOW ME YOUR RAGE.</b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = e2e86e25-d222-bc21-8691-3e0ea6d02910
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:e2e86e25-d222-bc21-8691-3e0ea6d02910
msgctxt "h759ac96dgc2d2g490dgbf7fga715b5895270"
msgid ""
"I do not submit. And I don't want submission from you. Show me your rage."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = e33a39da-83de-5b82-5eea-5498bfda2790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:e33a39da-83de-5b82-5eea-5498bfda2790
msgctxt "h544812c4g2a51g4330ga20fg397e846427f8"
msgid "Are you satisfied as well?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = e794e3fb-36c0-c193-e871-18ab90627587
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:e794e3fb-36c0-c193-e871-18ab90627587
msgctxt "h9eed57a7g4a3dg4c55gbe75g77e9df21d1ff"
msgid "<b>YES.</b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = e794e3fb-36c0-c193-e871-18ab90627587
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:e794e3fb-36c0-c193-e871-18ab90627587
msgctxt "h72de678bgbb57g4c65g8680g9c980cba4e97"
msgid "Yes, damn it!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = edf0dc76-df22-05d0-aed8-0da4bea39ec0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:edf0dc76-df22-05d0-aed8-0da4bea39ec0
msgctxt "h14ebd05aga648g452fgbfe4gdbd331563058"
msgid ""
"<i>Put your previous confrontation with Lae'zel out of your mind. Give in to "
"her demand.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = f7eca517-cb4e-b381-45c3-5bd1f27ca60a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:f7eca517-cb4e-b381-45c3-5bd1f27ca60a
msgctxt "hd7814cb9g7343g4a4eg96f6g65cf2b009ead"
msgid "In my pleasure, you will have yours."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Lae'zel
#. NodeID = fc4d6d6e-15f6-a89c-646c-6d4b9e01d375
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingLaezel(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:fc4d6d6e-15f6-a89c-646c-6d4b9e01d375
msgctxt "h8dc107dcg2202g44dcgb400g0071630e6ace"
msgid "And you will take your rest alone."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Player
#. NodeID = feb869ad-7dd0-5b92-c122-7655f2547dca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:feb869ad-7dd0-5b92-c122-7655f2547dca
msgctxt "h30fdc3dbg0485g4719g81f1g7f9943132de4"
msgid "Come back to bed. It's not morning yet."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel
#. Speaker = Narrator
#. NodeID = ff3f022b-ae3d-6b6f-c9b7-f45231e06443
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#.     - ORI_Laezel_State_Romance1HadSex = True
#.   Object:
#.     - ORI_HadSexWithLaezel(1) = True
#.     - ORI_HadSexWithCompanion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_GoblinHuntCelebration_SC_NightWithLaezel:ff3f022b-ae3d-6b6f-c9b7-f45231e06443
msgctxt "h9df4ca1eg5937g4aa6g9031g8eccc52ac61a"
msgid "*You awake in pain. Your back, your hands, even your tongue ache.*"
msgstr "*일어나니 온몸이 아픕니다. 등, 손, 심지어 혓바닥까지.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic
#. Speaker = Shadowheart
#. NodeID = 294e2f70-23d5-86bb-72c2-eac8bd279ca3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_ShadowHeart_Knows_WildMagic = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Shadowheart_CRD_WildMagic:294e2f70-23d5-86bb-72c2-eac8bd279ca3
msgctxt "hfe0cd963g86e4g4b30gbc88g262b29306d94"
msgid "Something's wrong. I feel... I feel..."
msgstr "뭔가 이상해. 느낌이... 이건..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Narrator
#. NodeID = 2873e67a-c690-45f6-bc82-7b0d6be9d996
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_ShadowHeart_Knows_WildMagic = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:2873e67a-c690-45f6-bc82-7b0d6be9d996
msgctxt "h35272fccg30ffg4cfbgb44bg82d602f402cf"
msgid ""
"*The day is over at last. Rest awaits... yet you cannot shake the sensation "
"that something is <i>off</i>.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Narrator
#. NodeID = 375c7d7e-cea0-4a5d-8442-b507958d3fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:375c7d7e-cea0-4a5d-8442-b507958d3fc6
msgctxt "hc88c6745g4a20g4456ga611g01b86406ad79"
msgid ""
"*But was it truly <i>nothing?  </i>The pain gripped you tight, robbing you "
"of all composure for a moment...*"
msgstr "*하지만 정말 <i>아무 것도</i> 아니었을까요? 고통은 당신을 꽉 휘어잡았고, 한순간 평정심을 잃을 정도였습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Player
#. NodeID = 4a0eab75-aa55-4239-b6b4-79d7bfe48d62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:4a0eab75-aa55-4239-b6b4-79d7bfe48d62
msgctxt "hfbad9509gb507g424fgabe6g67510544c7c2"
msgid "<i>It was nothing. Put it out of your mind.</i>"
msgstr "<i>아무 일도 아니었다. 마음 속에서 치워 버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Narrator
#. NodeID = 99260b47-2faa-4350-961f-96bb33086ab2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:99260b47-2faa-4350-961f-96bb33086ab2
msgctxt "haab9dbaagab2cg421agbb4fgc7f43ce4b8d1"
msgid "*She offers you nothing.*"
msgstr "*여신은 아무 것도 내려 주지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Narrator
#. NodeID = 9e868753-8332-4251-a083-70d2c0a79a0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:9e868753-8332-4251-a083-70d2c0a79a0c
msgctxt "heeb05069g8d25g4f05g9730gef401eecd221"
msgid ""
"*Is Lady Shar punishing you? Or perhaps testing you? Is it the tadpole, or a "
"curse? You cannot say.*"
msgstr ""
"*샤 여신님이 당신을 벌하고 있는 걸까요? 아니면 시험하고 있는 걸까요? 올챙이 때문일까요, 아니면 저주 때문일까요? 당신은 대답하지 "
"못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Narrator
#. NodeID = a38758a9-4dcd-459c-a704-b1152b9b5223
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:a38758a9-4dcd-459c-a704-b1152b9b5223
msgctxt "hc04107d9g69dfg425cg8644g2dad416200dd"
msgid ""
"*In any case, you must persevere without question. The Dark Lady will reveal "
"all to you, when the time is right.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Player
#. NodeID = a82f56d0-b75c-49ba-a0b4-fe7dc5993075
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:a82f56d0-b75c-49ba-a0b4-fe7dc5993075
msgctxt "h6a81c08dg7471g44ceg9e28ge86ffafa9442"
msgid "<i>Try to understand what's happening.</i>"
msgstr "<i>무슨 일이 일어나는지 이해하려 애쓴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Narrator
#. NodeID = b1327f5a-6744-4740-950a-ca785c4f4e87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#.     - Shadowheart_InParty_SharWorshipper_QuestioningAvailable = True
#.     - ORI_Shadowheart_Knows_IncurableWound = True
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:b1327f5a-6744-4740-950a-ca785c4f4e87
msgctxt "h334ac280gddc3g42bcgbe65gc513a9761173"
msgid ""
"*Intense pain blossoms from the wound on your hand, throughout your whole "
"body. A fragmented image comes to you - a hooded figure, admonishing you for "
"resting.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD
#. Speaker = Player
#. NodeID = d4e87b11-5fe3-4f57-84c3-24b492f5cd37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Sleep_Cutscenes/CAMP_Shadowheart_WildMagic_SD:d4e87b11-5fe3-4f57-84c3-24b492f5cd37
msgctxt "hdca05e4bg3616g4da9gac12g6d38698e7c37"
msgid "<i>Silently petition Lady Shar for guidance.</i>"
msgstr "<i>조용히 샤 여신의 인도를 청원한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = 002b1f47-c398-f241-0633-f7baa52a0696
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:002b1f47-c398-f241-0633-f7baa52a0696
msgctxt "h6cde36ffg8fe2g4a42g9a70g1d87346a0849"
msgid "All right, but it's very much your loss."
msgstr "그래 좋아, 하지만 그건 네 손해지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = 0a2ee55c-dbbd-c650-4a26-c5cb73d5aff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:0a2ee55c-dbbd-c650-4a26-c5cb73d5aff1
msgctxt "hac2532e4gf010g483fga2adg260230ed827a"
msgid "Of course, only if you want to."
msgstr "물론, 네가 원하면 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = 1376b936-296a-9c37-3848-2d86b94e6591
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:1376b936-296a-9c37-3848-2d86b94e6591
msgctxt "h3513fc98g45b4g4edfg8af9g1c9831893aec"
msgid "Actually, maybe not."
msgstr "사실, 아닐지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = 15505c32-af1a-87b8-3b00-7eb24b440ce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:15505c32-af1a-87b8-3b00-7eb24b440ce3
msgctxt "h7812e6f3ge60eg45d9gbad6g712fdbce0898"
msgid "I'm not sure..."
msgstr "잘 모르겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = 31dd0824-0a46-42a5-bcf0-b216ae83a369
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:31dd0824-0a46-42a5-bcf0-b216ae83a369
msgctxt "h3a83845bg1a2cg4ac6g8bd9g879ce70a46c6"
msgid ""
"A quiet evening, for once. Perfect for two people who'd like to take some "
"time to themselves, if you catch my meaning."
msgstr "드디어, 조용한 저녁이 왔네. 혼자만의 시간을 갖고 싶은 두 사람에게 안성맞춤이야, 내 말이 무슨 뜻인지 알아챘다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = 42d22f4d-b06c-157c-90be-6b223786c233
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:42d22f4d-b06c-157c-90be-6b223786c233
msgctxt "h53267790gf469g4b4cg8d75g50258fc3963d"
msgid "Excuse me? After everything you said before?"
msgstr "뭐라고? 조금 전에 그렇게 말해 놓고서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = 50fbd23d-47b8-f2ec-fc00-232f5ba82fd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:50fbd23d-47b8-f2ec-fc00-232f5ba82fd8
msgctxt "h472306dfg45eag4267g944bg2aedae6fd6fa"
msgid "But trust me - you do want to."
msgstr "하지만 믿어 봐. 너도 하고 싶잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = 557ca186-84cd-b8d2-a631-b7b53c7631ad
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Astarion_Event_PlayRomance1_AfterCelebration(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:557ca186-84cd-b8d2-a631-b7b53c7631ad
msgctxt "hb4323928g6d1cg4688g96cdg9d549210fb3b"
msgid "I'll see you there."
msgstr "거기서 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = 58e9652e-21da-4b27-8a4f-227d32b8b552
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:58e9652e-21da-4b27-8a4f-227d32b8b552
msgctxt "h5303d8c9g2863g4bb3g81b5gfb74a82b9682"
msgid "I'd rather not, honestly."
msgstr "솔직히 말해서, 안 하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = 5b4bfafa-4ba4-7d8a-78d4-ad3ffec2a478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:5b4bfafa-4ba4-7d8a-78d4-ad3ffec2a478
msgctxt "he8f00ea9gb898g4349gbca0g83c659c85c24"
msgid "Indeed you will, my love. I can't wait."
msgstr "물론 그럴 거야, 내 사랑. 정말 기대되네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Player
#. NodeID = ba1e248c-fcdf-4741-90ee-383ea32e96cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:ba1e248c-fcdf-4741-90ee-383ea32e96cb
msgctxt "hced29df9g3129g4c00gbd94g570f2f3d8f6c"
msgid "All right, but where will we go?"
msgstr "좋아, 하지만 어디로 가지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = bace01f6-e4a7-4c7c-2790-974efdccb866
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:bace01f6-e4a7-4c7c-2790-974efdccb866
msgctxt "hb3dd7885gf4f1g4272g9126g08d43a03c6e2"
msgid ""
"Let's find our own little piece of nowhere. Somewhere we can lose ourselves "
"and forget all this madness."
msgstr "우리만의 작은 공터를 찾아보자. 자신을 잃고 이 광기를 전부 잊어버릴 수 있을 만한 곳 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = bdbed00e-cfc4-4016-98a0-df4ff7166519
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:bdbed00e-cfc4-4016-98a0-df4ff7166519
msgctxt "hd576de60g9027g4941g9b63gc94763ba2941"
msgid ""
"There's a secluded place nearby that should do nicely. Wait until the others "
"are asleep, then come and find me there."
msgstr "근처에 한적한 곳이 있어. 다들 잠들 때까지 기다렸다가, 날 찾으러 오도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation
#. Speaker = Astarion
#. NodeID = ed150691-9ff1-e5d9-80b7-811e0b0a41e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_Romance1_SD_Invitation:ed150691-9ff1-e5d9-80b7-811e0b0a41e0
msgctxt "he4a75692g5970g41c7g8555ga9386d1d4d72"
msgid "And I do mean sex, to be clear. We've been waiting long enough."
msgstr "확실하게 말하자면, 섹스를 말하는 게 맞아. 우리 충분히 오랫동안 기다렸잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 00e56c01-50ed-6101-8063-5aa933b2e8d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:00e56c01-50ed-6101-8063-5aa933b2e8d0
msgctxt "ha7b437a3g3fd9g40ffga18cg4fbdfe6eaca6"
msgid ""
"I'd love to be closer to you, Astarion, but until my heart is fixed, it's "
"too dangerous."
msgstr "더 가까워지고 싶지만, 아스타리온, 내 심장이 고쳐지기 전까진 너무 위험해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 01496c71-adae-4f12-87d7-c07fd49e610d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:01496c71-adae-4f12-87d7-c07fd49e610d
msgctxt "h8d6efd67ga6f0g4b8fgb10cg53d13a88060d"
msgid "Come, give yourself to me."
msgstr "이리 와, 내게 몸을 맡겨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 0418efe9-c8fb-5ee6-9a15-911ef8125b4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0418efe9-c8fb-5ee6-9a15-911ef8125b4b
msgctxt "h18583957gff53g47c5g87c7ge6dbd340807f"
msgid ""
"It would mean your salvation. Your eternity, despite that thing inside you."
msgstr "이건 네 구원을 의미해. 네 안의 그게 있는데도, 영원을 가질 수 있는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 043b0e6e-9efc-f748-4789-10bb761f46cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:043b0e6e-9efc-f748-4789-10bb761f46cb
msgctxt "hced3ac1egcddfg46d5gadabg9edae47d1020"
msgid "Are you ready to join me? To accept this immortal gift?"
msgstr "나와 함께 할 준비가 됐어? 영원의 선물을 받아들일 준비가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 04b69801-89b5-7659-aac4-60d334c56edc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:04b69801-89b5-7659-aac4-60d334c56edc
msgctxt "h9429b1a3gfe22g4634ga5c2g29492037fe8f"
msgid "I don't feel great about it, honestly."
msgstr "솔직히, 그렇게 기분이 좋지는 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 07c84acb-022f-4fca-768d-26d67c350040
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:07c84acb-022f-4fca-768d-26d67c350040
msgctxt "hebcdd7b9g3ae3g4524ga950ga374add1e250"
msgid "You know, I didn't care for you when we first met."
msgstr "있지, 처음 만났을 때 널 안 좋아했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 0a7354c7-2823-7e95-e212-e674269775b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0a7354c7-2823-7e95-e212-e674269775b3
msgctxt "hf355dcc9gd554g4573g8ec1gce7cf80746ff"
msgid "I'm not sorry I killed him."
msgstr "놈을 죽인 걸 후회하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 0c1ddfdb-7741-d218-d93c-13367e400858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0c1ddfdb-7741-d218-d93c-13367e400858
msgctxt "h0861d8abg85dag4314g9109g1a860f2982f9"
msgid ""
"I'm glad I still have the power to surprise you. Even if it's the only power "
"I have left."
msgstr "아직 널 놀라게 할 힘이 남아있어서 다행이야. 그게 마지막이었지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 0cf5b361-d8d2-9f62-47cb-46a6b765cff4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0cf5b361-d8d2-9f62-47cb-46a6b765cff4
msgctxt "h80255de6gc964g4487g9f1bg1fec16d82bf2"
msgid ""
"Until then, you can enjoy my company. You can benefit from my power. But you "
"will not be in my heart."
msgstr "그때까지는, 나와 함께 하는 걸 즐겨도 좋아. 내 힘을 맘껏 사용해도 좋고. 하지만 내 마음속에 넌 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 0d3c1255-f252-667e-9c5c-326ca7dbd59a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0d3c1255-f252-667e-9c5c-326ca7dbd59a
msgctxt "he7ac9e64gedbbg4b36g9542ge47b363d49f4"
msgid "So why not focus on the tadpoles? They're our biggest problem."
msgstr "그러면 이제 올챙이에 집중하는 건 어때? 우리가 가진 가장 큰 문제잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 0e8cc877-bfba-c813-07b5-79cacf20a685
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0e8cc877-bfba-c813-07b5-79cacf20a685
msgctxt "h667bcad0g76bcg4fc2ga188gbe505c0555b4"
msgid "<i>Explore his mind - see what he really thinks about you.</i>"
msgstr "<i>그의 생각을 읽어본다. 아스타리온이 정말로 당신에 대해 어떻게 생각하는지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 0f06502a-fd26-f001-88d2-10c26ed79116
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0f06502a-fd26-f001-88d2-10c26ed79116
msgctxt "hbeb08c9fg91ccg4abagafcag696493c34ab7"
msgid "Unless we die horribly tomorrow. Which is always a strong possibility."
msgstr "적어도 우리가 내일 끔찍하게 죽지 않는 이상 말이야. 그럴 가능성이 높거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 0f18c70a-5ebf-20cd-6341-cf03199a3d6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0f18c70a-5ebf-20cd-6341-cf03199a3d6c
msgctxt "hd7cdec40g2942g4113gbdbbgc11561d8d126"
msgid "We don't have to rush into anything tonight."
msgstr "오늘 밤에 당장 뭘 하겠다고 서두를 필요는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 0faf1d83-cbbe-0fe9-132a-fa8d82577631
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:0faf1d83-cbbe-0fe9-132a-fa8d82577631
msgctxt "h99da73e4g55f9g463egbfa6g985540dc649a"
msgid "I know. That doesn't mean it stings any less."
msgstr "알아. 하지만 그렇다고 해서 아쉬움이 덜하지는 않지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 110dccbc-7514-5edd-df60-9df5ba31d858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:110dccbc-7514-5edd-df60-9df5ba31d858
msgctxt "h6e35a7f3ga3d7g43e5gafe4g3c1c00901ea8"
msgid "<i>Hold back for a moment.</i>"
msgstr "<i>잠시 멈춘다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 1153de5d-b19b-1f6a-74e0-e80c496cd3ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1153de5d-b19b-1f6a-74e0-e80c496cd3ba
msgctxt "h2e126ed3gefa8g497cga272g1f5729092974"
msgid "A beloved slave is still a slave."
msgstr "사랑받는 노예도 여전히 노예인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 11980d2f-68b6-fb87-cdc5-2e3fecf3acbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:11980d2f-68b6-fb87-cdc5-2e3fecf3acbb
msgctxt "hbf423932g870ag4ca9ga198ga9ae076544bc"
msgid ""
"That's what you've been waiting to hear, isn't it? That's what you want?"
msgstr "네가 듣고 싶었던 말이지? 이게 네가 원하는 거고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 12bbc84e-e5fc-acec-09dd-0a920adafabc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:12bbc84e-e5fc-acec-09dd-0a920adafabc
msgctxt "h934e218dg3ab2g4ea4g9eacg9b8e8c0db2a5"
msgid "Own your body, kill your mind."
msgstr "몸을 지배하고, 마음을 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 1497580e-4091-01c2-bc18-bf09f69f5754
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1497580e-4091-01c2-bc18-bf09f69f5754
msgctxt "hde3dbeb3gf1c5g4972gb2c0g70b9accf71f4"
msgid "Perhaps. But it'd be worse again to pretend it never happened."
msgstr "그렇겠지. 하지만 그런 일이 없었던 것처럼 행동하면 더 안 좋아질 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 151aabf4-6eb2-b698-42b1-7557250f6999
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:151aabf4-6eb2-b698-42b1-7557250f6999
msgctxt "hd4eb01edg3491g4689g8732g77278d305871"
msgid ""
"Cazador took up so much room in my life - my memories of him, my need for "
"revenge. Now there's just a blank space where he used to be."
msgstr ""
"카사도어는 내 삶에서 너무 많은 부분을 차지했어 - 그에 대한 기억, 복수에 대한 욕구 같은 거. 놈이 사라지니 그 자리는 텅 비어버렸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 15e2c200-3370-74d7-0246-ff0d6f64f1d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:15e2c200-3370-74d7-0246-ff0d6f64f1d5
msgctxt "h5f9e69fcg2cd7g4369gb9fbgca9464919a0f"
msgid "Perhaps, but some things are classics for a reason."
msgstr "그럴지도, 하지만 어떤 것들은 고전인 이유가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 191357fc-ffd1-72a9-02cf-7798964d9d30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:191357fc-ffd1-72a9-02cf-7798964d9d30
msgctxt "h286ba977g2cc1g4fa4g9855ga29905062a90"
msgid "Yes."
msgstr "꿇어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 19a630cc-dbf1-edca-fd17-ec1b890d1418
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:19a630cc-dbf1-edca-fd17-ec1b890d1418
msgctxt "ha82b12a5gde66g449bgbb10g9b0e4a113c3c"
msgid ""
"That's... interesting. I might even say I like it. And as for you and me, "
"well, I'm willing to wait."
msgstr "그건... 흥미롭네. 맘에 든다고 말할 수도 있겠어. 그리고 너와 나에 관해선, 음, 기꺼이 기다릴 의향도 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 1a304f63-662d-0e14-9e60-be11f330d45c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1a304f63-662d-0e14-9e60-be11f330d45c
msgctxt "h1a7fc9adgc249g461cga3afg86cc75d8d967"
msgid "I still care for you, but it can't be like this."
msgstr "난 여전히 널 아끼지만, 이런 식으로는 할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 1a5280f9-72cf-6302-2195-935d5ba96a21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1a5280f9-72cf-6302-2195-935d5ba96a21
msgctxt "h7689f367g9405g4307ga885g74732450d6db"
msgid "We shall not. I just need you to bite me."
msgstr "그러지 말고. 넌 그냥 날 물면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 1ba64e1d-45c5-83b6-cfd5-8cca61feba75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1ba64e1d-45c5-83b6-cfd5-8cca61feba75
msgctxt "h2f87f5bagd245g4864gaeafg0dad7f0acdec"
msgid "I'll have to. But that doesn't mean I have to like it."
msgstr "수용해야겠지. 하지만 그렇다고 해서 내가 만족해야 한다는 뜻은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 1c659e7d-0fbb-582a-f8a7-653dd20ac62b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1c659e7d-0fbb-582a-f8a7-653dd20ac62b
msgctxt "h07aebc63g3145g4937gbc9bg3e5e4e2f3665"
msgid "No."
msgstr "싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 1db2de42-c256-9f39-e808-d1b9ad4eb49e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1db2de42-c256-9f39-e808-d1b9ad4eb49e
msgctxt "hba25153ag0de4g4068gb285gf82c4046ebac"
msgid "I wanted a powerful ally. And now I have one."
msgstr "난 강력한 아군이 필요했어. 그리고 이제 하나를 얻었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 1dfff3da-06a0-7798-4ee3-fdec83175993
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:1dfff3da-06a0-7798-4ee3-fdec83175993
msgctxt "h8bf576e7ge35bg45ffgacf8g08b67b74a014"
msgid ""
"But if you want the gift of eternity, I can give you that. One more bite is "
"all it would take."
msgstr "하지만 영원의 선물을 받고 싶다면, 내가 줄 수 있어. 한 입만 더 물면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 218a70c9-3444-d8af-40c7-a09609a56fe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:218a70c9-3444-d8af-40c7-a09609a56fe1
msgctxt "h0d993d99gd04fg4b36gbf9dgc3c99fa628a4"
msgid "And you will! All in good time."
msgstr "그렇게 될 거야! 때가 되면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 228dc5ad-1843-5412-8acb-d3cbddd9c7f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:228dc5ad-1843-5412-8acb-d3cbddd9c7f0
msgctxt "h663a24a9g6c8cg4581g8575g4bb20b5f532d"
msgid "No, let's do this."
msgstr "없어, 해보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 23519e41-df9f-f66a-e426-e00a8f73e2cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:23519e41-df9f-f66a-e426-e00a8f73e2cd
msgctxt "hce78d131gfee9g4bf6gb821g28a5076e5bdf"
msgid "I thought you'd never ask."
msgstr "안 물어보면 서운할 뻔했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 2575abec-3c68-5631-049d-62ad08466dbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2575abec-3c68-5631-049d-62ad08466dbb
msgctxt "hd2e5a840g6c8ag452bg88c6g0cffd360fc8f"
msgid "I don't want this after all."
msgstr "이런 거, 원하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 27cc5f27-abf4-0c2e-18b5-6af8eba5fc2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:27cc5f27-abf4-0c2e-18b5-6af8eba5fc2a
msgctxt "h8e2182f9gd573g4b80gaec6g44f091aaf3d5"
msgid "I have been waiting so long for you."
msgstr "널 너무 오랫동안 기다렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 27da573f-c178-6af3-01cd-17f814dc021f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:27da573f-c178-6af3-01cd-17f814dc021f
msgctxt "h95459751g194bg4789g8c81g97e627d1fc4b"
msgid "Meaning...?"
msgstr "무슨 뜻이야...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 284741c3-7020-760f-8b42-964f070ce199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:284741c3-7020-760f-8b42-964f070ce199
msgctxt "h21c8ccd5g01f6g4b46gace7g63fc4e26383a"
msgid ""
"And you could be so much more, if you want it. One little bite and you could "
"be mine forever."
msgstr "네가 원한다면, 그 이상의 존재가 될 수도 있어. 한 번만 물면 넌 영원히 내 것이 되는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 28b9c662-aa48-d9f3-b7d3-fe15e656fdc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:28b9c662-aa48-d9f3-b7d3-fe15e656fdc5
msgctxt "ha765dab1g56c8g4d9dgb19cg17aab50f88fe"
msgid ""
"Well, what's done is done. And there's simply no point in dwelling on the "
"past, is there?"
msgstr "뭐, 지나간 건 지나간 거지. 그리고 굳이 과거에 연연할 이유는 없잖아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 28f04df2-f7d6-c904-4943-323b5cd05173
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:28f04df2-f7d6-c904-4943-323b5cd05173
msgctxt "h062d905bg6cb1g497dg9a2cg72e5a333a641"
msgid "But make no mistake, I will forever remember what you did for me today."
msgstr "하지만 실수하지 말아줘, 네가 오늘 나를 위해서 한 일을 나는 영원히 기억할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 29254454-6028-0d26-c008-391f040ed960
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:29254454-6028-0d26-c008-391f040ed960
msgctxt "h2b306d5cg0ae1g48ffga268g726ff16d45cc"
msgid "Oh don't be such a humourless little wretch - it's nothing but a joke."
msgstr "오 그렇게 재미없는 애송이처럼 굴지 마 - 농담일 뿐이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 294403af-1b62-c0e1-889a-28148a62dde4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:294403af-1b62-c0e1-889a-28148a62dde4
msgctxt "ha7500bbfgdbd6g4eb9gb1e1gcd554da44414"
msgid "Well. I should probably fix this."
msgstr "좋아. 그럼 이걸 고쳐야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 29b23779-ab34-9072-1139-c6dd0c4775e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:29b23779-ab34-9072-1139-c6dd0c4775e3
msgctxt "h0a3f73b6g1d73g4ba0g87e6gf7d2722dfd4a"
msgid "Then it's everything you shall recieve."
msgstr "너는 그 전부를 받게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 2a12ee3b-7322-7944-4abf-0efcfc8ef8e0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2a12ee3b-7322-7944-4abf-0efcfc8ef8e0
msgctxt "h34fd8ebag7210g42a5g9687gdb470203d78b"
msgid "You want to live forever, don't you? To be mine, forever?"
msgstr "영원히 살고 싶지 않아? 영원히, 내 것이 되고 싶지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 2a12ee3b-7322-7944-4abf-0efcfc8ef8e0
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2a12ee3b-7322-7944-4abf-0efcfc8ef8e0
msgctxt "h040dbc10g2d79g438bgb045g1f77a9328cd3"
msgid "That's what you want, isn't it? To be mine? Forever?"
msgstr "네가 원하는 거잖아, 안 그래? 영원히 내 것이 되는 거?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 2a6bbdb9-3d20-935c-d236-ce125f3b9579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2a6bbdb9-3d20-935c-d236-ce125f3b9579
msgctxt "h920323aeg64afg4f98g959bg8e1910518256"
msgid "Of course. That... that would mean a lot."
msgstr "그, 그래. 정말... 정말 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 2c531a4e-95dd-694e-c7e1-afa9d17abfde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2c531a4e-95dd-694e-c7e1-afa9d17abfde
msgctxt "h45386cfagf7f8g400bgab11gf52979c945ff"
msgid "You haven't learned anything, have you?"
msgstr "배운 게 아무것도 없구나, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 2caa1b32-d3db-44b8-1cd4-46b120d6bb0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2caa1b32-d3db-44b8-1cd4-46b120d6bb0d
msgctxt "h2e8de0b6g016ag447dgb1b3ge9d8f271d3d4"
msgid "Then stop joking around and let's sleep together."
msgstr "그럼 농담 따먹기는 그만하고 같이 자기나 하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 2e0aa876-e8db-b37f-b409-9a5da1cc76db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2e0aa876-e8db-b37f-b409-9a5da1cc76db
msgctxt "h8fe2fa87g78b9g469cga93fg44fb6a1fa985"
msgid "<i>Please, </i>yes."
msgstr "<i>제발, </i> 그러자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 2e8e532a-3cd5-5284-c194-26e419c1537d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2e8e532a-3cd5-5284-c194-26e419c1537d
msgctxt "h64c1915bg4ed3g4965ga0a6g8c7e78f70e33"
msgid "Huh. I forgot I'd be cold to the touch once I changed..."
msgstr "허. 변하면 이런 스킨십에 감흥이 없어질 거라는 걸 잊고 있었네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 2ecfb812-187f-1e6e-d1bc-233bcabff702
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - ORI_Astarion_Event_BlackMassAftermathHadSexAsEquals(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2ecfb812-187f-1e6e-d1bc-233bcabff702
msgctxt "h336d8705g5992g45d0g963bge3f3c5adccb0"
msgid "I love you. I love this. And I want it all."
msgstr "널 사랑해. 이걸 사랑해. 모든 걸 갖고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 2ef1889d-8f22-86ca-25b7-40f612e68660
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:2ef1889d-8f22-86ca-25b7-40f612e68660
msgctxt "h826ed185g4f34g4e15gb5e1ge72691c6c7ff"
msgid "Because I cared! But maybe now I see how wrong I was."
msgstr "널 생각했으니까! 하지만 이제 그게 얼마나 틀렸는지 알겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 3318f81c-bec7-c211-220b-6b01abfc46b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3318f81c-bec7-c211-220b-6b01abfc46b1
msgctxt "hbb7c648fgd5b5g4c78g9609g6479310a71df"
msgid ""
"Your hands are bloody as mine, darling. Why would you go along with any of "
"this just to pretend you're innocent now?"
msgstr "네 손도 나만큼 피투성이야, 자기. 왜 지금 와서 결백한 척 아무 상관 없다는 듯이 말하는 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 336db7af-b101-d2d5-8342-cdbff5240664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:336db7af-b101-d2d5-8342-cdbff5240664
msgctxt "h37038d4dg72f2g4bafgbe3fg5a5f3539b818"
msgid ""
"And now you think you can stand there and tell me how to feel? Because - "
"what? Because you care?"
msgstr "그리고 이제 와서 거기 서서 나한테 어떻게 느껴야 할지 명령해도 된다고 생각해? 왜 - 내가 신경 쓰여서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 34032d77-826c-57f3-f8c7-b24816dae7fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_BecameVampireLord = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:34032d77-826c-57f3-f8c7-b24816dae7fb
msgctxt "h9de71bfdg9189g4374gad84g0c4213cda623"
msgid "I can't believe you let me do that. Killing all those people."
msgstr "이 일을 하게 놔둘 줄은 몰랐어. 그 많은 사람을 죽이게 하다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 34e26bee-aa39-c6c8-84e6-639f256120ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_StayedVampireSpawn = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:34e26bee-aa39-c6c8-84e6-639f256120ed
msgctxt "h030031a7g4bdbg4438g8002g1218263b193d"
msgid ""
"I should probably start getting used to the shadows again. Who knows how "
"long I have left in the sun?"
msgstr "다시 그림자에 익숙해져야 할 것 같아. 태양 아래에서 얼마나 더 견딜 수 있을지 누가 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 3748cf07-a9b5-68e4-ca66-b15418aff0e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3748cf07-a9b5-68e4-ca66-b15418aff0e3
msgctxt "h2a640f7ag179cg499bgb983g8fe229d76326"
msgid ""
"Be careful, Astarion. My engine is running <i>so </i>hot. I won't be able to "
"control it."
msgstr "조심해, 아스타리온. 엔진이 <i>정말</i> 뜨거워지고 있어. 내 손에서 벗어날지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 3a2381da-bed6-fefd-87c7-e3aecba4bc66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3a2381da-bed6-fefd-87c7-e3aecba4bc66
msgctxt "hf43e4cbbg9d3eg4608ga347g3024522a7fe7"
msgid "<i>Pick up a flower and lay it on the grave.</i>"
msgstr "<i>꽃을 주워 무덤 위에 올려놓는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 3a3d3759-9eec-e099-6518-bfe71537e468
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3a3d3759-9eec-e099-6518-bfe71537e468
msgctxt "h9a300291g404cg4c94g8ffag76191942861a"
msgid "You're a hypocrite, and I don't want to be with you."
msgstr "넌 위선자야, 같이 있고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 3bbc72ba-622d-94b9-cf8b-cafa8dfc0838
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3bbc72ba-622d-94b9-cf8b-cafa8dfc0838
msgctxt "h3e42ad9cgdd8dg46a1g8191ge3e70b01c346"
msgid "Maybe, but even if I could control it, it's a dangerous game."
msgstr "그럴 수도 있겠지만, 통제할 수 있다 해도 여전히 위험한 게임이나 다름없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 3c24115a-562b-db9c-4cdf-aa40f49e4593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3c24115a-562b-db9c-4cdf-aa40f49e4593
msgctxt "h896c5c70gb80fg480bg8519gfd2acffc7531"
msgid "So what would I be? A vampire? Or your spawn?"
msgstr "그럼 난 뭐가 되는 거지? 뱀파이어? 아니면 네 스폰?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 3d144d22-0efe-04e4-792c-c3cc59c5d633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3d144d22-0efe-04e4-792c-c3cc59c5d633
msgctxt "h931d375bg5c1bg4116gb259ge3bdfbf524a0"
msgid ""
"There's... something I'd like to show you, if that's all right? Something "
"out in the city."
msgstr "그... 보여주고 싶은 게 있어, 네가 괜찮다면. 도시에 있는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 3e62fce3-a545-7869-ff33-e8936e8d828e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - GLO_Companion_Leave(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3e62fce3-a545-7869-ff33-e8936e8d828e
msgctxt "hc362740dg61ddg449dgb2ddg27dbc8a914bf"
msgid "To hells with you, I'm done. I hope you rot."
msgstr "제기랄, 너랑은 끝이야. 썩을 자식아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 3eb7d171-7e09-8f2f-8029-9b038aad9b77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3eb7d171-7e09-8f2f-8029-9b038aad9b77
msgctxt "h00c6a0f6g74eag46f7gb95eg7f48247cb126"
msgid ""
"But I do now. Being with you is about more than lust or manipulating you "
"into a tactical alliance."
msgstr "하지만 이젠 아냐. 너와 함께 있는 건 욕정이나 전략적 동맹으로 다루는 것 이상의 의미가 됐으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 3ecc2736-efb6-25eb-d3fb-84e8cbe81b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3ecc2736-efb6-25eb-d3fb-84e8cbe81b6b
msgctxt "h13295f50g309cg4e3dgaea1g24400701e6a2"
msgid "No, you have given me a glorious new future."
msgstr "당연 없지, 넌 내게 영광스러운 미래를 줬으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 3f2dc2d2-334f-8903-278b-374ad4f55bd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3f2dc2d2-334f-8903-278b-374ad4f55bd7
msgctxt "h5edfe390g5cf1g4215ga88bgeace21421e18"
msgid "Sounds good to me."
msgstr "좋은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 3fcd49ce-62dc-df95-f5e2-69d487a18a5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3fcd49ce-62dc-df95-f5e2-69d487a18a5f
msgctxt "he582d22cg8550g425bg8bc5g430efbb9979e"
msgid "The enthusiasm is appreciated, but hopefully not."
msgstr "열의는 고맙지만, 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 3ff58588-55d4-73c4-7217-86e2d4d037ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:3ff58588-55d4-73c4-7217-86e2d4d037ad
msgctxt "he8daa3e7g9d57g4766g9e97g22141ae1cc75"
msgid "If you want to sneak off for a cuddle, you can just ask."
msgstr "몰래 뒹굴러 가고 싶은 거면, 그냥 물어봐도 되는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 40c30885-19c2-da44-a3aa-c0371bca1992
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:40c30885-19c2-da44-a3aa-c0371bca1992
msgctxt "h3417c71ag0084g46c0ga429g01c1a0318f95"
msgid "I feel the same."
msgstr "같은 생각이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 42afdd68-43fb-ce87-322b-9819628d75e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:42afdd68-43fb-ce87-322b-9819628d75e0
msgctxt "hc775c50egf680g4848gbcc1g8577169a8a1a"
msgid "So. What's it to be, darling? Is this it?"
msgstr "어떻게 할 거야, 자기야? 이걸로 끝?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 4518559e-242e-6e05-507c-85bc2668d568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4518559e-242e-6e05-507c-85bc2668d568
msgctxt "h78f04a12g72cdg4d8cgb186g2609e7352291"
msgid "But we mustn't rush these things. You may need time to adjust."
msgstr "하지만 서두르면 안 돼. 적응할 시간이 필요할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 453711d6-ba89-12f5-0d4f-817e4c3ce7a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:453711d6-ba89-12f5-0d4f-817e4c3ce7a1
msgctxt "hf11dcfdbgd795g4471g81a3g8d657f3b08f5"
msgid "With everything that life has to offer."
msgstr "삶이 주는 모든 것과 함께."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 47a0fa0d-9839-7b0c-6ebb-52de538d8818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:47a0fa0d-9839-7b0c-6ebb-52de538d8818
msgctxt "hcd085f65g1a8ag4279g8150gc2759ec19f0f"
msgid ""
"For nearly two centuries I stalked the streets like a ghost while the person "
"I was lay here, dead and buried."
msgstr "내가 근 2세기를 유령처럼 거리를 배회하는 동안 사람이었던 나는 여기에, 죽어서 묻혀 있었던 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 48aba143-d6fa-c9a4-5f8e-40c16d004fda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:48aba143-d6fa-c9a4-5f8e-40c16d004fda
msgctxt "hcac93e73g8b93g403fg9a33ge3c958cf1aa3"
msgid "Not having second thoughts, are we?"
msgstr "망설이거나 하는 건, 없지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 49d5e839-1a45-d36a-34be-079e750b4a10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:49d5e839-1a45-d36a-34be-079e750b4a10
msgctxt "h886f1c75g5fd1g4f10g8076ga780b4d29b93"
msgid "Oh, come on. Let it <i>hurt</i>."
msgstr "오, 이리 와. <i>아프게</i> 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 4a1b70c1-3a86-e20d-003d-01c34e67e3f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4a1b70c1-3a86-e20d-003d-01c34e67e3f6
msgctxt "h13a0d3aegb7c5g440bg95a0g4b759aa14d84"
msgid "That does sound appealing..."
msgstr "그거 괜찮게 들리는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 4aa19091-e705-77a6-6e58-7339cc0d5cf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4aa19091-e705-77a6-6e58-7339cc0d5cf0
msgctxt "hb04f9287geff1g4675g9802g0781d38489db"
msgid "So, tell me what you desire. What can I do for my dearest pet?"
msgstr "그래서, 원하는 게 뭔지 말해봐. 사랑하는 애완동물을 위해서 뭘 해줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 4ab3acfc-961f-2b04-6bcb-a657e98aa416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4ab3acfc-961f-2b04-6bcb-a657e98aa416
msgctxt "he672349bg049bg4e45ga621gc9070e95e7d0"
msgid "The bastard got what was coming to him."
msgstr "그 개자식은 대가를 치렀어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 4ac7f632-f3be-315e-78d7-6b530f5da520
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4ac7f632-f3be-315e-78d7-6b530f5da520
msgctxt "h4c1e6fdbg6b46g4fe6ga0f9gabef367abb41"
msgid "I'll be with you either way. I hope you know that."
msgstr "어느 쪽이든 함께할 거야. 그건 알아줬으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 4b4991e7-c9d5-debc-1ded-187ccc19698e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4b4991e7-c9d5-debc-1ded-187ccc19698e
msgctxt "h4f6d33dcgcf3bg49a5g9aaeg5f73891b376e"
msgid "Don't you ever compare me to him! Never!"
msgstr "그 놈과 비교하지 마! 절대로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 4c3e8cb8-d63a-d5cd-1127-07bb4f771939
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4c3e8cb8-d63a-d5cd-1127-07bb4f771939
msgctxt "hf961df11g96c8g4258g9f3cge435d3e26976"
msgid "Regretting your choices?"
msgstr "선택을 후회해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 4c97b7a6-f489-b28c-681e-06e3a14b16e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4c97b7a6-f489-b28c-681e-06e3a14b16e1
msgctxt "ha831d7a2g78f5g4250ga024gf0e4caa6b63c"
msgid "I wanted you to be free. It seems you never will be."
msgstr "네가 자유로워지길 바랐어. 그런데 절대 그러지 못할 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 4dcf69eb-27f2-ba8c-9796-b3dc4e421ca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4dcf69eb-27f2-ba8c-9796-b3dc4e421ca8
msgctxt "hf077d2e1g44d1g4fc4ga96eg1f02d9568b89"
msgid "Let's just... stay here? Together?"
msgstr "우리 그냥... 여기 있을까? 같이?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 4e068533-f207-3b0f-7db2-50a34998747f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4e068533-f207-3b0f-7db2-50a34998747f
msgctxt "hb4a0a2ddg3c17g4a28g8afcg6b1c0bd13b3d"
msgid "Controlling them may still be an option, but it's a dangerous game."
msgstr "올챙이를 통제하는 게 선택사항일 수 있지만, 위험한 게임이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 4f5815bf-c628-917d-7537-cc1b4ba9cb1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:4f5815bf-c628-917d-7537-cc1b4ba9cb1d
msgctxt "hbb6ac3e4g1624g4f22ga381g3d0e48a3390c"
msgid ""
"Please, everything is about power. Sex, relationships, violence - they're "
"all just different forms of control."
msgstr "제발, 모든 건 힘과 관련되어 있어. 섹스, 관계, 폭력 - 모두 통제의 다른 형태들일 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 50c2ec19-385d-aaf9-38dd-ef77bf62828f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:50c2ec19-385d-aaf9-38dd-ef77bf62828f
msgctxt "h00210d8dg8a08g49c6g837eg301d316e8439"
msgid ""
"Instead I just feel... blank? I suppose not wielding the blade myself makes "
"a difference. It's all a little anti-climactic."
msgstr "대신 그냥... 공허한 느낌? 직접 칼을 휘두르지 않은 게 이유일까. 다 조금 실망스러워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5497e61e-133d-ac84-c4d2-f251f55bc7c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5497e61e-133d-ac84-c4d2-f251f55bc7c8
msgctxt "hcd9960c2g6befg4536g809agd2a22a4cb813"
msgid "You... I want you."
msgstr "너... 널 원해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Narrator
#. NodeID = 5511099b-89b4-b54a-4d7f-032b7b213e29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#.   Object:
#.     - ORI_Astarion_Event_TurnIntoSpawn(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5511099b-89b4-b54a-4d7f-032b7b213e29
msgctxt "h6c2095c0g29eag4042gade6g023165d5f33b"
msgid ""
"*As he drinks more and more, you feel yourself fading from consciousness. "
"When you wake again, you will be his forever more.*"
msgstr ""
"*그가 당신의 피를 마시면 마실수록, 의식이 점점 멀어지는 것을 느낍니다. 다시 깨어나면, 당신은 영원히 그의 소유가 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 57519673-ef24-0188-1103-3814f296ad75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:57519673-ef24-0188-1103-3814f296ad75
msgctxt "hfb0a9902g8568g4941gaf30gdfef932d6155"
msgid ""
"A great deal. But nothing I can act on without burning to a crisp. But I'm "
"willing to wait."
msgstr "아주 많지. 하지만 불타버리지 않고서는 할 수 없는 일들이야. 그렇지만 기꺼이 기다릴 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 57815d0a-bb80-c26e-fa1c-5a07c648a3c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:57815d0a-bb80-c26e-fa1c-5a07c648a3c3
msgctxt "hfcd20051ge615g4b4cg9399g535a019843ea"
msgid "No."
msgstr "싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 584bd60d-42ba-5b2f-2b9a-4c24bed6a257
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:584bd60d-42ba-5b2f-2b9a-4c24bed6a257
msgctxt "h8e748433g4c28g4472g88fbgc486a5e735ba"
msgid ""
"It seems I misjudged you. I thought we might have a future together - even "
"an eternity - but perhaps you're not worthy."
msgstr "널 잘못 판단했나 봐. 난 우리 앞에 영원토록 함께 하는 미래가 있을 줄 알았어, 그런데 자격이 없었던 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5a2931e3-870e-b470-60e0-b3c5aa182a2a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5a2931e3-870e-b470-60e0-b3c5aa182a2a
msgctxt "h561ef66egdd99g45b5gbb97g5a1ec45c9279"
msgid "I will miss that all-consuming heat of yours, mind."
msgstr "그 뜨거운 열정이 정말 그리울거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5a2931e3-870e-b470-60e0-b3c5aa182a2a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_DRAGONBORN
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5a2931e3-870e-b470-60e0-b3c5aa182a2a
msgctxt "hf3e58526g33c4g4b88ga892g816299ccafca"
msgid "I will miss the heat from those scales, though."
msgstr "비늘의 열기는 정말, 그리울거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5a2931e3-870e-b470-60e0-b3c5aa182a2a
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5a2931e3-870e-b470-60e0-b3c5aa182a2a
msgctxt "hefec280agdc0fg478cg83c8g412bc754201c"
msgid "I will miss this warm flesh, mind you."
msgstr "뭐랄까, 이 따뜻한 살이 정말 그리울거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5c485205-2ca5-9f6f-bfcc-de6115cf826d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5c485205-2ca5-9f6f-bfcc-de6115cf826d
msgctxt "h2fb64021gd0eag43a4gad6eg998f9075c52c"
msgid ""
"Shall we have one last night together before you join me in immortality? One "
"for the road, so to speak."
msgstr "영원의 삶을 함께하기 전에 마지막 밤을 보내지 않을래? 작별의 밤, 이라고 할까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5e4ab1a4-f6e6-2cb7-5c55-80322a773fbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5e4ab1a4-f6e6-2cb7-5c55-80322a773fbc
msgctxt "h10679eb6g9bd7g4024gac41gb17598a9e38b"
msgid ""
"I am indomitable, Karlach. Nothing can stop me - least of all your hot-"
"blooded self."
msgstr "난 불굴의 존재야, 칼라크. 아무것도 날 막을 수 없어 - 네 뜨거운 피는 더더욱."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5e6fd4ba-9bd2-c303-d0ee-d39e5d8d537a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5e6fd4ba-9bd2-c303-d0ee-d39e5d8d537a
msgctxt "hf4f54754g8c23g4de7g9979g343b40fc07f2"
msgid "How dare you stand there and judge me. As you know the first thing."
msgstr "어떻게 감히 거기 서서 날 판단할 수 있어. 처음부터 너도 알고 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5efb9bc3-4074-4175-70b6-799f7111b4bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5efb9bc3-4074-4175-70b6-799f7111b4bb
msgctxt "h51dc7da0gf889g46a9gba97g606491774f6d"
msgid "My dark consort. My right hand. My most beloved spawn."
msgstr "내 어둠의 배우자. 내 오른팔. 내 가장 사랑스러운 스폰."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 5fc1349b-2cf4-08e1-8bc1-22e067929106
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:5fc1349b-2cf4-08e1-8bc1-22e067929106
msgctxt "h887b492dgb2a9g40d2gbda6g32f04de4d043"
msgid ""
"I thought things would feel different when he was gone. That I'd be "
"revelling in my freedom."
msgstr "카사도어가 사라지면 뭔가 다르게 느껴질 거로 생각했어. 자유를 만끽할 수 있을 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 61c40736-4cff-dd70-d106-cdfb6fdc3450
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:61c40736-4cff-dd70-d106-cdfb6fdc3450
msgctxt "h2b487e69g2839g4412gb05dg90746366d60a"
msgid "Then come with me, my love, and live your final night."
msgstr "그럼 따라와, 내 사랑, 생의 마지막 밤을 보내자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 62233866-b883-cf6c-c279-46d9a9abbc14
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:62233866-b883-cf6c-c279-46d9a9abbc14
msgctxt "hb73fdd19gd92eg4c47g8846gf9e4a226c099"
msgid "It won't take me until the end of time to find another like you."
msgstr "하지만 나는 너 같은 사람을 찾는 데 시간이 오래 걸리지 않지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 646f54a4-ac74-2734-b028-da015e53bd0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:646f54a4-ac74-2734-b028-da015e53bd0a
msgctxt "he06a8bb6g132cg4fb3ga069g8257978c4544"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 650b0dfd-4509-8813-c48a-1960cda93d33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:650b0dfd-4509-8813-c48a-1960cda93d33
msgctxt "h352c7524g4930g4465g8fbfg0527823afe1d"
msgid ""
"Of course now that I'm free from one threat, we'll have to face the other: "
"the tadpoles that let me walk in the light."
msgstr "물론 내가 한 가지 위협에서 벗어났으니까, 또 하나에 맞서야지: 빛 속을 걸을 수 있게 하는 올챙이들 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 654225ea-f46e-3281-bbce-1f77dad64eff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:654225ea-f46e-3281-bbce-1f77dad64eff
msgctxt "h8f4117b7gb770g44cagb98dgc2a19b46b485"
msgid "We might not have forever, but we do have all the time we need."
msgstr "영원을 가지고 있진 않지만, 충분한 시간이 이미 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 65527e93-618a-63ae-9c84-f9796d2795ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:65527e93-618a-63ae-9c84-f9796d2795ad
msgctxt "h06ca2e3eg3b7eg4e35ga827g8239f6a9659f"
msgid "How does it feel to be free?"
msgstr "자유로워진 기분이 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 658b9eeb-fad3-633f-27d2-9780e588c2f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:658b9eeb-fad3-633f-27d2-9780e588c2f8
msgctxt "h07f843c2gbce5g4bf7gb3c7g83e2808d805d"
msgid "I wanted what was best for you."
msgstr "가장 좋은 선택지를 주고 싶었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 65bcd122-4c6f-5ae7-0319-af6090e36419
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:65bcd122-4c6f-5ae7-0319-af6090e36419
msgctxt "ha771449agf712g4aa1ga6eage24152b9d5f0"
msgid ""
"Who's to say I don't? I'm willing to share all of this with you. What's that "
"if not love?"
msgstr "안 그럴 거라고 누가 그러지? 난 이 모든 걸 너와 기꺼이 나눌 거야. 이게 사랑이 아니면 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 66280d3c-8148-2481-8ed5-48b17e202bec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:66280d3c-8148-2481-8ed5-48b17e202bec
msgctxt "h056e3596g2178g4051ga4b2g6b11299bf70f"
msgid "Sounds like you'd have it all."
msgstr "이미 모든 걸 다 가진 것처럼 들리는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 664c236c-e145-adc9-a10a-d43a08adec92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:664c236c-e145-adc9-a10a-d43a08adec92
msgctxt "hbf3d1f5bg9055g4d31gbe9fga56f32cc7d67"
msgid "You have given me <i>everything</i>. Thank you."
msgstr "넌 내게 <i>모든 걸</i> 줬어. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 6686278b-c7a0-1ed1-a7e9-8b877c5ccc6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:6686278b-c7a0-1ed1-a7e9-8b877c5ccc6c
msgctxt "hf2d209c0g2475g45c1g8d84g7bdef0d4655b"
msgid ""
"The only reason I can still walk in the day, you mean? Yes, we will have to "
"do something about them."
msgstr "태양 밑에서 아직도 걸을 수 있는 유일한 이유, 말이야? 그래, 이것들에 어떤 조처를 하긴 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 67138bcc-ed13-6518-46a9-feb7777ba14e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_SD_ROM_BlackMassAftermath_TriedBitingKarlach = True
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:67138bcc-ed13-6518-46a9-feb7777ba14e
msgctxt "hdb188ad4g1690g40e7ga655gf3a574c4f01f"
msgid "Gods - NO! ARGH!"
msgstr "젠장 - <b>안돼! 아악</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 67247387-073c-4435-dbac-551873ff8f71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:67247387-073c-4435-dbac-551873ff8f71
msgctxt "h78b2c69cg67f8g4906gb52agf4566d266151"
msgid ""
"How dare you! How could you? I was trying to help you, but you're beyond "
"help."
msgstr "어떻게 감히! 어떻게 이럴 수 있어? 널 도우려고 했을 뿐인데, 이미 내 손을 떠났잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 68593320-f208-bfde-4fc4-f239123a6fa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:68593320-f208-bfde-4fc4-f239123a6fa9
msgctxt "h09626191g8c10g4099gbf8cg8801ec9190c6"
msgid ""
"Karlach, my love. I'm the Vampire Ascendant - there's nothing I can't do."
msgstr "칼라크, 내 사랑. 난 승천한 뱀파이어야 - 못 할 게 어디 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 6897b6c3-4cdd-3f68-213c-8e614951c4e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:6897b6c3-4cdd-3f68-213c-8e614951c4e2
msgctxt "h8e85a656ge1a3g4282gb58ega5f083dec03d"
msgid "Are we here to piss on someone's grave?"
msgstr "누구 무덤에 오줌 싸러 온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 6d50cd21-6732-aaf5-1c9c-651f07fafb37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_PartySize_AtLeast3 = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:6d50cd21-6732-aaf5-1c9c-651f07fafb37
msgctxt "hb3af1fb4g2c78g46afga4a4gd295f263f2ed"
msgid ""
"Come on, let's get back to the camp. Who knows how long before the others go "
"feral without us there to guide them?"
msgstr "그럼, 이제 야영지로 돌아가자. 언제 다른 녀석들이 우리 같은 보호자 없이 멋대로 돌아다닐지도 모르잖아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 6eb7d8fb-d2e9-1051-e13f-cd44ad604c3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:6eb7d8fb-d2e9-1051-e13f-cd44ad604c3f
msgctxt "h2eaf0affg61dfg4de5ga182g0c598548558c"
msgid ""
"I had to punch a hole in the coffin and claw my way through six feet of dirt."
msgstr "관에 구멍을 내고 6피트 높이의 흙을 손으로 헤치면서 올라와야 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 6ee8202b-e8ad-10c3-2644-a5f36410f0a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:6ee8202b-e8ad-10c3-2644-a5f36410f0a9
msgctxt "h6444231egde8cg4c50gb042ga76254738db9"
msgid "Good luck with the brain, darling."
msgstr "뇌랑 잘 싸워 봐, 자기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 718c11fc-20ff-ed1a-6174-986cd5f3ccdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:718c11fc-20ff-ed1a-6174-986cd5f3ccdb
msgctxt "h0d3dda5fg90dfg4b15gad8ag9bcac9aea302"
msgid "I wanted you to feel safe."
msgstr "네가 안전하다고 느끼길 원했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 729c4428-e599-d54d-f788-2fd081dba1e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:729c4428-e599-d54d-f788-2fd081dba1e4
msgctxt "ha52ac7feg1b2cg40acg88a6ga2c0adf4f029"
msgid "No, I made the right choice. Although I do regret the options I had."
msgstr "아니, 난 옳은 선택을 했어. 하지만 고를 수 있었던 다른 선택지들을 잃은 게 아쉽긴 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 73e0aa5d-6ebb-3824-6ea3-e8d9ca26f271
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:73e0aa5d-6ebb-3824-6ea3-e8d9ca26f271
msgctxt "h954ce7b5gff08g4abfgbd1bga3c56edc8cd8"
msgid "Exhilarating. Terrifying. Exhausting."
msgstr "흥분되고. 무섭고. 지쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 748efb8d-6718-feb5-ff15-abf0296645f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:748efb8d-6718-feb5-ff15-abf0296645f3
msgctxt "he302a5f1g99c3g4147g8841g6e4a007b05b4"
msgid ""
"It will only hurt a bit, the pleasure will be far greater than the pain."
msgstr "조금 아프겠지만, 곧 쾌락이 고통을 앞지를 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 75404e50-d7de-b40e-9cec-d23f194b2aea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:75404e50-d7de-b40e-9cec-d23f194b2aea
msgctxt "h786214cbgec7ag4952g9a3fg03019d8f8815"
msgid "That's it? You're giving up on walking in the sun?"
msgstr "그걸로 끝이야? 태양 아래에서 걷는 걸 포기하려고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 7583a8f6-cc02-10e0-6a81-79983987b228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7583a8f6-cc02-10e0-6a81-79983987b228
msgctxt "h284cfbb2g0750g4ee9gafc9g9af41c7f30b0"
msgid ""
"Assuming I have a life to build. It's a little hard to plan anything knowing "
"there's still a tadpole burrowing its way through your brain."
msgstr ""
"내가 만들어 가야 하는 삶이 있다고 가정해 보자. 그런데 올챙이가 내 뇌를 야금야금 파먹고 있다는 걸 아는 상황에서 계획을 세우는 건 좀 "
"어려울 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 7755c214-3afc-7c85-8b8b-4c6972984177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7755c214-3afc-7c85-8b8b-4c6972984177
msgctxt "hd7d74bf5gbdedg428fgb714gd1bc4d5b1999"
msgid "I did it for you, you piece of shit."
msgstr "널 위해서 한 거니까, 이 개자식아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 78de0350-1470-85e3-cbbd-466469672861
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:78de0350-1470-85e3-cbbd-466469672861
msgctxt "hb0911e09g9c48g4dd6ga358gceb192e9c6c3"
msgid ""
"No, I don't expect you to be. You did what you thought was right. Even if "
"you were objectively wrong."
msgstr "그럴 거라고 생각 안 해. 옳다고 생각한 일을 했잖아. 객관적으로 봤을 때 틀렸을지 몰라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 7992bb65-deb3-761e-385e-e05318ce051e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7992bb65-deb3-761e-385e-e05318ce051e
msgctxt "h20b61e6fg1fb7g484dgb8bdg6bef4ef3901d"
msgid "That sex and relationships aren't about power over someone else."
msgstr "섹스와 관계는 다른 사람을 지배하는 데 사용하는 힘이 아니라는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 7a5314ac-9f13-72f0-cd21-2852b5ef09d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7a5314ac-9f13-72f0-cd21-2852b5ef09d0
msgctxt "h533a5a96gf6d9g4cfegae89gc958914d8a3a"
msgid "I'll try to restrain myself if you do. Shall we?"
msgstr "그렇게 하면 자제하도록 노력할게. 그럼 가볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 7ab38ee6-4a26-c7b2-758a-038b3795a3a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7ab38ee6-4a26-c7b2-758a-038b3795a3a6
msgctxt "h6163d677gf2b6g4d66g8798gd060c37ca7b9"
msgid ""
"Oh, I hadn't forgotten. But with you here, I am... dare I say 'optimistic' "
"about our chances?"
msgstr "오, 잊지 않았어. 그렇지만 너와 함께 있으니까, 난... 우리의 성공 여부를 감히 '낙관적'으로 보고 싶은걸?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 7af0010d-af1b-ee85-6084-e6dabc757955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7af0010d-af1b-ee85-6084-e6dabc757955
msgctxt "hda0a5e64g2b68g4462g883dgfb80fa2b002f"
msgid "You did the right thing, stopping the Black Mass."
msgstr "옳은 일을 했어. 검은 미사를 막았잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 7be95f8c-757f-8a05-8f42-55087bd4e1c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7be95f8c-757f-8a05-8f42-55087bd4e1c3
msgctxt "h8645b161ge60dg4f87g9913g7c25dd9474bb"
msgid ""
"I'd live with the risk of something going wrong. Of the tadpole finding some "
"new trick, reasserting itself, and making me a slave again."
msgstr ""
"뭔가 잘못될 위험을 안고 살아야 할 거야. 올챙이가 새로운 수를 찾아 스스로 진화한 뒤에 날 다시 노예로 만들까, 계속 걱정하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 7d9cfcdb-3658-de7f-3d3b-7b5d53f24d31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7d9cfcdb-3658-de7f-3d3b-7b5d53f24d31
msgctxt "h76b4ee0cgb427g4649g9a52g139bffcfbea0"
msgid "What did you have in mind?"
msgstr "생각하고 있던 거라도 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Narrator
#. NodeID = 7e0d0c66-21a6-de29-1a41-1594540aa5c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:7e0d0c66-21a6-de29-1a41-1594540aa5c8
msgctxt "hb22dc3beg6cd6g45beg8ce1ge98ff435ac7b"
msgid ""
"*He will always see you as degrading yourself if you continue to be with "
"him.*"
msgstr "*계속 함께 한다면 그는 당신을 자신 이하의 존재로 볼 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 81376bea-7f47-56ec-8dd4-3db1fef63d53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:81376bea-7f47-56ec-8dd4-3db1fef63d53
msgctxt "h0da69382gb6edg4cc8g918cg9f55ad6a4f02"
msgid "Would you be able to bite me without getting hurt?"
msgstr "아프지 않게 물 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 8188a67a-8552-71ba-a1ae-b19ab6f78896
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8188a67a-8552-71ba-a1ae-b19ab6f78896
msgctxt "h7c5170c5g5c7eg427cgaee8g950a94b6a496"
msgid "<i>Kick him in the balls.</i>"
msgstr "<i>불알을 걷어찬다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 81dc3aec-a04d-1d3d-eb2a-0ed91bc7046a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:81dc3aec-a04d-1d3d-eb2a-0ed91bc7046a
msgctxt "hf646e403g4ec2g4fb2ga277g597669d69203"
msgid "You wouldn't just be some spawn - you're far more than that to me."
msgstr "평범한 스폰이 아니지 - 내겐 그 이상의 의미가 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 83464df5-52b7-2e54-2bde-5b474f99e34e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:83464df5-52b7-2e54-2bde-5b474f99e34e
msgctxt "ha1b7231dg79c2g48f8g9ae6g33f7d93e413f"
msgid "There you are. The real you shows himself at last."
msgstr "이거 봐. 드디어 본모습을 드러냈네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 83464df5-52b7-2e54-2bde-5b474f99e34e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:83464df5-52b7-2e54-2bde-5b474f99e34e
msgctxt "hd9dce4d0g07c7g471egbafag50f6dd7e7ac2"
msgid "There you are. The real you shows herself at last."
msgstr "이거 봐. 드디어 본모습을 드러냈네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 83464df5-52b7-2e54-2bde-5b474f99e34e
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:83464df5-52b7-2e54-2bde-5b474f99e34e
msgctxt "h7421faddgb7e4g4fa0g9325g11187b256c7d"
msgid "There you are. The real you shows themselves at last."
msgstr "이거 봐. 드디어 본모습을 드러냈네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 867bce47-7704-fff4-f306-2fdb51f7deca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:867bce47-7704-fff4-f306-2fdb51f7deca
msgctxt "h5eff5ad7g00d1g490bg8794g8ccf41e88991"
msgid "You're the person I love. The person I want."
msgstr "넌 내가 사랑하는 사람이야. 내가 원하는 사람."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 87c8632c-ace3-2006-f774-009cd111ef1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:87c8632c-ace3-2006-f774-009cd111ef1f
msgctxt "h10ecafcegc73bg495bg8bddg4b1f46d9e0eb"
msgid "Cute."
msgstr "귀엽네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 8960b72c-aa44-592f-d077-5c3d783b0870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8960b72c-aa44-592f-d077-5c3d783b0870
msgctxt "heb4064a2ge4afg4a08gab63g4f9d78666592"
msgid "Of course we can. You're the one that I want - the one that I love."
msgstr "당연히 할 수 있지. 넌 내가 원하는 유일한 사람이고 - 사랑하는 유일한 사람이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 89c97780-2071-5bbd-a76a-59cc04e60c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:89c97780-2071-5bbd-a76a-59cc04e60c2f
msgctxt "hc0ab829dg2706g4702gaa01gc3f611e2f672"
msgid ""
"Oh my sweet, there are no vampires like me. And there never will be again."
msgstr "오 귀여운 자기, 이 세상에 나 같은 뱀파이어는 없어. 그리고 다신 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Narrator
#. NodeID = 8a573d50-6a49-243b-68d9-40ca774fe281
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8a573d50-6a49-243b-68d9-40ca774fe281
msgctxt "hc572790eg8a31g46e0gad3bgdd6f739d6cc8"
msgid ""
"*The graveyard is appropriately silent - there isn't a proverbial soul "
"around.*"
msgstr "*묘지는 시의적절하게 고요합니다. 흔히 표현하듯 영혼 하나 돌아다니지 않네요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 8ac836e7-3420-43c9-a4c7-20670547fa90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8ac836e7-3420-43c9-a4c7-20670547fa90
msgctxt "he605021dg4921g499dg8af5gcd0d2e2b213a"
msgid "You can tell me that you've learned something from all this."
msgstr "이 일련의 과정들에서 뭘 배웠는지 말해줄 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 8b233177-41d7-cd30-f023-f509366e4ecf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8b233177-41d7-cd30-f023-f509366e4ecf
msgctxt "hd828b217g54fag4461g8c06gebc75934dd9a"
msgid ""
"I won't forget what you've done for me. I won't leave you to fight this "
"alone."
msgstr "네가 날 위해 한 일들을 잊지 않을 거야. 혼자 싸우게 두지도 않을 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 8b7ace12-bd57-1ae6-993e-16d6ea1aea54
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6f84a003-69bf-b2a3-473c-9c9c8f65606f_ORI_Astarion_State_DidNotOfferToTurnIntoVampire = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8b7ace12-bd57-1ae6-993e-16d6ea1aea54
msgctxt "h50b178b8ga096g48bdgbb1bged70a261a83f"
msgid "Truly? And what was I supposed to learn from this?"
msgstr "정말? 여기서 뭘 배웠어야 했는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 8d7a28c5-bb92-fc75-9bc0-978fd128a303
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8d7a28c5-bb92-fc75-9bc0-978fd128a303
msgctxt "h2af9966fg65b7g493bgab85g64307844e863"
msgid "No, this isn't what I want."
msgstr "아니, 이건 내가 원한 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 8f053423-507b-4b53-05bc-8b524d6f71cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:8f053423-507b-4b53-05bc-8b524d6f71cf
msgctxt "h959d1a05g6957g4ab3gaa48ga58df7014ef9"
msgid "That's the question, isn't it?"
msgstr "그게 문제네, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 9139b1d5-cbb3-0963-376d-a408cc105d4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:9139b1d5-cbb3-0963-376d-a408cc105d4a
msgctxt "ha0290bcfgecedg4fabga7efgdc093961860c"
msgid "A pleasant surprise."
msgstr "생각지도 못한 즐거움이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 930df4a1-25d5-3c25-c519-07e7963b929f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:930df4a1-25d5-3c25-c519-07e7963b929f
msgctxt "hd712b5c2gc8d0g4c02g9889g25bb3232b25b"
msgid "If it has, it might be for the best."
msgstr "그랬다면, 오히려 잘된 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 954f7064-8df6-95c9-ab11-4891e07a1b20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:954f7064-8df6-95c9-ab11-4891e07a1b20
msgctxt "hbf292db9g0b48g41e1g914cg8af40a27dc7b"
msgid "What if I don't want forever?"
msgstr "내가 영원을 원하지 않는다면?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 9678d125-8919-5ca6-2a7b-8f919c5d863b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_TheHungerC_Bite = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:9678d125-8919-5ca6-2a7b-8f919c5d863b
msgctxt "hb4e621a1g47edg4fe6ga51bg8873afc676ba"
msgid ""
"But if you want the gift of eternity, I can certainly offer you that. One "
"little bite is all it would take."
msgstr "하지만 영원의 선물을 원한다면, 확실하게 줄 수 있어. 한 입이면 충분해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 96d5406c-b1f5-d337-ce1a-1036ea5faa25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:96d5406c-b1f5-d337-ce1a-1036ea5faa25
msgctxt "h2b998c3egb6f6g425ega87fg3cb03c8943f1"
msgid "On your knees, darling."
msgstr "무릎 꿇어, 자기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 96e1e43c-f423-c455-bbe5-89e8db7337dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:96e1e43c-f423-c455-bbe5-89e8db7337dc
msgctxt "h3e0a067eg14feg4430gb687gdc50d2f84c33"
msgid "You won't. Whatever comes next, I've got you."
msgstr "잃지 않을 거야. 뭐가 오든, 함께니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 975f0f78-a669-d7bf-ebd1-88063d11b34c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:975f0f78-a669-d7bf-ebd1-88063d11b34c
msgctxt "h09e7d837g46ccg4f4eg91degc41dfe737c0d"
msgid ""
"We could be together for eternity, ruling this world side by side. We could "
"have it all."
msgstr "영원히 함께하면서, 이 세상을 지배할 수 있어. 모든 걸 가질 수 있을 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 9806afa0-3aa9-3322-5259-cd0606f08bbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:9806afa0-3aa9-3322-5259-cd0606f08bbc
msgctxt "h84e4bde9g5d7eg44cfg9490g63a396e1cf29"
msgid ""
"I've been dead in the ground for long enough. It's time to try living again."
msgstr "땅 밑에서 충분히 오래 죽어 있었어. 이제 다시 살아볼 시간이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 980f28f5-49fc-9ccb-a4f5-8f07961b5b59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:980f28f5-49fc-9ccb-a4f5-8f07961b5b59
msgctxt "h5f799540gcf76g406bgac9fga54f3728d354"
msgid "With everything that life has to offer."
msgstr "삶이 주는 모든 것과 함께."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 99be3526-2271-1901-fd0d-1acbdf95d07e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6f84a003-69bf-b2a3-473c-9c9c8f65606f_ORI_Astarion_State_DidNotOfferToTurnIntoVampire = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:99be3526-2271-1901-fd0d-1acbdf95d07e
msgctxt "h4a1f902dgf300g441dg8f76gea690ddf2290"
msgid "I hope we can work things out and stay together."
msgstr "대책을 잘 찾아서 함께 지낼 수 있기를 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 9a62cc40-1c63-65ee-eb69-2b5107f64155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:9a62cc40-1c63-65ee-eb69-2b5107f64155
msgctxt "h35f3d976g2222g488cg900dg935cb2d3411e"
msgid "Indeed you do. I am so very, very powerful - all thanks to you."
msgstr "당연하지. 난 정말, 정말 강하거든 - 네 덕분에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = 9a7ac969-d8be-41d6-665d-615b54388989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:9a7ac969-d8be-41d6-665d-615b54388989
msgctxt "h6bbba36cg0cd9g41f3ga795g4d198920a5e5"
msgid ""
"Less giving up, more reassessing what I want. What I <i>really </i>want."
msgstr "포기한다기보단, 내가 뭘 원하는지 다시 생각해 보는 거야. 내가 <i>정말 </i>원하는 게 뭔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = 9f53ec89-520a-bbc6-07c2-5cbcdbd09609
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:9f53ec89-520a-bbc6-07c2-5cbcdbd09609
msgctxt "h1431fae8g2ae4g49aeg8d55g2f36881735da"
msgid "I'm ready. Bite me. Make me yours. Fix me."
msgstr "준비됐어. 날 물어줘. 날 네 것으로 만들어줘. 날 고쳐줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = a19a2120-51c5-0464-2c7b-b07516f49475
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:a19a2120-51c5-0464-2c7b-b07516f49475
msgctxt "hb94922f5g09fag4a02g9d5bgc9a32ce0bd76"
msgid ""
"Maybe, but he did take it. There's almost nothing left of the person I was. "
"Just a name on a rock."
msgstr "그럴지도 몰라, 하지만 놈은 빼앗아 갔어. 지금 내겐 사람이었던 흔적이 거의 남아있지 않아. 돌에 새겨진 이름만 남았을 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = a28ce86f-8901-9f54-e4d1-a4ddcd4b50c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:a28ce86f-8901-9f54-e4d1-a4ddcd4b50c7
msgctxt "h7e90936bg68cfg4fb7ga77eg9295f46aff32"
msgid "Don't say that - we could still find a way to control the tadpole."
msgstr "그런 말 하지 마. 올챙이를 제어할 방법을 찾을 수 있을지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = a65321c2-15e9-6486-6428-b0c1f216e980
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:a65321c2-15e9-6486-6428-b0c1f216e980
msgctxt "hf18c6b1cg63efg4765gb39ag6865e2d49303"
msgid ""
"I'm not sure. I'm burning so hot. I'm afraid of what will happen to you."
msgstr "잘 모르겠어. 지금 너무 뜨겁게 타오르고 있어. 네게 무슨 일이 일어날까 두려워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = a76c892b-ebc3-4638-9fd0-7740d42e3499
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:a76c892b-ebc3-4638-9fd0-7740d42e3499
msgctxt "hab8e8daeg21c2g4e8bg857bg928eaf1c9109"
msgid "I want you. I want your body."
msgstr "널 원해. 네 몸을 원해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = a7a9aaa1-4730-18ee-5693-c34154492e48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:a7a9aaa1-4730-18ee-5693-c34154492e48
msgctxt "h55f166ecg48a3g4498ga59fg971884aa6a34"
msgid "Now I need to figure out who I am. What I want."
msgstr "이제 내가 누군지 알아내야 해. 뭘 원하는지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = a7eb29e4-acd9-3e1b-90c0-b4cfafd5bb75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:a7eb29e4-acd9-3e1b-90c0-b4cfafd5bb75
msgctxt "h8ad6f6ddg8594g4fecgb319gbc047d71a859"
msgid "What's not to want? We could be together for all time."
msgstr "원하지 않을 게 뭐가 있겠어? 우리는 영원히 함께 할 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = aa86d52d-d9d1-8089-01a4-0b3534cc0124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:aa86d52d-d9d1-8089-01a4-0b3534cc0124
msgctxt "h3ec970ceg88ffg442ag991cgee7da101612f"
msgid ""
"I feel safe with you. Seen. And whatever the future holds for me, I don't "
"want to lose that."
msgstr "너와 함께라면 안전하다고 느껴. 네가 보일 때도. 내게 닥친 미래가 어떻든 간에, 그걸 잃고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = ab01cd02-85fc-c4ea-6967-172775fc5dd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ab01cd02-85fc-c4ea-6967-172775fc5dd6
msgctxt "hd046c71bg49ddg4d09g8164g8714d7b4c495"
msgid ""
"But don't you want more - don't you want eternity? One more bite is all it "
"would take?"
msgstr "하지만 좀 더 원하는 거 없어? 영원이라던가? 한 입만 더 물면 되는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = ab1d5d78-f231-34d5-22e3-97f3f659a818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ab1d5d78-f231-34d5-22e3-97f3f659a818
msgctxt "hd252ade5g92d0g43a4g9c54gad85544b0f5b"
msgid "A pity, then. We could have had something truly special."
msgstr "아쉽네. 정말 특별한 걸 가질 수 있었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = ac1ed9ea-f90b-9ced-505d-1666df121f7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ac1ed9ea-f90b-9ced-505d-1666df121f7e
msgctxt "h020febb8gd205g414agb093gaa1f0ee5a607"
msgid "And one wicked turn deserves another."
msgstr "그리고 한 번의 악행은 또 다른 악행으로 이어지지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = ac357afc-d481-6965-ba49-183f9885135b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ac357afc-d481-6965-ba49-183f9885135b
msgctxt "he165334bg33ffg4cd3g8a77gf78a2d52cd0e"
msgid "I don't want to look at you again. Get out of my camp."
msgstr "다시는 보고 싶지 않아. 야영지에서 나가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = ad183ba8-c492-db36-15af-64f899d445c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ad183ba8-c492-db36-15af-64f899d445c2
msgctxt "hacb7d414gcfa4g4f1fgb48cgb2d3432152b5"
msgid ""
"I'm surprised you didn't go through with the ritual. I was sure you were a "
"power-hungry madman."
msgstr "의식을 진행하지 않은 게 놀라워. 네가 힘에 굶주린 미친놈인 줄 알았거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = b2486dfd-1fe9-e602-fa40-4e6556746d11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:b2486dfd-1fe9-e602-fa40-4e6556746d11
msgctxt "ha2af99c2g011bg49f3g8677g0368493f7ea6"
msgid "You were never his. Whatever he had, he took by force."
msgstr "넌 그의 것이었던 적이 없어. 뭘 가졌든 간에, 놈은 강제로 빼앗았던 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = b37d508a-20ae-e477-7035-7b0feb574ce2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:b37d508a-20ae-e477-7035-7b0feb574ce2
msgctxt "h5833a48cg3a59g482fg83cbg7a20fb561111"
msgid "Life's a joke, dear, but now we're the ones laughing."
msgstr "삶은 농담이나 다름없어, 자기야, 하지만 이제 거기에 웃고 있는 건 우리들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = b70b4553-c5ae-f2fa-716c-4270b64f5bac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:b70b4553-c5ae-f2fa-716c-4270b64f5bac
msgctxt "h3e95487eg0c1fg4c14gb569g18dd82269973"
msgid "Oh that was completely different, I'd never hurt you. I love you."
msgstr "오 그건 완전히 달랐어, 난 널 절대 다치게 하지 않아. 널 사랑할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = b8290f16-4ee0-7f90-db82-f21c955e2d3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:b8290f16-4ee0-7f90-db82-f21c955e2d3b
msgctxt "hd2b02f9eg8620g4afdg9ceeg971ca277e0b1"
msgid "From that day on I was his. Until today."
msgstr "그날부터 난 그의 것이었어. 오늘까지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = b8505a2d-0fd9-2ba9-7c08-43e04c2f3a2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:b8505a2d-0fd9-2ba9-7c08-43e04c2f3a2c
msgctxt "h98ffa378g3e41g49b7g8aebg507a8c3e3a55"
msgid "I wanted a good time, that's all."
msgstr "즐거운 시간을 보내고 싶었을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = b8761bbc-7dd4-bb9b-a40b-3843223e5b89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:b8761bbc-7dd4-bb9b-a40b-3843223e5b89
msgctxt "h2e4a1d2ag4b35g4636gb7dfg87412e44a2f7"
msgid "You've earned it."
msgstr "넌 그럴 자격이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = bacd0103-7ea5-33c2-0d9e-453921cdc268
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:bacd0103-7ea5-33c2-0d9e-453921cdc268
msgctxt "hb677bfa3gf739g4ae0gba75gb5b5c277d36e"
msgid "Tonight, I shall drink every drop of your blood."
msgstr "오늘 밤, 네 피를 한 방울도 남김없이 전부 마실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = bae8739e-d0bc-8716-f6a7-988b7a9f982d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:bae8739e-d0bc-8716-f6a7-988b7a9f982d
msgctxt "hdda71a01g8d4ag4ef5g8cb7g902bcad06f03"
msgid "Hush love, it's all right. You don't have to worry."
msgstr "쉬잇, 괜찮아. 걱정할 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = bc56b71e-5865-d4fe-e0f2-07b88e25fd4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:bc56b71e-5865-d4fe-e0f2-07b88e25fd4b
msgctxt "h1495ab7eg4f9cg4100g83f8g83d035681fe5"
msgid "Argh! How DARE you!"
msgstr "아아악! 어떻게 <b>감히</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = c05ea9c4-644f-53db-a369-49ab4e148351
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c05ea9c4-644f-53db-a369-49ab4e148351
msgctxt "h17df3cabg57a5g4634g9225gffe0f3b58c74"
msgid "I want to be a vampire, like you."
msgstr "너처럼 뱀파이어가 되고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = c258f901-3c46-862b-595a-d50d9142ed27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c258f901-3c46-862b-595a-d50d9142ed27
msgctxt "hbd2bc495g572bg4fbeg9c61g8b16bb655bb7"
msgid "Maybe that's the space you need to build your own life."
msgstr "그 공간은 자신의 삶을 세워가는 데 필요할지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = c3ab5e50-65c0-7f83-18d3-b66307608b13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c3ab5e50-65c0-7f83-18d3-b66307608b13
msgctxt "h87cfe776g8957g424dga6d6g8ae796557ad4"
msgid "And if it is? Can you live with that?"
msgstr "정말로 그렇다면? 받아들일 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = c3d59a0e-fe19-c2ee-c632-4cddb4e43f1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c3d59a0e-fe19-c2ee-c632-4cddb4e43f1c
msgctxt "h37ecc38bg00bcg44edgb4ecgab4e46182db8"
msgid ""
"And here I thought I was the dangerous one. But I'm not so frightening after "
"all, am I?"
msgstr "난 내가 더 위험한 존재라고 생각했는데. 그래도 그렇게 무섭진 않지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = c3ea670e-fe66-1a76-5fcd-b548efa753a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c3ea670e-fe66-1a76-5fcd-b548efa753a2
msgctxt "had7428a6gdd52g4fe7g8de7g1def018db8c9"
msgid ""
"Assuming we survive, of course. Because a horrible death is always just "
"around the corner with you."
msgstr "물론, 우리가 끝까지 살아남는 전제 하에 말이야. 끔찍한 죽음은 언제나 우리 곁에 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = c6d5b4bb-522d-4757-826d-d0ef472fc07b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c6d5b4bb-522d-4757-826d-d0ef472fc07b
msgctxt "h6e35f761g9f9fg477fg9aa6g27096cdc507a"
msgid "You haven't seen my power, darling. You don't know the things I can do."
msgstr "아직 내 힘을 보지 못해서 그래, 자기야. 할 수 있는 일들이 얼마나 많은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = c722a9d0-d766-46f0-87d2-b5508312f019
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c722a9d0-d766-46f0-87d2-b5508312f019
msgctxt "h2f9c7b15g4806g4a15gbdaegd4cb3314bd78"
msgid ""
"What do you mean? Think of the things I can offer you! You're not going to "
"say no to that, surely?"
msgstr "무슨 뜻이야? 내가 줄 수 있는 것들을 생각해 봐! 그것들도 싫다고 하진 않을 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = c7f44433-5930-ae20-9ee0-16d5dc1abd75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c7f44433-5930-ae20-9ee0-16d5dc1abd75
msgctxt "h59b5c209g824cg4ed1g9300gaafe9b0b69f4"
msgid "I guess that depends on what your idea of 'a little fun' is."
msgstr "'재미'에 대한 네 생각이 어떤지에 따라 달라질 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = c8411491-2f08-3760-692b-a2a1d78f70b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:c8411491-2f08-3760-692b-a2a1d78f70b7
msgctxt "h231f0022g89dbg49cega4c3gfac1508c587e"
msgid "A little stereotypical, don't you think?"
msgstr "조금 진부하다고 생각하지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = cb077026-e64e-37b9-6de7-56dcacbde1dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:cb077026-e64e-37b9-6de7-56dcacbde1dd
msgctxt "h73f8b60fgac3bg4ea7g8023g1f8be38ac4d8"
msgid "I hoped you'd learn to love me."
msgstr "날 사랑하는 법을 배우길 바랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = cbe2bfb1-0c4e-22e9-93e3-4b5bf0c7b9d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:cbe2bfb1-0c4e-22e9-93e3-4b5bf0c7b9d8
msgctxt "ha625cf69g0a6dg4095gbfeeg145f3d375b92"
msgid "<i>Hold back. Give him his moment.</i>"
msgstr "<i>물러선다. 그에게 시간을 준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = ccdb26d8-1e27-97c5-71a1-f8cd7ae05719
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ccdb26d8-1e27-97c5-71a1-f8cd7ae05719
msgctxt "hc7cf35d5ged22g4186g9053g5130ed480036"
msgid "Something I haven't shown anyone else."
msgstr "다른 누구에게도 보여주지 않은 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = cd609241-79b0-4c56-4d2f-4fffa082299d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:cd609241-79b0-4c56-4d2f-4fffa082299d
msgctxt "h33547ed2g87bdg41cfg9288g317c7866c2d3"
msgid "You came so far, only to slip now. Such a pity."
msgstr "여기까지 왔는데, 이제 와서 미끄러지다니. 안타까워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = cfce2e4e-d588-2b0e-0409-b9d0692ccd19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:cfce2e4e-d588-2b0e-0409-b9d0692ccd19
msgctxt "hf4501697g2fb3g4f81gaca6g1b5882c32a40"
msgid "Impatient are we? Well who am I to deny you?"
msgstr "조급하네? 뭐 그렇게 원한다면야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = d03ebbc4-11c1-1707-00a4-f28d0023d1e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d03ebbc4-11c1-1707-00a4-f28d0023d1e1
msgctxt "h0522c223g4b1cg420egb457g30d197830dc5"
msgid "And what do you want?"
msgstr "네가 원하는 건 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = d1a06316-7200-6593-8009-8225f2b16bcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d1a06316-7200-6593-8009-8225f2b16bcf
msgctxt "h8140109fg6410g4a3agaa2fgcb4df3dba524"
msgid ""
"After everything you went through with Cazador, you're going to make me a "
"spawn?"
msgstr "카사도어한테 그렇게 당해놓고서, 날 스폰으로 만들겠다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = d2c389a9-48df-81d5-6047-48d07c97aad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d2c389a9-48df-81d5-6047-48d07c97aad4
msgctxt "h3c348118gfa0fg438bgb577g0b459b86f5c2"
msgid "Then don't mess it up."
msgstr "그럼 망치지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = d2f8e0da-02d6-658a-817c-77ced0226166
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d2f8e0da-02d6-658a-817c-77ced0226166
msgctxt "hce554639gbe31g4c8bg8696g632fb6a87a65"
msgid ""
"Then when I finally broke the surface, retching up dirt and congealed blood, "
"Cazador was waiting."
msgstr "흙먼지와 응고된 피를 토해내면서 마침내 땅 위로 올라왔을 때, 카사도어가 날 기다리고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Narrator
#. NodeID = d3eb3dd1-9227-376a-adf7-8d569ab13fdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d3eb3dd1-9227-376a-adf7-8d569ab13fdd
msgctxt "h12017710g70eag4988g9fb5gd76f65a7a444"
msgid "*But perhaps you wish to degrade yourself. And he knows it.*"
msgstr "*하지만 당신은 스스로를 낮추고 싶을지도 모릅니다. 그리고 아스타리온은 그 사실을 알고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = d4e4fa19-a132-8400-88cd-4a9435d7ab98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d4e4fa19-a132-8400-88cd-4a9435d7ab98
msgctxt "ha9b92d37g1d30g4e51g9162g1a065bedb09c"
msgid "Oh don't be like that, I'd never want to control you. I love you."
msgstr "그렇게 굴지 마, 널 절대 통제하고 싶지 않아. 널 사랑할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = d51aa7be-bc74-0798-53ab-4c675dcbc9f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d51aa7be-bc74-0798-53ab-4c675dcbc9f9
msgctxt "h551d6a9cg95bdg4b02gb680g0fe940008d92"
msgid ""
"All right. But if your offer is still open, I want to be a vampire. Just "
"like you."
msgstr "알겠어. 하지만 제안이 아직 유효하면, 뱀파이어가 되고 싶어. 너처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = d6f51785-9ecd-f9c0-6cef-54ee70e3a081
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d6f51785-9ecd-f9c0-6cef-54ee70e3a081
msgctxt "hc1c75bcfg4139g410dgbad0gceeed2aa1226"
msgid ""
"You were by my side through all of this. Through bloodlust and pain and "
"misery. You were patient. You cared. You trusted me when that was an "
"objectively stupid thing to do."
msgstr ""
"피의 욕망과 고통과 비참함을 헤쳐 나가는 동안 넌 계속 곁에 있어 줬어. 넌 인내했고. 배려해줬어. 객관적으로 멍청한 짓임을 알고 "
"있었지만서도 날 믿어줬지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = d7a2bfb0-ab99-435c-0fd6-f5049670a3b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d7a2bfb0-ab99-435c-0fd6-f5049670a3b0
msgctxt "h36d0efa2gad0bg4904gbd72gaaff308818ad"
msgid "On your grave? Absolutely not!"
msgstr "네 무덤 앞에서? 절대 안 돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = d7e17fa6-f815-5ed1-92d7-9b45d8ccfc17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d7e17fa6-f815-5ed1-92d7-9b45d8ccfc17
msgctxt "h16320a69g13bcg47cdgbe27ge2b352322db4"
msgid "Get away from me - get out of my sight!"
msgstr "저리 꺼져, 사라져 버리라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = d8036194-6e3e-b4e4-45e2-e26502fec9e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d8036194-6e3e-b4e4-45e2-e26502fec9e9
msgctxt "h17085a72gd48eg4c01ga773gf151da4dd1ee"
msgid ""
"Forget about your engine. Forget about control. I'll take care of "
"<i>everything</i>."
msgstr "엔진은 잊어버려. 통제하는 것도 잊어버려. 내가 다 <i>처리할게</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = d8aef41e-5c4f-95d7-0740-e9528b37bc90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:d8aef41e-5c4f-95d7-0740-e9528b37bc90
msgctxt "hbe817eccgd056g4225gb0f5g68fdad1c3138"
msgid "<i>Kneel</i>."
msgstr "<i>무릎 꿇는다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = dd4c5329-ff92-2f15-5804-603b0f97a040
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:dd4c5329-ff92-2f15-5804-603b0f97a040
msgctxt "h1d5c6ce0g7942g41f2ga8ecg0bf6bbdfb145"
msgid "Be gentle... if you can."
msgstr "부드럽게 해 줘... 할 수 있다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = de217473-7e41-2442-d4b6-371b6c2c63e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:de217473-7e41-2442-d4b6-371b6c2c63e3
msgctxt "hfa746199g9332g4619g94adg37f2984829af"
msgid "Spawn? I want to be a true vampire."
msgstr "스폰? 나는 진정한 뱀파이어가 되고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = de2d9446-bcc8-49ac-7b1a-eaf83de3ea5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:de2d9446-bcc8-49ac-7b1a-eaf83de3ea5e
msgctxt "h8070f6c4gde42g4aa4g8abfgaca82af5d260"
msgid "It doesn't feel like a joke. It feels like you mean it."
msgstr "농담으로 안 들려. 진심으로 느껴진다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = e038092b-34c7-57f6-740e-3ab46dff1cbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e038092b-34c7-57f6-740e-3ab46dff1cbb
msgctxt "h270b1944ga4d7g477cgad95g2a95f559269c"
msgid ""
"Nearly two hundred years and I never came back. Not since the night I woke "
"up down there."
msgstr "거의 200년이 지났는데 한 번도 돌아왔던 적이 없었어. 저 밑에서 깨어난 날 밤 이후로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = e0de7145-7d73-4fa1-a9bb-89e0467f289e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e0de7145-7d73-4fa1-a9bb-89e0467f289e
msgctxt "hfca05e4cg700dg4322g8eaegbe51eb6b97dc"
msgid "What is it?"
msgstr "그게 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = e2931d43-c819-1d95-ec1c-f2397591186e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e2931d43-c819-1d95-ec1c-f2397591186e
msgctxt "hd720732fg031fg4dffgb3bfg998e23a94f9a"
msgid "I will endeavour to please."
msgstr "만족할 수 있도록 노력할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = e377f5b9-ffd6-261e-eaea-9fc6eabe0df4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e377f5b9-ffd6-261e-eaea-9fc6eabe0df4
msgctxt "h45df18ebg1a92g402bg81a1g89025c4d74db"
msgid "I am <i>not </i>your pet."
msgstr "난 애완동물 같은 게 <i>아니야</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = e46a56b2-8f62-2e28-50e4-c1af9a9c9528
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e46a56b2-8f62-2e28-50e4-c1af9a9c9528
msgctxt "h873d274cga731g493cga013g5c8999ac3b5d"
msgid "You couldn't wait ten seconds before being an absolute freak?"
msgstr "10초도 못 기다리고 바로 변태처럼 굴 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = e6ff6c40-bd76-5db4-f204-f661795de7bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e6ff6c40-bd76-5db4-f204-f661795de7bf
msgctxt "h16e8f2f8gfde6g4824gb5dcgb722876c6b97"
msgid ""
"I wasn't about to release seven thousand hungry vampire spawn into the world."
msgstr "이 세상에 굶주린 칠천 마리 뱀파이어 스폰을 풀어놓을 생각은 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = e840c5ae-18e9-860c-fe39-ba90ac37e409
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e840c5ae-18e9-860c-fe39-ba90ac37e409
msgctxt "h0886e578gfd11g4f7bgae73g1405f201f748"
msgid "Of course, whatever you need to tell yourself, darling."
msgstr "물론, 스스로 납득하기 위해서라면 뭐든 말해도 돼, 자기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = e9a98256-efe4-5857-2c06-4e8c121473df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e9a98256-efe4-5857-2c06-4e8c121473df
msgctxt "ha7f18942g0daeg4becg8448g82ee4ba71225"
msgid "I knew you'd come around."
msgstr "그럴 줄 알았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = e9b6884d-b102-f461-2838-aa5e07994ebe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:e9b6884d-b102-f461-2838-aa5e07994ebe
msgctxt "hd3b95813gf045g4322ga7d9g92f086a54bdd"
msgid "Not to become Cazador yourself."
msgstr "카사도어처럼 되지 않는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = eab99404-2ba0-1486-8de4-32c3f9821783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:eab99404-2ba0-1486-8de4-32c3f9821783
msgctxt "h7290467bgc513g405bga8a3g06d526b5b031"
msgid "I already have everything. Except you by my side."
msgstr "난 이미 모든 걸 가졌어. 이제 너만 곁에 있으면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = eafe32b4-0fe7-95e2-ab3f-fa68800c7410
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:eafe32b4-0fe7-95e2-ab3f-fa68800c7410
msgctxt "h446bf7f5g9bc8g4e12gb0efgd430ffe98df6"
msgid "You sweet, sweet thing. I want what's best for you too, of course."
msgstr "이 귀엽고 사랑스러운 것 같으니. 물론, 나도 네게 가장 좋은 걸 주길 원해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = eaff2618-f7d9-b23b-3216-3844e1a1ef80
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:eaff2618-f7d9-b23b-3216-3844e1a1ef80
msgctxt "h177aaef5g98abg4ebfgb2b9g51c19812a9cf"
msgid "Bad girl."
msgstr "나쁜 아이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = eaff2618-f7d9-b23b-3216-3844e1a1ef80
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:eaff2618-f7d9-b23b-3216-3844e1a1ef80
msgctxt "hd4e65032g915ag4c60g9b0bg52466668434c"
msgid "Bad boy."
msgstr "나쁜 아이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = eaff2618-f7d9-b23b-3216-3844e1a1ef80
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:eaff2618-f7d9-b23b-3216-3844e1a1ef80
msgctxt "h3421e83age0beg4efag8112g1d4f8638624f"
msgid "<i>Tut tut</i>. Very bad."
msgstr "<i>어허</i>. 아주 나빠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = ebb45d61-02bd-97f2-2aee-2ecec5b67ef9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ebb45d61-02bd-97f2-2aee-2ecec5b67ef9
msgctxt "hd2dce78cgc841g4bc8gb368gec609c6a681e"
msgid "Hot."
msgstr "달아오르는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = f01f5d17-2bc2-5f3b-5511-ab49906b3651
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f01f5d17-2bc2-5f3b-5511-ab49906b3651
msgctxt "hbd3edff2g31dbg4993gb459gbd2753f03e86"
msgid "It doesn't wipe away the stain he left on the world, though."
msgstr "그렇다 해도, 카사도어가 세상에 남긴 얼룩은 지워지지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = f025fff0-316e-daf4-becd-0d724b9df2ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f025fff0-316e-daf4-becd-0d724b9df2ab
msgctxt "ha29ba743ga87cg4e4fg91e6gd1373214e73d"
msgid "I think I need a little time, honestly."
msgstr "솔직히, 생각할 시간이 좀 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = f12951dc-f215-a034-0b15-60c626de5228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f12951dc-f215-a034-0b15-60c626de5228
msgctxt "hac446ac1g281bg41adg8f0dgad5469c7e22d"
msgid "So... what's next?"
msgstr "그래서... 다음은 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = f129c469-02ba-2f1c-f070-ff3d9fa6f3d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f129c469-02ba-2f1c-f070-ff3d9fa6f3d8
msgctxt "h6f46eba8g80f8g4423gbbf3gfe17db951562"
msgid ""
"Of course if that's not enough - if you need something more - perhaps this "
"isn't for you?"
msgstr "물론 충분하지 않고, 뭔가가 더 필요하다면, 이 방법은 안 맞는 걸지도 모르지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = f1495875-58e9-d32b-f6e7-cc29a6e6afb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f1495875-58e9-d32b-f6e7-cc29a6e6afb1
msgctxt "hf395d29cgc790g4c1bg85bcgea3b766f3406"
msgid "Of course, lead on."
msgstr "물론이지, 앞장서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = f1fee8be-c119-b1d4-3dcc-68973787080e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f1fee8be-c119-b1d4-3dcc-68973787080e
msgctxt "h788094a1g3e70g4f8dgb25cgba6399c16773"
msgid "Oh? Do you want a little fun?"
msgstr "오? 재미 좀 보고 싶어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = f257083e-260a-7afe-44b6-b80411c9707d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f257083e-260a-7afe-44b6-b80411c9707d
msgctxt "h8f3cdc52g6bd5g4e3bg8fdcgf6af01d2369f"
msgid "<i>Give in and kneel</i>."
msgstr "<i>순응하고 무릎 꿇는다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = f4aec2bf-c8a8-d7f7-177d-7fc50d98082e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - GLO_Companion_Leave(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f4aec2bf-c8a8-d7f7-177d-7fc50d98082e
msgctxt "hba9c9fb2ga106g4246g91d2ge6d3b932c836"
msgid "Without me, you'll need it."
msgstr "내가 없으면, 생각을 좀 해야 할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = f51616d3-c219-8390-d6f4-9ed04fbb3d87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f51616d3-c219-8390-d6f4-9ed04fbb3d87
msgctxt "he95146fdgb818g4774g819eg3f5d1603196a"
msgid "We are bound until the end, you and I. But there will be an end."
msgstr "우린 끝까지 함께 해야만 해. 하지만 헤어짐은 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = f561fda1-4aec-6b95-81c1-73d5da75d60a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f561fda1-4aec-6b95-81c1-73d5da75d60a
msgctxt "h7c74475fgd027g4876gbb24g05dbe5e40528"
msgid ""
"That sounds very sincere. Are you sure the parasite hasn't chewed through "
"your brain?"
msgstr "진지하게 들리네. 기생충이 네 뇌를 파먹지 않은 게 확실하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = f732dc9a-1d5c-c8f0-d0e4-f990e3ca7262
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:f732dc9a-1d5c-c8f0-d0e4-f990e3ca7262
msgctxt "hc836a62dg1da6g4b10g8cf4gea85f89ec0a1"
msgid "This way. It's not far."
msgstr "이쪽이야. 멀지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = fa282b62-78f8-a2c9-83b5-ee59d8c26e00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fa282b62-78f8-a2c9-83b5-ee59d8c26e00
msgctxt "h29b7b5dcg77edg4cffg9427gc54e96cc95bf"
msgid "Yes, that's all I want."
msgstr "그래, 그게 내가 원하는 전부야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = fa299de6-575a-8bf8-9006-837d52f88897
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fa299de6-575a-8bf8-9006-837d52f88897
msgctxt "h09913ff8g7be3g4874gaaf0g7d0fafb7e334"
msgid "I think I do."
msgstr "알 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = fa31d009-cb84-6b4f-d774-d6da065474ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fa31d009-cb84-6b4f-d774-d6da065474ec
msgctxt "h76d116c2g4c23g4126g9d6bg78f30d3970b9"
msgid ""
"Come on, let's get back to the camp. If a night of passion isn't on the "
"cards, a night of rest would be very, very welcome."
msgstr "그럼, 이제 야영지로 돌아가자. 열정의 밤을 보낼 계획이 아니라면, 휴식의 밤도 매우, 매우 환영이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = fb12eaca-7d9c-1c6f-b084-8babbdafd751
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fb12eaca-7d9c-1c6f-b084-8babbdafd751
msgctxt "hc6dc0506g7cdeg44c2gbc56g2f0ee72d2ff0"
msgid ""
"You're missing the chance of a lifetime. You will never have another like me."
msgstr "일생일대의 기회를 놓치고 있는 거야. 나 같은 사람은 다신 없을 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = fc355afb-2f9f-6b07-fad6-44d20d4c2526
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fc355afb-2f9f-6b07-fad6-44d20d4c2526
msgctxt "h5e324a59g517eg430fga104ge1cd88157b27"
msgid "Maybe never seeing the sun again is just the price of freedom."
msgstr "다시는 태양을 보지 못하는 게 자유에 대한 대가일지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = fcd49ba1-2986-fdfb-ae2a-f04b4c28b43d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fcd49ba1-2986-fdfb-ae2a-f04b4c28b43d
msgctxt "h5643d4b0g0893g4d66gae21ga119ecba2ad8"
msgid "Are you ready, my darling?"
msgstr "준비됐어, 내 사랑?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = fe51cc66-4005-fed0-c0b5-e0d2e666c96c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fe51cc66-4005-fed0-c0b5-e0d2e666c96c
msgctxt "h3a56e925gc1eeg49c4gae68ge03de2c0dc24"
msgid ""
"Defining yourself by the worst people in your life sounds kind of messed up."
msgstr "인생 최악의 존재로 자신을 정의하는 건 좀 아니라고 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = fe6c035b-b1a5-08d1-e8e6-6d3402752e88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:fe6c035b-b1a5-08d1-e8e6-6d3402752e88
msgctxt "h9da57ca4g26a4g4d2dg9a70gaac61deb89a3"
msgid ""
"I'd spend every day waiting for something to go wrong. For the tadpole to "
"find some new trick, reassert itself, and make me a slave again."
msgstr ""
"매일 뭔가 잘못되길 기다리면서 하루하루를 보낼거야. 올챙이가 새로운 수를 찾아 스스로 진화한 뒤에 날 다시 노예로 만들까, 계속 "
"걱정하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Player
#. NodeID = ff9db4b2-1e03-68e9-f71e-4d1384b82d12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ff9db4b2-1e03-68e9-f71e-4d1384b82d12
msgctxt "hb580179dgb2b6g4220gb92ag24a1b7dde65e"
msgid ""
"You're not out of the woods yet - we still have the parasites to deal with."
msgstr "그런 걸 생각할 시간이 아니야 - 해결해야 할 기생충이 남아있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath
#. Speaker = Astarion
#. NodeID = ffa25101-b6d8-7a02-93d5-aaf95b3bc0cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BlackMassAftermath:ffa25101-b6d8-7a02-93d5-aaf95b3bc0cd
msgctxt "h401fdc9ag9cceg496ega65dg63897c91b5d9"
msgid "If a night of passion is on offer, I could be persuaded."
msgstr "열정적인 밤을 제안하는 거라면, 설득될 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 0356d330-41ab-cc06-9aeb-1e89c292fb83
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_BloodMerchantAftermath_ToxicBreakup = True
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - ORI_State_DatingAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:0356d330-41ab-cc06-9aeb-1e89c292fb83
msgctxt "h978f7e4fge091g4f37g9848gd221fcaed625"
msgid ""
"Huh. We shouldn't be involved with each other any more. I'll sleep alone."
msgstr "허. 더 이상 서로 엮일 필요가 없을 것 같네. 혼자 잘 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 050744af-7882-75b4-8f25-67d1f8856822
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:050744af-7882-75b4-8f25-67d1f8856822
msgctxt "h58b774a8gcc2cg4831gac80gd63da2f779c1"
msgid "I slept with you because I wanted some fun, not to deal with this."
msgstr "난 재미를 원했지, 이 문제를 해결하려고 너랑 잔 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 05693658-d64f-a522-4abe-aa803525da26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:05693658-d64f-a522-4abe-aa803525da26
msgctxt "hed1ae8c0g24e3g46aag827cg7dafaac0879e"
msgid "I can still taste that vile drow in my throat."
msgstr "아직도 목에서 그 사악한 드로우가 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 056d22ef-fb57-cffd-582d-8c24dd8adda0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:056d22ef-fb57-cffd-582d-8c24dd8adda0
msgctxt "h917eb45bgc103g41dbg96a5g39bb39b55ce3"
msgid ""
"I was just defiled by that creature, and you let it happen. You made it "
"happen!"
msgstr "난 방금 그 괴물에게 더럽혀졌고, 넌 그걸 내버려 뒀어. 네가 그렇게 만들었어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 08a6cabc-f94f-9ed3-d9cd-c367216517dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:08a6cabc-f94f-9ed3-d9cd-c367216517dd
msgctxt "hee8b59b3g3e48g4c2fg9144gdb7b251f84b3"
msgid ""
"Trust me, I was not happy about it. You were a complication I didn't see "
"coming. And yet..."
msgstr "정말이지, 기분 안 좋았어. 예상치 못한 문제였거든. 그렇다 해도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 08d47bf2-d778-24aa-1784-7a4811f85278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:08d47bf2-d778-24aa-1784-7a4811f85278
msgctxt "hfcb2c2acg6bfeg439fg8bd8gf37a122bda27"
msgid "Of course they did - that's the problem! Or part of it."
msgstr "물론 그랬지. 그게 문제인 거야! 어쩌면 일부는 그랬을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 09c335bb-a3b8-617f-eac5-a9ed196bd99d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:09c335bb-a3b8-617f-eac5-a9ed196bd99d
msgctxt "h7cde06e8g369bg4918g8197g7c36659142e1"
msgid "It's a game I'm tired of playing. Being used."
msgstr "그런 게임은 이제 지겨워. 이용당하는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 0b9f2cdc-a011-af04-83e3-b1d9be7810d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:0b9f2cdc-a011-af04-83e3-b1d9be7810d6
msgctxt "h9de8d131gf3d3g4d52gb185gce2763fc1ce7"
msgid "...I don't know what to think. I don't know what I want."
msgstr "...뭘 생각해야 할지 모르겠어. 내가 뭘 원하는지도 모르겠고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 150c6546-0f84-1d6d-7439-50f04942e92c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:150c6546-0f84-1d6d-7439-50f04942e92c
msgctxt "h427fb644ga072g46f4g9661gf58ffcccbe5f"
msgid "I- I'm not sure if I should."
msgstr "그 - 그래야 하는 건가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 1574c2af-3531-e361-017d-c3d355b71db2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:1574c2af-3531-e361-017d-c3d355b71db2
msgctxt "h06c7f098gc22ag4585gab88g529a7fef0c76"
msgid "I'm not interested in hearing it."
msgstr "흥미 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 17501b41-58d5-9171-2240-11d1e749047d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:17501b41-58d5-9171-2240-11d1e749047d
msgctxt "h8cdfef9cg5b48g420dg9a42g2ad40d294401"
msgid "Were you even attracted to me? Or was it all a lie?"
msgstr "끌리긴 한 거야? 아니면 전부 거짓말이었어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 18945ac3-bfb9-258b-3243-dee10fe5eae9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:18945ac3-bfb9-258b-3243-dee10fe5eae9
msgctxt "hf2e1ef8eg1f6fg42b9ga88cgea87a96e174d"
msgid "Don't tell me it was bad for you?"
msgstr "안 좋았다고 말하려는 건 아니지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 193319c4-536a-996b-ff74-e23d3887c0c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:193319c4-536a-996b-ff74-e23d3887c0c8
msgctxt "h03511b73g225dg44adgb0f7g53dcc7fa8592"
msgid "This is all a game to you, isn't it?"
msgstr "너한테는 이게 다 게임이겠지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 1ba56753-5107-47f3-3183-496fa3cedbc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:1ba56753-5107-47f3-3183-496fa3cedbc9
msgctxt "hf83bdd12g727dg4382gb465g6e100df5df79"
msgid "Now I couldn't stand to do it again."
msgstr "이제 다시는 그런 짓을 못하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 1f5f8027-811b-8863-0303-975eb5ef78d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:1f5f8027-811b-8863-0303-975eb5ef78d7
msgctxt "h92db64c1g4b7dg4b92gbd84g27b64ae109b5"
msgid "It's all right. I didn't expect myself to feel anything."
msgstr "괜찮아. 나도 아무 느낌이 없었을 줄은 몰랐으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 1f633e7a-40a7-1f85-47c3-893afee83017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:1f633e7a-40a7-1f85-47c3-893afee83017
msgctxt "h889835beg2476g425agb015g3ff0bd0d57e4"
msgid "Until you."
msgstr "널 만나기 전까지는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 21f0d3bf-ad0d-0c89-1bfd-6ed5fdf6d687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:21f0d3bf-ad0d-0c89-1bfd-6ed5fdf6d687
msgctxt "ha498ccd3g4817g40e6g8befg6b01927a9e0e"
msgid "You... you are full of surprises, aren't you?"
msgstr "너... 넌 정말 알면 알수록 신기한 녀석이야, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 23d4657c-34fb-6ae5-99c4-9490408eeda4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:23d4657c-34fb-6ae5-99c4-9490408eeda4
msgctxt "h84d00a71g0c94g4655g917ag6d8180aba8e8"
msgid ""
"I just don't know what 'real' looks like. Not after two hundred years "
"playing the rake."
msgstr "'진짜'가 뭔지 모르겠어. 200년간 천박하게 살아왔으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 25415c6d-5356-448f-8b50-a336dbb43dc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:25415c6d-5356-448f-8b50-a336dbb43dc1
msgctxt "hd8cfa691gfd60g4092gb0edg25647faf8507"
msgid ""
"You -... you're incredible. You deserve something real. I want us to be "
"something real."
msgstr "너... 넌 정말 대단해. 진짜를 가질 자격이 있어. 우리 사이가 진짜가 되었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 25fc58c7-68a3-d486-75e0-8bc4938f1df5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:25fc58c7-68a3-d486-75e0-8bc4938f1df5
msgctxt "h2a10f0f1gc889g4ea3g9af1g02bec5b49f02"
msgid "You're a vision. And you're so much more than that."
msgstr "미의 화신이야. 그 이상이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 260bb5ab-1f24-d0ae-66e6-11c3deebac8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:260bb5ab-1f24-d0ae-66e6-11c3deebac8f
msgctxt "he09e5e5ag73d3g47b3ga415g5e1322eb2524"
msgid "So the nights we spent together didn't mean anything?"
msgstr "그럼 함께 보냈던 밤들은 아무 의미가 없었던 거네?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 2630ad44-b31a-9976-7eeb-a0f5f7190848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2630ad44-b31a-9976-7eeb-a0f5f7190848
msgctxt "h1e8d7e39g2a1eg465bgb5ceg5005c480fc37"
msgid ""
"It would have been so easy to bite her. To just go along with what I was "
"being told to do."
msgstr "그 여자를 무는 건 쉬운 일이었어. 시키는 대로 하기만 하면 됐으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 273aba93-3960-8b7e-ddb7-2eb5e996661f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:273aba93-3960-8b7e-ddb7-2eb5e996661f
msgctxt "h6f59ce75ga827g47edgb28dgfaa8a32f326a"
msgid "Not interested."
msgstr "흥미 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 28ae6932-7a2e-f26a-d943-31cc774f6d28
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:28ae6932-7a2e-f26a-d943-31cc774f6d28
msgctxt "h22f11986g0da4g471ag910cga50d0e6eea82"
msgid "But I know that this? This is nice."
msgstr "그런데 이건, 정말 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 295bfd3d-e5af-9d5e-2d74-865ea745744b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:295bfd3d-e5af-9d5e-2d74-865ea745744b
msgctxt "h43baf08ag13b3g4718ga24dg78f22ea8a929"
msgid "Why the Hells did you agree to sleep with me, then?"
msgstr "그럼 대체 왜 나랑 자겠다고 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 2a510efe-a717-2e0d-5165-e74027ace57b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2a510efe-a717-2e0d-5165-e74027ace57b
msgctxt "h22b3a0eeg1b62g4b25g953bg9d31449ba536"
msgid "So you say."
msgstr "그게 네 생각이구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 2bf483b3-9330-3f1d-df10-953c6e181e8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2bf483b3-9330-3f1d-df10-953c6e181e8c
msgctxt "hc65350cbga292g4f12ga610g917b8a0ef717"
msgid "I'm sorry."
msgstr "미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 2c1cd05f-27e5-54a7-42eb-90a70a122dff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2c1cd05f-27e5-54a7-42eb-90a70a122dff
msgctxt "hf3776122ga7eeg4a83gbdfcg827595506851"
msgid "Of course not, it hurts to even hear you <i>say </i>that."
msgstr "물론 아니지, <i>그런 </i>말을 하는 걸 듣는 것만으로도 맘이 아픈데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 2c6b5da5-6add-85f0-e4d6-657085fea20c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2c6b5da5-6add-85f0-e4d6-657085fea20c
msgctxt "hc1ee689ageda6g4a0cg95b5g6cdfb0a7bc4d"
msgid "For what you said while I was in front of that vile drow."
msgstr "그 불쾌한 드로우 앞에 있었을 때 네가 했던 말 때문에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 2ca1b1b9-5ae1-0280-6e90-4fa89b4106d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2ca1b1b9-5ae1-0280-6e90-4fa89b4106d2
msgctxt "h36f12cabg6c5dg4d39g8a6dg95116a481ad7"
msgid "I've seduced people who repulsed me more times than I can count."
msgstr "날 거부하는 사람들을 셀 수 없을 정도로 많이 유혹했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 2dd137d8-76bb-27b8-006d-ea3708acbc70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2dd137d8-76bb-27b8-006d-ea3708acbc70
msgctxt "hba16a058g68d0g448cga781gd36440a486a8"
msgid "Of course, I needed protection."
msgstr "물론이야, 난 보호가 필요했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 2dfdb3fa-24b3-db75-e22a-4627e443e123
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:2dfdb3fa-24b3-db75-e22a-4627e443e123
msgctxt "he4eb73f0gd963g491dg94ffg403b5d80af36"
msgid ""
"I spent two hundred years using my body to lure pretty things back for my "
"Master. What I wanted, how I felt about what I was doing, it never mattered."
msgstr ""
"200년 동안 몸으로 주인에게 줄 예쁜 것들을 유인했어. 내가 원하는 거나, 이 일을 하면서 느끼는 감정이나, 전부 중요하지 않았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 314fff97-1d9b-c5e0-868a-cb1b22c600b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:314fff97-1d9b-c5e0-868a-cb1b22c600b7
msgctxt "h591a013dgf82dg4e7dgae22gc57a0d9dc18f"
msgid "But I know that this? This is nice."
msgstr "그런데 이건, 정말 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 3471ee11-d86e-adbd-ffe7-03d53a44043b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:3471ee11-d86e-adbd-ffe7-03d53a44043b
msgctxt "h7d55fd3ag9431g4868gb87dg2b7810c35680"
msgid "I shouldn't have pushed you to bite her."
msgstr "그 여자를 물도록 강요하지 말았어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 37497383-8813-0e49-08d5-c5dc5245a895
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - ORI_State_DatingAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:37497383-8813-0e49-08d5-c5dc5245a895
msgctxt "h4d0c3f33ga64bg4da0g9252gbd7ad0caee15"
msgid "It seems I was wrong about you. About us."
msgstr "너에 대해 큰 착각을 하고 있었나 보네. 우리에 대해서도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 380686b7-fef4-e05e-6f96-23b6dc93fed0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:380686b7-fef4-e05e-6f96-23b6dc93fed0
msgctxt "h8c61d223gf2a2g4a0cga5dbg861525ad2bad"
msgid "It should've just been another moment of disgust for greater reward."
msgstr "이것도 더 큰 보상을 위한 또 다른 역겨움의 순간이었을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 396e16a0-595c-358b-a7ac-0177733055cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:396e16a0-595c-358b-a7ac-0177733055cc
msgctxt "hf40303e2g032cg455bg8eadga1d471742eef"
msgid ""
"You made me see I never stopped thinking like I was still his slave, even in "
"freedom."
msgstr "넌 내가 여전히 그의 노예인 듯 생각하고 있었다는 걸 깨닫게 해줬어, 이 자유 속에서도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 3aa0b9cb-0241-7883-6476-204049d2c032
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:3aa0b9cb-0241-7883-6476-204049d2c032
msgctxt "h2781196bgc87ag4405g85cbgb256c83fb429"
msgid "<i>Sigh</i>."
msgstr "<i>하아</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 3dc755a0-818f-ace3-002b-a83973efc5f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:3dc755a0-818f-ace3-002b-a83973efc5f3
msgctxt "h52c5575cg0e4ag4a0dgbc13gaf81f0fdcd35"
msgid "What a <i>novel </i>idea!"
msgstr "정말 <i>참신한</i> 생각이네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 40259754-f081-35aa-8fdd-affc29d2c68d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:40259754-f081-35aa-8fdd-affc29d2c68d
msgctxt "h63983951g9df1g4108gbadcg078311232a18"
msgid "I've held more people than I can count. An infinite parade of lovers."
msgstr "셀 수 없이 많은 사람들을 안아 봤어. 끝없는 연인들의 향연이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 407eafdf-4626-a342-4c6a-6f4be5197da6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:407eafdf-4626-a342-4c6a-6f4be5197da6
msgctxt "h59f5ac7egfc1ag4571g9887g625a141c222d"
msgid "Just repressed it and moved on? Sounds healthy."
msgstr "그냥 억누르고 지나갔다고? 참 건강한 방법이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 41145279-4454-b252-bedb-28ccf5318751
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:41145279-4454-b252-bedb-28ccf5318751
msgctxt "hd7f8df98ge0e7g4992gb9a2g118c95760ea0"
msgid "For what?"
msgstr "뭐를?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 43383219-79e6-2838-236e-2cd9067acbac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:43383219-79e6-2838-236e-2cd9067acbac
msgctxt "h22d76b69g0215g4491g9dc8g8d2003c16fdf"
msgid "I'm sure I can take your mind off her..."
msgstr "내가 그 여자를 잊게 해줄 수 있을 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 43d5c776-9bd6-a4db-63b7-083e8e443b6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:43d5c776-9bd6-a4db-63b7-083e8e443b6c
msgctxt "h9c4ae6cag19a6g4c4bgbca4g67111a908dae"
msgid "How often were you disgusted by your targets?"
msgstr "상대한 사람들에게 얼마나 자주 혐오감을 느꼈어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 455f8d86-08dd-176d-7848-b8eeb1095b07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:455f8d86-08dd-176d-7848-b8eeb1095b07
msgctxt "h973d3345gf972g4fc3g9abdg25e6e1dc58dd"
msgid "You are worth a great deal to me, no matter what you are going through."
msgstr "어떤 일을 겪고 있든 간에, 넌 내게 매우 가치 있는 존재야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 46f426ca-0084-8e80-058f-24ff5dae217a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:46f426ca-0084-8e80-058f-24ff5dae217a
msgctxt "h5dacc966g0546g4d8dgba06g622ecfab6ded"
msgid "I don't know if I want anyone to."
msgstr "다른 사람들도 날 그렇게 보지 않았으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 48f9d842-0cfb-ecae-fb4f-2d5c13adb47e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:48f9d842-0cfb-ecae-fb4f-2d5c13adb47e
msgctxt "h202e1affgf244g49adga1ebga5b29b96e2b0"
msgid "I care about you."
msgstr "널 신경 쓰고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 4af55f61-76e8-7cbc-2a7f-e5d79950ba8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:4af55f61-76e8-7cbc-2a7f-e5d79950ba8f
msgctxt "h1d8bf1cdg9aacg4ecbg80c9g8377ea49e859"
msgid ""
"You could have asked me to do the same - to throw myself at her, what I "
"wanted be damned. But you didn't. And I'm grateful."
msgstr ""
"너도 똑같이 해달라고 부탁할 수 있었어. 원하는 대로, 그 여자한테 몸을 던지게끔 할 수 있었다고. 넌 그러지 않았어. 그게 정말 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 4cb7b449-ff2d-7c59-7185-0a784efd1507
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:4cb7b449-ff2d-7c59-7185-0a784efd1507
msgctxt "h050f1abfg5e5fg4f43gb335g2b6e168d3228"
msgid ""
"Perhaps it's better if we don't continue with whatever this was. Perhaps "
"we'll both be better for it."
msgstr "뭔진 몰라도 이 이상 이어가지 않는 게 낫겠어. 우리 둘 다 더 나아질지도 모르고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 4eed4d71-4386-d3c1-9655-7638fc658b9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:4eed4d71-4386-d3c1-9655-7638fc658b9b
msgctxt "h145f695fg94aag42d5gbfacgabf3cf0f8867"
msgid "Oh, don't look at me like that. I'm as surprised as you are."
msgstr "오, 그런 눈으로 보지 마. 나도 너만큼 놀랐으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 50ad3923-0b21-0995-db61-bc75fd6fc1b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:50ad3923-0b21-0995-db61-bc75fd6fc1b5
msgctxt "h769c5f5fgc34cg43b8ga623g5a51f16e14c0"
msgid "You make your own choices now - for better or worse."
msgstr "이제 스스로 선택해 - 좋은 거든, 나쁜 거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 50f9a49d-ac48-45c5-8d64-6f5c288b238b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:50f9a49d-ac48-45c5-8d64-6f5c288b238b
msgctxt "he3b5d3f2g4d5ag4767gbde4g5c6a0b6b17fc"
msgid "I didn't know how to say no."
msgstr "거절하는 방법을 몰랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 53556dec-4a0f-7d0a-672e-599a2792d1eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:53556dec-4a0f-7d0a-672e-599a2792d1eb
msgctxt "hc0841cb8ga28eg464fg89c1ge3e7f5f8adc1"
msgid "I'm not like all the others, I promise."
msgstr "다른 사람들과는 다를 거야, 약속해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 55423f2a-256b-cfc5-c0a1-f251553f871d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:55423f2a-256b-cfc5-c0a1-f251553f871d
msgctxt "hb796cdd6ge5c5g4c41ga315g3c41159fc4d1"
msgid "For you maybe."
msgstr "너한테는 그렇겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 564a471f-e1b7-e4c5-48c5-66b017a5dc32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:564a471f-e1b7-e4c5-48c5-66b017a5dc32
msgctxt "ha2047d15g01b3g43a5ga687gbd868b81be4f"
msgid ""
"I didn't think twice when the moment came, but now I can't get it off my "
"mind."
msgstr "그때는 두 번 생각하지 않았지만, 지금은 그 생각을 떨쳐버릴 수가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 579821aa-e536-b856-8663-18c69b1c5760
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:579821aa-e536-b856-8663-18c69b1c5760
msgctxt "h78f7ff15g0afeg47bbg9899ga9f103753529"
msgid "If you have something to say, say it."
msgstr "할 말이 있으면, 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 57fd916e-5fdd-66ea-85c9-3132cc242008
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:57fd916e-5fdd-66ea-85c9-3132cc242008
msgctxt "hfbc06845g22f9g47d7gae1bg16732d170fa4"
msgid "Oh yes, I'm fine. I just-... feel awful."
msgstr "어 그래, 괜찮아. 그냥...끔찍한 기분이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 5a34a2e8-47b0-0abd-95eb-8937e87f7f6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:5a34a2e8-47b0-0abd-95eb-8937e87f7f6d
msgctxt "h84c53b8eg46eag4c0dg93d8gbaee15b77f75"
msgid "Really?"
msgstr "정말?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 5cb3b362-e0c8-f6ef-d1dd-af48195cfea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:5cb3b362-e0c8-f6ef-d1dd-af48195cfea2
msgctxt "h8643a6d3g93e3g4613g8f31g15be658d1fcb"
msgid "Are you all right? What's wrong?"
msgstr "괜찮아? 무슨 일 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 5da79115-6366-0adf-2628-2c0fb115eeb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:5da79115-6366-0adf-2628-2c0fb115eeb6
msgctxt "h95a9ef0cgf86dg43bdgb73bgc3bd62458e8e"
msgid "Are you all right?"
msgstr "괜찮아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 5f5a1edf-0320-8792-2027-484a1f9a300b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:5f5a1edf-0320-8792-2027-484a1f9a300b
msgctxt "hc1ca57b1g0f3fg4dffgb49ag3fdf941c1691"
msgid "Still not interested."
msgstr "여전히 흥미 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 650e91ef-7840-120a-b5a7-53edc51cc9f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:650e91ef-7840-120a-b5a7-53edc51cc9f1
msgctxt "h81b0c5d2g7c16g4ce6gbcdcgb2c2445728fb"
msgid "I didn't expect it to bother you at all."
msgstr "신경 쓰이게 할 줄은 몰랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 66096c8a-ee9f-57db-c083-2c2e9e23565f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:66096c8a-ee9f-57db-c083-2c2e9e23565f
msgctxt "hee742724g620ag4f97g9891g4bc0ef922564"
msgid "Yes it was."
msgstr "그래 내 선택이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 680f6696-158b-e304-98ac-cc6d6551d9df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:680f6696-158b-e304-98ac-cc6d6551d9df
msgctxt "h018f8b61g4194g4c1eg86f0gebf5efbe1d8f"
msgid ""
"For as long as I can remember, I've been used by others. Controlled and "
"puppeted for someone else's pleasure. But not anymore."
msgstr ""
"기억할 수 있는 한, 나는 늘 다른 이들에게 이용당했어. 타인의 쾌락을 위해 통제당하고 꼭두각시처럼 쓰였지. 하지만 이젠 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 6dc1cbc0-3862-396f-c1d0-4dd3a6ec61c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:6dc1cbc0-3862-396f-c1d0-4dd3a6ec61c9
msgctxt "h4f6f6b3cgc252g4813gb0fbg420ca397c1ed"
msgid "What do you <i>want</i> to do?"
msgstr "<i>뭘</i> 하고 싶어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 700be45a-db9d-abce-e8f3-b84c49ed1e74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:700be45a-db9d-abce-e8f3-b84c49ed1e74
msgctxt "h5cfe7590g030cg42a5gb050g716cbf7583cc"
msgid "You make your own choices now - for better or worse."
msgstr "이제 스스로 선택해 - 좋은 거든, 나쁜 거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 718481b1-2259-abec-7225-990ce761e2f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:718481b1-2259-abec-7225-990ce761e2f4
msgctxt "hd2d2ff29g0cc8g4224gbd50ge68b7e165a75"
msgid ""
"Not last night, though. Last night I felt miserable, and it was a revelation."
msgstr "하지만, 어젯밤은 달랐어. 난 비참함을 느꼈고, 그걸로 깨달았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 719da6e6-61da-40bb-8b9e-586e90857a7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:719da6e6-61da-40bb-8b9e-586e90857a7a
msgctxt "h690141cdg84a1g4219gadf3g67a87fa275f6"
msgid ""
"I'm so used to my body being used as a tool to get what someone else wants. "
"But I'm free now. It shouldn't be like that."
msgstr "타인이 원하는 걸 얻기 위한 도구로 내 몸이 쓰이는 것에 너무 익숙해졌어. 하지만 이제 난 자유야. 이젠 그렇게 되면 안 되지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 7332200e-7eee-6899-c7db-0cb957f85161
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:7332200e-7eee-6899-c7db-0cb957f85161
msgctxt "h6f07778cgeae5g4438gb9b5gbf1d2f1b6f15"
msgid "For being so <i>wonderful</i> in bed?"
msgstr "침대에서 너무 <i>환상적이었어서</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 7463e874-c5ab-828b-0faa-3a196955c77f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:7463e874-c5ab-828b-0faa-3a196955c77f
msgctxt "h53a6a518gc841g4d2eg9df5g7fa344591c76"
msgid ""
"Look, I had a plan. A nice, simple plan - seduce you, sleep with you, "
"manipulate your feelings so you'd never turn on me."
msgstr ""
"있지, 나한테 계획이 있었어. 멋지고, 간단한 계획 말이야. 널 유혹하고, 같이 자고, 감정을 맘대로 조종해서 날 절대 배신하지 못하게 "
"하려는 거였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 7854b9f2-24a2-dab5-95bf-c94ce939e852
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:7854b9f2-24a2-dab5-95bf-c94ce939e852
msgctxt "h292a1bceg9d5bg4991g8bc4gd7d2b08a4537"
msgid "It was your choice."
msgstr "네 선택이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 7a0e5688-f413-4e58-b372-5ca511a8483d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:7a0e5688-f413-4e58-b372-5ca511a8483d
msgctxt "h36d92e04g99c5g473cg8982g146342ee8cd2"
msgid "I don't think I want you to think of me in terms of sex."
msgstr "날 그냥 섹스 대상으로 생각하지 않아 줬으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 7ae9d84b-a921-2801-32d2-2344a4214a9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BloodMerchant_State_ConvincedAstarionToDrinkBlood = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:7ae9d84b-a921-2801-32d2-2344a4214a9b
msgctxt "h0647e25dg4042g4da5g85e8g5b6930135258"
msgid "I want to thank you."
msgstr "네게 감사하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 7d51a787-dac9-7ba8-71b7-7ea46213d2ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:7d51a787-dac9-7ba8-71b7-7ea46213d2ce
msgctxt "hca03aef6g0f44g468cg8890g4f222875d4df"
msgid ""
"Excuse me? This might be the first honest thing I've ever told you and "
"you're 'not interested'?"
msgstr "저기? 너한테 처음으로 솔직하게 말하는 건데 '흥미가 없어'?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 7e8d18c9-b237-e941-9409-a083a8f920e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BloodMerchant_State_BloodMerchantOMHappened = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:7e8d18c9-b237-e941-9409-a083a8f920e5
msgctxt "h28a66487g81d9g40aega085gbac0a08fb9d4"
msgid "Do you have a moment? I think we need to talk."
msgstr "잠깐 시간 있어? 얘기를 좀 해야겠어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 81c970a0-637f-01a1-dba1-596912cfb64b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:81c970a0-637f-01a1-dba1-596912cfb64b
msgctxt "he1ac5fb6g8db4g4719gb1c6gb22843f1e476"
msgid "Of course I was attracted to you. Look at you, for goodness' sake!"
msgstr "당연히 너한테 끌렸지. 널 좀 보라고, 제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 8368a389-3b71-792b-16c6-f38e23689375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:8368a389-3b71-792b-16c6-f38e23689375
msgctxt "hd3013865g630fg48b3ga8e9g4cc6fb61b791"
msgid "So why sleep with me? Did you think you'd get something from it?"
msgstr "그럼 왜 나랑 잔 거야? 뭘 얻을 수 있을 거라 생각했어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 8550c9d8-3825-a4e9-2c02-c8b6329e8605
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:8550c9d8-3825-a4e9-2c02-c8b6329e8605
msgctxt "h0fdd3a79gc270g49b7gb7d3gd95e80f98cdf"
msgid ""
"Even though I know things between us are different, being with someone still "
"feels... tainted. Still brings up those feelings of disgust and loathing."
msgstr ""
"우리 사이가 그런 것들과 차이가 있다는 건 알지만, 누군가와 함께 있으면 여전히... 더럽혀진 기분이야. 여전히 혐오감과 증오심을 "
"불러일으켜."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 86b40576-7e16-8e63-7f12-b8364dea1ac1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:86b40576-7e16-8e63-7f12-b8364dea1ac1
msgctxt "h64b72506g6c84g403dgb3abg93e9e47b6a6a"
msgid "How dare you! We're <i>done</i>."
msgstr "어떻게 이럴 수 있어! 우린 <i>끝이야</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 8a9d6b2a-6cce-6c3b-9eab-2e1589d47bb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:8a9d6b2a-6cce-6c3b-9eab-2e1589d47bb1
msgctxt "h5feb9fa6ga2ccg413eg9632g181a1ce22204"
msgid ""
"Of course I did, I know that dance better than anyone. But I always felt "
"nothing."
msgstr "물론 그랬지, 난 누구보다 섹스에 대해 잘 알고 있다고. 하지만 항상 아무 감흥도 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 8adaf79e-6fb8-9425-b6b9-765a327a042a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:8adaf79e-6fb8-9425-b6b9-765a327a042a
msgctxt "h64d10378gfc3ag4aafga1f5g4058c3da8dc5"
msgid "I forced <i>myself</i> to bite her."
msgstr "난 <i>억지로</i> 그 여자를 물었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 8e02d15b-61ff-c093-1e0c-484d8509fe41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:8e02d15b-61ff-c093-1e0c-484d8509fe41
msgctxt "h7daa4377gd7d0g4a09gaf60g1f8b0dc81ac4"
msgid "But a friend? I can't think of a single one."
msgstr "하지만 친구? 떠오르는 사람이 단 한 명도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 8fe92b3a-91c1-fe23-a933-6e7ddb31a632
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:8fe92b3a-91c1-fe23-a933-6e7ddb31a632
msgctxt "h0fcfa68eg8a9ag4f6dg9ad9g87bddd03419f"
msgid "No matter what I say, it doesn't matter. Not if you get what you want."
msgstr "내가 뭐라 말하든, 상관 없어. 네가 원하는 걸 얻으면 끝이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 90739d94-4ba9-4393-6e0c-e4a03374a06c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:90739d94-4ba9-4393-6e0c-e4a03374a06c
msgctxt "h98f729b1gc487g43d3g920egc3e727837a84"
msgid ""
"Well, you got what you wanted. An apology doesn't mean much at this point."
msgstr "뭐, 넌 원하는 걸 얻었잖아. 사과가 지금의 상황을 바꿔주지는 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 90e98659-bb17-ad4c-52ad-5c13f83fdc40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:90e98659-bb17-ad4c-52ad-5c13f83fdc40
msgctxt "h4f86301dg49b8g44f8gbfa8g4ac5d0fef243"
msgid ""
"Really? After something like that, you think that's what I'm looking for?"
msgstr "정말? 그런 일이 있고 난 뒤에, 내가 그런 걸 원할 거로 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 9966d201-6115-f45e-14cb-184b2cfc8362
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_TheHungerC_Bite = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:9966d201-6115-f45e-14cb-184b2cfc8362
msgctxt "hee986e57g1a70g4c86gb9d7g1beeb0cbb110"
msgid "For having such delectable blood?"
msgstr "맛있는 피를 가지고 있어서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 99bbb7b9-789f-e9b6-f7fb-d7e4048a38f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:99bbb7b9-789f-e9b6-f7fb-d7e4048a38f8
msgctxt "h18cdd0d3g6e66g4ce4gbf88gee97a5e6d47a"
msgid "Honestly, I have no idea what we're doing. Or what comes next."
msgstr "솔직히, 뭘 하고 있는지 모르겠어. 이다음에 무슨 일이 일어날지도 모르겠고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 9baf6856-4b4f-5404-8997-252a5b44f423
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:9baf6856-4b4f-5404-8997-252a5b44f423
msgctxt "h79b0f942gabc8g46aegb0a0g2eabd554d4d5"
msgid "You can still throw your body at me, any time."
msgstr "언제든 내게 몸을 던져도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = 9d8aae65-6d9a-f104-87c6-684b40e116ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:9d8aae65-6d9a-f104-87c6-684b40e116ac
msgctxt "hd6e6a3acgef1bg49b8g8916ga0f537fe39b5"
msgid "I regret stopping you. That potion would've really helped."
msgstr "막은 게 후회돼. 그 물약이 정말 도움이 됐을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = 9f5f56ff-ad45-7d7c-8924-eb0f18693f37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:9f5f56ff-ad45-7d7c-8924-eb0f18693f37
msgctxt "h4fa18dc8g1a55g4240gbf96g326184970d5d"
msgid ""
"And all I had to do was not fall for you... Which is where my nice, simple "
"plan fell apart."
msgstr "그리고 내가 해야 할 일은 너한테 빠지지 않는 것뿐이었어... 거기서 내 멋지고 간단한 계획이 틀어졌고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = a0eaf5ea-bf9d-d8af-cd78-021cce9e0fe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:a0eaf5ea-bf9d-d8af-cd78-021cce9e0fe1
msgctxt "h8ae2e07egbdcfg41b4g99f6geb9d1785f718"
msgid "But I do now."
msgstr "하지만 이젠 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = a4963713-ca4e-c366-3192-1bf37cdfb2fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:a4963713-ca4e-c366-3192-1bf37cdfb2fc
msgctxt "hcad4a136g47c7g4e2dg8422g7d66ab691f84"
msgid "I suppose it has felt different with you..."
msgstr "너와 함께 있을 때는 느낌이 좀 달랐던 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = a4b81a52-f954-b7b7-e1de-da639096fc4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:a4b81a52-f954-b7b7-e1de-da639096fc4d
msgctxt "hd88572dcg13ccg45fdgb1c2g614af75889e0"
msgid "The entire reason for my existence was to seduce anything with a pulse."
msgstr "내 존재 이유는 맥이 뛰는 모든 걸 유혹하기 위해서였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = a56414e0-3cd2-2f21-acd3-e69e84b801ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:a56414e0-3cd2-2f21-acd3-e69e84b801ef
msgctxt "hfed740c6ga3d3g4392gb063g14f5f584e6cf"
msgid "How do you want me to see you?"
msgstr "널 어떻게 보길 바라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = a61721ca-8928-e165-afaf-4cda186e424b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:a61721ca-8928-e165-afaf-4cda186e424b
msgctxt "he4f9e50cg3f8cg4881ga5c5g687d9c8ab519"
msgid ""
"It's been so long since I've had to make these decisions for myself. I won't "
"lie, it's a daunting prospect."
msgstr "스스로 이런 결정을 내려본 지가 너무 오랜만이야. 거짓말 안 하고, 두려운 일이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = a6737d2b-69c1-9df0-193d-cd3a1ed2fced
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:a6737d2b-69c1-9df0-193d-cd3a1ed2fced
msgctxt "h44e6af94ge693g43e3g85bfg816f4447072d"
msgid "<i>Hug him</i>."
msgstr "<i>그를 끌어안는다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = b02eb6d7-72b2-0971-969b-adfb0a836c92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:b02eb6d7-72b2-0971-969b-adfb0a836c92
msgctxt "he702e224gda11g4293g8858g6b413330d7d4"
msgid "Of course I am - look at you!"
msgstr "물론 끌리지! 널 보라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = b1f9d414-ab5f-e6ea-e471-7f1d6b6f8ad1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:b1f9d414-ab5f-e6ea-e471-7f1d6b6f8ad1
msgctxt "hf0d8c5a0g78b9g4e91g9a5ag8c7c10978b80"
msgid ""
"It was easy - instinctive. Habits from two hundred years of charming people "
"kicked in. All you had to do was fall for it."
msgstr "간단했어, 본능적인 거였지. 사람을 매혹시키는 200년의 습성이 작용했을 뿐이야. 넌 거기 빠져들기만 하면 됐고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = b2159bb0-560f-6134-9043-78345b9c76f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:b2159bb0-560f-6134-9043-78345b9c76f6
msgctxt "h552f570ag437dg40b8g8ba6g17caba391402"
msgid "We can be together without sleeping together, for as long as you need."
msgstr "함께 자지 않고도, 필요한 만큼 오래 함께할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = b24e2f48-45bf-5cc8-d7c3-1fc0bb80bbe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:b24e2f48-45bf-5cc8-d7c3-1fc0bb80bbe1
msgctxt "h095dcc25ga584g408bga414g80453eda4ffd"
msgid "You're welcome?"
msgstr "천만에?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = b391b056-e2b6-0aaa-7b9c-b20374dd9fcc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - ORI_State_DatingAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:b391b056-e2b6-0aaa-7b9c-b20374dd9fcc
msgctxt "hdf77ae57gaa16g4b4aga853g3b2833d7c808"
msgid ""
"Yes. I suppose there's not much point in me if I won't have sex. My only "
"talent, I'm <i>fully aware.</i>"
msgstr "그래. 섹스를 안 하면 나란 존재는 딱히 의미가 없지. 유일한 재능이니까, <i>아주 잘 알고 있어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = b5179f57-4372-c42c-7dbc-e8e7da9e6ad8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:b5179f57-4372-c42c-7dbc-e8e7da9e6ad8
msgctxt "hdd091c2ag3bfcg4307g8721gbc0310fbc871"
msgid ""
"I don't know how else to be with someone. No matter how much I'd like to."
msgstr "난 다른 누군가와 함께하는 방법을 몰라. 아무리 하고 싶어도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = ba1ab35e-9f86-6fde-4b17-b95aa40776d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ba1ab35e-9f86-6fde-4b17-b95aa40776d6
msgctxt "he28b55e6ga785g4650ga6d2g9bbcfe8dff5d"
msgid "That would've been wrong."
msgstr "그건 잘못된 생각이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = bb0b2b52-17fc-a56b-f37e-facea619dfd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:bb0b2b52-17fc-a56b-f37e-facea619dfd1
msgctxt "h751288a6gbccbg4ad0g8fa3g1dfdc9f4d55a"
msgid "<i>Open your mind so he sees you care.</i>"
msgstr "<i>마음의 문을 열어 그가 볼 수 있도록 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = bb1294bf-f76a-0fd8-e3c0-e7a0335d3dd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:bb1294bf-f76a-0fd8-e3c0-e7a0335d3dd0
msgctxt "h80105ff0g0a83g47b4g8da8g7c671aeae9d4"
msgid ""
"A moment of disgust to force myself through. And then I could have carried "
"on, just like before."
msgstr "역겨움을 참아내야 하는 순간이 있었겠지만. 전처럼 지나가 버리면 됐었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = bc08be26-207f-21fd-1d75-6174be2586fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:bc08be26-207f-21fd-1d75-6174be2586fc
msgctxt "h56305b4age64fg414cga4a1gd2243a884e44"
msgid "I only had our best interests at heart."
msgstr "난 우리의 가장 좋은 점만을 생각했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = bc50bc76-4afb-b5f2-a5ee-2998d235797f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:bc50bc76-4afb-b5f2-a5ee-2998d235797f
msgctxt "h58d24284g53d3g4dc5g9cecg888238fde4de"
msgid "Something like that. Except... not that at all."
msgstr "비슷한데. 아니... 완전히 틀려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = bc580537-6cff-e1d9-75af-e1cab934f547
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:bc580537-6cff-e1d9-75af-e1cab934f547
msgctxt "h7c558b89g6825g4155g95f1g4df4ee111f0d"
msgid "Are you getting sentimental on me?"
msgstr "지금 나한테 감상적으로 대하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = c19c1a50-cc82-ab7c-4379-26ce1ff9da3f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - ORI_State_DatingAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:c19c1a50-cc82-ab7c-4379-26ce1ff9da3f
msgctxt "h7890f96bgb19cg46b8g841bg7ba71e2ca1d3"
msgid "I- I would like that."
msgstr "그, 그게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = c24b763d-53c7-eb0a-eacb-0c0ebb0d0ecc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_ROM_BloodMerchant_ForcedSex = True
#.     - ORI_Astarion_State_BloodMerchantAftermath_ToxicBreakup = True
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - ORI_State_DatingAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:c24b763d-53c7-eb0a-eacb-0c0ebb0d0ecc
msgctxt "h1afa2537gb258g4863gad41g18a3f1b376d7"
msgid "Whatever we had - whatever <i>this </i>was - it's over."
msgstr "우리가 뭘 했든, <i>이게 </i>뭐였든 간에, 이제 다 끝이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = c3e8ca88-e7d8-7d82-0fe1-9acca6403b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:c3e8ca88-e7d8-7d82-0fe1-9acca6403b3f
msgctxt "h82020e3eg5298g4603gb71agb34f3f2b90ad"
msgid "About your undying love for me?"
msgstr "나에 대한 네 변함없는 사랑에 대해 말하려고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = c43973a3-a55f-5727-75d6-ddb92d46cb82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:c43973a3-a55f-5727-75d6-ddb92d46cb82
msgctxt "h6ac1c563g2efdg4f1bg907egec9cfeb1b4df"
msgid "I don't know what I am."
msgstr "난 내가 누군지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = c6388f42-69d5-8714-b2a8-47b6d32fc05a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:c6388f42-69d5-8714-b2a8-47b6d32fc05a
msgctxt "h96a41fe2ga9dbg48afg954fg6e0e6ae44820"
msgid ""
"I... don't know. It's been so long since I've had to decide what I wanted."
msgstr "난... 모르겠어. 원하는 걸 직접 결정했던 게 너무 오래된 일이라서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = cbd91b51-ae2d-0c3a-f0ba-5d11d32327c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:cbd91b51-ae2d-0c3a-f0ba-5d11d32327c0
msgctxt "ha13e119cgf5d8g46bfg804ege37a5aa827ef"
msgid "This doesn't sound good."
msgstr "그리 좋게 들리지는 않는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = ccdcf418-89b7-b58d-5a1a-20d441abcd48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ccdcf418-89b7-b58d-5a1a-20d441abcd48
msgctxt "h05caf3e8g8280g4622ga281g2e89de1cb8e8"
msgid "As a person? Would that be so much to ask?"
msgstr "사람으로 봐주는 거? 그게 그렇게 무리한 요구일까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = cecafc86-60fd-3e91-d84c-07842e9ec3ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:cecafc86-60fd-3e91-d84c-07842e9ec3ec
msgctxt "h281f8f16g41e2g431bg9f9egda509fd55ff6"
msgid "It was worth it for that potion."
msgstr "물약을 위해서라면 할 만했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = d00071cc-ac2f-2af0-3c8b-2602de6753e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:d00071cc-ac2f-2af0-3c8b-2602de6753e4
msgctxt "h8ac5d2fbg6e47g4809g95a0gd7846f289dd0"
msgid "So do I. More than anything."
msgstr "나도 그래. 무엇보다도 더."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = d050d66d-135a-fc40-f2f4-eff593b97c83
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - ORI_State_DatingAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:d050d66d-135a-fc40-f2f4-eff593b97c83
msgctxt "hc612e22fgedecg4f56gb146gf828943a419f"
msgid ""
"I thought I could bear sleeping with you, to try and get you on my side."
msgstr "너랑 자는 걸 참으면서까지 널 내 편으로 만들 수 있을 거로 생각했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = d2d99537-f135-3942-2eb1-b637bbe671ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:d2d99537-f135-3942-2eb1-b637bbe671ca
msgctxt "h39d56e3bge074g439bga447g7653b5af877c"
msgid "Unfortunate, because you're going to hear it."
msgstr "안타깝네, 어쨌든 듣게 될 거라서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = d3332b52-0062-69d6-bf2a-3088effa9ef2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:d3332b52-0062-69d6-bf2a-3088effa9ef2
msgctxt "h5651e522g8b99g4321ga524ge0e2dc09b5b2"
msgid "I hope you're all right."
msgstr "괜찮길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = d4874abd-6e56-7f96-ae1b-93165d32dcb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:d4874abd-6e56-7f96-ae1b-93165d32dcb8
msgctxt "h351fb824gde6fg4374gbc92g887224c6011c"
msgid "I'm sorry. I don't want you to do anything you don't want to do."
msgstr "미안해. 네가 하고 싶지 않은 일은 하지 않았으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = d4ff97cd-83d2-e048-1a9e-355cb1a8e44b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:d4ff97cd-83d2-e048-1a9e-355cb1a8e44b
msgctxt "h4b4d3f65g0de6g456fgb20fg28030312e226"
msgid "Are you not attracted to me? Is that it?"
msgstr "나한테 끌리지 않아? 그게 다야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = d53dda92-6666-df4e-edf1-55f18688a111
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:d53dda92-6666-df4e-edf1-55f18688a111
msgctxt "haf13548egc70ag42eegb491g4d00c0709220"
msgid "Will you please stop whining?"
msgstr "그만 좀 징징거릴래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = da44e7f1-d858-3dd2-1fb2-9e7e7fdc5b22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:da44e7f1-d858-3dd2-1fb2-9e7e7fdc5b22
msgctxt "hc784e036g02d4g4e5bgad8cg9c5d6a391877"
msgid "I don't want you to do anything you don't want to do."
msgstr "네가 하고 싶지 않은 일은 하지 않았으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = dab7acc9-cff4-361b-9c1b-1b22f9d24859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:dab7acc9-cff4-361b-9c1b-1b22f9d24859
msgctxt "h36ef4d24g71e1g4665gbc63g8e146169ed24"
msgid "And you pushed me."
msgstr "그리고 넌 날 몰아붙였고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = db59a734-cd22-39e3-2114-592b6123a4a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:db59a734-cd22-39e3-2114-592b6123a4a1
msgctxt "hcb924b54gef9dg413aga578g06be32f17e99"
msgid "Hah! Why that almost sounds like a challenge."
msgstr "하! 왜 그게 도전처럼 들리는 걸까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = dd554d8a-9f51-7560-c5f3-deb85d3277c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:dd554d8a-9f51-7560-c5f3-deb85d3277c3
msgctxt "ha18118c2g1867g4302g8f45g25c3e806c1a7"
msgid ""
"You should learn to enjoy sex for your own pleasure, and you should enjoy it "
"with me."
msgstr "넌 네 쾌락을 위해 섹스를 즐기는 법을 좀 배워야겠어, 그리고 그걸 나와 함께 해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = ddc812a8-3993-33df-bd0c-802154e7f9c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ddc812a8-3993-33df-bd0c-802154e7f9c5
msgctxt "h5d8c80fcg02ddg49f0ga5e8ge6043c96fa85"
msgid ""
"Being close to someone - any kind intimacy - was something I performed to "
"lure people back for <i>him</i>."
msgstr "누군가와 친해진다는 건, 제아무리 친절하게 대해도, 사람들을 유인해서 <i>그</i>에게 바치기 위한 연기였을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = ddf38e2c-37ed-99fd-f024-2c0f9987c1bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ddf38e2c-37ed-99fd-f024-2c0f9987c1bc
msgctxt "h94571185g1cadg4f7ag9198g6b85fad4fe6c"
msgid ""
"Oh it's nothing terrible, it's just-... well, maybe it is a little terrible."
msgstr "오 그렇게 끔찍한 건 아니야, 그냥... 음, 끔찍할 수도 있겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = e330f710-3f35-e881-0fd1-f07c07de6e9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:e330f710-3f35-e881-0fd1-f07c07de6e9d
msgctxt "ha69cb48cg5434g4c37gb4f4g25e7802a780c"
msgid "It might be better if we don't see each other anymore."
msgstr "우리가 더 이상 만나지 않는 게 좋을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = e37914dd-9659-4eda-7eaf-8c91568783fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:e37914dd-9659-4eda-7eaf-8c91568783fc
msgctxt "ha95feff2gcdcbg4c88gae24g78116c42d950"
msgid ""
"You stood up for me earlier, when that wretched drow was insisting I bite "
"her. I appreciated it, that's all."
msgstr "아까 그 가증스러운 드로우가 나더러 자길 물라고 했을 때, 네가 막아줬잖아. 고마웠다고, 그게 다야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = e3fae94d-4d44-80ea-0d9f-49587ab5bf98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:e3fae94d-4d44-80ea-0d9f-49587ab5bf98
msgctxt "h87759027gd15fg4a0bgafb4g1b9a7cc74ab7"
msgid "I - yes, all right. I can understand."
msgstr "난... 그래, 알겠어. 이해할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = e77142d2-3967-c7ad-9f3e-39f4da17e22b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:e77142d2-3967-c7ad-9f3e-39f4da17e22b
msgctxt "h5cf9cef6g9565g4512gae5bgee080f956a04"
msgid "Maybe what you really need is a friend, not a lover."
msgstr "어쩌면 너에게 정말 필요한 건 연인이 아니라 친구일지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = e8012bd3-5ffb-af32-0b10-2ece9dbed9ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:e8012bd3-5ffb-af32-0b10-2ece9dbed9ce
msgctxt "h09d97a20gaa5ag4783ga972ga8a4025b54ad"
msgid ""
"So imagine how stupid I felt when I started to genuinely feel something for "
"you."
msgstr "그러니 너한테 감정을 느끼기 시작했을 때 나 스스로가 얼마나 멍청하게 느껴졌을지 상상해 보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = ea167a91-4f5d-eec3-0000-81e68a70c250
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ea167a91-4f5d-eec3-0000-81e68a70c250
msgctxt "h792da86eg4416g413cg8314g00c9c84b27ff"
msgid ""
"Throwing your body at someone becomes second nature. And I just did it again."
msgstr "누군가한테 몸을 던지는 건 자연스러운 일이 됐어. 그리고 이번에도 난 그렇게 했고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = ea9b09a5-ff4c-515f-ff95-6bb5b795e70e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ea9b09a5-ff4c-515f-ff95-6bb5b795e70e
msgctxt "h76dc5b80g6497g4a21g9b9dg7c874066955c"
msgid "It's almost funny."
msgstr "정말 웃기네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = eb8f7347-8153-7692-071b-9845d9c513c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:eb8f7347-8153-7692-071b-9845d9c513c5
msgctxt "h0db4aadcg1f8eg49f3g9c9ega7f7c324e8a6"
msgid "I was hoping that as reward for my support you'd throw yourself at me."
msgstr "내 지지에 대한 보답으로 네가 내게 몸을 던져주길 바랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = ecdb2177-fc62-1540-399b-24e63a2f1f4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithAstarion(1) = False
#.     - ORI_State_DatingAstarion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ecdb2177-fc62-1540-399b-24e63a2f1f4a
msgctxt "h32b9537cg3db3g4489ga65fg84fe75a9dccf"
msgid ""
"It's a shame, but I don't want to risk treating you like you were one of "
"<i>his </i>victims."
msgstr "안타깝네, 하지만 널 <i>그의 </i> 희생자들 중 하나처럼 취급하고 싶진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = edc3ffe4-41cd-6d1f-27ad-22b94527c8a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:edc3ffe4-41cd-6d1f-27ad-22b94527c8a5
msgctxt "h1e0d0bfdgdc60g4104g899cgb5756521fe2d"
msgid "But I'm more than that. More than a thing to be used."
msgstr "난 그 이상이야. 사용되는 물건 그 이상이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = eddc7c7b-f3a4-8663-21e0-280219539612
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:eddc7c7b-f3a4-8663-21e0-280219539612
msgctxt "hdbcae92fgdd27g4eaag9df4g3e296972f994"
msgid "I suppose... If this is what you want, then I shall provide."
msgstr "아마도... 네가 원하는 게 이거라면, 줘야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = edde7ea6-c2e8-d8d0-8f11-6637e873ebc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:edde7ea6-c2e8-d8d0-8f11-6637e873ebc9
msgctxt "h8369aab4g3eafg4a67g8d12gd40730d43664"
msgid "Come, lie with me, you'll feel better about it then."
msgstr "이리 와, 같이 자면 기분이 나아질 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = eec81caf-7eba-65a4-0d03-2c782f9ca6f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:eec81caf-7eba-65a4-0d03-2c782f9ca6f0
msgctxt "hbfc81e3bgfab5g47d0gb20fg87953fdfbf23"
msgid ""
"I tried to pick beautiful people where I could, but there were so many over "
"the years. After a while you stop caring."
msgstr "최대한 아름다운 사람들을 고르려고 했는데, 그 세월 동안 만난 사람이 너무 많아야지. 좀 지나니까 신경 안 쓰게 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = f110ebc6-8c06-7e62-34dd-7846c1d8836e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f110ebc6-8c06-7e62-34dd-7846c1d8836e
msgctxt "ha0354bcbgea33g4c17g83c7g8d1b9c73fcfe"
msgid ""
"People don't trust vampires - perhaps understandably - so I needed to get "
"someone on my side. And seducing you was easy, frankly."
msgstr "사람들은 뱀파이어를 믿지 않아. 이해는 되지만. 그래서 누군가를 내 편으로 끌어들여야 했어. 널 유혹하는 건 쉬웠지, 솔직히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = f1d2f0ba-7822-333c-f1ba-1abff5983375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f1d2f0ba-7822-333c-f1ba-1abff5983375
msgctxt "h146e0ca1g5c0bg49c9g94c7g58f3b779696a"
msgid "I'm so sorry."
msgstr "정말 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = f4278b5e-8133-2959-340c-8bac0ee378ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f4278b5e-8133-2959-340c-8bac0ee378ed
msgctxt "hbe6f83d5gce6fg4ab4g8dabgd6a729c85b7d"
msgid "I care about you. Deeply."
msgstr "네가 걱정돼. 진심으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = f4906dcf-c4d0-003c-9705-b12abad11d3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f4906dcf-c4d0-003c-9705-b12abad11d3f
msgctxt "h13852514gaf7fg4cabgb6c2g23864a3e0b92"
msgid "But you seemed like you were enjoying it last night?"
msgstr "하지만 어젯밤에는 즐거워 보였는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = f518414f-efb7-df36-8bc6-dc06805e96d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f518414f-efb7-df36-8bc6-dc06805e96d9
msgctxt "h52544793ge919g4c15g8625gb4ee9f07d0ad"
msgid ""
"And every instinct I have tells me that nothing's changed. That I'm still "
"just a means to an end."
msgstr "본능은 아무것도 변하지 않았다고 말해. 여전히 목적을 위한 수단일 뿐이라고 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = f7280a6e-9e47-7f16-26b3-ca702d1656f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f7280a6e-9e47-7f16-26b3-ca702d1656f7
msgctxt "h407bbad4g84b3g4465gb7bagfe61bf5b889e"
msgid ""
"It's just... it would have been so easy to bite her. To just go along with "
"what I was being told to do."
msgstr "그냥... 그 여자를 무는 게 쉬웠을 거야. 시키는 대로 하면 됐으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = f795d823-6fbb-b84c-9574-c9f068805fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f795d823-6fbb-b84c-9574-c9f068805fb2
msgctxt "h3e313369g96b8g4c16gb056ga98833a4f520"
msgid "It's easy to judge a situation when you're not in it."
msgstr "본인이 그 상황에 부닥쳐 있지 않으면 그리들 쉽게 판단하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Astarion
#. NodeID = f7ed9e77-eb8c-e41f-68d9-29c9bc5ca991
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:f7ed9e77-eb8c-e41f-68d9-29c9bc5ca991
msgctxt "h81ae3a17ga466g408ega823g811464893e00"
msgid "It's a novel concept, I admit. And a little intimidating."
msgstr "솔직히, 새롭긴 하네. 조금 겁도 나고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath
#. Speaker = Player
#. NodeID = ff3a2a25-f54f-bd72-a5b3-d2cdc244a351
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Astarion_SD_ROM_BloodMerchantAftermath:ff3a2a25-f54f-bd72-a5b3-d2cdc244a351
msgctxt "h28d0edc4gdb55g4a11gbc46gbd332af00b5a"
msgid "<i>Hug him</i>."
msgstr "<i>그를 끌어안는다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 053268d8-9aaa-c79a-d67b-a751a4a52c59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:053268d8-9aaa-c79a-d67b-a751a4a52c59
#, fuzzy
msgctxt "hff4ddcfege059g4aa6g9e45g123525da40b5"
msgid ""
"<i>Gortash is going to be so happy to see me, right up until I melt his face "
"like a candle.</i>"
msgstr "<i>고타쉬 녀석, 내가 그 면상을 양초처럼 녹여버릴 때까지 날 보고 정말 기뻐하겠지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 0a2cd61e-41ac-db71-26d9-01d3d1c51e2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:0a2cd61e-41ac-db71-26d9-01d3d1c51e2e
msgctxt "h1448f700g63c1g43feg8c94ga8d477407e99"
msgid ""
"<i>Dammon said he could come up with </i>something<i>, but at this point... "
"I don't know. My engine just feels cooked.</i>"
msgstr "<i>대먼이 </i>뭔가를<i> 생각해낼 수 있을 거라 했지만, 지금은... 모르겠어. 엔진이 구워지기 일보 직전이야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 14ce0dec-72e0-09f3-70b7-323695b8ae4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:14ce0dec-72e0-09f3-70b7-323695b8ae4d
msgctxt "h3d6850a4gf966g486fg92c5g7c893a17ddb4"
msgid "<i>Home. I'm nearly there. It's almost over.</i>"
msgstr "<i>우리 집. 거의 다 왔어. 거의 끝났다고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 1a032d45-5a92-6b92-2c3b-cb062dd101ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:1a032d45-5a92-6b92-2c3b-cb062dd101ba
msgctxt "hf71194c0g5c31g4ad3g805cgd08c2b313d5f"
msgid ""
"<i>But I'm so close to the city. To </i>home<i>. Wasn't sure I'd make it.</i>"
msgstr "<i>하지만 도시가 코앞이라고. </i>우리 집<i>. 내가 해낼 수 있을지도 몰랐잖아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 2a66c9e6-bb9e-74b0-048e-c8c3600026b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:2a66c9e6-bb9e-74b0-048e-c8c3600026b0
msgctxt "h8f4234b5geb2fg4886gad09g26943a4d38dc"
msgid "<i>That motherfucker doomed the wrong girl.</i>"
msgstr "<i>그 씨발새끼는 희생양을 잘못 골랐어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Player
#. NodeID = 3796d540-bddc-d3e8-5d95-6d7316fd53aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:3796d540-bddc-d3e8-5d95-6d7316fd53aa
msgctxt "he639f4e3gf946g476fg897egd707b66001bb"
msgid "I'm so grateful."
msgstr "정말 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Player
#. NodeID = 3cd4098f-64a0-e8ba-098c-23e246cbbb2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:3cd4098f-64a0-e8ba-098c-23e246cbbb2b
msgctxt "ha963f20fge4d0g4376ga7a4g3eb4d7bd9e6d"
msgid ""
"Doubting myself has always been a fool's errand. What Karlach wants, Karlach "
"gets."
msgstr "스스로를 의심하면 늘 헛고생을 했어. 칼라크가 원하면, 칼라크는 가진다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 4d3fa9ba-e6b8-80e5-f15f-87afcc1c8fb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachUpgraded = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:4d3fa9ba-e6b8-80e5-f15f-87afcc1c8fb6
msgctxt "h326a0010gfb5fg4f70g87adg60b357d5ebca"
msgid ""
"<i>Dammon might be able to do a little something, but at this point... I "
"don't know. My engine feels cooked.</i>"
msgstr "<i>대먼이 뭐라도 해줄 수 있을지 모르겠지만, 지금 상황에선... 모르겠어. 엔진이 구워지기 일보 직전인 것 같아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 56be7b6a-88a1-52ff-7a1d-f80534ae7719
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:56be7b6a-88a1-52ff-7a1d-f80534ae7719
msgctxt "h16ad9b4cg7790g4750g8b54gb9e108b6a66a"
msgid ""
"<i>Ngh - gods, this thing wants to burn out. Not sure it's ever felt "
"worse.</i>"
msgstr "<i>으윽, 젠장, 이게 다 타버리고 싶어서 날뛰는군. 지금보다 더 나빠질 순 없을 거야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 5a240a88-7dbd-d1c9-09cc-7078213eb4ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:5a240a88-7dbd-d1c9-09cc-7078213eb4ad
msgctxt "h39f317a9g49c9g4150gbf08gcabc93f0af7c"
msgid "<i>Everything but the thing I want the most - my heart back.</i>"
msgstr "<i>모든 것을 가질 수 있지만 가장 원하는 걸 가지지 못했지, 내 심장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 69f56298-dbd1-af78-a59f-ec88046dc613
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitment_State_DammonUnavailable = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:69f56298-dbd1-af78-a59f-ec88046dc613
#, fuzzy
msgctxt "h1c32ab98g4004g4ffbgb387gcf8251e25ef3"
msgid ""
"<i>But hey. We've all got to go one way or another. And I plan to go out "
"with a bang.</i>"
msgstr "<i>근데, 어차피 언젠가는 죽을 거잖아. 그럴거면 난 화끈하게 가야겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 8bb34cf5-fc66-5f99-5dfc-ea287c564969
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:8bb34cf5-fc66-5f99-5dfc-ea287c564969
msgctxt "hf11648d1g1cecg4b50gbe7agc682367044ab"
msgid ""
"<i>But hey, I made it to the city. That'll do me. Whatever comes after that "
"is between me and the so-called gods.</i>"
msgstr "<i>그래도, 도시까지 왔잖아. 그걸로 충분해. 이후에 일어나는 것들은 나랑 그 소위 신들 사이의 일이라고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = 913bce16-8a97-bf51-a22d-72423895703d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:913bce16-8a97-bf51-a22d-72423895703d
msgctxt "hd5391d05g0684g4bfbg8a18gccd19c0c9bf8"
msgid ""
"<i>I'm going home. And whatever happens after that is between me and the so-"
"called gods.</i>"
msgstr "<i>난 집에 갈 거야. 이후에 일어나는 것들은 나랑 그 소위 신들 사이의 일이라고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Player
#. NodeID = 93854fda-4bda-efbb-e26c-023cd8e4ee43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:93854fda-4bda-efbb-e26c-023cd8e4ee43
msgctxt "hee52e144g2cfag4188gb07cg8c82dedcc497"
msgid "If this thing's burning out, I'd like to do it in Baldur's Gate."
msgstr "만약 불타버릴 거라면, 발더스 게이트에서 하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = a60fd3d3-ea92-3c13-7916-4b68c08cb0f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:a60fd3d3-ea92-3c13-7916-4b68c08cb0f7
msgctxt "h43ae2bffg2292g4bedgb2afg87841e9da1e5"
msgid ""
"<i>But hey. If this is how I go out - saving the city, protecting everything "
"I love from everything I hate - that'll do me.</i>"
msgstr ""
"<i>그렇지만. 내가 진짜 이렇게 죽더라도, 도시를 구하고, 사랑하는 모든 걸 싫어하는 모든 것에서 지키고 죽으면, 괜찮지 않을까.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = b9c18277-9250-0986-8469-4d9eb0606579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:b9c18277-9250-0986-8469-4d9eb0606579
msgctxt "hf2c38614g3917g4f9egaf0eg193f78026d0c"
msgid ""
"<i>Sweaty, but grateful. Good gods, this thing is hot. And getting "
"hotter.</i>"
msgstr "<i>땀투성이지만, 고마워. 신들이시여, 이거 완전 뜨겁네. 점점 더 뜨거워지고 있어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = f7608d75-d1a0-f8c7-2915-acb9ec6a9a67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:f7608d75-d1a0-f8c7-2915-acb9ec6a9a67
msgctxt "hebbed7d6g5163g440cgbe49gadc178999a03"
msgid ""
"<i>And if my engine keeps burning this hot, it might be lights out sooner "
"than I think.</i>"
msgstr "<i>엔진이 계속 이렇게 과열되면, 생각보다 더 빨리 나가떨어질지도 모르겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = f9d2530e-3302-b56e-43f8-8a5297b56af7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:f9d2530e-3302-b56e-43f8-8a5297b56af7
#, fuzzy
msgctxt "h0048a45dgb2a2g46ddgba93gf5c533b21a60"
msgid ""
"<i>But hey. We've all got to go one way or another. And I plan to go out "
"with a bang.</i>"
msgstr "<i>근데, 어차피 언젠가는 죽을 거잖아. 그럴거면 난 화끈하게 가야겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach
#. Speaker = Karlach
#. NodeID = ff28ff61-3b4e-b771-f55d-b603bcd46efc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_KillDirectorGortash_Knows_GortashLocation = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_BackAtHome_SD_Karlach:ff28ff61-3b4e-b771-f55d-b603bcd46efc
msgctxt "hc3b2ca2dg65fcg4774gac2cg7de6b32b98c1"
msgid ""
"<i>Come out, come out, wherever you are, Gortash. Karlach's coming home.</i>"
msgstr "<i>꼭 꼭 숨어라, 고타쉬. 칼라크가 집으로 돌아오고 있으니까.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 02b42b72-6660-c200-f59a-d01935e17a88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:02b42b72-6660-c200-f59a-d01935e17a88
msgctxt "h61ace382g9cd0g48fdga781g431c307b0c11"
msgid "When you gaze long into the abyss the abyss also gazes into you."
msgstr "심연을 오래도록 들여다보면 심연 또한 당신을 들여다봅니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1ad71059-bdd7-e7ff-cf13-d181559d5942
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:1ad71059-bdd7-e7ff-cf13-d181559d5942
msgctxt "hb5fca9c7g03abg4c3agbcf3g43167565d2ff"
msgid "And that other will be your death."
msgstr "그 다른 이가 바로 당신에게 죽음을 선사하겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1b8dbb18-3a8e-e93d-82da-78c3d5742313
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:1b8dbb18-3a8e-e93d-82da-78c3d5742313
msgctxt "h6b62937egb4bag4ef2g9168ge069c55eb5de"
msgid "Another will embrace what you have rejected."
msgstr "당신이 거부한 것은 다른 이가 받아들일 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 32598361-0029-f671-3074-d04ac9f3e807
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:32598361-0029-f671-3074-d04ac9f3e807
msgctxt "h9921934egf06eg4faegb464g6768810c36bd"
msgid "You have disobeyed your Father's wishes one time too many."
msgstr "주인님 아버지의 지시를 어기시면 안 되죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 33418ac4-2de8-a4af-e0dc-e567d7535d1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:33418ac4-2de8-a4af-e0dc-e567d7535d1a
msgctxt "h56264535gcbdeg425fg87dfg9e82df8ef94e"
msgid "But another seeks to disinherit you. Do not let her be your death."
msgstr "하지만 주인님의 유산을 빼앗으려는 자가 있습니다. 당신을 죽이게 두지 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3d3f80e6-3568-50f6-e389-bde81715bc3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:3d3f80e6-3568-50f6-e389-bde81715bc3b
msgctxt "h8f3a6803g2f7ag41bdga128ge0570dc2aa68"
msgid "Lord Bhaal shall have but one Chosen."
msgstr "군주 바알께서는 오로지 하나의 후계만을 선택하십니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3ed122a7-9aa0-53b0-e6df-84780744915a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_GivenSlayerForm = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:3ed122a7-9aa0-53b0-e6df-84780744915a
msgctxt "hd32fc2a2g0229g40c9g8e33gaa373bdf9a4f"
msgid "Triumph after triumph, you have excelled in base villainy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3f27fe5f-9f4a-ff97-b215-d50f6085b6f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_IsobelKillOrder = True
#.      - NIGHT_DarkUrge_SparedIsobel = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:3f27fe5f-9f4a-ff97-b215-d50f6085b6f6
msgctxt "h6ae47ee0g97efg4dd8g8fafg17df02c4b1a5"
msgid ""
"There was much disappointment at your reluctance to kill the little "
"Moonmaiden."
msgstr "그 꼬마 달처녀를 죽이는 걸 꺼려하신 것에 실망이 크셨답니다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 62529d1e-dc8d-310a-9dc3-cda1e7eed95b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:62529d1e-dc8d-310a-9dc3-cda1e7eed95b
msgctxt "h99276c83gaa2bg4419ga9a1gdc8b2ac45ece"
msgid "Slaughter your line. Become the last of your name."
msgstr "혈육을 학살하세요. 당신 가문의 마지막 일원이 되는 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 68326937-fd70-8616-9e2a-9eeaedc43e28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_BloodWeddingFallback = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:68326937-fd70-8616-9e2a-9eeaedc43e28
msgctxt "hcc887125g6860g42cbg91d0g01c447f562d0"
msgid "Naughty, naughty, naughty, little Master."
msgstr "정말이지, 작은 주인님은 참으로 못돼먹었군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7c27d44c-31b9-98d0-d24e-5c99b75de503
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:7c27d44c-31b9-98d0-d24e-5c99b75de503
msgctxt "h06af71adgeb58g439cgb42ag78761a141f8d"
msgid ""
"For he who fights with monsters should look to it that he himself becomes a "
"monster."
msgstr "괴물과 싸우는 이는 괴물이 되기 위해서 조심해야 하는 법이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7c27d44c-31b9-98d0-d24e-5c99b75de503
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:7c27d44c-31b9-98d0-d24e-5c99b75de503
msgctxt "hf9d22dfeg2f0bg4420ga864g6a3838ff349a"
msgid ""
"For she who fights with monsters should look to it that she herself becomes "
"a monster."
msgstr "괴물과 싸우는 이는 괴물이 되기 위해서 조심해야 하는 법이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7c27d44c-31b9-98d0-d24e-5c99b75de503
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:7c27d44c-31b9-98d0-d24e-5c99b75de503
msgctxt "he5502f8cge834g40dcg914bg8be1d2b9ed38"
msgid ""
"For one who fights with monsters should look to it that they themselves "
"become a monster."
msgstr "괴물과 싸우는 이는 괴물이 되기 위해서 조심해야 하는 법이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 89450641-58f9-7acf-2c86-38b1c652c991
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_IsobelKillOrder = True
#.      - NIGHT_DarkUrge_SparedIsobel = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:89450641-58f9-7acf-2c86-38b1c652c991
msgctxt "hdfcecc0fg7d65g42e6gbe38g813110f9ac57"
msgid ""
"Your inheritance of your estate depends on you maintaining a healthy stream "
"of kills."
msgstr "주인님이 유산을 물려받으려면 꾸준하게 살인하는 습관을 건강하게 유지하셔야 한단 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9bec3107-a3f4-4346-b47e-b565c603cbef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:9bec3107-a3f4-4346-b47e-b565c603cbef
msgctxt "hcc5d2fa5gc063g4268g8aa9gdb1dab5abd45"
msgid "Your Father loves you best. You have already made us so proud."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9ec98a2f-bdff-e0d4-5023-cafbcce7d3a8
#. HandlePath = TaggedText[0].TagText[0]
