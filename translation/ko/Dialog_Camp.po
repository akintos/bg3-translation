#, fuzzy
msgctxt "hc35de236g5ae9g4b44g9d27g735f63bac125"
msgid "Are you two... friends?"
msgstr "너희 둘... 친구 먹었어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 7d8fa40a-d212-7ad8-bab3-f77df6a5740e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:7d8fa40a-d212-7ad8-bab3-f77df6a5740e
msgctxt "hf45b9fb1ge25fg4f4dg9471g1b4d55f2c8c9"
msgid "Wait - did you say you have a brother?"
msgstr "잠깐만, 형이 있어?"

