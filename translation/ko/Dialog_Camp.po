msgctxt "h57133275g5d2ag4d07g9ac2ged40606774a4"
msgid ""
"Would you look at this place? Such a pastoral escape. Free of predators. "
"Annoyances. <i>Obligations.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Player
#. NodeID = 43ee76ce-02ce-fc85-6df0-ee7ba3b98853
