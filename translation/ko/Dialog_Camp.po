msgctxt "ha8797e80g7ecfg4980g837agb37cfbbd6734"
msgid "Strong. Fight! Win!"
msgstr "강하다. 싸운다! 이긴다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Owlbear Cub
