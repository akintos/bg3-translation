msgctxt "hffd1e037g54b0g40e3ga96fg4bb50012f837"
msgid "<i>Twirl about with flair and abandon.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 725ccce9-3434-55fa-85be-500267b66d5d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Wyll_Event_RequestedDance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:725ccce9-3434-55fa-85be-500267b66d5d
msgctxt "h981bd86dga3f6g4946gbd47g4118efb6cde5"
msgid "May I have this dance?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 748633bf-12d8-d080-92d7-a16b0228ebff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:748633bf-12d8-d080-92d7-a16b0228ebff
msgctxt "h238f8b1ag0dcbg44bfg9758g4085bf2b6d9a"
msgid "Indeed? Well let's see how you fare with a more - intimate style."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 78da71ca-d5a7-d6b2-e3f8-cbf2ed752576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:78da71ca-d5a7-d6b2-e3f8-cbf2ed752576
msgctxt "h87ebc6e7gde23g4adeg9ef0g21b14aa5dbca"
msgid "Beats all that fancy flitting around you were doing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 7b0517af-7bbf-ae24-e444-2ba2542baed6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = True
#.     - ORI_State_DatingWithWyll(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:7b0517af-7bbf-ae24-e444-2ba2542baed6
msgctxt "hce524a4fge290g477fgabafg690f4e8fb442"
msgid "<i>Press your lips against Wyll's.</i>"
msgstr "<i>윌의 입술에 키스한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 83a16d69-5f3f-b4bc-8b7a-0c3494653c25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:83a16d69-5f3f-b4bc-8b7a-0c3494653c25
msgctxt "h0b7937ceg5dd2g42b1g8b18gbc6a5436faa1"
msgid ""
"Don't you worry, you were a joy to witness. But perhaps we might try a more "
"intimate style."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 845939d7-2595-bde1-6c40-21373b7d6405
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:845939d7-2595-bde1-6c40-21373b7d6405
msgctxt "h5392127age8f3g4a44gaab6g421f2685f389"
msgid "I'm tempted, trust me. I thought my heart might burst with every step."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 8a332522-58c8-c04c-e26d-fd224808f0a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:8a332522-58c8-c04c-e26d-fd224808f0a2
msgctxt "hdb79d472g8041g49edg9d6fg570eec32b3a0"
msgid ""
"I'm surprised you'd ask. Thought maybe a part of you was still suspicious of "
"me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 8c979559-7261-6225-cf61-b5fd237cb495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:8c979559-7261-6225-cf61-b5fd237cb495
msgctxt "hf958de9bgf341g4a18ga9b8g9476c594a502"
msgid ""
"Forgive me. I was... caught up in the moment. But look - not a cinder on me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 8cd2388c-d753-d5fd-b343-55aca94f589a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = False
#.     - ORI_State_DatingWithWyll(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:8cd2388c-d753-d5fd-b343-55aca94f589a
msgctxt "ha8e7d233g9fe6g4f36g91d9ga27ccb3a04e8"
msgid "I think we should just call it a day."
msgstr "이제 그만하는 게 어떨까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 8f791c3b-0ead-de95-6613-fb023a876d74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:8f791c3b-0ead-de95-6613-fb023a876d74
msgctxt "h329a435dgff9cg48d4gba38g7b4b421225c0"
msgid "Cocky, don't you think? Threaten my life, then try to cosy up after?"
msgstr "너 참 건방지다? 죽이려 들 땐 언제고 이제 와서 친한 척을 해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 8f79f330-3521-b66e-de11-e2a22ba48e7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = False
#.     - ORI_State_DatingWithWyll(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:8f79f330-3521-b66e-de11-e2a22ba48e7d
msgctxt "h0fcb1caagabbeg4b0eg84f0g172a7dd1704e"
msgid "<i>Turn your head away.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 9004af5c-a811-289f-9e46-c3f1376f4e4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:9004af5c-a811-289f-9e46-c3f1376f4e4b
msgctxt "heaeb2506g5145g4f91g9cf3g04b68244755f"
msgid "Fair enough. Perhaps a less energetic style would suit you better."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 964b305c-35a3-5c41-309f-e03b927fc442
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:964b305c-35a3-5c41-309f-e03b927fc442
msgctxt "h78dea831g206cg4b5fga9ebg8bc70c8f23bc"
msgid "No need to be modest, you were a delight to behold."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 9689aa5f-33be-b664-8445-2408a618a0ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:9689aa5f-33be-b664-8445-2408a618a0ed
msgctxt "he9de2448gc431g4542ga1b3g5bb1894de95c"
msgid ""
"I know a few people who might beg to differ. But the only one that matters "
"is here with me now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 9d639564-50be-1d5f-c5f4-04fbb7a188d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:9d639564-50be-1d5f-c5f4-04fbb7a188d5
msgctxt "h9a34a866g0b8bg48cdg9af8g592a36ffa62f"
msgid ""
"I'd like to do this the proper way. The way of the old romances sung by the "
"bards."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = a29c459f-29e6-f265-42c1-95f22b24ffb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:a29c459f-29e6-f265-42c1-95f22b24ffb7
msgctxt "hd8653e6cg89e6g492eg9d29g95a2c14a098d"
msgid "<i>Smile and bow.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = a2cb964a-906c-66a5-df50-17601d00e1c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = False
#.     - ORI_State_DatingWithWyll(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:a2cb964a-906c-66a5-df50-17601d00e1c7
msgctxt "hddfd8014g2db9g4e75g9f82geb9d1ebe4663"
msgid ""
"As charming as that sounds, I don't want to give you the wrong impression."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = a938939b-cfb7-5375-28b7-3dcde126afc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:a938939b-cfb7-5375-28b7-3dcde126afc3
msgctxt "h8481c149g9119g49cag85e6g7dac376482c2"
msgid ""
"I've attended my share of fancy balls and masquerades. A few elegant moves "
"can turn all the right heads."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = a9398efa-a1f3-0e07-cfc0-834dfb5dbd44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:a9398efa-a1f3-0e07-cfc0-834dfb5dbd44
msgctxt "h947b0246gc898g4db6g8e3ag6336efa8b01b"
msgid "<i>Stay quiet, and watch Wyll dance.</i>"
msgstr "<i>잠자코 윌의 춤을 지켜본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = a95c1b3a-9c50-7242-0c98-67fc7725988f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:a95c1b3a-9c50-7242-0c98-67fc7725988f
msgctxt "h1e340ac6gf363g4f1cgb3ddg4643eeb265ba"
msgid "I don't know. I'm not much of a dancer."
msgstr "모르겠어. 춤에는 조예가 깊지 않아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = ac281623-6094-1fd1-1c46-2a44add2e60f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:ac281623-6094-1fd1-1c46-2a44add2e60f
msgctxt "h308255deg0e16g4e31gb72eg5a28b0546400"
msgid "I mean - yes, of course. The sun only rests for so long."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = ad1835b1-3966-7e0a-38c0-fd2a7a6dbae9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:ad1835b1-3966-7e0a-38c0-fd2a7a6dbae9
msgctxt "h6e467868g6c25g41d1gb85bgbb082ab89313"
msgid "Dance with a devil? Most certainly not."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = b1277ed9-1399-99bd-5947-117f6f151e33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:b1277ed9-1399-99bd-5947-117f6f151e33
msgctxt "h76e92fdfgb0abg41ddga990gb1de46378856"
msgid "But perhaps we might try a more intimate style."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = b4ba8003-3163-199f-ac5a-f5c2b1ff2e41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:b4ba8003-3163-199f-ac5a-f5c2b1ff2e41
msgctxt "he6847280g925dg4867ga2dcgfbec34f90d90"
msgid "<i>Stay still and shake your head.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = b8aaf15f-5d1a-94ae-9408-689156c8da73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:b8aaf15f-5d1a-94ae-9408-689156c8da73
msgctxt "h42435f72g2fbfg4889g82a2g223c3af1baab"
msgid ""
"But I still keep faith in the old tales of love, the once-upon-a-times and "
"the happily-ever-afters."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = c235cc7c-265d-4105-030f-f906c6c00704
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:c235cc7c-265d-4105-030f-f906c6c00704
msgctxt "hdc13f446g2f2fg402fgb1a8g31b1835094bc"
msgid ""
"About that. You only burn hottest when your emotions are aflare, right? "
"Anger, excitement, fear... but a dance can be meditative. Calming."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = c3d305ad-423c-673e-3277-0108749e16ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:c3d305ad-423c-673e-3277-0108749e16ba
msgctxt "h36f6a8afgbed9g43a8g9d87g89815230513e"
msgid "Keep practising. I'm sure you'll get better... eventually..."
msgstr "계속 연습해 봐. 나아질 거야… 언젠간…"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = c890e63a-4faa-f79e-4067-40afc6cbe76e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:c890e63a-4faa-f79e-4067-40afc6cbe76e
msgctxt "haccc42a2g3516g466fg992dg57b85dabab32"
msgid "It would be an honour."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = c8b115e6-6c2e-fffd-61b7-45e285cb835f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:c8b115e6-6c2e-fffd-61b7-45e285cb835f
msgctxt "hd7a42b59g420fg4902gab9cg6614bf2ed1c4"
msgid ""
"Maybe. But I'm not so keen to perform solo. A duet's always been more my "
"style. Which is to say -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = caf4fe0e-4cac-3c61-a74d-5d38ce1aa2d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:caf4fe0e-4cac-3c61-a74d-5d38ce1aa2d1
msgctxt "h6463ca89g6984g47e3g9916g965ef9712454"
msgid ""
"Are you sure? I've been rehearsing, you know. I'd hate to put all that "
"effort to waste."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = d37e12ee-5da9-87c3-3a1f-672c832044ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:d37e12ee-5da9-87c3-3a1f-672c832044ee
msgctxt "hdfdd79d8g4807g4622g9555ge71ed690efbb"
msgid ""
"It's like watching a beached flounder flop back to the sea. Is that the idea?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = d62b8e30-cd46-5203-2036-c789c2d36971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:d62b8e30-cd46-5203-2036-c789c2d36971
msgctxt "hf1b03c1bgf223g4058ga66agd6c4b0b7908c"
msgid ""
"You've more than proven just how wrong I was about you. I'd make the same "
"decision a thousand times, even knowing the consequences."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = d72a79da-5813-9ffc-e301-f4cb617c328e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:d72a79da-5813-9ffc-e301-f4cb617c328e
msgctxt "hd1693cb8g36aag44d1ga0f4ga886c0592142"
msgid "<i>Smile in embarrassment.</i>"
msgstr "<i>멋쩍게 웃는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = d76bfcf6-e7bb-f3ba-582d-3854cbc5f648
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Wyll_HavenRomance_Event_Romanced(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:d76bfcf6-e7bb-f3ba-582d-3854cbc5f648
msgctxt "ha2760824g3e73g4a30gb5edgfdad47059070"
msgid "Till next time, good night - and dream sweetly."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = d89da047-1c9f-4981-f661-6c3cff395f6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:d89da047-1c9f-4981-f661-6c3cff395f6a
msgctxt "h9fb6f482g071cg4f85g8391ga505664f7219"
msgid "Thank you. For the dance, I mean. I won't forget it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = da430b55-d782-0a19-09c6-b597ee1e16a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:da430b55-d782-0a19-09c6-b597ee1e16a2
msgctxt "h95dc454cg9850g4168g83d6g0fb3055452a7"
msgid "So much shadow around us. To think I almost missed the light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = dad9cbff-8c98-285e-1fa4-25aedd1b581e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:dad9cbff-8c98-285e-1fa4-25aedd1b581e
msgctxt "ha4c057f8g1f9fg4c6fg9802g63a801164a5f"
msgid "Gods damn it. You almost make me forget myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
