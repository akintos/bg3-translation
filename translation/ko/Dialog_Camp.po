msgctxt "h8dcf68b1g2f34g4d6fg84adg99bddfc77680"
msgid "I told you - I quit music. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Zae
#. NodeID = 9275a793-ff09-d531-a9e7-bb49ee429f60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02:9275a793-ff09-d531-a9e7-bb49ee429f60
msgctxt "h792e5c99gdfe5g46e2g8eebg3c7b419bf122"
msgid "Never!"
msgstr "절대!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Alfira
#. NodeID = 992c0f33-dab0-388d-c33f-189189953bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02:992c0f33-dab0-388d-c33f-189189953bb6
msgctxt "h2fb5474egca9dg4e4bga405g1c3df5a61bc6"
msgid "Hah! Let's see how you are in the morning. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Zae
#. NodeID = ac9d7ba6-102b-735e-b1d2-a7cf14c403c8
