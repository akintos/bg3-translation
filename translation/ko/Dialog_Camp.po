msgid ""
"<i>Tense up. That may be what you were, but it is not who you <b>are</b>.</i>"
msgstr "<i>흠칫한다. 과거에는 그런 사람이었을지 몰라도, <b>지금은</b> 아니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Narrator
#. NodeID = d4ecd021-6671-df9b-cdf9-e3992df7f120
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:d4ecd021-6671-df9b-cdf9-e3992df7f120
msgctxt "hb529cce4g5e9bg41a8gb8aege2c40b5b9130"
msgid ""
"*Years spent in worship of Bhaal, leading his savage congregation in prayer, "
"sacrifice, and slaughter.*"
msgstr "*당신은 오랜 세월 바알을 섬겼습니다. 그의 흉악한 신도들을 기도와 희생, 그리고 살육으로 이끌었죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD_Nested_InWorld
#. Speaker = Narrator
#. NodeID = cdf8080f-3010-4bd8-afc4-43a44ea36827
