msgctxt "h0ccfd920gb3a7g4b54g981bgeef70206dbe0"
msgid ""
"<i>Pay him what you promised.</i> ([463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Player
#. NodeID = b20a4c5e-a2f9-9a2b-f9fd-8afdafff10c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:b20a4c5e-a2f9-9a2b-f9fd-8afdafff10c1
msgctxt "ha2ef9bf5gb740g4aa8g8974g6d37afb68f92"
msgid "No deal. But I'll pay you twice what I owe you - next time."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Lump the Enlightened
#. NodeID = c2e36f53-d065-0625-8ce4-8dcba9d42d89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:c2e36f53-d065-0625-8ce4-8dcba9d42d89
msgctxt "h223bc3d1g7eccg4b79g81c6g9bb48adc5eea"
msgid ""
"Mmm. That's a fight I may not win. Pity, too - I found an ale that would "
"pair nicely with your marrow."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Lump the Enlightened
#. NodeID = cb828fb4-eacd-b64e-36bb-5a9785de8d5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:cb828fb4-eacd-b64e-36bb-5a9785de8d5a
msgctxt "hb9e94e16g1b71g4e65g8585g86061ea1be0c"
msgid "A pity for us both."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Lump the Enlightened
#. NodeID = e00411fd-1f7e-da20-e581-7f977cd5c747
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_AggroOnPlayer = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:e00411fd-1f7e-da20-e581-7f977cd5c747
msgctxt "h313eb746g1ddbg4b2eg9666g015195802184"
msgid ""
"You think my mind so flaccid? I will crack your bones and suck their marrow!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Lump the Enlightened
#. NodeID = eea3c3dc-2306-1107-6359-61e5c544d91c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:eea3c3dc-2306-1107-6359-61e5c544d91c
msgctxt "h8e1d6b4eg4c6eg4193ga650ga4847c1f5dd8"
msgid "Consider me satisfied."
msgstr "제가 만족했다고 생각하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
