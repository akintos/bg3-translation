msgid "Dost thou need my services?"
msgstr "그대는 내 도움을 받겠는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 613f0465-8a8b-1e4b-e296-6ae95124bf72
#. HandlePath = TaggedText[0].TagText[0]
