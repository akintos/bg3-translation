msgctxt "h8967e1c2gb58cg422cg8d04ga01c351b5f03"
msgid "<i>Twirl about with flair and abandon.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 1fd4f38c-d6ae-793b-4cdd-375f0d8d278e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:1fd4f38c-d6ae-793b-4cdd-375f0d8d278e
msgctxt "h324a2e88g94bbg44adg96b6g0adf8a2f6fa8"
msgid ""
"Bashful tonight, are we? Perhaps you will take to a more - relaxed style."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 2105d85b-02dc-f7d3-f146-ff255e179ac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:2105d85b-02dc-f7d3-f146-ff255e179ac8
msgctxt "hb343e6f5gd775g4d41gbe8ag4e76169894b7"
msgid "That sounds wonderful."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 215ebdd1-2940-5c5c-a927-fbd1016828b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:215ebdd1-2940-5c5c-a927-fbd1016828b8
msgctxt "ha7732d53g0f09g4975g8bd6g047e883c9011"
msgid "Good night. And thank you. For the dance, I mean. I won't forget it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 2401b997-037c-1057-5e1f-a964f8c1dd75
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:2401b997-037c-1057-5e1f-a964f8c1dd75
msgctxt "h50e1eb7bg288fg4ce4gb550g28672a9c4042"
msgid "<i>Gather your strength and leap into the air.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 257093ad-501a-bec9-44c2-3e95e8e3268e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:257093ad-501a-bec9-44c2-3e95e8e3268e
msgctxt "heebb94f9g1622g42efg8fd5gaf9905c7b380"
msgid "Trust me. I don't think you could fail anyone if you tried."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 267b20ea-3807-ed39-2fdc-3f4453c8b10a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:267b20ea-3807-ed39-2fdc-3f4453c8b10a
msgctxt "he18c9735g8f67g4f5eg90ffg8c56b095b492"
msgid "<i>Smile nervously.</i>"
msgstr "<i>초조하게 미소짓는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 269563a9-9558-7cc4-dade-9ce1238803b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:269563a9-9558-7cc4-dade-9ce1238803b7
msgctxt "hc3d5b0d7g57a2g4051gb986gc59ee194f92c"
msgid "I was hoping we might spend the night... together."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 27b13601-1315-edb7-d7d2-fde61dd7c36f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:27b13601-1315-edb7-d7d2-fde61dd7c36f
msgctxt "h88ce40fcg5f09g415cgb07cg6a0fdfa7630f"
msgid "I could <i>really </i>hurt you."
msgstr "<i>진짜로 </i>다치는 수가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 2b792a49-bc70-f79a-f03c-45c4012e2cac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:2b792a49-bc70-f79a-f03c-45c4012e2cac
msgctxt "h44d9c02dgce87g4500g9afcg6bc2be9b9333"
msgid "How utterly charming!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 2ec4076c-5850-1d1b-9a5c-532ab9a1db01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:2ec4076c-5850-1d1b-9a5c-532ab9a1db01
msgctxt "h16633c02g7b46g4d16g81b1ge15c9ac8459a"
msgid "Oh goodness. Is it all that bad? I'm dreadfully out of practise."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 2f17a888-8edb-57f6-24fa-bf417641756c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = False
#.     - ORI_State_DatingWithWyll(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:2f17a888-8edb-57f6-24fa-bf417641756c
msgctxt "h90cbb7d8g788eg40e0g888bg3b1fec0d9113"
msgid "This has gone too far. I should take my leave."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 3072b61a-44fe-34e1-4c33-97ccbac639b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:3072b61a-44fe-34e1-4c33-97ccbac639b9
msgctxt "h95b2e1fcg6074g4ff3ga1adg5bf701855a0d"
msgid "Oh."
msgstr "오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 33aab6ec-e385-ed1b-079b-86ef64652762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:33aab6ec-e385-ed1b-079b-86ef64652762
msgctxt "h1c754985gea60g4439g8483g25efa11292f2"
msgid "But you won't."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 350db521-75dc-d8f9-5b28-ce6010dbabaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:350db521-75dc-d8f9-5b28-ce6010dbabaf
msgctxt "h7936c336g1919g4a86g84feg6c8bdef6392b"
msgid "Good night, Wyll."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 3623ecd8-aea9-36e0-5ea9-5b1c4622ff88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:3623ecd8-aea9-36e0-5ea9-5b1c4622ff88
msgctxt "h90e645eagc252g4efega9a0g8e6d9dff2a58"
msgid "Bravo. Bravo!"
msgstr "브라보. 브라보!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 40e5e97c-2e63-bd45-3f7d-499bfd2bd4d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:40e5e97c-2e63-bd45-3f7d-499bfd2bd4d0
msgctxt "h86d6d2cbg4174g47d8ga765gee7e9a2f94f8"
msgid ""
"*Sigh.* I've drunk wines from Daggerford to Cormyr, but I've never known a "
"taste as rich as yours."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 414f6495-9259-c891-56d2-cd36098d896d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:414f6495-9259-c891-56d2-cd36098d896d
msgctxt "h5ade1b9bg65ebg4dfdg800dg9910754e42c3"
msgid "<i>Move in for another kiss.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 41c93586-5ec5-8e41-e2a1-ba9debeed707
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:41c93586-5ec5-8e41-e2a1-ba9debeed707
msgctxt "hfe718efegc840g4cebgbd21gf2d19778f3cf"
msgid "Well, not all of us were born with silver spoons in our mouths."
msgstr "뭐, 모든 사람이 부유한 집안에서 태어나는 건 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 4ccac9e8-6330-064d-824e-c5e8605090e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:4ccac9e8-6330-064d-824e-c5e8605090e5
msgctxt "h40ddfb95gac64g4601gb302gd0701324e8ae"
msgid ""
"Don't worry. It's not really about the dance. It's about who's we're dancing "
"<i>with.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 4cf12985-ccca-79ab-169a-83a467eb7f0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:4cf12985-ccca-79ab-169a-83a467eb7f0c
msgctxt "h67f27c46g0895g4a50ga803gd588c904ec35"
msgid ""
"Well - it's getting late. We can't face the morrow if we don't bid farewell "
"to the now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 4e0d0c8f-0c1d-8a97-76ef-1e950fd5b3a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:4e0d0c8f-0c1d-8a97-76ef-1e950fd5b3a2
msgctxt "h6c61e6a9gad07g462fgaf43g36b9e61d20a6"
msgid "A new partner? And who might that be?"
msgstr "새로운 파트너? 누구일려나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 4e7b0d23-e5a0-1bca-208b-a2e4244e59c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = True
#.     - ORI_State_DatingWithWyll(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:4e7b0d23-e5a0-1bca-208b-a2e4244e59c2
msgctxt "he7a59c9eg2e29g455bga952g030a1cfd4429"
msgid ""
"<i>Invite him closer with a knowing look - it's what you both want. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 541d19a2-b899-57c4-8ffc-c3428dceadda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:541d19a2-b899-57c4-8ffc-c3428dceadda
msgctxt "hb6d09848g7d9fg4a21g915dg6a6b5de7b60e"
msgid "You're a beautiful dancer. I'm sure you'll teach me in no time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 54fd2887-082c-e9d4-0f82-daeecb114d54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:54fd2887-082c-e9d4-0f82-daeecb114d54
msgctxt "h7257ce04ga3a4g4e29ga168g817b04ada3b9"
msgid "I'm ready - let's dance."
msgstr "준비됐어. 우리 함께 춤추자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 59a3db83-1bd4-ce20-0193-cd61e40fa6bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:59a3db83-1bd4-ce20-0193-cd61e40fa6bb
msgctxt "h509b2755gf849g4f83gaf8cge6d6c7eab25b"
msgid ""
"No better time to brush up on my skills, then. It would do me no good to "
"fail my new partner."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 5aad086f-d649-c5fa-9227-f26492a22a52
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = True
#.     - ORI_State_DatingWithWyll(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:5aad086f-d649-c5fa-9227-f26492a22a52
msgctxt "h3f302130g4d10g478bgab72gfda5e6750686"
msgid "I'd burn you if I kissed you now, Wyll. No matter how much I want to."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 6d6d4c51-1155-fdf8-3b54-03c1552a78df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:6d6d4c51-1155-fdf8-3b54-03c1552a78df
msgctxt "hb4c7849eg335dg4b67gb99dgff828ddf0954"
msgid "Nice form. Where'd you learn to dance like that?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 7010397f-dc95-0353-03e9-92ab10cf26b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:7010397f-dc95-0353-03e9-92ab10cf26b3
msgctxt "h0063c4c3g3798g4230g9efaga09297769df5"
msgid "Good night, then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 71cc29c3-0613-8923-5ea1-98bb89eae206
