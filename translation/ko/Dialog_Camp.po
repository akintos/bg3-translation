msgctxt "h70fe40a8g1271g4c51gb840gf1481e64b54d"
msgid "I don't know what that means."
msgstr "대체 뭔 소리를 하는 거래."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Ikaron
#. NodeID = 83d0f15b-37f5-2788-7b0b-fa55d20ecdaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:83d0f15b-37f5-2788-7b0b-fa55d20ecdaf
msgctxt "hbf86a53eg311eg46f8ga02dg0f3377853ac6"
msgid "Not like you needed it."
msgstr "이미 실컷 마셨으니 됐잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = af395584-ceac-e097-e396-e7ed5233e1d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:af395584-ceac-e097-e396-e7ed5233e1d2
msgctxt "h6d108475gf3a4g421egbb35gd526e51d6231"
msgid "Have another drink and you'll know exactly what I mean."
msgstr "한 잔 더 쭉 들이켜보셔. 그럼 무슨 말인지 딱 알게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = b49532e0-3725-7557-b9b0-c9054522309b
