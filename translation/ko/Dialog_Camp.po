msgctxt "h30a3dea2g25ddg42fbg8fa5g480981ac3a6c"
msgid ""
"*The dog is unable to speak through the small bag he holds in his mouth.*"
msgstr "*개는 입에 물고 있는 작은 가방 때문에 말을 할 수 없는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
