#. NodeID = 517763cd-750f-9621-7487-781a9ad62025
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:517763cd-750f-9621-7487-781a9ad62025
msgctxt "ha05a1d46g4c1eg49dbga1b6g018e2316fb99"
msgid "It has made a monster of me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 541eaa7d-862d-bd51-08e2-752986337757
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:541eaa7d-862d-bd51-08e2-752986337757
msgctxt "h37f1f3c3ge5b9g4f23g8689g490d0159caa9"
msgid ""
"I will not allow it. I will not surrender control. Even in this place, there "
"are still innocents."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 59e97534-828a-2827-066e-bc112af440e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:59e97534-828a-2827-066e-bc112af440e1
msgctxt "h0b8c32a2g0354g450agb5deg24a04c869ac4"
msgid "*Whine.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 5eb5397c-4dd4-8d91-3852-4e0b0c80b8fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:5eb5397c-4dd4-8d91-3852-4e0b0c80b8fe
msgctxt "h5a6c258fg3d7fg49f6g8364g48e4383cb092"
msgid ""
"I am an archdruid - every fibre of my mind is attuned to nature. Give it "
"time - you will sense the rot as well."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
