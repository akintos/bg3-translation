#.     - ORI_Gale_State_AcceptedBeMyGodProposal(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:cf62350b-e10e-c2ac-26b7-24606007127a
msgctxt "h5fc742d1gdb57g40c3g9bc8gd3cdb56e8b41"
msgid "<i>Answer him with a kiss.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = d5ad42fa-4bbb-4976-48f6-182470b300db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:d5ad42fa-4bbb-4976-48f6-182470b300db
msgctxt "h71944281g149ag469eg926ag6c3247fc0317"
msgid "Just what am I agreeing to?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = d77afa8a-259f-7f6a-5389-f6e9e88362bd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Gale_State_AcceptedBeMyGodProposal(1) = True
#.     - ORI_Gale_Event_PushTowardsCrown(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:d77afa8a-259f-7f6a-5389-f6e9e88362bd
msgctxt "h7104b5b3g81bbg45daga96fg0a195a4335c6"
msgid ""
"You're right. We should not deny ourselves such a gift. The crown must be "
"ours."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = d8721eee-ade3-00b9-fb85-c41939b6b12d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:d8721eee-ade3-00b9-fb85-c41939b6b12d
msgctxt "h6518d0c1g903eg4bdaga86cgdbc818989657"
msgid "<i>Say nothing. Answer him with a kiss instead.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = daaef152-2b6a-2eeb-a58d-1f942247ae80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:daaef152-2b6a-2eeb-a58d-1f942247ae80
msgctxt "h5f4da547g0ae8g4513g8bacgace54d834b93"
msgid "You mean... you want the same as I do? "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = dac9c215-315a-cecb-bf19-8e9cd8ee7dc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:dac9c215-315a-cecb-bf19-8e9cd8ee7dc6
msgctxt "h0048090fg38d6g4da7g9102g3b7ac04a02f6"
msgid "<i>Say nothing. Answer him with a kiss instead.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = db0fbd0c-3ccb-4f70-2579-8da91e9b0429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:db0fbd0c-3ccb-4f70-2579-8da91e9b0429
msgctxt "h23d32c78gb957g4b02gbf57g83c1d515a8b4"
msgid ""
"No matter. Far be it for me to impose the majesty of the celestial canvas on "
"those unwilling to partake of its beauty."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = dc5f0b54-1760-9ec3-d127-60ea5c6002d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:dc5f0b54-1760-9ec3-d127-60ea5c6002d3
msgctxt "hac7db9c1gc9d5g4228g9692g474bbc59364d"
msgid "This folly is your own - I want nothing to do with it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = dee0acb4-3d81-bb3f-19e8-7b4a13b96b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:dee0acb4-3d81-bb3f-19e8-7b4a13b96b94
msgctxt "h453b3f70gbde5g4874gb3c0g04bc48c61e77"
msgid "I've never wanted to kiss you more than I do now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = e666b8db-edec-738f-1d38-c8a978c20aec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushTowardsCrown(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:e666b8db-edec-738f-1d38-c8a978c20aec
msgctxt "h43e90e77g03eeg4e7fgaab6ge3c6ad34e19a"
msgid "<i>Kiss him.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = e70ae5bb-a446-10c5-3f73-e0f0a4b57588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:e70ae5bb-a446-10c5-3f73-e0f0a4b57588
msgctxt "h92b57330gd404g4d53g8710g4201fc1bf380"
msgid "<i>Astra navigabimus.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = e7ef6db3-08ba-14a6-96a0-102b90906acb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:e7ef6db3-08ba-14a6-96a0-102b90906acb
msgctxt "h9f3271b5g5291g40b3gb14cgc79301426ee4"
msgid "Are you saying you want to ascend? Claim godhood?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = e99dce21-be79-5e1b-169d-bf9d044f7908
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:e99dce21-be79-5e1b-169d-bf9d044f7908
msgctxt "h17dd366cg5df4g4517g8e3fg7344a9e2be3c"
msgid "Forget it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = eb26b177-841a-65ab-b514-f3b8ce46c73a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:eb26b177-841a-65ab-b514-f3b8ce46c73a
msgctxt "hbf1df537g5c06g47c0gbd89gd8c5c451288d"
msgid ""
"Most would think me foolish, deluded even, for daring to pursue dreams of "
"wielding Karsus' Crown. I do not take your faith lightly."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = eb8e17c1-127c-3e07-8e3b-34ecc9bab2d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:eb8e17c1-127c-3e07-8e3b-34ecc9bab2d5
msgctxt "h8bc8505cg3454g4fc4g93f0gd3f5b6ec4b94"
msgid "Yes. I want you to seize the crown, and make us a new world."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = ec87ceb8-6647-9307-9533-69aa842187fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_WillingForCrown = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ec87ceb8-6647-9307-9533-69aa842187fd
msgctxt "h347a9300gf683g4b55g8c63g4288afbe94b9"
msgid "You're still determined to do this, after all that was said?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = ed288794-6d94-0b7b-ab9e-871e1dc68838
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ed288794-6d94-0b7b-ab9e-871e1dc68838
msgctxt "hbf796be9ged1ag4628g9c3ag062bf01af12f"
msgid ""
"I hope so, because honestly you have been a poor man recently. Especially on "
"the romance front..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = f5566cee-4aff-9cca-a0be-2320d378312f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:f5566cee-4aff-9cca-a0be-2320d378312f
msgctxt "h854027b2g9f8bg4df9g8384gd09e76e252f6"
msgid ""
"Thank you. But I owe you more than that. I need to help you understand just "
"what this could mean for us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = f8efbc57-0177-7e27-1bcb-c348f53a89a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:f8efbc57-0177-7e27-1bcb-c348f53a89a9
msgctxt "h2b78f3a3g2dc8g458bg9377g4681e35101eb"
msgid "<i>Astra navigabimus.</i>"
msgstr "<i>아스트라 나비가비무스</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = fb1465b8-7fc4-7ded-5ce0-172b5f58ca7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:fb1465b8-7fc4-7ded-5ce0-172b5f58ca7e
msgctxt "hd3290969gddb8g487cg9fcag6dc8df545056"
msgid ""
"No, not like that. I don't want to join them, I want to <i>better </i>them. "
"A god's powers, paired with a mortal conscience, a mortal heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = fb2a6159-4072-72e3-1915-0dfb63dfb69a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:fb2a6159-4072-72e3-1915-0dfb63dfb69a
#, fuzzy
msgctxt "hddbe646bgd883g4231g8994g255c48ae6234"
msgid ""
"The Outer Planes. This is where gods dwell. Where they observe us from afar. "
"Where they make play-things of us."
msgstr "여긴 바깥 차원이야. 신들이 머무는 곳이지. 멀리서 우리를 관찰하는 곳. 우리를 가지고 노는 곳."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = fb52ac2e-02eb-3139-00e6-be927fa32e90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:fb52ac2e-02eb-3139-00e6-be927fa32e90
msgctxt "h2f965977g680fg4bdcga590g20c33e82a6dc"
msgid ""
"Plenty, in time. This doesn't have to be the end for us - just forget the "
"crown."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = fdb7ccc7-d22c-eeec-4121-06764c596554
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:fdb7ccc7-d22c-eeec-4121-06764c596554
msgctxt "h801bad6fg7952g496bg9811g5924d496e3d3"
msgid ""
"I conjured this illusion often during my confinement in Waterdeep. An escape "
"for the mind, where there was none for the body."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = fe7facf7-315d-b54b-eb89-ed13ea6dd481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:fe7facf7-315d-b54b-eb89-ed13ea6dd481
msgctxt "hb2c09380gff3ag465cgb286g797bf58b3600"
msgid ""
"If that's true, it's thanks to you, and the trust you show in me at every "
"turn of this strange adventure of ours."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 010dfdf4-b2ae-4267-9feb-8d48a5d26f94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:010dfdf4-b2ae-4267-9feb-8d48a5d26f94
msgctxt "h57263691ge772g41bbg8f9bgedef78f67b5f"
msgid "You're deluded, Gale. There's more to life than one goddess."
msgstr "착각이 심하군, 게일. 삶은 여신 하나보다 더 많은 조건들로 이루어져 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 047aaba0-0549-4424-a738-ab251d6c1648
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:047aaba0-0549-4424-a738-ab251d6c1648
msgctxt "h0661b321gfd57g4ef7g88f1g1c99074476bb"
msgid "No, there's more to it than that. I know devotion when I see it."
msgstr "아니, 그게 다가 아니잖아. 난 헌신은 보면 알 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 063fabde-3edb-42d4-8fe9-90f2cc646c42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:063fabde-3edb-42d4-8fe9-90f2cc646c42
msgctxt "hca81610dg98f7g4f66gaba3g33689d570b70"
msgid "By all means."
msgstr "물론이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 0a5864b6-369a-4adc-a20e-970133f305dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:0a5864b6-369a-4adc-a20e-970133f305dc
msgctxt "he1d6d0d6g84f8g4d43gb4f1g8e8800d50a33"
msgid ""
"Magic is like music. But while you need it written down, I can play by ear."
msgstr "마법은 음악과 같아. 음악은 악보가 필요하지만, 난 듣는 것만으로도 연주할 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 0d6971d9-95b9-4545-9b5b-3436e95c2516
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:0d6971d9-95b9-4545-9b5b-3436e95c2516
msgctxt "h0195e999g17c4g44a7gbd1bg3d0e7c0485af"
msgid "*The Weave connects you. The moment feels intimate.*"
msgstr "*위브가 서로를 연결하고 있습니다. 이 순간이 친밀하게 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 0e63841d-6a19-d8f2-acac-ea1c1aedb7b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#.      - CAMP_GoblinHunt_State_GalePartner(1) = True
#.   Tag:
#.      - SORCERER(1) = False
#.      - WIZARD(1) = False
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:0e63841d-6a19-d8f2-acac-ea1c1aedb7b9
msgctxt "hab6b8115gfba6g43f6g8f4dg1824fb78199e"
msgid ""
"That is why I asked you to seek me out, to offer you a taste of such "
"wonders. Would you like me to show you?"
msgstr "그래서 날 찾아오라고 한 거였어, 이런 경이를 맛보게 하려고 말이야. 한번 보여줘도 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 1141382c-8e4a-4c1c-a92b-cb98497104d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1141382c-8e4a-4c1c-a92b-cb98497104d8
msgctxt "habc7220ag0031g4351g9dd3g42ac47732d7d"
msgid "You're hard to please, aren't you?"
msgstr "너 참 만족시키기 어려운 사람이구나, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 13ecb60e-3910-4aba-8936-c24110ccf244
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_CRD_SpellTeaching_Connected = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:13ecb60e-3910-4aba-8936-c24110ccf244
msgctxt "h900191a7g0d3ag4d8dg8c38g32854f8883ac"
msgid ""
"*You realise the Weave is making you one. You have but to imagine your "
"desire, and Gale will know it.*"
msgstr "*위브로 서로 하나가 되었다는 것이 느껴집니다. 당신의 욕망을 상상하기만 하면 게일이 알아챌 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 14dc85cd-4bd6-4068-80c9-fe731527715f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:14dc85cd-4bd6-4068-80c9-fe731527715f
msgctxt "h69a36e75gbc24g486fg916fgfd672e716a81"
msgid "It's not quite like praying to her. She feels closer, somehow."
msgstr "기도와는 상당히 다르네. 그래도 더 가까이 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 172a0303-0d4e-437a-a1be-cfcd3f00963f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:172a0303-0d4e-437a-a1be-cfcd3f00963f
msgctxt "hf047d5d9gacc4g4c5ag8829g7b0456e998a1"
msgid ""
"*You perceive quick-fire gusts of embarrassment, trepidation, and finally... "
"elation.*"
msgstr "*당혹감, 떨림, 그리고 마침내... 엄청난 기쁨이 순식간에 밀려오는 것이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 175173ba-d69e-2aa3-2abd-5ea8f2c21771
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#.      - CAMP_GoblinHunt_State_GalePartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:175173ba-d69e-2aa3-2abd-5ea8f2c21771
msgctxt "h8d55181dg7876g4d8bg9fefg5587b783a7e6"
msgid "I thought you wanted to show me something. Was that it?"
msgstr "나한테 뭐 보여주려고 한 거 같은데. 그거였어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 1871b6b0-f691-4aea-bed0-c8e846b3ca46
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_SpellTeaching_Attempted(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1871b6b0-f691-4aea-bed0-c8e846b3ca46
msgctxt "heb02662ag2b80g4a64gb2adg7eae6b9e8368"
msgid "Actually, never mind. Magic is just not for me."
msgstr "사실은, 신경 쓰지 마. 내게 마법은 맞지 않는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 18ee44e0-477d-97bb-0488-c13c3609097c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = True
#.      - ORI_Gale_State_GotTwoMagicItems = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:18ee44e0-477d-97bb-0488-c13c3609097c
msgctxt "h118318b6g12cbg49cbgb0c0g6e60e549d68e"
msgid "So I was. Praying - though perhaps more accurately: pleading."
msgstr "맞아. 기도 - 더 정확히 말하자면 애원이었을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 194ba35d-c6ae-01b5-4a67-1ba8f0bc6942
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:194ba35d-c6ae-01b5-4a67-1ba8f0bc6942
msgctxt "h3b024137gd542g4485g97f6g7130847cd5aa"
msgid "No special reason, really. I was just... practising an incantation."
msgstr "별다른 이유는 없어, 그냥...주문을 연습하고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 195c8b84-3d57-4d78-bb20-146e5d03ae61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:195c8b84-3d57-4d78-bb20-146e5d03ae61
msgctxt "h531784dcg74eag47c8ga75ag8a9c0169c6a9"
msgid ""
"Magic is... my life. I've been in touch with the Weave for as long as I can "
"remember. There's nothing like it."
msgstr "마법은... 내 인생 그 자체야. 난 아주 어릴 때부터 위브와 접촉하며 다루는 법을 배웠어. 다른 일은 생각조차 못했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 1b5b5284-2fd3-4f18-ba2d-be959fedf371
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC and !CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1b5b5284-2fd3-4f18-ba2d-be959fedf371
msgctxt "h4c52a973g981fg4996g9f21gb029f704dd11"
msgid ""
"Careful, Gale. The other gods are just as important. My own, for example."
msgstr "조심해, 게일. 다른 신들도 똑같이 중요하다고. 내가 섬기는 신께서 들으실라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 1b67a45c-ac23-475d-bfb5-7bbd03efc02f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1b67a45c-ac23-475d-bfb5-7bbd03efc02f
msgctxt "h14a336d5g52ecg446ega189g54392af6aac0"
msgid ""
"*The Weave evaporates, and as it does so, you realise the night feels "
"suddenly cold and lonesome.*"
msgstr "*위브가 사라집니다, 그러자, 갑자기 밤의 추위와 쓸쓸함이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 1bf56879-cde3-4d2d-b144-6fe7acddc133
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1bf56879-cde3-4d2d-b144-6fe7acddc133
msgctxt "h938dd682g1c6fg4fdegb91agc28328c7a5a4"
msgid ""
"Ah, Mystra. The matron of magic herself. An ambitious desire indeed, to hold "
"her in your hands."
msgstr "아, 미스트라잖아. 마법의 어머니가 현현했군.미스트라를 손 위에 그려내다니 야심찬데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 1bf56879-cde3-4d2d-b144-6fe7acddc133
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1bf56879-cde3-4d2d-b144-6fe7acddc133
msgctxt "hdf050f31gb219g49e1g9c7dg07addb049322"
msgid ""
"Is that Mystra I see in the palm of your hands? An ambitious spell indeed."
msgstr "네 손 위에 있던 것이 미스트라야? 엄청난 마법인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 1cf48d04-3bfb-45d7-948e-ca74da2b3724
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1cf48d04-3bfb-45d7-948e-ca74da2b3724
msgctxt "h51606e09g13fcg4bf1ga244g6cdc7372c138"
msgid "Magical. Sensual, even."
msgstr "마법 같군. 관능적이기까지 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 1d17b8ab-ec28-43b5-972c-4f05f51870c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1d17b8ab-ec28-43b5-972c-4f05f51870c9
msgctxt "hb75ae8f7g99b9g4b4egbb57gca248a611cfe"
msgid "Good night. Yes. Good night."
msgstr "좋은 밤. 그래. 잘 자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 1d54bc2f-43fc-4839-8e2c-af52840d1e60
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1d54bc2f-43fc-4839-8e2c-af52840d1e60
msgctxt "hd7fda670gf64fg4efbg8a2cg299728800f99"
msgid "<i>Imitate the gesture with a flourish.</i>"
msgstr "<i>과장된 행동으로 손동작을 따라한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 1d55f6ca-28bc-4bad-9bec-7381f3a24259
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_SpellTeaching_Mystra = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:1d55f6ca-28bc-4bad-9bec-7381f3a24259
msgctxt "h6f1eb660gdc1cg4c26g8f96g668176b2d8e7"
msgid "Mystra is all magic. And as far as I'm concerned, she is all creation."
msgstr "미스트라가 곧 마법이야. 그리고 내가 생각하기론, 그녀가 곧 모든 창조물이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 25e38f6c-6640-6558-efb6-c478f08235d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:25e38f6c-6640-6558-efb6-c478f08235d2
msgctxt "h35be623dgb8ebg4bbegb9dbgb336f9f9969f"
msgid ""
"Mystra commands all magic. Salvation, if such a thing exists, is hers to "
"bestow or withhold."
msgstr "미스트라는 모든 마법을 관장하지. 구원 같은 게 있다면, 그걸 내릴지 말지 결정하는 건 여신의 몫이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2703a30f-1877-45ec-a51c-cbc3225c3cab
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2703a30f-1877-45ec-a51c-cbc3225c3cab
msgctxt "hf2686328gc346g4dd6g8d68gd1e5af02f37c"
msgid "Meditate on the verses of the <i>Tla'ket</i>."
msgstr "<i>틀라켓</i> 구절을 떠올리며 명상한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2703a30f-1877-45ec-a51c-cbc3225c3cab
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2703a30f-1877-45ec-a51c-cbc3225c3cab
msgctxt "h2f3e0aeeg35a6g46d9g9bbaga7285e2555a2"
msgid "<i>Try to hum a familiar tune.</i>"
msgstr "<i>익숙한 노래를 흥얼거린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 2893d613-b8d1-44a4-a9eb-8d62b6822562
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2893d613-b8d1-44a4-a9eb-8d62b6822562
msgctxt "h8307a921g641fg460cg8611gf412b919e138"
msgid ""
"*Suddenly: the scent of rosewater and a sense of wellbeing. A sliver of "
"Weave that tastes sweet on the tongue.*"
msgstr "*불현듯 장미 향수의 내음과 만족감이 느껴집니다. 위브 한 조각이 혀끝에 달콤한 맛으로 내려앉습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 28fce852-cbbe-4375-a076-684f89a3d280
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:28fce852-cbbe-4375-a076-684f89a3d280
msgctxt "h9d4a3caagef6dg408fga027g4420a34c4c29"
msgid "That was... unnecessary."
msgstr "그건... 필요 없었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 2925dbba-d322-4893-a19a-cf153cd228e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2925dbba-d322-4893-a19a-cf153cd228e2
msgctxt "h81472c20g8beag43a3ga77cgefd3369d7633"
msgid "Truly."
msgstr "정말로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2b204341-5823-4539-9d44-2930934cefe0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_CRD_SpellTeaching_Pictured_Head(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2b204341-5823-4539-9d44-2930934cefe0
msgctxt "h83742825g2cafg4cf5g82ffg0c8656b286ff"
msgid "<i>Picture kicking him in the gut.</i>"
msgstr "<i>그의 고간을 발로 차는 상상을 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 2bc6fffd-3c10-41fe-b36d-8cf035264cff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_SpellTeaching_Scene = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2bc6fffd-3c10-41fe-b36d-8cf035264cff
msgctxt "h733acfeag4d71g4ef8gbea1g81f7f5d8ffed"
msgid "Oh! My, you startled me. I... I was miles away."
msgstr "오! 이런, 깜짝 놀랐네. 난... 잠시 딴생각 중이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2dec3914-f36c-40f2-859b-12406c63a6f1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2dec3914-f36c-40f2-859b-12406c63a6f1
msgctxt "h3cd1a278g72beg45d9gbd28ge018324a909e"
msgid "<i>Imagine being a child, innocent, free from your afflictions.</i>"
msgstr "<i>고통으로부터 놓여나, 때 묻지 않은 어린아이가 되었다고 상상해 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2dec3914-f36c-40f2-859b-12406c63a6f1
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2dec3914-f36c-40f2-859b-12406c63a6f1
msgctxt "hf3385c51gf797g4d31ga797g93fc86a94335"
msgid "<i>Recall a satisfying spar from your youth on Crèche K'liir.</i>"
msgstr "<i>클리르 양성소에서 마음껏 쌈박질을 하며 보냈던 어린 시절을 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2dec3914-f36c-40f2-859b-12406c63a6f1
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2dec3914-f36c-40f2-859b-12406c63a6f1
msgctxt "ha93ba82ag53e3g42c3g97b4g4e545bc382f2"
msgid "<i>Recall the satisfaction of sparring with your father in youth.</i>"
msgstr "<i>아버지와 대련하며 보냈던 어린 시절의 만족감을 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2dec3914-f36c-40f2-859b-12406c63a6f1
#. HandlePath = TaggedText[3].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2dec3914-f36c-40f2-859b-12406c63a6f1
msgctxt "h0d157d4dgfd38g4379g8705g0930abc73698"
msgid ""
"<i>Think back to before - back when hot blood flowed through your veins.</i>"
msgstr "<i>혈관에 뜨거운 피가 흘렀던 과거의 어느 한때를 회상한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2dec3914-f36c-40f2-859b-12406c63a6f1
#. HandlePath = TaggedText[4].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2dec3914-f36c-40f2-859b-12406c63a6f1
msgctxt "hd1f59ad6gb62fg4e3cg89bcgcade14c09d12"
msgid "<i>Think of mum and dad dancing in the kitchen.</i>"
msgstr "<i>엄마 아빠가 부엌에서 춤을 추던 모습을 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 2dec3914-f36c-40f2-859b-12406c63a6f1
#. HandlePath = TaggedText[5].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. TagRule: !REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2dec3914-f36c-40f2-859b-12406c63a6f1
msgctxt "h10247b5fg6c7dg4bb2g83b6gaaea39c910ba"
msgid "<i>Recall a memory of early youth, a happy family moment.</i>"
msgstr "<i>어린 시절 행복했던 순간을 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 2f2ad627-66d5-4b67-b371-b6299a1aa56b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:2f2ad627-66d5-4b67-b371-b6299a1aa56b
msgctxt "heee35b92g03ceg4794g88ddg63c3988f0821"
msgid "Good night. I enjoyed sharing a moment of magic with you."
msgstr "잘자. 너와 마법의 순간을 함께할 수 있어서 즐거웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 306963c3-a3df-4df8-852a-9d537ac4eafb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:306963c3-a3df-4df8-852a-9d537ac4eafb
msgctxt "h0f5491d7g22dcg46c2ga0d9g1f170ef441cf"
msgid "Of course, of course. I was just... practising an incantation."
msgstr "물론, 물론. 난 그저... 주문을 연습하고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 3107b67e-7704-4c0b-8fb6-db14ea98ab45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:3107b67e-7704-4c0b-8fb6-db14ea98ab45
msgctxt "h055a8b0eg6b3dg4274gbba5gc7fc20856359"
msgid ""
"<i>Harmony comes easily to you. Allow it to wash over your mind and "
"magic.</i>"
msgstr "<i>조화가 당신에게 편안히 찾아온다. 조화가 당신의 마음과 마법을 씻어내도록 허용한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 3396ee7c-8ed0-4c12-9024-a4e22c737ad7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:3396ee7c-8ed0-4c12-9024-a4e22c737ad7
msgctxt "h8f9f4287g1ec7g4adbga6f0ga516857ed71b"
msgid "I'm no paladin, like you are. It's different for a wizard."
msgstr "난 너처럼 팔라딘이 아니야. 위저드에겐 달라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 369fece8-408a-7520-90da-a0f298586c52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:369fece8-408a-7520-90da-a0f298586c52
msgctxt "h6ca03512ge87fg4172gbd33gf54d45896e1a"
msgid "So I was, praying she'd aid me."
msgstr "맞아, 날 치료해 주시길 기도했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 37096a3e-f6fd-470c-8e11-d127050845c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:37096a3e-f6fd-470c-8e11-d127050845c7
msgctxt "h916193acg79f0g4dc8g8fa6g1f455cf173f8"
msgid ""
"I think it's a mistake to hold that conviction, but I cannot force your hand."
msgstr "그런 신념을 가지는 건 실수인 것 같지만, 네게 강요할 생각은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 3891d4ca-7c65-4ea3-9598-165637dd828b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:3891d4ca-7c65-4ea3-9598-165637dd828b
msgctxt "h290203b9g4dc8g427dga5cfg048aeb06316c"
msgid "You don't have that look on your face when you're looking at 'no one'."
msgstr "'아무나'를 바라볼 때는 그런 표정을 짓지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 3d64b24d-e119-9cd0-4b32-242b94133c91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_MYSTRA(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:3d64b24d-e119-9cd0-4b32-242b94133c91
msgctxt "h033ce58ag61b0g4d62g9b86gaebd90668edd"
msgid ""
"<i>Still your mind. Focus on Mystra's grace. Her power. The peace you find "
"in following her wisdom.</i>"
msgstr "<i>마음을 편히 가져. 미스트라의 은혜에 집중해. 미스트라의 힘에. 미스트라의 지혜를 따르면서 얻는 평화에.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 3f830873-74a2-4b7c-a576-589ca04587e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_CRD_SpellTeaching_Pictured_Walk(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:3f830873-74a2-4b7c-a576-589ca04587e2
msgctxt "h734e7c4cg60a1g40f3g871ag5efb6f2aee60"
msgid "<i>Picture a romantic walk, your hand slipped within Gale's.</i>"
msgstr "<i>게일의 손을 부드럽게 맞잡으며 거니는 낭만적인 산책을 떠올려 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 41c96656-a96c-41d4-b1c7-4c1c42b21fc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:41c96656-a96c-41d4-b1c7-4c1c42b21fc3
msgctxt "h6929ede4g3702g4d3eg9de5g11cc95d2204c"
msgid "Always a pity when opportunities slip us by."
msgstr "기회를 놓치는 것은 언제나 안타까운 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 4362d780-05cc-4e7c-8b87-c0428e8fc967
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:4362d780-05cc-4e7c-8b87-c0428e8fc967
msgctxt "h493aa8b9g43bag4022g9f12g488b008df6b8"
msgid "You wouldn't say that if you felt what I feel."
msgstr "네가 나처럼 느꼈다면 그렇게 말하지 않았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 461a9612-acd9-4618-bfa4-bbc5a4505b9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:461a9612-acd9-4618-bfa4-bbc5a4505b9a
msgctxt "he1dc8441g1af3g4c71g9b57ge38fe2c95539"
msgid ""
"No sculpture or painting could ever do her justice, only the fabric that she "
"herself is and embodies:"
msgstr "어떤 조각이나 그림도 그녀의 모습을 표현하지는 못해, 그저 그녀의 파편만을 표현할 뿐이지:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 46cb0b89-d468-480f-b2e3-20bd80108ca1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_SpellTeaching_Success(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:46cb0b89-d468-480f-b2e3-20bd80108ca1
msgctxt "hd066cec4g63b9g4ecfg94e4g1159d7326d1c"
msgid "Look at that. We're channelling the Weave. How does it feel?"
msgstr "이거 봐. 우리가 위브를 다루고 있어. 느낌이 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 492a8235-c18c-47f9-9577-5bd31bfe3bc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:492a8235-c18c-47f9-9577-5bd31bfe3bc0
msgctxt "h3f1a43bag833dg4811g9e1eg578c7a270245"
msgid "She does. She's... She's Mystra."
msgstr "그래. 그녀는... 그녀는 미스트라야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 4ab2b26e-23c7-4294-91bc-df56c83584de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_SpellTeaching_Mystra = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:4ab2b26e-23c7-4294-91bc-df56c83584de
msgctxt "h1b8364f3gb4b6g4fa6g8c53g6313234142a4"
msgid "*You are safe. You are nestled in the cup of her hand.*"
msgstr "*당신은 안전합니다. 당신은 그녀의 손 안에 따뜻이 앉아 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 4bf1b932-fcd7-c29b-c211-434361d4b6e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:4bf1b932-fcd7-c29b-c211-434361d4b6e9
msgctxt "h0eb54f6bgeaa7g44a6ga2acg6e740e35714e"
msgid "In a manner of speaking, yes. I was lost in prayer of all things."
msgstr "말하자면, 그래 맞아. 기도를 하느라 정신이 팔려 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 5229b04f-cf17-443b-9956-b5f14f56dcdb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_CRD_SpellTeaching_Pictured_Nothing(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:5229b04f-cf17-443b-9956-b5f14f56dcdb
msgctxt "hd9e05aa2g6f56g4127g8c42g4cbdca87955c"
msgid "<i>Picture nothing. This is a bad idea.</i>"
msgstr "<i>아무것도 상상하지 않는다. 이건 별로 좋은 생각이 아니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 52834384-2a86-49e7-89e5-084c55a6f967
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:52834384-2a86-49e7-89e5-084c55a6f967
msgctxt "h68921488g1ad3g45beg960egd0cb20b7f15c"
msgid "Not quite. But this is the easy part. Shall we try again?"
msgstr "틀렸어. 하지만 이건 쉬운 부분이야. 다시 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 52b806fa-03d8-4339-b0de-5cbae586716b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Intelligence
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:52b806fa-03d8-4339-b0de-5cbae586716b
msgctxt "he96d5fedgf955g4101g9b87g56b087ab8090"
msgid "<i>Repeat the words, slowly, but carefully.</i>"
msgstr "<i>천천히, 조심스럽게 따라한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 560cc2fd-941b-4b00-8049-d8769de3da70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_WILDMAGIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:560cc2fd-941b-4b00-8049-d8769de3da70
msgctxt "h1fbea059gb046g4462g9571ga091cc67e1e0"
msgid "It's less 'music and poetry', and more 'I hope I don't blow up'."
msgstr "'음악과 시' 보다는 '제발 터지지 말아 주세요' 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 5871a0c1-ad74-4e4e-b340-90a3c65b3ffc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:5871a0c1-ad74-4e4e-b340-90a3c65b3ffc
msgctxt "h18883dfag72f8g4177g843bg576a15e7684d"
msgid "That it does."
msgstr "실로 그렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 589aa62b-23c9-4df0-8a5d-faf0451852e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:589aa62b-23c9-4df0-8a5d-faf0451852e2
msgctxt "h68dd667fgcba8g43b9g89fbg34f78a16564d"
msgid "Disinterest is such a disheartening condition."
msgstr "무관심이라니 아주 비관적인 태도군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 58bd0084-3437-4b15-b549-95eff90bb78f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:58bd0084-3437-4b15-b549-95eff90bb78f
msgctxt "hc6fc5961gfbb0g44a8g8a54g78ffcafbfd87"
msgid "No, I have no interest in such magic."
msgstr "아니, 그런 마법엔 관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 59dd8d4c-8178-411a-867c-53e765ebb6a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:59dd8d4c-8178-411a-867c-53e765ebb6a1
msgctxt "hd8df0072gc18eg40b0g8a01g356b4804788d"
msgid "The Weave."
msgstr "위브."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 5ac997dc-4002-41cc-bda5-c0fae820f328
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:5ac997dc-4002-41cc-bda5-c0fae820f328
msgctxt "h2c8dc78bgb397g49a0ga279g2675ed606f4b"
msgid "Yes - as raw and ancient as the veins of Bahamut."
msgstr "그래, 바하무트의 정맥 만큼이나 오래되고 변하지 않았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 5c5b4f3a-dd81-4f5a-ac11-47597a50fa14
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:5c5b4f3a-dd81-4f5a-ac11-47597a50fa14
msgctxt "h6db9d05ag1532g4c56g96a5g2a37ee1218d4"
msgid ""
"You speak a great truth. No other god other comes close to her divinity."
msgstr "두말하면 잔소리지. 미스트라의 신성은 다른 신들조차 범접할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 5d6923ba-dfaf-412e-aba7-7302e5689d2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:5d6923ba-dfaf-412e-aba7-7302e5689d2e
msgctxt "h8d3602e6gb4f6g4a06gaf3egb8486f4d1a69"
msgid "If you say so."
msgstr "그렇다면 그런 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 6165e37e-387e-49c7-3bdf-b13afaf55a19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = True
#.      - ORI_Gale_State_GotTwoMagicItems = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6165e37e-387e-49c7-3bdf-b13afaf55a19
msgctxt "h0dbb00d5g5637g4aceg98ddg16ee63cb1524"
msgid "Just pondering what I lost."
msgstr "그냥 내가 놓친게 있는지 생각하던 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 6182290d-6150-4b24-a33b-9a0902710f37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6182290d-6150-4b24-a33b-9a0902710f37
msgctxt "hdca17d77g4591g44acgaa5ag4679c371f4b5"
msgid "You sound like a smitten school boy."
msgstr "사랑에 빠진 학생같은 이야길 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 61ab61b5-26a8-4c80-90d7-4c000690f4a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:61ab61b5-26a8-4c80-90d7-4c000690f4a2
msgctxt "h95992888gdb6bg44c3gb5d5gf8fe0bf48732"
msgid ""
"There it goes. How easily things slip away from us, no matter how hard they "
"were in the obtaining."
msgstr "여기까지네. 아무리 어렵게 얻은 것이라도 얼마나 쉽게 우리 곁에서 멀어지는지 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 623f8543-b844-4c6e-bc3d-379ee17ce8e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:623f8543-b844-4c6e-bc3d-379ee17ce8e6
msgctxt "hb6c63377g06c8g4a85gbe59gd0517439cd45"
msgid "No, but you do understand, don't you?"
msgstr "그래, 하지만 이해는 되잖아, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 62c12ad4-30b7-40e8-a36e-b55464f6c25d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:62c12ad4-30b7-40e8-a36e-b55464f6c25d
msgctxt "h1004d6b0ge99eg4355gb5f1g465715fb29f3"
msgid "You just don't understand."
msgstr "이해가 안 되나 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 631e0df4-7bfb-4265-986d-0dcbdfd2413f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:631e0df4-7bfb-4265-986d-0dcbdfd2413f
msgctxt "h81eeb6a3g1bc1g49d0gb619g4344267c9f7e"
msgid "<i>Picture the perfect darkness - to be in the womb of Shar.</i>"
msgstr "<i>완벽한 어둠을 상상한다. 마치 샤의 자궁 속에 있는 것처럼.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 6338fc26-b350-4168-8f8b-5df5c37625d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6338fc26-b350-4168-8f8b-5df5c37625d0
msgctxt "h3f55e721gbeb5g430egb023g04db3e50c3c1"
msgid "I'm going to bed. Perhaps this was all a mistake."
msgstr "자러 가야겠어. 이 모든 게 실수였는지도 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 6871c9aa-d5fe-4754-a1fe-339c929ce9e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6871c9aa-d5fe-4754-a1fe-339c929ce9e9
msgctxt "h94c6ef9bg84e4g47dfga80bge6f653d671b3"
msgid "It feels like a good time to call it a night."
msgstr "이만 잠을 자기에 좋은 시간인 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 6a3a80aa-84c7-421a-b888-d3787c64ff0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6a3a80aa-84c7-421a-b888-d3787c64ff0e
msgctxt "h1f1a8338g18acg44b6gbcb1ge7e9437cca3a"
msgid "Excellent. Now repeat after me: <i>Ah-Thran Mystra-Ryl Kantrach-Ao</i>."
msgstr "좋았어. 이제 날 따라 말해 봐: <i>아-쓰란 미스트라-릴 칸트라크-에이오</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 6bca37ae-31f5-490a-aba2-0efd5a8956d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6bca37ae-31f5-490a-aba2-0efd5a8956d0
msgctxt "he7ffec5dgb6d3g439bgae22g959186f1504c"
msgid ""
"Perhaps we can share the experience by reaching into the Weave together."
msgstr "함께 위브에 연결해 경험을 나눌 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 6c41dbb3-bd6c-4365-a698-5758479730a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6c41dbb3-bd6c-4365-a698-5758479730a1
msgctxt "hf75340b2g67cbg40cfg95c6g3be20cbca8a2"
msgid "Not praying. Not quite. I was just... practising an incantation."
msgstr "기도하는 건 아니었어. 난 그저... 주문을 연습하고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 6d3e36c1-4d7d-485e-8d12-fe62aa3a0292
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6d3e36c1-4d7d-485e-8d12-fe62aa3a0292
msgctxt "h56db6693gbe7eg487eg8ac3g346fdf87d57b"
msgid ""
"Magic <i>is</i> music, poetry, and beauty. Though I suspect you and I "
"perform it differently."
msgstr "마법은 음악, 시, 그리고 아름다움이야. 물론 너와 내가 그걸 행하는 방법은 다르겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 6e407a15-bd9c-4efe-b322-af80c9a34375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6e407a15-bd9c-4efe-b322-af80c9a34375
msgctxt "h543520ccgafe5g4bdeg8ba0g4b835a267704"
msgid ""
"<i>You're in no mood to be so close to Gale. Release your grasp on the "
"Weave.</i>"
msgstr "<i>게일과 그렇게 가까워질 기분이 아니다. 위브에서 손을 뗀다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 6e9322a6-5100-4c92-89f4-08c6a2ebb28a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(BARD and SORCERER and WIZARD)
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:6e9322a6-5100-4c92-89f4-08c6a2ebb28a
msgctxt "h90e2c907g0ae9g4974g90ecg75dcc8191c0a"
msgid "The figure you conjured: who is she? Someone you miss?"
msgstr "네가 만들었던 환영: 그녀는 누구야? 네가 그리워하는 사람인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 72d365fa-d1d8-4cd0-aa23-e64da79ac71b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:72d365fa-d1d8-4cd0-aa23-e64da79ac71b
msgctxt "h3fc982aag2349g4987g995egcde277e48766"
msgid ""
"In any case, don't blame yourself. Mystra can be a fickle mistress. As I'm "
"sure you're aware."
msgstr "어쨌든 너 자신을 탓하진 마. 미스트라는 변덕스러울 때가 많으니까. 너도 알겠지만 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 74122d5f-cfb6-498c-8245-9027ff807a91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:74122d5f-cfb6-498c-8245-9027ff807a91
msgctxt "hbdb35927ge515g44b9gbd42g9f5aaab61e40"
msgid ""
"*You see - or is it sense? - the unmistakable presence of Mystra, the Lady "
"of Mysteries.*"
msgstr "*무언가 보입니다. 아니, 느껴진다고 해야 할까요? 분명 신비의 여인, 미스트라의 존재감입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 769c23e6-2deb-4baf-8e2d-d63d2b8da886
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 2
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:769c23e6-2deb-4baf-8e2d-d63d2b8da886
msgctxt "h0d40df34gf42dg42e3g9f74gef59df66c4fa"
msgid "<i>Attempt the gesture again. Give it more flair.</i>"
msgstr "<i>동작을 다시 시도한다. 더 마음을 담아서 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 77b0fd5f-bb24-45cb-9b5e-5a1eee21f2f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:77b0fd5f-bb24-45cb-9b5e-5a1eee21f2f0
msgctxt "ha65177e7ga57bg4e21gad97g2567f243e05b"
msgid ""
"No, I'm sorry, but it looks like magic's not on the cards tonight. Perhaps "
"I'm not quite the teacher I fancy myself to be."
msgstr "미안하지만 오늘은 마술을 배울 수 없을 것 같아. 내 생각보다 가르치는 데 소질이 없나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 7ca6c500-c3f4-4d1c-9ff2-50464ad6edfa
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:7ca6c500-c3f4-4d1c-9ff2-50464ad6edfa
msgctxt "h8eb4d020g49c3g42d4ga0d7g3f730818ba11"
msgid "A well-crafted illusion. Mystra would no doubt approve."
msgstr "아주 잘 만들어진 환영이던데. 미스트라가 허락하지 않을 리 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 7cd32ce0-8627-4570-b6fa-ccedd6fa4692
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:7cd32ce0-8627-4570-b6fa-ccedd6fa4692
msgctxt "hbdfaf338g9464g4d16g835ag98f9601a3e3f"
msgid "Were you praying to Mystra? If so, I'd gladly join you in prayer."
msgstr "미스트라께 기도드리고 있었나? 그럼, 나도 기꺼이 밤샘기도에 동참하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 7cd32ce0-8627-4570-b6fa-ccedd6fa4692
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC and !CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:7cd32ce0-8627-4570-b6fa-ccedd6fa4692
msgctxt "h5dca3dbcgd9cfg4640ga55egf340f080b0c2"
msgid "I know that look. You were praying to your goddess, weren't you?"
msgstr "그 모습이 누군지 알겠군. 네 여신에게 기도하고 있었잖아, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 7cd32ce0-8627-4570-b6fa-ccedd6fa4692
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: PALADIN
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:7cd32ce0-8627-4570-b6fa-ccedd6fa4692
msgctxt "h56137986g395fg452ag9c17ge2bd82c3eae1"
msgid ""
"Were you praying to your goddess? If so, I'd be glad to join your vigil."
msgstr "여신께 기도드리고 있었나? 그럼, 나도 기꺼이 밤샘기도에 동참하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 7d3e9429-2acb-44b6-8790-6530cd8adfff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:7d3e9429-2acb-44b6-8790-6530cd8adfff
msgctxt "h4cda75e8gcd33g4158gbc90gb92ffbd10095"
msgid "Pretty."
msgstr "예쁘네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 8293db47-a136-2cb7-6087-9101ff07b8da
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:8293db47-a136-2cb7-6087-9101ff07b8da
msgctxt "hcd8815d6gc35bg4ec9ga635g317dab94a330"
msgid ""
"There's more to it than that. You were contemplating her in a way I can "
"hardly fathom."
msgstr "숨기지 마. 내 머리론 이해할 순 없지만, 넌 분명 그녀를 생각하고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 88ac503b-e0d2-41a7-b785-9f06be32218c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD or CLERIC_MYSTRA or SORCERER or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:88ac503b-e0d2-41a7-b785-9f06be32218c
msgctxt "hc0654d09gfad6g4e88gbf73gb94067aa645d"
msgid "<i>Imitate the gesture with ease.</i>"
msgstr "<i>손쉽게 손동작을 따라한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 89c8ea4a-4702-49c2-8f18-f2e7016067bf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:89c8ea4a-4702-49c2-8f18-f2e7016067bf
msgctxt "hdaf52553g9b08g4179g919cg2e3485002985"
msgid ""
"There's more to it than that. The figure I saw: she means something to you."
msgstr "뭔가 더 있잖아. 내가 봤던 그 형상, 그녀가 분명 너에게 의미 있는 사람이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 8a1359f2-1cd8-47da-b7db-88190692dac9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:8a1359f2-1cd8-47da-b7db-88190692dac9
msgctxt "hdcaf3ce3g84deg4f00gaa5bg5ba08a4f2946"
msgid ""
"I'd be glad to try, though I normally commune with Mystra through prayer."
msgstr "해 보고 싶어, 물론 나도 기도로 미스트라와 교감하기는 하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 8a49f135-5093-454c-8084-fa8b71e32295
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:8a49f135-5093-454c-8084-fa8b71e32295
msgctxt "hea1a6240g0331g4b97gb27fg41d657c7390f"
msgid "I didn't realise the depth of your devotion."
msgstr "네가 그렇게까지 헌신적인 줄은 몰랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 8d49ee5b-0102-4fbe-86a3-86258f576f95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#.      - CAMP_GoblinHunt_State_GalePartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:8d49ee5b-0102-4fbe-86a3-86258f576f95
msgctxt "haddb57c9gf407g4108g8390g2c6f1a1db5d8"
msgid "Whatever this is, save it for tomorrow. We have a long day ahead of us."
msgstr "뭔진 모르겠지만, 내일로 미뤄둬. 긴 하루가 기다리고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 8e6c97f2-7be2-4c00-8f07-b2aaaf1e9ebc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:8e6c97f2-7be2-4c00-8f07-b2aaaf1e9ebc
msgctxt "hbd081daegf878g419fgbf08g3b3c39d6e1b8"
msgid "What can I say? She's... She's Mystra."
msgstr "뭘 더 말할 수 있겠어? 그녀는... 그녀는 미스트라야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 9063f78d-3a60-4171-842a-787cf396f4d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:9063f78d-3a60-4171-842a-787cf396f4d8
msgctxt "he1beb0b4g2400g4fbagbf4eg8e7eac434876"
msgid "That's the deity you wizards adore. Mystra, right?"
msgstr "마법사가 섬기는 신. 미스트라, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 91e1e6e2-af86-4af3-93ce-bd7066d66507
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(CLERIC_MYSTRA and PALADIN_MYSTRA)
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:91e1e6e2-af86-4af3-93ce-bd7066d66507
msgctxt "h50103da8ga62fg47aag9517g6be0ab38867d"
msgid ""
"In any case, don't blame yourself. Mystra can be a fickle mistress. Coy to a "
"tee."
msgstr "어쨌든, 자책하지 마. 미스트라는 변덕을 자주 부리거든. 수줍음이 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 932041b8-46f8-4fdd-9b32-1d3a5fb2f565
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD or SORCERER or WARLOCK or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:932041b8-46f8-4fdd-9b32-1d3a5fb2f565
msgctxt "hb3cf397cg0e3ag43c4gbc2cg0a1a57f0a480"
msgid "Is it the same for you?"
msgstr "너도 그런가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 93f316a6-a0a0-49c7-a49b-45ef32d793e5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD or SORCERER or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:93f316a6-a0a0-49c7-a49b-45ef32d793e5
msgctxt "hd06af7c5g56bcg4a29g88d9gb48662e9c01c"
msgid "Care to tell me why you were conjuring an image of the goddess?"
msgstr "왜 여신 얼굴 형상을 소환했는지 말해주겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 966c5911-3e4b-44cb-b3e6-2257b5a7d9e0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:966c5911-3e4b-44cb-b3e6-2257b5a7d9e0
msgctxt "h1063a0cbg303cg4334gbc3bge5f19a5f4e62"
msgid "<i>Imitate the gesture slowly and as precisely as you can.</i>"
msgstr "<i>최대한 느리고 세밀하게 손동작을 따라한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 9831296f-19b6-4453-83c6-c72d8a98c356
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:9831296f-19b6-4453-83c6-c72d8a98c356
msgctxt "h88377ce6g7d71g4e1aga14fg26ca7a313905"
msgid "Long days, yes."
msgstr "그래, 정말 긴 하루였지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = 99c27e02-6023-4641-87da-850056ae9b54
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC and !CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:99c27e02-6023-4641-87da-850056ae9b54
msgctxt "h4c7b7e29g63afg414cg8e24ge5b9848cf7ee"
msgid "Magic normally comes to me through prayer, but I don't mind trying."
msgstr "마법은 주로 기도를 통해 내게 오지만, 시도해 봐서 나쁠 건 없겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 9ac5d7aa-553c-44ee-9969-511d6ca6684f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:9ac5d7aa-553c-44ee-9969-511d6ca6684f
msgctxt "ha04eabcegcdb9g4d9ega223gdb671ace5856"
msgid ""
"I think it's a mistake to give up on the brink of success, but I cannot "
"force your hand."
msgstr "성공을 눈앞에 두고 포기하는 건 실수라고 생각하지만, 강요할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = 9c359b7c-54f0-4c30-bf63-d3db3479a230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_SpellTeaching_Mystra = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:9c359b7c-54f0-4c30-bf63-d3db3479a230
msgctxt "h1c1db297g28d0g423dg9e69gcc9e9d70b9e2"
msgid "*You are safe. You are nestled in the cup of Mystra's hand.*"
msgstr "*당신은 안전합니다. 미스트라의 손길 속에서 따뜻하게 안겨있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = 9e349177-3ab3-b064-825e-5409cb4d9d22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:9e349177-3ab3-b064-825e-5409cb4d9d22
msgctxt "h2339c3aagac1dg4d1fg8cd1gc3d18e345522"
msgid ""
"Mystra, for indeed it was her image I conjured, commands all magic. "
"Salvation, if such a thing exists, is hers to bestow or withhold."
msgstr ""
"미스트라, 내가 소환했던 얼굴 말이야. 그녀는 모든 마법을 관장하지. 구원 같은 게 있다면, 그걸 내릴지 말지 결정하는 건 여신의 몫이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = a46c505d-520d-43fd-9998-057f5a981bab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_SpellTeaching_Success(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:a46c505d-520d-43fd-9998-057f5a981bab
msgctxt "h03ea8079g5a8ag49f1gbf03g4e867c38ddc2"
msgid "You did it. You're channelling the Weave. How does it feel?"
msgstr "해냈군. 위브를 다루고 있어. 느낌이 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = a494bb7e-0f0c-40bb-9f02-4f37cfb7f9fd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:a494bb7e-0f0c-40bb-9f02-4f37cfb7f9fd
msgctxt "hb0ecbc64gba35g41f0g965dg141ec3d6d656"
msgid "<i>Think of the here and now: this unexpected moment of learning.</i>"
msgstr "<i>예상치 못했던 배움의 시간, 바로 이 순간을 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = a495c181-1872-4899-8680-cdf050e73fe9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:a495c181-1872-4899-8680-cdf050e73fe9
msgctxt "hd133529egf0ecg4607g9e9ag46c2e040eefd"
msgid "I'm no cleric, like you are. It's different for a wizard."
msgstr "난 너처럼 클레릭이 아니야. 위저드에겐 달라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = a4d71e5b-a88f-43fe-ac4f-95b6be51ae6a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:a4d71e5b-a88f-43fe-ac4f-95b6be51ae6a
msgctxt "hb77e87bfg336fg4232g9b3dgd4087bb78583"
msgid "I... I didn't think..."
msgstr "난... 그럴 줄은..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = a93a619b-26f4-4dd5-92e4-dd8af823f9f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:a93a619b-26f4-4dd5-92e4-dd8af823f9f8
msgctxt "h1a7e714dgb50ag4af6g9eaagda83ca7d6fea"
msgid "I see you understand."
msgstr "이해하고 있구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = af80f3e8-7baa-4e7d-89a7-f1c23ef6d11c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:af80f3e8-7baa-4e7d-89a7-f1c23ef6d11c
msgctxt "hacc6e57fgbc34g498egaa06g25d8f49bf841"
msgid ""
"I do - because it's through practice that I seek to perfect. To augment."
msgstr "하지, 난 연습을 통해 완벽을 추구해. 실력을 키우는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = b08e4817-beb6-47fb-80b0-7ba89a6412de
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD or CLERIC_MYSTRA or SORCERER or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:b08e4817-beb6-47fb-80b0-7ba89a6412de
msgctxt "hcbdb14a5g5f5ag4906gbad6gb1e3a1a883f2"
msgid "<i>An easy incantation. Simply repeat after Gale.</i>"
msgstr "<i>쉬운 주문입니다. 게일을 손쉽게 따라합니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = b22a1c05-a11b-4db8-9718-f4292fd63b3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:b22a1c05-a11b-4db8-9718-f4292fd63b3c
msgctxt "haf7d05c2g9264g4a34gae93g0b34acb4ec64"
msgid "<i>Hold on to the moment. It's a good night for intimacy.</i>"
msgstr "<i>잠시 순간을 즐긴다. 친밀감을 느끼기에 좋은 밤이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = b6ad99d9-ddc6-430d-b4d3-feda101f90ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:b6ad99d9-ddc6-430d-b4d3-feda101f90ba
msgctxt "h86d01531g7382g4dafga195g9d235392ca3c"
msgid "I'll leave you to it then. Good night."
msgstr "그럼 그냥 내버려 둘게. 잘자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = b6e4d90a-b952-4696-ae4f-e6e922582a07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:b6e4d90a-b952-4696-ae4f-e6e922582a07
msgctxt "h74e643fagd325g4898gb940g6004a2e4e4b9"
msgid "And long, lonesome nights."
msgstr "아주 길고 외로운 밤이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = b739c102-e90f-4434-ba59-2a63cb677b97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:b739c102-e90f-4434-ba59-2a63cb677b97
msgctxt "h7792afe6g2e27g4bfdg80c6gf2df63c7e12e"
msgid "Believe it or not, I can relate."
msgstr "믿거나 말거나, 나도 공감해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = b7d20185-fcdc-71fe-fe2b-8758234ae32a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:b7d20185-fcdc-71fe-fe2b-8758234ae32a
msgctxt "h874acd52ge20bg4f90g9f3fg9e670f64990c"
msgid "<i>A satisfying end to a wondrous experience. It's time to let go. </i>"
msgstr "<i>멋진 경험이 만족스럽게 끝났다. 이제 가야 할 시간이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = bb675b7d-5088-4f64-a227-f8c6969f5829
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_SpellTeaching_Attempted(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:bb675b7d-5088-4f64-a227-f8c6969f5829
msgctxt "h4f01dfa3g4909g4885g8610g6dc409592ae7"
msgid "Actually, I dislike tongue twisters. Let's just call it a night."
msgstr "사실, 어려운 발음은 싫어서. 이만 자자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = bc7023b2-3d1e-4431-a574-874379610a7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:bc7023b2-3d1e-4431-a574-874379610a7c
msgctxt "h92d400c9gd311g46fbg8900ga2c44bc5e3a0"
msgid "I practise magic, not melodrama."
msgstr "난 마법을 연습해, 멜로 드라마가 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = bcb25262-00e3-46ed-beb8-8f33f8e8f8f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_SpellTeaching_Attempted(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:bcb25262-00e3-46ed-beb8-8f33f8e8f8f3
msgctxt "h95a8a2b6ge754g4e33g9532g5aa07cd2b349"
msgid ""
"That's too abstract for my tastes. Let's just forget about it, shall we?"
msgstr "내겐 너무 추상적인 개념이야. 그냥 없던 일로 하자, 알겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = bcc8c385-dbc2-406d-bc1f-1f2eb43200de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:bcc8c385-dbc2-406d-bc1f-1f2eb43200de
msgctxt "hfc84f9d7g5f2bg4e97g8579gcdbb0831dd8b"
msgid "Most pleasant, in fact. Most welcome."
msgstr "사실, 아주 즐거운 상상이었어. 아주 환영이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = bfab4b35-3de8-4909-94af-dd4b459fac22
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_CRD_SpellTeaching_Pictured_Spike(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:bfab4b35-3de8-4909-94af-dd4b459fac22
msgctxt "h2e886329g4609g4492g8766g84c4dc8a9d12"
msgid "<i>Picture his severed head on a spike.</i>"
msgstr "<i>그의 절단된 머리가 창에 꽂혀있는 상상을 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = bfc8440d-0cfb-4cae-915b-d65f4654263c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:bfc8440d-0cfb-4cae-915b-d65f4654263c
msgctxt "h5319343cg3331g4156gac43gbc5931549c46"
msgid "Is everything all right?"
msgstr "괜찮은거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = c24f4f69-540d-4b76-8242-ea5e2b0a1f79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c24f4f69-540d-4b76-8242-ea5e2b0a1f79
msgctxt "h5af41f98g9546g41c2g9315g108e3ce713ae"
msgid "I quite agree. There's no greater deity than Mystra."
msgstr "동의해. 미스트라보다 위대한 신은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = c328d7c3-2a17-4b4c-9f3d-ae07a231c61c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c328d7c3-2a17-4b4c-9f3d-ae07a231c61c
msgctxt "hd8219295g1536g4e74gb101gce0f1a6ccab0"
msgid ""
"*Ah, yes: the scent of rosewater and a sense of wellbeing. A sliver of Weave "
"that tastes sweet on the tongue.*"
msgstr "*아, 그래요. 장미 향수의 내음과 만족감. 위브 한 조각이 혀끝에 달콤한 맛으로 내려앉습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = c33229f1-6621-4fb6-8745-879750162e46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c33229f1-6621-4fb6-8745-879750162e46
msgctxt "h9613c3efge5dfg4912g934fg47cbe35c67d4"
msgid ""
"Fair enough - though in the end we're still playing the same composition."
msgstr "인정할게 - 어쨌거나 우린 여전히 같은 음악을 연주하고 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = c33c5a44-d8b3-416b-bcfb-48be48b1580a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c33c5a44-d8b3-416b-bcfb-48be48b1580a
msgctxt "h38e52a46gaa8cg4539g96fbg7b438a507d6e"
msgid ""
"Still, it is magic in its purest, most essential rapture that I'm trying to "
"impart."
msgstr "들어봐. 난 가장 순수하고 본질적인 종류의 황홀경을 선사하기 위해 노력 중이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = c41cfdde-bcc1-4d88-bd68-dda8a3796a76
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(BARD and SORCERER and WIZARD)
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c41cfdde-bcc1-4d88-bd68-dda8a3796a76
msgctxt "h255e1b4egccf7g4330g96b9gd1afa544060f"
msgid "Who is that?"
msgstr "그건 누구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = c6345570-6ceb-4edf-92eb-7fc80fb28d67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c6345570-6ceb-4edf-92eb-7fc80fb28d67
msgctxt "h4c1eccd0g1c92g419ag8056g044fb3b87354"
msgid ""
"It's like music, poetry, physical beauty all rolled into one and given "
"expression through the senses."
msgstr "그건 마치 음악, 시, 육체적 아름다움이 모두 하나로 합쳐져 감각을 통해 표현되는 것과 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = c65d7b3d-0be6-471b-ac33-fa99d31285a3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c65d7b3d-0be6-471b-ac33-fa99d31285a3
msgctxt "h7000622bg74b9g4fefg83f2g6783945eb915"
msgid "<i>You sense power in these words. Speak them deliberately.</i>"
msgstr "<i>단어에서 힘이 느껴진다. 신중히 따라한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = c76f528d-59c6-4933-a9cb-6ebf29af628e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c76f528d-59c6-4933-a9cb-6ebf29af628e
msgctxt "h4dd463d2gd352g4d0cg938cg98c78558ca5e"
msgid "No, no. She's no one, really. I was just... practising an incantation."
msgstr "아니, 아니야. 그냥 아무나 만든 거야. 난 그저... 주문을 연습하고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = c8a34d5d-f487-4835-9125-26488f9bc33b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:c8a34d5d-f487-4835-9125-26488f9bc33b
msgctxt "haea01d14gdc71g4d22g874dg50bada8ad804"
msgid "How narrow-minded. Magic goes far, far beyond Mystra."
msgstr "참 편협하군. 마법은 미스트라에서 멈추지 않아, 그보다 훨씬 복잡한 것이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = cc89dc10-c5e4-4488-9531-3f396d29251c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:cc89dc10-c5e4-4488-9531-3f396d29251c
msgctxt "h84fadf40g9b31g4c18gad37ga942b58924a4"
msgid "<i>Belt the words with a little flourish on 'Ao'.</i>"
msgstr "<i>'Ao' 부분에 약간의 기교를 더한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = cd4f1383-9e7c-4e66-81ed-b9ee92398ecd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:cd4f1383-9e7c-4e66-81ed-b9ee92398ecd
msgctxt "he9b8e6e7g6cf0g4c85g9a96g5a1803739b52"
msgid ""
"*You see - or is it sense? - the presence of a woman, the woman who hovered "
"over Gale's palm.*"
msgstr "*무언가 보입니다. 아니, 느껴진다고 해야 할까요? 분명 게일의 손바닥 위에 떠다니던 그 여인의 존재감입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = cf1f08f8-b27e-4b03-8b14-e0a04d68c73e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:cf1f08f8-b27e-4b03-8b14-e0a04d68c73e
msgctxt "hd6b04423g11fdg4a96gb995gf8c247ba8972"
msgid "It's getting late. Perhaps another time."
msgstr "시간이 늦었네. 다음에 다시 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = cf398643-11c7-28e0-29c2-ee6f1fa3e120
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:cf398643-11c7-28e0-29c2-ee6f1fa3e120
msgctxt "h89932a03ga6a3g495fgab37g7e30dda880cf"
msgid "<i>Imitate the gesture again. Find the magic in the movement.</i>"
msgstr "<i>다시 한 번 손짓을 흉내 낸다. 움직임 안에서 마법의 실마리를 찾아본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = cfd0647b-d1c1-4ded-a32d-8123266703af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:cfd0647b-d1c1-4ded-a32d-8123266703af
msgctxt "hfb24008bgaaf7g42bfg914dgb0560ade9c89"
msgid ""
"<i>Recede into the calm centre of your mind, just like you were taught at "
"the academy.</i>"
msgstr "<i>아카데미에서 배운 대로 마음속의 고요한 중심부로 물러난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = d34296c1-c5a9-4f2e-83f8-724852fb880d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(BARD and SORCERER and WIZARD)
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:d34296c1-c5a9-4f2e-83f8-724852fb880d
msgctxt "h7139e1fcg709cg471agba42g71257aa5815d"
msgid "Would you like to experience this?"
msgstr "너도 경험해 보겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = d4a51ed3-c0c9-486b-b63f-c773fd639775
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_DRACONIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:d4a51ed3-c0c9-486b-b63f-c773fd639775
msgctxt "heb3a2530g8c7cg44e9g800dg16a3c27ea5e9"
msgid "My magic is both ancient and raw. Sometimes even volatile."
msgstr "내 마법은 고대의 것이면서 동시에 정제되지 않았어. 가끔은 변덕스럽기도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = d5ab8bcf-04b6-4607-950b-a468b1a22695
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:d5ab8bcf-04b6-4607-950b-a468b1a22695
msgctxt "hc379a4c4g630eg4c83g82e6g28a6d30cf486"
msgid ""
"*You feel something strange - like a kind word and a kind touch at the same "
"time. It's warm and comfortable.*"
msgstr "*묘한 기분이 듭니다. 마치 친절한 말과 손길이 동시에 느껴지는 것 같습니다. 따스하고 편안합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = d6898435-637f-4de1-86b6-8cd061683633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:d6898435-637f-4de1-86b6-8cd061683633
msgctxt "h9c1f1588g0864g4b77g9237gea64f8af96da"
msgid ""
"Pish posh. One might as well deny one's mother's womb as the cradle of life."
msgstr "헛소리군. 그건 어머니의 자궁이 생명의 요람임을 부정하는 것이나 다름없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = da831814-1c6e-49bd-91c3-d529bd6dd138
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD or SORCERER or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:da831814-1c6e-49bd-91c3-d529bd6dd138
msgctxt "h51fb6d0fg771fg44e4gbc22gc25edb3e4f94"
msgid "Incredible. Though of course, I could have managed it by myself..."
msgstr "놀랍군. 물론 혼자서도 할 수 있었겠지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = dcfcfc99-0354-402f-9d11-8fc10c9eec07
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. TagRule: !BARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:dcfcfc99-0354-402f-9d11-8fc10c9eec07
msgctxt "hd46ce71dg3e8dg42f6g8838ge891fe76a501"
msgid "<i>Repeat the words, bold and proud.</i>"
msgstr "<i>대담하고 자랑스럽게 따라한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = df15e134-c970-44f4-b3d4-fac53c5dce91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:df15e134-c970-44f4-b3d4-fac53c5dce91
msgctxt "h7a7fc8e3ga834g440dgb55dg8c3c87e2ced9"
msgid ""
"I can't quite describe it, the need I sometimes feel to see her - to draw "
"the filaments of fantasy into existence."
msgstr "말로는 표현할 수 없지만, 뭔가 가끔 그녀를 보고 싶다는 욕구, 환상의 실타래를 현실로 끌어들이고 싶다는 욕구가 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = e07bde57-d5c6-4e2f-9d14-9014475fde33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e07bde57-d5c6-4e2f-9d14-9014475fde33
msgctxt "hb69b8f44g2281g4adfgbe48geaed2ecfc1df"
msgid ""
"Very good. Now I want you to picture in your mind the concept of harmony. As "
"true as you can."
msgstr "아주 잘했어. 이제 머릿속에 조화의 개념을 그려봐. 최대한 사실적으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = e4761237-423e-4c4d-8903-f0aecfbb1ed2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e4761237-423e-4c4d-8903-f0aecfbb1ed2
msgctxt "ha29f5276g0867g4e22g815cg4fed44972518"
msgid ""
"<i>Picture the silent void of Wildspace, and K'liir nestled within it.</i>"
msgstr "<i>고즈넉한 야생 공간의 공허감과 그 안에 자리 잡은 클리르의 전경을 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = e4761237-423e-4c4d-8903-f0aecfbb1ed2
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e4761237-423e-4c4d-8903-f0aecfbb1ed2
msgctxt "h05f07950g3537g434bga858g7aed25fc128a"
msgid ""
"<i>Recall standing in the sun, your eyes closed, its gentle heat on your "
"skin.</i>"
msgstr "<i>눈을 감고, 햇볕 아래 서서, 살갗에 내리쬐는 부드러운 열기를 떠올려 보세요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = e4761237-423e-4c4d-8903-f0aecfbb1ed2
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e4761237-423e-4c4d-8903-f0aecfbb1ed2
msgctxt "h9e0c9190ga8f6g4ef0g86c0g629614e0251a"
msgid ""
"<i>Picture a place of utter peace, away from all harm and the mayhem of "
"civilisation.</i>"
msgstr "<i>모든 위험과 문명의 혼돈에서 벗어난 완전한 평화의 장소를 상상한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = e5a793b8-72c5-4a17-a842-877f17e2cd72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e5a793b8-72c5-4a17-a842-877f17e2cd72
msgctxt "hc11e9bd6ge174g495bga412gf6103b4c16ad"
msgid "Good night."
msgstr "잘 자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = e5cf9051-8534-48fc-ac75-6bd79cb58570
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e5cf9051-8534-48fc-ac75-6bd79cb58570
msgctxt "h84b89076ge338g4d52g9126gc1c0bc6fc265"
msgid "Good gods, what on earth makes you picture that?"
msgstr "이런 세상에, 왜 그런 상상을 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = e619ec9f-9ea7-4641-8675-501862d0d379
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e619ec9f-9ea7-4641-8675-501862d0d379
msgctxt "h4893087egb285g4381ga650gfdcc4f7d2bc8"
msgid "<i>Sink deep into your magic. It is who you are. It is home.</i>"
msgstr "<i>마법 속으로 깊이 빠져든다. 마법이 곧 당신이다. 마법이 곧 고향이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = e6a66855-565c-4abc-84a1-b962576b00f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_SpellTeaching_Attempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e6a66855-565c-4abc-84a1-b962576b00f2
msgctxt "h963a5b4fg2b40g4f8cg9953gfe9dd7373751"
msgid "Then follow my lead."
msgstr "그럼 날 따라해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = e7f8d29d-eb19-4406-8ad0-3c6d17de9618
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e7f8d29d-eb19-4406-8ad0-3c6d17de9618
msgctxt "h6479d2c5g998fg435dg86b3gc07613fb7ff5"
msgid "Yes, I would."
msgstr "응, 해 볼래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = e92c4410-6f97-4b4a-ae24-0afc895ef239
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e92c4410-6f97-4b4a-ae24-0afc895ef239
msgctxt "h0ea59df9g80afg4d72g890agc88c9e3c41e1"
msgid "Quite so. The Weave is a sensitive conduit."
msgstr "그렇지. 위브는 꽤 민감한 매개체거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = e941d5d9-91bd-4bf2-93b5-70959d6f59d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:e941d5d9-91bd-4bf2-93b5-70959d6f59d4
msgctxt "hac5c79ebg5682g4b06g9ad5gb855b1fc6f51"
msgid "It's different for me. Not quite so intense."
msgstr "내 경우는 좀 달라. 그렇게 과장된 편은 아니거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = eab5c779-0bed-4531-9394-a027f14ca3ca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_CRD_SpellTeaching_Pictured_Kiss(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:eab5c779-0bed-4531-9394-a027f14ca3ca
msgctxt "h615a8138g8f35g411fg9ca2g182f8dc4abcf"
msgid "<i>Picture kissing him. With tenderness. Then, with passion.</i>"
msgstr "<i>게일과의 키스를 상상해 봅니다. 처음에는 부드럽게, 곧 열정적으로.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = ec80fc1c-693a-4460-a639-69aa82742523
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 5
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:ec80fc1c-693a-4460-a639-69aa82742523
msgctxt "h4d40c970gd41dg4a53gb432gbe9cc012e7c9"
msgid "<i>Imitate the gesture quickly and decisively.</i>"
msgstr "<i>재빠르고 정확하게 손동작을 따라한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = ed606ae7-5847-419d-90a3-43f83abf0ed8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_SpellTeaching_Attempted(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:ed606ae7-5847-419d-90a3-43f83abf0ed8
msgctxt "h1bf45003g5326g409eg87feg5d806fa1d161"
msgid "No, thanks. Not my cup of tea, clearly."
msgstr "아니, 괜찮아. 확실히, 내 분야는 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = ed73b2cb-62b9-419c-9a81-e1a990d61b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:ed73b2cb-62b9-419c-9a81-e1a990d61b94
msgctxt "h5bceb715g6ddfg4ee7gb4a3gd715f51a1c8e"
msgid ""
"*There's something like the anticipation of a kiss, then the pleasure of "
"being cloaked in peace.*"
msgstr "*키스에 대한 기대감, 그리고 평화로움 속에 숨어 있는 즐거움 같은 것들이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f00caac6-9b46-4eec-2803-912272e18498
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f00caac6-9b46-4eec-2803-912272e18498
msgctxt "hcf2e5540gfa52g4f21g9446g4947aae2dfbf"
msgid "For the seldom purpose of prayer."
msgstr "모처럼 기도를 드리고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f0a53863-e4c8-4037-9439-0b513142d659
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f0a53863-e4c8-4037-9439-0b513142d659
msgctxt "h44f05a6eg9b0bg444cg8259g230be61f23d7"
msgid "Now you."
msgstr "네 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f0cacb3c-2627-427e-81e4-1b8bad77c641
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f0cacb3c-2627-427e-81e4-1b8bad77c641
msgctxt "h16be1383gc099g471ega630gb67a7af9f6a8"
msgid "You read too much into it. I was merely indulging in my passion."
msgstr "지나친 해석이군. 난 그저 내가 좋아하는 일에 빠져 있었을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f1a70ce9-f1d9-4a66-be3c-4a7f1c735987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f1a70ce9-f1d9-4a66-be3c-4a7f1c735987
msgctxt "h1da7b082g1902g47fbg80b4g6b1e2b49a947"
msgid "Perhaps I can show you what I mean by reaching into the Weave together."
msgstr "어쩌면 함께 위브를 다루면서 내가 전달하고 싶은 바를 보여줄 수 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f21bb1d3-f24a-4720-b842-ee7bd727f9a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f21bb1d3-f24a-4720-b842-ee7bd727f9a6
msgctxt "hbf6801c7gd920g44a0gafa9g91a28e61c7a4"
msgid "I know."
msgstr "나도 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f2544f6d-5bf1-2030-3412-5fbfa5a2c02f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_SpellTeaching_Mystra = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f2544f6d-5bf1-2030-3412-5fbfa5a2c02f
msgctxt "h6da361d6gc824g47aaga98bg184e29d48b53"
msgid ""
"And yet, even now, more than I fear losing my own self and soul, I fear "
"losing my command of her art."
msgstr "하지만 지금 이 순간조차 내 자아와 영혼을 잃는 것보다도 여신의 마법에 대한 통제권을 잃는 게 더 두려워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Narrator
#. NodeID = f3617c43-e923-468a-b972-3f064ed6f290
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f3617c43-e923-468a-b972-3f064ed6f290
msgctxt "hd6e744a3gbc08g4c81ga99dg82b18aa83e5b"
msgid ""
"*A familiar feeling - like a kind word and a kind touch at the same time. "
"It's warm and comfortable.*"
msgstr "*익숙한 느낌 - 다정한 말과 손길이 한번에 느껴집니다. 따뜻하고 편안합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f4db2863-d732-416e-902b-08d485e8bd7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f4db2863-d732-416e-902b-08d485e8bd7a
msgctxt "he2cac078g27e5g4421gb50fga73eb14ba43b"
msgid "Sorry, I wasn't expecting... But it is a pleasant image to be sure!"
msgstr "미안해, 전혀 예상하지 못해서... 하지만 분명 좋은 상상이었어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = f5240404-26d2-4bb0-9980-68dbce1fd88a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f5240404-26d2-4bb0-9980-68dbce1fd88a
msgctxt "h6a0db670g5095g42eaga583g1bf6ddc63a91"
msgid "Effortless. You're a wonderful teacher."
msgstr "아주 쉬워. 너는 훌륭한 선생님이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = f61d18d6-2f3f-bb96-d907-c85fade97fc0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = True
#.      - ORI_Gale_State_GotTwoMagicItems = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f61d18d6-2f3f-bb96-d907-c85fade97fc0
msgctxt "hb8164d3eg05cag4b35gad1ag8ea736eb7519"
msgid "Someone I miss and... lost, I suppose."
msgstr "내가 그리워하고...잃어버린 신이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = f7187ea3-17e1-443b-909c-313528ae99b9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC and !CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f7187ea3-17e1-443b-909c-313528ae99b9
msgctxt "h43af2afeg2c9fg4c53g9fbdg229100d45c1a"
msgid "It's different, but I can definitely feel a divine kind of presence."
msgstr "약간은 다르지만 분명 성스러운 존재감을 느낄 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = f8eb414d-50be-4136-9e74-5913087fe4d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f8eb414d-50be-4136-9e74-5913087fe4d9
msgctxt "hf9788b5bg1366g482ega0b6g052ffdb33517"
msgid "That sounds very familiar, yes."
msgstr "익숙한 이야기군, 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = f94c13f1-fde3-478d-b538-ed410882b193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:f94c13f1-fde3-478d-b538-ed410882b193
msgctxt "hcc781729gba08g48dcga503g6ff15986e1f3"
msgid "Cut it out. That spell of yours is attracting mosquitos."
msgstr "그만해. 주문 때문에 모기가 끌리잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = fb579ea9-2a02-4324-a715-bb9c8ff3890a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:fb579ea9-2a02-4324-a715-bb9c8ff3890a
msgctxt "h69b08b9bg8dcfg4815g8045g961085ee8bde"
msgid ""
"I think it's a mistake to give up so easily, but I cannot force your hand."
msgstr "너무 쉽게 포기하기엔 좀 아깝지만, 억지로 등 떠밀 수야 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = fcb4c2de-02b2-46b7-9d13-b33e71328b44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:fcb4c2de-02b2-46b7-9d13-b33e71328b44
msgctxt "h8c40edbbgfe83g49b5ga0a9g4d7f07e54833"
msgid ""
"It is a kind of love after all; at the very least a most deep seated passion."
msgstr "어떻게 보면 사랑이 맞지. 가장 깊은 곳에 잠겨 있던 열정이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = fcd19664-0ae3-4fb4-ab07-dddf79172eaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:fcd19664-0ae3-4fb4-ab07-dddf79172eaf
msgctxt "hadd2f801gec32g4d9bgb101gfc1d1eb96584"
msgid ""
"There it goes. I suppose a blow to the stomach upsets the Weave as much as "
"it would me."
msgstr "여기까지네. 위브도 나만큼이나 배에 타격을 입었나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Gale
#. NodeID = fe52da75-b955-c9bd-95ab-b386c9669e6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_GotThreeMagicItems = False
#.      - ORI_Gale_State_GotTwoMagicItems = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:fe52da75-b955-c9bd-95ab-b386c9669e6d
msgctxt "h8fdcbe5cg073cg4024gb15agbcd9a286d3a1"
msgid "More or less. I was lost in... prayer of all things."
msgstr "그럭저럭. 난 단지... 만물에 대한 묵상에 빠져 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2
#. Speaker = Player
#. NodeID = ff2d956a-e629-83d1-88d6-fe6a359ff6cc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_CRD_SpellTeaching_Pictured_Nothing(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_SpellTeaching2:ff2d956a-e629-83d1-88d6-fe6a359ff6cc
msgctxt "hf0cabde5g53aag4a1eg98c8gd4d710e472ad"
msgid ""
"<i>Picture a hearty meal with Gale, food and friendship flowing between you. "
"</i>"
msgstr "<i>게일과 함께 하는 화려한 식사, 둘 사이에 넘치는 음식과 우정을 상상해 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = 027ac1a4-dc21-4a87-3ef3-fac48590666b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:027ac1a4-dc21-4a87-3ef3-fac48590666b
msgctxt "h668b6a96gd9ddg4a7cg9e5dg5db02f9f1615"
msgid ""
"Is that so? Then we'd best hope you don't make any further miscalculations. "
"We both know what happened the last time you took something you thought you "
"deserved."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 07032f7d-15d6-2549-0d18-31334a1f8be4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:07032f7d-15d6-2549-0d18-31334a1f8be4
msgctxt "h15a9c92age6ebg4289gb91dg4a8a9c400745"
msgid "I think she misses me."
msgstr "내가 그리워서가 아닐까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 08f18584-9d8f-3223-86e0-4cb03c598d1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:08f18584-9d8f-3223-86e0-4cb03c598d1b
#, fuzzy
msgctxt "h9880418egdcf9g4f41gb1b0ga75a6edae5c9"
msgid "I think I felt Mystra's presence..."
msgstr "미스트라의 존재감을 잠시 느꼈어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = 09bd4315-8b00-2b7c-49a8-fd876cc21067
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:09bd4315-8b00-2b7c-49a8-fd876cc21067
msgctxt "h7b39d24bg4a56g4253gbac3g686a02d4de04"
msgid ""
"Well, she has a funny way of showing it, doesn't she, considering what she's "
"asked of you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 246929ea-0456-81cb-d0ad-81ee85b671db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_AbsorbedTWNBossPower = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:246929ea-0456-81cb-d0ad-81ee85b671db
msgctxt "h94993e0cg412cg4567gbc15gae7953142dde"
msgid ""
"I promise - these shadow powers will help us, even if they are... impure."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 2d6af76e-8170-b119-8929-9afa90e8c93f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:2d6af76e-8170-b119-8929-9afa90e8c93f
msgctxt "ha2a63c12ga7e8g467ag9cf6g35170a64c075"
msgid "A private matter. Nothing to concern yourself with."
msgstr "사적인 일이야. 네가 신경 쓸 건 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 32add695-e218-b783-4142-c32d940dcd63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:32add695-e218-b783-4142-c32d940dcd63
msgctxt "hbf66a07bg424eg45ddg811bg16e72a9b8d5e"
msgid "You sound just like Mystra."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = 3539590a-fc4c-65a8-455d-481828d0b7a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:3539590a-fc4c-65a8-455d-481828d0b7a8
msgctxt "hd3557bcage1cbg4086g937dgcff618423081"
msgid "You did <i>what</i>? What the devil has gotten into you?"
msgstr "<i>뭘</i> 했다고요? 도대체 무슨 짓을 하신 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = 465d3398-2679-7d15-cf9c-379e393378ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:465d3398-2679-7d15-cf9c-379e393378ea
msgctxt "h482be0eeg13e2g4507gaab2gd3d8bc4000cb"
msgid ""
"Oh, but I do concern myself, Mr Dekarios. Even when you're being as annoying "
"as you are now."
msgstr "오, 하지만 걱정되는걸요, 데카리오스 씨. 당신이 지금처럼 짜증 나게 굴 때 조차도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 58b72389-e0d0-6a6f-a40c-cda82f8892f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_CraftedDarkLantern = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:58b72389-e0d0-6a6f-a40c-cda82f8892f0
msgctxt "h4575a77dgcb2ag4f86g8b10g527a83a161d5"
msgid "I indulged in some dark magic to create a Shadow Lantern."
msgstr "그림자 등불을 만드느라고 어둠의 마법을 좀 사용했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = 63c017bb-9d0b-6882-4fc7-7eb65f749a9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:63c017bb-9d0b-6882-4fc7-7eb65f749a9c
msgctxt "hc75c9756g3824g40dcga9e3gd1ad35ab98e2"
msgid ""
"I was curled up here quite comfortably when I was suddenly overcome with "
"uneasiness. A tressym's intuition is rarely wrong. What's happened?"
msgstr "편안하게 몸을 말고 누워있던 중에 갑자기 불안감이 밀려오더라고요. 트레심의 직감은 거의 틀린 적이 없죠. 무슨 일이 있었나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = 6f6e158d-0012-6af7-901a-dadb7c62fecb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:6f6e158d-0012-6af7-901a-dadb7c62fecb
msgctxt "ha3947595g8e3cg43eag9c45g2f10ddb716bd"
msgid ""
"I trust you'll treat whatever she had to say with the required lashings of "
"salt. Better to keep your own wisdom than hers, Mr Dekarios. Or better yet, "
"keep mine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = 7eea674a-9f83-ea9a-ae3c-6986cb6859c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:7eea674a-9f83-ea9a-ae3c-6986cb6859c2
#, fuzzy
msgctxt "ha1927320gd850g4894g826bg998e488a5db0"
msgid ""
"I'll leave you to your secrets, Mr Dekarios, but allow me to remind you of a "
"simple fact. We rarely hide that which we know is right."
msgstr ""
"더 이상 캐묻지는 않을게요, 데카리오스 씨. 하나 말해두자면, 사람들이 뭔가 숨길 때는 그게 옳지 않다는 걸 알고 있다는 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 98c0e975-08e3-e296-c5b2-ab1e30e00cf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:98c0e975-08e3-e296-c5b2-ab1e30e00cf0
#, fuzzy
msgctxt "hd0c41276g11c2g488bgb636ge74d6173bf4f"
msgid ""
"I passed up an opportunity to serve Mystra's will. To give her a sign I've "
"changed."
msgstr "미스트라의 뜻을 받들 기회가 있었는데 무시하고 지나쳤어. 내가 변했다는 걸 보여주기 위해서지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = 9a40fd20-1d46-425c-1454-077e486d2d9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_CraftedDarkLantern = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:9a40fd20-1d46-425c-1454-077e486d2d9d
msgctxt "h6f02de75g0db7g43fdg94dbgd118e390b598"
msgid "I indulged in some dark magic to create a Shadow Lantern."
msgstr "그림자 등불을 만들려고 어둠의 마법을 좀 사용했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = a95afd85-c888-4df2-f1d1-a233c1c8c0a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:a95afd85-c888-4df2-f1d1-a233c1c8c0a6
msgctxt "hc0350abdgcb26g41dcga3f9g09c3b81f809e"
msgid ""
"You may as well leave your life lessons in a bucket, for all the good they "
"do you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = acf2bdd4-f7bc-5ebf-994d-36bdaf99431e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_CraftedDarkLantern = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:acf2bdd4-f7bc-5ebf-994d-36bdaf99431e
msgctxt "h7a2af0c7g468dg4a29gbf23g38831e12a780"
msgid ""
"The lantern will be useful to us. And I'll be sure to wield it carefully."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = b9c3d729-76bc-18de-116d-f8fe64f67ba3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:b9c3d729-76bc-18de-116d-f8fe64f67ba3
msgctxt "hdac67128g7131g4026ga9bcg36296c715712"
msgid "Nothing you need to be concerned about."
msgstr "네가 걱정할 만한 일은 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = ba141f91-d134-ee97-f2a9-ce524cf22bf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:ba141f91-d134-ee97-f2a9-ce524cf22bf6
msgctxt "h6b2f5bf9g2933g4ac5g8430g44d609990fb0"
msgid "I'll believe it when I see it, and not a moment before."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = c0491682-9f64-9404-c0ca-c08b49298f58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_AbsorbedTWNBossPower = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:c0491682-9f64-9404-c0ca-c08b49298f58
msgctxt "h3720ccebgc908g45b7gb867g54add1026291"
msgid "I drew power from a source of shadow magic. A corpse, to be specific."
msgstr "그림자 마법의 힘을 사용했거든. 시체를 이용해서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = c49166a5-d7f4-84d5-dc6d-e28d880bdfc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:c49166a5-d7f4-84d5-dc6d-e28d880bdfc0
msgctxt "h1cb9d465gdd4bg4b58g8106g5930e46479e9"
msgid "Good. Then she's speaking sense, at last."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = c5cfc78d-2179-d16e-0cad-d645f4e49def
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:c5cfc78d-2179-d16e-0cad-d645f4e49def
msgctxt "h5cebd596g918bg43efg8481gaa23111dc97d"
msgid ""
"Be <i>very</i> careful, Mr Dekarios. You're on a terrifying road. One "
"misstep could be your last. And then I'd be - oh, terribly cranky."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = d506be9d-699c-88eb-e2c6-5161801d48c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_IgnoredAct2Temptations = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:d506be9d-699c-88eb-e2c6-5161801d48c8
msgctxt "h802b80a8g623eg4f70gab8fgaa068ddb634e"
msgid ""
"I have a strategy in mind. One that involves not willingly provoking "
"Mystra's anger."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = e8c3234a-30b0-9652-fcfd-2bded2d90683
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:e8c3234a-30b0-9652-fcfd-2bded2d90683
#, fuzzy
msgctxt "h493d2443g9f4bg4ebfgbae6gf20707cd7ad7"
msgid ""
"You did? Well that <i>is</i> a turn-up for the books. And what led her to "
"grace you with her presence?"
msgstr "정말요? 그건 <i>정말</i> 놀랄만한 일인데요. 여신이 존재감을 드러낼 만한 이유가 있었나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = f297e359-6979-f173-fb72-c10e302e84b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_IgnoredAct2Temptations = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:f297e359-6979-f173-fb72-c10e302e84b0
msgctxt "hdb3b7b1ag06deg4efdgaf62g4ab0de310a35"
msgid ""
"I know exactly what I'm doing. Taking the power I <i>deserve</i> to wield."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Tara the Tressym
#. NodeID = fbf3c33d-1986-43c7-4f8f-7b9bf08ef572
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:fbf3c33d-1986-43c7-4f8f-7b9bf08ef572
msgctxt "h9782b16fgfe44g425eg8cceg8dca8d03d31b"
msgid "Mr Dekarios! There you are!"
msgstr "데카리오스 씨! 여기 계셨군요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = fd001ac0-4589-a02f-7ad3-7ed72d38529b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_AbsorbedTWNBossPower = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:fd001ac0-4589-a02f-7ad3-7ed72d38529b
msgctxt "hab938bdeg4516g4a37ga842g90473a0dd295"
msgid "You've a keen eye, Tara. I drew power from a source of shadow magic."
msgstr "아주 예리한걸, 타라. 그림자 마법의 힘을 사용했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive
#. Speaker = Player
#. NodeID = fe2217d7-55fc-86ad-fe66-b27dc39aba75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_IgnoredAct2Temptations = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive:fe2217d7-55fc-86ad-fe66-b27dc39aba75
msgctxt "hd1d59643g7b02g47e0gbddag9a6f50f02f34"
msgid ""
"Just because Mystra demands my life, doesn't mean I do her dirty work. I "
"make my own choices."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = 1b1fe1d0-c2f6-7b1a-e25b-09722d23bc87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:1b1fe1d0-c2f6-7b1a-e25b-09722d23bc87
msgctxt "hbaf96066ge9fbg4133gabe7g142f9d81e1a5"
msgid ""
"One thing only: he gave the strictest instructions that this letter was for "
"your eyes only."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = 2e0aa2dd-aa1a-f53a-6d1c-40d5d0eff347
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Event_ReadElminsterLetter = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:2e0aa2dd-aa1a-f53a-6d1c-40d5d0eff347
msgctxt "h0653551agbdc1g4210g84b3ge28683c5cedd"
msgid "<i>Read the letter.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = 37c5bac7-f529-b3c9-1f96-c5f719c0a740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:37c5bac7-f529-b3c9-1f96-c5f719c0a740
msgctxt "h79f32603g88deg4783g8835ga32a3bca6e6d"
msgid "Any idea what he wanted?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Weary Traveller
#. NodeID = 37e8b3b3-305f-5c81-77a9-9c13e47d82e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:37e8b3b3-305f-5c81-77a9-9c13e47d82e4
msgctxt "h8e17a0bcg07c4g439ag889dg3fef5cf60947"
msgid ""
"I see remaining optimistic as my duty - especially when I am not the one "
"being asked to do the seemingly impossible."
msgstr ""
"나는 낙관적인 태도를 유지하는 것이 내게 주어진 의무라고 생각하네. 불가능해 보이는 일을 요구받는 사람이 내가 아닐 때에는 더욱이 그렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = 3fb0b206-8b93-d6a9-7666-ca6df8219f27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:3fb0b206-8b93-d6a9-7666-ca6df8219f27
msgctxt "he0b39102g7e86g4222gb329gbcad0051e5ad"
msgid ""
"I won't pry for specifics, Mr Dekarios. Not when I can sneak a peek at your "
"letter while you sleep."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Weary Traveller
#. NodeID = 428a3c8b-f3e0-c87d-6832-b3830e45db76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:428a3c8b-f3e0-c87d-6832-b3830e45db76
msgctxt "h4773eef7gc2a2g4fb1g8abfg22b46cb34dab"
msgid ""
"Perhaps... perhaps that should have been your mission right from the start."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = 51b82ed4-fc6d-4396-7dfe-c6fa475cac9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:51b82ed4-fc6d-4396-7dfe-c6fa475cac9b
msgctxt "he6f97632g16bag4543ga1fag2b4e06b90f8d"
msgid "I'll read it later."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = 6305e4a7-014d-3225-6fd7-d7285ee6f969
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:6305e4a7-014d-3225-6fd7-d7285ee6f969
msgctxt "hc1f22622g6f8cg49ebgaf73gd893bef33bca"
msgid ""
"Speaking of which - you ought to get your rest. Quite another day ahead of "
"you, I'm sure."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Weary Traveller
#. NodeID = 6800efde-3ce4-193b-cc46-5eef27d44582
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:6800efde-3ce4-193b-cc46-5eef27d44582
msgctxt "h2d58e37bgf85cg4697gae04ga68e35c7a956"
msgid ""
"Think carefully - exceedingly so. You know Mystra, as do I. I was not born "
"an old man. I am all too familiar with what it's like to have a goddess fill "
"your heart with longing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = 7a38219c-2f30-5c54-1da0-1156807438f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:7a38219c-2f30-5c54-1da0-1156807438f1
msgctxt "he28d363agaaadg46begae10ge218dfac301b"
msgid "What is it, darling? You look rather pale."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Narrator
#. NodeID = 80f55058-132d-a5b1-f6da-49c5dcd0f38f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:80f55058-132d-a5b1-f6da-49c5dcd0f38f
msgctxt "hcfc4c9bdg0549g45fdgae35g2dd4783bcb7c"
msgid ""
"*Reading between Elminster's cramped lines, you can draw only one "
"conclusion. He thinks you should defy Mystra's instruction, and refuse to "
"use the orb.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = 8c21f2a3-faa9-02b4-c172-0c62c5272071
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:8c21f2a3-faa9-02b4-c172-0c62c5272071
msgctxt "hcbc0a164g0bcdg4c43g9df3g1e2b448932e5"
msgid ""
"Aha! Mr Aumar can always be relied upon to bring a dash of good sense to "
"proceedings. A shame he didn't <i>start</i> with that, but still."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Narrator
#. NodeID = 960aa7fb-8e04-1487-aa7a-9d5cbb31b243
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:960aa7fb-8e04-1487-aa7a-9d5cbb31b243
msgctxt "h3f4c7524g43a3g4a51gb694ga564a213e63b"
msgid ""
"*The letter is written in Elminster's crabbed hand. And, given his usual "
"verbosity, is rather succinct...*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = a6b39de7-fedf-d074-f419-9da4dd872b06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:a6b39de7-fedf-d074-f419-9da4dd872b06
msgctxt "h9a8e1237gfff8g45efgb1c7gd494d5cc00f0"
msgid "Elminster's changed his tune. He thinks I shouldn't use the orb."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = acc0eea1-b27c-d098-fa48-ee46bd5c8288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:acc0eea1-b27c-d098-fa48-ee46bd5c8288
msgctxt "h05cfb446g56c6g4195g8409gb27720f762ff"
msgid "Wrong. Go on. <i>Now.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = b04604ac-b3f8-b26a-1118-e1b77e5c75ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:b04604ac-b3f8-b26a-1118-e1b77e5c75ee
msgctxt "h849c0c66ge118g40a5g853cg7b002e7fe358"
msgid "Oh, it's nothing. A spot of indigestion."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = bc4d3772-1b0a-6649-a36d-d99b1edec3ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Event_ReadElminsterLetter = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:bc4d3772-1b0a-6649-a36d-d99b1edec3ce
msgctxt "hc59f0556g37cbg4835ga0c9g9b0384a34424"
msgid "Fine. I'll read it now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = c179ec98-646b-c7ed-17c5-f441fb23fa74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:c179ec98-646b-c7ed-17c5-f441fb23fa74
msgctxt "h2b83c428g8d5dg41b4gb833g633be52d639c"
msgid ""
"I hope you plan to heed his advice. Carefully, though. He seemed rather "
"fidgety when he delivered his message. Mystra will have both of you in her "
"bad books before long."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = c3581596-7a93-9a30-0869-f10d85e4b3cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:c3581596-7a93-9a30-0869-f10d85e4b3cc
msgctxt "h7986ee52gac89g4c95g8c4bg3000912da6b5"
msgid ""
"I've something for you. A letter from Elminster himself. He was most "
"insistent I give it to you immediately upon your return."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = c3d25516-874a-dbb1-2003-aacc0d6c0f41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:c3d25516-874a-dbb1-2003-aacc0d6c0f41
msgctxt "hc3d225c5gfd29g49b5g9f71g5decafd7fcc7"
msgid ""
"The most famous wizard in the realms delivers you a secret letter, and you "
"intend to read it... <i>some day</i>?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = e5049f19-d9b0-c629-96e4-827264074cc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:e5049f19-d9b0-c629-96e4-827264074cc3
msgctxt "h23f55762g862bg45c0gabc1gd5537e5f5c82"
msgid "There you are, Mr Dekarios. I've been champing at the proverbial bit."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = e6550719-6d14-a906-f616-38a2c25b8bdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:e6550719-6d14-a906-f616-38a2c25b8bdd
msgctxt "hd57b4d15g33e5g4952ga8deg60bcadec8cf8"
msgid "Well, yes, actually."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = e7fe5872-d2d2-1661-3895-ed63710edba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:e7fe5872-d2d2-1661-3895-ed63710edba8
msgctxt "hd6ff8d20g3cd8g4128ga180g04907897d574"
msgid "What kind of companion would I be were I to sneak a peek?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = e859f09a-a96b-5271-5fdc-bf74dbdd2413
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:e859f09a-a96b-5271-5fdc-bf74dbdd2413
msgctxt "h227b60a7g5cc0g4c70g9367g5289ff959fe6"
msgid ""
"However, I will not press you further. Your private correspondence is just "
"that, technically."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = eb494f22-eea4-49b2-f8e8-4875104e81a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:eb494f22-eea4-49b2-f8e8-4875104e81a3
msgctxt "hed3d43c1g1caag4fbdg8ef3g67655508e893"
msgid "Good news. Well. That's good. Yes. Quite."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = ebf42720-faea-541c-340f-c3bffce51513
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:ebf42720-faea-541c-340f-c3bffce51513
msgctxt "h6e680b31g0f55g434cgbcdfg41e43e79b459"
msgid "And I'm a displacer beast."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = ec0c051c-b34f-61b6-3dcd-53b65c90bde2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:ec0c051c-b34f-61b6-3dcd-53b65c90bde2
msgctxt "hc0904d08g58c4g4f3fgb90bg119dcb3c8287"
msgid ""
"I admit I was dreading what might be in that letter. There's been so much "
"dreadful news lately."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Tara the Tressym
#. NodeID = f3527a4a-d935-9ca5-9111-01eb2e1846dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:f3527a4a-d935-9ca5-9111-01eb2e1846dc
msgctxt "heb1148ceg5b67g4ea2gbc1agceeaf989d67f"
msgid ""
"That being said, I'm sure he won't mind you indulging <i>me </i>with its "
"subject matter, once you've broken the seal."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Player
#. NodeID = f79ca371-03de-4e96-de1a-0d451b700b16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:f79ca371-03de-4e96-de1a-0d451b700b16
msgctxt "hb0ebfdc5gd913g4b2cg88beg3a5907fbfb1c"
msgid "It's good news. I think..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra
#. Speaker = Weary Traveller
#. NodeID = f87944fd-2b63-e1a7-9465-c1fa5441160b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_Tressym_CRD_LastNightAlive_FollowedMystra:f87944fd-2b63-e1a7-9465-c1fa5441160b
msgctxt "h8185e0a8g7898g4283g89e7g148e80a52a7a"
msgid ""
"If there is another way, I trust you can find it. It is not in your nature "
"or mine to stop looking, to accept the first answer to any dilemma. Do what "
"you can - put that mind to work. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 001e00c0-f01f-8dde-51c7-b21c6bf2c856
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_State_DrowBetrayalOver = True
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHuntCelebration_HasMet_AstarionAfterBetrayal(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:001e00c0-f01f-8dde-51c7-b21c6bf2c856
msgctxt "h8b71af61gdc86g4430g8c3fgfd017bc3f1e5"
msgid "Don't you love the silence after a massacre? It's just so pure."
msgstr "학살 이후의 침묵이 참 사랑스럽지 않아? 그저 순수하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 022277a9-9b99-bd19-add9-81e7737e54b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:022277a9-9b99-bd19-add9-81e7737e54b3
msgctxt "h5a2db439gb193g406ega794gabf149b95dd9"
msgid ""
"So, given that we are fresh out of alcohol for you, what shall we get up to?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 03e1f87d-f8cc-0053-b2ae-45121758c1c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_ShadowheartPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:03e1f87d-f8cc-0053-b2ae-45121758c1c8
msgctxt "hacfe7c63g27ecg436cga21eg0c4c8304a256"
msgid "So, I see you and Shadowheart have a connection. It looks very sweet."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 05acbe87-a0dd-b4b5-406a-09cfca16bf67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:05acbe87-a0dd-b4b5-406a-09cfca16bf67
msgctxt "h77e9653bg91f8g4fedgb776g1a76bca3afb1"
msgid "You're not jealous, are you?"
msgstr "지금 질투하는 거 아니지, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 06521384-5069-2cbf-eafe-65795c722c4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:06521384-5069-2cbf-eafe-65795c722c4d
msgctxt "h54e4ead6g74d7g4fa4ga5dfg469f30f926a9"
msgid "I'm guessing you have something in mind."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 07646367-3805-63b9-0fe9-b4105687b16a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:07646367-3805-63b9-0fe9-b4105687b16a
msgctxt "ha3387cb2g184dg4a04g8c23g682a91a18674"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 0766085c-0ee3-e808-2793-1ca2ea1f9a0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0766085c-0ee3-e808-2793-1ca2ea1f9a0d
msgctxt "h78cfa5a0g5553g4c36gac50g941114fc9081"
msgid ""
"Really? I thought you had other company planned this evening, and I'd hate "
"to intrude."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 07985b7e-c342-e64d-2c81-0a7b9843134b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:07985b7e-c342-e64d-2c81-0a7b9843134b
msgctxt "h6efc7205gce87g4e82g9875g5208628c6459"
msgid "Never listen to your second thoughts! They always spoil the fun."
msgstr "다시 생각해 보는 건 앞으로 그만두라고! 그건 재미를 망치는 일이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 07ec4ac9-4fd4-febf-15b7-61239cd555ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:07ec4ac9-4fd4-febf-15b7-61239cd555ae
msgctxt "hb719c363g4355g4f4bgbc78g437b5ee7aebb"
msgid "It's nothing serious."
msgstr "진지한 관계는 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 07fa2d87-7b75-85af-b5e4-c9f02b160fec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:07fa2d87-7b75-85af-b5e4-c9f02b160fec
msgctxt "hd9eb6163g4e42g4b81g9914g59d6878f3f7a"
msgid "Does Lae'zel know that? I saw how she looked at you earlier."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 0817c2fe-f0f8-d8b1-d969-e75891cc2c17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0817c2fe-f0f8-d8b1-d969-e75891cc2c17
msgctxt "h09a1954dg083ag49c9g9e1dg7e2dad1afef9"
msgid "So, I see Lae'zel's marked you as her territory."
msgstr "그럼, 보아하니 레이젤이 널 자기 영토로 표시한 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 0876960b-3a05-89b2-9711-0191797633ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0876960b-3a05-89b2-9711-0191797633ae
msgctxt "ha57fee49gfd0ag4992gac4egf9906887f1bf"
msgid "No, I'll spend the night alone."
msgstr "아니, 밤을 혼자 보낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 0a540413-9708-da1e-de61-c3996fde396b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0a540413-9708-da1e-de61-c3996fde396b
msgctxt "hf0fa1251g962dg4b16g8095g2937bf5d52d0"
msgid ""
"Let's wait until things quieten down a bit. Once the others are asleep, "
"we'll find each other."
msgstr "좀 조용해질 때까지 기다리자. 다른 사람들이 잠들면, 우리끼리 만나는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 0abef3ca-89fb-e579-7612-e112eb2a9bb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0abef3ca-89fb-e579-7612-e112eb2a9bb0
msgctxt "h47a5fd1fgd937g4d84gae8dg82adc2715195"
msgid "Not that I'm judging, of course."
msgstr "물론 내가 판단할 건 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 0be944a7-3140-a69d-54e3-dff27d5efe3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DoubleDating(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0be944a7-3140-a69d-54e3-dff27d5efe3a
msgctxt "hfeae1f96ge63bg4a5bga45bgee78d4f59f2c"
msgid "Maybe. If you say 'please.'"
msgstr "'제발'이라고 말하면 생각해볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 0c6d3fe1-53ea-e8df-e27f-d6cf05637059
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0c6d3fe1-53ea-e8df-e27f-d6cf05637059
msgctxt "h838bc0ebg9820g401cga154gc81e58a2103e"
msgid "I wish things had turned out differently."
msgstr "일이 달리 진행됐으면 좋았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 0cbb6444-1431-892f-2af9-62e7a137d10f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:0cbb6444-1431-892f-2af9-62e7a137d10f
msgctxt "h79c5af4ag4301g461fga2e0ged5274343bff"
msgid "I'm afraid I'm all out. This party is more humble than I'd like."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 10db5e17-127f-b54d-d6b8-4589ec452615
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:10db5e17-127f-b54d-d6b8-4589ec452615
msgctxt "heb9cc7acgb391g4eebg9ebagd50f99b731f6"
msgid ""
"If you're here to beg forgiveness, save your breath. My cup and I are "
"perfectly happy together."
msgstr "용서를 구하러 왔다면, 말을 아껴줘. 내 컵과 나는 더없이 행복해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 12a5a0d8-c354-7f8c-0ec8-6f2019f706b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_DrowPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:12a5a0d8-c354-7f8c-0ec8-6f2019f706b4
msgctxt "ha22b9d53ge053g43b3ga809g4c239036ad11"
msgid ""
"Although you're doing well enough on your own. I saw how the drow looked at "
"you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 1401c07a-66f2-ba61-eb47-a8ddc3c22ef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:1401c07a-66f2-ba61-eb47-a8ddc3c22ef0
msgctxt "h96429ca7gf43ag4e85g8772g563f3605013c"
msgid "To surviving!"
msgstr "살아남기 위해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 163b87c4-bdb0-95dd-fb51-7ce8ac989815
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:163b87c4-bdb0-95dd-fb51-7ce8ac989815
msgctxt "h875954bcgc4ccg45b6g857eg7eae4d42c4b7"
msgid ""
"Ha! No, my love, I'm not jealous of the beating our gith friend will give "
"you."
msgstr "하! 자기, 난 우리 기스 친구가 널 두들겨 패줄 걸 질투하는 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 164cab5a-c331-ecac-4efd-1490fc0d041e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:164cab5a-c331-ecac-4efd-1490fc0d041e
msgctxt "hea56db99ga6b7g4fbeg820fgee1e454398f5"
msgid "Say 'please'."
msgstr "'제발' 이라고 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 17fa39d6-490c-0790-8a0a-4a478fa0be9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:17fa39d6-490c-0790-8a0a-4a478fa0be9c
msgctxt "h77dc33b2gdf35g469cg8bc4g5e9eff649d52"
msgid "That's not funny."
msgstr "하나도 재미없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 18fb6868-d742-f259-2ce4-e3d1db6c2b86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:18fb6868-d742-f259-2ce4-e3d1db6c2b86
msgctxt "h95b52433ge41dg4bb3g8184g27449bf1883b"
msgid ""
"As for me, I'm going to drink until I know I won't hear you grunting in the "
"bushes."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 1ba8da84-ef5f-9c81-3264-4f4e5f4fe102
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:1ba8da84-ef5f-9c81-3264-4f4e5f4fe102
msgctxt "hd39e05c4g95ebg46d8ga716g3f6bc3df1dc3"
msgid "You're a conquering hero and you want to drink foaming piss?"
msgstr "정복 영웅이나 돼서, 거품 나는 오줌을 마시고 싶다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 1bdd7cd4-ce08-7bd5-787d-6003653cf563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:1bdd7cd4-ce08-7bd5-787d-6003653cf563
msgctxt "hcebddfbegfb37g435fgae2ag059555db2f56"
msgid "So, what are we drinking to? Other than a pile of corpses."
msgstr "그럼, 뭘 위해 건배할까? 시체 한 더미 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 1c823bd2-1c37-ff7f-5795-a62e6547e1cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:1c823bd2-1c37-ff7f-5795-a62e6547e1cb
msgctxt "h94485213g2b60g4fa6gab2bge23e054d2778"
msgid "No."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 1d804c98-ac3d-cb9d-8cee-c43470b46442
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:1d804c98-ac3d-cb9d-8cee-c43470b46442
msgctxt "hbdc8484fgf4bag475fg8849g051d48cd78a1"
msgid "What do you mean?"
msgstr "무슨 뜻이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 1f3ef1b7-12aa-1d7d-d310-15b4d547c8c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:1f3ef1b7-12aa-1d7d-d310-15b4d547c8c5
msgctxt "h9e679e27g9df4g4690ga520g2e038b42f497"
msgid "Try it. You might have fun."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 2077204a-f9d8-8ca9-7e75-9b0ce86205af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:2077204a-f9d8-8ca9-7e75-9b0ce86205af
msgctxt "hb1c1f94ag0e33g47b5gb58cgac7bdf3c633b"
msgid "Red."
msgstr "레드."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 219e0dbd-0c34-7231-3f8d-14d889c6efdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:219e0dbd-0c34-7231-3f8d-14d889c6efdf
msgctxt "h5cdbe298gf86fg44acga84cg37498882ce65"
msgid ""
"I don't know what her idea of a good time is, but it seems to involve you. "
"I'd hate to intrude."
msgstr "그녀가 생각하는 좋은 시간이 무엇인지는 잘 모르겠지만 거기에 네가 포함된 것 같아. 난 끼어들고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 25232945-7111-bf3a-9ec8-ca0f26dd977a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:25232945-7111-bf3a-9ec8-ca0f26dd977a
msgctxt "ha5280a6cg2b82g400fga0adg5386bf0714fe"
msgid "To fun!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 26b35883-7a04-7a5c-3af4-fc4c15d81304
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:26b35883-7a04-7a5c-3af4-fc4c15d81304
msgctxt "h12a8d0e5gf557g4498g805cg4f573a9160db"
msgid ""
"And I wish I was drinking out of the skulls of everyone who's ever wronged "
"me. Life is tough."
msgstr "나는 내게 못된 짓을 한 모든 사람의 두개골로 술을 마시고 싶어. 인생은 거친 법이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 26b3bd36-db1a-d353-e529-69b7ac265f51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_HasMet_Astarion(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_HasMet_Astarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:26b3bd36-db1a-d353-e529-69b7ac265f51
msgctxt "h246e33c7g2b53g42cdg97e0g2e3951113b48"
msgid "Well hello. Welcome to my humble party."
msgstr "안녕하신가. 내 소박한 파티에 온 걸 환영해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 2876f203-5f3e-1271-a0e7-b0f5f6012cf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:2876f203-5f3e-1271-a0e7-b0f5f6012cf3
msgctxt "h28d8794cg5e0fg44b3gb4b9gefde0846440f"
msgid "We whip each other within an inch of our lives."
msgstr "서로 죽을 지경까지 채찍질 해보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 2c39551c-82be-ec43-f7f2-1d157496424b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:2c39551c-82be-ec43-f7f2-1d157496424b
msgctxt "hb9afa847g82f4g40dfg94begc9d792be4361"
msgid "I'm afraid it's warm, but needs must."
msgstr "따뜻한 것이긴 하지만, 어쩔 수 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 2c73d397-e7a1-dc1c-807e-8c0b9a10703f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:2c73d397-e7a1-dc1c-807e-8c0b9a10703f
msgctxt "h8668c465g5a9cg4d91ga688gb00e55f041d7"
msgid "To victory, of course."
msgstr "당연히 승리를 위해서지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 301e5389-5ceb-f0ff-3ff2-2365a1bdb36f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:301e5389-5ceb-f0ff-3ff2-2365a1bdb36f
msgctxt "h53123b6dg81b8g4eb2g8afdg5bd9fd62168f"
msgid "Although I'm sure you'd know better than I would."
msgstr "뭐 나보다 네가 훨씬 더 잘 알고 있겠지만 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
