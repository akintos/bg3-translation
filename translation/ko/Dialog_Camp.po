msgctxt "h596db675ga3f3g42e5gb224g33aeebd5631f"
msgid "*He relinquishes the ball. It is well-chewed and slick with drool.*"
msgstr "*녀석이 공을 내놓습니다. 잘근잘근 씹혀있고, 침이 흘러내립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
