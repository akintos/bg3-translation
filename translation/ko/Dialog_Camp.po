msgctxt "hc4ff2a8fgc9cdg4918gb260g1a96034cffc3"
msgid ""
"Didn't mean to hold out on you. Just didn't think you'd be interested, is "
"all."
msgstr "숨기려고 한 것이 아닙니다. 다만 관심이 없으실 것 같아서 그랬습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Player
#. NodeID = c6bff7a6-b000-704a-05a7-4461b8618b2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHuntCelebration_State_HasStolenInstrument(0) = True
