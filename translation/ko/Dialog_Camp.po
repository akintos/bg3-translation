msgctxt "h8b765a3agda0bg4fb3g809fg2f4318b62c5c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_OwlbearCub
