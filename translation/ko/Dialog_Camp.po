msgctxt "he2f7a93cg57bbg41c8ga43fg12c36109c9e0"
msgid "I trust him. He won't hurt us."
msgstr "난 그를 믿어. 그가 우릴 해치진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight
#. Speaker = Astarion
#. NodeID = 0821dc63-2d9e-449c-8cc5-063d034a325a
