msgctxt "h8e9520c7ge3abg4ec1g8c19geeab4957e357"
msgid "All I want is a little fun. Is that so much to ask?"
msgstr "난 그냥 약간의 재미를 보고 싶을 뿐이야. 그게 너무 지나친 부탁인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 9f89b2aa-f106-d05e-0a15-154c72012c04
#. HandlePath = TaggedText[0].TagText[0]
