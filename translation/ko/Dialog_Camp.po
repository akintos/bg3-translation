msgctxt "hc03f655eg54f1g4cb5ga63agfc03d3f4813c"
msgid "Back! Bite? No..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub
#. Speaker = Owlbear Cub
#. NodeID = 9d97d5c5-ca17-2380-59d0-1f5dc470559d
