msgctxt "ha530ca10g0625g4445gad57g69acade1c32f"
msgid ""
"*You can smell the sweetness of their skin - hear the beat of their pulse...*"
msgstr "*피부에서 달콤한 냄새가 풍기고, 조용히 맥박 뛰는 소리가 들립니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Narrator
#. NodeID = 2fcd0b90-6d51-d62d-a800-67fd1252a63a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice:2fcd0b90-6d51-d62d-a800-67fd1252a63a
msgctxt "h8ee47c18gc761g408cgb05dge78bddae5ff0"
msgid ""
"*Blood gushes into your mouth. You can feel it filling the maw inside you - "
"filling your soul.*"
msgstr "*피가 입 안 가득 흘러듭니다. 당신 안의 굶주린 아귀가 만족스럽게 채워지는 듯합니다. 영혼이 충만해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_IVB_SCO_Avatar_Choice
#. Speaker = Astarion
#. NodeID = 302ecdd3-1a4b-6371-09e3-c06c3d723158
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
