#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion:34e86f25-87cc-3dd8-d44e-f9272639a1bd
msgctxt "h9e5d506cg5c36g4849g96f4ge804ffffdb58"
msgid "Well hello. What's on your mind?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = 35c6d728-e4a9-d407-4b58-a826247a4f22
#. HandlePath = TaggedText[0].TagText[0]
