msgid "The young cub. He's gone... for good."
msgstr "어린 새끼 말이야. 가버렸어... 영영."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = 5097465f-6575-6b1c-a8ba-d47a028d8ac1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:5097465f-6575-6b1c-a8ba-d47a028d8ac1
msgctxt "h7f99a258g22c4g41a8gb9e9g39049f87ef88"
msgid "What's wrong?"
msgstr "뭐가 잘못됐어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Narrator
#. NodeID = 5388e096-f538-a289-4840-fa711ed9c66a
#. HandlePath = TaggedText[0].TagText[0]
