msgctxt "h370ac812ge16bg41f6g9d4ege900b7006609"
msgid ""
"*The wound is superficial, the edges torn and jagged - probably a gnoll's "
"crude blade.*"
msgstr "*상처는 겉만 벌어져, 끝이 뾰족하게 찢어져있습니다. 놀의 조잡한 칼날로 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Narrator
