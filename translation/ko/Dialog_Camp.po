#. SetFlags:
#.   Dialog:
#.     - CAMP_CourierDog_Knows_AskedAboutCourier(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:d93cfcef-a730-7fd6-80cf-084e27027116
msgctxt "hf7a91201g6c0dg404ag8206gdbd0af3473e5"
msgid "I'm sorry about what happened to your master."
msgstr "네 주인에게 생긴 일은 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = da19ba2f-89b2-d416-8c2b-d1dc49ccb987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:da19ba2f-89b2-d416-8c2b-d1dc49ccb987
msgctxt "hc24a1b82g02d4g499bg996eg2734700ef474"
msgid ""
"No, nothing happened - just the young one having bad dreams. That's what you "
"heard."
msgstr "아니, 문제가 생긴 건 아니야. 이 애가 나쁜 꿈을 꿨을 뿐이야. 그 소리를 들었나 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = dacad78a-55b8-b4b6-8e8f-0070079584e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Posthouse_State_EquerryLeaves = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Courier_Dog_State_TalkedAboutPosthouseKennels = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:dacad78a-55b8-b4b6-8e8f-0070079584e3
msgctxt "h6af9894dgfdbeg4bb8g8a44g2d40c97becb5"
msgid "I just hope Dringo is fine. Mar'hyah has a mean streak."
msgstr "난 그저 드링고가 괜찮았으면 좋겠어. 마르히야는 좀 못된 구석이 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = dc7802ef-08d6-139c-0713-a16d65711e82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:dc7802ef-08d6-139c-0713-a16d65711e82
msgctxt "he8cee65cgdebbg40d8g9e2cg7e44af2aaa5c"
msgid "All right. It's only fair that you enjoy it, too."
msgstr "좋아. 너도 같이 즐겨야 공평한 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = ddd3ea97-8836-de0c-f5a5-b376cb6b8162
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:ddd3ea97-8836-de0c-f5a5-b376cb6b8162
msgctxt "h617603ecgc2c6g46fag9c6cgc1764ecf7ee5"
msgid "All's well that ends well, eh, boy?"
msgstr "끝이 좋으면 다 좋은 거지, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Narrator
#. NodeID = e0c6ec5d-c7b0-83ff-aa09-ebc3b8a25398
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Courier_Dog_State_FoundSomething = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:e0c6ec5d-c7b0-83ff-aa09-ebc3b8a25398
msgctxt "h8859b3b1g0d30g49b5g937fg6173feee56b4"
msgid "*The dog wags his tail, a small bag clenched between his teeth.*"
msgstr "*개는 작은 가방을 입에 문 채로 꼬리를 흔들고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = e9f54df2-010f-50e0-11a7-597d9f22637b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_PlayerPetted_Scratch(1) = False
#.   Tag:
#.      - HUMANOID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_PlayerPetted_Scratch(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:e9f54df2-010f-50e0-11a7-597d9f22637b
msgctxt "h5d87ce3dg9dcag4717gbfc5g5760f55d540e"
msgid "<i>Pet him.</i>"
msgstr "<i>쓰다듬어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Narrator
#. NodeID = edd327da-f060-d668-1239-2f68e3ccdf9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b3ddc5ee-13e2-869c-44e3-54424652e5f4_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:edd327da-f060-d668-1239-2f68e3ccdf9c
msgctxt "h76449394gb6a2g4c15g9734gee5ca726c8ec"
msgid ""
"*His eyes track the ball avidly. He shuffles on his paws, ready to chase "
"after it...*"
msgstr "*녀석은 탐나는 눈길로 공을 쳐다봅니다. 발을 질질 끌며, 공을 쫓아갈 준비를 합니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = ef5205c6-21a9-37f9-283d-eca9dfce1b78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Posthouse_State_PlayerReclaimedDog = True
#.      - CAMP_Courier_Dog_State_TalkedAboutPosthouseKennels = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:ef5205c6-21a9-37f9-283d-eca9dfce1b78
msgctxt "h5d8542f9gc6cdg4701ga39egfd444cac37be"
msgid "*Bark!*"
msgstr "*멍멍!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = f31f4903-d213-9825-87c4-00402cb9770d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - b3ddc5ee-13e2-869c-44e3-54424652e5f4_AnimalHandlingSuccess = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:f31f4903-d213-9825-87c4-00402cb9770d
msgctxt "hf3fabc75gb7d0g4409g936ag60df1481d9b0"
msgid "<i>Extend a palm and wait expectantly.</i>"
msgstr "<i>손바닥을 내밀고 기대하며 기다린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = f55a1d48-6e72-9e3c-6820-4aafa1412ba0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Courier_Dog_State_FoundSomething = True
#.   Object:
#.      - CAMP_OwlbearCub_CFM_Dog_Event_PlayerDidntInvestigate(1) = True
#.      - CAMP_OwlbearCub_CFM_Event_LaterResolution(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_OwlbearCub_CFM_Event_LaterResolution(1) = True
#.     - CAMP_OwlbearCub_CFM_Event_ScratchResolution(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:f55a1d48-6e72-9e3c-6820-4aafa1412ba0
msgctxt "hc687dd3cgfa24g401ega4e0g23b694567515"
msgid "<i>Look him over for any signs of injury from the owlbear cub.</i>"
msgstr "<i>아울베어 새끼에게 입은 상처는 없는지 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = f78086ac-aec3-7f8f-9e91-39674a4e4fdb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - b3ddc5ee-13e2-869c-44e3-54424652e5f4_AnimalHandlingSuccess = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:f78086ac-aec3-7f8f-9e91-39674a4e4fdb
msgctxt "h36e13e18g79e5g425ega0d8g3b65ab06fc8b"
msgid "<i>Reach forward and yank at it.</i>"
msgstr "<i>손을 뻗어 홱 잡아당긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = fa0cea55-d3e1-ea0e-1ea4-1849b5f5f0d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:fa0cea55-d3e1-ea0e-1ea4-1849b5f5f0d1
msgctxt "hb98439a5ga6dag4f31g9fb9g919f42961cc0"
msgid "<i>Let him keep it.</i>"
msgstr "<i>녀석이 가지게 해 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = fad1d266-ce22-de4e-f2e5-c379193b0cf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:fad1d266-ce22-de4e-f2e5-c379193b0cf1
msgctxt "h092e0b30gf50eg4f88g91aagc77d135d68d7"
msgid "What've you got there, Scratch?"
msgstr "뭘 가지고 온 거니, 스크래치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = fd1d417b-b1ea-a410-8e0b-26758585f0d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Courier_Dog_PettedAlready = False
#. SetFlags:
#.   Global:
#.     - CAMP_Courier_Dog_PettedAlready = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:fd1d417b-b1ea-a410-8e0b-26758585f0d0
msgctxt "he08568cagbea4g4958gab1fgf61e7f18c195"
msgid "*Pant.*"
msgstr "*헥헥.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = 259e16f1-eb1b-7d67-c2df-517136866f3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Elfsong_HasMet_DumbWaiter(1) = False
#.   Global:
#.      - GLO_CAMP_State_NightMode = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Elfsong_HasMet_DumbWaiter(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:259e16f1-eb1b-7d67-c2df-517136866f3c
msgctxt "hefd7c401g16bdg4ae8g9cbcgf4fc134f263d"
msgid ""
"Alyn says I have to <i>what</i>? I'm sorry, I didn't know we had godsdamned "
"royals staying with us. Can't this wait 'til morning?"
msgstr "알린이 나더러 <i>뭘</i> 시켰다고? 염병할 왕족이 묵고 계신 줄은 몰랐네. 거 아침에 해결하면 안 되나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = 25b1e90f-4827-2186-75be-59f7cf4eb5ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:25b1e90f-4827-2186-75be-59f7cf4eb5ca
msgctxt "h36224f5bg90dag49f9gae9dg4abb86c9f4a1"
msgid ""
"Uh-huh. 'Cause people order from the kitchen in the dead of night to be "
"<i>polite</i>. Now - what you want?"
msgstr "으흠. 한밤중에 주방에 주문하는 사람들은 <i>공손해야</i> 하거든. 자, 그래서 뭘 원해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Player
#. NodeID = 50a3be8d-ef20-d55d-3023-4ba525c53d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:50a3be8d-ef20-d55d-3023-4ba525c53d7e
msgctxt "hdb51faa3g4866g40cdg9168ge368d07ba62a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = 8d0013e1-a1da-af36-0a22-43f19e2dd737
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:8d0013e1-a1da-af36-0a22-43f19e2dd737
msgctxt "h9a5684a8g5352g4135gb543gc594357a7d4d"
msgid "'Enjoy your night.'"
msgstr "'즐거운 밤 보내.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = 949df074-1125-7fc9-9970-39a852489031
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:949df074-1125-7fc9-9970-39a852489031
msgctxt "h01044370gf29fg444aga74fg839500da637a"
msgid ""
"You're absolutely right. So - tell me what you bloody want, <i>please</i>."
msgstr "지당하신 말씀이구만. 그래서, 무엇을 쳐 잡수시고 싶으신가<i>요</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Player
#. NodeID = a2437e05-093e-c918-3c9e-f55f5c4bc116
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:a2437e05-093e-c918-3c9e-f55f5c4bc116
msgctxt "h5bfb8287gcb8eg4e2cg894bg943ac2a6f41e"
msgid "Let me see what you have."
msgstr "파는 물건들 좀 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = a9cf8196-3197-8513-5587-486bbc622400
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Elfsong_HasMet_DumbWaiter(1) = True
#.   Global:
#.      - GLO_CAMP_State_NightMode = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:a9cf8196-3197-8513-5587-486bbc622400
msgctxt "ha3ab7818gb63cg46f5ga137g3b4087ed3600"
msgid "You lot have stomachs like gaping caverns. What you want?"
msgstr "당신네는 끝도 없이 먹는군. 뭐가 필요해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = a9cf8196-3197-8513-5587-486bbc622400
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Elfsong_HasMet_DumbWaiter(1) = True
#.   Global:
#.      - GLO_CAMP_State_NightMode = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:a9cf8196-3197-8513-5587-486bbc622400
msgctxt "h63f9febdg822fg4891g81a6g654b9f53973c"
msgid "Back again. Thrill me with your delightful midnight order."
msgstr "또 왔군. 신나는 심야 주문 시간이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = a9cf8196-3197-8513-5587-486bbc622400
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Elfsong_HasMet_DumbWaiter(1) = True
#.   Global:
#.      - GLO_CAMP_State_NightMode = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:a9cf8196-3197-8513-5587-486bbc622400
msgctxt "hd013f71eg21cag4672gb399geb9c271451f6"
msgid "Gods, I don't get paid enough. <i>What?</i>"
msgstr "세상에, 이 돈 받고 일하라니. <i>뭔데?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = a9cf8196-3197-8513-5587-486bbc622400
#. HandlePath = TaggedText[0].TagText[3]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Elfsong_HasMet_DumbWaiter(1) = True
#.   Global:
#.      - GLO_CAMP_State_NightMode = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:a9cf8196-3197-8513-5587-486bbc622400
msgctxt "h6da703d3gcf67g457fg9b16ga018f8e7b175"
msgid "I just damn near chopped my finger off. This had better be good."
msgstr "방금 손가락 잘릴 뻔했단 말이야. 괜히 불렀기만 해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = a9cf8196-3197-8513-5587-486bbc622400
#. HandlePath = TaggedText[0].TagText[4]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Elfsong_HasMet_DumbWaiter(1) = True
#.   Global:
#.      - GLO_CAMP_State_NightMode = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:a9cf8196-3197-8513-5587-486bbc622400
msgctxt "h692d4394ga1f9g483cg9b0fg73b52a800696"
msgid "I have about four carts of potatoes to prep. <i>Quickly.</i>"
msgstr "지금 준비할 감자가 산더미야. <i>빨리 해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Narrator
#. NodeID = b729dab5-6bc7-937e-980e-3a5c39806e42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_CAMP_State_NightMode = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:b729dab5-6bc7-937e-980e-3a5c39806e42
msgctxt "hb85620bdgbfb2g44d1g90eag58acad4a4803"
msgid ""
"*You call out, but there is no answer. The staff operate the dumbwaiter at "
"night.*"
msgstr "*소리쳐 불러 보지만, 대답이 없습니다. 화물용 승강기는 밤에만 작동합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Player
#. NodeID = c30a50f6-6c85-faf3-e9a2-5f3e1bfbafcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:c30a50f6-6c85-faf3-e9a2-5f3e1bfbafcf
msgctxt "h7b497b70g7f56g4988gbb3fg9461063a633d"
msgid "I'm sorry, I didn't mean to bother you."
msgstr "미안, 귀찮게 하려던 건 아니었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Player
#. NodeID = c378bd68-e7f7-d026-e056-d2a2aec199a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:c378bd68-e7f7-d026-e056-d2a2aec199a6
msgctxt "h76469919g19abg4e35g8c2bg99f29e3f8ebc"
msgid "Don't be rude - I'm a paying customer."
msgstr "태도를 좀 고쳐, 난 돈을 내는 손님이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = cb5a95a5-96da-8be0-87df-11fb420f685c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:cb5a95a5-96da-8be0-87df-11fb420f685c
msgctxt "h028410ccg08f8g4d66ga710g1822c74e7351"
msgid "Urgh - fine. Right, you. Food. Supplies. What you want?"
msgstr "으으, 그래. 알겠어. 음식. 자원. 뭐가 필요해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter
#. Speaker = Unseen Culinary Specialist
#. NodeID = e602ce23-e1b4-8cee-3120-3a29701dc5bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Act3_Dumbwaiter_State_AlreadyBuySuppliesToday = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Elfsong_Dumbwaiter:e602ce23-e1b4-8cee-3120-3a29701dc5bf
msgctxt "h6f3978d2ge15fg414fg8ad8gcb5614ea22a0"
msgid "You're here <i>again</i>? You've cleaned me out. Come back later!"
msgstr "<i>또</i> 왔나? 지금은 해줄 수 있는 게 없어. 나중에 다시 오라고!"

