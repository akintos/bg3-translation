msgctxt "h3df87f71g929dg4087gaa80g659d4fd39567"
msgid "*Your heart skips a beat. What treasures might this night bestow?*"
msgstr "*심장이 뜁니다. 이 밤에 어떤 소중한 순간이 있을까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
