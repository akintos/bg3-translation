#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:733a1893-3b73-d28b-fd3d-2c2f3d76e073
msgctxt "hf05ccac4g7503g49f6g954egb6516e94a94f"
msgid "<i>Explore Lae'zel's mind.</i>"
msgstr "<i>레이젤의 머릿속을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 7adcc01f-cc8d-e911-66e3-37a7e0316a5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:7adcc01f-cc8d-e911-66e3-37a7e0316a5f
msgctxt "he78339f7gc541g4283gb41eg7f9384c4b14a"
msgid "<i>Surrender to Lae'zel. You will not become an abomination.</i>"
msgstr "<i>레이젤에게 맡긴다. 흉물이 될 수는 없다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = 82e193ee-ad1d-fe65-2948-770742aafb2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:82e193ee-ad1d-fe65-2948-770742aafb2c
msgctxt "he136102agd19bg417dga62cgd9b26ecba9c4"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = 870618d5-fa5f-12c3-a50e-0a58cc4da8e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:870618d5-fa5f-12c3-a50e-0a58cc4da8e6
msgctxt "h892d7480g11e2g41e0ga1ceg07f54c329468"
msgid "This is no simple fever. This is ceremorphosis."
msgstr "이건 단순히 열이 나는 게 아니야. 뇌변이가 일어나는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = 9b5f750b-2872-aa2e-5d72-80c116291f8d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - CAMP_Daisy1LaezelBeforeDream_Event_FailedPersuasion = False
#. SetFlags:
#.   Local:
#.     - 7d72b4c3-1a05-876a-708d-bc0ef1f84110_AttemptedCheck = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:9b5f750b-2872-aa2e-5d72-80c116291f8d
msgctxt "h18ab35adg4145g49afg9225g7a138c8c6965"
msgid "It's just a fever. Rest will break it."
msgstr "그냥 열일 뿐이야. 쉬면 괜찮아질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = a022c63e-4efe-e43a-7ea4-75022b7ed6c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7d72b4c3-1a05-876a-708d-bc0ef1f84110_AttemptedCheck = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:a022c63e-4efe-e43a-7ea4-75022b7ed6c1
msgctxt "hc550156fg08eag45bbga73ag89dff31ebb4f"
msgid "Bah - I cannot trust my own mind. So it seems I must trust yours."
msgstr "쳇, 내 지성조차 믿을 수 없어. 그러니 너의 지성을 믿어볼 수밖에 없겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = a2df2178-224a-617b-2c43-caf2f5500f85
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Daisy1LaezelBeforeDream_Event_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:a2df2178-224a-617b-2c43-caf2f5500f85
msgctxt "ha81e314ag69d1g40a4gab20gef474959a4b0"
msgid "The monster in you craves birth. I trust no one but me to deny it."
msgstr "네 몸 속의 괴물이 깨어나길 갈망한다. 그걸 막을 사람은 나 말곤 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = a4ffeada-d9eb-aef4-429c-0de390ddbc09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:a4ffeada-d9eb-aef4-429c-0de390ddbc09
msgctxt "ha77d23aeg3c9ag485fg9ed2g1d6c0bafc2b1"
msgid "...I will end us all."
msgstr "...내가 우리 모두를 끝내겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = ac666e1e-b219-4c30-e42f-2cd918e09545
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_PartySize_AtLeast3 = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:ac666e1e-b219-4c30-e42f-2cd918e09545
msgctxt "h1751a56dgedb9g448fg9f68gdaddebba1973"
msgid "I will be quick with my blade. First you. Then the others. Then myself."
msgstr "내 칼로 신속하게 끝내주지. 우선 너부터다. 그 후에 다른 녀석들. 마지막은 내 차례겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = adcaefe7-c3b0-82df-4eeb-373d9794f5de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:adcaefe7-c3b0-82df-4eeb-373d9794f5de
msgctxt "h22d2c7e5ga297g4d57g8a1dg7a16cce8ac04"
msgid "<i>Press your fingers to your mouth.</i>"
msgstr "<i>손가락을 입에 갖다댄다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = ae068a3a-b65a-c6ec-3498-fb60b59b7370
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:ae068a3a-b65a-c6ec-3498-fb60b59b7370
msgctxt "h8bdfb7aag0685g44f6g81d6gf3b668131ca8"
msgid "First you. Then myself."
msgstr "널 먼저 죽이고, 다음은 내 차례가 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = b002bfe2-9840-c750-db69-84265d154ffe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:b002bfe2-9840-c750-db69-84265d154ffe
msgctxt "hd8f917abg3104g452bga097gdb5bfb5cbdb9"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = baf6279f-0681-d40b-f8d9-6d18569ceab4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:baf6279f-0681-d40b-f8d9-6d18569ceab4
msgctxt "h3da9f667gd18cg4ba7g9ffag361c7a6b930f"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = be689ccf-99f3-d92f-e4d4-94ad8f11c923
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Daisy1LaezelBeforeDream_Event_PassedTadpole = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:be689ccf-99f3-d92f-e4d4-94ad8f11c923
msgctxt "h4a1ae7acg2a40g45dcga420gf7b8b2098bda"
msgid ""
"*Lae'zel's fear grips you. Not fear of death, but fear of insignificance.*"
msgstr "*레이젤의 두려움이 당신을 붙잡습니다. 죽음에 대한 두려움이 아니라, 하찮음에 대한 두려움입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = c8749fb2-ffea-6178-e1e6-2589dfda6c9e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Daisy1LaezelBeforeDream_Event_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:c8749fb2-ffea-6178-e1e6-2589dfda6c9e
msgctxt "he9861ff0g72f6g41f3g859dgc24992aafe81"
msgid ""
"It feels as if a snake is slithering through every limb. My throat burns "
"like flames erupted within."
msgstr "마치 뱀이 사지 전체를 기어다니는 느낌이다. 내 목구멍은 불길이 치솟는 것처럼 타오른다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = c9ca1c73-75fb-5b3b-f37f-7200b24b0a19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:c9ca1c73-75fb-5b3b-f37f-7200b24b0a19
msgctxt "h04ce47f6g67d5g43a8g94eag07590630a466"
msgid "<i>Attack Lae'zel.</i>"
msgstr "<i>레이젤을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = ce3b2378-3507-20c6-638d-29298202b677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:ce3b2378-3507-20c6-638d-29298202b677
msgctxt "h8043bd75gbd12g4084g9da6g61302f7ea565"
msgid ""
"*Your hands shake as they reach upward. Your forehead remains drenched, no "
"matter how much you wipe.*"
msgstr "*당신의 손은 위로 올라갈수록 떨립니다. 아무리 닦아도 이마는 흠뻑 젖어 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Lae'zel
#. NodeID = d1447785-331f-02d1-cece-40ed0dad6210
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:d1447785-331f-02d1-cece-40ed0dad6210
msgctxt "h09ad5300g2c40g4fe3g8a2dg6bb734ed390c"
msgid "I can. I see it in you. I feel it in me. We are <i>lost.</i>"
msgstr "내게는 보인다. 네 안에 있는 그것이 보여. 내 속에 있는 그것도 느껴진다. 우리에겐 이제 <i>가망이 없다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = d161a6ab-24d3-e9ba-4b25-5ce2abda7460
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:d161a6ab-24d3-e9ba-4b25-5ce2abda7460
msgctxt "hf61c6c4bga9abg46d3gaaf7gf39476faf988"
msgid "<i>Slit her throat.</i>"
msgstr "<i>그녀의 숨통을 끊는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = dcc01e7e-6d3d-ec41-05a6-33260f259676
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:dcc01e7e-6d3d-ec41-05a6-33260f259676
msgctxt "h2d113724g1f8fg4c24gb0c2g4bab7c7bc7d0"
msgid "<i>Explore Lae'zel's mind.</i>"
msgstr "<i>레이젤의 머릿속을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Player
#. NodeID = df62335c-9bd5-cfe3-6b5b-00ebaba243e5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - CAMP_Daisy1LaezelBeforeDream_Event_FailedPersuasion = False
#. SetFlags:
#.   Local:
#.     - 7d72b4c3-1a05-876a-708d-bc0ef1f84110_AttemptedCheck = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:df62335c-9bd5-cfe3-6b5b-00ebaba243e5
msgctxt "hd7d481f2gb922g4676g91c5g94c3e4a401d0"
msgid "We're just exhausted. Lower the blade before you do something foolish."
msgstr "우린 그저 지친 것뿐이야. 어리석은 짓 말고 칼 내려놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = e2bef630-1358-7cc7-d063-a17fa9abd4b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:e2bef630-1358-7cc7-d063-a17fa9abd4b7
msgctxt "ha7194754g4276g4b82gab5agcce502e3d5c0"
msgid "*Lae'zel's mind holds you at length. Her thoughts remain unknown.*"
msgstr "*레이젤의 정신이 당신을 붙잡습니다. 그녀의 생각을 알아낼 수 없게 됐습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream
#. Speaker = Narrator
#. NodeID = e4141a92-ae50-a44b-79d4-635b8740b4eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Daisy1_CRD_Laezel_BeforeDream:e4141a92-ae50-a44b-79d4-635b8740b4eb
msgctxt "h901ba98bg910dg40e6gbdddg1d816ad0330b"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 10286028-7a35-4d44-a2fa-e35070ffe813
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:10286028-7a35-4d44-a2fa-e35070ffe813
msgctxt "h79a9653fgee85g4cacgbb2dg6be188761ca1"
msgid ""
"I'm sure you'd manage. But this ol' girl's got a few things to do before it "
"comes to that."
msgstr "난 네가 해낼 거라고 믿어. 하지만 이쪽은 그렇게 되기 전에 몇 가지 해야 할 일이 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 11b43d85-fe4a-6bc2-3326-f3fd2eb9fda9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:11b43d85-fe4a-6bc2-3326-f3fd2eb9fda9
msgctxt "ha6640809g37e8g49dag804eg08172cf03af1"
msgid ""
"Thing's been running in overdrive since I left Avernus; I'll burn clean "
"through anyone who gets too close."
msgstr "아베르누스를 떠난 후로 엔진이 과부하로 돌아가고 있어. 가까이 오는 누구든 깨끗이 태워버릴 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 178eca5b-948b-471f-be65-09b0902d2807
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:178eca5b-948b-471f-be65-09b0902d2807
msgctxt "hc60e6f8fg6f15g4248g833fgaecce71d07e7"
msgid "Ngh - hey soldier, I... well, I'm not feeling so good."
msgstr "으 - 거기 신참, 나... 상태가 안 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 1991d8fa-5167-4f0a-ad47-7069cacad9cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachUpgraded = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:1991d8fa-5167-4f0a-ad47-7069cacad9cf
msgctxt "he32b2905gecf4g4fffg9e48g3796743683ee"
msgid ""
"We need to catch up with Dammon. See if he's thought of a way to fix this "
"thing. If it <i>can </i>be fixed."
msgstr "우린 대먼을 만나러 가야 해. 이걸 어떻게 고치려 하는지 알아봐야지. 고칠 수 <i>있긴</i> 한 지 모르겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Player
#. NodeID = 19eb7c75-0144-b6d6-6c58-7bd5b6e57131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:19eb7c75-0144-b6d6-6c58-7bd5b6e57131
msgctxt "h90cb87e6g1266g4a4dg8d2eg050c4e762126"
msgid "You said it was a gift from Zariel - how?"
msgstr "그게 자리엘의 선물이라고 했잖아. 어떻게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 1afc03dc-bcdb-4e93-9fd5-850843585799
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:1afc03dc-bcdb-4e93-9fd5-850843585799
#, fuzzy
msgctxt "he699f41ag4726g4f1fg8786gd33f7a4657b7"
msgid ""
"Well... I imagine it's lights out, Big K. And then it'll just be you, your "
"parasite, and the wild yonder."
msgstr "글쎄... 덩치 큰 칼라크의 불이 꺼지는 걸 상상해 보자고. 그러면 너와, 너의 기생충, 저 너머의 야생만이 있을 뿐이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 280c1361-2865-423a-a520-588e02ef0e4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:280c1361-2865-423a-a520-588e02ef0e4e
msgctxt "h594dc0eeg64ceg4a06gbfb0g060e83b0e5ce"
msgid "Never. I mean - not if I can help it."
msgstr "천만에. 내 말은, 내가 불가항력인 경우가 아니라면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 29982c6b-6939-4298-882f-107ccf9714f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:29982c6b-6939-4298-882f-107ccf9714f7
msgctxt "h39afcedag32e5g4672gb8e0g6f35955de97c"
msgid "I need to find a mechanic. A good one, or this thing's going boom."
msgstr "기계공을 찾아야 해. 실력 좋은 기계공을. 아니면 큰일날거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 35ceabdb-b5ba-4ba0-9499-fcf20b265b10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:35ceabdb-b5ba-4ba0-9499-fcf20b265b10
msgctxt "h9b901a73g0a9eg4156gb3c5g871b6d8beb5f"
msgid ""
"Tell that to the inferno where my heart was, soldier. Actually, don't. I "
"don't want to piss it off."
msgstr "신참, 내 심장이 있던 지옥에게 그렇게 말해봐. 실은 아냐, 난 그것을 화나게 하고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Player
#. NodeID = 36999a9b-6497-adfa-8b28-13063d650193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:36999a9b-6497-adfa-8b28-13063d650193
msgctxt "h4a9cf48fg0748g49c1g87eeg5a3cf8937e4e"
msgid "How can we calm your engine down?"
msgstr "우리가 어떻게 하면 네 엔진을 진정시킬 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Player
#. NodeID = 38efbb03-074a-4dfb-a37c-cd114b4b0289
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:38efbb03-074a-4dfb-a37c-cd114b4b0289
msgctxt "h1598f6feg6332g4675gb629g849a136940c9"
msgid "Don't worry; we'll find him."
msgstr "걱정 마. 우린 그를 찾을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Player
#. NodeID = 3aba0a75-c99f-4bdf-a7c2-93bb4cd8a6c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:3aba0a75-c99f-4bdf-a7c2-93bb4cd8a6c6
msgctxt "h49437d9dgbf96g49beg906bg91608e4739a5"
msgid "Do you think you're a danger to the rest of us?"
msgstr "네가 나머지 우리에게 위협이 된다고 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 52e53ce0-a3df-42bf-ad75-196e1619c10c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:52e53ce0-a3df-42bf-ad75-196e1619c10c
msgctxt "h855f337dg6590g47f9g958egeeef01703819"
msgid "We need to catch up with that mechanic. And pray he's extremely good."
msgstr "우린 그 기계공을 따라잡아야 해. 그리고 그가 아주 잘 해내길 기도해야 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 6e8e629f-b098-4a21-b87e-40f29876465c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitment_State_DammonUnavailable = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:6e8e629f-b098-4a21-b87e-40f29876465c
msgctxt "hdfebaf76g91fbg451eg85b2g411b5339febc"
msgid ""
"Without a mechanic, you might need to get used to a slowly overheating "
"tiefling at your flank."
msgstr "기계공이 없으면, 후방에서 천천히 달아오르는 티플링에 익숙해져야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 8aed63ab-b6a3-4a29-90ed-5d1a74977fa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:8aed63ab-b6a3-4a29-90ed-5d1a74977fa8
msgctxt "h41ba458fg6f75g46a4gafa3g7f9a6bd4d99f"
msgid ""
"You leave your left flank wide open. If I'm ever not around to cover it, you "
"may find yourself on the wrong side of a goblin spear one of these days."
msgstr ""
"너는 왼쪽 측면을 활짝 열어두는 경향이 있어. 내가 그걸 커버해주지 못한다면, 언젠가는 고블린의 창이 잘못된 곳에 박혀있는 걸 발견하게 "
"될지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 93a122e7-dc61-407e-bae0-3377bf718957
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:93a122e7-dc61-407e-bae0-3377bf718957
msgctxt "h9468c0a6gddc0g4176g8f18gc9ebb2a21c0a"
msgid "I'm sure we will. But... in case we don't, a bit of advice."
msgstr "그럴 거라 생각해. 그렇지만... 혹시 그러지 못할 경우에 대비해 조언을 조금 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 95b20dfa-d23b-392a-1861-184701139e0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:95b20dfa-d23b-392a-1861-184701139e0c
msgctxt "hc49ff648g0e9bg47dbgbd3fgc007ff7252f7"
msgid ""
"Burn <i>very </i>hot. Great in hellish battle, less so now that I've escaped."
msgstr "<i>엄청</i> 뜨겁게 타올라. 지옥의 전투에선 유용하지만, 도망친 이후로 지금은 딱히 쓸모가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 9f03a3f1-c12f-359e-ba49-b750114cfae0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:9f03a3f1-c12f-359e-ba49-b750114cfae0
msgctxt "h353b9c20ge0b3g47b1g924bg658cfa0bac91"
msgid ""
"The short version: Clever sadism. The longer version: I worked for a guy who "
"sold me into Zariel's service. She put the engine in my chest, and now it's "
"burning me up."
msgstr ""
"간단히 말하자면, 똑똑한 가학성애자야. 자세히 말하자면, 난 나를 자리엘의 노예로 팔아넘긴 놈을 위해 일했어. 그 년이 내 가슴에 엔진을 "
"박아 넣었고, 이젠 완전히 타버리기 직전이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = ac49733b-bbf0-488c-bd21-9f7b79bda63e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:ac49733b-bbf0-488c-bd21-9f7b79bda63e
msgctxt "hb596cf9fgc65fg4732g8b13g062de639d629"
msgid ""
"Listen, in case something happens to me... I've been wanting to tell you "
"something."
msgstr "들어봐, 만약 내게 무슨 일이 생기면... 너에게 전하고 싶은 말이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = c24b56b7-3bf1-fe44-301e-dbbc93423f50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_Knows_InfernalEngineExists = False
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:c24b56b7-3bf1-fe44-301e-dbbc93423f50
#, fuzzy
msgctxt "h16171259g6622g470ag8ed3g2b40509e42d6"
msgid ""
"Reckon it's time we talked about all this fire, huh? I've got an infernal "
"engine for a heart. Little gift from Zariel."
msgstr ""
"우리가 전에 이 불에 대해 얘기했었잖아? 지금이 자세히 말할 적기인 것 같아. 난 심장 대신 지옥 엔진을 갖고 있어. 자리엘의 작은 "
"선물이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Player
#. NodeID = d82ff311-630c-dcb8-42e7-c7b14587760f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:d82ff311-630c-dcb8-42e7-c7b14587760f
msgctxt "h2a0eb8c9gee8ag49a7ga787g3546ede6eea9"
msgid "What does the engine allow you to do?"
msgstr "엔진으로 뭘 할 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Player
#. NodeID = ed38cf0d-fb19-4630-896c-8e556d1d7220
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:ed38cf0d-fb19-4630-896c-8e556d1d7220
msgctxt "h708d4c1dg12dcg4ff0gb1bcg4eda498e3c1b"
msgid "You're tough - that thing in your chest won't overpower you."
msgstr "넌 강인해 - 네 가슴 속에 있는 그것이 널 이겨내진 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Player
#. NodeID = f933e508-6941-40f8-bbcf-4bc3966dda3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:f933e508-6941-40f8-bbcf-4bc3966dda3a
msgctxt "h4b4aab25gea58g45c3g865ag02ef46b97da0"
msgid "What'll happen if he can't tune you up in time?"
msgstr "만약 제때 고치지 못한다면 어떻게 돼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach
#. Speaker = Karlach
#. NodeID = fa384f0a-b704-4710-a69e-7f80c1365b47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_EngineProblems_CRD_Karlach:fa384f0a-b704-4710-a69e-7f80c1365b47
msgctxt "hef50c96bgdd62g4c0egbfc3ga6e9cbae23f7"
msgid ""
"My engine... it's getting worse. Feels like it's going to burst out of my "
"chest."
msgstr "엔진이... 점점 나빠지고 있어. 가슴에서 터질 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 00dd15c5-af4e-9887-a89d-9a6d92fa437e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:00dd15c5-af4e-9887-a89d-9a6d92fa437e
msgctxt "hc609eebdg8da3g4b73g9269g68d4b6d78a89"
msgid ""
"You put the stars to shame. Let's sit here another while - I want to drink "
"you in."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 01ab0811-b350-ad22-5047-814870460a79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:01ab0811-b350-ad22-5047-814870460a79
msgctxt "h95a84caeg7147g444agb088ga8090aa23984"
msgid ""
"Please - continue to believe in me. I want to show you the wizard I am "
"capable of being, rather than the poor excuse for a man who's kept you "
"company thus far."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 02d020b0-9f13-a58a-479a-423680dc5107
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:02d020b0-9f13-a58a-479a-423680dc5107
msgctxt "hba8a1a92g1592g4d0cg982fg1381be432530"
msgid ""
"You're welcome - but don't put yourself down. You deserve me, and a lot more "
"besides."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 02e84e0e-3844-4fe9-03fc-f1e81cef1cb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_RejectedBeMyGodProposal = True
#.   Object:
#.     - ORI_Gale_Event_PushAwayFromCrown(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:02e84e0e-3844-4fe9-03fc-f1e81cef1cb6
msgctxt "ha1f3a336gacb3g4111gae8bg97019101be51"
msgid "<i>Stop his protests with a kiss.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 06c9fb3d-3601-c6e9-75a8-802ce6521a78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:06c9fb3d-3601-c6e9-75a8-802ce6521a78
msgctxt "h1ef53cadg52dfg414fgbf97g1e9828fa0580"
msgid ""
"No doubt it will be - abominably so. As is just about everything we do. But "
"I know we're up to the task. Are you still with me?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 087e5d56-980b-1a7d-34b5-292b333dd3ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:087e5d56-980b-1a7d-34b5-292b333dd3ae
msgctxt "h0495852cgff9bg4860g828bg802498f48c4c"
msgid ""
"I wouldn't blame you for giving me a wide berth. I thought the orb's ever-"
"present censure had tamed my wilder ambition, but that wasn't the case."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 0addd64b-5c7c-c05a-b891-d0b4decd4366
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_RejectedBeMyGodProposal = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:0addd64b-5c7c-c05a-b891-d0b4decd4366
msgctxt "h383df32fg4cdag4ae2g9e28gee495c49d362"
msgid ""
"You see me as I am, and do not find me wanting. With these stars as my "
"witness, I swear - you will always be enough for me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 1266ac47-68fb-fbe7-0f44-958cf7df6617
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:1266ac47-68fb-fbe7-0f44-958cf7df6617
msgctxt "h5e5ff74cgdd20g4ee6gb9bfg56bfc43fa1a5"
msgid ""
"The Karsite Weave could offer more than just power - it could bestow "
"divinity. If I only trust myself to wield it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 130ba6d7-aa86-1f63-3710-72dc97691785
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:130ba6d7-aa86-1f63-3710-72dc97691785
msgctxt "h2ac4f330g07a9g4259ga324g7d83f719ec88"
msgid ""
"I'll stand by you. But some further explanation of what you intend wouldn't "
"go amiss."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 135f7bfc-64d4-317a-50f4-cee932e80aa2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Gale_State_AcceptedBeMyGodProposal(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:135f7bfc-64d4-317a-50f4-cee932e80aa2
msgctxt "h83a85e6egd937g4d1fgac9fg717ccf291c82"
msgid "Yes. I want you to seize the crown, and make us a new world."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 1437de60-2882-5964-26d9-a7a754505912
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:1437de60-2882-5964-26d9-a7a754505912
msgctxt "he3b5198bgcdbfg4c26gabccg96d8fbbd9e5d"
msgid ""
"I love you. But for the man that you are. Not the god you'd pretend to be."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 16dd34f5-120b-72be-7210-12a90e75eca6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:16dd34f5-120b-72be-7210-12a90e75eca6
msgctxt "hbb5acfa9gd010g41f2g8c5fg975633fa75c3"
msgid ""
"You put the stars to shame. Let's sit here another while - I want to drink "
"you in."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 18ef803c-5f6a-7790-b30f-117c74c7d14c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:18ef803c-5f6a-7790-b30f-117c74c7d14c
msgctxt "h9c64bd5bgacbeg4050gb058gd45f5c276266"
msgid ""
"I hope you're right. I truly do. Godly power, perhaps I can live without, "
"but you? You're everything."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 1fb24a27-e86b-6929-38c1-999f7418c07a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:1fb24a27-e86b-6929-38c1-999f7418c07a
msgctxt "h74f5e6dcg7243g4751gbb9bgce2b2c552fc9"
msgid ""
"They would keep all of this from us - the power, the possibilities. They "
"only want us to serve them, pray to them... and ultimately, die for them."
msgstr ""
"신들은 이 모든 것을 우리에게 숨기려 하지. 이 모든 힘과 가능성들을. 신들은 우리가 그저 자신들을 섬기고, 기도하고, ... 마지막엔 "
"목숨까지 바치길 원할 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 207538fc-589d-459a-a3a8-5c53fd52fa94
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushAwayFromCrown(1) = True
#.     - ORI_Gale_State_GaveKarsusBookOpinion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:207538fc-589d-459a-a3a8-5c53fd52fa94
msgctxt "h478799adg05fbg4ecdga951g0262b95ace92"
msgid "So much power will only prove dangerous. You should forget it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 20f47427-010a-1556-9fa8-ffd614415788
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SORCERER or WIZARD
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:20f47427-010a-1556-9fa8-ffd614415788
msgctxt "h4facc61ag98fdg4c43g87d5gd824256aa61f"
msgid ""
"Mystra herself was once mortal. The power would corrupt you, as you believe "
"it corrupted her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 20f47427-010a-1556-9fa8-ffd614415788
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:20f47427-010a-1556-9fa8-ffd614415788
msgctxt "h615597a2g0caag415dg96c7gfcf9c53cd24f"
msgid ""
"Mystra herself was once mortal. The power would corrupt you, as you believe "
"it corrupted her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 20f47427-010a-1556-9fa8-ffd614415788
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: CLERIC
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:20f47427-010a-1556-9fa8-ffd614415788
msgctxt "hcc4b8a29g76b9g4e21ga51cg0b67bf4f0b9b"
msgid ""
"The gods you think so little of were once mortal themselves. The power would "
"corrupt you, as you believe it corrupted them."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 20f47427-010a-1556-9fa8-ffd614415788
#. HandlePath = TaggedText[3].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:20f47427-010a-1556-9fa8-ffd614415788
msgctxt "h30da3a51gd38dg4240gb611gbfffa3645c43"
msgid ""
"This is wrong, Gale. That power will corrupt you, even if you can seize it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 23de2911-6e4f-d988-8818-45d1426b1164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:23de2911-6e4f-d988-8818-45d1426b1164
msgctxt "ha813f2bfg09deg4c0agad90g1adb42e94170"
msgid "Just what am I agreeing to?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 23fe070f-967a-1a65-f228-c93b6551b966
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:23fe070f-967a-1a65-f228-c93b6551b966
msgctxt "h1cdf3e42g363bg43a8g9ca1gaa304577c22a"
msgid ""
"Then it will be so. With you and I together, there's not a force in "
"existence that can stop us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 25bafedd-9c9a-0b9c-c502-12d956b7be94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:25bafedd-9c9a-0b9c-c502-12d956b7be94
msgctxt "he3ea37d2gf4bfg4a01g91e8gd33e0d83d8fc"
msgid ""
"Remain steadfast - there is nothing to fear from what awaits me. In fact... "
"allow me to show you. Words alone are not enough."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 2767e425-e13c-9f07-5e2a-843a54f426d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_RejectedBeMyGodProposal = True
#.   Object:
#.     - ORI_Gale_Event_PushAwayFromCrown(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:2767e425-e13c-9f07-5e2a-843a54f426d1
msgctxt "ha102125ag025bg4efdgb0c3g91bdd8d9a75d"
msgid "<i>Stop his protests with a kiss.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 288a15f1-4936-4e42-015d-b277ae73db64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:288a15f1-4936-4e42-015d-b277ae73db64
msgctxt "h9e3fb487gb4ccg4a8fgbd1fg0496ae7a88b4"
msgid "You're more to me than magic, Gale."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 28bd0442-ff41-f4e9-dd79-0601fb306e52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = False
#.      - ORI_Gale_State_WillingForCrown = False
#.   Object:
#.      - ORI_Gale_State_GaveKarsusBookOpinion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:28bd0442-ff41-f4e9-dd79-0601fb306e52
msgctxt "h222eb594g8622g4960ga4cdgbb11402176f5"
msgid ""
"I owe you an apology. Things became quite heated between us before, after I "
"learned of the Crown of Karsus. I allowed myself to get carried away, and "
"failed to properly explain myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 2ab7d8ef-56e1-3c8b-d968-7337f25cd9b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Gale_State_ChosenThree_ChooseMe(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:2ab7d8ef-56e1-3c8b-d968-7337f25cd9b5
msgctxt "hccac2bc7g0921g4a22g857ag5681712d3b44"
msgid ""
"You told me once to choose you, the one who loved me. That's what this is "
"all about. Do you doubt me?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 2b2cf953-a077-b52f-1dff-b2afd7d4bb50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:2b2cf953-a077-b52f-1dff-b2afd7d4bb50
msgctxt "h5cc869fcg8a9ag4154g9808g3f088c51cc2a"
msgid ""
"I used to believe Mystra's forgiveness was worth dying for. But I was wrong. "
"You showed me just how much I have to live for. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 31a653b7-29fd-94c3-e145-861ce435c858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:31a653b7-29fd-94c3-e145-861ce435c858
msgctxt "h52ea9367g7189g49dag95a5g8aa0dfec781c"
msgid ""
"The power to change the world - it may be within our reach. You must have an "
"opinion, surely."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 32b21716-590d-00d4-0122-a88362f4aea8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:32b21716-590d-00d4-0122-a88362f4aea8
msgctxt "h52ec757cga0feg414agb0cfg9365995e7301"
msgid "That's all I ever need to hear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 3548666d-a646-238f-2c54-a7b443f1540f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:3548666d-a646-238f-2c54-a7b443f1540f
msgctxt "hba89b507gef19g46b1g8afdg0fa58a63ca7f"
msgid "<i>Close your eyes.</i>"
msgstr "<i>눈을 감는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 37654c61-6f2a-3674-7b1b-fc8ce54def07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_EagerForCrown = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:37654c61-6f2a-3674-7b1b-fc8ce54def07
msgctxt "h08f4ba6dg5d8fg465eg8160g3aab3c9a640b"
msgid "You know how I feel. I've already voiced my support."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 386e3e09-bc0e-7c56-14b4-32becb51d25c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushTowardsCrown(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:386e3e09-bc0e-7c56-14b4-32becb51d25c
msgctxt "h16826d50g0bd1g4ce7g831fgb7f7c3c008d0"
msgid ""
"You know I would if I could. But I'll sit with you as long as you'll have me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 39b6c215-ec3f-f60e-aef2-9d7e1d8e7265
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:39b6c215-ec3f-f60e-aef2-9d7e1d8e7265
msgctxt "h5e849abcg2398g4ccag9486gfb18edfcff86"
msgid "Tell me you feel the same way. Tell me you want what I want. Please."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 3a38a7fc-0a44-7f38-eaac-d20529cdf7f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:3a38a7fc-0a44-7f38-eaac-d20529cdf7f8
msgctxt "h6ae7fad6ge578g4b5dga4a4g7027e2881081"
msgid ""
"If we can seize it, and use it... the possibilities are endless. Yet you "
"haven't uttered a peep one way or the other about it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 3d7d9626-cdb9-49b6-50a7-6eb3d73061ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:3d7d9626-cdb9-49b6-50a7-6eb3d73061ac
msgctxt "h83062d06gb3cag4e21g8f7fgabc902b890c0"
msgid "Perhaps now is the time to explain then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 3fbf9dd2-113a-889f-fd71-89b52b2f3127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:3fbf9dd2-113a-889f-fd71-89b52b2f3127
msgctxt "hf97bc358g91cag4c05g89deg9109eaa3b77e"
msgid "A little boat voyage, that's all. Indulge me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 409e9ef8-52d0-3594-564f-d56413b6621e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_RejectedBeMyGodProposal = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:409e9ef8-52d0-3594-564f-d56413b6621e
msgctxt "hb351f7d4g9d1eg4b31g93f3g379c62765067"
msgid ""
"You see me as I am, and do not find me wanting. With these stars as my "
"witness, I swear - you will always be enough for me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 40a1e4ad-d26e-742e-b088-d1ccc7e9652c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:40a1e4ad-d26e-742e-b088-d1ccc7e9652c
msgctxt "h7d74c3ecg7cfdg4f97ga35bgc2548e757547"
msgid ""
"Few mortals ever glimpse what you're about to see. But don't be alarmed - "
"I'm here with you. Now... open your eyes."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 41a53ede-6e9d-c3cd-c257-21b4b4e6e5aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:41a53ede-6e9d-c3cd-c257-21b4b4e6e5aa
msgctxt "hc97a428eg330ag46d7g8fc7g36f4dcae0936"
msgid ""
"It was easier to stare at the celestial abyss than recognise the emptiness "
"within myself. Easier to pretend my destiny lay among such stars, than work "
"to salvage a life on solid ground. You changed all that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 43ba2148-402d-0a4a-f905-c6aeb4955b75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:43ba2148-402d-0a4a-f905-c6aeb4955b75
msgctxt "h1410d128g36b4g4a23g9b4dg67ef39156b7d"
msgid ""
"But I cannot. You would  not be able to either, if you knew what I knew. "
"Please, allow me to show you. Just close your eyes a moment."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 45c50e9e-ac9f-45a6-35d0-144a8a2290d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:45c50e9e-ac9f-45a6-35d0-144a8a2290d8
msgctxt "h20d841edg5009g4e06ga60cg2c3d24d17242"
msgid ""
"You're willing to give up the chance of unlimited power. I'd say your "
"ambition is under control."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 47e68c70-67b9-c184-093e-4f7ca74c19a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:47e68c70-67b9-c184-093e-4f7ca74c19a1
msgctxt "he639b047gecfag4620gb1a1gc786b9714c44"
msgid "I don't need the stars, Gale. I have you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 4a47676e-14f6-21c2-7dd7-1f797cc71355
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = True
#.      - LOW_StormshoreTabernacle_State_GaleSeeksForgiveness = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:4a47676e-14f6-21c2-7dd7-1f797cc71355
msgctxt "h17a4a67cgb880g490cg83d2g2f13d412cbb7"
msgid "Ah. You're still talking to me then?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 4bdf822c-e059-e8e5-5228-b795a2c7b0e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushTowardsCrown(1) = True
#.     - ORI_Gale_State_GaveKarsusBookOpinion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:4bdf822c-e059-e8e5-5228-b795a2c7b0e9
msgctxt "hdbcec3ecgfa36g4361gbf67g4c25d6142a32"
msgid "I'm here to support you, no matter what you want."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 4e4d871b-09c6-3906-3c38-99f132f0d0fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_PushTowardsCrown(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:4e4d871b-09c6-3906-3c38-99f132f0d0fe
msgctxt "h6443ff80g5ae2g4fd9g97ecg9c49d4c5b404"
msgid "<i>Kiss him.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 5385c051-7ce0-6718-446e-56f89cb07b49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:5385c051-7ce0-6718-446e-56f89cb07b49
msgctxt "he23f69b4g63e8g475fgb138g732cdf699025"
msgid ""
"The tadpoles, the orb - these threats to our existence - the gods could aid "
"us if they wished, but instead they cower behind Ao. So let us act ourselves."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 5419f2a1-1aaa-b626-5e61-30877f4902d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:5419f2a1-1aaa-b626-5e61-30877f4902d8
msgctxt "h7eb23992g0c9bg43b2gbc6cg3dc6886e4ab7"
msgid ""
"Let's not grow complacent - that path you speak of is sure to be a dangerous "
"one."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 54510a49-1ad6-ec21-732d-62a34097448f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:54510a49-1ad6-ec21-732d-62a34097448f
msgctxt "h2fea1793g3043g4756g9dc0g1001e6a8eb2e"
msgid "Enjoy the rest of your evening."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 5bf87028-1cef-d8fc-9ab4-28bf50d42e2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:5bf87028-1cef-d8fc-9ab4-28bf50d42e2a
msgctxt "h110dd8aag707eg4edbga8b2g5c0edce1022a"
msgid ""
"Apologies are useless if you're still intent on doing something dangerous."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 5e8cd3a2-5979-3bce-442b-80810983312e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:5e8cd3a2-5979-3bce-442b-80810983312e
msgctxt "haf33bb0dg0b1fg40aag8be1gfeb0d63c3cda"
msgid "It won't, I swear to you. It's merely a tool - a means to an end."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 62fee4f0-5b08-672c-e555-3199d7f14aa1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = False
#.      - ORI_Gale_State_SwayedTowardsCrown = True
#.   Object:
#.      - ORI_Gale_State_GaveKarsusBookOpinion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:62fee4f0-5b08-672c-e555-3199d7f14aa1
msgctxt "h66c349bbg0d5fg4719g94bbgc4ae85707d77"
msgid ""
"I don't think I deserve you at times. I told you of my ambitions - the likes "
"of which many would baulk at - and yet you remain at my side."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 639d5084-c714-de80-83e3-3936d1ef01a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:639d5084-c714-de80-83e3-3936d1ef01a8
msgctxt "h20958bddg0e12g42c2gb3c9g6e928c4bea01"
msgid ""
"That means there'll be no permanent place in the heavens for us. But we "
"could still visit.  "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 64034b6a-76d9-ed77-16cb-ebc72130c3f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_StormshoreTabernacle_State_GaleChallengesMystra = True
#.      - ORI_Gale_Knows_KarsiteWeave = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:64034b6a-76d9-ed77-16cb-ebc72130c3f9
msgctxt "h91bc0301g87a2g455cg96b7gc842622a983a"
msgid ""
"There you are. I was worried you might have second thoughts after my little "
"confrontation with Mystra."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 6415f360-73e6-7c6d-b2bf-a7d535f132a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Gale_State_AcceptedBeMyGodProposal(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:6415f360-73e6-7c6d-b2bf-a7d535f132a2
msgctxt "hdf560a11g6fa0g41aag9322ga584c6dc4200"
msgid ""
"Right now, I need nothing more than a kiss. Then we'll face what is to come, "
"together. And claim the crown when the time comes."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 6712c9ec-6308-0934-6c91-fd97ac871572
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:6712c9ec-6308-0934-6c91-fd97ac871572
msgctxt "h823e0e4ag0211g4741gb013g4b90bc7a4897"
msgid ""
"I needed Mystra's intervention. She offered me a path to redemption at last, "
"and it might yet leave my mind and body intact."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 672c0009-5910-8f87-fb7d-d058c14d0416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:672c0009-5910-8f87-fb7d-d058c14d0416
msgctxt "h2bfb860dgf71dg43abgb282g91e5c67ca0b1"
msgid ""
"I'm starting to regret our relationship. What am I even getting myself into?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 6f84cbc6-e8e9-66f8-4e78-58d12795b727
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:6f84cbc6-e8e9-66f8-4e78-58d12795b727
msgctxt "h7260c57eg5eeag451egb68ag2dbd4ec253aa"
msgid ""
"I suppose if you see it that way... there's little else to be said, is "
"there. Enjoy your evening."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 708416c3-6216-6a81-c6c3-db69f927a14b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:708416c3-6216-6a81-c6c3-db69f927a14b
msgctxt "h3933f1c4gb5a4g4188g8675g8f370759aa3b"
msgid ""
"Words alone are not enough. Permit me to show you. Please, close your eyes a "
"moment."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 7144b3bd-174a-5194-7c55-d1ef5f576332
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_MystraOM = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:7144b3bd-174a-5194-7c55-d1ef5f576332
msgctxt "h603688bdg2ff5g465egbf1fg7cd05bc9d461"
msgid ""
"Ah, you've a moment for me? I was hoping to speak to you - I confess, my "
"thoughts have been somewhat scattered since my audience with Mystra."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 740b3ecb-5829-2db0-a7bf-dbaefe7445cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:740b3ecb-5829-2db0-a7bf-dbaefe7445cb
msgctxt "h0024c22dge857g448bgb18fg479a121a7402"
msgid "Please, close your eyes a moment."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 78805575-0f92-0a3c-fde1-f12facbe1a34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:78805575-0f92-0a3c-fde1-f12facbe1a34
#, fuzzy
msgctxt "h30eef4acg77f7g4510g9bc1gbbb493ae0206"
msgid ""
"Few mortals ever glimpse what you're about to see. But don't be alarmed - "
"I'm here with you. Now... open your eyes."
msgstr ""
"이제부터 보게 될 광경은 극히 일부의 필멸자만이 평생 한 번 볼까 말까 한 것이지. 걱정하진 마. 내가 옆에 있으니까. 자... 눈을 "
"떠봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 7a41bed8-6093-b1dd-9983-c59216b0b134
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = False
#.      - ORI_Gale_State_WillingForCrown = True
#.      - ORI_Gale_State_SwayedTowardsCrown = False
#.   Object:
#.      - ORI_Gale_State_GaveKarsusBookOpinion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:7a41bed8-6093-b1dd-9983-c59216b0b134
msgctxt "haa95db3agcdeag40c8gb502g468ef2207a4c"
msgid ""
"I must admit, the Crown of Karsus has occupied my every thought since I "
"learned of it. If I can seize it, and use it... the possibilities for both "
"of us are <i>infinite</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 8106a1c3-fa7d-e7aa-a959-429dccb75bbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:8106a1c3-fa7d-e7aa-a959-429dccb75bbb
msgctxt "h4e0ff061gaefag443agbb53g8885d0598cfb"
msgid "I'll always have you, Karlach."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 814269ad-49ec-dbc3-3eea-3ae0d2a7c29b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:814269ad-49ec-dbc3-3eea-3ae0d2a7c29b
msgctxt "h319698cdg56a8g4a8dg867cg2b2f1da24c67"
msgid ""
"But think what I offer. The vastness of eternity to explore, the Weave at "
"our fingertips... You would really prefer me as I am?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 86d072a0-db1f-4bd0-4fd7-1539a2f3bde0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:86d072a0-db1f-4bd0-4fd7-1539a2f3bde0
msgctxt "h6fbea582gd3bag44aaga6f3gd5fc5432af59"
msgid "If you believe this can be done, then I will believe too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 88124e5c-2679-2eff-0dd9-e938b6fa5cfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:88124e5c-2679-2eff-0dd9-e938b6fa5cfd
msgctxt "hc449d2a7g4aaeg4796ga31bgf1a52e512230"
msgid "This sounds dangerous."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 89c1e130-a63d-f4c6-dcdd-e2fafa57dffc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:89c1e130-a63d-f4c6-dcdd-e2fafa57dffc
msgctxt "hf3c5cf98ge2efg496bg80cag735b4ecc3413"
msgid ""
"I don't doubt your motivations, but do this, and you will match Karsus' "
"folly with your own."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 8c2f2716-a8c0-18ab-9c3d-e2cd436bebd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:8c2f2716-a8c0-18ab-9c3d-e2cd436bebd6
msgctxt "h17e84a46g0663g422ag8c26g5a7d74bda8b0"
msgid ""
"I've already defied Mystra. Had I followed her command, there'd be nothing "
"left of me but a smoking crater."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 8c4633ae-b44f-7a22-41a8-79893c188c72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:8c4633ae-b44f-7a22-41a8-79893c188c72
msgctxt "h31a79466g15f1g4d5bg9262g06a2a4aa434d"
msgid ""
"When are we not doing something dangerous? Give me a chance - I think I can "
"help you understand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 8cfabc4e-68bf-6bcb-bff3-c5d0846e43af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:8cfabc4e-68bf-6bcb-bff3-c5d0846e43af
msgctxt "h09b68772g300ag416cgbe0egafe2bbdf33fc"
msgid "I believe in you Gale. Always have, always will."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 8e1852e3-8848-f192-e4f4-673233bc4a30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_RejectedBeMyGodProposal = True
#.   Object:
#.     - ORI_Gale_Event_PushAwayFromCrown(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:8e1852e3-8848-f192-e4f4-673233bc4a30
msgctxt "h6f1f5902g66f1g4eaegb01cgfcc3a42b4034"
msgid "You're already everything I need you to be. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 92c2a888-fd2f-ee82-e3b6-4b49bee5763a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Gale_State_AcceptedBeMyGodProposal(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:92c2a888-fd2f-ee82-e3b6-4b49bee5763a
msgctxt "h4e025e22g2c5cg4456g962bg42c51f2ee0a6"
msgid "<i>Answer him with a kiss.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = 97a85ad0-60ee-771f-f8ee-4527627dd6f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:97a85ad0-60ee-771f-f8ee-4527627dd6f1
msgctxt "h3826eb22g405bg4f03gaf0dg10753efe8005"
msgid "Apology accepted."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 9852d689-9f7f-99a1-5672-ecd0b191bb70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:9852d689-9f7f-99a1-5672-ecd0b191bb70
msgctxt "h163748d0g3685g4373g9975g3e013fac1108"
msgid ""
"It gladdens me to hear you say that. Perhaps I can show my gratitude another "
"way - by demonstrating exactly what ascension will mean to me. To <i>us.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 9aa2e899-6e52-df05-e0c9-6b9b2d631f55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:9aa2e899-6e52-df05-e0c9-6b9b2d631f55
msgctxt "h9113ca4fg7f33g4289g9c72gcf8a3d6f2b92"
msgid ""
"I can't. Your opinion matters greatly to me. Give me a chance - I think I "
"can help you understand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = 9c5a0ba8-76eb-e37e-e98a-cf684234c320
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:9c5a0ba8-76eb-e37e-e98a-cf684234c320
msgctxt "h7165e2aegad74g49c1g9fb5g2373d73ecbf3"
msgid ""
"I know what I must do. The Crown belongs under Mystra's stewardship, not "
"mine, and I will ensure she gets it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = a120d10c-338b-9c02-8098-54778e5887d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a120d10c-338b-9c02-8098-54778e5887d2
msgctxt "h9c0f7a64g5c27g4e64g922cg4bdef553f588"
msgid "You plan to dethrone the gods themselves - it's lunacy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = a1ef54f7-9314-70e5-1553-6ad3e09bcb31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a1ef54f7-9314-70e5-1553-6ad3e09bcb31
msgctxt "ha521ffaag80edg461ag8302g4c9eee5be46c"
msgid ""
"How could I not crave this? But I don't want it for myself, alone - I want "
"you at my side, willing and wholehearted."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = a2b6bc16-7802-690f-c589-82fdf3021c1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_MentionedGodhood = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a2b6bc16-7802-690f-c589-82fdf3021c1a
msgctxt "h461fd58dg19b1g4dd5g80f8g539d86e6818e"
msgid ""
"But what if we didn't need them? What if we wielded their power instead, and "
"helped ourselves in all the ways they refuse to. I could make that happen. I "
"could make this illusion a reality, with you by my side."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = a4812a58-bd9f-18ec-66b1-29b31365e53e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_Gale_State_AcceptedBeMyGodProposal(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a4812a58-bd9f-18ec-66b1-29b31365e53e
msgctxt "hfd35ad87g4ce7g4729g9993g55bdf49a1542"
msgid "Yes. I want you to seize the crown, and make us a new world."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = a5bb0ac8-ebc8-db1e-0c4d-6125f66ab933
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a5bb0ac8-ebc8-db1e-0c4d-6125f66ab933
msgctxt "h2c421ec2g2a04g4b3cg864cgb2e800f302ea"
msgid ""
"No doubt it will be - abominably so. As is just about everything we do. But "
"I know we're up to the task. What do you say...?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = a720392c-5dbe-40e2-59db-52662f807b2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = False
#.   Object:
#.      - ORI_Gale_State_GaveKarsusBookOpinion(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a720392c-5dbe-40e2-59db-52662f807b2c
msgctxt "hf95603e6g3b08g4a1cg9687gbd33b91ad73a"
msgid ""
"I must admit, the Crown of Karsus has occupied my every thought since we "
"learned of it. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = a7a91974-efad-0117-fab7-8abf4135d8e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a7a91974-efad-0117-fab7-8abf4135d8e8
msgctxt "h03b8e91dged56g4fb9gbe48g6601eab7eb55"
msgid "You stole the words from my mouth."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = a7e6cab9-7312-f697-ec9c-42416ffbb6dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a7e6cab9-7312-f697-ec9c-42416ffbb6dc
msgctxt "h3612cb7cg4d1fg4c08g9087g142c2baaa70e"
msgid "I feel the same. Whatever you need of me, consider it done."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = a96c08bc-5ebb-e7db-3b61-f33f48da89cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:a96c08bc-5ebb-e7db-3b61-f33f48da89cc
msgctxt "h198bbd0eg14a6g4a4bg85b1g0cf4ce334a6b"
msgid ""
"With the power of the crown, any foe would be rendered impotent. Any "
"obstacle would be dwarfed by our might."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = aa780c23-93d4-80c6-42d2-54c9f9734a43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:aa780c23-93d4-80c6-42d2-54c9f9734a43
msgctxt "h08338c8fg272fg4addg98ddge9d1350becaa"
msgid ""
"I don't know what to say. How can I respond to something so... immense? It's "
"beyond comprehension."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = ac0ac4bb-0d2a-c281-dc89-d253dcd0f521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ac0ac4bb-0d2a-c281-dc89-d253dcd0f521
msgctxt "h36f09f82gb31eg4bd6g8794g5f5dcfee62e9"
msgid "<i>Close your eyes.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = ad43482a-584a-17c8-23c6-6420d01a4363
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_RejectedBeMyGodProposal = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ad43482a-584a-17c8-23c6-6420d01a4363
msgctxt "ha71bba17gc823g48b8gadf4gbb6b38245a49"
msgid "But I could be so much more to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = ad4b7747-df97-afbc-103a-2973c9b5150d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ad4b7747-df97-afbc-103a-2973c9b5150d
msgctxt "h6a1116f5gd243g4502g9813gb8a44bcfe1fa"
msgid "Enough. If you won't see sense, just take me back."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = aebf8edc-1742-934c-7a5b-c789be70ccc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:aebf8edc-1742-934c-7a5b-c789be70ccc0
msgctxt "h0ae8d3dcg8967g4446gb18fg85747a508dec"
msgid "No, Gale. Whatever you have to show me - I don't need it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = b292864b-8d09-8897-efba-19a3d2adf1cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:b292864b-8d09-8897-efba-19a3d2adf1cd
msgctxt "hacee5c32g572dg421eg8013g2afde00445f9"
msgid "Say yes. But if words fail you, I'll accept a kiss."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = b36308d7-14e2-272f-8e97-ff616488125c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:b36308d7-14e2-272f-8e97-ff616488125c
msgctxt "hbb2f7a03g5137g4109gb866gf44a2fdfb73c"
msgid "What more is there to be said?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = b3e50581-92c1-f0ca-9aed-23dc9f04f1df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:b3e50581-92c1-f0ca-9aed-23dc9f04f1df
msgctxt "haed60889g15d6g449fgad00ga08739d04f35"
msgid ""
"I'm sorry. It's not easy living for more than just yourself, when for so "
"long just staying alive was accomplishment enough."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = b7a52f8b-d4dd-e8bf-efc4-00a16f93237a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:b7a52f8b-d4dd-e8bf-efc4-00a16f93237a
msgctxt "hf77b82b0gd8dfg4784gb526gbcd5b7e803c0"
msgid "I don't know what to say."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = b7dead1f-9268-2905-063d-be51b90013df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:b7dead1f-9268-2905-063d-be51b90013df
msgctxt "h2dbcbd39g5017g4631ga256gce0b71a2a662"
msgid "No, Gale. I've indulged you enough."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = b91363c9-138f-93ad-3d43-463387caa17f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:b91363c9-138f-93ad-3d43-463387caa17f
msgctxt "hf96ce95eg063fg4727gb890g3d7040eef05f"
msgid "You'd defy Mystra? As if we need more enemies."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = bc492c70-2d0a-23b3-7654-13e490719f06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_SwayedTowardsCrown = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:bc492c70-2d0a-23b3-7654-13e490719f06
msgctxt "hc5b3bea6gcf4dg4d6fga2c0g5f90ed2b0b59"
msgid ""
"I know this may not be the course you would choose for me, but before you "
"protest - you should at least know what it is you would be advising against."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = c0babc1b-01d0-9f1e-364d-d29c850ba7fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:c0babc1b-01d0-9f1e-364d-d29c850ba7fe
msgctxt "h2f25b71egeac2g4b41gb62dg07d126fccf3c"
msgid "With you, I forget my goddess. I love you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = c2943b9f-dc06-31d2-8daf-c8e657dec6ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_RejectedBeMyGodProposal = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:c2943b9f-dc06-31d2-8daf-c8e657dec6ae
msgctxt "h047bbbe1g2328g4fb5g890fg955926248058"
msgid ""
"As you wish. Take a moment to soak the view. I doubt you will be privy to it "
"again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = c4158ea0-43c1-965c-6294-7a73eff21ad2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:c4158ea0-43c1-965c-6294-7a73eff21ad2
msgctxt "h0338c4eaga549g47d3g9f35gc184ec165305"
msgid ""
"A pity I did not learn all she had to offer, but the fact that she summoned "
"me to her presence is proof enough that the Crown of Karsus is worth "
"pursuing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = c5ff2b7b-654f-8ddd-7a11-af59f22ff880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:c5ff2b7b-654f-8ddd-7a11-af59f22ff880
msgctxt "h13fd29f6g5d61g4434gb6beg24188eba75c9"
msgid "Then have me - but have the best possible version of me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = c7431234-35fc-e855-9ccf-5a1259a93504
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:c7431234-35fc-e855-9ccf-5a1259a93504
msgctxt "hdaedcf6agb7beg446aga8a2gb2ca33e5f398"
msgid ""
"Then the fault lies with me, and my inadequate words. Please, allow me to "
"show you instead. Just close your eyes a moment."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = c82cbfc0-66cc-27fc-b102-23b93a36a2e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:c82cbfc0-66cc-27fc-b102-23b93a36a2e0
msgctxt "hd3ebf83cg8f11g470bg9fb8ga502b42dbcbb"
msgid ""
"Quite the view, isn't it? The Outer Planes are a place of profound, "
"sometimes overwhelming possibility."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = ca6d17cf-31d4-5b4f-0eaf-bb954366cd82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ca6d17cf-31d4-5b4f-0eaf-bb954366cd82
msgctxt "h7b37b307gc3b0g45c6g9093g8f35b60149e7"
msgid "Nothing. Take me back."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Gale
#. NodeID = ccdef940-f3c3-e731-b041-52937c9b6f0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ccdef940-f3c3-e731-b041-52937c9b6f0b
msgctxt "h82b78f4ag1278g4395ga8fagab7a860b52a7"
msgid "Yes, you have. But I want more than your support. I want your heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = cd710858-1705-f3be-52cd-9dfa304ba1b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:cd710858-1705-f3be-52cd-9dfa304ba1b9
msgctxt "h0bd1311cg824bg4039g9f51gbe83d8869d49"
msgid "I can't, Gale. This is best forgotten. I love you as you are."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = ce3c67ac-51f0-0354-14b6-d0b7be363670
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
