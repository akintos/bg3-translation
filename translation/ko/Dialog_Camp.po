#.      - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_A = True
#. SetFlags:
#.   Local:
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:09baaf70-8da9-fde1-d9b6-6632c6ed9940
msgctxt "hf65b6e5bg7e0fg4ab4ga194gff9c12146782"
msgid "I want to see her. So much."
msgstr "그녀가 너무나 보고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = 14027ff0-a6f4-508d-c57d-a10a48ca2606
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:14027ff0-a6f4-508d-c57d-a10a48ca2606
msgctxt "hc5f6e247g2e95g4e7cgabcdg5d12131c9aa0"
msgid ""
"I think she's probably pickpocketed half of the Fugue Plane and is having a "
"blast. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = 156cf989-c66f-b265-28dc-d49b6d64178f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:156cf989-c66f-b265-28dc-d49b6d64178f
msgctxt "h0f4af530gf2adg4c69g904agfcae7f83e0f6"
msgid "I don't know. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = 1c97cdfd-9dad-7a01-7e3a-645b9303fd37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:1c97cdfd-9dad-7a01-7e3a-645b9303fd37
msgctxt "h84d2d995g413ag4eb0gae8ag52a3ab6f065a"
msgid "He'll never catch her."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = 3eb948fb-9eac-76f2-a83f-5374d6f7f185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:3eb948fb-9eac-76f2-a83f-5374d6f7f185
msgctxt "hec2bf1e7g5a03g4ee3gb24cga9ef74016925"
msgid "But Arabella saw justice. Because of you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = 56c5b660-7c91-9dce-97bb-40d7347e63b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:56c5b660-7c91-9dce-97bb-40d7347e63b8
msgctxt "h518dc9e2g6b35g4c2fga7e9ga1d37085719b"
msgid "And I don't feel bad. You must think I'm a monster. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = 6d34af3f-292f-4488-651b-b6ca96f53cec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:6d34af3f-292f-4488-651b-b6ca96f53cec
msgctxt "h7de73459gaa5fg4caag9c16g41cb8985b3eb"
msgid "Fine. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = 70c7ad63-7c19-428f-255c-42c7cc599154
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = False
#. SetFlags:
#.   Local:
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:70c7ad63-7c19-428f-255c-42c7cc599154
msgctxt "ha84437e9g2abbg40fbgaa5cg5fbff006ba61"
msgid "It doesn't feel right - going to Baldur's Gate without our little girl."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = 757f6855-0854-8c42-c3b0-869c2c39d4e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#.   Local:
#.      - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_A = True
#. SetFlags:
#.   Local:
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:757f6855-0854-8c42-c3b0-869c2c39d4e6
msgctxt "heba72234gb6a4g4e21gad92geefb3979ea79"
msgid "I thought killing that snake would make it hurt less.   "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = 7d2b5a3d-8ec1-9373-0dbe-245a5456d73c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = False
#.   Local:
#.      - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_B = True
#. SetFlags:
#.   Local:
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_B = False
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_A = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:7d2b5a3d-8ec1-9373-0dbe-245a5456d73c
msgctxt "hb706a95dgb095g4c75g9c97gf11517e7d5ff"
msgid "You think Arabella is scared - wherever she is? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = 8fab40dd-e975-676c-e92a-4dd48dcc0243
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:8fab40dd-e975-676c-e92a-4dd48dcc0243
msgctxt "h2ab543b9g237fg4999gadcbg29ca53ad1565"
msgid "I just miss Arabella more. Why? Why did she have to die?"
msgstr "그저 아라벨라가 더 그리워. 어째서? 어째서 그녀가 죽어야만 했던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = a213eeb0-f951-0323-a742-b60e01505cd4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#.   Local:
#.      - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_B = True
#. SetFlags:
#.   Local:
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_B = False
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_A = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:a213eeb0-f951-0323-a742-b60e01505cd4
msgctxt "h431698e5gb9dag4fbbg8fa0g82b9ccf1a058"
msgid "How're you holding up?"
msgstr "기분이 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = a50b6a2b-e9cb-108f-f131-0119e9267433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:a50b6a2b-e9cb-108f-f131-0119e9267433
msgctxt "h2a16bef5ge7feg4848g97eeg7154b11010db"
msgid "We will. One day."
msgstr "그럴 거야. 언젠가는."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = b6592fbe-e720-5af0-72c4-299cf410e6e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:b6592fbe-e720-5af0-72c4-299cf410e6e1
msgctxt "h356aed24g7330g40d3g9cfbga350c878c64b"
msgid "I'm not fine. Not one bit."
msgstr "괜찮지 않아. 전혀."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = bdac90bb-14fe-a083-6a21-bd092e30941c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:bdac90bb-14fe-a083-6a21-bd092e30941c
msgctxt "h88973272ga3d0g49afg8284g8df3a21d1964"
msgid "I wonder if she knew something was going to happen to her?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = c7bf1164-ad0e-474c-6a97-e511d61ea88f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#. SetFlags:
#.   Local:
#.     - 24c5b7bb-3613-3be7-21c8-7b720fb606c2_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:c7bf1164-ad0e-474c-6a97-e511d61ea88f
msgctxt "h8c3fe366gd04eg4b4dg9a4cg3ee5f626976a"
msgid "I killed someone, Locke. I stabbed them to death. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = d3b9facb-4b50-6d60-7af7-ca28b59d8e6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:d3b9facb-4b50-6d60-7af7-ca28b59d8e6f
msgctxt "hf2e75d18g544eg4654ga393gc784d87c0616"
msgid "I hope not. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = db097a46-b580-2743-817d-d63ae71c9965
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:db097a46-b580-2743-817d-d63ae71c9965
msgctxt "h574a04e8g1ee0g4c3egb750g5e374063fcb1"
msgid "Yes, she hated being in the grove."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = ddfd91e6-18ef-ee29-9ec1-f865ecd6e577
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:ddfd91e6-18ef-ee29-9ec1-f865ecd6e577
msgctxt "hbfd0fdb1g6eebg41e6gb803g52db60880ef2"
msgid "She was so looking forward to the city."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = ec6b4eea-00d1-2f49-8a39-ae91415c8706
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:ec6b4eea-00d1-2f49-8a39-ae91415c8706
msgctxt "h5b7e9571g244ag4defg8c90gda88acdbcd48"
msgid "Marri. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Komira
#. NodeID = f624f172-6261-9233-3c58-e5f00f8565ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:f624f172-6261-9233-3c58-e5f00f8565ac
msgctxt "hd3b549eag2ef3g4bf3g9a3agf0f510eba915"
msgid "Hah. I bet Kelemvor is fit to strangle her. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = fa2bf9fe-a8db-8a85-8c89-a87531926b8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:fa2bf9fe-a8db-8a85-8c89-a87531926b8f
msgctxt "hd700fe16g3d6eg4931gb8f4g6bdd92c7c21e"
msgid "No. I'm <i>proud </i>of you. I know Arabella would be too."
msgstr "아니. 난 당신이 <i>자랑스러워</i>. 분명 아라벨라도 그럴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = fc1368d5-a41f-a752-a441-da1a1982787e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone:fc1368d5-a41f-a752-a441-da1a1982787e
msgctxt "hd06374f2g27b4g4114g9dffgf1e16bd535a8"
msgid ""
"You two fought noon and night, but there's no one she looked up to more. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 119d0be5-8268-2f85-e95f-60a47f785ea0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:119d0be5-8268-2f85-e95f-60a47f785ea0
msgctxt "he28798b6ga86eg4eb5gaef9g85d67fc36041"
msgid "You will be once I'm done with you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = 1f28bb48-57c8-32af-cc2d-9ade957e6914
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:1f28bb48-57c8-32af-cc2d-9ade957e6914
msgctxt "h2f5b813cgd3c4g4340gb0a3gd3c934afaf79"
msgid "Then you should have kept her in line. You've only yourselves to blame."
msgstr "네 딸 관리는 너희가 잘했어야지. 너희가 탓할 사람은 너희 자신밖에 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Locke
#. NodeID = 2b0b5469-c06d-20c1-3868-8565f7f74c66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:2b0b5469-c06d-20c1-3868-8565f7f74c66
msgctxt "hf27537cfg1f9cg45d2g90a2g898bdfeb94ce"
msgid "You <i>murdered</i> our daughter."
msgstr "네가 내 딸을 <i>죽였어</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = 3be738ac-c136-4da5-95d1-a8eed258acb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:3be738ac-c136-4da5-95d1-a8eed258acb8
msgctxt "he550d5a2g24eeg46b1gb52cg6f682219633e"
msgid "A terrible tragedy. I am so very sorry."
msgstr "끔찍한 비극이군. 정말 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Locke
#. NodeID = 4a9ce1f2-5805-75ab-3179-a3115c1eaa88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_A = True
#. SetFlags:
#.   Local:
#.     - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:4a9ce1f2-5805-75ab-3179-a3115c1eaa88
msgctxt "h6eed6a2bg78c3g472eg8058gaa6968e1ae28"
msgid "She was just a <i>child.</i>"
msgstr "그저 <i>아이</i>였을 뿐이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = 6ee9731a-6d3d-fb78-e60e-0ca161d16d4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Local:
#.     - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:6ee9731a-6d3d-fb78-e60e-0ca161d16d4e
msgctxt "hb762879cg36d7g472ag95f2gf4d248e0eee6"
msgid "I swear to you, I gave Teela no order to strike."
msgstr "맹세할 수 있어, 난 틸라에게 공격하라는 명령을 내리지 않았다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = 895169ba-3d0b-c720-9379-cf60bc8ca1bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_B = True
#. SetFlags:
#.   Local:
#.     - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_A = False
#.     - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_B = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:895169ba-3d0b-c720-9379-cf60bc8ca1bd
msgctxt "h52cc8012gf11ag4a4cg9f00gb575de681dfc"
msgid "Please, just leave me in peace."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = 8fea6c0f-4b7b-fb19-113e-e25b700a9332
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:8fea6c0f-4b7b-fb19-113e-e25b700a9332
msgctxt "hf1d58ecfgc384g4547g8e37gef988ce1d582"
msgid "Or what? You'll kill me? Tell your snakes to rip out my throat?"
msgstr "어쩌라고? 날 죽이기라도 할 거야? 네 뱀한테 내 목덜미를 물어뜯으라 할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = b3fb880d-9d0a-9055-fe6b-42e3901ff2aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:b3fb880d-9d0a-9055-fe6b-42e3901ff2aa
msgctxt "h31f20921g6a65g4fe1gb567gcb8ca0bf0adb"
msgid "You loosed a thug in my grove. What did you expect to happen?"
msgstr "네가 숲에다 양아치를 풀어둔거야. 뭘 기대한 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Locke
#. NodeID = be535f1f-c330-e676-6f32-7ee0d7489a40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:be535f1f-c330-e676-6f32-7ee0d7489a40
msgctxt "h7c3283degdd08g4c0ega789ga266dc160343"
msgid "You're a liar."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = df53bbe6-1181-513c-2b5b-6736e9a2cb19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:df53bbe6-1181-513c-2b5b-6736e9a2cb19
msgctxt "h295fd95eg4c49g48afg99beg664ab166569d"
msgid "Our daughter is dead because of you!"
msgstr "네년 때문에 우리 딸이 죽었어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = e10b27e6-ca1d-f9b5-605a-f164966f3461
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:e10b27e6-ca1d-f9b5-605a-f164966f3461
msgctxt "hb0ed33aag32acg48c9g8a0cg4990b86afcef"
msgid "Hah. You have no idea what's about to happen - do you?"
msgstr "하. 이제 무슨 일이 벌어질 지 감도 안 오지, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Komira
#. NodeID = e70166d1-3e02-1f31-2029-f211f47f6af2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:e70166d1-3e02-1f31-2029-f211f47f6af2
msgctxt "he5f15b0agd229g43f3g8957g87bdb558633c"
msgid "Did you think we'd let you go? Let you walk away?"
msgstr "우리가 그냥 보내줄 줄 알았어? 그냥 떠나보낼 줄 알았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader
#. Speaker = Kagha
#. NodeID = f92fbd8a-16e3-e7d4-5a16-984b6021a9f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_B = True
#. SetFlags:
#.   Local:
#.     - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_A = False
#.     - 98a7f90a-a126-1c96-8fc4-9d7282cb784b_B = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAndDruidLeader:f92fbd8a-16e3-e7d4-5a16-984b6021a9f0
msgctxt "h10f6c07eg198cg4d19g8319gef64d0e02868"
msgid "You're trying my patience. Get out of my sight."
msgstr "내 인내심을 시험하는군. 썩 꺼져라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact
#. Speaker = Komira
#. NodeID = 30e1a4c2-608b-2fe2-f281-a9f1340d515f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact:30e1a4c2-608b-2fe2-f281-a9f1340d515f
msgctxt "h05243807gc440g462fg8564g58148549fa49"
msgid "No. But the snake is dead. That's all that matters. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact
#. Speaker = Locke
#. NodeID = 404c2ddb-b4fe-95ee-8c02-7019f5576d06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact:404c2ddb-b4fe-95ee-8c02-7019f5576d06
msgctxt "h2b116381gb4dfg4d14ga893ge1849132c741"
msgid "You all right? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact
#. Speaker = Locke
#. NodeID = 62ae4fbb-2296-823a-c3f5-5cec632a3bcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact:62ae4fbb-2296-823a-c3f5-5cec632a3bcf
msgctxt "h698705a5gac21g4fd9ga775g6d6e0a2be011"
msgid "That was a hard thing to do. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact
#. Speaker = Komira
#. NodeID = 6beeccb3-2bab-458d-d05c-bfd7605dc36d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsReact:6beeccb3-2bab-458d-d05c-bfd7605dc36d
msgctxt "h729b810bg7406g4af2ga852gc03a04bdfa8b"
msgid "Here's hoping I don't regret it. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Rolan
#. NodeID = 04278c87-3d10-df1e-7421-cb077650470e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:04278c87-3d10-df1e-7421-cb077650470e
msgctxt "h7346b008gf2c0g4b06gbd03g3496c99c586c"
msgid "Toddlers are easier to please than you lot."
msgstr "너희보다 갓난아기를 만족시키는 게 더 쉽겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Lia
#. NodeID = 277fff56-0dd9-a860-56b1-62b22c481c42
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 51e7ebb2-4726-694e-bb81-9bfe9049c326_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:277fff56-0dd9-a860-56b1-62b22c481c42
msgctxt "ha05cf351gc575g43f5ga25dgfdb13f46449f"
msgid "Oh, make a dragon!"
msgstr "오, 드래곤 모양으로 만들어줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Lia
#. NodeID = 4e5d2ae0-8f78-daeb-92cf-19c3af5dcbfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:4e5d2ae0-8f78-daeb-92cf-19c3af5dcbfc
msgctxt "h3bfcb3f2g6f74g49f2ga992gcdae5576010c"
msgid ""
"Rolan can finally have his own sock drawer - folded, colour-coordinated, "
"even <i>ironed.</i>"
msgstr "롤란이 드디어 자기만의 양말 보관함을 가질 수 있겠어, 잘 접고, 색깔별로 나누고, <i>다림질도 하고 말이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Rolan
#. NodeID = 51997877-20d7-4660-ccc4-2baf8874e55d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:51997877-20d7-4660-ccc4-2baf8874e55d
msgctxt "hccbbebf1gf6d7g4e8dg8cbbg071eef838b37"
msgid "Yes. Remember what happened last time?"
msgstr "그래. 지난번엔 어떻게 됐었는지 기억나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Lia
#. NodeID = 88176aca-3bbb-c66f-f9e3-99a57572a111
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 51e7ebb2-4726-694e-bb81-9bfe9049c326_A = True
#. SetFlags:
#.   Local:
#.     - 51e7ebb2-4726-694e-bb81-9bfe9049c326_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:88176aca-3bbb-c66f-f9e3-99a57572a111
msgctxt "hc731d669g3a8eg4684g9007g81e3994e21b8"
msgid "Try not to get too close, Cal."
msgstr "너무 가까워지진 마, 칼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Cal
#. NodeID = 9237ee22-c4db-8f3b-12d9-d7274d7404b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:9237ee22-c4db-8f3b-12d9-d7274d7404b6
msgctxt "ha47e4bb1gcecfg45c9gaef9gbf4b0a5c930b"
msgid ""
"I was eight and you magicked up a kitten. How was I supposed to know it was "
"made of <i>fire?</i>"
msgstr "그때 난 여덟 살이었고 넌 새끼 고양이를 만들었잖아. 그게 <i>불로</i> 만든 건지 내가 어떻게 알았겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Cal
#. NodeID = 956f9f41-f5b3-74ec-ea12-2141636be10f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 51e7ebb2-4726-694e-bb81-9bfe9049c326_B = True
#. SetFlags:
#.   Local:
#.     - 51e7ebb2-4726-694e-bb81-9bfe9049c326_C = False
#.     - 51e7ebb2-4726-694e-bb81-9bfe9049c326_B = False
#.     - 51e7ebb2-4726-694e-bb81-9bfe9049c326_A = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:956f9f41-f5b3-74ec-ea12-2141636be10f
msgctxt "h83b9be4dg4a11g454ega375g728b9ceea2b1"
msgid "The moment we hit the city, let's look for our own place!"
msgstr "도시에 도착하자 마자, 우리가 지낼 집을 찾아보자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Cal
#. NodeID = d45ddab1-9fb1-44c2-5f91-6c5412a640f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:d45ddab1-9fb1-44c2-5f91-6c5412a640f6
msgctxt "h67e425c1ge5c6g4686gba94gf33739f27461"
msgid "No, no, an <i>owlbear.</i>"
msgstr "아니, 아니, <i>아울베어로 해줘.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies
#. Speaker = Rolan
#. NodeID = dcb126d6-04e3-82c6-716e-a06f3bf39674
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Prodigies:dcb126d6-04e3-82c6-716e-a06f3bf39674
msgctxt "h3397b945gd75ag4bc8g85d4g637d9357e363"
msgid "There's <i>nothing </i>more satisfying than a well-organised wardrobe."
msgstr "잘 정돈된 옷장보다 만족스러운 것도 <i>없지</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 10490b03-b4df-7086-9933-e6ac66152577
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:10490b03-b4df-7086-9933-e6ac66152577
msgctxt "h599117c8gfb7ag4e99gbdc9gc3ca07c3ddda"
msgid "Good. Continue your patrol."
msgstr "좋아. 순찰을 계속하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Goblin Tracker
#. NodeID = 218ffec9-972f-cd02-b83f-418fe5acffe3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cdc5e808-58ce-4d7d-5bbe-661599274112_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:218ffec9-972f-cd02-b83f-418fe5acffe3
msgctxt "h4aeaa1a8g3bfbg4267gba71g324ad3508693"
msgid "Nothin' but the bird, True Soul."
msgstr "오직 새만 있었습니다, 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 32241cb6-bad6-8301-7515-6582a81ca902
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:32241cb6-bad6-8301-7515-6582a81ca902
msgctxt "hf4443b0fg4768g4f1eg9cfag9311688355a9"
msgid "You are wasting my time."
msgstr "내 시간을 낭비하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Goblin Tracker
#. NodeID = 477fac21-acfc-63f7-5e60-fcefb4fbf277
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:477fac21-acfc-63f7-5e60-fcefb4fbf277
msgctxt "h9c016078g27cbg4254g9c1dgf9c38f0d0703"
msgid "Ah - yes. Of course."
msgstr "아, 네. 물론입죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Goblin Tracker
#. NodeID = 75d525a3-1f33-e6fd-ef43-524ebd4c429f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cdc5e808-58ce-4d7d-5bbe-661599274112_C = True
#. SetFlags:
#.   Local:
#.     - cdc5e808-58ce-4d7d-5bbe-661599274112_C = False
#.     - cdc5e808-58ce-4d7d-5bbe-661599274112_A = False
#.     - cdc5e808-58ce-4d7d-5bbe-661599274112_B = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:75d525a3-1f33-e6fd-ef43-524ebd4c429f
msgctxt "h0d1da652g2f92g4c4bg8276gb120db3ba124"
msgid "Looks like the altar will be finished soon."
msgstr "제단이 곧 완성될 것 같습니다요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Goblin Tracker
#. NodeID = 8f4fa81a-3adf-6506-1302-9c1f85600253
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cdc5e808-58ce-4d7d-5bbe-661599274112_A = True
#. SetFlags:
#.   Local:
#.     - cdc5e808-58ce-4d7d-5bbe-661599274112_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:8f4fa81a-3adf-6506-1302-9c1f85600253
msgctxt "hadc5bc12g59fcg4300gb365g70c2bd6d8034"
msgid "Skies are all clear. The water is, too."
msgstr "하늘이 아주 맑구만요. 물도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Nightwarden Minthara
#. NodeID = ab2aeb2c-208a-637c-c686-955e098f4a3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:ab2aeb2c-208a-637c-c686-955e098f4a3b
msgctxt "hd36a0676g0861g435ega3d6geacac5cb5d19"
msgid "Excellent."
msgstr "완벽하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Goblin Tracker
#. NodeID = d19087d3-9906-8c94-52c0-6382056ab5e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cdc5e808-58ce-4d7d-5bbe-661599274112_B = True
#. SetFlags:
#.   Local:
#.     - cdc5e808-58ce-4d7d-5bbe-661599274112_C = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:d19087d3-9906-8c94-52c0-6382056ab5e0
msgctxt "h7872bddbg942eg49f6g9369g00c7d6f659d0"
msgid "Nothin' to report, madame True Soul."
msgstr "보고할 게 없습니다, 참된 영혼 마님."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow
#. Speaker = Nightwarden Minthara
#. NodeID = e3fc7ddb-341e-e460-aa14-4a80c35c36ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ReportingToDrow:e3fc7ddb-341e-e460-aa14-4a80c35c36ec
msgctxt "h62fb062ag3b70g42d1g8b29g1a5443b5f5c7"
msgid "Don't let down your guard."
msgstr "경계심을 늦추지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = 0c220509-e819-1c03-0364-41890841d8c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:0c220509-e819-1c03-0364-41890841d8c2
msgctxt "hf3c58388gae2ag4eafg95f8gcd803eff43d5"
msgid "I think you just want an excuse to drink."
msgstr "술 마실 핑계도 가지가지네 라고만 생각 드는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
#. NodeID = 0c3e541e-620e-8ba4-1fc7-a5d3f6affd15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Event_SonOfChefGotDrink = True
#.   Local:
#.      - a59bb4ec-5906-2106-1d28-bcd4c8bdc8f0_C = True
#. SetFlags:
#.   Local:
#.     - a59bb4ec-5906-2106-1d28-bcd4c8bdc8f0_B = False
#.     - a59bb4ec-5906-2106-1d28-bcd4c8bdc8f0_C = False
#.     - a59bb4ec-5906-2106-1d28-bcd4c8bdc8f0_A = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:0c3e541e-620e-8ba4-1fc7-a5d3f6affd15
msgctxt "h959ba644g86afg4b04g94eag42914b962bfa"
msgid "Here's to us!"
msgstr "다 같이 건배!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
#. NodeID = 1f32b05a-ca3d-ff95-2489-978ead997649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:1f32b05a-ca3d-ff95-2489-978ead997649
msgctxt "hcd0487ddg0528g4b69ga22agdf2e2e6fb9c5"
msgid "Here, take mine."
msgstr "자, 내 거 마셔봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = 2a5934cb-2efb-70af-8f5e-1802ae71c537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:2a5934cb-2efb-70af-8f5e-1802ae71c537
msgctxt "he001ac87g2973g4b8cg82d8gc0dbbe617c36"
msgid "I'd rather keep my wits about me, thanks."
msgstr "난 정신줄 놓고 싶지 않아서 말이지. 사양할게."

