msgctxt "hd6ee7920g48d4g4d00gb00eg0f2e53c36028"
msgid "*The dog gives a soft whine of appreciation.*"
msgstr "*개가 부드러운 울음으로 감사를 표현합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = ac01875c-1624-3c1f-b497-49a15e5173a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
