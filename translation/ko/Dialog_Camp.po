msgid ""
"<i>Distract him with one hand and slip the ball from his jaws with the "
"other.</i>"
msgstr "<i>한 손으로 녀석의 주의를 돌리고 다른 손으로 공을 꺼낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
