#. NodeID = 02291d88-b1c3-5586-1f1b-bb9b89eb1133
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:02291d88-b1c3-5586-1f1b-bb9b89eb1133
msgctxt "h34427ad2g8da1g4508g85cag6a6a41891b62"
msgid ""
"I never really had a chance to grow out of my 'if it moves, climb aboard' "
"dating strategy. I was still in the middle of figuring all that out when "
"Gortash sent me to Avernus."
msgstr ""
"'움직이면 우선 타고 본다' 식의 데이트 전략을 버리고 성장할 기회를 제대로 가져 본 적이 없었어. 고타쉬가 날 아베르누스로 보냈을 때 "
"그런 것들을 알아가고 있는 중이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 03f53b6d-0c6b-b591-9aaf-d061607225ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:03f53b6d-0c6b-b591-9aaf-d061607225ed
msgctxt "h1ec9eb69g7d68g4845g858dg0b2ca2dd5ef6"
msgid "You might have to show me how 'slow' works."
msgstr "나한테 '천천히'라는 게 어떤 건지 네 시범을 보여줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 05c6990e-2919-e7ce-d28b-60738871467f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:05c6990e-2919-e7ce-d28b-60738871467f
msgctxt "h513c7cf3ge458g4a62gb0eage06ee9b65734"
msgid "Ah-ah. You first."
msgstr "아니, 너 먼저."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 070117b4-2d79-5b60-d82c-480d64f92dc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:070117b4-2d79-5b60-d82c-480d64f92dc1
msgctxt "h6043dd9eg04a8g43a4ga822g90178285ad25"
msgid "Gods be damned, it's a good day to be alive."
msgstr "빌어먹을, 살아있음을 만끽하니 기분 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 07ac3cdc-9cc8-3184-8ac1-b2408241790e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:07ac3cdc-9cc8-3184-8ac1-b2408241790e
msgctxt "hd6b534a5g945dg4af6gaca5g1c32e760940a"
msgid "My name sounds so good in your mouth."
msgstr "네 입에서 나오는 내 이름이 정말 달콤하게 들려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 08b01952-c13d-30b3-ba0f-4af10f6ce13a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:08b01952-c13d-30b3-ba0f-4af10f6ce13a
msgctxt "h35941286gb690g475eg9bc5ga0b071688666"
msgid "Let's take things slowly."
msgstr "우선 천천히 흥을 즐기자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 123c524b-19eb-3139-d168-e42cba7aba3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:123c524b-19eb-3139-d168-e42cba7aba3b
msgctxt "hb9664210gf5d6g4436g9697g095ec7def2d3"
msgid "Are you all right? Did I say something wrong?"
msgstr "너 괜찮니? 내가 말실수라도 했어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 13c1b903-b44b-e44c-2e22-281dbf7751fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:13c1b903-b44b-e44c-2e22-281dbf7751fc
msgctxt "hc583b735g4c7fg4b2cg861eg11a8426c5d7e"
msgid "I just need to slow things down."
msgstr "천천히 시작하면 좋겠어, 그게 다야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 14153a03-72e8-546a-c1e6-8ff96e9e0cca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:14153a03-72e8-546a-c1e6-8ff96e9e0cca
msgctxt "h8ba062e4g713eg4081gab31gde14f9539c38"
msgid "You're in charge, soldier. Hey, I have an idea."
msgstr "너한테 맡길게, 신참. 아, 하나 생각났다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 1a468b0d-61d2-8035-516c-62660c160b3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:1a468b0d-61d2-8035-516c-62660c160b3d
msgctxt "h88e0d542g6d92g4177gb2d9g2a9d74286019"
msgid ""
"I think this has all gone too far. I've made a mistake - we should just be "
"friends."
msgstr "아무래도 너무 멀리까지 와버린 것 같다. 내가 실수했네. 우리 그냥 친구로 지내자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 1afd2d0c-91ed-f590-8aa2-5fa644a29861
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:1afd2d0c-91ed-f590-8aa2-5fa644a29861
#, fuzzy
msgctxt "h5fff3f45g2515g4665g8765gf61c321a5821"
msgid ""
"<i>Slow</i>. To tell you the truth, I feel like I have two modes: <i>Off </"
"i>and on, on, on."
msgstr ""
"<i>천천히</i>라. 솔직히 말해서, 난 지금 두 가지 상태 밖에 안 되는 거 같아. <i>꺼짐 </i>이랑, 켜짐, 켜짐, 켜짐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 1dc4aa19-e542-2959-64fc-b265ccdd6b66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:1dc4aa19-e542-2959-64fc-b265ccdd6b66
msgctxt "h17ccff44gf718g4f31g8400ge4f05496cca1"
msgid "Let's just talk a little. What was your last relationship like?"
msgstr "그냥 얘기 좀 나누자. 마지막 연애는 어땠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 1e7238a3-b557-720d-fab2-be1e803411f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:1e7238a3-b557-720d-fab2-be1e803411f6
msgctxt "h5a4a6d86g8953g489bgbe58g41ba0dec2b09"
msgid "Look at that. Not even a light singeing."
msgstr "이것 봐. 조금도 그슬리지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 1ec4a004-a425-ad04-bcb2-e6202b2cdbd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:1ec4a004-a425-ad04-bcb2-e6202b2cdbd5
msgctxt "hcdf49c6dg73deg4ebfgbaf3g19a94bc5736b"
msgid "Hello, darling."
msgstr "안녕, 자기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 212c5db6-dc91-d87e-e3bd-c8042e950766
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:212c5db6-dc91-d87e-e3bd-c8042e950766
msgctxt "he79a7b43g11e3g4199gad9dg7839bfa85436"
msgid "Look at that. Not even a light singeing."
msgstr "이것 봐. 조금도 그슬리지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 219d20b4-2efe-37ae-8918-fbcdd48c02f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:219d20b4-2efe-37ae-8918-fbcdd48c02f6
msgctxt "h738307dcg70c0g4427ga078g937bd64580a6"
msgid "Now that's a feather in <i>my </i>cap."
msgstr "네 그 말이 바로 <i>내</i> 자랑거리야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 24c4a5b6-adca-86a4-3632-2dbe6106fdf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:24c4a5b6-adca-86a4-3632-2dbe6106fdf4
msgctxt "hf485059egfd81g409bg8836ga312091bc128"
msgid "Believe me, I can handle myself. <i>And </i>you."
msgstr "날 믿어, 내 몸 하난 잘 다룰 줄 알거든. <i>그리고 </i>아마 네 몸도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 24c7d8fc-9b50-55be-6300-34914c8e42cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:24c7d8fc-9b50-55be-6300-34914c8e42cf
msgctxt "hf9803612g7210g4307g9099ge21dee5508cd"
msgid ""
"I hope you know that I'm yours. Completely. And I'd like to take you to bed "
"now."
msgstr "난 네 거라는 걸 알아줬으면 해. 머리부터 발끝까지 다. 이제 널 침대로 데려가고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 26db4e9f-73eb-96f1-75a2-2fa014219507
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:26db4e9f-73eb-96f1-75a2-2fa014219507
msgctxt "h788b4bdegd1b2g421fgb7c7g29b9f640889d"
msgid "Hang on, this has gone too far. I think I want to be alone after all."
msgstr "잠깐, 우리 너무 앞서 나갔어. 사실 혼자 있고 싶은 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 2d51a7ae-2a4c-1155-e44f-9d7420faa84c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:2d51a7ae-2a4c-1155-e44f-9d7420faa84c
msgctxt "h4fee8382gf18ag4b8eg9f71g6c55006dfdb0"
msgid "How are you feeling?"
msgstr "기분은 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 2fdac265-7ed5-0619-dd6a-9702aa83ab01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:2fdac265-7ed5-0619-dd6a-9702aa83ab01
msgctxt "hf6b56c40g4e7ag43cag8b3dg70f3fc219c58"
msgid "Gods be damned, it's a good day to be alive."
msgstr "빌어먹을, 살아있음을 만끽하니 기분 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 340811a0-8efe-9ccd-e210-ac22b9d4eab5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:340811a0-8efe-9ccd-e210-ac22b9d4eab5
msgctxt "hf02f7313g7fbdg4392gb29fg59dc136dbfaf"
msgid "Even I'm not desperate enough to fuck an imp."
msgstr "아무리 이런 나라도 임프랑 떡을 칠 정도로 절박한 건 아니었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 3556b07a-ee85-8096-e4a3-204df8252427
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:3556b07a-ee85-8096-e4a3-204df8252427
msgctxt "hface696aga311g4146g92a4ge5351802b616"
msgid ""
"Fuck yes I am. Especially while my ultimate fantasy is right within reach."
msgstr "물론이지 씨발. 꿈에 그리던 환상이 코앞에 있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 394d44b5-9e35-2da4-6596-f42cbad54c3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(1) = True
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:394d44b5-9e35-2da4-6596-f42cbad54c3f
msgctxt "h5370c7f4g65e6g4e05gad71g7aca03cb12bc"
msgid "Gods be damned, it's a good day to be alive."
msgstr "빌어먹을, 살아있음을 만끽하니 기분 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 40da3de5-0501-1b39-7294-053296e139ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:40da3de5-0501-1b39-7294-053296e139ec
msgctxt "hc9269a05gf718g4546g8a13g4ee5e61ad673"
msgid "Oh - of course. I'm sorry if I misunderstood."
msgstr "앗, 물론이지. 오해해서 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 417cee3c-a310-85c6-0810-4ba95d07286d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:417cee3c-a310-85c6-0810-4ba95d07286d
msgctxt "h254766a9ga801g46d6gafe1g23bff22dc3fc"
msgid "Feather in my cap that I lasted this long."
msgstr "이 정도로 오래 버텼다는 걸 내 자랑거리라 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 455fa631-73e7-a60f-8b07-ea49ca311866
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:455fa631-73e7-a60f-8b07-ea49ca311866
#, fuzzy
msgctxt "h0ba8dbf3gc0cbg4b33gba26gce3f63d0dba7"
msgid "Like a... creature. Pulse. Heat. Desire."
msgstr "마치... 야수같아. 맥박이. 열이. 욕망이 끓어올라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 46c47c9f-c4a6-7181-65c6-29b1968b3ff5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:46c47c9f-c4a6-7181-65c6-29b1968b3ff5
msgctxt "h2b2fd88bg24ebg4f02gb5a7g3b49b9291541"
msgid ""
"With you, though - having to wait for someone I wanted so bad. I didn't know "
"I could tolerate so much anticipation."
msgstr "그래도 너와 지내면서 너무나 원하는 사람을 위해 참고 기다려야 했어. 달뜬 마음을 그렇게 오래 참을 수 있을지 몰랐다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 4a02a8b2-4bae-e58f-9ced-90727d952e52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:4a02a8b2-4bae-e58f-9ced-90727d952e52
msgctxt "h4d687426g2d06g4d8dg917cgff3ce20cfa2f"
msgid ""
"I don't mean to push. I just... I feel like my skin's on fire. In a <i>good "
"</i>way this time."
msgstr "밀어붙일 생각은 없었어. 그저… 살갗이 불타는 느낌일 뿐이야. 이번에는 <i>좋은 </i>쪽으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 503310ca-65df-f22b-ac8f-eb4223cee79d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:503310ca-65df-f22b-ac8f-eb4223cee79d
msgctxt "hc7067ba1g08b6g4148gbb80ga8098c7e48e2"
msgid "We're <i>sure </i>I won't hurt you, right?"
msgstr "정말 <i>확실하지</i>? 이래도 넌 안 다치는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 54c18bb5-3372-809e-4ab5-7cf682e60de1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:54c18bb5-3372-809e-4ab5-7cf682e60de1
msgctxt "hb7fdc38fg979bg4944ga170ge9ef4b7dc6d3"
msgid "We'll chat in the morning. Sleep well."
msgstr "아침에 다시 얘기하자. 잘 자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 55dbd754-ea1e-a1bd-e169-7836be658988
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingKarlach(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:55dbd754-ea1e-a1bd-e169-7836be658988
msgctxt "h6d595f9dgb207g48b4ga2b4gcdbaba702713"
msgid "Oh - I'm sorry if I... never mind. You're right."
msgstr "오, 미안해, 내가 좀... 그래. 네 말이 맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 575cfa73-27b6-df2c-69a8-d0da028df247
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:575cfa73-27b6-df2c-69a8-d0da028df247
msgctxt "hcbab9861g41b8g4312g8ff4g2f3ccb8b0cca"
msgid "Say it loud: 'I'm yours, Karlach.'"
msgstr "큰 소리로 말해줘. '난 네 거야, 칼라크.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 57ee079a-dfbe-0e81-b47b-cfaf05f9238b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:57ee079a-dfbe-0e81-b47b-cfaf05f9238b
msgctxt "h553a3fa6g52f4g42c9gbdceg6cf76d1c40cf"
msgid "That can't be true. Can it?"
msgstr "그럴 리가 없어. 정말이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 5b102f25-d515-c749-d9f1-bbc12df5d59b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:5b102f25-d515-c749-d9f1-bbc12df5d59b
msgctxt "hcafd82b5g32d5g47a0gb12dgca90e0d17293"
msgid ""
"You said it. But... when I'm with you, all that seems manageable. If I can "
"have you, I'll take the rest."
msgstr "맞는 말이야. 그래도… 너와 함께면, 다 괜찮을 것 같아. 너만 가질 수 있다면, 기꺼이 받아들이겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 5b32a623-4d12-1a76-af30-c5fff3a908c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:5b32a623-4d12-1a76-af30-c5fff3a908c3
msgctxt "h1d7ada12gb686g4002g96beg6582f23f169b"
msgid "Gods be damned, it's a good day to be alive."
msgstr "빌어먹을, 살아있음을 만끽하니 기분 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 62060636-7f35-54a5-2e83-aa38cdf5ae72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:62060636-7f35-54a5-2e83-aa38cdf5ae72
msgctxt "h8fa483f9g5068g47f9gafa9g94e7be564c91"
msgid "Go on."
msgstr "해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 62f34b2d-3ffd-eab2-b56d-b9229620f0f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:62f34b2d-3ffd-eab2-b56d-b9229620f0f2
msgctxt "h4c459f0cg6054g4e54g9e00g14869eed23c3"
msgid "Same as they all were, I suppose. Quick to flare, quick to fade."
msgstr "매번 그랬듯 똑같았지. 금방 타오르고, 금방 사그라들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 654597c8-1fe5-bdf0-7d05-19561f35b2f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:654597c8-1fe5-bdf0-7d05-19561f35b2f0
msgctxt "hc24da00ag8006g4347g911eg0c0bf5975c6b"
msgid "No, but I just think I might prefer to sleep alone tonight after all."
msgstr "그런 건 아니지만, 생각해 봤는데 오늘 밤은 각자 혼자서 자는 게 낫겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 65736e53-cc5e-4633-9312-09e28bc4274a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:65736e53-cc5e-4633-9312-09e28bc4274a
msgctxt "h920a8000gbf3bg42afg8b97g1f7ae2b58e5e"
msgid "I feel the same way."
msgstr "나도 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 6c7fce84-e9e5-6fad-e583-46ea01f8802b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:6c7fce84-e9e5-6fad-e583-46ea01f8802b
msgctxt "h3a204585ge384g4a92gb52egca4feadf2cf7"
msgid "Actually, I think I want to go to bed - alone."
msgstr "있지, 이제 자러 가고 싶어, 혼자서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 6d04de22-fe0e-cba7-7cf2-99b9954237ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:6d04de22-fe0e-cba7-7cf2-99b9954237ed
msgctxt "he51f341bg62a3g4e56g91e7gbfd8b13a5db3"
msgid "Feather in my cap, says I."
msgstr "이게 내 자랑거리야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 6f9be52e-2dde-f837-3818-8a7eca692d91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:6f9be52e-2dde-f837-3818-8a7eca692d91
msgctxt "h02953876g287ag4245ga0a1gb9fe0aeddbc2"
msgid "Actually, I'm not so sure about this."
msgstr "사실, 난 아직 확신이 서지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 704c9d26-5d22-9d26-03b8-1a338c3a9884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:704c9d26-5d22-9d26-03b8-1a338c3a9884
msgctxt "hf7eeb4eag6badg4fbegb43dg01101349a554"
msgid "Since I met you, all I wanted was to be close to you."
msgstr "널 만난 이후로, 줄곧 너랑 가까워지기만을 바랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 71629718-bc7f-4441-a432-7e1599fab00f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:71629718-bc7f-4441-a432-7e1599fab00f
msgctxt "hdca852b4g49e4g4e8eg9040g9ce67373cdce"
msgid "I can't believe this is <i>finally </i>happening."
msgstr "이 상황이 <i>정말로</i> 현실이 되었다니 믿기지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 7190ad2f-f7e0-6363-2e92-f1464ed5f6c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:7190ad2f-f7e0-6363-2e92-f1464ed5f6c6
msgctxt "h61d1bf9cgeaa4g4355ga4b7g793f5b185215"
msgid ""
"Would you believe me if I said this was probably the best day of my life?"
msgstr "오늘이 내 인생 최고의 날인 것 같다고 말한다면, 믿어 줄래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 72900f32-d79e-9a77-f13a-291bee77f6b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingKarlach(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:72900f32-d79e-9a77-f13a-291bee77f6b9
msgctxt "hb80c8ce1gcd5cg4ddfgaadeg2ef00b18e7d0"
msgid "Oof. There it is. <i>Devastation</i>."
msgstr "우으윽. 그렇구나. <i>결딴났네</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 74e08014-a903-ca79-65fd-aebb13e99d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:74e08014-a903-ca79-65fd-aebb13e99d2d
msgctxt "h874a37bdg03f6g412cga49dg15cd45f7fc4f"
msgid "You're afraid to face reality."
msgstr "현실을 마주하는 게 두려운 거구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 76067b4f-f11b-9b3b-5871-df0f5bf4809a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:76067b4f-f11b-9b3b-5871-df0f5bf4809a
msgctxt "hf22df7c3g76f1g4b31gb849gdb42f788f386"
msgid "What did you have in mind?"
msgstr "어디까지 생각해봤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 78573e9c-2a42-29cb-f2e4-41fad44417a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:78573e9c-2a42-29cb-f2e4-41fad44417a4
msgctxt "h524c07ffg07b1g49c1gb953gbf6e098a11de"
msgid "I'm yours. Completely."
msgstr "난 네 거야. 모조리 다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 7b44f07c-c13b-fdc4-3273-e76543a94d39
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:7b44f07c-c13b-fdc4-3273-e76543a94d39
msgctxt "h5c63ae9cg1093g48bbgbfd3g728ed8f1de63"
msgid "No, but I want to skip the talk. Let's go to bed - <i>now.</i>"
msgstr "아니, 근데 대화는 생략하고, 지금 자러 가자. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 7f225f7d-7a06-e83e-750c-a7a4777ac85c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:7f225f7d-7a06-e83e-750c-a7a4777ac85c
msgctxt "h424a1dc1gce49g4e62gb675g59e97c5547ce"
msgid "I thought you'd never ask."
msgstr "그 고백만을 기다리고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 86069e8a-9d58-c7bb-0c5d-f8019ef5a0d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:86069e8a-9d58-c7bb-0c5d-f8019ef5a0d0
msgctxt "h5a3ca660g5263g46bdg8d01gf83d240a7780"
msgid ""
"I'm happy with halfway. Or a quarter of the way. Or any part of the way "
"you're happy with."
msgstr "난 절반만 가도 좋아. 아니면 반의반이라도, 아니면 네가 갈 수 있는 데까지만이라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 899e87fa-2bb2-6dca-426c-f53f0b81e433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:899e87fa-2bb2-6dca-426c-f53f0b81e433
msgctxt "h4374bc6bg16eeg4b5fgb403gd62c2f4f1f2f"
msgid "I understand. It's all a bit overwhelming."
msgstr "이해해. 버거운 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 8c5fa145-344e-7370-6eea-5d3f81ee2445
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:8c5fa145-344e-7370-6eea-5d3f81ee2445
msgctxt "h1c9838f4g9631g463fgbd9dg2cb95870c75a"
msgid "Hmm. Maybe I like slow after all. So erm... can I kiss you now?"
msgstr "흐음. 나 어쩌면 '천천히'가 좋은가봐. 그럼 어... 이제 키스해도 돼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 8cfe36e8-dbf5-432e-9f99-b838892cf4b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:8cfe36e8-dbf5-432e-9f99-b838892cf4b9
msgctxt "h5e4db9b1gae67g4919ga73bg7d613711a967"
msgid "Sleep well. I'll try to do the same."
msgstr "잘 자. 나도 그러려고 해볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 8f8b7829-325d-6eda-8c30-9d4460ee0704
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:8f8b7829-325d-6eda-8c30-9d4460ee0704
msgctxt "hdf663af2g2a22g4800g9e51gbbcb01ec19d5"
msgid ""
"Easy, tiger. I want to explore what we have, but I don't want to move too "
"fast."
msgstr "진정해. 아직 우리 사이를 탐험해보고 싶어. 이렇게 급하게 굴긴 싫단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 90eb2b88-c5e4-ad71-4a16-e7411313e269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:90eb2b88-c5e4-ad71-4a16-e7411313e269
msgctxt "h31f16014ga90cg44deg8266gc556266020e1"
msgid ""
"Right. Yes. Got it. <i>So...</i> do you... erm... <i>help me, I don't know "
"how to do this.</i>"
msgstr "맞아. 그치. 알겠어. <i>그럼...</i> 혹시... 음... <i>도와줘, 이제 뭘 어떻게 할지 모르겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 91bad6ee-146d-1633-286e-1574e5a2055d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:91bad6ee-146d-1633-286e-1574e5a2055d
msgctxt "h6ea206dbg1883g4b4bg95e5ga63f462d5bee"
msgid "I think I should probably just head to bed - alone."
msgstr "그냥 침대로 갈게, 나 혼자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 9718e0e8-26ab-368f-de2d-7b6b9f235bad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:9718e0e8-26ab-368f-de2d-7b6b9f235bad
msgctxt "h75b558c3g7abbg4fefg9aadg2c81116e178e"
msgid "Really now?"
msgstr "정말이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = 9827b249-2656-d286-41f1-12d3b2910b58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:9827b249-2656-d286-41f1-12d3b2910b58
msgctxt "hc10c97cfg4574g46cdg8662g56cd2c57d2f5"
msgid "I want to talk about what Dammon said - about your engine burning out."
msgstr "대먼이 무슨 말을 했는지 기억해. 네 엔진이 타버릴지도 모른댔잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = 9c23ee37-8aad-5b1b-0c8d-0c5135e30bfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:9c23ee37-8aad-5b1b-0c8d-0c5135e30bfb
msgctxt "hcbc31acfgc658g4145g9fadg12e36245c393"
msgid "Gods be damned, I'm going to fuck you <i>good.</i>"
msgstr "젠장, 아주 <i>끝내주게</i> 따먹어줄게"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = a21003be-5f7c-2405-ae09-24f3e235366f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:a21003be-5f7c-2405-ae09-24f3e235366f
msgctxt "h13b515d9ge400g4240g92f3g0b05493e13f9"
msgid "It's been hard for me, too. I'm so glad I can be close to you now."
msgstr "나도 힘들었어. 이제 너와 딱 붙어 있을 수 있어서 너무 기뻐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = a4e0f80f-fe0e-3076-69e5-9896d5dc7420
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:a4e0f80f-fe0e-3076-69e5-9896d5dc7420
msgctxt "hb6f763ccgbd31g44c6gb9a0gc03ea0890971"
msgid ""
"Feather in my cap that I've survived this long without being able to be "
"close to you."
msgstr "너와 함께할 수 있게 되기 전까지 이렇게나 오래 버틴 거, 자랑이라면 자랑 아닐까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = a61d1df5-b5e6-0dfb-85fc-cb0f448eeede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:a61d1df5-b5e6-0dfb-85fc-cb0f448eeede
msgctxt "h19662bcagd0a9g461eg95deg550fbb8fdcaa"
msgid "On second thought, let's slow things down."
msgstr "다시 생각해봤는데, 일단 천천히 가는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = b15e2b22-9562-1e56-1ca4-57471f3da937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:b15e2b22-9562-1e56-1ca4-57471f3da937
msgctxt "hb53c127eg457eg470cgbdeegec179f1747aa"
msgid "I'd like to take you to bed now."
msgstr "이제 너와 함께 자고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = b6b8383e-9a0f-f61d-40fc-55e3e41f7583
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:b6b8383e-9a0f-f61d-40fc-55e3e41f7583
msgctxt "h7017623dgaf0eg4517g8c74g94452e3737b9"
msgid ""
"But you're in charge, soldier. Help me: what comes next? I might be a little "
"out of my depth here."
msgstr "너한테 맡길게, 신참. 도와줘. 이제 어떻게 하면 돼? 내겐 지금 상황이 조금 버거워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = ba109d58-f635-bc1f-16ce-dbe13a4afe46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:ba109d58-f635-bc1f-16ce-dbe13a4afe46
msgctxt "h0cc26b67gd453g43d3gb279g16000a271588"
msgid "I think the others are asleep. <i>Hi.</i>"
msgstr "다들 잠든 것 같네. <i>안녕.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = bc930dea-5287-550f-04c7-21bac7df9a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:bc930dea-5287-550f-04c7-21bac7df9a49
msgctxt "hecfe2da1ga84dg40a6g9d09g70b24d18c55e"
msgid "I like you, Karlach, but I don't think I want to sleep together."
msgstr "칼라크, 널 좋아하지만, 너와 함께 자고 싶지는 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = c0a5fd67-be0b-ddf5-9a51-dddb8b040948
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c0a5fd67-be0b-ddf5-9a51-dddb8b040948
msgctxt "h026c59begc4adg455dg85efgfe1edd237b80"
msgid "<i>Put your hand on her hip.</i>"
msgstr "<i>그녀의 엉덩이에 손을 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = c0bb0672-31c1-2ea0-a6ce-c587ce6fb945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c0bb0672-31c1-2ea0-a6ce-c587ce6fb945
msgctxt "hdcb0c1ddga5a9g438bg8e75g99a999a8b3ed"
msgid ""
"This is getting difficult, you know. Being this close to you. It's almost "
"more than I can take."
msgstr "점점 견디기 어려워지고 있어. 너랑 이렇게 붙어 있는 게 말이야. 감당하기 힘들 정도라구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = c0c148af-155a-2076-0321-2ca401ec3ab0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c0c148af-155a-2076-0321-2ca401ec3ab0
msgctxt "h4ddf8f3dg4953g46c7gadd2g710c127fe34e"
msgid "Later. I promise. Right now I just... I just can't."
msgstr "나중에 얘기해. 약속할게. 지금은 그냥... 못 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = c289bce9-7fe4-eace-d132-c080fb34d25e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c289bce9-7fe4-eace-d132-c080fb34d25e
msgctxt "h964e8cc7g780cg43e9ga3a2gc3a05f3a891d"
msgid ""
"But no - there wasn't anyone.  Couldn't risk it. Had to survive. And look - "
"it all worked out."
msgstr "근데 정말 아무도 없었어. 그런 위험을 감수할 순 없었지. 살아남아야 했거든. 그리고 그게 제대로 통해서 이 자리에 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = c29b9392-41b2-2049-5ea1-3cb28d3f6135
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c29b9392-41b2-2049-5ea1-3cb28d3f6135
msgctxt "h8c4ca5b8g2c0fg4feegb5a5g4ae8999e68d0"
msgid ""
"C'mon and c'mere, you. I've already spent too much time without you in my "
"arms."
msgstr "빨리 이리 와. 널 품에 안지 않고 이미 너무 오랜 시간을 보냈단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = c3e2c7aa-f2a5-3408-9576-6d33f6f57693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c3e2c7aa-f2a5-3408-9576-6d33f6f57693
msgctxt "h1be31941gf251g4a02gaca1g166d420c42f5"
msgid "You didn't, but I think I made a mistake. We should just be friends."
msgstr "아냐, 널 오해하게 만들었으니 내 잘못이야. 우린 친구 사이로 남자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = c6e61760-ebc9-5185-bc86-00372ef0e8a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c6e61760-ebc9-5185-bc86-00372ef0e8a8
msgctxt "ha71184d1ge28bg429fg9831gfd6f4efbf462"
msgid "My name sounds so good in your mouth."
msgstr "네 입에서 나오는 내 이름이 정말 달콤하게 들려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = c8b8b393-e08e-22ce-5ff6-13eaecfb2cc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:c8b8b393-e08e-22ce-5ff6-13eaecfb2cc9
msgctxt "h48185cfbgb0c9g45efg8f12gefb93b59a04b"
msgid ""
"Well actually... it might be better for us to sleep alone for the time being."
msgstr "근데 있잖아... 당분간은 각자 혼자서 자는 게 더 좋을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = ca7124f4-285a-75ca-4c32-bccd2527a216
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:ca7124f4-285a-75ca-4c32-bccd2527a216
msgctxt "haad32f05g287dg4458gbfdag3c0b4cd56bd5"
msgid "<i>Lean in and kiss her.</i>"
msgstr "<i>몸을 기울여 키스한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = cb55e530-01fc-a265-9cf8-95d303dc711c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:cb55e530-01fc-a265-9cf8-95d303dc711c
msgctxt "h69ae7e0dgee69g4aa3gbab0gfa83876330b7"
msgid "In your defence, you've been in the Hells an awfully long time."
msgstr "그럴 수도 있지, 네가 지옥에 정말 오래 있었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = cbe6528f-071f-176a-f3b4-631cbb4c934f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:cbe6528f-071f-176a-f3b4-631cbb4c934f
msgctxt "hdbbd6ef4g07eag49a7gb7a7g44e579513fd1"
msgid "May I test that theory?"
msgstr "그 이론을 한 번 검증해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = cd3b7b52-e03e-ed1c-42d9-3fb2a66886dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:cd3b7b52-e03e-ed1c-42d9-3fb2a66886dd
msgctxt "hcbe82615g3de7g4f49ga964g7d4bb2476a2f"
msgid "<i>Shift awkwardly.</i>"
msgstr "<i>어색하게 몸을 배배 꼰다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = cfb5a1c0-730b-953d-0c43-2d9ddba9f11c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:cfb5a1c0-730b-953d-0c43-2d9ddba9f11c
msgctxt "hc595bfffg3640g4c72gb66bgec0175f53548"
msgid ""
"I want to get to know you more. Get close to you - without going too far."
msgstr "너를 더욱 알고 싶어. 선을 넘지 않으면서도, 너와 가까워지고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = d2e11d75-cfb8-7037-f8ef-a2712ba06901
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:d2e11d75-cfb8-7037-f8ef-a2712ba06901
msgctxt "h68db9013g0e18g4e7cg816dgb72d57d2cf13"
msgid ""
"Me too. Would you believe me if I said this was probably the best day I've "
"ever had?"
msgstr "나도 그래. 오늘이 아마도 내 인생 최고의 날인 것 같다고 말하면, 믿을 수 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = d569a9ed-cafd-2abb-3ec6-2cff7f116b14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:d569a9ed-cafd-2abb-3ec6-2cff7f116b14
msgctxt "h5de08cc7g7a2bg484agb9a2g0bb48f74432b"
msgid "Was there really no one, the whole time you were in Avernus?"
msgstr "아베르누스에 있는 내내, 정말 누구도 없었던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = d5b5d056-e49f-5756-d0c2-61021053f048
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:d5b5d056-e49f-5756-d0c2-61021053f048
msgctxt "h31396e61g4bf3g4a09g9444ge3c738312f8f"
msgid "I said slow, Karlach, slow! Kissing comes later."
msgstr "천천히라고 했어, 천천히! 키스는 나중에 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = d7700d51-9395-d749-1163-b9f0a9f3b79f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:d7700d51-9395-d749-1163-b9f0a9f3b79f
msgctxt "hd9f98fa4g66aeg44acg9563ga4762848e788"
msgid "Gods be damned, I'm going to fuck you <i>good.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = d9c19f0e-2648-0d3a-044e-19cfc752a87c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:d9c19f0e-2648-0d3a-044e-19cfc752a87c
msgctxt "h23f9d76dga46cg4014g8e31g860397c806cb"
msgid "May I test that theory?"
msgstr "그 이론을 한 번 검증해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = e1b4546f-5e5d-ec1c-c0b7-84a2bd37f0e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:e1b4546f-5e5d-ec1c-c0b7-84a2bd37f0e7
msgctxt "h256daed3g8da0g4d35gb299g121d79a3b134"
msgid "I want to be close to you, but I'm not ready to go all the way."
msgstr "난 너와 함께 있고는 싶은데, 갈 데까지 갈 준비는 안 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = e6fe1d10-eadd-ca76-6c8b-3f012b51f724
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:e6fe1d10-eadd-ca76-6c8b-3f012b51f724
msgctxt "hbe4c5da9g8fc6g4a1ag9734gab298e5cc320"
msgid ""
"Since I met you, all I wanted to do was touch you. Now that I can, I never "
"want to let you go."
msgstr "널 만난 이후로, 내 소망은 오로지 널 만지는 것밖에 없었어. 이제 할 수 있게 됐으니, 다시는 널 놓지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = e7fac7df-6c77-9857-ad8d-2544b488c114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:e7fac7df-6c77-9857-ad8d-2544b488c114
msgctxt "he9b42125gc17dg45edgb14dg51487626afc3"
msgid ""
"Avernus was bad. But being here and unable to touch you for so long was "
"worse, damn it."
msgstr "아베르누스는 끔찍했어. 하지만 여기 있으면서 그렇게 오랫동안 널 만질 수 없었던 건 더 끔찍했어, 젠장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = ee5bb1d4-41ea-32a4-dd9d-4a902024a7ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:ee5bb1d4-41ea-32a4-dd9d-4a902024a7ea
msgctxt "h71dc1dfeg7b18g44e5g8e39g883a63847fe2"
msgid "Don't worry about it. Goodnight, Karlach."
msgstr "그런 거 아니니 걱정 마. 잘 자, 칼라크."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = efd7bad2-4b81-e239-2775-ad441827e2bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:efd7bad2-4b81-e239-2775-ad441827e2bb
msgctxt "h3330ee7dga5fcg4de8gbcbdg3546dbf42ac1"
msgid ""
"If you like, we can just lay together...? Clothes on and everything. I just "
"want to be near you."
msgstr "우리 그냥, 누워 있기라도 할래…? 아무것도 벗지 말고. 난 네 곁에만 있으면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = f14f0f5b-856f-45e0-8a72-f2f52d2720cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:f14f0f5b-856f-45e0-8a72-f2f52d2720cf
msgctxt "h64c535d1gdcb6g413eg8290g3e0554787803"
msgid "What do you want to do instead?"
msgstr "그럼 대신 뭘 하고 싶은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = f20a58ae-039b-afcc-1627-9691284959b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#.   Object:
#.     - ORI_State_PartneredWithKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:f20a58ae-039b-afcc-1627-9691284959b4
msgctxt "h5ea79961g1f33g44b2ga6aegb6579df96203"
msgid "That sounds perfect."
msgstr "그거 좋네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = f49ea3a0-02fa-d9b0-dfb8-11c0fd1c73ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:f49ea3a0-02fa-d9b0-dfb8-11c0fd1c73ac
msgctxt "h270d9869gc8ccg4ddcga822g21f047876b4c"
msgid ""
"C'mon and c'mere, you. I've already spent too much time without you in my "
"arms."
msgstr "빨리 이리 와. 널 품에 안지 않고 이미 너무 오랜 시간을 보냈단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = f6195971-4f2c-1817-caff-19ce8f5502f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:f6195971-4f2c-1817-caff-19ce8f5502f9
msgctxt "h149efac1g672dg4484gb2e5g9ccee949c585"
msgid ""
"Soldier's honour. Being next to you right now... it's almost more than I can "
"take."
msgstr "병사가 얻을 수 있는 가장 큰 영광이야. 내 곁에 지금 함께 있는 것. 감당하기 힘들 정도라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Player
#. NodeID = f63e1df0-d973-3285-56a7-963896783f83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:f63e1df0-d973-3285-56a7-963896783f83
msgctxt "h8449f4dcgaa65g4fbfgbe73ge5a6bf6b8c4a"
msgid "I'm yours, Karlach."
msgstr "난 네 거야, 칼라크."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = fb115dfb-086e-734c-5bdc-a37ddda5e7fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:fb115dfb-086e-734c-5bdc-a37ddda5e7fa
msgctxt "hcf811ee2g2388g4f0fg93cag315964a9894e"
msgid "I'm yours. Completely."
msgstr "난 네 거야. 모조리 다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = fb4336e7-ce38-ddf3-6781-c7764f1ae865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:fb4336e7-ce38-ddf3-6781-c7764f1ae865
msgctxt "hf16bc8e0g1830g4c82gb84ag7ba82e40282c"
msgid ""
"I want to touch you as deeply as you can be touched. I want you to be mine - "
"completely."
msgstr "네게 닿을 수 있는 가장 깊은 곳을 만지고 싶어. 널 남김없이 다 가질래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart
#. Speaker = Karlach
#. NodeID = fe3cd6a4-fffe-9cc9-51b9-bcf3ba60031c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Karlach_SD_ROM_ForgingOfTheHeart:fe3cd6a4-fffe-9cc9-51b9-bcf3ba60031c
msgctxt "h5730ddb6g8844g4472gba45ge87fec063649"
msgid ""
"Look, I respect your decision. Of course I do. But right now I need <i>more "
"</i>than a friend."
msgstr "봐, 나도 진짜 네 선택을 존중하는데 말이야. 난 지금 친구<i>이상</i>이 필요하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 0198f607-c961-50fa-6b04-eaeb6a49c525
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:0198f607-c961-50fa-6b04-eaeb6a49c525
msgctxt "h5e6b9087ge9e4g405egbcc1gc25b0073b252"
msgid "Say the words."
msgstr "말해봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 0528d6af-150a-1cbc-a26c-a499be68b523
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:0528d6af-150a-1cbc-a26c-a499be68b523
msgctxt "h749254ebge1acg4e44gbd4eg290cebf29b16"
msgid "You doubted me, didn't you?"
msgstr "날 의심했었지, 안그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 07e04c71-c69f-d9de-4ffc-9a13dd2018f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:07e04c71-c69f-d9de-4ffc-9a13dd2018f1
msgctxt "h40d2e4d8g3635g442bgb907g67723ba23583"
msgid "Excellent form. Well done, Lae'zel."
msgstr "훌륭한 솜씨였어. 잘했어, 레이젤."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 083fb121-2cce-7ff9-561b-2585f641739e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:083fb121-2cce-7ff9-561b-2585f641739e
msgctxt "h4d1c2d69g8cc9g44e3gabbfg634e8b99525d"
msgid "<i>Take her.</i>"
msgstr "<i>레이젤과 사랑을 나눈다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 0dbf0f19-3702-c078-aec5-76a35953e778
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithLaezel(1) = True
#.     - ORI_State_DatingLaezel(1) = False
#.     - ORI_State_PartneredWithLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:0dbf0f19-3702-c078-aec5-76a35953e778
msgctxt "he17dc191g3cb2g4aacgb5f2gce88d21375ad"
msgid "I can't. I'm sorry."
msgstr "안되겠어. 미안."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 1377bb0a-5f34-4294-6bf5-116fcfcf0832
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:1377bb0a-5f34-4294-6bf5-116fcfcf0832
msgctxt "ha2111777g09ebg4341g9e12gbff792593b16"
msgid ""
"I should be humiliated. I should know the shame of defeat. <i>I am Lae'zel "
"-</i>"
msgstr "난 굴욕감을 느껴야한다. 패배에 수치스러워 해야한다. <i>난 레이젤이다</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 13f18d28-2220-8bb5-ac58-d977175aba7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:13f18d28-2220-8bb5-ac58-d977175aba7b
msgctxt "h4f3b2f13gf781g42a9gb763gb5dad6b4419f"
msgid "<i>Take her hand and pull her up.</i>"
msgstr "<i>손을 내밀어 일으켜 세운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 18ccf424-470e-4cd2-62cb-1164ad30f9eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:18ccf424-470e-4cd2-62cb-1164ad30f9eb
msgctxt "hb1bde9c0gcf84g49f4g8a5dg7c7658a87b62"
msgid "<i>Lay me.</i>"
msgstr "<i>날 눕혀봐.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 1b2b97fe-1e33-c987-b61a-3497a69b99ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:1b2b97fe-1e33-c987-b61a-3497a69b99ae
msgctxt "h4d43b009gee16g4dc5g839cg3fe6dad1c6cb"
msgid "I want something more."
msgstr "난 더 많은 걸 원한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 217ed1d3-06de-c4f7-a36e-4738a89275c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:217ed1d3-06de-c4f7-a36e-4738a89275c5
msgctxt "h5f383cdeg9309g4e69gaa1cg8844b05582e8"
msgid "Pathetic. That's the best you could do?"
msgstr "한심하군. 그게 최선을 다 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 22216771-e079-ec57-026a-9b5b6d9cf61d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithLaezel(1) = True
#.     - ORI_State_DatingLaezel(1) = False
#.     - ORI_State_PartneredWithLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:22216771-e079-ec57-026a-9b5b6d9cf61d
msgctxt "h1a4f32d0g6b05g41eagb9bdgc57dc41f822d"
msgid "My, Lae'zel. You've gone soft."
msgstr "우리 레이젤. 부드러워졌네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 2c0e3e4f-98ed-0601-b000-43f135f43a93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:2c0e3e4f-98ed-0601-b000-43f135f43a93
msgctxt "h0450a773g850dg41d0gbe00ga5dd4ba4e3ed"
msgid "I cannot master you. I cannot even try."
msgstr "너 만큼은 사로 잡을 수 없군. 시도조차 해 볼 수 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 30edc8df-9c0d-ae64-fbc9-19b36e7e2809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:30edc8df-9c0d-ae64-fbc9-19b36e7e2809
msgctxt "hbd1c4a65gac99g44dcga890g734b21bcd7ac"
msgid "<i>Walk away.</i>"
msgstr "<i>거리를 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 332842a5-e9f2-3010-9547-ba15a1175c89
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:332842a5-e9f2-3010-9547-ba15a1175c89
msgctxt "h9fbc9c1cg44b1g472dg97abg6fd94c1c5de5"
msgid "You are mine."
msgstr "넌 내꺼야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 357151ac-32b0-0c10-dc89-ec0e76e5659a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:357151ac-32b0-0c10-dc89-ec0e76e5659a
msgctxt "h9151c31eg4918g4aafg84bcga2a34190138e"
msgid "<i>Zhak vo'n'ash duj</i>. Source of my bruises."
msgstr "<i>자크 보나쉬 듀</i>. 내 멍자국의 근원."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 3789e7cf-91b6-819d-d98c-0c99b2534ad1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:3789e7cf-91b6-819d-d98c-0c99b2534ad1
msgctxt "h693ebcf5g7a69g4b21ga95agb644a55c5df2"
msgid "<i>Pull her close. Press your lips against hers.</i>"
msgstr "<i>가까이 끌어당깁니다. 그녀의 입술에 입맞춥니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 470a1169-950d-64d4-120d-79fe99f5fe31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:470a1169-950d-64d4-120d-79fe99f5fe31
#, fuzzy
msgctxt "he3ab3192gc8b2g427bg9711gcc6cbb2e2cf3"
msgid "It was. Your wounds are your proof."
msgstr "최선이었다. 네 상처가 그 증거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 47775495-a309-9d1b-ee76-ac591b71344d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:47775495-a309-9d1b-ee76-ac591b71344d
msgctxt "hef219536g41e8g4d2eg9e01g25e4798b761e"
msgid "<i>Zhak vo'n'ash duj</i>."
msgstr "<i>자크 보나쉬 듀</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 4f094ffc-dfa5-52d4-7033-bc9610836382
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:4f094ffc-dfa5-52d4-7033-bc9610836382
msgctxt "hfe5bfac3g848dg42d6gbcf4g34e9509c6f56"
msgid "Show me."
msgstr "보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 59881d8f-758c-4b27-d2de-9b99c13a8e92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:59881d8f-758c-4b27-d2de-9b99c13a8e92
msgctxt "h67c14807g02c1g48a4gab33gd6ba6897d6d9"
msgid "<i>Tsk'va!</i>"
msgstr "<i>츠크바!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 59c09209-3f7f-2745-59df-2c5a52ca9919
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:59c09209-3f7f-2745-59df-2c5a52ca9919
msgctxt "h8b541f3cgd926g47dbgaaa3g6950b3d37b68"
msgid "I am yours."
msgstr "난 네 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 5cc9900f-44bc-c2da-5ef6-81c64020374a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:5cc9900f-44bc-c2da-5ef6-81c64020374a
msgctxt "h13ab1824g15fcg48adg962ag04229846cedd"
msgid "'You are mine.'"
msgstr "'넌 내꺼다.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 5e935f14-094e-e2d0-8b18-ecae3591d543
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:5e935f14-094e-e2d0-8b18-ecae3591d543
msgctxt "h0baee77fg23d5g4570g8b52gab674b2ea8be"
msgid "'I am yours.'"
msgstr "난 네 거다.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 5fd6f2fd-4e7f-0bac-8ad3-ac6ca8d09079
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:5fd6f2fd-4e7f-0bac-8ad3-ac6ca8d09079
msgctxt "h16a9a925g3f40g4e7ag8c89g5b695d1b64ef"
msgid "I won't beg."
msgstr "애원하진 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 67f301d6-8648-85b4-b172-c892e9cffd13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:67f301d6-8648-85b4-b172-c892e9cffd13
msgctxt "h7c35ccedg0b01g47c6g90e3g7413dda319b5"
msgid "But I also didn't doubt me."
msgstr "그리고 나 자신도 의심하지 않았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 6a7cf6c2-0039-a9ca-a517-3d98f6c5b9ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:6a7cf6c2-0039-a9ca-a517-3d98f6c5b9ec
msgctxt "hc030210cg88cdg4573g8cc9gf91ea1cb382a"
msgid "<i>Zhak vo'n'ash duj</i>. Source of my bruises."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 6f4703ff-4659-6343-c80c-ba3e253a5c1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:6f4703ff-4659-6343-c80c-ba3e253a5c1e
#, fuzzy
msgctxt "hf08059afgf477g43c4gbb68g4ae3778d1ef3"
msgid ""
"I don't want to hurt you - I want to protect you. For <i>you</i> to protect "
"<i>me</i>."
msgstr "넌 해치고 싶지 않다, 지켜주고 싶다. <i>네가</i> <i>나를</i> 보호하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 76f8dd8f-b74b-8fce-8342-d6cde088c073
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:76f8dd8f-b74b-8fce-8342-d6cde088c073
msgctxt "hfbf8d66dgd69bg4671gbbb0g2c138edde8a9"
msgid "You were stronger. I was steel, and you were silver."
msgstr "네가 더 강했다. 내가 강철이라면, 넌 은이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 7cc5183e-3593-45d7-d857-e676e8126213
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:7cc5183e-3593-45d7-d857-e676e8126213
msgctxt "h8dadb91ag7525g4c16ga725g31457a42ab1f"
msgid ""
"I've torn flesh from monsters and men. I've laughed as they suffered. But "
"<i>you</i> -"
msgstr "난 괴물들과 사람들의 살을 찢는다. 그들이 고통받는 만큼 난 웃었지. 하지만 <i>넌</i> -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = 7efea4ff-73c6-3ca6-c4f1-1291f2c76a89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:7efea4ff-73c6-3ca6-c4f1-1291f2c76a89
msgctxt "hce344c5egff4cg4fc4gae2bgd7fe3ffd83db"
msgid "<i>Take her hand and pull her up.</i>"
msgstr "<i>손을 내밀어 일으켜 세운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 821de12e-6229-c243-4bab-7bbae30bf747
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:821de12e-6229-c243-4bab-7bbae30bf747
msgctxt "h1fb7658eg1caag469bg94e9g363b1cd009f2"
msgid "Right answer."
msgstr "좋은 대답이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 88983ef7-86c3-8a56-3060-c46ce87a7b44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:88983ef7-86c3-8a56-3060-c46ce87a7b44
msgctxt "h941a641bgf3c8g40e1g9bc4ge56aef97f582"
msgid ""
"Yet I cannot take of your flesh, of your body. I can withstand anything in "
"the realms, but not the fire in you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = 969b18b9-8dad-70b9-241f-10e816ebf64b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:969b18b9-8dad-70b9-241f-10e816ebf64b
msgctxt "h74f99beegfcc7g43dega1adgd6a6c8d7b850"
msgid "No more. I can't bear it."
msgstr "더 이상은. 못견디겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = c2aa14a4-099b-3267-0d70-87a04c843ec2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:c2aa14a4-099b-3267-0d70-87a04c843ec2
msgctxt "h7903a82agceceg4e0eg9fe0gff618be22d17"
msgid "- but you, you are <i>jhe'stil.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = c578993c-9de9-fdab-af52-9dced6083d71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:c578993c-9de9-fdab-af52-9dced6083d71
msgctxt "hfe38d58cgdb21g43d0ga631ge42b191faad0"
msgid "This is the mighty Lae'zel? What an embarrassment. You've gone soft."
msgstr "그 강하던 레이젤 맞아? 정말 어색한데. 너 부드러워졌구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = c8d8ae4e-b890-4655-aac1-84236b70d8d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:c8d8ae4e-b890-4655-aac1-84236b70d8d5
msgctxt "h6fc75148g9e53g4fc8g8a9fgcd7cdb3088ec"
msgid "Say the words."
msgstr "말해봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Narrator
#. NodeID = c96b8aa6-e7bf-1fa4-4831-05529cfe3835
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:c96b8aa6-e7bf-1fa4-4831-05529cfe3835
msgctxt "hfb36fe7dg7d01g4331gbe65g0648b793fd34"
msgid ""
"*Lae'zel's touch is unusually gentle. Her fingers lightly graze your bruises "
"and wipe away your sweat.*"
msgstr "*레이젤의 손길이 평소답지 않게 부드럽습니다. 그녀의 손가락이 상처를 가볍게 스치며 당신의 땀을 닦아냅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = cbf9680f-992d-a4a0-fcbd-7e696cff3438
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:cbf9680f-992d-a4a0-fcbd-7e696cff3438
msgctxt "h09faceffgc17bg479cgafaag3c2690148508"
msgid "<i>Zhak vo'n'ash duj</i>. Source of my bruises."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = ce3f82f1-1ca1-d619-fe0d-a00dfef6dd1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:ce3f82f1-1ca1-d619-fe0d-a00dfef6dd1f
msgctxt "h37836db0g2722g4342g9f1cg09c80935c060"
msgid "Save your compliments. I won't accept them."
msgstr "칭찬은 나중에 해라. 난 받아들이지 않을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Narrator
#. NodeID = d3eff4b4-2e48-04b2-fc31-b6ed9da17cbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:d3eff4b4-2e48-04b2-fc31-b6ed9da17cbd
msgctxt "h926b040fgb3ddg4110gb1b0gf7f9920d8409"
msgid ""
"*Lae'zel's touch is unusually gentle. Her fingers lightly graze your bruises "
"and wipe away your sweat.*"
msgstr "*레이젤의 손길이 평소답지 않게 부드럽습니다. 그녀의 손가락이 상처를 가볍게 스치며 당신의 땀을 닦아냅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = d8d04665-d846-6cc7-45b3-1aee13fa26c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:d8d04665-d846-6cc7-45b3-1aee13fa26c1
msgctxt "haa0668b8g216fg433fg9e81gdf1dd38b4fc7"
msgid "<i>Incredible.</i>"
msgstr "<i>대단하군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = dc3231a4-b0a0-731a-6723-f3bc028ce63c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:dc3231a4-b0a0-731a-6723-f3bc028ce63c
msgctxt "h52bada19g1272g4f41gac77g83f9ff45cced"
msgid "<i>Zhak vo'n'ash duj</i>. Source of my bruises."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = ddf225fb-b0c4-7f68-1115-0d4986b94280
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:ddf225fb-b0c4-7f68-1115-0d4986b94280
msgctxt "h91ef1ee1g69aeg4505g8e45g0bcbfec45adf"
msgid "No."
msgstr "안했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = e4536788-32d7-257b-34a9-9ce5a62810e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:e4536788-32d7-257b-34a9-9ce5a62810e9
msgctxt "h94ea7bb4g6faeg4eb7g94f1g825e743eb124"
msgid "<i>Smile and pull Lae'zel to the ground.</i>"
msgstr "<i>웃으며 레이젤을 바닥에 넘어뜨린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = eac32ef7-595f-666d-4bd4-9b84605cd0ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:eac32ef7-595f-666d-4bd4-9b84605cd0ff
msgctxt "hcefd7949g5dcag4399gbda4g655fce379186"
msgid ""
"I am made malleable by the flames in you. By the inferno of the Hells. But I "
"cannot touch you. I can have no part of you - none!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Lae'zel
#. NodeID = f5048950-1179-0938-53be-9b563441c713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:f5048950-1179-0938-53be-9b563441c713
msgctxt "h2f7d2718g7df8g45bagbfe1g674c7669e674"
msgid "As you wish."
msgstr "네가 그렇다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel
#. Speaker = Player
#. NodeID = f9f617cc-42d6-8c27-464f-e330ef1f2e76
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance2_AfterDuel:f9f617cc-42d6-8c27-464f-e330ef1f2e76
msgctxt "hd8bc0065g2bb6g4db3gad11g75db6f92f258"
msgid "You are mine."
msgstr "넌 내꺼야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 05f7b1f7-da1b-2f42-9954-99fb14097e01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:05f7b1f7-da1b-2f42-9954-99fb14097e01
msgctxt "h12846352g2b2cg4026g90bag182c00e5d325"
msgid "Everything's fine, trust me. Now come."
msgstr "별일 아니다. 날 믿어라. 어서 일어나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 07d87853-edf7-ea33-2eac-9b1820085c30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:07d87853-edf7-ea33-2eac-9b1820085c30
msgctxt "h2cce9ae0g118ag42b6gb254g595f32fe3a7a"
msgid "Of course. I could never resist you."
msgstr "그렇겠지. 널 어떻게 말리겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 0edb7f2f-faab-b92d-19cf-a2277cbfc2a8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_CompletedRomance = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:0edb7f2f-faab-b92d-19cf-a2277cbfc2a8
msgctxt "h88521e11gb7cag4a12gb7ceg2e576e3cfdd8"
msgid "I just can't say no. You have me for good."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 1061cd98-be5d-1855-e12d-f0db8ed5208f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:1061cd98-be5d-1855-e12d-f0db8ed5208f
msgctxt "h3f314406g9735g4187g8095gd45add272d01"
msgid "Hope. Life. A future worth fighting for."
msgstr "희망. 삶. 싸울 가치가 있는 미래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 1702d1ec-8f57-f7ee-ccb9-8d56ef90ac7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:1702d1ec-8f57-f7ee-ccb9-8d56ef90ac7a
msgctxt "h310b1c61g54e6g4e79gb6cfg66f95a6a8c17"
msgid "I know it's early. But this couldn't wait."
msgstr "이른 시간인 건 안다. 하지만 지금 아니면 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 183a8733-a641-6a3c-d050-8f07572ec15e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:183a8733-a641-6a3c-d050-8f07572ec15e
msgctxt "hb1f6366egd82bg47ffg8b14g0ae466dd43b3"
msgid "I'm not sure, Lae'zel. You can be a lot to handle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 1b2a3027-6eb7-54c7-8feb-6e1b554ebcab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:1b2a3027-6eb7-54c7-8feb-6e1b554ebcab
msgctxt "h2a5a4b77gf02bg4941gb8beg3352fab720d3"
msgid ""
"I used to hate that sight. The glowing sky, the long shadows, the fading "
"stars."
msgstr "예전에는 저 광경을 싫어했다. 불타는 하늘, 긴 그림자, 자취를 감추는 별들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 1c34362d-94cb-570c-47d1-40eaefb4a979
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:1c34362d-94cb-570c-47d1-40eaefb4a979
msgctxt "h2ce84448gd884g40cfg99ecg171e49bc4416"
msgid "Go on, say what you have to say."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 28324746-b8e9-572d-bd8d-df14f19471fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:28324746-b8e9-572d-bd8d-df14f19471fc
msgctxt "hb69a6cbdg2f00g4e55gabceg44813c049bcf"
msgid "I'm sleeping, Lae'zel. Must you make this a habit?"
msgstr "자고 있잖아, 레이젤. 매번 이렇게 깨워야겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 287b0a97-203a-4ef8-8681-b46b2dbb6e77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:287b0a97-203a-4ef8-8681-b46b2dbb6e77
msgctxt "h65c692efge71cg4bf1g8e5dg1d61e1042365"
msgid "Is everything all right?"
msgstr "별일 없는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 287d309d-8365-8d19-5bd2-328183861cb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:287d309d-8365-8d19-5bd2-328183861cb6
msgctxt "hacfe6f95g2ed0g473eg8740g4bee2a42a5e8"
msgid ""
"I lived for the red of blood and the black of death. Now I see the colours "
"between."
msgstr "나는 붉은 피와 검은 죽음을 위해 살아왔다. 지금은 그 사이의 색들이 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 2c6e160b-d37c-8185-c7a9-bad138a21a40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:2c6e160b-d37c-8185-c7a9-bad138a21a40
msgctxt "hb830291eg4da3g46d3ga9a1ga1198f044fc1"
msgid "A new day means new battle. I'm in no mood to fawn over sunrises."
msgstr "날이 밝으면 새로운 전투가 기다릴 뿐이야. 일출 따위로 감상에 빠지고 싶진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 2ec1713c-f33f-032f-c65a-f327a6272a6b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithLaezel(1) = True
#.     - ORI_State_HandledBreakupWithLaezel(1) = True
#.     - ORI_State_PartneredWithLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:2ec1713c-f33f-032f-c65a-f327a6272a6b
msgctxt "h9425b9acg87c8g4954g8e45g522876696343"
msgid ""
"You showed them to me. Thank you for that. But - ugh, <i>tsk'va</i>. I "
"thought this would be easier."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 3096becd-7069-796d-70cc-21aee93ebf94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:3096becd-7069-796d-70cc-21aee93ebf94
msgctxt "h28f1407bgf4c3g4f68g8d7ega08a3b938506"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 311e45f0-804e-f9aa-0fb4-ebedcdcf8ff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:311e45f0-804e-f9aa-0fb4-ebedcdcf8ff1
msgctxt "h7ced8551g248fg486dg9f72ga824cafe232a"
msgid ""
"You showed me the betweens and beyonds. Between war and peace, beyond "
"passion and obsession."
msgstr "넌 내게 사이와 너머를 보여 주었다. 전쟁과 평화 사이, 열정과 집착 너머를 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 31df4461-e861-d20b-ca9a-3dfbac254407
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithLaezel(1) = True
#.     - ORI_State_HandledBreakupWithLaezel(1) = True
#.     - ORI_State_PartneredWithLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:31df4461-e861-d20b-ca9a-3dfbac254407
msgctxt "h859a5df5g749cg4133gb421gdac2959df30d"
msgid "Get out of here, already."
msgstr "당장 여기서 나가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 33473746-62eb-7907-df0c-890b543fcee4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:33473746-62eb-7907-df0c-890b543fcee4
msgctxt "h533ee25fgedf4g4ed6g95a7gcb182f0e5c67"
msgid "Get out of here. I can hardly stand to look at you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 44cd9d0e-de9c-d988-32fc-8557a62d134a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:44cd9d0e-de9c-d988-32fc-8557a62d134a
msgctxt "h30627784g679bg4eb0gb030g232b29bfc5cd"
msgid "Only in Vlkaakith may we find light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 44cd9d0e-de9c-d988-32fc-8557a62d134a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:44cd9d0e-de9c-d988-32fc-8557a62d134a
msgctxt "h6158f2a7gade5g4a45gb38dge7c7f1446cc3"
msgid "Only in Vlkaakith may I find light."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 4ae23c8d-2088-81e7-a16c-bd64d8aa70cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:4ae23c8d-2088-81e7-a16c-bd64d8aa70cc
msgctxt "h7b504dc1gcbbag46deg8dc6g4cbf134a25f0"
msgid ""
"And I've learned other ways, too - the ways of affection and devotion. "
"First, you were my wound; now, you are its cure."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 4b61b7de-99ad-24fe-25b8-ededec4f4426
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:4b61b7de-99ad-24fe-25b8-ededec4f4426
msgctxt "hcaa1a0ddg5d54g4996gb13cge2d2c1d841fb"
msgid "<i>Zhak vo'n'ash duj</i>. Source of my bruises."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 4d97d2d8-494b-f8ab-1f09-aefad16ea6cc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:4d97d2d8-494b-f8ab-1f09-aefad16ea6cc
msgctxt "h646a92cag1865g416agbfd6g8c3d90361a60"
msgid "I would expect no less. You are a servant of our queen."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 4d97d2d8-494b-f8ab-1f09-aefad16ea6cc
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:4d97d2d8-494b-f8ab-1f09-aefad16ea6cc
msgctxt "h7ed256e3g1da5g4744gb3a2g36dbec9332b6"
msgid "I understand. Your queen must be your priority."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 5e03e766-84be-a02d-cb72-c6e4e6272647
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:5e03e766-84be-a02d-cb72-c6e4e6272647
msgctxt "h7a1b266eg58e7g431dg8015ga69d95af9863"
msgid "A flaming ball in the sky that provides heat and warmth."
msgstr "열기와 온기를 주는, 하늘 위의 불타는 공."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 61db6b7d-fe46-d62d-5236-cdfa863bec4b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_CompletedRomance = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:61db6b7d-fe46-d62d-5236-cdfa863bec4b
msgctxt "h1a0eac1cg4cceg46d6gb15fg09405d876d90"
msgid "<i>Smile bashfully and keep your hand to yourself.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 64049c8f-25cf-7606-d6fa-8dae092409e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:64049c8f-25cf-7606-d6fa-8dae092409e9
msgctxt "heb710f26gf277g4025gbae6g67f0cce64a01"
msgid "<i>Beauty.</i>"
msgstr "<i>아름다움.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 64523115-18b2-2268-ea88-99373e1e94c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:64523115-18b2-2268-ea88-99373e1e94c2
msgctxt "h20e848bag9c4eg4a2ag9b15gd5a8afad6969"
msgid "<i>Zhak vo'n'ash duj</i>. Source of my bruises."
msgstr "<i>자크 보나쉬 듀</i>. 내 멍자국의 근원."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 659e1453-8501-9267-4ce3-ee4bce01d598
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:659e1453-8501-9267-4ce3-ee4bce01d598
msgctxt "hcafd792age4fcg4a0bgb992g0fa5bb47f54e"
msgid ""
"You have taken the whole of me. I could never accept just a piece of you in "
"return."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 66795d5c-79e9-a14f-857b-8534f2676364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:66795d5c-79e9-a14f-857b-8534f2676364
msgctxt "hdfe832a4g4317g4d0cg9b08g226ba0436571"
msgid ""
"I can't deny that I feel for you. But you are a - a distraction. I belong to "
"Vlaakith. I cannot be yours. You cannot be mine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 69b231b3-64fe-5781-38b2-9b5c0ef2182f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithLaezel(1) = True
#.     - ORI_State_PartneredWithLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:69b231b3-64fe-5781-38b2-9b5c0ef2182f
msgctxt "hfe6d328ega991g4504gaa9dg2a35cec7d8a1"
msgid "I'm calling it quits."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 6c2a0a44-59ee-0e63-3ae7-6ef7c5698b25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:6c2a0a44-59ee-0e63-3ae7-6ef7c5698b25
msgctxt "h0a32f0f0g531eg4de8g82beg0d111ccc5f4f"
msgid "Then I'll go."
msgstr "원한다면야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 6f7f84d3-950a-dbbe-bc81-0ccfa6b0241c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:6f7f84d3-950a-dbbe-bc81-0ccfa6b0241c
msgctxt "hf2e87384gdc79g4c80ga761ga24ad50ef4d0"
msgid ""
"I know. I'm stubborn, I'm rude, I'm pushy. Maybe I always will be. But I'm "
"also loyal and protective and ferocious."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 74ee7b4f-ff2f-575c-d236-7473daaec51d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:74ee7b4f-ff2f-575c-d236-7473daaec51d
msgctxt "h44d6281cg6e55g48c7ga416g0b2f5d20e9aa"
msgid "Get up. There's something you should see."
msgstr "일어나. 네가 봐야만 하는 게 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 7da62359-6181-3adb-f12f-9ee7e7c4eb93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:7da62359-6181-3adb-f12f-9ee7e7c4eb93
msgctxt "h0e4aacf7g6d03g4788gac96gfa9c7e32f21c"
msgid "<i>Zhak vo'n'fynh duj</i>. Source of my joy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 7da83cd8-c344-c640-a514-0d844704e488
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:7da83cd8-c344-c640-a514-0d844704e488
msgctxt "hb429ec19gfdb6g4222g9048ga909e381d39b"
msgid "I see."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 7db05e66-0420-d5a0-d10d-24891ecfdaff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:7db05e66-0420-d5a0-d10d-24891ecfdaff
msgctxt "hdcd7993dg2e7bg477bg8ebcg082fa3006d30"
msgid "Come."
msgstr "따라와라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 7de49941-242d-37b0-3a9a-b08b2bc4e126
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_CompletedRomance = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:7de49941-242d-37b0-3a9a-b08b2bc4e126
msgctxt "h342c8588gd28eg4516g8d0bg563580ddb594"
msgid ""
"I've been waiting so long to hear those words. I will stay with you, come "
"what may."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 801f3da5-b32e-81e1-dab6-db72286beb42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:801f3da5-b32e-81e1-dab6-db72286beb42
msgctxt "h924a095dg0e2dg431eg9af2g5d8e9d23b8f9"
msgid "Yes. And something else, too."
msgstr "그래. 그리고 다른 것도 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 83d53fe5-b086-c950-932d-b66d25140b04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:83d53fe5-b086-c950-932d-b66d25140b04
msgctxt "h54725cebg88d4g4a43gad65gbafb36737bb4"
msgid "Watch."
msgstr "봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 8bb7be1d-b75c-6709-4c29-88c1baf8da06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:8bb7be1d-b75c-6709-4c29-88c1baf8da06
msgctxt "hb9232771g0c4ag4cebgbdafg1433c55d6963"
msgid ""
"Trust me, my bones ache for battle too. But look closer - you might see "
"something else."
msgstr "장담컨대 나 역시 전투를 갈망하고 있다. 하지만 자세히 봐라. 다른 무언가가 보일지도 모르니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 8c198b56-2766-cad6-808f-c7dc951e6d8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:8c198b56-2766-cad6-808f-c7dc951e6d8c
msgctxt "ha123f6a0g076eg4f38g9a4dgb3022221c09a"
msgid "All right. This better be good."
msgstr "알았어. 그 말 틀리기만 해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = 9c5c0c47-e5b9-2372-6623-757838f5a11f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:9c5c0c47-e5b9-2372-6623-757838f5a11f
msgctxt "h8184562cg5051g4fc8g87cfg97a503036ef9"
msgid "Understood."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 9d0ac729-3164-5f9b-dd25-12c1175d7dca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithLaezel(1) = True
#.     - ORI_State_PartneredWithLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:9d0ac729-3164-5f9b-dd25-12c1175d7dca
msgctxt "h95b6d7a1ga402g445dgab77g08e0f38a897c"
msgid "What a joke. I'm done with this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = 9e463108-df96-7d84-5ae5-63307bc32e61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:9e463108-df96-7d84-5ae5-63307bc32e61
msgctxt "h0b266af6gdff1g408ag855fgaff8e59b2c32"
msgid "One step at a time. But for now, I'm not going anywhere."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = a8c5a0bf-43a7-13a6-ac88-697e0ba859a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_CompletedRomance = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:a8c5a0bf-43a7-13a6-ac88-697e0ba859a2
msgctxt "hc4777a60g27fbg4159g841agcc5cb222adfa"
msgid "<i>Take Lae'zel's hand.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = aa6d1a93-3583-1c21-92d9-ccc4820c8ef2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:aa6d1a93-3583-1c21-92d9-ccc4820c8ef2
msgctxt "h2be19d36g438fg4015g9435gb5bef5a6d4b3"
msgid "Look at the sun. What do you see?"
msgstr "저 태양을 봐라. 무엇이 보이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = b2feb3d4-a90e-bfd1-1ef0-5c608ccd7447
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:b2feb3d4-a90e-bfd1-1ef0-5c608ccd7447
msgctxt "h1fcf8bb0gee65g4434gad75g293e790d97fd"
msgid "One step, then. Maybe even two - if I should be so lucky."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = b400586e-c85b-88b6-df06-995f51d657cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:b400586e-c85b-88b6-df06-995f51d657cc
msgctxt "ha3dab8f6g4961g418fg8c0cg4da27af8c8e0"
msgid "I liked the sex. But I'm not ready for commitment."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = b7fdf5ce-78dc-1678-3309-f79ebfb52c80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:b7fdf5ce-78dc-1678-3309-f79ebfb52c80
msgctxt "hb37602e8g4369g46dagb955g93e4c0b3495b"
msgid ""
"You have stirred my soul, and more besides. But I belong to Vlaakith. I "
"cannot be yours. You cannot be mine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = c6b10069-365a-5ded-eff7-3fc39b430af5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:c6b10069-365a-5ded-eff7-3fc39b430af5
msgctxt "h87e9374cgda12g434bga6bcged4ddd001304"
msgid "I'll make it worth your while. I promise."
msgstr "그만한 가치가 있을 거다. 약속하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = c9af31de-2858-74a9-d98c-f5cdba865a2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:c9af31de-2858-74a9-d98c-f5cdba865a2b
msgctxt "h872a1813gbdd8g4d01ga1c2g8b282303fb38"
msgid "If only you knew how much went unsaid."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = cf45d7aa-a9fe-cdfa-4b56-81d1016871d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:cf45d7aa-a9fe-cdfa-4b56-81d1016871d6
msgctxt "h020a645egda2bg4f91g874agcabfc3850c73"
msgid "Most importantly - you showed me freedom."
msgstr "그리고 무엇보다도... 자유를 보여 주었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = d5c21c71-3551-4757-080b-2bcbaf3bda4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:d5c21c71-3551-4757-080b-2bcbaf3bda4c
msgctxt "ha2e7b72ag59c0g4225ga4efgb4d1866f3790"
msgid "<i>Get out of the bed.</i>"
msgstr "<i>침대에서 일어난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = d6197e6c-78c0-6161-0591-6aa5aa30974c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_CompletedRomance = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:d6197e6c-78c0-6161-0591-6aa5aa30974c
msgctxt "hea355e22gd91ag4499ga70dg2db0b7604dbc"
msgid "I can't take your hand. But I'll gladly look after your heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = d6ff7af7-d485-3cd4-fc96-06682eb306cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:d6ff7af7-d485-3cd4-fc96-06682eb306cb
msgctxt "hb3288137g27b7g4454gaae6gf46a07286364"
msgid "It's not that I want to. It's that I must."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = e2d92d56-0315-3f6d-1245-5e9da0b7b2f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:e2d92d56-0315-3f6d-1245-5e9da0b7b2f0
msgctxt "h8ba304d0g23a8g4f35ga3deg4d1cf915f4f5"
msgid "Really? You've never been short of opinions."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = e4542a26-059c-db4f-bf1c-7795c3de45c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:e4542a26-059c-db4f-bf1c-7795c3de45c0
msgctxt "heb33dc15gba09g434bgab4cg487055fa3ae1"
msgid "It's better this way. Trust me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = e5b20222-59c4-be2f-5f5b-fdc2645a921b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:e5b20222-59c4-be2f-5f5b-fdc2645a921b
msgctxt "h0669031dge4bcg4d48g8a45ge556be9c44c1"
msgid ""
"There's more, but - but I don't know how to say it. I don't know what to "
"call it. I just know whatever comes next, I want you near."
msgstr ""
"할 말이 더 있지만, 어떻게 말해야 좋을지 모르겠다. 뭐라고 불러야 좋을지 모르겠다. 다만 무슨 일이 생기든, 네가 곁에 있기를 바란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = e721b07f-12e7-c3ee-7caf-e902025d97ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:e721b07f-12e7-c3ee-7caf-e902025d97ce
msgctxt "h50758874g4b80g43aeg9649ge89744ad3dfe"
msgid "Literal - but not wrong. I see something else."
msgstr "상상력이 부족하군. 하지만 맞는 말이야. 난 다른 걸 본다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = ec0a4465-c3dd-3c16-19a2-9a6c6ea84013
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:ec0a4465-c3dd-3c16-19a2-9a6c6ea84013
msgctxt "he6ecd7f7g190dg4932g8495g7707d6a5b37d"
msgid "<i>Zhak vo'n'fynh duj</i>. Source of my joy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = f10a908d-4ee1-407e-7b94-b363d8f7173b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:f10a908d-4ee1-407e-7b94-b363d8f7173b
msgctxt "ha0b6c3cbg0e5fg4454gb24cgd1d618db1a45"
msgid "When all this is over, will you stay with me? For good?"
msgstr "이 모든 일이 끝나면, 나와 함께해 주겠는가? 영원히?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = f1898089-a327-5923-a566-fc817f4c52f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:f1898089-a327-5923-a566-fc817f4c52f9
msgctxt "he94cad56g28f2g4bcdga637g6bdcf0f1d89d"
msgid "I know what this is. You want to sever our bond."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = f22b4042-a63e-5984-57ef-32a1fd720c1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:f22b4042-a63e-5984-57ef-32a1fd720c1d
msgctxt "hf0ab8cc1g62e0g43b9ga80ag75556172bb83"
msgid ""
"The dawn was my torment. Rustling leaves, agony. I couldn't wait to escape "
"this place. Now, I revel in it. I revel in you."
msgstr ""
"새벽은 내게 고문이었다. 바스락거리는 나뭇잎들, 고통스러웠지. 얼른 이곳에서 벗어나기만을 기다렸다. 이젠 도리어 즐긴다. 너를 즐긴다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Lae'zel
#. NodeID = f5bf7ea5-b8ed-a072-7da6-836c9616aa95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:f5bf7ea5-b8ed-a072-7da6-836c9616aa95
msgctxt "h5234c1c9g89bbg4d8dgb50agb3fbcd6cebc3"
msgid ""
"I value you as a friend. As an ally. But my future lies only in the red and "
"the black."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB
#. Speaker = Player
#. NodeID = fe17efe1-7909-40a3-58e1-ae99d0bb64fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_Romance3_MorningIVB:fe17efe1-7909-40a3-58e1-ae99d0bb64fb
msgctxt "h4aae795cg0cf6g41a0g803ag211c072f8862"
msgid "Please, stay with me. I don't want you to go."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Player
#. NodeID = 053ae18d-ddb3-4238-b9df-c1eeac4d94db
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithLaezel(1) = True
#.     - CAMP_Laezel_Romance2_Event_LaezelDuelStart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:053ae18d-ddb3-4238-b9df-c1eeac4d94db
msgctxt "hc1ab618eg01bfg40d5gb770gaa1c5701033f"
msgid "Ha! Prepare yourself, and prove your worth to <i>me.</i>"
msgstr "하! 준비해, 네가 <i>나에게</i> 가치 있다는 걸 증명해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Player
#. NodeID = 0bf77f6f-0a0e-771b-cb52-ad093f766d7a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedLaezelInRomance2 = True
#.   Object:
#.     - ORI_State_Partnered(1) = False
#.     - ORI_State_DatingLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:0bf77f6f-0a0e-771b-cb52-ad093f766d7a
msgctxt "he3c6859bge280g465agb43bg774015e3a0f5"
msgid "Drop this obsession. We're allies, nothing more."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
#. NodeID = 1c196bc3-c768-49a8-a72a-8dc8d02622db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:1c196bc3-c768-49a8-a72a-8dc8d02622db
msgctxt "h5960eb1cg360dg4575g88f3g4d4643978095"
msgid "A fine sentiment. But I require more."
msgstr "멋진 생각이다. 하지만 부족하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Player
#. NodeID = 2b2a8772-c2c7-432b-82be-6d009b78370a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedLaezelInRomance2 = True
#.   Object:
#.     - ORI_State_Partnered(1) = False
#.     - ORI_State_DatingLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:2b2a8772-c2c7-432b-82be-6d009b78370a
msgctxt "h2cf9b731gf74dg4d65gbdeag8a6834c42e75"
msgid "Sorry, but no. This is too intense for my liking."
msgstr "미안하지만, 싫어. 내 취향에 이건 너무 강렬해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Player
#. NodeID = 2bc5fda2-6b28-3ee5-f762-806f81e7f830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:2bc5fda2-6b28-3ee5-f762-806f81e7f830
msgctxt "hdaeb078bgf3f7g451agb1a1g8bf1ce1f2abe"
msgid "Get the Hells out of here. I'm trying to sleep."
msgstr "저리 꺼져. 나 이제 잘 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
#. NodeID = 2bed2448-1b2a-0057-93e4-297eb001fac8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_RefusedVossInAct2 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:2bed2448-1b2a-0057-93e4-297eb001fac8
msgctxt "hbe731960gba59g4af8g9516g78ebc64a6c0c"
msgid ""
"A parasite grips my mind. <i>Kith'raki</i> betray their own queen. But I am "
"gnawed by an even greater torment."
msgstr "기생충이 내 정신을 사로잡고, <i>키스락</i>이 여왕을 배신했지. 하지만 나는 그보다 더 큰 고통에 갉아먹히고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
#. NodeID = 2e199a9e-a642-181a-761f-9c67ee8e7c4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:2e199a9e-a642-181a-761f-9c67ee8e7c4e
msgctxt "h45ecdd6cg7452g4097g998fgff0d36e52036"
msgid "So was I. But my blood runs too hot."
msgstr "나도 그러려고 했지. 하지만 내 피가 너무나도 끓어오르고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
#. NodeID = 2ed3a252-f5b4-4e0a-a8a4-fb018d303674
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel:2ed3a252-f5b4-4e0a-a8a4-fb018d303674
msgctxt "hd2e5d537g2d93g4a44g9819g5be7a5e36838"
msgid ""
"My thoughts are hallowed ground. Yet you've crawled your way in. "
"<i>Uninvited.</i>"
msgstr "내 생각은 성스러운 땅이다. 하지만 네가 기어들어왔지. <i>초대받지 않은 채로.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
