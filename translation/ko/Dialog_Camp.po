msgctxt "hdf5c0c47g1925g4b53gad45g71bade9c3f64"
msgid "I'd rather fight. Let's see who's worthy of whom."
msgstr "싸우는 게 낫겠네. 누가 누구에게 더 가치있는지 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Player
#. NodeID = e7e01475-0eb4-46d4-a139-71ad0c400e16
#. HandlePath = TaggedText[0].TagText[0]
