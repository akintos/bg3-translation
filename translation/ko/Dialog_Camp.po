#.     - LAEZEL_ORPHEUSPATH(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:58b189fe-a1e9-4d34-a2de-19c11753d1f6
msgctxt "hdfe371e5g8e8bg4cd1gaf43gb646423db3b6"
msgid "Vlaakith's led you astray. I believe him, and so should you."
msgstr "블라키스가 너를 그릇된 길로 이끌었어. 난 그를 믿어. 너도 그래야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 5b254b06-0b49-93f4-774f-3aa5df4ab6c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:5b254b06-0b49-93f4-774f-3aa5df4ab6c2
msgctxt "h6c960031g400bg42f5g9b4bg41d6d2639791"
msgid "Yes. Yes! I am Vlaakith's will!"
msgstr "그래. 그래! 내가 바로 블라키스 님의 의지다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 5f0c62d7-ada7-be3c-ac44-a956a7f78c0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:5f0c62d7-ada7-be3c-ac44-a956a7f78c0a
msgctxt "hb6c05ef4g0639g4c8cgab2dg45976bf9faa0"
msgid ""
"Keep the Astral Prism close. Let no one take it from you. Slay any who try."
msgstr "아스트랄 프리즘을 가까이에 둬라. 어떤 상황에서도 빼앗기지 않도록. 시도하는 자는 누구든지 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 66d3e666-a2b1-8fe5-0023-a8153918ca4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:66d3e666-a2b1-8fe5-0023-a8153918ca4c
msgctxt "hbe928a50gd79cg4debga66eg3e69d8d93c43"
msgid "Your choice is made. <i>Hta'zith!</i>"
msgstr "선택은 네 몫이다. <i>Hta'zith!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 680cbde7-cb9f-064d-c755-74215fc21138
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:680cbde7-cb9f-064d-c755-74215fc21138
msgctxt "h3ef8eb22g108dg45c4gab7dgb04498f6d3f2"
msgid "Your blade speaks for you, <i>kith'rak</i>. You've come for blood."
msgstr "네 검이 말하고 있다, <i>키스락</i>. 피를 흘리러 왔군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 68159f3d-c228-b577-4c7a-29c1c836a5e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:68159f3d-c228-b577-4c7a-29c1c836a5e1
msgctxt "h3f6bde75g2b7ag4365g86d6gcc4efe642f81"
msgid ""
"I served Vlaakith the whole of my life. Learned her words, fought her "
"battles, yet she names me <i>Hshar'lak</i>. Your words carry truth."
msgstr ""
"한평생 블라키스 님을 섬겨왔다. 그녀의 말을 배우고, 그녀의 전투를 치렀지. 그럼에도 그녀는 내게 <i>흐샬락</i>이라는 낙인을 "
"찍는구나. 네 말에는 진실이 담겨 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 68897bb0-8270-b721-7735-35428efaf429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:68897bb0-8270-b721-7735-35428efaf429
msgctxt "hf38cb207g9fcbg4138ga0bbge5ff031f54cd"
msgid "I know you carry the Astral Prism, Lae'zel."
msgstr "아스트랄 프리즘이 네게 있다는 걸 안다, 레이젤."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 689e10d2-308a-86be-be85-88bb7adac87c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:689e10d2-308a-86be-be85-88bb7adac87c
msgctxt "he19ab078g85aag4db6gae0egfee1e70be502"
msgid ""
"I served Vlaakith the whole of my life. Learned her words, fought her "
"battles. Yet your words carry truth."
msgstr "한평생 블라키스 님을 섬겨왔다. 그녀의 말을 배우고, 그녀의 전투를 치렀지. 그럼에도 네 말에는 진실이 담겨 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 6b1c9a07-ff33-7e99-9f1f-4f195da97b5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:6b1c9a07-ff33-7e99-9f1f-4f195da97b5d
msgctxt "h7ade005dg6e59g4f12gae51gc4230295cf13"
msgid ""
"The <i>zaith'isk</i> does not purify - it extracts memory and kills the "
"infected. Nor does the lich queen glorify the ascended. She feeds on most "
"all of them to grow her power and pursue godhood."
msgstr ""
"<i>제이트이스크</i>는 정화기가 아니다 - 그 장치는 감염자의 기억을 뽑아낸 뒤 죽이게 되어 있지. 승천자에 대한 리치 여왕의 "
"영광스러운 의식도 마찬가지다. 여왕은 자기 힘을 키우고 신격을 좇느라 그들 대부분을 포식한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 70c728e0-ebae-35d0-cc18-567eaa5616f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:70c728e0-ebae-35d0-cc18-567eaa5616f9
msgctxt "hfdd95134g95b8g4da4g9b13g53e3a01b45ee"
msgid "Vlaakith is my queen. Why would I want to end her?"
msgstr "블라키스께서는 내 여왕이시다. 왜 내가 여왕의 종말을 원하겠는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 7312df17-d175-84e1-0f2f-9b0fbe3f8f88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:7312df17-d175-84e1-0f2f-9b0fbe3f8f88
msgctxt "h9b993d4fg03b8g4667ga482g3c8a3b9cbcf7"
msgid "Your doubt does not make it any less true, child."
msgstr "의심한다고 진실함이 사라지지는 않는다, 아이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 7b9b871f-2a5f-cd81-ca3f-79dd64b62d72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:7b9b871f-2a5f-cd81-ca3f-79dd64b62d72
msgctxt "hf5bc393ag9020g4245g8f78g117f0457c2b3"
msgid "Speak. My ear is yours."
msgstr "말해라. 듣고 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = GROUP_Daisy
#. NodeID = 7bfdf670-25b8-4b29-908f-54abb35fa4f7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:7bfdf670-25b8-4b29-908f-54abb35fa4f7
msgctxt "hc9f54f1agdc84g4780g9b2bg330191b507b6"
msgid "Don't trust him."
msgstr "놈을 믿지 마십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = GROUP_Daisy
#. NodeID = 7bfdf670-25b8-4b29-908f-54abb35fa4f7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:7bfdf670-25b8-4b29-908f-54abb35fa4f7
msgctxt "h3087a2c3g5b30g4536gb276gd7afe1b2c258"
msgid "Don't trust him."
msgstr "놈을 믿지 말아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 7cd2f97f-ee46-524d-4aac-c227a227ea64
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:7cd2f97f-ee46-524d-4aac-c227a227ea64
msgctxt "h22dc4d55g9eccg45ebga97ag6585088078f9"
msgid ""
"Bring the Prism to Baldur's Gate. I'll be waiting in a taproom called "
"Sharess' Caress. That is where we decide the fate of our people."
msgstr ""
"프리즘을 발더스 게이트로 가져가라. 샤레스의 애무라 불리는 술집에서 기다리겠다. 바로 그곳이 우리 백성들의 운명이 결정될 장소다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 7cd2f97f-ee46-524d-4aac-c227a227ea64
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:7cd2f97f-ee46-524d-4aac-c227a227ea64
msgctxt "hb66ece07gec8cg4b44g846ega6d86f78463c"
msgid ""
"Bring the Prism to Baldur's Gate. I'll be waiting in a taproom called "
"Sharess' Caress. That is where we decide the fate of my people."
msgstr ""
"프리즘을 발더스 게이트로 가져가라. 샤레스의 애무라 불리는 술집에서 기다리겠다. 바로 그곳이 우리 백성들의 운명이 결정될 장소다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 80094362-9fdb-377b-170d-4b67df8f373f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:80094362-9fdb-377b-170d-4b67df8f373f
msgctxt "h91b00b42g6a7fg4081g8777g46500f8cb682"
msgid ""
"All that remains is the key that unchains them - and I've found someone who "
"I believe can provide it."
msgstr "이제 남은 건 구속을 풀어줄 열쇠뿐이다 - 그리고 나는 어쩌면 그 열쇠를 내어 줄 수 있는 인물을 하나 알고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 89bf74a7-943a-9a1c-277d-46c7e296f712
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:89bf74a7-943a-9a1c-277d-46c7e296f712
msgctxt "h02f66704g2a25g4585ga15fg9e492075c08c"
msgid "Now - to Baldur's Gate. I'll be waiting, Lae'zel."
msgstr "자 - 그럼 발더스 게이트에서 만나지. 기다리고 있겠다, 레이젤."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 8e8d685e-a700-0ed0-8cbc-17e19279ee0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = True
#.      - GLO_GithChokepoint_Quest_GithLeave = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:8e8d685e-a700-0ed0-8cbc-17e19279ee0c
msgctxt "hc923b15ag0d77g447eg8a9egeecc73a2e6f6"
msgid "Your cronies tried to kill us. Why should Lae'zel listen to you?"
msgstr "네 친구들이 우릴 죽이려 했다. 왜 레이젤이 네 말을 들어야 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 909be629-7011-c49b-42a2-8108a2ee8a9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:909be629-7011-c49b-42a2-8108a2ee8a9a
msgctxt "h4d52939fgd758g40a6gbb23gcabb61e52b14"
msgid "No. I don't believe it."
msgstr "아니, 안 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 94bc4422-b0c5-7149-84fa-46f37b102e8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:94bc4422-b0c5-7149-84fa-46f37b102e8a
msgctxt "h2f7c9953g489cg4fa5g84d4g5113df55b992"
msgid "I've not come to kill you, Lae'zel. I've come to aid you."
msgstr "난 널 죽이러 온 게 아니다, 레이젤. 도우러 왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 98b54282-1f6a-002b-ddbf-7f00e595ab15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:98b54282-1f6a-002b-ddbf-7f00e595ab15
msgctxt "h7797e623g118eg4971g98a9g340cbfb14b74"
msgid "A fool stumbles without cause. A hero serves a cause without question."
msgstr "바보는 이유 없이 넘어진다. 영웅은 질문 없이 이유를 받들지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 990343f9-8846-b2f9-40b8-7ddbcb3044ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:990343f9-8846-b2f9-40b8-7ddbcb3044ef
msgctxt "h8b3cff40g3b92g49aeg93b2g1b5f13958d06"
msgid "Fine. We'll hear what you have to say before we gut you."
msgstr "좋아. 내장을 갈라 주기 전에 하고 싶은 말이나 들어 보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 99dc4f6e-e3f9-f255-b7c9-03655f3c6b70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:99dc4f6e-e3f9-f255-b7c9-03655f3c6b70
msgctxt "h810964f0g4f5fg4382g85d7g7cb237c9bdc6"
msgid ""
"The queen's warriors hunt you. The <i>qua'nith</i> will sound out when you "
"come near their portals. Hear its cry, and prepare for battle - or slip away."
msgstr ""
"여왕의 전사들이 너희를 뒤쫓을 것이다. 그들의 차원문 가까이 다가가면 <i>콰니스</i>가 소리를 낼 것이다. 울음소리가 들리면, 전투를 "
"준비하거나 몰래 빠져나가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 9fa81376-b1c1-68ff-bb4c-d3e7337735bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:9fa81376-b1c1-68ff-bb4c-d3e7337735bc
msgctxt "h220bf0b4gb9a4g465eg8789gbf5f01a14b41"
msgid ""
"I've sought their freedom for aeons. When the Prism went missing, I feared "
"the worst."
msgstr "나는 영겁의 세월 동안 그들을 해방시킬 방법을 찾아 헤맸다. 프리즘이 사라졌을 때는, 최악의 상황까지 우려했었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = a1ef7807-9b22-fd3f-75de-ccae83041f44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:a1ef7807-9b22-fd3f-75de-ccae83041f44
msgctxt "h1b2b2785gd9d5g4befg9e0bgb8e2c76e470f"
msgid ""
"Vlaakith's demise? <i>Shka'keth</i>. I should run you through for suggesting "
"it."
msgstr "블라키스 님의 폐위라고? <i>쉬카케쓰</i>. 그런 제안을 입에 올렸다는 사실만으로 나는 너를 베어 넘겨야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = a4fd47be-97eb-9647-a6ee-0aa17b252f70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:a4fd47be-97eb-9647-a6ee-0aa17b252f70
msgctxt "h32ab2c7fg6fcdg4775ga9beg25ad44eb4ea2"
msgid ""
"Such informality, child. Does <i>Jhe'stil Kith'rak</i> not command your "
"respect?"
msgstr "예의가 없구나, 아이야. 제스틸 키스락이 존중을 명하지 않더냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = a5c17f0b-aa76-e7ba-0369-3d8e65ce62e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:a5c17f0b-aa76-e7ba-0369-3d8e65ce62e8
msgctxt "h3bd44530ge4f9g45a3g9c35g14a87b5c3e08"
msgid "Lies, Lae'zel - every last one. There is no purification, no ascension."
msgstr "거짓말이야, 레이젤. 전부 다. 정화도, 승천도 모두 지어낸 말일 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = a8a0c49c-c68a-3d2a-e502-ed05004464a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:a8a0c49c-c68a-3d2a-e502-ed05004464a5
msgctxt "h43ec96edg83e2g4405ga44fg96db2ec67095"
msgid ""
"That very power will be the end of Vlaakith's tyranny. The Prism's tenant "
"must be let loose."
msgstr "바로 그 힘이 블라키스의 폭정을 종식시킬 것이다. 프리즘의 거주자는 반드시 풀려나야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = a9cfe412-908b-9644-d067-77b5caa853fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:a9cfe412-908b-9644-d067-77b5caa853fa
msgctxt "h1d1a8c49g483fg4c07gaf6dg200d112a7f5a"
msgid ""
"Lae'zel - together we will break our chains, and be Vlaakith's slaves no "
"longer."
msgstr "레이젤 - 우리는 함께 구속을 깨고, 더는 블라키스의 노예가 되지 않을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = b1de4699-3381-9b13-c01b-da3b2fff5e22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:b1de4699-3381-9b13-c01b-da3b2fff5e22
msgctxt "he131c946g4fbag4236g801bgb587bd3269fe"
msgid ""
"<i>Ska'kek kir Gith shabell'eth. </i>My blade rests. Mother Gith compels you "
"to listen."
msgstr "<i>스카케크 키르 기스 샤벨레쓰.</i> 내 검을 내려놓으마. 어머니 기스께서 네게 경청을 종용하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = b9fea05f-31e3-6940-4c35-09759b52581a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = True
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_MetVossInAct2 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:b9fea05f-31e3-6940-4c35-09759b52581a
msgctxt "h3788a256gdb02g4a26g9d42g2b1aeeeb7d05"
msgid "Supreme Kith'rak. Has Vlaakith sent you to slay me with your own blade?"
msgstr "최고 사령관 키스락. 블라키스께서 네 은검으로 나를 죽이라고 분부하셨나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = ba564302-05e9-42f3-abd2-c05b0bd50738
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVossInAct2 = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(5) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:ba564302-05e9-42f3-abd2-c05b0bd50738
msgctxt "h0ebcc264gbb07g4835g9848gc160f04b96fc"
msgid "Kill him. This is our chance to earn Vlaakith's redemption."
msgstr "놈을 죽여라. 블라키스 님의 구원을 얻을 수 있는 기회다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = ba564302-05e9-42f3-abd2-c05b0bd50738
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVossInAct2 = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:ba564302-05e9-42f3-abd2-c05b0bd50738
msgctxt "h2baabf88g89e1g4f87gb654gd02549452023"
msgid "Kill him. This is your chance to earn Vlaakith's redemption."
msgstr "놈을 죽여. 블라키스의 구원을 얻을 수 있는 기회야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = be91cfa4-5019-ffa6-133d-0c8f504ae52f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:be91cfa4-5019-ffa6-133d-0c8f504ae52f
msgctxt "h385eca66gd595g47edgb387g828a8f0b2437"
msgid ""
"I knew you would fight - and I knew you would win. I needed to ensure "
"Vlaakith's trust. This was the only way."
msgstr "네가 싸울 것도, 이길 것도 알고 있었다. 난 블라키스의 신뢰를 얻어야 했어. 방법은 이것뿐이었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = bf38323f-9a8a-33bf-8ca9-fdabbbb2f661
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:bf38323f-9a8a-33bf-8ca9-fdabbbb2f661
msgctxt "ha067476ag73c9g4885gbd04g971e3aea6cda"
msgid "The Prism's tenant alone has the power to end Vlaakith's tyranny."
msgstr "프리즘의 거주자만이 블라키스의 폭정에 마침표를 찍을 수 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = bff1969e-6b8a-d3d0-f00e-8d3e365741d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:bff1969e-6b8a-d3d0-f00e-8d3e365741d7
msgctxt "h13cda128g2829g49abgbbfdg94b7cf009308"
msgid "I'm asking for your help - and your trust."
msgstr "나는 단지 협력과 신뢰를 구하려는 것뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = c78be044-fd17-9d5c-9b65-6e3227f36fa4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:c78be044-fd17-9d5c-9b65-6e3227f36fa4
msgctxt "hb95acb9egbf1eg42d3g961eg0016378ecb70"
msgid ""
"I've heard word from Crèche Y'llek. You are infected - yet the one in the "
"Prism has chosen you, protects you with their power."
msgstr "일레크 양성소에서 전언을 들었다. 네가 감염되었다더군. 그러나 프리즘 내부의 존재가 너를 택했고, 보호하고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = c7a037ad-b368-18dd-3bac-e66c01cf4acf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:c7a037ad-b368-18dd-3bac-e66c01cf4acf
msgctxt "hfa87a7e8g03f4g4922g8ae6gacaf9fd3fd06"
msgid "Because I know who you are, and I know about the Astral Prism."
msgstr "난 네가 누군지 알고, 아스트랄 프리즘에 대해서도 알기 때문이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = cb172690-b2cc-1124-7cde-6bbdb79d99ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:cb172690-b2cc-1124-7cde-6bbdb79d99ed
msgctxt "h6b0c54bdgf4a3g475cgae61g9574f373cf2e"
msgid ""
"I am neither. 'Clear of heart, clear of mind, and bound by no master.' Now - "
"you must listen."
msgstr "난 어느 쪽도 아니다. '마음을 비우고, 정신을 비우고, 어느 주인에게도 얽매이지 않았으니.' 이제, 내 말을 들어야만 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = e29bccad-e907-99ce-a0e3-62d638e4f40f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:e29bccad-e907-99ce-a0e3-62d638e4f40f
msgctxt "hd121fedfg507cg4edcgaea6g6cfa3acd3715"
msgid "It is not."
msgstr "그럴 필요 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = ea275df0-1464-2a08-cca8-377274c37c11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:ea275df0-1464-2a08-cca8-377274c37c11
msgctxt "he3a9f38bg7307g45b4gadfdg57aa18d71920"
msgid ""
"Lae'zel. I see <i>T'lak'ma Ghir</i> in you - Sister in Freedom. Together, we "
"will be our people's light."
msgstr "레이젤. 네 안에서 <i>티라크마 기르</i>, 자유의 자매가 보이는구나. 함께라면, 우리는 백성들의 등불이 되리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = ee29250b-7eb9-ba47-a1ca-f62e018a164e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - Camp_VossConfrontation_Event_VossToldTruth = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:ee29250b-7eb9-ba47-a1ca-f62e018a164e
msgctxt "h9dea3301ga05dg4badgbb11gfdcc553c62d3"
msgid "I... I will hear no more of it."
msgstr "더는... 더는 듣지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = efc1fad6-dc1a-7228-e005-35699fd2d4a4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:efc1fad6-dc1a-7228-e005-35699fd2d4a4
msgctxt "h6adaefabgb096g466eg9fc0gbb658253dcc9"
msgid "<i>Shabell'eth.</i> I will listen, as is my duty."
msgstr "<i>샤벨레쓰.</i> 듣겠다, 의무이므로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = efc1fad6-dc1a-7228-e005-35699fd2d4a4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:efc1fad6-dc1a-7228-e005-35699fd2d4a4
msgctxt "he9ee6ac1gfa0bg4cd0ga558g795f3e658222"
msgid "Go on then. Speak."
msgstr "그럼 계속해. 말해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = f16dbd5b-3baf-c458-faa5-b97756b950f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - a852d987-a394-8158-5d83-4170c6f92207_Prisoner = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:f16dbd5b-3baf-c458-faa5-b97756b950f3
msgctxt "h0bc528c5g874eg480eg8c26g5a5d9fe1e4d4"
msgid "Are you talking about the person inside? Do you know who that is?"
msgstr "프리즘 내부의 인물 말인가? 그가 누구인지 알고 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = f306cb78-b524-da46-9171-04d8feb3d0b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:f306cb78-b524-da46-9171-04d8feb3d0b2
msgctxt "h06593354g27c2g4f65g8dc7g31d0143394b6"
msgid "I've not come to kill you, Lae'zel. I've come to aid you."
msgstr "난 널 죽이러 온 게 아니다, 레이젤. 도우러 왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = f5b72dde-1d6f-6b7c-9a02-4904d6ef9d13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:f5b72dde-1d6f-6b7c-9a02-4904d6ef9d13
msgctxt "h9ee9b722ga551g4ff1gaf02g01915b29bb66"
msgid ""
"Within it lies the seed of Vlaakith's demise. And I intend to help you bring "
"it to fruition."
msgstr "그 안에는 블라키스의 폐위를 앞당길 씨앗이 자라고 있다. 그리고 나는 네가 그 결실을 맺도록 도울 생각이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = fb6a41e6-f897-1e2b-cdce-03df9d381e4e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI and REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:fb6a41e6-f897-1e2b-cdce-03df9d381e4e
msgctxt "h5c685e09g77f6g484aga1feg9191744bcac7"
msgid ""
"A <i>kith'rak</i> resists the Undying Queen? That either makes you a fool - "
"or a hero."
msgstr "<i>키스락</i>이 불멸의 여왕에 대항한다고? 바보 같은 이야기야. 아니면 영웅이든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = fb6a41e6-f897-1e2b-cdce-03df9d381e4e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:fb6a41e6-f897-1e2b-cdce-03df9d381e4e
msgctxt "he5887286g1830g45f9ga6b3g9b3d828823f5"
msgid "You must be either a fool or a hero to work against your own queen."
msgstr "네 여왕에게 저항하다니 바보 아니면 영웅 둘 중 하나겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = fd8fc8c9-00e6-7332-8c12-4a58cc332d59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a852d987-a394-8158-5d83-4170c6f92207_Prisoner = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:fd8fc8c9-00e6-7332-8c12-4a58cc332d59
msgctxt "h025372f4ge913g4ef0gbdf3g2aff9901bfe5"
msgid "Who is the person inside the Prism?"
msgstr "프리즘 안에 있는 인물은 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 0035e6ba-b35c-31ed-0fa8-4d8b332b46ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:0035e6ba-b35c-31ed-0fa8-4d8b332b46ec
msgctxt "h551194a0g1be1g4648g950agd3a2652be0ff"
msgid ""
"We were the first to discover the cult. And if you had only waited, we might "
"have marshalled our numbers and -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = 029248d3-b292-6c25-cf88-a47c2039ff42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:029248d3-b292-6c25-cf88-a47c2039ff42
msgctxt "hb82be0a8g09c5g4456g8809g32463a43a372"
msgid ""
"I don't care what you call yourselves. I just need you both focused on the "
"fight ahead."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 05492ec2-bbb5-1fe4-1f67-b8d492bc4f4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:05492ec2-bbb5-1fe4-1f67-b8d492bc4f4d
msgctxt "hcaf5e5bdgdd1bg4e88gaf88g7be8c8c039b6"
msgid ""
"You know better than to believe our victory is some destined thing. I need "
"to be sure that Minsc knows it, too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 06f4ad9f-4588-4348-b999-fc5c5865db92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:06f4ad9f-4588-4348-b999-fc5c5865db92
msgctxt "hfd5c9d8cg946eg41c4g80ffg4dfed5203a73"
msgid ""
"I have seen too much to believe destiny has taken our side. Blind luck, "
"perhaps. The point remains."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 076b5f84-8004-56c7-23b5-0104c0ca5142
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:076b5f84-8004-56c7-23b5-0104c0ca5142
msgctxt "h3586b3fage2e8g4f79g807fga65be319d067"
msgid ""
"<i>Wychlaran</i>...? Minsc, I am <i>not</i> your witch. You are not my "
"bodyguard. This is not some high lodge of your homeland."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 0b9bfacc-e887-d10a-5472-9cba5144443b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:0b9bfacc-e887-d10a-5472-9cba5144443b
msgctxt "h041bdd24g0762g49b6gb95ag394a9bb12770"
msgid ""
"Hah! Not without a companion, I'm afraid. Boo will ask some of his sewer-"
"dwelling friends!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = 0d165449-3136-fd7f-0abc-d158c2266b5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:0d165449-3136-fd7f-0abc-d158c2266b5c
msgctxt "hd15db693g8edbg4c83g95edg26002533eeb9"
msgid "So what you're saying is you've learned absolutely <i>nothing.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 16419e40-9add-4e9c-9fad-2fb6aa305161
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:16419e40-9add-4e9c-9fad-2fb6aa305161
msgctxt "h21794ec1g7412g447dga29dg735a5fe78844"
msgid ""
"Jaheira does as <i>Jaheira</i> does, and finds a way to save us all anyway."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Narrator
#. NodeID = 1849aa49-c35a-95d4-5571-e964f74c74f0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Minsc_Knows_Wychlaran = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:1849aa49-c35a-95d4-5571-e964f74c74f0
msgctxt "hfcc144dfg9a65g4241g8921ge82dd87ea37d"
msgid ""
"*The <i>Wychlaran</i>: wise women of Rashemen, each bonded to a berserker "
"bodyguard for life. There is no higher title, nor deeper bond, in all of "
"Rashemaar custom.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 1e3c834f-d01a-8064-f50f-2d2465b594ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:1e3c834f-d01a-8064-f50f-2d2465b594ff
msgctxt "h82c47aebg097dg4de5g9d81gb9e56095e13b"
msgid ""
"The titles matter not. Only this - when Minsc does as Minsc does, and "
"charges in to make a mess:"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = 1ed9d225-e33f-f7bf-ddc9-d30df731e403
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:1ed9d225-e33f-f7bf-ddc9-d30df731e403
msgctxt "h6c188dafg5d60g4c38gb190g17aa3a70c788"
msgid ""
"Speaking of feelings - does Minsc know you were ready to kill the Emperor "
"for him?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 1f3de401-4568-e04a-9f45-e342a509f863
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:1f3de401-4568-e04a-9f45-e342a509f863
msgctxt "h60d69684gf3a6g4fe4g905fg458e01bd1df1"
msgid ""
"<i>Good</i> does not wait for <i>evil</i> to button up its britches - when "
"it offers buttocks for the smacking, Minsc and Boo greet cheek with hand!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 20927e5a-2a85-a300-667b-a151e2f6c3f4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MinscJaheiraReunion_PlayerWitnessed = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:20927e5a-2a85-a300-667b-a151e2f6c3f4
msgctxt "h89227f9fgb582g4e16gbf9dgdc6d3590c693"
msgid ""
"Jaheira... Boo is trying his best to explain, but I still do not understand "
"your anger."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 24d442fb-29ea-c41b-1ceb-0a6f82954337
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:24d442fb-29ea-c41b-1ceb-0a6f82954337
msgctxt "h48290a1cg274eg44e5g8827ga55aa10c9af5"
msgid "I would like to see if a lesson has been learned."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 3321ec3c-297e-4636-584d-7a9e8375e764
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:3321ec3c-297e-4636-584d-7a9e8375e764
msgctxt "hceec525ag124dg4e4agab16g81c17376793e"
msgid ""
"...I missed him, too. And try as you might, I know you have not missed my "
"point as neatly as you pretend."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 34f9407e-ef11-ecb9-60e5-7a8061d85fe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:34f9407e-ef11-ecb9-60e5-7a8061d85fe4
msgctxt "h41a88384g2f3bg4b01g8daag43a30a3026b3"
msgid "But... this is where Minsc falls short of the understanding, Jaheira. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 35667ef5-5bed-1292-2464-fab172fe7c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:35667ef5-5bed-1292-2464-fab172fe7c95
msgctxt "h6a704866gd083g4082gbb93g6792d4e427ea"
msgid ""
"A sad and desperate bluff. I need to be sure that Minsc understands I cannot "
"make such a threat <i>twice.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 3a4e022a-a24c-245b-3b02-a5911149fd51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:3a4e022a-a24c-245b-3b02-a5911149fd51
msgctxt "h0ee3b661gde49g4e6dg9747g3bd8e301567e"
msgid ""
"You mean the doppelgangers? It is no comfort to me that my face made this "
"fool all the easier to lead. The point remains."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 3ab0f859-207d-fe81-fc40-afecac3aa60f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:3ab0f859-207d-fe81-fc40-afecac3aa60f
msgctxt "hc9491a94g3bb1g40f0g9371gff89068cc5a5"
msgid "On that point, I am still to be convinced."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = 50f8147d-2ebf-44c8-a5c2-bf5c9f2bb44d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:50f8147d-2ebf-44c8-a5c2-bf5c9f2bb44d
msgctxt "hdad336daga6d0g4d7ag8dc4gd067db2b1589"
msgid ""
"She's right, Minsc. I need to know you'll follow orders from here on out."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 51d8b994-494e-3d06-bd1e-d1febe23113b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:51d8b994-494e-3d06-bd1e-d1febe23113b
msgctxt "hfdaf85f1gbca5g4a87g97a2gb7ba243c23f5"
msgid "Not even for Boo?!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 5427db37-5e59-61ab-fd27-affa62324cb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:5427db37-5e59-61ab-fd27-affa62324cb5
msgctxt "he787455dgf926g4263gae99g5c1a98101def"
msgid ""
"Do not hide behind your hamster, ranger. You do not understand, because you "
"do not <i>listen.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 5d211855-5817-3369-1a7a-fa58f9a6d348
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:5d211855-5817-3369-1a7a-fa58f9a6d348
msgctxt "he76f5c44g5570g4467gbc16g6308ba60fe67"
msgid ""
"This mess falls on <i>our</i> heads, Minsc. The city under siege - its "
"people poisoned by the cult - it all might have been avoided if you had just "
"put your feelings aside and <i>listened.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 6a7d673a-3690-95c1-3364-d4b885248a03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:6a7d673a-3690-95c1-3364-d4b885248a03
msgctxt "hc72fa02egd783g474ag9f59ga2553be67189"
msgid ""
"You meant well, Minsc. But you exposed the city to harm. You helped the cult "
"spread. And worse, perhaps, than any of this:"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 6a8fd2a8-2fc5-5548-3be3-ef220581932f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MinscJaheiraReunion_CFM_MinscMentionedWychlaran = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:6a8fd2a8-2fc5-5548-3be3-ef220581932f
msgctxt "hdbae5df0gecc5g4127gbd16g63a235c60f48"
msgid ""
"What else is a berserker for, if not to charge into danger ahead of his "
"<i>Wychlaran</i>?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 708230c1-eacc-1670-9a98-e621ba3c0b74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:708230c1-eacc-1670-9a98-e621ba3c0b74
msgctxt "h9221a395g3c7fg44d2g852dgc7af975dce87"
msgid ""
"Boo agrees, you are a queer <i>kind</i> of witch. But this city is a queer "
"place. And Minsc, you may have noticed, is sometimes strange himself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = 74305024-3ce6-6b50-f1ea-74768a0c082c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:74305024-3ce6-6b50-f1ea-74768a0c082c
msgctxt "heaa28fccg7b3fg444agbfc9gf255162e3eb9"
msgid "Enough. What's this about?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = 873f74c2-76ee-3e53-ba46-dc36e48b3870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:873f74c2-76ee-3e53-ba46-dc36e48b3870
msgctxt "h9d79a0a1gbf90g428ega511gfeb7cfb4cb2d"
msgid "...My own foolishness does not absolve Minsc of his."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = 90d3de63-9f04-03ef-1b9c-1e36cb0f1d56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:90d3de63-9f04-03ef-1b9c-1e36cb0f1d56
msgctxt "h3679b8c1g250ag40c8gb461g9d3af5a1e923"
msgid ""
"I have already pledged my sword and hamster both. What more does Minsc have "
"to give?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = 940de94c-57d3-3f64-50b0-934d28e419f3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:940de94c-57d3-3f64-50b0-934d28e419f3
msgctxt "ha30d9e9bgb760g4144g9782g4bf5c68e3047"
msgid ""
"Or the trail would have ended there, instead of leading you to Ketheric. The "
"Prism. Me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = 9b149b05-dff5-1bee-b9b9-86778e899051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:9b149b05-dff5-1bee-b9b9-86778e899051
msgctxt "he34dccedg4b15g4e05gb0f8g9f7c6b74b2c9"
msgid "That sounds like a fun evening."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = ad7274cc-62f7-98d9-ef26-45a512811269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:ad7274cc-62f7-98d9-ef26-45a512811269
msgctxt "hb36b3509g327ag4433gaccagee6f08c60605"
msgid ""
"I am your <i>friend</i>, ranger, I am not your witch. There will be no "
"ointments, or healing balms."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = ae3faf73-b9a3-6b59-f459-c90fa4749f19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:ae3faf73-b9a3-6b59-f459-c90fa4749f19
msgctxt "hc9dba50cge4e5g46c6g936bgeacfbac748a5"
msgid ""
"Your <i>word</i>, ranger - that next time, you will stop and <i>think.</i> I "
"will not always be here to tell you what to do."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = b01506b2-ac5c-47f2-a26f-d9c6acca62b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:b01506b2-ac5c-47f2-a26f-d9c6acca62b4
msgctxt "h6205f28aga7b3g4b7dg8f70g6a61eaf2d35e"
msgid "It is well that Boo's innocent ears still ring from all this shouting."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = b1d193c9-a5e1-0072-2b1d-b3f83a03700a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:b1d193c9-a5e1-0072-2b1d-b3f83a03700a
msgctxt "h274e51d8gbc2dg4a23g83bbg88e9d4de4f1e"
msgid "Aw. That's actually kind of sweet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = c552b498-8468-d596-8a80-db33cccd615f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:c552b498-8468-d596-8a80-db33cccd615f
msgctxt "h8bee07b1g0fbag4337gb824gf083e91d6ad0"
msgid ""
"If not here, then where? Wherever <i>there</i> is, Minsc and Boo will go "
"too! My hamster... he would not be parted from you again, Jaheira."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = cbdab6b0-d3a6-2919-ca22-aecd78dfbba6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:cbdab6b0-d3a6-2919-ca22-aecd78dfbba6
msgctxt "ha80bba01gb476g4711gb55agd9cda33df04a"
msgid "...I fight alongside fools."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = d2e053d7-2b32-3a7a-ebd6-b730283c79fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:d2e053d7-2b32-3a7a-ebd6-b730283c79fb
msgctxt "h0ba11814gedceg43c1g9ebbg2e6e36b7d678"
msgid "You forced me to leave you behind."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = d4894401-1805-d71b-30e9-aa831b8fc032
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:d4894401-1805-d71b-30e9-aa831b8fc032
msgctxt "ha15a869fg131fg44ccgb415gac0ddb5ec635"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = d97b0dda-a5b4-63ad-1d63-d7f74580a43e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:d97b0dda-a5b4-63ad-1d63-d7f74580a43e
msgctxt "h2c37c47fg65adg431dgb8e1gc338de8f3757"
msgid "You are the <i>only</i> one Minsc listens to - remember?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = db71db49-78a4-1a2a-a98c-923ad99b330c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:db71db49-78a4-1a2a-a98c-923ad99b330c
msgctxt "h354cda49gc178g4e75g87f1gc8ed2f5e8bce"
msgid "Well, at least you're getting to know him a little better."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Player
#. NodeID = e1bb3c3f-38ca-e440-d939-29adac1f249b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:e1bb3c3f-38ca-e440-d939-29adac1f249b
msgctxt "h4cb08453g31f7g44a2ga7a4gdeacf41b47dc"
msgid "I suppose there is some twisted logic at play there."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Jaheira
#. NodeID = e304d078-93e2-2aed-1014-4472e6ef98f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:e304d078-93e2-2aed-1014-4472e6ef98f9
msgctxt "hb92dcc96g768fg4a78g8aa2g2e1da70c4352"
msgid "<i>Is</i> there? Wonderful. Another Minsc in the making. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM
#. Speaker = Minsc
#. NodeID = f67deabf-ceb2-e42e-b6f6-6520c01653e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MinscJaheiraReunion_CFM:f67deabf-ceb2-e42e-b6f6-6520c01653e1
msgctxt "h123eed5eg8c41g4d2eg8fdcga830cc50df97"
msgid "You hear that, Boo? We fight alongside a <i>Wychlaran</i> again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 0539540f-4afd-98f4-33bc-ada267e17e29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:0539540f-4afd-98f4-33bc-ada267e17e29
msgctxt "h26c3e2ecg37c7g4096g8bafg2365fee9881d"
msgid "Jealous?"
msgstr "질투나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 05d6a2fe-d675-ea8d-19fa-305414e7002d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:05d6a2fe-d675-ea8d-19fa-305414e7002d
msgctxt "h70afc990g5ba6g4cbdga168ga4cdc636ac6f"
msgid "Please, stay with me. No more dalliances - I only want you."
msgstr "부탁이야, 가지 마. 다른 사람은 필요 없어. 난 당신만 있으면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 07c67c13-5554-a6e4-4ac7-5f6ba551a0f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:07c67c13-5554-a6e4-4ac7-5f6ba551a0f0
msgctxt "h92cab5f0gb6d5g4342g93edg195b2d712e72"
msgid "Listen, Karlach. She manipulated me into it. It meant nothing, I swear."
msgstr "들어 봐, 칼라크. 저 여자가 끌어들인 거야. 하면서도 아무 느낌 안 났어. 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 0a2e0d8b-ab8d-33ff-c5f2-6b2cc85b7234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:0a2e0d8b-ab8d-33ff-c5f2-6b2cc85b7234
msgctxt "h17a6c6a6g70a7g4d43gbbb2g17fc4eb8efe5"
msgid "Listen, Lae'zel. She manipulated me into it. It meant nothing, I swear."
msgstr "레이젤, 들어 봐. 저 여자가 나 끌어들인 거야. 하면서도 아무 느낌 안 났어, 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 0b8514a3-1771-4e50-a1ae-7cdd24691d4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithAstarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:0b8514a3-1771-4e50-a1ae-7cdd24691d4e
msgctxt "hd443f603g8b26g46bcg8dbag68ff48090fba"
msgid "Well. I hope I'm not interrupting."
msgstr "이런. 내가 방해한 거 아닌가 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 0ca5d8a9-ddeb-6d34-901c-109e1e2f8e9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:0ca5d8a9-ddeb-6d34-901c-109e1e2f8e9b
msgctxt "ha19705f9g6b64g44a9gab12g60a6d4c006cc"
msgid ""
"I thought we shared something special, I truly did. Clearly I'm nothing but "
"a smitten fool..."
msgstr "난 우리가 특별한 뭔가를 나눈 사이라고 생각했어. 진심으로. 근데 그냥 내가 멍청이였던 것 같네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 0cb6817b-98dc-f35a-c0c1-fd0b0b399046
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:0cb6817b-98dc-f35a-c0c1-fd0b0b399046
msgctxt "hfa7e65d1g6100g45d5gb9bdg14fabced20a3"
msgid "<i>Zhak vo'n'ash duj</i>. Source of my bruises."
msgstr "<i>쟈크 보 나쉬 두.</i> 넌 내 상처의 근원이 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = 0cf135dd-fd6b-0e26-d6c7-6f5042a7bc75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:0cf135dd-fd6b-0e26-d6c7-6f5042a7bc75
msgctxt "ha4bb57f5g30eeg4f04gaa79g6c326cf13940"
msgid ""
"An intriguing prospect, for sure... but I'm glad you've shown yourself to be "
"comfortable in exploring without me. Sharing is important, but some things "
"should be just for you."
msgstr ""
"정말 흥미로운 가능성이군...어쨌든 내가 없는 모험에서도 편안해하는 모습을 보니 기쁘오. 공유하는 것도 중요하지만, 어떤 것들은 홀로 "
"간직해야 하는 법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = 102745f8-09b4-14ef-cabd-25bb0f141ac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:102745f8-09b4-14ef-cabd-25bb0f141ac8
msgctxt "hf87d9a8dg98b3g46f2ga027g9a14da0d28c7"
msgid ""
"Worry not - I asked for freedom to follow my heart, and of course I offer it "
"in return. There is so much to enjoy amidst nature's bounty - why squander "
"what time we have on jealousy?"
msgstr ""
"염려 마시오. 난 내 마음을 따라 자유를 추구했으니, 그 대가도 감당해야지. 자연의 풍요로움 속에서 즐길 것이 얼마나 많은데, 어찌 질투 "
"따위로 시간을 낭비하겠소?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 10b2e66b-fd97-6496-16f6-0c1f99361847
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:10b2e66b-fd97-6496-16f6-0c1f99361847
msgctxt "he6a75784ga14dg47f0gbb83g9b93d235a6ee"
msgid "Nothing good, from the sounds of it."
msgstr "네 말투 보니까, 잘한 짓은 아닌 거 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 10d1f27c-de37-b9ac-78bc-7e804ff92b31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:10d1f27c-de37-b9ac-78bc-7e804ff92b31
msgctxt "hca1437f7gadb3g4a89gad76gc184169cddbe"
msgid "So that's it, then? No more 'us'?"
msgstr "그럼 헤어지는 건가? '우리' 끝난 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 1111cc1a-32ad-2fea-6e1e-13d2c1ba5f1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:1111cc1a-32ad-2fea-6e1e-13d2c1ba5f1f
msgctxt "h01a0d6a7ge5c9g4353gaa85gcea4c1566f00"
msgid "No, of course she didn't. Why would I want anyone but you...?"
msgstr "아니, 당연히 아니지. 내가 왜 너 말고 다른 사람을 원하겠어...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 111fef9f-0b4f-4d92-4ac1-cbe3eb0d2edd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:111fef9f-0b4f-4d92-4ac1-cbe3eb0d2edd
msgctxt "h1b1852cbg734bg4805ga26age36f66d923b8"
msgid "It's not what you think, I swear."
msgstr "당신이 생각하는 그런 게 아냐. 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 113c68d2-f823-5695-1174-ad205979b586
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllEternalPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:113c68d2-f823-5695-1174-ad205979b586
msgctxt "haf4509c1g6604g430dgb414ga9da47c64efc"
msgid ""
"You shared your body with the fiend who holds my soul. I can forgive it. I "
"can't forget it."
msgstr "넌 내 영혼을 손에 쥔 마족과 몸을 섞었어. 용서는 해 줄게. 근데 잊지는 못하겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 11bb8bc6-2c16-0a3c-6fae-b26fcf0ff2ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:11bb8bc6-2c16-0a3c-6fae-b26fcf0ff2ed
msgctxt "hf26c2300gd035g4833g859bge985786d3379"
msgid ""
"I had hoped my eyes were deceiving me... but no. You were with her, weren't "
"you?"
msgstr "내가 잘못 봤나 싶었는데... 아니구나. 밤새 저 여자랑 같이 있었던 거야, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Narrator
#. NodeID = 12963f64-e9a9-adfa-bed6-141cd5e5b2e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:12963f64-e9a9-adfa-bed6-141cd5e5b2e4
msgctxt "hed77e211gbfb9g483dga1a0gdedfecdf2f71"
msgid ""
"*Morning - tainted by the faint whiff of sulphur. You may have rejected "
"Mizora, but her essence still hangs in the air.*"
msgstr "*희미한 유황 냄새가 아침을 더럽히고 있습니다. 미조라의 유혹은 뿌리쳤지만 ,그녀의 정수가 아직도 공기 중에 떠돕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 12b5dd61-222b-2e71-1fa9-ae5673fe19d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:12b5dd61-222b-2e71-1fa9-ae5673fe19d2
msgctxt "h1cdee276gdb61g4766ga8d0g4ce35736b5b7"
msgid ""
"Oh, but you made no complaint when our flesh met for the first time - or the "
"tenth."
msgstr "오, 근데 우리가 처음으로 살 부딪힐 땐 그런 소리 안 했잖아. 열 번째 때도 안 그랬고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 15396f12-6d3f-d987-c275-e9d9070d13cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:15396f12-6d3f-d987-c275-e9d9070d13cb
msgctxt "h97399dacgd9a8g43f3g96d9gc3db490ce4f0"
msgid "No, but I bet you're going to tell me."
msgstr "몰라. 네가 말 해 주겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 16b294ac-cb44-91be-ba22-165768b3c346
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:16b294ac-cb44-91be-ba22-165768b3c346
msgctxt "hd6f0d49dge214g44c5gbf4eg922e39372e29"
msgid "Glorious. Such decadence, such depravity."
msgstr "죽여주던데. 그 정도로 방탕하게 놀고, 타락해 볼 수 있다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 18385d81-298a-c311-456f-4d4c28cb2762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:18385d81-298a-c311-456f-4d4c28cb2762
msgctxt "he6b59cdag0469g4106gb6dfg2d3e93011734"
msgid ""
"As you say. Perhaps others could turn the other cheek, but I'm not that "
"sort. It's for the best - to spare further heartache."
msgstr ""
"잘 아네. 기회를 한 번 더 주는 사람도 있겠지만, 난 그럴 만한 위인은 못 되거든. 더 마음 상할 일 없어지려면 이게 최선이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 187d15c2-0373-e8a9-99c7-98178864b01f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:187d15c2-0373-e8a9-99c7-98178864b01f
msgctxt "hacf237a9g117fg49ebgba95g0a4caf54718a"
msgid "I should never have gone along with this. I regret every moment."
msgstr "이딴 건 애초에 하지 말아야 했는데. 모든 순간이 후회되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = 197d4719-2924-3bca-dca6-7a102dc30eff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:197d4719-2924-3bca-dca6-7a102dc30eff
msgctxt "h95cb51c1g7977g4511gbd0ag5d1ed96156b4"
msgid "I no longer care what you want. You had me - and now you have lost me."
msgstr "네가 필요한 게 뭔지 관심 없어. 난 네 여자였지만, 이젠 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 1a973672-0913-076f-89a4-960c99b27a0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:1a973672-0913-076f-89a4-960c99b27a0e
msgctxt "hcc1f0befga873g4499gaa8fg8e6c5bcd9beb"
msgid "And out of every soul walking the planes, <i>you chose her.</i>"
msgstr "근데 이 차원계에 차고 넘치는 사람들 중에서 <i>저 여자</i>를 고르다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 1ad8f208-6330-bf95-2360-eace92127803
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:1ad8f208-6330-bf95-2360-eace92127803
msgctxt "h306273b6g5d31g4790g9dd1g13b3ad086f28"
msgid ""
"You can't undo what you did. But you can exalt the souls who are still "
"living."
msgstr "한 번 저지른 짓은 돌이킬 수 없어. 그래도 넌 아직 살아있는 영혼들을 찬양해 줄 순 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 1b33fd14-a41c-0591-a1cd-e0917dd8c790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:1b33fd14-a41c-0591-a1cd-e0917dd8c790
msgctxt "h310cb7afgc263g4d83g8da3ge1e910c2e266"
msgid ""
"More incredible than the love we might have shared, the kingdom we might "
"have built?"
msgstr "그게 우리가 나눌 수 있었던 사랑이나, 우리가 세울 수도 있던 왕국보다 중요해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 1bd9febd-4bbc-220c-0f3e-70c0288d4da1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:1bd9febd-4bbc-220c-0f3e-70c0288d4da1
msgctxt "h0a1eb893ga994g4f88g954egfa97c4d93239"
msgid ""
"If you want 'healthy' advice, go talk to a druid. I'm just telling you what "
"works."
msgstr "'좋은 해결책'이 듣고 싶으면 가서 드루이드하고 얘기해. 난 현실적으로 말해 주는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 20bb7b4b-166a-d78d-85ca-6011fe3bc841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:20bb7b4b-166a-d78d-85ca-6011fe3bc841
msgctxt "hc668ebc3g39f6g4abdg9b7fg6343c2dc60c4"
msgid "I think I'll nip out for a bit, stretch my wings, trim my talons."
msgstr "난 가서 날개 좀 펴고, 손톱 손질이나 해야겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = 214f5414-12b1-46df-46a8-7eabd0ec89de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:214f5414-12b1-46df-46a8-7eabd0ec89de
msgctxt "h58d907fbg3657g4f4egbca2g4542dd67e653"
msgid ""
"The way I was raised, the way I was trained... well, it was positively "
"encouraged, to get to know each other. Even from the memories I can recall, "
"there's stories I could tell you..."
msgstr ""
"내가 받은 가르침과 교육 방식에서는... 그, 서로를 알아가는 행위를 적극적으로 권장했어. 심지어 내 몇 안 되는 기억 중에서도, 해 줄 "
"만한 얘기들이 있고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = 222de5cd-8e82-440b-07e1-9901b6876bbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithHalsin(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:222de5cd-8e82-440b-07e1-9901b6876bbb
msgctxt "had4ac664g4c0fg4775gbd1bg7f53dd67fbd6"
msgid "Well, it seems you have little fear of adventure of any sort, do you?"
msgstr "흠, 그대는 정말 어떤 종류의 모험이라도 마다하지 않는 것 같군. 안 그런가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 237231f5-8b16-83b5-3c6e-17bc52c673dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:237231f5-8b16-83b5-3c6e-17bc52c673dd
msgctxt "h55eea4afg2ae3g4c6fg99b1gf7a06ce6c5c8"
msgid ""
"<i>Me</i>, darling. And you can have your turn, too, if you learn some "
"manners."
msgstr "<i>나랑</i>, 예쁜아. 너도 방법만 조금 알면 할 수 있을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 238683b3-3876-14b4-f45c-dcad9c6d370e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:238683b3-3876-14b4-f45c-dcad9c6d370e
msgctxt "h9469dc52g93a6g45e8gab1dgcb1286e0788e"
msgid ""
"What did you expect? <i>You layed a half-devil</i>. She does not give "
"without taking."
msgstr "뭘 기대했는데? <i>넌 하프데빌이랑 잤어.</i> 그 여잔 주는 게 있으면 반드시 뭔가를 가져간다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 23a75802-ea6f-d172-05d7-742549c6da11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:23a75802-ea6f-d172-05d7-742549c6da11
msgctxt "h0b181c53g1e3dg4ff9g88a6gfa02ef32ba25"
msgid "Afterwards you felt empty? Alone? Ashamed?"
msgstr "끝나고 나니까 허전해? 외로웠어? 창피했어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 248d695f-5627-258f-d179-cfa1a188f1fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:248d695f-5627-258f-d179-cfa1a188f1fd
msgctxt "h3c65e361g226fg4140g9c46gdb872c5d0795"
msgid "That... doesn't sound healthy."
msgstr "좋은... 해결책은 아닌 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 267566e4-429c-e1ae-dd1a-1e5ba235b392
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:267566e4-429c-e1ae-dd1a-1e5ba235b392
msgctxt "hd2f78839g9d93g47dfgb60ag26bf086d7822"
msgid ""
"She was incredible in all honesty. I had no idea the Hells could be so "
"heavenly."
msgstr "솔직히 말해서 끝내줬어. 지옥이 그렇게 천국처럼 느껴질 줄은 몰랐다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 267c4098-f916-9ffb-9757-84be2b0ca29e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:267c4098-f916-9ffb-9757-84be2b0ca29e
msgctxt "h87be1267ge3eag47f3ga4e0g90e30114e0a9"
msgid ""
"I do not share. That is not drama - that is pride. You might want to find "
"some of your own."
msgstr "난 사랑하는 이를 공유하지 않는다. 이건 감정 따위가 아니라 자존심의 문제야. 너도 그걸 좀 찾아봐야 할 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 26abd2ca-3443-8f25-cfbf-2c3c854df512
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:26abd2ca-3443-8f25-cfbf-2c3c854df512
msgctxt "he09fb727g28ebg4732ga70bg1d25c839c1ae"
msgid "Terrible. I regret ever agreeing to it."
msgstr "최악이었어. 말 꺼냈던 걸 평생 후회할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 2765a97d-067b-d6a7-ca61-5a57415d487c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:2765a97d-067b-d6a7-ca61-5a57415d487c
msgctxt "h33b74e41g86f3g4d9dg8825g95dee8d3c40e"
msgid "It was a mistake. I don't want to lose what we have because of this."
msgstr "내가 실수했어. 이런 일로 우리 관계 틀어지기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 2af4ba8e-a91b-6c7d-0a94-8486ea5c0cda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:2af4ba8e-a91b-6c7d-0a94-8486ea5c0cda
msgctxt "ha682d434gb68cg442agb3e2gbe9d48c8e4e0"
msgid "It's not what you think, I swear."
msgstr "네가 생각하는 그런 거 아니야, 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 2cba6de1-5b3c-c24c-8b53-2cf35c4b78c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:2cba6de1-5b3c-c24c-8b53-2cf35c4b78c0
msgctxt "hdea02ad3gf7e6g4201ga449g164f473cd1dd"
msgid "So, what was it like? Tell me everything."
msgstr "그래, 어땠어? 전부 다 얘기해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 2d012f26-1144-6526-bc9e-60c9e0441a46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:2d012f26-1144-6526-bc9e-60c9e0441a46
msgctxt "h7511699fg7cb9g46eaga777gc38f238fdf8e"
msgid "It's not what you think it is, I swear."
msgstr "네가 생각하는 그런 거 아니야, 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = 31dd4213-e415-9cf6-e79e-8dc874bec0ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:31dd4213-e415-9cf6-e79e-8dc874bec0ff
msgctxt "h1362ce77g28dfg4138g9648g22c1bddcf172"
msgid "Just don't forget about me either - I have needs of my own."
msgstr "그냥 나도 있다는 걸 기억해 줘. 나도 하고 싶을 때가 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = 33b1ff79-d0ae-d67b-64f8-a540d7e7b38a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:33b1ff79-d0ae-d67b-64f8-a540d7e7b38a
msgctxt "hd7daa774g3a41g41dcgb74bg7c4ca5b6052b"
msgid "There would be no more 'you' if I were not containing my anger."
msgstr "내가 참지 않았다면 '너'도 끝났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = 33dab320-31ae-819e-d1f1-416da3352df7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:33dab320-31ae-819e-d1f1-416da3352df7
msgctxt "hee0de55dgcd07g4835gb1fagec76bfad2c31"
msgid ""
"Lies. If you were so easily manipulated, I would never have admired you as "
"much as I did."
msgstr "거짓말. 네가 그렇게 쉽게 조종당하는 사람이었다면 절대 널 그토록 높게 평가하지 않았을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 356a38ec-24f2-d76e-b281-af7827f5df43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:356a38ec-24f2-d76e-b281-af7827f5df43
msgctxt "h3827427agfb69g4be0ga967ga5c62d0e0950"
msgid ""
"No, no regrets. It was great, actually. I didn't know the Hells could be so "
"heavenly."
msgstr "아니, 후회되진 않는데. 사실 되게 좋았어. 지옥이 그렇게나 천국처럼 느껴질 줄은 몰랐다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 3724350c-db14-cd58-f683-d9b2ab42214c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:3724350c-db14-cd58-f683-d9b2ab42214c
msgctxt "had1b2d25g4b01g486fg9a3dgacec00a1c660"
msgid "So? They're already dead. What's a little more torture?"
msgstr "근데? 다들 이미 죽었잖아. 거기서 좀 더 고통받는 게 뭐 어때서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 388433e0-1214-fde8-a599-ba7183d56bf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:388433e0-1214-fde8-a599-ba7183d56bf2
msgctxt "hf8892167gb548g47f9g836cg1eaf53c034bd"
msgid "Please, stick with me. No more dalliances - I only want you."
msgstr "가지 마, 부탁이야. 이제 한 눈 안 팔게. 난 당신이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 3944433b-91df-93d3-5f7b-9a78bfdd99e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:3944433b-91df-93d3-5f7b-9a78bfdd99e0
msgctxt "h4637ed7eg5d9dg4f4cgbae1gd51e96424a47"
msgid "It was only sex, Gale. Do you have to be so dramatic?"
msgstr "그냥 섹스 한 번 한 거야, 게일. 이렇게 감정적으로 나와야겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = 3a4b7240-bced-8abf-1bfb-a3af31c4f35d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:3a4b7240-bced-8abf-1bfb-a3af31c4f35d
msgctxt "h6d38f812g12dfg4185g84e1g3a70ffccbd8e"
msgid "Don't apologise. I'd rather see you happy than guilty."
msgstr "사과할 것 없어. 난 네 죄지은 얼굴보다는 웃는 얼굴이 보고 싶으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Narrator
#. NodeID = 3b088db0-bcc1-da42-bde8-0adf38dd8668
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:3b088db0-bcc1-da42-bde8-0adf38dd8668
msgctxt "h8f7556f3g9302g4383gaabdg4b314fad19a5"
msgid ""
"*Your pores flood with heat and frigid water. Your parched tongue searches "
"for the right response.*"
msgstr "*당신의 땀샘이 열기와 차가운 물기로 흘러넘칩니다. 말라붙은 혀는 계속 그때의 맛을 찾아 헤매고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 3babf3f4-02fa-b95d-07e9-34f8b79fcd52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:3babf3f4-02fa-b95d-07e9-34f8b79fcd52
msgctxt "h3dd64c07g1692g4ce6gbb3bg3a3f20cc56b2"
msgid "So do I, I've never tried my hand at seducing a devil."
msgstr "나도 그래. 여태껏 데빌을 유혹해 본 적은 없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = 41cf979b-d318-ed16-e04c-9e8ddf380b80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:41cf979b-d318-ed16-e04c-9e8ddf380b80
msgctxt "ha8f8cd71g2ba4g46fegbf79g4827282fafcc"
msgid "I'm sure that's true. But it doesn't change the way it makes me feel."
msgstr "당연히 그렇겠지. 근데 그런다고 내 기분이 바뀌진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = 465da165-4c0a-7c3c-9684-6974875118a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:465da165-4c0a-7c3c-9684-6974875118a5
msgctxt "h780e373fg0601g4124g90c2g8e1ab54192e3"
msgid ""
"Oh. Then I'm sorry to hear the encounter left a sour taste in your mouth. It "
"can be... an unfortunate reality. I just hope it doesn't dissuade you from "
"exploring nature's bounty."
msgstr ""
"아. 나와의 조우가 그대에게 씁쓸함을 남겼다면 사과하겠소. 정말... 불행한 현실이군. 이 일 때문에 그대가 자연의 풍요를 탐험하기를 "
"꺼리지 않았으면 좋겠소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 49788e26-75de-e1e6-3bc7-58e3bca4cfe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:49788e26-75de-e1e6-3bc7-58e3bca4cfe4
msgctxt "h06e94f3egc5cfg4653gbf10gf6405331d3df"
msgid ""
"Well, so long as you were able to indulge yourself, I suppose nothing - and "
"<i>nobody </i>- else matters."
msgstr "그래, 즐길 대로 즐기고 오셨으니 <i>아무도</i> 신경 안 쓰이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 4a455cdd-c754-152a-9331-1d7473e6d137
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4a455cdd-c754-152a-9331-1d7473e6d137
msgctxt "hd74d8a0fgee3eg41e2gbd1bgf43fdb0c36eb"
msgid "It was a mistake. You didn't invite me!"
msgstr "엄청난 실수지. 왜 나 안 불렀어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 4bea35f0-06cc-9545-726e-4f14a641c774
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4bea35f0-06cc-9545-726e-4f14a641c774
msgctxt "h9d079994g8d4bg4fa5ga795g47955f3ce4bf"
msgid ""
"Halsin, you saucy thing. Have those biceps of yours gotten even "
"<i>bigger?</i>"
msgstr "할신, 요 맛도리. 이두박근이 더 <i>커진</i> 것 같은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 4c61fe66-5afe-a0e0-229d-5d6e2b1580db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4c61fe66-5afe-a0e0-229d-5d6e2b1580db
msgctxt "hc13df7c2g54d7g40acgb3d9g09726dfd852a"
msgid "Please, stay with me. No more dalliances - I only want you."
msgstr "부탁이야, 가지 마. 다른 사람은 필요 없어. 난 너만 있으면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 4c72037c-658e-6db1-68d1-fe9e9028bc56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4c72037c-658e-6db1-68d1-fe9e9028bc56
msgctxt "hd79b23dbgdc23g4d1dg8e43gbe8bebb0c921"
msgid "Last I checked, none of us was tied to a leash."
msgstr "이제 우리 둘 다 아무렇게나 해도 되는 걸로 알고 있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = 4d5f1878-cef4-ea06-2771-b399185aeca9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithMinthara(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4d5f1878-cef4-ea06-2771-b399185aeca9
msgctxt "h4a901091ga625g45bag8e1bgc66a7659b6d1"
msgid ""
"Explain yourself. Or is your tongue too-scorched from exploring that "
"hellhole to form words?"
msgstr "설명해 보시지. 아님 저 년의 지옥 구멍에 혀가 바싹 타버려서 말하기가 어렵나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 4d6d54e5-54f1-a280-3cc2-9519378ac4cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4d6d54e5-54f1-a280-3cc2-9519378ac4cd
msgctxt "hf3632c9eg334fg4bdeg809eg439faeeda037"
msgid ""
"On the contrary, my dear - unlike you, I know <i>just </i>where to bite."
msgstr "그건 아니지, 자기야. 난 자기랑 다르게 어디를 깨물어야 하는지 <i>딱</i> 알거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 4db03b60-5a1e-9e2e-fd41-2f9ee6e53ef7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4db03b60-5a1e-9e2e-fd41-2f9ee6e53ef7
msgctxt "he5e2480fg31f3g46f9ga533g3c811696cf6a"
msgid "Gods. You caused so much sorrow, all for a damnable <i>fling.</i>"
msgstr "맙소사. 네 그 망할 <i>불장난</i>은, 수많은 이들을 고통에 빠뜨린 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 4fb8ae27-020a-ae96-0b11-eaa8f68ad0a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:4fb8ae27-020a-ae96-0b11-eaa8f68ad0a8
msgctxt "hae857dbfg90ddg4769g86a0ga57172e63728"
msgid ""
"Listen, Astarion. She manipulated me into it. It meant nothing, I swear."
msgstr "들어봐, 아스타리온. 저 여자가 끌어들인 거야. 하면서도 아무 느낌 안 났어. 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 514c8d4b-8fbd-d65a-d1c9-ebeed14ccfd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:514c8d4b-8fbd-d65a-d1c9-ebeed14ccfd4
msgctxt "h1fd42ddfg51a0g4f34gbfd9g2d9834830fe2"
msgid ""
"Well of course I'm jealous! It's not every day you can do a horizontal dance "
"with a devil."
msgstr "당연히 질투 나지! 데빌이랑 몸 섞을 기회는 날이면 날마다 오는 게 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 515d9313-99a3-dfb6-db1d-c4345c617d05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:515d9313-99a3-dfb6-db1d-c4345c617d05
msgctxt "h31066998gedf6g40b7gb98bgca274e368893"
msgid ""
"Diminish my feelings if you wish, but do not expect me to take this lying "
"down - that's more your style, from what I can tell. My trust in you is "
"broken."
msgstr ""
"내 감정 맘껏 짓밟아 봐. 근데 나도 가만히 보고 있지만은 않을 거야. 네 방식대로 말이지. 난 너에 대한 신뢰가 완전히 박살 났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 520dff5d-a7f9-5f95-36f1-9545e05b7263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:520dff5d-a7f9-5f95-36f1-9545e05b7263
msgctxt "h8da88784g3a3bg4e04gb990g062349c2a4c7"
msgid "Why, Gale - is that a hint of <i>jealousy</i> I detect?"
msgstr "왜 그래, 게일. 지금 이거 혹시 <i>질투</i>하는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 5219e224-d12d-d0b2-5d53-b40792ee2d93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:5219e224-d12d-d0b2-5d53-b40792ee2d93
msgctxt "h7065cef9gdfbfg4c64g8412g7471db154b37"
msgid "It's not what you think, I swear."
msgstr "네가 생각하는 그런 거 아니야, 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 53a59720-e540-aaf0-75b2-8ad9a5e75735
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:53a59720-e540-aaf0-75b2-8ad9a5e75735
msgctxt "h890b878dg9d48g456cg84aagdf66b55f6fa1"
msgid ""
"If only your mind had been so set last night. But alas, that bell cannot be "
"unrung."
msgstr "어젯밤에 그렇게 생각했으면 좋았을 텐데. 이제 돌이킬 방법은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 5427123a-4733-dc0a-dc69-3d2ce21082e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:5427123a-4733-dc0a-dc69-3d2ce21082e1
msgctxt "hd0b84cd2g0ff2g405eg943ag452d8698a33e"
msgid "It was only sex, Wyll. Do you have to be so dramatic?"
msgstr "그냥 섹스 한 번 한 거야, 윌. 꼭 그렇게 화를 내야겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 54fdc6ce-1e90-a35a-3ed2-82f7655d9978
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:54fdc6ce-1e90-a35a-3ed2-82f7655d9978
msgctxt "h88e29a8dgeae4g4d7cga1f9ge326790f3143"
msgid ""
"I'm glad to hear you say it. I had no idea the Hells could be so heavenly."
msgstr "이해해줘서 고마워. 지옥이 그렇게 천국처럼 느껴질 줄은 몰랐다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 572bf5d1-fe00-c675-8f92-85f0bcb1ccac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:572bf5d1-fe00-c675-8f92-85f0bcb1ccac
msgctxt "hc3a55895gc28dg4803g8f96g8b6ac9758660"
msgid ""
"Listen, Shadowheart. She manipulated me into it. It meant nothing, I swear."
msgstr "들어봐, 섀도하트. 저 여자가 나 끌어들인 거야. 하면서도 아무 느낌 안 났어. 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 57c28334-0330-b39d-9287-b899440a6e9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllEternalPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:57c28334-0330-b39d-9287-b899440a6e9b
msgctxt "h71a34a01g73f0g4980ga8e3gcb2a34684d44"
msgid "Last I checked, you were the only one of us tied to a leash."
msgstr "우리 둘 중에서 멋대로 굴면 안 되는 건 너뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 59090066-fce2-ace8-7063-06486266c517
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:59090066-fce2-ace8-7063-06486266c517
msgctxt "hda172e70g17fcg453bg877eged7196a410c7"
msgid ""
"I think I'll nip out for a bit, let you lovebirds chirp. Who would I be to "
"meddle in <i>personal</i> affairs?"
msgstr "잠깐 자리 비워 줄 테니까 둘이 얘기 나눠. 내가 무슨 자격으로 <i>연인들</i> 사정에 끼어들겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 59440175-ef64-4b8e-f444-7e433be25fdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:59440175-ef64-4b8e-f444-7e433be25fdb
msgctxt "hf0edef00g90a5g416eg91d0g4709c69e5857"
msgid "I couldn't resist her. And it was incredible, to be honest."
msgstr "저항할 수가 없었어. 그리고 솔직히 말해서 진짜 끝내주더라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 616591d3-7c70-488c-b583-26b53aff16b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:616591d3-7c70-488c-b583-26b53aff16b8
msgctxt "h75c9831ag65f4g469eg97c9g438014748649"
msgid "I should have known better. No patron gives without taking."
msgstr "내가 더 알아봤어야 했어. 후원자들은 주는 게 있으면 항상 무언갈 가져가지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 631ff6be-3c38-f6bc-073b-c919c8053d6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:631ff6be-3c38-f6bc-073b-c919c8053d6e
msgctxt "hb10f8d8agf093g44edg861fg737671c80d62"
msgid "You had your chance, and unleashed a wildfire. Nothing left but dust."
msgstr "네가 네 기회에 스스로 불을 질렀잖아. 여기엔 먼지 말곤 아무것도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 632a83bb-970f-c5fc-7473-242fb6704226
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:632a83bb-970f-c5fc-7473-242fb6704226
msgctxt "h35e981afg47d3g407bg8596g734e57765f48"
msgid "When the blade has cut clean through, it is too late for sorries."
msgstr "칼날로 깔끔히 베어내고 나면, 이미 사과하기에는 늦은 법이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 6544a9f4-a739-e8d5-c890-dd7395f2e5a9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6544a9f4-a739-e8d5-c890-dd7395f2e5a9
msgctxt "h039881b1gec86g410dg9094gd7b554e8ae7b"
msgid ""
"I think I'll nip out for a bit, stretch my wings. And don't be too hard on "
"her, pup. Don't you remember?"
msgstr "난 가서 날개나 좀 펴야겠다. 그리고 그 애한테 너무 뭐라고 하지 마, 멍멍아. 너도 알잖니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 6544a9f4-a739-e8d5-c890-dd7395f2e5a9
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6544a9f4-a739-e8d5-c890-dd7395f2e5a9
msgctxt "h8f1a749fgb99eg4d99gbee8gee530f73b75f"
msgid ""
"I think I'll nip out for a bit, stretch my wings. And don't be too hard on "
"him, pup. Don't you remember?"
msgstr "난 가서 날개나 좀 펴야겠다. 그리고 그 애한테 너무 뭐라고 하지 마, 멍멍아. 너도 알잖니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 6544a9f4-a739-e8d5-c890-dd7395f2e5a9
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6544a9f4-a739-e8d5-c890-dd7395f2e5a9
msgctxt "h9df33f23g9579g4041g92fdg6f0855a961d7"
msgid ""
"I think I'll nip out for a bit, stretch my wings. And don't be too hard on "
"them, pup. Don't you remember?"
msgstr "난 가서 날개나 좀 펴야겠다. 그리고 걔네한테 너무 뭐라고 하지 마, 멍멍아. 너도 알잖니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 687742f8-c0db-5646-6d3c-e4edd434e6da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:687742f8-c0db-5646-6d3c-e4edd434e6da
msgctxt "h8db10af3g2c80g4dc1g984cg9b97177d7f38"
msgid "You're smarter than that. It's part of what drew me to you."
msgstr "넌 그런 거에 넘어가지 않는 똑똑한 사람이잖아. 난 네 그런 점에 반했던 건데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = 69a31fd7-c29e-afc6-335a-f0d06b498bea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithGale(1) = True
#.     - ORI_State_PartneredWithGale(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:69a31fd7-c29e-afc6-335a-f0d06b498bea
msgctxt "hbd7981e2g1b86g4b70gbc61geda52d35a6fa"
msgid ""
"You still have me as an ally... but anything beyond that was just a fleeting "
"dream - one from which I have now awoken."
msgstr "계속 네 동료로 남긴 할 테지만... 우리가 동료 이상으로서 해왔던 건 그냥 잠깐의 꿈이었던 거야. 난 그 꿈에서 깼고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = 6a6b02cf-3a57-7cbc-e4ab-f7c5b5ee0509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6a6b02cf-3a57-7cbc-e4ab-f7c5b5ee0509
msgctxt "h30b8b180gcc86g412cg9ff2g37a9462f42bb"
msgid "I'm not seeking to control you. All I ask is a little... consideration."
msgstr "너 단속하고 그러려는 거 아니야. 살짝... 고민하고 움직이라는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 6aebe429-c152-b102-080d-df2f42717b84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6aebe429-c152-b102-080d-df2f42717b84
msgctxt "haf37f5bdg8453g4e48gbf9eg1e9695415779"
msgid "Tsk. You're a terrible liar. Your time in Avernus taught you nothing."
msgstr "하. 진짜 거짓말 못 하네. 넌 아베르누스에서 배운 게 없구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 6cec5e98-2a64-6038-62b1-7e612c4ec38a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6cec5e98-2a64-6038-62b1-7e612c4ec38a
msgctxt "he7891a39gad38g418eg82c5g2da93118d144"
msgid ""
"Is that what matters to you? Sex without union, heat without heart? Did you "
"not take joy in the dance?"
msgstr "네게는 그런 게 중요해? 정서적 교류 없는 섹스, 감정은 주고받지 않고 놀아나는 거? 그때 춤추면서는 즐겁지 않았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 6cf9dfc7-934b-0ed1-1689-49f5a6e2ad56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6cf9dfc7-934b-0ed1-1689-49f5a6e2ad56
msgctxt "h7b998fd6gdc27g4fcag8fc9g533cb7763e55"
msgid "Not bad, but I wish you'd been there too."
msgstr "나쁘지 않았어. 너도 같이 있었으면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 6dae5be2-f301-d1ba-2554-81b5ca20004e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6dae5be2-f301-d1ba-2554-81b5ca20004e
msgctxt "h505477b3g5c7cg4b74gb788ga1fa71b3913f"
msgid ""
"Well... no, not particularly. But it's better than facing up to it, at least."
msgstr "음... 아니, 그렇진 않지. 그래도 정면으로 마주하는 것보단 그게 낫잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 6e7b2177-da0f-0541-c67c-4af6b6970c2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithWyll(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6e7b2177-da0f-0541-c67c-4af6b6970c2e
msgctxt "h723b7cb4g1c84g4cb8ga4b7gdc8bb5901999"
msgid "Shit. Why?"
msgstr "젠장. 왜?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = 6f3a9099-9837-3220-6966-9031a0018466
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:6f3a9099-9837-3220-6966-9031a0018466
msgctxt "h4fe9571fg5ee4g42ecg9be5g35bb1571ea9a"
msgid "That said, you can certainly do better then her. I should know."
msgstr "그때, 너라면 분명 저 여자보단 낫게 행동할 거야. 난 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 70a7b5f2-0203-1b99-e04c-d208ca702705
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:70a7b5f2-0203-1b99-e04c-d208ca702705
msgctxt "h22f4071cg5cb0g4a96gaff6g5170a17ef4d1"
msgid "Then you're no better than the wretches that condemned them."
msgstr "그럼, 넌 그들에게 벌 주는 놈들과 다를 바 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = 714f707a-b6f6-8fe0-3800-bdb6a2d387d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:714f707a-b6f6-8fe0-3800-bdb6a2d387d1
msgctxt "h7ef3e7aeg7f25g4708g9724gcfa329658b7c"
msgid "You've <i>got </i>to be kidding. <i>Her?</i>"
msgstr "이게 진짜일 리 <i>없어</i>. <i>쟤</i>랑?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = 7324cc07-55f7-3093-c802-a96f6f8322f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:7324cc07-55f7-3093-c802-a96f6f8322f3
msgctxt "h6d656ebeg94e3g48f0g93eegf9ed093b06de"
msgid ""
"Well, I'm glad you didn't feel the need to deprive yourself. To deny the "
"most essential of impulses is to cut yourself off from nature."
msgstr "뭐, 죄책감을 느끼지 않는다니 기쁘구려. 가장 본질적인 충동을 거부하는 일이야말로 자연에게서 멀어지는 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = 7325edbf-9e3c-5f8f-04d7-1eed794e3160
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:7325edbf-9e3c-5f8f-04d7-1eed794e3160
msgctxt "hc65b92e8g7bc0g4acagb10dg22e92889ac9e"
msgid ""
"If you ever want to talk, my ears are all yours. Any part of me is yours, "
"should you wish."
msgstr "언제든지 대화하러 오시오. 내 귀는 그대의 것이니. 원한다면, 다른 부위도 그대의 것이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 733b4070-8cb2-564a-0783-2f74046b29cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:733b4070-8cb2-564a-0783-2f74046b29cc
msgctxt "h1f1af23bg4364g4a69gbf38g8408758981ac"
msgid ""
"Can't you feel it, pet? Where my lips scorched your skin? How your soul's "
"frozen over?"
msgstr "느껴지니, 멍멍아? 내 입술이 네 어디를 그을렸는지? 네 영혼이 얼어붙어 있는 건?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 74a408a5-0f0d-d0b1-8035-a0e10e4cebfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:74a408a5-0f0d-d0b1-8035-a0e10e4cebfd
msgctxt "h84115599g729fg47dagb7e7g44fd8b668a59"
msgid "Why not?"
msgstr "안 될 거 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = 751967a3-f110-153c-c8e7-a1ca3c27784e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:751967a3-f110-153c-c8e7-a1ca3c27784e
msgctxt "hece94299g2d60g436ag9784g5dab2707dd7e"
msgid ""
"Well... 'works' might be putting it a little strong, but... makes it feel "
"less terrible, at least."
msgstr "음... '현실적'이라는 표현은 좀 과하긴 한데, 어쨌든... 적어도 덜 끔찍한 기분일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = 785f3516-b12f-b77f-0210-5476d13cbce8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithKarlach(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_Karlach_State_SleptWithMizora(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:785f3516-b12f-b77f-0210-5476d13cbce8
msgctxt "h0f6fec0dgef70g427dg96e3g623a97b65db5"
msgid "You and Mizora. Wow. Just wow."
msgstr "너랑 미조라라니. 이야. 진짜 할 말이 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 78ae805e-620e-9b27-9687-fd7b195b75f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:78ae805e-620e-9b27-9687-fd7b195b75f4
msgctxt "h64948939gcb81g4964g8fa9g46daca97a266"
msgid "It was only sex, Minthara. Do you have to be so dramatic?"
msgstr "그냥 섹스였을 뿐이야, 민타라. 그렇게 예민하게 굴어야 해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 793e3f04-03f2-fe68-0bbb-46383d5be607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:793e3f04-03f2-fe68-0bbb-46383d5be607
msgctxt "ha2e21d6dge9c8g446bg88d9ge9ecba3790b3"
msgid ""
"She wasn't bad. If you'd been there, you could have taught her a thing or "
"two."
msgstr "나쁘지 않았어. 너도 거기 있었다면, 네가 미조라한테 몇 개 가르쳐 줄 수 있었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 7cbf5516-a07d-4172-d189-a508b2de749f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:7cbf5516-a07d-4172-d189-a508b2de749f
msgctxt "hc4e3d9dag83cag4b61g931egbfa9fb2d206a"
msgid "It was great, actually. I didn't know the Hells could be so heavenly."
msgstr "진짜 끝내줬어. 지옥이 그렇게 천국처럼 느껴질 줄은 몰랐다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 7dbac633-c9ef-1cd9-cda6-204fc53ecf8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:7dbac633-c9ef-1cd9-cda6-204fc53ecf8b
msgctxt "hae0df5ceg0270g40f5g90e1g71480cec03b8"
msgid "I let my guard down. It won't happen again."
msgstr "내가 방심했었군. 앞으로 다시는 이런 일 없을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 7ea10a3f-1d1d-a022-4408-56a826fc650f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:7ea10a3f-1d1d-a022-4408-56a826fc650f
msgctxt "hd924f397g1faeg40a9gb5feg0953d8b3ba84"
msgid ""
"<i>Shka'keth! </i>First, you cut me clean open. Then, you set my carcass "
"aflame."
msgstr "<i>쉬카케스</i>! 처음엔 내 마음을 찢어놓더니, 이제는 그 상처에 소금을 뿌리는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 802575bc-f4ce-c84f-f7a2-23ee97331dd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:802575bc-f4ce-c84f-f7a2-23ee97331dd9
msgctxt "h2e378845g685fg4888gba3egd5064cfd4302"
msgid "It's not what you think it is, I swear."
msgstr "네가 생각하는 그런 거 아니야, 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = 810a9bfc-a280-380d-77a0-5163c2e59d63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:810a9bfc-a280-380d-77a0-5163c2e59d63
msgctxt "h802b34c3g5befg407eg862fg4036ba02b40e"
msgid ""
"I can barely look at that devil, much less touch her. How could you be so "
"reckless?"
msgstr "난 저 데빌을 만지는 건 고사하고, 간신히 쳐다보는 것밖에 못 해. 어쩜 그렇게 생각이 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = 82486490-5851-f892-6b75-9123ed1dec72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:82486490-5851-f892-6b75-9123ed1dec72
msgctxt "h24e6b757g421fg4bcegad93ge40299553655"
msgid "Listen to you. You have no idea what you're talking about."
msgstr "네가 하는 말 좀 봐 봐. 자기가 무슨 말을 하는지도 모르고 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 83c87c6e-86ba-1594-470f-468be446298f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithWyll(1) = True
#.     - ORI_State_PartneredWithWyll(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:83c87c6e-86ba-1594-470f-468be446298f
msgctxt "h54db03c8gda12g4e33g92a0gd7cb93d095f5"
msgid "You have my might - I owe you that much. But don't owe you more."
msgstr "힘은 계속 빌려줄게. 빚진 게 있으니까. 근데 앞으로는 빚질 일 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = 8446d5cc-f0fc-6232-317a-f034991b44f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:8446d5cc-f0fc-6232-317a-f034991b44f0
msgctxt "hd991c13cg929ag421egb8adg294511eb21ac"
msgid "Leave. I have killed greater lovers for smaller betrayals than this."
msgstr "가라. 이보다 깊었던 사랑도 이것보다 사소한 배신 때문에 죽여봤으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 858a50d4-e8ac-f7ce-321d-ac319a25874f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:858a50d4-e8ac-f7ce-321d-ac319a25874f
msgctxt "ha74423f0g0c79g4f4cg9cefg79381bc99286"
msgid ""
"Is that what you said to <i>her</i> when she wrapped her wings around you?"
msgstr "<i>그년</i> 날개에 안겨 있을 때도 그렇게 말했나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 8644c4e4-1e03-9d80-b01f-722bcc355dac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:8644c4e4-1e03-9d80-b01f-722bcc355dac
msgctxt "h13496f3bg8454g43ddgaabcge25d1b064a29"
msgid "No, nothing good."
msgstr "전혀 잘한 짓이 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = 881721d3-35ce-86ec-38d0-ad3c0734710f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:881721d3-35ce-86ec-38d0-ad3c0734710f
msgctxt "hb3897086gac1fg4cc6g8f6cgc4192622944a"
msgid "Is that so? Clearly I've been going too easy on you..."
msgstr "그러셨어요? 내가 진짜 널 너무 편하게 대해줬나 보다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 88533314-9294-dcae-a1cf-f1eeb51aa858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:88533314-9294-dcae-a1cf-f1eeb51aa858
msgctxt "h3c7d925cg7f18g44b5g9550gba05b8cd3d9b"
msgid ""
"It was a mistake, and I'm sorry. I don't want to lose what we have because "
"of this."
msgstr "그냥 실수였어, 미안해. 이런 일로 우리 관계 틀어지기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = 8949094e-042b-ea88-29c9-7705a6f32336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:8949094e-042b-ea88-29c9-7705a6f32336
msgctxt "h448c3b77gbf02g4f58gacd3g504e3b5257a6"
msgid "Was it everything you thought it'd be?"
msgstr "네가 상상한 그대로였어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = 8def1f58-c25d-2b73-26eb-0880a58dee38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:8def1f58-c25d-2b73-26eb-0880a58dee38
msgctxt "h92b237c3gcf37g4f84g9d2cg51bc90206cb2"
msgid ""
"You should've thought of that before you got close to that devil. Did you "
"forget who she works for? Did you forget what Zariel did to me?"
msgstr "저 데빌이랑 붙어먹기 전에 그 생각을 했어야지. 저년이 누구 밑에서 일하는지 잊었어? 자리엘이 나한테 무슨 짓을 했는지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 8e0ddb64-cfc6-9215-3651-8ccf96675185
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_WasPartneredWithLaezel(1) = True
#.     - ORI_State_PartneredWithLaezel(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:8e0ddb64-cfc6-9215-3651-8ccf96675185
msgctxt "h59850cfagf51bg468cg8c6dg95cafb31b527"
msgid "Only allies. Nothing more."
msgstr "우린 그저 동료다. 거기까지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 8f0f6320-0b28-ee84-f0ae-2c18099eb599
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:8f0f6320-0b28-ee84-f0ae-2c18099eb599
msgctxt "h66bd511eg7f7eg4505g9f07g37f6eb369d8c"
msgid "Do you understand what she did - what <i>you</i> did?"
msgstr "저 여자가 무슨 짓을 했는지 알아? <i>네가</i> 무슨 짓을 했는지는?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = 8f60f1d8-0021-20b4-252d-0529ddf3daff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:8f60f1d8-0021-20b4-252d-0529ddf3daff
msgctxt "h19d8aeb9gc579g46ebg96d7gc74997fb2879"
msgid "Well look who the Lady of Silver dragged in."
msgstr "은의 여인께서 귀찮은 걸 끌고 오셨군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 926012dd-7ca6-5d87-021c-5408b80dde03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:926012dd-7ca6-5d87-021c-5408b80dde03
msgctxt "h37308534g007eg4a85ga461g38550aa39324"
msgid "She was incredible. Who knew the Hells could be so heavenly?"
msgstr "진짜 황홀했어. 지옥이 그렇게 천국 같이 느껴질 줄은 몰랐다니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 9517aff5-998c-0e6b-b7b5-1a51aeb30dcc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Wyll_Act3Romance_Event_Began = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:9517aff5-998c-0e6b-b7b5-1a51aeb30dcc
msgctxt "hb37293eag5522g4e6agba3dgbea3ed083218"
msgid "Can you blame me? It's not like you've been putting out."
msgstr "네가 날 비난할 자격이 있어? 넌 나랑 자려고도 하지 않았잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = 96943f99-6f92-6997-23ce-95ffa40caa72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:96943f99-6f92-6997-23ce-95ffa40caa72
msgctxt "h43acdb00g6fdcg4a0dgba4ag190aa93618e1"
msgid ""
"Would it be a mistake if my dagger were to find your heart? I think not."
msgstr "내가 네 심장에 단검을 겨눠도 실수일까? 아닐 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 97db7f12-805d-50e2-4937-171fc479294c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:97db7f12-805d-50e2-4937-171fc479294c
msgctxt "h5511fd55g3058g48e4g8a6fg261ea3e7dcb3"
msgid "Listen, Halsin. She manipulated me into it. It meant nothing, I swear."
msgstr "들어봐, 할신. 저 여자가 나 끌어들인 거야. 하면서도 아무 느낌 없었어. 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 9b8b0fed-f910-9132-c66c-3e56c96d8068
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:9b8b0fed-f910-9132-c66c-3e56c96d8068
msgctxt "hc9a0ea23gc7feg4788g81cdg73bc7fb061ff"
msgid "It was great, actually. I didn't know the Hells could be so heavenly."
msgstr "진짜 끝내줬어. 지옥이 그렇게 천국처럼 느껴질 줄은 몰랐다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = 9c02a885-bc25-e7d7-acf1-99bf898729aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:9c02a885-bc25-e7d7-acf1-99bf898729aa
msgctxt "ha67e8ce7g2760g4e3egb785g125103dce895"
msgid "<i>Shake your head in disbelief.</i>"
msgstr "<i>불신의 의미로 고개를 젓는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = 9f005c83-9a85-fbfe-814b-586b2c1d1270
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:9f005c83-9a85-fbfe-814b-586b2c1d1270
msgctxt "he0dce009g7d38g410dg9ef5gb80503da5130"
msgid "Is that what you think?"
msgstr "진짜 그렇게 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = 9f739ea3-05a3-cbcf-f885-dd6945abc086
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:9f739ea3-05a3-cbcf-f885-dd6945abc086
msgctxt "hc6e5832dg092eg4661gb819gb123b5c704da"
msgid ""
"<i>Kaincha. </i>Haven't I suffered enough wounds for you to come slice me "
"clean open?"
msgstr "<i>케인챠.</i> 상처는 충분히 받았으니 이제 그만 날 죽여주지 않겠느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = a03d3b7c-b103-b7b0-d3f1-f5561d60a377
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:a03d3b7c-b103-b7b0-d3f1-f5561d60a377
msgctxt "h0a461b69g2e43g4773gaa65g3f41f50992a1"
msgid ""
"Just remember to fetch me next time. I'd hate to think you were holding out "
"on me."
msgstr "다음엔 나도 껴서 같이 해. 나한테 뭐 숨기는 거 싫으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = a08c025f-fa66-4cef-f6d5-cc3994f42f81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:a08c025f-fa66-4cef-f6d5-cc3994f42f81
msgctxt "h3c4d8609g780bg43dcga1f5gf3b18b93eb13"
msgid ""
"More than a little. I would love to see her naked body bound to yours by "
"barbed chains, as you both bleed out in a spider-pit."
msgstr ""
"조금 정도가 아니지. 그년의 벗은 몸이 너와 엉켜있는 모습을 보고 싶어 미치겠으니까. 가시철조망에 묶여 거미굴에 던져져서 피 흘리는 채로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = a130bfd0-edd3-4e6d-f157-3f4ce68fbb98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:a130bfd0-edd3-4e6d-f157-3f4ce68fbb98
msgctxt "he7585769g9fddg4979gac2fgb2f499869b66"
msgid "I gave up my soul for the <i>city</i>, not for some diabolical fling."
msgstr "내가 영혼을 포기한 건 <i>도시</i> 때문이지, 무슨 악마랑 바람피우고 그런 것 때문이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = a1940ab4-a5d0-0afc-5a6f-55370ef4271e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:a1940ab4-a5d0-0afc-5a6f-55370ef4271e
msgctxt "hba092d78g2632g4dbdga455gb0fe6ff43e5e"
msgid ""
"I was just thinking it was a shame you weren't there - you could have taught "
"her a thing or two."
msgstr "당신이 거기 없었던 걸 아쉬워하던 참이야. 당신이 미조라한테 몇 개 가르쳐 줄 수 있었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = a399bd34-bc59-082f-83da-86888e833935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:a399bd34-bc59-082f-83da-86888e833935
msgctxt "h6d299be2g1755g4a2ag8bfag47ab7448e13f"
msgid "You mean to tell me you're not even a little turned on by her?"
msgstr "미조라한테 조금도 흥분하지 않는다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = a64e3159-9bc3-3278-2653-eaec9b8b3c14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:a64e3159-9bc3-3278-2653-eaec9b8b3c14
msgctxt "h669b587eg3de1g42b9g9dacg46d07b911308"
msgid ""
"One spark, and the Hells were yours to devour. A pity for you the one taste "
"is all I'll give."
msgstr "네 작은 불씨가, 지옥들을 꿀꺽 삼켜 버렸지. 이걸 한 번밖에 맛볼 수 없다니 너도 참 불쌍하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = a9f70b31-b625-b46e-9ff7-454a9e6125d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:a9f70b31-b625-b46e-9ff7-454a9e6125d4
msgctxt "h885a3ab9gcd43g4682g8a80g1c60e28dfac0"
msgid "Not bad. But it would have been even better If you'd been there too."
msgstr "나쁘지 않았어. 너도 거기 있었으면 더 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = ae5befb6-eddd-ed9e-f939-b08feaeb6d3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ae5befb6-eddd-ed9e-f939-b08feaeb6d3d
msgctxt "h789b92aeg49b9g4d40gb2e3g73bf50070e7c"
msgid ""
"And you - not a mark on you. You burn just as hot as myself, dear sister."
msgstr "하지만 네게는 낙인이 남지 않지. 넌 나만큼이나 뜨겁게 불타는구나, 동생아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = ae992866-3d68-e2a3-d65c-e20d1e9e427b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ae992866-3d68-e2a3-d65c-e20d1e9e427b
msgctxt "h39b5e091gafb9g4709gaebeg98f20ed88454"
msgid "Now now, Minthara. Can I help it if I'm too tempting to refuse?"
msgstr "진정해, 민타라. 내가 너무 매력적이어서 거절하지 못한 걸 어떡하겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = b33f2491-b284-bbb6-6ea6-c9e2a2758abf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b33f2491-b284-bbb6-6ea6-c9e2a2758abf
msgctxt "h9ab1e641gbb6eg4408gb33dg8e8d32d529b1"
msgid ""
"It happens, my dear. Best not to dwell on it. Not if you can move on to the "
"next conquest."
msgstr "그럴 때도 있는 거야, 자기. 너무 거기에 매몰되지 마. 다른 일로 넘어가면 그만이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = b35c7242-0398-1f39-5642-31ba58ebfe3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b35c7242-0398-1f39-5642-31ba58ebfe3d
msgctxt "h6bd2df67gf638g44ccg8a00g541841e6b62a"
msgid "It was a mistake. If I could choose over again, I would."
msgstr "이건 실수였어. 다시 선택할 수 있다면 그렇게 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = b45df4a7-5de6-ac11-e442-a433e3a4e15f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b45df4a7-5de6-ac11-e442-a433e3a4e15f
msgctxt "h217988c4g8e4ag4316gb65bg82c0b41d5e58"
msgid ""
"Astarion. What a pleasant surprise. I must have drawn more blood than I "
"intended."
msgstr "아스타리온. 이게 누구야. 이럴 줄 알았으면 피를 더 흘릴 걸 그랬네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = b4c40b6f-623c-b347-46d2-1f377d8f3c41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b4c40b6f-623c-b347-46d2-1f377d8f3c41
msgctxt "h8733074age1cfg4a25g8cddg40294d0628bb"
msgid ""
"It does sound divine. You'll have to catch me up on all the gory details "
"later."
msgstr "진짜 성스러운 문장이다. 나중에 피가 얼마나 났는지 같은 것도 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = b5692cb5-6b53-5c3d-25cc-684b0a62c238
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b5692cb5-6b53-5c3d-25cc-684b0a62c238
msgctxt "h446d2be7g6cd2g4275gafc0g0318023e44d9"
msgid ""
"But that said, don't allow me to talk myself out of a night to remember all "
"the time..."
msgstr "허나 그렇다고 해서, 그 영원토록 기억될 밤에 날 빼놓진 마시오..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = b6bc59aa-16a5-208f-d049-8047ef9782ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b6bc59aa-16a5-208f-d049-8047ef9782ab
msgctxt "h218dbccag0063g44bdgb564gb425657f628d"
msgid ""
"I've... misjudged the situation. I gave my heart over to you too freely, and "
"now it has been wounded. A mistake I shall not repeat."
msgstr "내가... 착각하고 있었네. 난 최선을 다해서 널 사랑했는데, 그러지 말았어야 했나 봐. 이제 다시는 이런 짓 안 해야겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = b88a72d9-7ecd-23d8-72fa-17d4ad743864
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllEternalPact = True
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b88a72d9-7ecd-23d8-72fa-17d4ad743864
msgctxt "ha60c80f8ga4a2g45ecg9102g2cecb357e8fb"
msgid "Forever marked. It's not just a contract that binds us."
msgstr "이것들은 영원한 낙인이야. 우릴 결속해 주는 건 계약뿐만이 아닌 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = b89a3ad1-255f-99c1-fba6-683cd12304a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithWyll(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b89a3ad1-255f-99c1-fba6-683cd12304a4
msgctxt "h43ed2fdbgd38dg4ce5g995cgd8359a97190a"
msgid ""
"I was such a godsdamned fool. I believed in you. I believed in <i>us</i>."
msgstr "내가 멍청한 놈이지. 난 널 믿었어. <i>우리</i> 관계를 믿었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = b9634a67-b3eb-0d9a-23dd-0069477e9152
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:b9634a67-b3eb-0d9a-23dd-0069477e9152
msgctxt "hb7918947g7077g40e2ga617g70200eda008b"
msgid "All that said, there's no harm in asking me in advance."
msgstr "그러니까, 하기 전에 나한테 미리 물어봐도 아무 상관 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = ba0aacf1-cfe0-ac6d-4825-bc85c6185af3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ba0aacf1-cfe0-ac6d-4825-bc85c6185af3
msgctxt "h0f06e3e5gf675g45e2g9210gc17dc6dba4b2"
msgid "I feel it. But I'm not sure I like it."
msgstr "느껴지긴 하지만, 나도 이게 내 맘에 드는지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = ba7b9d0b-98eb-5768-9f06-19d689ce4e3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ba7b9d0b-98eb-5768-9f06-19d689ce4e3a
msgctxt "he10fa57dg743dg4214g9e16gff99f00b9051"
msgid ""
"It was a mistake, and I'm sorry. I don't want to lose what we have because "
"of this."
msgstr "그냥 실수였어, 미안해. 이런 일로 우리 관계 틀어지기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = bb6c3a47-7447-0951-05ac-52ed14af6794
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:bb6c3a47-7447-0951-05ac-52ed14af6794
msgctxt "h1b504875g347bg4f74g97d9gb15b31676f56"
msgid ""
"Yes. I shared a night of ecstasy with the hottest devil this side of Avernus."
msgstr "알지. 아베르누스에서 가장 화끈한 데빌과 광란의 하룻밤을 보냈어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = bbe7f680-1552-e253-dc05-427e9d6daf43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:bbe7f680-1552-e253-dc05-427e9d6daf43
msgctxt "h81e4dde1g046cg4850g9054g779f688385ad"
msgid "I'm honestly not sure. Good in the moment, but afterwards..."
msgstr "잘 모르겠어. 할 땐 좋았는데, 끝나고 나니까..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = bd84a355-4124-7c7f-03ce-842e90046f5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:bd84a355-4124-7c7f-03ce-842e90046f5e
msgctxt "ha37e59abg9110g444cg9959g84122af12646"
msgid "But trust me, deary - the pleasure was all yours."
msgstr "그리고 착각하지 마, 아가야. 난 별 감흥 없었으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = bdcdf773-ea22-ec72-53e1-09e6504948af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:bdcdf773-ea22-ec72-53e1-09e6504948af
msgctxt "h87b01e28gd091g42fcg9687gd26699397a2e"
msgid ""
"Pleasant evening, I trust? I tidied up my hair and had an early night... but "
"you don't look like you had much sleep at all."
msgstr "되게 행복해 보인다? 난 머리 정돈하고 일찍 잤는데... 넌 어젯밤에 꽤나 바빴나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = be0cdda2-0191-5ae6-ab75-9fe626553be8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:be0cdda2-0191-5ae6-ab75-9fe626553be8
msgctxt "hd9876abdg7dd1g498cg9a80g6be442279488"
msgid "Don't you dare subject me to petty lies."
msgstr "저급한 거짓말로 무마할 생각 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = be77ba9f-6db4-21cc-d06d-2713d8234416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:be77ba9f-6db4-21cc-d06d-2713d8234416
msgctxt "h5448e908gef23g45cdgadcfg4b1d7f2e7320"
msgid ""
"Well of course it meant nothing! She's a devil, she's hardly going to fall "
"in love."
msgstr "당연히 아무 느낌도 안 났겠지! 저 여잔 데빌이야. 누구랑 사랑에 빠지는 건 하늘의 별 따기라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = c13b247a-ff32-9534-ac8e-26cf9bdb6a4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c13b247a-ff32-9534-ac8e-26cf9bdb6a4c
msgctxt "hb8d9d3b4gc076g41a7g8f3cgf809b9dd1c9f"
msgid "The flame always existed in me. But you were the one to kindle it."
msgstr "내 안엔 항상 불꽃이 있었어. 그걸 크게 지펴준 건 너지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = c1946aaa-ca01-ea6b-9ea1-8483f0752739
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithWyll(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c1946aaa-ca01-ea6b-9ea1-8483f0752739
msgctxt "h438d9024ge3dfg4271ga291gf0a93705e87d"
msgid ""
"Countless souls walk these planes, countless ways to find pleasure. And out "
"of all of them, you chose <i>her.</i>"
msgstr ""
"이 차원계엔 무수히 많은 영혼이 있고, 쾌락을 즐길 무수히 많은 수단이 있어. 근데 그 모든 경우의 수 중에서, 넌 <i>저 여자</"
"i>를 골랐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = c2b346ca-9d7b-1eb8-c4ff-c7349509bea7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c2b346ca-9d7b-1eb8-c4ff-c7349509bea7
msgctxt "h97c8d054g4cb6g4278g9f79gb617eb22d199"
msgid "Come on. Don't tell me she didn't stir something in you, too."
msgstr "솔직히 말해 봐. 너도 미조라가 꼬셨으면 넘어갔을 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = c379c5f4-47ed-1e72-b47e-67f8b0a8dcae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c379c5f4-47ed-1e72-b47e-67f8b0a8dcae
msgctxt "hd599ea57g0b80g43e1gb998gf8c7804a31bf"
msgid ""
"We danced, we made a connection. And you severed it for a single bite of the "
"Hells."
msgstr "우린 춤도 췄고, 무언가로 이어져 있었잖아. 근데 넌 지옥을 한 번 맛보곤 그걸 싹둑 잘라 버렸네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = c3836d96-3d6d-a7b5-e2c1-d23dd95f99c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c3836d96-3d6d-a7b5-e2c1-d23dd95f99c9
msgctxt "h642f3b88ge999g486bgb3cbg0371f76db977"
msgid "I had a bit of fun is all. Nothing to get worked up about."
msgstr "잠깐 재미 본 게 다야. 화낼 거 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = c3a0d707-d414-d85a-0980-07abb955fa43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c3a0d707-d414-d85a-0980-07abb955fa43
msgctxt "ha92b5423gcc96g4465g9320gc359c0910466"
msgid ""
"Were you actually worried I was angry? Oh you sweet little thing - I'm not "
"going to abandon a feast just because someone else had a nibble."
msgstr "내가 진짜 화난 줄 알았어? 귀염둥아, 난 누가 한 입 먹었다고 해서 꿀단지를 버리지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = c4c18404-b769-c9c9-ebe2-3186febefdab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c4c18404-b769-c9c9-ebe2-3186febefdab
msgctxt "h5df505c7gc27bg45e4g84c4g48aba3b9db9b"
msgid ""
"I'm smarter than that, and so are you. It's part of what drew me to you."
msgstr "나 그런 거에 속을 만큼 멍청하진 않거든. 그리고 너도 그렇잖아. 난 네 그런 점에 반했던 건데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = c551c771-50dd-cee3-3f0e-529a389cf59b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c551c771-50dd-cee3-3f0e-529a389cf59b
msgctxt "ha9926c68ge0d7g47e0ga165g1ec99595a74b"
msgid ""
"Tell me. Did her skin taste as good as mine? Did her tongue make you shiver?"
msgstr "말해 봐라. 저년의 살결이 내 살결만큼이나 달콤했나? 저 혀가 널 떨리게 하던가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = c62e8489-8c72-06c2-b113-846f57a42bd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c62e8489-8c72-06c2-b113-846f57a42bd3
msgctxt "h8fc810bfg8e00g40ddg8767g68872fb71992"
msgid "Gods. I had no idea."
msgstr "어떡해. 나 전혀 몰랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = c677dbb0-57eb-fe28-42f2-1e0e33c21c58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c677dbb0-57eb-fe28-42f2-1e0e33c21c58
msgctxt "hc00821b2g2b7eg41dag80deg8dc285d209e4"
msgid "True. The next will be better!"
msgstr "맞는 말이네. 다음에 잘하면 되지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = c74bbe27-8674-c195-e656-facb7fc97b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c74bbe27-8674-c195-e656-facb7fc97b9c
msgctxt "h3e047b42g5bdeg45d4g9877gb4d36e8fd258"
msgid ""
"Listen, Wyll. She manipulated me into it. You of all people should "
"understand."
msgstr "내 얘기 들어봐, 윌. 저 여자가 하자고 했어. 다른 사람들도 이해할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = c8556f86-8a3f-7b26-bb03-d79b85409b56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c8556f86-8a3f-7b26-bb03-d79b85409b56
msgctxt "hbc45e37fgda96g4bd7gabcfgb6aafe60bcc2"
msgid "I'm <i>irresistible.</i>"
msgstr "내가 좀 <i>꼴리잖아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = c8e1d43c-7fc0-77be-fef5-742f685c9a3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c8e1d43c-7fc0-77be-fef5-742f685c9a3b
msgctxt "h98398f9dg5c2ag454eg8a6eg441b3b6e4e8c"
msgid "I need... I need a minute."
msgstr "나... 나 좀 혼자 있을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = c945e943-fe28-f01c-bfcc-1d3ce39325f0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithMinthara(1) = False
#.     - ORI_State_WasPartneredWithMinthara(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:c945e943-fe28-f01c-bfcc-1d3ce39325f0
msgctxt "h2afa21d9gedf4g4902g86fdgdefe73b71edc"
msgid "Clean yourself off. Brimstone is an ill perfume."
msgstr "먼저 씻어. 유황이 냄새가 너무 심하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = ca8359d2-2b37-5f6e-4f02-90899238860d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ca8359d2-2b37-5f6e-4f02-90899238860d
msgctxt "h97141010g186bg4309gada1g94b3e387bd9c"
msgid "So that's it, then? No more 'us'?"
msgstr "그럼 이제 끝인가? '우리' 헤어진 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = cfaa42c5-cb81-e3a3-f1cc-8bb89603d01e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:cfaa42c5-cb81-e3a3-f1cc-8bb89603d01e
msgctxt "hc5e37804g36aag41c0g8918g43f573450c31"
msgid "So that's it, then? No more 'us'?"
msgstr "그럼 이제 끝인가? '우리' 헤어진 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = d0cec213-630f-04d1-65d5-fa81bda96664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d0cec213-630f-04d1-65d5-fa81bda96664
msgctxt "hd30c532dg812dg4359g8783g30090ea311d4"
msgid ""
"Well of course I would have! Sweet hells, it's not every day you can do a "
"horizontal dance with a devil."
msgstr "당연하잖아! 정말이지, 데빌이랑 몸 섞을 기회는 날이면 날마다 오는 게 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = d1b72a46-8d79-56f7-d610-9691036c683d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d1b72a46-8d79-56f7-d610-9691036c683d
msgctxt "h884daec9gc37eg430ag8da7g4a0e298148d3"
msgid ""
"It was a mistake, and I'm sorry. I don't want to lose what we have because "
"of this."
msgstr "그냥 실수였어, 미안해. 이런 일로 우리 관계 틀어지기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = d345aa43-6074-c5ef-3eeb-1587861caa23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d345aa43-6074-c5ef-3eeb-1587861caa23
msgctxt "h63543163gc616g4694g841bg515799057cf8"
msgid ""
"Is your mind so fragile that you couldn't say 'no'? Was our bond so weak "
"that a single spark could break it?"
msgstr ""
"네 놈의 정신은 얼마나 나약하길래 '안돼'라는 말도 못 하는 거냐? 우리의 유대가 이런 작은 불씨에 무너질 만큼 연약한 것이었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = d596dbad-e2b6-026b-8a0c-cf24100b6010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d596dbad-e2b6-026b-8a0c-cf24100b6010
msgctxt "hb8b1060ag757cg4f90g8cd6g5a4e13813f16"
msgid ""
"You're forever marked. Can't you feel it - where my lips scorched your skin? "
"How your soul burns with flame?"
msgstr "넌 영원히 낙인찍힌 거야. 내 입술이 네 어디를 그을렸는지 느껴져? 네 영혼이 불타버렸던 건?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = d59d8ecd-46ea-ac92-ab6f-85241ac6f067
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithShadowheart(1) = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d59d8ecd-46ea-ac92-ab6f-85241ac6f067
msgctxt "h649a6babg1ec1g4508gaaa4gb13dd2aa9ca3"
msgid ""
"Kind of you to offer a free sample then. Now that he's tried out inferior "
"goods, he'll know just how good he has it already."
msgstr "공짜로 대줘서 고마워. 싸구려를 한 번 먹어 봤으니까, 얘도 이제 내가 얼마나 잘하는 건지 잘 알겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = d59d8ecd-46ea-ac92-ab6f-85241ac6f067
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithShadowheart(1) = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d59d8ecd-46ea-ac92-ab6f-85241ac6f067
msgctxt "hf14f82e0g4d6dg4eccg8a10gbb5d3dff1b7e"
msgid ""
"Kind of you to offer a free sample then. Now that she's tried out inferior "
"goods, she'll know just how good she has it already."
msgstr "공짜로 대줘서 고마워. 싸구려를 한 번 먹어 봤으니까, 얘도 이제 내가 얼마나 잘하는 건지 잘 알겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = d59d8ecd-46ea-ac92-ab6f-85241ac6f067
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d59d8ecd-46ea-ac92-ab6f-85241ac6f067
msgctxt "h6b71c4a7gb59ag4a9dg8801g4ff4f2f0c69d"
msgid ""
"Kind of you to offer a free sample then. Now that they've tried out inferior "
"goods, they'll know just how good they has it already."
msgstr "공짜로 대줘서 고마워. 싸구려를 한 번 먹어 봤으니까, 얘도 이제 내가 얼마나 잘하는 건지 잘 알겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = d5a4291f-eade-0d2d-0ceb-615c2a96b8e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d5a4291f-eade-0d2d-0ceb-615c2a96b8e8
msgctxt "hf2d51345g1c45g4632g92a3g9168c89a0a97"
msgid ""
"You shared your body with the fiend who held my soul. I can forgive it. I "
"can't forget it."
msgstr "넌 내 영혼을 손에 쥐었던 마족과 몸을 섞었어. 용서는 해 줄게. 근데 잊지는 못하겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = d5acaee1-616c-3aea-44cc-d001804be5ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithMinthara(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d5acaee1-616c-3aea-44cc-d001804be5ec
msgctxt "h9621b3abg4bb6g417bgbb41gabeeed62588c"
msgid "The devil might just be the last"
msgstr "이게 네 마지막이 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = d5b28a4d-c010-98a7-8e92-05ce8a5fd7ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d5b28a4d-c010-98a7-8e92-05ce8a5fd7ab
msgctxt "haa159278gd117g4f21gb49dg9a3d07173ec0"
msgid "Souls like mine."
msgstr "나 같은 영혼들 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = d5ddb8d3-b524-8f2a-15d9-e603839bff5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d5ddb8d3-b524-8f2a-15d9-e603839bff5b
msgctxt "h40116d09g700ag465fgad44g48d4d202ec77"
msgid "My apologies. I'll keep that in mind."
msgstr "정말 미안해. 앞으로는 명심할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = d62e0ecb-3502-6ae5-9a2a-2ec09c483671
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d62e0ecb-3502-6ae5-9a2a-2ec09c483671
msgctxt "ha4a5ed3cg840dg46cbg8d9cgf472e138a65d"
msgid ""
"You may not like it. But you'll crave it in spite of yourself. A pity for "
"you the one taste is all I'll give."
msgstr ""
"딱히 맘에 들진 않겠지. 하지만 네 의지랑은 상관없이 간절히 바라게 될 거야. 이걸 한 번밖에 맛볼 수 없다니 너도 참 불쌍하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = d872c981-0bc4-564c-089f-dfb6383495e4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d872c981-0bc4-564c-089f-dfb6383495e4
msgctxt "h6255a128g80c4g48b0ga729gbd7699c08ff4"
msgid ""
"You've got to eat, after all. What do I gain from denying your appetites?"
msgstr "일단은 뭐 좀 먹어. 내가 네 욕구 가지고 계속 잔소리해봤자 뭐 하겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = d872c981-0bc4-564c-089f-dfb6383495e4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d872c981-0bc4-564c-089f-dfb6383495e4
msgctxt "h34c8d754gb74eg4cd0g9825g1d88c7021413"
msgid "A girl's got to eat. What do I gain from denying your appetites?"
msgstr "가서 뭐라도 좀 먹어. 내가 네 욕구 가지고 계속 잔소리해봤자 뭐 하겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = d872c981-0bc4-564c-089f-dfb6383495e4
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d872c981-0bc4-564c-089f-dfb6383495e4
msgctxt "h447af7a4g7736g4bd8g9ce9g47c5da5fc9ef"
msgid "An adventurer's got to eat. What do I gain from denying your appetites?"
msgstr "우리 모험가님 배고프시겠네. 내가 네 욕구 가지고 계속 잔소리해봤자 뭐 하겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = d98a0c2a-ae4f-4603-8bdf-93852fe8be4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d98a0c2a-ae4f-4603-8bdf-93852fe8be4e
msgctxt "haba46c98gfe67g4493ga983gb3612066d494"
msgid "But you did."
msgstr "어쨌든 그렇게 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = d9f916fd-6637-f7a6-1588-76f94baa5fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:d9f916fd-6637-f7a6-1588-76f94baa5fb2
msgctxt "hc758149cga132g4fa7g8da3gb7ceccd8982a"
msgid "Raphael. Mizora. You know the ways of devils."
msgstr "라파엘. 미조라. 이 녀석들이 어떤 놈들인지 잘 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = da51520c-0c4b-3ee9-e475-2efc80fbe575
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:da51520c-0c4b-3ee9-e475-2efc80fbe575
msgctxt "h88312e89g5ac4g4abagbab0gc905289f3abb"
msgid ""
"That is a relief, because I thought you had allowed a devil to enjoy your "
"body. A body that belongs to <i>me</i>."
msgstr "다행이로군, 데빌이 네 몸을 탐하도록 허락한 줄 알았으니까. <i>내 것</i>인 몸을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = db9338a8-c455-099a-2bea-06de5ecd3379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:db9338a8-c455-099a-2bea-06de5ecd3379
msgctxt "hc7f531fcg6c10g4852gad4cg5b0565ca016f"
msgid "I'm an adult. I don't need your permission."
msgstr "나도 성인이야. 네 허락은 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Gale
#. NodeID = dbfb8ae7-8e95-e5d2-562e-2477b4bcd217
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:dbfb8ae7-8e95-e5d2-562e-2477b4bcd217
msgctxt "h4a5ce041gb480g40d7gad2bg2acaaeca00f5"
msgid ""
"Some mistakes can't be resolved with an apology. Some mistakes, you have to "
"carry with you, forever."
msgstr "어떤 실수는 사과한다고 해결할 수 있는 게 아니야. 평생 짊어져야만 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = ddb2ce15-f4af-e88c-d6a5-b530ab03d421
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ddb2ce15-f4af-e88c-d6a5-b530ab03d421
msgctxt "h29cc1b09gf91bg4147gb02eg6fc422db38a4"
msgid ""
"It was a mistake, and I'm sorry. I don't want to lose what we have because "
"of this."
msgstr "그냥 실수였어, 미안해. 이런 일로 우리 관계 틀어지기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = de40023b-bc2a-ebbc-f72b-254422aba8b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:de40023b-bc2a-ebbc-f72b-254422aba8b3
msgctxt "h15e3ffabg15bbg4ec3g87a9g579fbb9fa20e"
msgid "And you know they don't give without taking."
msgstr "준 게 있으면 반드시 뭔가를 가져가지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = dfb83bdb-14d7-8cd0-57da-ff704ec73d36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:dfb83bdb-14d7-8cd0-57da-ff704ec73d36
msgctxt "h0ad1fb68g9a4fg4f94g967dg57c5855c3442"
msgid ""
"Gods. You raced from the Hells only to plunge right back in, all for a "
"damnable <i>fling</i>."
msgstr "세상에. 지옥에서 도망쳐 나왔으면서, 그 망할 <i>불장난</i> 때문에 다시 돌아갈 줄이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = e0b91300-72df-b889-cf4e-eabbd96908b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e0b91300-72df-b889-cf4e-eabbd96908b6
msgctxt "h62719a63g9583g41ddgb345g24f73eb2c878"
msgid "It was only sex, Lae'zel. Do you have to be so dramatic?"
msgstr "그냥 섹스 한 번 한 거야, 레이젤. 이렇게 감정적으로 나와야겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = e2c6660d-5ae9-e195-a796-c2a428cc92d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e2c6660d-5ae9-e195-a796-c2a428cc92d8
msgctxt "hda184406gc2b0g4536gb549g170d55367c87"
msgid ""
"Listen, Minthara. She manipulated me into it. It meant nothing, I swear."
msgstr "들어봐, 민타라. 미조라가 날 조종했던 거야. 진심이 아니었어, 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = e515d399-17b6-bc7b-d9d4-2ba42f8fe62a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e515d399-17b6-bc7b-d9d4-2ba42f8fe62a
msgctxt "h94b44d5egcef8g4f14g9556g701fdffbf534"
msgid "Does that work? Just ignoring it?"
msgstr "그게 도움이 돼? 그냥 무시하는 게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = e7a899ca-7c56-c587-4ce5-df7ef42744ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e7a899ca-7c56-c587-4ce5-df7ef42744ae
msgctxt "h171d7896gd195g4442ga97cg90d617601728"
msgid "Listen, Gale. She manipulated me into it. It meant nothing, I swear."
msgstr "들어봐, 게일. 저 여자가 나 끌어들인 거야. 하면서도 아무 느낌 안 났어. 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = e869f6f4-eccd-636f-5baa-41a52df665f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e869f6f4-eccd-636f-5baa-41a52df665f4
msgctxt "h56b8677fg33c4g49d7gbe81ga0a18c69c339"
msgid ""
"I just hope I don't seem boring to you now, in comparison. Perhaps I'll need "
"to redouble my efforts, in future..."
msgstr "미조라와 비교했을 때, 내가 지루하게 느껴지진 않을까 걱정되는군. 앞으로는 두 배로 노력해야겠소..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = e8ed0318-95d4-6ab6-c185-5028b16d9b45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e8ed0318-95d4-6ab6-c185-5028b16d9b45
msgctxt "hf192fed2g964cg45a3g8ecdg1199f5867a90"
msgid ""
"You were offered a chance, and you seized it with both hands - and some "
"other parts besides. It's admirable, really."
msgstr "기회가 오니까, 두 손으로 넙죽 받아서 놓치질 않네. 다른 부분들도 그렇고. 진짜 존경스러워, 진심으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = e98f1bcd-fee9-b56d-8438-b284d81808cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e98f1bcd-fee9-b56d-8438-b284d81808cc
msgctxt "h399e1ac1gfa98g4bc6ga63fgf38ee28fbde2"
msgid "What? Like you wouldn't have jumped at the chance."
msgstr "뭐? 무슨 엄청난 기회를 놓쳤다는 것처럼 말하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = e9d6b112-c4b5-949b-3a1f-3349f6216116
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e9d6b112-c4b5-949b-3a1f-3349f6216116
msgctxt "h1eba233ag358dg4740g84b8g90880a4d999a"
msgid "And I'd do it again. She was incredible."
msgstr "다시 돌아가도 그렇게 할 거야. 미조라는 진짜 미쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = e9e66f64-e087-c279-ead3-ae2051f94369
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:e9e66f64-e087-c279-ead3-ae2051f94369
msgctxt "ha40e6e92g2fd2g4ed7gb683g293c2853ded1"
msgid "This was a mistake. Nothing more. I'm disgusted with myself."
msgstr "그냥 실수였을 뿐이야. 이럴 생각을 한 내 자신이 역겹다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Karlach
#. NodeID = eb7a3e24-9277-1777-926a-189fadc6d86e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:eb7a3e24-9277-1777-926a-189fadc6d86e
msgctxt "h4c996de6ga667g428eg84aeg0c2625d723b3"
msgid "Do you really expect me to choke down that obvious bullshit?"
msgstr "그딴 뻔한 거짓말에 내가 속을 거 같아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = ec0848c2-88f8-e39a-7562-ecf55e44525a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_BecameVampireLord = True
#.   Object:
#.      - ORI_State_PartneredWithAstarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ec0848c2-88f8-e39a-7562-ecf55e44525a
msgctxt "he637f9f5g269cg42fegb4cfgf3413cb44e98"
msgid "And? What do you have to say for yourself?"
msgstr "그래서? 뭐라고 변명할 작정이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = ecb957c1-e9e9-7aed-f39d-6ee952987735
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ecb957c1-e9e9-7aed-f39d-6ee952987735
msgctxt "h8ee08595gc0f8g432fga184g1bb76a88c88d"
msgid "So that's it, then? No more 'us'?"
msgstr "그럼 이제 끝인가? '우리' 헤어진 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = ed72f7e6-bfe6-95a5-3909-82c3554a7bcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ed72f7e6-bfe6-95a5-3909-82c3554a7bcb
msgctxt "h47b88131g88f8g40eeg9a12g2d04fcbd3309"
msgid "Mm-hmm."
msgstr "으흠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = ed73923b-652a-effe-5682-ef9ec2d3ce8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ed73923b-652a-effe-5682-ef9ec2d3ce8f
msgctxt "h786f3e02gdbdcg4855gbf35ga2dd43cb1c8a"
msgid "Well look who snuck in from the shadows."
msgstr "누가 그림자 속에서 음침하게 훔쳐보고 계셨네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = f018914a-02ab-211f-e636-c4b898b86b8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f018914a-02ab-211f-e636-c4b898b86b8e
msgctxt "hc949a98fgec8fg4f9agaa64g0fbc9115189e"
msgid "It's not what you think, I swear."
msgstr "네가 생각하는 그런 거 아니야, 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = f0eaf9fb-fdbf-073e-9ebc-1408f05179ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f0eaf9fb-fdbf-073e-9ebc-1408f05179ec
msgctxt "h1e2b0421g2bfcg4f71g8077ge765f9de4f1e"
msgid "Please, stick with me. No more dalliances - I only want you."
msgstr "부탁이야, 가지 마. 다른 사람은 필요 없어. 난 너만 있으면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = f2dda077-9dab-db30-85a7-c4656d21a87e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f2dda077-9dab-db30-85a7-c4656d21a87e
msgctxt "h2476519ag107bg417cg9818g85ff3fa115ce"
msgid "The pleasure of torment, the torment of pleasure."
msgstr "고통의 쾌락과, 쾌락의 고통."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = f38fce29-4665-2b97-beb1-37e5e96d7e65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f38fce29-4665-2b97-beb1-37e5e96d7e65
msgctxt "hd0b2daadg2144g4ed1g8a10g1d735c8bb859"
msgid ""
"One taste, one indulgence - but the delicious agony remains. A pity for you "
"the one taste is all I'll give."
msgstr "딱 한 번 맛보고, 즐겼을 뿐이지만... 그 달콤한 고통은 쭉 남아 있겠지. 이걸 한 번밖에 맛볼 수 없다니 너도 참 불쌍하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = f43ddf2f-4cdb-a610-546c-d648e175c808
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f43ddf2f-4cdb-a610-546c-d648e175c808
msgctxt "h2aa2870cg7094g43f2ga130g2bd317dc8fb8"
msgid ""
"I would enjoy punishing your body almost as much as I have enjoyed loving "
"it, but I need you intact for the fights to come."
msgstr "네 육체를 사랑했던 만큼이나 벌주기도 즐기겠지만, 앞으로 다가올 싸움을 위해선 온전한 몸이어야 할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = f4789a53-918f-d1f0-4b1c-c3c89eff4820
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f4789a53-918f-d1f0-4b1c-c3c89eff4820
msgctxt "hbe279903g4113g4695gae69g90f2b8aaec69"
msgid ""
"For every pleasure you took, a damned soul suffered in the Hells. You fed on "
"the hopeless, the frightened. Souls so desperate, they sold themselves to a "
"devil."
msgstr ""
"네가 쾌락을 즐길 때마다, 망자들도 그만큼 지옥에서 고통받게 돼. 넌 희망 없고 두려움에 빠진 이들에게 그렇게 한 거야. 절박한 영혼들은 "
"자신을 데빌에게 팔아넘기기도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = f4ed306a-6fbb-82f9-76ab-5eb53dcf3881
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f4ed306a-6fbb-82f9-76ab-5eb53dcf3881
msgctxt "hd798e04bg8bedg4626ga359gfea36bf065e7"
msgid ""
"It was a mistake, and I'm sorry. I don't want to lose what we have because "
"of this."
msgstr "그냥 실수였어, 미안해. 이런 일로 우리 관계 틀어지기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Nightwarden Minthara
#. NodeID = f6c9d3ef-465f-adc5-8868-55ff3fe2944c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f6c9d3ef-465f-adc5-8868-55ff3fe2944c
msgctxt "hf005ce5bg616ag4b63gac7bgaf55bc8d02d3"
msgid ""
"If I were being dramatic, I would take a knife to your most sensitive parts, "
"and ensure you could never use them again."
msgstr "내가 예민하게 굴었다면, 네 가장 민감한 부위에 칼을 대서 다시는 쓰지 못하게 만들었을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Mizora
#. NodeID = f9a68c84-036f-796d-b347-7af74ebe8620
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllEternalPact = False
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f9a68c84-036f-796d-b347-7af74ebe8620
msgctxt "hab004f24gfce1g4e4ag8206g2047d014ce49"
msgid "Forever marked. We may not be pacted - but the Hells still bind us."
msgstr "이것들은 영원한 낙인이야. 우리 계약은 없던 게 됐지만, 앞으로는 지옥이 우릴 결속해 주겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = f9adf2c0-8f37-a6b5-035f-7dfbd4e972c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f9adf2c0-8f37-a6b5-035f-7dfbd4e972c3
msgctxt "h14c0f8abg1fe7g44d3gbf1fgdf3d079b8396"
msgid "You owe them that much."
msgstr "넌 그 사람들한테 그만큼 빚진 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Wyll
#. NodeID = f9b89a6e-711a-1c64-fd32-741ec35be4ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:f9b89a6e-711a-1c64-fd32-741ec35be4ed
msgctxt "h068a3f87g4defg4928gb8d7g41a53a938a4e"
msgid ""
"I saw a future for us. A kingdom, even. And you shattered it for a single "
"bite of the Hells."
msgstr "난 심지어 우리가 함께 왕국을 세우는 상상도 했어. 근데 네가 지옥을 한 번 맛보고 온 뒤 그건 박살이 났네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = fa9cb39d-7459-3fbc-23ae-adbc580b328e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:fa9cb39d-7459-3fbc-23ae-adbc580b328e
msgctxt "hb6016b35ga1c4g4bd5g8994g06bb3000464a"
msgid ""
"It was a mistake, and I'm sorry. I don't want to lose what we have because "
"of this."
msgstr "그냥 실수였어, 미안해. 이런 일로 우리 관계 틀어지기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Halsin
#. NodeID = fb2ac08f-e468-df7e-42e6-61c08b40a4bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithHalsin(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:fb2ac08f-e468-df7e-42e6-61c08b40a4bf
msgctxt "h4835d70cgb27cg4b1cgb700gb18e10f7bdc4"
msgid ""
"I can't help but sense a certain... ruefulness in you. Don't punish yourself "
"on my account - remember we are both free to roam and love as we see fit."
msgstr ""
"그대가 후회하는 게 느껴지는군. 난 그리 자책하지 않아도 된다고 생각하오. 우린 둘 다 자유로이 떠돌며 자신만의 방식으로 사랑할 수 있는 "
"존재임을 잊지 마시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = fb45f126-9f1a-6094-6310-c6af58725c2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:fb45f126-9f1a-6094-6310-c6af58725c2e
msgctxt "h60a1b90ag2f09g4b84ga31fg62ccb60001ce"
msgid ""
"Spare me the scolded puppy routine - I already said I'm not angry. I'll "
"still pet you as much as you like."
msgstr "불쌍한 강아지처럼 안 굴어도 돼. 화난 거 아니라고 했잖아. 앞으로도 항상 네가 원하는 만큼 예뻐해 줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Astarion
#. NodeID = fcb5669d-d4eb-d85b-a792-561888057bc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:fcb5669d-d4eb-d85b-a792-561888057bc7
msgctxt "hf3b11dacgc2b4g4b26g98b4g6a5b476e4524"
msgid ""
"That's the spirit, just keep moving forward. And hope the past never catches "
"up to you."
msgstr "바로 그거지. 그냥 계속 앞으로 나아가는 거야. 과거가 따라잡지 않기를 바라면서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Shadowheart
#. NodeID = fcfd4a9d-8155-2463-2cc2-0220396bedc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:fcfd4a9d-8155-2463-2cc2-0220396bedc1
msgctxt "h8126d362g8288g418dgb4feg7bb3e5cea180"
msgid ""
"I'm not jealous, you know. If I wanted to bed something loyal and pure, I'd "
"find a swan."
msgstr "질투 나서 이러는 건 아니야. 말 잘 듣고 순수한 놈이랑 자고 싶었으면, 백조랑 다녔겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Lae'zel
#. NodeID = ff3dfe2d-28ac-0a94-dbfa-10a6742279ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ff3dfe2d-28ac-0a94-dbfa-10a6742279ce
msgctxt "h5ccc24ceg876eg4d43g99ebgf792c99da3ad"
msgid "<i>Chk</i>. I see your standards have markedly declined."
msgstr "<i>츠크</i>. 네 여자 보는 안목도 이제 완전히 망가진 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM
#. Speaker = Player
#. NodeID = ffeee326-de0d-f2ed-d4eb-66aef9691c98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizoraMorningAfter_CFM_ROM:ffeee326-de0d-f2ed-d4eb-66aef9691c98
msgctxt "h8a11939bg0eb9g4cf4gbc1bgc1c575841c33"
msgid "And you'd have said yes?"
msgstr "그럼 괜찮다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 00a442ea-00e1-4adf-a3be-438412e073bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:00a442ea-00e1-4adf-a3be-438412e073bf
msgctxt "h941f1812g7601g408dgaffeg9aa647f2f191"
msgid ""
"And do mind your messes, Wyll. I won't always be there to clean them up."
msgstr "그리고 싸고 나면 좀 치워, 윌. 언제까지고 내가 치워줄 순 없잖니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 00ede04e-f6b9-f44c-81aa-19f6d592f533
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:00ede04e-f6b9-f44c-81aa-19f6d592f533
msgctxt "h348d81aagdb51g4adfg867fgbc7630e19bab"
msgid "Cheer up, buttercup. Karlach had no heart. You did the world a favour."
msgstr "기운내, 귀여운 것. 칼라크는 심장이 없어. 넌 세상에 좋은 일을 하는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 0297b06f-3684-40bb-6c62-619ebaad1fb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:0297b06f-3684-40bb-6c62-619ebaad1fb5
msgctxt "h41d3255egbf4eg4bacgaf0fg4eb1a43df48d"
msgid "Why don't you fuck all the way off, Mizora?"
msgstr "그냥 좀 꺼지는 건 어때, 미조라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Narrator
#. NodeID = 037dbd12-7536-40d4-a250-b1668549078f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:037dbd12-7536-40d4-a250-b1668549078f
msgctxt "he1fa653dgac28g45cdgbb5bg010d0360c5bf"
msgid ""
"*Somewhere deep inside, a spark is ignited. You are the Hells' fires made "
"flesh.*"
msgstr "*마음속 깊은 곳 어딘가에서 불이 붙습니다. 당신은 지옥 불의 화신입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Narrator
#. NodeID = 03ddee5d-e67c-b2ba-f590-8c368ec4ae26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:03ddee5d-e67c-b2ba-f590-8c368ec4ae26
msgctxt "h0a2038bbgb405g4e86gb8e2g9ce59ca40773"
msgid ""
"*Wyll burns in the fires of Avernus; the lightning storms of Dis strike his "
"flesh. His soul passes through each layer of the Hells, gaining their "
"essence - and their torment.*"
msgstr ""
"*윌은 아베르누스의 화염 속에서 불타고 디스의 빛 폭풍에 육체를 빼앗깁니다. 영혼은 아홉 지옥을 통과하며 각 층마다의 본질, 그리고 "
"고통을 마주합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 0595d81d-fb5a-40e8-a20f-603e94b63131
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizorasJudgement_Event_Secret(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:0595d81d-fb5a-40e8-a20f-603e94b63131
msgctxt "h17eac5ecg6af9g4aeeg9dc2g51e5df7fda2e"
msgid ""
"Wyll, you absolute stinker! You kept me a secret? Time to let the hellcat "
"out of the bag."
msgstr "윌, 이 나쁜 것! 내 얘기도 안 했니? 이제 비밀을 꺼내놓을 시간이란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 0b70cb13-d48e-bf10-d2c9-e5a01effe239
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:0b70cb13-d48e-bf10-d2c9-e5a01effe239
msgctxt "h76dc4670ga763g4aadg89c7ge6add913204b"
msgid "That's no kind of talk for a <i>lady</i>, Karlach."
msgstr "<i>숙녀</i>가 그런 말 하면 못써, 칼라크."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 0b7f2d53-6c30-4fb4-a212-08eb4329e494
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:0b7f2d53-6c30-4fb4-a212-08eb4329e494
msgctxt "h9dc0090fg80cdg4798gb0c3gd756becabd85"
msgid "Now. Let's see how the Frontiers fare without their precious Blade."
msgstr "변경의 칼날에서 소중한 날이 빠지면 어떻게 되는지 보자구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 0de5288d-aeeb-407b-9772-125b5f6d616c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:0de5288d-aeeb-407b-9772-125b5f6d616c
msgctxt "he59950dfgafd9g4eaagb6b1gcc28419b0dda"
msgid "That's a nice set of wings. Let me guess: Wyll's patron?"
msgstr "날개 멋진데. 네가 윌의 후원자인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 0e0110a2-04f2-414e-ad88-0263461bf233
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:0e0110a2-04f2-414e-ad88-0263461bf233
msgctxt "hfa197c39gcec8g4704g8564gfed9b36ab0a6"
msgid "You flatterer. Why, if I had a heart, I'm sure it would be skipping."
msgstr "끼 부리기는. 나도 심장이 있었다면 분명 두근두근했겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 11771d54-51d5-49a0-89e5-20f39e4a9455
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:11771d54-51d5-49a0-89e5-20f39e4a9455
msgctxt "h4952df1fgb132g4742gba19g6d4efe1d0603"
msgid "What if I kill Karlach now? Would that make you happy?"
msgstr "내가 지금 칼라크를 죽이면? 네가 기뻐할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 1266936b-5595-4e74-887d-059639ece47d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:1266936b-5595-4e74-887d-059639ece47d
msgctxt "h11161551g8ce9g4f17gbc60g4078a3da7dd8"
msgid "The one and only."
msgstr "바로 이 몸이시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 148c7334-04ad-4084-997f-dfcf7570d4ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - KARLACH(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:148c7334-04ad-4084-997f-dfcf7570d4ab
msgctxt "h8d9614c9g237ag4eccgb6d0g719057eefe63"
msgid "Karlach. Keep an eye on him, would you?"
msgstr "칼라크, 윌을 잘 보고 있으렴, 알겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 14e002f5-548c-4fa1-b88c-9056b6269b63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:14e002f5-548c-4fa1-b88c-9056b6269b63
msgctxt "hd8db90b1g93fdg4066g854ega753a0b9eb8f"
msgid "A nice new power should keep you muzzled."
msgstr "이 새로운 능력으로 우리 멍멍이 입을 막아야겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 159a2443-c4ba-4cd4-be06-b074fd3debec
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:159a2443-c4ba-4cd4-be06-b074fd3debec
msgctxt "h8f870bffg663fg4693gba50gbc4968922344"
msgid "Besides, I've already got a pet. But he's been unruly -"
msgstr "게다가, 난 이미 강아지가 한마리 있거든. 근데 제멋대로라,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 159a2443-c4ba-4cd4-be06-b074fd3debec
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:159a2443-c4ba-4cd4-be06-b074fd3debec
msgctxt "hb5bc40b2g947bg46e3gae24ge6e5e017377b"
msgid ""
"Call me Mizora. I'm Wyll's patron, the fount of his power. My pet's been "
"unruly -"
msgstr "난 미조라란다. 윌의 후원자고 힘을 준 장본인이지. 내 강아지는 제멋대로라서,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 171ad236-da69-4742-8cd6-a97213d87284
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:171ad236-da69-4742-8cd6-a97213d87284
msgctxt "h8db8f3bagced0g4ac2g8411ge5f90e84c856"
msgid "My pup here's been unruly -"
msgstr "우리집 강아지가 제멋대로라,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 1818b5a9-9a5d-a442-187a-dc17792e6886
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = False
#.      - KARLACH(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:1818b5a9-9a5d-a442-187a-dc17792e6886
msgctxt "h6ef698dbga62ag4924gb836ge815ab0a3093"
msgid "You better not lay a damned finger on Karlach."
msgstr "칼라크한테 손가락 하나라도 닿으면, 잘라버린다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Wyll
#. NodeID = 1c497a5b-356f-4412-bca7-42bee0b61e98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:1c497a5b-356f-4412-bca7-42bee0b61e98
msgctxt "he1afa283gbaeag42d0g99ecg51a5527cdc18"
msgid "Mizora."
msgstr "미조라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 1d3cb0ca-559a-4d0c-b80d-bcc16af13a3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:1d3cb0ca-559a-4d0c-b80d-bcc16af13a3a
msgctxt "h817fa9c9g96dag4598gb61fge109f3bbffcb"
msgid "<i>Handler's</i> the word, if it's all the same."
msgstr "괜찮다면, <i>조련사</i> 라고 불러도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 1dd196db-a9ef-64c5-31d3-16d2262d9af2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:1dd196db-a9ef-64c5-31d3-16d2262d9af2
msgctxt "h149e5751g6d74g44f4gaf91g3f62aebaf93f"
msgid "More to the point, <i>you obeyed</i>."
msgstr "무엇보다도, <i>너도 따랐잖아</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Wyll
#. NodeID = 1e392a1c-fe56-455a-9442-40b34fb04051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:1e392a1c-fe56-455a-9442-40b34fb04051
msgctxt "h62a8cfddgf543g44e1g8415g592aa4077b2a"
msgid "<i>You said devils only. </i>She was a tiefling, not a monster."
msgstr "<i>데빌만 이라고 했잖아. </i>칼라크는 티플링이었다고, 괴물이 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 1ee038f3-3181-468e-8c41-8d96fa5ca5cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:1ee038f3-3181-468e-8c41-8d96fa5ca5cd
msgctxt "ha13fb25bg0afdg4b7dgbb2dgbe9e96934d6f"
msgid "How precious. The little pupster's found his bark."
msgstr "깜찍해라. 멍멍이가 짖는 법을 배웠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 20c2dd55-8a47-433f-9825-a23608caf9e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:20c2dd55-8a47-433f-9825-a23608caf9e6
msgctxt "h1b557000gcb65g4780gb671gd21d316e25d0"
msgid "And that's not the half of it."
msgstr "그게 전부는 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 23f9562c-9be6-ea91-52ff-5dbaa3d6dff8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_MizorasJudgement_CFM_InclusionHappened(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:23f9562c-9be6-ea91-52ff-5dbaa3d6dff8
msgctxt "hda70043cgd3a9g42a3gb9d0g4190eb5aaaaf"
msgid "I prefer 'advocate'. Has a nice ring to it."
msgstr "'대변인'이라고 해주면 안될까. 그게 더 듣기 좋잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 27f4d109-6add-4b04-92a9-23fa53442c4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:27f4d109-6add-4b04-92a9-23fa53442c4b
msgctxt "hd92d83d9g805ag40cbgbfccg551dcda43d4e"
msgid "Hush, pup. A good warlock knows when not to push his luck."
msgstr "쉿, 멍멍아. 좋은 워락은 운을 시험할 때를 아는 법이란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Karlach
#. NodeID = 28d7a755-76f9-40c9-b8f2-00114e08eb69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_MizorasJudgement_CFM_InclusionHappened(1) = True
#.   Object:
#.     - CAMP_MizorasJudgement_CFM_KarlachPresent(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:28d7a755-76f9-40c9-b8f2-00114e08eb69
msgctxt "hb4b529e2ga78dg4bc9gbf77ga6faa5b9ad8f"
msgid "Mizora. Zariel's lapdog."
msgstr "미조라. 자리엘의 애완견."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 2e7b6802-9108-42db-8c6f-3e294ce76790
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:2e7b6802-9108-42db-8c6f-3e294ce76790
msgctxt "hd937cb6agaa31g48a5ga577gd005f78e9201"
msgid "Mizora. Zariel's lapdog."
msgstr "미조라. 자리엘의 애완견."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 30a2927a-c607-4455-8e9b-c2a999cac533
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:30a2927a-c607-4455-8e9b-c2a999cac533
msgctxt "ha164e53bg00b4g4aaega554g9e0f5228731d"
msgid "Don't worry. A good handler disciplines only her own pets. To wit:"
msgstr "걱정마. 좋은 조련사는 자기 강아지만 훈육하니까. 즉:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 35837e45-349b-4dcf-b1f4-7d1c9ec333ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:35837e45-349b-4dcf-b1f4-7d1c9ec333ed
msgctxt "h35202b62g5543g4647g964agbf57f8172b27"
msgid "Interesting. I've never grown horns before..."
msgstr "재밌군. 뿔이 자란 적은 없었는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 358fca77-4e78-b95f-057f-4f30aa881d8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:358fca77-4e78-b95f-057f-4f30aa881d8c
msgctxt "h1327e3fbga297g4854gb062gee9099b8b98f"
msgid ""
"Don't you worry - that ship has long sailed the Styx. But a defiant pup must "
"still pay his price. To wit:"
msgstr "걱정 마셔요. 그 건은 물 건너 갔으니까. 그치만 말 안 듣는 강아지는 벌을 받아야지. 그 말은,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 3626d518-eee3-459d-8496-e31ee52ea552
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:3626d518-eee3-459d-8496-e31ee52ea552
msgctxt "h837c961bgdde4g43abgaf20gddabd9202f03"
msgid "Catch up. Give you a pat."
msgstr "이리와. 쓰다듬어 줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 377f6506-f080-402d-a075-7853c6fe6549
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:377f6506-f080-402d-a075-7853c6fe6549
msgctxt "hace520dfgd2bdg4f0eg8a1fg0608383d8fc2"
msgid "And a good handler knows when her pup needs correction. To wit:"
msgstr "그리고 좋은 조련사는 교정이 필요한 때를 알아. 즉:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 383883cc-37d2-4343-9e13-523d04814710
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:383883cc-37d2-4343-9e13-523d04814710
msgctxt "h27f59c5bgb142g4cd6ga99dg9942a3e41c1e"
msgid "I prefer 'advocate'. Has a nice ring to it."
msgstr "'대변인'이라고 해주면 안될까. 그게 더 듣기 좋잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Narrator
#. NodeID = 3b706faa-7593-d525-9bfc-0151204e52d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:3b706faa-7593-d525-9bfc-0151204e52d2
msgctxt "hd926914ag7888g431agae7fg228d6c05135e"
msgid ""
"*You know this devil. Mizora, one of Zariel's servants, and a powerful devil "
"in her own regard.*"
msgstr "*당신은 이 데빌을 알고 있습니다. 미조라, 자리엘의 종복 중 하나이며, 그녀 자체로도 강력한 데빌입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 3bb7bfc3-bd5d-4d9e-9369-fa6bad6ab50e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:3bb7bfc3-bd5d-4d9e-9369-fa6bad6ab50e
msgctxt "h4012bc8fg3c55g4b84g84b2g44cbcbc33605"
msgid "I've heard enough. You're not leaving this place alive."
msgstr "들을만큼 들었어. 넌 살아나가지 못한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 3d3c4ad9-3f8d-4147-9e17-5996b60a2add
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5bdcfef6-87f6-ea58-a947-73fe030abca7_KarlachInclusion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:3d3c4ad9-3f8d-4147-9e17-5996b60a2add
msgctxt "h5d1b16ebg1fe3g46fega601ge5a45c253e7e"
msgid "That's no kind of talk for a <i>lady</i>. By the way, Karlach -"
msgstr "<i>숙녀가</i> 그런 말을 하면 못써요. 그나저나, 칼라크..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 40278197-581a-c260-eb80-1315528f5a7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:40278197-581a-c260-eb80-1315528f5a7c
msgctxt "haf52d2cegbc04g416eg8a7eg0ce8cc1c5e69"
msgid "Which reminds me..."
msgstr "그러고 보니, 이걸 깜빡했네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 41a1a2ce-d260-4037-a36a-a9dd53e6f832
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:41a1a2ce-d260-4037-a36a-a9dd53e6f832
msgctxt "hb3a5b32ag92a4g4cf7gb912g62f24d813d05"
msgid "After all - you've been a very good boy."
msgstr "어쨌든, 넌 지금까지 착한 아이였잖니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 41b05029-c449-47c9-bb80-1d5c8a63a43c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:41b05029-c449-47c9-bb80-1d5c8a63a43c
msgctxt "h44e5c2e3g0813g4848gb863g902e0171845b"
msgid "Which reminds me..."
msgstr "그러고 보니, 이걸 깜빡했네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 41b3cb6a-66c4-41e1-8d64-defe169b3eeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:41b3cb6a-66c4-41e1-8d64-defe169b3eeb
msgctxt "h33e83975gde9fg4f70g933dg0260e75dc7ac"
msgid "We had a deal. But Karlach's still breathing."
msgstr "거래한 게 있잖니. 근데 아직 칼라크가 살아 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 42ad7348-b3c5-4e49-9366-6ca877d8cb8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:42ad7348-b3c5-4e49-9366-6ca877d8cb8f
msgctxt "h2d84f25eg6bf2g46a9g8b0dgf8f9707f83e9"
msgid "That's better."
msgstr "좀 낫네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 45b696d1-16ac-4a49-b438-4181b3864efa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:45b696d1-16ac-4a49-b438-4181b3864efa
msgctxt "hf8bd504egd968g4a3cg88a5g09f1fae3baf9"
msgid "And you know what happens when you're naughty."
msgstr "나쁜 짓 하면 어떻게 되는지 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 47c12936-c0a4-4d3d-ba2d-1ad1388a0602
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:47c12936-c0a4-4d3d-ba2d-1ad1388a0602
msgctxt "h94a80eebg8505g483ega5b9gd4e6740c23b1"
msgid ""
"You haven't introduced me to your friend. Where <i>are</i> your manners?"
msgstr "너 아직 친구들한테 내 소개를 안 했구나. <i>왜 이렇게</i> 예의가 없니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 4997c9a9-23c2-4fa2-8904-9dedaeef6ebc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_MizorasJudgement_CFM_InclusionHappened(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:4997c9a9-23c2-4fa2-8904-9dedaeef6ebc
msgctxt "hae0eea0egae67g483aga58cgadfe56a966cf"
msgid "Do your worst. I'm not afraid of you."
msgstr "더 해봐. 난 두렵지 않으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 49fe8caa-644a-429a-9242-4188ce456f9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:49fe8caa-644a-429a-9242-4188ce456f9d
msgctxt "h7841ed66gab3cg42c9g900eg4fbe1cee827c"
msgid "By the gods, what have you done to me?"
msgstr "신이시여, 나에게 무슨 짓을 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 4d9a762a-02d3-457e-8d6c-6992836c0cb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:4d9a762a-02d3-457e-8d6c-6992836c0cb4
msgctxt "h2b1a7e24g7c96g47d5gbeb3g0545143187a9"
msgid "What's done is done, Wyll. And a defiant pup needs discipline. To wit:"
msgstr "이미 끝난 일이야, 윌. 반항적인 강아지는 대가를 치뤄야지. 즉:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 4ef83622-6d0a-4d65-93ca-b33dd267792f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_WyllConfrontation_State_ResolvedPeacefuly = True
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_State_IsDevil = True
#.   Tag:
#.     - WYLL_DEVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:4ef83622-6d0a-4d65-93ca-b33dd267792f
msgctxt "h295d6af2g5d6ag42afgb23aga0dc5a55244e"
msgid "Wyll. You've been naughty."
msgstr "윌, 그러면 못써."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 50587c20-2951-4069-a0c0-c3349bf8101f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:50587c20-2951-4069-a0c0-c3349bf8101f
msgctxt "h313cdc3dg2e62g4349ga47cgc80216f7a7df"
msgid "Speaking of..."
msgstr "말 나온 김에..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 5259265f-965e-4a56-b226-40a5a455ea28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:5259265f-965e-4a56-b226-40a5a455ea28
msgctxt "h2874f178ga4d0g4587gba59gce4a1d6eee1e"
msgid "Blast it all, Wyll. Why didn't you tell me about her?"
msgstr "제기랄, 윌. 미조라 이야기는 왜 안한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 55cf8d3e-6b6a-4acb-a2ab-ed6a2af7f4f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:55cf8d3e-6b6a-4acb-a2ab-ed6a2af7f4f1
msgctxt "h701a1a15g500eg4297g818egb064ade7e9fa"
msgid "That's a nice set of wings. Let me guess: Wyll's patron?"
msgstr "날개 멋진데. 네가 윌의 후원자인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 56443742-bd1b-4922-822a-71dc7abfa078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:56443742-bd1b-4922-822a-71dc7abfa078
msgctxt "hd30a8624ga0ecg413eg88bfg884e85731719"
msgid "I can't accept your reward. I killed an innocent."
msgstr "이 보상은 받을 수 없어. 난 무고한 자를 죽였으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 58395691-90be-473a-86d7-2cb991632d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:58395691-90be-473a-86d7-2cb991632d2d
msgctxt "h4781eac5g5cb6g463dgb3f1g563f49cf0804"
msgid "Well, well. Aren't <i>you</i> a luscious thing?"
msgstr "이런, 이런. 정말 매력적인 <i>분</i>이시네?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 5846ccd9-8abd-4026-b6a8-8e5c92a7a693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:5846ccd9-8abd-4026-b6a8-8e5c92a7a693
msgctxt "h5a4e5876ge290g4007g9c91ge7445b0950d6"
msgid "- and his leash needs a <i>yank</i>."
msgstr "목줄을 이렇게... <i>당겨야</i> 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 592ad4af-766f-4286-ac17-14889adde043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:592ad4af-766f-4286-ac17-14889adde043
msgctxt "ha25f470cgfcb8g43f9g8840g1f2a9c2219bd"
msgid "Always a pleasure. Shame that tadpole's gone and pissed on your party."
msgstr "아, 좋다. 그놈의 올챙이가 너희 파티에 싸질러 놓은 그것만 없었어도 더 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 5b058e91-3020-939a-d237-bb88d4cff035
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:5b058e91-3020-939a-d237-bb88d4cff035
msgctxt "h1194cd9fgefe8g419ag92f1g767f8a883df9"
msgid ""
"Clause G, Section Nine: <i>'Targets shall be limited to the infernal, the "
"demonic, the heartless, and the soulless.'</i>"
msgstr "G조, 제9항: <i>'대상은 지옥의 존재, 데몬, 심장이나 영혼 없는 자에 한한다.'</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 5bfe88be-86d8-4664-8c0a-5ae36aa736e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:5bfe88be-86d8-4664-8c0a-5ae36aa736e1
msgctxt "h2f7335abg9430g4460g89e1g7b7b330bd22e"
msgid "An obedient pup. Pure perfection."
msgstr "순한 멍멍이구나. 완벽해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 6471057d-7b5f-489d-af35-ba8fc094a7c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:6471057d-7b5f-489d-af35-ba8fc094a7c1
msgctxt "hbb8535b6gfcfeg46a8g9c35ga45b34326b0c"
msgid "I say fetch, and you fetch. I say kill a fugitive tiefling, and -"
msgstr "내가 물어오라하면, 물어오고. 내가 탈주한 티플링을 죽이라고 하면,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 6700d379-8bca-4114-8298-59e14eb0cb0e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:6700d379-8bca-4114-8298-59e14eb0cb0e
msgctxt "hbbec8873gec35g47e2g93d0g4db1a5460f88"
msgid "Karlach. Keep an eye on him, would you?"
msgstr "칼라크, 윌을 잘 보고 있으렴, 알겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 6700d379-8bca-4114-8298-59e14eb0cb0e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:6700d379-8bca-4114-8298-59e14eb0cb0e
msgctxt "h861983f2g0f27g4742g9186ge2c4e0db744b"
msgid "Keep an eye on him, will you?"
msgstr "잘 지켜봐줘, 알겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 672bdb72-4d92-4ba1-aa20-973a8d120a44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:672bdb72-4d92-4ba1-aa20-973a8d120a44
msgctxt "h32505333gcdd1g48b4g8ab3g77c2a23985bc"
msgid ""
"Call me Mizora. I'm Wyll's patron, the fount of his power. Your warlock "
"friend is my puppy -"
msgstr "미조라라고 부르렴. 윌의 후원자이자, 힘의 원천이지. 네 워락 친구는 내 애완견이란다,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 69369c9f-51b1-46ee-a3fb-8c0025406916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:69369c9f-51b1-46ee-a3fb-8c0025406916
msgctxt "h3793b9acg3d6bg4dc4g953cg7d7699480424"
msgid ""
"That ship has long sailed the Styx, Wyll. A defiant pup pays the price. To "
"wit:"
msgstr "배는 이미 스틱스강을 떠나버렸는 걸, 윌. 반항적인 강아지는 대가를 치뤄야지. 즉:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 6bf98126-05a5-4b47-8106-b71cc4277745
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:6bf98126-05a5-4b47-8106-b71cc4277745
msgctxt "h1bc7d904gcd54g45b5ga107g298d7e1fbc22"
msgid "A pleasure to serve, Mizora."
msgstr "기꺼이 따르지, 미조라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 744955d1-5a36-4789-bf9d-3a7381d5d364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:744955d1-5a36-4789-bf9d-3a7381d5d364
msgctxt "h83bd7116gbd3bg4615gb28bgee39932e5e96"
msgid "I'll be keeping mine on you."
msgstr "너는 내가 지켜봐 줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 75aa7b85-6fef-f897-a1e0-b1d7edceffc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:75aa7b85-6fef-f897-a1e0-b1d7edceffc7
msgctxt "h65c548f5g9e23g44b7g92c2g5153f5dacedd"
msgid "Oh - and Wyll? Don't forget. Our pact still stands. Ta-ta!"
msgstr "그리고 윌? 잊지 마. 우리 계약은 여전히 유효해. 빠빠이!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 75d686df-b919-4b38-8c19-ca12fab7f1c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:75d686df-b919-4b38-8c19-ca12fab7f1c6
msgctxt "h7b4bd2d1ge966g410bga0b9gcd24f427199d"
msgid "- and he's been a <i>very</i> good boy."
msgstr "이 아이는 지금까지 <i>아주</i> 착한 아이었단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 76bade6e-2fdf-4482-9495-92cafaec8d28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:76bade6e-2fdf-4482-9495-92cafaec8d28
msgctxt "h5deccbe3g5ebfg4772gbca7g75507e0317e8"
msgid "Now? But I'm just getting comfy."
msgstr "벌써? 나 이제야 좀 편해지고 있는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 7728e225-ab09-4531-998c-1995de18e7a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:7728e225-ab09-4531-998c-1995de18e7a4
msgctxt "hfefe017eg82ecg4e48gb32ag5910c03ed7e7"
msgid "Ta-ta!"
msgstr "빠빠이!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 79f6950e-678a-41dd-909a-79c796dfd754
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:79f6950e-678a-41dd-909a-79c796dfd754
msgctxt "hbbb59d3fgf710g4dc4gaa33g51bf9e8915e4"
msgid "If we kill Karlach now, will that get rid of you?"
msgstr "지금 칼라크를 죽이면, 너도 사라지는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 7e9ffb73-f7e6-45eb-9669-5a73d4cd91b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5bdcfef6-87f6-ea58-a947-73fe030abca7_KarlachInclusion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:7e9ffb73-f7e6-45eb-9669-5a73d4cd91b5
msgctxt "h34b4c301g3fd3g4a3eg9ec5gbd5ac06eca48"
msgid "- Zariel sends her regards."
msgstr "자리엘이 안부 전하더라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 803bfcfb-59d9-406c-b4d1-ed3f6e61cb9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:803bfcfb-59d9-406c-b4d1-ed3f6e61cb9e
msgctxt "hacca6ba7g022cg4e38g943cg4656dbc5c788"
msgid "Great. I look forward to my next assignment."
msgstr "좋아. 다음 임무가 기다려지는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Wyll
#. NodeID = 84bc2071-0e15-4d61-a081-2f1a40b9870a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:84bc2071-0e15-4d61-a081-2f1a40b9870a
msgctxt "hac9d7780ga27ag466fg8c7cg09c35f7d723d"
msgid "Hell's fire. <i>She's coming.</i>"
msgstr "지옥 불이군. <i>그 여자</i>가 온다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 873da349-b890-41ea-9038-75c63c704fbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:873da349-b890-41ea-9038-75c63c704fbe
msgctxt "h90de7629g0bccg4d0fg8ad7gea2ef4ca1fe3"
msgid "The point? Oh, yes - thanks for the reminder."
msgstr "요점? 아, 맞지. 상기해 줘서 고맙네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 878a27b5-f4fe-4d96-9fc7-10a8acef7a10
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:878a27b5-f4fe-4d96-9fc7-10a8acef7a10
msgctxt "h1aab7dacgb17eg411cgbb1bg415fb3fea4b4"
msgid "My pet's been unruly -"
msgstr "우리 강아지가 제 멋대로라서,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 878a27b5-f4fe-4d96-9fc7-10a8acef7a10
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:878a27b5-f4fe-4d96-9fc7-10a8acef7a10
msgctxt "ha22f61a3g8703g45d0g9e02gc1e83b81534a"
msgid ""
"Call me Mizora. I'm Wyll's patron, the fount of his power. My pet's been "
"unruly -"
msgstr "난 미조라란다. 윌의 후원자고 힘을 준 장본인이지. 내 강아지는 제멋대로라서,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Wyll
#. NodeID = 87d2c8c7-8f2e-42d1-aa5d-ab7dcd9c5761
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:87d2c8c7-8f2e-42d1-aa5d-ab7dcd9c5761
msgctxt "h1fb3bca4g3116g4b4eg9cd2g658e52e985fb"
msgid "You told me devils only. She's - a tiefling. Not a monster."
msgstr "데빌이라고만 했잖아. 칼라크는, 티플링이야. 괴물이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Narrator
#. NodeID = 88770b99-696c-4008-a1ac-366f4eca1d28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:88770b99-696c-4008-a1ac-366f4eca1d28
msgctxt "h8d003813gc1c9g422dg95ebgf76a97963f9b"
msgid ""
"*You burn in the fires of Avernus; the lightning storms of Dis strike your "
"flesh. Your soul passes through each layer of the Hells, gaining their "
"essence - and their torment.*"
msgstr ""
"*윌은 아베르누스의 화염 속에서 불타고 디스의 빛 폭풍에 육체를 빼앗깁니다. 영혼은 아홉 지옥을 통과하며 각 층마다의 본질, 그리고 "
"고통을 마주합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 8bd27d9d-187c-4bb9-b9a5-a5062df92b07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:8bd27d9d-187c-4bb9-b9a5-a5062df92b07
msgctxt "hef6df717g82bdg41e2g85e8g1d9fefd94ced"
msgid ""
"Call me [GEN_PlayerName2_85df4a15-4d9b-4f68-0512-d104305d8dac]. Now what in "
"the Nine Hells is going on?"
msgstr ""
"난 [GEN_PlayerName2_85df4a15-4d9b-4f68-0512-d104305d8dac]다. 이제 이게 다 무슨 일인지 설명 "
"좀 해 주실까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Wyll
#. NodeID = 8d9d24fc-4dff-4773-a146-83585c34e6fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:8d9d24fc-4dff-4773-a146-83585c34e6fc
msgctxt "hbbb05a95ge85dg42d7gbde6g4047b3aa271b"
msgid "What the hells have you <i>done</i>?"
msgstr "대체 <i>무슨 짓을</i> 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 92a21d63-23f9-4265-9e2d-6221d3404dad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:92a21d63-23f9-4265-9e2d-6221d3404dad
msgctxt "h197c2fe1g9d03g4cd6gb9efg8f1d2f74a0fb"
msgid "We had a deal, Wyll. But Karlach's still breathing."
msgstr "약속을 어겼잖니, 윌. 칼라크가 아직 살아있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = 9c267084-d97a-47d3-ac93-e949157865c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:9c267084-d97a-47d3-ac93-e949157865c7
msgctxt "hcf914906g92c8g42bag859dg29aa835da770"
msgid "A devil, huh? Not much of a punishment - more like a favour."
msgstr "데빌이라고, 엉? 그다지 처벌은 아닌 것같은데, 오히려 호의에 가깝잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 9ce2b064-e3e7-4f87-93e1-230572167ff8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_PartySize_AtLeast3 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:9ce2b064-e3e7-4f87-93e1-230572167ff8
msgctxt "h429e8538g1e10g406agb418g2709807f1b33"
msgid ""
"You haven't introduced me to your friends. Where <i>are</i> your manners?"
msgstr "너 아직 친구들한테 내 소개를 안 했구나. <i>왜 이렇게</i> 예의가 없니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = 9db97123-a8c3-42bd-ae44-c0a03a9c1a87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:9db97123-a8c3-42bd-ae44-c0a03a9c1a87
msgctxt "hca2f146eg20ccg49d1g88c6gcdda1cc36f88"
msgid "Now? But I'm just getting comfy."
msgstr "벌써? 나 이제야 좀 편해지고 있는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = a0a0420d-436e-492c-a603-da18639bf52f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:a0a0420d-436e-492c-a603-da18639bf52f
msgctxt "h25d6cd2dg4dcfg403eg8b67g91c1149c04f6"
msgid "I'm sorry. I should have obeyed. It won't happen again."
msgstr "미안해. 네 말을 따랐어야 하는 건데. 다시는 이런 일 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = a255b944-b541-4a03-8ec8-a7fc281b7b0e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:a255b944-b541-4a03-8ec8-a7fc281b7b0e
msgctxt "h9a870f2cg9384g44a8g83d6gf1e92030b8e6"
msgid "Karlach. Since when has flattery been in your bag of tricks?"
msgstr "칼라크. 끼 부리는 건 또 언제 배웠니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = a255b944-b541-4a03-8ec8-a7fc281b7b0e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:a255b944-b541-4a03-8ec8-a7fc281b7b0e
msgctxt "h7e9aaa85g4fe5g4a19ga608g0d4bec45b88d"
msgid ""
"You flatterer. Why, if I had a warm heart, I'm sure it would be skipping."
msgstr "끼 부리기는. 그래도 내 심장이 따스했다면 분명 두근두근했겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = a4ba6849-d430-420a-a3a6-f85d4abc2224
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:a4ba6849-d430-420a-a3a6-f85d4abc2224
msgctxt "heaf5dc20gffdfg401ag903eg4e0ca85865bc"
msgid "Damn it all, Wyll. Why didn't you tell me about her?"
msgstr "젠장, 윌. 왜 나한테 저 여자 말을 안 했어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = a90f9958-b064-41eb-9aac-eeef695563d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:a90f9958-b064-41eb-9aac-eeef695563d9
msgctxt "hde34d364g83f3g43b5g83d6gb145d84782c1"
msgid "I'll be keeping mine on you."
msgstr "너는 내가 지켜봐 줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = abfcce1b-4eed-461f-aa73-9c40090c795e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:abfcce1b-4eed-461f-aa73-9c40090c795e
msgctxt "h59fc8742g97d8g4593g8969gafe34d945250"
msgid "How precious. The little pupster's found his bark."
msgstr "깜찍해라. 멍멍이가 짖는 법을 배웠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = adc0bbdd-b264-44df-81da-a8ea22992219
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:adc0bbdd-b264-44df-81da-a8ea22992219
msgctxt "h8878f724gf6a8g43cdga6d5gf49906c1ab87"
msgid "I've heard enough. You're not leaving this place alive."
msgstr "들을만큼 들었어. 넌 살아나가지 못한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = add029cc-e28d-4c4a-8a0c-c930e109c0d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:add029cc-e28d-4c4a-8a0c-c930e109c0d8
msgctxt "h5fac3f7dgf904g4ef4g8f2cg31643c700e8e"
msgid "I say fetch, and he'll fetch. I say kill a fugitive tiefling, and -"
msgstr "내가 물어오라고 하면 물어오고, 또 내가 티플링 도망자를 잡아오라고 하면 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = b04eaacd-9955-4d0e-a921-76d630d769c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:b04eaacd-9955-4d0e-a921-76d630d769c1
msgctxt "he5713d67gf57ag4dedga6d6g39912652dbf9"
msgid "I'll be keeping mine on you."
msgstr "난 널 지켜볼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = b3398dcb-eb3b-90fb-9be3-8089b9da9638
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:b3398dcb-eb3b-90fb-9be3-8089b9da9638
msgctxt "hcabda8e7g679dg4c61ga26agf4457fd8b388"
msgid "You've been defiant - and defiance requires discipline. To wit:"
msgstr "넌 반항적이었어, 그리고 반항에는 훈육이 필요하지. 즉:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = b593571d-cd34-4ece-822d-3b8db6338085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:b593571d-cd34-4ece-822d-3b8db6338085
msgctxt "h3fd53e5eg164eg42d6ga586gab72b4f33194"
msgid "A matter of perspective, I'm sure you'll agree."
msgstr "관점은 사람마다 다르지, 너도 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = b610680a-d7ca-4bd4-aa76-291f4f2de34c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:b610680a-d7ca-4bd4-aa76-291f4f2de34c
msgctxt "h3417360bg97f3g41c2gb87eg2e65f25deacc"
msgid "Since you asked so nicely..."
msgstr "그렇게 예쁘게 물어본다면야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = b7513b2e-1173-44ea-96af-319f0c514884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:b7513b2e-1173-44ea-96af-319f0c514884
msgctxt "hd5686f5eg79a4g4918g975bg6e454c8c1451"
msgid "An ungracious warlock. <i>So</i> unbecoming."
msgstr "워락 주제에. <i>정말</i> 무례한 행동이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = b8515840-6593-6260-54bb-b0c60f57842d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:b8515840-6593-6260-54bb-b0c60f57842d
msgctxt "h50fb5470g1f91g4aeegb2abgf22e71546fd9"
msgid "Oh - and Wyll? Don't forget. Our pact still stands. Ta-ta!"
msgstr "그리고 윌? 잊지 마. 우리 계약은 여전히 유효해. 빠빠이!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = b8f6dc3e-048a-40c5-b177-59c2b25614ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:b8f6dc3e-048a-40c5-b177-59c2b25614ef
msgctxt "h416dd8d6g63d8g4c26g97efga5ad5a71b62c"
msgid "Get on with it, devil. What do you want?"
msgstr "계속해봐, 데빌. 원하는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = bcc9090f-d79d-487b-ba93-ca64fd8e8c9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:bcc9090f-d79d-487b-ba93-ca64fd8e8c9f
msgctxt "h50da1348gdcc9g4fd3g999bgb5303e05caed"
msgid "A promise broken, a price paid. You know the terms."
msgstr "네가 약속을 어겼으니, 대가를 지불한 거야. 그게 계약이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = bea300e5-c96e-448c-b0fd-ce78f08afaa6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - KARLACH(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:bea300e5-c96e-448c-b0fd-ce78f08afaa6
msgctxt "he7d48707g15b8g433dg8449g18f911e8c3ed"
msgid "Karlach. Keep an eye on him, would you?"
msgstr "칼라크, 윌을 잘 보고 있으렴, 알겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = bec39063-6715-552b-d882-7b3629a65534
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:bec39063-6715-552b-d882-7b3629a65534
msgctxt "h30bcc594g8821g4b8dga0bfga0288c421ab1"
msgid ""
"I've got some errands to do - but don't you fret much, pup. I'll be back in "
"three shakes of your tail."
msgstr "난 가 볼게. 볼 일이 좀 있어서. 너무 안달 내지 마, 멍멍아. 꼬리 몇 번 휘젓기도 전에 돌아올 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = bf51e841-c85c-4eef-b272-57557bc204e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:bf51e841-c85c-4eef-b272-57557bc204e9
msgctxt "ha1405bcfgc572g4f86g8198ga71aa5822c29"
msgid ""
"Kill me? I wouldn't recommend it. I die, and Wyll turns to a lemure and gets "
"sucked right down to the Hells."
msgstr "날 죽이려고? 그리 추천하진 않는데. 내가 죽으면 윌은 레무어로 변해서 바로 지옥으로 빨려 들어갈 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = c5acf822-bd72-44da-ac7a-a0f5cc1e4f03
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizorasJudgement_Event_Secret(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:c5acf822-bd72-44da-ac7a-a0f5cc1e4f03
msgctxt "h515cc17fgd952g45bagb018gc0574cc7d6f4"
msgid ""
"He's the Blade of Frontiers. 'Devil's plaything' just doesn't have the same "
"ring."
msgstr "윌은 변경의 칼날이잖니. '데빌의 장난감'이라고 하면 느낌이 안 사니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = c73195d1-91db-4dc7-87ae-d23877759fb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:c73195d1-91db-4dc7-87ae-d23877759fb0
msgctxt "h123a9130g9c52g4739g8411g3215c9ed167c"
msgid "I'm supposed to be hunting devils, not refugees."
msgstr "내게 데빌을 사냥할 거라고 했잖아, 도망자가 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Karlach
#. NodeID = cb535c3f-1b70-415b-9059-f9e65f1dd026
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#. SetFlags:
#.   Local:
#.     - 5bdcfef6-87f6-ea58-a947-73fe030abca7_KarlachInclusion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:cb535c3f-1b70-415b-9059-f9e65f1dd026
msgctxt "h926e35bcg511dg4dc2g8b6cg5aab450313f0"
msgid ""
"I've taken more pleasant shits than you, Mizora, and at least those can be "
"buried after."
msgstr "넌 내가 싼 똥보다 못한 년이야, 미조라. 똥은 최소한 땅에 묻을 수 있기라도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = cb78c133-592c-13cd-4ef9-23f163e8654a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:cb78c133-592c-13cd-4ef9-23f163e8654a
msgctxt "hf7acfbf2gaa04g45d8ga57dg705190344864"
msgid "Karlach meets the criteria by virtue of having no heart."
msgstr "칼라크는 심장이 없으니, 이 기준에 부합하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = cbc30558-495c-47e6-97ca-a715f10c0b8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:cbc30558-495c-47e6-97ca-a715f10c0b8f
msgctxt "h4c23dee2g7cc2g4f9fg807cg52bdd89a7574"
msgid "You should be."
msgstr "두려워 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = d168fbcc-9d0f-4f6e-ba86-b06ac0640915
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:d168fbcc-9d0f-4f6e-ba86-b06ac0640915
msgctxt "h8547a3a8g7d4bg4d0dg9a72g5d4aaeed1172"
msgid "How precious. The little pupster's found his bark."
msgstr "깜찍해라. 멍멍이가 짖는 법을 배웠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = d2ffe70a-7f98-4da7-b9d7-5efa742fee66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:d2ffe70a-7f98-4da7-b9d7-5efa742fee66
msgctxt "h0b3179f0g7b9dg483eg9c66g97a150ab69c9"
msgid "Godsdamned devil. Get out of my camp!"
msgstr "망할 데빌. 내 야영지에서 나가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = d49736d4-4fb3-490f-ad34-1c215521a897
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:d49736d4-4fb3-490f-ad34-1c215521a897
msgctxt "h04d69c8cgb232g4264gb878g1b889d397c21"
msgid "Come on. I've earned more than just the one power."
msgstr "왜 이래. 이것보단 더 줄 수 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = dd5dcdbf-dd26-4a3d-1d37-b3a53e544d68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:dd5dcdbf-dd26-4a3d-1d37-b3a53e544d68
msgctxt "h8cb25051gd420g4dd8ga975gdd5c741c2ab2"
msgid "Oh, I almost forgot..."
msgstr "아, 까먹을 뻔 했네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = e1caddb8-e68b-46fc-a842-f324f27eb8bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:e1caddb8-e68b-46fc-a842-f324f27eb8bb
msgctxt "h3920df4eg2896g483fgba15g4f2a939faa4f"
msgid "Just who in the Nine Hells are you?"
msgstr "넌 뭐 하는 녀석이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = e4dd5299-12b1-4f2c-9a75-f1cc23d8ba24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Karlach_State_Dead = True
#.      - ORI_WyllConfrontation_State_ResolvedPeacefuly = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:e4dd5299-12b1-4f2c-9a75-f1cc23d8ba24
msgctxt "h095b284egdb10g4750gae44geff2044c2203"
msgid "Wyll, buddy. I thought it was time I drop by the doghouse."
msgstr "안녕, 윌. 개집에 한 번 들를 때가 된 것 같더라구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = e4fb4865-886f-431d-af0e-26cf911eb4c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:e4fb4865-886f-431d-af0e-26cf911eb4c6
msgctxt "h1917b8a9g08c2g441ag806bg7e8fce035737"
msgid "You won't be waiting long."
msgstr "오래 기다리지 않아도 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = e59e9434-bfb6-413e-82c0-527f297f3fa6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_MizorasJudgement_Event_Secret(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:e59e9434-bfb6-413e-82c0-527f297f3fa6
msgctxt "h8d6c8f72gb071g4a5cg9c23g77a6e9679284"
msgid ""
"Wyll, you absolute stinker! You kept me a secret? Time to let the hellcat "
"out of the bag."
msgstr "윌, 이 나쁜 것! 내 얘기도 안 했니? 이제 비밀을 꺼내놓을 시간이란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = e792ed4f-dca3-456b-ac6a-c49867ad7e5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:e792ed4f-dca3-456b-ac6a-c49867ad7e5b
msgctxt "hdb19aaeagf7c3g47f5gadd0g6c3257b32f86"
msgid "Get to the point, devil. What do you want?"
msgstr "요점을 말해, 데빌. 원하는 게 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Karlach
#. NodeID = e7dd144c-736f-47e7-b549-7b63c2c13e53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#. SetFlags:
#.   Object:
#.     - CAMP_MizorasJudgement_CFM_KarlachPresent(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:e7dd144c-736f-47e7-b549-7b63c2c13e53
msgctxt "h76bca5cdgd87ag4f69gafb7g59fa38210aba"
msgid "Gods damn it. <i>Anyone</i> but her."
msgstr "제기랄. <i>하필</i> 저년이라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = ebd45343-b16a-4648-8c2a-cd55da14ccee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:ebd45343-b16a-4648-8c2a-cd55da14ccee
msgctxt "h164b4164g0014g4599g9304g5beae9f3b81d"
msgid "Well. I can trust it'll get done."
msgstr "뭐. 해낼 거라고 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = ebfcb40c-5fa7-4bef-8b5b-53ebf90c2546
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:ebfcb40c-5fa7-4bef-8b5b-53ebf90c2546
msgctxt "hbda906b2g03c2g48a2g8e6dgbf9be37775ee"
msgid "You've been a bad boy, Wyll. I'd say your leash needs a <i>yank</i>."
msgstr "넌 나쁜 아이였어, 윌. 이젠 네 목줄을 <i>당겨</i>야 겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = ecdf2ad0-c05f-4ca2-a31f-ca6f2e8f4d33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:ecdf2ad0-c05f-4ca2-a31f-ca6f2e8f4d33
msgctxt "hb3f3e631g3114g41c3ga23dg9b63470fbca6"
msgid "Well, well. Aren't <i>you</i> a luscious thing?"
msgstr "이런, 이런. 정말 매력적인 <i>분</i>이시네?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Karlach
#. NodeID = ed1b33fc-ed08-4e48-a30e-116347e7e686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:ed1b33fc-ed08-4e48-a30e-116347e7e686
msgctxt "h3066d5f5g37c0g4d6agadc8g4d3c7b020359"
msgid "<i>What?!</i>"
msgstr "<i>뭐?!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = ee5491a2-e53b-4af6-a727-5cfcbd662ae6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:ee5491a2-e53b-4af6-a727-5cfcbd662ae6
msgctxt "h379baf91g29afg4fa0g9eb0g91bbd6fbab91"
msgid "Now? Too late, flower. You'll <i>never</i> be rid of me."
msgstr "지금? 너무 늦었어, 예쁜아. 나한테서 <i>절대</i> 벗어나지 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = f0b99960-a9e8-85ac-aeec-975f8968520b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f0b99960-a9e8-85ac-aeec-975f8968520b
msgctxt "h6dac4ca2g59f7g44ebg9a14g00292aa897ac"
msgid ""
"Get used to the new form, pet - there's no going back. Some magic, even I "
"can't undo."
msgstr "새로운 모습에 적응하렴, 멍멍아. 돌이킬 방법은 없으니까. 어떤 마법은 나도 되돌릴 수가 없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = f38f8f29-e612-4b9e-b881-6a9fe14271ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f38f8f29-e612-4b9e-b881-6a9fe14271ee
msgctxt "hf370e829ga1e6g41e9gabe9g4ac3ccabc6f3"
msgid "You said my targets were monsters. But Karlach's no monster."
msgstr "죽일 건 괴물이라고 했잖아. 칼라크는 괴물이 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = f3e9e757-5cfa-4329-96bf-a54b75dc5bbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f3e9e757-5cfa-4329-96bf-a54b75dc5bbe
msgctxt "h2f5a5aaag5d63g4d3ag85e3g5df4ec155e10"
msgid "What do you want, Mizora?"
msgstr "원하는 게 뭐지, 미조라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = f5aa15b8-370a-4180-b84b-f05ed616a662
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f5aa15b8-370a-4180-b84b-f05ed616a662
msgctxt "h6ecf39a9gab58g4d9fg94b7gd07b76f1bfa0"
msgid ""
"<i>Handler's</i> the word, if it's all the same. Call me Mizora - your dear "
"friend Wyll is my little puppy -"
msgstr "괜찮다면, <i>조련사</i> 라고 불러도 돼. 미조라라고 하고, 네 친구 윌은 내 귀여운 강아지,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = f66a519b-c666-4e89-94d2-f94b4790e15a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f66a519b-c666-4e89-94d2-f94b4790e15a
msgctxt "h7b13f9cfgc52dg4dcfg9c18g8e4b857ad00c"
msgid "Godsdamned devil. Get out of my camp!"
msgstr "망할 데빌. 내 야영지에서 나가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = f76998ff-910f-bd4d-0a49-34e178479bae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f76998ff-910f-bd4d-0a49-34e178479bae
msgctxt "h48c19d07g41d7g40cfgbaa2g279386fbabe5"
msgid "But I'll be damned if it goes pissing on mine."
msgstr "내 거에도 멋대로 싸지르려고 하면 가만 안 두겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = f882396b-1e6e-4dd4-9162-9354a9cbd4cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f882396b-1e6e-4dd4-9162-9354a9cbd4cb
msgctxt "ha0ec7afag47fbg4320gbc8egeb35bebaa6e7"
msgid "I did what you asked. It's time for my reward."
msgstr "네가 하란대로 했어. 이제 보상을 받을 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = f9267dfa-fe81-8985-454a-596287eda32a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:f9267dfa-fe81-8985-454a-596287eda32a
msgctxt "hc53c8decg8702g4e15ga89fg4b1ee97fd650"
msgid "Karlach meets the criteria, pet. Trust me on this."
msgstr "칼라크도 거기 포함이란다, 아가야. 믿어도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = fd5fdda5-d18e-452f-a678-0b2d926f4675
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:fd5fdda5-d18e-452f-a678-0b2d926f4675
msgctxt "h0027ca96ge7f8g452agb061gd1f1d302646b"
msgid "Well. I don't need to tell <i>you</i>."
msgstr "뭐. <i>너</i>에게 더 말할 필요는 없겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Mizora
#. NodeID = fdf50fc0-843c-4a9d-8bfd-ea40146709a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:fdf50fc0-843c-4a9d-8bfd-ea40146709a4
msgctxt "hc07ad925ga886g4902gbd10gc2c866ab917e"
msgid "Ta-ta!"
msgstr "빠빠이!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM
#. Speaker = Player
#. NodeID = ff637042-1c6c-47b5-b611-375b0b21e26a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_MizorasJudgement_CFM_InclusionHappened(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasJudgement_CFM:ff637042-1c6c-47b5-b611-375b0b21e26a
msgctxt "h2f61a26cg9672g4ea7g89aegaf077961daac"
msgid "Do whatever you want with me. But leave my friends alone."
msgstr "나한텐 무슨 짓을 해도 상관없지만, 내 친구들은 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 033f0dc5-6a15-9b0a-eeed-29d933a0dcf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:033f0dc5-6a15-9b0a-eeed-29d933a0dcf4
msgctxt "hc9548f1cgc779g413fg96e1g1ca446484cae"
msgid ""
"I had no hand in your father's death, Wyll. But that doesn't mean he might "
"not still live."
msgstr "난 그 일 하고는 아무 관련 없어. 하지만 나라면 네 아빠를 살릴 수 있을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 0a97bd06-1075-c6d7-e886-c5e1ecd1da81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:0a97bd06-1075-c6d7-e886-c5e1ecd1da81
msgctxt "h06f47ac7gfad4g4010gac30g7cba2a7f1cdd"
msgid ""
"<i>Option one. I raise your father from the dead. <b>And you pledge your "
"soul to me and the archdevil Zariel in a pact eternal.</b></i>"
msgstr ""
"<i>첫 번째 경우. 내가 네 아빠를 되살려 준다. <b>하지만 너는 나와 아크데빌 자리엘 님과 영원한 계약을 맺고 우리에게 네 영혼을 "
"바친다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Duke Ulder Ravengard
#. NodeID = 0aff5b1e-028d-94e8-5db6-f477577265ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:0aff5b1e-028d-94e8-5db6-f477577265ae
msgctxt "h525dbb48g0dddg4303g992dg90410ba0a571"
msgid "What - what's happened? Wyll. Is that you?"
msgstr "어... 어떻게 된 거지? 윌? 너니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 0d0d6525-2bdc-8924-35c4-66e0dcb6a21f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:0d0d6525-2bdc-8924-35c4-66e0dcb6a21f
msgctxt "hce933d61g0a8fg4b35gb05dg95e8185984e0"
msgid "Bring back your father, Wyll. The city will need him to help rebuild."
msgstr "아버지를 되살려 드려, 윌. 도시를 재건하려면 그분이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 0fd535a5-919f-17b5-859b-e7b22c8bd312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:0fd535a5-919f-17b5-859b-e7b22c8bd312
msgctxt "h09daa651g4c67g4f93gb5c5gaba7d40509b3"
msgid ""
"You do not call upon the Sisters. They come when the Hells demand witness."
msgstr "이 아이들은 그냥 부를 수 있는 게 아니야. 지옥의 의식에서 증인이 있어야 할 때 나타나지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 1647eb0d-430d-1dee-cde0-3aac429c99c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:1647eb0d-430d-1dee-cde0-3aac429c99c1
msgctxt "hca790325gbd4cg4532g97dcg0bc8eaadcb81"
msgid "Your father is dead, Wyll. The Dead Three have claimed their prize."
msgstr "네 아빠는 돌아가셨어, 윌. 삼악신의 전리품으로써 취해졌지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 1b3ff4f3-b855-ce24-d55a-004eea804d02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:1b3ff4f3-b855-ce24-d55a-004eea804d02
msgctxt "h24c395b4g4d91g44aeg9962g1b1f511333c3"
msgid "Not for the greater good, you understand. Just for the entertainment."
msgstr "뭐 도와주려는 건 아니고. 그냥 그게 재밌을 것 같아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 1e7d3fb0-286c-b783-52b4-ca9182b4d8f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:1e7d3fb0-286c-b783-52b4-ca9182b4d8f1
msgctxt "hd7a281cegc987g4054gbb12g0f983618bcba"
msgid "It's me, father. It's all right. You're safe here."
msgstr "저예요, 아버지. 괜찮아요. 여긴 안전해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 1fceeb30-9ed5-ff28-d9e7-f4cc0afa36bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_Knows_KilledDuringIRNDestruction = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:1fceeb30-9ed5-ff28-d9e7-f4cc0afa36bf
msgctxt "ha5408cbbg6e53g4e1bgbd46ga6fd3aa6ff13"
msgid "Come to gloat, Mizora? We found a letter claiming Ravengard died."
msgstr "자랑이라도 하러 왔나, 미조라? 우린 이미 레이븐가드의 죽음을 알리는 편지를 봤다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 2ab63cbc-880a-4b21-0071-28a6e4a09f6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:2ab63cbc-880a-4b21-0071-28a6e4a09f6f
msgctxt "h0674f977g6ad8g4fbcga360g2462f5cdcd4b"
msgid "What are you proposing?"
msgstr "제안할 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 2c22bfad-83fc-8b10-569c-10ee5c67bbf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:2c22bfad-83fc-8b10-569c-10ee5c67bbf6
msgctxt "h9a5bbb1fg172bg4a6egbddeg9e34ecc026c8"
msgid "Dead? Godsdamn <i>wretches</i>!"
msgstr "돌아가셨다고? <i>이런 빌어먹을</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 2f169768-e183-5022-b4f0-25f643550654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:2f169768-e183-5022-b4f0-25f643550654
msgctxt "h3dff8329g1898g4919gafe4gb366cd0be66f"
msgid "Do the right thing. Give your soul so that your father can live."
msgstr "옳은 일을 해. 네 아버지를 살릴 수 있도록 영혼을 바쳐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 305f9550-4d20-f1fc-f8c2-629e136b08ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:305f9550-4d20-f1fc-f8c2-629e136b08ae
msgctxt "hca80ea58g5fbcg4e0eg81edg93d9454cb318"
msgid "What will happen to Wyll's powers if he breaks the pact?"
msgstr "게약이 끝나면 윌의 힘은 어떻게 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 34701f12-4036-c8ba-e0f9-3f9da52a715f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:34701f12-4036-c8ba-e0f9-3f9da52a715f
msgctxt "hb982940bg0c86g4c73gb8a8gc23f8058d3f4"
msgid "You damned <i>wretch</i>. Father..."
msgstr "이 <i>망할 년</i>. 아버지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 347ebd05-d697-c82b-68db-607cd1e2c85a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MizorasPact_State_WyllEternalPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:347ebd05-d697-c82b-68db-607cd1e2c85a
msgctxt "h87a2001cg6e9ag42d1g9701g58606c099dcc"
msgid "You always were your father's son."
msgstr "그 아빠에 그 아들이라니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 36982100-58a0-595c-eb80-5220edfe4643
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:36982100-58a0-595c-eb80-5220edfe4643
msgctxt "h18f54be5geb39g4220g9339g476e9f397c3b"
msgid ""
"I've no reason to lie. He's gone - for good, some might say. But not every "
"death is forever."
msgstr "내가 왜 거짓말을 하겠어. 그리고 네 아빠가 돌아가신 건 맞지만, 아직 방법이 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 36b0c593-cb8b-f75b-c7a2-e520499345ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:36b0c593-cb8b-f75b-c7a2-e520499345ba
msgctxt "h11226ceag7358g4804gb3e3g5b27fc31735b"
msgid "Please, introduce me to your friends."
msgstr "부탁이야, 친구들 소개 좀 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 3725b923-00e7-4279-ad04-595666ded1c6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MizorasPact_Event_PactScene = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:3725b923-00e7-4279-ad04-595666ded1c6
msgctxt "hf14087efg103cg4005gb21fgf7bd7c60dca0"
msgid "<i>Sorores surge. Testis esto pacti mei.</i>"
msgstr "<i>소로레스 수어제. 테스티스 에스토 파크티 메이.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 37f48de1-ad6f-4d61-9809-cc1ca5d1e381
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:37f48de1-ad6f-4d61-9809-cc1ca5d1e381
msgctxt "h85c8fddfga545g447bg888egf3724e6c612a"
msgid ""
"<i>Option one. I raise your father from the dead. <b>And you pledge your "
"soul to me and the archdevil Zariel in a pact eternal.</b></i>"
msgstr ""
"<i>첫 번째 경우. 네 아버지를 죽음에서 되살려내 준다. <b>하지만 너는 나와 아크데빌 자리엘 님과 영원한 계약을 맺고 우리에게 네 "
"영혼을 바친다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 3a7f6e6a-3934-faf0-db1b-56c4bbb898ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:3a7f6e6a-3934-faf0-db1b-56c4bbb898ad
msgctxt "h7c0432cag6bc5g4eb4gbd5cg8cdff90fd5da"
msgid "Feena, Cirrus. Arbiters for the Hells, exemplars of justice."
msgstr "피나랑 시루스야. 지옥의 중재자이자 균형의 집행자들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 3f9e33ac-1346-fa2f-1d4a-483fef04cfcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:3f9e33ac-1346-fa2f-1d4a-483fef04cfcd
msgctxt "haef87a83g5b36g4459gabafgc98381642ce0"
msgid "Take my father's soul. When the city's free, I will take his place."
msgstr "아버지의 영혼을 가져가라. 도시가 자유로워지고 나서 내가 그 자리에 서면 되니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 44d15f5d-500b-f061-3d68-3ab8b71cbcfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:44d15f5d-500b-f061-3d68-3ab8b71cbcfc
msgctxt "h60870209gea0bg4b78gb6d5g5254840b8b4a"
msgid "Sisters."
msgstr "자매들이여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 4615fb99-00c2-87dd-bb52-27dad0b720f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MizorasRescue_Event_ConvincedMizora = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:4615fb99-00c2-87dd-bb52-27dad0b720f5
msgctxt "h2ac405f7g926bg4a6eg8ec0g0f56523f8a3c"
msgid "Then break it now, Mizora. I don't need to wait six months."
msgstr "그럼 빨리 끝내. 6개월이나 기다리진 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Narrator
#. NodeID = 4636da08-83c6-a2b8-9715-d5625a27a0a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:4636da08-83c6-a2b8-9715-d5625a27a0a5
msgctxt "h231e576dgc53bg4c26gb2dag46e57301c57f"
msgid ""
"*Your mind connects to the Grand Duke's. He is still infected, but his "
"parasite is weak, shielded from the Absolute by the Astral Prism.*"
msgstr ""
"*당신의 마음이 대공과 연결됩니다. 아직 감염된 상태지만, 기생충은 약해져 있고 아스트랄 프리즘 덕에 절대자로부터 보호받고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 4ab85159-5366-b51d-e7c2-ca855c8b218b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:4ab85159-5366-b51d-e7c2-ca855c8b218b
msgctxt "hed335539gc393g4106g9c4cg659ca34577a0"
msgid "I come to bargain. The Hells demand witness."
msgstr "거래하러 왔어. 그리고 지옥의 의식엔 증인이 필요하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 53d6f4f9-da82-7a6b-ad7a-ed45b0095479
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:53d6f4f9-da82-7a6b-ad7a-ed45b0095479
msgctxt "h9ab43d1egaaabg4481gb0c9g394951d98349"
msgid "I come to bargain. The Hells demand witness."
msgstr "거래하러 왔어. 그리고 지옥의 의식엔 증인이 필요하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 54340edf-df4e-b5ea-ff58-b46ddbf5b04e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4f447e82-47bf-9d85-b393-210cb75f2e6e_PassedArcana = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:54340edf-df4e-b5ea-ff58-b46ddbf5b04e
msgctxt "haee9adc9g7bf0g4129gbfa1g3ada7200ab92"
msgid ""
"Interesting. I don't recall sending out invitations to the Sisters of "
"Justice."
msgstr "재밌군. 균형의 자매를 초대한 기억은 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 5ccc2639-58d6-a588-5674-6ed11fd995d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#.      - WYR_MeetingMizora_Event_WyllPresent = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:5ccc2639-58d6-a588-5674-6ed11fd995d9
msgctxt "hc040cb9bg48dfg43dcg994eg185542c4a50c"
msgid "Enough, Mizora. My father is dead. Say your piece."
msgstr "관둬, 미조라. 아버지는 돌아가셨어. 용건을 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 5e789469-4fa5-7cb7-795d-61513bda1c7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:5e789469-4fa5-7cb7-795d-61513bda1c7a
msgctxt "h51b11611ge259g4909g95f0ga8eafc1b9e4d"
msgid "Break the pact, Wyll. You deserve your freedom."
msgstr "계약을 끝내, 윌. 넌 자유로워질 권리가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 5eb62083-2d5f-281d-ce90-453ddb06182d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:5eb62083-2d5f-281d-ce90-453ddb06182d
msgctxt "ha80f8b1bgf1a4g4972ga343g16951fec550c"
msgid ""
"You know, I think I'll stick around, watch this play out. I could use the "
"entertainment."
msgstr "그리고 있지, 나 한동안은 여기에 있을까 봐. 어떻게 돌아가나 구경도 하고. 재미있을 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 5fb5a93c-fc60-4875-f331-02defeeea63f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:5fb5a93c-fc60-4875-f331-02defeeea63f
msgctxt "hf225d106gf4b9g4624ga124g93be8d5d6a2b"
msgid ""
"<i>Option one. I show you the way to your father. I guarantee him no harm "
"except that from you and your allies. <b>And you pledge your soul to me and "
"the archdevil Zariel in a pact eternal.</b></i>"
msgstr ""
"<i>첫 번째 경우. 네 아버지에게 가는 길을 알려준다. 너와 네 동료 말고는 아무도 그를 해칠 수 없을 것이다. <b>하지만 너는 나와 "
"아크데빌 자리엘 님과 영원한 계약을 맺고 우리에게 네 영혼을 바친다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 6101c9af-907f-8c22-1c88-a883fc3b73b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:6101c9af-907f-8c22-1c88-a883fc3b73b3
msgctxt "h6719a0cdg664fg49b8g9cbdgf842b94fdb1a"
msgid ""
"You do not call upon the Sisters. They come when the Hells demand witness."
msgstr "이 아이들은 그냥 부를 수 있는 게 아니야. 지옥의 의식에서 증인이 있어야 할 때 나타나지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 64a508aa-f7f7-c9a0-78a4-e03f2d62f707
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:64a508aa-f7f7-c9a0-78a4-e03f2d62f707
msgctxt "h799739c8g2d21g44degbeddg6dc468d5a88d"
msgid ""
"Your contract, Wyll. Signed in blood, forged in fire, bound in bone - but "
"not unbreakable."
msgstr "네 계약이야, 윌. 피로 서명하고, 불로 연단해서, 뼛속 깊이 결속되었지만... 끝낼 수는 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 64ab7528-ae36-10e4-2f4b-eae99cba4a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:64ab7528-ae36-10e4-2f4b-eae99cba4a68
msgctxt "h7af9eae4gf943g4e22gb0d4gb5ad8c720c38"
msgid "<i>Fiat ita.</i>"
msgstr "<i>피아트 이타.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 673c77cb-1c8d-8982-6de3-1a305e48fe2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:673c77cb-1c8d-8982-6de3-1a305e48fe2e
msgctxt "hdf9e5676g6f15g45fdg8094gfa38fddf1dcd"
msgid "I'm the Blade of Frontiers, godsdammit. Take my soul, not his."
msgstr "난 변경의 칼날이라고. 아버지 대신 내 영혼을 가져가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 6a7cb453-529f-758d-0055-6db9161442c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:6a7cb453-529f-758d-0055-6db9161442c8
msgctxt "h31079775gf1f8g4697g82b6g353a20a4ee88"
msgid "A promise made, a promise kept."
msgstr "난 약속한 건 지켜."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 6e40e3bc-52b4-118f-d5d8-da83825f08d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:6e40e3bc-52b4-118f-d5d8-da83825f08d8
msgctxt "h236444f5geb2eg42c0g8044gbc54c5bb780e"
msgid "Didn't think you had it in you. Seems my boy's all grown up."
msgstr "그런 면이 있는 줄은 몰랐어. 우리 아기 다 컸구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Karlach
#. NodeID = 7013d664-7a55-1844-5e9c-b3c40579bc78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#. SetFlags:
#.   Local:
#.     - 4f447e82-47bf-9d85-b393-210cb75f2e6e_KarlachInclusion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:7013d664-7a55-1844-5e9c-b3c40579bc78
msgctxt "hd2699859ge13dg42c1gbaddgd1ea7bba329d"
msgid "Bloody Zariel. I won't let her take Wyll!"
msgstr "자리엘 이 씨발년. 윌을 데려가게 두진 않겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 70457890-533f-261f-a034-7afd4f5d211f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_MeetingMizora_Event_MizoraLeftWYR = True
#.   Script:
#.      - GLO_Ravengard_AliveOrUnknownIRNState = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:70457890-533f-261f-a034-7afd4f5d211f
msgctxt "h28b4ac54g729ag419cgae90ge94519c2aa53"
msgid "Enough games - they took my father. Now what?"
msgstr "수작질 그만해. 놈들이 아버지를 데려갔다. 이제 어떻게 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 7228445d-b8f1-addb-b7de-35fb06957785
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:7228445d-b8f1-addb-b7de-35fb06957785
msgctxt "h5595bae5g37fbg4604ga470g681bdc6e9882"
msgid "<i>Choose.</i>"
msgstr "<i>선택해라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 73a503f9-f2ec-23a7-a5a3-7ce48b292748
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#.      - WYR_MeetingMizora_Event_WyllPresent = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:73a503f9-f2ec-23a7-a5a3-7ce48b292748
msgctxt "h7ae93ba7g2154g4998gb875g8b347830a1c5"
msgid "Father is dead? Godsdamned <i>devil</i>. Why are you here?"
msgstr "아버지가 돌아가셨다고? 이 망할 <i>데빌</i>. 여긴 왜 온 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 75435b6d-5bd8-de3f-ea19-f78bded6dfdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:75435b6d-5bd8-de3f-ea19-f78bded6dfdc
msgctxt "h3ec4ad19g3ffag4278ga77egb2e7b4adf6c3"
msgid ""
"And don't go fussing about your father. You made your choice, you knew the "
"terms."
msgstr "그럼, 이제 아버지 얘기 꺼내면서 징징대지는 마. 네가 선택한 길이고, 약관이 뭔지도 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 77167f02-55e5-a196-740f-50229e5399b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:77167f02-55e5-a196-740f-50229e5399b9
msgctxt "he600a9adg629fg4b70g9c99gd6cfdd5e8023"
msgid "Please, introduce me to your friends."
msgstr "친구들한테 내 소개 좀 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 78c82605-e77e-d107-f545-1eae54f05b22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4f447e82-47bf-9d85-b393-210cb75f2e6e_PassedArcana = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:78c82605-e77e-d107-f545-1eae54f05b22
msgctxt "hfd554ad2g1e98g45e9ga526g73451c59b3c5"
msgid ""
"Interesting. I don't recall sending out invitations to the Sisters of "
"Justice."
msgstr "재밌군. 균형의 자매를 초대한 기억은 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 7b8eeb68-f41e-c9c2-2406-e6908b5f7616
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Wyll_Quest_RescueRavengardIRN = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:7b8eeb68-f41e-c9c2-2406-e6908b5f7616
msgctxt "h34ce8c46gc1eag4e82gb991g94eaa2d5e9de"
msgid "Seems you've got a new mission, pup: go save your father."
msgstr "새 할 일이 생긴 것 같네, 멍멍아. 아버지를 구하러 가렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 7d722354-0a66-392e-1cee-f05407957af0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:7d722354-0a66-392e-1cee-f05407957af0
msgctxt "h87b21ff3gbba6g4b69ga4c6ga2bbd6527f40"
msgid ""
"<i>Option one. I show you the way to your father. I guarantee him no harm "
"except that from you and your allies. <b>And you pledge your soul to me and "
"the archdevil Zariel in a pact eternal.</b></i>"
msgstr ""
"<i>첫 번째 경우. 내가 네 아빠에게 가는 길을 알려주고, 너와 네 동료 말고는 아무도 그를 해칠 수 없게 막아준다. <b>하지만 너는 "
"나와 아크데빌 자리엘 님과 영원한 계약을 맺고 우리에게 네 영혼을 바친다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 7d8b26ae-0501-bb11-8e1e-1a04312f2ad9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:7d8b26ae-0501-bb11-8e1e-1a04312f2ad9
msgctxt "h775951c1g8873g4ddagbca0g3e3a2cf2c074"
msgid "Mizora, you <i>arsehole</i>."
msgstr "미조라, 이 <i>나쁜 년</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 7dec9315-d696-7b0c-95a6-24c3f3d16a39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:7dec9315-d696-7b0c-95a6-24c3f3d16a39
msgctxt "hc9ffffe0gf7c3g40f5g9d81g47a02d9ed315"
msgid ""
"Yet no contract is ended without sacrifice, Wyll. The cost must be paid."
msgstr "하지만 계약을 끝낼 땐 희생이 따르는 거야. 항상 그 대가를 치러야 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 7e715422-dcec-42fe-478a-f6cb42ff4adb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:7e715422-dcec-42fe-478a-f6cb42ff4adb
msgctxt "haadf68f8g9198g4ed8gbabcgfbe5b36823e3"
msgid ""
"<i>Option two. I break your pact, and you are freed from your duty. <b>Your "
"father remains dead, and Baldur's Gate loses its greatest champion.</b></i>"
msgstr ""
"<i>두 번째 경우. 계약을 끝내고 네 의무로부터 해방해 준다. <b>하지만 네 아빠는 여전히 죽어있는 상태고, 발더스 게이트의 가장 "
"위대한 투사는 사라진다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 80158829-6c18-c7fa-54f2-94c3d91c10e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:80158829-6c18-c7fa-54f2-94c3d91c10e2
msgctxt "he7781c08g1f15g49fbg90ecg07d33d1282b1"
msgid ""
"I am not so easy to be rid of. I come to bargain, and the Hells demand "
"witness."
msgstr "난 쉽게 떨쳐낼 수 있는 여자가 아니거든. 거래하러 왔어. 그리고 지옥의 의식에는 증인이 필요하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 8221aefa-85c2-3e5d-a552-4b279ffabf1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:8221aefa-85c2-3e5d-a552-4b279ffabf1d
msgctxt "h93adc1cdg5083g472fg9412gaa2772d9f663"
msgid ""
"Lucky for you, I know the way in. I'll mark your map - after all, a deal's a "
"deal."
msgstr "다행히 내가 길을 알고 있지. 네 지도에 표시해 줄게. 거래는 거래니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 842c16d3-cb41-3398-5450-c2ce6edcb6a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:842c16d3-cb41-3398-5450-c2ce6edcb6a2
msgctxt "hb08e832bgc965g473fgab53g40f5d47342be"
msgid "Come, Sisters, be my testament. <i>Notum sit in Baator.</i>"
msgstr "와라, 자매들이여. 나의 증언이 되어다오. <i>노툼 싯 인 베이아터.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 86c8e6cf-e003-38fd-bb72-7827a85f0e66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:86c8e6cf-e003-38fd-bb72-7827a85f0e66
msgctxt "h2fca2315g234fg4f0bgb7e3g8a3e231d27f8"
msgid "<i>Remain silent.</i>"
msgstr "<i>묵묵히 있는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 8822484c-5388-0073-5387-04f3552c8657
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:8822484c-5388-0073-5387-04f3552c8657
msgctxt "h046c209ag2df9g4c21ga5c6g474d01cb3e27"
msgid "Do it, then. Claim my soul for Zariel. Bring my father back."
msgstr "그렇게 해. 자리엘에게 내 영혼을 바치지. 아버지를 되살려 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 89593bd3-7700-fe8d-452a-48b72563a0f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_KilledOffScreenAfterCeremony = False
#.   Script:
#.      - GLO_Ravengard_PlayersKnowRavengardIsDead = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:89593bd3-7700-fe8d-452a-48b72563a0f7
msgctxt "hd19128acg82a2g4af6gaa0agb43687b13611"
msgid "Enough games - my father is dead. There must be something you can do."
msgstr "수작질 집어치워. 아버지가 돌아가셨다. 네가 할 수 있는 게 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = 8a1f3c92-8332-694a-5fa3-ca5d0752077e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:8a1f3c92-8332-694a-5fa3-ca5d0752077e
msgctxt "ha090cc1fg8567g4c8egbdffg56a529583a78"
msgid "Holy hells."
msgstr "맙소사."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 8e4eff37-9270-5eba-ca3f-3ac64e5e10ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_KilledOffScreenAfterCeremony = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:8e4eff37-9270-5eba-ca3f-3ac64e5e10ba
msgctxt "haf72d725g46d8g4f68gb0d0ge07c2cafe698"
msgid "Gods, you have the worst timing."
msgstr "하. 최악의 시기에 나타나셨군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 8ea77c8a-7c79-7147-5772-e35b956feee8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:8ea77c8a-7c79-7147-5772-e35b956feee8
msgctxt "hee05c719gceb2g4592ga0edgd6939d7ff88e"
msgid "<i>Choose.</i>"
msgstr "<i>선택해라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 8ec80081-7f19-dfdd-9003-61a6f716aa68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:8ec80081-7f19-dfdd-9003-61a6f716aa68
msgctxt "haad2e3ecg91cdg42a0g9654g9702cba36d79"
msgid "Still yourself, pup. Not every death is forever."
msgstr "진정해, 멍멍아. 아직 방법이 없는 건 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Arbiter Cirrus
#. NodeID = 9153fe7a-6f68-a305-8f04-6bc7123fea62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:9153fe7a-6f68-a305-8f04-6bc7123fea62
msgctxt "hb8212fd2g220fg4d2bga61cg4719b8c32c9a"
msgid ""
"<i>Infernus contractus te vocamus. Infernus contractus te vocamus. Infernus "
"contractus te vocamus.</i>"
msgstr "<i>인페르누스 콘트락투스 테 보카무스. 인페르누스 콘트락투스 테 보카무스. 인페르누스 콘트락투스 테 보카무스.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 9161af8e-7449-7d0c-ef8c-478a68c4f510
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:9161af8e-7449-7d0c-ef8c-478a68c4f510
msgctxt "h6c0174d3g816dg4785g8480gf74b2f4d8cae"
msgid "What are you proposing?"
msgstr "제안할 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 92b54fbd-bcb8-a592-2d30-3a94c128817a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:92b54fbd-bcb8-a592-2d30-3a94c128817a
msgctxt "h2faed545ge297g4fbdgb0e9gd06b5c50d3c2"
msgid ""
"You say that. But minds can change in the span of a snap - and not every "
"death is forever."
msgstr "지금이야 그렇게 생각하겠지. 근데 마음이란 건 쉽게 바뀌는 거야. 그리고 아직은 그 남자를 살릴 방법이 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 94ac3b60-8680-b989-85e8-f4edd86e91d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4f447e82-47bf-9d85-b393-210cb75f2e6e_KarlachInclusion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:94ac3b60-8680-b989-85e8-f4edd86e91d7
msgctxt "hdb76d19fgee30g4bacgb909ge423aa2f83ba"
msgid "<i>Silence, Karlach!</i>"
msgstr "<i>조용, 칼라크!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Arbiter Cirrus
#. NodeID = 9784dc16-2483-689a-42ba-a64ca6e50810
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:9784dc16-2483-689a-42ba-a64ca6e50810
msgctxt "hd4d70321gb914g46b4g93f9ga29cbb95b0b5"
msgid "<i>Notum sit in Baator.</i>"
msgstr "<i>노툼 싯 인 베이아터.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 97aa9e43-9ac8-aee5-5b28-d2b9283c24dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_SeenDeadRavengardDuringIRN = False
#.      - GLO_Ravengard_Knows_KilledDuringIRNDestruction = False
#.      - GLO_Ravengard_State_Defeated = True
#.      - GLO_Ravengard_State_KilledOffScreenAfterCeremony = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:97aa9e43-9ac8-aee5-5b28-d2b9283c24dc
msgctxt "hf6958656g4030g47deg8069g05a17a432fad"
msgid "Get on with it, Mizora. What can you do about Ravengard?"
msgstr "본론을 말해, 미조라. 레이븐가드를 위해 뭘 해줄 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 980674c5-7baa-a24c-3468-53b58f23a271
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:980674c5-7baa-a24c-3468-53b58f23a271
msgctxt "ha2e3e3b3gbd1dg413fgb6eeg933efb6dc4f9"
msgid ""
"Addendum F. <i>'The Absolute must be avenged for the soul-binder's detention "
"at Moonrise. The soul-bearer retains his gifts until such time as the "
"Absolute is slain.'</i>"
msgstr ""
"추가 사항 F. <i>'영혼 결속인을 문라이즈에 구금한 대가로 절대자에게는 복수가 치러져야 한다. 영혼 소지인은 절대자를 처단하기 전까지 "
"자기 능력을 사용할 수 있다.'</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = 9acb331f-b68c-f2f3-5052-90c5649765a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:9acb331f-b68c-f2f3-5052-90c5649765a8
msgctxt "h19dc7dfcg5eacg45e4g8dd3g7ad72f10f414"
msgid "How else? We <i>bargain.</i>"
msgstr "어떻게 할까? <i>거래</i>를 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = 9b4f631d-303c-7d6f-64cd-4936d20e07f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:9b4f631d-303c-7d6f-64cd-4936d20e07f0
msgctxt "h8c690b81g2c17g4f41g8ba2g5bd406a333b0"
msgid "Break the pact. I will have my freedom."
msgstr "계약을 끝내지. 날 풀어 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Arbiter Cirrus
#. NodeID = 9bbe6d2a-89a0-cfbf-346f-4d57af447828
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:9bbe6d2a-89a0-cfbf-346f-4d57af447828
msgctxt "ha45cf403ge215g4d3bga84cg46dd5a5f54ba"
msgid ""
"<i>Infernus contractus te vocamus. Infernus contractus te vocamus. Infernus "
"contractus te vocamus.</i>"
msgstr "<i>인페르누스 콘트락투스 테 보카무스. 인페르누스 콘트락투스 테 보카무스. 인페르누스 콘트락투스 테 보카무스.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = a30bda61-bbe1-09ef-6ac6-c86ab66e1143
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_MeetingMizora_Event_WyllPresent = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:a30bda61-bbe1-09ef-6ac6-c86ab66e1143
msgctxt "h76217e27g1d0bg4c83gb29fge57d3fda34cf"
msgid "Shit."
msgstr "제기랄."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = ababa61e-9d40-5f69-a3c3-22cd5e11dc2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:ababa61e-9d40-5f69-a3c3-22cd5e11dc2a
msgctxt "hb5a006eag9dccg4df4gab40gd036c73ac7e1"
msgid "Shit. Where did Gortash send my father? <i>How do I save him?</i>"
msgstr "제기랄. 고타쉬가 아버지를 어디로 보냈지? <i>어떻게 하면 구해드릴 수 있어?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = b2db006d-dc3d-f0a6-08c5-7f9228519084
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:b2db006d-dc3d-f0a6-08c5-7f9228519084
msgctxt "ha6e326aag6b38g4c7dg8833g18004bccefdf"
msgid "Let them have him, then. He was never any use to me."
msgstr "그러라고 해. 그 작자가 나한테 해준 건 아무것도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = b2eb1c51-6324-38cb-285a-ff87fdee98fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MizorasRescue_Event_ConvincedMizora = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:b2eb1c51-6324-38cb-285a-ff87fdee98fb
msgctxt "hff33b961gcaf9g4f2cgbe19ga1c12f1f58dc"
msgid "Then break it already. Wyll doesn't need to wait six months."
msgstr "그럼 빨리 끝내버려. 윌이 6개월이나 기다릴 필요 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = b8748929-304f-6ace-f311-d6ca5506015a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_MeetingMizora_Event_MizoraLeftWYR = True
#.      - GLO_Ravengard_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:b8748929-304f-6ace-f311-d6ca5506015a
msgctxt "h19efd597g3c9bg44b0gbeb2g3c0394454ed3"
msgid "The Duke's been taken. Now what?"
msgstr "대공은 납치됐다. 이제 어떻게 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = b93785b6-562f-84ec-4c47-3cf3a41ec5e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:b93785b6-562f-84ec-4c47-3cf3a41ec5e0
msgctxt "haa3ad531gd372g429fg8cbag319475d9326c"
msgid "I'll let you two catch up - I'm sure you've got plenty to talk about."
msgstr "둘이 시간 좀 가져. 할 얘기가 산더미 같겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = ba38f2db-1563-1d72-1708-f2f03ce65060
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_SeenDeadRavengardDuringIRN = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:ba38f2db-1563-1d72-1708-f2f03ce65060
msgctxt "h8d29004fg092eg4f36gb87ag87d9a6725e9f"
msgid "Come to gloat, Mizora? We saw Ravengard's corpse for ourselves."
msgstr "자랑이라도 하러 왔나, 미조라? 레이븐가드의 시체라면 우리도 봤다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = be861088-4736-6646-e3ae-142bbf9133b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:be861088-4736-6646-e3ae-142bbf9133b1
msgctxt "h2fe2a0d1gfa96g41d8g8186g7afc82de9240"
msgid "No contract is ended without sacrifice. A cost must be paid."
msgstr "그 어떤 계약이든 끝내려면 희생이 필요해. 항상 대가를 치러야 하는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = c03c292b-b166-a934-faae-105682522cad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#. SetFlags:
#.   Global:
#.     - CAMP_MizorasPact_Event_RescueFather = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:c03c292b-b166-a934-faae-105682522cad
msgctxt "h73ea7d79ge982g4a47ga5eag151087fab4da"
msgid "Do it, then. Claim my soul for Zariel. Keep my father safe."
msgstr "그렇게 해. 자리엘에게 내 영혼을 바치지. 아버지를 지켜 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = c4d4955e-0ac8-7679-b90a-66276aeffda6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MizorasRescue_Event_ConvincedMizora = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:c4d4955e-0ac8-7679-b90a-66276aeffda6
msgctxt "h7dbaae29g2860g45a8gadffg0bd3e4121ed2"
msgid "Then break it already. I suffered enough."
msgstr "그럼 끝내 버려. 난 할 만큼 했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = c5f9b7e3-587f-b23f-11c8-c700cc6d0dd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:c5f9b7e3-587f-b23f-11c8-c700cc6d0dd2
msgctxt "ha5124d94g57aag4ea4gac01g9f81d563f6c5"
msgid "You know what? I think I'll stick around."
msgstr "그리고 있지, 나 한동안은 여기서 지낼까 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Karlach
#. NodeID = c821ac34-8933-a3af-45e0-ceea3b6ad427
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:c821ac34-8933-a3af-45e0-ceea3b6ad427
msgctxt "ha1934b20g8be5g4a3fg8e1dg0969799c363a"
msgid "Holy fucking hells."
msgstr "미친 세상에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = c994f82c-afb6-a19f-44f0-e3a9d06eef04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:c994f82c-afb6-a19f-44f0-e3a9d06eef04
msgctxt "hf81788d7g832fg4517g815ag4a67615f01a2"
msgid "Bring back my father. He's Baldur's Gate's best hope."
msgstr "아버지를 되살려 줘. 그분은 발더스 게이트의 가장 큰 희망이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Arbiter Cirrus
#. NodeID = cc05c508-590f-43a0-d7a4-71703254d859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:cc05c508-590f-43a0-d7a4-71703254d859
msgctxt "h22c6e101g64bcg4978gbe91g3c4f04758aef"
msgid "<i>Fiat ita. Anima ad Baator.</i>"
msgstr "<i>피아트 이타. 아니마 앗 베이아터.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = cceceb22-c93f-708b-af0f-6f9fd5f283de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:cceceb22-c93f-708b-af0f-6f9fd5f283de
msgctxt "hd64ef686g7cd8g4234g8156g983884f92039"
msgid "<i>Wyll Ravengard. A choice is before you.</i>"
msgstr "<i>윌 레이븐가드. 선택의 순간이 도래했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = cd72ff23-7f58-3561-8b6b-f58aaa996454
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:cd72ff23-7f58-3561-8b6b-f58aaa996454
msgctxt "he6693b04g14dfg4752g98c1g01096be0475f"
msgid "It can't be. I don't believe you."
msgstr "그럴 리 없어. 네 말 따윈 믿지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = cf52be8a-4c32-e06d-09bc-3a584da35386
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:cf52be8a-4c32-e06d-09bc-3a584da35386
msgctxt "h86f86a9bga6feg4758ga222g050bb06cccb3"
msgid "What are you up to, Mizora?"
msgstr "무슨 일이지, 미조라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = d0b8b8da-7919-5106-d902-35b395749c1b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MizorasPact_Event_PactScene = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d0b8b8da-7919-5106-d902-35b395749c1b
#, fuzzy
#| msgid "<i>Sorores surge. Testis esto pacti mei. </i>"
msgctxt "hd0413925geee0g48f5gb1ebg6fe4a52e66e9"
msgid "<i>Sorores surge. Testis esto pacti mei.</i>"
msgstr "<i>소로레스 수어제. 테스티스 에스토 파크티 메이.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = d2ebbb42-777c-ca92-b484-8b1ea40d8fb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d2ebbb42-777c-ca92-b484-8b1ea40d8fb1
msgctxt "hee03da56g48ccg4d0bgbdedg704b661493bb"
msgid "<i>Name your sacrifice.</i>"
msgstr "<i>무엇을 희생할 텐가.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = d39ace02-7e66-3b0a-1803-786194245830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d39ace02-7e66-3b0a-1803-786194245830
msgctxt "h37f055a9g00e4g4910g8360g2bd98784fd2b"
msgid "Just what are you up to?"
msgstr "이번엔 또 무슨 일이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = d3bdb2e2-26ca-2f40-4119-de3763337e01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d3bdb2e2-26ca-2f40-4119-de3763337e01
msgctxt "hfbacd372g53ddg4f33g83cfgaa7ae9db9544"
msgid ""
"He's locked in a very nasty place - Gortash's secret command centre and "
"prison."
msgstr "레이븐가드는 아주 위험한 곳에 갇혀있어. 고타쉬의 비밀 사령부 속 감옥이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = d5081f4e-eb7b-b834-b39e-1dc74550acea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d5081f4e-eb7b-b834-b39e-1dc74550acea
msgctxt "h8deb34bagd0f9g4a38gaf4fg3fcdf7837c46"
msgid "Your father is dead, Wyll. The Dead Three have claimed their prize."
msgstr "네 아빠는 돌아가셨어, 윌. 삼악신의 전리품으로써 취해졌지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = d54f4b62-43ed-d0c6-55d5-d44f169d6333
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_MeetingMizora_Event_WyllPresent = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d54f4b62-43ed-d0c6-55d5-d44f169d6333
msgctxt "hffac5fc2gfd39g4e5dgb440g53a7bece394e"
msgid "Enough, Mizora. Where is my father? <i>How do I save him?</i>"
msgstr "그만해, 미조라. 아버지는 어디 계시지? <i>어떻게 하면 구할 수 있어?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Narrator
#. NodeID = d56d34ff-9495-dccb-effa-60b389bb862f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4f447e82-47bf-9d85-b393-210cb75f2e6e_PassedArcana = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d56d34ff-9495-dccb-effa-60b389bb862f
msgctxt "hf490dcb9ge818g4c3fg950egfd9bf2e0fb5d"
msgid ""
"*You've heard of such devils - Sisters of Justice, adjudicators of "
"diabolical contracts and bargains.*"
msgstr "*당신은 이 데빌들에 대해 들어본 적이 있습니다. 균형의 자매, 지옥의 계약과 거래의 심판관들입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = d7f61321-6ea5-b4a0-8890-773687b1fdfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:d7f61321-6ea5-b4a0-8890-773687b1fdfa
msgctxt "h5da156bfg7f82g442dgab74g3c7206f4b17b"
msgid "Let my father die. When the city's free, I'll take his place."
msgstr "아버지는 죽어도 돼. 도시가 자유로워지고 나서 내가 그 자리에 서면 되니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = dc1e99f9-0308-45e7-2197-28635f3dd2be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:dc1e99f9-0308-45e7-2197-28635f3dd2be
msgctxt "h535ea1d3gfad3g44dbg8ea4g3fa7f247900f"
msgid "<i>Remain silent.</i>"
msgstr "<i>묵묵히 있는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Narrator
#. NodeID = ddbe026f-856b-4b37-a59c-eae1672e18c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4f447e82-47bf-9d85-b393-210cb75f2e6e_PassedArcana = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:ddbe026f-856b-4b37-a59c-eae1672e18c2
msgctxt "h3b1a6dd9gbc36g4f37gbd3bg72883258be5e"
msgid ""
"*You've heard of such devils - Sisters of Justice, adjudicators of "
"diabolical contracts and bargains.*"
msgstr "*당신은 이 데빌들에 대해 들어본 적이 있습니다. 균형의 자매, 지옥의 계약과 거래의 심판관들입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = dde03a2c-d975-6a4c-7729-85722491f5aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:dde03a2c-d975-6a4c-7729-85722491f5aa
msgctxt "h7959bc71g8ac6g45c4gb6abg97ed1667016d"
msgid ""
"<i>Option two. I break your pact, and you are freed from your duty. <b>Your "
"father dies by his enemy's hand, and Baldur's Gate loses its greatest "
"champion.</b></i>"
msgstr ""
"<i>두 번째 경우. 넌 계약을 끝내고 의무로부터 자유로워진다. <b>하지만 네 아버지는 적들에게 죽임을 당하고, 발더스 게이트의 가장 "
"위대한 투사는 사라진다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = e15e9c4a-cc5c-4f5a-6c7c-10fc4d445bd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:e15e9c4a-cc5c-4f5a-6c7c-10fc4d445bd8
msgctxt "haa96d71egb092g4cf9gbe14gb580f5bbfa88"
msgid ""
"<i>Option two. I break your pact. You are freed from your duty but retain "
"your devil form. <b>Your father dies by his enemy's hand.</b></i>"
msgstr ""
"<i>두 번째 경우. 계약을 끝내고 의무로부터 해방되겠지만, 그 데빌 형상은 유지되고 <b>네 아빠가 적들에게 죽임을 "
"당한다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = e3fb7d2e-3789-524e-0cef-95c4ed868a9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:e3fb7d2e-3789-524e-0cef-95c4ed868a9c
msgctxt "hba88456fg3e7fg4ffbg8934g38015385de90"
msgid ""
"A life for a life. No contract is ended without sacrifice. The cost must be "
"paid."
msgstr "목숨은 목숨으로 갚는 법. 계약을 끝내려면 반드시 무언갈 희생해야 하지. 항상 대가를 치르게 되어 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = e643a39a-1a60-b743-9c3e-7311e372af0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:e643a39a-1a60-b743-9c3e-7311e372af0b
msgctxt "h3ed2c901g154bg4581g9f1fgdcc78cf62d54"
msgid "Leave him dead. When the city's free, you can take his place."
msgstr "그분을 되살리지 마. 도시를 구하고 난 뒤 네가 그 자리에 오르면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Narrator
#. NodeID = e70c0901-9ff5-76b4-8806-333702688cb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_MeetingMizora_Event_WyllPresent = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:e70c0901-9ff5-76b4-8806-333702688cb8
msgctxt "he45d78bdg9954g4132g9d50g6790d8c1aa54"
msgid ""
"*Your parasite links with Wyll's, and your memories flow into him. He sees "
"his father's flight from Wyrm's Rock and hears Mizora's words to you.*"
msgstr ""
"*당신과 윌의 기생충이 연결되면서, 당신의 기억들이 그에게 흘러 들어갑니다. 윌도 미조라가 당신에게 했던 말들과 아버지가 고룡 바위에서 "
"당한 일을 알게 되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = e88faa75-322c-4d4a-cc64-9cab1e43d706
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:e88faa75-322c-4d4a-cc64-9cab1e43d706
msgctxt "h2d5a4922g778cg4b83gadf3g15c4a1b3b310"
msgid "What happens to my powers if I break the pact?"
msgstr "계약이 끝나면 내 힘은 어떻게 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = ebe4ec14-f920-2754-00cf-bdbd0de8e0e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:ebe4ec14-f920-2754-00cf-bdbd0de8e0e3
msgctxt "ha8c93226g0b3ag442fg9d7dge6ab2bf4fe39"
msgid "So much for the selfless hero."
msgstr "이타적인 영웅은 어디로 가셨대."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = ec279831-11d5-7479-904a-6db73270fe92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_KilledOffScreenAfterCeremony = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:ec279831-11d5-7479-904a-6db73270fe92
msgctxt "h61f3e836gf9a8g4ce9gb56bg3b68002b3177"
msgid "I thought we were done with you."
msgstr "이제 볼 일 없다고 생각했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Mizora
#. NodeID = ee7a33f0-4688-8ab9-75af-f705a58add1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:ee7a33f0-4688-8ab9-75af-f705a58add1c
msgctxt "h8012b919g7a42g42edg89a1g83ee94a80377"
msgid "Do you suppose? I'd call the timing most perfect, myself."
msgstr "그런가? 내 생각엔 아주 딱 맞춰 온 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = f1cad109-dbfa-53d0-2e66-0438ae56aee9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:f1cad109-dbfa-53d0-2e66-0438ae56aee9
msgctxt "h09b37356gf883g4cd5gb87eg4d756cc8be2e"
msgid "Shit. What did you do, Mizora?"
msgstr "젠장. 무슨 짓을 한 거냐, 미조라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Narrator
#. NodeID = f5138547-41f8-e034-6b83-c3a3b308b1a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:f5138547-41f8-e034-6b83-c3a3b308b1a6
msgctxt "hb65fe85dg808dg4150g948eg75b89a7cc02c"
msgid ""
"*Your mind connects to the Grand Duke's. He is still infected, but his "
"parasite is weak, shielded from the Absolute by the Astral Prism.*"
msgstr ""
"*당신의 마음이 대공과 연결됩니다. 아직 감염된 상태지만, 기생충은 약해져 있고 아스트랄 프리즘 덕에 절대자로부터 보호받고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = f57bb616-cb53-af1a-01c6-1ea96d37d31d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:f57bb616-cb53-af1a-01c6-1ea96d37d31d
msgctxt "hbe5179bdg3027g4db0g8964g7475e96fa6f4"
msgid "Let your father die. When the city's free, you can take his place."
msgstr "네 아버지는 포기하자. 도시를 구하고 난 뒤 네가 그 자리에 오르면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = f59d4430-6232-f9f8-a33b-1a590f326c6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:f59d4430-6232-f9f8-a33b-1a590f326c6e
msgctxt "hb0e90880g7f27g49e3g8a8ag0dceaf763c97"
msgid "I won't let you take my father. He's Baldur's Gate's best hope."
msgstr "아버지를 데려갈 순 없을 거다. 그분은 발더스 게이트의 가장 큰 희망이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = fa12d631-35ff-58fe-5c79-050e45ea9cd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MizorasRescue_Event_ConvincedMizora = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:fa12d631-35ff-58fe-5c79-050e45ea9cd7
msgctxt "h3ca7d491g6273g4a98g9c2fg501c0cf48563"
msgid "Then break it already. Wyll has suffered enough."
msgstr "그럼 빨리 끝내버려. 윌은 충분히 고생했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = fc97380e-36b9-ecf0-5e18-5fd4af0fe865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:fc97380e-36b9-ecf0-5e18-5fd4af0fe865
msgctxt "h3d6bccc5g3f89g4f1fga365g00c5692922c5"
msgid "Do it. Break the pact."
msgstr "그렇게 해. 계약을 끝내 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Player
#. NodeID = fc9c19f8-a7b2-b607-b885-6891c46068b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:fc9c19f8-a7b2-b607-b885-6891c46068b3
msgctxt "h79cfb394gbb53g41dfg8016gc724f24dd1c4"
msgid "Save your father, Wyll. The city will need him to help rebuild."
msgstr "네 아버지를 구하자, 윌. 도시가 재건되려면 그분이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM
#. Speaker = Wyll
#. NodeID = fdb8a09d-1337-40c9-3c0e-6d6ae673782b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_MizorasPact_State_WyllEternalPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MizorasPact_CFM:fdb8a09d-1337-40c9-3c0e-6d6ae673782b
msgctxt "h8a41f1ffg4454g414bg8117g920fd94349e8"
msgid "You damned <i>wretch</i>."
msgstr "<i>못된 년</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 126b8b5a-735c-0591-cefe-cfdaf785c053
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:126b8b5a-735c-0591-cefe-cfdaf785c053
msgctxt "hdaf78053gb32dg43d0g8591gedccdd7c377b"
msgid "We should have a chat, you and I. But not here."
msgstr "우리 얘기를 좀 나눕시다. 여기서는 말고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = 15dbfb00-5fec-2269-fde0-519a24af9e21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:15dbfb00-5fec-2269-fde0-519a24af9e21
msgctxt "h7cec4d6dgf322g4b44g8efdg2fbc8cb212da"
msgid "Walk away while you still have legs to walk with."
msgstr "아직 두 다리가 성할 때 떠나지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = 1e5a7473-5ced-1df6-59a0-3df7ef58d214
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MonitorIntro_ForcedEncounter = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:1e5a7473-5ced-1df6-59a0-3df7ef58d214
msgctxt "h1c814bd1gfb02g4442g8cb3g4039bf64b03f"
msgid "Pretty words. If you want to threaten me, don't disguise it."
msgstr "듣기 좋은 말이로군. 날 위협하고 싶은 거라면, 본심을 숨기지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 1f2087be-a6f0-36f0-e6ce-ab66f26ee41d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:1f2087be-a6f0-36f0-e6ce-ab66f26ee41d
msgctxt "haad4f0b4gd445g4564g88a0g4da5c25ba90b"
msgid ""
"Must be the surroundings. Rather bleak and lonesome. One feels so... exposed."
msgstr "주위 환경 때문이겠지요. 다소 황량하고 쓸쓸하군요. 누구든 너무... 노출된 듯 느낄 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = 22ae4182-8569-f818-3b7a-c881e09cda8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MonitorIntro_ForcedEncounter = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:22ae4182-8569-f818-3b7a-c881e09cda8d
msgctxt "h482ed918g6463g48beg964bgd9aa5f4fec78"
msgid "Am I talking to the mouse or the cat?"
msgstr "그래서 당신은 쥐인가, 고양이인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 2a520a0f-7df4-dd69-2595-ec3b24451315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:2a520a0f-7df4-dd69-2595-ec3b24451315
msgctxt "h044e2329g7a05g45eeg87b9gf0c40de05fbe"
msgid ""
"Neither. The fox, rather, hiding in a word: a silent observer - about to "
"break the silence."
msgstr "둘 다 아니랍니다. 오히려 여우라고 할 수 있죠. 침묵을 깨고 나타나려고 하는 조용한 관찰자랄까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 448ead50-561e-28ff-5769-daa89fc20f6f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_MeetingTheMonitor_Quest_ChosenByMonitor(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:448ead50-561e-28ff-5769-daa89fc20f6f
msgctxt "he9a5f25fgbb35g4326g8245g594336ef79b4"
msgid "Come."
msgstr "오시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = 494f4a40-d7a9-e98b-cbd9-5fa7bf1ad015
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: KARLACH
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:494f4a40-d7a9-e98b-cbd9-5fa7bf1ad015
msgctxt "ha887eab2gb8d1g4393gb386g85471dee2a18"
msgid "I'm Karlach. And somehow I don't think you're at my service at all."
msgstr "난 칼라크야. 그리고 넌 내게 전혀 도움이 되지 않을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = 494f4a40-d7a9-e98b-cbd9-5fa7bf1ad015
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:494f4a40-d7a9-e98b-cbd9-5fa7bf1ad015
msgctxt "he90f2ba3gced2g46eega894ge83658234331"
msgid "Pleasure. I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "만나서 반가워. 난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 4a0bee93-ff78-3fe1-3fa6-bd662a589024
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:4a0bee93-ff78-3fe1-3fa6-bd662a589024
msgctxt "hb5549ccdgde86g43cbgbba7g35b4897b0c84"
msgid "They do know how to write them in Cormyr, don't they?"
msgstr "코어미어인들의 자장가 쓰는 솜씨는 꽤 괜찮지 않나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 4c3b7ca8-56cb-0bd7-33c1-2281af77e14d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:4c3b7ca8-56cb-0bd7-33c1-2281af77e14d
msgctxt "h6dfcbc6dgb1cdg496cgb889g2971f5a6f4ff"
msgid ""
"Shall we withdraw? We have much to discuss... to our mutual satisfaction."
msgstr "자리를 좀 옮길까요? 논의할 게 아주 많답니다... 서로의 욕구를 충족시켜 주기 위해서 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 5bb91ec3-4e4f-6cb4-bd74-6f3c6b393d96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_TheMonitor_HasMet_TheMonitor = False
#. SetFlags:
#.   Global:
#.     - GLO_TheMonitor_HasMet_TheMonitor = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:5bb91ec3-4e4f-6cb4-bd74-6f3c6b393d96
#, fuzzy
msgctxt "h4a4d1032g9cc7g47d5g917bg45a5440c6fb0"
msgid ""
"My, my, what manner of place is this? A path to redemption, or a road to "
"damnation? Hard to say, for your journey is just beginning."
msgstr ""
"이런, 이런. 여긴 뭐 하는 장소입니까? 구원으로 향하는 길인지, 저주받아 지옥으로 떨어지는 길인지, 구분하긴 어렵군요. 당신의 여정은 "
"이제 막 시작되었으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 60e663e6-9222-5d68-cd4c-c472bd9cc072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:60e663e6-9222-5d68-cd4c-c472bd9cc072
msgctxt "hcbed9f98g6704g4c73g81d4gadaff0b2a669"
msgid "The mouse smiled brightly: it outfoxed the cat!"
msgstr "새앙쥐는 영리하게 미소짓고 고양이를 앞질렀네!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = 61d2f78f-0ebf-1ec9-2bda-3c05f4ba0f4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MonitorIntro_ForcedEncounter = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:61d2f78f-0ebf-1ec9-2bda-3c05f4ba0f4b
msgctxt "h5a300607g98feg4225g99efg35770be66503"
msgid "You weren't invited here. Explain yourself."
msgstr "그쪽을 여기 초대한 적은 없는데. 어디 설명해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 80dad5d8-2182-c683-0b46-5077073c22f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:80dad5d8-2182-c683-0b46-5077073c22f1
msgctxt "h615f125dg3d5cg4288ga59bgb0a41456e1c7"
msgid ""
"This dark little tableau is decidedly too gloomy and middle-of-nowhere for "
"my tastes."
msgstr "이 작고 어두운 경관은 제 취향에 비해 너무 우울한데다 외따로 떨어져 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 8736440f-7026-3fd2-5f4c-96e2f44c3945
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:8736440f-7026-3fd2-5f4c-96e2f44c3945
msgctxt "h7caab7aag2b02g42a1gb250g365df5628bb1"
msgid ""
"It's not every day one meets such a cavalier sinner as yourself. A true, "
"bloody pleasure."
msgstr "당신같이 무정한 죄인을 만나기란 정말이지 쉽지 않죠. 실로 피비린내 나는 즐거움이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 8cc37358-0b86-8efc-aaf3-6ffb896eadb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:8cc37358-0b86-8efc-aaf3-6ffb896eadb0
msgctxt "h97cb483fg9685g404agb055g04aacf8c285e"
msgid "Well met. I am Raphael. Very much at your service."
msgstr "반갑습니다. 라파엘이라고 합니다. 극진히 모시도록 하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 8f9f9e50-97ea-6eb5-2d4f-1d64cc5df66a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:8f9f9e50-97ea-6eb5-2d4f-1d64cc5df66a
msgctxt "h4034ebf9ge1ddg4c1eg8567g431dcc34d22c"
msgid "Why, I never! You're paranoid, aren't you?"
msgstr "위협이라니요! 당신 약간 피해망상이 있으시군요, 그렇지 않나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = 9acf29cd-4811-8738-0991-3ab7ea26c6c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:9acf29cd-4811-8738-0991-3ab7ea26c6c4
msgctxt "h9c64aed1g880dg4083ga7d1g32adcdb38d48"
msgid ""
"I'm rather the admirer of the sanguine arts, even if I wasn't quite born "
"under a killing moon myself."
msgstr "비록 죽음의 달 아래 태어나지는 않았지만, 저도 당신만큼이나 혈액 예술을 흠모한답니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = a760bdc9-d872-5bb6-489c-c64c2a89b216
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:a760bdc9-d872-5bb6-489c-c64c2a89b216
#, fuzzy
msgctxt "h35a70d06gb096g4748gbb1cg2ba446a6e663"
msgid "What would suit the occasion? The words to a lullaby, perhaps?"
msgstr "이런 상황에 적절한 게 뭐가 있을까요? 자장가 한 소절은 어떻습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = a8963ef0-948e-496f-0c21-c77357814fc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:a8963ef0-948e-496f-0c21-c77357814fc4
msgctxt "hfcd0715egbd40g43d9g9c2dgbfd1cbe6613f"
msgid ""
"This quaint little scene is decidedly too middle-of-nowhere for my tastes."
msgstr "이 별난 작은 풍경은 확실히 제 취향에는 너무 뜬금없는 장소로군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = c540390e-b326-41df-0719-abae663f7015
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = True
#.   Tag:
#.      - DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c540390e-b326-41df-0719-abae663f7015
msgctxt "h8b3bd85cg6612g44e5gba40g01482c0f8b5d"
msgid "Don't tell me you're from my old staff. One evil butler is enough."
msgstr "설마 또 다른 부하는 아니겠지. 사악한 집사 한 명이면 충분하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c824e922-41a5-4745-2497-11889b3633f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c824e922-41a5-4745-2497-11889b3633f3
#, fuzzy
msgctxt "hd2f5ba40g238eg4173ga373g3c82c7ad87bb"
msgid ""
"Of course, what I have to say merits some privacy - as well as some more... "
"let's call it refinement."
msgstr "물론 제가 나누고 싶은 대화는 좀 더 은밀하고... 고상하게 다뤄질 가치가 있지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h608931e8gfdb8g43f4g9c19gb0908369ff18"
msgid "Bah! It looks like a duergar, but it speaks like a beast."
msgstr "쳇! 듀에르가같이 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "ha3054416g5104g44f9g91feg8048951f5499"
msgid "Bah! It looks like a drow, but it speaks like a beast."
msgstr "쳇! 드로우같이 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h8f0b59dcg0630g496bg96afgd665aa825612"
msgid "Bah! It looks like a githyanki, but it speaks like a beast."
msgstr "쳇! 기스양키 같이 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "hd29765b4g9efbg4a4egac29gd7c0c87a6b1d"
msgid "Bah! It looks like a deep gnome, but it speaks like a beast."
msgstr "쳇! 딥 노움같이 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: GNOME
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h3d6c2737gf8b2g44c4gb3a9g627d5974c30f"
msgid "Bah! It looks like a gnome, but it speaks like a beast."
msgstr "쳇! 노움처럼 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h3a9880dfga5f5g4c19ga1afg2ed7a27260da"
msgid "Bah! It looks like a dragonborn, but speaks like a beast."
msgstr "쳇! 드래곤본처럼 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: HALFORC
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h03ddacfdg8a94g4e58g87aage24a56caacb9"
msgid "Bah! It looks like a half-orc, but speaks like a beast."
msgstr "쳇! 하프오크처럼 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: DWARF
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "hd356e329g9f56g44f0ga1f8gcda866b66b25"
msgid "Bah! It looks like a dwarf, but it speaks like a beast."
msgstr "쳇! 드워프처럼 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: ELF or HALFELF
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "hf2615de6gbb11g4fd9g939dg358eb572dbec"
msgid "Bah! It looks like an elf, but it speaks like a beast."
msgstr "쳇! 엘프처럼 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: HALFLING
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "hde2f9bdagd181g4cf1ga27bgc2229ad75f2d"
msgid "Bah! It looks like a halfling, but it speaks like a beast."
msgstr "쳇! 하플링처럼 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[10].TagText[0]
#. TagRule: HUMAN
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h423d0b74g95d2g44c4g9f71g6a7e25280f07"
msgid "Bah! It looks like a human, but it speaks like a beast."
msgstr "쳇! 인간처럼 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[11].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "haa4fc42dg3356g4075gae8fg176e3c59ff38"
msgid "Bah! It looks like a tiefling, but it speaks like a beast."
msgstr "쳇! 티플링같이 생겼지만, 야수처럼 말하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[12].TagText[0]
#. TagRule: PLANAR or RARE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h6e95b253g2fc7g48b7gb57agb838bcafdb80"
msgid "Bah! Such a rare breed, but with such a common tongue."
msgstr "쳇! 희귀한 종족인데도 그런 공용어로 말을 하다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = c9d2c335-2d3e-7770-eec5-60fdb3ac577e
#. HandlePath = TaggedText[13].TagText[0]
#. TagRule: BESTIAL
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:c9d2c335-2d3e-7770-eec5-60fdb3ac577e
msgctxt "h8f8d5ac4g04a2g4f49g8c16g05b025f3c95a"
msgid "Bah! A beast you are indeed."
msgstr "쳇! 참으로 야수같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = d30740b9-677c-fef4-65d2-dbd7d595a132
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_TheMonitor_HasMet_TheMonitor = False
#. SetFlags:
#.   Global:
#.     - GLO_TheMonitor_HasMet_TheMonitor = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:d30740b9-677c-fef4-65d2-dbd7d595a132
msgctxt "h971353e6gb503g4499g93fcga96ca2cbe0e4"
msgid ""
"Most would quail to find themselves in a place so grim and unforgiving, but "
"your journey has no bright paths. Only dead ends, and ruinous roads."
msgstr ""
"많은 사람들이 이처럼 암울하고 가혹한 곳에서 스스로를 발견하곤 움츠러들지만, 안타깝게도 빠져나갈 길은 없습니다. 여러분의 여정에는 막다른 "
"골목과 파멸의 길만이 놓여 있을 따름입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = dda92301-c939-d57e-4ce6-18b48a63bf3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:dda92301-c939-d57e-4ce6-18b48a63bf3d
msgctxt "hdb2e1731g53deg4cbbgba0cgd2b718dea3b8"
msgid "Then down came the claw, and that, love, was that."
msgstr "그러고선 날카로운 발톱이 내려왔네. 그리고 그걸로 끝이란다, 아가야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = e60c6aec-e636-6314-0096-ff429b47cfdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:e60c6aec-e636-6314-0096-ff429b47cfdc
msgctxt "h9d54b589g356cg4e62ga249g8932363a24f2"
msgid "Charmed, I'm sure. In more ways than one..."
msgstr "매혹적이군요, 확실히. 여러모로 말이죠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Player
#. NodeID = ea0f25e4-ff4b-035e-bafb-1853c587f80f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = False
#.   Tag:
#.      - DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:ea0f25e4-ff4b-035e-bafb-1853c587f80f
msgctxt "h746402c0gb440g44d6gb58cg59e8e872fabd"
msgid "Oh, you're familiar with my work?"
msgstr "아, 내 일에 대해 좀 아시겠다?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = ef58a8c4-5862-c1e0-357e-615da569e6d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_TheMonitor_HasMet_TheMonitor = False
#. SetFlags:
#.   Global:
#.     - GLO_TheMonitor_HasMet_TheMonitor = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:ef58a8c4-5862-c1e0-357e-615da569e6d4
msgctxt "hf0695f4cgbb68g4399ga40fg6d0648efc6c1"
msgid ""
"My, my, what a curious meeting place this is. Only those in search of "
"something altogether out of this world would scour this forgotten road."
msgstr ""
"이런, 이런, 정말이지 별난 만남의 장소가 아닌가요. 이 세상과 완전히 벗어난 무언가를 찾는 이들만이 이처럼 잊혀진 길을 샅샅이 "
"뒤지겠지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = f0716adf-54d4-05bc-8db8-fa744e6ea361
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:f0716adf-54d4-05bc-8db8-fa744e6ea361
msgctxt "h018d931dg5d15g44ebg8efag378ec821fc45"
msgid "You wound my honour! Consider me a peer for your vice."
msgstr "이것 참 수치스럽군요! 그저 당신의 악행을 도울 동료로 봐 주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM
#. Speaker = Raphael
#. NodeID = ffa58666-7d06-abd5-6199-6664630a1caf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_MonitorIntro_CFM:ffa58666-7d06-abd5-6199-6664630a1caf
msgctxt "h117f1ac0gf3b2g4c1eg9c2bg8cc5acf40361"
msgid ""
"Karlach. Why does that name ring a bell? Hmm. Perhaps I read it in a book "
"somewhere."
msgstr "칼라크라. 왜 그 이름이 익숙하게 들릴까요? 흠. 어쩌면 어디선가 다른 책에서 읽었을지도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD
#. Speaker = Player
#. NodeID = e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD:e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
msgctxt "h1f7b7a29gf3a8g4a49ga850gc7823d071ce8"
msgid "Gods, what was that dream?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD
#. Speaker = Player
#. NodeID = e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD:e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
msgctxt "hf325811fge81cg4e09g9597g4412e5f8bf55"
msgid "The strangest dream. A relief to wake from it..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD
#. Speaker = Player
#. NodeID = e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD:e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
msgctxt "hf57a3b1bg7268g4a8cgb86dg01055016d729"
msgid "That dream - I can't get it out of my head..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD
#. Speaker = Player
#. NodeID = e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD:e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
msgctxt "h8d5db136ga63ag4d5dg8835gfcacf0f1d7ac"
msgid "That dream... it felt so vivid. Too vivid."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD
#. Speaker = Player
#. NodeID = e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD:e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
msgctxt "h76fe8426g6e73g4b46g8657gd41b68416be8"
msgid "Bah - I had the most <i>unwelcome</i> dream..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD
#. Speaker = Player
#. NodeID = e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_MorningAfterDaisyDream_PAD:e9225cf7-1bcb-9723-1751-fabfd2fc7f8f
msgctxt "hc103f73ag4e81g4757g9eb3ge7eb89eb3e69"
msgid "Good gods, the dream I just had."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 0081f0fd-6e6b-c376-09de-6d85eacabd0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:0081f0fd-6e6b-c376-09de-6d85eacabd0a
msgctxt "haa8562b0g010dg4bccga4eag6b284b62d319"
msgid "I... I don't know."
msgstr "난... 나도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 016052e5-efc4-93cb-984b-6877a85f49a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCE_Shadowheart_Event_GiveSeluneSpear(2) = True
#.     - SCE_Shadowheart_Event_GiveNightSpear(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:016052e5-efc4-93cb-984b-6877a85f49a1
msgctxt "h7467bfd1gfec7g4e37gad52ge0853f0fc28a"
msgid ""
"...and mirrored. Take it - you will find it useful. What you do with it... "
"that will be up to you. Same as before."
msgstr ""
"...마치 거울처럼. 취하거라 - 그대라면 분명 쓸모를 찾을 것이다. 다만 이것으로 무엇을 행할지는... 그대에게 달려 있다. 항상 "
"그랬듯이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 06a307e4-7875-56a9-9ce9-b125c375a910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:06a307e4-7875-56a9-9ce9-b125c375a910
msgctxt "h7057de3egc8bcg4f98g8e96g918ba17616bb"
msgid "You have been forewarned for what is to come, but not yet forearmed."
msgstr "그대는 미리 경고를 들었으니, 늦지 않게 경비되어야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 07765680-6aac-3dd4-8615-82c2866b4b31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:07765680-6aac-3dd4-8615-82c2866b4b31
msgctxt "h59aa318cgcc7eg49acgb3aeg29077b7463c2"
msgid ""
"They were seized by Shar's followers, same as you. Only you were to be "
"remoulded for their purposes, while your parents... I sense they have "
"suffered greatly in the years since."
msgstr ""
"그대와 마찬가지로, 그들은 샤의 추종자들에게 붙잡혀 있다. 오직 그대만이 놈들의 목적에 맞게 개조될 수 있었다. 반면 그대의 양친은... "
"그들은 오랜 세월 큰 고통을 겪었을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 08543e3f-bd56-dbb5-f7f2-524f17ebe85e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:08543e3f-bd56-dbb5-f7f2-524f17ebe85e
msgctxt "h709d7dc0g36abg4bd9g8440g764e8d0ac2c5"
msgid ""
"When I laid eyes on you, I sensed a similar bond. You, tethered to two "
"others, someplace distant."
msgstr "그대를 들여다보았을 때, 비슷한 종류의 끈을 느꼈다. 그대와 어딘가 먼 곳에 묶여 있는 두 사람이 보였지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Isobel
#. NodeID = 08cde73d-59b7-078f-57e6-47cef1f2b07c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:08cde73d-59b7-078f-57e6-47cef1f2b07c
msgctxt "h30707c0egca7eg4638gb7b0ge8cfdc32c7c5"
msgid ""
"It is a tragedy that the Moonmaiden's rite was perverted by Shar. Your "
"future was stolen from you."
msgstr "달처녀의 의식이 샤에 의해 뒤틀린 것은 비극이다. 그대는 그대의 미래를 스스로 빼앗게 된 셈이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 0929586e-cfea-5db4-8f8e-519415484716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:0929586e-cfea-5db4-8f8e-519415484716
msgctxt "h80b150f0g3c3cg4aacg805bg3578a62ed783"
msgid "That wolf - that <i>elf</i>... Who was he?"
msgstr "그 늑대 - 그 <i>엘프</i>... 그는 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 0f2dfe9a-5a24-d90d-bec1-a8f214ce6c26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:0f2dfe9a-5a24-d90d-bec1-a8f214ce6c26
msgctxt "he5a9cb51gf538g4f76ga08cg895f691ca31b"
msgid ""
"*You feel Shadowheart's mind tug at the edges of your thoughts. She wants "
"you to stay with her, to see whatever is about to be revealed to you.*"
msgstr ""
"*당신은 섀도하트의 정신이 당신 정신의 끄트머리를 붙잡고 이끄는 걸 느낍니다. 그녀는 당신이 함께 머무르며, 곧 밝혀질 비밀을 지켜봐 "
"주기를 원합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 11e3f06b-a1f7-ba61-1969-5ac73902c8b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:11e3f06b-a1f7-ba61-1969-5ac73902c8b3
msgctxt "h6afb8911gd375g442eg8c19g4d87fae1fb89"
msgid ""
"It no longer has the power to harm me, now that I've removed it from Shar's "
"domain."
msgstr "샤의 영역에서 빼내어 왔기에, 이 물건 안에 내게 해를 입을 힘은 남아 있지 않다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 122e471d-975f-7dad-30ca-bd8e62ad7263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:122e471d-975f-7dad-30ca-bd8e62ad7263
msgctxt "hd91da02dg33c3g491cg80b7g92a2daf61ed7"
msgid "The Spear. How do you have it? I threw it into the Shadowfell."
msgstr "그 창. 어떻게 당신이 그걸 갖고 있죠? 섀도펠에 던져버렸었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 12acded1-4958-a6ef-7632-7651d2af0efc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:12acded1-4958-a6ef-7632-7651d2af0efc
msgctxt "hd904ebb7g0949g4e45gab4dg55902ca96d8a"
msgid "Of course I am. And I can prove it."
msgstr "나는 진실을 말하고 있노라. 증명할 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 1323b140-8e80-0198-1d1d-54aeb4b9c003
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:1323b140-8e80-0198-1d1d-54aeb4b9c003
msgctxt "h37b34374g125ag4bf9g96a7g1c1be054b3ed"
msgid "I have to find my parents."
msgstr "부모님을 찾아야겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 13c298ca-615c-1c93-297e-cdbe84573f97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:13c298ca-615c-1c93-297e-cdbe84573f97
msgctxt "hd88bc701g4089g4984gacd6gf6a5ad46eb4c"
msgid ""
"You may have once thought of them as comrades, mentors, friends, even "
"lovers. But they will all be enemies now."
msgstr "그대는 한때 그들을 동지이자 멘토, 친구, 심지어는 연인으로 여겼으리라. 하지만 지금부터 그들 모두가 그대의 원수이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 13d68a76-41d9-ffe2-0095-88f21f738e73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:13d68a76-41d9-ffe2-0095-88f21f738e73
msgctxt "heb28eaaegd410g4ee2g9aefg7bceb65a19ea"
msgid ""
"He is your father - and he lives still, as does your mother. I felt them, "
"bound to you."
msgstr "그건 그대의 부친이었다 - 그리고 아직 살아 있지. 그대의 모친과 함께. 나는 그대에게 묶여 있는 그들의 존재를 느꼈다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 1559c0d9-245f-66bd-0af7-1dc7a2d96e69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:1559c0d9-245f-66bd-0af7-1dc7a2d96e69
msgctxt "h51d0cfe7g2550g406agac28g671ecdb86ce6"
msgid ""
"When I laid eyes on you, I sensed a similar bond. You, tethered to two "
"others, someplace distant. Let me help you remember."
msgstr ""
"그대를 들여다보았을 때, 비슷한 종류의 끈을 느꼈다. 그대와 어딘가 먼 곳에 묶여 있는 두 사람이 보였지. 그대의 기억에 접근하게 해 "
"다오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 17950014-7de8-1392-4c6b-f485121095db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:17950014-7de8-1392-4c6b-f485121095db
msgctxt "hc6166fa0g9a2ag4873g9168g97a5cc3f1809"
msgid ""
"Perhaps I was foolish to spare you. It may have been better to remain "
"ignorant."
msgstr "당신을 구한 건 어리석은 결정이었어요. 차라리 모르고 사는 편이 나았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 19edf9fb-bdb9-3a1b-e31d-823ddc6dddb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:19edf9fb-bdb9-3a1b-e31d-823ddc6dddb3
msgctxt "hbfcabfbagce40g4630g9d24gc26347b7eb9a"
msgid ""
"Shar is quick to discard whatever she has no use for. I think you know that "
"well enough."
msgstr "샤는 쓸모없는 패는 냉큼 던져버리지. 그대도 이미 잘 알고 있다시피 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 1a7b77d4-309c-da34-a260-dabe3dceccf7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:1a7b77d4-309c-da34-a260-dabe3dceccf7
msgctxt "he3a521c9g1afeg4a6ag9bc6gaffa9b627c21"
msgid ""
"I felt the Spear call to me as I took flight. Whatever Shar calls her own, "
"Selûne has equal claim to. They are one and the same. Their power is "
"matched..."
msgstr ""
"나는 날아오르던 중에 창의 부름을 들었다. 샤가 자신의 것이라고 주장하는 것은 무엇이든 셀루네의 것이기도 하다. 둘은 하나이며 "
"동일하노라. 그들의 권능은 일치하지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 1bb60d60-a74f-b3db-350b-d8c7a7cbc715
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:1bb60d60-a74f-b3db-350b-d8c7a7cbc715
msgctxt "h8fec2c0bg94c1g4141g85b6g250563da61a1"
msgid "That <i>is </i>him. He lives still, and your mother too."
msgstr "그게 <i>바로</i> 그대의 부친이다. 아직 살아 있지. 그대의 모친과 함께."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 1eacd027-bb65-0302-645a-6c7d57133391
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:1eacd027-bb65-0302-645a-6c7d57133391
msgctxt "hf64bad2cg045bg4b0fg9626g92f822179cfc"
msgid ""
"*Rest beckons. Soon you will be in Baldur's Gate, where you must confront "
"those who wronged you, and save those who were taken from you.*"
msgstr ""
"*휴식이 손짓합니다. 곧 당신은 발더스 게이트에 다다를 겁니다. 거기서 당신에게 잘못을 저지른 사람들을 마주하고, 당신이 빼앗긴 사람들을 "
"구해 내야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 1ef8872b-da28-f740-0bae-4e6432d7e32e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:1ef8872b-da28-f740-0bae-4e6432d7e32e
msgctxt "h884329a0gb48eg40bfgb36cgd60ff2de1e5b"
msgid "Getting your parents back sounds dangerous."
msgstr "네 부모님을 돌려받는 건 위험한 계획 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 24e4d0f2-d843-f4c5-6bc1-2524b7f5a9ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:24e4d0f2-d843-f4c5-6bc1-2524b7f5a9ec
msgctxt "hbaad60bfgae46g4b39g8ed7ged06c1c0ae66"
msgid "That can't be. I'm an orphan."
msgstr "그럴 리가 없어. 난 고아라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 2ada98c5-c179-ba0d-cd08-53ea3ecaadd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:2ada98c5-c179-ba0d-cd08-53ea3ecaadd9
msgctxt "h0bf81f09gbcabg4972g9be0g9e23493541f6"
msgid "Get to the point."
msgstr "요점을 말해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 2b105a4f-1dad-4f65-5419-9544d31655b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:2b105a4f-1dad-4f65-5419-9544d31655b6
msgctxt "h94ef9130g0f6fg4d8fg87d7g9154a63d0d29"
msgid "No, it can't be. I'm an orphan."
msgstr "아냐. 그럴 리 없어. 난 고아라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 2b8c4a8d-9875-1e21-229c-32c89eab300d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:2b8c4a8d-9875-1e21-229c-32c89eab300d
msgctxt "h71749a26gfdddg44afga7f9g302ee332c6c8"
msgid "Thank you."
msgstr "고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 2c9d3acc-d77f-ed29-4783-348c891cd181
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCE_Shadowheart_Event_GiveSeluneSpear(1) = True
#.     - SCE_Shadowheart_Event_GiveNightSpear(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:2c9d3acc-d77f-ed29-4783-348c891cd181
msgctxt "hf85e0999gd5afg47b2gbb4fg3e6c637bd097"
msgid "Thank you."
msgstr "고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 2d50ea2c-0042-1207-1a38-f23e065e4e83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:2d50ea2c-0042-1207-1a38-f23e065e4e83
msgctxt "h84ad7224ga2ceg44dfg9e70gbf8c777a2672"
msgid "But now the veil has been parted. You know what must be done, I trust?"
msgstr "하지만 드디어 장막이 걷혔노라. 내가 믿건대, 앞으로 뭘 해야 하는지 알고 있겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 2f64eb7c-12af-9fbf-2513-7948547ac6b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:2f64eb7c-12af-9fbf-2513-7948547ac6b7
msgctxt "h90b8866agfc02g41fcga119g3d9aaafd9435"
msgid "We've got other concerns."
msgstr "우리에게는 다른 골칫거리가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 2fb7eaa3-a89f-2a53-980f-b95c8edc4a54
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - Shadowheart_InParty_State_PreparingHairChange = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:2fb7eaa3-a89f-2a53-980f-b95c8edc4a54
#, fuzzy
msgctxt "hc2d7aac9g1dc9g4705g8be4g57f6cff34e4c"
msgid ""
"<i>You still wear your hair like that of a novice. You should change it.</i>"
msgstr "<i>당신은 여전히 입회자 시절처럼 머리를 기르고 있다. 바꿔야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 3302881b-399f-ece1-c460-01da84a1a2f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:3302881b-399f-ece1-c460-01da84a1a2f8
msgctxt "hf9e09af5g562ag44acgbb22gb53ad6efb589"
msgid "I chose to do that. For the mission. To protect Shar's -"
msgstr "내가 선택한 삶이에요. 임무를 위해, 보호하기 위해 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 33740734-0d3e-17f4-7e9a-fb8fdfc06a1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:33740734-0d3e-17f4-7e9a-fb8fdfc06a1c
msgctxt "h51ac5cedg9621g42d3g8422g27d3507a8806"
msgid ""
"Your parents are with your abductors. You will need to return to their lair. "
"But be warned."
msgstr "그대의 양친은 그대의 유괴범들과 함께 있노라. 그들의 소굴로 돌아가되, 경계를 늦추지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 33c1a553-eb8f-0275-f6ce-f4cade7a7ab2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:33c1a553-eb8f-0275-f6ce-f4cade7a7ab2
msgctxt "ha9f808fagc2d2g4060g9406g04b7b57bcb38"
msgid ""
"Your mind is a deep, dark wood. There are dead ends, shadowy corners, "
"lurking threats. I was lucky to be able to glean as much as I did."
msgstr ""
"그대의 마음은 깊고 어두운 숲과 같다. 막다른 길, 어두운 구석, 도사린 위협들로 얼룩졌지. 그 사이를 비집고 들어간 건 순전히 "
"행운이었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 36870dc1-0ba7-c2ed-4dbc-d64231b82f1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:36870dc1-0ba7-c2ed-4dbc-d64231b82f1e
msgctxt "h2b4903cag7682g4c71ga05dg0d2738bdbf3f"
msgid "I'll help."
msgstr "내가 도울게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 3c5367ee-fe0f-dcad-ce3d-789d94837b6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:3c5367ee-fe0f-dcad-ce3d-789d94837b6d
msgctxt "hb0859e7egfae2g4392g8584geff1f9e31d18"
msgid "There must be more you can tell me."
msgstr "제게 더 알려주실 게 있을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 3e360e6a-16da-7e49-73c8-dcec332ab65c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:3e360e6a-16da-7e49-73c8-dcec332ab65c
msgctxt "h228e6d63gf2a3g47f0ga5bege08371074c1f"
msgid "I have kept my word."
msgstr "나는 약속을 지켰다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 3fd0230f-924e-7cc4-4a49-039166955341
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:3fd0230f-924e-7cc4-4a49-039166955341
msgctxt "hc51e9ccdg9321g4924g86d6gcce51a3faee8"
msgid "What... who was that man?"
msgstr "그건... 그 남자는 누구였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 42872e20-3ef6-90ec-ea18-0759b6fad581
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:42872e20-3ef6-90ec-ea18-0759b6fad581
msgctxt "h70e873acga796g467dgb5fcgc33d5998f6ca"
msgid ""
"Shar's embrace is something that was forced upon you. It is not your true "
"nature."
msgstr "샤의 포용은 그대에게 강요된 처사였다. 그 길은 그대의 본성과 어긋나는 길이었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 48a2177b-72eb-7dc6-bf30-caa55a1be44c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:48a2177b-72eb-7dc6-bf30-caa55a1be44c
msgctxt "h10150609g5b15g4cd4g8201g2f90a6ab0e5f"
msgid ""
"Besides, there are more hardships ahead. Knowing too much may cause you to "
"despair, while a little ignorance may shield you."
msgstr "더군다나, 앞으로 더 많은 어려움이 따를 것이다. 지나친 앎은 그대를 좌절시키지만, 사소한 무지는 그대를 지켜 주는 법이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 4ba9e73c-9cc8-cdeb-cbb4-424b9641ef9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:4ba9e73c-9cc8-cdeb-cbb4-424b9641ef9d
msgctxt "hd864e5fegf52bg470bga7ebga2ecc71a1a31"
msgid ""
"One last thing: your parents have been in the hands of Shar's followers for "
"some forty years. It must take tremendous will for mortals to hold out that "
"long."
msgstr ""
"마지막으로: 그대의 양친은 거의 40년 간 샤의 추종자들에게 붙잡혀 있었다. 필멸자들이 그토록 오랜 시간을 인내했다면 필시 대단한 의지가 "
"뒤따랐으리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 4d0c8b70-fe8b-3f7e-a922-3c445fd334a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:4d0c8b70-fe8b-3f7e-a922-3c445fd334a2
msgctxt "he1933853g068dg4c66gbef2g7a56fbea24b5"
msgid "I think you might be right."
msgstr "어쩌면 당신이 옳을지도 모르겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 4d291c62-d292-724f-a043-8d73a35e3e6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:4d291c62-d292-724f-a043-8d73a35e3e6d
msgctxt "hc3422953g6ec0g4950gb35egedbdcbd8aaa9"
msgid "<i>Close your mind. This is for her alone.</i>"
msgstr "<i>정신을 닫는다. 이것은 그녀만을 위한 기억이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 4ee74621-360e-a7d7-efd3-02bca0c5c170
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:4ee74621-360e-a7d7-efd3-02bca0c5c170
msgctxt "hbdb5b0c9gd645g429egae5dg2dee11cc4eea"
msgid ""
"You were to receive my mother's guidance in those woods. You were to come of "
"age. Instead, Shar's followers snatched you. They must have been watching "
"you for a long time."
msgstr ""
"그대는 그 숲에서 나의 모친께서 내리시는 인도를 받기로 되어 있었다. 그렇게 성인식을 치를 예정이었지. 대신, 샤의 추종자들이 그대를 "
"낚아챘다. 놈들은 오랫동안 그대를 눈독들이고 있었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 5081081d-446e-7553-434e-a06afd42c7bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:5081081d-446e-7553-434e-a06afd42c7bc
msgctxt "h0c64c859g545bg43cbga904g2f75733974dc"
msgid "Perhaps it was just a mistake. A moment of madness."
msgstr "어쩌면 단지 실수였을 수도 있어요. 잠깐 정신이 나갔던 거죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 50dd6482-5b24-c269-f0bf-03e24542f1fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:50dd6482-5b24-c269-f0bf-03e24542f1fc
msgctxt "h7256d043g2bdbg421cg95a7g18b82a324801"
msgid ""
"You will remember this spear, no doubt? It was to be the instrument of my "
"death. Now it will become a parting gift in exchange for my life."
msgstr ""
"이 창을 기억하겠지, 안 그런가? 이것은 본디 내 죽음을 위해 준비되었던 수단이다. 이제 내 목숨과 맞바꾼 이별의 선물로써 그대에게 "
"주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 5137b6e9-dca6-1653-32b9-455c901fd2ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:5137b6e9-dca6-1653-32b9-455c901fd2ec
msgctxt "h925f0fc9g3b51g4eb8g988ag9cb93ea6eef3"
msgid ""
"*A long, sleepless night awaits. But come dawn, you will have reclaimed a "
"little piece of yourself.*"
msgstr "*길고, 잠 못 이루는 밤이 기다립니다. 그러나 새벽이 오면, 당신은 잃어버렸던 자아의 일부를 되찾게 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 51a07fad-3a5b-7528-16ff-7ccae18f9aa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:51a07fad-3a5b-7528-16ff-7ccae18f9aa1
msgctxt "h3296ff9dgeb63g4734g8657g4135a9659f3d"
msgid ""
"And who told you that? Your adoptive family? You are not to blame. You were "
"young, impressionable. They took you because they wanted to break and remake "
"you."
msgstr ""
"누가 그렇게 말하던가? 그대를 입양한 가족이? 그대 책임이 아니다. 그대는 어렸고, 영향 받기 쉬운 나이였지. 놈들은 그대를 무너뜨리고 "
"새로 만들기 위해 그대를 데려갔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 51a9d153-5ef2-91a5-2cc6-75deec39e930
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:51a9d153-5ef2-91a5-2cc6-75deec39e930
msgctxt "hab970bb1g20fag4c65g9678gafd37ba7c8d2"
msgid ""
"We are. Good fortune on your road ahead. It will not be easy, but it will "
"certainly be enlightening."
msgstr "동의한다. 남은 길에 행운을 빌겠다. 쉽지 않은 여정이겠지만, 반드시 깨우침이 뒤따르리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 52a12fac-9d47-507d-b748-807b48242c47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:52a12fac-9d47-507d-b748-807b48242c47
msgctxt "h4a8bb268g1e70g4a94ga21dg61b255c4d979"
msgid ""
"*Your mind joins with Shadowheart's. Something pulls at you both, bringing "
"you elsewhere...*"
msgstr "*당신의 정신이 섀도하트의 정신에 합류합니다. 무언가가 당신 둘을 끌어당겨 어딘가 다른 곳으로 데려갑니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 548bde82-c556-31eb-90d4-3ed2623f4eae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:548bde82-c556-31eb-90d4-3ed2623f4eae
msgctxt "heabd076dgac19g4ff9g9733g82ac170fe82c"
msgid ""
"*You remember that it is a common rite amongst Selûne's followers to send "
"their children off into the woods to find their way home. Perhaps this time "
"it had gone awry.*"
msgstr ""
"*당신은 셀루네식 통과의례에 대한 설교를 기억합니다. 셀루네의 추종자들은 아이들을 야생에 던져 놓고는 스스로 집을 찾아 가도록 "
"강요합니다. 어쩌면 이번에는 일이 꼬였는지도 모르죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 5a907ef9-0f90-bb2c-49ba-f116846b60d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:5a907ef9-0f90-bb2c-49ba-f116846b60d8
msgctxt "h5a40987eg392eg473cg8597g1cd9909cd736"
msgid "A debt repaid. You gave me my life back. Now go and claim your own."
msgstr "이걸로 빚은 갚았노라. 그대는 내 삶을 되찾아 주었다. 이제 가서 그대 자신의 삶을 되찾거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 5b45dd61-a5c2-bdc4-27ef-1f29011c9495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:5b45dd61-a5c2-bdc4-27ef-1f29011c9495
msgctxt "hdf9a0465gb196g490bg9f0ag60f6614244ed"
msgid ""
"You claimed to know something about me - you knew about the wolves. Tell me "
"everything."
msgstr "당신은 나에 대해 무언가 알고 있다고 주장했어요 - 늑대들에 대해서 말이에요. 전부 말해 줘요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 5e4697e8-dd60-5d3f-a291-ae8908c4ad2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:5e4697e8-dd60-5d3f-a291-ae8908c4ad2a
msgctxt "h321d2b1cgc4ecg4100gbef9g41895a9edf15"
msgid "My heritage? What are you talking about?"
msgstr "내 유산이요? 무슨 말씀을 하시는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 5ed8034d-2763-1a5b-af39-9c9ac4357c17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:5ed8034d-2763-1a5b-af39-9c9ac4357c17
msgctxt "hbdf5e5c8g51bfg4b61g8923g2dfb65fa459c"
msgid ""
"*She speaks pure heresy, or so you would have once thought. But you can deny "
"it no longer - a new presence empowers you. You felt it ever since the "
"Shadowfell. <i>Selûne</i>.*"
msgstr ""
"*그녀는 순수한 이단을 지껄이고 있습니다. 한때는 당신도 그렇게 생각했겠죠. 하지만 더는 부정할 수 없습니다 - 새로운 존재가 당신에게 "
"힘을 실어 줍니다. 섀도펠 이후 줄곧 느껴 온 존재입니다. <i>셀루네</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 616a26e1-e1ae-4a2e-81bf-441a2658f529
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_GiveOintment = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:616a26e1-e1ae-4a2e-81bf-441a2658f529
msgctxt "h471064a0g3f41g4d34gb4a7g26a5cd5182d8"
msgid ""
"First Selûne's blessing, and now her gifts. If only the old me could see "
"this..."
msgstr "처음엔 셀루네의 축복이었고, 이젠 그녀의 선물까지. 과거의 내가 이것들을 알아보았더라면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 633eb32d-03d4-c800-6fe1-05809b7875a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:633eb32d-03d4-c800-6fe1-05809b7875a2
msgctxt "had0398c5gebddg47adga649g0e8e7fc56956"
msgid ""
"Your parents both followed the Moonmaiden. I could sense their faith, even "
"in a brief glimpse of the past."
msgstr "그대의 양친은 달처녀를 따르는 자들이었다. 비록 과거의 짧은 순간이었으나, 나는 그들의 신앙을 느꼈노라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 637b49a9-85e3-151c-8feb-a134ea9936dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:637b49a9-85e3-151c-8feb-a134ea9936dc
msgctxt "h711fc9afga65cg4206gbfb9g81efa55620d9"
msgid ""
"Shar may seek to thwart you in that - if she cannot control you, she can at "
"least seek to deny you your past."
msgstr "샤는 그 점을 이용해 그대를 좌절시키려 들겠지 - 그대를 통제할 수 없다면, 그대가 스스로 과거를 부정하도록 만들 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 66844e25-c00d-3c97-5f36-3dc7c87ae1e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:66844e25-c00d-3c97-5f36-3dc7c87ae1e2
msgctxt "h66bb7699g03f5g4d26g95e4g9eae35be53c0"
msgid ""
"I am a daughter of Selûne - we illuminate darkness. We do not not create it."
msgstr "나는 셀루네의 여식일지니 - 우리는 어둠을 몰아내지, 도리어 만들어 내지는 않는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 66885154-4691-2d40-43f5-95553bbca7c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:66885154-4691-2d40-43f5-95553bbca7c3
msgctxt "h18985162gf366g456egb2f3g87649261c1ca"
msgid ""
"There are always other concerns. Let Shadowheart at least be forewarned."
msgstr "골칫거리는 언제나 있는 법. 최소한 섀도하트가 미리 경계 받도록 두어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 669f1a0a-6d95-4b4b-4579-238d77e3a7fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:669f1a0a-6d95-4b4b-4579-238d77e3a7fd
msgctxt "hd50ca3cfgf7f4g4fc1g82e9g6d42aae77ec0"
msgid ""
"...and mirrored. Take it - you will need it. But what you do with it... that "
"will be up to you. Same as before."
msgstr ""
"...마치 거울처럼. 취하거라 - 분명 필요해질 것이다. 다만 이것으로 무엇을 행할지는... 그대에게 달려 있다. 항상 그랬듯이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 67b3cc4d-db10-a94d-0dc1-ac5cc90ebd0d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Shadowheart_Debug_StartWolfDream(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:67b3cc4d-db10-a94d-0dc1-ac5cc90ebd0d
msgctxt "h55193f98g5b4bg434egb386g4f66c5bd63a2"
msgid "*A memory appears at the forefront of your mind.*"
msgstr "*기억 하나가 당신의 마음 한가운데 나타납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 6818b238-c44d-0738-518c-cf0ded4bab08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:6818b238-c44d-0738-518c-cf0ded4bab08
msgctxt "hb55b4783g1fe4g4402ga752g491cdc2a7a3f"
msgid ""
"You already know who he is. Did you not see yourself in him? Do you not "
"recognise your own blood?"
msgstr "그대는 이미 알고 있다. 남자의 얼굴에서 스스로를 발견하지 못했는가? 그대는 그대 자신의 핏줄조차 알아보지 못하는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 6847bbc1-17aa-b696-2100-ec9efe7f3782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:6847bbc1-17aa-b696-2100-ec9efe7f3782
msgctxt "he19f74dcg05fbg4c88gbf71g319e49b74db1"
msgid "Yes, a pain that I understand all too well."
msgstr "좋다, 그대의 고통을 나 또한 십분 이해하노라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 696c7a44-7c27-f248-3593-6d9ea244c0f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:696c7a44-7c27-f248-3593-6d9ea244c0f9
msgctxt "h2dac093eg9a35g4ee8gb10dg3835d0dc7c20"
msgid "I have to find my parents."
msgstr "부모님을 찾아야겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 6d78331c-796b-1868-7e91-2d998d51c683
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:6d78331c-796b-1868-7e91-2d998d51c683
msgctxt "h9bc3e40cgae1fg47d2g9495g3ea28c537af1"
msgid "Perhaps this isn't a good idea."
msgstr "좋은 생각이 아닐지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 6dec74c4-d4dc-b08f-1529-ffcb3df53ed8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:6dec74c4-d4dc-b08f-1529-ffcb3df53ed8
msgctxt "hf00eeeceg176eg42d3ga640g6d8a97e7b16e"
msgid "I just want to remember what I lost."
msgstr "내가 잃어버린 게 뭔지 알고 싶을 따름이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 6dfad28e-3f16-877c-9d3a-cf44ce56ca65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:6dfad28e-3f16-877c-9d3a-cf44ce56ca65
msgctxt "h709959cfg0a7eg4e03ga82dgaa30072d2eee"
msgid "The natural conclusion is that you are no true Sharran, and never were."
msgstr "그렇다면 그대가 진정한 샤 신도가 아니며, 숫제 속했던 적조차 없다고 보는 편이 자연스러운 결론이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 6e051e8b-be39-f470-c8ba-522cbfeed786
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:6e051e8b-be39-f470-c8ba-522cbfeed786
msgctxt "hdc6cd67ag9e7dg4cf6g96fegbfa40379024d"
msgid "The elf you saw was your father. He tried to stop them, but failed."
msgstr "그대가 목격한 엘프는 그대의 부친이다. 그는 놈들을 막으려고 했지만, 실패했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 72ec2b40-383a-fe28-eadc-5725158ab4f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:72ec2b40-383a-fe28-eadc-5725158ab4f3
msgctxt "h31b8c4f6gebffg4e97g82ccgfec102f30dcd"
msgid ""
"You were to receive Selûne's guidance in those woods. You were to come of "
"age. Instead, Shar's followers snatched you. They must have been watching "
"you for a long time."
msgstr ""
"그대는 그 숲에서 셀루네의 인도를 받기로 되어 있었다. 그렇게 성년식을 치러야 했지. 대신, 샤의 추종자들이 그대를 낚아챘다. 오랫동안 "
"그대를 눈독들여 왔겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 73cb9181-dfe0-6761-6195-b5726ecb9ff0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:73cb9181-dfe0-6761-6195-b5726ecb9ff0
msgctxt "h2aade519gb61eg44e9g8f81gacf5df74c10f"
msgid "They're alive? How? <i>Where?</i>"
msgstr "부모님이 살아 계시다고요? 어떻게? <i>어디에요?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 73df2eb2-c8be-efc4-0ade-403e441958de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:73df2eb2-c8be-efc4-0ade-403e441958de
msgctxt "ha1f7e284gf236g4ce7ga4cdg26f85b9e6f27"
msgid "The Spear of Night? I thought that was cast into the Shadowfell."
msgstr "밤의 창? 섀도펠에 던져진 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 749484bc-8a25-06cb-789d-6c78d2396b04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - CAMP_Shadowheart_State_HadNightsongMeeting = True
#.     - ORI_Shadowheart_State_ExistentialistCrisis = False
#.     - ORI_Shadowheart_Knows_HasSeenWolfDream = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:749484bc-8a25-06cb-789d-6c78d2396b04
msgctxt "habc47be2g2bddg4727g9058g2442ff9d09a2"
msgid ""
"What do you know about me? You spoke of my past, being chased by wolves - I "
"told no one about that..."
msgstr "나에 대해 뭘 알고 있죠? 내 과거에 대해, 나를 쫓던 늑대들에 대해 언급했잖아요 - 아무에게도 말한 적 없는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 75a2fcef-a658-25b8-0ea3-8470b1c17d3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:75a2fcef-a658-25b8-0ea3-8470b1c17d3c
msgctxt "h9635fcb2ga567g4678ga03ag399bcde2efdf"
msgid ""
"How do I know this isn't some trick? You could have tampered with my "
"memories."
msgstr "이 모든 게 속임수가 아니라고 장담할 수 있어요? 당신이 내 기억을 조작했을지도 모르잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 778ac6c6-073e-13fa-8b8c-0b4549cd5bd0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:778ac6c6-073e-13fa-8b8c-0b4549cd5bd0
msgctxt "h46025f2cg6e3ag46e5gbb3dg7e0178b38efc"
msgid ""
"*You remember that it is a common rite amongst Selûne's followers to send "
"their children off into the woods to find their way home. Perhaps this time "
"it had gone awry.*"
msgstr ""
"*당신은 셀루네식 통과의례에 대한 설교를 기억합니다. 셀루네의 추종자들은 아이들을 야생에 던져 놓고는 스스로 집을 찾아 가도록 "
"강요합니다. 어쩌면 이번에는 일이 꼬였는지도 모르죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 787ef582-7da0-8f92-786a-a7162f230365
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:787ef582-7da0-8f92-786a-a7162f230365
msgctxt "hdeac4e05g791eg4562ga5c4g43ca8ac3133d"
msgid ""
"...Until you weren't. Do you think it was but a brief lapse? A moment of "
"madness? No. I think you finally listened to your heart."
msgstr ""
"...더는 아니지. 단순한 실수였다고 말하고 싶은가? 잠시 정신이 나갔었다고? 아니다. 그대가 마침내 마음의 소리를 듣게 된 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 7acc0ea8-61e3-a1bf-278a-b7155dc7b084
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:7acc0ea8-61e3-a1bf-278a-b7155dc7b084
msgctxt "heeb8cf3age3a3g458egad0bg5f860dc10cf4"
msgid ""
"You will have to face your abductors in their very lair, in Baldur's Gate."
msgstr "그대는 발더스 게이트에 숨겨진 유괴범들의 소굴에서 그들을 마주해야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 7b153821-8430-f6b1-c50d-06d0b49e57a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:7b153821-8430-f6b1-c50d-06d0b49e57a8
msgctxt "h6e64fd73g544cg437cg9753g77f6629596bf"
msgid ""
"No. A moment of clarity. You finally listened to yourself, and stopped "
"resisting your true nature."
msgstr "아니. 정신이 돌아오는 순간이었겠지. 그대는 마침내 스스로에게 귀를 기울이고, 본성에 저항하는 일을 멈추었던 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 7cd92e64-3d84-4d31-ed94-ff9eef82ad58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:7cd92e64-3d84-4d31-ed94-ff9eef82ad58
msgctxt "hbbd053b6gaeb1g405dga168gb4ca2e9392f3"
msgid ""
"See that your parents' sacrifices are not in vain: allow the Moonmaiden to "
"guide you at last."
msgstr "그들의 희생이 헛되지 않았음을 보이거라 : 마침내 달처녀께서 다시 그대를 이끄심을 보이거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 7d48bb1a-897b-3241-de25-bdd761b20f3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:7d48bb1a-897b-3241-de25-bdd761b20f3f
msgctxt "h09191f24gce67g49b6g85f7g00cae691338b"
msgid "*...It seems that one child never came back. She was taken.*"
msgstr "*...한 아이가 돌아오지 않은 것 같습니다. 그녀는 납치되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 7d8e15c2-f691-1072-0ba4-f15b25331d6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:7d8e15c2-f691-1072-0ba4-f15b25331d6e
msgctxt "he2a81152ga269g46e3gb161g097dc3a8bfc8"
msgid "Do not pine for the nightmare now that you are finally awake."
msgstr "마침내 깨어났으니, 지나간 악몽 때문에 비통에 잠기지 말라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 7e9f57f2-e88e-237f-c161-1402a9852e9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:7e9f57f2-e88e-237f-c161-1402a9852e9e
msgctxt "ha93f208eg4e0bg461agb3b9ge35d554638e6"
msgid ""
"Come now. I do not believe you did not suspect something was amiss. No true "
"Sharran would have hesitated to skewer my heart."
msgstr ""
"설마. 그대가 뭔가 잘못되었다는 느낌을 눈치채지 못했으리라 생각치 않는다. 참된 샤 신도였다면 내 심장을 꿰뚫는 걸 망설이지 않았겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 827b9694-a4f2-1dcc-70a4-330f9267fd9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:827b9694-a4f2-1dcc-70a4-330f9267fd9f
msgctxt "h6b31c769g4379g4931ga774gff5b867c3eee"
msgid ""
"You claimed to know something about me - you knew about the wolves. Tell me "
"everything."
msgstr "당신은 나에 대해 무언가 알고 있다고 주장했어요 - 늑대들에 대해서 말이에요. 전부 말해 줘요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 8280e1e0-e0ec-3298-cff3-997aea0ce1ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:8280e1e0-e0ec-3298-cff3-997aea0ce1ed
msgctxt "he483fe8fgca7eg4cefg9922g1f7c1b428e67"
msgid ""
"When you freed me from the Shadowfell, you severed a bond between me and "
"that dog, Thorm. A bond of pain - his, inflicted on me."
msgstr "그대가 나를 섀도펠에서 풀어 주었을 때, 나와 그 개 - 쏨의 연결 또한 끊어졌다. 놈이 내게 안겼던 고통의 끈 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 83502fcc-654c-2e79-c9f8-70d93a3d7ffb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:83502fcc-654c-2e79-c9f8-70d93a3d7ffb
msgctxt "ha959baadg5a4dg4188gaaf3g228924e76d12"
msgid ""
"<i>This is not the time for symbolic gestures. You must stay focused.</i>"
msgstr "<i>지금은 상징적인 조치를 취할 때가 아니다. 긴장을 놓아선 안 된다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 83be8a96-dd02-d3f3-a322-f1fb235538f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:83be8a96-dd02-d3f3-a322-f1fb235538f3
msgctxt "h60927aa3g715dg4eceg9de0gbc5dda60f192"
msgid "Does this mean you're a Selûnite?"
msgstr "네가 셀루네 신도라는 뜻이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 8523300a-5497-fa9f-9b54-13c782abbf76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_HasSeenWolfDream = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:8523300a-5497-fa9f-9b54-13c782abbf76
msgctxt "hf23f58f3g0f6cg407ag85e3g4ff4599eefbc"
msgid "...Almost no one. But I certainly didn't share that with you."
msgstr "...거의 아무에게도. 하지만 분명 당신에게 이야기한 적은 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 86df65df-9472-77f2-b79a-05bd9818f80b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:86df65df-9472-77f2-b79a-05bd9818f80b
msgctxt "h73ab56c1g616cg4070g96e4ga2021499e1e8"
msgid ""
"But I felt it call to me as I took flight. Whatever Shar calls her own, "
"Selûne has equal claim to. They are one and the same. Their power is "
"matched..."
msgstr ""
"하지만 날아오르던 중에 창의 부름을 들었다. 샤가 자신의 것이라고 주장하는 것은 무엇이든 셀루네의 것이기도 하다. 둘은 하나이며 "
"동일하노라. 그들의 권능은 일치하지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 8a937f67-9498-d3e3-7f00-7637016fc91b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:8a937f67-9498-d3e3-7f00-7637016fc91b
msgctxt "hc2bdc542g799bg4d3dg9258g01ee3f84213d"
msgid "That can't be. I'm an orphan."
msgstr "그럴 리가 없어. 난 고아라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 8ba5a7c7-e613-b1c7-4892-b0aa1293b6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:8ba5a7c7-e613-b1c7-4892-b0aa1293b6ea
msgctxt "h961a17fcg5909g4adbgb52cg5971dbe83187"
msgid "Shar's weapon? Surely it's useless now."
msgstr "샤의 무구? 이제 그 기능을 다 잃었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 8d5766a0-a8c8-c379-b20d-ee6f11e6186c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:8d5766a0-a8c8-c379-b20d-ee6f11e6186c
msgctxt "h14382527g92beg48d4ga94ega50dbe83001a"
msgid ""
"For her purposes, perhaps. Shar is quick to discard whatever she has no use "
"for. I think you know that well enough."
msgstr "샤의 계획에서는 어긋났지, 사실이야. 샤는 쓸모없는 패는 냉큼 던져 버리지. 그대도 이미 잘 알고 있다시피 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 8e66b948-8e2d-c11d-6936-e38bc78688d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:8e66b948-8e2d-c11d-6936-e38bc78688d9
msgctxt "h9c84d16fg7c22g469ega1dcg8d07c273deed"
msgid "Whatever you have to say, just say it."
msgstr "해야 할 말이 있다면, 그냥 들려 줘요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 8eb1161b-2834-173c-b6d6-797353e66eb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_SeluniteForestRitual = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:8eb1161b-2834-173c-b6d6-797353e66eb6
msgctxt "h96714977gbdbdg48c5gbbb3g23d81ad8ba1a"
msgid ""
"*Something sparks in your memory. Teachings about Selûnite rites of passage, "
"about how they would abandon their children out in the wilds and force them "
"to find their way home...*"
msgstr ""
"*무언가 당신의 기억에서 불꽃을 피웁니다. 셀루네식 통과의례에 대한 가르침으로, 아이들을 야생에 던져 놓고는 스스로 집을 찾아 가도록 "
"강요하는 의식입니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 90244df3-5bc8-406d-76c1-8624cd4d0b1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:90244df3-5bc8-406d-76c1-8624cd4d0b1b
msgctxt "ha0d21087g6e10g4125gb17cg89aafb7c4210"
msgid "Let me help you remember so there will be no doubt."
msgstr "그대의 기억에 접근하게 해 다오. 내 말을 의심하지 않도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 908c31c2-d126-667f-77d7-fbb87e3511a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Shadowheart_State_HadNightsongMeeting = True
#.     - ORI_Shadowheart_State_ExistentialistCrisis = False
#.     - ORI_Shadowheart_Knows_HasSeenWolfDream = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:908c31c2-d126-667f-77d7-fbb87e3511a1
msgctxt "h4d2cdb1ega08dg4eb8g80bcgddd35a8acdc5"
msgid "It is time we spoke about your heritage. There is a debt I must repay."
msgstr "이제 그대의 유산에 관해 이야기 나눌 시간이로구나. 그대에게 빚진 설명들이 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = 916779ca-746b-d4f3-e246-0a4d5be9693f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCE_Shadowheart_Event_GiveSeluneSpear(1) = True
#.     - SCE_Shadowheart_Event_GiveNightSpear(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:916779ca-746b-d4f3-e246-0a4d5be9693f
#, fuzzy
msgctxt "hd7d048f9g90c2g4106ga9dfg6e9fc54a71ab"
msgid "I'll need every advantage, it seems... Thank you."
msgstr "짐작건대 어떤 이점이든 필요해질 거예요... 고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 91a03c94-2183-74df-62c8-5972bef733a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:91a03c94-2183-74df-62c8-5972bef733a5
msgctxt "h4f2097aag2876g4102gb1f0g1e4516a67469"
msgid ""
"Forget her. She was forged by lies. Be guided only by who you have become."
msgstr "그녀는 잊어라. 온갖 거짓으로 위조된 삶이었으니. 오직 그대가 걷고자 하는 삶을 향해 걸어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 93a8306e-7f28-b653-4c89-774ac7319dc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:93a8306e-7f28-b653-4c89-774ac7319dc7
msgctxt "h96f7db1fgbd63g4759gade9g40910b8e9b0a"
msgid ""
"I was able to retrieve it, before it sank too far into Shar's umbral domain."
msgstr "샤의 암영에 너무 깊이 가라앉지 않아서 회수할 수 있었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 98f58848-26d8-8a11-f0f3-a8e71e2ebdbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:98f58848-26d8-8a11-f0f3-a8e71e2ebdbb
msgctxt "h742bf57cga450g4e32gb012ge8674c5d2172"
msgid ""
"There is nothing I can tell you that you do not already know yourself. They "
"trained you well, trained you hard. Chiselled away any part of you that did "
"not fit their plan. They made you forget."
msgstr ""
"그대 스스로가 이미 알고 있는 사실에 대해서라면 알려줄 게 없다. 놈들은 그대를 잘 훈련시켰고, 혹독하게 훈련시켰다. 놈들의 계획에 "
"들어맞지 않는 부분은 뭐든 깎아냈지. 놈들은 그대가 잊게 만들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 994f9fa9-22c1-ee7f-bdcf-619efcde73ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:994f9fa9-22c1-ee7f-bdcf-619efcde73ec
msgctxt "h639d3d27g02b7g42fegaec6g66d0b739046b"
msgid ""
"Forget her. She was forged by lies. Be guided only by who you have become."
msgstr "그녀는 잊어라. 온갖 거짓으로 위조된 삶이었으니. 오직 그대가 걷고자 하는 삶을 향해 걸어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 9c126cc1-3308-fc42-ee04-d646ec484cf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:9c126cc1-3308-fc42-ee04-d646ec484cf4
msgctxt "h7de24f4fg9df5g4ef4gb723g3272a409d731"
msgid ""
"There is one more way in which I can help you. You have been forewarned, and "
"now you shall be forearmed."
msgstr "그대에게 한 가지 더 도움을 주겠다. 그대는 미리 경고를 들었으니, 늦지 않게 경비되어야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = 9cd5ca6d-280f-196f-3760-53c957be5c0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:9cd5ca6d-280f-196f-3760-53c957be5c0f
msgctxt "hc6dcb261gc353g4386g8e10g09de3f0c9d81"
msgid ""
"That is how Shar wished it to be. She robbed you of your childhood, all to "
"spite her twin."
msgstr "그게 바로 샤가 원했던 것이다. 그녀는 단지 쌍둥이 자매를 괴롭힐 목적으로 그대의 유년 시절을 빼앗았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = 9e72c64f-02ac-4e1c-8e91-c85e5982475d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:9e72c64f-02ac-4e1c-8e91-c85e5982475d
msgctxt "h57167f53ga437g4cd1gbad4gd7c0e7287390"
msgid ""
"*Pain surges from the wound on your hand... but no memory comes with it - no "
"lesson. Just agony.*"
msgstr "*손의 상처에서 고통이 밀려 듭니다... 하지만 그에 따른 기억은 없습니다 - 교훈도 없습니다. 오직 고통뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 9efa647d-3ab8-7eb0-e20f-c2c69c9a6180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:9efa647d-3ab8-7eb0-e20f-c2c69c9a6180
msgctxt "h7ea51bedg185dg421bgaabagcccccde0ceec"
msgid "My father? That was him?"
msgstr "아빠? 그게 우리 아빠였다고요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = 9fbe09c9-afb8-f10d-99ef-52817b16d86b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:9fbe09c9-afb8-f10d-99ef-52817b16d86b
msgctxt "hf5b35cbag2819g4854ga2aagacc4b87b3973"
msgid "There must be more you can tell me."
msgstr "제게 더 알려주실 게 있을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = a08ff3d8-d3e1-cb80-db08-2df6dba7c3fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:a08ff3d8-d3e1-cb80-db08-2df6dba7c3fd
msgctxt "h76f4eec5g3769g4179g8498g6060a717c58f"
msgid ""
"When you freed me, you severed a bond between me and that dog, Thorm. A bond "
"of pain - his, inflicted on me."
msgstr "그대가 나를 풀어 주었을 때, 나와 그 개 - 쏨의 연결 또한 끊어졌다. 놈이 내게 안겼던 고통의 끈 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = a2a066bf-5f5c-3da4-49f9-47972e58994a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:a2a066bf-5f5c-3da4-49f9-47972e58994a
msgctxt "hbc3ba7bdg12b4g4b76g84a1g19af9b4a355c"
msgid ""
"There is nothing I can tell you that you do not already know yourself. They "
"trained you well, trained you hard. Chiselled away any part of you that did "
"not fit their plan. They made you forget."
msgstr ""
"그대 스스로가 이미 알고 있는 사실에 대해서라면 알려줄 게 없다. 놈들은 그대를 잘 훈련시켰고, 혹독하게 훈련시켰다. 놈들의 계획에 "
"들어맞지 않는 부분은 뭐든 깎아냈지. 놈들은 그대가 잊게 만들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = a82f46f3-bd72-e704-49d2-6e049b39ebd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:a82f46f3-bd72-e704-49d2-6e049b39ebd9
msgctxt "h7716ec31g2aa3g48f8gb4b4ga10a1b807821"
msgid ""
"What life? The lie you've led until this moment? Confront the past, or your "
"future is nothing but a coward's charade."
msgstr ""
"어떤 인생 말인가? 지금껏 그대를 이끌어 왔던 거짓? 과거를 직시하지 않는다면, 그대의 미래는 겁쟁이의 가식에 지나지 않을 따름이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = aa02f730-a42b-16b2-e5b3-71c2c68e25ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:aa02f730-a42b-16b2-e5b3-71c2c68e25ac
msgctxt "h2326da23g6012g45e3gac65g5fceb36a9fd6"
msgid "That can't be. I was always loyal to Shar."
msgstr "그럴 리가 없어. 난 언제나 샤께 충성을 바쳤다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = aacd6fad-b878-f9c1-547c-8ec88fd70946
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:aacd6fad-b878-f9c1-547c-8ec88fd70946
msgctxt "h4aca6261g06a3g457dga598g81a650fc7541"
msgid ""
"Shar is quick to discard whatever she has no use for. I think you know that "
"well enough."
msgstr "샤는 쓸모없는 패는 냉큼 던져버리지. 그대도 이미 잘 알고 있다시피 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = ad1ecd4f-756a-e87b-7b34-39b2fa9499ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_HasSeenWolfDream = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:ad1ecd4f-756a-e87b-7b34-39b2fa9499ee
msgctxt "h633d643age15eg4634g9fcdg614b09f888d5"
msgid ""
"*You feel Shadowheart's mind tug at the edges of your own. You know this "
"sensation. She wants you to see whatever is about to be revealed.*"
msgstr ""
"*당신은 섀도하트의 정신이 당신 정신의 끄트머리를 붙잡고 이끄는 걸 느낍니다. 익숙한 감각입니다. 그녀는 곧 밝혀질 비밀을 당신이 지켜봐 "
"주기를 원합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = ae1d360c-65a4-b805-cedb-90b314160997
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:ae1d360c-65a4-b805-cedb-90b314160997
msgctxt "h56c6c302g437ag4cb9g85e7g932e2e08175b"
msgid ""
"Shar torments you still. What a spiteful creature she is. This will not stop "
"until you take action."
msgstr "샤는 여전히 그대를 괴롭히는구나. 얼마나 표독스러운 존재인가. 조치를 취할 때까지 그 시달림에서 벗어날 수 없으리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = b0cbd53b-1c19-d48e-4f64-c3f7ed4b04a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:b0cbd53b-1c19-d48e-4f64-c3f7ed4b04a9
msgctxt "hcd082bacg54d0g4f20ga3ceg7ce88a449f01"
msgid "I'm going to make them pay for what they did to me."
msgstr "그들이 내게 저지른 짓의 대가를 치르게 하겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = b6d01b25-def3-4121-aff2-40b6a082b024
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:b6d01b25-def3-4121-aff2-40b6a082b024
msgctxt "h871a7721g75e1g49f2ga4efg8d4050f2cfa9"
msgid ""
"Shar toys with you still. What a spiteful creature she is. This will not "
"stop until you take action."
msgstr "샤는 여전히 그대를 조롱하는구나. 얼마나 표독스러운 존재인가. 조치를 취할 때까지 그 시달림에서 벗어날 수 없으리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = be19a07c-1e0f-3a0d-56c0-6771d7c7c9fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:be19a07c-1e0f-3a0d-56c0-6771d7c7c9fd
msgctxt "h24499ed0g558eg405dg8029g3efda64e926f"
msgid ""
"See that their sacrifices are not in vain: allow the Moonmaiden to guide you "
"at last."
msgstr "그들의 희생이 헛되지 않았음을 보이거라 : 마침내 달처녀께서 다시 그대를 이끄심을 보이거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = c05f8290-67ac-71c9-c1c5-6c0cb3746d7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c05f8290-67ac-71c9-c1c5-6c0cb3746d7a
msgctxt "hf63f9b2agc04fg4bf8g8caegdeec686f1da2"
msgid "It seems we're even."
msgstr "공평한 거래였어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = c0bc8c5a-b4ca-d0c4-b373-481911aadd66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c0bc8c5a-b4ca-d0c4-b373-481911aadd66
msgctxt "h47d9a768g0f96g48e0ga698g13d26f3db71a"
msgid "My parents. I need to save them."
msgstr "부모님. 그들을 구해야겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = c29dd2c7-03d5-0d58-bf98-46ee992dc693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c29dd2c7-03d5-0d58-bf98-46ee992dc693
msgctxt "h5d057e51gd538g440bg8752g0b6618555208"
msgid "A debt repaid. You returned my life unto me. Now go and claim your own."
msgstr "이걸로 빚은 갚았노라. 그대는 내 삶을 되찾아 주었다. 이제 가서 그대 자신의 삶을 되찾거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = c4188171-40b2-231a-9008-76c21a28c0c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c4188171-40b2-231a-9008-76c21a28c0c1
msgctxt "h3c12716agefe3g4a4dga9a6gfd93f70126f9"
msgid "Careful - isn't that thing supposed to be able to kill you?"
msgstr "조심해요 - 그 물건은 당신을 죽일 수도 있지 않던가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = c63c957a-4ecf-554f-a4d7-6f60479a6b7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c63c957a-4ecf-554f-a4d7-6f60479a6b7f
msgctxt "h66da25b7g1334g44a2g8fd3g4c4bd6d62e1f"
msgid ""
"You already know. Did you not see yourself in him? Do you not recognise your "
"own blood?"
msgstr "그대는 이미 알고 있다. 남자의 얼굴에서 스스로를 발견하지 못했는가? 그대는 그대 자신의 핏줄조차 알아보지 못하는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = c6a327d1-73cd-e2bc-45d2-533a30b58a8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c6a327d1-73cd-e2bc-45d2-533a30b58a8a
msgctxt "hf164581ag14ddg4bdbgb3a6g0bcce1dd4fd0"
msgid "I thought that was lost in the Shadowfell. How do you have it?"
msgstr "섀도펠에서 잃어버린 줄 알았는데요. 어떻게 회수하셨죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = c9942c9c-be95-dc8b-8d53-afc23931c27a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c9942c9c-be95-dc8b-8d53-afc23931c27a
msgctxt "hbc12b78fg3c43g4933g83cbgbc8c195ee6b8"
msgid "I'm sorry for your parents, but we have other concerns."
msgstr "네 부모님께 일어난 일은 유감이야. 하지만 우린 신경쓸 일이 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = c9b10bcb-6176-7dc6-1203-4effb5206c59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:c9b10bcb-6176-7dc6-1203-4effb5206c59
msgctxt "hac0f80e5g7d3fg44dbg8c02g0b05a15832ac"
msgid ""
"*Take action, yes... but freeing your parents will take time. Perhaps there "
"is something more immediate you can do - something symbolic, to put Shar "
"behind you for good.*"
msgstr ""
"*조치를 취하라, 그럼요... 하지만 부모님을 풀어주기까지는 시간이 걸립니다. 지금 당장 할 수 있는 일이 있을지도 모릅니다 - 샤를 "
"영영 과거에 남겨 두기 위해 취할 수 있는 상징적인 조치 말이죠.\""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = ca9c3e78-1616-bad9-3b4b-0e18ab526682
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:ca9c3e78-1616-bad9-3b4b-0e18ab526682
msgctxt "h1074f8d7ge30bg4f7eg9554g9638cfddaeea"
msgid ""
"You may have once thought of them as comrades, mentors, friends, even "
"lovers. They will all be enemies now."
msgstr "그대는 한때 그들을 동지이자 멘토, 친구, 심지어는 연인으로 여겼으리라. 하지만 지금부터 그들 모두가 그대의 원수이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = cd6868a9-8066-be5f-14c6-c34870cb5129
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:cd6868a9-8066-be5f-14c6-c34870cb5129
msgctxt "h62968f5eg200dg469cg9a81ga2c5bd50fe94"
msgid "I thought that was lost in the Shadowfell. How do you have it?"
msgstr "섀도펠에서 잃어버린 줄 알았는데요. 어떻게 회수하셨죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = cdb5fe1b-7b02-a4e0-184e-8289794cdf27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:cdb5fe1b-7b02-a4e0-184e-8289794cdf27
msgctxt "h72b4d2d1g1441g4a47g96b4gc78d87b9931e"
msgid ""
"And who told you that? Your adoptive family? You are not to blame. You were "
"young, impressionable. They took you because they wanted to break and remake "
"you."
msgstr ""
"누가 그렇게 말하던가? 그대를 입양한 가족이? 그대 책임이 아니다. 그대는 어렸고, 영향 받기 쉬운 나이였지. 놈들은 그대를 무너뜨리고 "
"새로 만들기 위해 그대를 데려갔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = cfff47bc-2b5e-9f84-81c2-b0081acd532d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:cfff47bc-2b5e-9f84-81c2-b0081acd532d
msgctxt "h7c05434egc8b2g4bbcg80a7g7e3eeef429da"
msgid ""
"Your parents both followed the Moonmaiden. I could sense their faith, even "
"in a brief glimpse of the past."
msgstr "그대의 양친은 달처녀를 따르는 자들이었다. 비록 과거의 짧은 순간이었으나, 나는 그들의 신앙을 느꼈노라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = d1183575-76ef-2282-6fd0-4e487e7c8590
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:d1183575-76ef-2282-6fd0-4e487e7c8590
msgctxt "hc54f26feg6feag4f10gb7dbgaf3ebf4fab10"
msgid ""
"- secrets. Yes, yes. That is an old song, girl. Your goddess cares more for "
"her precious secrets than she does her devotees."
msgstr ""
"- 샤의 비밀을. 암, 그렇고 말고. 실로 오래된 가사이지, 소녀여. 그대의 여신은 신자들보다 자신의 소중한 비밀에 더 관심이 많지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Isobel
#. NodeID = d354193b-f271-967d-dcff-62ef7056d774
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:d354193b-f271-967d-dcff-62ef7056d774
msgctxt "h16643053g1262g4dbag9e8cg423edaa56c97"
msgid ""
"It is a tragedy that the Moonmaiden's rite was perverted by Shar. Your "
"future was stolen from you."
msgstr "달처녀의 의식이 샤에 의해 뒤틀린 것은 비극이다. 그대는 그대의 미래를 스스로 빼앗게 된 셈이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = d77dbf67-a7a9-cc99-e0f2-fb7e8c50875a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:d77dbf67-a7a9-cc99-e0f2-fb7e8c50875a
msgctxt "h0981f775gc097g4a8cgb8f6g8ea012d6a740"
msgid "That can't be. I was always loyal to Shar."
msgstr "그럴 리가 없어. 난 언제나 샤께 충성을 바쳤다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = d8c088fc-e612-d2ab-69c4-8c84b02822b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:d8c088fc-e612-d2ab-69c4-8c84b02822b8
msgctxt "hddea0c59g1021g43fega8c8g9ca8a420399c"
msgid "I just want to move on with my life."
msgstr "난 단지 내 삶을 이어 나가고 싶을 뿐이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = da47cb9f-0580-1fc9-fdd4-14268c70c3ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:da47cb9f-0580-1fc9-fdd4-14268c70c3ef
msgctxt "h17633025g8abbg4fcfgaab9gcb87d8aaf2a7"
msgid ""
"But I am not here to convince you, only show you a path. Whether you follow "
"it or not is up to you."
msgstr "허나 나는 그대를 설득하기 위해 온 게 아니라, 다만 길을 보여 주기 위해 왔노라. 따를지 말지는 여전히 그대에게 달려 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = de22075c-e49e-fe93-d5c2-3a69c46b498d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:de22075c-e49e-fe93-d5c2-3a69c46b498d
msgctxt "hf011209ag67b7g4d1eg97e4gc77b61a75696"
msgid ""
"But you are a child no longer. You are a woman. One who knows what must be "
"done."
msgstr "허나 그대는 더 이상 아이가 아니다. 어엿한 숙녀이지. 해야 하는 것을 아는 그런 사람 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = dee50c66-1a48-6cbe-b17c-87411d170c93
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_HasSeenWolfDream = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:dee50c66-1a48-6cbe-b17c-87411d170c93
msgctxt "h4e803b7fgd268g4530g974fgab36bf6d76d7"
msgid "<i>Open your mind to that sensation.</i>"
msgstr "<i>섀도하트에게 정신을 열어 보인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = df80bc73-55c7-dc3b-4eb0-978c73b8c60e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:df80bc73-55c7-dc3b-4eb0-978c73b8c60e
msgctxt "h5768cc18g17dfg4890g8a4agad1ec25afc9e"
msgid "I have kept my word. My guidance in exchange for my freedom."
msgstr "나는 약속을 지켰노라. 자유와 맞바꾼 인도를 내렸나니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Narrator
#. NodeID = e9a5030e-b691-2804-f49e-32bcd2183368
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_SeluniteForestRitual = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:e9a5030e-b691-2804-f49e-32bcd2183368
msgctxt "heed41a94gc0d6g4cb9gaebagba7182b67382"
msgid ""
"*You remember sermons about Selûnite rites of passage, about how they would "
"abandon their children out in the wilds and force them to find their way "
"home...*"
msgstr ""
"*당신은 셀루네식 통과의례에 대한 설교를 기억합니다. 아이들을 야생에 던져 놓고는 스스로 집을 찾아 가도록 강요하는 의식 말입니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = e9adc5d0-1711-e63f-3e2d-37be6403f41f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_GiveOintment = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#. SetFlags:
#.   Object:
#.     - SCE_Shadowheart_Event_GiveSeluneSpear(1) = True
#.     - SCE_Shadowheart_Event_GiveNightSpear(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:e9adc5d0-1711-e63f-3e2d-37be6403f41f
msgctxt "hcfd523b8g55eeg4e69ga34cgd7b9aac57334"
msgid ""
"First Selûne's blessing, and now her gifts. If only the old me could see "
"this..."
msgstr "처음엔 셀루네의 축복이었고, 이젠 그녀의 선물까지. 과거의 내가 이것들을 알아보았더라면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = ea9cd459-b661-4a82-9534-1338f1d6dccb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:ea9cd459-b661-4a82-9534-1338f1d6dccb
msgctxt "ha97a9a79geee6g46b2ga3b4g742b466793ed"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = eaf40285-4a44-83e8-00f6-c4fba39ef34d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:eaf40285-4a44-83e8-00f6-c4fba39ef34d
msgctxt "h4277245ag3170g466dg9b69gd6fc5122eecf"
msgid ""
"You will have to face your abductors in their very lair, in Baldur's Gate."
msgstr "그대는 발더스 게이트에 숨겨진 유괴범들의 소굴에서 그들과 맞서야 할 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = ed423370-8440-2fc1-28bc-a6437a0f206a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:ed423370-8440-2fc1-28bc-a6437a0f206a
msgctxt "h5845df65gff1cg4ac1gbcd9g0fc7f0544fb3"
msgid "That is for Shadowheart to decide."
msgstr "결정은 섀도하트에게 달려 있노라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = ef3130e7-af99-92c3-be6d-9fc8e7021303
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:ef3130e7-af99-92c3-be6d-9fc8e7021303
msgctxt "h1a8c8ecbg5076g47c8g8181gdce17838dc15"
msgid "I... I don't know what to say. I don't know these people."
msgstr "난... 난 뭐라 말해야 할지 모르겠어요. 난 그 사람들을 알지 못해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = f10f7142-b8d2-85e9-3608-75bc8633a47a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCE_Shadowheart_Event_GiveSeluneSpear(1) = True
#.     - SCE_Shadowheart_Event_GiveNightSpear(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:f10f7142-b8d2-85e9-3608-75bc8633a47a
msgctxt "h54eb9236gf801g4642gae34g06be0c1205f2"
msgid "<i>Accept the Spear silently.</i>"
msgstr "<i>조용히 창을 건네 받는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = f1f7db13-2f1a-e74d-2277-65d2591971fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:f1f7db13-2f1a-e74d-2277-65d2591971fe
msgctxt "h13608e61g91feg4e58g8d8dg26ac421ff5af"
msgid "I'll need every advantage, it seems... Thank you."
msgstr "짐작건대 어떤 이점이든 필요해질 거예요... 고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = f26fee48-1b32-45e0-7263-a907c796cef8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:f26fee48-1b32-45e0-7263-a907c796cef8
msgctxt "hea61a344g3404g419agb73egf749bcf313bf"
msgid ""
"If you want to remember, you will have to face your abductors in their very "
"lair, in Baldur's Gate."
msgstr "기억을 되찾고 싶다면, 그대는 발더스 게이트에 숨겨진 유괴범들의 소굴에서 그들과 맞서야 할 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = f630eb08-4da5-8c31-202a-ff2aa03042bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:f630eb08-4da5-8c31-202a-ff2aa03042bc
msgctxt "h4547b484ga9c7g47fagb0f0g08ec74f0578d"
msgid ""
"The elf you saw was your father. He tried to stop you being seized by Shar's "
"agents, but failed."
msgstr "그대가 목격한 엘프는 그대의 부친이다. 그는 샤의 요원들이 그대를 납치하는 걸 막으려 했으나, 실패했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = fbaf00b3-483a-a616-a7c8-cbb7aaf36e2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:fbaf00b3-483a-a616-a7c8-cbb7aaf36e2a
msgctxt "h483b3fa6g2e47g4197g9ca0g48faa467c6ca"
msgid "<i>Observe silently.</i>"
msgstr "<i>조용히 관찰한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Shadowheart
#. NodeID = fc0806ee-2780-6f6d-6968-636030f1626b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:fc0806ee-2780-6f6d-6968-636030f1626b
msgctxt "hff97eec1g4dc1g4d01g9c4agd09380898fdb"
msgid "That wolf - that <i>elf</i>... Who was he?"
msgstr "그 늑대 - 그 <i>엘프</i>... 그는 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Player
#. NodeID = fc0bb636-73f5-6078-b9b6-793b6ee35a2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_WolfDreamIsSeluniteRitual = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:fc0bb636-73f5-6078-b9b6-793b6ee35a2f
msgctxt "h64afb0b9gfd0cg4561g9ce1g4348f49930bf"
msgid "That was a Selûnite ritual, wasn't it? So that means..."
msgstr "그건 셀루네식 의식이었어요, 안 그래요? 그렇다는 것은..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM
#. Speaker = Nightsong
#. NodeID = fe9e271e-baf3-7905-4bb5-095a69f961db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_NightsongShadowheartVisit_CFM:fe9e271e-baf3-7905-4bb5-095a69f961db
msgctxt "h23c3be6bgb544g42e8g8123g5feafa116251"
msgid ""
"But you are a child no longer. You are a woman. One who knows what must be "
"done."
msgstr "허나 그대는 더 이상 아이가 아니다. 어엿한 숙녀이지. 해야 하는 것을 아는 그런 사람 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 03f13a8d-0d9b-da02-7dbf-916ff138930b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - WYR_OrinsImpersonations_SacrificeCity(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:03f13a8d-0d9b-da02-7dbf-916ff138930b
msgctxt "hf64c77a4gc1b5g4d94g960eg2dabdf747565"
msgid "Great idea. Go right ahead."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 09264386-d612-8cee-a185-331dc5663d22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:09264386-d612-8cee-a185-331dc5663d22
msgctxt "he369416fgcae0g4d3aga100gce459af0c1cd"
msgid "There is nothing better than leaving in a blaze of glory."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 0fb5c1bb-19f6-a899-666c-a35a512ea5a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:0fb5c1bb-19f6-a899-666c-a35a512ea5a9
msgctxt "h971726ebgac4cg4102g9999g14f2cc64012e"
msgid ""
"An intellectual dilemma to round off the evening? Sounds just the thing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 1dd7a1d9-57d7-687e-4d62-0fbe25ccaa24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_SwayedTowardsCrown = False
#.      - ORI_Gale_State_ReactedElderBrain = True
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:1dd7a1d9-57d7-687e-4d62-0fbe25ccaa24
msgctxt "h7a628a2ag730eg4d80ga910g9af80d24187a"
msgid ""
"We haven't yet learned what the crown might be capable of. I thought you "
"wanted to find out?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 1e63a194-47e2-40f2-9897-a640338c2aca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - WYR_OrinsImpersonation_EncouragedViolenceCompanion(2) = True
#. TagRule: !REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:1e63a194-47e2-40f2-9897-a640338c2aca
msgctxt "h8bbe5042g502dg4c2cg89f3gcdb77241a348"
msgid "Destroy an entire city? Sounds wonderful - go ahead."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 1e63a194-47e2-40f2-9897-a640338c2aca
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - WYR_OrinsImpersonation_EncouragedViolenceCompanion(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:1e63a194-47e2-40f2-9897-a640338c2aca
msgctxt "h41cb5eccgfa83g40abg9b7fg731a186cdf51"
msgid ""
"A city snuffed out in one moment: it will be a beautiful offering for Bhaal."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 2562c0ca-7c7c-8326-853b-ade76499a1c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:2562c0ca-7c7c-8326-853b-ade76499a1c1
msgctxt "h146724bag4ad7g41fdg95a0g56e4674b0e75"
msgid "Careful. You don't know what I'm about to ask."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 33b57020-701f-2c21-54ff-b7c6f853911b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithGale(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:33b57020-701f-2c21-54ff-b7c6f853911b
msgctxt "h0d0885beg4c59g4506ga991g77d0393aaa38"
msgid "You know I'll always help you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 37071f25-b0fd-d61c-ebb4-ac2fa6510a05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:37071f25-b0fd-d61c-ebb4-ac2fa6510a05
msgctxt "h57a62f6eg940bg4453ga19egabc3e2b470e7"
msgid ""
"A passing fancy, one that has lost its lustre. No - unleashing the power "
"within me will be far more magnificent than some crown."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 3745f762-79d1-151a-b8db-6ee5d2459424
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:3745f762-79d1-151a-b8db-6ee5d2459424
msgctxt "h8e7a3950gbf78g4792g86e6g548dd8589de2"
msgid ""
"Most foolish. Wanton violence against your dear Gale? After all, the man has "
"a budding apocalypse tucked beside his heart - you would <i>provoke </i>it?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 37a30e95-3d18-61fb-93b1-b3595c750d2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:37a30e95-3d18-61fb-93b1-b3595c750d2a
msgctxt "hf8e1de21gea86g41fag9483g315f25683e39"
msgid ""
"The inevitable has been delayed far too long already - no more, I say. It's "
"time to make a stand."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 3a8c5bb1-5872-34ec-ab84-0ddcc95d1abc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:3a8c5bb1-5872-34ec-ab84-0ddcc95d1abc
msgctxt "hf4ce2368g4d09g4a52g84a4gbacce2eb9aba"
msgid ""
"That may be, but has it put a stop to the Absolute? Or cured us of our "
"tadpoles?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 427e6b00-e7b0-3350-1815-044d28800310
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:427e6b00-e7b0-3350-1815-044d28800310
msgctxt "he3fff1a3g7717g4d9dg8626g246ac75e6fa6"
msgid ""
"Just a bit of late-night humour for you. Your input would be most welcome."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 428bab73-34b6-9836-11b2-1ec3588cf89b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:428bab73-34b6-9836-11b2-1ec3588cf89b
msgctxt "h8416adc2gb3f9g4242gb157g815950bce240"
msgid ""
"It wouldn't only kill Absolutists - it would kill <i>everyone</i>. You can't "
"be serious."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 449f9f0e-8fbc-f83f-d390-21aaea9a96a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:449f9f0e-8fbc-f83f-d390-21aaea9a96a7
msgctxt "heac444e0g5250g4499ga81bg5e850e6f376e"
msgid ""
"As always, I'm grateful for your enthusiasm. And yes, it will require some "
"amount of brutality on our part."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 4a733e96-20ee-63ea-8f25-149c87965bd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:4a733e96-20ee-63ea-8f25-149c87965bd5
msgctxt "hd33fbf50g24d5g4e7cgaf73gcb25459f2c4e"
msgid ""
"So quick to turn on your friends... a sure sign of an unsound mind, and a "
"villainous heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 4ece399b-d20a-4626-ffab-7b5ce63b4073
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:4ece399b-d20a-4626-ffab-7b5ce63b4073
msgctxt "hd90e1c33g05d3g49ecgb633g4a7c56b4f715"
msgid "You think I've been holding back this whole time?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 50b8072a-68a8-d045-1af3-b7c0ef8eb84b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:50b8072a-68a8-d045-1af3-b7c0ef8eb84b
msgctxt "h1c5987e4g79e2g434cga992g53df90cd35f5"
msgid ""
"Act now, and we take out the brain and every footsoldier in the Absolute's "
"army. All their hatred, their bile, their violence - erased. It would "
"finally be over."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 52fcee65-bb23-0964-a2fd-a46fcdc514ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:52fcee65-bb23-0964-a2fd-a46fcdc514ef
msgctxt "ha5d3e7beg6ab8g41d6g8f0dgdb78a1d67a16"
msgid "Forgive me. I was lost in my thoughts, as usual."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 5b02f669-d27f-4053-ad8e-486bf27d4ba9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:5b02f669-d27f-4053-ad8e-486bf27d4ba9
msgctxt "hede4a71eg1840g46fagb8d7g071139b6345a"
msgid ""
"A puzzle for the mind, I'd solve quite comfortably. Unfortunately, this is a "
"struggle for the heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 62147208-eb89-89a2-e1de-192fe9510a0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:62147208-eb89-89a2-e1de-192fe9510a0a
msgctxt "he4fac416gbfdfg49d9gb99ag618af79fe93c"
msgid "Of course! I find them to be almost the same quality as my own."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 666009a1-7d25-b04b-c549-04cc1f77ea69
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_Event_TransformToOrin = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:666009a1-7d25-b04b-c549-04cc1f77ea69
msgctxt "h7119dc6cg95adg480fg8546g186afb64dbad"
msgid "<i>Caeci verum videant.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 6912911c-e6a2-5a15-b7b7-be4254406559
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:6912911c-e6a2-5a15-b7b7-be4254406559
msgctxt "he710e71cg2dcdg4b78gba62gb5e444c52071"
msgid "What do you mean by 'drastic'?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 6cf46d48-bb99-7e67-65c4-459901e912b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:6cf46d48-bb99-7e67-65c4-459901e912b4
msgctxt "h69dd2ecfge094g4a24gb98bge05cdc0ef666"
msgid ""
"We both know the orb I carry inside me is powerful enough to burn away the "
"Absolute's blight in an instant. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 6d297de0-0124-6c56-2403-b3d8b3d30fc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:6d297de0-0124-6c56-2403-b3d8b3d30fc5
msgctxt "h7e64ca19g1330g44adg8093ga1730e3faf7f"
msgid "There isn't."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 6e65ee73-8bdd-3876-a6d0-a483a2a5af42
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - WYR_OrinsImpersonation_EncouragedViolenceCompanion(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:6e65ee73-8bdd-3876-a6d0-a483a2a5af42
msgctxt "hd04b55e5gc998g48c1g8906g32f80d7d9580"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 73bcda80-8b57-4817-1043-81e37e5eaa15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:73bcda80-8b57-4817-1043-81e37e5eaa15
msgctxt "he00f105bg72c1g467eg82edg3d4bb4ec08e9"
msgid "You wouldn't <i>dare</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 77e9d89e-426c-1410-207d-bbf83661f2c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:77e9d89e-426c-1410-207d-bbf83661f2c5
msgctxt "hdbc58759g57c8g48b1gaec9gc752aba189a1"
msgid "Wouldn't I?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 78549949-241a-b093-5a12-acc16218b869
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:78549949-241a-b093-5a12-acc16218b869
msgctxt "hf19ffdc8g3038g4a57gaadfg1a8b24073211"
msgid ""
"I know how much power rests within me - enough to turn Baldur's Gate to "
"ashes, its memory to no more than a children's fable."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 84568003-3a02-77ba-6ea6-1a095d8bdee7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:84568003-3a02-77ba-6ea6-1a095d8bdee7
msgctxt "hfa8b40bdgc84cg4b7fga70egd120fe9b29c6"
msgid "Please, Gale. You're <i>better</i> than this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 853f1d45-9a57-3517-f009-a34fc99efd84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:853f1d45-9a57-3517-f009-a34fc99efd84
msgctxt "hc7acdb89g3a03g4b5bg9efdg829e8ceb5012"
msgid ""
"I regret straying from Mystra's instruction. All the suffering around us, it "
"is our fault. I am reconsidering taking a more drastic approach."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 85673b5b-043c-9f53-5dd0-2a7fb7f30468
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:85673b5b-043c-9f53-5dd0-2a7fb7f30468
msgctxt "h74212182g1865g4f61g9331g2cae256186dc"
msgid "I'm afraid to say I <i>have</i> been holding back. Every. Single. Day. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 87b4f801-8197-bf38-af97-d66e3f53857e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:87b4f801-8197-bf38-af97-d66e3f53857e
msgctxt "he918fe88g5689g41afga07dgf788e2457b36"
msgid ""
"Gods damned if I'm going to let it be for nothing. If Mystra gave me one "
"purpose, it was this: to destroy Baldur's Gate, and the Absolute with it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 896f8fb6-9d3f-0154-0c0a-44dab7ed3ad7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:896f8fb6-9d3f-0154-0c0a-44dab7ed3ad7
msgctxt "hda94c264gfb2eg4dacga0eagb5c192bb74e4"
msgid "There is another way Gale!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = 8c364740-d304-7e42-6a7e-5e2f668f39cd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:8c364740-d304-7e42-6a7e-5e2f668f39cd
msgctxt "h60852ffegd663g44b2g84f2g0d07608d8d88"
msgid "Try it, and you'll be dead before you utter your first syllable."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = 969dd73c-f5b2-e9ea-70ef-6e64ea6d774a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:969dd73c-f5b2-e9ea-70ef-6e64ea6d774a
msgctxt "h9390d316gf184g4bdfg8ad5g481345191dc9"
msgid ""
"I fear our unwillingness to make difficult decisions is doing more harm than "
"good."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = a2dd594c-46e4-73c5-554b-cd9f1cb68239
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:a2dd594c-46e4-73c5-554b-cd9f1cb68239
msgctxt "hf4d62c95g292dg4782ga8eaga5a74d243908"
msgid ""
"I've found myself in something of a quandry. Yours is an opinion I'd gladly "
"hear on the matter."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = b306d0a3-a03b-9c62-35fa-a9bd3ac3b82f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:b306d0a3-a03b-9c62-35fa-a9bd3ac3b82f
msgctxt "hd2777d6fg3eccg4f3eg84a0ge13f10925cf2"
msgid ""
"All we've done is delay the inevitable, a delay that puts thousands more "
"lives at risk. But those lives can be saved."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = bc3b9127-d6fe-3ec1-1271-acb4a4afaf56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:bc3b9127-d6fe-3ec1-1271-acb4a4afaf56
msgctxt "hebb22d6ag6003g4012ga150g179e63ec1efa"
msgid ""
"So <i>gentle. </i>You think saving him will stop the bloodshed? It "
"<i>won't</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = c3f5b50c-4b53-d1a2-5a8d-1d756e83aac0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:c3f5b50c-4b53-d1a2-5a8d-1d756e83aac0
msgctxt "h8767354egc4f1g436egb5a4g1f822ab767f9"
msgid "Why change course now?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = c77c011b-044f-e20a-564d-9cd93de5e78b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:c77c011b-044f-e20a-564d-9cd93de5e78b
msgctxt "h27f50fb7g60c2g4a93g8d1fg6b730ab17993"
msgid "With <i>pleasure</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = c78bd93d-4cae-22b6-c145-ffc23b569669
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_SwayedTowardsCrown = True
#.      - ORI_Gale_State_ReactedElderBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:c78bd93d-4cae-22b6-c145-ffc23b569669
msgctxt "h02d6b289gf95ag4c31ga6f3g06117405e855"
msgid ""
"But I thought you had your heart set on the Crown of Karsus? A difficult "
"thing to aspire to, if you're dead."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = ca7203c7-7df9-a54c-1721-cdaa0acb794f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:ca7203c7-7df9-a54c-1721-cdaa0acb794f
msgctxt "h8b964e88g6c7fg4301g986eg95259ef3adb7"
msgid ""
"But what stays my hand? Obstinacy? Misplaced morals? Simple fear of dying? "
"You?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = cddd1577-0327-9ed6-d75b-ea1c4cce57f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:cddd1577-0327-9ed6-d75b-ea1c4cce57f5
msgctxt "h53d4cb17g8f8fg4df4g8745gb4cd93dce8fa"
msgid "Of course. What's on your mind?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = ce4ec2d1-fe90-2673-10df-45c508dd2630
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:ce4ec2d1-fe90-2673-10df-45c508dd2630
msgctxt "h02bb6182g7dd3g4779g99dcg0338b98467a9"
msgid "If 'drastic' means violent, then count me in."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = cedf83e0-8959-5f32-6b83-800b7152e5f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:cedf83e0-8959-5f32-6b83-800b7152e5f8
msgctxt "he20ca680ga99dg4f4aga807gf3f0a617427b"
msgid ""
"The day will come when I lose control of the power within me anyway. There's "
"nothing you or I can do to stop that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = d33609d1-c869-c7ed-f453-f526e86b8f96
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - WYR_OrinsImpersonation_EncouragedViolenceCompanion(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:d33609d1-c869-c7ed-f453-f526e86b8f96
msgctxt "hb225a951gafe5g4465gb5e8g55acb99bbfb9"
msgid "So be it. End this, once and for all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = d7024ea9-c9f7-baaa-8ffa-6ce9f5d72fa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:d7024ea9-c9f7-baaa-8ffa-6ce9f5d72fa8
msgctxt "hb130c1c6g1237g43dcg95c2g1302a924d251"
msgid "What makes you think it will work?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = d997bc46-3e3e-c1a6-af0a-282517a32179
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:d997bc46-3e3e-c1a6-af0a-282517a32179
msgctxt "hbc009f7dg47f1g4482gbf2cg0116b800b71f"
msgid "Kill me, and I'll destroy the city anyway."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = daf166fc-41d2-4950-ee7c-0674662c0532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:daf166fc-41d2-4950-ee7c-0674662c0532
msgctxt "hb9c80da3g8fc3g4b49g86e1g250645f22605"
msgid "Sounds a bit heavy for so late an hour. Another time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = e049ff25-323d-bb5f-b976-9302b2b4abcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:e049ff25-323d-bb5f-b976-9302b2b4abcf
msgctxt "he64206c0gbdbeg4fbdga11egece44ae78d5a"
msgid ""
"Wait. What I have to say... well, there may not be another chance. Please."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = e08e90e4-c69a-01f2-a0e2-983ed05fc9d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:e08e90e4-c69a-01f2-a0e2-983ed05fc9d4
msgctxt "h1d6425f8g718cg4cc7gb217g80c303b3692b"
msgid "I didn't know you thought so highly of my opinions."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = ecceb460-65ab-e133-2ca7-c03ae18335cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:ecceb460-65ab-e133-2ca7-c03ae18335cf
msgctxt "h67530315gf065g40bbg8f5dga449d158c8b2"
msgid ""
"Deadly serious. This is the burden we must carry - to condemn the few to "
"save the many, or Baldur's Gate will only be the <i>first</i> city to fall."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = f303d214-3de0-c68a-f287-9b68a20b60d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:f303d214-3de0-c68a-f287-9b68a20b60d1
msgctxt "h9585dde5g6bb1g4451gbe51g461d4812310d"
msgid "I disagree. Using restraint has kept us alive so far."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = fbb0cf9d-810a-b90c-61a8-17009b18a04e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:fbb0cf9d-810a-b90c-61a8-17009b18a04e
msgctxt "h422f585dg317ag48e1ga4d4gbd89c5770168"
msgid "My apologies. I shouldn't place my own guilt onto your shoulders."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Gale
#. NodeID = fca3efc9-d059-19a2-b6c9-45778180349c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:fca3efc9-d059-19a2-b6c9-45778180349c
msgctxt "h7e04a065gbcb5g402bg96cdg439a03c2c50b"
msgid ""
"Every day we spend inching our way towards our enemies is a day we <i>choose "
"</i>to let countless die in the Absolute's path."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale
#. Speaker = Player
#. NodeID = fdf51c2e-27ab-e31f-e2a7-4774e24acdd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_SwayedTowardsCrown = False
#.      - ORI_Gale_State_ReactedElderBrain = True
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Gale:fdf51c2e-27ab-e31f-e2a7-4774e24acdd3
msgctxt "h771db46cg8a42g4a3fg9b7egdc2b16b0c5f6"
msgid ""
"There's no need for anything so drastic. You thought the Crown of Karsus was "
"worth pursuing..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 07f79eb1-ddee-c0e3-f780-d6f6be538052
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:07f79eb1-ddee-c0e3-f780-d6f6be538052
msgctxt "hf9dd2152gdbf4g4fddgb13ag00d04d7861f4"
msgid ""
"Slow. You'll need to be much, <i>much</i> faster if you want to save the big "
"ox."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 0b24ebe1-487b-5aa5-9b41-2339b1eabb5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:0b24ebe1-487b-5aa5-9b41-2339b1eabb5d
msgctxt "h931a779fg51c5g42cbga354g217f9613824c"
msgid ""
"I can see your mind at work, my friend. But it's too late. Time to let go..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = 1144a2a7-49c9-cdac-ae91-4c710e25d1a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:1144a2a7-49c9-cdac-ae91-4c710e25d1a7
msgctxt "h81849a99g0b27g405aga2f0g794fbaa9f242"
msgid "<i>Raise your palms in a peaceful gesture. Try to calm him.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 16653f97-00f4-0e0f-18b0-0eee011593de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:16653f97-00f4-0e0f-18b0-0eee011593de
msgctxt "hceae34b7gd54bg4161gad1bg00a6422060cb"
msgid ""
"Do you think a poultice will unspill your friend's guts? A herbal tea will "
"ungouge his eyes? Try if you like - the time to save him is dwindling fast..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 1729fa2e-f198-6308-25a0-628a45f51ca7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:1729fa2e-f198-6308-25a0-628a45f51ca7
msgctxt "h9ee0a1fbgc06ag4d17ga264g7a1ded116022"
msgid ""
"After all you've been through together, you just idly stand by as he pours "
"his heart out for you? Tut tut."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = 1d30ec6f-75c6-2cda-0722-34c901acb37d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_State_HalsinAbduction_IsScratch = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:1d30ec6f-75c6-2cda-0722-34c901acb37d
msgctxt "h2ade005cg4e31g42b2g8813ge34d392c0e8f"
msgid "Get away from Scratch - <i>now</i>."
msgstr "스크래치한테서 떨어져. <i>당장</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Player
#. NodeID = 311cc101-59b9-1239-39df-321d235c5d9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:311cc101-59b9-1239-39df-321d235c5d9f
msgctxt "h20035100gb7d4g43dagae67ge0e412e8c323"
msgid ""
"No. You're responsible for your own actions. And you'll have to pay for them "
"as well."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 3b154ebe-fbf4-abf2-df33-747fbcc32bbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:3b154ebe-fbf4-abf2-df33-747fbcc32bbd
msgctxt "hb8e7660agb12eg4d85g95d1gdc57ecbf18f6"
msgid ""
"It's this place. This <i>city</i>. I can feel its corruption eating away at "
"me. I should not be here - <i>no one </i>should be here."
msgstr ""
"이 장소 때문이야. 이 <i>도시</i> 때문이라고. 타락이 날 좀먹는 게 느껴져. 난 여기 있어서는 안 돼... <i>그 누구도</i> "
"여기 있어선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 40751bad-07b9-1de2-80a2-85ee45258473
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:40751bad-07b9-1de2-80a2-85ee45258473
msgctxt "hfa4b9a6bg8b73g40a1g8ca1gcd9ef5fe04e6"
msgid "Uuargh."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin
#. Speaker = Halsin
#. NodeID = 42d6bad2-a20f-8954-b5ed-cc1d9997b5d0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Halsin:42d6bad2-a20f-8954-b5ed-cc1d9997b5d0
msgctxt "hf87ee0cdgb27eg4893ga133gd55a304f3a7a"
msgid "Did you enjoy the show? It was but an opening act, blood brother."
msgstr ""

