msgctxt "h250dd163g26b3g40e6g9b1bge7fc57f308c2"
msgid "He'll settle in. Give it a little time."
msgstr "적응할 거야. 시간을 조금 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
