msgctxt "h71bbd894gf1a6g493fg93a0g1c926c90df58"
msgid "*Scratch's tongue lolls out happily, his tail wagging even faster.*"
msgstr "*스크래치가 혓바닥을 기쁜 듯 내밀고, 꼬리를 세차게 흔듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = d2653dfa-de28-b783-4747-a8c9a02935c4
#. HandlePath = TaggedText[0].TagText[0]
