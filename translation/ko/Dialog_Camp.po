msgid "<i>Observe the pair for any signs of injury.</i>"
msgstr "<i>둘에게서 부상의 흔적이 느껴지는지 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
