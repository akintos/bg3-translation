#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Cazador Szarr
#. NodeID = 7dafa5a9-ed07-1104-5558-e0b98767ab8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:7dafa5a9-ed07-1104-5558-e0b98767ab8c
msgctxt "h79b4be45ga0b8g4072g9460gca7629a52bee"
msgid "Do not forget that you are mine. <i>Forever.</i>"
msgstr "네놈이 주인이 누구인지도 잊지 말고. <i>영원히.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Narrator
#. NodeID = 7f65e416-390d-3e47-6dc7-b9ff20a6462d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 927f5d77-9be4-3c73-672d-f34b04c16365_Sneaking = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:7f65e416-390d-3e47-6dc7-b9ff20a6462d
msgctxt "hc20d746bg1b8cg480bga892g6c45a611202b"
msgid "*You keep low to the ground, scuttling like a rat.*"
msgstr "*당신은 땅바닥에 바짝 붙어 쥐새끼처럼 허둥댑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Astarion
#. NodeID = 91fa78dc-f550-f1ac-e3a0-ec4b67d8b6b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 927f5d77-9be4-3c73-672d-f34b04c16365_Froze = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:91fa78dc-f550-f1ac-e3a0-ec4b67d8b6b0
msgctxt "h9aae73e5gd50eg463dgad2fgfbbc5beff97e"
msgid "Absolutely. It's just that I was kidnapped by a tentacle-faced -"
msgstr "지당하십니다. 제가 그만 촉수 달린 놈들에게 납치당하는 바람에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Cazador Szarr
#. NodeID = 93f0aff4-71e5-38bf-beaa-28752048dc6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:93f0aff4-71e5-38bf-beaa-28752048dc6d
msgctxt "h22000349gd266g4092g9ce7ge5d102847b6e"
msgid "Second, thou shalt obey me in all things."
msgstr "둘째, 그대는 무조건적으로 명령에 복종할지어다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Player
#. NodeID = 9f04a047-dba2-618b-741b-757bc5e2fab9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:9f04a047-dba2-618b-741b-757bc5e2fab9
msgctxt "h64f2f7cagf57fg4643gb0f6g570ed9d97500"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Cazador Szarr
#. NodeID = a072458a-f14c-38b2-8b5f-3f13c90c2d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:a072458a-f14c-38b2-8b5f-3f13c90c2d82
msgctxt "h807add13gea83g4f97gb60eg416c193a38a8"
msgid "Third, thou shalt not leave my side unless directed."
msgstr "셋째, 내가 분부하지 않는 한 내 곁을 떠나지 말라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Narrator
#. NodeID = a30220ec-f52a-53ec-55e6-cefd7775d33d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 927f5d77-9be4-3c73-672d-f34b04c16365_ReadyToFight = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:a30220ec-f52a-53ec-55e6-cefd7775d33d
msgctxt "hf439e53ag6e53g4b0aga5cbgcb16abb2a27e"
msgid ""
"*Your heart pounds, but you're ready. He's going to regret coming for you.*"
msgstr "*심장이 터질 것 같지만, 당신은 준비되어 있습니다. 그는 이 방문을 후회하게 될 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Cazador Szarr
#. NodeID = b758c605-a2d6-6ef0-7d3c-5d887210bb98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:b758c605-a2d6-6ef0-7d3c-5d887210bb98
msgctxt "hd29537c7g2902g41e4g94cfgf0c52cefe536"
msgid "Fourth, thou shalt know that thou art <i>mine</i>."
msgstr "넷 째, 그대는 <i>나의 것</i>이라는 걸 알 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Cazador Szarr
#. NodeID = cbee9d2c-0c3c-5681-9ab1-e8c3e8c51e5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:cbee9d2c-0c3c-5681-9ab1-e8c3e8c51e5a
msgctxt "h928201c1gc782g40a0gb0c4gca15e39b66d3"
msgid ""
"Do not forget who made you. Do not forget who carved those scars into your "
"back."
msgstr "네놈을 만든 게 누구인지 잊지 마라. 네놈 등짝에 흉터를 새긴 게 누구였는지 잊지 말란 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Astarion
#. NodeID = d62cb9a8-b03b-656a-3f39-f92d413a8dde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 927f5d77-9be4-3c73-672d-f34b04c16365_Sneaking = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:d62cb9a8-b03b-656a-3f39-f92d413a8dde
msgctxt "h77ceafcbg8e4eg410fgb577gcda2ab4505d0"
msgid "No. Please. Not again!"
msgstr "아니. 제발. 더는 안 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Astarion
#. NodeID = d999a244-4986-d6fd-a536-8ea3b45b0411
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:d999a244-4986-d6fd-a536-8ea3b45b0411
msgctxt "h666c95c8g666cg470egbc35g939f95c2b7d5"
msgid "Hello? Anyone there?"
msgstr "여보세요? 거기 누구 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream
#. Speaker = Player
#. NodeID = e08af795-2f0b-bf74-b420-3b8d6c6708a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 927f5d77-9be4-3c73-672d-f34b04c16365_Sneaking = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Avatar_Dream:e08af795-2f0b-bf74-b420-3b8d6c6708a0
msgctxt "ha0508d30gf7a4g4a9ag9a48g98ef8ea45ae0"
msgid "<i>Try to sneak away.</i>"
msgstr "<i>몰래 빠져나간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 01d93c83-3c13-52ea-5206-119a0e1763a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:01d93c83-3c13-52ea-5206-119a0e1763a1
msgctxt "h29a92ecbg635fg431cgb3c3gef8c88df39c4"
msgid ""
"Now, if you'll excuse me, you're invigorating, but I need something more "
"filling."
msgstr "이만 실례, 네 피가 기운을 북돋아주긴 하지만, 나에겐 좀 더 든든한 게 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 03afb238-9100-9c66-021c-3db6893fd1e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerC_Kill = True
#.   Object:
#.     - GLO_Companion_Murder(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:03afb238-9100-9c66-021c-3db6893fd1e3
msgctxt "h44f0c654g2f0fg4c3fga287g39b6d244b302"
msgid ""
"*He doesn't finish the thought. It slides away as the light fades from his "
"eyes.*"
msgstr "*그는 생각을 마치지 못합니다. 그는 눈에서 빛이 사라지면서 풀썩 쓰러집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 03d794ef-095c-770b-daf3-b4a473d2ee2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:03d794ef-095c-770b-daf3-b4a473d2ee2e
msgctxt "h983efb0bg8aa3g424bg9f64g855411e03cb2"
msgid "You ate animals because you were forced to. Not because you wanted to."
msgstr "넌 어쩔 수 없어서 동물을 먹었군. 원해서가 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 04f6fc1f-2673-595f-af23-56e0bf902226
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:04f6fc1f-2673-595f-af23-56e0bf902226
msgctxt "h7722c450g61cag44ccga152g435c11444c78"
msgid "Well, you're full of surprises."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 05beb12f-3460-0177-69f4-559212354647
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:05beb12f-3460-0177-69f4-559212354647
msgctxt "h432bc0b9g122eg46e5gaed0gb4cb75b3bde2"
msgid ""
"*You open your mouth and bite down. Not into a tender neck, but into the "
"twisting body of a rat - the only thing your master lets you eat.*"
msgstr "*당신은 입을 벌리고 한 입 뭅니다. 부드러운 목이 아니라, 주인이 유일하게 먹도록 허락한 쥐 한 마리의 뒤틀린 몸통입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 068276ee-1712-5038-e8c4-2ef0070f51d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:068276ee-1712-5038-e8c4-2ef0070f51d9
msgctxt "h6e183817g825bg4b43g833cgb564a6343f40"
msgid ""
"*There, in dim firelight, you see him for what he really is: a vampire. A "
"slave to sanguine hunger.*"
msgstr "*저 희미한 불빛 아래서 당신은 그의 실체를 목도합니다: 피를 향한 갈망의 노예, 뱀파이어 입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 079253ba-00c3-4769-8c48-f801f8214257
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:079253ba-00c3-4769-8c48-f801f8214257
msgctxt "hfa80ddb5g6042g40d8g9894g8d565007cc34"
msgid "I - what's this? What's happening?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 07a1a365-6d90-e16b-084a-1466a4d91740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:07a1a365-6d90-e16b-084a-1466a4d91740
msgctxt "h6ad733cag7828g448bga1e6gfa02243526c7"
msgid "*You drive the stake into his chest, but it glances off a rib.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 07ece3bd-27a0-0d38-7f01-df6ba42e83a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = False
#.      - HAG_GurHunter_State_NoticedAstarionsHostility = True
#.      - GLO_GurHunter_State_PermaDefeated = False
#.   Object:
#.      - HAG_GurHunter_COM_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:07ece3bd-27a0-0d38-7f01-df6ba42e83a2
msgctxt "ha336b6a5gf37bg4a4dg8c22ge246a0fb0b33"
msgid ""
"You <i>were</i> strangely concerned when we met the monster hunter in the "
"swamp."
msgstr "우리가 늪지대에서 괴물 사냥꾼을 만났을 때 <i>이상할 정도로</i> 불안해 하더니만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 08b810c5-7398-0a33-78fd-fc654acde4cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:08b810c5-7398-0a33-78fd-fc654acde4cd
msgctxt "h3b34bfaeg2ef6g426fgbbcegee47a1654b6d"
msgid ""
"*His mind opens up, revealing cracked and quivering memories. At their "
"heart, you see dark eyes, commanding you to feed.*"
msgstr "*그의 정신이 열리면서, 갈라지고 떨리는 기억이 드러납니다. 그 한가운데에는, 먹으라고 명령하는 어두운 눈동자가 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 09cb2ff1-5b96-ac3f-4211-ddb7dc905e49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:09cb2ff1-5b96-ac3f-4211-ddb7dc905e49
msgctxt "ha6e2583fgc012g4829gbeb4g9364e9f23c6d"
msgid "Argh! You - "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 0b90b3d7-09be-f97c-1e9b-334c9e7972b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:0b90b3d7-09be-f97c-1e9b-334c9e7972b1
msgctxt "h44186511gb622g48e2g8284gbd79433b4a2b"
msgid "Ah. Of course. I shall be gentle as a babe."
msgstr "아. 아무렴. 연인처럼 부드럽게 해줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 0c48aee7-e0b4-edad-7855-30e1284aa2d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:0c48aee7-e0b4-edad-7855-30e1284aa2d9
msgctxt "h8c6f472cgadb0g4edfg9505g023466e0986b"
msgid "Why didn't you tell me?"
msgstr "왜 말해 주지 않았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 11a1b1c4-1a03-96da-cf64-3c2ca121c5a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:11a1b1c4-1a03-96da-cf64-3c2ca121c5a0
msgctxt "h6dda4de3gec01g496eg9e92g40945b55dca9"
msgid "It's not the time to drink each other's blood either."
msgstr "서로의 피를 마실 때도 아니고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 14b12ffc-8d70-df66-ed56-3ea069e602c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:14b12ffc-8d70-df66-ed56-3ea069e602c7
msgctxt "ha9d509fbg9f50g49dag8c69g6870a7a79e2e"
msgid "It's not what you think - I'm not some monster!"
msgstr "네가 생각하는 그런 게 아니야 - 나는 괴물이 아니라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 15a7e894-ed31-64d7-e817-6b9cfc7eeac1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:15a7e894-ed31-64d7-e817-6b9cfc7eeac1
msgctxt "h79dadeafg0846g4a50g8807g914ab253cf13"
msgid "It won't happen again, you have my word."
msgstr "안 그럴 거야, 믿어도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 1b516140-7edf-8970-87c6-32f76934f416
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeUnarmedAttack
#. RollAbility:
#. DifficultyClass: 0
#. SetFlags:
#.   Dialog:
#.     - CAMP_AstarionHunger_SCO_Companion_AvatarFought(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:1b516140-7edf-8970-87c6-32f76934f416
msgctxt "h7f4b24e8gf597g40cag88afg72b59ecfd03c"
msgid "<i>Knee him between the legs.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 1c9be966-1983-61d5-cff8-ccf583811bf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_SharedBomb = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:1c9be966-1983-61d5-cff8-ccf583811bf6
msgctxt "h882a94deg9032g40dbgae97gfe3df4ab2c1b"
msgid ""
"My body's the vessel for an orb of corrupt Netherese magic, remember? Not "
"for the faint of heart."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 1f0828d4-791b-bd45-2fea-500148440681
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:1f0828d4-791b-bd45-2fea-500148440681
msgctxt "h8e92ab3fgbc62g40fegbba4g2f792e8cc1b6"
msgid "How long since you killed someone? Days? Hours?"
msgstr "누군가를 죽인 지 얼마나 지났지? 며칠? 몇 시간?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 1f0d7cb3-b2f4-e86b-7276-84ea58eee818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:1f0d7cb3-b2f4-e86b-7276-84ea58eee818
msgctxt "hcc1aa697g5552g4b70gae5cgecdd1cc1d236"
msgid "No no - it's not what it looks like, I swear!"
msgstr "잠깐만, 네가 생각하는 그런 게 아냐, 진짜야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 2174baff-a0fb-9c25-9e72-2119031d4892
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:2174baff-a0fb-9c25-9e72-2119031d4892
msgctxt "h772a4bafg33e3g489egb6ecgf1cf1d6edc92"
msgid "Ah! That - that was amazing."
msgstr "아! 방금... 정말 최고였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 219c938f-19a6-8afe-a52f-04845356d6f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:219c938f-19a6-8afe-a52f-04845356d6f1
msgctxt "h58de89d2ge10cg40dbg8f13ge46eaeace8ac"
msgid "You need to leave my camp. Now."
msgstr "내 야영지에서 떠나줘야겠어. 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 21bd770e-26eb-9bef-5147-509d373ea13d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:21bd770e-26eb-9bef-5147-509d373ea13d
msgctxt "h83f2ac50g33f5g4957gb4a4g7b81dd52b274"
msgid "But it worked. I feel good. Strong. Happy!"
msgstr "하지만 효과가 있었어. 기분이 좋군. 강해진 느낌이야. 만족스러워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 22633569-c978-1b05-5e7c-35acf27d3976
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeWeaponAttack
#. RollAbility:
#. DifficultyClass: 0
#. CheckFlags:
#.   Dialog:
#.      - CAMP_AstarionHunger_SC_Companion_HasStake(1) = True
#. SetFlags:
#.   Quest:
#.     - ORI_COM_Astarion.LearnedVampire_Attacked(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:22633569-c978-1b05-5e7c-35acf27d3976
msgctxt "hdd39910bgd7e4g4af7gbfedgc39d4fb45cde"
msgid "<i>Grab the stake and attack, trying to drive it into his heart.</i>"
msgstr "<i>말뚝을 움켜쥐고 그의 심장을 향해 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 23eed1d8-b149-482c-be7f-8d37d6b7d588
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:23eed1d8-b149-482c-be7f-8d37d6b7d588
msgctxt "hd888b173g7cb1g4de6gb2ffgd3f521418352"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 2498d122-efae-e781-eee0-2931245228d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:2498d122-efae-e781-eee0-2931245228d7
msgctxt "hc9e5c044g63a6g40b9gab5fg2cdadbc31a79"
msgid "Let's make ourselves comfortable, shall we?"
msgstr "편한 자세로 하자, 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 261ca619-f575-2769-8cec-e9f81e986d02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#. TagRule: REALLY_ELF
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:261ca619-f575-2769-8cec-e9f81e986d02
msgctxt "h057c9a46g4086g4f8fg8aeeg58ce59a81107"
msgid "*You don't rest well, flitting between dreams and nightmares.*"
msgstr "*당신은 꿈과 악몽 사이를 오가며 잘 쉬지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 261ca619-f575-2769-8cec-e9f81e986d02
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:261ca619-f575-2769-8cec-e9f81e986d02
msgctxt "he1db09ecg8af9g4205g8c8ag8daafd059eab"
msgid "*You don't sleep well, flitting between dreams and nightmares.*"
msgstr "*당신은 꿈과 악몽 사이를 오가며 잠을 잘 이루지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 2888142d-07dc-4d9d-a12a-d4d689a6efa2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:2888142d-07dc-4d9d-a12a-d4d689a6efa2
msgctxt "h71d315dfg57d8g4c68gaef5g57019e11cff3"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 29ceab20-bd7b-4a63-957b-73beb0219662
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:29ceab20-bd7b-4a63-957b-73beb0219662
msgctxt "h6e182d31g7b0dg4052ga226g74b74c203acd"
msgid "<i>Push into his mind, searching for the truth.</i>"
msgstr "<i>진실을 찾아 그의 내면에 침투한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 2a31edbf-e524-8355-0dac-427291970fd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:2a31edbf-e524-8355-0dac-427291970fd6
msgctxt "h142c2812g1765g4868g882fg79c33b6ffb34"
msgid "*He holds you carefully, delicately. Until he strikes.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 2a42066f-d891-dfdb-1052-97b4a8b26da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:2a42066f-d891-dfdb-1052-97b4a8b26da0
msgctxt "hb4237b75g95bcg4946gbd66ga78a9ebdeb59"
msgid "I only need a taste, I swear."
msgstr "맛만 보려는 거야, 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 30892e94-f2fc-11ef-e43a-2bd4b2f5c266
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_AstarionHunger_SC_Companion_HasStick(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:30892e94-f2fc-11ef-e43a-2bd4b2f5c266
msgctxt "h7161b0afgc88ag4cc8ga2c7g3101dc26acbc"
msgid "<i>Grab whatever weapon is close at hand.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 32696742-4530-8481-d939-e6d9972ec72f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:32696742-4530-8481-d939-e6d9972ec72f
msgctxt "hafc20c67g99bfg443dgbeb5g1b9f54cacb00"
msgid "I wouldn't if you'd been honest with me. Why didn't you tell me?"
msgstr "네가 나에게 솔직했다면 그러지 않았을 거야. 왜 털어놓지 않았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 35cbf849-db13-9bc0-3641-94ceb31386ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = False
#.      - ORI_AstarionHunger_State_BoarDiscovered = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:35cbf849-db13-9bc0-3641-94ceb31386ca
msgctxt "h63a7dd0eg612ag4fecga607g63021ca5911f"
msgid ""
"I can't believe I didn't see it - we even found the boar you snacked on."
msgstr "내가 이걸 알아차리지 못했다니 믿을 수 없네 - 네가 간식으로 먹은 멧돼지까지 발견했는데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 382406b7-6f52-9b67-a863-e0ca0ae7114d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:382406b7-6f52-9b67-a863-e0ca0ae7114d
msgctxt "h098b5dd6g06ddg4b31g8d97gdb724b80dcdb"
msgid "I'm just too slow right now. Too weak."
msgstr "지금의 나는 너무 느려. 너무 나약하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 3acfdcef-8c0f-6864-41c3-fff32094a152
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:3acfdcef-8c0f-6864-41c3-fff32094a152
msgctxt "h0e494830g9cc5g4adbgb305g9141a1309e42"
msgid "If you ever try that again, I'll cut you in half."
msgstr "한 번만 더 그런 짓을 한다면, 널 반으로 쪼개 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 3b03a80d-bee0-4fed-8ca4-b6267e3ed85d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.      - GLO_Tadpoled_UsedToday2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday2(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:3b03a80d-bee0-4fed-8ca4-b6267e3ed85d
msgctxt "h3d5de2f1g2d96g4d01gbec5gdf4dab4100f7"
msgid "<i>Push into his mind, searching for the truth.</i>"
msgstr "<i>진실을 찾아 그의 내면에 침투한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 3c31196c-f2b9-8358-2fd6-47ff776eecec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:3c31196c-f2b9-8358-2fd6-47ff776eecec
msgctxt "h63bd857ag0e8cg4051g9a0eg145f2f90638d"
msgid "No. No, of course, silly of me to even ask."
msgstr "아니. 아니, 물론이지, 이런 걸 묻다니 내가 바보였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 3dedeb62-e591-b978-4486-26b682bafd37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:3dedeb62-e591-b978-4486-26b682bafd37
msgctxt "hf401cdbbge7d0g4d8dg965eg5ea682ebeb56"
msgid "Clearly."
msgstr "그래보이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 3e041c37-051d-5573-40fa-b7599c1362c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:3e041c37-051d-5573-40fa-b7599c1362c0
msgctxt "h199389e5gd172g4dfag93c7g5c927cd6de6e"
msgid "I feed on animals! Boars, deer, kobolds - whatever I can get."
msgstr "나는 동물들을 먹고 살아! 멧돼지, 사슴, 코볼트 - 잡히는 뭐든 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 3f5d6bad-c3ad-54d0-1114-ad428b83163e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:3f5d6bad-c3ad-54d0-1114-ad428b83163e
msgctxt "h0457eadbg4964g492cga218gb3f48ce6bf91"
msgid ""
"*There, in dim firelight, you see him for what he really is: a vampire. A "
"slave to sanguine hunger.*"
msgstr "*저 희미한 불빛 아래서 당신은 그의 실체를 목도합니다: 피를 향한 갈망의 노예, 뱀파이어 입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 3f7aa938-1f3f-1e10-22d4-aa359f1010fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:3f7aa938-1f3f-1e10-22d4-aa359f1010fd
msgctxt "h52d53f8cg53adg4032g83e6gff5a93d0e0c1"
msgid "<i>Let him go. </i>"
msgstr "<i>그를 보내준다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 40e88b09-d934-75d9-1363-ab4edfa442c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:40e88b09-d934-75d9-1363-ab4edfa442c9
msgctxt "h97aa3766ga8bdg4168g96eegeb4c1fcb80de"
msgid "No. Thank you."
msgstr "아니. 사양할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 445a4b97-95af-6ec2-2e72-3c851b5be9d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:445a4b97-95af-6ec2-2e72-3c851b5be9d5
msgctxt "heb5b6a76g445ag4188gb61fgae53c3ac9da5"
msgid "Safe to say this will never happen again."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 44ce148e-74d4-0933-ec9a-7c92b49401db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:44ce148e-74d4-0933-ec9a-7c92b49401db
msgctxt "h25f99c76gb64ag4101g9985g098dda6d005e"
msgid "Have another taste, see what happens."
msgstr "한입 더 해봐, 어떻게 되나 보게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 452c8127-be7c-95bc-2ee8-33313266c79f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_Companion(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_Companion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:452c8127-be7c-95bc-2ee8-33313266c79f
msgctxt "h9fee891ag4a52g4947g8e2dg30b32ba72a77"
msgid ""
"*A strange sensation courses through you, and your companion's mind unfolds, "
"secrets half-revealed.*"
msgstr "*기묘한 감각이 당신을 관통하고, 동료의 정신이 펼쳐지며 그가 지닌 비밀이 반쯤 드러납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 4794a404-fce9-155b-f186-da8334fa69a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:4794a404-fce9-155b-f186-da8334fa69a1
msgctxt "heccdb8d7g88b3g467cga241g1a0d960105eb"
msgid "My mind is finally clear. I feel strong. I feel... happy!"
msgstr "정신이 마침내 맑아졌어. 힘이 느껴져. 기분이... 행복해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 4e90aff3-b599-64a2-a085-293761f1154b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:4e90aff3-b599-64a2-a085-293761f1154b
msgctxt "h5b24b114g7228g4dc3g804ag60d6567d6229"
msgid "You tried to <i>bite me</i>. How can I trust you?"
msgstr "넌 날 <i>물려고</i> 했어. 널 어떻게 믿을 수 있겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 4e990c67-c5c9-4fda-beed-23abbd371a54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:4e990c67-c5c9-4fda-beed-23abbd371a54
msgctxt "h49bdd80cg8f29g4ee8g8749g5c2d2253de56"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 4efb8569-620e-331e-0a47-46c9b648d269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:4efb8569-620e-331e-0a47-46c9b648d269
#, fuzzy
msgctxt "hc6a1156fg7407g4f16g8f9bgf52df1551c34"
msgid "...Shit."
msgstr "... 젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 557124ef-8dd3-2f78-31b6-f50a938bf43b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_AstarionCompanion_DrankGaleBlood = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:557124ef-8dd3-2f78-31b6-f50a938bf43b
msgctxt "hf3cf5875g9d48g4592g8c81g309eee17766a"
msgid "Urgh! You taste like bile. What in the hells is wrong with you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 56b173cc-0665-3c75-b9f3-d02a41534822
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeWeaponAttack
#. RollAbility:
#. DifficultyClass: 0
#. SetFlags:
#.   Quest:
#.     - ORI_COM_Astarion.LearnedVampire_Attacked(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:56b173cc-0665-3c75-b9f3-d02a41534822
msgctxt "h579d994bga02dg411egb515g5255c7a9ac84"
msgid "<i>His guard's down - grab the stake and drive it into his heart.</i>"
msgstr "<i>그가 경계를 풀었다- 말뚝을 움켜쥐고 그의 심장을 노린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 58454ca3-80f7-aede-f487-92f0d19eea68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:58454ca3-80f7-aede-f487-92f0d19eea68
msgctxt "hb331783bg1643g491dgbc2cg5fe3c5495740"
msgid ""
"*You try to connect, but your legs give out. You slump against him, "
"helpless.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 58474bb1-3101-27b0-36d4-9d51c882f64d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:58474bb1-3101-27b0-36d4-9d51c882f64d
msgctxt "h20bd3c8aga313g4bb1g83dag6e8ef0a89bb0"
msgid "I've never killed anyone! Well, not for food."
msgstr "나는 아무도 죽이지 않았어! 뭐, 적어도 식사로는."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 5ece674b-2bcf-d011-fdcd-a3658d954520
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:5ece674b-2bcf-d011-fdcd-a3658d954520
msgctxt "hed2498b6g90c3g46e5gafa7gc3ed7a228b6c"
msgid "I hope so. I look forward to seeing you fight."
msgstr "그랬길 바라. 네가 싸우는 모습이 기대되는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 5eed5b49-6b29-52b4-1792-575efa0952bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:5eed5b49-6b29-52b4-1792-575efa0952bb
msgctxt "h2e5adfdbgdfb7g4e41gaa0dgb38510624e14"
msgid ""
"I'd offer to help, Astarion, but my engine still means I'm too hot to touch."
msgstr "도와주고야 싶지만, 내 엔진이 난 아직 건드리기엔 너무 뜨겁다는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 5fb38181-f82a-d17a-f39d-1db638893313
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:5fb38181-f82a-d17a-f39d-1db638893313
msgctxt "h136e91b0g6defg4a82g9146g67d04dbc9563"
msgid "I was just swept up in the moment."
msgstr "그냥 이 순간에 빠져든 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 62083b24-f83d-fe68-0dfc-c1d7baea82d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerC_Leave = True
#.   Object:
#.     - GLO_Companion_LeaveDisappearInstantly(0) = True
#.   Quest:
#.     - ORI_COM_Astarion.CompanionLowRelation(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:62083b24-f83d-fe68-0dfc-c1d7baea82d7
msgctxt "h408731abg200cg45efg9bd0g581164938174"
msgid "*You try to grab him, but it's too late. He's gone.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 66ec30c0-8256-e71b-ee57-f292289f81ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:66ec30c0-8256-e71b-ee57-f292289f81ca
msgctxt "h6307c4f6g5ce4g4ca6g88e8gb8be6c1e920b"
msgid ""
"Gods! I'd nearly forgotten. I'm so hungry I would've bitten into anything."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 686b7911-d249-b31a-6e05-f17a8e40a9ff
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:686b7911-d249-b31a-6e05-f17a8e40a9ff
msgctxt "hb46b3918g0a1ag453dgafe1g90edf1d7bf87"
msgid "Stop! It's too much."
msgstr "그만! 이건 지나치잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 692880b8-618b-9119-167a-e680ca178b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:692880b8-618b-9119-167a-e680ca178b9c
msgctxt "hf83e028cg29d8g41e3ga3eegfafc6929dcf7"
msgid ""
"Please. Only be a taste, I swear. I'll be well, you'll be fine, and "
"everything can go back to normal."
msgstr "부탁해. 정말 맛만 볼게. 우리 둘 다 괜찮을 거고 모든 게 정상으로 돌아갈거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 69d36527-bf24-8930-19ce-0834297d055e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:69d36527-bf24-8930-19ce-0834297d055e
msgctxt "hec7fcecfgf4b8g4cd7g80c8ge6885cae6995"
msgid ""
"Gods! I'd forgotten about your little affliction. Hunger does cloud your "
"senses."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 6a4024a0-46ba-4704-bc5e-3e39953ee477
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:6a4024a0-46ba-4704-bc5e-3e39953ee477
msgctxt "ha3afe982g65f5g44d5gaa9egb24b96f4160f"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 6c8b0f72-1fa9-50a4-4069-34da710cb049
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_AstarionHunger_SCO_Companion_AvatarKneed(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:6c8b0f72-1fa9-50a4-4069-34da710cb049
msgctxt "ha59f8a3agd3beg4ad7g989bge8cd4a25d421"
msgid "Ouff! Oh you wretched little-"
msgstr "으윽! 오, 이 조그맣고 치사한 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 6ec4632d-68bf-cd7c-072f-219a4247e655
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:6ec4632d-68bf-cd7c-072f-219a4247e655
msgctxt "h5b296babgc9d2g49a1g9215g4b72a48de7fd"
msgid "Stop!"
msgstr "멈춰!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 6fb7dc2e-86c7-028c-3685-2847cc7a403c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:6fb7dc2e-86c7-028c-3685-2847cc7a403c
msgctxt "hf5236443g5f6bg4cbfga5b6g54f878b7b885"
msgid "I'm looking forward to seeing you fight."
msgstr "네가 전투에서 활약하는 걸 기대할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 710d943c-52b4-0af9-a308-80dd6c883cd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_GALE(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Astarion_Event_LetAstarionBite(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:710d943c-52b4-0af9-a308-80dd6c883cd2
msgctxt "h15b00097gd48cg4243g9ce4ge39746e964d2"
msgid "All right, but go too far and I'll drive a stake through your chest."
msgstr "좋아, 하지만 선 넘으면 네 가슴에 말뚝을 꽂아버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 71b8c9fe-d4e0-0408-4f1a-bacc3317185f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeWeaponAttack
#. RollAbility:
#. DifficultyClass: 0
#. CheckFlags:
#.   Dialog:
#.      - CAMP_AstarionHunger_SC_Companion_HasStake(1) = True
#. SetFlags:
#.   Quest:
#.     - ORI_COM_Astarion.LearnedVampire_Attacked(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:71b8c9fe-d4e0-0408-4f1a-bacc3317185f
msgctxt "hd2b07b62g95e0g4349g9123g9d92d1da101e"
msgid "<i>He's too dangerous. Grab the stake and drive it into his heart.</i>"
msgstr "<i>그는 너무 위험하다. 말뚝을 집어서 심장에 꽂아넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 71d8a4d4-b382-bd7f-0217-2ecbac3cec62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:71d8a4d4-b382-bd7f-0217-2ecbac3cec62
msgctxt "h38ef5f9fg6ec4g4438g9c5fgd6004aed2039"
msgid "I do. I believe you."
msgstr "그래. 난 널 믿어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 741bf884-f393-e29a-d2fd-e28560fb2ee6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_Event_KillAfterDialog = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:741bf884-f393-e29a-d2fd-e28560fb2ee6
msgctxt "he75cb8e0gb558g43ebga98ag5c98bb12f283"
msgid ""
"So that's why you were so quick to kill the Gur hunter: to keep your secret."
msgstr "그래서 네가 구르 사냥꾼을 그토록 황급히 죽인 거군. 비밀을 지키기 위해서."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = 7802ece2-143e-b162-f30c-7189ceb8b1dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:7802ece2-143e-b162-f30c-7189ceb8b1dc
msgctxt "h7ddb8d94gf8edg4d83ga0cegbd442cd58b6c"
msgid ""
"*You try to push him back, but his grip just gets tighter. You can feel your "
"blood racing, coursing through both your bodies.*"
msgstr "*당신은 그를 밀어내려 하지만 그는 더 세게 움켜쥡니다. 당신의 피가 하나가 된 두 육체를 통해 흐르는 것이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = 788bd674-2538-4b90-b329-c2305a1dfe5d
