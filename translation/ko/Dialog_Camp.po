#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = 03531eda-ddf9-9322-aa53-f514ea5b831b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:03531eda-ddf9-9322-aa53-f514ea5b831b
msgctxt "h197afb68g4d78g4dc9gac05gde346835f5f4"
msgid "A shame. He will be most disappointed, I fear."
msgstr "아쉽군. 그가 크게 실망할 텐데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = 26fbbfe7-cf8e-91ec-e1cd-0a36a72ccd96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:26fbbfe7-cf8e-91ec-e1cd-0a36a72ccd96
msgctxt "h637001fcg45a8g45e3g8c8eg30db71c5ec31"
msgid ""
"You are speaking to a mere projection of Gale - his appearance, his voice, "
"and a certain measure of his personality - reconstituted in this case to "
"play as emissary and usher."
msgstr ""
"네가 대화하고 있는 상대는 게일의 외모, 목소리, 그리고 일부 성격을 담은 투영체야. 이번 경우는 사절과 안내자로서의 역할을 하기 위해 "
"만들어졌지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = 2f3748e8-23de-43d8-9a77-36ebfafda441
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_LastNightAlive_RomanceCandidateExists = True
#.   Object:
#.      - ORI_State_DatingGale(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_LastNightAliveRomanceScene(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:2f3748e8-23de-43d8-9a77-36ebfafda441
msgctxt "h258fe4e4gd072g411agac0eg06f1fb417ca9"
msgid ""
"Good evening! I am here on behalf of Gale of Waterdeep. He wishes to extend "
"you an invitation for a private conversation in a more suitable locale."
msgstr "안녕하신가! 워터딥의 게일을 대신해 왔다네. 그는 더 적합한 장소에서 사적인 대화를 나누기 위해 그대들을 초대하고 싶어 한다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Player
#. NodeID = 38fe961b-31c7-4b48-8838-2d31bfc1996a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:38fe961b-31c7-4b48-8838-2d31bfc1996a
msgctxt "hd5ba9f5dg153fg4a16g8e6bg77e881da576a"
msgid "Very well, show me the way."
msgstr "좋아, 앞장서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Player
#. NodeID = 53220937-8dd5-1155-9976-9182f1448b98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_Gale_Knows_GaleDouble(1) = False
#. SetFlags:
#.   User:
#.     - ORI_Gale_Knows_GaleDouble(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:53220937-8dd5-1155-9976-9182f1448b98
msgctxt "h3edb2b00g70a2g4203gbd02ge442ae3b1a1f"
msgid "On behalf of Gale? <i>You're </i>not Gale?"
msgstr "게일을 대신해서? <i>네가</i> 게일인 건 아니고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = 683b9b52-54b7-4c38-b5c7-26dc3a65b38d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:683b9b52-54b7-4c38-b5c7-26dc3a65b38d
msgctxt "h8bc2432dg1682g48b1gbddbgfcd4591d641b"
msgid "Gladly."
msgstr "기꺼이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = 77720d0b-b48a-b8d3-3ebf-ffbbd19a4635
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:77720d0b-b48a-b8d3-3ebf-ffbbd19a4635
msgctxt "h6a6038a2gef29g4942g886fg2762b39a8864"
msgid ""
"Would you care to join him? What little I could glean from the portion of "
"his mind that is open to me, it is a matter most urgent."
msgstr "같이 가주겠어? 내가 그의 마음에서 알 수 있었던 것은 제한적이었지만, 꽤나 급박한 문제인 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Player
#. NodeID = 9ea52e88-8a41-de47-3899-bf873b02418a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:9ea52e88-8a41-de47-3899-bf873b02418a
msgctxt "haeef90ceg4f16g4f45gb659g5e674f145bd1"
msgid "Not interested."
msgstr "관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Player
#. NodeID = a0d0b2db-e61b-3eac-5412-7369bbf5101f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:a0d0b2db-e61b-3eac-5412-7369bbf5101f
msgctxt "ha4615594gbc86g47f3gbfd5g409967137480"
msgid "Later, perhaps."
msgstr "어쩌면, 나중에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = afeca5ff-24fb-4760-ae4a-6b56d930995d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_LastNightAliveRomanceScene(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:afeca5ff-24fb-4760-ae4a-6b56d930995d
msgctxt "h5db2af4age0deg4ba1gbb1ag33bdef091a34"
msgid "Simply follow yonder path and soon you will find him."
msgstr "길을 따라가면 곧 그를 찾을 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = b59e5ce2-71cc-d2b9-8fb6-ec87a6882611
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_LastNightAlive_RomanceCandidateExists = True
#.   Object:
#.      - ORI_State_DatingGale(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Gale_Event_LastNightAliveRomanceScene(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:b59e5ce2-71cc-d2b9-8fb6-ec87a6882611
msgctxt "h5d6c64ccg9615g4847gadc2g92871cc7567f"
msgid ""
"My message is intended only for the paramour of Gale of Waterdeep. Please "
"stand aside."
msgstr "내 메시지는 워터딥의 게일의 연인만을 위한 거야. 옆으로 좀 비켜주면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2
#. Speaker = Gale
#. NodeID = ff7490d5-223e-fa63-b4e7-14b5aadef44a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GaleDouble2:ff7490d5-223e-fa63-b4e7-14b5aadef44a
msgctxt "he4103807g4962g46c7gb45egfc712f82b048"
msgid ""
"Perhaps later shall be too late. I would urge you to reconsider, lest the "
"opportunity prove to be a fleeting one."
msgstr "나중이라면 너무 늦을지도 몰라. 기회가 왔을 때 다시 한 번 생각해보는 게 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = 53711949-4a59-9031-db1d-ee5253bac059
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_PartyHadKarsusNotes = True
#.   Object:
#.      - LOW_SorcerousSundries_Event_HasKarsusBook(0) = False
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_SentToFindBook = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:53711949-4a59-9031-db1d-ee5253bac059
msgctxt "hf5afc84bg0c72g4945gbac4g5c2664f95c5c"
msgid ""
"*You must learn more. There was a book in Sorcerous Sundries that surely had "
"the knowledge you needed... but what came of it?*"
msgstr "*정보가 더 필요합니다. 요술 잡화점에 분명 필요한 지식이 담긴 책이 있었죠... 하지만 결과는 어땠나요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = 87aedf0f-91ea-cb9d-e30e-efa81207b639
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_SawElderBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:87aedf0f-91ea-cb9d-e30e-efa81207b639
msgctxt "haba39391g2a5cg442ega67bg066e32ee7249"
msgid ""
"*You should get some rest, but you simply can't. Every time you close your "
"eyes, you see the brain... and more importantly, what it possessed.*"
msgstr ""
"*쉬어야 하지만, 그럴 수가 없습니다. 눈을 감을 때마다 엘더 브레인이... 더 정확히는 그 위에 얹혀 있던 물건이 아른거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = 9bf57443-0308-6bd7-90d8-06728403b0b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_SorcerousSundries_State_Visited = False
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_SentToFindBook = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:9bf57443-0308-6bd7-90d8-06728403b0b2
msgctxt "h0bcc1183g29d9g460eg9138g20640a7ff691"
msgid ""
"*The shelves at Sorcerous Sundries have been known to house the odd book on "
"Netherese magic. It's time you paid them a visit, to learn the truth about "
"the crown, and what it could yet be capable of.*"
msgstr ""
"*요술 잡화점의 책장은 네더릴 마법에 관한 특이한 책들을 보관하는 것으로 잘 알려져있죠. 이제 당신이 직접 가서 왕관에 관한 진실과, "
"그것이 지닌 힘에 대해 알아 볼 시간입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = ade7694f-639b-b934-4c7d-1cf4b6519e50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_SawElderBrain = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:ade7694f-639b-b934-4c7d-1cf4b6519e50
msgctxt "h3a9029c7g08f1g4df8g8be7gd925c91b8c9d"
msgid ""
"*You should get some rest, but you simply can't. All you can think of is the "
"brain that was beneath Moonrise Towers... and more importantly, what it was "
"said to possess.*"
msgstr ""
"*당신은 잠을 청해야 하지만, 도무지 그러기 힘들군요. 당신의 머릿속은 문라이즈 타워 아래에서 본 뇌 생각으로 가득합니다... 무엇보다, "
"뇌에 무엇이 잠들어있는 지에 관하여 말이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = be116bd3-0e65-c2ac-6fd3-83a374c8c0b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_PartyHadKarsusNotes = True
#.   Object:
#.      - LOW_SorcerousSundries_Event_HasKarsusBook(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_SentToFindBook = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:be116bd3-0e65-c2ac-6fd3-83a374c8c0b1
msgctxt "h807b7cfag6ae4g46a6g8110g5789916c0067"
msgid ""
"*You must learn more. The book acquired from Sorcerous Sundries - it surely "
"has the knowledge you need.*"
msgstr ""
"*더욱 더 알아 내야만 합니다. 요술 잡화점에서 구할 수 있는 그 책에, 분명 당신이 필요로 하는 지식이 담겨 있을 것입니다. *"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = de56e5a1-9243-a3e6-a150-f1ec0814497b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:de56e5a1-9243-a3e6-a150-f1ec0814497b
msgctxt "h44bf8629g13e2g4448gacd1g66f4754ee214"
msgid ""
"*An artefact. A crown. Positively reeking of Netherese magic. More than you "
"ever felt before. More than you ever dreamed was possible.*"
msgstr ""
"*이 아티팩트. 이 왕관은 네더릴 마법을 뿜어내고 있습니다. 당신이 한번도 느껴보지 못했던, 감히 상상조차 하지 못한 만큼이나 말이죠. *"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = ed891a6c-2f40-ccc8-eac7-6e2b323317ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_SorcerousSundries_State_Visited = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:ed891a6c-2f40-ccc8-eac7-6e2b323317ce
msgctxt "h0c3b2bacg5638g4b17ga23dg5ea849500a47"
msgid ""
"*The shelves at Sorcerous Sundries have been known to house the odd book on "
"Netherese magic. It's time you made a return visit, to learn the truth about "
"the crown, and what it could yet be capable of.*"
msgstr ""
"*요술 잡화점 책장에는 네더릴 마법에 관한 특이한 서적들이 있다고 알려져 있습니다. 다시 한 번 방문하여 왕관의 진실과 그 힘에 대해 "
"알아볼 때가 됐습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus
#. Speaker = Narrator
#. NodeID = f8c1bbad-f274-e359-1933-d477ca460da0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_PartyHadKarsusNotes = False
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_SentToFindBook = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_SD_CrownOfKarsus:f8c1bbad-f274-e359-1933-d477ca460da0
msgctxt "h2281c4a2gfeafg4912g8ddegbdf3537dce19"
msgid ""
"*Karsus himself was said to have forged such a crown, though you've never "
"known it spoken of as anything but myth.*"
msgstr "\"카서스가 직접 만든 것이라는 이야기가 있기는 했지만, 당신은 그저 신화로 치부하고 있었습니다.\""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 00732469-f252-ccad-44fd-b69f419688a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:00732469-f252-ccad-44fd-b69f419688a5
msgctxt "h48ae6a07g27c5g4833gadf8gddb3979b732f"
msgid "Did you now? About time she showed her... erm, does she have a face?"
msgstr "이제서야. 드디어 얼굴을 비치는... 음, 얼굴이 있기는 했던가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 0149e137-64b1-0340-2b65-ea27f730a197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:0149e137-64b1-0340-2b65-ea27f730a197
msgctxt "h5fb62a21g161eg44dagbbf1ge3fa6191da8e"
msgid ""
"I'll be sure to let your mother know you'll be home before she knows it - "
"for a nice long visit."
msgstr "그럼 전 도련님 어머니께 도련님이 곧 어머님과의 길고 감동적인 만남을 위해 집에 돌아간다고 알려드려야 겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 01a6f520-ac0e-36c5-525f-ff443f8f248b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:01a6f520-ac0e-36c5-525f-ff443f8f248b
msgctxt "hcce43df7g590eg442bg8a8eg1eddb2805c10"
msgid ""
"She still wants to know when she'll see you again, sir. I avoid giving any "
"answers. But she misses you."
msgstr "언제쯤 다시 당신의 얼굴을 보게 될지 궁금해하시더라고요. 확답은 드리지 못했지만요. 어머니가 당신을 많이 그리워하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 01e768d8-d26f-c7d7-11d2-ef6b326c8131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:01e768d8-d26f-c7d7-11d2-ef6b326c8131
msgctxt "h797cb2f2gb349g4aebg93c5gb803e7ecd8f1"
msgid "Days rather than tendays."
msgstr "며칠밖에 남지 않은 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 023a850c-af94-529d-9e93-a5457c21a9bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:023a850c-af94-529d-9e93-a5457c21a9bc
msgctxt "h801f98aagf02dg456cg83eegaf6ebf9086af"
msgid "Perhaps."
msgstr "아마도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 02e99e9a-cb2e-ccba-4155-618ff75e7983
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:02e99e9a-cb2e-ccba-4155-618ff75e7983
msgctxt "ha39e1492g9013g4845gb410ga0dadb4b6c07"
msgid ""
"Mystra is a god. She can handle this without taking your life in the "
"bargain, surely!"
msgstr "미스트라는 신이에요. 당신의 목숨을 빼앗지 않고도 해결할 수 있다고요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 038954b3-5bce-6e0a-4240-1d73f45aa68f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:038954b3-5bce-6e0a-4240-1d73f45aa68f
msgctxt "haf5d009cg0cd0g4be3g86ceg583337892fa9"
msgid ""
"To be honest, it's been nothing but one escalating problem after the other."
msgstr "솔직히 말하자면, 다른 문제도 겹겹이 쌓여있는 상태거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 047300d6-35b7-d064-e074-8cf7510a64ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:047300d6-35b7-d064-e074-8cf7510a64ce
msgctxt "h40fdb835g92b1g4b58g9e66g08c2116f61f4"
msgid "I think so, yes."
msgstr "네, 그렇게 생각해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 049dbdeb-831b-c41f-97b4-de9cf488dbe9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:049dbdeb-831b-c41f-97b4-de9cf488dbe9
msgctxt "h070ba16ag1873g400dgb07dgae308fd0cc8b"
msgid "I need a moment. There's much to consider."
msgstr "잠시만요. 고려해야 할 것들이 많네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 04c977fc-131a-e979-39d6-b0b9d5ccce03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_WentToAct3 = True
#.      - ORI_Gale_State_SentToFindBook = False
#.      - ORI_Gale_Knows_ReadKarsusNotes = False
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:04c977fc-131a-e979-39d6-b0b9d5ccce03
msgctxt "ha20014f8g6f0cg48ddgb845gdb6a8cd710e9"
msgid "There's a glint in your eye, Mr Dekarios. Explain."
msgstr "눈이 반짝이는군요, 데카리오스 씨. 설명해 주시겠어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 056fe43c-f77d-f8c2-723d-aec9444a8abb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:056fe43c-f77d-f8c2-723d-aec9444a8abb
msgctxt "ha27d77dagac7bg415fga7d3g7dcd573bb8b9"
msgid ""
"She really wants to kill you, Gale? To squander your life? Is that really a "
"god you want to serve?"
msgstr "정말로 죽으라고 했단 말예요? 게일? 그렇게 그냥 목숨을 버리라고? 그런 신을 모시고 싶으신가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 05dfa341-01d9-0d6f-1f23-639f48056615
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:05dfa341-01d9-0d6f-1f23-639f48056615
msgctxt "h6089ec57gcf92g45aega9f8gc85a5a9b127d"
msgid "I don't know, Tara, I'm feeling a little... tentacular."
msgstr "잘 모르겠어, 타라. 약간... 촉수가 돋아 나올 것 같은 느낌이 있는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 069f71e1-6a18-151a-7475-14cf594803d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:069f71e1-6a18-151a-7475-14cf594803d9
msgctxt "h695ec2d9g72a1g418cgaf80g344a51936158"
msgid ""
"I can't fathom why you're speaking in the past tense, sir. If you've lost "
"the damn thing, I expect you to get busy finding it. It could be the key to "
"your salvation."
msgstr ""
"왜 지나간 일처럼 말씀하시는 건지 모르겠군요. 그 망할 것을 잃어버렸다면, 이미 찾느라 바빠야 하는 게 도리 아닌가요. 구원의 열쇠일 "
"수도 있잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 085b4715-1f57-e35f-fff9-7ca485a0ff36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:085b4715-1f57-e35f-fff9-7ca485a0ff36
msgctxt "h3b2fe8a4g34d3g44fbg9050gfc3434475e9e"
msgid "Let's just say, I'm glad it's over with."
msgstr "그냥, 끝나서 다행이라고만 해 두지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 08e7c35a-6546-31e0-b3f5-1a95ef5abefd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_StormshoreTabernacle_State_GaleChallengesMystra = True
#.      - LOW_StormshoreTabernacle_State_HeardMystraQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:08e7c35a-6546-31e0-b3f5-1a95ef5abefd
msgctxt "h968f3664g7171g4e93gb964g279549fb15b0"
msgid ""
"She told me the orb is actually the Karsite Weave. I think there's a chance "
"I could control it, if I reforge the Crown."
msgstr "이 보주가 사실은 카서스의 위브라고 했지. 왕관을 재련해 내면 이 위브의 힘을 다룰 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 0a23a319-3f29-2324-89d6-31e8f57b2491
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_Tressym_Event_FlyOff = True
#.   Object:
#.     - CAMP_Gale_Tressym_MadAtGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:0a23a319-3f29-2324-89d6-31e8f57b2491
msgctxt "h1ad97c06gff7fg4c0dg99a3g62a58e0468d9"
msgid "Go! I don't want to look at you anymore! Go on!"
msgstr "저리 가세요! 더는 꼴도 보기 싫어요. 가라구요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 0af834b4-6fdd-8bec-2a86-1941cebb35f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_ReadKarsusNotes = False
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_MadAtGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:0af834b4-6fdd-8bec-2a86-1941cebb35f3
msgctxt "h2027a207ga123g4e96g859ag606ab8ce4426"
msgid ""
"What's that? For a moment I thought my friend Mr Dekarios was near, but now "
"I see it's only the ghost of one of Mystra's playthings."
msgstr "방금 뭐였죠? 잠시 나의 친구 데카리오스 씨가 근처에 있다고 생각했는데. 다시 살펴보니 미스트라의 버려진 장난감밖에 안 보여요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 0d960be8-333f-750b-98f2-d2fdbaa89984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:0d960be8-333f-750b-98f2-d2fdbaa89984
msgctxt "h60816c78gcf68g4a87g8426geb1759c3ab5a"
msgid ""
"Like winning my unwavering affection, for instance. And oh, you did a very "
"good job of that."
msgstr "예를 들면 저의 변함없는 애정을 얻는다던가 하는 거요. 아, 당신은 그 일을 아주 잘 해냈지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 0e2ee622-b117-cb61-45fa-a9e480302f31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:0e2ee622-b117-cb61-45fa-a9e480302f31
msgctxt "h7b9ea5ffg345bg4557g898egae156cc3d825"
msgid "I have. The ghost of love past."
msgstr "맞아. 지나간 사랑의 유령이랄까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 0f287cb1-4433-93f1-6207-7270866d7847
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:0f287cb1-4433-93f1-6207-7270866d7847
msgctxt "h35843125gad68g4b6bgb091g2d2652641ad2"
msgid "Start at the top, then."
msgstr "그럼 제일 중요한 것 부터 시작하셔야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 0f61dc4e-b664-a9f7-041f-5b670ad2434e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:0f61dc4e-b664-a9f7-041f-5b670ad2434e
msgctxt "h77bb04b4g0e84g454ag9aa8ga8c4b4d5042e"
msgid ""
"It isn't your job to do the gods' dirty work for them. If Mystra wants to "
"intervene, let her do so at her own peril."
msgstr "당신이 신의 뒷처리나 해줄 이유 같은 건 없어요. 손을 쓰고 싶었다면 미스트라 본인이 직접 위험을 감수해야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 10d7120c-087c-7aa7-3604-ddb574f34ca0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:10d7120c-087c-7aa7-3604-ddb574f34ca0
msgctxt "h0bbf59b1g5b21g44f8ga158g448a00eaeaee"
msgid "I'm still considering all my options."
msgstr "아직 모든 가능성을 검토하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 10e8fec5-f1b6-297e-f45e-2d24decbde9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:10e8fec5-f1b6-297e-f45e-2d24decbde9b
msgctxt "hf0e4d3dbgfddeg462dg8488gc7784d31e3e7"
msgid ""
"Well. I won't lie, this is a terrible problem. But do you know who's a dab "
"hand at solving terrible problems? Brilliant wizards."
msgstr ""
"뭐, 거짓말은 하지 않을게요. 이건 진짜 끔찍한 일이군요. 하지만 끔찍한 일들을 누가 제일 잘 해결할 수 있는지 아시나요? 뛰어난 "
"위저드죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 124b81e2-3fe7-1625-d805-e967ff7736e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:124b81e2-3fe7-1625-d805-e967ff7736e5
msgctxt "h272cea4bgce59g4871g8ef8gf9ae601076b1"
msgid "Elminster? And what did he have to say for himself?"
msgstr "엘민스터가요? 그 사람이 뭐라던가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 1296ff21-a7e0-5cdb-feb6-dfaff9a58586
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1296ff21-a7e0-5cdb-feb6-dfaff9a58586
msgctxt "h5bdcc0b6ge5c1g4f1cgabdag04bed486b86b"
msgid "Hmm. I smell the outer planes on you. Mystra, then, is it?"
msgstr "흠. 다른 차원의 냄새가 느껴지는군요. 미스트라를 만났나 봐요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 12bc836b-2719-d70c-f7cd-7d577e68a7e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:12bc836b-2719-d70c-f7cd-7d577e68a7e3
msgctxt "h37e053ffg8d5eg41d8gabddg73b1717bf1ef"
msgid ""
"You are too precious to meet your end splattered all over an illithid "
"monstrosity. No no. I won't allow it."
msgstr "당신은 일리시드한테 찢겨 죽기엔 너무나도 소중한 사람이에요. 아니, 아니, 내가 허락 못 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 13039d57-5450-ed7f-a212-02e4f9ea64fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:13039d57-5450-ed7f-a212-02e4f9ea64fc
msgctxt "h71c3fbe4ga016g471dgb7f1g10856c59de1c"
msgid "My gods! She didn't. She wouldn't!"
msgstr "원 세상에! 그럴 순 없어. 그럴 리가 없어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 135cfc7d-3ea8-e4d7-b72a-64e7b8a12f18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:135cfc7d-3ea8-e4d7-b72a-64e7b8a12f18
msgctxt "h44967680gac94g4020g9f4eg62ff94d13e6f"
msgid ""
"That's not the look you have when you've been on a spending spree, Mr "
"Dekarios. You look... guilty."
msgstr "쇼핑을 즐긴 사람의 얼굴이 아닌데요, 데카리오스 씨. 뭔가... 죄책감을 느끼는 사람 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 138d004d-f288-d7b9-d6e4-d3d096eaa38b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:138d004d-f288-d7b9-d6e4-d3d096eaa38b
msgctxt "h0d238395g7d84g434fgaf2ag141a01292f70"
msgid ""
"I hope he apologised for that horrid message he brought the last time he "
"graced us with his presence."
msgstr "지난번 만남에서 했던 그 끔찍한 이야기를 사과하려고 온 거면 좋겠는데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 179ae5ca-917f-822a-719b-69aabca77bce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:179ae5ca-917f-822a-719b-69aabca77bce
msgctxt "h52f62718g1326g4e7cg826egb553279e62fe"
msgid ""
"I won't ask for more details. All I know is we can lick this thing. Rough-"
"tongued and ready."
msgstr "더 깊게는 물어보지 않겠습니다. 그래도 함께 라면 이런 문제쯤은 핥아 없애버릴 수 있지요. 혓바닥 굳게 먹고 준비하자구요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 17bf1cdb-f48d-1518-7599-30cfc01cb487
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_Tressym_Event_FlyOff = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:17bf1cdb-f48d-1518-7599-30cfc01cb487
msgctxt "hb9fac23fg7e05g45f0gaba0g75a18317c257"
msgid ""
"Goodbye, Mr Dekarios. Try to regrow the bits of your brain that parasite has "
"obviously been eating. Before it's too late."
msgstr ""
"안녕히, 데카리오스 씨. 그 기생충이 당신의 뇌를 약간 먹어버린 것 같은데, 어떻게 해서든 다시 자라게 하는 게 좋을 거예요. 너무 늦기 "
"전에 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 17cb8750-55d2-f6c3-64e5-c0a7427ca044
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:17cb8750-55d2-f6c3-64e5-c0a7427ca044
msgctxt "hbb636573g6cb9g4296ga003g19f97b7f25cd"
msgid "Good point - I'll have another visit."
msgstr "좋은 지적이야. 다시 한 번 방문해 봐야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 184bbaad-af13-77fa-3288-7013c8e236a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:184bbaad-af13-77fa-3288-7013c8e236a7
msgctxt "hb8c57799g0c71g4f3dg8215g229a7b54f917"
msgid ""
"Mr Dekarios. Gale. You are the finest mind - the finest wizard - I have ever "
"had the pleasure to know."
msgstr "데카리오스 씨. 게일... 당신은 참으로 훌륭한 지성인이고, 훌륭한 위저드세요. 만날 수 있어 영광입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 18ca07a2-ae2a-a1fa-91e5-edbb99169b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:18ca07a2-ae2a-a1fa-91e5-edbb99169b6b
msgctxt "h035cee69g1cfeg42a4g82abgce28f4ecd360"
msgid "You don't want to know."
msgstr "알고 싶지 않을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 1c36062f-98bf-b221-025b-d87484a64ccb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1c36062f-98bf-b221-025b-d87484a64ccb
msgctxt "hde119e25g4d5fg4a54g8ff2g80c9afbc03bb"
msgid "Farewell, sir."
msgstr "그럼, 안녕히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 1db178ff-31de-8dc0-b8ca-6b567827230d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1db178ff-31de-8dc0-b8ca-6b567827230d
msgctxt "h88882baag56dag4550g86e8g081b4dbc8d40"
msgid ""
"Don't be too hard on yourself, sir. You've been like that all your life."
msgstr "너무 자신에게 엄격하게 굴지 마세요, 도련님. 평생을 그렇게 살아오셨잖습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 1dc84bdb-af6a-931e-b2f8-14bca30f94e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1dc84bdb-af6a-931e-b2f8-14bca30f94e8
msgctxt "h6f535167g3d65g4370g8a72gea1928350d13"
msgid "I'm not sure..."
msgstr "잘 모르겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 1e5f2e5a-bd1f-62a2-967e-dfc71a6a86d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = False
#.      - ORI_Gale_State_GotOneMagicItem = True
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_FirstSpeech(1) = True
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1e5f2e5a-bd1f-62a2-967e-dfc71a6a86d6
msgctxt "h843274cag553eg4306gb1f7g9f2bea1994da"
msgid "What is it, Mr Dekarios?"
msgstr "무슨 일이죠, 데카리오스 씨?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 1e5f2e5a-bd1f-62a2-967e-dfc71a6a86d6
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = False
#.      - ORI_Gale_State_GotOneMagicItem = True
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_FirstSpeech(1) = True
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1e5f2e5a-bd1f-62a2-967e-dfc71a6a86d6
msgctxt "hd39d3b2ag2661g484cgadbcg583d15b8dfcc"
msgid "All right, Mr Dekarios?"
msgstr "별일 없죠, 데카리오스 씨?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 1e5f2e5a-bd1f-62a2-967e-dfc71a6a86d6
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = False
#.      - ORI_Gale_State_GotOneMagicItem = True
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_FirstSpeech(1) = True
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1e5f2e5a-bd1f-62a2-967e-dfc71a6a86d6
msgctxt "ha5dca090g5a4ag4646ga539g0fbf0f21b39e"
msgid "Well, if it isn't my favourite fellow himself."
msgstr "음, 제가 가장 좋아하는 분이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 1ee3f4f8-7bf2-7b6e-9283-30f10b1008b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_SorcerousSundries_State_Visited = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1ee3f4f8-7bf2-7b6e-9283-30f10b1008b6
msgctxt "heaa66897g68a6g498bg8890g3ef06a17b87b"
msgid ""
"Well! We are in Baldur's Gate, aren't we? You've always been very positive "
"about the selection of books in Sorcerous Sundries. An opportunity for "
"research, perhaps."
msgstr ""
"이런! 벌써 발더스 게이트에 도착한 모양이네요? 도련님은 언제나 요술 잡화점의 책들한테 기대가 높으셨죠. 알아보기 딱 좋은 시간이 "
"아닐까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 1fef3368-3182-bd8e-f755-0b878e71d86c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:1fef3368-3182-bd8e-f755-0b878e71d86c
msgctxt "he95cb131gfde3g415fga337gdadfd131d004"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 200557cd-a841-fe55-a762-c278d74efa5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:200557cd-a841-fe55-a762-c278d74efa5b
msgctxt "hefe42b3cgc9d5g4987ga670gbeeb4a446921"
msgid "Oh? Well, do go on, Mr Dekarios."
msgstr "아, 그래요? 그럼 계속 말해보세요, 데카리오스 씨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 20ec8a41-b4e4-76e5-56c4-bfe890592714
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:20ec8a41-b4e4-76e5-56c4-bfe890592714
msgctxt "hb9c36ee4gbd80g48c6gbe6ag10915003329a"
msgid "Unfortunately."
msgstr "유감이지만 그렇지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 235178ca-c069-9e79-e063-258062d92eac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:235178ca-c069-9e79-e063-258062d92eac
msgctxt "h5ba1c00dg8e25g46d7g950bg7df13962fb88"
msgid "Must be the beard."
msgstr "수염 때문일지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 23b8b61a-b950-417f-ca05-ffcbb6a3fd66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:23b8b61a-b950-417f-ca05-ffcbb6a3fd66
msgctxt "h351f7b61g7a12g473fga30eg1eee850f6fb0"
msgid ""
"I thought you'd have learned by now what pursuing such power can cost. If "
"you haven't... well, I'm not sure who's left to teach it to you."
msgstr "이젠 그런 힘을 추구하면 어떤 대가가 따르는지 배웠으리라 생각했는데요. 아니면... 음, 남은 길이 있을까 싶군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 24dda1c1-5f98-8c3a-1dd5-12fdca3e587e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:24dda1c1-5f98-8c3a-1dd5-12fdca3e587e
msgctxt "h1fb1cc62gc78fg4391ga957gb60794dd1520"
msgid ""
"Elminster also brought instructions from Mystra. I'm to detonate the orb "
"once I find the 'Heart of the Absolute.'"
msgstr "엘민스터가 미스트라의 지시를 전해주더군. 절대자의 심장부를 찾게 된다면 보주를 폭발시키라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 25017f8c-a714-db56-66ed-b0e7a8885980
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_Tressym_Event_FlyOff = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:25017f8c-a714-db56-66ed-b0e7a8885980
msgctxt "h6f80f2a0g6546g48d1g8329gf96d68e477d1"
msgid ""
"When this is all over I'll be waiting for you, with a crackling fire and "
"good book at the ready. Good luck, darling."
msgstr "이 모든 일이 다 끝나면 당신을 기다리고 있을게요. 난롯가에 불을 지피고, 좋은 책을 준비해 둘 테니까. 행운을 빌어요, 자기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 254ef7ce-0857-dc84-c9ef-5476a5e0551f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_ReportedHadKarsusNotes = True
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:254ef7ce-0857-dc84-c9ef-5476a5e0551f
msgctxt "h2a64b1f0g9dacg4945g9290g89e35c7e2a3c"
msgid ""
"If I have to go search for it myself, I'm going to take it out on the legs "
"of your leather chaise."
msgstr "만약 저보고 찾아오라고 시키신다면, 도련님 가죽소파에다 확 분풀이 해버릴 거랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 257d66d4-ea08-e49f-b64d-2538ce146553
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:257d66d4-ea08-e49f-b64d-2538ce146553
msgctxt "hfd50911dg0855g41abgae71g96a52c77870b"
msgid ""
"And - Mr Dekarios - please. The beard. I'd cut it down myself if I could "
"hold a razor."
msgstr "그리고, 데카리오스 씨, 제발 부탁인데 그 수염 좀 어떻게 해봐요. 내가 면도날을 잡을 수만 있었으면 벌써 잘라버렸을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 25aebf34-20af-82ac-a2ef-c1ba629cf239
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_ReadKarsusNotes = False
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_MadAtGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:25aebf34-20af-82ac-a2ef-c1ba629cf239
msgctxt "haf2c16d6gc718g4fa8g91a3gb485482b050e"
msgid ""
"This disobedience of yours had best continue once you find this Heart of the "
"Absolute, Gale. That's all I have to say to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 2662a1c0-e59b-d4a1-d61d-461e52e11e0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = False
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_FirstSpeech(1) = False
#.   Tag:
#.      - REALLY_GALE(1) = True
#.      - GALE(1) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_Tressym_FirstSpeech(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2662a1c0-e59b-d4a1-d61d-461e52e11e0c
msgctxt "hd09f610bg4f1fg4ad4ga517g855d199b463f"
msgid ""
"Ah! Oh, goodness. That thing on your face is even worse than I remember."
msgstr "아! 세상에나, 당신 얼굴의 그건 점점 더 흉측해져 가는 것 같은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 2a354eb8-9513-df76-c267-fab4ab34e6fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2a354eb8-9513-df76-c267-fab4ab34e6fe
#, fuzzy
msgctxt "h5d4762a8gd99eg4e56ga691g833488e1a415"
msgid ""
"You've a Netherese orb in your belly, a tadpole in your head, and you've "
"been sleeping in what amounts to a very well-appointed ditch. So go on - "
"explain yourself."
msgstr ""
"가슴에는 네더릴 보주를 달았고, 머리에는 올챙이가 살고 있고, 멋진 흙바닥에서 잠을 자고 다니니 하는 말이죠. 그러니 왜 그런지 "
"말해보세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 2bb25678-98f9-3c73-4d4f-b509c400673a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2bb25678-98f9-3c73-4d4f-b509c400673a
msgctxt "h69c7279bgfeefg4df0gbf2fgb0fada0fa323"
msgid "Oh. That's no fun. I was hoping for a good bit of gossip."
msgstr "아아, 재미없기도 해라. 재미있는 이야깃거리라도 있었으면 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 2bc007a7-9b35-e738-d0fa-9a93d5bd740d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2bc007a7-9b35-e738-d0fa-9a93d5bd740d
msgctxt "hcab5d4e9ge9f0g49c2g9f0eg809372ab3a87"
msgid "No. I'm determined to find another way."
msgstr "응. 다른 방법을 찾아볼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 2d317741-8c3d-9924-c5ac-e7084a94f4b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2d317741-8c3d-9924-c5ac-e7084a94f4b9
msgctxt "hba6470cfga8c7g4a8fgb1c0gd99c6892cc32"
msgid ""
"I suppose I'll leave it be, so long as this thing you're 'handling' won't "
"blow us all to smithereens."
msgstr "좋아요, 그럼 더 캐묻지 않을게요. 당신이 '해결할 수 있는' 그 일이 우리 머리통을 날려 버리지 않기를 바라야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 2e7bccc9-f37a-3be0-e8bc-f064ac7be716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2e7bccc9-f37a-3be0-e8bc-f064ac7be716
msgctxt "hcd5c2ef2ga647g4cb6gbbebg0be456c641f3"
msgid "No more guilt trips, Tara. Please."
msgstr "타라, 날 더 이상 죄책감에 시달리게 하지는 말아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 2f90e3cf-a30b-7641-925a-6e97ce5ec3c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2f90e3cf-a30b-7641-925a-6e97ce5ec3c1
#, fuzzy
msgctxt "h8728dc5dg198ag408eg8dabg66b639527b50"
msgid "Mr Dekarios, if you have to ask, there's no hope for you at all."
msgstr "데카리오스 씨, 굳이 물으신다면 말이죠. 당신의 수염에 대한 기대는 버리는 게 좋아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 2f9656cd-790c-035d-ae32-c5c6950d2027
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2f9656cd-790c-035d-ae32-c5c6950d2027
msgctxt "h9012c4b7g662ag4e26ga538gf7d9e62bf1d4"
msgid "Don't be silly. What is it really?"
msgstr "바보 같은 소리는 마세요. 진짜 이유는 뭐예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 2fd03510-345f-9d9a-1f8e-42f70dff762c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:2fd03510-345f-9d9a-1f8e-42f70dff762c
msgctxt "h3292096ag307cg47edg95c6g9f1a0cb5f7da"
msgid ""
"I faced the Chosen of Myrkul and got a glimpse of where this journey will "
"lead us."
msgstr "머큘의 선택받은 자와 대면했었지. 그리고 우리의 이 여정이 어떻게 흘러가게 될지 살짝 맛보고 왔다고나 할까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 30079df3-03bd-eb0e-bb3f-4496e62e28c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:30079df3-03bd-eb0e-bb3f-4496e62e28c9
msgctxt "h432bb68cg70d3g40edgb046g5c0ca0f2cee1"
msgid "We'll talk later, hmm?"
msgstr "흠, 나중에 이야기할까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 303ae71a-5745-9020-afb0-b9dbde55986e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:303ae71a-5745-9020-afb0-b9dbde55986e
msgctxt "h83dd8bdeg578fg41a9g840dg3a8b33a849c4"
msgid ""
"That you wouldn't figure a way out of it. My clever friend never leaves a "
"knot knotted. This parasite is one more knot, so get to tugging threads."
msgstr ""
"당신이 해결할 방법을 찾을 거라는 거예요.나의 영리한 친구가 풀지 못할 매듭이란 없어요.\n"
"이 기생충도 단지 하나의 매듭에 지나지 않으니, 실을 잘 잡아당겨 보세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 31951920-2a5c-9016-8c15-bae034a18d96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:31951920-2a5c-9016-8c15-bae034a18d96
msgctxt "h76468b3dg5b3ag461dgbcbdg53ea7cb8d820"
msgid ""
"I've mostly been looking for artefacts to help stabilise me. It's a full-"
"time job."
msgstr "나를 안정시킬 아티팩트를 찾아다녔지. 눈코 뜰 새 없이 바빴다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 32291eb8-3ddd-37d5-b586-928c22773b4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Gale_AvatarCrownOfKarsus = False
#.      - ORI_Gale_State_PartyHadKarsusNotes = False
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:32291eb8-3ddd-37d5-b586-928c22773b4d
msgctxt "hd5643d49gbd3ag4819g92edg92918d07a445"
msgid ""
"Back in Moonrise Towers I saw an elder brain, wearing a curious Netherese "
"crown. I need to find out more about it..."
msgstr "저번에 문라이즈 타워에서, 엘더 브레인이 신기한 네더릴 왕관을 쓰고 있는걸 봤어. 그게 뭔지 더 자세히 알아내야해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 32b8631a-5a79-3baf-d1ed-a075ac950e41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:32b8631a-5a79-3baf-d1ed-a075ac950e41
msgctxt "hc3336c50g8ba1g4de5gb75ag4255ce9b7364"
msgid "I've been a bit preoccupied, you know."
msgstr "다른 일 때문에 정신이 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 342dd35a-ec4b-735a-6ffc-5eb349184987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:342dd35a-ec4b-735a-6ffc-5eb349184987
msgctxt "hddd44cddg7a8bg46cbgad40gb705675efa9f"
msgid "If you must know, there <i>is </i>someone..."
msgstr "네가 꼭 알아야겠다면, 그럴 사람이 <i>있기는</i> 한데…"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 360134d0-a964-ca9e-a102-66d89b5a47b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_WentToAct3 = True
#.      - ORI_Gale_Knows_ReadKarsusNotes = False
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = True
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedAct3Quest = False
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:360134d0-a964-ca9e-a102-66d89b5a47b7
msgctxt "h63706eadgea38g4e8bg8ab2g528fd473b825"
msgid "Well, sir? How goes the search?"
msgstr "어때요? 조사는 잘 돼가나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 3688943e-3763-3154-7d0d-29f41bc2ae19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:3688943e-3763-3154-7d0d-29f41bc2ae19
msgctxt "h168705bbg5cb7g4edbg8993g50d2dfff0abc"
msgid ""
"I'm not one to pry. I'd rather make up all the juicy details myself over tea "
"with your mother."
msgstr "제가 캐묻는 성격은 아니라서 말이죠. 그냥 어머님과 차나 한잔 하면서 이런 저런 말이나 지어 내렵니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 36ee6ae8-9a36-fcfa-9e5e-829c2e6ab269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:36ee6ae8-9a36-fcfa-9e5e-829c2e6ab269
msgctxt "hb0fa057fg12a2g4901ga8d2ged4e9807ff39"
msgid ""
"Damn the Absolute. Damn Mystra. Damn it all, if you go through with this, "
"Gale."
msgstr "망할 절대자 자식도, 망할 미스트라님도, 이럴거면 다 집어치우라고 하세요, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 37891239-8013-e92b-99d3-fb31c353c495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:37891239-8013-e92b-99d3-fb31c353c495
msgctxt "h10c5a037g9800g4c10g8d94gdbff5a5901a4"
msgid "Not in the slightest."
msgstr "전혀 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 37e2892a-b20d-7185-d623-f62441097c33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:37e2892a-b20d-7185-d623-f62441097c33
msgctxt "h6230f331g7340g4ae2g9f32g49d8f4537177"
msgid "Indeed."
msgstr "정말이예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 380b94a3-f34c-699a-e62b-2f773444cb64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:380b94a3-f34c-699a-e62b-2f773444cb64
msgctxt "h8435c073g3bfcg4a02g849eg418a1cf1f931"
msgid ""
"You <i>are </i>my pet. And I'm yours. A perfect circle of companionship. I "
"don't know about you, but I wouldn't have it any other way."
msgstr ""
"도련님이 제 애완동물이잖습니까. 동시에 전 도련님의 애완동물이구요. 완벽한 우정의 고리죠. 어떻게 생각하실는지 모르겠지만, 전 이 상태에 "
"아주 만족한답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 38606a95-8756-4977-bdfc-0fe655ba8894
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:38606a95-8756-4977-bdfc-0fe655ba8894
msgctxt "h2c8a2baeg31eag4e67g98e9g51453216dab4"
msgid "That parasite in your head seems to be quiet enough, thank the gods."
msgstr "그 머리에 있는 기생충은 그래도 좀 조용해 보이네요, 천만다행이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 38ace68c-4d8f-8274-33ce-8bb7a0f8bdf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Elminster_Event_WentToCamp = False
#.      - ORI_Gale_Knows_KarsiteWeave = False
#.      - ORI_Gale_Tara_KnowsMystraSummons = False
#.      - ORI_Gale_State_Met_ElminsterInWYR = True
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_RefusedElminsterWYRInformation = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:38ace68c-4d8f-8274-33ce-8bb7a0f8bdf6
msgctxt "heecaaa2egfd9ag4921gb6d0gbe79f02a8e46"
msgid "I know that look. Come on - out with it. What's happened?"
msgstr "당신의 표정만 봐도 알아요. 말해보세요, 무슨 일이 있었나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 3b85dda8-da65-2eea-e83a-c45d2503e0cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:3b85dda8-da65-2eea-e83a-c45d2503e0cd
msgctxt "h90cb0c6eg68ffg4886g999agf31fce1f8dc0"
msgid ""
"I know that, but she doesn't. She'd keel over if she knew just how you'd "
"tried to manipulate the Weave."
msgstr "저는 이해하지만, 어머님께선 그러지 못하신답니다. 도련님이 어떻게 위브를 조종하려 했다는걸 알면 쓰러지실거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 3d195fd6-1ff2-0a3e-4c65-ff2c5024f59c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:3d195fd6-1ff2-0a3e-4c65-ff2c5024f59c
msgctxt "ha94e6ce7g333bg4e87g8876g84c31d5ecd8a"
msgid ""
"But you're wise - and wiser all the time. Do what Mystra asks, and I'm "
"positive she will cure you of that wretched orb."
msgstr "하지만 당신은 언제나 현명하죠. 이 일을 잘 해낸다면, 미스트라가 그 끔찍한 보주를 치료해 줄 거라 믿어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 3e95baa5-d6fc-2f52-84f5-033ba3f7e1c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:3e95baa5-d6fc-2f52-84f5-033ba3f7e1c6
msgctxt "h5e12b258g91f8g49f1ga509g4aa7d893c3c8"
msgid "Mr Dekarios. Gale. No."
msgstr "데카리오스 씨. 게일. 안돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 3ee5430c-e2c5-cfaa-c5c6-0bf5e9b6393d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = True
#.      - SCE_Epilogue_State_HasStarted = False
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_ReflectedSuicideMission = False
#.   Tag:
#.      - REALLY_GALE(1) = True
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_ReflectedSuicideMission = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:3ee5430c-e2c5-cfaa-c5c6-0bf5e9b6393d
msgctxt "hbf7dd22ag9f91g4339gb542g7271897bfb11"
msgid ""
"Ah. Mr Dekarios. You seem... different. Better. What's the meaning of this?"
msgstr "아, 데카리오스 씨. 왠지… 달라진 것 같네요. 좋아 보여요. 이유가 뭐죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 3eed0188-de60-d2a0-493b-7e1d595c08ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_Epilogue_State_HasStarted = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:3eed0188-de60-d2a0-493b-7e1d595c08ee
msgctxt "h0333fa9fga62fg4fd0g8353g45bb66a34949"
msgid "Hello, sir."
msgstr "안녕하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 3f8622da-d7ba-dbd2-1bf6-3667c46b2cd4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_PartyHadKarsusNotes = True
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = False
#.   Object:
#.      - LOW_SorcerousSundries_Event_HasKarsusBook(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:3f8622da-d7ba-dbd2-1bf6-3667c46b2cd4
msgctxt "h1a4504d3ge47fg4d7fg9f46g9bdf23303094"
msgid ""
"We had our hands on a book written by Karsus himself. It might've been able "
"to help me."
msgstr "그 카서스 본인이 직접 쓴 책을 손에 넣었어. 책이 나를 도와줄 수도 있었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 4071806d-402a-7240-5113-ac66b34302e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Knows_Bomb = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4071806d-402a-7240-5113-ac66b34302e1
msgctxt "h3844fac4g7ba4g4c65ga55dg9fd114d918b5"
msgid ""
"When you tried to control the Weave - when it all went, pardon my language, "
"belly up - I was terrified."
msgstr "도련님이 위브를 조종하려해서..실례 좀 하겠습니다, 아주 그냥 폭망하셨을때, 저도 무서워 죽는줄 알았다구요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 40c2ac1d-6ec2-f28d-19a8-5a4e489d2606
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:40c2ac1d-6ec2-f28d-19a8-5a4e489d2606
msgctxt "ha3117f17g130eg4784g9cf8gb76077c780b3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 4171a764-6ca8-f8db-8345-b72e6d605431
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4171a764-6ca8-f8db-8345-b72e6d605431
msgctxt "h5a7280eagfa7dg4a2dg8cc7g910655bed6ea"
msgid "So? What led to this decision?"
msgstr "그래서, 왜 이런 선택을 하신 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 436ad844-be99-4f17-2fcf-9ddf5392cf9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:436ad844-be99-4f17-2fcf-9ddf5392cf9f
msgctxt "hf09f4e10gb21ag4a68g9ea2g53f9a093a362"
msgid "Tell me you aren't going to go through with it!"
msgstr "절대 그런 짓은 하지 않을 거라고 약속하세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 4537086e-eb54-3065-c5a9-66aa6d2279d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4537086e-eb54-3065-c5a9-66aa6d2279d0
msgctxt "h8dbab8fcg9b21g4139g87b1gd8fc3622ea7b"
msgid ""
"I'm glad you aren't considering such a ridiculous proposition. You've a good "
"head on your shoulders, Mr Dekarios. No matter what anyone says."
msgstr ""
"그런 터무니없는 제안을 고려하지 않아서 다행이군요. 당신은 분별력이 있는 사람이에요, 데카리오스 씨. 누가 어떻게 말하든지 간에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 45a00013-0b36-7e6b-7bee-b456545ea395
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_PartyHadKarsusNotes = True
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = False
#.   Object:
#.      - LOW_SorcerousSundries_Event_HasKarsusBook(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:45a00013-0b36-7e6b-7bee-b456545ea395
msgctxt "hf04f8543g551cg4b6dga204g9703c71a4312"
msgid ""
"I've got hold of a book written by Karsus himself. It might be able to help "
"me."
msgstr "카서스가 직접 집필한 책을 발견했어. 내게 도움이 될지도 모르겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 46fe718b-af61-07dc-ff35-7abbd9539217
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_Gale_AvatarCrownOfKarsus = True
#.      - ORI_Gale_State_PartyHadKarsusNotes = False
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:46fe718b-af61-07dc-ff35-7abbd9539217
msgctxt "h184b0538gee34g44e2ga93dg8c37dca1bbfe"
msgid ""
"There's a book I need to get from Sorcerous Sundries. To understand the "
"crown I saw atop the elder brain."
msgstr "탑에서 봤던 그 왕관을 이해하기 위해서. 요술 잡화점에서 얻어야 하는 책이 하나 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 472a9747-49bf-fa23-74b9-1bd153241481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:472a9747-49bf-fa23-74b9-1bd153241481
#, fuzzy
msgctxt "hd68d515ag8eebg440egaad7ge92ee0aaf0fe"
msgid ""
"There's not much escapes her sights, that's for certain. But she can hardly "
"have told you this herself. Why so sure?"
msgstr "그 여자의 시야를 벗어나기가 어렵긴 하죠. 그렇다고 당신에게 직접적으로 말한 것도 아닐 텐데, 왜 그렇게 확신하시나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 4956c454-cab0-a2de-193d-57c884cc73ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4956c454-cab0-a2de-193d-57c884cc73ab
msgctxt "he2d65fd3g219ag4d9dga95eg31811b3a8ec9"
msgid "I don't care if she does. She's not my goddess any longer."
msgstr "그렇다 하더라도 상관안해. 그녀는 더 이상 내 여신이 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 4a4e6e81-065f-9475-cc7e-7800261d9654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4a4e6e81-065f-9475-cc7e-7800261d9654
msgctxt "h6b08c32cga424g4c3bgae3dgddf1f4181d3c"
msgid ""
"That's quite all right, sir. Quiet company is more my specialty, anyway."
msgstr "괜찮아요. 사실 조용히 있는 게 제 특기거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 4ad92da3-bd8b-00e6-ef11-048a73cbf378
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4ad92da3-bd8b-00e6-ef11-048a73cbf378
msgctxt "hfeddd963g84a8g419fg990eg794d890ae469"
msgid ""
"But if you've still a warm lap on you when all's said and done, we can still "
"be friends. I suppose."
msgstr "그래도 혹시 변신이 다 끝나셔도 무릎이 여전히 포근하시다면, 친구 정도는 못 될 것도 없겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 4bcefea0-a62d-ae34-e397-dbd0acb19ff3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4bcefea0-a62d-ae34-e397-dbd0acb19ff3
#, fuzzy
msgctxt "h599da142g65a6g45dfg89f6g6c305be2ea30"
msgid "<i>Walk away.</i>"
msgstr "<i>무시하고 지나간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 4cd05386-d481-8a24-2f22-08595f2fd14d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4cd05386-d481-8a24-2f22-08595f2fd14d
msgctxt "h1c4fe252ga448g4077gb5c4g080488e69fb9"
msgid "You should return to Waterdeep now, Tara. It isn't safe here."
msgstr "워터딥으로 돌아가, 타라. 여긴 위험해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 4f394568-fd11-a4b7-6209-7f8cdb249732
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:4f394568-fd11-a4b7-6209-7f8cdb249732
msgctxt "h4dcdc6bdgc833g4f7agbb02g139c2778c6d5"
msgid "I defied Mystra's orders. She's lost to me forever."
msgstr "내가 미스트라의 명령을 거역했거든. 그녀와는 평생 이별이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 50e4df82-37bf-d2ce-2c16-8750b5c5738b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:50e4df82-37bf-d2ce-2c16-8750b5c5738b
msgctxt "habada032g299eg480dg89fdg595a4a887bbd"
msgid "Can we talk?"
msgstr "얘기 좀 할 수 있을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 51d28a20-6cb5-810e-b1f6-1399e0602150
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_Tressym_Event_FlyOff = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:51d28a20-6cb5-810e-b1f6-1399e0602150
msgctxt "hd95a9f78gff7bg4c6egaa63gdb1aa9150ab1"
msgid ""
"There's a fireplace and a half-read book waiting for us in Waterdeep. It's "
"about time we went home."
msgstr "벽난로와 읽다 만 책이 워터딥에서 우리를 기다리고 있어요. 우리가 이제 집에 갈 때가 된 것 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 57eb6082-7fd6-ea3b-5701-a8adcb0eff5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:57eb6082-7fd6-ea3b-5701-a8adcb0eff5d
msgctxt "h4c5ce82fg9221g422bg8313gd6c64c8ff705"
msgid "I promise I'll try."
msgstr "시도해 보겠다고 약속하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 594f3c5d-b9aa-4a0f-9378-9748d239bbed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:594f3c5d-b9aa-4a0f-9378-9748d239bbed
msgctxt "hfa3a6463g04c7g4bfeg99d9gf59ee33e2484"
msgid ""
"So - what's your plan? Why this region? What in particular are you looking "
"for?"
msgstr "그래서 계획이 뭔가요? 왜 이 지역으로 온 거죠? 특별히 찾는 거라도 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 5974218e-6c91-1abc-aee3-ddf2098d4ab7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_RefusedElminsterWYRInformation = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5974218e-6c91-1abc-aee3-ddf2098d4ab7
msgctxt "hceba6eeagd365g496dga524ged29e14cffca"
msgid "Very tough."
msgstr "아주 터프하시네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 5a89025b-cd0c-9e18-e71a-b95e83d2ee8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5a89025b-cd0c-9e18-e71a-b95e83d2ee8e
msgctxt "h9fe18835g2b35g45edgb4d4gb7d2d99b19aa"
msgid ""
"You've got a chance at salvation in front of you. Don't be a fool. <i>Take "
"it</i>."
msgstr "드디어 구원받을 수 있는 기회가 눈앞에 왔다구요. 바보처럼 굴지 말고 <i>받아들이세요</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 5aa6e2cf-2fe4-6986-7ad1-b4603cf7a2e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Tara_KnowsMystraSummons = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5aa6e2cf-2fe4-6986-7ad1-b4603cf7a2e9
msgctxt "hc6d64897g5093g47e7g9760g73407e4b5b82"
msgid ""
"No such luck. He came to summon me on Mystra's behalf. Though I'm not sure "
"it's a summons I want to obey."
msgstr "그럴 리가 없지. 미스트라를 대신해 나를 소환하러 온 거야. 그 부름에 응답할지 말지는 좀 생각해 봐야겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 5b3f4347-cda2-3903-940c-c740dee547f4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Tara_KnowsMystraSummons = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5b3f4347-cda2-3903-940c-c740dee547f4
msgctxt "h29497bfeg6ad1g4b59gaf06g1a16a02e01eb"
msgid "I've been summoned by Mystra. She's willing to speak to me."
msgstr "미스트라가 날 소환했어. 할 말이 있다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 5b77c1af-2156-c4b3-18a3-94c5bb946a3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5b77c1af-2156-c4b3-18a3-94c5bb946a3f
msgctxt "hfea754ccg86f2g43b0g8484g90e229577379"
msgid "I assure you I do."
msgstr "저는 알고 싶은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 5bbade54-08ce-8250-642c-5cfe746c1a86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5bbade54-08ce-8250-642c-5cfe746c1a86
#, fuzzy
msgctxt "h40d67f42gc3bfg468agbc01g86e969bcc057"
msgid "If she has, she could have offered it long before now."
msgstr "만약 그렇더라도, 이렇게 되기 전에 진작 이야기했어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 5c68525f-50cf-78df-2c3c-8c2ca37df3d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5c68525f-50cf-78df-2c3c-8c2ca37df3d1
msgctxt "h7ec9fe8cg6a92g45f7g9586g1fc8085061c4"
msgid "I'm going to need more details, sir."
msgstr "좀 더 자세히 들려주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 5f618546-120a-2e48-a519-d6722dc1db6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:5f618546-120a-2e48-a519-d6722dc1db6d
msgctxt "h069c110ege41cg404cg9825g8ade409f6851"
msgid "Well, out with it then. How did it go?"
msgstr "그럼, 털어놔 보세요. 어떻게 됐나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 610e3698-2ee1-2c12-ed7f-d55434904e0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:610e3698-2ee1-2c12-ed7f-d55434904e0a
msgctxt "hbb017015gc0ddg4915gb998g3a1f3f9fb08a"
msgid "Now go on. We don't want to make a scene, do we? There's a good lad."
msgstr "이제 얼른 가보세요. 난리통을 펼치긴 싫으시잖아요, 안그래요? 착하기도 하셔라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 626fe09e-0fe6-d828-a0f6-c00951787309
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_StormshoreTabernacle_State_HeardMystraQuest = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:626fe09e-0fe6-d828-a0f6-c00951787309
msgctxt "hde37f8fbge3a4g4350gb690g62c3a1bcf29b"
msgid "I didn't stay long enough to find out."
msgstr "그걸 알아낼 만큼 오래있진 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 63ae7ee6-0a76-e249-a42c-7689afa0841e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:63ae7ee6-0a76-e249-a42c-7689afa0841e
msgctxt "h1f097977gf511g4909ga2dbgd72034ae8317"
msgid "I've no need of your approval, Tara. I don't need a cat that badly."
msgstr "네 허락은 필요 없어, 타라. 그렇게까지 고양이가 필요한 건 아니라서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 65b486c9-8b36-c134-38d1-d28e986433c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:65b486c9-8b36-c134-38d1-d28e986433c9
msgctxt "hae0d09d7g1cc3g4499gacf9gf2b6016f22fd"
msgid ""
"If you're that immature, you're not ready for one tenth of Karsus' powers. "
"And I'll play no part in helping you get them."
msgstr ""
"당신의 미숙함으로 보아선, 카서스의 힘 한 조각이라도 손에 넣을 준비가 되지 않았네요. 그리고 전 당신이 그걸 얻도록 돕지도 않을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 66bad05b-9ff7-496f-1882-ab4db4d339c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:66bad05b-9ff7-496f-1882-ab4db4d339c4
msgctxt "haef4dc9dg4981g4a6fg8e60g95fa5068d5c2"
msgid "I'd rather not talk about it."
msgstr "그 이야기는 별로 하고 싶지 않은걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 67b3a5f7-df72-907e-fe27-b90a3d9886de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:67b3a5f7-df72-907e-fe27-b90a3d9886de
msgctxt "h645af5bdg721fg4424g9202g3ae5ca65d512"
msgid "Do I need a reason to be looking well, Tara?"
msgstr "좋아 보이는 데 이유라도 있어야 하는 거야, 타라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 6880954d-3757-d373-889e-bbae1abf579d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:6880954d-3757-d373-889e-bbae1abf579d
msgctxt "he45ae823g3787g4495g903ag8d5a439e801e"
msgid "Absolutely incredible. I can hardly believe it."
msgstr "대단하네요. 믿기가 힘든걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 68e79680-13ec-992b-a7de-3b658b5cbb3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:68e79680-13ec-992b-a7de-3b658b5cbb3b
msgctxt "h8a399765gf116g40b4gbb62gbc31adde9b0e"
msgid ""
"Hear what she has to say. At the very least you'll be better armed to "
"survive what comes next. And that's the most important thing."
msgstr "그녀가 뭐라고 하는지 들어나 보자고요. 적어도 다음에 무슨 일이 벌어질지는 대비할 수 있을 테니까요. 그게 제일 중요하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 6d2214e4-8f74-9708-88b3-70b1ae20dd84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:6d2214e4-8f74-9708-88b3-70b1ae20dd84
#, fuzzy
msgctxt "ha6b812aag2d1ag4297gaf14g5c13c9a3dad5"
msgid ""
"If that's all, then what comes after is for you to decide, Mr Dekarios. "
"Think well on all that's happened, and stay true to that heart of yours. "
"It's a good one."
msgstr ""
"그게 전부라면, 이후의 일들은 데카리오스 씨 스스로 결정해야겠군요. 여태껏 일어났던 모든 일을 잘 생각해 보시고, 자신의 마음이 시키는 "
"대로 하세요. 당신은 좋은 사람이니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 6e341482-f37a-48ad-2149-15f8bf7cf977
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:6e341482-f37a-48ad-2149-15f8bf7cf977
msgctxt "h32bffe13g0dd0g4459g8866gbf2ca8cc5df0"
msgid ""
"Why did she summon you? And how worried do I need to be about what she's "
"asked of you this time?"
msgstr "당신을 왜 소환했대요? 이번엔 또 뭘 시켰을지 정말 걱정되는군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 6f3443ea-a60c-25f9-26bf-5d7c89636063
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = False
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:6f3443ea-a60c-25f9-26bf-5d7c89636063
msgctxt "h4a47df30g55a5g4cd9gb2bbga73c1efdfdf0"
msgid ""
"Unless you've got Mr Dek- erm, <i>Gale</i> in your pocket, I don't believe "
"we have terribly much to say to one another."
msgstr "혹시라도 당신 주머니에서 데..크흠, <i>게일</i>게일 도련님을 쑥 꺼내지 않는 이상, 더 이상 별로 말 섞고싶진않네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 6f4084d7-8efa-9588-e70c-1c940380432f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:6f4084d7-8efa-9588-e70c-1c940380432f
#, fuzzy
msgctxt "h0d979226g516eg4cc0g8f77g8f3a6062e1a8"
msgid "I'm your only old friend, Mr Dekarios. We both know that much."
msgstr "제가 당신의 유일한 오랜 친구죠, 데카리오스 씨. 잘 알면서 그러시네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 7031bdfd-c19f-ffbe-f62d-8e6706b1ef4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7031bdfd-c19f-ffbe-f62d-8e6706b1ef4c
msgctxt "h89e84018gc8b0g4b03g843bge410f69e3393"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7075e05d-ee53-2b5a-1e39-32e6e6d7d7c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7075e05d-ee53-2b5a-1e39-32e6e6d7d7c9
msgctxt "h109076bagae50g4c2cg8c6cg2d03ef0683e2"
msgid "I suppose that's something."
msgstr "아예 안 하는 것보단 나을 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 715a4fce-505c-4ec6-c4bd-3f0b7bdb5b92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:715a4fce-505c-4ec6-c4bd-3f0b7bdb5b92
msgctxt "h85c816ddg0dd0g4783gade9g4fa77eb82ce7"
msgid "Will you still love me when I'm a mind flayer?"
msgstr "만약 내가 마인드 플레이어가 되어도 날 좋아해 줄거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 72ce1969-0001-6acc-dddf-8cb195007287
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:72ce1969-0001-6acc-dddf-8cb195007287
msgctxt "h9f06011ag89a6g487bga4d8g547d9a3cea24"
msgid ""
"Boyish charm and knees that creak like rusted hinges! Quite the combination."
msgstr "소년같은 매력과 녹슨 경첩마냥 삐꺽대는 무릎이라니! 괜찮은 조합이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 731ab839-a9cc-a2d2-00ab-beaa185085f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_WentToAct3 = False
#.      - ORI_Gale_State_SentToFindBook = False
#.      - ORI_Gale_Knows_ReadKarsusNotes = False
#.      - SCE_Epilogue_State_HasStarted = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:731ab839-a9cc-a2d2-00ab-beaa185085f3
msgctxt "h228b2771g02e0g4505g9bb8g580341a87be1"
msgid "Mr Dekarios, sir! Why - you're back!"
msgstr "데카리우스 도련님! 무슨...돌아오셨군요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 731f9512-5f75-a3b8-6016-169249a1ec68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:731f9512-5f75-a3b8-6016-169249a1ec68
msgctxt "hf6ea3f6fg324eg4728g8a9bg3b873109fb66"
msgid ""
"I owe Mystra this. If I have a chance to earn her forgiveness, I have to "
"take it."
msgstr "미스트라에겐 빚을 졌어. 내가 용서를 구할 기회가 있다면, 꼭 잡아야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 736a2f42-172a-e007-f077-6634bf820ad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:736a2f42-172a-e007-f077-6634bf820ad4
msgctxt "h7e454794g7263g489bga342gb4e9ed4964e5"
msgid "I didn't say 'try'. I said 'promise'!"
msgstr "'노력' 이라고 하지 않았어요. '약속' 하시라고 했죠!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 73933c5f-1c0f-d8c6-7c28-1b1141cbe959
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:73933c5f-1c0f-d8c6-7c28-1b1141cbe959
msgctxt "h3003d898g54dag4427g84a2g5e353b297b35"
msgid "Excruciatingly awkward. On my side, at least."
msgstr "극심히 불편하더군. 적어도 나는 그랬지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 73b0c8d7-c1a3-6d4b-cf9e-c6739d14a27f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:73b0c8d7-c1a3-6d4b-cf9e-c6739d14a27f
msgctxt "h68b6ee1dg0046g45ccgad14gc9dceaa84d49"
msgid "Of course."
msgstr "물론."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 74f1e73c-44bc-55bc-7ffd-be863caa646f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:74f1e73c-44bc-55bc-7ffd-be863caa646f
msgctxt "heed4551ag18ccg4f8eg8316g14345f6468db"
msgid ""
"You've got that quite the wrong way around, Mr Dekarios. She has lost "
"<i>you</i>, and is a poorer goddess for it."
msgstr "반대로 알고 계시네요, 데카리오스 님. 여신님이 <i>도련님</i>한테 이별당한거죠, 여신께서 잘못된 선택을 한 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 78449279-6360-e271-954b-4178dd4f6b61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:78449279-6360-e271-954b-4178dd4f6b61
msgctxt "hd399b5a4g90aag4d29g8993g9bcb0a0ba17a"
msgid ""
"It's very unsettling how you can tell what I've been up to just by looking "
"at me..."
msgstr "보기만 해도 뭐 하고 지냈는지 알겠다니, 되게 찝찝한데…"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 7871f48e-f6cd-ded7-c3c4-f04ea361f016
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7871f48e-f6cd-ded7-c3c4-f04ea361f016
msgctxt "h0ef49024g8d0dg4afeg9aacg6ce478ccb2ea"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 78cd28dd-c944-b3c7-f1ce-faee08a72273
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:78cd28dd-c944-b3c7-f1ce-faee08a72273
msgctxt "h32404251gf16dg40f8ga6efg48bcdb066199"
msgid "Oh! Well! That's a better report than I feared."
msgstr "오! 좋아요! 제가 생각했던 것보다 좋은 소식이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 795d900e-652a-fb9d-8f81-8bf19d4ec9ad
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Gale_Tressym_Event_FlyOff = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:795d900e-652a-fb9d-8f81-8bf19d4ec9ad
msgctxt "ha2d463d3gac0cg4d4dga3f5g02512eb38e71"
msgid ""
"I'm well past due to return to Waterdeep. I'm going to tell your mother that "
"you'll be home soon. Don't make a liar of me, darling."
msgstr "워터딥에 돌아갈 때가 됐네요. 어머님께는 곧 집에 올 거라고 전해 드릴게요. 내가 거짓말한 셈 되지 않게 해요, 자기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 797d163f-439f-56a3-f007-117781c8a3ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:797d163f-439f-56a3-f007-117781c8a3ac
#, fuzzy
msgctxt "hd7bf9228g01fdg45deg8494g57f0443d7875"
msgid ""
"Naturally. After you abandoned her, there was only me left to keep her "
"company."
msgstr "당연하죠. 당신이 어머니를 그렇게 내버려 두었으니, 제가 말동무를 해 드릴 수밖에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 799365dd-3df8-2c9b-fb2c-4a6a84b1e468
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:799365dd-3df8-2c9b-fb2c-4a6a84b1e468
msgctxt "h2ad91e10g3f8fg4fd8g8443g63b2ac934256"
msgid "Something like that. Don't worry - it's nothing I can't handle."
msgstr "뭐 비슷한 얘기지. 걱정 마. 내가 해결할 수 없는 일은 없으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 79d8504f-c911-9821-4234-442e44e85873
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:79d8504f-c911-9821-4234-442e44e85873
msgctxt "hd97abc4ag60c4g497bg83afg0d46ebf718a5"
msgid ""
"Attaboy! Keep doing what you're doing, then. We'll have this whole business "
"sorted in no time."
msgstr "장해라! 계속 그렇게만 하시면, 모든 게 마무리 되는 것도 시간문제 일겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7c135424-d114-b5e1-0f3a-030c6cc3443a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7c135424-d114-b5e1-0f3a-030c6cc3443a
msgctxt "h4649673cg87b1g4f6ega4f6g512de856fa23"
msgid "Certainly not."
msgstr "절대 아닙니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7c3c017f-5aa9-53cb-755e-f1cfd21b8c18
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_ReportedHadKarsusNotes = True
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7c3c017f-5aa9-53cb-755e-f1cfd21b8c18
msgctxt "he83a4449g87a8g422bg9720g755b9c42293b"
msgid "Get to it, hmm?"
msgstr "어서 가세요, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7d82a781-f0a7-6dbf-e544-d77143bc544e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7d82a781-f0a7-6dbf-e544-d77143bc544e
msgctxt "h388dbd01g4128g403agae32g285589a77138"
msgid "But then whatever will we talk about?"
msgstr "그럼 이야기 할 게 안 남을 텐데요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 7d8fe742-1f1d-4188-ac0d-43c3fb381cd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7d8fe742-1f1d-4188-ac0d-43c3fb381cd0
msgctxt "h79530717g2bfdg4b8dg9320g9c5b205ddb3d"
msgid "The Absolute has to be stopped. I'm no great loss in the bargain."
msgstr "절대자를 멈춰야만해. 그에 비하면 내 목숨은 별거 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7d980487-50d0-79f3-7518-715604f771fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7d980487-50d0-79f3-7518-715604f771fc
msgctxt "hf4d1a6bdg4ce4g40a7gb6feg5e9c87dc14cc"
msgid "Goodness. How <i>awful </i>that was."
msgstr "맙소사. 그것 참<i>끔찍</i>했겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7ed2c53e-bb1c-6ff7-55c3-9d56a99b1bef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_SentToFindBook = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7ed2c53e-bb1c-6ff7-55c3-9d56a99b1bef
msgctxt "hb6d51f1dg0ab3g4abdgac50ga8c5dac3dac6"
msgid ""
"We <i>are </i>heading to Baldur's Gate, aren't we? You've always been very "
"positive about the selection of books in Sorcerous Sundries. An opportunity "
"for research, perhaps."
msgstr ""
"지금 발더스 게이트로 <i>가시는</i> 중 이신거죠? 도련님은 항상 요술 잡화점의 책들을 굉장히 기대하셨었죠. 찾아볼 좋은 기회일지도 "
"모르겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 7f84f184-077c-1c4d-446e-c93120a0a1b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:7f84f184-077c-1c4d-446e-c93120a0a1b6
msgctxt "hc70bb631g5816g4b50g8be6g449263548930"
msgid ""
"Mystra is a god, Gale. We pay her her due, but not with our lives. Your duty "
"isn't to Mystra. Your duty is to return to Waterdeep. To continue your "
"research, to live your <i>life</i>!"
msgstr ""
"미스트라께선 신 이시잖아요, 게일. 우린 신께 헌신을 바치는 거지 목숨을 바치는 게 아니잖습니까. 도련님의 임무는 워터딥으로 무사히 "
"돌아가셔서 연구를 계속하시고 <i>삶</i>을 이어가시는 거예요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 808a6bdb-b4a7-deb4-723d-a8dae498681d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Tara_State_KnowsAboutTadpole = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:808a6bdb-b4a7-deb4-723d-a8dae498681d
msgctxt "h3ad25bd3g6319g44bega050g690c5f81675f"
msgid "If you think that's bad, just wait 'til you find out what's in my head."
msgstr "지금 내 머릿속에 뭐가 들었는지 알면, 수염 따위 신경 쓰지도 않게 될걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 80a76fc7-dee3-9a72-508f-d9f2238d3494
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:80a76fc7-dee3-9a72-508f-d9f2238d3494
msgctxt "hd1761e98g0e41g4cd9gba66gf08b515305fb"
msgid ""
"Hup hup, sir! Go on and have a read - I'd very much like to know this saga "
"had a happy ending for my favourite fellow."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 81878e45-39b6-03ce-1d23-e996df03b6b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:81878e45-39b6-03ce-1d23-e996df03b6b7
msgctxt "h0ed9318bg8303g46f6ga012g7f7203f0a003"
msgid "Nothing to report."
msgstr "아직 말해줄 만한 건 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 82a93645-2538-7133-7ba2-ca481bfb4f35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:82a93645-2538-7133-7ba2-ca481bfb4f35
msgctxt "h37b588bcgf516g4480gb0f4g7a8deb749014"
msgid "How long do you have?"
msgstr "앞으로 얼마나 남았죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 849c9a88-a0fd-ce54-f338-69eb9a40f6d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:849c9a88-a0fd-ce54-f338-69eb9a40f6d2
msgctxt "hba42c58fgdf8fg4329gb2e8ga365217a1784"
msgid "So. What did Elminster have to say for himself?"
msgstr "그래서, 잘난 엘민스터 님께선 뭐라고 말씀하시던가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 85bc06e5-4e21-5cc7-9105-bff21440a00e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:85bc06e5-4e21-5cc7-9105-bff21440a00e
msgctxt "h725bdc9eg8abeg4364g80a8gd8081e036283"
msgid "Yes."
msgstr "그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 87fdbe4b-57b8-9661-420b-75000a6736c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:87fdbe4b-57b8-9661-420b-75000a6736c2
msgctxt "hd1f0eb55g98f5g48cbg8a59g6078057bb123"
msgid ""
"I bumped into Elminster. I say 'bumped into' - he was waiting for me outside "
"Sorcerous Sundries."
msgstr "엘민스터와 우연히 만났어. 아니, 우연이라고는 할 수 없겠네… 요술 잡화점 바깥에서 나를 기다리고 계시더라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 882ae92e-0c42-72a7-3845-bc959ac1ed40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:882ae92e-0c42-72a7-3845-bc959ac1ed40
msgctxt "hca526c0bg0c16g48b9gb351gc446bd7254a2"
msgid "Ah-ah. I will not be dismissed! Tell me, Gale. What's going on?"
msgstr "어허. 그냥은 안 넘어가요! 말해 봐요, 게일. 무슨 일이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 88c7322d-96d4-f01b-9cc0-e4b3553f1d44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:88c7322d-96d4-f01b-9cc0-e4b3553f1d44
msgctxt "hd8edd91cg6adeg48degb25fg6dba76532174"
msgid ""
"Away with you, then! I have no desire to bear witness to such a distasteful "
"process."
msgstr "그럼 얼른 저리 가세요! 그런 징그러운 과정을 눈에 담고싶은 마음은 없으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 891490a8-90da-5605-8e45-a177943dc69a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_AskedWaterdeep = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:891490a8-90da-5605-8e45-a177943dc69a
msgctxt "h4b94f6eag96a0g4697g82c9ge75f7f6cb5cc"
msgid "How are things back in Waterdeep?"
msgstr "워터딥은 요즘 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 8a8b7a39-d3eb-2221-c384-4214db2f5cab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:8a8b7a39-d3eb-2221-c384-4214db2f5cab
msgctxt "h088b5d2eg272dg4719g98b7gdceb18d4db59"
msgid "What's wrong with my beard?"
msgstr "내 수염이 뭐 어때서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 8b55ddfd-47b0-a895-10e9-923d2dc628ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:8b55ddfd-47b0-a895-10e9-923d2dc628ee
msgctxt "he064ca89gcb53g4785g9770g75488ca726ee"
msgid ""
"Doing what, exactly? Last I checked, that orb is still pulsating inside you, "
"vulgar as ever."
msgstr "정확히 무슨 일이요? 마지막으로 뵜을때도, 보주가 여전히 대놓고 쿵쾅거리고 계셨는데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 8b81ecc6-d5d8-7148-b7a5-e029861956a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:8b81ecc6-d5d8-7148-b7a5-e029861956a8
msgctxt "h463ff689g59cbg4b09g9436g500715294318"
msgid ""
"Finally a task worth completing. Do her this little favour, and she'll have "
"no excuse not to cure that wretched orb of yours."
msgstr "드디어 해낼 만한 가치가 있는 일을 맡았네요. 이걸 해결하면, 미스트라가 당신의 그 끔찍한 보주를 당연히 없애 주겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 8d133a92-80aa-2dcc-a0ac-36bc9bc88c8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:8d133a92-80aa-2dcc-a0ac-36bc9bc88c8e
msgctxt "ha9f79e3fgbad9g4188g99d2g88a0f54612cf"
msgid ""
"I'll be gone with the morning light, sir. Though one last fuss wouldn't go "
"amiss before then."
msgstr "내일 아침까지는 떠나겠습니다, 도련님. 그 전에 한 번 정도는 쓰다듬어주셔도 상관없을거같은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 90c2385c-8461-69e8-0453-06217a530b3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:90c2385c-8461-69e8-0453-06217a530b3e
msgctxt "h8a00e17egc21dg4b70g818dg1f98c6efc1d1"
msgid "You've been visiting my mother?"
msgstr "어머니를 만나 뵌 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 91adfdaf-5d5f-fba6-e8b5-333f9114841d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:91adfdaf-5d5f-fba6-e8b5-333f9114841d
msgctxt "h9db6da11g760ag4736g950cg441eb7cef1e5"
msgid ""
"Indeed. It took me a good long while to find just the one - and an even "
"longer while figuring out how to transport it here."
msgstr "그렇고 말구요. 저도 찾아내는데 한참이나 걸렸답니다, 여기까지 어떻게 옮길지 생각하는 건 더 오래 걸렸구요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 9250544d-7c20-a289-e0b9-aa697c372ce2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9250544d-7c20-a289-e0b9-aa697c372ce2
msgctxt "h60a0ff70g1784g4e67gb282gcdf2d7465c7b"
msgid "Oh. Interesting."
msgstr "오. 흥미로운걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 93c4d909-39bf-dfdd-201a-1bc6ca53c80e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:93c4d909-39bf-dfdd-201a-1bc6ca53c80e
msgctxt "h730d1d1cg4610g44fcg8259g573ed5b2cf3c"
msgid "Oh yes, yes, yes - quite nice."
msgstr "오 좋아,좋아요,좋네요 - 아주 좋았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 93c4d909-39bf-dfdd-201a-1bc6ca53c80e
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:93c4d909-39bf-dfdd-201a-1bc6ca53c80e
msgctxt "h2d57c7e9gdde4g4b85g91cag826c8c76e45e"
msgid "That's the spot, sir - thanking you."
msgstr "바로 거기였어요, 고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 93c4d909-39bf-dfdd-201a-1bc6ca53c80e
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:93c4d909-39bf-dfdd-201a-1bc6ca53c80e
msgctxt "h33db77eeg93e1g426aga53ag01588a00ba55"
msgid "Blessed Mystra, that's lovely."
msgstr "미스트라에게 축복을, 너무 좋군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 93efb611-25b3-f598-c630-8b6a730a4740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:93efb611-25b3-f598-c630-8b6a730a4740
msgctxt "h7c8eabaegb8d9g4696gaf8fg099f23f66957"
msgid ""
"I imagine that's going to be somewhat difficult to retrieve. But you're "
"quite fond of accomplishing difficult feats, aren't you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 95eb4e68-ff26-57ce-9f9b-9efbd989c145
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:95eb4e68-ff26-57ce-9f9b-9efbd989c145
msgctxt "hdbc97ae4gce93g4304g9527g8aa9acba7b41"
msgid ""
"Scared you'd be hurt. Scared Mystra would punish you for your transgression. "
"But do you know what never crossed my mind?"
msgstr ""
"당신이 다치지 않을지 겁났어요. 미스트라가 당신의 죄를 벌할까 봐 두려웠죠.\n"
"하지만 제가 그 와중에 한 번도 걱정하지 않은 게 뭔지 아세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 9606fed8-117b-64a5-d473-bc73e5ada154
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9606fed8-117b-64a5-d473-bc73e5ada154
msgctxt "he37f3816g126bg4a73ga7f0g0703ab983254"
msgid "You're almost at the end of this, Gale. You're nearly there."
msgstr "이제 끝이 보이는군요, 게일. 거의 다 와 가요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 966b131c-d868-0fe7-92f3-69ab17e7be83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:966b131c-d868-0fe7-92f3-69ab17e7be83
msgctxt "h3446d775ge752g4373g85e0gca7856477a3a"
msgid ""
"About time that old book-a-bones showed his face! I've been looking for him -"
" for precisely the reason you outline."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 96db6ea1-2c40-75d3-6bc4-8b3792580ac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:96db6ea1-2c40-75d3-6bc4-8b3792580ac8
#, fuzzy
msgctxt "h80421825g93e5g4a79ga931gc894cd8bf2e9"
msgid ""
"You're going to kill me. And your mother. And then there'll be no one to "
"mourn you when you've wasted yourself for no good reason at all."
msgstr "나를 죽일 작정이군요. 당신의 어머니도요. 이깟 쓸모없는 일로 목숨을 바치고 나면, 애도해 줄 사람이 아무도 남지 않겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 98c7145b-2a30-68d0-7b27-e95f00ff2829
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:98c7145b-2a30-68d0-7b27-e95f00ff2829
msgctxt "h76175a01g1e07g4714g8c04ge2b526154e4e"
msgid "LOUT!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 99217fc9-41d7-ad55-6530-b149f798c702
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:99217fc9-41d7-ad55-6530-b149f798c702
msgctxt "h67423488g0c3eg4888gada6g8f43398aa371"
msgid "I met with Mystra."
msgstr "미스트라를 만났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 99603b21-4c7e-f73b-810b-032dd8cebf8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:99603b21-4c7e-f73b-810b-032dd8cebf8d
msgctxt "h6c307b31g6e03g4a35g944ag73b1f44012ed"
msgid "It went about as well as I expected."
msgstr "예상했던 대로 잘 흘러갔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 9969951e-81a6-66fd-4051-87ea8725310b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Tara_KnowsMystraSummons = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9969951e-81a6-66fd-4051-87ea8725310b
msgctxt "h3da2e36cg9beeg4c0cg9f46g4ee50a8b6cec"
msgid "He came with a message from Mystra. She wants to speak with me."
msgstr "미스트라로부터의 전언을 가지고 왔어. 나와 대화하고 싶다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 9985f3c2-ad3d-3f61-f7ad-a7007efe2420
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Tara_KnowsMystraSummons = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9985f3c2-ad3d-3f61-f7ad-a7007efe2420
#, fuzzy
msgctxt "h7cd25facg3df3g4b9cgac3cg38756ffb5748"
msgid "Mystra wants to see me, though I'm not sure I want to see her."
msgstr "미스트라가 나를 만나길 원한다던데, 솔직히 별로 그러고 싶지는 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 999badc0-a1f6-a9d9-ff98-7a7fda920466
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:999badc0-a1f6-a9d9-ff98-7a7fda920466
msgctxt "hd88a83a3g2880g47d9gab53g7e7eb60352e2"
msgid "I'm honestly not sure. But don't worry - it's nothing I can't handle."
msgstr "솔직히 잘 모르겠어. 하지만 걱정 마. 충분히 해결할 수 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 99b96afa-a2d6-0e2c-2133-750260ff781e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:99b96afa-a2d6-0e2c-2133-750260ff781e
msgctxt "hbf7d68f8g0379g47d7gb37egfb9db93e2225"
msgid "Who are you calling a pet?"
msgstr "애완동물이라니, 누구를 말하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 9a82bd6b-28d1-d5cb-345b-50b5c05293c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9a82bd6b-28d1-d5cb-345b-50b5c05293c4
msgctxt "h8721deb4gc924g4728ga67cge1506264fede"
msgid "I can't make that promise, Tara."
msgstr "그런 약속은 못 하겠어, 타라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 9aba37e3-39dc-708b-6df1-3d16e39c3ac2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9aba37e3-39dc-708b-6df1-3d16e39c3ac2
msgctxt "hbeceae6ag8c8cg4d1cga656g3d52b82c3fb6"
msgid ""
"Surely there's another way. Use your head, Mr Dekarios. It's what you do "
"best."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 9ce75f57-194d-8bce-6709-3db887acebf4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9ce75f57-194d-8bce-6709-3db887acebf4
msgctxt "h24c31aabg6b57g445cg81bfg1033dbaec851"
msgid ""
"I never thought I'd have to convince you to prioritise a trip to a bookshop. "
"Go on, then. Out with you!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 9e2dc3c1-99a9-6aa4-dc22-fe76c25e7986
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9e2dc3c1-99a9-6aa4-dc22-fe76c25e7986
msgctxt "hbd8e6efbga1c2g42e2g8feeg0a56f4b2b7c4"
msgid "You must choose, Gale. And you'll have to do it alone, I'm afraid."
msgstr "당신은 선택해야 해요, 게일. 그리고 유감스럽지만 혼자 해야겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = 9f5267c0-5391-5eb2-cb25-9bc67485b20b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9f5267c0-5391-5eb2-cb25-9bc67485b20b
msgctxt "h550dbb8eg8804g4b23g9192ge50787108766"
msgid ""
"I was... I was quite terrified you wouldn't return. What happened in there?"
msgstr "저는… 저는 당신이 영영 돌아오지 않을까 봐 너무 겁에 질렸었어요. 무슨 일이 있었던 거예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = 9fb5b808-f34f-b792-e7a6-30a4d63e2bb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:9fb5b808-f34f-b792-e7a6-30a4d63e2bb4
msgctxt "hb922573bga36eg45d3ga4b4g877f1a29bb9b"
msgid "I'm afraid you won't like it very much..."
msgstr "미안하지만 별로 마음에 들진 않을거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = a4c22992-6ff7-5a74-3d96-07bf747bba83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a4c22992-6ff7-5a74-3d96-07bf747bba83
#, fuzzy
msgctxt "hd81273degf10cg49c1ga00dgdf8467179a27"
msgid "Do go find out the gossip, won't you?"
msgstr "가서 재미있는 얘깃거리라도 듣고 오세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = a52baaeb-ab6f-0377-5598-cfca415dd2b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BrainHasCrownOfKarsus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a52baaeb-ab6f-0377-5598-cfca415dd2b2
msgctxt "h26d88126g4d3cg41b0g8abcgbee82d4ee8de"
msgid ""
"I discovered I can use the Crown of Karsus - currently atop the elder brain -"
" to save myself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = a52e8758-cd79-082f-cfe7-8337850b5037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a52e8758-cd79-082f-cfe7-8337850b5037
msgctxt "h5d096957g2a20g477bg9ce7ga1fa8a285afd"
msgid "You are to me. Or doesn't my opinion matter?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = a72ca6fd-4985-181c-b5ec-26020f0d19ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a72ca6fd-4985-181c-b5ec-26020f0d19ab
msgctxt "h55adaf59g1019g490cg90acg6ec86a42288b"
msgid "You will tell me what she says, won't you? Of course you will."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = a735c368-577b-b95f-2ede-9200ca3319be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a735c368-577b-b95f-2ede-9200ca3319be
msgctxt "h0e509102g3122g4439g99dagc18b3e703cdf"
msgid "Waterdeep has ten better bookshops on any given street."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = a7b64639-cef7-54a3-dd5e-d76fb716128d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a7b64639-cef7-54a3-dd5e-d76fb716128d
msgctxt "hd976387fg9356g4bd2g98ebg3ea7ae2fce4e"
msgid ""
"And not a moment too soon. Myself, I must away to Waterdeep. Your mother "
"will be worried silly not to have heard from either of us - and now I can "
"bring her the good news."
msgstr ""
"조금 늦은 감이 있었지만요. 저는 이제 워터딥으로 향해야겠어요. 우리 둘 다에게서 연락이 없으면 당신의 어머니가 너무 걱정하실 테니까요. "
"드디어 좋은 소식을 전해드릴 수 있겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = a80b10b3-91c8-1f7d-1f22-422f1bc09fd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a80b10b3-91c8-1f7d-1f22-422f1bc09fd2
msgctxt "hbbd0acadgd100g4b97gaaf3g54614a235cb4"
msgid ""
"A-slinking and a-stalking, of course. This is a fascinating area of the "
"Realms - this cult of the Absolute is taking over like a bad rash."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = a97caa08-54f5-74ac-1443-6abadb4b10ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:a97caa08-54f5-74ac-1443-6abadb4b10ea
msgctxt "h21d4dd88g74aag4f1dg8dd6g33786ed2ca30"
msgid "<i>Give Tara a good scritch.</i>"
msgstr "<i>타라를 부드럽게 긁어준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = acef68ac-da37-3449-3e5b-473481083b8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:acef68ac-da37-3449-3e5b-473481083b8a
msgctxt "h701c6ab6gfbc8g468cgbdf7g33a95bf97816"
msgid "I met our good friend Elminster. He stabilised the orb for me."
msgstr "친애하는 엘민스터를 만났어. 그분이 내 보주를 안정시켜 주셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = ad167799-06e4-b31a-d7e6-281dcec09b15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ad167799-06e4-b31a-d7e6-281dcec09b15
msgctxt "hf458ebedg790ag4c29g8bc8gfbf7c73a76fc"
msgid ""
"Gods! At this rate I'll have to give up the Weave and take up a crossbow. "
"Get the gods out of our business entirely."
msgstr ""
"세상에! 이대로 가다간 위브 다루는 건 때려치우고 쇠뇌나 들고 다니는 게 낫겠어요. 신들은 더 이상 우리 일에 간섭하지 말았으면 하네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = ae8799c9-977b-2028-5cbf-aca7b93ab864
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedAct3Quest = True
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ae8799c9-977b-2028-5cbf-aca7b93ab864
msgctxt "h52f4e638g1da4g484bgbe7cg3a588a6cbdea"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = af71f9f3-df0a-bcd3-6ef5-458dcb607b46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:af71f9f3-df0a-bcd3-6ef5-458dcb607b46
msgctxt "hfc3183a6ge16cg4d36gaeecg15194a300985"
msgid "I miss her too."
msgstr "나도 어머니가 그리워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b04965e0-5b0a-16a2-464d-089eb3c015c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b04965e0-5b0a-16a2-464d-089eb3c015c7
#, fuzzy
msgctxt "h5a1eb09ag9247g48a8g8cfeg7688b31cf3d1"
msgid "Control the orb? <i>Control </i>the brain?"
msgstr "보주를 통제한다고요? 엘더 브레인을 <i>지배하고</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b0667dd4-301f-a9ac-c97e-14adbfdc4598
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_AskedWaterdeep = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b0667dd4-301f-a9ac-c97e-14adbfdc4598
msgctxt "h419bc6e4gaef5g4486gb1e1g2e7dbfa4fefd"
msgid ""
"You focus on that parasite. I daresay turning into a mind flayer may set "
"that bomb off as quick as anything. No time to waste."
msgstr ""
"그 올챙이 문제에만 집중하세요. 마인드 플레이어로 변하게 된다면 아마도 그 폭탄은 순식간에 터지게 될 거예요. 시간을 낭비해선 안 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b210705d-1ac3-2e97-8ca5-09e12cd262d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b210705d-1ac3-2e97-8ca5-09e12cd262d3
msgctxt "h52f61652g3d8fg47e8g8e51g4c67681c2389"
msgid ""
"Don't let that stop you. There's a great deal I don't like, but I haven't "
"keeled over yet."
msgstr "말하던 건 계속하세요. 세상에는 제가 좋아하지 않는 게 산더미같이 많지만, 그것들이 저를 쓰러뜨리진 못한답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b38564b2-4f3e-5186-ef01-b2bb9875e7b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b38564b2-4f3e-5186-ef01-b2bb9875e7b9
#, fuzzy
msgctxt "hbc94dd0fg7e9ag4d44ga1e5g7443720991b9"
msgid ""
"No more pricey artefacts for you then, is that it? Excellent. You were "
"quickly becoming the most expensive pet in the Realms."
msgstr ""
"그러면 이제 더 이상 값비싼 아티팩트는 필요 없겠네요? 완벽해요. 당신은 렐름에서 가장 돈이 많이 드는 애완동물이 될 뻔했거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b45a15ef-e812-63a9-12fa-d349dcd1d8f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b45a15ef-e812-63a9-12fa-d349dcd1d8f8
msgctxt "h58895309g87d7g4b0egb9cbgd6cca50cedd5"
msgid "As am I, Mr Dekarios."
msgstr "저도 마찬가지예요, 데카리오스 씨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = b7c75f38-1a74-a764-9667-fdaa1a37d2f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b7c75f38-1a74-a764-9667-fdaa1a37d2f4
msgctxt "h962d5fd1g952cg42afga0dcg7a491c7aa46b"
msgid "A successful shopping trip, that's all."
msgstr "쇼핑을 즐긴 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = b8ba75e0-d2bd-9d6d-3f82-d72f7ebe96a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b8ba75e0-d2bd-9d6d-3f82-d72f7ebe96a4
msgctxt "hfb181d60g6998g49e5g8463g2588ac34737f"
msgid "I'll try."
msgstr "시도는 해 볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b8f963fa-baf5-e1e5-8407-398031cdf746
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b8f963fa-baf5-e1e5-8407-398031cdf746
#, fuzzy
msgctxt "hbd124f28gd354g400ag9b32g94901e7f3083"
msgid ""
"Depends. Are mind flayers warm-blooded? If so, my prize napping spot on your "
"lap won't be compromised. In which case, I suppose we could find an accord."
msgstr ""
"글쎄요. 마인드 플레이어가 온혈동물이라면, 당신의 무릎 위에서 즐기는 단잠은 계속할 수 있겠네요. 그렇다면 합의점을 찾을 수 있을지도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b9259e54-fcc9-6185-5d8f-ab1b20d61c2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b9259e54-fcc9-6185-5d8f-ab1b20d61c2a
msgctxt "hc364aa34g0a88g4cd7gac3eg5954a19e4ade"
msgid ""
"I'll tell her. With my catflap of displacement, I can afford the occasional "
"visit. I'd bring you along, if I could. Perhaps some day."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = b9d4b848-0ca2-036a-485e-add8f69e3d64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b9d4b848-0ca2-036a-485e-add8f69e3d64
msgctxt "h6a4ad967ge6e5g404cg861fg624997255c07"
msgid "Long enough to find a cure, I hope."
msgstr "치료법을 찾을 수 있을 정도로 오래 남았길 빌어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = b9dbee64-ad88-6a74-4586-ef975cc8e983
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = True
#.      - ORI_Gale_Event_ReadElminsterLetter = True
#.      - SCE_Epilogue_State_HasStarted = False
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_ReflectedSuicideMission = True
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:b9dbee64-ad88-6a74-4586-ef975cc8e983
msgctxt "he65ff6bdg537eg4b2bgb63bg8edf76862893"
msgid ""
"You will find a better solution to this whole 'Absolute' business, won't "
"you? I'm always bragging about your ingenuity and I'd hate to be thought a "
"liar."
msgstr ""
"이 '절대자' 놈들에 대한 더 좋은 해결책을 찾으실 거라 믿어요. 전 항상 당신의 독창성을 자랑하고 다녔는데, 다른 이들이 저를 "
"거짓말쟁이라고 생각하지 않았으면 하네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = bb16f0aa-3546-dd8a-48e6-34076a8e5c1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:bb16f0aa-3546-dd8a-48e6-34076a8e5c1e
msgctxt "h10708313g0daag4126gb827g3acd21cdf7ea"
msgid "<i>Give Tara a fuss.</i>"
msgstr "<i>타라를 쓰다듬는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = bc976bfa-2e8e-fe19-b3fe-57b451fadbc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:bc976bfa-2e8e-fe19-b3fe-57b451fadbc1
msgctxt "h10b54ac4g1700g428cg8794g2adca3f1d7aa"
msgid ""
"Anyhow - I'm keeping my senses pricked for any sign of another item that "
"might be of use to you. Hopefully something will turn up soon."
msgstr "어쨌든, 당신에게 필요한 다른 아이템들이 있을지 신경을 곤두세워야겠어요. 금방 발견해 내길 바라야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = be099e1f-2a47-8a49-72b5-e7bca5078c98
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:be099e1f-2a47-8a49-72b5-e7bca5078c98
msgctxt "ha7ebfc3agaaf3g4e71g96e1gd306501189f9"
msgid ""
"And if you can't find what you're looking for in Sorcerous Sundries, I'll go "
"check them all. But for now - get on with it!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = be8a84d8-c65d-14f4-2876-0f08699318fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:be8a84d8-c65d-14f4-2876-0f08699318fb
msgctxt "hc52021e9g726dg4c8bg989cgf5833540c649"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = bf6de6ea-8ebe-0354-6367-5943d1beb7d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:bf6de6ea-8ebe-0354-6367-5943d1beb7d9
msgctxt "hd1a4f212gdf71g4921gb549g3812a145803d"
msgid "Oh, I always knew Mystra had a good heart. Deep, deep down."
msgstr "아, 저는 항상 미스트라에게도 선한 마음이 있다는 걸 알았어요. 아주 밑바닥에 있는 것 같지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c062db05-784d-a991-652f-32fc66447c6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c062db05-784d-a991-652f-32fc66447c6f
msgctxt "hd3e80352g2733g469bgad9egebc55394747b"
msgid ""
"For now, I'm terribly glad you're all right. If I'd lost you to a giant "
"brain, the irony would have been intolerable."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c0d36d7b-f647-fa15-71ab-c8e0cc38d481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c0d36d7b-f647-fa15-71ab-c8e0cc38d481
msgctxt "hd4636d58ga1f7g4811g97d9g8d8ba027f865"
msgid ""
"More or less the same - though news of some mad faction calling themselves "
"'Absolutists' is starting to trickle in."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c197040c-91e6-cf71-ebe6-5015973e6a9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = True
#.      - ORI_Gale_Tara_KnowsMystraSummons = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c197040c-91e6-cf71-ebe6-5015973e6a9d
msgctxt "h19f3ef25g2cbdg4e94g836ag474f45ad675a"
msgid ""
"Come now, don't keep me in suspense. How was your reunion with the Mother of "
"All Magic?"
msgstr "자, 저를 더 이상 긴장하게 만들지 마세요. 모든 마법의 어머니와의 만남은 어땠나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c1da1fa0-7a4c-31e4-8e95-a6ada5377cb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c1da1fa0-7a4c-31e4-8e95-a6ada5377cb3
msgctxt "hd79a047cg0871g45e5gafa1g58cf3a825a1c"
msgid ""
"If something's happened that I should know about, I'd rather you were honest "
"with me. We are in this together, aren't we?"
msgstr "제가 알아야 하는 일이 생기면, 솔직하게 말해줬으면 해요. 우리는 한배를 탄 사이잖아요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c26da5eb-4057-f64f-ffa5-312195a67e18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c26da5eb-4057-f64f-ffa5-312195a67e18
msgctxt "h7e603e0egb4bfg44f3gb0d7g982591bec81e"
msgid "Whatever do you mean?"
msgstr "무슨 뜻이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c401a723-efd5-2f5a-eaec-cc36c3a18a5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c401a723-efd5-2f5a-eaec-cc36c3a18a5b
msgctxt "h8c944134gc145g41e3g9ec2g9d13715f8246"
msgid ""
"Karsus' powers should have perished with him. You <i>cannot</i> trust such "
"powers. You know better than this, don't you?"
msgstr "카서스의 힘은 그와 함께 사라졌어야 해요. 그런 힘을 믿어서는 <i>안 된다고요</i>. 잘 알고 계시지 않나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = c64180dd-f708-1ef0-25af-11bd1cccd229
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c64180dd-f708-1ef0-25af-11bd1cccd229
#, fuzzy
msgctxt "h167ec925gaee6g4588g9175g78f69f9cec84"
msgid "Surely we have more important things to discuss, Tara."
msgstr "더 중요한 이야기가 있어, 타라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c6948963-63bd-db85-0b65-d5352acfa24b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = True
#.      - ORI_Gale_Tara_KnowsMystraSummons = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c6948963-63bd-db85-0b65-d5352acfa24b
msgctxt "hdc164c6eg046eg42bdga306gb4b9e93d190f"
msgid "What is it, Mr Dekarios? You look like you've seen a ghost."
msgstr "무슨 일이죠, 데카리오스 씨? 유령이라도 본 것 같은 얼굴인데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c69fae10-f59a-89d1-3360-e0e1375b0057
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c69fae10-f59a-89d1-3360-e0e1375b0057
msgctxt "h98269375g9bd5g4cd9g83e4g0a4c01d7fb6f"
msgid "Then again... perhaps she's got something useful to say, for once."
msgstr "그렇지만… 이번에는 뭔가 도움이 되는 말을 해줄지도 모르잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = c88a22ad-05a9-f2cc-0cd3-dbaed44ee742
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = False
#.      - ORI_Gale_State_GotOneMagicItem = False
#.      - SCE_Epilogue_State_HasStarted = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:c88a22ad-05a9-f2cc-0cd3-dbaed44ee742
msgctxt "h35965560g65b9g40fbg818ag4e6708a22445"
msgid ""
"Not another word out of you 'til you've consumed that artefact, Mr Dekarios."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = cbe7b2c7-d35d-8999-3277-8c261a99a00c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:cbe7b2c7-d35d-8999-3277-8c261a99a00c
#, fuzzy
msgctxt "h1a8bbe77g691ag49cfga861g7bae0902e407"
msgid "She just wanted to clear the air between us."
msgstr "그냥 우리 사이의 오해를 좀 풀고 싶었나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = cc7a4cca-480e-63f0-6902-896a8959ee67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:cc7a4cca-480e-63f0-6902-896a8959ee67
msgctxt "h914c91bcg7364g48c8g95e4g792ed0d14170"
msgid "I'd never want to lose you, Tara. I'll return the Crown to Mystra."
msgstr "널 잃고 싶지는 않아, 타라. 미스트라에게 왕관을 돌려줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = cc8bf3cf-7e17-91a3-d953-5365e1e115b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:cc8bf3cf-7e17-91a3-d953-5365e1e115b3
msgctxt "h239f28a9gf573g4262g81d7ga9601373083b"
msgid ""
"Or maybe she'd just say something like, 'My Gale always was one to make the "
"impossible possible.' Oh, but she adores you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = cdac339f-cdd8-fdbc-7a3e-f46f5ebc1b4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:cdac339f-cdd8-fdbc-7a3e-f46f5ebc1b4f
msgctxt "h1d1a2f96gabd9g4954gbdc2ga6173bcc773a"
msgid "I think so."
msgstr "그래야 할 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = cdd1eefe-3901-1f45-f321-5ba8f43b1575
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_StormshoreTabernacle_State_WantsSurrenderCrown = True
#.      - LOW_StormshoreTabernacle_State_HeardMystraQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:cdd1eefe-3901-1f45-f321-5ba8f43b1575
msgctxt "h0ff638fbg3a59g4983g9d63gcd305df6b80b"
msgid ""
"She wants me to bring the Crown of Karsus to her when the elder brain is "
"defeated. She said she can cure the orb."
msgstr "엘더 브레인을 물리치고 나면 카서스의 왕관을 가져오라고 하더군. 그러면 내 보주를 없앨 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = ce0aace9-9adf-a68e-3ac3-1e664791293b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ce0aace9-9adf-a68e-3ac3-1e664791293b
msgctxt "ha0031e9dg56cfg48daga2dag13dd0a9bb091"
msgid "Not on my life."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = ce1320bd-08e2-9d57-f4c1-d823ba9f5766
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ce1320bd-08e2-9d57-f4c1-d823ba9f5766
msgctxt "h6098a777g472bg4419g822bg3be1954dcb31"
msgid ""
"Now Mr Dekarios - you know I'm as cynical about Mystra's recent behaviour as "
"the next tressym, but if she's reached out to you like this, it must be "
"important."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = ce5e407a-bb16-085a-6795-d82261168880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ce5e407a-bb16-085a-6795-d82261168880
msgctxt "hed0fe533g979eg4bb0ga90bg51f736443739"
msgid ""
"Please tell me you've at least made inroads when it comes to finding someone "
"to settle down with. Myself and Mrs Dekarios are starting to think you "
"intend to die alone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = cecfbeeb-984d-5a1c-2ab7-33fede7d7369
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:cecfbeeb-984d-5a1c-2ab7-33fede7d7369
msgctxt "he4c51d25g5905g4e84ga2ceg969a7e0b3091"
msgid ""
"Well then. No sense delaying a conversation like that. Who knows when she'll "
"next demand you blow yourself up, after all?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d08b510a-7a9c-c523-6ffd-19cb2edc57af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = False
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d08b510a-7a9c-c523-6ffd-19cb2edc57af
msgctxt "h40f9e1a8g5eefg4eb7gbfcegbaf69bb497de"
msgid "Erm. Meow."
msgstr "음. 야옹."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d2578c79-4d0e-8b35-4ca9-c36b1606ef77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d2578c79-4d0e-8b35-4ca9-c36b1606ef77
msgctxt "hb19b85b0g890ag4a70gb6bfg34a32e3925cf"
msgid "I need a moment, please."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d36df3eb-f993-1084-547b-2f7150657f4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d36df3eb-f993-1084-547b-2f7150657f4f
msgctxt "h91c3749eg433eg4249ga8d1g67140c1c33bc"
msgid "A <i>cat?</i>"
msgstr "<i>고양이?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d3ad57e9-ece9-6dd2-3dbb-a72a728eef32
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d3ad57e9-ece9-6dd2-3dbb-a72a728eef32
msgctxt "hd3c2c85aga7bbg4e43g81ddg6492821b9914"
msgid ""
"Search carefully, sir. The good things are usually either behind glass, or "
"buried under a stack of loathsome picture papers."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d3d78ed7-9778-02ac-41cc-1d5f81f36ea0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d3d78ed7-9778-02ac-41cc-1d5f81f36ea0
msgctxt "hc85f6933gf98fg48f5g860cg6cf3f1f058fd"
msgid "And why would you, after what she's asked of you?"
msgstr "그런 부탁을 받은 뒤인데, 만나고 싶을 리가 없겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d4b58fb2-fbb7-d60a-13d4-a1cde9193122
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d4b58fb2-fbb7-d60a-13d4-a1cde9193122
#, fuzzy
msgctxt "h8027a9c2gae9dg4535gb5fcgc87722278900"
msgid ""
"Well, you know the gods. When they indulge in a bit of divine intervention, "
"they do so like to <i>pick their moments</i>. Us mere mortals have no choice "
"but to go along for the ride."
msgstr ""
"신들이 어떤지 아시잖아요. 신성한 중재를 할 때는 <i>적당한 시기</i>를 고르는 걸 좋아하죠. 우리 필멸자들은 그 장단에 춤출 수밖에 "
"없고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d52fabb3-e3c3-5594-0a91-2b42ff1e724d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Tara_State_KnowsAboutTadpole = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d52fabb3-e3c3-5594-0a91-2b42ff1e724d
msgctxt "h6582d1ffg93b6g49a8gb25bg7c3f8f51fd16"
msgid "Oh. Well. That is... hm."
msgstr "아, 그래요. 그건… 흠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d5a7aa81-10d9-ad11-426f-684b790776c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d5a7aa81-10d9-ad11-426f-684b790776c9
msgctxt "h216ddb87g0e73g44b2g9729g63d0c3172f03"
msgid "Always."
msgstr "언제든지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d7fffabc-f49c-92dc-3bf9-323a1a79ddd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d7fffabc-f49c-92dc-3bf9-323a1a79ddd2
msgctxt "h4b1b965dg0c2ag4b18g9c0fgea8681769f7b"
msgid ""
"That sounds like a path well worth the walking! And I shall trot along right "
"beside you. Or flutter. It really depends on the terrain."
msgstr ""
"그 길이란 건 참으로 걸을 만한 가치가 있어 보이네요! 그리고 전 당신의 곁에서 함께 걸을게요. 아니면 날아가든가. 길 상태를 보고 "
"결정해야겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = d805cce5-abbd-da63-6d98-cdfd4f568603
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d805cce5-abbd-da63-6d98-cdfd4f568603
msgctxt "hf8d41584g7edeg4890g9b53g4f4a8db002a0"
msgid ""
"She's very good company, though. Ah, the stories we've traded over toast and "
"tea. You're a highly entertaining source of speculation."
msgstr ""
"어머니와 저는 아주 좋은 친구지만요. 아, 빵과 차를 나누며 했던 이야기들이 기억나네요. 우린 당신에 대해 재미있는 추측을 많이 나눴죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = d9b7e572-2a86-0298-d984-c035f2de0460
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_StormshoreTabernacle_State_HeardMystraQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:d9b7e572-2a86-0298-d984-c035f2de0460
msgctxt "hd8101a7dge9b2g4eb7gbcdag19561c4d973f"
msgid ""
"She offered me a path to forgiveness. One I have a far better chance of "
"surviving."
msgstr "용서받을 수 있는 길을 제시해 주더군. 내가 살아남을 가능성이 훨씬 높은 방법이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = da259c4d-0e1e-007e-f06d-2c4ca131c8c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:da259c4d-0e1e-007e-f06d-2c4ca131c8c6
msgctxt "h8cfc4c27g919dg4ed6gbcc2g0a8154c4c3d4"
msgid ""
"I told your mother not to worry. That if they were anything to worry about, "
"Baldur's Gate would handle things quick-sharp. Keep them from spreading "
"their tendrils north."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = db9461fa-a7c1-29be-5e43-27c96d8a98f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:db9461fa-a7c1-29be-5e43-27c96d8a98f4
msgctxt "hdac13831gfc7dg481ag9f96gdff56a57075c"
msgid "Just a gut feeling, I suppose. Nothing I can't handle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = dc7e705c-111c-a0f1-166b-29b7e2f8b38e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:dc7e705c-111c-a0f1-166b-29b7e2f8b38e
msgctxt "h426e9602g0d9ag4448ga978gda3deb7840b7"
msgid "<i>DAYS?! </i>Mystra preserve us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = dca60451-9aac-ec8a-5e1c-35a65b3d6faa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:dca60451-9aac-ec8a-5e1c-35a65b3d6faa
msgctxt "hfdbc33f7g9997g4cc0g81edgfe1f8ed8dac2"
msgid "There's a good humanoid. You had me scared for a moment here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = dcae1677-5c17-aa31-87e6-b82e85946f05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:dcae1677-5c17-aa31-87e6-b82e85946f05
msgctxt "hfb9fabceg2873g4083ga95dge541d332bae4"
msgid ""
"Chin up and keep at it, sir. And don't forget to pet your favourite tressym "
"for good luck."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = dcf07be2-cd69-a698-43c7-f30ab349016a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:dcf07be2-cd69-a698-43c7-f30ab349016a
msgctxt "h2021883cgf36dg4f8bga603g5032a13f443b"
msgid "Don't worry. It's nothing I can't hande."
msgstr "걱정하지 마. 내가 해결할 수 없는 일은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = ddd8a672-41b3-b6c6-8ac2-7a15d0428a6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ddd8a672-41b3-b6c6-8ac2-7a15d0428a6a
msgctxt "h1f263ba9geb29g4ef8gadcfg016f2c5daf24"
msgid ""
"You get all your best ideas from books, don't you, sir? Your worst ones, "
"too... but it's worth the risk."
msgstr "당신은 책에서 가장 좋은 생각들을 얻곤 하잖아요? 최악의 생각도 거기서 나오긴 하지만… 해볼 만한 가치는 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = dea9c569-cc29-407d-3f9f-7f53c5a1d8fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_KarsiteWeave = False
#.      - ORI_Gale_Tara_KnowsMystraSummons = True
#.      - ORI_Gale_State_Met_ElminsterInWYR = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:dea9c569-cc29-407d-3f9f-7f53c5a1d8fe
#, fuzzy
msgctxt "h50b945e8gdf22g495agac2fg81843f51a5f3"
msgid ""
"Do hurry up and speak with Mystra, won't you? Curiosity might kill cats, but "
"I assure you tardiness <i>torments </i>the tressym."
msgstr ""
"서둘러서 미스트라와 대화하면 안 될까요? 호기심이 고양이를 죽인다고들 하지만, 꾸물대는 건 트레심을 <i>학대하는</i> 거라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = e02a896d-9c79-f6fe-7cf0-4b6360f354a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e02a896d-9c79-f6fe-7cf0-4b6360f354a9
msgctxt "h2772b2b9gafe6g4d30g8e95g3dd96f70ffe3"
msgid "Ghastly boy. But fine. I'll take what I'm given and be grateful for it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = e037b028-2f3d-ff75-e42d-ffdb3ab8bba7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e037b028-2f3d-ff75-e42d-ffdb3ab8bba7
msgctxt "hb3452c46g3798g4f31g8777ge08dcaf5290b"
msgid ""
"I can look after myself. And you, while I'm at it. But what's wrong, Gale? "
"There's something on your mind. Out with it."
msgstr ""
"저는 제가 알아서 챙길 수 있어요. 당신도 돌봐줄 수 있고요. 그런데 무슨 일이에요, 게일? 뭔가 마음에 걸리는 게 있다면 털어놔 보세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = e12c428e-cfe6-2a84-4086-3fc89187ecb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e12c428e-cfe6-2a84-4086-3fc89187ecb4
msgctxt "hb57e0ae8ge7d3g49d7ga64cg59ef2a092c59"
msgid "You're right. I should hear her out."
msgstr "네 말이 맞아. 대화는 해봐야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = e20e39cc-4124-6ed7-ae05-34ad5916938d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_StormshoreTabernacle_State_GaleChallengesMystra = False
#.      - LOW_StormshoreTabernacle_State_HeardMystraQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e20e39cc-4124-6ed7-ae05-34ad5916938d
msgctxt "h88edfc4ag44e3g4a2ag8dfbgd88a94c41061"
msgid ""
"She told me the orb is actually the Karsite Weave. When I seize the Crown of "
"Karsus, I'll be able to control it at last. I'll be a god."
msgstr ""
"내가 갖고 있는 보주가 카서스의 위브라고 하더군. 카서스의 왕관을 손에 넣으면, 난 그걸 지배할 수 있을 거야. 내가 신이 되는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = e27f4099-2c05-4c41-ba87-bdfcdf3bc8d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e27f4099-2c05-4c41-ba87-bdfcdf3bc8d9
msgctxt "h5a76fa7ag14f9g4181gabe6g76ca6776d5c4"
msgid ""
"The truth is a bit shocking. I was kidnapped by mind flayers, infected with "
"a parasite, and left here after their ship crashed. Now I'm looking for a "
"cure."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = e2977b60-30d9-4d4e-1502-bad521c56460
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_StormshoreTabernacle_State_WantsSurrenderCrown = False
#.      - LOW_StormshoreTabernacle_State_HeardMystraQuest = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e2977b60-30d9-4d4e-1502-bad521c56460
msgctxt "h743ba1b2g01ecg4b1eg8dd7gd9fd8b732f77"
msgid ""
"She wants me to bring the Crown of Karsus to her when the elder brain is "
"defeated."
msgstr "엘더 브레인을 물리치고 나면 카서스의 왕관을 가져오라고 하더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = e59bbbbd-2e41-825d-8534-7bd9459191a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e59bbbbd-2e41-825d-8534-7bd9459191a5
msgctxt "h874b43edgcebfg4f80g8a08gd1c3a8079146"
msgid "If anyone can beat this thing, <i>it is you</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = e5a61f25-4e04-d2b7-4de1-6e09958165d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e5a61f25-4e04-d2b7-4de1-6e09958165d0
msgctxt "h24f1ebd5g5bddg4c94ga83agc5c9aa7a6f84"
msgid "There's more to it than that, I'm afraid. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = e6a464b5-9a24-07e4-f8a8-62ed3e8f2ea9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e6a464b5-9a24-07e4-f8a8-62ed3e8f2ea9
msgctxt "hfdba6cf6g0180g4efdgbd7ag412448f05f76"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = e6d9e2a0-9436-9082-858a-92a12b33751b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e6d9e2a0-9436-9082-858a-92a12b33751b
msgctxt "ha87cefdcg1b93g486fg9e73gb17500193861"
msgid ""
"About many things, actually. You left the tower in such a hurry, and you "
"didn't leave an address."
msgstr "사실 들어야 할 이야기가 너무 많아요. 그렇게 급하게 떠나면서 행선지 하나 남기지 않았잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = e7d0d831-ecbb-34c4-91d5-d0367679f03d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:e7d0d831-ecbb-34c4-91d5-d0367679f03d
msgctxt "h44bc366fga38fg4bf3gb4bag1bde755a45e4"
msgid "Tell me, Tara. What have you been up to in my absence?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = eb1a0955-2aad-e316-379c-4e0283a1906f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_ReadKarsusNotes = False
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_MadAtGale(-1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:eb1a0955-2aad-e316-379c-4e0283a1906f
msgctxt "hdbdea8a1g4ab1g4badga459gbf0d8dbee775"
msgid ""
"What's that? For a moment I thought my friend Mr Dekarios was near, but now "
"I see it's only the ghost of one of Mystra's playthings."
msgstr "방금 뭐였죠? 잠시 나의 친구 데카리오스 씨가 근처에 있다고 생각했는데. 다시 살펴보니 미스트라의 버려진 장난감밖에 안 보여요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = eb9a3d8e-9072-850a-64f0-5720eb4d1438
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:eb9a3d8e-9072-850a-64f0-5720eb4d1438
msgctxt "hceb295b3g0121g4748gbd5agb51f82bd9489"
msgid ""
"Nothing to concern yourself with. Just passing on an invitation from an old "
"friend."
msgstr "걱정할 필요 없어. 그냥 옛 친구의 초대를 전달하러 오셨던 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = ebbe26e5-b524-6cc8-d460-0e01ddb9703a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ebbe26e5-b524-6cc8-d460-0e01ddb9703a
msgctxt "h2a2899d5g94a9g415eg8052ge0ed469d4eca"
msgid "I can't risk putting her in danger."
msgstr "어머니를 위험에 처하게 할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = ed988b76-c129-e2cf-65f9-0415d82c7d4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ed988b76-c129-e2cf-65f9-0415d82c7d4c
msgctxt "h2f841c5dg22d0g4f4agafa6g37183714f309"
msgid ""
"I found the book I needed in Sorcerous Sundries. And I'm fairly positive "
"Mystra knows about it."
msgstr "요술 잡화점에서 내가 원하던 책을 찾았어. 그리고 미스트라가 그 사실을 아는 게 확실해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = edd9bf12-550b-cfeb-dbef-1c1dfa181b9f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_State_SentToFindBook = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:edd9bf12-550b-cfeb-dbef-1c1dfa181b9f
msgctxt "h2ab5431agb1d6g4d16g875dg7033a2cb244f"
msgid ""
"We're heading to Baldur's Gate, aren't we? You've always been very positive "
"about the selection of books in Sorcerous Sundries. An opportunity for "
"research, perhaps."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = ee4ed867-77db-a6d7-2901-cb17a9f881d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedAct3Quest = True
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedBombAndBrain = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ee4ed867-77db-a6d7-2901-cb17a9f881d2
msgctxt "hc72b8e5ag6ba7g4d8ega366ga0aad909a0d4"
msgid "Shoo then, Mr Dekarios. That crown isn't going to retrieve itself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = ef44b6dd-0afa-cfc8-7c2a-5dbf670e5bb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ef44b6dd-0afa-cfc8-7c2a-5dbf670e5bb2
#, fuzzy
msgctxt "hc3d6230cgf8f4g4779g8f5bg7b0f4ead593f"
msgid "I was abducted on a nautiloid and infected with an illithid parasite."
msgstr "노틸로이드에 납치됐었고, 거기서 일리시드 기생충에 감염되었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = f0435756-bb72-6ee2-2e6e-29895672ad9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f0435756-bb72-6ee2-2e6e-29895672ad9d
msgctxt "h60511ba6g4223g4621ga3d6g58dd9f45b7d2"
msgid "I promise."
msgstr "약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f27e3b43-ccbc-4934-7b30-35115043620c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f27e3b43-ccbc-4934-7b30-35115043620c
msgctxt "hfabc0ecegf40ag4dcdg8873g946ded931589"
msgid "You'll do what she says, won't you?"
msgstr "그 여자가 시킨 대로 할 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f310115b-446d-3877-1821-897a9839dda3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f310115b-446d-3877-1821-897a9839dda3
#, fuzzy
msgctxt "h95a7971cgf2d5g40e7g9025ga8587228671d"
msgid ""
"I'll have to make up some good news for your dear mother, then. I'm going "
"home, Gale. To look after Mrs Dekarios, and to remind you that there are "
"people waiting for you in Waterdeep."
msgstr ""
"그럼, 당신의 어머니께 좋은 소식이라도 전해드려야겠네요. 전 집으로 돌아갈 거예요, 게일. 데카리오스 부인도 돌봐드려야 하고, 워터딥에서 "
"당신을 기다리는 사람들이 있다는 걸 잊지 않았으면 해서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f3a80dbe-5b50-59f1-8d0f-a2278dcee072
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Event_BombDisarmed = False
#.      - SCE_Epilogue_State_HasStarted = False
#.   Object:
#.      - CAMP_Gale_Tressym_FirstSpeech(1) = False
#.   Tag:
#.      - REALLY_GALE(1) = True
#.      - GALE(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Gale_Tressym_FirstSpeech(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f3a80dbe-5b50-59f1-8d0f-a2278dcee072
msgctxt "h1e22405agb815g4f3dgaf2cg73059a4f8877"
msgid "Oh, thank the heavens! The barbarous beard has been slain at last!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = f46cbca6-be31-6bda-fafe-084f2a7a6c4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f46cbca6-be31-6bda-fafe-084f2a7a6c4c
msgctxt "hc4b0d9eeg7800g4f33gbe1egd64b0a8b2320"
msgid "On second thoughts, never mind."
msgstr "재고해 보니, 네가 신경 쓸 일은 아닌 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f550d0fa-0f87-9362-3f1d-12e7c89b0a09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Elminster_Event_WentToCamp = True
#.      - ORI_Gale_Knows_ReadKarsusNotes = True
#.      - GLO_Elminster_State_Defeated = False
#.      - ORI_Gale_State_Met_ElminsterInWYR = False
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedElminsterWYR = False
#. SetFlags:
#.   Local:
#.     - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedElminsterWYR = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f550d0fa-0f87-9362-3f1d-12e7c89b0a09
msgctxt "h04c0fff7gbc28g418fgbc57gde7be52f43f2"
msgid ""
"Much as I enjoy our little chats, Mr Dekarios, I think it's Elminster you "
"must speak to."
msgstr "데카리오스 씨, 저랑 이야기하는 것도 좋지만 지금은 엘민스터와 빨리 대화해야 할 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f581c4a6-01cb-fa2f-ed45-57e31b7b2497
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f581c4a6-01cb-fa2f-ed45-57e31b7b2497
msgctxt "h070162e1g1d4fg4f2agbbf2g57b8c8a08f89"
msgid ""
"And, of course, your mother would still think you a prince, no matter how "
"many tentacles you had. And with a nautiloid, you may even manage to visit "
"her more often."
msgstr ""
"그리고 물론, 촉수가 몇 개가 돋아나오든 간에 어머니는 여전히 당신을 왕자라고 생각하시겠죠. 노틸로이드가 있다면 어머니를 좀 더 자주 "
"찾아뵐 수도 있겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = f7b2a659-5e8d-4271-049b-4a811a747bd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f7b2a659-5e8d-4271-049b-4a811a747bd6
msgctxt "h1bc7910cg43a1g4e6eg9e47g871558c8cb28"
msgid "I'll consider what you've said. But I'm not making any promises."
msgstr "네 말에 대해서는 생각해 볼게. 하지만 약속은 할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f8537078-7175-e753-ac63-6dcb23b0e38f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f8537078-7175-e753-ac63-6dcb23b0e38f
msgctxt "h345f677dg8781g4cc9g822egdc4f7c7a969c"
msgid ""
"Thank heavens! I thought I was going to have to claw some sense into you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f8ff4e0f-0739-8f42-a53f-a8bbf37f5c5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f8ff4e0f-0739-8f42-a53f-a8bbf37f5c5d
#, fuzzy
msgctxt "h7055598dga4bbg4a5ega22eg207364ab9edd"
msgid ""
"Tressyms are exceptionally intuitive. And also, you wear your emotions like "
"a very garish cravat."
msgstr "트레심들은 직관이 뛰어나거든요. 그리고 당신은 감정을 잘 숨기지 못하는 편이기도 하고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f914616c-bf81-fe0c-a979-511acdd61157
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f914616c-bf81-fe0c-a979-511acdd61157
msgctxt "h74d13a2egd87ag447eg9629g099725b17aeb"
msgid ""
"Promise me, Gale. Promise me you'll find another way. Promise me you'll "
"return home, when this is all over."
msgstr "약속해요, 게일. 다른 방법을 찾아내겠다고 약속하세요. 이 모든 게 끝나면, 집으로 돌아올 거라고 약속해 줘요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = f91e1a9d-f310-3e58-9fd3-675798cfa0be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Elminster_Event_WentToCamp = True
#.      - ORI_Gale_Knows_ReadKarsusNotes = True
#.      - GLO_Elminster_State_Defeated = False
#.      - ORI_Gale_State_Met_ElminsterInWYR = False
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_DiscussedElminsterWYR = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f91e1a9d-f310-3e58-9fd3-675798cfa0be
msgctxt "hb786b62bgd56fg4cafg8b60g06070e938559"
msgid "Shoo, now! Off to see Elminster with you."
msgstr "쉬잇, 빨리요! 엘민스터를 만나러 가자고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = f98d74fe-028e-5f47-6a42-ce7a41facec9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:f98d74fe-028e-5f47-6a42-ce7a41facec9
msgctxt "hcd4e1827g180bg4157g9bccg112adaf25c81"
msgid ""
"I bumped into Elminster. I say 'bumped into' - he was waiting for me outside "
"Sorcerous Sundries."
msgstr "엘민스터와 우연히 만났어. 아니, 우연이라고는 할 수 없겠네… 요술 잡화점 바깥에서 나를 기다리고 계시더라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = fb4d0c5d-e22d-bd4e-e973-adfc2c7b31d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:fb4d0c5d-e22d-bd4e-e973-adfc2c7b31d4
msgctxt "h12fc3974ge2cfg4e3fgbc1eg583843ac9283"
msgid "How about a little love?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = fc62a487-4f66-966d-25af-ebd39f65f5c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:fc62a487-4f66-966d-25af-ebd39f65f5c3
#, fuzzy
msgctxt "h504ab272gf432g4289g8634gb7059d45f64d"
msgid ""
"Consider this, Gale Dekarios: I forbid you to undertake this fool's errand."
msgstr "이것도 검토하시죠, 게일 데카리오스 씨. 절대 이 헛짓거리를 받아들여선 안 된다는 걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = fca1d61d-276f-3ebc-0026-231e8a547eb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:fca1d61d-276f-3ebc-0026-231e8a547eb9
msgctxt "ha7d62c33geeb9g408ag92d8gaef8e5a601e6"
msgid ""
"But speculation only goes so far! Tell me, Mr Dekarios - how have you been?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = fd5461f9-5516-e578-10da-7a25233b04bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:fd5461f9-5516-e578-10da-7a25233b04bf
msgctxt "h4e6e4d97g8d35g427cgac2egd50d6c735d44"
msgid "And are <i>you </i>willing to speak with <i>her</i>?"
msgstr "<i>그 여자</i>와 대화할 마음이 드나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = fdae2a79-dcd1-f6e9-73fb-6c951ee50584
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:fdae2a79-dcd1-f6e9-73fb-6c951ee50584
msgctxt "h4cbb50a6g6f8dg47c3g816fg64b624733395"
msgid ""
"I found the Heart of the Absolute. It was an elder brain, wearing a strange "
"Netherese crown..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = fddd5690-d94b-9263-d654-1deab6c99d23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:fddd5690-d94b-9263-d654-1deab6c99d23
#, fuzzy
msgctxt "h5bcbb6a3g10d7g43acg9ef8g86a6d61b9049"
msgid "Rrriaow! AHEM! That is, you must tell me every detail, Mr Dekarios."
msgstr "니야오오옹! <b>에헴</b>! 그 내용을 상세히 들어야겠군요, 데카리오스 씨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = fe7da961-69fc-013b-939c-73d41a07386d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:fe7da961-69fc-013b-939c-73d41a07386d
msgctxt "h78c43ad8g7bc7g42c4ga088ga294754a98c7"
msgid ""
"Yes. Pleased to say I remain intact, with no signs of ceremorphosis or "
"spontaneous combustion on the horizon."
msgstr "그래. 뇌변이나 자연발화가 당장 닥쳐올 거라는 징후가 보이지 않아서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Tara the Tressym
#. NodeID = feb9cad1-2cc0-a290-a251-019e9edb0fa4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Elminster_Event_WentToCamp = True
#.      - ORI_Gale_Knows_KarsiteWeave = False
#.      - ORI_Gale_Tara_KnowsMystraSummons = False
#.      - ORI_Gale_State_Met_ElminsterInWYR = True
#.   Local:
#.      - 7f14d4dd-de1e-977b-d6b7-c68220ab36e4_RefusedElminsterWYRInformation = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:feb9cad1-2cc0-a290-a251-019e9edb0fa4
msgctxt "hb01e8d43g50fag48c4g9c0fg6a88b1089eae"
msgid ""
"So, what did Elminster have to say that he couldn't <i>possibly</i> have "
"told me, your closest companion and confidante?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym
#. Speaker = Player
#. NodeID = ffa5548c-3b4f-296f-31a2-61f05d859edf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Gale_Tressym:ffa5548c-3b4f-296f-31a2-61f05d859edf
msgctxt "h9bed150cg1d49g4a40g9763g339d99dc6152"
msgid "That's just my boyish charm."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 00c51cad-0ec6-986f-99e2-e7ce84486839
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_Knows_InfernalEngineExists = True
#. SetFlags:
#.   Global:
#.     - CAMP_BurningUpForYou_Event_UnlockedAtTieflingParty = True
#.   Object:
#.     - CAMP_BurningUpForYou_State_UnlockedWith(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:00c51cad-0ec6-986f-99e2-e7ce84486839
msgctxt "h80b21d12gb21cg490agb4a9g753671cd3baa"
msgid ""
"I'll come find you when the others have gone to bed. Wait up for me, all "
"right?"
msgstr "다른 사람들이 잠들면 찾아올게. 기다려줘. 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 00d7a671-16dd-3c0a-f85d-ff14cb17f72d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:00d7a671-16dd-3c0a-f85d-ff14cb17f72d
msgctxt "h828fede3g75c7g45dfg81b7gd5ca990f0097"
msgid ""
"Orthons are good for a drink and joke, but you can't turn your back on 'em."
msgstr "오르쏜은 술 마시며 농담 따먹기 하는덴 좋지만, 걔네 뒤통수 치려고 했다가는 큰일 날 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 068e4a55-af6d-05fa-d2ba-e9043e4b0360
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:068e4a55-af6d-05fa-d2ba-e9043e4b0360
msgctxt "h5c802747gebedg4985gb91eg0184706ae3cf"
msgid "I bet you could make me last as long as you wanted."
msgstr "네가 원한다면 얼마든지 계속 귀감이 될 자신 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 07ca4b8e-69fb-adeb-a0d6-1a06d54c6227
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:07ca4b8e-69fb-adeb-a0d6-1a06d54c6227
msgctxt "he56fe4ceg40dcg4f77gbd42g091a43922be8"
msgid ""
"I don't think your little friend would let me hear the end of it if I "
"accepted. No matter how much I wanted to."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 093b74c2-e993-d578-14f1-eb882aa292f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:093b74c2-e993-d578-14f1-eb882aa292f9
msgctxt "h4e54e606g2cb7g43a8g92ecgd3516e18c846"
msgid "How the hells did you get an infernal engine for a heart?"
msgstr "도대체 어쩌다 지옥불 엔진을 심장에다 박은 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 0e174a1e-1f49-c47a-9f24-308860bd2e5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_CRD_Karlach_HasMet(1) = False
#.   Global:
#.      - DEN_AttackOnDen_Event_TieflingPartyInvitation = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_CRD_Karlach_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:0e174a1e-1f49-c47a-9f24-308860bd2e5f
msgctxt "h4b5efd3eg0a0ag4699g99cdg734fd8010cc9"
msgid "Would you look at this place? All these people - happy because of us."
msgstr "여길 둘러봐. 이 사람들이 다 우리 때문에 행복해해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 0fb4c03d-0251-8de8-1a3b-410869b28dca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:0fb4c03d-0251-8de8-1a3b-410869b28dca
msgctxt "ha8b0e7f6g3f69g48fcga6a3gc343e539a118"
msgid "Enjoy yourself, soldier. You deserve it."
msgstr "즐기라고, 신참. 넌 그럴 자격이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 13c6b913-8669-7e54-faef-550472b3b763
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_KarlachRejected(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:13c6b913-8669-7e54-faef-550472b3b763
msgctxt "h1e75c1d1g4b13g40aeg95d7gd6a13b69a826"
msgid ""
"Ah, c'mon, let's not spoil an effective thing. You point, I rage, we win. "
"Doesn't need to be more complicated than that."
msgstr ""
"아, 왜 이래, 이 편리한 관계를 망치지 말자고. 네가 지시하면, 나는 분노하고, 승리를 거머쥔다. 이 이상 복잡해질 필요 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 15fc40a2-0f48-7526-3eaf-ed9ec0a8c79c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:15fc40a2-0f48-7526-3eaf-ed9ec0a8c79c
msgctxt "ha84367e6g8414g4c48ga37bg762f0267ca46"
msgid ""
"Speaking of, I hate to butt in, but I've seen the way you and Lae'zel have "
"been looking at each other."
msgstr "말 나온 김에, 눈치 없이 끼어들긴 싫지만 너와 레이젤이 서로 심상치 않은 눈빛을 주고 받던데 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 1893d661-dd5b-d942-2c98-a5e8aa7f75cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:1893d661-dd5b-d942-2c98-a5e8aa7f75cb
msgctxt "h06ebd37eg25adg4b30g843bg4367a4c64d23"
msgid "'Hopeless'? I can't stop thinking about it - and you."
msgstr "'가망이 없다'고? 난 항상 그 생각 뿐인데, 그리고 너도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 18e6159c-768a-6de3-56e2-d2411c149194
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:18e6159c-768a-6de3-56e2-d2411c149194
msgctxt "hae21fdfeg0cceg4cc8g938cge03b89f3e3eb"
msgid ""
"Well now! Maybe I could make his acquaintance? A tightened screw or two "
"might let me keep a little calmer."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 19b58f36-b5b9-ee55-69ed-80f6dbf0abb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_Knows_InfernalEngineExists = False
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:19b58f36-b5b9-ee55-69ed-80f6dbf0abb2
msgctxt "h624f3d23gbda5g44aagbdd1gc33bfb7653d9"
msgid "But there's something I think you should know."
msgstr "그런데 네가 알아야 할 게 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 1f3b2e53-5e2c-75f2-0c2a-b4b1d85ea7de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:1f3b2e53-5e2c-75f2-0c2a-b4b1d85ea7de
msgctxt "h488699e7g9659g4fd2g9bc4gadd32a8f6359"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 222ba785-6f05-e3a4-e3e8-5dc80fb156e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:222ba785-6f05-e3a4-e3e8-5dc80fb156e4
msgctxt "hca9817bbgaed4g4053gb4b7g77b7b5b54dde"
msgid ""
"But hey - enough about that. That's history now. I want to think about the "
"future."
msgstr "뭐, 이런 얘긴 이제 됐어. 다 지난 일이야. 난 앞으로의 일만 생각하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 23424b48-7fbc-4e5b-8456-ac55d023186e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:23424b48-7fbc-4e5b-8456-ac55d023186e
msgctxt "h69e87350gd910g44dfga80cg4da01bea2635"
msgid "How the hells did you get an infernal engine for a heart?"
msgstr "도대체 어쩌다 지옥불 엔진을 심장에다 박은 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 29180be0-3554-f0fd-54c9-f8a7670fff37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:29180be0-3554-f0fd-54c9-f8a7670fff37
msgctxt "hf6d8731cgc4c2g405ag8af5gf2238e27b571"
msgid "Ach. That is agonising! But I get it. I guess."
msgstr "아윽. 상처 받았어! 하지만 알겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 2941b547-71f7-261a-724a-117afff14c57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:2941b547-71f7-261a-724a-117afff14c57
msgctxt "hb8793957g8c95g414dg8195g6288cf26e763"
msgid "You have a mechanic for your heart?"
msgstr "네 심장을 위한 기계공이 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 2a013ffd-d116-4e47-d9d0-1d9d0301173d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:2a013ffd-d116-4e47-d9d0-1d9d0301173d
msgctxt "h06121e1dg199eg4105gbadcgb49bde2f484c"
msgid "Who knows! Maybe I can run like this indefinitely. But... maybe not."
msgstr "누가 알겠어! 이렇게 무한정 작동할 수도 있는데. 아마... 그렇진 않겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 2a88f5b8-c371-c33a-5329-742581a4717a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:2a88f5b8-c371-c33a-5329-742581a4717a
msgctxt "h3d1bb844gb4a0g4a64ga956g17b4f4d76e62"
msgid ""
"Won't be seeing my mechanic any time soon, so I'm afraid I just can't get "
"too close."
msgstr "당분간 기계공을 만날 수 없을 것 같으니 미안하지만 거리를 좀 두는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 36e4c8ba-e20e-fa37-c889-efd8632a46db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:36e4c8ba-e20e-fa37-c889-efd8632a46db
msgctxt "h2b07988dg1afag4a95g9efbg30be696dc98b"
msgid "Did you have parties like this in Avernus?"
msgstr "아베르누스에서도 이런 파티가 있었어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 371c0041-25aa-7625-b015-beae25e508c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:371c0041-25aa-7625-b015-beae25e508c6
msgctxt "h88edd17dg67ebg4161g84c9gccb9291a0359"
msgid "'Good' gets boring fast. I say do what suits you any time, anywhere."
msgstr "'착한' 건 금방 질리기 마련이야. 언제 어디서든 네 마음 가는 대로 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 38be0cb4-cd35-a464-c149-bd726f5f26eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:38be0cb4-cd35-a464-c149-bd726f5f26eb
msgctxt "h81ff673fg60ecg410bg8b41gdc73110a7796"
msgid ""
"I tried, in the beginning. Blew up in my face spectacularly. Lesson learned, "
"never try to befriend a devil, cambion, or imp."
msgstr ""
"처음엔 나도 시도해 봤어. 완전 헛짓거리였지. 내가 배운 건 데빌, 캄비온이나 임프 같은 것들이랑 친해지려 하면 안 된다는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 38cfc84a-017f-9bf9-c4cf-0deb4efd474e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_BurningUpForYou_State_UnlockedWith(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:38cfc84a-017f-9bf9-c4cf-0deb4efd474e
msgctxt "ha1f01968ga40eg4d44ga8afgfa4794db014b"
msgid "Can't wait for bed time. See you soon."
msgstr "잠자는 시간까지 못 기다리겠는데. 이따 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 3bf78e2f-22b0-85e0-7fc7-78f6b5dd9191
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:3bf78e2f-22b0-85e0-7fc7-78f6b5dd9191
msgctxt "hd6cc9fa7g0c0eg4ee9gaee3g4d0b19e37c6a"
msgid "You really are something, aren't you."
msgstr "너 참 대단하구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 49f29890-f6d3-a38e-77aa-9a131cfae262
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:49f29890-f6d3-a38e-77aa-9a131cfae262
msgctxt "hfa6f8ff9g14bag4786gbaa6ga34e251c0399"
msgid "I can imagine there weren't a lot of chances for do-goodery in Avernus."
msgstr "아베르누스에서는 착한 일을 할 기회가 없긴 했겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 4cbec3af-d3f7-1b73-bdc3-16a1da69d0e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:4cbec3af-d3f7-1b73-bdc3-16a1da69d0e5
msgctxt "h7085087eg663dg4751gaec5g41c00a621ab3"
msgid ""
"With you - and just lately, I feel like I can remember what it's like to "
"be... <i>good. </i>"
msgstr "최근 너와 함께하면서, <i>착한</i>... 생각을 할 수 있게 된 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 51273582-524d-643b-2ef8-7fc5edd55192
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:51273582-524d-643b-2ef8-7fc5edd55192
msgctxt "hea6d20dfg21deg4502g8ddcg90174d42886f"
msgid ""
"Don't get me wrong, I'd ride him to the Feywild and back if I had the "
"chance, but I wouldn't let my guard down around him."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 51ad0226-a696-2c52-2335-8c6bca9819e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:51ad0226-a696-2c52-2335-8c6bca9819e0
msgctxt "ha3289851ge09bg41b6ga416g93d5c061e105"
msgid "(Yes!)"
msgstr "(좋았어!)"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 584c36ef-38e0-96b5-5693-3c8cec3ef893
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_BurningUpForYou_State_Happened = False
#.   Object:
#.      - ORI_State_DoubleDating(1) = False
#.      - Approval_AtLeast_20_For_Sp2(0) = True
#.      - ORI_State_Dating(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:584c36ef-38e0-96b5-5693-3c8cec3ef893
msgctxt "h03c374b3g094cg4ca5gae11ge7523c25e7cb"
msgid ""
"Though... you know. If you wanted to meet up later, maybe we could... meet "
"up. Later."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 5864b91a-eeed-9a1f-e4ba-32fd72647030
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:5864b91a-eeed-9a1f-e4ba-32fd72647030
msgctxt "h3a08d0feg4ba7g46efg9567ga9570f308b6f"
msgid ""
"Maybe even manage a pat or bump without burning someone to death. It's been "
"a <i>long </i>time."
msgstr "어쩌면 누굴 만질 때 불태워 죽이지 않고 해낼수 있을지도 몰라. 안그런지 <i>오래 </i> 됐거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 5a315da1-caeb-00b8-cced-07440cf1efbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:5a315da1-caeb-00b8-cced-07440cf1efbb
msgctxt "hf0fefe0bg9ff0g427egbe20g78e09893dfb0"
msgid ""
"Haha! I really know how to lay it on thick, don't I? Ah well. What can I "
"say? I'm excited to be alive. And excited about what's to come."
msgstr "하하! 나 진짜 호들갑이다, 그치? 아무튼, 뭐라고 할까? 난 살아있어서 너무 즐겁고 앞으로 일어날 일들이 기대돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 5b835f10-bd31-d6e4-240b-f71855d2f928
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:5b835f10-bd31-d6e4-240b-f71855d2f928
msgctxt "hb8dbd9fdga901g4542g8923gd540c064fbc0"
msgid ""
"Wild, right? And believe it or not, I'm one of Zariel's <i>least</i>-"
"mutilated pets."
msgstr "대단하지? 믿거나 말거나, 내가 자리엘의 <i>그나마 덜</i> 개조된 애완동물이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 5e209ffd-a62e-c5a8-4dd4-732c9cd86ea2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_ShadowheartPartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:5e209ffd-a62e-c5a8-4dd4-732c9cd86ea2
msgctxt "h6702fd4eg5f33g491dg87ddge8cbbc318d14"
msgid ""
"Speaking of, from where I'm standing it looks like you and Shadowheart are "
"getting more... <i>familiar</i>."
msgstr "말 나온 김에 말인데, 내가 보기에 너랑 섀도하트는 갈수록 서로… <i>가까워지고 있는</i> 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 64dc816a-bc47-da31-4637-4bb53186f7ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_KarlachRejected(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:64dc816a-bc47-da31-4637-4bb53186f7ef
msgctxt "ha3a4ed1eg3a4fg49a8ga7bcg39cfe766e122"
msgid "Enjoy yourself tonight. You've earned it."
msgstr "오늘 밤 마음껏 즐겨. 넌 그럴 자격 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 64efcb9f-61f6-996d-08ee-a7997df5d464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:64efcb9f-61f6-996d-08ee-a7997df5d464
msgctxt "he03908a2ga578g41b2ga165ge08f7c4caab4"
msgid ""
"The one nice thing about being trapped in the inexorable grind of time is "
"you've always got something to look forward to."
msgstr "끊임없는 시간의 소용돌이 속에서 유일하게 다행인 점이 있다면, 삶에는 언제나 기대해볼 만한 게 있다는 점이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 656c95b8-5c0b-90c5-745f-fb03852215e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:656c95b8-5c0b-90c5-745f-fb03852215e2
#, fuzzy
msgctxt "h7ea6ff4agfd91g4a4dg93f7g74c3f7f3ea9f"
msgid ""
"It also means if I'm heated at all - excited, nervous, scared - I'm <i>way </"
"i>too hot to touch."
msgstr "흥분, 긴장, 두려움 등 조금이라도 자극을 받게 되면 날 만질 수 없을 정도로 엄청나게 뜨거워 진다는 얘기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 660563ac-081e-d4dc-0d41-d46ec9d4e6ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:660563ac-081e-d4dc-0d41-d46ec9d4e6ed
msgctxt "h7dadd55ag3cc5g47e0g9d7cg8e8477e9ecfa"
msgid ""
"But let's not get into tragic backstories now. It's such a beautiful night."
msgstr "그래도 지금은 슬픈 사연 같은 건 풀어놓지 말자. 이토록 아름다운 밤이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 665aabf8-a7fb-e916-43d4-874ff5f1d2ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:665aabf8-a7fb-e916-43d4-874ff5f1d2ee
msgctxt "h5794ffecga021g4e26ga37cg519edb1aa5ae"
msgid "Don't worry. I will. And I've got a good arm, you know."
msgstr "걱정 마. 그럴 거니까. 내 팔 힘이 좀 쩌는 거 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 667cbb3f-5a9e-48dc-55af-21dc2d56bafc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:667cbb3f-5a9e-48dc-55af-21dc2d56bafc
msgctxt "hef3cd9cdga77bg4273g8d85g6cebc6c0f02a"
msgid "I don't know if you mean that. But I hope you do."
msgstr "그런 뜻으로 한 말인지는 모르겠어. 그런데 그게 맞으면 좋겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 668c21ba-cf91-f73b-0db6-6e173646259b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_BurningUpForYou_Event_UnlockedAtTieflingParty = False
#.   Object:
#.      - ORI_State_DoubleDating(1) = False
#.      - Approval_AtLeast_20_For_Sp2(0) = True
#.      - ORI_State_Dating(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:668c21ba-cf91-f73b-0db6-6e173646259b
msgctxt "hbe3ae56eg604cg4f80g849ag4055028ae622"
msgid ""
"And I... I really want to. Ugh. This is bad. But I want to be bad <i>with "
"you.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 67d9ef23-234e-de1e-6624-2b40e69f5e2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:67d9ef23-234e-de1e-6624-2b40e69f5e2e
msgctxt "heec6c681g4605g41bfgb9c7g4e1dd875d837"
msgid "I want to be with you. Everything else is just a distraction."
msgstr "너와 함께 있고 싶어. 다른 모든 것들은 방해만 될 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 6baa0465-aed9-ff0a-9b57-ccb8f4a56761
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:6baa0465-aed9-ff0a-9b57-ccb8f4a56761
msgctxt "h3ce6627cg4885g4851gab7dg9392fa29c021"
msgid ""
"Ah, come on. I know I'm not really who you're interested in. And anyway, "
"even if I were, you couldn't touch me without getting burnt to a crisp."
msgstr "아, 왜 이래. 너 나한테 진짜 관심 있는 거 아니잖아. 아니 뭐, 관심 있다 해도 날 만지려 했다간 바삭해져 버릴걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 6fb7d064-5155-491e-e88f-dec7dfc0a466
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:6fb7d064-5155-491e-e88f-dec7dfc0a466
msgctxt "h20d18804g70b4g4c95gaa0eg87c3df2b818d"
msgid "I'd really like that."
msgstr "그거 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 72919e1e-f468-7d78-f80b-30a7c90fd8ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:72919e1e-f468-7d78-f80b-30a7c90fd8ac
msgctxt "he2487881gd5ebg4af1gaa29gfeb5ec46eddc"
msgid "I like you too. A <i>lot. </i>I'm sure you know that by now."
msgstr "나도 네가 좋아. 아주 <i>많이. </i> 지금쯤이면 너도 알고 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 72c43c91-c066-3b34-44db-2401c16bf118
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:72c43c91-c066-3b34-44db-2401c16bf118
msgctxt "hcd5dbd0fg63aeg45c2gb6d3gf43f0485f486"
msgid "Really now? Cause I think you suit me perfectly."
msgstr "지금 말이야? 당장 널 맘대로 해버리고 싶거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 752b55ca-7755-a9ea-c887-6ff6f3f2bb1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:752b55ca-7755-a9ea-c887-6ff6f3f2bb1b
msgctxt "h10bc4ab3g6a7cg4702g85b4gfe0850d6b97d"
msgid ""
"I tried to make friends at first. Learned my lesson fast. Better to keep to "
"yourself in Hell."
msgstr "처음엔 친구를 사귀려 했다가 빠르게 교훈을 얻었지. 지옥에선 혼자가 더 좋다는 걸 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 7575a496-fa70-ffc2-15f1-d522a573c61f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:7575a496-fa70-ffc2-15f1-d522a573c61f
msgctxt "h7ca73046g8a91g434bgaa62g75c2929c16c6"
msgid "Leave."
msgstr "떠난다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 75b2cbaa-4448-00a1-2ae0-dfa1384dd76a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:75b2cbaa-4448-00a1-2ae0-dfa1384dd76a
msgctxt "hae0fa57cg420ag4306g832bgb35f6bb97792"
msgid ""
"That's well and good, but beware. Paragons don't last long on the open road."
msgstr "다 좋은데, 조심하라고. 모범이라는 건 길 위에서 오래가지 않는 법이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 77927237-5a3f-56da-febc-a857ab6484fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Weaponsmith_Knows_Elturel(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_ToldKarlachAboutDammon = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:77927237-5a3f-56da-febc-a857ab6484fa
msgctxt "hac40571eg1557g4f06g9767gd66df7f02639"
msgid ""
"I met someone who might be able to help - a smith who worked in the Hells "
"for a time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 78e4d3cc-0cb6-7071-da72-44ff8d27a9bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:78e4d3cc-0cb6-7071-da72-44ff8d27a9bc
msgctxt "ha6b6a568gaa2fg4509ga272gb6d6f2311cd3"
msgid ""
"I can handle it. After all, life was made to be lived. And that's exactly "
"what you're doing."
msgstr "난 이겨낼 수 있어. 결국, 인생은 어떻게든 살아가게 되어있으니까. 그리고 정확히 너도 그러고 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 7aec6b73-2ac1-fa85-66c0-ec8e4bc45d57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:7aec6b73-2ac1-fa85-66c0-ec8e4bc45d57
msgctxt "h078ac5ccg74fag4eefgb1b0ga8ef9e852ac3"
msgid "You. Me. Bed. Now."
msgstr "너, 나. 침대, 당장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 7d426ef1-4d1c-8b2c-1263-83ae29126e2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:7d426ef1-4d1c-8b2c-1263-83ae29126e2c
msgctxt "h0232e1a2gc837g4fe4gab5dga00bcbfc41aa"
msgid ""
"Not so much. You spend the whole time avoiding swords and schemes. Plus "
"people just get nastier as the night wears on."
msgstr "그건 좀 그래. 넌 칼과 음모를 피하느라 여념이 없었잖아. 게다가 사람들은 밤이 깊어질수록 더 추잡해질 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 7d4668af-67c5-47ed-f1a9-c63965ccc5dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:7d4668af-67c5-47ed-f1a9-c63965ccc5dd
msgctxt "h1bb1471bg5e0eg4afeg8d1eg11a9f286e832"
msgid "Enjoy the party. And enjoy so-and-so too, while you're at it. For now."
msgstr "파티 즐겁게 보내. 누구누구 씨랑도 함께 있을 때 즐겁게 지내고. 지금은 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 7f1bc2ea-ddaf-05ee-2f56-94497bf207f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:7f1bc2ea-ddaf-05ee-2f56-94497bf207f0
#, fuzzy
msgctxt "h8e4aa382g84c7g417bg8920ga0655a4991e3"
msgid ""
"He's a good egg. A little scholarly for my tastes, but I'm sure you could "
"crack his spine like a new book."
msgstr "걘 좋은 녀석이야. 좀 고지식해서 내 취향은 아니지만, 너라면 꽉 휘어잡을 수 있을 거라고 확신해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 8121741c-5eaa-5c31-ef5e-8820fd730418
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:8121741c-5eaa-5c31-ef5e-8820fd730418
msgctxt "h587ae24fgdbadg4a9ag9d9fg58acf741109f"
msgid "All I need now is a fire-retardant lover to get lost in 'til sunrise."
msgstr "지금 내게 필요한 사람은 동틀녘까지 함께 시간을 보낼 내화성 연인뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 87edda57-e252-4643-9280-2f6e8d1a6cba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:87edda57-e252-4643-9280-2f6e8d1a6cba
msgctxt "hfa3be266g9bc0g4888gbbe4g9d8107db469c"
msgid ""
"Speaking of possibilities, what's this I've been hearing about you and "
"Astarion?"
msgstr "말 나온 김에 말이야, 너와 아스타리온에 대한 소문을 들었는데 그게 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 8d882d2b-9100-d946-711a-902660d30a61
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_KarlachRejected(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:8d882d2b-9100-d946-711a-902660d30a61
msgctxt "ha9a431e0g32e7g4f8bga2f3g5346c4944f46"
msgid "You. Me. Friends. Got it? Good."
msgstr "너. 나. 친구. 알겠지? 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 91885cb9-4387-11dc-8f2f-14cf3b57d20d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:91885cb9-4387-11dc-8f2f-14cf3b57d20d
msgctxt "he8332999g5730g46edg9c09ga4b6df1297ff"
msgid "Cheers to you, soldier. And to me, if I do say so myself."
msgstr "건배, 신참. 그리고 나 스스로를 위해 또 한 번 건배."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 95605f58-7fb7-ad23-3ad9-69691436c7c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:95605f58-7fb7-ad23-3ad9-69691436c7c5
msgctxt "hab4861e1g5f30g4bc3g87feg7a52cd92c8a7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 98d4b917-e89b-4e66-05cd-551ffa6a6c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:98d4b917-e89b-4e66-05cd-551ffa6a6c95
msgctxt "h650b1c44g1ff0g4f08g8fdag614276894e71"
msgid "Thank you. I know it can't be easy."
msgstr "고마워. 쉽지 않았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 991b9905-dc3e-d5ec-5fc7-b00d973e5b48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:991b9905-dc3e-d5ec-5fc7-b00d973e5b48
msgctxt "h1f4d92cfg4d17g447cgaccfg1f672a389ff6"
msgid "High pain tolerance. And a dynamic duo of truly shitty bosses."
msgstr "고통 진짜 잘 참기. 그리고 등신같은 상사들의 환상적인 조합."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = 9bfd39b8-c327-3590-517f-2cbfdd4e1a1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:9bfd39b8-c327-3590-517f-2cbfdd4e1a1f
msgctxt "ha5f5af01g94edg4bc9gaa23g22204b40e5b7"
msgid "Bye, soldier."
msgstr "잘 가, 신참."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = 9cb7c423-7022-fd38-44d3-b20a7106b112
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:9cb7c423-7022-fd38-44d3-b20a7106b112
msgctxt "h72521999gd428g4e8dg9f42g8dfcc7d3afcd"
msgid "Enjoy yourself tonight, Karlach."
msgstr "오늘 밤 재밌게 즐겨 칼라크."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = a03e5425-411d-1d30-0df6-dfc9f9e78be7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:a03e5425-411d-1d30-0df6-dfc9f9e78be7
msgctxt "hf4dba7acg1cf5g458dga0a0g125b3dee2749"
msgid ""
"Good to see the two of you getting along, anyway. At least one of us is "
"getting a little action."
msgstr "어쨌든 둘이 잘 어울려, 보기 좋아. 오늘밤 누군가는 진도 좀 빼겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = a3f1d6f5-daef-08ee-b79a-5d3fb1713a07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:a3f1d6f5-daef-08ee-b79a-5d3fb1713a07
msgctxt "hdb68928fga404g462cgb0begf93ae4e593d7"
msgid ""
"I know. But you only live once, and if you never throw your dart, you'll "
"never hit the bull's eye."
msgstr "알고 있어. 하지만 인생은 한 번뿐이고, 다트를 안 던지면 과녁의 정중앙을 맞힐 수 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = a5c78724-6e7e-2c91-f353-4abc7831926a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:a5c78724-6e7e-2c91-f353-4abc7831926a
msgctxt "h84245523g240eg4d6bga780ge67a4912edfc"
msgid ""
"It isn't hard. And I really like you. I was wrong to go for someone else."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = a826ae4d-ec93-de91-034d-8af5ee2b6705
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:a826ae4d-ec93-de91-034d-8af5ee2b6705
msgctxt "hcb24bbccg939bg4d1eg8b5bg854508e7743d"
msgid "But hey. At least some of us are getting a little action."
msgstr "뭐 어쨌든. 오늘밤 누군가는 진도 좀 빼겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = abff8f6c-f5a0-b3e6-bd27-e263f25b5696
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:abff8f6c-f5a0-b3e6-bd27-e263f25b5696
msgctxt "h0dd4fc13g660cg4ff1g9b7bgacba1cdabf54"
msgid "It's nice to be somewhere where good is still <i>possible</i>."
msgstr "여전히 좋은 일이 <i>가능한</i> 곳이 있다니 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = b078a8e0-74e5-13af-bb8c-3ee2ae416231
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:b078a8e0-74e5-13af-bb8c-3ee2ae416231
msgctxt "h804ae105g02dfg48c5g8568ga834cc1d10a5"
msgid ""
"She's a funny one. All pointy and secretive, but it seems like there's "
"someone very sweet beneath it all, you know?"
msgstr "걔가 좀 재밌긴 해. 예민하고 숨기는 게 많은 것 같아 보여도 사실 참 다정한 애야, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = b57adba6-a9e1-6fad-2912-c8058a8f3e98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:b57adba6-a9e1-6fad-2912-c8058a8f3e98
msgctxt "hd18ff525gbc99g4de4g9f2agba13b1c18b4c"
msgid "I think I've drummed up the courage to tell you how much I like you."
msgstr "내가 널 얼마나 좋아하는지 말할 용기가 난 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = b5acc294-7842-2f6c-26bb-17c00fcc1a44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:b5acc294-7842-2f6c-26bb-17c00fcc1a44
msgctxt "hd20963d7g55fdg4c6fga718gf6b68c95f420"
msgid ""
"Burn, baby. As hot as I can tolerate. Makes me a beast in battle. Hardly "
"remember what I was like before it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = b6538f09-6f9f-5d96-ac5a-cb5ad202b672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:b6538f09-6f9f-5d96-ac5a-cb5ad202b672
msgctxt "he0cdf07bg645bg4295g87b7gfc5c699da968"
msgid "Thank you for noticing."
msgstr "알아봐 주니 고맙네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = bbd08c4f-8236-300c-e7bf-e3aec79539d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:bbd08c4f-8236-300c-e7bf-e3aec79539d9
msgctxt "h47d3bf35g5962g4f07g9fb8g1f3dff6041bc"
msgid ""
"Really? I thought - because of you and you know... I don't know, I thought "
"maybe you just wanted to be with someone you could actually <i>be </i>with."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = bdc6f319-b489-7bb6-ed02-d2d5431d0e0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:bdc6f319-b489-7bb6-ed02-d2d5431d0e0d
msgctxt "hff408325g820bg4cafg854ag36024605644a"
msgid "I still want to spend time with you - just the two of us."
msgstr "난 지금도 너와 함께하고 싶어. 우리 둘이서만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = c0e82af5-6d50-2f22-d940-9236b83f97ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_BurningUpForYou_State_HappenedWithPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:c0e82af5-6d50-2f22-d940-9236b83f97ed
#, fuzzy
msgctxt "hbebe64e3g002fg4dd2g9707g07eee2e6d174"
msgid ""
"I know I was a little hopeless when we - you know - before. I want you to be "
"happy. And I want you to be with someone you can actually <i>be </i>with."
msgstr ""
"우리가 이전에는 좀 가망이 없었던 것 같아, 너도 알다시피. 난 네가 행복하길 바라. 그리고 네 옆에 실제로 <i>함께</i> 할 수 "
"있는 누군가가 있었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = c39dfc7b-3723-6040-2280-5b2d172f9a5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:c39dfc7b-3723-6040-2280-5b2d172f9a5f
msgctxt "hfc1cff4dge768g415dg9f69gc31db7e582a7"
msgid "You have a mechanic for your heart?"
msgstr "네 심장을 위한 기계공이 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = c50c4bb9-dd0b-b6af-bdd0-b1671d5c8634
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:c50c4bb9-dd0b-b6af-bdd0-b1671d5c8634
msgctxt "hdf17015cg8bf7g450bga993g34bdda594cbc"
msgid "And with such lovely company."
msgstr "게다가 이렇게 사랑스러운 동료들이랑 함께라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = c5a1db04-bb8e-030f-80f4-74244174da1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:c5a1db04-bb8e-030f-80f4-74244174da1f
msgctxt "hc77490a8ge52eg4b0ega4e5gb170b81ca329"
msgid "That's true. And I'm looking forward to spending more time with you."
msgstr "맞는 말이야. 그리고 난 너랑 더 많은 시간을 보내고 싶어하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = cd75ac6b-cf8d-0c40-b31d-fbe80ec028f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:cd75ac6b-cf8d-0c40-b31d-fbe80ec028f3
msgctxt "h9e7697f7gbbbag4d1dgbbccg7fc6e6456a7e"
msgid "I just want that to be me. Somehow. Some day."
msgstr "난 그게 나였으면 좋겠어. 어떻게든, 언젠가는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = cf91bec3-b6d3-6dc6-1024-9a69e1ca5aaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:cf91bec3-b6d3-6dc6-1024-9a69e1ca5aaa
msgctxt "h5f6c3e00gdbaeg430ega9a2g20806c7198fa"
msgid "<i>Gods</i> that's hot. Don't get me started. I might never stop."
msgstr "<i>신이시여</i>, 이거 진짜 뜨거운데. 날 자극하지 마. 멈출 수 없을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = d3d45e2e-5911-77c6-9ff2-04b1293310db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:d3d45e2e-5911-77c6-9ff2-04b1293310db
#, fuzzy
msgctxt "h8491d7ccg23ddg46f5g937agca90ab6d93a3"
msgid ""
"Fuck yes! I'm celebrating my freedom. And our friendship. And these folks' "
"bright future besides."
msgstr "씨발 물론이지! 나의 자유. 우리의 우정. 저 사람들의 밝은 미래까지 축하하는 중이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = d5518d43-0db9-c9e7-8740-5de0ee18eb7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:d5518d43-0db9-c9e7-8740-5de0ee18eb7f
msgctxt "hab466af6g6ad4g4a24g87c5g7770d93bc19a"
msgid "And with good potations, too."
msgstr "좋은 술과 함께 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = d91fc1aa-1336-a069-39e5-6bf5c9454839
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:d91fc1aa-1336-a069-39e5-6bf5c9454839
msgctxt "hd0c50c7dgec88g4de8gb1bcg18f3e51c33de"
msgid "Keep throwing."
msgstr "계속 던져봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = d9aed688-e33d-d962-7a92-d098a34801cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:d9aed688-e33d-d962-7a92-d098a34801cf
msgctxt "h60a54664g64b6g4f5eg8de8g45c3d31d1f4b"
msgid "Oh god. You know I want that more than fucking <i>anything.</i>"
msgstr "오 세상에. 내가 씨발 <i>어떤 것</i>보다 그걸 더 원한다는 거 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = d9eda9b1-defb-c30c-b1ed-c741a1cce336
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_KarlachRejected(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:d9eda9b1-defb-c30c-b1ed-c741a1cce336
msgctxt "h94129706g7bc3g4ad2g9052g79955da1d76f"
msgid "Have fun."
msgstr "좋은 시간 보내."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = dd330fae-b62c-9517-d587-cb7fb12e5708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:dd330fae-b62c-9517-d587-cb7fb12e5708
msgctxt "haa3038e8g8f5eg4bd7gab7fg8e069faee672"
msgid "What'll happen if you don't get tuned up?"
msgstr "그거 정비 안하면 어떻게 되는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = def863c2-b25f-8a50-2b2a-9c9885be60bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_GalePartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:def863c2-b25f-8a50-2b2a-9c9885be60bf
msgctxt "h519da7ecgba82g4a66g9532g8bb7c90a66c0"
msgid ""
"Take you and Gale, for instance. Don't think I haven't noticed the sparks "
"flying."
msgstr "너랑 게일을 예로 들어보자. 너희 둘 사이 흐르는 전류, 내가 모를 줄 알았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = e0af5706-d584-26ce-cda9-101e48a0de95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:e0af5706-d584-26ce-cda9-101e48a0de95
msgctxt "hae8d0220gcdefg4bd1g8708g00553d9a09f9"
msgid ""
"I like her, and I bet she's a wildcat after midnight, but I'm just not sure "
"I <i>trust </i>her yet. Mind yourself, all right?"
msgstr ""
"난 걔 맘에 들어. 장담컨대 자정이 지나면 살쾡이처럼 돌변하겠지. 하지만 아직 걔를 <i>믿어도</i> 될지는 모르겠어. 조심해, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = e403da52-ec83-b9dd-9d4c-eccadc486dff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Weaponsmith_Knows_Elturel(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_ToldKarlachAboutDammon = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:e403da52-ec83-b9dd-9d4c-eccadc486dff
msgctxt "hbcabb124g59d2g4cd0gabddg82b37e54437d"
msgid ""
"I met someone who might be able to help - a smith who worked in the Hells "
"for a time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = e4ae1967-b853-3f42-6d35-a9cb8724ec2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:e4ae1967-b853-3f42-6d35-a9cb8724ec2b
msgctxt "h1ad727b4g7288g4502ga272gf06630e05db7"
msgid "Really? I mean - great!"
msgstr "정말로? 내 말은… 좋아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = e5085b66-842d-fc8c-33e8-5b9b8be56ad2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:e5085b66-842d-fc8c-33e8-5b9b8be56ad2
msgctxt "h5cd4480bg1f00g4fd4gb082g79a3e70f1221"
msgid ""
"Hear that? Infernal engine for a heart. Lets me burn as hot as the Hells. "
"Seems to be running in overdrive since I left Avernus."
msgstr ""
"들려? 심장용 지옥불 엔진이야. 날 지옥불만큼 뜨겁게 불타오르게 해주지. 그런데 아베르누스를 떠난 후부터 과부하에 걸린 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = e8ef4755-6863-30c1-cabd-1992c59acb1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:e8ef4755-6863-30c1-cabd-1992c59acb1d
msgctxt "hed891e4eg4b01g4258ga5e1g4d5a99a71ae7"
msgid "You too, soldier."
msgstr "너도. 신참."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = ea93a2d7-3ac4-45e8-b53d-6709a266faa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:ea93a2d7-3ac4-45e8-b53d-6709a266faa6
msgctxt "h17857cfeg779cg4de6g91e1g62284a6d680f"
msgid ""
"He's a good one. The best, maybe. When I think about what he sacrificed for "
"me... Give him something to smile about, all right?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = eaed6e50-2c09-146d-6064-f2e0afb5a670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:eaed6e50-2c09-146d-6064-f2e0afb5a670
msgctxt "h5a1c69fdg4493g4e3fgae7egc51092d52080"
msgid ""
"Well look, soldier, I won't always be too hot for words and deeds. You may "
"regret to find that I happen to be very touch-worthy, underneath the "
"searing, lethal flames."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = eb6b6621-0d1c-bb62-8bbf-5972f7913dc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:eb6b6621-0d1c-bb62-8bbf-5972f7913dc4
msgctxt "h669f3f5egfe03g45eag8d72g899470e3f24a"
msgid "What does the engine allow you to do?"
msgstr "엔진으로 뭘 할 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = ec0b7254-fb6f-6734-f154-8aa7fbcce1d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_WyllPartner(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:ec0b7254-fb6f-6734-f154-8aa7fbcce1d2
msgctxt "h59bd7468g88ffg47e8g87b8gb307f654d2b9"
msgid ""
"Then we have you and Wyll, the ultimate incarnation of all things good in "
"the world. There's something between you two, isn't there?"
msgstr "너랑 윌 말야, 세상 모든 좋은 걸 다 합친 존재. 너네 둘 사이에 뭔가 있는 거 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = ee7e49b9-d1db-0260-bbe9-7a1c6efa5c43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:ee7e49b9-d1db-0260-bbe9-7a1c6efa5c43
msgctxt "h81490f17g6b33g416aga6d7g75f938bad7a4"
msgid "Not if I enjoy you first."
msgstr "너랑 먼저 즐거운 시간 보낼래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = ef0e1a11-b839-ca21-13eb-e2ba392b1acd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:ef0e1a11-b839-ca21-13eb-e2ba392b1acd
msgctxt "h4d54f75fg1a51g419dga818gf82b8ecb864b"
msgid "You know there's someone else, Karlach."
msgstr "나한테 다른 사람이 있다는 걸 알잖아, 칼라크."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = ef172fce-09b4-5a04-91c4-6874e29b1fb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:ef172fce-09b4-5a04-91c4-6874e29b1fb8
msgctxt "hdb502144g1cd4g4fbfg85eeg78ea3e522b51"
msgid "Are you enjoying yourself?"
msgstr "즐거운 시간 보내고 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = f2f86f94-d9be-6858-6dce-44a1ea94e26b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:f2f86f94-d9be-6858-6dce-44a1ea94e26b
msgctxt "h49b77807g4e5eg4794gb456g364a7028ac9e"
msgid "Enjoy yourself tonight, Karlach."
msgstr "오늘 밤 재밌게 즐겨 칼라크."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = f3f748f0-84ca-0cd3-5b82-ba55520c83a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:f3f748f0-84ca-0cd3-5b82-ba55520c83a4
msgctxt "h67359b00g7d61g4f3egaf5dgc7dd3b6440c3"
msgid ""
"I'd understand. I mean, I <i>do </i>understand. I'm not possessive. And at "
"the end of the day, I want you to do what you want to do."
msgstr "알았어. 내 말은, <i>정말</i> 이해했어. 난 집착하는 타입은 아니니까. 결국에는 네가 하고 싶은 대로 하길 원하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = f45840e1-abea-b694-0d83-9a4f292e9158
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:f45840e1-abea-b694-0d83-9a4f292e9158
msgctxt "h42c804b6gf4b9g4e4dga15dg203eb27dbaa1"
msgid ""
"I want to be close to you. Now, ten minutes from now, ten years from now."
msgstr "너와 가까워지고 싶어. 지금, 10분 후에도, 10년 후에도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = f64cad6b-3efe-a804-0da3-26ac559ee1ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:f64cad6b-3efe-a804-0da3-26ac559ee1ea
msgctxt "h0bb6d7a8gf685g4d43gabb7g684b5bd4cb6c"
msgid "I suppose so. But sometimes I feel like I'm stuck in the past."
msgstr "그런 것 같네. 하지만 난 아직도 가끔 과거에 갇혀 있는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = f87be205-6448-e445-2d00-a31d8af5194b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_Knows_InfernalEngineExists = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:f87be205-6448-e445-2d00-a31d8af5194b
msgctxt "he68c2334ga685g47a2gb977g96e0b9e5a81a"
msgid "Speaking of which... there's something I wanted to tell you."
msgstr "말 나온 김에… 너한테 하고 싶었던 말이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = faba1e7a-5920-34a7-d77d-0130701fc326
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:faba1e7a-5920-34a7-d77d-0130701fc326
msgctxt "h80305c61g44c4g4509gbb81gdbda12363355"
msgid "What does the engine allow you to do?"
msgstr "엔진으로 뭘 할 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = fbae0053-8e99-9694-fa48-d0cd5365860d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:fbae0053-8e99-9694-fa48-d0cd5365860d
msgctxt "h48346fbeg0b5eg43eaga572gbc204ec16cb5"
msgid "Me too. I don't think I've ever looked forward to anything as much."
msgstr "마찬가지야. 이렇게 뭔가를 기대해 본 적이 없었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = fd0b3545-c222-e0fc-a7f1-7c1b4f230a86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:fd0b3545-c222-e0fc-a7f1-7c1b4f230a86
msgctxt "h285cfb42ge989g4dbdgbdf0gd81d16c6a64e"
msgid "Don't look too far back. We only just met."
msgstr "너무 멀리 돌아보진 마. 우리는 만난 지 얼마 안 되었으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Player
#. NodeID = fe05eb79-cb6e-792a-2d8e-654db98bc07e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:fe05eb79-cb6e-792a-2d8e-654db98bc07e
msgctxt "h698e4a42g33ebg4374gafbcg462460642b77"
msgid "I appreciate that. But I'm afraid it's a miss this time."
msgstr "고맙지만 방금 건 빗나간 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach
#. Speaker = Karlach
#. NodeID = fe080b03-e32b-e1c2-1e2c-34a73f41cfd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_GoblinHuntCelebration_CRD_Karlach:fe080b03-e32b-e1c2-1e2c-34a73f41cfd2
msgctxt "h46099074gca11g4913gbf6ege62b82d8a3d5"
msgid ""
"You better go enjoy the party before I do something I'll regret. I like you "
"<i>un</i>burnt, after all."
msgstr "내가 후회할 짓을 하기 전에 가서 파티를 즐기도록 해. 어쨌든 난 <i>타지 않은</i> 네가 좋거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 01b240ff-885a-0188-05bb-a7c1ed831049
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:01b240ff-885a-0188-05bb-a7c1ed831049
msgctxt "hc3be4c8fg6aa1g41bag83b0g3ad351701792"
msgid ""
"Perhaps if I manage to break the curse... perhaps then I can show you just "
"how grateful I am."
msgstr "아마도 내가 저주를 풀 수 있다면... 아마 그때는 내가 얼마나 감사한지 보여 줄 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 02dde702-439b-6561-2502-8f20c1925f51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = True
#.      - CAMP_Halsin_Event_HadDarkUrgeConfession = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Event_HadDarkUrgeConfession = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:02dde702-439b-6561-2502-8f20c1925f51
msgctxt "h25539ecag9fc3g414agbe7bgd4fac1b410d2"
msgid "I think I might be sick beyond the tadpole... I'm getting worried."
msgstr "올챙이보다 심한 병에 걸린 것 같아요... 걱정되네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 03cc9910-833a-4a83-b6bd-feb2fa74a70e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:03cc9910-833a-4a83-b6bd-feb2fa74a70e
msgctxt "h56671ba4gb791g42eeg923fgd389befbb73e"
msgid "There's also the shadow curse - it's an affront and must be cleansed."
msgstr "게다가 그림자 저주도 있소. 이는 자연에 대한 모욕이며, 반드시 정화되어야 하오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 04744966-04e5-47d7-8274-b230e419c259
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = False
#.      - MOO_PartyProgress_EnteredMoonrise = False
#.      - HAV_LiftingTheCurse_State_HalsinAvailableForFist = False
#.      - GLO_LiftingTheCurse_State_RecoveredBreath = False
#.      - GLO_LiftingtheCurse_State_ThanielReleased = False
#.      - GLO_LiftingTheCurse_Event_TravelToHaven = False
#.      - GLO_LiftingTheCurse_Event_TravelToLakeside = False
#.      - CAMP_Halsin_Knows_ShadowCurseMotivation = False
#.   Local:
#.      - a0260ce0-84c8-2daa-27fd-648445acc5d0_UnfinishedBusiness = False
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Knows_ShadowCurseMotivation = True
#.   Local:
#.     - a0260ce0-84c8-2daa-27fd-648445acc5d0_UnfinishedBusiness = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:04744966-04e5-47d7-8274-b230e419c259
msgctxt "hc3fd0824ge9f9g43a4g98e9g88d0514042c1"
msgid "Why do you want to go to Moonrise Towers?"
msgstr "어째서 문라이즈 타워로 가고 싶어 하는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 06badfd6-2000-46f9-a845-be2e5187ad91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:06badfd6-2000-46f9-a845-be2e5187ad91
msgctxt "haf8a3924gef2dg40e6ga7c1gde8dc1638ce8"
msgid "Tell me how I can help."
msgstr "어떻게 하면 도움이 될까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 09431613-3e64-44a6-b851-db1ea30c9716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:09431613-3e64-44a6-b851-db1ea30c9716
msgctxt "h3eadeaeeg54c0g47bag8f9cg2d1f9616e8b8"
msgid "If only everyone said that."
msgstr "모든 사람이 그렇게 말했으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 09622407-f01c-490a-be10-1314c78db3ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Lockdown_State_Active = False
#.      - CAMP_Halsin_Knows_SuccessorFirstDruid = False
#.      - DEN_AttackOnDen_State_RaiderVictory = False
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Knows_SuccessorFirstDruid = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:09622407-f01c-490a-be10-1314c78db3ac
msgctxt "h422d4ff3g12b4g4098g86b6g4ef665dc49bb"
msgid "How will the grove fare without you?"
msgstr "당신이 없으면 숲은 어떻게 될까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 09ee6676-d826-c607-7f23-cfb6666b7eba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:09ee6676-d826-c607-7f23-cfb6666b7eba
msgctxt "h4cbf9238g4081g428fg83e0gfb6305fa7c9d"
msgid ""
"Don't get too sentimental - I had need of a guide in order to survive this "
"curse."
msgstr "너무 감상적으로 생각하지 마세요. 저는 이 저주에서 살아남기 위한 지침이 필요했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 0b4b7ef2-f171-4822-ab5f-3e0f9772b535
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0b4b7ef2-f171-4822-ab5f-3e0f9772b535
msgctxt "hf4abce35g0f2fg44c7g885ag10de999987f8"
msgid ""
"She can tend to the grove, help it heal. In time, others will join. Perhaps "
"some day I can return."
msgstr ""
"그녀가 숲을 돌보고 치유를 도울 수 있을 걸세. 시간이 지나면, 다른 이들도 함께하겠지. 언젠간 내가 돌아올 수 있을지도 모르고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 0bc62ea4-0277-36f5-8758-b93e6f47671d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0bc62ea4-0277-36f5-8758-b93e6f47671d
msgctxt "h5a14bf16gf773g4729g9587g75cb0818bf28"
msgid ""
"The Oak Father must have blessed you to make it this far, or another eye "
"above."
msgstr "여기까지 오기까지 참나무 아버지의 축복이 있었거나, 아니면 지켜보는 다른 눈이 있었을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 0cc2edec-cc88-48e7-9be2-b040dc65b78d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_DiscussedTadpoleResearch(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_TadpoleResearch = False
#.   Object:
#.      - SCE_State_PlayerVisitedEpilogue(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin_Event_DiscussedTadpoleResearch(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0cc2edec-cc88-48e7-9be2-b040dc65b78d
msgctxt "hc8cd9a3bg5939g44bfg8307g5300b87635fe"
msgid "I have to ask - how do you know so much about the parasite?"
msgstr "묻고 싶은 게 있습니다. 어째서 기생충에 대해 그렇게 잘 아는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 0dd0a824-dea4-4b96-afe6-2a0fd8d13a54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0dd0a824-dea4-4b96-afe6-2a0fd8d13a54
msgctxt "he9d3736fga766g4be5g92e5g29aadff8c821"
msgid "Perhaps - if we can find Thaniel's lost half, and make him whole again."
msgstr "가능해. 테니엘의 잃어버린 반쪽을 찾아 그를 완전하게 만들 수 있다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 0e03a7c9-fd97-440b-8e46-e74acf4a0342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0e03a7c9-fd97-440b-8e46-e74acf4a0342
msgctxt "hd811a073gfd64g4d59gbaadgaa4e49bcd874"
msgid ""
"I need her to stay focused on her training - the grove will need a skilled "
"healer in my absence."
msgstr "내가 없는 동안 숲에는 숙련된 치유사가 필요하니, 그녀가 훈련에 집중할 수 있게 해줘야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 0e4f5025-ecaf-48b0-bf6d-44ff765c96a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ElevatorToScl_Used = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0e4f5025-ecaf-48b0-bf6d-44ff765c96a0
msgctxt "h2c62942ag070eg47a2g9a8fg61fe62c1cbb5"
msgid "I found an elevator - but it leads right into the shadow curse."
msgstr "승강기를 찾았습니다. 하지만 바로 그림자 저주로 향하는 것 같더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 0e68778e-fe97-416a-9751-7cc2d6fcb3a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0e68778e-fe97-416a-9751-7cc2d6fcb3a1
msgctxt "h22cf970cg1616g4b87gab5ege845a38d15e3"
msgid "I'm glad I could help."
msgstr "도울 수 있어 기쁘군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 0eb7bff8-562e-48dc-9039-b09a7c7a11cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0eb7bff8-562e-48dc-9039-b09a7c7a11cd
msgctxt "h98668da7g99bcg4a40ga057g746dcd68d502"
msgid "Sounds like the grove will be in good hands then."
msgstr "그럼, 숲은 잘 돌아갈 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 0f9adefe-477b-4bf9-932b-1eee4327a974
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:0f9adefe-477b-4bf9-932b-1eee4327a974
msgctxt "h7e4319aeg41aag47e3g871cgbfd07263e06e"
msgid ""
"Keep looking. If they're present, then it's likely there's a route to "
"Moonrise somewhere."
msgstr "계속 찾아보게나. 그들이 거기 있다면, 문라이즈로 향하는 통로도 분명 근처 어딘가에 있을 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 10a85a3b-30dc-4cb4-8f9f-322327663d60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_RathIsPermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:10a85a3b-30dc-4cb4-8f9f-322327663d60
msgctxt "ha4725ec3g83d1g4b34g9a9cge4f6f3ce90f2"
msgid "What about one of the others? Rath, perhaps?"
msgstr "다른 드루이드 중에서는 어때요? 라스라든지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 139fadec-4912-fae3-9b9f-89a5fd98b3bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:139fadec-4912-fae3-9b9f-89a5fd98b3bb
msgctxt "hb2fee860g0331g4b28gad80gdea1a70a9d1e"
msgid "Is there something I can do to take your mind off things, perhaps?"
msgstr "혹시 제가 도와드릴 수 있는 일이 있을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 147f0020-b90f-48f0-8d1d-5e5219c47342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:147f0020-b90f-48f0-8d1d-5e5219c47342
msgctxt "hb6409eadgd1c6g4877g8a37gef68fa431e47"
msgid ""
"I knew something was wrong when he didn't wake up, but now I'm even more "
"certain."
msgstr "깨워도 일어나지 않아서 뭔가 잘못되었단 걸 알았지. 이젠 완전히 확신하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 155b2275-a08b-4948-9fd1-fef072d2ffd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - a0260ce0-84c8-2daa-27fd-648445acc5d0_Hasmet = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:155b2275-a08b-4948-9fd1-fef072d2ffd8
msgctxt "hcaa02d93gf593g4afag9e65g80ab0c754515"
msgid "Oak father's blessings to you."
msgstr "참나무 아버지의 축복이 있기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 157435bf-e38f-4149-97c3-969190b12a4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_ToldHalsinAboutOliver = True
#.      - HAV_LiftingTheCurse_State_HalsinWaitingInCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:157435bf-e38f-4149-97c3-969190b12a4c
msgctxt "h16c9ca9eg68b9g4783g9b74g148b49140a50"
msgid ""
"We need to find Oliver and get him to return to Thaniel. Otherwise this "
"curse will never be lifted."
msgstr "올리버를 찾아서 테니엘에게 돌려보내줘야 해. 안 그러면 이 저주는 절대 풀리지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 1628ca26-d8b3-4cc3-868c-c53702629842
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:1628ca26-d8b3-4cc3-868c-c53702629842
msgctxt "had28f1d3gd004g4cd0ga5acg4141897c4613"
msgid ""
"No more than my right hand can absorb my left. Oliver is helping Thaniel to "
"recover; they both lie dormant, like trees awaiting spring."
msgstr ""
"오른손이 왼손을 흡수할 수 없듯, 두 사람도 마찬가지지. 올리버는 테니엘이 회복하는 걸 돕고 있어. 봄을 기다리는 나무처럼, 둘다 휴면 "
"상태야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 177445a8-4ea8-89cb-392e-d28b1db5e898
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_AskedHowHalsinLikesCamp(1) = True
#.   Global:
#.      - CAMP_Halsin_Event_AskedFaringToday = False
#.      - CURRENTREGION_SCL_Main_A = True
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Event_AskedFaringToday = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:177445a8-4ea8-89cb-392e-d28b1db5e898
msgctxt "hb754f966g7c25g4a00g8d53g24f3126f7394"
msgid ""
"Still feeling at home here with us? The surroundings are less bucolic, I "
"understand..."
msgstr "아직도 우리와 있는 이곳이 집처럼 느껴지나요? 주변 환경이 덜 목가적이죠. 이해합니다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 1794ff23-4ca3-4026-92f0-c260ec969b0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = False
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:1794ff23-4ca3-4026-92f0-c260ec969b0c
msgctxt "hbac524f9g633dg40e1g9c28ga5e2f33e9630"
msgid ""
"I met a sort of shadow child before - a little boy named Oliver. Around "
"Thaniel's age."
msgstr "전에 그림자 아이와 비슷한 아이를 봤어요. 테니엘 또래의 올리버란 남자 아이였죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 182325d9-611b-4a2f-87e4-ddfd292706cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:182325d9-611b-4a2f-87e4-ddfd292706cf
msgctxt "h4f88e11eg0881g4ad3gb128gcb2e4ea42a62"
msgid "Won't this cause resentment?"
msgstr "이 결정이 원망을 사지는 않을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 18a286f5-0d6d-435a-aaaa-88aff5a3b662
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:18a286f5-0d6d-435a-aaaa-88aff5a3b662
msgctxt "hf045cd7dg31d1g4f82g89fdgf34c3a746c6d"
msgid "I'm just glad to be out here amidst the Oak Father's creations."
msgstr "나는 그저 참나무 아버지의 창조물들 사이로 돌아갈 수 있게 된 것이 기쁠 따름이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 18a3f07f-40cb-ec38-3c38-cba28caf203a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = False
#.      - Halsin_InParty_Even_ToldPlayerHisAge(1) = False
#.   Global:
#.      - IMPOSSIBLE = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:18a3f07f-40cb-ec38-3c38-cba28caf203a
msgctxt "h9d25fe17gf0c1g48cbgb4c5g20fb931afce4"
msgid "What now? You've got what you wanted, after all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 191be55e-9d1f-4ccc-bd63-e633cbe09644
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:191be55e-9d1f-4ccc-bd63-e633cbe09644
msgctxt "h56e8924egff3dg4212g9774geaa144c48efa"
msgid ""
"It's both simple and not - we need to find Thaniel's missing half, and make "
"him whole again."
msgstr "간단하기도 복잡하기도 해. 우린 테니엘의 잃어버린 반쪽을 찾아야 해. 다시 완전하게 만들어야 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 198edb40-b85a-407a-8a3a-976b3e023af8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:198edb40-b85a-407a-8a3a-976b3e023af8
msgctxt "hc6db183dgf32cg4c45ga7f4gd12cde16980f"
msgid "I'll be ready."
msgstr "준비하고 있을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 1a00cb63-3bcb-7e70-fd3a-f3d52660aeb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:1a00cb63-3bcb-7e70-fd3a-f3d52660aeb0
msgctxt "hdd082dd4gba16g4c8cgad07g41d740c584f5"
msgid ""
"Well if there's anything I can do to make you <i>less </i>comfortable, let "
"me know."
msgstr "당신을 <i>덜</i> 불편하게 할 수 있는 일이 있다면 알려주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 1aa195d1-100b-85c5-a678-c5b2a70f2457
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:1aa195d1-100b-85c5-a678-c5b2a70f2457
msgctxt "h2f1fd349g21adg44cdga03bgab7fd35a68e8"
msgid ""
"Perhaps... but best to not dwell on nights past. There are plenty more yet "
"to come."
msgstr "아마도... 하지만 지나간 밤에 연연하지 않는 것이 최선이지. 아직 더 많은 일이 남아있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 1be051ba-c227-33de-7754-45519a68aff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:1be051ba-c227-33de-7754-45519a68aff1
msgctxt "h46f61d0ag939dg4686gb632g97674ba64426"
msgid "Just try to make yourself useful."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 1ffd23b6-44e1-272a-a1d4-8e22cb9cbc91
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:1ffd23b6-44e1-272a-a1d4-8e22cb9cbc91
msgctxt "h092e92dfg0820g42a6g81fdg8884854e35f8"
msgid ""
"Prudent. But I hope we won't have to contend with the perils of the curse "
"for long. There's more to living than just survival. Much more."
msgstr "신중하군. 하지만 저주의 위험과 오랫동안 싸울 필요가 없기를 바라네. 삶에는 생존보다 더 많은 것이 있네. 훨씬 더."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 22748afa-fe9e-48ec-9670-aba94ab78266
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:22748afa-fe9e-48ec-9670-aba94ab78266
msgctxt "h7c664d7eg3048g4365g80ceg4195e895d4da"
msgid ""
"Once the curse is lifted, they can stand as one or as a pair. Whatever they "
"wish."
msgstr "일단 저주가 걷히면, 하나가 되거나 한쌍으로 살아갈 수 있어. 본인들이 바라는 대로 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 22f92319-e262-4411-9671-1d8fef27bab7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_AskedHowHalsinLikesCamp(1) = False
#.   Global:
#.      - CURRENTREGION_WLD_Main_A = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_AskedHowHalsinLikesCamp(1) = True
#.   Global:
#.     - CAMP_Halsin_Event_AskedFaringToday = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:22f92319-e262-4411-9671-1d8fef27bab7
msgctxt "hf7a64c0fg7ef1g4bf6gbfa7g4dc69d441e7a"
msgid "How're you faring out here at the camp?"
msgstr "야영지에서 지내본 소감은 어떤가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 23fa7785-30a0-c157-2c59-f17a045b4fc1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:23fa7785-30a0-c157-2c59-f17a045b4fc1
msgctxt "h375542dbg5e97g41b8g8499gd68148fa8a81"
msgid "Good lass. You're tougher than Blackwood."
msgstr "좋아 아가씨. 그대는 블랙우드보다 강인하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 23fa7785-30a0-c157-2c59-f17a045b4fc1
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:23fa7785-30a0-c157-2c59-f17a045b4fc1
msgctxt "h6164d58ag9ab1g437agb483gc4c71a070a4d"
msgid "Good lad. You're tougher than Blackwood."
msgstr "좋아 친구. 그대는 블랙우드보다 강인하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2499b847-7bcc-4b76-9932-32c0a5546da3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_CurseLiftedHasmet(1) = True
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2499b847-7bcc-4b76-9932-32c0a5546da3
msgctxt "h2519156dga961g4d7egbe4bg0f641caec001"
msgid ""
"I swear I can already feel a change in the air - like the curse itself knows "
"its time is short."
msgstr "공기 속에서 뭔가 변한 게 느껴져 - 마치 저주가 남은 시간이 동났다는 걸 아는 듯하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2569974a-d5e8-4098-bfd2-8d96b09f1b74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2569974a-d5e8-4098-bfd2-8d96b09f1b74
msgctxt "h30ac00e4g4b9ag42f0g80cbg1c1dcc722fca"
msgid ""
"Hideous - but fascinating. Like nothing else in nature, I'm glad to say."
msgstr "섬뜩하지만 매력적이었어. 자연의 그 어떤 것과도 비교할 수 없었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2659963b-4fa4-60ed-0c13-395f2a5f1ba5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2659963b-4fa4-60ed-0c13-395f2a5f1ba5
msgctxt "hcc2b00e6geedcg4f2cg8bc3ga47a25fb6912"
msgid "With such stimulating company? Never better."
msgstr "이렇게 활기찬 동료들과 함께라면? 이보다 더 좋을 수 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 274504a9-50a5-4ed1-b67e-b386f7995d7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Halsin_Knows_ShadowCurseMotivation = True
#.   Local:
#.      - a0260ce0-84c8-2daa-27fd-648445acc5d0_Responsible = False
#. SetFlags:
#.   Local:
#.     - a0260ce0-84c8-2daa-27fd-648445acc5d0_Responsible = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:274504a9-50a5-4ed1-b67e-b386f7995d7e
msgctxt "h32a5f5f7gd631g46b0g96b0g316305b945cf"
msgid "Seems like you feel responsible for this shadow curse somehow..."
msgstr "당신은 이 그림자 저주에 대해 왠지 책임감을 느끼는 것 같군요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 27882a87-e6aa-fe55-35b5-d93cf4bdb917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:27882a87-e6aa-fe55-35b5-d93cf4bdb917
msgctxt "h2b5f1c3fg63c3g4c5ag9ff7gba90df2b5054"
msgid ""
"You'll find plenty of books before long. I keep coming across them "
"everywhere."
msgstr "곧 많은 책을 찾을 수 있을 거예요. 여기저기서 계속 책을 발견하고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 278b07d4-ec66-4464-9a5d-424fa7bd9a40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:278b07d4-ec66-4464-9a5d-424fa7bd9a40
msgctxt "h9fd78d4fgc570g4779g933eg68ccf22e8047"
msgid ""
"I can't say for certain, but we'll see it come to pass long before this "
"place recedes behind us. Don't worry - all is at hand. We can depart "
"whenever you're ready."
msgstr ""
"확답을 줄 순 없지만, 우리가 여길 떠나 이곳이 더는 보이지 않을 때쯤 저주도 풀릴 걸세. 걱정 말게. 다 잘 돼 가고 있으니. 자네만 "
"준비됐다면 언제든 떠날 수 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 28c0a2da-83fc-58bb-03a5-fb4a28c11c6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:28c0a2da-83fc-58bb-03a5-fb4a28c11c6b
msgctxt "h68fa9a2ag30cbg4820g9303g2b8ea7e997be"
msgid ""
"I believe you when you tell me that your symptoms do not wholly align with "
"the makings of the parasite. But until we remove it, I doubt we will be able "
"to isolate the rest of your troubles."
msgstr ""
"그대의 증상이 기생충이 하는일과 전적으로 일치하지 않는다고 말했던 것을 믿네. 하지만 기생충을 제거하기 전까지는, 그대의 나머지 문제들을 "
"따로 떼어 놓을 수 있는지 의문이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2bd43299-3013-4a53-a56c-82061afa599e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2bd43299-3013-4a53-a56c-82061afa599e
msgctxt "hdda39669gf868g415cg9a6cg717e7ad37f72"
msgid ""
"Miss it? Oh dear no. It's a terrible burden; takes you away from nature and "
"forces you to deal with others' problems and personalities."
msgstr ""
"그리워한다고? 맙소사, 그렇지 않소. 오히려 극심한 부담이라오. 자연으로부터 멀어져야 하고 타인의 문제와 성격을 감당해야만 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2c4f76c1-af96-499c-bc66-4a64bec708d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2c4f76c1-af96-499c-bc66-4a64bec708d2
msgctxt "h69dfa0e7g70a8g4b0dga1dcg641f92903947"
msgid ""
"Resentment will spring up like mushrooms no matter what I do. You cannot "
"please everyone and you'd be a fool to try."
msgstr "내가 무엇을 하든 원망은 버섯처럼 솟아날 것이오. 모든 사람을 만족시킬 수는 없고, 그러고자 하는 것은 어리석은 일이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2d32212a-8402-4555-bf71-f7d13ca89753
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2d32212a-8402-4555-bf71-f7d13ca89753
msgctxt "he7d3ef0bgba6bg4ad3ga4c8g08aa2c9f6e7f"
msgid ""
"We must find Thaniel. He is the embodiment of nature's power, but... but he "
"is just a child. A child who has been trapped in this place for a hundred "
"years."
msgstr "테니엘을 찾아야 해. 그는 자연의 힘의 화신이지만... 하지만 그는 단지 아이일 뿐이야. 백 년 동안 이곳에 갇혀 있던 아이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2e5949e4-1324-4b72-9831-9d5e8045ff3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2e5949e4-1324-4b72-9831-9d5e8045ff3c
msgctxt "h1c86ca4dgd0b0g49a1gb561gbb0983e8465e"
msgid ""
"In truth, I'm not sure. This is beyond all reckoning. It's still part of "
"Thaniel, deep down, but it may not recognise that, or <i>want </i>to "
"recognise that."
msgstr ""
"솔직히 잘 모르겠어. 추측하기 무척 어려운 일이지. 그 정수는 테니엘의 일부일지라도, 내면으론 깨닫지 못하고 있을 수도, <i>깨닫고 "
"싶어 할 수도</i> 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2e8ff382-d983-49fd-ac18-dd2f2e16d82e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_GoToMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2e8ff382-d983-49fd-ac18-dd2f2e16d82e
msgctxt "hbd0c8e56g74dag40c6gaff9gb7f8805efe0e"
msgid "There'll be no firm answers until Moonrise Towers, I fear."
msgstr "하지만 문라이즈에 도착하기 전까지는 아무것도 확신할 수 없다오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 2f0f2a66-71d8-f98c-a731-2e6aee940705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#.   Global:
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:2f0f2a66-71d8-f98c-a731-2e6aee940705
msgctxt "hea916b0fg2032g4d06g8cfeg37f97fbb910b"
msgid ""
"I'd rather the shadow curse didn't linger just beyond the campfire... but "
"your company more than makes up for it."
msgstr "단지 야영지 너머에 그림자 저주가 남아있지 않기만을 바랐지... 하지만 그대들이 있어 훨씬 위로가 되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 329da151-d7d9-690f-6082-da4baad17744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:329da151-d7d9-690f-6082-da4baad17744
msgctxt "h15fd19e0gbd00g4bebgb541gc5ec69db2391"
msgid ""
"But... if I succeed, if I break the curse, then perhaps there will be time "
"for myself again. And for others."
msgstr "하지만... 내가 성공하면, 내가 저주를 푼다면, 그러면 내게 시간이 다시 생길지도 모르겠군. 다른 사람들에게도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 38d43d4f-476e-4cca-a885-df798274cfec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_AboutGrymforge = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:38d43d4f-476e-4cca-a885-df798274cfec
msgctxt "h28ff3c8bg6250g470bg8b4cg0f481e3e2d3d"
msgid ""
"It may prove impossible to avoid the shadow curse entirely, but if you find "
"any way to limit your exposure, seize it."
msgstr "그림자 저주의 영향을 완전히 피해 가는 것은 불가능할지도 모르지만, 노출을 최소화할 기회가 있다면, 반드시 사수하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 393dc2b3-a965-5780-7c53-f18c541f749f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:393dc2b3-a965-5780-7c53-f18c541f749f
msgctxt "h9c21a453ga966g42a5gbabbg0f7d3e94b568"
msgid "Black outs, fainting spells. I'm losing new memories every day..."
msgstr "기억상실, 실신. 매일 새로운 기억을 잃고 있어요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 3b03a9b7-813b-4533-be73-c5b49fd09966
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_LeaderMap = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:3b03a9b7-813b-4533-be73-c5b49fd09966
msgctxt "h7dc8ecadg3bdcg418aga755g6157b6279268"
msgid ""
"One of those who died had a clue that was supposed to help us find the "
"hidden entrance to the Underdark."
msgstr "죽은 이들 중 하나가 언더다크로 향하는 숨겨진 입구를 찾는 단서를 가지고 있었소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 3d2a8175-2ee3-44af-af1b-10fb0e9628c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:3d2a8175-2ee3-44af-af1b-10fb0e9628c1
msgctxt "hc61cff01g293dg4b72ga31bgc0a6f6c727f9"
msgid ""
"What stayed behind would have been the strongest part of him, but after all "
"these years left in darkness, corruption must have taken hold."
msgstr "남은 것은 그의 가장 강한 부분이었을 테지만, 오랜 세월을 어둠 속에서 지내다 보니 부패가 자리 잡았을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 3d518e3b-0ac8-3e3c-03fc-804a8ee935a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:3d518e3b-0ac8-3e3c-03fc-804a8ee935a5
msgctxt "h9106cecdg217fg4b95gaff7g0a8c1768cb3f"
msgid ""
"But friendship is no consolation trophy. I cherish the bond we have forged. "
"Whether it should grow into something else is not for me to predict."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 3e483fd5-55e1-c0cf-70db-b71c8e9bf8a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:3e483fd5-55e1-c0cf-70db-b71c8e9bf8a0
msgctxt "h50721cbdgf145g4c68g8306gc1df3aa71909"
msgid ""
"There are few things that are too strong for me. And cast those regrets "
"aside; you did not get caught up in the moment - you seized it."
msgstr "내가 과하게 여기는 것은 많지 않네. 후회는 떨쳐버리게. 그대는 분위기에 휩쓸리지 않았어. 기회를 잡았을 뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 3e77f2b9-9cf1-4e59-8e17-6cac2e610cee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_Dead = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:3e77f2b9-9cf1-4e59-8e17-6cac2e610cee
msgctxt "hfdea42dbga304g4378g8db1g5fdf052e4436"
msgid "Couldn't Nettie take over?"
msgstr "네티가 대신할 수는 없었나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 401e9cc5-21b3-6fb0-a05f-c5d64807914b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:401e9cc5-21b3-6fb0-a05f-c5d64807914b
msgctxt "hf70d1af2g42a2g4ac0ga19egbf78503055fc"
msgid ""
"Indeed, but we cannot yet say the same for you. I promised I would help you, "
"and I intend to keep that promise, however I can."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 41fd0f49-9cd4-4f20-b734-d8196c2523f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_TempleAccess_Event_PuzzleSolved = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:41fd0f49-9cd4-4f20-b734-d8196c2523f2
msgctxt "hf6fbc600ge2a7g41d6gaf9egb4debaa8427c"
msgid ""
"Aradin was convinced there was a hidden entrance in the temple of Selûne - "
"I'd start there."
msgstr "아라딘은 셀루네 신전에 숨겨진 입구가 있다고 확신했어. 나는 거기서부터 시작할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 42e2cb20-d540-4092-9138-e464192d3cb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:42e2cb20-d540-4092-9138-e464192d3cb7
msgctxt "h49422003g4357g49c1ga4eagca3898aab5e2"
msgid ""
"I've inspected a tadpole up close and seen the effects of them on the "
"Absolute's so-called 'True Souls.'"
msgstr "난 가까이서 올챙이를 관찰하고 그것이 절대자의 소위 '참된 영혼'이라는 이들에게 미치는 영향을 봤소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 42f23451-e367-4d14-a3ae-dc2a400aebb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - CURRENTREGION_WLD_Main_A = True
#.      - GLO_DuergarCamp_EverEnteredBefore = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:42f23451-e367-4d14-a3ae-dc2a400aebb2
msgctxt "h6ce81ad3g7071g4463ga3a8gb984afce56ef"
msgid "What about this secret stronghold in the Underdark? You must know more."
msgstr "언더다크에 있는 비밀 요새는 어떤가요? 더 아는 바가 있겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 434df5de-5992-41b4-9254-558b5ea717c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_GoToMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:434df5de-5992-41b4-9254-558b5ea717c0
msgctxt "h00498d17gcfd5g4fd5g8239gd717f601438a"
msgid ""
"If I can join you and get close to Moonrise, perhaps I can lift this curse "
"just as you find a cure for your infection."
msgstr "내가 그대와 함께 문라이즈에 다가갈 수 있다면, 이 저주를 풀고 그대의 감염을 치유할 방법을 찾을 수 있을지도 모르오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 43612c27-99ea-4029-bb4c-b672be584750
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0260ce0-84c8-2daa-27fd-648445acc5d0_Hasmet = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:43612c27-99ea-4029-bb4c-b672be584750
msgctxt "h716a64e1g4e49g465eg982ag7de2e7828129"
msgid "You wish to speak?"
msgstr "할말이라도 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 43c9e1d8-0610-43bf-8e19-fe75470f1615
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:43c9e1d8-0610-43bf-8e19-fe75470f1615
msgctxt "h4d6060a7g44a7g4597g893eg0e50abe512f8"
msgid ""
"But in my eagerness, I put far too much faith in the abilities of Aradin and "
"his band. We didn't even get close."
msgstr "하지만 간절함 때문에 아라딘과 그의 용병대의 능력을 너무 믿었소. 우린 심지어 가까이 가지도 못했다오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 4426db45-2756-4ffa-8d2d-5ef7f8637b4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:4426db45-2756-4ffa-8d2d-5ef7f8637b4e
msgctxt "hc61a4687gc302g4f6eg8e4dg1cd059379094"
msgid "Join me."
msgstr "함께 갑시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 44298d39-568b-422c-a0e4-31a7ede81b2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:44298d39-568b-422c-a0e4-31a7ede81b2a
msgctxt "hef423700g0b7cg4db0g84d3g7f078d986b8b"
msgid "I've got more exploring to do."
msgstr "탐색을 계속해 봐야겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 45775227-c393-4627-bc9a-b5af38ed93a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_WLD_Main_A = True
#.      - CAMP_Halsin_Knows_ShadowCurseMotivation = True
#.   Local:
#.      - a0260ce0-84c8-2daa-27fd-648445acc5d0_JoinedAradin = False
#.      - a0260ce0-84c8-2daa-27fd-648445acc5d0_UnfinishedBusiness = True
#. SetFlags:
#.   Local:
#.     - a0260ce0-84c8-2daa-27fd-648445acc5d0_JoinedAradin = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:45775227-c393-4627-bc9a-b5af38ed93a4
msgctxt "h49e51b97g8ac5g419dg8b17gc808363ec832"
msgid ""
"Is that why you went with Aradin? You thought he might find this route to "
"Moonrise?"
msgstr "그래서 아라딘과 함께 간 겁니까? 아라딘이 문라이즈로 가는 길을 찾을 수 있을 거라 생각해서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 45d01006-27c1-4717-a4c4-dad88bf2441d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:45d01006-27c1-4717-a4c4-dad88bf2441d
msgctxt "h5e5d6712gc2fcg466dg9c6agcd8671877ecd"
msgid ""
"By now, we should have seen some small glimmer of Thaniel's power - a sign "
"that the land is healing. New growth, flowers in bloom. But there has been "
"nothing."
msgstr ""
"지금쯤이면 테니엘의 힘이 조금이나마 돌아왔어야 해 - 새싹이 트고, 꽃이 피는 것처럼, 이 땅이 치유되고 있다는 신호도. 하지만 전혀 "
"없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 46b5d3d5-f804-3aed-b13a-6f9c0e411e10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:46b5d3d5-f804-3aed-b13a-6f9c0e411e10
msgctxt "h3f4d756bg703ag4951gba98gd6d4169a3c4d"
msgid "Maybe you could show your appreciation another way."
msgstr "아마 당신은 다른 방법으로 감사의 마음을 표현할 수도 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 47f9385c-1115-4b62-a824-3957c6e12640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:47f9385c-1115-4b62-a824-3957c6e12640
msgctxt "he4fb1fcfgbebag4f3aga728g12ec0d1be849"
msgid ""
"What Ketheric Thorm unleashed is not something that nature can undo by "
"itself. I must do what I can."
msgstr "케서릭 쏨이 풀어놓은 것은, 자연이 돌려놓을 수 없는 것이지. 난 내가 할 수 있는 것을 해야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 48275894-2d00-4fe8-b56f-eae467abf562
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_State_HalsinGoToLake = True
#.     - GLO_LiftingTheCurse_Event_TravelToLakeside = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:48275894-2d00-4fe8-b56f-eae467abf562
msgctxt "ha0cafa12gf305g4008g804ag06928d94c003"
msgid ""
"What comes next will prove dangerous. Meet me by the shore outside Last "
"Light - we can do our work there without imperilling others."
msgstr "위험한 일이 우릴 기다리고 있군. 피해를 끼치지 않고 일을 진행할 수 있도록 최후의 빛 여관 밖 호숫가에서 만나세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 4ce89534-faaa-f1eb-c334-307dca3c8cbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:4ce89534-faaa-f1eb-c334-307dca3c8cbd
msgctxt "h5642445bg14e1g43c0gaf89g3c983dbd01ba"
msgid ""
"I wish I could have found another fate for the Grove, but I appreciate all "
"you have done for me nonetheless."
msgstr "그 숲의 다른 운명을 찾았더라면 좋았을 텐데. 그럼에도 불구하고 나를 위해 해준 모든 일에 감사드리네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 4e18412f-2cb8-d67a-12c1-b5cbfaabfbb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:4e18412f-2cb8-d67a-12c1-b5cbfaabfbb5
msgctxt "h0e6c7cd5g0977g4c9egb037g3b0865a8e7eb"
msgid "A bad impression? Impossible."
msgstr "나쁜 인상? 있을 수 없는 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 4e88f227-78e1-4f24-917e-3d08eaeffb59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = False
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:4e88f227-78e1-4f24-917e-3d08eaeffb59
msgctxt "h420960c9g21ccg48e5g8fafg45af11063be5"
msgid ""
"I met a sort of shadow child before - a little boy named Oliver. Around "
"Thaniel's age."
msgstr "전에 그림자 아이와 비슷한 아이를 봤어요. 테니엘 또래의 올리버란 남자 아이였죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 4ee6e15b-5fea-4975-9cd4-4122f6c3f50a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:4ee6e15b-5fea-4975-9cd4-4122f6c3f50a
msgctxt "h8cd90deeg6530g4164g8320gf5255ed3ffd8"
msgid ""
"He's still fighting. The curse hasn't won yet, but he'll need our help if "
"he's to recover."
msgstr "그는 여전히 싸우고 있다네. 아직 저주가 완전히 발현되진 않았지만, 회복하려면 우리의 도움이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 4f55bb9a-b31f-36c9-4c2d-ddcf9cd441a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:4f55bb9a-b31f-36c9-4c2d-ddcf9cd441a4
msgctxt "h4b51be9dg5c3eg4d8dg8bd5g8b2a3fa45317"
msgid ""
"A haunting has come upon you, but the first step is this admission you have "
"now made. You will not walk alone into this night, remember that."
msgstr "그대에게 괴로움이 닥쳐왔지만, 지금 그대가 한 이 고백이 첫 걸음이라네. 그대는 이 밤을 혼자 걷지 않을 거야. 명심하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 50d75e8b-d3f0-5db2-d0e6-dee9f2477419
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:50d75e8b-d3f0-5db2-d0e6-dee9f2477419
msgctxt "h761c8aa3g26f3g4b0fg9ceege08891ccc4f8"
msgid "Honestly? Let's just forget it ever happened."
msgstr "있잖아요. 그냥 없었던 일로 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 51efe586-da71-7429-a599-81bb65c6d98e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:51efe586-da71-7429-a599-81bb65c6d98e
msgctxt "h78b31143g2d4eg404egbbb3g7a0551a9c47d"
msgid "I'm glad to have you."
msgstr "다시 함께하게 되어 기쁘군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 51fde514-45b2-4a27-bc91-187439a13edd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinWaitingInCamp = True
#.      - GLO_LiftingTheCurse_State_HalsinRecruitable = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:51fde514-45b2-4a27-bc91-187439a13edd
msgctxt "h5a96d3a3g4f33g41fdgb3fbg982cc5c90070"
msgid ""
"Thaniel is resting - but it's no easy slumber. I discovered what's wrong "
"with him."
msgstr "테니엘은 쉬고 있지만 쉽게 잠들지 못하고 있어. 무엇이 문제인지는 알아 냈어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 529d596c-5d51-928e-fab4-3dc2e90126e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:529d596c-5d51-928e-fab4-3dc2e90126e5
msgctxt "h6eefc4a0g5afcg4a96g810fg6ac49629d41a"
msgid "In other circumstances, I would have done the same."
msgstr "상황이 달랐다면, 나 또한 마찬가지였을 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 547bc15d-27b6-4fd7-85ed-a6b2af6f40b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = True
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:547bc15d-27b6-4fd7-85ed-a6b2af6f40b5
msgctxt "h4672d446gb2a1g4451g8fedga5a7a4a71175"
msgid ""
"I met a shadow child named Oliver, resembling Thaniel - but he's dead now."
msgstr "테니엘을 닮은 올리버란 이름의 그림자 아이를 만난 적 있어요 - 지금은 죽었지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 5869e25d-1bce-4074-8915-6c22e806c522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:5869e25d-1bce-4074-8915-6c22e806c522
msgctxt "he07e4174g3c40g405fg8010gb37803e4b93a"
msgid ""
"The shadows rended him in two when they bore him away to the Shadowfell. "
"Half of his essence remained here, amidst the curse."
msgstr "테니엘이 섀도펠로 끌려갔을 때 그림자가 그를 둘로 쪼갰지. 영혼의 절반은 저주에 둘러싸인 채 여기 남아있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 59479dce-45ea-4ada-aa7d-448743cc1a20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_CurseLiftedHasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:59479dce-45ea-4ada-aa7d-448743cc1a20
msgctxt "h40cb3c1dgf866g44e2g82ccgc63b9431c59b"
msgid ""
"Thaniel rests well. He's healing very rapidly, now that Oliver has returned "
"to him."
msgstr "테니엘은 잘 쉬고 있어. 이제 올리버가 돌아왔으니 , 더 빠르게 회복하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 59bb1ab8-598f-474c-965a-e47e5f5d2d19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:59bb1ab8-598f-474c-965a-e47e5f5d2d19
msgctxt "h48e237b5g7d9dg4773g8c60gaee946f87067"
msgid ""
"Those who remained are shadow-cursed. If you don't die at their hands, then "
"you become one of them."
msgstr "남아있던 자들은 그림자에 저주받고 말았지. 그들의 손에 죽지 않더라도, 그들 중 하나가 되고 말 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 5ccf08e5-36ea-4180-b3c3-15bcd5b00e3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:5ccf08e5-36ea-4180-b3c3-15bcd5b00e3c
msgctxt "h1082d626g0c43g462fgb41agf288c64fc996"
msgid "What should I look for, exactly?"
msgstr "정확히 무엇을 찾아야 하나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 5d649359-954b-4b7d-9a4f-776f5c2292aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:5d649359-954b-4b7d-9a4f-776f5c2292aa
msgctxt "haeced89cg26c5g4fd8g8fceg87d4c4c3c1e5"
msgid ""
"Rath has promise, but he's not ready yet. The grove needs experience and a "
"strong hand."
msgstr "라스는 성장할 가능성이 있지만, 아직 준비가 되지는 않았어. 이 숲에는 더 경험이 많고 강력한 전문가가 필요하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 5e309760-7a65-47cc-a759-f78bfb4548d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:5e309760-7a65-47cc-a759-f78bfb4548d7
msgctxt "h1fecabf1g5b4bg4e89g9777g167b6298a79b"
msgid ""
"I studied one up close - closer than most would care to be to those things."
msgstr "나는 그중 한 마리를 대부분 사람들이 관심을 가지고 관찰하는 수준보다 더 자세히 연구했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 62634243-6608-46db-87da-84aa82c37515
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:62634243-6608-46db-87da-84aa82c37515
msgctxt "h736febb1g98b0g4fe3g9c77ga512f2f31495"
msgid ""
"But if we can find him, we can break the curse. If you learn anything of the "
"Shadowfell, or of a boy with the forest in his eyes, find me at once."
msgstr ""
"하지만 그를 찾을 수 있다면 저주를 풀 수 있네. 섀도펠이나, 눈에서 숲이 보이는 소년에 대해 아는 게 있으면 즉시 날 찾아주게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 63d9f849-2d16-44de-ac9d-5516efb2bb66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:63d9f849-2d16-44de-ac9d-5516efb2bb66
msgctxt "h49586ddbgca9dg4847gb14cgfb17d46c282b"
msgid ""
"Look for signs of life in the darkness. Wildflowers, where everything else "
"is dead. The curse cannot subdue the power Thaniel bears. Not entirely."
msgstr ""
"어둠 속에서 생명의 흔적을 찾아봐. 야생화, 그 외엔 모든 것이 죽어버린 곳. 그 저주로는 테니엘이 지닌 힘을 제압할 수 없어. 완전히는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 65bc1ed8-87a2-43b2-8d66-9a928189dd9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_AskedAboutOliver(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedAboutOliver(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:65bc1ed8-87a2-43b2-8d66-9a928189dd9b
msgctxt "h3e00a4abg4e52g4627gbb9agbcab82a20e56"
msgid "What happened to Oliver, exactly? Did Thaniel... absorb him?"
msgstr "올리버에게 정확히 무슨 일이 있었던 거죠? 테니엘이... 그를 흡수한 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 65d74627-2e09-4b47-ac34-d3190a6692d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:65d74627-2e09-4b47-ac34-d3190a6692d8
msgctxt "h76f4410cg37c1g40c3gb368g20ebe9ecb8f2"
msgid ""
"Perhaps there's still a way to learn something from him - the dead can't "
"deny their knowledge, if asked the right question."
msgstr "그래도 그에게서 얻을 만한 정보가 있겠지 - 망자에게 질문만 제대로 하면, 모른다고 하진 못할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 677e01d1-39ff-47f7-992b-42b1f5153673
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:677e01d1-39ff-47f7-992b-42b1f5153673
msgctxt "he3d1ee88ge896g4fd4ga3dbgb46d4f3cb6ea"
msgid ""
"Those illithid creatures threaten the natural order - it's my duty to do "
"what I can to stop them."
msgstr "일리시드 생명체들이 자연의 질서를 위협하고 있소. 이를 막기 위해 최선을 다하는 것이 내 의무라오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 6b1f064c-0693-4041-92b1-f29044234c6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6b1f064c-0693-4041-92b1-f29044234c6a
msgctxt "hedf2fb28g327dg44eeg9f60g25c6e76b45d0"
msgid ""
"This doesn't have to be your burden alone. Every moment counts, and I've "
"asked much of you already without being at your side."
msgstr "이 무거운 짐을 홀로 지지는 마. 매 순간이 중요해. 게다가 난 함께 해주지도 못했는데, 너무 많은 부탁을 한 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 6b353fd3-396b-8735-eec2-00a1dc06cf05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6b353fd3-396b-8735-eec2-00a1dc06cf05
msgctxt "h360c3b30ga2c3g44edg8415gd645259ddd45"
msgid ""
"And I am glad to be at your side. I just hope an old bear can prove to be of "
"some service to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 6ba1866b-1754-9e67-75db-64f7ccaf4687
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = False
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = True
#.      - Halsin_InParty_Even_ToldPlayerHisAge(1) = False
#.   Global:
#.      - IMPOSSIBLE = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6ba1866b-1754-9e67-75db-64f7ccaf4687
msgctxt "h7518d6cfgf223g4fa3gab0fg61ac357dfbee"
msgid "What now? You've got what you wanted, after all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 6be29bde-1f6e-4828-be2d-ad52aaff4ff2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6be29bde-1f6e-4828-be2d-ad52aaff4ff2
msgctxt "h1d1cae15gada9g4434g8455gb206020e0b8f"
msgid ""
"That sounds like what you need. But the next part of the journey mightn't be "
"straightforward - or safe."
msgstr "그게 그대에게 필요한 것 같군. 하지만 여정의 다음 부분은 그리 간단하지 않을 수도 있소, 안전하지도 않을 것이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 6c80290d-5cc9-4706-a711-3c31a575b90c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_AboutGrymforge = False
#.      - CURRENTREGION_WLD_Main_A = True
#.      - GLO_DuergarCamp_EverEnteredBefore = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6c80290d-5cc9-4706-a711-3c31a575b90c
msgctxt "h7a62d4a1gcb48g46a5g956eg2253bdee200c"
msgid ""
"I found the stronghold in the Underdark you mentioned - a place called "
"Grymforge."
msgstr "당신이 얘기한 언더다크 요새를 찾았습니다. 그림포지라고 불리는 곳이더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 6ca9a14b-ed3e-f0f5-9c2a-13637618ed73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Halsin2_State_GaveSCLGreeting = False
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6ca9a14b-ed3e-f0f5-9c2a-13637618ed73
msgctxt "haf587a86g7a1bg409aga255gdf27df1e80b5"
msgid ""
"The shadow curse is upon us. As foul as I remember it - perhaps even worse."
msgstr "그림자 저주가 우리를 덮쳤네. 내 기억으론 끔찍했고, 어쩌면 더 끔찍할 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 6cad82da-7254-44bc-decd-33438d91089e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_Event_AddOliversHouseToMap = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6cad82da-7254-44bc-decd-33438d91089e
msgctxt "hc26ba74eg5684g4ac0g951eg89a281b28e27"
msgid ""
"There is a ruin, some way outside of Last Light. I caught a glimpse of fresh "
"blooms there, but did not investigate further. I shall mark it upon your map."
msgstr ""
"최후의 빛에서 멀지 않은 곳에 폐허가 하나 있다네. 거기서 생생하게 핀 꽃을 스치듯 봤지만, 더 조사해 보진 않았어. 자네 지도에 표시해 "
"줌세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 6f0d4ddd-2006-46c9-bd91-2e1ebbe9b853
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6f0d4ddd-2006-46c9-bd91-2e1ebbe9b853
msgctxt "h98807efcg599bg43f8ga0d0g204e11de0a0c"
msgid "Don't worry - if you find something, you will know it."
msgstr "걱정하지 마시오 - 만약 그대가 뭔가 발견한다면 저절로 알게 될 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 6fc9f1da-b75f-4e4f-aba9-58a242908154
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:6fc9f1da-b75f-4e4f-aba9-58a242908154
msgctxt "h724a9387g7fc2g4c2dgb508gafa1cf3d6b0b"
msgid ""
"I helped overthrow Ketheric Thorm and his Dark Justiciars years ago. But I "
"failed to prevent him from unleashing darkness across the region before he "
"was defeated."
msgstr ""
"여러 해 전에, 난 케서릭 쏨과 그의 다크 저스티시어들을 타도하는 데 기여했지. 하지만 놈이 패배하기 전에 이 지역에 어둠을 풀어놓는 "
"것을 막진 못했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 70c6bcb4-3eaf-d126-5237-ad3147d3c5cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:70c6bcb4-3eaf-d126-5237-ad3147d3c5cd
msgctxt "h27cb0cfcg46c3g475fg9531g6b949d63ac16"
msgid "Try as I may, I cannot stop thinking about death."
msgstr "아무리 노력해도 죽음에 대한 생각을 멈출 수가 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 70c84b3a-3927-4997-a4b9-bff17a809f21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Lockdown_State_Active = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:70c84b3a-3927-4997-a4b9-bff17a809f21
msgctxt "hd097cd8fgce56g4c59g918cgfbad0fbf1f12"
msgid "What will happen to the grove now?"
msgstr "이제 숲은 어떻게 되는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 73fb4bd4-66ab-4436-abf2-24d12ea5713b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:73fb4bd4-66ab-4436-abf2-24d12ea5713b
msgctxt "h02723b95gb304g4e49gb6aag5e38bd3a1c0d"
msgid ""
"No, my friend. The only thing I ask of you is to allow me by your side on "
"the road ahead. I still owe you a debt, and I intend to pay."
msgstr ""
"아니야, 친구. 내가 바라는 건 계속해서 나란히 함께 여행하는 것밖에 없어. 자네에게 갚지 못한 빚이 아직 있지, 그걸 갚을 셈이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 741eee0e-0141-1580-2635-cd1605721d2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:741eee0e-0141-1580-2635-cd1605721d2c
msgctxt "h4925af6fg97e0g4a33g83cdgdf69eb014e43"
msgid ""
"Perhaps so, or perhaps not. I had wondered if I had detected something else "
"once... but I must have been mistaken - my admiration for you, conflated "
"with other feelings."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 7482ed43-e03a-4b07-a04b-585519924c97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7482ed43-e03a-4b07-a04b-585519924c97
msgctxt "h53a11e3dga4a9g4e16g8734gc12eb4a20b01"
msgid ""
"And you saw this boy yourself? That can't be a coincidence - but we need to "
"be sure."
msgstr "그 아이를 직접 본 건가? 우연일 리가 없어 - 하지만 그래도 확실히 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 781e5b04-2570-4ffc-8a10-18559b7ac65f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:781e5b04-2570-4ffc-8a10-18559b7ac65f
msgctxt "h0d7efb86g5e59g4ac9ga6f5g7c1075742c30"
msgid ""
"A <i>survivor? </i>Silvanus blesses us - this could be just the person we "
"need to speak to."
msgstr "<i>생존자?</i> 실바누스께서 축복을 내려주시는군. 얘기 해봐야 할 바로 그 사람일 수 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 78b034de-55d9-6147-6f83-a5b54b5d6756
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = False
#.      - Halsin_InParty_Even_ToldPlayerHisAge(1) = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:78b034de-55d9-6147-6f83-a5b54b5d6756
msgctxt "hdba266b6g1195g4353gb391g12cf24ca0219"
msgid "What now? You've got what you wanted, after all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 78c99f5e-c5f0-492b-9773-9637ba2cae4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:78c99f5e-c5f0-492b-9773-9637ba2cae4a
msgctxt "ha3ae013ag9b43g4707g8575gc944463774e1"
msgid "Very shrewd of you."
msgstr "좋은 통찰력이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 7904bc41-2e21-46ba-9d26-d81bbab57bab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - OriginAddToParty(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7904bc41-2e21-46ba-9d26-d81bbab57bab
msgctxt "h36923cd2g21c1g4416g8842gc9f8611c97e6"
msgid "Good. Now our roots can deepen - together."
msgstr "좋아, 이제 우리의 뿌리가 함께 깊어지겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 797e660c-6bca-482d-b345-b5c113f5c043
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_MaxPlayerCountReached = True
#. SetFlags:
#.   Global:
#.     - GLO_Tutorials_FullPartyRejection = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:797e660c-6bca-482d-b345-b5c113f5c043
msgctxt "hef73916ageac7g4a4cgaa57g555d10ea864f"
msgid ""
"Seems your ranks are quite packed. If some space frees up, I'll be ready for "
"you."
msgstr "일행이 꽉 찬 것 같군. 자리가 나면, 합류하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 79a1c8fd-721a-4abf-bd13-971cabd0b4f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = False
#.      - CURRENTREGION_SCL_Main_A = True
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:79a1c8fd-721a-4abf-bd13-971cabd0b4f0
msgctxt "hec66459dgf45cg41efgb635g35b4163b7c2c"
msgid ""
"This land is more than just soil and rock, root and leaf... it is a living "
"being, in the form of a young fey boy, with the forest itself in his eyes. "
"His name is Thaniel - I've met him, in my meditations."
msgstr ""
"이 땅은 단순한 흙과 바위, 뿌리와 잎사귀 그 이상이야... 그것은 숲 그 자체를 눈에 담고 있는 어린 페이 소년의 형태로 살아있는 "
"존재라네. 그의 이름은 테니엘. 명상 중에 그를 만났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 7b7fa5e3-5ca4-41ef-b4a2-39177f22fd7f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_Event_RestoreAtHouse = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7b7fa5e3-5ca4-41ef-b4a2-39177f22fd7f
msgctxt "h6e6cb0ffg6db7g40e2g8888g605ea8e88b9d"
msgid ""
"Perhaps not - if he truly is a part of Thaniel, then he is beyond life and "
"death. More likely he's just hiding. We should return to where you saw him."
msgstr ""
"죽지 않았을 거야 - 그 애가 테니엘의 일부라면, 생사는 초월했을 테니까. 그냥 숨어 있을 가능성이 크지. 네가 그 애를 본 장소로 "
"가봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 7bf57047-fa18-410b-ada0-438bba1c76ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7bf57047-fa18-410b-ada0-438bba1c76ea
msgctxt "hd3c055d6gcd81g4338g9e7ag4f6b85c6d44c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 7c106c5f-0eb5-d163-e95f-091cbe12dae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7c106c5f-0eb5-d163-e95f-091cbe12dae7
msgctxt "h1de2636ag3683g4952gb2a4ga13ca2e5969d"
msgid ""
"In fact, I saw just the sort before, not long after we first came within "
"reach of the shadow curse. Fool that I am, I did not grasp their "
"significance at the time."
msgstr "사실 전에 무척 비슷한 걸 봤어. 그림자 저주가 닿은 곳에 막 도착했을 때였는데, 바보처럼 그땐 그 의미를 알아차리지 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 7c3ce250-f9be-4f08-baf5-38dce80eadb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7c3ce250-f9be-4f08-baf5-38dce80eadb7
msgctxt "hc0efd937g8509g4ff1g95b7g00ff77623538"
msgid "I'll trust your judgement."
msgstr "당신의 판단을 믿겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 7c46809b-22a2-4845-8a99-126941e77f42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7c46809b-22a2-4845-8a99-126941e77f42
msgctxt "h498718afg5541g4fc7ga12bg60700e494178"
msgid ""
"The grove needs to move beyond the mistakes of the past. What it needs is an "
"unknown quantity; an outsider who can enforce the Oak Father's teachings "
"without bias."
msgstr ""
"이 숲은 과거의 실수를 넘어서기 위해 낯선 것들이 많이 필요하오. 바로 참나무 아버지의 가르침을 편견 없이 행할 수 있는 외부인이라오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 7cffa239-4409-50ac-d10f-424894f42dca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7cffa239-4409-50ac-d10f-424894f42dca
msgctxt "h1441a46bge622g486cg9ca2g99dfc5ce77b9"
msgid ""
"More good has been done since I met you than in a hundred years before. "
"Words cannot express my gratitude."
msgstr "그대를 만난 후 지난 백년보다 더 많은 선한 일들이 이루어졌다네. 말로 다 표현할 수 없을 정도로 고맙네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 7e367aa1-e670-d387-fc90-afa9eb5b59b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:7e367aa1-e670-d387-fc90-afa9eb5b59b4
msgctxt "h655a2b64g5236g46beg9e4bgfa7bebb8d576"
msgid ""
"Sleepwalking... hallucinating creatures... the temptations... I could lose "
"myself before I make it to a cure."
msgstr "몽유병... 환각에 시달리고... 유혹에 시달리고... 치료되기 전에 나 자신을 잃을 수도 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 827cdbf9-de49-1349-f77e-a63c4cf044cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_Halsin_BranchExhausted(1) = True
#.      - CAMP_Halsin2_Event_TieflingCelebrationFollowup(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_TieflingCelebrationFollowup(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:827cdbf9-de49-1349-f77e-a63c4cf044cb
msgctxt "hd7892868ga893g481agb945g68dbacab9388"
msgid ""
"At the celebration before - I may have came over too strong perhaps. Got "
"caught up in the moment."
msgstr "전에 있었던 축하 행사에서 제가 너무 흥분했던 것 같아요. 순간에 휩쓸려서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 83638d8e-72d2-066e-3aff-a0583830c3be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:83638d8e-72d2-066e-3aff-a0583830c3be
msgctxt "h63077166g82e4g4e1bgadc4gfc33706a9147"
msgid "I shall do my utmost."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 84f7146f-eff8-46b8-b12c-2e9384d2f192
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:84f7146f-eff8-46b8-b12c-2e9384d2f192
msgctxt "he085ec94g89d6g4429g910ag055b0d9d116c"
msgid "Danger. Are you sure that's the best way to Moonrise?"
msgstr "위험해 보이던데, 그게 문라이즈 타워로 가는 가장 좋은 방법인 게 확실합니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 86feceba-2c2d-25bf-3acc-26eb7a848541
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:86feceba-2c2d-25bf-3acc-26eb7a848541
msgctxt "hfff91df5g632dg4a00gbcb2g46a94f965ab5"
msgid ""
"Is that so? Well, nature does abhor waste... I will keep watch, thank you. I "
"had a feeling time in your company would prove fruitful."
msgstr "그런가? 자연은 낭비를 싫어하지... 계속 지켜봐야겠군, 고맙네. 그대들과 함께하는 시간이 결실을 맺을 거라는 느낌이 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 87620098-7ad8-4f05-8b6d-32d3e0d25193
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:87620098-7ad8-4f05-8b6d-32d3e0d25193
#, fuzzy
#| msgid ""
#| "No matter how it's been twisted by the shadows, it is still part Thaniel's "
#| "essence - it will resemble him somehow, and may show signs of his power."
msgctxt "h2d25e5e9gbec5g45d0g9187g95b2dd7c7fce"
msgid ""
"No matter how it's been twisted by the shadows, it is still part of "
"Thaniel's essence - it will resemble him somehow, and may show signs of his "
"power."
msgstr ""
"그림자에 의해 어떻게 뒤틀렸더라도 그건 여전히 테니엘 본질의 일부야. 어쨌든 그와 닮았을 테고 그의 힘의 징조를 보여줄 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 87ad2778-7f86-4d32-a3e4-73d2d3a2f544
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:87ad2778-7f86-4d32-a3e4-73d2d3a2f544
msgctxt "hd8dde8fag6012g4fc3gbb57g6357a9cc0a70"
msgid ""
"A drow attacked me and I defended myself. Afterwards, I was able to examine "
"the tadpole that emerged."
msgstr "어떤 드로우가 나를 공격했고, 나는 내 몸을 방어했네. 그 후에 튀어나온 올챙이를 조사할 수 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 882d962f-b479-2c35-b0bf-2ceb8f475b73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:882d962f-b479-2c35-b0bf-2ceb8f475b73
msgctxt "h199075a6g579cg419ag9fcagf456eef43def"
msgid ""
"I am here to be your ear, as you bear your burdens, and the arms that "
"protect you, if you can shoulder them no more."
msgstr "그대가 짐을 짊어질 때 그대의 귀가 되어주고, 그대가 더 이상 짐을 짊어질 수 없을 때 그대를 보호하는 팔이 되겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 8b7a142e-b6dc-4052-be21-76aa1397405a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:8b7a142e-b6dc-4052-be21-76aa1397405a
msgctxt "h0d1d56d2geb32g450ag80cfgd553b067b8d1"
msgid ""
"Only, the missing half may not come willingly. The curse will have sunk its "
"tendrils deep, twisting Thaniel's essence into something... else."
msgstr ""
"하지만, 잃어버린 반쪽은 스스로 돌아오지 않을 수도 있어. 저주가 그 뿌리를 깊이 내리고, 테니엘의 본질을 다른... 무엇으로 왜곡했을 "
"거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 8c8ea60c-1062-4e93-a72e-2a16b229a2ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:8c8ea60c-1062-4e93-a72e-2a16b229a2ac
msgctxt "h940728b3g9a51g4ae6ga2c2gaf904e0ffab4"
msgid ""
"I can't be exact, unfortunately. Time and the shadow curse won't have been "
"kind to any traces that would have been left behind."
msgstr "안타깝게도 정확히는 알 수 없네. 시간과 그림자의 저주는 남겨진 흔적에 친절하지 않았을 것이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 8cfdd2f2-db80-47ab-9e0d-70f5595748c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:8cfdd2f2-db80-47ab-9e0d-70f5595748c5
msgctxt "hf1d3e576g22f8g4fbbg81afg764a8927aef8"
msgid "Once Thaniel's essence is found, what then?"
msgstr "테니엘의 정수를 발견하고 그 후엔?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 8e72923f-7ea0-456d-b2d0-c1863378943a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:8e72923f-7ea0-456d-b2d0-c1863378943a
msgctxt "h9ae4d80fgfd5eg47e2g8d2fg69c073ec0a11"
msgid ""
"Tread carefully. You're on the right track, I'm sure - but there'll still be "
"danger and difficulty before you reach Moonrise."
msgstr ""
"조심해서 나아가시오. 확실히 올바른 방향으로 향하고 있긴 하지만, 문라이즈에 도착할 때까지 어떤 위험과 어려움이 도사리고 있을지 모르오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 8fae4065-aa9f-2393-fd49-a865e17f43ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:8fae4065-aa9f-2393-fd49-a865e17f43ef
msgctxt "hf5a97d44gce75g40a8gaebeg91e145f9ca3f"
msgid ""
"I can think of a thing or two... but in truth, it is for the best that the "
"curse consumes my thoughts for now. This is the best chance I've had in a "
"century - I cannot squander it."
msgstr ""
"한두 가지 생각나는 게 있긴 하지만... 사실 지금은 저주에 대해 생각하는 게 최선이네. 이건 백년 만에 찾아온 최고의 기회인데 낭비할 "
"수 없다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 8fe08898-e6b5-7371-9ad6-684404a63742
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_AskedHowHalsinLikesCamp(1) = True
#.   Global:
#.      - CAMP_Halsin_Event_AskedFaringToday = False
#.      - CURRENTREGION_WLD_Main_A = True
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Event_AskedFaringToday = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:8fe08898-e6b5-7371-9ad6-684404a63742
msgctxt "h8c97aaa8gd0b6g4179g81f3g46f6bde4fd81"
msgid "You're still faring well at camp, I hope?"
msgstr "야영지에서 잘 지내고 계시죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 91486419-1ca7-4ceb-993e-088db4aefacd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:91486419-1ca7-4ceb-993e-088db4aefacd
msgctxt "h9cfe3429gb21bg4d75g99c1gf968bf5fccbc"
msgid ""
"Let me help you then. Every moment counts, and I've asked much of you "
"already without being at your side."
msgstr "내가 돕겠어. 매 순간이 중요해. 함께 해주지도 못했는데, 이미 너무 많은 부탁을 한 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9149e104-b385-b170-99a2-e1d011086b8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9149e104-b385-b170-99a2-e1d011086b8f
msgctxt "hf16e4f16g2552g4864g9f8egbf6184914de7"
msgid "Not what. <i>Who.</i> But all in due course."
msgstr "물건이 아니라 <i>사람</i>이야. 하지만 때가 되면 말해주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 933b5f66-af3e-4bad-938f-ce2f223c43de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:933b5f66-af3e-4bad-938f-ce2f223c43de
msgctxt "h70ce430cg2fb0g4d51ga031gf99655b6bd09"
msgid "You're sending me to look for a needle in a haystack. In the dark."
msgstr "나에게 건초 속 바늘을 찾으러 가라는 소리로 들리는데요. 이 어둠 속에서 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 942a0e4a-f5a4-4a35-9ab8-d71fbb05029f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:942a0e4a-f5a4-4a35-9ab8-d71fbb05029f
msgctxt "h31f72c09g80d8g4e17gbeb1g91ce53e6c91e"
msgid "First and only Druid. What will Francesca even do here?"
msgstr "최고이자 유일한 드루이드겠죠. 프란체스카가 대체 여기서 할 수 있는 게 있긴 한가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 954847d8-d034-6d98-b3c2-aeaf4bf7fcd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_GoblinHuntCelebration_Halsin_BranchExhausted(1) = True
#.      - CAMP_Halsin2_Event_TieflingCelebrationFollowup(1) = False
#.   Global:
#.      - CURRENTREGION_WLD_Main_A = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_TieflingCelebrationFollowup(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:954847d8-d034-6d98-b3c2-aeaf4bf7fcd7
msgctxt "h8a4bb07bgfc95g433fgb396g392e4d716560"
msgid ""
"At the celebration with the tieflings before - I hope I didn't come over too "
"strong. Got caught up in the moment."
msgstr "티플링들과의 축하 자리에서 제가 과하게 들이댔던 건 아니었으면 좋겠어요. 분위기에 휩쓸렸네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 95d6e4cd-1579-f79b-2be1-d4a9853a2713
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = False
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = True
#.      - Halsin_InParty_Even_ToldPlayerHisAge(1) = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:95d6e4cd-1579-f79b-2be1-d4a9853a2713
msgctxt "h3152a775g6679g4457gb74cgfb9e26c255d4"
msgid "What now? You've got what you wanted, after all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 95f969e7-f323-4128-80cd-1bdaa63d6f2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ElevatorToScl_Used = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:95f969e7-f323-4128-80cd-1bdaa63d6f2a
msgctxt "h622a5571gf38cg423fg8572g2230ec173b98"
msgid "Absolute followers - but that's about all."
msgstr "절대자의 추종자들이 있더군요. 하지만 그게 전부였습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 970feb3a-29b8-438c-9509-90f7a3e7e67f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:970feb3a-29b8-438c-9509-90f7a3e7e67f
msgctxt "haf448af8g84bdg4173gbd7fgfd6565713b70"
msgid "I'll see what I can do, but no promises."
msgstr "뭘 할 수 있을지 보겠지만, 장담은 못 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 97437bc7-d46c-b5dc-5d61-2697dd306754
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin2_State_GaveSCLGreeting = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:97437bc7-d46c-b5dc-5d61-2697dd306754
msgctxt "hc2387ecfg8dd8g4f4bg98b1g1d1060f67097"
msgid ""
"But with the Oak Father's blessing, we may soon see it banished from these "
"lands."
msgstr "하지만 참나무 아버지의 축복으로 곧 이 땅에서 퇴치 되는걸 볼 수 있을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9747acd7-9c59-4234-8444-6841b6617c8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9747acd7-9c59-4234-8444-6841b6617c8e
msgctxt "h318a2ed6gb1f1g46bdg9bf2g2cc664a94e59"
msgid ""
"A fellow druid. I can count on her to tend to the grove in my absence, help "
"it heal."
msgstr "동료 드루이드요. 그녀라면 내가 없는 동안 이 숲을 믿고 맡길 수 있소, 치유하도록 도우면서 말이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 97e195ad-2c2b-496e-832c-eaea67d9faeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:97e195ad-2c2b-496e-832c-eaea67d9faeb
msgctxt "h30c2edb8g1efbg4556g9ebcg343d0848b27d"
msgid ""
"It is lost to me - lost to the world. Perhaps there'll be some way to unseal "
"it in the future..."
msgstr "그것은 나에게도, 세상에게도 잃어버린게 되었어. 어쩌면 미래에 그것을 봉인 해제할 수 있는 방법이 있을지도 모르지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 97fa3b7c-4ace-4d2e-960c-77d3767536cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_PermaDefeated = True
#.      - HAV_LiftingTheCurse_State_KnowsBreathLocation = True
#.      - GLO_LiftingTheCurse_Event_TravelToLakeside = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:97fa3b7c-4ace-4d2e-960c-77d3767536cb
msgctxt "h0265f08fgac89g4630g8e9dg4803fbacc3d8"
msgid "<i>Share what you learned of Thaniel's presence in the Shadowfell.</i>"
msgstr "<i>섀도펠에서 테니엘의 존재로부터 얻은 정보를 알려준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 983c1510-9688-6aa2-6fe7-17f5a0761293
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:983c1510-9688-6aa2-6fe7-17f5a0761293
msgctxt "hbc2805c8g4c0ag491bgb5aag08a739cc9b97"
msgid "Friends and nothing more, then?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9a6e3340-039d-4eb7-8054-014e2d858e95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9a6e3340-039d-4eb7-8054-014e2d858e95
msgctxt "h88cf1340g4db8g43c6g9531g01f2664dff34"
msgid ""
"Perhaps it can be reasoned with, but I'm not hopeful. Reason is not "
"something that thrives amidst the shadow curse."
msgstr "정수를 설득할 수 있을지도 모르지만 큰 기대는 없어. 그림자의 저주 한가운데서 이성을 붙들고 있기란 어려운 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9ad0110b-63d9-448f-b8d2-c2e1783faa98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9ad0110b-63d9-448f-b8d2-c2e1783faa98
msgctxt "h91149ce1g2594g45a1g99f3g81f6ee826efd"
msgid ""
"Still, I would like to return here some day. See Thaniel and Oliver again - "
"in my meditations, or perhaps in person, if the Oak Father wills it. I hope "
"he does."
msgstr ""
"그래도, 언젠가 여기 돌아오고 싶어. 명상 속에서나 현실에서 테니엘과 올리버를 만나고 싶군. 참나무 아버지가 허락하신다면 말이야. 그래 "
"주신다면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9b7b1777-c6e4-48aa-9fa8-59113c143af7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9b7b1777-c6e4-48aa-9fa8-59113c143af7
msgctxt "h9d6d1aa3g4926g40fcgbc03gcdd370805b7e"
msgid ""
"Well... there's hardly anyone left to share the responsibility with. Few who "
"witnessed the fall of Moonrise still draw breath."
msgstr ""
"그렇다네... 그 책임감을 나눌 수 있는 사람은 별로 남아있지 않아. 문라이즈의 몰락을 목격한 자들 중 지금도 숨쉬고 있는 자는 거의 "
"없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 9bff5655-4f4a-47ad-9cb5-d4a053bd3f6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Halsin_Knows_AppointedSuccessor = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9bff5655-4f4a-47ad-9cb5-d4a053bd3f6b
msgctxt "h8f44b100g0c4bg4925g9f26gf10b693e3e8f"
msgid ""
"It can't have been easy, surrendering your title. Won't you miss being First "
"Druid?"
msgstr "직함을 내려놓는 결정이 쉽지는 않았을 것 같은데. 최고 드루이드가 그리워지진 않을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9c54e9d3-4d76-1a91-f555-247020444438
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9c54e9d3-4d76-1a91-f555-247020444438
msgctxt "h0df83880g1dbbg4b8eg913ag7c5fb823d8d2"
msgid ""
"You're too modest by far. What fate would I have met without you? Rotting in "
"the goblins' cells? Dying against an onslaught on the Grove?"
msgstr ""
"그대는 너무 겸손해. 그대가 없었다면 내가 어떤 운명을 맞이했을까? 고블린의 감방에서 썩어가고 있었을까? 숲에서의 맹공에 맞서 싸우다 "
"죽었을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9c5d71b1-7fda-4899-ae0e-b418b1f2707d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_GoToMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9c5d71b1-7fda-4899-ae0e-b418b1f2707d
msgctxt "hb09d983dg8d70g4159gaa51g82e6c58845f5"
msgid ""
"We have to get to Moonrise, but the less time we spend in its blighted "
"surrounds, the better."
msgstr "우리는 문라이즈에 도착해야 하지만, 황폐한 환경에서 보내는 시간이 적을수록 좋소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9d432af7-2cd2-b686-6971-0ecf4b674a02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9d432af7-2cd2-b686-6971-0ecf4b674a02
msgctxt "h06e2f762g59fcg47aag9902gc8af73a7e9bb"
msgid ""
"You are not bound by social niceties, I see. I like that. Perhaps I can show "
"you just how much, another time."
msgstr "사교적인 예의에 매달리지 않는 편이군. 맘에 들어. 나중에 기회가 되면 나의 그런 면도 보여주겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = 9e17c2a5-22bb-3883-5edf-07e97b7ec7df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9e17c2a5-22bb-3883-5edf-07e97b7ec7df
msgctxt "h019540ffge593g4f5cg9e50g229d2fcae2dc"
msgid "I'm glad to have you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = 9fd1da29-41cb-3a13-0d25-5f4b2bb71e87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:9fd1da29-41cb-3a13-0d25-5f4b2bb71e87
msgctxt "hf7f752b2g086dg429eg8eebg450b8e16c63d"
msgid "Of course. Whatever you wish."
msgstr "물론이네. 그대가 원하는 대로 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = a1daf88e-ae7f-4d60-b77a-c89e8b4fd99c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a1daf88e-ae7f-4d60-b77a-c89e8b4fd99c
msgctxt "h30e273c0geb37g458dga915gcfc640b722bd"
msgid ""
"Anyway, once the curse is lifted, nature can take its course without me. I "
"belong at your side."
msgstr "아무튼, 저주가 일단 풀리면, 자연이 알아서 길을 찾을 거야. 이제 네 곁에 머물 생각이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = a229dcec-96c8-46a4-a46d-7aa4743034a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a229dcec-96c8-46a4-a46d-7aa4743034a8
msgctxt "h13b80f7bgb01ag41fcg88c4g35407b69b221"
msgid "Who?"
msgstr "누구요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = a22a5256-2742-46ca-be2b-6cef4272225e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_HalsinRecruitable = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a22a5256-2742-46ca-be2b-6cef4272225e
msgctxt "h3bc3e154g22d7g43afg95eeg5f8dc17a0f56"
msgid "Come, I need you by my side out there."
msgstr "가시죠, 저와 함께 다닙시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = a2ebeec6-a255-f342-c8eb-006cfa7985c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a2ebeec6-a255-f342-c8eb-006cfa7985c5
msgctxt "h8da1c2b5g93a0g4537ga5fag0f8b92b4ac06"
msgid "You'd have done the same...?"
msgstr "마찬가지였을 거라고요...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = a34118a9-7e36-4849-887b-5eaa143b1995
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a34118a9-7e36-4849-887b-5eaa143b1995
msgctxt "h0d141d14g3040g4d8bgbf19gda0f7b6e889e"
msgid ""
"He is...? Then I must see him. Insensible or not, <i>he knows something.</i>"
msgstr "그 자는...? 그렇다면 그를 봐야겠어. 인사불성이든 아니든, <i>그는 뭔가를 알고 있어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = a5049fa9-7034-eb6d-87cb-6564440c92ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a5049fa9-7034-eb6d-87cb-6564440c92ec
msgctxt "h08e3b0d7g600bg4d30ga3fega866fe5dceb4"
msgid ""
"Who knows what awaits us in the city and beyond, but we shall face whatever "
"may come as staunch allies and unwavering friends."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = a5b4b16d-ab45-4bee-9731-b8de8f44a8ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a5b4b16d-ab45-4bee-9731-b8de8f44a8ea
msgctxt "h8312db91ge4acg47f7gbbb3ged81cf6fc0b8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = a6bacd2a-16ba-4842-8cdd-34f320f9d4de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_DeferredShadowCurseDiscussion(1) = True
#.   Global:
#.      - CAMP_Halsin_Knows_ShadowCurseMotivation = True
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a6bacd2a-16ba-4842-8cdd-34f320f9d4de
msgctxt "hf85a44ffg2528g449cg870eg6518f8572d1c"
msgid ""
"We're in the midst of the shadow curse now. Is there any more you can tell "
"me about how to lift it?"
msgstr "우리는 지금 그림자의 저주에 걸려 있습니다. 저주를 푸는 방법에 대해 더 알려주실 수 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = a76b8902-ffb1-4670-b313-de9883816800
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a76b8902-ffb1-4670-b313-de9883816800
msgctxt "h76c14529gedc8g4764gbaa3g6f3a40544b08"
msgid ""
"Powerful, certainly. But clearly arrested by magic, too. The question I just "
"can't answer is <i>who </i>has done this. And why?"
msgstr ""
"확실히, 강력하오. 마법으로 억제된 상태인 것도 확실하고. 하지만 도저히 알 수 없는 부분은, <i>누가 </i>이런 짓을 했냐는 "
"것이오. 뭘 위해 이런 짓을 했지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = a8a01502-3e7d-43b8-9663-5e08eb3ad41c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_LiftingTheCurse_State_HalsinRecruitable = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a8a01502-3e7d-43b8-9663-5e08eb3ad41c
msgctxt "h344bbf86g9d95g4f1eg9117g7656a76f8130"
msgid ""
"If you want me, I'm yours. Against the curse, against the Absolute - "
"anything. Just say the word."
msgstr "원한다면 함께 하겠네. 상대가 저주든, 절대자든, 그게 무엇이든. 말만 하시게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = a9192253-0e99-4a69-a150-9730ce82f01f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a9192253-0e99-4a69-a150-9730ce82f01f
msgctxt "hdd302102g648dg4b9eg9afbgf144e234849c"
msgid ""
"This is why I chose Francesca. She will restore simplicity and purity to the "
"grove in my absence."
msgstr "그렇기에 프란체스카를 고른 것이오. 내가 없는 동안 그녀가 숲의 소박하고 순수한 모습을 되찾아줄 수 있을 것이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = a926ed40-37ed-4020-94d6-2314d8eda169
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = False
#.   Global:
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:a926ed40-37ed-4020-94d6-2314d8eda169
msgctxt "h56958fd8g96fdg4d9fg8b16g0008837e98a6"
msgid ""
"It's not easy, seeing the ravages of the shadow curse... but your camp is a "
"most welcome solace."
msgstr "그림자 저주가 남기는 황폐화를 목격하는 것은 쉽지 않은 일이지만... 그대의 야영지는 가장 반가운 위안이 되네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = aad949a9-2f64-4572-9929-a5f5e0587382
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_LeaderMap = False
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_LeaderMap = True
#.   Quest:
#.     - SHA_Nightsong.LearnedBryanMap(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:aad949a9-2f64-4572-9929-a5f5e0587382
msgctxt "h962d2fbeg2355g4a8bgb87eg92649276b50b"
msgid ""
"One of his cohorts, a dwarf called Brian, had a clue on his person. If you "
"find his corpse in the goblins' camp, you may have a start."
msgstr ""
"그의 부하 중 하나인 브라이언이라는 드워프가 단서를 가지고 있었소. 고블린 야영지에 있는 그의 시체에서 그걸 찾을 수 있다면, 길을 찾을 "
"수 있을 것이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = abb4290d-99f9-93b6-7f75-73e8cbd9ea01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:abb4290d-99f9-93b6-7f75-73e8cbd9ea01
msgctxt "h883f03c1gfee5g4180g8d5dg19930b8a7aea"
msgid "This 'more' that you want. What is it?"
msgstr "원하는 게 '더' 있다니 그게 뭐죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ad19c250-b020-0ce8-6c09-ea6d78dd3b40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ad19c250-b020-0ce8-6c09-ea6d78dd3b40
msgctxt "h7723a011gc6efg4c4bga907gf3de26412761"
msgid "And I'm glad to be had - glad to be with you, I mean."
msgstr "나야말로 받아줘서... 아니, 함께 해주어 다행이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ad7dd4e5-2e38-40cf-9fb9-aa12f2b76cf8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin_Event_DeferredShadowCurseDiscussion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ad7dd4e5-2e38-40cf-9fb9-aa12f2b76cf8
msgctxt "h09dc8f8bg4662g46ffg814dg2a01fef4d480"
msgid ""
"Put it from your mind for now. Once we near the curse - then there will be "
"more to be said."
msgstr "지금은 잊어주게. 일단 우리가 저주에 가까워지면 더 말할 수 있을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ad9cc332-61c8-41a4-afb7-a8646f0dad9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ad9cc332-61c8-41a4-afb7-a8646f0dad9b
msgctxt "hbf097ae1g9685g4155g8aabgf43303745ad1"
msgid ""
"Precisely! Who indeed? You do not know, and neither do any of the others."
msgstr "바로 그거요! 그게 누구냐고? 그대는 모르겠지, 그리고 숲의 다른 이들도 마찬가지고 말이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = b06c26d6-11e8-4fc3-27ed-0d923d2ec228
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_CurseLiftedHasmet(1) = True
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#.      - IMPOSSIBLE = True
#.      - CURRENTREGION_INT_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:b06c26d6-11e8-4fc3-27ed-0d923d2ec228
msgctxt "hdc94b63ag3fa4g43ceg8581g82ba942b19c1"
msgid ""
"Bittersweet, that we had to leave Thaniel's realm so soon, after all that "
"was done to save it. But it shall thrive in our absence, and now Baldur's "
"Gate awaits."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = b0bac14c-6027-4c7b-b7cc-0ecf0686fda5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:b0bac14c-6027-4c7b-b7cc-0ecf0686fda5
msgctxt "h0ba8e48agb38eg4eb1ga22ag13875c099043"
msgid "Stay here, for now."
msgstr "당분간은 여기 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = b4acbb07-ec17-4446-8c1b-874c2e15ab4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_RecoveredBreath = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:b4acbb07-ec17-4446-8c1b-874c2e15ab4e
msgctxt "h8fc0dbe3g7aa8g42d0ga55ag322a6b09e329"
msgid ""
"His strength is coming back to him. Soon he'll be able to banish the curse "
"once and for all. Until then, we should do what we can to stop the Absolute."
msgstr "그의 힘이 돌아오고 있네. 곧 저주를 완전히 풀 수 있을 거야. 그때까지 우리는 절대자를 막기 위해 최선을 다해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = b6f43259-ab5b-4cdf-847d-fd3f9d345736
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_PermaDefeated = True
#.      - SCL_AncientFist_Knows_WasInCurse = True
#.      - HAV_LiftingTheCurse_State_KnowsBreathLocation = False
#.      - GLO_LiftingTheCurse_Event_TravelToLakeside = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:b6f43259-ab5b-4cdf-847d-fd3f9d345736
msgctxt "h3b0edab9ga7e1g42a6ga8fdg3f36fc068574"
msgid "I found a Flaming Fist who escaped the Shadowfell - but he's dead."
msgstr "섀도펠에서 탈출한 플레이밍 피스트 한 명을 찾았는데, 죽었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = b7a3b8c8-3682-4926-af4a-a4d0984a1272
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:b7a3b8c8-3682-4926-af4a-a4d0984a1272
msgctxt "h6d191d37g1ca5g46cbga6bag9bfaa5f956dc"
msgid ""
"Contrary to how some think of us, we druids can play politics when necessary."
msgstr "다른 이들이 우리에 대해 생각하는 것과 다르게, 우리 드루이드들은 필요한 경우엔 권모술수도 부릴 수 있소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = b9e9effd-cc95-40a7-a38e-f18832ce6294
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:b9e9effd-cc95-40a7-a38e-f18832ce6294
msgctxt "ha33fb38fg7af5g4978gbd9fg6d663d77c718"
msgid "Any ideas on how to find this missing half?"
msgstr "잃어버린 반쪽을 어떻게 찾을지 생각해 봤나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ba32569e-8602-417d-a382-bb08a439afc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ba32569e-8602-417d-a382-bb08a439afc1
msgctxt "hc3ba2b81ga1a3g43c4gb13dgd92d0ee6f906"
msgid ""
"It's had the whole region around Moonrise Towers in a chokehold of darkness "
"and despair for years now."
msgstr "그림자 저주가 문라이즈 타워 인근 지역 전체를 덮었고, 그곳은 수년째 어둠과 절망의 늪에 빠져 있소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = babf72a9-0731-4715-bcc3-426545365ca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:babf72a9-0731-4715-bcc3-426545365ca8
msgctxt "h6ad9f8c1gfc8dg4a8bga2f7g263ab84910ca"
msgid ""
"You've shared your fire with me, your company. A small pocket of light "
"against the darkness, but one I couldn't do without. Thank you."
msgstr ""
"그대는 내게 불을 나누어주고, 함께해 주었네. 어둠에 비하면 자그마한 불빛일 뿐이지만, 그게 없었다면 헤쳐나올 수 없었겠지. 고맙네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = bdec8500-4696-4349-8df9-21b5c7324d3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:bdec8500-4696-4349-8df9-21b5c7324d3d
msgctxt "hba9f9667gd03bg428ag885ag8b8abdb73af2"
msgid ""
"And I truly mean <i>we</i>, if you wish. Every moment counts, and I've asked "
"much of you already without being at your side."
msgstr ""
"그리고 네가 원하는지 모르겠지만, 나는 진심으로 <i>우리</i>에 의미를 부여하고 싶어. 매번 중요한 순간마다 너에게 많은 걸 "
"요구했지. 심지어 네 편도 아니었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c043bb74-7097-409c-b6b1-17d494579020
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_State_HasWokenUpFist = False
#.      - HAV_CursedFist_State_PermaDefeated = False
#.      - SCL_AncientFist_Knows_WasInCurse = True
#.      - GLO_LiftingTheCurse_Event_TravelToHaven = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c043bb74-7097-409c-b6b1-17d494579020
msgctxt "h9b0bf37dg119dg4611g9eb1g4ffab1eb8ae6"
msgid ""
"There's a Flaming Fist at Last Light. The curse has left him insensible, but "
"he's muttering about a boy called Thaniel."
msgstr ""
"최후의 빛에 플레이밍 피스트 한 사람이 있어요. 저주가 그를 인사불성으로 만들었지만, 테니엘이라고 불리는 소년에 대해 중얼거리고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c1a3018c-8b8f-208d-dbe8-3dc27cfc2502
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c1a3018c-8b8f-208d-dbe8-3dc27cfc2502
msgctxt "hcc718a88g3042g4666g9820g92ccdf31489f"
msgid "You're right. I'll try to keep it together."
msgstr "당신 말이 맞아요. 괜찮아지도록 노력할게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c1f5bf1a-7247-45c0-a9be-2aa7611f362a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = True
#.      - Halsin_InParty_Even_ToldPlayerHisAge(1) = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c1f5bf1a-7247-45c0-a9be-2aa7611f362a
msgctxt "h209d7437g5c35g4231ga0d9geb7ee164c6fc"
msgid "What now? You've got what you wanted, after all."
msgstr "또 뭐죠? 결국 당신이 원하는 걸 얻었잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c23b5fb3-ce6c-49a5-8258-115609cc2a63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c23b5fb3-ce6c-49a5-8258-115609cc2a63
msgctxt "hdfe09462g386eg4c46g91b6gb00398e36291"
msgid "I'll see what I can find out."
msgstr "제가 찾아 볼 수 있는 게 있는지 알아 보겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = c34b7aaf-a7cc-4bc1-9170-66eb5a844977
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c34b7aaf-a7cc-4bc1-9170-66eb5a844977
msgctxt "h15b14988ge3deg45e9gbc5cg265d7ed95e82"
msgid ""
"Thaniel still suffers. There'll be no improvement until his essence is "
"restored, I fear."
msgstr "테니엘은 여전히 고통받고 있어. 그의 영혼이 회복되기 전까지 어떠한 호전도 기대할 수 없을까 걱정이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = c477f157-ef26-4807-ab53-c15bd7457857
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Halsin_Knows_AppointedSuccessor = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c477f157-ef26-4807-ab53-c15bd7457857
msgctxt "h92748c58g8c24g415ag99ffg7387daceb9da"
msgid ""
"Hopefully. I've chosen a successor as First Druid - Francesca of the High "
"Forest. I sent a bird to summon her."
msgstr ""
"잘 돌아가길 바라오. 나는 최고 드루이드의 후계자로 하이 포레스트의 프란체스카를 선정하게 됐소. 이미 그녀를 소환하기 위해 새 한 마리를 "
"보냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c48202b1-ef36-3abd-3943-20968c34590e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = False
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = False
#.      - Halsin_InParty_Even_ToldPlayerHisAge(1) = True
#.   Global:
#.      - IMPOSSIBLE = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c48202b1-ef36-3abd-3943-20968c34590e
msgctxt "h10982228ge963g4415gbcadge1caf2dee2b9"
msgid "What now? You've got what you wanted, after all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c4a2f00b-0532-4bef-8fd8-320736668a96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_RathIsPermaDefeated = True
#.      - DEN_Apprentice_State_Dead = True
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c4a2f00b-0532-4bef-8fd8-320736668a96
msgctxt "hc6b7ae6cgdbdbg4c4fgb00bg47c132bb1f94"
msgid "There's nobody in the grove you'd choose?"
msgstr "숲에선 아무도 고를 사람이 없었습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = c532586c-ce40-4538-86f8-bcef4ff07bd2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_LiftingTheCurse_Event_TravelToHaven = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c532586c-ce40-4538-86f8-bcef4ff07bd2
msgctxt "h0fe89c09gf4cag438eg877egbb1db2c2c655"
msgid "I will go to see him at once. Join me when you can."
msgstr "즉시 그를 보러 출발하겠네. 그대도 가능하면 합류하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = c5e3e79b-1ef2-4f8a-aefc-2be7e159ac94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = False
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c5e3e79b-1ef2-4f8a-aefc-2be7e159ac94
msgctxt "h3d7a88b2gb776g4cd5g9c91gf33f6524239e"
msgid ""
"Thaniel is no ordinary child - he is the very spirit of this land. If this "
"Fist knows where he is, then perhaps we can save him... save everything."
msgstr ""
"테니엘은 평범한 아이가 아니라 바로 이 대지의 정령이오. 그 피스트가 테니엘의 행방을 안다면, 우리는 그를 구하고... 모든 것을 구할 "
"수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c7c6121a-7f6e-43bd-a48c-4f91ca5f2f73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = True
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c7c6121a-7f6e-43bd-a48c-4f91ca5f2f73
msgctxt "hed08a204g39fcg4e35g9aceg825344d1e52b"
msgid ""
"I met a shadow child named Oliver, resembling Thaniel - but he's dead now."
msgstr "테니엘을 닮은 올리버란 이름의 그림자 아이를 만난 적 있어요 - 지금은 죽었지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = c7fee8c0-af8a-3813-7f0b-877e71f685d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c7fee8c0-af8a-3813-7f0b-877e71f685d5
msgctxt "h01eb8902g9327g4cbfg8cd1g048aa000c5ac"
msgid "No words needed - I understand how you feel."
msgstr "아무런 말도 필요 없습니다. 당신이 어떻게 느끼고 있는지 이해합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = c9035586-6489-4b3f-8f93-9b9b048c26b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:c9035586-6489-4b3f-8f93-9b9b048c26b6
msgctxt "h586a78d5ge396g4655gafbdg1e929976e2fa"
msgid ""
"Poor soul... but in truth, if I had to choose between death and the "
"Shadowfell, I'd choose death."
msgstr "가련한 영혼이여... 솔직히 섀도펠과 죽음 사이에서 골라야 한다면 난 죽음을 택하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = cbcf3e52-cf51-98b5-fea3-3fc84c97af09
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:cbcf3e52-cf51-98b5-fea3-3fc84c97af09
msgctxt "h0ec8fca3g648cg44c0g97eag1ddffa95b06d"
msgid ""
"...Forgive me. Sometimes I forget myself, gazing on the beauty of nature's "
"creations."
msgstr "...용서하게. 때때로 나는 자연이 창조한 아름다움을 바라보며 나 자신을 잊어버린다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = cd6d2965-48ad-42fb-bd07-0121ab0c203f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:cd6d2965-48ad-42fb-bd07-0121ab0c203f
msgctxt "hf5973b1cgebacg4e3egb879g88363ab5e14d"
msgid ""
"I studied the shadow curse for years. But to truly understand it - and stop "
"it - I must reach its source."
msgstr "나는 그림자 저주를 수년간 연구했네. 하지만 저주를 진정으로 이해하고 멈추려면, 그 근원에 도달해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = cf713948-b30f-4edc-8c0c-2e83adf74fc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:cf713948-b30f-4edc-8c0c-2e83adf74fc7
msgctxt "hdf49ac42g6fcdg4281gb665g831be356cbec"
msgid ""
"Impressive. Most would quake at the mere thought of delving that far into "
"the Underdark. What did you find?"
msgstr "인상적이군. 대부분의 이들은 언더다크에 그렇게 깊게 나아간다는 생각만으로 두려움에 떨 텐데 말이지. 거기서 뭘 찾았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = cfc007c3-f3ad-bc57-8bf3-c196c7625413
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:cfc007c3-f3ad-bc57-8bf3-c196c7625413
msgctxt "h702f10fcg0a22g49e9g961dg7b40066aa574"
msgid ""
"You flirting with me, big man? Why not spare the talk and get straight to "
"the sweaty part?"
msgstr "나를 꼬시려는 건가, 덩치? 잡담은 그만 하고, 끈적한 단계로 곧장 넘어가는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = d297e45b-beff-40a0-b27c-daeb7ca53bfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d297e45b-beff-40a0-b27c-daeb7ca53bfb
msgctxt "he75fa11ag3599g414ag960bge327b55ec9b5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = d2abf26e-c00f-427d-9697-4b4ae7e40ba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d2abf26e-c00f-427d-9697-4b4ae7e40ba8
msgctxt "h9d5618a8g2ed9g453fg8416gbe6a3bb6efba"
msgid ""
"...perhaps not. I do not know. All I can do for now is to try do some good "
"where I can - try to help you."
msgstr ""
"...아마도 아니겠지. 모르겠어. 지금 내가 할 수 있는 전부는 내가 있는 곳에서 할 수 있는 선의의 행동을 해보는 거야. 바로 너를 "
"돕는 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = d2de64bc-ee93-dba0-842a-3330c77c848d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d2de64bc-ee93-dba0-842a-3330c77c848d
msgctxt "h55434507g9414g45d8gba04g861d2a682612"
msgid "Yes. I think you do..."
msgstr "그래. 너는 그럴 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = d4c3c34f-d7eb-6999-2e00-1949209a4f43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d4c3c34f-d7eb-6999-2e00-1949209a4f43
msgctxt "h8a0e6c6dg2f18g4b35ga070g536669346220"
msgid "You're welcome."
msgstr "천만에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = d5850d04-1d03-b6cf-05c4-4fba969130b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d5850d04-1d03-b6cf-05c4-4fba969130b5
msgctxt "h7460cf7fgbe7dg4920ga2c8gcc269d518bbe"
msgid ""
"I can think of a thing or two... but the curse grips my mind for now, and I "
"would loathe to give you only part of my attention."
msgstr "한두 가지 생각은 나지만... 지금은 저주가 내 마음을 사로잡고 있어서, 내 관심의 일부만 주기는 너무 싫군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = d5a549ae-b947-4f70-bd57-e87eb149d251
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - CURRENTREGION_WLD_Main_A = True
#.      - GLO_DuergarCamp_EverEnteredBefore = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d5a549ae-b947-4f70-bd57-e87eb149d251
msgctxt "h729eae8fg0c83g4a26gb63bgf89a563f0dcb"
msgid "This shadow curse you spoke of... surely it can't be <i>that </i>bad."
msgstr "당신이 말한 그림자 저주... 그게 <i>그렇게</i>까지 나쁘진 않을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = d6055ca7-9251-4690-b65e-ad355a1c5a1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d6055ca7-9251-4690-b65e-ad355a1c5a1e
msgctxt "h46106ae4gadaag4a89g996ag9d7780b3d992"
msgid "No. At least, not right now."
msgstr "없소. 적어도, 당장은 말이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = d6a1206e-d2c5-49b8-a4ae-63ce17927294
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_AskedWhenCurseWillLift(1) = False
#.   Global:
#.      - GLO_Ketheric_State_Dead = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhenCurseWillLift(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d6a1206e-d2c5-49b8-a4ae-63ce17927294
msgctxt "h7a8c6dabg17b3g4c05gbd9ege1c1fa8b5e45"
msgid "So when will the curse actually be lifted?"
msgstr "그래서 저주는 언제 실제로 풀리는 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = d76d0409-0e59-4f0b-a7c9-14f298344f5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_DiscussedTadpoleResearch(1) = False
#.   Global:
#.      - MOO_PartyProgress_EnteredMoonrise = False
#.      - GLO_Halsin_Knows_TadpoleResearch = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin_Event_DiscussedTadpoleResearch(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d76d0409-0e59-4f0b-a7c9-14f298344f5a
msgctxt "h5975f70ega2bcg4dfbgab8agd6fe135bd453"
msgid ""
"You've been researching the illithid parasites - is there anything you can "
"tell me?"
msgstr "당신은 일리시드 기생충에 대해 연구해왔잖아요. 제게 알려줄 수 있는 건 없나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = d81f7b70-3f39-4b3d-bc5e-1803debe97f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d81f7b70-3f39-4b3d-bc5e-1803debe97f7
msgctxt "he58bbbd1g0e0fg4095ga35dgac8e9be21c88"
msgid "How do you know this?"
msgstr "이런 걸 어떻게 아는 거예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = d8d543b9-4640-4e7f-b50d-ce158cdd7469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d8d543b9-4640-4e7f-b50d-ce158cdd7469
msgctxt "h8e476765g938dg4a08gbeb0gd1bdcc86db01"
msgid ""
"Perhaps, but we'll need to get closer before I can put my theory into "
"practice."
msgstr "어쩌면 알 수도 있네. 하지만 내 이론을 검증하려면 더 가까이 다가가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = d981a4f9-d251-a741-6631-3df8d3542fd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = False
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:d981a4f9-d251-a741-6631-3df8d3542fd1
msgctxt "h6be945e8g073eg40e6g87dbg1b482a88ae19"
msgid ""
"I met a sort of shadow child before - a little boy named Oliver. Around "
"Thaniel's age."
msgstr "전에 그림자 아이와 비슷한 아이를 봤어요. 테니엘 또래의 올리버란 남자 아이였죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = da0b0f3f-8300-433a-b081-2798ca88741c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:da0b0f3f-8300-433a-b081-2798ca88741c
msgctxt "hc3b602c8gaf19g42a5ga2a3gce48c19c78a1"
msgid "I'm sure something will come to me, given time."
msgstr "시간이 지나면 분명 생각이 날거라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = da3bc295-3df2-4ae0-8f3d-3f47f8084f92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:da3bc295-3df2-4ae0-8f3d-3f47f8084f92
msgctxt "hf8b872d4g402ag49b1ga756g3ffd1ea6e4c1"
msgid ""
"Good - this is what we've been lacking. Now there's a chance we can find "
"Thaniel, and bring him home."
msgstr "좋군, 필요하던 거야. 이제 테니엘을 찾아 집에 데려올 수 있는 기회가 생겼네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = db2767b2-c254-49b9-a00a-4d1f5f176c2f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_FlirtHint(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:db2767b2-c254-49b9-a00a-4d1f5f176c2f
msgctxt "h69066e34g6455g494fg932bga11e7d369d1f"
msgid "I have. But perhaps there is more that I want..."
msgstr "그랬지. 근데 원하는 게 더 있는 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = dcd28f3f-de6f-4295-a07e-15811f040324
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:dcd28f3f-de6f-4295-a07e-15811f040324
msgctxt "hbc9b3a81g8618g4a60g9f3bg41d81eeec126"
msgid ""
"I'm certain. The Underdark is dangerous, yes, but the alternative is "
"suicide. Be patient and be thorough - the path will reveal itself in time."
msgstr ""
"확신하오. 언더다크는 위험하긴 하지만, 다른 길로 가는 건 자살행위요. 인내심을 갖고 철저히 준비하면, 이윽고 길이 드러날 것이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ddb28d9c-bc5e-43a2-907d-325af68b2782
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ddb28d9c-bc5e-43a2-907d-325af68b2782
msgctxt "h365e49fegfc9eg4eceg94b1gb40aeb81122b"
msgid ""
"Wonderfully! If I'm honest, the grove was too comfortable for my tastes; I "
"felt removed from nature."
msgstr "아주 멋지군! 솔직히 말해서, 그 숲은 내 취향에 맞지 않게 너무 편안했네. 자연에서 소외된 기분을 느꼈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ddd89c3f-caa5-443f-ada6-395f3c2c6291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ddd89c3f-caa5-443f-ada6-395f3c2c6291
msgctxt "h9a13dd3agc5bbg4705gb4b4g75ca3f471ff5"
msgid ""
"Precisely. Then perhaps I could have done something about both the shadow "
"curse and ceremorphosis aberrations."
msgstr "정확하네. 그랬으면 내가 그림자 저주와 괴이한 뇌변이 양쪽 모두에 손을 쓸 수도 있었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = de24e3c2-4164-41ff-9d20-fe05bc109f28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:de24e3c2-4164-41ff-9d20-fe05bc109f28
msgctxt "hcbae6dd1g2327g403fga9cfgdee000fd7ea7"
msgid "Oak Father shield you, my friend."
msgstr "참나무 아버지가 그대를 지켜주네, 내 친구여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = df738fd3-5ad1-4d8d-a39d-09eb890ce0e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:df738fd3-5ad1-4d8d-a39d-09eb890ce0e0
msgctxt "h28fc60d0gab2fg4783g8aa6g63e89948ca1d"
msgid ""
"A living witness is unlikely, I'll admit. But perhaps there'll be an "
"<i>unliving </i>witness, or some lingering echo of what we seek."
msgstr ""
"살아있는 증인이 없을 거란 건 부정할 수 없어. 그러나 아마도 <i>살아 있지 않은</i> 증인이 있거나, 혹은 우리가 찾는 것에 대한 "
"어떤 메아리가 남아 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = dfa4338d-a05d-4599-9398-ff3bd4f960fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_State_HasWokenUpFist = True
#.      - HAV_CursedFist_State_PermaDefeated = False
#.      - SCL_AncientFist_Knows_WasInCurse = True
#.      - GLO_LiftingTheCurse_Event_TravelToHaven = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:dfa4338d-a05d-4599-9398-ff3bd4f960fd
msgctxt "hb32c9482gff7cg4b40g898eg61a8016ea3d3"
msgid ""
"There's a Flaming Fist recuperating in Last Light. Seems he escaped from the "
"curse - and he spoke of a boy called Thaniel."
msgstr ""
"최후의 빛에서 회복 중인 플레이밍 피스트가 있습니다. 그는 저주에서 벗어난 것 같습니다. 그리고 테니엘이라는 소년에 대해 이야기했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = e0824aa0-0d0e-087a-30d1-5f3179fe736c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = True
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e0824aa0-0d0e-087a-30d1-5f3179fe736c
msgctxt "h077f1ab8gb637g4a3bg8efcge45326277239"
msgid ""
"I met a shadow child named Oliver, resembling Thaniel - but he's dead now."
msgstr "올리버라는 이름의 그림자 아이를 만났어요. 테니엘을 닮았지만 지금은 죽었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = e174b73d-c153-419c-bb30-bf4f1e6e155a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e174b73d-c153-419c-bb30-bf4f1e6e155a
msgctxt "h5adda1aag1518g431dgbca6g4dfa88570520"
msgid "Can it be undone?"
msgstr "되돌릴 수 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = e1bf3da0-1948-07bd-1fe1-4740f768bf16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e1bf3da0-1948-07bd-1fe1-4740f768bf16
msgctxt "hdde92fb1gf1c3g440dg8d97gfc8230a758c2"
msgid "I'm glad I didn't leave a bad impression then."
msgstr "그때 나쁜 인상을 남기지 않아서 다행입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = e3a23c14-32a2-4f06-97af-a4786e259043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e3a23c14-32a2-4f06-97af-a4786e259043
msgctxt "h2397f9c7gad2bg4d1eg91b9ga2acde450b3b"
msgid "Indeed."
msgstr "그렇소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = e620727c-9fc6-472e-b27b-f8ed9896e3a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e620727c-9fc6-472e-b27b-f8ed9896e3a3
msgctxt "h3df64ccfgb7b8g4772g9425g0af3fa33e45e"
msgid ""
"...But since the curse was unleashed, I have not felt his presence. He is "
"its prisoner, I fear. And as long as he remains so, his domain will lie in "
"darkness."
msgstr ""
"...하지만 저주가 풀린 이후로 나는 그의 존재를 느끼지 못했네. 두렵게도, 그는 저주의 포로라네. 그리고 그가 그대로 있는 한 그의 "
"영역은 어둠 속에 놓여 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = e95be317-18d3-439e-9c07-d47ce515518c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingtheCurse_State_ThanielReleased = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e95be317-18d3-439e-9c07-d47ce515518c
msgctxt "h23448ec9g026bg4918g9a4bg07de0b0705d2"
msgid "How is Thaniel?"
msgstr "테니엘은 어때요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = e96762d1-629a-4d53-b6c3-f10399159f16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e96762d1-629a-4d53-b6c3-f10399159f16
msgctxt "hdcd96fceg1b6fg483bga3f2gde0806980ce3"
msgid ""
"I'll miss my books, but I can find all the wisdom they contain out here, "
"first-hand."
msgstr "책이 그리워지겠지만, 책에 담긴 모든 지혜를 이곳에서 직접 찾을 수 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = e9ff2283-2e7d-4799-870e-369f39a7d921
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:e9ff2283-2e7d-4799-870e-369f39a7d921
msgctxt "h0d7863edg8c32g433cg98abg922dd63fb33a"
msgid "All right, leave it to me."
msgstr "좋아요, 내게 맡겨요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ea4c1e02-4d43-1a44-ecfb-5fefbbaeb479
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Lockdown_State_Active = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ea4c1e02-4d43-1a44-ecfb-5fefbbaeb479
msgctxt "h23e088d8gf9aag49a9gb3f3g2e7003323e99"
msgid ""
"I can only imagine what fate would I have met without you -rotting in the "
"goblins' cells? Being sealed away by the Rite of Thorns for all eternity?"
msgstr ""
"그대가 없었다면 어떤 운명을 맞이했을지 상상만 할 뿐이야. 고블린의 감방에서 썩어가는 운명? 가시의 의식에 의해 영원히 봉인된 채로?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = eb91be7c-7bc4-4667-ad7e-a08bcf21e7a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:eb91be7c-7bc4-4667-ad7e-a08bcf21e7a0
msgctxt "hfa8c9aeagbaeag40b1gb9eag7fca9c5378ce"
msgid ""
"Be wary of anyone who actually <i>wants </i>such a role, I say. Likely they "
"don't understand it, or they have ill intent."
msgstr ""
"실제로 그런 역할을 <i>원하는</i> 사람은 경계해야 하지. 역할을 이해하지 못하거나, 나쁜 의도를 가지고 있을 가능성이 높으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ed87e258-254b-1f84-65ba-dbba3299994a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ed87e258-254b-1f84-65ba-dbba3299994a
msgctxt "h6009fbc6g2adcg4a90gb315g8af412c8a05c"
msgid ""
"If I had my fleet of druids and a month of hard research, perhaps I could "
"help. But I'm no savant, for now I can only guarantee a cure for "
"ceremorphosis."
msgstr ""
"내 드루이드 무리와 한 달간의 진지한 연구가 있다면, 아마도 도울 수 있을 걸세. 하지만 난 학자가 아니고, 지금은 뇌변이를 완화할 수 "
"있을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = eec9fcb6-f5a6-5d66-3c5f-7ba63357d61f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_AskedHowHalsinLikesCamp(1) = False
#.   Global:
#.      - CURRENTREGION_SCL_Main_A = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin2_Event_AskedHowHalsinLikesCamp(1) = True
#.   Global:
#.     - CAMP_Halsin_Event_AskedFaringToday = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:eec9fcb6-f5a6-5d66-3c5f-7ba63357d61f
msgctxt "h2ebb41deg13dfg483cg9040g4e932e4dd6e3"
msgid ""
"These lands must bring back bad memories for you. I hope you're still faring "
"all right with us."
msgstr "이 땅은 당신에게 나쁜 기억을 떠올리게 하겠군요. 그래도 우리와 함께 잘 지내고 계시길 바랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = f12d86df-2832-a360-c72c-f4db94995f2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:f12d86df-2832-a360-c72c-f4db94995f2e
msgctxt "hd1c53c95g2203g4443g86a2g6cd6f282fc04"
msgid ""
"Everything in your mind has been destroyed, from what I gathered. And from "
"the path I see you on, you are doing well at picking up the pieces."
msgstr ""
"내가 수집한 바에 따르면 그대의 마음속 모든 것이 파괴되었네. 그리고 그대가 걷고 있는 길을 보면, 그대는 그 조각들을 잘 줍고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = f17c58c5-ba38-aade-c855-84f9944c2eaf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin2_Event_FlirtedWitHalsinInSCL(1) = False
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#.      - CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA(1) = False
#.      - Halsin_InParty_Even_ToldPlayerHisAge(1) = False
#.   Global:
#.      - IMPOSSIBLE = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:f17c58c5-ba38-aade-c855-84f9944c2eaf
msgctxt "h6f46892dg304bg459cga2dcg6b16a706ea90"
msgid "What now? You've got what you wanted, after all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = f29e2b5f-f935-4711-8ee5-1e48b743e264
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:f29e2b5f-f935-4711-8ee5-1e48b743e264
msgctxt "h7c961179gb38fg4c94g8cf7g762acbf83358"
msgid "I knew I could put my faith in you. If only we had met sooner."
msgstr "너를 믿기로 했던 내 결정이 옳았군. 더 빨리 만났다면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = f6b277ce-9dd0-422a-ba42-eb39772dfdbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:f6b277ce-9dd0-422a-ba42-eb39772dfdbf
msgctxt "h229098eagec9bg41c8g8ef5g9481d63b1111"
msgid "Precious little, but I'm quite certain it can still be found."
msgstr "극히 조금 알고 있지만, 찾을 수는 있을 것이라 확신하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = f7861b39-a485-4faa-81b5-2af2c3f32d16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_DeferredShadowCurseDiscussion(1) = False
#.   Global:
#.      - CAMP_Halsin_Knows_ShadowCurseMotivation = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:f7861b39-a485-4faa-81b5-2af2c3f32d16
msgctxt "h3ebfc133g4af8g41f4g9395g2f58b512989f"
msgid "Do you know how the shadow curse can be stopped?"
msgstr "그림자 저주를 막을 방법은 모르십니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = fb3d6695-7f3a-4448-b109-5f0b55ce9adf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_LeaderMap = False
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_LeaderMap = True
#.   Quest:
#.     - SHA_Nightsong.LearnedBryanMap(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:fb3d6695-7f3a-4448-b109-5f0b55ce9adf
msgctxt "h2cce0cf1ga724g4bd9g871bg90c9a56bb63b"
msgid ""
"A dwarf called Brian, I believe. Though there's no guarantee that the "
"goblins left him recognisable."
msgstr "내 기억이 맞다면, 브라이언이라는 이름의 드워프였소. 하지만 고블린들이 그를 멀쩡히 내버려 뒀을지는 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Player
#. NodeID = fdc40393-bc8f-4c5f-b577-ddc8e60c6659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:fdc40393-bc8f-4c5f-b577-ddc8e60c6659
msgctxt "h9eb79e71g6f77g40a3g89a6g478c77c50d7c"
msgid ""
"I hope you've no more requests - I need to take care of my own problems."
msgstr "이제 부탁은 그만 해주면 좋겠군요 - 해결해야 할 일이 있어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2
#. Speaker = Halsin
#. NodeID = ffddde8d-d6af-433c-8a4e-661d900e84ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin2:ffddde8d-d6af-433c-8a4e-661d900e84ed
msgctxt "h63d23bd5g9400g4f3eg8720g5ca46ed593bd"
msgid ""
"I hope they will remain as a pair. It would be good for them both to have a "
"friend, once I'm gone."
msgstr "난 그들이 한 쌍으로 남기를 바라네. 내가 떠나고 나서도 서로 친구가 되는 것이 그 둘에게도 좋을 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 014ec39f-3d56-4fd8-a531-352f1c2f9dba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:014ec39f-3d56-4fd8-a531-352f1c2f9dba
msgctxt "h01034725g0468g4eacg902fg0cf7e1503e79"
msgid "A fine respite from the world's troubles, this camp of yours."
msgstr "세상의 번잡함에서 벗어나 숨 돌리기 좋은 곳, 바로 그대의 야영지일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 0c8ed22e-5dab-4bec-93f6-e3182670531f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:0c8ed22e-5dab-4bec-93f6-e3182670531f
msgctxt "h7169bfd4gaf9eg4b38gbc89ga496d00c1929"
msgid "Being within reach of the shadow curse again is... troubling."
msgstr "또다시 그림자 저주의 범위 내에 있게 되다니… 난감하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 20bbe75a-9093-471d-8e4e-a80451d0b1e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_CTY_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:20bbe75a-9093-471d-8e4e-a80451d0b1e1
msgctxt "h0b2b7288g7ceag46beg9de0g94eb5fd38ce7"
msgid "We end the day within the walls of the city, at last."
msgstr "마침내 도시의 방벽 안쪽에서 하루를 마무리하게 되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 29d23b35-0130-22ee-bec5-1700a1e67017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:29d23b35-0130-22ee-bec5-1700a1e67017
msgctxt "hfd2033eegf44ag48d1gab17g9ce430295dd1"
msgid ""
"I find it difficult to imagine that rest will come easily in such a place."
msgstr "이런 장소에서 편히 쉴 수 있을 거라고는 상상도 안 되네만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 3d43c4d2-6ebb-4768-97e0-722b85f613bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = True
#.      - GLO_Orin_State_PermaDefeated = True
#.      - CURRENTREGION_CTY_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:3d43c4d2-6ebb-4768-97e0-722b85f613bc
msgctxt "h542f12bdg08f0g4f2bg91d0g773755589dad"
msgid "Both Orin and Gortash are slain. We shall rest well tonight."
msgstr "오린도 고타쉬도 무찔렀으니, 오늘 밤은 편히 쉴 수 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 40319814-34d5-4a74-a0fc-d8fc74a9151c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_RecoveredBreath = True
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:40319814-34d5-4a74-a0fc-d8fc74a9151c
msgctxt "h7accf02egafcdg4645g857age787bb72ba7d"
msgid "Thaniel is back where he belongs, but there is more to be done."
msgstr "테니엘이 원래 있어야 할 곳으로 돌아가긴 했지만, 끝마칠 일은 아직 남아 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 628b544f-56b6-4bc5-b461-3ec75ee23cf2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_BGO_Main_A = True
#.      - GLO_Gortash_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:628b544f-56b6-4bc5-b461-3ec75ee23cf2
msgctxt "h0fd82c6eg03c4g4c5cgb103g9f33274b168d"
msgid "Gortash is no more, and we have not yet even reached the Lower City."
msgstr "하부 도시에 발을 들이기도 전에 고타쉬를 죽일 줄이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 72811e86-3610-45dc-9ad3-e22ff9a8b7fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_WLD_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:72811e86-3610-45dc-9ad3-e22ff9a8b7fb
msgctxt "h9b157eafgbe06g43e9g9c2ag07d046b37409"
msgid ""
"To rest beneath nature's canopy of stars - I can think of no finer way to "
"pass the night."
msgstr "자연이 수놓은 별들 아래에서 쉴 수 있다니, 밤을 보내기엔 더없이 좋은 곳이로구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 85b710d2-c2ed-dd6e-b037-acc696d45ae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:85b710d2-c2ed-dd6e-b037-acc696d45ae7
msgctxt "h8394192egaf82g47b2gb95cg68f53382071c"
msgid "At least he can rest, until the shadows are banished."
msgstr "적어도 테니엘은, 그림자가 사라질 때까지는 쉴 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 869812fb-947e-9064-bc3d-8f4f9f5603d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:869812fb-947e-9064-bc3d-8f4f9f5603d2
msgctxt "h6895bb7bg6ec8g4fecga961g2ad9aca54437"
msgid ""
"...and certainly better than I did while languishing in the goblins' cages."
msgstr "…고블린들의 감옥에서 시달리던 때와는 비교할 것도 없겠고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 95a0a73b-3b26-2322-19dd-902cdee7699b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:95a0a73b-3b26-2322-19dd-902cdee7699b
msgctxt "hf641f26dg43d0g4704gbeebgf1a8cc4fd97a"
msgid ""
"Too much noise, too many lanterns kept burning... nature's rhythm is ignored "
"here."
msgstr "소음도, 끊임없이 타오르는 등불도 너무 많네… 여기서는 자연의 리듬이 무시되고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 96467e95-ae6c-b1a8-0ee8-dd3cd1dfc6eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:96467e95-ae6c-b1a8-0ee8-dd3cd1dfc6eb
msgctxt "h1392fd90gd3c1g4df6g91a9g5a42e9180641"
msgid "I am blessed to have found your company, and share in your campfire."
msgstr "자네와 함께 있게 되어, 모닥불을 함께 쓰게 되어 행복하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 96ac8794-1e3b-5bc0-ee78-b686c0501245
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:96ac8794-1e3b-5bc0-ee78-b686c0501245
msgctxt "h6b751b59g5965g4776g8018g7f1d87b63280"
msgid ""
"Ketheric Thorm is the final obstacle. His demise shall unshackle nature, and "
"banish the shadows."
msgstr "이제 남은 장애물은 케서릭 쏨 하나뿐이네. 놈이 소멸하면 자연도 해방될 테고, 그림자도 걷힐 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = 982ebbd5-273b-62e1-9c4c-73f5f7328987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:982ebbd5-273b-62e1-9c4c-73f5f7328987
msgctxt "h40f91751gb003g40f3g99f7gec51feeeded7"
msgid "I daresay I may rest more easily here than I did at the grove..."
msgstr "숲에 있을 때보다 더 편히 쉴 수 있을 듯하네…"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = b0581cf6-d740-4a3e-b420-1471758e8481
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CURRENTREGION_BGO_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:b0581cf6-d740-4a3e-b420-1471758e8481
msgctxt "hb6636089ga13fg4f55gb67bg581387df04ac"
msgid ""
"A curious place, this camp. One foot in nature, and the other in the city "
"that awaits beyond."
msgstr "이 야영지, 기묘한 곳이로군. 자연과 그 너머의 도시 양쪽에 발을 걸치고 있다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = b1d53d87-7c5d-962f-5424-ec0d08eaf317
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:b1d53d87-7c5d-962f-5424-ec0d08eaf317
msgctxt "habb48336gf323g494cgbd2ag7074d625cd30"
msgid "At least this camp has bright-burning fires to stave off the shadows."
msgstr "적어도 이 야영지에는 밝게 타올라 그림자를 몰아낼 불이라도 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = bbe7012b-dcbd-44db-9961-7a0d845d7864
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = True
#.      - GLO_Orin_State_PermaDefeated = False
#.      - CURRENTREGION_CTY_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:bbe7012b-dcbd-44db-9961-7a0d845d7864
msgctxt "hc2156a4egbd52g41cbga14bgfa151b02b1fa"
msgid ""
"The nighttime will feel more peaceful, knowing that Orin no longer skulks in "
"the shadows."
msgstr "이제 밤이 더욱 평온하게 느껴질 걸세. 오린이 그림자 속에 숨지 못할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = bf826fef-25f5-31e8-8d15-efcb2b9922ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:bf826fef-25f5-31e8-8d15-efcb2b9922ec
msgctxt "h9143f0c4g3a7cg4d8bg9650gafeceb9aaf11"
msgid ""
"Though perhaps we are not destined to share a campfire for much longer - a "
"final reckoning surely looms."
msgstr "그래도, 모닥불 근처에 오래 머무르지는 말아야 할 듯하네. 최후의 심판이 임박했으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = cbe0df40-068a-4c73-80bc-c382d102760a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#.      - CURRENTREGION_SCL_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:cbe0df40-068a-4c73-80bc-c382d102760a
msgctxt "h2e0f5891g8fecg4993g9f97g1ed62ae98a55"
msgid "Thaniel and Oliver are reunited - nature's spirit is whole again."
msgstr "테니엘과 올리버가 다시 하나가 되었네. 자연의 정령이 다시 완전해진 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = d7a05278-cb8c-4535-88ce-3e6746964f82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = False
#.      - GLO_Orin_State_PermaDefeated = True
#.      - CURRENTREGION_CTY_Main_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:d7a05278-cb8c-4535-88ce-3e6746964f82
msgctxt "h7132577cgcd84g43beg82a4gcf765bc2d420"
msgid "Gortash is no more. We have earned our rest on this eve."
msgstr "고타쉬는 이제 없다네. 오늘 밤은 한시름 덜었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = e1260151-d5e1-d9a2-106d-70fbf2c78f5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:e1260151-d5e1-d9a2-106d-70fbf2c78f5b
msgctxt "h6368f401gff79g444egaed6g80bf5a2c6069"
msgid ""
"I should savour the sight of trees and grass while I can. Soon we shall be "
"surrounded by cobbles and walls."
msgstr "나무와 풀의 모습을 음미할 수 있을 때 음미해 둬야겠군. 우리가 곧 향하게 될 곳은… 자갈과 벽으로 가득할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = e3741939-e2eb-e335-5aec-dac24edb6dbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:e3741939-e2eb-e335-5aec-dac24edb6dbe
msgctxt "h889266e3ge93bg4204gb22fg546db68a8eda"
msgid "Sterling progress, by anyone's measure."
msgstr "누가 봐도 훌륭한 성과 아니겠는가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = f49efb12-48db-bcad-3c0e-ceff1201c611
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_State_Dead = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:f49efb12-48db-bcad-3c0e-ceff1201c611
msgctxt "h6e3093bbg580cg49b4g9a22g8da6d29ff0ca"
msgid ""
"And with Ketheric Thorm dead, the shadows he unleashed are soon to be gone."
msgstr "케서릭 쏨이 죽었으니, 놈이 불러들인 그림자도 곧 사라지겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo
#. Speaker = Halsin
#. NodeID = f4bdb10d-0f56-aedd-1634-dad57f33df61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Halsin_AD_Solo:f4bdb10d-0f56-aedd-1634-dad57f33df61
msgctxt "h53c40b62g1692g4d72gacf3g645865fa8e95"
msgid "Just as foul a sight now as it was a century ago. Worse, even."
msgstr "한 세기 전과 마찬가지인 신세로군. 아니, 더 나빠졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 00153978-5f3c-5b42-88c3-ec3f5807c330
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:00153978-5f3c-5b42-88c3-ec3f5807c330
msgctxt "h7035f223gcc3bg4cd1g91bagad65f4284c05"
msgid ""
"You <i>what</i>?! But she was immortal. How could she... how could "
"<i>you</i>...?"
msgstr "당신이 <i>뭐라고요</i>?! 하지만 에일린은 불사였을 텐데. 어떻게 그녀가... 어째서 <i>그런 짓을</i>...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 06129149-eee0-32c3-654a-16f08e080715
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:06129149-eee0-32c3-654a-16f08e080715
msgctxt "hd91b5fc1gcc1cg4246g8558g6c83cd537051"
msgid ""
"I couldn't tell her who I was. I had to protect them - and myself - no "
"matter what."
msgstr "내가 누구인지 말할 수 없었어요. 그들을 지켜야 했고, 나 자신도 지켜야 했죠. 어떻게든 말이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 061e5f9c-aee4-7bbb-a527-097964179bbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:061e5f9c-aee4-7bbb-a527-097964179bbb
msgctxt "h5efcb820g2a8fg458eg8108gd911240310a2"
msgid ""
"I found Last Light within the shadows. Made a shelter there. Prayed my "
"father wouldn't find me."
msgstr "그리고 그림자 속에서 최후의 빛을 찾았어요. 거기에 피난처를 만들었고, 아버지가 나를 찾지 못하길 기도했죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 0723ed1b-9d4f-787a-1f8b-676af2ab7ada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:0723ed1b-9d4f-787a-1f8b-676af2ab7ada
msgctxt "h883aa425g284eg404fgbf0ag1c339d9b1cb9"
msgid ""
"But I admit that plays second fiddle to helping you. None of us will be safe "
"until the horror behind 'the Absolute' is defeated. When the time comes, "
"I'll fight at your side."
msgstr ""
"하지만 그것보다 당신을 돕는 게 우선순위에 있다는 건 인정할게요. '절대자' 뒤의 공포를 물리치기 전까진 그 누구도 안전하지 못하니까요. "
"때가 되면, 당신 곁에서 싸우겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 08326a0a-afcf-2511-e3fc-da4ed3ea14d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:08326a0a-afcf-2511-e3fc-da4ed3ea14d4
msgctxt "hbb257fadge5a9g4051g9dcfgbdd7c7aac673"
msgid ""
"When an emissary of Selûne came to our little town, we were elated. Dame "
"Aylin. Daughter of the Moonmaiden herself."
msgstr "우리의 작은 마을에 셀루네의 사자가 찾아왔을 때, 우린 뛸 듯이 기뻐했어요. 여기사 에일린. 달처녀의 딸이 직접 찾아온 거죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 09f49be8-8695-19d5-8a86-ddf62947f589
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:09f49be8-8695-19d5-8a86-ddf62947f589
msgctxt "hc987d97bg6b9eg437cg84f5g3703c7bd9cc1"
msgid ""
"Perhaps there's something I can do to help the fight against the Dead Three. "
"The moon is rather good at illuminating darkness, after all."
msgstr "삼악신에 맞서 싸울 때 제가 할 수 있는 일이 있을지도 몰라요. 뭐니 해도 달은 어둠을 밝게 비추는 데 효과적이니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 0e0c6d0e-024e-d07f-28a5-28bd8c447250
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:0e0c6d0e-024e-d07f-28a5-28bd8c447250
msgctxt "h233ecb15g7e4bg44c5g92e4g20f068fcbd55"
msgid "Ketheric Thorm is - was - my father."
msgstr "케서릭 쏨은 내 아버지...였죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 0ed5cf3f-19f2-0536-1447-989da5615e14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:0ed5cf3f-19f2-0536-1447-989da5615e14
msgctxt "he9959d7dgd435g4684g8c66g879cf54b0dd0"
msgid "A great deal, but still some of the details elude me."
msgstr "많은 일이 있었죠, 하지만 아직도 이해하지 못한 일들도 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 137d8734-82ae-5980-594b-dd3009669ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:137d8734-82ae-5980-594b-dd3009669ef1
msgctxt "hb1517dbag7812g4a78g819eg60d1c43ffc0d"
msgid ""
"You jest, yet he <i>did</i> seem a ghost to me. A shadow of the father I "
"loved. He resurrected me with magic so foul I nearly retch just thinking of "
"it."
msgstr ""
"웃기네요, 하지만 <i>정말</i> 귀신처럼 보이기는 했어요. 사랑하던 아버지의 그림자였죠. 저를 너무나도 불결한 마법으로 부활시켜서 "
"이젠 생각만 해도 구역질이 나요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 14611677-9502-3200-abde-019eba992a70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:14611677-9502-3200-abde-019eba992a70
msgctxt "he37f6f13ge2b3g4098gb2edgd018be4d3e52"
msgid ""
"She's a formidable woman, my Aylin, but no one could escape such horrors "
"unscathed. She's in my hands, now, and I intend to help her through "
"whatever's to come."
msgstr ""
"물론 그녀는 만만찮은 여성이죠, 나의 에일린. 하지만 그런 공포에 상처받지 않을 이는 없어요. 이제 에일린은 제 손에 있고, 앞으로 어떤 "
"일이 오건 그녀를 도와나갈 거에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 15be98de-cc78-e7c2-0a15-8bbc0bd63f85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:15be98de-cc78-e7c2-0a15-8bbc0bd63f85
msgctxt "h72ecc2ffg370cg4520g95a9g36f448d69f4d"
msgid "You and Aylin seem to have a lot of history. What happened?"
msgstr "당신과 에일린에겐 사연이 있어 보이던데, 무슨 일이 있었나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 16312328-f95b-cad8-f317-9d928cc3ad31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_ShadowheartKilledNightsong = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:16312328-f95b-cad8-f317-9d928cc3ad31
msgctxt "h142f5846g6bc3g4d7agaeffg4ab64ac3ad35"
msgid "It's too late for that. We killed her."
msgstr "늦어버렸네요. 우리가 죽여버렸거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 18e4e16d-e292-b6e5-c8f0-8528654d64f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:18e4e16d-e292-b6e5-c8f0-8528654d64f6
msgctxt "h6a59876egb9dbg4bcbg8a8fg6d230242cb84"
msgid ""
"Ketheric captured her and was using her to fuel his invulnerability. She was "
"called the 'Nightsong'."
msgstr "케서릭이 그녀를 붙잡아 불사의 연료로 사용하고 있더군요. '밤의 노래'라고 불리고 있었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 1b98dabc-e94a-34ed-574e-4409888705e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:1b98dabc-e94a-34ed-574e-4409888705e5
msgctxt "h5d48bf5ege3e9g4881g8070gf80b4ed3b52f"
msgid "It's too late for that. I killed her."
msgstr "이미 늦었어요. 제가 죽였으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 1d089989-719b-6fd9-0fa5-2c3505941705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_State_CurseLifted = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:1d089989-719b-6fd9-0fa5-2c3505941705
msgctxt "h3837d3a6g30e7g4968g853cgbb4a73940ed8"
msgid ""
"In seriousness, my home needs me. It's still enveloped in Shar's horrific "
"curse. If it can be cleansed, I'll find a way."
msgstr ""
"그건 장난이고, 고향은 절 필요로 해요. 아직도 샤의 끔찍한 저주에 둘러싸여 있으니 말이죠. 이 저주를 해제할 수만 있다면, 어떻게든 "
"방법을 찾을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 1ead3ea8-f84b-63b8-3d4f-7a859eea01d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:1ead3ea8-f84b-63b8-3d4f-7a859eea01d4
msgctxt "h65c74aa7g4c33g44eagaf78gba9fa176c5c8"
msgid "Why would you lie? What's the matter with you?"
msgstr "왜 거짓말을 하는 거죠? 당신은 도대체 뭐가 문제에요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 2264cdf5-3170-4335-3909-3fc306949a7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:2264cdf5-3170-4335-3909-3fc306949a7d
msgctxt "ha87aee03g9a37g4727g94ecg55a76545cef0"
msgid "No, but it sounds like you do."
msgstr "아뇨, 하지만 당신은 믿는 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 25553a0b-8a58-d953-d161-e533000c60f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:25553a0b-8a58-d953-d161-e533000c60f5
msgctxt "h66c5c482gdf41g4e68gaf72g709353302f55"
msgid "I know you'll look out for her. You will, right? Of course you will."
msgstr "당신이 그녈 돌봐줄 거란 걸 알아요. 그럴 거죠? 물론 그러겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 2649af55-587a-2de2-94ba-d9eefee7db2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:2649af55-587a-2de2-94ba-d9eefee7db2e
msgctxt "h5807c142ga83eg48d9ga5edg38e45011ffdb"
msgid "On my life, I wouldn't go near magic so vile."
msgstr "맹세하건대, 그런 불결한 마법 근처에도 가지 않을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 28e75612-bea3-2ff8-82cc-bc07dbc24c97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:28e75612-bea3-2ff8-82cc-bc07dbc24c97
msgctxt "h3573b480gc9f4g43f5g8893gc99c179e6918"
msgid ""
"By the time Jaheira came, I'd pieced together just enough to know I'd been "
"dead a hundred years. That my father was the source of the horrors plaguing "
"this land - my home."
msgstr ""
"자헤이라가 왔을 때, 제가 죽은 지 100년이 지났다는 사실을 겨우 알아차렸어요. 그리고 아버지가 이 땅, 내 고향을 고통받게 만든 "
"공포의 근원이라는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 2fc1160a-913c-ebad-815f-ce21fd5968b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:2fc1160a-913c-ebad-815f-ce21fd5968b1
msgctxt "hbbb83f42gd80dg4524ga873g2dc8a988fefc"
msgid ""
"I did. Who would trust the next-of-kin of Ketheric Thorm? But I have no more "
"secrets."
msgstr "맞아요. 누가 케서릭 쏨의 혈육을 믿어 주겠어요? 하지만 더 이상 비밀은 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 385c931b-4c2a-1bca-fe35-7e9bec03179f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:385c931b-4c2a-1bca-fe35-7e9bec03179f
msgctxt "h82734d57gec15g48c2ga29fg202029e8d8f3"
msgid "And a monster he'd become. A Myrkulite."
msgstr "그리고 그는 괴물이 된 거죠, 머큘의 신도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 3b965176-d066-f523-9e35-3f340321a5f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:3b965176-d066-f523-9e35-3f340321a5f0
msgctxt "h1968cb92g4131g4695gbe12g71745a1f26d2"
msgid "What will you do now that your father's gone?"
msgstr "아버지가 죽었으니 이제 어떻게 할 생각이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 3c2828c6-a2db-64cf-4f92-2a60f1e7dc38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:3c2828c6-a2db-64cf-4f92-2a60f1e7dc38
msgctxt "hf8c8e68cg9b49g4bdfgaf8bg0cdfc9b6d0f9"
msgid ""
"Not on purpose. Or not with the intent to deceive. I've been trying to make "
"sense of it all."
msgstr "일부러 그런 건 아니에요. 속이려는 목적도 아니었고요. 그저 이 모든 걸 이해하려는 중이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 40763cda-e656-15da-7706-2fdc97592de9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:40763cda-e656-15da-7706-2fdc97592de9
msgctxt "h783984a9gd553g49abg9f6dge8ecd06aa96a"
msgid "Liar. Wicked, wicked liar. <i>Murderer.</i>"
msgstr "거짓말쟁이. 악한, 사악한 거짓말쟁이. <i>살인자.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 4106c63e-3992-afe7-2119-ac52ab7d2dae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:4106c63e-3992-afe7-2119-ac52ab7d2dae
msgctxt "h463673a8g857bg45e0g8f02g8c50ec2ccb03"
msgid ""
"As I was saying, I fell in love with Aylin swiftly. It was as easy as "
"breathing."
msgstr "제가 말하려던 건, 에일린과 금세 사랑에 빠져버렸다는 거에요. 마치 숨 쉬듯이 쉬웠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 462971c8-abb5-b0d0-6183-8c80450fb448
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:462971c8-abb5-b0d0-6183-8c80450fb448
msgctxt "h88df8032g6ee7g42a3gabacg757e286048c9"
msgid ""
"I should hope so. I can't imagine what insane course of thought led you to "
"murder someone so dear."
msgstr "그러길 바라요. 이렇게 소중한 사람을 살해하기까지 어떤 미친 생각과정이 있었을지 상상도 못하겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 46f223c7-6fac-6a65-1509-54e2b3c04e20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_State_CurseLifted = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:46f223c7-6fac-6a65-1509-54e2b3c04e20
msgctxt "h7713673fgbd49g4e9fgaf9fg5dbf3ca1f8fd"
msgid ""
"In seriousness, I intend to help you fight the Absolute - what lies "
"<i>behind </i>the Absolute, that is."
msgstr "그건 장난이고, 절대자와 싸울 때 도와드릴 생각이에요. 절대자 <i>뒤에</i> 뭐가 있던 간에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 472257ef-bca2-5adc-148b-db0f954b4efd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:472257ef-bca2-5adc-148b-db0f954b4efd
msgctxt "he2cbbe59ga59ag4faagbd7dg308a8890b1d0"
msgid ""
"Look after my angel, of course. She's been through more than I can bear to "
"think about."
msgstr "당연히 내 천사를 돌봐야죠. 제가 상상할 수 있는 것 그 이상을 겪어왔으니까요. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 47ac3a56-fa2a-a258-e50e-1aafbf505ae2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:47ac3a56-fa2a-a258-e50e-1aafbf505ae2
msgctxt "hc7ea9d1agb0f8g4d61gb5f7gf5b3a49aba9f"
msgid "It seems there's a great deal you haven't told me."
msgstr "제게 아직 중요한 걸 말해주지 않은 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 4aaa02f5-1eec-af26-4d5e-871c6bb16485
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Isobel_State_Hate = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:4aaa02f5-1eec-af26-4d5e-871c6bb16485
msgctxt "he60d0811gef4bg4fdcgb25dgfa647375a39c"
msgid "Get out of my sight before I do something you'll regret."
msgstr "후회할만한 짓을 하기 전에 제 눈앞에서 사라지세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 4c3db8cd-88e1-aae3-2d1b-c549b460e7ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:4c3db8cd-88e1-aae3-2d1b-c549b460e7ed
msgctxt "h03a9d441g8a94g4bf4g905fgeb41bd6ea253"
msgid ""
"Then - and this is where I still need answers - I died. I'm not sure how. "
"Why. But all was black, black, black."
msgstr ""
"그리고, 아직 해답이 필요한 부분이지만, 저는 죽었어요. 아직도 어떻게 된 일인지 잘 모르겠네요. 모든 것이 어둡고, 어둡고, 어두웠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 4d8e1a90-0e18-6f59-c5c4-d0ea92e65c1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelNightsongReunion_SoloIsobel_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:4d8e1a90-0e18-6f59-c5c4-d0ea92e65c1d
msgctxt "hd0595f71g769bg42fbga361gd7bc1cbf349a"
msgid ""
"So you're Ketheric's daughter. Where were you while he was amassing an army "
"for the Absolute?"
msgstr "당신이 케서릭의 딸이었군요. 그가 절대자를 위한 군대를 소집할 동안 어디에 있었던 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 50bbc8b1-a4d6-2b15-e87c-b32779addf98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:50bbc8b1-a4d6-2b15-e87c-b32779addf98
msgctxt "h71f26783g3088g4459gb19fg5643f478bf5c"
msgid ""
"A mission? A mission?! That Sharran murderer destroyed someone so precious, "
"so good..."
msgstr "임무? 임무요?! 그 샤의 살인자가 너무나도 소중하고, 너무나도 선한 사람을 죽여버렸다고요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 54da9a51-ccbc-16a9-5579-a5b4e6eb9401
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:54da9a51-ccbc-16a9-5579-a5b4e6eb9401
msgctxt "ha69a05b5g4533g47f6g9d29gc1494cbb2373"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 5a577d92-8fb0-d0e6-1664-ba950b6e45da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:5a577d92-8fb0-d0e6-1664-ba950b6e45da
msgctxt "h83ec632cgbe34g4891g9ebegeaf3f25c2c12"
msgid "Love? Eh. Lust? Hourly."
msgstr "사랑? 흠. 성욕? 언제든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 5c93b8fd-9cfd-5f61-85b2-80cdbebe028f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:5c93b8fd-9cfd-5f61-85b2-80cdbebe028f
msgctxt "h9f5f025dg5035g4fbbg90e7gfe75044024bd"
msgid "You really claim to be unaware of his doings?"
msgstr "정말 그가 한 짓을 모르고 있었다는 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 5fd6b395-47ca-7ff6-4c3a-5afac0682cb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:5fd6b395-47ca-7ff6-4c3a-5afac0682cb3
msgctxt "haa5f8dbbg54b4g4663gbcf5gf7666fb726d4"
msgid "Nightsong? What do you mean?"
msgstr "밤의 노래가요? 무슨 말이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 62648f2b-7147-b7c8-30c6-67cef577eecf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:62648f2b-7147-b7c8-30c6-67cef577eecf
msgctxt "h5ab00bd5gd916g45b8g97f2gd08e815d06fa"
msgid "I certainly believe you were starstruck, at least."
msgstr "적어도 당신이 그녀에게 반해버렸다는 건 확실히 알겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 632c6240-fbc5-7ec7-17e2-e0ec4704e7bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:632c6240-fbc5-7ec7-17e2-e0ec4704e7bf
msgctxt "hbd8fa166g2100g40b0ga926g431002d430f2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 63f9515e-7641-bd82-a60d-23a94aa8a2e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:63f9515e-7641-bd82-a60d-23a94aa8a2e3
#, fuzzy
msgctxt "hbc327549gf36ag405ag82cag9e0b880d5d5c"
msgid ""
"Guilty. The moment I looked at Aylin, I just knew I had to be with her. I "
"was hers. That was it."
msgstr "들켰네요. 에일린을 본 순간, 그녀와 함께여야 한다는 걸 그냥 알았죠. 난 그녀의 것이 되어버렸고 그걸로 끝이었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 65c2a71a-c474-acba-55c7-5fe45ec8d267
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:65c2a71a-c474-acba-55c7-5fe45ec8d267
msgctxt "hc7eb2fabg72cdg4e3dgb893g14233491351f"
msgid "This was different. It was like I could see my fate in her eyes."
msgstr "이건 뭔가 달랐어요. 그녀의 눈에서 내 운명을 보는 것만 같았죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 65db4740-4bbc-2c3c-10aa-2889d18c87be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:65db4740-4bbc-2c3c-10aa-2889d18c87be
msgctxt "he6fca524g4017g44e3ga2fagd44c6a656b8a"
msgid ""
"Lucky for me, she felt the same way. But my father was sceptical. Aylin is "
"immortal, after all."
msgstr "운 좋게, 그녀도 같은 마음이었죠. 하지만 아버지는 언짢아하셨어요. 아무래도 에일린은 불사의 몸이니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 68beccb6-ef6a-571c-e9c5-114127c0f4b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:68beccb6-ef6a-571c-e9c5-114127c0f4b9
msgctxt "ha7939860g0fa6g4fcegb59cgd66782b49f1e"
msgid "Shar got the better of me. It won't happen again."
msgstr "샤에게 압도당해 버렸어요. 다신 그럴 일 없을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 6af54a07-eb24-63af-2a4f-a346f60cdc08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:6af54a07-eb24-63af-2a4f-a346f60cdc08
msgctxt "hc00d6e4bgb9a5g4ba1gaf8eg3ed4033d7a30"
msgid ""
"She... <i>what</i>?! Does this mean she's still alive? I've got to find her -"
" set her free! Tell me everything you know. <i>Please.</i>"
msgstr ""
"에일린이... <i>뭐</i>?! 그러면 에일린이 아직 살아있다는 건가요? 찾아서 풀어줘야겠어요! 아는 걸 전부 얘기해주세요. "
"<i>제발요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 6cc0ea45-73ac-e773-9486-75b8c37d364a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:6cc0ea45-73ac-e773-9486-75b8c37d364a
msgctxt "hd3c387b6g069bg48ecg9141g1206fd6e046e"
msgid "It was the only way to make Ketheric vulnerable."
msgstr "케서릭을 약화할 유일한 방법이었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 71858be0-4730-4d5f-4c46-0be4b5a77788
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:71858be0-4730-4d5f-4c46-0be4b5a77788
msgctxt "h7e950cb6g3815g41a5g8586g4569c717b8a2"
msgid ""
"Without you, we'd be there still. My father fell so far from light, the "
"shadow of him nearly swallowed us all whole."
msgstr ""
"당신이 없었다면 우리는 아직도 그곳에 있었겠죠. 빛에서 너무나도 멀리 떨어져 버린 제 아버지의 그림자가 우리를 통째로 집어삼킬 뻔 했네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 71dc1466-41b8-1573-1a3c-3caed3e2209f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:71dc1466-41b8-1573-1a3c-3caed3e2209f
msgctxt "hef663f3ag0104g44bdgafd3g68a3bf8df9ed"
msgid "Tell me, do you believe in love at first sight?"
msgstr "당신은 첫눈에 사랑에 빠진다는 말을 믿나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 7252dc9f-64f7-f1f7-0b1e-8863707a71f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:7252dc9f-64f7-f1f7-0b1e-8863707a71f8
msgctxt "h8b59877bg855fg41cag8d0fg77aeb86b7b45"
msgid "There is. But perhaps it's time you knew the entire truth."
msgstr "맞아요. 하지만 이젠 모든 진실을 알려줄 때가 된 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 73e8ea1a-1023-e587-47b1-83848a798525
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:73e8ea1a-1023-e587-47b1-83848a798525
msgctxt "h8a11e49bg4ff5g4d2ega04dg24cbb7a282ac"
msgid ""
"I'm grateful for your help - your friendship. I hope we won't intrude on "
"your hospitality too long, but I'm grateful for a safe place to... well, "
"just to <i>be</i>."
msgstr ""
"도와줘서 정말 고마워요. 이 우정도요. 이 호의에 너무 오래 기대지 않도록 할게요. 하지만 안전한 곳에... <i>있을</i> 수 있는 "
"것만으로도 감사해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 73f275f3-409e-a219-869f-4edaa9294a27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelNightsongReunion_SoloIsobel_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:73f275f3-409e-a219-869f-4edaa9294a27
msgctxt "h1cc48de3g9ec3g4197g9d6ag4d9f7b63678a"
msgid ""
"So you're Ketheric's daughter. Where were you while he was amassing an army "
"for the Absolute?"
msgstr "당신이 케서릭의 딸이었군요. 그가 절대자를 위한 군대를 소집할 동안 어디에 있었던 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 796e4150-4599-b382-3296-4cec763b6007
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:796e4150-4599-b382-3296-4cec763b6007
msgctxt "h5131431cgb897g425egb819g6b638a487bd4"
msgid "By killing him, you set him free. You set <i>Aylin </i>free. And me."
msgstr "죽음으로 아버지에게 자유를 준 거에요. 그리고 <i>에일린</i>에게도, 제게도 자유를 준 거고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 7b9fe7ff-5286-7b82-07ae-5298cf376323
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:7b9fe7ff-5286-7b82-07ae-5298cf376323
msgctxt "h31cde6bag94a0g421ega4f5gbd1de771467f"
msgid "It's... a long story. But I'll tell it - you deserve to know."
msgstr "그건... 긴 이야기예요. 하지만 말할게요, 당신은 그럴 자격이 있으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 7d559473-4d35-2acb-6b37-e1d37723eea8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:7d559473-4d35-2acb-6b37-e1d37723eea8
msgctxt "h5b9d98d3g712dg456egbb5bge3efa22c272e"
msgid ""
"It's all out in the open now. And with my father dead, I have nothing to "
"fear. Only his wicked legacy to undo."
msgstr "전 이제 모든 걸 다 밝혔어요. 아버지도 죽었으니, 두려워할 것도 없죠. 남은 건 그 악업을 되돌리는 것뿐이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 7dd4fc96-1540-95c5-cda7-3071460edc7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:7dd4fc96-1540-95c5-cda7-3071460edc7b
msgctxt "h6260f992gcc97g46c7g9b67g45c8bcf3c2d8"
msgid "Never mind."
msgstr "신경 쓰지 마요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 7e57fc6c-7b09-870f-4363-a0ea543ad717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:7e57fc6c-7b09-870f-4363-a0ea543ad717
msgctxt "hc45326e8g4717g4cc8gbb6fg2e4c8149c8f3"
msgid ""
"We'll both of us stand by you when the time comes to put down the horror "
"that threatens this city. We are your allies for life."
msgstr "이 도시를 위협하는 공포를 처단할 때가 온다면 우리 둘은 당신 곁에 서겠어요. 우리는 평생 당신의 편이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 819f3f61-b2b9-fb14-e2ad-75c6cb8ef6fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_ShadowheartKilledNightsong = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:819f3f61-b2b9-fb14-e2ad-75c6cb8ef6fe
msgctxt "h735a5d24g7b83g4a9bg8d31ge74195d0515e"
msgid "That's what Ketheric and his chums called her. Killed her myself."
msgstr "케서릭과 그 패거리들이 그렇게 부르더군요. 밤의 노래는 내 손으로 죽였어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 820560e0-4f0f-b3ec-00c7-99c0defe366b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:820560e0-4f0f-b3ec-00c7-99c0defe366b
msgctxt "h2f30dbeege367g4296ga046g9b4c50e7f6a8"
msgid "It's too late for that. She was dead when I found her."
msgstr "이미 늦었어요. 발견했을 땐 이미 죽어있었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 829405be-50ca-6652-732c-0ee94fd6c522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:829405be-50ca-6652-732c-0ee94fd6c522
msgctxt "he59ca0fcg8d5eg476eg87e2ge74af405298a"
msgid "Are you like him? A Myrkulite?"
msgstr "당신도 그와 같은 머큘의 신도인가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 85c41025-2842-517e-c046-c22e69880542
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:85c41025-2842-517e-c046-c22e69880542
msgctxt "h165234f5gfa03g4248ga2cfgafa55c0cbd66"
msgid "Aylin - do you mean Nightsong?"
msgstr "에일린이라니, 밤의 노래를 말하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 86bd7c8e-4edb-5f75-5efa-5716c63e638d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_ShadowheartKilledNightsong = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:86bd7c8e-4edb-5f75-5efa-5716c63e638d
msgctxt "h83b4f025g59aeg4d81g90c3g515e6ae3fd18"
msgid "I couldn't hold my companion back. She had a mission to fulfil."
msgstr "제 동료를 막을 수 없었어요. 해내야 할 임무가 있었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 8866a12f-21af-b073-fe9c-ff1d6faf1e04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:8866a12f-21af-b073-fe9c-ff1d6faf1e04
msgctxt "h4feb3058gd244g4d35g8b0egf9d5d8aa15ab"
msgid ""
"Oh it won't? Then I suppose we'll just forget this little misstep, file it "
"under 'lessons learned'?"
msgstr "정말요? 그러면 우리 모두 이 작은 실수를 잊어버리고 '오늘의 교훈'으로 정리해둘까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 8a4ad298-644a-ffa4-5ec2-526437155571
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_Isobel_ThinksSheCanSaveNS = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:8a4ad298-644a-ffa4-5ec2-526437155571
msgctxt "hf7fe2db5gf337g4baag9fcdgc3496410de1f"
msgid "I hope Aylin's all right. Can't wait to have her in my arms again..."
msgstr "에일린이 괜찮길 바라요. 어서 품에 다시 안았으면 좋겠어요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 8d32ba41-3e69-0119-d228-248b0cff425b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_ShadowheartKilledNightsong = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:8d32ba41-3e69-0119-d228-248b0cff425b
msgctxt "he0488ec3g54a3g44b6g9ee5g245944871f4f"
msgid "That's what Ketheric and his chums called her. We killed her."
msgstr "케서릭과 그 패거리들이 그렇게 부르더군요. 밤의 노래는 우리가 죽였어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 8da149ec-69e1-6c7d-aa5a-37a46db86470
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Isobel_ToldAboutKetheric(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Isobel_ToldAboutKetheric(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:8da149ec-69e1-6c7d-aa5a-37a46db86470
msgctxt "hec74e1ebg4fc4g4362gbb6eg588ca4703cdf"
msgid "I'd like to know what happened between you and your father Ketheric."
msgstr "당신과 아버지, 케서릭 사이에 어떤 일이 있었던 건지 알고 싶어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 8e4913ad-b091-fc65-2f3f-1ec6af764d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:8e4913ad-b091-fc65-2f3f-1ec6af764d82
msgctxt "h27d5bdbbg4447g4e70g8e19g1da5b1876fa9"
msgid "Why did you lie about who you are?"
msgstr "왜 정체를 속인 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 902f4cc4-1c6e-b6a1-739d-e2bcd6cdde10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:902f4cc4-1c6e-b6a1-739d-e2bcd6cdde10
msgctxt "hc91c8b39gacfdg4eadgb32cg5a650a32e6c7"
msgid "You really claim to be unaware of his doings?"
msgstr "정말 그가 한 짓을 모르고 있었다는 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 9671ebbb-bdd7-4f05-f059-4dfc3a078c88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:9671ebbb-bdd7-4f05-f059-4dfc3a078c88
msgctxt "hce2ef08dg4783g4f13gb6dcg8a1165b4981a"
msgid ""
"My father raised me to serve Selûne, as my mother, rest her soul, had "
"wished. He was <i>everything </i>to me, all my life."
msgstr "아버지는 돌아가신 어머니가 바라시던 대로 제가 셀루네를 섬기도록 키웠어요. 아버지는 제 인생의 <i>모든 것</i>이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 977b38d3-b05d-f6d9-c6f1-eb49261e72c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:977b38d3-b05d-f6d9-c6f1-eb49261e72c4
msgctxt "h53476d61g351cg40f3ga6b0g5e9eef5c96df"
msgid "And my father... I heard what happened - what he'd become."
msgstr "그리고 아버지... 무슨 일이 있었는지는 들었어요. 어떻게 변해버렸는지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = 9f1cc9ae-d7d8-4c0a-148e-aac6eeca1858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:9f1cc9ae-d7d8-4c0a-148e-aac6eeca1858
msgctxt "h5382b688g1f32g493cga5a6gb1137c84b4f5"
msgid ""
"That's exactly it. And I tell you, I took one look at her, and I just knew. "
"She was it."
msgstr "바로 그거에요. 말하건대, 첫눈에 알아차렸어요. 운명이라는 걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = 9faf1e73-c7c0-cfee-dd25-eb7798dd1dff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:9faf1e73-c7c0-cfee-dd25-eb7798dd1dff
msgctxt "hd762f6d7g1eeeg4d40gbd1fgc8fd5ca5e84e"
msgid "I feel there's a great deal you haven't told me."
msgstr "아직 나한테 말해주지 않은 게 많은 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = a296c8b6-8800-eb09-7308-fafbcd616a5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelReunion_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:a296c8b6-8800-eb09-7308-fafbcd616a5f
msgctxt "hdb65c48agab3bg4894ga812g7a3862f35b35"
msgid "Keeping very well, I hope?"
msgstr "바라건대 잘 지내고 있죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = a33a4eda-d94e-53df-0577-c63898def9b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelReunion_HasMet(1) = False
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - SCE_IsobelReunion_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:a33a4eda-d94e-53df-0577-c63898def9b8
msgctxt "h4d92a009ga803g420cg906cgcac2f70d74ca"
msgid "You did it - you killed him. Ketheric Thorm. My... my father."
msgstr "해냈군요, 케서릭 쏨을 죽였군요. 나의... 나의 아버지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = a4a50c12-4f78-4c34-2e03-403a38882032
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:a4a50c12-4f78-4c34-2e03-403a38882032
msgctxt "h79850d30g8e93g4469gb16ag54901f853884"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = addb343e-4587-a6df-29ca-5af504a2005e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:addb343e-4587-a6df-29ca-5af504a2005e
msgctxt "he7d806f6g54e9g4c26gb58fgded33b80f4d7"
msgid "I mourn the man I knew. He was... wonderful."
msgstr "내가 알던 예전의 아버지가 그리워요. 정말... 멋진 사람이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = aee0ea57-2a39-0853-b0ef-863600cf4b85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:aee0ea57-2a39-0853-b0ef-863600cf4b85
msgctxt "he6e7403fg9099g4ce9ga9c5gdf448277a539"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = af204f09-357a-a658-b2b4-c76b8bd3a99c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Isobel_ThinksSheCanSaveNS = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:af204f09-357a-a658-b2b4-c76b8bd3a99c
msgctxt "h6b9cd95cg1830g4b01g92f8g63626ce4d0a6"
msgid ""
"Thank you - thank you so much. I'll gather some supplies and head out "
"shortly. Aylin... I can't believe she's alive. Before the day's end, I'll "
"have her in my arms. Incredible."
msgstr ""
"고마워요, 정말 고마워요. 장비를 챙겨서 금방 나갈게요. 에일린... 그녀가 살아있다니 믿기지 않아요. 오늘이 가기 전에 다시 제 품 "
"안에 안기겠죠. 놀라워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = b0b402b8-1a54-49a8-48a1-0685aad3ef3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:b0b402b8-1a54-49a8-48a1-0685aad3ef3d
msgctxt "h239b01f2g17f5g407cg9cc3g365db590e627"
msgid "It was a mistake. One I bitterly regret."
msgstr "실수였어요. 뼈저리게 후회해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = b3523e13-45e0-234f-9477-fa05def716e8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:b3523e13-45e0-234f-9477-fa05def716e8
msgctxt "hcc63cb86g6c68g4d34gb613g31a15070d811"
msgid "Give me your map. I'll show you where she's being kept."
msgstr "지도를 주세요. 어디에 갇혀있었는지 알려드리죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = b4190fad-9509-9d9c-241e-76948267aa8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:b4190fad-9509-9d9c-241e-76948267aa8b
msgctxt "h88a4a622gb041g405dg959ag5907e52f438d"
msgid ""
"I understand it's... strange. There's an imbalance between us, certainly. "
"But I suppose loving Aylin felt the same as loving myself. It was natural."
msgstr ""
"이게... 이상하다는 건 저도 알아요. 확실히 균형 잡힌 관계는 아니죠. 하지만 에일린을 사랑하는 것을 제 자신을 사랑하는 것처럼 "
"자연스럽게 느꼈던 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = b741f46d-9d0c-7232-18bf-535f3ae6e664
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelReunion_HasMet(1) = True
#.   Global:
#.      - CURRENTREGION_BGO_Main_A = False
#.      - CURRENTREGION_CTY_Main_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:b741f46d-9d0c-7232-18bf-535f3ae6e664
msgctxt "ha378c55ege1b7g4447g80eagf0ee696397e5"
msgid ""
"Looking forward to a bit of rest, if I'm honest. It's been a long century."
msgstr "솔직하게 말하자면 어서 쉬고 싶네요. 정말 긴 한 세기였어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = b8351afc-0777-68c0-868e-875660cddbc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:b8351afc-0777-68c0-868e-875660cddbc4
msgctxt "h347a7315g9f7fg4d6egb5d8ga3e218d2612c"
msgid "He'd become the Chosen of Myrkul."
msgstr "머큘의 선택받은 자가 되어버렸던 거죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = b9c70bab-be0e-8672-e6a8-1c86768d753e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:b9c70bab-be0e-8672-e6a8-1c86768d753e
msgctxt "hfd639b31g2443g4d19ga92bgaa19c89e99ef"
msgid "As you know, Ketheric Thorm is - <i>was </i>- my father."
msgstr "아시다시피, 캐서린 쏨은... 제 아버지<i>였었죠</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = bbc96c99-a1f3-8352-666c-99ad1756bb89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:bbc96c99-a1f3-8352-666c-99ad1756bb89
msgctxt "hca3b7767gc9b7g4cd3gb5ebgff7f6a40fce5"
msgid ""
"It's all out in the open now. And with my father dead, I have nothing to "
"fear. Except for Aylin. She needs healing. Rest."
msgstr "이제 모든 걸 다 밝혔어요. 아버지도 죽었으니, 걱정할 것도 없죠. 에일린만 빼고요. 에일린은 치유가, 휴식이 필요해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = bd6369dd-b413-a7f5-e622-4680d0838532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:bd6369dd-b413-a7f5-e622-4680d0838532
msgctxt "h86ca7ef5gad59g4298g8b10gdfd3ce004ec9"
msgid ""
"I didn't know that then. But I could see the change in him. He told me we'd "
"be together now, said Aylin was <i>dead</i>. I couldn't speak. Could only "
"<i>run</i>."
msgstr ""
"당시엔 그걸 몰랐어요. 하지만 그가 변했다는 건 알 수 있었죠. 아버지는 이제 우린 함께라고, 에일린은 <i>죽었다고</i> 했어요. 전 "
"입도 뻥긋할 수 없었고 <i>도망치는 것</i>말곤 할 수 있는 게 없었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = bdad0bb0-01d8-2861-59a8-ea14d48be2c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:bdad0bb0-01d8-2861-59a8-ea14d48be2c0
msgctxt "hb4ce6f2agaf8cg49f1g83eeg9d516fa3ebd4"
msgid "Oh, I don't know. Change my hair colour. Buy a horse."
msgstr "아, 모르겠어요. 머리 색을 바꾸거나, 말이라도 살까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = bdf0f5f9-0be8-c021-e8ae-e5097d797df9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Isobel_ToldAboutKetheric(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:bdf0f5f9-0be8-c021-e8ae-e5097d797df9
msgctxt "h67efad28g8857g4f9cgb774g0c45f620c923"
msgid "Tell me again about what happened between you and your father Ketheric."
msgstr "당신과 아버지, 케서릭 사이에서 무슨 일이 있었던 건지 다시 말해줘요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = bf594e39-cec5-6ecf-c34d-14c9a6799714
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(1) = True
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:bf594e39-cec5-6ecf-c34d-14c9a6799714
msgctxt "h52205568g9547g48b9gb257g19ef755cb819"
msgid ""
"You <i>what</i>?! But she was immortal. How could she... how could <i>you</"
"i>...? She is the Moonmaiden's daughter. And you call yourself a Selûnite?!"
msgstr ""
"당신이 <i>뭐라고요</i>?! 하지만 에일린은 불사였을 텐데. 어떻게 그녀가... 어째서 <i>그런 짓을</i>...? 에일린은 "
"달처녀의 딸이라고요. 그런 짓을 하고도 셀루네 신도라고 할 수 있나요?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = bfae2743-2b8b-677c-83f6-b7301126d224
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:bfae2743-2b8b-677c-83f6-b7301126d224
msgctxt "h4bcd22b5gd96cg4472ga7a9g413cba516ca5"
msgid "Did he shout 'boo!'?"
msgstr "'워!'하고 놀라게 했나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = c2884328-07ce-dba3-cc20-a8caa4a5fbf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:c2884328-07ce-dba3-cc20-a8caa4a5fbf4
msgctxt "hadb6b891g6f4bg4bd8ga6c9g55567866b91e"
msgid "What will you do now that your father's gone?"
msgstr "아버지가 죽었으니 이제 어떻게 할 생각이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = c63b7857-1dcd-78c4-cbce-e0b72a3d222c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:c63b7857-1dcd-78c4-cbce-e0b72a3d222c
msgctxt "h129a3a8ag5cbcg4e05gb49cg3448ad1647ea"
msgid ""
"Next I knew, I was being jolted awake. I smelled musty air. I saw shadows. "
"And then my father's face, so changed, so hideously warped."
msgstr ""
"그다음에 기억나는 건, 제가 갑자기 깨어나고 있었다는 거예요. 곰팡이 냄새가 나고 그림자들이 보이더니, 너무나 흉측하게 비틀리고 변해버린 "
"아버지의 얼굴이 시야에 들어왔죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = c720fae4-086a-9c49-562b-3a1d3f6fc8a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:c720fae4-086a-9c49-562b-3a1d3f6fc8a8
msgctxt "hb68c506cg4ba7g45bfgbb27g3de0621f68b4"
msgid ""
"When we met, it was like a lightning strike. My father wasn't sure about us -"
" she was immortal, after all - but I never doubted."
msgstr ""
"우리가 만났을 때, 마치 벼락에 맞은 듯했어요. 아버지는 달가워하지 않으셨지만요. 그럴 것도, 에일린은 불사의 몸이었으니까요. 하지만 전 "
"한순간도 의심하지 않았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = cb7e83b0-a413-247c-c6b7-da36d93f4cd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_Isobel_State_Hate = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:cb7e83b0-a413-247c-c6b7-da36d93f4cd6
msgctxt "h7b118565g0f99g4f89gbec1g2a80be88d820"
msgid "Get away from me. <i>Now.</i>"
msgstr "제게서 떨어지세요. <i>지금 당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = ce88bab2-d5d1-fee8-5e5e-a012c2b1edd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:ce88bab2-d5d1-fee8-5e5e-a012c2b1edd0
msgctxt "h092e1f49g5683g4a2ag8d22g9b60fb7d5698"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = ce94a487-6712-e1eb-9898-c54069423f67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_HasMet(1) = False
#.      - SCE_IsobelReunion_HasMet(1) = False
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - SCE_IsobelReunion_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:ce94a487-6712-e1eb-9898-c54069423f67
msgctxt "hbfe1e14eg3108g4816ga127gb10fee0573ae"
msgid "You did it - you killed him. Ketheric Thorm. My... my father."
msgstr "해냈군요, 케서릭 쏨을 죽였군요. 나의... 나의 아버지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = d24caa0e-3fd7-5374-e290-66f89da6376f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:d24caa0e-3fd7-5374-e290-66f89da6376f
msgctxt "h8c8943dcg046bg470ega490g1b7729bb1fd5"
msgid ""
"A hundred years in the Shadowfell. A hundred years being murdered by "
"Sharrans over and over. It fills me with a rage I can hardly contain."
msgstr "섀도펠에서 백 년. 샤 신도들에게 계속하여 살해당하기를 백 년. 제가 감당할 수 없을 정도의 분노를 느끼게 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = d2f80e30-46c9-fac5-87a7-0dea714780a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:d2f80e30-46c9-fac5-87a7-0dea714780a5
msgctxt "he463a37bg81a8g4c3bg8d1eg9a49f03d0966"
msgid "You and Aylin seem to have a lot of history. What happened?"
msgstr "당신과 에일린에겐 사연이 있어 보이던데, 무슨 일이 있었나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = d409fae9-f0ed-809f-964c-862fc9c230c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:d409fae9-f0ed-809f-964c-862fc9c230c8
#, fuzzy
msgctxt "h060446b9g8351g4c33g82fag1419a60ee3d4"
msgid ""
"He's gone now. But I suppose the man I knew died when I died. The man he "
"became - that wasn't the father I knew. The one I loved so very much."
msgstr ""
"이제 아버지는 없죠. 하지만 제가 죽었을 때 이미 제가 알던 아버지도 함께 죽었던 거로 생각하고 있어요. 바뀌고선 제가 알던 사람이, "
"제가 사랑하던 아버지가 아니게 되었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = d4f166ea-065e-a632-aa05-9a7225e365a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:d4f166ea-065e-a632-aa05-9a7225e365a6
msgctxt "h64d5a41ege095g4ac7g9a9bg22b6946ee96a"
msgid ""
"I had a safe haven - it was my duty to protect the people at Last Light. If "
"I'd told them I was the daughter of Ketheric Thorm, they might've taken "
"their chances in the darkness."
msgstr ""
"제겐 안전한 피난처가 있었으니까요. 최후의 빛에 있는 사람들을 지키는 게 제 일이었죠. 제가 케서릭 쏨의 딸이라는 걸 말했다면, 다들 "
"차라리 어둠 속으로 떠나고 말았을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = d8c48fc6-fee8-e449-0929-22cf42d3a8b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:d8c48fc6-fee8-e449-0929-22cf42d3a8b7
msgctxt "ha768fb6bgb3b1g4b51g81b1g66041837ada5"
msgid ""
"My father said she was gone. I'd tried to make my peace with it. But... she "
"was so special. So very dear."
msgstr ""
"아버지는 그녀가 죽었다고 말했었죠. 전 그걸 받아들이려고 노력했고요. 하지만... 그녀는 너무나도 특별했어요. 너무나도 소중했어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = dbf562e5-49f7-b7ae-57a8-4b3ddfcc6da5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelReunion_HasMet(1) = False
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - SCE_IsobelReunion_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:dbf562e5-49f7-b7ae-57a8-4b3ddfcc6da5
msgctxt "hcf5dfdaeg7428g45b3g961cg1912931e7124"
msgid "I can't believe it. I can't believe Aylin is here."
msgstr "믿을 수 없어. 에일린이 눈앞에 있다니 믿을 수 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = deaa0c82-b77d-1e5e-1987-cb614cae08ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_Nightsong_Event_GoToRamazithTower = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:deaa0c82-b77d-1e5e-1987-cb614cae08ff
msgctxt "hd1ba5dbag013bg4084g83a4gaa9423383b2e"
msgid "I wish Aylin would be more careful. I couldn't bear to lose her again."
msgstr "에일린이 조금만 더 조심해 줬으면 좋겠어요. 그녀를 또 잃어버릴 순 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = e14453f8-8b66-f47a-b360-7732ed1d6556
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:e14453f8-8b66-f47a-b360-7732ed1d6556
msgctxt "hdec9040egc67bg455dg9de2g60b837f76625"
msgid ""
"You're disgusting. You've killed someone so precious, so good. I knew Shar "
"was wicked. But I'd hoped for better from <i>you</i>."
msgstr ""
"역겹네요. 당신은 정말 소중하고, 정말 선한 사람을 죽였어요. 샤가 악하다는 건 알고 있었죠. 하지만 <i>당신</i>은 그보다 낫길 "
"바랐어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = e69a4814-7c72-4be7-2030-81ba7b64c15e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:e69a4814-7c72-4be7-2030-81ba7b64c15e
msgctxt "hb9f77440g774dg44caga0d4g34d5615ce6a1"
msgid ""
"He raised me to serve Selûne, as my mother, rest her soul, had wished. He "
"was <i>everything </i>to me, all my life."
msgstr "아버지는 돌아가신 어머니가 바라시던 대로 제가 셀루네를 섬기도록 키웠어요. 아버지는 제 인생의 <i>모든 것</i>이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = e7eb451f-9ebf-be04-796a-d28dbb2991b2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:e7eb451f-9ebf-be04-796a-d28dbb2991b2
msgctxt "h1e3f7dd9g08b0g4c24g8fc9g2e41a722a58e"
msgid "When the Lady of Loss speaks, her faithful act on her behalf."
msgstr "상실의 여신이 입을 여시면, 신도는 그녀를 위해 행동하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = e8e3ef15-5de9-f82a-e63f-e8c9f6e0b8b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:e8e3ef15-5de9-f82a-e63f-e8c9f6e0b8b1
msgctxt "h23535187g080bg4eaegbba6ga9cc5fda9f21"
msgid "Only a monster would rip his own daughter from the grave."
msgstr "괴물만이 자신의 딸을 무덤에서 끌어올릴 거에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = e8faf1c6-fb4d-cdf0-694f-80a5cbb5f781
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:e8faf1c6-fb4d-cdf0-694f-80a5cbb5f781
msgctxt "h5f7d094ag304cg465bgaed5g9d3996d537c2"
msgid ""
"You sound like my father. But it was more than that. This was no mere "
"attraction - it was love."
msgstr "제 아버지같이 말하네요. 하지만 고작 그 정도가 아니에요. 이건 단순한 흥미가 아니었어요, 사랑이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = eada44a3-674d-edc0-5aac-74a20b3faeaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:eada44a3-674d-edc0-5aac-74a20b3faeaf
msgctxt "h80dc25dcg75e9g4d20gb20cge34e20dca250"
msgid ""
"I had no idea what he'd become until it was too late. I fled from him when I "
"found out - kept a sanctuary in the shadows, where I met Jaheira."
msgstr ""
"아버지가 어떻게 변해버렸는지 알았을 땐 이미 늦었고, 알아차리자마자 도망쳐 나왔어요. 그리고 저는 그림자 속에 안식처를 만들었고, "
"그곳에서 자헤이라를 만났죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = ec8899bc-9589-34aa-f78f-f021fc5c9dff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:ec8899bc-9589-34aa-f78f-f021fc5c9dff
msgctxt "h417fd82ag027eg4dddg91d6ge2b51b0e3d76"
msgid "Understandable."
msgstr "이해해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = ed44ca24-d257-bd8d-2e6e-d04de54c8de6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:ed44ca24-d257-bd8d-2e6e-d04de54c8de6
msgctxt "hef56265egfa10g42b3g875cg05cd8127a54b"
msgid ""
"By the time Jaheira came, I'd pieced together just enough to know I'd been "
"dead a hundred years. That my father was the source of the horrors that "
"plagued my home."
msgstr ""
"자헤이라가 왔을 때쯤에, 여러 조각들을 맞춰 제가 백 년간 죽어있었다는 사실을 간신히 알아냈어요. 그리고 아버지가 고향에 재앙을 불러온 "
"장본인이었다는 사실도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = ee3d3542-1994-6b63-9bd2-afecd1bd6332
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:ee3d3542-1994-6b63-9bd2-afecd1bd6332
msgctxt "h57862647gbe8cg4a72gacb3g13dbef423ac5"
msgid "So you lied about who you were."
msgstr "그래서 정체를 속이게 된 거군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = ef20929c-9e03-0df4-8b61-0dd908687456
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Isobel_ToldAboutKetheric(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:ef20929c-9e03-0df4-8b61-0dd908687456
msgctxt "h3f870d4cgda49g4274g9cbfg1120147999c5"
msgid "Aren't you at all sad about your father's fate?"
msgstr "아버지의 최후가 조금이라도 슬프지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = f0cf37a9-c159-7e08-5ff2-25d3328a65fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:f0cf37a9-c159-7e08-5ff2-25d3328a65fb
msgctxt "h0c032d3cg6698g4f0egb093g9ca8cc48ffec"
msgid ""
"He told me we'd be together now, said Aylin was <i>dead</i>. I couldn't "
"speak. Could only <i>run</i>."
msgstr ""
"아버지는 이제 우리가 함께할 수 있을 거라고, 에일린이 죽었다고 말했어요. 아무 말도 나오지 않았죠. 전 도망칠 수밖에 없었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = f133a447-69fa-ef77-d141-a279baf3184c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:f133a447-69fa-ef77-d141-a279baf3184c
msgctxt "h94ebdf20gce15g46e5ga0e9gbf4010f75fc3"
msgid "Was it? Was it <i>truly</i>? I don't believe that. Not for a second."
msgstr "정말요? <i>정말로</i> 그랬나요? 요만큼도 믿을 수 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Player
#. NodeID = f3fb9a6c-d3f2-3ddb-9337-41ee3d1ae6fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:f3fb9a6c-d3f2-3ddb-9337-41ee3d1ae6fd
msgctxt "h6b7c3c82gfb4cg496bg935bg6c2590563dde"
msgid "Certainly. There's magic in a look."
msgstr "물론이에요. 눈길엔 마법이 깃들어 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = fb46af7a-5575-f0dc-9db3-5b1db5a7525e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:fb46af7a-5575-f0dc-9db3-5b1db5a7525e
msgctxt "h4195a28egbfb6g46ffgbee0g4110dae2c2e3"
msgid ""
"None of us will be safe until that looming horror is defeated. When the time "
"comes, I'll fight at your side."
msgstr "그 스멀대는 공포를 해치우기 전 까진 그 누구도 안전할 수 없죠. 때가 온다면, 당신 곁에서 싸우겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel
#. Speaker = Isobel
#. NodeID = fd19a9b8-da67-aeb0-d378-4e3a19331301
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Isobel:fd19a9b8-da67-aeb0-d378-4e3a19331301
msgctxt "h3217168ag71e4g4a56g95c4ga959a21c94e1"
msgid ""
"You're lying. She can't be saved, can she? My father told me she was... "
"gone. It's true, isn't it?"
msgstr "거짓말을 하는군요. 구할 수 없잖아요, 그렇죠? 아버지는 그녀가... 죽었다고 했어요. 그게 사실이었던거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 0451376d-4a46-3dc6-d7f3-a2f4499809cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:0451376d-4a46-3dc6-d7f3-a2f4499809cb
msgctxt "h7b514590g76f8g45c7g95c9g17de82b1e0c3"
msgid "Do you like it? It was bestowed upon me as a reward."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 094a70cb-859e-e365-15d8-38899c51da5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:094a70cb-859e-e365-15d8-38899c51da5a
msgctxt "h88f9cb93g74d2g4edegb1b6g839011a22191"
msgid ""
"But... fine. As you will. My own plans lie ruined back in that inn, amidst "
"the corpses of my Harpers."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 0a6cda57-0fac-a4ca-aaf2-1107e2998963
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:0a6cda57-0fac-a4ca-aaf2-1107e2998963
msgctxt "hd7083abegd54cg42b4g9077gcff724d1035f"
msgid "Pick one. Whichever is quicker. And do it <i>now</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 201784d1-e5dd-0e97-c017-628e4d95a015
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:201784d1-e5dd-0e97-c017-628e4d95a015
msgctxt "hcef50d4dg5026g4855g9660g187e8bcbc902"
msgid "It can do far more than that. Far <i>worse</i> than that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 25481ee5-7aa6-56ab-7b3f-f7da6498d021
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:25481ee5-7aa6-56ab-7b3f-f7da6498d021
msgctxt "h045d83d3g6c25g48aag952fg81f3e5adeb7f"
msgid ""
"I fear we do not have the luxury of time. Last Light has fallen - we alone "
"remain to stop Ketheric from marching on the city."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 26ac227c-c4bb-cb37-3a43-fffc1f07e08a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:26ac227c-c4bb-cb37-3a43-fffc1f07e08a
msgctxt "h9bda766dg6f01g4405gb7f9g6bc596d8c097"
msgid "And hoped never to again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 2dba8214-079f-6dc8-493d-43017e71e97e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:2dba8214-079f-6dc8-493d-43017e71e97e
msgctxt "h0656efc9g8701g47ddgb4f9g99789aac7798"
msgid ""
"To earn a meeting where you will face him alone, at the height of his powers?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 45b27cbf-8a88-4e1c-a775-34a810320781
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_SentNightsongBackToKetheric = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:45b27cbf-8a88-4e1c-a775-34a810320781
msgctxt "hce7b9dbegda42g4996ga118g83160d4eb0a1"
msgid ""
"You have already made that choice. You returned Ketheric's relic to him. "
"Perhaps you won his favour - but now you must face the full force of his "
"power, alone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 469451f5-26b5-5bdd-e37a-ca40ad6b998c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Necromancer_Knows_InvulnerabilitySource = True
#.      - GLO_Ketheric_Knows_ImmortalitySource = False
#.      - MOO_BalthazarsSecrets_Knows_NightsongSecret = True
#.      - MOO_Assault_Event_KethericTeleportedAway = False
#.      - MOO_Audience_State_GrantedPermission = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:469451f5-26b5-5bdd-e37a-ca40ad6b998c
msgctxt "h7423a49bge8eag4578gb088g3e2ad6521739"
msgid ""
"Ketheric's power stems from the Nightsong - a relic that his necromancer, "
"Balthazar, is trying to reach."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 4a7fa38d-32c1-aa6e-6647-db72edf44dc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Necromancer_Knows_InvulnerabilitySource = True
#.      - GLO_Ketheric_Knows_ImmortalitySource = False
#.      - MOO_BalthazarsSecrets_Knows_NightsongSecret = False
#.      - MOO_Assault_Event_KethericTeleportedAway = False
#.      - MOO_Audience_State_GrantedPermission = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:4a7fa38d-32c1-aa6e-6647-db72edf44dc1
msgctxt "hed974e26g8808g425eg84ecg202f99286899"
msgid ""
"Ketheric's power stems from a relic in a Sharran temple: his pet necromancer "
"is trying to reach it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 50441d32-e768-663e-c938-07f8beb8f6c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:50441d32-e768-663e-c938-07f8beb8f6c0
msgctxt "h02033e19g747bg4dc3gb37dge331a3b2696e"
msgid ""
"Once Ketheric is without his shield, the sword: together we assault his "
"tower, and put a final end to this blight."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 508a387e-4016-ff8f-f4b4-abd33e5c09d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:508a387e-4016-ff8f-f4b4-abd33e5c09d8
msgctxt "h46754135g28ddg41f0gb3feg81ed85fe001d"
msgid "No reward, I promise you. A curse."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 5f6939cf-1b00-74da-40e2-6faee2cfab41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:5f6939cf-1b00-74da-40e2-6faee2cfab41
msgctxt "hfb230ff8g0ea1g490dg9b4bg2e56dd52d972"
msgid "It came to me in a dream."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 5f6e3d93-ec1a-ddb2-9bae-4a4622feada2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:5f6e3d93-ec1a-ddb2-9bae-4a4622feada2
msgctxt "he6dcc868gff5eg4517ga163gb39ae52c95fe"
msgid "You've seen it before."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 6367d94b-9a9d-7ae9-9ad9-ca17bd32cba2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_SentNightsongBackToKetheric = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:6367d94b-9a9d-7ae9-9ad9-ca17bd32cba2
msgctxt "h94a95c45g9ec0g4066gaee6gd4676dc31cb5"
msgid "No. I sent the Nightsong back to Ketheric to earn myself an audience."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 643bd772-174d-dae9-efca-787294c91498
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:643bd772-174d-dae9-efca-787294c91498
msgctxt "h07270509gcfa9g4a9ag8150gc37f42bc94c3"
msgid ""
"I need a little time. But I will gladly join you at journey's end - so long "
"as it leads to the grave of General Ketheric Thorm."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 652d8100-f57b-3567-8d75-91cf48c89423
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_SentNightsongBackToKetheric = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:652d8100-f57b-3567-8d75-91cf48c89423
msgctxt "hedca3aeag938cg4448gae57ge991a12d30d3"
msgid "Surely you can join me on the road."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 71073052-ca1d-9f39-cff2-1a2ec7194cbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:71073052-ca1d-9f39-cff2-1a2ec7194cbe
msgctxt "had5d6700g94ffg44d2gaa14gd12359b441fa"
msgid ""
"The time for words will come, when we lay my Harpers to their final rest. I "
"owe them that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 74a45cb0-5194-a38b-bd63-9f8dfac5eb44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:74a45cb0-5194-a38b-bd63-9f8dfac5eb44
msgctxt "hb94168a0gd7fdg4428g8e22gbe9c9b7ee3b4"
msgid ""
"It is you who holds the key to defeating Ketheric, not I. Do what you must. "
"If it rids us of this cult, we'll consider the price well-paid."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 7de0dc0f-e2f4-f201-d825-9570e20766a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:7de0dc0f-e2f4-f201-d825-9570e20766a4
msgctxt "h480dbe4eg85a3g452agb9adge0df528decca"
msgid "So. What now?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 80cd2d9e-30fb-914a-ddd4-4accdcc126da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_SentNightsongBackToKetheric = False
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - HAV_Jaheira_Knows_ToldKethericImmortalitySource = True
#.      - MOO_Assault_Event_KethericTeleportedAway = False
#.      - MOO_Audience_State_GrantedPermission = False
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_SentNightsongBackToKetheric = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:80cd2d9e-30fb-914a-ddd4-4accdcc126da
msgctxt "h0720abecgdf82g4813gb768gaa308b8657ff"
msgid "I sent Ketheric's relic back to him - to earn myself an audience."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = 871206d8-1bc5-48d8-2c41-346b0aef4d40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_Knows_ImmortalitySource = True
#.      - HAV_Jaheira_Knows_SentNightsongBackToKetheric = False
#.      - MOO_Assault_Event_KethericTeleportedAway = False
#.      - MOO_Audience_State_GrantedPermission = False
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_ToldKethericImmortalitySource = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:871206d8-1bc5-48d8-2c41-346b0aef4d40
msgctxt "h99e80163ga9b1g44d5gaa82g1edadf599b9d"
msgid ""
"I discovered the source of Ketheric's invulnerability: a celestial called "
"the Nightsong."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 9747dc1f-0a3a-ccae-3063-c9c241ca3085
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#.     - HAV_Jaheira_Knows_ToldKethericImmortalitySource = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:9747dc1f-0a3a-ccae-3063-c9c241ca3085
msgctxt "hb68ddea4g5b82g4904ga8b0g027c9374d366"
msgid ""
"This relic must be your focus instead, then. Find it. Strip him of its power."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = 976912e6-27f4-483e-8a8f-1be8d860bfff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Jaheira_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:976912e6-27f4-483e-8a8f-1be8d860bfff
msgctxt "h95ea40a8g14b6g498cga26dgdc9360d7a7ff"
msgid ""
"I suppose this place is no worse for wear than my last lodgings. Though I "
"cannot say the same for myself, I fear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = a953da16-ffb9-44e7-b563-cb3961590a57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jaheira_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:a953da16-ffb9-44e7-b563-cb3961590a57
msgctxt "h1d7b214dg22ceg4c94ga3b6gc3d056b6afc1"
msgid "Yes? You have news?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = b0943fff-726b-9c42-04a5-78c509d82b0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_State_Dead = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:b0943fff-726b-9c42-04a5-78c509d82b0e
msgctxt "h39febafdgcc45g47fcg9adegae5693ba72a3"
msgid "Once Ketheric is dealt with... then. Then we shall speak of this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = b13f359c-6095-72bc-c96c-8fbe610528bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:b13f359c-6095-72bc-c96c-8fbe610528bc
msgctxt "h4db1e5f6g3c9eg4080gacb4g027ab438c5bf"
msgid "Nothing to report yet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = b23f549a-6a0d-6818-5dea-ba9ac8f13b13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:b23f549a-6a0d-6818-5dea-ba9ac8f13b13
msgctxt "h92151677gdb3eg47fdgae9egdb8b55b09853"
msgid "Does it matter? It's powerful - it can help us against our enemies."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = b73b64f7-397c-a484-afdf-33aec00d87fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:b73b64f7-397c-a484-afdf-33aec00d87fb
msgctxt "h2e11f609g2297g499aga5bagab0168d2ec05"
msgid "No dream, then. A nightmare."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = ba2edf39-31ba-8026-492e-6db7df71d316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:ba2edf39-31ba-8026-492e-6db7df71d316
msgctxt "h1d3adad1ga6f7g40e0ga844g124b482de006"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = bb41204f-b110-13c8-4326-069f524dace0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:bb41204f-b110-13c8-4326-069f524dace0
msgctxt "h630584b6g89c0g4c77g9f38g86a9052511be"
msgid ""
"You've learned so much? That tadpole in your head already begins to pay "
"dividends."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = bd58110e-2177-e9d0-4d95-95d212b8cc37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#.      - HAV_Jaheira_Knows_ToldKethericImmortalitySource = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:bd58110e-2177-e9d0-4d95-95d212b8cc37
msgctxt "hb0cfcf78g2815g46c6g8344gbe8dfc2ba0ba"
msgid "You know your task. This relic - find it. Strip Ketheric of its power."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = c2e118e3-f0b6-451e-a55e-20ec47717834
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:c2e118e3-f0b6-451e-a55e-20ec47717834
msgctxt "hafe44205g3853g4763g9bebge27b83959f16"
msgid ""
"The battle, the escape after... I might need to lick my wounds a while, "
"before I can be of use to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = c9454237-ee71-73de-4d5b-d155c6432244
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:c9454237-ee71-73de-4d5b-d155c6432244
msgctxt "h2eea5870g1277g4522gaeb5g61592acf24e5"
msgid ""
"Well done. Did you learn how we might untether Ketheric from this Nightsong?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = ca1429cb-1ee4-275c-caee-5304df290857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:ca1429cb-1ee4-275c-caee-5304df290857
msgctxt "h03b757d9g6c88g41f7g8404g0b2acc19c62a"
msgid ""
"What?! So all this time, he has been leeching his life from an immortal? The "
"man is more parasite than anything in his True Souls' heads."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = ce52ef56-cf87-ac40-a948-ddbb94b32808
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_SentNightsongBackToKetheric = True
#.      - MOO_Assault_Event_KethericTeleportedAway = False
#.      - MOO_Audience_State_GrantedPermission = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:ce52ef56-cf87-ac40-a948-ddbb94b32808
msgctxt "hefed5176g774dg4ce1ga918g483e54112196"
msgid ""
"I've earned an audience with the Absolute. Are you well enough to join me?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = cf43ffbc-76dd-e8de-4e59-68114afa3b66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:cf43ffbc-76dd-e8de-4e59-68114afa3b66
msgctxt "h2fc897a6ge8efg4b37g9392geb424ff193de"
msgid "Remove her from her bonds, or kill her, maybe. I haven't done either."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = d073b5c8-d4c0-9798-2377-c5493af33450
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:d073b5c8-d4c0-9798-2377-c5493af33450
msgctxt "hbd46a001g3b1cg4da7gb8f3gca9cfbc3c3fe"
msgid ""
"What?! So all this time, he has been leeching his life from an immortal? The "
"man is more parasite than that thing in your head."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = d5ec560e-8ba3-9d04-f8ec-2ec604dbf0ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Jaheira_AskedAboutLastLight(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Jaheira_AskedAboutLastLight(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:d5ec560e-8ba3-9d04-f8ec-2ec604dbf0ec
msgctxt "h20f1258ag2ef5g4e2eg9de5gb7622f316214"
msgid "Do you want to talk about what happened at Last Light?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = ddb6ba18-bfd7-83fd-6ca3-bdcc939393cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:ddb6ba18-bfd7-83fd-6ca3-bdcc939393cb
msgctxt "hc4e6ca7eg7ec6g427bg8878g874095e26928"
msgid "Where you will face him in the height of his power - <i>alone</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = ddf55c4d-a2ac-50b5-c56c-270b677f6a1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - TG_DarkUrge_SlayerForm(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - TG_DarkUrge_SlayerForm(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:ddf55c4d-a2ac-50b5-c56c-270b677f6a1d
msgctxt "h3ef078cdg34dcg4554g9998ga3bcbe6b18ff"
msgid ""
"That... <i>form</i> you took. That was no common shape-change. Where did you "
"learn to do such a thing?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = ea8754a1-c496-af6b-653c-c510e06c3862
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:ea8754a1-c496-af6b-653c-c510e06c3862
msgctxt "ha402fae2ga7beg42b2g869eg138c3218169b"
msgid ""
"Then by all means, don't let me keep you. We can't end this until Ketheric "
"can bleed. I await your next report."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = eb4afa19-dd77-2b53-2263-c92fb8e881cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:eb4afa19-dd77-2b53-2263-c92fb8e881cf
msgctxt "h878ee2f5g52dbg4943gaeddg811d18c72ffc"
msgid "Once we've reached the city... then. Then we shall speak of this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = ed10ee0d-c9ca-55e7-9c6a-51443978cea8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:ed10ee0d-c9ca-55e7-9c6a-51443978cea8
msgctxt "h91b6c6f8g28ccg413bga7edgab01c88216f2"
msgid ""
"<i>'Sent'? </i>Meaning you had the source of all of Ketheric's power in your "
"grasp, and you gave it <i>back</i> to him?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Player
#. NodeID = eec3544e-b54b-9451-8d66-728ca7df715f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:eec3544e-b54b-9451-8d66-728ca7df715f
msgctxt "hd19410a1g120bg4995ga9b4g78aafbb7fc18"
msgid "I'm still investigating that."
msgstr "아직 알아보는 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = eff85175-0237-9798-4062-8fbb80d7b37d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:eff85175-0237-9798-4062-8fbb80d7b37d
msgctxt "h65841956g8e55g4492gbf02gf11f249d7ffd"
msgid "But first - I owe them justice. Moonrise must fall."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = f2b591e5-5dc5-312e-1f4a-ad344c21c209
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:f2b591e5-5dc5-312e-1f4a-ad344c21c209
msgctxt "heb5f0544ge171g4c50gaa63ga8b5c3f9fe74"
msgid ""
"You know your task. Ketheric Thorm clawed his way free of death. Find out "
"how, so we can send him back."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira
#. Speaker = Jaheira
#. NodeID = f3068279-2793-029d-1147-e62152c44906
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Jaheira:f3068279-2793-029d-1147-e62152c44906
msgctxt "h8ab7bd3bg217eg4427gb00bg83126f748aff"
msgid ""
"It must mean... but no. Not here. Not <i>now.</i> We have more pressing "
"concerns before us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 001e47cb-019f-3ca5-9646-5395b3f1a2b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_SparedIsobelWithKarlach = True
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = True
#.      - ORI_DarkUrge_Event_AskedJergalAboutCompanionResurrection = False
#.      - NIGHT_DarkUrge_SparedIsobel = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:001e47cb-019f-3ca5-9646-5395b3f1a2b5
msgctxt "hb076cd19gda86g4d22gabc7g034f4f607fbe"
msgid "Please bring back Karlach. I can't live with what I did."
msgstr "제발 칼라크를 되살려 주세요. 이렇게는 살 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 004b60cd-701e-3db5-efa2-0e3cc48be277
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:004b60cd-701e-3db5-efa2-0e3cc48be277
msgctxt "h8584b0f3gb362g4ae3gab3dg930051840287"
msgid "I'd prefer if you'd leave."
msgstr "떠나줬으면 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 0334c140-4823-ea8c-2d99-ca3668cf54b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - NIGHT_DarkUrge_MurderOfAlfira = True
#.      - ORI_DarkUrge_Event_AskedJergalAboutMurderOfAlfira = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:0334c140-4823-ea8c-2d99-ca3668cf54b7
msgctxt "hc3b5718dgc123g451cg829agf61ee21b8250"
msgid "I didn't mean to kill Alfira. Please bring her back."
msgstr "알피라를 죽일 생각은 아니였습니다. 제발 그녀를 되살려주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 045a4777-aa67-4e1b-be19-4ba394ee0950
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:045a4777-aa67-4e1b-be19-4ba394ee0950
msgctxt "he065997fg1a02g4ceag9287g268fc6b9a547"
msgid ""
"<i>Recruit a hireling.</i> ([GEN_CheckMagicPocketGold_3_01f129ea-b4dc-"
"44b6-8154-9a948f876a82])"
msgstr ""
"<i>용병을 고용한다.</i> ([GEN_CheckMagicPocketGold_3_01f129ea-b4dc-"
"44b6-8154-9a948f876a82])"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 06249055-db74-a4e7-0e65-4783bf775682
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_Event_ResurrectedSomeoneOnce = True
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - CAMP_Jergal_State_WillResurrect_Hireling1 = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:06249055-db74-a4e7-0e65-4783bf775682
msgctxt "h42e92662g9d3bg4866gb8a8g1cf800b0ef7a"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Narrator
#. NodeID = 076e571f-fa8e-e9cb-d88a-eb383ac0c216
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Jergal_Event_ReligionCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:076e571f-fa8e-e9cb-d88a-eb383ac0c216
msgctxt "h3f5f85cdg2976g499dg8435g01366cde3796"
msgid "*There is great divine energy indeed, but the source is unclear.*"
msgstr "*강대한 신성의 기운은 분명 느껴지지만, 그 신성의 근원은 모호합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 098ef53f-17f3-5919-c91d-ffae8e90fe90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:098ef53f-17f3-5919-c91d-ffae8e90fe90
msgctxt "hbbfcedebg3deag4f3eg8cc3g5032a7b3cb70"
msgid ""
"Most willingly, forsooth. Their passions doth run deep for what hath been "
"wrought upon them."
msgstr "아주 기꺼이 그럴 거다. 자신들이 당한 일로 말미암아, 열의가 아주 깊게 차 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 0b9d421c-48a8-370e-69a2-876c584a6392
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:0b9d421c-48a8-370e-69a2-876c584a6392
msgctxt "h90279ffeg9d9fg48d4g82f7g7832d3fe0a13"
msgid "As thou wishest."
msgstr "그대의 뜻 대로."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 0c7ab42d-4449-6f6b-2ff6-b0917367c1e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:0c7ab42d-4449-6f6b-2ff6-b0917367c1e4
msgctxt "h1e706780g8c0eg41d8ga5a4gbd89ecc8ce00"
msgid "I don't wish to burden another with my madness."
msgstr "제 광기 때문에 다른 사람을 더 묻을 순 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 0ce80d14-6a00-114c-47ca-731be41ab273
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Jergal_AttackedJergal(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:0ce80d14-6a00-114c-47ca-731be41ab273
msgctxt "h4ee20103g9c85g4b71gb519g9d7a7984c1fc"
msgid "Very well. Let us see how long thy understanding takes."
msgstr "좋다. 그대가 언제쯤 상황을 받아들일지 어디 두고 보자꾸나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 0d30b785-9315-a27a-dd44-3d3a12e91b7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
