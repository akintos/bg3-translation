msgctxt "h119dc18bga583g4bb2gab69gfb83bafdf260"
msgid "BORING. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02
#. Speaker = Zae
#. NodeID = b5ff576e-95ad-8848-8fd7-6bc7aeb19a3f
