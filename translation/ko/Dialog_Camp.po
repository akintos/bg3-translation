msgctxt "hefa8e07fgae27g49f0gab77g10896bb91021"
msgid "Hope you're keeping well, friend."
msgstr "잘 지내고 있길 바라, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
