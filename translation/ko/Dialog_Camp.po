msgctxt "hdea54fccge994g4d6dgbf39g1529064bcdbe"
msgid "There's an animal hiding in that shell, I bet."
msgstr "분명 네 그 껍데기 속에 짐승이 감춰져 있을걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = c24e1aa9-61d5-6896-ec98-8ce86d449b70
