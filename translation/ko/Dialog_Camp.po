msgctxt "h8a8eb3c9g870dg496dgbb1bg3c1a91de5cab"
msgid ""
"*There is a beautiful blush on her cheeks that was never there while she was "
"alive.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
