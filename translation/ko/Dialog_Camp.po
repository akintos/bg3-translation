msgctxt "h209df1f1g4119g4b67g8e28gea741d9dfda9"
msgid "All it took was one! I'm jealous."
msgstr "한 잔만에 술빨 돌다니. 부럽다 야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = 91319bc5-bb67-43bf-acbe-2b5e59d91b8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:91319bc5-bb67-43bf-acbe-2b5e59d91b8c
msgctxt "h9b5226b2gf0feg4eebga851g0f49bbd09c01"
msgid "And no, I don't want another."
msgstr "그리고 더 마시고 싶진 않네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
