#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting:17fc043f-3d0a-4bc7-a294-eb75d0d79798
msgctxt "h37f1e230g62cag454dgb7dfg76c5fb0ac0c4"
msgid "I don't recall inviting you over."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
#. Speaker = Shadowheart
#. NodeID = 17fc043f-3d0a-4bc7-a294-eb75d0d79798
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_0_For_Sp2(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting:17fc043f-3d0a-4bc7-a294-eb75d0d79798
msgctxt "h6898a911gf747g4f19gb3d1g921cd170504b"
msgid "There's plenty of space at camp - no need to crowd me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
