msgctxt "h4f29937eg10aag4664g9079g9c949e0ff47c"
msgid "It was worth a shot."
msgstr "시도해볼 만했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyMissionStatement_AvD
#. Speaker = GROUP_Daisy
