msgctxt "h42a5dfcegae39g4413gb51dg9778eab19f6d"
msgid ""
"*All is greater than you could have dreamed. You are a spawn of Bhaal - his "
"heir, his scion.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Narrator
#. NodeID = e96a554b-ebb1-007a-6661-7233c1cf672e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD:e96a554b-ebb1-007a-6661-7233c1cf672e
msgctxt "h7b027bf9gd8f9g40d4gb90fgd44218ea3df1"
msgid ""
"*But be wary of your confessors. Will friend turn to foe, knowing what you "
"are?*"
msgstr "*하지만 누구에게 털어놓을지 조심해야 합니다. 당신의 정체를 안다면, 친구도 적으로 돌아서지 않을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD_Nested_InWorld
#. Speaker = Narrator
#. NodeID = e0b43b5d-2576-4709-81b6-bfb20cec5694
#. HandlePath = TaggedText[0].TagText[0]
