msgid ""
"*Beneath the resilient veneer, a touch of fragility. They need comfort.*"
msgstr "*탄력적인 겉치장 아래로 연약함이 스칩니다. 위로가 필요해 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = d24cf5dd-f8ee-4aec-ae53-f96bffe025d9
