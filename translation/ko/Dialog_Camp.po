#, fuzzy
msgctxt "h552ff852g1e44g49f7ga925gca8f9967615a"
msgid ""
"*Scratch looks at you in confusion. His tail wags enthusiastically, "
"nonetheless.*"
msgstr "*스크래치가 혼란스러워 하며 당신을 쳐다봅니다. 그럼에도 꼬리는 열정적으로 흔들립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Scratch
#. NodeID = 174f60f2-bdbd-e88f-7fb3-787aab53e1af
#. HandlePath = TaggedText[0].TagText[0]
