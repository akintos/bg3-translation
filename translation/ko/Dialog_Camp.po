msgid "Say 'go', and I will go. And I will speak of this no longer."
msgstr "'가라'고 하면, 가겠다. 그리고 이런 이야기는 더 이상 하지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Player
#. NodeID = a5d14a2e-50fe-0560-cd31-f396f3f996da
#. HandlePath = TaggedText[0].TagText[0]
