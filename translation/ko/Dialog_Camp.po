msgctxt "h4df00813ga653g46d7g8417gc73e0201822f"
msgid "It's been too long."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
