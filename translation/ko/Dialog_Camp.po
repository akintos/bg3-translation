msgctxt "hb68bc0a8gb067g491egb879g8b2e7a8ef629"
msgid "COME ON."
msgstr "<b>어서요</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02
#. Speaker = Chell
#. NodeID = e1262b1b-04e3-6dfc-6773-1efa283260c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02:e1262b1b-04e3-6dfc-6773-1efa283260c9
msgctxt "hbc5b6031g22b4g462cg9e8cg26f381ed2007"
msgid "No. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02
#. Speaker = Zae
#. NodeID = e2030b6c-ec8b-5672-b829-d2a74ac306ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a48f6b31-02af-ab98-7c9f-8372db0d3fde_A = False
#.      - a48f6b31-02af-ab98-7c9f-8372db0d3fde_C = False
#.      - a48f6b31-02af-ab98-7c9f-8372db0d3fde_B = False
#. SetFlags:
#.   Local:
#.     - a48f6b31-02af-ab98-7c9f-8372db0d3fde_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02:e2030b6c-ec8b-5672-b829-d2a74ac306ea
msgctxt "h91dfb360geb5eg48f7g8bfbg563bb66601d2"
msgid "Shake those hips! Let's go! "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02
#. Speaker = Zae
#. NodeID = e204a48f-4a4b-ec56-c0a6-10a70cff50fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02:e204a48f-4a4b-ec56-c0a6-10a70cff50fc
msgctxt "hace56279g8955g40b2g92b3g6f4300ae2214"
msgid "Just TRY. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Rhy
#. NodeID = 210d6e0f-a439-4408-c98a-353c0f094f79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:210d6e0f-a439-4408-c98a-353c0f094f79
msgctxt "h2bffd264g54abg4904gb99age2189e88834d"
msgid "More of this!"
msgstr "한잔 더!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Rhy
#. NodeID = 6b4d5c2a-05f6-eac1-cadf-0f0556494282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:6b4d5c2a-05f6-eac1-cadf-0f0556494282
msgctxt "h46ce4871g5c84g4b9fgad29g155d0d39d04f"
msgid "Prefer the city, being honest."
msgstr "솔직히 말하면, 도시가 더 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Kivak
#. NodeID = 796d5182-ee52-b187-b798-fd9b8932d402
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_B = True
#. SetFlags:
#.   Local:
#.     - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_C = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:796d5182-ee52-b187-b798-fd9b8932d402
msgctxt "hf692862cgf730g4cdbgbc48g7b09dd2fd075"
msgid "How much ale you figure we have left?"
msgstr "술이 얼마나 남은 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Rhy
#. NodeID = 7bc59173-b55c-edd7-77bb-42787eb6b945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:7bc59173-b55c-edd7-77bb-42787eb6b945
msgctxt "h56c24a28ga24bg4613gb7aag8b6978cd2159"
msgid "Not enough. Never enough!"
msgstr "충분하지 않아. 절대!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Rhy
#. NodeID = 7e4d0e93-ed6c-7f7e-fab5-3d24f5187fd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:7e4d0e93-ed6c-7f7e-fab5-3d24f5187fd3
msgctxt "h3836a22cgcaa6g4e78g8715g66f7b50815f4"
msgid "Chin up! This is a celebration!"
msgstr "기운 내! 이건 축하연이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Rhy
#. NodeID = 8d524d49-58aa-7bbb-a263-4538c2dc8e55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:8d524d49-58aa-7bbb-a263-4538c2dc8e55
msgctxt "h2e81ea91gac1fg48fbg9b6fg3e0e10492d64"
msgid "To living!"
msgstr "삶을 위해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Kivak
#. NodeID = a0b704ce-e8c2-2bcd-a19a-4f9914d27243
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:a0b704ce-e8c2-2bcd-a19a-4f9914d27243
msgctxt "h31b59525g4d43g44f4g96a4g8556463ff6c0"
msgid "This, though! Night sky, warm fire..."
msgstr "그래도, 이건! 밤하늘, 따뜻한 모닥불..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Rhy
#. NodeID = a10ca575-0653-438a-c33e-28c0e9b40a98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_A = True
#. SetFlags:
#.   Local:
#.     - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:a10ca575-0653-438a-c33e-28c0e9b40a98
msgctxt "ha0c5ba12g0a91g464cg854egc3e09b931d7b"
msgid "Gods, it's good to be out of that damned grove!"
msgstr "신이시여, 그 망할 숲에서 나오니 정말 좋네!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Kivak
#. NodeID = c8537b94-9322-7ec3-56c1-89ae30aa3e1c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:c8537b94-9322-7ec3-56c1-89ae30aa3e1c
msgctxt "hd8e53628g23d3g4f77g83d1g6d1f27fda740"
msgid "What're you going to do in Baldur's Gate when we get there?"
msgstr "우리가 발더스 게이트에 도착하면 뭘 할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Kivak
#. NodeID = f5b226fc-6f79-ab5a-d405-dda86c5f1f2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:f5b226fc-6f79-ab5a-d405-dda86c5f1f2d
msgctxt "hf0f2a5c9gee9fg4baaga079g19de7f90c33f"
msgid "Yeah... yeah. It is!"
msgstr "그래... 그래. 그렇지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06
#. Speaker = Kivak
#. NodeID = f9c87b74-40fa-387e-6b16-2a7ddb685b67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_C = True
#. SetFlags:
#.   Local:
#.     - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_B = False
#.     - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_A = False
#.     - e473e79a-9bd6-ed15-5e2b-eca0d0ab4263_C = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup05_Backup06:f9c87b74-40fa-387e-6b16-2a7ddb685b67
msgctxt "h7f2399f7g68f1g48abgbc73gb24bac8654c6"
msgid "Never thought things would end up this way."
msgstr "일이 이렇게 풀릴 거라곤 상상해 본 적도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Zae
#. NodeID = 09ebbc95-5460-e64f-906e-94beb39c81a6
