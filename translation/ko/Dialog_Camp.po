#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:339b48ec-1f3e-3662-17df-a9088956c3b7
msgctxt "h0ccdc961gf91bg48e9g852cg6f38e72bd27e"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 342bdb84-8a64-5d07-3424-e8bed571b6cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - Hirelings_Event_DismissHireling_1(1) = False
#.     - Hirelings_Event_DismissHireling_3(1) = False
#.     - Hirelings_Event_DismissHireling_2(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:342bdb84-8a64-5d07-3424-e8bed571b6cf
msgctxt "h3c43d025g1a2eg47abg9347g6d7e40b28844"
msgid "It is done."
msgstr "이루어 졌노라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 35145fbb-40ae-4231-995f-a4dcde70be87
