#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:59c6f312-5b26-588b-031c-4de15acdde66
msgctxt "h0326e13bg2851g4e27g8a6ega6d28f7b5fe6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
