msgctxt "hc21abe76gdf99g4456ga550g29d28572ec18"
msgid "Lae'zel, what's going on?"
msgstr "레이젤, 무슨 일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Lae'zel
#. NodeID = 9a93cf03-cdd8-cffd-adb6-670dff6a47ec
#. HandlePath = TaggedText[0].TagText[0]
