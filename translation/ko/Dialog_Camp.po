msgctxt "h300c8ef5ge95ag4a25g93e0gea9683365dde"
msgid "*Hoot! Hoot!*"
msgstr "*훗! 훗!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub
#. Speaker = Owlbear Cub
#. NodeID = a9932b1f-470d-19c5-0a63-39faefce99da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_OwlbearCub_HasMet_GoblinHuntCelebration(1) = False
