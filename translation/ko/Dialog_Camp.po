msgctxt "h5e4cd6c5gd08eg4fe0gbd84gdeed51ed0330"
msgid ""
"*Your parasites resonate. You feel Lae'zel's ecstasy as she moves to kneel "
"before her queen.*"
msgstr "*당신의 기생충이 공명합니다. 여왕 앞에 무릎꿇으려 하는 레이젤의 환희가 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 8979cda5-27b9-dc7c-f2d7-f827bb9ebe8e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_IsOnOrpheusPath = True
#.     - ORI_Laezel_Event_VlaakithToOrpheus = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:8979cda5-27b9-dc7c-f2d7-f827bb9ebe8e
msgctxt "he700a7deg44a7g4816gaa00g03d3a90754cf"
msgid "No. It can't be. I believed you - I believed <i>everything</i>."
msgstr "아니야. 그럴리 없다. 당신을 믿었건만... <i>전부</i> 믿었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 8eb1f60a-dcb3-8525-580a-f1975f4dad20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:8eb1f60a-dcb3-8525-580a-f1975f4dad20
msgctxt "h64bc1ffdg98bfg4912ga052gc5efc43941c1"
msgid "Queen Vlaakith - <i>tsk'va!</i>"
msgstr "여왕 블라키스, <i>츠크바!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 8eefc80b-e12b-674b-46f6-7aaa01ffcc0d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:8eefc80b-e12b-674b-46f6-7aaa01ffcc0d
msgctxt "hfb36b9aega8bag41a4gb51cg58d8df4d0cb7"
msgid ""
"<i>Connect with Lae'zel's parasite. 'Commander of Dragons. This is your "
"destiny.'</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 911cae3f-1bfc-e2a3-a11c-3acec65a4849
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:911cae3f-1bfc-e2a3-a11c-3acec65a4849
msgctxt "h73f4da82gb089g4f9bg9874g869ccd347ff8"
msgid ""
"I've seen the captive Orpheus with my own eyes, spoken to <i>Jhe'stil "
"Kith'rak </i>Voss. You lied to us, <i>enslaved</i> us."
msgstr ""
"사로잡혀 있는 오르페우스를 내 눈으로 봤다, <i>제스틸 키스락</i> 보스가 그랬지. 네가 우리에게 거짓말을 하고 있다고, 우리를 "
"<i>노예로</i> 삼았다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 942f0522-a35c-556a-f7cc-36d815314965
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:942f0522-a35c-556a-f7cc-36d815314965
msgctxt "ha3ca3f1dg07d2g4045g9722gcba6af60bf49"
msgid "<i>Your word is nothing. You are nothing.</i>"
msgstr "<i>네 말은 의미없다. 넌 아무것도 아니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 94b8f392-910d-c44f-18ac-eda0c370d5e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:94b8f392-910d-c44f-18ac-eda0c370d5e2
msgctxt "h4e3d0572g2594g47f4gb142g1d649d85d55c"
msgid "<i>Keep silent.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 97086675-9a4f-0af1-29be-f7308ce9489f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:97086675-9a4f-0af1-29be-f7308ce9489f
msgctxt "h45532167g2301g40e7g9f15g685bc447f87d"
msgid "Return to the Astral Prism. Slay Orpheus the pretender."
msgstr "아스트랄 프리즘으로 돌아가라. 참칭자 오르페우스를 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 97cafd77-7208-56a6-87d1-f3be479c2905
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:97cafd77-7208-56a6-87d1-f3be479c2905
msgctxt "hdb09dc8ag99d4g4f39ga066g8bf7a557995f"
msgid ""
"So the worm bows to the wyvern. Have some dignity, stand up to Vlaakith!"
msgstr "벌레가 와이번 앞에 머리를 조아리는 꼴이군. 위엄을 갖추고, 블라키스에 맞서라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 984cc6ac-6f47-478a-44c1-0ba67bad9eb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:984cc6ac-6f47-478a-44c1-0ba67bad9eb8
msgctxt "h1a546d4agad54g4d8fgb45egaa92b827c335"
msgid "You are <i>Hshar'lak</i>. And still you speak my name."
msgstr "너 <i>흐샬락</i>. 아직도 내 이름을 입에 담는가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 9b8d5f62-5d51-f7a4-ac8c-2859b34ed204
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:9b8d5f62-5d51-f7a4-ac8c-2859b34ed204
msgctxt "h199759cag1eaeg4f28gb5ffg306f557c7e32"
msgid "Out of my head!"
msgstr "내 머릿속에서 나가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 9bbd88ef-ef80-ea06-7391-136b46b4c266
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:9bbd88ef-ef80-ea06-7391-136b46b4c266
msgctxt "h256f8c5bg911eg4a17g9adbgf6c00eaab3a6"
msgid "I named you <i>Hshar'lak</i>. Yet you still call me Queen."
msgstr "내가 널 <i>흐샬락</i>으로 지정했건만. 날 아직 여왕이라 부르는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 9e118e64-3f56-2248-6bbe-c18eefeb5945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:9e118e64-3f56-2248-6bbe-c18eefeb5945
msgctxt "h4793b62dg1e15g4025ga52cgfa009cf26a1a"
msgid "Hear my words, <i>vin'iisk</i>."
msgstr "듣거라, <i>비니스크</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = a0f2c3eb-7745-5527-8f5b-af22831ef2b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:a0f2c3eb-7745-5527-8f5b-af22831ef2b0
msgctxt "hf49b6823g4fffg4aecg8b08g1ff034974d33"
msgid ""
"And you - you are abominations twice over. You carry <i>ghaik</i> parasites. "
"And you harbour the Heretic Prince Orpheus."
msgstr ""
"그리고 너, 가증스러움을 한 번도 아니고 두 번이나 드러내는 구나. <i>게이크</i> 기생충을 품고 있고. 이단자들의 왕자 오르페우스를 "
"숨겨주고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = a1e843f5-2955-03a0-f606-8ae56b990123
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:a1e843f5-2955-03a0-f606-8ae56b990123
msgctxt "h1e438ea2g33d8g4097g994fgf2385f2ce243"
msgid "I have my dignity. What I do not have is patience for your disloyalty."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = a4c5019a-d6bd-250c-9a55-1534fd07bb42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:a4c5019a-d6bd-250c-9a55-1534fd07bb42
msgctxt "ha8235a9agd7ccg4100g9ecagfb555f2886ae"
msgid "I will not entertain madness. Only in Vlaakith's might am I free!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = a6060dfa-4d89-7d8b-0cd0-5bb093f3758b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:a6060dfa-4d89-7d8b-0cd0-5bb093f3758b
msgctxt "h5b29b7adg912eg4054g94a3g663320c2a75b"
msgid "Go on, Lae'zel. Kneel before our queen."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = a6060dfa-4d89-7d8b-0cd0-5bb093f3758b
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:a6060dfa-4d89-7d8b-0cd0-5bb093f3758b
msgctxt "h8a758873gc5e8g45cbg83degf5653bbdd1b1"
msgid "Go on, Lae'zel. Kneel before your god-queen."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = a6a8b138-6d5f-2032-3edc-9140af470f3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:a6a8b138-6d5f-2032-3edc-9140af470f3f
msgctxt "h152fc807ga9a6g4971g82f2gf7c5731cedac"
msgid ""
"*Can this be true? Is the githyanki prince really a threat to his own people "
"or simply a challenge to Vlaakith's rule?*"
msgstr "*이게 사실일까요? 기스양키 왕자가 정말 동족들에게 위협이 되는 걸까요, 아니면 단순히 블라키스의 지배에 도전하는 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = b24ba04d-0b65-7fdf-ec46-05c4669060f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:b24ba04d-0b65-7fdf-ec46-05c4669060f3
msgctxt "haad4d509g546eg4a89g85eaga1f059b85183"
msgid "My forgiveness. Yes, I know - and I might yet grant it."
msgstr "용서를 구하는구나. 좋다, 내가 용서해줄 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = b3b8cce7-3b1a-d9c7-6b5a-b09caa41801f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:b3b8cce7-3b1a-d9c7-6b5a-b09caa41801f
msgctxt "h005d201fgc633g4f7cga478ge354aee979fb"
msgid ""
"We are githyanki. We move mountains, we snuff out stars, <i>we shake the "
"planes</i>."
msgstr "우리는 기스양키다. 산을 옮기고, 별을 소멸시키며, <i>차원을 뒤흔드는 존재다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = b58e2403-8683-3e59-ec6a-74cfb9b39bbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:b58e2403-8683-3e59-ec6a-74cfb9b39bbe
msgctxt "hea2cc098gcd3bg4db9g8705gc4cdc85be9c3"
msgid "A final chance. Kneel before me. Make your promise."
msgstr "마지막 기회를 주노라. 내 앞에 무릎꿇고. 맹세하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = bb4c570c-5978-851c-3c80-7123cd25a911
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:bb4c570c-5978-851c-3c80-7123cd25a911
msgctxt "hadf2bcabg9d09g4a31ga88bg44bc72c076b1"
msgid "Stand your ground. Don't fall for Vlaakith's lies."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = bbd450db-1296-66f8-e6c6-a481e67b643b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:bbd450db-1296-66f8-e6c6-a481e67b643b
msgctxt "h9a67d89cg9ad0g4bb8gb8c2gd062649147a7"
msgid "Return to the Astral Prism. Slay Orpheus the pretender."
msgstr "아스트랄 프리즘으로 돌아가라. 참칭자 오르페우스를 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = be45bc99-95fd-79b0-22be-46ea757efd13
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_AcceptedVlaakithsFinalMission = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:be45bc99-95fd-79b0-22be-46ea757efd13
msgctxt "he44ebce2g0ccbg4875g80dfg55d9ff42e196"
msgid ""
"<i>Ch'mar, zal'a Vlaakith.</i> Your grace is my honour. Orpheus will die by "
"my hand - and I will take my rightful place at your side."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = be9da37e-fe08-fc40-704d-81aee9a23cdd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Event_OrpheusToVlaakithSwitch = True
#.     - ORI_Laezel_State_IsOnOrpheusPath = False
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:be9da37e-fe08-fc40-704d-81aee9a23cdd
msgctxt "h84f93633gd719g40acgb972g327fd07a8098"
msgid ""
"<i>Baht t'Vlaakith.</i> No githyanki's held the honour. My faith, almost "
"lost to the dark winds -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = c000fb0d-4b43-f9c4-56c8-2ef20c12485c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:c000fb0d-4b43-f9c4-56c8-2ef20c12485c
msgctxt "h6051f9a4g62bag4d54gb0a4g522f013b3ab3"
msgid ""
"The <i>kith'raki</i> will bring you. I will tear your flesh from your bones "
"and devour your skull's marrow while you beg for death."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = c47dae36-99f9-3916-35be-7078e1ce2ddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:c47dae36-99f9-3916-35be-7078e1ce2ddc
msgctxt "hcb92a7d1gf11ag466fg9598g94b6eab49d2b"
msgid "Damned fool. The wretched cannot sway the divine!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = c4b3740d-aade-41cc-1fe2-0ee90426c526
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:c4b3740d-aade-41cc-1fe2-0ee90426c526
msgctxt "h7f4bf94cg57fag43a0ga55eg101ada9636a5"
msgid "The Mistress of Castle Susurrus does not require <i>invitation</i>."
msgstr "속삭임의 요새의 여주인은 <i>초대</i>따위 필요하지 않다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = c669ab3b-8d40-7884-8244-5af277384504
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:c669ab3b-8d40-7884-8244-5af277384504
msgctxt "h65da4874g50b3g490fgb16egffa8cf19a822"
msgid "No. I have not cast off my chains only to be rebound."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = c794540e-65e0-c3b9-714f-688633e93880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:c794540e-65e0-c3b9-714f-688633e93880
msgctxt "h94c681ecgea7bg46cagabc9g6264d1a577dc"
msgid ""
"You carry a <i>ghaik</i> parasite. You harbour the Heretic Prince. Yet so "
"blind is your faith that you still call me Queen."
msgstr ""
"<i>게이크</i> 기생충을 품고 있고. 이단자들의 왕자 오르페우스를 숨겨주고 있으면서. 그럼에도 맹목적인 믿음으로 날 여왕이라 "
"부르는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = cb4d99ee-a857-99db-afb2-47e2104d7c09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:cb4d99ee-a857-99db-afb2-47e2104d7c09
msgctxt "hdafca6afg9cf5g4034gbcd8g64879453677b"
msgid ""
"Serve me and I will ascend you. You will be no mere warrior, nor "
"<i>kith'rak</i>. You will be <i>Baht t'Vlaakith</i>."
msgstr "나를 섬겨라, 그러면 널 승천시켜 주겠다. 단순한 전사도, <i>키스락</i>도 아닌. <i>바트블라키스</i>가 될 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = cf20b682-3130-1e7f-bbff-e78b95bae164
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:cf20b682-3130-1e7f-bbff-e78b95bae164
msgctxt "h4e014eadg77e5g4ecdg8521g0ef279e0a099"
msgid "<i>Look upon the figure with reverence.</i>"
msgstr "<i>경외심을 담고 형상을 올려다 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = d5ce5050-b2ce-bddd-e16e-396d1ac9f95e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:d5ce5050-b2ce-bddd-e16e-396d1ac9f95e
msgctxt "h5c5ddebcg1fa5g4767gb8a7gefa74b6a6cb0"
msgid "How incredible, for them to carry it back."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = d66e0a38-1a9b-b7dd-a608-62e1722f3de6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:d66e0a38-1a9b-b7dd-a608-62e1722f3de6
msgctxt "h563d7e22gbc04g4a72g8e9agdd294bec4896"
msgid "There's little time. I will speak, and you will listen."
msgstr "시간이 별로 없다. 내가 말하노니, 들을지어다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = d6b349c3-ea15-6fa7-c26b-a77fa349d33f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:d6b349c3-ea15-6fa7-c26b-a77fa349d33f
msgctxt "h4167b9e6gc1a3g4e3dg8b94gb8f7c7601183"
msgid "Kneel before me. Make your promise."
msgstr "무릎 꿇어라. 맹세하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = df33888b-428d-3c6c-98d2-c261fb664e26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_IsOnOrpheusPath = True
#.     - ORI_Laezel_Event_VlaakithToOrpheus = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:df33888b-428d-3c6c-98d2-c261fb664e26
msgctxt "hfba46af0gcc1bg4513ga048g045164d20789"
msgid ""
"*Lae'zel's mind reels with images of Vlaakith, the Prism, and the githyanki "
"prince inside it.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = e02cb254-30f3-1c56-9f21-28030cabe5cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:e02cb254-30f3-1c56-9f21-28030cabe5cd
msgctxt "hd15a29d3g8704g49e6gb552g8a15adea3287"
msgid "I have only a moment. And you, <i>Hshar'lak</i>, will listen."
msgstr "시간이 얼마 없다. 그리고 너, <i>흐샬락</i>, 들을지어다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = e0328928-6cb8-2b0b-0896-4c35fb30b1b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:e0328928-6cb8-2b0b-0896-4c35fb30b1b0
msgctxt "h53e39cffgd6e0g40bag8f63g76ee73fed6e0"
msgid "The Undying Queen. Honour be!"
msgstr "불멸의 여왕이시여. 영광스럽습니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = e2861d4c-f804-bde2-e6d9-73e6395c44fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:e2861d4c-f804-bde2-e6d9-73e6395c44fc
msgctxt "h49b76884gc08eg4576g94a9g317c81fe8589"
msgid ""
"*Water and blood. They envelop you, they drag you downward. You are "
"submerged in past, present, and future.*"
msgstr "*물과 피가 당신을 감싸고, 아래로 끌어내립니다. 당신은 과거, 현재, 미래에 잠기게 됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = f50de820-5817-143d-336f-59433f04499a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:f50de820-5817-143d-336f-59433f04499a
msgctxt "hfdfbb771gb4f1g41f3g8199g4c5aab7f7301"
msgid "<i>Keep silent.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = f5d2ce77-90bc-e71b-877b-6ca937f3c22d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:f5d2ce77-90bc-e71b-877b-6ca937f3c22d
msgctxt "h7bba0586g678ag44e7g9514g9595cc151605"
msgid ""
"I gave you my faith, and you called me traitor. I gave you my life, and you "
"ordered your knights to hunt me."
msgstr "난 믿음을 줬지만, 당신은 날 반역자라 하고. 내 삶을 바쳤지만, 당신은 기사를 보내 날 사냥하게 했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = f62c40c4-15e4-1efb-83fe-e5534ad29ede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:f62c40c4-15e4-1efb-83fe-e5534ad29ede
msgctxt "hb0f07ed9g3276g4e0cg9d1ag75279fe31e5a"
msgid "<i>Vin'iisk. </i>I am your Queen! Would you not bend in my honour?"
msgstr "<i>비니스크.</i>내가 너의 여왕이거늘! 어찌 내 위광앞에 무릎꿇지 않는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = f796f0b1-61fa-cb69-6816-e43c7049e57b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:f796f0b1-61fa-cb69-6816-e43c7049e57b
msgctxt "h8bc1e3d4g98d2g4829gaaf3ge9e1838ffab0"
msgid ""
"*Lae'zel's thoughts become yours. The sight of Orpheus looms over her mind; "
"Voss' words echo within it. She means to forever turn her back on Vlaakith.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = fb00f5ce-8655-f8dc-5633-ebf233e840d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:fb00f5ce-8655-f8dc-5633-ebf233e840d8
msgctxt "h3f49fd99g4a66g4df6g98c3gd598ddc14625"
msgid "Commander of Dragons. <i>My only, my Chosen.</i>"
msgstr "드래곤들의 지휘관. <i>나의 유일한, 선택받은 자</i>가 될 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = fcf6466b-160f-08b7-6799-b29064f1dc0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:fcf6466b-160f-08b7-6799-b29064f1dc0f
msgctxt "h5a9faeacg6abfg46d8g934cgddcc9c2f663d"
msgid ""
"She - she has good reason, surely. Vlaakith is my faith, my - my very "
"purpose."
msgstr "그... 그분께선 분명 그러실 만한 이유가 있으셨을 거다. 블라키스 님은 나의 믿음, 나의...나의 참다운 목적이시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 0be2a864-fd13-d0a6-21a1-4b97d87ecca3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:0be2a864-fd13-d0a6-21a1-4b97d87ecca3
msgctxt "h3b4ef395g3ecbg420egbef4g55ee3c843bf3"
msgid ""
"<i>Ska'kek kir Gith shabell'eth. </i>My blade rests. Mother Gith compels you "
"to listen."
msgstr "<i>스카케크 키르 기스 샤벨레쓰.</i> 내 검을 내려놓으마. 어머니 기스께서 네게 경청을 종용하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 1033b8cb-7f4b-4b36-2cff-d69384ac8de8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:1033b8cb-7f4b-4b36-2cff-d69384ac8de8
msgctxt "h6529994dgc3c3g4278g852eg268be1a96369"
msgid "You make a dangerous accusation. Vlaakith would call your words heresy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 114740bd-ed00-ceb5-d149-b08fca6ec79e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 79dc4456-27f6-faf2-a47e-f2da8c320eb9_Prisoner = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:114740bd-ed00-ceb5-d149-b08fca6ec79e
msgctxt "hdb4dcf93g31f5g461cgb7a9g8ebba5b49ec7"
msgid "Who is this 'seed of Vlaakith's demise'?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 14b9e6da-c47b-b893-5f39-65ff047826d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:14b9e6da-c47b-b893-5f39-65ff047826d1
msgctxt "h2187348cg62b2g44f8ga427g9bb8f76827c2"
msgid "I've not come to kill you, child. I've come to aid you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 15863435-0d76-664c-e8ed-1f6b4f5ed9de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:15863435-0d76-664c-e8ed-1f6b4f5ed9de
msgctxt "h9b948d60g0d22g4848g9307g9cdd9d761af9"
msgid "For now, that will do."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 1593fcf7-8757-9207-a41b-9bb87c46cee1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:1593fcf7-8757-9207-a41b-9bb87c46cee1
msgctxt "he41603e4g359dg4a89g8ea6g0631e9cd4750"
msgid ""
"I am neither. 'Clear of heart, clear of mind, and bound by no master.' Now - "
"you must listen."
msgstr "난 어느 쪽도 아니다. '마음을 비우고, 정신을 비우고, 어느 주인에게도 얽매이지 않았으니.' 이제, 내 말을 들어야만 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 15c6e838-37cc-8cc9-0121-9aa2f3dec172
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:15c6e838-37cc-8cc9-0121-9aa2f3dec172
msgctxt "h45df7064gf0fcg42bdgaa91gd5ac3d47f090"
msgid ""
"I've heard word from Crèche Y'llek. You are infected - yet the one in the "
"Prism has chosen you, protects you with their power."
msgstr "일레크 양성소에서 전언을 들었다. 네가 감염되었다더군. 그러나 프리즘 내부의 존재가 너를 택했고, 보호하고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 18992b3b-131a-33e7-309e-c78d43b80ec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:18992b3b-131a-33e7-309e-c78d43b80ec4
msgctxt "hf16864cfgc71cg45c4gbf16g0b66db5d9691"
msgid ""
"The queen's warriors hunt you. The <i>qua'nith</i> will sound out when you "
"come near their portals. Hear its cry, and prepare for battle - or slip away."
msgstr ""
"여왕의 전사들이 너희를 뒤쫓을 것이다. 그들의 차원문 가까이 다가가면 <i>콰니스</i>가 소리를 낼 것이다. 울음소리가 들리면, 전투를 "
"준비하거나 몰래 빠져나가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 1bf52bbe-e9ed-314a-15c6-639ef9758fbe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVossInAct2 = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:1bf52bbe-e9ed-314a-15c6-639ef9758fbe
msgctxt "h50023a94g5663g4ec0ga73eg4f762ed58a11"
msgid "I will not abandon my queen. Die, <i>kith'rak</i>!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 2575daf3-84c6-97c3-bbe7-2e60688a4988
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = False
#.      - CRE_ChainOfCommand_State_SpokeToVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:2575daf3-84c6-97c3-bbe7-2e60688a4988
msgctxt "h00760d54gf0e5g425eg9237g662ee6c962c7"
msgid "My own queen hunts me. Why in the hells should I listen to you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 28da7832-f1fa-fc17-4633-02895155abf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:28da7832-f1fa-fc17-4633-02895155abf9
msgctxt "h1646d397gb238g4ffegac9cg7ffa5e235ce4"
msgid ""
"Because her throne rests on lies, more than a hundred gish scholars could "
"count in a lifetime. I will share but two."
msgstr "여왕의 왕좌는 기스 현자 백 명이 평생 세어도 모자랄 거짓말 위에 세워졌기 때문이다. 이 중 두 가지만 나누겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 399da6ac-93b0-0cc1-1a48-6770deaf998a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:399da6ac-93b0-0cc1-1a48-6770deaf998a
msgctxt "hec64414dgfb60g4600gaf69gcb13b796b06e"
msgid ""
"I've sought their freedom for aeons. When the Prism went missing, I feared "
"the worst."
msgstr "나는 영겁의 세월 동안 그들을 해방시킬 방법을 찾아 헤맸다. 프리즘이 사라졌을 때는, 최악의 상황까지 우려했었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 3c168415-dc4d-e6ff-0f27-b0c1440685ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:3c168415-dc4d-e6ff-0f27-b0c1440685ad
msgctxt "h51abf30age780g4e92gbd23ga61ef8921d63"
msgid "But I know the truth."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 467b504b-4766-a80f-87f7-a20994ae92ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:467b504b-4766-a80f-87f7-a20994ae92ee
msgctxt "hf620e82bgea08g4fcbg90d4gf4456c3ce2bc"
msgid "I'm not giving you the Astral Prism, if that's what you're wanting."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 47181dff-b4a0-57f3-46d6-f4ef9a7634f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:47181dff-b4a0-57f3-46d6-f4ef9a7634f2
msgctxt "h9e8eb8f2g7abag47b3g8aa4g75469258fb43"
msgid ""
"All that remains is the key that unchains them - and I've found someone who "
"I believe can provide it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 473ce3a8-6931-4dcf-6b55-f189e178b525
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 79dc4456-27f6-faf2-a47e-f2da8c320eb9_PrismAvatar = False
#. SetFlags:
#.   Local:
#.     - 79dc4456-27f6-faf2-a47e-f2da8c320eb9_PrismAvatar = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:473ce3a8-6931-4dcf-6b55-f189e178b525
msgctxt "h74457a66g3053g453ega09cgb05652734c61"
msgid "Vlaakith's demise? I should run you through for suggesting it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 4b6f72cc-bcdb-2778-3d82-215638189ee3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:4b6f72cc-bcdb-2778-3d82-215638189ee3
msgctxt "h8855fbb7g5d09g4a6egbffbg635d74829a0e"
msgid ""
"I am not <i>Hshar'lak</i>. You must hear me - Vlaakith has abandoned us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 54d8f3a5-8f1a-b072-39bd-a9cba66dc848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:54d8f3a5-8f1a-b072-39bd-a9cba66dc848
msgctxt "h8516235fg6bbag4e44g9aefgee8b0ff5b78f"
msgid ""
"But the one inside's chosen you as an ally, protects you with their power."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 57d51179-e467-84cd-38e4-76a927b143af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:57d51179-e467-84cd-38e4-76a927b143af
msgctxt "h79393055g2ea4g423cga120g6186a0b6a150"
msgid "I come to aid you."
msgstr ""

