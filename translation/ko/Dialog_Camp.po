msgctxt "hc90a7024g0301g4610g82acg08b39c919c64"
msgid "Good? Strong!"
msgstr "좋아? 강해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Owlbear Cub
#. NodeID = c2550227-f5f0-d869-495b-f97c64cc472a
#. HandlePath = TaggedText[0].TagText[0]
