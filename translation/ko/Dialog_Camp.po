msgctxt "h8a823a11gb5f9g4e6fg82b4gad4ec7a48d0a"
msgid "I don't want to go back. Not just yet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 8d6eb833-e4e2-6980-4ff3-5d95454d9ffc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:8d6eb833-e4e2-6980-4ff3-5d95454d9ffc
msgctxt "hb6735472g4ab7g4ea6ga96cge25d5eb6b230"
msgid "<i>Shrug and run in ahead of her</i>."
msgstr "<i>으쓱하고선 앞서 물속으로 뛰어 들어간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 8d8b464a-9584-8e21-c1cc-1f72bb7529b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:8d8b464a-9584-8e21-c1cc-1f72bb7529b1
msgctxt "h4a4172e5g650fg4933g86f5g8eb36c571df7"
msgid "I don't doubt you in the slightest."
msgstr "물론 그렇겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 8fa6aad7-bc55-d516-f0ab-c081bfef1fe8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:8fa6aad7-bc55-d516-f0ab-c081bfef1fe8
msgctxt "h3a117373g660cg4d95ga4a8g4b7ee718ae61"
msgid "Come on then. We've already come this far."
msgstr "어서 벗어. 우리 이미 이만큼이나 왔잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 91b0c48d-b252-d4b9-9b87-df17ab55a460
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:91b0c48d-b252-d4b9-9b87-df17ab55a460
msgctxt "hbdbced74gf05eg44fagbe20g57eea51704d6"
msgid ""
"More the drowning, and the things that could be hiding underwater, and the "
"drowning, and the cold. Did I mention the drowning?"
msgstr ""
"물에 빠져 죽는 거랑 물속에 숨어있을지도 모르는 것들, 그리고 익사하는 거랑 추위가 무서운 거야. 내가 <i>익사</i>를 빼먹었던가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 955c8afa-d714-09e6-2541-a409d7919304
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:955c8afa-d714-09e6-2541-a409d7919304
msgctxt "h5be5476ag1461g4bbdgac3cgfb31deb7f814"
msgid "I didn't bring anything to swim in."
msgstr "수영할 때 입을 옷은 가져오지 않았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = 958c12a3-f689-a840-d195-8b934658d64b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:958c12a3-f689-a840-d195-8b934658d64b
msgctxt "hcdce0f75g7bfag4794gaeeegf05acfe90520"
msgid "We don't have to do this if you're not ready."
msgstr "네가 준비가 되지 않았다면 이러지 않아도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 97859427-f401-6a21-bd0c-e855f36c7d1d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_AbortedSkinnydipping = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:97859427-f401-6a21-bd0c-e855f36c7d1d
msgctxt "h3355e2c8gd452g47c3gaf5fg342c50f18aee"
msgid "Oh. If you insist..."
msgstr "오. 정 그렇다면야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = 9a749a44-333a-73b0-c79d-6ae839b73fee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:9a749a44-333a-73b0-c79d-6ae839b73fee
msgctxt "h78c348deg47b5g40d1g88dage5ccb628dc7b"
msgid ""
"More the drowning, and the things that could be hiding underwater, and the "
"drowning, and the cold. Did I mention the drowning?"
msgstr ""
"물에 빠져 죽는 거랑 물속에 숨어있을지도 모르는 것들, 그리고 익사하는 거랑 추위가 무서운 거야. 내가 <i>익사</i>를 빼먹었던가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = a00730b5-70c7-13ab-9263-239d28168c29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:a00730b5-70c7-13ab-9263-239d28168c29
msgctxt "hc16f19ddg4c0dg4141ga446g456a58c47a09"
msgid "I never said I was coming in with you."
msgstr "너와 함께 물에 들어가겠다고 하진 않았는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = a22f7db1-0245-1230-adc6-611be3b4fcd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:a22f7db1-0245-1230-adc6-611be3b4fcd0
msgctxt "hc8c8c809gbcd5g4b50ga6e4g724635970a73"
msgid ""
"Thank you. I needed that. I needed to know I can face things without Shar."
msgstr "고마워. 이게 필요했어. 샤 없이 혼자서도 해낼 수 있는지 알아야 했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = a36d3365-38ba-8a0a-e249-8491cf394f2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:a36d3365-38ba-8a0a-e249-8491cf394f2c
msgctxt "h5b438eb7g1a7dg4cc9g867ag5a25d3240f04"
msgid "What?"
msgstr "뭐라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = b0ecb96d-ddc6-5048-4e14-ef77afec79e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:b0ecb96d-ddc6-5048-4e14-ef77afec79e4
msgctxt "h061cb71bge87ag43b9g88f6gbb67fe407a76"
msgid ""
"Wait - just give me a moment. I can manage. As long as you stay with me."
msgstr "잠깐, 잠시만 기다려줘. 난 해낼 수 있어. 네가 곁에 있어만 준다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = b4876e96-3d9f-97b0-82e3-dddf7f5b169a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:b4876e96-3d9f-97b0-82e3-dddf7f5b169a
msgctxt "h521aee48gc3bcg4ba4ga3ebgd183d02f87b6"
msgid "What's the matter?"
msgstr "왜 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = b86c5fef-1138-b6ec-1137-811c5c332d1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:b86c5fef-1138-b6ec-1137-811c5c332d1f
msgctxt "h5dee6a10g3e10g4bc1ga5bag90a5f466c7a9"
msgid "All the things we've faced, and you're afraid of getting a little wet?"
msgstr "지금까지 겪어온 게 있는데 조금 젖는 걸 무서워하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = baf8b4c4-f9af-c5a2-0d80-d17160a90953
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:baf8b4c4-f9af-c5a2-0d80-d17160a90953
msgctxt "h25a8e7a6g19f4g4b18gaaffgb99eb7f2da8d"
msgid ""
"How about a night on the beach, under the stars? Together. Just near enough."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = bbd5a13c-fa69-58c4-e0d8-1b65c3dc908d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:bbd5a13c-fa69-58c4-e0d8-1b65c3dc908d
msgctxt "h3e1dc3eeg8553g4d86ga14cg4da389a5a5e1"
msgid "There's easier ways to get me naked, you know."
msgstr "저기, 내 옷을 더 쉽게 벗기는 방법이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = bcaa7f07-6298-6180-4789-61f675990a73
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_Act3RomanceEnded = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:bcaa7f07-6298-6180-4789-61f675990a73
msgctxt "hd2655d8egb16fg4a32g8b67g0c210a4f9f2c"
msgid "<i>Do as she says</i>."
msgstr "<i>그녀의 말에 따른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = c0230403-b3a9-2203-baff-7102710154c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:c0230403-b3a9-2203-baff-7102710154c7
msgctxt "h9006f3d1gae61g4e20g8805g3d8ade9a44bf"
msgid "Actually, I've changed my mind. I'm heading back to camp."
msgstr "실은 마음이 바뀌었어. 야영지로 돌아갈래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = c0aedfce-deda-2cf9-0f80-8bb62e0bb7ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:c0aedfce-deda-2cf9-0f80-8bb62e0bb7ad
msgctxt "hd6cb062cgf0b4g4273gb73bg3268974103ab"
msgid "<i>Disrobe</i>."
msgstr "<i>벗는다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = c42aacc3-5eb9-baeb-8ae4-c911991ce8a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRAGONBORN(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:c42aacc3-5eb9-baeb-8ae4-c911991ce8a7
msgctxt "hc18d69c2g5fe9g43cbgb429g9b9e603f3d94"
msgid "Just a pebble."
msgstr "그냥 조약돌이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = c70dbc9c-5afe-909b-7514-6480a9c2c79c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:c70dbc9c-5afe-909b-7514-6480a9c2c79c
msgctxt "hfa66cb7egbbd6g4b14g8673g294eb44f2426"
msgid "What?"
msgstr "뭐라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = c7bba6a2-780f-4fb8-4e08-85ad1880a63c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:c7bba6a2-780f-4fb8-4e08-85ad1880a63c
msgctxt "h535eff99g0ce1g488ag992bg3a8f2aa39e6c"
msgid "Yes you can. Just walk forward until you feel the weight lift."
msgstr "물론 넌 할 수 있어. 몸이 가벼워질 때까지 앞으로 걸어가기만 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = c890d041-95ce-d80b-6eb7-70bc476e4a5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:c890d041-95ce-d80b-6eb7-70bc476e4a5b
msgctxt "hf6b1f54fg8823g4a5cga784g899bfd8015cb"
msgid "Come here..."
msgstr "이리 와..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = cac2311e-00fd-4dab-e180-fcb2ea0d20bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:cac2311e-00fd-4dab-e180-fcb2ea0d20bf
msgctxt "h33829f87g7080g478ag8040gb7c357d50b63"
msgid ""
"You don't want to get them wet, do you? Or worse, weigh you down. Go on; "
"don't turn shy on me now."
msgstr "옷이 젖는 건 싫잖아, 그렇지? 그러면 수영하기 힘들어져. 어서, 이제와서 부끄러워하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = cd07e5eb-beca-52aa-d6f7-5369e29ee72a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:cd07e5eb-beca-52aa-d6f7-5369e29ee72a
msgctxt "hc5469384gcf5bg4680g84ffg3e9de10717b5"
msgid ""
"Wait - just give me a moment. I can manage. As long as you stay with me."
msgstr "잠깐, 잠시만 기다려줘. 난 해낼 수 있어. 네가 곁에 있는 한."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = d00dc4c9-b67c-1002-e6fa-135a8f4f556c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:d00dc4c9-b67c-1002-e6fa-135a8f4f556c
msgctxt "h624e02f8g3c50g4508g980ege748f3ba8104"
msgid "What can I say? I'm respectful."
msgstr "어쩌겠어? 내가 매너가 좋은걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = d045a7f6-26b3-1f89-a790-05495f960ed1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:d045a7f6-26b3-1f89-a790-05495f960ed1
msgctxt "h94056cf2gf317g4ca2g91ecg4ebd0b1f9cf6"
msgid "<i>Sneak a glance</i>."
msgstr "<i>살짝 훔쳐본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = d1d208f3-099a-a89e-1470-2f7fb8dd614b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:d1d208f3-099a-a89e-1470-2f7fb8dd614b
msgctxt "h57b30a46g323fg41dcga8c6g5b6c93b0d27c"
msgid "Oh Hells that's cold."
msgstr "오 세상에 정말 차갑다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = d1d4d074-af1e-67a1-921c-db9909bf5c34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:d1d4d074-af1e-67a1-921c-db9909bf5c34
msgctxt "h58a11a6dge517g413dgaa66g10f6ece505c0"
msgid "All right. Turn around."
msgstr "알았어. 돌아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = d2205284-8cbe-0cba-be5a-6693eb699a5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:d2205284-8cbe-0cba-be5a-6693eb699a5a
msgctxt "hd88f8542g5d8dg45fagb91dgfbf0b04dd510"
msgid "Forget it. Let's head back."
msgstr "됐어. 그만 돌아가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = d4ec474e-c2c1-c9cf-ac68-df0722202e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:d4ec474e-c2c1-c9cf-ac68-df0722202e70
msgctxt "hb3cef858g5973g4601gb5a3gfb6772f115ec"
msgid "I know. But it's nice to hear you say it."
msgstr "나도 알아. 그래도 네가 그렇게 말해주니 좋네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = d53947d8-21fc-df12-a0f0-c43c4d080911
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:d53947d8-21fc-df12-a0f0-c43c4d080911
msgctxt "hf882d843g0927g445eg90d6gef93d9b6fa15"
msgid "I didn't bring anything to swim in."
msgstr "수영할 때 입을 옷은 가져오지 않았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = dc3879e1-1e37-4c43-abf3-e399d6fa1478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:dc3879e1-1e37-4c43-abf3-e399d6fa1478
msgctxt "h4eb98788gabd9g4803g9ab3g622f72988ae5"
msgid "<i>Do as she says</i>."
msgstr "<i>그녀의 말에 따른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = dcf4063d-193d-744f-980a-048379c1a677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:dcf4063d-193d-744f-980a-048379c1a677
msgctxt "ha7a3b810gcc3cg4968g9e0fg3ba45582e67e"
msgid "I don't want to go back. Not just yet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = e10a3b94-85ae-394a-591a-9ff9b07c1d21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:e10a3b94-85ae-394a-591a-9ff9b07c1d21
msgctxt "h0831ab95g76cbg452ega5eeg343c675b863a"
msgid "Hard not to. You're beautiful."
msgstr "네가 아름다워서 고개를 돌리기 힘들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = e1420d7f-0526-71fe-a505-42bd5ddeda5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:e1420d7f-0526-71fe-a505-42bd5ddeda5c
msgctxt "h291c7e46gbbc3g4b4eg969dgb3ff8d76a012"
msgid "You're what...? But I already took my clothes off."
msgstr "뭐라고...? 하지만 난 이미 옷을 다 벗었는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = e345a5f0-ff39-5c05-2387-51a746dec5be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:e345a5f0-ff39-5c05-2387-51a746dec5be
msgctxt "h212aae05g276cg4136gaaeag84b2d33b797e"
msgid "You <i>pest</i>!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = e8a2f935-4548-eac9-c0f8-abb080b1895c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:e8a2f935-4548-eac9-c0f8-abb080b1895c
msgctxt "hb89260fbgf54eg4ec2ga7c2g03b968e2b089"
msgid "Nothing at all. You're beautiful."
msgstr "아무것도 아니야. 그냥 네가 아름다워서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = f2a80417-e296-e37c-d316-1c2dc0b5dacf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:f2a80417-e296-e37c-d316-1c2dc0b5dacf
msgctxt "h747a54eeg0cdbg43cdga97dgebb020e90c52"
msgid "I'm sorry."
msgstr "미안."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Shadowheart
#. NodeID = fda433c0-4613-8d30-6a06-df743a3cf3a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:fda433c0-4613-8d30-6a06-df743a3cf3a8
msgctxt "h883c7e18g9029g4a2cgb5f2g3602b56f9baf"
msgid "Just a pebble."
msgstr "그냥 조약돌이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM
#. Speaker = Player
#. NodeID = ff07ba24-bdea-3ef0-c20d-3dcdf7097fe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Shadowheart_SkinnyDipping_SD_ROM:ff07ba24-bdea-3ef0-c20d-3dcdf7097fe6
msgctxt "hd1ec1397g1a82g4750g885bge4dcfd9f1635"
msgid ""
"And you can put them back on again if you like. Come on, we've a walk ahead "
"of us."
msgstr "네가 원한다면 다시 입으면 되지. 서둘러, 걸어가야 할 길이 멀어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 113348e9-dc47-4841-b66b-fa9f4e47f77e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:113348e9-dc47-4841-b66b-fa9f4e47f77e
msgctxt "he252af62g24c7g4b78gbcc0g2de7ce5ffba7"
msgid "Hells - a devil. This must be a bad dream..."
msgstr "젠장, 데빌이잖아. 분명 악몽을 꾸는 걸 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 13f64ea2-b2c1-9aca-967d-518e2bd76aa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:13f64ea2-b2c1-9aca-967d-518e2bd76aa5
msgctxt "hdaade0ddg5033g4a54gbdf2gceeaeb7ae738"
msgid "What do you know - I was just thinking about you."
msgstr "그거 알아? 마침 네 생각 중이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 14973698-fde5-4197-ac27-05afece3f5fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:14973698-fde5-4197-ac27-05afece3f5fc
msgctxt "hf7b8bbf1g3a7bg4422g8831g1d346b1cb245"
msgid "Half-devil, hon - and I'm no dream. But if I were, I'd be the baddest."
msgstr "하프-데빌이겠지, 애기야. 게다가 난 꿈 따위가 아니란다. 내가 악몽에 나왔다면, 이 정도는 약과지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 1d406da8-7f64-3da2-5b98-02b26f576cd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:1d406da8-7f64-3da2-5b98-02b26f576cd8
msgctxt "h883f4688gbc64g4094gb17cga8a979ec6e13"
msgid ""
"The Sword Coast is in danger. I'll send this damned fiend back to the Hells."
msgstr "소드 코스트가 위험에 처했군. 이 빌어먹을 마족을 지옥으로 돌려보내야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 23fae69a-1480-06cd-576b-b4b5b99f6f8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:23fae69a-1480-06cd-576b-b4b5b99f6f8c
msgctxt "hf58e50cagec9fg4f4cgb9e8g5a13891217d2"
msgid "That's the spirit. Go get her, tiger."
msgstr "좋은 자세야. 가서 그년을 잡으렴, 맹수야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 29c0a707-7614-fb73-a0bc-33ab09a11e69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:29c0a707-7614-fb73-a0bc-33ab09a11e69
msgctxt "hc90d61f5g97acg4d29gaf1dg3a2318ad7ba4"
msgid "Hells - a devil. This must be a bad dream..."
msgstr "젠장, 데빌이잖아. 분명 악몽을 꾸는 걸 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 29ffc4fb-eab8-a9db-f617-3bf53ed420c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:29ffc4fb-eab8-a9db-f617-3bf53ed420c3
msgctxt "h775cb451gd659g47b5g960bg67e4036863f3"
msgid "You can shove the deal up your own arse."
msgstr "네 똥은 네가 닦아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 2ef03679-c28d-4848-ccc0-be9ecc7175e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:2ef03679-c28d-4848-ccc0-be9ecc7175e6
msgctxt "h3b060ec6g5207g4d13g8ccfg42e385b0cc0f"
msgid ""
"Karlach's not just the Hells' problem now. She fled Avernus on the same ship "
"you hitched a ride on."
msgstr "칼라크는 이제 지옥만의 골칫거리가 아니야. 네가 얻어 탔던 함선에 올라타 아베르누스를 빠져나갔거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Narrator
#. NodeID = 35ce52e9-3f13-1329-bcad-fc6296cd28c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:35ce52e9-3f13-1329-bcad-fc6296cd28c5
msgctxt "hbd3fcdb4g4072g47bcg84d0g19406544dcc6"
msgid ""
"*Memories of your father - Grand Duke Ulder Ravengard - and his diplomatic "
"mission to Elturel. Memories of the diabolical bargain you made to save "
"Baldur's Gate in his absence...*"
msgstr ""
"*당신의 아버지, 얼더 레이븐가드 대공과 외교 사절단으로 엘투렐에 파견되었던 기억들. 아버지가 자리를 비운 동안 발더스 게이트를 구하기 "
"위해 악마적인 계약을 맺었던 기억들...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 3f8b24a2-c6f9-efba-7927-b0906aad0654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:3f8b24a2-c6f9-efba-7927-b0906aad0654
msgctxt "h5a778cc2g68aag410dg9f37g0ed3e77b14b5"
msgid "You can shove the deal up your own arse."
msgstr "네 똥은 네가 닦아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Narrator
#. NodeID = 47df6f75-0738-820d-373e-6ce5c92a2ee0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:47df6f75-0738-820d-373e-6ce5c92a2ee0
msgctxt "hec273b13g5bc2g46a8gbb03g20815d11642c"
msgid ""
"*Just ahead, the diabolical figure called Karlach cuts through demonic "
"invaders, her single horn blazing in flame. You are the hunter, and she is "
"your prey.*"
msgstr ""
"*바로 눈앞에, 칼라크라고 불리는 사악한 존재가 불꽃에 휩싸인 외뿔을 불태우며 데몬 침략자들을 베어 넘기고 있습니다. 당신은 사냥꾼이고, "
"그녀는 사냥감입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 4e30927e-364e-8975-5b72-5f2039c0ba0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:4e30927e-364e-8975-5b72-5f2039c0ba0d
msgctxt "h370591b5g157fg4133gb29bgd26245d512e7"
msgid "Wrong on both counts, pet."
msgstr "오답만 늘어놓는구나, 강아지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 4f98d4dd-8e79-4fa3-ba23-aac818e7c954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:4f98d4dd-8e79-4fa3-ba23-aac818e7c954
msgctxt "h91614bd7g9d8dg4887ga2ffg97acecacca46"
msgid ""
"My poor little pupster. A free trip on a mind flayer machine, and all you've "
"got is a brain-bug to show for it."
msgstr "우리 불쌍한 강아지. 마인드 플레이어 기계를 얻어 타고 공짜 여행을 떠나더니, 고작 뇌 벌레만 얻어 왔네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 50ad0f79-6afd-d421-74ff-c85e3456be5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:50ad0f79-6afd-d421-74ff-c85e3456be5f
msgctxt "hb552e21bg8f10g4bf8ga1e5gfb262a4818aa"
msgid "She's still in the Hells. I need to get back there."
msgstr "그녀가 아직 지옥에 있어. 다시 돌아가야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 51ea1705-785f-cffd-4985-e40c2d27f6b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:51ea1705-785f-cffd-4985-e40c2d27f6b0
msgctxt "h3d4b0ac6g57fcg459agb0e8g5af92e79203d"
msgid "Remind me - what should I be doing?"
msgstr "다시 일러줘 - 내 목표가 뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 5d8b310c-5f87-c494-99fc-4c2c137fef57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9db546b0-cae4-da40-9042-a8df02e71e8d_Tadpole = False
#. SetFlags:
#.   Local:
#.     - 9db546b0-cae4-da40-9042-a8df02e71e8d_Tadpole = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:5d8b310c-5f87-c494-99fc-4c2c137fef57
msgctxt "ha81e6611g5c70g4833g9268g3abdcad0c8ca"
msgid "I have bigger problems now, if you haven't noticed."
msgstr "눈치채지 못했나 본데, 지금 더 큰 문제가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 6100bb98-9ced-03b5-2802-073a08d4c72e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:6100bb98-9ced-03b5-2802-073a08d4c72e
msgctxt "h5659d9d6gc734g4b4cgb255g9198e8f4c3b9"
msgid "She's still in the Hells. I need to get back there."
msgstr "그녀가 아직 지옥에 있어. 다시 돌아가야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 68fdf9ed-91cf-4acd-b7c9-25b40b59b468
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:68fdf9ed-91cf-4acd-b7c9-25b40b59b468
msgctxt "ha2cff52bgcd6eg4723g9984gce6f43e74c6b"
msgid "Mizora. I'm surprised it took you this long to stop by."
msgstr "미조라. 그러지 않아도 왜 안 나타나나 싶었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 6fb8ffae-38c2-3c98-132d-bc60a65cc005
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:6fb8ffae-38c2-3c98-132d-bc60a65cc005
msgctxt "h4e40d09fg98ccg489bg8013g4a59dbf6e1a2"
msgid ""
"But she's not just the Hells' problem now. She fled Avernus on the same ship "
"you hitched a ride on."
msgstr "하지만 그년은 이제 지옥만의 골칫거리가 아니야. 네가 얻어 탔던 함선에 올라타 아베르누스를 빠져나갔거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 73cafb26-e79c-8cd4-c00c-ba56648f21a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:73cafb26-e79c-8cd4-c00c-ba56648f21a7
msgctxt "h5f0d7a04g8a18g4aa7g8ca4gf1423915db9d"
msgid ""
"And I <i>know</i> the famed Blade of Frontiers would never stand for that."
msgstr "그리고 난 저명하신 변경의 칼날께서 그 꼴을 그냥 두고 보지 않을 거라는 걸 <i>알지</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 8791b2ea-830c-49f1-16da-1793c7b4a495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:8791b2ea-830c-49f1-16da-1793c7b4a495
msgctxt "hbec9a992gfde2g4dfcg8175g6aeb3069dffa"
msgid "What do you know - I was just thinking about you."
msgstr "그거 알아? 마침 네 생각 중이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 8c92c666-a526-408f-be93-83edb58f97d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:8c92c666-a526-408f-be93-83edb58f97d1
msgctxt "h870d7beag2aa2g4cf3ga685g658263affdbc"
msgid ""
"Come knocking before you've settled in? I may be half-devil - but I'm no "
"<i>monster</i>."
msgstr "노크도 없이 찾아올 줄 알았니? 내가 비록 하프-데빌일지언정, <i>괴물</i>은 아니라구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = 8ce9da75-bdc9-f15b-cc49-37e9ca98fbf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:8ce9da75-bdc9-f15b-cc49-37e9ca98fbf3
msgctxt "h1f44f0bdg75adg43d6gb956g0dd36bfb1d9e"
msgid ""
"Sweet spot you've found for yourself. But I wouldn't get too cosy. After "
"all, we've got a deal."
msgstr "제법 괜찮은 장소를 찾아냈구나. 그치만 나라면 너무 아늑하게 지내진 않겠어. 결국, 우린 거래를 했잖니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = 8f60eb09-27b6-3e4d-0f71-63fabd01cb01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:8f60eb09-27b6-3e4d-0f71-63fabd01cb01
msgctxt "hb27e9becg5a37g4858g8406g438fc77a546f"
msgid "I know the terms of our bargain. I'll find Karlach and kill her."
msgstr "계약 조건을 굳이 상기시켜 줄 필요 없어. 칼라크를 찾아서 죽일 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Narrator
#. NodeID = 9fe0eddd-6a7e-ec2f-916b-2ae8f1a58fa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:9fe0eddd-6a7e-ec2f-916b-2ae8f1a58fa8
msgctxt "h92ee33b3gcc0cg4956gb298ge1f845df5f85"
msgid ""
"*Another memory seizes your mind. You race through the burning wastes of "
"Avernus.*"
msgstr "*또 다른 기억이 당신의 정신을 사로잡습니다. 당신은 아베르누스의 불타는 황무지를 질주합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = ac0ad4bd-77d8-36ed-ef6b-2ff38fa9f1fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:ac0ad4bd-77d8-36ed-ef6b-2ff38fa9f1fd
msgctxt "hc4757272gcc76g4813gb427g63bc3805a664"
msgid "Obedient thing - I love to see it."
msgstr "순종적인 것 - 사랑스럽기도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = ae2309b8-e1c6-5a39-e575-da832ed55bc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:ae2309b8-e1c6-5a39-e575-da832ed55bc6
msgctxt "h5b88f68agafa3g4b49g98degd4b87b035340"
msgid "Remind me - what should I be doing?"
msgstr "다시 일러줘 - 내 목표가 뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = b53497c2-af1d-950c-f6ac-c6ff23da4804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:b53497c2-af1d-950c-f6ac-c6ff23da4804
msgctxt "h41f81a42g51fcg4f68g98a7g6bddb338b316"
msgid "Karlach's fled Avernus on the same ship you hitched a ride on."
msgstr "칼라크는 네가 얻어 탔던 함선에 올라타 아베르누스를 빠져나갔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = b63e9cee-2cea-2b01-a34a-03cf51322649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:b63e9cee-2cea-2b01-a34a-03cf51322649
msgctxt "h8f46c8a5g273dg41c1g8f2agf5e3b064391a"
msgid ""
"The Sword Coast is in danger. I'll send this damned fiend back to the Hells."
msgstr "소드 코스트가 위험에 처했군. 이 빌어먹을 마족을 지옥으로 돌려보내야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = c00560d0-5c30-d483-8f43-7399243fce30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - ORI_Avatar_Wyll.FirstContact(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:c00560d0-5c30-d483-8f43-7399243fce30
msgctxt "h5cf9e37ega4bdg4b78g8590g9c1a5eac6bfe"
msgid ""
"Be a good boy. Bring me her head for dessert - I've a sweet tooth, and "
"devil's on the menu."
msgstr "착하게 굴어. 그년 대갈통을 디저트로 내와. 달달한 게 땡기는데, 마침 차림표에 데빌이 있잖니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = c06101ab-a470-66f9-7c63-135f8518d2f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9db546b0-cae4-da40-9042-a8df02e71e8d_Tadpole = False
#. SetFlags:
#.   Local:
#.     - 9db546b0-cae4-da40-9042-a8df02e71e8d_Tadpole = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:c06101ab-a470-66f9-7c63-135f8518d2f1
msgctxt "h5f412b1dg018ag47ddgab5egdb627b53421a"
msgid "I have bigger problems now, if you haven't noticed."
msgstr "눈치채지 못했나 본데, 지금 더 큰 문제가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = c46940fe-3f05-e3f9-7f14-2d1397232c8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:c46940fe-3f05-e3f9-7f14-2d1397232c8b
msgctxt "h4d1683d9gafe4g46eegaeedg7d35a8a37a51"
msgid ""
"Wild little thing. You don't find her and cut her down, she'll burn the "
"whole Coast to ash."
msgstr "다루기 고약한 년 같으니. 그년을 찾아서 죽이지 않으면, 아마 소드 코스트 전체가 잿더미가 되고 말걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = c4e4fa65-7f9c-5629-47df-cf2ef00c3c5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:c4e4fa65-7f9c-5629-47df-cf2ef00c3c5b
msgctxt "h51375797g7cf9g4cb5g8855g1c4bc2b0da86"
msgid "Yelp all you want - you belong to the Hells."
msgstr "어디 맘껏 짖어 보렴. 네 영혼은 지옥에 묶여 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = ce7ffc84-752e-d741-16ff-920f47bf356f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:ce7ffc84-752e-d741-16ff-920f47bf356f
msgctxt "h9cc58e86g87b5g477fgbb7eg31077e99ce6a"
msgid ""
"You missed me? How sweet. The best bloodhounds are always the most loyal."
msgstr "내가 그리웠구나? 귀엽기도 하지. 일등 사냥개의 덕목은 언제나 충성심에 있다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = d2c0663c-a021-6d9b-e7e6-5495ba9a01f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:d2c0663c-a021-6d9b-e7e6-5495ba9a01f2
msgctxt "h0a4dbf83g67b0g43a7gb462gba2b9f4b0d21"
msgid "I know the terms of our bargain. I'll find Karlach and kill her."
msgstr "계약 조건을 굳이 상기시켜 줄 필요 없어. 칼라크를 찾아서 죽일 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Narrator
#. NodeID = d6d03e73-6761-43b5-a1bf-ef450a5129ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:d6d03e73-6761-43b5-a1bf-ef450a5129ef
msgctxt "h71ec9d21g466dg44e6g8ce3g1ffbfc9486f3"
msgid "*It is a fitful night, haunted by the bitter memories of the past.*"
msgstr "*과거의 쓰라린 기억에 시달리는, 잠 못 이루는 밤입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = d8b1443b-1dcc-1232-6241-8fd93d9e7e30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9db546b0-cae4-da40-9042-a8df02e71e8d_Tadpole = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:d8b1443b-1dcc-1232-6241-8fd93d9e7e30
msgctxt "hb90e76b4gef24g4ab5gafc6ga45934f676ba"
msgid "I don't care about the deal. I just want this thing out of my head."
msgstr "거래 따위엔 관심 없어. 그냥 내 머릿속에서 이놈 좀 꺼내줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = dc5dc5c3-91a9-0b37-443b-52222b479f3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:dc5dc5c3-91a9-0b37-443b-52222b479f3e
msgctxt "hccc7b294g456fg4cecg98f2gdeef8186873a"
msgid ""
"I won't lie, pet - you drew a lousy hand. But folding's not an option when "
"your soul's on the line."
msgstr "거짓말은 안 할게, 강아지. 넌 형편없는 패를 뽑았어. 하지만 영혼이 걸려 있는 판에서는 그렇게 쉽게 포기하면 안 되지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = e35ea58e-e01b-8fe7-d4da-4ddd7cb15799
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:e35ea58e-e01b-8fe7-d4da-4ddd7cb15799
msgctxt "hf3f1562cgf9cag47b6g948bgb33b9cd6857b"
msgid ""
"My poor little pupster. A free trip on a mind flayer machine, and all you've "
"got is a brain-bug to show for it."
msgstr "우리 불쌍한 강아지. 마인드 플레이어 기계를 얻어 타고 공짜 여행을 떠나더니, 고작 뇌 벌레만 얻어 왔네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Narrator
#. NodeID = e39338e1-8fcc-c4a0-217c-8a5e8bd9b583
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:e39338e1-8fcc-c4a0-217c-8a5e8bd9b583
msgctxt "h0e535bccgcc70g4a22gb759ge7c72b84d0c4"
msgid ""
"*...Memories of your father casting you, his Hells-touched son, out of your "
"beloved city.*"
msgstr "*...당신의 아버지가 지옥에 물든 아들을 사랑하는 도시에서 추방했던 기억들.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = eb572e9b-55d9-e63b-f871-97f75911430a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:eb572e9b-55d9-e63b-f871-97f75911430a
msgctxt "h8b413aceg09b7g4c85g9424g89215db31262"
msgid ""
"Good boys get treats. Bad boys? Well - let's not think about that 'til we "
"need to."
msgstr "착한 아이들은 상을 받지. 나쁜 아이들은? 글쎄, 지금 당장은 생각하지 않는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = ebd715c7-9e88-7743-4fb9-df1be36101f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9db546b0-cae4-da40-9042-a8df02e71e8d_Tadpole = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:ebd715c7-9e88-7743-4fb9-df1be36101f1
msgctxt "hbaf3c443gb268g4ba6gaff1g1d896e15c3dc"
msgid "I don't care about the deal. I just want this thing out of my head."
msgstr "거래 따위엔 관심 없어. 그냥 내 머릿속에서 이놈 좀 꺼내줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Mizora
#. NodeID = f58bade3-3568-e865-1351-6ba8602b9299
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:f58bade3-3568-e865-1351-6ba8602b9299
msgctxt "h3ac6a269gaa2cg43a2g91deg2369e565f9a0"
msgid ""
"Killing the fiend known as Karlach. She's been a thorn in the archdevil "
"Zariel's side."
msgstr "칼라크라고 알려져 있는 마족을 죽여. 아크데빌 자리엘께서 골칫거리로 여기고 계시니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD
#. Speaker = Player
#. NodeID = faf8163e-f657-37d1-d986-3a2910976c8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_MizoraFirstContact_SD:faf8163e-f657-37d1-d986-3a2910976c8f
msgctxt "h461576abg3b09g4b8fga999g2790c6bf64bb"
msgid "Mizora. I'm surprised it took you this long to stop by."
msgstr "미조라. 그러지 않아도 왜 안 나타나나 싶었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 006d1379-5b25-7eb4-ba30-3a96ab138526
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:006d1379-5b25-7eb4-ba30-3a96ab138526
msgctxt "h10eff38eg81dbg4b5cga3a6g9157185d5506"
msgid ""
"Ha ha - <i>ahem</i>. Don't you worry. It takes years to master the Vollante."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 04e18428-5d06-0cd8-c8f0-53498d3a493b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_PartneredWithWyll(1) = False
#.     - ORI_State_DatingWithWyll(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:04e18428-5d06-0cd8-c8f0-53498d3a493b
msgctxt "h4f49878cg9ab6g450bg9399ga8d420479fcd"
msgid "Sorry, but it's a firm 'no' on this one."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 06574f79-de03-b588-8b58-2c7fc64aed68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:06574f79-de03-b588-8b58-2c7fc64aed68
msgctxt "hb414d194g0c8eg4b59g88c1gc60c2ef2dabe"
msgid "You have more control than you give yourself credit for."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 07e57263-0c37-d0b8-2bfd-365f2f01070e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:07e57263-0c37-d0b8-2bfd-365f2f01070e
msgctxt "he5e77353g8e84g4707g84cfgdd62275cea4b"
msgid ""
"Wyll, I'd love nothing more than to dance with you. But I fear I'd burn you "
"to a crisp."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 081114e4-7348-e247-dfea-6ca67e744569
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:081114e4-7348-e247-dfea-6ca67e744569
msgctxt "he0c4930bge824g4b4bgaa91g5864704eb7a0"
msgid "I could try. If you're up for it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Player
#. NodeID = 0bd5373c-c4dd-efa1-1ef3-4ea5800c033e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:0bd5373c-c4dd-efa1-1ef3-4ea5800c033e
msgctxt "hdf2ee9a3g8464g462ag90a7g5d85ce4b1407"
msgid "Dance? But there's no music."
msgstr "춤추자고? 음악이 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 0e85510f-6d1c-9e27-c7c9-fa294955a3f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:0e85510f-6d1c-9e27-c7c9-fa294955a3f9
msgctxt "ha4dae334gc09cg43aagb058g3ff4b9b4b516"
msgid "Our hearts can keep time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 0eac9cd8-92b2-780a-214d-19079a0e70f5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:0eac9cd8-92b2-780a-214d-19079a0e70f5
msgctxt "h84469542g2652g4e7cg8efcgf8df93d57045"
msgid "As luck would have it, she just arrived."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 0eac9cd8-92b2-780a-214d-19079a0e70f5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM:0eac9cd8-92b2-780a-214d-19079a0e70f5
