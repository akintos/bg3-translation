msgctxt "h6d6e1c96g2108g4facg82ddgc8c34724d876"
msgid ""
"There are, after all, other spreads before me. Gale looks particularly "
"tempting tonight."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
