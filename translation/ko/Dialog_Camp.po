msgid "<i>Perform a simple cadence.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_Wyll_SD_HavenRomance_ROM
#. Speaker = Wyll
#. NodeID = 12285705-8607-03a4-350e-e7fba059b391
