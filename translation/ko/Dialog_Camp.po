msgctxt "haca3711fgdbf2g4a5ag9b0eg6ee234abc52f"
msgid "And? Did you kill any?"
msgstr "그래서? 뭐라도 죽였어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
