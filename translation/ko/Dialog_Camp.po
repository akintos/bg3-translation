msgctxt "h5fc39249g42c0g4709gbc92g46d478ec9c0b"
msgid "I was hoping you'd come by."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
