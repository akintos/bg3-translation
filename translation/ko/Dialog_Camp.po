msgctxt "hc1992e2bgbc3bg4400gb496gc6622ab0c99b"
msgid "And you're carousing with Astarion."
msgstr "그리고 넌 아스타리온과 웃고 떠들고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
#. Speaker = Shadowheart
