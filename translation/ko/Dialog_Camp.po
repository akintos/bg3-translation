msgctxt "h6e879a4fgdadeg4af8gb40ag517b5749843c"
msgid "I'll never forget him, but I'm glad to have met you."
msgstr "그를 절대 잊진 못하겠지만, 널 만나서 정말 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
