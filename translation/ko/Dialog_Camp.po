msgctxt "h1b34bffcg9254g4bfdg8637g7d9c85ee96f6"
msgid "<i>Push into his mind, searching for the truth.</i>"
msgstr "<i>진실을 찾아 그의 내면에 침투한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 78bc91b3-5744-ba21-ca6f-21f375d4bc1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:78bc91b3-5744-ba21-ca6f-21f375d4bc1b
msgctxt "h4a7dced7g8ebfg40bag868ag2d5fda609fca"
msgid "That - that was amazing."
msgstr "이건, 방금은 정말 최고였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = 78ea25f7-5c0f-b206-859d-77b3da29b515
