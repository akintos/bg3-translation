#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_OwlbearCub_HasMet_GoblinHuntCelebration(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub:a9932b1f-470d-19c5-0a63-39faefce99da
msgctxt "h35c5f607g9deag476cg8600gfca0699bda16"
msgid "Red people. Blood people."
msgstr "붉은 사람. 피 사람."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_OwlbearCub
#. Speaker = Owlbear Cub
#. NodeID = ac3fc70f-17a5-a058-b4c2-3b328ab8299f
