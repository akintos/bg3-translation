#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:2076d49f-bac6-b2b0-bb53-22e4eceaeea6
#, fuzzy
msgctxt "h378cf267gaad4g4befgb824gfac366d78e52"
msgid "<i>Call to them.</i>"
msgstr "<i>둘을 부른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Owlbear Cub
#. NodeID = 2619ccbc-a874-9833-6373-b090161796d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:2619ccbc-a874-9833-6373-b090161796d9
msgctxt "hc18b1629g3322g4a2fg8a9dg94f2867da399"
msgid "Goblins had me in a cage. Poked me with pointy sticks.."
msgstr "고블린들이 날 우리에 가뒀어. 뾰족한 막대기로 찔러댔어.."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Owlbear Cub
#. NodeID = 2aafc72c-0120-8a0c-5b5f-92a499837385
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:2aafc72c-0120-8a0c-5b5f-92a499837385
msgctxt "h0fa17157gbdb2g4e97ga058g4867fbd4b083"
msgid "Like it here. Warm fire, Scratch reminds me of big brother."
msgstr "여기 좋아. 불 따뜻하고, 스크래치 형 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Scratch
#. NodeID = 348b3836-6a1b-3b82-0eab-53bb63d713c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Courier_Dog_State_PlayersAndDogArePack = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:348b3836-6a1b-3b82-0eab-53bb63d713c7
msgctxt "hf2dec931ga0f1g4460gabafg42a341fb7a19"
msgid "Easy now. The guardian's just looking out for us."
msgstr "진정해. 수호자는 그저 우릴 지켜봐주고 있을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 348f5302-0070-3e3e-607e-2685a1aca722
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:348f5302-0070-3e3e-607e-2685a1aca722
msgctxt "h09a1114age0b3g4a5dg8539g365d68a0d1ba"
msgid "<i>Leave it. Those animals aren't your concern.</i>"
msgstr "<i>무시한다. 저 동물들은 관심사가 아니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
