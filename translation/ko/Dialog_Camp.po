#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:2bb02121-2f41-fd85-8f5a-20934b373d53
msgctxt "h097c7553g274bg4eabgb51egcb21d030ea99"
msgid "*Alarmed by your companion's approach, the cub flees into the forest.*"
msgstr "*동료가 다가오자 놀란 아울베어 새끼는 숲으로 달아납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 2fce1b34-67b2-d9a3-1048-3a971f733893
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HasTaggedItem_FOOD(1) = True
#.      - GLO_Polymorphed(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:2fce1b34-67b2-d9a3-1048-3a971f733893
msgctxt "h7665b75eg7478g4ba4gae3fg704b31226f8d"
msgid "I have food. Would you like it?"
msgstr "밥 있어. 먹을래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Owlbear Cub
#. NodeID = 3011ce15-13b1-b79a-060a-466ab3f9909a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:3011ce15-13b1-b79a-060a-466ab3f9909a
msgctxt "h4cff5715gf976g45c5g952fgd1e10e8a9c69"
msgid "Big! Friend?"
msgstr "커! 친구?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 30fbb85f-a176-facb-96da-4a9c5a51d82d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HasTaggedItem_FOOD(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:30fbb85f-a176-facb-96da-4a9c5a51d82d
msgctxt "he40ca598g28ecg4b0dg9037g4abee46f8708"
msgid "*Your hand is suddenly empty - the work of a surreptitious companion.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 35ac1c9d-4177-a497-9eef-1427c69491b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:35ac1c9d-4177-a497-9eef-1427c69491b9
msgctxt "h15ea7677g4e76g4af2g8f72ga03b22d54c1e"
msgid ""
"Careful. Once that thing's eaten through the camp, it might start looking at "
"<i>you </i>hungrily."
msgstr "조심해. 쟨 야영지에 있는 걸 다 먹어 치우고 나면, 배고픈 표정으로 <i>널</i> 쳐다볼 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Owlbear Cub
#. NodeID = 3d388020-8d87-ee2c-91e9-52d576980c02
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_OwlbearCub_Event_Fight = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:3d388020-8d87-ee2c-91e9-52d576980c02
msgctxt "h1ba08543g86adg4ef8g9d96g1a6b238223ce"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 3dc07c8c-5a91-37db-b62b-7c5a8cc5a1e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 382ca17f-f229-c9f2-4aaf-86504be0e5e2_AnimalHandlingSuccess = True
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:3dc07c8c-5a91-37db-b62b-7c5a8cc5a1e5
msgctxt "haea66582g0478g45d4g8889g0de9fc62bf48"
msgid ""
"*Frightened by the sharp noise, he turns tail and runs into the forest.*"
msgstr "*날카로운 소리에 놀란 녀석은 곧바로 뒤돌아 숲으로 도망칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 3fcda9a7-d19d-d56e-7543-cb8ec57f4f70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_OwlbearCub_State_Friend = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:3fcda9a7-d19d-d56e-7543-cb8ec57f4f70
msgctxt "hfeaf45e4g7592g41e6g9394g581ddb41d9c0"
msgid "<i>Keep your distance.</i>"
msgstr "<i>거리를 유지한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 40e9beb0-204a-24a4-b8c9-8b754f975b56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:40e9beb0-204a-24a4-b8c9-8b754f975b56
msgctxt "h551c0e3ega487g4bc0gad23gf5f2db50b1a1"
msgid ""
"*You recognise the feathered creature - it's the owlbear cub you rescued.*"
msgstr "*당신은 깃털 달린 생명체를 알아봅니다 - 당신이 구해줬던 새끼 아울베어입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 428ab992-60f6-ae60-16fb-d169385046e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 382ca17f-f229-c9f2-4aaf-86504be0e5e2_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:428ab992-60f6-ae60-16fb-d169385046e4
msgctxt "h414a64dcgc509g45b1g8048gf53e5f744f1e"
msgid "*Your movement angers the cub. He readies himself to charge.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Owlbear Cub
#. NodeID = 438d9444-1399-d98f-66c5-6dfd153910b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:438d9444-1399-d98f-66c5-6dfd153910b7
msgctxt "hcaaf0f17g99bcg40f6g8f11g492bf7421ad6"
msgid "*Chirrup!*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 44589cb9-c3e6-724b-4fe4-de361b543e7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:44589cb9-c3e6-724b-4fe4-de361b543e7e
msgctxt "h01cd283cg6407g4950g8d78g91eb7033c5c8"
msgid "<i>Keep the food held out in front of you.</i>"
msgstr "<i>음식을 든 손을 내밀고 있는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 4a2795cf-786a-0d1f-4362-3837aa92fb22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:4a2795cf-786a-0d1f-4362-3837aa92fb22
msgctxt "h65926808g803fg4a90ga171ged667eb57151"
msgid "Bah. Now that you've fed it, we'll never be rid of the beast."
msgstr "윽. 먹이를 줬으니, 이제 저 짐승을 떼어낼 수 없겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Owlbear Cub
#. NodeID = 4b624fb0-6353-9ca9-d684-e7a33ddf0fa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:4b624fb0-6353-9ca9-d684-e7a33ddf0fa8
msgctxt "ha9546974g1f9dg4179gbf92gc2218e6c79fd"
msgid "Bad! Mean..."
msgstr "나빠! 나빠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 4e2884b9-f0a6-1d4f-e816-8b46d346a678
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - GLO_Polymorphed(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:4e2884b9-f0a6-1d4f-e816-8b46d346a678
msgctxt "hb6eca660g33fcg4779gb313g15cfaab415d6"
msgid "No, you will <i>not </i>bite."
msgstr "아니, 물면 <i>안 돼</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 4f4e3939-d235-0983-c5a3-c27b9e1ff897
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:4f4e3939-d235-0983-c5a3-c27b9e1ff897
msgctxt "h24885e4bg5ea8g4ff6g9395gb12eabdc9af8"
msgid "<i>Toss the food to the owlbear.</i>"
msgstr "<i>아울베어에게 음식을 던져준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 511a7705-52a6-4ed7-1eed-bf6352c919c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#.      - AVATAR(2) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:511a7705-52a6-4ed7-1eed-bf6352c919c0
msgctxt "hd33869f9g03bag4a55gb996g9d567b7b603a"
msgid ""
"Damn it! We scared it off. Poor little beaky fella - hope he finds his way "
"back."
msgstr "아이씨! 우리 때문에 겁먹었나 봐. 불쌍한 녀석, 돌아오는 길 잘 찾아야 할 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 553ee90c-ff05-5053-c19b-c66414ec5d94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 382ca17f-f229-c9f2-4aaf-86504be0e5e2_AnimalHandlingSuccess = True
#. SetFlags:
#.   Global:
#.     - CAMP_OwlbearCub_State_Friend = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:553ee90c-ff05-5053-c19b-c66414ec5d94
msgctxt "h17a1a0edgae1cg4cffgb73egcd4f8e7c0ace"
msgid "*The creature slows, his aggression replaced with curiosity.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 56f02d09-3422-1d2c-7f63-c1d56946f3c6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - GLO_Polymorphed(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:56f02d09-3422-1d2c-7f63-c1d56946f3c6
msgctxt "hf05c4cafgf9acg48edg9f1bg0885ce8675d6"
msgid "<i>Beckon him closer.</i>"
msgstr "<i>그에게 가까이 오라고 손짓한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 573b3876-9ca1-8cbf-4b60-7ef1d96ca005
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:573b3876-9ca1-8cbf-4b60-7ef1d96ca005
msgctxt "hfce3ca30gf3d7g4842g88a7g30c1c30ec828"
msgid "Are you injured?"
msgstr "다친 곳은 없니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 57af1594-e75f-6c9e-b226-d072b20edbad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - GLO_Polymorphed(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:57af1594-e75f-6c9e-b226-d072b20edbad
msgctxt "h11ca2128gf66cg4bdfgaf54g89339cf399e4"
msgid "<i>Step away from the beast.</i>"
msgstr "<i>짐승에게서 물러난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 580d34f1-dfb3-7b65-f88c-7a156b958b1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:580d34f1-dfb3-7b65-f88c-7a156b958b1e
msgctxt "h72b4a88dg4c04g4835gace7g3d27d198c4ca"
msgid "Go away. You're not welcome here."
msgstr "저리 가. 넌 여기서 환영받지 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 5edc5033-bee2-1b47-7236-a95994405f4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:5edc5033-bee2-1b47-7236-a95994405f4a
msgctxt "h4d8b5ea5g4620g43f5gaa1dg6c49cd95367d"
msgid "<i>Leave him alone.</i>"
msgstr "<i>그를 혼자 있게 둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 62686a51-bae2-9f0d-03e9-dd2bb1d6e2a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:62686a51-bae2-9f0d-03e9-dd2bb1d6e2a6
msgctxt "h15bf7927gfe69g40cag8aafg689cda7a1902"
msgid "You don't look very strong to me."
msgstr "별로 강해 보이진 않는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 64eb6917-925b-98b7-5571-0452f9fbac09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 382ca17f-f229-c9f2-4aaf-86504be0e5e2_AnimalHandlingSuccess = True
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:64eb6917-925b-98b7-5571-0452f9fbac09
msgctxt "h51a1ca8cg2c7bg4bc1g955fgfc90418c114d"
msgid "*Frightened by the sharp noise, he turns tail and runs away.*"
msgstr "*날카로운 소리에 놀란 녀석은 곧바로 뒤돌아 숲으로 도망칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Owlbear Cub
#. NodeID = 653f5ab4-d5b9-5660-709a-06ec89929e4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:653f5ab4-d5b9-5660-709a-06ec89929e4f
msgctxt "h645000cegf2afg407aga056gb1b3cd07ab9a"
msgid "No! Run!"
msgstr "안 돼! 도망쳐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Owlbear Cub
#. NodeID = 6719bda9-7da6-730e-2a58-86a0bc3a095e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:6719bda9-7da6-730e-2a58-86a0bc3a095e
msgctxt "hf52fecfbg0059g4ddcgacc6ge7e0d55e623f"
msgid "No. Strong. Big!"
msgstr "아니. 크고! 강해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Narrator
#. NodeID = 68f82739-c9da-7ac4-c9e0-9e58ae991801
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 382ca17f-f229-c9f2-4aaf-86504be0e5e2_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:68f82739-c9da-7ac4-c9e0-9e58ae991801
msgctxt "h3e6b439ag6e24g4d30g8ca8gea3ea840d833"
msgid "*He takes a hesitant step toward you, his beak chittering hungrily.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Owlbear Cub
#. NodeID = 6978c4aa-0201-4701-c214-9f8dc312fde4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:6978c4aa-0201-4701-c214-9f8dc312fde4
msgctxt "h4b97813ege4b0g45fcgbc46g8d7389ab5068"
msgid "*Hoo. Hoo-hoot.*"
msgstr "*후. 후-훗.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1
#. Speaker = Player
#. NodeID = 69f530ae-7b79-b347-534a-753cdca10269
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_OwlbearCub_Event_Fight = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_1:69f530ae-7b79-b347-534a-753cdca10269
