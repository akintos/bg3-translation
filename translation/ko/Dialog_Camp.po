#. Speaker = Player
#. NodeID = aa33acbf-ac9e-96de-46be-f7a31bfe29b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart:aa33acbf-ac9e-96de-46be-f7a31bfe29b1
