msgctxt "h7825f1bbg0f52g4cf5gbbcfgffffdc7ae5a6"
msgid "Aw, come on! "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Alfira
#. NodeID = d332c312-f8ae-872c-f039-ece0cb1046c5
