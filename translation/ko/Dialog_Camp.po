msgctxt "hf95c4144g4b59g4b2fgbacfg59cb2e89beec"
msgid "There - a corpse like any other. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Yenna
#. NodeID = 0420a05c-08db-3d70-91ff-6b0e5ef3cadf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:0420a05c-08db-3d70-91ff-6b0e5ef3cadf
msgctxt "h5b22314aga766g4553g9a33gb4c6ffcdb8e0"
msgid "I didn't do anything!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 0dbbc49e-9781-7d9e-fe1e-1f85d01cecba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:0dbbc49e-9781-7d9e-fe1e-1f85d01cecba
msgctxt "h559ccb7ag55a0g4994gb646gadc43a13a747"
msgid "Another normal evening in camp, I see."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 111cd0a3-2c4f-2917-1e15-ce47f72cbf7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:111cd0a3-2c4f-2917-1e15-ce47f72cbf7c
msgctxt "h91204b92g0b06g451egb62eg14448bfb039a"
msgid "Gortash warned you of this? Then there is nothing left to discuss."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Yenna
#. NodeID = 12b2aeb4-076a-5c8a-7e64-07f166c5d3e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:12b2aeb4-076a-5c8a-7e64-07f166c5d3e5
msgctxt "h44cf179dg633dg455dga9e4gd515a3b216e4"
msgid "No, please -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 15075992-bbe1-98e4-1bac-058ee07df467
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:15075992-bbe1-98e4-1bac-058ee07df467
msgctxt "hdc5aebddg8ad4g4ebdg8e34g0d74fedf3d79"
msgid "This is not the whelp who's been following us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 1e272243-637d-c95b-1103-a29d1c7b31be
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_State_OrinLaezelKillsYenna = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:1e272243-637d-c95b-1103-a29d1c7b31be
msgctxt "h0d3cb557gc298g463bg8f10gf5552d64a4a2"
msgid ""
"Blood and tears taste so sweet together. Ambrosia fit for Bhaal himself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 29863835-54fe-721d-54c3-8833cb4ffeb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_KillDirectorGortash_Knows_CampCompromised = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:29863835-54fe-721d-54c3-8833cb4ffeb1
msgctxt "hdd400c72gf7a3g4aedg8950g4a4f51dd3ca4"
msgid "So Gortash spoke the truth."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 2e58be3b-d831-699e-715a-da456610784f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_Event_PlayerOrderedYennaDeath = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:2e58be3b-d831-699e-715a-da456610784f
msgctxt "h984cb82fg8cf8g49b8g9dc8g7f5930d307a6"
msgid "Do it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 3602bb09-3d26-5b9c-892b-199f19657241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:3602bb09-3d26-5b9c-892b-199f19657241
msgctxt "hefe4ec57g0c42g4b7cg8e4ag2179484342f8"
msgid "Let her go, Lae'zel. She's a child!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 46c2e614-842e-6069-1aa7-a97371328f01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:46c2e614-842e-6069-1aa7-a97371328f01
msgctxt "h69803791gd859g46adgb37eg5b342e855dab"
msgid ""
"I saw her - she slipped into camp in the form of a woman and shifted into "
"this... <i>abomination. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 4752d582-be2b-ca10-d6a3-2622eec854e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:4752d582-be2b-ca10-d6a3-2622eec854e0
msgctxt "ha7db6d0fg0d63g4d51gb203gaa08575d3f63"
msgid "We can't take the risk, Yenna. I'm sorry."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 4a726d0d-ea73-43d2-a586-0bba86f79130
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:4a726d0d-ea73-43d2-a586-0bba86f79130
msgctxt "ha1b37454g455fg4ea6g9deagaa2a1ef6a014"
msgid "Let her go, Lae'zel."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 63b9e289-9e4a-ad42-f02b-3c4e10cf9a72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:63b9e289-9e4a-ad42-f02b-3c4e10cf9a72
msgctxt "h37bfd44cg79c3g4aa0g87a7gf5a8bba6828e"
msgid ""
"Do not be deceived by her paltry form. This is no child. This is a "
"shapeshifter who intends to slay us where we sleep. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 64ad3217-2df4-e800-860b-73b0da2b3631
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:64ad3217-2df4-e800-860b-73b0da2b3631
msgctxt "h50c6f4a5g0e22g4697ga848g1a9c3a4c3ac4"
msgid "Explain yourself, Yenna."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = 6730afff-62a7-3f1b-2310-784595ff8730
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:6730afff-62a7-3f1b-2310-784595ff8730
msgctxt "h955c310cg5c14g48dagacd6g80d9d9491038"
msgid "She doesn't seem to be putting up much of a fight..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 6c6f1320-f983-7c87-12d6-0d900247c1f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:6c6f1320-f983-7c87-12d6-0d900247c1f9
msgctxt "h2de77d24gd14fg4f7bgae52gd28e6d82b608"
msgid "You may lack resolve - but I do not."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Yenna
#. NodeID = 77e785f3-d9b1-5715-8cff-be8569ff2079
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:77e785f3-d9b1-5715-8cff-be8569ff2079
msgctxt "h1aa3075dge1abg4e88g9661g1b40d28da9a8"
msgid "Help me! She's gone mad!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 818015ef-17c6-9235-32b7-73f8dc9d63bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:818015ef-17c6-9235-32b7-73f8dc9d63bc
msgctxt "h42f801daga2bag49bag95efg2737b0927c27"
msgid ""
"You'd turn on me to save this ignorant whelp. Do I mean so little to you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 833b0fe0-b0a3-d736-8699-ed0335eba4ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:833b0fe0-b0a3-d736-8699-ed0335eba4ef
msgctxt "h4cb5b77dg284bg4cddg89c6gb0efea33f306"
msgid "Is my word not enough?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 89ec0db1-f6b3-b65a-39b0-5dbfec3deb23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:89ec0db1-f6b3-b65a-39b0-5dbfec3deb23
msgctxt "h3a02829dg7a16g4163g879dgdcb92e4e87f9"
msgid "Her wits are about her - she knows we outnumber her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = 9d5ef9ae-fca4-a093-951e-25fc244d0b2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:9d5ef9ae-fca4-a093-951e-25fc244d0b2f
msgctxt "h956afc74g58deg49b6g99a1gceaf0ae3429f"
msgid "I shall cleave the truth from you like flesh from a <i>dhour</i>. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = a0ab386f-d6a1-60af-0623-06a2670d86c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:a0ab386f-d6a1-60af-0623-06a2670d86c5
msgctxt "h81fd1b04g515fg479bg954bg5b33ffed1b7c"
msgid "She tried to silence me and hide her deception. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = b20e5961-5d82-6463-785d-87eab955cc25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:b20e5961-5d82-6463-785d-87eab955cc25
msgctxt "h63e20871g12d0g408bga582g5edd953a08b6"
msgid "Stay out of this. She is mine to purge. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = bc7b7446-515b-f8f6-b311-c3e1349aea36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:bc7b7446-515b-f8f6-b311-c3e1349aea36
msgctxt "h31436ba5g3b49g4a8eg8897gddfb6b5bc79c"
msgid "Say your farewells, <i>ne'voocrim!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = c787655b-d5b0-afa6-5b74-7dd838b7f7b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:c787655b-d5b0-afa6-5b74-7dd838b7f7b4
msgctxt "h0dee743fgac2fg4b4fga34eg65e91e56bdbf"
msgid "Kill her then - get it over with."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = cbba65a6-d442-e8dc-ffc8-8181b9222025
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:cbba65a6-d442-e8dc-ffc8-8181b9222025
msgctxt "he0d2694dgd1d7g49d7g8e00g1eb8d8eb7cd3"
msgid "It's your decision Lae'zel. I want no part in this."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Yenna
#. NodeID = ce9a959a-f294-911c-53b3-3c632d78fef4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:ce9a959a-f294-911c-53b3-3c632d78fef4
msgctxt "h6aa5ec34g4174g474bgb676g898808242634"
msgid "I-I just came to get warm! I - I like it here with you and -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = d2c93185-2c86-f21d-f51c-e3429d281ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:d2c93185-2c86-f21d-f51c-e3429d281ef1
msgctxt "h30149438g7c76g4227ga65dg3ddce30b1ba8"
msgid "What in the hells is going on here?"
msgstr "대체 무슨 일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = dba1f959-72be-e381-1fef-e792acf81e5f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:dba1f959-72be-e381-1fef-e792acf81e5f
msgctxt "h6af129ffgd82bg4be1g8055gbfaf9b0636e9"
msgid "There's something we're not seeing here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = de71d143-5b4b-ebd7-fde3-14c0561a8cff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:de71d143-5b4b-ebd7-fde3-14c0561a8cff
msgctxt "h57b19c23g3574g4bc9g9929g32b234a9ae37"
msgid "Then let us expose the truth through action. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = e09928f3-56af-2808-2724-ca47af4e7bc2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_Event_PlayerOrderedYennaDeath = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:e09928f3-56af-2808-2724-ca47af4e7bc2
msgctxt "h6d20a353g5caag4077ga831gc5c75a322d94"
msgid "I don't care if she's Orin or not. Kill her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = e4f722a7-366b-31e0-2e70-36caf248f128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:e4f722a7-366b-31e0-2e70-36caf248f128
msgctxt "h6d63e5b8gadf1g457dg95feg35ded6c94c02"
msgid "With pleasure. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = ea9144c1-306a-f59a-4eb7-878c80306ea7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:ea9144c1-306a-f59a-4eb7-878c80306ea7
msgctxt "h8056fbc1gcdbag4b98gaadcgd43069fb22a0"
msgid "Perhaps if I remove your eyes, you'll see things as they are."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Lae'zel
#. NodeID = ecc3b278-ddd5-02eb-d3d2-fdd01f710515
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:ecc3b278-ddd5-02eb-d3d2-fdd01f710515
msgctxt "h1f7021cdga8d9g4376gabbegb52a2137373b"
msgid "<i>Kainyank!</i> Your deception ends now. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel
#. Speaker = Player
#. NodeID = f4fc2e6b-1156-e37d-8478-b6eec12f9a45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Laezel:f4fc2e6b-1156-e37d-8478-b6eec12f9a45
msgctxt "h4358855eg6e91g4e8dg818cgd6eead0d87e9"
msgid "Do you have any proof?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 0088efdf-c2cf-dc44-fa9e-df5d401ed108
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Laezel = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Laezel = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:0088efdf-c2cf-dc44-fa9e-df5d401ed108
msgctxt "ha29989fag66aag49b0g8988gab4a7a871889"
msgid ""
"The githyanki asked me to teach her some combat techniques - naturally, I "
"was pleased to be consulted."
msgstr "기스양키가 전투 기술을 가르쳐 달라고 부탁했어. 당연하게도, 나는 기꺼이 조언을 해줬지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 033930bc-66b0-067f-5b8b-9c279fd6cd67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:033930bc-66b0-067f-5b8b-9c279fd6cd67
msgctxt "h6e8b622agbae7g4a37ga18ag47bd9ca80cb0"
msgid "You're a murderer, Minthara. I can't let you walk away."
msgstr "넌 살인자야, 민타라. 이러고도 그냥 지나갈 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 03964be3-8385-e0e3-8233-8e9161b1c4a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:03964be3-8385-e0e3-8233-8e9161b1c4a7
msgctxt "hf95ecfcdg61eeg4293g9405g3450dd48e2ba"
msgid "All right. I'm with you."
msgstr "좋아. 너와 함께하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 03dfba8a-4c1f-8376-3fdc-914bc8f063a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:03dfba8a-4c1f-8376-3fdc-914bc8f063a5
msgctxt "h8e96b320gf98fg4c7egaca2ga859dd8d952c"
msgid "Someone has betrayed our presence here. A spy."
msgstr "누군가 우리 정보를 적에게 팔아넘겼어. 첩자가 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 05ad0dad-bc29-6e7f-d81b-85d22babd3b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:05ad0dad-bc29-6e7f-d81b-85d22babd3b9
msgctxt "h7c40a683g6154g4d71g8ccdg4b32c5eac893"
msgid "I dealt with her."
msgstr "내가 처리했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 05b8cc4b-210d-b0ee-5882-455a12af2a9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Minsc = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:05b8cc4b-210d-b0ee-5882-455a12af2a9b
msgctxt "h9a09a97cga455g4e5dgb58eg14364d3e26f0"
msgid "You - you killed Minsc?"
msgstr "너 - 네가 민스크를 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 0b32e007-93fb-57f9-e6f0-98440c53f7e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Isobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:0b32e007-93fb-57f9-e6f0-98440c53f7e8
msgctxt "he58f010cg2752g434fg8df7g08984afb1da6"
msgid "You - you killed Isobel?"
msgstr "너 - 네가 이소벨을 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 0d74b0d5-b507-8598-c110-6ac19a1918d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:0d74b0d5-b507-8598-c110-6ac19a1918d7
msgctxt "h4eba596bg91adg48ccg9361gd50f3512dbcc"
msgid "Let's do it while they're awake. It'll be more enjoyable. Please."
msgstr "걔네가 깨어 있을 때 해치우자. 그쪽이 훨씬 더 재밌을 거야. 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 11d9fc4b-68f1-340a-66aa-ef83eb20fe1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:11d9fc4b-68f1-340a-66aa-ef83eb20fe1a
msgctxt "h7f0daa39gf7c8g44ddg9eb1g1bc0e39b89a7"
msgid "We can talk them around. They listen to me."
msgstr "설득할 수 있어. 모두 내 말을 들으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 14f30e6e-64b5-2033-a18e-b690c437c01a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:14f30e6e-64b5-2033-a18e-b690c437c01a
msgctxt "h08b1cb2ega865g468ag8369g518c572e42b6"
msgid "Yes. Menzoberranzan rules. If we're found, we die."
msgstr "그래. 멘조베란잔 식 숨바꼭질이지. 발각되면, 죽는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 1804cf30-a474-6f56-2456-94c5cbabd7a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:1804cf30-a474-6f56-2456-94c5cbabd7a9
msgctxt "h1693dc7dg6c93g4638ga05eg4e2a33459aa4"
msgid ""
"When we met, I was beholden to a cult dedicated to a false god that "
"controlled me through a parasite in my brain."
msgstr "우리가 만났을 때, 난 뇌 속 기생충으로 날 조종하려 드는, 가짜 신을 따르는 교단의 지배를 받고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 18ca99b7-3041-6fb2-b9fd-bb349542a845
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:18ca99b7-3041-6fb2-b9fd-bb349542a845
msgctxt "h1ad45bdeg5cfbg4c7agb47bgef3dc66ce208"
msgid ""
"<i>Of course I did. </i>Anyone who threatens me either kills me, or dies."
msgstr "<i>물론.</i> 나를 위협하는 놈은 누구든, 죽거나 죽이거나 둘 중 하나야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 1ae3a654-e16e-d54a-cbdb-a68d6a2c9032
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:1ae3a654-e16e-d54a-cbdb-a68d6a2c9032
msgctxt "h1d46fc68gb1b1g40b7gb6e3g2810c2443b7e"
msgid "Not the first. I killed my sister in her crib to secure my inheritance."
msgstr "처음 죽여본 것도 아니야. 내 상속을 확고히 하려고 요람에 있던 여동생을 죽였거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 1b957b25-5c80-62b9-2f7b-3a3b3899684e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:1b957b25-5c80-62b9-2f7b-3a3b3899684e
msgctxt "h36c295b4gc133g4408gaf1ag599ad057eaf1"
msgid ""
"This latest conspiracy is rather ordinary in comparison. As is the solution."
msgstr "이 최신 음모는 비교적 평범한 거 같은데. 그 해결책도 그렇고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 1be761c2-ef8d-792b-2f8e-f0128de22a5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:1be761c2-ef8d-792b-2f8e-f0128de22a5f
msgctxt "hf0897b47g44f4g43e4ga448g0e853f7514ae"
msgid "Naturally, she didn't stand a chance. I dealt with her."
msgstr "당연하게도, 그녀에겐 승산이 없었어. 내가 처리했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 1d8a9520-436b-5806-f8a5-bdf39009d9ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:1d8a9520-436b-5806-f8a5-bdf39009d9ea
msgctxt "hf11399b4gd84fg4f35g9695g50abfc9b66df"
msgid "Do you have any proof of this?"
msgstr "무슨 증거라도 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 1e4b81cc-bf3c-934b-cb92-957d4fab89ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_State_DrowBetrayalPacified = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:1e4b81cc-bf3c-934b-cb92-957d4fab89ae
msgctxt "hc39a98a5g7c04g4937g8699gc0ced23bd50d"
msgid "With one exception. You."
msgstr "한 가지 예외를 제외하고. 너 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 2446a765-b666-2196-07ed-f46d7a7ea8ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:2446a765-b666-2196-07ed-f46d7a7ea8ff
msgctxt "h43cc18c7gd9d8g424eg9becg8e2dfaf4a053"
msgid ""
"The creature confessed, of course. Their childish bravado didn't last long. "
"They told me everything."
msgstr "물론 이놈이 자백했지. 그 애송이 같은 허세는 오래 가지 않았어. 금방 다 털어놨거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 27a01b14-24d0-a5d3-b9d7-a1cb981d480c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:27a01b14-24d0-a5d3-b9d7-a1cb981d480c
msgctxt "hdfcdb8cfgc1d6g4d06g9f8eg3c792f2c6902"
msgid ""
"As are you. Consider yourself lucky that I trust <i>you</i>, or you would "
"not be alive to doubt me."
msgstr ""
"그건 너도 마찬가지지. 내가 <i>널</i> 믿는다는 걸 다행으로 생각하는 게 좋을 거야. 그렇지 않았다면 날 의심한 죄로 내 손에 "
"죽었을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 348c811a-8418-9890-30dd-c7f0b4f42d6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:348c811a-8418-9890-30dd-c7f0b4f42d6c
msgctxt "hc2411e5ag1fc1g4930ga23cg87ff5ce6cd01"
msgid ""
"Children should not play at such dangerous games, if they fear getting hurt. "
"This one made some dangerous friends."
msgstr "다치기 싫으면 애들은 이런 위험한 게임에 끼면 안 되지. 이 애는 위험한 친구를 사귄 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 396625de-53c0-3b4f-19a2-5e6ad4ff3176
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:396625de-53c0-3b4f-19a2-5e6ad4ff3176
msgctxt "h295674feg4ad8g4754g9f99g92b989cce144"
msgid ""
"I have heard them whisper, I have seen the way they look at me. They begin "
"to see you in the same light."
msgstr "그놈들이 속닥거리는 소리와, 날 향한 눈길을 봤지. 그러고는 너를 같은 시선으로 바라보기 시작했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 3983a43f-742b-81ae-e86d-3b3e7d8a9ddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:3983a43f-742b-81ae-e86d-3b3e7d8a9ddb
msgctxt "h65c3fe1egfc0eg4db0g91cagd91f9ed5e874"
msgid "No. If the blood-witch were here, I'd be able to smell her."
msgstr "아니. 피의 마녀가 여기 있었다면, 냄새를 맡았을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 3a1cbfe4-1e61-0dd9-a2cf-341a290fb9df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Ravengard = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Ravengard = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:3a1cbfe4-1e61-0dd9-a2cf-341a290fb9df
msgctxt "h79b332a6g4386g4a4bg872bgcd1b12a672e6"
msgid ""
"Ravengard asked to speak with me alone, and the moment my back was turned, "
"he tried to kill me."
msgstr "윌이 단둘이 이야기 할 것이 있다고 했는데, 등을 보이자마자 날 죽이려고 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 3f2af2a1-d51b-791b-7ebd-ed2417a2d67d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:3f2af2a1-d51b-791b-7ebd-ed2417a2d67d
msgctxt "hf416e821ge38cg4c76gbb39g933aac9efe9d"
msgid "It was the girl, Yenna. I have dealt with the problem."
msgstr "그 예나라는 여자애였어. 이미 그 문제는 내 선에서 해결했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 3fd8e458-7e8d-2d70-068d-9b140550bcfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Wyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:3fd8e458-7e8d-2d70-068d-9b140550bcfb
msgctxt "h1588a78eg8f46g40d6g8f22g716e346c27c4"
msgid "You - you killed Wyll?"
msgstr "너 - 네가 윌을 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 3fe0373a-3ef6-49f0-cc5e-f3cf699e087b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:3fe0373a-3ef6-49f0-cc5e-f3cf699e087b
msgctxt "hc1182d53gb192g4e2cga0fagf75681826627"
msgid "You're such a disappointment."
msgstr "너한텐 실망했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 4252168f-b644-b8d5-c4c4-433e6a372ea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:4252168f-b644-b8d5-c4c4-433e6a372ea2
msgctxt "hfce15e9dg2c83g4290gb0c3g41059733bc73"
msgid ""
"Will you watch when the others kill me? Will you hold my head back while "
"they cut my throat? Whisper goodbyes as I gasp and bleed?"
msgstr ""
"그럼 다른 놈들이 날 죽이는 걸 지켜볼 생각인가? 놈들이 내 머리를 자르기 좋게 목을 뒤로 젖혀주면서? 내가 피 흘리며 껄떡대고 죽어가는 "
"동안 작별 인사를 속삭이면서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 43a379ec-64ea-7201-ee9b-b5b3398870e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:43a379ec-64ea-7201-ee9b-b5b3398870e3
msgctxt "h012dfb18g405fg4febg869dg405f8be03e00"
msgid "The cult."
msgstr "교단이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 43da3e10-9519-6821-7905-9d5e9de1d383
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:43da3e10-9519-6821-7905-9d5e9de1d383
msgctxt "h2bd1f17agfdc0g439fgaf09g10fe8685c6ed"
msgid "Surviving what comes next."
msgstr "뭐든 다음에 닥쳐올 상황에서 살아남는 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 47e2b727-c3fb-fc90-b24d-6a46f0809e3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:47e2b727-c3fb-fc90-b24d-6a46f0809e3f
msgctxt "h83fb32f2g9c2fg4d8cgbbe3g4bbb509155f6"
msgid "You killed a child?"
msgstr "애를 죽인 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 509a4944-6ede-14df-af64-2c5ab1859e17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:509a4944-6ede-14df-af64-2c5ab1859e17
msgctxt "h698db528g6a1dg47daga994g50170be8b132"
msgid ""
"But the moment we were alone, she spouted some drivel about my integrity and "
"loyalty."
msgstr "하지만 단둘이 있게 되자마자, 내 진실성과 충성심에 대해 헛소리를 늘어놓기 시작했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 52c47fb5-1d32-7bf1-de07-fd35915db4dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Isobel = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Isobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:52c47fb5-1d32-7bf1-de07-fd35915db4dc
msgctxt "h8a1c2d93ge2e1g499fg8b72gccd476ea5669"
msgid ""
"That fawning cleric Isobel asked to speak with me alone. Told me her goddess "
"had asked her to extinguish me."
msgstr "그 알랑대는 클레릭 이소벨이 나와 단둘이 이야기 하고 싶다고 했어. 그녀의 신이 날 죽이라는 신탁을 내렸다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 563fe835-cb51-f554-6149-2072c51699f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:563fe835-cb51-f554-6149-2072c51699f1
msgctxt "hbd1cec8agc4b1g4df4g9051gd3e3a818522b"
msgid "Let's butcher them all - I've been waiting for an excuse."
msgstr "한 명도 남김없이 썰어버리자 - 핑곗거리가 필요했는데 잘 됐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 5995de01-a162-2357-b6e0-108688cb4cfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:5995de01-a162-2357-b6e0-108688cb4cfb
msgctxt "h7e72269ag90e1g4069g9e7eg032398ad515e"
msgid "My life is in danger. As I knew it would be the moment I joined you."
msgstr "내 목숨이 위험해졌어. 내가 너에게 합류한 순간부터 예상한 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 5fde86cf-938c-4d83-fb80-28360f682c29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Gale = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:5fde86cf-938c-4d83-fb80-28360f682c29
msgctxt "hd809c8c9gc14bg4336g891eg44b511ba15b4"
msgid "You - you killed Gale?"
msgstr "너 - 네가 게일을 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 61b26e5d-4026-4f18-6690-2c48df9a3573
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:61b26e5d-4026-4f18-6690-2c48df9a3573
msgctxt "h28baa81cg3e35g464cg94a4gc66fd28681b8"
msgid ""
"That is the correct course. I was prepared to convince you - I am glad I do "
"not have to."
msgstr "정답이야. 설득할 준비가 되어 있었는데, 그럴 필요가 없어서 다행이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 6228b8f1-2ac3-3187-cf38-940a419caae4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:6228b8f1-2ac3-3187-cf38-940a419caae4
msgctxt "ha4cb9cbag3119g4fe0gb39dgf390cb2f5dac"
msgid "Grim work. But it has to be done."
msgstr "끔찍한 일이군. 하지만 해야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 626192a8-9eaa-14b0-d176-c5fb02f92e55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:626192a8-9eaa-14b0-d176-c5fb02f92e55
msgctxt "h24b1b00cg3310g4b9ega324g0f037b334a6b"
msgid "Why should I trust you on this? You're a murderer!"
msgstr "내가 왜 널 믿어야 하지? 넌 살인자잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 66218cf3-a5c7-89de-5bf6-c4e8878b70c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:66218cf3-a5c7-89de-5bf6-c4e8878b70c0
msgctxt "hef802923g373eg4882g8884g74c604bd280a"
msgid ""
"First, we must dispose of the body. What comes next will be... <i>simpler</"
"i> if we don't arouse suspicions."
msgstr "먼저, 시체를 처리해야 해. 의심을 사지 않는다면 그 뒷일은 <i>쉬워</i>지겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 6765aaf7-d9aa-0102-259f-2dd0a5b2e77a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Wyll = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Wyll = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:6765aaf7-d9aa-0102-259f-2dd0a5b2e77a
msgctxt "h09ec579egc992g41e9ga81bg3821d410c1c0"
msgid ""
"Wyll asked to speak with me alone, and the moment my back was turned, he "
"tried to kill me."
msgstr "윌이 단둘이 이야기 할 것이 있다고 했는데, 등을 보이자마자 날 죽이려고 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 68c12f42-cf4d-ac30-edc8-9f613cca7b71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:68c12f42-cf4d-ac30-edc8-9f613cca7b71
msgctxt "h3d8c8fe8gec42g4550g9135g78684bf7c846"
msgid "Conspirators? Assassins? Listen to yourself, Minthara."
msgstr "음모라고? 암살자라고? 네가 무슨 말을 하는 건지 좀 들어 봐, 민타라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 6bed9eea-7879-8045-1e85-db820df91aa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:6bed9eea-7879-8045-1e85-db820df91aa5
msgctxt "hf0f3d302g0c3ag4dcag99d0gf664776c0a85"
msgid "He tried to kill me."
msgstr "그리고 날 죽이려 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 6cbee3ec-b2c9-f498-2f3c-8ece77ece2f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:6cbee3ec-b2c9-f498-2f3c-8ece77ece2f5
msgctxt "hd913bc36g7d0eg4918gb35cgb8cd9bab966b"
msgid "I will not apologise for defending myself."
msgstr "스스로를 방어한 것에 대해선 사과하지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 6f33aef7-0df2-0478-e5e6-79837e660f4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:6f33aef7-0df2-0478-e5e6-79837e660f4c
msgctxt "h29aca1ddg43a0g4103ga474gc90a0e705db3"
msgid "Good. Nobody saw you arrive - that will be to our advantage."
msgstr "좋아. 아무도 네가 오는 걸 보지 못한 것 같군. 이건 분명 이점이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 722ad8c7-a8d1-8c74-c784-4e248d6b7d73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:722ad8c7-a8d1-8c74-c784-4e248d6b7d73
msgctxt "ha733ca22g2d24g4204g9fd4g5d4ee280171a"
msgid ""
"Pathetic. You don't negotiate with people who wish you dead. You <i>kill "
"</i>them."
msgstr "한심하긴. 네 죽음을 바라는 자들과는 협상하려 들지 마. 유일한 방법은 놈들을 싹 다 <i>죽여버리는</i> 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 798705aa-32d6-a025-194b-ecb4aa045d8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Astarion = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Astarion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:798705aa-32d6-a025-194b-ecb4aa045d8c
msgctxt "h6e935a17gd68cg4b2bg8d87g10c64e5112ef"
msgid ""
"The vampire asked to speak to me alone. Accused me of being a threat to your "
"wellbeing, if you can believe it."
msgstr "그 뱀파이어가 단둘이 이야기할 것이 있다고 했어. 그러고는 내 존재가 네 목숨에 위협이 된다고 하더군. 말이 되는 소릴 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 7bb537a9-44d6-dc43-8adb-278fcb64a13a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Jaheira = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:7bb537a9-44d6-dc43-8adb-278fcb64a13a
msgctxt "h5e69e264g4d07g42edgbf92gb510a3ebe379"
msgid "You - you killed Jaheira?"
msgstr "너 - 네가 자헤이라를 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 80b220e7-388b-a287-2cb0-b35b9ddc761d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Minsc = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Minsc = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:80b220e7-388b-a287-2cb0-b35b9ddc761d
msgctxt "h3cc1afdfg447fg43a0ga248gf63aa51b121e"
msgid ""
"Minsc asked to speak to me alone - I expected his usual righteous drivel. "
"Annoying, but harmless."
msgstr "민스크가 단둘이 이야기할 게 있다고 하더군. 평소대로 도덕적인 헛소리를 할 거라 예상했어. 짜증 나지만 무해한 헛소리."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 80b27924-01ea-c12a-319b-a66884139cc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Karlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:80b27924-01ea-c12a-319b-a66884139cc6
msgctxt "hd088e9a4geee2g4a2cg91dbgf8c68cc4e40c"
msgid "You - you killed Karlach?"
msgstr "너 - 네가 칼라크를 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 817ec2f8-e468-2ca3-4841-599434239856
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:817ec2f8-e468-2ca3-4841-599434239856
msgctxt "haddab5f6ga4b9g4e19g8131g83200ac767b9"
msgid ""
"I overpowered her, of course. A thief I can tolerate, but under duress she "
"admitted to being a spy."
msgstr "물론 완전히 제압했지. 도둑질은 용서할 수 있지만, 조금 추궁하니 자기가 첩자라고 자백하더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 82b231f5-77d8-2a7c-1296-2e12b3b0d28c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:82b231f5-77d8-2a7c-1296-2e12b3b0d28c
msgctxt "h0491185cg63dbg44daga275gaf623214fdbd"
msgid "They plan to attack our camp. Tonight."
msgstr "놈들이 우리 야영지를 공격할 계획을 세웠어. 오늘 밤이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 87807d63-0b75-98ab-edce-d6e1e48c3633
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:87807d63-0b75-98ab-edce-d6e1e48c3633
msgctxt "h7dcb428fgaae9g4216gb5a0gd8e6a1f8bfd7"
msgid "We need to kill them all."
msgstr "싸그리 죽여버려야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 8b74d32f-3cad-51b3-c009-6b5c242d0ba9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:8b74d32f-3cad-51b3-c009-6b5c242d0ba9
msgctxt "h12ca0d75gd397g475cg9bb5gcae166d1314c"
msgid "I may have been too late. She already reported to her superiors."
msgstr "너무 늦었을지도 몰라. 이미 상부와 연락을 취한 것 같거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 8da11124-544e-34a0-2d96-b0c07f127581
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:8da11124-544e-34a0-2d96-b0c07f127581
msgctxt "hc58ad70cge334g4ec6g97b6g980e8515ec93"
msgid "Who do you think sent them?"
msgstr "누가 보냈다고 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 915a62f1-a243-cd2e-094b-b6b67f566a75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Nightsong = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Nightsong = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:915a62f1-a243-cd2e-094b-b6b67f566a75
msgctxt "h1215dc7cgd250g4390gbe9bg28b45dba122f"
msgid ""
"The aasimar asked for a word in private. I find her sanctimony irritating, "
"but I agreed to speak with her."
msgstr "그 아시마르가 개인적으로 말할 게 있다고 하더군. 짜증 날 정도로 거만한 태도였지만, 일단 그러기로 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 934803e9-e908-a8f2-abc7-18c12f5a63fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Astarion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:934803e9-e908-a8f2-abc7-18c12f5a63fe
msgctxt "he705c88cg6e11g4728ga443ga877e0c41d30"
msgid "You - you killed Astarion?"
msgstr "너 - 네가 아스타리온을 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 938350bb-b1c0-e6ce-cdbc-6542c3feb175
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:938350bb-b1c0-e6ce-cdbc-6542c3feb175
msgctxt "h847e03f0g7469g4e9eg93dcg4fd0d20ac100"
msgid "Idiot. Think with your brain, not your groin for once."
msgstr "바보 같긴. 한 번쯤은 좆 말고 뇌로 생각을 해보는 게 어때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 94e1e6ee-cd8f-d6bc-ddd8-3fb102a1c819
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:94e1e6ee-cd8f-d6bc-ddd8-3fb102a1c819
msgctxt "h83523d17gf285g45f9g9735g8926d2cd5dea"
msgid "I welcome you into my camp, and <i>this</i> is how you repay me?"
msgstr "내 야영지에 들여보내 줬더니, 그 보답을 <i>이런 식으로</i> 하는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 954f0c6f-a9e8-7d5e-1003-567020f9aa44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:954f0c6f-a9e8-7d5e-1003-567020f9aa44
msgctxt "h97dc2db1g42dbg4991gb4a1g783605581318"
msgid "Are we playing hide and seek?"
msgstr "숨바꼭질 하는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = 96d2193c-e9d1-e1be-3c0d-b22f15e40903
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:96d2193c-e9d1-e1be-3c0d-b22f15e40903
msgctxt "h4f6d333cgc634g4b77g80bdg9f330ed11b2e"
msgid "I don't want to be an accessory to child murder."
msgstr "어린애를 살해하는 데 엮이고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 9c60cc8e-0889-40f5-8702-b61297bb8d21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:9c60cc8e-0889-40f5-8702-b61297bb8d21
msgctxt "h3366455cg290bg41afg875cg4d2fb9c08eda"
msgid "We must not rest tonight. We must lie in wait for them."
msgstr "오늘 밤은 쉬어선 안 돼. 숨죽이고 놈들을 기다리자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = a084d843-b483-9b9f-bf94-a2733629bfb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Nightsong = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:a084d843-b483-9b9f-bf94-a2733629bfb8
msgctxt "hf69ce52bgcdc3g4449ga13bgb8e53b5cc1ef"
msgid "You - you killed Aylin?"
msgstr "너 - 네가 에일린을 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = a1b3d79e-6dab-1e80-a201-875e70bbbcbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:a1b3d79e-6dab-1e80-a201-875e70bbbcbf
msgctxt "hed0f2f99g84e4g4990gae18g7c33956d6766"
msgid ""
"Our relationship disturbs them. It is not only me they conspire to "
"assassinate. They will kill us both."
msgstr "우리 관계가 심기를 불편하게 한 거야. 그놈들이 암살하려고 했던 건 나뿐이 아니라, 우리 둘 다였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = ad414811-cef6-8378-a1bd-eb04fded4720
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:ad414811-cef6-8378-a1bd-eb04fded4720
msgctxt "h9b2be066ge069g4c2fg88e7g5c265a80077c"
msgid "Good work. Our camp is in safe hands with you."
msgstr "잘했어. 덕분에 우리 야영지가 안전해졌군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = b09fe89d-0da8-be48-1acb-a7a8dbc5721a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:b09fe89d-0da8-be48-1acb-a7a8dbc5721a
msgctxt "h0cfa5be5g6879g4c25g86cfg841021373b0b"
msgid "I only kill when it is necessary. This was necessary."
msgstr "난 필요할 때만 살인을 해. 이건 필요한 일이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = b22ae973-90f9-a80e-2666-659f46b0b0fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:b22ae973-90f9-a80e-2666-659f46b0b0fa
msgctxt "hb0c10f82gd8e7g46e8g933bg0ef09f9a526f"
msgid ""
"She was confused. Said the gods had a plan for her, and that I was a threat "
"to it."
msgstr "혼란스러워 보였어. 신들이 그녀를 위한 계획을 세웠는데, 내가 그 계획에 위협이 된다고 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = b71874b9-015a-89c5-4bef-1a076bf04f9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:b71874b9-015a-89c5-4bef-1a076bf04f9d
msgctxt "h7d7dfcb1g04adg45d8g8d15g064419c6c027"
msgid "And then she tried to kill me."
msgstr "그리고 날 죽이려 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = b94d1d8f-60f8-b54a-bd26-4d133237eec8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:b94d1d8f-60f8-b54a-bd26-4d133237eec8
msgctxt "hb31d8407g3de2g4e65g936agc1ca16a759c9"
msgid "But this time was different. He tried to kill me."
msgstr "하지만 이번엔 달랐어. 그가 나를 죽이려 들었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = b9fcc776-6d49-e2da-87b6-477956155104
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:b9fcc776-6d49-e2da-87b6-477956155104
msgctxt "h24bbc17bg298eg413dg97e2gd7fa5e19985a"
msgid "And then she tried to kill me."
msgstr "그리고 날 죽이려 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = bc6fe0ef-d305-f92e-e79a-cf08f7532a4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:bc6fe0ef-d305-f92e-e79a-cf08f7532a4b
msgctxt "h5d7e4140gfbebg48efgbd17gfd939dbfdd8e"
msgid "You're covered in gore. More so than usual."
msgstr "피투성이잖아. 평소보다 더 심각해 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = bdae5721-70c0-3b3c-9b3a-168e9ab9e542
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:bdae5721-70c0-3b3c-9b3a-168e9ab9e542
msgctxt "h7eb7739cgd627g4a66g94a6g49435b64c474"
msgid "How do you know they were a spy?"
msgstr "어떻게 첩자라는 걸 알아챈거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = be7fe4ae-0f62-8b5a-a5f0-34ab24459027
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:be7fe4ae-0f62-8b5a-a5f0-34ab24459027
msgctxt "hb4c18eddg3740g499eg8c75g00c8536918de"
msgid "The cult plan to attack our camp. Tonight."
msgstr "교단이 우리 야영지를 공격할 계획을 세웠어. 오늘 밤이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = c08e1df6-9889-56eb-cae7-47f342c9c251
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_KillDirectorGortash_Knows_CampCompromised = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:c08e1df6-9889-56eb-cae7-47f342c9c251
msgctxt "hd3ac3133g02a5g4e0bgbce4gd1d362ec5063"
msgid "I think Orin is behind this - she may have infiltrated our camp."
msgstr "오린이 배후에 있는 것 같아. 그녀가 우리 야영지에 잠입한 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = c34d1743-6ee0-de5b-91ca-96d16b04ce6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:c34d1743-6ee0-de5b-91ca-96d16b04ce6e
msgctxt "h85ff6a8eg9c06g4c90g9e72g63183935c65a"
msgid "You made this mess. You're on your own."
msgstr "네가 이 난장판을 만들었잖아. 혼자 해결해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = c44c5a6c-8773-a140-280f-253a23b0b68e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:c44c5a6c-8773-a140-280f-253a23b0b68e
msgctxt "hdc9bdf2dg659fg4921g9571g77dbfdfafb97"
msgid "This threat has been with us since Moonrise."
msgstr "위협은 문라이즈에서 부터 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = c4c0b4af-d25c-12e2-46ab-1ca4139f3a28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:c4c0b4af-d25c-12e2-46ab-1ca4139f3a28
msgctxt "h21d86b4fg2b68g4ae3ga6b7ge8772d034c91"
msgid "Whatever her crimes, I can't abide the murder of a child in our camp."
msgstr "그녀가 무슨 죄를 지었든 간에, 우리 야영지에서 아이를 죽이는 건 용납할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = c541d4ef-a2e4-2cb8-0947-0c06538fae61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:c541d4ef-a2e4-2cb8-0947-0c06538fae61
msgctxt "h15d089adg7b7ag435egaf85gf867369733a1"
msgid "I don't understand. Why would anyone try to kill you <i>now</i>?"
msgstr "이해가 안 되는군. 왜 <i>지금</i> 널 죽이려 하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = cb97c0bb-86fd-d867-79a3-cb92c8e04377
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:cb97c0bb-86fd-d867-79a3-cb92c8e04377
msgctxt "hc48a73dcg9ca4g4c31g8d7cg6130f65e691a"
msgid "My proof lies beneath that blanket."
msgstr "그 증거는 담요 아래에 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = cc1c7e69-de82-aa78-a885-d85465a7b060
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Gale = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Gale = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:cc1c7e69-de82-aa78-a885-d85465a7b060
msgctxt "hb901115cgf8f3g4912gb968g3e8ad518c2e8"
msgid ""
"Gale asked to speak with me alone, and the moment my back was turned, he "
"tried to kill me."
msgstr "게일이 단둘이 이야기 할 것이 있다고 했는데, 등을 보이자마자 날 죽이려고 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = cd934d98-18f5-1d16-a0e1-668111700bdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:cd934d98-18f5-1d16-a0e1-668111700bdf
msgctxt "h92449412g3c62g4d17g8bfbgd83a1bac500c"
msgid "Our advantage for what?"
msgstr "무슨 이점?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = d04823f1-b6fa-eb97-a3c9-683e184239d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:d04823f1-b6fa-eb97-a3c9-683e184239d2
msgctxt "h6921813egcf02g4de6gbbecg88924a53ab56"
msgid "Definitely dismemberment."
msgstr "무조건 해체로 간다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = d26a19d3-1a5e-abfa-def0-71228c834a11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Shadowheart = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:d26a19d3-1a5e-abfa-def0-71228c834a11
msgctxt "h1aaebafeg8ac9g45cfga20fg4a431c55082f"
msgid "You - you killed Shadowheart?"
msgstr "너 - 네가 섀도하트를 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = d2ec9b4b-d42f-48a4-d886-49606d019cf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Ravengard = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:d2ec9b4b-d42f-48a4-d886-49606d019cf7
msgctxt "h5686f457g63f6g4353ga175g61f034cb116c"
msgid "You - you killed Ravengard?"
msgstr "너 - 네가 레이븐가드를 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = d4a8b7a6-e1c9-d64c-4d10-3667f5627b5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Jaheira = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Jaheira = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:d4a8b7a6-e1c9-d64c-4d10-3667f5627b5b
msgctxt "h18cf59adgea92g4810gbd0agfb83fde79e8e"
msgid ""
"Jaheira took me to one side - told me the whole party are against me. That "
"she was the only one bold enough to do what needed to be done."
msgstr ""
"자헤이라가 한쪽으로 날 데려가더니 파티 전원이 나에게 반대한다고 했어. 그리고 그녀가 해야 할 일을 할 용기가 있는 유일한 사람이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = d505a6a9-8f27-416c-0b03-e2b5fcc82289
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:d505a6a9-8f27-416c-0b03-e2b5fcc82289
msgctxt "hfe7e7e28g5ff1g4961g9568gdbf8e3ac6f39"
msgid ""
"Opportunism. My guard was down. It was the first time - it will be the last."
msgstr "기회를 잡은 거지. 내 경계가 풀어져 있었으니까. 처음이자 마지막이 될 테지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = d84383d2-18cd-ecdc-dc41-713f3a6ff565
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:d84383d2-18cd-ecdc-dc41-713f3a6ff565
msgctxt "h6ab6bd9egc102g49d1g8f97gc526155e1482"
msgid "All I had to do was twist my knife."
msgstr "난 그저 내 단검을 조금 비틀어 줬을 뿐인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = dca91c25-161d-5d95-27c1-3b6bda517cd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:dca91c25-161d-5d95-27c1-3b6bda517cd1
msgctxt "hd8f600c2g3816g496bgb0a7g5ee31bf38d69"
msgid "You killed Yenna?"
msgstr "예나를 죽인 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = dcb5028c-22f9-9be0-b7df-bad54359585f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:dcb5028c-22f9-9be0-b7df-bad54359585f
msgctxt "ha115d75dg73cfg4691g9d22g03ea314489bf"
msgid "Now we are both in danger."
msgstr "이제 우리 둘 다 위험해졌군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = dda5b21e-5b04-adb3-cf86-9ca2b00fc42c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:dda5b21e-5b04-adb3-cf86-9ca2b00fc42c
msgctxt "h6589bab1g45d4g4f3aga05dg0efd78daf1d2"
msgid "Tempting tempting tempting. But not yet. Not yet."
msgstr "솔깃해 솔깃해, 아주 솔깃한 이야기야. 하지만 아직은 아니야. 아직은."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = de7c6e7c-f2e5-5e28-43bc-c2744c6fb908
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:de7c6e7c-f2e5-5e28-43bc-c2744c6fb908
msgctxt "h5d0ec11eg3459g4e11gbc29g1ad1bab71937"
msgid "You really are wonderful."
msgstr "넌 정말로 멋진 사람이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = e289ca5d-24c7-ffaa-38bb-f36cdd4b5790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:e289ca5d-24c7-ffaa-38bb-f36cdd4b5790
msgctxt "h1c352f90g3277g4fafga169gdb7720d7c82a"
msgid "I'm sorry, Minthara. I thought you would be safe here."
msgstr "미안해, 민타라. 여기서라면 네가 안전할 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = e2e0442f-cf17-ebc5-f6c7-35fd4a476c79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:e2e0442f-cf17-ebc5-f6c7-35fd4a476c79
msgctxt "hfa055646gd712g412dga61eg16259344b5aa"
msgid ""
"You are not to blame. It is easy for one who has lived a coddled life to "
"mistake my caution for paranoia."
msgstr "네 잘못이 아니야. 응석받이로 자란 사람은 내 조심성을 편집증으로 착각하기 쉽거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = e3291171-d3cc-ba04-9d51-e249f41418de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:e3291171-d3cc-ba04-9d51-e249f41418de
msgctxt "hd9d6d385g7448g425dgaaa5g32df6cf9e419"
msgid "I knew you couldn't wait to get me alone again."
msgstr "또 단 둘이 있고 싶어서 안달이 났구나, 알았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = e377dc9d-7126-5a36-45aa-bf20b55b8b04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:e377dc9d-7126-5a36-45aa-bf20b55b8b04
msgctxt "h68487816g1ed6g413dg92feg159998813314"
msgid "You. This way. Quickly. Eyes down."
msgstr "너. 이리 와. 빨리 움직여. 눈은 바닥에 두고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = f0120a09-2c27-e9c9-5fb5-9f746c504a0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:f0120a09-2c27-e9c9-5fb5-9f746c504a0a
msgctxt "h375b4865g706ag4b33ga32ag0c5e5b36ca08"
msgid "Naturally, he didn't stand a chance. I dealt with him."
msgstr "당연하게도, 그에겐 승산이 없었어. 내가 처리했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = f0d5ec70-a756-55ea-7a78-d6d48f9d9325
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Yenna = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Yenna = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:f0d5ec70-a756-55ea-7a78-d6d48f9d9325
msgctxt "h586d2fa8gb50eg4ab7gb94cgb89dead40ca9"
msgid ""
"I caught the girl, Yenna, rifling through my belongings. When I confronted "
"her, she pulled a knife on me."
msgstr "예나 그년이 내 소지품을 뒤지는 걸 봤어. 이야기를 좀 하려 했더니, 칼을 꺼내 들더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Player
#. NodeID = f19023f3-7b22-3c62-45ae-23b64a5caa11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsChosen_Laezel = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:f19023f3-7b22-3c62-45ae-23b64a5caa11
msgctxt "hccca98a5g3e06g4a3ag8567gb0a9c988dfa9"
msgid "You - you killed Lae'zel?"
msgstr "너 - 네가 레이젤을 죽였다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = f60449ae-ceb1-c790-e8d1-1bfe4607b2cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:f60449ae-ceb1-c790-e8d1-1bfe4607b2cd
msgctxt "haa38227fg6a0fg4a0egaadag5116fd4b0d97"
msgid "Observant as ever."
msgstr "언제나처럼 예리하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = f74363f3-4071-a70e-97f9-883163b2c9da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:f74363f3-4071-a70e-97f9-883163b2c9da
msgctxt "h7cbd9cffgcfa5g4bd8gadb7g2b8c4bffc358"
msgid ""
"You could stick me through the heart. Stick <i>her</i> through the heart. "
"Cut us to bits."
msgstr "내 심장에 쑤셔버려도 좋아. <i>그녀의</i> 심장을 쑤셔도 좋고. 우릴 도륙내도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = f8a83c19-6663-8946-9120-6d2243acb34b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:f8a83c19-6663-8946-9120-6d2243acb34b
msgctxt "h2659be57g045eg4282ga777gd0b1aedc85d0"
msgid "The others have despised my presence here since I joined you."
msgstr "다른 놈들은 너에게 합류한 날 이래로 나를 경멸해 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = f94ad894-bf64-1649-d410-ca734a484707
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Karlach = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Karlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:f94ad894-bf64-1649-d410-ca734a484707
msgctxt "ha30c0b98gefe9g4bf3g8137g574b52217db1"
msgid ""
"That brute Karlach asked to speak to me alone. Told me I was no better than "
"the devils who once imprisoned her."
msgstr "그 양아치 칼라크가 단둘이 이야기 할 것이 있다고 했어. 나에게 전에 그녀를 가뒀던 데빌과 별다를 게 없다 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = fa650a5a-52c6-7d87-4520-fece22ce546f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:fa650a5a-52c6-7d87-4520-fece22ce546f
msgctxt "h22217187g7e05g41fcga4d4g2e18257ec8d4"
msgid ""
"First, we must dispose of their little spy. Burial or dismemberment. Either "
"will suffice."
msgstr "먼저, 이 작은 첩자를 처리해야 해. 매장하거나 해체하거나. 둘 중 하나면 충분하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = fbfa00c6-deaf-d141-50d9-18a2313a5ac8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_MintharaAbduction_IsAvailable_Shadowheart = True
#. SetFlags:
#.   Global:
#.     - LOW_BhaalTemple_MintharaAbduction_IsChosen_Shadowheart = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:fbfa00c6-deaf-d141-50d9-18a2313a5ac8
msgctxt "hbf1577b6g66a7g4690ga15bg828714693395"
msgid ""
"Shadowheart came to me, flashing those puppy-dog eyes. Asked for my counsel, "
"in private."
msgstr "섀도하트가 그 강아지 같은 눈을 하고 와선, 다른 사람이 없는 곳에서 조언을 구하고 싶다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = ff91193f-2f9f-d5ee-50ff-ad74ddc740ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Minthara:ff91193f-2f9f-d5ee-50ff-ad74ddc740ab
msgctxt "h8e13c4aage7bdg4645gbb8eg400cf10f8b89"
msgid ""
"When the body is hidden, we wait until the dead of night, and kill the "
"others as they sleep."
msgstr "시체를 숨기고 나면, 밤이 오는 걸 기다려서, 다들 잠에 들면 편하게 보내주자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 017f1325-d8c5-cf16-cfa8-66f7b15dfebd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:017f1325-d8c5-cf16-cfa8-66f7b15dfebd
msgctxt "h475cbc66gef07g4a00gbc03geec2f5abd5de"
msgid "No one ever cares about me like that. Not since my mum."
msgstr "저를 그렇게나 신경써주신 분, 엄마 말고는 없었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 01ebd5f7-2d25-b93d-3379-985192bb69d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:01ebd5f7-2d25-b93d-3379-985192bb69d7
msgctxt "h2a90046ag9a4eg49fcga062g0bb9a8a22216"
msgid "You know why? Because I put in my <i>secret </i>ingredient."
msgstr "왜 그런 줄 아세요? 왜냐면 저만의 <i>비밀</i> 재료가 들어갔거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 032175ff-f307-ec1d-b5ab-810fb81db9da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:032175ff-f307-ec1d-b5ab-810fb81db9da
msgctxt "hdaae787egc66bg4390g81b9g249132f19d6d"
msgid "Did - did I do something wrong?"
msgstr "제가 잘못한 게 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 0cca2563-0630-2d43-7a06-d88415d44674
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:0cca2563-0630-2d43-7a06-d88415d44674
msgctxt "h78f97b61g35f8g4469g9711g2ef43dbabe31"
msgid "It's not mediocre! You - you haven't even tried it!"
msgstr "그저 그런 요리가 아니에요! 아직 맛도 안 봤잖아요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 0ef4fc45-6799-0434-9951-65b28bbdebb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:0ef4fc45-6799-0434-9951-65b28bbdebb8
msgctxt "h76f4009dg1010g4e40g9bc3g3062fb07e340"
msgid "She used to work in the kitchens at some fancy noble's house."
msgstr "어느 호화로운 귀족 집 주방에서 일하셨지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 1037c167-ca2e-cf61-86c3-40e1b50c69af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:1037c167-ca2e-cf61-86c3-40e1b50c69af
msgctxt "h2e7b1619g760dg4ca2gbd61g2e2a872ff61a"
msgid "Such a sweet little kitten. Oh how it <i>screamed</i>."
msgstr "참 어여쁜 고양이였는데. 어찌나 <i>비명을 질러대던지</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 124f320e-b0e7-c0ef-cda3-c0b161364a88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:124f320e-b0e7-c0ef-cda3-c0b161364a88
msgctxt "hc6906b89g7e4bg4bd4gb3dbge5a2d8fd8e0a"
msgid "Fine. I'll eat it."
msgstr "알았어. 먹을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 16f55931-be17-6c29-6591-7a80e93f1632
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:16f55931-be17-6c29-6591-7a80e93f1632
msgctxt "h33dd6871gcdeeg44f9ga039gd784f0a9d417"
msgid "It has? You're not just making it up?"
msgstr "자리가요? 방금 지어내신 게 아니라요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 1981075d-f0df-b26d-2169-99e734405a06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:1981075d-f0df-b26d-2169-99e734405a06
msgctxt "h88b6f347gfa63g4993ga7c4g9dfafdc66ad4"
msgid "<i>Taste the meal.</i>"
msgstr "<i>한 입 먹어본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Narrator
#. NodeID = 1eaf1392-0bd5-56a0-abc5-c09cdc869ced
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_OrinAbduction_CFM_Yenna_IdentifiedMeat(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:1eaf1392-0bd5-56a0-abc5-c09cdc869ced
msgctxt "h7dc5f2aegbdbag4106g8b49g5d59c6034cc3"
msgid ""
"*The herbs and spices are ones you recognise, staples in Baldurian cuisine. "
"But the meat itself is unusual - gamey, tough, with a distinctly <i>feline</"
"i> quality.*"
msgstr ""
"*허브와 향신료는 당신이 알고 있는, 발더식 요리에서 흔히 쓰이는 것들입니다. 하지만 고기가 이상합니다. 누린내가 나고, 질기며, 뚜렷한…"
" <i>고양이의</i> 질감이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 22a4b133-97a4-5e7a-fbda-3ab030570410
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_HasMet = True
#.      - CAMP_Yenna_State_MovedToCamp = False
#.      - GLO_OrinsAbduction_State_AbductionOccured_Elfsong = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:22a4b133-97a4-5e7a-fbda-3ab030570410
msgctxt "hdeb6dc13gee01g4cdbgb11fgdf86e8023666"
msgid "I made myself clear. You're not welcome here."
msgstr "내 끼니는 내가 알아서 해. 여긴 들어오지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 29e507bd-6755-3123-c7b2-bfb8c785b29f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:29e507bd-6755-3123-c7b2-bfb8c785b29f
msgctxt "h6b9e99b1g4b0cg4ffdg9fcdgfe257fec3253"
msgid "You don't need to prove anything. You're welcome here."
msgstr "아무것도 증명할 필요 없어. 편히 지내."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 36b1316f-0c81-78e6-f929-0d0e22f43728
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:36b1316f-0c81-78e6-f929-0d0e22f43728
msgctxt "hdbfe5b0cgf482g4f83gb141g39ab43481cc2"
msgid ""
"Argh! You're here. I know you don't know me very well, but please - give me "
"a chance."
msgstr "앗! 여기 계셨군요! 저를 잘 모르신다는 건 알지만, 그래도 제게… 기회를 주실래요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 3abc451f-874c-aaee-7737-05df68a97d4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:3abc451f-874c-aaee-7737-05df68a97d4d
msgctxt "h2e8add7dgea34g43f6g8fe3g7cbc5efc94dc"
msgid "It's called Heap Gate Mess. A Baldur's Gate classic."
msgstr "힙 게이트 꼬치구이에요. 발더스 게이트 최고의 음식이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 3d67e9d6-82f5-48fb-3bc3-b2e143a2f1d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:3d67e9d6-82f5-48fb-3bc3-b2e143a2f1d2
msgctxt "hb8e1edd0g328fg4264g8f06g9fe916b04c24"
msgid "<i>Worry why you recognise it.</i>"
msgstr "<i>내가 이 맛을 어떻게 알고 있는 거지?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 4644de8a-b9f5-1e64-d1c5-0d750943d9a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:4644de8a-b9f5-1e64-d1c5-0d750943d9a3
msgctxt "h218c4322gc7d9g4693g9efdg45335c08e636"
msgid ""
"I- I know it won't be good like she used to do. But I think I remembered "
"everything."
msgstr "어… 엄마가 했던 것만큼 맛있지는 않겠지만, 이렇게 요리하는 게 맞았던 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 48f6fbe3-adb0-5d40-192c-dbb8d5d797a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_OrinsAbduction_State_AbductionOccured_Elfsong = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:48f6fbe3-adb0-5d40-192c-dbb8d5d797a6
msgctxt "h4c5a503eg5fe8g4c49gad34g7944969f96cc"
msgid "You're up to something. Go on - spit it out."
msgstr "너 뭔가 꿍꿍이가 있지? 어디 말해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 4c7b05a2-2153-ffb8-89fd-d28e6dd4c2a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:4c7b05a2-2153-ffb8-89fd-d28e6dd4c2a7
msgctxt "hb70fdfadg4c2bg4ab6g94afg2eeeee2f2d49"
msgid "You're in luck! A position has just opened up."
msgstr "너 운 좋구나! 마침 자리가 하나 났거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 4c9eccbf-ca5e-8a57-320b-49dfb3b2f53e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:4c9eccbf-ca5e-8a57-320b-49dfb3b2f53e
msgctxt "h8bf7b2e3g9ed7g4963g8b7eg778d36e89436"
msgid "Smells delicious. What is it?"
msgstr "냄새 좋은데. 이건 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 5094c20e-da3d-f45f-0e0c-8ed794f1767e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_OrinsAbduction_State_AbductionOccured_Elfsong = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:5094c20e-da3d-f45f-0e0c-8ed794f1767e
msgctxt "he4b94e36ga02fg4dcbgab7fgc9211f2ebd60"
msgid "Get the hells out of here."
msgstr "저리 꺼져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 529d15c7-3ea8-843e-101c-55b33561e3c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_State_MovedToCamp = True
#.      - GLO_OrinsAbduction_State_AbductionOccured_Elfsong = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:529d15c7-3ea8-843e-101c-55b33561e3c9
msgctxt "hb9ca3a2fg7458g4183gbdcfg6ec87595df62"
msgid "What have I done to earn this?"
msgstr "뭐 이런 걸 다?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 529f3177-157a-ca76-d3d0-c60022d4e68c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:529f3177-157a-ca76-d3d0-c60022d4e68c
msgctxt "h7d0f487dg074cg499ag8a48gec3be42af1da"
msgid ""
"Well, um, I can sew a little bit. And, um, I know most of the letters for my "
"writing."
msgstr "그, 음… 바느질도 조금 할 줄 알고, 또, 음… 글 쓰는 데 필요한 글자들도 대부분 알아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 5bc98420-737d-419e-9655-224b1e7b1f48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:5bc98420-737d-419e-9655-224b1e7b1f48
msgctxt "h133df129g8b48g45e9gac84g9334faa423e7"
msgid "A bit of salt on the top and -"
msgstr "소금 약간을 위쪽에 뿌리고…"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 5f0da5d3-7f71-feea-6948-b6fe87a9becc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:5f0da5d3-7f71-feea-6948-b6fe87a9becc
msgctxt "h456c7e7bga05ag45caga377g059e12d7eaba"
msgid "See. It's good, right?"
msgstr "어때요. 맛있죠, 맞죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 601c320f-000b-cb38-6188-1512811107c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:601c320f-000b-cb38-6188-1512811107c8
msgctxt "hd70a9463g4188g4259g97b1g7abd379f5ec5"
msgid "Too right. No way I'm eating that."
msgstr "어쩌라고. 저딴 건 안 먹어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 65028ce5-3a71-225f-746e-e71db6e35ddd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:65028ce5-3a71-225f-746e-e71db6e35ddd
msgctxt "hb612ba58gfbc4g42a3g8e92g8cd70d90d29a"
msgid "<i>Take the food. Throw it away.</i>"
msgstr "<i>음식을 집어 저 멀리 던져버린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 6b8da8d5-8ff8-5abc-2bfb-cd97c09ce947
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:6b8da8d5-8ff8-5abc-2bfb-cd97c09ce947
msgctxt "hbd27eb3cge6ccg4676g80dag07f36fbadc47"
msgid "I'd rather not find out, to be honest."
msgstr "솔직히 별로 알고 싶진 않네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 6c6fa2f1-7ecf-a446-6daf-5f790c2ba2ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:6c6fa2f1-7ecf-a446-6daf-5f790c2ba2ea
msgctxt "h5df07278gdf50g4741g959fgf10e09b81eca"
msgid "I think cooking is really my main talent."
msgstr "요리에는 자신이 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Narrator
#. NodeID = 6c9e0eb0-8429-0848-4fd1-5d50c7b1b50b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:6c9e0eb0-8429-0848-4fd1-5d50c7b1b50b
msgctxt "h7629795cg9741g48d7g9f04g77fb0149f278"
msgid ""
"*You taste nothing out of the ordinary - the herbs and spices sold by any "
"market trader.*"
msgstr "*특별한 점을 찾지 못합니다. 어디서나 쉽게 구할 수 있는 허브와 향신료 같군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 6da776c9-81bc-9b30-1981-5cc9baf78d1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:6da776c9-81bc-9b30-1981-5cc9baf78d1a
msgctxt "hd7aaab20g554bg4ddaga02ag3dea71969e99"
msgid ""
"Oh, thank you! Thank you! You won't regret this. I'll - I'll be the best "
"cook you ever had."
msgstr "와, 감사해요! 진짜로요! 실망시켜 드리지 않을게요. 최고의 요리사가 되어 드릴게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 6fe0ba54-4ce7-afd8-873f-606a42a0bd14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:6fe0ba54-4ce7-afd8-873f-606a42a0bd14
msgctxt "h63823aaag2857g4ce2g960dg15294ec05230"
msgid ""
"It took me hours to chop the little vegetables and get the meat roasted "
"right. And now you won't even try it..."
msgstr "채소 썰고, 고기 굽느라 몇 시간이 걸렸는데... 근데 한 입도 안 드신다니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 71621d46-4df8-8665-3a19-18c499d4d2bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:71621d46-4df8-8665-3a19-18c499d4d2bb
msgctxt "h1246d7c4gf172g404cgbcb7g7eab2870d4ed"
msgid "One mediocre meal isn't enough to earn a place in my camp."
msgstr "내 야영지에서 한 자리 구하려면, 그저 그런 요리 하나로는 부족하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 71aa805d-59fd-44ea-9648-d9e993e0b580
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_HasMet = True
#.      - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:71aa805d-59fd-44ea-9648-d9e993e0b580
msgctxt "hb75cd3a1gf73ag4a50g980fg611a9328b469"
msgid "Argh! You're here. I'm not ready. I mean, I think I'm ready."
msgstr "앗! 여기 계셨군요! 준비 안 됐어요. 아니… 준비된 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 72a6db8b-6a5b-d19f-9cf6-294cc10e8b35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:72a6db8b-6a5b-d19f-9cf6-294cc10e8b35
msgctxt "hd298bb61g55dfg4e35gb317g58ec7018c58d"
msgid "I put in some bits from your supplies. I hope you don't mind."
msgstr "야영지에 있는 재료를 조금 썼어요. 화는 내지 말아주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 7b794d3c-6991-d7ed-86eb-380f7ed77c32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:7b794d3c-6991-d7ed-86eb-380f7ed77c32
msgctxt "h6b4c5264gb574g4154g950egaa62df2f4681"
msgid "You let me stay, when I didn't have nowhere else to go."
msgstr "갈 곳 없는 저를, 여기 머무르게 해주셨잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 7bb39e4e-aaf4-dfa1-97ba-6744d3ee6dda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:7bb39e4e-aaf4-dfa1-97ba-6744d3ee6dda
msgctxt "hd9beca81gfc6eg4c78gb9c0ge8dedc957bec"
msgid ""
"I - I thought you'd be hungry, so I made this for you. My mum's favourite "
"recipe."
msgstr "그… 배고프실 것 같아서, 이걸 만들었어요. 엄마가 제일 좋아하던 레시피로요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 7eef188b-4665-f15d-6910-c9fc0e83dac2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:7eef188b-4665-f15d-6910-c9fc0e83dac2
msgctxt "hfd3df5bcg52b0g4220g94f1gf9849f96c772"
msgid "I put a special meat inside."
msgstr "특별한 고기가 들어갔어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 8073c70d-26c9-f4d0-ceb0-2b62bae74ef9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:8073c70d-26c9-f4d0-ceb0-2b62bae74ef9
msgctxt "habbe681fg52dfg46dfg8bf4gfe08949e24f7"
msgid ""
"My mum always used to make it for me. She used to change the recipe a lot, "
"'cause she had to, um, <i>borrow</i> some of the ingredients."
msgstr "엄마가 자주 해주시곤 했어요. 근데 매번 재료가 달랐죠. 왜냐면, 그... 매번 <i>빌리는</i> 재료가 달랐거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 81eee8f2-2f0a-32f7-c4b9-ca785fbb33e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:81eee8f2-2f0a-32f7-c4b9-ca785fbb33e3
msgctxt "ha20dddafge0c9g44ddg8d2bga8a8cafebb70"
msgid "What a waste of good flesh."
msgstr "좋은 고기를 낭비하다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 8a0a981f-90e3-a15e-6813-f1a632618040
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:8a0a981f-90e3-a15e-6813-f1a632618040
msgctxt "h97fafd96g010bg441bg960bgacf2522d8ea6"
msgid "I prefer dwarf."
msgstr "고양이보단 드워프가 낫군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 8bcfd5f8-0049-a80e-c557-bae059bdc7c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:8bcfd5f8-0049-a80e-c557-bae059bdc7c0
msgctxt "hcf51af25g2ad8g4bc8g9ac6gcc3817e9ea21"
msgid "You're going to tell me anyway, aren't you?"
msgstr "안 궁금해도 알려줄 거잖아, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 96a08736-0edf-dfd1-0a01-91d76eaf43a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:96a08736-0edf-dfd1-0a01-91d76eaf43a9
msgctxt "h59ba3f9eg8342g403dgb908gddf7e8bd2eb6"
msgid "Go on then - what is it?"
msgstr "말해봐, 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 9a77bc8b-07f5-45b8-eac8-baf33757b5b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:9a77bc8b-07f5-45b8-eac8-baf33757b5b3
msgctxt "ha2558bbag9630g4e42gbcabg6852d6559483"
msgid "Your mum was a cook?"
msgstr "네 엄마, 요리사였어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 9c65d189-f298-4cc2-979c-3d944a9b8a07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:9c65d189-f298-4cc2-979c-3d944a9b8a07
msgctxt "h39bfb571g1907g44a3gbe0egf8ff590fb744"
msgid "First let me try the food. <i>Then</i> I'll decide."
msgstr "일단 맛 좀 보고. 결정은 <i>그다음에</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = 9e806370-05d8-2f19-1592-d5ab318f75b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:9e806370-05d8-2f19-1592-d5ab318f75b6
msgctxt "hdf451502g789fg4396gbbdcg01c0db75b3c9"
msgid "I - I made is especially for you. I thought you'd like it."
msgstr "특별히 만든 거란 말이에요. 좋아하실 줄 알았는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = 9eb8263e-08ce-d09a-37b2-1101c6aca975
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:9eb8263e-08ce-d09a-37b2-1101c6aca975
msgctxt "h81c6eb35g0d0fg4b2bg99f2g5aa83bfdea9e"
msgid "No way in the hells I'm eating that."
msgstr "내가 그딴 걸 왜 먹냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = a2a47460-0f99-6e00-a015-c18cb5856c81
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 25
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:a2a47460-0f99-6e00-a015-c18cb5856c81
msgctxt "hf1df62bdgd1e9g4a8egbc6ag96e80c0ff9df"
msgid "<i>Taste the meal again. Try to identify the secret ingredient.</i>"
msgstr "<i>한 입 더 베어 문다. 비밀 재료가 무엇일지 확인해 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = a5beecb9-f7ec-b6be-e058-bdc85e7d849d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:a5beecb9-f7ec-b6be-e058-bdc85e7d849d
msgctxt "h77d1c947gc779g4494ga15dge10d8f7429be"
msgid "You've underdone it, urchin wretch."
msgstr "덜 익었잖아, 거렁뱅이 녀석아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = abcaaa39-8c13-4fa1-ff36-adca28df705b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:abcaaa39-8c13-4fa1-ff36-adca28df705b
msgctxt "h6be5a9dag42e8g4042gbcf7gb0851bf36c99"
msgid "Don't you have any other skills?"
msgstr "다른 할 줄 아는 건 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = b13d6994-859e-1ba1-73c3-8c184541e449
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:b13d6994-859e-1ba1-73c3-8c184541e449
msgctxt "h219b8c59gb634g43b9gb3a8g2c79b67f1abe"
msgid "<i>Take another bite.</i>"
msgstr "<i>한 입 더 먹어본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = c41d6cec-672c-6dcc-4a18-3423f74810a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:c41d6cec-672c-6dcc-4a18-3423f74810a6
msgctxt "h770687f7g9fd8g4049g94ebgc1c151cfc05f"
msgid "Do - do you want to try it?"
msgstr "한 입 드셔보실래요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = c48336fb-58dd-0b3d-73c4-fa322ac39a28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:c48336fb-58dd-0b3d-73c4-fa322ac39a28
msgctxt "h8aaa087bg39d8g4102gba9cg544f29e1a299"
msgid "I- I hope you like it."
msgstr "꼭 좋아하셨으면 좋겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = c66777bc-9444-959b-6549-2ddddc2ba2d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:c66777bc-9444-959b-6549-2ddddc2ba2d1
msgctxt "h4404c6b2g8f64g4696g9e25g3b4dd3e79c6b"
msgid ""
"I wanted to do something to show I was worth keeping around. I want to be "
"your cook."
msgstr "저도 할 땐 한다는 거 보여드리고 싶었어요. 여러분의 요리사가 되고 싶어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = c7e34f86-8671-8f44-2857-3f152220a7b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:c7e34f86-8671-8f44-2857-3f152220a7b5
msgctxt "h48db04f8gab70g4fa3gaf2ag8df9a79cab00"
msgid "Well I - I just wanted you to give me a chance."
msgstr "그냥... 제게 기회를 한번 주셨으면 했어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = cb87fba5-79b6-2896-2f03-7332cf9468ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_OrinsAbduction_State_AbductionOccured_Elfsong = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:cb87fba5-79b6-2896-2f03-7332cf9468ab
msgctxt "h27db30b9g3e41g4c0egad0fg195db8cbe6de"
msgid "The Elfsong needs better security. Are you up to some mischief in here?"
msgstr "엘프송 보안이 엉망이네. 대체 여기서 무슨 장난을 치던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = cba9df1f-b7ab-addc-4a5c-36dca5ecedbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_State_MovedToCamp = True
#.      - GLO_OrinsAbduction_State_AbductionOccured_Elfsong = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:cba9df1f-b7ab-addc-4a5c-36dca5ecedbd
msgctxt "h0afb660bgd703g4204g80eagbbc8a5e9a0ec"
msgid ""
"When I invited you to camp, I didn't expect you to follow me into the city."
msgstr "널 야영지로 받아줬을 때, 도시까지 따라와도 된다는 뜻은 아니었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = ce55a921-6b4a-69bf-0646-e2aed9aeea97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:ce55a921-6b4a-69bf-0646-e2aed9aeea97
msgctxt "hd43fb68cga75ag466eg9024gbc113c3b8f21"
msgid "Please, just try it. I promise it's good."
msgstr "한 번만 맛봐 주세요. 진짜 맛있을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = d07e253a-4013-cd82-78fd-e5343985e7cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_HasMet = True
#.      - CAMP_Yenna_State_MovedToCamp = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:d07e253a-4013-cd82-78fd-e5343985e7cc
msgctxt "h1b481e1ag5791g4abcg8acfgd8e0dcda6ed8"
msgid "Please, don't hurt me. I know you don't want me but - give me a chance."
msgstr "혼내지 말아 주세요! 제가 필요 없더라도… 기회를 주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = d0d19dc2-e989-2ae2-62b2-a8fc0361b314
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_HasMet = True
#.      - CAMP_Yenna_State_MovedToCamp = False
#.      - GLO_OrinsAbduction_State_AbductionOccured_Elfsong = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:d0d19dc2-e989-2ae2-62b2-a8fc0361b314
msgctxt "h85a46b56g328eg4aefg91b9g4485183128db"
msgid "Did you break into my room? I told you to stay away from me."
msgstr "내 방에 몰래 들어온 거야? 얼씬도 하지 말라고 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = d29372d4-a801-5464-b0dc-f30d3912684c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:d29372d4-a801-5464-b0dc-f30d3912684c
msgctxt "he3c8b2b2g4d41g460fg81abgdc6b9ccfa63a"
msgid ""
"You don't believe me do you? Taste it, and then tell me it's 'mediocre'."
msgstr "못 믿으시는군요? 어디 한번 맛본 후에도 '그저 그런 요리'라고 할 수 있을지 보자고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = d539f083-f27f-f1a4-31d5-f78762c142d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:d539f083-f27f-f1a4-31d5-f78762c142d7
msgctxt "he65bb9acgae75g47e8g88b6g334633a7438d"
msgid "No - I'm not up to anything! I just wanted to say thank you."
msgstr "아뇨! 그런 거 없어요! 그저 감사드리고 싶었을 뿐이예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = da27b927-37f9-356e-8ec0-7667fad36bc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_OrinAbduction_CFM_Yenna_IdentifiedMeat(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:da27b927-37f9-356e-8ec0-7667fad36bc8
msgctxt "h9c0ce895g58c5g4033g800eg65f91812e0ea"
msgid "Did - did you cook your cat?"
msgstr "너... 네 고양이로 만든 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = da9a2166-d5b9-1e26-cc04-6190567b0843
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:da9a2166-d5b9-1e26-cc04-6190567b0843
msgctxt "hb93c3d72gf510g4e10gb624gd71127dc2631"
msgid "You already know. You felt it purr as it slid down your throat."
msgstr "눈치채셨잖아요. 목구멍으로 넘어갈 때 그 <i>하악질</i>하는 느낌을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = daf268bc-db4e-b439-eda2-645b89297399
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:daf268bc-db4e-b439-eda2-645b89297399
msgctxt "h90211197gf7acg493ega9fbg624914941370"
msgid "You've tasted it's flesh before? Isn't it <i>delicious</i>?"
msgstr "이전에 살점을 맛보셨죠? <i>맛있었죠</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = e4d29929-a3db-9748-b9b5-3dff58db608d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:e4d29929-a3db-9748-b9b5-3dff58db608d
msgctxt "h95f67fefg9bdcg43f0gb45ag2a4457ccb990"
msgid ""
"I didn't come to beg. I can work. I can cook for you. I can help - let me "
"prove it."
msgstr "그냥 밥이나 축내려고 온 건 아니에요. 일하고, 밥하고, 청소할게요. 기회를 주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = e567cb5d-2854-e89b-b568-46528ee1e00f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:e567cb5d-2854-e89b-b568-46528ee1e00f
msgctxt "h3f94c6d8gd116g4c70g8c2cg10d38db5552d"
msgid ""
"You really mean it? I'll - I'll make you proud. I'll be the best cook you "
"ever had."
msgstr "정말이죠? 저… 실망시켜 드리지 않을게요! 최고의 요리사가 되어 드릴게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Player
#. NodeID = ec6230e8-8186-9a29-70b1-78f520f98f86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:ec6230e8-8186-9a29-70b1-78f520f98f86
msgctxt "h60d8e896g5e76g4343g9907g3f24e1c1fcca"
msgid "Perhaps later, when I've more of an appetite."
msgstr "나중에. 좀 더 배고파지면 먹지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = edd675ff-21cc-9168-1b2e-2fd2eec9574a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:edd675ff-21cc-9168-1b2e-2fd2eec9574a
msgctxt "hdb06b6f5g1b6bg4545g946eg6595f468289f"
msgid "I know. But I don't have nowhere else to go."
msgstr "알아요. 근데… 여기 아니면 갈 곳이 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna
#. Speaker = Yenna
#. NodeID = f15cf661-1fb6-f28d-a0ef-6ee38dbcd477
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_OrinAbduction_CFM_Yenna:f15cf661-1fb6-f28d-a0ef-6ee38dbcd477
msgctxt "h175ae2f7gef41g4515gbc76g2122ba5b3b74"
msgid "Want me to tell you what it is?"
msgstr "말해드릴까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Owlbear Cub
#. NodeID = 07e5ed27-3cad-da1d-5e1f-f679203e9f5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:07e5ed27-3cad-da1d-5e1f-f679203e9f5b
msgctxt "h84d0a3d6g580ag4e30g8cbeg735e7ee0d615"
msgid "No hurt Scratch! Never!"
msgstr "스크래치 안 해쳐! 절대!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 0d6f931c-383d-e730-8fce-784265581f36
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:0d6f931c-383d-e730-8fce-784265581f36
msgctxt "hd9ec6736g901dg417ag8d7bg717cab89ee41"
msgid "Did you call me master just now...?"
msgstr "너 지금 날 주인님이라고 부른 거야...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 0d6f931c-383d-e730-8fce-784265581f36
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:0d6f931c-383d-e730-8fce-784265581f36
msgctxt "h3444eae9gb8e7g4c26gbfd5ge647c9813f69"
msgid "Did you call me mistress just now...?"
msgstr "너 지금 날 여주인님이라 부른 거야...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 0d6f931c-383d-e730-8fce-784265581f36
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:0d6f931c-383d-e730-8fce-784265581f36
msgctxt "h5ff20e08g72a8g46degad4cgd9fc6daa98a5"
msgid "Did you call me guardian just now...?"
msgstr "너 지금 날 수호자님이라 부른 거야...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Narrator
#. NodeID = 110f4fd5-9584-2824-15ef-4953e74fd51f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:110f4fd5-9584-2824-15ef-4953e74fd51f
msgctxt "h43581a99gea0bg47edga280gef8d2df9ded7"
msgid "*Scratch's tail wags furiously. These two have become firm friends.*"
msgstr "*스크래치의 꼬리가 열정적으로 흔들립니다. 이 둘은 돈독한 친구가 되었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 1117f388-5ac6-0198-6e66-0a3418840ced
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:1117f388-5ac6-0198-6e66-0a3418840ced
msgctxt "h2667e212g0e47g4f80g9a43geee81ca66d03"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Scratch
#. NodeID = 13910323-a430-4c4d-0340-dc381ca8c670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog:13910323-a430-4c4d-0340-dc381ca8c670
msgctxt "hf1ffbdb7g08c1g42eegb52ag9e086d39c8d1"
msgid "*Bark!*"
msgstr "*멍멍!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Player
#. NodeID = 13e19f3e-ac8b-73d3-e27d-4b426a82fcc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 81a4d63b-c888-156c-8166-3760752e82ee_PetScratch = False
#.   Object:
