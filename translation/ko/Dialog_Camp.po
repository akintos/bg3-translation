msgctxt "h9c471933g0662g4a38gb43eg7cff1aa0ff25"
msgid "<i>Move in for the kill.</i>"
msgstr "<i>공격을 시작한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Lump the Enlightened
#. NodeID = 2bfcf6a6-9831-2159-33c3-5a475c84bbdd
#. HandlePath = TaggedText[0].TagText[0]
