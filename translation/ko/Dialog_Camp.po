msgctxt "hd1b8938bgcf2bg4667g9d38g72f428efb531"
msgid "Get up! Let's dance. \n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Alfira
#. NodeID = 6a8450ce-7b11-364c-ecd1-59da9ae545d7
