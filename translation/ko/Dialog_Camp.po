msgctxt "h6b949f4ag6b23g4245g89aag9f07a1e44872"
msgid ""
"Here. I hope you like it. ([CAMP_Courier_Dog_FetchedItemDescription_50004d01"
"-651b-a7ea-308a-451a9571cb85])"
msgstr ""
"여기. 맘에 들면 좋겠네. ([CAMP_Courier_Dog_FetchedItemDescription_50004d01-651b-a7ea-"
"308a-451a9571cb85])"

