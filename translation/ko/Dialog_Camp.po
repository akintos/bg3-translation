msgctxt "h983c5bedg45c9g4fa3gbe40g23f98d12df5e"
msgid "Calm yourself - save your anger for our queen's enemies."
msgstr "진정해. 우리 여왕님의 적들을 위해 분노를 아껴둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/PLA_GithChokepoint_CRD_Laezel
#. Speaker = Player
#. NodeID = 4abed3ca-117f-852e-533e-55c72512d02d
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
