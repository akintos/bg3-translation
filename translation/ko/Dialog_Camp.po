msgid "What did you do to Scratch? I heard you two, in the night."
msgstr "스크래치한테 뭘 한 거야? 밤에 너희 소리가 들리던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_OwlbearCub
#. Speaker = Player
#. NodeID = dc66548b-aa0d-776f-1f2e-46233bc48af2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_OwlbearCub:dc66548b-aa0d-776f-1f2e-46233bc48af2
msgctxt "h105a7d1cga8c2g4743gadc8gd8d8366dadc1"
msgid "You like it here, huh?"
msgstr "여기가 좋구나, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_OwlbearCub
