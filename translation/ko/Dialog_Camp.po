msgctxt "ha8f57d34g7b56g43e4g958fg601fd842827c"
msgid "It doesn't matter how many times you ask. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Backup01_Backup02
