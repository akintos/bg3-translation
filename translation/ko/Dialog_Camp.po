msgctxt "h6aeec28bg101dg4487g95f7gde22de9c3251"
msgid "There is no doubt. Moonrise Towers."
msgstr "두말할 나위 없이, 문라이즈 타워입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = bebbddc4-f2ce-5638-e2b0-08a485905adb
