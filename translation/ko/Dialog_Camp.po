msgctxt "h6fb040b9g7224g484bg9662g6a92c46d3422"
msgid "Something you needed?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
