#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 11ab3500-e58b-4c2d-ac76-b477e1ee7893
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ToldParentsDead = False
#. SetFlags:
#.   Local:
#.     - 4cd75d9f-d40b-e52c-937a-1e37c7d9147a_A = True
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:11ab3500-e58b-4c2d-ac76-b477e1ee7893
msgctxt "hb5f6be62g5204g40f6gaa67g452849796072"
msgid "I never met a skeleton before. Are you, you know - dead?"
msgstr "해골은 처음 보는데, 혹시, 음... 죽으셨나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 17e458b8-1aca-408c-92a8-ebe8d0043e5c
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:17e458b8-1aca-408c-92a8-ebe8d0043e5c
msgctxt "h3273f892g6b2bg4a74ga4b6gf47e27f1e570"
msgid "I don't get it."
msgstr "이해가 안 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 1b4d1317-ffdb-34a8-e68a-1a5f2605910e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ToldParentsDead = False
#.   Local:
#.      - 4cd75d9f-d40b-e52c-937a-1e37c7d9147a_A = True
#. SetFlags:
#.   Local:
#.     - 4cd75d9f-d40b-e52c-937a-1e37c7d9147a_B = True
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:1b4d1317-ffdb-34a8-e68a-1a5f2605910e
msgctxt "hc39f9ba4g914fg4eb4gbfa4g7e5f1ac150bc"
msgid "Can I touch your face?"
msgstr "얼굴 만져봐도 돼요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 39e710e8-c52e-f5a0-32d7-887c628d462a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ToldParentsDead = False
#.   Local:
#.      - 4cd75d9f-d40b-e52c-937a-1e37c7d9147a_B = True
#. SetFlags:
#.   Local:
#.     - 4cd75d9f-d40b-e52c-937a-1e37c7d9147a_B = False
#.     - 4cd75d9f-d40b-e52c-937a-1e37c7d9147a_A = False
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:39e710e8-c52e-f5a0-32d7-887c628d462a
msgctxt "had9f6af0g0afcg488cgb87dgc245ecccc2f3"
msgid "So what were you before you were... this?"
msgstr "그러니까... <i>이렇게</i> 되기 전엔 어떤 존재였나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Arabella
#. NodeID = 47e46b60-4d0b-e018-456b-316b65a6956f
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:47e46b60-4d0b-e018-456b-316b65a6956f
msgctxt "h9be269c5g5abcg4a6eg8b76g6eb249830241"
msgid "So you've always been a bone man?"
msgstr "그러니까 계속 뼈다귀 인간이었다고요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Withers
#. NodeID = 5821e3d6-b720-49f0-a7bd-23c49561755b
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:5821e3d6-b720-49f0-a7bd-23c49561755b
msgctxt "h5fe203c1g7a7cg430agaff7g0b44867949d5"
msgid "Thou wilt."
msgstr "물론 그럴 터."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Withers
#. NodeID = b7ba1351-3e79-94cf-bfcb-a5b58bb18578
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:b7ba1351-3e79-94cf-bfcb-a5b58bb18578
msgctxt "h720b6561g7a68g49b8g8134gfde4b5c68a51"
msgid "No."
msgstr "거절하마..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Withers
#. NodeID = d10d777c-4790-aa4a-064f-ffe380ed2b3c
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:d10d777c-4790-aa4a-064f-ffe380ed2b3c
msgctxt "hab0f1c37g9a40g48d2ga2e5g7385c3e14b8e"
msgid "There is no 'before'."
msgstr "'이렇게 되기 전'은 없단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Arabella
#. NodeID = d5a081b3-ee18-2ac0-d4fa-f89a5bc8ee9f
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:d5a081b3-ee18-2ac0-d4fa-f89a5bc8ee9f
msgctxt "h197ac62eg8d68g4a91g8b44g89264d6d3491"
msgid "Aw. You're no fun."
msgstr "에이... 재미없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Withers
#. NodeID = e0274359-2e48-4fe1-bd97-80c7deb91d2c
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:e0274359-2e48-4fe1-bd97-80c7deb91d2c
msgctxt "he07f76c5g7858g4954gb308g511067b3b246"
msgid ""
"I am not a skeleton. I am neither dead, nor undead. Neither alive, nor "
"unliving."
msgstr "나는 해골이 아니다. 죽어있지도, 죽어있지 않지도 않지. 살아있지도, 살아있지 않지도 않다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Withers
#. NodeID = f253b6eb-f87a-7e3a-0587-b744c8329c6e
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:f253b6eb-f87a-7e3a-0587-b744c8329c6e
msgctxt "h6f40d040g2388g49a1gaff8gf756e8986151"
msgid "In a sense."
msgstr "그런 셈이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal
#. Speaker = Withers
#. NodeID = fdf7e759-08ec-bd0c-ab8a-c67c0a35621b
#. HandlePath = TaggedText[0].TagText[0]
#. Comment = TagRule:
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_AD_ArabellaJergal:fdf7e759-08ec-bd0c-ab8a-c67c0a35621b
msgctxt "hb7f2bdbeg24fcg401agad36gb0785f255db5"
msgid "No."
msgstr "안된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Arabella
#. NodeID = 0228cab6-01dc-712e-d0e9-474cf5b99d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:0228cab6-01dc-712e-d0e9-474cf5b99d2d
msgctxt "h8a967b26g33dbg42f2g8309g68dfc54b76c5"
msgid "It isn't true. It isn't!"
msgstr "거짓말... 거짓말이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Arabella
#. NodeID = 03ba7218-5011-4b07-9fef-96633bd9778a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedToLearn(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:03ba7218-5011-4b07-9fef-96633bd9778a
msgctxt "h60acd2c9g18ffg4f84g95dbg1dcf914ee1af"
msgid "Hey - that wasn't the deal."
msgstr "저기요, 그건 약속에 없었잖아요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 0a8101d4-2772-0715-e6d6-096103865f52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:0a8101d4-2772-0715-e6d6-096103865f52
msgctxt "ha98bc560gbc5dg425egbd6bg014e1ef253a6"
msgid ""
"I know this is hard - but accepting their passing is the first step to "
"healing."
msgstr "어렵다는 건 알지만, 받아들어야만 해. 그래야 앞으로 나아갈 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Arabella
#. NodeID = 0b1530f9-617a-29ad-c698-5590531b59fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:0b1530f9-617a-29ad-c698-5590531b59fc
msgctxt "h53ecd945g05c7g4b9bga1d8gdd3bda182aa4"
msgid "Get away from me. Go!"
msgstr "저리 가요. 가라고요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 10924deb-b45c-8b7e-8d6d-4f209e2b8ae8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:10924deb-b45c-8b7e-8d6d-4f209e2b8ae8
msgctxt "h12f7d65bgfd19g439eg88eag513333f9ce9e"
msgid "It hurts, I know it does. But you'll feel better in time."
msgstr "많이 힘들 거야. 이해해. 하지만 시간이 해결해 줄 거란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Arabella
#. NodeID = 1119b9e7-27ae-44b8-9813-4183d717679a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellaPowers_State_MetAtCamp = True
#.      - TWN_ArabellasPowers_State_ToldParentsDead = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:1119b9e7-27ae-44b8-9813-4183d717679a
msgctxt "heab0db0cga996g46b7ga3cfg218e1e7c3014"
msgid "Hey. Where's mum and pops?"
msgstr "저기, 우리 엄마 아빠는 어디 있어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 22dfb751-1a4e-ffd0-4cdd-c71558c65779
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ParentsFoundDead = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:22dfb751-1a4e-ffd0-4cdd-c71558c65779
msgctxt "ha57ec33cg493fg414fg931fgbeb13783bd7d"
msgid ""
"For once, I find myself at a loss for words. They're gone, Arabella - I'm "
"sorry."
msgstr "어떻게 말해야 할지 모르겠지만, 아라벨라. 그들은 돌아가셨어. 유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 2baae110-e0d7-4c5b-984f-9a762d82b7d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedToLearn(1) = True
#.      - CAMP_ArabellaPowers_Event_AskedAboutVineTrick(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_ArabellaPowers_Event_AskedAboutVineTrick(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:2baae110-e0d7-4c5b-984f-9a762d82b7d9
msgctxt "hdef9f3abgf5f8g4c29gad80gdc37a06f7d0f"
msgid "Teach me your vine trick. Maybe then I'll start looking."
msgstr "너의 그 덩굴 마법을 알려주면 찾는데 도움이 될지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 3a0ffef8-1b78-40cc-eb77-1a0fbe45091b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ParentsFoundDead = True
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:3a0ffef8-1b78-40cc-eb77-1a0fbe45091b
msgctxt "h368a13fbgf446g4f88g98b4gefb560f7a0e6"
msgid "They've... passed on, Arabella. Returned to the cycle. I'm sorry."
msgstr "그들은... 떠났어, 아라벨라. 흙으로 돌아갔지. 유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 3d2b2a4b-a263-7d87-abd9-50d15a0e519e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:3d2b2a4b-a263-7d87-abd9-50d15a0e519e
msgctxt "h8a5d9aadgc02ag47f9g8d3dg436a4b013003"
msgid "It was quite the sight. Their corpses were all but turned inside out."
msgstr "두 눈으로 똑똑히 봤어. 너희 부모님은 고깃덩이가 되어있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Arabella
#. NodeID = 44deae16-c849-0bf9-4e6a-195ddd836875
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:44deae16-c849-0bf9-4e6a-195ddd836875
msgctxt "he0b8bcc6g7a39g4f66gb976ge1cac8f6bf90"
msgid "You don't have to be mean. I was just saying."
msgstr "그렇게 말할 필요는 없잖아요. 그냥 한 말이었다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 48458fd0-1851-127e-d7d6-85e8721eb9c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:48458fd0-1851-127e-d7d6-85e8721eb9c9
msgctxt "h6cbf3296g3a1bg49c1g9fe1g9e7649923482"
msgid ""
"I wish this were simply another tale, but it's not. I'm telling you the "
"truth."
msgstr "나도 그냥 다른 세상 이야기였다면 좋겠지만, 그렇지 않아. 난 진실을 알려주고 있는 거란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 49fbe396-a3b5-4ba7-bc1c-e7baf500eaa9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_ArabellaPowers_Event_AskedAboutParents(1) = True
#.     - CAMP_ArabellaPowers_Event_AskedAboutVineTrick(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:49fbe396-a3b5-4ba7-bc1c-e7baf500eaa9
msgctxt "hf2ba8429g3002g44c7g95b2gf7b7eb4324a4"
msgid "I haven't found your parents just yet."
msgstr "아직 너희 부모님은 찾지 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 4bc35627-3311-c93f-8aec-3f04938886de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_KELEMVOR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:4bc35627-3311-c93f-8aec-3f04938886de
msgctxt "hbaa49db0ga0fbg4685g99ccg180b509109d5"
msgid ""
"Death is simply another part of life, Arabella. It is not something to fear."
msgstr "죽음도 삶의 일부일 뿐이야, 아라벨라. 두려워할 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 4d8a51d9-ac4d-40ec-98e5-04dd3121fb75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:4d8a51d9-ac4d-40ec-98e5-04dd3121fb75
msgctxt "h20874390g211bg4253g91ffgf88e7fb95cc5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Arabella
#. NodeID = 539438c9-3353-7fb0-4638-4197a1c7fed3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:539438c9-3353-7fb0-4638-4197a1c7fed3
msgctxt "ha60eb916g0456g4d14gb1f2g09d4d88dc357"
msgid "They'd never leave me. <i>They promised.</i>"
msgstr "저희 부모님은 저를 떠나지 않을 거예요. <i>약속했다고요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 56c3f945-1e06-d12e-2050-fd4c2b12f631
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ParentsFoundDead = True
#.   Tag:
#.      - CLERIC_KELEMVOR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:56c3f945-1e06-d12e-2050-fd4c2b12f631
msgctxt "h73854eeag537dg4519g87b4gdd1c7bd8d26c"
msgid ""
"They're with Kelemvor now, my child. But he will care for them as they did "
"you."
msgstr "부모님은 이제 켈렘보르와 함께 하셔, 얘야. 부모님께서 널 돌봐주신 것처럼 이젠 켈렘보르께서 부모님을 살펴주실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Arabella
#. NodeID = 639db8fe-d6f6-4543-aa65-67545b9e7d48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella:639db8fe-d6f6-4543-aa65-67545b9e7d48
msgctxt "hf9a5f9feg40c1g474egb046g55ab6957594b"
msgid "You find mum and pops?"
msgstr "엄마 아빠는 무사하시죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_ArabellaPowers_Arabella
#. Speaker = Player
#. NodeID = 69a16468-64af-a0d6-025e-de7593840e37
#. HandlePath = TaggedText[0].TagText[0]
