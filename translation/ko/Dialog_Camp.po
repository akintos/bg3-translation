msgctxt "h8a1b0b54g85a8g4160g9a3fg24e3cbd019ae"
msgid "A fine opponent, this Halsin - my bloodthirst is whet!"
msgstr "이 할신이라는 자는 훌륭한 적수야. 내 피의 갈망을 돋우는구나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_HalsinsRevenge_PAD
