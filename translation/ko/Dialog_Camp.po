#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:e30629cc-7473-42cf-8eb6-a420c03ac9f9
msgctxt "h03d37d31gfd94g41e5g9ef4ge03fba1f96ac"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = e50ce2c5-a1d4-ef0e-5774-d62180afe288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:e50ce2c5-a1d4-ef0e-5774-d62180afe288
msgctxt "h2b7d7244gc4a1g4809g8670g466309fbd69e"
msgid ""
"Because we don't have a choice! Not if we're going to save ourselves from "
"these worms."
msgstr "우리에겐 달리 선택지가 없으니까! 이 벌레로부터 우리 자신을 구해내려면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = e6efbd37-b551-d7c0-764f-b7301bed7afd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:e6efbd37-b551-d7c0-764f-b7301bed7afd
msgctxt "h8d976d5cg0f89g49ccg9e2dgd64c82551e4d"
msgid "You almost killed me!"
msgstr "나를 죽일 뻔했잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = e7062dd1-cc67-5b3e-e313-2c8f6688e945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:e7062dd1-cc67-5b3e-e313-2c8f6688e945
msgctxt "hf6e3c51agd9bfg4632g9f40gff110722cef5"
msgid "<i>Let him continue.</i>"
msgstr "<i>계속하게 둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = eaed47ef-69ca-8ef4-1e3f-9e2263955973
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Astarion_TheHungerC_Leave = True
#.   Object:
#.     - GLO_Companion_LeaveDisappearInstantly(0) = True
#.   Quest:
#.     - ORI_COM_Astarion.CompanionLowRelation(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:eaed47ef-69ca-8ef4-1e3f-9e2263955973
msgctxt "h5a6df4abg09b2g4de5g8368g5441540a2e4f"
msgid "Wretch!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = eb3b3a07-43de-de9b-d514-fc148e0aba3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:eb3b3a07-43de-de9b-d514-fc148e0aba3a
msgctxt "h6c745dffg560cg4dd3ga10cgf3f4b8af8163"
msgid "No. Leave and never return."
msgstr "아니. 떠나서 다시는 돌아오지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = eef23ca2-db08-4f3f-c5e0-7ed8014236fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:eef23ca2-db08-4f3f-c5e0-7ed8014236fb
msgctxt "hcca08b02gdc8ag4875g97b0g3adec7ceefc0"
msgid ""
"*You watch as he stalks towards the forest. Stronger. More confident. Ready "
"to hunt.*"
msgstr "*당신은 그가 숲을 향해 걸어가는 모습을 지켜봅니다. 더 강해지고, 자신감 넘칩니다. 사냥 준비를 마쳤습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = efce9ce0-d383-f404-d790-c0e255fad71a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeWeaponAttack
#. RollAbility:
#. DifficultyClass: 0
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:efce9ce0-d383-f404-d790-c0e255fad71a
msgctxt "hcab873e0g45cag4e17g9166g16db2f083394"
msgid "<i>Pick up a stake and lunge at the monster.</i>"
msgstr "<i>괴물에게 달려들어 막대기로 심장을 찌른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Narrator
#. NodeID = f1a47de8-cadb-c9e6-84ae-e7de72b42d92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#. SetFlags:
#.   Quest:
#.     - ORI_COM_Astarion.LearnedVampire_NoBlood(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:f1a47de8-cadb-c9e6-84ae-e7de72b42d92
msgctxt "h21959930g235bg49c0g8af8gde2f09e289aa"
msgid "*You watch him stalk away, slumped, sulking, and ready to kill.*"
msgstr "*당신은 그가 부루퉁해, 구부정하게, 죽일 준비를 마친 채 떠나는 모습을 지켜봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = f3a3b3f1-ca2a-4b58-c189-5636c8d19c94
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeWeaponAttack
#. RollAbility:
#. DifficultyClass: 0
#. SetFlags:
#.   Quest:
#.     - ORI_COM_Astarion.LearnedVampire_Attacked(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:f3a3b3f1-ca2a-4b58-c189-5636c8d19c94
msgctxt "hb5ae3dabg8859g47d1g8077g719c0b78ba6c"
msgid "<i>Grab the stake and drive it into his heart.</i>"
msgstr "<i>말뚝을 잡고 그의 심장에 꽂아넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = fb68fa97-55a9-04b0-17fc-580bd1c8467d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:fb68fa97-55a9-04b0-17fc-580bd1c8467d
msgctxt "haa9db4fdg992fg4844gb1eeg4eae462c4d3a"
msgid ""
"I - yes. Yes, I ate whatever disgusting vermin my master picked. So you can "
"see why I'm slow to trust you."
msgstr "난 - 맞아. 그래, 주인이 고른 역겨운 해충을 뭐든 먹었어. 그러니 왜 내가 널 믿는 데 조심스러운지 알겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = fbe75ad5-c5c9-58eb-02ca-4d97acd59670
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_Astarion_Event_LetAstarionBite(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:fbe75ad5-c5c9-58eb-02ca-4d97acd59670
msgctxt "h05e7ac80g2ea7g4e4cg9c30g8ebc875dfe02"
msgid "Fine. But not a drop more than you need."
msgstr "좋아. 하지만 필요 이상으로는 한 방울도 더 빨지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = fbf1be91-a1a9-6e04-e035-3aaf6cc7e276
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:fbf1be91-a1a9-6e04-e035-3aaf6cc7e276
msgctxt "h81d8f89fg011eg43d0g8c43g6444ef5e6441"
msgid "Why didn't you tell me you were a vampire?"
msgstr "왜 뱀파이어라고 말 안 했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = fdae9a8a-02d9-c01c-f1a5-3d54aca4550e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:fdae9a8a-02d9-c01c-f1a5-3d54aca4550e
msgctxt "h4353f3d4g7052g4359gab93ga78f85ca31df"
msgid "Must be the infernal engine. Sorry, Astarion, I can't help you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Player
#. NodeID = fe492b12-6aa4-b5d7-94ef-79e6e8a8061b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:fe492b12-6aa4-b5d7-94ef-79e6e8a8061b
msgctxt "he23027f7g25fdg4ee7g921fg3d07a9c1461e"
msgid "You have your secrets, I have mine."
msgstr "내게도 비밀은 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion
#. Speaker = Astarion
#. NodeID = ff893dd0-4cbd-89d7-ade1-f10ad1887c45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_AstarionHunger_SCO_Companion:ff893dd0-4cbd-89d7-ade1-f10ad1887c45
msgctxt "h36deefd2g3f59g41d1g961eg11948ea3049e"
msgid "No no no! It's not what it looks like."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 0571b59f-519e-c93d-39c8-b952f3f72518
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:0571b59f-519e-c93d-39c8-b952f3f72518
msgctxt "h891587a3gad55g4605g8f5egeb498d2b4a82"
msgid ""
"Cazador gave me just enough to keep me - well, 'alive', for lack of a better "
"word. But never more than that."
msgstr ""
"카사도어는 겨우 내가 살아남을 수 있게만 했어. 어쨌든 '살아있다'라는 단어보다 더 적절한 말은 없었지. 하지만 그 이상은 아니었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 0f82e6b7-fa10-7041-88b0-b4f1b46e2a7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:0f82e6b7-fa10-7041-88b0-b4f1b46e2a7e
msgctxt "hb6026792g5c21g4874g9d32g29f0fcb0e646"
msgid ""
"Maybe not, but you'll grovel before the mind flayers if you keep using the "
"tadpole."
msgstr "아마 그럴 수도 있어. 하지만 네가 올챙이를 계속 사용한다면 너는 마인드 플레이어들에게 엎드려 빌게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 0fb41ab6-5c2e-c875-4e60-ec2fbe79e832
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:0fb41ab6-5c2e-c875-4e60-ec2fbe79e832
msgctxt "hfc78302bgb109g48d2ga616ge8e5bf8420c8"
msgid "Power corrupts. You'd do well to remember that."
msgstr "권력은 부패해. 명심하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 11f1627e-ea53-a696-d8ca-cb44eddb73fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:11f1627e-ea53-a696-d8ca-cb44eddb73fa
msgctxt "h0a4f7d3dg9cbcg4700ga4cag45cbad0e743a"
msgid "He took a little of my blood, I took all of his."
msgstr "곰이 내 피를 좀 가져갔고, 난 곰의 피를 다 가져갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 125d1cb9-03f9-18f1-3e70-e552f3c6da3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:125d1cb9-03f9-18f1-3e70-e552f3c6da3d
msgctxt "hb98f49b8gd99eg4252g8f76gc4e15f08aeda"
msgid "It was exactly as appetising as you'd think."
msgstr "딱 네가 생각했던 것만큼 식욕이 돋았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 151f3248-a12f-6631-b623-9ab6c375d1fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:151f3248-a12f-6631-b623-9ab6c375d1fd
msgctxt "he2be4b8ege419g4a49ga09egab9dfa176ec0"
msgid "We're not powerless. The tadpoles are quite the asset."
msgstr "우린 무력하지 않아. 올챙이들은 꽤 쓸모있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 156b1162-e106-82c2-5018-d6433ef16cbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:156b1162-e106-82c2-5018-d6433ef16cbb
#, fuzzy
#| msgid "Flies? And what did you do to deserve that?"
msgctxt "h6015a67dg350bg4e28gb4c7gc2227c845554"
msgid "Rats? And what did you do to deserve that?"
msgstr "벌레? 네가 뭘 잘못했길래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 189b52a4-bd33-91ef-2688-cb274e4a3c55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:189b52a4-bd33-91ef-2688-cb274e4a3c55
msgctxt "h4e023784gefcdg4c81gabfcg18512b10a428"
msgid ""
"The strong had two centuries to pluck me from torture, but no one came. No, "
"it was the mind flayers that rescued me."
msgstr ""
"강자들은 고문에서 나를 구할 수 있는 두 세기의 시간을 가졌지만, 아무도 오지 않았어. 아니, 나를 구해준 것은 바로 마인드 "
"플레이어들이었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 18ef45bb-2ce0-cb92-efd6-da3d05fcf1a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:18ef45bb-2ce0-cb92-efd6-da3d05fcf1a0
msgctxt "hdf366f51g8d76g4704gbd00gda1f431ceb2a"
msgid "Well... yes."
msgstr "글쎄... 맞아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 1f27665e-ec2b-cdc9-f766-c038577e8c21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:1f27665e-ec2b-cdc9-f766-c038577e8c21
msgctxt "h6d2806c3g8787g4feag8037gf5c6f59ed3f7"
msgid ""
"I spent centuries as the victim of a corrupt man. It was the mind flayers "
"that plucked me away from that."
msgstr "나는 수세기 동안 한 부패한 남자의 희생자였어. 나를 그로부터 구한 것은 바로 마인드 플레이어들이었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 227c1e52-520a-475d-1d0f-5085e992ec04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:227c1e52-520a-475d-1d0f-5085e992ec04
msgctxt "hd433971eg0752g4832g93f8g21717ba7dbf5"
msgid ""
"It's nothing compared to - well, other things I could be dining on. But "
"significantly better than the rats and bugs Cazador served me."
msgstr "다른 음식에 비하면 별거 아니지만, 카사도어가 내게 준 쥐와 벌레보다는 훨씬 나은 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 2454ec48-74c2-941b-ee59-8f0a19123d59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:2454ec48-74c2-941b-ee59-8f0a19123d59
msgctxt "h0770eb3bg993ag4d9dg8cf0gf406bc83edb1"
msgid ""
"I mean - I think it was a bear? Big head, four legs, hair that gets stuck in "
"your teeth."
msgstr "그러니까, 아마 곰이었을걸? 큰 머리에, 다리 네 개, 이빨에 걸리는 머리털."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 263418f5-e4c7-efe2-f7d2-803f3a672cc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:263418f5-e4c7-efe2-f7d2-803f3a672cc8
msgctxt "h93f21d95gc431g4e69g9897g8683ee4cfd67"
msgid "Heroes didn't save me from Cazador: mind flayers did."
msgstr "영웅들은 나를 카사도어로부터 구하지 못했어: 마인드 플레이어는 구했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 2ad5fce5-f9c8-7e6b-88d8-8a60c5d4c69d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:2ad5fce5-f9c8-7e6b-88d8-8a60c5d4c69d
msgctxt "hca5b1159ga11fg4d0fg8020ge609b3184391"
msgid "Exactly! I can be better than him. Stronger. More powerful. More -"
msgstr "정확해! 난 그 사람보다 더 나을 수 있어. 더 강하고. 더 강력하고. 더 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 357de5e3-ae6f-2b99-2c9d-1a8d5ccbbb7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:357de5e3-ae6f-2b99-2c9d-1a8d5ccbbb7b
msgctxt "h4d91e752gdc2cg481ag9679g3fb5d5f069c4"
msgid "You think I'd kill you, just like that? Darling, I would never!"
msgstr "내가 너를 죽여? 정말로? 자기야, 내가 왜 그런 짓을 하겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 37fd9cb2-a840-d50f-cb2e-143bf3964bf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:37fd9cb2-a840-d50f-cb2e-143bf3964bf2
msgctxt "h25975047g542fg4475g81b8gea31c846708f"
msgid ""
"Anyway, the bear will sustain me. And it's a marked improvement over the "
"rats and flies Cazador would feed me."
msgstr "뭐, 당분간은 곰 덕분에 괜찮겠어. 어쨌든 카사도어가 먹이로 던져 주던 쥐새끼나 파리들보다야 훨씬 나으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 39ae31e6-497e-a8ed-1cf5-4ca851c42ec1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:39ae31e6-497e-a8ed-1cf5-4ca851c42ec1
msgctxt "h4163f8b1gfafbg4cb9g8149g2cdd109bbb73"
msgid ""
"No, these tadpoles are a gift I intend to use to the fullest. You should do "
"the same."
msgstr "아니, 이 올챙이들은 내가 최대한 활용할 선물이야. 너도 그래야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 39c9b69d-a40a-0b75-45f0-fdfa276415aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:39c9b69d-a40a-0b75-45f0-fdfa276415aa
msgctxt "hbd1401cag140bg4cb7gbe4agf5dc2835712f"
msgid "You sound very sure."
msgstr "엄청 확신하는 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 3c9dbc4f-cb6f-3b88-9a74-aa26ff2b8b36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:3c9dbc4f-cb6f-3b88-9a74-aa26ff2b8b36
msgctxt "hde36f5dbge9ecg4295g9beeg5e56700389e3"
msgid "Does it matter? Blood is blood, isn't it?"
msgstr "그게 문제야? 피는 피야, 그렇지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 44ea37b7-797a-5b92-27f7-53e0c1876c8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDDUNABB_State_InRegion(1) = False
#.      - CAMP_WLDCAVGRN_State_InRegion(1) = False
#.      - CAMP_WLDMAIN_State_InRegion(1) = False
#.      - CAMP_WLDBAS_State_InRegion(1) = False
#.      - CAMP_WLDCAVSND_State_InRegion(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:44ea37b7-797a-5b92-27f7-53e0c1876c8f
msgctxt "h36d275d5gf881g4ec9gb9cbg02b6e5a8e4ae"
msgid "Where did you find a bear down here?"
msgstr "여기서 곰을 찾았다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 4e14a550-f73a-e6ea-7907-7f839b331595
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:4e14a550-f73a-e6ea-7907-7f839b331595
msgctxt "haab94169gf28fg42c3g8b29g971ff3b7d2fb"
msgid "Sounds like a dangerous meal."
msgstr "위험한 식사처럼 들리네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 515c4c7a-178a-c530-e4e3-abcbd75a2115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:515c4c7a-178a-c530-e4e3-abcbd75a2115
msgctxt "ha2ebc52dg0befg4336gba20ga81781c14403"
msgid "You're free now. That's what matters."
msgstr "이제 넌 자유잖아. 그게 중요한 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 5bdb5921-1b6a-ff9b-a5cf-834665b70728
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:5bdb5921-1b6a-ff9b-a5cf-834665b70728
msgctxt "ha5d3be97g6729g4c9bga5a2g73e48c9d78ab"
msgid ""
"And being able to walk in the sunlight opens a lot of doors for me. Maybe "
"some coffins too."
msgstr "게다가 햇빛 아래 멀쩡히 거닐 수 있다는 건 또 얼마나 많은 문을 내게 열어 주는지. 어쩌다 묘지도 좀 열어제끼겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 62ef48ee-94c9-c5e2-3e2c-84fad42fc07f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:62ef48ee-94c9-c5e2-3e2c-84fad42fc07f
msgctxt "h4b24047bg2594g4d2eg9953g9a7a391c77d8"
msgid "So's any meal worth having."
msgstr "어떤 식사든지 마찬가지지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 63c1c6b3-c057-e68b-f88c-6084004d0fdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:63c1c6b3-c057-e68b-f88c-6084004d0fdc
msgctxt "h330e1046g3470g4486g9fadg4c13e4634725"
msgid "I don't intend to grovel before anyone!"
msgstr "난 누구 앞에서든 비굴하게 굴 생각 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 64194b32-60c4-d0c9-5694-371b368bb0b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:64194b32-60c4-d0c9-5694-371b368bb0b6
msgctxt "h00896ffeg72e2g4f61ga13ega554ca1b460f"
msgid "You seem happy. No need to drink humanoid blood, then?"
msgstr "행복해 보이네. 그러면, 인간의 피를 마실 필요는 없는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 743063e1-3d9b-3bb5-1de7-081ea2a4c90d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:743063e1-3d9b-3bb5-1de7-081ea2a4c90d
msgctxt "h58378f8fg83f5g4994g9088g0245520dd916"
msgid ""
"And now I'm left with this gift: the strength to take my own freedom. I'm "
"not afraid to use it, and you shouldn't be either."
msgstr "놈들은 내게 선물을 남겼지. 자유를 쟁취할 수 있는 힘 말이야. 나는 기꺼이 이 힘을 사용할 거야. 너도 그러는 편이 좋을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 75fe0c21-0724-a7a6-c31c-86579518ea76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:75fe0c21-0724-a7a6-c31c-86579518ea76
msgctxt "h7754de88gbfa0g404agacceg7a10b03e25e0"
msgid ""
"But Cazador fed me rats and bugs. And when you're used to drinking from a "
"sewer, even plonk is a marked improvement."
msgstr ""
"하지만 카사도어는 나에게 쥐와 벌레를 먹였어. 그리고 하수구에서 물을 마시던 것에 익숙해지면, 심지어 싸구려 와인도 눈에 띄게 개선된 "
"것처럼 느껴질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 7c99591a-a540-4c09-d977-49d362110ff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:7c99591a-a540-4c09-d977-49d362110ff8
msgctxt "hc928b0dbg66cag476fgb242g237ec0e03f88"
msgid "Thankfully I've had my needs met this evening. I found a bear."
msgstr "다행히 오늘 저녁엔 더 필요하지 않겠어. 곰을 한 마리 찾았거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 7e120d20-f0f3-3058-2313-659bd1e00e63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:7e120d20-f0f3-3058-2313-659bd1e00e63
msgctxt "h53559217g0907g4d34gbbdegcf98f04cb711"
msgid ""
"They gave me a gift: the strength to take my own freedom. I'm embracing this "
"power - you should too."
msgstr "그들은 내게 선물을 주었어: 내 자신의 자유를 가져갈 힘. 나는 이 힘을 받아들이고 있어 - 너도 그래야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 7f1575ac-639d-facb-268c-11664240d8e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:7f1575ac-639d-facb-268c-11664240d8e5
msgctxt "h9d3fefafge5bfg41e3g9740g7ee6b39a64f6"
msgid ""
"You're comparing plonk to vintage wine. You can make merry with either, but "
"they are not the same."
msgstr "넌 싼 와인과 고급 와인을 비교하고 있어. 둘 다 즐길 수 있지만, 같지는 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 8046dc1d-f444-a3d1-5eb1-cf51d82f470d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:8046dc1d-f444-a3d1-5eb1-cf51d82f470d
msgctxt "hc80bf0b1g26efg4d65g8147g8e6232673f0a"
msgid "Whatever it was, I thoroughly enjoyed it."
msgstr "그게 뭐였든 간에, 재미 좀 봤으면 됐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 80a438a6-382a-15ad-6136-04d5cd555637
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:80a438a6-382a-15ad-6136-04d5cd555637
msgctxt "h583697edg1959g4fb8gb59dg58fdd3e04468"
msgid ""
"I existed, that was enough for him. He revelled in having power over me."
msgstr "내가 존재한다는 사실, 그것만으로도 이유는 차고 넘쳤지. 놈은 날 갖고 노는 걸 즐겼거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 82beadb2-296a-64a2-2c4d-bbfe7bf6320e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:82beadb2-296a-64a2-2c4d-bbfe7bf6320e
msgctxt "h9463169eg6b67g4d11gbadfg0f66b3968992"
msgid "As long as you're leaving mine alone."
msgstr "하여튼 내 건 건드리지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 8384ca8b-5b29-ae7a-3772-897506d620be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:8384ca8b-5b29-ae7a-3772-897506d620be
msgctxt "h25787661gacfeg447dg85e2gfc5dc80dda57"
msgid "I still need you."
msgstr "난 아직 네가 필요한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = 862b47d7-18a7-cd8c-2864-46dbbda928b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:862b47d7-18a7-cd8c-2864-46dbbda928b6
msgctxt "h95d475bag6e3eg4a97g8152g60a396e9f156"
msgid "Sounds... delicious."
msgstr "왠지... 맛있게 들려."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 91d40a20-9132-a2f2-b011-ff5b49fc6a19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:91d40a20-9132-a2f2-b011-ff5b49fc6a19
msgctxt "hdb43c6b5gd5a3g46e4gbfbagff3d92e8505f"
msgid "- oh, you meant 'be kinder'? Pet bunnies, that sort of thing?"
msgstr "- 아, 너 '친절해져라'는 거냐? 토끼 쓰다듬는 거, 그딴 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 922cfaaf-25f3-0920-a213-29faefd81bcd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:922cfaaf-25f3-0920-a213-29faefd81bcd
msgctxt "h34765bf8gb294g4b0eg827dg96a848d729d9"
msgid "Still, that was the past. I'll never have to grovel for him again."
msgstr "그래도 그건 과거야. 그 사람을 위해 엎드려 빌 필요는 이제 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 95385a20-827d-ce92-52cb-6995492b681c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:95385a20-827d-ce92-52cb-6995492b681c
msgctxt "h81693962ga54bg489cgb146g6c0b90515aad"
msgid ""
"No, I'll be safe when I'm powerful enough to grind Cazador into the dust. "
"Powerful enough to do whatever the hell I want."
msgstr ""
"아니, 내가 안전해지는 건 카사도어를 먼지로 갈아버릴 수 있을 정도로 강해지고 난 다음이야. 원하는 건 뭐든지 할 수 있을 정도로 "
"강해지고 나서."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 9842a857-6b08-c244-5e50-e85b6e9b2060
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:9842a857-6b08-c244-5e50-e85b6e9b2060
msgctxt "hd766ea54gb9dfg4023g9c2egff3777cff0e8"
msgid "Oh, that. A scratch. I ran afoul of a bear."
msgstr "아, 그거. 긁힌 거야. 곰과 조금 마찰이 있어서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = 9a5bf82b-7ff6-499e-bdd6-2cf08a4d375b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:9a5bf82b-7ff6-499e-bdd6-2cf08a4d375b
msgctxt "h90db8a94ge1bdg4e40gb047gc3386ead0fff"
msgid "Because those with power can do whatever the hell they want."
msgstr "권력을 가진 자들은 뭐든 맘대로 할 수 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = a5a281b2-71b1-8a46-94af-063fb314c79e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:a5a281b2-71b1-8a46-94af-063fb314c79e
msgctxt "hc9e13144g9628g42fdgbc8bgc5cad2c83989"
msgid "Well - look at us. We've never been more powerful."
msgstr "자 - 우리 모습을 봐. 우리는 그 어느 때보다도 강해졌다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = aeced858-f9c9-d997-bc7e-55d6ac92b4e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:aeced858-f9c9-d997-bc7e-55d6ac92b4e6
msgctxt "h8c2694e3gf5d9g4a99gbb8fg807fa43d1eb0"
msgid "You can't look at the world and tell me I'm wrong."
msgstr "네가 이 세상을 보고도 내가 틀렸다고 말할 수 있을까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = b046a21b-e331-ef86-d5b1-0c6b4d35ab66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:b046a21b-e331-ef86-d5b1-0c6b4d35ab66
msgctxt "hbcac2a01gc59dg46e2gbfc9g5c47b20bb34f"
msgid "At your service."
msgstr "무슨 일이든지 말만해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = b2a9c723-6c8c-40dd-5e60-0bd6ff60c372
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:b2a9c723-6c8c-40dd-5e60-0bd6ff60c372
msgctxt "h8eca2fc2g2a2dg46dcgaa49g007904c07593"
msgid "There you are! My friend."
msgstr "이게 누구신가! 내 친구잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = b3fc7a3a-2c10-d3d6-8222-18a475b99aa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:b3fc7a3a-2c10-d3d6-8222-18a475b99aa5
msgctxt "h6af796a7g39d0g4186gba88gd0608e3d21a6"
msgid ""
"Indeed they are. Now that I can walk in the sun - well, that opens all "
"manner of doors."
msgstr "그렇고 말고. 이제 햇볕 아래를 멀쩡히 거닐 수 있어. 음, 말인즉슨 온갖 현관 예절을 무시해도 된다는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = b983fe02-0810-4e3e-9701-23cd1d774094
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:b983fe02-0810-4e3e-9701-23cd1d774094
msgctxt "h035cfda1g4161g406dgabe7gfe2cbc4a309c"
msgid "What happened? Were you attacked?"
msgstr "무슨 일이야? 공격 당했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = ba927f4b-5fe7-3721-9709-9b38bfc2b3a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:ba927f4b-5fe7-3721-9709-9b38bfc2b3a0
msgctxt "h44e41d9eg0386g4a40ga8cfg8708932badf7"
msgid "Are you drunk?"
msgstr "술 마셨어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = bbbcdd46-c397-8717-c0f6-2e102ffdb8ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:bbbcdd46-c397-8717-c0f6-2e102ffdb8ff
msgctxt "hfe20dd3ag6e2ag49c7g97ccgb8abd9fd7c8f"
msgid ""
"Not at all! Blood is life essence. And some creatures have so much more life "
"than others."
msgstr "아니야! 피는 생명의 본질이야. 그리고 어떤 생물은 다른 생물보다 훨씬 더 많은 생기를 가지고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = bc70da36-83f9-a80b-5129-d29be768e2bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:bc70da36-83f9-a80b-5129-d29be768e2bd
msgctxt "h0db7fef5g9de1g41f5gafbcg1721d77980c2"
msgid "True, you can start over. You can be better than what he made you."
msgstr "맞아, 너는 다시 시작할 수 있어. 너는 그 사람이 너를 만들었던 것보다 더 나아질 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = bd6a693d-9edc-759e-bdf3-a56ef4f467db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:bd6a693d-9edc-759e-bdf3-a56ef4f467db
msgctxt "h6522a945g0864g413dg887dgea164467d863"
msgid "Is it? What good is freedom if I'm always watching the shadows?"
msgstr "그런가? 항상 그림자만 보고 있다면 자유가 대체 무슨 소용이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = c0532c6b-3f0c-5e26-7fac-38ad8d21f84f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:c0532c6b-3f0c-5e26-7fac-38ad8d21f84f
msgctxt "h6ff83861ge618g4f6cga425g6cdcd0715f84"
msgid "You think power lets you do anything, free from consequences?"
msgstr "권력이 있으면 무슨 짓이든 할 수 있다고 생각하는 건가? 결과에 대한 책임없이?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = c160a510-7eb2-cd8e-9069-950a4b2a5e94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:c160a510-7eb2-cd8e-9069-950a4b2a5e94
msgctxt "h0d7c810ag401dg4ed6gb94eg0633185bfe14"
msgid "They're doing a piss poor job, then."
msgstr "그럼 놈들은 개똥같이 일을 처리하고 있는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = c8d3c51a-4988-0789-aae6-649ffb62aa96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:c8d3c51a-4988-0789-aae6-649ffb62aa96
msgctxt "h415945c6gff2dg4b67g92efgf7801f407d96"
msgid "Oh I hope so. A little corruption sounds fun."
msgstr "오, 제발 그랬으면. 약간의 부패는 분명 짜릿할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = cc2b8c6c-ff76-9e25-b8f9-3060f9f82e67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:cc2b8c6c-ff76-9e25-b8f9-3060f9f82e67
msgctxt "h5fd8367dgffe6g4f4bg8e62g37764226e7cb"
msgid ""
"Careful, there are heroes about. I'd hate for them to get the right idea "
"about you."
msgstr "조심해, 근처에 영웅들이 있어. 그들이 너에 대해 잘못된 생각을 가지는걸 원치 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = cd13d0ed-39f6-67ef-b048-38dd04c7a3fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:cd13d0ed-39f6-67ef-b048-38dd04c7a3fb
msgctxt "h56a249eagdc5cg414bg8adeg32347be3766c"
msgid "It could open some coffins too."
msgstr "어쩌다 묘지를 열어버릴지도 모르지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = e49b6c0f-493c-0d03-79fd-ad52a65661a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:e49b6c0f-493c-0d03-79fd-ad52a65661a8
msgctxt "h0829d2a1g6454g4044g9b6dg86ec3b26888b"
msgid ""
"Let them. Heroes are half the damn problem. Fools that believe in right and "
"wrong - good and evil."
msgstr "알게 뭐야. 영웅들은 그 빌어먹을 문제의 절반이야. 옳고 그른 것, 선과 악을 믿는 바보들."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = e84c9a49-d66d-ce0f-7d5b-628fe5f3c55c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:e84c9a49-d66d-ce0f-7d5b-628fe5f3c55c
msgctxt "hec24259bg3d46g4b6fgaea8gd8c9a4920ebe"
msgid ""
"I've no objection to being nice, of course. Once I have the power to bend "
"others to my will."
msgstr "물론, 나는 친절해지는 것에 반대하지 않아. 일단 다른 사람들을 내 뜻대로 움직일 수 있는 힘을 얻으면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = e8aaaa8d-5f43-d6e8-dc1a-b5968d2007bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:e8aaaa8d-5f43-d6e8-dc1a-b5968d2007bd
msgctxt "hcf0f18b9g9f02g4fe7g9dabg1716830db367"
msgid "Are you now? Don't make promises you can't keep, darling."
msgstr "지금 말이야? 지키지도 못할 약속은 하지 말라고, 자기."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Player
#. NodeID = f35049ee-ef93-af2f-d24d-04ee93216b3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:f35049ee-ef93-af2f-d24d-04ee93216b3b
msgctxt "hcd6c073fg3812g40e5g9fd3ge63003a039a2"
msgid "The strong have a duty to protect the weak."
msgstr "강자는 약자를 보호할 의무가 있는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = fcd6b654-f2e2-fda2-0174-b6777b992095
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:fcd6b654-f2e2-fda2-0174-b6777b992095
msgctxt "hb7ab7707gd036g4c1egba14ge379fd98e4ef"
msgid "I have drunk. Not alcohol, of course. A bear."
msgstr "마셨지. 물론 술은 아니고. 곰이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear
#. Speaker = Astarion
#. NodeID = fdf150d0-e97a-8b6f-64b4-c8c151d2d46d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_DrunkBear:fdf150d0-e97a-8b6f-64b4-c8c151d2d46d
msgctxt "h3a2c0820gb9bbg4828gb181gbd59090a6376"
msgid ""
"The mind flayers gave us power, but left us to our own devices. Whatever "
"they had planned for us, they failed."
msgstr ""
"마인드 플레이어들은 우리에게 힘을 주었지만, 우리를 제어하지는 못하고 있지. 그놈들이 무엇을 계획하고 있었던 간에, 놈들은 실패한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 01e97b37-bd06-beb6-9fd7-4815f1fc3f70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:01e97b37-bd06-beb6-9fd7-4815f1fc3f70
msgctxt "h8cf3c77bgf30bg46fagba92g02293240d2c1"
msgid ""
"This is meant to be flattery, not poetry. Just tell me I'm beautiful and we "
"can call it a day."
msgstr "이건 시적인 게 아니라 치켜 세우는 거잖아. 그냥 내가 아름답다고 말해주고 마무리 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 053af73c-a7ab-d878-3fae-0f16a93a4f52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:053af73c-a7ab-d878-3fae-0f16a93a4f52
msgctxt "ha8749e39g150dg4cc0g98f9g2c951d3ddd91"
msgid "Oh pardon, I didn't want to inconvenience you with my age-old curse."
msgstr "오, 미안해. 나의 나이 안먹는 저주가 널 불편하게 했나봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 084a0bba-60b5-95d2-c5c9-e5128164fa8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:084a0bba-60b5-95d2-c5c9-e5128164fa8e
msgctxt "h90f1a7fbgdb26g4a0bgbf4cg3694073523c0"
msgid "Just looking. What are you doing?"
msgstr "그냥 보고 있어. 넌 뭐하고 있는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 0f8a26c8-95f0-340f-6d4c-bd57e14a176b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_IsInParty = True
#.   Tag:
#.      - REALLY_GALE(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:0f8a26c8-95f0-340f-6d4c-bd57e14a176b
msgctxt "ha27c74a4g0821g4d39g958eg36d2bad5930e"
msgid "You're pretty good. Not 'Gale' good, but pretty good."
msgstr "너도 꽤 아름답지. '게일' 만큼은 아니지만 꽤 괜찮아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 1d0f0bca-02a8-7817-3149-fa43fe46d237
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:1d0f0bca-02a8-7817-3149-fa43fe46d237
msgctxt "h0e06e63bg478cg4b12ga76fg299363adfba3"
msgid "Very good. Now just tell me I'm beautiful and we can call it a day."
msgstr "아주 좋아. 이제 내가 아름답다고 말해주고 그만 끝내자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 20a8cb3d-eb3b-c030-20db-8f819cd5b7fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:20a8cb3d-eb3b-c030-20db-8f819cd5b7fc
msgctxt "hcde3f7d5g96e6g4802g8127g108b73943b76"
msgid "Your mole definitely grabs my attention."
msgstr "네 얼굴의 점이 확실히 내 관심을 끄는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 2272d7b8-2be6-d854-3bdd-b17478dc0850
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:2272d7b8-2be6-d854-3bdd-b17478dc0850
msgctxt "h195700a8g6e50g468dgaa38gabe05b965b0c"
msgid "So is the tadpole causing all that sagging skin, or..."
msgstr "그럼 그 올챙이가 그 주름진 피부를 받치고 있는 건가, 아니면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 23b45bed-7901-477a-d8a5-c4bd956c383d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:23b45bed-7901-477a-d8a5-c4bd956c383d
msgctxt "h356cce95gddf6g4799ga4a2gecf736984897"
msgid "I see you."
msgstr "널 보고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 37026b1d-2a0e-fcc6-3600-eed663c46b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:37026b1d-2a0e-fcc6-3600-eed663c46b6b
msgctxt "hbd46ec85g1156g4045g94fdgdab0805cbdee"
msgid "Another quirk of my affliction."
msgstr "내 불행의 또 다른 특징이지 뭐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 38d413c0-f1bc-fcb2-91d1-66551fe8b6ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:38d413c0-f1bc-fcb2-91d1-66551fe8b6ae
msgctxt "ha4cc3088ga37fg4fe7gba22gb7503a15a10b"
msgid "An elven vampire spawn, approximately 5'11\", medium build..."
msgstr "엘프 뱀파이어 스폰, 키는 180cm 정도, 중간 체격에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 3955c822-53b3-813f-7e57-027205fbaa38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:3955c822-53b3-813f-7e57-027205fbaa38
msgctxt "h2ec3bf9bgbfc5g4b13g88a4g4e3fcac7da94"
msgid "Do you miss it? Seeing your own face?"
msgstr "그리워? 네 얼굴을 보는 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 3d791fcc-b6b4-9dc0-5df0-11cd77086901
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:3d791fcc-b6b4-9dc0-5df0-11cd77086901
msgctxt "h9ce300b6g6f23g4f08g87abg9ab1c95fa8d6"
msgid ""
"I'd better get some beauty sleep. It seems I need it if I'm to catch up with "
"the competition."
msgstr "미용 수면을 좀 취해야겠어. 경쟁에서 따라 잡으려면 그게 필요할 것 같으니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 3e9cfad5-a50e-b031-2d82-bd1e6f9d0d3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:3e9cfad5-a50e-b031-2d82-bd1e6f9d0d3a
msgctxt "hec90c374g6f93g4087g856dg89f3819cafb6"
msgid "When you smile, your face wrinkles. It is comforting."
msgstr "네가 미소 지으면, 얼굴에 주름이 잡히지. 편안한 느낌이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 3ed8090d-5bae-071f-56f3-e2609db82c9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:3ed8090d-5bae-071f-56f3-e2609db82c9a
msgctxt "h485cd98fgd4dcg4ac2gbb87gf32e4c6f7e19"
msgid "Your mole is impressively large."
msgstr "네 얼굴의 점이 인상적인 크기인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 3f744589-2842-8783-782f-811c192ce61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:3f744589-2842-8783-782f-811c192ce61e
msgctxt "h8c830e01gc0feg4137gb2c4g7a0ef0f854b2"
msgid "Mirrors aren't much use, but being reflected in someone else's eyes?"
msgstr "거울은 별 쓸모가 없지만, 다른 사람의 눈에 비춰질 때는?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 3fec15b2-e0f6-4d05-ce17-bce14a4a8500
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_Mirror_MentionedMole(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:3fec15b2-e0f6-4d05-ce17-bce14a4a8500
msgctxt "hd4e4f35ag7f61g42e5gaf50gdf5be6a21bb3"
msgid "My - what? But I don't..."
msgstr "내 - 뭐라고? 그런데 난..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 4352e559-e8ed-ed9b-3f1b-46b0eeb44cc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:4352e559-e8ed-ed9b-3f1b-46b0eeb44cc0
msgctxt "h2c4d3eb0gde77g46e9gbab9gb66710a9d369"
msgid "To you, maybe. To me it's just another thing Cazador took."
msgstr "너한테는 그럴지도. 나한테는 카사도어가 가져간 그저 또 하나의 것일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 44834d41-c724-ef7e-c2f8-87630a66cd01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:44834d41-c724-ef7e-c2f8-87630a66cd01
msgctxt "h2bdaaac2geddbg4e45gbf1bg2db4b5ca51ee"
msgid "<i>Stare into his eyes, taking in every detail of his face.</i>"
msgstr "<i>그와 눈을 마주치고, 그 얼굴의 특징을 꼼꼼히 살핍니다..</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 488811e3-c246-7200-b430-6eee9de45940
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:488811e3-c246-7200-b430-6eee9de45940
msgctxt "h1f96890ag33d5g488bgaeddg47ec05418505"
msgid "Is it? What do you see when you look at me?"
msgstr "그래? 나를 바라보면 넌 뭐가 보이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 4903d75d-16af-7231-0fb4-d38e9bc10742
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:4903d75d-16af-7231-0fb4-d38e9bc10742
msgctxt "h9b285840g49a8g4d38ga0bfge92166fb2d5c"
msgid "I'm a vampire - forever young."
msgstr "나는 뱀파이어야 - 영원히 젊다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 4d8a46c9-1d64-fb5e-cf67-226a51824fdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:4d8a46c9-1d64-fb5e-cf67-226a51824fdc
msgctxt "hd542732dged0cg4f7ega6bcgd5b611566a0f"
msgid "Looking at something?"
msgstr "뭘 보고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 5395740b-6d21-c186-b5ea-814e479dc84e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:5395740b-6d21-c186-b5ea-814e479dc84e
msgctxt "h6d155891ge8cdg4ccdg8885gd8d32ccab5a2"
msgid ""
"I've never even seen this face. Not since it grew fangs and my eyes turned "
"red."
msgstr "난 이 얼굴을 한 번도 못 봤어. 송곳니가 돋고 눈이 빨갛게 변한 이후로."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 57148c04-e887-0bb4-dfe8-f08a0412035f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:57148c04-e887-0bb4-dfe8-f08a0412035f
msgctxt "h5a83732bge987g4d78g9fb1gd4f0d53494e8"
msgid "Your unsightly mole..."
msgstr "네 얼굴의 볼품없는 점..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 5d5b8bc8-d5db-91cb-415c-81a8c716117d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:5d5b8bc8-d5db-91cb-415c-81a8c716117d
msgctxt "h0b4931fdg991bg41f3gb309g873c40150610"
msgid "Suit yourself."
msgstr "좋으실 대로."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 5e7ee629-f316-19c0-71a5-cefd51f8fc8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:5e7ee629-f316-19c0-71a5-cefd51f8fc8c
msgctxt "h5874b2fcgbc9fg4bfdg8380gf668a51834e8"
msgid "How dare you! I thought we had something special."
msgstr "어떻게 그럴 수 있어! 우리가 특별한 사이라고 생각했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 5fc6e329-2246-8090-ba76-08ab6aa46165
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:5fc6e329-2246-8090-ba76-08ab6aa46165
msgctxt "h0f8c7372g5364g4254g90abgacc17a17ea6e"
msgid "You're beautiful."
msgstr "너는 아름다워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 625c2e48-93ff-063e-c5cf-e83d4be2a61a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:625c2e48-93ff-063e-c5cf-e83d4be2a61a
msgctxt "hf0ae9813gc471g495bgb70dg8549ec221168"
msgid "Sure, but was your mole always so... prominent?"
msgstr "알았어, 근데 네 얼굴에 있는 점이 항상 이렇게... 두드러졌어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 69b92f3a-2296-522f-eeba-a6de718e02fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:69b92f3a-2296-522f-eeba-a6de718e02fc
msgctxt "ha6664d2cgdbc3g4c56gbcf7gdf5647959107"
msgid "Observant."
msgstr "관찰력이 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 6be6a98c-8187-c63d-6fec-eeba6879c005
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:6be6a98c-8187-c63d-6fec-eeba6879c005
msgctxt "h5ecfdb7cg29c6g4ef3g8a7cg15e815d28d99"
msgid "I see someone wasting my time."
msgstr "내 시간을 좀 먹는 사람이 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 7446aec6-c1c0-d462-c7a9-601846ac6ec3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:7446aec6-c1c0-d462-c7a9-601846ac6ec3
msgctxt "h60594070g73ddg4c99g98fag7b76b894ea42"
msgid "The creases when you laugh."
msgstr "웃을 때 생기는 팔자 주름."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 76922b41-8753-fd97-0cac-81534429afdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:76922b41-8753-fd97-0cac-81534429afdc
msgctxt "hd0369afagd052g4dd1ga311gd6ec2b062264"
msgid ""
"It's an indulgence, I'll grant you, but a weakness? A well-presented face "
"can open a lot of doors."
msgstr "이건 자아도취지, 네 말 인정하지, 하지만 약점일까? 잘 꾸민 얼굴은 많은 문들을 열 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 795da8b6-c9f6-3dcc-7ba8-f9c18360b795
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:795da8b6-c9f6-3dcc-7ba8-f9c18360b795
msgctxt "h10064e3bgb0a6g4593gb68ag6df612812118"
msgid "Oh. Go on..."
msgstr "오. 계속해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 7b94a9da-a259-fba2-bf22-9b9ce085cff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:7b94a9da-a259-fba2-bf22-9b9ce085cff4
msgctxt "h21b4da8bg8b0dg46fag90dag3263edbad2c3"
msgid "Is that all you want? Shallow praise?"
msgstr "네가 원하는 게 그게 전부야? 얄팍한 칭찬?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 85aa2854-e4b0-2589-00f8-187e49ecade3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:85aa2854-e4b0-2589-00f8-187e49ecade3
msgctxt "hd888ba3fg71e7g45c6g8dfdg0f0f70b6a1e4"
msgid "You can do better. What else?"
msgstr "더 잘 말해줄 수 있잖아. 다른 건?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 87ff83af-8787-9c26-61bf-6c17fcc35f26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:87ff83af-8787-9c26-61bf-6c17fcc35f26
msgctxt "h823b3ecdgc0cdg4f38gb87dge48a9a3b0a4e"
msgid "But failing any of those, I will always settle for shallow praise."
msgstr "하지만 그런 것들을 얻지 못한다면, 얄팍한 칭찬에 만족 해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 8d91c3b7-810e-6825-ea7a-c5365560d58f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_State_IsInParty = True
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:8d91c3b7-810e-6825-ea7a-c5365560d58f
msgctxt "h8b1e3433g3e87g45d3gb255g4e116b0689bf"
msgid "Karlach is beautiful. You're fine, though."
msgstr "칼라크는 아름다워. 너도 괜찮은 편이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 9015adf4-6367-ecff-d3bb-ee056151c41f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:9015adf4-6367-ecff-d3bb-ee056151c41f
msgctxt "h88c136f2g67bbg4ea5g8cd8g7b1ad3b1907b"
msgid "That dangerous smile."
msgstr "살인 미소."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 90a1e2ad-28bf-cf9e-445a-94557835906b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:90a1e2ad-28bf-cf9e-445a-94557835906b
msgctxt "hb22ea090gb805g4759g9a33g6c410eae34d4"
msgid "It's for the best, you're not exactly ageing gracefully."
msgstr "그래도 나은 거야. 넌 확실히 우아하게 늙지는 않으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 92a18a95-a950-f519-aa07-40be533ae749
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_Mirror_MentionedSkin(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:92a18a95-a950-f519-aa07-40be533ae749
msgctxt "h7590ec83g74d1g4cd4ga2b6gb5d7061cc4ea"
msgid "What are you talking about? My skin isn't... is it?"
msgstr "무슨 소리야? 내 피부가... 설마?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 93de2fa0-5b96-34d4-4bff-03d94cbb41fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:93de2fa0-5b96-34d4-4bff-03d94cbb41fa
msgctxt "h3b000295gb3d3g4959gb12bg81b9b80aff35"
msgid "Have a good night."
msgstr "좋은 밤 되길."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 99d88343-321d-0396-e8ee-ba3fe00c1998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:99d88343-321d-0396-e8ee-ba3fe00c1998
msgctxt "ha6482c6ag7df2g427fg9c99gddba50397bd5"
msgid "My face is just some dark shape in my past. Another thing I've lost."
msgstr "내 얼굴은 그저 내 과거의 어두운 형상일 뿐이야. 내가 또 하나 잃어버린 것."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 9d14c79a-02e5-d47d-52eb-fd38bd64bddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:9d14c79a-02e5-d47d-52eb-fd38bd64bddc
msgctxt "hbb6922c1g0943g46e9g8e57gfe097b4e9ce0"
msgid "Excuse me? I'm an eternally young vampire, not your doting grandmother."
msgstr "저기? 나는 영원히 젊은 뱀파이어야, 너의 노망난 할머니가 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = 9d1801af-3108-a67c-8a42-5ee8db2c44f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_State_IsInParty = True
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:9d1801af-3108-a67c-8a42-5ee8db2c44f9
msgctxt "h907960ddg550fg442fgaf91gdd8ed2db18c3"
msgid "Honestly, Wyll's more my type."
msgstr "솔직히, 윌이 더 내 타입이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = 9ecbdb58-a463-6e10-abc1-85aece2a9820
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:9ecbdb58-a463-6e10-abc1-85aece2a9820
msgctxt "hc56753c6g8794g4866gb42cg6bf58921293f"
msgid "Funny. And what do you see, exactly?"
msgstr "우습군. 그래, 뭐가 보이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = a0d96bd1-62c8-3432-f38c-4a2ff9a9e76b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:a0d96bd1-62c8-3432-f38c-4a2ff9a9e76b
msgctxt "h7f8a5880g40f5g464ega056gc0182b8a46eb"
msgid "Really? Anything in particular?"
msgstr "정말? 뭐가 특히 그런데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = a578116e-efca-16b3-680b-f01eb895fac6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_IsInParty = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:a578116e-efca-16b3-680b-f01eb895fac6
msgctxt "hbc582720g1155g4ec6g95a0gc2e427d626dc"
msgid "You don't have Lae'zel's charm, but you're all right."
msgstr "레이젤만큼 매력적이진 않지만, 썩 괜찮은 인물이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = a8e5f924-e6de-3873-4e90-fd1bd97d464b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:a8e5f924-e6de-3873-4e90-fd1bd97d464b
msgctxt "h6f1537f2g6cd9g41b6gab43g49646ed41cd0"
msgid "I'm looking too, but not seeing very much."
msgstr "나도 보고 있는 중이야, 그런데 잘 안보이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = af3f9c01-7389-4ba7-37fc-336910740a78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:af3f9c01-7389-4ba7-37fc-336910740a78
msgctxt "he3a086d9gbc19g4f45g8eabg7a662c0b9f92"
msgid ""
"Despite being neither brave nor intelligent, you are one of the finest "
"killers I've ever seen."
msgstr "비록 용감하지도 똑똑하지도 않지만, 내가 봤던 가장 훌륭한 살인자 중 하나야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = afe09da0-74c1-b26b-97fc-4b22ec5995fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:afe09da0-74c1-b26b-97fc-4b22ec5995fe
msgctxt "haae72f49gc264g4e61ga7a1ga39113b4a786"
msgid "It's a small price to pay for a vampire's power."
msgstr "뱀파이어의 힘에 대한 대가 치고는 저렴하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = b3a4cb3c-ff96-5a76-1503-4bab9c9ae197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:b3a4cb3c-ff96-5a76-1503-4bab9c9ae197
msgctxt "had229dc5g0fecg4abag99ceg79098a677276"
msgid "No, I was just leaving."
msgstr "아니, 막 가려던 중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = b96ec4d0-ea8d-94b0-6745-0f2f4a6c9520
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:b96ec4d0-ea8d-94b0-6745-0f2f4a6c9520
msgctxt "haf3ee765gc7abg4e72g8033gc1755ab4ac8b"
msgid "The only benefit to a mirror when you have my condition."
msgstr "내 증상의 유일한 장점은 거울을 보는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = bb89be87-b6ff-0669-dd24-9eaf39d62613
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:bb89be87-b6ff-0669-dd24-9eaf39d62613
msgctxt "h49b4d54cgaf98g47d3g8e90ga587057d6a59"
msgid "What?"
msgstr "왜 이래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = bf70c6ea-88e7-bc77-4ce9-94a7d736bc96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:bf70c6ea-88e7-bc77-4ce9-94a7d736bc96
msgctxt "h83f7857egde7cg439egb910g66e824bb9e66"
msgid "...Excuse me."
msgstr "...실례하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = c0ff68b0-6401-acb3-5a04-0610996893b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:c0ff68b0-6401-acb3-5a04-0610996893b4
msgctxt "h9b103618ge8a7g4aaeg9aacgb676fbd0d0b5"
msgid "Hardly. There's also gold, sex, revenge - quite the list, really."
msgstr "전혀 아니야. 금화, 섹스, 복수... 이게 진짜로 원하는 것들이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = c175dd95-7205-258c-ac63-4a5145d6357e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:c175dd95-7205-258c-ac63-4a5145d6357e
msgctxt "h07b732ebgc60fg4f2bgafcaga085fc57b2ec"
msgid "Ageing? What do you mean 'ageing'?"
msgstr "늙는다고? '늙는다'라는 게 무슨 의미야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = c3a4fffd-1fd8-89d3-189a-7c50bf8f462a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:c3a4fffd-1fd8-89d3-189a-7c50bf8f462a
msgctxt "hbe904425gf4ddg4beegafdfgecd32c7c51f4"
msgid ""
"Let's leave it there, shall we? It's been a long day and I've had all the "
"compliments I can take."
msgstr "여기서 마무리 하자, 응? 오늘은 내가 받아 들일만한 칭찬을 받기엔 너무 긴 하루였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = cb0842e3-1814-1270-0979-8694a7c1a4ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:cb0842e3-1814-1270-0979-8694a7c1a4ca
msgctxt "h0c2ff412g7823g4f42gaf51g8dece61cb7f6"
msgid "The way your hair curls around your ears."
msgstr "네 머리카락이 귀를 감싼 모습."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = cc590e39-e6d4-a000-93e4-16a25a92942b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:cc590e39-e6d4-a000-93e4-16a25a92942b
msgctxt "h6d59f7ccg7034g4588gb6aagc374639c8ab3"
msgid "What colour were they before?"
msgstr "전에는 어떤 색이었는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = cdb789d8-5fff-9ad5-f7b3-88d08595e102
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:cdb789d8-5fff-9ad5-f7b3-88d08595e102
msgctxt "h9a7b36f9gded7g44d9g89bcgcc1a2d717095"
msgid "I'll be your mirror. What do you want to know?"
msgstr "내가 너의 거울이 되어 주지. 알고 싶은 게 뭔데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = cf07adff-0777-dd1f-5273-43dcef10b522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:cf07adff-0777-dd1f-5273-43dcef10b522
msgctxt "h56139396g43fcg4419ga132g5dd1c13aa1b5"
msgid ""
"Not that I've seen this face. Not since it grew fangs and its eyes turned "
"red."
msgstr "이 얼굴을 본 적이 없어. 송곳니가 돋고 눈이 빨갛게 변한 이후로."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = d29f8343-79f9-0bad-74d1-2cc03b1b5737
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_ShadowHeart_State_IsInParty = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:d29f8343-79f9-0bad-74d1-2cc03b1b5737
msgctxt "hd2011626geeaag4da0g8875g113dcbb656de"
msgid "You're fine. Now Shadowheart - there's a beauty!"
msgstr "너도 괜찮지만. 섀도하트가 진짜 미인이지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = d6c82e32-2202-632a-9523-d3cec42f265a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:d6c82e32-2202-632a-9523-d3cec42f265a
msgctxt "he3ffb667g2143g4ad3g8436gc9f8230d189b"
msgid "Count yourself lucky. I have to see this mug every day."
msgstr "운 좋은 줄 알라고. 난 이 얼굴을 매일같이 봐야하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = d95449ed-3ce8-7c20-099d-d85fdd764e4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:d95449ed-3ce8-7c20-099d-d85fdd764e4a
msgctxt "ha38cc47egf0f3g48ffgb347g483fdbf925fe"
msgid "Strong, piercing eyes."
msgstr "강하고 날카로운 눈."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = db891b3a-29ed-697c-ea2d-f5aeee617e2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:db891b3a-29ed-697c-ea2d-f5aeee617e2b
msgctxt "h7eeb6dd0g102dg459fg9a0cg27631bd8e7f6"
msgid "I'm kidding, you look great."
msgstr "농담이야, 너 굉장히 잘 생겨보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = dbd47f00-5b42-08ee-c89d-fa87bf46c7ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:dbd47f00-5b42-08ee-c89d-fa87bf46c7ad
msgctxt "h8b6f00c1g3888g45edg9f88gfa3bf2ac8709"
msgid "I... I don't know. I can't remember."
msgstr "나... 나도 모르겠어. 기억이 나지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = dcba9124-47e3-efb2-1bbf-e59d1d550e1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:dcba9124-47e3-efb2-1bbf-e59d1d550e1e
msgctxt "hc777e7beg3f56g42e5g967cg9517005a3093"
msgid "Your eyes are pleasing."
msgstr "네 눈은 보기가 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = dde71352-41a3-d643-405b-94b087763c12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:dde71352-41a3-d643-405b-94b087763c12
msgctxt "hc88a63eeg083ag40b5g96cbg3895cf14e605"
msgid "Gods above. Would it kill you to dispense a compliment?"
msgstr "신이시여. 칭찬 한 번 하면 어디가 덧나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = e028a110-ced8-8ca9-8b5b-fb5ef2181ead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:e028a110-ced8-8ca9-8b5b-fb5ef2181ead
msgctxt "h080c3119gbc86g440bg86f2gf24708f2a662"
msgid "It doesn't quite make up for the lack of a reflection, mind you."
msgstr "뭐랄까, 반사되지 않는다는 단점을 보완할 수는 없겠지만 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = e304f049-faa8-ab8e-f5f2-fd96752a72d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:e304f049-faa8-ab8e-f5f2-fd96752a72d8
msgctxt "h0155fe37ge362g474ag936ag26302a2897b3"
msgid "You have nothing to worry about - it's a very good face."
msgstr "걱정할 필요 없어 - 매우 훌륭한 얼굴이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = e37f1f28-abf7-6faa-4293-3e823cac1d53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:e37f1f28-abf7-6faa-4293-3e823cac1d53
msgctxt "h43eb97bcg943dg4d49gaa91g9fd17371c1f8"
msgid "...Right. I, um..."
msgstr "...그래. 나는, 음..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = eda867ec-4ca8-de7e-37c1-04cc37694efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:eda867ec-4ca8-de7e-37c1-04cc37694efb
msgctxt "h5679aa69gbbceg4852g8e30gc8b3d13c0346"
msgid "I want to know what the world sees when it looks at me. What you see."
msgstr "세상이 날 볼 때, 무엇이 보이는지 알고 싶어. 네가 볼 때도 그렇고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = ef306046-0493-43d2-549e-f368c2792836
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:ef306046-0493-43d2-549e-f368c2792836
msgctxt "h43f4c3fcg78f0g421bga412gb54c39ba9752"
msgid "For you maybe, but I like what I see."
msgstr "너한테는 그렇겠지. 하지만 내가 보기엔 마음에 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = f2124b4a-ebe1-f614-436d-e7d9453e3c22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:f2124b4a-ebe1-f614-436d-e7d9453e3c22
msgctxt "h96b04c77g9fcdg4bbbg9a95g98a3a7f02cd6"
msgid "Vanity is a weakness."
msgstr "허영심은 약점이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = f2c7efec-8a3c-ca0a-b4ff-650b2aabb2cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:f2c7efec-8a3c-ca0a-b4ff-650b2aabb2cb
msgctxt "he21ce101gc43eg4e95gb9ffgef0b25907335"
msgid "Still. You're nice too."
msgstr "그래도 넌 참 좋은 사람이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = f36802e0-9b76-919f-b081-57560dac326e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:f36802e0-9b76-919f-b081-57560dac326e
msgctxt "h210f9c32g3398g4ae3g81e9ge42c9b2ed5bc"
msgid "And what do you see, exactly?"
msgstr "그래서, 정확히 뭐가 보이는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = f5faa5a2-bc10-425a-8399-ad26bdea5a3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:f5faa5a2-bc10-425a-8399-ad26bdea5a3b
msgctxt "hd74b0740gb216g46eagacd5g242c163b39cf"
msgid "Well, I could do worse."
msgstr "뭐, 그래도 나쁘지 않네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Player
#. NodeID = feaa65da-6a80-f560-54b2-8b30e3ee7453
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:feaa65da-6a80-f560-54b2-8b30e3ee7453
msgctxt "h2bbdef0ag0fe1g488bga792g7f226dbfb4d6"
msgid "How did you know I was here?"
msgstr "내가 여기 있는줄 어떻게 알았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror
#. Speaker = Astarion
#. NodeID = ffe8f6bb-42a9-010c-449d-30bbc6aa2b6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_Mirror:ffe8f6bb-42a9-010c-449d-30bbc6aa2b6c
msgctxt "hfbad7f99g9c4bg4ce5g8a5fge23bdd34f4f7"
msgid "Preening in the looking glass? Petty vanity? Of course I miss it."
msgstr "거울 앞에서 뽐내는 거? 하잖은 허영심? 물론 그립지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 02504ff3-c2b1-c11b-ce7d-221a1a5bc6a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:02504ff3-c2b1-c11b-ce7d-221a1a5bc6a1
msgctxt "hd2690b75gbe24g4ad8g96bagecbe91de418c"
msgid "They're just symbols, arranged in a circle."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 0308e722-6248-4817-9d9c-5ad8385c8da3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:0308e722-6248-4817-9d9c-5ad8385c8da3
msgctxt "ha96dea5ag98e0g4445g850fg11eef7d273a5"
msgid "Did you ever see Cazador write in Infernal before?"
msgstr "카사도어가 지옥어로 글을 쓰는 걸 본 적 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 0326a9a9-d9a6-0957-3b0a-bb74d96616b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:0326a9a9-d9a6-0957-3b0a-bb74d96616b7
msgctxt "he669c7f8g76d8g4c1fg842bg68cf3b9d6cd9"
msgid "It's easy for some of us."
msgstr "우리한테는 읽기 쉽지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 0383be31-9695-c172-46af-434aa8244fe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:0383be31-9695-c172-46af-434aa8244fe6
msgctxt "h74ddede4g57d7g4388gb0c8g5329ed0e08a6"
msgid "Bloody Infernal - how is anyone meant to read this garbage?"
msgstr "망할 지옥어 같으니. 이딴 걸 어떻게 읽으란 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 053a7c04-8bc1-68b1-27f8-85e09ca3037a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:053a7c04-8bc1-68b1-27f8-85e09ca3037a
msgctxt "h1f2f4700g2392g4cb6ga719g791cb88ce733"
msgid "You're right, it's not. Good luck."
msgstr "맞네, 내 일이 아니지. 알아서 잘 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 054d0ec3-b3b0-304e-63ee-907fea1ca632
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:054d0ec3-b3b0-304e-63ee-907fea1ca632
msgctxt "hcea0ff05g4b81g4f0eg8ef8ga52fdbfe9236"
msgid "Yes, but you can read it? You can tell me what it says?"
msgstr "그래. 하지만 읽을 순 있겠어? 뭐라고 하는지 말해 줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = 068ed83d-bc93-5a4b-597c-62731c720851
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:068ed83d-bc93-5a4b-597c-62731c720851
msgctxt "ha59ebb73g11b4g46e3g98b3gf1da08f6eced"
msgid ""
"*You examine his face, but all you can see are sneering fangs. His defences "
"are up and you're not getting past them.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 06b14e51-e800-2f4a-3dc1-ed5ac8e788aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:06b14e51-e800-2f4a-3dc1-ed5ac8e788aa
msgctxt "h024a09e4gf4ffg409ag8334ge23c02a4d800"
msgid "Want me to take a look?"
msgstr "내가 한번 봐 줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 06fda991-7078-7b70-ba9c-96506ba435b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:06fda991-7078-7b70-ba9c-96506ba435b6
msgctxt "h0d92c99dg5066g4451gae43gc6fc7305dc4b"
msgid "What? I - well, maybe you could have a look."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 0952cd4b-53a4-ea6d-e032-63323401bab8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:0952cd4b-53a4-ea6d-e032-63323401bab8
msgctxt "h5fa9b335g757ag4d94ga844gf61dfdef0aab"
msgid "More dangerous than you thought, perhaps. I've never had any doubt."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 09f0cb11-191d-24d0-1146-5b4b39b19f42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:09f0cb11-191d-24d0-1146-5b4b39b19f42
msgctxt "h0aa972b0g2f86g430ag9782g585ffb123a86"
msgid "What in the hells..."
msgstr "이게 대체 무슨..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 11d502c0-555f-e3e3-e361-509dde4aee3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:11d502c0-555f-e3e3-e361-509dde4aee3d
msgctxt "h19156a9fgfed4g4321g945egdc50c45e97bf"
msgid "Yes, I can read it if you turn around."
msgstr "그래. 돌아서면 읽어줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 15236594-eb70-586c-9bdd-786368967082
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:15236594-eb70-586c-9bdd-786368967082
msgctxt "h3b0fbbe8gb26bg4239g9414g048bca632ac1"
msgid "Whatever you find, you don't have to deal with it alone."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 17b0a3a8-9e5b-3427-e539-8eaf3609ea78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:17b0a3a8-9e5b-3427-e539-8eaf3609ea78
msgctxt "hc21d5bcag7905g4507gad97g8dd74c418e2a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 18379baa-b9cf-a52f-9998-aa50a735c973
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:18379baa-b9cf-a52f-9998-aa50a735c973
msgctxt "hbdfeb4d2gb04fg474fga875g5f76d6037ac6"
msgid "If this is part of a contract, where's the rest?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 1fbaa1c1-dfe8-7a79-2d62-247c7d5d02ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:1fbaa1c1-dfe8-7a79-2d62-247c7d5d02ee
msgctxt "h3a3bdf0bg554fg45e1gbc7cg09728129b0a3"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 209c495f-7f4c-4ab5-da1f-a2e9ea39ffdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:209c495f-7f4c-4ab5-da1f-a2e9ea39ffdc
msgctxt "h75a22d1cg3f55g4715g8911g69602034f801"
msgid "Just make sure it doesn't get us killed, all right?"
msgstr "그게 우릴 죽이지만 않도록 해줘, 알겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 20e42af4-5c03-3ad6-a758-032f03ce20b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:20e42af4-5c03-3ad6-a758-032f03ce20b8
msgctxt "h6260071fg0500g437bga5c9g66a280281159"
msgid "I suppose we will."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 2116d627-04c8-7949-7983-9c47b69fc5ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:2116d627-04c8-7949-7983-9c47b69fc5ae
msgctxt "h9e727208g44c6g46eeg8ffdg95ec8cc72c60"
msgid "Infernal? Are you sure? Can you show me?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 273322bf-b11e-2ad0-1117-b329d574ec75
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:273322bf-b11e-2ad0-1117-b329d574ec75
msgctxt "h652d2c4fg384bg4e43gaa3dgfaecef9cf6c9"
msgid "<i>Examine the runes, trying to identify the script.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 2839cb79-de09-1bb8-574b-49efc4b94b28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:2839cb79-de09-1bb8-574b-49efc4b94b28
msgctxt "hc1bb42f1gea6bg4d3ega9bfg642421a84ac2"
msgid ""
"What are these symbols? There must be something you can tell me about them?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 28d1538a-22f9-5b1d-63d5-1cef307d557b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:28d1538a-22f9-5b1d-63d5-1cef307d557b
msgctxt "h941b0abfg207bg42e8g9ee3g15ee9f9f6482"
msgid "I'm sure he can. A shame it took a deal with a devil to unravel this."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 29dc1a8f-0b71-fa68-cd7d-db413104091b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:29dc1a8f-0b71-fa68-cd7d-db413104091b
msgctxt "hdb508b62ge929g494egb78bg34a9952f29cb"
msgid "In my own time."
msgstr "때가 됐을 때."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = 2a549daf-c395-a83b-b006-ea51f8152753
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:2a549daf-c395-a83b-b006-ea51f8152753
msgctxt "h78eec18eg6fe5g488ag94d8g396e8300d209"
msgid ""
"*The runes are carved in deep, brutal strokes, but the jagged letters mean "
"nothing to you. Whatever language this is, you don't recognise it.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 2b234ce5-61ff-5353-8cdb-adadb3dad97e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:2b234ce5-61ff-5353-8cdb-adadb3dad97e
msgctxt "h3221c348gb1afg488dgaafdg9ee0e8fec1f0"
msgid "We should tell the others. They might be able to help."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 2c9b3e2e-8f59-694e-ed8f-f180ef226072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:2c9b3e2e-8f59-694e-ed8f-f180ef226072
msgctxt "h7b39c898g0abfg463bg9469gdf7555c57046"
msgid "Does it matter? You're free of him now."
msgstr "그게 중요해? 넌 이제 그로부터 자유를 얻었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 2e36f96a-716a-39c4-062e-ecab3706b408
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:2e36f96a-716a-39c4-062e-ecab3706b408
msgctxt "h9ca75dd9g27ecg470eg863fg4d218552bb92"
msgid "Well I know now, so why not show me? I can read Infernal, after all."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 2eca5fa2-b584-3fd3-be5e-32a3d7b9abb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_GotQuestFromRaphael = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:2eca5fa2-b584-3fd3-be5e-32a3d7b9abb4
msgctxt "h3f4b9304gdaccg4469gb0d5g5cf7e9528468"
msgid "Trying to decode the scars before Raphael does?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 312a2edd-42b8-df65-9c3f-7d05810fe884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:312a2edd-42b8-df65-9c3f-7d05810fe884
msgctxt "h0a902620g0febg44d7ga779gd94ee3719e90"
msgid "Don't ask me, it's your body..."
msgstr "왜 나한테 물어, 네 등이잖아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 31ca9034-c763-f101-eb7d-d35011ce604c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:31ca9034-c763-f101-eb7d-d35011ce604c
msgctxt "h1131994cg4967g474fg8cf6ga01de9e3b854"
msgid "It's a strange-looking poem."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 31fb4e26-0b8f-0ca4-0e8e-fe6175c1bc37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:31fb4e26-0b8f-0ca4-0e8e-fe6175c1bc37
msgctxt "he4b5bc8bg8ed2g49a6g9a3ag29b0c62f81f8"
msgid "Oh, it's you. Well, I'm glad you like them."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = 32e88e2a-5961-a838-8b40-e5df6ca4b764
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_LearnedPoemInfernalBeforeScarReading = True
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#.   Global:
#.     - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:32e88e2a-5961-a838-8b40-e5df6ca4b764
msgctxt "h6a7ac345g4879g4cd0ga964g2dbee1ba4184"
msgid ""
"*The jagged script is definitely Infernal, a language you know all too well.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 338c596c-f031-e3ad-1f96-cff996593d95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:338c596c-f031-e3ad-1f96-cff996593d95
msgctxt "h36501d13g5da9g4fa6ga3a0g076a8b707192"
msgid "<i>Smile and say nothing, waiting for him to speak.</i>"
msgstr "<i>웃으며 아무 말도 하지 않고 아스타리온이 말하길 기다린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 33e9984b-17f9-f501-9e7d-1ccc9a7ad3ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:33e9984b-17f9-f501-9e7d-1ccc9a7ad3ce
msgctxt "h8a944119g915fg4c58g82e4ga08cf4545db3"
msgid "If he did make a devil's pact, he's more dangerous than we thought."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 355f0a31-07e7-aee0-24fa-cae930b2a773
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:355f0a31-07e7-aee0-24fa-cae930b2a773
msgctxt "h9645ff8dg170ag4168g8f7bg7298d5d153b9"
msgid "<i>Thank you.</i>"
msgstr "<i>고마워.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 36ecc104-0e9e-e1a4-d7c1-257a04623a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:36ecc104-0e9e-e1a4-d7c1-257a04623a56
msgctxt "hacb16b57gcee3g45f7g8385g2838e251644e"
msgid "Approximately... zero words? Thereabouts."
msgstr "대략 아마... 영 글자? 그 정도."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 371881fa-5b1e-83ef-8bb8-b3d2b3117828
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:371881fa-5b1e-83ef-8bb8-b3d2b3117828
msgctxt "h39e84ab3gc1d3g46b9ga51bg4cf77ee40804"
msgid "Very true. This is nothing to concern yourself with."
msgstr "맞는 말이네. 넌 상관할 바가 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 37b2049f-e0af-4db7-c419-fa7c1e14f83c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:37b2049f-e0af-4db7-c419-fa7c1e14f83c
msgctxt "h336dca03gc04bg440eg937cg7a128d5e9f5a"
msgid "Snooping. What are <i>you </i>doing?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 3a1c3b3b-998e-df14-4542-a4cced0ac1d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:3a1c3b3b-998e-df14-4542-a4cced0ac1d5
msgctxt "h2507dcdfg8e72g450cg9147gbdb1c7136ba7"
msgid "What did he do to me?"
msgstr "그놈이 내게 무슨 짓을 한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 3af74323-a8a4-4843-2178-49975d9bc46e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:3af74323-a8a4-4843-2178-49975d9bc46e
msgctxt "hf6ec241eg6688g4177gbf48g82fa7cf9edf0"
msgid ""
"Thank you, by the way. This may not be your fight exactly, but you're "
"willing to help. That means a lot."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 3bbafa97-f63c-5e7f-9ac4-a6f3210dd07e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:3bbafa97-f63c-5e7f-9ac4-a6f3210dd07e
msgctxt "h8339d6c3ge865g48c6gabffg90004013de0d"
msgid ""
"When Cazador first carved this on me, I didn't fight back. I couldn't. I "
"just knelt there as it happened to me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 3cbbeffb-3971-01ad-b4b5-1ccf0c8d829c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:3cbbeffb-3971-01ad-b4b5-1ccf0c8d829c
msgctxt "ha2047619gbd0eg4bedgb027g7b135bb6b76f"
msgid "I don't need help. And certainly not from you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 3e257e73-ed96-23f2-f0ac-b48882edabf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:3e257e73-ed96-23f2-f0ac-b48882edabf2
msgctxt "h483c9516gac9dg48adg8978g5963370139b3"
msgid "Oh, and when were you going to tell me?"
msgstr "아, 그럼 대체 언제 얘기하려던 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 404a7d9d-ffd2-45cb-cb50-5fc4a8cb096f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:404a7d9d-ffd2-45cb-cb50-5fc4a8cb096f
msgctxt "hf4667381gf575g49a3gb900gb46b4e2a51f1"
msgid "Good. This is personal and we're travelling companions, not friends."
msgstr "그래. 이건 개인적인 문제고, 우리는 여행 동지지 친구가 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 41ec0edf-4959-3dec-1e52-9559f80aa830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:41ec0edf-4959-3dec-1e52-9559f80aa830
msgctxt "h9617e506g3f12g4cccga3b0g224d0bfe9aa9"
msgid "Doing some stretches before bed?"
msgstr "눕기 전에 기지개라도 펴려고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 42be26ce-600c-cb03-7b92-f9035808fb40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_PartySize_AtLeast3 = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:42be26ce-600c-cb03-7b92-f9035808fb40
msgctxt "h96f6c63eg3eb7g403cgaddbg34f84c1a11c7"
msgid "Should we ask the others? They might know something."
msgstr "다른 사람들에게 물어볼까? 아는 게 있을지도 모르잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 438107cf-d6f9-68ef-9f85-8b432ac5e48c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:438107cf-d6f9-68ef-9f85-8b432ac5e48c
msgctxt "h107f7431g4599g4c5egaf4bgd980df0c4b10"
msgid ""
"I do hate that he just... revealed everything to you, by the way. I would "
"have liked to tell you in my own time."
msgstr "사실 그놈이 이걸 그냥... 보여준 건 마음에 안 들긴 해. 천천히 마음의 준비를 하고 때가 됐을 때 말하고 싶었는데. "

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 4523330e-3abe-13a5-1b0e-4fe925f71737
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: !(REALLY_GALE and WARLOCK and WIZARD)
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:4523330e-3abe-13a5-1b0e-4fe925f71737
msgctxt "h3cac35d1ge48fg4f7dgbd53g0f1f2bf9b7fe"
msgid ""
"You can let me look or spend all night twisting yourself into knots. Your "
"call."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 46fb93be-96d8-7241-bd9c-ab820463d6f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:46fb93be-96d8-7241-bd9c-ab820463d6f0
msgctxt "hb0e87136ge8f5g47abgb6bcg84132bcd072e"
msgid ""
"No! No, let's keep this between ourselves. At least until we know what it "
"means."
msgstr "아니! 아냐, 우리끼리만 알고 있는 비밀로 하자. 적어도 그게 무슨 의미인지는 알기 전까진."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 47903063-b024-878c-a60a-31acd1921000
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:47903063-b024-878c-a60a-31acd1921000
msgctxt "hdb9dce97g4df9g4b83g987fg58936701bc8a"
msgid ""
"I've been wearing these scars for so many years, I started to feel around "
"back there. Try to figure out what poem Cazador cut into me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 47f212c6-0c02-9d80-4dca-5b4b8ab3ae7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Astarion_InParty_Asked_GurHunter = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:47f212c6-0c02-9d80-4dca-5b4b8ab3ae7d
msgctxt "he94c9c17g1003g4fdcg8f5fgb2618e0c029b"
msgid "No wonder he wants me back. What have I run off with..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 4bb0889a-a5c8-595b-6582-622be25d4c69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:4bb0889a-a5c8-595b-6582-622be25d4c69
msgctxt "hae2bed3eg13e7g4edfg98f5g9ff8cf41ac00"
msgid ""
"'There once was a cleric of Gond, who was cursed with a very small wand...'"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 4dd06463-d1ab-0a0f-52ab-470e06577a5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_Astarion_Knows_ScarsIsCazadorPoem_Character(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:4dd06463-d1ab-0a0f-52ab-470e06577a5b
msgctxt "h12d9ec02gba58g4786g99dfg3c8419aa6f76"
msgid "I was hoping to hear a little poetry. What's it say?"
msgstr "시라도 좀 듣고 싶었지. 뭐라고 적혀 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 4effb857-cb48-45aa-d0a7-3ae906192d46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:4effb857-cb48-45aa-d0a7-3ae906192d46
msgctxt "ha7e77cc2g1bc8g4ef5g88e2gc153a9241e26"
msgid "Can you read what's on my damned back? Please."
msgstr "그냥 내 망할 등 좀 읽어라? 부탁해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = 4fefc612-b051-f748-5b76-07c33a9a5f14
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#.   Global:
#.     - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:4fefc612-b051-f748-5b76-07c33a9a5f14
msgctxt "h2ae1df58g102cg4114ga577g7c8269475ef8"
msgid ""
"*You search for anything you can identify and recognise a couple of symbols "
"associated with the Hells. You suspect it's written in Infernal.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = 5174d6f2-38f7-a534-bef2-7386187cafa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5174d6f2-38f7-a534-bef2-7386187cafa5
msgctxt "h6ad79c46g47c1g4552gbaadg57e9abcf8cbd"
msgid ""
"*You search for anything you recognise - a letter, a rune, something - but "
"there's nothing. You can't even tell what script it's written in.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 52d21031-aa81-b929-d6a1-bbe6c58f6090
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:52d21031-aa81-b929-d6a1-bbe6c58f6090
msgctxt "h175ec766g9ee3g4691gb913g1433a14e37ab"
msgid "If anyone can tell us, Raphael can."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 5444700b-8fab-e1ac-c453-f73c8d0006d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5444700b-8fab-e1ac-c453-f73c8d0006d2
msgctxt "hf33f0bedg61c9g4137gac53g3738ecce7d80"
msgid "Useless. Why do I even bother with you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 559b34fe-7431-3ef8-d4a7-7018e9106ffd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_Astarion_Knows_ScarsIsCazadorPoem_Character(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:559b34fe-7431-3ef8-d4a7-7018e9106ffd
msgctxt "h18633d88g8becg4676ga324g72922e72d61d"
msgid "I thought you didn't care what Cazador wrote on your back."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 559f51f9-e047-f790-46ea-68dcdb51bc3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:559f51f9-e047-f790-46ea-68dcdb51bc3f
msgctxt "h5bc6c118g64a6g42adg831cg4da932dc456a"
msgid ""
"Listen, we travel together, but we're not friends. I'm not about to share "
"anything with someone I can't trust."
msgstr "잘 들어, 우리는 함께 여행하지만, 친구는 아니야. 내가 믿지 못하는 이에게는 아무 것도 공유할 생각 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 5603c189-cca0-4d82-6a2f-5e98005bc918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5603c189-cca0-4d82-6a2f-5e98005bc918
msgctxt "hd8551afaga81cg4ec2gad28g52ced8c9dc5a"
msgid "Peace at last."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 564904f6-6e1e-1073-b7f8-d2a6d0be7a33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:564904f6-6e1e-1073-b7f8-d2a6d0be7a33
msgctxt "hf09f8f3egfd5dg4fc2g8184g0cbaebaa68de"
msgid "We'll figure it out. I promise."
msgstr "함께 알아낼 수 있을 거야. 약속하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 5712d2fa-9b94-40d6-f8e4-e66c44ebe6fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5712d2fa-9b94-40d6-f8e4-e66c44ebe6fb
msgctxt "h93e12db8g3f96g4f5agbe04gbb8424410f41"
msgid "It's my back. My skin. My business."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 5b2f6050-4f0c-7b61-def9-fd8577a7f120
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5b2f6050-4f0c-7b61-def9-fd8577a7f120
msgctxt "h2edb0e91g970bg41f7gaf3cg2b1a630eadee"
msgid "Did you not get enough of an eyeful back with Raphael?"
msgstr "라파엘이 있을 때 충분히 보지 않았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 5bbfd1e5-af09-e009-86ca-103b6cb8b5f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5bbfd1e5-af09-e009-86ca-103b6cb8b5f6
msgctxt "hf849f6a5g0276g432cgab77g3095d157d4f3"
msgid "<i>Fine.</i>"
msgstr "<i>알았어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = 5c3d5df9-3dbc-f44f-5f79-9f4f11be9d3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5c3d5df9-3dbc-f44f-5f79-9f4f11be9d3d
msgctxt "h553b31b4gd20bg4642g9bf1g13677c173f1c"
msgid ""
"*He might be sneering, but you can see pain in his eyes. He needs help, but "
"doesn't know how to ask.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 5d4aa769-2b0e-a500-ee84-1d1fc62ae240
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5d4aa769-2b0e-a500-ee84-1d1fc62ae240
msgctxt "h80bdc514g7089g480cg8beag4e6a17c5696e"
msgid ""
"I'm not one to drop my guard and trust the first person who flounces up to "
"me after we crash out of the sky."
msgstr "난 하늘에서 떨어지자마자 제일 먼저 찾아온 사람에게 무턱대고 비밀부터 털어놓는 사람은 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 5e479844-a1d0-30f7-fed3-16775e925419
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:5e479844-a1d0-30f7-fed3-16775e925419
msgctxt "h5225d1a1g8a29g4369gb80dg5fa166e340f6"
msgid "Of course. Turn around."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 63154a87-f753-6b51-a0ea-9adcd6634240
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:63154a87-f753-6b51-a0ea-9adcd6634240
msgctxt "hf217c105g3180g4756ga3c6gba55c5f9ee5d"
msgid "Me? What are <i>you </i>doing?"
msgstr "뭐 하냐니? <i>너는</i> 뭐 하는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 644b2e90-d1e5-6ab4-75b4-b6429cf511a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:644b2e90-d1e5-6ab4-75b4-b6429cf511a6
msgctxt "hd7beb995gb39ag48f8gb69dge9e2a125329b"
msgid "Oh no, I'm not getting involved."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 67f93dec-3685-1cdb-c696-4775edbf17cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:67f93dec-3685-1cdb-c696-4775edbf17cf
msgctxt "h77029bfbge1cdg4825g97dbgc419ec44e9db"
msgid "Ah! There you are. I admit, I got curious."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6890661b-5a4e-0686-9423-f6ddb5f78770
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6890661b-5a4e-0686-9423-f6ddb5f78770
msgctxt "hf2b7400egcb52g44d1g8119g013cab5584ca"
msgid ""
"I wasn't his only spawn. And he tortured us all - I imagine each of us are "
"carrying a piece of this infernal contract."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6ada2dba-6754-a6b9-04cf-a343243fa8a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6ada2dba-6754-a6b9-04cf-a343243fa8a1
msgctxt "h3252dd42gfb48g4530ga739gcb805269552d"
msgid ""
"I can't read it with a mirror and it seems I can't read it with my hands "
"either."
msgstr "거울로 볼 수는 없고, 아무리 해봐도 손으론 못 읽겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6b8f1e54-f8b5-0791-3bf2-7d54e6dd9714
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = False
#.      - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6b8f1e54-f8b5-0791-3bf2-7d54e6dd9714
msgctxt "h967b31e9g61f2g44bfgabd8g6a7dc9c326c5"
msgid "It doesn't look like a poem. It doesn't look like anything I recognise."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6bfb146d-2df7-e1ef-ad00-16ecaad06009
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6bfb146d-2df7-e1ef-ad00-16ecaad06009
msgctxt "h6aa5e80fgd784g43f7gb870gd33b7acf443d"
msgid "...That had better be a joke."
msgstr "...방금 그거 농담 맞겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6cdff379-f7d3-c9f2-b9d9-df87a665738c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6cdff379-f7d3-c9f2-b9d9-df87a665738c
msgctxt "h806b8596g2267g4946gba78g5474647456a3"
msgid ""
"It matters! It's carved into my back - whatever this is, it's part of me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6e9e1690-2a46-368f-4f7e-e34735e8d86f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6e9e1690-2a46-368f-4f7e-e34735e8d86f
msgctxt "h13410319g1cb3g4a6aga27dg0fbd2b3933ae"
msgid "I - I suppose it couldn't hurt."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6f049527-ac1a-2a17-c635-14f8bf0f1b5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6f049527-ac1a-2a17-c635-14f8bf0f1b5d
msgctxt "h2ad39482g1f16g47bfgbb55gc503ce506ae7"
msgid "Wait - I'm sorry. You caught me by surprise, that's all."
msgstr "잠깐만, 미안. 그냥 내가 놀라서 과민반응했던 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 6f633628-8b60-e2b9-1f32-c0b0e7bb6b6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:6f633628-8b60-e2b9-1f32-c0b0e7bb6b6a
msgctxt "he58f0f2bgba15g4501g837fgd272b1c2747b"
msgid "None at all..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 708c1e95-f7be-2ae2-14b1-edaaf7735034
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:708c1e95-f7be-2ae2-14b1-edaaf7735034
msgctxt "h1e15f388gb3acg4452gaeecga14945aab068"
msgid "If it's a poem at all..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 72dee80f-28ad-3504-dd97-ece09550d8ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:72dee80f-28ad-3504-dd97-ece09550d8ed
msgctxt "h88848664ga94bg4546ga538g86176192caee"
msgid "Still, I've made my bed with Raphael. We'll know soon enough."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 74f521cc-8c5b-f800-6bdd-a64cde63fc3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = False
#.      - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#.   Global:
#.      - ORI_Astarion_State_LearnedPoemInfernalBeforeScarReading = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:74f521cc-8c5b-f800-6bdd-a64cde63fc3d
msgctxt "hd12b33a0g511eg405bgbb13gb35b5df1791b"
msgid "It's written in Infernal, I can't read it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 75580bab-d561-8ab4-2121-d57851cfca58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:75580bab-d561-8ab4-2121-d57851cfca58
msgctxt "he879a850g96cbg435egbeb0gf1b77a07a8b3"
msgid ""
"At least I still have the devil. He'll deliver, even if it's at a price."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 7648a60d-bcd4-3edb-6e72-66397c9be6e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:7648a60d-bcd4-3edb-6e72-66397c9be6e2
msgctxt "hfd8743fegf45eg4a1eg8c53ge1f24cdc0549"
msgid "But you can read it? You can tell me what it says?"
msgstr "어쨌든 읽을 수는 있다는 거지? 뭐라고 하는지 말해줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 76eac795-7735-c710-d328-2a44f1e9075c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:76eac795-7735-c710-d328-2a44f1e9075c
msgctxt "hada8e6d9gd967g4599gbe7ag5997668f42ff"
msgid ""
"A gift from Cazador, written in flesh. Apparently it's a poem, but I've "
"never read it."
msgstr "카사도어가 살에 새겨준 선물이지. 시라고는 하는데, 난 한 번도 읽은 적이 없어. "

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 770fb0ff-fbdd-ea0e-4fdf-06c8094f5887
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:770fb0ff-fbdd-ea0e-4fdf-06c8094f5887
msgctxt "h3fb6ec5cgc64dg4963gbdb2g295fc439696e"
msgid "It's a surprise. And Cazador's surprises are never good."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 7741424a-7f80-422f-390d-08b71488c8f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:7741424a-7f80-422f-390d-08b71488c8f9
msgctxt "h933d8098g9568g43b6gb3a1g6221a03d8373"
msgid "What damned language is this?"
msgstr "망할, 이건 또 무슨 언어야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 77a6e5d0-4f7b-cffe-777d-ddc8f0ca7067
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:77a6e5d0-4f7b-cffe-777d-ddc8f0ca7067
msgctxt "hffa5241agb93fg44dbg860bg92267a32441c"
msgid "And? What can you see?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 7b0f87b4-2e1b-6e2f-380d-ca80d73bfd57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:7b0f87b4-2e1b-6e2f-380d-ca80d73bfd57
msgctxt "h34c729bdgff4eg48e2ga7ecgad0181f3570f"
msgid "Of course. Turn around."
msgstr "물론이지. 돌아서 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = 7f9cfa17-0106-d53c-c2ec-616cff52dd8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#.   Global:
#.     - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:7f9cfa17-0106-d53c-c2ec-616cff52dd8c
msgctxt "h0f501a14gaeb2g4807g8214ged86c2a2ef84"
msgid ""
"*You can't read the text carved into his flesh, but you recognise the script "
"- any warlock would. It's Infernal, the language of the Hells.*"
msgstr ""
"*당신은 그의 살갗에 새겨진 문자를 못 읽지만, 글씨는 알아봅니다. 워락이라면 누구든 알아볼 수 있습니다. 지옥의 언어인, 지옥어입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 811b24bd-9f0f-ce25-30eb-7e6e014e3632
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:811b24bd-9f0f-ce25-30eb-7e6e014e3632
msgctxt "hb3f0602bg5ffdg43c8ga376gbc6f2efe948e"
msgid ""
"But if Cazador drew up a contract with someone in the Hells, then we need "
"details from Raphael. There must be immense power on the line."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 82dfab91-65fb-6bbd-741e-215f38d8ee64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:82dfab91-65fb-6bbd-741e-215f38d8ee64
msgctxt "he62839c6g4ef9g4df9ga17dgede0be9e1aee"
msgid "I know. Now shut up and turn around."
msgstr "나도 알아. 그러니까 입 다물고 돌아서기나 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 8392386e-1069-31fd-a4a8-2cd35efa4508
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_Astarion_Knows_ScarsIsCazadorPoem_Character(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:8392386e-1069-31fd-a4a8-2cd35efa4508
msgctxt "h54731635ge33eg4db6gadaeg90f21b57e7c6"
msgid "Just looking. What's that on your back?"
msgstr "그냥 보는 거야. 등에 그건 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 85fae53c-5b0c-f9e5-c91f-fd4cdf0b8a33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:85fae53c-5b0c-f9e5-c91f-fd4cdf0b8a33
msgctxt "h0c62ba85g4e2ag4037gb036g07ee5ab7fe3b"
msgid "It's - ah, well..."
msgstr "그게... 어, 말이지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 8628a8aa-ba6d-0e4d-69a9-0fe4ad8694cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:8628a8aa-ba6d-0e4d-69a9-0fe4ad8694cf
msgctxt "haf4ee5d9g4027g45fbg9b95g76acc6dab516"
msgid "Disappointed?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 8f10944c-0ab1-24c8-371c-9d996b578c3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:8f10944c-0ab1-24c8-371c-9d996b578c3b
msgctxt "h3297cb47g06ffg4f34ga0c7g31f9ba493696"
msgid "Offering to help. I can tell you what it says, if you want."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 92be42dc-0952-692e-58d4-8dab82d5f82e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_Knows_PoemInfernal = True
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_LearnedPoemInfernalBeforeScarReading = True
#.     - ORI_Astarion_State_PartySawScars = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:92be42dc-0952-692e-58d4-8dab82d5f82e
msgctxt "h348fbf99g3934g4657g8021g92decdaecb99"
msgid "A line with a fork and one - two - three dots?"
msgstr "포크 모양 선이랑, 점이 하나... 둘... 세 개?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 9326bce6-1474-700b-702c-f8a4fa9500ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:9326bce6-1474-700b-702c-f8a4fa9500ed
msgctxt "ha4568b71gf77bg4a62g8415gbae4fcadcb65"
msgid ""
"Cazador was only figuratively hellish - there were never any devils hanging "
"about the crypt."
msgstr "카사도어가 악마 같긴 했지만, 그건 비유적인 표현이지. 그놈 궁전에서 데빌은 한 번도 돌아다닌 적이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = 95369b73-df26-7fa2-8e08-f69d5d4dbc49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:95369b73-df26-7fa2-8e08-f69d5d4dbc49
msgctxt "ha0fcb5cbgb2b1g4766g9fa4g4b2c561fc9d9"
msgid "Sorry, I'll leave you alone."
msgstr "미안, 그냥 갈게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 96d9fc79-8e5b-95af-ce13-bffadc5867b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:96d9fc79-8e5b-95af-ce13-bffadc5867b6
msgctxt "hc52132c8ge237g41a7ga630ga9abe3f8fcf1"
msgid ""
"I can't see them, so I've been trying to feel my way about, but they may as "
"well be written in Rashemi."
msgstr "볼 수는 없어서, 촉각으로 느끼려고 했지. 하지만 공용어인지 라셰멘어인지조차 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 98ac388c-6cfd-ecc4-5076-901d4abbc111
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:98ac388c-6cfd-ecc4-5076-901d4abbc111
msgctxt "h2d453ea4g9771g4e55ga37dgbbb38c275238"
msgid ""
"You sweetheart. But while you're here, maybe there's something else you "
"could look at?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = 9ad3a369-e8bd-7663-25de-6fa768ba62e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:9ad3a369-e8bd-7663-25de-6fa768ba62e1
msgctxt "h5d2cd3c4g35d4g466cgbac9geb29aaac47fb"
msgid "I - this isn't your problem, you know."
msgstr "난 - 이건 내 개인적인 문제잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = a00b06b0-7735-01ed-0d1d-386b59ad4725
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:a00b06b0-7735-01ed-0d1d-386b59ad4725
msgctxt "h79f9a077gdb09g49b4g82ffg7f427070bdb5"
msgid "What does it say?"
msgstr "뭐라고 적혀 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = a15d6aae-a834-bd2e-8837-1ac774f4882d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:a15d6aae-a834-bd2e-8837-1ac774f4882d
msgctxt "h6ac46f8agdc62g4322gba46ga7143d16e659"
msgid "Never mind. It's not your concern."
msgstr "됐어. 어차피 넌 알 바가 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = a293a6cb-cc89-cf49-eee4-50b747bb198c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:a293a6cb-cc89-cf49-eee4-50b747bb198c
msgctxt "h478feab3g19ecg48b0g948ag526860e58135"
msgid "Given the subject matter, I probably won't."
msgstr "사실 정말로 이 주제론 말을 안 꺼낼 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = a3a7c845-a556-2f14-00f0-fca55146dbb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:a3a7c845-a556-2f14-00f0-fca55146dbb3
msgctxt "h73f52ae1g1af4g47b1g8c36g764c5f0363e5"
msgid "So... I was wondering if maybe - perhaps - you might be able to..."
msgstr "그래서... 내가 혹시나 해서 말이야, 어쩌면, 그, 네가 대신..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = a4af2396-2840-e437-8d13-543f51d45e5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:a4af2396-2840-e437-8d13-543f51d45e5a
msgctxt "h96a64a57ga354g404bgbaffg80d8eea8bdaf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = a55501f1-e74b-1b9c-5a74-ea90af6a38a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:a55501f1-e74b-1b9c-5a74-ea90af6a38a9
msgctxt "h7974afb2gc1c2g498fga222gc2e8b6dee5b5"
msgid ""
"*The lines describe oaths and 'the fires below', but the language is "
"fragmented and strange. This is just a piece of a larger text.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = ac84800d-54cf-9521-827f-8af7fcfe1202
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ac84800d-54cf-9521-827f-8af7fcfe1202
msgctxt "h58b4f407g877cg41f2g89cegee64b939c3cf"
msgid "Just enjoying the view."
msgstr "그냥 감상중."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = ac8a5dfc-0fb8-9bca-e6e6-ba313328eb83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ac8a5dfc-0fb8-9bca-e6e6-ba313328eb83
msgctxt "he6f0b0efg3b1cg4f91gb03cg79a0c8d3778e"
msgid ""
"Then again, even he couldn't know I'd be kidnapped. Whatever he planned, "
"it's gone wrong. Which gives us an advantage."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = acd56fbe-9882-2f3f-7199-c5a01b8cd9b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_Astarion_Knows_ScarsIsCazadorPoem_Character(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:acd56fbe-9882-2f3f-7199-c5a01b8cd9b2
msgctxt "h74d0abe7g59e7g4978g9853gd3334991d30c"
msgid "What language were you expecting?"
msgstr "그럼 무슨 언어일 줄 알았는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = b1567b77-173e-1e37-1f13-a8562bdf47f6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. TagRule: REALLY_GALE or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b1567b77-173e-1e37-1f13-a8562bdf47f6
msgctxt "h4913d3f6gdc1fg4d0agad30g7cb197b494eb"
msgid "Those runes look occult. I can probably read them, if you like?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = b36a8f9d-e569-d03c-3daf-bf960628c41f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b36a8f9d-e569-d03c-3daf-bf960628c41f
msgctxt "hdaad2d40g7cd4g4a94g960cga4a2c9429f4e"
msgid "I'll draw them for you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = b625d7f0-c7fb-17f7-9a01-840f20ec9633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b625d7f0-c7fb-17f7-9a01-840f20ec9633
msgctxt "h1ce8469cg2842g4777gbdd0g198102b29991"
msgid ""
"I thought you could help me, but no - I'll have to make my own way. As "
"usual. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = b6279e32-43fa-f305-350a-f820932bc044
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b6279e32-43fa-f305-350a-f820932bc044
msgctxt "h8ff6c908gc20fg4af8gb09cg61df3148c85b"
msgid "Now, if you don't mind - piss off."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = b6a5eb42-77bc-0418-8317-86969d3a12be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_LearnedPoemInfernalBeforeScarReading = True
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#.   Global:
#.     - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b6a5eb42-77bc-0418-8317-86969d3a12be
msgctxt "hc7680f4fgae74g4549ga0f4gde91ca9bb1c3"
msgid ""
"*The jagged script is definitely Infernal, the language of the Hells, but "
"you can't make out its meaning.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = b6f720aa-608a-4ec9-7b02-23d7511199cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b6f720aa-608a-4ec9-7b02-23d7511199cd
msgctxt "h316efd89g9db2g4a34g9959g3b01de251946"
msgid "What is it, if not a poem?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = b716b428-50f1-b92b-5556-73ad5a36a252
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#.   Global:
#.     - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b716b428-50f1-b92b-5556-73ad5a36a252
msgctxt "hc0bde3f6gafa8g4b9bg800cga70b0d2e9b80"
msgid ""
"*You run your eyes over the runes hacked into his flesh and recognise an all-"
"too-familiar language: Infernal. It's the language of the Hells.*"
msgstr "*그의 살갗에 새겨진 룬을 훑어보니, 너무나도 익숙한 언어가 눈에 들어옵니다. 지옥의 언어인, 지옥어입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = b79052ad-6b9a-ecf1-b98d-302b49004a8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b79052ad-6b9a-ecf1-b98d-302b49004a8b
msgctxt "h1c1b9976g1cb8g48ddgbe37g81bea6963013"
msgid ""
"Well find something else to gawp at. I'm busy and I don't need your help."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = b9cbab4b-ac17-7089-5aba-0412507cd60a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b9cbab4b-ac17-7089-5aba-0412507cd60a
msgctxt "ha1ed8ed2g0c47g495bg9f40g702cbea49dfd"
msgid "Although you can read Infernal..."
msgstr "네가 지옥어를 읽을 수 있긴 한데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = b9d30846-c782-4d57-5178-941e1b571647
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_Astarion_Knows_ScarsIsCazadorPoem_Character(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:b9d30846-c782-4d57-5178-941e1b571647
msgctxt "h41ebd665gd473g408fg8dffg0ff640508c75"
msgid "Nice scars. Who's the artist?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = bab72712-715c-5692-b731-77c6e9e12520
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:bab72712-715c-5692-b731-77c6e9e12520
msgctxt "h670bf1d0g7d4dg44d1gb593gfe8c346fe2c7"
msgid "Although I've been able to make out exactly none of this on my own..."
msgstr "나 혼자서는 아무것도 알아낼 수 없긴 했는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = bced5ceb-4d77-35e2-1e4e-86216461d0a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:bced5ceb-4d77-35e2-1e4e-86216461d0a4
msgctxt "hbef2b4e6g4a55g44efg9faeg64e77f157e4e"
msgid "What have I run off with..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = bd71dec8-105a-6a49-defd-df8145d42300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:bd71dec8-105a-6a49-defd-df8145d42300
msgctxt "h9bce5e07gbd1cg43daga15ag3d3f920a41ab"
msgid "I'm sure, but what will it say?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = be9d2fee-f4a1-4c7f-e717-708ab9a23d16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:be9d2fee-f4a1-4c7f-e717-708ab9a23d16
msgctxt "h7caa2e4fg1af4g4479gae16g3a10c3bb2377"
msgid ""
"But what could a devil have offered Cazador? He had wealth, power, control - "
"what more could you want?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = bfbfbb2d-ab4e-19d5-7afd-8a5bf52f434b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:bfbfbb2d-ab4e-19d5-7afd-8a5bf52f434b
msgctxt "hc8a42b12gb9abg4c8dg9725ga6b8bcaaa8d6"
msgid "Two centuries carrying this, and I can finally see it."
msgstr "등에 이걸 2세기나 가지고 다녔는데, 드디어 보다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = c20ec58e-8065-d584-e9d0-e92108d1063b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c20ec58e-8065-d584-e9d0-e92108d1063b
msgctxt "hcfd1a75fgf8f7g4d10g8d2fg1ad88dcd8e32"
msgid "How do you know it's Infernal?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = c398b12f-097a-cd6f-575c-ca53178a3cf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c398b12f-097a-cd6f-575c-ca53178a3cf6
msgctxt "h79206a9dg46eag476fga1d2gaecbdae8267e"
msgid "Whatever he's left carved in my flesh, it's a mystery to me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = c42361fc-7b01-7c6c-e22b-05eb6b653f4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c42361fc-7b01-7c6c-e22b-05eb6b653f4c
msgctxt "h1b273b88g5f68g419cga8cdg06c9d5457aa5"
msgid ""
"Why would he write a poem in Infernal? Why would he write anything in "
"Infernal?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = c44b7799-1b6e-a3c8-81b9-aa24758ac79b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c44b7799-1b6e-a3c8-81b9-aa24758ac79b
msgctxt "h8ee07c08gb4beg4089g95c9g8a0c45817cbb"
msgid "Well I know now, so let me help you read it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = c48ee551-488f-2605-9bb9-a25423b968f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c48ee551-488f-2605-9bb9-a25423b968f6
msgctxt "h2460ce17g7491g4447g9580g5da7cc0d4c99"
msgid "But now that I know, let me help you read it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = c56ef9b3-0c36-b0fb-057c-0b5a7a6c9d20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c56ef9b3-0c36-b0fb-057c-0b5a7a6c9d20
msgctxt "h364dfeedgfa56g463eg9111gfe6e4f8ff72f"
msgid "And? What does it say?"
msgstr "어때? 뭐라고 적혀 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = c6205798-e323-cd4c-0430-cf6078942d96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c6205798-e323-cd4c-0430-cf6078942d96
msgctxt "haafd7ce6g0bf5g4a9agb21ag62aa304f337e"
msgid "It's Infernal."
msgstr "지옥어야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = c62ee527-df38-3775-df67-4f350b0c4ca7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c62ee527-df38-3775-df67-4f350b0c4ca7
msgctxt "h4c78b496g6212g4e62gafa9g11d195f5470e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = c6459337-ff08-dbe6-6e03-47f7474abfd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c6459337-ff08-dbe6-6e03-47f7474abfd4
msgctxt "h8f3f63c5g9ec7g4dc1g9ba1g7e6ea6be94d4"
msgid "All right, if you don't want answers..."
msgstr "알았어, 정 답을 알기 싫은 거라면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = c77d76a4-9a2e-79de-dff0-0b5d01412c0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c77d76a4-9a2e-79de-dff0-0b5d01412c0a
msgctxt "hf62e573dg4670g436cg9c0eg45376a591e98"
msgid ""
"But now that I know, why not let me take a look? I can read Infernal, after "
"all."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = c7eb2445-a894-0646-a3e0-860721855e4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c7eb2445-a894-0646-a3e0-860721855e4b
msgctxt "ha62f19c3ga171g4ec0gb4bagac333488a3a7"
msgid ""
"I - well, if you must know, I've been trying to make out the scars on my "
"back."
msgstr "내가 - 뭐, 굳이 알고 싶다면, 내 등에 있는 흉터를 알아내려고 하던 중이었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = c8b2872e-f412-b882-716c-bcb52ce52b92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c8b2872e-f412-b882-716c-bcb52ce52b92
msgctxt "h9ac3ec1fgd264g4a1cgb54eg6a65ffb85197"
msgid "It's a sonnet about minding your own damn business."
msgstr "소네트야. 제목은 '니 일이나 신경 쓰세요'."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = c9a6c639-0949-0903-b255-294557165442
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:c9a6c639-0949-0903-b255-294557165442
msgctxt "h5dff4d39g7e89g446ag982fg33ad330ad8e7"
msgid "Ah! What are you doing?"
msgstr "악! 뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = ca711186-d6ee-72fa-5af8-ff33b406f968
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ca711186-d6ee-72fa-5af8-ff33b406f968
msgctxt "h43e4bb9cg7e5fg45aega958gac2ad3e37ba9"
msgid "Ah! What the hells are you - wait, did you say Infernal?"
msgstr "악! 너 뭐 하는... 잠깐, 지옥어라고 했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = cb4bc5e4-f06e-b4f9-59bb-1acc13f888d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:cb4bc5e4-f06e-b4f9-59bb-1acc13f888d5
msgctxt "h0c60b5e8g1f62g4935g92a4g02ee379db837"
msgid ""
"I suppose 'thank you' covered it, really. But I do mean it. I'm grateful - "
"for all of this."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = ce4b6319-11ba-4e4f-7ea2-fbcf9ec69aa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ce4b6319-11ba-4e4f-7ea2-fbcf9ec69aa8
msgctxt "hbd673002g2f58g4feeg9d96gad6734cae3d3"
msgid "It's not a poem. It might be part of a devil's pact..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = cf2ab146-b9a7-cb27-d074-c6ae551e33e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:cf2ab146-b9a7-cb27-d074-c6ae551e33e2
msgctxt "h8be31243g3f96g41e3g87e2gd3dec3524ff6"
msgid ""
"I've been tracing the scars on my back with my fingers, trying to read them "
"by touch, but I can't. They may as well be written in Rashemi."
msgstr "계속 내 등에 있는 흉터를 손으로 만져봤어. 촉각으로 내용을 읽어보려고 했는데, 안 되네. 공용어인지 라셰멘어인지조차 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = d03e6d16-ee70-1bee-01b7-670ba449b352
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d03e6d16-ee70-1bee-01b7-670ba449b352
msgctxt "hfbba0a9fgbb59g4441g821bg22c4c2ff251a"
msgid "You really have no idea what this is?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d110254c-003a-095d-748d-f72339828263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d110254c-003a-095d-748d-f72339828263
msgctxt "hb91ad64ag1671g4705g9737g7cf96121121d"
msgid "What was that bastard up to?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d2bda5b0-81a2-0d2d-ba19-af3f610eac74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d2bda5b0-81a2-0d2d-ba19-af3f610eac74
msgctxt "h809db433gdf33g4a02g9184g8cbaa86f5b93"
msgid "Perplexed. This was a surprise, and Cazador's surprises are never good."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = d32cb01e-74e1-5d72-570c-cdaeda51009d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d32cb01e-74e1-5d72-570c-cdaeda51009d
msgctxt "h0d6bc42bgd5edg41ffga8c5g67e9f5f8682a"
msgid "How much of it have you read?"
msgstr "얼마나 읽어냈어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d3561a92-7698-b59b-f4dc-df58ae8f8b2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d3561a92-7698-b59b-f4dc-df58ae8f8b2f
msgctxt "h421153d2g4cceg4d37g85eeg01865abf4d7c"
msgid "No. I could have missed it, of course, but I doubt it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = d3872313-a009-a00c-2a7e-5fa074364b18
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d3872313-a009-a00c-2a7e-5fa074364b18
msgctxt "hddb0d4bag3578g4868g8145g9b3ea4811cec"
msgid ""
"The little I read looked pretty dangerous, but if you don't want to know..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = d40b2ea5-3cd5-9158-2ff3-511543e6fa46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = False
#.   Global:
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d40b2ea5-3cd5-9158-2ff3-511543e6fa46
msgctxt "h671529c5g41a8g4e53g9237g70d053c69d99"
msgid "Someone out there will be able to read it, I'm sure."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d40cfc00-1af6-0d38-3f98-16556228d2ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d40cfc00-1af6-0d38-3f98-16556228d2ab
msgctxt "h5c128b64g2e20g4f83gbf21g60d6d9e63299"
msgid "Thank you, by the way. This is... well, it's something."
msgstr "고마워, 어쨌든. 이건... 음, 의미가 있었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d59cfc00-a9a5-2e77-d024-0d3df21d9dcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d59cfc00-a9a5-2e77-d024-0d3df21d9dcc
msgctxt "hc025bca7g43ebg4ba1gaca3g1acd5eec4171"
msgid "Hells forbid."
msgstr "그런 일은 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = d674a6da-fcba-c8c5-c65f-fa35b07aeec5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d674a6da-fcba-c8c5-c65f-fa35b07aeec5
msgctxt "h8a074844ge62ag407bgaef9ge40b73d72f38"
msgid "What's the magic word?"
msgstr "'해주세요'라고 해야지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d681a3af-4853-95cc-ebc7-39011a67727f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d681a3af-4853-95cc-ebc7-39011a67727f
msgctxt "h1c6cd673g298eg4cb7g8049gcf63f8bd2cf8"
msgid "It's not a poem? That can't be good."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d7b31d7f-1d40-7069-ef5e-c96180157c37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d7b31d7f-1d40-7069-ef5e-c96180157c37
msgctxt "hf67484b1ga0dag4d13g8457g7283b0297f88"
msgid "I am perfectly capable, thank you. This isn't your concern."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = d8035887-1fe0-ad89-9324-484ec47b6279
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d8035887-1fe0-ad89-9324-484ec47b6279
msgctxt "he21752c1g2954g4287g8329g782118bc1fc0"
msgid "Don't mention it."
msgstr "말 안해도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = d95c25d9-94b3-f385-1c82-0aa1d66d54cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d95c25d9-94b3-f385-1c82-0aa1d66d54cb
msgctxt "hb9441712g5048g4d68g9990gf16270f68e4d"
msgid "I don't know. Not that."
msgstr "나도 몰라. 아무튼 지옥어는 아니었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = d9a3004b-f1c8-e34a-21ef-aeb9c597257d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:d9a3004b-f1c8-e34a-21ef-aeb9c597257d
msgctxt "he3b91c73gc253g4a4eg9c66gd2dc3d2f06ae"
msgid "It's easy for some of us."
msgstr "우리한테는 읽기 쉽지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = db672e88-c029-e7ac-a7f2-dc44cab4f923
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:db672e88-c029-e7ac-a7f2-dc44cab4f923
msgctxt "h410a9b09g1b3dg4030ga17dg2bb644522d2b"
msgid ""
"...I have no idea. I've been trying to trace the words, but they may as well "
"be written in Rashemi."
msgstr "...나도 모르겠어. 단어를 짚어내려고 하고 있었는데, 뭐라고 적힌 건지 전혀 모르겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = dc0ee47e-bc2a-4d65-736f-b26f5928ba09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:dc0ee47e-bc2a-4d65-736f-b26f5928ba09
msgctxt "h9fa9b65cg8b84g418ag9edegbb4ea48b4200"
msgid "Nothing. It's just a bunch of strange symbols."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = e108676f-9f8e-54b5-0791-e9f6e8ed9723
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:e108676f-9f8e-54b5-0791-e9f6e8ed9723
msgctxt "h1f56096bgee0dg4674gb1f5g178052b1d35b"
msgid ""
"I thought maybe if I could read them myself, we wouldn't have to play "
"whatever game that devil's concocting, but it's no use."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = e4675a3f-30fe-27ed-7c25-eb726b745ab8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:e4675a3f-30fe-27ed-7c25-eb726b745ab8
msgctxt "h7cc015a7gcb9ag4b48gbbf5ga228a8f99459"
msgid ""
"I couldn't make out much the first time I tried, but I recognised that "
"jagged Hells-script. Hence, approaching Raphael."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = e477eef4-4c44-3c42-1244-bc109395f29a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:e477eef4-4c44-3c42-1244-bc109395f29a
msgctxt "hee8dd3fcgf960g4abbgab92g877211a59e2d"
msgid ""
"Still, you're not the only person in the world that can read Infernal. I'll "
"do this on my own. As I always do."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = e64f16df-13b5-79d0-1fca-0309eab63eb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:e64f16df-13b5-79d0-1fca-0309eab63eb5
msgctxt "hb4f38282g1cf1g431eg99f8ga92f193da112"
msgid "I have absolutely no idea. But it's no poem."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = e6d75774-e5ef-c505-bbd9-4d854b5780d6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:e6d75774-e5ef-c505-bbd9-4d854b5780d6
msgctxt "h75858ea3g230eg4bc0gacf3ge1751a40b4c2"
msgid "<i>Look past the bluster and try to discern his true feelings.</i>"
msgstr "<i>날선 말투 뒤에 어떤 감정이 담겨 있는지 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = ea397a30-209c-12a5-2e62-bc6a9b86ca20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ea397a30-209c-12a5-2e62-bc6a9b86ca20
msgctxt "he71b2723gdf63g4fdbg93e6g2dae8464d351"
msgid "I was minding my own business. If only everyone was so considerate."
msgstr "나야 아무도 귀찮게 하지 않고 혼자 있었지. 다른 사람도 다 그러면 얼마나 좋을까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = ec1bd4cc-3cf8-889a-464a-5f1741048ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ec1bd4cc-3cf8-889a-464a-5f1741048ae1
msgctxt "h8ad525a0g8e7cg4c7eg895bgc3783130179f"
msgid "An infernal pact? But not even the whole text?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = ec20d747-f607-e7d2-48ce-3f4100462f7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ec20d747-f607-e7d2-48ce-3f4100462f7b
msgctxt "h2b59e428g688fg415eg9e75gb9da36151644"
msgid ""
"Something about 'the fires below'? It's just fragments of Infernal legalese."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = ec4c00a6-dd9f-fa0d-3907-3d99c1979edd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_Knows_PoemInfernal = False
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_PartySawScars = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ec4c00a6-dd9f-fa0d-3907-3d99c1979edd
msgctxt "hd5aa67a5g6879g47f5g8009g231739268574"
msgid "I - F - or is it an E? Is it even a letter?"
msgstr "I, F... 아니면 E인가? 글자는 맞아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = eec02de6-5e28-fb89-60f0-3a16346dca82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_Astarion_Knows_ScarsIsCazadorPoem_Character(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:eec02de6-5e28-fb89-60f0-3a16346dca82
msgctxt "h7b445b59gdcedg4980g841egbc99f84ada25"
msgid "Why? What's on your back?"
msgstr "왜? 네 등에 뭐가 있는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = f238ea3e-da32-2dfc-2f1b-6dd0692818fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f238ea3e-da32-2dfc-2f1b-6dd0692818fd
msgctxt "h159ba6cbgcfa6g4355gbd06g6450c16a6594"
msgid "Will we? How... sweet."
msgstr "함께? 참... 다정하셔라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = f30407cb-34e3-d983-a15d-3b623b849c4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f30407cb-34e3-d983-a15d-3b623b849c4a
msgctxt "h3e02bf71g9517g4b22gbdc0g91cad12b257c"
msgid "All right then."
msgstr "알겠어, 그럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = f4382d89-11cd-0700-28a0-982a065e61dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f4382d89-11cd-0700-28a0-982a065e61dd
msgctxt "hc9e68732gbe93g415dgb2b0gcce0ee54aca8"
msgid ""
"But if this is part of a contract, it must be powerful. Or valuable. Or both."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = f449d378-8f7b-8015-f2de-fd1412c6928e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f449d378-8f7b-8015-f2de-fd1412c6928e
msgctxt "hdeefdebegd830g4ce3g8c2fg49a88b1dbe49"
msgid "Tell me what it says!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = f4e56124-4bc8-974b-051a-27fee701bf38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f4e56124-4bc8-974b-051a-27fee701bf38
msgctxt "h9335da8ag9bdeg47f5gbf26g817bed1f88f7"
msgid "Want me to get a mirror?"
msgstr "거울 갖다줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = f7c9b682-45bd-94f0-39c5-c75cd3db30c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f7c9b682-45bd-94f0-39c5-c75cd3db30c2
msgctxt "h704bac1fg8f68g442bg8a55ga7bd43747e8d"
msgid "I'm not sure. Hold still, I'll draw it for you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = f831a55e-3e79-71d4-a64f-79ada795c2e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f831a55e-3e79-71d4-a64f-79ada795c2e5
msgctxt "hc5abf199gfe9ag43b2g935fgb9878842e682"
msgid "Want me to take a look?"
msgstr "내가 한번 봐 줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = f88727a1-027a-f494-e273-9851e97131fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f88727a1-027a-f494-e273-9851e97131fa
msgctxt "h068075a0g53f9g43e0g8c9eg951b19cf6775"
msgid ""
"A gift from Cazador, written in flesh. I think it says 'mind your own damn "
"business'."
msgstr "카사도어가 살에 새겨준 선물이지. 아마 '본인 일이나 신경 쓰셔'라고 적혀있지 않을까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = f8c65240-e808-8d44-f06f-44e1859b79bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f8c65240-e808-8d44-f06f-44e1859b79bb
msgctxt "hf5b6a9e0g64f3g46a5g9284g050d8ef9eade"
msgid "What does it matter? You're free of him now."
msgstr "그게 무슨 상관이야? 넌 이제 그로부터 자유를 얻었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Player
#. NodeID = f9fc416a-2696-1aa7-6d26-e3acf4cee310
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:f9fc416a-2696-1aa7-6d26-e3acf4cee310
msgctxt "hdd64b885g4aa8g43f6gac88gac191bcdccfe"
msgid "Let me have a look."
msgstr "한번 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = fc363436-ad5e-7e24-a4ba-9bcb41b70b4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:fc363436-ad5e-7e24-a4ba-9bcb41b70b4b
msgctxt "h2e6cfa16g83c3g4c42gb3e8g1d50e2b146da"
msgid "Ah! It's you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = fc53e07d-2645-6b85-f9d7-fe2e5786e12e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:fc53e07d-2645-6b85-f9d7-fe2e5786e12e
msgctxt "hd34ac510g4474g4fb9gb54ag4cfc5f00ae9e"
msgid ""
"But now that I'm free of him, now that I have a choice, I will do whatever "
"it takes to fight. I'll pay any price to undo what he did to me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = fcfa2f8c-1263-3046-a59a-53a4d465c502
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:fcfa2f8c-1263-3046-a59a-53a4d465c502
msgctxt "heac6ca00ge6abg4051gb146ge1882f412654"
msgid "Of course not. Why would I expect anything else?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = fe03e3a5-b70b-0ec6-50db-9f91ea2cb5f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:fe03e3a5-b70b-0ec6-50db-9f91ea2cb5f4
msgctxt "he53b468agb1f6g42dcg8ff7g738c4ba2ba18"
msgid "No! Wait - here."
msgstr "잠깐! 여기... 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = fe4ce330-c9b9-fe9e-3443-308d5c368d06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:fe4ce330-c9b9-fe9e-3443-308d5c368d06
msgctxt "hbd8a15aag7b28g417fgae3egce7e8e3ae35e"
msgid "I'll know soon enough. The devil will deliver, once the price is right."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = fe57e771-7d47-0255-aa0e-99fda2ec205a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:fe57e771-7d47-0255-aa0e-99fda2ec205a
msgctxt "h0be08f28ge499g4159g87c6g94abb99c09f2"
msgid ""
"I admit, I was curious, but it's hardly your concern. I'm happy to do this "
"alone."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Astarion
#. NodeID = fe875178-b3a3-41d2-48dd-0097c944c3b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:fe875178-b3a3-41d2-48dd-0097c944c3b1
msgctxt "h10ed8896gbfb5g4262ga306gf88fd9005ed6"
msgid ""
"Thank you. It never really occurred to me to ask for help, and - well..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading
#. Speaker = Narrator
#. NodeID = ff848987-6334-e55b-c5c9-00db337a8cfe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_ScarReading_KnowsItsInfernal(1) = True
#.   Global:
#.     - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_ScarReading:ff848987-6334-e55b-c5c9-00db337a8cfe
msgctxt "hefbf605dg1e3fg4c5agb6e3g079bf9aa037c"
msgid ""
"*The pattern swirls before you, runes hacked crudely into his flesh. You "
"can't read it, but you recognise the letters: Infernal, the language of the "
"Hells.*"
msgstr ""
"*문양이 당신 눈앞에서 소용돌이칩니다. 룬이 그의 살에 거칠게 새겨져 있습니다. 읽을 수는 없지만, 글자는 알아볼 수 있습니다. 지옥의 "
"언어인, 지옥어입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 0059d0f2-244a-4bf1-5c2b-78cc9992fe22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LAEZELCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:0059d0f2-244a-4bf1-5c2b-78cc9992fe22
msgctxt "h980175f7g5cc0g4f8dga15bg6ddd02739b0c"
msgid "I could be tempted to try Lae'zel."
msgstr "레이젤이 끌릴지도 모르겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 009791b5-aaa9-10eb-b8e0-fd16c25ef066
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:009791b5-aaa9-10eb-b8e0-fd16c25ef066
msgctxt "h8f8dab5ag9284g47e3g8eb0gaf28ebe3c030"
msgid "Ah, a refined palate! I can't disagree."
msgstr "아, 세련된 입맛! 동의하지 않을 수 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 017d9d52-32c3-4c03-ba55-79bd45cf0924
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - KARLACHCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:017d9d52-32c3-4c03-ba55-79bd45cf0924
msgctxt "h7b47a3fbg2ce0g4944gbdfeg91e3c54c3a65"
msgid "I'd risk Karlach."
msgstr "목숨이 걸리더라도 칼라크."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 01e82228-334d-7116-6ea0-28fa4ac9c63e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:01e82228-334d-7116-6ea0-28fa4ac9c63e
msgctxt "h8e6d2948g9fe8g4210g8a34g49e66bdbbb5c"
msgid ""
"In all these years, I've only ever fed on beasts. Drinking the blood of "
"thinking creatures is a different thing entirely."
msgstr "지금까지는 짐승에만 손을 댔었지. 사고하는 생명체의 피를 마신다는 건 완전히 다른 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 07e1f8fb-ddb2-93ed-b8d3-8c4ed6a54461
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:07e1f8fb-ddb2-93ed-b8d3-8c4ed6a54461
msgctxt "h2e765236g18b5g4861gabf2g3235a63dcfc6"
msgid "Are you <i>really </i>asking which of our companions I'd eat?"
msgstr "<i>진심으로</i> 내게 동료들 중 누굴 먹을지 묻는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 08158f56-bd61-ae90-931b-15d4d384a8f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:08158f56-bd61-ae90-931b-15d4d384a8f2
msgctxt "h3fb0b247g7f37g4394g8968ge8aba88f317d"
msgid "Hurt them and I'll kill you, no hesitation."
msgstr "그들을 해치면 망설이지 않고 널 죽여버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 14fb8cce-de0c-74be-cde1-9542012c0fec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:14fb8cce-de0c-74be-cde1-9542012c0fec
msgctxt "ha6707626g1682g4836ga087gd327de635846"
msgid ""
"So - in the spirit of theoretical questions - if you had to take a bite from "
"one of them, who would it be?"
msgstr "그러니까, 가정한다면 말이야 - 네가 그들 중 하나를 깨물어야 한다면 누굴 고를거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 18c5b807-643e-ee13-178f-da414fe10a0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - KARLACHCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:18c5b807-643e-ee13-178f-da414fe10a0b
msgctxt "h6a54ebc7g8c9fg4a3dg88aegc12b4fd3267d"
msgid ""
"Take Karlach, for example, her blood aged in the Hells. She's potent, like a "
"fiery whiskey."
msgstr "칼라크를 예로 들어볼까. 그녀의 피는 지옥에서 숙성되었지. 마치 불타는 위스키처럼 강력할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 1ee5401b-998d-3736-efb0-731aeb60d67c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:1ee5401b-998d-3736-efb0-731aeb60d67c
msgctxt "h66b2b703g2245g4d46g997ag8567f8521e9d"
msgid ""
"And I am deeply sorry. I was overeager - but can you blame me? You were my "
"first."
msgstr "그래 정말 미안해. 내가 너무 급했지, 하지만 그게 내 탓일까? 네가 나의 첫 상대였거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 22cd1bc6-a16c-61ab-7bf8-5ca9543a903b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:22cd1bc6-a16c-61ab-7bf8-5ca9543a903b
msgctxt "h7a1b33c1ga8dag4f0bgbec8gb1a85054cff4"
msgid "Good. I was getting tired of them anyway."
msgstr "잘됐네. 걔네가 질리려던 참이었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 2334b74c-ba74-bc10-647a-770a2f6bec72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:2334b74c-ba74-bc10-647a-770a2f6bec72
msgctxt "hddd3dabfg6947g4b4ag934bg5cde71c8040f"
msgid "Yes, heavens forbid we'd have an interesting conversation."
msgstr "그래, 우리가 나눴던 흥미로운 대화는 하늘도 용서하지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 2695696c-6789-e933-dd1c-b99382d97e14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:2695696c-6789-e933-dd1c-b99382d97e14
msgctxt "h55fb65feg2230g41dbg8b62ga1ba447cccf3"
msgid "Good hunting."
msgstr "성공적인 사냥이 되길."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 2a2e1bd9-bd10-14b1-9761-1038fbcd1e7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:2a2e1bd9-bd10-14b1-9761-1038fbcd1e7b
msgctxt "h65e5844dgbab2g42d6g9b81g827eb659a4f5"
msgid ""
"Although the more I think on it, the hungrier I get. I'd better go find "
"something I can actually get my teeth into."
msgstr "그런데 생각할수록 더 배가 고파지는걸. 가서 이빨을 박아 넣을 뭔가를 찾는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 2abedf1c-777f-4435-a9fb-df0e026990b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:2abedf1c-777f-4435-a9fb-df0e026990b4
msgctxt "hd2e100dag426cg4e63g8bf1g4813ec4d29d7"
msgid ""
"You can rest easy, I don't intend a repeat performance. Although I do wonder "
"how the others might taste."
msgstr "걱정하지 마, 내가 또 그럴 생각은 없어. 근데 다른 사람들은 어떤 맛일지 궁금하긴 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 2f09a61d-8ef1-b407-7e94-f5bdfc1cb26a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GALECOMPANION = True
#.      - CAMP_AstarionCompanion_DrankGaleBlood = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:2f09a61d-8ef1-b407-7e94-f5bdfc1cb26a
msgctxt "hafa5546fgaf08g4116g8c8agdda5c40aff2c"
msgid ""
"Take Gale, for example. He strikes me as someone whose blood is rich, "
"refined like a well-aged brandy."
msgstr "게일을 예로 들자면, 그의 피는 정제되어 맛이 풍부한, 잘 숙성된 브랜디 같을 거 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 2f26d976-600e-e930-1b71-7a01b694dc82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LAEZELCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:2f26d976-600e-e930-1b71-7a01b694dc82
msgctxt "he13a5ebcgc1eag48e4g8a81g134864acc140"
msgid "But the gith? What in the hells would she taste like?"
msgstr "하지만 그 기스양키는? 그녀는 대체 어떤 맛이 날까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 3262ae13-22bd-d5d3-fda9-e7216a859b31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:3262ae13-22bd-d5d3-fda9-e7216a859b31
msgctxt "haa994a6eg7c2eg4b9cgbd3bge63d52cd95e4"
msgid "Alas. It doesn't hurt to ponder the question, though."
msgstr "유감스럽게도. 하지만 이 질문을 숙고해 보는 것도 나쁘지 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 33d0ae11-8c1f-a8ac-746c-5ac951be5251
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:33d0ae11-8c1f-a8ac-746c-5ac951be5251
msgctxt "h1fae3a4bg36eeg4d77g83c9g4cec6f62a7f0"
msgid "Honestly, you have no sense of fun."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 3bcb73c3-e971-eb40-06b8-b1a0242e4e48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:3bcb73c3-e971-eb40-06b8-b1a0242e4e48
msgctxt "hf6baa76ag22f3g4e39g9dfeg276ab640e812"
msgid ""
"I appreciate your restraint. It would have spoiled the mood - you were my "
"first, after all."
msgstr "자제해줘서 고마워. 분위기를 망칠 수도 있었을 텐데, 어쨌든 네가 내 첫 번째였으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 449d095a-7041-1fbb-8da2-57fa136a9a6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:449d095a-7041-1fbb-8da2-57fa136a9a6d
msgctxt "h79670fa3g95f4g493fgadb1g3c8866d260e7"
msgid "Could I convince you to kill someone less useful?"
msgstr "덜 중요한 누군가를 죽일 수는 없을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 461d5388-65bf-abb4-d705-8f501d8549d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:461d5388-65bf-abb4-d705-8f501d8549d5
msgctxt "h764eeedbg9739g405dg9c49gdd7a0337f733"
msgid "This is still theoretical, right?"
msgstr "이건 다 그냥 해보는 말이야, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 48933a7b-16a1-c68a-6c3f-041196120d26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:48933a7b-16a1-c68a-6c3f-041196120d26
msgctxt "hf7cb9d3cgd1cdg4388gb447g73d420a2bf1f"
msgid "Don't tempt me, darling."
msgstr "날 시험하지 마, 자기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 499d7dcc-22f4-acf9-acc3-238fe2504dd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:499d7dcc-22f4-acf9-acc3-238fe2504dd5
msgctxt "h242c30d2g21cag406cg9f68g9ca06c79cb47"
msgid "Mmm, a meal that would put up a fight. An adventurous choice."
msgstr "음, 먹거리가 저항한다라. 흥미로운 선택이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 4ac5b0ea-eae9-c953-043a-40409f8ebe60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_TheHungerC_Bite = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:4ac5b0ea-eae9-c953-043a-40409f8ebe60
msgctxt "h8aee5d73g8a83g4d5fgbe9bgc32f46f75d55"
msgid ""
"You know, I was just thinking about you. Remembering our little encounter in "
"the night."
msgstr "있잖아, 너에 대해 생각하던 참이었어. 밤에 우리의 작은 만남을 기억하면서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 4d65bfa3-0264-62b2-a5cc-301c6dc7fffd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHADOWHEARTCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:4d65bfa3-0264-62b2-a5cc-301c6dc7fffd
msgctxt "h8b074f2eg15c1g42d0gb8begf95c883b4e1d"
msgid "If I had to? Shadowheart."
msgstr "그래야만 한다면? 섀도하트를 고르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 502676ac-e988-7958-e041-adc5ee15c235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:502676ac-e988-7958-e041-adc5ee15c235
msgctxt "h2cb38381g3acbg4579gb71eg726bdf847680"
msgid "Something that could lay you out. Calishite Absinthe, maybe?"
msgstr "기분을 전환할 수 있는 무언가. 칼리사이트 압생트 같은?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 5248cd4e-08c0-8a5a-3259-efba75e781b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:5248cd4e-08c0-8a5a-3259-efba75e781b6
msgctxt "h45c7a538ge7bdg4554ga273g5989d622a1c9"
msgid "Oh, I'm flattered. Who knew you had such taste?"
msgstr "오, 부끄러운걸. 네게 그런 취향이 있을 줄 누가 알았겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 5f437170-67b6-686e-0a7c-ef22ce1fe610
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:5f437170-67b6-686e-0a7c-ef22ce1fe610
msgctxt "h2c6fb469g2393g44dbg94deg082e71c889cf"
msgid "I much prefer eating flesh to blood."
msgstr "나는 피보다 살을 먹는 게 훨씬 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 64e118ea-47a8-e7c3-3dc1-a0930110f3eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:64e118ea-47a8-e7c3-3dc1-a0930110f3eb
msgctxt "h6c7bcb75g630eg4354gae1fgbb6aea1cb68c"
msgid "I just mean a sip of their blood. No mastication required."
msgstr "난 단지 한 모금의 피를 말한 거야. 씹을 필요는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 6643d9dc-ba3b-4f17-0f66-00bb0e49c311
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYLLCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:6643d9dc-ba3b-4f17-0f66-00bb0e49c311
msgctxt "h9acdb79bge4e0g4200ga996gf07db18191ac"
msgid "And Wyll? Well, I'm not quite sure. How do you think he'd taste?"
msgstr "윌은 어때? 난 잘 모르겠어. 그는 어떤 맛일 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 6d576f14-365d-3a12-ca24-7005b62d6818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:6d576f14-365d-3a12-ca24-7005b62d6818
msgctxt "h7504ae61g3b2bg4d35ga420g5d3beb572c5f"
msgid "Still, I am intrigued by the possibilities..."
msgstr "그래도, 나는 그 가능성에 흥미를 느껴..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 6e5232e1-4bf8-fc05-fc61-ee8ebd4a54ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:6e5232e1-4bf8-fc05-fc61-ee8ebd4a54ac
msgctxt "he6883da9gb851g4c51gaa55gb812dd356bb9"
msgid ""
"Don't worry, there's enough of me to go around. I'm a man of tremendous "
"appetites."
msgstr "걱정하지 마, 난 충분히 먹을 수 있으니까. 난 식욕이 엄청나게 왕성한 사람이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 725d7bd8-1b63-4e33-7b2c-c613c2c694fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:725d7bd8-1b63-4e33-7b2c-c613c2c694fa
msgctxt "h46341c1cg3684g4a50gbe32g843f5821ce54"
msgid "We still need them. That doesn't stop me from wondering, of course."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 732f031e-056e-dde0-85b8-393f045d0613
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:732f031e-056e-dde0-85b8-393f045d0613
msgctxt "h32005bd1g3978g48cegb637g4bfd8ecb06ed"
msgid "Something exotic, surely? An Amnan liqueur?"
msgstr "분명 이국적인 맛일 거야. <i>암</i>에서 온 술 느낌이려나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 73bb488f-67b9-766b-ed72-5b048be20d08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_TheHungerC_AvatarDeath = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:73bb488f-67b9-766b-ed72-5b048be20d08
msgctxt "hc04f65e2g5d61g47dfgb5b3g07da7558b66e"
msgid "'Delicious'? You <i>killed </i>me!"
msgstr "'달콤하다'고? 넌 나를 <i>죽였어</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 75d57aed-4b06-9563-5425-435d171d7037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:75d57aed-4b06-9563-5425-435d171d7037
msgctxt "h9cd40a5ag2177g4d69gb131gef416f4cc200"
msgid ""
"I don't think they'd volunteer, of course, but it doesn't make me any less "
"curious."
msgstr "물론 걔네가 지원할 것 같진 않지만 그 사실이 내 호기심을 식히진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 77019053-7360-350d-5c44-f16525d05609
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_AstarionHunger_SCO_Companion_AvatarKneed(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:77019053-7360-350d-5c44-f16525d05609
msgctxt "h26825f52g239dg413agb44dg7af4d9c4b767"
msgid "Yes, I'm still rather tender, now that you mention it."
msgstr "그래, 말한대로 아직은 약간 아파."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 776962dd-b18d-4fb2-7efb-99827ef70001
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:776962dd-b18d-4fb2-7efb-99827ef70001
msgctxt "hbb0d78f7g79e1g40c3g9184gb236054cab27"
msgid ""
"The very same. I've had this condition for two centuries, but truth be told? "
"You were my first."
msgstr "정확해. 2세기동안 이런 상태였지만, 솔직히 얘기해? 네가 처음이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 7871f999-6080-5d81-4d29-b3123a334d8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:7871f999-6080-5d81-4d29-b3123a334d8a
msgctxt "h7ef2e0deg36a5g437bg925fg5d051d61732f"
msgid "A brave choice."
msgstr "도전적인 선택인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 7999c9e4-cd63-f870-88d0-ab57cb05ffbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:7999c9e4-cd63-f870-88d0-ab57cb05ffbe
msgctxt "h6cfe9a02gdcceg4eeagbefbg1ff9a9616bb2"
msgid ""
"Unfortunately, all this talk is getting me hungry. I'd better find something "
"I can actually sink my teeth into."
msgstr "아쉽지만 이 대화는 날 더 배고프게 하는걸. 이빨을 박아 넣을 뭔가를 찾는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 79f4e1d8-869c-ad73-c33f-e7d24705fd44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:79f4e1d8-869c-ad73-c33f-e7d24705fd44
msgctxt "h84ea2f7dgc0d2g4ebbg91e4g33b77b3dcd60"
msgid "Relax, we're just talking."
msgstr "진정해, 그냥 얘기만 하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 7adcf614-509f-a74d-10a9-8161160955c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:7adcf614-509f-a74d-10a9-8161160955c4
msgctxt "hb0daccd6g1adbg4b74g8486ga1560666291c"
msgid "No one's getting killed, I swear. We're just two friends talking."
msgstr "맹세하는데, 아무도 안 죽어. 이건 그냥 친구 사이에 얘기하는 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 7bbf2770-1d21-1716-630f-d6ffb0920372
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:7bbf2770-1d21-1716-630f-d6ffb0920372
msgctxt "hd147faf4g1162g4422ga2d6g395934c7c2d2"
msgid "Something potent, I'm sure. A smoky Waterdeep whiskey?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 7ee1cb52-6d6a-d48c-a13d-d0f20be7d638
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:7ee1cb52-6d6a-d48c-a13d-d0f20be7d638
msgctxt "he0e4d536g7eb3g4070gac6dg1158f076b340"
msgid "We are not having this conversation. Good night."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 7fdf2995-dcb3-4dfb-d623-7115ce2ea7cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Astarion_CRD_TastingParty_MaleCompanion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:7fdf2995-dcb3-4dfb-d623-7115ce2ea7cb
msgctxt "h1fbd241dg6869g44bdgb56cgd75a4a0460a8"
msgid "He has a good heart. I'm sure he tastes sweet as any cider."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 8629d088-9be2-29f0-07de-7d73f9c37e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:8629d088-9be2-29f0-07de-7d73f9c37e8f
msgctxt "h5702128agd419g48d7gac35ge571e585fc96"
msgid "Oh no, don't be disgusting."
msgstr "오 아니야, 불쾌해 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 8a4e3dc9-3dc6-3877-175e-b3b4b14f44fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GALECOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:8a4e3dc9-3dc6-3877-175e-b3b4b14f44fa
msgctxt "h4f2cabb9g310bg4973g99d2ge53e5d714edc"
msgid "Gale, no question."
msgstr "여지없이 게일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 8b98db9c-192b-91e0-2991-233f6ccdae1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHADOWHEARTCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:8b98db9c-192b-91e0-2991-233f6ccdae1d
msgctxt "hf553b27dg30a1g4ae9gae1cga2860b16ea4e"
msgid ""
"Take Shadowheart, for example. She strikes me as having a heavy, enigmatic "
"flavour - vintage port on two legs."
msgstr "섀도하트를 예로 들어 볼까. 그녀는 무겁고 신비한 맛이 날 것 같아. 두 다리로 걷는 빈티지 포도주 같이."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 8c59ae7d-78e2-4dc6-a4a9-3246cf45853e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYLLCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:8c59ae7d-78e2-4dc6-a4a9-3246cf45853e
msgctxt "h1b1de854g2332g4665g94e0gdca983e154d5"
msgid ""
"Take Wyll, for example. A man of the people, very palatable, like a sweet "
"cider."
msgstr "윌을 예로 들어 볼까. 민중들의 남자답게, 아주 맛있고, 달콤한 사이다 같은 맛일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 8c6d462c-3482-c88c-b7c7-bc67397ecc66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:8c6d462c-3482-c88c-b7c7-bc67397ecc66
msgctxt "h6a826ac6gf004g4038ga4e5g1cc741f7ee1f"
msgid "A dangerous 'fancy'. They're all off the menu."
msgstr "위험한 '공상'이야. 그들은 모두 메뉴에서 제외됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 8f33be2b-b3de-7b79-ec67-6f0c5614e0a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:8f33be2b-b3de-7b79-ec67-6f0c5614e0a9
msgctxt "h2e70e178g305cg407eg8545g8f590c0c96aa"
msgid ""
"And I am very grateful. It did get me thinking about the others, though. How "
"they might taste."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 93242dc6-d145-ee4b-9343-f782c93fc000
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:93242dc6-d145-ee4b-9343-f782c93fc000
msgctxt "h64d9acc1g73e9g4e18g93adg8876d1b2ec60"
msgid "What? I was only making conversation!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 99fd05e5-4be0-6634-5cbf-50ba8645fd02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Astarion_TheHungerC_Bite = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:99fd05e5-4be0-6634-5cbf-50ba8645fd02
msgctxt "h2f46ec09gf66fg4325gbd5eg31ddfb05b47d"
msgid ""
"There you are, I was just thinking about you. And that delicious moment we "
"shared the other night."
msgstr "안녕, 네 생각을 하던 참이야. 그리고 우리가 전날 밤에 나눴던 달콤한 순간에 대해서도 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = 9bf2f415-052a-633a-2d53-1f9381c44e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:9bf2f415-052a-633a-2d53-1f9381c44e8f
msgctxt "hf16f75ddg66f0g4167g8e9bg61729f81adee"
msgid ""
"You're a sweetheart, but you don't need to worry - I'm just thinking out "
"loud."
msgstr "넌 정말 다정하네. 하지만 걱정할 필요 없어. 그냥 혼잣말을 하고 있는 것이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 9c9f8fae-4f16-4ef4-3bac-8c253c3e71cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:9c9f8fae-4f16-4ef4-3bac-8c253c3e71cc
msgctxt "h34327f1egdb3fg4fcbgaf70g56601ce86c65"
msgid "You're looking at other necks? I'm hurt."
msgstr "나 말고 다른 목을 탐내는 거야? 나 상처받았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 9d5cb15d-57b3-f430-8bdd-d5d2e81d2cd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:9d5cb15d-57b3-f430-8bdd-d5d2e81d2cd8
msgctxt "hff144388g217dg464bg898ag63c4e5cda5fe"
msgid "Savour the memory. It won't happen again."
msgstr "잘 기억해놔. 다신 그럴 일 없을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = 9d9e1b1a-d2a9-e918-e4d5-a3580bf195f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:9d9e1b1a-d2a9-e918-e4d5-a3580bf195f4
msgctxt "hdd8f1418gc9d0g4dffgbe32gc916fa0e8308"
msgid "That's it. We're done talking."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = a217eee1-f9d6-c312-09d1-ea85486c7b39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:a217eee1-f9d6-c312-09d1-ea85486c7b39
msgctxt "ha11b7ba4gd278g45f3g8a3dg14d28727dd1b"
msgid "A fine choice. She is enticing."
msgstr "좋은 선택이야. 그녀는 유혹적이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = a2ec7e16-3c0f-feec-bd2c-aae30e91bf7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:a2ec7e16-3c0f-feec-bd2c-aae30e91bf7b
msgctxt "h05bafaaeg5dc7g42eeg98e2g03f65edfeb51"
msgid "Keep your eyes to yourself. You'll make people nervous."
msgstr "눈독 들이지 마. 애들을 불안하게 만들 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = a502d0d7-10d2-9e94-aabd-f57740a690bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_AstarionHunger_SCO_Companion_AvatarFought(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:a502d0d7-10d2-9e94-aabd-f57740a690bc
msgctxt "h793eedcege25dg4021gad0ag89e446032401"
msgid "I had to fight you off me!"
msgstr "너를 떼어내려고 싸워야 했었지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = a834f8cb-ad4c-77d4-47fc-273422db3104
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:a834f8cb-ad4c-77d4-47fc-273422db3104
msgctxt "h8b13d9e9g371fg478dgb900ge82177886e97"
msgid "You're lucky I didn't kill you."
msgstr "내가 널 죽이지 않은 걸 다행으로 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = b1ff0624-759b-cc33-2c2b-5f2be4499b42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:b1ff0624-759b-cc33-2c2b-5f2be4499b42
msgctxt "h652860e1g141fg4b05g8550gc097703afead"
msgid "Anything that keeps you away from our necks."
msgstr "그렇게 해서 우리의 목이 네게서 안전해진다면야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = b376ebba-3e41-d565-3b73-3ec713fbfd5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:b376ebba-3e41-d565-3b73-3ec713fbfd5e
msgctxt "hb0ddaefag2108g4546g8472g18e197ac0311"
msgid ""
"I admit, I may have been a little eager. But can you blame me? You were my "
"first."
msgstr "인정하지, 좀 성급했던 것 같군. 그런데 그게 내 잘못일까? 네가 나의 첫 상대였거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = ba71f302-32fb-b777-f8c8-88237e11e0cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:ba71f302-32fb-b777-f8c8-88237e11e0cb
msgctxt "hbbd26525ge21cg476cg83ceg444b788858aa"
msgid "Do you have your eye on anyone in particular?"
msgstr "혹시 특별히 눈여겨보는 사람이 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = bf3fb075-86ab-c360-e8e9-de99dc1757e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:bf3fb075-86ab-c360-e8e9-de99dc1757e9
msgctxt "h0f525027g2df7g4e1dg9c4fg30986ae66769"
msgid "Personally, I'm trying to forget."
msgstr "나로서는, 잊으려고 노력 중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = bf79fcc3-b593-14ec-9054-33ec894e1c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:bf79fcc3-b593-14ec-9054-33ec894e1c2f
msgctxt "h75d18536gbe2eg40cbg95bag1b18e98876be"
msgid "I wouldn't expect any volunteers either."
msgstr "나도 누가 자원할 거라고는 생각하지 않았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = c35eacfa-8cea-c9fa-aa2e-3bb75b2d8d0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:c35eacfa-8cea-c9fa-aa2e-3bb75b2d8d0d
msgctxt "h172a6c30g8986g4c9bgac3cgaccceb09be1d"
msgid "A pity, they can be annoying sometimes."
msgstr "아쉽네, 그들 때문에 때로는 짜증날 때도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = c4823e55-787b-0ed9-482b-422f868bbc78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:c4823e55-787b-0ed9-482b-422f868bbc78
msgctxt "he44244a7g00c2g4056g983egadfa466204c2"
msgid ""
"I'm not going to bite any of them. They don't seem as accommodating as you "
"were."
msgstr "난 그들을 물지 않을 거야. 너만큼 그렇게 친절하지 않을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = c84714e1-1c71-e8e5-3ab2-323fc72ada0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:c84714e1-1c71-e8e5-3ab2-323fc72ada0a
msgctxt "h2f612f0agf647g4b10gb37bg0afff3392c87"
msgid "Ohh, that sounds very appealing. I'm almost convinced."
msgstr "오, 그것 참 맛나겠는데. 나 거의 넘어간 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = c88f42ba-860c-e234-f7fa-f2263dc054f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:c88f42ba-860c-e234-f7fa-f2263dc054f1
msgctxt "h96f2fc6dg1cd1g4f71gb3f2g3c643403084b"
msgid "The moment when you bit me?"
msgstr "네가 날 깨물었던 순간 말이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = cb5703d8-ee28-e160-9d78-5c10f9b3a881
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:cb5703d8-ee28-e160-9d78-5c10f9b3a881
msgctxt "h62ebf904g4d10g4ac6g8e32gd95900d05ee4"
msgid ""
"I do appreciate your enthusiasm, but let's try to restrain ourselves a "
"little."
msgstr "너의 열정은 고맙지만, 우리 스스로 조금만 더 자제하도록 노력하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = d523b255-6933-89c7-8b10-3b5e1cbdc1ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:d523b255-6933-89c7-8b10-3b5e1cbdc1ff
msgctxt "hc2c07217g24c3g4865g9506g57f88dc59432"
msgid "No, that's the thing. I can't quite figure them out."
msgstr "아니, 그게 문제야. 난 그들을 잘 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = d9164703-7a10-c136-a0fb-b14db8c8cd38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYLLCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:d9164703-7a10-c136-a0fb-b14db8c8cd38
msgctxt "h757da0dbg793eg4a73g8763g11d0ba4a4a8d"
msgid "Probably Wyll."
msgstr "아마 윌이지 않을까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = d9aef261-8bed-b495-4e5b-ab560a9e3a93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - KARLACHCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:d9aef261-8bed-b495-4e5b-ab560a9e3a93
msgctxt "h7d879b49gd396g4c36gb652g047557d0f19d"
msgid ""
"But Karlach? A tiefling seasoned by hellsfire? What could she possibly taste "
"like?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = e0705237-d325-4a80-c63f-3914787b2848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:e0705237-d325-4a80-c63f-3914787b2848
msgctxt "hcff4582cg48a8g4f98gb03ag3bf1ed2ac922"
msgid "Absolutely. A mere thought experiment."
msgstr "물론이지, 그저 사고 실험일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = e0740ceb-f216-2dc8-2e70-d051686b2ef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:e0740ceb-f216-2dc8-2e70-d051686b2ef0
msgctxt "h4cef5346gda42g4cd9ga5eegb69bbc09d5dd"
msgid "Pity, you're tastier than you know. And you were my first."
msgstr "유감이지만, 넌 네가 아는 것보다 더 맛있어. 그리고 네가 최초였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = e64225ba-ca1d-373b-b525-82015f63aa1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHADOWHEARTCOMPANION = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:e64225ba-ca1d-373b-b525-82015f63aa1f
msgctxt "ha18551eegc4acg493cgab20g7e38974d0133"
msgid ""
"But Shadowheart? I have no idea. How do you think our little enigma would "
"taste?"
msgstr "하지만 섀도하트는? 나도 모르겠어. 이 작은 수수께끼의 맛이 어떨 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = e8c32679-2f52-069f-5dc9-826e98536ad3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:e8c32679-2f52-069f-5dc9-826e98536ad3
msgctxt "h6ce26aaegb382g4409g9cd9g87b96a3d2085"
msgid "Interesting. I always thought he'd taste a little too sweet."
msgstr "흥미롭군. 난 항상 너무 달다고 생각했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = eb09284c-4027-a555-1ee3-61d005fd72c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:eb09284c-4027-a555-1ee3-61d005fd72c7
msgctxt "h0ade0312gbac2g4761gb1bbgaef76838a7f6"
msgid "Not that anyone's volunteered, it's just an idle fancy."
msgstr "아무도 자원하지 않았지만, 그냥 바보 같은 공상일뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = eb0fa761-538b-9ba2-cf57-3721ac8580a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:eb0fa761-538b-9ba2-cf57-3721ac8580a5
msgctxt "hbb8f73f8g7db5g4e70g896dgc872c7b3acd9"
msgid "Spoil sport."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = ef12e66c-90c5-41e0-4aa5-189025f3c9e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:ef12e66c-90c5-41e0-4aa5-189025f3c9e0
msgctxt "hdd7ef050g79c5g47e2gb6f9gf1a42042e4c7"
msgid "When you tried to bite me?"
msgstr "네가 날 깨물려고 했을 때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = f1e19d9d-d38b-27b0-03ff-5b9352f96b12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:f1e19d9d-d38b-27b0-03ff-5b9352f96b12
msgctxt "hba51c0e7gf93eg48a2g851cgb097edc6d60f"
msgid "You, of course."
msgstr "당연히 너지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = f2a601b6-4d86-7b47-b53a-ad6728368fe7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GALECOMPANION = True
#.      - CAMP_AstarionCompanion_DrankGaleBlood = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:f2a601b6-4d86-7b47-b53a-ad6728368fe7
msgctxt "h532b11b5g8219g4279ga4dagf8815b02425d"
msgid ""
"I'm all too familiar with Gale's blood, unfortunately. I can't recommend it."
msgstr "불행히도 난 게일의 피라면 너무 익숙해. 추천은 못 하겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = f52c23eb-2c67-4dff-e33c-4f5074952ed3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_AstarionHunger_SC_Companion_HasStake(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:f52c23eb-2c67-4dff-e33c-4f5074952ed3
msgctxt "hfbb76d40g9f30g4c40gaef2gf5899b92d404"
msgid "You're lucky I didn't drive that stake into your heart."
msgstr "내가 말뚝을 네 심장에 박지 않은 걸 다행으로 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = f8707e99-6a49-4c14-a686-5732d034c177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:f8707e99-6a49-4c14-a686-5732d034c177
msgctxt "hfd422d1bgbc49g4897g8ce5g8761a12c461b"
msgid ""
"Nothing out there will taste as good as the alternatives, but I'll make do. "
"Sweet dreams."
msgstr "저 밖엔 대체될 만큼의 좋은 맛은 없겠지만, 노력해 볼게. 좋은 꿈 꿔."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = f95570c6-353e-ca61-eeb6-43dd05c2da9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:f95570c6-353e-ca61-eeb6-43dd05c2da9c
msgctxt "h9e0eeb4dg84a7g496bgad38ge6a488d9312b"
msgid "I'd prefer a beer, if it's all the same to you."
msgstr "네게 상관없다면 난 맥주나 마시겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = fa2ef5e0-e4c9-859b-69e1-f69962704815
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:fa2ef5e0-e4c9-859b-69e1-f69962704815
msgctxt "h685e00e8g63e8g430fg83a7g551b13ce0f25"
msgid ""
"You were delectable. And now I just can't help but wonder how the others "
"taste."
msgstr "넌 정말 끝내주는 맛이었어. 그러고 보니 다른 애들은 어떤 맛일지 궁금해지더라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = fc5e28aa-01ec-880b-a40d-648daedd90ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_WLDMAIN_State_InRegion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:fc5e28aa-01ec-880b-a40d-648daedd90ac
msgctxt "hbfc12772gc00dg4784g9fdcg7f8152a8895c"
msgid ""
"There's nothing that tasty lurking out in the woods, but I'll make do. Sweet "
"dreams."
msgstr "숲에 숨어있는 것들 중엔 맛있는 게 없지만, 어떻게든 해보지 뭐. 좋은 꿈 꿔."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Player
#. NodeID = fe37f3e7-ea62-1b98-a9a3-5c502783ba24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:fe37f3e7-ea62-1b98-a9a3-5c502783ba24
msgctxt "h56e3a800gf4d8g46bbga22egb75066dd2e0b"
msgid "They might not be as open to the idea as I was."
msgstr "그들은 나만큼 그 생각에 호의적이지 않을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty
#. Speaker = Astarion
#. NodeID = ffd19495-c01a-c08a-e79f-73620cfc3691
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_CRD_TastingParty:ffd19495-c01a-c08a-e79f-73620cfc3691
msgctxt "hb491e190g3fecg473cga22eg875b101fe8fd"
msgid ""
"The very same. It obviously put me off your neck, but now I can't help but "
"wonder how the others taste."
msgstr "정확해. 확실히 너의 목에겐 거부당했지만, 다른 사람들은 어떤 맛일지 궁금하지 않을 수가 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 00c850c1-ccec-697b-1981-0e9a360c8720
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:00c850c1-ccec-697b-1981-0e9a360c8720
msgctxt "he5a9407cg0fd6g4481gbff8gcddf71567e28"
msgid "We had a deal - the orthon for information."
msgstr "우린 거래를 했어. 오르쏜과 정보를 교환하기로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 01266747-b5ac-cc3f-642b-86abd294e3f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:01266747-b5ac-cc3f-642b-86abd294e3f4
msgctxt "hc745fb8agfc61g49b4gbf83gbd6f414584f8"
msgid ""
"The arousals and appetites of man will return to him, and unlike you, he "
"will have no need of a parasite to protect him from the sun."
msgstr "카사도어는 사람의 성욕과 식욕을 돌려받게 될 테고, 당신과는 달리 태양으로부터 보호해 줄 기생충도 필요하지 않겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 05fcb10c-a896-8e92-f997-d6bb470a5b1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:05fcb10c-a896-8e92-f997-d6bb470a5b1e
msgctxt "h2abccaf4gd9cdg4284gafbege10ae6f089db"
msgid "I need to take the fight to him."
msgstr "그에게 맞서 싸워야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 0b0476ee-2e8f-2318-6dec-c8e39f8eb5bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:0b0476ee-2e8f-2318-6dec-c8e39f8eb5bf
msgctxt "h63189e27g960dg4047g906ege4594d4c2c7e"
msgid ""
"We can't let Cazador complete that ritual. He could unleash terrible horrors."
msgstr "카사도어가 그 의식을 끝내게 둘 수는 없어. 끔찍한 공포를 세상에 풀어둘 수도 있게 되는 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 111942dd-5299-89ae-9c86-ea4e941fabd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:111942dd-5299-89ae-9c86-ea4e941fabd1
msgctxt "h151dad11g8d91g44f1gb990g8b5cd8de7127"
msgid ""
"You are the final piece he requires to complete the ritual - your scars bind "
"you to it. Your soul will set off a very wave of death, bringing Cazador his "
"twisted life."
msgstr ""
"의식을 끝내기 위해서 필요한 마지막 조각이 바로 당신이죠 - 당신의 흉터는 거기 묶여 있어요. 당신의 영혼은 바로 그 죽음의 파도에 "
"휩쓸려, 카사도어에게 뒤틀린 삶을 가져다주는 데 쓰일 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 117a758a-76e7-34b8-4cbd-b9b9ceae2553
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:117a758a-76e7-34b8-4cbd-b9b9ceae2553
msgctxt "h9cca5b61g37a1g4779g80a7g7cffbe9757ef"
msgid "You'll never be free while Cazador lives."
msgstr "카사도어가 살아있는 한, 넌 절대 자유롭지 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 12b7a01f-3b3b-19d5-519b-d12b8707d22e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:12b7a01f-3b3b-19d5-519b-d12b8707d22e
msgctxt "he17f3fe8gd6acg44bag820bg2f6aa3613057"
msgid "Of course I'll help. We'll hunt him down and kill him."
msgstr "당연히 돕지. 카사도어를 찾아내서 죽여 버리자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 134ae05f-d6f1-d845-04f2-944936b21df7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:134ae05f-d6f1-d845-04f2-944936b21df7
msgctxt "h93650b84gd3e0g4827g9681gfa3f53719d59"
msgid ""
"He thought I would dismember him but he has his uses so instead I am "
"<i>reeducating </i>him."
msgstr "그 친구는 내가 그의 사지를 잘라버릴 줄 알았겠지만, 그도 나름대로 쓸모는 있어서 대신에 <i>재교육</i>시키기로 했죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 17ee7df4-6cbf-a40b-6b9d-9effd10793e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:17ee7df4-6cbf-a40b-6b9d-9effd10793e3
msgctxt "hedef1b34g57f0g4e3ag9368g2c158b41cf8a"
msgid "We delivered the devil. Now I want what I'm owed - we had a deal."
msgstr "데빌을 넘겨줬잖아. 이제 내게 빚진 걸 돌려줄 차례야 - 우리가 계약했던 대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 18e8c37a-ca54-9cae-4ac2-933fda38884b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:18e8c37a-ca54-9cae-4ac2-933fda38884b
msgctxt "h3ed924dagb1dag4fd0gabebg5c0cdb249a98"
msgid "After we dealt with our tadpole problem, yes, I'll help you then."
msgstr "올챙이 문제를 해결한 다음에는. 그래, 그땐 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 1908e003-4559-5052-705d-b8de86cc1e21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:1908e003-4559-5052-705d-b8de86cc1e21
msgctxt "hd8f9c7beg2066g42e5g8036g14687f146aab"
msgid ""
"As you wish. Brace yourself, Astarion - we're about to unveil your destiny."
msgstr "바라시는 대로. 마음의 준비를 하시길, 아스타리온. 당신의 운명을 밝히기 직전이니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 1b6a205f-abe1-25d0-4df3-e2eb8e528140
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_RaphaelToldRitual = True
#.     - ORI_Astarion_Knows_RitualsPurpose = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:1b6a205f-abe1-25d0-4df3-e2eb8e528140
msgctxt "h6f8b441dg1096g4ec2g9b8bgf4e525a815b8"
msgid ""
"But the ritual has its price, as all worthwhile things do. Lord Cazador will "
"need to sacrifice a number of souls, including all of his vampiric spawn, if "
"he is to ascend."
msgstr ""
"하지만 의식은 대가가 있지요, 다른 모든 가치있는 일들이 그렇듯이. 카사도어 경은 승천하기 위해서, 그의 모든 뱀파이어 스폰을 포함해 "
"정해진 수의 영혼을 희생시켜야 할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 29e866a5-9b37-40ac-4059-7ce5315a6dcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:29e866a5-9b37-40ac-4059-7ce5315a6dcf
msgctxt "h8a114043gd8dbg48d5g9ce2g5a161cba8a50"
msgid ""
"There's a way to become a living vampire... That must mean a lot to you."
msgstr "살아있는 뱀파이어가 되는 방법이 있다는 거… 그건 너한테 의미가 크겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 2a461cba-d503-6daf-64a8-87c3d80bda47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:2a461cba-d503-6daf-64a8-87c3d80bda47
msgctxt "h23518b6fgd8bdg48c4gbe70g3d9965e24e1e"
msgid "The Absolute is a greater threat - we need to focus."
msgstr "절대자가 더 큰 위협이야. 우린 거기에 집중해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 2e77f13b-e08e-5c93-013b-9a1c2396deec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:2e77f13b-e08e-5c93-013b-9a1c2396deec
msgctxt "h6bf6f4a8gc286g49c5g8483gfc94c3a48257"
msgid ""
"It promises to be a marvellous ceremony. Very elaborate, incredibly ancient, "
"and entirely diabolical."
msgstr "그 의식은 환상적일 겁니다. 아주 정교하고, 믿을 수 없을 만큼 옛 것인 데다가, 전적으로 사악하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 2fe01fc2-695d-3bc0-5c0b-dd0e3f6919b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:2fe01fc2-695d-3bc0-5c0b-dd0e3f6919b1
msgctxt "ha272132eg593bg4e62gb376g9d8025e994a9"
msgid ""
"Oh come, Astarion. We're about to unveil your destiny - you should be "
"quivering in anticipation."
msgstr "왜 그래요, 아스타리온. 당신의 운명을 밝히기 직전인데, 기대감에 떨어야 마땅하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 34336cc0-3ee9-a1d0-6fa3-19399902a8a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:34336cc0-3ee9-a1d0-6fa3-19399902a8a3
msgctxt "hf8ca325fgc49dg48c9gb12cga898e17a5179"
msgid "The idea definitely has appeal."
msgstr "혹하는 얘기긴 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 37aa2169-8259-483b-0c91-fe57d8e0c491
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:37aa2169-8259-483b-0c91-fe57d8e0c491
msgctxt "h7363886dg82b8g48e4gb44ag43a69f311958"
msgid ""
"He'll never leave me alone. I didn't think he would when I was just one more "
"wretched toy for him to play with."
msgstr "카사도어는 날 절대 내버려 두지 않을 거야. 내가 단지 그의 망할 장난감 중 하나였던 줄 알았던 때에도 그렇게 생각했었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 3b05209a-d55d-9636-ec70-63988bf866eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:3b05209a-d55d-9636-ec70-63988bf866eb
msgctxt "h199a955fge19ag4e5bgbe47gd490f556deb4"
msgid "You're... quiet. It's unsettling."
msgstr "오늘따라… 말이 없네. 불안해지게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 53a963e7-89c3-45cc-7155-d3b2e5fbdad4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Astarion_CRD_ScarReading_ReadScar(1) = True
#.   Global:
#.      - ORI_Astarion_Knows_PoemInfernal = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:53a963e7-89c3-45cc-7155-d3b2e5fbdad4
msgctxt "h123a4664gd550g4278g889ag2f2b8f15bfa8"
msgid ""
"As you know already, your precious skin is home to one part of a contract "
"between the archdevil Mephistopheles, and your former master, Cazador Szarr."
msgstr "이미 알다시피, 당신의 소중한 살갗에 새겨진 건 아크데빌 메피스토펠레스와 당신의 옛 주인, 카사도어 자르가 맺은 계약의 일부죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 548f2bca-dff6-c334-03fa-a0384fb3698a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:548f2bca-dff6-c334-03fa-a0384fb3698a
msgctxt "hb24891e2g3fb0g48dbgbc18gf51e2af6e8f1"
msgid "Cazador is a piece of shit. We're going to stop him."
msgstr "카사도어는 쓰레기 새끼야. 우리가 막으러 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 55daf80a-df54-a71e-d75b-a06b0c614d09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:55daf80a-df54-a71e-d75b-a06b0c614d09
msgctxt "hffb4c463gfbdcg4efdga115gd8ad85b225f6"
msgid "We're done talking about this, Astarion. My decision is made."
msgstr "이 얘기는 끝났어, 아스타리온. 난 이미 마음을 정했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 57c0dbe1-4b1b-4ddd-fe0a-6ad08789b0e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:57c0dbe1-4b1b-4ddd-fe0a-6ad08789b0e9
msgctxt "h6cc8da56gafc3g441dg8e98g5abceb942f8f"
msgid "Not a chance."
msgstr "어림도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 586d6332-b5b0-5678-6181-d78179f8c334
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:586d6332-b5b0-5678-6181-d78179f8c334
msgctxt "hbb7d6bcdg6141g48a7g9478g130aae8b035e"
msgid ""
"He returned to me chastened but intact, his wounds healed, his body restored."
msgstr "유르기르는 혼쭐이 나긴 했지만 온전하게 내게 돌아왔더군요. 상처는 치료되고, 육체도 수복됐죠. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 59ea597d-3900-979f-1d8c-4ecdfe4a9a63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:59ea597d-3900-979f-1d8c-4ecdfe4a9a63
msgctxt "hdee1f4adgf70ag4e7ag93f0gc9ec71e01e32"
msgid ""
"I could get rid of the worm in my head and still walk in the sun. I'd "
"finally be free of the hunger."
msgstr "내 머리에서 기생충을 뽑아내고도 태양 아래서 걸을 수 있어. 드디어 굶주림에서도 벗어날 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 5d1f3949-22ae-b4f9-3da4-74ddbeace173
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:5d1f3949-22ae-b4f9-3da4-74ddbeace173
msgctxt "h4cb26167gff36g4ac5gbecbg190bdaba8ee5"
msgid "How long do you think I can run? He has eternity to find me."
msgstr "내가 언제까지 도망칠 수 있겠어? 카사도어는 날 영원토록 쫓을 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 5f0a4072-77a5-9480-f6ec-aaf9b93e98e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:5f0a4072-77a5-9480-f6ec-aaf9b93e98e0
msgctxt "hca262f1dge803g4db2gbdbfg131b906056c9"
msgid ""
"And if I'm the key to this deal of Cazador's, perhaps I can turn this to my "
"advantage..."
msgstr "그리고 내가 카사도어가 한 계약의 핵심이라면, 어쩌면 내가 우위를 선점할 수 있을지도 모르지…"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 606530a1-6ff5-4cbd-084e-d9644f5be903
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:606530a1-6ff5-4cbd-084e-d9644f5be903
msgctxt "h511a95ceg2fabg422ag8803g4f3cb1aaebd7"
msgid "I was... contemplating. It's a lot to take in."
msgstr "그냥… 고민하는 중이었어. 한번에 받아들이기엔 좀 벅차서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 67f6c2b5-dbef-e6fb-0ef6-6576b2b1075e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:67f6c2b5-dbef-e6fb-0ef6-6576b2b1075e
msgctxt "h329c3d8cge091g4360g82feg6da9fa8ff5ee"
msgid "And I need you to help me."
msgstr "그리고 네가 날 도와줬으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 6a2fecc3-a8c5-3566-266b-5328564e7a9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:6a2fecc3-a8c5-3566-266b-5328564e7a9c
msgctxt "hdb8cf229ge4f5g4bbbga557ge45b5ce3ae20"
msgid ""
"Indeed we did. I discovered all there is to know about those scars of yours -"
" it's a rather grim tale, even for my tastes."
msgstr "물론이죠. 당신의 흉터에 대해 알 수 있는 건 전부 알아왔답니다. 상당히 음산한 이야기에요, 제 취향을 감안해도 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 6e910906-a6ed-d94a-d08d-2888c8a57e6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:6e910906-a6ed-d94a-d08d-2888c8a57e6d
msgctxt "hdf7882e3g97feg4c24g9f55g74501f0a6579"
msgid "Spill it - this sounds fascinating."
msgstr "말해 봐, 흥미진진할 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 6ef24660-6f75-1553-d701-54dad95e18d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:6ef24660-6f75-1553-d701-54dad95e18d7
msgctxt "h0c942ea2g56cag47c0g93c6gb2c9e2b6fcef"
msgid ""
"I'd appreciate a little less enthusiasm when it comes to Cazador and his "
"horrors."
msgstr "카사도어랑 그가 일으킬 참상 얘기를 할 땐 조금만 덜 신나 하면 고맙겠는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 70ac57d6-ecf0-4eed-1f0c-5bac55235866
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:70ac57d6-ecf0-4eed-1f0c-5bac55235866
msgctxt "h58b4b0c5g8db0g44e9gb638g8b1022e28f48"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 72fde7d6-950c-0167-0def-fd5a9823c1f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:72fde7d6-950c-0167-0def-fd5a9823c1f8
msgctxt "ha6e601bcgf2e5g4e91gb5a9g9060c3e52700"
msgid ""
"Carved into that ivory skin of yours is one part of an infernal contract "
"between the archdevil Mephistopheles and your former master, Cazador Szarr."
msgstr "당신의 상앗빛 피부에 새겨진 건 아크데빌 메피스토펠레스와 당신의 옛 주인 카사도어 자르가 맺은 지옥의 계약 일부분입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 76cd7491-bc6a-5e89-d147-d5f1abeb8017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:76cd7491-bc6a-5e89-d147-d5f1abeb8017
msgctxt "hee16ce29g06dcg430agaf47g6d90e9fa92f4"
msgid "Do you think it's so simple?"
msgstr "그게 그렇게 간단한 줄 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 7978433f-62d5-a1ca-fcb2-857d686ef878
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:7978433f-62d5-a1ca-fcb2-857d686ef878
msgctxt "he46bcca0g43ecg4d60g970bg18cfb96c7799"
msgid ""
"I think you should run. If Cazador can't find you, he can't complete his "
"ritual."
msgstr "도망치는 게 좋겠어. 카사도어가 널 찾지 못한다면, 의식을 끝낼 수 없을 테니까.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 7b7a7b28-28b1-7232-cae6-5d8379c8c4c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:7b7a7b28-28b1-7232-cae6-5d8379c8c4c9
msgctxt "h02f6ee71gdccfg471cg9df4ge686c642a200"
msgid ""
"Even if I wanted to walk away from all of this, I can't. Cazador won't let "
"me."
msgstr "내가 이 모든 일에서 그냥 빠져 버리고 싶다고 한들, 그럴 수 없어. 카사도어가 그렇게 두지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 7edbc24a-6b43-0ad0-680d-12c88a90f2c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:7edbc24a-6b43-0ad0-680d-12c88a90f2c8
msgctxt "h31c350ffg1640g40a4ga91dg1289394f2e4b"
msgid "You don't need to go back to Cazador - you're with me now."
msgstr "카사도어에게 돌아갈 필요 없어, 넌 지금 나랑 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 84578ee1-57f8-2962-ff76-765750edf01d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:84578ee1-57f8-2962-ff76-765750edf01d
msgctxt "h49725325gc7e5g4a26g8ca2gd0d27c8f0f65"
msgid "'Hmm'? That's all you have to say?"
msgstr "'흠'? 그게 다야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 850e65e8-7f43-96b5-71e1-0e5624268d83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:850e65e8-7f43-96b5-71e1-0e5624268d83
msgctxt "h535d1b0fg7950g4c26ga0bfg8c1d9dfef7af"
msgid ""
"If he completes the rite, he will become a new kind of being - the Vampire "
"Ascendant."
msgstr "만약에 그가 의식을 마친다면, 완전히 새로운 존재가 될 겁니다. 바로 승천한 뱀파이어지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 85fd29cf-6639-a3cb-cc9f-8cd114a5513e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:85fd29cf-6639-a3cb-cc9f-8cd114a5513e
msgctxt "h7f601673ga564g4280g8c18g7981c01df4de"
msgid ""
"In full, the contract states that Cazador will be granted knowledge of an "
"infernal ritual so vile it has never been performed."
msgstr ""
"자세히 말하자면, 그 계약서에는 극히 부도덕해서 그동안 한 번도 치러지지 않은 의식에 대한 정보를 카사도어에게 제공한다는 내용이 명시되어 "
"있답니다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 8678ac84-aebc-4e1b-9e69-960631cdda52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:8678ac84-aebc-4e1b-9e69-960631cdda52
msgctxt "h50595f2dg8f10g4d22ga438g1c3b02c66242"
msgid "The end of my life among them. Just when I was starting to enjoy it."
msgstr "거기서 내 명도 같이 끝나겠지. 이제야 갓 만끽하기 시작했는데 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = 8c592942-fae5-c842-ca6b-fa0ef5178123
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:8c592942-fae5-c842-ca6b-fa0ef5178123
msgctxt "h87da0b14g3d35g421fgaae9g81a596dec82f"
msgid ""
"But if I'm the key to this power he craves, he'll hunt me to the ends of "
"Faerûn."
msgstr "그렇지만 내가 그토록 갈망하는 힘의 열쇠라면, 카사도어는 페이룬의 끝까지 나를 추적할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = 8f43bca4-a66d-64dc-a724-657bcbbe38c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:8f43bca4-a66d-64dc-a724-657bcbbe38c0
msgctxt "h39723200gb12dg469dga2f9gc1f0909d4c0f"
msgid ""
"Do you know what happens when a devil is struck down on this charming plane "
"of existence?"
msgstr "이 매력적인 물질계에서 데빌이 죽는다면 어떤 일이 벌어지는지 알고 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 91c73867-1107-7fed-d17c-41f4b936f660
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:91c73867-1107-7fed-d17c-41f4b936f660
msgctxt "h3f2126c3gfc6eg40ccg8729g7ae493a2f657"
msgid "Please, give me more boring details about your plans."
msgstr "제발, 네 지루한 계획에 대해서 더 자세히 말해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = 9a54a9fc-d388-d05f-fdab-4a4835933a43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:9a54a9fc-d388-d05f-fdab-4a4835933a43
msgctxt "hb07d445fg279dg44f5g8a62gb116b0b0356f"
msgid ""
"If he comes for you, I'll defend you. But we're not risking an attack on his "
"lair."
msgstr "카사도어가 널 잡으러 온다면, 거기에 맞서 싸울게. 하지만 그의 소굴에 쳐들어가는 위험은 감수할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = a78046af-f359-24d0-bb8f-91a941c6e9c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:a78046af-f359-24d0-bb8f-91a941c6e9c3
msgctxt "hb75b9727g89afg4b94gb960gf5a7a44bfe6f"
msgid "It's a lot to take in."
msgstr "생각할 게 좀 많네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = a7c666e8-fd71-2251-ec00-6865118b4532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:a7c666e8-fd71-2251-ec00-6865118b4532
msgctxt "h098a8ab8g57c5g457cgac84gbc281efc5cc1"
msgid ""
"In the case of our friend Yurgir, the orthon you so handily dispatched in "
"the temple of Shar, he manifested in my House of Hope."
msgstr "우리의 친구, 당신들이 샤의 신전에서 너무도 손쉽게 보내버린 오르쏜 유르기르의 경우엔 제 희망의 집에 나타났답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = acd27248-2277-7271-0a6e-d8e243a5e286
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:acd27248-2277-7271-0a6e-d8e243a5e286
msgctxt "h50f2a3c0g2d70g418bg8ba7g3c32503c0973"
msgid ""
"Do you know what happens when a devil is struck down on this charming plane "
"of existence?"
msgstr "이 매력적인 물질계에서 데빌이 죽는다면 어떤 일이 벌어지는지 알고 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = b23850c3-9eb6-dbb2-76b4-b24bf8c569cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:b23850c3-9eb6-dbb2-76b4-b24bf8c569cf
msgctxt "hbeea2a27g730dg4512gba6cg844d99e52d10"
msgid ""
"All the strengths of his vampiric form will be amplified, and alongside them "
"he will enjoy the luxuries of the living."
msgstr "그가 뱀파이어로서 가진 모든 힘은 증폭되고, 그와 동시에 살아있는 생명이 누릴 수 있는 사치도 전부 만끽할 수 있을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = b45095fe-1a9b-09ac-2835-8e055e230243
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:b45095fe-1a9b-09ac-2835-8e055e230243
msgctxt "h82ea9270gb540g41f6gbe31g905d9f50c72a"
msgid "The only missing ingredient is Astarion."
msgstr "유일하게 빠진 재료는 아스타리온이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = b4566a2a-a587-bb96-2ef2-75fe8bd6d8ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:b4566a2a-a587-bb96-2ef2-75fe8bd6d8ed
msgctxt "h249f13dcgdfc0g4fa4ga8e2g503d642abe6e"
msgid "What do you think I should do?"
msgstr "내가 뭘 해야 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = c131a65f-99bd-e2d1-d029-5b2319d42525
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:c131a65f-99bd-e2d1-d029-5b2319d42525
msgctxt "h85597581g58d9g468eg994ag0c9a18ec1e2d"
msgid ""
"It returns to the hells - to the very point where it last stood before "
"venturing to whichever devilforsaken plane it died on."
msgstr "지옥으로 돌아온답니다. 그가 사망했던, 악마를 저버린 차원으로 떠나기 전에 마지막으로 발을 디뎠던 지점으로 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = ca775a57-c1b5-d13b-fa0c-1ecfa36ee890
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:ca775a57-c1b5-d13b-fa0c-1ecfa36ee890
msgctxt "h6020ddd4gcd13g4afcgac4dgd0893420b2b3"
msgid ""
"The arousals and appetites of man will return to him, and unlike Astarion, "
"he will have no need of a parasite to protect him from the sun."
msgstr "사람의 정욕과 식욕을 돌려받고, 아스타리온과는 다르게, 태양으로부터 보호해 줄 기생충도 필요치 않을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = cc7e5143-0f6a-bd21-08c0-d167ae8bdff5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:cc7e5143-0f6a-bd21-08c0-d167ae8bdff5
msgctxt "h2868eb9cg5bccg415bg9b0dgcf7eec122333"
msgid ""
"I knew he wouldn't leave me alone even when I was just another wretched toy "
"for him to play with."
msgstr "내가 단지 카사도어의 망할 장난감 중 하나였던 때에도, 그가 나를 가만히 내버려 두지 않을 거라는 걸 알았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = ce467a6a-e3e0-1e41-95eb-4442dd47016c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:ce467a6a-e3e0-1e41-95eb-4442dd47016c
msgctxt "h1d07a7a2geaa1g44eega65fg46762f3ef86f"
msgid ""
"Are you sure you want to know, Astarion? Maybe it's best left in the past."
msgstr "정말 알고 싶어, 아스타리온? 어쩌면 과거는 과거에 묻어 두는 게 좋을 지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = d30502f3-33a6-2454-f414-5beb829712ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:d30502f3-33a6-2454-f414-5beb829712ab
msgctxt "h71731debgbb66g45abgb5f6g4902cd430883"
msgid ""
"Come now, we're about to unveil your destiny - you should be quivering in "
"anticipation."
msgstr "왜 그래요, 지금 당신의 운명을 밝히기 직전인데. 기대감으로 떨고 있어야 마땅하죠.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = d332d5b0-2268-d14f-6d32-e721e34bb6da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:d332d5b0-2268-d14f-6d32-e721e34bb6da
msgctxt "h6b51e614g4947g4f19g8423g2d8322e481d2"
msgid "I hate how right you are."
msgstr "네 말이 옳다는 게 진짜 싫다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = d78172a2-df6e-5afd-4eb7-65ce3eef1a51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:d78172a2-df6e-5afd-4eb7-65ce3eef1a51
msgctxt "h998cb5c5g8685g487egb095ge750b3b64c57"
msgid "Fine."
msgstr "그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = d9cace5a-3dc4-b5f0-0701-303df79b1776
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:d9cace5a-3dc4-b5f0-0701-303df79b1776
msgctxt "h53e63979gb234g47dfg8317gf2e02be8637c"
msgid ""
"I need to deal with Cazador while I still have any kind of advantage over "
"him."
msgstr "아직 내게 조금이라도 이점이 있을 때 카사도어를 처리해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = d9ebe1aa-b962-b7e2-ebca-43fcc46538aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:d9ebe1aa-b962-b7e2-ebca-43fcc46538aa
msgctxt "h1ef2c82fg60a6g4e76gad55g95bae23ae089"
msgid ""
"And that, my tragic and toothsome friend, is that. Now if you'll excuse me, "
"I have business elsewhere."
msgstr "이것이, 나의 비극적이고도 매력적인 친구여, 모든 일의 전말이랍니다. 그럼 이만 실례하겠습니다. 다른 볼일이 있어서 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = da7c7b13-dbcd-2a6f-90bd-d6f2813e2cf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:da7c7b13-dbcd-2a6f-90bd-d6f2813e2cf9
msgctxt "h88d7f82bg90e8g47b2g85cdgbd8de50c454c"
msgid "Stop stalling."
msgstr "잡담은 그만해. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = db908759-63a7-2a5a-d497-cdb17170ca89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:db908759-63a7-2a5a-d497-cdb17170ca89
msgctxt "h5eb37227geca5g4d22g8537g25503097b125"
msgid "And why <i>would</i> he want to walk away? This is his destiny."
msgstr "그리고 <i>왜</i> 이 일에서 빠지고 싶겠어요? 이게 그의 운명인걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = df0961b7-ac09-d99d-5e05-21b305419bd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:df0961b7-ac09-d99d-5e05-21b305419bd4
msgctxt "hdb47673age00ag41e2ga4f3g3efd590da201"
msgid "The Rite of Profane Ascension."
msgstr "불경한 승천의 의식."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = e6983cc0-b636-6834-331f-866d1807b79a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:e6983cc0-b636-6834-331f-866d1807b79a
msgctxt "h1466c36cg493bg4541g89ffg9b78a5e3786a"
msgid ""
"If you won't risk taking him on for my sake, think of the innocent souls "
"he'll sacrifice in this ritual."
msgstr "나를 위해서 위험을 감수하고 싶지 않은 거라면, 카사도어가 의식에서 희생시킬 무고한 영혼들을 생각해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = e722db76-0e3a-f910-8d45-e3e85c4e7bb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:e722db76-0e3a-f910-8d45-e3e85c4e7bb3
msgctxt "ha4afddf1gd25cg4981ga25cgbe5c4f48149c"
msgid ""
"Once we deal with the tadpole, I'll be back to my nocturnal self. When "
"you're being hunted by vampires, the dark is the worst place to hide."
msgstr ""
"올챙이 문제를 해결하고나면, 난 다시 어둠속으로 돌아가야겠지. 그리고 뱀파이어들에게 사냥당하는 입장에서 어둠은 최악의 은신처라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Player
#. NodeID = edf90f2e-14af-b0ad-a6a5-e2462b989bcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:edf90f2e-14af-b0ad-a6a5-e2462b989bcb
msgctxt "h6d8c2525g6a38g4e52ga669g622bf8106192"
msgid "You're right - I'll help you destroy him."
msgstr "네 말이 맞아. 놈을 없애는 걸 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Astarion
#. NodeID = f94f0909-a159-1a29-9315-3ac786cdb898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:f94f0909-a159-1a29-9315-3ac786cdb898
msgctxt "h5eaf7f8dg746dg4bd3g839egc56b044083f7"
msgid "Hmm..."
msgstr "흠..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM
#. Speaker = Raphael
#. NodeID = ffaa0cca-4685-95d1-76cf-4ea697b173da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_RaphaelsRevelation_CFM:ffaa0cca-4685-95d1-76cf-4ea697b173da
msgctxt "hde7e90c5gd723g4177g85adg28b72bc4bd38"
msgid ""
"Imagine how he felt, then, when one of those precious spawn simply "
"disappeared into thin air."
msgstr "그가 어떤 기분이었을지 상상이 가십니까? 소중한 스폰 하나가 공기중에 증발이라도 해버린듯 사라져버린 것입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 01fb5183-2438-89f6-4f16-c41ec59df77a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:01fb5183-2438-89f6-4f16-c41ec59df77a
msgctxt "hd5deb4f5ga875g42a8g9190g7e8a6235e6d0"
msgid ""
"*At first you can't fight the torrent of memories, but soon you find a "
"foothold. You can push them back - push them down until you feel nothing.*"
msgstr ""
"*처음에 당신은 기억의 급류에 속수무책으로 휩싸이다가, 곧 지지대를 찾습니다. 당신은 그 기억을 눌러 둘 수 있습니다 - 기억의 "
"밑바닥으로, 아무것도 느껴지지 않을 때까지.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 31303ae5-69a9-cb2d-159d-900756fc0a33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:31303ae5-69a9-cb2d-159d-900756fc0a33
msgctxt "hb74ba449g6b9cg461ag85acgb32580a5e468"
msgid ""
"*Eventually your meagre defences are washed away and you succumb to a long, "
"tormented night.*"
msgstr "*결국 얄팍한 방파제는 씻겨나가고, 당신은 길고, 고문같은 밤에 굴복합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 31480cad-8bb3-d9bf-5bf7-cc6c853d8837
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:31480cad-8bb3-d9bf-5bf7-cc6c853d8837
msgctxt "h302897fdg7b97g492cg9a01gff1fec1cd6cf"
msgid ""
"*You spend the rest of the night reliving your torment, none the wiser about "
"what your old master did to you.*"
msgstr "*당신은 남은 밤을 과거의 고통 속에서 보냅니다. 옛 주인이 당신에게 했던 짓에서 전혀 벗어나지 못한 채로.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 37938105-7327-fe9c-ded0-346d3422bc3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:37938105-7327-fe9c-ded0-346d3422bc3b
msgctxt "hfe6afc1ag4394g4fb7ga11cg57f8495c52cf"
msgid ""
"*Again and again, your thoughts return to memories of pain. Of suffering. Of "
"Cazador.*"
msgstr "*다시, 그리고 또 다시, 당신은 고통스러운 기억으로 돌아갑니다. 당신이 당했던 고초들로, 카사도어에게로.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 4767d5c1-723c-f818-5b75-8d200df24eec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:4767d5c1-723c-f818-5b75-8d200df24eec
msgctxt "h6c44d9c4g6472g4a0egb527g206b1b0d3fbf"
msgid ""
"*Your body is racked by agony, but you push through it, carefully tracking "
"the movement and position of every tear and slice.*"
msgstr "*육체는 고통에 시달리지만, 찢기고 잘렸던 위치와 움직임을 조심스럽게 좇으며 당신은 고통을 밀어냅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 6db981a8-fecd-d8f4-6a1c-2f71b6ce119d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:6db981a8-fecd-d8f4-6a1c-2f71b6ce119d
msgctxt "h5d581915g5b38g427dgbe74g83bed3fcfc61"
msgid ""
"*You gather yourself, building one mental wall after another against the "
"waves of pain that wash over you.*"
msgstr "*스스로를 가다듬고, 당신은 밀려오는 고통의 파도에 정신적인 벽을 겹겹이 쌓습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 6e24b322-2404-4944-8a28-7a22d333eeaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:6e24b322-2404-4944-8a28-7a22d333eeaa
msgctxt "hb2ac3438gc0e0g437fga15fgb59af28dfe82"
msgid ""
"*Eventually you drift to a quiet place and the terrors subside. You do not "
"rest well, but you do finally rest.*"
msgstr "*결국 당신은 고요한 곳까지 밀려오고 공포는 잦아듭니다. 충분하지는 못해도, 당신은 마침내 쉬게 됩니다.\""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 7ab767bc-5acb-ad9f-8db7-a0d367e7bdba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:7ab767bc-5acb-ad9f-8db7-a0d367e7bdba
msgctxt "h806c6c30g6f49g4520g9364g24e910c7b59b"
msgid ""
"*You rarely rest well, but tonight something feels different. Whether it's "
"the parasite within your brain or the darkness without, you're deeply "
"uneasy.*"
msgstr ""
"*당신은 푹 쉬는 날이 드물지만, 오늘 밤은 무언가 다릅니다. 뇌 속의 기생충 때문이든 그 밖의 어둠 때문이든, 깊은 불안이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 7c402cec-5743-5040-90ab-f6050c654d02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:7c402cec-5743-5040-90ab-f6050c654d02
msgctxt "h6e00937aged79g4bccg9676gb15973a31b52"
msgid ""
"*You try to focus, but the pain is too much. As one cut flows into the next "
"you lose all track of their shapes, leaving you with nothing but a haze of "
"pain.*"
msgstr ""
"*당신은 집중하려 하지만 고통을 견딜 수 없습니다. 하나의 상처에서 다음으로 넘어갈 때마다 당신은 상처들의 모양을 좇던 것을 놓치고, "
"고통의 안개 속에 빈손으로 남겨집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = 80aeb29c-f5cf-8aaa-c28e-4a7bc9c8e7e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:80aeb29c-f5cf-8aaa-c28e-4a7bc9c8e7e3
msgctxt "h19bb53a0g1e48g447dg8d03g445645143d45"
msgid ""
"*You spend the night drifting from one torture to another, but in time the "
"memories become less visceral.*"
msgstr "*고문에서 다른 고문으로 오가며 밤을 지새지만, 시간이 지나며 기억은 차츰 덜 잔혹해집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Astarion
#. NodeID = a6e55977-a2f0-0df9-29af-b0fbf2638bb5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Intelligence
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:a6e55977-a2f0-0df9-29af-b0fbf2638bb5
msgctxt "ha57c9529gdc9eg4e60gbe72g54cd65f34920"
msgid "<i>Push the pain away, try to banish the memory.</i>"
msgstr "<i>고통을 밀어내며, 기억을 떠올리지 않으려 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = aea1319d-e1fa-e2ec-d3da-341aaa8c2ae6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:aea1319d-e1fa-e2ec-d3da-341aaa8c2ae6
msgctxt "ha75a3115gf168g4b35gbe4fg15ad03b65cfa"
msgid ""
"*Despite the horror your body feels, you slowly start to build up a picture "
"of what your old master carved, recognising not words, but runes. Infernal "
"runes.*"
msgstr ""
"*몸이 느끼는 공포에도 불구하고, 당신은 옛 주인이 새겼던 것의 형상을 천천히 떠올리기 시작합니다. 단어가 아니라, 룬, 지옥의 "
"룬입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = b35e39d0-c71c-e751-c040-c49f69ba867d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:b35e39d0-c71c-e751-c040-c49f69ba867d
msgctxt "h6b378b9bgd76ag4d3fgbccdg9b2a7b3b6433"
msgid ""
"*You gather yourself, trying to build mental walls against the pain, but "
"they're assaulted by one tortured memory after another.*"
msgstr "*당신은 마음을 가다듬고, 정신적인 벽을 쌓아 고통을 막으려 하지만 연이은 고문의 기억이 당신을 괴롭힙니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = c5b73916-a397-7bbf-94d9-83957385e310
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:c5b73916-a397-7bbf-94d9-83957385e310
msgctxt "hab2794a7g46f3g49d3g93bcgbba1b3d1168c"
msgid ""
"*You spend the rest of the night reliving your torment, but if nothing else, "
"you know your scars are not what they seemed to be.*"
msgstr ""
"*당신은 남은 밤을 그 고문으로부터 벗어나는 데 쓰지만, 그렇다 하더라도 당신의 상처가 보이는 그대로의 의미가 아니라는 것만은 압니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Astarion
#. NodeID = c5fa0fd3-efa2-ed0e-a5cf-63b8d1db80cc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Intelligence
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:c5fa0fd3-efa2-ed0e-a5cf-63b8d1db80cc
msgctxt "hd95faec5g220dg4b9ega972gdd62b266a3a2"
msgid ""
"<i>Focus on the pain in your back - try to understand what he's carving.</i>"
msgstr "<i>그가 무엇을 새기려고 했는지 이해하려 애쓰며 등의 고통에 집중한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Player
#. NodeID = c9046565-1c1b-69a2-1c1b-d39f63d77e0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:c9046565-1c1b-69a2-1c1b-d39f63d77e0f
msgctxt "h8cb2e127gad3dg47f6g8e41gd2a9bcb005ba"
msgid "<i>Do not resist. Let your mind wander as it will.</i>"
msgstr "<i>저항하지 않고, 생각이 흐르는 대로 가게 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = dcea96a3-8888-81ca-9b47-b5970a5ef81c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:dcea96a3-8888-81ca-9b47-b5970a5ef81c
msgctxt "h1305f31cgd5fdg4eb5gbf4fgac983c15f166"
msgid ""
"*Unable to decipher the arcane symbols, you have to admit defeat and give "
"yourself over to the pain.*"
msgstr "*비전 문양들을 해독하지 못한 채로, 당신은 패배를 받아들이고 고통에 스스로를 넘겨줍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = e1ad2c85-2496-6c42-1c50-39bb9f6c3d74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:e1ad2c85-2496-6c42-1c50-39bb9f6c3d74
msgctxt "hc6cdc6c4g5a29g4b04gbbd7gb562b8ddf5f7"
msgid ""
"*Deep in your trance it all feels vividly real again - the jagged cuts of "
"the 'needle' he used on you, the shapes he traced into your flesh. You can "
"almost tell what he's writing.*"
msgstr ""
"*명상 속에서 모든 것은 다시 생생하게 느껴집니다 - 그가 사용했던 '바늘'이 만든 들쭉날쭉한 상처, 당신의 살갗에 흔적을 남긴 모양들. "
"그가 무엇을 쓰고 있는지 알 수 있을 정도입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = fcc025f3-f1d0-4293-3d6a-2cddd15af38a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:fcc025f3-f1d0-4293-3d6a-2cddd15af38a
msgctxt "h2ceddc36g8a14g4303g8628g0eca4a9eb197"
msgid ""
"*Freed from the ghost of your past, you can finally rest and dream of "
"brilliant futures.*"
msgstr "*과거의 유령에게서 벗어난 당신은 마침내 휴식을 취하고 찬란한 미래를 꿈꿉니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream
#. Speaker = Narrator
#. NodeID = fe3b927d-f0f0-e478-52ee-189a678cf5dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Astarion_SCO_CazadorNightmare_SecondDream:fe3b927d-f0f0-e478-52ee-189a678cf5dd
msgctxt "hf3324353gb83eg4708g9d1fgd1f16a9f57a6"
msgid ""
"*You remember his small cruelties. You remember his sadistic whims. And you "
"remember the long night he spent carving 'poetry' into your back.*"
msgstr ""
"*당신은 카사도어의 사소한 잔학 행위를 기억합니다. 그의 가학적인 변덕, 그리고 그가 당신의 등에 '시'를 새기던 긴 밤을 기억합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 0160563f-8a8f-e805-376c-87fc5f93bb56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:0160563f-8a8f-e805-376c-87fc5f93bb56
msgctxt "hb1a06744g20cag4499g87c8gad67405ab0fa"
msgid "<i>Kiss her more deeply. Your passion is hotter than her flames.</i>"
msgstr "<i>그녀에게 깊게 키스한다. 당신의 열정은 불길보다 뜨겁다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 01d79607-ece5-803f-aa5f-b32d760abb89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:01d79607-ece5-803f-aa5f-b32d760abb89
msgctxt "hc69006a9g82eag4c8cg8456g645d76e3009e"
msgid "We'll make it quick. One tiny kiss, nothing more."
msgstr "빨리 끝낼 수 있어. 짧은 키스 한 번, 그거면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 02b53b31-9719-e5a8-db84-f5e65ad39b83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:02b53b31-9719-e5a8-db84-f5e65ad39b83
msgctxt "h408fa7beg95ceg4374gbaf4gb0e045136f7e"
msgid "I'll turn you to charcoal. Guaranteed."
msgstr "널 숯덩이로 만들어버리고 말 거야. 진짜로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 05cfd3c2-ffcf-b9f3-a9e6-39a70d5f13b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:05cfd3c2-ffcf-b9f3-a9e6-39a70d5f13b6
msgctxt "h0ccb3b4ag9794g4ab5g8e0dgaad74f24f881"
msgid ""
"In <i>and </i>out, you say? I'd never considered that. But I think I know "
"what you mean. I'll give it a go."
msgstr "들이마신 <i>다음</i> 뱉으라고? 생각해 본 적 없는데. 근데 무슨 말인지 알 것 같아. 한번 해볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 05d7412e-a10a-a618-119e-11b0a896679c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:05d7412e-a10a-a618-119e-11b0a896679c
msgctxt "h42456dcdgd5f0g4987gb17dgea80e460e3e9"
msgid "We could... read a book."
msgstr "이제 우리... 책 좀 읽자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 091dfdbf-3b45-3437-a3c9-6188c437cef4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:091dfdbf-3b45-3437-a3c9-6188c437cef4
msgctxt "h35ef4fc5gaeebg4c4agb431gccd878bd698b"
msgid "Ugh, GODS, I want to ride you 'til you see stars."
msgstr "으, <b>젠장</b>, 별이 보일 때까지 네 위에 올라타고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 0bc4c010-9cd5-7160-95ee-239335d640d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:0bc4c010-9cd5-7160-95ee-239335d640d4
msgctxt "h5c233d83gaf58g4b8fgba2fg61e078407ef3"
msgid "A little singed, but it was worth it."
msgstr "조금 그을리긴 했지만 만족스러웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 0da5c45e-2f9d-757a-56e0-bb97da4712bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:0da5c45e-2f9d-757a-56e0-bb97da4712bf
msgctxt "h41ab8de9gd060g4b6bg974fg54e8906d1dd7"
msgid "Fire doesn't frighten me."
msgstr "불은 내게 아무런 문제도 되지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 0ff2e2f0-1869-c2de-b7cf-1dccd7ddc34e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:0ff2e2f0-1869-c2de-b7cf-1dccd7ddc34e
msgctxt "h5fb252bdgab2dg4e2dg8e21ge9c1965ff37e"
msgid "And <i>that's </i>a promise."
msgstr "꼭 <i>그렇게</i> 하기로 한 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 125b5d8d-82e2-b76a-2bda-afd08c78c8c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:125b5d8d-82e2-b76a-2bda-afd08c78c8c0
msgctxt "h2cec5088g06b3g440eg9d63g1d4f1f21707c"
msgid "And right now I want to ride you 'til you see stars."
msgstr "그리고 지금 당장 별이 보일 때까지 네 위에 올라타고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 12a58cfc-0b37-b3ee-ee11-1dd2f6893efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:12a58cfc-0b37-b3ee-ee11-1dd2f6893efb
msgctxt "h878d9a2ag22d7g4bbdg8b68ge177c3412233"
msgid "Karlach, I like you, but we hardly know each other."
msgstr "칼라크, 네가 좋지만, 우린 서로에 대해서 아직 잘 모르는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 12d73f17-f612-fdbb-9622-2aabde7cee36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:12d73f17-f612-fdbb-9622-2aabde7cee36
msgctxt "h84580b0cg5409g4fe0g84dcg071c8171ccf1"
msgid "You don't have to ask me twice. Let's go."
msgstr "두말할 필요 없어. 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 190d1bb6-609e-c755-fe6e-1ba457aadd7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:190d1bb6-609e-c755-fe6e-1ba457aadd7f
msgctxt "hbac852a3gc562g4dd2gb9c8g87a0afe6021b"
msgid "Guess not. I just feel what I feel. No sense hiding it."
msgstr "그런가 봐. 그냥 내가 느끼는 대로 따를 뿐이야. 숨길 필요 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 196015cc-5f14-e1de-1073-3e15195e6f87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_CanTrySolveBurningProblem = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:196015cc-5f14-e1de-1073-3e15195e6f87
msgctxt "he1d84caag49bdg4f99ga82cg8f907d2e5468"
msgid ""
"We can try. But don't hurt those pretty lips of yours, all right? They "
"feature heavily in my future plans."
msgstr "노력은 해볼 수 있어. 하지만 그 어여쁜 입술을 다치게 하진 마, 알았지? 나중에 써먹을 일이 많아질 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 1b4e16f2-a7de-f315-53b2-8e43a602f957
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:1b4e16f2-a7de-f315-53b2-8e43a602f957
msgctxt "h90957dabg737eg4755gb7d2ge36b3c9b3ffc"
msgid "I know. What I want and what I can have are two very different things."
msgstr "나도 알아. 무언가를 원한다고 해서 그걸 가질 수 있는 건 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 22fbfea8-c6c6-7828-2b1c-87e55e7713d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:22fbfea8-c6c6-7828-2b1c-87e55e7713d5
msgctxt "h62f9720fg7302g4b44g92ebg0fbefa99d620"
msgid "Maybe we should keep our distance, then."
msgstr "그럼 우리 서로 거리를 두는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 2374cb4d-a78c-def4-9317-97c05baaca86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:2374cb4d-a78c-def4-9317-97c05baaca86
msgctxt "h62875c94gc19eg499dg90aeg381792864985"
msgid ""
"All true, but there's more than that. Or have you forgotten the fine art of "
"conversation?"
msgstr "사실이야, 하지만 절차라는 게 있거든. 혹시 가장 기본적인 화술조차 잊어버린 건 아니지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 278cb421-08a7-ae04-c3f4-ebcdfd65c082
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:278cb421-08a7-ae04-c3f4-ebcdfd65c082
msgctxt "hb46e7488g5fefg455dgbaf3gd28a50454220"
msgid ""
"Please. My life is an instant mood-killer, and I'm enjoying this mood. Maybe "
"even a little too much."
msgstr "에이, 내 삶은 분위기에 찬물을 끼얹는 화젯거리야. 나는 이 분위기를 즐기고 있다구. 어쩌면 너무 많이 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 2e2732a2-4697-49ed-ac81-f9ab06a6da00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:2e2732a2-4697-49ed-ac81-f9ab06a6da00
msgctxt "h7f57ded1ga37fg48e2g92e2g6c22353fb9f2"
msgid ""
"Maybe I can't touch you, but I could <i>tell </i>you what I'd like to do "
"with you..."
msgstr "널 만질 순 없겠지만, 너에게 무슨 짓을 하고 싶은지 <i>들려줄</i> 수는 있겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 2ec00be0-74cd-609c-e073-66be67559a7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:2ec00be0-74cd-609c-e073-66be67559a7b
msgctxt "h63fbd4f9gb172g4518g827eg35dabd0f963f"
msgid "Let's talk. I still know so little about you."
msgstr "얘기나 하자. 아직도 너에 대해 잘 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 36f10f47-a1ff-0626-37d9-59f8cfc95814
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:36f10f47-a1ff-0626-37d9-59f8cfc95814
msgctxt "hdcefb022g5f6ag4553gac66g0b099588071c"
msgid "Around you? Tall order. But if you've got an idea, I'm all ears."
msgstr "네 수준으로? 어려운 주문일 텐데. 무슨 수가 있다면 일단 들어는 볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 36fcc8b7-bbc6-e1e9-4095-43d6ec5b4778
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:36fcc8b7-bbc6-e1e9-4095-43d6ec5b4778
msgctxt "hb4c8a1fdg697eg4332g8e03gfcbb226e3123"
msgid "Ugh, I'm terrible at this. What should we do now?"
msgstr "윽, 더럽게 어렵네. 이제 어쩌면 좋지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 37adb1ce-444e-4a75-9858-d6953e3d443c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:37adb1ce-444e-4a75-9858-d6953e3d443c
msgctxt "hc282ee20gcea9g49d6gb7e2g110e471b0eab"
msgid "Not particularly."
msgstr "딱히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 43dad6b7-cf3e-fd96-3470-20a85b493aff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:43dad6b7-cf3e-fd96-3470-20a85b493aff
msgctxt "hf960341dg0980g49abg943dg449d3b8aef5a"
msgid "My turn."
msgstr "내 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 4dcaebec-93a2-04c1-e4fd-2e35f9440428
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:4dcaebec-93a2-04c1-e4fd-2e35f9440428
msgctxt "h73b3906fgaac8g4d0bg926ag0c5cc5cae8ff"
msgid ""
"Ugh, I'm sorry - I shouldn't tease you - or myself. I'd give anything to "
"touch you, but I can't. Not until I can be sure I won't burn you."
msgstr ""
"윽, 미안해. 놀리면 안 되는데, 나도 참기 힘들고. 널 만질 수만 있다면 뭐든 내주겠지만, 그럴 수 없어. 널 불태우지 않을 거라는 "
"확신이 들 때까진 안 할래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 4f84346b-b0e8-26db-bb91-b9d2150f181c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:4f84346b-b0e8-26db-bb91-b9d2150f181c
msgctxt "hccda89c0ga1aeg4c11gafc6g4b1da19e1268"
msgid "Let's try breathing deeply, in and out."
msgstr "깊게 숨을 들이마시고, 내쉬어 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 5089d32e-a474-d2c8-06d3-c50a0b3921c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:5089d32e-a474-d2c8-06d3-c50a0b3921c7
msgctxt "h78f5ef5bg0d32g4b27ga6c9g79d44c8e3f2c"
msgid ""
"Evil would be grabbing you and kissing you with no regard for the "
"consequences."
msgstr "악마였다면 결과 따윈 생각하지 않고 널 냅다 붙잡아 키스를 갈겼겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 52e0ccb3-7543-1ad2-9cb4-0f27ca6ce754
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:52e0ccb3-7543-1ad2-9cb4-0f27ca6ce754
msgctxt "h4953ec21g830cg4d6dg82fag8f871d1ff5e2"
msgid ""
"Sorry if I was a little forward. Ten years in Avernus and I guess I've "
"forgotten whatever manners I might've had."
msgstr "미안, 내가 좀 눈치가 없었지. 아베르누스에서 10년을 보냈다 보니, 예절 같은 것도 죄다 까먹어버렸나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 574c826d-26e8-8a66-b076-513692240c7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:574c826d-26e8-8a66-b076-513692240c7f
msgctxt "ha12b5c8cgdc50g4f59ga5cag245389fcab4d"
msgid "I know some magic that might help me handle your fire. Let me see..."
msgstr "네 불길을 처리하는 데 도움이 될 마법을 좀 알고 있어. 어디 보자..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 5ba896a6-a261-84cf-ebd4-6edf49161742
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:5ba896a6-a261-84cf-ebd4-6edf49161742
msgctxt "hb601cc3fg06cdg48bdg8392gaf454a44efce"
msgid "I'm fine. Let's go again."
msgstr "난 괜찮아. 한 번 더 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 6277dc5c-6937-88a4-83d1-af54c3f8c512
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_BurningUpForYou_State_Happened = True
#.   Object:
#.     - CAMP_BurningUpForYou_State_HappenedWithPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:6277dc5c-6937-88a4-83d1-af54c3f8c512
msgctxt "hca71a993g3ed7g4df1gacafg1ca15bb43f3c"
msgid "Psst! Hey soldier - you aren't asleep, are you?"
msgstr "쉬잇! 안녕 신참, 너 아직 안 자고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 70be03a5-5ce2-1279-96b4-36e98e4c945e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:70be03a5-5ce2-1279-96b4-36e98e4c945e
msgctxt "h46d1f4f8g16ecg442egb0abg3ea03af41ed2"
msgid ""
"Thank the gods. I was afraid I was the only one. Ten years is a long time to "
"be trapped in the Hells. Ten years without a kind word, a touch."
msgstr ""
"천만다행이야. 나만 그렇게 느끼는 줄 알았거든. 지옥에 갇힌 채로 보내기엔 10년은 너무 긴 시간이야. 친절한 말 한마디도, 손길 하나도 "
"없는 10년 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 711e338d-0e00-ecc8-29e6-df8df3645583
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:711e338d-0e00-ecc8-29e6-df8df3645583
msgctxt "h8bfbf156gea57g4b5egad26g15209585eec5"
msgid ""
"Then let me backtrack and take you up on your first offer. Something about "
"seeing stars?"
msgstr "그럼 아까 얘기로 되돌아가서 첫 번째 제안을 생각해 볼게. 별이 보일 때까지 뭐라고 했더라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 73266ea8-4a98-bfdb-88b4-6adc039ca38c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:73266ea8-4a98-bfdb-88b4-6adc039ca38c
msgctxt "h9c0598dfg3b61g4c30g9e03g20368b7c3c36"
msgid ""
"Ah come on, don't give me that. We're here, we're alive, we're "
"<i>together.</i>"
msgstr "아, 왜 이래. 쩨쩨하게 굴지 말라고. 우린 여기 있고, 살아 있고, <i>함께잖아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 759028fa-0655-172a-308a-a1c6baf5c01e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:759028fa-0655-172a-308a-a1c6baf5c01e
msgctxt "h2b11b32bg5bf3g43a0gbf4bgc5a1ef127819"
msgid ""
"On that note, I'd better head back to my bunk. <i>You </i>might not be able "
"to touch me, but you've given me a lot to... <i>think </i>about."
msgstr ""
"그래서 말인데, 이제 그만 텐트로 돌아가야겠어. <i>넌</i> 비록 날 만질 순 없지만, 내게 많은... <i>고민거리</i>를 "
"주었거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 760683c8-1a1b-2a1f-6b6e-2e569e2d2d20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:760683c8-1a1b-2a1f-6b6e-2e569e2d2d20
msgctxt "he9d51dd4g9ae6g47e4g95f2gca539b8cfe7e"
msgid "I like the sound of that."
msgstr "그거 마음에 드는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 77bb1524-11f0-545a-fd4f-8a014f40a1f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:77bb1524-11f0-545a-fd4f-8a014f40a1f1
msgctxt "h299ac5begb54dg4941gb78ag13448664ee41"
msgid ""
"I'd better head back to my bunk. <i>You</i> might not be able to touch me, "
"but you've given me a lot to... <i>think</i> about."
msgstr "내 텐트로 돌아가는 게 좋겠어. <i>넌</i> 비록 날 만질 순 없지만, 내게 많은... <i>고민거리</i>를 주었거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 77ff2483-cfdd-cf2a-6148-9ab3dd2cad5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:77ff2483-cfdd-cf2a-6148-9ab3dd2cad5a
msgctxt "h147d912ag4326g4429g82ecg53e11f06982a"
msgid "Are you all right?!"
msgstr "괜찮아?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 7a92cdeb-3215-162b-9d54-297c00e86836
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:7a92cdeb-3215-162b-9d54-297c00e86836
msgctxt "hd23eef0dg1791g4e78ga9b7g86d9b5a5677a"
msgid ""
"Haven't read a book since I was a kid. Not a lot of exciting fiction in "
"Avernus. Tell you what, you find one you think I should read, and I'll check "
"it out."
msgstr ""
"어릴 때 이후로 책에는 손도 안 댔어. 아베르누스에는 흥미진진한 소설이 많지 않거든. 추천할 만한 책을 찾아 주면 한번 읽어보도록 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 7dca0334-56b0-b943-7654-3125c40f6326
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:7dca0334-56b0-b943-7654-3125c40f6326
msgctxt "h6f8227c1ge6c6g4e7ag8821g854a3460a76b"
msgid ""
"When I look at you, I feel real again. Alive. Gods, I want to ride you 'til "
"you see stars."
msgstr "널 보고 있으면, 현실로 돌아왔음을 느껴. 살아있음을. 젠장, 별이 보일 때까지 네 위에 올라타고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 7f4fa13c-9676-ba32-0a4f-8e6571127160
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:7f4fa13c-9676-ba32-0a4f-8e6571127160
msgctxt "h81a4879agfb87g4de1g830eg09c938f78f02"
msgid ""
"I held my own against the devils and imps, but they weren't my friends. How "
"could they be? You don't go to the Hells to <i>live</i>. You go to punish "
"and be punished."
msgstr ""
"데빌과 임프들에게 맞서 싸웠지만, 놈들은 내 친구가 아니었어. 어떻게 그럴 수 있겠어? 지옥은 <i>살기</i> 위해 가는 곳이 "
"아니잖아. 형벌을 받으러 가는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 83a98abe-dea2-d88b-ea83-af285deb7a5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:83a98abe-dea2-d88b-ea83-af285deb7a5e
msgctxt "h40a113d7g9b72g4167ga1e6g0f886eba6c95"
msgid "Hello, you. I've been waiting for this all night."
msgstr "반가워, 너랑 얘기하려고 밤새 기다렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 84ddcd85-20a9-927e-09f9-f2c1ce1a2b74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:84ddcd85-20a9-927e-09f9-f2c1ce1a2b74
msgctxt "hd0215f3bg628bg4a5bg80e2gaa4146dd1454"
msgid "We need to find a solution to the 'infernal engine' problem first."
msgstr "네 '지옥 엔진' 문제에 대한 해결책부터 찾아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 8b2e4d8c-e328-f882-a245-a708c692a12e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:8b2e4d8c-e328-f882-a245-a708c692a12e
msgctxt "h7d2e9cc1g70acg436fgb49aga58368fd00ba"
msgid "I admire your optimism, but <i>is </i>it that good?"
msgstr "긍정적인 관점은 존중하지만, 삶이 <i>정말</i> 그렇게 좋아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 8f5843ad-7b1c-3d5f-0f8c-4edf58eff98a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:8f5843ad-7b1c-3d5f-0f8c-4edf58eff98a
msgctxt "h9f6c446cg7df8g4385ga16ag9edcb1bc9ed9"
msgid "I'm buzzing, honestly. I couldn't wait to talk to you."
msgstr "솔직히 계속 떨렸어. 너랑 얘기하고 싶어서 엄청 기다렸거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = 960dd338-e40e-3f49-1085-6e9aed525067
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:960dd338-e40e-3f49-1085-6e9aed525067
msgctxt "habf46717g11bdg4074g8dd4g588348405f4d"
msgid ""
"Yes! Soldier, you're <i>saving </i>me. Every time you speak my name, fight "
"beside me, share what's yours, I'm reminded that I'm <i>alive</i>. Properly "
"alive. And <i>free.</i>"
msgstr ""
"그럼! 신참, 네가 날 <i>구해 주고</i> 있잖아. 네가 내 이름을 부르고, 함께 싸우고, 물자를 공유할 때마다 <i>살아 있다</"
"i>고 느껴. 제대로 말이야. 아주 <i>자유롭지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 9d575a87-50e3-fafc-6a98-ae55c82d7c2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:9d575a87-50e3-fafc-6a98-ae55c82d7c2b
msgctxt "h6ad09979g85c2g44d2ga5fdg8aa8b038b77e"
msgid "<i>It's too hot - pull away.</i>"
msgstr "<i>너무 뜨겁다. 물러난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = 9ed254f4-f634-11a4-72b2-522d7cb7298f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:9ed254f4-f634-11a4-72b2-522d7cb7298f
msgctxt "h9e167ffbg98a7g41d5gbd99g302ad870f442"
msgid "This is going a little fast - let's slow down."
msgstr "진도가 너무 빠른걸. 좀 천천히 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = a8350ecf-0888-a6a6-8cd0-eae3b20e07ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:a8350ecf-0888-a6a6-8cd0-eae3b20e07ea
msgctxt "hbbe9eb05gf4bcg43b9g85a2gb2a23e611345"
msgid "I'm free now. Incredible, isn't it? And I can have whatever I want."
msgstr "난 이제 자유야. 진심 놀랍지 않아? 내가 원하는 건 뭐든 가질 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = a9b2cb97-03d7-8ecd-60be-d3f8207b243c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:a9b2cb97-03d7-8ecd-60be-d3f8207b243c
msgctxt "h0fc2abf1g1b91g4e3cgba34g34bb753ac8c1"
msgid "You don't mince words, do you?"
msgstr "말을 가려서 하는 편이 아니구나, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = ab3a0827-f6f4-9191-32e7-9121371c64a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:ab3a0827-f6f4-9191-32e7-9121371c64a1
msgctxt "h87fecf10g1878g4d4egb585gb1b321863398"
msgid ""
"I'm just... ngh... <i>combustible</i>. Ten years is a long time without "
"anyone's touch but my own. And when I look at you, I just feel... explosive."
msgstr ""
"난 단지... 윽... <i>쉽게 달아오르는</i> 부류야. 10년은 나 외에는 누구의 손길도 느낄 수 없었던 긴 시간이었어. 그리고 널 "
"보면... 폭발할 것 같은 기분이 들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = b135baad-9cdc-2d17-42b2-4d2f7b15ccc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:b135baad-9cdc-2d17-42b2-4d2f7b15ccc5
msgctxt "h408b42afg3ee0g41d9gbb27ga75596e7a41d"
msgid ""
"I never made peace with my life in Avernus. Ten years, and I never accepted "
"that <i>that </i>was what my life would be."
msgstr ""
"아베르누스에서의 내 삶은 평화를 찾지 못했어. 10년이나 보냈지만, 내 삶이 앞으로도 <i>글러먹었다는</i> 사실을 받아들이지 못했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = b19d0b7a-074e-02b1-940b-988a95ae0e3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:b19d0b7a-074e-02b1-940b-988a95ae0e3a
msgctxt "haafb3cfdge89cg4369g8e62g07db56cc3cf8"
msgid ""
"Not true! I know you're a goblin-destroyer, an adventurer, and most "
"importantly, I know <i>you </i>like <i>me.</i>"
msgstr ""
"잘 알거든! 네가 고블린 파괴자인 것도, 모험가인 것도 알아. 제일 중요한 건 <i>네</i>가 <i>날</i> 좋아한다는 것도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = b2aa5219-fe2a-6eef-3ccf-278cf86e1b3c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_State_DatingKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:b2aa5219-fe2a-6eef-3ccf-278cf86e1b3c
msgctxt "h8dba7cddge14dg4fbdga113g9228a88aa451"
msgid "How about just one kiss?"
msgstr "그럼 키스 한 번은 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = b381c172-162e-dc61-2e11-bfd00f433c48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_CanTrySolveBurningProblem = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:b381c172-162e-dc61-2e11-bfd00f433c48
msgctxt "ha6790945gc5d2g435eg89bfg3a117c6080ee"
msgid ""
"We can try. But don't hurt those pretty lips of yours, all right? They "
"feature heavily in my future plans."
msgstr "노력은 해볼 수 있어. 하지만 그 어여쁜 입술을 다치게 하진 마, 알았지? 나중에 써먹을 일이 많아질 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = b5027c77-343c-98b9-093b-c5e53ec0fa69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:b5027c77-343c-98b9-093b-c5e53ec0fa69
msgctxt "hed996a82g71d5g47b6g9495g95a94dce01d0"
msgid "You can't make me be the responsible one. I'll destroy us both."
msgstr "나한테 책임을 떠넘기지 마. 우리 둘 다 파괴되고 말 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = bfd59101-5e94-e7aa-1458-9ad0453b76fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:bfd59101-5e94-e7aa-1458-9ad0453b76fe
msgctxt "h2b05780bg3dbag41a6gb25fg2360ef7d89f7"
msgid ""
"You have no idea. If I weren't so worried about killing you, I'd be in a "
"puddle on the floor."
msgstr "넌 상상도 못할 거야. 내가 널 죽일까 봐 걱정만 안 했어도 지금쯤 바닥에 녹아내렸을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = c01c928b-24c5-f8a2-7900-fd0b2aa5152a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_BurningUpForYou_State_UnlockedWith(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_BurningUpForYou_State_Happened = True
#.   Object:
#.     - CAMP_BurningUpForYou_State_HappenedWithPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:c01c928b-24c5-f8a2-7900-fd0b2aa5152a
msgctxt "h31c759d6g17ffg4f0cga38cg72a97615094c"
msgid "Heya soldier - I think everyone's asleep. May I?"
msgstr "안녕 신참, 다들 곤히 자고 있는 거 같네. 잠깐 앉을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = c0eec4c9-6c6f-a0f1-0310-af8e82327f30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:c0eec4c9-6c6f-a0f1-0310-af8e82327f30
msgctxt "hbb98e4dfg5d7cg48edg8738ge2999e08843b"
msgid "The best worst decision. So what do we do now?"
msgstr "최고로 나쁜 선택이네. 이제 어쩌면 좋지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = c7aa7f1c-4e0a-a51f-a3b6-d6db35b18d03
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_CanTrySolveBurningProblem = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:c7aa7f1c-4e0a-a51f-a3b6-d6db35b18d03
msgctxt "h248b7bc5g9e13g4622gbffbg1b361166bb6e"
msgid "Don't tempt me. It isn't fair."
msgstr "유혹하지 마. 불공평하다구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = cde3773c-9b43-587a-c520-f51c6156e049
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:cde3773c-9b43-587a-c520-f51c6156e049
msgctxt "he4bf1137g183dg4717g9e50g4453967b2ed3"
msgid "You do seem to have the relevant parts of me in hand."
msgstr "나에 대해 꽤 잘 알고 있구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = cef7c8ce-ca98-269f-9594-d434990568b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:cef7c8ce-ca98-269f-9594-d434990568b5
msgctxt "h1151bbb0g0b02g481cgadd1g1b8e2e2bcdc4"
msgid ""
"I told you, I'm an 'at your own risk' attraction. Make better decisions."
msgstr "말했잖아, 난 '귀하의 책임 하에' 즐길 수 있는 놀이 기구라니까. 짱구 좀 굴리라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = d09ef7c5-db4e-ca10-06c2-7c3dfff6d53e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:d09ef7c5-db4e-ca10-06c2-7c3dfff6d53e
msgctxt "habb10a3dg2cd5g4f09gaf92g20ceecb8f55f"
msgid "I know what you mean. When I look at you, it's all I can think about."
msgstr "무슨 말인지 알겠군. 널 보고 있자면, 그런 생각밖에 떠오르지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = d0a62205-cd5d-aade-4e79-3fd8ad5d0b9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:d0a62205-cd5d-aade-4e79-3fd8ad5d0b9a
msgctxt "h7609560agf5ebg4b43g84feg4fdd75747e4f"
msgid "Oh, now you're just teasing me. Evil."
msgstr "오, 이제 날 놀려 먹고 있잖아. 악마 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = d277355d-1478-b4b4-3b10-76b66288c17e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:d277355d-1478-b4b4-3b10-76b66288c17e
msgctxt "h28bc56cdg40b0g447cg9121g07c123dde9cf"
msgid "Sorry, but I'm not interested in you in that way."
msgstr "미안, 난 네게 그런 쪽으로는 관심이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = d85433a3-ee9a-82ee-0670-e8d6392c1525
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:d85433a3-ee9a-82ee-0670-e8d6392c1525
msgctxt "hf5986748gbc01g44bag8e76g3a6795b55655"
msgid "Ngh - wait! NO!"
msgstr "우움, 잠깐! 안 돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = d8d60405-87ba-945b-ee16-790fbc5767c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:d8d60405-87ba-945b-ee16-790fbc5767c7
msgctxt "h07affb6cg08bfg47a5g8c0fg3c706614ee4f"
msgid "My turn."
msgstr "내 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = d91de997-510d-5eff-4476-2c2a91dcf160
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:d91de997-510d-5eff-4476-2c2a91dcf160
msgctxt "h0b826683g7de0g4781ga8dbg4b465ba5621b"
msgid ""
"We need to find a solution to the 'infernal engine' problem before we get "
"any closer."
msgstr "'지옥 엔진' 문제의 해결책을 찾아야만 우리가 더 가까워질 수 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = dabfcecf-1503-4596-1e92-9befd8aa4b24
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_CanTrySolveBurningProblem = True
#.   Object:
#.     - ORI_State_DatingKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:dabfcecf-1503-4596-1e92-9befd8aa4b24
msgctxt "h17838572g6cabg4b7egbbb9gc55ab031dd7d"
msgid ""
"Sleep on it, maybe. If you've thought of something by morning, I'd love to "
"know. For now, it's enough just to know you care enough to try."
msgstr ""
"그냥 자는 게 좋겠어. 아침에 뭔가 생각 나면 알려줘. 지금은 이런 걸 시도해 볼 만큼 내게 관심이 있다는 걸 알았다는 것만으로 "
"충분하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = dcdef7a2-51f1-99e1-029d-ab79b843804b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:dcdef7a2-51f1-99e1-029d-ab79b843804b
msgctxt "h5d6c563cg2530g4049gbd74g2869d1648cce"
msgid "I like the sound of that."
msgstr "그거 마음에 드는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = de8310ed-fd45-de19-1f54-85a07eafd54b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:de8310ed-fd45-de19-1f54-85a07eafd54b
msgctxt "h444ceba8gfbe0g4f60g929dg067d86c4c278"
msgid "Isn't it mad? How <i>good </i>life is?"
msgstr "믿기 힘들지 않아? 삶이란 게 얼마나 <i>근사한지</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = ea1a05ce-e75a-f499-628e-dd27b57058e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_CanTrySolveBurningProblem = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:ea1a05ce-e75a-f499-628e-dd27b57058e9
msgctxt "hdd9dbd1egf243g4b6fgbb0cg907e573699ae"
msgid ""
"The flames get worse when you're excited, right? What if we cool you down?"
msgstr "흥분하면 불길이 더 고약해진다는 거지? 그럼 널 좀 식히면 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = ee1f62f2-fd50-d202-1b6f-896fbd248256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:ee1f62f2-fd50-d202-1b6f-896fbd248256
msgctxt "h178bf9f9gbd5bg43dfga523g3443102b3cf6"
msgid "So what do we do now?"
msgstr "이제 어쩌면 좋지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = ee6e1eb7-f295-8c04-2253-c2b4f5ef1cee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:ee6e1eb7-f295-8c04-2253-c2b4f5ef1cee
msgctxt "h253a6ccagb670g412bga950g34efc202cb07"
msgid "Ngh - wait! NO!"
msgstr "우움, 잠깐! 안 돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = f173a1ee-0593-70c7-b734-9cd2766c6241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:f173a1ee-0593-70c7-b734-9cd2766c6241
msgctxt "h51499e12g0f76g48c7g9b4dgab6b254c0d79"
msgid "Shit, are you all right?"
msgstr "씹, 너 괜찮아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = f84f4ded-8d69-4e44-dfce-d8466a31b1b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:f84f4ded-8d69-4e44-dfce-d8466a31b1b5
msgctxt "ha552ef05gc027g429aga9c9gf320df49a2b0"
msgid "Honey, when I look at you, my brain turns to mush."
msgstr "내 사랑, 널 보고 있으면, 머리가 하얘져버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Player
#. NodeID = ff1f00a7-e112-1d51-35f2-e74318901713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:ff1f00a7-e112-1d51-35f2-e74318901713
msgctxt "ha6611e3fg9983g4b60g8091g5c59a85eecd9"
msgid "No! You nearly burnt my face off!"
msgstr "아니! 너 때문에 내 얼굴이 불탈 뻔했잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM
#. Speaker = Karlach
#. NodeID = ff7b7414-7824-db6c-2dd2-8239cff42469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_BurningUpForYou_CFM_ROM:ff7b7414-7824-db6c-2dd2-8239cff42469
msgctxt "h9aad6661g7efag4820g84d4gb2988f8585ad"
msgid "Don't hold it against me. Unless you want to."
msgstr "너무 화내진 말아 줘. 너만 괜찮다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 00d43c53-a332-9fb1-4561-2ece3ca011b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:00d43c53-a332-9fb1-4561-2ece3ca011b2
msgctxt "h237d4309g6520g4892g8a41g7f555f399bb3"
msgid ""
"<i>What I didn't anticipate was how much I would <b>enjoy</b> your company. "
"Your mind. </i>"
msgstr "<i>내가 예상하지 못했던 건 내가 얼마나 너와의 동행을 <b>즐기게</b> 되었는지였다. 네 정신을.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 01a5ab51-c877-5096-55f5-ee35a72db014
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:01a5ab51-c877-5096-55f5-ee35a72db014
msgctxt "h1c5455efgd79ag48e5ga939ga21a8503d98d"
msgid ""
"<i>Is it? We have experienced much together. Consider this an opportunity "
"for further mutual exploration. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 02368c9b-bfa5-324e-7a98-2224bfd8faa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:02368c9b-bfa5-324e-7a98-2224bfd8faa9
msgctxt "hd0ee463eg3e2dg4646g806cg96f72f9105c8"
msgid ""
"<i>It was intelligent before. But now, with its hivemind established across "
"the city, it is well on its way to becoming indestructible. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 032aa762-b004-50da-7e41-bc44c75d6a34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:032aa762-b004-50da-7e41-bc44c75d6a34
msgctxt "h1dfbadc6ga300g4abdg803eg631bd13ab769"
msgid "<i>Hhhhnnnnhhh. </i>"
msgstr "<i>흐으으으으으.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 03cc23d0-eb05-2aeb-56e7-7f36bad30335
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:03cc23d0-eb05-2aeb-56e7-7f36bad30335
msgctxt "h491cf4dfg3ca5g4042g94deg5a842feee669"
msgid "<i>I'll remember that.</i>"
msgstr "<i>그 말, 기억해두지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 045e04d7-9cb9-9ee0-e61b-769c957ddc3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:045e04d7-9cb9-9ee0-e61b-769c957ddc3d
msgctxt "h7fd37a23g4fedg4eb7g8815g4f624a607de3"
msgid "<i>I anticipated the challenge, and I anticipated your resistance. </i>"
msgstr "<i>난 어려움을 예상했다. 네가 반발하리라 예상했지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 062e0a48-322b-7a39-aede-f3863074545b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:062e0a48-322b-7a39-aede-f3863074545b
msgctxt "hdbd80c3bg4778g40cdg9ca1ge4b38a9368af"
msgid ""
"<i>We must stop it while we still can. Before we, too, become its slaves. "
"</i>"
msgstr "<i>아직 가능할 때 막아야만 한다. 우리마저 엘더 브레인의 노예로 전락하기 전에.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 06c598bb-7a35-3a90-51b9-93a4496998af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:06c598bb-7a35-3a90-51b9-93a4496998af
#, fuzzy
msgctxt "hffeb07cdg3451g42e6gaf03g45413d9defba"
msgid ""
"<i>You wouldn't even have come this far without me so, as I see it, you "
"don't have a choice. </i>"
msgstr "<i>넌 내가 아니었으면 여기까지 오지도 못했을 것이다. 그리고 내가 보기엔, 넌 선택지가 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 0c220f97-40a5-504e-e135-531b9dbd2e12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:0c220f97-40a5-504e-e135-531b9dbd2e12
msgctxt "hdbfc393fg2b46g46e5g8c64gf89799fc8b4d"
msgid ""
"<i>Did you like it - the truth? This was the alternative relationship we "
"could have had. Aren't you glad I finessed my methods?</i>"
msgstr ""
"<i>진실이 마음에 드는가? 어쩌면 우리가 이런 관계가 될 수도 있었다. 내가 나의 술책을 우아하게 다듬어서 기쁘지 않나?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 0cf6fd82-d56c-4f55-3da4-e59f235585d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:0cf6fd82-d56c-4f55-3da4-e59f235585d8
msgctxt "h820c864cgd0aeg484fg901cgc44e77197f0c"
msgid "<i>You even tried to kill me.</i>"
msgstr "<i>심지어 날 죽이려고까지 했지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 0e62ecf1-0bb4-864b-6911-57f9fa549402
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:0e62ecf1-0bb4-864b-6911-57f9fa549402
msgctxt "h06291374g9c7cg43f4gb869ged04d674bc50"
msgid ""
"<i>And you would do well to reconsider unlocking your potential. Your "
"puerile attachment to your material form jeopardises us all. If I must, I "
"will force you.</i>"
msgstr ""
"<i>그리고 잠재력을 해방하는 것 말인데, 재고하는 게 좋을 거다. 육신의 형태에 대한 네 유치한 집착이 우리 모두를 패망으로 몰아가고 "
"있단 말이다. 불가피한 상황이 된다면 강제할 테다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 0efe8355-06b7-dd94-4eac-6d74863c63e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4ea3a949-d1a4-91b1-278c-56f970d80ac2_HeldTentacle = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:0efe8355-06b7-dd94-4eac-6d74863c63e4
msgctxt "h93572db5gefb2g4cb7gabb1g1bf0211895ce"
msgid "<i>Take its tentacle in your hand, invite it in. </i>"
msgstr "<i>촉수를 쥐고 끌어당긴다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 117c7466-993b-9303-e022-738e8f6567ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:117c7466-993b-9303-e022-738e8f6567ba
msgctxt "h796a1824gb0b9g42dfga76cg011a9d7b3896"
msgid "<i>Some wisdom at last.</i>"
msgstr "<i>마침내 일말의 지혜를 보이는군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 133d3c36-fe46-0c3b-dc88-a58eb71b8ff6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - LOW_Elfsong_EmperorAD_Knows_RascallCollar(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:133d3c36-fe46-0c3b-dc88-a58eb71b8ff6
#, fuzzy
msgctxt "h99a53419g5584g48c6g8000g67b2ece72f8f"
msgid "<i>My beloved confidant and loyal companion, Rascal.</i>"
msgstr "<i>나의 소중한 친우이자 충성스러운 동료, 라스칼.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 1537451b-6b4d-91be-1f31-cec7945809db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:1537451b-6b4d-91be-1f31-cec7945809db
msgctxt "h5f157163g56bfg4088gade8g48fb11ab405b"
msgid "<i>You were stubborn, antagonistic. You didn't want to listen. </i>"
msgstr "<i>너는 고집을 피우면서 나를 적으로 여겼다. 말을 들으려 하질 않았지. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 17a9c537-cd95-eb66-c0cf-4e362275a993
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:17a9c537-cd95-eb66-c0cf-4e362275a993
msgctxt "hdd77920cg97a1g4174gac3bg7d2b2f79b5f9"
msgid "You sure I can't tempt you into another round?"
msgstr "한 판 더 하고 싶지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 1a25b873-11e1-571c-faf5-751c2499055b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:1a25b873-11e1-571c-faf5-751c2499055b
msgctxt "h77ec1a04g61beg4fb8g9cbdgd13112283c7a"
msgid "Could you maybe not make that noise?"
msgstr "그 소리 안 내면 안 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 1d35927d-0f88-fed6-c373-01b3dd015636
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PARTIAL_CEREMORPH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:1d35927d-0f88-fed6-c373-01b3dd015636
msgctxt "he4557394g6240g4814gb14fge1d8a89e69ed"
msgid "<i>What I didn't anticipate was how reasonable you would be.</i>"
msgstr "<i>내가 예상하지 못했던 건 네가 얼마나 합리적일 수 있는지였다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 1e2b3ccc-0672-e6bd-d512-245612bf3fe1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_8 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:1e2b3ccc-0672-e6bd-d512-245612bf3fe1
msgctxt "hb408056bgf3c5g4ec5g83c6g3ad067ca833d"
msgid ""
"*It seems the tadpole allowed you to share more than you would have liked "
"with your companions.*"
msgstr "*올챙이 덕에 당신이 원했던 것 이상을 동료들에게 공유할 수 있었던 모양입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 2391494f-a2ff-82e5-fcb3-bdada2f086cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_Elfsong_State_GithDefeated = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2391494f-a2ff-82e5-fcb3-bdada2f086cd
#, fuzzy
msgctxt "h5b29eef2g582ag4555g8990g408401199b0d"
msgid "<i>You did well to see off the githyanki who had invaded mine.</i>"
msgstr "<i>내 집에 침입한 기스양키들을 잘 처리해줬다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 24d588c2-bb9d-3595-84d9-9e1b884cc8a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:24d588c2-bb9d-3595-84d9-9e1b884cc8a5
msgctxt "h9b3b3097g045cg4c79g9992g2fb96ad76d3b"
msgid ""
"<i>You will take me to the brain because you have no other choice. And once "
"we are there, you will do exactly what I tell you to.</i>"
msgstr ""
"<i>넌 다른 방도가 없기에 날 엘더 브레인에게로 인도할 것이다. 그리고 그곳에 도달하면, 넌 정확히 내가 시키는 대로 행할 "
"것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 2538754c-6737-7d50-d5e3-fe96a338167f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2538754c-6737-7d50-d5e3-fe96a338167f
msgctxt "h7b88368eg57c4g4c9fg8b88gd51b3f5c9b37"
msgid "<i>Antagonistic to the very end. </i>"
msgstr "<i>끝까지 적대적이군. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 26e5ac77-8021-6a9f-4111-faaa97dd2785
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:26e5ac77-8021-6a9f-4111-faaa97dd2785
msgctxt "hcf0c11d2g5a73g4158g9961gd4458568ac29"
msgid "<i>I will take that as a yes.</i>"
msgstr "<i>읽게 해달란 뜻으로 알겠다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 29834494-6916-8f05-563c-377ac5910ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:29834494-6916-8f05-563c-377ac5910ff4
#, fuzzy
msgctxt "h77754a20ge676g4aa9gbbd6gcd6c6a4c144f"
msgid ""
"<i>Yours has been no less exciting. But even with all your experience, it "
"has not been easy. </i>"
msgstr "<i>너의 삶도 내 것만큼 흥미로웠다. 하지만 그 모든 경험을 가지고도, 쉽지는 않았지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 2c0d5db0-50e7-83e3-a54a-33ec02bd41b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2c0d5db0-50e7-83e3-a54a-33ec02bd41b3
msgctxt "hab5a8b3eg71b4g4efdgaf64gcc3ce257ec99"
msgid ""
"<i>But you made your choices - such is the burden of freedom. And now we "
"must move on.</i>"
msgstr "<i>하지만 선택을 내린 사람은 너였다. 그것이 자유에 따르는 책임이지. 그럼, 앞으로 나아갈 시간이다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 2c5a1d23-f3c0-a3cb-9f36-b33dd52fb849
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - LOW_Elfsong_EmperorAD_Knows_SoupRecipe(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2c5a1d23-f3c0-a3cb-9f36-b33dd52fb849
#, fuzzy
msgctxt "hc615e9fdg8586g4d54gb78eg27e581ce48bb"
msgid ""
"<i>The flavours of my favourite fiddlehead soup, should you wish to "
"experience it for yourself. </i>"
msgstr "<i>내가 제일 좋아하는 고비 수프의 맛, 너도 직접 맛보길 원하면 좋을 텐데.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 2cb36fe4-549a-64c3-2edb-f9bce998de32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tadpole_Event_AstralTouchedTadpoleEaten = False
#.      - GLO_Tadpole_Event_AstralTouchedTadpoleDestroyed = False
#.      - CAMP_DaisyAcknowledgement_SexWithEmperor = True
#.      - GLO_General_State_SomeoneIsPartialCeremorph = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2cb36fe4-549a-64c3-2edb-f9bce998de32
msgctxt "hf8042fe4ga08fg4602g8009g23533a1ff158"
msgid ""
"<i>You should reconsider your attachment to your physical form. You have "
"seen what an illithid can do. You have experienced the pleasure for "
"yourself.</i>"
msgstr "<i>육신에 대한 집착은 재고해 보아라. 일리시드가 무엇을 할 수 있는지 보았지 않나. 그 쾌락도 직접 경험했지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 2cc1a57f-e5ad-8498-17bd-3154b76cb807
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2cc1a57f-e5ad-8498-17bd-3154b76cb807
msgctxt "h1ed45000gfc01g423fg88f1gb96e60c56a84"
msgid "<i>I needed your absolute dedication to the cause.</i>"
msgstr "<i>내겐 대의를 향한 네 전적인 헌신이 필요했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 2d584beb-f165-c78e-2084-26a0f367bf79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - LOW_Elfsong_EmperorAD_Knows_Wardrobe(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2d584beb-f165-c78e-2084-26a0f367bf79
#, fuzzy
msgctxt "h63403927g75e4g4dbfgbc23g4746db639371"
msgid ""
"<i>The garments with which I concealed and later constructed my appearance "
"as the Emperor.</i>"
msgstr "<i>내가 숨겼고 후에 황제로서의 외관을 만들어준 의복들.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 2eb553f3-ed1b-664b-cbea-61a63a0cd24e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_DaisyAcknowledgement_State_RejectedEmperorsAdvances(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2eb553f3-ed1b-664b-cbea-61a63a0cd24e
msgctxt "hb34bca4eg1a79g4595g8584g05ced28c6ff6"
msgid "Actually, I'm having second thoughts."
msgstr "사실, 마음이 바뀌었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 2ed6f472-27b9-611e-af65-1850569e5ca3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_DaisyAcknowledgement_State_RejectedEmperorsAdvances(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:2ed6f472-27b9-611e-af65-1850569e5ca3
msgctxt "h724e83c3gcce9g484agb9ebgc072cd304d18"
msgid "I'd rather we stick to business."
msgstr "일 얘기만 하는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 30637903-d6c4-781c-e59e-78d5347c141a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:30637903-d6c4-781c-e59e-78d5347c141a
msgctxt "hf26eb942g232bg42f8gb7d8g18f01b495296"
msgid "Was that... a good sound?"
msgstr "그거... 좋은 소리야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 34c33bbd-804c-2abb-a39f-0726d5237e89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:34c33bbd-804c-2abb-a39f-0726d5237e89
msgctxt "h6df49a44g5e08g436ag9213g8e93805bef30"
msgid "I'm not stopping you."
msgstr "막지 않을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 35cc41f3-c60e-6f90-2d79-70e6257b1010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:35cc41f3-c60e-6f90-2d79-70e6257b1010
msgctxt "hca51f5e4gc545g42a7ga519g1226b1919397"
msgid ""
"<i>Imagine - some of that could be in your grasp. Not enough to warp your "
"appearance beyond recognition, but just enough to enhance your potential. "
"</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 373930fe-dd87-6860-f322-008eabe52b7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:373930fe-dd87-6860-f322-008eabe52b7a
msgctxt "hd4158854g2e3bg44acg9780g13bc6a9a2995"
msgid ""
"*And in this dream world, the fires that burn inside you wouldn't  hurt a "
"fly, much less a mind flayer.*"
msgstr "*그리고 이 꿈의 세계에서 당신 안에서 타오르는 불길은 마인드 플레이어는 고사하고 파리 한 마리도 해치지 못할 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 3c9ce3f9-a594-10bd-46ff-03b8e1c9746c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:3c9ce3f9-a594-10bd-46ff-03b8e1c9746c
msgctxt "hf744045eg16c7g4cb9g9f9egd3ac42d1a76f"
msgid "This feels quite... unexpected."
msgstr "이건... 예상치 못했는데. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 3f713024-9f28-dbc2-ff91-038f93990b29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_DaisyAcknowledgement_State_ThreatenedEmperor(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:3f713024-9f28-dbc2-ff91-038f93990b29
msgctxt "h557c4846ge072g4678gbd52g561a33331ab0"
msgid "First chance I get I will rip your head off, mind flayer."
msgstr "기회만 오면 네 모가지를 뜯어낼 테다, 마인드 플레이어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 41462154-7982-b635-d64f-b5d01e8a543d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:41462154-7982-b635-d64f-b5d01e8a543d
msgctxt "hb77c070fgd525g4f88g8685g0d83ba5885c8"
msgid "You led an exciting life. Why did you conceal it from me?"
msgstr "흥미로운 삶을 살아왔던데. 왜 나한테 숨겼던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 41489ede-b24c-a772-ee5c-fcfc1fdba8db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:41489ede-b24c-a772-ee5c-fcfc1fdba8db
msgctxt "h50d7501ag44f4g4a9dg87d1g2a3b1b3e062f"
msgid "You're right. For now, we have to be allies."
msgstr "그 말이 옳군. 지금 당장은 우리가 협력해야만 하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 41e40d72-a0e0-105c-d384-7ba2ae610f9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:41e40d72-a0e0-105c-d384-7ba2ae610f9e
msgctxt "hd1544504g41c8g41cdg8d7dg8cdcb3f8d370"
msgid "Would you mind parting those tentacles?"
msgstr "그 촉수 좀 벌려줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 426158f9-781e-9a43-78ad-0aeb5d46a727
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:426158f9-781e-9a43-78ad-0aeb5d46a727
msgctxt "h65943230gcf55g48ecgb808gaf7069f82481"
msgid ""
"*If this creature is at all similar to an octopus, as it appears to be, its "
"mouth is probably somewhere underneath the tentacles.*"
msgstr "*이 생명체가 생긴 것처럼 문어와 유사하다면 입은 아마도 촉수 아래 어딘가에 있을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 43f902db-1a32-8e1e-db74-2c2bdf068b0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:43f902db-1a32-8e1e-db74-2c2bdf068b0e
msgctxt "h66e6ed74gec0cg4e48gb12fg6121ddd143e6"
msgid ""
"<i>That you are complex. And full of contradictions. It was no easy task, "
"but I had to persist. </i>"
msgstr "<i>네가 모순으로 가득찬 다면적인 사람이라는 사실을 알게 되었지. 쉬운 과업은 아니었다만 난 노력을 계속해야만 했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 44b1995d-3ed2-2b29-3a3a-5bc235f9cb85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:44b1995d-3ed2-2b29-3a3a-5bc235f9cb85
msgctxt "hb9b965e3gf30cg4e51g84f9g9f4917637eb2"
msgid "I saw right through you."
msgstr "널 통해서였지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 45bb088b-d139-dfa2-c6f8-a8a6350be5c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:45bb088b-d139-dfa2-c6f8-a8a6350be5c1
msgctxt "he633beb6g8751g41aaga0c1g04a5ae1e4639"
msgid "<i>We are done here.</i>"
msgstr "<i>대화는 여기까지다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 464f7f98-7bb1-df10-e11d-fbf9cd28f708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:464f7f98-7bb1-df10-e11d-fbf9cd28f708
msgctxt "hff6663c7gf075g409cgb27eg6f4d1036efdb"
msgid "No need. You're right. We need to trust each other."
msgstr "그럴 필요 없어. 네 말이 맞아. 우린 서로를 믿어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 478492c0-6b3d-ad61-c6c8-ac91e66937d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:478492c0-6b3d-ad61-c6c8-ac91e66937d2
msgctxt "h0a1db86bg451fg42b1gafd2g641388c95894"
msgid "I enjoyed our conversations."
msgstr "우리가 나눴던 대화들, 즐거웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 499810b9-bd2c-9e06-afd9-395493dd20d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DaisyStelmane_Knows_StoryOfStelmane = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:499810b9-bd2c-9e06-afd9-395493dd20d8
#, fuzzy
msgctxt "h81377246ged1dg4d1ag9cfeg82c5b7a30242"
msgid ""
"<i>We spoke of my relationship with Duke Belynne Stelmane - a story I have "
"told no one else.</i>"
msgstr "<i>우린 공작 벨린 스텔메인과 나의 관계를 얘기했었지. 다른 누구에게도 한 적 없는 얘기다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 49ae3d7d-fb31-2545-894a-c86f2c56ae08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:49ae3d7d-fb31-2545-894a-c86f2c56ae08
msgctxt "hb2b2e53fg5483g4285g8aaeg2c560e9e6c37"
msgid ""
"*Its breathing quickens as you pull in close to its face. Its excitement "
"palpable.*"
msgstr "*당신이 얼굴이 맞닿을 정도로 마인드 플레이어를 가까이 끌어당기자, 그것의 숨이 거칠어집니다. 흥분의 징후가 명백합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 4a52054b-4a43-83b7-e937-5c9ab079e489
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:4a52054b-4a43-83b7-e937-5c9ab079e489
msgctxt "hb162731agebe9g45bbg8c1ag3daf43a30624"
msgid "I could have done with a little more coddling."
msgstr "어린애처럼 굴면서 할 수도 있었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 4c46caef-d9ce-4e98-a337-19aecf32dffa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:4c46caef-d9ce-4e98-a337-19aecf32dffa
msgctxt "h6fbbd7d9gb111g4adagb2a0g2dd3b1604fb0"
msgid ""
"*You feel its breath merging into yours, cold, smelling faintly of vanilla "
"and garlic.*"
msgstr "*마인드 플레이어의 호흡이 당신의 것과 엉킵니다. 그 차가운 숨결에선 희미하게 바닐라와 마늘 향이 느껴집니다. *"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 4ed46982-b155-bc9c-62f3-e3116391d6f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:4ed46982-b155-bc9c-62f3-e3116391d6f6
msgctxt "hf38758a5g8176g414bgadc5ga84cd0ccb467"
msgid "You tried to control me."
msgstr "날 조종하려고 했다는 거군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 4f2a71d9-2da4-b7bc-6973-3d930a7b33b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:4f2a71d9-2da4-b7bc-6973-3d930a7b33b2
msgctxt "h5563afe8g8de0g4b29gb3a2ge2443576df7b"
msgid "<i>Good instinct. </i>"
msgstr "<i>좋은 판단이다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 50057a18-dfac-3a40-eba8-e29dcaf851ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_DaisyAcknowledgement_State_RejectedEmperorsAdvances(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:50057a18-dfac-3a40-eba8-e29dcaf851ae
msgctxt "h6f4fad7dg0e8bg4498gb2d7gd2909503a916"
msgid "<i>Think on it. </i>"
msgstr "<i>생각해 보아라. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 522f540f-d6ee-ff4c-cc11-4e04be9586e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:522f540f-d6ee-ff4c-cc11-4e04be9586e1
msgctxt "h23c46f63ga204g4ec0g8e98ge3588509881d"
msgid "<i>Let's move on to more important things. </i>"
msgstr "<i>더 중요한 얘기를 하도록 하지. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 52bf9301-f1b8-9d5c-08e3-2f2629933162
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:52bf9301-f1b8-9d5c-08e3-2f2629933162
msgctxt "h2c7c5cffg8e94g4773ga4e7g5f3764e57dbb"
msgid ""
"*You can't tell if the mind flayer is smiling or not. A symptom of your "
"wider problem.* "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 549ac7db-7da0-76e3-47c9-86ee2d4cd273
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:549ac7db-7da0-76e3-47c9-86ee2d4cd273
msgctxt "h64c1c42agd01eg4868gaa7fgde0c811cf779"
msgid "<i>HHHNNNNNNHHHHHH.</i>"
msgstr "<i><b>흐으으으으으으으으으으.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 54e3b5f7-03a3-6ef3-4612-7a61b836aa02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:54e3b5f7-03a3-6ef3-4612-7a61b836aa02
msgctxt "hafad701fge912g42bfg913fgd98bc0dfe49e"
msgid ""
"<i>I'm sorry - you're right - now's not the time. Forget I said anything. "
"</i>"
msgstr "<i>미안하군, 네가 옳아, 이럴 때가 아니다. 내가 말한 것들은 잊어라. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 55472de1-c41d-cb27-3629-f335af867fe9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - LOW_Elfsong_EmperorAD_Knows_Sword(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:55472de1-c41d-cb27-3629-f335af867fe9
#, fuzzy
msgctxt "hb69e5807g7253g4c73gb8f8g7ffc871ba752"
msgid ""
"<i>The very first reward I gifted myself on completion of my first "
"adventure. </i>"
msgstr "<i>내 첫 모험의 끝을 기념하며 스스로에게 선물한 첫 번째 상.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 55c27848-ff80-2cbd-6379-c52909de6b9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:55c27848-ff80-2cbd-6379-c52909de6b9a
msgctxt "h061f6006g935fg4d55ga8a6g7eca69ee6088"
msgid ""
"<i>Sorry. You didn't leave me much energy to spare to maintain appearances. "
"</i>"
msgstr "<i>미안하다. 형태를 유지할 만한 힘을 네가 남겨두질 않았어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 58f62e36-7ef2-3272-4e6d-6ca82c944a94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:58f62e36-7ef2-3272-4e6d-6ca82c944a94
#, fuzzy
msgctxt "hb52ef7dag9af6g4e94gaefcg2ab53280d6b7"
msgid "You really don't sound like a mind flayer."
msgstr "정말 마인드 플레이어가 아닌 것처럼 말하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 5a9bd51f-d988-ca00-cf65-87a1465a97b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:5a9bd51f-d988-ca00-cf65-87a1465a97b9
msgctxt "hc2aa9a2bg79b2g45b9g85aagf1d27db8c627"
msgid "<i>Let's move on to more important things. </i>"
msgstr "<i>더 중요한 얘기를 하도록 하지. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 5ac13213-2537-6c67-b139-de870c040487
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:5ac13213-2537-6c67-b139-de870c040487
msgctxt "ha32b7a60gdc16g4387gaa89gff793cd7dac9"
msgid "<i>You think you know my true nature?</i>"
msgstr "<i>내 진정한 본성을 안다고 생각하나?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 5c59c9cf-2b22-1966-86f3-3673a960eab8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:5c59c9cf-2b22-1966-86f3-3673a960eab8
msgctxt "h88577c2fg0e69g4e20gbebag88f94b06b5c6"
msgid "<i>Think on it. </i>"
msgstr "<i>생각해 보아라. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 5e5eb858-7051-abf7-8b8e-3e4cf5bf8de6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:5e5eb858-7051-abf7-8b8e-3e4cf5bf8de6
msgctxt "hc15bd273gdab8g4608g98c2g9f570bfd4934"
msgid "To business, then."
msgstr "그렇다면 일 얘기로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 5ec58592-18ba-404d-1173-1395a95ef306
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_AstralPrison_State_KilledDaisyDuringDialog = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:5ec58592-18ba-404d-1173-1395a95ef306
msgctxt "h0c26b40cg648cg4f39g8b17g6ec098d47831"
msgid "<i>What I didn't anticipate was how exhausting you would be.</i>"
msgstr "<i>내가 예상하지 못했던 건 네가 얼마나 지치게 굴 수 있는지였다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 5edf4416-967f-7c7c-3ae1-417624d8f46b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:5edf4416-967f-7c7c-3ae1-417624d8f46b
msgctxt "he24b81c4g9d78g4220gabc5ga779046eb103"
msgid ""
"<i>You are my puppet. Make no mistake. Without me, you have no value. </i>"
msgstr "<i>넌 내 꼭두각시다. 오해 말도록. 내가 없으면 넌 무가치하다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 602436fa-500f-a3ea-ea47-c51492b68c7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_8 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:602436fa-500f-a3ea-ea47-c51492b68c7d
msgctxt "h658f77f3g6cfag459fg8f2ag99d82ccca560"
msgid "<i>Don't worry. I'll make sure they don't remember a thing. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 61ca88a3-bd63-7e19-60c7-73965a0946b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:61ca88a3-bd63-7e19-60c7-73965a0946b0
msgctxt "hfd421c0agfff7g4b37gbaddg2cdfb4286d1c"
msgid ""
"<i>And yet, here you are, exactly as I instructed. That is all I needed.</i>"
msgstr "<i>그럼에도 넌 정확히 내 지시대로 여기까지 오게 되었지. 그거면 충분하다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 6330ed3b-85f5-3c41-2060-60cccff6e679
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:6330ed3b-85f5-3c41-2060-60cccff6e679
msgctxt "ha85a2400gc82ag46bdga61fg0b0b61ccf9e5"
msgid "<i>But since you insist on thwarting my craft, let us be blunt. </i>"
msgstr "<i>하지만 네가 고집스럽게도 내 기만술에 대해 불평하니, 진솔하게 말하도록 하지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 65c8fcac-b029-989c-f116-3bfb7f0117fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:65c8fcac-b029-989c-f116-3bfb7f0117fc
msgctxt "he5086816g90e7g4ec0g9fcag4c5bc8de6431"
msgid "Absolutely not, you freak!"
msgstr "절대 아니야, 이 괴물아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 6ab82c2a-2e1e-2e06-1cc5-00d61f9da8f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_DaisyStelmane_State_CalledOutManipulation = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:6ab82c2a-2e1e-2e06-1cc5-00d61f9da8f3
#, fuzzy
msgctxt "hd32d791bgf955g426fg9760g855e7e428a97"
msgid "You do a great impression of a human. But you're not fooling me."
msgstr "너는 분명 사람들에게 깊은 인상을 남겼지. 하지만 날 속일 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 6beeaef0-cf92-a1bf-20a9-344e9b7164ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:6beeaef0-cf92-a1bf-20a9-344e9b7164ef
msgctxt "h3d4bbc0fg48cdg4796gb3ddgdea74a593603"
msgid "Why did you resort to subterfuge at all?"
msgstr "애초에 왜 속임수에 연연했던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 732f3b5f-e6c0-551b-7939-18bdccadb5cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:732f3b5f-e6c0-551b-7939-18bdccadb5cf
msgctxt "hc5e2d4e7g989cg4b48gaf1agd9d5324eefb6"
msgid "It's fine. I just wanted you to know I know your true nature."
msgstr "됐어. 그냥 난 네 진짜 본성을 알고 있다는 것만 알아두라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 77aba1a7-5702-c333-7930-0de6e60d4ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:77aba1a7-5702-c333-7930-0de6e60d4ce5
msgctxt "h76004454g13fcg46d0gb2ecg3b5f5cbf81e8"
msgid ""
"<i>The elder brain's hivemind has grown to monstrous proportions. And "
"through the Crown's magic, it has complete control over each and every "
"member.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 78fa807c-c139-bfb8-9e36-730df8c2e8dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:78fa807c-c139-bfb8-9e36-730df8c2e8dc
msgctxt "he485c87fg7a6bg4714gb7ceg0e3f82d277b7"
msgid ""
"*The back of your mind warms with a rush of feeling, the Emperor's feeling - "
"heat, care, <i>arousal</i>.*"
msgstr "*당신의 마음 뒤켠이 몰아치는 느낌으로 덥혀집니다. 황제의 것입니다. 열감, 염려, <i>욕정</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 7ab334d6-4288-b83e-e0b0-6055e76c89d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:7ab334d6-4288-b83e-e0b0-6055e76c89d3
msgctxt "hd87eb5d8g7ca6g4891gbb75gc201508fc6f6"
msgid "<i>We are bonded now. And it is time to consummate love, with war. </i>"
msgstr "<i>우리는 바야흐로 결속되었다. 그리고 이제 전쟁으로써 사랑을 완성할 시간이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 7e62d202-4eb0-2ea5-8cd3-d891a877ef14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_State_DarkUrge_KnowsBhaalspawn = True
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:7e62d202-4eb0-2ea5-8cd3-d891a877ef14
msgctxt "h5f9c1316gcbecg4d31gb4a5g131d74d32ce7"
msgid ""
"<i>You know now of your Father's plans to use the elder brain to slaughter "
"the world over. One need not read minds to foresee the horrors he will pen "
"with your hand if you do not stand against him.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 7f390f22-a65d-5670-c7fa-49f68b7036c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:7f390f22-a65d-5670-c7fa-49f68b7036c4
msgctxt "hac63d6d4gb933g4444g8377g29b5a70bc159"
msgid "You weren't that easy to work with either."
msgstr "함께 일하는 동료로서는 너도 만만치 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 81750df6-e06a-c32d-6fd9-fec69a5cc55d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_8 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:81750df6-e06a-c32d-6fd9-fec69a5cc55d
msgctxt "h2ff9ca55g1ee4g4881g934ag2cbdc4087cb2"
msgid ""
"<i>I said I'd protect you from the Absolute, not each other. And I was... "
"distracted. </i>"
msgstr "<i>너를 절대자로부터 보호하겠다고 했지, 서로에게선 아니었다. 그리고 잠깐... 산만해졌었으니.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 825304f0-ae4f-313a-72d9-c2d7d718be46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:825304f0-ae4f-313a-72d9-c2d7d718be46
msgctxt "h4052774cg5f6fg4adegba95g31817f11257d"
msgid "<i>Lean in towards it. </i>"
msgstr "<i>마인드 플레이어를 향해 몸을 기댄다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 84398a1b-2334-1d45-29bf-233f1bb278bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:84398a1b-2334-1d45-29bf-233f1bb278bd
msgctxt "hb0e12effg7d2eg4376g9b75g74ca55ecf6e3"
msgid ""
"<i>I can make this easier for you if you like. My other form might be more "
"familiar for you to navigate.</i>"
msgstr "<i>원하다면 보다 쉽게 만들어줄 수 있다. 내 다른 형태가 아마 너로서는 탐색하기에 더 익숙하겠지. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 852e7759-39e1-d0fe-8185-3a3853ae2277
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:852e7759-39e1-d0fe-8185-3a3853ae2277
msgctxt "hd5365186g7c95g44fcg90f6g7d45346be468"
msgid "<i>Pull away. </i>"
msgstr "<i>밀어낸다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 85d41972-fabd-2e88-74bb-d8fc4587bf9c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:85d41972-fabd-2e88-74bb-d8fc4587bf9c
msgctxt "hae2123a8g744eg4a03g8a75ga7fd4e5b3e34"
msgid "<i>Try to find its mouth so you can kiss it. </i>"
msgstr "<i>키스할 수 있게 마인드 플레이어의 입을 찾아본다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 8723d655-7afa-8d52-f985-32b04b979aff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:8723d655-7afa-8d52-f985-32b04b979aff
msgctxt "ha9c3c352gfbecg4bafg8722g6ea90566209d"
msgid "I think you misread the signs - I'm fine with what we have now."
msgstr "잘못 판단한 것 같은데. 난 지금 이대로 충분해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 8b5b96f8-17e0-72e0-5183-b7c5c6faaed9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:8b5b96f8-17e0-72e0-5183-b7c5c6faaed9
msgctxt "h56bc3b0bg388ag4d45g998bgcdd9528c5b03"
msgid ""
"<i>I studied you. Your motivations, your actions, your desires. I deduced "
"the best way to align your goals with my own. </i>"
msgstr "<i>널 연구했지. 네 동기와 행동이며 욕망에 대해. 네 목표를 나의 것과 일치시킬 최적의 방도를 추론했다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = 8e4d1200-e6ea-3d0a-f852-e2a1065e218e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:8e4d1200-e6ea-3d0a-f852-e2a1065e218e
msgctxt "h384135a3gcacag4c8eg962cg027a91c4e81f"
msgid "I refuse to be controlled by anyone but my own self."
msgstr "난 나 자신 외의 누구에게도 통제받지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 8f803b53-34cb-fc85-c23f-80ece5f5553c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ea3a949-d1a4-91b1-278c-56f970d80ac2_HeldTentacle = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:8f803b53-34cb-fc85-c23f-80ece5f5553c
msgctxt "h4d99af22gf536g45fbg93a3ga0bedabaa27e"
msgid ""
"*A memory stirs - diagrams in a book you read long ago - a mind flayer's "
"mouth is underneath the tentacles.*"
msgstr "*오래전 책에서 보았던 도해에 대한 기억이 떠오릅니다. 마인드 플레이어의 입은 촉수 아래에 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 8fd49256-4200-4f18-6cc2-4d35032a66e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:8fd49256-4200-4f18-6cc2-4d35032a66e3
msgctxt "hf3e92861g00c6g4d92ga0d5g0dbf779a532b"
msgid "<i>What's the problem? </i>"
msgstr "<i>뭐가 문제지? </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 901ec830-99d3-b808-b539-034b994e614d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:901ec830-99d3-b808-b539-034b994e614d
msgctxt "h4e9976f3gb173g46a9g96e2g6a64266ea8a7"
msgid "<i>You saw straight to the core of what really mattered.</i>"
msgstr "<i>넌 진정으로 중요한 문제를 정확히 꿰뚫어보았다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 91cf6ec2-85e3-9a6f-7e5e-2c43a260b85a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:91cf6ec2-85e3-9a6f-7e5e-2c43a260b85a
msgctxt "hacb3289cge293g482eg9dd8g92f74c7ff675"
msgid ""
"<i>And believe me, it will radically increase our chances of success against "
"the elder brain.</i>"
msgstr "<i>그리고 분명, 그리하면 우리가 엘더 브레인에 맞서 승리할 가능성이 대단히 증대된다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 961a2efc-b089-69b6-370c-ff02e6894864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:961a2efc-b089-69b6-370c-ff02e6894864
#, fuzzy
msgctxt "hd427bdd0ga932g4aacga3cag926ad8b790ab"
msgid ""
"*As you drift into sleep, you feel a certain disappointment. The mind flayer "
"was very quick to abandon its attentions on you.*"
msgstr "*잠에 빠져들면 분명한 실망감이 느껴집니다. 마인드 플레이어는 당신을 향한 관심을 너무나 빨리 끊어냈습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 9790d31d-3e83-b46c-48d5-b7697ea6daeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:9790d31d-3e83-b46c-48d5-b7697ea6daeb
msgctxt "h2b953a4dg3a67g4d09g81c3g6cebc0ac1969"
msgid ""
"<i>By necessity, not design. But I am glad you appreciate the richness of my "
"experience. </i>"
msgstr "<i>계획이 아니라 필요에 따른 것이다. 그런데도 네가 내 경험의 풍부함을 제대로 알아봐 주니 기쁘군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = 99b14028-072b-0501-8075-715f595bb42f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:99b14028-072b-0501-8075-715f595bb42f
msgctxt "hd17be715g09e1g4462gafc9g8c550d51cc2b"
msgid ""
"*A memory stirs - diagrams in a book you read long ago - a mind flayer's "
"mouth is underneath the tentacles.*"
msgstr "*오래전 책에서 보았던 도해에 대한 기억이 떠오릅니다. 마인드 플레이어의 입은 촉수 아래에 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 99beb9aa-b694-4a23-b5a0-44f8a78e344f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:99beb9aa-b694-4a23-b5a0-44f8a78e344f
msgctxt "hdd15362eg16b4g456bg8d63g37e1e8cb9254"
msgid "<i>Come - it is time to get dressed. We have work to do. </i>"
msgstr "<i>와라, 옷을 입어야지. 우리에겐 할 일이 있다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = 9ebff05d-9e76-5d00-c4d2-6f54e9056b6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:9ebff05d-9e76-5d00-c4d2-6f54e9056b6c
msgctxt "h74780d9ag5dd7g4a09g859bgb25aa8775859"
msgid ""
"<i>As well as radically increasing our chances of success against the elder "
"brain.</i>"
msgstr "<i>물론, 엘더 브레인에 맞서 승리할 가능성도 대단히 증대된다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = a03f66af-122a-a32a-f2fc-26d31743820e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:a03f66af-122a-a32a-f2fc-26d31743820e
msgctxt "h666c9104gbf43g4f39g9eaag63cb9f3c9103"
msgid ""
"*Pleasure upon pleasure as mind and body intertwined. It was hard to tell "
"where thoughts ended and feelings began.*"
msgstr "*정신과 육체가 한데 얽히며 쌓여진 쾌락. 사고와 감각의 경계가 어디였는지 가름하기 어렵습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = a0456336-b916-8cd5-e085-ed4bd5a8033a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:a0456336-b916-8cd5-e085-ed4bd5a8033a
#, fuzzy
msgctxt "h218bb826g14d6g4462g9734g07417804f4ee"
msgid "<i>I trust you. And I did what I needed to earn your trust too. </i>"
msgstr "<i>난 너를 믿는다. 내가 했던 일들도 너의 신뢰를 얻기 위함이었지. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = a187dfe5-b516-cffe-203a-f8144add04af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:a187dfe5-b516-cffe-203a-f8144add04af
#, fuzzy
msgctxt "h58e3de41ga843g41edg8987g651361cdd04d"
msgid ""
"<i>And now that you have seen where I come from, you know all there is to "
"know about me. At least all that matters. </i>"
msgstr "<i>이제 내가 온 곳을 보았으니, 넌 내 모든 걸 알게 된 거다. 적어도 중요한 건 모두.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = a34bea02-8a19-238e-cf67-e612a0be6c17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:a34bea02-8a19-238e-cf67-e612a0be6c17
msgctxt "hd84da6f6g8855g46e3ga207g53d70f0d9f4d"
msgid ""
"<i>Perhaps, at first, I did consider that you were just a problem to be "
"solved. And not an easy one at that. But I persisted. </i>"
msgstr "<i>그랬을지도. 처음에는 널 풀어야 할 숙제라고만 생각했다. 쉽진 않았지. 하지만 나는 노력을 계속했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = a4de7fac-4d69-9856-7469-7ccd0b75a96d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:a4de7fac-4d69-9856-7469-7ccd0b75a96d
#, fuzzy
msgctxt "h5a97430dgca72g4ad8gb3e7g5a7f8873e9e7"
msgid ""
"<i>They say that home is where a person can be their truest selves, without "
"guile, without pretence.</i>"
msgstr "<i>집은 한 인간이 속임수 없이, 가식 없이 진정한 자신이 될 수 있는 곳이라고 하지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = ac52c47f-6d3e-b3ca-4ddc-8e6d61c66a5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ac52c47f-6d3e-b3ca-4ddc-8e6d61c66a5e
msgctxt "hd1c9ce71g25a0g472agaf59g905ec7beecba"
msgid ""
"<i>Sometimes I felt almost like we were dancing our way towards something "
"deeper... </i>"
msgstr "<i>때로 난 우리가 더 깊은 곳을 향해 흘러가고 있는 것처럼 느껴졌다...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = ad863978-8519-0cca-a5ad-56f78149b159
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ad863978-8519-0cca-a5ad-56f78149b159
msgctxt "h07c3c0a5g1da9g4b59gb4fdgbef3da973b80"
msgid "<i>As did I. </i>"
msgstr "<i>마찬가지다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = ae024b54-a931-d5c1-ff07-a88377ef144d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ae024b54-a931-d5c1-ff07-a88377ef144d
msgctxt "h5cb494fcg0dafg486egb0beg1e97b737ca53"
msgid "Are we not going to talk about what just happened?"
msgstr "방금 있었던 일에 대해서 얘기 안 할 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = b1af7978-5aec-4ace-9475-7a9e6d485c6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:b1af7978-5aec-4ace-9475-7a9e6d485c6b
msgctxt "h8f9751f3g0dbbg4a8bg8196gb8c45883a919"
msgid ""
"<i>You don't like to be coddled, cajoled. But you responded well to logic, "
"to rational arguments, to cold, hard facts.</i>"
msgstr ""
"<i>넌 내가 어린애 다루듯 달래고 회유하는 걸 좋아하지 않았다. 그러나 논리와 합리적인 주장, 냉정하고 확고한 진실은 잘 받아들였지. "
"</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = b2d31554-279a-2051-0212-34803f0f88de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:b2d31554-279a-2051-0212-34803f0f88de
msgctxt "had9fca71gb80ag4901g8cb4g61db753bcb14"
msgid "Yes. Show me your thoughts."
msgstr "그래. 네 생각을 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = b3be4e32-560e-9a3f-5658-14296fa8a830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:b3be4e32-560e-9a3f-5658-14296fa8a830
msgctxt "h2b5c4ed9ga14fg403agb5b9g291cd965ec7c"
msgid ""
"<i>I'm sorry - you're right - now's not the time. Forget I said anything. "
"</i>"
msgstr "<i>미안하군, 네가 옳아, 이럴 때가 아니다. 내가 말한 것들은 잊어라. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = b6310d80-2145-c3d1-a51b-52adaafa32bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:b6310d80-2145-c3d1-a51b-52adaafa32bb
msgctxt "h32371ac9g9650g407fgb15agd0786eb5985b"
msgid "This is awkward... I want to kiss you but I have no idea where."
msgstr "어색해... 키스하고 싶은데 어디에 해야 할지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = b9a6970e-7fc6-485f-5d7c-b60debdfe42a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:b9a6970e-7fc6-485f-5d7c-b60debdfe42a
msgctxt "hc7b62cafg1dfag4909g97fag005fb6d66b7b"
msgid ""
"You're an expert at mental manipulation. I wouldn't trust anything you show "
"me."
msgstr "넌 정신 조작의 대가잖아. 네가 나한테 뭘 보여주든 믿지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = ba74f75e-f115-9cd7-3bb2-3d829f9ed568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ba74f75e-f115-9cd7-3bb2-3d829f9ed568
msgctxt "hf830d842gd2b1g4871ga147g8ace379b3d37"
msgid ""
"*Its breathing quickens as you pull in close to its face. Its excitement "
"palpable.*"
msgstr "*당신이 얼굴이 맞닿을 정도로 마인드 플레이어를 가까이 끌어당기자, 그것의 숨이 거칠어집니다. 흥분의 징후가 명백합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = bbff505e-60d0-47d3-7402-a97d4ee38b61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:bbff505e-60d0-47d3-7402-a97d4ee38b61
msgctxt "haf9ee88bgaab3g4d6dg9bf5gf65c85ded9b2"
msgid "Please do."
msgstr "그렇게 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = bc8255d8-d820-5c55-20e9-d761c265134b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:bc8255d8-d820-5c55-20e9-d761c265134b
msgctxt "he934d0fdge592g4766gb99eg66ffbf423203"
msgid ""
"<i>We have communed with our <b>minds entire </b>at the deepest level. What "
"else is there to say? </i>"
msgstr "<i>우리는 서로의 <b>오롯한 정신 </b>으로 가장 깊은 수준에서 교감을 나눴다. 달리 더 할 말이 남았단 말인가?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = bd4adda7-b000-b0b1-4115-dd377c97f886
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:bd4adda7-b000-b0b1-4115-dd377c97f886
msgctxt "hb1749f22g4de7g45c9gbc4egf9a5a0804272"
msgid ""
"<i>You know... this might be our last chance to explore the possibility "
"of... a deeper relationship.</i>"
msgstr "<i>이것이 우리의... 더 깊은 관계의 가능성에 대해 탐색할... 마지막 기회일지도 모른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = c06d8044-578e-b1a7-2ec0-27133e2d1409
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:c06d8044-578e-b1a7-2ec0-27133e2d1409
msgctxt "he52011b3g6b78g4eb9g8939gc59310327423"
msgid ""
"<i>I have no more secrets from you. No need to resort to subterfuge. We are "
"true allies now, working towards a common goal. </i>"
msgstr ""
"<i>더 이상 네가 모르는 비밀은 없다. 속임수에 연연할 필요는 없다. 우리는 이제 같은 목표를 위해 노력하는, 진정한 동맹이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = c24d64f1-453c-fbeb-00af-de22cdabd6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:c24d64f1-453c-fbeb-00af-de22cdabd6ea
msgctxt "hd59eef04ge838g417cgb59agbc49d1eea5f4"
msgid "Very much."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = c25cb27b-7dce-a23f-e33d-6c55fce50d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:c25cb27b-7dce-a23f-e33d-6c55fce50d7e
msgctxt "h3f7eff96g461bg4c46ga4deg96cfc473fa20"
msgid ""
"<i>I am tempted. But it will be quite some time before I am - ah - able - to "
"do that again. And time is not on our side. </i>"
msgstr "<i>유혹적이다만. 시간이 좀 걸릴 거다... 내가, 음, 또 할 수 있게 되려면. 그리고 시간은 우리의 편이 아니지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = c8e1ec73-a7c8-c758-4eee-b3826ee4c9fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:c8e1ec73-a7c8-c758-4eee-b3826ee4c9fb
msgctxt "hc182e443gc60bg429cg8c61g71d16f571bc9"
msgid "<i>It would make us <b>even more </b>compatible.</i>"
msgstr "<i>그리한다면 우리는 <b>지금보다도</b> 긴밀한 사이가 될 테지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = ce68cd3d-b9d7-033c-4ab3-b819b63f7ff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ce68cd3d-b9d7-033c-4ab3-b819b63f7ff8
msgctxt "h6287fa31g501fg43b8g8314g75be096b8837"
msgid ""
"<i>Good. Then you understand why I had to do what I did. It was for your own "
"good. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = cf017dd9-f716-1ee7-0437-b91a8d7e3177
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ea3a949-d1a4-91b1-278c-56f970d80ac2_HeldTentacle = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:cf017dd9-f716-1ee7-0437-b91a8d7e3177
msgctxt "h9415947bg2467g494cg932ag622b6983b2b4"
msgid "<i>Kiss the tentacle and hope that it's an erogenous appendage.</i>"
msgstr "<i>촉수에 키스하고 성감대이길 기대한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = cf485d11-619d-86f0-96bc-4feaac2f1eba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:cf485d11-619d-86f0-96bc-4feaac2f1eba
msgctxt "h0c01606cg7813g4893gb264gce702fbd8dc9"
msgid "I prefer this one. Just... show me what to do."
msgstr "난 이대로가 좋아. 그냥... 어떻게 해야 하는지 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = d069c678-db0b-5f3d-bd83-0e2f9941c9fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:d069c678-db0b-5f3d-bd83-0e2f9941c9fb
msgctxt "h80070bfcgff2ag4e88gb5e9gb4e25cfca7a7"
msgid "<i>Is that something you want?</i>"
msgstr "<i>네가 원하는 바인가?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = d109f824-a8cb-31e0-9ad5-4afd9f5c850e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:d109f824-a8cb-31e0-9ad5-4afd9f5c850e
msgctxt "h6a61ce99gb22cg4b38g83f6g6b42b11f6054"
msgid "You're trying to flirt with me now?"
msgstr "지금 날 유혹하려는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = d21a9825-246e-8ce1-9a4e-aff270e384ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_DaisyAcknowledgement_State_RejectedEmperorsAdvances(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:d21a9825-246e-8ce1-9a4e-aff270e384ce
msgctxt "h70498f08g73beg4e7bgb2eeg76ff4b4516b2"
msgid "<i>Pull away.</i>"
msgstr "<i>밀어낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = d25a3356-1163-c8ff-aeac-4411c1d31799
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:d25a3356-1163-c8ff-aeac-4411c1d31799
msgctxt "hc28e2891g751dg4dbdg97f6gf92c3cd3184c"
msgid "Perhaps."
msgstr "어쩌면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = d3464778-83e0-1e63-d979-5dad240a48b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:d3464778-83e0-1e63-d979-5dad240a48b7
msgctxt "h8af39e2fg7040g44d9gbaebg2bb384949d93"
msgid "I'm sorry. I just don't know what I'm doing."
msgstr "미안. 그냥 내가 뭘 하는지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = d81dfc7f-119b-2bb2-a7f5-876e002a00d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_DaisyAcknowledgement_State_RejectedEmperorsAdvances(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:d81dfc7f-119b-2bb2-a7f5-876e002a00d1
msgctxt "h4bfd06bcgf78bg4656ga626g2d36d85a02d2"
msgid "Perhaps now just isn't the time. That was... awkward."
msgstr "어쩌면 지금은 아닌 듯해. 이건... 어색해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = d9e15697-5dcc-d477-3695-a09fb7eb5fa5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Daisy_State_TriedToReadMind(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:d9e15697-5dcc-d477-3695-a09fb7eb5fa5
msgctxt "he64d6df1gaa20g41d7g8db9g1a4e7ddc062e"
msgid ""
"Please don't show me your thoughts - I've been there and I didn't like it. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = da7abd66-8825-f4d2-c5bc-922b15144cbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:da7abd66-8825-f4d2-c5bc-922b15144cbd
msgctxt "h63087ec3ge608g4570g9311ge9761ce763f3"
msgid ""
"<i>I didn't get that impression. And my calculations are never wrong. </i>"
msgstr "<i>그런 인상은 받지 못했다. 그리고 내 계산은 틀리는 법이 없지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = dee44c73-8866-036a-9116-9aa0046a2c15
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_DaisyAcknowledgement_State_ThreatenedEmperor(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:dee44c73-8866-036a-9116-9aa0046a2c15
msgctxt "hc91f8d78gb78dg4281gb56fge7f4462579c5"
msgid "I should have thrown you and the Prism to the shadow curse."
msgstr "네놈과 프리즘을 그림자 저주에 던져버렸어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = df6704ee-d0d5-1b1e-5729-c5eabc83f831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:df6704ee-d0d5-1b1e-5729-c5eabc83f831
msgctxt "h0de6a15fg21fag4c8eg9584gec5053ede4c7"
msgid "True."
msgstr "사실이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = e1137779-25b9-ae59-0964-7f210cb1168a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ea3a949-d1a4-91b1-278c-56f970d80ac2_HeldTentacle = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:e1137779-25b9-ae59-0964-7f210cb1168a
msgctxt "h87372269gbd62g43eag9ce9g92769f90cb0a"
msgid ""
"*If this creature is at all similar to an octopus, as it appears to be, its "
"mouth is probably somewhere underneath the tentacles.*"
msgstr "*이 생명체가 생긴 것처럼 문어와 유사하다면 입은 아마도 촉수 아래 어딘가에 있을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = e1bd593f-a912-c1c0-95e3-927039c77eca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:e1bd593f-a912-c1c0-95e3-927039c77eca
msgctxt "hc0427e49g83aag42c8gbba6g65939a00e2ac"
msgid "Finally the mask drops. And you put so much effort into it."
msgstr "마침내 가면이 벗겨졌군. 참으로 공을 들이셨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = e1f3d270-2899-8c3e-9e82-2c0098bae864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:e1f3d270-2899-8c3e-9e82-2c0098bae864
msgctxt "h7b190f0egb437g452fg95c3gef6a579bc62d"
msgid ""
"<i>Your distrust of me will be our undoing. Would it make a difference if I "
"let you read my thoughts?</i>"
msgstr "<i>너의 불신은 우리의 실패가 될 것이다. 네가 내 생각을 읽게 해준다면 차이가 생길까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = ea40390c-dc63-854f-ce34-41b76c8a99e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ea40390c-dc63-854f-ce34-41b76c8a99e2
msgctxt "hd24114fag34eag4164g90efg1cae3d3ed341"
msgid "And what did you learn?"
msgstr "그래서 뭘 알아냈는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = ec5013dc-2a45-5f48-bdff-190ebf2b8e3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ec5013dc-2a45-5f48-bdff-190ebf2b8e3c
msgctxt "hd02c3ae9g3720g42fag92edg50bc55a8795b"
msgid ""
"You did some pretty bad things. I'm not sure how I feel about being your "
"ally."
msgstr "넌 꽤 나쁜 짓들을 저질렀어. 내가 네 동맹이란 걸 어떻게 생각해야 할지 확신이 안 서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = ec5cb85b-72a2-b147-5f62-bdc4378504a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ec5cb85b-72a2-b147-5f62-bdc4378504a7
msgctxt "h4236549fgab04g48bega523gc495b88c6718"
msgid "You could have been open with me from the start."
msgstr "처음부터 솔직하게 말해줄 수도 있었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = ef1a5207-ab83-5226-9387-047144cd5f20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ef1a5207-ab83-5226-9387-047144cd5f20
msgctxt "hd2db74d2ge08cg44abgb98bgc74ed5449641"
msgid ""
"<i>But few would trust a mind flayer, so I did what I had to do to convince "
"you.</i>"
msgstr "<i>하지만 마인드 플레이어를 신뢰할 사람은 드물기에, 난 너에게 확신을 주기 위한 작업을 했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = ef267248-7374-e3cd-145c-f513b35046f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ef267248-7374-e3cd-145c-f513b35046f2
msgctxt "h24b34a43g6b00g46ccgbd56g579bda851d9d"
msgid "<i>Do you wish it?</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = ef49e204-fd74-edb4-5f2c-4d91af283425
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ef49e204-fd74-edb4-5f2c-4d91af283425
msgctxt "hffe8de15g846bg41b8gb5adg6c11f2455f9a"
msgid ""
"<i>Freak? If only you knew... but why conceal it? You may as well see for "
"yourself. </i>"
msgstr "<i>괴물? 네가 알았더라면... 하지만 숨길 이유가 뭐지? 너로서도 보는 편이 좋을 텐데.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = f0f24ce2-5071-0159-30f0-b673758745af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f0f24ce2-5071-0159-30f0-b673758745af
msgctxt "h951ac3f4g642dg4de1g9b45g1b40a4049be7"
msgid ""
"*You can read the Emperor's expression better now that you've connected on a "
"deeper level. You know it feels the same way.*"
msgstr ""
"*더 깊은 차원에서 연결되자, 황제의 표정을 전보다 잘 읽을 수 있게 되었습니다. 마인드 플레이어 역시 마찬가지로 느낀다는 것을 알 수 "
"있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = f129d3c0-3653-b185-7a23-ddce3047c80b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f129d3c0-3653-b185-7a23-ddce3047c80b
msgctxt "hf47d8333g80bag455eg9a82g4d464cf69aa6"
msgid "<i>Do it again.</i>"
msgstr "<i>다시 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f2b11974-a583-69fc-a732-3d94cca56bbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f2b11974-a583-69fc-a732-3d94cca56bbf
msgctxt "h51a43499g843bg4372gb279gb8c3c69f482f"
msgid "<i>Would you like that?</i>"
msgstr "<i>마음에 드는가?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = f36ba4ad-8fce-3534-b6b1-2ef1d0bafe1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f36ba4ad-8fce-3534-b6b1-2ef1d0bafe1a
msgctxt "h9c5522e8g070cg4cfag8cffg204ff97fba2e"
msgid ""
"*Everything you ever dreamt of and more. The single greatest experience of "
"your life.*"
msgstr "*당신이 꿈꿔왔던 그 모든 것 이상. 지금까지의 삶을 통틀어 가장 위대한 경험.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Narrator
#. NodeID = f542d46c-f4a3-b43d-e32f-2ba9dd409814
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f542d46c-f4a3-b43d-e32f-2ba9dd409814
msgctxt "hf41c0a7fgecdeg4c6bga8edgabbca00c5a67"
msgid ""
"*You pause a moment as a thought occurs to you - where <i>is</i> a mind "
"flayer's mouth?*"
msgstr "*당신은 떠오른 의문에 멈칫합니다. 마인드 플레이어의 입은 어디에 <i>존재</i>하죠?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = f567f330-4af1-d9ff-35b4-70944bbaf8aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f567f330-4af1-d9ff-35b4-70944bbaf8aa
msgctxt "h8ffe4224gcc72g4f8ega37ag05fbcd6c6568"
msgid "Let me get this straight. You're complaining about being stuck with me?"
msgstr "터놓고 말하자고. 지금 날 내칠 수가 없다고 불평하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f5861ddd-163c-b004-35f1-8253e6fed325
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f5861ddd-163c-b004-35f1-8253e6fed325
msgctxt "h98fca05fgb209g46b9g94cag7162e7069fec"
msgid "<i>I have learned to adapt my methods to your needs.</i>"
msgstr "<i>내 방법론을 네 필요에 맞추는 법을 배웠으니.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f713b62d-0483-70e7-2109-52e7f330db92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_DaisyAcknowledgement_State_RejectedEmperorsAdvances(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f713b62d-0483-70e7-2109-52e7f330db92
msgctxt "h733c80b3ge0ccg4807g8d8aga7e7f840ae4e"
msgid ""
"<i>We must stop it while we still can. Before we, too, become its slaves. "
"</i>"
msgstr "<i>아직 가능할 때 막아야만 한다. 우리마저 엘더 브레인의 노예로 전락하기 전에.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f7f59961-d6ad-5fd5-166d-3736e63d50e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f7f59961-d6ad-5fd5-166d-3736e63d50e9
msgctxt "hd8ae8b36gc4ffg4461gb630ga01a51c475ed"
msgid ""
"<i>The only way we were ever going to get close enough to the brain to "
"destroy it was by working together.</i>"
msgstr "<i>우리가 엘더 브레인을 파괴할 수 있을 만큼 접근하기 위한 유일한 방법은 함께 협력하는 것이었다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f91589c2-eaf0-5b44-213e-87d74991ee6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f91589c2-eaf0-5b44-213e-87d74991ee6a
msgctxt "hf5cdd18bgc916g40bbg83d3g7bacaa876607"
msgid "<i>I understand. Then let us move on to other things. </i>"
msgstr "<i>이해한다. 그렇다면 다른 문제로 넘어가도록 하지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f918c3df-02f6-3846-f664-6d31032e8ca0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tadpole_Event_AstralTouchedTadpoleEaten = False
#.      - GLO_Tadpole_Event_AstralTouchedTadpoleDestroyed = False
#.      - CAMP_DaisyAcknowledgement_SexWithEmperor = False
#.      - GLO_General_State_SomeoneIsPartialCeremorph = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f918c3df-02f6-3846-f664-6d31032e8ca0
msgctxt "h9bab6026g6ab9g460fg8e9cg5464fbcf7ef0"
msgid ""
"<i>You should reconsider your attachment to your physical form. You have "
"seen what an illithid can do.</i>"
msgstr "<i>육신에 대한 집착은 재고해 보아라. 일리시드가 무엇을 할 수 있는지 보았지 않나.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f94bdb5b-6e71-e4b1-9b86-b12c449d4857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f94bdb5b-6e71-e4b1-9b86-b12c449d4857
msgctxt "hca788334g0bffg495fgada0ge14943000d4b"
msgid "<i>I'm sorry - it's a reflex. But I can stop if I do this... </i>"
msgstr "<i>미안하다, 반사적인 것이라. 하지만 이렇게 하면 가능하겠지...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = f95f0fdf-1ce9-813a-672a-ea396046316f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:f95f0fdf-1ce9-813a-672a-ea396046316f
msgctxt "hc0753853gfd7fg4e3fgb73dg0e2107b83d78"
msgid "<i>Yes, you did.</i>"
msgstr "<i>그래, 그랬다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = Player
#. NodeID = fd3456d6-9433-e2f2-7514-08a2ea7b463b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:fd3456d6-9433-e2f2-7514-08a2ea7b463b
msgctxt "h7768e2deg037eg45fdg946eg3fb7f3833685"
msgid "You make it sound like I was some sort of experiment."
msgstr "내가 무슨 일종의 실험이었다는 것처럼 들리는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM
#. Speaker = The Emperor
#. NodeID = ffafa57c-c955-b8f4-2b7a-0016998c3347
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyAcknowledgement_AvD_ROM:ffafa57c-c955-b8f4-2b7a-0016998c3347
msgctxt "h0715eebcg155bg48fegb4ceg0880874150be"
msgid ""
"<i>Perhaps, but I couldn't take the risk. An elder brain leaves no room for "
"error. </i>"
msgstr "<i>그럴지도. 하지만 위험을 감수할 수 없었다. 엘더 브레인은 실수를 허용하지 않으니.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 021c9eed-d02d-390e-7d4c-f52566ddc3da
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:021c9eed-d02d-390e-7d4c-f52566ddc3da
msgctxt "hbec6576cg4df5g4e30gb5acg368b7c815fb7"
msgid ""
"Unfortunately they are both dedicating more and more resources to retrieving "
"it."
msgstr "불행히도 두 세력 모두 프리즘을 찾기 위해 점점 더 많은 자원을 투입하고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 021c9eed-d02d-390e-7d4c-f52566ddc3da
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD:021c9eed-d02d-390e-7d4c-f52566ddc3da
msgctxt "h46c49d27g9406g496cgad52g72c518de3867"
msgid ""
"Unfortunately they are both dedicating more and more resources to retrieving "
"it."
msgstr "불행히도 두 세력 모두 프리즘을 찾기 위해 점점 더 많은 자원을 투입하고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
#. NodeID = 0bb0d10e-c051-3b29-14c7-9d4dc61957d2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
