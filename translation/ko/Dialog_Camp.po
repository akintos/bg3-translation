msgctxt "hde8bc505g8a43g4387ga4ddg59376d2601a4"
msgid "I would like to talk about hirelings."
msgstr "용병에 관해 얘기하고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 2a26e83b-8cd4-3157-405e-2823c4f5545d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2a26e83b-8cd4-3157-405e-2823c4f5545d
msgctxt "h856714c1gd9e3g4805g84c2ge5d941154b32"
msgid "I'd like to talk about something else."
msgstr "다른 주제에 대해 얘기하고 싶어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 2b4d1302-1234-984e-bd09-87ae39a15155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2b4d1302-1234-984e-bd09-87ae39a15155
msgctxt "h3a601a2cg6922g46cegb6feg950abab7912f"
msgid ""
"She will be left to the peace of eternity, where the Urge shall seek her no "
"more."
msgstr "충동이 더 이상 그녀를 괴롭히지 않는 곳에서, 그녀는 이제 영원토록 안식에 들리라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 2c86ce25-949e-3c0a-1d3b-7b6d7bf8a586
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
