msgctxt "h00563d65ge3c3g4cf7ga6d2gd43cbd5bf751"
msgid "Well, I don't find you entertaining in the least."
msgstr "그래, 넌 진짜 재미있는 구석이라곤 하나도 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Shadowheart
