#.     - CAMP_Jergal_State_WillResurrectHalsin = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:f668579f-0e68-a152-777c-e921453bd297
msgctxt "h77e7ccfcg7514g47abgad01g1eb88fcb7123"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = f6f2a8fd-2e22-fe74-191a-667342e98846
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:f6f2a8fd-2e22-fe74-191a-667342e98846
msgctxt "hef717da6g81e3g4a4eg9476gd2969177ffcc"
msgid "You sound disapproving."
msgstr "못마땅하게 들리는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = f7dfd3ae-45fc-e9a0-c883-6e18c3a1cbef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Jergal_AttackedJergal(1) = True
#.   Object:
#.      - CAMP_Jergal_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Jergal_AttackedJergal(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:f7dfd3ae-45fc-e9a0-c883-6e18c3a1cbef
msgctxt "hd0850dbcg6926g4395gacfeg8195fce2547a"
msgid "Hast thou seen the futility of thy actions?"
msgstr "그대의 행위가 부질없음을 이제 깨달았는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = f88ad834-6988-8c5f-d759-2260e1fd6db6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:f88ad834-6988-8c5f-d759-2260e1fd6db6
msgctxt "h759f0e80gb3f7g47fega07dgb40091bc18ea"
msgid "Thou mayest."
msgstr "바라는대로."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = fde3e63a-25b0-4604-8d0c-22c60f55a598
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:fde3e63a-25b0-4604-8d0c-22c60f55a598
msgctxt "hc03bcd03g9520g4a21g9306gda2e2c3c355b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = fe03ee08-4e09-ab89-2cc8-b9148e7dd6da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_MurderOfAlfira = True
#.   Object:
#.      - CAMP_Jergal_HasMet(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:fe03ee08-4e09-ab89-2cc8-b9148e7dd6da
msgctxt "hbcad51bcgfa69g4708gb119g6c5e8c03b5f4"
msgid "Thy wheel of Fate turns ever to the dark."
msgstr "그대의 운명의 바퀴는 항상 어둠으로 향한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = fe1fd2e8-11f2-3d9d-5ee6-99ac28e7337e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:fe1fd2e8-11f2-3d9d-5ee6-99ac28e7337e
msgctxt "h2112307dg9f66g476cgabbdgad31c024473b"
msgid ""
"This is the price of balance. ([GEN_CheckMagicPocketGold_2_463b0f43-5410"
"-412d-aba3-875cf81c38ca])"
msgstr ""
"이것이 균형의 대가이니라. ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = fe646049-f888-f4a5-76c3-227ef5c193ce
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:fe646049-f888-f4a5-76c3-227ef5c193ce
msgctxt "hea49b2fcg89dcg4773ga850g6d509f0f21e7"
msgid "You walk with death. Are you a Chosen of Kelemvor?"
msgstr "당신은 죽음과 함께 거니는군. 혹시 켈렘보르님께 선택받은 자인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = fe646049-f888-f4a5-76c3-227ef5c193ce
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:fe646049-f888-f4a5-76c3-227ef5c193ce
msgctxt "hc2d37bf5g74eeg48d4g8d17g5e6b2603fe57"
msgid "Are you a Chosen of Kelemvor?"
msgstr "당신은 켈렘보르님께 선택받은 자인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = ff3e56ef-1557-2c4f-dcb3-74f605b599de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Jergal_State_PlayerHasDismissableAvatars(1) = True
#.   User:
#.      - CAMP_Jergal_State_DismissTutorialGiven(1) = False
#. SetFlags:
#.   User:
#.     - CAMP_Jergal_State_DismissTutorialGiven(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:ff3e56ef-1557-2c4f-dcb3-74f605b599de
msgctxt "hdd95f673gce6eg447dgaaf3g291ead3ff12c"
msgid "How can I remove fellow adventurers from my party? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = ff456838-b1df-4deb-dc4e-9fc7f97c4f42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = True
#.      - ORI_DarkUrge_Event_AskedJergalAboutCompanionResurrection = False
#.      - NIGHT_DarkUrge_SparedIsobel = True
#.      - ORI_DarkUrge_State_SparedIsobelWithAstarion = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:ff456838-b1df-4deb-dc4e-9fc7f97c4f42
msgctxt "h4521f8abg7fa3g4ea9gbdd9g6c1897df3a3b"
msgid "Please bring back Astarion. I can't live with what I did."
msgstr "아스타리온을 되살려주세요. 제가 한 일을 감당할수가 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal_AD_PlayerResurrection
#. Speaker = Withers
#. NodeID = 5a7d5502-bdd7-dda4-e0b9-3176c27f54db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal_AD_PlayerResurrection:5a7d5502-bdd7-dda4-e0b9-3176c27f54db
msgctxt "h9d60359bgdd2ag4778gbad4g53f0f6d88d5d"
msgid "By doom and dusk, I strike thy name from the archives! Rise!"
msgstr "파멸과 황혼의 힘으로 망자의 명부에서 그대의 이름을 외치니! 일어설지라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 0097b428-1368-6b10-bea1-45a78513fa7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingWithWyll(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:0097b428-1368-6b10-bea1-45a78513fa7f
msgctxt "hdefadcd1g5fb0g4a6dgb719g69469889d3c2"
msgid ""
"I know you and Wyll have been getting close, by the way. I owe him a lot, "
"but I don't owe him you."
msgstr "그건 그렇고 너랑 윌이 요즘 부쩍 가까워진 거 나도 알아. 윌한테는 신세 좀 지긴 했지만, 너까지 신세 진 건 아니거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 0155cb1a-f975-0bdc-d58e-a341aca202ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:0155cb1a-f975-0bdc-d58e-a341aca202ce
msgctxt "ha043fef8g1fe3g4ebaga4f1g4e5d03cc5b20"
msgid "They're still zipping around inside me."
msgstr "아직도 내 마음은 불꽃들로 너울거리는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = 04dbd90e-d9eb-89db-5c7b-cec2c16488fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:04dbd90e-d9eb-89db-5c7b-cec2c16488fa
msgctxt "hef8ae7e7gc96eg4c59g95d0g79ebb7d8c2d2"
msgid "No permanent damage. And absolutely worth it."
msgstr "영영 아픈 것도 아닌걸. 그만한 가치가 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = 05d065bc-f818-6f56-f234-a49658ebae45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:05d065bc-f818-6f56-f234-a49658ebae45
msgctxt "h8eee44cdg69c8g4686g9345g7f9c484fb844"
msgid "You can count on it."
msgstr "맡겨만 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = 0ebdcf8f-f31b-2664-62c2-7009d9408c3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:0ebdcf8f-f31b-2664-62c2-7009d9408c3b
msgctxt "hc8d67cfbged1dg4bcagbbc9g31a7568a5dd0"
msgid "I miss the feeling of you already."
msgstr "벌써 또 널 느끼고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 32ecb3c5-d4fe-0b81-c91b-3a10bfe6c9bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_State_WaitingForSolution = False
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:32ecb3c5-d4fe-0b81-c91b-3a10bfe6c9bf
msgctxt "heb9aedb9gdc31g4acfg85b0g173a5e27fdf1"
msgid "Oh, this is clever. Might even work. C'mere."
msgstr "오, 머리 좋은데. 통할지도 몰라. 이리 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 3590603d-6004-2940-aebf-61af045a1591
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:3590603d-6004-2940-aebf-61af045a1591
msgctxt "h64e6fc48ge86bg48abg9642g2281070af574"
msgid ""
"I don't mind sharing you with the bookworm while I'm indisposed, by the way. "
"I'm sure he can keep you entertained until I'm more... approachable."
msgstr "내가 기분이 별로일 땐 책벌레와 함께 있어도 괜찮아. 내가 좀 더... 접근 가능해지기 전까지는 녀석이 널 즐겁게 해 줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = 3954f04a-1e99-078d-0121-c74898aed98f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:3954f04a-1e99-078d-0121-c74898aed98f
msgctxt "h9fa67c6dg005dg422ag8784gfe3c6a447811"
msgid "Believe me, it's my top priority."
msgstr "믿어 줘, 그건 내 최우선 사항이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 504c4c6e-26c4-7974-f487-4ee3f7395b51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:504c4c6e-26c4-7974-f487-4ee3f7395b51
msgctxt "h4c5fe903g6446g423dg9a3agd371f6af2c89"
msgid ""
"I know I can't have much more than that - not until we've found a more "
"permanent solution to the hellfire issue."
msgstr "나도 알아. 지옥불 문제에 대해 영구적인 해결책을 찾기 전까지는 이 이상 욕심 내선 안 된다는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = 65030b81-d755-4051-6f63-ea65517b11e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:65030b81-d755-4051-6f63-ea65517b11e1
msgctxt "hfa30eb06ga0d2g4cb4g816dg80219e4213cf"
msgid "You're the only one for me, Karlach. Believe me."
msgstr "난 너뿐이야, 칼라크. 믿어 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 664b8ab9-570f-328a-fde2-5a581ce68f37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:664b8ab9-570f-328a-fde2-5a581ce68f37
msgctxt "h2b8e5d70g7aaeg42a0gad60g99ae3307eb6d"
msgid ""
"You have your fun with the angry alien 'til then - I don't mind sharing. But "
"keep a piece left over for me, hmm?"
msgstr ""
"그때까지 성난 외계인 년이랑 재미 좀 보도록 해. 난 나눠 먹는 거 개의치 않거든. 하지만 나중을 위해 한 조각은 남겨 줘, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = 70e0c891-4ee0-848d-f87f-c2fd63ef378f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:70e0c891-4ee0-848d-f87f-c2fd63ef378f
msgctxt "h23440da9gdbf2g483cgbee2g189339952b8a"
msgid "Let's just take things as they come."
msgstr "현실을 있는 그대로 받아들이자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 78dc6540-38de-4cc4-4da8-59ddd975e236
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_State_WaitingForSolution = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:78dc6540-38de-4cc4-4da8-59ddd975e236
msgctxt "he7abf62eg0fa4g4491g864cgdae33131105a"
msgid "I'm waiting!"
msgstr "기다리고 있다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 7a905419-d480-f60f-9c29-f56e013b962e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:7a905419-d480-f60f-9c29-f56e013b962e
msgctxt "h69e22ae9gc9feg4b18ga756ge48d5fabf664"
msgid ""
"Have your fun, but save some for me, all right? I won't be too hot to touch "
"for long."
msgstr "재미있는 시간 보내. 나중을 위해 좀 남겨 놓고, 알았지? 나라고 영영 뜨거우란 법은 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 7e4091dc-4fc4-47e9-0aac-28bc6338703d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:7e4091dc-4fc4-47e9-0aac-28bc6338703d
msgctxt "h905569c9ga7a9g4b09g82e9g5e011d40e3f7"
msgid "I'd believe you if you said one plus one is seven."
msgstr "차라리 1 더하기 1은 7이라고 하면 믿을래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 7efa105d-4b07-ba6e-4081-79ff715f84f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:7efa105d-4b07-ba6e-4081-79ff715f84f4
msgctxt "h285a29fdg4fc6g47d3g9d22gbb4e33e07941"
msgid ""
"I hope that's true. 'Cause I'm hoping for seconds, thirds, and fourths, once "
"we find a way to cool off this engine."
msgstr "그 말이 사실이어야 해. 엔진을 식힐 방법을 찾은 다음 두 번째, 세 번째, 네 번째도 기대하고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 87911173-705e-bbba-8d5c-e5015a161034
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:87911173-705e-bbba-8d5c-e5015a161034
msgctxt "hf648552bg93a8g4ff2ga714g7d2bffee4d9c"
msgid "That's the only way to take 'em, isn't it?"
msgstr "그게 현실을 있는 그대로 받아들이는 유일한 방법 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 8b850299-5f22-a4a2-8952-ed5a9a68a172
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:8b850299-5f22-a4a2-8952-ed5a9a68a172
msgctxt "h81db5396g7053g469cgac55g6c037b59ee10"
msgid ""
"I know you and hairdo girl have something happening, but keep a piece left "
"over for me, hmm? I won't always be too hot to touch."
msgstr ""
"너랑 미용실 아가씨 사이에 무슨 일이 벌어지고 있는 건 아는데, 나중을 위해 한 조각 남겨 줘, 응? 나라고 항상 뜨거운 건 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 9026ba52-0d82-a3b8-7a54-b6747b42e4fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_HelpingAboutBurningOthers = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:9026ba52-0d82-a3b8-7a54-b6747b42e4fc
msgctxt "h14eed73ag40eeg49cdg8a22g3c570116fb7f"
msgid "Mmm. I'm dizzy. And you - are you all right?"
msgstr "우움. 좀 어질어질해. 넌 어때, 괜찮아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = 9760b13b-15f7-1af5-b9fc-212e9b612c98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:9760b13b-15f7-1af5-b9fc-212e9b612c98
msgctxt "hd8579b07g399ag48c8ga901gc735c871d4ff"
msgid ""
"Mine too. Soon enough, you're going to be mine. But until then, I'll play "
"nice."
msgstr "나한테도 그래. 머지않아 널 손에 넣고 말 거야. 하지만 그때까진 얌전히 있을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = a94708d5-99cf-a5ce-ba68-792ac863b537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:a94708d5-99cf-a5ce-ba68-792ac863b537
msgctxt "hc6bfaae3g1ee4g409eg8a17gfa7fd262c1f0"
msgid "We'll have to see where we are by then."
msgstr "그럼 어디까지 괜찮은지 알아봐야겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = ab92d2a2-45ae-84e0-2ac4-b755ce03b263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:ab92d2a2-45ae-84e0-2ac4-b755ce03b263
msgctxt "h19cbf45eg1f00g4e1egbb69gb2ecdd451774"
msgid "I saw sparks - <i>actual </i>sparks."
msgstr "불꽃이 튀는 게 보였어. <i>진짜</i> 불꽃 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = cd938bd4-a24f-d421-78fe-b4aeb2a41684
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:cd938bd4-a24f-d421-78fe-b4aeb2a41684
msgctxt "hdbcff169ga830g4934gb896g57253e6ca01e"
msgid ""
"Gods, me too. That was... amazing. But it is what it is, isn't it? I may not "
"be able to have any fun, but you're still free as a lark."
msgstr ""
"맙소사, 나도 그래. 그건 정말... 놀라웠어. 그치만 사는 게 다 그렇지 뭐, 안 그래? 난 어떤 재미도 누리지 못하는 반면, 넌 "
"종달새처럼 자유롭잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = ce54dd94-a324-8237-30b9-f082cd9d843d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingAstarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:ce54dd94-a324-8237-30b9-f082cd9d843d
msgctxt "h3c113292gafc5g4546g86f6g96a4f3b86143"
msgid ""
"You have your fun with the pretty boy 'til then - I don't mind sharing. But "
"keep a piece left over for me, hmm?"
msgstr ""
"그때까지 저 기생 오라비랑 재미 좀 보도록 해. 난 나눠 먹는 거 개의치 않거든. 하지만 나중을 위해 한 조각은 남겨 줘, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = d250c704-55ba-612b-2688-6c86f1abae61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:d250c704-55ba-612b-2688-6c86f1abae61
msgctxt "h1acac53fgd169g446bg9c95g09feeb278edc"
msgid "I will, then."
msgstr "그럼 그렇게 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = e50ec7a0-5082-6dad-a69d-8e458499d0dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:e50ec7a0-5082-6dad-a69d-8e458499d0dc
msgctxt "h19def892gda97g4053ga792gc77e897e1470"
msgid ""
"<i>Very </i>coy. But don't worry - we are nothing if not free, and until I'm "
"back to my full splendour, I make no claims upon you."
msgstr ""
"이것 <i>참</i> 부끄럽네. 그치만 걱정 마. 자유 빼면 우린 시체니까. 내가 온전한 위엄을 되찾기 전까진 네게 아무것도 요구하지 "
"않을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = e84adb4e-c183-53da-3d20-e401cdf41fea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_State_WaitingForSolution = False
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:e84adb4e-c183-53da-3d20-e401cdf41fea
msgctxt "h01334418g95a6g40d6gb8b8g0117c634e405"
msgid "Oh, this is clever. Might even work. C'mere."
msgstr "오, 머리 좋은데. 통할지도 몰라. 이리 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Player
#. NodeID = f4584c80-27fb-146e-9103-d8c3934a4945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:f4584c80-27fb-146e-9103-d8c3934a4945
msgctxt "hbebc476cg2bfeg4f44g925dga6f4dcf12452"
msgid "All I can say is 'ouch'."
msgstr "'아야' 외엔 할 말이 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = f6b9daaa-957d-a648-e4ee-0d7d5197b281
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:f6b9daaa-957d-a648-e4ee-0d7d5197b281
msgctxt "h8352d997gf705g4e1eg853ag24df92ffbd8b"
msgid "You have no one but yourself - and Zariel - to blame."
msgstr "너랑 자리엘 말고 누굴 탓하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou
#. Speaker = Karlach
#. NodeID = ff71d40d-addf-a7cd-3fa7-6ccd7bfe51fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Karlach_ROM_CoolingDownForYou:ff71d40d-addf-a7cd-3fa7-6ccd7bfe51fb
msgctxt "h107eb73fgde8eg4fd8gac6eg36cdc5a32479"
msgid ""
"You have your fun with the others 'til then - I don't mind sharing, if I "
"must. But keep a piece left over for me, hmm?"
msgstr ""
"그때까진 다른 녀석들이랑 재미 좀 보도록 해. 난 나눠 먹는 거 개의치 않거든. 하지만 나중을 위해 한 조각은 남겨 줘, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_KorrillaTheSpy_Korrilla
#. Speaker = Korrilla
#. NodeID = 10d852d8-3a63-4f04-8068-d6670cec4c1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_KorrillaTheSpy_State_Talked = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_KorrillaTheSpy_Korrilla:10d852d8-3a63-4f04-8068-d6670cec4c1a
msgctxt "h16b2303cgea83g44adg9498g55476095bd3f"
msgid ""
"You and I will have time aplenty to speak - but not tonight. This night is "
"one of celebration - enjoy it while you can."
msgstr "나와는 나중에 충분히 이야기할 시간이 있을 거야. 오늘은 축하의 밤이니 즐길 수 있을 때 마음껏 즐겨 둬. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelImmobilized
#. Speaker = Lae'zel
#. NodeID = f69bbc69-5940-4e5b-ab32-177a51233bd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelImmobilized:f69bbc69-5940-4e5b-ab32-177a51233bd6
msgctxt "h04700874gfc1cg485bgba31g1ffcf742ddbc"
msgid "Think you're clever, do you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelCombatEndsDueToSpellsButWillResume
#. Speaker = Lae'zel
#. NodeID = 2cfd35f1-a7eb-44f1-8dc1-e5bbbb575384
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelCombatEndsDueToSpellsButWillResume:2cfd35f1-a7eb-44f1-8dc1-e5bbbb575384
msgctxt "hd5af1467g07abg454fgbc03g2ce5b00ff231"
msgid "Clever. But this isn't over."
msgstr "영리하군. 하지만 아직 끝나지 않았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelFirstTurn
#. Speaker = Lae'zel
#. NodeID = 6905563d-c971-e697-e496-d46ff6cfa378
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelFirstTurn:6905563d-c971-e697-e496-d46ff6cfa378
msgctxt "h8b93ffc8g9fb2g42dfga9efgb8d32e57b076"
msgid "Best me. Prove your excellence."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnAvatarHalfHealth
#. Speaker = Lae'zel
#. NodeID = 0d658449-2695-4f45-8e4a-bfdd4b0d6260
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnAvatarHalfHealth:0d658449-2695-4f45-8e4a-bfdd4b0d6260
msgctxt "h7561134fgc165g4ed5gbd65ge60f539411c8"
msgid "More. Wound me, scar me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnAvatarUsingItems
#. Speaker = Lae'zel
#. NodeID = 1b996a7d-387f-aa2f-2f76-99feb1096546
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnAvatarUsingItems:1b996a7d-387f-aa2f-2f76-99feb1096546
msgctxt "h74a11a9ag22dbg4ae1gaf28g6510bef29bce"
msgid "<i>Chk</i>. Trying to cheat? See what that gets you!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnBeingHit
#. Speaker = Lae'zel
#. NodeID = 7cabe340-bfdf-4b0d-bcec-5e00a3393ae4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnBeingHit:7cabe340-bfdf-4b0d-bcec-5e00a3393ae4
msgctxt "hb367a179g67e5g45ebga03eg1868ee86f852"
msgid "Yes. Just like that!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnHalfHealth
#. Speaker = Lae'zel
#. NodeID = 5214a5e8-1100-45b7-8e71-75cfac933f32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_LaezelRomance2_AD_LaezelOnHalfHealth:5214a5e8-1100-45b7-8e71-75cfac933f32
msgctxt "haa488894gcd20g4f9bgbea6g3b260a9732e7"
msgid "Keep it coming. Give me all you've got!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 0b1449f8-0688-300a-01e1-5249f85eb5d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:0b1449f8-0688-300a-01e1-5249f85eb5d8
msgctxt "h5c3f392dg04fcg4e5fgaf7bgc884fceff425"
msgid "But - I won't make it that long on my own."
msgstr "하지만… 그렇게 오래 저 혼자 버틸 수 있을지 모르겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Jaheira
#. NodeID = 1e03c377-efb6-4268-a37b-bd1ad630efa7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_JAHEIRA(9) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:1e03c377-efb6-4268-a37b-bd1ad630efa7
#, fuzzy
msgctxt "hd67d038ege88bg42d1g97fbg8682a7d0bf71"
msgid ""
"Of course, girl. You can help me determine who it is doing all the snoring."
msgstr "물론이지, 얘야. 야영지에서 누구 코골이가 가장 심한지 나랑 같이 알아보자꾸나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Player
#. NodeID = 1ef21cac-677c-e185-8efd-9beab9a0edd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:1ef21cac-677c-e185-8efd-9beab9a0edd2
msgctxt "h04eb570dgf5d6g40acgb18bg91c495f7f2e0"
msgid "Ugh. Fine. Get your stuff and come on in."
msgstr "어휴, 알았어. 짐 챙겨서 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Player
#. NodeID = 2264a352-0be5-cf58-56be-51922bf4bba0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:2264a352-0be5-cf58-56be-51922bf4bba0
msgctxt "hcdd2f057g3e20g4f2bg8a90g65123daa9a06"
msgid "No kids allowed. Come back in ten years."
msgstr "애들은 출입금지야. 십 년 후에 다시 오렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Player
#. NodeID = 2b3791e9-540d-4a4e-61ff-e8b6f398daec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:2b3791e9-540d-4a4e-61ff-e8b6f398daec
msgctxt "h1f20a390ga2d0g44ebg8820g5a2e12fc0580"
msgid "Of course you can stay, Yenna. Pick a spot and settle in."
msgstr "당연히 그래도 되지, 예나야. 자리 하나 골라잡고 짐을 푸렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 50ccfc9f-f76a-3420-d171-da6f89d08a56
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_State_DismissYenna = True
#.     - CAMP_Yenna_State_MovedToCamp = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:50ccfc9f-f76a-3420-d171-da6f89d08a56
msgctxt "h3220ddfdg04c0g47b0g841eg4ebfefad7507"
msgid ""
"But erm. But - all right. I'll go. But you'll see - you should've said yes. "
"You'll wish you said yes."
msgstr "그렇지만, 엄. 그렇지만 - 좋아요. 가면 되잖아요. 하지만 알게 될걸요. 날 받아줬어야 했다는 걸. 후회하게 될 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 6747c3da-c87c-4e46-8806-1009cefadc8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:6747c3da-c87c-4e46-8806-1009cefadc8c
msgctxt "h4a4e4b8ag7f51g4d8fgb29cg558974e3dbf4"
msgid ""
"I met you before. And erm. My mum hasn't come back yet. She might come "
"later... I don't think she's coming."
msgstr "예전에 봤어요. 근데 엄. 엄마가 아직 돌아오시지 않았어요. 아마 나중에 오실 거예요... 아니, 오시지 않을 거 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 71e97410-a21b-f2c8-165e-e958ed57cf91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:71e97410-a21b-f2c8-165e-e958ed57cf91
msgctxt "hdd27df22g8f57g4fe4gb3cfge174fd2115d8"
msgid ""
"You were really nice to me before. And erm. My mum hasn't come back yet. She "
"might come later... I don't think she's coming."
msgstr ""
"그땐 정말 친절하게 대해주셨어요. 그리고 엄. 엄마가 아직 돌아오시지 않았어요. 나중에 오실 거예요... 아니, 오시지 않을 거 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 7638c2d2-f50b-dd99-5b9f-4ab957efcd22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_State_InviteYenna = True
#.      - CAMP_Yenna_HasMet = True
#.      - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:7638c2d2-f50b-dd99-5b9f-4ab957efcd22
msgctxt "he7540cf8gd643g43a5gbf17gb26063899eac"
msgid ""
"I brought my own paring knife; now I just need some ingredients and... I'm "
"gonna make something really good, I promise!"
msgstr "제 전용 식칼도 가져왔어요. 이제 필요한 건 약간의 재료와... 엄청나게 끝내주는 걸 만들어줄게요, 약속해요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 77f4c5be-cf42-eb19-504a-d89117ad6ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:77f4c5be-cf42-eb19-504a-d89117ad6ff4
msgctxt "he76e9030g5b36g43b7g997ege4c217b47e1d"
msgid "Thankyouthankyou! I won't get in the way. I promise!"
msgstr "고마워요고마워요! 방해되지 않을게요. 약속해요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Nightwarden Minthara
#. NodeID = 787b83dc-ca4f-4204-840c-9e5f4f37adf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.   Tag:
#.      - REALLY_MINTHARA(11) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:787b83dc-ca4f-4204-840c-9e5f4f37adf7
msgctxt "h951d0795g4f86g49b8g8439g306ef63eb310"
msgid "I would rather share my camp with goblins again."
msgstr "차라리 다시 고블린들이랑 야영지를 같이 쓰고 말지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 7954e7e3-85fe-51c7-06b6-8bf9f0f994fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:7954e7e3-85fe-51c7-06b6-8bf9f0f994fa
msgctxt "h1589495cg26a0g40e8gac3dg9319df4e0d45"
msgid "Could I maybe stay here?"
msgstr "저 여기서 지내도 되나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = 89e6788c-c6ad-5085-8de8-e16139b6ba35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:89e6788c-c6ad-5085-8de8-e16139b6ba35
msgctxt "h7a624acbg58fcg49ffg91ceg654095eaf052"
msgid "You don't?"
msgstr "진심이예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Karlach
#. NodeID = 99eb1567-a3b8-4b13-abc5-ef0254c38383
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_KARLACH(7) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:99eb1567-a3b8-4b13-abc5-ef0254c38383
msgctxt "hd29535e9gd89ag4bb2g9babg6585461471d8"
msgid "Yes! We can play one-a-cup!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = a35415f5-3c6c-c7e9-ee84-08f85c83682d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:a35415f5-3c6c-c7e9-ee84-08f85c83682d
msgctxt "h57355ce6gd4afg4828ga084gd04fe7da56a2"
msgid "Could we maybe stay here?"
msgstr "우리 여기서 지내도 되나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Lae'zel
#. NodeID = aceead3b-2c32-4fae-bef1-b449d3dd201d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:aceead3b-2c32-4fae-bef1-b449d3dd201d
msgctxt "h2819881fg5e18g413dga483g84e10c953e80"
msgid "Ugh. Isn't there a human crèche she can join?"
msgstr "윽. 쟤를 맡길 만한 인간들의 양성소는 없는 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = acf8092f-d4df-b68d-0a10-91fad5fd9ab2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_State_InviteYenna = True
#.     - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:acf8092f-d4df-b68d-0a10-91fad5fd9ab2
msgctxt "h7c3d819fga231g4b8dgbde9gb1599f431012"
msgid ""
"YES! You've got a fire and everything. I can cook really good! Whatever you "
"want! Thankyouthankyou."
msgstr "좋았어! 여기엔 모닥불이랑 모든 게 있어요. 전 요리도 엄청 잘해요! 무엇을 원하시든 다 할게요! 고마워요고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = b0aee9af-4563-1cd5-749f-91cc19a7e26a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_HasMet = False
#.      - CAMP_Yenna_State_MovedToCamp = False
#.   Object:
#.      - WYR_MeetingYenna_State_LessKindPath(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:b0aee9af-4563-1cd5-749f-91cc19a7e26a
msgctxt "hbbfea165g8f14g404dgb791g80b3d279f988"
msgid "Erm. Hi. It's me. Yenna. You remember me, right?"
msgstr "엄. 안녕하세요. 저예요, 예나. 기억하시죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Wyll
#. NodeID = c99efa72-2e94-4595-a6ce-52fc7cee5f60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:c99efa72-2e94-4595-a6ce-52fc7cee5f60
msgctxt "h3213f23age15dg46a2gb44fged56f955f0dc"
msgid "It isn't much of a home, but what's ours is yours."
msgstr "편한 잠자리는 아니지만, 여기를 너희 집처럼 생각하렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = cca1ec4f-0cdd-ca90-a963-01be76984367
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_State_InviteYenna = True
#.     - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:cca1ec4f-0cdd-ca90-a963-01be76984367
msgctxt "h4c5e6255g1553g4fbfg881fg6ddc26789f44"
msgid "I don't have any stuff. But I can cook!"
msgstr "가진 건 없지만… 요리는 할 수 있어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Shadowheart
#. NodeID = d71b3dd1-fc5d-48b2-bd73-0f436e7b2761
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:d71b3dd1-fc5d-48b2-bd73-0f436e7b2761
msgctxt "hd24f26a5g4613g4e62g8ad1g4146d016f3f8"
msgid ""
"What harm? She's little - won't take up much space, or make much of a dent "
"in our provisions."
msgstr "안될 거 있어? 작은 아이잖아. 공간을 많이 차지하지도 않을 거고, 식량을 다 먹어 치우지도 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Player
#. NodeID = db666a09-378e-ff03-1248-1597ae945107
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:db666a09-378e-ff03-1248-1597ae945107
msgctxt "h095b50f8g5589g4ad8gb8a5g0ece8ddbc6bc"
msgid "I already told you no - I meant it."
msgstr "안 된다면 안 되는 줄 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Gale
#. NodeID = def58cd6-c395-4551-8596-e071ed03fffa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:def58cd6-c395-4551-8596-e071ed03fffa
msgctxt "h9e715cf4g5e89g4949gbddfg65f7c3e26f15"
msgid ""
"If the child's desperate enough to seek safety in our company, who are we to "
"turn her away?"
msgstr "안전해지기 위해 우리한테까지 손을 내밀 만큼 절박했나 본데, 그런 애를 외면하면 쓰나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Astarion
#. NodeID = e8059c62-4766-4c12-82fe-184b8ff0b689
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:e8059c62-4766-4c12-82fe-184b8ff0b689
#, fuzzy
msgctxt "h788a8010g2aedg4233gab3dg2d6d55a00242"
msgid "Absolutely not. We've hit our quota for mangy strays."
msgstr "절대 안 돼. 지저분한 길고양이는 이제 충분하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Minsc
#. NodeID = efedd2f8-38dd-412d-a637-5e78a43342c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_MINSC(10) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:efedd2f8-38dd-412d-a637-5e78a43342c9
msgctxt "hca7ce038g313dg490eg9644gd7afaa939815"
msgid ""
"Of course! Boo could use an extra friend to play 'chase the Boo', seeing as "
"none here are quick enough."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Halsin
#. NodeID = f0718bf2-ee5e-4489-8edc-d75cb0694d82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_HALSIN(8) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:f0718bf2-ee5e-4489-8edc-d75cb0694d82
msgctxt "h5b1e47bfg01deg4dd5g817cg69e225010a87"
msgid ""
"Only a truly callous heart could refuse. Besides, our little abode could use "
"a child's laughter."
msgstr "여기서 거부하는 건 너무 냉담하겠지. 게다가, 이 작은 거처에 아이의 웃음소리 정도는 있어도 괜찮지 않겠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Yenna
#. NodeID = f8bdd184-3c2e-19eb-da82-259181314232
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Yenna_HasMet = False
#.      - CAMP_Yenna_State_MovedToCamp = False
#.   Object:
#.      - WYR_MeetingYenna_State_KindPath(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:f8bdd184-3c2e-19eb-da82-259181314232
msgctxt "h9c801e82g6352g4803g9449g74e5d7fae236"
msgid "Erm. Hi. It's me. Yenna. You remember me, right?"
msgstr "엄. 안녕하세요. 저예요, 예나. 기억하시죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna
#. Speaker = Player
#. NodeID = ff41c04e-210b-67cb-138e-ec40b97f55d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_InviteYenna:ff41c04e-210b-67cb-138e-ec40b97f55d6
msgctxt "haf923e34gc887g49e0g9995gfb01452e201e"
msgid "Sorry, kid. I don't think so."
msgstr "미안 꼬맹아. 그렇게는 안될 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 013bd1cf-1579-4658-94f1-130f50a58898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:013bd1cf-1579-4658-94f1-130f50a58898
msgctxt "h0c120477g15e3g4f9bg8918g81186c2b43c3"
msgid "I'll keep it hot for you!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Player
#. NodeID = 1339d3c0-9ffa-4eaf-bd41-e6f5518a0d63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:1339d3c0-9ffa-4eaf-bd41-e6f5518a0d63
msgctxt "hf76a2426g0656g4c7dg8c9dg62586a940b45"
msgid "Not now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 15207086-233c-45eb-b7d7-cf0b15f41d72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Yenna_HasMet_PostAbduction(1) = False
#.   Global:
#.      - CAMP_Yenna_State_MovedToCamp = True
#.      - LOW_BhaalTemple_State_WasAbductedYenna = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Yenna_HasMet_PostAbduction(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:15207086-233c-45eb-b7d7-cf0b15f41d72
msgctxt "hcb0f9f0eg0521g4dadg8258gdd6f73fd7691"
msgid "That was so scary. Oh my gods."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 25f8e482-fe4e-ad00-694b-bfbc1cceba06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:25f8e482-fe4e-ad00-694b-bfbc1cceba06
msgctxt "h116d6954g4440g4171gb9f8g285cfe18e42e"
msgid "I can't believe what happened to Grub. He was my best friend."
msgstr "그럽이 그렇게 됐다니 말도 안 돼요. 가장 친한 친구였는데…"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Player
#. NodeID = 359692a3-7de2-d11d-9122-8e541772b850
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:359692a3-7de2-d11d-9122-8e541772b850
msgctxt "hb4ad91c4gb39bg412ag84b6gf8a8067ee5f3"
msgid "You can stay. But stay out of my way."
msgstr "함께해도 되긴 한데, 내 발목 잡지는 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 38d4aa95-44d6-9414-8e29-40e4adfc909b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:38d4aa95-44d6-9414-8e29-40e4adfc909b
msgctxt "h600182d0g512dg42c1gbb74gb550ad618521"
msgid ""
"I will! I won't bother you. I'll be real quiet. And I'll cook loads! Thank "
"you!"
msgstr "알았어요! 방해 안 할게요. 완전 얌전하게 지내고, 요리도 잔뜩 할게요! 고마워요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Player
#. NodeID = 3c631176-a9d1-41f0-85b6-63b562009b92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:3c631176-a9d1-41f0-85b6-63b562009b92
msgctxt "hcce5a3efg9323g4d8bgbdd1gf377638e8ded"
msgid "Not now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 3fa11271-338f-45e0-82d7-3e5b54be1855
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Yenna_HasMet_PostAbduction(1) = True
#.   Global:
#.      - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:3fa11271-338f-45e0-82d7-3e5b54be1855
msgctxt "ha66b9163gafc6g4d39gb436g67e9b05e9059"
msgid "I. Erm. I made soup! Want some?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 49c8618c-6f99-4b92-a6f4-9dbfdf356cd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Yenna_HasMet_PostAbduction(1) = False
#.   Global:
#.      - CAMP_Yenna_State_MovedToCamp = False
#.      - LOW_BhaalTemple_State_WasAbductedYenna = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_Yenna_HasMet_PostAbduction(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:49c8618c-6f99-4b92-a6f4-9dbfdf356cd8
msgctxt "h8018899eg3ce0g4eedgb401g740366d71794"
msgid "Please, can I stay here? I don't want to be alone."
msgstr "저, 여기 있으면 안 될까요? 혼자가 되긴 싫어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 57341005-933f-4f94-ab97-0500b6ebde6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:57341005-933f-4f94-ab97-0500b6ebde6f
msgctxt "h0e379eaag60a4g4a58g9f51g0704795d0ecf"
msgid ""
"Yesss! I mean - thank you! Thank you so much! I promise to cook up loads. "
"And be really good!"
msgstr "좋았어! 아니… 고마워요! 정말 고마워요! 요리 잔뜩 해드릴게요. 완전 맛있게요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 5d4cc691-e4b5-4ff8-9965-b4d4da4e80b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:5d4cc691-e4b5-4ff8-9965-b4d4da4e80b5
msgctxt "hbd39efffgd268g49c4g8037gfd24016d4617"
msgid "I - I promise to pull my weight."
msgstr "제… 제 몫은 할게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Player
#. NodeID = 66a521d5-5984-4030-a847-e5c3e67c8c90
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_State_DismissYennaPermanently = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:66a521d5-5984-4030-a847-e5c3e67c8c90
msgctxt "h28bc4a0cgeb28g43a8g8379g68e9f6853264"
msgid "No - you're on your own, kid."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 8be3f51a-44c2-431d-9e7c-7fe986f34b51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:8be3f51a-44c2-431d-9e7c-7fe986f34b51
msgctxt "h496de694g3eb5g4774g9d55g1a364bdaca8c"
msgid "Oh. All right. Erm. I'll go but. Well. Bye."
msgstr "오. 알았어요. 음. 갈게요, 네… 잘 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Player
#. NodeID = 969fb725-9a6a-4782-9582-500728d98bb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:969fb725-9a6a-4782-9582-500728d98bb8
msgctxt "hb031773fge83fg4c6bg9605gaaab62fbcce6"
msgid "Sure."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = 98b53f30-789a-499b-8573-04f1e9959339
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:98b53f30-789a-499b-8573-04f1e9959339
msgctxt "h01d21a4bg4aa8g4f8ag87f2g67f1ee3c26e7"
msgid "Slurp happy!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Player
#. NodeID = ac19c7c9-b326-4a3c-a904-9712114c48ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:ac19c7c9-b326-4a3c-a904-9712114c48ac
msgctxt "h28cd81aag4f5dg40a4g9871g8961a215fa4d"
msgid "Sure - let's see what you've got."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = b0652615-6764-3ce8-1bb8-2a10b62f619e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:b0652615-6764-3ce8-1bb8-2a10b62f619e
msgctxt "h3a25c368g8d81g4a34g9027g89dd311a0489"
msgid "Now that Grub is gone, I don't got anyone."
msgstr "그럽이 떠나버린 지금, 제 곁에는 아무도 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Player
#. NodeID = bb63d2c9-50cd-4115-9ad4-814b02dd681a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Yenna_State_MovedToCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:bb63d2c9-50cd-4115-9ad4-814b02dd681a
msgctxt "h020bd3dbgc891g4c32ga616g3aae7ed3e249"
msgid "Of course you can stay."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor
#. Speaker = Yenna
#. NodeID = d6c149c7-e455-44de-bbfb-9ba5543d3144
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MeetingYenna_SoupVendor:d6c149c7-e455-44de-bbfb-9ba5543d3144
msgctxt "h13f04a59g9babg4e7bgb341ga5bd237b8a47"
msgid "But we're back now. Safe. And we can have soup! I made it. Want some?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Minsc
#. NodeID = 2bed42b2-492a-4461-8186-34b32baca935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:2bed42b2-492a-4461-8186-34b32baca935
msgctxt "h2075041bgfc7cg482egb9a2ga9b6c5fba885"
msgid ""
"Of course! Eh... it is the name of one of those thick histories you have "
"given Minsc to read, yes?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Minsc
#. NodeID = 02d39d65-1bc7-48a0-bbd3-d5f6bb693872
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:02d39d65-1bc7-48a0-bbd3-d5f6bb693872
msgctxt "hfbf5cc29g8d1ag477dg8973g8ed2feb3288f"
msgid ""
"Of course, Jaheira! I <i>think </i>they have something to do with "
"<i>illithids.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Minsc
#. NodeID = 30685b1b-9c7c-4689-b772-67f2177e30c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - fd448082-4fcc-464c-ddbd-36fc870b4213_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:30685b1b-9c7c-4689-b772-67f2177e30c0
msgctxt "h5a9e868eg214eg4f80gae4bgd4e4a7ae52d1"
msgid ""
"Jaheira, Minsc has been thinking, and Boo agrees - you are owed an apology."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Jaheira
#. NodeID = 14f07edf-4096-4992-8f66-10e2b71e9f0e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3b6c4c4c-75ef-abdd-522c-7ea54e244393_A = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:14f07edf-4096-4992-8f66-10e2b71e9f0e
msgctxt "h21383ba4g58b8g421cg85dag145f93f6a6fc"
msgid "You can point that smug little smile somewhere else, for a start."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Jaheira
#. NodeID = 535ea26a-41d8-42f8-8832-2095c2c3a2c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:535ea26a-41d8-42f8-8832-2095c2c3a2c4
msgctxt "h138d2ee5gdd4fg4854gb03cgb33091c6470d"
msgid ""
"I know, old friend. They made a poor imitation at me, bossing you around."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Minsc
#. NodeID = 68c21eff-aada-2ae4-2f0f-29fe62219322
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:68c21eff-aada-2ae4-2f0f-29fe62219322
msgctxt "h3de7cdabg549ag4caeg987bg280c7b1de824"
msgid ""
"Oh, no. I speak of how they sealed Boo away, so that he would not remind me "
"of the man he has taught me to be."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Minsc
#. NodeID = 738ec7d0-c1bb-3a94-c804-3b6923a954ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:738ec7d0-c1bb-3a94-c804-3b6923a954ec
msgctxt "h5c0180b6g81e5g4f54g928fgaf3af8318c0d"
msgid "B-but - <i>you</i>, too, are important to Minsc!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Jaheira
#. NodeID = b9d1b58a-a6d6-4673-a2d0-7048bcdec7d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fd448082-4fcc-464c-ddbd-36fc870b4213_A = True
#. SetFlags:
#.   Local:
#.     - fd448082-4fcc-464c-ddbd-36fc870b4213_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:b9d1b58a-a6d6-4673-a2d0-7048bcdec7d9
msgctxt "haa02a670gebaeg4802gbe0dgd446eadd0140"
msgid ""
"The <i>problem</i>, ranger, is that you <i>charged in at all. </i>We didn't "
"even know what we were dealing with!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Jaheira
#. NodeID = aa7318e4-22e4-4cdf-bc05-aba062223915
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b6c4c4c-75ef-abdd-522c-7ea54e244393_A = True
#. SetFlags:
#.   Local:
#.     - 3b6c4c4c-75ef-abdd-522c-7ea54e244393_B = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:aa7318e4-22e4-4cdf-bc05-aba062223915
msgctxt "hd4f350a2g4890g4c4dga5a2g3c7955d93434"
msgid ""
"Do not get too comfortable just yet. I will want a <i>full </i>report - "
"everything you learned during your time with the cult."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Jaheira
#. NodeID = be1d64b4-d7ff-443d-bf59-83518551465d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:be1d64b4-d7ff-443d-bf59-83518551465d
msgctxt "h56edc83dg7f22g4c7fgaf93g9360aeaca53a"
msgid ""
"Oh...? I will admit, that is unexpected. Your capture by the cult has taught "
"you something, then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Minsc
#. NodeID = b33637f0-5f8d-4427-872b-eda0f5252d37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:b33637f0-5f8d-4427-872b-eda0f5252d37
msgctxt "h976886fcg3d95g45d3g8f1fgf0816f94be39"
msgid "Ah, forgive me, Jaheira. But it is just so good to be together again!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Jaheira
#. NodeID = ba575c69-993f-e55d-b086-4c2a9aacb471
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:ba575c69-993f-e55d-b086-4c2a9aacb471
msgctxt "h4c7d1047g0a1ag4e89gba4cg62d7a5c72157"
msgid "I was talking to Boo."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Jaheira
#. NodeID = cf3ec13f-3c4e-45ab-ce75-1e10fa5a6e28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:cf3ec13f-3c4e-45ab-ce75-1e10fa5a6e28
msgctxt "haa1ccd3fgd6d5g4844ga3ecg11db47b2f7e2"
msgid ""
"Too late. But don't worry, I shall try to sob into a pillow tonight so as "
"not to wake the entire city."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Jaheira
#. NodeID = e06feae6-dc7b-f98a-a242-1b61df787bf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:e06feae6-dc7b-f98a-a242-1b61df787bf5
msgctxt "had632b7fg9641g4f0egb507gf5f58a83a060"
msgid "...I'll ask the hamster."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Minsc
#. NodeID = f8118ecc-06a3-4132-8d7e-a5253ffbbd15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fd448082-4fcc-464c-ddbd-36fc870b4213_B = True
#. SetFlags:
#.   Local:
#.     - fd448082-4fcc-464c-ddbd-36fc870b4213_C = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:f8118ecc-06a3-4132-8d7e-a5253ffbbd15
msgctxt "ha0fdf491g5927g4336g95e3gb0883bb39dc2"
msgid ""
"You have found fine companionship while we were apart. It is no common soul "
"with the strength of arms to best Minsc in combat."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion
#. Speaker = Minsc
#. NodeID = ff94253b-76f7-4f7d-a512-c71e1de0c936
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b6c4c4c-75ef-abdd-522c-7ea54e244393_B = True
#. SetFlags:
#.   Local:
#.     - 3b6c4c4c-75ef-abdd-522c-7ea54e244393_A = False
#.     - 3b6c4c4c-75ef-abdd-522c-7ea54e244393_B = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PostReunion:ff94253b-76f7-4f7d-a512-c71e1de0c936
msgctxt "h1dfdcbb9gec02g49eag8d9egb20e47fa70c3"
msgid ""
"Jaheira... I <i>am</i> sorry that I was so easily blinded. There was more "
"than the tadpole to the cult's manipulations of Minsc."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Jaheira
#. NodeID = 27412fc6-262d-2794-5dd5-0bd84ff5f674
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:27412fc6-262d-2794-5dd5-0bd84ff5f674
msgctxt "hddc0ac85g4a40g459cg9f3age1b15e6a19bd"
msgid "Cover the hamster's ears. I'm going to scream."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Minsc
#. NodeID = 3881e62a-5f08-362c-c3cc-068384f51027
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:3881e62a-5f08-362c-c3cc-068384f51027
msgctxt "h04a268fbg4649g4716g83e8g9c1dc95e54af"
msgid ""
"Yes. Minsc should have charged in all the sooner - and brought a second "
"sword, so that he might have cut all his captors down in one blow!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Jaheira
#. NodeID = 3a96902f-da81-4da5-905f-c07b5a723fc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:3a96902f-da81-4da5-905f-c07b5a723fc3
msgctxt "h569a5229gd1a1g4d96g825bgd6789e993a63"
msgid ""
"Why don't you sidle up to the fire. Sit in it, for all I care - though leave "
"Boo aside first."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Jaheira
#. NodeID = 52e47f72-5ff5-5128-4b2f-72f7ad16d23e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:52e47f72-5ff5-5128-4b2f-72f7ad16d23e
msgctxt "h6dc317aegac55g4bbcga743g4582ebba00a2"
msgid "Yes. And I begin to wonder if I was not over-hasty."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Minsc
#. NodeID = 63779f1a-c921-b23b-29c4-8b06f58d2896
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:63779f1a-c921-b23b-29c4-8b06f58d2896
msgctxt "h3ead3297gfd62g4ba2gbee3g440d09dd90fc"
msgid ""
"Or the strength of heart, to take his hand in friendship afterwards! Though "
"I think this perhaps had something to do with you, yes?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Minsc
#. NodeID = 7c6fd145-fafc-adbb-8475-d634f3aefde0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:7c6fd145-fafc-adbb-8475-d634f3aefde0
msgctxt "ha1e8024cg26adg487aga780gade842c1b18d"
msgid ""
"Wait. Wait. Jaheira, wait. Boo suggests... that you are <i>unhappy</i> about "
"something...?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Jaheira
#. NodeID = ea84716b-4805-1ddc-7b2b-b97caa5dfeef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:ea84716b-4805-1ddc-7b2b-b97caa5dfeef
msgctxt "h6bd65e5dga976g4acfga472g503ede7c4bc1"
msgid ""
"We have discussed matters like this before. You recall what the better part "
"of valour is...?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion
#. Speaker = Minsc
#. NodeID = f07a5118-ec47-4b14-8d98-b382ed7a1db9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fd448082-4fcc-464c-ddbd-36fc870b4213_C = True
#. SetFlags:
#.   Local:
#.     - fd448082-4fcc-464c-ddbd-36fc870b4213_C = False
#.     - fd448082-4fcc-464c-ddbd-36fc870b4213_B = False
#.     - fd448082-4fcc-464c-ddbd-36fc870b4213_A = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MinscJaheira_PAD_PreReunion:f07a5118-ec47-4b14-8d98-b382ed7a1db9
msgctxt "hfd0f2bc6gb29eg422agb6c6g1b2aaf50bf1c"
msgid ""
"Now! Where is it you lay your head, so Minsc and Boo may find a spot nearby?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 00fa8e9e-c7aa-0a71-39b6-8f971c3778ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:00fa8e9e-c7aa-0a71-39b6-8f971c3778ab
msgctxt "h5a812f3dg0249g4c2agbbecg42a0893ba8d1"
msgid "Then you should have killed me rather than saving me."
msgstr "그럼 넌 나를 구하는 대신 목을 비틀었어야 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 03212a9e-0c96-c47d-93b7-1298d273c51b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:03212a9e-0c96-c47d-93b7-1298d273c51b
msgctxt "hd12f1b81ga5e4g4401gaf33g80e144bdebbf"
msgid "I intend to cause plenty, but only for our enemies."
msgstr "말썽이야 부릴 만큼 부려주지. 단 우리의 적들에게 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 056e11c1-9aa8-4e3d-026c-c9cc432ff3cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:056e11c1-9aa8-4e3d-026c-c9cc432ff3cf
msgctxt "h9ffe0162g53c2g43d8ga1d4g6ef9c666287e"
msgid ""
"But it was not the Prism that held me, and touched my mind and body. "
"<i>That</i> was you."
msgstr "그렇지만 그때 내 정신과 육체를 어루만지던 건 프리즘이 아니야. <i>그건</i> 너였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 06d82dc4-97a2-891f-5bd5-688f91cac72a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:06d82dc4-97a2-891f-5bd5-688f91cac72a
msgctxt "h8b6b6b9ega983g4829g8562g50cfc12be7c6"
msgid "Kind words do not always come easily to me..."
msgstr "상냥한 말에는 익숙해지지 않는군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 074b639a-e361-f81d-8b04-e4a3206dc419
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - OriginAddToParty(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:074b639a-e361-f81d-8b04-e4a3206dc419
msgctxt "hef2c2865g1b6bg45b2g80d6gf3ca2093c34e"
msgid "Excellent. Let us teach the cult to fear <i>us</i>."
msgstr "훌륭해. 이 광신도들에게 왜 우리를 두려워해야 하는지 가르쳐 주자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 0798c79a-c7dd-d537-d3af-afe9d8709d7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Quest_MistressOfSouls = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:0798c79a-c7dd-d537-d3af-afe9d8709d7b
msgctxt "hc4a97307ge494g425agbf35g5b8dc2d53188"
msgid ""
"<i>Someone </i>in this cult might have broken mine, too. We are going to "
"break them back."
msgstr "이 사이비 집단의 <i>누군가</i>가 내 정신도 파괴했을지도 몰라. 이젠 우리가 녀석들을 파괴하러 가자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 07a8e3f2-fc9d-016b-d1b6-f34dbb9ccaa8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:07a8e3f2-fc9d-016b-d1b6-f34dbb9ccaa8
msgctxt "h1ed9ce5ege21fg487fg9eedg3ca1e4077711"
msgid "You <i>monster</i>."
msgstr "이 <i>괴물</i> 새끼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 07dd0cc8-5a70-657f-7c70-00bb602c60de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:07dd0cc8-5a70-657f-7c70-00bb602c60de
msgctxt "he6feda96gf0f6g47dcg929eg562945057648"
msgid "As you wish."
msgstr "네가 바란다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 0d3d8de6-7b01-c7c1-8730-dc9cc9353713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:0d3d8de6-7b01-c7c1-8730-dc9cc9353713
msgctxt "hbc62558fg0c53g438dgb050gd0f96b30a01b"
msgid "They broke my mind."
msgstr "그들이 내 정신을 파괴했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 14a59386-66af-bbf7-2359-5dcf7f6b92b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_MaxPlayerCountReached = True
#. SetFlags:
#.   Global:
#.     - GLO_Tutorials_FullPartyRejection = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:14a59386-66af-bbf7-2359-5dcf7f6b92b6
msgctxt "h0bd5165dgdea6g4397g9f60g948051e56cf6"
msgid "I don't have room for you at the moment."
msgstr "지금은 자리가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 175881f4-688a-a55e-2d97-e58bc36fe016
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:175881f4-688a-a55e-2d97-e58bc36fe016
msgctxt "h6234f346g44abg4f43g9b2ag35e945cbcf48"
msgid ""
"Moonrise is a den of necromancy, and the most powerful practitioner of the "
"art is Thorm's closest advisor, Balthazar."
msgstr "문라이즈는 사령계의 아지트야. 그 중 가장 강력한 사령술을 부리는 이는 쏨의 오른팔, 발타자르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 1776aefa-b2fe-b1cd-fed3-1787408ae756
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:1776aefa-b2fe-b1cd-fed3-1787408ae756
msgctxt "h4697674agbfe0g4f29gb158g9cfb90fd0f45"
msgid ""
"I knew you were different to other True Souls when we met, but I could see "
"nothing clearly."
msgstr "처음 만났을 때, 네가 다른 참된 영혼과는 다르다는 걸 알았지만, 왜 그런지 정확하게는 알 수 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 17ef905d-1259-d847-a7b9-420337855c28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:17ef905d-1259-d847-a7b9-420337855c28
msgctxt "h18713498ga0d3g4299g89a5g9c8d95237c7b"
msgid "Precisely."
msgstr "맞는 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 18cde666-dbfa-cc3c-c8a3-804070fa1e5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:18cde666-dbfa-cc3c-c8a3-804070fa1e5e
msgctxt "h6af2c5b5g66e9g4764gbc8cg5c392e974cd3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 1dec3fec-7ec0-ba90-15c8-07407ece45d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:1dec3fec-7ec0-ba90-15c8-07407ece45d1
msgctxt "h84f1be4dg8fd2g4138ga517gdc2044d74cc0"
msgid "I would rather die."
msgstr "그렇게 되느니 차라리 죽음을 택하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 23a8cb52-10f1-ea6e-4252-d618064d4c44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_HadSexWithMinthara(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:23a8cb52-10f1-ea6e-4252-d618064d4c44
msgctxt "h95a836f2gd617g49cag9ce9ga43aa2191c6d"
msgid ""
"I knew you were different to other True Souls when we lay together. Now I "
"know it was the Prism that silenced the Absolute in those moments, not you."
msgstr ""
"너와 잠자리에 들었을 때 네가 다른 참된 영혼과는 다르다는 걸 알았어. 이제는, 그때 절대자를 침묵시킨 것이 네가 아니라 프리즘이었다는 "
"걸 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 23b313e3-eb8d-cbcf-9100-dc416665a189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:23b313e3-eb8d-cbcf-9100-dc416665a189
msgctxt "h06ea19a1g33e5g4567gaa44ge31f758b2771"
msgid "I won't let that happen."
msgstr "그렇게 두진 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 2a493910-40e4-be49-0d32-f46a7b3ec7d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:2a493910-40e4-be49-0d32-f46a7b3ec7d7
msgctxt "h085537afgdb2ag4ce7gb681g42999942f7c5"
msgid "Then make room. None among your allies can compare to me."
msgstr "그럼 자리를 만들어. 네 동료 중 아무도 나에 비할 자는 없을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 2a65b60d-f3ed-188a-10a6-9393b2a130a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:2a65b60d-f3ed-188a-10a6-9393b2a130a3
msgctxt "hf3f7e5edgb153g46feg9de7g4e6e14c73a57"
msgid "That's in the past."
msgstr "그건 과거일 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 2a8614ee-3f0d-4463-db0a-ee57f5c56f76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:2a8614ee-3f0d-4463-db0a-ee57f5c56f76
msgctxt "h706e1b9agfce1g4ecdg8611g11eea3c8b245"
msgid "I can help you fix it."
msgstr "회복할 수 있도록 내가 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 2df55d5d-399a-263d-5ed1-d4f3bb8755b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:2df55d5d-399a-263d-5ed1-d4f3bb8755b1
msgctxt "h86a75cbdg0609g4eaeg8cc2gd20fa2b92629"
msgid "Of course. You'll be a valuable ally."
msgstr "당연하지. 넌 귀중한 아군이 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 2e9bc2ac-0ae6-4fd5-2653-2da4cb8cdf2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:2e9bc2ac-0ae6-4fd5-2653-2da4cb8cdf2a
msgctxt "hfa4b1f87g5839g4f92g8d63gdb66311edc2c"
msgid "We must find the necromancer, and claim what he seeks. Or destroy it."
msgstr "일단 그 사령술사를 찾아서, 그가 찾으려 하는 걸 손에 넣어야 해. 아니면 파괴하거나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 31963109-f07e-37f5-f602-b7f4407fd160
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:31963109-f07e-37f5-f602-b7f4407fd160
msgctxt "hf9feee6cg8fb8g4cf1gaad9gd887db9d488f"
msgid ""
"Now, thanks to the Prism, the Absolute does not cloud my thoughts at all. I "
"see that together, we can have our vengeance on those who infected us."
msgstr ""
"지금은 프리즘 덕분에 절대자가 더 이상 내 정신을 휘젓지 못하고 있어. 함께라면 분명 우리를 감염시킨 것들에게 복수할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 343ff0a5-84c2-2d51-4d77-193dadba119d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - ORI_Minthara_HasMet_RecruitmentHasMet(1) = True
#.   Tag:
#.      - AVATAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:343ff0a5-84c2-2d51-4d77-193dadba119d
msgctxt "h3f191c0agdf7ag4399gbd17g179cc02c1ada"
msgid "I am ready to join you in battle, if you have space in your ranks."
msgstr "일행에 자리가 난다면, 언제든지 전투에 참여할 준비가 되어 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 395e259f-c903-1e8d-82b1-9df81db5e435
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:395e259f-c903-1e8d-82b1-9df81db5e435
msgctxt "h3a66209cg0f6bg44deg80dbg8072c8c0e046"
msgid ""
"When we lay together, I was myself for the first time since they butchered "
"my mind."
msgstr "너와 잠자리에 들었을 때, 난 그들이 내 정신을 산산조각 낸 이후 처음으로 내 자신일 수 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 3a966e1c-7f8a-147a-f73e-5b237bbecd0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:3a966e1c-7f8a-147a-f73e-5b237bbecd0f
msgctxt "h01c1fd3dgb4d0g4c58g8cc0g9d39010224d3"
msgid ""
"If I leave your side, the Prism will no longer protect me, and I will cease "
"to be Minthara. The Absolute will make me its puppet again."
msgstr ""
"내가 네 곁을 떠난다면, 프리즘이 더 이상 날 보호하지 않을 테고, 민타라로서의 난 끝이겠지. 절대자가 나를 다시 꼭두각시로 만들 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 3b68d38a-4bc4-bf68-23af-8dd8735c3512
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:3b68d38a-4bc4-bf68-23af-8dd8735c3512
msgctxt "h8ea5d6efge750g455cg9028g038eb6e7f453"
msgid ""
"We have the same goal, and you have a better chance of achieving it with me "
"at your side."
msgstr "우리는 목적이 같잖아, 그리고 내가 네 편이라면 목적을 이룰 확률이 올라갈 테고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 424714b9-95f7-3106-b697-36a00ee3f5ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:424714b9-95f7-3106-b697-36a00ee3f5ad
msgctxt "hf99e4626gea96g4492g9178ge6f3ccb0acec"
msgid "Sleep well. We will venture forth together come morning."
msgstr "잘 자. 아침이 오면 같이 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 529fef37-9d7b-89c4-4ebb-5309adb11809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:529fef37-9d7b-89c4-4ebb-5309adb11809
msgctxt "h129efbd8gfc7ag4d43g9c2ag368602e76930"
msgid "Together we can have our vengeance on those who infected us."
msgstr "함께라면 우리를 감염시킨 녀석들에게 본때를 보여 줄 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 5435baa7-aaac-fab9-129b-36c5c25a68ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:5435baa7-aaac-fab9-129b-36c5c25a68ae
msgctxt "h9745cad7gcaa2g4902g9125g40aa44fa7903"
msgid ""
"Thank you. For allowing me to come here, and for bringing me back to myself."
msgstr "고마워. 날 여기로 받아들여 줘서, 그리고 나 자신을 되찾게 해 줘서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 56b3691a-08f4-9623-a98f-cab8909b7790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:56b3691a-08f4-9623-a98f-cab8909b7790
msgctxt "h233a662dg15b7g481dg9555g17cb3fc43781"
msgid "Broken minds can heal just as well as broken bones."
msgstr "부서진 정신은 뼈만큼이나 빨리 나을 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 56be3571-7c68-a646-7360-6ad54c67a1fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#.   Tag:
#.      - AVATAR(1) = True
#. SetFlags:
#.   Dialog:
#.     - ORI_Minthara_HasMet_RecruitmentHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:56be3571-7c68-a646-7360-6ad54c67a1fb
msgctxt "h0810cbeegbc51g4caagbe91g40add2ccf0ce"
msgid ""
"It does not compare with the comforts of home, but your camp is almost "
"palatial in comparison to my previous accommodation."
msgstr "집의 안락함에 비할 바는 못되지만, 적어도 내가 전에 지내던 곳과 비교하면 네 야영지는 궁궐 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 582bdf56-40d1-d20f-7bed-aac4ce8c98eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:582bdf56-40d1-d20f-7bed-aac4ce8c98eb
msgctxt "h2066daf9g9bf0g46a6g8476g9275e15daf46"
msgid "I'm glad you're with me."
msgstr "네가 내 곁에 있어서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 5d07f4f2-77df-0d83-7fc7-cc65d8f87e2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:5d07f4f2-77df-0d83-7fc7-cc65d8f87e2d
msgctxt "h8dc53753g7490g41d1g932fg1656e1d40bef"
msgid "<i>Straj.</i>"
msgstr "<i>스트라지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 5e1f65a7-9c3d-4a0c-d2dc-9ba4f901744f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:5e1f65a7-9c3d-4a0c-d2dc-9ba4f901744f
msgctxt "heed9066bg38bag4c83ga2deg542e45b6b550"
msgid "It is the safest place to be."
msgstr "이 세상에서 가장 안전한 장소지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 622290d2-ac86-e036-6826-913c5e510b45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:622290d2-ac86-e036-6826-913c5e510b45
msgctxt "he4936226gefdfg4e08ga308g94af33e20f7d"
msgid ""
"General Thorm would have the world believe that his invulnerability is a "
"gift from the Absolute."
msgstr "쏨 장군은 자신의 불사력이 절대자가 내린 선물이라고 모두가 믿게 만들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 65a797b7-a4aa-b520-afd8-fc4654ee0cf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:65a797b7-a4aa-b520-afd8-fc4654ee0cf5
msgctxt "h71c60c82ge6d0g493cga692g085e91401785"
msgid "Then you shall die."
msgstr "그럼 죽든가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 673bd976-7647-d528-fd1c-332f5d083de2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:673bd976-7647-d528-fd1c-332f5d083de2
msgctxt "hf29336c2gea2bg4e8egb3dbg3e801d623876"
msgid "You're a victim of the cult. Of course I'll protect you."
msgstr "넌 광신도들의 희생자야. 당연히 너를 보호하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 67cc9b10-dc94-7277-d4f5-604bdb5313e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:67cc9b10-dc94-7277-d4f5-604bdb5313e8
msgctxt "h132026ccgd034g4332g8cf1g029d6ecb836a"
msgid "There is no 'we'. I rescued you, but now you're on your own."
msgstr "여기에 '우리'란 없어. 내가 널 구했어. 이제는 네 앞가림을 할 시간이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 6a032dd2-d0d6-4010-c559-af0ba2d1ec0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:6a032dd2-d0d6-4010-c559-af0ba2d1ec0d
msgctxt "hb9490779g4805g4fb9g90c6g32d205a713dd"
msgid "I'll be watching you - don't cause any trouble."
msgstr "지켜보고 있을 거야 - 말썽부리지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 6e8cc005-3da3-6b31-01a0-ec92efd5282c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:6e8cc005-3da3-6b31-01a0-ec92efd5282c
msgctxt "h148219f5g1dc8g4675g9514g14f832c307df"
msgid "I don't trust you enough to feel safe around you."
msgstr "네 가까이서 안전하다고 느낄 정도로 신뢰하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 6f5c7574-de92-3cf7-bfbc-b2f19b9edecb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:6f5c7574-de92-3cf7-bfbc-b2f19b9edecb
msgctxt "h51dd25dfgc0c8g4216gb6fcgc0448ac21c31"
msgid "Stay with me - you'll be a valuable ally."
msgstr "내 옆에 있어 - 넌 귀중한 아군이 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 72b9685f-7ae6-98fb-d90c-081d6d473c6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - GEN_MaxPlayerCountReached = True
#. SetFlags:
#.   Global:
#.     - GLO_Tutorials_FullPartyRejection = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:72b9685f-7ae6-98fb-d90c-081d6d473c6d
msgctxt "h7d471385g82c1g4cf4ga3e9gdaf8b73f4e4d"
msgid ""
"I do not sleep unless I wish to. Until I feel safe among this company, I "
"shall spend my nights planning for the fights to come."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 785bfeef-f4da-0fb5-151f-45f102ee7b24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:785bfeef-f4da-0fb5-151f-45f102ee7b24
msgctxt "h4c4fb3d0g854bg47ccg8aaeg593ac9b4bbc9"
msgid "I don't think so. You need to leave."
msgstr "아니니까 떠나 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 78740526-9e04-f807-5c46-6e4e62c43ab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:78740526-9e04-f807-5c46-6e4e62c43ab3
msgctxt "hcd0a214dg60a8g45cfg8208gd94cf457d735"
msgid "I am no threat to you - I am at your mercy."
msgstr "난 너에게 위협이 아니라 - 구원이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 820441ae-5782-a589-10a7-8ab6c2a22345
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Minthara_AskedAboutKetheric(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:820441ae-5782-a589-10a7-8ab6c2a22345
msgctxt "hd277e107g2524g4c5fgaa0egd0f17df0c67c"
msgid "Tell me what you know about Ketheric's power first."
msgstr "먼저 케서릭의 능력에 대해 뭘 알고 있는지 말해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 821b4ad5-af07-a8a9-6b7c-4040533b6e7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:821b4ad5-af07-a8a9-6b7c-4040533b6e7c
msgctxt "hbd736a9dg4e87g44e8g959ag96ce63133f44"
msgid ""
"It does not need to be. But if you prefer to focus on the fight, I will not "
"distract you."
msgstr "과거로 남아있을 필요는 없지. 그렇지만 네가 싸움해 집중해야 할 때 방해가 되게 하진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 841d4e53-1977-b3a5-f5ed-dcb957c57331
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:841d4e53-1977-b3a5-f5ed-dcb957c57331
msgctxt "hcd22f3a4gc341g493ag88a8gb36fa0f2c3a3"
msgid "If your mind is broken, you're no good to me."
msgstr "네 정신은 망가졌어, 더 이상 쓸모가 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 84542ef3-2807-6c55-bac9-24fc6d3f967b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:84542ef3-2807-6c55-bac9-24fc6d3f967b
msgctxt "h871d157eg0757g4b5bgaa01g0f23fd6a9a06"
msgid "Why are you so keen to join with me?"
msgstr "왜 그렇게 따라 오려고 안달 난 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 85c00641-fce2-8364-14ce-176326bc991c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:85c00641-fce2-8364-14ce-176326bc991c
msgctxt "ha9a5d797g8de3g4334g9d25g6a9ecc6d3972"
msgid ""
"I suspect it is the very relic that Balthazar has been sent to retrieve."
msgstr "발타자르가 회수하려 하는 바로 그 유물 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 88b6da81-c06c-3ed6-fd92-80884943d606
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:88b6da81-c06c-3ed6-fd92-80884943d606
msgctxt "ha20f293eg91f6g4958gbd5bg05acb1b6054a"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 901ea044-6dce-af92-9232-c5dfedcc553a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:901ea044-6dce-af92-9232-c5dfedcc553a
msgctxt "h1f537b5cga705g43cdg8c2dg38af328b9813"
msgid ""
"We must eradicate them, starting with General Thorm... I mean Ketheric. My "
"deference to him is a habit that will die hard, I fear."
msgstr ""
"쏨 장군 부터 시작해서, 전부 쓸어버려야 해... 내 말은, 캐더릭 말이야. 안타깝지만 내가 그에게 가진 경외감은 오래 갈 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 91af769e-4ea1-198d-e867-686043eeb65d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:91af769e-4ea1-198d-e867-686043eeb65d
msgctxt "hcf49996fg7948g42f3gaaf5g635f85f346b1"
msgid ""
"He has chambers beside the General's, on the upper floor of the tower. I "
"suspect we will find answers there."
msgstr "발타자르의 집무실은 타워의 상층부, 쏨 장군의 집무실 옆에 있어. 거기로 가면 무언가 해답을 찾을 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 94f4cc8c-f1a5-ced7-60d4-83b116b4ca46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:94f4cc8c-f1a5-ced7-60d4-83b116b4ca46
msgctxt "hc02a5fabgaa6fg475aga39fgc074dc4c3526"
msgid ""
"Each memory that returns to me is more disturbing than the last. The things "
"that I did in the name of the Absolute... the things that were done to me."
msgstr "점점 끔찍해져만 가는 기억들이 돌아오고 있어. 내가 절대자의 이름으로 행한 것들... 나에게 행해진 것들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 96c45f97-9af7-ec5f-e510-19018c55d53a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:96c45f97-9af7-ec5f-e510-19018c55d53a
msgctxt "h3e13bcd3gee1fg4d7eg98caga5e49eddcadc"
msgid "Perhaps later. You should rest for now."
msgstr "다음에. 지금은 좀 쉬도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = 96fc693d-713b-935f-e9f3-443ad4b170a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:96fc693d-713b-935f-e9f3-443ad4b170a8
msgctxt "h7584d790g1c3ag4b40gbad3g655688e33b04"
msgid "Now that you're free, we can spend more nights together."
msgstr "이젠 네가 자유를 찾았으니, 더 많은 밤을 같이 보낼 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = 9b93e0ca-7ae1-a984-eb0c-bdcf6bc60fb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:9b93e0ca-7ae1-a984-eb0c-bdcf6bc60fb6
msgctxt "h4cca728cg017cg4a7fg80d1g997cf97ae9f4"
msgid ""
"I do not require sleep, but I shall use the solitude of the night to plan "
"for the fights to come."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = ae5c3495-ed89-ba09-3b3f-82588b77f878
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:ae5c3495-ed89-ba09-3b3f-82588b77f878
msgctxt "h4819cdcag4a9cg4268gb40bgc33764f156a1"
msgid ""
"You belonged to the Absolute then. I don't even know who you really are."
msgstr "그럼 넌 절대자의 영향 아래 있었다는 거네. 네가 도대체 누군지 모르겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = b08b6c6c-9079-2567-b4c8-babade15d7b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:b08b6c6c-9079-2567-b4c8-babade15d7b5
msgctxt "hd204ca00g7b77g4123g904age6d515d3bcba"
msgid ""
"Swear that you will keep me close... until the Absolute is dead, at least."
msgstr "날 옆에 두겠다고 맹세해... 적어도 절대자가 죽기까진."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = b34dc5ea-f7da-56d5-0e73-fedade49af8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:b34dc5ea-f7da-56d5-0e73-fedade49af8f
msgctxt "h23391b05g6e98g4b3ega280gc0dc9b3069c0"
msgid "The best cure is vengeance, for both of us."
msgstr "우리 둘에게 가장 좋은 치료제는 바로 복수야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = ba674b8a-d89d-448f-949b-604fa0c4525f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:ba674b8a-d89d-448f-949b-604fa0c4525f
msgctxt "h641b1fdbg3d7cg45bdga60dg470468928cbb"
msgid "I am."
msgstr "맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = bd0217c3-99f4-92ec-ac84-a009b525fe50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:bd0217c3-99f4-92ec-ac84-a009b525fe50
msgctxt "h63fec993gd5b0g4b00gbad2gc2332e5585f9"
msgid "Strength will not save us from an enemy that can dominate our will."
msgstr "강함은 정신을 지배하는 적으로부터 우리를 보호해 주진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = c320e3f3-7c41-3bb3-bc82-188c0b1ab7f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:c320e3f3-7c41-3bb3-bc82-188c0b1ab7f4
msgctxt "hdf679334gd17eg49adgbd74g9380b668dcad"
msgid ""
"For now, we will travel together, and fight together. In time, perhaps we "
"will lie together again."
msgstr "일단 지금은 같이 여행하고, 같이 싸우자. 때가 온다면 또다시 우리가 밤을 같이 보낼지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = c46bca25-18e7-0fad-9119-1844b0ed0647
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Minthara_State_ToldBalthazar = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:c46bca25-18e7-0fad-9119-1844b0ed0647
msgctxt "h58c5f262g1748g43d9g8e7dga98baedfc201"
msgid "Now, rest. We will need our strength for what lies ahead."
msgstr "지금은 쉬어 둬. 이 앞에서 우리를 기다리고 있는 것들과 싸우기 위해선 힘이 필요할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = c6785d53-8a12-f87a-a777-fabca9b18873
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:c6785d53-8a12-f87a-a777-fabca9b18873
msgctxt "h56b4a53bga890g42e8gbabdgdb892c1e4e7c"
msgid ""
"I did not invite you to approach my tent. I need privacy while I recover "
"from my ordeal at Moonrise."
msgstr "내 텐트에 초대한 기억은 없는걸. 문라이즈에서 얻은 피해를 복구할 수 있게 혼자 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = c9910aed-57a8-c39e-c232-9048502e9735
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:c9910aed-57a8-c39e-c232-9048502e9735
msgctxt "h418b704cg8cf8g4296g9924gf31c09e4c338"
msgid ""
"I believe Thorm draws his power not from a divine source, but an arcane one."
msgstr "내 생각에 쏜의 능력은 신성이 아니라 비전에서 오는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = ca87660e-4e6b-ad33-9d17-cf134d846fa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:ca87660e-4e6b-ad33-9d17-cf134d846fa1
msgctxt "heb338c0eg8b94g49ceg9df9g9c95187095d1"
msgid ""
"The Prism will protect me. You will fight alongside me, and help me to get "
"my vengeance."
msgstr "프리즘이 나를 보호할 거야. 넌 내 옆에서 싸우고, 내 복수를 돕는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = cada9648-eb15-717f-b50a-14a00fa6e393
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:cada9648-eb15-717f-b50a-14a00fa6e393
msgctxt "h471063f3gc881g4799g8cebg0c21a29402ce"
msgid "And we will break them - it's time for revenge."
msgstr "그리고 우리는 그들을 파괴할 거야 - 이제 복수의 시간이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = cc049d87-ab77-a822-c85f-504ee9ee262d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Minthara_State_KillKetheric = True
#.   Object:
#.     - OriginAddToParty(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:cc049d87-ab77-a822-c85f-504ee9ee262d
msgctxt "h0b36b56bga44bg44fcga6afg3b4212c84dca"
msgid ""
"Rest well, and keep your wits about you. Tomorrow, we go to war with the "
"cult of the Absolute."
msgstr "잘 자, 그리고 정신 잘 차리고 있어. 내일부터 절대자의 광신도들과의 전쟁이 시작될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = cc1549d1-ecef-26e0-2710-2379b150ad55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:cc1549d1-ecef-26e0-2710-2379b150ad55
msgctxt "h8c38b4ebg4c89g485agb026g106c30e3a950"
msgid "You sound desperate."
msgstr "필사적이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = cd7eb2d5-33c7-0d96-c172-e4bf8782efd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Quest_MistressOfSouls = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:cd7eb2d5-33c7-0d96-c172-e4bf8782efd8
msgctxt "h599472abgaef7g49cdga5b0g4dff8263d1d8"
msgid ""
"Down in their flesh-hives, an Absolutist attacker slashed <i>my </i>mind. I "
"know not who, but I know I seek revenge."
msgstr ""
"절대자 신도의 살점 감옥에서, 그들 중 하나가 <i>내</i> 정신을 베어버렸어. 누가 그런 건진 모르겠지만, 톡톡히 갚아줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = cdf487d0-fdf5-26be-b3e7-22def184de4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:cdf487d0-fdf5-26be-b3e7-22def184de4d
msgctxt "hac7a5ad5g723cg42f5g9a42g3aeba7e5fc32"
msgid ""
"That is a lie, intended to impress those who flock to the cult's cause, and "
"to strike fear in the minds of those who stand against the Absolute."
msgstr ""
"그건 거짓말이야. 광신도들의 뜻을 떠받들려 몰려드는 멍청이들에게 감명을 주기 위한 거짓말. 감히 절대자를 대적하려고 드는 자들을 겁주기 "
"위한 거짓말."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = ce7d32ca-38e2-0821-8eef-33b7c72f6744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:ce7d32ca-38e2-0821-8eef-33b7c72f6744
msgctxt "h000b7c82g0367g4666g9a1fge733ea9422b7"
msgid "Yes. Join me."
msgstr "그래. 따라 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = d42758a0-d420-185c-ff80-0f2aa536b773
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:d42758a0-d420-185c-ff80-0f2aa536b773
msgctxt "hd87cdc6ag075eg4440gb354gb56980e98be7"
msgid "Fine. You can stay here, but I'll be watching you."
msgstr "좋아. 남아있는 걸 허락하지, 하지만 내가 항상 지켜보고 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = d5ec4c5c-f08a-51df-e4b2-e0f6c23f47cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_MaxPlayerCountReached = True
#. SetFlags:
#.   Global:
#.     - GLO_Tutorials_FullPartyRejection = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:d5ec4c5c-f08a-51df-e4b2-e0f6c23f47cd
msgctxt "h923bbd25gd462g4d8cgae1egf64f9059dfe2"
msgid ""
"I would gladly join you in the fight. Leave one of your other allies here, "
"and I shall."
msgstr "일행에 자리가 난다면 언제든지 전투에 참여할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = e460b165-c7bf-632d-d35a-8d9c327d7736
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:e460b165-c7bf-632d-d35a-8d9c327d7736
msgctxt "hd47f55acge030g40acg8666g906f0ffab654"
msgid "Not only this battle, but all that come after."
msgstr "전투뿐만 아니라, 그 어떤 것도 함께 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Narrator
#. NodeID = e73fb925-4ec4-edf5-89c4-5c8bf45bc76c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:e73fb925-4ec4-edf5-89c4-5c8bf45bc76c
msgctxt "h6caf6ba6ga100g4b6fg8b3ag7564c382bc8d"
msgid ""
"*And you have earned that trust, along with a small measure of her "
"affection. It is a rare thing, well-hidden in the cold fortress of her mind, "
"and it is precious.*"
msgstr ""
"*그리고 당신은 그 신뢰와 함께 작은 애정을 얻었습니다. 차가운 성벽으로 둘러싸 자신을 숨기고 있는 그녀에겐 드물면서도, 소중한 "
"일입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = e79829f3-74c6-de49-a105-622efff91ae2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:e79829f3-74c6-de49-a105-622efff91ae2
msgctxt "h9a3662b2gd6c8g4a35g802dg8562c6ae9330"
msgid ""
"While our tadpoles live, and the cult have the means to control them, we "
"will never be safe."
msgstr "우리 안의 올챙이가 살아있는 한, 이 광신도들은 언제든 우리를 조종할 수 있어. 절대 안전할 수 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = e810ede8-c6ca-36f3-b21a-da0ae02a58fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:e810ede8-c6ca-36f3-b21a-da0ae02a58fe
msgctxt "hee6760c3g328fg4351ga764gb5bffc4538fc"
msgid "As a good leader should."
msgstr "좋은 지휘관이라면 마땅히 그래야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = ea509e03-2094-db1d-2766-17286f58065b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:ea509e03-2094-db1d-2766-17286f58065b
msgctxt "h597d5116gbed6g470fg9cc6g780260397599"
msgid "You'll join me in this battle, then?"
msgstr "전투에 함께 해 줄 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = f2546717-98a2-2c3b-6124-c8f7e3082d24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:f2546717-98a2-2c3b-6124-c8f7e3082d24
msgctxt "hb7d39161g7f06g4939gb9e8g2c0663b4a633"
msgid "You're strong - you'll recover."
msgstr "넌 강하니 곧 회복될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = f78ef342-cc8d-c59f-7584-059fd3acb512
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CAMP_Minthara_AskedAboutKetheric(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:f78ef342-cc8d-c59f-7584-059fd3acb512
msgctxt "h87c47855g2526g460bgb6e0gd78e27c42c76"
msgid ""
"All that live can die. I can help you plot Ketheric's demise, but I need "
"something from you first."
msgstr "살아 있는 건 언젠가 죽음을 맞는다는 거야. 케서릭을 죽일 방법을 찾도록 도울 수 있지만, 먼저 네가 해줘야 할 게 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = f9bd0961-a4cd-dbc9-78e4-28881ad0fcd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:f9bd0961-a4cd-dbc9-78e4-28881ad0fcd4
msgctxt "h301d9149g860ag4f27gb07dg21b85b1ce552"
msgid "Stop grovelling, and leave."
msgstr "비굴하게 굴지 말고 떠나기나 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Narrator
#. NodeID = fbaa1f58-a639-4518-6a12-53d00166348c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:fbaa1f58-a639-4518-6a12-53d00166348c
msgctxt "hdbd676fbga167g4205ga394g775cf4a3b3a4"
msgid ""
"*Her entire being joins with you for a moment, and you see all that she is. "
"Dangerous, cunning, wounded, brutal, paranoid... and utterly loyal to those "
"she trusts.*"
msgstr ""
"*순간 그녀의 존재 그 자체가 당신과 하나가 되고, 당신은 그녀의 전부를 볼 수 있습니다. 위험하고, 교활하고, 상처 입고, 잔혹하고, "
"편집증적이지만... 신뢰하는 사람에겐 완벽한 충성을 맹세하는 그녀를.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Nightwarden Minthara
#. NodeID = fd03517d-a358-a054-b414-eab755dd64dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Minthara_State_MintharaLeavesTheTeam = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:fd03517d-a358-a054-b414-eab755dd64dd
msgctxt "hf65383bcg460bg4c85g8951ge881657c8fea"
msgid ""
"The next time we meet, I will kill you. In the Absolute's name, or my own."
msgstr "다음에 마주칠 땐 죽여버릴 거야. 절대자의 이름, 혹은 민타라의 이름을 걸고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = fd1a15de-16aa-6f1e-23ae-3668fdcbad0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:fd1a15de-16aa-6f1e-23ae-3668fdcbad0b
msgctxt "h68e7674fg458ag49d4g9bf5g0948356f35d7"
msgid "Very well. You can join me."
msgstr "알겠어. 나와 함께 해도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara
#. Speaker = Player
#. NodeID = fea0f912-f1c4-6c0c-dfbc-dd37152aecd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Minthara:fea0f912-f1c4-6c0c-dfbc-dd37152aecd7
msgctxt "hdc095d81gdeb5g4ba6gab92gb9efaf3af50f"
msgid "Any suggestions on how we kill an invulnerable man?"
msgstr "불사자를 죽일 방법이라도?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_000
#. Speaker = Nightwarden Minthara
#. NodeID = cfa12001-cc58-4bcf-8796-b184d606fb4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_000:cfa12001-cc58-4bcf-8796-b184d606fb4b
msgctxt "hd205d414gbbf1g4d28gbafag02ec9834c7cc"
msgid "Slaughter them!"
msgstr "썰어 버려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_001
#. Speaker = Nightwarden Minthara
#. NodeID = 4a876481-e27d-4c14-812d-c6db3067d3e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_001:4a876481-e27d-4c14-812d-c6db3067d3e5
msgctxt "hb98fd27fgc6e7g4f5dg9e75g73708293bc72"
msgid "For the Absolute!"
msgstr "절대자를 위하여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_002
#. Speaker = Nightwarden Minthara
#. NodeID = afa85724-f339-4f30-8025-84ba037f633e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_002:afa85724-f339-4f30-8025-84ba037f633e
msgctxt "h09c65b11gec9eg41c1ga1d4gd22662ec2eda"
msgid "Your existence is blasphemy."
msgstr "넌 존재 자체로 신성을 모독하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_003
#. Speaker = Nightwarden Minthara
#. NodeID = 1da7604e-01af-4c85-97ab-f747bad93c60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_DrowCommander_003:1da7604e-01af-4c85-97ab-f747bad93c60
msgctxt "hff2266d0gcb82g412bga821g94c8187d5edc"
msgid "<i>Dos orn el, ghil lu'nin.</i>"
msgstr "<i>도스 온 엘, 질 루 린!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_001
#. Speaker = Goblin Brawler
#. NodeID = f29f9fd5-0429-4ba1-b72d-df0a4372b22b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_001:f29f9fd5-0429-4ba1-b72d-df0a4372b22b
msgctxt "ha1d3b58ag59a6g4a1fgb35bg596c86670b72"
msgid "You die tonight!"
msgstr "넌 오늘 뒈진다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_003
#. Speaker = Goblin Tracker
#. NodeID = 5be887c9-aca0-4d95-873e-842c1f79a667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_003:5be887c9-aca0-4d95-873e-842c1f79a667
msgctxt "h4f46a898ga04dg47b5g9abfgffa2be562a5f"
msgid "I'll piss on your grave!"
msgstr "니 무덤에 오줌을 싸갈겨 주마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_008
#. Speaker = Goblin Warlock
#. NodeID = 30913983-3ada-46ee-84e4-e4243277ab73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_008:30913983-3ada-46ee-84e4-e4243277ab73
msgctxt "h338408a3gebebg41eegb764g99134370fce8"
msgid "Stop fighting back, you belly-achers!"
msgstr "항복하라고, 이 살만 뒤룩뒤룩 찐 것들아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_009
#. Speaker = Goblin Booyahg
#. NodeID = 0f55568f-6e8d-4e5b-8064-49405308d118
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_MintharaAmbush_AD_Combat_PartyGoblin_009:0f55568f-6e8d-4e5b-8064-49405308d118
msgctxt "ha551ec86gfb8cg4561ga8e7g2b9c62ff9cf0"
msgid "I'm strategisin'."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 0053817c-cb19-2519-3dbd-12194d8397f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0053817c-cb19-2519-3dbd-12194d8397f3
msgctxt "h93870573g4036g4f41ga307gaa007fc97340"
msgid "I look forward to it."
msgstr "그거 기대되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 02cb7b04-2f6e-a701-91c9-fd8728266b21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:02cb7b04-2f6e-a701-91c9-fd8728266b21
msgctxt "h9f315d2fg7074g4a47g91b8gaf3406ee1858"
msgid ""
"The legend lives! Oh, how the people will applaud their courageous hero."
msgstr "대담하기도 하지! 아, 다들 용감하신 대공님을 얼마나 칭송할까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 02d77084-9e0a-e101-7e1d-70931a27b475
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:02d77084-9e0a-e101-7e1d-70931a27b475
msgctxt "h6ae839f8ge15dg411cg8ca6g8a16aae0ddf3"
msgid ""
"But you mess with Zariel's true faithful? You'll be turned to a lemure and "
"answer to the Archduchess of Avernus."
msgstr "하지만 자리엘 님의 진정한 신봉자를 건드렸다간 레무어로 변한 채 아베르누스의 대공비님께 복종하는 신세가 될걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 02d77084-9e0a-e101-7e1d-70931a27b475
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:02d77084-9e0a-e101-7e1d-70931a27b475
msgctxt "h1e7585fcg618fg4204g906cg1a6f0b82aab4"
msgid ""
"But if he messes with Zariel's faithful? He'll be turned to a lemure and "
"answer to the Archduchess of Avernus."
msgstr "하지만 자리엘 님의 진정한 신봉자를 건드렸다간 레무어로 변한 채 아베르누스의 대공비님께 복종하는 신세가 될걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 032df377-09f7-6c60-c038-860938d7d6ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:032df377-09f7-6c60-c038-860938d7d6ee
msgctxt "hb3ccb2e3g6d5fg4a60ga739gad77b97bc925"
msgid ""
"But <i>do</i> tell me you haven't forgotten. Once the Absolute is no more, "
"so is my aid."
msgstr "<i>절대</i> 잊어버리면 안 돼. 절대자가 없으면, 내 도움도 없는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 03461a21-fbf7-762a-7a50-2df038497230
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:03461a21-fbf7-762a-7a50-2df038497230
msgctxt "h8907d93ag9d8bg4ba1gbfafgd815ecc17739"
msgid "Oh, how the people will applaud their courageous hero."
msgstr "아, 사람들이 자기들의 용감하신 대공님을 얼마나 칭송할까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 03b784a6-3809-6a0a-9bff-cda630b56392
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:03b784a6-3809-6a0a-9bff-cda630b56392
msgctxt "hddc9fc57gb102g44bbgacecg0b884c8d8b20"
msgid ""
"Roam where you want, pup. But don't give me a reason to tighten the leash."
msgstr "너 가고 싶은 데로 가봐, 멍멍아. 하지만 엉뚱한 곳으로 가서 내가 나설 일은 없게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 03b784a6-3809-6a0a-9bff-cda630b56392
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:03b784a6-3809-6a0a-9bff-cda630b56392
msgctxt "h93eb997ag040eg43a1g84baged8dd15e55b3"
msgid ""
"The pup can roam where he wants, as long he gives me no reason to tighten "
"the leash."
msgstr "엉뚱한 곳으로 가서 내가 나설 일만 없다면야, 멍멍이는 어디든 가도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 03e776cb-4430-b007-116c-19ab5e8c5d5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:03e776cb-4430-b007-116c-19ab5e8c5d5a
msgctxt "h98a7df19g3d7eg4791gb1ecgc058c8625f76"
msgid ""
"Devils, demons, deserters. They're a great burden on the Lord of the First."
msgstr "데빌에, 데몬에, 탈영병까지. 이것들은 제1층의 군주님께 굉장한 골칫거리라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 0667b3d9-2f0d-4da0-18f5-d671c97ee529
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0667b3d9-2f0d-4da0-18f5-d671c97ee529
msgctxt "hefff8c54g3f2fg4e20gaa10gae5a0949c1fd"
msgid ""
"You're such a witless little thing. Laugh in the face of the Archduchess "
"Zariel, and she only laughs back."
msgstr "너 정말 머리 나쁘구나. 잠깐 자리엘 대공비님의 앞을 막을 수는 있겠지만, 결국 마지막에 미소 짓는 건 그분이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 067a56a5-c651-e948-f34d-9faa3d393d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:067a56a5-c651-e948-f34d-9faa3d393d7e
msgctxt "h30e56b05g8fe4g444fg9debg5e712fe8bd07"
msgid ""
"But I do enjoy a game of cat and mouse. Let the Grand Duke give chase. I "
"might even let him catch me."
msgstr "하지만 난 술래잡기를 좋아하지. 우리 대공님한테 잡는 역할을 드려. 잡혀줄 의향도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 07e2223d-dadb-26fe-3e61-13a0fb82fb89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:07e2223d-dadb-26fe-3e61-13a0fb82fb89
msgctxt "h2867c5ebg1651g47e5g8392gfe875b1ceacc"
msgid "Out with it, devil."
msgstr "하고 싶은 말이 뭔데, 데빌 년아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 08be8f7e-e6cd-8e9c-0d4f-1177f4f6c9da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:08be8f7e-e6cd-8e9c-0d4f-1177f4f6c9da
msgctxt "ha8b21d50g02fbg4b5cgad31gb9e61f19f5e8"
msgid "Oh, <i>let's.</i>"
msgstr "오, 너무 <i>좋지</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 08e2f192-5a51-33f8-c198-5da0d417e1c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:08e2f192-5a51-33f8-c198-5da0d417e1c7
msgctxt "h0456edfeg60edg49e7g9212g770cbb432893"
msgid ""
"The elder brain is first on the list. Everything else will need to wait."
msgstr "엘더 브레인이 최우선이다. 다른 일은 나중에 처리하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 0a8a546e-254e-ddbe-d806-cbd88d8ad578
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0a8a546e-254e-ddbe-d806-cbd88d8ad578
msgctxt "h3276ed07g6e71g41dag863eg2f20b0854fc7"
msgid ""
"Is it possible? Could the courageous Wyll Ravengard be this heartbreakingly "
"naive?"
msgstr "이게 말이 되나? 그 용감한 윌 레이븐가드께서 이렇게 불쌍할 정도로 순진하셨다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 0aa49464-f6b6-1315-b418-a33c92d3ed7b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0aa49464-f6b6-1315-b418-a33c92d3ed7b
msgctxt "h80618114g27acg4c03g9426gb1c7a8c7562f"
msgid "Glower all you want - I was merely laying the path to your success."
msgstr "뭐라고 칭얼대건 난 신경 안 써. 다 네 성공을 위해 했던 일이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 0aa49464-f6b6-1315-b418-a33c92d3ed7b
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0aa49464-f6b6-1315-b418-a33c92d3ed7b
msgctxt "h8f8cfff1ga7edg4c0ega4d5g01ea48cffa27"
msgid "Glower all you want - I was merely laying the path to Wyll's success."
msgstr "뭐라고 칭얼대건 난 신경 안 써. 다 윌의 성공을 위해 했던 일이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 0c7dddd9-b36f-ec12-3a1a-f0db21ed4ee6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0c7dddd9-b36f-ec12-3a1a-f0db21ed4ee6
msgctxt "haa350c7bgfbe1g460fg887cg78331139d115"
msgid ""
"You and me, duke and advisor. Baldur's Gate's outlook is radiant indeed."
msgstr "너하고 나하고, 대공과 고문관이 되는 거지. 발더스 게이트의 미래는 완전 눈부실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 0d05965a-3b61-c5b4-8b3f-7c16aea8fe03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0d05965a-3b61-c5b4-8b3f-7c16aea8fe03
msgctxt "h57cb52ccg5fd8g4c7dgbb1ag24dc7a8e629a"
msgid ""
"You don't owe me an explanation, pet. He was as good as dead before you ever "
"set foot in the Iron Throne. That was the deal, after all."
msgstr ""
"나한테 설명할 필요 없어, 멍멍아. 너희 아빠는 네가 아이언 스론에 발 들이기 전부터 이미 죽은 목숨이었던 거야. 그게 거래였잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 0f4ade53-5e41-dccc-cd05-19ebe5585337
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:0f4ade53-5e41-dccc-cd05-19ebe5585337
msgctxt "h92971fd1gd523g45e7gbf4ege94a050dda57"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 101fb14b-d24a-d665-4794-b9ce5f1bd328
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:101fb14b-d24a-d665-4794-b9ce5f1bd328
msgctxt "h71e8e8fcgc155g4644g9af4g59f22755ba0c"
msgid ""
"Entertainment? I'd be a cheeky devil indeed to make such diabolical merry!"
msgstr "재미라고? 이런 악마 같은 짓에 재미를 느끼면 정말 뻔뻔한 데빌 년이지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 107813eb-adc4-dc06-27e1-2859c6be3da8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:107813eb-adc4-dc06-27e1-2859c6be3da8
msgctxt "h365e3740gaef0g4a24gafb7g26df3411a69f"
msgid "Oh, you always were an inquisitive one."
msgstr "아, 넌 항상 궁금한 게 많았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 107813eb-adc4-dc06-27e1-2859c6be3da8
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:107813eb-adc4-dc06-27e1-2859c6be3da8
msgctxt "hcff3f2c5gcb3bg4a16g93e9g291c1771cea6"
msgid "Oh, you are an inquisitive one."
msgstr "아, 진짜 궁금한 거 많네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 12310f2a-3df1-4e12-d62d-5b0a213283c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:12310f2a-3df1-4e12-d62d-5b0a213283c1
msgctxt "h40b14ff4gcbfbg4258g9d73gbcf7ad472fc9"
msgid "That's it then. My father is dead."
msgstr "다 끝난 일이야. 아버지는 돌아가셨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 125a956b-98d6-b97f-fffa-4967a3be7866
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:125a956b-98d6-b97f-fffa-4967a3be7866
msgctxt "h792889e5g672ag453cga97dgc160f97c55df"
msgid "Your moans of ecstasy told me otherwise."
msgstr "그런 것 치고는 되게 기분 좋아하는 신음이던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 13c648bf-5f71-150e-31a5-77f4f3f5b265
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dbeade8e-5b5b-89b3-e348-6845275fa885_MindHasBeenRead = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:13c648bf-5f71-150e-31a5-77f4f3f5b265
msgctxt "h47bae78bge91cg4760g8fb4g1f06ca837946"
msgid "What did you mean, about tipping the scales in your favour?"
msgstr "저울이 우리 쪽으로 기울었다는 게 무슨 뜻이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 13ece952-aa82-ddad-5aa6-909b6dc17a12
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:13ece952-aa82-ddad-5aa6-909b6dc17a12
msgctxt "ha3ae8994ge710g452dga21dgbfb2a93cf089"
msgid ""
"But that would make your sacrifice worthless. And I know you wouldn't want "
"<i>that.</i>"
msgstr "근데 그러면 지금까지의 희생은 다 물거품이 되는 거고. 너도 <i>그런 걸</i> 원하진 않겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 13ece952-aa82-ddad-5aa6-909b6dc17a12
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:13ece952-aa82-ddad-5aa6-909b6dc17a12
msgctxt "hf6bd9899geb8ag4cbag9118ga240f78f490c"
msgid ""
"But that would make Wyll's sacrifice worthless. And I know you wouldn't want "
"<i>that.</i>"
msgstr "근데 그러면 윌이 지금까지 했던 희생은 다 물거품이 되는 거고. 너도 <i>그런 걸</i> 원하진 않겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1402c44c-19f1-ab2c-a2fe-4dea22aad4ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1402c44c-19f1-ab2c-a2fe-4dea22aad4ce
msgctxt "hc72be2ccg2162g4fc8g9111ge2a5701a2a6b"
msgid ""
"You don't owe me an explanation. Like most other mortals, Ravengard was "
"always bound for the grave."
msgstr "구구절절 설명할 것 없어. 다른 필멸자처럼 레이븐가드도 결국 흙으로 돌아갈 운명이었던 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1439540d-a607-4f33-d4d8-33dad6e43eda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1439540d-a607-4f33-d4d8-33dad6e43eda
msgctxt "hf540c56bg7cdbg44cdg8871g177ee4947875"
msgid "If you ask me, that's where our Lady should've left you long ago."
msgstr "자리엘 님께서 너 같은 년을 그런 데 처박아 두셨어야 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 151ae275-b335-162a-f83a-dbbdc7805910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:151ae275-b335-162a-f83a-dbbdc7805910
msgctxt "h03ba7a61gb536g40dfgbe90gf1a282fb03c7"
msgid "Go on, do your gloating. You earned it."
msgstr "뭐 해, 잘난 척 해봐. 네가 해냈잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 15230fee-ecca-49a9-acdd-10d722553610
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#.   Object:
#.      - CAMP_Mizora_Event_AskedWhyStay(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_AskedWhyStay(1) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:15230fee-ecca-49a9-acdd-10d722553610
msgctxt "hdb986d12g84bag468fgba6bg8b9117741d30"
msgid ""
"I don't get it. If the pact is broken, why stick around and give me power?"
msgstr "이해할 수 없군. 계약도 끝났는데 왜 여기 머무르면서 나한테 힘을 주지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 15230fee-ecca-49a9-acdd-10d722553610
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#.   Object:
#.      - CAMP_Mizora_Event_AskedWhyStay(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_AskedWhyStay(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:15230fee-ecca-49a9-acdd-10d722553610
msgctxt "he5f93d90g4464g4e41gb7d2g649c6d5705e2"
msgid ""
"I don't get it. If Wyll isn't your warlock, why stick around and give him "
"power?"
msgstr "이해할 수 없군. 이제 윌은 네 워락도 아닌데 왜 여기 머무르면서 힘을 주고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 162419ae-1c34-67dd-3753-8e6756b2ddb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:162419ae-1c34-67dd-3753-8e6756b2ddb2
msgctxt "h1d555f59g3c41g4f83g9677g26d9cba1b93d"
msgid "Lead me to the Hells, and you'll be the first to know."
msgstr "지옥에 가게 해 줘. 그럼, 너한테 제일 먼저 알려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 162419ae-1c34-67dd-3753-8e6756b2ddb2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:162419ae-1c34-67dd-3753-8e6756b2ddb2
msgctxt "hf8a8cfd2g8e3dg449cgad76g0a0a69fec8b4"
msgid "Lead him to the Hells. I'm sure he'll find plenty of quarry."
msgstr "윌과 지옥으로 가라. 거기라면 윌의 사냥감이 넘쳐나겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 16260c29-37aa-0a86-5d0a-a50a0605bd79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:16260c29-37aa-0a86-5d0a-a50a0605bd79
msgctxt "h00a9eb6cgd016g42adg9b3dg10772a8cc7e3"
msgid ""
"The Dead Three and that bulging brain of theirs are a threat to more than "
"this trifling city, you know."
msgstr "알고 있겠지만 삼악신이랑 그 퉁퉁 부은 뇌는 이 보잘것없는 도시에 닥친 가장 큰 위협이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 169ec10e-6739-349d-45a2-1971ef517e88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:169ec10e-6739-349d-45a2-1971ef517e88
msgctxt "he0da6c49g50ffg421ag85aeg8a0c5c49a20c"
msgid ""
"With the duke gone, someone will need to step up in his absence. A man with "
"the spirit of a dragon."
msgstr "이제 대공님이 돌아가셨으니, 누군가 그 분의 빈 자리를 채울 사람이 필요하겠네. 드래곤 같은 기백을 가진 그런 사람 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 16f4e3ca-19ea-247d-a8b3-c9ffb5d8dfeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:16f4e3ca-19ea-247d-a8b3-c9ffb5d8dfeb
msgctxt "ha54266eag69ecg4b5fg8ce5g7aefb22fc6b9"
msgid ""
"Oh, you <i>have</i> found your bark! I beg your forgiveness for such undue "
"impertinence."
msgstr "오, 우리 멍멍이 기운 <i>차렸네</i>! 아까는 내가 너무 주제넘게 말해서 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 1823e917-6b12-efd1-7225-5e1abaaaf90b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1823e917-6b12-efd1-7225-5e1abaaaf90b
msgctxt "h9f7cf913gec08g4286gbfb7g0d40ce1b869e"
msgid "I'm not a child. You need to start treating me with respect."
msgstr "난 어린애가 아니야. 이제 나한테 존중을 담아서 대해야 할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1999fcd2-c49b-fdf2-f6e4-3c85fbaedf27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1999fcd2-c49b-fdf2-f6e4-3c85fbaedf27
msgctxt "hfeb389aegb0e0g48d1gaf22g516c73841019"
msgid ""
"I've never seen you so giddy, Wyll. Go on, celebrate your fortunes. But "
"remember that they are lost as quickly as they are gained."
msgstr ""
"그렇게 신난 건 처음 보네, 윌. 맘껏 축하해. 이번엔 운이 좋았네. 근데 운이란 건 들어온 속도만큼 빠르게 사라진다는 거 알아 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 19b7e7d2-bb73-59b4-cdbe-181b900a05fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:19b7e7d2-bb73-59b4-cdbe-181b900a05fa
msgctxt "h50ddf136g4f70g41d9gb90fg12a0ff3ce00a"
msgid ""
"Don't worry, I won't keep too tight a leash. You scratch my horns, I'll "
"scratch yours."
msgstr "걱정 마, 너무 빡빡하게 굴려는 거 아니니까. 다만 내 뿔을 긁으면, 나도 네 뿔을 긁을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 19b7e7d2-bb73-59b4-cdbe-181b900a05fa
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:19b7e7d2-bb73-59b4-cdbe-181b900a05fa
msgctxt "h8deeaba5g4e59g4273gac13gc48a209a661e"
msgid ""
"Don't worry, I won't keep too tight a leash. He scratches my horns, and I'll "
"scratch his."
msgstr "걱정 마, 너무 빡빡하게 굴려는 거 아니니까. 다만 윌이 내 뿔을 긁으면, 나도 그 애 뿔을 긁을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1a0b9578-ef9a-b43c-f30f-f25978b38e98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = True
#.      - IRN_IronThrone_State_MizoraEnemy = True
#.   Object:
#.      - CAMP_Mizora_Event_Gloating(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_Gloating(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1a0b9578-ef9a-b43c-f30f-f25978b38e98
msgctxt "h6e958591g525ag424agb57eg4f7ec4c0035f"
msgid "Back so soon?"
msgstr "벌써 왔어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1b8c2f5f-85e5-c2c1-07aa-e3875cab4a61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1b8c2f5f-85e5-c2c1-07aa-e3875cab4a61
msgctxt "h5d466313gd588g4f1cg9cd6g224cc7f33f42"
msgid "Impossible? My bargain was <i>uncommonly</i> reasonable."
msgstr "불가능하다고? 그 정도 거래면 <i>말도 안 되게</i> 합리적이었던 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 1bf89dc6-502b-8a9f-2595-31ee26e800f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Karlach = True
#.   Object:
#.      - CAMP_Mizora_Event_KarlachAlive(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_KarlachAlive(1) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1bf89dc6-502b-8a9f-2595-31ee26e800f6
msgctxt "h70645139g3e8ag486eg856ag8730a99ddb09"
msgid "Zariel wanted me dead, but you've left me alone. What gives, Mizora?"
msgstr "자리엘이 죽이라고 했을 텐데 넌 날 혼자 내버려 뒀어. 무슨 일이냐, 미조라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 1bf89dc6-502b-8a9f-2595-31ee26e800f6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Karlach = True
#.   Object:
#.      - CAMP_Mizora_Event_KarlachAlive(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_KarlachAlive(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1bf89dc6-502b-8a9f-2595-31ee26e800f6
msgctxt "hf6491a3aged1fg4c55gac8cg9238ec49ac31"
msgid "You've left Karlach alone. Didn't you want her dead? What changed?"
msgstr "넌 칼라크를 혼자 내버려 뒀어. 그 애가 죽길 바라지 않았나? 뭐가 달라진 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1c53a058-121b-162a-ed14-19097f07ae1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1c53a058-121b-162a-ed14-19097f07ae1a
msgctxt "h13330aa2g9bc8g4a8dg9ecag18a7bfe64c72"
msgid ""
"All that anger in you, Karlach - that pent-up fury and desire. It felt good "
"to unleash them on the one person who could possible understand, didn't it?"
msgstr "칼라크. 여태껏 그 모든 분노와, 혈기와 욕구가 쌓여있었잖아. 그걸 다 감당할 수 있는 사람한테 쏟아내 보니까 기분 좋았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1c63d6bf-b77f-5b6d-4112-f04cfeea713f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1c63d6bf-b77f-5b6d-4112-f04cfeea713f
msgctxt "h1d5c6558ga505g4c99gbea3g4304fa08f61b"
msgid "- and <i>radiant </i>with Her Ladyship Zariel's blessings."
msgstr "그리고 자리엘 님의 은총으로 <i>빛나지</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 1e5a5b62-fe69-b3d3-3904-7340f032310d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_TitForTat(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_TitForTat(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1e5a5b62-fe69-b3d3-3904-7340f032310d
msgctxt "h0184259ag3a4ag4778g9fa9g416befc848e5"
msgid "If you're going to be staying, I need something in return."
msgstr "여기 계속 머무를 거라면 대가를 좀 받아야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1ee7940f-6465-bc94-b6ab-65ce9f2147f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1ee7940f-6465-bc94-b6ab-65ce9f2147f3
msgctxt "hefc9ced5g6350g44a2g923bg64ac1810b7b1"
msgid ""
"Don't be so hard on him. I'm sure he carefully weighed the pros and cons."
msgstr "윌한테 너무 뭐라고 하지 마. 분명 자기도 장단점을 다 따져 봤을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 1f9df0f3-b56b-f3db-4354-4fbaa7d1feeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:1f9df0f3-b56b-f3db-4354-4fbaa7d1feeb
msgctxt "h7d08e9cdgf420g4242g89fbg7d84421e9f58"
msgid ""
"All that, for the measly cost of one soul. A real bargain, don't you think?"
msgstr "그 모든 게 영혼 하나만 바치면 이뤄진다니, 완전히 남는 장사 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 209d50a1-9e48-8487-bfa1-2758fbe7b8fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:209d50a1-9e48-8487-bfa1-2758fbe7b8fb
msgctxt "h0636686ag2447g45b3gac6cg961fe9ed7f46"
msgid ""
"Oh, I almost forgot - you sold his life for your freedom. <i>My</i> mistake."
msgstr "아, 맞다. 넌 자유로워지고 싶어서 자기 아빠를 팔아먹었지? <i>깜빡했네</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 21030caa-5348-441b-f6cf-9b05e65ae0ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:21030caa-5348-441b-f6cf-9b05e65ae0ef
msgctxt "h4d3fdf51g4819g4302gb531ga100f3cb2345"
msgid "Don't patronise him."
msgstr "윌을 얕보지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 21100148-9ba7-8755-86f7-74c91465e548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:21100148-9ba7-8755-86f7-74c91465e548
msgctxt "h8f6a586fge275g4a7cg8cd6g0d031acce9c8"
msgid ""
"I am a benefactress. And I have an eye for a good cause. Wyll needed help, "
"so I indulged him."
msgstr "난 기회를 제공해 주는 사람이야. 누가 도움이 필요한지도 잘 찾고. 윌이 그런 상황이었으니, 내가 도와준 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 21514c3f-61d7-5524-bc11-2f60fac309ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_FlorrickFighFallback_Event_Occurred = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:21514c3f-61d7-5524-bc11-2f60fac309ee
msgctxt "h80c83208g611eg45aega021ga27395a661f3"
msgid ""
"So you talked to Cordula? Such an elegant woman - so protective of the city, "
"so <i>eager</i> to hear of your exploits."
msgstr "코듈라하고 만났나 보네? 완전 우아한 여자지. 도시 지키는 일도 열심이고, 네 활약상도 굉장히 기대하고 있던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 233a43ef-ae69-5406-aef5-dbb7653a083c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:233a43ef-ae69-5406-aef5-dbb7653a083c
msgctxt "h027865fdgd583g4cf4g9cc5gc6a9f4b4a97f"
msgid "Oh, I was just thinking of Wyll's father, the Grand Duke."
msgstr "그냥 윌 아빠 생각을 하고 있었어. 우리 대공님 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2350dc08-75ec-e358-d8cc-090dc46e94a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2350dc08-75ec-e358-d8cc-090dc46e94a0
msgctxt "h09e741f5g9289g401dga28dg94bc74fa56be"
msgid ""
"Don't be so hard on yourself. I'm sure you carefully weighed the pros and "
"cons."
msgstr "너무 자책하지 마. 너도 신중하게 장단점을 다 따져보고 나서 행동한 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 23b46456-2403-9a0c-1d5e-84e140b6be79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:23b46456-2403-9a0c-1d5e-84e140b6be79
msgctxt "h78f9da4eg16a8g412cga147gbc73dbd406fa"
msgid ""
"Oh, I almost forgot - Wyll sold his father's life for his freedom. <i>My</i> "
"mistake."
msgstr "아, 맞다. 윌은 자유로워지고 싶어서 자기 아빠를 팔아먹었지? <i>깜빡했네</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 24790953-ec6f-d1a4-427c-a2e9a7b1fc6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:24790953-ec6f-d1a4-427c-a2e9a7b1fc6d
msgctxt "h1ea8dbbdg2584g48d5gaabcgf18ea76e1590"
msgid "And I bet you're <i>full </i>of ideas."
msgstr "물론 우리 후계자님께서는 계획이 <i>무궁무진</i>하시겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Narrator
#. NodeID = 252db2b2-c549-f678-c1c6-d3d9dd621835
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#.      - CAMP_MizorasPact_State_WyllEternalPact = False
#.   Tag:
#.      - AVATAR(1) = True
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:252db2b2-c549-f678-c1c6-d3d9dd621835
msgctxt "h5c8d8110g96ccg4ee1g9182g2bb332661057"
msgid "*Mizora eyes you silently. She wants to speak with Wyll.*"
msgstr "*미조라가 당신을 조용히 쳐다봅니다. 윌과 대화하고 싶은 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 254f2a2b-ed6c-819a-df7f-068aa9c7d4dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:254f2a2b-ed6c-819a-df7f-068aa9c7d4dc
msgctxt "hcd9ba204g150dg489cgad17gb2286cc4a40e"
msgid "I find a way to kill my former patron."
msgstr "내 옛날 후원자를 죽이러 갈 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 25505292-1db2-870f-863f-7b5d2e26b16e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:25505292-1db2-870f-863f-7b5d2e26b16e
msgctxt "h1cfdf87cg6a07g4124gb701gaa45f9fdb6dc"
msgid ""
"Don't worry, I won't keep too tight a leash. You scratch my horns, I'll "
"scratch yours."
msgstr "걱정 마, 너무 빡빡하게 굴려는 거 아니니까. 다만 내 뿔을 긁으면, 나도 네 뿔을 긁을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 25505292-1db2-870f-863f-7b5d2e26b16e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:25505292-1db2-870f-863f-7b5d2e26b16e
msgctxt "hea3930b1g9ca2g4dc6g887cgd6e535af3ef9"
msgid ""
"Don't worry, I won't keep too tight a leash. He scratches my horns, and I'll "
"scratch his."
msgstr "걱정 마, 너무 빡빡하게 굴려는 거 아니니까. 다만 윌이 내 뿔을 긁으면, 나도 그 애 뿔을 긁을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 25e9ca6f-f4cb-ae8c-63e2-36cbebdb206a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:25e9ca6f-f4cb-ae8c-63e2-36cbebdb206a
msgctxt "h8fa6137fge645g42c0g9926g33a46a2fa312"
msgid "Let's see how well he suffers the burn."
msgstr "레이븐가드가 불 속에서 얼마나 잘 버티나 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 26ff9a51-f8a2-062f-1262-a4fb4a7319ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:26ff9a51-f8a2-062f-1262-a4fb4a7319ef
msgctxt "h60f984deg279dg4407gbd56g2e518d2cf0fc"
msgid ""
"Ah, the thrill of the unknown! I can't wait to see what's in store for "
"Baldur's Gate's newest Grand Duke."
msgstr "아, 설렌다! 발더스 게이트에 새 대공이 임명되면 상점에 대체 뭐가 들어오려나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2729d099-370f-e2e6-465a-72203804dc2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2729d099-370f-e2e6-465a-72203804dc2c
msgctxt "hbb6cdf80g1998g4297gae61g151c21fb72af"
msgid "So what's your first order of business, sir duke?"
msgstr "그럼, 이제 누구한테 먼저 가시겠어요, 대공님?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 27d0df0d-a7d1-7496-0366-7f1841062424
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:27d0df0d-a7d1-7496-0366-7f1841062424
msgctxt "haab1fe85g07f3g45a9ga20agebaf0e7107b7"
msgid ""
"I never thought the legendary Blade of Frontiers would surrender his father "
"for freedom."
msgstr "전설적인 변경의 칼날 님께서 본인 자유를 위해 자기 아빠를 팔아먹을 줄은 몰랐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 28ad4c6e-868a-1079-2734-917c4443b9ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#.      - CAMP_Mizora_Event_FinalDiscussion = False
#.   Tag:
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_Event_FinalDiscussion = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:28ad4c6e-868a-1079-2734-917c4443b9ad
msgctxt "h28ac5e0cg1847g4f99g9f96ged2733d17589"
msgid ""
"'Grand Duke Wyll Ravengard.' What a thrill! Imagine the statues they'll "
"build, the songs that they'll sing!"
msgstr "'윌 레이븐가드 대공.' 진짜 신난다! 무슨 동상이 세워지고 무슨 노래가 불릴까!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 2996736d-2d75-4b9a-9c76-5125acd28e96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dbeade8e-5b5b-89b3-e348-6845275fa885_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2996736d-2d75-4b9a-9c76-5125acd28e96
msgctxt "hf6596430gb7cbg4484gb14eg2f2d49fcaaa2"
msgid ""
"I know you will come for him. Try it, and I'll save him again - and kill you "
"while I'm at it."
msgstr "그분을 노린다는 거 다 알아. 해볼 테면 해 보시지. 난 또 그분을 구해내고, 넌 죽을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 29cd648a-bf3d-f693-01c8-fb45a4b438fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:29cd648a-bf3d-f693-01c8-fb45a4b438fc
msgctxt "h1ab87a95g178dg4303g8aa8g492ffafc6244"
msgid "...and Ravengard died knowing the face of his killer."
msgstr "...레이븐가드도 살인범 얼굴은 보고 죽었네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2a4318e7-9196-0d05-0e59-265626120a44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2a4318e7-9196-0d05-0e59-265626120a44
msgctxt "h90dd87e6ge46fg4f8ag8829gaafb43398642"
msgid "I wanted to reward you."
msgstr "난 보상이 주고 싶었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2a8270d7-c9a5-ba26-5783-99e501b6d1c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2a8270d7-c9a5-ba26-5783-99e501b6d1c9
msgctxt "h312c4816g4c62g4e9bgac06gad54134250d6"
msgid "Well - if they're not revolted by those hideous horns."
msgstr "뭐, 그 흉측한 뿔을 혐오스러하지 않을 때 얘기지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2b690562-bd4b-7b2a-00c9-874b4d1f310f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2b690562-bd4b-7b2a-00c9-874b4d1f310f
msgctxt "h04cf113cgec0fg4d91gb2c0g068728844ddf"
msgid "Correct. I didn't."
msgstr "맞아. 그런 적 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2ce0b9b0-cddc-24f0-6494-a3a7c9a1b060
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2ce0b9b0-cddc-24f0-6494-a3a7c9a1b060
msgctxt "ha5b7993egc185g4dc3g987bgee11f3bbcc45"
msgid "Like I said. I'm the giving type."
msgstr "아까도 말했지만, 난 주는 쪽이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2d1f2ffd-ece1-046c-a4b4-1d67565cb674
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2d1f2ffd-ece1-046c-a4b4-1d67565cb674
msgctxt "h77956954gc92ag4364g8ee4g5cf762a56caf"
msgid "They <i>do</i> have cats from where you come from, don't they? Hm."
msgstr "네 고향에도 고양이라는 게 <i>있긴</i> 하지? 흠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 2d531348-e783-9877-d677-26c4ac78f2c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2d531348-e783-9877-d677-26c4ac78f2c5
msgctxt "hb1ee8641g1fd6g4965g8772g5976c7e92592"
msgid "There are plenty of cultists and monsters to go around. Take your pick."
msgstr "찾아갈 광신도나 괴물이야 사방에 널렸지. 네가 한 번 골라 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 2e00b922-0b74-0f11-97e9-4ac9c32e0152
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:2e00b922-0b74-0f11-97e9-4ac9c32e0152
msgctxt "h1e070ec0g876fg41a0ga4dbg309586658df6"
msgid ""
"If you must know, I was scouting the cultists on behalf of Zariel. But those "
"cursed shadows were thick enough to fell even a half-fiend."
msgstr ""
"어떻게 된 거냐면, 난 그때 자리엘 님을 대신해 교단 놈들을 정찰하고 있었어. 근데 그 그림자 저주가 나 같은 반 마족도 떨어뜨릴 만큼 "
"강하더라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 30f427f2-082e-28c9-a396-664df092adc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:30f427f2-082e-28c9-a396-664df092adc7
msgctxt "h54c8809agd181g42cdg91e3g0c0e51199f73"
msgid ""
"I am a woman of my word. Go to Gortash's secret prison, and I'll help you "
"spring your daddy free."
msgstr "난 했던 말은 지키는 여자야. 고타쉬의 비밀 감옥으로 가 봐, 그러면 네 아빠 구하는 걸 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 31b77fcd-d64e-5494-a63e-25863fe3d3a1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:31b77fcd-d64e-5494-a63e-25863fe3d3a1
msgctxt "hb66fe142g6a02g4f83gb9f3gf6b2504100eb"
msgid "Have your pick of the prey - within reason, of course."
msgstr "어떤 놈한테 갈지 마음대로 골라 봐. 당연히 이유는 있어야겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 31b77fcd-d64e-5494-a63e-25863fe3d3a1
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:31b77fcd-d64e-5494-a63e-25863fe3d3a1
msgctxt "hab16deceg5548g44d7gb2b9g3ca275f77fc8"
msgid "He'll have his pick of the prey - within reason, of course."
msgstr "어떤 놈이든 윌 맘대로 골라잡으면 돼. 당연히 이유는 있어야겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 323b3dc8-ed6d-2348-e292-b36c5c931b54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:323b3dc8-ed6d-2348-e292-b36c5c931b54
msgctxt "haf36a299gbf3eg4bf4g9d65g76f30068c9f8"
msgid "I just never expected you'd speed up the process."
msgstr "네가 그걸 앞당길 줄은 예상 못 했지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 33f114f0-4f97-9d41-f593-8faa17d8d938
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:33f114f0-4f97-9d41-f593-8faa17d8d938
msgctxt "h3f1771b3ge576g44b9ga8e4g38a33b3d9757"
msgid ""
"Alas, she misses the fallen duke. Someone will need to step up in his "
"absence, a man with the spirit of a dragon."
msgstr ""
"아아, 대공님을 정말 그리워하고 있겠지. 누군가 그분의 빈자리를 채워 줄 사람이 나타나 줘야 할텐데. 드래곤 같은 기백을 가진 그런 사람 "
"말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 34020b3f-b86b-a58e-f281-f1cbac19e217
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:34020b3f-b86b-a58e-f281-f1cbac19e217
msgctxt "h5d5c9541gfc41g416dg8ba5gdf44bbf151ca"
msgid ""
"The other eight, well, they are pleasures unto themselves. I pity those who "
"can never know them."
msgstr "나머지 여덟 곳도 뭐, 그 자체로 즐거운 곳이지. 그걸 모른 채 사는 건 인생 손해 보는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 34dac75c-cccc-b7c0-956d-800ceb501e57
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:34dac75c-cccc-b7c0-956d-800ceb501e57
msgctxt "hd5c3bd92g045dg494cga53cg976db7201e42"
msgid "Savour it, sister. Who's to say when Zariel might change her mind?"
msgstr "한번 맘껏 날뛰어 봐, 동생아. 네 활약상을 보고 자리엘 님께서 마음이 바뀔지 누가 아니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 34dac75c-cccc-b7c0-956d-800ceb501e57
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:34dac75c-cccc-b7c0-956d-800ceb501e57
msgctxt "h25b98ff6g93a6g4095g9266ga3546e3d8b91"
msgid "Savour her company. Who's to say when Zariel might change her mind?"
msgstr "그 애를 한 번 맘껏 날뛰게 해 봐. 걔 활약상을 보고 자리엘 님께서 마음이 바뀔지 누가 아니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 351c6f7c-2d36-9554-7a6d-5f76d69e16be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:351c6f7c-2d36-9554-7a6d-5f76d69e16be
msgctxt "hd8b756c8gba41g41c4g8ea2g71520b433707"
msgid "How I <i>adore</i> it. The delicious agony of it all."
msgstr "정말 <i>황홀한</i> 곳이야. 그 모든 고통의 달콤함이란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 352ffe56-7ac8-d572-b6d6-992f579e10ad
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:352ffe56-7ac8-d572-b6d6-992f579e10ad
msgctxt "h38b06772g21c1g45b6g932ag5e11d579d259"
msgid ""
"Roam where you want, pup. But don't give me a reason to tighten the leash."
msgstr "너 가고 싶은 데로 가봐, 멍멍아. 하지만 엉뚱한 곳으로 가서 내가 나설 일은 없게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 352ffe56-7ac8-d572-b6d6-992f579e10ad
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:352ffe56-7ac8-d572-b6d6-992f579e10ad
msgctxt "h1cbf7af1g8e14g46e2gb3a8ga162eaa811f4"
msgid ""
"He can roam where he wants - until he gives me a reason to tighten the leash."
msgstr "엉뚱한 곳으로 가서 내가 나설 일만 없다면야, 멍멍이는 어디든 가도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 3562ad79-16e6-4902-bbc0-7a86f6340aa6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dbeade8e-5b5b-89b3-e348-6845275fa885_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3562ad79-16e6-4902-bbc0-7a86f6340aa6
msgctxt "h84ddebf7gae1fg4e4bgb2b6g207bb7217eeb"
msgid ""
"<i>Ravengard will fall. I will strike when the Duke has the most to lose - "
"and I have the most to gain.</i>"
msgstr "<i>레이븐가드는 무너질 거야. 그 남자가 잃을 것이 가장 많고, 난 얻을 것이 가장 많을 때 그 남자를 치겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 35fbdc52-4fb1-494d-be74-9a39bab27452
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:35fbdc52-4fb1-494d-be74-9a39bab27452
msgctxt "h780c1ef3gf3d9g416ag84bcg91a97f2834c4"
msgid ""
"Yes. You're curious - your good eye is lit like a raging star. You want what "
"only I can give you."
msgstr "눈 반짝이는 것 봐. 이제 좀 관심이 생기시나 보네. 이런 걸 줄 수 있는 건 나밖에 없긴 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 35fbdc52-4fb1-494d-be74-9a39bab27452
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:35fbdc52-4fb1-494d-be74-9a39bab27452
msgctxt "h33dc7706g1d8cg48a3g9529gaeecf00af6a5"
msgid ""
"Yes. You're curious - your eyes are lit like raging stars. You want what "
"only I can give you."
msgstr "눈 반짝이는 것 봐. 이제 좀 관심이 생기시나 보네. 이런 걸 줄 수 있는 건 나밖에 없긴 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 36670de8-8b9e-a222-2de3-fe19a7e24b14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:36670de8-8b9e-a222-2de3-fe19a7e24b14
msgctxt "hae5eb3f2gcdfcg4519g92acg7cfb9b564fd8"
msgid ""
"Clause One, Section One: <i>'Soul-bearer pledges his soul to half-fiend "
"Mizora and the archdevil Zariel in a pact eternal.'</i>"
msgstr ""
"1조, 제1항. <i>'영혼 소지인은 영원한 계약에 따라 아크데빌 자리엘과 반 마족 미조라에게 영혼을 바칠 것을 맹세한다.'</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 36c5ca5a-a81c-1f29-80cf-6ea3f0d5574e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:36c5ca5a-a81c-1f29-80cf-6ea3f0d5574e
msgctxt "h5bf8072bg93eag4341gb909g4f2dead2138a"
msgid ""
"The clause still holds. As long as Wyll doesn't tug on my leash, he'll be "
"stalking only the wickedest prey."
msgstr "계약은 아직 유효해. 내가 시키는 대로만 하면 윌은 가장 쟁쟁한 상대들과 붙게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 39001c4b-8d66-8283-d512-0f388a775fb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:39001c4b-8d66-8283-d512-0f388a775fb6
msgctxt "hd92805bege881g4cbdg9323gef5fa280268c"
msgid "Well, not exactly. But it's only a matter of time."
msgstr "글쎄, 아직은 모르지. 더 시간 끌면 진짜로 그렇게 되겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 39c2ed20-0ee2-c572-6d87-2d74a87a8104
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:39c2ed20-0ee2-c572-6d87-2d74a87a8104
msgctxt "hc217583dgb497g4efbg8b91gb134db6ccf70"
msgid "I wanted to handle it myself. He had it coming."
msgstr "내가 직접 손 봐주고 싶었어. 그 자식이 자초한 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 3b15d10f-3872-a09a-1cc4-72b5de516b61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3b15d10f-3872-a09a-1cc4-72b5de516b61
msgctxt "ha2bee6d2gcb94g47f4g892dg56ed9753c9d0"
msgid "You turned the pain of the damned into impossible pleasure."
msgstr "넌 망자들의 고통을 네 말도 안 되는 쾌락을 느끼는 일에 써버린 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 3c251161-fb61-9415-5d82-d30b2d7f952c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3c251161-fb61-9415-5d82-d30b2d7f952c
msgctxt "h939f34dfg634bg48ccgac3egc6cc740d951d"
msgid "I beg your forgiveness for such undue impertinence."
msgstr "미안해, 내가 너무 주제넘은 말을 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 3c6edb00-b32c-84fc-eea9-0572655e1d98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3c6edb00-b32c-84fc-eea9-0572655e1d98
msgctxt "hc42bb0a0gc7e0g474eg896cgaebee726ac07"
msgid "You forced Wyll to make an impossible choice."
msgstr "넌 윌한테 말도 안 되는 선택을 강요했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 3c843990-cfc9-a42d-819f-60b07cf11e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3c843990-cfc9-a42d-819f-60b07cf11e03
msgctxt "h15b86d61gb4e3g48acga0e1g11335330ad05"
msgid ""
"I thought as much. You moaned like a dragon thrice-struck with a broadsword."
msgstr "그런 것 같더라. 무슨 드래곤이 브로드 소드로 세 번 맞은 듯한 신음을 내던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 3caf9158-f75e-ecdd-918d-4c9e51a56d28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3caf9158-f75e-ecdd-918d-4c9e51a56d28
msgctxt "h9f9e243agcbbeg477bgaf59g430bca6184b7"
msgid "Since I made you a devil, the heat of Avernus burns ever hotter in you."
msgstr "네가 데빌이 되고 나서 안 건데, 아베르누스의 불길은 네 안에서 더 뜨겁게 타오르는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 3d0f573a-127c-70ee-0ba2-f18c8e2e8ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3d0f573a-127c-70ee-0ba2-f18c8e2e8ef1
msgctxt "hf94e0e2fgb446g465cg991agcf883ab20533"
msgid ""
"Indeed - a bargain's a bargain. And the man who skirts a sworn pact is "
"living on borrowed time."
msgstr "그럼. 거래는 거래지. 그리고 계약을 어긴 자의 말로는 바람 앞의 등불 같은 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 3d4a8c58-7aa6-b022-8761-a7b4e37f0448
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3d4a8c58-7aa6-b022-8761-a7b4e37f0448
msgctxt "ha975934eg0e1ag4bcagbc60ge529fd545cd2"
msgid "That's it, then. Duke Ravengard's dead."
msgstr "다 끝난 일이야. 레이븐가드 대공은 돌아가셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 3fdf3c2c-03b0-1bab-a242-cb83a7f8a74e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_GivingType(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:3fdf3c2c-03b0-1bab-a242-cb83a7f8a74e
msgctxt "h5d99faaag8370g47a8gab7cg99a8762004dc"
msgid ""
"I tell you what. When the time comes to squish that big baddie of a brain, "
"I'll lend you a hand."
msgstr "그럼 이렇게 하자. 언젠가 네가 그 사악한 뇌하고 붙게 되면, 나도 도와주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 40199850-fe0a-52de-c532-98d56ce4eadf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_FlorrickFighFallback_Event_Occurred = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:40199850-fe0a-52de-c532-98d56ce4eadf
msgctxt "h115d4fa8ge18eg4a9dg9031g69383b1e6ca8"
msgid ""
"What a shame. Ravengard, Eltan - Baldur's Gate has lost its brightest stars."
msgstr "안타깝게 됐네. 레이븐가드에 엘탄까지. 발더스 게이트의 가장 빛나는 별들이 사라지다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 401ba423-3d6a-0361-ae2d-4a5cacfaf4ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_FlorrickFight_Event_FlorrickFightStarted = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:401ba423-3d6a-0361-ae2d-4a5cacfaf4ae
msgctxt "h00d11dbfg1250g4163g9863g9af5a4252cf8"
msgid ""
"Florrick accosted us in the Lower City. What in the hells did you tell her?"
msgstr "하부 도시에서 플로릭이랑 문제가 있었다. 그 여자한테 대체 무슨 짓을 한 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 40278b16-ffab-2ec9-afd0-f61e548e2fdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:40278b16-ffab-2ec9-afd0-f61e548e2fdd
msgctxt "h040b35e0g7a52g492cg85efgdb364733a6e3"
msgid ""
"Cut the shit, Mizora. How dare you force me to make such an impossible "
"choice?"
msgstr "헛소리 집어치워, 미조라. 감히 내가 그런 말도 안 되는 결정을 하게 만들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 402fcb0b-306a-d684-4c82-c4926132d175
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:402fcb0b-306a-d684-4c82-c4926132d175
msgctxt "h6eae9bd8g83ebg4133g8168g60cc91d303c7"
msgid "You forced Wyll to make an impossible choice."
msgstr "넌 윌한테 불가능한 선택을 강요했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 40813045-f008-1d6c-e20b-e0984abaa111
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:40813045-f008-1d6c-e20b-e0984abaa111
msgctxt "h2e9e3dd1g1683g4392gb515gd6b20523214e"
msgid "Words of temptation - the kind used by a patron seeking a pact."
msgstr "그럴듯한 말로 꼬시려는 걸 보니, 계약할 대상을 찾는 중인가 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 44af944a-ec47-ece9-fc8f-a881a1f8d392
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:44af944a-ec47-ece9-fc8f-a881a1f8d392
msgctxt "h574531a0g809ag4044g9b5dgd1de56c25fb9"
msgid "I'm afraid that's not an option. I'm quite stubborn, you see."
msgstr "그렇겐 안 되겠는데. 너도 알겠지만 내가 꽤 고집이 세거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 45597bf8-3407-5875-ca4d-b28c0bdc1523
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:45597bf8-3407-5875-ca4d-b28c0bdc1523
msgctxt "h7ae39f6dg7607g42f7gb65egab232f860d63"
msgid ""
"From now on, I promise him the same measure of respect he's shown his father."
msgstr "이제부터는, 나도 윌이 그랬던 만큼 레이븐가드를 존중할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 457b730b-5e4d-3860-d677-f0cdca24a121
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:457b730b-5e4d-3860-d677-f0cdca24a121
msgctxt "h61a3007cg9426g45b5gad3bg5ca38de40c96"
msgid ""
"Goodness. I hardly expect such obscenity from the heroic Blade of Frontiers."
msgstr "세상에. 우리 모범적인 칼날 님의 입에서 저런 말이 나올 줄이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 469cd758-0812-a9ca-c8f1-010f6555d516
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:469cd758-0812-a9ca-c8f1-010f6555d516
msgctxt "h94523e59g9110g4412g915agaf5041c0996e"
msgid "I am glad my father's safe. But I won't thank you for it."
msgstr "아버지를 살린 건 기쁜 일이지만, 네게 감사 인사를 할 생각은 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 46b1396a-9833-232c-47b4-89ee96e4d393
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:46b1396a-9833-232c-47b4-89ee96e4d393
msgctxt "hd76d96f4gc220g4d4ega939g91bbc89b4006"
msgid "I should be angry with you. But I'm just in awe of your cunning."
msgstr "원래는 화가 나야 맞겠지. 근데 난 네 그런 교활한 모습이 나쁘지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 46bbb24c-c182-4ca8-9554-2e92bd2f9437
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:46bbb24c-c182-4ca8-9554-2e92bd2f9437
msgctxt "hde7e835dg385ag4adeg9868g70d6527a777e"
msgid ""
"I know you want me, Karlach. You don't want to want me, of course. Which "
"makes the longing all the more agonising."
msgstr "네가 나 좋아하는 거 알아, 칼라크. 물론 넌 부정하고 싶겠지. 그래서 계속 고통스러운 시간을 보내고 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 485cbbef-b335-a264-2938-de436ee9a2cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:485cbbef-b335-a264-2938-de436ee9a2cb
msgctxt "hca30d6e7gbb96g4c0bg9b6ega7ae30664372"
msgid "I promise you the same measure of respect you've shown your father."
msgstr "앞으로는 나도 너만큼이나 네 아빠를 존중하겠다고 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 48cae2fd-dc59-4861-008c-f0f40b0d6427
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_State_RavengardInCamp = False
#.      - LOW_FlorrickFight_Event_FlorrickFightStarted = True
#.   Object:
#.      - CAMP_Mizora_Event_TalkedAboutAmbush(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_TalkedAboutAmbush(1) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:48cae2fd-dc59-4861-008c-f0f40b0d6427
msgctxt "h669e6adeg6f3bg4cdag9ea0g2f1efe5bfddc"
msgid "What do <i>you </i>want?"
msgstr "<i>넌</i> 또 뭐가 문젠데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 48cae2fd-dc59-4861-008c-f0f40b0d6427
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_State_RavengardInCamp = False
#.      - LOW_FlorrickFight_Event_FlorrickFightStarted = True
#.   Object:
#.      - CAMP_Mizora_Event_TalkedAboutAmbush(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_TalkedAboutAmbush(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:48cae2fd-dc59-4861-008c-f0f40b0d6427
msgctxt "h7fc3bc1fg62e3g484cgaacfg2cf6c0eec85e"
msgid "Something on your mind?"
msgstr "하고 싶은 말 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 4989f2c2-ee68-5e0a-9652-41362c3f004a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4989f2c2-ee68-5e0a-9652-41362c3f004a
msgctxt "h3224dddcg41feg444bgb9d0g2ff800f80f7c"
msgid ""
"Is it possible? Could the courageous Wyll Ravengard be this heartbreakingly "
"naive?"
msgstr "이게 말이 되나? 그 용감한 윌 레이븐가드께서 이렇게 불쌍할 정도로 순진하셨다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 4a5cbad5-a0b8-fadf-4352-7fabab16cc22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4a5cbad5-a0b8-fadf-4352-7fabab16cc22
msgctxt "h57de2412g4985g4755gb305g89d7d7fc79e1"
msgid ""
"I... sacrificed my own father to save myself. What kind of monster have I "
"become?"
msgstr "난... 내 목숨 부지하겠다고 아버지를 죽였어. 난 대체 무슨 짐승 새끼가 된 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 4abf57a5-891e-a88e-3f8a-0c575010bf8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#.   Tag:
#.      - WYLL_DEVIL(1) = False
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4abf57a5-891e-a88e-3f8a-0c575010bf8c
msgctxt "he5fe6d74gb2fbg47caga298g07149845430c"
msgid ""
"You've been an ardent hellhound and hunter, Wyll - ever so eager to please. "
"But I've seen something new:"
msgstr "항상 열렬한 지옥사냥개이자 사냥꾼으로서 고생 많았어, 윌. 그래서인가 너 요즘..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 4b2e392d-7e25-90df-f94d-a1adc1f1e2e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4b2e392d-7e25-90df-f94d-a1adc1f1e2e7
msgctxt "h8195c0c4ge093g4056g9dbfgd99d10b891ac"
msgid "Oh, sister. I'm going to make this very worth your while."
msgstr "우리 동생. 절대 잊지 못할 밤으로 만들어 줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 4b684a32-718d-890d-ddd2-da727d956309
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4b684a32-718d-890d-ddd2-da727d956309
msgctxt "h2c7abda9gb560g41e3g9088g431f514c0ade"
msgid ""
"Take a swing or a stab if you want, but I'll just slip away for a breather. "
"One of the perks of being a half-devil, of course."
msgstr "때리든 찌르든 뭘 해도 상관없는데, 난 잠깐 다른 데 가서 쉬었다 올게. 이런 게 하프데빌의 특권이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 4b747ab0-2df5-f731-bda4-a8ad37f4e295
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4b747ab0-2df5-f731-bda4-a8ad37f4e295
msgctxt "h7de80cacg204cg4773g887dga477b77915ad"
msgid "I'm sure my infected head has room for a hint, at least."
msgstr "내 감염된 머릿속에도 정보 하나 들어갈 공간은 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 4c56592b-c89c-6b7a-3c70-689f1ebfb781
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4c56592b-c89c-6b7a-3c70-689f1ebfb781
msgctxt "h07dfc378g3118g4110g9517g04a6cecdcd44"
msgid "Now now, you know what they say about curiosity and cats."
msgstr "너무 캐묻지 마. 목숨이 아홉 개인 고양이도 호기심 때문에 죽었다는 말이 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 4c8791bc-511c-5c5a-5bf7-cfd0c277d14b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4c8791bc-511c-5c5a-5bf7-cfd0c277d14b
msgctxt "hb90d2322g5423g459cgbea6g7be4fc60f3ad"
msgid "Come for a chat?"
msgstr "할 말 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 4f1ea543-06a8-343b-7a91-cc54edeb1299
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_FlorrickFight_Event_StoodDown = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:4f1ea543-06a8-343b-7a91-cc54edeb1299
msgctxt "h7be56355g7905g4a9eg8d89g07b262fea798"
msgid ""
"With the duke and his closest confidantes gone, someone will need to step up "
"in their absence. A man with the spirit of a dragon."
msgstr ""
"이제 대공도, 그분의 측근도 모두 죽어버렸으니 누군가 나서서 그 빈 자리를 채워줘야겠네. 드래곤 같은 기백을 가진 그런 사람 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 50c2b252-408d-153c-cb12-3bfbc00f42d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:50c2b252-408d-153c-cb12-3bfbc00f42d3
msgctxt "hc13263d3g56efg448ag8138gcf01e5f139f1"
msgid ""
"The Dead Three had such big plans for him. Seems someone else had even "
"bigger ones."
msgstr "삼악신들한테 그자를 이용해 진행할 어마어마한 계획이 있었는데. 근데 그보다 더 큰 계획을 세운 사람이 있었나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 50eaf646-7e09-13ce-1070-31fb4802f184
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:50eaf646-7e09-13ce-1070-31fb4802f184
msgctxt "h5d739ac7g865fg46a7g8608g5e3b7513b32b"
msgid ""
"Such is the lure of power, I suppose. With your father gone, the people will "
"look to his heir for direction."
msgstr "권력의 유혹이란 참 무섭구나. 어쨌든 대공님이 돌아가셨으니, 백성들은 그 후계자의 지시를 기다리고 있겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 51503952-e241-d8db-598f-11a2ebc1b5ef
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:51503952-e241-d8db-598f-11a2ebc1b5ef
msgctxt "h4d4009e0gdb2cg4fb9g82ffg541c0ec69c10"
msgid "You'd be sucked into Avernus and take up arms in the Blood War."
msgstr "아베르누스로 빨려 들어가서 피의 전쟁에 참여하게 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 51503952-e241-d8db-598f-11a2ebc1b5ef
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:51503952-e241-d8db-598f-11a2ebc1b5ef
msgctxt "h4949eba6g1f9ag4e65g9f46g4e27baadf377"
msgid ""
"Young Wyll would be sucked into Avernus and take up arms in the Blood War."
msgstr "우리 귀여운 윌이 아베르누스로 빨려 들어가서 피의 전쟁에 참여하게 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 51f51634-ac76-def0-88d0-24d4fab567cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:51f51634-ac76-def0-88d0-24d4fab567cc
msgctxt "h4037960ag417dg4a8cg817agafd8abeeba03"
msgid "Have it your way."
msgstr "그래, 알았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5245c04d-a2c3-0fa3-c3e4-24b3d1e69fd4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5245c04d-a2c3-0fa3-c3e4-24b3d1e69fd4
msgctxt "h39deaf11gdeb2g4000ga43fgd9454e04a75e"
msgid ""
"Focus on the elder brain, Wyll. I'd hate to clog that infected head of yours "
"with needless details."
msgstr "엘더 브레인에 집중해, 윌. 그 감염된 머릿속에 쓸데없는 정보 집어넣지 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5245c04d-a2c3-0fa3-c3e4-24b3d1e69fd4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5245c04d-a2c3-0fa3-c3e4-24b3d1e69fd4
msgctxt "hf2757becgd058g4144g8491g31c78ed14432"
msgid ""
"Focus on the elder brain. I'd hate to clog that infected head of yours with "
"needless details."
msgstr "엘더 브레인에 집중해. 그 감염된 머릿속에 쓸데없는 정보 집어넣지 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 528c506f-7a21-9050-19c5-27b82a957b9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:528c506f-7a21-9050-19c5-27b82a957b9b
msgctxt "h75036fc4g6464g4491g9dbagaf19850c56e5"
msgid ""
"I would have done the same thing in his shoes. But what do I know about "
"heroes?"
msgstr "내가 윌이었어도 그렇게 했을 거야. 영웅의 심리 따위야 난 모르지만, 그러지 않겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 547322a4-4ba9-d589-b6b3-c1be6885fa82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:547322a4-4ba9-d589-b6b3-c1be6885fa82
msgctxt "hacfe33e8gcd98g4110g912bg81539cfebc38"
msgid "So what's your first order of business, sir duke?"
msgstr "그럼, 이제 누구한테 먼저 가시겠어요, 대공님?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 5688d8fa-229a-70af-b59b-9c0a2bc25d20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Orin_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5688d8fa-229a-70af-b59b-9c0a2bc25d20
msgctxt "h387044e0g53cbg463eg95a5g623c474bf3fb"
msgid "Orin the Red, Bhaal's Chosen."
msgstr "바알의 선택받은 자, 적색의 오린한테 간다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 58990b01-f57f-7452-fa4f-28825406f6ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:58990b01-f57f-7452-fa4f-28825406f6ee
msgctxt "he8fd4eeeg6e77g4a0dg9e9bge43a05fce351"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 58fdef46-655f-9930-56e4-6aa66aa777e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:58fdef46-655f-9930-56e4-6aa66aa777e4
msgctxt "he532e3fagf00bg4ea7g9860g644ad914f9eb"
msgid ""
"Clause A, Section Two: <i>'Should soul-holder choose to abandon his patron, "
"he is freed from his duty. His father, Grand Duke Ulder Ravengard, will be "
"thus fated to die by an enemy's hand.'</i>"
msgstr ""
"A조, 제2항. <i>'영혼 보유인이 자신의 후원자를 저버릴 경우 자신의 의무로부터 해방되지만, 그의 아버지 레이븐가드 대공은 적의 손에 "
"죽음을 맞이한다.'</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 596d129a-df6c-86ae-8236-72fe5b46539a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:596d129a-df6c-86ae-8236-72fe5b46539a
msgctxt "h17ffc2dfg6232g494dg9b3eg80aec7fd676f"
msgid ""
"Is it a shame, though? Is a single soul not worth the return of Baldur's "
"Gate's most beloved duke?"
msgstr "안타까워해야 하나? 발더스 게이트의 가장 사랑받는 대공님께서 돌아올 수 있다는데 영혼 하나 정도는 바칠 만하잖아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 59b2740b-5d8f-1027-9b4b-edc7aa366b31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:59b2740b-5d8f-1027-9b4b-edc7aa366b31
msgctxt "h5f1cc72agd0eeg4e7fg87f1g22101399d96c"
msgid ""
"Pro: freedom. No more pact, no more hellbound soul. Con: killing off your "
"own father, Baldur's Gate's most beloved duke, and forever altering the "
"city's future."
msgstr ""
"장점은 자유로워졌다는 거지. 계약도 끝났고, 지옥에 영혼이 묶여있거나 하지도 않고. 단점은 발더스 게이트의 가장 사랑받는 대공인 자기 "
"아빠가 도시의 미래를 위해 희생됐다는 게 있겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 59b3d171-ee24-3baa-6203-9a774692c045
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:59b3d171-ee24-3baa-6203-9a774692c045
msgctxt "h91ec4b03g2a94g45f1g9fadgeb03fddec42a"
msgid ""
"Cut the shit, Mizora. How dare you force me to make such an impossible "
"choice?"
msgstr "헛소리 집어치워, 미조라. 감히 내가 그런 말도 안 되는 결정을 하게 만들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5a4cd571-3872-4568-2032-39d2084429ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5a4cd571-3872-4568-2032-39d2084429ee
msgctxt "h348ae7a7g0f0ag4fa2g9c18gb9a975384f07"
msgid ""
"What a relief. It would be a shame if she'd struck down the one and only "
"Blade."
msgstr "다행이네. 세상에 단 하나뿐인 우리 칼날 님께서 그 여자에게 쓰러졌다면 정말 안타까웠을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 5a916568-ba71-dd58-a0e5-ea044af3de84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5a916568-ba71-dd58-a0e5-ea044af3de84
msgctxt "h91053956g90e1g458cg9a94g511a7200e033"
msgid "I should be angry with you. But I'm just in awe of your cunning."
msgstr "원래는 화가 나야 맞겠지. 근데 난 네 그런 교활한 모습이 나쁘지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 5b07093d-ae4e-d54d-7607-854e0d1b76a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5b07093d-ae4e-d54d-7607-854e0d1b76a4
msgctxt "h47d264cagf0ccg42afgb0e2gdc8b9a80da86"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5b434719-d85a-896b-2bc7-216576b05316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5b434719-d85a-896b-2bc7-216576b05316
msgctxt "h947194fcg3343g456fgb9d9gda820e017228"
msgid ""
"<i>Tell</i> me you haven't forgotten. Once the Absolute is no more, so is my "
"aid."
msgstr "내 말 <i>명심해</i>. 절대자가 없으면, 내 도움도 없는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5bd680af-182c-d4b6-9d8d-de0d9a2878d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#.   Object:
#.      - CAMP_Mizora_Event_ReleasedIntro(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_ReleasedIntro(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5bd680af-182c-d4b6-9d8d-de0d9a2878d5
msgctxt "h65693e42g4b24g47f8g992bg54eabefa9186"
msgid ""
"Little Wyll's all grown up. I can't <i>wait</i> to see what trouble he gets "
"into."
msgstr "윌도 완전 남자가 다 됐네. 이제 또 무슨 사고를 칠지 궁금해서 못 <i>참겠어</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5c1ee832-2772-ad76-5afc-2c8aa33f38c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5c1ee832-2772-ad76-5afc-2c8aa33f38c4
msgctxt "h8af46e9cgabbfg4b7ag8ca9g86fa2f270a83"
msgid "Goodness me. For all that, a lone soul is a bargain."
msgstr "세상에. 그 모든 게 이뤄질 수 있다면야, 영혼 하나 쯤은 바칠 만하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 5cd913e7-f33c-0442-d5e0-fe07070d5ff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5cd913e7-f33c-0442-d5e0-fe07070d5ff8
msgctxt "h4e664b42g89f3g47a4gbeceg5d1628070fa4"
msgid "Hello, Mizora. Or should I say 'Lady Mizora'?"
msgstr "반갑군, 미조라. 아니면 '미조라 부인'이라고 해야 하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 5e8f17d7-fc06-1883-0cdd-9e7911d6cf71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5e8f17d7-fc06-1883-0cdd-9e7911d6cf71
msgctxt "h8c791287g5f63g48e1gb7b0g1bb92f2ba257"
msgid "Stupendous."
msgstr "끝내줬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5f287644-3430-7803-4a90-60fa3ee10d9f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5f287644-3430-7803-4a90-60fa3ee10d9f
msgctxt "h2f59c936gffdfg4f72g93e4gc1de37441367"
msgid ""
"Cunning, am I? Ah, you see me as a schemer, an exploiter. You've pegged me "
"wrong, Wyll."
msgstr "교활하다고? 날 무슨 치사한 계획이나 세우고 남 등쳐먹는 사람으로 본 모양이네. 네가 헛짚은 거야, 윌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 5f287644-3430-7803-4a90-60fa3ee10d9f
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5f287644-3430-7803-4a90-60fa3ee10d9f
msgctxt "h8651be4cg99a5g4a7cg8821g7724e1261673"
msgid ""
"Cunning, am I? Ah, you see me as a schemer, an exploiter. You've pegged me "
"wrong, little bug."
msgstr "교활하다고? 날 무슨 치사한 계획이나 세우고 남 등쳐먹는 사람으로 본 모양이네. 네가 헛짚은 거야, 꼬물아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 5fe48784-833c-fd44-79ee-5fe0f59c0f38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:5fe48784-833c-fd44-79ee-5fe0f59c0f38
msgctxt "h37bb0c25g06f0g4048gb834gae4f2307eaeb"
msgid "I have no idea what you're on about."
msgstr "무슨 뜻인지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 60641254-c07b-e888-7379-d0a11f10cc65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:60641254-c07b-e888-7379-d0a11f10cc65
msgctxt "h998bfe0agaac8g4a07g9f00g776927d6ff52"
msgid ""
"*Sigh.* Wyll's a gifted hunter. And Zariel's made her share of enemies in "
"and out of the Hells."
msgstr "*하아*. 윌은 타고난 사냥꾼이야. 그리고 자리엘 님께선 지옥 안팎으로 적들이 많지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 60e0fff9-6d7d-f340-b321-d160b4f10cd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:60e0fff9-6d7d-f340-b321-d160b4f10cd0
msgctxt "h56bea30bg719cg4918ga421g0dbf1d3cedf9"
msgid ""
"Yes. To kill the Absolute, to free the infected, to end the illithid Grand "
"Design. Could there be a more heroic journey?"
msgstr "그래. 절대자를 죽이고, 감염자들을 풀어주고, 일리시드의 원대한 설계도 끝장내는 거야. 이보다 영웅적인 여정이 어디 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 6173d2c3-02e4-03ee-f0e9-3be4ad045bd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6173d2c3-02e4-03ee-f0e9-3be4ad045bd9
msgctxt "hfa888dc8g1614g404eg827cgae24a3d4d3f8"
msgid "I'd do anything for Wyll. That includes not murdering you on the spot."
msgstr "여기서 널 죽여버리고 싶지만, 윌을 봐서 참겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 620fac04-a0d1-7a96-4fa3-2c57cc166ce6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:620fac04-a0d1-7a96-4fa3-2c57cc166ce6
msgctxt "h958b661bg6acag432dgb506gcc338ca55822"
msgid "So-so, to be honest."
msgstr "솔직히 그냥 그랬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 62c119d5-1d9e-d6bb-4cb6-9048b878b873
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:62c119d5-1d9e-d6bb-4cb6-9048b878b873
msgctxt "h0c9fff03g8af9g48ebg903fg12400ce566e2"
msgid "Gortash, Bane's Chosen."
msgstr "베인의 선택받은 자, 고타쉬에게 가지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = 63738eff-4d14-46dd-622c-38efe1509ae9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:63738eff-4d14-46dd-622c-38efe1509ae9
msgctxt "he8796497g29ffg4900gb2ebg6baf0f9e3503"
msgid "Damn I right I did. My father is safe and my chains are broken!"
msgstr "해냈고 말고. 아버지도 구해냈고 계약에서도 풀려났지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 64a20165-e3f8-d2e0-1219-2086b2c4afbc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:64a20165-e3f8-d2e0-1219-2086b2c4afbc
msgctxt "h1b8b8da2g1946g42c5g8d2agc338a15c3a2f"
msgid ""
"I call the first hell my home. Avernus, my mistress Zariel's realm - a "
"torrid battleground split by the bloody waters of the Styx. As well you "
"know, Wyll."
msgstr ""
"내 고향은 첫 번째 지옥이야. 아베르누스. 나의 여제 자리엘 님의 영역이자 스틱스의 핏빛 물줄기로 갈라진 치열한 전장이지. 윌 너도 알고 "
"있겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 64a20165-e3f8-d2e0-1219-2086b2c4afbc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:64a20165-e3f8-d2e0-1219-2086b2c4afbc
msgctxt "h29ff7d62g9bb6g46d4g9114g36cfb3e48600"
msgid ""
"I call the first hell my home. Avernus, my mistress Zariel's realm - a "
"torrid battleground split by the bloody waters of the Styx. As well you "
"know, Karlach."
msgstr ""
"내 고향은 첫 번째 지옥이야. 아베르누스. 나의 여제 자리엘 님의 영역이자 스틱스의 핏빛 물줄기로 갈라진 치열한 전장이지. 칼라크 너도 "
"알고 있겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 64a20165-e3f8-d2e0-1219-2086b2c4afbc
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:64a20165-e3f8-d2e0-1219-2086b2c4afbc
msgctxt "hcca887ddga74ag4b65gb909gf1c86e68579b"
msgid ""
"I call the first hell my home. Avernus, my mistress Zariel's realm - a "
"torrid battleground split by the bloody waters of the Styx."
msgstr "내 고향은 첫 번째 지옥이야. 아베르누스. 나의 여제 자리엘 님의 영역이자 스틱스의 핏빛 물줄기로 갈라진 치열한 전장이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 64a68d05-5740-dfb2-aeaf-7c64865a73ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:64a68d05-5740-dfb2-aeaf-7c64865a73ec
msgctxt "h71e4b92fg8accg4c6eg90bbg68c2b548b569"
msgid "You're stuck with me for good."
msgstr "넌 이제 나한테서 절대로 못 벗어나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 650fd62f-0866-1d5e-275d-ec3d21293679
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:650fd62f-0866-1d5e-275d-ec3d21293679
msgctxt "h8842fde1g6428g4ff5gaaacg0eb583975479"
msgid "Someone who needed a bargaining chip. Whoever could <i>that</i> be?"
msgstr "자기 거래 협상에 쓸게 필요했던 사람 말이야. <i>그건</i> 대체 누구셨을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 667b3ec5-50cd-07d6-3b71-c78d82615a94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:667b3ec5-50cd-07d6-3b71-c78d82615a94
msgctxt "h3880e0f7g6b3fg4019ga25cgf78b62664e3e"
msgid ""
"Once the Absolute is no more, so is my aid. Poof - there go your warlock "
"powers."
msgstr "절대자가 없으면 내 도움도 없는 거야. 내가 뿅 하면 네 능력은 사라져 버릴 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 676e25b7-bebb-490a-9bad-1c4c25ea0ad1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Ravengard_State_RavengardInCamp = False
#.      - GLO_Ravengard_State_Defeated = False
#.      - CAMP_MizorasPact_State_WyllEternalPact = True
#.   Object:
#.      - CAMP_Mizora_Event_FreedIntro(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_FreedIntro(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:676e25b7-bebb-490a-9bad-1c4c25ea0ad1
msgctxt "h761958a7g856cg42d8gbeb7gb3487240c996"
msgid "Why the stunned face? You look like you've seen a devil."
msgstr "뭘 그렇게 놀라? 데빌이라도 봤다는 표정이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 696d680c-ca08-b056-8186-1576dbf9a5c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:696d680c-ca08-b056-8186-1576dbf9a5c7
msgctxt "h6ccf9bbdg6141g4776g8c94g14fe8de4763c"
msgid ""
"I sold you my soul for my father. You better fulfil your end of the bargain."
msgstr "난 아버지를 위해 영혼까지 팔았어. 거래에 그만한 가치가 있었어야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = 6974895d-2e95-d15b-e752-6aa063175781
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6974895d-2e95-d15b-e752-6aa063175781
msgctxt "h5e96847cg66d3g4d09g9345g4d81bf102e1d"
msgid "You know <i>exactl</i>y what's on my mind."
msgstr "내가 무슨 말 하려는지 <i>정확히</i> 알고 있을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 699233d6-1d22-49de-d286-614bbad818b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:699233d6-1d22-49de-d286-614bbad818b2
msgctxt "hc7a24aacg19d9g49efg9090gf2e038da8cbc"
msgid "All that time together, and you still find ways to surprise me."
msgstr "그렇게나 오래 봤는데, 넌 항상 날 놀라게 해준다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = 6b87683e-f32a-306e-9815-ff85e1788a8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6b87683e-f32a-306e-9815-ff85e1788a8b
msgctxt "h34a9461bg77c5g495bga5d3g6ff57bad6843"
msgid ""
"The elder brain is first on the list. Everything else will need to wait."
msgstr "엘더 브레인이 최우선이다. 다른 일은 나중에 처리하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6bb78ff4-6586-8c0c-b147-49d66f70fb56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6bb78ff4-6586-8c0c-b147-49d66f70fb56
msgctxt "h1514d7deg56cdg459ag97dfg6cebf70ef69e"
msgid ""
"Someone will need to step up and lead in their absence, a man with the "
"spirit of a dragon."
msgstr "누군가 나서서 그 빈 자리를 채워줘야겠는데. 드래곤 같은 기백을 가진 그런 사람 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6c0c5e60-7da3-71e6-99b5-3158f53e6d29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6c0c5e60-7da3-71e6-99b5-3158f53e6d29
msgctxt "hccf0343ag34e7g41cfga1b2g195f34c54083"
msgid ""
"*Sigh.* You're a gifted hunter, pup. And Zariel's made her share of enemies "
"in and out of the Hells."
msgstr "*하아*. 넌 타고난 사냥꾼이야, 멍멍아. 그리고 자리엘 님께선 지옥 안팎으로 적들이 많지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 6cae1f19-692b-b184-7dac-8218568dbd0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6cae1f19-692b-b184-7dac-8218568dbd0e
msgctxt "h6493d15dg19cdg402fgb87fgd1ab9ba27211"
msgid "It's a trick, it's got to be. A bargain's a bargain, right?"
msgstr "분명 속임수일 거야. 거래는 거래니까. 그렇지 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6d914e4c-5a85-2024-ec1d-d9b7fc433c7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6d914e4c-5a85-2024-ec1d-d9b7fc433c7b
msgctxt "h916457cag7e0fg42c8g8a8eg08611ef18e3b"
msgid ""
"Well, apart from the whole 'devil pulling the strings' aspect, of course."
msgstr "뭐, 이 모든 게 다 '데빌이 배후에서 조종하고 있다'라는 것만 빼면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6e9c9846-91ad-82f1-8db9-fe0471b198b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6e9c9846-91ad-82f1-8db9-fe0471b198b7
msgctxt "h7e099889gba1cg4d4fg894fge2280ea247bf"
msgid "Such language. Didn't your father teach you any manners?"
msgstr "말버릇하고는. 아버지한테 가정 교육도 제대로 안 받았니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6f243cf2-d746-5e07-3d9a-5962c9d52724
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6f243cf2-d746-5e07-3d9a-5962c9d52724
msgctxt "h03f747b5gc5b6g4ef2gab8bg13329f348f24"
msgid ""
"And I'm not done with you yet, pup. Our future together looks real bright."
msgstr "그리고 너랑 내 관계는 아직 안 끝났어, 멍멍아. 우리 미래는 완전 눈부실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6f243cf2-d746-5e07-3d9a-5962c9d52724
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6f243cf2-d746-5e07-3d9a-5962c9d52724
msgctxt "h331fe057g1de6g4382g97e0gb69133cc83b9"
msgid "And I'm not done with him yet. Our future together looks real bright."
msgstr "그리고 나랑 그 애 관계는 아직 안 끝났어. 우리 미래는 완전 눈부실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6fb95e0c-83e5-8b58-67b0-bf6d11a0dde6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6fb95e0c-83e5-8b58-67b0-bf6d11a0dde6
msgctxt "hfb94ccaagcb60g44aeg84c8g6d2ce1311c75"
msgid ""
"Demons are fair game. Zariel's enemies? Likewise. Devils threatening the "
"Sword Coast? Fine by me."
msgstr "데몬 정도면 나쁘지 않겠지. 자리엘 님의 적들도 마찬가지야. 소드 코스트를 위협하는 데빌들도 괜찮고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 6fbbeb37-fdf8-6f72-0f5c-6a7fc0a36818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:6fbbeb37-fdf8-6f72-0f5c-6a7fc0a36818
msgctxt "h8d76084fg0720g4167g8070g2dee40292374"
msgid "Ha. Ha. Hahahahaha!"
msgstr "하. 하. 하하하하하!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 7058c471-643e-b432-bbad-21e63797923f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7058c471-643e-b432-bbad-21e63797923f
msgctxt "h79b5fb54g5bf6g4cbfg9e5agb1252ff175a6"
msgid "Damn I right I did. My father is safe and my chains are broken!"
msgstr "해냈고 말고. 아버지도 구해냈고 계약에서도 풀려났지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 726ac566-1dc9-8cbc-4693-a180a48cfe50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_AskedAboutHells(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_AskedAboutHells(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:726ac566-1dc9-8cbc-4693-a180a48cfe50
msgctxt "h56abeb3fgbdfdg4756gb300g47c1517b3168"
msgid "What can you tell me about the Hells?"
msgstr "지옥에 관해 뭘 알려줄 수 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 731cd54f-5e24-688f-f694-6b5fbd4af141
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:731cd54f-5e24-688f-f694-6b5fbd4af141
msgctxt "h753d5883ge299g4567gb5fag5335134d862c"
msgid "Let's change the subject."
msgstr "다른 얘기를 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 73282156-b072-a5f9-1fc0-cd439c70408b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:73282156-b072-a5f9-1fc0-cd439c70408b
msgctxt "h10996cbfg48f4g4412g81d5g61c502e4250b"
msgid "A terrible, violent display. And I bet you enjoyed every moment."
msgstr "끔찍하고, 폭력적인 광경이었어. 넌 신나서 구경이나 했겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 7426a391-7104-d451-7ed4-c23c5de89ce1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_GrandDuke = True
#.      - CAMP_Mizora_Event_FinalDiscussion = False
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_Event_FinalDiscussion = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7426a391-7104-d451-7ed4-c23c5de89ce1
msgctxt "hfaee9a6ag85e8g4105g8355g27031ee5e778"
msgid ""
"'Grand Duke Wyll Ravengard.' What a thrill! Imagine the statues they'll "
"build, the songs that they'll sing!"
msgstr "'윌 레이븐가드 대공.' 진짜 신난다! 무슨 동상이 세워지고 무슨 노래가 불릴까!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 752a9cd1-290c-84ae-dfc2-33b5789cc364
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Partnered(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:752a9cd1-290c-84ae-dfc2-33b5789cc364
msgctxt "h5306f21cgfb2eg407dg8747gcac8b6935321"
msgid "I'm not sure. I'm involved with someone else."
msgstr "이래도 되나 모르겠는데. 난 지금 만나는 사람이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 7600227e-0023-69eb-d47b-46c88337a19a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7600227e-0023-69eb-d47b-46c88337a19a
msgctxt "hbb9d7ec5g0869g4bd9gbe97gfe73a8d617cd"
msgid "The pup dug his own hole, darling. I merely supplied the claws."
msgstr "다 멍멍이가 자초한 거야, 아가야. 난 도움을 좀 준 것뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 76583b27-e320-bf07-3742-38aef0a74228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:76583b27-e320-bf07-3742-38aef0a74228
msgctxt "he78e1059g1826g4a8bgb9fag07a0a04ec4ec"
msgid "Hot as brimstone, jagged as lightning -"
msgstr "넌 유황처럼 화끈하고, 번개처럼 재빠르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 76f9f724-09c7-d22d-94c0-d7f1335e8a0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:76f9f724-09c7-d22d-94c0-d7f1335e8a0d
msgctxt "h40499cb9gc44ag459cgbb56g619eb1546177"
msgid "I wanted to handle it myself. He had it coming."
msgstr "내가 직접 손 봐주고 싶었어. 그 자식이 자초한 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 77780115-12f1-bcaa-8175-87b7dc5070eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:77780115-12f1-bcaa-8175-87b7dc5070eb
msgctxt "hb7847c21gcc65g49f3g8477gdc1e34ed8318"
msgid "Tell me, pet: who's our first target?"
msgstr "말해봐, 멍멍아. 우리 처음엔 누구한테 갈래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 77872457-7d71-d158-8d8f-92351b43a03b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:77872457-7d71-d158-8d8f-92351b43a03b
msgctxt "h6b5965aeg2c24g41efgab7dgd63e0f09cc58"
msgid ""
"Well, apart from the whole 'devil pulling the strings' aspect, of course."
msgstr "뭐, 이 모든 게 다 '데빌이 배후에서 조종하고 있다'라는 것만 빼면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 77966299-f6ae-f967-31cb-1509052d32d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:77966299-f6ae-f967-31cb-1509052d32d6
msgctxt "hbce42f18g8324g43ecgb983g0a4a128ba75e"
msgid ""
"I woke in that damned pod. It kept my body sealed and my most powerful magic "
"silenced."
msgstr "깨어나 보니까 그 망할 포드였어. 몸은 옴짝달싹 못 했고 내 가장 강력한 마법은 막혀 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 78eefdf2-3ca2-26b5-f1a2-d6a895ebdf22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:78eefdf2-3ca2-26b5-f1a2-d6a895ebdf22
msgctxt "h222cbd74gd58fg4091ga79dgd005328dacd4"
msgid ""
"Yes, celebrate your fortunes. But remember that they are lost as quickly as "
"they are gained."
msgstr "그래, 이번엔 운이 좋았네. 근데 운이란 건 들어온 속도만큼 빠르게 사라진다는 거 알아 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 7979d2e6-234d-ad78-1ceb-5d49f66ca4f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7979d2e6-234d-ad78-1ceb-5d49f66ca4f9
msgctxt "h06fe7b62gf686g44d1g8704gdfd887e54ceb"
msgid "Oh, don't let him spoil our fun. Come at me, sister. See what happens."
msgstr "윌 핑계는 대지 말고 한 번 덤벼봐, 동생아. 어떻게 되나 한번 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 798230be-9aa3-4a3d-9712-2443bf65a02f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - dbeade8e-5b5b-89b3-e348-6845275fa885_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:798230be-9aa3-4a3d-9712-2443bf65a02f
msgctxt "h177660e3ga634g4d21gb7bfgfa4aea3b6b9c"
msgid "<i>Probe Mizora's mind.</i>"
msgstr "<i>미조라의 머릿속을 들여다본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 7eafbc6c-b1c3-a3ca-241c-d805a5312269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7eafbc6c-b1c3-a3ca-241c-d805a5312269
msgctxt "hb9a81fb3g0108g43ddg8d87g4fc12363e5bb"
msgid "Do you, now? Mistress Zariel will be pleased to hear it."
msgstr "옛날하고 달라지셨네? 여제님께서 들으면 기뻐하시겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 7fbfcc92-ef55-4590-8abd-428b24ad0aec
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7fbfcc92-ef55-4590-8abd-428b24ad0aec
msgctxt "habc01652g5fc7g414dg8d5agb2564c8fee3b"
msgid "You're hiding something. Spit it out, Mizora - you know you want to."
msgstr "숨기는 게 있군. 순순히 털어놓으시지, 미조라. 너도 솔직히 입이 근질거릴 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 7fcc1813-eb12-5eeb-41b0-ba0877bf5256
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7fcc1813-eb12-5eeb-41b0-ba0877bf5256
msgctxt "hf8f219dbgeeecg4f49gb6f7g5c7057c00718"
msgid ""
"Who should Wyll's first target be? I assume Zariel's old pet will have an "
"opinion on the matter."
msgstr "윌의 첫 상대로 누가 좋을까? 여기 자리엘 님이 키우던 똥개가 무슨 의견이 있는 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 7fcc1813-eb12-5eeb-41b0-ba0877bf5256
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:7fcc1813-eb12-5eeb-41b0-ba0877bf5256
msgctxt "h9620c1f1g7992g46a7ga768gd3ab6263800a"
msgid "Tell me, little bug: who should Wyll's first target be?"
msgstr "우리 꼬물이가 말해 봐. 윌의 첫 상대는 누구로 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 8171704c-c166-33cd-d27a-b35975fb00b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:8171704c-c166-33cd-d27a-b35975fb00b6
msgctxt "h5b2f0d22gc0b3g4d05gab38ga33c63bfd0de"
msgid ""
"You're such a loser, Mizora. You broke a contract and got nothing out of it. "
"Ha!"
msgstr "멍청한 미조라. 계약도 어겨 놓고서 딱히 해낸 것도 없네. 하!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 81f38ee5-c57b-435c-61b5-82180d7d7413
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:81f38ee5-c57b-435c-61b5-82180d7d7413
msgctxt "h3b2c512dg9e39g4790ga043g0df614c8f0c1"
msgid "I'll keep the whole 'devil pulling his strings' hush-hush, I promise."
msgstr "'데빌이 배후에서 조종하고 있다'라는 건 내가 잘 숨겨볼게. 약속."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 85132ae8-eb18-75ea-0ad0-249992959f29
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:85132ae8-eb18-75ea-0ad0-249992959f29
msgctxt "hdebd6211gd110g43f8gb187g2945c40da666"
msgid ""
"You've got it all wrong, pup. <i>You</i> killed your father. Your wish - my "
"command."
msgstr "뭔가 단단히 잘못 알고 있네, 멍멍아. 네 아빠를 죽인 건 <i>너</i>야. 난 네 소원을 들어줬을 뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 85132ae8-eb18-75ea-0ad0-249992959f29
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:85132ae8-eb18-75ea-0ad0-249992959f29
msgctxt "h76a08b61g415ag4fa8g9760g646d17e9aabb"
msgid ""
"You've got it all wrong, bug. <i>Wyll</i> killed his father. His wish, my "
"command."
msgstr "뭔가 단단히 잘못 알고 있네, 꼬물아. 자기 아빠를 죽인 건 <i>윌</i>이야. 난 그 애 소원을 들어줬을 뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 855e9650-4444-fbd4-0512-de7a19f702ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:855e9650-4444-fbd4-0512-de7a19f702ea
msgctxt "h3d54493cg39e6g4a2fga6e8g17e3c90880aa"
msgid ""
"But what about the next battle, and the next? How mighty will the stalwart "
"Blade be, without warlock powers to help him?"
msgstr "근데 다음 전투, 그리고 그다음 전투는 어쩌지? 능력도 없는 우리 용감한 칼날 님께서 얼마나 버틸 수 있으시려나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 86ce13b2-bf34-adde-8608-231ccbda5dbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:86ce13b2-bf34-adde-8608-231ccbda5dbd
msgctxt "h187ebd7fg5bc1g4f6bg9e53gd2a128ab98cc"
msgid "Well - at least you got to pay your last respects..."
msgstr "뭐, 일단 너도 마지막 가는 길은 배웅해 드렸고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 871db40e-d6d7-0285-30f9-9bbd30ac9244
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:871db40e-d6d7-0285-30f9-9bbd30ac9244
msgctxt "h00662343g41dfg4a49gbaf1g7b08f179bb2a"
msgid ""
"I would have done the same thing in your shoes. But what do I know about "
"heroes?"
msgstr "내가 너였어도 그렇게 했을 거야. 영웅의 심리 따위야 난 모르지만, 그러지 않겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 87fb18fe-5cc1-096f-54cf-8c0e0678dfb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:87fb18fe-5cc1-096f-54cf-8c0e0678dfb8
msgctxt "h9e593763g2c4fg4fe4gb39bg2451d74169ac"
msgid "You sizzle like brimstone, glow like hot iron -"
msgstr "네 힘은 유황불처럼 끓어오르고, 넌 달군 쇠처럼 빛나지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 890bb60d-f6ca-1821-918b-68c2067f1e47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:890bb60d-f6ca-1821-918b-68c2067f1e47
msgctxt "h5b600b34g6eefg49d3ga7b0gbafcf1db234b"
msgid "Tell me, pet: who's your first target?"
msgstr "말해 봐, 멍멍아. 첫 상대는 누구로 할래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 8b1033ad-98b2-4c07-739b-ac3dd782312b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:8b1033ad-98b2-4c07-739b-ac3dd782312b
msgctxt "hb3c5b35cg1988g4572g8c18gb427ebd0b642"
msgid ""
"Ah, the thrill of the unknown! I can't wait to see what's in store for "
"Baldur's Gate's newest Grand Duke."
msgstr "아, 설렌다! 발더스 게이트에 새 대공이 임명되면 상점에 대체 뭐가 들어오려나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 8c360055-a99c-443e-d89c-a403a29c22c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:8c360055-a99c-443e-d89c-a403a29c22c2
msgctxt "hb85544b7g17d0g4c0eg9acbg18aca5a222f7"
msgid ""
"Not very valorous if you ask me. But what does a mean ol' devil like me know "
"about heroes?"
msgstr "영웅이 할 만한 짓은 아닌 거 같은데. 근데 뭐 나 같은 데빌이 영웅에 대해 뭘 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 8f60fb33-727d-b23c-3237-4a367a742b66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_Gloating(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:8f60fb33-727d-b23c-3237-4a367a742b66
msgctxt "h5447c3f1g2043g48cegb84ag9e92bcd6aa72"
msgid "What brings you by?"
msgstr "무슨 일로 오셨을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 8f700b30-fb54-aa09-5e06-c65431b02484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:8f700b30-fb54-aa09-5e06-c65431b02484
msgctxt "hd3280532g389bg44f3gae9ag173196855e6c"
msgid "I just didn't expect you'd take it so <i>literally.</i>"
msgstr "네가 그렇게 <i>곧이곧대로</i> 받아들일 줄은 몰랐지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 8f833122-ac47-4575-e6d6-57e6dfbad4a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Mizora_Event_StartedRomanceScene = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:8f833122-ac47-4575-e6d6-57e6dfbad4a9
msgctxt "hd66ac88fg13b6g489eg9c59gfc25258ca6cd"
msgid ""
"The other eight, well, they are pleasures unto themselves. Perhaps I'll show "
"you myself - if I deem you worthy."
msgstr "나머지 여덟 곳도 뭐, 그 자체로 즐거운 곳이지. 네가 자격만 갖춘다면 내가 데려가 줄 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 91728d9f-6203-8ad6-af09-49fc4abc0934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:91728d9f-6203-8ad6-af09-49fc4abc0934
msgctxt "h86ec9148g61b1g4440gb31cg595677e25d08"
msgid ""
"A single soul for the return of Baldur's Gate's most beloved duke. A real "
"bargain, I should think."
msgstr "영혼 하나로 발더스 게이트의 가장 사랑받는 대공을 되살릴 수 있다니. 완전 거저지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 92a762b9-de58-69d1-9e53-c09995485623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IRN_Ravengard_State_KilledByPlayer = True
#.      - IRN_IronThrone_State_MizoraEnemy = True
#.   Object:
#.      - CAMP_Mizora_Event_Gloating(1) = False
#.   Tag:
#.      - REALLY_WYLL(1) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_Gloating(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:92a762b9-de58-69d1-9e53-c09995485623
msgctxt "h891b0fd4g7c3cg4bbbgaa41gbcd32eba4438"
msgid "All that trouble I went to. The planning, the anticipation -"
msgstr "나 정말 고생 많이 했는데. 계획도 짜고, 예상도 하고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 92ca7ddd-a021-a9b1-dc7f-338b8f1d9c9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:92ca7ddd-a021-a9b1-dc7f-338b8f1d9c9a
msgctxt "h0e2525a3g3581g4f5eg84dcgd618bf3dc350"
msgid "Yes, let's."
msgstr "그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 93e72cec-65a4-73d0-dc43-ef4329af2efd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_TalkedAboutAmbush(1) = True
#.      - CAMP_Mizora_Event_Gloating(1) = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:93e72cec-65a4-73d0-dc43-ef4329af2efd
msgctxt "h7882bc8cg28cbg4b9agb9e8g9c96888da455"
msgid "Karlach. Darling. How good to see you."
msgstr "칼라크. 아가야. 다시 보니까 너무 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 93e72cec-65a4-73d0-dc43-ef4329af2efd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_TalkedAboutAmbush(1) = True
#.      - CAMP_Mizora_Event_Gloating(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:93e72cec-65a4-73d0-dc43-ef4329af2efd
msgctxt "h7af88008ge15cg4cc9gbf5eg733f74c60476"
msgid "How good to see you."
msgstr "다시 보니까 좋네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9452a80b-7be6-ac67-fc6b-b5a97b9b7c49
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9452a80b-7be6-ac67-fc6b-b5a97b9b7c49
msgctxt "h53f9b908g4035g4e1egb68bg860b92b2ed97"
msgid ""
"But don't forget who signed away his own father's life when he's finally "
"bled. You, Wyll. Only you."
msgstr "하지만 네 아빠가 피 흘리게 되는 그때 그분 목숨을 넘겼던 게 누군지 똑똑히 기억해 둬. 너야, 윌. <b>네 짓이었어</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9452a80b-7be6-ac67-fc6b-b5a97b9b7c49
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9452a80b-7be6-ac67-fc6b-b5a97b9b7c49
msgctxt "h63a95408g3d06g47e3g8ca0g61e80570cbea"
msgid ""
"But don't forget who signed away his own father's life when Ravengard's "
"finally bled."
msgstr "하지만 레이븐가드가 피 흘리게 되는 그때 그 남자 목숨을 넘겼던 게 누군지 똑똑히 기억해 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 94e48875-5c35-cd9e-0baa-ea0139142afb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_State_ReadyForRomance = True
#.   Object:
#.     - CAMP_Mizora_Event_ReadyForRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:94e48875-5c35-cd9e-0baa-ea0139142afb
msgctxt "h559e9cceg7287g4f31g80b2g14f3403fce69"
msgid "<i>Smile.</i>"
msgstr "<i>웃는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 95738c38-6bed-14dd-07f9-79185cc8aa3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#.   Object:
#.      - CAMP_Mizora_Event_AskedAboutFuture(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_AskedAboutFuture(1) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:95738c38-6bed-14dd-07f9-79185cc8aa3a
msgctxt "h8f05f5b3g8211g4e8fg888cg1be5c75caf09"
msgid "What do you have planned for me now that the pact is eternally sealed?"
msgstr "나랑 영원한 계약을 맺었으니 이제 뭘 할 계획이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 95738c38-6bed-14dd-07f9-79185cc8aa3a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#.   Object:
#.      - CAMP_Mizora_Event_AskedAboutFuture(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_AskedAboutFuture(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:95738c38-6bed-14dd-07f9-79185cc8aa3a
msgctxt "h4255df30gd363g4723g87beg05f85ad982ce"
msgid ""
"What do you have planned for Wyll now that the pact is eternally sealed?"
msgstr "윌과 영원한 계약을 맺었으니 이제 뭘 할 생각이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = 9576d43d-d806-d052-916a-c3ff8d5a9ef2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9576d43d-d806-d052-916a-c3ff8d5a9ef2
msgctxt "h8b14ac1cgea31g475ega232gfbec3614278e"
msgid "It was you. <i>You</i> killed my father."
msgstr "너잖아. <i>네</i>가 아버지를 죽인 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 96a33742-6b4b-79b5-a069-00e5f30f68b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:96a33742-6b4b-79b5-a069-00e5f30f68b3
msgctxt "hc71dd858g4d9ag4c08g8a71g7c19987839ca"
msgid "Oh! Well, maybe 'monster' isn't so far off."
msgstr "오! 이건 뭐 '짐승 새끼'랑 다를 바 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 96d04c3f-3493-5ee0-e2c0-ab85a5b8634e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_FlorrickFight_Event_StoodDown = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:96d04c3f-3493-5ee0-e2c0-ab85a5b8634e
msgctxt "h53aa68f0g54e0g4663ga9dfg1ee7096b5266"
msgid "Alive, no thanks to you. I convinced her to stand down."
msgstr "살아있다. 내가 투항하라고 설득했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9702746f-bb2f-a178-4869-c97efcab0a08
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9702746f-bb2f-a178-4869-c97efcab0a08
msgctxt "heed0c9c7g5d81g47d2gb71bgaa0d0c06c267"
msgid ""
"Why, I'm supplying you with every scrap of your infernal power. I've paid my "
"dues many times over."
msgstr "왜, 네가 가진 지옥의 힘은 전부 다 내가 준 거잖아. 비용이라면 이미 여러 번 냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9702746f-bb2f-a178-4869-c97efcab0a08
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9702746f-bb2f-a178-4869-c97efcab0a08
msgctxt "h6fda085cga99ag4e03gaeeag81941168e203"
msgid ""
"Why, I'm supplying Wyll with every scrap of his infernal power. I've paid my "
"dues many times over."
msgstr "왜, 윌이 가진 지옥의 힘은 전부 다 내가 준 거잖아. 비용이라면 이미 여러 번 냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 975485fa-bd33-b701-ca9d-1fd693710d5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#.      - IRN_IronThrone_State_MizoraEnemy = True
#.   Object:
#.      - CAMP_Mizora_Event_Gloating(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_Gloating(1) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:975485fa-bd33-b701-ca9d-1fd693710d5e
msgctxt "h10617e8fg457fg4fb6gb259g42d5bdd3813f"
msgid ""
"I bet you're pleased with yourself. Saving your father and making a fool out "
"of me in a single swoop."
msgstr "기분 엄청 좋겠네. 아버지도 구해냈고 날 순식간에 바보로 만들었으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 975485fa-bd33-b701-ca9d-1fd693710d5e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ravengard_State_Defeated = False
#.      - IRN_IronThrone_State_MizoraEnemy = True
#.   Object:
#.      - CAMP_Mizora_Event_Gloating(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_Gloating(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:975485fa-bd33-b701-ca9d-1fd693710d5e
msgctxt "hfc3365a2gf354g413ag88dagc581e93c02bf"
msgid ""
"I bet you're pleased with yourself. Saving Ravengard and making a fool out "
"of me in a single swoop."
msgstr "기분 엄청 좋겠네. 레이븐가드도 구해냈고 날 순식간에 바보로 만들었으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 991e7dbe-12ff-d32f-c22b-0b2c97d40a14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:991e7dbe-12ff-d32f-c22b-0b2c97d40a14
msgctxt "h55859fa3gda89g4575g82b0gce6a1f914737"
msgid "And here I thought you'd be grateful for the final good-bye."
msgstr "마지막으로 작별 인사를 할 수 있었으니 기쁜 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 996cdeb6-fe36-62ff-31b1-d5ef07cd9f6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:996cdeb6-fe36-62ff-31b1-d5ef07cd9f6e
msgctxt "h222fa507g7f2bg4783g811ege0725372dfb7"
msgid "Let's change the subject."
msgstr "다른 주제로 넘어가지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 99a8cbbb-82b0-95a6-bf39-f8a16964d394
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:99a8cbbb-82b0-95a6-bf39-f8a16964d394
msgctxt "h6af4bf38g3affg4841g854ag8eaed95deee8"
msgid "But I understand. You have appearances to keep up, charades to play."
msgstr "근데 뭐 이해해. 너도 체면이 있고, 점잖은 척하고 싶겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9b2b827d-bcd6-45ec-804c-784fcb1c5346
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9b2b827d-bcd6-45ec-804c-784fcb1c5346
msgctxt "hcdec794cga1bbg4b89g91f1g44e8055aa8c5"
msgid ""
"A sealed pact is mightier than even Asmodeus' ruby rod. Do you think by "
"merely saving a duke that you were ripping it through?"
msgstr "한 번 정해진 계약은 아스모데우스의 루비 지팡이보다 더 강력한 법이야. 대공을 구해냈으니 다 끝난 줄 알았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9bf83f5d-98fd-61d0-65bf-2b7b28156980
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9bf83f5d-98fd-61d0-65bf-2b7b28156980
msgctxt "h733a2dc2g5f41g4151g9649g14c5fb68a688"
msgid ""
"I stayed to true to the bargain. Isn't it a relief to know I'm always good "
"for my word?"
msgstr "난 약속 지켰어. 그래도 내가 했던 말에 책임진다는 거 알게 됐으니까 다행이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 9c3a123a-2546-b753-275d-2c1d5fbef5e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9c3a123a-2546-b753-275d-2c1d5fbef5e8
msgctxt "h2e38abc5gd02eg442eg9fb1geb7008606ef4"
msgid "I can't believe Wyll actually sacrificed his father to save himself."
msgstr "윌 스스로 자기 아버지를 희생했다는 게 믿어지지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 9ca00ad1-6685-b61c-1f02-9c7f62bcbe91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Gortash_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9ca00ad1-6685-b61c-1f02-9c7f62bcbe91
msgctxt "ha814ff17gbf29g40efgba7cg07784ed105a1"
msgid "I kill Gortash, Bane's Chosen."
msgstr "베인의 선택받은 자인 고타쉬를 죽일 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9ca5e542-366b-5f04-92bb-8d53de95175b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9ca5e542-366b-5f04-92bb-8d53de95175b
msgctxt "h32f041ccg5a13g4fe9g8e59ga3744194d828"
msgid ""
"I'd think you'd figured by now - Zariel found a new use for an old battleaxe."
msgstr "지금쯤 알아낸 줄 알았는데. 자리엘 님께서 자기 오래된 배틀 액스가 새로 쓰일 곳을 찾아내셨거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 9d82db48-48d3-e8af-57be-6c593f037d84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9d82db48-48d3-e8af-57be-6c593f037d84
msgctxt "h4c3261c4g3eefg439dga486g346896690145"
msgid ""
"'Our' order of business? You need to stay out of Baldur's Gate's affairs."
msgstr "'저희'라고? 넌 더 이상 발더스 게이트의 일에 끼어들 생각 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9e9c0c69-bb04-f9af-8054-c55b246e1773
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IRN_Ravengard_State_KilledByPlayer = True
#.      - IRN_IronThrone_State_MizoraEnemy = True
#.   Object:
#.      - CAMP_Mizora_Event_Gloating(1) = False
#.   Tag:
#.      - REALLY_WYLL(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_Gloating(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9e9c0c69-bb04-f9af-8054-c55b246e1773
msgctxt "h73b0277cgb9dag475ag87a8g1624c06c6720"
msgid "I do so love when someone does the work and I get all the credit."
msgstr "난 누가 열심히 일해서 나한테 다 가져다 바치는 게 너무 좋더라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 9f5c7052-e18c-76f2-e55c-50d0802f0f27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_State_ReadyForRomance = True
#.   Object:
#.     - CAMP_Mizora_Event_ReadyForRomance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9f5c7052-e18c-76f2-e55c-50d0802f0f27
msgctxt "hf8e6b357ga8c4g4721g9635g0d8454b3bcd0"
msgid "<i>Smile the rictus grin of the damned.</i>"
msgstr "<i>망자들을 조롱하는 웃음을 짓는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = 9f6616a8-07c0-fe1f-2f3f-811370fa5514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9f6616a8-07c0-fe1f-2f3f-811370fa5514
msgctxt "hc7c69fa0g4726g4338gb85cg86e1d627fb89"
msgid "Our night together was a big mistake."
msgstr "그날 밤 일은 실수였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = 9f9bd978-e000-08dd-e1bb-81f7f997ad88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:9f9bd978-e000-08dd-e1bb-81f7f997ad88
msgctxt "hb9056b49geaa3g4210g89c0g85b2d0ac09ed"
msgid "Oh, but do hear me out - you want what I have to offer."
msgstr "한 번 들어나 봐. 너도 꽤 마음에 들걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = a04b72f9-9e7a-e594-7098-f0c5191f3f35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a04b72f9-9e7a-e594-7098-f0c5191f3f35
msgctxt "h1f4e82eage0c7g46f4g97e6g44f31d954258"
msgid "Wyll's not a child. You need to start treating him with respect."
msgstr "윌은 어린애가 아니야. 이제 윌한테 존중을 담아서 대해야 할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a0a590b2-cdca-8555-9866-09b1b0521fb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Mizora_State_SuggestRomance = True
#.   Object:
#.      - CAMP_Mizora_Event_RomanceOffered(1) = False
#.   Tag:
#.      - AVATAR(1) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_RomanceOffered(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a0a590b2-cdca-8555-9866-09b1b0521fb9
msgctxt "ha4267e4eg2d25g47d5ga5bbg2c9e4db78b53"
msgid "I've had my eye on you."
msgstr "그동안 쭉 지켜보고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a0ef0f71-b819-69ab-d083-8d24423bc511
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a0ef0f71-b819-69ab-d083-8d24423bc511
msgctxt "hab7bfbacg41c9g4cbcga177g6c991b5b8b1b"
msgid ""
"I am a benefactress. And I have an eye for a good cause. You needed help, so "
"I indulged you."
msgstr "난 기회를 제공해 주는 사람이야. 누가 도움이 필요한지도 잘 찾고. 네가 그런 상황이었으니, 내가 도와준 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = a10cf01c-e943-0187-0c5b-8840a30d91a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a10cf01c-e943-0187-0c5b-8840a30d91a4
msgctxt "hf7e12925gd4f8g4e91g8723gd92a3547caf4"
msgid "Godsdamn you, Mizora. Admit it: You were trying to cause trouble."
msgstr "그냥 좀 인정해, 미조라. 뭔가 곤란한 상황 만들고 싶었던 것뿐이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = a10f54ef-65db-4c35-279a-05b7cc0c685c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a10f54ef-65db-4c35-279a-05b7cc0c685c
msgctxt "h10355b93g693fg464fg9fbdg7431c6a41eae"
msgid ""
"I have. But even the lowliest devils honour their agreements, don't they?"
msgstr "보고 있긴 하지. 그리고 아무리 최하급 데빌이라도 자기 약속은 지키는 법 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a1d45568-77f5-5eba-0048-c4b5f8ae357b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a1d45568-77f5-5eba-0048-c4b5f8ae357b
msgctxt "hbc969e5ag0dd2g4394g9ca1gc0ea39ca2729"
msgid ""
"I am a woman of my word. Go to Gortash's secret prison, and I'll help you "
"spring Wyll's daddy free."
msgstr "난 했던 말은 지키는 여자야. 고타쉬의 비밀 감옥으로 가 봐, 그러면 윌의 아빠 구하는 걸 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a3593d16-44d8-5ad0-3e3f-275e9c0510c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a3593d16-44d8-5ad0-3e3f-275e9c0510c7
msgctxt "h998ae96bge843g4d91g9d7ag11b197cc8f83"
msgid "No one crosses the Hells' children without getting scorched."
msgstr "누구든 지옥의 자손을 건드렸다간 크게 데이는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = a3d9073a-e6b1-99f5-dd53-099bd665be20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a3d9073a-e6b1-99f5-dd53-099bd665be20
msgctxt "h73d0a6f5g4fa4g4a2aga2c8geb6709c02953"
msgid "It was an accident. I didn't mean to do it, I swear."
msgstr "그건 사고였어. 맹세컨대 그럴 생각은 없었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a3dda74c-1f5c-6cbf-3686-40408ee22b09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#.   Object:
#.      - CAMP_Mizora_Event_ResurrectedIntro(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_ResurrectedIntro(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a3dda74c-1f5c-6cbf-3686-40408ee22b09
msgctxt "hc2109e14gf744g466dg96d1g20da6bb6b2f3"
msgid "Such a touching reunion. It's enough to bring a tear to my eye."
msgstr "감동적인 재회네. 나도 눈물 날 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a41b53f9-3188-2afe-fa04-ec23e85f579a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a41b53f9-3188-2afe-fa04-ec23e85f579a
msgctxt "h80bd6694gf718g4b13g9d47gf203530fe876"
msgid "A duke's son, perhaps."
msgstr "대공의 아들은 어떠려나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = a42f5db0-f427-8e6a-7be3-060c8dbbff46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a42f5db0-f427-8e6a-7be3-060c8dbbff46
msgctxt "h0e9ca34bgf489g4cdfg97eeg2cfefcf7b279"
msgid ""
"The elder brain is first on the list. Everything else will need to wait."
msgstr "엘더 브레인이 최우선이다. 다른 일은 나중에 처리하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a55fb944-d245-83a7-2f2c-8bbd6c314352
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a55fb944-d245-83a7-2f2c-8bbd6c314352
msgctxt "h2b5e8609g435fg44e9g9467g7045b9d58151"
msgid ""
"Clause One, Section One: <i>'Soul-bearer pledges his soul to half-fiend "
"Mizora and the archdevil Zariel in a pact eternal.'</i>"
msgstr ""
"1조, 제1항. <i>'영혼 소지인은 영원한 계약에 따라 아크데빌 자리엘과 반 마족 미조라에게 영혼을 바칠 것을 맹세한다.'</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = a6198036-70d1-3219-c0c8-0b4b0b659eba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a6198036-70d1-3219-c0c8-0b4b0b659eba
msgctxt "h1eab8625g7504g46c6g967ag13517031fadb"
msgid "Absolutely not."
msgstr "전혀 생각 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Narrator
#. NodeID = a641458b-1791-ed03-c217-ce9d7c56aee0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a641458b-1791-ed03-c217-ce9d7c56aee0
msgctxt "hfb0c03c2g3197g4e04gbbb7g31c93b765ca5"
msgid ""
"*Mizora sounds entirely too pleased with herself. She's keeping something "
"from you.*"
msgstr "*미조라의 말투가 과하게 들뜬 것 같습니다. 뭔가 숨기고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a694f005-8d8c-b7b0-e4c1-405e51dc74f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Mizora_Event_FinalDiscussion = False
#.   Object:
#.      - Wyll_InParty2_Event_RavengardWhyKill(1) = True
#.      - CAMP_Mizora_Event_DukeBody(1) = False
#.   Tag:
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_DukeBody(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a694f005-8d8c-b7b0-e4c1-405e51dc74f9
msgctxt "h84891d93g6bfcg4595gb3f0gd13441109074"
msgid ""
"What torment it must have been, to see the duke's corpse rotting in the Iron "
"Throne."
msgstr "대공의 시체가 아이언 스론에서 썩고 있는 걸 봤다니, 얼마나 마음이 아플까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a80838ad-607f-5f12-8807-470cd9dc6983
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_Ravengard_State_Resurrected = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a80838ad-607f-5f12-8807-470cd9dc6983
msgctxt "he6941964g493fg45d6ga65agef797fd19816"
msgid ""
"Your words, not mine, pup. Besides, he's looking much better now, wouldn't "
"you say?"
msgstr "내가 아니라 네가 그렇게 계약했으니까 돌아가신 거지, 멍멍아. 그리고 대공님은 지금이 훨씬 더 편하신 것 같은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = a87a21ff-c7fc-a2fe-70c2-0a2853c5ca10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_AskedCapture(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_AskedCapture(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a87a21ff-c7fc-a2fe-70c2-0a2853c5ca10
msgctxt "h059a061dg437ag420cg8cddg4930733d4fb2"
msgid "You never told me how the Absolutists captured you."
msgstr "교단 놈들이 널 어떻게 붙잡은 건지 말해준 적이 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a9bbaeb5-9106-447e-5eb7-9fb8a1d32acc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a9bbaeb5-9106-447e-5eb7-9fb8a1d32acc
msgctxt "hff3f36d2g54b4g4dffga973g4edf8396e33f"
msgid ""
"Clause G, Section Nine: <i>'Targets shall be limited to the infernal, the "
"demonic, the heartless, and the soulless.'</i>"
msgstr "G조, 제9항: <i>'대상은 지옥의 존재, 데몬, 심장이나 영혼 없는 자에 한한다.'</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a9faa74e-365e-50ec-f43d-b1c8c6c40976
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a9faa74e-365e-50ec-f43d-b1c8c6c40976
msgctxt "h63b2047ag6c35g4a89gafa2g78babd80c4ab"
msgid ""
"To wit: go to Gortash's secret prison, and I'll help you spring your daddy "
"free."
msgstr "이제 고타쉬의 비밀 감옥으로 가 봐. 그럼, 네 아빠를 구해내는 걸 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = a9faa74e-365e-50ec-f43d-b1c8c6c40976
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:a9faa74e-365e-50ec-f43d-b1c8c6c40976
msgctxt "h9f16a4ffge256g46a2gb276g93f0a1b69968"
msgid ""
"To wit: go to Gortash's secret prison, and I'll help you spring Wyll's daddy "
"free."
msgstr "이제 고타쉬의 비밀 감옥으로 가 봐. 그럼, 윌의 아빠를 구해내는 걸 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = aad790c4-1f96-65f5-0369-71444f7ede0f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:aad790c4-1f96-65f5-0369-71444f7ede0f
msgctxt "h40bddc18g7450g4bc3gad11gc18cf6b774cd"
msgid ""
"Why, only the truth - that you bear the blame for your father's untimely "
"demise."
msgstr "그냥 사실대로 얘기한 것뿐이야. 네 아빠가 이렇게 돌아가신 데 네 책임이 있다는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = aad790c4-1f96-65f5-0369-71444f7ede0f
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:aad790c4-1f96-65f5-0369-71444f7ede0f
msgctxt "h2f76eb5agc37fg41e1gbb56g1c8a28aab990"
msgid ""
"Why, only the truth - that you bear the blame for the duke's untimely demise."
msgstr "그냥 사실대로 얘기한 것뿐이야. 네가 대공의 죽음에 책임이 있다는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = acde09ec-f55d-bfd0-a471-12df8b8323ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:acde09ec-f55d-bfd0-a471-12df8b8323ee
msgctxt "h4a04d2c0g99ffg4bc4g84a2ge95b11a1a4f3"
msgid ""
"But I do wonder - just how mighty will the stalwart Blade be, without "
"warlock powers to help him?"
msgstr "근데 좀 궁금하네... 능력도 없는 우리 용감한 칼날 님께서 얼마나 버틸 수 있으시려나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ae68e319-310c-ffcf-c247-81b1596b9f1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IRN_IronThrone_State_Visited = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ae68e319-310c-ffcf-c247-81b1596b9f1d
msgctxt "hd69f36a1ga437g4157g9038gac1fb1280fb5"
msgid ""
"I am a woman of my word. Go to the Iron Throne, and I'll help you spring "
"Wyll's daddy free."
msgstr "난 했던 말은 지키는 여자야. 아이언 스론으로 가 봐, 그러면 윌의 아빠 구하는 걸 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = af2fd310-9e98-db86-17b1-2a35938a41d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:af2fd310-9e98-db86-17b1-2a35938a41d8
msgctxt "h9911362egde15g4cfeg96a4gb8c80e9e3d29"
msgid ""
"Imagine the battles he's still to lead once you've flattened the Absolute."
msgstr "절대자를 쓰러뜨리고 난 후에 대공님께서 얼마나 많은 전투를 승리로 이끌게 될지 생각해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = b22ec450-8dec-634e-5a8f-6f5b1eb40d1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:b22ec450-8dec-634e-5a8f-6f5b1eb40d1a
msgctxt "hf9b65be3g39d1g4564gaf76gc9e14ff42ba5"
msgid "So what's our first order of business, sir duke?"
msgstr "그럼, 저희는 이제 누구한테 먼저 가나요, 대공님?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = b2c5ba99-ee16-93cd-7cca-51b0bb30fc1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:b2c5ba99-ee16-93cd-7cca-51b0bb30fc1e
msgctxt "h58a10f37gf31fg4d47gb313gd3729a967a4b"
msgid ""
"'Sir duke?' Marvellous - you are already giddy with power and possibility."
msgstr "'대공님?' 세상에, 벌써 권력이랑 그걸로 이룰 일에 들떴구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = b34049e7-3f51-760d-e782-22e2aa55c9d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:b34049e7-3f51-760d-e782-22e2aa55c9d1
msgctxt "h479639e5gd6c3g444egabf2g68823b5ce4a5"
msgid "Tell me, darling - how is she?"
msgstr "그래서, 어떻게 됐어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = b5920af6-d6af-245e-8210-117361acd8af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:b5920af6-d6af-245e-8210-117361acd8af
msgctxt "hc0c2fb38gc398g4455gbeebgcffc1cee445d"
msgid "A terrible, violent display. You must be positively ecstatic over it."
msgstr "끔찍하고, 폭력적인 광경이었다. 넌 그걸 보고 좋아했겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ba71cd97-c86c-9283-473b-b3f541ebac66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ba71cd97-c86c-9283-473b-b3f541ebac66
msgctxt "hef2b9ba8g85c1g4a14g8dccg43d14bdc586b"
msgid "Of course, you could always leave him to rot."
msgstr "물론, 거기서 썩게 놔둬도 아무 문제 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ba819fda-26c6-028b-2665-98db04dbcc1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ba819fda-26c6-028b-2665-98db04dbcc1b
msgctxt "h847f31c5g05adg433cg91dfge16beaf20d34"
msgid ""
"Don't be too hard on Wyll. I'm sure he carefully weighed the pros and cons."
msgstr "윌한테 너무 뭐라고 하지 마. 분명 자기도 장단점을 다 따져 봤을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = bb07a534-e747-4148-b35d-84b483063c20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bb07a534-e747-4148-b35d-84b483063c20
msgctxt "h2873665eg8d45g44b6ga11eg761f26075411"
msgid ""
"Now now, have some manners. It's not polite to dig around in a lady's mind "
"without her permission."
msgstr "어머, 이러면 곤란하지. 숙녀분 허락도 없이 머릿속을 멋대로 들춰 보면 쓰나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = bb6b1b38-f93d-f87c-7e45-e92a34a31632
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bb6b1b38-f93d-f87c-7e45-e92a34a31632
msgctxt "h930eb7ccg8635g4d09g8548g7f7f9a9ca427"
msgid ""
"Your words, not mine, pup. Besides, you could have undone it all in a snap."
msgstr ""
"내가 아니라 네가 그렇게 계약했으니까 돌아가신 거지, 멍멍아. 그리고 그 일은 손가락만 한 번 튕기면 바로 없던 일로 할 수 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = bc0b37cc-cce4-0e4a-e396-a94def431113
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bc0b37cc-cce4-0e4a-e396-a94def431113
msgctxt "h19edfdd5gd0aeg45edg8da5g881c1064d34f"
msgid ""
"- and then you kill the poor duke yourself. I'm nothing if not impressed."
msgstr "...근데 네가 알아서 대공을 죽여 버렸네. 솔직히 이럴 줄은 꿈에도 몰랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = bccb1185-4ac6-aeb7-aea0-4d4903edf0c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bccb1185-4ac6-aeb7-aea0-4d4903edf0c4
msgctxt "h949a6dfag729fg4271ga9f5g614377d17cff"
msgid "Then we'll keep it our little secret, hand to beating heart."
msgstr "그럼, 가슴에 손 얹고, 우리 둘만 아는 비밀로 간직하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = bd182fcb-ebb4-27c6-6001-79a823187a69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bd182fcb-ebb4-27c6-6001-79a823187a69
msgctxt "hd6b375deg8092g462eg90abgbc48eefa2696"
msgid ""
"Oh, I do love when you lot get nasty. I've always appreciated your sharp "
"edges."
msgstr "아, 난 네가 그렇게 말할 때 좋더라. 네 날 선 모습 보는 거 너무 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = bd768866-bc1d-dd83-74fa-404978bdbe28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bd768866-bc1d-dd83-74fa-404978bdbe28
msgctxt "h704fa896gc27eg4e27g956cgb075357249d8"
msgid "I'm sure I'll find plenty of prey in the wilds of the Sword Coast."
msgstr "소드 코스트의 황야 정도면 충분히 사냥감이 많을 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = bd768866-bc1d-dd83-74fa-404978bdbe28
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bd768866-bc1d-dd83-74fa-404978bdbe28
msgctxt "h2e4e99fag9a05g4df4ga3cbg65f669fbaf7c"
msgid "I'm sure he'll find plenty of prey in the wilds of the Sword Coast."
msgstr "소드 코스트의 황야 정도라면 윌의 사냥감이 충분할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = bf9da4bf-8616-5b3d-b048-1a903ed621e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bf9da4bf-8616-5b3d-b048-1a903ed621e6
msgctxt "h96c635d3gdecfg42a1gb672gf21259d0b912"
msgid ""
"Well - perhaps I might stop by once a tenday, see how the pup's getting "
"along. A bit of infernal altruism, if you will."
msgstr "한 열흘에 한 번쯤은 가다가 들러야겠네. 우리 강아지 잘 있나 확인도 하고. 지옥 출신 나름의 이타주의랄까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = bfac083d-de57-d6bc-52a5-e066d2f16b84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_KillDirectorGortash_State_WyllKilledRavengard = False
#. TagRule: WYLL_DEVIL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bfac083d-de57-d6bc-52a5-e066d2f16b84
msgctxt "ha5b72848gccbeg4d93g9c44g311bfbd7cb42"
msgid "How dare you interfere? I am not to blame for my father's death!"
msgstr "감히 이 일에 끼어들어? 아버지의 죽음은 내 탓이 아니야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = bfac083d-de57-d6bc-52a5-e066d2f16b84
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_KillDirectorGortash_State_WyllKilledRavengard = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bfac083d-de57-d6bc-52a5-e066d2f16b84
msgctxt "hda8a02c3g5258g40f8gbc29g4add2be36be8"
msgid "How dare you interfere? I am not to blame for Ravengard's death!"
msgstr "감히 이 일에 간섭해? 레이븐가드의 죽음은 내 탓이 아니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = bffdd3fc-ca0a-39e7-46a4-e403bb65e030
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:bffdd3fc-ca0a-39e7-46a4-e403bb65e030
msgctxt "h8625d374g191cg46b3gaf1fg8754eb30ccdd"
msgid ""
"You're hungry for pleasures beyond this plane. Something more satisfying "
"than mortal flesh, blood, and bone."
msgstr "이 차원계에선 맛볼 수 없는 쾌락을 경험하고 싶잖아. 언젠간 사라질 살점, 피, 뼈 따위로는 경험할 수 없는 무언가를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c000e166-4761-8844-790a-5dfe4e78ab58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c000e166-4761-8844-790a-5dfe4e78ab58
msgctxt "hdcb1f911g1b27g4194ga049g6d9435638ae3"
msgid ""
"Yes. To kill the Absolute, to free the infected, to end the illithid Grand "
"Design. Could there be a more heroic journey?"
msgstr "그래. 절대자를 죽이고, 감염자들을 풀어주고, 일리시드의 원대한 설계도 끝장내는 거야. 이보다 영웅적인 여정이 어디 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c0a4d3df-45c6-ad93-c08f-2ee9820222e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c0a4d3df-45c6-ad93-c08f-2ee9820222e2
msgctxt "h55d7fd3fga0bcg4cb8g996agf737dfdb97c1"
msgid "Was it? You screamed like a banshee in a bathhouse when you climaxed."
msgstr "그래? 그땐 갈 것 같으니까 무슨 욕실에 들어간 밴시처럼 소리를 질렀잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = c0b0faa7-2bd1-f124-e0e2-1a60dd3e6cf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_AskedLeave(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_AskedLeave(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c0b0faa7-2bd1-f124-e0e2-1a60dd3e6cf3
msgctxt "h4e893597gf592g4066g9794ga9431b8f6cbd"
msgid "I want you out of here. Now."
msgstr "당장 나가 줬으면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = c16e8b56-85df-9808-27c5-3dbaf1cefe8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c16e8b56-85df-9808-27c5-3dbaf1cefe8e
msgctxt "h5aac118fgf1f8g4ae6ga469ge1d168cfa43c"
msgid ""
"'Our' order of business? You need to stay out of Baldur's Gate's affairs."
msgstr "'저희'? 넌 더 이상 발더스 게이트의 일에 끼어들 생각 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c1ccd434-830c-2706-96c4-fff6f81e5ddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c1ccd434-830c-2706-96c4-fff6f81e5ddc
msgctxt "had820755gfd05g4ab9gb23cgbf1c578e005d"
msgid ""
"To think I went through all that trouble, only for you to land the final "
"blow."
msgstr "어쩌면 내가 했던 일들은 다 네가 대미를 장식할 수 있게 도와주는 과정이었나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = c290407d-48b3-1a1e-39ea-ab86af32602e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c290407d-48b3-1a1e-39ea-ab86af32602e
msgctxt "hd91e15fdgf069g429dg8cb7g88a44938cc38"
msgid "I'm just relieved that Grand Duke Ravengard is all right."
msgstr "레이븐가드 대공을 무사히 구출할 수 있어서 다행일 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c2c84308-4e10-843d-dd08-461297ecdb1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c2c84308-4e10-843d-dd08-461297ecdb1d
msgctxt "h3a040c24g8191g4326ga7efgbe05d4a014da"
msgid ""
"Besides, if you did manage a killing blow, I wouldn't be the only victim."
msgstr "그리고 나한테 손대면, 나도 가만히 당하고만 있진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c3f8706a-7aec-d9a7-27c4-f297fd6f53d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c3f8706a-7aec-d9a7-27c4-f297fd6f53d8
msgctxt "h98d63031g6c8dg426fg9b3bg2f07f0cce57d"
msgid ""
"Judging by the zeal with which you tore into my flesh, I think it's the "
"latter."
msgstr "내 살을 뚫고 들어왔던 그 열정을 생각해 보면 아마 후자겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = c47a8ebd-bbce-94a4-872e-0719b0ed08ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c47a8ebd-bbce-94a4-872e-0719b0ed08ec
msgctxt "haa5ef4c7g843eg420dg811cgdb3d0b2157ff"
msgid ""
"Wyll sacrificed his soul for his father. You better fulfil your end of the "
"bargain."
msgstr "윌은 아버지를 위해 영혼까지 바쳤다. 거래에 그만한 가치가 있었어야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c4a42cba-40bb-6f1f-bb8d-36c795149b0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c4a42cba-40bb-6f1f-bb8d-36c795149b0a
msgctxt "hb5416e98gbbdfg4ac2gab02g1abae2d345a3"
msgid "Paranoia doesn't become you, my dear."
msgstr "예민하게 굴지 마, 아가. 넌 그런 거랑 안 어울려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = c4c42d73-ca8d-b209-f24d-4b975176c269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c4c42d73-ca8d-b209-f24d-4b975176c269
msgctxt "h77900996g98ccg4317gafd2ga5560d90963d"
msgid "You need to keep out of Baldur's Gate's business, Mizora."
msgstr "발더스 게이트에 더는 간섭 마시지, 미조라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c5920a68-d28a-dcf2-c8c0-0fda2048af88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c5920a68-d28a-dcf2-c8c0-0fda2048af88
msgctxt "h72e9d064ge277g42a8gbacfg28da5d115f1f"
msgid "You'll never be the same."
msgstr "이제 다신 옛날 몸으로 못 돌아갈걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c62f3334-8796-683a-4feb-ddc77fad3b88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c62f3334-8796-683a-4feb-ddc77fad3b88
msgctxt "hdd64f589g1252g43bbgb901g506205b0167a"
msgid ""
"Smile, and I'll come to you when you put your head down to rest. I will sate "
"your most forbidden lusts."
msgstr "지금 웃으면 이따 밤에 누워 있을 때 내가 찾아갈게. 네 가장 은밀한 취향도 만족시켜 줄 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = c68bb787-cfbe-b9a7-3a80-19e88bef2936
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c68bb787-cfbe-b9a7-3a80-19e88bef2936
msgctxt "hb30bd71dge769g4805gb6fag38650d042b88"
msgid "You forced Wyll to make an impossible choice."
msgstr "넌 윌한테 말도 안되는 선택을 강요했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c74e1aac-8004-0a21-3523-2bd7964894c5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c74e1aac-8004-0a21-3523-2bd7964894c5
msgctxt "h61eacdc0gc5e7g4548g931fgc20e0fd882ba"
msgid ""
"The mad assassin herself. Strike her down, pet - let her syndicate fall. The "
"brain won't be too far beyond."
msgstr "미친 암살자 년 말이지. 그년도, 그 조직도 다 박살을 내 버리자, 멍멍아. 뇌는 나중에 처리해도 늦지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c74e1aac-8004-0a21-3523-2bd7964894c5
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c74e1aac-8004-0a21-3523-2bd7964894c5
msgctxt "h25c34c66g4b63g425cgada5gc94dac3d3e4f"
msgid ""
"The mad assassin herself. Strike her down, bug - let her syndicate fall. The "
"brain won't be too far beyond."
msgstr "미친 암살자 년 말이지. 그 년도, 그 조직도 다 박살을 내 버리자, 꼬물아. 뇌는 나중에 처리해도 늦지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c8aaf45f-acaf-f594-3e87-b4ed7caab9df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c8aaf45f-acaf-f594-3e87-b4ed7caab9df
msgctxt "h941a4e4bgb13dg4165g8a51g7b380e117f91"
msgid "His only son, perhaps."
msgstr "그분의 유일한 친아들은 어떠려나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c8db002b-b0c5-d8fd-1e85-a4c2028efcbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c8db002b-b0c5-d8fd-1e85-a4c2028efcbd
msgctxt "h684b1cc1gaea3g4a2cg8a40gbf899c48c141"
msgid ""
"The same thrills I offer you. Some experiences are better when... shared."
msgstr "네가 느낄 그 짜릿함을 나도 느끼는 거지. 같이 할 때가 더... 기분 좋잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c9b8c68d-ed5a-7a86-c603-1c5fe6e00631
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c9b8c68d-ed5a-7a86-c603-1c5fe6e00631
msgctxt "h2dcd0da0g5c03g42c5g94f7ge258e123e7a2"
msgid ""
"Besides, now is a time of celebration. I am sure you and your father have "
"<i>plenty</i> to talk about."
msgstr "그리고, 지금은 일단 축하를 먼저 해야지. 아빠랑 할 얘기가 <i>산더미</i> 같잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = c9b8c68d-ed5a-7a86-c603-1c5fe6e00631
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:c9b8c68d-ed5a-7a86-c603-1c5fe6e00631
msgctxt "h2bb1211bgab92g4911g852fg535ad6133239"
msgid ""
"Besides, now is a time of celebration. I am sure you and Duke Ravengard have "
"<i>plenty</i> to talk about."
msgstr "그리고, 지금은 일단 축하를 먼저 해야지. 레이븐가드 대공님이랑 할 얘기가 <i>산더미</i> 같잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = ca8a4d1a-8547-a778-0c06-8539767d8b5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_FlorrickFight_Event_StoodDown = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ca8a4d1a-8547-a778-0c06-8539767d8b5f
msgctxt "h5caaa322gea7bg41a5g8f5cgd7f739d5b68f"
msgid "She's gone for good, thanks to your meddling."
msgstr "죽었지. 네 쓸데없는 참견 덕분이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = cb4def61-009d-9d64-0313-98559b3da2c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:cb4def61-009d-9d64-0313-98559b3da2c9
msgctxt "h14542b1bg02a6g43aagafdcg957c0fe22c71"
msgid "You're as cunning as a fox. It's a delight to see you in action."
msgstr "넌 여우만큼이나 교활한 여자야. 근데 난 네 그런 모습이 마음에 들더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = cb98276a-2c84-6019-ac84-a7e5d7d6fff2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:cb98276a-2c84-6019-ac84-a7e5d7d6fff2
msgctxt "h1ddf5e40g8067g48afgaa60g564b14c6937b"
msgid ""
"I'd like to see him try. Poor kitten's utterly powerless without my help."
msgstr "그 모습도 보고 싶긴 하네. 우리 불쌍한 고양이가 내 도움이 없으니 무력하게 당하기만 하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = cbdc66cf-8cbb-c91b-8d4c-dc103b9dc8ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:cbdc66cf-8cbb-c91b-8d4c-dc103b9dc8ae
msgctxt "h03312bbdg8a9bg40c2ga98ag8782c4872de8"
msgid "It was an accident. I didn't mean to do it, I swear."
msgstr "그건 사고였어. 맹세컨대 난 그럴 생각 없었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = cbe07b03-7671-27f8-7a1c-6f425cf2bcda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:cbe07b03-7671-27f8-7a1c-6f425cf2bcda
msgctxt "he2bd19a8g916fg400egbaacgeb5977a8bf0e"
msgid "But at least you got to pay your last respects."
msgstr "그래도 최소한 마지막 작별 인사는 할 수 있었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = cbe40ccb-20ae-3f2c-18d2-a7bdc3b4d33d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:cbe40ccb-20ae-3f2c-18d2-a7bdc3b4d33d
msgctxt "h0bd4141ag87b2g43eaga4cdga707ff5de9bf"
msgid ""
"Now, now, let's not bring Mummy into this. This is between us girls, isn't "
"it?"
msgstr "왜 그래, 엄마 얘기는 하지 말자. 우리 둘 사이에 있었던 일이잖아. 그치?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = cd0abf9d-e580-c0af-b15d-1b2bae74c567
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:cd0abf9d-e580-c0af-b15d-1b2bae74c567
msgctxt "ha96820e4g7fb7g42ccgaeb3gd591b8e4e05e"
msgid ""
"Your father's dignified bearing and seething annoyance are thanks enough."
msgstr "너희 아빠의 품격 있는 절제력과 짜증 참는 모습을 봤으니 난 충분히 만족해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = cf68f2d7-d79d-fdeb-323d-1c35abd9eb10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:cf68f2d7-d79d-fdeb-323d-1c35abd9eb10
msgctxt "h4de2a679g4f28g4a60g99b8g692c4b67a32a"
msgid "Tonight, then. Be ready."
msgstr "오늘 밤이구나. 그래, 기다리고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d04bf32d-078f-2262-cd5e-d009e53a2fdf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d04bf32d-078f-2262-cd5e-d009e53a2fdf
msgctxt "hcda1625dg9295g4718gbf97g086312fe36b0"
msgid ""
"Funny girl. If Wyll so much as touches a <i>faithful</i> of Zariel - never "
"mind Her Ladyship - he'll be turned into a lemure and left to rot in the "
"deepest pit of Avernus."
msgstr ""
"웃기셔. 자리엘 님은 커녕 그분의 진정한 <i>신봉자</i>한테 손대는 것만으로도 윌은 레무어로 변해서 아베르누스의 가장 깊은 구덩이 "
"속에서 썩게 될걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d1b47129-47c5-2b07-6332-9ddac59dcd7b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d1b47129-47c5-2b07-6332-9ddac59dcd7b
msgctxt "h688ad37cg9eb7g462cg92cegca8adc25e6ae"
msgid "Far from it. It wrecked me to see your father come to such a cruel end."
msgstr "아니거든. 네 아빠가 그런 비참한 최후를 맞으셨다는 사실에 내 가슴이 미어진다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d1b47129-47c5-2b07-6332-9ddac59dcd7b
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d1b47129-47c5-2b07-6332-9ddac59dcd7b
msgctxt "h080989b4g3319g4a61g8e84g82605ee4f306"
msgid ""
"Far from it. It wrecked me to see Wyll's father come to such a cruel end."
msgstr "아니거든. 윌 아빠가 그런 비참한 최후를 맞으셨다는 사실에 내 가슴이 미어진다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d40ba2e4-295b-0302-81ff-a784fb8b5565
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d40ba2e4-295b-0302-81ff-a784fb8b5565
msgctxt "he70ef7b8g8001g4ca5gbfb3g1e16c9532a6f"
msgid ""
"The Absolutists worked a number on me at Moonrise. And you're the best hope "
"I've got at payback."
msgstr "난 절대자 교단 놈들 때문에 문라이즈에서 수모를 당했어. 이걸 되갚아 주기엔 너만 한 사람이 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d428b67e-1ba6-1063-0e7d-c6c076606889
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_GivingType(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d428b67e-1ba6-1063-0e7d-c6c076606889
msgctxt "h26a1c723g4affg4337gae6fg8233c0bd3df0"
msgid "I've always been the giving type, after all."
msgstr "난 항상 주는 쪽이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = d461e59d-9327-be80-bdb0-d34dfdc28026
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d461e59d-9327-be80-bdb0-d34dfdc28026
msgctxt "h00380cf7g25f1g4f7fgb386g2647ff6d6c8a"
msgid "You absolute shit-stain!"
msgstr "이 버러지 같은 년!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = d46ecd88-94d8-fbeb-e287-b73df982a7bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d46ecd88-94d8-fbeb-e287-b73df982a7bb
msgctxt "h186df4acge7eag46ccg8060gc441e1c53186"
msgid ""
"I take my pleasures wherever I please. Zariel would hate that, wouldn't she?"
msgstr "몸 아무 데나 다 기분 좋아지게 하는데 써 버렸어. 자리엘이 알면 싫어하겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d4c43b94-ec8a-8884-4ced-aed1c41ed17c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d4c43b94-ec8a-8884-4ced-aed1c41ed17c
msgctxt "h10c9b127gced9g43b8g9786ge80b60ccf394"
msgid ""
"The clause holds, Wyll. Don't tug on my leash, and you'll be stalking only "
"the wickedest prey."
msgstr "계약은 아직 유효해, 윌. 내가 시키는 대로만 하면 가장 쟁쟁한 상대들과 붙게 해 줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d62dcfe8-f3cf-8ad3-e047-0f52518386d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d62dcfe8-f3cf-8ad3-e047-0f52518386d0
msgctxt "h5f3d3b1agb807g4fdfg8e7bg25b340a57c31"
msgid "Why look for hidden meaning when the words are laid so bare?"
msgstr "대놓고 말했는데 숨겨진 뜻을 왜 찾니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = d6c53b23-34bd-9095-9a04-0278f15956ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d6c53b23-34bd-9095-9a04-0278f15956ad
msgctxt "hcb7093e0ge18cg4065gb163g8210930a9f64"
msgid "What's the catch? What are you getting out of this visit?"
msgstr "숨기는 게 뭐야? 이런다고 네가 얻는 게 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = d74e9c81-c740-2f28-0028-f927b01771cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d74e9c81-c740-2f28-0028-f927b01771cf
msgctxt "he2ca58bcg6c14g4068gb153g61b551bc9354"
msgid "You wanted to hurt me."
msgstr "내가 상처 입는 꼴이 보고 싶던 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = d751075d-6d9a-38e7-731c-fab42d2fa9ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Orin_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d751075d-6d9a-38e7-731c-fab42d2fa9ec
msgctxt "hfe8b14beg44d4g42a7ga135g7d05933199bf"
msgid "I will destroy Orin the Red."
msgstr "적색의 오린을 무찌르러 가지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d75b1f71-7ce0-0c00-4523-2a9816e0fb6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d75b1f71-7ce0-0c00-4523-2a9816e0fb6b
msgctxt "h9b0c6a17g96c6g4334g99ecgeea82ded2dab"
msgid "<i>Hunger.</i>"
msgstr "<i>굶주린 것 같더라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = d8125fbf-d473-a1c0-10ec-5edd0156bf8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:d8125fbf-d473-a1c0-10ec-5edd0156bf8e
msgctxt "h6c1f4397g68ccg456eg87b1g55aef03773db"
msgid ""
"You crave elations unknown on this mortal plane. Something more satisfying "
"than flesh, blood, and bone."
msgstr "필멸의 차원계에서는 알려지지 않은 환희가 맛보고 싶잖아. 살점, 피, 뼈 따위로는 경험할 수 없는 무언가를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = da29049d-be01-2a2b-da62-e57319062f2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:da29049d-be01-2a2b-da62-e57319062f2a
msgctxt "hc83da2bdgf6a1g4cd5g9e0cgbed4fd99ab18"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = da468dff-3f9d-d078-5bf4-312457e347da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:da468dff-3f9d-d078-5bf4-312457e347da
msgctxt "h5f4f6f23gd1c3g459bg9740g024c7f65496e"
msgid "I got what I wanted. So did you."
msgstr "난 욕구 다 채웠어. 너도 마찬가지잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = da47058f-a2b3-faa9-a549-b566a85a925a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#.      - SHADOWHEART_SHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:da47058f-a2b3-faa9-a549-b566a85a925a
msgctxt "h045d643bg9059g49c2ga6d8g479e0763d7b8"
msgid ""
"- and dark as the newest moon. But there's something missing, isn't there?"
msgstr "그리고 새로 떠오른 달만큼이나 어둡고. 근데 뭔가 부족하다는 생각 안 들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = db25eed7-8226-e53e-7d9b-645562111b45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:db25eed7-8226-e53e-7d9b-645562111b45
msgctxt "h1a525ceag5d6dg4270gb6c4gf938e03a6c12"
msgid ""
"That was a nasty display at the Iron Throne. I bet you enjoyed every moment."
msgstr "아이언 스론에서 본 건 정말 끔찍한 광경이었어. 아마 넌 신나서 구경하고 있었겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = dc0d85fa-e85a-709e-e477-4b2bf28f85ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:dc0d85fa-e85a-709e-e477-4b2bf28f85ff
msgctxt "hc88d60c3ge245g4f59ga741gd5cff62b870d"
msgid ""
"You killed Wyll's father right in front of him. Why don't you go back to the "
"Hells, where you belong?"
msgstr "넌 윌 눈앞에서 그 애 아버지를 죽였어. 지옥에나 떨어져. 네가 있을 곳이 거기 아니야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = dcbbbcc3-ddbd-43c1-3c13-2058121a1e99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:dcbbbcc3-ddbd-43c1-3c13-2058121a1e99
msgctxt "h3e7bc213g65a3g409bg924ag86585da4b556"
msgid "As if you care. Is this the kind of 'entertainment' you wanted?"
msgstr "신경도 안 쓰는 주제에 잘도 지껄이는군. 이게 네가 말한 '재미'냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = dcbd6b06-d519-e1e6-f395-0c4fb6cf04fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:dcbd6b06-d519-e1e6-f395-0c4fb6cf04fc
msgctxt "h3f03e0afg2932g41eeg9671gce2c557ba1f2"
msgid ""
"Come now, don't be hard on yourself. I'm sure you carefully weighed the pros "
"and cons."
msgstr "기운 내, 너무 자책하지 말고. 너도 신중하게 장단점을 다 따져보고 나서 행동한 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = dcccc9ad-4a46-df51-dfc6-c8b727201819
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:dcccc9ad-4a46-df51-dfc6-c8b727201819
msgctxt "hc22d598bg4865g4a77g9eacg9da550d195e9"
msgid "Blasted devil. If you're trying to get me killed, you almost succeeded."
msgstr "망할 데빌 자식. 너 때문에 거의 죽을 뻔 했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = dd0637c6-1d40-87b4-1cb7-b8e64e1ba714
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:dd0637c6-1d40-87b4-1cb7-b8e64e1ba714
msgctxt "ha1bc1a40g204eg4139g984cg04f0a4e2f7a2"
msgid ""
"I'm glad to see Ravengard's safe. A shame Wyll had to sacrifice his eternal "
"soul for him."
msgstr "레이븐가드가 무사해 다행이지만, 윌의 영혼이 영원히 제물로 바쳐졌다는 게 안타깝군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = dd5854e0-21b8-e1cd-7cb3-d00433a954a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = False
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:dd5854e0-21b8-e1cd-7cb3-d00433a954a5
msgctxt "hc1f302fegc1b4g43a9g816bg516cec8656f6"
msgid ""
"- and sharp as Vlaakith's own silver blade. But there's something missing, "
"isn't there?"
msgstr "그리고 블라키스의 은검만큼 날카롭고. 근데 뭔가 부족하다는 생각 안 들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = de613c11-fd3e-5c11-516f-dd20ce42f453
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:de613c11-fd3e-5c11-516f-dd20ce42f453
msgctxt "h47fe4758g4cfeg4ab5g99e1g6a6c30df9150"
msgid "I do like when you call me that. Say it again."
msgstr "그렇게 부르니 되게 기분 좋은데. 다시 말해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = de615961-de5b-c487-5c15-9cf1f9637077
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:de615961-de5b-c487-5c15-9cf1f9637077
msgctxt "h0bd08041g4e30g42e4g8a74g75ac98ab95a2"
msgid "Sounds delicious. What are you suggesting?"
msgstr "구미가 당기는데. 어떤 걸 준다는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = df66bd6e-bf2a-0444-6cee-5da6b87a9a29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:df66bd6e-bf2a-0444-6cee-5da6b87a9a29
msgctxt "h78dd899fg5c9ag49fbga0dfgcc9f7bb4fb1d"
msgid ""
"By all means, struggle and seethe when I come for Zariel's prize. Play the "
"hero, put up a fight."
msgstr "내가 자리엘 님을 위해 대공의 목숨을 가지러 올 때 열심히 반항해 봐. 영웅 놀이도 하면서, 맞서 싸워 보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = df750b3d-c4b8-2fa9-ea79-e4243bb15f2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Karlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:df750b3d-c4b8-2fa9-ea79-e4243bb15f2e
msgctxt "h426b8034g5179g46e8g9db0gc43f4df67356"
msgid ""
"Leave the obscenities to Karlach - coming from you, they sound positively "
"<i>unseemly.</i>"
msgstr "욕하는 건 칼라크한테 맡겨. 네가 하니까 되게 <i>안 어울리네</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e0278058-1a90-18cc-dcb6-0ab861b3b1de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e0278058-1a90-18cc-dcb6-0ab861b3b1de
msgctxt "h540796f5g5d1cg417cg866agcab4ecc684d0"
msgid ""
"Look at him. Staunch as an iron-cast statue, proud as a lion after the hunt."
msgstr "저분 좀 봐 봐. 강철로 만든 동상처럼 굳건하시고, 사냥을 마친 사자처럼 늠름하시잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e0343cb7-98c6-9e49-73bf-2b6c5a02dca6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e0343cb7-98c6-9e49-73bf-2b6c5a02dca6
msgctxt "h70829e30ge576g48bag8a8fg3178499a344b"
msgid "Dear me - I've overestimated you."
msgstr "재미없긴. 넌 뭘 좀 안다고 생각했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e086e22f-d80f-6b14-b0ef-1e4ee8a8f862
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e086e22f-d80f-6b14-b0ef-1e4ee8a8f862
msgctxt "h616c3243g8e41g4b3fg850eg9b33eab845f2"
msgid "Trust me, I shan't be making that mistake again. Ta-ta!"
msgstr "나 믿어 봐, 절대로 후회 안 할 거야. 그럼 빠빠이!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e121ee63-3cc2-05b6-4d93-c57cbe34f54c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e121ee63-3cc2-05b6-4d93-c57cbe34f54c
msgctxt "hbae95c49g6567g429agb021g844c4d785fb3"
msgid "Fine. Let's move on."
msgstr "좋아. 이 얘기는 이쯤 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e2604cfd-98f9-a0d8-0dc6-0a4c33b50a3b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e2604cfd-98f9-a0d8-0dc6-0a4c33b50a3b
msgctxt "he91bb385g54c4g495cgaa0agca47d8aba41c"
msgid "Just because you're not my pet doesn't mean you're not useful."
msgstr "네가 더 이상 내 멍멍이가 아니라는 게 쓸모없어졌다는 뜻은 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e267a589-0385-badb-c941-c45661b3edac
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e267a589-0385-badb-c941-c45661b3edac
msgctxt "h8cdf8d35gf813g4967ga5efg1f95ad5a57ab"
msgid "Disgusting creature. You killed my father right in front of me."
msgstr "역겨운 것. 넌 내 눈앞에서 내 아버지를 죽였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e267a589-0385-badb-c941-c45661b3edac
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e267a589-0385-badb-c941-c45661b3edac
msgctxt "h43315e9dg3257g4fa3gb2d2g623a2f38d60b"
msgid "Disgusting creature. You killed Ravengard right in front of me."
msgstr "역겨운 것. 넌 내 눈앞에서 레이븐가드를 죽였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e2bb57bb-3e38-e36d-e61f-42c6c8d4f128
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e2bb57bb-3e38-e36d-e61f-42c6c8d4f128
msgctxt "h28055d36g94dbg43efgaca0gfe157b7a9995"
msgid "If you've come to make another bargain with me, I've had my fill."
msgstr "또 무슨 거래를 하려는 거라면 사양하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e38916e9-1f7a-04a8-7339-47edc801d927
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e38916e9-1f7a-04a8-7339-47edc801d927
msgctxt "h7e55d423g1655g484cg89b4gdde8f2489611"
msgid ""
"I am positively full-up on warlocks - and you are already claimed. What I "
"offer is free for your taking."
msgstr "다른 워락하고는 볼 일 없어. 너도 이미 임자 있는 몸이잖아. 난 그냥 공짜로 뭘 주고 싶은 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e5c6000e-e8fb-611e-0d29-152b2d540164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e5c6000e-e8fb-611e-0d29-152b2d540164
msgctxt "h399dee4bgc77dg4bf0g97a9g920568eadd9d"
msgid "Oh, how the people will applaud their courageous Grand Duke!"
msgstr "아, 다들 용감하신 대공님을 얼마나 칭송할까!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e5d6fb1a-5e77-806b-b410-ca3cd1a212c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e5d6fb1a-5e77-806b-b410-ca3cd1a212c8
msgctxt "hbe83c376g3621g4010g8f9dg263ffd823555"
msgid ""
"You and me, duke and advisor. Baldur's Gate's outlook is radiant indeed."
msgstr "너하고 나하고, 대공과 고문관이 되는 거지. 발더스 게이트의 미래는 완전 눈부실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e606b559-607b-eb31-df46-173bc69b3f21
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e606b559-607b-eb31-df46-173bc69b3f21
msgctxt "hfaed7ec1gad9bg4843g980bg1d59d6e24cca"
msgid "A deal's a deal. But I didn't know I'd have to watch my own father die."
msgstr "계약은 계약이지만, 그렇게 코 앞에서 아버지의 죽음을 봐야 하는 줄은 몰랐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e606b559-607b-eb31-df46-173bc69b3f21
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e606b559-607b-eb31-df46-173bc69b3f21
msgctxt "h8f15c0bfg1a03g49e1g812cg3b3b8ec4ccfb"
msgid "A deal's a deal. But I didn't know I'd have to watch Ravengard die."
msgstr "계약은 계약이지만, 그렇게 코 앞에서 레이븐가드의 죽음을 봐야 하는 줄은 몰랐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e6b93742-f8c3-fbca-022a-c40aee2a7af9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e6b93742-f8c3-fbca-022a-c40aee2a7af9
msgctxt "h6499e169g5083g44a7gb2e4ge6fbb52d9e7f"
msgid "Or don't, and know the eternal ache of the unknown and the unanswered."
msgstr "싫으면 말고. 무슨 일이 벌어졌을까 평생 머리 싸매고 고민하면서 사시든가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e6f610fc-c962-a735-e72f-78e117d5e1b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e6f610fc-c962-a735-e72f-78e117d5e1b4
msgctxt "hf971c319g4017g4c27g8b4bg90635c79bd44"
msgid ""
"I'm quite content, actually. Whatever you're offering, I'm not interested."
msgstr "지금도 충분히 만족해. 뭘 준다고 해도 관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e74ba25a-646e-8337-6581-ef356a562d2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e74ba25a-646e-8337-6581-ef356a562d2c
msgctxt "hc54f6cacg1156g4277g9b90g1e2e4a2c20d0"
msgid "My mistress can be <i>so</i> capricious."
msgstr "우리 여제님은 <i>아주</i> 변덕이 심하시거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e786ea67-4f0c-ef27-179c-be7586192006
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: WYLL_DEVIL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e786ea67-4f0c-ef27-179c-be7586192006
msgctxt "h0d7dc956gd98bg48e2gb718g5ece573bc2c3"
msgid ""
"So you talked to Florrick? The city's most loyal servant. Positively "
"outraged to hear how you failed your father."
msgstr "플로릭하고 만났나 보네? 이 도시의 가장 충실한 일꾼이지. 네가 아버지를 실망하게 했다는 소리를 듣고 엄청 화가 난 것 같던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e786ea67-4f0c-ef27-179c-be7586192006
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e786ea67-4f0c-ef27-179c-be7586192006
msgctxt "h032ee358gcaecg46dag89ceg8960b623fa37"
msgid ""
"So you talked to Florrick? The city's most loyal servant. Positively "
"outraged to hear how Wyll failed his father."
msgstr "플로릭하고 만났나 보네? 이 도시의 가장 충실한 일꾼이지. 네가 아빠를 실망하게 했다는 소리를 듣고 엄청 화가 난 것 같던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e7f37b04-f8fe-1d96-3914-029814d6a411
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e7f37b04-f8fe-1d96-3914-029814d6a411
msgctxt "h8ff8c179g9dbeg4c74g93adg78817eb893db"
msgid ""
"Such a loyal servant of the city, so eager to hear of your exploits. Tell "
"me, darling - how is she?"
msgstr "도시를 위해 열심히 일하면서, 네 활약상도 엄청나게 기대하고 있더라. 그래서, 어떻게 됐어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e831c3fd-66ee-e3e3-4c24-eda6e1b4dba1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e831c3fd-66ee-e3e3-4c24-eda6e1b4dba1
msgctxt "hbd3320e5g3ab4g4583g8fc5g8378926f0a49"
msgid ""
"The terrible tyrant himself. Strike him down, pet - let freedom's bells "
"ring. The brain won't be too far beyond."
msgstr "끔찍한 폭군 녀석이지. 그 자식을 쓰러뜨리고 자유의 종을 울리자, 멍멍아. 뇌는 나중에 처리해도 늦지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e831c3fd-66ee-e3e3-4c24-eda6e1b4dba1
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e831c3fd-66ee-e3e3-4c24-eda6e1b4dba1
msgctxt "h47dbb914ga0dag4d4fgb704g7273af6e93b4"
msgid ""
"The terrible tyrant himself. Strike him down, bug - let freedom's bells "
"ring. The brain won't be too far beyond."
msgstr "끔찍한 폭군 녀석이지. 그 자식을 쓰러뜨리고 자유의 종을 울리자, 꼬물아. 뇌는 나중에 처리해도 늦지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = e861ccb3-a2be-a60a-e8e1-975304488c2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_FlorrickFighFallback_Event_Occurred = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e861ccb3-a2be-a60a-e8e1-975304488c2a
msgctxt "h765c7926gc08ag4b4fg89b3ga314cc0ac543"
msgid ""
"Cordula Eltan accosted us in the Lower City. What in the hells did you tell "
"her?"
msgstr "하부 도시에서 코듈라 엘탄과 문제가 있었다. 그 여자한테 무슨 짓을 한 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e8eff741-18bd-ee28-20ff-1d90c36bb519
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Mizora_Event_FinalDiscussion = False
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_Event_FinalDiscussion = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e8eff741-18bd-ee28-20ff-1d90c36bb519
msgctxt "hf6a7abeag5e02g4b2cga4f7ga0e9f69f9b28"
msgid ""
"Still the Blade of Frontiers, are you? Never let it be said you aren't "
"consistent."
msgstr "변경의 칼날 놀이는 잘하고 있어? 지치지 말고 항상 열심히 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e8eff741-18bd-ee28-20ff-1d90c36bb519
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Mizora_Event_FinalDiscussion = False
#.      - GLO_Wyll_State_BladeOfFrontiers = True
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_Event_FinalDiscussion = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e8eff741-18bd-ee28-20ff-1d90c36bb519
msgctxt "h1c865834g54c0g4c24g9393geaa5662acad6"
msgid ""
"Still the Blade of Frontiers, is he? Never let it be said Wyll isn't "
"consistent."
msgstr "윌이 변경의 칼날 놀이는 잘하고 있어? 지치지 않고 계속할 수 있게 잘 도와줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e991fab1-777b-c194-17a1-8602457b1f7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e991fab1-777b-c194-17a1-8602457b1f7d
msgctxt "hffb42526gaed5g45a0gb6a4ge0a7c8e80244"
msgid ""
"The ecstasy of agony. The pain of the damned, distilled into pure bliss - "
"beyond every climax you've known. The little death, writ large."
msgstr ""
"고통의 절정. 망자들의 고통을 극상의 쾌락으로 증류시켜서, 네가 알던 그 어떤 것보다 기분 좋게 해 줄 거야. 그들의 작은 죽음이 우리의 "
"큰 기쁨이 되는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = e9aee6f5-9045-30c1-4f0e-b34b833329f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:e9aee6f5-9045-30c1-4f0e-b34b833329f8
msgctxt "heb6a10a0gb94dg4bfcg85d2g481fa91bf78b"
msgid ""
"- and seething like the River Styx. But there's something missing, isn't "
"there?"
msgstr "그리고 스틱스강처럼 끓어오르고 있고. 근데 뭔가 부족하다는 생각 안 들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ea5db3db-93ac-98e1-f288-90ac1733f29e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ea5db3db-93ac-98e1-f288-90ac1733f29e
msgctxt "h55152bc9gc552g495cg90d1g8e07c252cd0c"
msgid ""
"What a shame. Ravengard, Florrick - Baldur's Gate has lost its brightest "
"stars."
msgstr "안타깝게 됐네. 레이븐가드에 플로릭까지. 발더스 게이트의 가장 빛나는 별들이 사라지다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = eb51f859-2b83-1989-35e2-58d14d4d359a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:eb51f859-2b83-1989-35e2-58d14d4d359a
msgctxt "hd248af10g3a0eg4c6bgaef6g84224db3b6d2"
msgid ""
"I'm talking of the mundanity of a life ignorant to the thrills of the Nine "
"Hells."
msgstr "아홉 지옥이 주는 쾌락을 모른 채로 사니 따분하지 않냐는 얘기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ec5bf481-1ee8-44bf-1ef8-dcd0626b24fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ec5bf481-1ee8-44bf-1ef8-dcd0626b24fa
msgctxt "h2d1173b9gcf9fg45beg9283g6c5ae4781d3c"
msgid ""
"Well - perhaps I might stop by once a tenday, see how the pup's getting "
"along. A bit of infernal altruism, if you will."
msgstr "한 열흘에 한 번쯤은 가다가 들러야겠네. 우리 강아지 잘 있나 확인도 하고. 지옥 출신 나름의 이타주의랄까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = ed024629-76ab-827c-884b-d533c3fcbcd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wyll_State_BladeOfAvernus = True
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ed024629-76ab-827c-884b-d533c3fcbcd5
msgctxt "h7dc30c70gfc07g4d00ga411g917f6e57be87"
msgid "Zariel would be a good start."
msgstr "자리엘 그 년은 어때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ee40c05a-b245-0b84-0c4d-4cd3b0a03819
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ee40c05a-b245-0b84-0c4d-4cd3b0a03819
msgctxt "h2add2574g64a4g4931gb711g410dcd777afd"
msgid ""
"But a brave, kind, benevolent soul set me free. Gallantry isn't dead after "
"all."
msgstr "근데 어떤 용감하고, 친절하고, 자애로우신 영혼이 날 풀어주셨어. 기사도는 아직 죽지 않았나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ee5ea4b1-f289-adc2-3877-43c1ccca3e3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ee5ea4b1-f289-adc2-3877-43c1ccca3e3d
msgctxt "h03a0ded6g4074g40a8gb65fg43f3105431fb"
msgid ""
"But what about the next battle, and the next? How mighty will the stalwart "
"Blade be, without warlock powers to help him?"
msgstr "근데 다음 전투, 그리고 그다음 전투는 어쩌지? 능력도 없는 우리 용감한 칼날 님께서 얼마나 버틸 수 있으시려나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = eef3cd89-dd2d-ba9f-8419-5f4664798b43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:eef3cd89-dd2d-ba9f-8419-5f4664798b43
msgctxt "h8fca468ag10e4g4cdcg9988g4625713fff11"
msgid "Oh, I do love when you get nasty. The Blade's always had an edge."
msgstr "아, 난 네가 그렇게 말할 때 좋더라. 네 날 선 모습 보는 거 너무 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ef39498e-0eab-e874-1256-25e28bc71410
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ef39498e-0eab-e874-1256-25e28bc71410
msgctxt "hfc7d22f1gf94fg442egaff0gaf0e24878aae"
msgid ""
"I've never seen you so giddy, Karlach. Go on, celebrate your fortunes. But "
"remember that they are lost as quickly as they are gained."
msgstr ""
"그렇게 신난 건 처음 보네, 칼라크. 맘껏 축하해. 이번엔 운이 좋았네. 근데 운이란 건 들어온 속도만큼 빠르게 사라진다는 거 알아 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f0759e6a-94d2-8c8f-1c9d-6567114ee1f3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f0759e6a-94d2-8c8f-1c9d-6567114ee1f3
msgctxt "h6e8f328eg5e73g4201gb075g5c815c474eab"
msgid ""
"Well, perhaps I might pay a visit once you've settled, offer some advice. A "
"bit of infernal altruism, if you will."
msgstr "네가 거기 눌러앉게 되면 가끔 들러서 조언도 좀 해줘야겠네. 지옥 출신 나름의 이타주의랄까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f0759e6a-94d2-8c8f-1c9d-6567114ee1f3
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f0759e6a-94d2-8c8f-1c9d-6567114ee1f3
msgctxt "h03396bd7ge144g402cg9d3dgb8e1f360d5ca"
msgid ""
"Well, perhaps I might pay a visit once he's settled, offer some advice. A "
"bit of infernal altruism, if you will."
msgstr "윌이 거기 눌러앉게 되면 가끔 들러서 조언도 좀 해줘야겠네. 지옥 출신 나름의 이타주의랄까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f35af86d-8f1b-5556-ea04-67cc55a70560
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f35af86d-8f1b-5556-ea04-67cc55a70560
msgctxt "h974d4487g478eg4a1bg8572ga08bcc664afa"
msgid ""
"<i>Tell</i> me you haven't forgotten. Once the Absolute is no more, so is my "
"aid."
msgstr "내 말 <i>명심해</i>. 절대자가 없으면, 내 도움도 없는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f3a26844-f625-be3e-e785-375084edefc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f3a26844-f625-be3e-e785-375084edefc2
msgctxt "h0ae3108bg2c23g455cg9403g17b6cbc7d79b"
msgid ""
"Pro: freedom. No more pact, no more hellbound soul. Con: killing off his own "
"father, Baldur's Gate's most beloved duke, and forever altering the city's "
"future."
msgstr ""
"장점은 자유로워졌다는 거지. 계약도 끝났고, 지옥에 영혼이 묶여있거나 하지도 않고. 단점은 발더스 게이트의 가장 사랑받는 대공인 자기 "
"아빠가 도시의 미래를 위해 희생됐다는 게 있겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f46230a0-6d38-e728-515c-66c3331507c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f46230a0-6d38-e728-515c-66c3331507c4
msgctxt "hb0beb50bg1768g4375ga8cfge2ac28fae60b"
msgid ""
"But I know the truth, I see the change. You turned the pain of the damned "
"into impossible pleasure."
msgstr "하지만 난 뭔가 달라진 거 다 알아. 게다가 넌 망자들의 고통을 네 말도 안 되는 쾌락을 느끼는 일에 써버린 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f46d8060-0391-2725-44e4-91b732c4a732
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f46d8060-0391-2725-44e4-91b732c4a732
msgctxt "hc9e98d16g4c8eg4a96g93afg7850bf891f57"
msgid ""
"- and seethe like the River Styx. But there's something missing, isn't there?"
msgstr "그리고 스틱스강처럼 끓어오르고 있고. 근데 뭔가 부족하다는 생각 안 들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = f4f954c2-d546-817b-8bdd-3ebf572b83aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f4f954c2-d546-817b-8bdd-3ebf572b83aa
msgctxt "h6af25d55g7834g4cf1gaa35g8cf8fc367316"
msgid ""
"Cut the shit, Mizora. How dare you force me to make such an impossible "
"choice?"
msgstr "헛소리 집어치워, 미조라. 감히 내가 그런 말도 안 되는 결정을 하게 만들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f567db4c-457c-c8a5-3829-fa2c2d5ac33b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Mizora_Event_FinalDiscussion = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f567db4c-457c-c8a5-3829-fa2c2d5ac33b
msgctxt "h33636e7dgc421g4d27gb442g18a535b502f2"
msgid "Ready and waiting."
msgstr "난 준비 끝났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f5829590-c873-c916-fcc9-62b8a99f56e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f5829590-c873-c916-fcc9-62b8a99f56e9
msgctxt "h8b9928e7g1300g4296gb952g54535635c6aa"
msgid "You dug your own hole, pup. I merely supplied the claws."
msgstr "네가 자초했잖니, 멍멍아. 난 도움을 조금 준 것뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f5a46caf-db6d-06d2-3c8b-6de1a7f1ad53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f5a46caf-db6d-06d2-3c8b-6de1a7f1ad53
msgctxt "h2215dab0g6f50g4249gb55fg06a3a9289552"
msgid "It's a win-win."
msgstr "서로 좋잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f66da2fa-7952-dc42-bb8a-1610353236a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = True
#.   Tag:
#.      - WYLL_DEVIL(1) = False
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f66da2fa-7952-dc42-bb8a-1610353236a2
msgctxt "hf3f2f186g1fc0g4592g9d50gc567c50ecfe5"
msgid ""
"You've been my private hellhound and hunter, Wyll - ever so eager. But I've "
"seen something new:"
msgstr "항상 사냥꾼이자 내 전용 지옥사냥개로서 고생 많았어, 윌. 그래서인가 너 요즘..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f691eef4-7b99-44fa-ac27-3c09d30b4707
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f691eef4-7b99-44fa-ac27-3c09d30b4707
msgctxt "he52ea1ebgb855g48b7g940dg0e07e6c97671"
msgid "So what's our first order of business, sir duke?"
msgstr "그럼, 저희는 이제 누구한테 먼저 가나요, 대공님?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Wyll
#. NodeID = f88b98c8-f15b-d9a4-2fbe-8d5448748316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f88b98c8-f15b-d9a4-2fbe-8d5448748316
msgctxt "h3f02b748g1b02g418eg8331g6abc9b60262f"
msgid "You are <i>such</i> a piece of shit, Mizora."
msgstr "넌 <i>정말</i> 썅년이야, 미조라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f9e0633c-66b2-e197-f036-fa2722deabf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f9e0633c-66b2-e197-f036-fa2722deabf6
msgctxt "he80c8a3dgc13cg46acgbc40g4678e5765415"
msgid ""
"For now, you've tipped the scales in your favour. But all it takes is a "
"whisper for me to tip them back."
msgstr "지금은 저울이 너희 쪽으로 기운 것 같네. 내가 바람만 후 불어도 다시 뒤집히긴 하겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = f9f07443-c017-f18b-1573-2deaa25fc99d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Mizora_Event_RomancedMizora(1) = True
#.      - CAMP_Mizora_Event_PostRomanceGreeting(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Mizora_Event_PostRomanceGreeting(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:f9f07443-c017-f18b-1573-2deaa25fc99d
msgctxt "h83d5a0b6g4216g4ca3g9368g415b7df3aa55"
msgid "It was good for me. Was it good for you?"
msgstr "난 좋았는데. 너도 좋았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = fa27329b-b1d0-4bed-6c19-e0cb091e5311
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:fa27329b-b1d0-4bed-6c19-e0cb091e5311
msgctxt "h5e617f61gaca4g4bdag8b16g017b679b13d5"
msgid "You're as cunning as a fox. It's a delight to see you in action."
msgstr "넌 여우만큼이나 교활한 여자야. 근데 난 네 그런 모습이 마음에 들더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = fa52ed8a-7c53-fdbb-b152-379d10748e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:fa52ed8a-7c53-fdbb-b152-379d10748e03
msgctxt "h2c2e860eg8513g477dg9addg2f1d7ae348da"
msgid ""
"The fire of Avernus courses through you. And you know only I can bear it."
msgstr "네 몸에 흐르는 아베르누스의 불길. 그걸 감당할 수 있는 건 나밖에 없다는 거 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = fad7eb91-43d8-f386-9d4c-8d3e7df28eef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:fad7eb91-43d8-f386-9d4c-8d3e7df28eef
msgctxt "h8e483351gad19g4040g8debg6a7314944559"
msgid ""
"Far from it. I'm positively <i>wrecked</i> to see my poor Wyll orphaned like "
"this."
msgstr "아니거든. 난 우리 불쌍한 윌이 고아가 됐다는 사실에 가슴이 <i>미어진다고</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = fb56923f-1643-864a-4622-54ab312f3269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:fb56923f-1643-864a-4622-54ab312f3269
msgctxt "h4ed38f66g3ecfg431cg91b4gb4add2b5cf5a"
msgid ""
"Ah, the thrill of the unknown. I can't <i>wait</i> to see how this epic "
"plays out."
msgstr "아, 설레네. 얼마나 재밌을지 보고 싶어서 못 <i>참겠어</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = fc1214a3-e583-09d0-5a52-1f6cfab116c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:fc1214a3-e583-09d0-5a52-1f6cfab116c7
msgctxt "h4dcc1726g16e9g439ega7b5gc79cd8b25e9b"
msgid ""
"Oh dear - the pangs of remorse. Is it our night you regret, or the fact we "
"were caught?"
msgstr "어머, 갑자기 죄책감이 드시나 보네. 지금 후회하는 게 어젯밤 일이야, 아니면 들킨 일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = fe467c01-9191-bf40-34ba-7540711aab51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:fe467c01-9191-bf40-34ba-7540711aab51
msgctxt "he587a508g7f91g4508g9254g38f36117738e"
msgid ""
"The Nine Hells of Baator. Each its own domain, each with its own archdevil "
"to rule it."
msgstr "베이아터의 아홉 지옥. 각각 독자적인 권역이고, 각기 다른 아크데빌들이 지배하고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = fe97908a-4d2e-4db1-2ccc-2924d79239c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:fe97908a-4d2e-4db1-2ccc-2924d79239c9
msgctxt "h5fdf9c07ge095g429egb43ag765a71ed7e69"
msgid "You have the best ideas."
msgstr "잘 생각했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Player
#. NodeID = ff13891c-bf51-be23-314c-557468d79929
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ff13891c-bf51-be23-314c-557468d79929
msgctxt "hfbc8ee5fg861fg420fg9284g982a09fee500"
msgid "I certainly did. Wyll's father is safe, and Wyll's free of you at last."
msgstr "그렇고 말고. 윌 아빠도 구해냈고, 네 손아귀에서 윌도 빼냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora
#. Speaker = Mizora
#. NodeID = ff590661-ff0f-d553-adac-8bfc4fe9e388
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Mizora_Event_FinalDiscussion = False
#.      - GLO_Wyll_State_BladeOfAvernus = True
#. SetFlags:
#.   Global:
#.     - CAMP_Mizora_Event_FinalDiscussion = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Mizora:ff590661-ff0f-d553-adac-8bfc4fe9e388
msgctxt "he8ec2d18g1728g4173ga7daga7b6312e8a94"
msgid "The Blade of Avernus. How marvellous - it rolls right off the tongue."
msgstr "아베르누스의 칼날. 아주 마음에 들어. 입에도 착착 감기고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 01adfdfc-2732-c60c-46f9-b33438fa86e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:01adfdfc-2732-c60c-46f9-b33438fa86e5
msgctxt "h36675b05g833bg4344gb579g5d4601b8277e"
msgid "What next?"
msgstr "다음은 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 02968175-0623-d362-a11c-93fbcdb3f054
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:02968175-0623-d362-a11c-93fbcdb3f054
msgctxt "hc013cf27gbe40g4dc4g9472g1706580268f8"
msgid "I couldn't have done it without you."
msgstr "당신 없이는 해내지 못 했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 04be25c6-7a5d-4c36-2dbf-40c04c7b23f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:04be25c6-7a5d-4c36-2dbf-40c04c7b23f5
msgctxt "he5aec51ag44a1g4137gb1a5gb703a422c025"
msgid ""
"So mighty are her wonders, her great wisdom. Together, we will set this fair "
"land free of tyranny and murder."
msgstr "그분의 경이와 지혜에는 끝이 없어라. 함께라면, 우린 이 눈부신 땅에서 폭정과 살육을 몰아낼지니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 05ac94fd-4a25-9882-f99d-344671d458e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:05ac94fd-4a25-9882-f99d-344671d458e8
msgctxt "h9cd46fb7g701fg4332g9497g5e353dbe86a9"
msgid "Next? Eternity."
msgstr "다음? 영생이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 06a11b2f-561a-27fe-fb59-c89189d9d147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:06a11b2f-561a-27fe-fb59-c89189d9d147
msgctxt "hf60a4c70gd172g49cdgabacg2e92881a29f3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 08b62e3c-9f25-72fe-2a4a-7e208a645efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:08b62e3c-9f25-72fe-2a4a-7e208a645efb
msgctxt "hc84195a6g2aeag45adgb210gd48fe60dffb0"
msgid "Alas. I will live my life for us both."
msgstr "아아. 나는 내 연인의 몫까지 살아내리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 0b6629dc-3d68-f552-3537-5af31cb51b7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Nightsong_Solo_AgreedToJoinCamp(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Nightsong_Solo_AgreedToJoinCamp(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:0b6629dc-3d68-f552-3537-5af31cb51b7d
msgctxt "h9c07cfdagd70eg44eagb409g9957eeffa64a"
msgid ""
"You should join my camp permanently. We can fight the powers of evil "
"together."
msgstr "내 야영지에 완전히 합류하는 게 어때. 우린 함께 악의 세력에 맞서 싸울 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 0bca9beb-3953-b617-45c3-751f26faf54d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:0bca9beb-3953-b617-45c3-751f26faf54d
msgctxt "h473156begaddcg45b0g90d3gaf8d579c585f"
msgid "I hope you can rest easy now, Dame Aylin."
msgstr "당신이 이제 편히 쉬었으면 좋겠군, 여기사 에일린."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 0c103371-b56a-b96e-0379-62f75d0426d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_IsDead = False
#.   Object:
#.      - CAMP_Nightsong_Knows_HowNightsongTrappedInShadowfell(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Nightsong_Knows_HowNightsongTrappedInShadowfell(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:0c103371-b56a-b96e-0379-62f75d0426d8
msgctxt "h2b2f0873g7c88g4ac2gb497g527d3f940d1c"
msgid "You and Isobel seem to have a lot of history..."
msgstr "당신과 이소벨은 많은 일을 겪은 거 같군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 0e86598e-9aba-fe2f-3dff-f7e2b4583b0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:0e86598e-9aba-fe2f-3dff-f7e2b4583b0d
msgctxt "he9e31372gd5c5g4e8cgb864g1a726242fd20"
msgid "I will sleep with both eyes open this night."
msgstr "오늘 밤은 두 눈을 뜨고 잘 거라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 13348eea-c0f6-20d9-73dd-8b31c82c605b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_Nightsong_Knows_LorroakansPlan = False
#.      - LOW_SorcerousSundries_Knows_AboutLorroakanGoingAfterNightsong = True
#.      - LOW_Lorroakan_State_IsPermadefeated = False
#.      - LOW_Lorroakan_Knows_NightsongIsAtCamp = True
#.      - LOW_Nightsong_Event_GoToRamazithTower = False
#. SetFlags:
#.   Global:
#.     - LOW_Nightsong_Knows_LorroakansPlan = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:13348eea-c0f6-20d9-73dd-8b31c82c605b
msgctxt "hdb26d7c0g6cf9g4697g9aa7ga0c942f7523b"
msgid ""
"There is a dangerous wizard called Lorroakan who seeks to lay claim to you."
msgstr "당신을 손에 넣으려고 하는 로로아칸이란 위험한 위저드가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 14a34637-23cd-727e-7cfd-3d44edbb9813
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Act3_Visited = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:14a34637-23cd-727e-7cfd-3d44edbb9813
msgctxt "hfc30bb03gaaeag4741ga5a5g7d33e8627bbf"
msgid "Come to bask in the glow of the Moonmaiden's sword? Be most welcome."
msgstr "달처녀의 검의 광채를 받아보고 싶어서 온 건가? 열렬히 환영하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 15f321d8-5a33-f911-062c-584ce216466b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:15f321d8-5a33-f911-062c-584ce216466b
msgctxt "h57ec3058g8b72g4655g8630gfc93e58d89bc"
msgid ""
"I was killed, murdered, made dead, over and over and over by Justiciars of "
"every make and kind. I was reborn, for it is my nature. And Ketheric fed "
"upon my immortality all the while."
msgstr ""
"나는 죽임당했고, 살해당했으며, 죽음에 처해졌노라. 죽고, 죽고, 죽으며 수많은 저스티시어의 손을 거쳤다. 본성에 따라 나는 계속해서 "
"부활했고, 케서릭은 나의 불멸성을 야금야금 갉아먹었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 16741934-37a1-9bed-463e-a9d85923a4f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:16741934-37a1-9bed-463e-a9d85923a4f4
msgctxt "h0739b91cg2b1eg4031ga7a2geda0e9809f49"
msgid "How do you intend to spend your newfound freedom?"
msgstr "새로 얻은 자유를 어떻게 누릴 생각이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 18503f4a-852e-29bf-5e72-c9abd9660b7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:18503f4a-852e-29bf-5e72-c9abd9660b7f
msgctxt "h9b311f95ga3cdg4e8fg8b90gca14463f3f11"
msgid ""
"Now: let us caper, dance, and engage in every ribald pleasure before a new "
"dawn breaks."
msgstr "이제, 새벽이 오기 전까지 춤추고, 뛰놀며, 모든 천박한 즐거움들을 기꺼이 만끽하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 1cdccd1f-a968-4209-5ebf-3c31ff44b722
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:1cdccd1f-a968-4209-5ebf-3c31ff44b722
msgctxt "h36b35ef5g6e31g4216gb7f8gb723f0ab0604"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 1e0544d9-3452-8177-6642-bafc32987e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:1e0544d9-3452-8177-6642-bafc32987e3b
msgctxt "hac6b8d5fg8e91g4a34gb442ge9549414194f"
msgid "You have recovered your soul in the taking of Ketheric's foul life."
msgstr "그대의 영혼은 사악한 케서릭을 처단함으로써 치유되었네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 2183fd84-ffd0-c663-1c37-fac3ef98075e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Nightsong_ConfirmedMotherSelun(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:2183fd84-ffd0-c663-1c37-fac3ef98075e
msgctxt "h1370666agf8e7g43b1g9aeag77e40b0c4275"
msgid ""
"Would your mother be willing to aid us in the fight against the Dead Three?"
msgstr "삼악신과의 싸움에서 당신의 어머니가 우리를 도와줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 245c2ac8-f8c9-3c32-e0a6-2a4cd90bb832
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:245c2ac8-f8c9-3c32-e0a6-2a4cd90bb832
#, fuzzy
msgctxt "h2698c2d2g9a73g4c2egbc24ga1513b74221d"
msgid ""
"Ho! Surely you cannot fear me - you who have fought beside me in the war "
"against damned Ketheric Thorm?"
msgstr "호! 나를 두려워 하지 않는 것이 분명하군. 그대가 빌어먹을 케서릭 쏨과의 전쟁에서 나와 함께 싸운 이인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 27296586-93a1-0dce-3b41-a49cf84a4124
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_Lorroakan_State_IsPermadefeated = True
#.      - LOW_Nightsong_Knows_LorroakanIsDead = False
#. SetFlags:
#.   Global:
#.     - LOW_Nightsong_Knows_LorroakanIsDead = True
#.     - LOW_SorcerousSundries_State_PlayersSideWithNightsong = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:27296586-93a1-0dce-3b41-a49cf84a4124
msgctxt "h2ec3b10egd1ddg40a9g9c47g7b170003451f"
msgid "I have defeated Lorroakan, the wizard who sought to hunt you down."
msgstr "당신을 추적하던 로로아칸이라는 위저드를 무찔렀어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 2978447b-ed6f-08b8-6662-19c02433470a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_GivenSlayerForm = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:2978447b-ed6f-08b8-6662-19c02433470a
msgctxt "he3761e1bge374g4039g9485g2c5122a24fab"
msgid "Yes, I am quite the Slayer, aren't I?"
msgstr "맞아, 내가 꽤 훌륭한 슬레이어이긴 하지. 그렇지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 33c2faf3-0106-b62c-ac12-054c1b9f7a81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:33c2faf3-0106-b62c-ac12-054c1b9f7a81
msgctxt "h89c14176g9a39g4d0cgb3e8ga883319e1ca3"
msgid ""
"In due time. Mother Selûne will tell me when the time is right. Painful "
"truths should be handled with some decorum."
msgstr "적절한 때에, 어머니 셀루네께서 때가 되면 나에게 말해주실 걸세. 고통스러운 진실은 세심하게 다루어야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 35c7b6f4-d0c7-b996-d95e-9bc8e810236c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_Nightsong_Knows_HowNightsongTrappedInShadowfell(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Nightsong_Knows_HowNightsongTrappedInShadowfell(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:35c7b6f4-d0c7-b996-d95e-9bc8e810236c
msgctxt "h20c9077agad49g43ceg9c12g6db21c0d826f"
msgid "How did you come to be trapped in the Shadowfell?"
msgstr "어쩌다 섀도펠에 갇히게 된 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 37939e26-e508-26d3-b33b-c6f610c3be2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Nightsong_HasMet(1) = True
#.      - SCE_IsobelNightsongReunion_Followup_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:37939e26-e508-26d3-b33b-c6f610c3be2a
msgctxt "hb4f134d9g058ag459dg91d4g1681a71f3185"
msgid "Begone, friend; I have a darling to adore."
msgstr "사라지게, 친구여. 나는 사랑하는 이를 흠모해야 하니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 393716b7-0f38-a9df-768c-b54d78136f5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:393716b7-0f38-a9df-768c-b54d78136f5b
msgctxt "h54e0632bg2a74g4683g9520gb9c00d8db5e2"
msgid ""
"Isobel was - is - the love of my eternal life. I adored her from the moment "
"I beheld her sweet face, her great, wise eyes."
msgstr "이소벨은 내 불멸의 삶의 연인이었- 연인이지. 나는 그녀의 아름다운 얼굴, 놀랍고 현명한 눈을 본 순간부터 그녀를 사랑했다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 3d3e487a-e020-214d-8dcd-850f2ffec71a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_SorcerousSundries_State_ToldNightsongAboutAradin = False
#.      - LOW_Aradin_Knows_BelievesNightsongIsAtCamp = True
#.      - LOW_Aradin_State_IsPermaDefeated = False
#. SetFlags:
#.   Global:
#.     - LOW_SorcerousSundries_State_ToldNightsongAboutAradin = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:3d3e487a-e020-214d-8dcd-850f2ffec71a
msgctxt "hb6bfd8a0g56c1g4337gbd4dg36bc04492233"
msgid ""
"I have reason to believe a mercenary named Aradin might try to capture you."
msgstr "아라딘이라는 용병이 너를 납치하려고 하는 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 4f1c80e5-d261-9508-72a3-74d54dac7581
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:4f1c80e5-d261-9508-72a3-74d54dac7581
msgctxt "h2ca9471eg06aag4e79gb211gf17a9d08b9e5"
msgid ""
"Your mother is wrong. I'd send you to Ketheric again, if given the chance."
msgstr "당신의 어머니는 틀렸어. 다시 돌아가도 널 케서릭에게 보냈을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 4f5f173f-83a7-b69b-0605-12e0b0d98e69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:4f5f173f-83a7-b69b-0605-12e0b0d98e69
msgctxt "h57af93a5g07d6g4454gb88dg47af378732ad"
msgid ""
"He turned to wretched Shar, the Lady of Loss, for relief. And she whispered "
"into his ear, poisoning his mind."
msgstr "그는 상실의 여인, 샤에게 구원을 간청하기로 했네. 그러자 그녀는 그의 귀에 속삭이며 그의 정신을 오염시켰지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 513209e5-46e3-94f5-cb03-a259cc827ab0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_IsDead = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:513209e5-46e3-94f5-cb03-a259cc827ab0
msgctxt "h92438aacg981eg45acg93dcge702c28309ad"
msgid ""
"My darling Isobel says we will stay allied at your side. I am pleased to "
"hear it."
msgstr "나의 연인 이소벨은 함께 그대의 동맹으로 남겠다고 하더군. 두 팔 벌려 반길 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 5236fafd-f172-7910-4506-254b35e540bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:5236fafd-f172-7910-4506-254b35e540bd
msgctxt "hb63487f4gcf07g437dgb7b3g94735f152515"
msgid ""
"Yes! My mother proclaims you cleansed, our allegiances aligned once more. By "
"her Word, let it be so."
msgstr ""
"좋아! 나의 어머니께서 그대가 정화되었다고 말씀하셨으니, 다시 한번 우리의 믿음은 일치되었네. 그분의 말씀대로, 그렇게 될 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 52b5529d-d226-d4d3-8e82-022bbe2116e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:52b5529d-d226-d4d3-8e82-022bbe2116e8
msgctxt "h4d477b9fga30cg4ab5ga999g2fc796a51c5d"
msgid "But lo! The brute is dead. And we, <i>we live</i>!"
msgstr "허나 보아라! 그 짐승은 죽었으니. 반면 우린, <i>우린 살아 있노라</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 5ffd1976-5348-4443-4e08-6a9dbdbcf531
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:5ffd1976-5348-4443-4e08-6a9dbdbcf531
msgctxt "h5029c972gbdbdg4046g9da1gae2f9f40b96c"
msgid "Yes. I wish for the very same."
msgstr "그래. 나도 정말 그랬으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 62127e1e-3212-a011-71f4-efc62292c96d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:62127e1e-3212-a011-71f4-efc62292c96d
msgctxt "h26dc25aegfeecg4571gb325g6405d5abb842"
msgid ""
"When she died - curse the day, the hour! - we each of us mourned bitterly. "
"But Ketheric's pain could be touched by no aid, no boundary."
msgstr ""
"이소벨이 죽었을 때, 그 저주받을 날과 시간에! 우리 모두 처절한 비탄에 빠졌네. 그러나 케서릭의 고통은 그 끝이 없어서, 어떠한 것도 "
"그에게 위안이 되지 않았다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 6635acc5-3f39-8d31-c1c0-f873b6a7166c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:6635acc5-3f39-8d31-c1c0-f873b6a7166c
msgctxt "h2a883959g557eg47e8g8da8g4a49df87df41"
msgid "Where's the silver light, the moon-magic?"
msgstr "은색 광채 같은 건 없나, 달-마법 같은 거?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 6b0d7b50-ba7f-e56c-3644-dfcd6eea5b7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:6b0d7b50-ba7f-e56c-3644-dfcd6eea5b7d
msgctxt "h2c4c12c6g6f30g453fgbb5dgd2c173db28c0"
msgid ""
"I trust your judgement. If you believe this magician's threats are sound, "
"then we must face him."
msgstr "그대의 판단을 믿는다. 그대가 이 마법사의 위험이 염려된다면, 우리는 그자를 반드시 대면할 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 70d31ca8-c1cb-4e4e-6825-c4c5fe1c61b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_IsDead = True
#.   Object:
#.      - CAMP_Nightsong_Knows_HowNightsongTrappedInShadowfell(1) = False
#. SetFlags:
#.   Object:
#.     - CAMP_Nightsong_Knows_HowNightsongTrappedInShadowfell(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:70d31ca8-c1cb-4e4e-6825-c4c5fe1c61b0
msgctxt "he8b02aa7gcd3cg4082g9329gd842cd35a1d2"
msgid "You and Isobel seemed to have a lot of history..."
msgstr "당신과 이소벨은 많은 일을 겪은 거 같군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 7cec31e2-0f39-c512-36d0-90e99fb56919
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:7cec31e2-0f39-c512-36d0-90e99fb56919
msgctxt "h0cc0793egc778g4a2agaadbg5a568a4d9e3b"
msgid ""
"Hmm. Ketheric Thorm. Father of my one and only love. Enslaver of Dame Aylin."
msgstr "흠. 케서릭 쏨의 짓이지. 내 하나뿐인 연인의 부친이자, 여기사 에일린을 노예 삼은 자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 7dab9d52-54b0-0498-134e-7e83c1b4d8c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:7dab9d52-54b0-0498-134e-7e83c1b4d8c3
msgctxt "hdf70da4dg40c0g4214gadb1gcc645704413c"
msgid ""
"Our thoughts are as one, my friend. You must face the Chosen of Bane and "
"Bhaal. I will do my part to see them laid low."
msgstr ""
"우리의 생각이 일치하는군, 나의 친구여. 그대는 베인과 바알의 선택을 받은 자들과 맞서야 한다. 그들을 쓰러뜨리는 데에 내 몫을 다 "
"하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 826784f0-9bf4-c751-701f-d2ec8c37bdd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:826784f0-9bf4-c751-701f-d2ec8c37bdd4
msgctxt "h0f762bcfgdd02g4ed5gbdfeg5992479449a4"
msgid "I'd have taken gold over a prayer."
msgstr "기도보단 금화를 받는 편이 좋은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 83e10c02-9232-d1be-f92b-16902a906bfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:83e10c02-9232-d1be-f92b-16902a906bfc
msgctxt "heb6b8e45g0be9g423fg9baegaf142155b508"
msgid "Now - I must inform you of my news."
msgstr "이제, 내 이야기를 말해줘야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 83ecd7e4-834e-bfe2-6712-b1620a643d23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:83ecd7e4-834e-bfe2-6712-b1620a643d23
msgctxt "h0a44db51g5303g43b4gb904g7fcd7a6f930a"
msgid ""
"He and his loathsome advisor Balthazar lured me into the Shadowfell, claimed "
"they'd found someone in need of my aid. There they trapped me in their "
"infernal cage."
msgstr ""
"케서릭과 그의 역겨운 조언자인 발타자르는 내 도움이 필요한 사람이 있다며 나를 섀도펠로 유인했네. 그곳에서 그들은 나를 영원의 감옥에 "
"가뒀지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 84848afe-4823-0012-bfdb-06b035c03660
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:84848afe-4823-0012-bfdb-06b035c03660
msgctxt "hf7ba9e92g93c7g4b07ga5c6g98c7f25c3cfd"
msgid ""
"Now he is dead. And his twisted facsimile of sweet Isobel, returned to the "
"grave. I'd give anything for one more day with her - the <i>real </i>her."
msgstr ""
"이제 놈은 죽었다. 그리고 사랑스러운 이소벨의 뒤틀린 복제품 또한 무덤으로 돌아갔지. 그녀, <i>진짜</i> 이소벨과 하룻밤만 더 "
"함께할 수 있다면 무엇이든 아깝지 않으련만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 87274dc0-2d42-6307-ff8f-f881fbe2b7cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:87274dc0-2d42-6307-ff8f-f881fbe2b7cc
msgctxt "hce13e226g054cg4b47gb3fagd4c718a58d24"
msgid ""
"Set your mind at ease, my friend. Dame Aylin is more well now than she has "
"been this past century."
msgstr "안심하게 친구여. 지금의 여기사 에일린은 지난 세기보다도 더 강하다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 8bcb1f4c-3aaf-cade-9b29-9a901386504f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:8bcb1f4c-3aaf-cade-9b29-9a901386504f
msgctxt "h528d1c2dg5b8eg4a68ga700g62ba36c6d80e"
msgid "What is it?"
msgstr "무슨 일이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 8d57af4b-0024-1658-c66f-306e997f9235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:8d57af4b-0024-1658-c66f-306e997f9235
msgctxt "h1ca6f780g6c5fg4d86g87fcg79c73d25ecdb"
msgid ""
"There is a Selûnite enclave not far from fair Baldur's Gate. The Absolute's "
"armies have left them in sore need of aid. Aid I will provide, in the "
"Moonmaiden's name."
msgstr ""
"셀루네 신도들의 거주지가 발더스 게이트에서 멀지 않은 곳에 있네. 절대자의 군대가 그들을 곤경에 빠뜨려 도움이 간절하지. 내가 그들을 "
"도울 것이다. 달처녀의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 911b9561-5194-4cb4-3853-6cbbdf331c42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Nightsong_HasMet(1) = False
#.   Global:
#.      - Act3_Visited = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Nightsong_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:911b9561-5194-4cb4-3853-6cbbdf331c42
msgctxt "h60b62cfag2831g4578gbb48gb49371865519"
msgid ""
"There you are. I have awaited your arrival with great anticipation. Come "
"closer."
msgstr "여기 있었군. 그대가 오길 고대하고 있던 참이다. 이리로 오게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 9196036f-35ae-eb39-d2e6-fa067ee207e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:9196036f-35ae-eb39-d2e6-fa067ee207e4
msgctxt "h99a2fbedg660dg40aag8f50g4b564aec1d0e"
msgid ""
"Moonmaiden, I ask you to cleanse the wickedness in the heart of the slayer "
"of Ketheric Thorm! Forgive them the sin of sending Dame Aylin into his foul "
"clutches!"
msgstr ""
"달처녀시여, 당신께서 케서릭 쏨을 처단한 자의 마음 속 사악함을 정화해 주시길 간청하오니! 여기사 에일린을 쏨의 더러운 마수에 넘긴 "
"이들의 죄를 사하소서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 96a3431f-ad73-0611-65f8-869170c945db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:96a3431f-ad73-0611-65f8-869170c945db
msgctxt "h7a55935bg1dd3g4923gacc1gc4e90b28fe2b"
msgid "Blessings upon the slayer of the wicked one!"
msgstr "악인을 처단한 자에게 축복 있으리!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 96b4f943-e408-715e-9672-e8dd96f85820
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:96b4f943-e408-715e-9672-e8dd96f85820
msgctxt "h3fe74f55gbd1ag48dbgb8c6g231752f11b5d"
msgid ""
"Indeed I do. Let his demise serve as a warning to anyone else who'd seek you "
"out."
msgstr "정말 나도 그렇게 생각해. 그 자의 죽음이 당신을 찾아내려는 자들에게 경고가 되었으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 9e81e718-a0c3-4024-cea2-ad53b937a6db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:9e81e718-a0c3-4024-cea2-ad53b937a6db
msgctxt "h2e801423gb12fg4bcaga27bgd2eddb7bc346"
msgid "Pray ask, and I will tell."
msgstr "물어보라. 답해줄 터이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = 9e824b85-77dd-9c66-dbbe-9eaa066dadf0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - ORI_Shadowheart_State_AskedNightsong(1) = False
#.   Global:
#.      - ORI_Shadowheart_State_EnemyOfSharPath = True
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = False
#.      - NIGHT_NightsongShadowheartVisit = False
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#. SetFlags:
#.   Dialog:
#.     - ORI_Shadowheart_State_AskedNightsong(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:9e824b85-77dd-9c66-dbbe-9eaa066dadf0
msgctxt "hdd695d90gffa2g47cagbd4cg7efc605f4758"
msgid "You claimed you knew things about me. I want to hear them."
msgstr "나에 대해 안다고 했었지. 그 말을 듣고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 9f8af772-55e8-6dfa-3a4e-30048f59bbf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:9f8af772-55e8-6dfa-3a4e-30048f59bbf6
msgctxt "h244ea32cg722fg481agb244g729eb17dc358"
msgid ""
"But her father Ketheric distrusted me from the first. He did not fancy an "
"immortal for Isobel's mate. I understood; I respected his concerns; but our "
"love was stronger than a father's reservations."
msgstr ""
"그러나 그녀의 아버지인 케서릭은 처음부터 나를 불신했네. 그 녀석은 딸의 연인이 불멸자인걸 원하지 않았어. 나는 그의 우려를 이해했고, "
"존중했지만 우리의 사랑은 아버지의 걱정보다 강했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = 9ff85393-b6e3-95fe-e444-79ca5f24a792
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:9ff85393-b6e3-95fe-e444-79ca5f24a792
msgctxt "haa997a1dg4c64g49eag90aeg2f2fdd4b2b4d"
msgid "Do I not radiate with my mother's brightness, her glory?"
msgstr "내가 그분의 광채와 영광으로 빛나는 게 보이지 않는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = a28d718b-89a4-9cd0-2516-893fdb48cf41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:a28d718b-89a4-9cd0-2516-893fdb48cf41
msgctxt "h04029971ge305g4c63ga77fgf184cb5153eb"
msgid "<i>Stay back, ready to defend yourself.</i>"
msgstr "<i>물러서서 방어 태세를 갖춘다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = a2d95e15-a474-0625-dd8f-054d0321627a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:a2d95e15-a474-0625-dd8f-054d0321627a
msgctxt "hd5c82b29gce7ag4abdgbeb9g6bebd4fa8635"
msgid ""
"Ha! I am not surprised. You have a great talent for tearing down Dame "
"Aylin's enemies. Thank you, my friend. From the bottom of my heart."
msgstr "아! 놀랍지도 않군. 그대는 이 여기사 에일린의 적들을 찢어발기는 훌륭한 재능이 있군. 고맙네. 나의 친구여. 진심으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = a3f3298a-6e85-3b0f-d729-5fb2a71027a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:a3f3298a-6e85-3b0f-d729-5fb2a71027a7
msgctxt "h0f9b0f80g9c05g4ee9g87fbgc84744225a2a"
msgid ""
"No doubt you do. But I will come to you, when Mother Selûne deems the moment "
"is right. Patience, girl - it will come soon enough. And you cannot unlearn "
"the truths I have to share. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = b084186b-fb4f-dbed-23b8-1d87de9f5c21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:b084186b-fb4f-dbed-23b8-1d87de9f5c21
msgctxt "h9679fedbg0181g4776gb91dgb917af09dcd2"
msgid ""
"Moonmaiden, Selûne, hear me: Ketheric Thorm, traitor, Apostle of Myrkul, is "
"dead at last!"
msgstr "달처녀 셀루네께선 들으소서! 케서릭 쏨, 반역자이자, 머큘의 사도가 마침내 죽었으니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = b29c4dfe-84e3-0e6a-3613-5c6e5a692550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:b29c4dfe-84e3-0e6a-3613-5c6e5a692550
msgctxt "h8f565bc4g2b6cg4cedg925bgd5c7df337326"
msgid ""
"I am free from my bonds, but not my duty. The Dead Three are risen - the "
"Dead Two remain."
msgstr "나는 속박에서 해방되었지만, 의무에서 해방된 건 아니지. 삼악신이 부활했고 그 중 둘이 남아있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = b35b8256-7eb1-6771-4987-13cbe07cd026
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:b35b8256-7eb1-6771-4987-13cbe07cd026
msgctxt "h09a724b8gc913g48e7g9286ge30febf8c08e"
msgid "I am grateful for your understanding."
msgstr "당신이 이해해주니 정말 기쁘군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = b4bfc700-4117-7be9-91b2-4222ddb10316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:b4bfc700-4117-7be9-91b2-4222ddb10316
msgctxt "h24ac188ag3bf4g4013g8e79g3d747e9db5b3"
msgid ""
"I was just reviewing our fight against foul Lorroakan; your moves and mine. "
"The victory was soundly won."
msgstr "악랄한 로로아칸과의 전투를 돌이켜 보고 있던 참이네. 그대와 나의 움직임을 말이지. 승리는 확실히 우리의 것이었네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = b869f44a-b76c-589e-0d26-d445d36ac5a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - LOW_Nightsong_Event_GoToRamazithTower = True
#.     - LOW_Lorroakan_Quest_WaitingForCampNightsongDialog = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:b869f44a-b76c-589e-0d26-d445d36ac5a0
msgctxt "ha492723dgf2cfg443bga921g326459f62548"
msgid ""
"I will soar above the city and find his lair with my keen sight. Meet me "
"there when you've had your rest. We will fight together - and this magician "
"will fall."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = b86b1b4c-ce4f-4c29-b571-c59241943509
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - LOW_SorcerousSundries_Event_NSAndIsobelLeaveCamp = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:b86b1b4c-ce4f-4c29-b571-c59241943509
msgctxt "h889d1eedg3e81g4d78g991fgd699e92d0b79"
msgid "Go well, friend. The city will be saved - we will be certain of it."
msgstr "그럼 이만, 친구여. 도시는 구원 받을 것이네. 우리는 확신을 가져야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = bb48b169-b75a-848c-d70c-70d46d4b4041
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:bb48b169-b75a-848c-d70c-70d46d4b4041
msgctxt "haf9c99b5g85dfg4310g9682g58443b038993"
msgid "You must face them. I will help."
msgstr "그대는 그들과 맞서야 하네. 내가 도와주겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = bb7cac77-cb5c-699c-95eb-83447689ab11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:bb7cac77-cb5c-699c-95eb-83447689ab11
msgctxt "hfaa96b2dg774dg4b7bg99e3g59f941f7b087"
msgid ""
"We fought well - though I was a little worried about you afterward, in truth."
msgstr "우리는 잘 싸웠어. 사실, 그 후에 당신이 조금 걱정되긴 했지만 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = c0b6b867-92b9-6a44-7868-0a08ddf065aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:c0b6b867-92b9-6a44-7868-0a08ddf065aa
msgctxt "hcaf755bdgb51bg40f1gbe12g1eaf804f6b36"
msgid ""
"A mercenary, you say. Then I must find who has set a price upon my head and "
"take theirs in kind."
msgstr "용병이라. 그럼 내 머리에 값을 매긴 자를 찾아가서 그 돈을 대신 가져가야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = c19dab7d-8dd0-8c98-69ea-ca2d12b02d72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:c19dab7d-8dd0-8c98-69ea-ca2d12b02d72
msgctxt "h1ca7f826gf1eeg46edg90d1gd5060985fa7a"
msgid "Gold can buy you baubles; a prayer to the Moonmaiden buys you eternity."
msgstr "금화는 값싼 보석들이나 줄 수 있지만 달처녀께 바치는 기도는 그대에게 영생을 준다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = c4e6b081-66cb-5f87-bbc2-79d7efe1e448
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Nightsong_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:c4e6b081-66cb-5f87-bbc2-79d7efe1e448
msgctxt "ha62734d2gf66ag413fg83b8gbe427757e185"
msgid "My resplendence honours yours."
msgstr "나의 찬란함이 그대를 영광스럽게 할지니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = c518c09b-63cb-5ef9-6ca8-153958ef25c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:c518c09b-63cb-5ef9-6ca8-153958ef25c3
msgctxt "h8a8625f4gf232g4641g8643g683974864823"
msgid ""
"When Isobel died - curse the day, the hour! - we were each of us agonised. "
"But Ketheric's pain could be touched by no aid, no boundary."
msgstr ""
"이소벨이 죽었을 때, 그 저주받을 날과 시간에! 우리 모두 비통해 했네. 그러나 케서릭의 고통은 그 끝이 없어서, 어떠한 것도 그에게 "
"위안이 되지 않았다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = c592d1e3-b633-3e5b-fb59-d3709c0adfbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:c592d1e3-b633-3e5b-fb59-d3709c0adfbe
msgctxt "he1faa0fcge2c1g4bc8gacfdg6417c9a36dc3"
msgid "Feel my voice rattle your bones as I proclaim our victory."
msgstr "나의 승리 선언에 그대의 뼈가 전율하는 것을 느끼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = cb209cfd-f4fa-4612-fb1e-b62626cd9282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:cb209cfd-f4fa-4612-fb1e-b62626cd9282
msgctxt "h005fac36g338cg4be6g95d8g1f2d4c2f1b9a"
msgid ""
"A century of it, by now. I loved her from the moment I beheld her sweet "
"face, her great, wise eyes."
msgstr "한 세기 동안의 일이네. 시간이 됐군. 나는 그녀의 아름다운 얼굴, 놀랍고 현명한 눈을 본 순간부터 그녀를 사랑했다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = cb530b46-ae66-e356-929c-24556a376efe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:cb530b46-ae66-e356-929c-24556a376efe
msgctxt "h7bfbeacbgc88bg4425g9c90gf13c741bfe8a"
msgid ""
"Listen to the subtle vibrations of the Moonmaiden thumping within your heart-"
"chambers, friend. She works her magic there."
msgstr "달처녀께서 그대의 심장 안에서 박동하시는 그 미묘한 떨림에 귀 기울여보게 친구여. 그분의 마법은 그곳에 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = ccd66b87-b4a0-40de-4456-1e746c786dcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:ccd66b87-b4a0-40de-4456-1e746c786dcf
msgctxt "h7898ad05g77deg4589g9748g2487b636d06a"
msgid "Don't you think?"
msgstr "그렇게 생각하지 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = ce568fd1-decc-eb20-d5aa-4e65ad87a072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:ce568fd1-decc-eb20-d5aa-4e65ad87a072
msgctxt "h3d52ad5fgf77fg44c4g8961g9c8a36d00e6d"
msgid "We are a powerful party, indeed. Faerûn itself trembles at our touch!"
msgstr "우린 정말 강력한 동맹이네. 페이룬은 우리의 호령에 떨 것이니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = cf6a4dcc-4e26-1bfa-f3eb-1dd115266cd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_Lorroakan_State_IsPermadefeated = True
#.      - LOW_Nightsong_Event_GoToRamazithTower = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:cf6a4dcc-4e26-1bfa-f3eb-1dd115266cd7
msgctxt "hd319fdddgfb56g465ag983ag71335fa899be"
msgid "Ah. Ally mine. We are reunited once more."
msgstr "아. 나의 동료여. 우리가 다시 재회했군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = d09faa39-1387-de29-cce6-5b5525163bb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - ORI_Shadowheart_State_AskedNightsong(1) = False
#.   Global:
#.      - ORI_Shadowheart_State_EnemyOfSharPath = True
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = False
#.      - NIGHT_NightsongShadowheartVisit = False
#.      - GLO_Origin_PartOfTheTeam_Shadowheart = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#. SetFlags:
#.   Dialog:
#.     - ORI_Shadowheart_State_AskedNightsong(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:d09faa39-1387-de29-cce6-5b5525163bb3
msgctxt "hbee774abg067bg441bgaab3g68327f1dd3dc"
msgid "You seem to know things about Shadowheart. When will you tell her?"
msgstr "섀도하트에 대해 알고 있는 게 있잖아. 언제 얘기해줄 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = d1c4770e-8d8a-b960-9b5d-c0e2efb21e02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Nightsong_ConfirmedMotherSelun(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Nightsong_ConfirmedMotherSelun(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:d1c4770e-8d8a-b960-9b5d-c0e2efb21e02
msgctxt "h92166ae1g95e6g42e4g9d0dg98d4547d8a32"
msgid "Are you really Selûne's daughter?"
msgstr "정말 당신은 셀루네의 딸인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = d37a5846-1379-b08f-1e88-88b893837d02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:d37a5846-1379-b08f-1e88-88b893837d02
msgctxt "h8955ffbfg31f6g4986g8c07gf17ebf4670d1"
msgid ""
"A century of it. I have mourned her every day these hundred years. When I "
"saw Ketheric had made her live again - made her his <i>thrall </i>- lo, my "
"gorge did swell."
msgstr ""
"한 세기 동안의 일이네. 난 그 백년동안 매일 그녀를 그리워했지. 케서릭이 이소벨을 부활시켜 자기의 노예로 만들었다는 걸 알았을 땐 하, "
"내 가슴은 부풀어 올랐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = d3e7e797-fc4f-be1e-f631-f91d1c5c04e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:d3e7e797-fc4f-be1e-f631-f91d1c5c04e2
msgctxt "h2eb42b5dg2dd7g449bg918fgeb7145150b49"
msgid ""
"I've done some things I'm not proud of, but I'm proud of this. Proud of us."
msgstr "그동안 자랑스럽지 못한 일들도 좀 했었지만, 이번 일은 자랑스럽군. 우리가 자랑스러워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = d4a3c95f-848c-6022-7dc3-6cf200dd7aba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:d4a3c95f-848c-6022-7dc3-6cf200dd7aba
msgctxt "hd0def621g63e7g4af1g86e0gf9a81ef0b241"
msgid ""
"Why, she already has. She has brought her sword to your side. <i>Dame "
"Aylin.</i>"
msgstr "이미 돕고 계시지 않나. 본인의 검을 그대 곁에 직접 내리셨지. 이 <i>여기사 에일린 말일세.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = d532e694-a759-95b3-6782-a42c7865b113
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:d532e694-a759-95b3-6782-a42c7865b113
msgctxt "hcb0822b7ge569g43c4g81edg666b8163b938"
msgid ""
"Ketheric Thorm never did trust me, even when he worshipped the Moonmaiden. "
"He was threatened by my love for Isobel, by her love for me."
msgstr "케서릭 쏨은 달처녀를 섬기던 때조차 날 믿지 않았다. 놈은 이소벨에 대한 나의 사랑과, 나에 대한 그녀의 사랑에 위협을 느꼈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = d5851c73-ff84-5372-e4bd-7960fa0d8c7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:d5851c73-ff84-5372-e4bd-7960fa0d8c7a
msgctxt "h6980d684g1ad1g4dc1g9377gd39bf6cec375"
msgid ""
"<i>Actions </i>are the words of heroes. Let your deeds speak for themselves."
msgstr "<i>행동이란</i> 영웅의 언어지. 그대의 행동이 스스로 말하게 하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = dc010490-307e-2d6a-01c1-82f81b14c7ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:dc010490-307e-2d6a-01c1-82f81b14c7ce
msgctxt "habdbf2a6g2ceag417dgb42bg6aef42790843"
msgid ""
"Let him be the last. If my dear mother has any mercy, she will ensure it."
msgstr "그가 마지막이었으면 좋겠군. 나의 사랑하는 어머니께서 자비를 베푸신다면, 그렇게 해주실 것이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = e2cd755e-5753-34f3-516f-90c2f77cc716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:e2cd755e-5753-34f3-516f-90c2f77cc716
msgctxt "h5c985edagce8ag4cd0gba0eg83041903f3b2"
msgid ""
"But fear not: When the time comes for you to face the foe of foes, Dame "
"Aylin will stand at your side."
msgstr "하지만 두려워하지 말게, 적들과 맞서 싸워야 할 때가 오면, 여기사 에일린은 그대의 옆에 있을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = e7e6c14b-21e3-389b-8f97-1456fdaa8969
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:e7e6c14b-21e3-389b-8f97-1456fdaa8969
msgctxt "hd08540d8g4f7ag49f9g97d6g93e733f1c2fc"
msgid "<i>Step closer.</i>"
msgstr "<i>가까이 다가선다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = ea0e9a6d-62e8-9af6-4fad-bbede4f865aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:ea0e9a6d-62e8-9af6-4fad-bbede4f865aa
msgctxt "h454da18eg8077g4ba9ga0d7gb49fd8d08f87"
msgid "I have questions for you, Dame Aylin."
msgstr "여기사 에일린, 당신한테 질문이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = eae8fc28-ea86-35a8-b87a-f34792c94499
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_IsDead = False
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:eae8fc28-ea86-35a8-b87a-f34792c94499
msgctxt "hfcd068c4gc94cg4cf9g96b8g0a9b08bfc1d5"
msgid ""
"My mate most high, darling Isobel, is safe and well. Safe and well and "
"returned to my embrace."
msgstr "제 가장 고귀하고 사랑하는 연인, 이소벨이 안전하고 안녕히 제 품으로 돌아왔나이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Player
#. NodeID = ef099387-f0c6-af04-0057-f69f0e8dcdd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:ef099387-f0c6-af04-0057-f69f0e8dcdd4
msgctxt "hd5c219c9g480dg4da7g893ege2a348037efd"
msgid "There's still a great deal about you I don't know."
msgstr "당신에 대해 아직 모르는 것들이 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = f497bbe5-9a70-fad4-9f33-f51a54c921e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:f497bbe5-9a70-fad4-9f33-f51a54c921e3
msgctxt "hda60687ag0a71g45cagb922g77148b6d49ef"
msgid ""
"Enjoy the spoils of your victory. Spin memories of our prowess in your mind "
"like silkfloss."
msgstr "승리의 전리품을 즐기게. 우리의 활약상을 실타래처럼 머릿속에서 되뇌이게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = fc34bfe3-d345-d9a1-8178-121e725d849a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:fc34bfe3-d345-d9a1-8178-121e725d849a
msgctxt "h85fe18beg1d9dg444dg8323g2131f83086ff"
msgid ""
"Her father Ketheric never did trust me. He did not fancy an immortal for his "
"daughter's paramour."
msgstr "그녀의 아버지 케서릭은 절대 나를 믿지 않았지. 그 녀석은 딸의 연인이 불멸자인걸 원하지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong
#. Speaker = Nightsong
#. NodeID = fe83c704-a709-069e-da28-78d938ded256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/CAMP_Nightsong:fe83c704-a709-069e-da28-78d938ded256
msgctxt "hc3bc51a5gf4b8g4ebdgb967g7b1d6b0571be"
msgid "There can be no doubt: I am of her silvered flesh, her celestial womb."
msgstr "의심의 여지가 있을 수 없네. 나는 그분의 은빛 육신과 천상의 품에서 태어났다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_NightsongShadowheartVisit_PAD_NotShadowheart
