msgctxt "hbcc3e31dg711cg498cgbff9g659cf2ba3fad"
msgid "I'm sure I'll have a good time."
msgstr "좋은 시간이 될 거라 확신해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Player
#. NodeID = a0670b46-5721-e96d-9210-dd105c5b3218
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DoubleDating(1) = True
#.      - ORI_State_DatingAstarion(1) = True
