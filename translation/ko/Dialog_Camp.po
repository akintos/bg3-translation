msgctxt "hd01fe8dfgf6efg4072gbc09g4fc8ed40f7f2"
msgid "<i>Pet him.</i>"
msgstr "<i>쓰다듬어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2
#. Speaker = Owlbear Cub
#. NodeID = e21f2db7-8388-0965-d6f2-386b2c4aee24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_OwlbearCub_CRD_2:e21f2db7-8388-0965-d6f2-386b2c4aee24
msgctxt "h061de27ag6d03g4bf0gbb52gd6775686ec38"
msgid "Too big... Wait!"
msgstr "정말 컸어... 잠깐!"

