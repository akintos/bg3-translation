msgctxt "hc76c9681g4b0dg4cadgba5dg93ae32366555"
msgid "So, I see you and the drow have been making eyes at each other."
msgstr "그런데, 너와 그 드로우가 서로 눈빛을 주고받는 걸 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntRaiderCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = 34e86f25-87cc-3dd8-d44e-f9272639a1bd
