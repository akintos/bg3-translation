#. CheckFlags:
#.   Local:
#.      - 4fa781b1-5bf3-5873-4331-f56c0efa6476_B = True
#. SetFlags:
#.   Local:
#.     - 4fa781b1-5bf3-5873-4331-f56c0efa6476_C = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef:c24e1aa9-61d5-6896-ec98-8ce86d449b70
msgctxt "ha3175edcg3f43g42b6gb916gf27ebda87a47"
msgid "Agh! Spilled my pint."
msgstr "으아! 내 술 쏟아버렸네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_SonOfChef
#. Speaker = Guex
#. NodeID = c68a91c0-0912-8523-e9b4-881c05ef0e3b
