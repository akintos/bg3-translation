msgctxt "hfbd99763g8b4ag48c7g9bc7g86bc4fae972e"
msgid "<i>Accept his gift.</i>"
msgstr "<i>선물을 받는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Narrator
#. NodeID = a5cf4cac-5916-f857-be5f-a30c1641f17b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:a5cf4cac-5916-f857-be5f-a30c1641f17b
msgctxt "hb181bfd5ge21dg4631ga406g4a2bcc69e46b"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Goblin Brawler
#. NodeID = c4ebb850-29f1-7b91-6567-5c911b71f63c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHuntCelebration_Event_TransferHeart(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001:c4ebb850-29f1-7b91-6567-5c911b71f63c
msgctxt "h33d0fad0g741fg44e1g888ag0d0a7798fdf9"
msgid ""
"Didn't mean to hold out on you, ma'am. Just didn't think you'd be "
"interested, is all."
msgstr "숨기려고 한 것이 아닙니다, 마님. 다만 관심이 없으실 것 같아서 그랬습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/CAMP_GoblinHuntCelebration_Goblin001
#. Speaker = Goblin Brawler
#. NodeID = c4ebb850-29f1-7b91-6567-5c911b71f63c
