#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - CAMP_Jergal_Event_ResurrectedSomeoneOnce = True
#.     - CAMP_Jergal_Event_WillResurrect_DismissedAvatar1 = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2c86ce25-949e-3c0a-1d3b-7b6d7bf8a586
msgctxt "h19799e39g1806g4ebag8a80gd1fec818b565"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 2d863a9a-e984-b8e9-ab74-14ff333b36b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2d863a9a-e984-b8e9-ab74-14ff333b36b3
msgctxt "h86174970gbddcg4f55gb62cg4281492d942e"
msgid ""
"Death alone was not suffering enough for thine Urge. Thou shouldst fear "
"thyself."
msgstr "죽음도 그대의 충동에는 충분한 고통이 아니었구나. 그대는 자기 자신을 두려워 해야 할지니."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 2e46ca39-ff71-c9c5-7ee8-9e696dc00ea4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Hirelings_Dialog_ShowHireling_2(1) = True
#. SetFlags:
#.   Object:
#.     - Hirelings_Event_DismissHireling_2(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2e46ca39-ff71-c9c5-7ee8-9e696dc00ea4
msgctxt "h0c9f734fg4a2dg4051g835dg493d3746b1d8"
msgid ""
"I would like to dismiss "
"[HirelingName_2_c4187b58-a2f9-61d1-9899-e456945876fd]."
msgstr "[HirelingName_2_c4187b58-a2f9-61d1-9899-e456945876fd]을 내보내고 싶습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 2f235380-54c5-09e8-0558-880943fbd80a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingGale(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2f235380-54c5-09e8-0558-880943fbd80a
msgctxt "hb2a7411cg1c04g4cf9ga844gac51972d000a"
msgid "It was just a moment in the Weave, 'bosoms' haven't been involved yet!"
msgstr "그냥 잠시 위브에서 시간 좀 보낸 거예요, '육체적인 쾌락'은 아직 시작하지도 않았다구요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 2fc4e178-849e-de12-6b75-567b6d05e125
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2fc4e178-849e-de12-6b75-567b6d05e125
msgctxt "hd1860b99ga250g4f0cg934fg281dfda2a3db"
msgid "If you won't answer, then get out of my camp."
msgstr "대답해 줄 생각 없으면, 내 야영지에서 나가."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 2fea384a-563d-00c3-1815-7ea668032f65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.      - GEN_MaxPlayerCountReached = True
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:2fea384a-563d-00c3-1815-7ea668032f65
msgctxt "h3f9cd9d3gd99bg47dag8c9bga25082e5d0bb"
msgid ""
"The fallen will rise when they are summoned. But thou must first make space "
"for them amongst the living."
msgstr "그대가 소환하면 쓰러진 자들이 일어나리라. 그러나 그 전에 산 자들 사이에 빈 자리를 만들거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 31bcd2c1-238b-c502-e6a7-bb5c183639c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - Hirelings_State_ShowIntro = False
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:31bcd2c1-238b-c502-e6a7-bb5c183639c7
msgctxt "h6cfc777cga00fg4f33gb7b8gc1600c8642ec"
msgid ""
"Beyond mortal realms, there doth exist an amalgamation of spirits akin to "
"thine own, ensnared by the treacherous cult of the Absolute, felled in its "
"name."
msgstr ""
"필멸의 세상 너머, 그대와 비슷한 영혼들의 집합체가 존재하노라. 절대자의 교단의 마수에 걸려 들어, 그 이름 아래 쓰러진 자들이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 333620c2-e35c-8e33-503a-24b5b0aaec7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:333620c2-e35c-8e33-503a-24b5b0aaec7b
msgctxt "h7fb0a826gfe0eg4258g9932g3b33130af7d1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 339b48ec-1f3e-3662-17df-a9088956c3b7
