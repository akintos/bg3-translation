#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:abaa76c0-2528-4520-b92f-550e23677c88
msgctxt "hb2e01b93g942dg469fg9f3bgdc1e1ebd8f0d"
msgid ""
"I'd love nothing more, but I'm afraid I can't touch anyone until my engine "
"is fixed."
msgstr "더 이상 바랄 게 없지만, 내 엔진이 수리될 때까지는 아무도 만질 수 없을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = ace84b01-68e6-45f2-984c-d54940d13427
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_LaezelRefused(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:ace84b01-68e6-45f2-984c-d54940d13427
msgctxt "heb74a37aga5cag41a6g9379gd97d37bdf579"
msgid ""
"A loathsome hurdle. Watching you burn lit a fire in me I could not quench "
"alone."
msgstr "지긋지긋한 걸림돌이야. 네가 타는 모습을 보면서 내 안에 붙을 지폈고 혼자서는 그 불을 끌 수가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = ad127ad4-dc27-54e9-4f50-cbc5a15c0b89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = False
#.      - Approval_AtLeast_20_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:ad127ad4-dc27-54e9-4f50-cbc5a15c0b89
msgctxt "h4acf0bf7g4eabg405bg8fa3g1b038ef8b147"
msgid "I smell their blood on you still. I smell your sweat."
msgstr "아직 네게서 그들의 피 냄새가 난다. 네 땀 냄새도 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = afae6c64-0a9a-a53a-62ed-62bd05ce2d5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_LaezelRefused(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:afae6c64-0a9a-a53a-62ed-62bd05ce2d5c
msgctxt "h8231483eg6230g4344g9319gc98835686776"
msgid ""
"Go on, have your fun. And do not wipe away a single bead of sweat. It's "
"<i>intoxicating.</i>"
msgstr "계속 해, 즐겨. 그리고 단 한 방울의 땀도 닦지 마. 그건 <i>취하게</i> 하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Player
#. NodeID = b62735a8-1c6a-372d-91e1-36b6819a2961
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:b62735a8-1c6a-372d-91e1-36b6819a2961
msgctxt "h13130a5fg1385g46eag9f21gc65fe7f4fc27"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = b643f5f8-cf3d-e860-1a11-b3b727f8a124
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_LaezelRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:b643f5f8-cf3d-e860-1a11-b3b727f8a124
msgctxt "h2224543cg7742g4f09gbfc2g03ea4a01d42d"
msgid "A pity for us both you've turned your back on me so often."
msgstr "네가 날 너무 많이 실망시켰다는 점이 유감스럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Player
#. NodeID = bb8c613f-982c-f746-3473-7212cd268c5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:bb8c613f-982c-f746-3473-7212cd268c5f
msgctxt "h0114f6a2g4a8dg43ccg85f3g5948f2be8cf1"
msgid "Be as snide as you want. I'm not interested in you like that."
msgstr "마음대로 헐뜯어. 난 네게 별 관심 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = bee8cf1e-dfe0-a25e-62f0-74c568ec6a97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:bee8cf1e-dfe0-a25e-62f0-74c568ec6a97
msgctxt "h4040834bgab76g41beg88a2g1a3250d27e30"
msgid "Mm - if only I might lay claim to my proper trophy."
msgstr "음, 제대로 된 전리품을 차지할 수만 있으면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = c0197b55-d078-b3dd-ffb4-dbb3ab6632fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:c0197b55-d078-b3dd-ffb4-dbb3ab6632fc
msgctxt "h51081ed5g3e96g4305ga292gbb9226e5cb14"
msgid "One day, fortune may favour you."
msgstr "언젠가는, 행운이 네 편을 들어줄지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Player
#. NodeID = c349783d-e6fd-62d8-e09a-0cafb3946a97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:c349783d-e6fd-62d8-e09a-0cafb3946a97
msgctxt "h73cc6da0g2bd9g4949gb874gf14a7184a7e0"
msgid "Are you... asking for sex?"
msgstr "지금... 나랑 섹스하자는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = c89187e6-c579-d913-5726-927864d77128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:c89187e6-c579-d913-5726-927864d77128
msgctxt "h8a11a028gb357g4a16gb832ge6c91f9961da"
msgid "If only you'd earned the right to lay at my side."
msgstr "네가 내 침대 옆자리에 누울 자격이 없다는 점이 아쉽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = c8d78b2f-e862-8a6b-df75-d8a93d9f71b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:c8d78b2f-e862-8a6b-df75-d8a93d9f71b4
msgctxt "he3e00d1ag8a7cg4199g9cf8g4aa47c3a56a2"
msgid "I mean to taste it."
msgstr "그걸 맛보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = d4139632-cf3a-94f2-1631-da61d69c8115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:d4139632-cf3a-94f2-1631-da61d69c8115
msgctxt "h57756849gc36bg4987gbee0g53f4bd3970f9"
msgid "When you lie down for the night, I will come."
msgstr "오늘 밤 잠자리에 들면, 내가 찾아오겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Player
#. NodeID = d449ff07-55b4-0a82-0eaf-fe73765578d5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:d449ff07-55b4-0a82-0eaf-fe73765578d5
msgctxt "h5a8aa877g26a8g4355gaeefg5733d695fc4b"
msgid "I can hardly believe my own words, but - perhaps another night?"
msgstr "내 말을 믿을 수 없지만, 어쩌면 다음 밤이 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Player
#. NodeID = d449ff07-55b4-0a82-0eaf-fe73765578d5
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:d449ff07-55b4-0a82-0eaf-fe73765578d5
msgctxt "h5e6b61ceg1725g4368g9604g0b3aad180764"
msgid "Perhaps we could get to know each other another time."
msgstr "다음에 서로를 알아가면 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = d46415cd-6e86-7aa4-7065-bab6c5e5b084
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:d46415cd-6e86-7aa4-7065-bab6c5e5b084
msgctxt "h87847596gd472g4dc1g9aa2gaa75a8476ad0"
msgid "There are, after all, other spreads before me."
msgstr "결국 내겐 다른 선택지도 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = d7ba7961-6cb3-66b2-6b83-969925b2b86f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:d7ba7961-6cb3-66b2-6b83-969925b2b86f
msgctxt "hb32b7dc7g28ffg41c1ga521g2dd835e5eae8"
msgid "I will have to seek relief elsewhere."
msgstr "다른 곳에서 도움을 구해야 할 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Player
#. NodeID = d7bfd210-5471-b9c6-fa15-307ac4742333
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:d7bfd210-5471-b9c6-fa15-307ac4742333
msgctxt "hcc75f581g1be4g4743gb2a8g989950f3b730"
msgid "I am grateful for your aid. You are a gifted warrior."
msgstr "네 도움에 감사해. 넌 타고난 전사야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = dd14a6b2-c6d7-6254-36e7-bea1820da3f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:dd14a6b2-c6d7-6254-36e7-bea1820da3f8
msgctxt "ha21470c1g36abg4b64gabe6gd3f4e84f9abb"
msgid "Oh, but do enjoy yourself this night. I intend to, myself."
msgstr "하지만 오늘 밤은 즐기도록 해. 나도 그렇게 할 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = e0deb181-6a06-8b19-5293-b4a601c11ef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:e0deb181-6a06-8b19-5293-b4a601c11ef0
msgctxt "h44331b0fgcba5g42a3g86a4g1a557c458a77"
msgid ""
"Yet they could not match your nerve today. It was enough to drive me to "
"madness."
msgstr "하지만 그들도 오늘 네가 보여준 용맹함에 비할 바는 되지 못한다. 그것은 나를 광기에 이르게 할 만큼 충분했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = e731159a-d8b8-25a5-4cdb-248fcad6f3b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:e731159a-d8b8-25a5-4cdb-248fcad6f3b2
msgctxt "h6ae892afgd77ag49dbg8a74g08bdc064af94"
msgid ""
"You will wonder how my lips might have tasted, how my fingers on your skin "
"might have felt."
msgstr "내 입술의 맛이 어땠을지, 네 피부에 닿는 내 손가락의 느낌이 어땠을지 궁금할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = e8a27c13-f3d3-dbf3-a78a-52a810ab2c2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ASTARIONCOMPANION = True
#.   Object:
#.      - CAMP_GoblinHunt_State_ShadowheartPartner(1) = True
#. SetFlags:
#.   Object:
#.     - CAMP_Celebration_LaezelChoseAstarion(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:e8a27c13-f3d3-dbf3-a78a-52a810ab2c2e
msgctxt "hd2f54c0egee0bg479ag8a2ag55679d3b05b7"
msgid ""
"I will take pleasure when I wish, and from whom I wish. Astarion looks "
"particularly tempting tonight."
msgstr "난 내가 원할 때, 원하는 이와 즐길 것이다. 오늘 밤은 아스타리온이 특히 매력적으로 보이는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = ee2d78b9-103e-51ba-300c-665639b2cea6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_WyllPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:ee2d78b9-103e-51ba-300c-665639b2cea6
msgctxt "h79f7df6fge944g45e9gb7d9g32b1b1ce2e78"
msgid "A pity for us you have promised your body to the Blade."
msgstr "그 칼날에게 너의 몸을 약속했다니, 참 유감이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = f3dee24b-e5f0-a827-5114-1db2c90aebaf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_LaezelRefused(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:f3dee24b-e5f0-a827-5114-1db2c90aebaf
msgctxt "h28cd2e3eg00c6g40c6g9b51gaf9fca8fef5e"
msgid "How torturous for us both that I'll never get a taste."
msgstr "내가 결코 맛볼 수 없다는 것이 우리 둘 다에게 얼마나 고통스러운지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = fc887067-99cf-be33-2b2d-ecaea7ed4b35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:fc887067-99cf-be33-2b2d-ecaea7ed4b35
msgctxt "h9a4e8d57g3f8fg46b3gbf9agb76d3ffdf696"
msgid "Perhaps not."
msgstr "못할 수도 있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel
#. Speaker = Lae'zel
#. NodeID = ff6a260e-da41-9ba1-4ee4-32ce43e4e0cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Laezel:ff6a260e-da41-9ba1-4ee4-32ce43e4e0cc
msgctxt "h2b2ecb24g2df1g421bg9354g9323526789dc"
msgid "You know the fortune of my company."
msgstr "내 동료의 운명을 알고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 01420046-02ec-69c3-4119-48fe153283a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_HasMet_Gale(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:01420046-02ec-69c3-4119-48fe153283a6
msgctxt "h8bdbe62agb2e0g49a3gaca1g6eb1ecdb51eb"
msgid "Enjoy the night. It seems to me full of opportunities."
msgstr "밤을 즐겨. 기회가 가득한 것 같으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 039ee116-6ba2-b494-ce6b-a5e2f5dd2d48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:039ee116-6ba2-b494-ce6b-a5e2f5dd2d48
msgctxt "hf2e09efcge49ag4378ga1feg296fec26c833"
msgid ""
"Jealousy is in the eye of the beholder. Or something along those lines, the "
"wine might be befuddling me a smidge."
msgstr "질투란 보는 이의 눈에 달린 거라고 하지. 그와 비슷한 걸지도 모르고, 포도주를 좀 마셨더니 취한 걸지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 04a818a2-3703-340c-05d4-638c8cf5a8cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:04a818a2-3703-340c-05d4-638c8cf5a8cb
msgctxt "hafbe086eg3a7fg4b51gabe2g14d137d1a7ee"
msgid "I wasn't sure we'd have a chance to make merry, just the two of us."
msgstr "우리가 이렇게 즐거운 시간을 보낼 기회가 있을 줄은 몰랐어, 우리 둘이서만 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 051bc382-5961-2977-9d35-201aa2c09e36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:051bc382-5961-2977-9d35-201aa2c09e36
msgctxt "h603e8048g275bg486egbfcbg7ae75528e4be"
msgid "Indeed?"
msgstr "정말?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 06089ae7-fc31-949b-e879-38cdc90f8c27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:06089ae7-fc31-949b-e879-38cdc90f8c27
msgctxt "hbd19f3e9ga698g421dgb6dag98c086dcf312"
msgid ""
"The art of the body. The exploration and acceptance of the self and the "
"other. The art of the night itself."
msgstr "그리고 육체의 예술도 있어. 스스로와 타인에 대한 탐구와 수용. 밤이 선사하는 예술 그 자체 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 07c58012-9469-37a4-db14-b66b1247387f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:07c58012-9469-37a4-db14-b66b1247387f
msgctxt "h3c3a6f9fge5c6g436eg841cg3db73b9c9522"
msgid "That's usually followed by: in water there is good sense."
msgstr "그 말 뒤에 따라오는 말이 있지: 물에는 제정신이 박혀있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 0aff4d36-6966-5f8e-75d9-605527a8b8bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = False
#. SetFlags:
#.   Global:
#.     - ORIG_Gale_ToStoryScene_Romance = True
#.   Object:
#.     - CAMP_GoblinHunt_State_HasPartner(1) = True
#.     - CAMP_GoblinHunt_State_GalePartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:0aff4d36-6966-5f8e-75d9-605527a8b8bd
msgctxt "h5cc7af70gb8f5g45b0g961egbd1380ab338a"
msgid ""
"We'll let the night run its course. And when everything is quieting down, "
"safe in the arms of sleep, I'll come by to find safety in yours."
msgstr "밤은 흘러가는 대로 놔두자. 모든 것이 조용해지고 잠에 들 시간이 되면, 내가 네 곁으로 올게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 0e72961b-1046-c9f5-c14f-43733e00e740
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_HasMagicItem = True
#.   Object:
#.      - ORI_Gale_State_GaveGaleMagicItem(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:0e72961b-1046-c9f5-c14f-43733e00e740
msgctxt "h50996b3fg57e7g46d4g8dafge7673de458f7"
msgid "You've given me powerful magic to consume when I needed it most."
msgstr "넌 내가 가장 필요로 할 때 내게 강력한 마법을 섭취하게 해줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 0f8941fb-1e53-8958-6df3-9d8cc92ea607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:0f8941fb-1e53-8958-6df3-9d8cc92ea607
msgctxt "h5aad2cc6gb81fg4455g8825g07f7386f6da5"
msgid "You're right. I'd like to spend the night with you."
msgstr "네가 맞아. 오늘 밤은 너와 함께 보내고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 11072d61-99c7-f9fe-4f97-72e5484f31d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_GaleRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:11072d61-99c7-f9fe-4f97-72e5484f31d2
msgctxt "h96206608g2132g4abag836cg4f8598f388f2"
msgid "It would..."
msgstr "그렇겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 18982f38-96e8-8e9d-abdc-837e3cc13c67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:18982f38-96e8-8e9d-abdc-837e3cc13c67
msgctxt "h952ef47eg6601g4f5ega41dgb919c24d89b0"
msgid "And yet you question them nonetheless."
msgstr "그렇게 말하면서 이미 의심했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 19251c7c-fa75-457b-707c-3c7458af4c01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:19251c7c-fa75-457b-707c-3c7458af4c01
msgctxt "h60e3396eg6ae7g40f3gaabcg7361216f2c19"
msgid "Then we'll start writing the prequel."
msgstr "그럼 우리가 함께 속편을 쓰자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 1c4c74f3-4b69-576c-4271-03697fbe3228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:1c4c74f3-4b69-576c-4271-03697fbe3228
msgctxt "h31303f7agdb05g4448gb1d9g3be8850aefc8"
msgid "That or deadly nightshade."
msgstr "아니면 치명적인 벨라도나일지도 모르지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 20a386df-b64d-b22f-8b13-c7c1a0eb4d23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_CRD_Loss_RomanticMoment = False
#.   Object:
#.      - ORI_State_DatingGale(1) = False
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:20a386df-b64d-b22f-8b13-c7c1a0eb4d23
msgctxt "h346b4f5agbf92g4820g945ege67375be51be"
msgid ""
"I'm sorry, but surely we're friends, allies, the best of companions, but... "
"no more than that."
msgstr "미안해, 우리는 분명 친구이자, 아군이고, 최고의 동료지만... 그 이상은 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 21b5c766-5b94-3d31-dff9-5eb3575e571e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:21b5c766-5b94-3d31-dff9-5eb3575e571e
msgctxt "h87d73e5cg1a77g4c88g8dc3gd05261287b7c"
msgid "Too bad. One should never be afraid to live life to the fullest."
msgstr "안타깝네. 아무도 자신의 삶을 즐기는 걸 두려워해선 안되는데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 26d4bd35-3cfc-e9ba-b55a-a11294b35a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:26d4bd35-3cfc-e9ba-b55a-a11294b35a4f
msgctxt "h9b4c81f1g60f0g4e08g85e7ge9b2b3704047"
msgid "What for?"
msgstr "무슨 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 28ae7198-1110-c7ec-94ee-7eb1e946058e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_ShadowheartPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:28ae7198-1110-c7ec-94ee-7eb1e946058e
msgctxt "h71134a9fg9b63g4368g94cagddbc2bcf1f0b"
msgid ""
"Actually, I may just want to spend the night with you instead of Shadowheart."
msgstr "사실은, 섀도하트가 아니라 너와 함께 밤을 보내고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 2ab953d2-169b-6704-3372-9ad2b6169790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:2ab953d2-169b-6704-3372-9ad2b6169790
msgctxt "h92b3c96eg7e9bg4d7bgb3e5g6a7794616c68"
msgid "Or perhaps more than you bargained for - full stop."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 2bcebcf1-620b-6077-0f80-38d06c654d65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:2bcebcf1-620b-6077-0f80-38d06c654d65
msgctxt "hd12ae151g628fg4f44g8baage1aedd01a71e"
msgid "I've waited long enough, haven't I?"
msgstr "이 정도면 충분히 오래 기다리지 않았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 2c001e45-a3dd-19e6-709d-ccc2f49b13d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:2c001e45-a3dd-19e6-709d-ccc2f49b13d3
msgctxt "h3331caa7g353cg4f5fga134g3996780530c2"
msgid "Tonight seems perfectly suited for such endeavours."
msgstr "오늘 밤이 그런 여정을 위해 딱 맞은 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 2cd69afc-b663-8205-e536-1629b222e73e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:2cd69afc-b663-8205-e536-1629b222e73e
msgctxt "hb3869d3fgfacbg4aa1g9834g094ce36976e0"
msgid ""
"Actually, I may just want to spend the night with you instead of Astarion."
msgstr "사실, 아스타리온이 아니라 너와 함께 밤을 보내고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 30aa3aac-f251-4329-6d6c-29a1811b8e4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - ORI_COM_Gale_Letter.GaleDied(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:30aa3aac-f251-4329-6d6c-29a1811b8e4b
msgctxt "he0d06c20g90ddg489cg91d1g10e43642475e"
msgid "You've brought me back from the grey shores of death."
msgstr "네가 날 삶과 죽음의 경계에서 날 끌어내줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 30cfa90f-f5be-d408-7004-3a141fee0ead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:30cfa90f-f5be-d408-7004-3a141fee0ead
msgctxt "hc955f29fgb699g462dgb5f6gb031d9687a78"
msgid "Come now! This is a night for celebration, not suspicion."
msgstr "자자! 오늘은 축하의 밤이야, 의심이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 30ea78eb-2485-04a0-9daa-e67d0770e3d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:30ea78eb-2485-04a0-9daa-e67d0770e3d2
msgctxt "hc9dfcbeeg48f2g45cagbf1eg861c5dc6feb9"
msgid ""
"Actually, I may just want to spend the night with you instead of Lae'zel."
msgstr "사실, 레이젤이 아니라 너와 함께 밤을 보내고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 326f68c6-6c16-9e87-f662-480179e5fbd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_WyllPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:326f68c6-6c16-9e87-f662-480179e5fbd2
msgctxt "h6849ea79ge0dag455fg9413g237084abc844"
msgid "Actually, I may just want to spend the night with you instead of Wyll."
msgstr "사실, 윌이 아니라 너와 함께 밤을 보내고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 34547220-f84b-1cf2-b4c7-8bafc1bc1477
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:34547220-f84b-1cf2-b4c7-8bafc1bc1477
msgctxt "h397a452eg5bb5g4238ga5d8g0cb12a96c8e8"
msgid "I can only hope my tale will live up to your expectations."
msgstr "내 이야기가 네 기대에 부응할 수 있었으면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 378d0f3b-1926-baa4-70bf-76244472f661
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:378d0f3b-1926-baa4-70bf-76244472f661
msgctxt "hcd0c4c82g5f7dg4803ga39fg6e9f14270886"
msgid "There's that confidence I like."
msgstr "네 그 자신감이 참 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 3920d93c-706d-c4be-6dd1-68f805f33e65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_CRD_Loss_RomanticMoment = False
#.   Object:
#.      - ORI_State_DatingGale(1) = False
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:3920d93c-706d-c4be-6dd1-68f805f33e65
msgctxt "hed59fd76g759bg4d68g9582g7f16956a4d29"
msgid ""
"Merely to share a glass of wine I suppose; to toast to victory and to offer "
"you an invitation."
msgstr "그저 포도주 한 잔을 나누며 승리를 위해 건배하기 위해 널 초대하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 3a49717d-6133-a468-8d6d-a127869f6f0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:3a49717d-6133-a468-8d6d-a127869f6f0c
msgctxt "h886f8fb6g3c78g42e2gaab9g8f24b11a1569"
msgid "No, I was glad you sought me out for an entirely different reason:"
msgstr "아니, 네가 전혀 다른 이유로 날 찾아줘서 기뻐:"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 3a8cc12f-a7a3-213a-e7cc-1f5ebd8e4414
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:3a8cc12f-a7a3-213a-e7cc-1f5ebd8e4414
msgctxt "h1d9d15bcgb407g4295ga16fgbe21ace6ec97"
msgid "You're remarkably upfront about your intentions."
msgstr "넌 아주 놀랍도록 직설적이구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 3a98f61b-3e45-49ca-cbf4-36541f42d0ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:3a98f61b-3e45-49ca-cbf4-36541f42d0ee
msgctxt "h6c08413dg05a6g454eg9361gc3e8e0d8b6f6"
msgid ""
"Then again he's so full of himself it's a small miracle he hasn't resorted "
"to self-cannibalism yet."
msgstr "그렇지만 그는 자기애가 너무 충만해서, 자기 자신을 먹지 않은 것이 약간의 기적일 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 3c9eeaab-ee34-b786-b230-b588b5b858c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:3c9eeaab-ee34-b786-b230-b588b5b858c2
msgctxt "h2e4c5b5dg7091g4919g837ag9f513ded5731"
msgid ""
"More's the pity you've already found someone else to make merry with, just "
"the two of you."
msgstr "불행한 건 네가 이미 다른 사람을 찾아서, 단둘이 즐거운 시간을 보낼 것이라는 사실이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 45e30def-e55e-e33a-f0d9-75dae369621b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_GaleRefused(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:45e30def-e55e-e33a-f0d9-75dae369621b
msgctxt "h52cdad0ag57b7g4dd8g98e9g58cac658f8f4"
msgid "I'm afraid I have to decline."
msgstr "미안하지만, 거절해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 48b164e7-a759-2931-66d9-9acedcf8882d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:48b164e7-a759-2931-66d9-9acedcf8882d
msgctxt "h5d460b3cgdcbbg4357g8e00g4bf762fec341"
msgid "What makes you think I still care?"
msgstr "왜 내가 아직도 신경 쓴다고 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 4ecddf1d-ad08-05fd-c9c1-76e9b3b96894
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:4ecddf1d-ad08-05fd-c9c1-76e9b3b96894
msgctxt "h89898879g6732g45fegae3cgf2bc65a25d4e"
msgid "I say we take a page from their book."
msgstr "그 책을 우리가 실행에 옮겨 보는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 4feafad1-9ed0-3199-ff57-9797089ce8a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_CRD_Loss_ToldLostMystra = False
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:4feafad1-9ed0-3199-ff57-9797089ce8a8
msgctxt "hfeb4ef1agda95g47fega4bcgb98628f244ec"
msgid ""
"You know of my condition and its challenges, but those are but the broad "
"strokes."
msgstr "넌 내 상태와 어려움에 대해 알고 있지만, 그건 희미한 테두리에 불과해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 5326552b-8504-f232-d7f7-2ff6a755055a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:5326552b-8504-f232-d7f7-2ff6a755055a
msgctxt "he55ffb37gfa83g406cgae9agbb79d3b0ccfb"
msgid "Curiosity is a trait we all share."
msgstr "호기심은 우리 모두가 공유하는 특성이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 5d296610-b65e-f932-6f13-4d692b62db71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:5d296610-b65e-f932-6f13-4d692b62db71
msgctxt "h46377955gde5fg4065gb2c7g031e2fdea0fc"
msgid "Good sense will have to wait 'til the morrow."
msgstr "제정신은 내일까지 기다려야 돌아오겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 5d7300f3-533e-db0a-1a6f-1acb364cef60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:5d7300f3-533e-db0a-1a6f-1acb364cef60
msgctxt "h44825ee8gfc63g4f81g9266g24fe56c733b0"
msgid ""
"I know there are many things about me that remain shrouded in mystery. "
"You've been very patient with me, and I appreciate that."
msgstr "내가 수수께끼에 싸인 점이 많다는 사실은 나도 알고 있어. 넌 인내심을 가지고 기다려 줬고, 그건 정말 고맙게 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 6073178a-06fb-3dd3-8d33-a7dd5864650d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_HasMet_Gale(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:6073178a-06fb-3dd3-8d33-a7dd5864650d
msgctxt "hb30ee084g5640g4e3dg82b6gbf8e3606deb4"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 607c8cca-cbc4-aa99-0542-820448c55c85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_State_HasMagicItem = True
#.   Object:
#.      - ORI_Gale_State_GaveGaleMagicItem(1) = False
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:607c8cca-cbc4-aa99-0542-820448c55c85
msgctxt "he1f38580g50b8g437cgabd2gcd67d3869a11"
msgid "I was given powerful magic to consume when I needed it most."
msgstr "나에게는 내가 가장 필요로 할 때 섭취할 수 있는 강력한 마법이 주어졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 65f74eda-9b2e-ae93-b4a2-4ac531c36978
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:65f74eda-9b2e-ae93-b4a2-4ac531c36978
msgctxt "hbf9f421cg2796g459fg84efg2ef1dc8250cf"
msgid "Allow me to make the following proposition:"
msgstr "다음과 같은 제안을 하고자 해:"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 66acf9d5-d941-31a0-9a4f-26dca4dc8cd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:66acf9d5-d941-31a0-9a4f-26dca4dc8cd2
msgctxt "h109a1b01g7146g4844gb4d9g31ea21f7337d"
msgid ""
"He has a certain charm about him, Astarion. Then again, so does a tiger when "
"it purrs."
msgstr "아스타리온, 그에겐 꽤 매력적인 구석이 있어. 하지만, 호랑이도 애교를 부릴 땐 매력적이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 6a0c16b9-2bb3-a24c-da83-4e4832f41e2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:6a0c16b9-2bb3-a24c-da83-4e4832f41e2f
msgctxt "hd3c75631g9803g4136g9713gd8eec2321e49"
msgid "Caught on to that, did you? Might be the wine talking."
msgstr "내가 그렇게 말했나? 술김에 그런 말을 했나봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 6ef95ad8-0309-d790-1fad-1da0fdb89803
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:6ef95ad8-0309-d790-1fad-1da0fdb89803
msgctxt "h40e4bc11g5407g479fg8c14ge2b1163a5c6f"
msgid "As they say in Waterdeep: in wine there is truth."
msgstr "워터딥에는 이런 격언이 있어: 포도주에는 진실이 담겨 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 6fa78c17-85ce-5c31-30b9-f13921f781ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:6fa78c17-85ce-5c31-30b9-f13921f781ab
msgctxt "hb85b42d1gb327g4adcgbce6g1136e1523e3e"
msgid "Actually I think I'll go mix and mingle."
msgstr "사실 나는 사람들과 섞여서 어울려야 할 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 6fc6682c-15b3-4a04-a5ce-3278b1032f1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_CRD_Loss_ToldLostMystra = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:6fc6682c-15b3-4a04-a5ce-3278b1032f1c
msgctxt "h63491773g723bg4bd7gbb9eg803c934c34f5"
msgid ""
"You know of my condition, and you know about my unfortunate efforts to win "
"Mystra's favour, but those are but the broad strokes."
msgstr "너는 내 상태를 알고 있고, 미스트라의 호의를 얻기 위한 내 안타까운 노력도 알겠지만, 이 내용들은 개략적인 줄거리일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 710b17d5-8338-c800-a954-b65f318537bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_GaleRefused(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:710b17d5-8338-c800-a954-b65f318537bb
msgctxt "hc3980b50g9363g4842gbeddgf0e6d88ccd21"
msgid "No. Another time maybe."
msgstr "아니. 다음에 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 724d1d5c-8ff6-142d-d216-1d0cd54c1ee7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:724d1d5c-8ff6-142d-d216-1d0cd54c1ee7
msgctxt "he878f97eg9a5eg43f6ga79cg2bca7f87eef6"
msgid "Far be it from me of course, to question your tastes."
msgstr "물론, 네 취향에 의문을 표할 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 7725977b-1a29-771c-8d33-9322e9a145c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:7725977b-1a29-771c-8d33-9322e9a145c5
msgctxt "h24f5e2f3g13a9g494fgb7c4gdbb0921756f0"
msgid "I'm many things, but coy's not one of them."
msgstr "내겐 많은 특징이 있지만, 내숭을 떠는 편은 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 7afda240-7aac-0f63-fea7-697e6f1d4230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_KarlachPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:7afda240-7aac-0f63-fea7-697e6f1d4230
msgctxt "hdf451724gb195g4e5agbbc6g1b902c0d7a8c"
msgid ""
"Actually, I may just want to spend the night with you instead of Karlach."
msgstr "사실, 칼라크보단 너와 밤을 보내는 편이 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 7b8c26b1-7f72-3b26-752b-0b572647a2c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_CRD_Loss_RomanticMoment = True
#.   Object:
#.      - ORI_State_DatingGale(1) = True
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:7b8c26b1-7f72-3b26-752b-0b572647a2c6
msgctxt "h46bdf95dgaa6cg4cd8gb18fgb2b2d68893e3"
msgid ""
"We shared a romantic moment of the mind while cloaked in the Weave, didn't "
"we?"
msgstr "저번에 위브에 몸을 숨긴 채 로맨틱한 정신의 순간을 공유했잖아, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 7d3f3403-7639-8487-b919-e73e4f607529
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:7d3f3403-7639-8487-b919-e73e4f607529
msgctxt "h65561494g4f4bg4e7bga9a6g966feb47cfad"
msgid ""
"Forgive me, I seem to be of two minds and two moods. We'll blame the wine "
"and leave it at that."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 82e1240a-1187-7416-b06c-59b2dc94ebdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:82e1240a-1187-7416-b06c-59b2dc94ebdb
msgctxt "h3d394528g83d0g4ec7ga741g292bd82b6456"
msgid "That's because you've yet to find out what you're missing."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 8652f5e1-6149-de90-dab8-49aa37a7ac33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:8652f5e1-6149-de90-dab8-49aa37a7ac33
msgctxt "h94a3a5d0gaf7fg4cccg826ag66b4056ad3b9"
msgid "Lae'zel. Blade like a razor, wit like a razor, tongue like a razor."
msgstr "레이젤은 마치 면도날과 같아서 생각과 입이 모두 날카로워."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 8747f89e-569f-2b20-f5b9-8fb01fe96b9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:8747f89e-569f-2b20-f5b9-8fb01fe96b9e
msgctxt "hd7186646g963bg4bf1g8663g5e38bdbf1c45"
msgid "What do you say?"
msgstr "어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 8aed04da-c394-ee87-e764-7ccd517b0f4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:8aed04da-c394-ee87-e764-7ccd517b0f4e
msgctxt "h90068ce0gad23g4811g835dg52596d8540fe"
msgid ""
"There's a book that circulates in Amn, detailing the first thousand nights "
"of a newlywed king and queen."
msgstr "엠에는 신혼을 보내는 왕과 왕비의 첫 천일 밤을 자세히 묘사한 책이 퍼져 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 8be8c79e-2feb-47bf-eee8-8ee5db348d2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:8be8c79e-2feb-47bf-eee8-8ee5db348d2a
msgctxt "h60cb146dg93cag414dga205g7f3b296e21f6"
msgid "Am I? Perhaps I am. Or perhaps I need another glass of wine."
msgstr "그런가? 맞을지도 모르지. 아니면 포도주 한 잔이 더 필요할지도 모르고."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 8c522e2d-02f0-9ff1-0af3-d0dc38f0512c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:8c522e2d-02f0-9ff1-0af3-d0dc38f0512c
msgctxt "h5fc2301dgf000g4c5dga3d9g5039f9ca27f5"
msgid "I'm not sure you're the one I want."
msgstr "내가 원하는 게 너인지 확실히 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = 8fa36eca-632a-bb5f-6662-754e63a93a28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:8fa36eca-632a-bb5f-6662-754e63a93a28
msgctxt "h922707d3gfe37g4fdeg8f40g280484a71922"
msgid "Didn't peg you for a sore loser, Gale."
msgstr "네가 패배자라고 한 건 아니야, 게일."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 91edf8dc-fc45-fc31-d00e-98121f9090c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:91edf8dc-fc45-fc31-d00e-98121f9090c0
msgctxt "h96d13dd5g344eg4b95ga9f6g8b9adc1932e7"
msgid "Perhaps that's a moment we ought to further explore."
msgstr "아마 그건 우리가 더 깊게 탐구해야 할 순간일지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 93a9ea22-03af-554e-cee1-202a10af8ade
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:93a9ea22-03af-554e-cee1-202a10af8ade
msgctxt "h0290778fgaf7ag41baga308gaf14135c6473"
msgid ""
"Forget the book then. Let's be blank slates on blank sheets, delightfully "
"new."
msgstr "그럼 책은 잊어버려. 백지 위에서 새롭고 유쾌하게 시작하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 94019213-5d6f-c4c9-03e3-d208aba7cc13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:94019213-5d6f-c4c9-03e3-d208aba7cc13
msgctxt "h44e3b30ag1bd7g4066gacdcg3caae12a64e4"
msgid ""
"Actually, on second thought I can't think of it entailing anything "
"particularly enticing at all."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 96bc42fc-c680-df03-a497-2e2bdfffcb87
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORIG_Gale_ToStoryScene_Story = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:96bc42fc-c680-df03-a497-2e2bdfffcb87
msgctxt "h396ce6feg32b5g40f4gb6d1g1d1f077dff52"
msgid ""
"Tonight, of course, we celebrate, and I won't keep you any longer. Tomorrow "
"night though, you're in for quite the bedtime story."
msgstr "물론 오늘 밤은 축하 파티를 해야 하니, 더 이상 너를 붙잡고 있지 않을게. 하지만 내일 밤에는 멋진 잠자리 이야기를 들려주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 97066bd6-1cf0-ce2d-4f7c-f5dd267ebae0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:97066bd6-1cf0-ce2d-4f7c-f5dd267ebae0
msgctxt "h8f512020g5c38g4c24g8598gb7be8bc8b636"
msgid "And I seem to recall a fond allusion to that moment afterwards."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 99f3aede-89e6-6b4c-31bd-f4d32cb257b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_KarlachPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:99f3aede-89e6-6b4c-31bd-f4d32cb257b0
msgctxt "h268b7e25g1ec6g4a63g82faga1977fff351d"
msgid ""
"You might be in for an adventure with Karlach. More than you bargained for - "
"with a bit of luck."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = 9e091627-a96b-582d-a16b-c5c64638abf8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(0) = False
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_GaleRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:9e091627-a96b-582d-a16b-c5c64638abf8
msgctxt "hd01194abgf660g4e37g9d13g9823246def46"
msgid ""
"You're all too quick to abandon the one you promised yourself to. That is "
"not a quality I admire."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = a195cea0-b5c7-2bd2-c842-b94bef8f6d05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_GaleRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:a195cea0-b5c7-2bd2-c842-b94bef8f6d05
msgctxt "hd8d65948geb96g4d2bg858dgb6a103b6c353"
msgid "I've said enough. Let silence do the talking."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = a344411e-8c04-0097-4782-c6595a95856a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:a344411e-8c04-0097-4782-c6595a95856a
msgctxt "h527fbb5bg81e0g4506ga2d4g355fe75e5156"
msgid ""
"No, I was glad you sought me out for an entirely different reason: to toast "
"to victory and to offer you an invitation."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = a65aabbd-f94e-35a2-1a34-2dfc8e79855a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:a65aabbd-f94e-35a2-1a34-2dfc8e79855a
msgctxt "h83c593ceg6316g4f0fga838g32b72cdce542"
msgid "I'll remind you we're newly acquainted, not newlyweds."
msgstr "우린 만난 지 얼마 되지 않은 사이야, 신혼부부가 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = a72b0f64-6d21-8382-dcbc-1cae6008eafb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:a72b0f64-6d21-8382-dcbc-1cae6008eafb
msgctxt "h4fe66ee3gd958g4140gb344gcea262aa713c"
msgid ""
"They turned everything they did into an art. The art of conversation. The "
"art of taste, time honoured and newly acquired."
msgstr "그들은 모든 행위를 예술로 바꿔놓았어. 대화의 예술. 오랜 세월을 거치며 새롭게 터득한 맛의 예술이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = ac3077e8-1728-ad89-1802-d55b517b2a58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:ac3077e8-1728-ad89-1802-d55b517b2a58
msgctxt "h5d9b08bag07c5g46deg9f66gd94e256a41a7"
msgid "Do I detect a hint of jealousy?"
msgstr "질투의 기운이 느껴졌다면 기분 탓인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = b3db5550-c877-10a6-bf38-cb28eb923014
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:b3db5550-c877-10a6-bf38-cb28eb923014
msgctxt "h6c7e91f3g9928g4ecfg8d7ag862abf5ec745"
msgid "I think that sounds delightful."
msgstr "그것참 감미로울 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = bf35f076-edca-c7be-59aa-21fcd823a875
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:bf35f076-edca-c7be-59aa-21fcd823a875
msgctxt "h9a600134g294ag4f5agba54g79c12f663d7b"
msgid ""
"That, my friend, must remain a secret. For now. Or rather: for as long as "
"you've eyes only for someone else among our troupe."
msgstr ""
"그건, 친구, 절대로 못 알려주지. 당장은 말이야. 정확히는, 우리 일행 가운데 다른 사람이 네 관심을 독차지하고 있는 동안은 안 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = c2297c6e-b858-5c26-fda8-ed1117c12f30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:c2297c6e-b858-5c26-fda8-ed1117c12f30
msgctxt "ha3100111gd0a6g4fdcg9780g5baaed4d51c4"
msgid "I do hope you know what you're doing."
msgstr "네가 지금 무슨 일을 하는지 알았으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = c38d954e-deef-cbc4-63c2-a2b7fba6d633
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_ShadowheartPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:c38d954e-deef-cbc4-63c2-a2b7fba6d633
msgctxt "hc7ed5bd2ge96cg4edbga016g7888cd301f06"
msgid ""
"There's something... unspeakable about Shadowheart. But I mean that in a "
"good way. She seems to me like a bud on the cusp of bursting into a rose."
msgstr "섀도하트는 뭔가... 이루 말할 수 없는 면이 있어. 좋은 뜻으로 말이야. 그녀는 마치 장미꽃이 피기 직전의 꽃봉오리 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = cb077053-cad4-718c-ca46-9d571c6e0089
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Gale_CRD_Loss_RomanticMoment = True
#.   Object:
#.      - ORI_State_DatingGale(1) = False
#.      - Approval_AtLeast_30_For_Sp2(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:cb077053-cad4-718c-ca46-9d571c6e0089
msgctxt "h175e84c2gb0bcg4a77gbbdbgd74578b5b71c"
msgid ""
"We had a moment, you and I, a moment in which we expressed the possibility "
"of becoming more than friends."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = ce35a968-a189-3fd2-22ab-aa25a00f918d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:ce35a968-a189-3fd2-22ab-aa25a00f918d
msgctxt "h77e993e1g6836g437agbc3fgc5e072719c39"
msgid "That's because I'm full of delights."
msgstr "그건 내가 감미로움으로 가득해서 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = cf227dbd-d67c-6a1f-0568-c7460fe88eb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:cf227dbd-d67c-6a1f-0568-c7460fe88eb6
msgctxt "hbb75dac9gf09eg4604gbe04gfd12dbca58f3"
msgid "Spontaneous thank-yous make me suspicious."
msgstr "갑자기 감사 인사를 하니 뭔가 의심스러운데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = d419fdb5-34cd-47a0-70f2-1df2f6760874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:d419fdb5-34cd-47a0-70f2-1df2f6760874
msgctxt "h65cedf33gf470g42f6gbf9bg7d28a7095d5b"
msgid "I think that's the wine talking."
msgstr "살짝 취해서 그런 건가 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = d483e30b-5fe4-6b57-815b-2003f2510136
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:d483e30b-5fe4-6b57-815b-2003f2510136
msgctxt "h2dd3a6c0gab82g47b4gbabdgfd4fd4d065d8"
msgid ""
"I'm glad you sought me out. Amid all this merriment I wasn't sure we'd have "
"a chance to speak this evening."
msgstr "네가 나를 찾아줘서 다행이야. 오늘 저녁의 이 모든 즐거움 속에서 우리가 대화할 기회가 있을지 확신하지 못했거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = d59d48f4-2bb4-4ce7-acb5-30383034bd6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:d59d48f4-2bb4-4ce7-acb5-30383034bd6c
msgctxt "he88d941cgb7d3g4818g8a18g2167ca24e4d6"
msgid "Make merry, just the two of us. What would that entail?"
msgstr "우리 둘이서만 즐거운 시간을 보낸다라. 어떤 일이 일어날까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = da565a83-1509-727b-2601-4ad2b9035ad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:da565a83-1509-727b-2601-4ad2b9035ad4
msgctxt "ha97df8d1g1d1ag41f5gb232g27940456c40d"
msgid "Let me stop you right there. That's not something I'm interested in."
msgstr "이제 그만해. 그건 내가 듣고 싶은 이야기가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = dc4390c2-f674-e94b-2e8a-6515d70abfc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:dc4390c2-f674-e94b-2e8a-6515d70abfc7
msgctxt "h36a9a09dg0b70g46bfg9934gf0e98be465c0"
msgid "I have to admit I'm curious."
msgstr "궁금하지 않다고 하면 거짓말이겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = dfeb10dd-4cb2-6c32-4163-adf93d7d739b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:dfeb10dd-4cb2-6c32-4163-adf93d7d739b
#, fuzzy
msgctxt "h119423eagf961g4bf4gb5b8g7532987afa21"
msgid ""
"I thank you for seeking me out. Amidst all this merriment I wasn't sure we'd "
"have a chance to speak this evening."
msgstr "나를 찾아줘서 고마워. 오늘 저녁의 이 모든 즐거움 속에서 우리가 대화할 기회가 있을지 확신하지 못했거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = e6fcda4e-fb9f-e2e7-9d2c-6172895a120c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_GalePartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:e6fcda4e-fb9f-e2e7-9d2c-6172895a120c
msgctxt "h3b32aebegd34fg4f4bg9ff0g2cf1c166c257"
msgid ""
"There's promise in patience, I assure you. Let the night run its course so "
"that we can run ours as well."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = e761af9c-9d5c-3205-23c4-ea630f15154a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:e761af9c-9d5c-3205-23c4-ea630f15154a
msgctxt "hb102fe28g9081g4823g8f53gf1789ff3b56e"
msgid "Another night perhaps."
msgstr "다음 밤을 기대할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = e8065e80-00a1-b635-c6d6-7629c738744c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:e8065e80-00a1-b635-c6d6-7629c738744c
msgctxt "h2f304415g08bcg4f5fgb9b8g7ea15049148f"
msgid "Leave it to you to woo someone with a book."
msgstr "책으로 누군가를 유혹하는 건 좋은 선택이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = ec75615a-e237-90ea-7b31-9e7dcb9b4e54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:ec75615a-e237-90ea-7b31-9e7dcb9b4e54
msgctxt "h50707379g1436g49deg84c4g3237da3ad581"
msgid "The time has come to paint you the true picture."
msgstr "너에게 진실을 그려줄 때가 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = f08ed7c0-5686-25a3-8312-cd95a0665f2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:f08ed7c0-5686-25a3-8312-cd95a0665f2a
msgctxt "h6e3c1061gb8b3g4e51ga099g93a7fba3813e"
msgid "A match made... not quite in heaven, but close enough."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Player
#. NodeID = f4e89c1c-8b16-4979-eb95-cd0462426532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:f4e89c1c-8b16-4979-eb95-cd0462426532
msgctxt "h7228f1afgd0bbg4741ga08bgdc11d37b40ca"
msgid "I'm sure you're welcome."
msgstr "당연히 그러셔야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = f61407a5-494d-cd50-03d4-9e7a429793bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:f61407a5-494d-cd50-03d4-9e7a429793bc
msgctxt "haaa80c13gfd3fg4513g9413g34b606442c61"
msgid "But before you go..."
msgstr "가기 전에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = f7da019d-822d-131d-211b-bb1621e962e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_WyllPartner(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:f7da019d-822d-131d-211b-bb1621e962e6
msgctxt "h547e03e1gd3dcg4308g97fbg1bd99b5cefc5"
msgid "Wyll's a good man. He may actually be a tried-and-true storybook hero."
msgstr "윌은 좋은 남자야. 정말로 진실한 노력을 다한 이야기 속의 영웅일지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale
#. Speaker = Gale
#. NodeID = fb6c3c39-7efe-8729-d011-fd9ddcbad36a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Gale:fb6c3c39-7efe-8729-d011-fd9ddcbad36a
msgctxt "h261c3709g3f5ag469agb770g5424b2e4da4d"
msgid "Doubt is a spoilsport. Cast it aside."
msgstr "의심은 흥을 깰 뿐이야. 그건 제쳐둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Player
#. NodeID = 08d9c3f3-d2d7-0cef-6930-f4c2f04d686c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:08d9c3f3-d2d7-0cef-6930-f4c2f04d686c
msgctxt "h1b1b6e13gce56g4b49g81a6g80b5af0dfffb"
msgid "Was I that obvious?"
msgstr "그렇게 티 나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 09eac407-c6cc-2c96-75dd-cce8e3149e33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Karlach_State_Dead = False
#.      - ORI_Karlach_HasMet = False
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:09eac407-c6cc-2c96-75dd-cce8e3149e33
msgctxt "h7c10c2bag072bg4d37g9a70g95848201baef"
msgid "These people are still in danger."
msgstr "저 사람들은 여전히 위험한 상태야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Player
#. NodeID = 0a61a5e9-0786-3501-113a-82e97cf8ae7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:0a61a5e9-0786-3501-113a-82e97cf8ae7e
msgctxt "hc92c5049g9598g43bag8279g4897f73aa7a8"
msgid "I like you, Wyll. And I want to know you better."
msgstr "네가 좋아, 윌. 그리고 널 더 알고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 0db46644-1da1-332c-b2f8-7723d3839f34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:0db46644-1da1-332c-b2f8-7723d3839f34
msgctxt "h683d8c87g3654g4d46g8755gc2eb6bdf3beb"
msgid "If only faith was enough to ward off every bully of the wilds."
msgstr "믿음만으로 야생의 모든 괴물을 물리칠 수 있다면 얼마나 좋을까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Player
#. NodeID = 0ea92ff0-f232-1d29-bf21-52be10f4af2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:0ea92ff0-f232-1d29-bf21-52be10f4af2d
msgctxt "he0ecabf6g949fg49cfga04dg5de6c85d2902"
msgid "I just wanted to check up on you, that's all."
msgstr "그냥 네가 어떤지 보러온 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 13e6e6a9-d394-8a8c-3ad7-87602f7654a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:13e6e6a9-d394-8a8c-3ad7-87602f7654a1
msgctxt "hf6bc63a1g1ebeg4d4dgbc09g87566c206233"
msgid "I'm not sure that I am. But it means something that you think so."
msgstr "잘 모르겠어. 하지만 그렇게 생각한다는 건 뭔가 의미가 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 166c8f2c-47e4-0477-c1d2-6f0b3ee10c25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:166c8f2c-47e4-0477-c1d2-6f0b3ee10c25
#, fuzzy
msgctxt "h355aeceag5fa5g4eb7g95c4g3e3caffe1662"
msgid "But who am I fooling? I can't go back to that life."
msgstr "하지만 나 자신을 속일 순 없어. 다신 그런 삶으로 돌아가지 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Player
#. NodeID = 17b9e864-d997-e0ed-01a4-6903c8554c2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:17b9e864-d997-e0ed-01a4-6903c8554c2b
msgctxt "h5a74d07cg7f70g40abga379gdcea5e805e85"
msgid "I wish you were there, but I'll respect your need for peace."
msgstr "너도 거기 있으면 좋겠지만, 평온함이 필요하다면 존중해줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 1ce95583-8864-0886-93df-f49f8fe4deec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:1ce95583-8864-0886-93df-f49f8fe4deec
msgctxt "h0c474646g4500g48ddg8de6g89aa6327ccb0"
msgid ""
"I love the way your nose wrinkles up when you get the scent of a lead for "
"the first time."
msgstr "네가 처음 납 냄새를 맡았을 때 코에 주름이 잡히는 모습이 정말 마음에 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 1d5a0285-904d-997c-6822-c5a6984e8904
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = True
#.      - GLO_Volo_State_PermaDefeated = False
#. SetFlags:
#.   Local:
#.     - 29dbf53f-173e-20de-7cfd-d45fc98b6d20_volo = True
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:1d5a0285-904d-997c-6822-c5a6984e8904
msgctxt "h97f00c6agd49eg4948g9ab9g02288db1ea86"
msgid ""
"You must be Volo in disguise, out here to harangue me for some tales of the "
"Frontiers."
msgstr "너는 변장한 볼로임이 분명해. 변경에 대한 이야기로 열변을 토하러 왔나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 2019841a-6cda-e035-bebf-def6735cda25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:2019841a-6cda-e035-bebf-def6735cda25
msgctxt "hcfef9838g1c2dg4009gbe73g106c39e404aa"
msgid "Though I can't say I've earned the honour."
msgstr "내가 이 영광을 얻었다고 말할 수는 없지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Player
#. NodeID = 21059d60-646b-d067-8226-4f08090e7f1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:21059d60-646b-d067-8226-4f08090e7f1b
msgctxt "h4ff8b733gf39eg4428g91a5g89b0e164052e"
msgid "You're impossible."
msgstr "못말리겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 22413716-833c-42c7-83ab-ccddb9655e17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:22413716-833c-42c7-83ab-ccddb9655e17
msgctxt "h9e2c49a6gaedag46a5gbd77gbd378f789719"
msgid ""
"Maybe another time. Now, you've got a party to get back to. Don't forget, "
"tonight is about <i>you</i>."
msgstr "다음에 하자. 이제 파티에 돌아가야지. 잊지마, 오늘 밤은 <i>널</i>위한 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 231758d1-eebf-10a3-832f-2f8a1a652440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:231758d1-eebf-10a3-832f-2f8a1a652440
msgctxt "hea7b75fdg23ceg441fgbf16g1abfd995380c"
msgid "Saving the people of the grove was all the satisfaction I could ask."
msgstr "숲 주민들을 구한 것만으로도 충분히 만족감을 얻었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 263f6147-3146-3c53-4d19-bc5653f43599
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:263f6147-3146-3c53-4d19-bc5653f43599
#, fuzzy
msgctxt "ha7b76f37gad23g485fg940dg7a375a6bfd43"
msgid "I know how to have fun! I have lots of fun every day!"
msgstr "나도 즐길줄은 알아! 매일 즐겁다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Player
#. NodeID = 26c210c0-42e6-d368-db25-af0f45d6f849
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:26c210c0-42e6-d368-db25-af0f45d6f849
msgctxt "hca7c8726g3745g410fg9b05g161d285ef5f2"
msgid "I just wanted a quick chat. I'll leave you to it."
msgstr "잠깐 이야기하고 싶었을 뿐이야. 이제 갈게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Player
#. NodeID = 275a69cf-4af0-e331-8402-5f3626bac44c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:275a69cf-4af0-e331-8402-5f3626bac44c
msgctxt "ha9dda53bgad12g4cc0gbc3bg8c5c64c0071a"
msgid "You don't unsettle me, you know that."
msgstr "난 불안하지 않은데, 알면서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 2a9a393e-e93d-a580-93d5-2af048f0a398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:2a9a393e-e93d-a580-93d5-2af048f0a398
msgctxt "h647ec42bgedcbg4db8gb842g0a1bb75b109d"
msgid ""
"We all die. But life's still worth the living. Otherwise, what's the point "
"of it?"
msgstr "우린 모두 죽어. 그렇다고 살아갈 가치마저 잃는 건 아니지. 그게 아니라면, 이게 다 무슨 소용이겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA
#. Speaker = Wyll
#. NodeID = 3009cdcb-7a7d-7fd8-381c-431023839f93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_ROM_Wyll_PostEA:3009cdcb-7a7d-7fd8-381c-431023839f93
msgctxt "h72cb668fge5efg4ceag83b5g67bb5d369daa"
msgid ""
"I feel spikes begnning to sprout <i>in places they really shouldn't.</i>"
msgstr "뾰족한 것들이 <i>진짜 있으면 안 되는</i> 곳까지 자라나고 있다니까."

