msgctxt "ha10410fcgfdd1g4035ga2dag65db3d09af92"
msgid "*You spot a name on the dog's collar - 'Scratch'.*"
msgstr "*당신은 개 목걸이에서 이름을 발견합니다- '스크래치'.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = 590b01c2-e7ff-f4f0-206a-2b3b3a3c04ac
