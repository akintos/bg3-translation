msgid ""
"*This is the truth lost in your mangled memories. You are a spawn of Bhaal - "
"his heir, his scion.*"
msgstr "*이것이 바로 당신의 짓이겨진 기억에 묻혀있던 진실입니다. 당신은 바알의 자식이자 후계자, 바알스폰입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 0641100f-933e-b156-e8a7-a2a89f73d4d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:0641100f-933e-b156-e8a7-a2a89f73d4d9
msgctxt "h7c79fbcegbe5ag40bfg9c4bgffb993db2c8e"
msgid "I'm in a nightmare, aren't I?"
msgstr "이건 악몽이야, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 06ca212b-e2c1-05d8-99ae-5d3d29510ced
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:06ca212b-e2c1-05d8-99ae-5d3d29510ced
msgctxt "h9c6c9c06g0475g49b5gb068g15407ec04869"
msgid "You're going to tell me <i>everything </i>about my past life."
msgstr "내 과거에 대해 <i>죄다</i> 털어놔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 08f19a8f-5da1-28f1-ded8-0734598e1385
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:08f19a8f-5da1-28f1-ded8-0734598e1385
msgctxt "h23027d97g8ce4g4853ga720g9e4d749d8e62"
msgid "Though I would love to regale you with your past triumphs, I cannot."
msgstr "과거의 승리로 주인님을 기쁘게 해드리고 싶지만 그럴 순 없네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 0f16d6d2-0d1d-a7d2-df1a-20f4e756e433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:0f16d6d2-0d1d-a7d2-df1a-20f4e756e433
msgctxt "hd4416703g7805g4e1ag925ege7eceb7514c2"
msgid "<i>Go for a walk, to try and stop yourself from retching.</i>"
msgstr "<i>산책을 한다. 구역질을 참는 데 도움이 될지도 모른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = 13b614b0-bfb3-f293-05f7-7659398e3074
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - ORI_Avatar_DarkUrge.ButlerAppearance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:13b614b0-bfb3-f293-05f7-7659398e3074
msgctxt "ha63ab560g4375g4158g918fg87913e73a175"
msgid "*Why did she die? The mystery gnaws at your pounding heart.*"
msgstr "*왜 그녀는 죽었을까요? 의문이 당신의 두근거리는 심장을 갉아먹습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1545290c-90a8-ac75-7d9f-22f248563382
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:1545290c-90a8-ac75-7d9f-22f248563382
#, fuzzy
msgctxt "h42682bcfg91a2g4676g9b89gefafd5375d3c"
msgid "Such fine work could never be done by a wretch like me!"
msgstr "그런 훌륭한 일은 저같이 몹쓸 녀석은 절대 할 수 없는 일인걸요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 15519c17-65d3-fa57-9224-89635888e306
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:15519c17-65d3-fa57-9224-89635888e306
msgctxt "h869913bdgda0cg48a9gbfc9ga92711f60bd8"
msgid "One Hell of a Butler, the most unprincipled servant you could hope for."
msgstr "주인님께서 바랄 수 있는 최고의 절조없는 하인입니다. 저는 어디까지나 집사니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 1925427f-831f-9685-80bc-20d5a2b3acb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:1925427f-831f-9685-80bc-20d5a2b3acb5
msgctxt "h5f872428g734eg487cgaf92g3c206a683088"
msgid "What in the Hells do you mean, you're my <i>butler</i>?"
msgstr "도대체 무슨 말이야, 네가 내 <i>집사</i> 라니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1ab8f979-4fb5-55c0-7134-4409c735ec0e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:1ab8f979-4fb5-55c0-7134-4409c735ec0e
msgctxt "h52e4ffe8gab7dg4f1egb0a4gc971a0e22ed9"
msgid "Be true to yourself, my Lord."
msgstr "본성에 충실하세요, 주인님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1ab8f979-4fb5-55c0-7134-4409c735ec0e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:1ab8f979-4fb5-55c0-7134-4409c735ec0e
msgctxt "ha1c8cbbcgc459g4c87gbc6cgae4249d96de9"
msgid "Be true to yourself, my Lady."
msgstr "본성에 충실하세요, 주인님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1ab8f979-4fb5-55c0-7134-4409c735ec0e
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:1ab8f979-4fb5-55c0-7134-4409c735ec0e
msgctxt "h4e8f3f4cg53f9g4761g9e22g3f64f8eb1ab3"
msgid "Be true to yourself, Master."
msgstr "본성에 충실하세요, 주인님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 20355cef-913a-edb9-516b-72e612a7db9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:20355cef-913a-edb9-516b-72e612a7db9c
msgctxt "hf1a2ef37g5757g4e14gb3c6g43d21ac38d8e"
msgid "<i>Sigh dreamily at the fantasy.</i>"
msgstr "<i>환상적인 상상에 꿈꾸듯 한숨을 내쉰다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 206cdaf3-4984-c763-df36-67675fa0e0cd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:206cdaf3-4984-c763-df36-67675fa0e0cd
msgctxt "ha1ca0f2cg4655g4587g919agf0d64762bcc7"
msgid ""
"Ooft! I had heard of Milord's indisposition, but I had hoped the rumours "
"were untrue."
msgstr "으윽! 주인님의 병에 대해 듣긴 했지만, 그 소문이 사실이 아니길 바랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 206cdaf3-4984-c763-df36-67675fa0e0cd
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:206cdaf3-4984-c763-df36-67675fa0e0cd
msgctxt "h2711b25bg894cg4fecg9d2fg46249137841f"
msgid ""
"Ooft! I had heard of Milady's indisposition, but I had hoped the rumours "
"were untrue."
msgstr "으윽! 주인님의 병에 대해 듣긴 했지만, 그 소문이 사실이 아니길 바랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 206cdaf3-4984-c763-df36-67675fa0e0cd
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:206cdaf3-4984-c763-df36-67675fa0e0cd
msgctxt "hf12f3c42g1129g4e7ega661gcc0f8590e1df"
msgid ""
"Ooft! I had heard of Master's indisposition, but I had hoped the rumours "
"were untrue."
msgstr "으윽! 주인님의 병에 대해 듣긴 했지만, 그 소문이 사실이 아니길 바랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2320af88-5e91-c697-f410-8e1f4c78fd8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:2320af88-5e91-c697-f410-8e1f4c78fd8b
msgctxt "h6461cbbcgfb00g4273gb7e8g952f39c183ad"
msgid ""
"I found you, following the stench of that bard. She reeked across the coast "
"like a piece of dog-muck on the road."
msgstr "그 바드의 악취를 따라 주인님을 찾았습니다. 그녀는 마치 길 위의 개똥처럼 온 해안에 악취를 풍겼죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 288c6a94-bd7b-1c90-e454-9b617cc717cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:288c6a94-bd7b-1c90-e454-9b617cc717cc
msgctxt "hcf12d103ge4c8g4cceg8670g49efa19b6025"
msgid ""
"We are in a place darker than any prison, hotter than any fire, where the "
"souls of the innocent scream in sacred agony..."
msgstr ""
"우리는 어떤 감옥보다도 어둡고, 어떤 불보다 뜨거운 곳에 있어요. 죄 없는 이들의 영혼이 신성한 고통 속에서 비명을 지르는 곳이죠..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2952d704-7899-bdd8-e648-d40f4bf17382
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:2952d704-7899-bdd8-e648-d40f4bf17382
msgctxt "h2f34482bg107fg4084gba18g638e409d112a"
msgid ""
"I followed you, my dear rotted Master. We have been parted so tragically "
"long."
msgstr "나의 사랑하는 부패한 주인, 당신을 찾고 있었어요. 너무 끔찍하도록 긴 시간 동안 떨어져 있었군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = 2cea422e-c2fe-89ae-38f0-aeadb776d1bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:2cea422e-c2fe-89ae-38f0-aeadb776d1bf
msgctxt "h4078e902geacfg456eg892egd1a36527927e"
msgid "*She was only seeking your protection? What compelled you to end her?*"
msgstr "*그녀는 단지 당신의 보호를 요청했을 뿐이었을 텐데. 무엇 때문에 당신은 그녀를 죽인 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 2dc7560a-5c70-a2a3-f8bd-0e6512af8b21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:2dc7560a-5c70-a2a3-f8bd-0e6512af8b21
msgctxt "h8750c0ceg1c28g4796gbf0cg9d0ef91cb4d8"
msgid "Neither can I."
msgstr "그럴 일 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 343d95f4-96c4-56d2-dc64-7a041eaf4823
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:343d95f4-96c4-56d2-dc64-7a041eaf4823
msgctxt "h1a20de4dg3361g4997g990bgd2d39f9eb596"
msgid "Did you cause me to kill her?"
msgstr "네가 날 그녀를 죽이게 만든 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = 3b499437-b6f5-f2b3-72c6-61d0c7ada4f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:3b499437-b6f5-f2b3-72c6-61d0c7ada4f3
msgctxt "h5285a9a9gcc2cg4f4eg9bb7g5e597afa97e0"
msgid "*You would have given anything to have seen it.*"
msgstr "*당신은 그 광경을 볼 수만 있다면 무엇이든 했을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 3c98b6bc-e4af-d378-c1d1-9d8f14b1e499
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:3c98b6bc-e4af-d378-c1d1-9d8f14b1e499
msgctxt "h25b6ce44g862bg4d98gb39bg1511e1ce28d1"
msgid "My head is sick, very sick. Do you know about it?"
msgstr "머리가 너무 아파. 대체 어째서지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3fdf9e5b-26c4-41d3-1a87-d3ea44bf8770
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:3fdf9e5b-26c4-41d3-1a87-d3ea44bf8770
msgctxt "h258156bagc0a6g4f2cg99aegf2cf6a6e45d2"
msgid "Ah yes, Milord has always had some spontaneous little outbursts of joy."
msgstr "아, 그래요, 주인님은 늘 무의식적으로 작게 기쁨을 분출하곤 하셨죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3fdf9e5b-26c4-41d3-1a87-d3ea44bf8770
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:3fdf9e5b-26c4-41d3-1a87-d3ea44bf8770
msgctxt "h40153e83g5e2fg430ag8a4bg1a2259e4bd45"
msgid "Ah yes, Milady has always had some spontaneous little outbursts of joy."
msgstr "아, 그래요, 주인님은 늘 무의식적으로 작게 기쁨을 분출하곤 하셨죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3fdf9e5b-26c4-41d3-1a87-d3ea44bf8770
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:3fdf9e5b-26c4-41d3-1a87-d3ea44bf8770
msgctxt "h4578086dg918eg4d81g9b75gf8898717aea8"
msgid "Ah yes, Master has always had some spontaneous little outbursts of joy."
msgstr "아, 그래요, 주인님은 늘 무의식적으로 작게 기쁨을 분출하곤 하셨죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 4a182b3c-1177-5684-c69d-a9cec54b12af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:4a182b3c-1177-5684-c69d-a9cec54b12af
msgctxt "h660f160dg6d8eg4668g861dg0fdc3fa1b05b"
msgid "Death wants <i>everything </i>to do with you, good villain."
msgstr "죽음은 언제나 훌륭한 악당이신 주인님과 <i>모든 것</i>을 함께하기를 원한답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = 4a2783b0-c4c5-2f2d-0f48-7d3e558ef45d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:4a2783b0-c4c5-2f2d-0f48-7d3e558ef45d
msgctxt "h14279864g3449g4b9dgb3e4geeb8dab7b69d"
msgid "*As you jolt awake, too many questions plague you.*"
msgstr "*잠에서 퍼뜩 깨어나자, 너무나 많은 질문이 당신을 괴롭힙니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 4f414f5d-f589-e41a-f63d-1a6c386ab1fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:4f414f5d-f589-e41a-f63d-1a6c386ab1fc
#, fuzzy
msgctxt "h14a03f5fg65ceg49d1ga281g9a5fe5ae713c"
msgid ""
"At least I'm here now, to direct you towards further atrocities worthy of "
"your station. You truly have been lost without your Butler, haven't you?"
msgstr ""
"적어도 지금은 제가 여기 있으니, 주인님의 지위에 어울리는 더 큰 잔학한 행위로 인도할 수 있겠군요. 정말 집사 없이는 길도 못 "
"찾으시는군요, 안 그래요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 5363bad3-50cc-73eb-05fe-250e025600f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:5363bad3-50cc-73eb-05fe-250e025600f2
msgctxt "hdfe9e728gc746g4354g9d5fge30750b180a8"
msgid "This prize isn't from my tadpole, is it?"
msgstr "이 상은 내 안의 올챙이가 준 것이 아니군, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 543a4fc4-6a6e-d418-9ed4-ae43169f9fbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:543a4fc4-6a6e-d418-9ed4-ae43169f9fbc
msgctxt "h0dcd5252gf5c4g4eaag8301g8753276f435c"
msgid ""
"You earned this iniquitous prize through your great show of exceptional "
"violence the other night."
msgstr "주인님은 지난 밤에 뛰어난 폭력을 보여준 덕분에 이 사악한 상을 받게 되었습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 56e6cbed-5753-ab5a-e424-5a3a92878e3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_ButlerMurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:56e6cbed-5753-ab5a-e424-5a3a92878e3d
msgctxt "h887e0556gdf46g4116ga36aga7eda2a131d8"
msgid ""
"Fear not, I have arranged your affairs in your absence. You shall wake up to "
"her putrefied carcass. Breakfast in bed!"
msgstr ""
"하지만 걱정하지 마세요, 제가 주인님이 없을 때 일을 대신 처리했으니까 말이죠. 주인님은 그녀의 부패한 시체 위에서 일어나게 될 거예요. "
"저만 믿으세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 5d021d9d-13d3-fce7-728f-a861124a4c30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:5d021d9d-13d3-fce7-728f-a861124a4c30
msgctxt "h4a6bf24fg5e22g4877g895bg897f369b9cf2"
msgid ""
"My, my. We will be reintroducing necrophilia to your schedule in no time."
msgstr "이런, 이런. 아무래도 주인님의 일정에 당장이라도 시체성애증 부분을 다시 가져와야겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6136b15c-95e9-da0e-0767-71b3c41f0eac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:6136b15c-95e9-da0e-0767-71b3c41f0eac
#, fuzzy
msgctxt "hcc45ef6egb0c2g4eb4gbab6g7d9e2458f2b7"
msgid "I am forbidden to interfere. Our betters will not allow it."
msgstr "저는 간섭하는 것이 금지되어 있어요. 위에서 그것을 허락하지 않을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6225f508-6bad-d69e-5c6b-9f0f3bde841b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:6225f508-6bad-d69e-5c6b-9f0f3bde841b
msgctxt "hf312de0cg71f6g474dg9645g76df4418bad4"
msgid ""
"I was so worried for your health during our long separation. Now I found "
"you, silly me, my fears were unfounded."
msgstr ""
"저는 오랜 이별 동안 주인님의 건강이 너무 걱정됐어요. 이제 주인님을 찾았는데, 멍청하기도 하지, 두려워할 필요가 없었는데 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6affd8c3-90b4-59fa-2870-2f4fabd7323e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:6affd8c3-90b4-59fa-2870-2f4fabd7323e
msgctxt "h5d5ad3e4g0cffg41f8gbd68gb32e959989c6"
msgid ""
"I was so worried for your health during our long separation. Master, you "
"should really take better care of yourself."
msgstr "저는 오랜 이별 동안 주인님의 건강이 너무 걱정됐어요. 주인님, 스스로를 정말 더 소중히 여기셔야 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = 6fdf29ce-b25f-cd29-5d97-a38edab794d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - ORI_Avatar_DarkUrge.ButlerAppearance(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:6fdf29ce-b25f-cd29-5d97-a38edab794d8
msgctxt "h8a89aa54g5b02g41b9ga8dagb8e5794c6d69"
msgid ""
"*When the proud deed of her death was yours, why do you have no recollection "
"of it?*"
msgstr "*그녀의 자랑스러운 죽음은 당신의 것이었는데, 왜 그것을 기억하지 못하는 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 71016cb3-28c2-99a8-747c-659c827b5d3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:71016cb3-28c2-99a8-747c-659c827b5d3d
#, fuzzy
msgctxt "hfe3cfa55g5f14g4c00g8f00gf85a4b7bdfaf"
msgid ""
"It is too sad, I am too late! The conditions were all set up for the perfect "
"crime, and your precious knife-arm didn't take the bait!"
msgstr "슬프네요, 너무 늦어버렸어요! 완벽 범죄를 위한 모든 조건이 갖추어졌는데, 그 소중한 오른팔이 미끼를 물지 않을 줄이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 7673e798-3639-c343-a63e-87691ba47a71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:7673e798-3639-c343-a63e-87691ba47a71
#, fuzzy
msgctxt "hfb8ba63agafe1g4767gbcb2g3b479ff7c4d4"
msgid "I can still smell her gore, too. What a fair perfume."
msgstr "아직도 그녀의 피 냄새가 나. 얼마나 좋은 향수인지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7ec6374b-f34a-9ecc-f542-c2e3fbbe11e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_ButlerMurderedAlfiraOrAlternative = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:7ec6374b-f34a-9ecc-f542-c2e3fbbe11e5
msgctxt "h0ba99811gac79g46e1g844cgfd540ac074a0"
msgid ""
"At least the bard is gone now, I promise I will not speak of this little "
"embarrassment again."
msgstr "적어도 그 바드는 이제 죽었으니, 이 작은 난처한 일에 대해서는 말하지 않기로 약속하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 850521d1-a206-71fe-dd87-a0c197b56fa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:850521d1-a206-71fe-dd87-a0c197b56fa9
msgctxt "h4d9492b8g8df3g4307g8461gbe1eb9f8ff95"
msgid ""
"No matter, we will get you back to committing five villainous acts before "
"breakfast in no time!"
msgstr "괜찮아요, 아침 식사 전에 다섯 번 정도는 극악무도한 짓을 저지를 수 있도록 도와드릴테니까요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 851357d1-9b90-3c09-deed-d661cd5082d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:851357d1-9b90-3c09-deed-d661cd5082d8
#, fuzzy
msgctxt "h4b8906e7gc8f0g4687ga679g0fe975551268"
msgid ""
"Pay no mind to it. We have been with you, always. And always by your side, "
"we will remain."
msgstr "신경 쓰지 마세요. 우리는 항상 주인님과 함께 해왔으며, 항상 주인님의 곁에 남아있을 테니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 87342618-e69e-c2b4-df9d-3ab3079f1d0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:87342618-e69e-c2b4-df9d-3ab3079f1d0c
msgctxt "hf51b6c1bg03fbg45c5g8a96g7b15703a0e2c"
msgid "Get away from me!"
msgstr "나한테서 떨어져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 888855ad-8bfb-9aa5-0054-c69125fee196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:888855ad-8bfb-9aa5-0054-c69125fee196
msgctxt "h4fa215ceg3c24g4502g8d3bg926231fcfc94"
msgid "It was bliss to kill her in front of <i>everyone</i>."
msgstr "<i>모두</i>의 앞에서 그녀를 죽인 것은 정말 행복한 일이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8a27c9e8-eda0-0ed0-e7a5-dbb37d0d17c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:8a27c9e8-eda0-0ed0-e7a5-dbb37d0d17c9
msgctxt "haddfd3e6g6ab7g4a30ga904g334805e62c78"
msgid "Sceleritas Fel. Your loyal and ever-adoring butler."
msgstr "전 스켈레리타스 펠. 당신의 충성스럽고 끝없이 사랑스러운 집사죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = 8a5c4ebc-b23c-c9d6-777f-78fe1a8e7b12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:8a5c4ebc-b23c-c9d6-777f-78fe1a8e7b12
#, fuzzy
msgctxt "h6b6392fcg1a35g429agb36cg05a352f92ae6"
msgid ""
"*The blood running through you feels so thick, you can hear your arteries "
"screaming as your restless body twitches.*"
msgstr "*몸속에 흐르는 피가 너무 진해서, 당신의 불안한 몸이 경련할 때마다 동맥이 비명을 지르는 것을 들을 수 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = 8ad067c2-4954-d1f0-4ee3-57d0919a284b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:8ad067c2-4954-d1f0-4ee3-57d0919a284b
msgctxt "h70f4b5e7g265dg40a4g8df6ga7f034c74505"
msgid "Get away from me!"
msgstr "나한테서 떨어져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = 9395bc45-1a29-2cdc-5b56-fe7e31ad6604
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:9395bc45-1a29-2cdc-5b56-fe7e31ad6604
msgctxt "hd5259b37g6551g4734gb22fgc5f060839332"
msgid ""
"*You wonder what she looked like as she died. Squirming, skewered, in abject "
"agony.*"
msgstr "*그녀가 죽었을 때 어떤 모습이었을지 떠올립니다. 몸을 꿰뚫린 채 비참한 고통 속에서 몸을 꿈틀거리고 있었겠죠 .*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9677d75e-71b6-8cf9-d517-ca5d1472868b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:9677d75e-71b6-8cf9-d517-ca5d1472868b
msgctxt "hdb73f685gdc4dg4159g91b6g76c01840163a"
msgid ""
"You were meant to kill the bard, my Liege. Then throw her into a ditch, "
"river, pit, bog, or whathaveyou."
msgstr "주인님, 당신은 음유시인을 죽일 작정이었습니다. 그런 다음, 그녀를 도랑, 강, 구덩이, 늪, 등에 던져버릴 예정이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9a575062-adae-86d1-be17-66b7834a5007
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:9a575062-adae-86d1-be17-66b7834a5007
msgctxt "h9682fdcfg1fa9g435fg9484g337ba82aaf69"
msgid "Milord? Jubilant day! I have found your vile self at last!"
msgstr "주인님? 환상적인 날이네요! 마침내 그 사악한 모습을 찾아냈어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9a575062-adae-86d1-be17-66b7834a5007
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:9a575062-adae-86d1-be17-66b7834a5007
msgctxt "h67b0c441g1551g43c8g92dbgcf4c53a6ffd0"
msgid "Milady? Jubilant day! I have found your vile self at last!"
msgstr "주인님? 환상적인 날이네요! 마침내 그 사악한 모습을 찾아냈어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9a575062-adae-86d1-be17-66b7834a5007
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:9a575062-adae-86d1-be17-66b7834a5007
msgctxt "hf5bca215g964cg4159g81a7gc19ed84c962d"
msgid "O most royal one! Jubilant day! I have found your vile self at last!"
msgstr "가장 고귀한 분이시여! 환상적인 날이네요! 마침내 그 사악한 모습을 찾아냈어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9bb37abc-1d72-029d-a202-7e53a4b52d88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:9bb37abc-1d72-029d-a202-7e53a4b52d88
#, fuzzy
msgctxt "ha4db3be9g7550g4a59ga6d7gaf14e223c1b1"
msgid ""
"It will be hard to improve upon what you have already done - I am a great "
"admirer of what you did with the bard's left carotid artery."
msgstr "주인님께서 끝내신 일은 더 개선할 여지가 없을 정도에요. 그만큼 이번에 바드의 왼쪽 경동맥에 가하신 일은 매우 존경스럽습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9f8030f0-9417-7b31-be17-96fd7078dd22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:9f8030f0-9417-7b31-be17-96fd7078dd22
msgctxt "h5447cbabg3666g4f8fg9e7cg0be598789f41"
msgid ""
"I'm sure Master will be better soon. A fellow of your fine breeding is never "
"down for long."
msgstr "저는 주인님이 나아질 거라 믿습니다. 당신처럼 태생부터 뛰어나신 분은 무슨 일이든 털어내고 일어서니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = a6585b8d-0e58-1005-0c99-9860b7f1c456
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:a6585b8d-0e58-1005-0c99-9860b7f1c456
msgctxt "hfe353b85g693dg4546gacd5g87c138dae56e"
msgid "But I am certain inspiration will strike!"
msgstr "하지만 저는 다음에도 영감이 떠오를 거라고 확신해요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = a823bd5d-aaeb-6e51-5225-a17fd151d315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:a823bd5d-aaeb-6e51-5225-a17fd151d315
msgctxt "hf69c6e93g117eg40f3gaa2fgb09ee6c64384"
msgid ""
"Oh, sweet Master, you're shivering! You'll get sick if you don't have your "
"sweetmeats!"
msgstr "오, 귀여운 주인님, 떨고 계시는군요! 달콤한 간식을 먹지 않으면 병이 날 거예요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = b20242b2-0233-a6a0-2194-7dad5f661f77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:b20242b2-0233-a6a0-2194-7dad5f661f77
msgctxt "h97252b77g66e1g4cd4gb7d6gd8a85838d71e"
msgid "What in the Hells do you mean, you're my <i>butler</i>?"
msgstr "도대체 무슨 말이야, 네가 내 <i>집사</i> 라니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = b234ac59-897d-ae23-88cc-deb02f5e5d5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:b234ac59-897d-ae23-88cc-deb02f5e5d5f
#, fuzzy
msgctxt "h368e283egd154g47bdga4a5gdbcaf583e2ed"
msgid "That mithering thing?"
msgstr "그 귀찮은 것 말씀이신가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = b478ee9a-23c0-763a-b516-b6cae7c59562
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:b478ee9a-23c0-763a-b516-b6cae7c59562
#, fuzzy
msgctxt "h2f40d7c7ge939g42bdgab76g5744400f4202"
msgid "Oh, my sanguine Master! I Your next work will be wonderful."
msgstr "오, 낙관적인 주인님! 다음 작품도 완벽할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = b62d982e-e9d7-d7cf-8090-5aeeb2a41554
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:b62d982e-e9d7-d7cf-8090-5aeeb2a41554
#, fuzzy
msgctxt "hd0889306g5c10g411fg9449gb9a80c403077"
msgid ""
"You are a fellow of fine breeding... you shall have your chance to "
"<i>indulge </i>again soon enough. And there will be a great Prize when you "
"do."
msgstr ""
"주인님은 훌륭한 교육을 받은 분이니... 곧 다시 <i>충족시킬</i> 기회가 있을 겁니다. 그리고 그때 큰 보상이 주어질 거고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = b8bcca8f-9fb2-f8ca-37b2-1a0baa36d4e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:b8bcca8f-9fb2-f8ca-37b2-1a0baa36d4e2
msgctxt "h9656fe30g07b1g4487gaae0g9d41438617ec"
msgid "I didn't kill her! It happened while I was asleep!"
msgstr "나는 죽이지 않았어! 그건 내가 자고 있을 때 일어난 일이라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = b9b74b23-5fe2-676d-3e6e-29872295faef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:b9b74b23-5fe2-676d-3e6e-29872295faef
msgctxt "ha92dc4bfgd10eg454bgbbbagdd8292e80b02"
msgid ""
"You have kept killing without me. That will keep you fighting fit and "
"healthy."
msgstr "주인님은 저 없이도 계속 죽여왔어요. 그 덕에 주인님은 건강해졌고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = bba6ffa1-747a-d311-34d9-922ce221f188
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:bba6ffa1-747a-d311-34d9-922ce221f188
#, fuzzy
msgctxt "hb09dae29g6070g4fa1g8219g3ecb1aa8a03d"
msgid "You have always struggled to conduct yourself properly without me."
msgstr "제가 없으니, 주인님께선 언제나 올바르게 행동하려고 발버둥치셨죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = bbee3a42-008b-c172-6206-dd9626078d07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternativeInSleep = True
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:bbee3a42-008b-c172-6206-dd9626078d07
msgctxt "hffe86fd8g2158g4467g8e0fgc6ce421979bd"
msgid ""
"*Tonight, you can't chase the thoughts of that poor girl you killed from "
"your head.*"
msgstr "*오늘 밤은 유난히 당신이 죽인 불쌍한 소녀에 대한 생각이 머릿속을 자꾸 맴돕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = c1ea3ba0-47aa-0a7f-f1e9-2f581a5211a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:c1ea3ba0-47aa-0a7f-f1e9-2f581a5211a5
msgctxt "h16629298gb828g4609ga411gaf18a665fa34"
msgid "Oh, it was wonderfully disgusting, wasn't it?"
msgstr "오, 굉장히 역겨우시겠죠, 그렇지 않나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = c267e03e-b515-5c82-0951-0a85cacd1e54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:c267e03e-b515-5c82-0951-0a85cacd1e54
msgctxt "hc6f63d4ag0988g43a4g9ecega422d268118b"
msgid "There will be no more barbarity!"
msgstr "더 이상의 잔혹한 일은 없을 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = c76c6101-80fc-1c4d-7331-a8b1e993e92e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:c76c6101-80fc-1c4d-7331-a8b1e993e92e
msgctxt "he30c0f3dga667g4d78gbc9dg0519a21f14f1"
msgid "It isn't good for you to go this long without garrotting little girls."
msgstr "어린 여자를 죽이지 않고 이렇게 오랜 시간을 보내는 건 정말 좋지 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = cb1ecce1-04ea-4b90-8f2b-37851088e71b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:cb1ecce1-04ea-4b90-8f2b-37851088e71b
#, fuzzy
msgctxt "hc9d5dbe4gd618g46f4gaefdgd611587b7c97"
msgid "I cannot wait until your next act of shameless barbarity."
msgstr "주인님의 파렴치한 야만 행위가 나타날 다음 번까지 기대하고 있겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = cedb25a1-eda1-2be9-b9d0-7aaacda6262b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:cedb25a1-eda1-2be9-b9d0-7aaacda6262b
msgctxt "h5c4e1316g1c05g4b54gb6d3g89c4918579c1"
msgid "Not likely. I am already disgusted at myself for killing her."
msgstr "그럴 리가 없어. 난 이미 그녀를 죽인 내 자신이 역겨우니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = cf8122c9-cd1e-136b-1aa4-9837363a71da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:cf8122c9-cd1e-136b-1aa4-9837363a71da
msgctxt "h24d72decg7bafg41bbgb743gb9d1a7c0c2b9"
msgid "That's insane. Of course I wasn't going to kill her!"
msgstr "그건 말도 안 돼. 난 그녀를 죽이려 하지 않았어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = dad145e3-8450-a4f1-9575-9f0c451d0b16
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_GiveReward(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:dad145e3-8450-a4f1-9575-9f0c451d0b16
msgctxt "h24b07e6fg044dg4e08gaa5cg0d9d0a868556"
msgid "Anyways, I come once again bearing a part of your dreadful inheritance."
msgstr "어쨌든, 저는 다시 한번 주인님의 끔찍한 유산의 일부를 짊어지고 왔습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = db7a41e6-05f5-ee5b-d8e8-6e19e85c587b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - ORI_Avatar_DarkUrge.ButlerAppearance_FailedBard(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:db7a41e6-05f5-ee5b-d8e8-6e19e85c587b
msgctxt "h52431ae4ga0feg4483g8615g7eaa1b3303eb"
msgid "*How many lives did you ruin already, before the crash?*"
msgstr "*추락하기 이전에는 얼마나 많은 생명을 파멸로 이끌었을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = dd32f8c3-042f-6607-a708-4f8f49e2f989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:dd32f8c3-042f-6607-a708-4f8f49e2f989
msgctxt "h092c5c9bgeb74g4b07g8d9cgdf764559b5a7"
msgid ""
"Ah, I can tell Master's mind has experienced a bit of treacle since last we "
"met."
msgstr "아, 저는 주인님의 마음이 마지막 만남 이후로 약간의 어려움을 겪었다는 걸 알 수 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Narrator
#. NodeID = e08541ad-00c2-6409-29bc-38dcdc83bb78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:e08541ad-00c2-6409-29bc-38dcdc83bb78
msgctxt "h853c3ec9gecc1g432eg9755gdb9eef76497d"
msgid ""
"*Your body barely complies; you feel such rushes from your thoughts of the "
"dead woman.*"
msgstr "*몸이 말을 듣지 않습니다; 죽은 여자에 대한 생각을 품을 때마다 강렬한 감각이 몸을 감쌉니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = e39ba156-fbf6-c6a3-1d70-0cf3ede139f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:e39ba156-fbf6-c6a3-1d70-0cf3ede139f8
#, fuzzy
msgctxt "h66e98e33g55edg47c1g94fdgba0b570fb057"
msgid ""
"It seems you've become quite the exhibitionist without me. I can only "
"congratulate you on your indecency."
msgstr "제가 없는 동안 주인님이 노출증을 가지신 모양이군요. 주인님의 외설적 행위에 대해 축하드릴 수 밖에 없겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = e3f34844-7ba5-d2f0-417a-c08c68bb9bc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:e3f34844-7ba5-d2f0-417a-c08c68bb9bc5
msgctxt "h232dd179ge18eg4de4ga3cag517931bbad1a"
msgid "My head is sick, very sick. Do you know about it?<i></i>"
msgstr "머리가 너무 아파. 대체 어째서지?<i></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = e7de0b77-32d4-512e-cace-a6a5954bcade
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:e7de0b77-32d4-512e-cace-a6a5954bcade
msgctxt "h1b801c02gf0e0g4555g8924g06543b092a76"
msgid "My lordly reprobate! I missed you ever-so."
msgstr "나의 사악한 주인님! 정말 보고 싶었답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = e866abcd-5e22-d12c-fd9a-a9a0cf9ce624
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:e866abcd-5e22-d12c-fd9a-a9a0cf9ce624
msgctxt "h639d7335gafcfg4812ga32bge097ba56fa7e"
msgid ""
"Rotted One? Pardon? I don't wish to overstep myself in saying so, but you "
"seem rather not yourself."
msgstr "부패한 자여, 뭐라고 하셨습니까? 지나친 말은 하고 싶지 않지만, 주인님 본인 같지가 않네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Player
#. NodeID = fe88373f-552a-8124-0786-bf54ec372ea1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:fe88373f-552a-8124-0786-bf54ec372ea1
msgctxt "h86435f9agdf51g4b62gbbd3g3bd63a48b59d"
msgid "About damned time someone respected my godlike depravity!"
msgstr "드디어 누군가 나의 신성한 타락을 존중해 주는 구나!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD
#. Speaker = Sceleritas Fel
#. NodeID = ff990bcb-93ef-2f7b-1993-56cd05970cd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_ButlerIntro_SD:ff990bcb-93ef-2f7b-1993-56cd05970cd4
#, fuzzy
msgctxt "h3e8e4ef5gbd5eg408cg96fcgf36c84ded7b1"
msgid "Your flayed and putrefied heart. Thump. Thump."
msgstr "주인님의 벗겨지고 또 곪아버린 심장 말이에요. 쿵. 쿵."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 006693cf-0acd-9e77-d93f-006470602380
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:006693cf-0acd-9e77-d93f-006470602380
msgctxt "he5d3e94fg6f28g4870g86b2ga4a5044d2136"
msgid "Isobel: the cleric with the sweetest face of the Moon."
msgstr "이소벨. 마치 달처럼 순진무구한 얼굴을 한 클레릭 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 013ac3a4-44f6-bba4-80b8-b5240ef7f8f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:013ac3a4-44f6-bba4-80b8-b5240ef7f8f8
msgctxt "h3efac197ga3acg458eg9d2bg099f06fd667a"
msgid "Enough, I'll do it."
msgstr "그만하면 됐어. 할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 01fe63c4-e02e-f4ae-5f77-bb96190fd05a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:01fe63c4-e02e-f4ae-5f77-bb96190fd05a
msgctxt "h240fe5b1g8488g48dag8161g7322c4d4d072"
msgid ""
"Hope you don't mind - I know you always told me not to stand too close to "
"art when it's on display."
msgstr ""
"주인님 심기를 거스르는 일은 아니었으면 좋겠군요. 주인님이 예술 작품을 전시해 놓은 자리에 너무 가까이 가지 말라고 항상 당부하셨던 것은 "
"아직 기억하고 있답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 06bffc93-854d-1278-107c-cdeb031862a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:06bffc93-854d-1278-107c-cdeb031862a4
msgctxt "h9a4c4bd0g822eg42d4g9a57g3039fa5846c4"
msgid "Haven't I done enough killing already?"
msgstr "이만하면 살육은 넘치게 벌이지 않았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 06d90c3b-7086-59bc-9e4b-12702a43df76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:06d90c3b-7086-59bc-9e4b-12702a43df76
msgctxt "hc9139506g196ag4ed6ga1c9gae0205d73eb7"
msgid ""
"But I cannot grant you this prize quite yet. You must do something divinely "
"<i>unspeakable </i>first."
msgstr ""
"그렇지만 아직은 주인님께 이 포상을 드릴 수가 없습니다. 이걸 받으시려면 먼저 불경스럽고도 <i>형언할 수조차 없는</i> 짓을 먼저 "
"저지르셔야 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 07ffd30b-143a-7218-4f05-787ba8372437
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:07ffd30b-143a-7218-4f05-787ba8372437
msgctxt "h1caa94b6gd501g4a10g93f3geffca2e42fb3"
msgid "I come here, for I wish to bring you a powerful tithe."
msgstr "저는 주인님께 강력한 공물을 드리고 싶어 여기 온 것이랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 0be4109e-a4fd-0a6f-980b-ff631c63f484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:0be4109e-a4fd-0a6f-980b-ff631c63f484
msgctxt "hfd249528g622eg4d50ga1dagdf6617aaee6c"
msgid "The killing is good enough fun even without a reward!"
msgstr "누군가를 죽이는 건 포상이 주어지지 않더라도 충분히 재밌는 일인걸!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1044da1e-6200-89c8-6ae7-84fc538fb648
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:1044da1e-6200-89c8-6ae7-84fc538fb648
msgctxt "hd2a7eabag105bg4e07g9174g9b438ff034b3"
msgid ""
"No catch at all. You will get to see the beautiful sight of an entire "
"village filled with bodies."
msgstr "그런 것은 일절 없습니다요. 해내시면 온 마을 사람이 죽어 시체로 나자빠진 아름다운 광경을 보실 수 있을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 14bd6b8f-8f2a-957d-1651-e71afb47bcee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_HAV_TakingIsobel_HasMet_BriefInRoom(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:14bd6b8f-8f2a-957d-1651-e71afb47bcee
msgctxt "h7fce3774gde36g4b04g9282g48bffb344189"
msgid "I'm not going to kill Isobel! Last Light is doomed without her."
msgstr "난 이소벨을 죽이지는 않을 거야! 이소벨 없이는 최후의 빛 여관 사람들이 몰살당한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 1e69b8dc-22e7-9133-6ee4-df1d9f80642c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:1e69b8dc-22e7-9133-6ee4-df1d9f80642c
msgctxt "h553551afg9613g44d7gadaegd3297c9be842"
msgid "I'm not doing a thing you say! This isn't who I am."
msgstr "난 네가 시키는 것 따위는 무엇도 하지 않아! 이건 진짜 내가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 276ebf3a-7383-c05e-9381-bd4de2b5a4e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:276ebf3a-7383-c05e-9381-bd4de2b5a4e7
msgctxt "h64063fb7gabb8g49ffga4dbgedd46c03c394"
msgid "I love you so dearly, Master."
msgstr "저는 주인님을 몹시도 사랑한답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 29cd2969-93b3-582e-ebce-f2bb0eac1b48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:29cd2969-93b3-582e-ebce-f2bb0eac1b48
msgctxt "h3bb0b438ge83ag4b9egb3deg9d8332cb6f51"
msgid "One with the sweetest face of the moon."
msgstr "흡사 달처럼 몹시도 순진무구한 얼굴을 지닌 이자 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2ec1fb4e-bb66-af2d-3da5-1d4d7a78c9ca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:2ec1fb4e-bb66-af2d-3da5-1d4d7a78c9ca
msgctxt "hbb0c38dfg941bg4fa6ga1e5g6fa92cd16024"
msgid "You called for me, Milord?"
msgstr "부르셨습니까, 나리?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2ec1fb4e-bb66-af2d-3da5-1d4d7a78c9ca
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:2ec1fb4e-bb66-af2d-3da5-1d4d7a78c9ca
msgctxt "he5e688acgf8dbg4cebgb8a4gd693507063fc"
msgid "You called for me, Milady?"
msgstr "부르셨습니까, 나리?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2ec1fb4e-bb66-af2d-3da5-1d4d7a78c9ca
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:2ec1fb4e-bb66-af2d-3da5-1d4d7a78c9ca
msgctxt "h7df5807fgd37fg4dd2ga56dg47d0072ac2f9"
msgid "You called for me, Master?"
msgstr "부르셨습니까, 나리?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 30c175ab-0b18-cd1c-673c-61114a577391
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:30c175ab-0b18-cd1c-673c-61114a577391
msgctxt "h7718aff0gcd8bg4b38gbd96g0a72b9794682"
msgid "Should be no trouble."
msgstr "간단히 해치울 수 있는 일이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 34943b0e-c95c-31e7-b4b6-be3ca449f498
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:34943b0e-c95c-31e7-b4b6-be3ca449f498
msgctxt "hdb8d38f9g9b1cg4de0g80c6gf0706f6d3329"
msgid "You're insufferable, wretch."
msgstr "정말이지 참아줄 수가 없구나, 이 비열한 놈아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 429e172d-8a0c-584d-054e-547c21d575a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:429e172d-8a0c-584d-054e-547c21d575a3
msgctxt "h307635afgaa3cg49e2gbac8g40026f3d6a44"
msgid "What has she done to deserve such a fate?"
msgstr "이 사람이 무슨 짓을 했기에 죽어야 한다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 48d27b07-28e9-9354-064b-4f2e5af33f75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:48d27b07-28e9-9354-064b-4f2e5af33f75
msgctxt "h5c4068f7g697ag4b45gb7b9ge29e5ca2af12"
msgid "I won't let myself touch another innocent."
msgstr "또 다시 무고한 이를 손대는 짓은 절대 하지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 4d992c89-0ecf-1f4e-fa53-a64816b07e00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:4d992c89-0ecf-1f4e-fa53-a64816b07e00
msgctxt "h38fbf950g54c5g479egba91gac0e20de669e"
msgid "Perhaps once, but not now."
msgstr "한때는 그랬을지 몰라도, 이제는 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 504097ed-0334-5109-6ae4-85ec2a51276c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:504097ed-0334-5109-6ae4-85ec2a51276c
msgctxt "hc02ab079ga0e8g439agb4a4g14a555ed12c5"
msgid "<i>Give in to the rush of joy that courses through you.</i>"
msgstr "<i>자신 안에 넘쳐 흐르는 쾌락에 굴복한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 5248dd77-5449-acea-0dc1-4f222d12dfed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:5248dd77-5449-acea-0dc1-4f222d12dfed
msgctxt "h8fee579dg4cadg44b4ga339g44851b489c0b"
msgid ""
"The reward will titillate your twitching Urge, in preparation for the rest "
"of your inheritance to come."
msgstr "나머지 유산을 물려받으실 때를 예비해서, 제가 드리는 이 상이면 주인님의 꿈틀거리는 충동이 기분 좋은 자극을 받을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 53328afc-f617-2e87-c1e6-c3147d24fa10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:53328afc-f617-2e87-c1e6-c3147d24fa10
msgctxt "h24bd1cceg583bg46ffgbbb6gcea08476ad48"
msgid "I don't need to. They are all the same."
msgstr "그럴 필요가 없지요. 주인님이 생각하시는 것은 언제나 같으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 549e05f8-7aae-3e4b-cef8-ea2a267a8a32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:549e05f8-7aae-3e4b-cef8-ea2a267a8a32
msgctxt "hc242c62bgf9d5g4ac5gbf2dg5fab7089828c"
msgid ""
"Although I must apologise: dinner is nowhere near ready tonight. For we are "
"far behind on our murder schedule."
msgstr "물론 안타깝게도 오늘 밤에는 저녁상을 올릴 수 없으니 사과 말씀을 드려야겠군요. 예정된 살인 일정을 한참 지나고 말았으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 55b25996-f83a-f001-67da-eb607b52a903
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:55b25996-f83a-f001-67da-eb607b52a903
msgctxt "h55fdc378ga188g444cgbbcbgaccd412001e8"
msgid "A prize?"
msgstr "포상이라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 55e10237-d1ae-d4d5-06ab-2eb8ee205dbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:55e10237-d1ae-d4d5-06ab-2eb8ee205dbe
msgctxt "h8e911227gdaaag41d4ga005g095eb86c66e7"
msgid ""
"I'm sure you will breeze through these trivial little exams with great "
"distinction."
msgstr "저는 주인님께서 이런 사소한 시험 같은 것은 아주 우수하게 통과하실 것이라 믿는답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 589f7364-1a79-2895-8e5a-417dea3fa1ca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:589f7364-1a79-2895-8e5a-417dea3fa1ca
msgctxt "hf9633fe6g24eeg4174g80d7gdbc6b89a316e"
msgid "Be true to yourself, my Lord."
msgstr "본성에 충실하세요, 주인님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 589f7364-1a79-2895-8e5a-417dea3fa1ca
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:589f7364-1a79-2895-8e5a-417dea3fa1ca
msgctxt "haf73684eg7014g4a83ga8dbg9bad18dea194"
msgid "Be true to yourself, my Lady."
msgstr "본성에 충실하세요, 주인님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 589f7364-1a79-2895-8e5a-417dea3fa1ca
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:589f7364-1a79-2895-8e5a-417dea3fa1ca
msgctxt "h50c3a8d9ga92ag4bfagb059g617ad2032b4d"
msgid "Be true to yourself, Master."
msgstr "본성에 충실하세요, 주인님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 5c629712-80df-5520-ea69-27b1eb091687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:5c629712-80df-5520-ea69-27b1eb091687
msgctxt "he3b56354gfc1fg4fd3gac9eg7168b55e74c5"
msgid "Go away!"
msgstr "저리 꺼져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 6c77108c-2e64-e898-8a0a-774e4140ab18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:6c77108c-2e64-e898-8a0a-774e4140ab18
msgctxt "h6fb9d211gf93dg47f6ga37dg0dea828fcb87"
msgid "<i>Shriek.</i>"
msgstr "<i>비명을 지른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 75849fad-9e5c-5138-3036-4c0d0718021a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:75849fad-9e5c-5138-3036-4c0d0718021a
msgctxt "h32b4ef76g4c22g46a1gb13dgb1751621792e"
msgid "Oh, you are such an eloquent and well-mannered Master."
msgstr "아이고, 우리 주인님은 어쩜 이리 말씀도 잘 하시고 행실도 바르실까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7ba3a5e5-e422-8d72-c01c-d0ad6d9ea301
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:7ba3a5e5-e422-8d72-c01c-d0ad6d9ea301
msgctxt "h21dd2786ga5cag4359g9010g3e51c1911a5b"
msgid "Why, the greatest crime of them all: nothing at all!"
msgstr "그야 물론, 세상에서 가장 질이 나쁜 죄악을 저질렀지요. 아무 죄도 없다는 것 말입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7f22c3c1-7bb3-5d6c-8922-c8dcc648253b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:7f22c3c1-7bb3-5d6c-8922-c8dcc648253b
msgctxt "h2a7c9581g11c8g46bega6a2g3570d91f5ea1"
msgid "I come here, for I wish to bring you another powerful tithe."
msgstr "저는 주인님께 또 다른 강력한 공물을 드리고 싶어 여기 온 것이랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 89039475-e4cf-31f0-4816-b102d3d9d843
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:89039475-e4cf-31f0-4816-b102d3d9d843
msgctxt "h81ef0c15g303eg41a5g9091gfe9288399346"
msgid ""
"Oh Master, consider the tiny mishap with the bard you had the last time we "
"met."
msgstr "아, 주인님. 지난번에 우리가 만났을 때 그 바드와 있었던 사소한 불상사를 떠올려 보세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8e1dbdda-76d1-d815-3d9d-3f4bc8ed3f52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:8e1dbdda-76d1-d815-3d9d-3f4bc8ed3f52
msgctxt "h053d7f34g9cffg41b4g8e97g2064390c3963"
msgid ""
"I arranged a perfect crime for you: the sweet little girl Alfira was to "
"place herself in your knife's way."
msgstr "저는 주인님이 만끽하실 수 있게끔 살육판을 마련해 두었답니다. 그 예쁘장하고 귀여운 알피라 계집이 주인님 손에 죽게끔 말이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 8ea2f7cb-238b-1762-6963-d9651675fbd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:8ea2f7cb-238b-1762-6963-d9651675fbd2
msgctxt "hec46c5e7g1ff9g42a2g8a66g4907af3d02cc"
msgid ""
"Stop talking as if you're brewing me a cup of tea! We're talking about real "
"people!"
msgstr "그걸 무슨 차 한 잔 우리는 일인 양 아무렇지 않게 말하지 마! 진짜 사람들 목숨이 걸린 일이잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 975507c2-e107-3b5a-391b-4f8f3adec656
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#.      - NIGHT_DarkUrge_ButlerIntro = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:975507c2-e107-3b5a-391b-4f8f3adec656
msgctxt "h1e63b7e1g4387g446cg9869g5ad954f54737"
msgid ""
"Good evening, Master! Oh, I am inundated with relief, having finally found "
"your vile self."
msgstr "좋은 밤이군요, 주인님! 아아, 마침내 사악한 주인님을 찾게 되어서 이 얼마나 안도감이 드는지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = 986b616e-755e-b1ff-e4b4-d9d92f36bad1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:986b616e-755e-b1ff-e4b4-d9d92f36bad1
msgctxt "h5d88cc8bg57edg4185ga71ag407cb3a70523"
msgid "I was just lying here wishing you <i>wouldn't </i>come back."
msgstr "난 여기 누워서 네가 돌아오지 <i>않기만을</i> 바라고 있었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9927a010-7a7b-9fc4-851c-0d4cc832dff7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:9927a010-7a7b-9fc4-851c-0d4cc832dff7
msgctxt "h277d4ef1g3ee5g4d92ga01dg4410535a09bb"
msgid "She is too precious to live."
msgstr "이 여자는 세상에 살아 있기에는 지나치게 귀여운 존재예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9e868b89-a6b0-bf13-fd4f-c58cf4f8969a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:9e868b89-a6b0-bf13-fd4f-c58cf4f8969a
msgctxt "hd2b8167dgccf1g4cd2g8c3fg68898e19f461"
msgid ""
"You adore piles of bodies, Master. They have always been your favourite."
msgstr "주인님께서는 송장 무더기를 참으로 좋아하시지 않습니까. 그걸 무엇보다도 사랑하셨지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = a02a4101-d33a-65d8-febb-1ebbf8bfead5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Knows_KillIsobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:a02a4101-d33a-65d8-febb-1ebbf8bfead5
msgctxt "h0cbc56e5g1c16g408agbdfeg97ba94895204"
msgid "You will receive a royal prize for killing this pretty girl."
msgstr "이 아리따운 여인을 죽이시면 훌륭한 보상을 받으실 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = a154e2aa-c00b-98d1-bb71-7d8d7b46f15c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:a154e2aa-c00b-98d1-bb71-7d8d7b46f15c
msgctxt "h9e58dde2g804dg4072g9dc0g47a0615dfa0a"
msgid "Good, dear tainted one. Good."
msgstr "바로 그겁니다, 경애하는 더럽혀진 분이여. 잘 하셨습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = a1593b00-76aa-67b8-86f2-98ec695e9ebb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:a1593b00-76aa-67b8-86f2-98ec695e9ebb
msgctxt "h4785b699ge7b2g41f6ga3ddgfd019d7e8889"
msgid "What do you mean you're my <i>Butler</i>?!"
msgstr "네가 나의 <i>집사라니</i> 그게 무슨 뜻이야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = a5e2dbda-5ccc-13c9-47d6-b1921c327ec4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = False
#.      - NIGHT_DarkUrge_ButlerIntro = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:a5e2dbda-5ccc-13c9-47d6-b1921c327ec4
msgctxt "heb355384g77eeg4210g8b44ga11f290945d0"
msgid ""
"Good evening, Master! I'm ever-relieved to have found you at last, for "
"you've been shirking your duties!"
msgstr "좋은 밤입니다, 주인님! 마침내 주인님을 찾아서 얼마나 안도감이 드는지요. 그간 피둥피둥 게으름을 피우고 계셨으니 말입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = acd2e5dc-c785-dd5e-d0be-47b46347bebb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:acd2e5dc-c785-dd5e-d0be-47b46347bebb
msgctxt "h166dea17g01dcg42dcg9c82ge830df08a515"
msgid ""
"There is but one thing on your mind. And it won't go away, until your "
"thirsty Urge is sated."
msgstr ""
"주인님의 마음 속에는 오로지 하나만이 깃들어 있답니다. 그리고 그건 주인님의 목 마른 충동이 채워지기 전에는 절대 가시지 않는 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = ad2266b8-d61a-8226-b723-70d420cc6d13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:ad2266b8-d61a-8226-b723-70d420cc6d13
msgctxt "h680f6a82g9e1dg4dffgbb9bg77110b9bb9d6"
msgid "What must I do?"
msgstr "내가 뭘 해야 한다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = b0a7246f-591a-dc7e-4eb5-1b264e797ede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:b0a7246f-591a-dc7e-4eb5-1b264e797ede
msgctxt "h721eaf86gb44bg4beega521g4e150557a3cd"
msgid ""
"Perhaps you have failed to consider all the piles of bodies that will fill "
"the village?"
msgstr "혹시 온 마을에 시체 무더기가 가득 쌓일 거란 점을 미처 헤아리지 못하고 그런 말씀을 하는 건 아니십니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Narrator
#. NodeID = b308c3b3-37ab-4ffc-9e25-9e724e405ef0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:b308c3b3-37ab-4ffc-9e25-9e724e405ef0
msgctxt "he2f10f5dgb102g41e9ga963g14d152cac215"
msgid ""
"*Your thoughts are back on the twisted Sceleritas and his honeyed words of "
"violence.*"
msgstr "*또다시 뒤틀린 스켈레리타스와 놈이 속삭이는 달콤한 폭력에 대한 생각이 떠오릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = b6a3e7fc-2546-9aeb-c4a7-8faa4da7317f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:b6a3e7fc-2546-9aeb-c4a7-8faa4da7317f
msgctxt "h685d1d4ag7cbfg469bga9fbgd061da943945"
msgid ""
"Although, after I found the bard's body, I was waylaid. Awestruck, I sat, "
"admiring the work night and day."
msgstr "물론, 그 바드의 시체를 찾았을 때 저는 예상치 못한 경외감에 휩싸였답니다. 앉아서 밤낮으로 주인님의 업적에 탄복했지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = b721c7c1-019f-2eb0-fdf9-82607432aabf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:b721c7c1-019f-2eb0-fdf9-82607432aabf
msgctxt "hd7fb1f5dg3f36g43beg84e2g98241ea29416"
msgid "Fear not. Her death will fill an entire village with piles of bodies."
msgstr "거리끼실 것 없습니다. 이자가 죽으면 온 마을이 통째로 송장 천지가 될 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = b9a893d4-c877-9c15-d8f5-ce66a1a0b0d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:b9a893d4-c877-9c15-d8f5-ce66a1a0b0d7
msgctxt "hb31fc3f1gc0f3g419agb6d8g0c596738309e"
msgid ""
"But I saved the gall bladder as a memento of your talent. It's tucked safely "
"inside my breast pocket."
msgstr "주인님의 재능을 되새길 기념품 삼고자 쓸개는 남겨두었답니다. 저의 웃옷 주머니에 안전히 담아 두었지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = be3b90b7-b395-d4eb-513f-79ec8d4ed727
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:be3b90b7-b395-d4eb-513f-79ec8d4ed727
msgctxt "h2c4d3133g6206g437dgb911g1f7579391dd3"
msgid "I only live to advise."
msgstr "저는 그저 주인님께 조언하려는 것뿐이랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = c1de483d-617b-3644-e7ed-ddda89df3f6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:c1de483d-617b-3644-e7ed-ddda89df3f6d
msgctxt "h1f77f360gf71eg4805g98f3g7917fcb34188"
msgid ""
"You are such a pleasure to serve! Of course, you are killing for yourself."
msgstr "과연 섬길 가치가 있는 주인님이십니다! 그야 물론, 주인님은 자신을 위해서 살육을 행하시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = c74cf012-0481-de5a-4a39-bea69a905c72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:c74cf012-0481-de5a-4a39-bea69a905c72
msgctxt "ha0d038e6gd032g4f99ga856g7e02620b96e5"
msgid "Hells! Can you read my thoughts?"
msgstr "세상에! 내 생각을 읽을 수 있기라도 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = c8e8d01a-6504-298e-d3d0-c3fd476200da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:c8e8d01a-6504-298e-d3d0-c3fd476200da
msgctxt "h39d73adag2d8dg4dc1g99d1ga4f68fa8a5be"
msgid "Your unconscious, clever mind hungers for extreme violence."
msgstr "주인님의 영민한 정신은 의식을 잃은 상태에서도 극렬한 폭력을 갈망한답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = c9e01a52-0a02-7658-fb35-abed34edf9d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:c9e01a52-0a02-7658-fb35-abed34edf9d6
msgctxt "h0928050ag495cg41ddgab37g9475659dda5c"
msgid "It has been too long since you venerated me. You're slipping."
msgstr "네가 날 숭배하러 찾아온 지도 꽤 되었는데 말이지. 게으름을 피우는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = cc648f5c-228a-e5eb-0f25-d8273ba94a44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:cc648f5c-228a-e5eb-0f25-d8273ba94a44
msgctxt "hd13a800cg8e44g44ccgba38gbdec08fae355"
msgid ""
"Ssh. Ssh. Quiet, dear depraved one. We wouldn't want to wake the others. "
"They would be so jealous."
msgstr "쉬. 쉬잇. 조용히 하소서, 타락하신 존재여. 다른 이들이 깨어나는 건 피해야지요. 그자들이 질투할 게 뻔하지 않습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = cf5a8db7-ce65-6d5a-594e-9b64b6220d8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:cf5a8db7-ce65-6d5a-594e-9b64b6220d8d
msgctxt "he5cf4c7fg864fg48a5g9976g10cd11afa7b5"
msgid "You have been a prodigal young Master."
msgstr "젊으신 주인님께서 몹시 방탕해지셨군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = cfdfcd8b-42fa-5218-d8fb-379ded508b1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_MurderOfAlfira = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:cfdfcd8b-42fa-5218-d8fb-379ded508b1f
msgctxt "hf23a3478g6486g4d7fg951agea416805619f"
msgid ""
"A fine fellow of your gruelling station must continue to show the innocent "
"masses what-for."
msgstr "주인님처럼 무시무시한 지위를 지닌 훌륭하신 분이라면 무고한 아랫것들에게 자신의 목적을 상기시켜 주셔야 하는 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = d1d05734-a581-99a7-52c5-27a07d1351a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:d1d05734-a581-99a7-52c5-27a07d1351a8
msgctxt "hd14adf5cg2095g4bf8gbb6cgf4c743439012"
msgid "Who knows who you might kill next if you do not satisfy your Urge?"
msgstr "주인님의 그 충동을 채우지 못하면 다음번에는 누가 죽어나갈지 어찌 알겠습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = dde6fdbd-bde9-2cd1-7907-be1b22f1f19f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:dde6fdbd-bde9-2cd1-7907-be1b22f1f19f
msgctxt "hf52d15ccg67bdg4ef4ga2ccg655093d3fa5d"
msgid ""
"But you have not been disinherited yet. You can rule with such ease, if you "
"follow your call."
msgstr "그렇지만 주인님은 아직 유산을 물려받으실 수 있답니다. 주인님의 소명을 따르기만 한다면 손쉽게 만물을 지배하실 수 있으세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = e56495da-1b1a-c289-69b5-4b4517fea5dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:e56495da-1b1a-c289-69b5-4b4517fea5dc
msgctxt "h42324870gc155g4973ga428g243fec4f3952"
msgid ""
"Those words sting, though they are true. I vow I will say your name a "
"thousand times in prayer before I rest tonight."
msgstr ""
"모질기 그지없는 말씀입니다만, 분명 사실을 말씀하십니다. 오늘 밤 잠들기 전에 주인님의 이름을 천 번 거듭해 올리며 경배하겠다고 "
"약속하나이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = ea461134-67a1-527f-fb9f-b66fc9212c5c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:ea461134-67a1-527f-fb9f-b66fc9212c5c
msgctxt "h097cc151g5ed6g47ccgb393ged8700cb24c5"
msgid ""
"Oh! My nauseating Lord! Such rudeness is unbecoming of your august station."
msgstr "아! 밉살스런 주군이시여! 주인님처럼 존귀한 분께서 그렇게 불손하게 구셔서야 어디 되겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = ea461134-67a1-527f-fb9f-b66fc9212c5c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:ea461134-67a1-527f-fb9f-b66fc9212c5c
msgctxt "h7e375383gc945g4f79g8047g47ed6ccc6060"
msgid ""
"Oh! My nauseating Lady! Such rudeness is unbecoming of your august station."
msgstr "아! 밉살스런 주군이시여! 주인님처럼 존귀한 분께서 그렇게 불손하게 구셔서야 어디 되겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = ea461134-67a1-527f-fb9f-b66fc9212c5c
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:ea461134-67a1-527f-fb9f-b66fc9212c5c
msgctxt "h13b9d3a9g1428g425dga417g0027bb6a53dc"
msgid ""
"Oh! My nauseating Master! Such rudeness is unbecoming of your august station."
msgstr "아! 밉살스런 주군이시여! 주인님처럼 존귀한 분께서 그렇게 불손하게 구셔서야 어디 되겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = eb725361-ca65-9f7e-32a2-09d5fb37af60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:eb725361-ca65-9f7e-32a2-09d5fb37af60
msgctxt "h5cb93f65gfd96g4c96ga3baga52869cb68c1"
msgid "I might be willing. Is there a catch?"
msgstr "구미가 당기는 것 같기도 해. 혹시 뭔가 안 좋은 점이 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = ebe29f60-6efd-b307-7256-b93e4fe07903
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:ebe29f60-6efd-b307-7256-b93e4fe07903
msgctxt "h62711c23g09dag431bg9b46g80043313a12b"
msgid ""
"But ooh, poor itching one, your little indisposition has made you absent-"
"minded indeed if you didn't notice."
msgstr ""
"그렇지만 아아, 불우하게도 갈망에 애타는 분이시여. 알고 계셨는지는 모르지만, 사소한 싫증 때문에 실로 멍하니 넋을 잃고만 계시더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = f061d546-aa76-3c17-f0ef-f755ac0b1194
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:f061d546-aa76-3c17-f0ef-f755ac0b1194
msgctxt "h48ab6c09gb3fbg467eg8099gde7c9ed1fc43"
msgid "I kill for myself, not because you command me."
msgstr "나는 나 자신을 위해서 죽이는 거지, 네가 명령해서 그러는 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = f1772be4-11c0-d0b5-4aae-9d4d4c1dd60f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:f1772be4-11c0-d0b5-4aae-9d4d4c1dd60f
msgctxt "hbf42385cg4cefg4c63gb58fg07eff9aa0cec"
msgid ""
"From coast to coast, our realm only exists for you to play with, after all."
msgstr "애당초, 해안을 따라 펼쳐진 우리네 세상은 결국 주인님의 놀이터 노릇을 하기 위해 존재하는 것이 아니겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = fcb13b95-aa4b-d46b-f827-782eab36396f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:fcb13b95-aa4b-d46b-f827-782eab36396f
msgctxt "h8681738cg5dabg4a0bg8c98g3fc1672df99b"
msgid ""
"I also tend to your grounds, manage your estate, arrange murder victims for "
"you to systematically brutalise, and serve dinner."
msgstr ""
"저는 집사 노릇을 하면서 주인님의 터전도 보살피고, 영지도 관리하고, 주인님께서 체계적으로 잔악무도하게 살인을 벌이실 수 있게 피해자들을 "
"마련하고, 저녁 식사 시중도 든답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Player
#. NodeID = fe16a89d-70b7-fbcc-812d-912afb3e945b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_State_DarkUrge_FeltUrgeBeforeIsobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:fe16a89d-70b7-fbcc-812d-912afb3e945b
msgctxt "h44a8ecbeg59afg42c1g88a0g062c207cc608"
msgid "I felt the desire to kill her so strongly when we met..."
msgstr "이소벨을 만났을 때 그자를 죽여 버리고 싶다는 엄청나게 강렬한 욕망을 느끼기는 했지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD
#. Speaker = Sceleritas Fel
#. NodeID = ffc1c6fe-3dfc-0ed7-7620-0469c9af3898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_IsobelKillOrder_SD:ffc1c6fe-3dfc-0ed7-7620-0469c9af3898
msgctxt "hbe2a3628g738dg4134gbad6g9bf078a7e740"
msgid ""
"Oh, where are my manners - you've forgotten me, haven't you? Sceleritas Fel. "
"Your <i>undyingly </i>loyal Butler."
msgstr ""
"아, 제가 너무 무례했군요. 주인님께서는 저를 잊지 않으셨습니까? 저는 스켈레리타스 펠. 주인님께 <i>불멸의</i> 충절을 바치는 "
"주인님의 집사랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 01574491-02c1-ca86-c346-5980d63a2a1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:01574491-02c1-ca86-c346-5980d63a2a1d
msgctxt "h99f0b29egcc0ag4cbeg9392g3f421475c632"
msgid "I don't want it, it clearly wasn't enough to save me before."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 053e8366-7d47-5940-8e8f-9ab5ab14011a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:053e8366-7d47-5940-8e8f-9ab5ab14011a
msgctxt "h5c8f9ecbgd4c2g43abg85d9gc6955cce3caf"
msgid ""
"Your little indisposition has not been able to get rid of <i>what's on the "
"inside</i>. The evil in your rotten heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 0d5a9799-f719-4ef3-628f-38f60166730d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:0d5a9799-f719-4ef3-628f-38f60166730d
msgctxt "hf5bb61a9gcd20g4f86ga091g8a6a7256f1f6"
msgid "<i>Yawn. You're missing your sleep waiting up for him.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 0e04842c-f87e-3500-0bf8-540512b2504d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_State_SlayerForm(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:0e04842c-f87e-3500-0bf8-540512b2504d
msgctxt "hc8bae2dfg29cag4bc9g86c7ge9d6e8d6ee8d"
msgid "And look at you! Now you're your perfect self again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 11ad79cb-4238-17b1-0b1f-7bfd26857457
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:11ad79cb-4238-17b1-0b1f-7bfd26857457
msgctxt "hb8d3d791gd419g48abg9999g7e4d5098ed6e"
msgid "It's been <i>so long</i> since you last killed me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 122075f8-40c6-5c59-f32c-46e388bff560
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:122075f8-40c6-5c59-f32c-46e388bff560
msgctxt "h36b4122dg3af1g423fgac04gf1f4f9f0af9e"
msgid ""
"Alive again! Sceleritas always comes back. He could never leave his odious "
"liege! "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 150f2c3a-d8b8-4146-c483-67ab4f9c093f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:150f2c3a-d8b8-4146-c483-67ab4f9c093f
msgctxt "hee3a5053gf7a1g4a37g87b5gbdfb3ff8ac6e"
msgid "I hope you will consider killing me in future, Master."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1822647f-3145-f7f6-8609-3a88b9aed5da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:1822647f-3145-f7f6-8609-3a88b9aed5da
msgctxt "hdaf59715g0d3ag4dcagabe8g2bdda8d7a564"
msgid ""
"I was worried when you didn't kill the silly bard I sent for you to play "
"with, but forgive my lack of faith - I only had your best interests at heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 1928c605-28db-10d6-bf9b-b5daff8a0ef7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:1928c605-28db-10d6-bf9b-b5daff8a0ef7
msgctxt "h94d8830cgb9ebg4a10gadcega3c479d3244b"
msgid "<i>Lower your claw.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 1e5c67b4-0d8b-4e17-dbb8-64a2efa438cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:1e5c67b4-0d8b-4e17-dbb8-64a2efa438cb
msgctxt "h7f2a0bc2g4291g4587ga985g7b1f4d19fdee"
msgid "The whole time I was killing... you were watching?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 210d9172-b223-fc64-1c00-ceda1a321b56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:210d9172-b223-fc64-1c00-ceda1a321b56
msgctxt "h9a8d7a55g87fcg48f4g8b51g44dc3606541e"
msgid "How horrible!\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 2518ab1c-da7f-53be-1eab-f9b217e67d65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:2518ab1c-da7f-53be-1eab-f9b217e67d65
msgctxt "h2fbd1f62gc7f2g40aegab0egea0e33e23a8d"
msgid "<i>Snarl.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 25ec4b7f-d462-5a23-cc69-42fc8dd18c20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:25ec4b7f-d462-5a23-cc69-42fc8dd18c20
msgctxt "he223e162g9590g4eb8g8128g19b0ed4e4cd7"
msgid ""
"Don't worry, Master, I will ensure you have a diverse roster of victims from "
"now on. Hapless menfolk deserve death just as much as the girlies."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2693df56-8aa0-b4fd-75bf-0ef0af366fe3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_KilledIsobel_State_KilledIsobelByKillingNightsong = False
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:2693df56-8aa0-b4fd-75bf-0ef0af366fe3
msgctxt "hf3f2ed6bg5a00g432cg9003g148910a914b0"
msgid ""
"I was away admiring her body. I have never seen a torn tibia quite like that!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 274de58a-a923-f3dc-381c-406aaaa0f7ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:274de58a-a923-f3dc-381c-406aaaa0f7ac
msgctxt "he83158aagf4fcg4918g8fc5ge7c966f8dd5d"
msgid ""
"Oh, my itching Liege, it hurts to hear you recall me not! I had indeed heard "
"rumours you had become <i>indisposed</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 29b93019-9989-5368-beaf-318a836f3b27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:29b93019-9989-5368-beaf-318a836f3b27
msgctxt "he6c4f3d8g3295g43b1ga2d9g5e371ac37d2d"
msgid " The cleric and Last Light, all are now but an ichored slagheap."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2ab22e78-8066-9db1-9a9d-37633d704be2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:2ab22e78-8066-9db1-9a9d-37633d704be2
msgctxt "h586153fcgd736g4af3ga902geafee2dc4b07"
msgid ""
"Oh, I rather got carried away there, wherever are my manners? Sceleritas "
"Fel, your <i>undyingly </i>loyal servant, your Butler, before our separation."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2b62e0ef-8ae7-b9dd-a247-1e8bff3157a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = False
#.      - ORI_DarkUrge_Knows_KillIsobel = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:2b62e0ef-8ae7-b9dd-a247-1e8bff3157a3
msgctxt "h6ed218abg2a15g4d71g8dbcgdccdd22c9b99"
msgid ""
"Oh! Bravo! Bravo! You are growing up to be a fine fellow of the most "
"degraded calibre.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2cb9191e-dd7e-7af7-844d-e9f1d9dd3c60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:2cb9191e-dd7e-7af7-844d-e9f1d9dd3c60
msgctxt "hac885fb3ga6b9g4d45gb0efgb3857aeaeb18"
msgid "Kill me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2e87c7a9-2f9e-bd94-9912-00ea1d6d545d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:2e87c7a9-2f9e-bd94-9912-00ea1d6d545d
msgctxt "h1ac4ebbaga809g4d69gb40ag57dc7015c793"
msgid "It sparkles resplendently! I shall be back after your next triumph."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3088a103-ec8f-b610-bad2-b8c549b42537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:3088a103-ec8f-b610-bad2-b8c549b42537
msgctxt "h2a05cf65g753fg4b58g8d1cg5c8864e48bd5"
msgid "Don't be cruel! Don't leave incy wincy Sceleritas on edge like that!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 30ad7393-d070-fbac-86f8-2fc6f69ff9c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:30ad7393-d070-fbac-86f8-2fc6f69ff9c3
msgctxt "ha4b387a9g7cf4g490ag81d7gd0be58d6555a"
msgid "<i>Level Sceleritas.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 32478755-1c00-629b-ec99-a1bdae4643bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:32478755-1c00-629b-ec99-a1bdae4643bd
msgctxt "h0faff17eg0654g43fdg8118g2b6b3a219b93"
msgid "<i>Cock your head in confusion.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3319e66b-06c9-2c3e-837b-e343a0804058
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:3319e66b-06c9-2c3e-837b-e343a0804058
msgctxt "hf2adab2bgcc6dg410bga1b4gba66fb28bde0"
msgid ""
"My crumbs of doubt in you were most unjust. You killed your darling! "
"<i>Encore</i>!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 340367da-7542-bb46-a649-6f31b0451575
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:340367da-7542-bb46-a649-6f31b0451575
msgctxt "h00d093cdg6e74g4795gb3fbgf71cb2ad24a1"
msgid "Sceleritas will ensure you stay in harm's way."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 35595432-2e5f-c5aa-e582-781b77a5919c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:35595432-2e5f-c5aa-e582-781b77a5919c
msgctxt "hfaee7b57ga7d1g409aga74fga3413ec8870c"
msgid "There are endless combinations of moral atrocities ready to be penned."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 431a964d-2513-514a-bc2e-7766af50b826
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:431a964d-2513-514a-bc2e-7766af50b826
msgctxt "h19c8463bg86d9g4d16g944fg910b250d54ca"
msgid "Excellent work with the Cleric, but we are only now getting started."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 473e5e69-e3d1-5ec3-aa57-dc3d23542a59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:473e5e69-e3d1-5ec3-aa57-dc3d23542a59
msgctxt "h32972e01g0a52g46eagb53bg7bbee383b6c3"
msgid "You know who I was, before I lost my memories?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 474e5ec9-09f9-241c-19b6-1029fe7fba25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_SCLMAIN_State_InRegion(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:474e5ec9-09f9-241c-19b6-1029fe7fba25
msgctxt "h17b98445g1dfdg4488g8d69gdbcfa1dcb648"
msgid "Hhhngh."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 5401c4eb-ee3f-7a3b-463a-a95bea77021d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:5401c4eb-ee3f-7a3b-463a-a95bea77021d
msgctxt "h012b34dag1138g429eg8b87g7c84a9a4d65e"
msgid "<i>Swipe at the Butler.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 58431c0e-c99a-4207-b320-85f48280f935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:58431c0e-c99a-4207-b320-85f48280f935
msgctxt "hc0e67234g3878g4648ga92dg83cef346f376"
msgid "I tire of killing, please, let me be free."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 5b2d62c7-10df-cfb7-2340-aa7037ed8296
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:5b2d62c7-10df-cfb7-2340-aa7037ed8296
msgctxt "ha1be3f30gd223g46fcg8b07g80a6f5662917"
msgid "<i>Try to suppress the beast's rage.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 5b4abd70-ee81-821e-ba49-51181d6f9990
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:5b4abd70-ee81-821e-ba49-51181d6f9990
msgctxt "h209ed2eegfd5ag4cd2gbcb1g2d714472cbe1"
msgid ""
"If you ever feel you're losing your spark, I would recommend breaking a few "
"taboos. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 5b66fff0-ba47-0a06-219d-ed1448981bd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:5b66fff0-ba47-0a06-219d-ed1448981bd3
msgctxt "h46f86f97g0e1cg414bg921dgc50dfebac338"
msgid "If it's from my old life, I don't want anything to do with it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 5b7e4f75-3272-a56c-25af-d099354b1cb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:5b7e4f75-3272-a56c-25af-d099354b1cb0
msgctxt "h8bf0d782g67a9g4f62g89d3gda7450dd4cdf"
msgid "But you yearn for the sordid scandal deep down, don't you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 628b5d2b-dc90-9212-3141-814e4dd26d0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:628b5d2b-dc90-9212-3141-814e4dd26d0d
msgctxt "hcf6046dfgab21g4d81g8b50g7d7d26aacdaf"
msgid "There is nothing you can do to me I would not enjoy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 652e94da-7e66-6751-c248-c1a88c4eeab1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:652e94da-7e66-6751-c248-c1a88c4eeab1
msgctxt "h51efc647g303fg4662ga3cfge72af62519d1"
msgid "<i>Focus on your breathing. Release this murderous shape.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 67f7d504-de76-fb42-0bcd-1caa771a7116
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:67f7d504-de76-fb42-0bcd-1caa771a7116
msgctxt "h57c9286eg2224g491bg9c87gf9bd4e724ab7"
msgid "Every death brings a new, brighter, better Sceleritas into this world."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6938e63b-b716-5c9c-b244-18b73329f20f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:6938e63b-b716-5c9c-b244-18b73329f20f
msgctxt "hbc82c280g6619g4ef7ga6f7g05230bbc11dd"
msgid ""
"You would be lost without your Butler, but you shall never be without me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 6961f900-9eaf-831c-0cfe-7f93bc2391b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:6961f900-9eaf-831c-0cfe-7f93bc2391b4
msgctxt "h310473deg8953g4fdcg9aafgd463d92705f8"
msgid "<i>Mourn your deeds. You regret them all.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Narrator
#. NodeID = 6b8dd204-dc21-a709-8a9d-2e7049521d15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:6b8dd204-dc21-a709-8a9d-2e7049521d15
msgctxt "h7bc422d3gebb1g4c7cgaa94gfe6f270d772d"
msgid ""
"*Your kill of your poor friend can only mean one thing. The degraded "
"Sceleritas will be back soon enough.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 6f53516f-c4ee-4979-c916-84ed36402795
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:6f53516f-c4ee-4979-c916-84ed36402795
msgctxt "h7c6dcd48gbf56g4813g8021g369113c30c2e"
msgid "<i>Return to your former form.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6f6a173f-1f45-0398-e866-0cae3647a267
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:6f6a173f-1f45-0398-e866-0cae3647a267
msgctxt "he9d47463g445cg4f02ga427gc2cfac72cba5"
msgid "Thank you. Your claws hit like a kiss."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 708a6e10-ba5f-d34e-cf73-fc0e04537bd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:708a6e10-ba5f-d34e-cf73-fc0e04537bd5
msgctxt "h7b70afe0g4844g4462g80d9g263cf9f52d69"
msgid "<i>Transform back.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 72ba5dad-4cca-59e6-8932-3f6d1b222116
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:72ba5dad-4cca-59e6-8932-3f6d1b222116
msgctxt "hca9e287fg527cg4bb9ga485gd5fe1d59fa89"
msgid "Please. <i>Please</i>. I know you have the iniquity within you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 733d8922-268c-b114-2d40-724f40301f9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:733d8922-268c-b114-2d40-724f40301f9c
msgctxt "h715acea7g3b3fg4707g8ceag8931eea201ca"
msgid ""
"You didn't have it before, but wished for it. I was pained to watch you pine "
"and pine!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 79ea5f89-635c-0a6c-32ec-da653926803b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:79ea5f89-635c-0a6c-32ec-da653926803b
msgctxt "h55a66dfeg808bg4503gac30g1cce9a86719f"
msgid "And there is nothing you can do to thwart yourself. You are perfection."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7bf7d1c0-d4a6-efd9-683d-05f9493e7693
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:7bf7d1c0-d4a6-efd9-683d-05f9493e7693
msgctxt "h593aba28g6b4cg4560g9826gce445b321feb"
msgid ""
"Excellent betrayal the other night! I could not have backstabbed better "
"myself!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 816c3089-f671-3f34-95ad-e947b7fb8b5f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_State_SlayerForm(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:816c3089-f671-3f34-95ad-e947b7fb8b5f
msgctxt "hbf74c64dg1046g482cgba39g2a402f5f1b4d"
msgid "But you should be hopeful for your bright future!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 85aa4f5e-9b19-6b58-f0f6-b9edc19107f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:85aa4f5e-9b19-6b58-f0f6-b9edc19107f2
msgctxt "h17f7a3b4gb043g4143g80ccg09f624285e5f"
msgid "Do not be afraid, my tainted angel."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8631b9dc-4482-67c2-8f13-0c1d88a5f7c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:8631b9dc-4482-67c2-8f13-0c1d88a5f7c9
msgctxt "hec956e44g361eg4f7cg91eegb2857fdc0c86"
msgid "Ooh! Such a strapping young behemoth!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 86925b54-8c66-a9ab-c648-2254f65668da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:86925b54-8c66-a9ab-c648-2254f65668da
msgctxt "h1445fd30g07c3g45f4g99f9g0d658710236f"
msgid ""
"It would damage your reputation if the fearing public thought you a "
"predator. After all, you're far worse than one of those base lusty spree-"
"killers."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8acaf793-e0b5-0970-c4b5-f5c5bfea95c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:8acaf793-e0b5-0970-c4b5-f5c5bfea95c3
msgctxt "h78f146a0g3fc5g4dbfgb325g4c0560f0a22a"
msgid "I shall return when you next have need of me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8ba306d5-9324-adaf-3bf5-907460964971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:8ba306d5-9324-adaf-3bf5-907460964971
msgctxt "h8216c3begfd86g48f4gaf43gaa66ae81ecea"
msgid "Another time, I hope."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8c1d4ec9-2b5d-5625-a051-264ad2c9a555
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:8c1d4ec9-2b5d-5625-a051-264ad2c9a555
msgctxt "hd0ac83f8g177cg463dga355g4265f1598511"
msgid "Your past and future are avowed life-long lovers."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8fca02d9-e7c2-7ce5-2dc5-a3e9faa7fde1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_GivenSlayerForm = True
#.   Object:
#.     - ORI_DarkUrge_State_SlayerForm(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:8fca02d9-e7c2-7ce5-2dc5-a3e9faa7fde1
msgctxt "h577ad6d9g45f6g4becga275g111f739141ce"
msgid ""
"Try on your new jimjams! They're a present from Father, it would be rude not "
"to."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 93a71633-19cf-d574-33b1-a0ab0803c664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:93a71633-19cf-d574-33b1-a0ab0803c664
msgctxt "heb7bb7b4g94ecg4718gba8dg35f9168eeb8d"
msgid ""
"Oh don't say it like that, you're clearly the same-old knife-happy lunatic I "
"have loved ever-long!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 97d1d1a8-da7c-1fdc-faca-b830fdbf37f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:97d1d1a8-da7c-1fdc-faca-b830fdbf37f1
msgctxt "ha9e043f7g7df8g4bb9g90cbg2606c14ec646"
msgid "So handsome, so brazen!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 97f8e7de-f6c4-7d7c-c63b-87caf9e75edf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:97f8e7de-f6c4-7d7c-c63b-87caf9e75edf
msgctxt "he3652ee0g9c33g435dga6a0g199108885dce"
msgid "Mmmm, I have something wonderful for you, dear mouldering Master."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = 9c61c23f-b475-0740-cea3-7f4ffcc5a1a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:9c61c23f-b475-0740-cea3-7f4ffcc5a1a6
msgctxt "h9555af4egce4ag4468gaa16g4ba57ead05b8"
msgid "<i>Drink in your beautiful body.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9f1f6ee6-8667-a8a8-9441-727b1c6dc385
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_DarkUrge_State_SlayerForm(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:9f1f6ee6-8667-a8a8-9441-727b1c6dc385
msgctxt "hcb412d19ge59ag42a1gb892g92468fed2e25"
msgid ""
"I wish I had time to wax your hide and brush your spines, but your adoring "
"Butler must away."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = a2e39667-aa68-a6ec-9d55-5bc96b5eb959
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:a2e39667-aa68-a6ec-9d55-5bc96b5eb959
msgctxt "h53b81441g69f9g4b1ega088g5b79999e84e2"
msgid "No! Don't be sad, Master! I am here to give you a happy present!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Narrator
#. NodeID = a5f6e522-48d8-8519-6f1c-02de2590c7e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_KilledIsobel_State_KilledIsobelByKillingNightsong = True
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:a5f6e522-48d8-8519-6f1c-02de2590c7e2
msgctxt "hbabe16bfgbb51g48fegbf38gbfc5136c1bfb"
msgid ""
"*Your mind is heavy. The devastation of Last Light is sure to pique the "
"interest of the vile Sceleritas.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = a852342c-a733-32a7-9f28-7e2092221501
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:a852342c-a733-32a7-9f28-7e2092221501
msgctxt "h31caac75gaf5fg4687g969agc5190270dd0e"
msgid ""
" Oh, soon enough <i>everyone </i>in the Sword Coast and beyond will know "
"about you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = adf21fc9-e0f5-a13f-9435-12ce6a12078b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:adf21fc9-e0f5-a13f-9435-12ce6a12078b
msgctxt "h137c6638gfac2g4535ga7e8g8fac13493be2"
msgid "Ahh, that was so freshening!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = af8e5f9a-69a5-5cf3-a19a-6759e01b34e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_DarkUrge_State_SlayerForm(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:af8e5f9a-69a5-5cf3-a19a-6759e01b34e2
msgctxt "h92bc96b2g7e4dg4b7dgb46ag2e5b99c8ab10"
msgid ""
"I wish I had been blessed with a few more moments of ogling, but the Slayer "
"will be back soon."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = af96e377-3183-ee1c-56af-f1ef48fe0ba0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - MONK(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:af96e377-3183-ee1c-56af-f1ef48fe0ba0
msgctxt "h278e58a6gee05g4646g9be4g4543e62cc480"
msgid "<i>Force yourself back into your natural form.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = b119c64d-4806-18b2-7e2d-352ea77a67f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:b119c64d-4806-18b2-7e2d-352ea77a67f7
msgctxt "hbf74aa7ag80fdg47a8g816fg41cb12eb2608"
msgid "A part of your past is here for you. I come with your disgusting Prize."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = b4e515ce-8771-cc11-2c0b-a46e622c93bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:b4e515ce-8771-cc11-2c0b-a46e622c93bc
msgctxt "h879995ddga46ag445bgaf7cgcdb59f8f52ac"
msgid "<i>Fret in fear - will you ever be free of him?</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Narrator
#. NodeID = b537029d-b60a-4eeb-96fd-be5a01f8b265
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Event_KillFavouriteCharacter = False
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:b537029d-b60a-4eeb-96fd-be5a01f8b265
msgctxt "h20b71fe7ge78dg4a70g9e5agb87696274fc5"
msgid ""
"*Your kill of that poor cleric can mean only one thing: the vile Sceleritas "
"will be here soon enough.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = b7238fd4-9951-4bd7-b730-4a9b372bc03d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:b7238fd4-9951-4bd7-b730-4a9b372bc03d
msgctxt "h203c0d4fge0efg4f56gbe11gf1dd3507a718"
msgid "<i>Refuse.</i>"
msgstr "<i>거절한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = b9476e39-0dea-ed1e-2a33-ee754909e342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:b9476e39-0dea-ed1e-2a33-ee754909e342
msgctxt "h63f394f1ge553g435ega337g66b9b4bd8930"
msgid "Oh yes."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = ba0adb92-2dd2-75fc-45ea-8c4d5d75097f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:ba0adb92-2dd2-75fc-45ea-8c4d5d75097f
msgctxt "hfd14be0dga5d4g4549g8999gf587083c8d22"
msgid "I'll take your sugary trinket, but my killing comes from pure desire."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = bb5e6fb8-f4bc-d0b5-f9c2-753b552aaae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:bb5e6fb8-f4bc-d0b5-f9c2-753b552aaae7
msgctxt "h6da80216g4bffg480dga77bg8524cf3b8825"
msgid "This Prize is no payment, but a sign of reverence towards you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = bc7a961a-62cd-6964-f6d1-e4a517f411a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:bc7a961a-62cd-6964-f6d1-e4a517f411a8
msgctxt "h6e9163fdg8763g4c70ga023g4c1e67327ab9"
msgid ""
"A bit of infanticide here and a touch of cannibalism there are sure to "
"inspire you again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = c3c76a8b-2a0f-fecd-9227-9237fa1c9861
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:c3c76a8b-2a0f-fecd-9227-9237fa1c9861
msgctxt "hf75b0da9g0653g44e8g9aafgecae69c5c54a"
msgid ""
"I have your estate to attend to, we will meet again there. Good night, sweet "
"Master."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = c3ef4080-bdc4-c4aa-7721-b370e6313397
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_DarkUrge_Knows_ButlerDied(1) = True
#.      - ORI_DarkUrge_Knows_ButlerDiedReaction(1) = False
#. SetFlags:
#.   User:
#.     - ORI_DarkUrge_Knows_ButlerDiedReaction(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:c3ef4080-bdc4-c4aa-7721-b370e6313397
msgctxt "h7005d8b4g4e3bg4294g8244g797fa7c23691"
msgid "<i>Pray that he was defeated in the attack.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = c5f8c77f-0513-2c5f-2b54-0dc118923017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:c5f8c77f-0513-2c5f-2b54-0dc118923017
msgctxt "he8791dfbg6fcdg4fb4g9bd4gde21cc21dcb8"
msgid "Quickly, give it to me. I don't want anyone seeing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = c7b95fe6-8b1e-49a8-0d18-70b3dd4397c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:c7b95fe6-8b1e-49a8-0d18-70b3dd4397c6
msgctxt "hc56cb624ge70eg4d73ga2e4ged3cd4ade0a9"
msgid "Perhaps on my birthday."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Narrator
#. NodeID = c9f90491-0759-2dfe-eac4-af7a4c1c8899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:c9f90491-0759-2dfe-eac4-af7a4c1c8899
msgctxt "h27f359f4g5e8ag4375gaf29gf02998371688"
msgid "*You cannot speak, but you have command over your own cruelty.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = cb4ba675-8a1f-835e-57e9-938ab830bfed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:cb4ba675-8a1f-835e-57e9-938ab830bfed
msgctxt "h52cd27deg29feg4b66gadc7g81d872a42127"
msgid "This form is the Slayer. You will do many naughty feats with it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = cd24cd56-4f2f-dde2-8fde-2bec58374288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:cd24cd56-4f2f-dde2-8fde-2bec58374288
msgctxt "hc6bb89d4g36d9g4fb5g8fa5ge72302be2e6b"
msgid "<i>Tap your foot impatiently, a butler should be on time!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = d466d163-1b73-7094-3109-bc628162bf6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:d466d163-1b73-7094-3109-bc628162bf6e
msgctxt "hcd1c3228g4492g4b2egb10fg87a1f02eccd0"
msgid ""
"And it was all your own work! You didn't even need your Butler's advice: you "
"have acted with the utmost decorum. First the bard, now this triumph! "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = d47fb6ff-cd03-ad6d-6afa-ea97ffd20cf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:d47fb6ff-cd03-ad6d-6afa-ea97ffd20cf2
msgctxt "hc36a1ba2gb115g4f32gb07egaf316867f46a"
msgid "Please, wondrous manslaughterer."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = d9e13a2a-510e-3572-d051-57ca8f75f11b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:d9e13a2a-510e-3572-d051-57ca8f75f11b
msgctxt "hc8034254g5ef6g4903gb280ge53f61694418"
msgid "<i>Fantasise about the dark prize you will soon receive.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = dc620363-07fc-63c1-3c69-e838971c54bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:dc620363-07fc-63c1-3c69-e838971c54bf
msgctxt "ha2276a82g18a2g403cgb5fbg18cf559fc9f6"
msgid "<i>Swipe to crush the Butler.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = dca3bf07-9d4b-a20f-fb3a-dd73ae1f5a2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:dca3bf07-9d4b-a20f-fb3a-dd73ae1f5a2c
msgctxt "hfd8d78deg63f8g4611g99f7g3c9a8c7ba086"
msgid "<i>Panic</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = df58d487-2f1d-ea6c-b25a-45be5436de7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:df58d487-2f1d-ea6c-b25a-45be5436de7d
msgctxt "h1f663546g51afg455ega3e8g1799839ca9e3"
msgid "Or else what, debased one?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = df95ad40-9496-b276-2f74-7533d70fb185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:df95ad40-9496-b276-2f74-7533d70fb185
msgctxt "h35c95fdeg6842g4d9cg8036g3528164d9a0f"
msgid ""
"You are going to kill again soon. You will keep chopping down the "
"Moonmaiden's family tree."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = e0eef322-f167-8371-f447-22c4b1232527
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:e0eef322-f167-8371-f447-22c4b1232527
msgctxt "h0db6d1d2g0198g425agb3a6g35a1ef74aa66"
msgid "You're going to tell me everything about my lineage, or else!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = e4b39d73-7115-4fe9-2188-323a1559ebfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:e4b39d73-7115-4fe9-2188-323a1559ebfd
msgctxt "hb577362egf4d9g4decga61fgcd88941aad45"
msgid "Hhhngh."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = e4ef4837-a6e8-2b6d-859a-8537ef2b23bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:e4ef4837-a6e8-2b6d-859a-8537ef2b23bf
msgctxt "hc76a42e1g1eb9g4b94ga2b3g792c5e623d0b"
msgid "Come closer, my depraved prodigy!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = e557fc8b-964d-79f3-e00c-cbd9c34f9cbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:e557fc8b-964d-79f3-e00c-cbd9c34f9cbc
msgctxt "h1f030b6ag0a51g44ccgb69cg479e0356d83d"
msgid "What in the Hells do you mean, you're my Butler?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = e8668639-a8f9-c162-05ce-d47145bdc824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:e8668639-a8f9-c162-05ce-d47145bdc824
msgctxt "h8155711agff2cg43aag87bcgf4af7332cfcf"
msgid "Glorious! I shall do my best to honour its brutality."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Player
#. NodeID = f4f24734-f47a-125b-1587-99b80950c751
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:f4f24734-f47a-125b-1587-99b80950c751
msgctxt "h626af6ffg6f6ag4259gb173g64c0de9b95c3"
msgid "<i>Take command and return to yourself.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = f7f426cf-c370-9b0b-a6d7-76cf15f3ab7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:f7f426cf-c370-9b0b-a6d7-76cf15f3ab7e
msgctxt "h5bc6ed83gf36fg4b14g9adfg8345b03ef555"
msgid "Apologies for the tardiness, my festering liege."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fae90964-05ef-91e8-abb7-d7861274cc98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:fae90964-05ef-91e8-abb7-d7861274cc98
msgctxt "h6fc8b43eg93c6g4778gab0dgd350aef923a8"
msgid ""
"I fear you are over-working yourself, for I was earnestly trying to find a "
"moment to help set you on the right path, but you were just frolicking away "
"with your dagger, weren't you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc994f3c-2ae9-91fd-8ff1-7d08323dac22
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:fc994f3c-2ae9-91fd-8ff1-7d08323dac22
msgctxt "hbcc04644g631fg486bg8726gfaa7f91fd037"
msgid ""
"Oh! Milord is tired! I will tuck him in personally, with a bedtime story of "
"his former self."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc994f3c-2ae9-91fd-8ff1-7d08323dac22
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:fc994f3c-2ae9-91fd-8ff1-7d08323dac22
msgctxt "h26a45af9ge123g4deeg8888gac27da0c3d44"
msgid ""
"Oh! Milady is tired! I will tuck her in personally, with a bedtime story of "
"her former self."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = fc994f3c-2ae9-91fd-8ff1-7d08323dac22
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_KilledIsobel_SD:fc994f3c-2ae9-91fd-8ff1-7d08323dac22
msgctxt "h69046b72g7d70g4811g947bg4f51818120d9"
msgid ""
"Oh! Milord is tired! I will tuck them in personally, with a bedtime story of "
"their former self."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = GROUP_ORI_DU
#. NodeID = 003c6a38-c165-7206-3366-252928940406
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Intelligence
#. DifficultyClass: 12
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:003c6a38-c165-7206-3366-252928940406
msgctxt "h0f1116e5g5ea5g41ebg85edg2c2db0447203"
msgid "<i>Try hard to remember something, anything.</i>"
msgstr "<i>뭔가 기억하려 애써 본다. 뭐든지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 0e664a7f-1aac-fcb5-164b-742908c7b937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:0e664a7f-1aac-fcb5-164b-742908c7b937
msgctxt "ha4eeff85g9569g4a7bg92ebg9b6a81e9ef64"
msgid ""
"*If you could craft a corpse like this in one night, what masterpieces have "
"you sculpted in your forgotten decades?*"
msgstr "*만약 당신이 이런 시체를 하룻밤만에 만들어낼 수 있다면, 잊혀진 나날 동안 당신은 어떤 걸작들을 조각했을까요?\""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 21f0d548-e991-35c0-4894-0ddf7f9c665e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Event_HideAlfiraCorpse = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:21f0d548-e991-35c0-4894-0ddf7f9c665e
msgctxt "h9622ebbcgac60g4c5eg85d4g73d27da05e7b"
msgid ""
"*A light and delicate girl. It should be no trouble at all to toss her into "
"a ditch.*"
msgstr "*가볍고 섬세한 소녀입니다. 도랑으로 밀어넣는 데는 아무 문제도 없겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 27edabf2-4587-7faa-53aa-c5034047429a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:27edabf2-4587-7faa-53aa-c5034047429a
msgctxt "h8069ad17g05bag4b3dga0b9g4f282be0f4db"
msgid "*You open your eyes with a lurch, and you are not in your bed.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 3073b5b6-a68b-f213-f72b-5c2bd72daa48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:3073b5b6-a68b-f213-f72b-5c2bd72daa48
msgctxt "h74315d71g5b85g47c2g875dg0b4c7766d041"
msgid "*You should face the problem at hand.*"
msgstr "*지금은 당면한 문제를 마주해야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = GROUP_ORI_DU
#. NodeID = 30c9f77d-e5b6-5d95-63c5-df7c51c7ad29
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 7
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:30c9f77d-e5b6-5d95-63c5-df7c51c7ad29
msgctxt "h0a8752eeg280eg4bc2g941fgae4e2e55f4fb"
msgid "<i>Investigate your surroundings, looking for an explanation.</i>"
msgstr "<i>주변을 조사하여, 무슨 일이 있었는지 알아본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 3ebabf11-49f8-a8c4-12c4-11af1beee62f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:3ebabf11-49f8-a8c4-12c4-11af1beee62f
msgctxt "h62cf3a17gf261g4091gac8cgbb5e2765cb8c"
msgid ""
"*The question flows through your mind: who are you, really, that you could "
"be guilty of such bitter business?*"
msgstr "*질문이 당신 마음 속에 흘러듭니다. 당신은 대체 누구이기에, 이런 무시무시한 짓을 저지를 수 있었을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = 46403be6-afd4-0a9b-2a46-2e35679e2ac3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:46403be6-afd4-0a9b-2a46-2e35679e2ac3
msgctxt "hbfa880a0gad1dg4cd6gbb3bg231ac298eff3"
msgid "<i>Attend to the body - something must be done about it.</i>"
msgstr "<i>시체를 살펴본다. 거기 무언가를 했을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 4c6c0f47-952b-e15d-9dfd-223651b5917a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:4c6c0f47-952b-e15d-9dfd-223651b5917a
msgctxt "hfda4d83eg8644g46f5g967bg6b059e1b4fb6"
msgid "*Another explanation will arise.*"
msgstr "*분명 다른 원인을 알아낼 수 있을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 4dbd069b-26e8-a2c8-a2b6-04f04054772b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_CamperToJudgeAlfiraMurder = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:4dbd069b-26e8-a2c8-a2b6-04f04054772b
msgctxt "hcc479b78g1a8bg4c2eg9a7dgdae617af4549"
msgid "*You don't have much time for reflection now, you need to act.*"
msgstr "*되돌아볼 시간이 많지 않습니다. 행동해야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 51f513a8-05da-f500-7137-efce06359920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:51f513a8-05da-f500-7137-efce06359920
msgctxt "h1273d965g9b50g4302gaea2g445d79c39e8f"
msgid ""
"*There are dozens and dozens of wounds on the corpse. The killer did not "
"stop savaging it, even when she was long gone.*"
msgstr "*시체에는 수십 개의 상처가 있습니다. 범인은 피해자가 죽고 나서 한참 뒤에도 유린을 멈추지 않았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = 5aeeda34-ad5a-5d09-80e5-c11471d1a3c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:5aeeda34-ad5a-5d09-80e5-c11471d1a3c1
msgctxt "h956a182egaa0bg4ae9g8a86g89b483725bc5"
msgid "<i>Push the thoughts away - you'd rather not know.</i>"
msgstr "<i>생각을 치워 둔다. 모르는 편이 나을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 60e96c50-7e26-1d8b-44d6-7bfd7ec2b507
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:60e96c50-7e26-1d8b-44d6-7bfd7ec2b507
msgctxt "hb7cd2063gbfceg482cgb5fagd4a8dbfc97c6"
msgid ""
"*No matter how it appears, the body is there, and her blood is on your "
"hands.*"
msgstr "*어찌 되었거나, 시체는 거기 있고, 그 피는 당신 손에 묻었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 6267c533-84b4-b74a-375d-cde16b1a3eb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:6267c533-84b4-b74a-375d-cde16b1a3eb4
msgctxt "h9b7f056dg90eag4c01g9f93gb1162f25d017"
msgid "*After a few moments more of scrubbing, your hands begin to sting.*"
msgstr "*좀 더 문지르고 나자, 손이 찌르듯 아프기 시작합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 63422318-809c-c688-0e4e-aef7c5e9d74f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:63422318-809c-c688-0e4e-aef7c5e9d74f
msgctxt "hd4486b8bgace3g49b9gb6fcge1b727741542"
msgid "*Something wicked must have woken you.*"
msgstr "*사악한 무언가가 당신을 깨웠음에 틀림없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 65d8e703-faa1-ae8d-2219-ae43fabc7681
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:65d8e703-faa1-ae8d-2219-ae43fabc7681
msgctxt "h144d2af5gabe9g4cfag8911g8cae17dc3d8c"
msgid "*The bedroll becomes a warm, swampy cocoon of gall and fluids.*"
msgstr "*침낭은 분비물과 액체로 가득한 따스하고, 질척거리는 고치가 됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = 663ad4e1-07dc-6e92-453d-c5669fdd5f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:663ad4e1-07dc-6e92-453d-c5669fdd5f9b
msgctxt "h99d2066fgb4a6g4b4fg8638g86658a7d9326"
msgid "<i>Connect to your parasite, is it responsible?</i>"
msgstr "<i>기생충에 연결해 본다. 책임이 있을까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 69ec6383-6e76-5d73-b945-263b6c9a0684
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:69ec6383-6e76-5d73-b945-263b6c9a0684
msgctxt "h6ac7e0f5gab94g4edbgbf5cg6f91a90d90d3"
msgid "*A single moment comes to you.*"
msgstr "*단 한 순간이 떠오릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 6a94345b-6885-b0a7-895c-48e9d5938147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:6a94345b-6885-b0a7-895c-48e9d5938147
msgctxt "h0fe0424cgc71fg43c7g89fag4924412ae343"
msgid "*Blood spilling from her lips. No time for last words.*"
msgstr "*입술에서 흐르는 피. 유언을 남길 시간조차 없었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = 6bf28aac-d29a-d0d7-30f5-17e5dd48cf10
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:6bf28aac-d29a-d0d7-30f5-17e5dd48cf10
msgctxt "hf3f06b83g3c7ag49b6ga3e2g7da7f5d2a99e"
msgid "<i>Admire this beautiful death.</i>"
msgstr "<i>이 아름다운 죽음을 음미한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 6ccf3ec6-0972-47dd-ec1a-41385562c6f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:6ccf3ec6-0972-47dd-ec1a-41385562c6f8
msgctxt "h213078adgecb5g4e6cgb76egf0d67b4ae72c"
msgid "*There is nothing else here, and no one else around.*"
msgstr "*여긴 아무 것도 없고, 주변엔 아무도 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 7b58d5ab-e36f-871d-daca-933350b85436
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:7b58d5ab-e36f-871d-daca-933350b85436
msgctxt "h903b9913g5989g4000g922agcdc3eaab725a"
msgid "*And your dominant arm aches. It aches from stabbing. Over and over.*"
msgstr "*그리고 주로 쓰는 팔이 아파옵니다. 계속해서 찌르고, 찌르고, 또 찌른 탓에.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 7e149a7e-f64f-0d63-bcd8-cb263efc5647
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:7e149a7e-f64f-0d63-bcd8-cb263efc5647
msgctxt "h70615152gded6g4178gb8d8gff90a5104d35"
msgid ""
"*But where, oh where could that monster have come from? If only you knew "
"yourself better.*"
msgstr "*하지만 그런 괴물이 어디서, 대체 어디서 왔을까요? 당신 자신을 더 잘 알았더라면.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 82c09fbd-1cd4-b787-06fd-e004b7a9aed5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:82c09fbd-1cd4-b787-06fd-e004b7a9aed5
msgctxt "h6debaec2g0f5eg42d5gaa70g11800e6ef59b"
msgid "*Your misdeed is bright and clear as the dawning day.*"
msgstr "*당신의 악행은 밝아오는 새벽만큼이나 밝고 명확합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 84cb430c-fb6f-bab4-2805-b5917b3e8d5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:84cb430c-fb6f-bab4-2805-b5917b3e8d5c
msgctxt "hbe365b6fgef1dg4e7ega4f8gd6b6231ca3e5"
msgid ""
"*While your body starts to feel clean, the blood doesn't seem to leave.*"
msgstr "*몸은 깨끗하다 느끼기 시작하는 반면, 피는 씻겨나가지 않는 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 8d9c4814-d373-f78f-0617-b8207589625e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:8d9c4814-d373-f78f-0617-b8207589625e
msgctxt "he47c9ed7g25eeg40a5ga9d8g4703fa1b12b6"
msgid "*You wonder if your misdeed will be noticed.*"
msgstr "*당신은 악행이 들킬까 걱정됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 8dba7cca-6df5-bbc4-37c1-c2167b4619f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:8dba7cca-6df5-bbc4-37c1-c2167b4619f0
msgctxt "h50d56e96gba3fg4688g81cfg76965501c187"
msgid "*But her blood is still on your hands, surely?*"
msgstr "*하지만 피는 아직도 손에 묻어 있죠, 확실히?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = 8e0101de-38de-c02a-7aaf-893a673a43f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_OnlyOneToJudgeAlfiraMurder = True
#.      - ORI_DarkUrge_State_CamperToJudgeAlfiraMurder = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_AlfiraMurderWokeParty = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:8e0101de-38de-c02a-7aaf-893a673a43f9
msgctxt "h8c5786ddg9463g4955g936dg22d30aea81f3"
msgid "<i>Hide nothing. You aren't ashamed.</i>"
msgstr "<i>숨기지 않는다. 부끄럽지 않다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 8ee0f3f0-2689-886f-633b-871baea15d14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_PartyToJudgeAlfiraMurder = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:8ee0f3f0-2689-886f-633b-871baea15d14
msgctxt "h90e98d0egf71eg4a8dg9cf1g0732b40a8e74"
msgid "*Her guts start to spill and flow everywhere as you shift her.*"
msgstr "*시체를 옮길 때마다 창자가 쏟아져 나와 흐릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 8fe11dd0-7fac-9e9c-860b-805fece45264
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:8fe11dd0-7fac-9e9c-860b-805fece45264
msgctxt "h748e7d8cge14dg400dg8215g8d8a2f892004"
msgid ""
"*The contemptible pervert within must have lavished slash after slash upon "
"the girl.*"
msgstr "*내면의 경멸스러운 변태가 소녀를 마구 베고 또 베었을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 91e5b007-e240-ad26-3ea9-f4d8316483e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:91e5b007-e240-ad26-3ea9-f4d8316483e2
msgctxt "hedd3cafeg0ce9g48a2g96c4gdbe7ac5a4add"
msgid "*You shake your head, and it seems to go away, only then.*"
msgstr "*머리를 흔들자, 없어진 듯 보입니다. 그 때만요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = 938999ee-9eec-f8d6-ea8e-a6e136525e9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:938999ee-9eec-f8d6-ea8e-a6e136525e9e
msgctxt "ha9972f6eg62d2g4ffdga8bdg65d710a401d4"
msgid "*You open your eyes with a lurch, and you are not in your bed.*"
msgstr "*화들짝 놀라며 눈을 뜨자, 어느새 잠자리에서 일어난 것을 깨닫습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = 99fca7d9-9be0-e4ee-04a3-6c25b6597235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:99fca7d9-9be0-e4ee-04a3-6c25b6597235
msgctxt "h183a58a2g18c5g4eebg9885g6bd160ed7de4"
msgid "<i>Seek out the nearest water to wash the blood away.</i>"
msgstr "<i>피를 씻어낼 수 있는 가까운 물을 찾는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = 9f047179-c5d6-b917-413f-399d80fd15fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:9f047179-c5d6-b917-413f-399d80fd15fa
msgctxt "h6e6a2ae5g2e37g401bgb590gd77eef8c7f59"
msgid "<i>Refuse to believe this was your doing.</i>"
msgstr "<i>자신이 한 짓임을 믿지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = a11b75b7-d810-7259-7bd5-082f02b827cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_PartyToJudgeAlfiraMurder = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:a11b75b7-d810-7259-7bd5-082f02b827cd
msgctxt "hf969c5e1geb33g429egaf1bg1d23352e82c1"
msgid ""
"*Your companions sleep blissfully tonight. If it were the rage of a tadpole, "
"no others seem to be affected.*"
msgstr "*오늘 밤 동료들은 아무 것도 모른 채 잠들었습니다. 올챙이가 부린 난동이었다기엔, 다른 사람들은 영향이 없어 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = a727b163-02af-2ffb-52eb-c05a5b0f5212
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DarkUrge_Event_RecruitAlfira = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:a727b163-02af-2ffb-52eb-c05a5b0f5212
msgctxt "hd7b388a0gd056g4052gbc0fg95e3587dd6db"
msgid ""
"*The body of that brave girl, who earnestly swore to devote her life to your "
"cause.*"
msgstr "*당신의 대의를 위해 생을 바치겠다고 간절히 맹세했던, 용감한 소녀의 시체입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = ac074053-374a-3e1d-9404-7df05bd8054a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:ac074053-374a-3e1d-9404-7df05bd8054a
msgctxt "h9e077628g446ag4e24gb29bg340ae261c102"
msgid ""
"*You can tell the blood is washing away, but your heart mourns its loss so "
"dearly.*"
msgstr "*피가 씻겨나가는 것을 알 수 있지만, 마음 속에선 그 손실을 매우 가슴아파합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = b6d186b4-c4ee-2ffa-8a5d-62002a4651d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_CleanedBlood = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:b6d186b4-c4ee-2ffa-8a5d-62002a4651d9
msgctxt "h417e797bg61aeg4bddga17eg00b523269ceb"
msgid "*You scrub yourself until your hands are cold and raw.*"
msgstr "*당신은 손이 차가워지고 거칠어지도록 자신을 문지릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = b7b8ed8f-774d-bc8e-7ba3-d8a3122778de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:b7b8ed8f-774d-bc8e-7ba3-d8a3122778de
msgctxt "hc83184aag7664g4fc1g92bdg681c6d42f1c1"
msgid "*You roll her away, further bloodying your hands as you do.*"
msgstr "*당신은 손에 점점 더 피를 묻혀 가며 시체를 굴립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = baf810e2-7c9d-1f4d-8821-c7c54eec3c6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:baf810e2-7c9d-1f4d-8821-c7c54eec3c6d
msgctxt "h753358faga40eg4a22gb6f9g11c601f6b650"
msgid ""
"*You stand above a body, which is in a state of gore nearly beyond "
"recognition.*"
msgstr "*당신은 어떤 몸 위에 서 있습니다. 거의 알아볼 수 없을 수준으로 잔혹한 상태입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = be4653a7-29ef-f47c-7593-407c186a9479
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_OnlyOneToJudgeAlfiraMurder = True
#.      - ORI_DarkUrge_State_PartyToJudgeAlfiraMurder = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:be4653a7-29ef-f47c-7593-407c186a9479
msgctxt "h9ff3033bg8d1dg47e8gaca9g4d4d093820aa"
msgid "*Someone is sure to see the evidence of this darling sin.*"
msgstr "*누군가 이 사랑스런 죄의 증거를 확실히 보겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = bfc2c881-b4a3-c972-8a12-bb4f00c36406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:bfc2c881-b4a3-c972-8a12-bb4f00c36406
msgctxt "h76bbb417g565bg4013g96cbg1e4a36acc931"
msgid ""
"*You recall nothing of how you ended up here, but your head pounds and "
"aches.*"
msgstr "*어쩌다 이 지경이 되었는지 아무 것도 떠오르지 않지만, 머리가 지끈거리고 아픕니다 .*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = c0916945-a29b-c43d-7b15-d7e434fbf68f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:c0916945-a29b-c43d-7b15-d7e434fbf68f
msgctxt "hf52f4459g37a3g410dg985ag76603f46bf70"
msgid "*There is no magic binding this blood to your body, only guilt.*"
msgstr "*당신의 몸과 이 피를 잇는 것은 마법이 아닙니다. 죄책감뿐이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = GROUP_ORI_DU
#. NodeID = c61cf78c-ed5f-a4d2-6697-75b02468d5e4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 12
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:c61cf78c-ed5f-a4d2-6697-75b02468d5e4
msgctxt "h158bcdd4g3147g4bafg94dbg36b15bb14856"
msgid "<i>Try to hide the body.</i>"
msgstr "<i>시체를 숨기려 시도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = c918855b-0026-3c6d-c0e3-e17835458571
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:c918855b-0026-3c6d-c0e3-e17835458571
msgctxt "h50b86b0bgb980g496egb9b9ga0643a8f1020"
msgid "<i>Wonder: what curse is in your heart, to kill in your sleep?</i>"
msgstr "<i>의문을 가진다. 마음 속에 어떤 저주가 있기에, 자다 말고 살인을 할까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = cef4efc9-83c7-d1e5-9f97-573fdf6f5b0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:cef4efc9-83c7-d1e5-9f97-573fdf6f5b0f
msgctxt "h51ec30dfgc694g47e2gb05bg1e8e6374a73f"
msgid "<i>Keep scrubbing.</i>"
msgstr "<i>계속 문지른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = d17b4aab-c780-bcff-266e-0f5d8ae126f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:d17b4aab-c780-bcff-266e-0f5d8ae126f1
msgctxt "h5b0f59eagdd01g49bdg9b81g7779e0917345"
msgid "*The flash of abject terror in her eyes.*"
msgstr "*피해자의 눈 속에 비치는 비참한 공포.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = d4813bf8-d44c-b2a9-3d79-615513baee15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_PartyToJudgeAlfiraMurder = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:d4813bf8-d44c-b2a9-3d79-615513baee15
msgctxt "h9da5120cg6ca8g4c9agb2cdgc41efcbe35cc"
msgid ""
"*You may only have a few moments before the others awaken, and begin to cast "
"blame for the hot sin before you.*"
msgstr "*다른 이들이 일어나서 당신이 저지른 뜨거운 죄를 비난하기까지 얼마 남지 않았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = d537a3d7-e4bc-af4f-bfa4-bff1cc3377d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:d537a3d7-e4bc-af4f-bfa4-bff1cc3377d6
msgctxt "h98581853gd8ffg40fcgae87gfd66c2bc28cd"
msgid ""
"*The throbbing in your skull will hardly let you think, let alone remember.*"
msgstr "*머리를 두들겨 본들 기억나지 않을 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = da145aad-ceea-d1a7-5750-5b6746255d34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:da145aad-ceea-d1a7-5750-5b6746255d34
msgctxt "h525137a7ge2b2g468ag8915g169065a7dbbb"
msgid ""
"*But this body says it all... your desires for cruelty will not hide from "
"you.*"
msgstr "*그러나 시체는 말합니다...잔인한 욕망은 당신에게서 숨지 않으리란 것을요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = dc0a1b78-412b-8f9e-6b28-68c2dd1f9941
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_PartyToJudgeAlfiraMurder = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:dc0a1b78-412b-8f9e-6b28-68c2dd1f9941
msgctxt "h7bd6e7bbg11dbg475bgb10egbd00fafdec8e"
msgid ""
"*If you are fortunate, no soul will be able to know you were behind this "
"murder.*"
msgstr "*운이 좋다면, 아무도 당신이 이 살인의 배후에 있다는 사실을 모르겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = GROUP_ORI_DU
#. NodeID = dd8ee8f8-6724-67c6-08e2-03fe8756a3ac
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:dd8ee8f8-6724-67c6-08e2-03fe8756a3ac
msgctxt "h6dd57755ga0e6g4c0cg9f1ag09306ae442cc"
msgid "<i>Examine the blood more closely - is it magical?</i>"
msgstr "<i>피를 더 자세히 살펴본다. 마법적인 걸까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = defd5206-4951-f47b-40e5-404eaeb777d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:defd5206-4951-f47b-40e5-404eaeb777d4
msgctxt "hde88fdfag9b0bg491fgab96g2aad5a15eff0"
msgid "<i>Go back to sleep.</i>"
msgstr "<i>도로 자러 간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = e567bf22-36b2-1512-ad3f-d37bebb207a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:e567bf22-36b2-1512-ad3f-d37bebb207a4
msgctxt "hf478a75cg8bc8g4e61g98fega6067fe25699"
msgid "*In lumbering style, you have gotten away with murder.*"
msgstr "*통나무 다루듯, 당신은 살인을 처리했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = ebd40154-6adc-f559-88a4-93d38addfa65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_DarkUrge_Event_RecruitAlfira = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:ebd40154-6adc-f559-88a4-93d38addfa65
msgctxt "h2e160ca1gb373g4d6cg8de0g67977a44b980"
msgid ""
"*The body of that scared girl, who asked for nothing more than a night of "
"shelter.*"
msgstr "*하룻밤 쉴 곳만을 요구했던, 겁에 질린 소녀의 시체입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = ee92e10f-8261-11bf-a181-715fb03fc306
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:ee92e10f-8261-11bf-a181-715fb03fc306
msgctxt "ha8e0e302g0224g4ee6ga159g7aeed84eec05"
msgid "*There is something intangible which stops the blood from leaving you.*"
msgstr "*다룰 수 없는 무언가가 피를 씻어내지 못하게 막고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = ef054b6d-4764-cb69-3f02-8af13bb70dd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:ef054b6d-4764-cb69-3f02-8af13bb70dd7
msgctxt "h358bb4f8g012ag4bc8ga0e3g8c42d9c314ff"
msgid "*The little worm seems silent.*"
msgstr "*작은 벌레는 가만히 있는 모양입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = f1ed7ccf-51fa-9571-e717-ac4719f275ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:f1ed7ccf-51fa-9571-e717-ac4719f275ac
msgctxt "hb741d055ge133g4959g8d5fg4d2d907fceb4"
msgid ""
"*Her blood covers you, and its warmth feels like the embrace of an old "
"friend.*"
msgstr "*소녀의 피가 당신을 덮었고, 그 따뜻함이 마치 오랜 친구의 포옹 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = f5a69e1b-f934-219e-c89f-2be2acfcc077
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:f5a69e1b-f934-219e-c89f-2be2acfcc077
msgctxt "h082327b8g3eb2g4264gaf97g2c49286d9bcd"
msgid "*You may wish to hide from your past, and your Urges.*"
msgstr "*당신은 과거로부터, 당신의 충동으로부터 숨고 싶을지 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Narrator
#. NodeID = f5d4accd-b0ac-34dc-0d36-b64f0d22b1b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:f5d4accd-b0ac-34dc-0d36-b64f0d22b1b5
msgctxt "h9cf5408dg373cg46e6g978ag5bfda9fc9cbc"
msgid ""
"*You and the corpse seem to have been alone together for quite some time.*"
msgstr "*당신과 시체는 둘이 함께 어느 정도 시간을 보낸 모양입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands
#. Speaker = Player
#. NodeID = f6486b28-50a7-57e7-d79e-cb07e267daab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_OnlyOneToJudgeAlfiraMurder = False
#.      - ORI_DarkUrge_State_CamperToJudgeAlfiraMurder = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_AlfiraMurderWokeParty = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands:f6486b28-50a7-57e7-d79e-cb07e267daab
msgctxt "heec2eef9gd0a4g434cga12bg3e1a50712f1f"
msgid "<i>Prepare to face the others - you aren't going to hide.</i>"
msgstr "<i>다른 사람들을 마주할 준비를 한다. 숨지 않을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 02f257fa-6fdc-62d8-4bdb-80e2c6250ed5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:02f257fa-6fdc-62d8-4bdb-80e2c6250ed5
msgctxt "hdd07fb90g4b79g43a9g8678gf9bc90d64fba"
msgid "I needed to guarantee that Bhaal would not claim me as his Chosen."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 031b0338-d36a-2dbc-aac7-29463b1f2a26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:031b0338-d36a-2dbc-aac7-29463b1f2a26
msgctxt "hd88b5e1cg4be7g4ffdgaff4g69a397854af0"
msgid "It seems your cruelty was uninspired in the end."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 04500762-33a4-60e9-b76d-9b814bcd1884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:04500762-33a4-60e9-b76d-9b814bcd1884
msgctxt "h0240ec1egf6d8g4e63gacfbg28292f7e2ad9"
msgid ""
"Ruined mind waxing ever-red, with less reason than a feral ratling, crawling "
"from ditch to sewer, suckling on your dagger's rust."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 0ce09d35-3696-4511-c3b0-b6ba866b8a59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:0ce09d35-3696-4511-c3b0-b6ba866b8a59
msgctxt "h7a9012c9gbe23g4803gac43g36cf68daabdb"
msgid "Not now. You have killed me by robbing me of all purpose."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 0d37808f-2dac-a3c2-153a-3713b65d1582
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:0d37808f-2dac-a3c2-153a-3713b65d1582
msgctxt "hc090bd76g7775g4201gb776g4ad11f58b282"
msgid ""
"But the Lord's line cannot end. If you ever heed a single word from me, heed "
"this: Go forth and breed widely. Sire a new legion, and set them upon self-"
"slaughter."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 125d4d41-448c-46ba-c483-ba15213489dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:125d4d41-448c-46ba-c483-ba15213489dc
msgctxt "h67d112ceg3277g4f95gbd89g5e59c352e2b0"
msgid "For what it's worth: I'm sorry."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1616441f-69e2-b111-707c-7a2c1a9540d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:1616441f-69e2-b111-707c-7a2c1a9540d8
msgctxt "hff795d20g4cb5g41a2gb349g1971eccc14c9"
msgid ""
"Now that you have failed Bhaal, the Urge shall come calling to claim you, "
"the moment that tadpole is not in your head."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 16619702-40db-e589-5368-9e1549427ba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:16619702-40db-e589-5368-9e1549427ba8
msgctxt "h79fb342cg1b42g41b2g932cgf773cc012a73"
msgid ""
"What's the point in all that brutalising domination if you don't have a "
"family to go back to at the end of the day?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1df1f3d4-0279-b971-2cf8-8b9237bed3b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:1df1f3d4-0279-b971-2cf8-8b9237bed3b3
msgctxt "hae4a23f2g8c0ag4817g80d4g35838e64ce64"
msgid ""
"The only moments of hope amidst the terror are snatched from the dark when I "
"am around <i>you</i>, Master."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 23ab68db-1399-127b-46e1-61d75d9c863b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:23ab68db-1399-127b-46e1-61d75d9c863b
msgctxt "h0d4052c7g250dg47c0g9a23gf900d470bab4"
msgid ""
"My simpering lordling, you failed the entrance exam your august Father shed "
"his very <i>seed </i>to prepare you for."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 24051315-df4a-a1bc-be00-36965c17ca6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:24051315-df4a-a1bc-be00-36965c17ca6b
msgctxt "head14668g7d08g4e63g911age564cf65a145"
msgid ""
"You will not be your clever self, murderous erudite. Stupid, stupid bastard "
"orphan baby."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 2af32841-cd40-0ca9-d79c-ee743ec01c42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:2af32841-cd40-0ca9-d79c-ee743ec01c42
msgctxt "hb6824357g75f6g4f11g9e57g2d9691e317b3"
msgid "Lies, this city will be mine yet. You will see."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 2ca5c502-8d28-1433-dfb8-427051f7bc3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:2ca5c502-8d28-1433-dfb8-427051f7bc3d
msgctxt "h8b170682gf5dbg474fgaf62g775339e4b2cd"
msgid ""
"The world will still be subdued by my hand. Alone, without Bhaal's meddling."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 2ca66abf-6fb9-2c18-d24e-f03b18e7f05e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:2ca66abf-6fb9-2c18-d24e-f03b18e7f05e
msgctxt "h11ab3331ga279g4c1cgb5e1g3b0f28f3161c"
msgid "Is there any way I can make it up to Bhaal?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2d5c56be-b241-fcd1-a49e-ccfd7332458d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_GivenSlayerForm = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:2d5c56be-b241-fcd1-a49e-ccfd7332458d
msgctxt "h8d1a9bf8g9c3ag4769g8b4ag5569fe20920f"
msgid "I will lock it away, perhaps never to be worn again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2d7f56b0-eaed-3f14-20f6-d5bb80bee672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:2d7f56b0-eaed-3f14-20f6-d5bb80bee672
msgctxt "h9c4ff21fg470ag4bd5g9f42g7ac25d2d2c8f"
msgid ""
"There was a day where I longed for your caress. I dreamed of sitting like a "
"pup in the lap of the Slayer."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 3bec9b33-b89c-4b8a-aaa4-aa188bf8a649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:3bec9b33-b89c-4b8a-aaa4-aa188bf8a649
msgctxt "he09f6f7fgee20g4338g8a5bga1f9252654f6"
msgid "Can nothing save you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 3ddbd5ec-3079-e9e8-6c43-fbcf178b5ea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:3ddbd5ec-3079-e9e8-6c43-fbcf178b5ea2
msgctxt "h77833369g2ff0g4014g9dbag94217afb04e1"
msgid "Save me, then. I'll do whatever you want."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 3eee21d6-0dfd-72da-3c58-b7dd8fe32a5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:3eee21d6-0dfd-72da-3c58-b7dd8fe32a5f
msgctxt "h41bd8904gb444g4e3bg9359g4879df75e283"
msgid "Begone. Leave me in peace at last."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3fb3f1f0-ec6d-e6c7-66da-3cde44b1a26e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:3fb3f1f0-ec6d-e6c7-66da-3cde44b1a26e
msgctxt "h0ce19823g630fg42f0g91a4g347fef610ac3"
msgid "Oh, don't give me that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 41261c04-903c-258b-d5a2-7dac75c6d8ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:41261c04-903c-258b-d5a2-7dac75c6d8ec
msgctxt "h79bf22b4g1cfag4e21g9f88gee4356a88edd"
msgid "Then die."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 462617a5-9b5f-5e6e-09ae-524a49d7c773
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:462617a5-9b5f-5e6e-09ae-524a49d7c773
msgctxt "hffca4d27g292eg4e55g88c6g71505dc966d5"
msgid ""
"Fear of Bhaal ruins me. No matter how many times I am reborn - the rotted "
"phoenix rising from sheer agony - I can never get my heart to slow its "
"tormenting lurches."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 5d199886-20ac-f903-e13d-e0aaca5c0742
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:5d199886-20ac-f903-e13d-e0aaca5c0742
msgctxt "h108a73b0gcf72g47f4ga743g156f2f5c0e24"
msgid "Perhaps it would be for the best, at least they bear some dignity."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 67efc0e6-8631-8ca7-ddab-accaf06eb47f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:67efc0e6-8631-8ca7-ddab-accaf06eb47f
msgctxt "h880a82ceg9cbeg437bga5a3gd9d8b7aafc23"
msgid "But it is not to be."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6b43af51-5aa0-3167-6dcc-7dcb8d4ce3bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:6b43af51-5aa0-3167-6dcc-7dcb8d4ce3bc
msgctxt "h4979c6e7g86efg456cg8ef7g4f988fe3dab8"
msgid ""
"When you have reached the depths of your lunacy, you shall reflect the time "
"we spent together as your flower-days."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 73daee95-5f8c-7cdb-73d9-a86483bf233e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:73daee95-5f8c-7cdb-73d9-a86483bf233e
msgctxt "h85d8addag5143g4e81g8ba2g2d21f2460528"
msgid "Not half as sorry as I, who lived for you alone. Goodbye, Master."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 782f5df6-989d-ede0-43ec-839d3603f163
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:782f5df6-989d-ede0-43ec-839d3603f163
msgctxt "h7c5a27fdg4e93g4238gb39eg38778733b12f"
msgid "I will not fault you for fear. You think I don't fear Bhaal?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 82b4b9e2-5b0a-66ed-da64-5612b78cb68d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:82b4b9e2-5b0a-66ed-da64-5612b78cb68d
msgctxt "h1494fce4ga07eg430eg8cffg392d5585ddad"
msgid "Bhaal will never restore you, abortive spawn."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 8512ad69-3b27-2fc2-9f54-c5cc79f2eab8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:8512ad69-3b27-2fc2-9f54-c5cc79f2eab8
msgctxt "hdefec897g312dg45bag8dc4g4ee8c3d6f865"
msgid ""
"Never before has a Bhaalspawn left a Blood Wedding at the altar. What were "
"you doing, coward, not facing your sister?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 960ddcab-7f63-73ce-1c71-910f33bf5d0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:960ddcab-7f63-73ce-1c71-910f33bf5d0b
msgctxt "hbe24a524gbbddg4ff6g824eg8edbe371c8de"
msgid "You really can't help me?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 9716cd94-9030-22ba-02fc-7b3bc069dc99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:9716cd94-9030-22ba-02fc-7b3bc069dc99
msgctxt "h5b4ff52dg7abfg49f6ga038g06f78134cce0"
msgid "Is this the end of my Urges?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = 99f58207-e6d1-0227-8612-2ed64d5aca01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:99f58207-e6d1-0227-8612-2ed64d5aca01
msgctxt "h0b2d17a7gd97cg467fgb28fg5caf9b7e6ab7"
msgid "To tell the truth: I was afraid."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = 9a757cfd-deb1-3eab-ffff-6300d94c874d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:9a757cfd-deb1-3eab-ffff-6300d94c874d
msgctxt "h9220ebb0g61a2g4be5gb7c7g14de2428115b"
msgid ""
"And I, your only tutor, feel naught but humiliation for letting your "
"education fall so short."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = a02f3ec1-3689-76fc-682d-02e0e358994a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PARTIAL_CEREMORPH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:a02f3ec1-3689-76fc-682d-02e0e358994a
msgctxt "h8e91bc0ag99ceg497eg9707g30c682fe9e6e"
msgid "Not if I become an illithid first."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = a0cea54a-0b57-67df-dc14-c23e7726dddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:a0cea54a-0b57-67df-dc14-c23e7726dddb
msgctxt "h1bcab8cfg02c4g498cg86ddg229a98c9deb3"
msgid "I am not needed. As you are disinherited, I have no Liege to serve."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = a1b2ab7e-ea8f-b664-5aea-5aa7ddbb6e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:a1b2ab7e-ea8f-b664-5aea-5aa7ddbb6e8f
msgctxt "h948c9514g8b34g4459g97f8gbb3791688c46"
msgid ""
"Why... why...? I <i>adored </i>you. I never expected you to demonstrate such "
"resplendent mediocrity, such impotence!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = a6df9b7d-1709-da9d-52a3-86da40309eb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:a6df9b7d-1709-da9d-52a3-86da40309eb8
msgctxt "h5b148ff9g92adg4190gb382g4b026cbb5f4e"
msgid "Impossible..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = ae18cf3e-d6cf-b8ed-29c4-50e297da361f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:ae18cf3e-d6cf-b8ed-29c4-50e297da361f
msgctxt "h71c4a8c2gbd98g4378ga263g3e07f3cc65d6"
msgid "I don't remember... it's all a blur."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = b0cd6775-4f7c-8890-b415-0d2e9e79b4c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:b0cd6775-4f7c-8890-b415-0d2e9e79b4c8
msgctxt "h29079ccbgf130g454fgb8bbg0bb1fa643a2d"
msgid "I can still subdue the Coast. I will prove myself worthy again."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = b973bcba-2cec-753c-c93c-72e48f77a81a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:b973bcba-2cec-753c-c93c-72e48f77a81a
msgctxt "h36d82324g0b91g4576g9bffgabdf436bace1"
msgid "You have squandered your inheritance. Oaf, Bhaal<i>slug</i>!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = b9b8aa29-ccae-7801-71d6-be1dcd3d3b11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_GivenSlayerForm = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:b9b8aa29-ccae-7801-71d6-be1dcd3d3b11
msgctxt "hb0fa59c6g4bd6g4d58gb6e3g5ad21b29b0b9"
msgid ""
"The Slayer is an ill-fitting suit, not tailored to that lazed body you have "
"left to waste away."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = b9ebd7c6-50be-a6b9-3a63-a8cd00a35f56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_BhaalTemple_State_DUDefeatedByOrin = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:b9ebd7c6-50be-a6b9-3a63-a8cd00a35f56
msgctxt "h30c050f9g8effg4653g911dgf10da8c18fdc"
msgid ""
"You should have stayed dead in the Temple as Bhaal's ritual lamb, rather "
"than bear the shame of crawling back to life after your defeat."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = bf46eda3-9533-88ee-0ac7-3b45236765fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:bf46eda3-9533-88ee-0ac7-3b45236765fc
msgctxt "hf13c5db6ge099g4fbega60ag9dd222dde7f2"
msgid ""
"Your fertile organ is now your sole weapon. Combined, potent worm and gravid "
"womb may honour Bhaal's name."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = c0ebd70f-20e1-fdd0-457f-dfb2243465d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:c0ebd70f-20e1-fdd0-457f-dfb2243465d5
msgctxt "h452d9c1eg56b2g473dgbee5gebc0b317afef"
msgid ""
"A Butler lives to serve. And as I can no longer serve, I will surely die. "
"Once and for all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = ca450af2-81e6-ae19-f934-c7b1478729fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:ca450af2-81e6-ae19-f934-c7b1478729fc
msgctxt "hafa43e65g8bc3g434ag96b8ga1c19af37128"
msgid ""
"But you didn't fear only Bhaal. You <i>feared yourself. </i>That I shall "
"never forgive."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = d2ef7617-b05e-bb8c-0f99-011498d08406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:d2ef7617-b05e-bb8c-0f99-011498d08406
msgctxt "h21bb5f0bgea80g4b33gb1c3g98e6052694cb"
msgid "To call you 'Master' brings me shame."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = d9d4e59d-937a-dcfe-9e76-987a3fbc99b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:d9d4e59d-937a-dcfe-9e76-987a3fbc99b0
msgctxt "hfc58a20cg7298g4c45ga70bg386feb3d9f90"
msgid "<i>Weep.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = e18a39cc-2b33-fb16-56e8-a923b12eb52f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:e18a39cc-2b33-fb16-56e8-a923b12eb52f
msgctxt "hbfaaf9c6g0b96g4bf6g8a78g8587b5d2d7a4"
msgid "Won't you stay with me? Until the end..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = e3bf59fc-96d5-4f5b-8d59-f87c0cce6eb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:e3bf59fc-96d5-4f5b-8d59-f87c0cce6eb0
msgctxt "h514737e5gc775g4f0bga328ga6b627ad94bc"
msgid "Get up! Get <i>up</i>! Quit malingering in your red dreams."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = eb294801-eea5-ca41-f4c1-d76b9c6d4e79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:eb294801-eea5-ca41-f4c1-d76b9c6d4e79
msgctxt "h0898a661g0791g4d67g8851gc5c71cfd330b"
msgid "I hate you, Master. I hate you, I hate you, I hate you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = ed4f04d3-6725-d7e4-d226-ef923e8520ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:ed4f04d3-6725-d7e4-d226-ef923e8520ec
msgctxt "hb2bdb513g61b4g40e3gb5c3g4cd883566a10"
msgid ""
"Hee hee! You speak of the Urge as if it were some enchantment or curse. My "
"dear, disgraced Master: the Urge is <i>you</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Player
#. NodeID = efb7baec-063b-d732-18df-5c63894f8164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:efb7baec-063b-d732-18df-5c63894f8164
msgctxt "h74a6740cg1163g4b42gad04g979fc211dfb0"
msgid "I really thought I could win the fight."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = f12d9e68-4721-8b77-0806-c4c29c7df3a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_BhaalDisappointed = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:f12d9e68-4721-8b77-0806-c4c29c7df3a7
msgctxt "h414df16fg4366g4ccbg9e7cga1b5a4adaa91"
msgid ""
"They won't write books of you, but if they do, let history tell: Sceleritas "
"Fel died of a broken heart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = f25c85d6-29bc-7781-7596-40a361afcddf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:f25c85d6-29bc-7781-7596-40a361afcddf
msgctxt "he0699856g8106g4454ga2d1g0c94d5e42173"
msgid ""
"Oh... It still pains me to see my little liege in distress. Oh, please, "
"don't cry. I... will always love you. But I must go."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = f5dd42c6-5db8-fd2c-8844-4833521ffdb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:f5dd42c6-5db8-fd2c-8844-4833521ffdb3
msgctxt "he5863e41ga8c6g48f6gadd7g5c39791861e1"
msgid ""
"I don't want anything. Every moment we were together, I was perfectly "
"content. But now..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD
#. Speaker = Sceleritas Fel
#. NodeID = fcbc6c05-37bd-0e15-de19-5e68f8d9630e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SkippedTempleFinale_SD:fcbc6c05-37bd-0e15-de19-5e68f8d9630e
msgctxt "ha4f801d6g2959g4060g86ffgef874983ca53"
msgid ""
"You shall be a naked filthy piglet soon, supping on bones. You shall hardly "
"be able to defecate in the corner, yet alone rule the world."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 005a27dd-0396-c23b-20ca-445770591646
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:005a27dd-0396-c23b-20ca-445770591646
msgctxt "hd7ec4164g93b2g46cegba97g3e90c1106b3a"
msgid "<i>Reach forward to shake his shoulder and wake him.</i>"
msgstr "<i>손을 뻗어 어깨를 흔들고 깨운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 005a27dd-0396-c23b-20ca-445770591646
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:005a27dd-0396-c23b-20ca-445770591646
msgctxt "hf7538677gbfdfg4ca0ga3a1gc1341c0e1e64"
msgid "<i>Reach forward to shake her shoulder and wake her.</i>"
msgstr "<i>손을 뻗어 어깨를 흔들고 깨운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 018ee161-5f23-742b-9b69-f3511da91ec7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:018ee161-5f23-742b-9b69-f3511da91ec7
msgctxt "he42fd965g8dacg4f2aga8d6gd52d4daf4340"
msgid "Have you been watching us while we are together?"
msgstr "우리가 같이 있는 동안 지켜봤던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 041a06c8-693e-65d0-548c-2ecb83157643
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:041a06c8-693e-65d0-548c-2ecb83157643
msgctxt "h9fc7002bgb87bg46b2gab09g55d54706dcc6"
msgid "You will do something divinely <i>unspeakable</i> on this eve."
msgstr "오늘밤 주인님은 아주 신성하고 <i>잔악무도한</i> 짓을 저지를 거랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 04a3bdf0-3311-2609-5ae6-40c2b091791b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:04a3bdf0-3311-2609-5ae6-40c2b091791b
msgctxt "hfacf7d30g5a44g4943g9cc8g28acb493b747"
msgid ""
"And kill you will. Tonight, the moment you close your eyes, your favourite "
"person will be brutalised."
msgstr "그 살육은 이루어질 겁니다. 오늘밤, 주인님이 눈을 감는 순간 당신이 가장 애정하는 사람의 사지가 찢겨나가겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 07acdc8e-3511-f584-53aa-5d072255bb2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:07acdc8e-3511-f584-53aa-5d072255bb2c
msgctxt "hd760d9adg8a41g4fc3gb4eeg097c05ee0fef"
msgid ""
"You could kill this one deliberately. I'm sure it will be considered a great "
"show of good will. The tithe could still be yours."
msgstr "이 녀석은 의도적으로 죽이시는 게 어떨까요. 의지가 있는 훌륭한 모습을 보여주는 겁니다. 아직 계승의 여지가 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 08fbe1e8-c6e9-c50b-fa01-fed97c24b83f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:08fbe1e8-c6e9-c50b-fa01-fed97c24b83f
msgctxt "heea420e7g0190g4c10gaf4bgf520c029a442"
msgid ""
"You can try to deceive me all you wish - you cannot deceive your own heart."
msgstr "절 속이려 해도 소용없습니다. 자신의 마음마저 속일 수는 없으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 0aed61eb-f357-59d6-63aa-80c757c1cf38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:0aed61eb-f357-59d6-63aa-80c757c1cf38
msgctxt "h23043570g5f80g4979gbe2ege05ec59eab4f"
msgid ""
"Had you excelled instead of resisted, you would have received a disgusting "
"Prize already. But it's not too late yet."
msgstr "당신이 저항하는 대신 뛰어남을 보였더라면, 이미 한참 전에 징그러운 상을 받았을 겁니다. 하지만 아직 늦지 않았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 0ce6c71b-6256-e640-9c6f-df36dce47d8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:0ce6c71b-6256-e640-9c6f-df36dce47d8f
msgctxt "h6b9a092bg9b3fg403cg9175g2df730806175"
msgid "You are wrong to consider another your equal."
msgstr "다른 이를 당신과 동등한 존재로 여기신다면 착각하시는 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 0d5f7ff7-149a-c191-c0bb-5b14e3e9914c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:0d5f7ff7-149a-c191-c0bb-5b14e3e9914c
msgctxt "ha1ae4f70gd0b5g4cb9g9ac1g6041af8f29ca"
msgid "An example must be set."
msgstr "본보기를 보여야만 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 0ddfdbf9-86a6-19d9-5e49-4ad86802554f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:0ddfdbf9-86a6-19d9-5e49-4ad86802554f
msgctxt "h384e931dg9f8eg4395g88c7gcdc621420d61"
msgid "<i>Leave and go back to sleep.</i>"
msgstr "<i>내버려두고 도로 잠든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 0e86aa0e-79bb-8521-4a8c-77eff49f9d67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:0e86aa0e-79bb-8521-4a8c-77eff49f9d67
msgctxt "h7c334ad0g7b32g4776ga71ag424b191b9d81"
msgid "*The corpse feels carefree, peaceful, and loving to linger beside.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 10510901-3abd-45c5-f7bd-433897f6912b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:10510901-3abd-45c5-f7bd-433897f6912b
msgctxt "h6ab8b2a3gb297g4b94gb0e7gb979d1662856"
msgid "Madness will take over my body against my will, and I will kill you."
msgstr "곧 저항할 수 없는 광기가 내 몸을 잠식해서, 널 죽이려 들 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 151f164b-3116-1cbe-3d14-1994326dafbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:151f164b-3116-1cbe-3d14-1994326dafbc
msgctxt "h93cb0398g2350g41e5g9adbg0c6658b484ef"
msgid "Do you know who I am?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 1905beac-ed46-9eed-98be-b474add13cdf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1905beac-ed46-9eed-98be-b474add13cdf
msgctxt "h7f87d641g3bb0g494egb69eg97395cd1d869"
msgid ""
"*As your hand approaches his body, it wavers. It longs to close around his "
"throat.*"
msgstr "*뻗어나가던 당신의 손이 흔들립니다. 손가락이 목을 조르길 원하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 1905beac-ed46-9eed-98be-b474add13cdf
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1905beac-ed46-9eed-98be-b474add13cdf
msgctxt "h4b608cc1gc454g421cg83dag4c1ccae18a56"
msgid ""
"*As your hand approaches her body, it wavers. It longs to close around her "
"throat.*"
msgstr "*뻗어나가던 당신의 손이 흔들립니다. 손가락이 목을 조르길 원하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1a868186-0b58-6a97-88cf-38560b2c149a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1a868186-0b58-6a97-88cf-38560b2c149a
msgctxt "h1c5818ddg67d0g47b3gad58g8a1ec0b6b1cb"
msgid "Each man kills the thing he loves."
msgstr "사람은 자고로 사랑하는 것을 죽이는 법입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 1a868186-0b58-6a97-88cf-38560b2c149a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1a868186-0b58-6a97-88cf-38560b2c149a
msgctxt "h6c4e6341g3313g4aabg8eecg44ee8c86652d"
msgid "We all kill what we love most, in time."
msgstr "우리 모두는 가장 사랑하는 것을 죽이죠. 언젠가는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 1b94e6f2-8690-644e-8ba0-bd9e3e9dc4af
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1b94e6f2-8690-644e-8ba0-bd9e3e9dc4af
msgctxt "h7e07c8d5gf0eag40e4g9f98g5bb92dfb552d"
msgid "*With almost no struggle, he has gone out like a light.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 1b94e6f2-8690-644e-8ba0-bd9e3e9dc4af
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1b94e6f2-8690-644e-8ba0-bd9e3e9dc4af
msgctxt "h00d5c20ag91c2g470aga4c5g6dfc95237382"
msgid "*With almost no struggle, she has gone out like a light.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 1c31a6ad-7a98-00d9-db4f-340f3b8ee102
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1c31a6ad-7a98-00d9-db4f-340f3b8ee102
msgctxt "h0889751bg6c87g42b3g89aag7b50523e9a79"
msgid "Your blood will clot for me like liquid rubies."
msgstr "네 엉긴 피가 핏빛 보석처럼 맺힐 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 1e9c5a62-f4ef-b534-1242-6131d0e26775
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:1e9c5a62-f4ef-b534-1242-6131d0e26775
msgctxt "h6e65608ag1395g4db9g8054g6ac4fcd6498f"
msgid "I'm going mad, aren't I?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 20a43d53-1dc6-7973-5141-24cdf8db55f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:20a43d53-1dc6-7973-5141-24cdf8db55f6
msgctxt "h476b2cecg7a91g459dg9a2cgf7ef06b5b527"
msgid "<i>Kill him.</i>"
msgstr "<i>죽인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 20a43d53-1dc6-7973-5141-24cdf8db55f6
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:20a43d53-1dc6-7973-5141-24cdf8db55f6
msgctxt "h13f9a944g41e0g41b7g8979g4c61f55f84f6"
msgid "<i>Kill her.</i>"
msgstr "<i>죽인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 248516e8-1d51-6aae-4038-707d59ac1b1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - ORI_DarkUrge_Knows_ButlerDied(1) = True
#.      - ORI_DarkUrge_Knows_ButlerDiedReaction(1) = False
#. SetFlags:
#.   User:
#.     - ORI_DarkUrge_Knows_ButlerDiedReaction(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:248516e8-1d51-6aae-4038-707d59ac1b1c
msgctxt "hf1a22968gfe98g4a8bga783gb5e5599d2595"
msgid "Didn't you die?"
msgstr "너는 죽지 않았던가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 249cb9dc-3a31-81d7-5b15-c05a2fa5c74a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:249cb9dc-3a31-81d7-5b15-c05a2fa5c74a
msgctxt "h25c956beg2ca6g48c9g953fg10f3ac63d454"
msgid "What in the Hells do you want?"
msgstr "넌 대체 원하는 게 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 260b40a5-e955-d561-9791-b443916b706b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:260b40a5-e955-d561-9791-b443916b706b
msgctxt "h4e0d0fdeg993dg4aadga62bg398c50d2b0f1"
msgid ""
"Should this inner fiend seek battle again, I'll give it one. Let it taste "
"the edge of the Blade."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 260b40a5-e955-d561-9791-b443916b706b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:260b40a5-e955-d561-9791-b443916b706b
msgctxt "h6aadd7b9g31dfg4bdbgb4e1g6a982c91cf94"
msgid ""
"We'll get through this together. I'll protect us. And we'll skip through "
"fate like two truants on the beach at midday."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 260b40a5-e955-d561-9791-b443916b706b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:260b40a5-e955-d561-9791-b443916b706b
msgctxt "hbc930600g9088g468agb476g7136ea33926e"
msgid "This is surmountable, I'm sure. I'll protect you until you prevail."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 260b40a5-e955-d561-9791-b443916b706b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:260b40a5-e955-d561-9791-b443916b706b
msgctxt "h43920783g7a28g4d98g9be9ge45c74e0a7d8"
msgid ""
"You are not alone in this - none of us are. We can even compare notes if you "
"like."
msgstr "너 혼자 해결해야 하는 문제가 아니야. 우리 문제가 다 그렇지. 괜찮으면 서로 해법이라도 공유하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 260b40a5-e955-d561-9791-b443916b706b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:260b40a5-e955-d561-9791-b443916b706b
msgctxt "h6fb0d237g85fcg43bcg9dcfgc98ff13d2e4d"
msgid "Whenever this Urge strikes next, we will fight it and we will win."
msgstr "이 충동이 또 찾아온다면, 우리는 하나되어 같이 싸울 거다. 그리고 이긴다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 260b40a5-e955-d561-9791-b443916b706b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:260b40a5-e955-d561-9791-b443916b706b
msgctxt "h5e3fbc53g9bacg43ccg93beg875e1573b8c1"
msgid ""
"I'll help protect you, I promise. Seems I'll need to, just to keep myself "
"safe."
msgstr "널 보호하는 걸 도울게. 약속해. 내 안위를 위해서라도 그래야 할 것 같고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 27be1940-9c82-89a4-fda2-9bfbe866bda8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternativeInSleep = True
#.      - NIGHT_DarkUrge_MurderOfAlfira = True
#. SetFlags:
#.   Local:
#.     - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_ConfessedAlfiraMurder = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:27be1940-9c82-89a4-fda2-9bfbe866bda8
msgctxt "h3063d31bg85dbg454bg8657ge1f8d18cc146"
msgid ""
"The beast that killed Alfira will call again - my possessed mind will kill "
"you."
msgstr "알피라를 죽인 짐승이 다시 찾아올 거야. 내 정신이 악령에 씌어 널 죽일 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 2aa69415-4fb3-2e2d-ea5b-f6cbfc4489b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#.      - REALLY_WYLL(1) = True
#. TagRule: WYLL_DEVIL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2aa69415-4fb3-2e2d-ea5b-f6cbfc4489b3
msgctxt "he281bf5dgf506g485ega180g68a468fd8e67"
msgid ""
"He is an insult to the name of devils, posing as a monster with that sickly "
"good heart."
msgstr "데빌이라는 이름에 먹칠을 하는 자 아닙니까. 그렇게 불쾌하게 선한 심성으로 괴물의 형상을 하고 있다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
msgctxt "h742fa502gffbag4812g95e7g368b4a6052a2"
msgid ""
"Glad you're all right. Get some rest, and may only the sweetest spirits "
"haunt your dreams."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
msgctxt "hc2cf4a76g18b1g448fg889fg9eee9b0c138d"
msgid ""
"Must've been a doozy. Look after yourself, all right? And wake me up again "
"if you can't sleep."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
msgctxt "h1040ac39g3338g4926ga69eg0764c3338aae"
msgid ""
"Hmm. All right, then. Hopefully there's no more interludes before daybreak."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
msgctxt "haedce0c8gd1bfg4072gb5b9g54185f8ebf4e"
msgid "All right, if you're sure. We can always talk about it in the morning."
msgstr "알았어, 네가 확실하다면. 아침에 언제든지 다시 얘기해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
msgctxt "h879ac8b6g1552g48b8gaa8cg2612becbb3d9"
msgid "Fine. Good night, then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2c43fdfe-eeee-34cf-cc23-4db2cfbf23ea
msgctxt "h4cb27224g8ac6g4166gb94dg9fa549e786fc"
msgid "All right, then... Maybe if it happens again, try pinching yourself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
msgctxt "hd530a924g08efg45bfg8dccg6d120fa48c28"
msgid "How are you feeling? Talk to me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
msgctxt "h5fc643fag2286g4420gb20bg2954d8f77725"
msgid "That you in there, love?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
msgctxt "h23917d33gc1b8g4bd1gac13gedf8376f4d90"
msgid ""
"Welcome back to the land of the lucid - where explanations are owed, if you "
"don't mind."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
msgctxt "h31e910d9gd87ag4c72ga471gb46c93659b54"
msgid "Now that you're back with us, we need to have a talk."
msgstr "이제 네가 제정신으로 돌아왔으니, 얘기를 좀 해볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
msgctxt "h3c6041bbg1715g4af7g91e7gf9b2ebc9b828"
msgid "Not to be maudlin, but I'm glad I didn't gut you. Now: answers."
msgstr "감상적인 소리를 하기는 싫지만, 널 갈라버리지 않아서 다행이다. 이제, 해명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2ee7f304-bf0b-0d7d-1cbc-e3b120a8c771
msgctxt "h82dbc106ge88bg46c3gbf73g2ec6492301f4"
msgid ""
"I think some more explaining is in order. Exactly what just came over you?"
msgstr "이제 좀 설명이 필요할 것 같은데. 밤에 대체 뭐에 씌었던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 2f3337c1-c5b4-8d0a-edc9-6f3c5c85614f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:2f3337c1-c5b4-8d0a-edc9-6f3c5c85614f
msgctxt "h464aaf5eg79dbg40ffg9dcagc33380d84c2f"
msgid "There's no chance in the Hells I'm going to kill my companion."
msgstr "아홉 지옥이 얼어붙어도 내가 동료를 죽일 일은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 3124b001-f570-d96a-82c1-9e1c13c02ef6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:3124b001-f570-d96a-82c1-9e1c13c02ef6
msgctxt "ha3932210g0c82g40ecg9016g0bfbc374aa12"
msgid ""
"He is so afraid. So, so afraid. Of everyone, besides <i>you</i>, who he "
"ought to fear most."
msgstr "참으로 두려워하는군요, 정말로. 이 세상 모두를 무서워합니다. 정작 가장 두려워해야 할 <i>주인님만</i> 빼고 말이지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 33424a72-a854-36b8-24ea-aa216ad2683b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:33424a72-a854-36b8-24ea-aa216ad2683b
msgctxt "h9b9b76f1g8bd4g410cgaee6gba7ffe3a773b"
msgid "No. I'll kill Isobel instead, if I need to kill someone."
msgstr "아니. 누구를 죽여야 한다면 차라리 이소벨을 대신 죽일게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 33424a72-a854-36b8-24ea-aa216ad2683b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:33424a72-a854-36b8-24ea-aa216ad2683b
msgctxt "h1a74886fgbf45g4efbg83fbg16f966eb845b"
msgid "No. I'll kill the cleric instead, if I need to kill someone."
msgstr "아니. 누구를 죽여야 한다면 차라리 그 사제를 대신 죽일게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 3393f2e8-aa69-fd99-375b-dbcc5836c7ae
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:3393f2e8-aa69-fd99-375b-dbcc5836c7ae
msgctxt "hbd48286cg998bg4568g8f0cg7b3f92b8971f"
msgid "<i> Resist and try to express understanding.</i>"
msgstr "<i>저항하며 이해했다는 것을 표현하려 시도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 353871e4-1a9f-d5bc-9d8c-bd5cd285d2c7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteHalsin = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:353871e4-1a9f-d5bc-9d8c-bd5cd285d2c7
msgctxt "hf6b88200geb34g4cebga3c8g01a8993d3373"
msgid "You've judged my affections wrongly - I am much closer to Halsin!"
msgstr "내 감정을 잘못 재단했군. 난 할신에게 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 353871e4-1a9f-d5bc-9d8c-bd5cd285d2c7
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteHalsin = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:353871e4-1a9f-d5bc-9d8c-bd5cd285d2c7
msgctxt "hcd8a948fg1dc4g4949g8d2cgf738d7220bb9"
msgid "I am much closer to Halsin!"
msgstr "난 할신이랑 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 365c2938-958d-9911-94e4-7a501fdefd9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:365c2938-958d-9911-94e4-7a501fdefd9d
msgctxt "hdaa28f32g04e2g401cgb369gf4eab8749e83"
msgid "Cease this insubordination. You serve <i>me</i>."
msgstr "이 불손한 행동은 그만둬. 넌 <i>내 명령을</i> 따른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 36aa4f6a-8890-9a92-e43f-9f24f6b9947a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:36aa4f6a-8890-9a92-e43f-9f24f6b9947a
msgctxt "hf806f519g924cg4317gb266g564bfd0f463c"
msgid "<i>Surrender to the Urge. Do your worst.</i>"
msgstr "<i>충동에 굴복한다. 어디 해 보라고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 389771d0-f334-5e1c-0271-cdcd43a5be4b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:389771d0-f334-5e1c-0271-cdcd43a5be4b
msgctxt "h7bcd5c19gdb75g45a7g9511g7e497b083d54"
msgid ""
"*As soon as you raise the dagger, all doubts disappear from your mind, "
"replaced by pure pleasure.*"
msgstr "*단검을 들어올리는 순간, 정신을 괴롭히던 의구심이 씻은 듯이 사라지며 순수한 희열만이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 3c7a80f8-b494-f2b5-ccce-985b4930b457
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:3c7a80f8-b494-f2b5-ccce-985b4930b457
msgctxt "h15d8a669gd305g4031g9c7bg61bc6a16749f"
msgid "<i>Resist. Wake him up.</i>"
msgstr "<i>저항한다. 깨워야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 3c7a80f8-b494-f2b5-ccce-985b4930b457
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:3c7a80f8-b494-f2b5-ccce-985b4930b457
msgctxt "h3ee38186g05e2g4a7fgbecbg50774219ceb2"
msgid "<i>Resist. Wake her up.</i>"
msgstr "<i>저항한다. 깨워야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 3cff3183-5127-d53e-3f27-fd35847f4ab4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:3cff3183-5127-d53e-3f27-fd35847f4ab4
msgctxt "h654adb65gfaabg4aa2gaeadg6c9114c5da83"
msgid ""
"I'm going to kill the person I care most about: you. Unless you can stop me."
msgstr "난 곧 내가 가장 아끼는 사람을 죽이게 될 거야… 너를. 네가 날 막아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 3d0e4b6a-2d24-fd8e-af90-3d3edde20bf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:3d0e4b6a-2d24-fd8e-af90-3d3edde20bf7
msgctxt "hc3817af9ge30cg40acg8e83g1795ed1d83bf"
msgid "I didn't lay a finger on Isobel. I can control myself."
msgstr "난 이소벨에게 손가락 하나 대지 않았어. 나 자신을 통제할 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 401134ee-1e5b-b9c0-927d-eb4b031c1c40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:401134ee-1e5b-b9c0-927d-eb4b031c1c40
msgctxt "h4a3191e0g8c3cg42e3gab6fg9c4ecda2b96d"
msgid ""
"You know there is murder slumbering within you, and in controlling it, it "
"has grown <i>insatiable</i>. Your Dark Urge will have death tonight, one way "
"or another."
msgstr ""
"당신 안에 살육이 잠들어 있다는 것은 아시죠. 주인님이 통제하려 한 탓에, 이제는 <i>갈증을</i> 느끼고 있습니다. 어두운 충동은 "
"오늘밤 어떻게든 죽음을 맛보아야만 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 42a793ec-db11-9ee8-1731-f9485886fe1f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:42a793ec-db11-9ee8-1731-f9485886fe1f
msgctxt "ha06da34cga3ceg4449ga5a6g56d75120f2cb"
msgid "Maybe we still can. There's yet to be a storm we couldn't weather."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 42a793ec-db11-9ee8-1731-f9485886fe1f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:42a793ec-db11-9ee8-1731-f9485886fe1f
msgctxt "hf650fed4g9ea4g4a8fg8175ga48860f1c94d"
msgid "That's what we do. We help each other. Right?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 42a793ec-db11-9ee8-1731-f9485886fe1f
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:42a793ec-db11-9ee8-1731-f9485886fe1f
msgctxt "h3eec8c20gbd76g4263g9875gad53d7c6892e"
msgid ""
"What is it? A curse? Compulsion? Enthrallment? Whatever it is, we're going "
"to free you of it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 42a793ec-db11-9ee8-1731-f9485886fe1f
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:42a793ec-db11-9ee8-1731-f9485886fe1f
msgctxt "hfc38abbdg559cg4b43gb768g9ed17cf23b95"
msgid ""
"Whatever it is that's controlling you, we can fight it. I know that better "
"than anyone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 42a793ec-db11-9ee8-1731-f9485886fe1f
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:42a793ec-db11-9ee8-1731-f9485886fe1f
msgctxt "hfccece3fg7971g449fg92ddg527ef6731588"
msgid ""
"We have too many battles before us. I will not have you falling to bloody "
"<i>madness</i>."
msgstr "우리에겐 아직 치를 전투가 많이 남아 있어. 이딴 <i>광기</i> 따위에 쓰러지게 두진 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 42a793ec-db11-9ee8-1731-f9485886fe1f
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:42a793ec-db11-9ee8-1731-f9485886fe1f
msgctxt "hde2ef4f0g61ffg4ca2g8daaga0257016fd6d"
msgid ""
"Seems like some sort of curse - the last bloody thing we need. But we're "
"going to help you through this, together."
msgstr "일종의 저주인 것 같네. 지금 이딴 데 기력을 허비할 때가 아닌데. 어쨌든 이걸 풀도록 도와줄게. 같이 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 42c17acb-2610-3e65-e602-46ea123f6c8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:42c17acb-2610-3e65-e602-46ea123f6c8b
msgctxt "hb3efd4d7gc890g433ag9697gf3a7e9ad8ff0"
msgid ""
"Oh, <i>rather</i>. Can't you tell how the Urge is thickening? You have been "
"altogether too good to appease it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 4365e4b3-2a5d-434b-12a4-e81cca2ea5da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4365e4b3-2a5d-434b-12a4-e81cca2ea5da
msgctxt "ha8290badg06c2g40d4ga1bfgc3de8f97c590"
msgid "*Your companions sleep like blissful lumps of meat.*"
msgstr "*당신의 동료들은 순진한 고깃덩이답게 세상 모르고 자고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 43b95fa4-d72d-96d4-ea27-19c1992825e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:43b95fa4-d72d-96d4-ea27-19c1992825e8
msgctxt "h077c1017gffa9g486bga4f5ga06e6ad37637"
msgid "One of your station has no equal to call a friend."
msgstr "주인님 같은 신분에게 친구라고 할 동등한 상대가 어디 있겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 44c6ce4f-fd40-ab67-0d3b-26848c5a9ff5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:44c6ce4f-fd40-ab67-0d3b-26848c5a9ff5
msgctxt "h6e02116fg0a70g4bdbg899ag76294469face"
msgid ""
"So all those sweet words were said in the hope of lying with him? Hah! A "
"fine performance, O my itching liege!"
msgstr "그렇다면 그 달콤한 말은 전부 다 같이 눕기 위해 꾸며낸 거짓말이었군요? 하! 훌륭한 연기력이십니다, 욕망의 군주시여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 44c6ce4f-fd40-ab67-0d3b-26848c5a9ff5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:44c6ce4f-fd40-ab67-0d3b-26848c5a9ff5
msgctxt "h226804d8g67fbg4e57g8d66g69035864b0e8"
msgid ""
"So all those sweet words were said in the hope of lying with her? Hah! A "
"fine performance, O my itching liege!"
msgstr "그렇다면 그 달콤한 말은 전부 다 같이 눕기 위해 꾸며낸 거짓말이었군요? 하! 훌륭한 연기력이십니다, 욕망의 군주시여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 46c99d0a-9542-5992-2fb8-9f31dad136a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:46c99d0a-9542-5992-2fb8-9f31dad136a8
msgctxt "h3ce2011fgdf11g4663g9752g37c646da48b3"
msgid "The gods fight over her, but is she truly that special?"
msgstr "신들이 이 여자를 두고 다투지만, 과연 정말 그렇게 특별할까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 488703c8-3962-fcf8-7ac9-8da8294d2bc2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Camp_Event_SkipSleepCutscene = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:488703c8-3962-fcf8-7ac9-8da8294d2bc2
msgctxt "h68539fb7g5f1dg4068ga651g15a7cb747d6c"
msgid "*The night passes sick and sweating, but bloodlessly.*"
msgstr "*그렇게 땀과 고통으로 얼룩진 밤이 지나가지만, 피는 찾아볼 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 4a59d0b0-7cb7-913a-83f9-0c3dbcd0ecff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4a59d0b0-7cb7-913a-83f9-0c3dbcd0ecff
msgctxt "h90275db7ga4d9g43b1gbdfdg9e426015b6dd"
msgid ""
"Oh, Master! Still as thirsty as ever. But tonight you should concentrate "
"your efforts on another."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 4c6de8bf-a039-3ec9-ed43-74256aac1f08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithWyll(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_InRomanceWithSparedIsobelVictim = True
#.   Local:
#.     - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4c6de8bf-a039-3ec9-ed43-74256aac1f08
msgctxt "h2bbe0271g1513g444fga9c2gda91a17dce45"
msgid "You could do so much better, Milord."
msgstr "주인님은 이보다 훨씬 더 잘할 수 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 4c6de8bf-a039-3ec9-ed43-74256aac1f08
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithWyll(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_InRomanceWithSparedIsobelVictim = True
#.   Local:
#.     - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4c6de8bf-a039-3ec9-ed43-74256aac1f08
msgctxt "h5fb9e574g7c0fg4fdag8c03g96d676183aea"
msgid "You could do so much better, Milady."
msgstr "주인님은 이보다 훨씬 더 잘할 수 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 4c6de8bf-a039-3ec9-ed43-74256aac1f08
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithWyll(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_InRomanceWithSparedIsobelVictim = True
#.   Local:
#.     - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4c6de8bf-a039-3ec9-ed43-74256aac1f08
msgctxt "hb09db496g47e4g4e51ga735g0731ee5dafda"
msgid "You could do so much better, Master."
msgstr "주인님은 이보다 훨씬 더 잘할 수 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 4c877b23-0e9c-7282-a6ad-9ff12939a01e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4c877b23-0e9c-7282-a6ad-9ff12939a01e
msgctxt "h0aad44f3g7fecg4e7bgba1bg8d9278575ddb"
msgid ""
"<i>Confess everything: you have been fiercely fighting against your Dark "
"Urge.</i>"
msgstr "<i>모든 것을 털어놓는다. 지금까지 어두운 충동에 치열하게 맞서 싸우던 중이었노라고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 4e0f714c-ee71-d0d4-1e31-278c389b2d67
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4e0f714c-ee71-d0d4-1e31-278c389b2d67
msgctxt "hccbc3207g808fg417agb3e5g9f400c922b63"
msgid "He must live - I haven't yet told him how I truly feel about him."
msgstr "지금 죽을 수는 없어, 아직 내 진짜 감정을 말도 못 해줬단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 4e0f714c-ee71-d0d4-1e31-278c389b2d67
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4e0f714c-ee71-d0d4-1e31-278c389b2d67
msgctxt "hcccb12f0g5d5dg4f85ga441g54d9c5f23d05"
msgid "She must live - I haven't yet told her how I truly feel about her."
msgstr "지금 죽을 수는 없어, 아직 내 진짜 감정을 말도 못 해줬단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 4f39cc64-b601-dc08-445e-8b587c184ebc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4f39cc64-b601-dc08-445e-8b587c184ebc
msgctxt "h6e9562fcg4fd2g4ee9g87c0geedbfbaa3a8f"
msgid ""
"A wicked wretch came to me in the night, and told me something horrible."
msgstr "방금 사악한 괴물이 밤중에 찾아와서 끔찍한 사실을 알렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 4f4b94fe-00e6-85ee-78a8-0454e450df47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4f4b94fe-00e6-85ee-78a8-0454e450df47
msgctxt "he9845b18g6375g4c3egb9d4gd8ee36f8b3c1"
msgid ""
"*Your hands are raw and bloody as every inkling of your Urge yearns to tear "
"your bindings.*"
msgstr "*당신의 충동이 전력을 다해 밧줄을 뜯어내려고 하는 바람에, 손은 벗겨지고 피로 물들었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 4ff6bc8e-cfb0-4738-8da0-45d0cdb58899
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:4ff6bc8e-cfb0-4738-8da0-45d0cdb58899
msgctxt "h31701c82g17bbg48b8g88f4ge4c31e3de2b3"
msgid ""
"*Your stomach churns around and around. The bile within is unsettled. Each "
"moment brings a new surge.*"
msgstr "*배가 끊임없이 울렁거리고 들쑤십니다. 뱃속의 증오는 가라앉을 줄을 모르며, 매 순간 파도처럼 정신의 해안을 두드립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51049669-dd0b-ccca-f2a7-2c20deb7ade8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51049669-dd0b-ccca-f2a7-2c20deb7ade8
msgctxt "h29d4c36cgea64g4beag987dge72a0f5f1348"
msgid "You've got my attention."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51049669-dd0b-ccca-f2a7-2c20deb7ade8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51049669-dd0b-ccca-f2a7-2c20deb7ade8
msgctxt "h4f1caae3ge30bg4487gb651g25ebd7c6fcfd"
msgid "Tell me what to do, and it's done."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51049669-dd0b-ccca-f2a7-2c20deb7ade8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51049669-dd0b-ccca-f2a7-2c20deb7ade8
msgctxt "he899b044g7fc1g4a2egab85gab2486f5a2f9"
msgid ""
"I see... fast as in right now, I assume, rather than 'first light after some "
"sleep' fast? You'd better tell me all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51049669-dd0b-ccca-f2a7-2c20deb7ade8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51049669-dd0b-ccca-f2a7-2c20deb7ade8
msgctxt "h790047f9g0823g4390gb60bg09a95ae865a9"
msgid "All right, talk quickly, then."
msgstr "알았어. 어서 말해 봐, 그럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51049669-dd0b-ccca-f2a7-2c20deb7ade8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51049669-dd0b-ccca-f2a7-2c20deb7ade8
msgctxt "h2369c1e8gc70bg4859gbdaeg96e324829533"
msgid "Point me the way, and I will scrape my enemy's skin from its body."
msgstr "해야 할 일을 알려줘라. 적의 피부를 도려내줄 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51049669-dd0b-ccca-f2a7-2c20deb7ade8
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51049669-dd0b-ccca-f2a7-2c20deb7ade8
msgctxt "h3fa567b8gb790g41c6gb03egef4662052580"
msgid "All right, I'm awake. Tell me everything."
msgstr "알았어. 잠 깼으니까, 다 얘기해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51a894b4-b7c4-0070-1c5d-448e243a977f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51a894b4-b7c4-0070-1c5d-448e243a977f
msgctxt "h82fd1f26g640cg4e3ag81c4gbfb034c3f44d"
msgid ""
"Looks like you're back to your old self. Poor Alfira - if only she'd been so "
"lucky."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51a894b4-b7c4-0070-1c5d-448e243a977f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51a894b4-b7c4-0070-1c5d-448e243a977f
msgctxt "h1a5daad3g3b8dg407bg976cg7dcbe589e3a9"
msgid "Here we are, both un-Alfira'd."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51a894b4-b7c4-0070-1c5d-448e243a977f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51a894b4-b7c4-0070-1c5d-448e243a977f
msgctxt "h19d9d82ag2c7eg4f2fga217g8669c1be7b54"
msgid ""
"I think I see the madness slipping from your eyes. Looks like I won't be "
"joining Alfira just yet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51a894b4-b7c4-0070-1c5d-448e243a977f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51a894b4-b7c4-0070-1c5d-448e243a977f
msgctxt "h9552c91eg0bf5g492ag842ag6838fa45f307"
msgid ""
"I felt for the bard, seeing you like that. Poor Alfira never stood a chance, "
"did she?"
msgstr "네가 변했던 모습을 보니 그 바드가 가엾어지네. 불쌍한 알피라는 기회조차 없었겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51a894b4-b7c4-0070-1c5d-448e243a977f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51a894b4-b7c4-0070-1c5d-448e243a977f
msgctxt "h045e5967gf5c9g4ec7ga258g85d05c2c132c"
msgid ""
"<i>Chk.</i> Lucky for us, we're still standing. Can't say the same for "
"Alfira."
msgstr "<i>츠크.</i> 다행히 모두 아직 살아 있군. 알피라는 그러지 못했지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 51a894b4-b7c4-0070-1c5d-448e243a977f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_MurderOfAlfira_Alternative = False
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:51a894b4-b7c4-0070-1c5d-448e243a977f
msgctxt "h4ad24306gdd31g4999g8f37g25aef50bf5eb"
msgid "Are you back to yourself...? Hells, Alfira didn't stand a chance..."
msgstr "다시 돌아온 거야...? 망할, 알피라는 가망이 없었구나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 52fb8b9a-a113-99a1-a403-e98d5f864624
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteKarlach = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:52fb8b9a-a113-99a1-a403-e98d5f864624
msgctxt "h9b41ae58ga57dg40f3g8b5eg7bcb4d592763"
msgid "You've judged my affections wrongly - I am much closer to Karlach!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 56a6336b-5a0f-e710-bbb6-bd8619c2659b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:56a6336b-5a0f-e710-bbb6-bd8619c2659b
msgctxt "hacb120bfg7424g4c01gbd2cgbac9c9cc582f"
msgid ""
"*Suddenly you become drowsy. Your vision blurs and floods with yellow bile, "
"and you faint in a dizzy blur.*"
msgstr "*갑자기 정신이 혼미해집니다. 시야가 뿌연 안개로 누렇게 흐려지고, 당신은 의식을 잃고 기절합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 573a14b8-7221-4435-ea13-867dee53f346
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:573a14b8-7221-4435-ea13-867dee53f346
msgctxt "hbb2e3bbdg439eg4bbbg9ac1ge610965387a0"
msgid "You should've told me sooner. We could've figured something out."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 573a14b8-7221-4435-ea13-867dee53f346
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:573a14b8-7221-4435-ea13-867dee53f346
msgctxt "h27aeb6e5gdf50g4b1cga0d0gd3f6ce8e5b40"
msgid ""
"But why didn't you tell me before? I could've helped you sooner - like "
"you've helped me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 573a14b8-7221-4435-ea13-867dee53f346
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:573a14b8-7221-4435-ea13-867dee53f346
msgctxt "h54f1a175gd0d9g4a9bg9a25g4156a753573d"
msgid ""
"We're in this together, theoretically. You should have confided in me sooner."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 573a14b8-7221-4435-ea13-867dee53f346
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:573a14b8-7221-4435-ea13-867dee53f346
#, fuzzy
msgctxt "hb7c707f6g5be9g4c69g8aa5gb82b75b7a6ab"
msgid ""
"You could have talked to me before things got murderously bad, you know. We "
"are technically in this together."
msgstr "일이 이 정도로 심각해지기 전에 나한테 얘기했어야지. 우리는 함께 하고 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 573a14b8-7221-4435-ea13-867dee53f346
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:573a14b8-7221-4435-ea13-867dee53f346
msgctxt "h5bfc6c2bg15f5g4f89gb4b4gcd57cc44d537"
msgid "This is no new affliction, is it? To think you'd keep this from me."
msgstr "새로 생긴 병은 아닌가 보지? 이런 걸 말도 안 하고 숨기고 있었다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 573a14b8-7221-4435-ea13-867dee53f346
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:573a14b8-7221-4435-ea13-867dee53f346
msgctxt "h3b75e5dbg88bdg4f7eg82edg93fe71fbbcbb"
msgid ""
"I'd rather you'd trusted me sooner, given all we've been through already."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5883da61-8ed2-6c0c-e8d9-54e7aadfef06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5883da61-8ed2-6c0c-e8d9-54e7aadfef06
msgctxt "hf3186303gd46eg4e6cg98f4g3db5c5e0fdfa"
msgid "<i>Recount your Urges, holding your past life responsible.</i>"
msgstr "<i>충동을 되새기며, 과거의 삶을 원인으로 지목한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 5bd88ccb-09aa-b220-9e11-3a71cf28901f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_LeastFavouriteJaheira = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5bd88ccb-09aa-b220-9e11-3a71cf28901f
msgctxt "he9d13fdcg5f34g4553ga839gde9e7ccdeb52"
msgid "You've judged my affections wrongly - I am much closer to Jaheira!"
msgstr "내 감정을 잘못 재단했군. 난 자헤이라와 훨씬 더 가까워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
msgctxt "hc3a33915g359bg42a6gaa92g9a37e9115016"
msgid ""
"You're not in your right mind. There are healers in the city, clerics who "
"can help."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
msgctxt "hc2abe830g0d90g45fbgb8ceg4668f6988186"
msgid "Look - we'll do whatever it takes to keep us both safe. I promise."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
msgctxt "h3c772966g4a92g4f21g9ea6g098c1845d27d"
msgid ""
"Dangerous secrets are best shared with those who depend on you. I should "
"know."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
msgctxt "ha9a0ecf7gc1dbg41c8g8188g2a1c3cbcf7fd"
msgid ""
"You're welcome to try and kill me, of course, but I don't die easily these "
"days."
msgstr "물론 얼마든지 나를 죽이려 시도해도 좋지만, 요즘 나는 쉽게 죽어주지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
msgctxt "h53768830g4ae6g4fe5gaf78g510953824ea8"
msgid ""
"You're suffering - I see it. Perhaps the shadow curse still lingers? No. You "
"are more than cursed. You are <i>taken</i>."
msgstr "고통받는 게 보인다. 그림자 저주가 아직도 남아있는 건가? 아니, 저주 정도가 아니군. 몸을 <i>빼앗겼어</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5e2a3bcb-2f6a-d5ef-80a2-6e7e51a4ff58
msgctxt "hf40a406eg427dg45b6ga40bg3389e001e572"
msgid ""
"How long has this been going on? Do I even want to know the answer to "
"that...?"
msgstr "얼마나 오랫동안 이래왔던 거야? 내가 답을 들으면 물어본 걸 후회하려나...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 5e4351da-b7b3-321c-4bbc-09d1ee1fa627
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:5e4351da-b7b3-321c-4bbc-09d1ee1fa627
msgctxt "h8f80ecc1g6d9ag47e6g9f64g0c8c2575090c"
msgid "You are allowed to hate me for this."
msgstr "이제 날 미워해도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 60220963-eacf-8c79-6155-3bc826b6924c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:60220963-eacf-8c79-6155-3bc826b6924c
msgctxt "ha3c9d8acg311dg4da2g931dg92f56b7c6283"
msgid "*Your jaw convulses, and you almost bite off your own tongue.*"
msgstr "*턱이 경련을 일으키고, 혀를 씹어 동강낼 뻔 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
msgctxt "h98d8291agc620g4d2egaccbgc3801e067103"
msgid "The fiend strikes. Punish it, warrior. It's come for the slaughter!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
msgctxt "hc1f03bceg184eg4a06gb5b0gaa1e8ced997b"
msgid "Ah, soldier, what are you even on about?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
msgctxt "h8197f497g6f1eg454agb427gc3f8e6a1d72b"
msgid ""
"There will be no gorging of any sort until breakfast - understood? Stay with "
"me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
msgctxt "h6999359cg15ecg43b6gbf8fg138949312b5b"
msgid "Of course they will, dear. Now just relax, dawn will be here soon."
msgstr "그래, 맞아. 그러니까 이제 쉬어. 곧 해가 뜰 거야. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
msgctxt "h26e9eb32g6ddfg4cf4gbf73gaf7e48190192"
msgid "<i>Kainyank.</i> You will lay no hand on me tonight."
msgstr "<i>케인얀크.</i> 네가 오늘밤 내게 손을 댈 일은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:60bf4901-1ec1-79c9-fa3c-5c139e9f02aa
msgctxt "h6f6d760bg8875g4e33gb9c9ga954a3e42c76"
msgid ""
"Whatever's whispering these rabid thoughts to you - block it out. Focus on "
"me."
msgstr "그런 생각을 속삭이는 게 뭐든 간에, 생각하지 마. 내게 집중해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 62ea1096-60e4-7e67-ac96-6facf23365c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:62ea1096-60e4-7e67-ac96-6facf23365c8
msgctxt "h57b8e57fged5eg428bg8470g558525fe47f3"
msgid "<i>Sob. Say nothing.</i>"
msgstr "<i>흐느낀다. 아무 말도 할 수 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = GROUP_ORI_DU
#. NodeID = 64d3d6bf-14c0-3390-9ed1-d3c87dcf4991
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:64d3d6bf-14c0-3390-9ed1-d3c87dcf4991
msgctxt "h4db7f765gd06bg444cg8cf4g1cd53f545268"
msgid "<i>Try to express gratitude.</i>"
msgstr "<i>감사를 표하려 시도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 65407cfd-68cc-9493-f526-f9ed9710e7a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = False
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:65407cfd-68cc-9493-f526-f9ed9710e7a5
msgctxt "h0255c47cg25ebg4eb3gbbe4ge9cfec027711"
msgid "No, I'll kill anyone else instead. But not one of my companions."
msgstr "아니, 차라리 누구든 다른 사람을 죽이겠어. 내 동료는 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6727e857-f9bd-e0f9-1c3d-529f261283d4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6727e857-f9bd-e0f9-1c3d-529f261283d4
msgctxt "hf60e25b2gd3b0g46fbg9274g80053493409a"
msgid "Hells. What wretch? What did it say?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6727e857-f9bd-e0f9-1c3d-529f261283d4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6727e857-f9bd-e0f9-1c3d-529f261283d4
msgctxt "h85198ef6gb020g44c5gbe5eg968c670480b4"
msgid "I'll kill the bastard. What happened?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6727e857-f9bd-e0f9-1c3d-529f261283d4
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6727e857-f9bd-e0f9-1c3d-529f261283d4
msgctxt "h210b8a21gd492g4a50g9651g3d0d21782a67"
msgid ""
"And you're quite sure it wasn't a dream? Cheese partaken at a late hour can "
"wreak havoc on the unconscious... Go on, tell me about it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6727e857-f9bd-e0f9-1c3d-529f261283d4
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6727e857-f9bd-e0f9-1c3d-529f261283d4
msgctxt "he6f5e0ffg4213g4162gafd7g940f8623cf80"
msgid "More horrible than our day-to-day lives? Well this I have to hear."
msgstr "우리의 평범한 일상보다 더 끔찍한 거야? 이건 꼭 들어봐야겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6727e857-f9bd-e0f9-1c3d-529f261283d4
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6727e857-f9bd-e0f9-1c3d-529f261283d4
msgctxt "hf6cb85c8g6fcdg44c8g9b40g401b2fbc4e84"
msgid "Tell me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6727e857-f9bd-e0f9-1c3d-529f261283d4
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6727e857-f9bd-e0f9-1c3d-529f261283d4
msgctxt "h7ee84ebag1079g4e92g8b6bgd13b4a118e57"
msgid ""
"Well, could be worse... It could have <i>done </i>something horrible. What "
"did it say?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 68218f7d-a8fb-183d-35e5-c16039c7f6e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:68218f7d-a8fb-183d-35e5-c16039c7f6e6
msgctxt "hd1b5748ege97bg4c1egbae8g31fbcd69e6ad"
msgid "I am but an eager messenger, from the depths of your dirty thoughts."
msgstr "전 그저 열렬한 심부름꾼일 뿐이랍니다. 주인님의 깊숙하고도 추잡한 생각을 전하러 왔지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6a72039e-806c-59fa-d11b-f50f8b033419
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6a72039e-806c-59fa-d11b-f50f8b033419
msgctxt "h5a5c0905gd5e8g4885gb628ge100b6d691e3"
msgid "It is my duty to ensure you are making the right decisions, Master."
msgstr "주인님이 반드시 옳은 선택을 하도록 돕는 것이 제 의무랍니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6b077811-2119-41ea-aa19-79984a76e6f3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6b077811-2119-41ea-aa19-79984a76e6f3
msgctxt "h4e8c0a52g664eg4051g8a99g365810c2db23"
msgid ""
"Gods, what's the matter? You look like you've seen a gravehound's ghost."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6b077811-2119-41ea-aa19-79984a76e6f3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6b077811-2119-41ea-aa19-79984a76e6f3
msgctxt "h9eb9adb9gc7ecg4d9dga5f0gac175dd56343"
msgid "You look like hell. What's wrong?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6b077811-2119-41ea-aa19-79984a76e6f3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6b077811-2119-41ea-aa19-79984a76e6f3
msgctxt "h75f0050eg3307g4f2fgb408g2643bc33de52"
msgid "Wait. I'm not sure I like that look in your eyes. What's wrong?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6b077811-2119-41ea-aa19-79984a76e6f3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6b077811-2119-41ea-aa19-79984a76e6f3
msgctxt "h80ea0477ga705g451fgb621g8eb86180165b"
msgid ""
"Although you don't look entirely... yourself. What's going on in that head "
"of yours?"
msgstr "그런데 너 평소와는 완전히… 다른 것 같은데. 머릿속에 무슨 일이라도 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6b077811-2119-41ea-aa19-79984a76e6f3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6b077811-2119-41ea-aa19-79984a76e6f3
msgctxt "h2fad721fg5529g4e40g87ebg6f7e2d5850c0"
msgid "Bah - you look sick as a cadaver. What's come over you?"
msgstr "이런, 시체처럼 생기가 없군. 대체 무슨 일이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6b077811-2119-41ea-aa19-79984a76e6f3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6b077811-2119-41ea-aa19-79984a76e6f3
msgctxt "h39974a26g8bbag4a60gb189gb1a2956def16"
msgid "Hold on, you look like you've had a shock - is something the matter?"
msgstr "잠깐, 굉장히 충격받은 얼굴인데. 무슨 문제라도 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6bbb3544-228e-846f-47d4-ad7b10dc8a80
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6bbb3544-228e-846f-47d4-ad7b10dc8a80
msgctxt "h0e42f864g4251g4f3eg893bga5e54b0f2852"
msgid ""
"I won't lay so much as a talon on him. I wouldn't rob you of that delight."
msgstr "저 사람에게는 발톱 하나 대지 않겠습니다. 그 기쁨을 주인님에게서 앗아갈 수는 없지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 6bbb3544-228e-846f-47d4-ad7b10dc8a80
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6bbb3544-228e-846f-47d4-ad7b10dc8a80
msgctxt "h9f1bc5d8g9a2bg4cf6gbdb7g1a75c369afad"
msgid ""
"I won't lay so much as a talon on her. I wouldn't rob you of that delight."
msgstr "저 사람에게는 발톱 하나 대지 않겠습니다. 그 기쁨을 주인님에게서 앗아갈 수는 없지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6ef6192a-84d0-c2d1-c715-c80d7ae3506d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6ef6192a-84d0-c2d1-c715-c80d7ae3506d
msgctxt "h5b88f793ge264g4313ga936g963184eaeb1e"
msgid "I love feeling you close. But are you sure -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6ef6192a-84d0-c2d1-c715-c80d7ae3506d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6ef6192a-84d0-c2d1-c715-c80d7ae3506d
msgctxt "h109f706dg36cfg4089ga269gbe33b34cc981"
msgid "Mm - hello, love. Did you have a bad dream?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6ef6192a-84d0-c2d1-c715-c80d7ae3506d
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6ef6192a-84d0-c2d1-c715-c80d7ae3506d
msgctxt "h27bb2cd4gc664g4af8ga7a8g6c8279fb296a"
msgid "Mmm. A pleasant dream gives way to an even more pleasant reality."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6ef6192a-84d0-c2d1-c715-c80d7ae3506d
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6ef6192a-84d0-c2d1-c715-c80d7ae3506d
#, fuzzy
msgctxt "hee8b646bgc6f2g4218g9053ga8084ed62b0c"
msgid "Well, hello. Looking for a cuddle?"
msgstr "안녕. 안아줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6ef6192a-84d0-c2d1-c715-c80d7ae3506d
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6ef6192a-84d0-c2d1-c715-c80d7ae3506d
msgctxt "h2627e497gfc44g4b70ga05eg007b8306b2d6"
msgid ""
"Your breath and body - the heat of <i>you</i>. You know what it does to me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 6ef6192a-84d0-c2d1-c715-c80d7ae3506d
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:6ef6192a-84d0-c2d1-c715-c80d7ae3506d
msgctxt "he3104688g5509g4d90g832eg2bd8b5e6ce34"
msgid ""
"Hmm...? Oh, has the mood struck you, love? I suppose we could try, if you "
"think the others won't stir..."
msgstr "흐응...? 아, 지금 하고 싶은 거야? 해볼 수도 있겠네, 다른 사람이 깨지만 않으면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 70813f26-af39-bf4b-4ff3-4b5ff5a14300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:70813f26-af39-bf4b-4ff3-4b5ff5a14300
msgctxt "h2f2aa59age4d8g4fe3gbd89g4f7addc366db"
msgid ""
"Ah yes - the memory problem. I'm afraid I'm not allowed to interfere but "
"know you had the thirstiest knife-arm in the Coast, before you were stolen "
"away from my side."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 71b38a17-3f8b-c2bf-3d3f-af1a76178cb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:71b38a17-3f8b-c2bf-3d3f-af1a76178cb5
msgctxt "h1ebec302gde4ag49cag844eg60216f3da4e1"
msgid ""
"I wish I'd discovered you drinking yourself to death in a tavern with some "
"bedfellows of negotiable virtue, and not <i>this </i>debacle."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 7322ab5c-d08f-58f7-f94e-b61ea2246749
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7322ab5c-d08f-58f7-f94e-b61ea2246749
msgctxt "hb30b0ccdgf449g4639gb630ga597ad62cf2d"
msgid "*Surely it is preposterous anything else would happen tonight?*"
msgstr "*오늘밤 갑자기 무슨 일이 또 생긴다니, 당연히 그럴 리가 없겠죠?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7330d370-8e4e-587f-9afb-eab2c0955359
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7330d370-8e4e-587f-9afb-eab2c0955359
msgctxt "ha82f62a3g039cg445cg988agdabc252f1650"
msgid "Then it should be a trifling matter to kill this one!"
msgstr "그렇다면 이걸 죽이는 건 일도 아니겠군요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 75eb1638-a4d1-4b97-cb82-292238dc0812
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:75eb1638-a4d1-4b97-cb82-292238dc0812
msgctxt "hdd54b70cg81c8g4c5bgb73egd16820ce162c"
msgid "<i>Tell the story, but lay heavy blame on the Butler.</i>"
msgstr "<i>이야기하지만, 거의 다 집사의 잘못으로 떠넘긴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 7688192c-68d7-2e08-ea8d-52f24ddd35e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7688192c-68d7-2e08-ea8d-52f24ddd35e1
msgctxt "h38d263cfg2659g4cbbg9c98g0274cd53e415"
msgid ""
"*As you tell your story, fatigue fills your body. Your head swims with the "
"worst headache you've known.*"
msgstr "*당신이 입을 열자 피곤이 몸을 덮쳐옵니다. 머리가 생전 느껴본 적 없는 끔찍한 두통으로 욱신거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 76c5e62c-9abb-fc98-64c1-cef678c142d3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:76c5e62c-9abb-fc98-64c1-cef678c142d3
msgctxt "hfcdb83c6g20abg4af3gb82ega660f28baf69"
msgid ""
"That blasted thing better hope I don't catch it. I'll slice it in two, fancy "
"hat and all."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 76c5e62c-9abb-fc98-64c1-cef678c142d3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:76c5e62c-9abb-fc98-64c1-cef678c142d3
msgctxt "h8713841ege8afg4c25g85f7g9b7ab8010b36"
msgid ""
"I'll fuck him up. Bad. Just say the word next time he slithers into our "
"camp, and he's <i>gone</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 76c5e62c-9abb-fc98-64c1-cef678c142d3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:76c5e62c-9abb-fc98-64c1-cef678c142d3
msgctxt "h3358fed7g8167g4f07g9f46g6dda424761cb"
msgid ""
"A most dire night-visitor to be burdened with, sounds like. My sympathies."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 76c5e62c-9abb-fc98-64c1-cef678c142d3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:76c5e62c-9abb-fc98-64c1-cef678c142d3
msgctxt "haf51382fg84d2g4f90g945cge84c0c6859d6"
msgid "The little shit. And here I hoped I was your only night-time visitor."
msgstr "찢어죽일 놈이네. 밤에 몰래 널 찾아가는 건 나만 해야 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 76c5e62c-9abb-fc98-64c1-cef678c142d3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:76c5e62c-9abb-fc98-64c1-cef678c142d3
msgctxt "h19bf089bg243bg4bccg9881gd75c46d1ee1f"
msgid ""
"Damnable vermin. I will not let you be preyed upon by this - this "
"<i>louse</i>."
msgstr "저주받을 벌레 같으니. 네가 이런, 이딴 <i>기생충에게</i> 고통받도록 두진 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 76c5e62c-9abb-fc98-64c1-cef678c142d3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:76c5e62c-9abb-fc98-64c1-cef678c142d3
msgctxt "h8cfbcda7g513bg4918gbae3g7be3cc7243de"
msgid "Gruesome-sounding wretch - not something I envy of you."
msgstr "징그럽게 잔인한 놈 같네. 나라면 절대 만나고 싶지 않은. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 77aa359b-e759-86bd-9c81-117084626c30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:77aa359b-e759-86bd-9c81-117084626c30
msgctxt "he431effagfe0dg4e19gb5fcg54eddcde33cd"
msgid "You're not making any sense."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 789ec25e-8c81-5274-baca-2c05fede14f2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:789ec25e-8c81-5274-baca-2c05fede14f2
msgctxt "h1cca643bgcd1dg4854gbc69gb02f5ecaf32b"
msgid "Shit. This isn't good."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 789ec25e-8c81-5274-baca-2c05fede14f2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:789ec25e-8c81-5274-baca-2c05fede14f2
msgctxt "h364aab4fg0e78g4c9dgb6d2gba903b25549c"
msgid "Easy, now - a piece of me will burn you going in <i>and </i>out."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 789ec25e-8c81-5274-baca-2c05fede14f2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:789ec25e-8c81-5274-baca-2c05fede14f2
msgctxt "hb6d4006egc270g4fd8gafebgaf2fa2fa3bb3"
msgid ""
"By the Weave, you're practically <i>rabid</i>. This is not good, if I may "
"state the obvious."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 789ec25e-8c81-5274-baca-2c05fede14f2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:789ec25e-8c81-5274-baca-2c05fede14f2
msgctxt "hfef67b51g7dd3g4972g816dgb3ff64d4466c"
msgid "Ah ah ah! We ask before we bite."
msgstr "아, 안 되지! 얘기 없이 함부로 물지 않기로 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 789ec25e-8c81-5274-baca-2c05fede14f2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: LAEZEL_ORPHEUSPATH and REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:789ec25e-8c81-5274-baca-2c05fede14f2
msgctxt "hd3750a6bg32e5g432dga178g0804e44aa9d1"
msgid "<i>Tsk'va!</i> The banished prince willing, I'll bite back."
msgstr "<i>츠크바!</i> 나도 추방된 왕자의 이름으로 똑같이 물어뜯어 줄 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 789ec25e-8c81-5274-baca-2c05fede14f2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:789ec25e-8c81-5274-baca-2c05fede14f2
msgctxt "h2ae1a1b6g9832g4238gbf17g573bd68a49af"
msgid "<i>Tsk'va! </i>Vlaakith willing, I'll bite back."
msgstr "<i>츠크바!</i> 나도 블라키스의 이름으로 똑같이 물어뜯어 줄 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 789ec25e-8c81-5274-baca-2c05fede14f2
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:789ec25e-8c81-5274-baca-2c05fede14f2
msgctxt "hb9e0a4c3g5460g4b7dgaa1fgedeb40d26f23"
msgid "No - keep back. No biting. This is worse than I thought..."
msgstr "아니, 물러서. 물면 못써. 생각보다 더 심각한걸..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7aba7cec-6732-764f-c7a9-c3db65f501a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7aba7cec-6732-764f-c7a9-c3db65f501a6
msgctxt "h0de78ea7g27aag4f71g95c8g31b3433660c7"
msgid "Your betters are no fans of the company you've been keeping..."
msgstr "어르신께서는 당신이 데리고 다니는 것들이 마음에 들지 않아요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7cf3f3ad-d652-dc84-8a6f-8743e9a9d90b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL_DEVIL(1) = False
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7cf3f3ad-d652-dc84-8a6f-8743e9a9d90b
msgctxt "h210e3b63g14b3g42e0gbb53g165c8c7b3d92"
msgid "He has his own devil, just as you have me. Aren't you a foul pair?"
msgstr "저 사람도 데빌 짝이 있는 것이, 마치 저와 주인님 같군요. 참으로 흉악하게 어울리지 않습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Sceleritas Fel
#. NodeID = 7f3f0c38-97f8-b164-108a-0ae2c0db6c01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_MurderedAlfiraOrAlternative = True
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7f3f0c38-97f8-b164-108a-0ae2c0db6c01
msgctxt "h01f4b58cgae62g4fbegbc64gabda645ef720"
msgid ""
"Your perfect instincts force your knife-arm. You know that well from the "
"bard."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 7f81d941-20d1-51d3-e122-bf45f7f3c759
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7f81d941-20d1-51d3-e122-bf45f7f3c759
msgctxt "hc1aaf80cg0a46g4ab3g8901g14d8dc6cc1e8"
msgid "Get away from him!"
msgstr "걔한테서 떨어져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 7f81d941-20d1-51d3-e122-bf45f7f3c759
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:7f81d941-20d1-51d3-e122-bf45f7f3c759
msgctxt "he12555a3g3dd8g4583gbad2gf54bcad1832f"
msgid "Get away from her!"
msgstr "걔한테서 떨어져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 80949461-115e-9ba0-2671-989f102416ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:80949461-115e-9ba0-2671-989f102416ea
msgctxt "h7cbce0a1g68c6g4f6bgb66eg73da6ab0b533"
msgid "I love him. No, it cannot be."
msgstr "연인을. 아니, 그럴 리가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 80949461-115e-9ba0-2671-989f102416ea
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 806a4bc3-5227-e9eb-8dbf-ffe2ba9dbc4c_IsInRomanceWithVictim = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:80949461-115e-9ba0-2671-989f102416ea
msgctxt "h7c96395fg804eg48f9gafd4gcb1a3b90ffad"
msgid "I love her. No, it cannot be."
msgstr "연인을. 아니, 그럴 리가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 83fdda1b-ba78-0fe2-1c35-b038584511b4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:83fdda1b-ba78-0fe2-1c35-b038584511b4
msgctxt "h08161691g1415g4fc4g8c27g3516e0b44c62"
msgid ""
"The fiend's slain. As if I could ever have doubted you. Now rest - you've "
"earned it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 83fdda1b-ba78-0fe2-1c35-b038584511b4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:83fdda1b-ba78-0fe2-1c35-b038584511b4
msgctxt "heb4d97d9gd09dg44ffgaf34g5d566fe2dcb0"
msgid "Thank me when we've both survived the night."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 83fdda1b-ba78-0fe2-1c35-b038584511b4
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:83fdda1b-ba78-0fe2-1c35-b038584511b4
msgctxt "hab311ac3gcc0ag44f8ga6ffg8ed3e3980b4b"
msgid "Gratitude can wait - you're not out of the woods yet. Stay focused."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 83fdda1b-ba78-0fe2-1c35-b038584511b4
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:83fdda1b-ba78-0fe2-1c35-b038584511b4
msgctxt "had39343dg4edfg45dfg97bfga517da6bc3ea"
msgid "You'd do the same to me. Now just relax - dawn isn't far off."
msgstr "너였어도 나한테 똑같이 해줬을 거야. 이제 새벽이 머지않았으니 긴장 풀어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 83fdda1b-ba78-0fe2-1c35-b038584511b4
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:83fdda1b-ba78-0fe2-1c35-b038584511b4
msgctxt "h2b7c5cf8gcdcbg443cg944eg2be9fc5c0b8a"
msgid ""
"I don't need thanks - I need answers. For now, rest. We'll speak come dawn."
msgstr "고마워할 필요 없어, 해명이 필요한 거니까. 당장은 쉬도록 해. 해가 뜨면 다시 얘기하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Player
#. NodeID = 83fdda1b-ba78-0fe2-1c35-b038584511b4
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD:83fdda1b-ba78-0fe2-1c35-b038584511b4
msgctxt "h5a8f52b6g24bbg48e6g8b42g334c859ce592"
msgid "You can thank me once the bloodlust subsides. Keep focused."
msgstr "살인 충동이 가라앉고 나면 고맙다고 해. 지금은 계속 집중하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_SparedIsobel_SD
#. Speaker = Narrator
#. NodeID = 84296010-6503-046c-2773-b067aad94471
