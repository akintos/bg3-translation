msgctxt "h6f9b0756gbe4cg4d4dg8e5cgb4da222a009a"
msgid "Thou hast broken thy oath. Before I can aid thee, thou must atone."
msgstr "그대는 그대가 한 맹세를 저버렸구나. 내가 그대를 돕기 전에, 성의를 보여야만 할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Withers
#. NodeID = 48e09b76-b0f9-5cce-76d9-82da1a76d943
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal:48e09b76-b0f9-5cce-76d9-82da1a76d943
msgctxt "h07b278b8g5109g458bgbf88ga8c370a0b66b"
msgid "An apology to one such as myself is but empty air."
msgstr "나와 같은 이에게 사과는 공허할 뿐이다."

