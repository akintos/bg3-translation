msgctxt "h9b55e07cg0c0ag4e17g8a3cg9115efa5deeb"
msgid "Naughty, naughty, naughty, little Master."
msgstr "쯧, 쯧, 쯧. 그러면 못 써요, 꼬마 주인님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/SoloDreams/CAMP_DarkUrge_Bloodwedding_SD
#. Speaker = Sceleritas Fel
#. NodeID = c12be327-28fb-6198-9531-62d11c04558a
