msgctxt "h6d39a526gaa47g4d80gb7bdgecc123c96837"
msgid "People will start talking, with all the time we spend together..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
