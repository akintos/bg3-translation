msgid "We will!"
msgstr "그럴게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_OwlbearCub_CFM_Dog
#. Speaker = Scratch
#. NodeID = f3d4241f-b06a-5e65-aaf3-dd9b3a60a279
