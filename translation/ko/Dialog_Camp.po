msgctxt "heeec60dfg2bf1g4228g9222g9ff859a9885c"
msgid "I see the problem - you don't have a drink! "
msgstr "왜 이리 꽁한지 알겠네. 너 술에 입도 안 대고 있잖아! "

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Rhy
#. NodeID = be1f1bf6-c282-722f-ba9d-296b8880bc14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05:be1f1bf6-c282-722f-ba9d-296b8880bc14
msgctxt "h7e825542g7e71g4a20ga57ag230358e2fceb"
msgid "You're tense as a bowstring."
msgstr "당긴 활시위만큼 뻣뻣하거든?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_SonOfChef_Backup05
#. Speaker = Ikaron
#. NodeID = c4dc0e9b-6c69-636a-c103-1db6b9c80a59
