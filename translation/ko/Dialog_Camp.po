msgctxt "h52148568g6847g4349g82f7g2cb9f3d5e090"
msgid "I trusted that you would protect me."
msgstr "당신이 날 지켜 줄 거라 믿었으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyMissionStatement_AvD
