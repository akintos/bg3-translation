#: Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod:ce3c67ac-51f0-0354-14b6-d0b7be363670
msgctxt "hc0b01f87gb65eg439cg848dg2c44c9609f13"
msgid "Wait. Perhaps I'm being too hasty... and perhaps you're overreaching."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Gale_CRD_ROM_BeMyGod
#. Speaker = Player
#. NodeID = cf62350b-e10e-c2ac-26b7-24606007127a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
