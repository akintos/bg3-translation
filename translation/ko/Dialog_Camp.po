msgctxt "h4ef94d2cg8929g4317g8573gb90b597cf0b0"
msgid "<b>FOLLOW ME AGAIN AND I'LL EAT <i>YOU</i>.</b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
#. Speaker = Player
#. NodeID = a22463a8-613a-47b9-6638-511df6afd8fa
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection:a22463a8-613a-47b9-6638-511df6afd8fa
msgctxt "ha157c6edg8f15g4988g9988g6022d3e2ff74"
msgid "You can leave alive, or you can roast over my campfire."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_SchoolOgres_CFM_DebtCollection
