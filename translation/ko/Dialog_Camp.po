msgctxt "hd79a4af1ge188g471agbc6bg95f3d3bcf197"
msgid "I hope you don't mind."
msgstr "기분 나쁘지 않았길 바라요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
