msgctxt "he217eb06gb821g4515gb10dgb0f221d453ed"
msgid "Just so you know, I'm spending tonight with Gale."
msgstr "너도 알다시피, 난 게일이랑 하룻밤을 보낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
