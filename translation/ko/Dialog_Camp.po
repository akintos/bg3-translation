#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:8047d598-d212-a045-8b54-1502071cf79f
msgctxt "hafea5b0agcbf2g44cdg8c0fg96bf84f2dff6"
msgid "Your words carry truth - I will meet you in Baldur's Gate."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 84fb7aca-575b-74a0-cd04-c8a6471990c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:84fb7aca-575b-74a0-cd04-c8a6471990c6
msgctxt "hfc40e365ga0b2g48c2gb3c3g51d00525d7f8"
msgid ""
"Forgiveness? Ignorant child. In Vlaakith, there is no forgiveness. You might "
"as well beg a dragon for its wings."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 8610082a-97cf-b317-f5ad-a4a3109f313a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:8610082a-97cf-b317-f5ad-a4a3109f313a
msgctxt "h5080b8e3ga980g473agb92ega4f2bd9a62c5"
msgid ""
"Keep the Astral Prism close. Let no one take it from you. Slay any who try."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 88876d07-8a1b-0173-7662-733913fd7d04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:88876d07-8a1b-0173-7662-733913fd7d04
msgctxt "hd6817476g336ag4ea5ga935g2c92cceeaad9"
msgid ""
"*Ascension - the foundation of githyanki belief. Bring Queen Vlaakith an "
"illithid's head, and she will grant you an eternal home in the great city of "
"Tu'narath.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 89965f03-cf79-aa1e-ef44-c0bac11ef68a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVossInAct2 = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:89965f03-cf79-aa1e-ef44-c0bac11ef68a
msgctxt "hb78266a0gb425g4220g8284gec203b01bdb4"
msgid "No more words. This camp will be your grave."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 8d1ef3af-eb20-572c-95fc-18794c583299
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:8d1ef3af-eb20-572c-95fc-18794c583299
msgctxt "hd38d514dg8addg423dgab59g17e7af55680c"
msgid "Honoured <i>kith'rak</i>. Tell me you bring me Vlaakith's forgiveness."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 8d791bae-19e4-b394-cf4a-0da408fa2c34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - Camp_VossConfrontation_Event_VossToldTruth = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:8d791bae-19e4-b394-cf4a-0da408fa2c34
msgctxt "he9f8d8f2g5f49g4c5fgb22dgfe29837303d4"
msgid ""
"Lae'zel - together we will break our chains, and be Vlaakith's slaves no "
"longer."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = 8ecfb170-8afb-4b7d-4d96-47da38ee42ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_AgreedWithVossInAct2 = True
#.     - ORI_Laezel_State_IsOnOrpheusPath = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:8ecfb170-8afb-4b7d-4d96-47da38ee42ea
msgctxt "h42fdb51bg7149g4202gbdd6gbdd891459b27"
msgid "I'll let you leave this camp alive. But I can promise nothing more."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 9806979b-0398-83a5-de36-10df9511a193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:9806979b-0398-83a5-de36-10df9511a193
msgctxt "h757e88b1g0a61g41a2gbc1aga398cb0f3198"
msgid ""
"I knew you would fight - and I knew you would win. I needed to ensure "
"Vlaakith's trust. This was the only way."
msgstr "네가 싸울 것도, 이길 것도 알고 있었다. 난 블라키스의 신뢰를 얻어야 했어. 방법은 이것뿐이었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 99f4bc54-67d2-6edf-4689-8783d57576d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:99f4bc54-67d2-6edf-4689-8783d57576d8
msgctxt "hef80b5e0gbbfdg4e92ga697g80b25e12bcfe"
msgid ""
"*This has been your life's purpose. Could Vlaakith truly intend to consume "
"your life force to strengthen her own?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = 9ddbdf0b-0e72-f801-4c9f-190910981b55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:9ddbdf0b-0e72-f801-4c9f-190910981b55
msgctxt "h94b4e89eg7e85g4b2fgbf08g7ec9f7619520"
msgid "At ease, child. <i>Jhe'stil Kith'rak</i> does not come to kill you -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = a2ce70a9-1357-fa44-5834-abead756fd90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:a2ce70a9-1357-fa44-5834-abead756fd90
msgctxt "h1b1f60f4g53e7g4d89g9e86ga30b3cf7f1ec"
msgid "Be at ease. I bring only truth."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = a3e71bb1-f6e4-9028-4510-bd22aa29ee4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:a3e71bb1-f6e4-9028-4510-bd22aa29ee4d
msgctxt "h12692898g71a5g43b2g8ec6g90118697df4e"
msgid ""
"Lae'zel. I see <i>T'lak'ma Ghir</i> in you - Sister in Freedom. Together, we "
"will be our people's light."
msgstr "레이젤. 네 안에서 <i>티라크마 기르</i>, 자유의 자매가 보이는구나. 함께라면, 우리는 백성들의 등불이 되리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = a45522a8-af8a-e075-624b-711d4d12ff17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:a45522a8-af8a-e075-624b-711d4d12ff17
msgctxt "hda740fcag53c8g4c4bg8d23g4fe2e57d2d90"
msgid "It is not."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = aab0b7a0-d26d-b748-0816-1904d2765d12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:aab0b7a0-d26d-b748-0816-1904d2765d12
msgctxt "hdf08f144gb225g4ed5g9c96g8ef43c66799b"
msgid ""
"That very power will be the end of Vlaakith's tyranny. The Prism's tenant "
"must be let loose."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = b12518c5-cee1-ea88-abfd-df757289a6a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_VossMeetingRaphaelInSharessCaress = True
#.   Object:
#.     - ORI_Laezel_Event_VossGivesGithRadar(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:b12518c5-cee1-ea88-abfd-df757289a6a9
msgctxt "head891d4gc4ccg4e76g933ag5588c6e77b28"
msgid "Take this. It is a <i>qua'nith</i> - a psionic detector."
msgstr "이걸 받게. <i>콰니스</i>라고 한다네. 사이오닉 감지기지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = b57b7fc2-2ec4-42e2-14b5-bb85889e2295
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:b57b7fc2-2ec4-42e2-14b5-bb85889e2295
msgctxt "hf7805c03g8218g4db3ga81ag57799fa96002"
msgid ""
"The Prism's tenant alone has the power to end Vlaakith's tyranny. They must "
"be let loose."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = b7594545-379a-0998-9d96-550ba85a08bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:b7594545-379a-0998-9d96-550ba85a08bd
msgctxt "h9642a220g740dg49a0g996eg39457038777b"
msgid "A fool stumbles without cause. A hero serves a cause without question."
msgstr "바보는 이유 없이 넘어진다. 영웅은 질문 없이 이유를 받들지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = bc943ccb-6e9f-e8c2-1237-3d218ab221f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:bc943ccb-6e9f-e8c2-1237-3d218ab221f7
msgctxt "h28cdf200gbf69g42a6g9809g214f93d0751e"
msgid "A <i>kith'rak</i>. Has our Queen sent you to slay me yourself?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = bdbb7806-52c7-846a-6fce-5a77c761b89b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:bdbb7806-52c7-846a-6fce-5a77c761b89b
msgctxt "h0961e45fgc2d7g4be6g9b10g8fe92dd4c85e"
msgid ""
"The <i>zaith'isk</i> does not purify - it extracts memory and kills the "
"infected. Nor does the lich queen glorify the ascended. She feeds on most "
"all of them to grow her power and pursue godhood."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = c07d2818-c376-15ac-3a8e-11152d03dad1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 79dc4456-27f6-faf2-a47e-f2da8c320eb9_PrismAvatar = False
#. SetFlags:
#.   Local:
#.     - 79dc4456-27f6-faf2-a47e-f2da8c320eb9_PrismAvatar = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:c07d2818-c376-15ac-3a8e-11152d03dad1
msgctxt "hd629aecbga161g4274gaa21gee30d2672a59"
msgid "I am no slave. It is Vlaakith who will purify me and ascend me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = c58d3dde-1aa9-d56b-f9ac-69d970b4ebe7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:c58d3dde-1aa9-d56b-f9ac-69d970b4ebe7
msgctxt "h898a69edg7df3g4b81ga94dg397f1b762bdf"
msgid ""
"I am no servant of Queen Vlaakith. But I know who you are, and I know of the "
"Astral Prism you carry."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = c657b003-e4b3-3db1-ac47-3e38d3e001a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:c657b003-e4b3-3db1-ac47-3e38d3e001a0
msgctxt "h3f6d0fa9gddccg4db0g9c85g66230655f490"
msgid "I know you carry the Astral Prism, Lae'zel."
msgstr "아스트랄 프리즘이 네게 있다는 걸 안다, 레이젤."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = c8301ae3-dd7f-0976-31bd-20889f99756a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVossInAct2 = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:c8301ae3-dd7f-0976-31bd-20889f99756a
msgctxt "h5c851485ge627g4873gaf56g37befcfe7ffb"
msgid "I've heard enough. Taste my fury, <i>kith'rak.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = cd861fe7-4441-ff2f-c15d-9d99ef3cfd2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:cd861fe7-4441-ff2f-c15d-9d99ef3cfd2b
msgctxt "h9c0d2b47g6622g43cbgb174g53be3902a8c7"
msgid "Instead, you've granted the opportunity I've so long awaited."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = cdd8be35-5bff-5d2d-b157-1e3f971b1e24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:cdd8be35-5bff-5d2d-b157-1e3f971b1e24
msgctxt "h03a3eeafg5521g4716g8d85g865d98a8c329"
msgid "Enjoy your next breath. It will be your last."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = d0ab7191-a0c9-489b-1c78-8cfd1d31cd88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:d0ab7191-a0c9-489b-1c78-8cfd1d31cd88
msgctxt "h7dd29e63g7eeeg4b93g8e36gd1d6cfa13303"
msgid "Speak. You have my ear, as Mother Gith taught us."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = db078cc5-7c00-29d9-8c9b-0bf977f4831a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:db078cc5-7c00-29d9-8c9b-0bf977f4831a
msgctxt "hb3e36811g631bg448fg9ee2g280567c6bbc2"
msgid "Fine. I'll hear what you have to say before I gut you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = dd43e016-7c07-c2c6-2e4e-c161e8f5be62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:dd43e016-7c07-c2c6-2e4e-c161e8f5be62
msgctxt "hd5aac389g84abg478egb7b1ge7848cb46828"
msgid ""
"I should go. Vlaakith's gaze pierces the seas and skies. She believes me "
"loyal - and I can't afford her mistrust."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = e0ecfe76-f992-39e4-319f-1252763dbf27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = True
#.      - GLO_GithChokepoint_Quest_GithLeave = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:e0ecfe76-f992-39e4-319f-1252763dbf27
msgctxt "he2b6d2e1g3cc9g4781g9920ge0f2138c23d1"
msgid "Your cronies tried to kill us. Why should I listen to you?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = e13c3931-3291-f4a5-4468-e830b3fa1343
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:e13c3931-3291-f4a5-4468-e830b3fa1343
msgctxt "h707e42acg2847g45d7g86c4ge9da304a6bbc"
msgid ""
"Within it lies the seed of Vlaakith's demise. And I intend to help you bring "
"it to fruition."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = ef1f1f03-1981-fb30-4d20-612726dcd219
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:ef1f1f03-1981-fb30-4d20-612726dcd219
msgctxt "h7c486b63gbd29g4e47gbd2ag00adc309af96"
msgid "Now - to Baldur's Gate. I'll be waiting, Lae'zel."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = f167e1f4-9c19-6374-842a-8832b6c64ea7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:f167e1f4-9c19-6374-842a-8832b6c64ea7
msgctxt "hdc7571b7g2626g4559g8766g318288ea533a"
msgid ""
"The Prism's tenant can put an end to Vlaakith's tyranny. They must be let "
"loose."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = f277dca4-282e-58ac-03c2-af86df427c4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:f277dca4-282e-58ac-03c2-af86df427c4b
msgctxt "h89564b90g7469g49c3g85ccg0a63b62ea7a2"
msgid "I'm asking for your help - and your trust."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = f94c4de9-8fb2-2cc1-567f-3359fbdc4f6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:f94c4de9-8fb2-2cc1-567f-3359fbdc4f6c
msgctxt "hb26e289egb271g4c8bgaed9g22db5e90706a"
msgid "Lies, Lae'zel - every last one. There is no purification, no ascension."
msgstr "거짓말이야, 레이젤. 전부 다. 정화도, 승천도 모두 지어낸 말일 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Player
#. NodeID = f97f17a8-a66f-f977-0cae-6e83c367f5e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:f97f17a8-a66f-f977-0cae-6e83c367f5e0
msgctxt "h5bf2b4ddg7fd9g445ega66fg8446fa1b5c9e"
msgid "Supreme Kith'rak. Has Vlaakith sent you to slay me with your own blade?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar
#. Speaker = Kith'rak Voss
#. NodeID = fd2f44e5-f859-794e-e464-c6521020ecba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar:fd2f44e5-f859-794e-e464-c6521020ecba
msgctxt "hd6ab3668gc497g4a63gac93gc69b895fe8c3"
msgid ""
"Bring the Prism to Baldur's Gate. I'll be waiting in a taproom called "
"Sharess' Caress. That is where we decide the fate of our people."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 031dff98-ce22-f0ed-e2a8-39eb76fb7a90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:031dff98-ce22-f0ed-e2a8-39eb76fb7a90
msgctxt "h59b7b79dg0b59g4251g8a54gd81b8a33e6a8"
msgid ""
"Because her throne rests on lies, more than a hundred gish scholars could "
"count in a lifetime. I will share but two."
msgstr "여왕의 왕좌는 기스 현자 백 명이 평생 세어도 모자랄 거짓말 위에 세워졌기 때문이다. 이 중 두 가지만 나누겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 066c665f-63c6-7697-d331-c150b9a586f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:066c665f-63c6-7697-d331-c150b9a586f0
msgctxt "hfb313989g9a6bg4cadg9e7bgc9b5be1a8035"
msgid "Child of Gith. I've not come to kill you. I've come to aid you."
msgstr "기스의 아이여. 난 널 죽이러 온 게 아니다. 도우러 왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 0e4b4f00-650c-2394-b943-5681a1005f87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:0e4b4f00-650c-2394-b943-5681a1005f87
msgctxt "h70335e0ageab4g4cf4ga6e5gbe0eaf917652"
msgid ""
"If they have not said, they must have good reason. And I won't be the one to "
"betray them."
msgstr "그들이 스스로 밝히지 않았다면, 분명 그만한 이유가 있을 거다. 그들의 선택을 저버리고 싶지 않다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 0e5047cf-551b-1e6e-b67a-d336582fe56c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:0e5047cf-551b-1e6e-b67a-d336582fe56c
msgctxt "h497b09a0g60ddg4b52gb970g0f5f651bccb3"
msgid ""
"I am no slave, <i>Jhe'stil Kith'rak</i>. The Undying Queen <i>is</i> my "
"freedom. It is she who will purify me, and she who will ascend me."
msgstr ""
"난 노예가 아니다, <i>제스틸 키스락</i>. 불멸의 여왕<i>만이</i> 나의 자유이다. 그분께서 나를 정화하시고, 그분께서 나를 "
"승천시킬 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 1720bc98-7b27-eaa6-9888-21e8466058f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:1720bc98-7b27-eaa6-9888-21e8466058f1
msgctxt "h3978d391g2c8fg4b6cga2e2g402171b7e814"
msgid "Be at ease. I bring only truth."
msgstr "안심해라. 진실만을 가져왔으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 1b24eff7-d66a-e6b4-33b1-eb6b970c38dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_UsedDevice = True
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_AgreedWithVossInAct2 = True
#.     - ORI_Laezel_State_IsOnOrpheusPath = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:1b24eff7-d66a-e6b4-33b1-eb6b970c38dd
msgctxt "h43175801g584bg4fc4g93b6ga0d7af0598bb"
msgid "He speaks true of the <i>zaith'isk</i>. You need to trust him."
msgstr "<i>제이트이스크</i>에 대해 사실만을 진술하고 있잖아. 그를 믿어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 1c144f1c-6071-7ffa-d5a7-64d4709d937f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(0) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:1c144f1c-6071-7ffa-d5a7-64d4709d937f
msgctxt "h1e81a760g4619g4d64gbaa1g9251ab936651"
msgid "What are you asking of us, Voss?"
msgstr "원하는 게 무엇이지, 보스?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 25879775-02e7-3880-1c9c-759813c6b95e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_CanProceedToAct3 = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:25879775-02e7-3880-1c9c-759813c6b95e
msgctxt "h553379b3gba8cg4aebg9a66g283c6092eb70"
msgid "Madness. You flood me with this... this heresy."
msgstr "미쳤군. 감히 내게 이... 이따위 이단을 심어 넣다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 2cfc9ed1-9159-e899-b6a4-572e8dce7241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:2cfc9ed1-9159-e899-b6a4-572e8dce7241
msgctxt "hd67d8409g6025g4600gba5ag2ece5b66b92d"
msgid "I'm not giving you the Astral Prism, if that's what you're wanting."
msgstr "네가 원하는 게 아스트랄 프리즘이라면, 내어 주지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 2db25143-1da8-523e-a4dd-df6d3ebaee91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:2db25143-1da8-523e-a4dd-df6d3ebaee91
msgctxt "h3769f393g4e68g4c0fg8478g2c5f3ba58fa1"
msgid "I will meet you in Baldur's Gate. Do not make me regret it."
msgstr "발더스 게이트에서 만나지. 이 선택을 후회하게 하지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 3368da32-184d-714d-cfa7-17197d31819d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_VossMeetingRaphaelInSharessCaress = True
#.   Object:
#.     - ORI_Laezel_Event_VossGivesGithRadar(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:3368da32-184d-714d-cfa7-17197d31819d
msgctxt "hb8cf5d77g5657g455bg8991g544b6124967a"
msgid "Take this. It is a <i>qua'nith</i> - a psionic detector."
msgstr "받아 둬라. <i>콰니스</i>라는 것이다. 사이오닉 감지기지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 375facf2-bcf2-9e2b-7e32-cf3ad4079c61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:375facf2-bcf2-9e2b-7e32-cf3ad4079c61
msgctxt "h83033fc6g6f07g4631g9cc9gf352fc2bc7e5"
msgid "<i>Nod to Lae'zel. She should take the lead.</i>"
msgstr "<i>레이젤에게 고개를 끄덕인다. 그녀가 주도해야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 37727a4d-99d4-1daa-b3fa-62197930cd45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:37727a4d-99d4-1daa-b3fa-62197930cd45
msgctxt "h744785bcg4610g4fa6g8024gfa8e293c88e6"
msgid ""
"I should go. Vlaakith's gaze pierces the seas and skies. She believes me "
"loyal - and I can't afford her mistrust."
msgstr ""
"이만 가야겠군. 블라키스의 시선은 하늘과 바다조차 꿰뚫는다. 아직 나를 충신이라 믿고 있으니 - 괜한 의심은 사지 않는 게 좋겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 418833ae-e30b-6185-4216-58767c406d86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:418833ae-e30b-6185-4216-58767c406d86
msgctxt "he5c33f98gf7adg478fg8560gafe4cbeb8091"
msgid ""
"The Prism's tenant can put an end to Vlaakith's tyranny. They must be let "
"loose."
msgstr "프리즘의 거주자는 블라키스의 폭정에 마침표를 찍을 수 있다. 그들은 반드시 풀려나야만 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 41b17ce5-8229-b94a-5ea9-8726bef3599c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_AgreedWithVossInAct2 = True
#.     - ORI_Laezel_State_IsOnOrpheusPath = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(4) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:41b17ce5-8229-b94a-5ea9-8726bef3599c
msgctxt "h3bd70064g2c4eg455egbf72g92b460b88679"
msgid "What do you want to do Lae'zel? I have your back."
msgstr "어떻게 하고 싶어, 레이젤? 내가 도울게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 41bc2099-f629-2422-2695-dc8a9976e327
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = False
#. TagRule: GITHYANKI and REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:41bc2099-f629-2422-2695-dc8a9976e327
msgctxt "hb19ec2dagef52g4436g8420g8825f45baba8"
msgid "My own people hunt me. Why shouldn't I gut you where you stand?"
msgstr "우리 동족이 나를 사냥하고 있다. 내가 이 자리에서 널 도륙하지 않을 이유가 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 41bc2099-f629-2422-2695-dc8a9976e327
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:41bc2099-f629-2422-2695-dc8a9976e327
msgctxt "h4492ba6bg94f9g4770gb3b3gbe569862f718"
msgid "Your queen hunts us. Why in the hells should we listen to you?"
msgstr "너희 여왕이 나를 사냥하고 있다. 대체 내가 왜 네 말을 들어야 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 4e7f24bf-9edc-ca63-4099-4422d0838fca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:4e7f24bf-9edc-ca63-4099-4422d0838fca
msgctxt "h0ab87a2fg5460g4654g83aeg4aa1166da1e5"
msgid ""
"But the one inside's chosen you as an ally, protects you with their power."
msgstr "어쨌건 프리즘 내부의 인물은 너를 아군으로 택했고, 그들의 힘으로 너를 지키고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Kith'rak Voss
#. NodeID = 54fac6af-da8f-da78-2053-8526e20a64af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:54fac6af-da8f-da78-2053-8526e20a64af
msgctxt "h641b8301g0e16g41ccgb9e9g4e2439df0dec"
msgid "Instead, you've granted the opportunity I've so long awaited."
msgstr "다행히 너는 내가 그토록 고대해 왔던 기회를 허락해 주었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 582ed2da-be7c-8563-497b-bb13caa6530c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Event_LaezelOMStarted = False
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_MetVossInAct2 = True
#.   Local:
#.     - a852d987-a394-8158-5d83-4170c6f92207_NoChokeVersion = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:582ed2da-be7c-8563-497b-bb13caa6530c
msgctxt "h0d6ab2e7g80cag4374g8df1g38bf4718f35a"
msgid ""
"<i>Tl'a'Vlaakith</i> - has our queen sent a knight to slay me with his own "
"blade?"
msgstr "<i>틀라 블라키스</i>, 여왕께서 그 검으로 나를 죽이라고 기사를 보내셨나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 58b189fe-a1e9-4d34-a2de-19c11753d1f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_AgreedWithVossInAct2 = True
#.     - ORI_Laezel_State_IsOnOrpheusPath = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(4) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom:58b189fe-a1e9-4d34-a2de-19c11753d1f6
msgctxt "h371903afge7cdg4a77g9c9dg2eb661d09e7c"
msgid "Vlaakith's led us astray. I believe him, and so should you."
msgstr "블라키스가 우리를 그릇된 길로 인도했다. 그를 믿어 보겠다. 너도 그래야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VossCampConfrontation_SCO_LaezelCom
#. Speaker = Player
#. NodeID = 58b189fe-a1e9-4d34-a2de-19c11753d1f6
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_AgreedWithVossInAct2 = True
#.     - ORI_Laezel_State_IsOnOrpheusPath = True
