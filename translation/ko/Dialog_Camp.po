msgctxt "hc6de3b3ag6001g4ae5g9ba3gba3410a0db87"
msgid "<i>Wrestle the ball from him.</i>"
msgstr "<i>공을 강제로 빼낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Scratch
#. NodeID = d74427fa-ac81-8c0d-94ac-a8a41a251809
