msgctxt "hc4ab3dbcg8ce0g4b1ag88edg681b6d366400"
msgid "Having fun yet?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_GoblinHuntTieflingCelebration_CRD_Astarion
#. Speaker = Astarion
#. NodeID = ec6425f1-33ed-74a1-47e1-2953cc7074a1
#. HandlePath = TaggedText[0].TagText[0]
