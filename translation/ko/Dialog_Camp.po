#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:a9917ee0-e07b-5929-cce0-e220f4229fd7
msgctxt "h731d8d15g48deg458fga928g90a47972648f"
msgid "<i>Share memories of growing up in the Underdark.</i>"
msgstr "<i>언더다크에서 자란 기억을 공유한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = a9917ee0-e07b-5929-cce0-e220f4229fd7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_WYLL(1) = False
#.      - REALLY_GALE(1) = False
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_ASTARION(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_SC_NightWithShadowheart_SharedPersonal(1) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:a9917ee0-e07b-5929-cce0-e220f4229fd7
msgctxt "hacf465a1gc634g4f03gb1d8gccb212a54fa5"
msgid ""
"<i>Share some memories from your youth. The fight to survive, to prove "
"yourself.</i>"
msgstr "<i>어릴 때의 기억을 공유한다. 스스로를 증명하고, 살아남기 위해 싸웠던 기억을.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = a9917ee0-e07b-5929-cce0-e220f4229fd7
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_WYLL(1) = False
#.      - REALLY_GALE(1) = False
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_ASTARION(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_SC_NightWithShadowheart_SharedPersonal(1) = True
#. TagRule: !(REALLY_GITHYANKI and REALLY_UNDERDARK)
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:a9917ee0-e07b-5929-cce0-e220f4229fd7
msgctxt "hcfa44b62gb1c3g4bf0g9abbg0eaeb3191953"
msgid "<i>Share a little memory from growing up in Baldur's Gate.</i>"
msgstr "<i>발더스 게이트에서 자란 기억을 공유한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = ac6ba271-5649-fac8-643f-e4f67a31ffff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:ac6ba271-5649-fac8-643f-e4f67a31ffff
msgctxt "h0385fbadg2d76g43baga8abg4e5baf9b0708"
msgid "Oh... of course."
msgstr "오... 당연하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = ace04ce9-aa11-467f-6d2b-0c335c5c579a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:ace04ce9-aa11-467f-6d2b-0c335c5c579a
msgctxt "hdfb3a1e7g4287g4c73ga022ga093ddc2a83b"
msgid "Something about me? I'm surprised you cared."
msgstr "나에 대해 말해 보라고? 신경 써주다니 놀라운걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = ad6b0f05-6381-2393-3a5b-18e9179b66c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:ad6b0f05-6381-2393-3a5b-18e9179b66c1
msgctxt "hfe3abafcg4babg48e2gbd30g348ccca9e229"
msgid "Do you think your memories will ever come back?"
msgstr "언젠가는 네 기억이 돌아올 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = b0400084-c413-b8ca-bb74-7fc6e47c40fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b0400084-c413-b8ca-bb74-7fc6e47c40fa
msgctxt "h31586628gcf10g48f8gbda4g15002aa4a9dd"
msgid "You... All right, then. More the fool me."
msgstr "너... 알겠어, 그럼. 나만 바보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = b1117253-57f5-0d22-597d-3892df2e8904
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b1117253-57f5-0d22-597d-3892df2e8904
msgctxt "haf1ac02agbbe6g4186gb534g4d4cddf6fd5c"
msgid "Well, to begin, I think a toast is in order. Any suggestions?"
msgstr "음, 일단 우선 건배부터 하는 게 맞겠다. 좋은 생각 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = b2522958-b643-90d0-d220-355bf687a03f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b2522958-b643-90d0-d220-355bf687a03f
msgctxt "h072bf34fg066bg4bb1g8b4bg0f1811b0fc19"
msgid "There are other things we could do besides talk."
msgstr "이야기하는 것 말고도 우리가 할 수 있는 게 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = b270c2f2-2caf-fd9c-b41c-e5821f45ffb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b270c2f2-2caf-fd9c-b41c-e5821f45ffb9
msgctxt "h78e879fdg3787g4973gab8cg854874cd6826"
msgid "Very practical. We could've toasted to that every night so far."
msgstr "정말 실용적이구나. 지금까지 지낸 모든 밤에 대해 건배할 수도 있었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = b55e3c80-37b1-06c3-dcf8-9734390c0482
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b55e3c80-37b1-06c3-dcf8-9734390c0482
msgctxt "hb57ff7cbgf6b6g481cg89bfg4f2e27c52927"
msgid "That's a convenient way to avoid the question."
msgstr "질문 피하기에 참 편리한 수법이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = b58e9616-b47a-893d-5676-2fc41dbf1914
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_SC_NightWithShadowheart_SharedPersonal(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b58e9616-b47a-893d-5676-2fc41dbf1914
msgctxt "h1c1797c7g8cc4g485bga378g2d23493db666"
msgid ""
"<i>Lower your guard and describe the desolate beauty of your home: Crèche "
"K'liir.</i>"
msgstr "<i>경계심을 낮추고 당신의 고향, 클리르 양성소의 황폐한 아름다움을 묘사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = b7bff6db-e3cf-e029-e8ba-fa83ba700be6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b7bff6db-e3cf-e029-e8ba-fa83ba700be6
msgctxt "h237bad19g50abg4ddfgb2dag7b6d680e8a0c"
msgid "I suppose I'll find out. To us."
msgstr "무슨 뜻인지는 앞으로 알게 되겠지. 우리를 위하여."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = b829fb4d-df7c-76ae-4374-0cc364c1b5d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:b829fb4d-df7c-76ae-4374-0cc364c1b5d3
msgctxt "h4216cccaga781g44b3ga062g2fbeee74ade2"
msgid "I wouldn't dream of missing it."
msgstr "이 순간을 놓치는 건 꿈에서도 생각지 않았을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = ba27f696-5758-7997-0fcc-7134f3293c03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:ba27f696-5758-7997-0fcc-7134f3293c03
msgctxt "h864a4bbdga40cg41c3g9b71g43474db8eb93"
msgid "To not being poisoned - how about that?"
msgstr "독살되지 말기를, 그건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = be1c29e1-86ba-576d-4e76-baf0ae1b1f2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:be1c29e1-86ba-576d-4e76-baf0ae1b1f2a
msgctxt "h81a5d4f2g74c0g43a4ga8a3gb8c814daa6ef"
msgid "What?"
msgstr "뭐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = bede54bc-5f39-3892-04f0-70cf623bdca1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_Event_ToastSuccess = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:bede54bc-5f39-3892-04f0-70cf623bdca1
msgctxt "hec95e830g24e5g4defg84c6gce61fc6680ee"
msgid "I seem to recall a campful of goblins faring very poorly after a toast."
msgstr "고블린 무리가 건배를 나누고 어떻게 됐는지 기억나는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = c3357d87-6283-6b37-962b-958534347458
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:c3357d87-6283-6b37-962b-958534347458
msgctxt "hbd133bdcg4fc4g404fg9e97gf20d70bbe545"
msgid "Well deserved, though."
msgstr "하지만, 그럴 만했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = c559cb46-cdfd-53a5-1976-c3cdfb368f94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:c559cb46-cdfd-53a5-1976-c3cdfb368f94
msgctxt "hce3a94b3gd851g4f86ga9f0g4c720ad7c639"
msgid "You're sweet."
msgstr "너 정말 다정하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = c65e8a9d-15c8-8abf-7578-0f7535545f93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:c65e8a9d-15c8-8abf-7578-0f7535545f93
msgctxt "h5bb0971ag0061g43b1g961dgd80f738f3043"
msgid "I wish I could kiss you."
msgstr "너랑 키스하고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = cd0f7b17-1fe7-c28f-a2b8-b7a488a457d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - Shadowheart_InParty_Knows_PersonalInfo(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:cd0f7b17-1fe7-c28f-a2b8-b7a488a457d1
msgctxt "h40e0b3e2gccdbg4994g95b4g5041b50efd6b"
msgid "Wrong. You like night orchids and can't swim. You told me once."
msgstr "틀렸어. 넌 밤 난초를 좋아하고 수영을 할 줄 몰라. 나한테 말해준 적 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = cdc21051-6dbb-f087-5521-c882f230d559
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:cdc21051-6dbb-f087-5521-c882f230d559
msgctxt "h326748e0gc2adg4230gba72g7ff3473a0f0c"
msgid "Here's to many more. Survival."
msgstr "더 많은 날들을 위해. 살아남자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = ce225c6b-1d95-7895-c54d-25d7bc0873e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:ce225c6b-1d95-7895-c54d-25d7bc0873e9
msgctxt "hed6a6682gc067g4069gb4f6geb00b553d2fd"
msgid ""
"Oh, I see. Think I can't get you to confess? I'm something of an expert."
msgstr "오, 그래. 내가 네 자백을 못 받아낼 것 같아? 이래 봬도 그쪽으론 꽤 전문가거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = cf7a1507-98c2-0812-39f2-5796fcad1dce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:cf7a1507-98c2-0812-39f2-5796fcad1dce
msgctxt "hd163de70g4f56g457fgb044gcc93e5c63833"
msgid "To us."
msgstr "우리를 위하여."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = cf92c703-641a-c391-a533-8a9624955c13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:cf92c703-641a-c391-a533-8a9624955c13
msgctxt "h8202e6b8g0cd6g4080g8fe6g370f634bbdb1"
msgid ""
"I can relate. I think I used to have a place of my own I liked to retreat "
"to... but it slips my mind."
msgstr "공감이 가네. 나도 안정을 얻을 장소가 있었던 것 같은데... 기억이 나질 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = d0808c04-d91a-3acc-1024-4b0fc467032e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:d0808c04-d91a-3acc-1024-4b0fc467032e
msgctxt "he1919baag3161g49begb699gd19091d50814"
msgid "I know."
msgstr "나도 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = d1c412c4-ff85-594d-7d3d-a7c3a19c4fec
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_UNDERDARK
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:d1c412c4-ff85-594d-7d3d-a7c3a19c4fec
msgctxt "h104a6fcag67d0g4f10ga138g827a60c2332c"
msgid "You must have an extraordinary affinity for the darkness. I'm jealous."
msgstr "넌 어둠에 대해 남다른 애착을 가지고 있는 게 틀림없겠구나. 부러워라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = d1c412c4-ff85-594d-7d3d-a7c3a19c4fec
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:d1c412c4-ff85-594d-7d3d-a7c3a19c4fec
msgctxt "h1e4d0f31g2e6dg48ffga135g2157b734a87e"
msgid ""
"Whatever I said about your kind before, trust I'll never accuse you of being "
"boring."
msgstr "내가 너희 종족에 대해 무슨 말을 했었든 간에, 너희가 지루하다고 할 일은 절대로 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = d1c412c4-ff85-594d-7d3d-a7c3a19c4fec
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: !(REALLY_GITHYANKI and REALLY_UNDERDARK)
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:d1c412c4-ff85-594d-7d3d-a7c3a19c4fec
msgctxt "hcbcf9842gab7cg4e80gab32gc2aec387bf9d"
msgid ""
"Seems like you truly know the city. I never got to explore it to my liking."
msgstr "너는 그 도시를 정말 속속들이 잘 알고 있구나. 나는 내키는 대로 돌아다녀 볼 기회가 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = d1e4ea6f-a629-7acd-f5f3-092a848ddf07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:d1e4ea6f-a629-7acd-f5f3-092a848ddf07
msgctxt "h348552d2gc51bg4159gabd2g68194515bdaf"
msgid "I was hoping for a toast. Any suggestions?"
msgstr "건배를 했으면 좋겠다 싶었지. 좋은 생각 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = d42e5cb5-1a8b-dc2a-c110-47ca0efdbfc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:d42e5cb5-1a8b-dc2a-c110-47ca0efdbfc4
msgctxt "ha3afc731g3003g4425gacefg35de9648a4f1"
msgid "<i>Look into her eyes.</i>"
msgstr "<i>그녀의 눈을 바라본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = d441112e-b65f-e9a5-ee74-0da55f86320e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#. SetFlags:
#.   Quest:
#.     - ORI_COM_ShadowHeart.LearnedMemorySupressed(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:d441112e-b65f-e9a5-ee74-0da55f86320e
msgctxt "h5bdd089eged12g445fgb82cg7683e06a69f5"
msgid ""
"When you worship Shar, secrecy is everything. We'll sacrifice our own "
"memories when ordered to."
msgstr "샤님을 섬기면, 비밀 엄수가 가장 중요해. 그러기 위해서 스스로의 기억을 억제하기도 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = dd9daace-497d-005d-8cea-a3571c210d1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:dd9daace-497d-005d-8cea-a3571c210d1b
msgctxt "hf1e0a639g5d9bg43a4g96a4gc2117921f978"
msgid "Right. 'Friendship'."
msgstr "그래. '우정'이라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = debc5dd7-9489-d97b-5524-667d097e6920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:debc5dd7-9489-d97b-5524-667d097e6920
msgctxt "hed7fa441g3621g4c49g8dd9gf4f6497ec671"
msgid "You can be tricky sometimes, you know."
msgstr "있잖아, 가끔 보면 넌 가끔 영리한 면이 있는 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = df859d3a-8004-b4c3-4cce-3b8eec23cff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:df859d3a-8004-b4c3-4cce-3b8eec23cff1
msgctxt "h28b26c02g5265g4617g811dg64cbbc1801ab"
msgid "The others can wait. I don't want this to end just yet."
msgstr "다른 이들은 기다리라고 하자. 이 순간을 아직 끝내고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = e08e2b56-1136-7df4-4f8d-e2a84e31dd6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:e08e2b56-1136-7df4-4f8d-e2a84e31dd6f
msgctxt "h1c7420fegc90dg45e5gb07dg2c925c4112f2"
msgid "Never mind."
msgstr "신경 쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = e0ff56a9-8da3-9a05-b327-2ac66686558c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:e0ff56a9-8da3-9a05-b327-2ac66686558c
msgctxt "h9f19ca8eg86d2g4e82g8ebcg9c0bd151a21f"
msgid ""
"I can respect that sort of loyalty. It's not all that removed from what was "
"instilled in me..."
msgstr "그런 충성심은 존중할 수 있어. 나도 내게 부여된 것에서 완전히 벗어난 것은 아니지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = e166e1a0-401f-054b-9bec-f6b770bec0f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:e166e1a0-401f-054b-9bec-f6b770bec0f7
msgctxt "hfe90c347gc68ag44bdg9effgb409f4d01d77"
msgid "Which is why I'm looking for a little company."
msgstr "그래서 내가 동료를 좀 찾고 있는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = e2e8cf67-f437-b17b-36fb-9c9f13948a64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:e2e8cf67-f437-b17b-36fb-9c9f13948a64
msgctxt "hf68b9931g5685g4c11ga6c8g5cac70b85be3"
msgid "Oh? And what else do you find to be fair?"
msgstr "오? 그리고 또 뭐가 공정하다고 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = ea58d72f-7398-49db-2255-0e3175de4e79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:ea58d72f-7398-49db-2255-0e3175de4e79
msgctxt "he00d8dccg1d93g4f2dgb731ga4920676ec8c"
msgid "I'm sure they'd last another while without us. But if you insist..."
msgstr "분명 당분간은 우리가 없어도 괜찮겠지만. 네가 원한다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = eb63c5e6-c72f-5f93-cd6d-4a2bb6ea5b1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:eb63c5e6-c72f-5f93-cd6d-4a2bb6ea5b1a
msgctxt "hb00e68b1g1b28g4625g8e2cgd287de2d0c38"
msgid "No. Far from it."
msgstr "아니. 고통과는 거리가 멀었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = ee706f81-2a3e-0acc-b588-7011dcaee4da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:ee706f81-2a3e-0acc-b588-7011dcaee4da
msgctxt "h29c86f2cg3991g4741g8fe8g3a65e09669da"
msgid "Just checking for signs of ceremorphosis."
msgstr "그냥 뇌변이의 징후를 확인하는 중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = eed46f0d-24ad-c5cb-6a7b-e3c1e60efff7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Dialog:
#.     - CAMP_GoblinHuntCelebration_SC_NightWithShadowheart_SharedPersonal(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:eed46f0d-24ad-c5cb-6a7b-e3c1e60efff7
msgctxt "hfd4b71aagea37g45e1g863cg3ca1bf8b4b81"
msgid ""
"<i>Tell her about a quiet spot in Avernus you used to visit. Ugly as sin, "
"but at least you could be alone.</i>"
msgstr ""
"<i>그녀에게 전에 방문했던 아베르누스의 조용한 장소에 대해 말해준다. 비참하긴 하지만, 적어도 혼자 있을 수는 있을 테니까.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = f27a148b-f841-1431-b9f0-2caf4acf639a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f27a148b-f841-1431-b9f0-2caf4acf639a
msgctxt "h2ffcd31cgf880g46b8gba3fg1ae74b511bb6"
msgid "We should get back, then."
msgstr "그렇다면, 돌아가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = f5ddb3f7-161d-832b-e849-6be8e63aeeea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f5ddb3f7-161d-832b-e849-6be8e63aeeea
msgctxt "h7ebf0981gf601g4463g974fgaef43af7d8ac"
msgid "Does that mean you're spoken for or not? Heh."
msgstr "그럼 넌 임자가 있다는 거야, 없다는 거야? 하."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = f731104c-ef12-be1c-c844-f7fcb7f35433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f731104c-ef12-be1c-c844-f7fcb7f35433
msgctxt "h17e793d7g1b53g453fgab77gf9f6b5e57dfa"
msgid "Honestly? You."
msgstr "솔직히? 너."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = f7540901-e9b4-b5a9-cd97-dca93d0b8a31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f7540901-e9b4-b5a9-cd97-dca93d0b8a31
msgctxt "h20fcc9a2g89d1g4677gbd6fg94e0342af4ea"
msgid "Let's head back. If we must."
msgstr "돌아가자. 그래야 한다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = f767180b-e66e-99d4-4f62-ad94a9f0fd8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f767180b-e66e-99d4-4f62-ad94a9f0fd8d
msgctxt "h4461f143ge507g453egae20g0683ebcc909b"
msgid "Merciless, but beautiful in its own way... Sounds familiar."
msgstr "무자비하지만, 자신만의 방법으로 아름답다... 익숙한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = f88078cf-c361-8e0b-8a3e-21c441dbf1ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f88078cf-c361-8e0b-8a3e-21c441dbf1ba
msgctxt "hb5ee1c69g6737g4082g994cg6608f9d25db4"
msgid "...I like it. To victory."
msgstr "...마음에 들어. 승리를 위하여."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = f942b94b-68e2-f898-d647-08d6d2845f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f942b94b-68e2-f898-d647-08d6d2845f59
msgctxt "h8956a844g0814g481dgbb10g6f945a33ac06"
msgid "There's still plenty of wine and the whole night ahead of us."
msgstr "아직 포도주도 충분히 남아 있고, 즐길 밤도 남아 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Player
#. NodeID = f962209c-352e-1747-b5cc-815478e64249
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:f962209c-352e-1747-b5cc-815478e64249
msgctxt "hff202b7agb5fcg4cd3g9191gd01b7399e0f9"
msgid "You first."
msgstr "너 먼저."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart
#. Speaker = Shadowheart
#. NodeID = fe41ec0f-8acb-816f-6622-0bb5ec376cab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_ROM_NightWithShadowheart:fe41ec0f-8acb-816f-6622-0bb5ec376cab
msgctxt "h96c4eea1g86a0g4f44ga3bege23e0b74100f"
msgid "Not one for taking things slowly, I see."
msgstr "천천히 즐기는 타입은 아니구나, 알겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 0d935fbc-86c6-876f-4222-928f1c09457d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:0d935fbc-86c6-876f-4222-928f1c09457d
msgctxt "h93d4d862g8e0bg47f2gb69dg7a3cb2a76528"
msgid ""
"*The buzz of celebration quiets to a soothing hum as you approach your bunk.*"
msgstr "*잠에 들 시간이 다가오자, 축하의 소리가 점점 차분한 콧노래처럼 조용해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 1334f2bc-c13d-ab26-dae6-7ae417fe6820
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:1334f2bc-c13d-ab26-dae6-7ae417fe6820
msgctxt "h4706fc91ga08eg4890ga225g9605eac2450e"
msgid ""
"*As she looks you up and down, her mind touches yours - you feel her hand at "
"your neck, her lips closing around yours.*"
msgstr ""
"*그녀가 당신을 위아래로 바라볼 때 그녀의 마음이 당신의 마음에 닿습니다. 당신은 그녀의 손이 당신의 목에 닿고 그녀의 입술이 당신의 "
"목을 감싸는 것을 느낍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 2631760b-492b-c085-dbbd-dd8b1214ac11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:2631760b-492b-c085-dbbd-dd8b1214ac11
msgctxt "h25546af9g25b6g45bbg8fedg992d08782287"
msgid "*Though you seek repose, you needn't spend the night alone.*"
msgstr "*쉬고 싶긴 하지만, 밤을 혼자 보낼 필요도 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 2de173d5-1a73-80b7-da3c-626b962dbe93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AdditionalPartner(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:2de173d5-1a73-80b7-da3c-626b962dbe93
msgctxt "ha53c44beg3b02g4ad7gaaf3g630d3026e8ff"
msgid "*Your hand was sought by several, but there is only one night ahead.*"
msgstr "*여러 사람이 당신의 손을 찾았지만 앞으로 하룻밤만 남았습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 31aacef5-fdcb-c4eb-8ffc-fa3dbea582f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingKarlach(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:31aacef5-fdcb-c4eb-8ffc-fa3dbea582f8
msgctxt "haae42259g88a5g4e7cg82d7gc9d4077d1edf"
msgid "<i>Spend the night thinking of Karlach.</i>"
msgstr "<i>칼라크를 생각하면서 밤을 보낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 429b1e25-50b5-a4d3-f219-7303ca4d82cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingGale(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:429b1e25-50b5-a4d3-f219-7303ca4d82cd
msgctxt "h475d99b1g266eg4a39ga285g0ad824252078"
msgid ""
"<i>While away the night, fantasising where Gale could take you in the "
"Weave.</i>"
msgstr "<i>게일이 자신을 어떤 위브의 세계로 데려갈 수 있을지 상상하며 느긋한 밤을 보낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 492d8502-54d9-1a09-8b10-8929a1cfea12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:492d8502-54d9-1a09-8b10-8929a1cfea12
msgctxt "h5104da6fgc2a3g4dc6g8a20gf3b8eec5eea3"
msgid "*Or perhaps you will be the one taking him...*"
msgstr "*아니면 당신이 그를 데려갈 수도 있습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 4bd801a9-fb91-927f-85b2-bb6ae274a3c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingLaezel(0) = True
#.      - CAMP_GoblinHunt_State_LaezelAgreedBefore(0) = False
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:4bd801a9-fb91-927f-85b2-bb6ae274a3c3
msgctxt "ha5fd52adgafbeg4a19g9289g6fa5bc2bc4b3"
msgid "<i>Go to bed, thinking of Lae'zel.</i>"
msgstr "<i>레이젤을 생각하며 잠자리에 든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 55637cbe-dc18-9472-fa1e-ff1596df0c4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingShadowheart(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:55637cbe-dc18-9472-fa1e-ff1596df0c4e
msgctxt "h60907ad6g60c1g4cf0g8f7ag3c24e48943ba"
msgid ""
"<i>Try to push twisting thoughts of Shadowheart from your mind, and seek "
"sleep.</i>"
msgstr "<i>섀도하트에 대한 뒤틀린 생각을 마음에서 떨쳐내고 잠을 청한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 5a0f478e-4f4d-c986-d6c7-97a4d9bf50a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_GoblinHunt_State_DrowHasPartner = True
#.   Object:
#.     - CAMP_GoblinHunt_State_DrowPartnerChosen(0) = True
#.     - CAMP_GoblinHunt_State_HasPartner(0) = True
#.     - CAMP_GoblinHunt_State_DrowPartner(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:5a0f478e-4f4d-c986-d6c7-97a4d9bf50a5
msgctxt "h3610ee8bgbea9g4befgbfd9g8f0f87789930"
msgid "Yes. I'm yours, Minthara."
msgstr "물론. 난 네 것이야, 민타라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 5fcd0ed0-607b-9a65-9799-f30f1137ffe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:5fcd0ed0-607b-9a65-9799-f30f1137ffe1
msgctxt "hcfe7f2abg6061g4a1cgb7e6g59bd1b905023"
msgid "*There is one who yearns for you in the dark... Who will you seek?*"
msgstr "*어둠 속에서 당신을 갈망하는 사람이 있습니다... 누구를 찾으시겠습니까?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Nightwarden Minthara
#. NodeID = 65744903-c0c5-26c9-69e1-c9136b9e4a72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:65744903-c0c5-26c9-69e1-c9136b9e4a72
msgctxt "h76af2323gd3ceg4981gad22ge4f95ae557a0"
msgid ""
"I was hoping to find you before you turned in for the night. My blood runs "
"hot after the battle."
msgstr "네가 잠들기 전에 널 찾으려고 했어. 전투가 끝나고 피가 뜨거워졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 6a2b8812-60ed-b76e-8ed6-70f2897292ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_ShadowheartAdditionalPartner(0) = True
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_ShadowheartPartnerChosen(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:6a2b8812-60ed-b76e-8ed6-70f2897292ed
msgctxt "h337282d3g70ddg4da0g966agcfbcc4cbabf2"
msgid "<i>Shadowheart.</i>"
msgstr "<i>섀도하트.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 6b632bb8-a425-488d-564e-8d6c96244894
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:6b632bb8-a425-488d-564e-8d6c96244894
#, fuzzy
msgctxt "hdbb7a814gc6c0g4a17gbcdeg9e625b832fda"
msgid "*Whose company will you seek, at least for tonight?*"
msgstr "*누구랑 만날까요? 적어도 오늘 밤은 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 714f6e88-ba32-2132-7df3-a457d153eab2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_DrowRefused(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:714f6e88-ba32-2132-7df3-a457d153eab2
msgctxt "h96fd9fb4g1197g4828ga8c8ge2c151d7e120"
msgid "Back off. I'm not interested."
msgstr "물러 서. 난 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 73e30438-8633-d6c9-bf85-090b29c8bec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:73e30438-8633-d6c9-bf85-090b29c8bec4
msgctxt "h091a3423g79b6g430dga0d5g399ee1d85f23"
msgid ""
"*You've picked up a few pleasant memories on your journey, amongst your "
"struggles.*"
msgstr "*힘들었던 여정 중에서도 몇몇 즐거운 추억이 생각났습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 7728bbad-f2ef-3d7b-aaad-67f92772a989
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_WentToBedAlone(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:7728bbad-f2ef-3d7b-aaad-67f92772a989
msgctxt "h57a62453gc87ag415bgbc46gb3b75cb24428"
msgid "<i>Go to bed alone.</i>"
msgstr "<i>혼자 잠자리에 든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 7ca37d6a-c107-4101-fd53-6b25a72675e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:7ca37d6a-c107-4101-fd53-6b25a72675e6
msgctxt "he082245bgec78g4d1cga146gafa9bac0b481"
msgid "*You sleep alone, uplifted by memories of your recent triumphs.*"
msgstr "*당신은 승리에 대한 기억에 고취되어 혼자 잠에 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 81731096-6622-7ee9-398f-22a0ac0fd5bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionAdditionalPartner(0) = True
#. SetFlags:
#.   Object:
#.     - CAMP_GoblinHunt_State_AstarionPartnerChosen(0) = True
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:81731096-6622-7ee9-398f-22a0ac0fd5bc
msgctxt "h5819285fg4071g4677g9e31g9111e8656d39"
msgid "<i>Astarion.</i>"
msgstr "<i>아스타리온.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 84a2c4ae-c810-81a7-d128-a6f5c923bd38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:84a2c4ae-c810-81a7-d128-a6f5c923bd38
msgctxt "h37e54e48gf651g4d57g9dc8ge867962861be"
msgid ""
"*Somewhere, in a corner of your heart, you suspect he might be dreaming of "
"you, too.*"
msgstr "*마음 한 구석 어딘가에서, 그도 당신의 꿈을 꾸고 있을지도 모른다는 생각이 들기도 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Narrator
#. NodeID = 9de596f0-bc8c-33a6-977d-ad9ad5bb61cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight:9de596f0-bc8c-33a6-977d-ad9ad5bb61cd
msgctxt "h3ac4e821ge43fg4ca8g833ag74f876820a25"
msgid ""
"*Your body aches pleasingly with the memory of past bruises. Perhaps it is "
"the same for her.*"
msgstr "*과거의 멍에 대한 기억으로 몸이 기분 좋게 아픕니다. 아마 그녀도 마찬가지일 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_GoblinHuntCelebration_SD_SelectNight
#. Speaker = Player
#. NodeID = 9fe4445c-763e-840c-8033-3aeb854db408
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_LaezelPartner(0) = True
#. SetFlags:
