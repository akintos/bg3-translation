#, fuzzy
msgctxt "h056bc631g41e6g441ega73eg7b8d6e0989f9"
msgid "Having fun, are you?"
msgstr "재밌어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight
#. Speaker = Astarion
#. NodeID = 0d227bca-45e2-46ce-bdae-8b606f81a73b
