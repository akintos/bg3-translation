msgctxt "h882a87aeg18b2g4434g925egb0aedeb1e4fd"
msgid "We should go down and see the water."
msgstr "저기로 가서 강 구경하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Danis
#. NodeID = e69c1acd-c93d-32af-e60e-c9f052f94c06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 966616f6-f9a1-58cc-6369-867f4c00cd23_A = True
#.      - 966616f6-f9a1-58cc-6369-867f4c00cd23_C = False
#.      - 966616f6-f9a1-58cc-6369-867f4c00cd23_B = True
#. SetFlags:
#.   Local:
#.     - 966616f6-f9a1-58cc-6369-867f4c00cd23_C = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:e69c1acd-c93d-32af-e60e-c9f052f94c06
msgctxt "hbe8cda72gaf09g40d4gbc28g1a126a67d243"
msgid "You recall how I love you very dearly?"
msgstr "내가 자기를 얼마나 사랑하는지 알지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2
#. Speaker = Bex
#. NodeID = f5f5c226-4493-a98c-142e-e3e5f4a5f397
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Lover1_Lover2:f5f5c226-4493-a98c-142e-e3e5f4a5f397
msgctxt "h0091a8e1g56bag4736ga340g0c9a600463bf"
msgid "It's a bed and a roof for me. But off you go, master ranger."
msgstr "나는 번듯한 숙소를 원해서 별로. 뭐, 응원은 해줄게, 마스터 레인저님."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_ParentsAlone
#. Speaker = Locke
#. NodeID = 09baaf70-8da9-fde1-d9b6-6632c6ed9940
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
