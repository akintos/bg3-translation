#. NodeID = 0cfc0640-2663-50a7-2cee-4beec0b5bdcd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:0cfc0640-2663-50a7-2cee-4beec0b5bdcd
msgctxt "he5a4b531gdfaag489bgb456g851dfd3b6cf0"
msgid ""
"*Silver swords stained with shimmering <i>ghaik</i> blood - a comforting "
"notion. Your queen is eternal and your people untouchable.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 0d552a6c-fe48-2a1c-1e73-6f1c25d5c09e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:0d552a6c-fe48-2a1c-1e73-6f1c25d5c09e
msgctxt "he7999e5cged79g4442gb885gf05661c59c53"
msgid ""
"*Her words were carved in slate and her figure carved in granite. She was "
"silver, she was iron, she was your reason for being.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 0f994f17-315a-ca99-f001-c24d1a87c65b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:0f994f17-315a-ca99-f001-c24d1a87c65b
msgctxt "hc928c93cg5c94g478dgacbcg86fab735f188"
msgid ""
"*Yet even within reverie, the figure's final words penetrate as a silver "
"sword into illithid flesh:*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 13baac85-362d-f569-944a-ad23250ad09e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:13baac85-362d-f569-944a-ad23250ad09e
msgctxt "hde86bdc7g9f41g4cdag91f5g8d3e752dce3e"
msgid ""
"*Vlaakith will stop at nothing to retrieve the Prism - even if it means "
"sacrificing Lae'zel of K'liir, her most faithful champion.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 1660b672-652b-fb05-7688-336466794073
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:1660b672-652b-fb05-7688-336466794073
msgctxt "h1be93c3agbeafg4367g86bdg812ee54b931a"
msgid ""
"<i>Heresy. Your queen bears the might of the Astral Sea. The </i>ghaik<i> "
"are no threat to the githyanki.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 183e22ed-cecf-32e7-9ff3-c7a01e848210
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_AstralPrison_State_KilledDaisyDuringDialog = True
#.   Object:
#.      - GLO_Daisy_Event_SwapTrack_Fear(0) = False
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RestedAfterCreche = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:183e22ed-cecf-32e7-9ff3-c7a01e848210
msgctxt "hd88cb9d8g9740g48e8g8d7bgd73fbb357b3d"
msgid "*'I know a secret that Vlaakith never wants to be revealed.'*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 1855535d-e389-05f5-ebca-74d8597ad481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:1855535d-e389-05f5-ebca-74d8597ad481
msgctxt "h15a63ac6g492dg45cdga2d6g5896cad5283d"
msgid "*Moonrise is your destiny. That is where the truth will finally out.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 1dfc6602-0b55-23a6-8858-b85a3a557555
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:1dfc6602-0b55-23a6-8858-b85a3a557555
msgctxt "hc481ad3eg6cf7g4c16g8170gc23d97790df5"
msgid ""
"<i>If the figure holds the power to resist illithid control, you must return "
"it to Vlaakith.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 1fccda66-8cfb-a38d-b27c-9378faadc3b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:1fccda66-8cfb-a38d-b27c-9378faadc3b7
msgctxt "h929c7541gc641g4f82g87c5g0a095c49d193"
msgid "*What must you do next?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 228b2d7c-806f-014d-4ead-8192c9f71cd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:228b2d7c-806f-014d-4ead-8192c9f71cd1
msgctxt "h303b1044g7905g46f8g8834gf0df2dd8f866"
msgid ""
"<i>Lies, every word of it. </i>Ghaik<i> trickery played on you by the "
"parasite in your head.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 2aaf3b67-93d1-13db-806b-5f3d8c501cad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:2aaf3b67-93d1-13db-806b-5f3d8c501cad
msgctxt "h5ec453ecg7361g4b85g822ag75e8e02bbdb0"
msgid ""
"*It was in Vlaakith's name that you learned the art of the blade. It was by "
"her protocol that you sought purification.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 2f157d4a-bea5-19cb-efd6-87146dff2870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:2f157d4a-bea5-19cb-efd6-87146dff2870
msgctxt "ha6193cbdgf07dg4054gbcc1g0286b8561498"
msgid ""
"<i>Lies, every word of it. </i>Ghaik<i> trickery played on you by the "
"parasite in your head.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 34eee948-9bfd-5601-7241-c18c028d8eb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_UsedDevice = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:34eee948-9bfd-5601-7241-c18c028d8eb7
msgctxt "h4b3eaef6g4d7fg4a93g98e0g11906eab5b01"
msgid ""
"<i>The </i>zaith'isk<i> failed. Your people have turned on you. There must "
"be truth in the figure's words.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 352428e7-9ed4-894b-e58f-d612ce5868a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:352428e7-9ed4-894b-e58f-d612ce5868a6
msgctxt "hd3955449gb6efg4f8eg9f99g12d0d17c9c13"
msgid ""
"*Could the Undying Queen truly be powerless against the Illithid Empire, as "
"the dream figure said?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 36704040-1235-7940-308f-0b8e4b24d6e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:36704040-1235-7940-308f-0b8e4b24d6e0
msgctxt "h3f584dedgaea1g475dga4abg5bd502e4f52c"
msgid ""
"*But now? Now, doubt gnaws at your skull like a tadpole gnaws at its host.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 38e68bf6-db9a-ffe2-baae-d9f15018851c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:38e68bf6-db9a-ffe2-baae-d9f15018851c
msgctxt "he5c912b3g4f4fg4240g8d0eg392ab5932497"
msgid ""
"*You want little more to rid yourself of the <i>ghaik</i> tadpole in your "
"head.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 3d1e94d8-bc40-acf8-c1c1-0fd26c78978a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_AstralPrison_State_KilledDaisyDuringDialog = False
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RestedAfterCreche = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:3d1e94d8-bc40-acf8-c1c1-0fd26c78978a
msgctxt "hc9d3246agc77fg460bg84e8ge404fe34db79"
msgid "*'Queen Vlaakith is lying to you and your people.'*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 3d42dc0a-eefb-600f-3fd9-c63bc75f6404
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_AstralPrison_Event_ReturnMoonrise(0) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:3d42dc0a-eefb-600f-3fd9-c63bc75f6404
msgctxt "h18e884b5ga7e2g465bgbf5fgea00ba4098b6"
msgid "*'You were on the right path - to Moonrise Towers. Return to it.'*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 3ec08586-89f8-28a7-e2b0-603ee5726691
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:3ec08586-89f8-28a7-e2b0-603ee5726691
msgctxt "hc27c2996gef98g4ac8gaa18g1bd9ff12cac5"
msgid ""
"*Vlaakith is afraid. Afraid of what you might discover. Afraid of <i>you</"
"i>. And your most reliable ally lives inside the Prism you carry.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 3ede25d4-883a-24e3-a5d1-4ee6f4f06001
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:3ede25d4-883a-24e3-a5d1-4ee6f4f06001
msgctxt "h7ad373bag8f56g497cga44dgf2ec5e543b4d"
msgid ""
"*You were taught that she would reward her most vicious adepts with "
"ascension - an invitation to the imperial city of Tu'narath.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 44e86419-cc27-d948-2416-5df5e4da8d8b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:44e86419-cc27-d948-2416-5df5e4da8d8b
msgctxt "h0417f0c8gfea8g48f1g8a55g4c8b414a7eb5"
msgid ""
"<i>This figure is protecting you from the Absolute. He is an ally - and "
"worth hearing out.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 44e86419-cc27-d948-2416-5df5e4da8d8b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:44e86419-cc27-d948-2416-5df5e4da8d8b
msgctxt "h0e83971ega9ebg4edagaeb6g539af12cb848"
msgid ""
"<i>This figure is protecting you from the Absolute. She is an ally - and "
"worth hearing out.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 44e86419-cc27-d948-2416-5df5e4da8d8b
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:44e86419-cc27-d948-2416-5df5e4da8d8b
msgctxt "h0d614e2cg05b7g43acg9a18gbe72247a178f"
msgid ""
"<i>This figure is protecting you from the Absolute. They are an ally - and "
"worth hearing out.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 476deefe-9a67-b2f4-e2ef-474f835f7d1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:476deefe-9a67-b2f4-e2ef-474f835f7d1f
msgctxt "h8c6a6a74g0683g4be3ga4e3g54299cbb09f2"
msgid "*Now, doubt gnaws at you like a tadpole at its host.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 499f6672-64a5-c5b9-da4c-343350fcde68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:499f6672-64a5-c5b9-da4c-343350fcde68
msgctxt "h81b7cc9fg26c7g45e6g9208g746f3f13cac5"
msgid ""
"*Now your own people point their blades at you, Lae'zel of K'liir, "
"Vlaakith's most faithful warrior - just as your dream figure warned.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 4c00e11b-6e30-fb2a-e391-56d2b8bdb91c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RestedAfterCreche = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:4c00e11b-6e30-fb2a-e391-56d2b8bdb91c
msgctxt "h131dceb6ge8f0g431fg80aagb6c006a84f76"
msgid "*You did as the Undying Queen asked.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 5382e67f-dd04-51b4-f180-7b210fddaa7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:5382e67f-dd04-51b4-f180-7b210fddaa7c
msgctxt "h86870357gef63g49a7gabcdg7e3503af24d6"
msgid ""
"*Let Vlaakith's servants come for you if they dare. You will show them who "
"embodies the true essence of the githyanki.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 58c7367e-a8c2-ca02-6fbf-7dd171f25a37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:58c7367e-a8c2-ca02-6fbf-7dd171f25a37
msgctxt "h3e401be2g6e23g44a8g9629g1967cd6ac330"
msgid ""
"*The figure bid you to journey to Moonrise Towers. That is your destiny. "
"That is where the truth will finally out.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 58d03a8e-f2fd-2c86-b6d6-a5c9dbc25f5b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:58d03a8e-f2fd-2c86-b6d6-a5c9dbc25f5b
msgctxt "hd1338179gf2b1g4784gb2ecg31fdc58c753f"
msgid ""
"*Whoever this dream figure, one thing is clear: Vlaakith would sacrifice her "
"own faithful to slay him.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 58d03a8e-f2fd-2c86-b6d6-a5c9dbc25f5b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:58d03a8e-f2fd-2c86-b6d6-a5c9dbc25f5b
msgctxt "hf03fa8c0g5c07g4a2fg8b37g0111368fe3be"
msgid ""
"*Whoever this dream figure, one thing is clear: Vlaakith would sacrifice her "
"own faithful to slay her.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 58d03a8e-f2fd-2c86-b6d6-a5c9dbc25f5b
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:58d03a8e-f2fd-2c86-b6d6-a5c9dbc25f5b
msgctxt "h129965c7g062cg4d05ga824gf79d530a8a57"
msgid ""
"*Whoever this dream figure, one thing is clear: Vlaakith would sacrifice her "
"own faithful to slay them.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 77851eeb-324d-4d69-c933-35a79a2dfada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:77851eeb-324d-4d69-c933-35a79a2dfada
msgctxt "hf368aeb0g0ca4g46dag9ab6g8d00170f0976"
msgid ""
"*Even faith is no shield when it's your own goddess who would shatter you.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 7993ce82-002f-e469-7538-0bcb1fea1399
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:7993ce82-002f-e469-7538-0bcb1fea1399
msgctxt "h21b9df76g8213g4423g8635g3d263b5c7e9b"
msgid "*As a young warrior on K'liir, you'd never once questioned your queen.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 7a13eb32-9176-1ced-93c5-5c7990ac8507
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:7a13eb32-9176-1ced-93c5-5c7990ac8507
msgctxt "hf4eceeeeg55bbg472fg8dafg85a24cab4386"
msgid ""
"*These were the words of your dream figure. Not long ago, they pierced the "
"ethereal stillness of the Astral Plane.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 7e2225f5-60a1-226f-c65b-c13d7bb69305
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:7e2225f5-60a1-226f-c65b-c13d7bb69305
msgctxt "h431ad7b7gbb74g48f1g8d90geb6f9aa1a265"
msgid ""
"<i>This secret is not yours to know. You will return the Astral Prism to "
"Vlaakith and regain her favour.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 7f7d7cdb-a1aa-c9cc-3e5a-243fa9c1230a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:7f7d7cdb-a1aa-c9cc-3e5a-243fa9c1230a
msgctxt "hfbe36ab9g3c67g45d8g8ff2gd0ec7b76d7f7"
msgid "<i>Return the Astral Prism to Vlaakith and regain her favour.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 82e8567f-3c55-38b3-2396-66c577b131ca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:82e8567f-3c55-38b3-2396-66c577b131ca
msgctxt "h508cd651g25fag44a5g9daeg59efd7660dbf"
msgid ""
"<i>Look for a way back into the Prism and ask the dream figure what she "
"knows.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 82e8567f-3c55-38b3-2396-66c577b131ca
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:82e8567f-3c55-38b3-2396-66c577b131ca
msgctxt "h80c5b65fg2fa2g4909g98a9gcc6c6034016a"
msgid ""
"<i>Look for a way back into the Prism and ask the dream figure what he "
"knows.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 82e8567f-3c55-38b3-2396-66c577b131ca
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:82e8567f-3c55-38b3-2396-66c577b131ca
msgctxt "hfa83b001g257dg4ec2gb05ag91451374290f"
msgid ""
"<i>Look for a way back into the Prism and ask the dream figure what they "
"know. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 8639315f-5058-5f1c-3a65-00c98fc0ddbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:8639315f-5058-5f1c-3a65-00c98fc0ddbe
msgctxt "h3daffe42g3047g4ca0g8267g9cfb20bc9ebb"
msgid ""
"*'Vlaakith, show us truth. Vlaakith, make me pure. Vlaakith, I seek entry. "
"<i>Vlaakith, I am reborn</i>.'*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 86cccaa8-8acf-34bb-3a0f-daaca4afe7e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:86cccaa8-8acf-34bb-3a0f-daaca4afe7e6
msgctxt "h0c1a5fdbg7761g485bgae30g9a0c41529d5f"
msgid ""
"*Vlaakith knows this too. Perhaps the <i>zaith'isk</i> will cleanse you - or "
"perhaps the Undying Queen will see that it kills you.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 8ef98ee1-1aa9-3beb-6825-ffb27d0876b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:8ef98ee1-1aa9-3beb-6825-ffb27d0876b8
msgctxt "he210f356g1d75g4816g9566g49668539a6b2"
msgid ""
"*What secret could be so ruinous to the Undying Queen of the Six Arms of "
"Tu'narath?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 90cc444e-170b-eca1-cd73-f09f4a8bdb51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:90cc444e-170b-eca1-cd73-f09f4a8bdb51
msgctxt "h21ec867eg8ca1g4271g8f2eg7d9b87559105"
msgid ""
"*Your mind bursts with vicious images of githyanki knights tearing through "
"scores of mind flayers.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = 91ba72ee-bbed-6a5b-e76a-f8ef5b6f1661
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_UsedDevice = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:91ba72ee-bbed-6a5b-e76a-f8ef5b6f1661
msgctxt "h294c51d4g55e9g42a3gb713g33fb5efb78eb"
msgid ""
"<i>Your people have turned on you. There must be truth in the figure's "
"words.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = 9358a520-f12e-0218-7c84-046f43876786
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:9358a520-f12e-0218-7c84-046f43876786
msgctxt "h7de88401ga416g416eg8c9cgde88670dae2d"
msgid ""
"*Your people seek your head, just as the dream figure warned. Whatever this "
"secret, Vlaakith will kill her own faithful to keep it.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = a18f8a65-90b9-ee4d-8ac6-670dbb8c7417
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:a18f8a65-90b9-ee4d-8ac6-670dbb8c7417
msgctxt "h3f65187cgb9a0g4fedg8f95g486d872bcdf9"
msgid ""
"*What is this Astral Prism? Who is this dream figure? And what makes "
"Vlaakith so desperate to slay her?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = a18f8a65-90b9-ee4d-8ac6-670dbb8c7417
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:a18f8a65-90b9-ee4d-8ac6-670dbb8c7417
msgctxt "hc6b12b16g6fafg4bbfg9ec3g0324320a6b3d"
msgid ""
"*What is this Astral Prism? Who is this dream figure? And what makes "
"Vlaakith so desperate to slay him?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = a18f8a65-90b9-ee4d-8ac6-670dbb8c7417
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:a18f8a65-90b9-ee4d-8ac6-670dbb8c7417
msgctxt "h25d606c3gf5b6g43e5gb7b6g4ee995daef65"
msgid ""
"*What is this Astral Prism? Who is this dream figure? And what makes "
"Vlaakith so desperate to slay them?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = a58ed46b-a720-e290-f8f2-0fd167266818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:a58ed46b-a720-e290-f8f2-0fd167266818
msgctxt "hbd967c63gb0b7g4eebgb3d5g8db99c574e05"
msgid ""
"*If the <i>ghaik</i> empire should rise - if the Grand Design were to "
"transpire - it could be the doom of your people.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = a6340553-c030-94c3-4645-ab6f0a32ea66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:a6340553-c030-94c3-4645-ab6f0a32ea66
msgctxt "h1381e9begeeaeg48a6gadf3g86beb5c4318b"
msgid ""
"<i>There's no telling - but your people have turned on you. Vlaakith is "
"afraid of being found out.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = a885f8b0-0b96-2585-9c15-e592e851da34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:a885f8b0-0b96-2585-9c15-e592e851da34
msgctxt "h79b97499g302eg4449gbd32g84a87d59e57e"
msgid ""
"*As long as you carry the Prism - and the one inside - you remain Vlaakith's "
"prey.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = b3e1e040-e5d4-6c30-7852-821723201275
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:b3e1e040-e5d4-6c30-7852-821723201275
msgctxt "h92b0c622gb6f0g4175gafecgdeac795faa86"
msgid ""
"*Blasphemous words, looming as large in your mind as the towering figure of "
"Vlaakith herself.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = b403863b-aece-f282-a872-438418dc8fdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:b403863b-aece-f282-a872-438418dc8fdb
msgctxt "h4f1c31cdge19bg4a7ega488g84615d696c43"
msgid "*You entered the Astral Prism. You attacked the one inside.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = bd0f1f46-83d0-5d2d-2ac8-24487f44d291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:bd0f1f46-83d0-5d2d-2ac8-24487f44d291
msgctxt "h8865983ega4fbg48d8gb90cga71a4021fe52"
msgid ""
"*For now, the answers are locked tightly away. But there is one thing you "
"are most certain of:*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = c291bf14-ebc3-41e2-3d2d-337b5632e5f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:c291bf14-ebc3-41e2-3d2d-337b5632e5f6
msgctxt "h51353655ge6efg4167gb2ceg883c9dee1e26"
msgid "*Questions gnaw at your mind like a tadpole at its host.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = c457aa61-f1b5-8513-d466-9ac5527d327b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:c457aa61-f1b5-8513-d466-9ac5527d327b
msgctxt "h5d00b10bgc33cg430dg89d8g849ac7095a91"
msgid "*Such a feat would surely earn your queen's most gracious blessings.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = cfac8453-ea10-0a5a-b3c4-0c5803becfd1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:cfac8453-ea10-0a5a-b3c4-0c5803becfd1
msgctxt "hc193b750g5eb7g44e9gab0aga515bc18bcb7"
msgid ""
"*And come, they most certainly will. Whoever this dream figure, Vlaakith "
"would clearly sacrifice her own faithful to slay him.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = cfac8453-ea10-0a5a-b3c4-0c5803becfd1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:cfac8453-ea10-0a5a-b3c4-0c5803becfd1
msgctxt "hb3dabe39ge8dbg409bga0c8g8ea0c1b06a73"
msgid ""
"*And come, they most certainly will. Whoever this dream figure, Vlaakith "
"would clearly sacrifice her own faithful to slay her.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = cfac8453-ea10-0a5a-b3c4-0c5803becfd1
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:cfac8453-ea10-0a5a-b3c4-0c5803becfd1
msgctxt "h0fe05aa9g4352g49cfg95c3g2af3d2d124ed"
msgid ""
"*And come, they most certainly will. Whoever this dream figure, Vlaakith "
"would clearly sacrifice her own faithful to slay them.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = e03375fd-b352-1fa3-8eda-e194870bd39d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:e03375fd-b352-1fa3-8eda-e194870bd39d
msgctxt "hd9a2e82dg589dg48f2ga03eg3abbc9d40dd0"
msgid ""
"*You breathe slowly and deeply, seeking refuge from the figure's deceit in "
"the words of the sacred <i>Tla'ket</i>.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = e3cb756b-5cb8-f3eb-0732-ea9572a653f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:e3cb756b-5cb8-f3eb-0732-ea9572a653f3
msgctxt "h151a113fg621ag4f89ga69eg32dbdb05382b"
msgid "*But even in reverie, worry gnaws at you like a tadpole at its host.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = e5c7c5cd-19e9-7ad9-fa5c-203d6f10eec1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:e5c7c5cd-19e9-7ad9-fa5c-203d6f10eec1
msgctxt "h6fdce871g6eb0g4823g9811g1ebfe053dc66"
msgid ""
"<i>Do what you do best: fight. Bleed your own people if they come for your "
"head.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = e94db12f-b629-bc92-d2c6-b9f963c5bacb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:e94db12f-b629-bc92-d2c6-b9f963c5bacb
msgctxt "h348c2010ga913g4ef9g8d6fg83b6bd3b8cc4"
msgid ""
"*You can carry yourself tall knowing you were loyal in both deed and intent. "
"You are no heretic.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = ea471a68-33d5-b89e-8ea3-438f5d0b492c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:ea471a68-33d5-b89e-8ea3-438f5d0b492c
msgctxt "h5bb98b7cg58aeg441ag87d4g1f30470402b0"
msgid "*But even in reverie, doubt gnaws at you like a tadpole at its host.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = ee238fb7-c576-366c-ed99-f5957b39b5db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:ee238fb7-c576-366c-ed99-f5957b39b5db
msgctxt "h624ab7f3gd98dg4996g8fb1gde75149b57f6"
msgid ""
"*'You must go to Moonrise Towers. That is where the cultists are gathering.'*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Player
#. NodeID = f662f662-2f36-36c6-b00a-e49593b5520f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_UsedDevice = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:f662f662-2f36-36c6-b00a-e49593b5520f
msgctxt "h4cf4d14eg42abg4a23gbf30g584ee0c94b23"
msgid ""
"<i>Find the </i>zaith'isk<i> inside the crèche and cleanse yourself of the "
"parasite.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection
#. Speaker = Narrator
#. NodeID = fde74e57-cf2d-192b-a5b5-6974d5107ac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_SD_AfterCrecheReflection:fde74e57-cf2d-192b-a5b5-6974d5107ac8
msgctxt "hb4ac4ccbg3d21g4f71g8c8dgcfcab4c44687"
msgid "*As a young warrior on K'liir, you devoted your life to your queen.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 022fd0fa-2c36-e013-12ca-3c8240b1c68e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:022fd0fa-2c36-e013-12ca-3c8240b1c68e
msgctxt "h0798f590g178fg49dcga2d7gdd3ded87c46a"
msgid "<b>YOU WILL ANSWER TO ME.</b>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 0e54d3ad-2f22-dc49-53ec-46e698cbab0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:0e54d3ad-2f22-dc49-53ec-46e698cbab0c
msgctxt "ha77f7c49g9dadg44b5g8bddg2a95ab6902c9"
msgid ""
"*Prince Orpheus may be a threat to your people as she claims, or perhaps, a "
"threat to her rule.* "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 1271a589-0005-0bea-4145-6bb1683fe149
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:1271a589-0005-0bea-4145-6bb1683fe149
msgctxt "hfefe63d5gd49bg422bgb00agaedfc6d80553"
msgid "<i>Vlaakith tavki na'zin. <b>I am truth.</b></i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 13aa6fa6-81a9-a70b-2344-605034796926
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:13aa6fa6-81a9-a70b-2344-605034796926
msgctxt "h6c17aad1g006fg4304gb7ccg3d5a924870db"
msgid "You are <i>Hshar'lak</i>. And still you speak my name."
msgstr "너 <i>흐샬락</i>. 아직도 내 이름을 입에 담는가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = 13badc31-7d21-1ebf-9e05-9b5f53aff0bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:13badc31-7d21-1ebf-9e05-9b5f53aff0bb
msgctxt "h76c2a61ag2778g4056gb1bbg48e4c81c6081"
msgid "A projection this powerful? Impossible - isn't it?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 13e7e1f8-5fb5-cfc3-3a1c-0ced13b64670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:13e7e1f8-5fb5-cfc3-3a1c-0ced13b64670
msgctxt "h31961264gf081g4e56gb176g2480396c951f"
msgid "Find a way into the Astral Prism. Slay Orpheus the pretender."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 1518403a-4041-6742-a253-ff932c9ab892
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:1518403a-4041-6742-a253-ff932c9ab892
msgctxt "h761f89cdg9b9fg4c41gb151gb79d423655e2"
msgid ""
"*Your mind spins, your heart races. There is only endless void, an ocean of "
"grey and violet.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = 1dbf2542-e13a-4b95-3846-9ca518aa9fa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:1dbf2542-e13a-4b95-3846-9ca518aa9fa7
msgctxt "h4cbc5b91ge34dg4901g9a67ge4b12163ae69"
msgid ""
"I don't want your pity. I don't want your mercy. I want you gone from this "
"place."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 206021e7-2042-3909-61a4-f323c38217b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:206021e7-2042-3909-61a4-f323c38217b9
msgctxt "h61eda649gc802g430bg903fg512b1bcfc835"
msgid ""
"Insolent. Ignorant. But I know a flicker of faith still burns inside you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = 231f7801-e169-656a-da0b-3d222286618b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:231f7801-e169-656a-da0b-3d222286618b
msgctxt "h84dd7624g8b0eg4ae8ga4f3g53732779974b"
msgid "Get to the point. Why are you here?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 23da51c0-237a-7afd-197b-311576423a0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:23da51c0-237a-7afd-197b-311576423a0f
msgctxt "h8e0f03d0gc99dg49efg919dg6b605aa42835"
msgid "I have only a moment. And you, <i>Hshar'lak</i>, will listen."
msgstr "시간이 얼마 없다. 그리고 너, <i>흐샬락</i>, 들을지어다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 2cf0f49f-0bb8-2b62-d921-59140052d8e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:2cf0f49f-0bb8-2b62-d921-59140052d8e6
msgctxt "h9c9cb227g5650g453bg934fgf19d15e2746f"
msgid "<b>I will consume you. I will unmake you!</b>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 31150c93-e3d3-2edc-0be3-a5eee4990ddd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:31150c93-e3d3-2edc-0be3-a5eee4990ddd
msgctxt "h68056bb5g6e5dg46f1gb220g64dc2f7039cd"
msgid ""
"*In this endless sea of understanding, you find truth. There is no "
"cleansing, no ascension, no Chosen. You are Vlaakith's pawn, and nothing "
"more.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = 31553d8f-d567-6aeb-6195-ca1ee4190740
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVlaakithsFinalMission = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:31553d8f-d567-6aeb-6195-ca1ee4190740
msgctxt "h4104ccdeg6e71g493fg9b92gba008074f6a9"
msgid "No. I will not kill Orpheus for you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 42052e0c-3431-d2d9-eb1f-e3cabb419eaa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_MetVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:42052e0c-3431-d2d9-eb1f-e3cabb419eaa
msgctxt "h9b906605gd404g48a8g9571g90eea3e7d230"
msgid "Raise your eyes. Look upon She Who Conquers."
msgstr "눈을 들거라. 눈을 들어 정복자를 보아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 45d28b02-65dd-b180-ce90-f4594dc9aa5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:45d28b02-65dd-b180-ce90-f4594dc9aa5e
msgctxt "hf3105866gb06ag422agb14dg02b5ff9c61eb"
msgid ""
"Mother Gith made us a city. I made us an <i>empire</i>. We move mountains, "
"we snuff out stars, <i>we shake the planes</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 49f6cd1e-5c1a-2078-10be-f0b35f8ea608
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:49f6cd1e-5c1a-2078-10be-f0b35f8ea608
msgctxt "hc013a2a0g7682g4217g86c9gf8d58c010d0c"
msgid ""
"*Can this be true? Is Prince Orpheus really such a threat to your people or "
"simply a challenge to Vlaakith's rule?*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 5143b780-5a6c-393a-7c8d-31a2f97b3652
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:5143b780-5a6c-393a-7c8d-31a2f97b3652
msgctxt "h115f9f48g80c3g43b0ga17bg977e474e2615"
msgid "Commander of Dragons. <i>My only. My Chosen.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 55f4a89d-e34a-2930-d365-778b94a0b001
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:55f4a89d-e34a-2930-d365-778b94a0b001
msgctxt "h8f33aec6g862bg45d9g8b73gad39cafa6e4e"
msgid ""
"The traitor Voss has lied to you. The Heretic Prince would shatter us in an "
"instant. The Great Dominion, shrunk to the head of a pin."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 574bcced-41e5-5c2b-546e-381ea6e3a589
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:574bcced-41e5-5c2b-546e-381ea6e3a589
msgctxt "hd56de866g5008g4264g9ea6gc08f07926eeb"
msgid ""
"Five thousand <i>senja'si</i>, five thousand <i>gish</i> - gathered in "
"Tu'narath. They convey my essence through a single psionic thread."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 57b4de6b-75c3-1392-7bef-efc6424f9243
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:57b4de6b-75c3-1392-7bef-efc6424f9243
msgctxt "h7c865b92g85edg45ffg8a92ge14dce3f3198"
msgid ""
"And you - you are an abomination twice over. You carry a <i>ghaik</i> "
"parasite. And you harbour the Heretic Prince Orpheus."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Lae'zel
#. NodeID = 583eca03-a937-18c7-285c-9dcf7effdaa2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:583eca03-a937-18c7-285c-9dcf7effdaa2
msgctxt "h3727eadbgfa85g4fe9gbf8eg1e2c6e5f30f5"
msgid ""
"<i>Use the tadpole. Seek Vlaakith's mind through her psionic conveyance.</i>"
msgstr "<i>올챙이를 사용한다. 블라키스의 사이오닉 전달을 통해 그녀의 정신을 찾는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 5850ae0e-9f33-d85f-65d0-b691644df5d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:5850ae0e-9f33-d85f-65d0-b691644df5d3
msgctxt "h87e90df9gca0dg4be0gb2cdg5c562c6f563b"
msgid "One promise. One drop in the Astral Sea."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 61332e39-8e3f-5e1d-3f9b-f00195a45149
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:61332e39-8e3f-5e1d-3f9b-f00195a45149
msgctxt "hbf3c12b2g5e17g4f44g9948gc94eb593859f"
msgid ""
"You yearn for purity and mercy. You yearn for a place in Tu'narath still."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = 64b7f4a8-d222-c19a-cf87-7b4c7974d8b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:64b7f4a8-d222-c19a-cf87-7b4c7974d8b9
msgctxt "h60bb91f4g7317g496cg856dg92c58a47e49f"
msgid "Tell me. What must I do to regain your trust?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 655d4bb0-ccda-05b9-0a8c-ad93c18e95dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:655d4bb0-ccda-05b9-0a8c-ad93c18e95dc
msgctxt "h83abe9bfg666eg4152g88fcg17ac1791d9d1"
msgid "I named you <i>Hshar'lak</i>. Yet you still call me Queen."
msgstr "내가 널 <i>흐샬락</i>으로 지정했건만. 날 아직 여왕이라 부르는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = 6d8eb0e9-fb10-eea1-67e7-4c0fea6634fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:6d8eb0e9-fb10-eea1-67e7-4c0fea6634fe
msgctxt "hd11cba21g4b4cg4fe5g9e4dg1e18d915bc91"
msgid "<i>Say nothing. Avert your eyes.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 7b6701d6-3be0-c888-09d2-14dfa88c07a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:7b6701d6-3be0-c888-09d2-14dfa88c07a0
msgctxt "h632ce92eg4bd1g4934gab49g688101b8c43b"
msgid ""
"*Can the Heretic Prince really be such a threat to your queen's rule? He is "
"a prisoner, shackled, impotent.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 7c1fcd71-cb43-9014-87bd-2eca3c9a595a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:7c1fcd71-cb43-9014-87bd-2eca3c9a595a
msgctxt "h3fd25400g7f07g4029gb90dg72614d786f67"
msgid ""
"*Vlaakith does not welcome her finest young warriors into her royal city to "
"reward them, but to consume their essence in her quest for godhood.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 7feb4498-0764-b751-b674-6cca96f44298
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_MetVossInAct2 = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:7feb4498-0764-b751-b674-6cca96f44298
msgctxt "h4952e1efgb813g467egb456g8dd5abf8aa2c"
msgid "*In this endless sea of understanding, you find truth.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = 81381bc2-411b-6627-a3ba-04b94a90fce6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:81381bc2-411b-6627-a3ba-04b94a90fce6
msgctxt "h3ee1def0ga51ag43c9g9fa4g492a60fb0d23"
msgid "Vlaakith? Get out of my camp. You're not welcome here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 84e332c0-abe6-34d6-e7e6-9fe2929885f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:84e332c0-abe6-34d6-e7e6-9fe2929885f3
msgctxt "hf4c1f52fg3ac2g4b25g92b0g2ed922c78b81"
msgid ""
"I am Vlaakith. Undying Queen of the noble githyanki. <i>God Regent of the "
"Six Arms of Tu'narath.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 8a3ab8e5-d83d-973f-af40-eb7012efd97c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:8a3ab8e5-d83d-973f-af40-eb7012efd97c
msgctxt "h4cf22063g9464g4dc3ga9ddg8c37733d3fdc"
msgid "Kneel before me. Make your promise."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 8dd65b87-f8d1-de34-d2f2-ae6e70e0f8c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:8dd65b87-f8d1-de34-d2f2-ae6e70e0f8c9
msgctxt "h1122a6e7gd8f0g4799g85d2g34c3eba724f6"
msgid "Your word. Your faith. Your eternal promise in exchange for mine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 8f4ed010-964f-2549-262e-b174ea031176
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:8f4ed010-964f-2549-262e-b174ea031176
msgctxt "h4dc79053g5405g426dga37fg10a8bf2a6c4f"
msgid ""
"Yes, I see it. A flicker of faith. You yearn for purity and mercy. You yearn "
"for a place in Tu'narath still."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 8f6aa2eb-35b9-a252-e48e-b10026020682
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:8f6aa2eb-35b9-a252-e48e-b10026020682
msgctxt "h0087ef8ag9340g4d51ga210g15631ed9c5d8"
msgid "A final chance. Kneel before me. Make your promise."
msgstr "마지막 기회를 주노라. 내 앞에 무릎꿇고. 맹세하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 90bb482b-db6e-939b-2bda-a20b75d8c594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:90bb482b-db6e-939b-2bda-a20b75d8c594
msgctxt "h37b91f01ga374g4764ga644g1766b3d12e79"
msgid ""
"*The projection exudes immense psionic energy. Only five thousand "
"<i>senja'si</i> and five thousand <i>gish</i>, gathered in Tu'narath, could "
"convey such an image.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = 9e480ecb-8201-292f-94d6-27686f06bd59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:9e480ecb-8201-292f-94d6-27686f06bd59
msgctxt "h5cb3916fgad19g4901g9d71g45f18acce9dc"
msgid ""
"*The lich queen doesn't intend to reward you, but to devour you. She speaks "
"only in lies.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = 9eb85f1a-4e87-0afc-ba2e-ff283b08c974
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:9eb85f1a-4e87-0afc-ba2e-ff283b08c974
msgctxt "h8cd6c857g8cfcg45c3g8fb8g92fc8d7f9401"
msgid ""
"I am sovereign of the Astral Plane, Queen Regent of the City of Death. You "
"could ask any question, yet you choose only the obvious."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = a172b7a3-2525-0ada-3f4d-003f2992e5d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:a172b7a3-2525-0ada-3f4d-003f2992e5d0
msgctxt "h83d50150g2d66g4167g8e87gf3c47809948a"
msgid "The Undying Queen. Honour be!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = aa1ff25d-da1f-d693-2de3-136203cc81d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:aa1ff25d-da1f-d693-2de3-136203cc81d2
msgctxt "h7bc5b472g3882g444ag8fdeg4ccc50570a4d"
msgid "Find a way into the Prism. Slay Orpheus. All will be made right."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = b0cb4529-c427-0297-f6a5-2d0a9a5aff7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:b0cb4529-c427-0297-f6a5-2d0a9a5aff7a
msgctxt "h03d13bd3g067fg48b9g81e8g3765074ae87e"
msgid ""
"*The <i>zaith'isk</i> device doesn't cleanse the parasite - it's used for "
"extracting memories and killing the infected.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = b8326eb3-2374-1753-1f75-7c682bd95391
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ceae7f6e-305a-5716-69f4-8b96999b8fa3_VlaakithTruth = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:b8326eb3-2374-1753-1f75-7c682bd95391
msgctxt "hc4469388g29f2g4189gab6bga8a539a8dff3"
msgid ""
"*Water and blood. They envelop you, they drag you downward. You are "
"submerged in past, present, and future.*"
msgstr "*물과 피가 당신을 감싸고, 아래로 끌어내립니다. 당신은 과거, 현재, 미래에 잠기게 됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = b91fc5b1-0608-b57d-515d-9eb98a6d3b9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:b91fc5b1-0608-b57d-515d-9eb98a6d3b9b
msgctxt "he926c051g7c76g4617g906cgec64bf1128bd"
msgid "<b>I WILL NOT BE REJECTED.</b>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = bf37eb29-a9f6-a2eb-30fe-4ce627204a9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:bf37eb29-a9f6-a2eb-30fe-4ce627204a9a
msgctxt "h7ff80247g8391g4720g97a6gb53f52cd9105"
msgid ""
"*Your queen has bridged the planes to meet with you. An act of great power, "
"but what drives it - authority or fear?* "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = c28405c6-14af-52c9-fcb3-ee21270ee8df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:c28405c6-14af-52c9-fcb3-ee21270ee8df
msgctxt "hde2dbf1cg5e4fg44b8g8b5cg24aefff94072"
msgid "Vlaakith. The enslaver."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = cc940b39-d551-4979-c20e-be333dfc72fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:cc940b39-d551-4979-c20e-be333dfc72fc
msgctxt "h0a6972d2g2bf7g416ega89ag508990e4f874"
msgid ""
"I am the Eternal Empress, she who presides over the One in the Void. I do "
"not require an invitation."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = dd7e8a36-fde3-d1e6-7a37-7fdd1f583a94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:dd7e8a36-fde3-d1e6-7a37-7fdd1f583a94
msgctxt "hc0462c2cgbc0cg4d81gbe15ga4047be9bd38"
msgid "Do not fail me. For you would not survive the flood to follow."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = df760bc8-2279-1179-e6e0-fc28669653a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ceae7f6e-305a-5716-69f4-8b96999b8fa3_VlaakithTruth = True
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVlaakithsFinalMission = True
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:df760bc8-2279-1179-e6e0-fc28669653a0
msgctxt "h2451b5bagf56bg47fdgacb6gd18af7801e08"
msgid ""
"I have seen the truth. I reject you, Queen of Lies - I will not be your "
"puppet."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = e226fdb2-0d65-638f-bc88-a7fd79bfbf8b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_AcceptedVlaakithsFinalMission = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:e226fdb2-0d65-638f-bc88-a7fd79bfbf8b
msgctxt "hf670e02fg492eg4ae6ga135g7eb33043bbae"
msgid "<i>Kneel before Vlaakith. Promise to slay Orpheus.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = e47a16c7-b050-30e4-b293-643b79e2535a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:e47a16c7-b050-30e4-b293-643b79e2535a
msgctxt "h48f95d95g3f76g444dg9c93ge6e5f3c88bd9"
msgid ""
"The Heretic Prince would shatter us in an instant. The Great Dominion, "
"shrunk to the head of a pin."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = e52cab9f-a108-aa6d-3d3f-391e994b91fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:e52cab9f-a108-aa6d-3d3f-391e994b91fb
msgctxt "hf1e3ee35g3a48g46bdg9ca2gfa8b585b36df"
msgid ""
"The <i>kith'raki</i> will bring you. I will tear your flesh from your bones "
"and devour your skull's marrow while you beg for death."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = e53dccad-97f3-5327-334e-b60a52b61eb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:e53dccad-97f3-5327-334e-b60a52b61eb9
msgctxt "h18ec4928g3183g42cbg87f5g493b0db34d14"
msgid "<i>Tsk'va.</i> I should have expected no better from <i>Hshar'lak</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = ef47a908-009c-082f-7acb-2223e580d142
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:ef47a908-009c-082f-7acb-2223e580d142
msgctxt "h45f41752g5e75g42dcg844dgc3cc0daa15d6"
msgid ""
"I will cleanse your infection. I will ascend you. You will be no mere "
"warrior, nor <i>kith'rak</i>. You will be <i>Baht t'Vlaakith</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Narrator
#. NodeID = f30acd62-1c12-9755-09a5-6645ac482bca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:f30acd62-1c12-9755-09a5-6645ac482bca
msgctxt "h628dd66eg7e26g4e6fg8307g229bb5511dc6"
msgid ""
"*Your queen is terrible and mighty as you ever dreamed. It seems "
"unfathomable that she could be afraid of an imprisoned, impotent prince.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = f3e3e49e-7147-ce37-50ed-c85496a70efc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:f3e3e49e-7147-ce37-50ed-c85496a70efc
msgctxt "h6ab1adf4gd155g45b3g8e8agaa23742b571d"
msgid "You may yet have it. For I am not wholly without pity."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Player
#. NodeID = f43e8d0d-afbd-9b86-417a-663478188ec0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:f43e8d0d-afbd-9b86-417a-663478188ec0
msgctxt "hbda23fbdg2664g4906g9417g1773d02f6213"
msgid "Vlaakith. My queen be honoured."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar
#. Speaker = Vlaakith
#. NodeID = fde63d38-d18d-3540-7a14-dc5aecb750a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelAvatar:fde63d38-d18d-3540-7a14-dc5aecb750a6
msgctxt "h03db1e4fgc19ag48dag986agb190c7e14090"
msgid "I have only a moment. And you, <i>vin'iisk</i>, will listen."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 03d36cb1-6ad0-f954-d2a4-cbd70ff1edd6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Local:
#.      - 9ea5df93-0177-8e74-7fcd-06e57a542fbf_ReadVlaakithsMind = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:03d36cb1-6ad0-f954-d2a4-cbd70ff1edd6
msgctxt "h3250bb53ge097g44cbg9c16g8469f5588848"
msgid "<i>Link to Lae'zel's parasite, show her Vlaakith's mind.</i>"
msgstr "<i>레이젤의 기생충에 연결합니다, 블라키스의 정신을 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 04302d26-96f5-1fa3-8f9b-338f88b58673
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:04302d26-96f5-1fa3-8f9b-338f88b58673
msgctxt "hcc738d55ge914g47efgb29fg931d75417871"
msgid "Poisoned by a life of propaganda. I pity you, Lae'zel."
msgstr "과도한 선동에 찌들어 버렸구나. 딱하다, 레이젤."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 07afdef9-9f45-b5a0-5aaa-9bb2d29fa019
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:07afdef9-9f45-b5a0-5aaa-9bb2d29fa019
msgctxt "h81565799g2af5g4557ga003g1960a38c865a"
msgid "And I pity your faithless mind."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 08b82736-f300-46f0-e092-75adaf309c5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:08b82736-f300-46f0-e092-75adaf309c5f
msgctxt "hb6a430fdg40a0g47f6g8ba6g95000fad5106"
msgid "Who in the Hells are you?"
msgstr "넌 도대체 누구냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 0c76b257-7990-d6e3-d3c2-c18281aeaade
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:0c76b257-7990-d6e3-d3c2-c18281aeaade
msgctxt "h666d8189gbb86g4a45gad62g4f960aa75699"
msgid "Glorious Vlaakith. I am unclean. I exhort you, grant me guidance."
msgstr "영광스러운 블라키스시여. 저는 부정한 자입니다. 저를 인도해 주시길 간곡히 바라옵니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = 12bf94ec-21a5-6ed9-91e9-bea018ecdbc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:12bf94ec-21a5-6ed9-91e9-bea018ecdbc5
msgctxt "h1e7f92a5g6fdbg44d5g856bg424554063158"
msgid ""
"*Lae'zel believes a <i>zaith'isk</i> device cleanses the parasite - but it's "
"used for extracting memories and killing the infected.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 141abc9e-6c04-f926-c2d6-a8fe004f06b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:141abc9e-6c04-f926-c2d6-a8fe004f06b1
msgctxt "h15267ad1g2a4dg437bgab71g4beb569da43d"
msgid "One promise. One drop in the Astral Sea."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 15d7d4e5-866c-583d-94a9-9be63db9770f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:15d7d4e5-866c-583d-94a9-9be63db9770f
msgctxt "ha76dc59cge17eg4f3dg8ff1g6bd2864a5dce"
msgid ""
"Mother Gith's son lives, caged by a prison of your design. Our people "
"deserve the truth - but you have denied it to us."
msgstr ""
"어머니 기스의 아들은 당신의 설계한 감옥에 갇혀 살고 있다. 우리 동족은 진실을 알 자격이 있다, 하지만 당신은 인정하지 않았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 1700883f-bc3a-bc8b-17f6-78049191cbcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:1700883f-bc3a-bc8b-17f6-78049191cbcf
msgctxt "h37d11dcbg2550g4115gb861ge04dd01e2084"
msgid "Go on, then. Kneel before Vlaakith."
msgstr "그래라, 그럼. 블라키스 앞에 무릎꿇어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 1a25b673-bf37-92c7-e7ab-42c14699c04f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:1a25b673-bf37-92c7-e7ab-42c14699c04f
msgctxt "h64a357a1g5f10g47cdg93ecg0d2a0aa4fe3f"
msgid "<b>The betrayer Voss LIES!</b>"
msgstr "<b>반역자 보스가 거짓말 한 것이다!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 1cc55d8e-ae01-adcc-39d6-4afd3a425bdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:1cc55d8e-ae01-adcc-39d6-4afd3a425bdf
msgctxt "h184f2900g8061g4d23gbecfg3dcdaf02518c"
msgid "Who... am... <i>I?</i>"
msgstr "<i>내가</i>... 누구... 냐고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 25845154-bf18-18ba-701d-c9fb80dc891e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:25845154-bf18-18ba-701d-c9fb80dc891e
msgctxt "hd818458bga408g4c4dg85d8gc490c2fff4d7"
msgid "Get out of my camp. You're not welcome here."
msgstr "내 야영지에서 나가. 초대받지도 않았으면서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 2f15cfda-79c4-7675-f3d7-a3ccd1d11b49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:2f15cfda-79c4-7675-f3d7-a3ccd1d11b49
msgctxt "hd1b92660g7416g45dbga8e0g3b14690e5afc"
msgid "Do not fail me. For you would not survive the flood to follow."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 3ac3ec3b-1758-083b-f16e-07f9861092e1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 18
#. SetFlags:
#.   Local:
#.     - 9ea5df93-0177-8e74-7fcd-06e57a542fbf_ReadVlaakithsMind = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:3ac3ec3b-1758-083b-f16e-07f9861092e1
msgctxt "h24ea9f22g4fe3g4fe1gab5dg5035645bc830"
msgid ""
"<i>Use the tadpole. Seek Vlaakith's mind through her psionic conveyance.</i>"
msgstr "<i>올챙이를 사용한다. 블라키스의 사이오닉 전달을 통해 그녀의 정신을 찾는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 3d5a6b34-82b9-a092-f10c-b281dba5ba84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_MetVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:3d5a6b34-82b9-a092-f10c-b281dba5ba84
msgctxt "h21b700e2g019eg4befgb337gb0bfaa619a3a"
msgid "Queen Vlaakith - <i>tsk'va!</i>"
msgstr "여왕 블라키스, <i>츠크바!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = 41fd296b-bb85-1e1c-cca9-0332e0183130
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:41fd296b-bb85-1e1c-cca9-0332e0183130
msgctxt "h2307fd6fgdb21g4432gb51ag0923d16fd1b4"
msgid ""
"*The lich queen doesn't intend to reward Lae'zel, but to devour her. "
"Vlaakith speaks only in lies.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 44ab3134-a004-a0f6-71fa-b30658af772d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_RefusedVlaakithsFinalMission = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:44ab3134-a004-a0f6-71fa-b30658af772d
msgctxt "h2eaa1fa4g4303g41bcg8501g92d5704cf3ec"
msgid ""
"I have witnessed too much, and you have given me too little. Finally, I can "
"<i>see</i>."
msgstr "너무 많은 증거를 보았다, 그리고 당신은 내게 너무 조금만 주었지. 드디어, <i>볼 수 있게</i> 되었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 4505ed67-5572-ce28-5cbe-6fb79f961505
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:4505ed67-5572-ce28-5cbe-6fb79f961505
msgctxt "h223f3f07gb3d6g41feg98e7gd16b2e8383ce"
msgid ""
"Vlaakith hid Mother Gith's son from us. Reject her - we've found a new path "
"to follow."
msgstr "블라키스는 어머니 기스의 아들을 숨겨두었다. 거부해, 우린 새로운 길을 찾을 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 4505ed67-5572-ce28-5cbe-6fb79f961505
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:4505ed67-5572-ce28-5cbe-6fb79f961505
msgctxt "h03642f5bg918eg462eg9c35g037f6c750a4e"
msgid ""
"Face the facts, Lae'zel. Vlaakith lied to your people. It's time you reject "
"your queen."
msgstr "사실을 직시해, 레이젤. 블라키스는 네 동족들을 속였다. 여왕을 거부할 시간이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 454f7bf1-53e0-5e2f-4bce-6f4dc5915501
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:454f7bf1-53e0-5e2f-4bce-6f4dc5915501
msgctxt "h4e13c5acg178eg41d8g87afg6b864115c602"
msgid ""
"Voss was right, Vlaakith is our slaver. Denounce her - we must walk free."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 454f7bf1-53e0-5e2f-4bce-6f4dc5915501
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:454f7bf1-53e0-5e2f-4bce-6f4dc5915501
msgctxt "h3c28786fg7ee9g421fg8514gd9281d9feeda"
msgid ""
"Voss was right, Vlaakith is your slaver. Denounce her - you must walk free."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 49bca7e3-9646-3c8e-e8ce-a8895567b557
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:49bca7e3-9646-3c8e-e8ce-a8895567b557
#, fuzzy
msgctxt "h2e152d58g561bg47b2g85abg9d63b8397667"
msgid ""
"The traitor Voss has lied to you. The Heretic Prince would shatter us in an "
"instant. The Great Dominion, shrunk to the head of a pin."
msgstr "반역자 보스가 널 속였다. 반역자들의 왕자가 당장이라도 우릴 산산조각 낼테지. 위대한 제국이, 바늘 머리 크기로 줄어버렸다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 4d907cab-dcec-6d9d-55ca-91f141624eed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:4d907cab-dcec-6d9d-55ca-91f141624eed
msgctxt "hcf18e99eg2f3fg4efdg9632ga9ed6406179e"
msgid "<b>OUT.</b>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 50f1a108-6877-c8cb-308f-cb5832ef366b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:50f1a108-6877-c8cb-308f-cb5832ef366b
msgctxt "hf0e11316g8f86g49a8g83aagc0edbe48435e"
msgid ""
"Kneel, Lae'zel. To be the god-queen's Chosen is an extraordinary honour."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 513bc7cc-abe8-a378-97eb-653c29fa598d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:513bc7cc-abe8-a378-97eb-653c29fa598d
msgctxt "h1d56a2fcg58e6g47bdgb19ag5e283d869d3a"
msgid "<b>I will consume you. I will unmake you!</b>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 529e7c73-25d1-8282-a0f5-0bb24eaff58f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = False
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_MetVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:529e7c73-25d1-8282-a0f5-0bb24eaff58f
msgctxt "hb5bf2c94gf059g4772ga3eag1a70108b91e9"
msgid "Vlaakith. <i>My Queen.</i>"
msgstr "블라키스. <i>나의 여왕이시여.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = 5415b334-2d0c-c363-4ec8-f32f82773654
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Event_OrpheusToVlaakithSwitch = True
#.     - ORI_Laezel_State_IsOnOrpheusPath = False
#.   Tag:
#.     - LAEZEL_ORPHEUSPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:5415b334-2d0c-c363-4ec8-f32f82773654
msgctxt "h84fd9ba7g1b4fg4693ga12bg99b70dccf117"
msgid ""
"*Lae'zel's doubts turn to rapture as she considers an eternity as Vlaakith's "
"Chosen.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 5627b6e3-5615-70c5-18a0-8be2c247b07c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:5627b6e3-5615-70c5-18a0-8be2c247b07c
msgctxt "hb0c0498dg058bg467fg859fgb1a7813cffc3"
msgid "Out of my head - the Queen has spoken!"
msgstr "내 머리에서 나가, 여왕님께서 말씀하고 계신다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = 56a739e9-155f-1262-d365-95e7526c6f7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:56a739e9-155f-1262-d365-95e7526c6f7b
msgctxt "hfcc0e89bge91eg4080gb346g8f49a825876f"
msgid ""
"*Vlaakith does not welcome her finest young warriors into her royal city to "
"reward them, but to consume their essence in her quest for godhood.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 571aa505-36ce-fe32-b033-2d52cf9228f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_MetVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:571aa505-36ce-fe32-b033-2d52cf9228f1
msgctxt "h42e78668gd7b0g4f74ga657gba99b1273f97"
msgid "Raise your eyes. Look upon She Who Conquers."
msgstr "눈을 들거라. 눈을 들어 정복자를 보아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 65f992eb-b0f0-e0df-fd53-c9e373810040
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:65f992eb-b0f0-e0df-fd53-c9e373810040
msgctxt "hb360cd7agd5b8g47aaga258g6a737570a215"
msgid "Venerable Vlaakith. Please, I beg you to listen. I seek -"
msgstr "존경해 마지 않는 블라키스시여. 간청드립니다, 들어주시옵소서. 전..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 682fd3de-9864-a1df-ae9d-9a1e1b12634b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:682fd3de-9864-a1df-ae9d-9a1e1b12634b
msgctxt "hacada3e6gea42g40c6ga592g4d21d638eb44"
msgid ""
"I am Vlaakith. Undying Queen of the noble githyanki. God Regent of the Six "
"Arms of Tu'narath."
msgstr "나는 블라키스. 고귀한 기스양키 불멸의 여왕. 튜나라쓰 여섯 팔의 섭정 신이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Lae'zel
#. NodeID = 6a2b1755-7cb5-e588-b4f7-5fb019ea9b69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:6a2b1755-7cb5-e588-b4f7-5fb019ea9b69
msgctxt "h1e237ff1g54aag4790gb36agc646ea0d9382"
msgid "Orpheus will live, and I will hear his creed. <i>This</i> is my word."
msgstr "오르페우스는 살 것이다, 그리고 난 그의 교리를 듣겠다. <i>이것</i>이 내 대답이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 6ed1bf3f-19c1-6e74-43ee-d1ef54c25851
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:6ed1bf3f-19c1-6e74-43ee-d1ef54c25851
msgctxt "hb5e89b4fg5bfbg438fgbfebgda560121290c"
msgid "<i>Vlaakith tavki na'zin. <b>I am truth.</b></i>"
msgstr "<i>블라키스 타브키 나진. <b>나는 진리이니라.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Vlaakith
#. NodeID = 6f5091b6-f6fd-41cf-2a62-f7ebe6702c07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:6f5091b6-f6fd-41cf-2a62-f7ebe6702c07
msgctxt "h07affa9cgbcacg4fc5gaea9g6e490a8c42a0"
msgid "<i>Shka'keth!</i> You speak against the Eternal Queen?"
msgstr "<i>쉬카케쓰!</i> 영원한 너의 여왕을 부정하는 것이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Narrator
#. NodeID = 71301971-13c9-f4f7-b0c2-e92d65aad006
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_MetVossInAct2 = False
#: Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom:71301971-13c9-f4f7-b0c2-e92d65aad006
msgctxt "h8d3a9c3bg3a97g4bffg9868g7173d41a29bc"
msgid "*In this endless sea of understanding, you find truth.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_VlaakithVisit_CFM_LaezelCom
#. Speaker = Player
#. NodeID = 740641d5-d39f-78d0-86f8-50cdaab3d8f8
#. HandlePath = TaggedText[0].TagText[0]
