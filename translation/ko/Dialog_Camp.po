msgctxt "hb9c29e3eg3e35g497bg9312g2ffb24e83ecb"
msgid "<i>Pet him.</i>"
msgstr "<i>쓰다듬어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Player
#. NodeID = a12c7b10-91a2-c22a-5906-469b6029020d
#. HandlePath = TaggedText[0].TagText[0]
