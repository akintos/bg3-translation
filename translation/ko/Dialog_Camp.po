msgctxt "h1a4b4a69gfb08g4db4g8dbdg98ab1429ad4f"
msgid "Do you ever get tired, Zae?\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02
#. Speaker = Alfira
#. NodeID = e4141585-1ce3-7271-f1ee-b9530ee75a63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Backup02:e4141585-1ce3-7271-f1ee-b9530ee75a63
msgctxt "h194fbaecg21eeg4a9aga9c9gdb30d713a6e6"
msgid "I'll need more wine for that. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 0773ba23-df67-4d94-9dda-6fbadea3f397
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:0773ba23-df67-4d94-9dda-6fbadea3f397
msgctxt "h5147a79ag4dd7g4627g86f6g64ab57eb892a"
msgid "I can introduce you all, if you want?"
msgstr "괜찮으면 너도 한 번 같이 갈까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 0dab2e78-fecc-0ce1-369f-cd9cfff867fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = False
#.   Local:
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_C = False
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_A = True
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_B = False
#. SetFlags:
#.   Local:
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:0dab2e78-fecc-0ce1-369f-cd9cfff867fb
msgctxt "h8f83a60dg7f8bg4082ga930gaa1dc2c5d9b3"
msgid "How about... 'two tiefling queens, frightful and fierce.'"
msgstr "이건 어때요... '무시무시하고 맹렬한 티플링 여왕 두 명이 있었네.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 1b7c86b3-8e0d-c063-2572-da5b419c98e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:1b7c86b3-8e0d-c063-2572-da5b419c98e4
msgctxt "hede1d7begdef4g4ed4ga500g4f4ef30e0bb1"
msgid "Hey, don't talk like that. We'll work on it."
msgstr "야, 너무 그러지 마. 더 나아질 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 1be12dfc-f74a-e685-9a47-3f95e30a03ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:1be12dfc-f74a-e685-9a47-3f95e30a03ac
msgctxt "h362a04b1gbe59g40d7g93f9g1c223685a1b2"
msgid "This is a bad idea."
msgstr "나 너무 못한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 200467c5-efab-9260-d9ed-0b6a749561e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:200467c5-efab-9260-d9ed-0b6a749561e8
msgctxt "hf340d2f8g3839g4a96ga910g185e833709d6"
msgid "Live a little!"
msgstr "그게 뭐 어때서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 23dcf175-a634-29bc-00d2-72e555f83be5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:23dcf175-a634-29bc-00d2-72e555f83be5
msgctxt "hd3042803gd282g47b1g82dfgbac4474bef2f"
msgid "But that's not what happened..."
msgstr "하지만 그건 실제로 있었던 일이 아니잖아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 25dec1de-e9b7-d21f-260e-2fa74c03595e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_C = False
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_A = True
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_B = True
#. SetFlags:
#.   Local:
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_C = False
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_A = False
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_B = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:25dec1de-e9b7-d21f-260e-2fa74c03595e
msgctxt "h1ffee719g073fg48bbgbad1g581e8cbdee8a"
msgid "You got friends or family in the city?"
msgstr "도시에 가족이나 친구는 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 2c001b30-c9f7-b9cb-f831-ffffae1e7dd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:2c001b30-c9f7-b9cb-f831-ffffae1e7dd2
msgctxt "hef06b5e4gb460g4d6ag9bffg8d5b399a079d"
msgid "That's more like it! How many goblins did we kill? Ten?"
msgstr "바로 그거지! 우리가 얼마나 많은 고블린을 죽였지? 열 명?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 423fdee7-10fd-258b-90a2-5a976015b143
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:423fdee7-10fd-258b-90a2-5a976015b143
msgctxt "h722a0b08g9eccg4cf4gb250gb28fd10d69bb"
msgid "Aha! Only a child would find that intimidating."
msgstr "하하! 애들이나 겁먹을 만한 내용이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 45635e23-c471-dbba-3bf3-4b3f6cfa8797
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:45635e23-c471-dbba-3bf3-4b3f6cfa8797
msgctxt "h5c17bd1ag5d59g4652g8df8g54201fc90d3d"
msgid "If the owner has any sense, they'll hire you on the spot."
msgstr "여관 주인이 감이 없을 리가, 널 바로 뽑아주겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 4a7eb6d0-99e4-35bc-9996-74b024914187
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:4a7eb6d0-99e4-35bc-9996-74b024914187
msgctxt "h944651f0g89bcg4932ga9e9g7282e50432d2"
msgid "Pfft, none of that poetic stuff! Something like..."
msgstr "흥, 그런 시적인 것 말고! 이런 건 어때..."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 4aa06444-2d35-0422-6d1c-926ea3683d82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = False
#.   Local:
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_C = False
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_A = True
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_B = True
#. SetFlags:
#.   Local:
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_C = False
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_A = False
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_B = False
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:4aa06444-2d35-0422-6d1c-926ea3683d82
msgctxt "hff6cf3f8gf4e3g44e8g8b5bg47767acbbe49"
msgid "What are you going to do in the city?"
msgstr "도시에 가면 뭘 할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 512a815d-8a3d-41dd-7381-b7dda037e2ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:512a815d-8a3d-41dd-7381-b7dda037e2ac
msgctxt "h216a7bdfgf1eeg4600gb1e1g949d30a72641"
msgid "Let's make it twenty."
msgstr "스무 명으로 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 55f30e79-b687-864d-a251-f6f88719e569
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:55f30e79-b687-864d-a251-f6f88719e569
msgctxt "h79c3af92gb07bg444dg9b0agee9490376341"
msgid "Don't worry. I can get us both jobs as guards. If you practice."
msgstr "걱정 마. 너랑 같이 일할 경비 자리를 알아볼 테니까. 네가 수련만 좀 한다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 5a048e80-a94f-2f86-5bf7-0042219f3b1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:5a048e80-a94f-2f86-5bf7-0042219f3b1a
msgctxt "he0a86c25gc81ag4665g8217g5d8c6c6ce697"
msgid "Haha! That's my girl!"
msgstr "하하! 바로 그거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 848bb221-3b66-3ce3-a9df-0c57a4ee100b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:848bb221-3b66-3ce3-a9df-0c57a4ee100b
msgctxt "had48b82bgf48dg4f8bgaf1cg9dcd84f3bd8a"
msgid "All right, erm, 'hearts aquiver, we raised our bows...'"
msgstr "알았어, 음, '심장이 떨리고, 우린 활을 들었네...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 8ddc4333-3f49-1ef6-d981-d3db00363153
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:8ddc4333-3f49-1ef6-d981-d3db00363153
msgctxt "h952ffc38gc92dg4546g957bg2c2dca3321af"
msgid "All right. *ahem* What - what you looking at?"
msgstr "알았어. *에헴* 뭐, 뭘 쳐다보냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Alfira
#. NodeID = 946856ac-8069-2a5c-a5ce-7c960384a2cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:946856ac-8069-2a5c-a5ce-7c960384a2cd
msgctxt "h42cfb1beg5841g4747gafb2gd96041a51c1f"
msgid "I'd like that."
msgstr "그거 좋지."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
#. Speaker = Lakrissa
#. NodeID = 977965af-a125-dc77-b392-830623abb4bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = False
#.   Local:
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_C = False
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_A = False
#.      - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_B = False
#. SetFlags:
#.   Local:
#.     - 81e514bc-0212-ae5e-46b7-9ecce21dda4f_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty:977965af-a125-dc77-b392-830623abb4bd
msgctxt "hee3877f3g5f4cg461ag8d45gb01a4625eced"
msgid "C'mon Alfie, make it <i>spicy.</i>"
msgstr "좀, 알피, 더 <i>매콤한</i> 걸 들려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Bard_Flirty
