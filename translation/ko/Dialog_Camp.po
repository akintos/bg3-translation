msgctxt "h3e202afcg0261g4d48ga533g20b44b100d9d"
msgid "Here's to living every day like it's our last."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Karlach_CRD_ROM_Date
