msgctxt "h82e53836g4443g45adg8e4ag0d6f316c81a9"
msgid "Nothing to be done now. It's finished."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_HalsinsRevenge_PAD
#. Speaker = Player
#. NodeID = ad7db905-dcd1-47fa-5ed2-fc81bbace005
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_HalsinsRevenge_PAD:ad7db905-dcd1-47fa-5ed2-fc81bbace005
msgctxt "h5719c5ecg1347g40f6g9a73g65254cc4f913"
msgid "An unforgivable loss. He'd have made a fine ally."
msgstr "용서할 수 없는 손실이군. 훌륭한 아군이 될 수도 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_HalsinsRevenge_PAD
#. Speaker = Player
#. NodeID = ad7db905-dcd1-47fa-5ed2-fc81bbace005
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/Campfire_Moments/CAMP_HalsinsRevenge_PAD:ad7db905-dcd1-47fa-5ed2-fc81bbace005
msgctxt "h6367d178g1ef6g4a83ga073g71aa1acbe6ee"
msgid "We did what we did. Let's just see this through to the end."
msgstr "우리가 한 짓은 이미 벌어진 일이야. 끝장을 보자."

