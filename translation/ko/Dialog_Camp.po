msgctxt "hb639608dg097dg4355g9146ge1ce3625306f"
msgid "It seems I enjoyed it, I still don't know why."
msgstr "난 그걸 즐겼던 것 같아요. 아직도 이해가 안 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_DaisyCourseCorrection_AvD
#. Speaker = GROUP_Daisy
