#. Speaker = Player
#. NodeID = c31667b9-f832-dc2e-8dbd-48b11e66218a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog:c31667b9-f832-dc2e-8dbd-48b11e66218a
msgctxt "hb3e41a5dg9e09g4e38gbd7eg1af7e284b1d7"
msgid "<i>Let him keep it.</i>"
msgstr "<i>녀석이 가지게 해 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Courier_Dog
#. Speaker = Narrator
