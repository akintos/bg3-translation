msgctxt "h71cffa32g9908g4ddagb29egc5edd9f48088"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/CAMP_Jergal
#. Speaker = Player
#. NodeID = 14955796-a441-92bc-6052-cde94ef9da54
