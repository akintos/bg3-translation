msgctxt "h879989f7g823eg44aag825agc04ea7f668ad"
msgid "Shh. Let me speak."
msgstr "쉬잇. 내가 말하게 해다오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Campfire_Moments/CAMP_Laezel_ROM_SD_Romance2_WokenUpByLaezel
#. Speaker = Player
#. NodeID = 98ae8c84-1256-1105-e985-7ade70a6dce5
