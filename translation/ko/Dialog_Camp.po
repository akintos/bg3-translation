msgctxt "h987d374fge1eeg429dgb550g5fb7cb5dfee5"
msgid "I told ya to get up. You're disrespectin' the True Souls."
msgstr "일어나라고 했잖아. 너는 참된 영혼을 무시하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Tracker
#. NodeID = 6e7f8302-ae08-c079-77d5-014c7314a1f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:6e7f8302-ae08-c079-77d5-014c7314a1f4
msgctxt "hc7a0cd49g4089g468dgb10bgdc9d2f421dbe"
msgid "You're not."
msgstr "너는 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Tracker
#. NodeID = 75107ddc-3146-fb63-25ac-c8c723d35637
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:75107ddc-3146-fb63-25ac-c8c723d35637
msgctxt "hd0231360g6a72g4ed2ga622g2fb0231f70d8"
msgid "I am. Got nothin' to fear from you."
msgstr "나는 그래. 너는 무서울게 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Brawler
#. NodeID = b2f518d5-052c-b4f6-dac6-a724d736450f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:b2f518d5-052c-b4f6-dac6-a724d736450f
msgctxt "h741f5b8bgbe9ag48b2g8357gf53678c33724"
msgid "I'm just sayin', be careful who you go around annoyin'."
msgstr "그냥 말하는 건데, 네가 사람들 짜증나게 하는 거 조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Tracker
#. NodeID = bf57b6ac-199f-f122-d833-ae507e9587eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:bf57b6ac-199f-f122-d833-ae507e9587eb
msgctxt "he2554cdeg0aedg46bdgb66eg0d436f346c49"
msgid "Right. Fantasies."
msgstr "그래. 환상일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Brawler
#. NodeID = ce274016-07cc-27be-e499-5ec4af449ec8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:ce274016-07cc-27be-e499-5ec4af449ec8
msgctxt "h535f9de7gb3e1g4cdbgabddg85477b7a58b6"
msgid "Oh, you'll see."
msgstr "오, 알게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Tracker
#. NodeID = d618c8eb-8a70-5d5e-d0c5-9cb61ef2bcd4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c858ac88-af34-b678-e769-a791be9087fa_A = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:d618c8eb-8a70-5d5e-d0c5-9cb61ef2bcd4
msgctxt "h2d95ab31gfa2bg43d2ga2d7g2d1ec1226811"
msgid "Look who's here, sittin' all by himself."
msgstr "봐봐, 혼자 앉아있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Tracker
#. NodeID = d955080a-ea49-04b0-a90e-c34463bfda7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:d955080a-ea49-04b0-a90e-c34463bfda7b
msgctxt "h29dd68a9g74f5g4b13gb98bgada0851a7a53"
msgid "Heh. We'll see which one of us ends up on top."
msgstr "헤. 결국에 누가 꼭대기에 있는지 두고 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001
#. Speaker = Goblin Tracker
#. NodeID = fed69523-edd4-ddf2-18e6-03c35a52debf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c858ac88-af34-b678-e769-a791be9087fa_A = True
#. SetFlags:
#.   Local:
#.     - c858ac88-af34-b678-e769-a791be9087fa_B = True
#: Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_GuardAndGoblin001:fed69523-edd4-ddf2-18e6-03c35a52debf
msgctxt "hcb1d0ebegbd49g49bcga0c8g96ff8f3bdab6"
msgid "Get up. Make yourself useful."
msgstr "일어나. 쓸모있는 일을 해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Camp/NPCs/ADs/CAMP_GoblinHuntCelebration_AD_Irritated_Backup06
#. Speaker = Kivak
#. NodeID = 06ad88cb-a9f3-ecc0-812d-cfe0a92ba33d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_A = True
#.      - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_B = True
#. SetFlags:
#.   Local:
#.     - 9ceb5bcf-7870-84ea-9c46-e8ad6e851168_A = False
