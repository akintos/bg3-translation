msgctxt "haa1ada92gf7bbg4916gba60ga506de633efe"
msgid "So many honeyed words, as usual."
msgstr "언제나처럼 입에 발린 달콤한 말인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/Camp_Relationship_Dialogs/CAMP_Astarion_CRD_SecondNight
#. Speaker = Astarion
#. NodeID = 41bb5487-0a88-41bd-b331-2b46096bc51c
#. HandlePath = TaggedText[0].TagText[0]
