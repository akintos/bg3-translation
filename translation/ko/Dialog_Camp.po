msgctxt "h7f138eb2g03dbg4714ga77dga5bb09fc43da"
msgid "I do enjoy our little sits together."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Camp/CAMP_Shadowheart_PAD_Greeting
#. Speaker = Shadowheart
#. NodeID = f5ddc2fe-8b83-4b17-a540-c0e8c3e6c53b
