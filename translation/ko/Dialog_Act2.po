#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:5f87abc0-9db9-4f2b-a860-b43d6deebbd0
msgctxt "h837359f1g383cg42ebg9a1ag29f728b80e1a"
msgid "Do you have any valuables in this place?"
msgstr "이 주변에 혹시 네 귀중품이 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = 7bd4e490-ef6b-4692-952f-142fcc404ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:7bd4e490-ef6b-4692-952f-142fcc404ff4
msgctxt "h432bbab4g0780g4aa9g910eg76bc98847051"
msgid "*The corpse remains silent. It does not know.*"
msgstr "*시체가 침묵을 유지합니다. 알지 못합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 80424f82-dd5f-45e5-9bfb-6b6c7b0b28cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:80424f82-dd5f-45e5-9bfb-6b6c7b0b28cd
msgctxt "hda014152gc9f8g4d47gb532g38d52dfb72f7"
msgid "How did you come to follow the Absolute?"
msgstr "어쩌다 절대자를 따르게 된 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = cae1a293-e486-4121-9263-33b0cc5d64e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:cae1a293-e486-4121-9263-33b0cc5d64e8
msgctxt "he9442879gb593g4dadga1ebgf5ca8461266a"
msgid "What do you know of Ketheric Thorm?"
msgstr "케서릭 쏨에 대해 아는 게 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = d178a399-6fd9-4afb-a2b2-cac1626f1b66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:d178a399-6fd9-4afb-a2b2-cac1626f1b66
msgctxt "h119c51d2gdbbcg48eagbfc5g1619e0fa3898"
msgid "Enlightenment... love... power..."
msgstr "계몽... 사랑... 힘..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = da1cd35b-c532-4fd0-ac0b-843f05db54cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:da1cd35b-c532-4fd0-ac0b-843f05db54cf
msgctxt "h2c88de8dg7611g41b8gb924ge7b05a1a194e"
msgid "Marcus Falgor... raised in... Baldur's Gate..."
msgstr "마커스 팔고어...발더스 게이트... 출신..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = e401476f-d752-45c4-974f-f73a4f2cba3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:e401476f-d752-45c4-974f-f73a4f2cba3f
msgctxt "h94f675e7g902bg4ee2gb7e9g6b399bf1c069"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = f3ea6a4b-b7bf-4587-ad8f-09e643f8ac09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:f3ea6a4b-b7bf-4587-ad8f-09e643f8ac09
msgctxt "h7b32713cgacf0g420bgae48g7132a3950d84"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = f4f134a9-496b-4b00-a214-9777a35c1f2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:f4f134a9-496b-4b00-a214-9777a35c1f2a
msgctxt "h1459282fg0f81g4b4cgae4cg21d2077e7335"
msgid "Who were you before you became a True Soul?"
msgstr "참된 영혼이 되기 전에는 어떤 사람이었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = f874caf8-e2ad-426b-b045-641a2afd2836
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:f874caf8-e2ad-426b-b045-641a2afd2836
msgctxt "h8161432dgcc5dg409ag9b0cg5e3b0f073f64"
msgid "Chosen of... the Absolute. Wants... the cleric... more than anything."
msgstr "절대자님에게... 선택받은 자. 클레릭을... 원한다... 그 어떤 것 보다도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = fa412354-57e0-4f21-9005-dd737de9adb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:fa412354-57e0-4f21-9005-dd737de9adb8
msgctxt "he7827c2fg0245g447cg8c5eg516c0e1e7221"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = fb84a7e5-9e0f-4b75-ab1a-bbc5f0a8da72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:fb84a7e5-9e0f-4b75-ab1a-bbc5f0a8da72
msgctxt "he06ad9b5g7724g4c3fg83a1g1f7c8dbf85a1"
msgid "Squad... captured... enlightened..."
msgstr "부대가... 생포됨... 계몽되었음..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = fe18596b-b692-4eb4-b0c9-3941ee4fa8d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:fe18596b-b692-4eb4-b0c9-3941ee4fa8d1
msgctxt "h7b7905f0g8fd6g4582gbf19gf2e9a7a7aabe"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre
#. Speaker = Glourik
#. NodeID = 883314a0-fc9f-9c57-96b8-d88c6e83e35e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_ZrellBriefing_Ogre_HasMet_DoorBlocked(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre:883314a0-fc9f-9c57-96b8-d88c6e83e35e
msgctxt "hbb680a54gff3dg4091gb5d1gf5df55f48e46"
msgid "Nah-uh. Stay out."
msgstr "안돼. 여기서 나가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre
#. Speaker = Glourik
#. NodeID = 8f9abd57-4f94-5250-52ab-64b6b64d8ecf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_ZrellBriefing_Ogre_HasMet_DoorOpen(1) = True
#.   Object:
#.      - MOO_Executioner_Event_GiveBalthazarKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre:8f9abd57-4f94-5250-52ab-64b6b64d8ecf
msgctxt "h65b455d7g9efeg4bffg8608g40c3f9fa7c0e"
msgid "Our god is watching. Me too."
msgstr "그분께서 지켜보신다. 나도 마찬가지고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre
#. Speaker = Glourik
#. NodeID = a18a8a3b-958d-f281-be07-bae716a8a31c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_ZrellBriefing_Ogre_HasMet_DoorBlocked(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre:a18a8a3b-958d-f281-be07-bae716a8a31c
msgctxt "h82735e71gee0ag4706g8fc5ga545f013816c"
msgid "No business here 'less Disciple or General say you do."
msgstr "신봉자님이나 장군님 명을 받고 온 게 아니라면 여기서 볼 일은 없을거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre
#. Speaker = Glourik
#. NodeID = ab57e75c-c79f-86ce-0b03-6ea91edc5f1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Executioner_Event_GiveBalthazarKey(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_ZrellBriefing_Ogre_HasMet_DoorOpen(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_Ogre:ab57e75c-c79f-86ce-0b03-6ea91edc5f1d
msgctxt "h096fa0a9gd952g431egb1a3g4b3ac9093f4f"
msgid "You can pass. In the name of the 'solute."
msgstr "지나가도 좋다. 잘때자님의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/NGB_MOO_General_SpottedUnwelcomeVisitors
#. Speaker = Narrator
#. NodeID = 0d4e7638-fb1c-06bd-b2d0-8d839a2916fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Crimes_State_UnwelcomeVisitorAccompanied = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/NGB_MOO_General_SpottedUnwelcomeVisitors:0d4e7638-fb1c-06bd-b2d0-8d839a2916fb
msgctxt "h35632e39g8357g4716gb921g26e460382f7c"
msgid ""
"*You're not welcome in Moonrise, and your presence hasn't gone unnoticed. "
"Time to fight... or flee.*"
msgstr "*당신은 문라이즈에 초대받지 않았습니다, 그리고 당신의 존재가 발각되었습니다. 싸우든지... 도망가십시오.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/NGB_MOO_General_SpottedUnwelcomeVisitors
#. Speaker = Narrator
#. NodeID = 6691ba8f-0137-5a7f-c3cc-b5665c88c18f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Crimes_State_UnwelcomeVisitorAccompanied = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/NGB_MOO_General_SpottedUnwelcomeVisitors:6691ba8f-0137-5a7f-c3cc-b5665c88c18f
msgctxt "hd5d534dcgc2e3g41d7g9abega6e571d1bab0"
msgid ""
"*You'll need to avoid attention while exploring Moonrise - one among you "
"isn't permitted to be here.*"
msgstr "*문라이즈를 탐사하는 동안에는 주의를 끌지 않아야 합니다, 동료 중에는 여기 들어오는 걸 허가받지 않은 사람도 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution
#. Speaker = Ketheric Thorm
#. NodeID = 3e2d8c21-8446-450c-a988-b7ac3351e0a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution:3e2d8c21-8446-450c-a988-b7ac3351e0a3
msgctxt "h951e0af8gfa39g4b64ga6fbg4d3b47a60f33"
msgid "Considering all that is at stake..."
msgstr "모든 것의 성패가 달린 상황인데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution
#. Speaker = Ketheric Thorm
#. NodeID = 4d3df084-9fa6-4f79-93aa-519aee0bcec2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution:4d3df084-9fa6-4f79-93aa-519aee0bcec2
msgctxt "h99e1470fg07fag47e4g965fgbcd538cf86d5"
msgid "I ask you again: <i>why am I here?</i>"
msgstr "다시 묻겠다. <i>내가 왜 여기 있는 거지?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution
#. Speaker = Ketheric Thorm
#. NodeID = eedce3c4-2db7-4200-9b97-e921380ee049
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution:eedce3c4-2db7-4200-9b97-e921380ee049
msgctxt "h0637a077gcbbag412fg960eg1466bc4a6d8c"
msgid "Why am I here?"
msgstr "내가 왜 여기 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution
#. Speaker = Ketheric Thorm
#. NodeID = f28756d4-ee94-4fb4-980e-19a794a4ed20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/SCL_Ketheric_AD_Execution:f28756d4-ee94-4fb4-980e-19a794a4ed20
msgctxt "hc09b75b1g55e6g4018g8f51g6d6cb9909313"
msgid "Considering how close we are to the conclusion of our efforts..."
msgstr "우리가 여태 들인 노력의 결실이 눈앞으로 다가왔거늘..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "hd9114d75gaf6dg4b82gafe0g9eb03c058d94"
msgid ""
"A ritual circle. The kind of place Moonlanterns are crafted, most likely."
msgstr "의식 마법진이야. 아무래도 여기가 달등불이 만들어지는 곳 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "hfb1988e6gd7ebg4749gb79fg00ee269905e1"
msgid ""
"I feel darkness and light, woven together. This is where Moonlanterns are "
"crafted."
msgstr "어둠과 빛이 서로 엮인 것이 느껴진다. 이곳에서 달등불을 만들었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "hc40ab928gd379g4028g92b1g2d0a67149f6b"
msgid "A ritual circle? Looks like it's what empowers the Moonlanterns."
msgstr "의식 마법진? 달등불에 힘을 부여하는 게 바로 이건가 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "h4850747cg5d09g4e65g9a12gf35912c33a1a"
msgid "A ritual circle? I wonder - is this how Moonlanterns are made?"
msgstr "의식 마법진? 달등불은 다 이렇게 만들어지는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "h1b67d0a3g0aa6g41d9ga14eg695cca2c2049"
msgid "This must be how Moonlanterns were made."
msgstr "이게 달등불이 만들어진 방법임이 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "h90c8ea86g196fg4727gaf6cg2906abe00595"
msgid "A ritual circle. The Moonlanterns must receive their enchantments here."
msgstr "의식 마법진이네. 달등불에 마법을 부여하는 곳이 바로 여긴 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "h16079bd7g8c52g4b00g94bag0ca786f9a83d"
msgid ""
"This circle - where the cult enchant their Moonlanterns, no doubt. Take "
"note, Isobel."
msgstr "이 마법진... 교단 놈들이 여기서 달등불을 만들고 있었군. 이것 좀 봐, 이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 2bb5578b-5fb9-43af-9960-60eb5eb81849
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = False
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:2bb5578b-5fb9-43af-9960-60eb5eb81849
msgctxt "h808d0692ga7ddg458dgb3c9gf672bf6f3bf5"
msgid ""
"A ritual circle. Looks like it was used in the crafting of Moonlanterns."
msgstr "의식 마법진이야. 보아하니 달등불을 제작하는 데 쓰인 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "h389e320fgf92cg4718g9099gdc62fcbc00a7"
msgid ""
"I'll leave this one to the wizard, give him <i>something</i> useful to do."
msgstr "이건 위저드에게 맡겨야겠어. 그 친구도 <i>어딘가에는</i> 쓸모가 있어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "h5edb719eg36efg4bfcg94e0gae1bca7e058f"
msgid "Seems the sort of thing our resident wizard of Waterdeep should handle."
msgstr "우리의 워터딥 위저드가 다뤄야 할 물건 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "hae880824g7795g4626g9cd5ge89e45af2511"
msgid "This looks like a matter for Gale."
msgstr "게일이 맡아야 할 문제 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "h451fc048g770dg458dga2e9g1aebf5de0519"
msgid "Some kind of magic circle. I'll leave Gale to figure this out."
msgstr "일종의 마법 원반이군. 게일이 알아내도록 맡겨야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "h249e6da1gbf42g4e93ga3a3gfc9e975f557f"
msgid "Gale will want to take a look at this."
msgstr "게일이 이걸 보길 원할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "h06e30809gcd0dg4cf8g8582g6ee56b7fd54d"
msgid "This seems like something best left to Gale."
msgstr "이 물건은 게일에게 맡기는 게 최선이겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "h31cc8c7fg2cd8g4319gb82fg1203b6d8c0e2"
msgid ""
"Let us leave the wizardry to Gale. Gods forbid he get bored and put that "
"mind to some other use."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD
#. Speaker = Player
#. NodeID = 3bf7fd63-bff4-238b-ace8-490d8cd0d659
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_BalthazarCircle = True
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/MOO_BalthazarLab_Circle_PAD:3bf7fd63-bff4-238b-ace8-490d8cd0d659
msgctxt "hd250ca5bg32bag4388g94d4gae33b6d1c61f"
msgid "I'll let Gale deal with that particular problem."
msgstr "이 문제에 관해선 게일에게 맡겨야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_Entrance_Plaque2
#. Speaker = Narrator
#. NodeID = 4319f732-438e-4f05-b0b2-c91cf5084884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_Entrance_Plaque2:4319f732-438e-4f05-b0b2-c91cf5084884
msgctxt "h608d43fegd097g423bg981egfb5fa757d321"
msgid ""
"*We offer our pain to the Lady of Loss, that she may truly know her "
"faithful.*"
msgstr "*우리의 고통을 상실의 여인께 바칩니다. 우리의 신실함을 제대로 알게 될 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_Entrance_Plaque1
#. Speaker = Narrator
#. NodeID = 5cd24c12-eaa4-42b8-bd17-b725e9b5f913
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_Entrance_Plaque1:5cd24c12-eaa4-42b8-bd17-b725e9b5f913
msgctxt "h9a28b521g873dg4f64g91a9g0d42777f3a43"
msgid ""
"*We offer our prayers to the Dark Lady, whose comfort and grace heals all.*"
msgstr "*우리의 기도를 어둠의 여신께 바칩니다. 위로와 은혜로 모두를 치유하시는 분이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_Entrance_Plaque3
#. Speaker = Narrator
#. NodeID = 59be7837-74c7-4bf1-ba28-a83485cf23b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_Entrance_Plaque3:59be7837-74c7-4bf1-ba28-a83485cf23b1
msgctxt "h4ef29973g4367g4486gb9fdgfc4630ccd787"
msgid ""
"*We offer ourselves to the darkness, that blessed Shar may give us her "
"mercy.*"
msgstr "*우리 스스로를 어둠에 헌신합니다. 신성한 샤께서 자비를 내려주실지도 모르죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory10
#. Speaker = Narrator
#. NodeID = 5a76cd5d-4e42-463b-b418-a0c57a093bb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory10:5a76cd5d-4e42-463b-b418-a0c57a093bb2
msgctxt "h4d05a30dg2268g4251gb6a1g13e107b3e1d1"
msgid ""
"*In her former life, this girl played in the nearby woods. She was always "
"the best at climbing trees.*"
msgstr "*전생에 이 소녀는 근처의 숲에서 놀곤 했습니다. 나무를 오르는 실력이 항상 최고였죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory11
#. Speaker = Narrator
#. NodeID = 5d19e601-0740-4090-aa76-0091b71f3a27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory11:5d19e601-0740-4090-aa76-0091b71f3a27
msgctxt "h2c37192cg8845g4220gb3bcg798a4ed5678c"
msgid ""
"*You see an older woman, on her knees, scrubbing the floor of an inn. The "
"patrons made a mess of things again the night before.*"
msgstr "*무릎을 꿇은 채 여관 바닥을 닦고 있는 노파가 보입니다. 지난 밤, 손님이 또다시 방을 난장판으로 만들어 놓았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory12
#. Speaker = Narrator
#. NodeID = d7a4c7e0-5aff-44f7-85d1-c3e523469a5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory12:d7a4c7e0-5aff-44f7-85d1-c3e523469a5a
msgctxt "h90bb3498g4925g470cgad11g4b31c750a7df"
msgid ""
"*He had dreams of boarding a ship in Baldur's Gate, and seeing the world. "
"But then the darkness came.*"
msgstr "*이 남자에는 발더스 게이트로 가서 배를 타고 세계를 여행하는 꿈을 가지고 있었습니다. 하지만, 어둠이 찾아왔지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory13
#. Speaker = Narrator
#. NodeID = a4aa5ad3-04e7-4c5e-9d15-4fae7389df2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory13:a4aa5ad3-04e7-4c5e-9d15-4fae7389df2c
msgctxt "h893686fbgd97bg4a3bg8288ge0b46d246918"
msgid ""
"*You sense a young woman, gazing at Moonrise Towers in awe. Perhaps one day "
"she will get to gaze out from atop it, she hopes.*"
msgstr ""
"*경외의 눈으로 문라이즈 타워를 바라보는 젊은 여자가 느껴집니다. 언젠간 저 꼭대기에서 이곳을 내려다볼 날이 오리라고, 그녀는 "
"소망했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory14
#. Speaker = Narrator
#. NodeID = d586c1c5-2941-4f90-8de9-0703790f8c61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory14:d586c1c5-2941-4f90-8de9-0703790f8c61
msgctxt "ha5f42d6dg05b5g48aeg85b0g5aec4a53fa18"
msgid ""
"*The image of an orange-haired cat asleep before a fireplace comes to you. "
"What came of it?*"
msgstr "*벽난로 앞에서 잠든 주황색 고양이의 이미지가 떠오릅니다. 이 아이에게 무슨 일이 있었던 걸까요.* "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory15
#. Speaker = Narrator
#. NodeID = c38a6b2c-354c-4bb3-bc84-36c71b0c39f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory15:c38a6b2c-354c-4bb3-bc84-36c71b0c39f3
msgctxt "hf40ed9caga203g46b2gaa89g396af1e52de7"
msgid ""
"*You sense a swell of grief. Before the shadows took her, this woman mourned "
"someone lost in battle.*"
msgstr "*터질 듯한 비탄이 느껴집니다. 그림자가 이 여성을 데려가기 전까지, 그녀는 전투에서 잃은 누군가를 애도하고 있었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory16
#. Speaker = Narrator
#. NodeID = f4253aa7-8173-4487-bc82-2fe05ac275f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory16:f4253aa7-8173-4487-bc82-2fe05ac275f0
msgctxt "h8d64786eg7743g4a47gb76cg3db1443cf37e"
msgid ""
"*You sense a matriarch's flush of pride - she will soon be a grandmother, "
"and the child will bear <i>her </i>name. Muldred.*"
msgstr ""
"*나이든 귀부인의 자부심이 넘쳐흐르는 것이 느껴집니다. 그녀는 곧 할머니가 될 테고, 태어날 아이는 그녀의 이름을 물려받겠죠. "
"<i>멀드레드</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory17
#. Speaker = Narrator
#. NodeID = 9b5658cd-c4c9-4ba1-bc34-89fca759eb80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory17:9b5658cd-c4c9-4ba1-bc34-89fca759eb80
msgctxt "hbac9047fg53d4g4e83g8908gc9265467b7e8"
msgid ""
"*Callused hands work a hammer and chisel around a massive slab of rock. "
"Months from now, a face will take shape.*"
msgstr "*굳은살 박힌 손이 망치와 끌로 거대한 바위를 깎아내고 있습니다. 몇 달 뒤에는 이 얼굴의 윤곽이 선명히 잡혀 있겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory18
#. Speaker = Narrator
#. NodeID = 70072199-64e1-4b3c-853c-51bd77ccbbe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory18:70072199-64e1-4b3c-853c-51bd77ccbbe6
msgctxt "haeb0b5b8g73aag4a0dg95fcgf341f01443bf"
msgid ""
"*You sense this one hid for days as the sounds of battle got closer and "
"closer to town. You didn't even care who won, so long as it ended.*"
msgstr "*이 영혼은 전투의 소리가 점점 가까워지는 동안 며칠이고 숨어있었습니다. 누가 이겼는진 중요하지 않습니다. 끝나기만 바랄 뿐.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory2
#. Speaker = Narrator
#. NodeID = 4a05eaa7-8328-410b-b8e3-4041617f1c85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory2:4a05eaa7-8328-410b-b8e3-4041617f1c85
msgctxt "hb7362618g8c7dg4882ga57bg12574f06e0c8"
msgid ""
"*You can almost feel the heat from the forge. This one was once a "
"blacksmith.*"
msgstr "*용광로의 열기가 느껴지는 것만 같습니다. 이 영혼은 한때 대장장이였습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory19
#. Speaker = Narrator
#. NodeID = 46155c4a-2f52-46a1-a9fc-36ec17e35e9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory19:46155c4a-2f52-46a1-a9fc-36ec17e35e9c
msgctxt "hb0fe3400gabd2g4a76g8b96g97c354861c27"
msgid ""
"*Before the shadows, there was once a house full of warmth a childrens' "
"laughter in this one's life. No more.*"
msgstr "*그림자가 덮쳐오기 전에, 이 영혼에게는 아이들의 웃음소리로 가득찬 따뜻한 집이 있었습니다. 이젠, 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory20
#. Speaker = Narrator
#. NodeID = f571d1e7-ff46-474d-9d3e-4cb49d422d47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory20:f571d1e7-ff46-474d-9d3e-4cb49d422d47
msgctxt "h3764a9e2g93d2g40c6g89dbg48de17790103"
msgid ""
"*A distant memory of a man stretching his back with a groan. Another day of "
"hauling masonry blocks done...*"
msgstr "*끙끙거리며 허리를 쭉 펴는 남자의 아득히 먼 기억입니다. 또 하루, 벽돌을 나르는 일과가 끝났습니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory21
#. Speaker = Narrator
#. NodeID = e2ffdd59-8e89-4831-8290-31094a5074a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory21:e2ffdd59-8e89-4831-8290-31094a5074a6
msgctxt "he6320f9ag9b6eg4421g8a0bg7f782f6529d7"
msgid ""
"*You can almost taste the sour ale that once clung to this soul's breath. He "
"was insensible when the shadows came for him.*"
msgstr "*한때 이 영혼의 숨결에 배어 있던 시큼한 맥주 맛이 느껴집니다. 이 남자는 그림자가 덮쳐 오고 있음을 알지 못했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory22
#. Speaker = Narrator
#. NodeID = 67a1ddaf-467a-4c84-804f-44fe1e08ba4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory22:67a1ddaf-467a-4c84-804f-44fe1e08ba4c
msgctxt "h8dafad06g75d0g41fbg9955gea5f4d25793d"
msgid ""
"*A happy, faded memory comes to you. A woman walking along a beach, holding "
"hands with her husband-to-be.*"
msgstr ""
"*행복하지만, 빛 바랜 기억이 당신을 향해 쏟아집니다. 한 여성이 해변을 따라 걷고 있습니다. 남편이 될 사람과 손을 잡은 채로.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory23
#. Speaker = Narrator
#. NodeID = 0cc45a1f-a34c-4f9a-a089-90e61806ec02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory23:0cc45a1f-a34c-4f9a-a089-90e61806ec02
msgctxt "h36f6b37fgbce0g4f54g8a3bgfcf387fbfbc4"
msgid ""
"*As the pile of sawdust on the floor grows larger, the cabinet gradually "
"takes shape. The carpenter's pride washes over you...*"
msgstr "*바닥에 쌓이는 톱밥 더미가 많아질수록 캐비닛의 형태가 뚜렷해져 갑니다. 목수의 자부심이 느껴집니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory24
#. Speaker = Narrator
#. NodeID = 2f9213e9-25a2-47e7-aabe-c8177753cf3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory24:2f9213e9-25a2-47e7-aabe-c8177753cf3f
msgctxt "h46beb378g5705g4dccgbbdaga2f9fa56402f"
msgid ""
"*A strange feeling of resentment comes to you. A travelling merchant, sick "
"of this route. Sick of the tolls eating away his profits.*"
msgstr ""
"*당신은 어떤 행상인의 것이었던 기묘한 분노에 사로잡힙니다. 이 길을 이용하는 것도 지긋지긋하고, 수익을 갉아먹는 통행료도 "
"지긋지긋합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory25
#. Speaker = Narrator
#. NodeID = 89cd56a8-bae9-4490-9281-d713fa6c4d6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory25:89cd56a8-bae9-4490-9281-d713fa6c4d6f
msgctxt "h14377248g5fbbg41bdga7cbg281758abd180"
msgid ""
"*You see an old boot, balanced upside down on a cobbler's knee, as he taps "
"the final nail into the new sole. Good as new.*"
msgstr "*수선공의 무릎 위에 거꾸로 놓인 낡은 부츠가 보입니다. 새 밑창에 마지막 못이 박히는 모습이 보입니다. 새것처럼 좋아졌지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory26
#. Speaker = Narrator
#. NodeID = 77ed6801-cbab-4c86-9b42-62e5c426796d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory26:77ed6801-cbab-4c86-9b42-62e5c426796d
msgctxt "h975f0aeegf3e7g4ae1ga656g6d8c8ed4fe47"
msgid ""
"*You sense a faded memory of marching in an army against Ketheric Thorm. "
"Victory seemed possible then.*"
msgstr "*당신은 케서릭 쏨을 향해 진군하는 군대의 희미해진 기억을 느낍니다. 그 때는 승리를 거머쥘 수 있을 것만 같았죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory27
#. Speaker = Narrator
#. NodeID = 768a5f89-fb67-441f-acc2-f84c71f10254
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory27:768a5f89-fb67-441f-acc2-f84c71f10254
msgctxt "h697cd393gd7e3g47dag935dg7c3f8108d22a"
msgid ""
"*You can almost smell the hops and barley for yourself. This man's family "
"always complained that his clothing reeked after work at the brewery.*"
msgstr ""
"*홉과 보리의 냄새가 느껴지는 것만 같습니다. 이 남자가 양조장에서 일을 마치고 돌아오면 가족들은 항상 그의 옷에서 냄새가 난다고 "
"불평했지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory28
#. Speaker = Narrator
#. NodeID = a3b321ce-9eb0-44ae-a600-08af3ec68681
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory28:a3b321ce-9eb0-44ae-a600-08af3ec68681
msgctxt "h10895adcg031cg46a0gb43bgbc2b0461b4cf"
msgid ""
"*You hear the heavy thud of a butcher's cleaver on his block, as he divides "
"his meagre fare for those waiting. Never enough to go around.*"
msgstr "*도살자가 식칼을 내려찍는 소리가 들립니다. 변변찮은 음식을 배급을 위해 나누고 있습니다. 모두가 먹기에는 부족한 양입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory1
#. Speaker = Narrator
#. NodeID = 0b9cec59-8bfc-49ad-bb31-8eb3b8423e39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory1:0b9cec59-8bfc-49ad-bb31-8eb3b8423e39
msgctxt "h0f335d80gedd3g4811gae9eg0a5e4726da1b"
msgid ""
"*A faded memory of a boy and girl sharing their first kiss. Your own heart "
"almost flutters in tune with theirs.*"
msgstr "*첫 키스를 나누는 소년과 소녀의 희미해진 기억입니다. 두 사람의 심장 박동에 맞춰 당신의 심장도 함께 떨리는 것만 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory29
#. Speaker = Narrator
#. NodeID = 761e4274-1d8e-4dae-b8c1-6ea8e6e511f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory29:761e4274-1d8e-4dae-b8c1-6ea8e6e511f8
msgctxt "h3d3ba7cbg9613g422cg89fag6e94cc536a1d"
msgid ""
"*You see a mother sitting by her child's bedside, listening to his sickly "
"breathing as he sleeps.*"
msgstr "*잠든 아이의 가쁜 숨소리를 들으며 아이의 머리맡을 지키고 앉아 있는 어머니의 모습이 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory30
#. Speaker = Narrator
#. NodeID = 4b23147f-1e88-4be6-85c1-f9ceb6407a55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory30:4b23147f-1e88-4be6-85c1-f9ceb6407a55
msgctxt "h3d7f04ddg1c56g4a9fg9bacg5d94e1996984"
msgid ""
"*An echo of the past shows a man hunched over a ledger, quill in hand. Tolls "
"collected on the Risen Road, destined for Moonrise.*"
msgstr ""
"*과거의 메아리가 한 손에 깃펜을 들고 장부 앞에 구부정하게 앉아 있는 남자의 모습을 보여줍니다. 치솟은 길로부터 문라이즈까지의 구간에서 "
"징수한 통행료입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory31
#. Speaker = Narrator
#. NodeID = b5696b78-0890-887a-0cc8-fd600a6f6839
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_Knows_WasInCurse = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_KnowsLuteImportant = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory31:b5696b78-0890-887a-0cc8-fd600a6f6839
msgctxt "h6b735842g6173g4148g99bdg22576d7f8084"
msgid ""
"*You catch a glimpse of the lute-playing Flaming Fist. It's the catatonic "
"man you encountered in Last Light Inn.*"
msgstr "*류트를 연주하는 플레이밍 피스트의 모습이 얼핏 보입니다. 최후의 빛 여관에서 인사불성으로 누워있던 그 남자입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory31
#. Speaker = Narrator
#. NodeID = 0d8cc1b6-d73a-45ad-9931-526be6d4f4a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory31:0d8cc1b6-d73a-45ad-9931-526be6d4f4a4
msgctxt "hf1a53ab9g1adbg4ffegb1a7gdf8dd1e35ed2"
msgid ""
"*You see a man drain his tankard in an inn as he listens to a Flaming Fist "
"play the lute. He's better than his uniform might suggest.*"
msgstr ""
"*한 남자가 여관에서 맥주잔을 비워냅니다. 플레이밍 피스트 한 명이 류트를 연주하고 있습니다. 겉보기와는 다르게 실력이 좋습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory32
#. Speaker = Narrator
#. NodeID = 0b78a3fc-4226-4ce2-ba30-27f1ab4a1cd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory32:0b78a3fc-4226-4ce2-ba30-27f1ab4a1cd3
msgctxt "h9a3626dbgf85ag4745gbd1fg7ea3b48c2f4c"
msgid ""
"*An older man turns his head away in shame. His neighbours would not "
"renounce Selûne - now they hang in the town square.*"
msgstr "*노인이 수치심에 고개를 돌립니다. 그의 이웃들은 셀루네를 저버리지 않았고, 그 결과 그들은 마을 광장에 매달려 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory33
#. Speaker = Narrator
#. NodeID = a5481963-12af-4316-87f9-0b6c6721ca0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory33:a5481963-12af-4316-87f9-0b6c6721ca0d
msgctxt "h4db86900g8b55g4d3eg8d01geb581b5912c8"
msgid ""
"*You feel a rush of outrage. This woman worshipped Shar to the end - so why "
"does the Nightsinger's curse not spare her...?*"
msgstr ""
"*당신은 분노가 치미는 것을 느낍니다. 이 여자는 끝가지 샤를 섬겼습니다. 그런데 어째서 나이트싱어의 저주로부터 안전하지 않았던 "
"걸까요...?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory3
#. Speaker = Narrator
#. NodeID = bfe799e1-4dfd-46ec-8c9f-47f85829bba2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory3:bfe799e1-4dfd-46ec-8c9f-47f85829bba2
msgctxt "h6a18357bgfff2g48b5gb0f1g5ebe8061b440"
msgid ""
"*Desperate prayers to Selûne, echoing from the past. They did not save him.*"
msgstr "*셀루네를 향한 간절한 기도가 과거로부터 울려퍼집니다. 아무도 이 남자를 구해 주지 않았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory4
#. Speaker = Narrator
#. NodeID = 5c99996b-5214-4ce0-998f-42729f3a23ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory4:5c99996b-5214-4ce0-998f-42729f3a23ca
msgctxt "h15d8f516g3d94g45ceg9cd7gf585c43b6ce3"
msgid ""
"*You sense a fading echo of the person who once was. A dockhand. He did not "
"ask for this.*"
msgstr "*한때는 사람이었던, 사라져가는 메아리를 감지합니다. 항만 노동자였습니다. 그가 원하던 결말은 아니었죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory5
#. Speaker = Narrator
#. NodeID = 5c17ff02-3adf-4fcf-a95f-27efb275198b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory5:5c17ff02-3adf-4fcf-a95f-27efb275198b
msgctxt "h91ffd965ga98eg4350g8672gc75bd5dbf121"
msgid ""
"*You glimpse a young Harper on the eve of battle against Thorm, long ago. He "
"and his comrades toast each other in Last Light...*"
msgstr ""
"*젊은 하퍼의 모습이 보입니다. 오래전, 쏨과의 전투가 벌어지기 전날 밤, 최후의 빛 여관에서 동료들과 함께 잔을 주고받고 있습니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory6
#. Speaker = Narrator
#. NodeID = fe4091d1-7c37-4508-9a91-558668bdef18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory6:fe4091d1-7c37-4508-9a91-558668bdef18
msgctxt "h4a319473g93f1g4e37g8c77g10a132015d2e"
msgid ""
"*Thoughts of baby names. She did not wish for her first born to be named "
"after her mother-in-law. Muldred. Ugh.*"
msgstr "*아이 이름에 대한 생각들입니다. 그녀는 자신의 첫 아이가 장모님의 이름을 따르는 걸 원치 않았습니다. 멀드레드라니. 윽.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory7
#. Speaker = Narrator
#. NodeID = 6773c1d7-6520-43b1-833a-6fd3121b6c5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory7:6773c1d7-6520-43b1-833a-6fd3121b6c5b
msgctxt "hc0c15228g3cafg443dgaca9g117a05959794"
msgid "*You sense that this one was once a fisherman, taught by his father.*"
msgstr "*이 자는 한때 어부였습니다. 자신의 아버지에게 일을 배웠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory8
#. Speaker = Narrator
#. NodeID = 10a85854-2494-4d93-ab2f-6a5ffacc5804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory8:10a85854-2494-4d93-ab2f-6a5ffacc5804
msgctxt "hca36eaa4gadfbg431fg9ee4gb25f83a196fe"
msgid ""
"*She was a healer, trying to aid the wounded in the battle against the "
"Sharrans. But there were so many...*"
msgstr "*그녀는 치유사였습니다. 샤 신도들과의 전투에서 다친 이들을 돕고자 했죠. 그러나 그 수가 너무 많았습니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory9
#. Speaker = Narrator
#. NodeID = d8cbe3e9-20e7-4fc6-b105-a5404dead9e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_AD_ShadowMemory9:d8cbe3e9-20e7-4fc6-b105-a5404dead9e9
msgctxt "he9802c22gc799g4ceagae7dg99eee5d91fff"
msgid ""
"*You see a man stalking slowly through the woods, bow half-drawn. If he bags "
"a deer, the whole family will be kept fed all winter...*"
msgstr ""
"*활 시위를 반쯤 당긴 채 숲에서 사냥감을 은밀히 쫒는 남자가 보입니다. 사슴을 하나 잡으면 온 가족이 겨울 내내 먹을 수 있습니다... "
"*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "h9a2b8f9aged30g4d31g985cg321fd2d94648"
msgid "Consumed by that blasted curse... Greedy."
msgstr "탐욕스런 저주에 삼켜지고 말았어... 지독하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "hfca2f1ebg3395g4239g9ea4gf96f16c7263f"
msgid "Killed by cursed shadows. A fate I'd rather avoid."
msgstr "저주받은 그림자에 죽다니. 나로선 피하고 싶은 운명이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "hf9e8a10agca15g4825gb140g35e56e25f715"
msgid ""
"A withered creature, consumed by the shadow curse. A fate I hope we don't "
"share."
msgstr "말라붙어 버렸군. 그림자 저주에 잠식당하고 만 거야. 우리는 저렇게 안 됐으면 좋겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "h54644c92g487dg45d7g96eag4ce149e6265e"
msgid "The shadows' hunger is endless, it seems."
msgstr "그림자의 허기는 끝이 없는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "h7bbdad42ga9e3g4eddg96ceg277a331d8ae5"
msgid "Poor thing. The place must have teemed with wildlife, once."
msgstr "가여운 것들. 여긴 분명 예전엔 광활한 생태계가 있었을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "h5fc94722gfbe6g419bgbe34g99ae543a3dba"
msgid "Shadows will take whatever's living."
msgstr "그림자가 살아있는 모든 생물을 잠식하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "h72dae0c1g3c31g41ebgb450g7ec6ee7c8ec0"
msgid "Consumed by the shadows. Like everything else in this land."
msgstr "그림자에 잡아먹히고 말았어. 이 땅의 다른 모든 것들처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "hee40e98agdb3dg465aga864g12cd255dc123"
msgid "The shadow curse spares none of nature's creations."
msgstr "그림자 저주는 자연의 피조물들에게 자비가 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: DRUID
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "h6d9a41begec77g4ed2g8ecag86354e1ea750"
msgid "This curse subverts all that is good in nature."
msgstr "자연의 모든 아름다움을 망가뜨리는 저주로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: CLERIC and PALADIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "h7dfeb4e3g7852g4fbcg9646g4581e53fa510"
msgid "This curse is powerful - the will of a god made manifest."
msgstr "매우 강력한 저주야. 신의 의지가 개입된 게 틀림없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal
#. Speaker = Player
#. NodeID = 038e99e7-0479-49c6-9079-d9892b518429
#. HandlePath = TaggedText[10].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadCursedAnimal_PAD_FindAnimal:038e99e7-0479-49c6-9079-d9892b518429
msgctxt "he6b3361cg6ea4g4b90g8e96g17df0b0d3eb0"
msgid ""
"The animal never had a chance. The curse consumes everything it touches."
msgstr "동물마저도 꼼짝없이 당했군. 저주의 손길이 생기를 죄다 빨아들이고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "he466c12fgd883g4ce3gb9a4g94abb29396da"
msgid ""
"The druids have been studying this place for a while. Not that it's helped."
msgstr "드루이드들이 이 장소에 관해 한동안 연구했었나 보네. 도움이 된 건 아니지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "hdef3a599g022ag42e1gb270g1c98fccbc335"
msgid "The druids' research. Helpful too, as luck would have it."
msgstr "드루이드들의 연구 기록이군. 행운 만큼이나 유용하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "hfb6d2ef2g32d2g44adgb0acgfe967fafe801"
msgid ""
"Research notes - on the nature of the shadow curse. A most-fortuitous find."
msgstr "연구 기록이군. 그림자 저주의 특성에 대한 내용이야. 이런 걸 발견하다니 운도 좋지.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "ha76f944cga5eeg4711ga596g1854b359ca93"
msgid ""
"Research notes on the shadow curse. It may be wise to heed what's said here."
msgstr "그림자 저주에 대한 연구 기록이야. 여기 적힌 내용은 유의할 필요가 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "h5e6128eage094g432fga050g483767b3058e"
msgid "These notes offer good advice - I should keep it in mind."
msgstr "이 기록은 훌륭한 도움이 되겠는데. 기억해 두자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "hf34346ffgb476g4c8ag8b77gb131aacb85c1"
msgid "Someone was researching the shadows. Good advice in here."
msgstr "누군가 그림자에 대해서 연구했어. 도움이 되겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "hfe9353c4g2300g4995ga508g7bb0fe982b0d"
msgid ""
"The druid learned much of the shadow curse. But not enough to cleanse it - "
"or save themselves."
msgstr "그림자 저주에 대해 많은 걸 알아냈는데, 그걸로는 어림도 없었군. 정화는 고사하고, 자기들 목숨도 부지하지 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "hdd5e0a91g5b85g48fagb212ge973202acbdb"
msgid ""
"A fellow druid's research into the nature of this foul shadow curse. These "
"insights may prove valuable."
msgstr "나와 같은 드루이드가 이 사악한 그림자 저주의 특성에 대해 연구했군. 그 통찰이 언젠가는 빛을 보겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:19d32a61-139e-4b3a-a5c5-6ba7aed0dd61
msgctxt "h935a5fd2g40cbg415egb48eg8bd82fa8504a"
msgid "Research on the nature of the shadow curse. Good to know."
msgstr "그림자 저주의 특성에 대한 연구로군. 좋은 정보야.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "hf3fe53f0g11b6g4c68gadb9g1fdc2aabb891"
msgid "The idea of this darkness spreading is not comforting."
msgstr "이 어둠이 퍼져나간다니 생각만 해도 불편하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "h00642723gb384g480dg9f21ga578e2975c28"
msgid "This shadow curse is deadly. I hope it's been contained."
msgstr "이 그림자 저주는 치명적이다. 억제가 된 상태라면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "h80ec7239g8fc2g4774gb946gaef18b63c46d"
msgid ""
"Notes on the shadow curse. I sincerely hope its effects haven't spread past "
"this region..."
msgstr "그림자 저주에 대한 기록이군. 그 영향력이 이 지역을 넘어서까지 퍼지지 않았으면 좋겠는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "ha07216bdgb969g4000gb1d7ga1561c3193d5"
msgid "Notes on the shadow curse. Perhaps some feared it would spread?"
msgstr "그림자 저주에 대한 기록이군. 누군가 저주가 퍼져나가지 않을까 걱정했나 본데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "h35a75624g0afeg4543gb073g4dd5138a2ca2"
msgid "Notes on the cursed shadows. If ever they were to spread..."
msgstr "저주받은 그림자에 대한 기록이군. 만약 저주가 퍼져나간다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "h4f3e5acfgf10fg45b3g926fgb92f75327996"
msgid "The shadows are spreading? Well, shit."
msgstr "그림자가 퍼져나가고 있다고? 이런, 젠장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "hd7875572g5ba1g4362gae6dg00fafc9ea770"
msgid "The curse spreads. Not even nature's devotees are safe."
msgstr "저주는 퍼진다. 자연에 헌신하는 자들도 안전하지 않겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "h523897f7gb5c6g48a2g920cge5eff33cc75b"
msgid ""
"Notes on the shadow curse. I can only hope such knowledge is never needed "
"beyond this place."
msgstr "그림자 저주에 대한 기록이군. 이 지식이 부디 이곳 밖에서는 쓸모가 없기만을 바랄 뿐이네.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch
#. Speaker = Player
#. NodeID = 307c60c9-ffad-f186-2228-54b9e156578b
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_DeadDruid_State_PassedNatureCheck = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DeadDruid_PAD_ReadResearch:307c60c9-ffad-f186-2228-54b9e156578b
msgctxt "hd844f613ge212g4a62gae06g2acb9c603a61"
msgid ""
"Something to do with the shadow curse? I truly hope this blight isn't "
"spreading..."
msgstr "그림자 저주에 관한 내용인 것 같은데? 이 재앙이 퍼지지 않기만을 바랄 수밖에...\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower
#. Speaker = Brawler Vez
#. NodeID = 4e2e6ef6-09d6-47d3-a97a-d8bdcb05a3ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 711fda6a-05e2-6677-b067-9b1c710e0cdb_A = True
#. SetFlags:
#.   Local:
#.     - 711fda6a-05e2-6677-b067-9b1c710e0cdb_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower:4e2e6ef6-09d6-47d3-a97a-d8bdcb05a3ff
msgctxt "h00df433bgf020g4d50g9de2gedfc73c82a86"
msgid "Wonder if there's dancing down in the war camp. Feelin' frisky."
msgstr "군영에서 춤은 추나 모르겠네. 신나게 놀고 싶단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower
#. Speaker = Brawler Vez
#. NodeID = 8353ee97-41c1-48c4-b49d-198ca898557a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 711fda6a-05e2-6677-b067-9b1c710e0cdb_B = True
#. SetFlags:
#.   Local:
#.     - 711fda6a-05e2-6677-b067-9b1c710e0cdb_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower:8353ee97-41c1-48c4-b49d-198ca898557a
msgctxt "h1e067172g55cbg4cb3g8532geee28ce22e15"
msgid "Can you hear what I'm thinking, oh Absolute? 'S dirty."
msgstr "제 생각이 들리십니까, 절대자시여? 추잡한 생각인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower
#. Speaker = Brawler Vez
#. NodeID = 85562151-bc51-4f04-9404-381924a14833
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 711fda6a-05e2-6677-b067-9b1c710e0cdb_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower:85562151-bc51-4f04-9404-381924a14833
msgctxt "hee717f35gc201g4a26gb5c9g6fc6625e2f93"
msgid "Stronghold of the Absolute, eh? Well I ain't praying."
msgstr "이게 절대자님의 요새인가? 난 기도 따윈 안 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower
#. Speaker = Brawler Vez
#. NodeID = fbaaa786-63f7-405a-8379-1c63f7d1c2e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 711fda6a-05e2-6677-b067-9b1c710e0cdb_C = True
#. SetFlags:
#.   Local:
#.     - 711fda6a-05e2-6677-b067-9b1c710e0cdb_B = False
#.     - 711fda6a-05e2-6677-b067-9b1c710e0cdb_A = False
#.     - 711fda6a-05e2-6677-b067-9b1c710e0cdb_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_Goblins_AtTower:fbaaa786-63f7-405a-8379-1c63f7d1c2e7
msgctxt "hbc304438gaa1cg4af2g8876g9ad509ca78d6"
msgid "Lots of fat little halflings in that tower. Damn waste of meat."
msgstr "타워 안에 뚱뚱한 하플링들이 잔뜩 있어. 그게 다 고기인데 아깝단 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Kansif
#. NodeID = 08849bf3-6d0e-125a-277b-ab34199d7aa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:08849bf3-6d0e-125a-277b-ab34199d7aa1
msgctxt "h0754bd6fgc2a1g4ee4g95d1g1036d425ecaa"
msgid "This <i>is</i> its glory."
msgstr "여긴 <i>지금이</i> 한창때야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Bedi
#. NodeID = 0e9aad2b-ab92-b0c9-e6fc-cee7390e4717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:0e9aad2b-ab92-b0c9-e6fc-cee7390e4717
msgctxt "hccadd1e6g3e18g4497g90a4ge151afa03c40"
msgid ""
"I can... <i>feel</i> them. True Souls - it's like they send out ripples."
msgstr "그들이... <i>느껴져.</i> 참된 영혼말이야. 뭔가 파동을 내보내는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Kansif
#. NodeID = 20aac90d-bdaa-6dbf-2ea1-09426bc767f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:20aac90d-bdaa-6dbf-2ea1-09426bc767f8
msgctxt "h446f3db9geb98g4575g9b9cgc6016096dffe"
msgid ""
"Aye. They're Her vessels. You can feel the strength of their faith, like a "
"tickle at the back of your mind, whenever they approach."
msgstr "맞아. 참된 영혼은 그분의 그릇이야. 네가 느끼는 건 그들의 강한 신념이다. 근처에 있으면 네 정신의 뒷면을 간지럽게 만들지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Bedi
#. NodeID = 41cae6e7-bcfc-28e3-48ff-117deb1f468b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:41cae6e7-bcfc-28e3-48ff-117deb1f468b
msgctxt "hccf6bdedgc1adg44a7g874ag15ce4c114a07"
msgid "As you say, Kansif."
msgstr "그 말대로 하지, 칸시프."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Kansif
#. NodeID = 42dbc872-eaf8-4212-8966-4a7040706004
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6d32676a-ac06-3f94-8377-35a6aed97492_A = True
#. SetFlags:
#.   Local:
#.     - 6d32676a-ac06-3f94-8377-35a6aed97492_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:42dbc872-eaf8-4212-8966-4a7040706004
msgctxt "h10fe6665gfbedg42deg8d99gbe5baf5c4ea9"
msgid "Remember to show respect. Anyone here could be a True Soul."
msgstr "존경을 보이는 거 잊지 마. 여기 있는 누구든 참된 영혼일 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Kansif
#. NodeID = 626a6f68-fb04-3f58-0db4-aa4e11798999
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:626a6f68-fb04-3f58-0db4-aa4e11798999
msgctxt "h72b8c8aegfe36g4144g9e8cgb6365618c835"
msgid ""
"And if you don't show respect, you'll feel their faith like a fist to your "
"gut."
msgstr "존경을 보이지 않으면, 그 신념이 네 내장을 휘젓는 주먹처럼 느껴질 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Bedi
#. NodeID = 64d8f06a-8964-4264-be0f-cf8584ab80e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6d32676a-ac06-3f94-8377-35a6aed97492_B = True
#. SetFlags:
#.   Local:
#.     - 6d32676a-ac06-3f94-8377-35a6aed97492_B = False
#.     - 6d32676a-ac06-3f94-8377-35a6aed97492_C = False
#.     - 6d32676a-ac06-3f94-8377-35a6aed97492_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:64d8f06a-8964-4264-be0f-cf8584ab80e8
msgctxt "h1cfe1724g1d40g42ecg9597g17e1f1038355"
msgid "I wonder what this place looked like in its glory."
msgstr "여기가 한창때는 어땠을지 궁금하단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Bedi
#. NodeID = 84a795f8-d5e4-6dfc-1b5d-8bcb99775166
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:84a795f8-d5e4-6dfc-1b5d-8bcb99775166
msgctxt "h7b9c534cg7ce3g4c4cg9538g9815d9b5588b"
msgid "Still. I bet Ketheric changed his wall hangings as often as his gods."
msgstr "그래도. 케서릭이라면 자기가 섬기던 신 갈아치우듯 벽에 걸린 족자도 갈아치웠을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Kansif
#. NodeID = a7fd14df-0c09-37ec-d576-69baac9839a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:a7fd14df-0c09-37ec-d576-69baac9839a6
msgctxt "h1e2ee3a9gbf3ag45aeg86b0g47515f2acec5"
msgid "Careful. The General has excellent hearing, I'm told."
msgstr "조심해. 장군님께선 유별나게 귀가 밝다고 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Kansif
#. NodeID = a9a24700-4632-414f-8c5e-1bffd7e52f45
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6d32676a-ac06-3f94-8377-35a6aed97492_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:a9a24700-4632-414f-8c5e-1bffd7e52f45
msgctxt "hcccbb62fg55fcg4d85g9ca2gd020f9cee919"
msgid "Rest while you can. We have no more pilgrims to herd for a time."
msgstr "쉴 수 있을 때 쉬어. 당분간은 순례자들이 없을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower
#. Speaker = Kansif
#. NodeID = c80a087c-623c-591f-4c74-577797a1c4a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_AD_HalfOrcs_AtTower:c80a087c-623c-591f-4c74-577797a1c4a8
msgctxt "hfb02cd55g77e5g46acg9ef6g22d567f62b61"
msgid "... right."
msgstr "... 그렇군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_000_AD_DriderDies
#. Speaker = Brawler Vez
#. NodeID = 219d23b1-dc13-4787-b1c6-01e244f8e944
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_000_AD_DriderDies:219d23b1-dc13-4787-b1c6-01e244f8e944
msgctxt "hec64000bg24a8g4df0gaf67ga74d36a144b6"
msgid "The boss is down! Don't let 'em get away with the light!"
msgstr "대장이 쓰러졌다! 놈들이 도망가지 못하게 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 02f5fd10-71b5-744a-755b-0f425ff1ca4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:02f5fd10-71b5-744a-755b-0f425ff1ca4a
msgctxt "h32a7ccefgbc86g4352g96b2ge63ae72c9e37"
msgid ""
"The curse gets deadlier the further you go in. But have no fear, boss. We've "
"got a guide."
msgstr "안으로 들어갈수록 저주가 더 심해질거야. 그래도 겁먹지는 마, 대장. 안내자가 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 038a460e-b1fa-da54-9d15-82a08ea3ebc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:038a460e-b1fa-da54-9d15-82a08ea3ebc2
msgctxt "h68ca2c3cg138bg4742gbc51g56b006f9ba97"
msgid "Speaking of power - go on and fetch that bone you threw."
msgstr "권력자가 말하노니, 네가 던진 뼈를 물어 오거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 0fc605e8-701a-40a4-7f60-216f8264692d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_GainedAccessToCaravanCampFromDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:0fc605e8-701a-40a4-7f60-216f8264692d
msgctxt "h5df4eb5dg1683g4704gabe3gb687f93f1f3d"
msgid "Right you are. Go through and talk to Kansif - he's been waitin'."
msgstr "맞구만. 지나가서 칸시프랑 이야기 해봐, 기다리고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 1f32ec92-2e19-8200-e304-972c61cee443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:1f32ec92-2e19-8200-e304-972c61cee443
msgctxt "hd16e14efg16d8g4678gada1gec0d99194018"
msgid ""
"Aye, in the shallows. But the curse don't care 'bout some itty bitty light "
"once you get deeper. But don't worry, boss - we've got a guide."
msgstr ""
"그래, 얕은 곳에서는 괜찮지. 근데 깊은 곳으로 들어가면 저주가 그런 쪼매난 빛은 신경도 안쓸 걸. 그래도 걱정마, 대장, 안내자가 "
"있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 1f6eaba5-d655-1fea-599b-8db38507330c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:1f6eaba5-d655-1fea-599b-8db38507330c
msgctxt "hd6414e83g893eg49eagbacdge10744512b29"
msgid "Let's get moving then."
msgstr "그럼 이제 가볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 202aa767-cb92-1eb5-5e88-a76097188028
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:202aa767-cb92-1eb5-5e88-a76097188028
msgctxt "h68d3f474g4034g4403g99f4g92fe000b8a02"
msgid "Don't worry boss, you're in good hands. We've got a guide."
msgstr "걱정마 대장, 안심해도 돼. 안내자가 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 272a54cd-4e60-a23e-2ff8-6cc17cdc527a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_DriderCaravan_GoblinMelee_001_Checkpoint_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:272a54cd-4e60-a23e-2ff8-6cc17cdc527a
msgctxt "ha360dda9g91d5g4badga548g34842718f3ea"
msgid "Hey boy - yeh want the bone? Yeh want the bone?"
msgstr "멍멍아, 뼈 갖고 싶어? 뼈 갖고 싶냐고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 2766c8c6-b575-26f7-38b0-746b5addb836
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:2766c8c6-b575-26f7-38b0-746b5addb836
msgctxt "h7c71dd96ga061g44dfga9d4g6a0617723ade"
msgid ""
"I have power in spades, that's true - but it comes from <i>me</i>, not the "
"Absolute."
msgstr "나에겐 엄청난 힘이 있지, 그건 사실이야, 하지만 그건 절대자의 힘이 아니라 <i>나</i>의 힘이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 2da246cb-4ce7-1d6d-33af-9d03258aeb5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_HyenaGoblinScene = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:2da246cb-4ce7-1d6d-33af-9d03258aeb5c
msgctxt "h332795b1gc039g4ec6gb5cage583564a0a6c"
msgid "Fetch!"
msgstr "물어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 2dcc7027-32fd-1b51-c37b-137965e84cee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:2dcc7027-32fd-1b51-c37b-137965e84cee
msgctxt "hc60f3523gc756g4d98ga38eg33c8b84b11c8"
msgid "<i>Chuckle.</i>"
msgstr "<i>웃는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Hyena
#. NodeID = 368ee40a-9239-5b07-689a-92d233621051
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Hyena_State_Defeated = False
#.      - SCL_EntryPoint_Event_TossHyena = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:368ee40a-9239-5b07-689a-92d233621051
msgctxt "ha5f38059g86eag4994gbcebg949c82304a03"
msgid "*Whine.*"
msgstr "*낑낑거림*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 3931d23f-3dec-9d91-4778-e59560a06230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:3931d23f-3dec-9d91-4778-e59560a06230
msgctxt "h9edf1e6eg434dg4079g8939g0468aa08f06b"
msgid "Go on. <b>Fetch.</b>"
msgstr "얼른 가. <b>물어.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 3bdefe8c-1b5f-02d2-6f3c-6abd2f48de7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:3bdefe8c-1b5f-02d2-6f3c-6abd2f48de7c
msgctxt "hbad46254g1b69g4002g9fc7g35f8b38301cb"
msgid ""
"You don't know? Oh, you're gonna soil yourself when you see him. But I won't "
"spoil the surprise - that's for Kansif. Head on in."
msgstr "모르는 거야? 오, 그 사람보면 지릴지도 모르겠네. 그래도 미리 말해주진 않을 거야, 그건 칸시프에게 맡겨야지. 들어가봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 4a389513-abc9-4ca7-c385-570434be0301
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:4a389513-abc9-4ca7-c385-570434be0301
msgctxt "h2cef2a86g30b4g4759g85fcg2769e6707f44"
msgid "Ha! Haha! Of course. Good one."
msgstr "하! 하하! 그렇지. 재밌었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 531e3500-89f4-a9ee-7e71-c91b2417aeb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_GainedAccessToCaravanCampFromDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:531e3500-89f4-a9ee-7e71-c91b2417aeb5
msgctxt "hc3e92619gd154g4c3ag9a40g9534c0a010ea"
msgid "Ready when you are, True Soul. Anything you need."
msgstr "준비됐어, 참된 영혼. 원하는 걸 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 552e7080-8ddf-e832-ffb9-1b6c9abb93e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_GainedAccessToCaravanCampFromDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:552e7080-8ddf-e832-ffb9-1b6c9abb93e2
msgctxt "h1ab5deeagddbfg459bgab9eg04ba91e9faa6"
msgid ""
"Go on through and speak to Kansif. He's not as honey-tongued as me, mind."
msgstr "지나가서 칸시프랑 이야기 해봐. 나처럼 꿀바른 혀를 가지진 않았으니, 염두하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 573292db-320a-f22b-9cc8-1f8515698464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:573292db-320a-f22b-9cc8-1f8515698464
msgctxt "h04ab23b1gaa95g49edg9e76g6956ace2bb7e"
msgid "You're the True Soul we're taking to Moonrise, I'm guessing?"
msgstr "넌 우리가 문라이즈로 데려다 줘야하는 참된 영혼, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 57386d0b-586d-9fbe-12d2-11798ba835eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:57386d0b-586d-9fbe-12d2-11798ba835eb
msgctxt "h50c57fb2g8a54g430agb891gf6b456615d7b"
msgid "One last thing - go and fetch the bone you threw."
msgstr "마지막으로 하나만 더, 네가 던진 뼈 물어다 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 5a9b0f26-7fa6-308c-5f51-c2ece7fce70e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:5a9b0f26-7fa6-308c-5f51-c2ece7fce70e
msgctxt "h27031d07g4145g4f4dg97bag853447347c3c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 5a9fe4d5-e8e0-3ae1-29a2-f2ccb09e318b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:5a9fe4d5-e8e0-3ae1-29a2-f2ccb09e318b
msgctxt "hba8a5d08g7ef1g4b36g87fdg0a10334c2d5e"
msgid ""
"I take it you're the True Soul we're waiting on? Needs passage to Moonrise?"
msgstr "보니까 우리가 기다리던 참된 영혼 맞지? 문라이즈로 가는 길을 찾는?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 5ca18ad6-9f8d-3ead-393a-3171b84e3d24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:5ca18ad6-9f8d-3ead-393a-3171b84e3d24
msgctxt "hdd068767g6156g4746gbdb1g3ad5d01d6811"
msgid ""
"I meant it as a compliment, True Soul! No sweeter stink there is than that "
"of power - yours, of course."
msgstr "칭찬으로 한 말이야, 참된 영혼! 네가 가진 힘보다 더 달콤한 냄새가 나는 건 없지, 당연히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 627a2226-e7e7-4bee-4b85-ef58f340adca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:627a2226-e7e7-4bee-4b85-ef58f340adca
msgctxt "hb9b7dbe5g0c8bg4eeag875cg26f997f643a8"
msgid "Anything for a True Soul. Put in a good word for me at Moonrise, eh?"
msgstr "참된 영혼을 위해서라면. 문라이즈에 가면 나에 대해 좋게 이야기 해줘, 어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 65b3735e-b191-d0b1-4924-7a9880a7da81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:65b3735e-b191-d0b1-4924-7a9880a7da81
msgctxt "hb48a75bbg0fc8g42d1g9a34g060e1153f69d"
msgid "How do you plan on getting me through this cursed darkness?"
msgstr "저주받은 어둠을 어떻게 뚫고 갈 생각이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 6802c16f-5d3d-1dde-b66c-e17822002e69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:6802c16f-5d3d-1dde-b66c-e17822002e69
msgctxt "hf997595agc411g409cgad1fg42aaa676e7b7"
msgid "Heh. Oi!"
msgstr "헤. 어이!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 68b8d7b6-e243-2c6f-a577-b36469ae297d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_EntryPointGoblin_HasMet(1) = True
#. TagRule: WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:68b8d7b6-e243-2c6f-a577-b36469ae297d
msgctxt "hb4492003g154bg4d37g9bcegb2a06094b5af"
msgid ""
"According to my notes, light should be sufficient to keep the curse at bay."
msgstr "내 노트엔, 빛이 저주를 막아주는데 효과가 있다고 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 68b8d7b6-e243-2c6f-a577-b36469ae297d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_EntryPointGoblin_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:68b8d7b6-e243-2c6f-a577-b36469ae297d
msgctxt "h44686418gf48cg4773ga527g1d18b7eedc8f"
msgid "I thought light was enough to keep the curse at bay."
msgstr "내 생각엔 빛 정도면 저주를 막는데 충분할 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 698df9cf-2830-6120-1138-f7dbd649a5d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:698df9cf-2830-6120-1138-f7dbd649a5d2
msgctxt "hc1a6a27egb409g4347g8e83ge46ec97e2861"
msgid "<i>Argh! </i>Hells - I near stained myself."
msgstr "<i>악! </i>망할, 얼룩질 뻔 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 6b02b237-29c0-c045-1df4-c6bc592b97f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_EntryPointGoblin_HasMet(1) = True
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Knows_CreaturePath = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:6b02b237-29c0-c045-1df4-c6bc592b97f6
msgctxt "h2e8c9f60g54b7g4242g84f2g29634b390866"
msgid "I was sent here by another goblin."
msgstr "다른 고블린이 여기로 가라던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 704d813a-b323-803e-8662-7a6790da174b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DRUID or RANGER
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:704d813a-b323-803e-8662-7a6790da174b
msgctxt "h4352b17fgd82cg4978ga5b6ga0e68c9447dd"
msgid ""
"A guide? I know of no man nor beast that could traverse such darkness "
"unaided."
msgstr "안내자가 있다고? 이런 어둠을 혼자서 가로지를 수 있는 인간이나 짐승은 없을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 7088b3b5-bb11-44e0-8d24-67c1d1efaa12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:7088b3b5-bb11-44e0-8d24-67c1d1efaa12
msgctxt "h1709a404g5da4g4332gb0c0g8163847e8c5e"
msgid "Go on. <b>Fetch.</b>"
msgstr "얼른 가. <b>물어.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 734429dd-a6e7-9753-7de4-875877bd4751
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Knows_CreaturePath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:734429dd-a6e7-9753-7de4-875877bd4751
msgctxt "hf67e61b0gadd7g48dag94b8gd36bd9a85799"
msgid "Minthara sent me."
msgstr "민타라가 날 보냈어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 75c41ca4-903f-6712-f4d9-09bab6c0dd13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Knows_CreaturePath = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:75c41ca4-903f-6712-f4d9-09bab6c0dd13
msgctxt "h9ead21e3g7053g4fe1g9fa3g5ad8490622d1"
msgid "That's me."
msgstr "나 맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 7885265d-b22e-7bb5-d09f-50f7cacced79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:7885265d-b22e-7bb5-d09f-50f7cacced79
msgctxt "haeda1badg52feg4fb9g9f1cg2755096ec40a"
msgid "Will do - thanks."
msgstr "그러지, 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Narrator
#. NodeID = 79a3e84e-acbd-4628-b515-32daf3e20554
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:79a3e84e-acbd-4628-b515-32daf3e20554
msgctxt "h9c526da6g35b7g4c0egb6eag2f234e51fe2e"
msgid ""
"*You focus on the source of the power, but it is quiet and still. It needs "
"to rest.*"
msgstr "*힘의 원천인 존재에 정신을 집중하지만, 응답이 없습니다. 휴식이 필요한 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 7b72dcfe-a0a0-f499-0d67-6f31afdb50e3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: OATHBREAKER_VENGEANCE or PALADIN_VENGEANCE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:7b72dcfe-a0a0-f499-0d67-6f31afdb50e3
msgctxt "hd86f278ag806dg4163gb402g453075967567"
msgid "Those who refuse me do not live for very long."
msgstr "나에게 거역한 놈은 오래 못 살지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 80790034-517e-95b6-3c30-2ebfdbd2d11a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_GainedAccessToCaravanCampFromDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:80790034-517e-95b6-3c30-2ebfdbd2d11a
msgctxt "hfa01c8f8gae7cg4dacg8de9gad9549b29223"
msgid "Now, eh... we'd best get goin', eh?"
msgstr "이제, 어... 우리 가봐야겠지, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 80af23ef-4b61-5fd1-299d-e5efeb16e469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:80af23ef-4b61-5fd1-299d-e5efeb16e469
msgctxt "hb3165cd4g748cg4759ga318gc97f6e02c38c"
msgid "Wait. You're... joking, yeah?"
msgstr "잠깐. 노... 농담이지, 어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 8557601e-f9ee-bd10-5d9e-c5875bac2467
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:8557601e-f9ee-bd10-5d9e-c5875bac2467
msgctxt "h5677c30bgce4cg4ea4g8f5bg24b97d136759"
msgid ""
"Just seeing if this shadow curse is as bad as they say. Word is it eats "
"anyone gets too deep into the dark."
msgstr "그림자 저주가 사람들 말하는 거만큼 나쁜지 확인한 것뿐이야. 너무 깊이 들어가면 잡아먹힌다고 하던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 950964bc-6b59-c4eb-c862-a5ade3f3f01b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:950964bc-6b59-c4eb-c862-a5ade3f3f01b
msgctxt "h72ae2202g7e05g4462g91cegc68d3768fedb"
msgid ""
"Refuse me again and I'll strike you down with the power of the <i>divine.</i>"
msgstr "한번만 더 거역하면 <i>신성한</i> 힘으로 널 박살내주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 98594851-46bc-6a10-2c75-f62e75aab919
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:98594851-46bc-6a10-2c75-f62e75aab919
msgctxt "h7eb8ace1g696bg4aeeg9bb7g204d0a88e329"
msgid "Hah!"
msgstr "하!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 9aa567c5-e4d6-e63a-67a7-d1d11d7c5516
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:9aa567c5-e4d6-e63a-67a7-d1d11d7c5516
msgctxt "h4c0fa6b0g251fg4f02g9c25g407d1c37992c"
msgid "...I'll just go and, eh..."
msgstr "...내가 가서, 그..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 9b03ccd4-72cd-e1e4-d258-7c0cf8e58d56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:9b03ccd4-72cd-e1e4-d258-7c0cf8e58d56
msgctxt "h00471410g31b0g472fgaf63gd0613bb3cb8e"
msgid ""
"Heh. You see that blighter go? Swallowed whole by the shadow curse. Bet he "
"was pure tasty."
msgstr "헤. 저 녀석이 간 곳 보여? 그림자 저주에 먹혀 버렸군. 맛있는 놈이었을 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Player
#. NodeID = 9b5b9923-e161-0eb2-2eb1-4fb8ba8252d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:9b5b9923-e161-0eb2-2eb1-4fb8ba8252d0
msgctxt "h1dab9b2eg6a52g468cg967dg1727a5d4a2ad"
msgid "What are you doing?"
msgstr "뭐해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint
#. Speaker = Warrior Gronag
#. NodeID = 9c21648d-e82c-510c-60c2-d9189b61cc10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinMelee_001_Checkpoint:9c21648d-e82c-510c-60c2-d9189b61cc10
msgctxt "h151bb26cg5635g4d7fg9e5cg8a40de02053b"
msgid ""
