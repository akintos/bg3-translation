#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:1b676049-88ca-445e-a497-556ef20aefa2
msgctxt "h48be4c0ag85c8g458cg97dfgd4679f179504"
msgid ""
"These flowers are surviving the curse. This is the sign Halsin said to look "
"out for."
msgstr "이 꽃들은 저주 속에서 살아남아 있어. 이게 할신이 찾아보라 했던 흔적이구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 1b676049-88ca-445e-a497-556ef20aefa2
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:1b676049-88ca-445e-a497-556ef20aefa2
msgctxt "h6aa84f56g4890g4de1g914agc837033f404f"
msgid "These are the flowers Halsin mentioned, right?"
msgstr "이게 할신이 말한 그 꽃, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 1b676049-88ca-445e-a497-556ef20aefa2
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:1b676049-88ca-445e-a497-556ef20aefa2
msgctxt "h4e2fd874g4d0bg448ag8597gfba9913b06f8"
msgid "Flowers blooming in shadow. This is the sign Halsin mentioned."
msgstr "그림자 속에서 피어나는 꽃들. 할신이 말한 흔적이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 99409534-b447-e930-26c0-17b85143d4eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = True
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:99409534-b447-e930-26c0-17b85143d4eb
msgctxt "ha15e78a9gd929g4b49g9545gdfd67417f4be"
msgid ""
"Wildflowers growing amidst the darkness. Thaniel's missing half must be near."
msgstr "야생화가 어둠 가운데서 자라나고 있군. 테니엘의 잃어버린 반쪽이 근처에 있는걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = c1b762c2-a419-3b4a-b6fa-c029b308cd1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:c1b762c2-a419-3b4a-b6fa-c029b308cd1f
msgctxt "h8725cba2gfb21g4eb2gbf57g53d6db2cf38a"
msgid "Unusual for a flower to grow among such decay."
msgstr "이런 부패한 땅에서 꽃이 자라는 건 드문 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = c1b762c2-a419-3b4a-b6fa-c029b308cd1f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:c1b762c2-a419-3b4a-b6fa-c029b308cd1f
msgctxt "hf399f61fgf126g4ae2gaf90gb6a30e68cc16"
msgid "Flowers? I'd expect them to wither in the curse."
msgstr "꽃? 저주에 시들어 버리는 건 시간 문제겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = c1b762c2-a419-3b4a-b6fa-c029b308cd1f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:c1b762c2-a419-3b4a-b6fa-c029b308cd1f
msgctxt "hf4967c65g9850g4011gb568g07498b398113"
msgid "Wildflowers in bloom... A welcome sight, but a strange one..."
msgstr "야생화가 피고 있어... 반갑지만, 기이한 광경이군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = c1b762c2-a419-3b4a-b6fa-c029b308cd1f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:c1b762c2-a419-3b4a-b6fa-c029b308cd1f
msgctxt "heb131decgb615g4f9eg9860ge46c3a05dc47"
msgid "How are wildflowers surviving here? Nothing else is growing..."
msgstr "어떻게 야생화가 살아남은 거지? 다른 건 자라고 있지 않은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = c1b762c2-a419-3b4a-b6fa-c029b308cd1f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:c1b762c2-a419-3b4a-b6fa-c029b308cd1f
msgctxt "hb88cddc2g2cd8g43c7gb8b9gb73e6dc255c9"
msgid "Flowers, sprouting right into the darkness. How's that possible?"
msgstr "꽃이잖아, 어둠 속으로 뿌리를 내리고 있다니. 이게 어떻게 가능한 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = c1b762c2-a419-3b4a-b6fa-c029b308cd1f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:c1b762c2-a419-3b4a-b6fa-c029b308cd1f
msgctxt "h9fa73ce7g785eg4f44g8d8ag84c64ac93a00"
msgid "Flowers. How? I thought the shadows ate everything alive."
msgstr "꽃이야. 어떻게? 그림자가 살아있는 건 몽땅 잡아먹은 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = c1b762c2-a419-3b4a-b6fa-c029b308cd1f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:c1b762c2-a419-3b4a-b6fa-c029b308cd1f
msgctxt "hdab8dac1g240dg49cfgb151g1f3906260a9b"
msgid "Flowers? How are they growing here, of all places?"
msgstr "꽃? 많고 많은 장소 중에서 어떻게 여기서 자라는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_AD_CreepyNoises
#. Speaker = Oliver
#. NodeID = 79511b1d-148f-7786-12bf-0448690583f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_AD_CreepyNoises:79511b1d-148f-7786-12bf-0448690583f2
msgctxt "h677c7b9cg7ec9g442bgb922gde95dbaea68f"
msgid "<i>Someone's coming. Someone new. Maybe they want to play.</i>"
msgstr "<i>누가 오고 있어. 새로운 사람이야. 같이 놀고 싶은가 봐.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_AD_CreepyNoises001
#. Speaker = UNKNOWN_CHARACTER
#. NodeID = 787bb7dd-6613-a954-0367-dfd8771a0cb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_AD_CreepyNoises001:787bb7dd-6613-a954-0367-dfd8771a0cb6
msgctxt "h308fb44fg0bedg4a86gb03bgd9f5ed78f06c"
msgid "<i>She was no fun. All I wanted was to play.</i>"
msgstr "<i>그 여자는 재미없었어. 난 그냥 놀고 싶었을 뿐인데.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_AD_OliverDeathScream
#. Speaker = Oliver
#. NodeID = 060728d5-b149-4e12-c3da-675f5b90fe8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_AD_OliverDeathScream:060728d5-b149-4e12-c3da-675f5b90fe8a
msgctxt "h8d20fb69gd87fg4f26g961egf83f9c4bca2b"
msgid "<i>Mummy! Daddy! Betsy! No - don't leave me!</i>"
msgstr "<i>엄마! 아빠! 벳시! 안 돼, 나만 두고 가지 마!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 00a0200a-e6ee-b218-6475-3e50e847fffb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:00a0200a-e6ee-b218-6475-3e50e847fffb
msgctxt "h039d4b0bg8752g4dd7g84adgad9c50798707"
msgid "This land needs you and Thaniel together, Oliver. Nature needs you."
msgstr "이 땅은 너와 테니엘이 함께 필요해, 올리버. 자연이 널 필요로해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 00ac9823-985e-a5d0-b8ca-cec4415d5249
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_State_LaidToRest = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:00ac9823-985e-a5d0-b8ca-cec4415d5249
msgctxt "h2012cf36g2cfdg4b26ga4adgf91adfc156de"
msgid ""
"You did better than most though, so I'll let you go. Here - second prize. "
"You'll need it."
msgstr "그래도 다른 친구들보단 잘했으니까 보내줄게. 자, 준우승상. 필요하게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 014b13d1-36bc-1458-0af6-8a0e18b3bfd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_RefusedOnce(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:014b13d1-36bc-1458-0af6-8a0e18b3bfd2
msgctxt "h51efe1bbg8da2g4e59g8cddgd6a40bad1413"
msgid "I'm Oliver. I'm seven."
msgstr "전 올리버라고 해요. 일곱 살이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 09d5fb50-87d7-be0b-f873-3d73c440305b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_LaidToRest = True
#.      - SCL_OliversDiary_State_FoundAgain = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:09d5fb50-87d7-be0b-f873-3d73c440305b
msgctxt "hf0661ce8gb341g4199g9566g57c4bc130c3e"
msgid "Not back to gloat, are you? Nobody likes a bad winner."
msgstr "비웃으러 돌아온 건 아니겠죠? 누구도 잘난 척쟁이는 좋아하지 않거든요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 0b22f3d8-c2d4-0b94-555e-65471f9ef89d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:0b22f3d8-c2d4-0b94-555e-65471f9ef89d
msgctxt "hf949c16egfadcg436dgbeb4g586156823606"
msgid ""
"They don't need names. They just need to be mummy and daddy, and do what I "
"want. Now play with me, or they'll be angry with you."
msgstr "이름 필요없어. 그냥 말하는 대로 해주는 엄마랑 아빠라구. 이제 놀자, 안 그럼 엄마아빠가 화낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 0d3c5143-d84a-e118-9a6f-952198e03500
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:0d3c5143-d84a-e118-9a6f-952198e03500
msgctxt "h187933a2g1892g4ee2gaba3g07261f9ff808"
msgid "Let's play another game - I deserve a chance to even the score."
msgstr "다른 게임 해요. 동점 기회는 주셔야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 0d93c65b-4195-1591-03ec-c566a57110fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_LiftingTheCurse_State_OliverAlerted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:0d93c65b-4195-1591-03ec-c566a57110fe
msgctxt "ha0e52b35g294eg4005ga8d5g3c4d3e19a870"
msgid "No -<i> leave me alone!</i>"
msgstr "싫어, <i>날 내버려둬!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 0e83eacf-fbc4-c707-684f-2d8389ccd99a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:0e83eacf-fbc4-c707-684f-2d8389ccd99a
msgctxt "hc39b6323g8a35g48dbg9317g068d16108101"
msgid ""
"Have you seen another little boy around here? He's called Thaniel - he's "
"very special."
msgstr "주변에서 다른 꼬마 본 적 있니? 테니엘이라고 하는데, 특별한 아이란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 1139c6dd-9d8a-adb2-d1c3-0865d4c0e9a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_RefusedOnce(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_OliversDiary_OliverShadow_Event_RefusedOnce(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:1139c6dd-9d8a-adb2-d1c3-0865d4c0e9a3
msgctxt "h05e5e8a1gf7ddg4e56g9d2bg1a6f87fdda01"
msgid "I don't have time for this."
msgstr "이럴 시간 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 1252961b-a4ea-9ed0-835a-5e91f0f4513c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:1252961b-a4ea-9ed0-835a-5e91f0f4513c
msgctxt "h1cad4b35ge68dg4261g9ca2g32ea632a55f8"
msgid ""
"<i>Another presence lingers near the boy. Study him, try to discern what it "
"is. </i>"
msgstr "<i>소년 주변에 다른 존재가 남아있다. 연구해서 무엇인지 알아낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 13c53217-fbca-b897-d0a0-505a19203c74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:13c53217-fbca-b897-d0a0-505a19203c74
msgctxt "h5c888febgeaabg42c2gb620gfbd562e95a39"
msgid ""
"I have a mummy, a daddy, and a doggy. They'll be back in a while. But you're "
"here now. And I want to play."
msgstr "엄마도 있고, 아빠, 강아지도 있어. 곧 올 거야. 지금은 네가 있잖아. 놀고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 164e16ac-ea84-8556-6fb9-894b6c9ca6f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:164e16ac-ea84-8556-6fb9-894b6c9ca6f6
msgctxt "h3db9ec9fg3ee2g4623g896bge98da66a370e"
msgid ""
"I still think you might have tricked me. If you did - I'll figure it out."
msgstr "아무래도 나를 속인 것 같은데. 걸리기만 해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 16c317f4-1a49-a04e-e82f-1bfc2834ebe3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:16c317f4-1a49-a04e-e82f-1bfc2834ebe3
msgctxt "h36456190ga819g452aga45cg0a6d3889a030"
msgid "I think we're done here."
msgstr "여기까지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 194c17d7-1f89-a86e-b3b0-fe1e7401e87f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_StartedHideAndSeek = True
#.      - SCL_OliversDiary_State_FoundOliver = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:194c17d7-1f89-a86e-b3b0-fe1e7401e87f
msgctxt "h6d2931e4g678cg427bg99e9g2c7ed4bb89e4"
msgid "I win! I win!"
msgstr "이겼다! 내가 이겼어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 1fa08826-cd2c-9caf-7be9-c4c605d73930
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_Event_OliverAppears = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:1fa08826-cd2c-9caf-7be9-c4c605d73930
msgctxt "hfff18071g1946g4e13ga8a6g29738efe9d35"
msgid "Will you play with me?"
msgstr "나랑 놀래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = 266ce5a2-34cf-e582-063c-adc66863f151
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:266ce5a2-34cf-e582-063c-adc66863f151
msgctxt "hf488682aga5ddg46d6gac16gbcbf475d20d8"
msgid ""
"*Below the layers of shadow and curse, you sneak a fleeting glance of this "
"creature's true nature.*"
msgstr "*그림자와 저주의 층 아래로, 이 존재의 본질을 짧게 엿봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = 27b120e1-8bc5-4fc2-12e7-f9a615e1e35f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:27b120e1-8bc5-4fc2-12e7-f9a615e1e35f
msgctxt "hdcc7ea02gc8cdg4ddbga3d5g84f2245f14a6"
msgid ""
"*Though shrouded in shadows, the child's resemblance to Thaniel is "
"unmistakable. This must be his dark half - warped by the curse.*"
msgstr "*그림자에 가려져 있지만, 아이와 테니엘은 명백히 닮았습니다. 저주로 인해 뒤틀린 그의 검은 반쪽임이 틀림없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 2919403a-e452-87e9-8af6-143d4bcbd611
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:2919403a-e452-87e9-8af6-143d4bcbd611
msgctxt "hf2adf699g87b6g459cga809gf5d64bf1b803"
msgid "Like it or not, you don't belong here."
msgstr "좋든 싫든, 여기는 네가 있을 곳이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 2c29763b-8eac-2687-d141-da90450fd86e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:2c29763b-8eac-2687-d141-da90450fd86e
msgctxt "h027176a1gbf06g4547gb465g4e41ea852ad1"
msgid "Go on. Find someone else to play with."
msgstr "가서 다른 상대나 찾아봐요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 2e72a614-36de-c7df-c83b-59e79d694b3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:2e72a614-36de-c7df-c83b-59e79d694b3c
msgctxt "hced99615g45d3g4b35ga835g548ffe16d217"
msgid "Don't startle people like that - easy way to wind up killed by mistake."
msgstr "그렇게 사람들 놀래키면 안 되지. 실수로 죽을 수도 있단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 32215f90-9fdf-9a04-87d6-cffef31e815f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_OliversDiary_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:32215f90-9fdf-9a04-87d6-cffef31e815f
msgctxt "ha368dc42g9fddg4c7bga9f4g1a95d8f3ad2f"
msgid "Boo! I scared you - I saw it. <i>Nobody </i>beats me at hide and seek."
msgstr "부! 놀랐지! 다 봤어! <i>아무도</i> 숨바꼭질로는 날 못 이겨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 3609c5e8-42bd-b1db-9000-0d159722bc56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_LaidToRest = True
#.      - SCL_OliversDiary_State_FoundAgain = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:3609c5e8-42bd-b1db-9000-0d159722bc56
msgctxt "h22328562g836cg44b9g9261g1a7ba65bb819"
msgid ""
"I won fair and square. There's no point in playing again - I want a "
"challenge."
msgstr "난 정정당당히 이겼어요. 다시 할 이유가 없죠. 흥미진진한 승부가 좋거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 3843a60f-70a8-8141-7690-cc2b4d67e5f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:3843a60f-70a8-8141-7690-cc2b4d67e5f2
msgctxt "h3e41fc74g9743g46a7g8ce1g1d38494ccb4d"
msgid "I don't know anyone called that. Don't ask me again."
msgstr "그런 녀석은 모르는데. 그만 물어봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 3b89aac6-2ca5-fd68-fab4-27c68e382c36
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = False
#.   Tag:
#.      - DRUID(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:3b89aac6-2ca5-fd68-fab4-27c68e382c36
msgctxt "hfd22d10bg2df7g4dfbgbf24g7834fdaf0b65"
msgid "<i>Study the boy. Try to understand his true nature.</i>"
msgstr "<i>소년을 조사한다. 그의 본질을 이해하려고 시도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = 3cbdc955-2132-7568-fbd1-230793fcf035
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:3cbdc955-2132-7568-fbd1-230793fcf035
msgctxt "h324db374g683dg41d7g90e3gd08357136b42"
msgid "*Something is amiss about the boy - but exactly what eludes you.*"
msgstr "*소년은 뭔가 잘못되어 있지만, 정확히 어떤 점이 그러한지는 알 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 421a04ee-3a46-9ca7-778b-92ab7b3c0184
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:421a04ee-3a46-9ca7-778b-92ab7b3c0184
msgctxt "h9597ec64g98ccg4644gb03dga388f1ea2323"
msgid "<i>A familiar magic exudes from this boy. Try to commune with it.</i>"
msgstr "<i>익숙한 마법이 소년에게서 흘러나오고 있다. 그것과 교감을 시도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = 48824cf0-1ed8-5033-8b29-82a279ffe0ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:48824cf0-1ed8-5033-8b29-82a279ffe0ec
msgctxt "h946b63b0g4748g43fag8b7ag1663a164553a"
msgid ""
"*Unlike your patron, the presence isn't seperate. It's more <i>part</i> of "
"the boy. You focus your gaze on him.*"
msgstr ""
"*당신의 후원자와는 다르게, 그 존재는 소년과 별개의 것이 아닙니다. 그것은 더욱이 소년의 <i>일부</i>입니다. 당신은 그를 유심히 "
"쳐다봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 4ac28877-f9ec-7fa4-d6f6-29114186e7ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:4ac28877-f9ec-7fa4-d6f6-29114186e7ea
msgctxt "h4b875160ga82ag478cga952g0ecdba7ffe0a"
msgid "No, I'm finished."
msgstr "이제 끝이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Jaheira
#. NodeID = 50a48414-f2d9-4f88-9cf7-7a8c33eed9a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_JAHEIRA(9) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:50a48414-f2d9-4f88-9cf7-7a8c33eed9a3
msgctxt "haced79aeg83dag490fg9318g7ad0758ca698"
msgid ""
"Fled back to the shadows, no doubt. Come out, boy, or this mean old Harper "
"might get cranky."
msgstr "그림자로 달아났어, 의심할 것도 없이. 나오렴, 꼬마야, 안 그러면 이 늙은 하퍼가 짜증 낼지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = 52fc6b3e-e5bf-c3be-b81e-986daaed8751
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:52fc6b3e-e5bf-c3be-b81e-986daaed8751
msgctxt "h500c771bg17b6g42a8gb745g33fe41b7963d"
msgid ""
"*Too many layers of shadow and curse obscure the familiar, latent magic of "
"the child.*"
msgstr "*겹겹이 쌓인 그림자와 저주가 시야를 흐립니다. 아이 안에 내재된 익숙한 마법이 뭔지는 알 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 533e533d-737e-ca78-2449-f81ddad68dcc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:533e533d-737e-ca78-2449-f81ddad68dcc
msgctxt "h4e08e4fdg5b33g4251g8950g0ea54d877233"
msgid "I can play you a little song  - would you like that?"
msgstr "노래를 한 곡 들려줄 수는 있는데 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 5966244b-3c7e-bc07-f911-ce64a624955a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:5966244b-3c7e-bc07-f911-ce64a624955a
msgctxt "h385ce977gfb7bg43e5g8763g8e13a875a35f"
msgid "What are your parents' names? Maybe I can find them."
msgstr "부모님 성함이 뭐니? 내가 한번 찾아볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 599b5cc4-477e-9d0c-ca0b-82df78ed1c2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:599b5cc4-477e-9d0c-ca0b-82df78ed1c2c
msgctxt "hdc8be1f5g842cg4ddagb152g67abf614681d"
msgid "I'm not going anywhere. I like it here. Now play with me, or else."
msgstr "난 아무 데도 안 가. 난 여기가 좋거든. 이제 나랑 놀든가, 다른 걸 하든가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = 5b76a28d-e454-a995-4fc6-d3a58a26a673
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_OliversDiary_OliverShadow_Knows_Family(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:5b76a28d-e454-a995-4fc6-d3a58a26a673
msgctxt "he1812362g517ag428agb959gb203a0707b1f"
msgid ""
"*The boy doesn't like these questions - because he has no real answers. And "
"perhaps no real family.*"
msgstr "*소년은 질문을 싫어하는 눈치입니다. 답할 말이 없으니까요. 가족도 진짜가 아닐지 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 5c648914-a771-fcf1-089f-37778a898886
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:5c648914-a771-fcf1-089f-37778a898886
msgctxt "h89225d1eg7839g44e2g9192g0a10848b75e3"
msgid "And if I don't find you?"
msgstr "만약 못 찾으면?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 5d3751a2-a605-d108-8241-387c1a73d44a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_State_FamilyHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:5d3751a2-a605-d108-8241-387c1a73d44a
msgctxt "h44e2fd9fgb6d8g4e5agae42gc02612cc4e12"
msgid "No!"
msgstr "싫어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 60f5ebea-022f-e529-5781-e968c55c212e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:60f5ebea-022f-e529-5781-e968c55c212e
msgctxt "h91a23f9bg9959g4f3bgbf46ge8ab691ef421"
msgid "You want to play? Fine."
msgstr "놀고 싶어? 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 6165e17a-f184-d642-33c0-3753bd23df8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:6165e17a-f184-d642-33c0-3753bd23df8a
msgctxt "ha68a1510gd06dg457cg9e5bg51e1bc1006af"
msgid "I've changed my mind. You're on your own."
msgstr "마음이 바뀌었어. 너 혼자 놀아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = 621d28da-5e02-3b79-9846-5586887a792f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_OliversDiary_OliverShadow_Event_ArcanaSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:621d28da-5e02-3b79-9846-5586887a792f
msgctxt "h113975c2g6fd3g40f6g8187g22e16a309991"
msgid ""
"*Not an ordinary child, but not a spectre either. One part of a greater "
"whole. Something ancient. And oddly... sad?*"
msgstr "*일반적인 아이가 아니지만, 망령도 아닙니다. 더 강대한 존재의 일부입니다. 고대의 무언가. 그리고 이상할 정도로... 슬픈?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 67f50af9-c6a4-216d-86d3-e339d1c9ddf6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:67f50af9-c6a4-216d-86d3-e339d1c9ddf6
msgctxt "h74fa9e8cg9318g4a5ega0bcg8dea83d6599f"
msgid "You're not my mummy - don't tell me what to do."
msgstr "우리 엄마도 아니면서 이래라저래라 하지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 67f50af9-c6a4-216d-86d3-e339d1c9ddf6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:67f50af9-c6a4-216d-86d3-e339d1c9ddf6
msgctxt "hfa2e8ee6geb8cg4b25gbf5ag68f9b0ddd804"
msgid "You're not my daddy - don't tell me what to do."
msgstr "우리 아빠도 아니면서 이래라저래라 하지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 67f50af9-c6a4-216d-86d3-e339d1c9ddf6
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:67f50af9-c6a4-216d-86d3-e339d1c9ddf6
msgctxt "h7dfe4ae6g37b4g44c5gba99g3e170c7879ea"
msgid "You're not my mummy or my daddy - don't tell me what to do."
msgstr "우리 부모님도 아니면서 이래라저래라 하지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 6972edbe-c3c9-a595-26e7-43dccdd24e69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:6972edbe-c3c9-a595-26e7-43dccdd24e69
msgctxt "h4703a6b7g86e2g4e72gaff9g6052678c7a18"
msgid "I think we're finished here."
msgstr "여기까지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 6b98a855-efe3-3788-febc-5de32f5fcfd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:6b98a855-efe3-3788-febc-5de32f5fcfd7
msgctxt "h0e4b2df3g60bdg49feg9b80gde8d4f2b7c5d"
msgid "Go on - leave me alone!"
msgstr "저리 가! 날 내버려 둬!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 6de4c6ca-5ded-5ee9-a99f-960c167b5985
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_StartedHideAndSeek = True
#.      - SCL_OliversDiary_State_FoundOliver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:6de4c6ca-5ded-5ee9-a99f-960c167b5985
msgctxt "h4a881ee0gdac9g47dbgb07egea8f783431af"
msgid "You weren't supposed to find me. You weren't supposed to win."
msgstr "찾으면 안 되는데... 이기라고 있는 게임이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Karlach
#. NodeID = 6fca726e-8ad4-413c-b3d7-d354adb802b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_KARLACH(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:6fca726e-8ad4-413c-b3d7-d354adb802b1
msgctxt "ha29e3ca9g4808g4d55g8270g29cb3274639a"
msgid "That little bastard - where'd he go?"
msgstr "그 좆만 한 녀석, 어디로 간 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 701f52e2-37cf-2e45-1a87-598be8792811
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_State_SecondRound = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:701f52e2-37cf-2e45-1a87-598be8792811
msgctxt "hcc03af08ga750g4ef6ga828g1bb6f2d983d3"
msgid ""
"Try to find me again - but my family will be looking for <i>you </i>at the "
"same time, so don't get caught!"
msgstr "다시 한번 찾아보시지. 하지만 이번엔 우리 가족도 <i>너</i>를 찾을 거야. 잡히지 않는 게 좋을걸!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 70e2eec1-2001-ad01-2284-a834a15f136c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:70e2eec1-2001-ad01-2284-a834a15f136c
msgctxt "h9f601eb5g2a8dg4a1agbd17gbb324270db10"
msgid ""
"I don't know what you mean. I'm just me. I have a mummy, a daddy, a pet "
"doggy."
msgstr "무슨 뜻인지 모르겠어. 나는 나야. 엄마랑 아빠, 강아지랑 살아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Lae'zel
#. NodeID = 7385d8ac-8928-4ba9-bf11-13880cec6b6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:7385d8ac-8928-4ba9-bf11-13880cec6b6e
msgctxt "h47b66508gd8e5g4d32g9fbag3427dbd11c01"
msgid ""
"Back to the shadows. After him, <i>ra'stil</i> - we need to see this through."
msgstr "그림자로 돌아갔군. 쫓아가자, <i>라스틸.</i> 우리는 이걸 끝까지 지켜봐야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 753d8cae-08c2-e5cf-1e9b-45f420b2f022
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:753d8cae-08c2-e5cf-1e9b-45f420b2f022
msgctxt "h557a0219g454eg49b1ga73eg7dbc817424d7"
msgid "Not harder - <i>impossible.</i>"
msgstr "어려운 게 아니야, <i>불가능해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 7a4f454a-41c3-5b09-ded7-da131109b172
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:7a4f454a-41c3-5b09-ded7-da131109b172
msgctxt "h59902a4bg2f98g457bg939ag4d7ce93e9dad"
msgid "You were too good for me."
msgstr "나는 상대가 안 되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Wyll
#. NodeID = 7dce49df-14b3-450d-8ec5-0bb898c371b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:7dce49df-14b3-450d-8ec5-0bb898c371b6
msgctxt "h53eab805g4264g48c9g9533g96f37feb5bf1"
msgid ""
"He's gone - and we need to follow. He'll feel the safest where the shadows "
"are deepest."
msgstr "떠났군, 쫓아가야 해. 그림자가 가장 짙어지는 곳에서 가장 안전하다고 느낄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 80f2b2d2-aedc-7c8a-ef7b-4ef34f916056
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:80f2b2d2-aedc-7c8a-ef7b-4ef34f916056
msgctxt "he8666413g964ag434bgbda4g7122e39b269c"
msgid "I know."
msgstr "저도 알아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 8177d2ae-e7b6-f387-7227-8d62d719f575
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:8177d2ae-e7b6-f387-7227-8d62d719f575
msgctxt "h5bc21dfegc945g4977g865egae5a294d4ef5"
msgid ""
"I know who you really are, and where you really belong. You need to reunite "
"with Thaniel."
msgstr "난 진정한 네가 누구인지, 어디에 속한 존재인지 알아. 넌 테니엘과 다시 하나가 돼야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 817ee988-2395-3734-229c-490b119514e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:817ee988-2395-3734-229c-490b119514e2
msgctxt "hef4f8c0ega945g446ag8ebbg5738bd092311"
msgid "Don't you have anyone else to play with?"
msgstr "너하고 놀 사람이 없니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 862ba6ae-79c8-95c3-6333-778ddfd183f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_State_FamilyHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:862ba6ae-79c8-95c3-6333-778ddfd183f2
msgctxt "hf0a2f7f1g764fg4d0fg8e5ege0ec31e16ee1"
msgid "<i>We're not finished!</i>"
msgstr "<i>아직 안 끝났어!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 8ac14918-630c-b3fb-50c8-527f02362ce7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:8ac14918-630c-b3fb-50c8-527f02362ce7
msgctxt "ha2731373ga7e2g4342gacb8gdf6395b5dc05"
msgid "Make time. I want to play. Or else."
msgstr "그럼 만들어. 놀고 싶단 말이야. 다른 것도 좋고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 8acdfd1a-845f-3468-40fa-a46e5e0496f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:8acdfd1a-845f-3468-40fa-a46e5e0496f7
msgctxt "ha8003e8cgd26ag41fcg8c89g46e6e35a6b2e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 8c6dcff2-eca6-9800-4a6d-559c21256d61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:8c6dcff2-eca6-9800-4a6d-559c21256d61
msgctxt "h1d956a55g213dg4bcfgac45g59eb37c300b0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = 8ed25893-8c9f-2ed0-460a-8414f39f6c47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:8ed25893-8c9f-2ed0-460a-8414f39f6c47
msgctxt "he6e72fa9g035eg4b1eg898cg78761779efde"
msgid "Now play with me."
msgstr "이제 나랑 놀자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 96aa95ad-9f29-350a-a59d-831d71693f4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:96aa95ad-9f29-350a-a59d-831d71693f4c
msgctxt "hafe9c650g09bag4697g9460g36551f5e7938"
msgid "Don't be a sore loser."
msgstr "징징거리지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 97d1f1de-d730-531c-d129-418c37efc06a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:97d1f1de-d730-531c-d129-418c37efc06a
msgctxt "he6b15b3dgcdecg42afgbf60gc2dc1dfdc2a1"
msgid "Don't make this harder than it needs to be."
msgstr "일을 쓸데없이 어렵게 만들지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = 98f904ca-44ec-e6ae-16a4-b71ed3400259
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:98f904ca-44ec-e6ae-16a4-b71ed3400259
msgctxt "ha35847d7g8860g4d00g9b54g41cc29607823"
msgid "Who are you?"
msgstr "넌 누구니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Halsin
#. NodeID = 9c66eaa3-e3d8-4f78-a4e6-480a8fc061b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:9c66eaa3-e3d8-4f78-a4e6-480a8fc061b9
msgctxt "hfdea8877gcb13g477fg9551g8923e7b88cbd"
msgid ""
"That's him - like an echo of Thaniel, remoulded by the curse. We need him, "
"if we're to put a stop to all of this."
msgstr "저 아이예요, 테니엘의 분신과 같은 아이. 저주로부터 탄생한... 저 아이가 필요해요, 이 모든 것들을 멈추려면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = a05ab46f-423b-9af3-daa0-bd2a93adb9d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:a05ab46f-423b-9af3-daa0-bd2a93adb9d8
msgctxt "h574fd0c4gd68fg4ce1g8e24g01059ee01010"
msgid "All right. I'll hide, and you seek."
msgstr "좋아. 내가 숨고, 넌 술래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = a332776f-9c85-74de-775d-d6ebe0f35a71
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:a332776f-9c85-74de-775d-d6ebe0f35a71
msgctxt "h989d89eegd4c6g429eg84a4g9b368b14f3ee"
msgid "<i>The child's ki feels... uneven. At odds. Why?</i>"
msgstr "<i>아이의 기가... 고르지 않아. 조화가 깨져 있어. 어째서지?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = a35400bc-1760-4af4-91ad-79d20f6798d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:a35400bc-1760-4af4-91ad-79d20f6798d0
msgctxt "hb3eb242eg0f18g447dgb984g5a94f2b2faec"
msgid "Yes I do. You can't make me do anything."
msgstr "맞거든! 그래서 네가 뭘 할 수 있는데, 흥."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = a49139df-41f4-9be7-600e-c9dd3278a819
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_RefusedOnce(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:a49139df-41f4-9be7-600e-c9dd3278a819
msgctxt "hbbf76c25gff94g4214gaa7bgcd80242dfdf1"
msgid "We're done here."
msgstr "여기까지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = a841a5ae-a38f-cca0-ad6e-b75cd2be6fbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:a841a5ae-a38f-cca0-ad6e-b75cd2be6fbf
msgctxt "h03141214g0741g46f7g9ceeg68e6ed1fd9bd"
msgid "You ruined my fun - I don't want to talk to you."
msgstr "네가 재미를 다 망쳤어. 너랑 얘기 안 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = a945767a-e950-4d95-4a74-b1324e76ad08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:a945767a-e950-4d95-4a74-b1324e76ad08
msgctxt "hfe949520gb255g4a8bgbf6egb4ec99f3ea2b"
msgid ""
"I'm not going back. I like it here - I've made a family for myself, I get to "
"play all the time."
msgstr "난 안 돌아가. 여기가 좋다고. 직접 가족도 만들었거든, 계속 놀 수도 있어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = b17c92ae-1083-220d-2a1c-1bf6a6b67cd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b17c92ae-1083-220d-2a1c-1bf6a6b67cd7
msgctxt "h34163bfcgd239g4719g8c3cgbb5816375a09"
msgid ""
"Killed? Nobody <i>dies </i>around here, silly. Not like that. Play with me, "
"and you'll see for yourself."
msgstr "죽는다고? 여기선 아무도 안 <i>죽거든</i>, 바보야. 그렇게는 말이야. 나랑 놀자, 그러면 직접 보게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = b1f81fc6-dd84-76a3-ee33-b3f6ec9ea0a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Knows_Family(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b1f81fc6-dd84-76a3-ee33-b3f6ec9ea0a6
msgctxt "h8a7a29f5g010eg45c9gbd18g7d4976677f1d"
msgid "Sorry, I don't think they're coming back. Want to come to my camp?"
msgstr "미안하지만, 부모님은 안 돌아오실 것 같구나. 내 야영지로 오련?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = b377568a-fe08-bb7d-a986-2a3e45cb9d15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = True
#.      - SCL_OliversDiary_State_SecondRound = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b377568a-fe08-bb7d-a986-2a3e45cb9d15
msgctxt "hfadb41fdgcfd2g4d4ag85bbg24c194c75102"
msgid "Hmph. You're good at this - are you sure you didn't cheat?"
msgstr "흠. 너무 잘하는데, 반칙 쓴 거 아니죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = b6dd68bd-4be2-6429-8b99-07852f3ea844
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b6dd68bd-4be2-6429-8b99-07852f3ea844
msgctxt "h1075bc3cg87d5g41c9g8916g905758236b63"
msgid ""
"I don't know what you mean. The shadows must be making your head go funny."
msgstr "무슨 말인지 모르겠어. 그림자 때문에 머리가 이상해진 게 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = b785b832-398d-ce8c-640c-5f70847b72ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b785b832-398d-ce8c-640c-5f70847b72ce
msgctxt "h5ad73ebdg5e30g40cbga46cg603120f0be8d"
msgid "I'm Oliver. I'm seven. Will you play with me?"
msgstr "난 올리버야. 일곱 살이고. 나랑 놀래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = b8c58d74-72e4-56ae-412a-cac967931a67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b8c58d74-72e4-56ae-412a-cac967931a67
msgctxt "hbf565b08gb05ag46b3ga67fg32af3b205257"
msgid ""
"In a moment maybe. Have you seen another little boy? His name is Thaniel."
msgstr "글쎄다. 주변에서 다른 꼬마아이 본 적 있니? 이름은 테니엘이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = b93b8d07-4a21-6368-488b-32e38423c568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b93b8d07-4a21-6368-488b-32e38423c568
msgctxt "h9bdcfa63g015cg4cd2g8e06g96d6128eaca3"
msgid ""
"<i>Play? </i>This is no place for a child - if that's even what you are."
msgstr "<i>놀자고? </i>여긴 아이가 올 만한 곳이 아니야. 너 같은 존재라 할지라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Narrator
#. NodeID = b9e1cf48-527b-8a0b-9a01-62b8c45a9bc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:b9e1cf48-527b-8a0b-9a01-62b8c45a9bc9
msgctxt "hf142a35bgfbadg446eg9d11g09df88759079"
msgid ""
"*Wherever Oliver has fled to, you have to pursue him. No doubt he will seek "
"a place where the shadows are strongest.*"
msgstr "*올리버가 어디로 도망쳤든, 당신은 그를 쫓아야 합니다. 그림자가 가장 강한 곳을 찾을 것이 분명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Shadowheart
#. NodeID = ba07383d-993d-46d8-b046-3ab97156768b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:ba07383d-993d-46d8-b046-3ab97156768b
msgctxt "ha46c2860g0824g464ag88a2gcefe57e0f022"
msgid ""
"He's scarpered. We'd better track him down - if the shadows don't stop us "
"first."
msgstr "달아났군. 추적하는 게 좋겠어. 그림자가 우리를 먼저 멈추지만 않는다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = bfc3710c-93c5-e48e-cb5c-323edccd86f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:bfc3710c-93c5-e48e-cb5c-323edccd86f2
msgctxt "hfa949b23g9e26g42a1gaa83g494c7e7d397f"
msgid "<i>No!</i>"
msgstr "<i>싫어!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = c2ae8fd5-4455-08da-8cab-6317cd088263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:c2ae8fd5-4455-08da-8cab-6317cd088263
msgctxt "ha16aea44g723eg42fbgbd89g0039c5dafaa4"
msgid "We're done when I say we're done."
msgstr "내가 끝났다고 해야 끝난 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = c9585086-600c-02a1-fc59-b0fea2300fc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_ArcanaSuccess(1) = True
#. TagRule: WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:c9585086-600c-02a1-fc59-b0fea2300fc6
msgctxt "hadb0cd9fg3601g4196g9e84g2c5386169fc3"
msgid ""
"You're quite clearly a magical anomaly, child. What's really going on here?"
msgstr "마법적 기현상인 것만은 분명하구나. 여기서 무슨 일이 벌어지고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = c9585086-600c-02a1-fc59-b0fea2300fc6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_ArcanaSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:c9585086-600c-02a1-fc59-b0fea2300fc6
msgctxt "h53e6db3cg1d0ag4488g93f4g6651bb87aa91"
msgid "You're not what you say you are. I can sense it."
msgstr "넌 네가 말하는 그런 존재가 아니야. 느낄 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = cc59e5b2-9b88-b4ec-c0e1-fb8f44f24740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:cc59e5b2-9b88-b4ec-c0e1-fb8f44f24740
msgctxt "h0e376360g70f1g4d9aga9deg45a010f16747"
msgid "Spoilsport."
msgstr "재미없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = cf351c58-2c5a-4981-40ce-1762fcbf9f4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:cf351c58-2c5a-4981-40ce-1762fcbf9f4e
msgctxt "h5a0016cag907ag45f3g9fd5g2d1d78c79774"
msgid "Let's play again - you might be able to even the score."
msgstr "한 판 더 해요. 분발하면 동점 딸 수 있을지도 모르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Gale
#. NodeID = d3e1e8fa-656b-4897-85c9-82ffa74c485b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:d3e1e8fa-656b-4897-85c9-82ffa74c485b
msgctxt "he3c54904gde29g4e11g903cg3e348dda2f8f"
msgid "He's scarpered - and I suppose it's up to us to find him."
msgstr "도망쳤군, 우리가 찾는 수밖에 없겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = d4f2c967-805d-eb61-99e5-775fedd1bb24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:d4f2c967-805d-eb61-99e5-775fedd1bb24
msgctxt "h0a620b38gd889g4961g9ae8gc482e3325679"
msgid "Find me, and you win."
msgstr "찾으면 이기는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = d51b3c62-88d9-501e-1af9-cbc0f41fecc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:d51b3c62-88d9-501e-1af9-cbc0f41fecc5
msgctxt "hcb0983b9g046fg45d4ga59dg59a60dba743a"
msgid "Then you lose."
msgstr "그럼 지는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = db9c00e4-e4a5-8e97-3feb-5cf9a4f195ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:db9c00e4-e4a5-8e97-3feb-5cf9a4f195ba
msgctxt "ha147414dg3e56g40bcg9031g247826471bab"
msgid "Let's play."
msgstr "그래 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = dfe43ea9-6645-2410-3f90-e54f4d880315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:dfe43ea9-6645-2410-3f90-e54f4d880315
msgctxt "h2138ae44g3f80g4a52g9c7bgfb2e27b4614a"
msgid "I don't want to play with you anymore."
msgstr "이제 너랑 놀기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = e0371f0c-6f72-7f9e-67f4-7255bb48e207
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_DefeatedAtHouse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e0371f0c-6f72-7f9e-67f4-7255bb48e207
msgctxt "h5a89d3c6ge09eg4c5agb6b7g262e230272c4"
msgid "No - <i>go away!</i>"
msgstr "싫어, <i>저리가!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = e142284c-4999-6dce-c76f-e0ee214fe6ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_RefusedOnce(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e142284c-4999-6dce-c76f-e0ee214fe6ba
msgctxt "hcb9bc432gef54g47a6g9c75g3331699a050f"
msgid "We're done here."
msgstr "그만하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = e159e5bc-bd0b-7b2c-6905-f28f88eb8d08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e159e5bc-bd0b-7b2c-6905-f28f88eb8d08
msgctxt "had266682g2a50g4677g9994g67b4bbf007b3"
msgid "Of course I am! Now are you going to play with me or not?"
msgstr "나는 되거든요! 그래서 나랑 놀 거예요 말 거예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = e362a9f9-0406-7513-a27c-064f1507a560
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e362a9f9-0406-7513-a27c-064f1507a560
msgctxt "h8e0a00c7g2d7cg4391ga719g63bacbe6b033"
msgid ""
"You shouldn't be nasty. You should just do what I want. It's easier for you, "
"that way."
msgstr "추잡한 짓은 안돼. 넌 내가 원하는 대로 해야 해. 그러는 편이 더 쉬울걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = e3ed0fcc-89fc-14c2-c2ea-03d65263a864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e3ed0fcc-89fc-14c2-c2ea-03d65263a864
msgctxt "h3dc3b285gf3acg4bdega8e7g0798cf63ad75"
msgid "<i>Lunge at him.</i>"
msgstr "<i>돌격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = e4e14f16-e537-ccdc-3127-616446675480
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e4e14f16-e537-ccdc-3127-616446675480
msgctxt "h8db1822fg120eg4c90g9e2bg6b91bcc5e82b"
msgid ""
"Good idea - you're smarter than some playmates I've had. They always tried "
"to leave before I was done with them."
msgstr "좋아. 이전 친구들보단 똑똑하네. 걔들은 언제나 끝나기 전에 떠나려 했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = e556c481-8190-de08-5cc9-a22b68f1b9ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e556c481-8190-de08-5cc9-a22b68f1b9ae
msgctxt "hfc0a5df7g5affg4a76ga023g9ac9c1f7e2b5"
msgid "We're finished when I say we're finished."
msgstr "내가 끝났다고 할 때까지 끝난 게 아니에요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = e5b21988-ca6d-8c66-f537-6c1a1cfa4db3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e5b21988-ca6d-8c66-f537-6c1a1cfa4db3
msgctxt "h3dc43e57g8696g4c8ag88ebgeb3cc270dfcd"
msgid "Let's play again."
msgstr "다시 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Astarion
#. NodeID = e7b647e9-f21d-4874-bf7e-12dc7ac07a45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e7b647e9-f21d-4874-bf7e-12dc7ac07a45
msgctxt "h25f11785gc1edg4e3cg9ff7g57685e23ad58"
msgid ""
"Slippery little bugger, isn't he? He'll be looking for somewhere safe - "
"somewhere where the shadows are nice and strong."
msgstr "약삭빠른 녀석이군, 그렇지? 안전한 곳을 찾고 있을 게 분명해, 그림자가 짙고 강한 곳으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = e7fd6136-e6e4-cf32-a112-f1a89809eb5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e7fd6136-e6e4-cf32-a112-f1a89809eb5a
msgctxt "h7432f3f2g63edg419fg9bd6gb224a4a8d39f"
msgid "All right. Let's begin."
msgstr "좋아. 시작하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = e801fc43-cff9-2bb5-d666-d57deca62e82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_ArcanaSuccess(1) = True
#. TagRule: WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e801fc43-cff9-2bb5-d666-d57deca62e82
msgctxt "hb06c5636g8296g4c29gbe31g6c2fcc174503"
msgid ""
"You're quite clearly a magical anomaly, child. What's really going on here?"
msgstr "마법적 기현상인 것만은 분명하구나. 여기서 무슨 일이 벌어지고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = e801fc43-cff9-2bb5-d666-d57deca62e82
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Event_ArcanaSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e801fc43-cff9-2bb5-d666-d57deca62e82
msgctxt "hb5d382f2gdf50g40cfgacf8gc32e21623646"
msgid "You're no ordinary little boy, are you? I can sense it."
msgstr "넌 평범한 작은 소년이 아니야, 그렇지? 느낄 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = e8436505-accf-f87f-53dc-6cac37945d08
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_State_LaidToRest = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e8436505-accf-f87f-53dc-6cac37945d08
msgctxt "hbccbe67dgaa54g445agb680gd50d335d1b69"
msgid ""
"But I can't let you think me a bad sport. Here's your prize. You'll need it."
msgstr "하지만 나는 나쁜 승부사가 아니니까. 여기 상품이요. 필요할 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = e923fd75-431c-5ce7-081d-3ce161f24f69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_OliversDiary_OliverShadow_Knows_Family(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:e923fd75-431c-5ce7-081d-3ce161f24f69
msgctxt "hd6bb4dc4gbc4dg417agbc88g1266e28cb0c0"
msgid "Face facts, kid. Your family's dead - and you might be too."
msgstr "현실을 직시하렴, 꼬마야. 너희 가족은 다 죽었어. 너도 마찬가지일 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = ec5229c3-c31d-b56b-7e6c-e60263910581
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = False
#.      - SCL_OliversDiary_State_SecondRound = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:ec5229c3-c31d-b56b-7e6c-e60263910581
msgctxt "h0c30a09fg0305g42ddgbf53g620a5fb059e9"
msgid "I win! I <i>always </i>win, in the end."
msgstr "내가 이겼다! 끝까지 가면 내가 <i>다</i> 이겨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = ef1ebd73-4308-f73b-324a-7cefe3addde7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:ef1ebd73-4308-f73b-324a-7cefe3addde7
msgctxt "h660a73ffg11bbg4d3bg982fg2a6461764602"
msgid ""
"He's not special - he's <i>nothing</i>. You shouldn't say that name. Forget "
"you ever heard it."
msgstr "하나도 안 특별해. <i>아무것도</i> 아니야. 그 이름 말하지 마. 다 잊어버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = f369187a-6de4-23f5-7d76-13a708837943
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_State_StartedHideAndSeek = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:f369187a-6de4-23f5-7d76-13a708837943
msgctxt "h3cf25ee4g8e52g434eg8c4cg6ae0604694b1"
msgid "Get ready - and no cheating."
msgstr "준비해, 그리고 반칙은 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Halsin
#. NodeID = f945b9a5-5c4e-495c-8828-ef8d38970ec8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_HALSIN(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:f945b9a5-5c4e-495c-8828-ef8d38970ec8
msgctxt "h1947d87cg7084g4360g856ag81c926ff628a"
msgid ""
"He's fled - we need to track him down. Wherever the curse is strongest, "
"that's where he'll go. That's where he'll feel safe."
msgstr ""
"도망쳤어, 우리는 그를 추적해야 해. 어디가 됐든 저주가 가장 강한 곳, 그곳이 올리버가 향할 곳이야. 그곳에서 안정감을 느끼겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = fa6e471a-f1ac-f266-f62d-e6e9a4023e48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:fa6e471a-f1ac-f266-f62d-e6e9a4023e48
msgctxt "hfb37e7c6g220dg4916g9960g66e67573652a"
msgid ""
"Not <i>that</i> kind of playing, silly - I want to play a game! It'll be "
"really fun, let me show you."
msgstr "<i>그런</i> 놀이 말고, 바보야. 난 게임이 하고 싶다고! 정말 재미있을 거야, 보여줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = fc3a64e7-59d5-5615-6c1b-4a7c8ed1d015
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = False
#. TagRule: WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:fc3a64e7-59d5-5615-6c1b-4a7c8ed1d015
msgctxt "hb6376df4g5e47g46fdg8512ge44a7552274f"
msgid "<i>A child? Here? Must be magical - but how? Study the boy.</i>"
msgstr "<i>아이라고? 이런 곳에? 마법적인 것이 분명해, 하지만 어떻게... 소년을 조사해 보자.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Player
#. NodeID = fc3a64e7-59d5-5615-6c1b-4a7c8ed1d015
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = False
#. TagRule: SORCERER
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:fc3a64e7-59d5-5615-6c1b-4a7c8ed1d015
msgctxt "hb6543429g89d2g4454g8b1dgf9b1d486340f"
msgid "<i>Unsual magic pours from the creature. What is it? </i>"
msgstr "<i>이상한 마력이 이 생물에게서 흘러나오고 있어. 이게 뭐지? </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Halsin
#. NodeID = fd61e224-fa61-908b-9dc9-c8be9518cd70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:fd61e224-fa61-908b-9dc9-c8be9518cd70
msgctxt "hccdfae3bg2db1g4dd1gb5bagbb7215b8cd94"
msgid "Let's make this quick. We need to reunite him with Thaniel."
msgstr "빨리 끝내자. 테니엘과 하나가 되게 해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow
#. Speaker = Oliver
#. NodeID = fe0b2296-6e45-b292-a665-3735eb05ad00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_OliverShadow:fe0b2296-6e45-b292-a665-3735eb05ad00
msgctxt "h3ef29b37g749eg47f8g8328gaad7bd3ea3ba"
msgid "You can't make me do anything I don't want to. I won't <i>let</i> you."
msgstr "넌 내가 하기 싫은 것을 하게 만들 수 없어! 그렇게 <i>두지</i> 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a39e622f-535b-ce65-18a6-2ddbb4891976
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a39e622f-535b-ce65-18a6-2ddbb4891976
msgctxt "h7c0a87c3ga0d5g468eg9432gc656090269d7"
msgid "Where is that spooky little brat?"
msgstr "이 소름 돋는 조그만 녀석 어디 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a39e622f-535b-ce65-18a6-2ddbb4891976
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a39e622f-535b-ce65-18a6-2ddbb4891976
#, fuzzy
msgctxt "h1827d56egce8bg4f7dg8d13gac11de2d35ba"
msgid ""
"Hells. I have better things to do than seek out unsettling little children."
msgstr "젠장. 소름 돋는 애 찾기보다 해야 할 일이 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a39e622f-535b-ce65-18a6-2ddbb4891976
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a39e622f-535b-ce65-18a6-2ddbb4891976
msgctxt "hf51d90e9g48acg4291g8e4dg8e527c621f18"
msgid "All right, kid, where the hell did you go?"
msgstr "자아, 꼬맹아. 대체 어디로 간 거니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a39e622f-535b-ce65-18a6-2ddbb4891976
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a39e622f-535b-ce65-18a6-2ddbb4891976
msgctxt "h9c76e222g6f2dg400bga0fcgd7edb7dd0ad5"
msgid "Where has the child gone? I am in no mood for games."
msgstr "아이는 어디로 간 거지? 놀이할 기분이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a39e622f-535b-ce65-18a6-2ddbb4891976
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a39e622f-535b-ce65-18a6-2ddbb4891976
msgctxt "h6b13f40ag90dfg4a64gbda2gbcc40ef8ecc3"
msgid ""
"Surely finding a little boy can't be that hard, even if he is... whatever he "
"is."
msgstr "조그마한 남자애 하나 찾는 건 별로 어렵지 않겠지. 사실 걔가... 뭐던 간에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a39e622f-535b-ce65-18a6-2ddbb4891976
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a39e622f-535b-ce65-18a6-2ddbb4891976
msgctxt "h290d4225g02d5g4f17g9c07gfc799f14983c"
msgid "He can't have gone too far. I'll find you, you little scoundrel."
msgstr "멀리 가지 못했을 거야. 널 찾아내 주마, 조그만 말썽꾸러기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a39e622f-535b-ce65-18a6-2ddbb4891976
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a39e622f-535b-ce65-18a6-2ddbb4891976
msgctxt "h38a7d413gf775g4c63g8b9bg1c249e83d8a8"
msgid "Where'd that child go? Or... whatever it is."
msgstr "그 애 어디로 간 거야? 애가 아니라 뭐던 간에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a57c5353-65b8-48f0-86bd-8cc8d10e920e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundOliver = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a57c5353-65b8-48f0-86bd-8cc8d10e920e
msgctxt "hce8e8275gf6c0g441dgb1e6g03a5c179f017"
msgid "There you are! Come out, little one."
msgstr "찾았다! 나오렴, 꼬맹아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a57c5353-65b8-48f0-86bd-8cc8d10e920e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundOliver = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a57c5353-65b8-48f0-86bd-8cc8d10e920e
msgctxt "h67f9b600g91f3g4526g96e3g614310b8c6d5"
msgid "Ah, I have you! Just a shame I don't want you."
msgstr "아, 찾았다! 그렇다고 내가 널 좋아하는 건 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a57c5353-65b8-48f0-86bd-8cc8d10e920e
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundOliver = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a57c5353-65b8-48f0-86bd-8cc8d10e920e
msgctxt "h8f0fa4aegfa83g492eg9838g087b06b437e9"
msgid "There you are! Got you!"
msgstr "찾았다! 잡았어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a57c5353-65b8-48f0-86bd-8cc8d10e920e
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundOliver = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a57c5353-65b8-48f0-86bd-8cc8d10e920e
msgctxt "h011eeb68g682fg4160g82dcg006cb7a4ab8a"
msgid "There you are. Enough games, cursed one."
msgstr "찾았다. 놀이는 끝났다, 이 저주받은 것아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a57c5353-65b8-48f0-86bd-8cc8d10e920e
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundOliver = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a57c5353-65b8-48f0-86bd-8cc8d10e920e
msgctxt "hfd154754g4d7dg461bg9a4eg5fc3dfe7e697"
msgid "Hello? Little... whatever you are - I know you're there. Come out."
msgstr "저기? 꼬마... 뭐든 간에, 거기 있는 거 알아. 이제 나와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a57c5353-65b8-48f0-86bd-8cc8d10e920e
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundOliver = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a57c5353-65b8-48f0-86bd-8cc8d10e920e
msgctxt "hb4d13340g742ag469bg9f4dgd4c07ade4325"
msgid "A-ha! The jig is up, kid."
msgstr "아하! 이제 끝이야, 꼬맹아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek
#. Speaker = Player
#. NodeID = a57c5353-65b8-48f0-86bd-8cc8d10e920e
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundOliver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliversDiary_PAD_HideAndSeek:a57c5353-65b8-48f0-86bd-8cc8d10e920e
msgctxt "h6df9cf54gfbcbg45fdg8236g58efa896840d"
msgid "There you are - come on out."
msgstr "찾았다. 이제 나와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD
#. Speaker = Player
#. NodeID = 4c6600d6-8327-490a-a0cc-06beecfb5b2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.   Object:
#.      - SCL_State_PickedUpSeluneIdol(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD:4c6600d6-8327-490a-a0cc-06beecfb5b2c
msgctxt "h4463bdb2g9d54g43c0gb558gf9abd663688e"
msgid ""
"Good craftsmanship wasted on Selûne. Maybe it can be repurposed somehow."
msgstr "이렇게 좋은 솜씨를 셀루네 여신상 따위에 낭비하다니. 뭐 다른 쓸모가 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD
#. Speaker = Player
#. NodeID = 8048ee77-a20c-032b-db90-ef35159399cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD:8048ee77-a20c-032b-db90-ef35159399cd
msgctxt "hdb620af7g891cg434bg9936g6765ed6ffde2"
msgid ""
"Hmm. You might find some use for that thing if it's melted down for "
"arrowheads, but that's all."
msgstr "흐음. 녹여서 화살촉으로 만들면 쓸만하겠는데, 아니면 쓸모 없는 물건이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD
#. Speaker = Player
#. NodeID = d46a45f4-b0bc-4353-804e-5933e85d7353
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD:d46a45f4-b0bc-4353-804e-5933e85d7353
msgctxt "hb9425c3fg184ag430fg8e37g4cb7d2fa293d"
msgid "A Selûne idol, really? Are you in need of a paperweight?"
msgstr "셀루네의 우상이라니, 진심이야? 누름돌이라도 필요한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD
#. Speaker = Player
#. NodeID = d743a499-6e97-ef47-5bae-86c8538a65d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_State_PickedUpSeluneIdol(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PIckedUpSeluneIdol_PAD:d743a499-6e97-ef47-5bae-86c8538a65d7
msgctxt "h09e78e0dgbbd4g4608g8e6cg804b22e2b621"
msgid "Gaudy thing. Maybe it can be sold for something more useful."
msgstr "요란한 물건이군. 팔아서 보다 유용한 물품을 구하는 데 쓰면 되겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PixieBell
#. Speaker = Player
#. NodeID = 02d5d825-6123-98d6-271f-25f004abe0df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Pixie_State_SaidCorrectAnswer(2) = False
#. SetFlags:
#.   Object:
#.     - SCL_Pixie_State_SaidCorrectAnswer(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PixieBell:02d5d825-6123-98d6-271f-25f004abe0df
msgctxt "heb3df649gcc73g4f34g92d1g691d9c014bc1"
msgid ""
"Oh, my lovely Dolly thrice who is so very sweet and nice - won't you assist "
"your humble friend so I won't meet my cursèd end?"
msgstr ""
"오, 돌리 애정하고 아끼는 내 벗이여, 유달리 다정하고 상냥한 내 친구여. 초라한 나그네를 가엾게 여긴다면, 오싹한 그림자를 가볍게 "
"막아주련?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PixieBell
#. Speaker = Dolly Dolly Dolly
#. NodeID = 057dcf26-7268-729e-0bbe-db3e3044d2e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PixieBell:057dcf26-7268-729e-0bbe-db3e3044d2e5
msgctxt "hc2ce0b43g2f81g47e5ga1d8gdb1afc435324"
msgid "Anything you wanna say?"
msgstr "하고 싶은 말 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PixieBell
#. Speaker = Dolly Dolly Dolly
#. NodeID = 0e296550-da03-70f5-0d4a-adae2750ad6f
