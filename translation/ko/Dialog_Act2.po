msgctxt "he4bc61eegf163g4149g9188gac3efffbcfff"
msgid "The shadows do not suffer our little flame."
msgstr "그림자는 우리의 미약한 불꽃엔 꿈쩍도 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 4ef4b11f-4366-4107-9062-539d468fc2b6
