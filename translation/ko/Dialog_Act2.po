#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:a47e09ce-16b7-4d72-b1ad-98812ce24d37
msgctxt "h31650c1agd085g4abcg89cfg64ac255af750"
msgid ""
"Always knew Marcus was a snake. You did well to knock the light out of him."
msgstr "마커스가 뱀같은 놈이란 건 항상 알고 있었지. 처치해줘서 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = aea607f5-dab4-474e-9c76-3e7702f4d275
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_1_Protected_HasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_FountainGuards_Melee_1_Protected_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:aea607f5-dab4-474e-9c76-3e7702f4d275
msgctxt "hd024c1ddg7230g445fg8f25gc583b68a9f9c"
msgid ""
"Gods, what I wouldn't give to be back in the Gate. Place like this makes you "
"miss home, eh?"
msgstr "젠장, 발더스 게이트로 돌아갈 수만 있다면 뭐든지 할 텐데. 이런 곳에 있다 보면 집이 그리워지기 마련이지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = b04234c2-cdb6-4220-a84d-6ada65dae074
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_1_Alert_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:b04234c2-cdb6-4220-a84d-6ada65dae074
msgctxt "h5da5a4a5g97beg4d33ga34bg23580d45be5d"
msgid ""
"If one of ours was a traitor, one of the Harpers might be too. It's always "
"the do-gooders, isn't it?"
msgstr "우리 중 하나가 배신자였다면, 하퍼들 중에도 있을지 모르지. 배신자는 늘 일 잘 하는 놈이지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = b8b74ed1-990a-89de-b702-4468cdc4b7c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcast_FountainGuards_Melee_1_Freed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:b8b74ed1-990a-89de-b702-4468cdc4b7c4
msgctxt "h70acda81gebc9g40c4g870fga9402dd11c4f"
msgid "Ready? It's time to take the fight to them."
msgstr "준비됐어? 그놈들이랑 결판을 낼 때야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = e26d5877-fe16-f552-85d7-c0c339a9eccb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_FountainGuards_Melee_1_MidAssaultHasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:e26d5877-fe16-f552-85d7-c0c339a9eccb
msgctxt "ha06315c3ge5a3g42dagb73agc71d726765f1"
msgid "We wouldn't have made it this far without you."
msgstr "네가 없었다면 여기까지 오지도 못했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = ee5e0870-4fb9-435b-adfc-d5a321eb7d3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_1_Unprotected_HasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_Unprotected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_FountainGuards_Melee_1_Unprotected_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:ee5e0870-4fb9-435b-adfc-d5a321eb7d3b
msgctxt "h251b7dafgeb0dg46b8ga4bfg7fa71174ce31"
msgid "Can't talk - shades might come clambering over the barricade any time."
msgstr "지금은 얘기 못 해. 그림자들이 언제든 바리케이드를 넘어올 수 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = f36401b2-694f-741a-7731-481ca75d3ce3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_FountainGuard_Melee_1_PostAssaultHasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:f36401b2-694f-741a-7731-481ca75d3ce3
msgctxt "hfe962dadg5414g4cf1g9fb2gb9a0e193ad1d"
msgid "Didn't expect Ketheric to retreat - not sure he has. Could be a trap."
msgstr "케서릭이 물러날 거라 생각도 못 했는데 - 실제론 아닐지도 모르지. 함정일지 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = f656c656-c848-0bd3-0855-261f813ba821
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_FountainGuards_Melee_1_MidAssaultHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:f656c656-c848-0bd3-0855-261f813ba821
msgctxt "h32bd3a43g8dbcg4877g985ag2c713ce0b5ab"
msgid "Ketheric's on the back foot. Ready for the final push?"
msgstr "케서릭은 이제 물러설 곳이 없어. 마지막 공격의 준비는 됐어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2
#. Speaker = Harper Essius
#. NodeID = 39f9cee5-fe9c-40c8-820d-83f661f36525
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_FountainGuards_Melee_2_Protected_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2:39f9cee5-fe9c-40c8-820d-83f661f36525
msgctxt "had10ce21g7009g48e5gaebag73371f86cc4b"
msgid "Go safely."
msgstr "조심해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2
#. Speaker = Harper Essius
#. NodeID = 5705f26a-0ed7-7ba9-4366-54456bbfa538
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_Started = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_FountainGuards_Melee_2_Freed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2:5705f26a-0ed7-7ba9-4366-54456bbfa538
msgctxt "hc376d8a4gddf2g4d13g8707g471a3c2952e8"
msgid ""
"With Jaheira to lead us, and you bringing light to the shadows, we might "
"just have a chance."
msgstr "자헤이라 님이 우릴 이끌어 주시고 당신이 그림자에 빛을 가져다 준다면, 우리에게도 기회가 있을지 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2
#. Speaker = Harper Essius
#. NodeID = 5beacd63-7563-4a31-b042-0e6e9c427eb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_2_Alert(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_FountainGuards_Melee_2_Alert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2:5beacd63-7563-4a31-b042-0e6e9c427eb4
msgctxt "h6aa539d0g3fdag45f4g9915ga296069b5b3e"
msgid ""
"The Flaming Fist may be a bit rough, but I've respected them. Didn't expect "
"a traitor in their ranks."
msgstr "좀 거친 자들이기는 했지만 플레이밍 피스트를 존중해 왔는데, 그 중에 배신자가 있을 거라고는 생각도 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2
#. Speaker = Harper Essius
#. NodeID = 9c4a8344-c119-4684-ab2a-e13508891502
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_2_Protected_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_FountainGuards_Melee_2_Protected_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2:9c4a8344-c119-4684-ab2a-e13508891502
msgctxt "h34afa8f5gffd8g48f6g9c16gf45441781df9"
msgid "Jaheira will see us through this matter. She always does."
msgstr "언제나 그렇듯, 자헤이라 님께서 이 문제를 해결해 주실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2
#. Speaker = Harper Essius
#. NodeID = a00f11a7-3c7f-4ca2-82db-32efc9e99441
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_2_Alert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2:a00f11a7-3c7f-4ca2-82db-32efc9e99441
msgctxt "h2889418bgcecfg4dfdg8478g16eb3e379045"
msgid "Let us pray we've had our last surprise."
msgstr "예상치 못한 상황은 이게 마지막이면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2
#. Speaker = Harper Essius
#. NodeID = c4bb64c0-5b5d-37a7-cf24-6726e88586fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_2_Freed_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_Started = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_FountainGuards_Melee_2_Freed_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_2:c4bb64c0-5b5d-37a7-cf24-6726e88586fb
msgctxt "h60ed0d8cgf26cg4f26g823bgb3a22a7eabd5"
msgid "It's time to fight back."
msgstr "되갚아 줄 시간이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Fist Ulthred
#. NodeID = 067900bb-55c6-1b3e-2ba0-f339700c6e4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:067900bb-55c6-1b3e-2ba0-f339700c6e4b
msgctxt "hb2b5b95dgc053g4287gbe8ag95529a08c08d"
msgid ""
"Hey. That's close enough. You ain't no Harper and you ain't no Fist. Don't "
"need the likes of you crashing our party."
msgstr "이봐. 거기 멈춰. 넌 하퍼도 아니고 피스트도 아니군. 너 같은 게 우리 작전을 망치는 건 사양하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Harper Essius
#. NodeID = 109f0175-23cb-b7f7-b12b-b7aa8e386f04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:109f0175-23cb-b7f7-b12b-b7aa8e386f04
msgctxt "hafcd83f8ge74bg486cg8fc5g87d3ed7d7ce5"
msgid "She's inside - one of the ground floor chambers."
msgstr "그녀는 안에 있어. 1층에 있는 방 중 하나에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Fist Ulthred
#. NodeID = 10f1fdd6-0a2f-2104-7177-6d7251c8b144
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:10f1fdd6-0a2f-2104-7177-6d7251c8b144
msgctxt "hefb13444g6765g44d0g8e4eg9d2baeb939a5"
msgid "Good. Wouldn't want to get it wrong in your eulogy."
msgstr "좋아, 네 놈 추도사에서 실수하고 싶지는 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Fist Ulthred
#. NodeID = 1a6f8651-d7d7-b0bc-6fe8-eb4473510bb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:1a6f8651-d7d7-b0bc-6fe8-eb4473510bb7
msgctxt "hc4e4aa92gcf82g4d1bgb5d4g55eb8d172d7a"
msgid ""
"If you're serious, go talk to his aide, Florrick. She's inside, "
"'strategising'."
msgstr "진심이라면, 그의 자문관인 플로릭에게 가봐. 안쪽에서, '전략을 짜고' 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Player
#. NodeID = 215936cf-220d-7c51-6c8e-9e7b65b8ee17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:215936cf-220d-7c51-6c8e-9e7b65b8ee17
msgctxt "hfe72ce0dg10dfg4e5fga1deg78cbf699db68"
msgid "Nah. Mind flayers don't really have names."
msgstr "뭐래, 마인드 플레이어에게 이름이 어디있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Fist Ulthred
#. NodeID = 2b9afa68-6875-3494-0ce8-a4cdbf5bb2ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Florrick_Event_RavengardInTowers = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:2b9afa68-6875-3494-0ce8-a4cdbf5bb2ef
msgctxt "h7671945bg289cg4493gad50g4e1164542ba9"
msgid ""
"Bastards torched the pig-sty we were staying in and made off with the Grand "
"Duke of Baldur's Gate himself."
msgstr "개자식들이 우리가 머물던 돼지우리 같은 곳에 불을 지르곤, <b>발더스게이트의 대공</b>님을 납치해 달아나버렸다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Player
#. NodeID = 35240d6e-73c5-da86-953e-c521ab1bb447
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:35240d6e-73c5-da86-953e-c521ab1bb447
msgctxt "h93e2410cgfa24g431bg904cg1ef85e1aa3ad"
msgid "Ah the Flaming Fist. You <i>don't </i>like people like me, do you?"
msgstr "아 플레이밍 피스트로군. 넌 나같은 사람을 <i>안</i>좋아하지, 안그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Fist Ulthred
#. NodeID = 35acef47-e968-6f0e-e65b-a767949b598e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_RevealedArtifact = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:35acef47-e968-6f0e-e65b-a767949b598e
msgctxt "h90436198gba00g439ag82d9gc81879106948"
msgid ""
"Hey. That's close enough. Artefact or no, I don't like the likes of you "
"crashing our party."
msgstr "이봐. 거기 멈춰. 아티팩트를 가지고 있건 말건, 너 같은 게 우리 작전을 망쳐버리는 건 싫다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Harper Essius
#. NodeID = 3b0356f7-b0be-94ec-7e63-4c8e6b2f0947
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay:3b0356f7-b0be-94ec-7e63-4c8e6b2f0947
msgctxt "hcd2736d5g8e1eg420ag9d5cg7f97982b5987"
msgid "See? Help needed, help offered."
msgstr "봤지? 도움이 필요한 곳엔, 도움을 주는 사람이 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_ThreeWay
#. Speaker = Harper Essius
#. NodeID = 3d64f80f-4e94-1780-68d8-5f5675da7186
#. HandlePath = TaggedText[0].TagText[0]
