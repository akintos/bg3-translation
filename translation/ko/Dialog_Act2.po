msgctxt "h56a3c5d4gf113g4743gbe55g6f8bcdb0a36d"
msgid "I fear we have given up the one advantage we had."
msgstr "우리의 유일한 이점을 포기해 버린 것 같다는 느낌이 드는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
