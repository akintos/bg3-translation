msgctxt "hb2a5e1f0gd74fg4c0eg9493g5eeb4dda5332"
msgid "Too big to be a spear wound - a horn?"
msgstr "창에 찔렸다기엔 상처가 너무 크군 - 뿔인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedTiefling
