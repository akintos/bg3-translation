msgid ""
"Three corpses sharing one personality. Who - or what - am I speaking to?"
msgstr "시체 셋이서 하나의 인격을 공유하는군. 난 누구, 혹은 무엇이랑 이야기하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_TadpoledSkeletons_Scouts
#. Speaker = Reconstituted Duellist
#. NodeID = 4a8e6773-3cc2-3413-3685-41f376a24218
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_TadpoledSkeletons_Event_ShadowsAttack = True
