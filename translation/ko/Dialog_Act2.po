msgctxt "h5c70380bgf49fg41e7g8764g1d8574a0ea5b"
msgid "*The nurse regards you, then disregards you.*"
msgstr "*간호사는 당신의 안부를 묻고, 당신을 무시합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003
#. Speaker = Sister Anya
#. NodeID = 1c84b226-20c3-444e-9684-63c2418e603b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_HasMet_Nurse003(1) = False
