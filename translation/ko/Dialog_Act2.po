#.     - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#. TagRule: SORCERER
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:f08bc0d9-ad44-6f28-eef6-c0b92950d7e3
#, fuzzy
msgctxt "h73224e1bg7a86g4665g848ag9e1302e3caa5"
msgid "No incantations, impressive. That sorcery came from within."
msgstr "주문 영창을 하지도 않다니, 대단한걸. 그 마법은 내면에서 흘러나온 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = f08bc0d9-ad44-6f28-eef6-c0b92950d7e3
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:f08bc0d9-ad44-6f28-eef6-c0b92950d7e3
msgctxt "h45c50288g4579g443ag8e91ge14ffd190e06"
msgid "That's a powerful spell. Where did you learn to do that?"
msgstr "강력한 주문인걸. 어디서 배운 거니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = f138d731-5a96-bf08-ed34-f36e5af9db87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:f138d731-5a96-bf08-ed34-f36e5af9db87
msgctxt "h758fe9afg0e26g4b7dg8b9cgb6b523b90d85"
msgid ""
"I don't trust no one 'sides myself, no more - save three. Mum, pops, and you."
msgstr "저는 저 자신을 제외하곤 아무도 믿지 않을 거예요. 세 명만 빼고. 엄마, 아빠, 당신."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = f68e825d-f714-2180-745a-5708542fbc1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:f68e825d-f714-2180-745a-5708542fbc1a
msgctxt "h350fc2f5g99b7g48cdgb29dg9f519e06006f"
msgid "And are you tough enough?"
msgstr "그래서, 살아남을 수 있겠니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = f8ced2b6-51b4-ecb8-3fcb-d0327f37e400
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:f8ced2b6-51b4-ecb8-3fcb-d0327f37e400
msgctxt "hb2d29051g101ag48ebg86f1gc5c23905e518"
msgid "Sure. The vine trick, at least. Maybe some others."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Wyll
#. NodeID = fb458b0c-d073-ad7e-9c0d-a4d97636883d
