#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:5dd35bcf-7ba7-5f83-73eb-c7d9c8a57b61
msgctxt "h02cacedbg4174g4170gb2ddg6a2cf1e1bdc2"
msgid "I seek your blessing."
msgstr "전 당신의 축복을 구합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Player
#. NodeID = 643fbd80-9f45-c410-2d01-383bb8180a35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_Barracks_Mistress_Knows_ThinksPlayerIsThrall(1) = False
