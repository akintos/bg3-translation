msgctxt "ha148372egff06g480bg9658g4c071d3b3cfd"
msgid "*Cackle*"
msgstr "*낄낄*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kitchen_AD_Gnoll001Howl
#. Speaker = 'Barnabus'
#. NodeID = e7ca2910-f212-4dfb-b114-157b6f1d3e40
