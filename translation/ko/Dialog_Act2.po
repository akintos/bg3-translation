msgctxt "h9b55c53fg94b9g4deag98e2gad7f6065c6a0"
msgid "*The beast shudders - a moment of pleasure...*"
msgstr "*짐승은 전율합니다... 기쁨의 순간입니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
