#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:00a125b2-3afc-4700-809c-d0ef2d383b3d
msgctxt "hb4e2c737g7657g4b1dgbec0ga1b6ae5d42f8"
msgid ""
"The shadows are draining me - I can't just walk through them like before."
msgstr "그림자가 날 붙잡으려 하는군 - 몸을 평소처럼 움직일 수가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "h8bb85a41g96dcg404fg80eeg1099f6170dee"
msgid "Urgh, this darkness is gnawing at me."
msgstr "으으, 이 어둠이 날 씹어먹으려 드는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "h607bfbbag4844g479cga4degb7acd0142977"
msgid "This darkness - it's too much. I won't last long like this."
msgstr "이 어둠은 지나치군. 이대로는 오래 버티지 못 하고 말 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "h25395f2bg7619g4059g8310g2fb5066ca180"
msgid "Agh... I'll be sucked dry of all life if I linger here..."
msgstr "윽... 꾸물거렸다간 잡아먹히고 말겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "hce3163a8gc5e9g4cbeg87ccg69354b07fbb8"
msgid "The shadows are hungry here. Doesn't seem to affect me though..."
msgstr "이곳의 그림자는 굶주린 모양이네. 나한테는 영향을 끼치지 않는 듯 하지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "h1fc27cf8g39a6g4bc5g97b7gcb8c4a3ce3bc"
msgid "<i>Ngh. </i>This bloody curse is sapping the life right out of me."
msgstr "<i>윽. </i> 이 빌어먹을 저주가 내 목숨을 위협하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "h9e702571gfeb5g46edgb5abg0526459c2687"
msgid "This isn't right. I feel like absolute shit in this darkness."
msgstr "젠장. 여기 있으니까 완전 똥통에 빠진 기분인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "hc11907a7g02f8g4452g95bbg72b9aa75335b"
msgid "The shadows are hungry here. I can feel them sapping my strength."
msgstr "이곳의 그림자는 굶주렸군. 내 힘을 앗아가려는 게 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 187d726c-3b4b-47dd-8946-b51fc8d4af68
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:187d726c-3b4b-47dd-8946-b51fc8d4af68
msgctxt "h492d52f7g83b2g4d28gba54gb05613cb1abb"
msgid "My energy's draining. The shadows are taking their toll."
msgstr "내 힘이 빨려나가는군. 그림자가 영향을 끼치고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 32aa4bac-7038-4204-96ef-3b6b4b40495c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(0) = True
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:32aa4bac-7038-4204-96ef-3b6b4b40495c
msgctxt "hd867cab5gdf69g4543g8eb3g01abc8e0c3e3"
msgid "The darkness is encroaching. Can't linger here - not like before."
msgstr "어둠이 좀먹고 있군. 전처럼 계속 머무를 수는 없겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 3bd911a5-9d47-4d24-b7c0-34083a66bbf1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:3bd911a5-9d47-4d24-b7c0-34083a66bbf1
msgctxt "h71ca5569g5d29g4dd3g96d3g781b830d887e"
msgid "The dark feels hungry - like it'd drain you dry."
msgstr "어둠이 굶주린 게 느껴져... 다 빨아먹을 기세야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 3bd911a5-9d47-4d24-b7c0-34083a66bbf1
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:3bd911a5-9d47-4d24-b7c0-34083a66bbf1
msgctxt "hb23345b3g44e5g4375ga5f2gdf882324210b"
msgid "The shadows... feels like they're gnawing at my very being."
msgstr "이 그림자가... 내 존재 자체를 갉아먹는 것처럼 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 3bd911a5-9d47-4d24-b7c0-34083a66bbf1
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:3bd911a5-9d47-4d24-b7c0-34083a66bbf1
msgctxt "h363433c2gcff7g4382gb6cdgc1808ee913a8"
msgid "I feel... cold. Miserable. What kind of dark is this?"
msgstr "느낌이... 추워. 비참하고. 무슨 어둠이 이렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 3bd911a5-9d47-4d24-b7c0-34083a66bbf1
#. HandlePath = TaggedText[3].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_A = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:3bd911a5-9d47-4d24-b7c0-34083a66bbf1
msgctxt "h738d91b1g4fbeg4f24gb8d9g6d650579fbb5"
msgid ""
"This darkness - it's <i>cursed. </i>I can feel it leeching the life from me."
msgstr "이 어둠은... <i>저주받았군.</i> 내 안의 생명이 빨려 나가는 게 느껴진다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 3bd911a5-9d47-4d24-b7c0-34083a66bbf1
