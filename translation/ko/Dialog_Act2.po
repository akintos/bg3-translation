#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_HavenOutcasts_DockGuard_Left_Ranger:37361452-f036-4730-8fed-0abdc92284f5
msgctxt "h44ecb263g3bc3g4e0cgbb5egce09b391b31e"
msgid "Anger. Something breaks above."
msgstr "분노다. 저 위에서 무슨 일이 일어난 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_HavenOutcasts_DockGuard_Left_Ranger
