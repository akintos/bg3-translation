msgctxt "h5b43a69agaec7g4ad0g871agdf24148a52fd"
msgid "<i>Unlock the restraints.</i>"
msgstr "<i>구속을 풀어준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Patient_AD
#. Speaker = Distressed Patient
#. NodeID = 31017113-2e7c-a561-56bf-6d433bed0457
#. HandlePath = TaggedText[0].TagText[0]
