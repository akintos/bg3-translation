msgid "Her voice... Absolute... promised..."
msgstr "목소리... 절대자의... 약속했어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_Zevlor_Dead
#. Speaker = Narrator
#. NodeID = d8518b75-d531-43f2-86f6-528519f7c4bc
