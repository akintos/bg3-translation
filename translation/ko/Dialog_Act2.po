msgctxt "h31625ac0gc507g4f0dgbee4g66e86a0ed58c"
msgid "I believe we've said all we have to say."
msgstr "할만한 얘기는 다 한 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Ox
#. NodeID = 2ab260ec-5089-d0fa-9870-1a4acbb2f260
