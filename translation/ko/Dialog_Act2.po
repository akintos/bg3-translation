msgctxt "h54e2e1afg0f60g4020gb4f4g93a7c632abc8"
msgid "Is anyone keeping an eye on those children from Elturel?"
msgstr "누군가 엘투렐에서 온 아이들은 감시하고 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
