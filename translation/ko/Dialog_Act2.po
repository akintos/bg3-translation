msgctxt "h47872e36g29ccg46e7g977cgf43d2b80edbd"
msgid "Be still darling. Let Sister Anya comfort you."
msgstr "얘야, 가만히 있으렴. 간호사 안야 님이 돌봐줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003
#. Speaker = Sister Anya
#. NodeID = 4c26716e-91e3-4bb5-b572-00d2b8735935
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_HasMet_Nurse003(1) = True
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003:4c26716e-91e3-4bb5-b572-00d2b8735935
msgctxt "h71021038g1d8eg46e7ga0f7g02c0fc8edd49"
msgid "Dear child, what is the matter? No one can hurt you here."
msgstr "얘야, 무슨 일이니? 여기선 아무도 널 해칠 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003
#. Speaker = Sister Anya
#. NodeID = fb6ee1fd-81be-4384-acfc-5d249d969e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003:fb6ee1fd-81be-4384-acfc-5d249d969e70
msgctxt "h82e09241gb29eg4ecfga85cgeec41d36d165"
msgid "Calm yourself, darling. I'm here to help."
msgstr "얘야, 진정해. 도와주러 왔으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 1a250036-faf5-4f67-aa79-04ce73fef111
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = False
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = False
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:1a250036-faf5-4f67-aa79-04ce73fef111
msgctxt "hcb92142dg8b70g4c4bg8cfag4c19a81b6246"
msgid "Can you feel it? The hurting?"
msgstr "느껴지니? 아픈 게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 1cba7852-06db-0b54-d7bd-db5a8d9f1b0a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:1cba7852-06db-0b54-d7bd-db5a8d9f1b0a
msgctxt "hc67a879cg60cag4440gaaf8gb79f7b082c78"
msgid "Come closer, child. Let me help you."
msgstr "가까이 오렴, 얘야. 내가 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 27f35345-9738-4d5d-9b6c-26b23b0b9b2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_SurgeonPermaDefeated = True
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:27f35345-9738-4d5d-9b6c-26b23b0b9b2a
msgctxt "h856903c0g6083g4245g9de1g690b71b2ed5e"
msgid "Come to me, darling. Where does it hurt?"
msgstr "얘야, 이리 오렴. 어디가 아프니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 36c1f84f-607c-4287-b07e-39d18c773fc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:36c1f84f-607c-4287-b07e-39d18c773fc3
msgctxt "hba2b220bg7ee9g436cga2cag7dadbfea12eb"
msgid "Bring me your sick, your lonely. In these hands, they are safe."
msgstr "병든 자, 외로운 자를 데려오세요. 저희 손에, 그들은 안전해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 567aa59b-2969-4316-c1f9-624c098be6a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:567aa59b-2969-4316-c1f9-624c098be6a1
msgctxt "h5bae34a4g1a92g4142g88a5gca441facbb3c"
msgid "Dear me, child - no need to carry on."
msgstr "아이야 - 계속할 필요가 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 6b1a3c57-8a10-6385-3ea1-65ee6e277ca6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = False
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = False
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:6b1a3c57-8a10-6385-3ea1-65ee6e277ca6
msgctxt "hf23231d3gc5b9g4283gb079g2cc5c4c01989"
msgid "Sleep, my child. It will be better when you wake."
msgstr "자요, 아이야. 일어나면 기분이 나아질 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 6b8608c8-50ec-22bb-ad5c-fe084a2a0aa9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:6b8608c8-50ec-22bb-ad5c-fe084a2a0aa9
msgctxt "h536da71bga415g4ff1g8d18g7c23e6b31a1d"
msgid "Show me where it stings, little one."
msgstr "어디가 따가운지 보여줘요, 아이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 6c44406a-cbab-4b28-b656-f5f584ebc238
