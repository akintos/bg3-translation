msgctxt "h9535f1bfg0872g4603g8887gc1c297549ad9"
msgid "That's no mere disc - it's a lift. We've found our way forward."
msgstr "저건 그냥 원판이 아니라 승강기야. 길을 찾았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 8d8d45ed-1d96-44da-a07a-5ef781d606be
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players:8d8d45ed-1d96-44da-a07a-5ef781d606be
msgctxt "h3eee7d22g53ddg4a4ag96c2g9dca995cd65e"
msgid "That thing looks mobile. Maybe it can bring us somewhere."
msgstr "저 물체는 움직이는 듯한데. 어디론가 데려다줄지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 8d8d45ed-1d96-44da-a07a-5ef781d606be
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
