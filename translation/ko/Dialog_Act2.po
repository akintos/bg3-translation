#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:2ba1a7f9-a276-26c1-7611-b8757d1d789e
msgctxt "h2d367afeg88bbg4335g86d8g3fe3a00b94f0"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 2bba5d27-c283-b8d3-490b-5c40071b9987
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DEBUG(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:2bba5d27-c283-b8d3-490b-5c40071b9987
msgctxt "h2beac35fgaf90g4dd9g88f5g85ddb26ca5f9"
msgid "I would like to change my appearance or class."
msgstr "제 외모나 클래스를 바꾸고 싶습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 2e3d45c3-de5f-19e1-9fb6-93ae7149f48a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:2e3d45c3-de5f-19e1-9fb6-93ae7149f48a
msgctxt "hc7039515gba87g4619gafe6g8a75269279d1"
msgid "There are depths to this alliance yet unplumbed. Consider, mortal:"
msgstr "이 동맹 속에는 아직 헤아릴 수 없는 심연이 있으니. 필멸자여, 생각해 보라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 3031eb75-67ca-ace3-b32c-b7296247b7a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:3031eb75-67ca-ace3-b32c-b7296247b7a9
msgctxt "hd80d9e3eg8a44g4b81gb73bgf005465eacea"
msgid "It is done."
msgstr "이루어 졌노라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 3087131a-f8d0-97cc-99da-c777c9db21d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#.   Object:
#.      - ORI_DarkUrge_State_KilledIsobel(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - SCE_Jergal_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:3087131a-f8d0-97cc-99da-c777c9db21d8
msgctxt "h9bd132dag69bfg4b25gb5e9g1439fc9d86ea"
msgid ""
"Selûne's light extinguished, thy hunger quenched. The scales tip, weighted "
"by blood thou spilt."
msgstr "셀루네의 빛은 꺼졌고, 그대의 굶주림은 가라앉았군. 그대가 흘린 피로 저울이 기울어졌구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 337778fe-cd98-cf55-3251-3518ab0810a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:337778fe-cd98-cf55-3251-3518ab0810a3
msgctxt "h9af76598g65aeg4911g8dc1g0710f0758369"
msgid ""
"Thou shalt think about it now, and I shall give the answer. Mind flayers are "
"soulless."
msgstr "이제부터라도 생각해보게, 내가 그대에게 답을 줄테니. 마인드 플레어들에겐 영혼이 없다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 33b48aa7-42f9-ffd8-b9ea-491ef3559744
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = False
#. SetFlags:
#.   Object:
#.     - SCE_Jergal_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:33b48aa7-42f9-ffd8-b9ea-491ef3559744
msgctxt "h433b8150gbff3g46c3ga00bga6d7e0901841"
msgid ""
"The shadows yet fester. The Dead Three, united under cover of darkness. The "
"balance shifts."
msgstr "그림자는 여전히 곪아가고 있구나. 어둠을 틈타, 삼악신이 뭉쳤으니. 균형이 흔들릴지어다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 37b716bb-e07f-9d2e-252b-bfaf854ef9cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Respec_Start(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:37b716bb-e07f-9d2e-252b-bfaf854ef9cb
msgctxt "h84f995e8g7ea7g48d5g89edg5634a7db9a53"
msgid "As thou desire."
msgstr "그대가 바라는 대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 3f416322-b195-099c-96a2-1d38c2b6481b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Hirelings_State_FeatureAvailable = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:3f416322-b195-099c-96a2-1d38c2b6481b
msgctxt "hca1709a3gfd62g4be3gaa9agb644cd3d718d"
msgid "I want to manage my hirelings."
msgstr "제 용병들을 관리하고 싶네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 407696cc-eb26-3bd4-1ac7-ee9411871e4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_NightsongShadowheartVisit = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:407696cc-eb26-3bd4-1ac7-ee9411871e4a
msgctxt "h2c31672dg8adeg448ag9c22g9243cfc9f40c"
msgid ""
"Thou knowest the answer to this already. The daughter of Selûne, whose blood "
"thou left unspilled, revealed long-hidden truths. Thou must win back that "
"which was taken."
msgstr ""
"그대는 이미 답을 알고 있다네. 그대가 직접 피 흘리지 않게 한 셀루네의 딸이 오랫동안 감춰진 진실을 밝혀냈으니. 그대는 반드시 빼앗긴 "
"것을 되찾아야 할지어다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 42c258c0-fd9b-6942-2f65-1ff5e1e8d89b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:42c258c0-fd9b-6942-2f65-1ff5e1e8d89b
msgctxt "hc4f066afg46ffg48a8ga65egde8ad748b231"
msgid ""
"Should thou or any of thy compatriots perish, I will cleave soul to body "
"once more."
msgstr "그대나 그대의 동료가 죽게 되면, 내가 영혼을 육신에 다시 한 번 결합해 주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
