#.     - 44060298-4dbf-d240-f4ac-efdffab5e199_HAV_HavenOutcasts_RoofWatcherCaster_HasMet_Freed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster:11310101-1499-ba93-db45-42b1ca71a00d
msgctxt "h537504a8g222bg4b9eg8340g6834f508e9df"
msgid "Did you see the light overhead? Glorious."
msgstr "저기 지나간 빛 봤어? 찬란하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster
#. Speaker = Harper Terradissia
#. NodeID = 4c159f2c-827e-9c46-e474-ddb3aaa0b16a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.   Local:
#.      - 44060298-4dbf-d240-f4ac-efdffab5e199_HAV_HavenOutcasts_RoofWatcherCaster_HasMet_Freed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster:4c159f2c-827e-9c46-e474-ddb3aaa0b16a
msgctxt "h2e68e5c0g3215g4a12ga133g546701158842"
msgid ""
"If the cultists try to snatch this place while you're at Moonrise, we'll "
"fight them off."
msgstr "네가 문라이즈에 가 있는 동안 광신도들이 여길 빼앗으려 들면, 싸워서 쫓아낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster
#. Speaker = Harper Terradissia
#. NodeID = 660d8fd1-bbd3-4f4f-a605-84f00058e857
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Protected = True
#.   Local:
#.      - 44060298-4dbf-d240-f4ac-efdffab5e199_HAV_HavenOutcasts_RoofWatcherCaster_HasMet_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster:660d8fd1-bbd3-4f4f-a605-84f00058e857
msgctxt "h5dc4fa37g3014g422ag8345g1dc32c5ec31c"
msgid "I'd rather be up here than drowning in the dark."
msgstr "어둠 속에 잠겨 죽느니 이 위에 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster
#. Speaker = Harper Terradissia
#. NodeID = b1103db0-9c04-4a06-8094-b64dcd36ce41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Local:
#.     - 44060298-4dbf-d240-f4ac-efdffab5e199_HAV_HavenOutcasts_RoofWatcherCaster_HasMet_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster:b1103db0-9c04-4a06-8094-b64dcd36ce41
msgctxt "h11614cf8gb1adg40c8g9215g7e0ffdab2202"
msgid "Can't trust anyone anymore - and that includes you."
msgstr "이젠 아무도 못 믿어, 너도 포함해서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster
#. Speaker = Harper Terradissia
#. NodeID = c12d7746-8465-4f61-b5a8-735e606199ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Local:
#.     - 44060298-4dbf-d240-f4ac-efdffab5e199_HAV_HavenOutcasts_RoofWatcherCaster_HasMet_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster:c12d7746-8465-4f61-b5a8-735e606199ce
msgctxt "h7be6f46cgf9b6g43a3g9db1gab612c7f7cd1"
msgid "From up here, you can almost pretend Isobel's light is the sun."
msgstr "이 위에서 보면, 이소벨의 빛을 태양마냥 느낄 수 있다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster
#. Speaker = Harper Terradissia
#. NodeID = c204a1b8-b640-4282-afb3-8998a7b60aee
