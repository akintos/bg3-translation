#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:9f60a053-d04d-45d6-ab0a-aa19d3db02bc
msgctxt "h28b55233g2142g4105gbdf4g708917fc091a"
msgid "Fewer lights in the darkness now."
msgstr "그나마 있던 빛이 더욱 줄어들었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
#. NodeID = bb8ef48f-624f-4ea5-923d-98c25e3029e6
