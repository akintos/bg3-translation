msgctxt "hfb18d728g8056g4df7g8df3gdc15d15280bd"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 81686fe9-8736-a0dc-ffea-d79f6a8ddbaa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - Hirelings_Event_RefreshHirelings(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:81686fe9-8736-a0dc-ffea-d79f6a8ddbaa
msgctxt "hf8c0f390g3624g4c71g8d74g8a8f92684fc2"
msgid "I would like to dismiss a hireling."
msgstr "용병을 해고하고 싶습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 82fec722-afe3-be31-2808-8055bab97147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:82fec722-afe3-be31-2808-8055bab97147
msgctxt "hcee9c1a7gc5d9g4b78g9ff5g04a1e596c385"
msgid "Changed my mind. They can stay dead for now."
msgstr "생각이 바뀌었어요. 지금은 죽어 있으라고 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 8488ab2a-6cba-9739-70eb-4cf0021d53e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Hirelings_State_Hired_1 = False
#.      - Hirelings_State_Hired_3 = False
#.      - Hirelings_State_Hired_2 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:8488ab2a-6cba-9739-70eb-4cf0021d53e2
msgctxt "hd155f73dg94dbg47adgbc23gc198d6cbb847"
msgid "There is no one to dismiss."
msgstr "해고할 용병이 없다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 84bcdb35-5276-b95e-8c6f-c511793b0a5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCE_JergalDebrief_Event_WhyHere(1) = False
#.      - CHA_Jergal_HasMet(1) = True
#.      - CAMP_Jergal_HasMet(1) = False
#. SetFlags:
#.   Object:
#.     - SCE_JergalDebrief_Event_WhyHere(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:84bcdb35-5276-b95e-8c6f-c511793b0a5b
msgctxt "h3b0a6353g3eaeg400eg8b12g9c158bd7e73e"
msgid "Forget that. What are you doing here, Withers?"
msgstr "그 얘긴 됐어요. 여기서 대체 뭐하시는 겁니까, 위더스?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 850fa1e2-09cd-8d8a-4a9c-766a931e7dc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_IsDead = False
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - SCE_Jergal_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:850fa1e2-09cd-8d8a-4a9c-766a931e7dc9
msgctxt "h8e9f7ee4geb55g4f21g85efgca36e45b65d2"
msgid "Thy hunger denied. Selûne's faithful yet shines. The balance shifts."
msgstr "그대의 굶주림을 억제했구나. 셀루네의 신자가 아직 빛나느니. 균형이 흔들릴지어다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 857a8756-520c-9f4a-63df-a0541ee9b30e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:857a8756-520c-9f4a-63df-a0541ee9b30e
msgctxt "h840e5823g6539g4fa3g8dd2gdb81c791c2fb"
msgid "Once judged, ascended, then vanquished, as one and as three."
msgstr "한때 셋이자 하나로서 심판 받았으며, 승천했고, 패배했던 이들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 8594997c-37f3-b7c7-f91d-6b639b00f40d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:8594997c-37f3-b7c7-f91d-6b639b00f40d
msgctxt "h39baaacfgd90cg4aeeg87c7g2cb40c0da6a3"
msgid "Well counted. I recommend keeping thy distance for a moment."
msgstr "잘 받았다네. 잠시 나와 거리를 두는 게 좋을 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 86bc3286-3fab-a5cd-f9fe-e0f88b225411
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_SHARPATH(1) = True
#. SetFlags:
#.   Object:
#.     - SCE_Jergal_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:86bc3286-3fab-a5cd-f9fe-e0f88b225411
msgctxt "h24b53431g514cg4ac2ga610g0bd9b845f249"
msgid ""
"One goddess mourns her daughter, slain by thy hand. Yet her sister rejoices "
"in the blood, and bestows honours upon thy head."
msgstr "한 여신은 그대의 손에 살해 당한 딸을 애도하는구나. 허나 그 동생은 그 피에 기뻐하며, 그대의 머리에 영광을 씌워주나니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Narrator
#. NodeID = 87b418e5-7cf4-fdc0-ef61-45537526bc6d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 932401b1-7763-7fd7-bee1-8731fe62084f_DeadThree = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:87b418e5-7cf4-fdc0-ef61-45537526bc6d
msgctxt "h1b643807gf594g41a2ga07fgff6031622011"
msgid ""
"*The Dead Three. Myrkul, Bane, and Bhaal - lords of deathly tenets, and "
"traitors to Ao, god of gods.*"
msgstr "*삼악신. 머큘, 베인, 그리고 바알. 신들의 신 Ao에게 반기를 든 죽음의 교리를 관장하는 군주들입니다. *"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 87fe59f0-cb89-9fb9-2326-d29f297b726b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:87fe59f0-cb89-9fb9-2326-d29f297b726b
msgctxt "h9658a5fbg3a4ag4587ga0a1g9c7b756370d4"
msgid "No. Thy coinpurse is near empty."
msgstr "안 된다네. 그대의 지갑이 거의 비었잖은가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 8a95ef19-1afc-6921-be75-7ed717c3ee55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCE_Jergal_HasMet(1) = True
#. SetFlags:
#.   Object:
#.     - CHA_Jergal_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:8a95ef19-1afc-6921-be75-7ed717c3ee55
msgctxt "h8057d6c3g513bg4e12gaf7dg4827d4cb1161"
msgid "Fate spins along as it should. Hast thou need of my services?"
msgstr "운명은 순리대로 흘러가고 있으니. 내 도움이 필요한가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 91319d01-1130-aa9c-cf58-fd45aaa49b19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:91319d01-1130-aa9c-cf58-fd45aaa49b19
msgctxt "h8affefd7g430fg4970ga1b0gb0bc60a5958a"
msgid "The Dead Three stand united. Shalt thou have the strength to face them?"
msgstr "삼악신이 힘을 모았구나. 그대는 그들에게 맞설 힘을 가지고 있는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 94cc8051-adf2-b351-d2ec-663a3872bc8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:94cc8051-adf2-b351-d2ec-663a3872bc8f
msgctxt "hd551082eg4331g49dbg85bagf2f5cd234c81"
msgid "These abominations are soulless, surely."
msgstr "그 혐오스러운 것들은 영혼이 없을 겁니다, 확실해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Narrator
#. NodeID = 95d64f92-187a-5290-6453-7788c7b23374
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:95d64f92-187a-5290-6453-7788c7b23374
msgctxt "h94e7ec6dgad8bg451dgaf71g7ed75fe4cc72"
msgid ""
"*All three sowed chaos at the height of their power. And all three now walk "
"the planes as mortals - or so it's believed.*"
msgstr ""
"*세 신은 그 힘이 가장 강대하던 때에 혼돈을 야기했습니다. 그리고 이젠 셋 모두 필멸자 처럼 차원들을 거닙니다. 또는 그렇다고 일컬어 "
"집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 9c6bafa3-e10f-52c5-7fe9-d56d8efba23d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:9c6bafa3-e10f-52c5-7fe9-d56d8efba23d
msgctxt "hc6181dbdg1bdbg475eg98a1g6dae66a992d9"
msgid "Then thou must provide the proper payment."
msgstr "그대는 반드시 적절한 대가를 지불해야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 9cf5a44b-bbae-2863-470f-a30ea348e89d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCE_JergalDebrief_Event_TalkRiddles(1) = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#. SetFlags:
#.   Object:
#.     - SCE_JergalDebrief_Event_TalkRiddles(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:9cf5a44b-bbae-2863-470f-a30ea348e89d
msgctxt "h3b49ffd3g5823g4948g99f0ga1d36d8b70b5"
msgid "Speak plainly. Isn't there more you can tell me?"
msgstr "털어놔요. 제게 더 말해줄 게 있지 않나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = a31b02bb-4eff-d62f-df9e-7bf3c54893d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_MaxPlayerCountReached = False
#.   Tag:
#.      - AVATAR(1) = True
#. SetFlags:
#.   Object:
#.     - Hirelings_Event_StartCC(1) = True
#.     - GEN_TransferNPCPayment_3(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:a31b02bb-4eff-d62f-df9e-7bf3c54893d9
msgctxt "h8ce46162g3a05g48f2gb9ccg3c8aea438ec2"
msgid "Choose."
msgstr "선택하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = a4beb0d0-96cb-37ee-86ad-5942f19c3707
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:a4beb0d0-96cb-37ee-86ad-5942f19c3707
msgctxt "h3d7636f8g53d1g4b88gaed1g06bb332bba12"
msgid "Do illithids possess souls?"
msgstr "일리시드에게는 영혼이 있는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = a54677ac-8eb5-96ed-5f55-28e3fe623913
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:a54677ac-8eb5-96ed-5f55-28e3fe623913
msgctxt "h6223d43fg85dfg4dc6gaf24g5cbb2d04024f"
msgid "Dost thou require anything else?"
msgstr "다른 것이 또 필요한가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = ad3b8a4a-8ff8-6ca4-d786-c149c015c79e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCE_JergalDebrief_Event_WhyHere(1) = False
#.      - CHA_Jergal_HasMet(1) = True
#.      - CAMP_Jergal_HasMet(1) = True
#. SetFlags:
#.   Object:
#.     - SCE_JergalDebrief_Event_WhyHere(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:ad3b8a4a-8ff8-6ca4-d786-c149c015c79e
msgctxt "hbc9ffdcdg7b7bg415cgbce7gef08955ae571"
msgid "I'm surprised to see you. Why are you here?"
msgstr "여기서 보게 돼서 놀랐네요. 왜 여기 계신 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
