msgctxt "h2635b839g6f90g4f9fg840dg816c89d0ab67"
msgid "Whatever that thing is, it's not going to last much longer."
msgstr "이게 뭐든 간에 그리 오래 버티지는 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes
#. Speaker = Karlach
#. NodeID = 71ca0598-79af-403f-a5cb-ae4d4aa85df5
