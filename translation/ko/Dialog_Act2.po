#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:3ebf7e51-a3e2-490a-9d72-243ac594b3e6
msgctxt "h404e1a98g4e86g4e2bgbf8dg6537dc6f7325"
msgid "The <i>noise</i>. I must leave - get to the boat. Now!"
msgstr "<i>소리</i>가 들려.여기서 떠나야 해, 당장 배로 가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = 4adbd412-5bb4-f864-ac61-936fa2cf70d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_ForceBoatLeave = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:4adbd412-5bb4-f864-ac61-936fa2cf70d7
msgctxt "hb11e73e3gadc7g44f6gbee4g741424c7488c"
msgid "It is done. Go - GO."
msgstr "이제 끝났어, 어서 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = 5085a3bf-5372-41ef-b86b-47b7f13335c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADBoatMissed(0) = True
#. SetFlags:
