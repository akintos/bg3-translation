#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "h3c1cc97dgae6eg48d0ga711g163c261b49a0"
msgid "Unpowered. Wonder what it's lacking..."
msgstr "전원이 꺼져 있군. 무엇으로 채워질지 궁금한걸..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = False
#.      - COL_RegenStation_State_CheckSuccess = False
#. SetFlags:
#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "h243da7deg1263g4231gac46g66d21f03c7a6"
msgid "No power. How does this work?"
msgstr "동력이 없군. 어떻게 작동시켜야 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = False
#.      - COL_RegenStation_State_CheckSuccess = False
#. SetFlags:
#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "hd3826572g8391g43c3gb96fg323e1df1833e"
msgid "Won't work. How do we get it running?"
msgstr "작동하지 않아. 어떻게 굴러가게 만들지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = False
#.      - COL_RegenStation_State_CheckSuccess = False
#. SetFlags:
#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "hccc41e16g321eg48c5gbf18g6dcf21a84399"
msgid "Inactive. It must need a power source."
msgstr "비활성 상태다. 어디선가 동력을 공급해야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = False
#.      - COL_RegenStation_State_CheckSuccess = False
#. SetFlags:
#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "h54c917c8g7c38g4986g80ebgeb1901830c05"
msgid "Not working. How is this thing powered?"
msgstr "작동하지 않잖아. 어떻게 전원을 켜면 좋지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = False
#.      - COL_RegenStation_State_CheckSuccess = False
#. SetFlags:
#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "h8b26c47fgbda1g4b1ag8c88g42b4b046f755"
msgid "Hm - dead as door hinge."
msgstr "흠 - 돌쩌귀만큼이나 움직이지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = False
#.      - COL_RegenStation_State_CheckSuccess = False
#. SetFlags:
#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "hd38c1b55gc30eg42a3g94c7g3575958db918"
msgid "It seems to be inert. Are we supposed to wake it up, somehow?"
msgstr "비활성 상태인 것 같군. 어떻게든 깨우는 편이 좋겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = False
#.      - COL_RegenStation_State_CheckSuccess = False
#. SetFlags:
#.   Global:
#.     - COL_RegenStations_State_UsedOnce = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD:f941e883-b0c6-2be6-cf2f-f4d710cb521c
msgctxt "h6b1d0ab2gc9c9g47e5g99c2gddfd80ef1955"
msgid "Inactive. What powered the one on the nautiloid?"
msgstr "비활성 상태다. 노틸로이드의 동력으로 삼을 만한 게 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "h9ecfd6c3g23adg4aafgb8bdge6b982dcb05d"
msgid "Ow! That... took something. <i>And </i>it hurt."
msgstr "아야! 그게... 무언가를 건드렸어. <i>그리고 </i> 따끔했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "h301519dfgb039g4e1egb8fcg86d3f709f8be"
msgid "<i>Ngh.</i> Well - it could have been worse."
msgstr "<i>윽.</i> 좋다 - 생각만큼 나쁘지는 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "hca858693g912bg4a16gb27bg6ed4f40cab5c"
msgid "Ow! Feels like being siphoned, and painfully too."
msgstr "오우! 빨아먹힌 기분이야. 고통은 덤이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "h0358b7f8g3daag46fcgb2edg8dc2295ba669"
msgid ""
"<i>Agh...</i> Not the most pleasant feeling, though I've definitely felt "
"worse."
msgstr "<i>윽...</i> 그렇게 좋은 느낌은 아니야. 더러운 기분이 드는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "ha99d5365g77b5g45a7g9476g0fc424677dfe"
msgid "Ouch! A hungry little device, this."
msgstr "아야! 굶주린 기계 녀석 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "h50f99029gd9a6g4140g953fg826d302d342d"
msgid "Yowch!"
msgstr "으앗!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "h0fac0017gd5f6g4586ga057g5fd8b967c703"
msgid "Ow! I should know better than to ease into an illithid contraption."
msgstr "오우! 일리시드 장치 안에 편히 들어가는 방법을 배워 뒀어야 하는 건데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "haae5e91ag73a5g4fbega896g4fa1e4f84ca9"
msgid "<i>Agh...</i> This contraption bites like a hungry wolf."
msgstr "<i>윽...</i> 이 장치는 굶주린 늑대처럼 물어뜯는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "hf3e4310dg3f92g4ec0gace2g2131bb5af274"
msgid "Ngh. It's... feeding on me."
msgstr "윽. 날... 먹이로 삼고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain
#. Speaker = Player
#. NodeID = e0164aaf-6fd5-46bf-a062-b216c996e37d
#. HandlePath = TaggedText[9].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_SourcePain:e0164aaf-6fd5-46bf-a062-b216c996e37d
msgctxt "hdf6a6b8bg623bg49a1g9904g3089568ff07e"
msgid "Argh! I feel... lighter, somehow. Like something's been taken."
msgstr "악! 왜인지... 가벼워진 기분이야. 무언가 빼앗긴 것처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "ha248f834gfbe0g4c34g86cbge3a64fd7f494"
msgid "Nothing. Is there a problem with the power source?"
msgstr "뭐야. 동력원에 문제라도 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "hf2acadecgd196g4df8ga580g9ec9271e642c"
msgid "No joy. Should I be using something else?"
msgstr "실패로군. 다른 걸 이용해야 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "h8a8f60ceg55fdg4a23g9ae9gd0c226f3bbb4"
msgid "The wrong power source, it seems."
msgstr "동력원이 잘못된 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "h9ca26fdag8a99g48f4gadabg2ed9e46c2fc3"
msgid "Hm. Nope."
msgstr "흠. 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "h1fb301e1g5e79g43edga73dg6b1385038891"
msgid "Inactive. The power source must be inadequate."
msgstr "비활성 상태다. 올바른 동력원을 찾아야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "h33256dfbg5d08g4cf8ga309g29114b561be8"
msgid "No good. Must need a different power source."
msgstr "옳지 않아. 분명 알맞은 동력원이 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "h7169bb61g90e1g424aga101gf19fd4b1dd58"
msgid "Not what this contraption prefers to feed on, I think."
msgstr "이 장치가 선호하는 먹이는 아닌 것 같네만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "heea631abg14c4g40ddg94f9g2948e0c60f40"
msgid "Nothing. I reckon it needs a different power source."
msgstr "쓸모없군. 다른 동력원이 필요한 것으로 판단된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource
#. Speaker = Player
#. NodeID = 7ca051d2-c46b-445b-a9cb-8267390fdbfa
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD_WrongSource:7ca051d2-c46b-445b-a9cb-8267390fdbfa
msgctxt "hfa9ea764gd25fg44b8g91bcg547bae2a88e0"
msgid "Nothing. Seems it needs a different source to draw from."
msgstr "쓸모없군. 흡수할 다른 동력원이 필요하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "h12783fbag0b2dg44c8gb043gda265cd4d915"
msgid "An illithid brine pool - but no tadpoles. Curious."
msgstr "일리시드 염수 웅덩이 - 올챙이는 없고. 흥미로운걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "h1cad0edfgb96ag44e4gbf53g00e570d89574"
msgid "A brine pool - but it's empty."
msgstr "염수 웅덩이 - 하지만 비어 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "hde143eb1g7dc8g4a6fga771ga39c67048019"
msgid ""
"Overly optimistic to hope there were never any tadpoles here? Thought as "
"much."
msgstr "이 안에 올챙이가 한 마리도 남아 있지 않기를 바란다면 너무 사치일까? 놀랍지도 않네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "hf12ab473gfeb7g461dg88d9g4311c6cafca4"
msgid "A brine pool. Empty, thankfully."
msgstr "염수 웅덩이야. 비어 있네. 감사해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "hc72886a0ge5a3g4ee0g8188g394ed04e41a0"
msgid "Thick brine for the wrigglers. Thankfully they're gone."
msgstr "꿈틀이들만의 걸쭉한 염수로군. 고맙게도 모두 독립했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "hb720a956g9c50g400fg93e6g0c362cb387cc"
msgid "A brine pool with no tadpoles."
msgstr "올챙이가 없는 염수 웅덩이라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "h6d799b92g92ddg4259gab45gbfee1b03bf73"
msgid "A brine pool - but not a little swimmer to be seen. Good."
msgstr "염수 웅덩이 - 수영하는 녀석들은 보이지 않는군. 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "h3f203ed8g5515g4f52gbac8ge24377c8ed15"
msgid "A brine pool - depleted of tadpoles, blessedly."
msgstr "염수 웅덩이 - 은혜롭게도 올챙이들은 고갈되었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = b1a8f551-d135-69aa-0a1e-1f0d710b90ab
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:b1a8f551-d135-69aa-0a1e-1f0d710b90ab
msgctxt "h7a2871d8ga06cg4e81gb606g34265bc7a7e5"
msgid "No tadpoles in this brine pool."
msgstr "일리시드 수조에 올챙이가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "h8ad44fb0g240bg434fg88feg58d24d7a4ea8"
msgid "Empty of tadpoles... I wonder where the little wrigglers went?"
msgstr "올챙이가 없다라... 그럼 이 꿈틀이들이 어디로 간거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "he91722c1g625bg4867ga97bg7a19eefd46f9"
msgid "Not a single parasite. Which means they've all been put to use..."
msgstr "기생충이 한 마리도 없어. 어디선가 제 역할을 하고 있단 소리겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "h23c27feeg2408g44d2g9652g69637a2e0979"
msgid "Not a tadpole to be seen. What have they done with them?"
msgstr "올챙이가 코빼기도 보이지 않아. 올챙이로 뭘 한 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "hb14f13cegfcdfg4f7bg9429g65582cdf58f4"
msgid "An empty brinepool. But then where are the tadpoles...?"
msgstr "염수 웅덩이가 비었잖아. 그럼 올챙이들은 어디로 간 거지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "h9050d793ge164g4180ga418ge9fe7f9aad30"
msgid ""
"The only thing worse than a pool for tadpoles is an <i>empty </i>pool for "
"tadpoles."
msgstr "일반적인 올챙이 웅덩이보다 더 나쁜 건 <i>텅 빈 </i> 올챙이 웅덩이뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "hc135da42g0ff7g4abagacc6g340eab5706e8"
msgid "No more tadpoles. Hope they all weren't used on people."
msgstr "올챙이가 코빼기도 안 보여. 바라건대 사람들에게 사용되지 않았기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "h78ab8632g81ffg4bb4gb589g5467c73aed74"
msgid "Emptied of tadpoles. How many True Souls were made down here, I wonder."
msgstr "올챙이들이 비워졌어. 이 아래에서 얼마나 많은 참된 영혼들이 만들어졌을지 궁금하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "h7946ad36g16cfg4480ga69dg21f5cddb6ada"
msgid "No tadpoles present. Have they all been put to use...?"
msgstr "지금은 올챙이들이 보이지 않는군. 벌써 사용된 건 아니겠지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool
#. Speaker = Player
#. NodeID = fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_State_BrinePoolEmpty = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpoleChamber_PAD_BrinePool:fcb6998a-9a57-42fd-b132-87ffbc0cc3cc
msgctxt "h55929037g7354g4cebgaa92ga0d21cf856db"
msgid "No more tadpoles in here. Wonder what happened to them?"
msgstr "올챙이들이 남아 있지 않아. 무슨 일이 일어난 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_Manip_ColonyComment
#. Speaker = Manip Shuurga
#. NodeID = 24ce1ea5-687c-4b1d-8bf5-7bb85ce54713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_Manip_ColonyComment:24ce1ea5-687c-4b1d-8bf5-7bb85ce54713
msgctxt "h71fd7d95gc7cdg45a1g8856gbcbfe8b75506"
msgid "There'll be hells to pay for this, if I make it out of here alive."
msgstr "제대로 되갚아 주겠어. 여기서 살아 나갈 수만 있다면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_Manip_ColonyComment
#. Speaker = Manip Shuurga
#. NodeID = fccf9827-93e4-45e2-a477-315652d5dad2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_Manip_ColonyComment:fccf9827-93e4-45e2-a477-315652d5dad2
msgctxt "hcbd6732dg9e56g456eg9ed3g7a83b7706457"
msgid ""
"That smell - I can feel it in my <i>throat</i>. I'll never be rid of it."
msgstr "이 냄새 - <i>목구멍</i>으로 느껴져. 절대로 잊지 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_001_Mindflayer
#. Speaker = Narrator
#. NodeID = 2924bf0c-1428-8a62-8b67-ac5b93ed67a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_MemoryImprint_FirstUse = False
#. SetFlags:
#.   Global:
#.     - COL_TadpolingCentre_MemoryImprint_FirstUse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_001_Mindflayer:2924bf0c-1428-8a62-8b67-ac5b93ed67a9
msgctxt "h1df886cbg0df6g4a4egb694g29f6a44d9877"
msgid ""
"*The device releases a stream of fragmented memories and emotions - all that "
"remains of the pod inhabitant's former self.*"
msgstr "*장치가 기억과 감정의 파편들을 쏟아냅니다. 포드에 있는 존재의 예전 자아가 남긴 전부입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_001_Mindflayer
#. Speaker = Narrator
#. NodeID = 30a0c817-1bf9-42f4-9294-dee19f9618c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_MemoryImprint_FirstUse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_001_Mindflayer:30a0c817-1bf9-42f4-9294-dee19f9618c2
msgctxt "h7e06df0bg2fb5g4853g81aag0faf738b421b"
msgid ""
"*Amusement... curiosity... fascination. He believed the horrors of Moonrise "
"to be a fleeting dream that fade on waking.*"
msgstr "*즐거움... 호기심... 황홀경. 이 남자는 문라이즈에서 겪은 공포를, 그저 일어나면 잊어버릴 꿈이라고 믿었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_001_Mindflayer
#. Speaker = Narrator
#. NodeID = eaa41f76-c07e-46a1-baf7-c0704963c602
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - COL_TadpolingCentre_State_PodEmpty(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_001_Mindflayer:eaa41f76-c07e-46a1-baf7-c0704963c602
msgctxt "h0b1eefacg869fg4aabg9a61g6f7f645ef16c"
msgid "*The device does not react to your touch or presence.*"
msgstr "*장치는 당신의 손길과 당신의 존재에 전혀 반응하지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_002_Manip
#. Speaker = Narrator
#. NodeID = 81a8c53d-f114-4f99-b99c-d65d26a5f65c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_002_Manip:81a8c53d-f114-4f99-b99c-d65d26a5f65c
msgctxt "hcfb47c44g1f67g4c29ga062g50f3d8c5bfbe"
msgid ""
"*This pod pulsates with the angry memories of Ravengard's search officer, "
"Manip Shuurga. She laments her failure to locate him.*"
msgstr "*포드에서 레이븐가드를 찾던 장교, 매닙 슈르가의 분노한 기억이 흘러넘칩니다. 공작을 찾아내지 못한 것에 한탄하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_002_Manip
#. Speaker = Narrator
#. NodeID = e194d31e-6614-46b3-a53b-fb4def1ba56b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - COL_TadpolingCentre_State_PodEmpty(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_002_Manip:e194d31e-6614-46b3-a53b-fb4def1ba56b
msgctxt "h57adbccaga59bg41e8ga812g4d49ea28d61f"
msgid ""
"*This pod is empty, bereft of memories but for a single waft of frustrated "
"fury.*"
msgstr "*포드는 비어있지만, 희미한 기억이 남아있습니다. 절망과 분노의 편린이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_003_Mindflayer
#. Speaker = Narrator
#. NodeID = 003b22ce-cb26-4e29-acde-555addcc383f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_MemoryImprint_FirstUse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_003_Mindflayer:003b22ce-cb26-4e29-acde-555addcc383f
msgctxt "h7ae2f26dg7961g4e71g976egda28547c3478"
msgid ""
"*Desperation... pain... terror. Cultists raided his village - he was the "
"sole survivor.*"
msgstr "*절망... 고통... 공포. 이 남자는 광신도들이 마을을 공격했을 때 살아남은 유일한 생존자였습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_003_Mindflayer
#. Speaker = Narrator
#. NodeID = 07acd34c-989a-578e-07d5-b13e948383b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_MemoryImprint_FirstUse = False
#. SetFlags:
#.   Global:
#.     - COL_TadpolingCentre_MemoryImprint_FirstUse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_003_Mindflayer:07acd34c-989a-578e-07d5-b13e948383b6
msgctxt "h64024400g99dcg45e6g9b3ag401be27ad0f1"
msgid ""
"*The device releases a stream of fragmented memories and emotions - all that "
"remains of the pod inhabitant's former self.*"
msgstr "*장치가 기억과 감정의 파편들을 쏟아냅니다. 포드에 있는 존재의 예전 자아가 남긴 전부입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_003_Mindflayer
#. Speaker = Narrator
#. NodeID = 61a94ba4-e206-4df4-b781-06d0ff00f78c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - COL_TadpolingCentre_State_PodEmpty(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_003_Mindflayer:61a94ba4-e206-4df4-b781-06d0ff00f78c
msgctxt "h4e2397d9g19e7g4ec8gb411ga8413fdfbb45"
msgid "*The device does not react to your touch or presence.*"
msgstr "*장치는 당신의 손길과 당신의 존재에 전혀 반응하지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_004_Mindflayer
#. Speaker = Narrator
#. NodeID = a6e9800f-0ad4-47e8-d4ab-5e065cefcb21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_004_Mindflayer:a6e9800f-0ad4-47e8-d4ab-5e065cefcb21
msgctxt "h797635b3g6387g4e1bgbd9dg12713748d36c"
msgid "*The device does not react to your presence.*"
msgstr "*장치는 당신의 존재에 전혀 반응하지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_AD_MemoryImprint_005_Mindflayer
