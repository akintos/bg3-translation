msgctxt "h1e3110f4g905eg43c5g904ag4a2eabdd80c5"
msgid "Something's wrong. I feel weak. <i>Drained</i>."
msgstr "이상해. 기운이 <i>빠져나가는</i> 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
