#.     - SHA_ObjectOfDarknessTrial_Event_RefusedSH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:1f518ac6-3cc4-9348-703a-1576b6e81df4
msgctxt "h77f19029g55cag4761gb590g8b433c1c0e92"
msgid "As you wish."
msgstr "원하는 대로 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Player
#. NodeID = 3f7faee2-6657-d9cc-e29a-49bf277010f2
#. HandlePath = TaggedText[0].TagText[0]
