#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = False
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:f9b7aba2-79fd-490d-96e2-3bfeed7dc7c4
msgctxt "h8b938d4dg832fg4ef3g9714g6ddc69201744"
msgid "Sweet child. Let me help."
msgstr "귀여운 아이야. 내가 도와줄게요."

