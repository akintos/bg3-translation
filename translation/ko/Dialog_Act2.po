msgctxt "ha86b5ba2gb333g4c55g9c18g14e7153a243e"
msgid "Isn't it obvious! I'm a... I stand on a stage, pretending..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_PAD_ArmInBarrel
