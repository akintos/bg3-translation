msgctxt "h4f559a02g7910g44ccg83e4gbf89cb844ca7"
msgid "Seems someone's been skimming our supplies."
msgstr "누군가가 저희 물자를 빼돌리고 있는 듯 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Harper Callie
#. NodeID = 6b53446f-5e18-418a-99b5-129806db059e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_JaheiraReport:6b53446f-5e18-418a-99b5-129806db059e
msgctxt "hd806c972g3575g4510g9056g920b7919a7c8"
msgid "Seems that way."
msgstr "그런 것 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Harper Callie
#. NodeID = 95b75a61-45ac-4537-ac88-1a93e1ce2afe
