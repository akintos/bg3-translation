#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:e0829a11-b3c9-0985-b534-9df46bafff60
msgctxt "hafb036bcgb640g4e76g910fg1428415ac8ed"
msgid ""
"You only love your master because he's been dosing this meat. He's "
"manipulating you."
msgstr "네가 주인님을 사랑하게 된 건, 그가 이 고기에 약을 탔기 때문이야. 그가 널 조종하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = e1afd7c5-b546-b14b-4d26-05ff1b03cf13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:e1afd7c5-b546-b14b-4d26-05ff1b03cf13
msgctxt "hcf08e1d2gf3d6g4db3g9cd3g1579c15ff526"
msgid "I <i>love</i> him. And he loves me."
msgstr "난 주인님을 <i>사랑해</i>. 그리고 주인님도 날 사랑해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = e386a13c-0be3-69a5-9a7d-7b6db73b5841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:e386a13c-0be3-69a5-9a7d-7b6db73b5841
msgctxt "h25567713gcdf9g4f37ga355g2886e3f87658"
msgid "Master found me, fed me, then I... I..."
msgstr "주인님이 날 찾아주시고, 먹여주셔서 그리고 난... 내가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = e478086b-4e18-4879-c264-4559daa3b149
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:e478086b-4e18-4879-c264-4559daa3b149
msgctxt "hff7f25fbgf95bg4dabgba30ged8d300161f3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = e767ea99-03be-a394-fe35-f06ce00b0263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:e767ea99-03be-a394-fe35-f06ce00b0263
msgctxt "h5d46b795ge675g4402g8e01g1369ea60738e"
msgid "You should consider me - I'm much better than him<i>.</i>"
msgstr "난 주인님으로 어때 - 내가 <i>그보단</i> 훨씬 나을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = e7a1f0ab-a66f-c2f8-b529-5566201aa394
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:e7a1f0ab-a66f-c2f8-b529-5566201aa394
msgctxt "he9aab1b2g1309g476dgb735gf0e34d51a5b7"
msgid "*There are too many prints - you cannot tell them apart.*"
msgstr "*자국이 너무 많습니다... 당신은 구별할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = e845db8d-b93f-262c-d182-2fa4e3992211
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:e845db8d-b93f-262c-d182-2fa4e3992211
msgctxt "hfe0736bcg7e24g4634gbf48g495aaca6a764"
msgid "This is love. I am sure."
msgstr "이건 사랑이야. 확실해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
