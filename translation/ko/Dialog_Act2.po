msgctxt "h70c7b648g2f05g4214gad81g86a6200e1caa"
msgid "Shame to let a meal walk free..."
msgstr "식사가 걸어 나가게 하는 건 수치스럽지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = cea7e65a-16fc-0b0e-4886-bc5598f08a20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:cea7e65a-16fc-0b0e-4886-bc5598f08a20
msgctxt "hd2b841c5gd0d5g49e0g936fgf9da6c4c60e0"
msgid "<i>I</i> am master's heart-chosen."
msgstr "<i>나</i>는 주인님의 진심 어린 선택받은 자다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
