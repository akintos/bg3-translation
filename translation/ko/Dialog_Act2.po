msgctxt "h9f08c86dg6279g40aag860bg3a0dbe787a45"
msgid "Sorry, I - I don't think I can talk right now."
msgstr "미안해요, 지 - 지금은 대화할 수 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001
#. Speaker = Harper Meygan
#. NodeID = ee0c4483-7e50-42c4-9ec4-abfa14b67434
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
