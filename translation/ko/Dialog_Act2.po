#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HarperGuard_002_AD_WithMirkon:7ebbbc8f-7071-4599-8158-04d797ae2c55
msgctxt "hcc541349g53a4g4db5g9e18gd221a9accd29"
msgid "This might be cheating, but have you seen any treasure?"
msgstr "반칙일 수도 있긴 한데, 보물 본 적 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
#. Speaker = Harper Bor
#. NodeID = 832eb350-b009-fc94-89b5-4245b8eb3560
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HarperGuard_002_AD_WithMirkon:832eb350-b009-fc94-89b5-4245b8eb3560
msgctxt "h6f7b2462gc5ddg4937g8a2bgebd044cedd62"
msgid "Well, my coin is on you. Just do your best, all right?"
msgstr "난 너한테 걸었어. 그냥 최선을 다하기만 해. 알겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
#. Speaker = Mirkon
#. NodeID = 9c539c2e-19e2-595f-9ac4-c7036f2d6333
