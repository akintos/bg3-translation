#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Arrival_DaisyAD_ThroughHole
#. Speaker = GROUP_Daisy
#. NodeID = 5f58f35e-5267-40cd-81a2-448fbeb4143f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
