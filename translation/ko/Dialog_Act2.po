msgctxt "he601b90ag55dbg4189gbd99g5a6a704df494"
msgid "I wish my audition piece was that exciting..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Blighted Actor
#. NodeID = b6e60e7e-d2dc-ca23-96e6-60dbaa7cd92d
#. HandlePath = TaggedText[0].TagText[0]
