msgctxt "hf57ef3a0gd4feg4a94g9016g0413a8ffc4e3"
msgid "Careful! Those are meenlocks."
msgstr "조심해! 민록이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
msgctxt "h6fe36e80gf2b3g4236ga77aga9a544190518"
msgid "It's something with razor-sharp claws. Keep your distance."
msgstr "날카로운 발톱을 가진 놈이다. 거리를 유지해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
msgctxt "h21e98affgef56g4cc9gabd3g914068e79c2e"
msgid ""
"Those claws look sharp - stay clear, unless you wish to trip on your own "
"entrails."
msgstr "발톱이 날카로워 보이는데. 자기 내장에 걸려 넘어지고 싶은 게 아니라면 멀리 떨어져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
msgctxt "h164cbdc6g38dcg4667g8b83g030c0f0f05a9"
msgid "Those claws look vicious. Defend, soldier!"
msgstr "발톱이 사나워 보이는군. 조심해, 신참!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
msgctxt "he1357817g182dg4139gad24gf759988d4cf6"
msgid "Dismember those claws before they dismember you."
msgstr "저 발톱부터 잘라라. 안 그러면 네 사지가 잘릴 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
msgctxt "h39f635fdgfb6ag45ebg8e3eg33b7cc36dd29"
msgid "Whatever it is, keep away from those claws."
msgstr "뭔지는 모르겠지만, 저 발톱은 조심하는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
msgctxt "hbc14df0dg9a4bg45d1g8299g35c7d823bef7"
msgid "Keep your neck out of those claws. One snip and you're done for."
msgstr "목에 저 발톱 안 닿게 조심해. 한번 그이면 그걸로 끝이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:596fd98a-ecf0-28aa-b9bc-febc0c7c57d2
msgctxt "h1b073b9egeab7g4104g91abg021da3d5b2d1"
msgid "Those claws look deadly. Stay on your guard."
msgstr "발톱이 위험해 보이는군. 경계를 늦추지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = b5a5f70b-3faf-40a3-8309-0c090d819b2f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:b5a5f70b-3faf-40a3-8309-0c090d819b2f
msgctxt "h07dab3a4g6f72g43efgb999gfaba9e05b8b9"
msgid "They can't stand bright lights - any flame or illumination will help."
msgstr "놈들은 밝은 빛에 약해. 불꽃이나 불빛이 도움이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = b5a5f70b-3faf-40a3-8309-0c090d819b2f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:b5a5f70b-3faf-40a3-8309-0c090d819b2f
msgctxt "h56fe5a04g7e54g4387g9382gca1f229705b5"
msgid "Their sight works best in darkness - stay with light, if you can."
msgstr "놈들은 어둠 속에서 더 잘 보지. 될 수 있으면 빛 근처에 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = b5a5f70b-3faf-40a3-8309-0c090d819b2f
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:b5a5f70b-3faf-40a3-8309-0c090d819b2f
msgctxt "h0591b8c9g3292g4f82gb9acg5990ae2a09da"
msgid "Meenlocks! These buggers thrive in the dark. Let's light 'em up."
msgstr "민록이다! 어둠 속에서 살아가는 놈들이지. 불이라도 붙여주자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = b5a5f70b-3faf-40a3-8309-0c090d819b2f
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:b5a5f70b-3faf-40a3-8309-0c090d819b2f
msgctxt "h227ba83fg3efbg4130g84dfgf68a6f80c6e0"
msgid "Their eyes are made for darkness. Strike with fire - or light."
msgstr "놈들의 눈은 어두운 곳에 맞춰져 있다. 불이나 빛으로 공격해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = b5a5f70b-3faf-40a3-8309-0c090d819b2f
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:b5a5f70b-3faf-40a3-8309-0c090d819b2f
msgctxt "h074265cbg032dg45d3g8b8dg71c41ed607e5"
msgid "They see best in the dark - a light source can blind them."
msgstr "민록은 어두울 때 제일 눈이 밝지. 빛이 있다면 눈을 멀게 할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = b5a5f70b-3faf-40a3-8309-0c090d819b2f
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:b5a5f70b-3faf-40a3-8309-0c090d819b2f
msgctxt "h7d42d974g077dg42b4g9a46gf208d7c21283"
msgid ""
"Their eyes are accustomed to darkness. A bit of light or fire will sort them "
"right out."
msgstr "놈들의 눈은 어두운 곳에 익숙해. 약간의 빛이나 불만 있다면 처리할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = b5a5f70b-3faf-40a3-8309-0c090d819b2f
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:b5a5f70b-3faf-40a3-8309-0c090d819b2f
msgctxt "ha91cf97fg471ag4fd0g9479gfd8e6bd597ce"
msgid "Their eyes are made for the dark - fire and light is our friend."
msgstr "놈들의 눈은 어두운 곳에서나 쓸모가 있지. 불이나 빛을 활용해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
msgctxt "h66ba3d37g6bb5g4789ga4f7gb0c9a29a84f7"
msgid "Hells! Whatever you are, you can keep those claws to yourself."
msgstr "젠장! 네놈이 뭔지는 모르겠다만, 그 발톱은 좀 치워달라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
msgctxt "h8b532067g7693g4113ga476g2957d82a34a3"
msgid ""
"Those claws look sharp. Better stay clear - I much prefer to keep my insides "
"on the inside."
msgstr "발톱이 날카로워 보이는데. 조심하는 게 좋겠어. 내 내장은 온전히 내 몸 안에 두고 싶거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
msgctxt "h7a2b01abg042eg4650g827agbaa9470e784c"
msgid "Those claws look vicious."
msgstr "발톱이 아주 사나워 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
msgctxt "ha69caf22g6c8eg4d7dgbff3gfa433702fb91"
msgid "Grotesque things. I will rip their claws clean off!"
msgstr "역겨운 것들. 놈들의 발톱을 모조리 뽑아버리겠다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
msgctxt "h719c85abg9e12g4d9ag9e99g13fa93ba6228"
msgid "What the hells is that? More claws than a sack of feral cats."
msgstr "저게 대체 뭐야? 길고양이 무리보다도 발톱이 많잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
msgctxt "h661b82f4g464bg474ag80d8g2f289577732f"
msgid "Gone gods - what hole did <i>this</i> thing crawl out of?"
msgstr "이런 세상에, <i>이건</i> 대체 어느 구멍에서 기어 나온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:c1f27b6d-e0f3-4318-ae14-fc53f7a0696c
msgctxt "h8412113eg64a5g46f8g8a9fgbb81e5c2e272"
msgid "Those claws look deadly. Best be on my guard."
msgstr "발톱이 위험해 보이는군. 조심하는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = d87e5ce4-49db-f821-9a02-37724d380d57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:d87e5ce4-49db-f821-9a02-37724d380d57
msgctxt "h08e18a28g9bbdg4de2ga4b7gcd7b93277963"
msgid "Hells! What's this new horror?"
msgstr "젠장! 이 끔찍한 것들은 또 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = d87e5ce4-49db-f821-9a02-37724d380d57
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:d87e5ce4-49db-f821-9a02-37724d380d57
msgctxt "haef19fa7gdfc4g4405gbe4egb4a90c576b7b"
msgid "Hells. What gruesome creature's assailing me now?"
msgstr "젠장. 이 끔찍한 괴물은 또 뭐길래 날 공격하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = d87e5ce4-49db-f821-9a02-37724d380d57
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:d87e5ce4-49db-f821-9a02-37724d380d57
msgctxt "h8d20467fg2a49g467ega22egd7163a906768"
msgid "Oh gods, what now."
msgstr "이런 젠장, 이번엔 또 뭐야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = d87e5ce4-49db-f821-9a02-37724d380d57
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:d87e5ce4-49db-f821-9a02-37724d380d57
msgctxt "h276d6cbag5295g4d44g9405gc1a394fc7660"
msgid "<i>Tsk'va. </i>Beasts so grotesque, they put even a neogi to shame."
msgstr "<i>츠크바.</i> 네오기도 울고 갈 만큼 끔찍한 짐승들이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = d87e5ce4-49db-f821-9a02-37724d380d57
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:d87e5ce4-49db-f821-9a02-37724d380d57
msgctxt "ha4e9894cg7ee3g45bcg96a3gd2a7afacbbb9"
msgid "Oh hells, what now?"
msgstr "이런 젠장, 또 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = d87e5ce4-49db-f821-9a02-37724d380d57
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:d87e5ce4-49db-f821-9a02-37724d380d57
msgctxt "h620269c4g8df6g4fefgb45cg2f771fe22109"
msgid "Gone gods - what hole did <i>this</i> thing crawl out of?"
msgstr "이런 세상에, <i>이건</i> 대체 어느 구멍에서 기어 나온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = d87e5ce4-49db-f821-9a02-37724d380d57
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:d87e5ce4-49db-f821-9a02-37724d380d57
msgctxt "ha19d2997g1d2fg43f1ga8e4g199b8b0b1399"
msgid "What is <i>that</i>?"
msgstr "<i>저건</i> 또 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Shadowheart
#. NodeID = 4377e8aa-2755-42d1-8742-3db0bc5abae8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:4377e8aa-2755-42d1-8742-3db0bc5abae8
msgctxt "h3ec72650g1995g4588g97a3gad3da40ce3c6"
msgid "A Selûnite shrine, hidden away."
msgstr "셀루네의 성소군. 잘도 숨겨 놨네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Shadowheart
#. NodeID = 8cedaf10-dbba-4ec0-9f1a-812d67aa8dd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:8cedaf10-dbba-4ec0-9f1a-812d67aa8dd6
msgctxt "he7d7fa70g1510g4852g8a94g39d6822b73f6"
msgid ""
"A shrine to Selûne. I might have sneered at this, once. Or tried to destroy "
"it."
msgstr "셀루네의 성소구나. 예전이라면 이걸 비웃었을 거야. 아니면 파괴하려고 했거나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
msgctxt "h80a32ba6g85d9g4936g891agaefb92492a01"
msgid "Well, we live and learn. Or we die and don't."
msgstr "뭐, 다 살아가면서 깨닫게 되는 거지. 죽으면 영영 무지한 채로 남는 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
msgctxt "h1efcb44bg79ffg41a8g86f4gfdf8b5ba5977"
msgid ""
"Quiet but uneasy. Even in the Moonmaiden's refuge, the curse feels close at "
"hand."
msgstr "고요하지만 불안하군. 달처녀의 피난처에 있는데도, 저주가 손에 닿을 듯 가까이 느껴진다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
msgctxt "he1a5f317gae21g4fc2g8c61gee5b93a7f4c3"
msgid ""
"Far better to encourage such glimmers of light amongst the darkness.  Who "
"knows where they may lead?"
msgstr ""
"이런 어둠 속에서 한 줄기 빛을 발견했다는 건 충분히 고무적인 일이야. 이 빛이 우리를 어디로 이끌어줄지는 아무도 모르는 일이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
msgctxt "h038da301g5ec8g45a9g9ee4g7b07d426bff9"
msgid "In a land of darkness, Selûne's faithful learn make their own light."
msgstr "이런 어둠 가득한 땅에서도 셀루네 신도들은 자신의 빛을 잃지 않았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
msgctxt "hd475ff5fg0678g4957ga77dg7920fcd4ef09"
msgid "I liked you before, but I extra like you now."
msgstr "원래도 네가 좋았는데, 이젠 두 배로 더 좋네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
msgctxt "hbc920723g8ed8g40dbgae7cg60fa7bcfd73a"
msgid "You are no longer the same person you once were. You are better."
msgstr "자네는 더 이상 예전과 같은 사람이 아닐세. 더 나은 존재지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:c9407fb9-ca10-43d3-8d8e-f5af411ccdc2
msgctxt "h9d22257cg6cdbg4d48ga625g668896be8a76"
msgid "I believe that's called growth, Shadowheart."
msgstr "그런 걸 성장이라고 부를 수 있겠지, 섀도하트."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = ce9febad-577b-43af-9551-e4a9e5547a71
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:ce9febad-577b-43af-9551-e4a9e5547a71
msgctxt "h891315d3g8700g4cb0gb28egb25540832970"
msgid "I thought Sharrans were usually the ones worshipping in the shadows."
msgstr "어둠 속에서 기도하는 부류는 샤의 신도들 뿐이라고 생각했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = ce9febad-577b-43af-9551-e4a9e5547a71
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:ce9febad-577b-43af-9551-e4a9e5547a71
msgctxt "h513dde88g25e5g4766gaa2eg23e341cbb47a"
msgid "Even the Moonmaiden's own seek private sanctuary for prayer."
msgstr "달처녀의 신도들에게도 비밀 사원이 필요했던 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = ce9febad-577b-43af-9551-e4a9e5547a71
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:ce9febad-577b-43af-9551-e4a9e5547a71
msgctxt "hc10263a0ged57g4728g8495g91fc44c9b596"
msgid "Even Selûne's faithful are driven to the darkness in such a place."
msgstr "셀루네의 신자라 해도 그런 곳에서는 어둠 속으로 내몰리고 말겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = ce9febad-577b-43af-9551-e4a9e5547a71
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:ce9febad-577b-43af-9551-e4a9e5547a71
msgctxt "hde0ea4d5g1a21g4508gbe64g3987c4caec94"
msgid ""
"A haven within a haven. The prayerful seek solitude - even Selûne's faithful."
msgstr "안식처 속의 안식처. 신앙이 깊은 자들은 고독을 찾지. 셀루네의 신도라고 해도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = ce9febad-577b-43af-9551-e4a9e5547a71
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:ce9febad-577b-43af-9551-e4a9e5547a71
msgctxt "h40da6e69gcf04g4defg94c5g93c91a3e0fb6"
msgid "Cosy down here. Secret, even."
msgstr "여기 되게 아늑하다. 비밀스럽기도 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = ce9febad-577b-43af-9551-e4a9e5547a71
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:ce9febad-577b-43af-9551-e4a9e5547a71
msgctxt "h9db954a7g0b12g498fg9a0dg17b3eeada910"
msgid "Driven into concealment, perhaps?"
msgstr "숨겨야만 했던 것이 아닐까 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine
#. Speaker = Player
#. NodeID = ce9febad-577b-43af-9551-e4a9e5547a71
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_SeluneShrine:ce9febad-577b-43af-9551-e4a9e5547a71
msgctxt "h31b466e8gb2beg4d5ag8420gbdad529e90fb"
msgid "Perhaps they had no choice but to hide."
msgstr "숨는 것 말고 다른 선택지가 없었을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_AD_MonitorLeave
#. Speaker = Raphael
#. NodeID = 744b08aa-4442-466b-8637-cfda9423361d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_AD_MonitorLeave:744b08aa-4442-466b-8637-cfda9423361d
msgctxt "haf3ce1dbg0fe0g4dfegbc63gc9305e26b19d"
msgid "If you'll excuse me, I must see to urgent matters."
msgstr "양해해 주신다면, 저는 이만 급한 용무를 처리하러 떠나겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_AD_MonitorLeave
#. Speaker = Raphael
#. NodeID = d8573151-c308-1545-b60f-16be799860b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_AD_MonitorLeave:d8573151-c308-1545-b60f-16be799860b6
msgctxt "h5767cab6g204bg4472gb322gb26c8d268479"
msgid ""
"But don't you fret. I shall always find time for my most treasured "
"acquaintance."
msgstr "너무 안달 내지는 마시죠. 가장 귀한 지인을 위한 시간 정도는 언제나 마련해 둘 테니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_AD_NoticedStolenBoard
#. Speaker = Mol
#. NodeID = ccbdd512-3036-ef3c-4c39-d53e38439238
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_AD_NoticedStolenBoard:ccbdd512-3036-ef3c-4c39-d53e38439238
msgctxt "h69e1cb02gf427g4414ga035gbbf6f9c6d3c7"
msgid "Huh. Just put this away a second ago... didn't I?"
msgstr "허. 방금 전에 치운 것 같은데... 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Mol
#. NodeID = 0ddb7178-3435-47d3-a52e-77a7fbf8d5d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:0ddb7178-3435-47d3-a52e-77a7fbf8d5d4
msgctxt "hf38a397dg3176g4b15g86faga4384a77cf3a"
msgid "Oh? You must be broke, then."
msgstr "오? 주머니에 한 푼도 없는 모양이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Mol
#. NodeID = 2fe7836e-57be-48be-b147-744b60607508
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 90a73000-b6ed-ad55-7eae-f9a6f8f00f55_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:2fe7836e-57be-48be-b147-744b60607508
msgctxt "he88571d0g4e09g4a4cgaaccga9a4a4017cd9"
msgid "This game's awful. Why's anyone play it?"
msgstr "이 게임 재미 없어요. 왜 하는 거예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Mol
#. NodeID = 352ffa65-4a33-4fc2-9164-c18a159481b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 90a73000-b6ed-ad55-7eae-f9a6f8f00f55_A = True
#. SetFlags:
#.   Local:
#.     - 90a73000-b6ed-ad55-7eae-f9a6f8f00f55_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:352ffa65-4a33-4fc2-9164-c18a159481b5
msgctxt "h4f42816eg61e5g4732gb026g376915b0a80c"
msgid "Should have picked your pockets instead of doin' this."
msgstr "이거 할 시간에 당신 소매치기나 하는 게 나았겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Mol
#. NodeID = 3fe0378d-d5e9-4a15-8b3f-afecc2529c3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 90a73000-b6ed-ad55-7eae-f9a6f8f00f55_B = True
#. SetFlags:
#.   Local:
#.     - 90a73000-b6ed-ad55-7eae-f9a6f8f00f55_A = False
#.     - 90a73000-b6ed-ad55-7eae-f9a6f8f00f55_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:3fe0378d-d5e9-4a15-8b3f-afecc2529c3a
msgctxt "h70f0ee01gb69bg42a9gbd51g38baecea2a71"
msgid "How much are these pieces worth?"
msgstr "이 말은 가격이 얼마나 되죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Raphael
#. NodeID = 4dd6e34a-95d0-9139-31d9-a8dcf0b80d93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:4dd6e34a-95d0-9139-31d9-a8dcf0b80d93
msgctxt "h8af066a8g9838g4d05ga92bg435164e7a96f"
msgid "I wouldn't recommend that."
msgstr "그런 짓을 권하고 싶지는 않구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Raphael
#. NodeID = 8fdb74e1-520d-45cd-97d3-e60b117e08dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:8fdb74e1-520d-45cd-97d3-e60b117e08dc
msgctxt "h453222cegb901g4864ga4d2gfef31053948c"
msgid "It hones a strategic mind, my dear. Take your turn."
msgstr "전략적 사고를 연마하는 거지, 얘야. 네 차례란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Mol
#. NodeID = 9fa2b57c-2032-49e6-8d66-2ce63f70586c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:9fa2b57c-2032-49e6-8d66-2ce63f70586c
msgctxt "h3122be15g51e2g4923g9a85g499175194dce"
msgid "Ugh."
msgstr "어휴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Mol
#. NodeID = e7299175-6810-5a51-9d57-c8e12eded6d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:e7299175-6810-5a51-9d57-c8e12eded6d3
msgctxt "hccdb0d48g16cbg4778g84d0g66ee6feb47dc"
msgid "Don't you ever give a straight answer?"
msgstr "좀 직설적으로 말해주실 순 없나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD
#. Speaker = Raphael
#. NodeID = f3d93e49-ebbc-38b5-2d4e-716df59e445a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_AD:f3d93e49-ebbc-38b5-2d4e-716df59e445a
msgctxt "h52718081ge715g4b74ga8e4gf86740fa5675"
msgid "The value is in the player, not in the pieces."
msgstr "가치있는 건 말이 아니라 이 게임을 하는 사람이란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 00875500-6c3c-51fc-9f9a-00d52cfc3302
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:00875500-6c3c-51fc-9f9a-00d52cfc3302
msgctxt "h1ff43923g82fdg493cg85c8ga206037bb024"
msgid "And what is the other half?"
msgstr "나머지 반은 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 0118e2ff-0f73-0352-ea75-a47752277041
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:0118e2ff-0f73-0352-ea75-a47752277041
msgctxt "h62b4e4f9gc060g4b53g96cbgadb99ffb43b8"
msgid ""
"But of course, you'll have to do something for me first. Let me think about "
"it and get back to you."
msgstr "물론 그 전에 앞서서, 제게 뭔가를 해주셔야겠군요. 생각을 좀 해 보고 다시 돌아오도록 하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 022449ac-c0b2-d143-319f-276ba8fa438a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:022449ac-c0b2-d143-319f-276ba8fa438a
msgctxt "h1bccfa2bg743ag4deega7f2g6bbce21cf617"
msgid ""
"The good thing is, though, there's only one little voice you really should "
"listen to."
msgstr "그래도 잘된 건, 당신이 귀기울여야 할 작은 목소리는 딱 하나라는 거죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 024529ea-bd8f-393e-378e-ebb1a47a1332
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:024529ea-bd8f-393e-378e-ebb1a47a1332
msgctxt "he917a1dcg4775g49a8gab06g90b3e23ab463"
msgid ""
"And there's this little voice inside of you asking: 'Is this my will, or is "
"it the worm's?' But you have no answer, and no way of knowing."
msgstr ""
"당신 머릿속의 작은 목소리가 계속 스스로 묻고 있죠. '이게 내 의지일까, 아니면 벌레의 생각일까?' 라고 말이죠. 허나 그에 대한 답은 "
"없고, 알아낼 방법도 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 030715b8-f60c-de8e-a3da-24a83e57c4b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_RaphaelRemovedClothing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:030715b8-f60c-de8e-a3da-24a83e57c4b2
msgctxt "h5076cbc2g88f5g43fdga017g7fc89d16bf91"
msgid ""
"You haven't told them? And you've kept your clothes on this whole time? How "
"unlike you."
msgstr "말 안 해 줬군요? 여행하는 내내 옷도 계속 입고 있었고? 참 당신답지 않군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 03707901-b46d-9b68-cf85-27d49c48f6d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:03707901-b46d-9b68-cf85-27d49c48f6d9
msgctxt "h69049643g6582g40b7g9888gaec2521ea11b"
msgid ""
"A love letter? A warning? A deed of ownership? I could give you all the gory "
"details."
msgstr "연애 편지일까요? 경고일까요? 아니면 소유권 증서일까요? 전 그 끔찍한 세부 사항을 다 알려드릴 수 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 03ccac68-f586-709e-2485-bc66c5083882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:03ccac68-f586-709e-2485-bc66c5083882
msgctxt "hb17598e1g0edag445eg8353g026555d953d0"
msgid "Your move, Mol."
msgstr "네 차례란다, 몰."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 07a442ad-712d-d7b4-a668-3159107ad99e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:07a442ad-712d-d7b4-a668-3159107ad99e
msgctxt "h6acc6ffeg0443g45b2gb00bg1b4d15bb860e"
msgid "Just like yourself - isn't that right?"
msgstr "당신처럼 말이죠, 그렇지 않나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 0cfef9e5-4085-e254-9a40-69c3fb28e97f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_PartySawScars = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:0cfef9e5-4085-e254-9a40-69c3fb28e97f
msgctxt "h645d815fg2226g46dbgb13egc9585e655cd9"
msgid "What are you talking about, Astarion? What scars?"
msgstr "무슨 얘기야, 아스타리온? 무슨 흉터가 있다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 0e61ff76-80bd-791a-023f-e56703a78707
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:0e61ff76-80bd-791a-023f-e56703a78707
msgctxt "h67cab22eg622dg48c7gaaccg03eb66ec301f"
msgid "Why spoil it? It's all out there, waiting to be discovered."
msgstr "미리 알려드릴 이유가 있을까요? 그 역사는 저 바깥에 다 남아 있습니다. 밝혀지기만을 기다리고 있지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 0f1a66bc-013d-4cc3-950c-57a9ada18711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:0f1a66bc-013d-4cc3-950c-57a9ada18711
msgctxt "ha74942fdg1014g4f02g9eb0g3c275e649bf7"
msgid ""
"Suffice to say there's ambition, folly, and death aplenty. The rest... well. "
"I'll let you uncover that yourself."
msgstr "야망과 어리석음, 죽음이 아주 가득하다고 할 수 있겠네요. 나머지는... 뭐, 당신이 직접 밝혀내도록 두겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 0f5ce3c3-b5e0-8861-bfb6-017093f5f787
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:0f5ce3c3-b5e0-8861-bfb6-017093f5f787
msgctxt "h11fbf683g7d63g4864g99c8g92adf0ffcd31"
msgid "Oh, such impatience."
msgstr "아아, 참을성 없기도 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 1111fb3b-b276-5d66-a1a3-002568c275fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(2) = True
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Fighter = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:1111fb3b-b276-5d66-a1a3-002568c275fe
msgctxt "h604367abg11b0g4afcgbac4g12922f86c588"
msgid ""
"Of course I play. No better way to learn battle strategy than lanceboard. "
"It's fun, too."
msgstr "당연히 해본 적 있단다. 랜스보드만큼 전투 전략에 대해 배우기 좋은 방법이 또 없지. 게다가 재미있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 12306867-f176-c9fe-4232-896bee7fcdbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:12306867-f176-c9fe-4232-896bee7fcdbe
msgctxt "hdcfc0d86gabf2g4ac6gb8eeg59235047c9b7"
msgid ""
"Morality? No. The lesson is rather more about <i>autonomy</i> - not some you "
"zealous types know much of."
msgstr ""
"도덕이라니요? 아니죠. 오히려 <i>자율성</i>에 대한 가르침이라고 할 수 있죠. 당신같이 열성적인 부류는 잘 모르는 것 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 132b6ee1-d4aa-7b8c-ae5c-c57efe0dd05e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Q-Mol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:132b6ee1-d4aa-7b8c-ae5c-c57efe0dd05e
msgctxt "hb1c3f4e5g73c0g4dd2ga5cfg36ce1729536b"
msgid "Just stay away from Mol, you hear?"
msgstr "그냥 몰에게 접근하지 마, 알아들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Karlach
#. NodeID = 1896174e-404a-907c-9f7c-b279a35c8594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:1896174e-404a-907c-9f7c-b279a35c8594
msgctxt "hc84f79edg3858g42b1g8921ged4905564cf9"
msgid "<i>Please </i>let me smack this creep."
msgstr "<i>제발</i> 이 변태 새끼 한 대만 때리게 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 19ab142a-94b2-b836-c883-9f262f1eb2e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:19ab142a-94b2-b836-c883-9f262f1eb2e9
msgctxt "he83ad3d9g6c65g4825gab4fg44599fdcd8df"
msgid "Splendid."
msgstr "훌륭하군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 1b0d5052-ac92-0fb9-bf7f-b493dff6267b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:1b0d5052-ac92-0fb9-bf7f-b493dff6267b
msgctxt "h247281efg665eg4b13g8847g4c06148952e9"
msgid ""
"A proposal? If you're hoping to taste my blood, little vampling, think "
"again. It burns hotter than Wyvern Whiskey."
msgstr ""
"제안이라? 만약 제 피를 마시고 싶은 거라면, 어리석은 뱀플링이여, 생각을 바꾸시죠. 그랬다간 와이번 위스키보다 더 뜨겁게 타오를 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 1b76a856-9956-14cc-746b-f44603798795
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:1b76a856-9956-14cc-746b-f44603798795
msgctxt "h41c450begc73cg4d25g876dgd4b0684dd6af"
msgid ""
"Indeed. There's no telling where life will lead us - into the Hells, out of "
"them again..."
msgstr "물론이지요. 인생이 우리를 어디로 데리고 갈 지는 아무도 모르는 법 아니겠습니까. 지옥으로 끌려갔다가, 빠져나오게 된다거나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 1e2adf01-6fcd-68f9-89c0-5c9f5b8510b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:1e2adf01-6fcd-68f9-89c0-5c9f5b8510b0
msgctxt "h04c0d922g1d9ag4137ga90bg297d4ba2c47d"
msgid "This is a bad idea, Astarion. We should find another way."
msgstr "아스타리온, 이건 안 좋은 생각이야. 다른 방법을 찾아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 208f2c76-0c93-4a5d-b992-b032030827cc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Devil = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:208f2c76-0c93-4a5d-b992-b032030827cc
msgctxt "h294e65d8g6e16g4adcga94bga8c950f60fa9"
msgid "Sure, and I'm Zariel's firstborn. Don't be distractin' me."
msgstr "아, 그러셔. 그럼 난 자리엘의 장녀쯤 되겠네. 한눈팔게 만들지 좀 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 216c9323-3e05-01e3-50e6-55a1a4f6087a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:216c9323-3e05-01e3-50e6-55a1a4f6087a
msgctxt "h4c4eb3d9g30bfg4352g91ebg627326bc0e3e"
msgid "Really?"
msgstr "과연 그럴까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 22c266aa-7eef-ad0a-ec75-fa7106f58689
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:22c266aa-7eef-ad0a-ec75-fa7106f58689
msgctxt "hbbf1be8fg10b0g413fgbf3dgc69dac16e861"
msgid "Whose ever are?"
msgstr "누군들 그렇지 않나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 23431e61-0974-d393-be30-716e8c1ee7bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:23431e61-0974-d393-be30-716e8c1ee7bf
msgctxt "h023c5514ge52dg4b89gbc9dgdf19805e0d53"
msgid ""
"Besides, I do enjoy being in this neighbourhood again. It has such a rich "
"history of abject tragedy."
msgstr "그나저나, 이 동네에 다시 돌아오니 즐겁군요. 참혹한 비극의 역사가 깊이 서려 있는 곳이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Narrator
#. NodeID = 241b530d-cd9f-80e3-d1bd-29df85229682
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_NoticedLying = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:241b530d-cd9f-80e3-d1bd-29df85229682
msgctxt "hdd1e234dg129dg4c44g8e5dg097ac0eacd90"
msgid ""
"*The keen gleam in Mol's eyes reveals the lie. She knows the game well, and "
"she wants to win.*"
msgstr "*몰의 날카로운 눈빛으로 보아 거짓말을 하고 있습니다. 이 아이는 게임을 잘 알고 있고, 이기고 싶어 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 245cbf44-fc47-e587-b255-448b0c2b6670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:245cbf44-fc47-e587-b255-448b0c2b6670
msgctxt "h8b454667gb8bbg410cga931g999545a3074b"
msgid ""
"Oh please, Karlach. Let us abandon this cack-handed attempt at solving your "
"problems by fixing hers."
msgstr "오 칼라크, 이성적으로 생각해. 그녀의 문제를 고쳐서 네 문제를 해결하려는 이 가당치도 않은 시도를 관두자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 27d8b5e1-a096-af88-8f2e-74156e13588f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_GaleSuggestion = False
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Fighter = False
#.   Tag:
#.      - WIZARD(2) = False
#.      - BARD(2) = False
#.      - MONK(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:27d8b5e1-a096-af88-8f2e-74156e13588f
msgctxt "haee15571gbe3bg43abg9b86g33f510aeefa2"
msgid "Put pressure on him. Attack the pieces in front of his king."
msgstr "압박을 가해야 해. 킹 앞에 있는 말들을 공격해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 27e3f85d-80d8-db81-adcd-83c8551af01a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:27e3f85d-80d8-db81-adcd-83c8551af01a
msgctxt "h5459dfd8g497dg43edg8402gbcee16c25886"
msgid ""
"Poor Karlach. She really suffers so terribly, death haranguing her from "
"every angle. But it hasn't struck yet, has it?"
msgstr ""
"불쌍한 칼라크. 정말 끔찍한 나날을 겪고 있네요, 죽음이 온 사방에서 조여오고 있죠. 그래도 아직은 그 손아귀에 잡히진 않았네요, "
"아닌가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 28aab903-0d4f-3fe2-4480-3ac33947e47f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:28aab903-0d4f-3fe2-4480-3ac33947e47f
msgctxt "h5d287d95gd8cdg481bg8172g3fe3e2aace9e"
msgid ""
"In fact, I'm quite confident you still have a few good days in you yet. "
"Precious time to practise begging for my help with your bare knees in the "
"dirt."
msgstr ""
"뭐 그래도 며칠간은 괜찮을 거라고 확실하게 말할 수 있습니다. 무릎을 흙바닥에 박고 도와달라 애원하는 걸 연습을 할 수 있는 소중한 "
"시간이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 2aabb2d3-c45e-19bb-fb4f-c71c5d58896d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Theskan = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:2aabb2d3-c45e-19bb-fb4f-c71c5d58896d
msgctxt "h0ac40494g0170g4cfbg8d7eg1fa75f979435"
msgid ""
"My, the Theskan Double Counter-Gambit. Vicious. Exactly what I would have "
"done."
msgstr "저런, 테스크식 더블 카운터 갬빗이라니. 아주 사납구나. 나였어도 그 수를 놓았을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 2ae2cd19-6c06-7f82-d963-fad16420b89d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:2ae2cd19-6c06-7f82-d963-fad16420b89d
msgctxt "h4165a98eg1872g4220gb354ga1442020aae9"
msgid "A god is quite handy when dealing with devils."
msgstr "데빌을 상대할 때 신만큼 효과적인 것도 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 2d9b9875-5515-bc74-10c9-48638baaf384
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:2d9b9875-5515-bc74-10c9-48638baaf384
msgctxt "h3e3f787dg9d69g41b1gab87gc226afbfbe80"
msgid ""
"All thumbs, rather, the way you've been stumbling about the place. But at "
"least I can't say I'm not entertained."
msgstr "비틀거리며 온 사방을 쏘다니는 것보다 어설프기 짝이 없군요. 그래도 보는 맛은 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 306eccaf-f596-03e0-5dc1-bd95927e372d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:306eccaf-f596-03e0-5dc1-bd95927e372d
msgctxt "h7e8a91f7g6f19g4a4ag9dccge99999338ab5"
msgid "I had a feeling the odds weren't in her favour."
msgstr "이길 수 있을 거 같진 않아서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 3655fdb6-01c8-3916-cc90-4af6f15ac2fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Retreat = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:3655fdb6-01c8-3916-cc90-4af6f15ac2fc
msgctxt "h3ef10cc5g7b56g4090gadd3g717fb5312b9b"
msgid "She might have won, you know - if you hadn't made her retreat."
msgstr "아시겠지만, 저 아이가 이길 수도 있었죠. 당신이 후퇴하게 만들지만 않았더라면 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 3776e741-ea4f-f0e4-30de-386f7333bc1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:3776e741-ea4f-f0e4-30de-386f7333bc1e
msgctxt "h85995f40gf9e7g4d3cga4d9g0849ec9a6c85"
msgid ""
"Why would I play a game that imitates war when I can fight any time I want?"
msgstr "원할 때 언제든지 실제로 싸울 수 있는데, 뭐하러 전쟁 흉내내는 게임을 하니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 38325a16-750f-1010-5770-eff37779ab90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:38325a16-750f-1010-5770-eff37779ab90
msgctxt "h3c3e6bc9g89f0g4867gb98cg9e9a271ff9a2"
msgid "You trapped me. I didn't even want to take this one."
msgstr "이거 함정이잖아요. 무슨 수를 놓든 질 것 같은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 38b17dee-dc55-61af-df1d-a751b1a75777
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#.   Object:
#.     - ORI_Inclusion_End_Astarion(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:38b17dee-dc55-61af-df1d-a751b1a75777
msgctxt "h7c334b5bga194g4bb0g8a2cg789f60e83e47"
msgid ""
"Don't worry - I'm motivated to help you. Scars often tell such wonderful "
"stories - I think yours might be truly exquisite. I'll see you soon."
msgstr ""
"걱정하지 마세요. 당신을 돕고 싶으니까. 흉터는 종종 멋진 이야기를 들려주고는 하는데, 당신 흉터라면 정말이지 강렬한 이야기이겠군요. 곧 "
"봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 395e1e3e-767b-ed21-fd50-756f8b1c5969
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Don'tPlay = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:395e1e3e-767b-ed21-fd50-756f8b1c5969
msgctxt "hc2bfaba1g0503g4620ga082g5c36f2f5e6e1"
msgid "Pfft. Guess no one's good at everything."
msgstr "쳇. 역시 모든 걸 잘 하는 사람은 없나 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 3af2b211-6d64-8ecf-8a5f-c3d7ecdf3ab4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:3af2b211-6d64-8ecf-8a5f-c3d7ecdf3ab4
msgctxt "h05dca62egd714g4e49ga341gfff72a3eb3c2"
msgid ""
"She might have won, you know - with a little push in the right direction."
msgstr "이겼을 수도 있었을 텐데, 당신이 맞는 방향으로 살짝 밀어주기만 했다면 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 3dbb411b-abc1-0ed2-ae00-341e69438ba2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:3dbb411b-abc1-0ed2-ae00-341e69438ba2
msgctxt "h0d55e391g4fc4g4c86g9af8g103f0f8b78c7"
msgid ""
"But enough about my lesser pursuits. Why bother with trifles when I'm in the "
"illustrious presence of my very favourite client!"
msgstr "작은 먹잇감에 대해선 이쯤하죠. 사소한 것에 왜 신경 쓰겠습니까, 제일 좋아하는 고객과 영접하고 있는데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 3fe89b79-7b49-d503-a5b7-55407dc2edcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:3fe89b79-7b49-d503-a5b7-55407dc2edcc
msgctxt "h90f930aeg31a3g4c36g8eb5gc6d1fee17d25"
msgid "I don't think he knows."
msgstr "얘가 아는 거 같진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 428973d4-d558-eb1c-0097-a3f5dd7f1d8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:428973d4-d558-eb1c-0097-a3f5dd7f1d8d
msgctxt "h28789e00ga065g4012g96a6g8b09f5d9a0ed"
msgid "She'd never take your word for it - not with my angelic complexion."
msgstr "제 천사 같은 외관으로는 그 말은 절대 믿지 못할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 46354f11-bbfe-dbf5-9074-8b981970d263
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_MolVouched = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:46354f11-bbfe-dbf5-9074-8b981970d263
msgctxt "h0ed07efegdadag4b69ga230gb527a483dea6"
msgid ""
"Look who made it! For once <i>I</i> saved <i>your</i> butt out there, didn't "
"I? We're square now, chief."
msgstr "아니 이게 누구야! <i>내가</i> 한 번 구해줬던 <i>사람</i> 아니야? 이젠 서로 빚진 거 없기야, 대장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 49767124-0fe7-91c7-7d50-5fb90a61d855
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:49767124-0fe7-91c7-7d50-5fb90a61d855
msgctxt "h0ed7451bgc718g4eaagbb45gc598d35982fc"
msgid "A little push away from you is exactly the right direction."
msgstr "네가 있는 곳에서 살짝 밀어내는 게 맞는 방향이라서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 498d7a86-5cd6-23dc-db21-a94cc3bbc543
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:498d7a86-5cd6-23dc-db21-a94cc3bbc543
msgctxt "he6d2faadgdcf1g40c1g97e9g3ffc7be24aba"
msgid ""
"My old - well, a long time ago, someone carved some runes into my back. I'd "
"rather like to know what they say."
msgstr "내 예전... 음, 오래 전에, 누군가가 내 등에 지옥 문자를 새겨 넣었어. 그게 무슨 내용인지 알고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 4b7bff54-07b2-396d-28e8-42ed48b50c18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:4b7bff54-07b2-396d-28e8-42ed48b50c18
msgctxt "h9c4b8c3cg68deg4093gbb68g7fa3183c5507"
msgid "Hmmmm..."
msgstr "흐으음..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 4ca30c66-d935-c8e5-1f03-e1a72651d5a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Theskan = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:4ca30c66-d935-c8e5-1f03-e1a72651d5a9
msgctxt "h9413e6d9g16fdg4e88g8e1dg9f00e884a664"
msgid "The Theskan move suggestion was inspired. I had no idea you played."
msgstr "테스크 말로 제시한 수는 아주 훌륭하더군요. 전에 해보신 적이 있는 줄 몰랐습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 4cedbf87-311b-0884-a874-dd7b7ed02d31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:4cedbf87-311b-0884-a874-dd7b7ed02d31
msgctxt "h53233181gbb5fg4326g83a4g75a5baa4ef0e"
msgid "My favourite kind: ambition."
msgstr "제가 좋아하는 것, 야망입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 5248d1d2-dd61-2d96-d9a2-6bc94e38de58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5248d1d2-dd61-2d96-d9a2-6bc94e38de58
msgctxt "h9c97a05dga94bg429bga0f4g28767baab3de"
msgid "And yet..."
msgstr "그런데 말입니다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 5329446f-450a-c2eb-a40b-2b5613a4d05b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5329446f-450a-c2eb-a40b-2b5613a4d05b
msgctxt "hd6315cb9gd8cdg4639g94faga4966817f63d"
msgid "This is serious business, devil."
msgstr "이건 심각한 일이야, 데빌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 53733815-7671-fd5e-8309-be4ed1631515
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Fighter = True
#.   Tag:
#.      - FIGHTER(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:53733815-7671-fd5e-8309-be4ed1631515
msgctxt "h4f1e77d0g4936g4ab4g88f6g0b47b2985c4d"
msgid ""
"You win by taking the king - attack it at all costs. The Vanquisher's Lance "
"stratagem."
msgstr "킹을 쳐서 이기는 거다, 무슨 수를 써서라도. 그게 정복자의 창 전략이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 5451698c-36ff-a506-5202-3a5e71875e0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5451698c-36ff-a506-5202-3a5e71875e0d
msgctxt "hbe8d0775g1954g4968gbd3agd8ae2622418e"
msgid "You never know what you might find if you just... dig a little deeper."
msgstr "당신이 무엇을 찾을 지 절대 모를 겁니다. 그저... 조금만 더 파보기만 해도 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 55189747-3974-c84b-e574-49b6a10bea6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:55189747-3974-c84b-e574-49b6a10bea6c
msgctxt "h92488ab7g62e1g4ceag8c79g6cef6835608a"
msgid "<i>Rig the game with some sleight of hand.</i>"
msgstr "<i>손재주로 게임을 조작한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 57d5cad1-99fa-9ed2-7e28-619e2442d92d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_WonGame = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:57d5cad1-99fa-9ed2-7e28-619e2442d92d
msgctxt "h75785798g62cfg414eg8202g9b2c14452ed9"
msgid "How's that for Calimshan rules?"
msgstr "칼림샨 규칙이 뭐 어떻다구요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 5802f956-27b4-2808-d21f-b9f9fbf1e10e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5802f956-27b4-2808-d21f-b9f9fbf1e10e
msgctxt "h66d43155g9db6g476cgbd57g70b18c632072"
msgid "You underestimate my magnetism."
msgstr "제 마성을 과소평가하시는군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 591dc89d-7273-f3e1-4d46-f003a1c906ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_Knows_PoemInfernal = True
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:591dc89d-7273-f3e1-4d46-f003a1c906ed
msgctxt "h2b6ec021gb383g4d82g86b4ga1869404ae69"
msgid ""
"My old - well, a long time ago, someone carved infernal runes into my back. "
"They are a fragment of a contract. I'd like to know what the full contract "
"says."
msgstr ""
"내 예전... 음, 오래 전에, 누군가가 내 등에 지옥 문자를 새겨 넣었어. 계약서의 일부라고 하던데, 그 계약 전문이 어떤 내용인지 "
"알고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 5ab10924-75bd-222a-bba8-559fe1a36424
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5ab10924-75bd-222a-bba8-559fe1a36424
msgctxt "hd048c6b4ga141g4863g8a55g8cdf36f116dd"
msgid "That's garbage. No matter where the knight goes, I'm gonna lose it."
msgstr "뭐 그딴 규칙이 다 있어. 나이트를 어디에 놓더라도 잃을 것 같은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 5b96d964-7a00-676d-1ee8-337c6ae28f45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5b96d964-7a00-676d-1ee8-337c6ae28f45
msgctxt "h20e6d504g2918g4ffbgaaabg0aaf3d05f164"
msgid "Say, do you play lanceboard by any chance? It's my first time playing."
msgstr "혹시 랜스보드 해본 적 있어? 난 이거 처음이라서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 5b9dec34-1ae3-c837-9b9e-f4ace04cdd77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5b9dec34-1ae3-c837-9b9e-f4ace04cdd77
msgctxt "hbae0451dg76a9g4686gabccg8fefb2f4e529"
msgid "It's in her best interest to retreat from a devil."
msgstr "데빌에게서 후퇴하는 게 저 아이에게는 최선이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 5c25a084-dab5-f99a-2844-e65369279cb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5c25a084-dab5-f99a-2844-e65369279cb3
msgctxt "h147d70e0g2939g437cga9adg129888135e89"
msgid "See you soon."
msgstr "곧 뵙도록 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 5d6d4967-dc2b-3709-0666-8bdbe010e085
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5d6d4967-dc2b-3709-0666-8bdbe010e085
msgctxt "hb01e6597gb8b7g45b1g9b3fgc5bb66aa03a3"
msgid "<i>'Accidentally' jostle the board Mol's way. </i>"
msgstr "<i>'실수로' 몰 쪽으로 게임판을 밀친다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 5de21a52-720f-5dd4-6fa3-62da846950c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5de21a52-720f-5dd4-6fa3-62da846950c0
msgctxt "hd2771cb9gc66ag4552gac63g1c2250a49c6f"
msgid "There's plenty about me you have no idea about."
msgstr "나에 대해 모르는 건 산더미같이 많을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 5f0f0b9f-f690-a8ee-e1fb-435bc97e1718
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_GaleSuggestion = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5f0f0b9f-f690-a8ee-e1fb-435bc97e1718
msgctxt "h5565df3fg4439g4471gb749gc884c94f9142"
msgid ""
"Gale's right. Put pressure on him. Attack the pieces in front of his Cyric."
msgstr "게일 말이 맞아. 압박하고 들어가면 되겠다. 시어릭 앞에 있는 말들을 공격해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 5f6339d1-1760-ee5c-160e-fa59bb919e61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5f6339d1-1760-ee5c-160e-fa59bb919e61
msgctxt "ha49b20bbg30c8g4f4ag8f65g9a694cb81a7c"
msgid ""
"Didn't ask for your life story - I asked if you could play. What's the next "
"move?"
msgstr "인생사 물어본 건 아니거든. 할 줄 아냐고 물어봤지. 이 다음에 어떻게 움직여야 돼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 5ff7546a-3ae5-e7a7-b79e-ea385758e230
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:5ff7546a-3ae5-e7a7-b79e-ea385758e230
msgctxt "h2b8a6a6ag7106g40edg805bg5b2c7d4250ca"
msgid ""
"Oh, I promise on every treasure I own... you've <i>never</i> dealt with a "
"devil like me before."
msgstr "아, 제 금은보화와 재물을 다 걸고 말씀드리건데... 저 같은 데빌은 <i>절대</i> 상대해보신 적 없을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 66e427cc-d011-2c71-024e-9bbcb1b3d015
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:66e427cc-d011-2c71-024e-9bbcb1b3d015
msgctxt "hf5347d2agdb93g4c6ag8e98ge2f3332464eb"
msgid "You will consider it, won't you?"
msgstr "고려해볼거지, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 68d0c22f-3398-6f7b-f7bf-96bcaa9a4124
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_MolVouched = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:68d0c22f-3398-6f7b-f7bf-96bcaa9a4124
msgctxt "h641b6f17gcdfbg4440gb014g2733489da6aa"
msgid "Hey! What's a big hero like you doing in a dustheap like this?"
msgstr "이런 쓰레기장에 영웅 나리가 어쩐 일로 오셨나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 690637ed-b3d8-2d66-882a-49755cc7783a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:690637ed-b3d8-2d66-882a-49755cc7783a
msgctxt "hfe8b5346gd602g4417gafbag5cf6d1d5015c"
msgid "Well. Now you know."
msgstr "뭐, 이제 너도 알게 됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 6aabf590-3ca9-1176-3c0d-8bc0b643dd5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:6aabf590-3ca9-1176-3c0d-8bc0b643dd5e
msgctxt "h1a1bbf0dg2d19g40f2gab33gc8ccb33053b2"
msgid "Hmm. A-ha - his king is wide open!"
msgstr "흐음... 아하! 저 킹이 완전 노출되어 있네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 6c3ea551-76ae-6874-8077-dd20a5414a88
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Retreat = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:6c3ea551-76ae-6874-8077-dd20a5414a88
msgctxt "ha95f2694ga013g416eg8ba3g0260540c2564"
msgid ""
"You should be more careful who you listen to. Retreat begets regret. Always."
msgstr "누구 말에 귀를 기울일지 더 신중히 해야겠구나. 후퇴는 곧 후회가 된단다. 항상 그렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 6d945fde-5e59-2178-d5fc-bbaa74fa0592
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:6d945fde-5e59-2178-d5fc-bbaa74fa0592
msgctxt "h25b66930g5cfag4d94g876ag2bf8aebc0fdc"
msgid "You came close, though. All you needed was a dash more courage."
msgstr "그래도 거의 다 왔었단다. 약간의 용기만 더 있었다면 이겼을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 701354dd-7c52-07cf-13e0-10d4bb5e2858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:701354dd-7c52-07cf-13e0-10d4bb5e2858
msgctxt "haa4b8290g9628g4343g830fg6ab2695c1ffa"
msgid "I'm afraid you'll find me more difficult to ruffle than that."
msgstr "절 짜증 나게 하려면 그것보단 더한 노력이 필요할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 70249fa1-1be6-c319-3f7b-6448b9f3c5d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:70249fa1-1be6-c319-3f7b-6448b9f3c5d9
msgctxt "h386a45e9g9173g47bag8197gadd40e081edf"
msgid "She has a right to know your truer nature."
msgstr "이 녀석은 네 진정한 본성을 알 권리가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 7188c4ff-f768-21ce-b58e-10c132333c0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:7188c4ff-f768-21ce-b58e-10c132333c0f
msgctxt "hc2f4a96cgf86ag43d7gbda5gbbdbb2a3020d"
msgid "I do. I have a proposal for you."
msgstr "그래. 제안할 게 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Gale
#. NodeID = 729de007-729c-4562-aa77-fc5fb219fbdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:729de007-729c-4562-aa77-fc5fb219fbdf
msgctxt "hcb31b76fgbff9g443dgba84ga520ec3b20f4"
msgid "<i>Exactly </i>what I was about to suggest."
msgstr "<i>그게 바로</i> 내가 제안하려 했던 수야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 763c34c5-efa9-78ea-108f-6ff4727d5502
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:763c34c5-efa9-78ea-108f-6ff4727d5502
msgctxt "h7b22dd83g2bb9g4e9cgbb73gc4854e1e4179"
msgid ""
"I - perhaps I should have. I'm not exactly used to asking for help and being "
"met with, well... help."
msgstr ""
"아- 어쩌면 미리 말했어야 했을지 모르지. 그렇지만 난 도와달라고 말해본 적이 별로 없어서 말이야. 도움을 받아본 적도... 그렇고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Gale
#. NodeID = 7672c063-807b-43df-8f90-85eec9445399
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(2) = False
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_GaleSuggestion = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:7672c063-807b-43df-8f90-85eec9445399
msgctxt "hae3fbeaagc097g49fegad93g19be4f64ff9d"
msgid ""
"He's laid a fine trap for you, Mol. But it looks to me like his Cyric could "
"be dethroned."
msgstr "저 자가 제대로 함정을 파 놨구나, 몰. 하지만 내가 보기엔 저 시어릭을 잡을 수 있을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 77bcacd5-9625-b4ba-94af-13342a292c68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Q-Tragedy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:77bcacd5-9625-b4ba-94af-13342a292c68
msgctxt "h9f9f6a42gce8fg4512g9cc5g8d771e6875d0"
msgid "I can't resist a good tragedy. Indulge me - what happened here?"
msgstr "비극은 또 그냥 넘길 순 없지. 한번 말해봐, 여기서 무슨 일이 있었는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = 77cac185-f2de-537e-5822-48b78cba4efa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = False
#.      - GOB_State_LeadersAreDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:77cac185-f2de-537e-5822-48b78cba4efa
msgctxt "h7392e148g44edg4662g8727g810315df3818"
msgid ""
"Oh, hey. I remember you. Booked it from the grove before the druids could "
"kick us."
msgstr "아, 안녕. 당신 기억해요. 드루이드가 우리 쫓아내기 전에 숲에서 떠났었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 7845f043-bc76-2fbe-60ba-a0d0995abe2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:7845f043-bc76-2fbe-60ba-a0d0995abe2e
msgctxt "h404a0cb4g2308g49a0g84a8g5e4c6686ba9f"
msgid ""
"But of course, you'll have to do something for me first. Let me think about "
"it and get back to you."
msgstr "물론 그 전에 앞서서, 제게 뭔가를 해주셔야겠군요. 생각을 좀 해 보고 다시 돌아오도록 하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 7c444837-1331-e07d-8def-156242962568
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:7c444837-1331-e07d-8def-156242962568
msgctxt "hc0b8ac50gd78fg4ea6ga8d6gfd6eb64161b4"
msgid ""
"Now, let's talk about you. I sense there's something you want to ask me."
msgstr "이제 당신 얘기를 좀 해 봅시다. 제게 부탁할 게 있으신 것 같은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 8382cfbf-8653-2262-8f6c-9aa55753488b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_MolsDeal_State_WonGame = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:8382cfbf-8653-2262-8f6c-9aa55753488b
msgctxt "h2ba4d9c4g73fbg425eg9b84g3998a14683cd"
msgid "She won. She has a taste for it now. She'll be the one who comes to me."
msgstr "몰은 승리했고 그리고 이제 그 맛을 알았죠. 저 아이는 <i>절</i> 찾아오게 될 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 844b5ca1-6bb5-1488-28c4-195d54531701
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:844b5ca1-6bb5-1488-28c4-195d54531701
msgctxt "h315cad44g5bc4g4675g9b47ge704a1d7dac7"
msgid "I really am at my magnanimous best when people make an effort."
msgstr "전 노력하는 사람에게는 아주 관대합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 857ee210-5848-bc7f-646f-1d439fc317f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_FailCheat = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:857ee210-5848-bc7f-646f-1d439fc317f4
msgctxt "ha299e688gadcbg44faga95dg38d101e274ee"
msgid ""
"She might have won, you know. There was no need for your attempt at sabotage."
msgstr "몰이 이겼을 수도 있었을 텐데. 당신이 방해할 필요도 없었습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 85899ecb-f78b-4b75-242d-fb727926e5f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = False
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Q-Tragedy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:85899ecb-f78b-4b75-242d-fb727926e5f1
msgctxt "h1427a84dgab8bg4d55g940fgffaf92b52289"
msgid "So what is this region's history of tragedy?"
msgstr "그래서 이 곳의 비극의 역사란 게 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 87e949e2-337e-bccf-6f55-5f4fff1406dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:87e949e2-337e-bccf-6f55-5f4fff1406dc
msgctxt "h0d77df14g5421g48f1g9607g231e058fff16"
msgid ""
"He's set up a clever little trap. <i>But</i>... his Cyric looks rather open, "
"don't you think?"
msgstr "영리한 함정을 파 놓았군. <i>그렇지만</i>... 저 시어릭이 좀 노출되어 있는 것 같은데, 안 그렇니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 8acba16e-998f-5651-0e6f-c1f685c9ae92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:8acba16e-998f-5651-0e6f-c1f685c9ae92
msgctxt "hc6cc44c8g299fg42b8g92afgb62b9e63524a"
msgid "Why not let them see? Don't be shy."
msgstr "친구들한테 보여주시지 그래요? 부끄러워하지 말구요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 8d2e7c7b-181f-2953-7cf8-85d0c5b210e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:8d2e7c7b-181f-2953-7cf8-85d0c5b210e7
msgctxt "hce567168g32cdg4886ga100g81dc8789968b"
msgid ""
"I have this picture in my head - of you tossing and turning in the middle of "
"the night, thinking strange things, dreaming strange dreams."
msgstr "한밤중에 뒤척이며 이상한 생각을 하고 희한한 꿈을 꾸고 있는 당신의 모습이 자꾸 제 머릿속에 떠오르는군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 90c164fa-61d4-d4eb-389c-bc20cfda28b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:90c164fa-61d4-d4eb-389c-bc20cfda28b2
msgctxt "he3e4ebe5g232dg4466g98dcg607f06ae8275"
msgid "It was a rough night."
msgstr "견디기 힘든 밤이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 90f7b146-6bd6-2268-5470-66ea07205954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:90f7b146-6bd6-2268-5470-66ea07205954
msgctxt "h637ec87bg0346g491ega846gd02575e91cb1"
msgid "Why didn't you tell me earlier? I could have helped."
msgstr "왜 더 빨리 얘기하지 않았어? 내가 도울 수도 있었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 913d969c-0267-077f-3636-9332d84e6dbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:913d969c-0267-077f-3636-9332d84e6dbf
msgctxt "headec9d8g55f6g4838g8267ga32f6197304c"
msgid "Gods... the carving must have been excruciating."
msgstr "맙소사... 그거 새기는데 완전 고문이었겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 9186e787-2021-c638-5d93-2556f5070d61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Devil = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9186e787-2021-c638-5d93-2556f5070d61
msgctxt "h542e6a8cg7612g4c54g9bb4ga3627ce00ea0"
msgid ""
"She might have won, you know - if you hadn't been so hell-bent on exposing "
"my truer nature."
msgstr "당신이 제 본성을 실토하느라고 활활 타오르지만 않았어도 몰이 이겼을 수도 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 9343f631-d818-8376-6edb-e535f29a8868
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9343f631-d818-8376-6edb-e535f29a8868
msgctxt "hf30c8311g0788g4646gb0c3g8f8f55f9ebac"
msgid "All I know is you have us doing odd jobs for a devil."
msgstr "확실한 건 이제 네 덕분에 데빌의 부탁을 들어줘야 한다는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 93886be6-4f2b-8849-ea32-cf2aa8541e88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Cheat = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:93886be6-4f2b-8849-ea32-cf2aa8541e88
msgctxt "h84d98c56g234dg4324g8bf0g20586ad02c52"
msgid "She cheated, of course, but that's half her charm."
msgstr "물론 속임수를 쓰긴 했지만, 그게 또 저 아이가 가진 매력의 반이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 93b8d601-5aee-1d5d-60fe-3f12b6ebbaef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:93b8d601-5aee-1d5d-60fe-3f12b6ebbaef
msgctxt "ha2fcebb9g3f4ag4060g8a1agd8f56ba8ca98"
msgid "So it seems."
msgstr "그런 것 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 93cdeb6e-4790-62ef-cca7-3f3f13c891d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:93cdeb6e-4790-62ef-cca7-3f3f13c891d0
msgctxt "he76f0294g3cb9g46dfgbdb4ga9adda26422e"
msgid "Come now, you'd have me tell you? Spoil all the fun?"
msgstr "에이, 그걸 말하라고요? 그러면 재미없지 않겠습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 96f7da48-6e41-835d-ef70-7bf91b37baf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:96f7da48-6e41-835d-ef70-7bf91b37baf0
msgctxt "h24daeaf0g617cg4f19g83f0g12327d0640ed"
msgid "Hell is wherever I take it. I just call it Hope, remember?"
msgstr "제가 가는 곳이 곧 지옥이죠. 전 그걸 희망이라고 부릅니다, 기억하십니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 9795c627-28dc-b629-595b-aa5cacd3dee0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9795c627-28dc-b629-595b-aa5cacd3dee0
msgctxt "hd04b162egec4fg4a1ag8cecga520043e80d5"
msgid "They always do."
msgstr "다들 그렇게 생각하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 985f9593-d8ed-2427-c7db-7e4ba90c182a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_Event_FinishedGame = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:985f9593-d8ed-2427-c7db-7e4ba90c182a
msgctxt "h57207bacg092cg4c01gbf24g57b252fbd0f2"
msgid "What a lovely specimen she is. A blushing apple, begging to be plucked."
msgstr "정말 사랑스러운 표본이지 않나요. 마치 빨갛게 익은 사과가 따달라고 애원하는 것 같지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 9a844034-bba3-ee85-5bd4-c1c7f4e246c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9a844034-bba3-ee85-5bd4-c1c7f4e246c5
msgctxt "hd373bb38gadecg48a0g9e39g5d3c740358cc"
msgid "All in good time, dear."
msgstr "다 괜찮아질겁니다, 친구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 9b529679-bc3a-bd00-05bd-9d75d94bcdc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9b529679-bc3a-bd00-05bd-9d75d94bcdc5
msgctxt "hd0404335g1f41g41daga65ag793a81a96b94"
msgid "I can most <i>certainly</i> believe it."
msgstr "<i>정말</i> 그런 것 같습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = 9cc5b1f3-964e-e661-0632-48f46ca745a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9cc5b1f3-964e-e661-0632-48f46ca745a0
msgctxt "hfeee2b06g8533g4655g90a8g967118e57821"
msgid ""
"Calimshan fell because its nobility got cocky. Put pressure on his king."
msgstr "칼림샨은 귀족이 너무 거만해서 몰락했다. 킹을 압박해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = 9d7d462b-10c8-0340-4796-2a55f16dce36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9d7d462b-10c8-0340-4796-2a55f16dce36
msgctxt "h98e703b6g4ceag487dg98acga9c287f61e34"
msgid "You'll 'get back' to me? This is important, devil. When?"
msgstr "다시 돌아온다고? 이건 중요한 일이야, 데빌. 언제 돌아온다는 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = 9d9ad452-b591-d0e5-860e-8563e3afc860
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#.   Object:
#.     - ORI_Inclusion_End_Astarion(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:9d9ad452-b591-d0e5-860e-8563e3afc860
msgctxt "hb0e8c657ga29dg4a53g951bge4d32b0ea4fd"
msgid ""
"Don't worry - I'm motivated to help you. Scars often tell such wonderful "
"stories - I think yours might be truly exquisite. I'll see you soon."
msgstr ""
"걱정하지 마세요. 당신을 돕고 싶으니까. 흉터는 종종 멋진 이야기를 들려주고는 하는데, 당신 흉터라면 정말이지 강렬한 이야기이겠군요. 곧 "
"봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = a12884a1-2192-9a7a-98b0-90cdefabdf54
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:a12884a1-2192-9a7a-98b0-90cdefabdf54
msgctxt "hd9883fc2g3d32g45ffgb6b0g89ccacfeeee8"
msgid "Someone's gotta look out for her."
msgstr "누군가는 이 녀석을 신경 써 줘야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = a3bc00cb-50bf-a445-9de4-6ee90237c46a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Fighter = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:a3bc00cb-50bf-a445-9de4-6ee90237c46a
msgctxt "h0c0d28e1gd042g4d38gbb63g4244c2aff7f6"
msgid "Sorry, kid. I've never played lanceboard."
msgstr "미안하구나, 꼬마야. 랜스보드는 해본 적 없어서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = a7b6fec8-804c-23f2-49d3-5538512c1406
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Theskan = True
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_DivineIntervention = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:a7b6fec8-804c-23f2-49d3-5538512c1406
msgctxt "h47948ce7g6f7cg4066g9539g6051a4d8a874"
msgid ""
"Her victory was hollow, of course. Frankly, I expected better of you - did "
"Mol <i>ask</i> to have your god win the game for her?"
msgstr ""
"저 아이는 헛된 승리만 쟁취했을 뿐입니다. 솔직히 당신이 그것보다는 더 나은 수를 보여주길 바랐습니다만, 몰이 당신의 신에게 게임에서 "
"이기도록 도와달라고 <i>부탁</i>이나 했습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = a7eafd34-ae5d-2190-d8e3-c33865c5efa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:a7eafd34-ae5d-2190-d8e3-c33865c5efa8
msgctxt "heddb2b8dg185bg4210g9b91g34d0b5c542c3"
msgid "Brava! Lovely work. I see I was right to make you the offer I did."
msgstr "브라보! 아주 훌륭해. 너에게 그 제안을 하길 잘한 것 같구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = aa532d4c-c523-b519-539a-1836cd9a5ecc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:aa532d4c-c523-b519-539a-1836cd9a5ecc
msgctxt "h0b1746c4gb16fg4848ga46dg5f6db19f044a"
msgid "Look outside. There's no one else for her to run to."
msgstr "바깥을 좀 보세요. 저 아이가 누구 품으로 도망칠 수 있겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = ab6d19fd-b865-dbb5-db62-8d1008e11137
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ab6d19fd-b865-dbb5-db62-8d1008e11137
msgctxt "h6d91087bga1f3g45f8g9ce4g8cfd7344511d"
msgid "Gods damn it."
msgstr "이런 젠장할."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = abc6875f-f43b-bf02-b783-1e86a624272f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:abc6875f-f43b-bf02-b783-1e86a624272f
msgctxt "hecfc354dg32b5g4a19g96b1gc5eb704537a4"
msgid "I'll not take lessons on morality from a devil, thanks."
msgstr "데빌한테서 도덕에 관한 가르침은 듣고 싶진 않군, 사양하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = abc9c9c5-8567-4b5c-6093-ad6f89db1974
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:abc9c9c5-8567-4b5c-6093-ad6f89db1974
msgctxt "h59d35c30gdb5eg4041ga7a9gee3677db0eaf"
msgid ""
"She lost. She <i>is</i> lost. It's only a matter of time before the apple is "
"plucked."
msgstr "그녀는 패배했군요. <i>져버렸습니다</i>. 이제 탐스러운 사과가 제 손에 들어오는 것은 시간문제입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = ac2763b3-205e-072d-88dc-54e275ed23d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ac2763b3-205e-072d-88dc-54e275ed23d4
msgctxt "h718b6148ga42bg4369g9717g12bf24663dac"
msgid "Mine."
msgstr "제 목소리죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = ac726c4d-01cd-31bd-9fad-b1bbf6256db7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ac726c4d-01cd-31bd-9fad-b1bbf6256db7
msgctxt "h627ac6dfgab91g4519g8999ge2185dec74d1"
msgid "A list of my many hidden talents would stretch to Avernus and back."
msgstr "나의 숨겨진 재능 목록 적자면 아베르누스까지 닿을 정도일 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = ad7e6774-2674-a971-dab1-2017845ecacb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ad7e6774-2674-a971-dab1-2017845ecacb
msgctxt "h4b65ab8dga0a7g47dagae49ge8ccd1ddb3ef"
msgid ""
"It's something very important to your master. But is it a love letter, a "
"warning, or a deed of ownership? I could give you all the gory details."
msgstr ""
"당신의 주인에게 매우 중요한 거겠지요. 연애편지이려나? 아니면 경고문? 소유권 증서? 내가 그 피 냄새 가득한 내용을 알려 줄 순 "
"있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = adc0d7aa-ca98-1499-2464-d1228525c30c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_LostGame = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:adc0d7aa-ca98-1499-2464-d1228525c30c
msgctxt "h9b15c1adg0411g480bgb84ag2b239fc4533d"
msgid "<i>Hells. </i>Thought I had you."
msgstr "<i>젠장.</i> 다 이긴 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = afe8bb85-9425-fcfe-c587-c53e1d3ac259
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:afe8bb85-9425-fcfe-c587-c53e1d3ac259
msgctxt "h39169ae8g0491g4325g8622g0f2e57b4af8b"
msgid "To play <i>the</i> game. The vast lanceboard of souls."
msgstr "<i>그깟</i> 게임이 아닙니다. 영혼들이 벌이는 방대한 랜스보드지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = b113efdf-0e6f-fa1d-fd66-f66a60c98d4f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:b113efdf-0e6f-fa1d-fd66-f66a60c98d4f
msgctxt "h1c950277g541cg4840g91b5g29c58bcb8135"
msgid "I figured the girl could handle herself."
msgstr "알아서 하겠거니 생각했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = b2238ca6-de9b-b167-1cf2-b84b472744c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = False
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:b2238ca6-de9b-b167-1cf2-b84b472744c4
msgctxt "hbc296c44gd64ag408eg8949gd85ca035df8b"
msgid "I want to know about the scars on my back. What do they mean?"
msgstr "등에 있는 흉터에 대해 알고 싶어. 이게 무슨 의미인지 말이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = b2883e89-7740-9bb9-fa70-ed93c739be13
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:b2883e89-7740-9bb9-fa70-ed93c739be13
msgctxt "h8954b7a3g8119g459fg8ff8gb68cc22e57c5"
msgid "Anything to annoy a devil."
msgstr "데빌을 짜증나게 할 수 있다면 뭐든 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = b2bae2de-028d-484c-fa6b-34213302dd29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:b2bae2de-028d-484c-fa6b-34213302dd29
msgctxt "h16b2fd79gc733g4687g9d42ga34ef6fe0811"
msgid ""
"Tell me, O apple of my eye, how have you been? You don't have any gills to "
"get green around yet, but you do look a bit worse for wear in this light."
msgstr ""
"그간 어떻게 지내셨는지 여쭤봐도 될까요? 아직까진 그렇게 안색이 나쁘진 않아 보이지만, 이렇게 보니까 또 아닌 거 같기도 하네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = b7b22ce9-5332-102d-eeaf-734a6504a538
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:b7b22ce9-5332-102d-eeaf-734a6504a538
msgctxt "h7a0f3be3ga7f7g46b8gad39ga836faf7c3cf"
msgid "You will remember that, won't you, when you consider my offer?"
msgstr "그 용기 말이야, 내 제안을 고려할 때에도 기억하는 게 좋을 거란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = b859dd00-abcd-556c-ad8f-3ce82def8f16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:b859dd00-abcd-556c-ad8f-3ce82def8f16
msgctxt "hfb6a0997ga290g4bd5g98d9g447397dd8d05"
msgid "And tragedy, my friend, well there's my bread and bloody butter."
msgstr "비극이야말로 제게는 피와 살이 되는 밥줄 아니겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = ba400d8d-a173-2847-9aff-f1c83d011812
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ba400d8d-a173-2847-9aff-f1c83d011812
msgctxt "h8c47f8c2ga76fg4a46gba25g55beafb82f93"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Gale
#. NodeID = ba8926fa-273d-3e53-2104-db5fe2a43abc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ba8926fa-273d-3e53-2104-db5fe2a43abc
msgctxt "hd567bd34g7fd5g483eg8f6dg47c96f7e8fa1"
msgid ""
"That's... certainly another strategy. A losing one, but a strategy "
"nonetheless."
msgstr "그건... 확실히 다른 전략이군. 패배하는 것이긴 하지만, 전략은 전략이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = bc25c65b-1aa3-5b49-1a40-6d8e0c20b741
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:bc25c65b-1aa3-5b49-1a40-6d8e0c20b741
msgctxt "h783349e9g60ffg4e98g807egc303a69f1ef1"
msgid "Beating devils brings out the best in me."
msgstr "데빌한테 한 방 먹여주는 일이라면 최선을 다하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = bdb7fa9e-44b3-c9b3-fdc7-1db8e0faf579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:bdb7fa9e-44b3-c9b3-fdc7-1db8e0faf579
msgctxt "hcce70bc2g463ag46d2ga0deg63e86b4c8909"
msgid ""
"Cazador worked on it from dusk until dawn, all with an ancient blade he "
"called his 'needle'. Cutting and tearing, starting over if I screamed or "
"winced too much."
msgstr ""
"카사도어가 해 질 녘부터 동틀 때까지 '바늘'이라고 하는 고대 단검으로 새겨넣었지. 비명을 지르거나 너무 움찔거리면 처음부터 또 살을 "
"자르고 찢었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Gale
#. NodeID = be124bc1-c33c-77d3-6253-bfcd2586d70c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:be124bc1-c33c-77d3-6253-bfcd2586d70c
msgctxt "he9aea185g3a8ag40a0g913bg88e2b05cd5c8"
msgid ""
"I see that glint in your eyes. You've a strategy in mind. The same one as "
"me, I'd wager."
msgstr "눈빛 반짝이는 거 다 봤어. 머릿속에서 전략을 짜고 있는 것 같은데. 내가 생각하는 것과 같은 걸지도 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = bed6e10c-ea49-ba2b-4440-e81c5c38866d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = False
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:bed6e10c-ea49-ba2b-4440-e81c5c38866d
msgctxt "hddca7a8fg0ad1g4025g9a31gd02c64acff51"
msgid ""
"Speaking of bloody - the scars on my back. Can you tell me what they mean?"
msgstr "피 관련한 얘기가 나와서 그런데, 내 등 뒤에 있는 흉터 말이지. 이게 뭔지 알려줄 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = bf1acd3b-5914-bb3c-1b1b-ff6730431870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:bf1acd3b-5914-bb3c-1b1b-ff6730431870
msgctxt "hd613796bgd8b2g4625g8532g17ad6bf9c2d5"
msgid ""
"Then make the sacrifice useful. Guard your Mystra, or come for my Cyric."
msgstr "그럼 그 희생을 쓸모있게 만들어야지. 네 미스트라를 지키거나, 내 시어릭을 잡으러 와도 된단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = c0c29a26-2203-8f4a-cfc7-0e2625f0fc82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:c0c29a26-2203-8f4a-cfc7-0e2625f0fc82
msgctxt "h15749c0ag617cg43eeg809dg45caff6960f0"
msgid "Is that why you're here? To play games?"
msgstr "저거 하려고 여기 온 거야? 그깟 게임이나 하려고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = c2abf42b-4d04-bc1f-ca05-b651a87a32bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:c2abf42b-4d04-bc1f-ca05-b651a87a32bd
msgctxt "h9c31f303g0e38g48f0gb75dg135e5401fcbc"
msgid ""
"But of course, those curious little marks. Something important to your "
"master, no doubt, but what?"
msgstr "물론, 그 수수께끼 같은 조그만 기호 말하는 거겠죠. 틀림없이 당신 주인에게 아주 중요했던 거 같은데, 그게 대체 뭘까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = c8048014-1022-4fbd-104e-01238020776f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:c8048014-1022-4fbd-104e-01238020776f
msgctxt "hb5302e09g8680g402dga47ag9e0732c9a3ec"
msgid "I guess we'll never know."
msgstr "뭐, 어떻게 됐을진 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = ca80c6ae-60d8-c222-f5eb-d96abebdfac2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC(2) = True
#. SetFlags:
#.   Local:
#.     - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_DivineIntervention = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ca80c6ae-60d8-c222-f5eb-d96abebdfac2
msgctxt "h4b322a6cg71a4g401bga770g26a5fc0b9edb"
msgid ""
"<i>Say you don't want to interfere and pray for your god to guide Mol's "
"hand.</i>"
msgstr "<i>간섭하고 싶지 않다고 말하고, 몰의 다음 수를 인도해달라고 당신의 신에게 기도를 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = ce47ec19-6c1b-bab9-25bf-26295feda98e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ce47ec19-6c1b-bab9-25bf-26295feda98e
msgctxt "hb49716ebg64c5g497cg94e2g515e3e727576"
msgid "Oh dear, aren't we clumsy? Let me put these back in place."
msgstr "오 얘야, 약간 어질러지지 않았니? 다시 제자리에 놓아야겠구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = d2222731-eafa-95a1-bc72-7b478f8aaaad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:d2222731-eafa-95a1-bc72-7b478f8aaaad
msgctxt "h2483737fg678fg4a93gadd9g97d7a7b1116b"
msgid "Although I should probably get dressed first..."
msgstr "일단 옷부터 다시 입어야겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = dad84557-99e5-710f-d2e7-2645b9d01871
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:dad84557-99e5-710f-d2e7-2645b9d01871
msgctxt "h3c98186egf7e5g427fgb1ffga1165c7d535f"
msgid "Leave me alone, hellspawn."
msgstr "꺼져, 지옥의 자손아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = dc382bb9-60c0-927d-d4d3-06e05449c79b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:dc382bb9-60c0-927d-d4d3-06e05449c79b
msgctxt "hfa39c58ag3e1ag4bd7g98d0g9963b1ec888d"
msgid "A pity no one did the same for you, all those years ago."
msgstr "당신을 그렇게 신경 써줄 사람이 그 오랜 시간 동안 아무도 없었다는 게 참 유감이긴 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Karlach
#. NodeID = dc95f492-20cc-4ad4-9f4d-4f9c6ef1b549
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:dc95f492-20cc-4ad4-9f4d-4f9c6ef1b549
msgctxt "h8b361935gbd38g468cga010gc4a6adb34554"
msgid "What's going on here?"
msgstr "뭐 하고 있는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = dcb5e837-e078-0b51-fe10-c71d8c812914
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:dcb5e837-e078-0b51-fe10-c71d8c812914
msgctxt "h09df7ee5ge875g4805gb364gccc2d6f63ac4"
msgid ""
"Calimshan rules, dear. The first piece touched is the first piece moved."
msgstr "칼림샨 규칙이란다, 얘야. 말을 만지면 반드시 그걸 움직여야 한단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = dd5aecec-9c82-66ee-c8cc-c6be9a478057
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:dd5aecec-9c82-66ee-c8cc-c6be9a478057
msgctxt "h3257c5adg33e7g4a82gb4cfgd4a1201433bd"
msgid "Don't I, indeed..."
msgstr "물론, 모릅니다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Mol
#. NodeID = df6a31c4-69ef-e741-52e3-16b4d78f65d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:df6a31c4-69ef-e741-52e3-16b4d78f65d6
msgctxt "hd5a2691bgd92dg4160g9f6bgb7e3c9375cee"
msgid "Smart. You smart enough for lanceboard? It's my first time playing."
msgstr "당신 똑똑하잖아요. 그럼 랜스보드도 잘 하시겠네요? 난 이거 처음인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = df921a8f-0875-27f3-634e-1701e0515a97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:df921a8f-0875-27f3-634e-1701e0515a97
msgctxt "h1d098831g1bf8g4ebdgad3cgf093f966860a"
msgid ""
"But what's done is done, so how about we stop talking about it and just get "
"on with things?"
msgstr "이미 끝난 일이야, 그러니 이 얘기는 그만하고 하던 일이나 계속하는 게 어떻겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = e28fe007-6296-8653-3d9b-f78a7b459344
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:e28fe007-6296-8653-3d9b-f78a7b459344
msgctxt "h0ee725f6g733fg4632gad00gbccf7e84a753"
msgid ""
"But don't you worry about Mol - it goes without saying she still has the "
"unconditional freedom to choose the only option she has left."
msgstr ""
"뭐 몰은 걱정할 필요 없습니다, 아직 저 아이에게 유일하게 남아있는 선택지를 고를 수 있는 무한한 자유가 남아있다는 건 말할 필요도 "
"없고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = e37f3d2a-8160-3322-c4a9-d359b6c786d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:e37f3d2a-8160-3322-c4a9-d359b6c786d6
msgctxt "h8ccce86cga28cg4350ga1ceg0fd8879eb6cb"
msgid "Just bugger off back to Hell, would you?"
msgstr "그냥 지옥으로 썩 꺼지시지, 좀?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = e3a25941-c9b8-3010-e0e7-61f42935f766
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Fighter = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:e3a25941-c9b8-3010-e0e7-61f42935f766
msgctxt "h0b7027bfgfe69g459bga2dbgd902ce3de642"
msgid "Fall back. Protect your queen above everything else."
msgstr "후퇴해. 퀸을 최우선으로 지켜."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = e3b13986-8192-f0fd-9d3d-baf50c9412c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_Theskan = False
#.      - dad63dde-f309-491a-1edb-b3ced9a1fccd_Chess_DivineIntervention = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:e3b13986-8192-f0fd-9d3d-baf50c9412c0
msgctxt "h8777c139g32a0g45eag8c18gbb34cbbf5653"
msgid ""
"I noticed your little trick, by the way. You should trust Mol - she never "
"asked for your god to interfere in the game."
msgstr "그건 그렇고, 당신이 한 장난질은 알고 있습니다. 몰을 좀 더 믿으셔야죠, 당신의 신에게 도와달라 한 적도 없잖습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = e941ede9-1985-cfd0-f203-73343c7741cb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:e941ede9-1985-cfd0-f203-73343c7741cb
msgctxt "h128ded8dg54fdg4887g83a7ge2344c8920c1"
msgid "You know this guy's a devil, right, Mol? No beating one of them."
msgstr "이 남자 데빌인 거 알지, 몰? 이길 수 없는 게임이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = e941ede9-1985-cfd0-f203-73343c7741cb
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:e941ede9-1985-cfd0-f203-73343c7741cb
msgctxt "h848ac598g48edg43e4g99a6ga001052d0e8f"
msgid "You shouldn't be playing games with this man. He's a devil."
msgstr "이 사람이랑 게임하면 안 돼. 데빌이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Raphael
#. NodeID = ec4f6f53-02bf-bd0e-8ee7-2b233b7118e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#.   Object:
#.     - ORI_Inclusion_End_Astarion(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ec4f6f53-02bf-bd0e-8ee7-2b233b7118e1
msgctxt "h5c697c59gffdag4eb1g8693g338fe27709b7"
msgid ""
"Don't worry - I'm motivated to help you. Scars often tell such wonderful "
"stories - I think yours might be truly exquisite. I'll see you soon."
msgstr ""
"걱정하지 마세요. 당신을 돕고 싶으니까. 흉터는 종종 멋진 이야기를 들려주고는 하는데, 당신 흉터라면 정말이지 강렬한 이야기이겠군요. 곧 "
"봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = ef0ce83b-0f30-c39d-2bc0-653b2b6cd0a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:ef0ce83b-0f30-c39d-2bc0-653b2b6cd0a4
msgctxt "hcb5f903bgf279g4e2cg93bdgb50e87f1c216"
msgid "Might be the infernal engine in my chest."
msgstr "내 안에 있는 지옥 엔진 때문일 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = efaa877f-39de-50f7-7f6a-86b45fbab011
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:efaa877f-39de-50f7-7f6a-86b45fbab011
msgctxt "hcdae2be9gceabg4507ga4d7geaf9bd7f3305"
msgid "Leave her alone. I'm warning you."
msgstr "꼬맹이한테 손 떼. 경고다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = f186135d-748b-fa0b-120e-21131bf30eee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:f186135d-748b-fa0b-120e-21131bf30eee
msgctxt "he6e833cdgdcc3g4f81gb69dg053511fe45a9"
msgid ""
"It could be infinitely worse. We seem to be rather good at killing things."
msgstr "이 정도면 그래도 괜찮은 거야. 뭘 죽이는 건 우리가 잘 하는 것 같으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = f786e2e0-9b13-fced-4957-3a6c7558f307
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:f786e2e0-9b13-fced-4957-3a6c7558f307
msgctxt "h2e538523g23b1g4897ga4c5g695db5d85dad"
msgid "You know, I've never been better."
msgstr "알고 있겠지만, 아주 잘 지내."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = f8bab497-a27f-cf65-faae-d9d7780c8616
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:f8bab497-a27f-cf65-faae-d9d7780c8616
msgctxt "h911518f9ga498g4fe9gbd73gf97e8dcc14a2"
msgid "Don't play games, Raphael. Help him out."
msgstr "놀리지마 라파엘. 그냥 좀 도와줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = fa937f2e-b2e8-5384-fe85-0b9e56482ded
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:fa937f2e-b2e8-5384-fe85-0b9e56482ded
msgctxt "hbaa4e5c2g6371g4f06g818cg560301d0ccfa"
msgid ""
"This is a game that tests your mind. Look at the board with fresh eyes - "
"what does your opponent hide?"
msgstr "이건 네 정신을 시험해보는 게임이야. 새로운 시각으로 판을 한번 봐 보렴. 상대가 숨기고 있는 게 뭘까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Player
#. NodeID = fbe1144f-f1b3-1fe0-6f06-d80f4c2dbe16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:fbe1144f-f1b3-1fe0-6f06-d80f4c2dbe16
msgctxt "h04a32c97g44bag46e6gac1cg2eefbead7567"
msgid "If you're still offering solutions, I'm all ears."
msgstr "전에 제시한 해결책이 아직 유효하다면 한번 들어보겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay
#. Speaker = Astarion
#. NodeID = feab9089-5db1-e203-a203-6eec95673fe0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Lanceboard_ThreeWay:feab9089-5db1-e203-a203-6eec95673fe0
msgctxt "hf7877946g49d1g470dg8adegf5a64abcdc27"
msgid "Let's just go. Standing here chatting gets us nowhere."
msgstr "그냥 넘어가자. 여기서 서서 얘기하는 건 아무 의미 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 02cb13f0-47b5-6939-fd07-86f6fefae8d5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Local:
#.      - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = False
#.   Tag:
#.      - CLERIC(1) = True
#.      - WARLOCK(1) = False
#. SetFlags:
#.   Local:
#.     - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:02cb13f0-47b5-6939-fd07-86f6fefae8d5
msgctxt "h2ec66ad1g2314g422cgba45gcfcf961b02d9"
msgid ""
"Raphael is a real, literal devil. These creatures care not for you - only "
"your <i>soul.</i>"
msgstr "라파엘은 진짜, 말 그대로 악마야. 그런 괴물들은 네 안위 따위는 개의치 않아. 오직 네 <i>영혼만을</i> 탐내지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 0cd4c87f-27f5-fe82-dd67-1e96bbc43eba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:0cd4c87f-27f5-fe82-dd67-1e96bbc43eba
msgctxt "h796813d1g89b0g4f2fgb8acgf66fee617534"
msgid "Did he deal with you straight? Heard you two talking."
msgstr "라파엘이 너하고는 솔직하게 거래했어? 너희 둘이 이야기하는 걸 들었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 0da4aa5c-ed74-4474-b702-e3ffddb1be00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:0da4aa5c-ed74-4474-b702-e3ffddb1be00
msgctxt "hcaac7564g2bf5g4d60gbf0fg73047aaba049"
msgid "You must love the taste of it. He seems to know you pretty well."
msgstr "당해본 모양이네. 보아하니 라파엘은 널 잘 아는 것 같던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 0dbfaa15-36c7-0bfb-3333-076b90309bd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - GOB_State_LeadersAreDead = True
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingHav = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:0dbfaa15-36c7-0bfb-3333-076b90309bd5
msgctxt "hdb41ec19gd628g4505ga8c9gf040912de1e3"
msgid ""
"Look, you saved us. Not knockin' that. But after you left, Zevlor lost his "
"nerve - gave up the fight. I won't."
msgstr ""
"이봐, 네가 우리를 구해준 건 알아. 그걸 걸고 넘어질 생각은 없어. 그렇지만 네가 떠나고 난 뒤로 제블로어는 정신줄을 놔 버렸어. "
"싸움을 포기해 버렸다고. 난 안 그럴 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 134769f5-4dbe-c70d-cca7-8e394b13703e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Local:
#.     - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:134769f5-4dbe-c70d-cca7-8e394b13703e
msgctxt "heeada44bg4973g40acg8c7dg8baacd85ccad"
msgid ""
"He's a devil, Mol. They are fickle patrons - ambition and treason lie before "
"you."
msgstr "라파엘은 데빌이야, 몰. 데빌이란 변덕스러운 존재고. 넌 야심가의 탐욕어린 짓거리와 배신을 겪게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 134769f5-4dbe-c70d-cca7-8e394b13703e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Local:
#.     - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:134769f5-4dbe-c70d-cca7-8e394b13703e
msgctxt "h1df82449g3f66g4e06gae10gba64467cf6d2"
msgid ""
"Be careful, little one. Raphael's a devil - they're lying bastards. Hardly "
"<i>fun</i> patrons."
msgstr ""
"조심해, 꼬마야. 라파엘은 데빌이야. 놈들은 거짓말이나 해 대는 잡것들이지. 후원자로 삼기에는 재미라고는 눈곱만큼도 없는 녀석들이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 134769f5-4dbe-c70d-cca7-8e394b13703e
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Local:
#.     - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:134769f5-4dbe-c70d-cca7-8e394b13703e
msgctxt "h92645f40g9528g4485gac4fge974b8ef6d11"
msgid ""
"I swore a pact with a creature like Raphael once. He's a devil, Mol. Be "
"cautious."
msgstr "나도 이전에 라파엘 같은 존재와 서약한 바 있어. 놈은 데빌이야, 몰. 주의하도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 13a62b4b-e88d-cfb1-aeb8-517521addf7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:13a62b4b-e88d-cfb1-aeb8-517521addf7d
msgctxt "he84f3322g3bc9g4a4cg9855g1b9be0a2dcc5"
msgid ""
"Looked like he was doin' a pretty good job. If I had to deal with gods and "
"worms in my head, I'd make a deal with anyone."
msgstr ""
"라파엘이 꽤 괜찮은 수작을 부리는 것 같던데. 만약에 내가 신적인 존재랑 얽히고 머릿속의 버러지 문제를 해결해야 하는 처지에 놓였더라면, "
"아무나 붙잡고 진작에 거래했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 149456f3-84e0-0092-f872-5d250b17934e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:149456f3-84e0-0092-f872-5d250b17934e
msgctxt "h073f6a01g95f5g4dc4gbca9g54476cf147ae"
msgid ""
"This isn't about me, it's about your <i>soul</i>. What did he really offer?"
msgstr "지금 내 이야기를 하고 있는 게 아니잖아. 네 <i>영혼이</i> 걸린 문제라고. 놈이 네게 실제로는 무슨 제안을 했니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 181dd205-1ff5-fae4-3344-a5a22db3b36d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Local:
#.     - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:181dd205-1ff5-fae4-3344-a5a22db3b36d
msgctxt "hf468c97dg6fe1g4822ga8d3gf964da9b68b7"
msgid ""
"Our kind have enough trouble with devils. You should stay away from this one."
msgstr "우리 종족은 그러잖아도 데빌 때문에 골머리를 썩고 있어. 너도 라파엘과 거리를 두는 편이 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 19ebd424-93a0-e0c7-0f19-e5ab7608b60b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:19ebd424-93a0-e0c7-0f19-e5ab7608b60b
msgctxt "h7853f0dfg08fcg4018gbe06gb6461f9c4a4d"
msgid ""
"So what if Raphael's a devil? Means he's got the power to keep his promise."
msgstr "라파엘이 데빌인 게 뭐가 어때서? 말인즉슨 자기가 한 약속을 지킬 힘을 지녔다는 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 1a65d6c7-194d-78de-1276-c59223643a26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:1a65d6c7-194d-78de-1276-c59223643a26
msgctxt "hcb6159c5gb589g49dcgbed1g0f1506607365"
msgid ""
"Zevlor had <i>belief </i>- didn't get him anywhere good. Besides, Raphael "
"wasn't promising anything stupid."
msgstr ""
"<i>믿음</i> 같은 건 제블로어도 지니고 있었어. 그렇지만 좋은 꼴 못 봤잖아. 게다가, 라파엘의 제안은 제대로 된 거였다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 1a6cf7cb-8a69-5b59-f82f-9371e0b86872
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:1a6cf7cb-8a69-5b59-f82f-9371e0b86872
msgctxt "h7372e26cg9bf5g4f15g8008gf82ac4583472"
msgid ""
"Like a prick from a scorpion, Raphael's deals seem innocuous, but they are "
"poison."
msgstr "마치 전갈의 침에 쏘일 때처럼, 라파엘이 내미는 거래는 사소하고 시시하게 느껴지지. 그렇지만 거기에는 독이 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 1b7b1fb9-c6fa-f375-c05a-3da9dbd551e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:1b7b1fb9-c6fa-f375-c05a-3da9dbd551e5
msgctxt "h26dacf4fge506g4cd5g9a65g59afdb90812b"
msgid ""
"He said he could get me and my gang get to Baldur's Gate. I reckon he can do "
"it too - don't care what your 'lore' says."
msgstr ""
"라파엘은 자기가 나랑 내 패거리 녀석들을 발더스 게이트로 데려다줄 수 있다고 했어. 아마 실제로도 그럴 수 있을걸. 네가 떠드는 "
"'전승'이 뭐라고 하는지는 난 신경 안 써."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 252abc93-3ccc-82a2-1ee3-7220b9f7171c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:252abc93-3ccc-82a2-1ee3-7220b9f7171c
msgctxt "hd279f881g8547g4350ga14bg72e57acb71d3"
msgid "Trust me, it might sound good but it's not worth it."
msgstr "내가 하는 말 믿어. 말은 그럴싸해도 거기에는 이럴만한 가치가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 258153ed-4417-2caf-f0d0-061d3588a048
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = False
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_EncouragedDeal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:258153ed-4417-2caf-f0d0-061d3588a048
msgctxt "h3a08478agfd0ag4697gbb07g4c412aa5e731"
msgid "If Raphael offered you a good trade, you should take it."
msgstr "라파엘이 괜찮은 조건의 거래를 제안했다면, 받아들이는 게 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 291f6d0b-baf4-fbce-8d50-d5a44a12e6aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:291f6d0b-baf4-fbce-8d50-d5a44a12e6aa
msgctxt "h7f97f88fg0b60g483bga828g5c8205fb85d7"
msgid "Whatever. My soul's not gonna matter if we get eaten by shadow freaks."
msgstr "뭐라는 거야. 그림자 어쩌고에 집어삼켜지면 내 영혼 같은 건 애초에 무슨 대수라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 2f4ff1bd-2aea-7d2a-b3f0-79d9c7f1bce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:2f4ff1bd-2aea-7d2a-b3f0-79d9c7f1bce5
msgctxt "h149ab2a7gefacg43acg8486g33074412ac35"
msgid "And also... when we get there, I'd be head of the Thieves' Guild."
msgstr "그리고... 발더스 게이트에 도착하면, 날 도둑 조합의 우두머리로 만들어달라고 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 314703ae-05b0-4f00-b7a4-e80640886b08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:314703ae-05b0-4f00-b7a4-e80640886b08
msgctxt "h5e749222gfd0bg4993g8bffgac745cef1422"
msgid "What exactly did he offer you?"
msgstr "라파엘이 정확히 너한테 뭘 제안하던?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 349212b8-914f-4b41-66bf-19583a92233a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:349212b8-914f-4b41-66bf-19583a92233a
msgctxt "hd9ee98a9g6537g407bgae28gbfa0129399b5"
msgid ""
"Simply professional curiosity, Mol. Devils of lore don't usually deal in "
"such low stakes."
msgstr "순전히 직업상의 이유로 호기심이 들어서 그래, 몰. 전승 속의 데빌들은 보통 밑지는 내기는 하지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 37429676-f040-4234-ea4a-08d676a8ed9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:37429676-f040-4234-ea4a-08d676a8ed9d
msgctxt "h30c725f5g0dd0g474bga1a5g65fc45dceecd"
msgid ""
"No idea if it's good or not. A lot of people like to promise pretty things, "
"but it's empty air."
msgstr "그게 좋은지 어떤지는 난 몰라. 다들 약속은 그럴듯하게 잘 하지만, 사실 다 헛소리잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 38e48245-681a-96a7-a185-b35b625afd5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:38e48245-681a-96a7-a185-b35b625afd5b
msgctxt "hc3a7ad24gc535g4e91ga927gdd1d75973980"
msgid "What I said! That he'd get me and my gang safely to Baldur's Gate."
msgstr "내가 한 말 그대로야! 녀석이 나랑 내 패거리를 발더스 게이트로 안전하게 데려다준다는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 41821664-7356-4728-a8ef-5dfe6e78ff8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:41821664-7356-4728-a8ef-5dfe6e78ff8a
msgctxt "h0b52a935gb2efg4146g9e24gacf5b4ff33bd"
msgid "Nothin' personal."
msgstr "개인적인 악감정은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 422199e0-7024-f570-1dbb-9edfbfed1fd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_EncouragedDeal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:422199e0-7024-f570-1dbb-9edfbfed1fd9
msgctxt "h7f5fc9bcgf8d1g4f0agbd56g439ceddde292"
msgid ""
"Take the deal if you want, kid. But a word of advice - let him get a little "
"desperate first."
msgstr "원한다면 거래에 응해도 좋아, 꼬마야. 그렇지만 조언 한마디 할까? 먼저 녀석을 좀 달아오르게 만들도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 4421823c-6d5e-0a4d-e60e-fa01fc7ccdb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:4421823c-6d5e-0a4d-e60e-fa01fc7ccdb4
msgctxt "h48c8dba0g766eg4d36ga67fg3ffbf2c91788"
msgid ""
"But I haven't accepted nothing yet. Sounds like you're in deeper than I am."
msgstr "그렇지만 아직 어떤 거래도 받아들이지는 않았어. 듣자하니 너는 나보다도 더 깊게 얽힌 모양이던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 45d7c47a-c12c-7c27-6f23-9b225876c3cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:45d7c47a-c12c-7c27-6f23-9b225876c3cf
msgctxt "h45b384f5g4060g4bcdg9e00g2bebc504bc99"
msgid "Protection for me and my kids. That's all."
msgstr "나랑 내 패거리 애들을 보호해주는 거. 그게 다야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 467bc878-44ff-34da-e967-f4fcdd79bf28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:467bc878-44ff-34da-e967-f4fcdd79bf28
msgctxt "hab8ae982g3309g4989gaa98g0748f41f7816"
msgid "I'm holding out. Better to make him a little desperate."
msgstr "난 살짝 튕겨주고 있어. 녀석을 조금 절박하게 만드는 편이 좋지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 46edea6a-220d-1181-c059-cc212bf77a20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:46edea6a-220d-1181-c059-cc212bf77a20
msgctxt "ha8aec86ag93c9g490dgbd68g08b025910758"
msgid ""
"You... you aren't joking? Huh. I kind of believe him more now than I did a "
"minute ago."
msgstr "너... 농담 하는 게 아니구나? 허어. 어쩐지 조금 전보다 라파엘의 말을 더 깊이 믿게 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 474df18f-20b5-270a-6cd7-a64fda562c00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:474df18f-20b5-270a-6cd7-a64fda562c00
msgctxt "hb51232d0gab3bg4addga03fgfa018fe06f06"
msgid ""
"Also - bit rich for <i>you</i> to tell me who I can or can't make deals "
"with. All things considered."
msgstr "그리고 있지, 애초에 <i>네가</i> 나한테 누구랑은 거래해도 되고, 누구랑은 하면 안 되는지 떠드는 거 좀 재수없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Narrator
#. NodeID = 53bf79f7-ad82-8907-7aa8-a208f0d0dac7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:53bf79f7-ad82-8907-7aa8-a208f0d0dac7
msgctxt "h038bc12bg7bb8g4c9cg91fdg48c01a2893b6"
msgid ""
"*Her smile is broad, her eyes twinkling, her face the very picture of "
"innocence. She's clearly lying.*"
msgstr ""
"*몰의 입가에는 빙글거리는 웃음이, 눈에는 반짝임이 감돕니다. 순진무구하기가 이를 데 없는 낯빛을 하고 있군요. 몰은 분명히 거짓말을 "
"하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 5a1b6166-10d9-4b90-c02e-30561f34bf25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:5a1b6166-10d9-4b90-c02e-30561f34bf25
msgctxt "h938489c1g2db5g4c3eg8d33gc2c4cd038b45"
msgid ""
"Safe passage to Baldur's Gate. Safe from <i>everyone</i>, like Zev was "
"supposed to do."
msgstr ""
"발더스 게이트로 모두를 안전하게 데리고 갈 방법. <i>어떤 것에도</i> 방해받지 않고 말이야. 제브가 원래 그래야 했던 것처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 5b660369-b149-27b7-b063-32f2e025829a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:5b660369-b149-27b7-b063-32f2e025829a
msgctxt "hea837d4fg1f25g49eagb124g6960c7cbaeef"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 63c63fe9-91d7-a5d1-4d84-b2e2b82bfd94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:63c63fe9-91d7-a5d1-4d84-b2e2b82bfd94
msgctxt "h1ce956c4g6389g4aa1gbae4gf60b35aa996c"
msgid ""
"Zevlor couldn't save everyone - it's my job to look after those who survived."
msgstr "제블로어는 모두를 구하지 못했어. 살아남은 녀석들을 보살피는 건 나한테 달린 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 651a553a-c905-8b3d-d511-5645cab400a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = False
#.      - GOB_State_LeadersAreDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:651a553a-c905-8b3d-d511-5645cab400a3
msgctxt "h0f8983abgcc21g4fd2gae62gb58fe4ae2d9b"
msgid ""
"Whatever. I'm tired of taking orders from people who think they know better "
"than me."
msgstr "그러든가 말든가. 난 자기가 나보다 더 똑똑한 줄 아는 녀석들한테 이래라저래라 명령받는 건 넌더리가 나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 6ecc8d72-05e3-f5d9-275e-bbe8a64198c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:6ecc8d72-05e3-f5d9-275e-bbe8a64198c8
msgctxt "hb8553e50gd497g41a5g9d21g9eafad3acdc5"
msgid "I'm not judging, Mol. Only curious about the details."
msgstr "난 네 행실의 옳고 그름을 따지려는 게 아니야, 몰. 그냥 자세한 사항이 궁금해서 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 742e0bee-4488-a381-bd4c-028fe763f92b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:742e0bee-4488-a381-bd4c-028fe763f92b
msgctxt "he129eeadg8d5eg4883g9becg92b6d36b67f5"
msgid ""
"My problems are more urgent than yours - I <i>have</i> to deal with him."
msgstr "내가 품은 문제는 네 골칫거리보다 더 긴박해. 나는 녀석과 거래하는 <i>수밖에</i> 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 770b8287-041d-d910-f5c5-1f7483a265e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:770b8287-041d-d910-f5c5-1f7483a265e4
msgctxt "hcb97abfdg85ddg4825ga086g718a46564c01"
msgid ""
"Though it can be near-impossible to stay on the good path, you have to try. "
"We all have to try."
msgstr "의롭고 선한 방향에 머무르는 게 가히 불가능에 가깝다고는 하지만, 그래도 노력해봐야 해. 우리 모두 그래야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 7a67b8e1-d275-4a3a-1d54-cfc6db42f783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:7a67b8e1-d275-4a3a-1d54-cfc6db42f783
msgctxt "h4ded616egd173g4151g9c89g2d00ba8337d6"
msgid ""
"If our kind looked out for one another, we wouldn't need to deal with devils."
msgstr "만약에 우리 종족이 서로를 보살피는 데 신경을 썼더라면, 애초에 데빌과 거래를 해야 할 이유도 없었겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 7b7b53f7-48aa-9f7e-2b1a-d6a85f2d44b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:7b7b53f7-48aa-9f7e-2b1a-d6a85f2d44b8
msgctxt "h73372830ga92dg4de8gbac0g233bbc2d05d0"
msgid ""
"You need to believe in <i>yourself</i>, Mol. Not the empty promises of a "
"fork-tongued monster."
msgstr "중요한 건 <i>너 자신을</i> 믿는 거야, 몰. 혀가 갈라진 괴물의 공허한 약속에 기대는 게 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 7d97c191-be41-c0a9-f7fd-027e0d872e65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:7d97c191-be41-c0a9-f7fd-027e0d872e65
msgctxt "h6e1e3861g52dbg4f44gb925g35994054b1d3"
msgid "And what happens to the current head of the Guild?"
msgstr "그리고 조합의 현재 수장은 어떻게 되고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 7dd17e38-f798-420e-b443-0915801f9d55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:7dd17e38-f798-420e-b443-0915801f9d55
msgctxt "hdab27cecgc085g44e2gb9cag60cdf9295f63"
msgid "I know him well enough to know he's a trickster."
msgstr "라파엘이 사기꾼이라는 걸 인지할 만큼은 녀석을 잘 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 7f86a86e-401b-0618-1282-99b0d517141b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:7f86a86e-401b-0618-1282-99b0d517141b
msgctxt "hc8a9c50cgb9b8g4b7cg9062g6a06e5b8646b"
msgid ""
"I can read you like a book, Mol - call it hunter's instincts. Now tell me, "
"what did he really offer?"
msgstr "네 속은 훤히 들여다 보여, 몰. 사냥꾼의 직감이라고 해도 좋아. 그러니까 말해 줘. 라파엘이 실제로는 무슨 제안을 했니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 81072e91-84d6-c737-28ff-a87e93a118d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:81072e91-84d6-c737-28ff-a87e93a118d1
msgctxt "h1999498fgb098g42f5g9e7eg82a9b18c77df"
msgid ""
"Do as I say, not as I do, right? Got a lot of that from Zev too, and he was "
"a walking pile of imp shite at the end of the day."
msgstr ""
"\"내가 시키는 대로 해. 내가 하는 짓거리는 따라하지 말고.\" 뭐 그런 거야? 제브 녀석도 그런 소리 실컷 해댔어. 끝까지 시답잖은 "
"말만 지껄이다 갔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 863214b1-095b-4e3e-b708-11110791a822
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:863214b1-095b-4e3e-b708-11110791a822
msgctxt "h199b4fabge487g456bgb4efg4699f8b43cd7"
msgid "My problems are a lot more pressing than yours."
msgstr "내가 안은 문제는 네 골칫거리보다 훨씬 더 엄중하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 873b77f1-49b8-2a6f-35f7-ab045ada54ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:873b77f1-49b8-2a6f-35f7-ab045ada54ba
msgctxt "hc2b0401ag5ad8g4c71g8996g519bfe4e6915"
msgid ""
"I had the grove running pretty smooth, I'll do the same in Baldur's Gate. "
"And I can keep the kids safe."
msgstr ""
"에메랄드 숲에서도 순탄히 일을 잘 굴렸으니까, 발더스 게이트에서도 마찬가지로 그렇게 할 거야. 그리고 이러면 날 따르는 녀석들을 안전하게 "
"지킬 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 95d2afd9-9b7e-ff55-eb2a-2315507decd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:95d2afd9-9b7e-ff55-eb2a-2315507decd9
msgctxt "h575e75a6g4d4dg4556g84d4gb1699df085fe"
msgid ""
"I dunno, devil stuff? What matters is I can keep my kids safe. Everyone "
"else's let them down, but I won't."
msgstr ""
"몰라. 데빌이 알아서 하겠지? 중요한 건 이렇게 해서 내가 날 따르는 녀석들을 안전하게 지킬 수 있다는 거야. 다른 놈들은 전부 녀석들을 "
"저버렸지만, 난 안 그럴 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 99e14ff2-2480-fccd-9c5d-ac7235c44321
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:99e14ff2-2480-fccd-9c5d-ac7235c44321
msgctxt "hb5e14c67g66f2g4240gb164gffae7776ddf6"
msgid "I haven't made any kind of deal with him. He's just trying to tempt me."
msgstr "난 아직 놈과 어떤 거래도 하지 않았어. 녀석이 날 부추기려고 애쓸 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = 9a0902f7-196b-ba42-39b8-6d5b6d8aa28f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#.      - RANGER(1) = False
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:9a0902f7-196b-ba42-39b8-6d5b6d8aa28f
msgctxt "ha2c400a6g87e4g4b7egbda0g470ba7c6fe23"
msgid "Raphael's dangerous, Mol. What did he <i>really </i>offer you?"
msgstr "라파엘은 위험한 자야, 몰. 놈이 <i>실제로는</i> 뭘 제안했니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = 9c8ca31c-8d8c-8033-880b-f9cb26be7895
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:9c8ca31c-8d8c-8033-880b-f9cb26be7895
msgctxt "hf4b0a33cgcb20g4d9dg8ccfg6d93da822f96"
msgid "Hey! I'm not so little! Grown-up enough to have grown up ages ago."
msgstr "이봐! 나 그렇게 어리지 않거든! 진작에 철이 들고도 남았다 이거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = a49319de-3cfc-52b4-7106-1b567b5a6cb6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Local:
#.      - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = False
#.   Tag:
#.      - CLERIC(1) = False
#.      - SORCERER(1) = False
#.      - WARLOCK(1) = False
#.      - WIZARD(1) = False
#. SetFlags:
#.   Local:
#.     - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:a49319de-3cfc-52b4-7106-1b567b5a6cb6
msgctxt "h767ee393g090cg4c85g9f68g86fe9346967c"
msgid "Raphael is a real, literal devil. You and your soul are in danger, Mol."
msgstr "라파엘은 진짜로, 문자 그대로 악마적인 데빌이야. 너와 네 영혼이 위험에 처한 거라고, 몰."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = a57ecb4f-58e2-825e-a688-fc4681f54418
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:a57ecb4f-58e2-825e-a688-fc4681f54418
msgctxt "h7e62f9d8g0aafg4833g9bbagc6b0848c9888"
msgid ""
"Yeah, I bet. What kind of problems could someone like me have? You hero "
"types are all the same."
msgstr "아무렴, 그렇겠지. 거기 비하면 나 같은 녀석이 떠안은 문제는 얼마나 하찮겠어? 너 같은 영웅 부류는 다 똑같다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = a5e04c45-91f7-16ab-eca1-db117faff77a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:a5e04c45-91f7-16ab-eca1-db117faff77a
msgctxt "h75df390fgb2b9g4ed0g9820gde78ae1f0159"
msgid ""
"Now there's no grove, no coin, no one taking us to the city. I'm not letting "
"my crew get eaten by shadows."
msgstr ""
"이제는 머무를 숲도 없고, 돈도 다 떨어졌고, 우리를 도시로 데려다줄 사람도 없어. 내 패거리 녀석들이 그림자에 삼켜지게 놔두지는 않을 "
"거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = abd443b1-76b3-4117-b95d-4cf6e153011b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:abd443b1-76b3-4117-b95d-4cf6e153011b
msgctxt "h869a3aa3gaddag4460g86c2g3a1d10ea8907"
msgid "Wonder if I could con some gold off that cleric."
msgstr "그 클레릭한테 사기를 쳐서 금화를 좀 뜯어낼 수 있으려나 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = ae87f1d6-fc53-8c08-29bf-3e3dbca4ec9c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:ae87f1d6-fc53-8c08-29bf-3e3dbca4ec9c
msgctxt "hf5ccdb40gb695g4298ga1edgc4422a34b7d6"
msgid ""
"Devils of lore don't deal in such low stakes, Mol. What'd he <i>really "
"</i>offer?"
msgstr "전승 속에 등장하는 데빌은 밑지는 거래는 하지 않아, 몰. 라파엘이 <i>정말로</i> 제시한 게 뭐니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = afcd5bb0-e45e-0573-ae23-826d773ed1cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:afcd5bb0-e45e-0573-ae23-826d773ed1cf
msgctxt "hf3e18e7ag5295g41d0gbb7fgcb3bdcf01674"
msgid ""
"Yeah, that's the way to go. His lanceboard trick was meant to soften me up, "
"but I know better."
msgstr "그렇지, 그래야지. 라파엘이 랜스보드 속임수를 부린 건 날 흔들려고 그랬던 거지만, 이런 건 내가 더 빠삭하다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = b1b1f49a-4a4b-4e21-8bca-db65bdfd36a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:b1b1f49a-4a4b-4e21-8bca-db65bdfd36a5
msgctxt "hbb44c7e4g90cfg481cgbd4cg8d76ad15ce43"
msgid "Poison. Sure."
msgstr "독 같은 소리 하고 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = b1fc9058-0941-c66d-11a5-a497e6da6a1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_EncouragedDeal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:b1fc9058-0941-c66d-11a5-a497e6da6a1d
msgctxt "h184dbd55g6459g4eb5gacbeg1787facedce7"
msgid ""
"Make a deal with a devil, little one. Once you fall, you'll never look back."
msgstr "데빌과 거래하도록 해, 꼬마야. 폭삭 망하고 나면 기회는 다시 찾아오지 않으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Karlach
#. NodeID = b3ddc808-377f-4a0d-9f12-4cdf8a2f45d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_Event_KarlachPresentInFollowUp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:b3ddc808-377f-4a0d-9f12-4cdf8a2f45d5
msgctxt "hd6849eb7g1f1fg4848g8e2eg2d66e3a4907b"
msgid "No, kid. No."
msgstr "안 돼, 꼬마야. 안 된다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = b498fae4-0f7f-5a6a-92f9-514508457ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:b498fae4-0f7f-5a6a-92f9-514508457ef1
msgctxt "h00117abag8982g4e54g8198g15475b2f49cb"
msgid ""
"I get looking out for number one - respect it, even. So if I make a deal, "
"you can be damn sure it's what's best for me and my crew."
msgstr ""
"난 뭐가 가장 중요한지를 잘 알고, 우선순위를 존중하기도 해. 그러니까 만약에 내가 거래에 응한다면, 그건 분명 내가 그게 나랑 내 "
"녀석들한테 최선이라고 판단했기 때문일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = b6efb3a6-c161-444d-bbf8-8aceb29068fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:b6efb3a6-c161-444d-bbf8-8aceb29068fa
msgctxt "hb25c556fg739dg4dd7ga1e0g2354a7f30972"
msgid "I haven't made a deal. He's just trying to tempt me."
msgstr "난 녀석과 거래 안 했어. 놈이 날 유혹하려고 애쓸 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = bbf46798-87fa-5800-49b9-7a19e1cbe1f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:bbf46798-87fa-5800-49b9-7a19e1cbe1f3
msgctxt "h8058f5e4g5cf8g42e3g8e09g648e8fcc21ac"
msgid ""
"There aren't any other options, <i>soldier</i>. Raphael said he could keep "
"me and my kids safe, and that's that."
msgstr ""
"다른 선택지가 애초에 없거든, <i>군인 씨</i>. 라파엘은 자기가 나랑 내 패거리 애들을 안전하게 보호해줄 수 있다고 했어. 그거면 "
"되잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = ca6f24c7-ae4e-41c3-319f-3f9847000c2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:ca6f24c7-ae4e-41c3-319f-3f9847000c2c
msgctxt "h2aeae46dg9db2g4d00g9ab1g845cea1d799c"
msgid ""
"Everyone they turned to let my kids down - the druids, Zevlor, <i>everyone</"
"i>. Now it's my job to keep 'em safe, and I'm gonna do it right."
msgstr ""
"날 따르는 녀석들이 손을 뻗는 족족 남들은 녀석들을 저버렸어. 드루이드, 제블로어, <i>전부 다</i> 말이야. 이제 녀석들을 안전하게 "
"지키는 건 나한테 달렸어. 그리고 난 제대로 해낼 거란 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = cc136537-f80d-5634-d196-4c0df759144c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Local:
#.      - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = False
#.   Tag:
#.      - WARLOCK(1) = False
#. SetFlags:
#.   Local:
#.     - f908976f-ef66-a83b-7960-49ea44efd9e5_HAV_MolsDeal_LancerBoard_ThreeWay_ToldDevil = True
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#. TagRule: SORCERER or WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:cc136537-f80d-5634-d196-4c0df759144c
msgctxt "h84ecfc52g8a25g4d8dgaef5g48b38ac30107"
msgid ""
"Do you not hear it? The power of the Nine Hells, woven in his every word? He "
"is a devil who wishes for your very soul."
msgstr ""
"너한테는 들리지 않았어? 녀석이 내뱉은 말 한마디 한마디에 아홉 지옥의 권능이 서려 있다는 게? 라파엘은 다름 아닌 네 영혼을 탐내는 "
"데빌이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = ce70e223-09f4-4523-ac3a-c444ee609d26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_MolsDeal_HasMet_Mol(1) = False
#.   Global:
#.      - HAV_MolsDeal_State_LostGame = True
#. SetFlags:
#.   Dialog:
#.     - HAV_MolsDeal_HasMet_Mol(1) = True
#.   Global:
#.     - DEN_Thieflings_HasMet_Mol = True
#.     - HAV_MolsDeal_Event_Confronted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:ce70e223-09f4-4523-ac3a-c444ee609d26
msgctxt "h25dd08fbg7eb5g426bgbd53gd8763c139aad"
msgid "Should've trusted my gut instead of asking for help."
msgstr "남한테 도움을 구하는 대신 내 직감을 믿었어야 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = d08ced2e-e866-ce74-5163-abc363a5f04b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:d08ced2e-e866-ce74-5163-abc363a5f04b
msgctxt "h38878feeg8e55g485cgb944gbcac43728439"
msgid "Not like we have anyone in charge now. Zev's dead."
msgstr "이제는 딱히 대장 노릇 할 사람이 있는 것도 아니지만 말이야. 제브는 죽었으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = d1a2481e-fe0a-4537-a6dd-b001eef61087
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_MolsDeal_HasMet_Mol(1) = False
#.   Global:
#.      - HAV_MolsDeal_State_WonGame = True
#. SetFlags:
#.   Dialog:
#.     - HAV_MolsDeal_HasMet_Mol(1) = True
#.   Global:
#.     - DEN_Thieflings_HasMet_Mol = True
#.     - HAV_MolsDeal_Event_Confronted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:d1a2481e-fe0a-4537-a6dd-b001eef61087
msgctxt "h564581d9gae7cg4022ga3d2ga6b0d4536070"
msgid "Nice strategy back there."
msgstr "아까 전술 펼친 거 좋았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = d2270a41-7cb6-6266-0dcb-a0dc4c06e303
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_EncouragedDeal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:d2270a41-7cb6-6266-0dcb-a0dc4c06e303
msgctxt "ha50fec96gae60g4001g9ba1g3cd66a9600ae"
msgid "Ha! Ambitious - I like it."
msgstr "하! 야심가로구나. 마음에 들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = d5906075-a25f-8869-8931-931597a63657
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:d5906075-a25f-8869-8931-931597a63657
msgctxt "hf51df303gc74bg414agaf96g844f2b7406f0"
msgid ""
"One should consider all options before forming a battle strategy - not just "
"the easiest deal."
msgstr "전투 전략을 짤 때에는 모든 가능한 수를 고려해 봐야 하는 거야. 가장 쉽기만 한 길을 택하는 게 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = d5f935d9-e1fe-e2dc-1292-fe84167d8fb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:d5f935d9-e1fe-e2dc-1292-fe84167d8fb6
msgctxt "h77f8cce1gce61g408ag9272ga29747130c17"
msgid ""
"Maybe I'll make a deal, maybe I won't. But it'll be <i>my </i>choice - not "
"the devil's and not yours."
msgstr ""
"어쩌면 내가 거래에 응할지도, 혹은 그러지 않을지도 모르지. 하지만 어떻게 되든 선택은 <i>내가</i> 할 거야. 데빌이나 네가 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = d877d608-5be1-4cd0-8817-8058ac1bdd18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:d877d608-5be1-4cd0-8817-8058ac1bdd18
msgctxt "h02a3017ag6bf6g4166gb87cge5a6aae4b1f7"
msgid ""
"If we put our heads together, I bet you and me could make a tidy stack of "
"coin in Baldur's Gate."
msgstr "우리가 서로 머리를 맞대면, 너랑 나랑 둘이서 발더스 게이트의 금화를 왕창 거둬들일 수도 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = db506621-07f5-5358-98f8-4bc6fb1d10dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = False
#.      - GOB_State_LeadersAreDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:db506621-07f5-5358-98f8-4bc6fb1d10dc
msgctxt "hfbeaad29g8269g4d61gae5cgce0d2b3390b2"
msgid ""
"You could have helped us. With the goblins, with the druids. But you saved "
"your own skin."
msgstr "넌 우릴 도와줄 수도 있었잖아. 고블린 문제도, 드루이드 문제도. 그렇지만 넌 자기 몸 보전하기에 바빴어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = ed757931-ca3d-8ae7-8a11-82acc0321687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:ed757931-ca3d-8ae7-8a11-82acc0321687
msgctxt "hf926a8e2g6b3fg4981g9067g0721aaf1d913"
msgid ""
"But Raphael's offered me a partnership already, and it seems like a sweeter "
"deal than throwing my lot in with you."
msgstr "그렇지만 라파엘이 먼저 나한테 협력하자고 제안했어. 그리고 너한테 거는 것보다는 이쪽이 더 조건이 좋아서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = f009748c-655a-5dfc-c411-6a254168042b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:f009748c-655a-5dfc-c411-6a254168042b
msgctxt "h1657fc34g4967g449fgab96gfc5df735fa7c"
msgid ""
"Not that it's any of your business - I'm not poking my nose into whatever "
"trade <i>you</i> made with him."
msgstr "그거야 네가 알 바 아니잖아. 나는 <i>네가</i> 라파엘과 무슨 거래를 했는지 꼬치꼬치 캐묻지 않고 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Player
#. NodeID = f81a21b9-5480-4acd-89dc-926edfa95c9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = False
#. SetFlags:
#.   Object:
#.     - HAV_MolsDeal_Event_WarnedAboutRaphael(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:f81a21b9-5480-4acd-89dc-926edfa95c9c
msgctxt "h598f6e7bg3a03g46f6g9263gbf06e61a4356"
msgid "You need to stay away from Raphael. His deals are poison."
msgstr "라파엘과는 반드시 거리를 둬야 해. 놈이 제안하는 거래는 맹독과 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol
#. Speaker = Mol
#. NodeID = fbf5db27-72c0-9d45-534c-01cf20ec3cd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Mol:fbf5db27-72c0-9d45-534c-01cf20ec3cd0
msgctxt "h80acfe25gb55cg498cg91fegffd1e5ab0c2b"
msgid ""
"Easy for you to say - you can do what you want, go where you want. My kids "
"need protecting, and I'm going to protect 'em."
msgstr ""
"너야 남 일이니까 쉽게 말하지. 너는 네가 원하는 건 다 하면서 어디든 싸돌아다닐 수 있잖아. 날 따르는 녀석들한테는 보호가 필요하고, "
"난 녀석들을 지켜줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_MolMoving
#. Speaker = Mol
#. NodeID = 0aaa2f7f-c3cd-4f02-afa3-8f53c9d4b3cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_MolMoving:0aaa2f7f-c3cd-4f02-afa3-8f53c9d4b3cc
msgctxt "he85db9fag2c9ag4837g83b0g8a281fa93a5b"
msgid ""
"Look, you're welcome and all, but I've gotta chat with bigger fish. Later."
msgstr "어이, 잘 왔고 반갑고 다 좋은데, 난 큰손이랑 이야기 좀 해야 해. 이따 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 00ab50fe-19f9-9ca4-d749-c39faa5da823
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_Knows_PoemInfernal = True
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:00ab50fe-19f9-9ca4-d749-c39faa5da823
msgctxt "h44e233ccgb7afg4121g8618g070a51b87a96"
msgid ""
"My old - well, a long time ago someone carved infernal runes into my back. "
"They are a fragment of a contract. I'd like to know what the full contract "
"says."
msgstr ""
"나의 예전... 음, 아주 오래 전에 누군가 내 등에 지옥의 룬을 새겨뒀어. 어떤 계약의 일부분이지. 계약서의 전체 내용을 알고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 03c85261-2e87-5b1a-fba8-077c73c2f67b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:03c85261-2e87-5b1a-fba8-077c73c2f67b
msgctxt "hb08337adgdb01g4540gb711ge0393d92be3d"
msgid "This is serious business, devil."
msgstr "진지하게 말하는 거야, 데빌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 069e5789-e4ff-69c6-2c6d-1b3d07078c9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:069e5789-e4ff-69c6-2c6d-1b3d07078c9e
msgctxt "haaa7af89ge08ag4229gbe3bg97a0bf8d1f49"
msgid ""
"My dear, nothing is coincidence. Mortals trifle themselves with free will, "
"as if their betters have not moulded every potential path ahead."
msgstr ""
"오, 저런, 우연이란 존재하지 않는답니다. 필멸자들은 자유 의지라는 하찮은 것에 연연하곤 하지요. 실은 그들이 걸을 수 있는 길은 더 "
"우월한 존재가 이미 다 짜 놓았는데도 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 098196a1-25d5-ff3a-6080-e8fe26985475
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:098196a1-25d5-ff3a-6080-e8fe26985475
msgctxt "h3015c008g313cg46b9g80b0gdbe503e101b9"
msgid ""
"I - perhaps I should have. I'm not exactly used to asking for help and being "
"met with, well... help."
msgstr "난... 그럴 걸 그랬어. 도움을 요청하는 것도 받는 것도 내겐... 낯선 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 0a919c35-bf4f-9cbe-0de6-c8f24be18337
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:0a919c35-bf4f-9cbe-0de6-c8f24be18337
msgctxt "hfa9269bdg2c83g4bffgbe7egefe8388542c8"
msgid "Now who would possibly benefit from such a massacre?"
msgstr "그런 대학살로 이득을 볼 사람이 과연 누구였을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 0fc5ab99-1d17-8c62-da5b-3dc65c36882c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:0fc5ab99-1d17-8c62-da5b-3dc65c36882c
msgctxt "h9e85cc45g6e1dg4caag8c12g5d8795fd207b"
msgid ""
"For now, I'm afraid you've already made me late for a meeting with another "
"client. I'll see you soon."
msgstr "이만 가봐야겠어요. 당신과 얘기하느라 다른 고객과의 약속에 늦어버린 것 같네요. 곧 다시 보도록 하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 107ba92b-c71a-e9bc-a672-33a432e7da94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:107ba92b-c71a-e9bc-a672-33a432e7da94
msgctxt "hc6e8b253g6a73g4486g8b02g226078715bb2"
msgid "Oh such impatience."
msgstr "아아, 참을성 없기도 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 189f34dd-ca70-50b1-c87c-1c899ffcafac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:189f34dd-ca70-50b1-c87c-1c899ffcafac
msgctxt "hd708227age304g4213g8673g8bf475a28310"
msgid "You were here before? Why?"
msgstr "여기에 온 적이 있다고? 무슨 일로?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 194be70c-1b1a-a40b-1499-05a1e9763c2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:194be70c-1b1a-a40b-1499-05a1e9763c2b
msgctxt "h8627eed0g284ag49aegb768ga4bf9e3317f3"
msgid ""
"I never surrender knowledge for free, but one good turn deserves another, "
"does it not? To repay you for the souls sent my way, I offer a taste of the "
"truth."
msgstr ""
"지식을 결코 공짜로 알려주진 않습니다. 다만, 오는 게 있으면 가는 것도 있어야 이치에 맞지 않겠습니까? 당신이 보내준 영혼에 대한 "
"보답으로 진실을 맛보게 해드리죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 19da9c7f-b17b-e044-cfe4-3295570467af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:19da9c7f-b17b-e044-cfe4-3295570467af
msgctxt "h34684967g46e6g4a8bg8565g09f3956eadd7"
msgid "You really have a knack for showing up in all the wrong places."
msgstr "넌 정말 뜬금없는 곳에서 나타나는 재주가 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 1b66430c-e926-c174-d94d-3e3acdc6efa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:1b66430c-e926-c174-d94d-3e3acdc6efa9
msgctxt "hcc14ab7fg2c34g4502gae44g05b3ba54c4fb"
msgid ""
"You wound me. I've only tried to be a friend to you - just as to the poor "
"souls here, where hope hangs by a single thread."
msgstr ""
"이것 참 마음에 상처를 주는군요. 전 그저 친구가 되려고 한 것뿐입니다. 여기 희망이 가느다란 실에 매달린 곳에 있는 이 불쌍한 "
"영혼들에게도 친구가 되려고 한 것처럼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 1e0173a4-b950-b7a4-baef-ec4fe6a76c21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:1e0173a4-b950-b7a4-baef-ec4fe6a76c21
msgctxt "h463bd709gd436g4689g997fg659f149023d1"
msgid ""
"But of course, you'll have to do something for me first. Let me think about "
"it and get back to you."
msgstr "물론 그 전에 앞서서, 제게 뭔가를 해주셔야겠군요. 생각을 좀 해 보고 다시 돌아오도록 하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 1e7eeef0-bd4d-e2cb-9518-dd6a7fa96c9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:1e7eeef0-bd4d-e2cb-9518-dd6a7fa96c9b
msgctxt "h33154556g74f0g4fbaga4d7gb54d721bd0c7"
msgid "I do. I have a proposal for you."
msgstr "그래. 제안할 게 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 21e0a8db-193b-a170-2c53-15aaf2d1ad17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:21e0a8db-193b-a170-2c53-15aaf2d1ad17
msgctxt "h06b3eee6g6d54g46e4gbe57g8a48b6de65cc"
msgid "Well. Now you know."
msgstr "뭐. 이제 알았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 2259fa34-4709-1967-ea13-ef5f5dc6499c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:2259fa34-4709-1967-ea13-ef5f5dc6499c
msgctxt "h6d7f604bg210dg44e6gad8bga68fc62fd174"
msgid "Are you following me?"
msgstr "날 따라다닌 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 235e396f-99e4-7870-626b-8e52f4202da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:235e396f-99e4-7870-626b-8e52f4202da0
msgctxt "h4059ab04g99d4g4321g9f30gc8cbb8be98af"
msgid ""
"Such a shame to end a spree before you've tired of the slaughter. But don't "
"be disheartened."
msgstr "성에 차기도 전에 학살을 멈춰야 했다니 참으로 안타까운 일이군요. 하지만 너무 낙담하진 마십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 2610c702-23e1-01f8-e0e8-bf453ddb5c82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:2610c702-23e1-01f8-e0e8-bf453ddb5c82
msgctxt "h1a3a2c24g44b4g4b83gbc08gf6341e75c87c"
msgid ""
"But what's done is done, so how about we stop talking about it and just get "
"on with things?"
msgstr "지난 건 어쩔 수 없지, 이제 그만 신경 끄고 다음 일을 생각하는 게 어떨까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 2618db15-a01f-81cf-557e-91893f6a2898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:2618db15-a01f-81cf-557e-91893f6a2898
msgctxt "ha700a635g0fe8g4574g8da6g554d34acb2d0"
msgid ""
"Ketheric Thorm - proud father, man of faith, utter fool. On the night the "
"Harpers sealed him away, someone murdered his entire army in cold blood."
msgstr ""
"케서릭 쏨. 자랑스러운 아버지, 독실한 신자, 어리석은 멍청이. 하퍼가 그를 봉인한 그 날 밤, 누군가 그의 군대 전체를 냉혹하게 "
"살해했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 2a32456a-e787-1274-f78a-f80756d25aa3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:2a32456a-e787-1274-f78a-f80756d25aa3
msgctxt "h65b27982gd330g416bg974egaaff2b57168d"
msgid ""
"My old - well, a long time ago someone carved some runes into my back. I'd "
"rather like to know what they say."
msgstr "내 옛 - 아니, 아주 오래전에, 누군가 내 등에 룬 문자를 새겨놨어. 그 문자들이 무얼 뜻하는지 알고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 355416b7-4988-eba0-79d4-87974a8cb661
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ee01d1c0-9e3b-de72-fa20-db701a173a27_RaphaelRemovedClothing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:355416b7-4988-eba0-79d4-87974a8cb661
msgctxt "h73dcf05fg68a7g4687g9d69g65a9536b2ae3"
msgid ""
"You haven't told them? And you've kept your clothes on this whole time? How "
"unlike you."
msgstr "말 안 해 줬군요? 여행하는 내내 옷도 계속 입고 있었고? 참 당신답지 않군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 3730d03c-537b-2b51-b775-78f1c042c04a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:3730d03c-537b-2b51-b775-78f1c042c04a
msgctxt "h1f81420cg78b3g4ae8g89ddg9db6d6ab1fb6"
msgid ""
"My, my, fancy meeting you here! Little late to be traipsing around Last "
"Light, isn't it? You've lit the fire, you've freed the angel,  so shoo! Go "
"after her!"
msgstr ""
"이런, 이런, 여기서 만나다니 반갑군요! 최후의 빛 주변을 배회하기엔 조금 늦지 않았소? 불을 지르고, 천사를 놓아주었잖소, 그러니 "
"어서! 천사나 쫓으시오!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 37ca1f8e-c6be-3f84-475d-9797f088dd02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:37ca1f8e-c6be-3f84-475d-9797f088dd02
msgctxt "h4e74dbc8g808bg40a6g980fga415a58099f1"
msgid ""
"At times I wonder if some other fiend swapped out your tongue with that of "
"an ox."
msgstr "가끔 다른 마족이 당신 혀를 황소의 것으로 바꿔놓은 건 아닌가 하는 생각이 드네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 3b8141a4-ad89-211b-d521-bb4dbb00d548
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:3b8141a4-ad89-211b-d521-bb4dbb00d548
msgctxt "ha577bbf1ge43ag4caeg8252ga780f71c8ac4"
msgid ""
"I do love the people I meet in these dark lands. Everyone's desperate for "
"something."
msgstr "전 이 어둠의 땅들에서 만나는 사람들을 좋아한답니다. 다들 각자의 이유로 절박하거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 431f9b4b-7d63-0198-7633-733e3c5e3f4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = False
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:431f9b4b-7d63-0198-7633-733e3c5e3f4e
msgctxt "h5cd4cd55g8ef7g418bg8084g8966c8a82c5a"
msgid ""
"I wanted to ask you about the Infernal scars on my back. What do they mean?"
msgstr "내 등에 지옥하고 연관된 흉터 같은 게 있는데 이걸 물어보고 싶어. 이게 무슨 의미인지 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 442140a6-d246-4c34-4b1e-2c05a2ed39d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:442140a6-d246-4c34-4b1e-2c05a2ed39d2
msgctxt "h7deaf562g3bb2g4a3fgb9b2gc730bd9e837c"
msgid ""
"Don't worry - I'm motivated to help you. Scars often tell such wonderful "
"stories - I think yours might be truly exquisite. I'll see you soon."
msgstr ""
"걱정하지 마세요. 당신을 돕고 싶으니까. 흉터는 종종 멋진 이야기를 들려주고는 하는데, 당신 흉터라면 정말이지 강렬한 이야기이겠군요. 곧 "
"봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 4d6596e9-67aa-deac-5bc7-81cba7502c7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:4d6596e9-67aa-deac-5bc7-81cba7502c7d
msgctxt "hcc3e03a3g1b0bg4e45g9d3bgd0776159e099"
msgid ""
"Cazador worked on it from dusk until dawn, all with an ancient blade he "
"called his 'needle'. Cutting and tearing, starting over if I screamed or "
"winced too much."
msgstr ""
"카사도어가 해 질 녘부터 동틀 때까지 '바늘'이라고 하는 고대 단검으로 새겨넣었지. 비명을 지르거나 너무 움찔거리면 처음부터 또 살을 "
"자르고 찢었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 50c31b03-a879-0913-d556-90c2d7ead471
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:50c31b03-a879-0913-d556-90c2d7ead471
msgctxt "hddabc36egea95g48b9g8f9ag3a758aef763e"
msgid ""
"You flatter yourself - you're not the only soul of interest in this ruin. "
"This is Last Light, where hope hangs on by a single withered thread."
msgstr ""
"스스로를 너무 고평가하는군요. 이 폐허에는 당신 말고도 흥미로운 영혼이 많아요. 여긴 최후의 빛입니다. 희망이 말라붙은 한 가닥 실에 "
"가까스로 매달려 있는 곳이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 580cb176-f902-1a32-c0b8-ef6544ebc135
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:580cb176-f902-1a32-c0b8-ef6544ebc135
msgctxt "hfea4eccfg9be2g4304g9ee5g58af4ee2709b"
msgid "Enjoy them while you can - I'll smite you down soon enough."
msgstr "즐길 수 있을 때 즐겨둬. 곧 널 때려눕혀 줄 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 5a78228d-f2bc-786e-0166-05446d2d73c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:5a78228d-f2bc-786e-0166-05446d2d73c4
msgctxt "h70e24b0dgade6g4a55gbb0dgb1aa097dee41"
msgid "It was a rough night."
msgstr "아주 지독한 밤이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 5ce00c95-3788-a0f8-d549-842c07f5c992
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:5ce00c95-3788-a0f8-d549-842c07f5c992
msgctxt "h4b828974gb82dg49bfga574gc91330949a23"
msgid "Gods... the carving must have been excruciating."
msgstr "신이시여...살을 파내는 고통이 끔찍했겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 61807d14-5384-6a6c-27e9-b2e192c97028
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:61807d14-5384-6a6c-27e9-b2e192c97028
msgctxt "h554b1539gba4ag42fag9754gcc38c46fd10a"
msgid "I need a shot of liquid courage before I go. Perhaps you'll join me."
msgstr "가기 전에 용기 한잔이 필요해서 말이지. 너라면 어울려 줄 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 639da1af-0b89-1c02-5cb2-e840a9bd8ef4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#.   Object:
#.     - ORI_Inclusion_End_Astarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:639da1af-0b89-1c02-5cb2-e840a9bd8ef4
msgctxt "h41714fe6gc2c1g457bg90e1gf2232c509171"
msgid ""
"Don't worry - I'm motivated to help you. Scars often tell such wonderful "
"stories - I think yours might be truly exquisite. I'll see you soon."
msgstr ""
"걱정하지 마세요 - 당신을 도울 생각입니다. 상처는 가끔씩 아주 훌륭한 이야기를 들려주곤 하죠 - 당신의 등에 있는 이야기 역시 아직 "
"멋질 것 같군요. 곧 뵙도록 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 6642081c-4cd3-f5de-f0f8-ef07306fe161
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = False
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:6642081c-4cd3-f5de-f0f8-ef07306fe161
msgctxt "hac2111b8ge818g457dgacd8gde1637102b9a"
msgid ""
"I wanted to ask you about the Infernal scars on my back. What do they mean?"
msgstr "내 등에 지옥하고 연관된 흉터 같은 게 있는데 이걸 물어보고 싶어. 이게 무슨 의미인지 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 685e40ac-446a-7a82-dcc1-8e097b063a11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:685e40ac-446a-7a82-dcc1-8e097b063a11
msgctxt "he436c823gd3d6g4f31g9f95g07c033392087"
msgid ""
"Anyway - don't linger here too long, will you? I've got front row tickets "
"for your grand finale in Moonrise Towers, and I'm dying to see the show go "
"on."
msgstr ""
"어쨌거나, 너무 오래 머물러있진 마세요, 알겠죠? 문라이즈 타워에서 열리는 당신의 피날레를 볼 수 있는 맨 앞 좌석 티켓이 있는데 그 "
"피날레를 너무 보고 싶거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 6a059323-eb37-2b6e-3305-52c9c4fd7ef2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:6a059323-eb37-2b6e-3305-52c9c4fd7ef2
msgctxt "h8ae47e4cg9c3dg4d26gb858g3b875038bf91"
msgid "Don't play games Raphael. Help him out."
msgstr "장난 치지 말고, 라파엘. 도와줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 6afd1e26-665b-a242-16e3-d592b3d64f39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:6afd1e26-665b-a242-16e3-d592b3d64f39
msgctxt "hb03f0361g43deg49f7g9806g681aae2ad77c"
msgid "You'll 'get back' to me? This is important, devil. When?"
msgstr "다시 돌아온다고? 이건 중요한 일이야, 데빌. 언제 돌아온다는 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 729c1ad2-550c-5369-5b17-e6119ecde6aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:729c1ad2-550c-5369-5b17-e6119ecde6aa
msgctxt "hd2c3fa58gfb55g48c5gbd7dgb20508ea7ffd"
msgid "You're not responsible for the curse, are you?"
msgstr "그림자 저주가 네가 한 짓은 아니지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 73f29889-d01e-b075-9805-00b32ed6df77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:73f29889-d01e-b075-9805-00b32ed6df77
msgctxt "h54a07495gdab7g4f23g99a5gf8608071d850"
msgid ""
"A proposal? If you're hoping to taste my blood, little vampling, think "
"again. It burns hotter than Wyvern Whiskey."
msgstr ""
"제안이라? 만약 제 피를 마시고 싶은 거라면, 어리석은 뱀플링이여, 생각을 바꾸시죠. 그랬다간 와이번 위스키보다 더 뜨겁게 타오를 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 7953630a-24a5-e0e8-b372-6338b8fc3c1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:7953630a-24a5-e0e8-b372-6338b8fc3c1e
msgctxt "h67588a04gcf77g4039g94ceg03f3cca0fb27"
msgid ""
"A love letter? A warning? A deed of ownership? I could give you all the gory "
"details."
msgstr "연애편지이려나? 아니면 경고문? 소유권 증서? 내가 그 피 냄새 가득한 내용을 알려 줄 순 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 7b3bfb40-3e09-7866-1f2f-32450136dbef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:7b3bfb40-3e09-7866-1f2f-32450136dbef
msgctxt "hbf934fbag5eaag4bccg91e4g84cd7f03734a"
msgid ""
"If you want to know more, I could work the exchange of such precious "
"knowledge into the terms of your future deal."
msgstr "더 알고 싶으시다면, 추후에 있을 거래의 계약 조건에 이 귀중한 지식을 포함시키도록 할 수도 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 7be41b3f-473e-5fea-1898-d44cfdcc275b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:7be41b3f-473e-5fea-1898-d44cfdcc275b
msgctxt "hb0f877a2ge068g454ag86ebg6d43a67bc1d5"
msgid "Spit it out, Raphael."
msgstr "빨리 털어놔, 라파엘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 7ef342e6-c95b-7cf6-e8a2-c68c5eda4831
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:7ef342e6-c95b-7cf6-e8a2-c68c5eda4831
msgctxt "h24ed6ed8ge9a5g4291g837eg5908aecb7f9a"
msgid ""
"Not with you, at least. Although I sense there's something your friend wants "
"to ask me."
msgstr "적어도 당신은 빼고요. 당신 친구가 제게 물어보고 싶은 게 있는 것 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 878c1352-99fe-78f1-84ed-8cad70875ab0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:878c1352-99fe-78f1-84ed-8cad70875ab0
msgctxt "h4fdd03d4g2d1dg48f0g895ag07eec837ac90"
msgid ""
"A devil encouraging me to follow an angel. Aren't you full of surprises."
msgstr "천사를 따라가라고 하는 데빌이라. 넌 정말 예측할 수 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 8bc0a412-6996-c6b3-3e07-466c58677625
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:8bc0a412-6996-c6b3-3e07-466c58677625
msgctxt "h352cecf7g00d3g43bbg8a6eg4a7fa37c4413"
msgid "With your tail between your legs."
msgstr "꼬리를 다리 사이로 말아 넣은 채로요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = 974c52d6-e51f-616a-dafb-fd1cbfbce427
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:974c52d6-e51f-616a-dafb-fd1cbfbce427
msgctxt "h05708a44g1095g4f43g9cbbg07deb872aa89"
msgid "You again - I'm sure your arrival is simply a coincidence."
msgstr "또 너로군. 네가 여기 온 것도 순전히 우연이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 97ab081c-3a10-2f64-7303-a940e4ada068
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:97ab081c-3a10-2f64-7303-a940e4ada068
msgctxt "ha3f09496gd5a5g4d4ega141ga44f9846641e"
msgid "Hmmnmm..."
msgstr "흐으으음...."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 99cdcfde-f92a-5d25-5228-ad4dc555cc42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:99cdcfde-f92a-5d25-5228-ad4dc555cc42
msgctxt "hd5db56b1g9896g48f2g8927g432af4bffbd2"
msgid "Why not let them see? Don't be shy."
msgstr "보여주는 게 어떻습니까? 부끄러워하지 마시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = 9a756f53-d3eb-f422-19a8-1c59e0125388
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:9a756f53-d3eb-f422-19a8-1c59e0125388
msgctxt "h114e2ed9g48f1g4be8ga39cg562abbbc397a"
msgid ""
"It's good to see you again. I'd ask if you've made any progress with your "
"little problem, but the tell-tale twitching of your eye is answer enough."
msgstr ""
"다시 만나게 되어 반갑습니다. 당신의 사소한 문제와 관련해 진전이 있었는지 물어보려고 했는데, 그 눈 깜빡임을 보니 그럴 필요는 없겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = 9e3b780c-ee49-d36a-6e12-a358b955c432
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:9e3b780c-ee49-d36a-6e12-a358b955c432
msgctxt "h41f129fdg1073g4c92ga15fg0a2e58debf21"
msgid "Gods damn it."
msgstr "이런 제기랄."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = a5d83f20-5bf8-8644-3e38-a8938c2b9ebd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:a5d83f20-5bf8-8644-3e38-a8938c2b9ebd
msgctxt "heeda60d0g8e98g438dg8c53gb512a4391075"
msgid "I'm fine - the last thing I need is your meddling."
msgstr "됐어, 네 간섭은 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = abb5cdd3-e208-884e-5852-5fe82d515be2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:abb5cdd3-e208-884e-5852-5fe82d515be2
msgctxt "h5d839533g9ae3g4529g9642gecbadf34ad2f"
msgid ""
"But of course, those curious little marks. Something important to your "
"master, no doubt, but what?"
msgstr "물론, 그 수수께끼 같은 조그만 기호 말하는 거겠죠. 틀림없이 당신 주인에게 아주 중요했던 거 같은데, 그게 대체 뭘까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = ae1b1ac1-f9fd-a47e-fd72-640a6ac5630a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:ae1b1ac1-f9fd-a47e-fd72-640a6ac5630a
msgctxt "h95854728ga3d4g4544g9272gb99f7f3ab55e"
msgid "This is a bad idea Astarion. We should find another way."
msgstr "좋은 생각이 아닌 것 같아, 아스타리온. 다른 방법을 찾아보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = b0984183-0dcc-87ec-87b4-aa0e21eb65d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:b0984183-0dcc-87ec-87b4-aa0e21eb65d5
msgctxt "h794f88a4gc3a4g4a62g8f27g2853752c417c"
msgid ""
"Too parochial a setting for me, I'm afraid. I prefer my liquor served in a "
"quivering belly button, distilled in fear and arousal."
msgstr "미안하지만, 제가 끼기엔 판이 너무 작군요. 전 공포와 흥분으로 증류되어 벌벌 떠는 배꼽에 담겨오는 술을 선호한답니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = b610aea9-dceb-0b03-60b6-6f191f94d137
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:b610aea9-dceb-0b03-60b6-6f191f94d137
msgctxt "h439de456gfd91g4119g8acdgf0874db77139"
msgid ""
"Don't worry - I'm motivated to help you. Scars often tell such wonderful "
"stories - I think yours might be truly exquisite. I'll see you soon."
msgstr ""
"걱정하지 마시죠, 전 당신을 돕고자 하니까요. 흉터는 종종 아름다운 사연을 갖고 있죠. 당신의 사연은 매우 훌륭할 것 같군요. 조만간 또 "
"보시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = b97ca110-f324-6b53-2d1d-2b13eb83f6bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:b97ca110-f324-6b53-2d1d-2b13eb83f6bc
msgctxt "hcd544c26ge26bg4c80gb276g3812d92789fe"
msgid ""
"No offence meant, of course. I'm sure everyone in Last Light thinks they "
"could have changed things."
msgstr "물론, 나쁜 뜻은 없습니다. 최후의 빛에 있는 모두가 자기가 결과를 바꿀 수 있다고 믿고 있겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = bae91136-f65b-c959-cefc-4ea70f6ae2a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:bae91136-f65b-c959-cefc-4ea70f6ae2a6
msgctxt "hdd1e3ba9gce89g4ee6g85eag457dcbe51846"
msgid ""
"Please, I would never leave such a mess behind. Far too much attention for "
"so little gain."
msgstr "설마요, 저는 저렇게 엉망으로 어질러 놓고 다니지 않아요. 얻는 것에 비해 쓸데없이 많은 이목을 끌잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = bf28c1a5-1c6c-2e06-4c7e-7a6fa68baa1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:bf28c1a5-1c6c-2e06-4c7e-7a6fa68baa1c
msgctxt "h02720341g244dg4b9agbd05gbc63f65cdf32"
msgid ""
"Sometimes you've got to root for Team Celestial. Keeps you on your toes."
msgstr "가끔은 천국 쪽을 응원해야 할 때도 있는 법이죠. 긴장감을 주거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = c4d5c55f-d4ff-e28c-f8c2-265c6113bf99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:c4d5c55f-d4ff-e28c-f8c2-265c6113bf99
msgctxt "h71e707c6g14fag4f95ga438g6fec6260735b"
msgid ""
"You've got a knack for giving me the dullest reply you could have possibly "
"given."
msgstr "당신은 가장 재미없는 답변을 해주는 재주가 있고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = cb1e1569-16c5-717e-9689-e5eef88f52a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:cb1e1569-16c5-717e-9689-e5eef88f52a2
msgctxt "h2088de25g0f3eg49adg81ecg62cc630c4708"
msgid ""
"You're the best thing for business since the Second Sundering. Countless "
"sorry souls came running to my door after your work in the grove."
msgstr ""
"당신은 제2차 대분단 이래로 제 사업에 가장 큰 호재입니다. 당신이 숲에서 저지른 일 덕분에 수 없이 많은 불쌍한 영혼들이 제 문을 "
"두드리고 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = cb5e339c-fe57-0aec-6a57-687c80b217a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:cb5e339c-fe57-0aec-6a57-687c80b217a3
msgctxt "h83f7fbc4ge69fg4342g98b8g4a895eaa5a21"
msgid "I can mend it or cut it, depending on what they ask for."
msgstr "전 그 실을 잘라버릴 수도, 이어줄 수도 있죠. 저에게 뭘 부탁하느냐에 따라서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = cec6cbce-9bd3-e4aa-4153-3fa8c7444ee3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:cec6cbce-9bd3-e4aa-4153-3fa8c7444ee3
msgctxt "h4a1d7946gfeb8g4c69g9a14g43cfc9d17912"
msgid "Although I should probably get dressed first..."
msgstr "일단 옷을 좀 입어야 할 것 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = d2022c14-5dc1-1fe8-3006-6998c5f16dc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:d2022c14-5dc1-1fe8-3006-6998c5f16dc4
msgctxt "he53e76eagc117g484dgb258g4e9a310f7c28"
msgid "Family troubles. Not my family, of course."
msgstr "가족 문제였죠. 제 가족 말고요, 물론."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = d2bb3530-ec01-d021-341c-a631617e6133
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:d2bb3530-ec01-d021-341c-a631617e6133
msgctxt "h40688b79g8fbcg4c52g9477g4eacdf6b175b"
msgid "I don't think he knows."
msgstr "얘가 아는 거 같진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = d600afcd-ee57-4b43-1f2a-2348251f12a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:d600afcd-ee57-4b43-1f2a-2348251f12a3
msgctxt "h4b072ab4g9f03g4404gb1b9g75fe3e743ebe"
msgid ""
"After all - here you are again, in a refuge for the haggard and weary. "
"Plenty of clients - or victims - for both of us."
msgstr ""
"다시금 비슷한 곳에 왔잖아요. 초췌하고 지친 이들이 모인 피난처 말입니다. 우리 둘 모두를 위한 고객 혹은 희생양으로 가득한 곳이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = d6985708-ce72-b2b7-9ed3-b7dc4fb4656b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:d6985708-ce72-b2b7-9ed3-b7dc4fb4656b
msgctxt "h5a1d35c8g8a39g4a7cga1b0g00930b32786b"
msgid "All I know is you have us doing odd jobs for a devil."
msgstr "확실한 건 이제 네 덕분에 데빌의 부탁을 들어줘야 한다는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = dd649b2e-b9e4-fb9f-fd55-b9a52f2fedaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:dd649b2e-b9e4-fb9f-fd55-b9a52f2fedaa
msgctxt "h6fd83433g5f1ag4fa0gaca5g751c194f8b2a"
msgid "Let's just go. Standing here chatting gets us nowhere."
msgstr "그냥 넘어가자. 여기서 서서 얘기하는 건 아무 의미 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = de443d91-1479-6835-a226-8766afee310e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:de443d91-1479-6835-a226-8766afee310e
msgctxt "h4eabf315gbf8dg4e0aga378g2855b49a9eff"
msgid "I'd have sent more souls your way, but I ran out of tieflings to kill."
msgstr "너한테 더 많은 영혼을 보낼 수 있었는데, 죽일 티플링이 다 떨어져서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = de76af5d-8c17-a4c9-4523-506443de8ac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:de76af5d-8c17-a4c9-4523-506443de8ac8
msgctxt "hc00e7448g6959g439dgbcc6g92b0772e9629"
msgid "You included, I presume."
msgstr "추측하건대, 너를 포함하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = df3da297-7b02-c296-7ead-84c928ad71a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:df3da297-7b02-c296-7ead-84c928ad71a0
msgctxt "hd49fa5ceg6e22g4f3fgb250g9590212c13a2"
msgid ""
"But the time for quibbling over clauses and contracts hasn't quite arrived. "
"You'll be limping back to me soon enough."
msgstr "하지만 아직 조항이니 계약이니 하며 옥신각신할 때는 아닌 것 같군요. 머잖아 절뚝거리며 제게 오게 될 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = df4b646c-e759-31a1-fb79-dde7a9771728
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:df4b646c-e759-31a1-fb79-dde7a9771728
msgctxt "hd646c61ag4cfag41ddgb571gaf1eb3efd2f1"
msgid ""
"They're not the only ones ripe for temptation, you know. My last contract "
"here fed me for decades."
msgstr "유혹하기 딱 좋게 무르익은 게 저들뿐인 건 아닙니다. 여기서 했던 마지막 계약이 절 수십 년 동안 먹여 살렸죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = e2a2a13a-696d-d50d-e3a5-3b7c427fe7cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:e2a2a13a-696d-d50d-e3a5-3b7c427fe7cb
msgctxt "h6c30f843g6dc8g4a98g97b4g5f8a4a41c0d0"
msgid "Really?"
msgstr "과연 그럴까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = eae7d57d-b1f6-41fc-6cb8-115f57a67982
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:eae7d57d-b1f6-41fc-6cb8-115f57a67982
msgctxt "h0770b55egf0aag41a9g83e2g6b2f565ce18a"
msgid "What are you talking about, Astarion? What scars?"
msgstr "무슨 얘기야, 아스타리온? 흉터라니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = eb55de47-6b55-5352-293a-cd76729acda2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = False
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:eb55de47-6b55-5352-293a-cd76729acda2
msgctxt "h40a10bb0g09e9g4dbeg87a6g69c6aff6fe5b"
msgid "Wipe that smugness from your face or I'll smite it off."
msgstr "그 우쭐한 표정 치우지 않으면 내가 직접 치워주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Player
#. NodeID = f1a51260-03f1-1532-5b59-1e7e3493982b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:f1a51260-03f1-1532-5b59-1e7e3493982b
msgctxt "ha642e65fg0739g476egb5d6g5f5d26439832"
msgid "Why didn't you tell me earlier? I could have helped."
msgstr "왜 진작 말해주지 않았어? 도울 수도 있었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = f4d98260-6782-74b5-31ca-b34ac63eb049
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:f4d98260-6782-74b5-31ca-b34ac63eb049
msgctxt "hd3550fb6g5472g4256g8bc3gf0d3a2a5ee39"
msgid ""
"But of course, you'll have to do something for me first. Let me think about "
"it and get back to you."
msgstr "물론 그 전에 앞서서, 제게 뭔가를 해주셔야겠군요. 생각을 좀 해 보고 다시 돌아오도록 하지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Astarion
#. NodeID = f7c47509-ab93-6a86-a4c4-0c1fc4838fd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:f7c47509-ab93-6a86-a4c4-0c1fc4838fd2
msgctxt "hd5e739f3g3e93g4c5bgb598gc6002f5d70ba"
msgid ""
"It could be infinitely worse. We seem to be rather good at killing things."
msgstr "이 정도면 그래도 괜찮은 거야. 뭘 죽이는 건 우리가 잘 하는 것 같으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael
#. Speaker = Raphael
#. NodeID = f8d03735-afe4-5103-b163-8ce2572d1898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_Raphael:f8d03735-afe4-5103-b163-8ce2572d1898
msgctxt "h75cba139gb5f7g4564gb111g88c1dd15acf5"
msgid ""
"It's something very important to your master. But is it a love letter, a "
"warning, or a deed of ownership? I could give you all the gory details."
msgstr ""
"당신의 주인에게 매우 중요한 거겠지요. 연애편지이려나? 아니면 경고문? 소유권 증서? 내가 그 피 냄새 가득한 내용을 알려 줄 순 "
"있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_RaphaelWaiting
#. Speaker = Raphael
#. NodeID = d0a61c37-9d7b-4e7e-ae73-103d96efc586
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_MolsDeal_RaphaelWaiting:d0a61c37-9d7b-4e7e-ae73-103d96efc586
msgctxt "h44c51d1cg7043g4d37gb3bbg321681da68e8"
msgid ""
"Sorry, I have an appointment with someone far more interesting than you. "
"We'll speak soon."
msgstr "미안합니다만, 당신보다 훨씬 더 흥미로운 사람과 선약이 있어서 말이죠. 나중에 다시 얘기합시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_DouseTorch
#. Speaker = Narrator
#. NodeID = 9a7df3b6-5490-bd17-9d1a-e3e2568ab147
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GEB_CrimeWarning_3(1) = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_DouseTorch:9a7df3b6-5490-bd17-9d1a-e3e2568ab147
msgctxt "h409d304fgaf29g415eg8482g04c0d3cbb7c5"
msgid ""
"*The denizens of Last Light are fed up with your reckless torch-dousing in "
"the face of the shadow curse.*"
msgstr "*최후의 빛 여관 사람들은 그림자 저주를 마주하고 있는 마당에 무책임하게 횃불을 꺼버리는 당신에게 진절머리가 났습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_DouseTorch
#. Speaker = Narrator
#. NodeID = a94a8fb3-cdad-63c7-3668-c8484c375c6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GEB_CrimeWarning_2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_DouseTorch:a94a8fb3-cdad-63c7-3668-c8484c375c6b
msgctxt "h170662a8gf6a5g47afg85aagc94124bd48fa"
msgid ""
"*Beware - this is the only warning you'll get in Last Light about the crime "
"of dousing a torch.*"
msgstr "*조심하세요. 이번이 최후의 빛에서 횃불을 끄는 범죄에 대한 마지막 경고입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_DouseTorch
#. Speaker = Narrator
#. NodeID = ccd247bf-4692-f0c6-9afa-1413291b29ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_DouseTorch:ccd247bf-4692-f0c6-9afa-1413291b29ff
msgctxt "ha5c75897g68bag4d41gaaaegced60b097df5"
msgid ""
"*Where torches protect mortal souls from a shadow curse, dousing one is "
"considered a crime.*"
msgstr "*횃불이 그림자 저주로부터 필멸자들의 영혼을 지켜주는 곳에서는, 불을 끄는 것을 범죄로 간주합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing
#. Speaker = Narrator
#. NodeID = 2541fb97-78c0-6b1a-f336-a10d077e6f90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Jaheira_State_Defeated = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing:2541fb97-78c0-6b1a-f336-a10d077e6f90
msgctxt "ha9f8644egecc3g481dg92ebge487cca61272"
msgid ""
"*You haven't got permission to remain here; now you'll need to defend "
"yourself.*"
msgstr "*당신은 여기 있을 허가를 얻지 못했습니다. 이제 자신을 방어해야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing
#. Speaker = Narrator
#. NodeID = 8891c29d-a76c-d44a-b0fd-5e853bd9c90e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Jaheira_State_Defeated = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = True
#. SetFlags:
#.   Object:
#.     - HAV_EnteringHaven_Event_TrespasserSpotted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing:8891c29d-a76c-d44a-b0fd-5e853bd9c90e
msgctxt "he251925fg3db7g4777ga731g3fc0fa303e89"
msgid ""
"*You won't be asked again - you'll need to get permission to walk freely in "
"this place.*"
msgstr "*마지막 경고입니다. 여기서 자유롭게 돌아다니려면 허가가 필요합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing
#. Speaker = Narrator
#. NodeID = cdbfa184-abb8-11a1-d63a-c7251ee0eea9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Jaheira_State_Defeated = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = False
#. SetFlags:
#.   Object:
#.     - HAV_EnteringHaven_Event_TrespasserSpotted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing:cdbfa184-abb8-11a1-d63a-c7251ee0eea9
msgctxt "ha4a75284g0702g4674gbb51gb776741dbd3d"
msgid ""
"*You've been caught sneaking around. Someone with authority will have to "
"grant you safe passage.*"
msgstr "*당신은 몰래 돌아다니다 걸렸습니다. 권위 있는 누군가가 통행을 허가해 주어야겠군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing
#. Speaker = Narrator
#. NodeID = fe7bbcc7-cbda-b8ce-9b1f-3685d2199f15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Global:
#.     - HAV_EnteringHaven_State_GainedAccess = True
#.     - HAV_EnteringHaven_State_GainedAccessNoJaheira = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_NGB_EnteringHaven_Trespassing:fe7bbcc7-cbda-b8ce-9b1f-3685d2199f15
msgctxt "ha611bf22gcf1eg4cdcgac52ga6a0b351f7c7"
msgid ""
"*You've been caught sneaking around. But the people here have more important "
"things to worry about - as long as you don't cause any trouble.*"
msgstr ""
"당신은 몰래 돌아다니다 걸렸습니다. 하지만 여기 사람들은 더 중요한 일에 신경 쓰고 있습니다. 당신이 문제만 일으키지 않는다면요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 19a4af24-fa0b-4360-9e11-b7a4598fbf7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Skillcheck_StuffedBear_Success = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:19a4af24-fa0b-4360-9e11-b7a4598fbf7f
msgctxt "h64e318c0gac67g46dag881fgd085379d3e15"
msgid "Wait, that bear - Darkmaw the Wicked? The Terror of Cloakwood?"
msgstr "잠깐, 저 곰은, 포악한 검은아귀? 클록우드의 공포?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 19a4af24-fa0b-4360-9e11-b7a4598fbf7f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Skillcheck_StuffedBear_Success = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:19a4af24-fa0b-4360-9e11-b7a4598fbf7f
msgctxt "h4c932a9bg376ag41f3g9c64g46ae71472eb6"
msgid "Believe it or not, but I know that stuffed bear. Darkmaw the Wicked."
msgstr "믿기 힘들겠지만, 나 저기 박제된 곰을 알아. 포악한 검은아귀야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 19a4af24-fa0b-4360-9e11-b7a4598fbf7f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Skillcheck_StuffedBear_Success = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:19a4af24-fa0b-4360-9e11-b7a4598fbf7f
msgctxt "hb4b72c7bg3c1fg4c5eg92bbge2ea907d28ff"
msgid "Darkmaw the Wicked! Legendary king of the forest."
msgstr "포악한 검은아귀! 숲의 전설적인 왕이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 19a4af24-fa0b-4360-9e11-b7a4598fbf7f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Skillcheck_StuffedBear_Success = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:19a4af24-fa0b-4360-9e11-b7a4598fbf7f
msgctxt "h4caa7c73gb3eeg44fbg88c6g90cb54c2b9d9"
msgid "Darkmaw the Wicked. The tale is known even to the githyanki."
msgstr "포악한 검은아귀라. 심지어 기스양키 조차도 그 이야기를 알고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 19a4af24-fa0b-4360-9e11-b7a4598fbf7f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Skillcheck_StuffedBear_Success = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:19a4af24-fa0b-4360-9e11-b7a4598fbf7f
msgctxt "h3ccf071fgb485g4191g8235gace9f415ac1b"
msgid ""
"That's Darkmaw the Wicked! Imagine meeting him in the flesh - or rather, in "
"the hide and stuffing."
msgstr "저건 포악한 검은아귀야! , 저놈이 살아있는 채로 마주친다고 생각해 봐 - 뭐 지금은 살이 아니라 가죽과 충전재 덩어리지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 19a4af24-fa0b-4360-9e11-b7a4598fbf7f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Skillcheck_StuffedBear_Success = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:19a4af24-fa0b-4360-9e11-b7a4598fbf7f
msgctxt "h20f0d3bbgb3cag4450g9c88g48e205d1bb3d"
msgid "Darkmaw the Wicked, straight from the storybooks."
msgstr "포악한 검은아귀라, 이야기 책에서 튀어 나왔구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 19a4af24-fa0b-4360-9e11-b7a4598fbf7f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Skillcheck_StuffedBear_Success = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:19a4af24-fa0b-4360-9e11-b7a4598fbf7f
msgctxt "h924dee80g002dg428egb7aag59cec1b51aac"
msgid "Is that Darkmaw the Wicked? I don't believe it."
msgstr "저거 진짜 포악한 검은아귀야? 못 믿겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 292dd758-c68b-4c41-b9f7-1c39862cf945
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:292dd758-c68b-4c41-b9f7-1c39862cf945
msgctxt "h8262317eg4240g4e4egb880g2fb8a2c11015"
msgid "Ferocious-looking beast. Although your stuffing might be leaking..."
msgstr "사나워 보이는 짐승이네. 속에 채워둔 건 좀 새는 것 같지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 292dd758-c68b-4c41-b9f7-1c39862cf945
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:292dd758-c68b-4c41-b9f7-1c39862cf945
msgctxt "h208a24b3g3d95g447cgb5dag7e4e29e4d5f6"
msgid "Impressive specimen. Better off stuffed than stalking me, I daresay."
msgstr "훌륭한 표본인걸. 날 쫓아오는 것보단 박제된 게 낫겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 292dd758-c68b-4c41-b9f7-1c39862cf945
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:292dd758-c68b-4c41-b9f7-1c39862cf945
msgctxt "h8379cd38gcb99g43aegbdc3ga00a17247056"
msgid "I'm watching you, buddy."
msgstr "지켜보고 있다고,친구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 292dd758-c68b-4c41-b9f7-1c39862cf945
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:292dd758-c68b-4c41-b9f7-1c39862cf945
msgctxt "h4f36ce94g971cg4da2ga704g05cfc094ca57"
msgid ""
"I suppose this stuffed beast is some kind of trophy. Well - I'm not "
"impressed."
msgstr "이 박제된 동물은 일종의 전리품인가 보군. 딱히 인상깊진 않다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 292dd758-c68b-4c41-b9f7-1c39862cf945
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:292dd758-c68b-4c41-b9f7-1c39862cf945
msgctxt "h8361df08gff47g44f7gac91g847a19d306a1"
msgid ""
"Look at the size of that thing. It could eat a person whole - or a double "
"portion of children."
msgstr "크기 좀 봐. 사람 한 명쯤은 거뜬히 먹겠는걸 - 애들은 두 명 정도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 292dd758-c68b-4c41-b9f7-1c39862cf945
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:292dd758-c68b-4c41-b9f7-1c39862cf945
msgctxt "h71d3e14dgd522g4b38gb52ag686c0e16736d"
msgid "Adorable. Vicious, but adorable."
msgstr "사랑스럽군. 사나워 보이지만 사랑스러워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 292dd758-c68b-4c41-b9f7-1c39862cf945
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:292dd758-c68b-4c41-b9f7-1c39862cf945
msgctxt "hc1bab831g9a09g4996g9052g04d4ffd049eb"
msgid "What a vicious looking creature. I swear its eyes are following me."
msgstr "굉장히 사나워 보이네. 시선이 날 따라오는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 8961b700-2f27-4075-8f8b-cbb4d66d0056
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:8961b700-2f27-4075-8f8b-cbb4d66d0056
msgctxt "h6bc68151geb9fg44c2g9b47g483f0936c468"
msgid "You stole away more children than any vampire. And look at you now..."
msgstr "넌 흡혈귀보다 더 많은 아이를 납치했지. 그런데 네 꼴 좀 봐..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 8961b700-2f27-4075-8f8b-cbb4d66d0056
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:8961b700-2f27-4075-8f8b-cbb4d66d0056
msgctxt "h97f3148fg4f73g444bga0d3g8057aed5fe0b"
msgid ""
"He terrorised everyone and everything between the woods of Cloak and Sharp "
"Teeth. Odd place for him to end up, this."
msgstr "칼날 이빨 숲과 망토 숲 사이에 있는 모든 것들을 공포에 떨게 했지. 이런 곳에서 마지막이라니, 좀 묘한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 8961b700-2f27-4075-8f8b-cbb4d66d0056
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:8961b700-2f27-4075-8f8b-cbb4d66d0056
msgctxt "heaf57722ga5bcg4e0fgb26dgbcadd212dcf0"
msgid ""
"Legend has it his kingdom ran from the Wood of Sharp Teeth to Cloak Wood. "
"How'd he end up here?"
msgstr "전설에 따르면, 칼날이빨 숲에서 클록우드 숲까지가 이 곰의 왕국이었다는데, 어떻게 여기까지 왔을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 8961b700-2f27-4075-8f8b-cbb4d66d0056
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:8961b700-2f27-4075-8f8b-cbb4d66d0056
msgctxt "hca49e126gc93dg4bf1g90b0g0ed5b824c92f"
msgid ""
"It's said that it took five-hundred warriors to drive him from his lands. "
"<i>Chk</i> - I thought he'd be <i>bigger.</i>"
msgstr "이 곰을 영역에서 쫓아내는데 500명의 전사들이 필요했다 한다. <i>츠크</i>, 이것보다 <i>더 클</i> 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 8961b700-2f27-4075-8f8b-cbb4d66d0056
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:8961b700-2f27-4075-8f8b-cbb4d66d0056
msgctxt "h4b8d08dage945g48e4gaa95ga2e43b414399"
msgid ""
"Everything from the Wood of Sharp Teeth to Cloakwood was his hunting ground, "
"until a small army rallied to take him down."
msgstr "이걸 쓰러뜨리기 위해 소규모 군대를 소집하기 전까진, 칼날 이빨 숲에서부터 클록우드 숲까지 모두 이 곰의 사냥터였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 8961b700-2f27-4075-8f8b-cbb4d66d0056
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:8961b700-2f27-4075-8f8b-cbb4d66d0056
msgctxt "h60af08beg5ad9g4b0eg91e8g07215c21ddb9"
msgid ""
"It took a veritable army to run him from the Wood of Sharp Teeth. Who in the "
"hells brought him here?"
msgstr "칼날 이빨 숲에서 이 곰을 몰아내려고 실력 있는 군대를 투입했어. 대체 어떤 놈이 이걸 가져왔을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear
#. Speaker = Player
#. NodeID = 8961b700-2f27-4075-8f8b-cbb4d66d0056
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_PAD_StuffedBear:8961b700-2f27-4075-8f8b-cbb4d66d0056
msgctxt "h22f6b9c4g9832g42bbg8234ga5f358d5aae6"
msgid ""
"His territory ran from the Wood of Sharp Teeth to Cloakwood. It took half an "
"army to drive him out. How did he end up here?"
msgstr "칼날 이빨 숲에서 클록우드 숲까지 이 곰의 영역이었어. 곰을 내쫓는 데 군대의 절반이 필요했지. 어떻게 여기에 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = 03979b55-f43c-dcf0-10a1-8c070274c5ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:03979b55-f43c-dcf0-10a1-8c070274c5ec
msgctxt "h08f6dc97gf1c7g4e64gb994g9cca160f58a5"
msgid ""
"He did. He wants you to 'keep your sacred vow' and name a spell after him."
msgstr "했어. 칼은 네가 '신성한 서약을 지켰'으면 하고, 자기 이름을 딴 주문을 만들어주길 바란대."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 0d1968d1-cdbd-4f8a-ba18-ed9bc6a086cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = True
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = False
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = False
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:0d1968d1-cdbd-4f8a-ba18-ed9bc6a086cd
msgctxt "hb3fac93dg80b4g4954ga50cgec387e22eef6"
msgid "Do you two need anything? Something to eat or drink, perhaps?"
msgstr "뭐 필요한 거 있어? 먹을 거나 마실 거라도?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 0d9c47a4-c1ad-4d4f-b74f-4081abead997
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = True
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:0d9c47a4-c1ad-4d4f-b74f-4081abead997
msgctxt "h8c607d20g758dg47bdg9af9g8470bf876252"
msgid "How bad was it? In Moonrise?"
msgstr "문라이즈에서 대체 무슨 일을 당한거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 1143c708-11c5-4b54-ab53-5f2d6a5bae05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:1143c708-11c5-4b54-ab53-5f2d6a5bae05
msgctxt "h8e5dd225g2e8ag4903gaa85ga0bf90ee58b7"
msgid "No, not another word. This isn't your fault."
msgstr "아니, 더 이상 말하지 마. 네 잘못이 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = 11d3ca5e-a380-48a1-8226-c334af9ae70e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:11d3ca5e-a380-48a1-8226-c334af9ae70e
msgctxt "heac46a55g7939g47f4g9717ga25b801bb9fc"
msgid "No splitting up, ever again, you hear?"
msgstr "갈라지기 없기, 두번 다시. 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 13cdc231-9347-d0d6-9fec-50c60acec0d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:13cdc231-9347-d0d6-9fec-50c60acec0d2
msgctxt "h632a42deg14eag4e25gaf17g526098db3df8"
msgid "The cultists and their bastard god are to blame. Nobody else."
msgstr "추종자들과 개 같은 신 때문이지. 누구의 잘못도 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = 16e9d552-f3da-4062-b91c-3e9dbdb36c3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:16e9d552-f3da-4062-b91c-3e9dbdb36c3c
msgctxt "h2f941b9cg9ac5g443fg9ea2ge2b0566d3db3"
msgid "I'm sorry, Rolan."
msgstr "미안해, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 21cd8523-8458-a726-a3b4-0d7153253c5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:21cd8523-8458-a726-a3b4-0d7153253c5d
msgctxt "h0c4c9f6ag77f1g419ag9073g99ed4a5ca6b0"
msgid "Sorry, I'm just... tired. Of this - of everything."
msgstr "미안, 난 그냥... 피곤한가 봐. 이게... 모든 게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 253fd89e-4311-4900-8f60-bbff9b6ff227
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:253fd89e-4311-4900-8f60-bbff9b6ff227
msgctxt "h89d0c558g6c23g4c6dg954cg434a83fadfd1"
msgid "Did Cal say anything? Before he... died?"
msgstr "칼이 남긴 말이라도 있어? 죽기...전에?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 37da4515-914e-e30a-fb4c-a97861811e4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:37da4515-914e-e30a-fb4c-a97861811e4e
msgctxt "h98bfe869gb9acg425fg906fg40cedcb1d81e"
msgid ""
"Gods, I'd forgotten that. In my defence, it was his birthday and I'd had "
"several glasses of wine."
msgstr "맙소사, 완전히 까먹고 있었네. 변명하자면, 그날은 칼의 생일이었고 난 와인을 여러 잔 마신 상태였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 3b4c8bf1-0839-492f-a854-b6a10f6655ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:3b4c8bf1-0839-492f-a854-b6a10f6655ac
msgctxt "h7980454ag9ac9g4c1dg95c9g8d54fc6e0ebd"
msgid "For once we are in agreement."
msgstr "드디어 모두가 같은 생각이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = 423fab92-7457-420c-a02d-4eebdf01be32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:423fab92-7457-420c-a02d-4eebdf01be32
msgctxt "h88ee7811g74f0g4b10ga10fg1a20e4b7c87c"
msgid "You know what I mean."
msgstr "무슨 말인지 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 4df4c553-05b2-4074-828e-a5a9ddf13efa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:4df4c553-05b2-4074-828e-a5a9ddf13efa
msgctxt "h427f0a06gb3bcg4834gbda8g5bdd8f0ec648"
msgid "Not here. Lia deserves a proper send-off - and a proper memorial."
msgstr "여기선 안 돼. 리아에겐 제대로 작별 인사를 하고, 제대로 추모해줘야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 61936cc3-f137-4f6f-8770-7ab154026d31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = False
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = False
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:61936cc3-f137-4f6f-8770-7ab154026d31
msgctxt "hf46e8072gbc9fg41cag81f7g6941c8562482"
msgid "I'm glad you're here."
msgstr "무사히 만나서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = 647603ca-f9ad-4290-a67f-4ba3fc1dba2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = False
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = False
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:647603ca-f9ad-4290-a67f-4ba3fc1dba2c
msgctxt "h1f118a23gbe27g42d0gb5ddg59fd40ca1927"
msgid "We should do something for Lia. A gravestone, or something."
msgstr "리아를 위해 뭐라도 해야 해. 묘비나, 그런 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = 6504c3d1-88a1-4b7e-97c0-c5eb6f9626e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:6504c3d1-88a1-4b7e-97c0-c5eb6f9626e8
msgctxt "hf9f0e4b2ge520g4ee3g9bd7g4e164f6478ee"
msgid "Mind if we talk about that later, Rolan?"
msgstr "나중에 이야기하면 안될까, 롤란?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = 6a1d923b-2d90-4baf-91e7-349a3c907280
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:6a1d923b-2d90-4baf-91e7-349a3c907280
msgctxt "h5be733f9g3f41g439cgbb9egfdd4fafbf0fe"
msgid "Same."
msgstr "마찬가지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = 6c2b8b13-aec7-4018-aea8-68a08ae387b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:6c2b8b13-aec7-4018-aea8-68a08ae387b2
msgctxt "hb5f39422g1e45g4c89ga6b2ga9a9943aceb5"
msgid "Really? You seem a little banged up."
msgstr "진짜? 좀 안 좋아 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = 6f67656b-4676-4a10-941b-3188a4bf0d85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:6f67656b-4676-4a10-941b-3188a4bf0d85
msgctxt "hf46adba3gb547g427fg9d5ag7a6d03831d2f"
msgid "Deal."
msgstr "물론."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = 7c162544-927f-76d5-0bba-7994bb5a539d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:7c162544-927f-76d5-0bba-7994bb5a539d
msgctxt "hd4c02d20g8ff1g4f83g8ac4g7e4d0fa9fd53"
msgid ""
"We should have a little party when we reach the city, like we did for mum."
msgstr "도시에 도착하면, 작은 파티를 열어야겠어. 엄마 때처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 8fd3657a-d35d-4f03-b292-c958b905d7fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:8fd3657a-d35d-4f03-b292-c958b905d7fa
msgctxt "he1227dd9gd8acg4068g8848g7e32551173b0"
msgid "And I you."
msgstr "나도 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = 8ff50ba3-9d63-49f7-ae93-21095a5194d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = True
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:8ff50ba3-9d63-49f7-ae93-21095a5194d4
msgctxt "h02bf0429g36f9g458dga4a2g6efba0e56229"
msgid "How are you holding up?"
msgstr "잘 견디고 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 913ed828-282b-6b96-1b94-fa65aee15654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:913ed828-282b-6b96-1b94-fa65aee15654
msgctxt "h9ad3e704ga34fg448ega2f2gabd2a3d5706a"
msgid "I'm perfectly fine."
msgstr "완전 멀쩡해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = 95f82eef-2e4c-4576-bf4b-da174eac7a0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:95f82eef-2e4c-4576-bf4b-da174eac7a0b
msgctxt "h1199aef9gab67g4fd5gb18bgbefe51110b34"
msgid "You look like shit."
msgstr "꼴이 말이 아니네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = 9f7839b4-b1f0-8608-299e-d914339b2082
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:9f7839b4-b1f0-8608-299e-d914339b2082
msgctxt "h7f5e91a8g5737g47f5ga23dgb00a98f8dfc4"
msgid "...Yes, well, this place has been abandoned for some time."
msgstr "....그렇지, 음, 한동안 여긴 아무도 안 왔었거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = b1a3abb0-30b8-4039-90cc-ddeeb0e9501e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:b1a3abb0-30b8-4039-90cc-ddeeb0e9501e
msgctxt "h9e3f05fcgc141g4d23g955ag9fc435bad702"
msgid "How did you even find this place?"
msgstr "도대체 어떻게 여길 찾은 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = be459c80-5aba-9298-775b-b0a80bacbfca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:be459c80-5aba-9298-775b-b0a80bacbfca
msgctxt "he443b0b8gb16bg4bfbg8ba3g2c25ebaf1cc1"
msgid ""
"That 'little party' lasted from sundown to sunrise. Lia would like that."
msgstr "그 \"작은 파티\" 를 해가 떨어질 때부터 뜰 때까지 했었지. 리아도 좋아했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = c2326187-5ebd-4f2c-a136-58ccc8c4ee79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:c2326187-5ebd-4f2c-a136-58ccc8c4ee79
msgctxt "hb5eb71e0g7befg4f32gb576gfafb7e0d7ea4"
msgid ""
"Perfectly fine. The accommodation leaves much to be desired, but it will "
"suffice for now."
msgstr "아주 좋아. 숙소는 아쉬운 부분이 많지만, 지금은 이거면 충분할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = c5a4074c-5451-6e08-fd4b-2cbbe5529717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:c5a4074c-5451-6e08-fd4b-2cbbe5529717
msgctxt "h7288dd91ge202g42dfgba6fga39895bb39a5"
msgid "I'm fine. The bar looks cleared out, anyway."
msgstr "괜찮아. 그건 그렇고, 저 바는 텅 비어 보이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = cde2b2e1-2306-413f-a448-69a88304c682
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:cde2b2e1-2306-413f-a448-69a88304c682
msgctxt "h7807e221ge139g4287gb80eg9c2763b5aeac"
msgid "I'm all right. You?"
msgstr "난 괜찮아. 넌?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = cfb459b8-9cb4-94c2-3bd6-4766000f4bbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:cfb459b8-9cb4-94c2-3bd6-4766000f4bbd
msgctxt "h2fdb8224g8692g4d3ega26bg92f8bdc9a8db"
msgid "Why do you think he plied you with wine in the first place?"
msgstr "애초에 왜 칼이 너에게 자꾸 와인을 권했다 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = d2c30564-9d34-1de1-74aa-00500171ce25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:d2c30564-9d34-1de1-74aa-00500171ce25
msgctxt "h803d3b96gb57cg4b92g8b66g228b7b42ad96"
msgid "Of course, of course! Take all the time you need."
msgstr "그럼, 그럼! 마음 내킬 때 천천히 얘기해도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = d5b3c1e0-502b-448c-9cb6-28410a8571a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:d5b3c1e0-502b-448c-9cb6-28410a8571a1
msgctxt "h84de67c3g94e2g46a4ga8efg98aeb0b62ec6"
msgid "Little of note."
msgstr "별일 없었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = dc39bf55-8d0f-f9cf-2a92-66ba15930af0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:dc39bf55-8d0f-f9cf-2a92-66ba15930af0
msgctxt "h34a72d5bg65b6g4fadg8204gbcfb26c5d888"
msgid "I'm perfectly fine."
msgstr "완전 멀쩡해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = dc3f0ab7-6fb1-8dfe-ac53-68092572c824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:dc3f0ab7-6fb1-8dfe-ac53-68092572c824
msgctxt "h93068109gb34cg40fcga29dg1667ebbaded6"
msgid "He even had a suggestion - 'Cal's Irresistible Charm'."
msgstr "이름 제안까지 했다니까. '칼의 저항할 수 없는 매력'."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = f37d7297-df21-4d7c-a082-4ce8b2e8fc65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:f37d7297-df21-4d7c-a082-4ce8b2e8fc65
msgctxt "ha11257aega4f5g4cfbg846eg671f09fcadbc"
msgid "Are you hurt?"
msgstr "안 다쳤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = f40b2598-9eea-43ec-884d-4ea8cfe0feed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:f40b2598-9eea-43ec-884d-4ea8cfe0feed
msgctxt "hac134ffdgb898g4da9g8fe9g25428c53a787"
msgid "Heh. And I thought I was the mother hen."
msgstr "하. 내가 어미 새 역할인 줄 알았는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = f5518e23-40a8-4013-a6d9-bd84a3b629cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1591cb60-9e65-980a-c49e-69f68b958a1d_B = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 1591cb60-9e65-980a-c49e-69f68b958a1d_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:f5518e23-40a8-4013-a6d9-bd84a3b629cf
msgctxt "hc01c8e3fg8a75g44a4g9b35gae932847aa01"
msgid "What have you been doing since we got separated?"
msgstr "떨어진 다음에 뭘 하고 있었어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Lia
#. NodeID = fa0d421e-b855-45ef-a795-f868389d6fe5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:fa0d421e-b855-45ef-a795-f868389d6fe5
msgctxt "h96261d42g0f98g4cb1g8fdeg57b9be40b46c"
msgid "It could be a lot worse, Rolan - trust us."
msgstr "그나마 나은 거야, 롤란. 우릴 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = fa11bf20-5677-45bc-9efe-1af35d7ba179
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:fa11bf20-5677-45bc-9efe-1af35d7ba179
msgctxt "hd080ac1bg2176g43ddgb54bg34fc0b782bde"
msgid ""
"Never mind that - do you need anything? Something to eat or drink, perhaps?"
msgstr "신경 쓰지 마. 뭐 필요해? 먹고 마실 거?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Cal
#. NodeID = fd46326c-fbf5-4350-afad-2661f99add03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:fd46326c-fbf5-4350-afad-2661f99add03
msgctxt "h4de35fd4g2d11g494eg98e9g641f37579f32"
msgid "We're doing all right. Just... glad to see you."
msgstr "우린 다 잘하고 있잖아. 그냥... 만나서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion
#. Speaker = Rolan
#. NodeID = ff10d61c-2dd6-402d-bfc3-abff85899ad1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AfterReunion:ff10d61c-2dd6-402d-bfc3-abff85899ad1
msgctxt "hfcbe31f8g1a9eg42beg93a2g5b5157e94fdb"
msgid "Thanks."
msgstr "참 고맙다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother
#. Speaker = Cal
#. NodeID = 3a34a50d-b986-4e91-8f4f-62abbc076a14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_C = True
#. SetFlags:
#.   Local:
#.     - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_C = False
#.     - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_A = False
#.     - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother:3a34a50d-b986-4e91-8f4f-62abbc076a14
msgctxt "hd0a4734cg8fc7g4ab5g94d0g658e888df541"
msgid "What am I going to do now?"
msgstr "이젠 뭘 해야 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother
#. Speaker = Cal
#. NodeID = 43483075-f110-4dd6-8bf5-c2cb75f69268
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_B = True
#. SetFlags:
#.   Local:
#.     - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother:43483075-f110-4dd6-8bf5-c2cb75f69268
msgctxt "h34cdc737gdfbdg485dg96eega1d7f553cf6f"
msgid "*Sob.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother
#. Speaker = Cal
#. NodeID = 5e6ac7c6-55e7-7c49-ce09-236476333555
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother:5e6ac7c6-55e7-7c49-ce09-236476333555
msgctxt "heb140f26g75deg409fg80e2g6951a51f8890"
msgid "Gods forgive me."
msgstr "신이시여, 용서해 주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother
#. Speaker = Cal
#. NodeID = 5ff97d12-5cbf-2590-a32b-612adc63897d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother:5ff97d12-5cbf-2590-a32b-612adc63897d
msgctxt "h6f60bdb9g7c9ag4b3bgb707ge4ade2a16624"
msgid "I'm worthless."
msgstr "난 가치가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother
#. Speaker = Cal
#. NodeID = a7e06fee-1457-4821-9a3a-9a8388f60750
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother:a7e06fee-1457-4821-9a3a-9a8388f60750
msgctxt "h1365ffc8g5e37g4fb6g9fdagfedbd4379b97"
msgid "Lia, I'm so sorry."
msgstr "리아, 정말 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother
#. Speaker = Cal
#. NodeID = eb456b9f-a936-1b05-161e-185cb26aa8ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother:eb456b9f-a936-1b05-161e-185cb26aa8ed
msgctxt "he6202d66gf76ag4cd7gb01bgf06031f6c17d"
msgid "Rolan's right - I should have done more, I should have saved you."
msgstr "롤란이 맞았어. 더 잘 해야 했어, 널 구해야 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother
#. Speaker = Cal
#. NodeID = fa80c274-68e0-4e8c-958f-33343bd87f7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_A = True
#. SetFlags:
#.   Local:
#.     - 29ddc96b-303b-373d-2b6f-37ae4e8d534b_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngryBrother:fa80c274-68e0-4e8c-958f-33343bd87f7b
msgctxt "h5b574b41g86fbg4c02ga929g71c83147e208"
msgid "Why wasn't it me?"
msgstr "왜 내가 아니었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = 0a3fc7f9-81fc-ac6b-0702-cd2712e06c8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:0a3fc7f9-81fc-ac6b-0702-cd2712e06c8f
msgctxt "hc009e8d4g6152g4cecg8a0bg156f65358fbc"
msgid "Damn it all."
msgstr "다 꺼지라 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = 0caed55a-0448-3690-ae68-9b1fb2746d53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:0caed55a-0448-3690-ae68-9b1fb2746d53
msgctxt "h13bf1daeg3bf4g4c19gb7e4gf6b52e65c7ef"
msgid "Everything is about him, everything is about his pain. Godsdamit Rolan!"
msgstr "전부 걔 중심으로만 돌아가고, 걔가 아픈 것만 이야기하지. 개같은 롤란!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = 51394ff6-018a-7f7f-f346-94ad0b5bdb88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:51394ff6-018a-7f7f-f346-94ad0b5bdb88
msgctxt "h676394f0gf151g4a03ga88bg4c34904fb4a4"
msgid "I don't owe that arsehole anything."
msgstr "그새끼한테 빚진거 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = 5ea33568-c9af-43b8-8a99-f9af829ac392
