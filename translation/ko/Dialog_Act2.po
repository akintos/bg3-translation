msgctxt "hd973c52agee1cg460cga0f8g818b9f979428"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = 3fcf2611-303d-4ac2-96bc-9674aeee607d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:3fcf2611-303d-4ac2-96bc-9674aeee607d
msgctxt "h672012efg6fdfg40d7gb79egf2d37719216d"
msgid "Only... my... devotion..."
msgstr "오직... 나의... 헌신..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 5f87abc0-9db9-4f2b-a860-b43d6deebbd0
