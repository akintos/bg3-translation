msgctxt "h6054a6d3g22a0g49cdgb7d2ga3dd743fdf92"
msgid "It's you - our little idol thief from the druids' grove!"
msgstr "너구나, 드루이드 숲의 꼬마 우상 도둑!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
