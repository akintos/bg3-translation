msgctxt "h9bc62479gb1f0g460fg8bbcgc226cf663340"
msgid "Gods above, what a forsaken place."
msgstr "신들이시여, 뭐 이런 불모지가 다 있습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_003
