msgctxt "hc6f6a7f9ga82fg4630gb8c1g853520a59ca7"
msgid "Suppose I do?"
msgstr "그렇다면?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ExitBlessingReminder
#. Speaker = GROUP_Act2_HAV_BlessingWarner
#. NodeID = c0617f71-7ecb-e3c9-3920-4d64460e0302
#. HandlePath = TaggedText[0].TagText[0]
