msgctxt "h6476a0c3g5a86g4883g889fg7d7625868ce8"
msgid ""
"*North - Thorm Mausoleum \n"
"South - South Reithwin \n"
"East - Masons' Guild \n"
"West - House of Healing*\n"
msgstr ""
"*북쪽 - 쏨 가문의 영묘 \n"
"남쪽 - 남부 라이스윈 \n"
"동쪽 - 석공 조합 \n"
"서쪽 - 치유의 집*\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_AD_Justiciar
#. Speaker = Narrator
#. NodeID = 09b03682-ec9e-4029-9373-399f1e430e3a
#. HandlePath = TaggedText[0].TagText[0]
