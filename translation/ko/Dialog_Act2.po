#.     - MOO_Assault_FountainGuard_Melee_1_PostAssaultHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:2a0ca112-cebe-f2d5-19cb-a55303d4bf42
msgctxt "hfb16663bg20bfg4b6ag8107ga79073b00259"
msgid "Thought it was over, but Ketheric's not done yet. Finish him."
msgstr "끝난 것 같아 보이지만 아직 케서릭이 살아있어. 가서 끝장을 보고 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
#. NodeID = 3c5bf484-81fc-48f7-aa4a-cf6760e07d57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_FountainGuards_Melee_1_Unprotected_HasMet(1) = True
