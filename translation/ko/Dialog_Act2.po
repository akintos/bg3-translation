#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked:50d0d5df-6961-45cc-9662-55119fa0f362
msgctxt "hee83fb46gc86bg4d37g999fg92731ebb03bf"
msgid "Can't get out! Need to face those guardians first."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked
#. Speaker = Player
#. NodeID = 50d0d5df-6961-45cc-9662-55119fa0f362
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked:50d0d5df-6961-45cc-9662-55119fa0f362
msgctxt "hd0297e56g999fg44f1gb8e6g0e1abf0dbf5c"
msgid "Stuck tight. This battle cannot be avoided."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked
#. Speaker = Player
#. NodeID = 50d0d5df-6961-45cc-9662-55119fa0f362
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked:50d0d5df-6961-45cc-9662-55119fa0f362
msgctxt "h4e608f00gf6e1g4703g9f00gede4d9f0587a"
msgid "Sealed tight."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked
#. Speaker = Player
#. NodeID = 50d0d5df-6961-45cc-9662-55119fa0f362
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked:50d0d5df-6961-45cc-9662-55119fa0f362
msgctxt "h20854ef9gc917g4138g9db9g28c1e45d8989"
msgid "Hmph. Well - it was worth a try."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked
#. Speaker = Player
#. NodeID = 50d0d5df-6961-45cc-9662-55119fa0f362
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked:50d0d5df-6961-45cc-9662-55119fa0f362
msgctxt "h07acacecgec5dg4c77g85a5gfd116a68dd42"
msgid "Stuck. There's no leaving without a fight."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse
#. Speaker = Player
#. NodeID = 514eef0c-6e36-472d-8497-35e6d239ecf8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse:514eef0c-6e36-472d-8497-35e6d239ecf8
msgctxt "hc64d8c3ag3948g42d9g92bbg6dc4ec83dc27"
msgid ""
"Well that does... something. Not that the gibberish scrawled on it is any "
"help. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse
#. Speaker = Player
#. NodeID = 514eef0c-6e36-472d-8497-35e6d239ecf8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse:514eef0c-6e36-472d-8497-35e6d239ecf8
msgctxt "h874d4b29g2201g4f0ag87dag833045da565f"
msgid ""
"Looks like these plaques make for a mechanism of sorts. I sense a secret.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse
#. Speaker = Player
#. NodeID = 514eef0c-6e36-472d-8497-35e6d239ecf8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse:514eef0c-6e36-472d-8497-35e6d239ecf8
msgctxt "hd96dbdd3g9d16g459fgbb37ga8665b8d4e93"
msgid "Hey, I can push these plaques! Hmm..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse
#. Speaker = Player
#. NodeID = 514eef0c-6e36-472d-8497-35e6d239ecf8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse:514eef0c-6e36-472d-8497-35e6d239ecf8
msgctxt "he2cde81eg662eg4c34g97efg14fa66181f13"
msgid "Not just a plaque - a button. Inscribed with nonsense, no less."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse
#. Speaker = Player
#. NodeID = 514eef0c-6e36-472d-8497-35e6d239ecf8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse:514eef0c-6e36-472d-8497-35e6d239ecf8
msgctxt "h5892c232gcf79g4106g8cfdgeadd4903b99b"
msgid "There's some sort of mechanism behind these plaques.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse
#. Speaker = Player
#. NodeID = 514eef0c-6e36-472d-8497-35e6d239ecf8
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse:514eef0c-6e36-472d-8497-35e6d239ecf8
msgctxt "h884b147ag2da4g4472gb9a0g3c392c029764"
msgid "I give it a push, it gives me a click. There's a puzzle afoot."
msgstr "살짝 밀었더니, 딸깍 소리가 나는 군. 숨겨진 퍼즐이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse
#. Speaker = Player
#. NodeID = 514eef0c-6e36-472d-8497-35e6d239ecf8
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_PlaqueFirstUse:514eef0c-6e36-472d-8497-35e6d239ecf8
msgctxt "h06e42610g153ag4925g9454g5aba6dd5453e"
msgid "Was that a click I heard? There's something about these plaques..."
msgstr "방금 딸깍 소리가 들렸어. 여기 명판에 뭔가 있나본데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = 01b699d8-dbbb-3b7f-9efd-becaf68c72be
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = False
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:01b699d8-dbbb-3b7f-9efd-becaf68c72be
msgctxt "h8c72483bg5572g4e67g9afbgb1a668e3f5cc"
msgid ""
"<i>Perhaps you could still win a modicrum of favour here, if you used all "
"your charm and guile.</i>"
msgstr "<i>당신의 매력과 능청을 발휘하기만 한다면, 이곳에서 약간의 호의를 얻을 수 있을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = 274399d9-0152-8a72-b965-dac0855179cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:274399d9-0152-8a72-b965-dac0855179cf
msgctxt "h3490812ag3293g4207gabd8g168bd6d2908d"
msgid ""
"*A faerie chuckle echoes in the corners of your mind. Your patron knows a "
"thing or two about turning people.*"
msgstr "*요정 같은 웃음소리가 마음 한구석에 울려 퍼집니다. 당신의 후원자는 사람을 변화시키는 방법 한두 가지쯤은 알고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = 274399d9-0152-8a72-b965-dac0855179cf
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:274399d9-0152-8a72-b965-dac0855179cf
msgctxt "hc6525b5ag3c78g473cgbc1egde108c5356fe"
msgid ""
"*A fiery cackle echoes in the corners of your mind. Your patron knows a "
"thing or two about turning people.*"
msgstr "*불타는 낄낄거림이 마음 한구석에 울려 퍼집니다. 당신의 후원자는 사람을 변화시키는 방법 한두 가지쯤은 알고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = 274399d9-0152-8a72-b965-dac0855179cf
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:274399d9-0152-8a72-b965-dac0855179cf
msgctxt "hb1e6b8e4g01d9g4e2egb3e2gb6f481dee174"
msgid ""
"*A deep, eldritch hum echoes in the corners of your mind. Your patron knows "
"a thing or two about turning people.*"
msgstr "*깊고, 섬뜩한 웅웅거림이 마음 한구석에 울려 퍼집니다. 당신의 후원자는 사람을 변화시키는 방법 한두 가지쯤은 알고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = 3d502334-0976-4e89-9fe9-db06eb289060
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#. TagRule: CLERIC_SHAR or PALADIN_SHAR or REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:3d502334-0976-4e89-9fe9-db06eb289060
msgctxt "h9448f34dgf65bg4483g8aeeg04eec906c687"
msgid ""
"<i>Nod. With Shar's words on your tongue and teachings in your heart, none "
"can deny you.</i>"
msgstr "<i>끄덕인다. 샤님의 말씀을 혀로 옮기고 마음에 새기면 누구도 당신을 거부할 수 없으리라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = 7e171972-c86f-5213-c81a-9d9a22744f73
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:7e171972-c86f-5213-c81a-9d9a22744f73
msgctxt "hb2b75132g97fag45dbgab53g07ec3a1b446d"
msgid ""
"<i>You no longer bow to Shar, and do not need her blessings. You can take "
"what you wish.</i>"
msgstr "<i>당신은 더 이상 샤에 충성하지 않으며, 축복 또한 필요하지 않습니다. 원하는 게 있다면 가져가면 될 일입니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = 87a8c480-aaaa-43a7-b9cb-0b1a8bccf90c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TWN_CentralSquare_Event_FailedSave(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:87a8c480-aaaa-43a7-b9cb-0b1a8bccf90c
msgctxt "hbbc39fcfgade9g4d08g9469g4dc31a0c0da5"
msgid ""
"*You feel your confidence wilt under the cold stare of the statue. A great "
"weight of self-doubt seems to drag on you.*"
msgstr "*석상의 차가운 시선 아래 자신감이 말라붙습니다. 막대한 회의감이 당신을 무겁게 짓누르는 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = 98174958-7867-33c7-05ad-23e8faf65733
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CentralSquare_State_TrialFailed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:98174958-7867-33c7-05ad-23e8faf65733
msgctxt "h4c507977g20eeg4afcg8a0fg89f500565f61"
msgid ""
"*The statue looms silently. Whatever hidden purpose it has will remain a "
"secret.*"
msgstr "*석상이 고요한 모습으로 솟아 있습니다. 석상이 간직하고 있는 비밀은 앞으로도 비밀로 남을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = 99fd0e7c-e1cf-4b80-88f9-18bb4045ffb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:99fd0e7c-e1cf-4b80-88f9-18bb4045ffb9
msgctxt "hb49cd410gcae8g4ffagb3b9gbfbe4a95cfa7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = aa7a2c9d-5669-227b-85b4-b7afdd98845c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:aa7a2c9d-5669-227b-85b4-b7afdd98845c
msgctxt "h9a310d88ga37fg4624ga287g6adbe16dad24"
msgid "<i>Summon your faith and devotion - letting it flow through you.</i>"
msgstr "<i>믿음과 헌신을 불러내어 당신 안에 흐르게 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = ab761f35-b4c1-4f10-9fe4-06a6c428fd80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - TWN_CentralSquare_HasMet_PlaqueOfCharisma(1) = False
#. SetFlags:
#.   Object:
#.     - TWN_CentralSquare_HasMet_PlaqueOfCharisma(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:ab761f35-b4c1-4f10-9fe4-06a6c428fd80
msgctxt "h4547f78egb08fg4478gbc36g0a35abdbc513"
msgid ""
"*Are you bold of heart and sharp of tongue? Can you turn any and all to the "
"Dark Lady's cause?*"
msgstr "*대담한 마음과 날카로운 혀를 가졌다고 자부합니까? 어둠의 여신의 뜻에 모든 걸 맡길 수 있겠습니까?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = cc056354-2f2b-437f-adea-7e29bdb79ef0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_PlaqueOfCharismaActivated = True
#. TagRule: SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:cc056354-2f2b-437f-adea-7e29bdb79ef0
msgctxt "hacc1eb13gab92g492eg9244g542dcb5cba87"
msgid ""
"*Confidence surges through you. You feel like there is nothing you can't do, "
"no one you can't win over. Even this totem of your former goddess is briefly "
"swayed.*"
msgstr ""
"*자신감이 마구 솟구칩니다. 당신에게 불가능한 일이나 이길 수 없는 적 따윈 없습니다. 한때 당신이 섬겼던 여신의 석상조차 흔들리는 것만 "
"같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = cc056354-2f2b-437f-adea-7e29bdb79ef0
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_PlaqueOfCharismaActivated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:cc056354-2f2b-437f-adea-7e29bdb79ef0
msgctxt "h1d93ecb8g7465g4bcbgac48g36f7c0851c72"
msgid ""
"*Confidence surges through you. You feel like there is nothing you can't do, "
"no one you can't win over. The statue seems to agree - and approve.*"
msgstr ""
"*자신감이 마구 솟구칩니다. 당신에게 불가능한 일이나 이길 수 없는 적 따윈 없습니다. 석상도 동의하는 듯 보입니다. 자격을 "
"입증했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = ccc2a318-fcce-0223-b886-0234c364a589
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:ccc2a318-fcce-0223-b886-0234c364a589
msgctxt "hd564457agfd2bg4965ga697gd3cc4f0ca505"
msgid ""
"*The Nightsinger has turned on you. Surely whatever blessings she offers "
"here are now lost to you... yet no harm in reading on, surely.*"
msgstr ""
"*나이트싱어는 당신에게 등을 돌렸습니다. 이곳에서 찾을 수 있는 은총도 분명 상실되었을 겁니다... 그렇다고 계속 읽지 말란 법은 "
"없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = d3af0fc4-1d6a-1eb7-37cf-477ec0e36e08
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:d3af0fc4-1d6a-1eb7-37cf-477ec0e36e08
msgctxt "h8890b31age3bfg4181gab98gee386f7906d9"
msgid ""
"<i>Allow the tricksy nature of your patron to be glimpsed for but a "
"moment.</i>"
msgstr "<i>후원자의 교활한 본성을 빌려 잠시 동안 드러내 보인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = d3af0fc4-1d6a-1eb7-37cf-477ec0e36e08
#. HandlePath = TaggedText[1].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:d3af0fc4-1d6a-1eb7-37cf-477ec0e36e08
msgctxt "hdb4f1c01g011eg4533g9836gd64c9ee8e0a7"
msgid ""
"<i>Allow the devious machinations of your patron to be glimpsed for but a "
"moment.</i>"
msgstr "<i>후원자의 사악한 계략을 빌려 잠시 동안 드러내 보인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = d3af0fc4-1d6a-1eb7-37cf-477ec0e36e08
#. HandlePath = TaggedText[2].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:d3af0fc4-1d6a-1eb7-37cf-477ec0e36e08
msgctxt "h8f11a364g51cdg4439ga0e7g87c94248e362"
msgid ""
"<i>Allow your patron's ancient, immutable will to be glimpsed for but a "
"moment. </i>"
msgstr "<i>후원자의 유구하고 불변하는 의지를 빌려 잠시 동안 드러내 보인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Player
#. NodeID = da33b549-6f97-4881-9c56-d16be2ec6908
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:da33b549-6f97-4881-9c56-d16be2ec6908
msgctxt "h727e2d58gacb6g423bg89e8gb70900dd141c"
msgid "<i>Smirk. Of course. Need you even say it?</i>"
msgstr "<i>웃는다. 물론이다. 설명할 필요가 있을까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma
#. Speaker = Narrator
#. NodeID = f39c954a-e073-5881-64d0-74ba5be2928f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CentralSquare_State_PlaqueOfCharismaActivated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfCharisma:f39c954a-e073-5881-64d0-74ba5be2928f
msgctxt "hdf379fc3gfa2ag421dg838bg18b20ea2641c"
msgid "*The statue watches serenely. Its challenge has been met.*"
msgstr "*석상의 고요한 눈빛이 느껴집니다. 해당 시험은 충족되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Narrator
#. NodeID = 141cc42e-1630-3e42-82b8-5e7ed1feaf92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CentralSquare_State_TrialFailed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:141cc42e-1630-3e42-82b8-5e7ed1feaf92
msgctxt "h99b53fa2g9db5g4a5bg8113g250b6a27f703"
msgid ""
"*The statue offers you nothing but silence. Whatever secrets it may guard "
"will remain hidden.*"
msgstr "*석상은 침묵할 뿐입니다. 석상이 어떤 비밀을 지키고 있었든 감춰진 채로 있겠지요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Player
#. NodeID = 51a4acaa-8617-4ab2-a765-b09a064677a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#. TagRule: CLERIC_SHAR or PALADIN_SHAR or REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:51a4acaa-8617-4ab2-a765-b09a064677a9
msgctxt "h9d034c1ag3ae1g48efg8d06gdf0f4f35e0df"
msgid ""
"<i>You are Shar's child - there is no reason to shy away. Nod in "
"acceptance.</i>"
msgstr "<i>샤의 아이이므로 부끄러워 할 이유가 없다. 끄덕여 수락한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Player
#. NodeID = 625b8de1-4615-cb93-feaf-35f89bf1d672
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:625b8de1-4615-cb93-feaf-35f89bf1d672
msgctxt "h4c9af3b0g3b98g4564gb836g51d030ffbb90"
msgid ""
"<i>Let your faith and devotion guide you - if you are meant to pass this "
"test, you will.</i>"
msgstr "<i>신앙과 헌신이 안내하도록 한다. 만약 이 시험을 통과하기로 정하셨다면, 그리 되리라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Narrator
#. NodeID = 8e4ec583-d20f-4669-8681-38f17d9c603a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TWN_CentralSquare_Event_FailedSave(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:8e4ec583-d20f-4669-8681-38f17d9c603a
msgctxt "h8e252283g27f0g4f78gbd18g66f9598c3118"
msgid ""
"*Your insides seem to churn uneasily. You feel strangely rejected. Strangely "
"<i>unwelcome</i>.*"
msgstr "*당신의 내면은 휘저어놓기 어려운 모양입니다. 거부하는 이상한 느낌이 옵니다. <i>반갑지 않은 듯한</i> 이상한 느낌도요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Narrator
#. NodeID = beae9ffc-099d-ce4f-43ee-4a54480300c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:beae9ffc-099d-ce4f-43ee-4a54480300c0
msgctxt "h664af4bagcb7ag408bga286ge1b20c833e7d"
msgid ""
"*Lady Shar has exiled you. It would be foolish to think you could enjoy any "
"favours found here, surely... yet what do you have to lose from reading on?*"
msgstr ""
"*샤 여신께서는 당신을 추방했습니다. 당신이 여기서 호의를 찾아내 누릴 수 있다니 멍청한 생각이겠지요, 확실히...하지만 읽는다고 손해 "
"볼 건 없지 않을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Player
#. NodeID = bf519d21-504d-49e2-9394-65d7b1d02cc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:bf519d21-504d-49e2-9394-65d7b1d02cc1
msgctxt "h3fa1d81cgb31eg4491gbe15g5b691b03fde1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Player
#. NodeID = c5349d4b-d5df-d48c-5750-60ad37b2e9e3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:c5349d4b-d5df-d48c-5750-60ad37b2e9e3
msgctxt "hcc7e4f4ag56eeg46fdg8a40g2842acd128f0"
msgid ""
"<i>You are clear-headed regarding Shar: she is you foe now. Yet you are not "
"above taking her power.</i>"
msgstr "<i>샤에 대해 생각해 본다. 이제 샤는 적이다. 그러나 샤의 힘은 못 받을 것도 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Narrator
#. NodeID = c8dfa8cf-0166-4586-b869-af0ec9b3d8d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - TWN_CentralSquare_HasMet_PlaqueOfIntelligence(1) = False
#. SetFlags:
#.   Object:
#.     - TWN_CentralSquare_HasMet_PlaqueOfIntelligence(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:c8dfa8cf-0166-4586-b869-af0ec9b3d8d0
msgctxt "h9a070b26g9b3cg447ag8b5dg41bac67f3b5e"
msgid "*Do you accept Shar's test of your intellect?*"
msgstr "*당신의 지성에 대한 샤의 시험을 수락하시겠습니까?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Player
#. NodeID = d27699bd-f4e8-40d9-9846-bb2c70dac918
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:d27699bd-f4e8-40d9-9846-bb2c70dac918
msgctxt "h3ceb8d76g95e7g4096gb157g250418402b54"
msgid "<i>Nod in acceptance. An untested mind is a dull mind.</i>"
msgstr "<i>끄덕여 수락한다. 시험하지 않는 마음은 고루한 마음이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Narrator
#. NodeID = e05022c1-4b8a-4059-99c4-728d8c16c5e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_PlaqueOfIntelligenceActivated = True
#. TagRule: SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:e05022c1-4b8a-4059-99c4-728d8c16c5e9
msgctxt "h05250579g3ae4g4bf7g99e2g47f704f43960"
msgid ""
"*You feel a small pulse of energy race up your spine. Though out of favour "
"in this place, your intellect has won you something.*"
msgstr ""
"*당신은 등줄기를 타고 올라오는 작은 에너지 흐름을 느낍니다. 여기서 당신은 환영받지 못하지만, 당신의 지성은 무언가 얻어냈습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Narrator
#. NodeID = e05022c1-4b8a-4059-99c4-728d8c16c5e9
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_PlaqueOfIntelligenceActivated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:e05022c1-4b8a-4059-99c4-728d8c16c5e9
msgctxt "hc9eba2dcg759cg4fb4g8d6fg2a1c1d46dc5c"
msgid ""
"*You feel a small pulse of energy race up your spine. And a strange "
"sensation of <i>acceptance</i>.*"
msgstr "*당신은 등줄기를 타고 올라오는 작은 에너지 흐름을 느낍니다. 그리고 <i>수락</i>하는 듯한 이상한 감각을 체험합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Player
#. NodeID = e43dcbf9-7029-1910-085c-134b94bd5d11
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = False
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:e43dcbf9-7029-1910-085c-134b94bd5d11
msgctxt "he5c87f46gdef3g48b8g8b7fgcfdd89b88743"
msgid ""
"<i>Surely if there is any way to repair your relationship with Lady Shar, "
"your mind is up to the task.</i>"
msgstr "<i>샤 여신님과의 관계를 되돌릴 어떤 방법이 있다면, 수행할 각오가 되어 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence
#. Speaker = Narrator
#. NodeID = ecdebcc2-36d5-ea91-bde8-7bef57a488f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CentralSquare_State_PlaqueOfIntelligenceActivated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfIntelligence:ecdebcc2-36d5-ea91-bde8-7bef57a488f7
msgctxt "h48c4688eg2c7eg448dga247g2cc4efb8f5d3"
msgid ""
"*It seems this statue has nothing to offer. Its challenge has been "
"surmounted.*"
msgstr "*이 석상은 내줄 것이 없어 보입니다. 석상의 시험을 극복했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Player
#. NodeID = 0378fb83-ecfd-3a7e-836e-0b0cd1e9a496
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#. TagRule: CLERIC_SHAR or PALADIN_SHAR or REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:0378fb83-ecfd-3a7e-836e-0b0cd1e9a496
msgctxt "h9e90208cg0789g442dgb056g072e9b943ca8"
msgid ""
"<i>Bow your head modestly. You are wise if Shar deems so. Ignorant if she "
"deems so.</i>"
msgstr "<i>겸허히 고개를 숙인다. 샤께서 현명하다 여기신다면 현명한 것이며, 무지하다 여기신다면 무지한 것이니.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Narrator
#. NodeID = 1d31bf10-5ef3-d59f-217c-2fb1f96a6f39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:1d31bf10-5ef3-d59f-217c-2fb1f96a6f39
msgctxt "h88e48a74gdf6eg4459gbb39g686a6a1b917a"
msgid ""
"*The Lady of Loss has abandoned you. Whatever boon found here is no longer "
"for you, surely... yet what harm in reading on?*"
msgstr ""
"*상실의 여인은 당신에게 등을 돌렸습니다. 이곳에서 구할 수 있는 은총이 무엇이든 더 이상 도움이 되진 않겠지만... 읽어 보는 것쯤은 "
"괜찮지 않을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Player
#. NodeID = 47ddc306-86cd-ca34-c947-e096a4badfa1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = False
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:47ddc306-86cd-ca34-c947-e096a4badfa1
msgctxt "h12f9e862g189ag4713gb14dg05dcaa4ea229"
msgid ""
"<i>Show wisdom through understanding of how you have angered Lady Shar - "
"that it cannot be undone.</i>"
msgstr "<i>당신의 행동으로 말미암아 샤께서 진노하셨다. 이를 되돌릴 수 없다는 사실을 이해함으로써 지혜를 발휘한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Narrator
#. NodeID = 4c2bef59-3ae1-254a-22d8-007f5cf0fb5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CentralSquare_State_PlaqueOfWisdomActivated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:4c2bef59-3ae1-254a-22d8-007f5cf0fb5f
msgctxt "h83a15007gf5c8g4e32g8f36g665d67a07a46"
msgid "*The statue gazes at you impassively. Its challenge has been met.*"
msgstr "*석상이 당신을 무심히 바라봅니다. 해당 시험은 이미 충족되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Narrator
#. NodeID = 857c453f-abbd-85cb-827c-092186d14ef1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TWN_CentralSquare_Event_FailedSave(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:857c453f-abbd-85cb-827c-092186d14ef1
msgctxt "hf93a6ce8g75b5g440cg8806gc21a644b9847"
msgid ""
"*The air seems to chill around you. Your claims of wisdom are rebuffed.*"
msgstr "*주변의 공기가 차가워지는 듯합니다. 당신의 지혜를 입증하지 못한 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Player
#. NodeID = 901554db-fb93-cac6-a6fd-9210574fd2b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:901554db-fb93-cac6-a6fd-9210574fd2b7
msgctxt "hce179808g1ad8g4bccg80b9gf03295c04b8b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Narrator
#. NodeID = 923b0f4d-baee-c048-5016-50c4c36490a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - TWN_CentralSquare_HasMet_PlaqueOfWisdom(1) = False
#. SetFlags:
#.   Object:
#.     - TWN_CentralSquare_HasMet_PlaqueOfWisdom(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:923b0f4d-baee-c048-5016-50c4c36490a6
msgctxt "hbed3c66fg722cg48a5gb230g233a22364ab4"
msgid "*Do you think yourself wise enough to be granted Shar's blessing?*"
msgstr "*그대에게 샤의 축복이 내려질 만큼 현명하다고 생각합니까?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Narrator
#. NodeID = 9f4c52ea-2449-cc4c-9645-48002be62108
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CentralSquare_State_TrialFailed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:9f4c52ea-2449-cc4c-9645-48002be62108
msgctxt "hff6803c5g02c9g4128g9115gca8ea92564e0"
msgid ""
"*The statue offers a mute stare, and nothing more. Any secret it guards will "
"remain secret.*"
msgstr "*석상은 말없이 응시할 따름입니다. 석상이 간직하고 있는 비밀은 앞으로도 비밀로 남을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Narrator
#. NodeID = a66abe26-5388-fcd0-2558-a7d952df95a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_PlaqueOfWisdomActivated = True
#. TagRule: SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:a66abe26-5388-fcd0-2558-a7d952df95a1
msgctxt "ha49bb331g54fag4d09g8e2bg8bdc8ffb64f2"
msgid ""
"*The strength of your conviction seems to confuse the statue. Incredibly, "
"you are deemed worthy.*"
msgstr "*당신의 확고한 신념으로 인해 석상이 혼란을 겪는 듯합니다. 놀랍게도, 당신은 합당하다고 판단됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Narrator
#. NodeID = a66abe26-5388-fcd0-2558-a7d952df95a1
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_PlaqueOfWisdomActivated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:a66abe26-5388-fcd0-2558-a7d952df95a1
msgctxt "h1d31674ag8acbg4cf7g9870gfcd3222fa42a"
msgid "*A warm swell rises through you. Acceptance - you are worthy.*"
msgstr "*마음 한 켠이 따뜻하게 부풀어오릅니다. '수긍하노라. 과연 자격 있는 자로다.'*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Player
#. NodeID = b2f39398-1e90-cbcd-17bc-5fef897cc4a0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:b2f39398-1e90-cbcd-17bc-5fef897cc4a0
msgctxt "h0695bb72g9ab8g46bbgb19eg61dcdd184d3f"
msgid ""
"<i>Nod. You feel like a veritable sage, after all you've experience of "
"late.</i>"
msgstr "<i>끄덕인다. 최근에 겪은 모든 일을 생각하면, 정말로 현자가 된 것 같은 기분이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Player
#. NodeID = b4604b00-7c1a-8dc2-0fd7-696966711249
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:b4604b00-7c1a-8dc2-0fd7-696966711249
msgctxt "hbfd408d3g85d8g4fd3g8fedg8d011797bf14"
msgid "<i>Nod. Your life is richer, wiser, with your god on your side.</i>"
msgstr "<i>끄덕인다. 당신의 삶은 당신의 신과 함께할 때 비로소 풍요롭고 현명해질 수 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom
#. Speaker = Player
#. NodeID = e5745cec-35b9-8d5c-bcd8-95fbd2658e90
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - CAMP_Shadowheart_State_HadNightsongMeeting = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PlaqueOfWisdom:e5745cec-35b9-8d5c-bcd8-95fbd2658e90
msgctxt "hf745f7ccgf83ag462ag97f3g77ccd8ce9771"
msgid ""
"<i>You are wise enough to recognise Shar as a capricious, lying tyrant, "
"yes.</i>"
msgstr "<i>물론. 당신은 샤가 거짓투성이 폭군이라는 사실을 깨달을 만큼 현명하다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_Plaque_001_AD
#. Speaker = Plaque
#. NodeID = 35eb9f10-a92d-de8d-07f4-361333d3cb9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_Plaque_001_AD:35eb9f10-a92d-de8d-07f4-361333d3cb9f
msgctxt "hd518a942g5964g4f7eg9497g2dd243dab44c"
msgid ""
"F - L O S S \n"
"- P A I N \n"
"A L L S \n"
"L - R I S E"
msgstr ""
"의 - 여 인\n"
"- 이 시 여\n"
"올 - 때 에\n"
"일 어 난 다"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_Plaque_002_AD
#. Speaker = Plaque
#. NodeID = 195d5910-0036-41d6-8650-ec38aaa9e9da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_Plaque_002_AD:195d5910-0036-41d6-8650-ec38aaa9e9da
