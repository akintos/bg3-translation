msgctxt "hd6d7aad1g4093g4ff5gbdedg36a3327296ac"
msgid "It's me, Arabella."
msgstr "저에요. 아라벨라요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_AD_Arabella
