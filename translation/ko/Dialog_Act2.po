msgctxt "h84632fd6ga136g414eg8520gb7ede76e69da"
msgid "I have <i>a </i>lyre. It used to belong to a drow."
msgstr "리라 <i>하나 </i>갖고 있긴 한데. 드로우가 갖고 있던 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
