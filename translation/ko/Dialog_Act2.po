msgctxt "h6a7a0048g39efg4286g89c4gd7c4830de7e9"
msgid "Curious little thing. I respect its pluck."
msgstr "흥미로운 녀석이야. 그 용기만큼은 가상하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Narrator
#. NodeID = 9ac82e1c-7f61-c3d0-5e6d-4317877d20ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:9ac82e1c-7f61-c3d0-5e6d-4317877d20ac
msgctxt "hac4ac550g36f5g4ebeg8522g40b3606f97ce"
msgid "*You fail to glean anything. It's just a rat.*"
msgstr "*아무것도 알아내지 못합니다. 그냥 쥐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Shadowheart
#. NodeID = a3aab041-0217-4a97-a173-295e8715add5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
