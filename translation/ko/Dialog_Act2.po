#. NodeID = e3564bd0-2c11-4f6b-8d34-08579b31f01d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinRanger_Dead:e3564bd0-2c11-4f6b-8d34-08579b31f01d
msgctxt "hfdb2f313g3e9bg4b48ga89cgaa3fcf5ef76c"
msgid "Wait for drider... take prisoners..."
msgstr "드라이더를 기다렸다... 죄수들을 호송한다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinRanger_Dead
#. Speaker = Narrator
#. NodeID = e8533705-c0f5-4270-8e6d-3e4f96a7191f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinRanger_Dead:e8533705-c0f5-4270-8e6d-3e4f96a7191f
msgctxt "h70e37c70g675fg4669ga529gd099059acdb2"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinRanger_Dead
#. Speaker = Sharp-Eye Lora
#. NodeID = fb8948c1-7785-43de-8403-f402d0d41820
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinRanger_Dead:fb8948c1-7785-43de-8403-f402d0d41820
msgctxt "h5e39e2e9g27d4g4e03g9a84g0d15d93ad150"
msgid "Absolute..."
msgstr "절대자..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinRanger_Dead
#. Speaker = Narrator
#. NodeID = fc3d4c5d-4d70-47fe-adb5-ad73316f3f30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_GoblinRanger_Dead:fc3d4c5d-4d70-47fe-adb5-ad73316f3f30
msgctxt "h6b298c5cg8314g4329ga1f5gf0f9605214b3"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_AD_DriderDies
#. Speaker = Kansif
#. NodeID = e7547091-9580-8be2-c9ed-9d50f459a012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_AD_DriderDies:e7547091-9580-8be2-c9ed-9d50f459a012
msgctxt "h5fcad614g2879g4de3gb0b2g8b77d2db8513"
msgid "Our guide is dead - and so are we if they take the lantern!"
msgstr "안내자가 죽었어. 놈들이 등불을 가져가 버리면 우리도 그렇게 되겠지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Player
#. NodeID = 04a57057-bb21-0ad0-88f8-c5d7a2169a49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Knows_CreaturePath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:04a57057-bb21-0ad0-88f8-c5d7a2169a49
msgctxt "h58af96e7g034bg4719g8818g7d390d635e52"
msgid "Minthara sent me. She said you'd get me to Moonrise."
msgstr "민타라가 보냈다. 네가 날 문라이즈로 안내해 줄 거라던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = 12afd6a5-b522-4dc6-514d-ba014b614cbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:12afd6a5-b522-4dc6-514d-ba014b614cbf
msgctxt "hf5170d6bgfaf3g45b8ga41egd32ee2e1267c"
msgid "Hold there! One step closer and -"
msgstr "멈춰라! 한 발짝만 더 오면 그땐 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = 2df01274-2c28-ce42-8b1e-38186638d0aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_GainedAccessToCaravanCampFromDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:2df01274-2c28-ce42-8b1e-38186638d0aa
msgctxt "h508e5176gab96g4655gbdc5gb3ba19304d35"
msgid "Of course, we've been waiting. Speak to me when you're ready to depart."
msgstr "물론입니다. 기다리고 있었습니다. 출발할 준비가 되면 저한테 말씀하십쇼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Player
#. NodeID = 42e59858-6560-c401-c2b3-a21ece49d688
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:42e59858-6560-c401-c2b3-a21ece49d688
msgctxt "h66033aa4gd78cg40a5gb059gac3d8c77ffb4"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = 7a52dbb7-7e2b-5044-3ccd-cb36f4457c1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_Knows_CreaturePath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:7a52dbb7-7e2b-5044-3ccd-cb36f4457c1f
msgctxt "hdb7a688agd356g4958gb312gc37698776529"
msgid "We were forewarned - told to wait for someone like you."
msgstr "미리 언질을 받았죠. 당신같은 사람이 올 거라고 했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = 7a7de508-2870-a4db-f2bf-1efc5cb437a4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_GainedAccessToCaravanCampFromDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:7a7de508-2870-a4db-f2bf-1efc5cb437a4
msgctxt "hb9cc1762g339bg4b63ga099g0c8ac433cc1e"
msgid ""
"Speak to me if you want to get moving. Until then, welcome to the most "
"cursed place in Faerûn."
msgstr "떠나고 싶다면 저한테 말씀하십쇼. 아무튼, 페이룬 최악의 저주가 내린 땅에 오신 걸 환영합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = 972471cb-4559-1411-8bb3-a64a6ba8f1ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:972471cb-4559-1411-8bb3-a64a6ba8f1ed
msgctxt "h0fbd5b7egc468g4346gaba0g62001d4dd249"
msgid ""
"You have the look. You come to recognise it if you spend enough time around "
"the Absolute's lieutenants."
msgstr "그렇게 보입니다. 절대자님의 부관들과 가까이에서 오래 지내다보면 어느새 자연스레 알아보게 되죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = a0132c74-2fd0-0b63-f1e9-0e703b8bbb56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:a0132c74-2fd0-0b63-f1e9-0e703b8bbb56
msgctxt "h311fde93gc268g4a1fgb39dg7ec34452d514"
msgid "If it was the Absolute's will."
msgstr "그것이 절대자님의 뜻이라면야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = b4bc806f-5cf0-681e-e1fc-afdd2245e3f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:b4bc806f-5cf0-681e-e1fc-afdd2245e3f0
msgctxt "h7f09c875ga04cg4cc6gae7ag247372dc81cd"
msgid ""
"But you had best wait until we get to Moonrise. Otherwise you might be "
"missing a guide through the darkness."
msgstr "문라이즈에 도착할 때까지만이라도 기다려 주십쇼. 어둠을 뚫고 길을 인도할 안내자는 있어야 하지 않겠습니까. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = b591b7db-7ddb-8e17-4cda-5d743ca95b2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:b591b7db-7ddb-8e17-4cda-5d743ca95b2a
msgctxt "h284be3dcg0830g4a3dg83e9g8c90ed99499b"
msgid "True Soul - forgive me, I did not see you in the dark."
msgstr "참된 영혼이시군요. 죄송합니다. 어두워서 잘 보이지 않았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = ced33a9b-fff8-329b-e252-60227a58946a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:ced33a9b-fff8-329b-e252-60227a58946a
msgctxt "hea45dc17g1258g44afg9eaag8eb7412f4ea7"
msgid "Besides, I cannot think who else would be walking these shadows."
msgstr "게다가, 이 그림자 속을 활보하는 이가 달리 또 누가 있겠습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = dc889a64-394b-6dd4-11ec-f5237cffc125
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_EntryPoint_Event_GainedAccessToCaravanCampFromDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:dc889a64-394b-6dd4-11ec-f5237cffc125
msgctxt "h21428c35g04bdg4e5ag9e93g05c9f5e3db33"
msgid ""
"Speak to me if you are ready to leave. Until then - welcome to the shadow "
"curse."
msgstr "떠날 준비가 되면 저한테 말씀하십쇼. 아무튼, 그림자 저주의 땅에 오신 걸 환영합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Kansif
#. NodeID = e0bfcc8c-c2d5-eb28-173b-9d793d9d7cea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:e0bfcc8c-c2d5-eb28-173b-9d793d9d7cea
msgctxt "ha99761d1g0e09g44dbg9d22g2b42100fa08e"
msgid "What - you'll die for this, traitor!"
msgstr "무슨 - 죽음을 자초하는구나, 이 배신자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Player
#. NodeID = e4f04b72-d768-c349-b11a-ce0e76a8c226
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:e4f04b72-d768-c349-b11a-ce0e76a8c226
msgctxt "ha74141b3g2075g43dcga41bga2aaff0888e4"
msgid "I could kill you for speaking to me like that."
msgstr "널 죽여버릴 수도 있어. 감히 그딴 식으로 말하다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint
#. Speaker = Player
#. NodeID = eb3326dc-ce72-fdc4-1535-fce3a4ea35d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_DriderCaravan_HalfOrcCaster_Checkpoint:eb3326dc-ce72-fdc4-1535-fce3a4ea35d6
msgctxt "hc7c890f8g4d05g4f52g8ac8g5df2b79d90fd"
msgid "How did you know I was a True Soul?"
msgstr "내가 참된 영혼이라는 걸 어떻게 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterAmbush
#. Speaker = Kar'niss
#. NodeID = 3402f542-bc5a-4e30-b6f9-dec1f32b4c6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterAmbush:3402f542-bc5a-4e30-b6f9-dec1f32b4c6a
msgctxt "hb39ace37g8c5cg4ac2g88b4g3245bd9ad385"
msgid ""
"Shadows and heretics, Majesty. But they won't stop us. They can't stop us."
msgstr "그림자와 이단자들입니다, 폐하. 하지만 우릴 막지 않을 겁니다. 우릴 막을 수 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterTollhouse
#. Speaker = Kansif
#. NodeID = 2e5977ca-1faf-ee27-15a9-046b0d88317c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterTollhouse:2e5977ca-1faf-ee27-15a9-046b0d88317c
msgctxt "h5bd1d469g889bg418cg8dadg214f08fb11e4"
msgid "My blade is. But that can change - just keep talking."
msgstr "칼은 깨끗하지. 하지만 더러워질 수도 있어. 계속 나불대봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterTollhouse
#. Speaker = Brawler Vez
#. NodeID = 7863b27b-4d1a-4e8f-942b-6dc1c02ebaaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterTollhouse:7863b27b-4d1a-4e8f-942b-6dc1c02ebaaf
msgctxt "he8452b45ga27fg405eg9e9dg3e88d860e05c"
msgid "There's the tower now, big lad. Your breeches still clean?"
msgstr "드디어 저기 타워가 보이네, 덩치 큰 형씨. 바지는 아직 깨끗해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterTollhouse
#. Speaker = Kar'niss
#. NodeID = deb39a2e-ca65-4bf2-a069-1b5c89140126
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AfterTollhouse:deb39a2e-ca65-4bf2-a069-1b5c89140126
msgctxt "h23a0e8e6gf3dfg4963g8baegf3367e68445c"
msgid "They will be <i>silent!</i> They approach your sanctuary, Majesty."
msgstr "다들 <i>조용히</i> 할지어다! 저희가 당신의 성역으로 향하고 있습니다, 폐하."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AllHarpersWaitingAtAmbush
#. Speaker = Harper Lassandra
#. NodeID = 7e08f1f7-32d6-4920-8983-9c1b56c483d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AllHarpersWaitingAtAmbush:7e08f1f7-32d6-4920-8983-9c1b56c483d5
msgctxt "h423898c5gbfb7g44a8gbef5g709aeed1c9f6"
msgid "More than ready."
msgstr "준비 됐고 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AllHarpersWaitingAtAmbush
#. Speaker = Harper Elindale
#. NodeID = 85e1a16c-39ed-413a-8c00-29bff34a086f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AllHarpersWaitingAtAmbush:85e1a16c-39ed-413a-8c00-29bff34a086f
msgctxt "hfd131bb2g8a4eg4668g9cd5g5e194bc45494"
msgid "I see something - they're coming!"
msgstr "뭔가 보여. 놈들이 온다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AllHarpersWaitingAtAmbush
#. Speaker = Harper Branthos
#. NodeID = eec2129e-9087-432d-900e-fb83f5f8b987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_AllHarpersWaitingAtAmbush:eec2129e-9087-432d-900e-fb83f5f8b987
msgctxt "h94d34a9cgcc09g4279g8203g2a1689aaf2f1"
msgid "All right. You ready for this?"
msgstr "좋아. 준비됐어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_ArriveToTollHouse
#. Speaker = Kar'niss
#. NodeID = 12cf5685-b0df-d9b1-3869-59a130136004
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_ArriveToTollHouse:12cf5685-b0df-d9b1-3869-59a130136004
msgctxt "h1f185b0eg55a9g4865gb3a0g2d49505f48bf"
msgid "Do not stray from the light, no matter what they promise you."
msgstr "등불에서 벗어나지 마십시오, 그들이 무얼 속삭이든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_ArriveToTollHouse
#. Speaker = Kar'niss
#. NodeID = c39ee2ca-a07d-3c17-1fbb-31a5453a9c64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_ArriveToTollHouse:c39ee2ca-a07d-3c17-1fbb-31a5453a9c64
msgctxt "h32e7c26fg69f8g4794g8715gdf793bfc4384"
msgid "Stay close. The shadows are darkest here - hungriest here."
msgstr "가까이 계십시오. 여기선 그림자가 칠흑과도 같습니다. 가장 굶주려 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_BeforeAmbush
#. Speaker = Sharp-Eye Lora
#. NodeID = 947fa8f1-248e-8bd7-9a01-07b078e935bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_BeforeAmbush:947fa8f1-248e-8bd7-9a01-07b078e935bd
msgctxt "h6ad21158g7eaeg4aabg803bgc2c07b671156"
msgid "Ain't all got ten legs!"
msgstr "모두 다리가 열 개는 아니라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_BeforeAmbush
#. Speaker = Kar'niss
#. NodeID = c3bbcb7c-4b9f-c73b-7482-a40b5e18306d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_BeforeAmbush:c3bbcb7c-4b9f-c73b-7482-a40b5e18306d
msgctxt "h46871855gd53fg4799g8d39gaf037ea82a1d"
msgid "...Patience, Majesty. You bless us with patience."
msgstr "...인내하소서, 폐하. 인내심으로 축복하소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_BeforeAmbush
#. Speaker = Kar'niss
#. NodeID = d209b9a0-cc5a-5a80-5ca7-3d0603323a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_BeforeAmbush:d209b9a0-cc5a-5a80-5ca7-3d0603323a56
msgctxt "hf79bf0fdg4190g4e1bgbad1gef9104badffc"
msgid "They must keep up. The shadows are hungry."
msgstr "다들 보조를 맞춰야 해. 그림자들이 굶주려 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_CaravanConflict
#. Speaker = Brawler Vez
#. NodeID = 944519ac-db80-7198-1b25-63bfe68afbdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_CaravanConflict:944519ac-db80-7198-1b25-63bfe68afbdc
msgctxt "h3e4c87edg87a3g4d8cgadafg2adfc310fc73"
msgid "You look twitchy, stone-skin. Afraid of the dark?"
msgstr "너 좀 불안해 보이는데, 바위 피부. 어둠이 무서워?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_CaravanConflict
#. Speaker = Kansif
#. NodeID = dcd37565-b0bc-e1cc-15ac-a16109d71b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_CaravanConflict:dcd37565-b0bc-e1cc-15ac-a16109d71b9c
msgctxt "hb6b96445g6f41g49b6ga7b9gc26391d5a1bf"
msgid "In this place? Only a fool wouldn't be."
msgstr "이런 지역에서? 안 무서워 하는 건 바보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_CombatStarts
#. Speaker = Kar'niss
#. NodeID = 6a534b49-3dc9-b502-52a5-a01eb5492f0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_CombatStarts:6a534b49-3dc9-b502-52a5-a01eb5492f0f
msgctxt "h6c66fba3gbd00g4eb6g8de1g0b7c933b5983"
msgid "Drive them into the dark! Do not let them take our light!"
msgstr "어둠 속으로 모두 몰아넣어라! 우리의 빛을 빼앗길 순 없다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_DroppedLantern
#. Speaker = Kar'niss
#. NodeID = c947f738-bc1f-45e3-a52c-219ea03ca39d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_DroppedLantern:c947f738-bc1f-45e3-a52c-219ea03ca39d
msgctxt "hd23d75e9g2e52g46d7gadd3g1d49f77070d1"
msgid "No! The lantern!"
msgstr "안돼! 등불이!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted
#. Speaker = Kar'niss
#. NodeID = 3b046f47-5c3e-4be1-8ae7-12b72a151239
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c7cbc714-5e48-c78a-0867-2ce81a42d681_A = True
#. SetFlags:
#.   Local:
#.     - c7cbc714-5e48-c78a-0867-2ce81a42d681_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted:3b046f47-5c3e-4be1-8ae7-12b72a151239
msgctxt "h13f8c83fg0182g493fgbacfg3ed43a5f7fde"
msgid "Return to the light! Do not stray!"
msgstr "등불 곁으로 돌아와! 벗어나지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted
#. Speaker = Kar'niss
#. NodeID = 82c54f1a-59ab-4e7e-8083-273f6a209ec4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c7cbc714-5e48-c78a-0867-2ce81a42d681_B = True
#. SetFlags:
#.   Local:
#.     - c7cbc714-5e48-c78a-0867-2ce81a42d681_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted:82c54f1a-59ab-4e7e-8083-273f6a209ec4
msgctxt "h06387dbag56b9g4ae8g9a90g847448f2c2d3"
msgid "Do the fools want to die in the dark, Majesty?"
msgstr "저 바보들이 어둠 속에서 죽고 싶을까요, 폐하?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted
#. Speaker = Kar'niss
#. NodeID = b88d19a7-6d30-4765-8e52-1d39e60d8589
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c7cbc714-5e48-c78a-0867-2ce81a42d681_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted:b88d19a7-6d30-4765-8e52-1d39e60d8589
msgctxt "he4a89ec3gc3b4g45d7g811dge4edf360e075"
msgid "Come back! They must stay in the light, Majesty."
msgstr "돌아와! 그들은 등불 곁에 머물러야 합니다, 폐하."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted
#. Speaker = Kar'niss
#. NodeID = cb28a109-8edc-46e9-a535-e8a10ea0a0c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c7cbc714-5e48-c78a-0867-2ce81a42d681_C = True
#. SetFlags:
#.   Local:
#.     - c7cbc714-5e48-c78a-0867-2ce81a42d681_B = False
#.     - c7cbc714-5e48-c78a-0867-2ce81a42d681_A = False
#.     - c7cbc714-5e48-c78a-0867-2ce81a42d681_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_EscortInterrupted:cb28a109-8edc-46e9-a535-e8a10ea0a0c2
msgctxt "hc1199f6dg272eg430ag8c8dgf516735c5066"
msgid "They leave us again? Very well, my queen - we will wait."
msgstr "그들이 또다시 떠납니까? 알겠습니다, 여왕님. 저희가 기다리겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarperTakesMoonlantern
#. Speaker = Kar'niss
#. NodeID = f790c954-23e2-4f0b-a47d-97c371a1fb37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarperTakesMoonlantern:f790c954-23e2-4f0b-a47d-97c371a1fb37
msgctxt "h0a0249beg852eg4dacga6b0ge9e28e59b21c"
msgid "The heretics hold the lantern - take it back!"
msgstr "이단자가 등불을 들었다! 되찾아와!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarperWaitingAtAmbush
#. Speaker = GROUP_Act2_SCL_HarpersAmbush
#. NodeID = 9bf2fba6-f41b-f8ab-11f9-5474df59d01b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarperWaitingAtAmbush:9bf2fba6-f41b-f8ab-11f9-5474df59d01b
msgctxt "h63b58251g8e0ag4a17gb4fegcc4d616e0e0a"
msgid "It's close. Ready yourself."
msgstr "다가온다. 준비해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harper_Caster_000
#. Speaker = Harper Elindale
#. NodeID = 6c8ca38a-0b68-4803-ac4b-25ef1df228c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harper_Caster_000:6c8ca38a-0b68-4803-ac4b-25ef1df228c9
msgctxt "h414f3fd0g3738g4946gbdc4g5b5742a1d197"
msgid "Guard against the darkness."
msgstr "어둠 속으로 들어가지 않도록 조심해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harper_Melee_000
#. Speaker = Harper Branthos
#. NodeID = 5579c533-7ceb-4b26-a048-6a814c01fbdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harper_Melee_000:5579c533-7ceb-4b26-a048-6a814c01fbdf
msgctxt "h7ad7faa9g0a63g44b8g8e42g47cd8a8b6bd6"
msgid "I fear neither shadow nor death."
msgstr "나는 그림자도, 죽음도 두렵지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harper_Ranger_000
#. Speaker = Harper Manus
#. NodeID = 3782152b-8d61-41fc-b843-64e8a1f37196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harper_Ranger_000:3782152b-8d61-41fc-b843-64e8a1f37196
msgctxt "h0f670e4cged80g495eg9746ged6fec01d206"
msgid "No god can protect you."
msgstr "그 어떤 신이라도 네놈을 지킬 수는 없을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 0df4914e-4824-48ee-b202-a7d55aad22e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 153f4e14-c830-5653-1638-7495b0b9fc12_A = True
#. SetFlags:
#.   Local:
#.     - 153f4e14-c830-5653-1638-7495b0b9fc12_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:0df4914e-4824-48ee-b202-a7d55aad22e2
msgctxt "hb3481614gd665g4e48g8e00g5d88684beb95"
msgid "The cultists will soon know the drider's fallen..."
msgstr "광신도 놈들이 조만간 드라이더의 사망을 알게 될 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Skywin
#. NodeID = 27085089-f586-8ab1-2989-7e3900162072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:27085089-f586-8ab1-2989-7e3900162072
msgctxt "ha29e0545g1225g4205g976bg0929accc033d"
msgid "I say we head to Last Light. There's a wine bottle calling my name."
msgstr "최후의 빛으로 돌아가자. 포도주 한 병 걸칠 때도 됐잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Manus
#. NodeID = 4f76ed3d-2044-983f-2238-88511d553aa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:4f76ed3d-2044-983f-2238-88511d553aa7
msgctxt "h63cbaa0bgfd45g4780gbd16gd87d5881cac9"
msgid "The Chionthar'll run red, if I have my way."
msgstr "할 수만 있다면 치온타르 강을 온통 붉게 물들였을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 5e3fc9f7-818d-48ec-8330-a0ee58dc04f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 153f4e14-c830-5653-1638-7495b0b9fc12_B = True
#. SetFlags:
#.   Local:
#.     - 153f4e14-c830-5653-1638-7495b0b9fc12_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:5e3fc9f7-818d-48ec-8330-a0ee58dc04f5
msgctxt "h6d47068bg8449g48c1ga292gf1a4e0c71418"
msgid "Stay on your toes - more cultists might still pass."
msgstr "정신 바짝 차려, 아직 광신도 놈들이 더 올지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Manus
#. NodeID = 6a8a29d3-f007-5a9a-5782-e2c6e143704b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:6a8a29d3-f007-5a9a-5782-e2c6e143704b
msgctxt "hfbe70381g7591g449ega334g735a4e37d8cd"
msgid "At very least. For every beast we slay, the shadows spawn two more."
msgstr "무슨 소용이람. 괴물을 한 마리 잡으면 그림자가 두 마리를 더 내놓는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Skywin
#. NodeID = 6cb9a014-d0a3-3643-707b-7170b790cd94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:6cb9a014-d0a3-3643-707b-7170b790cd94
msgctxt "h9b8aadf9gbf06g4a20g9f3eg4887ee84415b"
msgid ""
"A victory is a victory. Our heads are intact - and that's worth celebrating."
msgstr "이기긴 이겼잖아. 다들 머리는 잘 붙어있으니까, 이만하면 충분히 축하할 만하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Elindale
#. NodeID = 7f9eebc6-7002-1b31-c834-50e1970b640d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:7f9eebc6-7002-1b31-c834-50e1970b640d
msgctxt "ha521c2f4g1fe7g4957gac88gfbffd418ca41"
msgid "Damn right it won't. I'll crush every cultist myself if I have to."
msgstr "당연하지. 필요하다면 모든 광신도를 뭉개버릴 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Elindale
#. NodeID = 8143b8ea-72fd-6dca-c346-a7fc7d7c9792
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:8143b8ea-72fd-6dca-c346-a7fc7d7c9792
msgctxt "h3b0096c0gfe94g46e7g8f03g25a6bf0e2e65"
msgid "Then we'll gut them like the rest."
msgstr "다른 놈들처럼 내장을 쏟게 해 주자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Branthos
#. NodeID = ac28a1f1-34c8-b90d-21b9-4a1289e7618e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:ac28a1f1-34c8-b90d-21b9-4a1289e7618e
msgctxt "hf6a50552gb1e2g42efg8eeeg6ce65e8f80d2"
msgid "...if they don't already."
msgstr "...아직 모르고 있다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Skywin
#. NodeID = ad982a48-9ff7-52e9-b615-afd5897a1ee4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:ad982a48-9ff7-52e9-b615-afd5897a1ee4
msgctxt "hf7e31149g16dfg4f5eg8fe5gd4ab1533d15a"
msgid "Then we best keep our blades sharp and our torches alight."
msgstr "그렇다면 칼날을 벼리고 횃불을 밝혀두자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Branthos
#. NodeID = b174e68e-c32a-4900-b071-89c81b3b80cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 153f4e14-c830-5653-1638-7495b0b9fc12_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:b174e68e-c32a-4900-b071-89c81b3b80cd
msgctxt "h3533d187g1920g4900g91e1gb4d83937bcdb"
msgid "One less blight in the darkness. A thousand more to conquer."
msgstr "어둠에 사는 해충이 하나 줄었군. 처리해야 할 게 천 마리는 더 남았지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Elindale
#. NodeID = c20e97e5-8d9d-d8a3-612e-7e81b32124d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:c20e97e5-8d9d-d8a3-612e-7e81b32124d4
msgctxt "h0af7bb5fgbb58g413ag961cg1e6728bf7fc8"
msgid "Gods - why so glum? We hit the cult where it hurts."
msgstr "맙소사, 왜들 그렇게 뚱해 있어? 교단 놈들한테 제대로 한 방 먹여줬잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Elindale
#. NodeID = c50735e8-154b-a731-018d-5f0a50f0641e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:c50735e8-154b-a731-018d-5f0a50f0641e
msgctxt "h04629a5ag6553g4e76g970bga3e349b499f7"
msgid "If they come, we fight. That's the way of it."
msgstr "놈들이 오면, 맞서 싸우면 돼. 항상 그래 왔잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Manus
#. NodeID = c8c5ac9e-5a82-c3bf-a988-2602926337f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:c8c5ac9e-5a82-c3bf-a988-2602926337f1
msgctxt "hb8a4f46dg1187g449egb3b5gcc62ade019fa"
msgid "All the more reason to keep our senses keen."
msgstr "그러니 더더욱 감각을 예민하게 유지해야지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Manus
#. NodeID = cd6c85fd-921e-a42d-ed7a-bb6d5d639d91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:cd6c85fd-921e-a42d-ed7a-bb6d5d639d91
msgctxt "h38109073gafa6g427cga46cgebd759b7c0c8"
msgid "We shouldn't hang about. Jaheira's lost too many as it is."
msgstr "오래 머물러선 안 돼. 이미 너무 많은 동료를 잃었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush
#. Speaker = Harper Branthos
#. NodeID = ef9be344-ed0f-43c4-8d7a-972ffd3c4928
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 153f4e14-c830-5653-1638-7495b0b9fc12_C = True
#. SetFlags:
#.   Local:
#.     - 153f4e14-c830-5653-1638-7495b0b9fc12_B = False
#.     - 153f4e14-c830-5653-1638-7495b0b9fc12_A = False
#.     - 153f4e14-c830-5653-1638-7495b0b9fc12_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersAfterAmbush:ef9be344-ed0f-43c4-8d7a-972ffd3c4928
msgctxt "h51d575d7g3272g48dcg8693ga3fd39e237f0"
msgid "That won't be the last blood we spill."
msgstr "피를 볼 일이 앞으로도 수두룩하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersMoveTowardsAmbush
#. Speaker = Harper Branthos
#. NodeID = 7b34828f-ac1d-ca3f-030b-3d28b8de971e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersMoveTowardsAmbush:7b34828f-ac1d-ca3f-030b-3d28b8de971e
msgctxt "h0cf527a8gfa56g488dg9a9fg12cc04b1dd16"
msgid "Eyes open, wits sharp."
msgstr "눈 크게 뜨고, 정신 똑바로 차려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Manus
#. NodeID = 28e1c501-7b1a-434e-b14b-e20c5bd2c870
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_A = True
#. SetFlags:
#.   Local:
#.     - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:28e1c501-7b1a-434e-b14b-e20c5bd2c870
msgctxt "h2abe6d79g9e1cg4982ga764g9ab7feac71ee"
msgid "Haven't we waited long enough, Bran?"
msgstr "충분히 오래 기다리지 않았어, 브란?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = 3e2ae90d-cae2-4a80-b955-cf65b34ac99f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_B = True
#. SetFlags:
#.   Local:
#.     - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:3e2ae90d-cae2-4a80-b955-cf65b34ac99f
msgctxt "hefeb9b43g87dfg4899g9ff3gb7557b205728"
msgid "At ease, Harpers - but stay close by."
msgstr "쉬어, 하퍼들. 간격은 유지하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Skywin
#. NodeID = 4da65e21-cd63-ed84-cfc6-96388982eeb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:4da65e21-cd63-ed84-cfc6-96388982eeb8
msgctxt "ha25d3a8age553g4326g9875geacc573104a9"
msgid "And just when will that be?"
msgstr "그때가 언제인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = 4e3282c3-ee13-e783-5d3a-573084af30d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:4e3282c3-ee13-e783-5d3a-573084af30d0
msgctxt "h79c20b43g1e8fg46f6g9e32gc933825ee260"
msgid "New considerations."
msgstr "새 계획이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = 4e6470d7-0bf9-5780-aaaf-692ff32ec2f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:4e6470d7-0bf9-5780-aaaf-692ff32ec2f9
msgctxt "h9d7b25b0g188bg45abg89eeg6053788c29c0"
msgid "We won't be waiting long."
msgstr "오래 기다리진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = 51997075-9f20-9b97-a83b-0c6ba8757697
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:51997075-9f20-9b97-a83b-0c6ba8757697
msgctxt "hd57b576cg1b8fg45aaga3f3g8e2b70bdd995"
msgid "And not a moment sooner."
msgstr "그전에는 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = 62d9b233-5e36-473d-952f-1fbb7216896e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:62d9b233-5e36-473d-952f-1fbb7216896e
msgctxt "h594f6a2cgfa86g4688g8413gc0adfbcdb97f"
msgid "Arms down. Plan's changed."
msgstr "무기 내려. 계획이 바뀌었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = 7c1a4fb2-7f29-10ae-04f9-9548eaef36b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:7c1a4fb2-7f29-10ae-04f9-9548eaef36b2
msgctxt "h2b80d3f2g3a4cg4664ga7eeg32f75ba2f1aa"
msgid "When I give the word."
msgstr "내가 신호할 때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = 94890ad2-23f5-ee52-21c6-6403da511404
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:94890ad2-23f5-ee52-21c6-6403da511404
msgctxt "hc8aa4673g6197g4a75g99dcgc0f64baf2de9"
msgid "For the winds to blow in our favour."
msgstr "우리에게 유리한 때가 올 때까지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Elindale
#. NodeID = a1ca3fdd-6bd8-6122-d135-21f7e6ed7412
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:a1ca3fdd-6bd8-6122-d135-21f7e6ed7412
msgctxt "h14a6d482gf33dg4d3eg99d2gb8632a6f4e57"
msgid "Changed? Why?"
msgstr "바뀌었다고? 무슨 일인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Manus
#. NodeID = a7d3c6c1-7156-e944-71d6-7af7be46e710
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:a7d3c6c1-7156-e944-71d6-7af7be46e710
msgctxt "he9be1fb9g1a81g4286gad25gab6baa7bd079"
msgid "As long as it takes for what?"
msgstr "뭘 기다리고 있는 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = c4f5fb0b-8d9a-9555-c54c-206172441e1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:c4f5fb0b-8d9a-9555-c54c-206172441e1d
msgctxt "h2fef5b07g9928g459bg9ae1g2d712f4dd22a"
msgid "We'll wait as long as it takes."
msgstr "우린 필요한 만큼 기다릴 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush
#. Speaker = Harper Branthos
#. NodeID = d31f8e75-b315-41ed-93d3-64e92d990c17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_C = True
#. SetFlags:
#.   Local:
#.     - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_A = False
#.     - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_C = False
#.     - 7c651195-e50f-fd75-7a35-f6f9a8d80e8d_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersPreparingBeforeAmbush:d31f8e75-b315-41ed-93d3-64e92d990c17
msgctxt "h5f0e65f8gf9b6g4a79gbb9bgfb25be07bf0d"
msgid "When the times comes, move quick, move quiet."
msgstr "때가 되면, 빠르고 조용하게 움직여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersReachAmbushHouse
#. Speaker = GROUP_Act2_SCL_HarpersAmbush
#. NodeID = 7dd84fb1-5bcb-43d3-bfe7-bfbb296428af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersReachAmbushHouse:7dd84fb1-5bcb-43d3-bfe7-bfbb296428af
msgctxt "h60f44271g75fcg4581gaa43g23f966684e66"
msgid "Perfect spot for an ambush. Get into position."
msgstr "매복하기에 완벽한 곳이로군. 각자 위치로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersReachTree
#. Speaker = GROUP_Act2_SCL_HarpersAmbush
#. NodeID = 2995d381-8c48-b52f-a883-57480f032aec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_HarpersReachTree:2995d381-8c48-b52f-a883-57480f032aec
msgctxt "hc3662a75g7b4ag47f8g809dg0c74bb0f9522"
msgid "Keep steady. We're closing in."
msgstr "계속 가도록. 거의 다 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 00a923ae-8db8-9698-e52b-a718e8485e4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:00a923ae-8db8-9698-e52b-a718e8485e4c
msgctxt "h3d701081g54fcg4e2dgb41ag07c9629499bc"
msgid "Then give it time. We will see victory yet."
msgstr "시간을 좀 줘. 아직 승리를 보지 못한 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = 013a63d1-7a64-6da6-05ec-f318fd572c4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:013a63d1-7a64-6da6-05ec-f318fd572c4f
msgctxt "h299825d0g430ag4b43gabe4gb3e1136c4e87"
msgid ""
"I just - are you really sure we can trust someone who is <i>infected?</i>"
msgstr "난 그저 - 감염된 사람을 믿어도 된다고 <i>확신</i>할 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 038c4c22-a5f5-5aeb-ea97-6c8c4f35b210
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:038c4c22-a5f5-5aeb-ea97-6c8c4f35b210
msgctxt "h12432823gbcbfg4066g8f08g0ea6fb9c71c7"
msgid "Until then, keep watch, and keep wary. I need your senses sharp."
msgstr "그때까진, 경계를 늦추지 마. 난 네가 가진 그런 감각이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 29b808bd-6685-a674-07e0-14bf9174c675
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_RendezvousAfterAmbush = False
#.      - SCL_Drider_State_HarpersBackAtInn = True
#.   Local:
#.      - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_B = True
#. SetFlags:
#.   Local:
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_B = False
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:29b808bd-6685-a674-07e0-14bf9174c675
msgctxt "h3d8311bbgd472g4d01gb8e8gac355f1d8b20"
msgid "I know you're keen, Elin. Be patient - your chance will come."
msgstr "엘린, 네가 조급한 건 알지만. 인내심을 가져 - 때가 올 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = 3b950168-2ede-cd56-b704-b122174b8af0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_RendezvousAfterAmbush = True
#.      - SCL_Drider_State_HarpersBackAtInn = True
#.   Local:
#.      - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_A = True
#. SetFlags:
#.   Local:
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:3b950168-2ede-cd56-b704-b122174b8af0
msgctxt "h2c545efcg14a9g406agab9eg43995a909ff0"
msgid "Take a moment, Bran. Savour our victory over the drider."
msgstr "기다려, 브란. 승리를 만끽할 시간을 좀 가지자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 40397719-39c8-0348-6c28-e1ecad19d971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:40397719-39c8-0348-6c28-e1ecad19d971
msgctxt "haa5c3fb0ga73dg4fadgb245g9ea65a717fc8"
msgid "Do you trust Jaheira?"
msgstr "자헤이라를 믿어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 7555c79c-6141-5075-7bd3-18ff1d0f3729
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:7555c79c-6141-5075-7bd3-18ff1d0f3729
msgctxt "h73b9deaegc078g47a5ga101g901a0f653867"
msgid "Yes. Until Jaheira gives me reason to think otherwise."
msgstr "응. 자헤이라가 달리 생각해야 할 이유를 줄 때까지는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = 75bfe883-7b7d-1edf-4927-8f7e4bd5ccb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_RendezvousAfterAmbush = False
#.      - SCL_Drider_State_HarpersBackAtInn = True
#. SetFlags:
#.   Local:
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:75bfe883-7b7d-1edf-4927-8f7e4bd5ccb0
msgctxt "h48a108e3g2a11g4dc7g87d8g1b2c9324231a"
msgid "There must be something more we can do, Bran."
msgstr "우리가 할 수 있는 일이 있을 거야, 브란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = 7b64d2b1-947f-040b-1196-a6cf0be5d744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:7b64d2b1-947f-040b-1196-a6cf0be5d744
msgctxt "h67576d40g247ag4afdga703g8d827a6149c7"
msgid "Yes - we wait."
msgstr "응, 기다려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = ac8d6cff-611c-768b-8bc9-f31e8c23117f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:ac8d6cff-611c-768b-8bc9-f31e8c23117f
msgctxt "h1f8b8be6gf386g4f1fgb76eg36ae4fadc964"
msgid "Have you ever known me to cheer?"
msgstr "내가 활기차게 지내는 거 본 적 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = b6984d06-b621-1058-10e9-e11fe698d999
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:b6984d06-b621-1058-10e9-e11fe698d999
msgctxt "h3ab8a4fdg5a77g483dg814cg41d75073389f"
msgid ""
"If we're called, we join the fight against Ketheric. And with the True Soul, "
"we <i>will</i> land the final blow."
msgstr "불러주면, 케서릭과의 싸움에 합류하겠어. 그리고 참된 영혼과 함께 놈에게 <i>마지막 일격을</i> 날릴 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = c47ec51d-0fb7-9973-8ec9-77bb271890d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_RendezvousAfterAmbush = True
#.      - SCL_Drider_State_HarpersBackAtInn = True
#.   Local:
#.      - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_B = True
#. SetFlags:
#.   Local:
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_B = False
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:c47ec51d-0fb7-9973-8ec9-77bb271890d0
msgctxt "hba557f55gee5eg4637ga88fgdd3c49ff845a"
msgid "So now what. We just - wait? Hope the True Soul comes through?"
msgstr "그래서 이제 뭐 하는데. 그냥 기다려? 참된 영혼이 지나가길 바라면서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = d6be2459-9ac0-0871-d7df-75ff0666e1d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:d6be2459-9ac0-0871-d7df-75ff0666e1d7
msgctxt "h912bd7e5g33a2g4ce9gb45fg4f7372672f46"
msgid "Go on - finish the thought."
msgstr "생각 그만하고 말해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = d97f2fff-927f-e2fb-3f26-9a986788571d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_RendezvousAfterAmbush = False
#.      - SCL_Drider_State_HarpersBackAtInn = True
#.   Local:
#.      - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_A = True
#. SetFlags:
#.   Local:
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:d97f2fff-927f-e2fb-3f26-9a986788571d
msgctxt "h841c236ag2a18g4d29gb7a6g6db46e5b22c4"
msgid "And the True Soul?"
msgstr "그리고 참된 영혼도?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = da5a7619-495a-cd83-c0b2-ec361377827e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:da5a7619-495a-cd83-c0b2-ec361377827e
msgctxt "hc249aa38gea5dg427eg821bgec878ddcf3c5"
msgid ""
"They've gathered an entire army. What's one lost soldier among thousands?"
msgstr "그들은 군대를 모두 모았어. 수천의 병사 중 하나가 사라진 게 뭐가 그리 대단하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = de33a06b-d79b-e1ae-3ff8-306b6b91393d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_RendezvousAfterAmbush = True
#.      - SCL_Drider_State_HarpersBackAtInn = True
#. SetFlags:
#.   Local:
#.     - 0cca6d90-e7d5-b1d6-8d9e-f6b5b8f65006_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:de33a06b-d79b-e1ae-3ff8-306b6b91393d
msgctxt "h21cde075g9bbag45bfgacdfg816ba550a27f"
msgid "A drider doing the cult's work. The Absolute's claws have dug deep."
msgstr "교단의 일을 하는 드라이더라. 절대자의 손아귀가 깊이도 파고들었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = de7ef6d8-ae5e-c32f-8ab0-6cec8bbff1e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:de7ef6d8-ae5e-c32f-8ab0-6cec8bbff1e8
msgctxt "he2b63b8cgbd4cg4547gb78dgda5b76a48950"
msgid "Its death was surely a great blow to the cult."
msgstr "놈의 죽음은 확실히 교단에 큰 타격이 됐을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = efd98aae-062d-aca4-1e35-52ae9fc3c3fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:efd98aae-062d-aca4-1e35-52ae9fc3c3fc
msgctxt "h216b01fdge87fg4cf9gb771g11bec33952bd"
msgid "There's always a first time."
msgstr "언제나 첫 순간이 있는 법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = f018e80b-b0ab-d321-fba6-ab544855950f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:f018e80b-b0ab-d321-fba6-ab544855950f
msgctxt "h015da644ge50bg41a9g8d6fg61b8c855f020"
msgid "With my life."
msgstr "목숨도 걸 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Elindale
#. NodeID = f9677f50-4c81-a0c4-e7e4-8b454cc8c7bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:f9677f50-4c81-a0c4-e7e4-8b454cc8c7bf
msgctxt "h6e9f5f15g7c8eg43f3gbcf3g90f397641f2b"
msgid "We're still alive, Bran. That's worth a cheer, at the very least."
msgstr "우린 아직 살아있잖아 브란. 최소한 그건 축하할 가치가 있는 일이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush
#. Speaker = Harper Branthos
#. NodeID = fc61016f-7914-afde-b1f5-9c391ac1631b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Harpers_AtInn_AfterAmbush:fc61016f-7914-afde-b1f5-9c391ac1631b
msgctxt "hc2d4027bg1c12g4732g8017gdde9ceb8355f"
msgid "I'll celebrate when Ketheric's dead. Not before."
msgstr "케서릭이 죽으면 축하하도록 하지. 그 전에는 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone
#. Speaker = Kar'niss
#. NodeID = 04578481-c71b-4126-a507-2def45b37d5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_A = True
#. SetFlags:
#.   Local:
#.     - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone:04578481-c71b-4126-a507-2def45b37d5a
msgctxt "hc618e485g43d9g402cgbac8g9424c648df1a"
msgid "For the Absolute! For my queen!"
msgstr "절대자를 위하여! 여왕을 위하여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone
#. Speaker = Kar'niss
#. NodeID = 3b134872-605f-4cf9-a882-7773790528e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_B = True
#. SetFlags:
#.   Local:
#.     - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone:3b134872-605f-4cf9-a882-7773790528e3
msgctxt "hbd391bb0ga659g44acg99aag668a7b94a417"
msgid "All will fall in Her name."
msgstr "모두 그녀의 이름 앞에 쓰러질 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone
#. Speaker = Kar'niss
#. NodeID = bb5cfbd1-33b5-42cb-aa12-7ec8f902d91b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone:bb5cfbd1-33b5-42cb-aa12-7ec8f902d91b
msgctxt "h9d1ccd39g7217g4acfg98e3g4e5434c6fee4"
msgid "We strike down the blasphemers in Your name, Majesty!"
msgstr "당신의 이름으로 모독자들을 쓰러뜨리겠습니다, 폐하!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone
#. Speaker = Kar'niss
#. NodeID = d19d85b6-ad89-4f99-9e0e-38338d9dc6b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_C = True
#. SetFlags:
#.   Local:
#.     - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_A = False
#.     - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_B = False
#.     - 1fbc1449-b85a-90a5-3f67-a8898acbd1d0_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_KillsSomeone:d19d85b6-ad89-4f99-9e0e-38338d9dc6b0
msgctxt "h73d143f7g7699g4db3g98edge91976852a38"
msgid "We shall not fail! We shall stand victorious!"
msgstr "우리는 실패하지 않을 것이다! 우리는 승리할 것이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_PlayerTakesMoonlantern
#. Speaker = Kar'niss
#. NodeID = 46c54c90-dd73-4021-943f-510e66f62537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_PlayerTakesMoonlantern:46c54c90-dd73-4021-943f-510e66f62537
msgctxt "h26f74425g235cg4410g88d0gf59b7143d0c3"
msgid "Return the lantern! You are not worthy to hold her light!"
msgstr "등불을 돌려주어라! 넌 그녀의 빛을 가질 자격이 없다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_TollhouseFight
#. Speaker = Kar'niss
#. NodeID = d2642ad0-3154-28cc-4119-f20c0c93fc42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_TollhouseFight:d2642ad0-3154-28cc-4119-f20c0c93fc42
msgctxt "hfa50a7e4g48d4g4c13gb718gfa58b60aee84"
msgid "Pay no heed - onwards, to Moonrise!"
msgstr "신경 쓰지 말도록 - 문라이즈로 전진!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning
#. Speaker = Kar'niss
#. NodeID = 13669fd0-97c5-a1a7-73e5-9f15ece80ca7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7b1fff12-3497-bd2c-4003-1905563c535e_A = True
#.      - 7b1fff12-3497-bd2c-4003-1905563c535e_B = True
#. SetFlags:
#.   Local:
#.     - 7b1fff12-3497-bd2c-4003-1905563c535e_A = False
#.     - 7b1fff12-3497-bd2c-4003-1905563c535e_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning:13669fd0-97c5-a1a7-73e5-9f15ece80ca7
msgctxt "h075a243bg4047g4ceeg96bag3898b78d72b4"
msgid "If they wander, we will not be responsible."
msgstr "그들이 방황한다면, 우리 책임은 아닐 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning
#. Speaker = Kar'niss
#. NodeID = 22357a7e-a5a7-1b83-aaf0-d9f78a24f7a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning:22357a7e-a5a7-1b83-aaf0-d9f78a24f7a4
msgctxt "h75399f23g666ag4dd3ga0b7g787f1c720e46"
msgid "Unless they <i>want </i>to become shadows..."
msgstr "그들이 그림자가 되기를 <i>바라는 게</i> 아니라면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning
#. Speaker = Kar'niss
#. NodeID = 33b58d94-4a26-1a3e-9c9d-29083279b2e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7b1fff12-3497-bd2c-4003-1905563c535e_A = True
#.      - 7b1fff12-3497-bd2c-4003-1905563c535e_B = False
#. SetFlags:
#.   Local:
#.     - 7b1fff12-3497-bd2c-4003-1905563c535e_A = True
#.     - 7b1fff12-3497-bd2c-4003-1905563c535e_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning:33b58d94-4a26-1a3e-9c9d-29083279b2e6
msgctxt "ha764c6b1g914ag4f31gab1fge097d96912b6"
msgid "They wander away from the light, Majesty."
msgstr "그들이 빛 밖에서 방황하고 있습니다, 폐하."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning
#. Speaker = Kar'niss
#. NodeID = 482a7352-3bd2-cada-162e-1da57347b868
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning:482a7352-3bd2-cada-162e-1da57347b868
msgctxt "h407dccd0g3d52g46c0g9999g841ac5dcd796"
msgid "Do they know what they're doing?"
msgstr "무슨 짓을 하고 있는지 그들이 알기나 할까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning
#. Speaker = Kar'niss
#. NodeID = 68882aab-cfd9-baea-9d71-b01bdf92f706
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning:68882aab-cfd9-baea-9d71-b01bdf92f706
msgctxt "h0efe78ffgae3fg49d5g8790g45b93b7eae1c"
msgid "If they die, it is their own fault."
msgstr "그들이 죽어버린다면, 스스로 자초한 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning
#. Speaker = Kar'niss
#. NodeID = e8bfe4eb-b3f5-bd65-730e-12adee9ff88e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7b1fff12-3497-bd2c-4003-1905563c535e_A = False
#.      - 7b1fff12-3497-bd2c-4003-1905563c535e_B = False
#. SetFlags:
#.   Local:
#.     - 7b1fff12-3497-bd2c-4003-1905563c535e_A = True
#.     - 7b1fff12-3497-bd2c-4003-1905563c535e_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AD_Warning:e8bfe4eb-b3f5-bd65-730e-12adee9ff88e
msgctxt "h482e236cg8ff5g4616gb3bagc30ab1533f0a"
msgid "They should stay closer, my Queen. They should stay in the light."
msgstr "그들은 가까이 있어야 합니다, 여왕님. 그들은 빛에 머물러야만 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower
#. Speaker = Kar'niss
#. NodeID = 57f469a8-0eee-de8c-e85c-91a5d3cd89ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower:57f469a8-0eee-de8c-e85c-91a5d3cd89ba
msgctxt "h18996b60ga440g4450ga834g591181ee9f27"
msgid "<i>Be worthy of Her.</i>"
msgstr "<i>그분께 가치있기를.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower
#. Speaker = Kar'niss
#. NodeID = 8812799d-6e1d-f645-0076-f3dec0961095
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_AtTower_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower:8812799d-6e1d-f645-0076-f3dec0961095
msgctxt "h8c5c36fbg850cg403fgb34bg821e84d89913"
msgid "To think, it was we who brought you to Our Majesty's blessing."
msgstr "생각해보니, 네게 폐하의 축복을 가져다 준 건 우리인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower
#. Speaker = Kar'niss
#. NodeID = c5d8b314-658a-2cbd-a97e-23928d00b012
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_AtTower_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower:c5d8b314-658a-2cbd-a97e-23928d00b012
msgctxt "h4a6303c4g892ag4e32ga5ddg63c11ccca71e"
msgid "Outcast no longer. I will <i>ascend.</i>"
msgstr "더 이상 추방자가 아니다. 나는 <i>승천할</i> 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower
#. Speaker = Kar'niss
#. NodeID = f77024cd-ca82-446c-6070-fa96e86e2c1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_AtTower_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_AtTower:f77024cd-ca82-446c-6070-fa96e86e2c1f
msgctxt "h61e56ba2gbf58g4ac0gb698g9c6a27f3ac63"
msgid "An interloper receives the Majesty's blessing before us?"
msgstr "침입자가 우리보다도 먼저 폐하의 축복을 받는다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CINE_CaravanIntro
#. Speaker = Kar'niss
#. NodeID = ad5655a0-6d15-f9c4-548a-5bbfba910d98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CINE_CaravanIntro:ad5655a0-6d15-f9c4-548a-5bbfba910d98
msgctxt "h1f424bd8gbb87g4b72ga7afg050e8255dc28"
msgid "Onwards! The tower awaits us."
msgstr "전진! 탑이 우리를 기다린다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Kar'niss
#. NodeID = 1d4928b6-8486-68c5-ad05-b8a6ea56117f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:1d4928b6-8486-68c5-ad05-b8a6ea56117f
msgctxt "hcd07ea29g0ff9g41dbgb709g8059caa3b503"
msgid ""
"What are they doing? We thought they were True Souls! Traitors! Heathens!"
msgstr "뭐하는 짓인가? 참된 영혼이라 생각했거늘! 배신자! 이교도!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Harper Elindale
#. NodeID = 23cc7c17-6a32-3965-f56a-e8f664558499
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:23cc7c17-6a32-3965-f56a-e8f664558499
msgctxt "h064644b4gd3d7g4fe1g99adge25e0fe2c748"
msgid "Harpers, attack! Get that lantern!"
msgstr "하퍼들, 공격! 등불을 빼앗아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Player
#. NodeID = 375948da-1f29-a359-8b77-d3f2eb585b17
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_State_BetrayedCaravan = True
#.     - SCL_Drider_State_SidedWithCaravan = False
#.     - SCL_Drider_State_SidedWithHarpers = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:375948da-1f29-a359-8b77-d3f2eb585b17
msgctxt "h35df942fg93deg4355gaef1g2963634c229b"
msgid "<i>Turn on the caravan and attack the drider.</i>"
msgstr "<i>호송대를 배신하고 드라이더를 공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Kar'niss
#. NodeID = 594894bb-cf18-9845-8d62-b795dd07d1e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:594894bb-cf18-9845-8d62-b795dd07d1e3
msgctxt "h4e64e744g06f0g46a4g8cf7gdb1d758f6239"
msgid "Wait... Something's wrong, Majesty."
msgstr "잠깐... 뭔가 이상합니다, 위대한 분이시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Kar'niss
#. NodeID = 7561e0bd-8436-4292-47b0-5285872f726d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:7561e0bd-8436-4292-47b0-5285872f726d
msgctxt "h16665365g178bg4ac4ga4fege82cbeaa49a3"
msgid "Kill them! Tear the heathens to pieces!"
msgstr "죽여라! 이교도들을 조각내 버려라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Kar'niss
#. NodeID = 853ce934-0c5a-3a40-52c3-374b12b1b0b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:853ce934-0c5a-3a40-52c3-374b12b1b0b8
msgctxt "h7d2bc4b4g0919g479egba80g676568ed9cfd"
msgid "Heretics! Villains in the dark!"
msgstr "이단자! 어둠 속에 적들이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Harper Manus
#. NodeID = 94dee2c5-a8ce-c750-277a-a5a8f321555f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:94dee2c5-a8ce-c750-277a-a5a8f321555f
msgctxt "h749f3ccbg5beag482egaecfgef6fddb495cc"
msgid "Harpers, now! Get that lantern!"
msgstr "하퍼들, 지금이다! 등불을 뺏어라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Harper Branthos
#. NodeID = 9a489054-4502-dc73-03fa-4b2b162cbecb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:9a489054-4502-dc73-03fa-4b2b162cbecb
msgctxt "h4e4e1da1g12fdg492dg84b9g221ca553378d"
msgid "Harpers, attack! Kill the cultists - and get that lantern!"
msgstr "하퍼들이여, 공격! 광신도들을 죽여라, 등불을 빼앗아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Kar'niss
#. NodeID = a40e3789-ede0-e15f-74da-6f5987a040d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:a40e3789-ede0-e15f-74da-6f5987a040d8
msgctxt "ha380bf06g1300g4371ga7b5g14aedb085add"
msgid "Who's there? Show yourself!"
msgstr "거기 누구냐? 모습을 보여라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Player
#. NodeID = c687f0d5-772a-8e52-5662-029e6fd24c3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:c687f0d5-772a-8e52-5662-029e6fd24c3f
msgctxt "hccd9248bg7d76g47a8g956eg98a58b20e8ac"
msgid "<i>Defend the caravan, attack the Harpers.</i>"
msgstr "<i>호송대를 보호, 하퍼들을 공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Harper Skywin
#. NodeID = df632edc-902f-ed32-a028-aa92f71cfc44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:df632edc-902f-ed32-a028-aa92f71cfc44
msgctxt "hbdbb728cg5e10g49cagb98fg64c9f1adf368"
msgid "Harpers, now! Cut them down!"
msgstr "하퍼들, 지금이다! 죽여라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed
#. Speaker = Narrator
#. NodeID = e864cdaa-ab16-9b2f-7f8e-52fda33f95d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanAmbushed:e864cdaa-ab16-9b2f-7f8e-52fda33f95d8
msgctxt "h3fcf00a4g5eecg4b52gb14agb9263c3f1c60"
msgid ""
"*These Harpers are clearly enemies of the Absolute... they could be "
"worthwhile allies. But defend the guide, and you may preserve your cover as "
"a True Soul. *"
msgstr ""
"*이 하퍼들은 명백한 절대자의 적입니다... 그들은 가치있는 아군이 될 수도 있습니다. 하지만 안내자를 보호한다면, 참된 영혼이라는 "
"위장을 유지할 수 있습니다. *"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 026c1e85-45c7-9f27-c850-2e4cc5110979
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:026c1e85-45c7-9f27-c850-2e4cc5110979
msgctxt "hb3904b6bgacfag4ecag96acg1ba04e58cd1b"
msgid "You heard him. Move out!"
msgstr "다들 들었지. 움직여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 06f1a91f-02d5-24ee-a8eb-1b4b8fc67130
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Hyena_State_Defeated = False
#.      - SCL_EntryPoint_Event_TossHyena = False
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.      - GEN_IsSpeakerPresent_3 = True
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:06f1a91f-02d5-24ee-a8eb-1b4b8fc67130
msgctxt "h8a5ef0cagf75eg4f68gbe50g5280eb71d4cc"
msgid "Why are you smiling like that? What's out there?"
msgstr "왜 그렇게 웃지? 밖에 뭐가 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 0a629301-fa71-f642-df83-63950714371f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:0a629301-fa71-f642-df83-63950714371f
msgctxt "hbdbffff3g4cbcg42cbga4e7ge34a6a724017"
msgid "Yes, let's go."
msgstr "좋아, 가자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 0e1554d2-ea91-3569-2f6f-6e4509488b75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:0e1554d2-ea91-3569-2f6f-6e4509488b75
msgctxt "h1ed69db6g310dg4fb9g8394g0dab5a57677c"
msgid "My apologies. I'm loyal to the Absolute, always."
msgstr "미안하군. 난 절대자께 충성하지, 항상."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 0f74c149-c2cd-6b3c-f84a-30767b3b9639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:0f74c149-c2cd-6b3c-f84a-30767b3b9639
msgctxt "h35f7d5edg0579g466bgbd4agc9432ba3d6bd"
msgid ""
"Come. Follow and stay close. Do not leave the light. Do <i>not </i>feed the "
"shadows."
msgstr "오라. 가까이 붙어서 따라오도록. 빛을 떠나지 마라. 그림자들에게 먹이를 주지 <i>마라</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Lae'zel
#. NodeID = 0fe36385-380a-83da-f344-5ea3912bc12e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#.      - ORI_Laezel_Knows_FoundCreche = True
#.      - ORI_Laezel_State_CanProceedToAct3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:0fe36385-380a-83da-f344-5ea3912bc12e
msgctxt "h14357673ga78bg49bcg93d8g1cd9cb2b7361"
msgid ""
"Every step into the darkness leads us away from the crèche. Do not lose "
"sight of our prize."
msgstr "그림자 속으로 향하는 매 발걸음은 우리를 양성소로부터 멀어지게 하고 있어. 우리 목적을 잊지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 11d6208f-3159-7832-c474-24e832def130
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:11d6208f-3159-7832-c474-24e832def130
msgctxt "h5ec84745g258dg4a5fg882eg516e5dd9715b"
msgid ""
"We walk in the Absolute's light. Her blessed power keeps the shadows back."
msgstr "우리는 절대자의 빛 속에서 걷는다. 그녀의 축복받은 힘은 그림자를 물리친다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 1317dcd8-d3b8-fec1-891f-50c560e95727
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:1317dcd8-d3b8-fec1-891f-50c560e95727
msgctxt "h560d8885gf65bg42b8g9769gc0983ef21ec2"
msgid "Yes. Yes, they'll do nicely."
msgstr "네. 그럼요, 다들 잘 해낼 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 155e6ba4-2e0b-d7ed-54d1-f16dd62340e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:155e6ba4-2e0b-d7ed-54d1-f16dd62340e7
msgctxt "hf6331a43gdc15g4083g920cg4ebe774fbd05"
msgid "No! Our queen gave it to <i>us</i>."
msgstr "안돼! 여왕님께서 <i>우리</i>에게 주신 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Narrator
#. NodeID = 1a926d9e-76fa-ae72-2135-91a37270b24d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_DriderKillsGoblin = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:1a926d9e-76fa-ae72-2135-91a37270b24d
msgctxt "hf7b2e6b6gec2eg4661g97cag61d508120c11"
msgid ""
"*You might as well give orders to an avalanche - the drider does not relent.*"
msgstr "*차라리 산사태에 명령하는 것이 나았을 것입니다. 드라이더는 멈추지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 1b154893-64d7-fb23-2ec9-3d148753a209
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:1b154893-64d7-fb23-2ec9-3d148753a209
msgctxt "hf9072f99g798cg4277ga02egd6d59ed4bccb"
msgid "But we should depart. Are they ready to leave?"
msgstr "허나 이제 출발해야 합니다. 저들이 떠날 준비가 되었나이까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 1c007841-e64b-4702-ee05-bf6a8d522349
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. SetFlags:
#.   Global:
#.     - SCL_Drider_State_SidedWithCaravan = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:1c007841-e64b-4702-ee05-bf6a8d522349
msgctxt "h216103dcgbbaeg4226g9137g6d4fd9995b89"
msgid "You go ahead. I need to consider my options."
msgstr "먼저 가. 난 생각을 좀 해봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 1cf8bd17-d58a-18f6-4107-806d6290f8c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:1cf8bd17-d58a-18f6-4107-806d6290f8c3
msgctxt "hb42349b1geebdg45d5gb5bag703382bf2f36"
msgid "Bless us again, Majesty. Shine Your light, protect us."
msgstr "저희를 또 축복하소서, 폐하. 당신의 빛을 밝히소서, 저희를 보호하소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 210a5d10-16c2-d44e-1d5b-6b2e677920bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:210a5d10-16c2-d44e-1d5b-6b2e677920bd
msgctxt "h37d889d3gb33eg4ff7g9e61g5fed71283142"
msgid "I need to do something first. You wait here."
msgstr "먼저 할 일이 있으니. 여기서 기다려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 24e21e4b-ef64-4ae3-c98d-f91e5ba984f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:24e21e4b-ef64-4ae3-c98d-f91e5ba984f5
msgctxt "h6de767f4g3d22g42c6g8877g5dfe6fba06bc"
msgid "They think they can lie to us, Majesty, but we know better."
msgstr "저들은 자기들의 거짓말이 통할 거라 생각합니다, 위대하신 자여, 하지만 우린 알고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 2894c977-452e-c3f0-3671-0b21a7eceed7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:2894c977-452e-c3f0-3671-0b21a7eceed7
msgctxt "h0d91769bg9e1ag4fcfgabeag204c19268e06"
msgid "No! What are they doing?!"
msgstr "안돼! 뭐하는 짓이야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 3237f44e-3416-8b32-c7f4-300015532e47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:3237f44e-3416-8b32-c7f4-300015532e47
msgctxt "h9ecb79e1g8e7dg432bga085g1667883c6245"
msgid "Fine. Let's go."
msgstr "좋아. 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 33df2e2b-2bf8-14e7-8c1d-efb5901adeaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:33df2e2b-2bf8-14e7-8c1d-efb5901adeaa
msgctxt "h3d13da76g78ddg4e9bg9d08g89cf478a9a8e"
msgid "Peace - stop it!"
msgstr "잠깐, 그만 둬!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 35fe6b1c-9263-4f25-ea62-5bbe159492e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:35fe6b1c-9263-4f25-ea62-5bbe159492e8
msgctxt "hf62d6db3g8eceg40bbgb866g3ad10928d601"
msgid "<i>Attack the creature.</i>"
msgstr "<i>괴물을 공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 3869b094-c417-e2ed-967e-f8c738b94fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:3869b094-c417-e2ed-967e-f8c738b94fc6
msgctxt "ha8c5641ag8e11g4621g9440gaeb3170b6539"
msgid "If they wish to walk through the darkness alone, they are welcome to."
msgstr "그들이 혼자 어둠 속을 걷고 싶다면, 언제든지 환영이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 3cbdc71a-8289-4d69-2051-e9b02f1c9bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:3cbdc71a-8289-4d69-2051-e9b02f1c9bb6
msgctxt "ha82df448gcebag4a89ga050g6ddefa14f3c1"
msgid "Their queen?! They still follow the spider bitch?"
msgstr "너희 여왕?! 아직도 그 거미년을 추종하는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 3f7b0c5c-4569-d7e5-aa96-c436840f5414
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:3f7b0c5c-4569-d7e5-aa96-c436840f5414
msgctxt "hc5e4c7b1ga05fg41a1g9fa8g7d53352dbd8b"
msgid "I'm not following this damned creature - it's an insult to my Queen!"
msgstr "난 저런 저주받은 괴물을 따라가지 않을 거야, 이건 우리 여왕님에 대한 모욕이라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = 403dc60f-075f-52bb-7444-1b05ab44ad02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:403dc60f-075f-52bb-7444-1b05ab44ad02
msgctxt "h68a7e434g1b65g45f1g8159g3b5b66f5da5e"
msgid "Don't worry, we didn't need that 'un anyway."
msgstr "걱정마, 더 이상 필요하지 않으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 4383eace-c3d1-7a54-f8bd-35898d73f732
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47fa253e-3d4a-030a-8a33-3ea72aebd0bf_DarkUrgeComplimentedDrider = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:4383eace-c3d1-7a54-f8bd-35898d73f732
msgctxt "hdcf2ca05g1baeg421fg9309g1343a141e3ae"
msgid "Worshipping the Absolute doesn't mean I have to accept freaks like you."
msgstr "절대자를 숭배한다는 게 너 같은 괴물을 받아들인다는 뜻은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 444c46fe-7e18-75e3-ed0a-3da7e03530f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:444c46fe-7e18-75e3-ed0a-3da7e03530f8
msgctxt "h8f5a9664g68a3g4a7eg8f7dg1441a68fb8ac"
msgid "And you? What are you?"
msgstr "넌? 넌 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 4bebe512-7bd1-f840-f171-c8f4784c78a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Hyena_State_Defeated = False
#.      - SCL_EntryPoint_Event_TossHyena = False
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.      - GEN_IsSpeakerPresent_3 = True
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:4bebe512-7bd1-f840-f171-c8f4784c78a4
msgctxt "h279c4ce7g8750g49e1gbe56g7698271cac11"
msgid "Why? What's hiding in the dark?"
msgstr "왜? 어둠 속에 뭐가 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 4c4646bb-7119-253f-7ae1-3a86bc0a2805
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_MakeCaravanHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:4c4646bb-7119-253f-7ae1-3a86bc0a2805
msgctxt "ha461be43g3fc6g4456g9547gebb33c07565c"
msgid "Treachery! Heathens!"
msgstr "배반이다! 이교도!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 4c8113a5-217f-b85d-03a3-b0b07e2b2649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:4c8113a5-217f-b85d-03a3-b0b07e2b2649
msgctxt "h03ffc0f9gf390g45e6gb193g62ac8efcb87a"
msgid "Yes, lead on."
msgstr "그래, 앞장서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 502b6c27-0b21-8f2f-c5bb-2149dc2e209c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:502b6c27-0b21-8f2f-c5bb-2149dc2e209c
msgctxt "h436a5624g9837g4a90g8e27g5efb7ba2d005"
msgid "Good. It is only Her mercy that keeps us safe in the darkness."
msgstr "좋다. 우리가 어둠 속에서도 안전한 건 그분의 자비 덕분이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 528d69a2-0390-a741-0e32-6185a7fad882
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_MakeCaravanHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:528d69a2-0390-a741-0e32-6185a7fad882
msgctxt "hb33c5462g26c7g4b76gbcaeg31dc7356059c"
msgid "They will pay for this. They will die for this!"
msgstr "대가를 치룰 것입니다. 죽음으로 치룰 것입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 5560fc35-ddac-925d-7f30-85a145a81dd3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:5560fc35-ddac-925d-7f30-85a145a81dd3
msgctxt "h339ffee3g0fa0g4347g85a4g7e7aba310ce7"
msgid "Stand down, drider <i>- now!</i>"
msgstr "멈춰라, 드라이더 <i>- 당장!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 57ad39b7-3443-da3e-d434-81244cc66525
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_MakeCaravanHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:57ad39b7-3443-da3e-d434-81244cc66525
msgctxt "h4c5bc5aag9cc7g4edbgb0afgeed73f6ea96e"
msgid "No, they will not leave! They will answer for their crimes!"
msgstr "아니, 너희는 떠날 수 없다! 너희가 저지른 짓에 대해 대답해야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 5a7f07e4-1b58-b63c-9896-cdc8782fb386
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_SoloPlayer = True
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanHalfOrcCaster(1) = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:5a7f07e4-1b58-b63c-9896-cdc8782fb386
msgctxt "h7d81e0d4g4744g4e08ga1cfgf3b5a0e278a7"
msgid ""
"More faithful of the Absolute. He needs a guide to the Tower, same as us."
msgstr "또다른 절대자의 신실한 종이지요. 타워로 데려다 줄 안내자를 찾고 있습니다, 우리처럼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 5a7f07e4-1b58-b63c-9896-cdc8782fb386
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_SoloPlayer = True
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanHalfOrcCaster(1) = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:5a7f07e4-1b58-b63c-9896-cdc8782fb386
msgctxt "h01113f0fgba2dg4d59g9eb1gf210208df4ca"
msgid ""
"More faithful of the Absolute. She needs a guide to the Tower, same as us."
msgstr "또다른 절대자의 신실한 종이지요. 타워로 데려다 줄 안내자를 찾고 있습니다, 우리처럼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 5a7f07e4-1b58-b63c-9896-cdc8782fb386
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_SoloPlayer = True
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanHalfOrcCaster(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:5a7f07e4-1b58-b63c-9896-cdc8782fb386
msgctxt "h47074721g8c65g4bbag8533g3e2e6487d805"
msgid ""
"More faithful of the Absolute. They need a guide to the Tower, same as us."
msgstr "또다른 절대자의 신실한 종이지요. 타워로 데려다 줄 안내자를 찾고 있습니다, 우리처럼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 5ae5889f-4814-d5cd-569d-730919ca3c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:5ae5889f-4814-d5cd-569d-730919ca3c2f
msgctxt "hc19a13abg29ccg4c57g9941gb3d89754d596"
msgid ""
"Yes. Yes, we shall go. Your light leads the way, my Queen. Are all ready?"
msgstr "네, 그래요. 우린 가야 합니다. 당신의 빛이 길을 이끕니다, 여왕이시여. 이자들이 준비되었나이까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 5b56017f-322a-4628-cf4f-3ed810e83ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:5b56017f-322a-4628-cf4f-3ed810e83ce5
msgctxt "hcacb22bfg32d9g4751ga6c8g77c3c6533fb8"
msgid ""
"Hungry shades and cursed darkness. Cursed by a lesser god, but dangerous all "
"the same, oh yes."
msgstr "굶주린 그림자와 저주받은 어둠. 하급 신의 부산물이지만, 위험하기는 매한가지지. 오, 그렇고 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Lae'zel
#. NodeID = 61191cc5-67e1-45f5-9204-64bd2d19b59e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Knows_FoundCreche = False
#.      - ORI_Laezel_State_CanProceedToAct3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:61191cc5-67e1-45f5-9204-64bd2d19b59e
msgctxt "hce323cc9g38cdg4cd0ga847ge4cb68e664a7"
msgid ""
"Every step into the darkness leads us away from the crèche. Cleansing awaits "
"- do not lose sight of our prize."
msgstr "그림자 속으로 향하는 매 발걸음은 우리를 양성소로부터 멀어지게 하고 있어. 정화가 기다린다, 우리 목적을 잊지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 641debad-fbb8-c696-a262-cd7ba4f3f8c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:641debad-fbb8-c696-a262-cd7ba4f3f8c3
msgctxt "h32cf0d93g69abg41f9gb6e8ge9472f7a83ef"
msgid "Do not! It is only Her mercy that keeps us safe in the darkness."
msgstr "다시는! 우리가 어둠 속에서도 안전한 건 그분의 자비 때문이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 67155c98-4c9f-557d-96a0-bec340dfe655
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:67155c98-4c9f-557d-96a0-bec340dfe655
msgctxt "hedfbbce6g9193g42fegade0g4c1ba84c1d5f"
msgid "What did they do?!"
msgstr "무슨 짓을 한 것이냐?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 683ec32b-8f6e-918c-7ea6-0092806bbb35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:683ec32b-8f6e-918c-7ea6-0092806bbb35
msgctxt "hdd1881bag0bbeg4c9eg9b77g5e7f674cf093"
msgid "We do not toy with the dark. None of us! Do they understand?"
msgstr "우린 어둠으로 장난질을 하지 않는다. 그 누구도! 알아들었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 68c239e3-2dce-57d2-f485-cbb7b6e90436
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:68c239e3-2dce-57d2-f485-cbb7b6e90436
msgctxt "hb8d6b5e2gf212g482cgb9e7gb1f3eb8f80d9"
msgid "I apologise, I didn't mean any offence."
msgstr "사과하지, 불쾌하게 하려던 건 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 6f7e9681-ff69-5ac4-4910-d8cf7c57166e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:6f7e9681-ff69-5ac4-4910-d8cf7c57166e
msgctxt "h68f13fcag1e95g476eg90ecga17fea2ed50e"
msgid "It's time to leave. Take me to Moonrise."
msgstr "갈 시간이다. 문라이즈로 데려다 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 7290825c-856e-04fe-7eac-16c07833ab6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7290825c-856e-04fe-7eac-16c07833ab6c
msgctxt "h1ece509dg07b8g4ceega174g6148b2658f4e"
msgid ""
"They are jealous of Your gift, Majesty. But You gave it to us. And we always "
"keep it close."
msgstr ""
"그들은 당신의 선물을 질투하고 있습니다. 폐하. 하지만 폐하께서 우리에게 주셨습니다. 그리고 우리는 항상 그것을 가까이 두고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 729dcc4e-7e1b-db0c-7f03-cb78b3080655
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:729dcc4e-7e1b-db0c-7f03-cb78b3080655
msgctxt "h1a49ae7egf07bg468fga336g543616bbb4ac"
msgid "Good. Now, are we ready to depart?"
msgstr "좋습니다. 이제, 떠날 준비 되셨나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 76e1af65-f1c9-3047-2cfc-562bd4975be3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:76e1af65-f1c9-3047-2cfc-562bd4975be3
msgctxt "ha976658dgc177g4c42gbee4g46e46194cd67"
msgid "They're not Your faithful, Majesty."
msgstr "저들은 당신의 신자가 아닙니다, 위대한 분이시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 78379d42-9992-0337-4cbb-6ca1d00a41fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:78379d42-9992-0337-4cbb-6ca1d00a41fd
msgctxt "he1b31a4dga97bg454fg9bfcg02c0a615e365"
msgid "<i>Do nothing.</i>"
msgstr "<i>아무것도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 7a05fef7-5dc4-bc5d-aedc-309b57f727a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7a05fef7-5dc4-bc5d-aedc-309b57f727a4
msgctxt "he3ac38d4g4e36g4429ga976gbce95c21c45d"
msgid "I'll be perfectly fine out there alone. I'm a seasoned killer."
msgstr "나 혼자서도 얼마든지 괜찮을 거다. 이 몸은 노련한 살인자니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 7a05fef7-5dc4-bc5d-aedc-309b57f727a4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7a05fef7-5dc4-bc5d-aedc-309b57f727a4
msgctxt "h8e61a2e9g32dfg4e21g8f5dgbc47ea43488d"
msgid "I don't need you to keep me safe out there."
msgstr "저 바깥에서 네 보호 따윈 필요 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 7b294d38-ee22-e080-37c7-040590458c2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7b294d38-ee22-e080-37c7-040590458c2c
msgctxt "hb96ef379g3722g4021ga816ga9da6a2b2b31"
msgid "Watch your tongue, abomination."
msgstr "말 조심해, 혐오체."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 7b9b25c5-7038-ae1a-553d-90c0130ec4aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. SetFlags:
#.   Global:
#.     - SCL_Drider_State_SidedWithCaravan = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7b9b25c5-7038-ae1a-553d-90c0130ec4aa
msgctxt "hc2ddd9bfg4b5fg4651g8d42g462947daa3ac"
msgid "I'll find another way to Moonrise."
msgstr "문라이즈로 가는 다른 길을 찾아보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 7bc6e26f-f61f-751a-bce3-be24ce87a5d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47fa253e-3d4a-030a-8a33-3ea72aebd0bf_DarkUrgeComplimentedDrider = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7bc6e26f-f61f-751a-bce3-be24ce87a5d3
msgctxt "hfc3b2416g72f1g41d6gaf5cgb093c9b2e9cf"
msgid ""
"Worshipping the Absolute doesn't stop me finding you disgusting to look at."
msgstr "절대자를 숭배한다고 해서 너의 역겨운 부분이 보이지 않는 건 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 7c477336-58be-4fb8-8a27-ca3971b5b109
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Strength
#. DifficultyClass: 14
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7c477336-58be-4fb8-8a27-ca3971b5b109
msgctxt "h4a03ad81g3a96g465fg94fbg26ab466efd77"
msgid "<i>Stop ogling the butcher: save the goblin.</i>"
msgstr "<i>도살자에게서 눈을 떼고 고블린을 구한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 7fced9c3-347f-afb5-ce4d-9413ea27f7c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:7fced9c3-347f-afb5-ce4d-9413ea27f7c5
msgctxt "h341b8bf1g08d1g4164gae5cgf2706c694e57"
msgid ""
"We will wait for a time, Majesty, but not long. The shadows are getting "
"closer - we cannot wait long."
msgstr "잠시만 기다리겠습니다, 폐하. 하지만 오래는 안됩니다. 그림자가 가까워지고 있습니다. 우린 오래 기다릴 수 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 80f476f0-5416-7ab6-d283-9f1d1c93a896
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:80f476f0-5416-7ab6-d283-9f1d1c93a896
msgctxt "h4582259cg1f8bg4e41ga39bga6e2ccf312fc"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = 82802049-867b-ad8e-1272-883e8e38ef72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:82802049-867b-ad8e-1272-883e8e38ef72
msgctxt "h523cc407g140fg4d4ega9acgb93394dc0d88"
msgid "Easy now, we're all on the same side, right?"
msgstr "진정해, 우린 다 같은 편이라구, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 83125b30-ae79-c5e8-4536-daa8dc48899e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:83125b30-ae79-c5e8-4536-daa8dc48899e
msgctxt "hb534ad13g05b2g4242g914ag5be0dff6be8d"
msgid "What's out there? What makes the shadows so dangerous?"
msgstr "저 밖에 뭐가 있지? 뭐가 그림자를 위험하게 만드는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 87f9fc41-9ef1-b89c-e89c-f46aad7a9d16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#.      - REALLY_LOLTHDROWELF(1) = False
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:87f9fc41-9ef1-b89c-e89c-f46aad7a9d16
msgctxt "he465cd55g4898g4f02ga458gffe3ace9bdd0"
msgid "I'm not following that abomination anywhere."
msgstr "저 혐오체 따라서는 아무데도 안갈거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 88cb530b-c13b-1fea-1a35-e47a83144118
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:88cb530b-c13b-1fea-1a35-e47a83144118
msgctxt "h0b801613g859ag417bgaf97g5f94cc872980"
msgid ""
"We have our queen's favour. She speaks to us. Protects us. Graces us with "
"Her blessing."
msgstr "여왕님께서 베푸신 호의다. 그분은 축복으로 우리에게 말씀하시고. 지켜주시고. 빛내주신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 8a460d7f-45a1-71b1-5671-aa5fab740794
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:8a460d7f-45a1-71b1-5671-aa5fab740794
msgctxt "hc10a7095ge66dg4590g8e85g3396eb094dbb"
msgid "We understand. Now, we need to go."
msgstr "알겠나이다. 이제 그만 출발해야 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 8bccf679-bdee-cc67-9099-cb19c1e1dcc7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_SoloPlayer = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:8bccf679-bdee-cc67-9099-cb19c1e1dcc7
msgctxt "h5c65c697g757dg49f3g82bcg714d260ed8a8"
msgid "Yes. Yes, he'll do nicely."
msgstr "그렇지, 그래. 이자라면 딱 알맞겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 8bccf679-bdee-cc67-9099-cb19c1e1dcc7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_SoloPlayer = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:8bccf679-bdee-cc67-9099-cb19c1e1dcc7
msgctxt "hc2d85079g277dg4eb9gbc06gfc57a5dcd4cd"
msgid "Yes. Yes, she'll do nicely."
msgstr "그렇지, 그래. 이자라면 딱 알맞겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 8bccf679-bdee-cc67-9099-cb19c1e1dcc7
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_SoloPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:8bccf679-bdee-cc67-9099-cb19c1e1dcc7
msgctxt "h7d9ee479gcabag438bga316g53e735438631"
msgid "Yes. Yes, they'll do nicely."
msgstr "네. 그럼요, 다들 잘 해낼 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 8f360360-b60e-322d-8358-13dc2b6dbddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:8f360360-b60e-322d-8358-13dc2b6dbddc
msgctxt "hd5c097b5gf8a4g494cg8aebgcbd7af7b89bc"
msgid "Come. Do not leave the light. Do <i>not </i>feed the shadows."
msgstr "따라와라. 빛을 떠나서는 안 돼. 그림자에 <i>절대</i> 먹이를 주지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 8fcfc48f-2aaa-9fd4-1b16-05722a47ab14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:8fcfc48f-2aaa-9fd4-1b16-05722a47ab14
msgctxt "h757b3c5bg3b25g450fgadccgf7059dc23231"
msgid "No more 'demonstrations'. Time is short, we need to go."
msgstr "'시연'은 이제 그만. 시간이 없어요, 가야합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 93852bde-a53f-83e1-fd6f-cbd50a01cfc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:93852bde-a53f-83e1-fd6f-cbd50a01cfc0
msgctxt "h6d59af48g6ba2g43b4g946dg2e58fea468ac"
msgid "To insult me is to insult Her Majesty. It is to mock the Absolute!"
msgstr "날 모욕하는 건 여왕님을 모욕하는 것이다. 절대자를 조롱하는가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = 983ef13b-adf0-c469-fdc9-6d358ac01aa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:983ef13b-adf0-c469-fdc9-6d358ac01aa7
msgctxt "h3aec7ca0gb19cg4544gbd02geafaa50c4963"
msgid "And Her magic lamp."
msgstr "그리고 마법의 등 때문이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 98ad3ae2-9b98-1309-b06b-b8fe37fefb65
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_State_DeadCultistSituationDefused = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:98ad3ae2-9b98-1309-b06b-b8fe37fefb65
msgctxt "h05f13690g1744g43bag838dg07cce1c58d0d"
msgid "At least these have survived. At least we return with some faithful."
msgstr "적어도 이만큼은 살아남았군. 적어도 신도들을 데리고 돌아갈 수는 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = 9babbba8-950b-894c-1894-82efdbcad5fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:9babbba8-950b-894c-1894-82efdbcad5fa
msgctxt "h21aa2e1egf095g474eg8190g8075d5e7e44a"
msgid "Things best avoided. Shadows lurking in shadows."
msgstr "피하는 게 최선인 것들이지. 그림자 속에 숨은 그림자들이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = 9bf1b239-e6c2-f013-b2dd-cc3c8ad7de8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanHalfOrcCaster(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:9bf1b239-e6c2-f013-b2dd-cc3c8ad7de8c
msgctxt "h23a1b5fbg0ac3g4606g845fg0553522412de"
msgid ""
"More faithful of the Absolute. They need a guide to the Tower, same as us."
msgstr "또다른 절대자의 신실한 종이지요. 그들도 타워로 데려다 줄 안내자를 찾고 있습니다, 우리처럼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 9c341ea8-9546-a54b-42e1-5fd845f45051
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Local:
#.     - 47fa253e-3d4a-030a-8a33-3ea72aebd0bf_DarkUrgeAdmiredDriderAttack = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:9c341ea8-9546-a54b-42e1-5fd845f45051
msgctxt "hb067babfga183g4081g95aag3dd9f9f59e42"
msgid "<i>Admire the grace of the Drider's serrated legs.</i>"
msgstr "<i>드라이더의 삐죽빼죽한 다리들이 얼마나 우아한지 감상한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = 9d7f04cf-a7bb-8875-1e8f-2a1c5019cf39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47fa253e-3d4a-030a-8a33-3ea72aebd0bf_DarkUrgeAdmiredDriderAttack = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:9d7f04cf-a7bb-8875-1e8f-2a1c5019cf39
msgctxt "hb7c9883fg41c7g4a36g986bgeaf5589fd7ec"
msgid "That was amazing... Let's travel together."
msgstr "놀라운 광경이었어... 같이 다니도록 하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = a2a1c42a-70ba-ec1a-c1b9-13badeb89915
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:a2a1c42a-70ba-ec1a-c1b9-13badeb89915
msgctxt "hf1b8c57bg5485g4369g89eegc6eab7077d2a"
msgid "I just found them like this."
msgstr "나도 이렇게 된 걸 발견했을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = a33070a4-1bbb-8d70-b7f4-d2fd1e1e9868
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:a33070a4-1bbb-8d70-b7f4-d2fd1e1e9868
msgctxt "h8a72ac50g8bccg465dgac3fg2093a4355725"
msgid "So why are we still waiting, Majesty? Why have we not left?"
msgstr "이자들이 뭘 기다리는 겁니까, 위대하신 자여? 왜 아직 떠나지 않는 겁니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = a3e07932-7272-adc9-6298-d5c43aced890
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:a3e07932-7272-adc9-6298-d5c43aced890
msgctxt "hf55cb99dg5eefg4b65g8b01gc753247659d5"
msgid ""
"But the shadows are cunning. Wily. If you stray from the light even for a "
"moment, they'll have you."
msgstr "하지만 그림자는 약삭빠르고, 교활하니, 빛에서 잠시라도 벗어나면 그림자가 당신을 취할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = a413a1a5-7433-c296-4b90-d600c6189e10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:a413a1a5-7433-c296-4b90-d600c6189e10
msgctxt "h938dba1eg4a2fg48a7gb9e8g110cf4038a1d"
msgid "No no NO! We do not toy with the dark. WE DO NOT FEED THE SHADOWS!"
msgstr "안돼 안돼 <b>안돼</b>! 어둠과 장난해선 안된다. <b>그림자에게 먹이를 주지마</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kansif
#. NodeID = a43d3e45-9657-4484-c766-fc0ccba60782
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_1 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:a43d3e45-9657-4484-c766-fc0ccba60782
msgctxt "h9bb2cf2cg802eg485cg80a9gef2bdd7f9bbb"
msgid "Peace! We have enemies enough out there."
msgstr "그만! 적들은 밖에 충분히 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = a65b7cd0-ab0e-e0ca-098e-21e63bcd477f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:a65b7cd0-ab0e-e0ca-098e-21e63bcd477f
msgctxt "hf722e366ga604g452egb951g3d596c876afe"
msgid "Can I examine your lantern? Surely the Absolute wouldn't mind?"
msgstr "그 등불을 좀 살펴봐도 될까? 분명 절대자가 신경 쓰지 않을 텐데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = a7180c46-5528-671b-3e49-7230ac570e83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:a7180c46-5528-671b-3e49-7230ac570e83
msgctxt "h667abc45ga159g4a67g9f94g5dc329adbde3"
msgid "I need to do something first. You wait here."
msgstr "먼저 할 일이 있으니. 여기서 기다려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = ac728f84-af73-b5dd-6b14-5c2180326e3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:ac728f84-af73-b5dd-6b14-5c2180326e3c
msgctxt "h3df40902g2ff9g4c8dgb295g1cf82edf0153"
msgid "Die alone, then. We do not care."
msgstr "그럼, 혼자 죽어라. 우린 신경 쓰지 않는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = b0d223d4-5f52-a78c-c0e7-73660e77670c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_LOLTH or PALADIN_LOLTH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b0d223d4-5f52-a78c-c0e7-73660e77670c
msgctxt "h4b8f6928g8c83g4242gac30g229ad6968dbe"
msgid "I follow Lolth almighty, and how dare you reject our Dark Mother."
msgstr "난 전능하신 롤쓰님을 따른다, 어찌 감히 어둠의 어머니를 거부하는가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = b10f8cdc-45b0-e3fd-f2b6-3911df00b932
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b10f8cdc-45b0-e3fd-f2b6-3911df00b932
msgctxt "h5924e223g11aeg4882g9ddfg812c3991aee0"
msgid "Here, this'll tickle yeh."
msgstr "자, 이거 진짜 재밌을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = b1202d76-cac0-fcee-0f54-8509e8440c8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b1202d76-cac0-fcee-0f54-8509e8440c8a
msgctxt "hf26a567dg2e0fg4cf6gb367g26e318926df3"
msgid ""
"Our queen's light will keep them at bay. Will keep us safe as we guide Her "
"faithful to Her temple, but only if they stay close."
msgstr ""
"여왕님의 빛이 놈들을 막아 주신다. 우리가 그분의 충신들을 신성한 신전으로 인도하는 동안 안전하게 지켜 주시지. 하지만 멀리 떨어져선 안 "
"된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = b339012b-3714-00c0-2654-28d86b5167d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b339012b-3714-00c0-2654-28d86b5167d9
msgctxt "hd8d7eb06gd1f9g4c9cgbe7ag9caf3048dce9"
msgid "First tell me how you can move safely through the darkness."
msgstr "먼저 어둠 속에서 네가 어떻게 안전하게 이동하는지 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = b3c2ad58-3601-6418-facc-611ed22bcda6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b3c2ad58-3601-6418-facc-611ed22bcda6
msgctxt "h9ec6ef4egd413g44d5g8684gc25dcfdf332a"
msgid "Forgive me, obviously I'm loyal to the Absolute."
msgstr "실수를 했군. 보다시피 난 절대자님께 충성을 바친다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Lae'zel
#. NodeID = b52bf000-0dda-4b75-a9bb-8a312fd770bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Knows_FoundCreche = False
#.      - ORI_Laezel_State_CanProceedToAct3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b52bf000-0dda-4b75-a9bb-8a312fd770bc
msgctxt "h1cf60b68gf448g46b8g9516g211ba8d2b588"
msgid ""
"Every step into the darkness leads us away from the crèche. Cleansing awaits "
"- do not lose sight of our prize."
msgstr "그림자 속으로 향하는 매 발걸음은 우리를 양성소로부터 멀어지게 하고 있어. 정화가 기다린다, 우리 목적을 잊지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = b61e8726-7ed9-e5ea-5528-f10d60b4427a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_State_DeadCultistSituationDefused = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b61e8726-7ed9-e5ea-5528-f10d60b4427a
msgctxt "h6f35cfe9g37bcg4726gb923g2e71208cd550"
msgid "They culled the weakest of your flock in your name, Majesty. Glorious!"
msgstr "저들이 당신의 이름에 먹칠을 하는 나약한 자들을 제거했습니다, 폐하. 영광을!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = b9bbe987-53b6-2503-2e9d-ec9eca0cfed1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:b9bbe987-53b6-2503-2e9d-ec9eca0cfed1
msgctxt "hb667d09bg7459g4dc7gbdbeg5229a44a0619"
msgid "We do <i>not </i>toy with the dark! Do they understand?"
msgstr "우린 어둠으로 장난질을 하지 <i>않는다!</i> 알아들었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = bd0ceec3-bf49-af5b-5625-fa880fe7d922
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:bd0ceec3-bf49-af5b-5625-fa880fe7d922
msgctxt "h68621aa5g3172g4536g8224g0b4652e30606"
msgid "Forgive me, I would never insult the Absolute."
msgstr "용서해줘, 다시는 절대자를 모욕하지 않을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = c1851e20-ec39-362e-3fbf-4ae3faf7984f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_State_PlayedHarpBadly(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:c1851e20-ec39-362e-3fbf-4ae3faf7984f
msgctxt "h9c8cf4b9g7606g463bg9a1fgbb7e67b670b5"
msgid "Apart from a torturer of lyres."
msgstr "끔찍한 리라 연주자라는 것 말고 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Narrator
#. NodeID = ca0d16f8-be21-b3a6-fac7-fc53bc1179c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:ca0d16f8-be21-b3a6-fac7-fc53bc1179c4
msgctxt "h72a79d59g73bcg47dfgaa46gf8f0c5043578"
msgid ""
"*Your minds connect and you hear a whispered voice. The Absolute? Or just "
"the echoes of his fractured mind, reverberating in the dark?*"
msgstr ""
"*여러분의 정신이 연결되고 속삭이는 소리가 들립니다. 절대자일까요? 아니면 그의 조각난 정신의 메아리가 어둠속에서 울리는 것 일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Lae'zel
#. NodeID = cb7dce27-3653-4c4d-fa89-610cbc2cdacf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_BetrayedByVlaakith = False
#.      - ORI_Laezel_Knows_FoundCreche = True
#.      - ORI_Laezel_State_CanProceedToAct3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:cb7dce27-3653-4c4d-fa89-610cbc2cdacf
msgctxt "hcb7a3c2ag45cfg4a4cg9e2fgeaca69063f2a"
msgid ""
"Every step into the darkness leads us away from the crèche. Do not lose "
"sight of our prize."
msgstr "그림자 속으로 향하는 매 발걸음은 우리를 양성소로부터 멀어지게 하고 있어. 우리 목적을 잊지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = cc2a8266-114f-f152-9503-cdca81a755d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:cc2a8266-114f-f152-9503-cdca81a755d9
msgctxt "hf4ec1ae8ge22bg4fb1g85c3gf79d78205d55"
msgid "Very well. Gather the flock."
msgstr "아주 좋아. 신도들을 모아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = d3d72ec8-ec9c-6737-38b1-cecebd2663b8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:d3d72ec8-ec9c-6737-38b1-cecebd2663b8
msgctxt "h136a1553g9334g44cdga7b7g8556a07ee8d6"
msgid ""
"Blood-slaughter is how I worship. Take me to Moonrise, or become a prayer."
msgstr "피의 살육이 내가 숭배하는 방식이다. 나를 문라이즈로 데려가라. 아니면 숭배의 제물이 되던지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = d3d72ec8-ec9c-6737-38b1-cecebd2663b8
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:d3d72ec8-ec9c-6737-38b1-cecebd2663b8
msgctxt "h054441ddg0be2g4e57gb7b3gd48a5167bf6b"
msgid ""
"I killed them in the Absolute's name, now take me to Moonrise or meet the "
"same fate."
msgstr "절대자의 이름으로 죽였지, 이제 날 문라이즈로 데려다줘, 아니면 저들과 같은 운명을 맞이하든가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = d680efc0-7836-e83f-6d1a-33859c09032f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:d680efc0-7836-e83f-6d1a-33859c09032f
msgctxt "h4b603d42gad14g422bgb75cg09e637f69a4d"
msgid "<i>Attack the blasphemous creature.</i>"
msgstr "<i>불경스러운 괴물을 공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = d6d3e04a-4012-22ff-b5aa-c4f60c0a5a04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:d6d3e04a-4012-22ff-b5aa-c4f60c0a5a04
msgctxt "h1055b3bdgbc4eg441fgbd32g174d7f7b3498"
msgid "A True Soul. You have more worshippers every day, majesty."
msgstr "참된 영혼이라. 당신의 숭배자가 매일 같이 늘어나고 있습니다, 여왕님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = d8a12b54-545f-9382-2217-61a567ba7667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:d8a12b54-545f-9382-2217-61a567ba7667
msgctxt "hc5ccddf5g74cdg454agb8ecg4660242535ef"
msgid "Try not to piss him off, mate..."
msgstr "그를 열받게 만들진 말라구, 친구..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = d934bc0b-acc9-4b8c-e1bb-829ffedd1798
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:d934bc0b-acc9-4b8c-e1bb-829ffedd1798
msgctxt "hab124145gd701g4148g853bgb6bf94852196"
msgid "So you're the guide? How do you survive out there?"
msgstr "그래서 네가 안내자? 저 밖에서 어떻게 살아남지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = db28d041-e10f-8619-c5b0-782ee1f00aa4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:db28d041-e10f-8619-c5b0-782ee1f00aa4
msgctxt "h4dba3817g84bag4a80gaf91gd060a466d62f"
msgid "Are they ready, majesty? Shall we depart?"
msgstr "그들이 준비 됐을까요, 여왕님? 우리가 출발해도 될까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = dd0b36d6-e0fe-1b43-212e-4b679546d4d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Local:
#.     - 47fa253e-3d4a-030a-8a33-3ea72aebd0bf_DarkUrgeComplimentedDrider = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:dd0b36d6-e0fe-1b43-212e-4b679546d4d5
msgctxt "h2f85d5b9g44adg4aafg82d4g4de54a1f3977"
msgid "My, what a delightful abomination you are."
msgstr "이런, 정말 맘에 드는 혐오체구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = e09f5ab3-2ab3-cadd-ac7e-d928d8bba4a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e09f5ab3-2ab3-cadd-ac7e-d928d8bba4a8
msgctxt "h991feefage699g4322g9e97g14700fe17dc4"
msgid "Fools. Idiots!"
msgstr "바보 놈들. 어리석기는!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = e0c68312-259c-62bc-ec98-c40159b7212a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e0c68312-259c-62bc-ec98-c40159b7212a
msgctxt "hf73df8f0gcb54g4314gbe84gff72386a65e4"
msgid "Now, will they follow or stay?"
msgstr "그럼 저들이 따라 오겠습니까, 머물겠습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = e5b1fc4c-4d23-e64e-efef-204189ede09e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 14
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e5b1fc4c-4d23-e64e-efef-204189ede09e
msgctxt "h6632514cgc261g45e6ga792g9c224dec6f64"
msgid "<i>Pull the goblin to safety.</i>"
msgstr "<i>고블린을 안전한 곳으로 잡아끈다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = e5c6fb91-fa75-8b4e-3671-8d972976df1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_CheckpointGoblin_State_Defeated = False
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e5c6fb91-fa75-8b4e-3671-8d972976df1a
msgctxt "h8c44512eg7bccg48ffgaa21g7f1914bc1fbd"
msgid "Bloody right we do..."
msgstr "젠장, 물론 그래야겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = e71bc3b3-799c-8cb2-41c8-3535b80cac22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Hyena_State_Defeated = True
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e71bc3b3-799c-8cb2-41c8-3535b80cac22
msgctxt "h99b6e6dageb81g4402g8768g42e0d1658d71"
msgid ""
"I'll get to Moonrise myself. I'd be mad by now if I was afraid of the night."
msgstr "내 발로 직접 가겠다. 밤을 겁냈다면 지금쯤 미쳐버렸겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = e71bc3b3-799c-8cb2-41c8-3535b80cac22
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Hyena_State_Defeated = True
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e71bc3b3-799c-8cb2-41c8-3535b80cac22
msgctxt "h61d8df1bg38d2g4c49gb131g1fccb3f350a6"
msgid "I'll get to Moonrise myself. A few shadows don't scare me."
msgstr "내 발로 직접 가겠다. 약간의 그림자 따위는 겁나지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = e73845d6-6f4e-d215-0e3d-bfe94da56d51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e73845d6-6f4e-d215-0e3d-bfe94da56d51
msgctxt "h9ec072c2g63afg4088g9fb2g84dad9ef7c05"
msgid "What the hells is hiding in there?"
msgstr "저기 숨어있는 게 대체 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = e86f45ba-4260-7785-f997-aec37f0f9537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:e86f45ba-4260-7785-f997-aec37f0f9537
msgctxt "h790e4c20gf359g43c6g8240g1f16f4a6d814"
msgid "That so? Maybe this'll change your mind."
msgstr "그렇단 말이지? 이걸 보면 생각이 바뀔지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = ed078e8c-3cd0-0ed6-3e33-a1b29681bcd0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:ed078e8c-3cd0-0ed6-3e33-a1b29681bcd0
msgctxt "hd8f27ca3g23dcg401egb8b3g644411b7c14c"
msgid "I murdered them, like I'm going to murder you."
msgstr "내가 죽였지, 이제 네 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = ed078e8c-3cd0-0ed6-3e33-a1b29681bcd0
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:ed078e8c-3cd0-0ed6-3e33-a1b29681bcd0
msgctxt "hda110fb9gba96g4d5fga4bfg3590994364d9"
msgid "I slaughtered them, like I'm going to slaughter you."
msgstr "내가 도살했지, 이제 네 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = ed2e1b19-f5d6-ea1b-fa49-a8c0dd01766f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:ed2e1b19-f5d6-ea1b-fa49-a8c0dd01766f
msgctxt "hf31735bfgbdf5g47c8g907fg8e4c8f88acb6"
msgid "All right, let's go."
msgstr "알았어, 가자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = ef1870fa-b980-4d7d-e05a-1664361ce61b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_DeadCultistSituationDefused = False
#.      - SCL_Drider_State_CaravanCultistsDefeated_NoDrider = True
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:ef1870fa-b980-4d7d-e05a-1664361ce61b
msgctxt "haff12c90gaafag459ag8dc9g0a8b18c9ef0b"
msgid "Your worshippers, Majesty. What happened here?"
msgstr "당신의 숭배자들 입니다, 위대하신 자여. 무슨일이 있었던 걸까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = ef5d7784-3fab-07d2-d7da-6697862225d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Hyena_State_Defeated = False
#.      - SCL_EntryPoint_Event_TossHyena = False
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.      - GEN_IsSpeakerPresent_3 = True
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:ef5d7784-3fab-07d2-d7da-6697862225d0
msgctxt "h96d80bebg93beg4e82g87b6g9bcee738a0b0"
msgid "Why do I need you to get to Moonrise? What's out there?"
msgstr "문라이즈에는 왜 가야하지? 거기에 뭐가 있길래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = f0354244-d97a-9150-da43-6f9b675eba5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f0354244-d97a-9150-da43-6f9b675eba5a
msgctxt "he0fbe1cbg2a80g4dc3g9596g69f5fc53b5c0"
msgid ""
"My queen has ordered me to guide Her followers through the dark. However "
"imperfect they may be."
msgstr "여왕님께선 신도들이 어둠을 뚫고 갈 수 있게 안내하라고 하셨다. 그들이 아무리 불완전하다고 해도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = f13c9d8c-5fe0-6a70-22bd-bbdd3135b818
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f13c9d8c-5fe0-6a70-22bd-bbdd3135b818
msgctxt "h1b059262geaf0g4068g980ag82ca7842edfc"
msgid "I don't know. I was fast asleep, resting for the journey!"
msgstr "나도 몰라. 깊이 잠들어 있었거든, 여행 중에 좀 쉬느라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = f17f5b65-1dd1-5a67-b2bc-add2e2c85ebd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f17f5b65-1dd1-5a67-b2bc-add2e2c85ebd
msgctxt "hc5c62ec7g598cg40e0g80a4g59054e28235d"
msgid "Oh ho, the drow really told you nothin', eh?"
msgstr "오 호, 드로우가 진짜 아무것도 말 안해줬나봐, 엉?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = f323ce11-e33c-9698-17dc-9951cebf61aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f323ce11-e33c-9698-17dc-9951cebf61aa
msgctxt "hf6a4e957g5ec8g4264g9102g420bf593c753"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Narrator
#. NodeID = f4aec3c6-9355-6c8f-20fe-3cab31813349
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_DriderKillsGoblin = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f4aec3c6-9355-6c8f-20fe-3cab31813349
msgctxt "h47ee7746ga62dg4fefg9ac2ge72447182e05"
msgid "*You try to pull the goblin away, but it's too late. She's gone.*"
msgstr "*고블린을 잡아당겨 보지만, 너무 늦었습니다. 이미 죽었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = f512e048-ce66-e450-32e9-23404bbb93bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.      - GEN_IsSpeakerPresent_3 = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f512e048-ce66-e450-32e9-23404bbb93bb
msgctxt "h8e18eb95g2929g466agac5dg77afe19b0243"
msgid "I'd be perfectly fine out there alone. I'm a seasoned killer."
msgstr "난 혼자 나가도 아무 문제 없을걸. 남을 해치는 데에는 일가견이 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = f512e048-ce66-e450-32e9-23404bbb93bb
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f512e048-ce66-e450-32e9-23404bbb93bb
msgctxt "h2d9b445bgdec4g48abgb653g98f15a871954"
msgid "Fine. I don't need you or your lamp."
msgstr "그러지. 네가 됐건, 네 등불이 됐건 전부 필요없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Kar'niss
#. NodeID = f540ccaa-883f-53d1-ceab-ac12aee54022
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_PlayersStartFollowingDrider = True
#.     - SCL_Drider_State_WaitAtCaravanStart = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:f540ccaa-883f-53d1-ceab-ac12aee54022
msgctxt "h8f9aa29dg1882g4dc8gaee1gae81244b5521"
msgid "They must follow close, Majesty. They must not leave the light."
msgstr "저들은 가까이 따라 와야 합니다, 위대하신 분이시여. 빛에 머물러야 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Brawler Vez
#. NodeID = fd1ebde5-a14d-f189-dbcb-aa095f4edf4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:fd1ebde5-a14d-f189-dbcb-aa095f4edf4c
msgctxt "h5cb308e5g07a3g4cdag8ea9ga7f75150a807"
msgid "Gods above, what's wrong with you?!"
msgstr "이런 세상에, 대체 무슨 짓이야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart
#. Speaker = Player
#. NodeID = feedd495-66db-cf28-56b8-d787a72372e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47fa253e-3d4a-030a-8a33-3ea72aebd0bf_DarkUrgeComplimentedDrider = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_CaravanStart:feedd495-66db-cf28-56b8-d787a72372e9
msgctxt "h8839f489gc57ag4015gb38bgc5104b06b479"
msgid "It's a compliment! You're a beautiful beast. Calm down."
msgstr "이건 칭찬이라구! 넌 아름다운 짐승이야. 진정해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_GoblinMelee_001
#. Speaker = Warrior Gronag
#. NodeID = 7455a956-4a89-4b2f-9aef-cf9e12ccb21d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_GoblinMelee_001:7455a956-4a89-4b2f-9aef-cf9e12ccb21d
msgctxt "hcd0b86b0gb0bbg4d9egab96ga30adf8a6435"
msgid "I'll gut you in 'er name - for the Absolute!"
msgstr "그분의 이름으로 배를 따주마. 절대자님을 위해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Kansif
#. NodeID = 04f28438-7663-15a1-9579-75b17ec70c0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:04f28438-7663-15a1-9579-75b17ec70c0b
msgctxt "h2882406fg061cg48c4g805egfa41dc701bec"
msgid "What was what?"
msgstr "뭐 말이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Kansif
#. NodeID = 15fd53e3-77f4-47da-8a1f-be6fd1dc5f3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f2fd8947-51ee-4636-035d-0ed1841d3f5d_A = True
#. SetFlags:
#.   Local:
#.     - f2fd8947-51ee-4636-035d-0ed1841d3f5d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:15fd53e3-77f4-47da-8a1f-be6fd1dc5f3c
msgctxt "hea6a390fg94ebg4198g9ef4g5c934a5d645f"
msgid ""
"Don't you believe the Absolute will protect you? Or is your faith waning?"
msgstr "절대자께서 널 지켜주실 거라 믿지 않나? 믿음이 옅어지기라도 한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = 35afaff9-4e51-1a41-4154-8b3404fe8dd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:35afaff9-4e51-1a41-4154-8b3404fe8dd4
msgctxt "hb98a38eeg96f4g4fb8g87f8gd736eee8f318"
msgid ""
"Wish he'd bloody well hurry up then. I could swear the shadows are getting "
"closer."
msgstr "그럼 부디 서둘러줬으면 좋겠군. 맹세코 그림자가 다가오고 있을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = 5c62b1f2-eb4d-08ca-14c2-15529cd94e44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:5c62b1f2-eb4d-08ca-14c2-15529cd94e44
msgctxt "hf4d12a74gcb28g4763gb687g09d1def39fdd"
msgid "...Nothing. Just the dark."
msgstr "...아무것도 아니야. 어둠뿐이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = 7029c59d-0891-4d84-1f19-3ec0973a5cf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:7029c59d-0891-4d84-1f19-3ec0973a5cf1
msgctxt "h1ec46c98ga36dg410aga80fg4c030d9492c6"
msgid "I got faith. I just got common sense too."
msgstr "믿음은 있어. 다만 나한테는 상식이란 것도 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Kansif
#. NodeID = 80897e96-72c7-41fd-848d-4f1bbb8bf57c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f2fd8947-51ee-4636-035d-0ed1841d3f5d_B = True
#. SetFlags:
#.   Local:
#.     - f2fd8947-51ee-4636-035d-0ed1841d3f5d_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:80897e96-72c7-41fd-848d-4f1bbb8bf57c
msgctxt "h8aea40f9g71cag4356gbe6ag01affe13c0f8"
msgid "The guide will see us through the darkness."
msgstr "안내자가 어둠을 뚫고 나갈 수 있도록 우릴 도와줄 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = 81f093d1-ef01-3628-9936-e638f196536c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:81f093d1-ef01-3628-9936-e638f196536c
msgctxt "h476ef522g0e42g420cg9c19gd8cdf179bd50"
msgid "And you ain't? You know what's out there as well as I do."
msgstr "넌 어떻고? 너나 나나 저 밖에 뭐가 있는지 잘 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Kansif
#. NodeID = 9a0bbb58-72cd-4f44-a9bf-21e51a254679
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f2fd8947-51ee-4636-035d-0ed1841d3f5d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:9a0bbb58-72cd-4f44-a9bf-21e51a254679
msgctxt "h8fde4c8ag6f98g4a6aga0f4g302337e3ff87"
msgid "You're jumpy."
msgstr "예민해 보이는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = be16efa6-508f-4425-a1bc-e027379c20de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f2fd8947-51ee-4636-035d-0ed1841d3f5d_C = True
#. SetFlags:
#.   Local:
#.     - f2fd8947-51ee-4636-035d-0ed1841d3f5d_A = False
#.     - f2fd8947-51ee-4636-035d-0ed1841d3f5d_B = False
#.     - f2fd8947-51ee-4636-035d-0ed1841d3f5d_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcAndGoblinAtCheckpoint:be16efa6-508f-4425-a1bc-e027379c20de
msgctxt "h78579863gc41eg4997ga315g1640db84cce4"
msgid "What was that?"
msgstr "뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 5ec63f23-1b89-42dc-a4e7-81f11479b93d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_HalfOrcCaster:5ec63f23-1b89-42dc-a4e7-81f11479b93d
msgctxt "h686fdc22gff2fg4460g9fb9gf434cdf8b76f"
msgid "You will die here - the Absolute wills it so!"
msgstr "넌 여기서 죽는다. 절대자님의 뜻에 따라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena
#. Speaker = Warrior Gronag
#. NodeID = 03f64726-b5f7-b761-78ff-b74b3211c5b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena:03f64726-b5f7-b761-78ff-b74b3211c5b7
msgctxt "hdbdee94ag5e98g44fdg8b0cg73ff02486272"
msgid "Don't make eyes at me, you breech-blossom."
msgstr "나한테 눈짓 하지 마라, 이 똥강아지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena
#. Speaker = Warrior Gronag
#. NodeID = 237119f1-40be-d49c-7387-d6ef0164f5fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena:237119f1-40be-d49c-7387-d6ef0164f5fe
msgctxt "hf80254acg0f04g46fdg8b06gbf49e0468269"
msgid "Should've let your mum eat ya."
msgstr "네 어미가 잡아먹게 냅둬야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena
#. Speaker = Hyena
#. NodeID = 41e776e2-ba52-4f1c-ba2d-4d6181641d58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_A = True
#. SetFlags:
#.   Local:
#.     - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena:41e776e2-ba52-4f1c-ba2d-4d6181641d58
msgctxt "h6bb29282g73a4g4e0cg829aga3a67d4bd700"
msgid "*Whimper.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena
#. Speaker = Warrior Gronag
#. NodeID = 851da0d4-8c9f-46cb-a674-7ba4732c3fff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_B = True
#. SetFlags:
#.   Local:
#.     - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena:851da0d4-8c9f-46cb-a674-7ba4732c3fff
msgctxt "hb4b9d7f0gab54g4ccag84fegf2f5a393bf94"
msgid "You want a kickin'? Can only make you prettier."
msgstr "한 대 걷어차 줄까? 그럼 말 좀 잘 듣겠구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena
#. Speaker = Warrior Gronag
#. NodeID = b8e11697-4b2d-4fdd-b943-ac79a1c38b17
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena:b8e11697-4b2d-4fdd-b943-ac79a1c38b17
msgctxt "h234baed6g5280g4de3gaff0g0a978620e575"
msgid "Get outta here. Scram!"
msgstr "여기서 나가라고. 썩 꺼져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena
#. Speaker = Hyena
#. NodeID = c9f716e2-796f-4a63-a24a-8f0e2ebedd18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_C = True
#. SetFlags:
#.   Local:
#.     - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_A = False
#.     - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_B = False
#.     - 13d9f9ef-d1da-1d1d-287f-7a1763d72c38_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_Hyena:c9f716e2-796f-4a63-a24a-8f0e2ebedd18
msgctxt "h14462444gebf3g4210g86d8g660ee2f7bf89"
msgid "*Whine.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Brawler Vez
#. NodeID = 0dad4815-bbf0-b356-4903-a4c83a97c551
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint:0dad4815-bbf0-b356-4903-a4c83a97c551
msgctxt "h32695795g81ceg4948g9db7g019f7e543314"
msgid "Stay 'ere then. See if you like the shadows any better."
msgstr "그럼 여기 있어. 그림자가 하나라도 더 마음에 드는 게 있는지 보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = 3b6260f0-ab9b-42c2-9463-ee91fcf5e950
