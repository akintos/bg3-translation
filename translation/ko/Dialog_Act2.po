#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 00a82e63-fae8-cc02-0b2b-314c9d21ce6c_C = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:ed6c3274-d0e6-4593-a988-f7abc7a5681d
msgctxt "h7bff93c9g3b03g4b54g8a29g54005d0616a3"
msgid "Chains bind the boat. I will free it."
msgstr "배가 사슬에 묶여 있어. 내가 풀게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = eff3d81c-87bd-48ba-ba10-8e1deb704515
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 00a82e63-fae8-cc02-0b2b-314c9d21ce6c_E = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:eff3d81c-87bd-48ba-ba10-8e1deb704515
msgctxt "h47b20f2cgc52ag4b4fgbd25gdf2a32e3d16a"
msgid "Must we go by water? I - I don't want to."
msgstr "꼭 물로 가야하는 거야? 나, 난 싫은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = fcacf9a7-63cd-9dfe-7e5d-e1e45088e6a5
