msgctxt "hc9465cc4g6cfbg400dgb17cg2a99f04eee19"
msgid "I played cards with Marcus. I thought we were friends."
msgstr "마커스와는 카드놀이도 했었어. 친구라고 생각했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_DockGuard_Ranger
#. Speaker = Harper Naysa
#. NodeID = 3fef19df-a8f6-49d4-90ce-7917385d3c26
