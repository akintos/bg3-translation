#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Quest_WallTentacle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:1f0edd6b-00f7-cc7b-a292-d9888085f179
msgctxt "hf6c76676g10c6g496dgb64dg7db78ecd115e"
msgid ""
"---disgraced--        -master-<i>\n"
"</i>             -<i>heir</i>---        ---tyrant-<i>\n"
"</i>      ---DARK--      ---<b>URGE-</b>"
msgstr ""
"---불명예스러운--        -주군-<i>\n"
"</i>             -<i>후계자</i>---        ---폭군의-<i>\n"
"</i>      ---어두운--      ---<b>충동-</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Lae'zel
#. NodeID = 1fa493c1-ad5e-dcdd-a849-ba51103ff12e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_LAEZEL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:1fa493c1-ad5e-dcdd-a849-ba51103ff12e
msgctxt "h84e4ffcbg2b39g4639g88dfge8da7c514ead"
msgid "That voice. Like nothing I've ever heard..."
msgstr "그 목소리. 한번도 들어본 적 없는 것처럼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Karlach
#. NodeID = 20a2a340-7784-49a0-86c9-ed51ea61b162
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:20a2a340-7784-49a0-86c9-ed51ea61b162
msgctxt "h53e9d710g710ag4675g934dgf21d3767e53d"
msgid "Uh, what is <i>that</i>?!"
msgstr "어, <i>저게</i> 뭐야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 2110c052-7e5f-9d02-f76a-77c9a9c9c9e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:2110c052-7e5f-9d02-f76a-77c9a9c9c9e8
msgctxt "h90aed181g3fbag4770g86d5ga72e390c5d0b"
msgid ""
"---You are--\n"
"         ---the flaw----\n"
"-<b>FLAW</b>---"
msgstr ""
".........넌....\n"
"         .........결함이다............\n"
"...<b>결함</b>........."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Lae'zel
#. NodeID = 22d0ee93-73fe-4741-87d7-d78b6007eac1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_LAEZEL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:22d0ee93-73fe-4741-87d7-d78b6007eac1
msgctxt "h1e950081g9383g45b4gb7f5g42709d837889"
msgid "No. Pull away. Pull away!"
msgstr "안 돼. 빠져나가. 물러서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 23b9ce5b-525c-cdda-24a9-f2b2dab19713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:23b9ce5b-525c-cdda-24a9-f2b2dab19713
msgctxt "h06f24905ge47fg4fb9ga6bbg1fe8e0c2f676"
msgid "I've been here before?"
msgstr "내가 여기 온 적이 있었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Wyll
#. NodeID = 248e6e60-4bc3-465b-9a4b-a7a9179444c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:248e6e60-4bc3-465b-9a4b-a7a9179444c8
msgctxt "h678ecfd0gb8eeg43f5gb40fga8f8e76f12b1"
msgid "I can feel it... looking. Deep inside..."
msgstr "느껴져... 날 보고있어. 깊은 내면까지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Astarion
#. NodeID = 2702001b-0e42-4a3c-dc42-6b681096f1dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:2702001b-0e42-4a3c-dc42-6b681096f1dc
msgctxt "h12ad2064gc5d8g446ag85a9ge443fc5cf943"
msgid ""
"Oh, thank goodness. I was worried I'd have to get involved. Now let's keep "
"our hands to ourselves, hmm?"
msgstr "오, 정말 다행이야. 내가 끼어들어야 하나 걱정했는데. 이제 아무거나 만지지 말자구, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Gale
#. NodeID = 30a12646-a929-ea93-72c7-ec89a470406b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:30a12646-a929-ea93-72c7-ec89a470406b
msgctxt "h876759efg5811g4b9egbba9gbc31ee4fc34e"
msgid "Well, now that we know what it is, I suggest we leave it well alone."
msgstr "뭐, 그래도 저게 뭔지는 알았군, 긁어 부스럼 만들지 말자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 32397d5e-9e5d-ab6e-4de0-e2311d35252e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:32397d5e-9e5d-ab6e-4de0-e2311d35252e
msgctxt "h48313b90ge4eeg4dbbgaeb4g50706628594d"
msgid "Who are 'they'?"
msgstr "'그들'이 누군데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 3683d2d9-b2d9-28c5-c39c-2f13551a8649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:3683d2d9-b2d9-28c5-c39c-2f13551a8649
msgctxt "hbe96f462g6373g4b53gb539gf31cfd2ebab1"
msgid ""
"<b>This <i>is the voice they have given me. To better speak to your kind "
"without breaking you.</i></b>"
msgstr "<b>이것은 <i>그들이 나에게 준 목소리이다. 너와 같은 종족들을 망가뜨리지 않고도 대화하려면 이 편이 낫겠지.</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Wyll
#. NodeID = 380e9476-d131-7a4b-9984-1c226cf4d547
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:380e9476-d131-7a4b-9984-1c226cf4d547
msgctxt "h43cc2b10g53ddg4a56g81f8g1e7f751569fc"
msgid ""
"I appreciate a wandering hand now and again, but maybe control your urges "
"for now."
msgstr "아무거나 쑤셔보는 거 가끔은 괜찮은데, 지금은 그 충동을 좀 조절해야 하지 않을까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = 385b4848-93df-9173-4265-5ea2b6942288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:385b4848-93df-9173-4265-5ea2b6942288
msgctxt "h95fd1ed0g296dg42f1gaba8gc909dcd38da4"
msgid ""
" -Gave- \n"
"---us-  -<b>EVERYTHING</b>---\n"
"         ---<b><i>disappeared</i>--</b>"
msgstr ""
" -주었다- \n"
"---우리에게-  -<b>모든 것을</b>---\n"
"         ---<b><i>사라졌다</i>--</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = 3b113619-a25b-8ad0-a5eb-00ec7a9d8a2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:3b113619-a25b-8ad0-a5eb-00ec7a9d8a2b
msgctxt "hc316fae1g62e9g458fgba0dg2a94a7946fed"
msgid ""
"              -FALLEN--\n"
"<b>-ONE--\n"
"      --returns-</b>"
msgstr ""
"              -타락한--\n"
"<b>-존재--\n"
"      --돌아온다-</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 3d09fc2a-409d-cad7-aec8-eedb00f5838a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:3d09fc2a-409d-cad7-aec8-eedb00f5838a
msgctxt "h95d67bb3gb563g4aecga87bg6c553503371e"
msgid ""
"<b><i>You abandoned me... You left me the slave of the puny Chosen, used to "
"bind this world...</i></b>"
msgstr ""
"<b><i>네가 날 버렸어... 하찮은 선택받은 자의 노예가 되어 세상을 속박하는 데 이용당하도록 내버려 두었지...</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 45011e45-f61e-d1da-a158-3e9eea43fa80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:45011e45-f61e-d1da-a158-3e9eea43fa80
msgctxt "hc94b7485gdee2g43d1ga213g475198c9af69"
msgid "I don't care about any design. I just want to be free of the tadpole."
msgstr "설계 따위는 관심없어. 올챙이한테서 자유롭고 싶을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 45b750ff-e16b-4b92-dbe5-9d51bd8f6d2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:45b750ff-e16b-4b92-dbe5-9d51bd8f6d2f
msgctxt "hc3aa6c31g79b1g4dcfgae85g4125e280106c"
msgid ""
"*A world away, the grip on you tightens - a desperate, drowning thing that "
"pulls you down with it.*"
msgstr "*완전히 다른 세상의 것이 당신을 더욱 단단히 조여옵니다. 필사적으로 당신을 삼키려는 듯 아래로 잡아당깁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 45c6596b-b626-b862-5d5b-82fc659244c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:45c6596b-b626-b862-5d5b-82fc659244c6
msgctxt "h82c1c34fge9f1g4372gb5a5ge1e45b38dcd5"
msgid ""
"*There is no hesitation this time - the tendrils lash out like a waiting "
"predator.*"
msgstr "*이번엔 망설이지 않습니다, 촉수는 매복하고 있던 포식자와 같이 맹렬하게 튀어나옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Shadowheart
#. NodeID = 46f258b6-1dda-9e1d-995e-a5e1b63fbe1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:46f258b6-1dda-9e1d-995e-a5e1b63fbe1c
msgctxt "h7e9a7d71g7170g4d77g8947g3607f10ae26a"
msgid "You're free... The Absolute must be keen to meet us."
msgstr "넌 자유야... 절대자는 분명 우릴 만나고 싶어 안달 났겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Karlach
#. NodeID = 49d4b054-990f-c351-a2d7-8b5019ecc16a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:49d4b054-990f-c351-a2d7-8b5019ecc16a
msgctxt "ha8cb6e3eg892eg45acg9a6eg2d6c17cca338"
msgid ""
"The Absolute fairly ripped your hand off. That's no way to tempt us into a "
"meeting."
msgstr "절대자가 네 손의 아주 뜯어버릴뻔 했네. 그런 식으로는 우리를 오라고 유혹할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 4b067925-8752-8dd8-54d9-7d73e0ab273f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:4b067925-8752-8dd8-54d9-7d73e0ab273f
msgctxt "hb422c8cfg3693g481cgb2a3g03eb15d4e9f3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Shadowheart
#. NodeID = 4d249710-bd28-42de-affb-2519739d2e65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:4d249710-bd28-42de-affb-2519739d2e65
msgctxt "h0bcb7277g60c2g485cg8334g694dfb5762bd"
msgid "Gods. What is it? <i>What now?</i>"
msgstr "신이시여. 저게 뭐지? <i>이번엔 뭐지?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = GROUP_Daisy
#. NodeID = 4db26f4c-0247-f7f5-efbe-a175314bb471
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:4db26f4c-0247-f7f5-efbe-a175314bb471
msgctxt "h16f2c79ege548g4280g84a3g781473bf2e3a"
msgid "It almost had you. You did well to pull away from it."
msgstr "거의 잡힐뻔 했어요. 잘 빠져 나왔습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = GROUP_Daisy
#. NodeID = 4db26f4c-0247-f7f5-efbe-a175314bb471
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:4db26f4c-0247-f7f5-efbe-a175314bb471
msgctxt "hae3d3bdagdbf1g46a4g8b96g4860772bd49d"
msgid "It almost had you. You did well to pull away from it."
msgstr "거의 잡힐뻔 했어요. 잘 빠져 나왔습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 50192d12-2430-0126-74f7-10d7fbb76af9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:50192d12-2430-0126-74f7-10d7fbb76af9
msgctxt "hc37b0b88g062ag49d0gabc4gb0d895d89ba2"
msgid "You first."
msgstr "너 먼저."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 570fde23-08c1-8bbe-0297-4989a774a726
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:570fde23-08c1-8bbe-0297-4989a774a726
msgctxt "hb5977669gff28g4ed7gad97gf6ff0ab19ab6"
msgid "<b><i>I am the chain they will use to bind this world...</i></b>"
msgstr "<b><i>난 그들이 세상을 속박할 때 사용할 사슬이지...</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 578be51b-aefe-eb89-a584-473bfcbfe8c5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 16
#. TagRule: ROGUE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:578be51b-aefe-eb89-a584-473bfcbfe8c5
msgctxt "he7f4c122g949bg4200gb5cbg9c314f8806c0"
msgid "<i>You've been in tougher traps - wriggle your hand free.</i>"
msgstr "<i>더한 함정에 걸린적도 있다, 손을 움직여 빼낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 578be51b-aefe-eb89-a584-473bfcbfe8c5
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 16
#. TagRule: RANGER
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:578be51b-aefe-eb89-a584-473bfcbfe8c5
msgctxt "hfed24205g3d78g45c6g8038g33c0f18ca36f"
msgid "<i>Calm yourself and gently wriggle your hand free.</i>"
msgstr "<i>진정하고 부드럽게 움직여 손을 빼낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 578be51b-aefe-eb89-a584-473bfcbfe8c5
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 16
#. TagRule: MONK
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:578be51b-aefe-eb89-a584-473bfcbfe8c5
msgctxt "h1cd570c6ge0a4g4affg84aag40579dd2fe59"
msgid "<i>Twist your wrist to break the grip.</i>"
msgstr "<i>손목을 비틀어 속박을 망가뜨린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 5db072fd-8170-bf58-d82d-de41a4c7d88b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:5db072fd-8170-bf58-d82d-de41a4c7d88b
msgctxt "h93429f29gdde4g4d61g838cgbc6ac39cf584"
msgid ""
"*With a soft sucking sound, your hand pulls free. The flesh within the wall "
"retreats.*"
msgstr "*부드럽게 빨아들이는 소리와 함께, 당신의 손이 자유로워 집니다. 벽 속의 촉수가 후퇴합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 5facb5c2-9c16-bf56-18ef-111fd3138e6a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:5facb5c2-9c16-bf56-18ef-111fd3138e6a
msgctxt "hc38fd559gdcc4g4c15g8c6cg54533d5fddbf"
msgid "<i>Channel your oath. Rebuke the voice. Free yourself.</i>"
msgstr "<i>맹세를 떠올려, 목소리를 몰아낸다. 자유를 되찾는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 613c2047-e4c1-0241-42af-42f4c9724d4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:613c2047-e4c1-0241-42af-42f4c9724d4b
msgctxt "h259d854bgad81g4befg9b3bg6607212ce326"
msgid ""
"*Your awareness <i>unfolds</i>, expanding through every wall in the tower - "
"every <i>mind</i>.*"
msgstr "*당신의 의식이 <i>펼쳐지며</i>, 이 탑에 있는 모든 벽, 모든 <i>정신</i>으로 확장됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Gale
#. NodeID = 626b406c-ce00-4f7f-845e-f5d4fbcd1c22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:626b406c-ce00-4f7f-845e-f5d4fbcd1c22
msgctxt "h13484885gc4bcg44a5ga332g540550c1735b"
msgid "What in the hells is <i>that</i>?"
msgstr "도대체 <i>저게</i> 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Lae'zel
#. NodeID = 6485d7dd-c75c-5b7d-e49c-1bac7b30ff9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_LAEZEL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:6485d7dd-c75c-5b7d-e49c-1bac7b30ff9c
msgctxt "h74ce012ag8f0fg4806g936cgabb76bc52cd0"
msgid "What is wrong with you? Pull. Away!"
msgstr "뭐하고 있는 거야? 당겨. 빼내!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 65ae9136-d9cb-838e-b6b2-44f9c062a271
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK_GREAT_OLD_ONE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:65ae9136-d9cb-838e-b6b2-44f9c062a271
msgctxt "h99973bf0ga1eag4251g9df4ga478bfcafef0"
msgid "<i>Invite the presence in. There's always room for one more. </i>"
msgstr "<i>그 존재를 받아들인다. 하나 더 들어올 공간은 언제나 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 67b003b5-7653-3823-27be-5c5dd82bb3f1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:67b003b5-7653-3823-27be-5c5dd82bb3f1
msgctxt "h6c3dd17cg8e37g4772gb4e7ga41b2f44b7b8"
msgid "<i>Heave against the tentacle with all your might.</i>"
msgstr "<i>온 힘을 다하여 촉수를 끌어당긴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Shadowheart
#. NodeID = 6e0f1037-ecc4-9222-bff9-7f122e5a26df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:6e0f1037-ecc4-9222-bff9-7f122e5a26df
msgctxt "h6e6fd7d3g5d02g4d0cgb94cg6ec319d087ec"
msgid "Enough! Break off from that <i>thing</i>!"
msgstr "그만! 당장 <i>거기서</i> 떨어져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 6fcd2a5a-302c-de9a-ff1a-236eb530baf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:6fcd2a5a-302c-de9a-ff1a-236eb530baf4
msgctxt "h620568d1g5b3dg4169g890bg68f691f57375"
msgid ""
"<b><i>You were the jewelled hope for their design, but now you are their "
"flaw.</i></b>"
msgstr "<b><i>그들의 설계에서 넌 보석같은 희망이었지, 하지만 지금은 결함이 되었다.</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 70bb225f-ca1a-2064-916a-f309315c5138
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:70bb225f-ca1a-2064-916a-f309315c5138
msgctxt "hcc1cd1c6gb80eg4712g842fg541df02446ba"
msgid "<i>Submit. Become.</i>"
msgstr "<i>항복한다. 몸을 맡긴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 756a48ce-70bd-45c3-57fd-0180fe8d7e32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_WallTentacle_HasMet_Tentacle(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:756a48ce-70bd-45c3-57fd-0180fe8d7e32
msgctxt "h4f412170g4f68g4b87g99ebg9caeca2578b1"
msgid ""
"*Again, the sickening slither of flesh on stone - barely an arm's-length "
"away.*"
msgstr "*다시 한 번, 팔만 뻗으면 닿을 거리에 소름 끼치는 살점이 미끄러지듯 벽돌을 타고 지나갔습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 762b7287-9348-d05e-39f8-3b6ad3af9bee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:762b7287-9348-d05e-39f8-3b6ad3af9bee
msgctxt "h9c4a994ag8337g4d43ga4a6g41a23834ef23"
msgid ""
"--not out---\n"
"    <b>-inward--\n"
"-</b>-you are here - here is you--"
msgstr ""
"--밖이 아니---\n"
"    <b>-안으로--\n"
"-</b>-너는 여기 있다 - 이곳이 너다--"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Karlach
#. NodeID = 7d119fa9-b037-a7ba-e866-08d9fbd74a9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:7d119fa9-b037-a7ba-e866-08d9fbd74a9e
msgctxt "he7046acfg5edag4736gbf1agb059a7de91b5"
msgid "Hello?! Hey! Snap out of it!"
msgstr "어이?! 야! 정신 차려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 7d786ebb-7192-401b-0f77-92315f528f31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:7d786ebb-7192-401b-0f77-92315f528f31
msgctxt "h2e0039e3g87c5g4f11g81ccg28f850827ca9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 7db263b6-825a-7abf-91af-d27927283caf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_WallTentacle_HasMet_Tentacle(2) = True
#.   Global:
#.      - MOO_WallTentacle_Knows_Tentacle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:7db263b6-825a-7abf-91af-d27927283caf
msgctxt "h57d95ddag718cg4f22gaa40g91ded52c9211"
msgid "*The tentacle pulses within the wall, waiting.*"
msgstr "*촉수가 벽 속에서 맥박을 뛰며 기다립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Gale
#. NodeID = 819e271f-67c2-ee2b-80b8-23f6e2533225
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:819e271f-67c2-ee2b-80b8-23f6e2533225
msgctxt "hc5a22119ge6e9g493bg8316g0d2114afbf8f"
msgid "Enough of this - release yourself!"
msgstr "이 정도면 충분해, 모습을 드러내라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 8532a79f-297e-f807-c98f-04c109dec433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:8532a79f-297e-f807-c98f-04c109dec433
msgctxt "hbb18517eg501fg4750ga6feg421839e19c05"
msgid ""
"<b><i>There is no freedom. They will use me to bind the world in "
"chains...</i></b>"
msgstr "<b><i>자유같은 건 없다. 그들이 세상을 속박하는 데 날 사용할테니까...</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = 857f07cf-8d0b-2bd4-448c-6823fc8b8672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:857f07cf-8d0b-2bd4-448c-6823fc8b8672
msgctxt "hf1c872fcg0bd6g4b4eg9e77g90a460651e40"
msgid ""
"               --I am----\n"
"-<b>WE ARE</b>-"
msgstr ""
"               ......난............\n"
"...<b>우리는</b>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = 8644ad45-08cb-3ce3-3483-f0d9401cba2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:8644ad45-08cb-3ce3-3483-f0d9401cba2b
msgctxt "ha0d9c478g679ag4ea6g86f5gbbdda3e18d1d"
msgid ""
"              --killer-- \n"
"<b>-KIN-\n"
"      -who </b>are you---<b>-</b>"
msgstr ""
"              ......살인자...... \n"
"<b>...동족...\n"
"      ...넌 </b>누구 냐.........<b>-</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Wyll
#. NodeID = 875c0c6d-6e0b-b207-4d74-bf29dd72cd8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:875c0c6d-6e0b-b207-4d74-bf29dd72cd8c
msgctxt "h2a7e211bgf328g489dg9550g84567db982b4"
msgid "Was - was that Her? The <i>Absolute</i>?"
msgstr "그, 그자 였어? <i>절대자</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Lae'zel
#. NodeID = 87f00a29-b683-9ed8-6b56-3040d20f95a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_LAEZEL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:87f00a29-b683-9ed8-6b56-3040d20f95a1
msgctxt "h694f4228g241fg411bg8e13g02dc39c426b2"
msgid ""
"Keep your hands to yourself. Every last crevice of this tower could be... "
"infected."
msgstr "아무거나 손대지 마라. 여기 있는 틈 전부가... 오염되었을 수도 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 8845a84a-2889-a154-b1fc-9ed04ede0e81
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:8845a84a-2889-a154-b1fc-9ed04ede0e81
msgctxt "hd020004fg1b9cg4aaega61bgb173b468ff0e"
msgid "<i>Tear your arm out of the tentacle's grip.</i>"
msgstr "<i>촉수에 잡힌 팔을 빼낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 8c785d8b-d455-2610-d563-2a6ab3c6047e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Knows_Tentacle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:8c785d8b-d455-2610-d563-2a6ab3c6047e
msgctxt "h5b08f111g0df9g4fd7g8e3dg0bb15a3b2d69"
msgid ""
"*You can't quite catch a glimpse, but you recognise this feeling - the same "
"alien presence you felt on the nautiloid.*"
msgstr "*당신이 정확하게 보지는 못했지만, 그 느낌은 알아차립니다, 노틸로이드에서 이 같은 외계의 존재를 느껴본 적이 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 8d219753-3c01-76d8-004f-80b9970d227e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:8d219753-3c01-76d8-004f-80b9970d227e
msgctxt "h0fd96344gfc9cg4bf8ga713gf1a86aeb95a1"
msgid "'Dark Urge' - what does it mean?"
msgstr "'어두운 충동'... 그게 무슨 뜻이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 9050c7c5-8d73-1b33-d874-7f01561b4faf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:9050c7c5-8d73-1b33-d874-7f01561b4faf
msgctxt "h4be3558ag33c4g42ddg90a0g69482a4cd8bd"
msgid "What do you mean I'm the flaw?"
msgstr "내가 결함이라니 무슨 뜻이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Astarion
#. NodeID = 935ce3e3-77b8-457d-9bf3-52226b6604ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:935ce3e3-77b8-457d-9bf3-52226b6604ad
msgctxt "h93ace654gabcfg4259ga293g0be10fa82436"
msgid "What in the hells - oh no. Not again."
msgstr "저건 도대체... 이런 안 돼. 또다시 이럴 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 99e822fa-5d41-b35d-0bc9-7b265ff946f3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:99e822fa-5d41-b35d-0bc9-7b265ff946f3
msgctxt "h5b3c2b7fg4a71g4ea8gaf5ag36a35f937176"
msgid "<i>Channel all your rage - and pull.</i>"
msgstr "<i>모든 분노를 표출하여, 끌어당긴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = a0decc04-109a-3685-168a-a321d2c658e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:a0decc04-109a-3685-168a-a321d2c658e2
msgctxt "h90fcd088gde44g43d3g83e6gadc3cde783e9"
msgid ""
"*You stop resisting, your arm bending with the movement of the flesh. And "
"suddenly, an opening appears.*"
msgstr "*당신은 저항하는 걸 멈추고, 촉수의 움직임에 따라 팔을 움직입니다. 그러던 순간, 빈틈이 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Gale
#. NodeID = a39a658b-537a-da53-bfcb-f3f11d6206f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:a39a658b-537a-da53-bfcb-f3f11d6206f7
msgctxt "h24aca7fbgd431g4174gb796g5bac4d70f4a2"
msgid ""
"Well, you've certainly piqued the interest of the Absolute. Though I can "
"think of at least a dozen gods I'd rather meet."
msgstr "이런, 절대자의 관심을 아주 확실히 끌었군. 물론 절대자보다 만나고 싶은 다른 신들 이름을 열 개는 넘게 댈 수 있지만 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = a4e0ab52-1dbb-2249-f73d-e058185a3daa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_WallTentacle_State_FailedExamine(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:a4e0ab52-1dbb-2249-f73d-e058185a3daa
msgctxt "h8d16bd4bg693ag48c1gafa5g83663e31b6c4"
msgid ""
"*You almost catch a glimpse, but the darkness within the wall is too deep.*"
msgstr "*당신은 거의 알아차릴 뻔 했으나, 벽 속의 어둠이 너무 깊습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Astarion
#. NodeID = a8b353d2-0a67-a596-dd40-5ab56a16336f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:a8b353d2-0a67-a596-dd40-5ab56a16336f
msgctxt "h5bb7271dg7bd7g4826gb552g693103bdf8b5"
msgid "Clingy little shit, this Absolute. And She wants to meet..."
msgstr "끈질긴 쓰레기같은 절대자 자식. 우릴 만나고 싶어 한다라..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = adf0504d-0623-5bf5-d7ed-35657e86f199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:adf0504d-0623-5bf5-d7ed-35657e86f199
msgctxt "hed3ef16agb953g4555g84acg42b0744c11e2"
msgid "<b><i>...but I cannot bind you.</i></b>"
msgstr "<b><i>...하지만 널 속박할 수 없다.</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = ae180e9f-746f-67b3-6dc7-a46ff73fcc6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Knows_Tentacle = True
#.   Object:
#.      - MOO_WallTentacle_HasReachedIn(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:ae180e9f-746f-67b3-6dc7-a46ff73fcc6f
msgctxt "h9371e308gf721g4ee6g880dg26647f68cfae"
msgid "*The tentacle pulses within the wall, waiting.*"
msgstr "*촉수가 벽 속에서 맥박을 뛰며 기다립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = aef044d8-497d-ea8b-7ca9-58019e8ae806
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:aef044d8-497d-ea8b-7ca9-58019e8ae806
msgctxt "h43c3f267g3ee7g4425gb468g1faa51b177d7"
msgid "Show yourself. What are you really?"
msgstr "정체를 밝혀라. 진짜 넌 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = b14dba26-179f-532d-87fd-2cf75e526cad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:b14dba26-179f-532d-87fd-2cf75e526cad
msgctxt "h477df639g227dg4a56gba0eg3d4bbe9e9ec6"
msgid "You... <i>revere </i>me?"
msgstr "네가... 나를 <i>높이는 </i>건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = b4a2a051-5919-a83d-3345-57cec9e6dce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:b4a2a051-5919-a83d-3345-57cec9e6dce3
msgctxt "h4b142a75g466fg44b1ga5cbga7d0c3ec6c9a"
msgid "<i>Reach back in.</i>"
msgstr "<i>다시 손을 뻗는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = b62b9d6c-9ed0-a84d-1f1d-8a11d4ca4020
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:b62b9d6c-9ed0-a84d-1f1d-8a11d4ca4020
msgctxt "h38232f1bgb85eg4853g9fefgfec5fa110c8d"
msgid ""
"<b><i>Come. Become. </i>\n"
"\n"
"-COME- \n"
"               -BECOME-</b>"
msgstr ""
"<b><i>와라. 되어라. </i>\n"
"\n"
"...와라... \n"
"               ...되어라...</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = b9efb99e-609d-21df-46c3-13758081d050
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:b9efb99e-609d-21df-46c3-13758081d050
msgctxt "h2e9668efga158g4b28g94bagb12a19256f08"
msgid ""
"-other-\n"
"             -else-\n"
"                          -<b>ABERRATION</b>?-"
msgstr ""
"...다른...\n"
"             ...아니면...\n"
"                          ...<b>변이</b>?..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = bc333ad6-c3dd-fd6d-8520-0d43dd8c35f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:bc333ad6-c3dd-fd6d-8520-0d43dd8c35f5
msgctxt "hcabff298g007bg4d11ga1b7g33355da60d5b"
msgid "Take me out of here. Now."
msgstr "날 여기서 내보내줘. 당장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = bc41a0aa-40ad-b85a-b85b-2e24bfc5469d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:bc41a0aa-40ad-b85a-b85b-2e24bfc5469d
msgctxt "h382cfad9g4e06g49aaga238gd5d4eac7d378"
msgid "<b><i>You must come to me - so I can become myself again.</i></b>"
msgstr "<b><i>넌 반드시 나에게 와야 한다, 내가 다시 본모습을 찾을 수 있도록.</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = be181e91-08db-535f-332a-d1988e6e859b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_State_HadVoiceOfAbsoluteEvent = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:be181e91-08db-535f-332a-d1988e6e859b
msgctxt "h75768871g561ag4797g87eegbe878be78fe2"
msgid "I know your voice. You're the Absolute."
msgstr "그 목소리는 알고 있어. 네가 절대자로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = c3cf2d51-9325-703e-ce1b-9c49a9baf401
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:c3cf2d51-9325-703e-ce1b-9c49a9baf401
msgctxt "h91bf72fcg2ac3g4520g8ea4gbf73102df67b"
msgid "<i>Go limp and ride it out.</i>"
msgstr "<i>몸을 축 늘어뜨리고 견뎌낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = c4cdc315-5777-4a44-ad5c-65a267670d4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:c4cdc315-5777-4a44-ad5c-65a267670d4d
msgctxt "h6c86d7cfgf6fcg4c9agb6b3g652117bbc81f"
msgid ""
"*A pause, as if it struggles to compress its vast being down into terms you "
"can understand.*"
msgstr "*잠시 침묵이 흐릅니다, 마치 자신의 광대함을 당신이 이해할 수 있을만한 용어로 압축하려 애쓰는 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Astarion
#. NodeID = cbe70d5f-d70e-9b16-2589-537746893755
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:cbe70d5f-d70e-9b16-2589-537746893755
msgctxt "h62aa8937gee5ag4d93g9045g40138b2e2fe5"
msgid "What's happening? Speak to me. Wake up!"
msgstr "무슨 일이 벌어지고 있는 거야? 말 좀 해봐. 일어나!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = cd8336d0-58d6-b969-d93e-6bf5c9ea65eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:cd8336d0-58d6-b969-d93e-6bf5c9ea65eb
msgctxt "h5756fb03gfb9eg4467gbe55gcac108b51688"
msgid "-<b>YOU!</b>-"
msgstr "...<b>너!</b>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Astarion
#. NodeID = ce03585c-96aa-eb3d-61c8-670fd4da67a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:ce03585c-96aa-eb3d-61c8-670fd4da67a1
msgctxt "h6eb4ee24g8cd8g4848gba03g7898444b5113"
msgid "Thank goodness - I was almost worried."
msgstr "하 다행이야 - 거의 걱정할 뻔했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = cf16a59f-b4ae-68b4-70c6-4195f9f1148e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:cf16a59f-b4ae-68b4-70c6-4195f9f1148e
msgctxt "hca53f8f6g90d6g4473g8c39g8027a0dc4626"
msgid ""
"<b><i>They name themselves 'Chosen', but they are </i>slavers<i>. They will "
"use me to bind this world...</i></b>"
msgstr ""
"<b><i>그들은 스스로를 '선택받은 자'라고 부르지만, 그 녀석들은<i> 노예를 부리는 자</i>에 불과하다. 나를 이 세계를 속박하는 "
"데 사용하려 한다...</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = d0896b78-bba6-8fa4-92d8-b03e15f90a0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_WallTentacle_State_IsDestroyed(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:d0896b78-bba6-8fa4-92d8-b03e15f90a0a
msgctxt "he6952de8g221dg4227gb8ecgb163e56f810e"
msgid ""
"*The sound of flesh echoes from further away - retreated beyond your reach.*"
msgstr "*살갗이 부딪히는 소리가 멀리서 울리더니, 닿지 않는 곳으로 물러갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = d17a1971-7ff8-c90d-9b3d-4f9ac4189c58
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Tentacle_EnteredVoid = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:d17a1971-7ff8-c90d-9b3d-4f9ac4189c58
msgctxt "he99a90ceg2569g4cfegb294g50fa09fafb64"
msgid "*The tendrils <i>tighten</i>, and suddenly you are... elsewhere.*"
msgstr "*촉수가 <i>단단히 조여지더니</i>, 갑자기... 어딘가 다른 곳에 존재합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Wyll
#. NodeID = d2c536b2-073a-f489-8d54-8df645b67075
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:d2c536b2-073a-f489-8d54-8df645b67075
msgctxt "hbea164dfge004g4c39g9e2ag6290fd6307f4"
msgid "Come on, chief - get a hold of yourself!"
msgstr "이봐, 대장! 정신 차려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = e234d44e-d329-fae4-93d8-b6a1c1382935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:e234d44e-d329-fae4-93d8-b6a1c1382935
msgctxt "ha495cbd6g6044g48edg8c64gfeca59851fb3"
msgid ""
"---<b>KINGMAKER</b>--        ---returns-\n"
"             -<i>pawn</i>----"
msgstr ""
"---<b>킹메이커</b>--        ---돌아온다-\n"
"             -<i>잡혀있다</i>----"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = e2911701-aa15-2888-40b7-9f1d3d5aa7a2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:e2911701-aa15-2888-40b7-9f1d3d5aa7a2
msgctxt "h957d81f2g636bg42eeg89d6gf41a9befc7ec"
msgid "<i>Focus your thoughts to an edge - and cut free.</i>"
msgstr "<i>집중력을 최대한으로 끌어올려 끊어낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = e5cc9404-a5d9-b80f-dd47-5c357711a862
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:e5cc9404-a5d9-b80f-dd47-5c357711a862
msgctxt "hb106fec5g646bg437bgb1f7g1efc26db86d7"
msgid "I am not your kin, <i>ghaik</i>-spawn."
msgstr "난 네 동족이 아니다, <i>게이크</i> 스폰."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = e6862067-18d5-86f0-d274-a2d33d204d08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:e6862067-18d5-86f0-d274-a2d33d204d08
msgctxt "h66633e79gf770g4b70g8d90g67960e18678b"
msgid "I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = GROUP_Daisy
#. NodeID = e891e521-4e72-402d-8566-cc9f785fc455
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:e891e521-4e72-402d-8566-cc9f785fc455
msgctxt "h0fbf66cegaeebg4222ga9f3g7e3d03645bf7"
msgid "It's a trap!"
msgstr "함정이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = GROUP_Daisy
#. NodeID = e891e521-4e72-402d-8566-cc9f785fc455
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:e891e521-4e72-402d-8566-cc9f785fc455
msgctxt "h4c30bc93gf977g4f5fg9ae8g8d1b54c9a803"
msgid "It's a trap!"
msgstr "함정이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = ec345265-ff64-92c3-4c56-26f5b16639ad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 16
#. TagRule: !(MONK and RANGER and ROGUE)
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:ec345265-ff64-92c3-4c56-26f5b16639ad
msgctxt "h6875eca6gca7ag4609g9a6cg9f73db72bf5c"
msgid "<i>Wriggle your hand free.</i>"
msgstr "<i>손을 움직여 빼낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = ed7efb38-63bf-35b0-e4be-a001a2fb10b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:ed7efb38-63bf-35b0-e4be-a001a2fb10b9
msgctxt "h4f39210ag24a1g47ecg8bfag2d9aa1ff6a56"
msgid ""
"*A coiling, restless void stirs within you. Your patron. For some reason, "
"this thing in the wall <i>excites</i> it.*"
msgstr ""
"*당신 안에 자리 잡은 무언가가 꿈틀거립니다. 머릿속에 있는 손님이네요. 왠지 모르게 벽 안에 있는 존재에 올챙이가 <i>반응하고</i> "
"있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = f389cd2f-666f-7a37-4473-47e2111a8046
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Knows_Tentacle = False
#.   Object:
#.      - MOO_WallTentacle_State_FailedExamine(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:f389cd2f-666f-7a37-4473-47e2111a8046
msgctxt "he55fa7f3g7295g43a7ga603g69c5bb69986a"
msgid "<i>Determine what it is.</i>"
msgstr "<i>무엇인지 알아낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = f71545fe-7c95-9ca0-7cba-3a5eaaa293a8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_WallTentacle_HasMet_Tentacle(2) = True
#.   Global:
#.     - MOO_WallTentacle_Knows_HasSeenMeat = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:f71545fe-7c95-9ca0-7cba-3a5eaaa293a8
msgctxt "h095f5dabge6d2g4c37gb751gf4c2150f2635"
msgid ""
"*Through a narrow crack in the wall, you hear something <i>shift </i>against "
"stone. The pulse of a crawling, living thing.*"
msgstr "*벽의 좁은 틈을 통해서, 무언가 돌을 <i>지나다니는</i> 소리가 들립니다. 기어다니는 생명체의 맥박입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = f76ab3c9-59f3-82ec-f8bd-7665e7d074af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:f76ab3c9-59f3-82ec-f8bd-7665e7d074af
msgctxt "h2b4a9235g2688g4e1ag88d1g314073be8a4a"
msgid ""
"<b><i>I was once a servant of the Grand Design. Now I am slave to </"
"i>theirs<i>. But you...</i></b>"
msgstr "<b><i>난 한때 원대한 설계의 종복이었다. 지금은 </i>그들의<i> 노예지. 하지만 넌...</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = f7a78520-4c5e-92a0-2fc1-55f01a079ea6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:f7a78520-4c5e-92a0-2fc1-55f01a079ea6
msgctxt "h9d792f14g431bg4299g8635g3e660b6a1ed3"
msgid ""
"-child---      <i>-enemy--\n"
"</i>             --of-      <i>----hunter-\n"
"</i>                         -<b>GITH</b>--      <b><i>----SLAYER-</i></b>"
msgstr ""
"...아이......      <i>...사냥꾼......\n"
"</i>             ......의...      <i>............적...\n"
"</i>                         ...<b>기스</b>......      <b><i>............"
"살해자...</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = fb7ad9d8-b103-c56d-6048-06612990ec6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:fb7ad9d8-b103-c56d-6048-06612990ec6d
msgctxt "h89828a35g1799g474ag9af3g8e8455663e0b"
msgid "<i>Do nothing.</i>"
msgstr "<i>가만히 있는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = fbad7220-39fb-d9a6-47c1-50ca071f90e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_WallTentacle_HasReachedIn(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:fbad7220-39fb-d9a6-47c1-50ca071f90e8
msgctxt "h88e352abg940eg47c8gb6f1g47981d542b4c"
msgid "<i>Reach in.</i>"
msgstr "<i>손을 넣는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = ff785d81-8108-9e86-6056-408402d0fc3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:ff785d81-8108-9e86-6056-408402d0fc3c
msgctxt "hb0c7a953gd029g4929g8685gf8f2de2d6188"
msgid ""
"*A vast, living network, extending down into the dark - where something "
"wakes.*"
msgstr "*아주 광활하고, 살아있는 망이 어둠 속으로 뻗어갑니다, 거기서 뭔가가 깨어납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = ffc01903-212c-e7c1-d17d-c800b5bdf12c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeUnarmedAttack
#. RollAbility:
#. DifficultyClass: 0
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:ffc01903-212c-e7c1-d17d-c800b5bdf12c
msgctxt "h03280e1egc576g4c9bg88dbg35a4be8f73d9"
msgid "<i>Forget subtlety - claw at whatever you can reach.</i>"
msgstr "<i>머리 굴리는 건 집어치우고, 손에 닿는 건 뭐든 할퀸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Shadowheart
#. NodeID = ffeb9dd7-2a58-1960-777d-9a78fc33762d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:ffeb9dd7-2a58-1960-777d-9a78fc33762d
msgctxt "hf6f99df0gb17eg4446g88f6gf8f578b928b2"
msgid ""
"Careful, in future - you can't just stick your hand in every strange hole "
"you come across."
msgstr "앞으로는 조심해. 수상한 구멍이랍시고 아무데나 쑤셔대다간 손이 남아나지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Soreni
#. NodeID = 1248d9ec-3287-4796-be69-4799f6771bf4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 72f2c4d8-2c3a-dabb-8c0b-993a1b018dbd_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:1248d9ec-3287-4796-be69-4799f6771bf4
msgctxt "h821db901gfa49g478bg95degc86a10a26f40"
msgid "You ought to be kinder, you know. To the prisoners, I mean."
msgstr "좀 더 친절해야 해. 죄수들한테 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Zira
#. NodeID = 1d7538d3-644f-694d-70dd-63f3fe51dc07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:1d7538d3-644f-694d-70dd-63f3fe51dc07
msgctxt "h847309c0gdc78g4eb7g92b4g498fd5b1e91c"
msgid ""
"Ugh. Then I shall have to keep them busy praying for mercy from <i>other</i> "
"gods, won't I?"
msgstr "으. 그럼 놈들이 <i>다른</i> 신들에게 자비를 빌도록 만들어줘야겠군?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Soreni
#. NodeID = 424473f9-37ad-2a41-4079-bad20f4c4e68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:424473f9-37ad-2a41-4079-bad20f4c4e68
msgctxt "h68ca7cd3gf91dg46f4g9f78g585a1f9cabfb"
msgid "I am not."
msgstr "아니거든. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Soreni
#. NodeID = 4c5fa2bf-e0e1-f487-492e-1b92df236dc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:4c5fa2bf-e0e1-f487-492e-1b92df236dc8
msgctxt "hef352da2gd6a9g4631g9275g2cc66dc804f1"
msgid ""
"Oh, of course! Perhaps our prisoners can be your bearers. A fine view from "
"gnome-back, I expect."
msgstr "오, 그러시겠지! 우리 죄수들이 널 들어줄지도 모르지. 노움 등 위에서 경치가 아주 좋겠구먼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Zira
#. NodeID = 63c11d79-0a27-5901-dac9-f381eeb19413
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:63c11d79-0a27-5901-dac9-f381eeb19413
msgctxt "h7f544457g6c92g4417g86b8g58d912dfc71e"
msgid ""
"If you think I'm walking all the way to Baldur's Gate without a litter, you "
"don't know me at all."
msgstr "내가 발더스 게이트로 가마 없이 걸어갈 거라고 생각한다면, 넌 날 모르는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Zira
#. NodeID = 867aae8d-97e1-4bbc-8aa5-e619e86b10d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 72f2c4d8-2c3a-dabb-8c0b-993a1b018dbd_A = True
#. SetFlags:
#.   Local:
#.     - 72f2c4d8-2c3a-dabb-8c0b-993a1b018dbd_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:867aae8d-97e1-4bbc-8aa5-e619e86b10d2
msgctxt "h9ea57202g56f1g4218g93b9gdba28904059e"
msgid "You're mistaken, surely."
msgstr "분명히 네가 잘못 생각 한거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Soreni
#. NodeID = b1b900e2-50b5-63e0-74a0-ad57da490b98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:b1b900e2-50b5-63e0-74a0-ad57da490b98
msgctxt "h49e56eddg7d10g429ag88f8g2aedacaea138"
msgid ""
"Any one of them could be elevated to True Soul, should they accept the "
"Absolute."
msgstr "저들 중 누구라도 참된 영혼이 될 수 있어, 절대자님을 받아들인다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Zira
#. NodeID = b92ddb7b-1cb8-4424-9ad4-0120179bc2df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 72f2c4d8-2c3a-dabb-8c0b-993a1b018dbd_B = True
#. SetFlags:
#.   Local:
#.     - 72f2c4d8-2c3a-dabb-8c0b-993a1b018dbd_B = False
#.     - 72f2c4d8-2c3a-dabb-8c0b-993a1b018dbd_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:b92ddb7b-1cb8-4424-9ad4-0120179bc2df
msgctxt "h04a7ed50gafb6g4eb9g9953gf1259a56bddb"
msgid "It is impossible to keep a garment <i>clean</i> down here."
msgstr "여기선 옷을 <i>깨끗하게</i> 유지할 수가 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Soreni
#. NodeID = dae50f3d-a70d-47ae-ec52-fe6bb82e5e47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:dae50f3d-a70d-47ae-ec52-fe6bb82e5e47
msgctxt "he921af9eg418dg4e1ag90dbgd3c7dc5b3d60"
msgid "You'll find it all the harder once we're off on the march."
msgstr "우리가 진군을 시작하면 더 힘들어질걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Soreni
#. NodeID = dcd71714-2be6-a56d-b768-a7fdf597b3d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:dcd71714-2be6-a56d-b768-a7fdf597b3d9
msgctxt "hcb8da97eg8f0ag44f7g9533g230d45f73086"
msgid ""
"And not a single one came back down from the tower-top. Must've been "
"unworthy."
msgstr "그리고 단 한 명도 탑 꼭대기에서 돌아오지 않았지. 그럴 가치가 없는 자들이었나 보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02
#. Speaker = Zealot Zira
#. NodeID = fcec3933-db22-0d9b-56d8-9ed4bb7586ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_AD_Guard01_02:fcec3933-db22-0d9b-56d8-9ed4bb7586ab
msgctxt "he40549aag3908g4b42g82bcged077e065fae"
msgid "But we've seen, what? Five True Souls sent for an audience?"
msgstr "그렇지만 우리가 본 건 뭐야? 절대자님과의 접견을 위해 다섯 명의 참된 영혼을 보냈지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard01
#. Speaker = Zealot Zira
#. NodeID = 3fa32dcd-541f-49e2-a450-439764821e37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard01:3fa32dcd-541f-49e2-a450-439764821e37
msgctxt "h2cb86074g98d4g42c6g87b5ge5d71d1a6ebf"
msgid "I hear we'll be marching west soon. Hope to see you on the front line."
msgstr "곧 서쪽으로 행군할 거라고 들었어. 전방에서 보길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard01
#. Speaker = Zealot Zira
#. NodeID = b3f85c8d-9a56-4f4b-b227-9a1e651b422b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Warehouse_HasMet_Guard01(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Warehouse_HasMet_Guard01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard01:b3f85c8d-9a56-4f4b-b227-9a1e651b422b
msgctxt "hebee9d3fgccdbg4ad5gb4dbg42696c9500f2"
msgid ""
"Don't get too close to the prisoners - they're desperate enough to try "
"anything."
msgstr "죄수들에게 너무 다가가지 마. 무슨 짓을 할 지 모를 정도로 절박한 상태니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard02
#. Speaker = Zealot Soreni
#. NodeID = 34d4cb5c-1d99-417b-8ed3-a5dc28e1841a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard02:34d4cb5c-1d99-417b-8ed3-a5dc28e1841a
msgctxt "hb4dc76b5ga2dfg4580g80aag48ff05aab296"
msgid ""
"All's well here. The cargo from below has already been taken to the docks."
msgstr "여기는 이상 없어. 아래에 있던 화물은 이미 부두로 옮겨졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard02
#. Speaker = Zealot Soreni
#. NodeID = aac7e96c-2664-427b-887d-c294a4665d0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Warehouse_HasMet_Guard02(1) = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Warehouse_HasMet_Guard02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Warehouse_Guard02:aac7e96c-2664-427b-887d-c294a4665d0a
msgctxt "hffb56ceagdc0fg4db9ga896gfbf5004ab526"
msgid ""
"Do I know you, True Soul? Feels like we met before - maybe in a previous "
"life."
msgstr "우리 혹시 구면인가, 참된 영혼? 언제 만난 적 있는 것 같아. 전생에서 만났을지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Radija
#. NodeID = 2b570fce-4d92-98f2-8a93-861c1b6e192e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:2b570fce-4d92-98f2-8a93-861c1b6e192e
msgctxt "ha9104b4cge352g4234g8f8egee320c855bad"
msgid "As you say, Z'rell."
msgstr "따르겠습니다, 즈렐 님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Disciple Z'rell
#. NodeID = 30a3921c-15f8-4ac2-a9d8-dd4f466f0066
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9378e194-3135-f75c-b557-457fa52db9f9_A = True
#. SetFlags:
#.   Local:
#.     - 9378e194-3135-f75c-b557-457fa52db9f9_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:30a3921c-15f8-4ac2-a9d8-dd4f466f0066
msgctxt "h51d0cab8gedbeg4410g9becgd0e08440357c"
msgid ""
"Ensure that the Moonlanterns outside are maintained, too. The curse cannot "
"be allowed to touch the Absolute's hall."
msgstr "바깥의 달등불 또한 확실히 관리하거라. 절대자님의 전당에 저주가 들러붙지 못하게 하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Disciple Z'rell
#. NodeID = 3456436e-798c-4bb6-aa67-80af413fe1ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:3456436e-798c-4bb6-aa67-80af413fe1ae
msgctxt "hf662cf60g52e3g431ag8cb9g56bfaacd1845"
msgid "Your role in Her design is to serve those who bring it into being."
msgstr "그분의 계획을 실현하는 이들을 수행하는 것이 네 역할이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Radija
#. NodeID = 649532ad-949b-49fc-86ef-96dd0aaf76da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:649532ad-949b-49fc-86ef-96dd0aaf76da
msgctxt "hdc54ba10g0a14g442eg8f92gc054394f5ad1"
msgid "By Her design. Can I assist you, Disciple?"
msgstr "그분의 뜻대로. 도와드릴 것이 있습니까, 신봉자시여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Disciple Z'rell
#. NodeID = 6f93039f-340f-4c07-b90c-39439b31c5a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9378e194-3135-f75c-b557-457fa52db9f9_B = True
#. SetFlags:
#.   Local:
#.     - 9378e194-3135-f75c-b557-457fa52db9f9_B = False
#.     - 9378e194-3135-f75c-b557-457fa52db9f9_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:6f93039f-340f-4c07-b90c-39439b31c5a7
msgctxt "h57ab2184gcbd9g44c5g9f18ge6baef129ab2"
msgid ""
"Remember your place, child. The True Souls stand above you, and I above them."
msgstr "네 위치를 기억하거라, 아이야. 네 위에 참된 영혼이, 그 위에는 내가 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Disciple Z'rell
#. NodeID = 71737bb8-1a61-4a5e-97bc-5862740a7f5f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9378e194-3135-f75c-b557-457fa52db9f9_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:71737bb8-1a61-4a5e-97bc-5862740a7f5f
msgctxt "hcad59688g09b4g43dag8b09ge19a722ca2f1"
msgid "In Her name."
msgstr "그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Disciple Z'rell
#. NodeID = ae84d710-4df5-1e22-6ab6-b4e5bc1d465e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:ae84d710-4df5-1e22-6ab6-b4e5bc1d465e
msgctxt "hc6c0fb68g9cb7g4c3cgac52g2f89c6f80bb2"
msgid "It is <i>Disciple.</i>"
msgstr "<i>신봉자</i>다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Radija
#. NodeID = b07c46a9-3186-f808-2d16-008e29954096
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:b07c46a9-3186-f808-2d16-008e29954096
msgctxt "h36638dd0gf8f5g45bagb38fgc4a42eca5eb3"
msgid "Of course, Disciple. As always."
msgstr "여부가 있겠습니까, 신봉자시여. 평소처럼 조치하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Radija
#. NodeID = b44f1cf4-6e37-4ba8-89f4-346162f447fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:b44f1cf4-6e37-4ba8-89f4-346162f447fa
msgctxt "h79943bb2g6d45g4c7dg9c34g7033fac8f345"
msgid "I will not forget, Disciple."
msgstr "절대 잊지 않겠습니다, 신봉자시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist
#. Speaker = Disciple Z'rell
#. NodeID = c1dcae0a-3fd2-4a35-b1cd-be7d703fda70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithCultist:c1dcae0a-3fd2-4a35-b1cd-be7d703fda70
msgctxt "h646d5ec2g1953g4d48gaf26g7cde63be101d"
msgid ""
"The General has withdrawn to his chapel above. He is <i>not</i> to be "
"disturbed."
msgstr "장군님께서 위층 예배당으로 가셨다. <i>절대</i> 방해받으시는 일이 없도록 하여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Zealot Bennel
#. NodeID = 2237706a-aabe-4ce4-ba19-3cd2b3c110a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e6aef01a-0468-5046-e519-b9b624c704dc_A = True
#. SetFlags:
#.   Local:
#.     - e6aef01a-0468-5046-e519-b9b624c704dc_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:2237706a-aabe-4ce4-ba19-3cd2b3c110a6
msgctxt "h7141a54dg7913g4fcdgbf45g229af2cb8380"
msgid "All quiet, Disciple."
msgstr "이상 없습니다, 신봉자님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Acolyte Daine
#. NodeID = 1e7269af-17f5-4960-b6c6-bfe53a8e5f04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8817275c-224d-13c2-92e6-680e5910ff1e_A = True
#. SetFlags:
#.   Local:
#.     - 8817275c-224d-13c2-92e6-680e5910ff1e_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:1e7269af-17f5-4960-b6c6-bfe53a8e5f04
msgctxt "hfb84c365gcaa1g4a46gb34bg599c536740a7"
msgid ""
"We have the Eyes watching the perimeter, Disciple. I thought it best remain "
"close to you."
msgstr "타워 주변은 수정구가 감시하고 있습니다, 신봉자시여. 가까이서 당신을 수행하는 게 낫겠다고 생각했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Disciple Z'rell
#. NodeID = 2aef0860-c52b-0137-fd0b-16ccc9f12e99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:2aef0860-c52b-0137-fd0b-16ccc9f12e99
msgctxt "h06315a82g9a46g49edg96feg8eb9f5c98a78"
msgid ""
"We do not need to trust them. The Absolute's Design requires many threats - "
"not all of them of the finest fabric."
msgstr "그들을 믿을 필요는 없다. 절대자님의 설계는 수많은 실로 직조하는 자수와 같으니, 그 모두가 최고급일 수는 없겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Disciple Z'rell
#. NodeID = 3c32c20d-40fe-4340-83e2-6de7344b52cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:3c32c20d-40fe-4340-83e2-6de7344b52cd
msgctxt "h981a2364gf292g4eaeg820dgacd31bdc0ba7"
msgid "All quiet? Do you suppose the Absolute's enemies are resting, soldier?"
msgstr "이상 없음? 절대자님의 적들이 가만히 앉아서 쉬고 있을 거라는 뜻인가, 병사?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Disciple Z'rell
#. NodeID = cf7a0a15-0919-48aa-ab5c-ce8e01c9c14a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:cf7a0a15-0919-48aa-ab5c-ce8e01c9c14a
msgctxt "h70a49059g070fg44c3ga984g6f55cfd8dd90"
msgid "Protect me? Adorable. Get back on your rounds."
msgstr "지켜? 날? 갸륵하기도 하지. 당장 순찰이나 하러 가도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Zealot Bennel
#. NodeID = 693a164b-6b2c-430f-817e-c4bfabe4b188
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e6aef01a-0468-5046-e519-b9b624c704dc_B = True
#. SetFlags:
#.   Local:
#.     - e6aef01a-0468-5046-e519-b9b624c704dc_B = False
#.     - e6aef01a-0468-5046-e519-b9b624c704dc_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:693a164b-6b2c-430f-817e-c4bfabe4b188
msgctxt "h371cfc71gd898g4701g8700g52bce2d90e2b"
msgid "Nothing to report, Dis-"
msgstr "보고할 건 없습니다, 신-"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Disciple Z'rell
#. NodeID = d2983ce4-d9d8-4fd6-aaa1-3a2a495ce210
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8817275c-224d-13c2-92e6-680e5910ff1e_B = True
#. SetFlags:
#.   Local:
#.     - 8817275c-224d-13c2-92e6-680e5910ff1e_A = False
#.     - 8817275c-224d-13c2-92e6-680e5910ff1e_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:d2983ce4-d9d8-4fd6-aaa1-3a2a495ce210
msgctxt "hd0c7c4efg90eeg41e5ga0d7gde1fe6c88956"
msgid "What now?"
msgstr "또 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Disciple Z'rell
#. NodeID = 74282b5a-7d57-4179-a883-1c8fe24e1c93
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e6aef01a-0468-5046-e519-b9b624c704dc_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:74282b5a-7d57-4179-a883-1c8fe24e1c93
msgctxt "h00d95321g2f13g4a3cg92a8ga5f6d9792ce4"
msgid "In Her Name. Report?"
msgstr "그분의 이름으로. 보고할 게 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Disciple Z'rell
#. NodeID = ddcaafc2-5885-46b8-afe8-94e558c5313e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8817275c-224d-13c2-92e6-680e5910ff1e_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:ddcaafc2-5885-46b8-afe8-94e558c5313e
msgctxt "hd8024c13gecaag4db6g9d0bgb9545055770e"
msgid "Anything of note to report?"
msgstr "내가 알아야 할 사항이 있느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Disciple Z'rell
#. NodeID = e1a645f1-4cc5-3f6c-b02c-321c65b6c2ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:e1a645f1-4cc5-3f6c-b02c-321c65b6c2ea
msgctxt "hdb9c1893gc16fg4020gb01cga9e84cedc18b"
msgid "Meat. Fodder. I asked for anything of <i>note.</i>"
msgstr "늘 오는 고깃덩이들이잖아. <i>알아야 할</i> 게 있냐고 물었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Disciple Z'rell
#. NodeID = 991170f4-75fd-40e7-8af1-7b2dfe811e04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:991170f4-75fd-40e7-8af1-7b2dfe811e04
msgctxt "h2ed7d127g67e0g4014gb10fg19f3652915a5"
msgid ""
"Then <i>why </i>are you reporting, soldier? Interrupt me again, and you will "
"serve Disciple Balthazar instead. Do you want that?"
msgstr "그럼 <i>왜</i> 보고하고 있는 건가, 병사? 한 번만 더 나를 방해한다면, 나 대신 발타자르를 섬기게 될 거야. 이해했나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Acolyte Daine
#. NodeID = edbb8a40-8abe-4d85-9023-754e5b9b5319
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:edbb8a40-8abe-4d85-9023-754e5b9b5319
msgctxt "h5fa33ea6g4745g4a04gabf5g5af27945de02"
msgid ""
"The shipments are progressing, Disciple. Though I do not trust the "
"mercenaries. The <i>infidels.</i>"
msgstr "운송은 진행 중입니다, 신봉자시여. 하지만 용병들은 영 믿음이 가질 않는군요. <i>불신자</i> 놈들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Zealot Bennel
#. NodeID = c5369567-1537-4aa4-8f71-d71bf07cf5b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:c5369567-1537-4aa4-8f71-d71bf07cf5b4
msgctxt "hfeabe6e6g8890g4cfag9c4fg40bd06b3cf10"
msgid ""
"There are some ghouls nesting on the upper ramparts. They seem... restless."
msgstr "성벽 위쪽에 구울들이 둥지를 틀었습니다. 뭐랄까... 불안해 보였습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000
#. Speaker = Acolyte Daine
#. NodeID = f456af0f-fc67-4143-a9bd-3862ba2747a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard000:f456af0f-fc67-4143-a9bd-3862ba2747a1
msgctxt "h269487c0g2898g4863gaf3fgc92cfbc6654f"
msgid "More pilgrims are arriving, Disciple."
msgstr "더 많은 순례자가 모여들고 있습니다, 신봉자시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Zealot Bennel
#. NodeID = 04888c8e-7547-c264-dc97-dc1e6aebb973
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:04888c8e-7547-c264-dc97-dc1e6aebb973
msgctxt "hb3e35089ge872g473dg9909g454a12a51e16"
msgid "I - no, Disciple."
msgstr "전.. 아닙니다, 신봉자님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Zealot Bennel
#. NodeID = 14f72a4b-774b-0e00-f0da-9e81394ef6ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:14f72a4b-774b-0e00-f0da-9e81394ef6ad
msgctxt "hcd80e191g787eg4ca4g81cegf654838423dc"
msgid "I - no, mistress! I  would never -"
msgstr "전.. 아닙니다, 신봉자님! 저는.. 절대로..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Zealot Bennel
#. NodeID = 325774f3-be11-30b3-dabb-cd3fab87a366
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:325774f3-be11-30b3-dabb-cd3fab87a366
msgctxt "h925d752dgbc97g4871g8ac3g60e03f9d9334"
msgid "No, Disciple. Forgiveness, Disciple."
msgstr "물론입니다, 사과드립니다. 신봉자님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Disciple Z'rell
#. NodeID = 69e88c38-d91c-e708-e76d-dba93bc9d8a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:69e88c38-d91c-e708-e76d-dba93bc9d8a9
msgctxt "h6670f9cbg4227g469bg844fg41ac84404bec"
msgid ""
"We had best hope they don't forget themselves - or I'll have to send you out "
"there to calm them down."
msgstr "그것들이 본분을 잊지 않기를 바라야지, 아니면 너를 보내서 놈들을 진정시키게 해야 할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Disciple Z'rell
#. NodeID = 718fcf97-661f-d1b6-e874-4610b39359ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:718fcf97-661f-d1b6-e874-4610b39359ef
msgctxt "h0eaaf440ga2c7g4a9fgb5a8g844779e5c4e3"
msgid "Oh, relax and let me have my fun. This paperwork grows tedious."
msgstr "아, 진정해. 장난 좀 친 거야. 서류 작업이 워낙 지루해져서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Zealot Bennel
#. NodeID = b0672aa9-1d54-8471-fd1d-bd50cd0873a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:b0672aa9-1d54-8471-fd1d-bd50cd0873a0
msgctxt "hb742620fg3eb7g4167ga47cge8d42746ef41"
msgid "I'll put some sense in their heads, Disciple."
msgstr "제가 단단히 주지시키겠습니다, 신봉자님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Disciple Z'rell
#. NodeID = cc035dc7-bdcf-9f1c-835a-807c1ac27fae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:cc035dc7-bdcf-9f1c-835a-807c1ac27fae
msgctxt "h4f79f001gf1cdg430agb47bg6d45b76b581c"
msgid ""
"Perhaps you cannot find them - root them out - because they are your allies? "
"Hm?"
msgstr "네가 놈들을 찾아내 뿌리 뽑지 못하는 이유가 혹시, 그들이 네 친구라서 그런 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001
#. Speaker = Disciple Z'rell
#. NodeID = fbf66269-ecad-621f-c21c-c42cb6ad6e86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithGuard001:fbf66269-ecad-621f-c21c-c42cb6ad6e86
msgctxt "h437a516dgb9bdg4634gbee4g2f18900a0e62"
msgid "Or some meat in their bellies, at least."
msgstr "아니면 주린 배라도 채워주든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Fist Marcus
#. NodeID = 1fd41c11-cf1f-4ec4-b422-41dc6fb1d055
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4cf922b7-6432-9edf-022e-b530fcc825bb_A = True
#. SetFlags:
#.   Local:
#.     - 4cf922b7-6432-9edf-022e-b530fcc825bb_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:1fd41c11-cf1f-4ec4-b422-41dc6fb1d055
msgctxt "h9157a39bged8eg4990g9061g501598c59066"
msgid "If I may... am I to receive an audience with the General?"
msgstr "외람될 지 모르나... 혹시 장군님을 알현할 수 있겠습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Disciple Z'rell
#. NodeID = 3074da7b-720c-4ea5-9296-57d18c689310
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:3074da7b-720c-4ea5-9296-57d18c689310
msgctxt "h4ed35466g65aeg435dg931bg5bbccdaaab06"
msgid ""
"You can certainly pray for it. Or pray that he doesn't hear that he moves "
"too slowly for your liking."
msgstr "기도는 해볼 수 있겠지. 아니면 너무 오래 걸린다고 징징대는 소리가 장군님 귀에 들어가지 않게 기도하던지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Fist Marcus
#. NodeID = 31992120-188f-6d93-6466-21d6e4d3bf1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:31992120-188f-6d93-6466-21d6e4d3bf1f
msgctxt "h91cac88eg01d9g43d6ga019g382ed1811dda"
msgid "I will... reflect on that, Disciple."
msgstr "아... 반성하겠습니다, 신봉자님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Fist Marcus
#. NodeID = 3bdfa3c0-54b0-46e0-a31a-f28f20189b55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4cf922b7-6432-9edf-022e-b530fcc825bb_B = True
#. SetFlags:
#.   Local:
#.     - 4cf922b7-6432-9edf-022e-b530fcc825bb_B = False
#.     - 4cf922b7-6432-9edf-022e-b530fcc825bb_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:3bdfa3c0-54b0-46e0-a31a-f28f20189b55
msgctxt "h8f3f5232gee48g459dg8079g2ff9c6d85cd5"
msgid "Disciple Z'rell, I simply wanted to say what an honour -"
msgstr "신봉자 즈렐 님, 그야말로 영광이라는 말 밖에는 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Fist Marcus
#. NodeID = 50b0f614-4280-4534-b19e-2f109f73e777
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4cf922b7-6432-9edf-022e-b530fcc825bb_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:50b0f614-4280-4534-b19e-2f109f73e777
msgctxt "h7a444405ga852g4920gbf6bg231483c210de"
msgid "I am free to do more for the Absolute, Disciple. Anything."
msgstr "절대자님을 위해 일하게 해 주십시오, 신봉자시여. 뭐든지 하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Disciple Z'rell
#. NodeID = 78b41e35-7aea-4717-b730-d97d77d34dcd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:78b41e35-7aea-4717-b730-d97d77d34dcd
msgctxt "h16d0f2cagaea3g4929g81e1gf2d876d1256a"
msgid "Why are you speaking, meat?"
msgstr "누가 네놈더러 입을 열라고 했지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Disciple Z'rell
#. NodeID = e0de7267-861a-1053-6cd7-781a46abf2e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:e0de7267-861a-1053-6cd7-781a46abf2e4
msgctxt "h05e84595g34e4g47fdg9022ge985cd09dde7"
msgid "Off you go, then. I've always wanted to try those ballistas."
msgstr "그럼 어서 가봐. 저 발리스타로 표적 연습을 꼭 해보고 싶었는데 잘됐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Disciple Z'rell
#. NodeID = f53b8b9a-8167-4b19-ba14-3df466bd7623
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:f53b8b9a-8167-4b19-ba14-3df466bd7623
msgctxt "h0a0cba8eg8b30g468aga8c0g6dda1ade6645"
msgid "Would you cast yourself from the tower-top?"
msgstr "타워 꼭대기에서 몸을 던질 수도 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy
#. Speaker = Fist Marcus
#. NodeID = fe2f3f60-0db2-0c7f-c965-7bd256a0afd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_AD_WithSpy:fe2f3f60-0db2-0c7f-c965-7bd256a0afd7
msgctxt "h9e0f45ebgee87g475agad1bgb6cba4c67718"
msgid "Of course. I have the Absolute's wings to catch me."
msgstr "물론입니다. 절대자께서 제게 날개를 주셨으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 125ebd1c-1c15-862c-c11a-bb45cdb73f34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_FlamingSpy_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy:125ebd1c-1c15-862c-c11a-bb45cdb73f34
msgctxt "h90541b08g60a4g49f5g8c86g63d585d70593"
msgid ""
"My unexpected ally! The General was very pleased with Isobel's return. Don't "
"worry, I told him <i>all </i>about you."
msgstr ""
"예상 밖의 지원군 아니신가! 장군님께서 이소벨의 귀환에 기뻐하고 계시네. 걱정 마. 자네에 대해서는 <i>전부</i> 얘기했으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 30f619ae-1bd1-6dce-cf51-56301f0583e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyConfrontationStarted = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#. SetFlags:
#.   Dialog:
#.     - MOO_FlamingSpy_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy:30f619ae-1bd1-6dce-cf51-56301f0583e5
msgctxt "h1e6df087g4ca8g4f04ga1f7g19b902938fcf"
msgid ""
"Glad I stuck my neck out for you in Haven. The General was very pleased with "
"Isobel's return. Don't worry, I told him <i>all </i>about you."
msgstr ""
"자네를 위해 위험을 무릅쓴 보람이 있구먼. 장군님께서 이소벨의 귀환에 기뻐하고 계시네. 걱정 마. 자네에 대해서는 <i>전부</i> "
"얘기했으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 35820fa8-a113-4649-b6a6-f82c574b9ec5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyConfrontationStarted = True
#.      - HAV_TakingIsobel_State_SidedWithSpy = True
#. SetFlags:
#.   Dialog:
#.     - MOO_FlamingSpy_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy:35820fa8-a113-4649-b6a6-f82c574b9ec5
msgctxt "h813836bag052cg402bgbce7gb246fe3f2181"
msgid ""
"My old friend, thanks for your help with Isobel. The General was most "
"pleased. Don't worry, I gave you some credit."
msgstr ""
"내 오랜 친구여, 이소벨과 관련해 날 도와줘서 고맙네. 장군님께서도 아주 흡족해 하셨어. 걱정마. 자네의 공적도 조금은 얘기했으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 9e205b5e-01cb-a81b-7f92-7eed61f12b66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_FlamingSpy_HasMet(1) = True
#.   Global:
#.      - HAV_TakingIsobel_State_SpyConfrontationStarted = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy:9e205b5e-01cb-a81b-7f92-7eed61f12b66
msgctxt "h90afe765gcb4bg4c16g8bd0ga89c283b56a2"
msgid "I look forward to working with you again, the Absolute permitting."
msgstr "자네와 다시 함께 할 날을 기대하겠네. 절대자께서 허락하신다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 167811d7-9c63-42a4-88bc-2a96f220dd4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:167811d7-9c63-42a4-88bc-2a96f220dd4b
msgctxt "h9d64178dgaa07g4494gbf5dg5dd7168ab2b3"
msgid "What is the Absolute's end game?"
msgstr "절대자의 최종 목표가 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 1bc96f3d-7a26-48aa-97e0-9f006fa33622
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead:1bc96f3d-7a26-48aa-97e0-9f006fa33622
msgctxt "h1a142439g2608g4c09gb219gec10bff5e14e"
msgid "Do you know the source of Ketheric's invulnerability?"
msgstr "케서릭이 갖고 있는 불사의 힘의 근원을 알고 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ZrellBriefing_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 2140e481-f78b-477b-a303-17a3075c2e74
