msgctxt "h17398fbcg849cg4f7fgbc86g324600283b5d"
msgid "A most difficult dissection. Sister?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon_Trepan_Combat
#. Speaker = Malus Thorm
#. NodeID = 64dbd4c2-0f00-4345-9b2a-6bb682dcb51a
