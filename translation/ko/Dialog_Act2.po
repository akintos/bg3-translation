#.      - SHA_LastJusticiar_RatsCalm_Knows_RatsUncooperative(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsCalm_Knows_RatsUncooperative(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:9838eebf-e630-5a92-f09f-9787e9c4cb55
msgctxt "heab2fd15gbc9ag45b5g8525gc59ef18beff4"
msgid "You're just a rat - is it really wise to stand up to me?"
msgstr "넌 그냥 쥐잖아. 나한테 맞서는 게 현명할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Gale
#. NodeID = 989c49e5-4b77-441c-9044-ef59aa81a89b
