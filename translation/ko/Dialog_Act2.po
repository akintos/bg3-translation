msgctxt "h19ad15f0gff3eg4632gbfa1ge3c32538a5cc"
msgid "But where exactly does it lead...?"
msgstr "근데 어디로 향하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 90bc4890-500a-4084-8994-ebbf5f78dea4
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players:90bc4890-500a-4084-8994-ebbf5f78dea4
msgctxt "he789cc58g858eg4db5gbdd1gb74eaea9a3c8"
msgid "Onto the disc, then. Unless you have a better idea."
msgstr "더 나은 방법이 없잖아, 그냥 올라타."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 90bc4890-500a-4084-8994-ebbf5f78dea4
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players:90bc4890-500a-4084-8994-ebbf5f78dea4
msgctxt "hd3948572g5344g4b7dgbb11g1155e74fe8e3"
msgid "The question is: where will it take us?"
msgstr "문제는, 우릴 어디로 데려가냐는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 90bc4890-500a-4084-8994-ebbf5f78dea4
