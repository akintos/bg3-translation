msgctxt "h2b3accafg8ddag40dbg801dg804bc9027038"
msgid "Thaniel? Who is that?"
msgstr "테니엘? 그게 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = 1dda1e80-bece-4b18-a6f4-d3c009f51535
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LiftingTheCurse_State_AskedAboutBreath(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:1dda1e80-bece-4b18-a6f4-d3c009f51535
msgctxt "h5f026f20g277cg40a5ga80cg99397f66a34f"
msgid "What does Thaniel need?"
msgstr "테니엘에게 필요한 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 2bc36879-66e2-262e-2543-8a20370ffbf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:2bc36879-66e2-262e-2543-8a20370ffbf6
msgctxt "hc8b5ce88g23c6g4494g9c7dgc91d24a9ab8c"
msgid "He is... brutal. Cares for nothing... except... his daughter..."
msgstr "쏨은... 무자비해. 아무것도... 신경 쓰지 않아... 딸만 빼고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = 2c619a3a-4b76-45e8-8a95-e2e74d0d28f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:2c619a3a-4b76-45e8-8a95-e2e74d0d28f3
msgctxt "h9009d885g5cbeg4ab8g88cdg0bf70fe58fd2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = 6f9faf6b-0e19-fa00-d43f-e47607e08846
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8ba20bc7-3f8f-18c1-6b19-93e2a9874d16_mentionedketheric = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:6f9faf6b-0e19-fa00-d43f-e47607e08846
msgctxt "h38bf2eddgf5cbg452fg965ag4fda51db7911"
msgid "What can you tell me about Ketheric Thorm?"
msgstr "케서릭 쏨에 대해서 말해줄 것이 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 74454e9d-c15a-4f63-9de9-1be0b4036f6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:74454e9d-c15a-4f63-9de9-1be0b4036f6e
msgctxt "h98c7bfb3gdddcg4ba4gbe65ge8c7842298c1"
msgid "<i>Halsin.</i>"
msgstr "<i>할신.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = 98e544c6-d329-49f7-b7cf-5fc1c7b55533
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 8ba20bc7-3f8f-18c1-6b19-93e2a9874d16_mentionedketheric = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:98e544c6-d329-49f7-b7cf-5fc1c7b55533
msgctxt "hbf83ae5dg101cg4530g93d4g3790825aa4da"
msgid "What are you doing here?"
msgstr "여기서 뭘 하고 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Art Cullagh
#. NodeID = a0463b81-87da-3d7f-bf62-51f714d514b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:a0463b81-87da-3d7f-bf62-51f714d514b7
msgctxt "hb0ad6ec1gcfc3g4d87gafbfg2b227955ee90"
msgid ""
"Shadowfell... shifts... and changes. But where Thaniel is... always "
"smells... of lavender..."
msgstr "섀도펠... 항상... 변한다. 하지만 테니엘이 있는 곳... 변함없이... 라벤더 향이 나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = a604761f-0ae3-29ee-deea-9beb8bec21be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 8ba20bc7-3f8f-18c1-6b19-93e2a9874d16_mentionedthaniel = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:a604761f-0ae3-29ee-deea-9beb8bec21be
msgctxt "h20abe4d9g80b7g47edgad7fgc4151450f575"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = b39a97f5-161e-06bb-36d2-43dc67a4e47a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#.   Local:
#.      - 8ba20bc7-3f8f-18c1-6b19-93e2a9874d16_mentionedthaniel = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_State_KnowsBreathLocation = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:b39a97f5-161e-06bb-36d2-43dc67a4e47a
msgctxt "h9ac19a45g66dfg4358gbe92g6bbc25f3f388"
msgid "I'm looking for Thaniel. Where is he?"
msgstr "테니엘을 찾고 있다. 그는 어디에 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Art Cullagh
#. NodeID = b923b9fa-22d6-4c3c-bc7f-a5c72811b254
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:b923b9fa-22d6-4c3c-bc7f-a5c72811b254
msgctxt "h0191307fg01d7g4c2bg8fefg24f657fc0907"
msgid ""
"Spirit... of the Land. In the... Shadowfell. Look for... lavender. He "
"needs... he needs..."
msgstr "대지의... 정령. 섀도펠에... 있어. 라벤더를... 찾아. 테니엘에게... 필요한 건..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Art Cullagh
#. NodeID = bc60511a-bc93-4a23-86fa-70d167c6f8e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:bc60511a-bc93-4a23-86fa-70d167c6f8e0
msgctxt "hc1fadb69g1f97g4e64g911ega8601e0d3e12"
msgid "Art... Cullagh of... the Flaming Fist."
msgstr "플레이밍 피스트의... 아트... 컬라흐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Narrator
#. NodeID = cb46fc29-ea9d-453d-ac67-d32e9cec3ec9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:cb46fc29-ea9d-453d-ac67-d32e9cec3ec9
msgctxt "h3cb9318eg6046g4d2cg8bafgf79c2302ba48"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Art Cullagh
#. NodeID = cdf39ce5-4f84-7abf-8278-226726d1a7e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:cdf39ce5-4f84-7abf-8278-226726d1a7e5
msgctxt "h394baa58gada5g436cga74ag17812f6223b0"
msgid "Curse... darkness... pain. Thaniel... have to help... Thaniel..."
msgstr "저주... 그림자... 고통. 테니엘... 도와줘야 해... 테니엘을..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Narrator
#. NodeID = e1de68a3-e1da-4925-a750-bc4c1f273b21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist:e1de68a3-e1da-4925-a750-bc4c1f273b21
msgctxt "h5abd20d8ga040g45f0ga4d3gc6c5ef764fff"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = e3e65b7a-be52-405c-ae27-76915a2313f6
#. HandlePath = TaggedText[0].TagText[0]
