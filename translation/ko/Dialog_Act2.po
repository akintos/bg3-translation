#.      - 2bc86ee2-13ec-992e-993a-8b2fb705bd0a_B = True
#.      - 2bc86ee2-13ec-992e-993a-8b2fb705bd0a_A = True
#. SetFlags:
#.   Local:
#.     - 2bc86ee2-13ec-992e-993a-8b2fb705bd0a_B = False
#.     - 2bc86ee2-13ec-992e-993a-8b2fb705bd0a_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_AD_SkullLasher_002_AttackDummy:ad95e051-5715-4b0a-a5ca-e1e87986583d
msgctxt "hfdc86813g7c9cg448fg8ec1g9f0e301b3027"
msgid "A shame it has no bones to break."
msgstr "부러트릴 뼈가 없는 게 아쉽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_AD_SkullLasher_001_Prayer
#. Speaker = Hairy Henry
#. NodeID = c43c6536-34cb-4920-bc15-580b65042987
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a2b4b527-63b6-ffde-caf9-cb61e6405ce3_A = True
#.      - a2b4b527-63b6-ffde-caf9-cb61e6405ce3_B = True
#. SetFlags:
#.   Local:
#.     - a2b4b527-63b6-ffde-caf9-cb61e6405ce3_A = False
#.     - a2b4b527-63b6-ffde-caf9-cb61e6405ce3_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_AD_SkullLasher_001_Prayer:c43c6536-34cb-4920-bc15-580b65042987
msgctxt "hff51e784gc2f7g4b2bg9731g8efa01167f7e"
msgid "Bring dusk, bring night. Bring death."
msgstr "황혼을 불러오고, 밤을 내리며, 죽음을 데려오라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_AD_SkullLasher_002_Combat
#. Speaker = Ironfinger
#. NodeID = 88094d99-73d6-49a3-9c41-85e1de45597e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_AD_SkullLasher_002_Combat:88094d99-73d6-49a3-9c41-85e1de45597e
msgctxt "hedccb29fgdf7fg4102ga293ge6ab8f544b2d"
msgid "I will toast a goblet of your blood after you're dead!"
msgstr "죽여서 네 피가 담긴 잔에 건배를 할 것이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_AD_SkullLasher_003_Combat
#. Speaker = Maghtew Budj
#. NodeID = e1e14e59-1986-486a-b029-798d33bb4e78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_AD_SkullLasher_003_Combat:e1e14e59-1986-486a-b029-798d33bb4e78
msgctxt "h87123fb0g75cag4c29gaa5eg30f6747f47c2"
msgid "I shall make sweet music of your screams!"
msgstr "너의 비명으로 달콤한 노래를 만들어 주겠다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Kressa Bonedaughter
#. NodeID = 1dfefb15-ca76-1799-fa1e-357d75ef6c31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:1dfefb15-ca76-1799-fa1e-357d75ef6c31
msgctxt "haa3dda9bg30a7g4e0eg8152ga609eb297adc"
msgid "He is below."
msgstr "그는 아래에 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Kressa Bonedaughter
#. NodeID = 214865ac-4308-d438-833d-3b4322cd134b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:214865ac-4308-d438-833d-3b4322cd134b
msgctxt "h0c49d7f4g4eb7g48c7g9677gbaf4124f3929"
msgid "And he does not deem you worthy of his dread touch."
msgstr "그리고 그분은 네가 그분의 절망적인 손길의 닿을 자격이 없다고 여기신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Kressa Bonedaughter
#. NodeID = 29fbd4d6-4c7f-37d5-8f0c-ab42ad2fd10a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:29fbd4d6-4c7f-37d5-8f0c-ab42ad2fd10a
msgctxt "h6afadef7g5ec9g4698g93c3gc48573068c80"
msgid ""
"It is not <i>my </i>blessing, True Soul. I am merely a vessel for our Lord "
"Myrkul's will."
msgstr "<i>나의</i> 축복이 아니다, 참된 영혼이여. 난 그저 머큘님의 의지를 담는 그릇에 불과할 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Kressa Bonedaughter
#. NodeID = 46d41685-dd58-eb38-34f2-6c14598e5f67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:46d41685-dd58-eb38-34f2-6c14598e5f67
msgctxt "h9a6500b4gdc27g42d4g923egadbb81ddd256"
msgid ""
"It is not my blessing to give - I am merely a vessel for our Lord Myrkul's "
"will."
msgstr "내가 줄 수 있는 축복이 아니다. 난 그저 머큘님의 의지를 담는 그릇에 불과할 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Player
#. NodeID = 4f4a3987-4f70-bdaa-ff2f-9f6b3479378f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - COL_Barracks_Mistress_Knows_ThinksPlayerIsThrall(1) = False
