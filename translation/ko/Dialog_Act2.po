msgctxt "hca6dc3b7g60a7g4683g99a7ga7fd9edbc8ef"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Dead Githyanki Warrior
#. NodeID = 0577665e-eb5a-3369-f451-aa333d44e41e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:0577665e-eb5a-3369-f451-aa333d44e41e
msgctxt "h9ae5ca35gb4deg47a6g84dbg6c70cbe81b44"
msgid "Not in the shadowlands... Atop the mountain, reaching to the sun..."
msgstr "그림자땅에는 없다... 산꼭대기, 태양에 닿은 곳에..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = 0d796720-15e8-400b-bf2e-2f073624c1be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:0d796720-15e8-400b-bf2e-2f073624c1be
msgctxt "hd2c0d56dgc27eg4318g84bege9903349f871"
msgid "Why were you here?"
msgstr "왜 여기에 왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = 1927da47-14cc-4c15-ae16-ebeb4223f586
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:1927da47-14cc-4c15-ae16-ebeb4223f586
msgctxt "h6cc71e94g06b6g4b1ag8477g8b5920a8fed2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Narrator
#. NodeID = 250aead2-8996-4a35-ac35-8a2637794562
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:250aead2-8996-4a35-ac35-8a2637794562
msgctxt "he658bd0egd655g4c19g948dg6ae53ead91a1"
msgid "*The corpse remains silent. It does not know.*"
msgstr "*시체가 침묵을 유지합니다. 알지 못합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = 366586a1-9af8-48f8-b9fa-5db201160ecc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:366586a1-9af8-48f8-b9fa-5db201160ecc
msgctxt "hf0e0652dgb3dcg43b1g9253g22afe47e6d94"
msgid "How do I fight the curse?"
msgstr "어떻게 저주를 이겨낼 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = 4fe18962-3645-f1a1-71ab-86e637797858
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:4fe18962-3645-f1a1-71ab-86e637797858
msgctxt "h0e2e56d9g9608g4740g8e2cg2509b9890334"
msgid "Are there other githyanki nearby?"
msgstr "근처에 다른 기스양키가 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Dead Githyanki Warrior
#. NodeID = 56d4f7b0-32c0-f7b7-12df-6ec7a6320fb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:56d4f7b0-32c0-f7b7-12df-6ec7a6320fb7
msgctxt "ha5f3fff5g01b2g47d2gbb29g20aa36687d2c"
msgid "Shameful death... dishonour to Vlaakith..."
msgstr "수치스러운 죽음... 블라키스 님께 불명예를..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Dead Githyanki Warrior
#. NodeID = 58650afa-7cca-4126-b5a4-55851e5227bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:58650afa-7cca-4126-b5a4-55851e5227bf
msgctxt "h5f48a08egd4edg4b32g9b7agf8381888df8c"
msgid "Training... becoming a <i>sarth</i>... leading my kin..."
msgstr "훈련... <i>사크</i>가 되려고... 동족을 이끄는..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = 6a422691-4129-4e6a-84bc-4a9b51b6bf57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:6a422691-4129-4e6a-84bc-4a9b51b6bf57
msgctxt "hf39f0b94g40f0g41d7ga631gef9047e05b2b"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Dead Githyanki Warrior
#. NodeID = a996a43b-e328-47b4-aaf1-528fd05fc961
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithCreche_Knows_Location = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:a996a43b-e328-47b4-aaf1-528fd05fc961
msgctxt "h7b5d398dgb9b3g4a27gb017g4ee084d4741f"
msgid "Crèche Y'llek... hidden among the mountains... veiled by ruins..."
msgstr "일레크 양성소... 산속에 숨겨져 있다... 폐허에 가려진 곳..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Dead Githyanki Warrior
#. NodeID = c5f6db03-01ce-4064-9c13-5392c1756cce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:c5f6db03-01ce-4064-9c13-5392c1756cce
msgctxt "h0943fbc4g58b8g44a4g8255g26135bae64bd"
msgid "Teth'ka... warrior for my Queen... blade for my <i>Kith'rak</i>..."
msgstr "테스카... 여왕의 전사... <i>키스락</i>의 병사..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Narrator
#. NodeID = c8f97a71-7b65-42c3-93f5-c03ea1c821ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:c8f97a71-7b65-42c3-93f5-c03ea1c821ee
msgctxt "h548c8bf2ge77fg476fg8333g9fe35b1231eb"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Narrator
#. NodeID = cf875d4b-d3bd-4393-92e4-5ac52c7c5694
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:cf875d4b-d3bd-4393-92e4-5ac52c7c5694
msgctxt "h7807a8a1g6280g4b24gb06fg3a981b418241"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = d0eda3f5-2afd-41f5-8f38-0e0f5ad6c9d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:d0eda3f5-2afd-41f5-8f38-0e0f5ad6c9d3
msgctxt "h7bf8d717g2177g4165g9da1g9da45b380d6b"
msgid "Who were you?"
msgstr "너는 누구였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = d40b9c8d-2032-51b1-0643-da5fcf3eddcf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:d40b9c8d-2032-51b1-0643-da5fcf3eddcf
msgctxt "h8642ce1fgdf52g405cga9e8gc4970fcbeaf9"
msgid "What crèche do you hail from, kin?"
msgstr "어느 양성소에서 왔나, 동족이여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Narrator
#. NodeID = d8a24024-7c2c-44ce-b505-c1917c114554
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:d8a24024-7c2c-44ce-b505-c1917c114554
msgctxt "hc8899b54gbc8dg4243g9a4ag738fa9264a65"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Dead Githyanki Warrior
#. NodeID = e5d6cbaa-b8a1-4afa-8e7f-cc7ac9045dba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead:e5d6cbaa-b8a1-4afa-8e7f-cc7ac9045dba
msgctxt "hf0067025g57f5g43a4g96feg87972fff462f"
msgid "Foolish games... shadow... ambushed..."
msgstr "유치한 놀이... 그림자... 기습 당했어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Graveyard_VB_Debilitated
#. Speaker = Player
#. NodeID = c76950fd-06f1-e55e-30db-f839d2c715bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Graveyard_VB_Debilitated:c76950fd-06f1-e55e-30db-f839d2c715bd
msgctxt "h103daff0gd789g4f0ega493g707c98e33407"
msgid "This place... I feel chilled to the marrow."
msgstr "이곳은… 뼛속까지 오싹한걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Graveyard_VB_DirtpileGas
#. Speaker = Player
#. NodeID = 4fa00091-1203-0516-e2c5-423d80e432de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Graveyard_VB_DirtpileGas:4fa00091-1203-0516-e2c5-423d80e432de
msgctxt "h120f663bg0c01g496dg8632gd68b15fb1032"
msgid "Argh! This air is foul with rot. Better be careful..."
msgstr "으윽! 썩은내가 진동하는군. 조심하는 게 좋겠어…."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Graveyard_VB_Revitalized
#. Speaker = Player
#. NodeID = 537b2918-7946-f1df-317f-f82d02eb9dea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Graveyard_VB_Revitalized:537b2918-7946-f1df-317f-f82d02eb9dea
msgctxt "h7a243c49g57fcg4051gbac7g6ecfbcbeb551"
msgid "That place is cursed; I feel better just for having left it."
msgstr "저 저주받은 곳을 떠난 것만으로도 기분이 나아지는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Halsin
#. NodeID = 06683b9f-d727-7cbb-def6-2488add1fff6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:06683b9f-d727-7cbb-def6-2488add1fff6
msgctxt "h56d42d2eg2a50g4d64g9931g0e143ebaaf35"
msgid ""
"I must continue to investigate the curse - this may be my last chance. I "
"shall await your return when you are ready to continue."
msgstr "나는 저주를 계속 조사해야만 하네. 이게 내 마지막일 수 있어. 자네가 계속할 준비를 하고 돌아오길 기다리겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Player
#. NodeID = 79e7fd8c-7284-8b75-4502-1774042ff917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:79e7fd8c-7284-8b75-4502-1774042ff917
msgctxt "h694ba159gf5acg48fag9b31g0fc094b1038c"
msgid "What if I need you by my side?"
msgstr "당신이 제 곁에 있어야 한다면요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Halsin
#. NodeID = ce4ba9d1-e4d6-d139-5c84-ed77a15e116c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:ce4ba9d1-e4d6-d139-5c84-ed77a15e116c
msgctxt "h3bd5423ag3a41g4427g968eg23be46ed6d22"
msgid ""
"If you truly need to retread your steps, then you will have little need for "
"me there. You are more formidable than anything that lies in our wake."
msgstr ""
"자네가 정말로 발걸음을 물려야겠다면, 거기서 내 도움은 크게 필요치 않을 것이네. 자네는 우리가 지나온 곳에 있는 그 무엇보다도 강하니 "
"말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_CombatStarts
#. Speaker = Harper Lassandra
#. NodeID = 300a02f9-5001-4cfc-9abb-d7b50bc449f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_CombatStarts:300a02f9-5001-4cfc-9abb-d7b50bc449f9
msgctxt "h83338096ga19fg441cg8a63g9b0c2c8e11fd"
msgid "That's them! Kill the drider - take the Moonlantern!"
msgstr "저놈들이야! 드라이더를 죽이고 달등불을 차지해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_DriderDies
#. Speaker = Harper Lassandra
#. NodeID = 89b87a7e-31fe-408c-ba2d-1937d2f93fe5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_DriderDies:89b87a7e-31fe-408c-ba2d-1937d2f93fe5
msgctxt "h44521ecdg42f6g4d5dg9af7g9c9c409a6003"
msgid "Got him! Now to get the lantern."
msgstr "잡았다! 이제 등불을 챙기자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_DriderDropsLantern
#. Speaker = Harper Lassandra
#. NodeID = 5286db73-0412-4edf-bdc2-59c476489114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_DriderDropsLantern:5286db73-0412-4edf-bdc2-59c476489114
msgctxt "h3cc8452cg0f19g4a11g9418g1971a6c32cb5"
msgid "The lantern's down - we need to get it!"
msgstr "등불이 떨어졌다! 가져와야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_PlayerTookLantern
#. Speaker = Harper Lassandra
#. NodeID = 79d7ef4e-e1bb-4379-a97d-eb159574dc22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_PlayerTookLantern:79d7ef4e-e1bb-4379-a97d-eb159574dc22
msgctxt "hb75088acge817g40c0gbc6dge6bcad1d433b"
msgid "That lantern is ours, cultist!"
msgstr "이 광신도들아, 이제 등불은 우리 것이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_TakesMoonlantern
#. Speaker = Harper Lassandra
#. NodeID = 07353796-1cc5-44ee-914f-777df2c5be42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScout_000_AD_TakesMoonlantern:07353796-1cc5-44ee-914f-777df2c5be42
msgctxt "hba8380eagb242g4e89gac31gf2ec3f6ae184"
msgid "The Moonlantern's ours! Let's finish this and go home."
msgstr "달등불은 이제 우리거야! 얼른 끝마치고 돌아가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScouts_AD_HarperScout000_ExplainShadows
#. Speaker = Harper Lassandra
#. NodeID = 4c3f541e-6248-4cf2-811e-ea4301007286
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScouts_AD_HarperScout000_ExplainShadows:4c3f541e-6248-4cf2-811e-ea4301007286
msgctxt "h8fed0792gd013g4d56gb479g22588f0c0e89"
msgid ""
"The shadows are cursed - either keep away from them or destroy them with "
"light!"
msgstr "그림자는 저주받았어, 그림자에서 멀리 떨어지거나 빛으로 파괴해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScouts_AD_HarperScout_000
#. Speaker = Harper Lassandra
#. NodeID = 0af02bae-604e-4cdc-a0a3-0668f867d966
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScouts_AD_HarperScout_000:0af02bae-604e-4cdc-a0a3-0668f867d966
msgctxt "hf284600bg7f3ag4078gbcd1g4af18d490579"
