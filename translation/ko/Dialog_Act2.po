msgctxt "h2cfcb280g8985g4c6bg80b3g7f6758cfee7c"
msgid "<i>It's vulnerable - an opportunity. Attack.</i>"
msgstr "<i>취약한 상태... 기회다. 공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_DoublesEncounterTrial
