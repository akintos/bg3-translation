msgctxt "h3f31055bg5538g4ef9g9cfbgf17e2b56fede"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_002
#. Speaker = Player
#. NodeID = ed473a00-5370-c6fe-39c8-9f677e51df74
#. HandlePath = TaggedText[0].TagText[0]
