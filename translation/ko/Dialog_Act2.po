#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:479dac9b-b2fd-a7bc-e495-6fb916a3656c
msgctxt "hccbec246g52c3g4be2g9076g64bb8b76c5be"
msgid ""
"<i>The creature thinks you prey - adjust your body language to display as a "
"threat.</i>"
msgstr "<i>야수가 당신을 먹잇감으로 여깁니다. 몸짓으로 위협적인 상대임을 표현합니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = 49097f15-5a1f-4aaf-82e8-37a2fec17bc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:49097f15-5a1f-4aaf-82e8-37a2fec17bc1
msgctxt "h9fdffec6g539eg461cga2c5gb9554785aee0"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = 51348647-0949-bb7d-8c51-664b510e380d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:51348647-0949-bb7d-8c51-664b510e380d
msgctxt "h64a79277gba71g4435gb330g9a28cc1114bf"
msgid "Bluhrngh..."
msgstr "그아아악... "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = 6a953bce-6cd1-8c36-b5ad-917ff23aa13d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Kitchen_State_GnollsAreFree = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:6a953bce-6cd1-8c36-b5ad-917ff23aa13d
msgctxt "h77bc8e32g8985g4fa3g9b8bg970ed45e1ef5"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = 78b80832-eb5b-4637-ab9a-2a75881a61b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_Companion(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_Companion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:78b80832-eb5b-4637-ab9a-2a75881a61b2
msgctxt "h84264ee8g982cg476aga701g3b66f1498100"
msgid ""
"*A strange sensation courses through you, and your companion's mind unfolds, "
"secrets half-revealed.*"
msgstr "*기묘한 감각이 당신을 관통하고, 동료의 정신이 펼쳐지며 그가 지닌 비밀이 반쯤 드러납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = 7b6f9d3b-f7bb-401a-b3c9-5c148ad015c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:7b6f9d3b-f7bb-401a-b3c9-5c148ad015c3
msgctxt "h4b3e8bd6gd061g4f05gbc17gd93bea80835c"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = 8a8e65e5-8d4f-1f15-5ab7-f32a51ad6bad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:8a8e65e5-8d4f-1f15-5ab7-f32a51ad6bad
msgctxt "h4091940eg4184g4614g8003g249e441eda2e"
msgid "I'm <i>back</i>? Why have we met?"
msgstr "내가 <i>돌아왔다고</i>? 우리 뭐 때문에 만났더라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = 8e6fbc2d-e993-48ef-a277-785a5cef57c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.      - GLO_Tadpoled_UsedToday2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:8e6fbc2d-e993-48ef-a277-785a5cef57c4
msgctxt "h032f60bfg601dg4525gb55egbc07d599cdbb"
msgid "Now, now, Barnabus - <i>behave.</i>"
msgstr "자, 자, 바나버스. <i>착하지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = 90343e23-455a-896f-7c40-5c017b0cf2c6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Kitchen_State_GnollsAreFree = True
#.     - MOO_KitchenFight_Event_PlayerFreedGnoll = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:90343e23-455a-896f-7c40-5c017b0cf2c6
msgctxt "h95697af7g74dfg49a8gbee0g5edf880b99bd"
msgid ""
"*The beast sizes you up... then turns away to easier prey - the kitchen's "
"rich stock of unguarded meat and a warm patch by the fire.*"
msgstr ""
"*야수가 당신을 가늠합니다... 그리고는 등을 돌려 더 쉬운 먹잇감을 찾습니다. 주방에는 주인없는 고기가 쌓여있는데다, 따뜻한 불까지 "
"피워져 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = 91352f2c-41ea-854e-65f9-4f2045beaaf7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:91352f2c-41ea-854e-65f9-4f2045beaaf7
msgctxt "h3935fdb7gc07eg48f5g805dg65872eabb2c5"
msgid "Easy! I freed you - I'm a friend."
msgstr "진정해! 내가 널 풀어줬어. 난 친구야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = 9f4a8fdb-1dbb-fbab-5ad8-aff87516189a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Kitchen_State_GnollsAreFree = True
#.     - MOO_KitchenFight_Event_PlayerFreedGnoll = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:9f4a8fdb-1dbb-fbab-5ad8-aff87516189a
msgctxt "hd719381bge67ag429fgbf57g6405b0389cc9"
msgid ""
"*To your surprise, instead of ravishing you, he grovels with a howl of "
"pining awe.*"
msgstr "*놀랍게도, 녀석은 당신에게 달려드는 대신 경외를 담아 울부짖으며 복종을 표합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = a7e71352-baca-4cdf-aaf2-894c684a549d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:a7e71352-baca-4cdf-aaf2-894c684a549d
msgctxt "hb8245b67g5241g483bgbdf4gdfdbd1625bc7"
msgid "Now, now, Barnabus - <i>behave.</i>"
msgstr "자, 자, 바나버스. <i>착하지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = a9366e7e-ce3e-4ba2-9728-40b91314b510
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:a9366e7e-ce3e-4ba2-9728-40b91314b510
msgctxt "h2978724dg8afcg40c9gb13agd34a7141ce37"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = aa766176-21bc-41a3-8640-a1c414083a96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:aa766176-21bc-41a3-8640-a1c414083a96
msgctxt "h287ae666gdfe1g4f71gac8eg7afa0425b560"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = b1d1242e-e7f1-4ea1-9450-4859d56f6b03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:b1d1242e-e7f1-4ea1-9450-4859d56f6b03
msgctxt "h5d8920f2g0508g4f4bgbf20g7df5103f070b"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = b799e848-5b28-4144-b44b-e492186ff1e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:b799e848-5b28-4144-b44b-e492186ff1e0
msgctxt "h0319d360g56c4g4e3fg8038ge0acbf5ae874"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = c5b781b8-36b4-5987-87d1-4563f700607e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:c5b781b8-36b4-5987-87d1-4563f700607e
msgctxt "h82dbef45g2131g4302gb568g838b7e23be98"
msgid "Eugh, get away from me!"
msgstr "으엑, 저리 꺼져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = caf52ee9-d527-3a61-718c-a6fd30138528
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:caf52ee9-d527-3a61-718c-a6fd30138528
msgctxt "hdd214cbbg5ffag47a5g939fg5561d310bebb"
msgid "Lord... baaaack."
msgstr "군주님... 돌아왔구나아아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = caf52ee9-d527-3a61-718c-a6fd30138528
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:caf52ee9-d527-3a61-718c-a6fd30138528
msgctxt "hb85ba0c1gd80dg440egbd09g7837fb3f61e0"
msgid "Lady... baaaack."
msgstr "여군주님... 돌아왔구나아아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = caf52ee9-d527-3a61-718c-a6fd30138528
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:caf52ee9-d527-3a61-718c-a6fd30138528
msgctxt "hc0b7cfb5g2d60g4535gbe03g627b76d82735"
msgid "Holy one... baaaack."
msgstr "신의 사도가... 돌아왔구나아아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = cb5c8d3d-424d-f037-1557-6e5581b9343d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Kitchen_State_GnollsAreFree = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:cb5c8d3d-424d-f037-1557-6e5581b9343d
msgctxt "hf169e3e5gce02g4e7cg9534gdbe6d21876f4"
msgid "*Howl.*"
msgstr "*울부짖음.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = cf4aa948-fb39-4e99-8a01-f4dc2489a0bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:cf4aa948-fb39-4e99-8a01-f4dc2489a0bf
msgctxt "h2f813cf0g23a4g4f74gb1a1g910ca505704f"
msgid ""
"*You focus on the source of the power, but it is quiet and still. It needs "
"to rest.*"
msgstr "*힘의 원천인 존재에 정신을 집중하지만, 응답이 없습니다. 휴식이 필요한 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Narrator
#. NodeID = d827544e-9a73-40bb-bd3b-babba8c7a702
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:d827544e-9a73-40bb-bd3b-babba8c7a702
msgctxt "h9e85b69dg045eg4cfeg97d5gb031f67a05b2"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = dee4be57-c392-c6c2-5bd4-a38c6d26efa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:dee4be57-c392-c6c2-5bd4-a38c6d26efa9
msgctxt "h2f720485gb50ag4a7fg8367gd649879228dd"
msgid "Many-many die."
msgstr "많이, 많이 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = e2fc9047-1153-3ba0-326f-26709f380859
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. TagRule: BARBARIAN
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:e2fc9047-1153-3ba0-326f-26709f380859
msgctxt "hf64b3a46g42bbg4a1egb581g181eb72947d9"
msgid "<i>Match it growl for growl.</i>"
msgstr "<i>같이 으르렁거린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = e2fc9047-1153-3ba0-326f-26709f380859
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:e2fc9047-1153-3ba0-326f-26709f380859
msgctxt "hc458281bgecc4g4b1fg872fgb18c5e8a7c84"
msgid "Try it - I dare you."
msgstr "해봐. 해보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = e8725333-6237-41eb-8db0-f35675a14bc9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Kitchen_State_GnollsAreFree = True
#.     - MOO_KitchenFight_Event_PlayerFreedGnoll = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:e8725333-6237-41eb-8db0-f35675a14bc9
msgctxt "h066b2ea1gdd89g46dbg870cgc733dc126a59"
msgid "*Whine.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = Player
#. NodeID = edcf714a-5f38-e5d1-62b1-3c2068b3b455
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:edcf714a-5f38-e5d1-62b1-3c2068b3b455
msgctxt "h4d36de14g6a14g4949g8f77g63d5c4f9ba7f"
msgid "No need to wait any longer, gnollies, there's <i>blood </i>coming soon."
msgstr "더 이상 기다리지 않아도 된단다, 아이들아. <i>피를 볼 날</i>이 머지않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = fc246d23-a1b1-b492-9b33-5d4fdd2d979a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Kitchen_State_GnollsAreFree = True
#.     - MOO_KitchenFight_State_PlayerShownKidness = True
#.     - MOO_KitchenFight_Event_PlayerFreedGnoll = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:fc246d23-a1b1-b492-9b33-5d4fdd2d979a
msgctxt "h1200fcbag84a8g43bcg95d7g142995d58aec"
msgid "Th... aaaaank... <i>you</i>..."
msgstr "고...마아아... <i>워</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack
#. Speaker = 'Barnabus'
#. NodeID = ff9bc713-e12f-398b-d597-bc45bb355e57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollAttack:ff9bc713-e12f-398b-d597-bc45bb355e57
msgctxt "h20c37e0dg7eafg47f7g8bb8g4fd3dd88de0b"
msgid "Schlurp. Awoo!"
msgstr "츄릅. 아우우!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 029b04c4-6719-238c-d78a-35b5c1a3b8a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:029b04c4-6719-238c-d78a-35b5c1a3b8a4
msgctxt "he9dce9b1g0b49g4f64g8dcfgd4176f8593eb"
msgid "How do I get to meet the Absolute?"
msgstr "어떻게 하면 절대자님을 뵐 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 08e2298a-49c8-7329-018a-54823a99d2e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:08e2298a-49c8-7329-018a-54823a99d2e5
msgctxt "hbd5fa791gcf52g4a4cgafcdg3209159a521f"
msgid ""
"Please Z'rell, and you will be called to ascend to the tower-top. Many have "
"gone before you."
msgstr "즈렐의 비위를 맞춰봐, 그러면 탑 꼭대기로 올라오라는 부름을 받을 수 있을 거야. 너보다 먼저 올라간 사람들이 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 0bcff832-6e13-2ff3-611b-356b74916d66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:0bcff832-6e13-2ff3-611b-356b74916d66
msgctxt "hd03b3bb7ge695g4023ga61ag01c3f645f8ca"
msgid "How about a dance?"
msgstr "춤 출 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = 'Barnabus'
#. NodeID = 0cbf8356-8257-7df4-176a-aab069160eb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:0cbf8356-8257-7df4-176a-aab069160eb8
msgctxt "hf44714c8g04ffg4582ga29egd9b357bf599f"
msgid "*Soft hoot.*"
msgstr "*가벼운 웃음.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 0d3262b3-99bb-9a46-33a6-45de689b2aa0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_ResistedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:0d3262b3-99bb-9a46-33a6-45de689b2aa0
msgctxt "h736e61ccg92abg453dga3dfgb3354dfb9b74"
msgid "<i>Put aside dreams of mincing her. Help her take back control.</i>"
msgstr "<i>그녀를 갈아버리고 싶은 마음은 접어두고. 다시 통제권을 찾는 걸 도와준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 10d38aaf-2d27-5461-fd76-2108604aa825
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:10d38aaf-2d27-5461-fd76-2108604aa825
msgctxt "h482f62f1g1683g4883gb605ga3ad61a0e3df"
msgid "Now... Barnabus, darling... NO!"
msgstr "이런... 바나버스, 얘야... <b>안 돼</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 161a84f8-f77e-7a7e-d463-8c09355abea3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:161a84f8-f77e-7a7e-d463-8c09355abea3
msgctxt "h9ab192dcg6f21g44b3g8a88gec072da49587"
msgid ""
"Their will has <i>always </i>been Hers to command. I am simply putting it "
"back where it belongs. Behold:"
msgstr "그들의 의지는 <i>언제나</i> 그 분의 명령아래 있는 더야. 난 단순히 원래 자리로 돌려놓는 것뿐이지. 잘 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 1e0256ab-97ec-6108-78c0-2a6e17e23bf1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KitchenFight_State_SeenPower = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:1e0256ab-97ec-6108-78c0-2a6e17e23bf1
msgctxt "h2f886089gd1beg4f93gae52g5903a622514f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 1f707e5e-8833-0a4c-ed7f-3c4a4b5764b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:1f707e5e-8833-0a4c-ed7f-3c4a4b5764b0
msgctxt "h47983ab1g06b1g472fg94edg1889f4d31a9d"
msgid "Gnolls are beasts, plain and simple."
msgstr "놀은 짐승이다, 명확하고 간단하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 200566e2-6e32-4383-4f47-7c9953c6bfc0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_Kitchen_State_GnollIsEntertaining(2) = False
#.     - MOO_KitchenFight_Event_GiveReward(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:200566e2-6e32-4383-4f47-7c9953c6bfc0
msgctxt "hc60cd5e0g7b4ag4e10gaa82g8ddc87874b2e"
msgid ""
"Here. I meant this as a treat for Barnabus, but he doesn't deserve it now."
msgstr "여기. 원래는 바나버스에게 선물로 주려고 했던 건데, 아직 받을 자격이 안 되는 것 같아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 26ddbe18-d444-8a90-cc83-2e92e31807f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:26ddbe18-d444-8a90-cc83-2e92e31807f4
msgctxt "h9963f80fgaa55g4c9cga569ga8f837cb1810"
msgid "You've actually stood before the Absolute?"
msgstr "진짜 절대자를 대면한 적이 있다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 2a34cb70-a731-cbeb-8344-56739b0d863b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:2a34cb70-a731-cbeb-8344-56739b0d863b
msgctxt "h1d2a9aa1g508bg4a58g833ag2b1d17e6e9c9"
msgid "If you return at all."
msgstr "적어도 돌아오기만 한다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 2d280db6-3a58-fdbe-66eb-7c66df44dda7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c0af7175-e75f-06d3-0e38-dbe52b668dc1_MOO_KitchenFight_State_GaveReward = False
#. SetFlags:
#.   Local:
#.     - c0af7175-e75f-06d3-0e38-dbe52b668dc1_MOO_KitchenFight_State_GaveReward = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:2d280db6-3a58-fdbe-66eb-7c66df44dda7
msgctxt "heb918306g3f86g479cgbd58gd07999438b45"
msgid ""
"Hah. For all the power She lends us... I am still only an imperfect vessel."
msgstr "하. 그 분께서 주신 힘이 있어도... 난 여전히 불완전한 그릇이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 2d676c4a-7239-a658-f6c7-8dbc9ca56d13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:2d676c4a-7239-a658-f6c7-8dbc9ca56d13
msgctxt "h00073ae9g5609g4a39g8d56g5ab0e8aebbe0"
msgid "Oh? As you wish."
msgstr "오? 그렇다면야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 2e7b9c55-1e8d-338c-8560-173e83617c27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:2e7b9c55-1e8d-338c-8560-173e83617c27
msgctxt "h04533e8fgbbb0g4153gb17egeae523c6724a"
msgid "Aw - you'd like that, wouldn't you, Barnabus?"
msgstr "오, 너도 괜찮지, 바나버스?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 35aed102-931f-54a6-8d05-7d21d4902ca3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:35aed102-931f-54a6-8d05-7d21d4902ca3
msgctxt "h9933e3d1ge545g4426gbc71g0a2e79d04ead"
msgid "<i>Reinforce her efforts with your own.</i>"
msgstr "<i>힘을 보태 애쓰는 그녀를 돕는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 406457d4-ca76-6f9c-6e33-6e8a09b47d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:406457d4-ca76-6f9c-6e33-6e8a09b47d7e
msgctxt "h07955e62gbe27g4b75g8819g123d9c849ceb"
msgid ""
"He isn't the first to die. Her love is simply too much for some. I hope you "
"will fare better, when your time comes."
msgstr ""
"죽은 게 쟤가 처음은 아니야. 단지 그 분의 사랑이 누군가에게 너무 과분하기도 한 거지. 네 차례가 오면, 네가 더 잘했으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = 'Barnabus'
#. NodeID = 43842c01-b7a4-2a10-470d-56d39c9a8388
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:43842c01-b7a4-2a10-470d-56d39c9a8388
msgctxt "hc70e6747g9136g4823gbe2cg08d4d0c5cc4d"
msgid "...M... any... heaaarts... one... <i>soul</i>..."
msgstr "...마...많은...마아음...하나... <i>영혼</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 443d23e1-12f7-55ef-8a71-4353907ec70b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:443d23e1-12f7-55ef-8a71-4353907ec70b
msgctxt "h26cc84f7gd6c2g485cga26eg9e25fe68f31e"
msgid "What would you like him to do?"
msgstr "뭘 시켜볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 49b3819f-6656-e2ba-5215-d43f7ff58be3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_KitchenFight_HasMet_GnollMaster(1) = True
#.   Global:
#.      - MOO_KitchenFight_State_SeenPower = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:49b3819f-6656-e2ba-5215-d43f7ff58be3
msgctxt "hb8e1b3bcg975bg41d2gb661ge2538222ff58"
msgid "Go on now, friend. It seems I must have a stern chat with Barnabus."
msgstr "이제 가봐, 친구. 바나버스랑 진지한 대화를 나눠야 할 것 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 4cd68426-c231-9944-d74a-2a6b44992d6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:4cd68426-c231-9944-d74a-2a6b44992d6b
msgctxt "h9c877a27g9d6ag4fdeg92b6ga7d584bdc467"
msgid ""
"You use a <i>spoon</i> to stir the soup, Barnabus. Forget the axe, my "
"darling."
msgstr "수프를 저을 땐 <i>숟가락</i>을 써, 바나버스. 도끼는 아니야, 내 사랑."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 4d24df4e-fdd4-b687-4911-30772a65c494
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 16
#. SetFlags:
#.   Object:
#.     - MOO_Kitchen_Event_PlayerInterfered(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:4d24df4e-fdd4-b687-4911-30772a65c494
msgctxt "hbdb46599g7e42g4baag9cf4ged13ef1653d5"
msgid "<i>Compel the gnolls to pulp their master.</i>"
msgstr "<i>놀에게 주인을 곤죽으로 만들어 버리도록 강제한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 4d24df4e-fdd4-b687-4911-30772a65c494
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 16
#. SetFlags:
#.   Object:
#.     - MOO_Kitchen_Event_PlayerInterfered(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:4d24df4e-fdd4-b687-4911-30772a65c494
msgctxt "h560e976bge3b3g42a1ga62cg3c6549988a09"
msgid "<i>Sever her control once and for all.</i>"
msgstr "<i>그녀의 통제권을 완전히 끊어버린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 4df4e56f-615f-ff90-08a2-96ff10c2e579
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_KitchenFight_HasMet_GnollMaster(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:4df4e56f-615f-ff90-08a2-96ff10c2e579
msgctxt "h3433fd4ag3bd3g41a6g9dbbg50d971df23d6"
msgid "A moment, True Soul."
msgstr "참된 영혼, 잠시만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Narrator
#. NodeID = 4e75966a-650a-391a-3711-acfeff2e7f3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:4e75966a-650a-391a-3711-acfeff2e7f3b
msgctxt "h8b5ecc16g93deg491fg91c7g4cd73e5f72b9"
msgid ""
"*You feel her will surge outwards and envelop the creature, inexorable as "
"the tide.*"
msgstr "*당신은 그녀의 의지가 퍼져나가 괴물을 뒤덮는 것을 느낍니다, 거침없기가 파도와 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 576f09c7-7fc2-1774-f52d-736571e7cb87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_KitchenFight_HasMet_GnollMaster(1) = True
#.   Global:
#.      - MOO_KitchenFight_State_SeenPower = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:576f09c7-7fc2-1774-f52d-736571e7cb87
msgctxt "h3de2ba62g7c1fg4d49g8369g9bec093b650f"
msgid "Yes? Barnabus and the boys get antsy if I'm distracted for too long."
msgstr "응? 바나버스랑 다른 애들은 내가 너무 오래 신경을 못써주면 안달나거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 5870cd11-49bf-bc04-031c-3cc831323354
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:5870cd11-49bf-bc04-031c-3cc831323354
msgctxt "h96d50d14g858eg413dgb20cg7a2c05d04da2"
msgid "Nothing. Keep your sick games to yourself."
msgstr "별로. 구역질나는 놀이는 너 혼자서 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 5c19fe32-4932-ec6e-b918-3ba7db45e283
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:5c19fe32-4932-ec6e-b918-3ba7db45e283
msgctxt "h2413f5cegb72dg4f1egb6cbg7b7d6fb52ed4"
msgid "A little advice - should you seek an audience with Her, steel yourself."
msgstr "한 가지 조언할게, 그 분을 알현할 생각이면, 단단히 준비해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 600d34b5-abc2-1071-bb71-5d9084161f25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:600d34b5-abc2-1071-bb71-5d9084161f25
msgctxt "h4277cac0g7bb2g499ag862cg6c83848eab86"
msgid ""
"I have. It is one thing to hear Her voice. Quite another to feel the "
"<i>power</i> She can grant. Observe:"
msgstr "물론이지. 그 분의 목소리를 듣는 것과, 그 분께서 허락하신 <i>힘</i>을 느끼는 건 완전히 다른 얘기거든. 잘 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 6172812b-a369-6022-2a07-0bb8f4a980e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c0af7175-e75f-06d3-0e38-dbe52b668dc1_MOO_KitchenFight_State_GaveReward = True
#. SetFlags:
#.   Object:
#.     - MOO_Kitchen_State_GnollIsEntertaining(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:6172812b-a369-6022-2a07-0bb8f4a980e3
msgctxt "hdb50c03bg1effg4af5g8a94ga0891f6b5ea5"
msgid ""
"Hah. For all the power She lends us... I am still only an imperfect vessel. "
"You will fare better when your time comes, I think."
msgstr "하. 그 분께서 주신 힘이 있어도... 난 여전히 불완전한 그릇이네. 넌 때가 오면 더 잘할 거야, 내 생각엔 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 68c31e5a-119b-e217-c251-ef1df4bcf139
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:68c31e5a-119b-e217-c251-ef1df4bcf139
msgctxt "h4f73c682gb974g49cbg9118g988c308ec42d"
msgid "I've shown Barnabus a kinder way. A kinder name is only fitting."
msgstr "내가 바나버스한테 친근하게 대하는 법을 알려줬거든. 그러니 친근한 이름이 어울릴 거 같아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 6c32ef5d-4410-c0a4-a808-d70ca86aea35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:6c32ef5d-4410-c0a4-a808-d70ca86aea35
msgctxt "h01af080fgf6dfg448cgb464g8f56407f9c01"
msgid "You decide."
msgstr "네가 정해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 6db0578d-bbd1-3ed6-5c8b-4bea34dbd79c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:6db0578d-bbd1-3ed6-5c8b-4bea34dbd79c
msgctxt "h409b4c88ge5b4g41f2ga345ge3bdd38f7413"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 7f35778a-586b-1078-4b3d-d7cb54bfe50f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:7f35778a-586b-1078-4b3d-d7cb54bfe50f
msgctxt "h8bdb67f1gd59bg4f4fg8906g21167f11db50"
msgid ""
"Praise Her <i>works</i> - committed by the hands of Her faithful. Observe:"
msgstr "신도들의 손으로 이루어 낸 그 분의 <i>업적</i>을 찬양하라. 잘 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 81e32b9a-7e12-eaa9-b696-52d7b8c7a769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:81e32b9a-7e12-eaa9-b696-52d7b8c7a769
msgctxt "h5eba650fg25b9g4440ga35agfd465f46b720"
msgid ""
"Soft and sweet as pudding, isn't he? He no longer remembers his life in the "
"wild."
msgstr "푸딩처럼 부드럽고 달콤하지 않아? 이제 야생에서 살았다는 걸 기억하지도 못 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 828023f6-c978-7ea6-bc85-88f4ec076562
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:828023f6-c978-7ea6-bc85-88f4ec076562
msgctxt "h82af9d3dga74fg41f7g94b0g875ffd868714"
msgid ""
"...The prayer, I think. Barnabus struggles with civilised speech, but he's "
"been practising."
msgstr "...기도는 어떨까. 바나버스는 우리가 쓰는 말을 하는데 어려움을 겪고 있지만, 계속 연습 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 830c13c1-144b-6ff4-8c17-40e8c03ae9a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:830c13c1-144b-6ff4-8c17-40e8c03ae9a9
msgctxt "h617f9b4fg57c6g4e68g9355g498e571c4c8c"
msgid "You ascend the tower as a True Soul, and return as something more."
msgstr "참된 영혼으로써 탑에 오르고, 더 나은 무언가가 되어 돌아오게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 8a4553c3-b263-f952-258b-b7e5b28d2e7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_KitchenFight_UserShortcut(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:8a4553c3-b263-f952-258b-b7e5b28d2e7a
msgctxt "h7e09004bg683fg409cg9a43g479de62c8143"
msgid "'Barnabus'...?"
msgstr "'바나버스'...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 8b9fb2af-9d1d-5de1-3605-8f0f46de608a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KitchenFight_State_SeenPower = False
#.   Object:
#.      - MOO_KitchenFight_UserShortcut(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:8b9fb2af-9d1d-5de1-3605-8f0f46de608a
msgctxt "hdd0041aeg3b05g4d04gae99gb83cafaec49c"
msgid "This gift you mentioned. I'd like to see it after all."
msgstr "네가 말한 선물말이야. 그게 보고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 8d663d27-e9ec-cdac-02bc-eabc453adbf2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KitchenFight_State_SeenPower = True
#.     - MOO_KitchenFight_Knows_GnollMasterPower = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:8d663d27-e9ec-cdac-02bc-eabc453adbf2
msgctxt "hde5d2015g66c0g41f4gaefcg6ed4f6f9c037"
msgid "NO, Barnabus! <i>We talked about this.</i>"
msgstr "<b>안돼</b>, 바나버스! <i>그러지 않기로 했잖아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Narrator
#. NodeID = 9140e9bb-0441-88ef-2cb1-072383f965e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Entertainer_RegainedControlGnoll = True
#.     - MOO_Background_Charlatan_GnollInfluence = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:9140e9bb-0441-88ef-2cb1-072383f965e4
msgctxt "hb7edebf5g1af1g4001g9545gd307d71c03c5"
msgid ""
"*The weight of the assault drives the gnoll to his knees, defiance melting "
"away like snow in summer.*"
msgstr "*갑작스런 공격의 압력이 놀을 무릎 꿇도록 몰아 붙였고, 반항심은 여름철 눈 녹듯 사라집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = 98628af5-799f-77f7-cdd1-1a941015c35e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:98628af5-799f-77f7-cdd1-1a941015c35e
msgctxt "h80f913f4g2ea4g45a9g8bf4g0878abbc1de9"
msgid "Oh, Barnabus. I'm so sorry, my darling."
msgstr "아, 바나버스. 정말 미안하다, 얘야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = 9a999862-4e1e-39a2-f2e7-32bb27610dea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_KitchenFight_UserShortcut(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:9a999862-4e1e-39a2-f2e7-32bb27610dea
msgctxt "hf3ead542g7f45g4d8eg91dbg2d0e055599dd"
msgid "I've never seen a tame gnoll before."
msgstr "길들여진 놀은 처음 보는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = a11cfa72-b482-3d86-47ee-48fa0fc5fde4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:a11cfa72-b482-3d86-47ee-48fa0fc5fde4
msgctxt "hce88f8d0gd4aag47cfga0e5g5c3b3437338a"
msgid ""
"She gathers many threads for Her Design - but it is still <i>Her </i>Design. "
"And Barnabus has found his place in it. Observe:"
msgstr ""
"그분의 설계에는 여러 종류의 실이 필요해, 그렇지만 여전히 <i>그분</i>의 설계인 건 마찬가지야. 바나버스도 자기 자리를 찾았고. "
"보라구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Narrator
#. NodeID = a549afc9-100c-f9d2-b6b1-4eb9f114a03d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_KitchenFight_Event_GnollDied(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:a549afc9-100c-f9d2-b6b1-4eb9f114a03d
msgctxt "h9a1ce00bge3c5g4f91g838bg032fc565fc66"
msgid ""
"*They battle silently for a long moment, the gnoll's heart <i>drumming </"
"i>with strain. Then all at once, his heart stops.*"
msgstr ""
"*오랫동안 그들은 조용한 싸움을 이어갑니다, 놀의 심장이 압박감으로 <i>쿵쿵거립니다</i>. 그러다 한순간에, 심장이 멈춥니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = a8af3221-6b00-5b42-20de-879b55af0a85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:a8af3221-6b00-5b42-20de-879b55af0a85
msgctxt "h9517900ag472ag4c8dg9dc6ge5d37713f4fe"
msgid "To be remade, we must be willing to suffer."
msgstr "다시 태어나려면, 고통을 감내해야 하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = a9ea0241-37e1-7a61-6d2e-761f6d2decc4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AudienceGrantsPower = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:a9ea0241-37e1-7a61-6d2e-761f6d2decc4
msgctxt "h539eeb90g7920g4da3g9e70ge7fec6abbf0f"
msgid ""
"That is the gift the Absolute gave me, when I stood before Her. To rewrite "
"the lives of Her faithful - make them believe they are something "
"<i>better</i>."
msgstr ""
"이게 바로 내가 그분을 마주했을 때, 그분께서 내게 주신 선물이야. 신도들의 삶을 새로 쓰고, 그들이 <i>더 나은</i> 존재라고 믿게 "
"하는 능력이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = aa1c698a-bc1b-697c-bbe7-e263e09dfa2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:aa1c698a-bc1b-697c-bbe7-e263e09dfa2b
msgctxt "hde7f5c43g5004g4bbeg95a7g8f840d61b2aa"
msgid "You mean you enslave people."
msgstr "사람들을 노예로 삼는다는 뜻이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = 'Barnabus'
#. NodeID = b39846de-2e5b-6781-7fa7-0bd31ee1040b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:b39846de-2e5b-6781-7fa7-0bd31ee1040b
msgctxt "h20e09663g4a1ag4337gbdeeg5e5e6ed48f96"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = b6d7e1b5-7ac0-44bd-4e3c-8ca471df048e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:b6d7e1b5-7ac0-44bd-4e3c-8ca471df048e
msgctxt "h947fa223g294dg4096g813bgf70408f78935"
msgid "Heart-warming. Praise Her name."
msgstr "마음이 따뜻해지는군. 그 분의 이름을 찬양하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = bc02f545-2710-e36b-f51f-7016048fd855
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:bc02f545-2710-e36b-f51f-7016048fd855
msgctxt "h16699a43g601eg458dga034g31288c7ecd2b"
msgid "I thought the Absolute accepted us all as we are."
msgstr "절대자께선 우릴 있는 그대로 받아들이시는 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = 'Barnabus'
#. NodeID = c484c5fb-810b-e53e-5b77-7128da93aa52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:c484c5fb-810b-e53e-5b77-7128da93aa52
msgctxt "hc3810647g8da7g44b1g84b5gdf9b52cd713d"
msgid "*Whine.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = c50d3485-38fa-3f9d-0bf3-7245bd05ab3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:c50d3485-38fa-3f9d-0bf3-7245bd05ab3c
msgctxt "hc08adc95gbe10g470dg9feagea798a2a959e"
msgid "Now! How can I help you?"
msgstr "자! 뭘 도와줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = ca68cc1e-3209-74d6-4c65-9d8ca2a1ad59
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_Kitchen_State_GnollIsEntertaining(2) = True
#.     - MOO_KitchenFight_UserShortcut(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:ca68cc1e-3209-74d6-4c65-9d8ca2a1ad59
msgctxt "hc5b22515g59a8g4571g9de4ga9a5999966c6"
msgid "Barnabus, sweetie! Come show what a good boy you are."
msgstr "바나버스, 얘야! 네가 얼마나 착한 아이인지 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = ca9c06c6-7862-e01b-734f-c13f423b23fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:ca9c06c6-7862-e01b-734f-c13f423b23fd
msgctxt "h9536a721geb73g412cgb833gbd5529fd1883"
msgid "Though not all have returned."
msgstr "비록 모두가 돌아온 건 아니지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Narrator
#. NodeID = cea31f92-54e8-5cab-9d5c-95e02ed0739a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BreakFreeGnolls = True
#.     - MOO_Background_Charlatan_GnollInfluence = True
#.     - MOO_Kitchen_State_AttackedTrueSoul = True
#.     - MOO_Background_HauntedOne_BreakControl = True
#.   Object:
#.     - CharacterDieAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:cea31f92-54e8-5cab-9d5c-95e02ed0739a
msgctxt "hd2faa5b2g850fg4b55g868cgd97d455dc1a7"
msgid ""
"*Like rope drawn taut beneath the blade, the connection simply... snaps.*"
msgstr "*칼날 위의 팽팽히 당겨진 밧줄처럼, 연결이... 툭하고 끊어집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = df4eda4e-1855-7f6f-0be8-856c405b2913
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:df4eda4e-1855-7f6f-0be8-856c405b2913
msgctxt "h97dd42fbg6ac1g4f17g82bagd6e87dcdd380"
msgid "You'll do well when you meet with the Absolute, I think."
msgstr "절대자님을 뵐 때 넌 더 잘할 수 있을 거야, 그렇게 생각해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Linsella
#. NodeID = e054971e-0488-daf0-e8f1-00658096b9e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:e054971e-0488-daf0-e8f1-00658096b9e2
msgctxt "h8003145dg81ffg43c9g98e5g8a246f8baf5b"
msgid ""
"Oh, the good is buried deeper in some, that is true. But She will always "
"find it."
msgstr "오, 좋은 면이 좀 더 깊이 묻혀 있는 사람도 있는 법이지, 그건 사실이야. 하지만 그 분께선 언제나 찾아내셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = 'Barnabus'
#. NodeID = e61220d7-ee72-c47c-581e-e4e940874569
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:e61220d7-ee72-c47c-581e-e4e940874569
msgctxt "hbb9e9573g2292g4f4fg8f67gb8b6fa889174"
msgid "<i>Ughhh.</i>"
msgstr "<i>으윽.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = f712b5fc-f1fd-140c-e2b3-efe915a2c9b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:f712b5fc-f1fd-140c-e2b3-efe915a2c9b3
msgctxt "hf5435fbag65f7g46c5g9f46gc8daa8284503"
msgid "It seems you're not as commanding as you think."
msgstr "생각보다는 명령이 잘 안먹히나 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster
#. Speaker = Player
#. NodeID = fb87d607-bc61-6b73-0468-cc556ab9337d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_GnollMaster:fb87d607-bc61-6b73-0468-cc556ab9337d
msgctxt "h27278723g1f12g4a8fga2e0g123b2ad84c8b"
msgid "You almost make this audience sound dangerous."
msgstr "얼핏 알현이 위험하다는 얘기로 들리는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_MasterGrieving
#. Speaker = Linsella
#. NodeID = 1d74b79e-07ec-4d2f-9f96-612fc5f4dfd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_MasterGrieving:1d74b79e-07ec-4d2f-9f96-612fc5f4dfd9
msgctxt "hb1ea3c2cg693bg4e3bga1fdg386baf2bb471"
msgid "Poor Barnabus. I'll have to find another favourite."
msgstr "불쌍한 바나버스. 다른 아이를 찾아봐야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kitchen_AD_Gnoll00
