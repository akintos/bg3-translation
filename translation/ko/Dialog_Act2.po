#.      - Hirelings_State_InCamp_1 = True
#.      - Hirelings_State_InCamp_3 = False
#.      - Hirelings_State_InCamp_2 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:b8cedc02-e793-44b8-1309-8c22bf72910e
msgctxt "he1d4f978geaf0g4ef3gbdb0g864d911b9f83"
msgid "One of thy hirelings waits in thy camp."
msgstr "그대의 용병 중 하나가 야영지에서 기다리고 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
