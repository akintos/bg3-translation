msgctxt "h0bdac032g4fd4g4427g947eg0d48e89f7064"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = d04c75b2-c6d8-f4a4-eb5f-2da6e18181ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:d04c75b2-c6d8-f4a4-eb5f-2da6e18181ef
msgctxt "ha8a3b5edg41e6g4f6eg918fge23d0681b002"
msgid "Squad... captured... enlightened..."
msgstr "부대가... 생포됨... 계몽되었음..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
