msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Blighted Actor
#. NodeID = 6d75d0e5-71d9-423f-3917-b39c7656bab0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04:6d75d0e5-71d9-423f-3917-b39c7656bab0
msgctxt "h4594cf97g3946g4146g96acg913df7ca53ae"
msgid ""
"Baldur's Gate! Where the streets sparkle with silver, and the actors have "
"jobs. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Blighted Actor
