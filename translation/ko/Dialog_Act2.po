#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_C = True
#. SetFlags:
#.   Local:
#.     - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_B = False
#.     - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_C = False
#.     - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:1b1c74d4-85dd-48f4-a6ed-f93bd54894c3
msgctxt "h03b4eb60g1104g4709g91f8g8a2bf7d37d7d"
msgid "Get your ragged tail back here, Rolan - and fast."
msgstr "해진 꼬리 끌고 돌아와, 롤란. 빨리."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
#. NodeID = 2173f664-3f88-450e-a333-5b0e02a71239
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_B = True
#. SetFlags:
#.   Local:
#.     - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:2173f664-3f88-450e-a333-5b0e02a71239
msgctxt "h8d3d443bgb7e9g4fc5gb5e8g4d345a02758e"
msgid ""
"What would Cal say? Heh. Probably to trust that Rolan knows what he's doing."
msgstr "칼은 뭐라고 말할까? 헤. 아마 롤란은 자기가 뭘 하는지 알고 있다 믿었겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
#. NodeID = 3595cb33-d643-41f2-bc0c-9e9143b89e4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:3595cb33-d643-41f2-bc0c-9e9143b89e4a
msgctxt "h47a0a3d2g1c58g412bg992bgfb14df732ea8"
msgid "Of course Rolan isn't here. Of course!"
msgstr "롤란이 여기 있을 리 없지. 그럼 그렇지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
#. NodeID = 3f86daa3-84c2-5010-4dc8-825a5502c964
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:3f86daa3-84c2-5010-4dc8-825a5502c964
msgctxt "h2f6f2052gcdb0g4d5bg94d1g8110651e5796"
msgid "'Our little brother is dead, but hey I'm still here?' Gods."
msgstr "'우리 작은 동생은 죽었지만, 여기 좀 봐, 아직 내가 있어?' 맙소사."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
#. NodeID = 60a870e3-4822-315c-f9f7-325edc746c01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:60a870e3-4822-315c-f9f7-325edc746c01
msgctxt "h7ab32cd7ga207g4f04g8bfag06bf2246fd62"
msgid "Cal... what am I going to tell Rolan?"
msgstr "칼... 롤란에게 뭐라고 말하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
#. NodeID = 9eeb6d01-982e-4c96-871c-cd24c28732cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_A = True
#. SetFlags:
#.   Local:
#.     - 6d9043f1-e0c3-43de-a895-b87cae60e0c0_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:9eeb6d01-982e-4c96-871c-cd24c28732cb
msgctxt "hdc6b7a1age685g4384g8911g71c554216a27"
msgid ""
"I swear, Rolan, if you're bleeding out on some patch of cursed darkness "
"while I'm here..."
msgstr "맹세하겠어, 롤란. 내가 여기 있는 동안 네가 저주받은 어둠 속에서 피흘리고 있다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
#. NodeID = ba9263a1-8bb8-8850-7c1c-ab4be190b047
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:ba9263a1-8bb8-8850-7c1c-ab4be190b047
msgctxt "h2e5c0257gc5d5g44edgbce4gd4815f9413fc"
msgid "Gods help something being simple for once in our bloody lives!"
msgstr "신이시여, 빌어먹을 우리 삶에서 단 한 번만이라도 좀 단순하게 도와주세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
#. NodeID = bceeb69f-f0bc-1092-8488-878b41fec872
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone:bceeb69f-f0bc-1092-8488-878b41fec872
msgctxt "h781e6069g179fg41fegb220g4855cd7c90b4"
msgid ""
"I should look for him. But what if he comes back and I'm gone? <i>Argh.</i>"
msgstr "찾으러 가야하는데. 하지만 내가 찾으러 나가있는 동안 돌아온다면 어떡하지? <i>끄응.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Cal
#. NodeID = 185cc974-85a3-4a6d-bb92-ca939b6c1faf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1437add2-2ff6-24f2-3941-79ea2761444c_C = True
#. SetFlags:
#.   Local:
#.     - 1437add2-2ff6-24f2-3941-79ea2761444c_C = False
#.     - 1437add2-2ff6-24f2-3941-79ea2761444c_B = False
#.     - 1437add2-2ff6-24f2-3941-79ea2761444c_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:185cc974-85a3-4a6d-bb92-ca939b6c1faf
msgctxt "heda214f7g1696g4988gaaf0g75d13cda4973"
msgid "What if one of us stays here while the other looks for Rolan?"
msgstr "한 명이 여기 있는 동안 다른 한 명이 롤란을 찾아보는 건 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Lia
#. NodeID = 1d50580f-9026-45fc-b5de-f6c22824d734
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1437add2-2ff6-24f2-3941-79ea2761444c_B = True
#. SetFlags:
#.   Local:
#.     - 1437add2-2ff6-24f2-3941-79ea2761444c_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:1d50580f-9026-45fc-b5de-f6c22824d734
msgctxt "h1461d9e3g2c70g4fc7gbfbagdbafa1e8e060"
msgid "Damn it. Rolan couldn't have said where he was going?"
msgstr "젠장. 롤란 녀석, 어디로 갈 건지 말해주면 안 됐나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Lia
#. NodeID = 236486cf-f564-4f19-8081-88af4c598c8e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1437add2-2ff6-24f2-3941-79ea2761444c_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:236486cf-f564-4f19-8081-88af4c598c8e
msgctxt "h3b076250gf6e6g4f70gaa52g9f28aaefe61e"
msgid "Of course Rolan isn't here - <i>of course.</i>"
msgstr "롤란은 여기 없겠지, <i>그럼 그렇지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Lia
#. NodeID = 3f5a14be-f866-4df6-9d0e-eed48aa261b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:3f5a14be-f866-4df6-9d0e-eed48aa261b7
msgctxt "hfdfcd28ag1ec7g418ega12bg04c5aa89e303"
msgid "<i>Argh. </i>Why does everything go wrong?"
msgstr "<i>아윽.</i> 왜 모든 게 다 꼬이는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Cal
#. NodeID = aa9594e5-822d-4f36-8606-b3410e80619f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:aa9594e5-822d-4f36-8606-b3410e80619f
msgctxt "h229ed361gca8cg4bdbg80e5ga585fbf17aa7"
msgid "We'll figure this out, all right?"
msgstr "해결할 수 있을 거야, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Cal
#. NodeID = b0a55479-5c69-426e-9b42-2336ca352472
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:b0a55479-5c69-426e-9b42-2336ca352472
msgctxt "hb6085dc7gd5efg4058gb509g02e7fcbe2ce9"
msgid ""
"His message is out in the open - he probably didn't want the wrong ears to "
"listen in."
msgstr "롤란의 메시지는 공개된 장소에 있었어. 애먼 사람이 엿듣지 않기를 바랐겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Lia
#. NodeID = bde91292-262c-4c6b-8578-b8cd64beb138
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1437add2-2ff6-24f2-3941-79ea2761444c_A = True
#. SetFlags:
#.   Local:
#.     - 1437add2-2ff6-24f2-3941-79ea2761444c_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:bde91292-262c-4c6b-8578-b8cd64beb138
msgctxt "h547e9cabg518ag43c1g957eg97f6b5c4d5ad"
msgid "We don't even know how long Rolan's been gone."
msgstr "롤란이 얼마나 오래 떠나 있었는지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Cal
#. NodeID = c41e1957-d8eb-48da-9d40-a73f1dd67df7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:c41e1957-d8eb-48da-9d40-a73f1dd67df7
msgctxt "hf025101cg72fdg4911ga41dg3ed5bdc12d46"
msgid "Let's listen to the message again, maybe we missed something."
msgstr "롤란이 남긴 말을 다시 한 번 들어 보자, 뭔가 놓쳤을지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Lia
#. NodeID = d8542fe6-4e54-413d-b495-ad0ba1887114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:d8542fe6-4e54-413d-b495-ad0ba1887114
msgctxt "h22f49507g29b2g4c68ga7a2gcbfb1705132f"
msgid "No, we're not seperating again, not even for Rolan."
msgstr "아니, 다시 떨어지면 안 돼. 롤란을 찾기 위해서라고 할지라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan
#. Speaker = Cal
#. NodeID = fd9e859f-4263-44e0-a59a-33cd150885a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_WaitingForRolan:fd9e859f-4263-44e0-a59a-33cd150885a9
msgctxt "h2d039191ge5f3g4aa8ga5c7ga3cd3a193eab"
msgid ""
"Then we have to do as Rolan says, and sit tight. He'll come back - I know it."
msgstr "그럼 롤란 말대로 얌전히 앉아서 기다려야겠지. 롤란은 돌아올 거야. 난 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 18e990c0-3780-6dcf-b41f-59ba0c249ef8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Brother_RolanDead_HasMet(1) = False
#.   Global:
#.      - GLO_Prodigy_State_ToldSiblingsProdigyDead = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Brother_RolanDead_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:18e990c0-3780-6dcf-b41f-59ba0c249ef8
msgctxt "h43709eadg7662g42b8g9f58g0f2ab2ae8d08"
msgid "When you told me about Rolan, I didn't believe you. But it's true..."
msgstr "자네가 롤란에 대해 이야기했을 때 난 믿지 않았지. 허나 맞는 말이야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Player
#. NodeID = 229a8281-5e39-c29a-391a-3e037ab2d74f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:229a8281-5e39-c29a-391a-3e037ab2d74f
msgctxt "hdfae4c99g9f41g4672g9ff8g8a6a38b7b2ee"
msgid "I did what I could to save him."
msgstr "구하려고 최대한 노력했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 24f2e044-2f19-3d9f-efbf-35d0b7ee931d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Cal(1) = False
#.   Global:
#.      - HAV_SavingPrisoners_State_SisterReturned = False
#.      - HAV_ProdigyLament_State_ReunionDone = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Cal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:24f2e044-2f19-3d9f-efbf-35d0b7ee931d
msgctxt "h328bcae2g3db4g4a05gbf80g5f4fc0bd8fc0"
msgid ""
"Things will be rough, probably for a long time, but Rolan and I will be all "
"right - thanks to you."
msgstr "한동안은 상황이 좋지 않겠지. 그래도 자네 덕분에 롤란과 난 괜찮을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 26eacea9-3276-56b4-bf63-fd5caa1b70a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyBrother_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:26eacea9-3276-56b4-bf63-fd5caa1b70a6
msgctxt "hca7e8b7cgcc40g4722ga5cdg1b7796de9b74"
msgid "I hope all of this is coming to an end. We need a win - badly."
msgstr "이 모든 게 결말을 향해 가고 있었으면 하네. 우린 승리가 필요해. 절실히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 29e8ce28-f63e-a9b2-10b8-c0ee9b969740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:29e8ce28-f63e-a9b2-10b8-c0ee9b969740
msgctxt "hd44155a1g0645g49fbg9eceg714d22da0b66"
msgid ""
"I wish we were parting under better circumstances, but thank you for helping "
"us. I won't forget it."
msgstr "더 좋은 상황에 작별 인사를 나눴으면 하지만 도와줘서 고마워, 잊지 않을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 3583d21e-de3d-cfc6-b454-f2a4a196ae8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_State_RolanMissing_HasMet_Cal(1) = False
#.   Global:
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_State_RolanMissing_HasMet_Cal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:3583d21e-de3d-cfc6-b454-f2a4a196ae8e
msgctxt "h20432722g3ad9g4e5cgbeccg3eea253492b8"
msgid ""
"Lia's dead. Rolan is gods-knows-where. This couldn't have gone more wrong."
msgstr "리아는 죽었어. 롤란이 어딨는진 신만이 알겠지. 더 잘못될 구석이 있을까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 3ad32e64-76f8-a2a0-4760-a6a9094aa528
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Cal(1) = False
#.   Global:
#.      - HAV_ProdigyLament_Event_AngrySibling = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Cal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:3ad32e64-76f8-a2a0-4760-a6a9094aa528
msgctxt "he6e02617g1e99g4c6dgb77bg8171d07f5b28"
msgid "I'm fine, don't worry about me. I'm sure other people need you."
msgstr "괜찮으니 내 걱정은 마. 다른 사람들이 자넬 더 필요로 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 616788eb-d266-1530-6a2a-5fc724c08f72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Cal(1) = False
#.   Global:
#.      - HAV_ProdigyLament_State_ReunionDone = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Cal(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:616788eb-d266-1530-6a2a-5fc724c08f72
msgctxt "h75751acdgf911g4675g9b28g168fc7fa6a7a"
msgid ""
"Thank you - I never thought I'd see these two again. It's good to be back."
msgstr "고마워, 둘을 다시 보게 될 줄은 몰랐어. 돌아오길 잘했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 71b04dd2-799e-967b-98f5-07499bb4ac4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:71b04dd2-799e-967b-98f5-07499bb4ac4b
msgctxt "h06a2aa17g660cg476bga9c7g143dd7776bf6"
msgid "I know... but that doesn't matter, does it?"
msgstr "알아... 그치만 이제와서 무슨 소용이겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 7c364732-402e-33df-be33-ce336ae71b07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:7c364732-402e-33df-be33-ce336ae71b07
msgctxt "h95ed560cg8aaeg4064g8b76g3cffde56c7e1"
msgid "Rolan could be stubborn, but he was never malicious. Not like you."
msgstr "롤란은 답답했을지언정, 나쁜 녀석은 아니었어. 너랑은 다르게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 92b2317d-6bea-0669-c887-91e8bee2fc73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:92b2317d-6bea-0669-c887-91e8bee2fc73
msgctxt "h6481ff4cg648cg4033gacd7g447d80e61c91"
msgid "You won't see me again."
msgstr "앞으로 볼일 없을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 931a7382-5575-d554-c203-ce7690258b23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:931a7382-5575-d554-c203-ce7690258b23
msgctxt "h813ac7e4gfcd8g460cg9ac1gb30a2a5370eb"
msgid "Everyone I've ever loved is dead. I have nothing."
msgstr "내가 사랑한 모두가 죽었어. 아무것도 안남았다구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 98c6f8e0-c580-e68b-8504-59b2fe0ae77a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Brother_RolanDead_HasMet(1) = False
#.   Global:
#.      - GLO_Prodigy_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Brother_RolanDead_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:98c6f8e0-c580-e68b-8504-59b2fe0ae77a
msgctxt "he7a094d0g5854g4276gaea9g7689c4130e94"
msgid "You don't need to say anything. I got Rolan's message."
msgstr "아무 말 말아줘. 롤란의 메시지를 받았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = 9983e014-c377-cdc7-e061-104ec24b2af9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Cal(1) = True
#.   Global:
#.      - HAV_SavingPrisoners_State_SisterReturned = False
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:9983e014-c377-cdc7-e061-104ec24b2af9
msgctxt "hf3f18debg96c0g498cg9826g12b4c88d8107"
msgid "Lia spoke fondly of you. She'd be glad to know you stuck around."
msgstr "리아가 걱정어린 말을 하더군. 자네가 여기있단 걸 알면 기뻐할거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Player
#. NodeID = b0574b96-c1d1-953c-1143-475d07d3cbbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:b0574b96-c1d1-953c-1143-475d07d3cbbb
msgctxt "h55696ca6g04beg4f85g9adeg9d00589c3aec"
msgid "You're alive, aren't you? A little gratitude would be nice."
msgstr "너라도 살았잖아? 그 사실에 감사하는 건 어떨까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = b1667937-3ff3-2365-2d63-79ff63e675cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_State_RolanMissing_HasMet_Cal(1) = False
#.   Global:
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_State_RolanMissing_HasMet_Cal(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Knows_RolanMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:b1667937-3ff3-2365-2d63-79ff63e675cf
msgctxt "h6a860c9agee71g4d69g96d7gbcef8b4c6eb9"
msgid ""
"Rolan said to sit tight, but what's taking so long? I hope he's all right."
msgstr "롤란은 잠자코 있으랬지만, 너무 오래 걸리는걸? 별탈 없었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = b2b114fd-0a9c-19d4-493b-c70541dc9204
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:b2b114fd-0a9c-19d4-493b-c70541dc9204
msgctxt "h79e51b72g3becg43ecg8fb0g7153161895fe"
msgid ""
"I hope you find happiness, or at the very least, learn not to be so very "
"cruel."
msgstr "행복을 찾길 바란다. 아님 적어도 사람 되는 법이라도 배웠으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = bf1d0c0f-f5ad-f564-f05b-f424012b7aa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Brother_RolanDead_HasMet(1) = True
#.   Global:
#.      - GLO_Prodigy_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:bf1d0c0f-f5ad-f564-f05b-f424012b7aa8
msgctxt "hf538c383g40d1g41e7ga446ga3a9d123db05"
msgid ""
"Please don't. I have to leave - and there's nothing you can say to change my "
"mind."
msgstr "그만 둬. 난 떠날거고, 아무 말도 내 맘을 바꾸진 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Player
#. NodeID = c4d13d61-9993-daf8-a065-e31837ffcfe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:c4d13d61-9993-daf8-a065-e31837ffcfe6
msgctxt "h9aaeea8fgd761g4e31gb501gd0818e127331"
msgid "He died as he lived - stupidly."
msgstr "삶만큼이나 바보같은 죽음이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = d671b373-5396-2d2a-5994-74790f9d6abf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyBrother_NightsongFreed_HasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_ProdigyLament_State_ReunionDone = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyBrother_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:d671b373-5396-2d2a-5994-74790f9d6abf
msgctxt "h0a3561d0gd6bcg4c8dgba61ga69d663677fd"
msgid ""
"I don't think I've ever seen Harpers move so fast. What in the hells is "
"going down at Moonrise?"
msgstr "하퍼가 이렇게 빨리 움직이는 건 본 적이 없어. 대체 문라이즈에 무슨 일이 일어나고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Player
#. NodeID = d6bc0020-9220-a658-73e0-7483fc38d329
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:d6bc0020-9220-a658-73e0-7483fc38d329
msgctxt "h526bc802g74f2g486dgb247g677c86be5ca0"
msgid "I'm sorry."
msgstr "유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = d77e9437-20a5-80a1-ee6a-5018fc6214cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = False
#.      - GLO_Prodigy_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:d77e9437-20a5-80a1-ee6a-5018fc6214cc
msgctxt "h26e3496fgf5f8g4d65g89c3g8ee9794412ac"
msgid "Where <i>is </i>Rolan? He must be all right - he must."
msgstr "대체 <i>롤란은 </i>어디 있는 거지? 괜찮아야 할 텐데. 괜찮아야해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = e0d7e759-7318-5a68-0f46-3b85774eba69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Cal(1) = True
#.   Global:
#.      - HAV_ProdigyLament_Event_AngrySibling = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:e0d7e759-7318-5a68-0f46-3b85774eba69
msgctxt "h0d8f4935g83e2g414fg937dga24a0170c2c5"
msgid "You saved me and I'm grateful, but I need some time alone right now."
msgstr "구해줘서 진심으로 감사하네만, 지금은 혼자서 좀 쉬고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = ec5fdbe0-976f-4ca6-a852-c76956f6f674
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_State_RolanMissing_HasMet_Cal(1) = True
#.   Global:
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:ec5fdbe0-976f-4ca6-a852-c76956f6f674
msgctxt "h0f619ab5gd542g483fg9b93g493798128362"
msgid ""
"If you see Rolan, could you let him know we're here? I'm getting worried."
msgstr "혹시 롤란을 보게 되면 우리가 여깄다고 전해줄래? 걱정돼서 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = ee4e4230-966d-232e-6743-fcea32c69593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_SisterReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:ee4e4230-966d-232e-6743-fcea32c69593
msgctxt "hed09d146g16a0g4655gb9b4g1d14f3211df0"
msgid "We're leaving. It's what he wanted. As for you..."
msgstr "우린 떠날 거야. 걔가 원했던거니까. 넌..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = f8da2e50-6b1d-4e89-ab08-c7cebc4e06dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:f8da2e50-6b1d-4e89-ab08-c7cebc4e06dc
msgctxt "h2c3b47e6ge392g4f4fgab7agbac46eccaf2e"
msgid "The person I admired most is dead - gratitude is the last thing I feel."
msgstr "가장 존경하던 사람이 죽었어. 감사는 끝에가서나 느낄거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = f9c16d4f-3171-e820-18b1-f38fcffe08a6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Prodigy_State_ToldSiblingsProdigyDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:f9c16d4f-3171-e820-18b1-f38fcffe08a6
msgctxt "hc56d9e72g965bg4ed4ga2dbg7e05e5acb999"
msgid "My big brother is dead."
msgstr "형은 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother
#. Speaker = Cal
#. NodeID = feb71319-767b-4072-dfda-a2eebf1bc025
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Cal(1) = True
#.   Global:
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Brother:feb71319-767b-4072-dfda-a2eebf1bc025
msgctxt "h9b48ffb0gacb0g4f90ga273g58d80a0ebf8b"
msgid "If you ever need us, we'll be there - I guarantee it."
msgstr "언제라도 우리가 필요하면 갈게. 맹세해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Hologram
#. Speaker = Rolan
#. NodeID = 272a0eaf-888b-dc07-d459-1816185bacfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Hologram:272a0eaf-888b-dc07-d459-1816185bacfe
msgctxt "h262e751dgae6eg4154g9916g464345295112"
msgid ""
"Lia, Cal - if you see this, stay put. I will return in a tenday at most. I "
"repeat - <i>stay put.</i>"
msgstr "리아, 칼, 너희가 이걸 보고 있다면, 기다려. 길어야 열흘 안에 돌아올 거야. 다시 말하지만, <i>기다려.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Hologram
#. Speaker = Rolan
#. NodeID = 980eb450-9473-1f80-1134-c12dc7f3784b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Prodigy_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Hologram:980eb450-9473-1f80-1134-c12dc7f3784b
msgctxt "h706885f6g28cfg43cagaea3ga07274987454"
msgid ""
"Lia, Cal, if you see this... I'm dead. It's nothing to get upset about - "
"it's simply the way life is."
msgstr "리아, 칼, 너희가 이걸 보고 있다면...난 죽었어. 화낼 일은 아니야. 그냥 삶이란 게 이렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Hologram
#. Speaker = Rolan
#. NodeID = f3e8674a-729f-92fe-abf2-b395daab89ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Hologram:f3e8674a-729f-92fe-abf2-b395daab89ec
msgctxt "h4d973092g3d31g473aga89fg4e9a1a812166"
msgid ""
"Head to Baldur's Gate immediately. You'll both do excellently there, I have "
"no doubt. And thank you for, well, you know."
msgstr "당장 발더스 게이트로 가. 거기선 너희 둘 모두 아주 잘 해낼 거라 믿어. 그리고 고맙다. 뭐가 고맙냐면, 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 0015492e-7c93-42e8-9f41-0f78e8c56ec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:0015492e-7c93-42e8-9f41-0f78e8c56ec4
msgctxt "h5d0fc5deg3ff8g439cg9866g9e8bca7e3d42"
msgid ""
"He isn't very good with anyone<i>. </i>He yelled at me just because I told "
"him not to drink anymore."
msgstr "그는 <i>누구와도</i> 어울리지 못해요. 술 그만 마시라고 했더니 저한테 소리를 질렀다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 00d057d4-73e1-1cbf-e5f0-70459035e776
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:00d057d4-73e1-1cbf-e5f0-70459035e776
msgctxt "ha2c50facgf19dg498cg8d29gb4399fafb018"
msgid ""
"My mum always said a drink's the most important meal of the day. Take your "
"pick."
msgstr "엄마는 항상 술이 하루 식사 중 가장 중요하다 하셨죠. 골라보세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 0d6976bf-c6ce-4b29-9c71-7144fc7731a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:0d6976bf-c6ce-4b29-9c71-7144fc7731a0
msgctxt "h5b070571g95ecg473ag9676gd7a088876aa2"
msgid "I musta dropped it. Well, you can look for it if you want."
msgstr "어디다 떨어트렸나 봐요. 뭐, 찾아보셔도 되고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 0f3dc3e4-5ea3-4a0d-ab9c-8c7b9c059916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:0f3dc3e4-5ea3-4a0d-ab9c-8c7b9c059916
msgctxt "h790ccefegf486g4f9bgba40g984113119ff4"
msgid "Can I have it?"
msgstr "내가 가져도 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 163d4aa4-cba6-4f4c-849f-2f8e370275ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:163d4aa4-cba6-4f4c-849f-2f8e370275ea
msgctxt "h29579a8fg0d01g4eeegb000g4c0191bd7250"
msgid "He called me a 'ragged little devil'."
msgstr "그는 절 '걸레짝 같은 데빌 꼬맹이' 라고 불렀다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 18480a06-f37f-42e8-9a4f-781dfd61f4fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:18480a06-f37f-42e8-9a4f-781dfd61f4fb
msgctxt "h943043edg06d5g4abcga3ceg6f20ae9db80f"
msgid "And now we're just trying to save him from drinking himself stupid!"
msgstr "그리고 우리는 맛이 가도록 마셔대는 그를 구하려 했을 뿐이고요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 1bd72352-d391-34e5-f71d-8f0e0f82f42c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:1bd72352-d391-34e5-f71d-8f0e0f82f42c
msgctxt "h1765924dg994bg4c85g8ca2g04f660ce085a"
msgid "Maybe."
msgstr "한 번 볼게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 1caaeb84-ed91-47ed-af67-23ecfd43f0b6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:1caaeb84-ed91-47ed-af67-23ecfd43f0b6
msgctxt "ha4a81208g0d7dg4073g9cceg4c5c417b8c09"
msgid "Do you really want to give it to him after how he acted?"
msgstr "롤란이 그렇게 행동하는데 정말로 주고 싶어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 1dcf03e5-abfe-ba32-0441-62574d7063b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:1dcf03e5-abfe-ba32-0441-62574d7063b9
msgctxt "h3b6f1be3ge46bg47e8ga165gd09a9f55c2bf"
msgid "All this whining is making <i>me</i> wish he hadn't saved you."
msgstr "징징거리는 걸 듣자니 <i>나도</i> 그가 널 구하지 않았으면 하는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 1e7b1fe9-bfac-4dfa-a20a-6827245a7154
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_ProdigyLament_State_HasBook(0) = False
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_BookGivenAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:1e7b1fe9-bfac-4dfa-a20a-6827245a7154
msgctxt "h3ee50557g8298g4db4gb1ffg4f183794c3bd"
msgid "Fine. Here, you ... huh, where is it?"
msgstr "좋아요. 여기... 허, 어디 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 2130ede5-a387-fa8c-2356-78c7db2b033d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Ide_NightsongFreed_HasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Ide_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:2130ede5-a387-fa8c-2356-78c7db2b033d
msgctxt "h1bce3004ge35dg4d30g930dg88b7fc6a3081"
msgid "People just ran off and said nothing! Adults always do this."
msgstr "사람들은 그냥 뛰기만 하고 아무 말도 안 했어요! 어른들은 항상 그래요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 23a98811-b5af-a5b8-2322-dd0d8cd05d3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Ide(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:23a98811-b5af-a5b8-2322-dd0d8cd05d3f
msgctxt "h11224404g74c3g4047g8e52g004646716491"
msgid "Eh? You forget something?"
msgstr "에? 잊은 거 있어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 23f24944-ae0a-7f18-7b8b-b37a25d2f532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:23f24944-ae0a-7f18-7b8b-b37a25d2f532
msgctxt "h08671d0eg78c3g437dg8451gd9635ab0b63f"
msgid "Right? He went through three bottles before I told him to stop.<i></i>"
msgstr "맞죠? 제가 말리기 전까지 <i>세 병</i>을 들이켰다니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 25d8e057-83f5-2746-8209-555aea036904
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:25d8e057-83f5-2746-8209-555aea036904
msgctxt "he4a453eeg34f7g4705gba65g82bfa497e47a"
msgid "Actually I just wanted a drink."
msgstr "사실 그저 한잔 하고 싶었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 295a2810-0f51-4d6d-b0df-b00aba7c5e69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:295a2810-0f51-4d6d-b0df-b00aba7c5e69
msgctxt "h53c02a78gf15cg43c6g9d73g09cae1ea85af"
msgid "But he <i>did</i> save you - that's what matters."
msgstr "하지만 널 <i>구했잖아</i>. 그게 중요한 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 2ee38afa-e68b-4aae-ac7f-a9eae6a971ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:2ee38afa-e68b-4aae-ac7f-a9eae6a971ef
msgctxt "h57153f5dge695g4df0g9a09g96227b1a7d68"
msgid ""
"He acts like he wished we weren't here - like he wished he hadn't saved us."
msgstr "그는 마치 우리가 여기 없어야 할 것처럼, 구하지 말았어야 할 것처럼 굴어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 3044b817-b4c0-447c-a9df-49197a2592f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:3044b817-b4c0-447c-a9df-49197a2592f2
msgctxt "h70597b5fg379cg4760g85eagf3fa704db723"
msgid "True. But I don't think he meant it."
msgstr "사실이야. 하지만 진심으로 그런 건 아닐 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 31ad2c60-0fe6-aed6-2985-cbc697cda1b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:31ad2c60-0fe6-aed6-2985-cbc697cda1b4
msgctxt "hfd955f7bgdca7g482dg8e4dgd9274838ae43"
msgid "He'll be losing his mind and his lunch if he keeps drinking like that."
msgstr "계속 그렇게 마셔대면 정신을 잃고 토악질을 하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 351d4de1-5c04-4afc-9526-5e96240b304d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:351d4de1-5c04-4afc-9526-5e96240b304d
msgctxt "hab496d49g5424g4596gb7a5g6dc823b1208c"
msgid "I don't blame him - he wanted a drink, and you wouldn't serve him."
msgstr "난 그를 비난하진 않겠어. 그저 술을 달라고 했을 뿐인데 네가 갖다 주지 않았잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 364f3e95-3539-4f45-a1f2-80c5dec0d8ba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Event_FailedToGetBook(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Event_BookGivenAway = True
#.   Object:
#.     - HAV_ProdigyLament_Event_GiveBook(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:364f3e95-3539-4f45-a1f2-80c5dec0d8ba
msgctxt "h0be1d176gbbb1g4895gb2aegf968296d8cab"
msgid "<i>Fine. </i>He'll probably hate it anyway. Here."
msgstr "<i>좋아요.</i> 어차피 안 좋아할 게 뻔한데요 뭐. 여기요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 39eba7d9-5237-4b72-b197-0a730d150c3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:39eba7d9-5237-4b72-b197-0a730d150c3c
msgctxt "h06cb466bgc41bg4c8bgb505g1aba2bee25b6"
msgid "No need to snap at me."
msgstr "나한테 쏘아붙일 필요는 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 42c93bd6-a498-4d50-bf0f-713f0b895daa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Ide(1) = True
#.   Global:
#.      - HAV_ProdigyLament_Event_BookGivenAway = True
#.      - HAV_TieflingSurvivors_State_PromisedToSaveMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:42c93bd6-a498-4d50-bf0f-713f0b895daa
msgctxt "h2cc8aff9g999cg4172g83c7g14a7a5924bc9"
msgid ""
"What are you doing? You gotta get <i>Mol. </i>Don't make me regret trusting "
"you with this."
msgstr "뭐 하고 있어요? <i>몰</i>을 데려와야죠. 당신을 믿은 걸 후회하게 하지 마요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 44686dcc-1bfa-43cd-b112-3a1033948802
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:44686dcc-1bfa-43cd-b112-3a1033948802
msgctxt "hd1ae22b9g2793g4a4fgb4e7g9bc7375af5e7"
msgid "Hmm. Maybe."
msgstr "흠. 아마도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 464b08f7-d025-461e-b044-1e818f6d2aaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:464b08f7-d025-461e-b044-1e818f6d2aaf
msgctxt "h19ba1d9eg5ab6g41b2gbc21g7d23a46e6cf8"
msgid "Rolan isn't very good with kids."
msgstr "롤란은 아이들과 잘 못 어울려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 46c04ed6-f621-43d5-818f-9af667d6620b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:46c04ed6-f621-43d5-818f-9af667d6620b
msgctxt "h433fd4a7gedfbg4785g9101g2bc7516a3d68"
msgid "It's for <i>Rolan.</i>"
msgstr "<i>롤란</i>한테 줄 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 4f434ad1-2231-a642-4309-20fd66218018
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_Ide(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:4f434ad1-2231-a642-4309-20fd66218018
msgctxt "ha819d0bagf196g4794ga9aag1b55cef24fae"
msgid "If this is about Rolan, go <i>away.</i>"
msgstr "롤란에 대해 이야기할 거면, <i>저리</i> 가요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 525c8a26-c326-4236-b231-3936582397e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:525c8a26-c326-4236-b231-3936582397e5
msgctxt "hafb3bdc2geee7g443ag9737gee46a6982ec0"
msgid "Next time, call him one back."
msgstr "다음엔, 한 방 먹여주자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 583d1482-3d96-40b4-bd14-b0a567db8492
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:583d1482-3d96-40b4-bd14-b0a567db8492
msgctxt "he8b10f6dgd889g4a53gb65eg66a4da1ab1e9"
msgid "Give it to me, you brat. Now."
msgstr "내놔, 이 자식아. 당장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 5f058828-5151-558f-0a1b-201e53effb23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:5f058828-5151-558f-0a1b-201e53effb23
msgctxt "h2a91e5a3g940cg4563g93e5gf04a63122f6d"
msgid "What do you mean, his loss?"
msgstr "손해라니, 무슨 말이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 617c12d4-ffe7-964d-6f93-7c2253d202d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:617c12d4-ffe7-964d-6f93-7c2253d202d6
msgctxt "h9e7363bfgb719g4fa9g8d33ga17c9c1a2458"
msgid "You badger's backside-looking idiot."
msgstr "이 오소리 똥구멍같이 생긴 멍청아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 61d10f73-e6db-f3ff-7258-ad362fe3fe91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Event_FailedToGetBook(1) = False
#.   Global:
#.      - HAV_ProdigyLament_Event_BookGivenAway = False
#.      - HAV_ProdigyLament_Knows_AboutBook = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:61d10f73-e6db-f3ff-7258-ad362fe3fe91
msgctxt "h4b143127gdf4bg495bgb858g22d155679dc5"
msgid "You mentioned you had a magic book?"
msgstr "마법 책 갖고 있다고 했었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 63891f93-d312-870d-8600-f18d2a6b7523
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:63891f93-d312-870d-8600-f18d2a6b7523
msgctxt "h01522637gf9a6g44cfga8e5geb99559c4537"
msgid ""
"I found this book. Old, dusty, full of strange lettering. Pretty sure it's "
"magic."
msgstr "책을 하나 찾았어요. 낡고, 먼지투성이에, 이상한 글자로 가득하죠. 마법 책이 확실해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 63d10e00-7d94-42cb-a499-6f58d48bd76f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:63d10e00-7d94-42cb-a499-6f58d48bd76f
msgctxt "hddb51d5dgb695g4accg84dbgf3a541a4d65c"
msgid "True. Guess I'll keep it then."
msgstr "맞아요. 그냥 제가 가질래요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 6547fae2-e5ec-7808-fda2-962f2da5998c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:6547fae2-e5ec-7808-fda2-962f2da5998c
msgctxt "h3582a4ceg1d53g469cg840dg426b8a55766f"
msgid "Which he shouldn't have done."
msgstr "그는 그러면 안 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 67ef82dc-618d-41d2-87aa-ad542fa8699c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:67ef82dc-618d-41d2-87aa-ad542fa8699c
msgctxt "h6293d5b9g4f06g403dga924g53903706c652"
msgid "Fine. I <i>will.</i>"
msgstr "좋아요. 그렇게 <i>하죠.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 693b6eb7-0fa9-5c74-2514-69f51b0cdc33
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Event_FailedToGetBook(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Event_BookGivenAway = True
#.   Object:
#.     - HAV_ProdigyLament_Event_GiveBook(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:693b6eb7-0fa9-5c74-2514-69f51b0cdc33
msgctxt "hd4ce2928g003dg4534g8894g3a59aeb67f6c"
msgid "Guess you can have it then. I don't care."
msgstr "그럼 그냥 당신이 가지세요. 상관 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 6b0bb857-f898-1bc8-3047-01980d8c6fa6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Event_RudeWithIde(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:6b0bb857-f898-1bc8-3047-01980d8c6fa6
msgctxt "ha8b81c99g396bg45bdg8a9egb0e58c0bb1cf"
msgid "You're just as mean as the rest of 'em."
msgstr "당신도 다른 모든 사람들처럼 못됐군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 6bd1fe6b-41b9-1449-478c-a9ed27ee585a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:6bd1fe6b-41b9-1449-478c-a9ed27ee585a
msgctxt "h28388d17gf437g424agb1ebg51eb0f113d61"
msgid "I'm sure it is. See you around, kid."
msgstr "맞는 말이야. 또 보자, 얘야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 6dd9b032-0922-4ac1-bb8d-59f1cf46d120
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:6dd9b032-0922-4ac1-bb8d-59f1cf46d120
msgctxt "hcf996cfage6b3g435bgbbd2gc20d7ddf0e57"
msgid "Stop interfering. Just stay out of his way - and mine."
msgstr "참견하지 마. 그냥 그를 내버려 둬. 그리고 나도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 6e76aa56-59c9-7a97-617c-afcc29894713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:6e76aa56-59c9-7a97-617c-afcc29894713
msgctxt "hcd7b9166gbd4ag4803g895bgdd6d4274f262"
msgid "Ignore him - he's more immature than you are."
msgstr "그냥 무시해. 그는 너보다 덜 성숙하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 6f087761-aab9-cd00-1453-d9f248b4b5e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:6f087761-aab9-cd00-1453-d9f248b4b5e2
msgctxt "hf396d2d0ge682g47a7ga8e8ge2c894ccd56f"
msgid "Anyway, it's his loss."
msgstr "어쨌든, 롤란 손해에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 79e04f3c-c3b6-4ab9-81d5-6bfd9dea2ddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:79e04f3c-c3b6-4ab9-81d5-6bfd9dea2ddc
msgctxt "hbe8924b4gbdc4g4e7fg86bdgf7d9b58528d1"
msgid "I'm sorry he was mean."
msgstr "롤란이 무례하게 굴었다면 대신 사과할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 8398475d-d1a4-4d00-b2a4-41e5fc59edf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:8398475d-d1a4-4d00-b2a4-41e5fc59edf9
msgctxt "h0743d84dga3bag4e87g89fbgbca8a5863353"
msgid "A drunk wizard's a dangerous thing - all that uncontrolled power."
msgstr "술 취한 위자드는 위험하지. 자기 힘을 주체할 수 없으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 8dc3cc41-50f1-42f7-8460-aa182d69a22c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:8dc3cc41-50f1-42f7-8460-aa182d69a22c
msgctxt "hc2878590g34e1g4f5agaffaga50e0d8c4471"
msgid ""
"Yeah, well everyone says you smell like rotting badger, but they're wrong."
msgstr "그러시겠죠, 모두 당신더러 썩은 오소리 냄새가 난다고 하죠. 하지만 틀렸어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 924f40cc-f912-4ee7-8ae3-15077e802fb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:924f40cc-f912-4ee7-8ae3-15077e802fb7
msgctxt "hdede7e6cg3ed9g4e74ga4feg70b15f74d70e"
msgid "I get it - you were trying to look after him."
msgstr "알겠어. 그를 돌봐주려고 했던 거구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 936d604b-2459-47b5-9a1a-ca5d2b3d7ca9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Event_RudeWithIde(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:936d604b-2459-47b5-9a1a-ca5d2b3d7ca9
msgctxt "h82b9a3feg7c90g4201g91f6g37aa08ee1f49"
msgid "You're mean. Leave me alone."
msgstr "당신은 못됐어요. 날 내버려 둬요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 97a0372c-eb90-4591-8fdf-46ed28581e1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:97a0372c-eb90-4591-8fdf-46ed28581e1a
msgctxt "h4315ea2dg1500g4fd8gab7bg91264ccb7d50"
msgid "Yeah. He did save us, after all."
msgstr "네. 무엇보다 우릴 구해 줬으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 98942790-285c-ac1a-26da-37b37beb6466
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:98942790-285c-ac1a-26da-37b37beb6466
msgctxt "h517b94e9ga204g4568ga8fdgff179d6ff6ce"
msgid "I could use some supplies, if you've still got any."
msgstr "아직 남아있는 게 있다면, 보급 좀 하면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = 98ed7d60-d738-1cb4-b214-3cf2555810db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:98ed7d60-d738-1cb4-b214-3cf2555810db
msgctxt "he9e1ef26g32fcg4b24g8f90g4f666fd7acbc"
msgid "How about a drink for me, instead?"
msgstr "대신 나한테 한 잔 주는 건 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = 9d9b222a-60bb-4925-9913-0f701a7ebe08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:9d9b222a-60bb-4925-9913-0f701a7ebe08
msgctxt "h88f71c61g1d3fg41c5gb897gc0d28480f2b5"
msgid "Maybe. Thanks for... talking and stuff."
msgstr "아마도요. 고마워요...이야기 해주고 그런 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = a1abed29-6cfa-4476-af86-f1792f644093
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Event_RudeWithIde(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:a1abed29-6cfa-4476-af86-f1792f644093
msgctxt "h7b0df904g7a68g469ag8a33g75e4296e8c11"
msgid "You smell like crusty toe-jam - look it too. <i>Bye.</i>"
msgstr "당신한테선 굳은 발가락 때 냄새가 나요. 그렇게 생기기도 했고요. <i>안녕.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = a6405e1a-1efc-51e7-0453-7880fb0475f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:a6405e1a-1efc-51e7-0453-7880fb0475f5
msgctxt "h55f25bb9gd104g4ccfgb5eegd88df02c150a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = a6e0d921-99ba-4b21-8008-4125ca4d6c5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:a6e0d921-99ba-4b21-8008-4125ca4d6c5a
msgctxt "h774c2596g6da4g4897ga966g80df258a172b"
msgid "Anyway, I'm sick of talking. You can go now. Bye-bye."
msgstr "어쨌든, 말하는 거 질렸어요. 이제 가세요. 안녕."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = a96ec393-7c58-0107-f16f-638fbc1b2ff6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:a96ec393-7c58-0107-f16f-638fbc1b2ff6
msgctxt "h17dc43b8g5bd1g44d2g84b3g58770454dd79"
msgid "Bye!"
msgstr "안녕히 가세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = acc68d42-9cbc-41d8-9134-5fb23aaf70ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:acc68d42-9cbc-41d8-9134-5fb23aaf70ae
msgctxt "h3a595e40g4457g4225gbbfbg36af89cd7e9f"
msgid ""
"Right? He might wave his arms wrong and burn the whole inn down, or belch up "
"a puddle of acid."
msgstr "맞죠? 팔 한번 잘못 휘둘러서 여관을 홀라당 태울 수도, 아니면 산성 웅덩이를 뿜을 수도 있는 거잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = b33afdd5-76bc-4d76-ba53-e9d8f5b89939
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:b33afdd5-76bc-4d76-ba53-e9d8f5b89939
msgctxt "h868c46f4gc9fcg48bbg9478g33d9867c7667"
msgid "Brat? Really? You can do better than that."
msgstr "자식? 진심이에요? 그것보단 좋은 말이 있을 텐데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = b3bf2cc8-20e4-45bc-b7b7-ecd2ba7755c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:b3bf2cc8-20e4-45bc-b7b7-ecd2ba7755c6
msgctxt "haf6c71e3gd73eg4138gbae2g5ec72e6c153e"
msgid "...Sorry. Rolan snapped too and I didn't like it."
msgstr "...죄송해요. 롤란이 쏘아붙여서 기분이 상했나 봐요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = ba77863b-9fe0-db38-31cd-2ed9d0c4b4a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Event_FailedToGetBook(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Event_BookGivenAway = True
#.   Object:
#.     - HAV_ProdigyLament_Event_GiveBook(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:ba77863b-9fe0-db38-31cd-2ed9d0c4b4a9
msgctxt "h4d50cb87gd35dg41e4g8cfag984e195d75e2"
msgid "Sorry. I didn't mean - here. Just go away!"
msgstr "미안해요. 그런 뜻은...여기요. 그냥 가버려요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = c86adb68-3a5a-4b8a-b9c8-92d5e62c4a86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:c86adb68-3a5a-4b8a-b9c8-92d5e62c4a86
msgctxt "h4ac9120bgd5fag46aegb0b1g907dc9bba91a"
msgid "Ignore Rolan. He's just a grump."
msgstr "롤란은 무시해. 그냥 심술쟁이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = ca20a6e3-795b-4727-8288-c72e7e1a801c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TieflingSurvivors_State_DidNotPromiseToSaveMol = True
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:ca20a6e3-795b-4727-8288-c72e7e1a801c
msgctxt "h3c7c882dg7d09g4dbdg8b8cg3e9c3f03138a"
msgid "Please bring Mol back. Please."
msgstr "제발 몰을 데려와 주세요. 제발요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = db12c088-66e1-4d5e-929c-320621d3277c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:db12c088-66e1-4d5e-929c-320621d3277c
msgctxt "h533f3a7fg10aag4a35ga718g1100a860e660"
msgid "Very observant of him - that's exactly what you are."
msgstr "그는 아주 눈썰미가 좋군. 왜냐면 그게 바로 너니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = e41c7103-d191-d7d8-0273-a1de1586d174
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Ide_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:e41c7103-d191-d7d8-0273-a1de1586d174
msgctxt "h513b8a12gc7f9g4be5gb9adg843305b0d9a4"
msgid "I'll find out what's going on <i>myself</i>, thank you very much."
msgstr "무슨 일이 벌어지는지 <i>직접</i> 좀 봐야겠어요, 정말 고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = e674d69d-9932-4d19-bcbd-80311c6ce6d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:e674d69d-9932-4d19-bcbd-80311c6ce6d8
msgctxt "hc829515fg2afeg4f95gaed4g6d8adac3dbf9"
msgid "I will too!"
msgstr "그럴 거예요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = e69abd26-f07a-bfbc-693e-15884b4b643b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:e69abd26-f07a-bfbc-693e-15884b4b643b
msgctxt "h5c364107gb10bg4d62g9792ga89c4a31a797"
msgid "Never mind then."
msgstr "그럼 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = e70b0eab-6b28-4ad6-a8f3-dca131a0c41c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:e70b0eab-6b28-4ad6-a8f3-dca131a0c41c
msgctxt "h54428cd0g0b76g4838g99dag971851ad86eb"
msgid "Uh-huh. Like I've never used that one before."
msgstr "으흠. 내가 그런 수를 안 써본 줄 알아요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = e70cd6bd-14d6-6f18-8df0-333969874127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:e70cd6bd-14d6-6f18-8df0-333969874127
msgctxt "h697d840bg9b25g4db1ga104g1e5a3084ddb4"
msgid "Take care."
msgstr "몸조심하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = eac5219c-0e60-8f46-2de1-128b75fe00c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:eac5219c-0e60-8f46-2de1-128b75fe00c6
msgctxt "hb9e6e007g1844g4a45gb261gfeec4f8d2a9f"
msgid "The one for Rolan? What about it?"
msgstr "롤란한테 줄 책이요? 그게 뭐요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = eb3c33e2-cd79-331d-7975-222c03f8cf2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:eb3c33e2-cd79-331d-7975-222c03f8cf2e
msgctxt "h2c441363gd9bbg43d4g9dd4ga5092547baab"
msgid "Darn shame too."
msgstr "더럽게 쪽팔리기도 하고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = ede42492-f190-4d04-8693-2c42c921aed3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:ede42492-f190-4d04-8693-2c42c921aed3
msgctxt "h6e4e3569g3ae7g4193gbf56g7710ef8391bf"
msgid "Why don't you keep it for yourself?"
msgstr "그냥 가지는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = f0761445-51ff-d1e7-2b13-42a38df7a6f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f0761445-51ff-d1e7-2b13-42a38df7a6f4
msgctxt "h2337247cg2d4ag4bebga468g1c1364aca0d4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = f117d5f5-01fb-4695-b0f6-0a90595c984b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f117d5f5-01fb-4695-b0f6-0a90595c984b
msgctxt "h0cc770bag805cg43ccg94baga720d94c7c47"
msgid ""
"Then he should say sorry - all I did was tell him he shouldn't drink anymore."
msgstr "그러면 나한테 사과해야죠. 난 술 좀 그만 마시라고 했을 뿐인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = f24eb0ad-ccbc-416f-94b5-7ae187dcc9cd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f24eb0ad-ccbc-416f-94b5-7ae187dcc9cd
msgctxt "ha5642106gcae2g4907ga60fg61408f20d3db"
msgid "If you give it to me, I'll make sure he gets it."
msgstr "나한테 주면 롤란에게 전해줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = f2f2707c-6b4d-4335-a565-a68f0ade56cc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Knows_AboutBook = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f2f2707c-6b4d-4335-a565-a68f0ade56cc
msgctxt "h4bb54b56g92a5g4bb0g8e0ag0b0b99e9a900"
msgid ""
"I was gonna give it to Rolan so he could learn new spells, you know? Beats "
"drinking 'til he forgets the ones he knows."
msgstr "롤란에게 새로운 주문이라도 배우라고 이 책을 선물할 생각이에요. 저렇게 술을 퍼마시다간 알던 주문도 잊어먹을 게 틀림없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = f5b959c9-9525-4f34-ab20-e3c23c79094c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f5b959c9-9525-4f34-ab20-e3c23c79094c
msgctxt "h04dc6eabge182g4c29g8f3bg7800137833f5"
msgid "It was for his own good! He can barely stand up straight."
msgstr "그를 위해서였다고요! 제대로 서 있지도 못하던데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = f63339ed-aceb-b8f1-daa3-79bdb5781d84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f63339ed-aceb-b8f1-daa3-79bdb5781d84
msgctxt "h1b96a684ga7aeg4223gb841g4ae676151b88"
msgid "Nothing important - I just want a drink."
msgstr "별거 아니야. 그저 한잔하고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = f749bf6d-c23e-40a9-986f-0b8f48a193e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f749bf6d-c23e-40a9-986f-0b8f48a193e1
msgctxt "hf6088e04g0588g45ddgb09bgd1e022c67c5a"
msgid "That's a great gift. I'm sure he'll love it."
msgstr "훌륭한 선물이야. 엄청나게 기뻐할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Player
#. NodeID = f7d21545-aeee-a7f7-28d1-f195376eca0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:f7d21545-aeee-a7f7-28d1-f195376eca0d
msgctxt "hcc256d60gb424g464ag97e9g749531c2dced"
msgid " <i>Leave.</i>"
msgstr " <i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide
#. Speaker = Ide
#. NodeID = fe91877e-8d0d-45f5-b444-a39b13928d35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_IdeAlert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Ide:fe91877e-8d0d-45f5-b444-a39b13928d35
msgctxt "heaeba44agb723g418cgafc3gbaf3a304add7"
msgid "They took Mol - I couldn't stop them."
msgstr "그들이 몰을 데려갔어요. 난 막을 수 없었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "h957ce1f2gd744g4cdcg8876gaf82b431f6b7"
msgid "He went into the shadows alone? What a dolt."
msgstr "혼자 그림자들한테 갔다고? 얼간이 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "hfd96c3d8gbfcdg4b80gb3acg26d1ea408fec"
msgid "What a fool. The darkness will swallow him in no time."
msgstr "멍청이 같으니. 어둠이 그를 단숨에 집어삼킬 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "h59f9d094g587ag4cf3gb41ag0f8fad7807bf"
msgid ""
"Ah, Rolan. Not the brightest decision to stride off into such darkness. "
"He'll soon be extinguished."
msgstr "아, 롤란. 어둠 속으로 성큼 걸어 들어가는 건 현명한 선택이 아니었어. 그는 곧 스러질 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "h960283b5g4ab1g4c50g9e45g97849c09282a"
msgid "He went into the shadows alone? Then he's as good as dead - or worse."
msgstr "혼자 그림자 속으로 갔다고? 그럼 죽은 목숨이야 - 더 심한 꼴을 당하던지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "h5dc256c9g7a62g4192g936ag553daed04fe4"
msgid ""
"He won't last long in the shadows. What in the Nine Hells was he thinking?"
msgstr "오래 못 버틸 거야. 아홉 지옥이여, 도대체 무슨 생각이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "h8f7fdf2ag237cg498bg9abag3a90d72f7b6d"
msgid ""
"Did he really go off into the shadows alone? Wonder how long he'll last."
msgstr "정말로 그림자 속으로 혼자 갔다고? 얼마나 오래 살 수 있을지 궁금하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "h90de7ed6gaf4fg46a1gae32ga8be752d7ecf"
msgid "He went into the shadows alone? Madness."
msgstr "혼자 그림자 속으로 갔다고? 미쳤군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction
#. Speaker = Player
#. NodeID = d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_PAD_HologramReaction:d9e34b37-0ea3-4daa-a1c3-3d9c06af1ac2
msgctxt "h01727474g5d54g4d34gacc8g60386b6b3f8c"
msgid ""
"He'll need help to survive those shadows. Only a fool would face them alone."
msgstr "그가 살아남으려면 도움이 필요해. 혼자서 그림자들을 상대하는 건 바보 같은 짓이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = 00f16267-1409-5b92-a994-915e7304b33b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:00f16267-1409-5b92-a994-915e7304b33b
msgctxt "h76ebaa6agb331g42cegbbf0g5abafce7d20e"
msgid "Don't you dare turn this on me, Rolan."
msgstr "내 탓으로 돌릴 생각도 하지 마, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 065a131b-7802-84c0-3d5e-b23aa2454abb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_AngrySibling = True
#.     - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:065a131b-7802-84c0-3d5e-b23aa2454abb
msgctxt "h65254146g2502g4aa1g88beg96043132d5b6"
msgid "He's no brother of mine."
msgstr "저딴 놈은 내 형제가 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 068f5afc-dd78-c95c-e53b-017d96aaeac5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:068f5afc-dd78-c95c-e53b-017d96aaeac5
msgctxt "hdc1566dag701ag42baga9c1g0e281ac408aa"
msgid ""
"Well, we'll never know, will be? Because Cal had one job - protect her. And "
"he failed - <i>miserably.</i>"
msgstr ""
"글쎄, 그건 아무도 모르는 거지, 그렇지 않나? 왜냐면 이 자식에겐 임무가 단 한 개였거든. 리아를 지키는 것. 그리고 실패했지... "
"<i>끔찍하게</i> 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = 07f7192e-3b61-2ed2-8507-7ff163dcd6a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:07f7192e-3b61-2ed2-8507-7ff163dcd6a2
msgctxt "hf58ffa26g1dd3g4841g9abdgbd1566d1ded0"
msgid "<i>Enough</i>. I won't say it again."
msgstr "<i>그만</i>. 두번 말 안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 0b6efea7-13e4-9552-aef1-127c9f3a1987
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - CLERIC_KELEMVOR(3) = False
#.      - MONK(3) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:0b6efea7-13e4-9552-aef1-127c9f3a1987
msgctxt "h85d71c16g08eeg4bc6gb36dg36f978b88b3f"
msgid "Lia is alive - you should be grateful."
msgstr "리아는 살았잖아. 그 사실에 감사하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 0f50c545-456a-e06f-1c56-256093b00b17
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:0f50c545-456a-e06f-1c56-256093b00b17
msgctxt "h2faa4d6dg8366g4127g85b6ga7dd47e12c9e"
msgid "SHUT UP, BOTH OF YOU, BEFORE I FINISH WHAT KETHERIC STARTED."
msgstr "너네 둘 다 입 닥쳐라. 케서릭이 하려 했던 일을 내가 해버리기 전에 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 0fdc9e38-3845-69bd-3634-163b1c7d3c25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:0fdc9e38-3845-69bd-3634-163b1c7d3c25
msgctxt "hd8bba301g63eag432fgb437g37244745d566"
msgid "Am I going to get paid or what?"
msgstr "그래서 보상은 줄 거야 말 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 11e623dd-92c9-e00f-96e3-2ac85e4eacf2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_ProdigyPostRescue(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:11e623dd-92c9-e00f-96e3-2ac85e4eacf2
msgctxt "h3a566ee4g7d19g4784ga6dfg0747e067aa81"
msgid ""
"I return from the darkness itself only to find you acting like you're on "
"holiday. Lia could still be in Moonrise!"
msgstr "나는 어둠 속을 헤집고 돌아왔는데, 너는 휴가 중인 것처럼 행동하고 있잖아. 리아가 아직 문라이즈에 있을지도 모른다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 161ded25-5ce5-9a6c-6e71-551c68bd71ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:161ded25-5ce5-9a6c-6e71-551c68bd71ea
msgctxt "ha49222e4gdd25g4721g90d3g0609945a5f55"
msgid "Do you wish it was me who died? Instead of Lia?"
msgstr "내가 죽은 거였으면 하고 바라는 거야? 리아 대신에?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 1d2d5bd2-8fa0-300b-bd7b-82d4223e9c67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:1d2d5bd2-8fa0-300b-bd7b-82d4223e9c67
msgctxt "h0c713e8ege751g4ab7g84cag76abf9e7f3f8"
msgid "I thought my entire family was DEAD."
msgstr "난 내 가족들이 전부 죽은 줄만 알았다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 252ef1ba-e1cc-3de5-7331-c0af12c44a49
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:252ef1ba-e1cc-3de5-7331-c0af12c44a49
msgctxt "h53b66a82gc08fg4d98ga6a8gacbb3eac6018"
msgid "Rolan, we're alive because of her - don't be like that."
msgstr "롤란, 그녀 덕분에 우리가 산 거잖아... 그러지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 252ef1ba-e1cc-3de5-7331-c0af12c44a49
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:252ef1ba-e1cc-3de5-7331-c0af12c44a49
msgctxt "h6e9d45e1g84dfg4106g8d08g9514ea6743c0"
msgid "Rolan, we're alive because of him - don't be like that."
msgstr "롤란, 그 덕분에 우리가 산 거잖아... 그러지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 252ef1ba-e1cc-3de5-7331-c0af12c44a49
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:252ef1ba-e1cc-3de5-7331-c0af12c44a49
msgctxt "h94cbef32g5b77g4873g8211gc5947a1bdf5c"
msgid "Rolan, we're alive because of them - don't be like that."
msgstr "롤란, 이 사람 덕분에 우리가 산 거잖아... 그러지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 2699ecba-d640-3a1a-b0cf-7019c2aef46b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_AngrySibling = True
#.     - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:2699ecba-d640-3a1a-b0cf-7019c2aef46b
msgctxt "h3c0f1b6cg4408g4fa8g8aacg2d34a89224cb"
msgid "Don't you dare. Lia was his responsibility, and he <i>failed</i> her."
msgstr "감히 그딴 말 꺼내지도 마. 리아는 이 녀석 책임이었어, 그리고 <i>실패</i> 했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 29f1a3b3-6197-8195-dfe1-0d942bf767a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:29f1a3b3-6197-8195-dfe1-0d942bf767a1
msgctxt "h50523a82gfc35g47dfga733ga654683396f1"
msgid "I was just... overwhelmed. It doesn't matter."
msgstr "그냥 좀... 당황했던 것뿐이지. 별거 아니었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 2b706b25-0419-334a-0e65-5c5e1d63a450
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#.      - HAV_SavingPrisoners_State_SisterReturned = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_ProdigyPostRescue(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:2b706b25-0419-334a-0e65-5c5e1d63a450
msgctxt "h2517f61fgea98g442eg906bg94f2161b4adc"
msgid "Where in the Nine Hells have you been?"
msgstr "빌어먹을 도대체 어디에 있었던거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 3585be15-61ae-75fe-cafa-511a591f0d85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:3585be15-61ae-75fe-cafa-511a591f0d85
msgctxt "h7b561385g3409g4aa4g945cgb7d85bdc47e8"
msgid ""
"You two did what you thought was right, but I can't go through this again. I "
"just can't."
msgstr "너희 둘은 스스로가 옳다고 생각한 일을 한 거겠지만, 난 다시는 이런 일을 겪을 수 없어. 그냥 못하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 379a1b1b-22c8-32b3-594c-84c910448625
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: !(MONK and SORCERER and WARLOCK and WIZARD)
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:379a1b1b-22c8-32b3-594c-84c910448625
msgctxt "h7b8ecd85g59ddg4378gbef3g9270236e8686"
msgid "You want to blame someone for Lia's death? Blame me."
msgstr "리아의 죽음에 대해 누군가를 탓하고 싶나? 날 탓해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 4016a8a7-e06a-864e-11b0-42df931e3b13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:4016a8a7-e06a-864e-11b0-42df931e3b13
msgctxt "hd0c87465gc032g40c5gb596gd571380bfabb"
msgid "Me too."
msgstr "나도 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 48ccf90e-ffd2-2d4e-d332-259fdcaf2a81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:48ccf90e-ffd2-2d4e-d332-259fdcaf2a81
msgctxt "h6bda49c6g3025g468dgba03g97786959cdef"
msgid "And when others, such as myself, failed miserably."
msgstr "다른 사람들이... 특히 나처럼, 비참하게 실패했을 때 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 553ac7b1-d99b-7c8f-59cc-7277320699bb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: SORCERER or WARLOCK or WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:553ac7b1-d99b-7c8f-59cc-7277320699bb
msgctxt "hfe760b17ge8dbg4205ga8ffg8b2d132c1d25"
msgid ""
"All the magic in the world could not have saved Lia. Not yours - and not "
"mine."
msgstr "이 세상 그 어떤 마법으로도 리아를 구할 순 없었을 거야. 나도 그렇고 너였어도 마찬가지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 5740a203-2881-cb5c-ef2c-0246cfdb7ce6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:5740a203-2881-cb5c-ef2c-0246cfdb7ce6
msgctxt "h473effc5g56ddg4cd6ga756gcd1ecdc48e4d"
msgid "Anything to add, Rolan?"
msgstr "더 줄 건 없나, 롤란?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 5c1e2d94-3997-1452-3e38-9940d4dcff25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:5c1e2d94-3997-1452-3e38-9940d4dcff25
msgctxt "ha7c66edcga44bg4c88g8161g2061ecc745e1"
msgid "Rolan was in a bad state without you two."
msgstr "너희 둘이 없는 동안 롤란이 얼마나 맘고생을 했는지 모를걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 5fd7897b-95c9-881e-0bb6-146b6172a5c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:5fd7897b-95c9-881e-0bb6-146b6172a5c1
msgctxt "h3693f5d8gde5bg4684gadddgc5f42f00ec0f"
msgid "Shit. I'm sorry."
msgstr "젠장, 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 601bbaaa-353f-b63c-117a-c829bcceb5a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:601bbaaa-353f-b63c-117a-c829bcceb5a7
msgctxt "h0b7b7787g8c18g44dbg941fg8fe7c8d9c990"
msgid "Rolan, please."
msgstr "롤란, 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 6045b8f5-3b3e-3a61-ecf3-7d335d971a4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:6045b8f5-3b3e-3a61-ecf3-7d335d971a4b
msgctxt "h76cf87d4g3e42g4ccfg8c16gd051623764b2"
msgid "Am I supposed to pretend that everything is fine? That Lia isn't dead?"
msgstr "모든 게 괜찮은 척해야 하나? 리아가 죽지 않은 것처럼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 60e36e9e-554c-5b6c-b89d-5e072cd8089b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_ProdigyPostRescue(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:60e36e9e-554c-5b6c-b89d-5e072cd8089b
msgctxt "h7ac2f87cg9112g4f26ga56cgbd750b90a529"
msgid ""
"I return from the darkness itself only to find you at ease while Cal lies "
"<i>dead</i>. What in the hells did you do?"
msgstr "어둠 속에서 돌아와 보니 칼은 <i>죽은 채</i> 누워있고 넌 편안하게 쉬고 있다 이거지? 빌어먹을 대체 무슨 짓을 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 62775663-cf79-8b61-f623-3d9e6e1fae0c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:62775663-cf79-8b61-f623-3d9e6e1fae0c
msgctxt "hd153b187g93bdg483cgab90g7076f9530c21"
msgid ""
"How about I kill you both, so you can join Lia? I'll even say your last "
"rites."
msgstr "리아랑 만날 수 있게, 내가 여기서 너희 둘 다 죽여주는 건 어떨까? 특별히 마지막 의식까지 치러줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 65f3e754-0363-65e0-962f-327f61d010df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:65f3e754-0363-65e0-962f-327f61d010df
msgctxt "h67d23650gf33ag4675g9fd8gcd638ab941fa"
msgid "Getting captured was stupid and reckless."
msgstr "포로로 붙잡히는 것 자체가 멍청하고 무모한 짓이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 6614e5d2-5ee3-b5dc-d5eb-f8829e4a3733
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:6614e5d2-5ee3-b5dc-d5eb-f8829e4a3733
msgctxt "hb98454cbg6a10g4ee9ga978g8511b40daca4"
msgid "Here - take this and leave. You can go now."
msgstr "자, 이거 받고 떨어져. 이제 가 보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 68cac3bf-7f3f-6507-8a45-8aff104d85bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:68cac3bf-7f3f-6507-8a45-8aff104d85bc
msgctxt "hbfa2d9d0g30eag4875g8470ga6febd59346b"
msgid "I've lashed out at you, drunkenly and otherwise, and you helped anyway."
msgstr "술에 취해서든 다른 이유로든 네게 모질게 대했지만, 결국 우릴 도와줬네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 69a72905-56dd-cf9e-7bfb-059663b1f962
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_ProdigyPostRescue(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:69a72905-56dd-cf9e-7bfb-059663b1f962
msgctxt "h8f01402bgd311g427bg9e62g858ec45796fd"
msgid "What do you mean Cal is <i>dead? </i>What did you do?"
msgstr "칼이 <i>죽었다는</i> 게 무슨 뜻이야? 무슨 짓을 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 6d6e78c4-1d33-a3ce-2d6e-5f74768f42b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:6d6e78c4-1d33-a3ce-2d6e-5f74768f42b8
msgctxt "hcebc0ab6g6153g4db8g86f7g5287b9c4bc70"
msgid "I thought you were dead, you ass. Both of you!"
msgstr "너희 둘 다 죽은 줄 알았다고, 이 바보들아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 732e1245-4043-e5e3-feee-b81adb0a072c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:732e1245-4043-e5e3-feee-b81adb0a072c
msgctxt "h55274fc8g69a0g48a5g8bebg8395ee8869c1"
msgid "That's more than fair. Thank you for helping us when most wouldn't."
msgstr "충분히 이해해. 대부분의 다른 사람들이 주저할 때 우릴 도와줘서 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 73e2e6fa-63a0-e4f1-0677-0175e8347e77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#.      - HAV_SavingPrisoners_State_SisterReturned = True
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_ProdigyPostRescue(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:73e2e6fa-63a0-e4f1-0677-0175e8347e77
msgctxt "h79a96c2dgbc7ag4245g90c9ge66c0d0ee3b8"
msgid ""
"Did you enjoy relaxing here while I battled that wretched darkness? What "
"were you thinking?"
msgstr "내가 저 끔찍한 어둠 속에서 싸우는 동안 편안하게 쉬고 계셨다? 머릿속에 대체 뭐가 든 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = 745e44ce-ef62-d65d-1c40-30b1920c070e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:745e44ce-ef62-d65d-1c40-30b1920c070e
msgctxt "hb0dc0b53ga577g4645gbe75g1ad410e122a1"
msgid "I know, all right? But I couldn't stand back and do nothing."
msgstr "나도 알아, 안다고! 그렇다고 뒤돌아서 아무것도 안 할 순 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 765242b7-7fc2-ced6-0d8c-a3791ed8ed8e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:765242b7-7fc2-ced6-0d8c-a3791ed8ed8e
msgctxt "h6958fbfag709dg4050g818fgb480afdb4e32"
msgid "Don't be an arsehole, Rolan. He's your brother."
msgstr "어리석게 굴지 마, 롤란. 네 형제잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 79700aa9-b30c-c3a2-597a-e5b342abde88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:79700aa9-b30c-c3a2-597a-e5b342abde88
msgctxt "hd703ba11g38f7g4a2fg8fe1g5cf1ecadde9b"
msgid "And who's fault is that?"
msgstr "그래서 잘못은 누가 했는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = 7a4fada4-3c70-d8d4-bd2b-50200b12f833
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:7a4fada4-3c70-d8d4-bd2b-50200b12f833
msgctxt "h4c5298f5gd3c4g46a3g9bedgd0aff62c3f09"
msgid ""
"Or, we could remember how brave, and kind, and smart he was - every single "
"day. That's my plan, anyway."
msgstr ""
"아니면 항상 기억하며 살아가는 거지. 칼이 얼마나 용감하고, 친절하고, 똑똑했는지... 하루도 빼놓지 않고 말이야. 어쨌든, 난 그럴 "
"거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 7b4ddc2a-5afb-8240-64e4-69e8030548ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:7b4ddc2a-5afb-8240-64e4-69e8030548ec
msgctxt "h49304325gcb86g4a03gb951g7dfcb77fc86d"
msgid "Could you give us a moment? Please?"
msgstr "잠시만 좀 시간을 줄래? 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 7bd2f243-78fa-22ff-1971-9bf970931e94
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - CLERIC_KELEMVOR(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:7bd2f243-78fa-22ff-1971-9bf970931e94
msgctxt "h99dc2fafgcee4g4db2ga666g3722117bc906"
msgid ""
"Peace - your brother is dead, but he is not gone. He is safe now, and at "
"peace."
msgstr "조용히 해... 네 동생은 죽었지만, 사라진 게 아니야. 그는 이제 안전하고, 평화로울 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = 7c6edfc0-2ef0-ea58-86ea-7aa93427defa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:7c6edfc0-2ef0-ea58-86ea-7aa93427defa
msgctxt "h142340d2gbf86g4973gbf94ga8b9890c31ef"
msgid "I'm sorry too."
msgstr "나도 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 7cdd3662-0a7b-61b5-d381-1bf21f814a3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:7cdd3662-0a7b-61b5-d381-1bf21f814a3d
msgctxt "he74b6502g6d92g4165gb2b8gd564f7000a16"
msgid ""
"Sorry for... yelling. Here - I hope this helps down the road. And thank you."
msgstr "그...소리 지른 건 미안해. 자, 이게 가는 길에 도움이 되었으면 좋겠군. 그리고 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 814f5d0c-f830-e529-2b3c-6b92e498655e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:814f5d0c-f830-e529-2b3c-6b92e498655e
msgctxt "h795acd94g43a1g4c54gb992ge0835d39edb0"
msgid "So, who is paying me?"
msgstr "그럼, 값은 누가 치르려나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 8538e75f-acd4-07c4-22d8-e67ebe781506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:8538e75f-acd4-07c4-22d8-e67ebe781506
msgctxt "h985ad2a9gf215g4a94gb74fg4c6b20171d07"
msgid "Thank you - for saving me. And the two idiots."
msgstr "구해줘서 고마워. 그리고 여기 두 멍청이도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 8635095e-af47-cfa9-b6ba-c13f09bb43c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:8635095e-af47-cfa9-b6ba-c13f09bb43c6
msgctxt "h39fe18f8g8227g489cg8f94ge1e2c9a189cb"
msgid "Did you even try to save Cal?"
msgstr "칼을 구하려고 해보긴 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 868b300e-f3fd-fdd7-6831-3e9b3a58f09f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - MONK(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:868b300e-f3fd-fdd7-6831-3e9b3a58f09f
msgctxt "h5db536e7g8486g48edgad4dg881f26192eeb"
msgid ""
"Breathe. Think. This is no time for harsh words - you only have each other "
"now."
msgstr "심호흡하고, 잘 생각해 봐. 지금은 거친 말 할 때가 아니야. 이젠 서로 밖에 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 8a7b2d29-2a4a-8626-fa11-deff1987ec6b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:8a7b2d29-2a4a-8626-fa11-deff1987ec6b
msgctxt "h34ddf717g46efg44e9gbcedge7b7f0ce83e8"
msgid ""
"You went out of your way to help us, it's only right you get something in "
"return. Here - I hope it helps."
msgstr "우리를 도우려고 그 고생을 하게 했으니, 뭔가 보답을 하는 게 맞겠지. 자, 도움이 되길 바라지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 8c1e4e0f-f0e1-e26e-ec5e-38f4bac2e494
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:8c1e4e0f-f0e1-e26e-ec5e-38f4bac2e494
msgctxt "hb6b3f75cg96c7g4e03gbdb9g11805f220495"
msgid "Don't mention it."
msgstr "별말씀을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 94b6a491-2e61-eab5-9aaf-23a0520f118c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:94b6a491-2e61-eab5-9aaf-23a0520f118c
msgctxt "h5e43d499g37f9g4892ga30egf305deb8cf8d"
msgid "We're all safe, Rolan - that's what matters."
msgstr "우린 모두 안전해, 롤란. 그게 중요한 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = 97a7f225-8cbb-566f-a7a2-ba68d0d98450
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:97a7f225-8cbb-566f-a7a2-ba68d0d98450
msgctxt "hf527a3b6g65c7g477dg8013gd9d29cbbf1d6"
msgid "She's <i>gone,</i> Rolan. I saw it."
msgstr "리아는 <i>죽었어</i>, 롤란. 내가 봤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = 9984860a-1ec7-2f40-9648-83c86f53531f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:9984860a-1ec7-2f40-9648-83c86f53531f
msgctxt "he7e01956gc8cag44d7g8cbeg067137d40d70"
msgid "No - no, it's not your fault. I shouldn't have shouted - I'm sorry."
msgstr "아니, 아니. 네 탓이 아니야. 소리 지르면 안됐는데, 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = 9df1a2fd-1154-a20b-fa2e-c768ac858fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:9df1a2fd-1154-a20b-fa2e-c768ac858fb2
msgctxt "h2d0901ffgf71fg4e26g9b4cg8d158f3e24f0"
msgid "Humble too? Imagine that."
msgstr "겸손하기까지? 그럴 줄 알았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = 9e9c6445-0a9e-ff52-7c51-ed1072192d24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:9e9c6445-0a9e-ff52-7c51-ed1072192d24
msgctxt "hd4b65b9bg795eg4702gb7eeg3183e156ef06"
msgid "This is the last time I risk my life for you lot."
msgstr "너희들을 위해 목숨 거는 것은 이번이 마지막이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = a0a871e4-c263-6664-00eb-75163d345490
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:a0a871e4-c263-6664-00eb-75163d345490
msgctxt "h898e214cg0850g471cgbe6ag0a50bafcf9e8"
msgid "Get out of my sight - both of you."
msgstr "내 눈앞에서 사라져, 둘 다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = a1b8fd62-0e98-0c1f-d3a2-49668e29dd29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:a1b8fd62-0e98-0c1f-d3a2-49668e29dd29
msgctxt "hf0330033g14e7g4c00g9aa5g49c511034da8"
msgid "You're right - I'm sorry. We're all we have right now."
msgstr "네 말이 맞아. 미안해. 우린 이제 서로밖에 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = a23b2ff2-f8cb-bc80-ed54-3e5b4935df7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:a23b2ff2-f8cb-bc80-ed54-3e5b4935df7e
msgctxt "h2833bb46g84a4g4637g848fg086a7e719d5a"
msgid "I'm sorry - we should have been here."
msgstr "미안해. 여기 머물렀어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = aa1a2207-7245-1583-ca53-6c784414247f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_AngrySibling = True
#.     - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:aa1a2207-7245-1583-ca53-6c784414247f
msgctxt "hc8f2d43bgb1ceg4e15g8878gd79b4d5e7782"
msgid "Yes, she's alive. But at what cost?"
msgstr "그래, 리아는 살았지. 하지만 그 대가가 이거라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = b65d7aaf-2e94-85f5-1ceb-faf796ec55c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:b65d7aaf-2e94-85f5-1ceb-faf796ec55c1
msgctxt "hfe27629egd63ag407cg9608g0bfcd10fbb01"
msgid "Gladly."
msgstr "기꺼이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = b6931f1e-7f6b-4fef-328f-03187f88e2c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:b6931f1e-7f6b-4fef-328f-03187f88e2c1
msgctxt "hb3df7d9cgde36g4b15g9c7bg376bf8c89cc5"
msgid "Enjoy the show, did you? Get out of my sight."
msgstr "잘 구경하셨나? 이제 좀 사라지시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = b941084c-e89e-e210-a119-3ba2d320a727
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:b941084c-e89e-e210-a119-3ba2d320a727
msgctxt "h854b82adgcbadg4c04g8763g07b93d0d8674"
msgid "I said go!"
msgstr "가라고 했잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = bfb1b05b-80fb-26b9-77b4-14b76a01b909
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:bfb1b05b-80fb-26b9-77b4-14b76a01b909
msgctxt "hc6154dfcg4193g438dg985bgf8da7b3b5bfc"
msgid ""
"She has no cause to be humble. She's brought us back together - a task I "
"failed miserably at."
msgstr "겸손해할 필요 없어. 우리가 다시 만난 건 전부 이 사람 덕분이야. 나는 꼴사납게 실패했던 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = bfb1b05b-80fb-26b9-77b4-14b76a01b909
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:bfb1b05b-80fb-26b9-77b4-14b76a01b909
msgctxt "hf94374cdg6d9fg4b13g8e4bg1d4ec4a8403b"
msgid ""
"He has no cause to be humble. He's brought us back together - a task I "
"failed miserably at."
msgstr "겸손해할 필요 없어. 우리가 다시 만난 건 전부 이 사람 덕분이야. 나는 꼴사납게 실패했던 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = bfb1b05b-80fb-26b9-77b4-14b76a01b909
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:bfb1b05b-80fb-26b9-77b4-14b76a01b909
msgctxt "hde019119g0cd0g4dcbg9e49ge6bdb3aeb256"
msgid ""
"They've no cause to be humble. They brought us back together - a task I "
"failed miserably at."
msgstr "겸손해할 필요 없어. 우리가 다시 만난 건 전부 이 사람 덕분이야. 나는 꼴사납게 실패했던 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = c2141a80-5d63-ddf9-301e-a9624e5f0d5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:c2141a80-5d63-ddf9-301e-a9624e5f0d5d
msgctxt "h14042d1cg03eag4214gb1fbg518b79981cb7"
msgid "Now is <i>not</i> the time."
msgstr "지금은 때가 <i>아니라고</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = c44277ab-793b-a5e6-dae3-2ed09e71a2f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:c44277ab-793b-a5e6-dae3-2ed09e71a2f4
msgctxt "h50a2bc8ag8a0fg4624ga088g7189246f20e6"
msgid "I thought you'd be happier to see each other."
msgstr "서로 만나면 더 기뻐할 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = c7721b09-ee57-d96b-d793-e90e64e3e977
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - MONK(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:c7721b09-ee57-d96b-d793-e90e64e3e977
msgctxt "h892a9003g0164g4f74ga1a5gd02ca64f2577"
msgid ""
"You speak with  grief stricken hearts, not clear minds. Peace - you need "
"each other."
msgstr "맑은 정신이 아니라 슬픔에 짓눌린 상태로 대화하고 있군. 서로에게 필요한 건... 화합이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = cde1b354-a684-df75-b611-b0a7021e6561
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:cde1b354-a684-df75-b611-b0a7021e6561
msgctxt "h51b69af0gaf30g4babg96ddg5b362f7fac0c"
msgid "The beggar wants their coppers, do they? Fine by me."
msgstr "아, 거지 양반께서 돈이 필요하시구만? 뭐, 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = ce0aa6f7-1cc2-ace4-6656-7ad709afdba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:ce0aa6f7-1cc2-ace4-6656-7ad709afdba8
msgctxt "h7167ac7bgc471g4bb7g943cg2930f7992a6d"
msgid "Gods no, that's not what I meant. Never, Cal. Never!"
msgstr "세상에 아냐, 절대로 그런 뜻이 아니었어, 칼. 절대로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = ce5466f3-a92b-366f-5aff-b663df8c136f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:ce5466f3-a92b-366f-5aff-b663df8c136f
msgctxt "hd77c8b9dg4627g4749ga0bcg241e77426663"
msgid "I'm sorry we got captured by <i>murderous lunatics.</i>"
msgstr "<i>미치광이 살인마들</i>에게 붙잡혀서 미안하게 됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = cfd16dd4-55dc-126c-4d3c-1b7bf2dcb0ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:cfd16dd4-55dc-126c-4d3c-1b7bf2dcb0ba
msgctxt "hb397a092g38bfg41bcg87e8g66c8825c3b66"
msgid ""
"Don't think I've forgotten about you - I bet you didn't lift a finger to "
"save Lia either. <i>Cowards.</i>"
msgstr "내가 널 잊었다고 생각하지 마. 네 녀석도 리아를 구하기 위해 손가락 하나 까딱 안 했을 테지. <i>겁쟁이들.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = d2714d13-1965-8c43-06bf-3de9235ea584
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_AngrySibling = True
#.     - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:d2714d13-1965-8c43-06bf-3de9235ea584
msgctxt "h0a7a88c0gfa1dg4bf6g816ag3ffc64c872c4"
msgid ""
"You deserve <i>nothing. </i>You two are cowardly parasites and I am "
"disgusted it took me this long to see. Get out of my sight."
msgstr "네게 줄건 <i>아무것도 없어.</i> 겁쟁이 기생충 두 명을 오래 보고 있자니 역하군. 내 눈앞에서 당장 꺼져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = d8e9fc71-95c4-920e-9703-61847a235d5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:d8e9fc71-95c4-920e-9703-61847a235d5e
msgctxt "h7dd9ff5fge946g4ccbg8a67g479f7f9608f4"
msgid "You didn't deserve that - I'm sorry. And thank you."
msgstr "네게 그랬으면 안 됐는데... 미안해, 그리고 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = db1e60bb-5995-6b80-83e7-b9d5ac9266c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:db1e60bb-5995-6b80-83e7-b9d5ac9266c1
msgctxt "h3a3719dbg5027g4a67ga755g3dbc59b41d5d"
msgid "I tried to save her - I swear it! Please, Rolan."
msgstr "난 최선을 다했어. 진짜야! 제발, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Cal
#. NodeID = dd6ff898-7b13-4643-5641-e0f9025798ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:dd6ff898-7b13-4643-5641-e0f9025798ba
msgctxt "he32e044egf428g41e7g938cgf50ff136f3ef"
msgid "I'm sorry, Rolan."
msgstr "미안해, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Lia
#. NodeID = ee50205b-9228-2bf9-2172-15197f5ecc5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:ee50205b-9228-2bf9-2172-15197f5ecc5a
msgctxt "hc673df3bgcceeg4547g9028g24b20aa1c2ce"
msgid "Fuck you, Rolan."
msgstr "엿이나 먹어, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = efadc76b-4f6e-e8b4-de67-4eb5da9dce62
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_ProdigyPostRescue(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:efadc76b-4f6e-e8b4-de67-4eb5da9dce62
msgctxt "h1825f402g77edg4f98gadeegc392bc699460"
msgid "What are you doing here? Lia could still be in Moonrise!"
msgstr "여기서 대체 뭘 하고 있는 거야? 리아가 아직 문라이즈에 있을지도 모른다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = f1553fe6-0085-a60b-583b-5dd7ca40a365
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:f1553fe6-0085-a60b-583b-5dd7ca40a365
msgctxt "hedc39f95g1be4g4dfag9289gb22ab0a30adf"
msgid "Mine too."
msgstr "동감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = f15b4e0c-0629-26e8-4af2-e4ba41512c76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:f15b4e0c-0629-26e8-4af2-e4ba41512c76
msgctxt "h8c954cbfg6732g4217g97feg2b93f5169c17"
msgid "Did you even try to save Lia?"
msgstr "구하려고 노력은 해봤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = f16451c0-2daa-95e7-6c07-30025326f31d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:f16451c0-2daa-95e7-6c07-30025326f31d
msgctxt "h9fb4b176g1da5g48cag8c4cg6ffb54c05cf3"
msgid "So Lia gets off scoff free for letting Cal die? I think not."
msgstr "그럼 리아는 칼을 죽게 내버려 둔 비난에서 해방되는 건가? 난 그렇게 생각 안 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = f4693d64-4baf-f349-d819-03bbb38b3b5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:f4693d64-4baf-f349-d819-03bbb38b3b5f
msgctxt "h8a612473gd988g4557gb1d4g384963b2801f"
msgid "So what? We're just supposed to carry on? Act like he never existed?"
msgstr "그래서 어떡하라고? 그가 원래 없던 사람인 것처럼 계속 살아가라 이거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Rolan
#. NodeID = f74620dd-22bc-4210-205f-262ef70d3ba3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_AngrySibling = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:f74620dd-22bc-4210-205f-262ef70d3ba3
msgctxt "hdd393c78gcbd5g4a72gaa24gcddd5bc8007f"
msgid "Go ahead - I'm sure death would be an improvement."
msgstr "해 봐. 차라리 죽는 게 더 낫겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion
#. Speaker = Player
#. NodeID = fde1a5ce-3c16-3f85-b8ee-a7e33ebb4dbe
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Reunion:fde1a5ce-3c16-3f85-b8ee-a7e33ebb4dbe
msgctxt "h40e11cd9g8298g4508gaf50g3eff304ab04a"
msgid "Shut up both of you - you're being childish."
msgstr "둘 다 입 닥쳐. 애처럼 굴지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 0102601e-7e82-17d1-d8ba-d66a0e9f776b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:0102601e-7e82-17d1-d8ba-d66a0e9f776b
msgctxt "hc0a4a733gf60bg4e7dg9609gf774282e5434"
msgid "We need some time, if you don't mind."
msgstr "미안하지만 혼자 있고 싶어"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 02579d00-2a97-47a1-5323-63dc51f5018f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#.      - HAV_SavingPrisoners_State_SisterReturned = True
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:02579d00-2a97-47a1-5323-63dc51f5018f
msgctxt "hdc21c7c4ge0a9g499aga736ga1dce556cff8"
msgid ""
"You're still here? Thought you'd be halfway to Moonrise and leading the "
"Harpers' charge on the tower. Go on - the day needs saving."
msgstr "아직도 여기 있나? 문라이즈에 가서 하퍼들을 지휘하고 있는 중인 줄 알았는데. 가 봐, 도움이 필요할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 02931c30-ec4c-f7ab-0b5b-ebb3afc7aa7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:02931c30-ec4c-f7ab-0b5b-ebb3afc7aa7d
msgctxt "h7c9136edgff2fg4581g9c60g981d802eea01"
msgid ""
"Keep drinking like that and you won't be able to read your spellbook, wizard."
msgstr "그렇게 마셔대다간 주문서도 못 읽게 될걸, 위저드."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 035f4e88-d855-6503-99cf-64dbbc2dc4f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:035f4e88-d855-6503-99cf-64dbbc2dc4f0
msgctxt "h6d5d1566g7282g4803g9c6fga19d18a5728e"
msgid "Cute - maybe she'll write a ballad about me."
msgstr "귀엽네, 내 이야기를 발라드로 써줄지도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 0628976e-97bb-05ba-f495-bc6f385d4ce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:0628976e-97bb-05ba-f495-bc6f385d4ce4
msgctxt "h0c4f9041g4098g4958g95b5gd50f55878654"
msgid "How did you decide which ones to save, and which to leave behind?"
msgstr "누구는 남겨두고 데려와야 할지 어떻게 결정한 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 08f86adb-9095-b65f-33f5-4a0eb9e7c1fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:08f86adb-9095-b65f-33f5-4a0eb9e7c1fe
msgctxt "h129762fagf5e6g4122g92f1g67076a02a52c"
msgid "<i>I'm</i> fine. It's Cal and Lia who need help."
msgstr "<i>난</i> 괜찮다고. 지금 도와줘야 하는 건 칼하고 리아야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 090566e5-bdcb-e79d-3918-b88292c3f9d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Prodigy_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:090566e5-bdcb-e79d-3918-b88292c3f9d0
msgctxt "h41992641g1781g4d18gacbdg345efa055266"
msgid "Something is happening in Moonrise - I can feel it from here. Gods."
msgstr "문라이즈에서 무슨 일이 일어나고 있어, 여기서도 알아차릴 수 있을 정도야. 세상에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 0a8dc936-1aa5-ddf1-199b-55aedeb97742
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:0a8dc936-1aa5-ddf1-199b-55aedeb97742
msgctxt "h1f799faag18c9g4274gbc88gb28e00c15733"
msgid "If you're here to save the day again, you're a little late this time."
msgstr "또 영웅 행세하러 온 거면 이번엔 좀 늦었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 0cd5e9cb-53ae-aab5-0b3d-2a41e4b54e13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:0cd5e9cb-53ae-aab5-0b3d-2a41e4b54e13
msgctxt "h0ff3d04bgd4c0g46d1g9306gf6c4bcd1aa32"
msgid ""
"She can leave out the part where my brother and sister were dragged away "
"screaming while I was saving the orphans."
msgstr "내가 고아들을 구하는 동안 내 가족이 비명을 지르며 끌려갔던 부분은 적어도 생략해 줄 순 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 11135f82-9eaf-8938-8125-28b2e9dbbee9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:11135f82-9eaf-8938-8125-28b2e9dbbee9
msgctxt "h14da9ddbg7f9fg405fga93cgf00c2df5f60b"
msgid "I wanted to make sure you hadn't wandered off again."
msgstr "네가 또 어디 나돌아다니는 게 아닌가 싶어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 12edc525-deb2-0765-ea83-906dc319c6ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:12edc525-deb2-0765-ea83-906dc319c6ff
msgctxt "h431c0e0cg9c2eg4976g9b9eg4544c42cd304"
msgid "Then it's my responsibility to bring them back."
msgstr "그럼, 그 친구들을 데려오는 건 내 책임이겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 18c11359-8c48-2a59-3e35-df5322e9d1d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:18c11359-8c48-2a59-3e35-df5322e9d1d8
msgctxt "h93d78f47g9d9dg4b7bg81cegda61d4f2c657"
msgid "Oh, it's <i>you</i>. I'd recognise that self-righteous tone anywhere."
msgstr "아, <i>너</i>군. 그 독선적인 말투는 어딜 가도 알아차리기 쉽지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 1ce9c97d-aa51-3e97-9dc6-0d15fd2c5dc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:1ce9c97d-aa51-3e97-9dc6-0d15fd2c5dc9
msgctxt "h2a99e633g216eg4636gb270g69517d67f961"
msgid ""
"Oh, it's <i>you</i>. Don't you get tired of telling people how to live their "
"lives?"
msgstr "아, <i>너</i>군. 다른 사람 인생에 훈수 두는 게 지겹지도 않나 보지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 1d2fc014-4fb7-badc-0bf9-6f286e15cdf9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:1d2fc014-4fb7-badc-0bf9-6f286e15cdf9
msgctxt "h30a25c1dgfe78g46a8gb496gc4db7ce87644"
msgid ""
"I can't find Cal and Lia. Tell me they're here... tell me you brought them "
"back."
msgstr "칼과 리아는 못 봤는데. 여기 있다고 해줘... 너가 그 녀석들을 데려왔다고 말하라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 1dcdfa5a-8794-7975-56a1-ec02a0c6cd5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:1dcdfa5a-8794-7975-56a1-ec02a0c6cd5d
msgctxt "hcf655d4dgc97dg4538g93e5gd64f504a26d6"
msgid "Oh, sod off. I'm only here because you 'helped' me and my family."
msgstr "아, 꺼져. 네놈이 우리 가족을 도와줬기 때문에 내가 여기서 이러고 있는 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 1e21ec0b-2d1f-ef9f-4e0c-c5fb182382ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:1e21ec0b-2d1f-ef9f-4e0c-c5fb182382ef
msgctxt "h3e6e2595g59e8g4709ga95fgebacac3e8d6a"
msgid "Well, I'm not here to grovel so piss off."
msgstr "여기서 너한테 굽실거리려고 있는 거 아니니까 꺼져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 21ad3191-e05b-e74b-88fd-93681174a4ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:21ad3191-e05b-e74b-88fd-93681174a4ed
msgctxt "hc91383bfgde40g4ed8ga7c2gd88b1bbf6bf8"
msgid ""
"I'm not going anywhere. Not until Cal and Lia return - and they <i>will "
"</i>return."
msgstr "아무 데도 안 갈 거야. 칼과 리아가 돌아올 때까지, 그 녀석들은 <i>돌아올 거니까</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 2317d6a7-3b2a-9205-11e1-c352cec0d5da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_Knows_SiblingsInMoonrise = False
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Knows_SiblingsInMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:2317d6a7-3b2a-9205-11e1-c352cec0d5da
msgctxt "h5cd91fb7g83e0g419bg8886g86c8d0f75156"
msgid "Where are your siblings?"
msgstr "네 형제들은 어디 갔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 234d8490-d44b-2140-0db8-7ebe33dd1773
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:234d8490-d44b-2140-0db8-7ebe33dd1773
msgctxt "hfc54c237g92bdg4a11ga719g33d1c8a12830"
msgid "Want to talk about your sorrows instead of drowning them?"
msgstr "술독에 빠지는 대신 네 슬픔을 말하지 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 2b88209d-10c3-0b5a-9d31-fe7dee845efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:2b88209d-10c3-0b5a-9d31-fe7dee845efb
msgctxt "h60dce762g416cg4bdfg8787ga95559cb5d3f"
msgid ""
"But you brought some of them back. How did you decide who to save and who to "
"leave behind?"
msgstr "하지만 일부는 데려왔잖아. 누굴 구하고 누굴 남겨둘지는 어떻게 정한 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 2e0c9c95-3b45-3b4c-50a2-c3542bffa10d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:2e0c9c95-3b45-3b4c-50a2-c3542bffa10d
msgctxt "h17556aeagd21fg4741gb198g05dd37f9be01"
msgid "You should have left me there."
msgstr "넌 그냥 거기에 날 내버려 두고 갔어야 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 2fcd478e-e0cb-0829-b5a8-c69469fbe25f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Prodigy_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:2fcd478e-e0cb-0829-b5a8-c69469fbe25f
msgctxt "h677488a3g2763g4236gafc7gb7c36a954759"
msgid ""
"What magic is powerful enough to pierce the curse like a blade through "
"flesh? Incredible."
msgstr "도대체 무슨 마법이길래 칼로 살을 에는 듯한 저주를 뚫을 수 있는 거지? 놀랍군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 313d0dfb-475a-ec70-a935-47e288307452
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:313d0dfb-475a-ec70-a935-47e288307452
msgctxt "h20ffa1d1gb563g44e8g9e37gcc020ad4e77a"
msgid "They're better off dead than in the cult's hands."
msgstr "그 광신도 놈들 손에 놀아나느니 죽어있는 편이 나을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 33096e04-8088-bf88-af09-8c2573c9a785
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:33096e04-8088-bf88-af09-8c2573c9a785
msgctxt "ha3fc4509g4e41g463aga5b4ge7dfd5cc0edf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 3489ff71-afcb-ba7b-ab1d-8d7bd08f9414
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:3489ff71-afcb-ba7b-ab1d-8d7bd08f9414
msgctxt "he45eb49bg8b97g44f1g923fgd8ef15f00a80"
msgid "I saved as many as I could, but they didn't make it. I'm sorry."
msgstr "할 수 있는 만큼 해봤는데 그 둘은 구하지 못했어. 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 351b0c48-9ac4-5c9e-eaa5-74500f8d3424
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_State_Angered = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:351b0c48-9ac4-5c9e-eaa5-74500f8d3424
msgctxt "hd8037c7agf67dg4de4gbb66gcb1beeb90d87"
msgid ""
"We're done here. But if our paths cross in the city, keep your head down and "
"keep walking, or there'll be trouble."
msgstr "우린 끝이야. 도시에서 만나게 된다면 모르는 척하고 지나가는 게 좋을 거야, 아니면 문제가 생기게 될 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 359b0a29-11bc-6b06-eae9-fc18e823dc67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_State_RolanReturned = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_RolanReturned(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Knows_RolanAlive = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:359b0a29-11bc-6b06-eae9-fc18e823dc67
msgctxt "h97fba705gf782g47d8g91f5gae6f40d456f1"
msgid "Yes, yes, you saved me from shadow-creatures. No need to gloat."
msgstr "그래, 그래 날 그림자 괴물한테서 구해낸 건 너야. 그렇게 자랑스러워하지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 3afe13cb-12aa-ccfe-ee7b-16be6e742171
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:3afe13cb-12aa-ccfe-ee7b-16be6e742171
msgctxt "hc6661fa3g5219g4fd9ga499gb4d1b3b2784f"
msgid "If you lay off the liquor, you might be able to help us fight back."
msgstr "우리가 반격하는 걸 도와줄 수 있을 것 같은데, 술 좀 그만 마신다면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 3b79f243-55e0-1b6b-e127-12113f65bfc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_RolanAlert(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Knows_RolanAlive = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:3b79f243-55e0-1b6b-e127-12113f65bfc4
msgctxt "h106ea786ge37ag4ce5g9db0g473f8cb6d820"
msgid ""
"We won't even have to go out into the shadows to die now that the cultists "
"have found us."
msgstr "이제 광신도 놈들이 우리가 어디 있는지 알았으니 자살하러 어둠 속으로 걸어나갈 필요도 없겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 3d0a0ac9-8992-ec92-b130-adb08880c030
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:3d0a0ac9-8992-ec92-b130-adb08880c030
msgctxt "h725d65dag06bcg4e4bgb5c6g0d4c62895664"
msgid "Jaheira didn't save your ragged little tail from the cultists - I did."
msgstr "네 걸레짝 같은 쪼그만 꼬리를 교단에게서 구해준 건 자헤이라가 아니야, 내가 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 40a0ea3f-5c97-9524-23e9-699460250398
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = False
#.      - HAV_SavingPrisoners_Knows_CapturedTieflings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:40a0ea3f-5c97-9524-23e9-699460250398
msgctxt "hac069316ga277g4a90ga519g85ba7b91dedd"
msgid "I am getting tired of having to swoop in and rescue you all."
msgstr "너희 모두를 구하겠답시고 뻔질나게 돌아다녀야 하는 것도 이제 질렸다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 42732e72-277d-3f3a-6976-87cb5a8d70b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:42732e72-277d-3f3a-6976-87cb5a8d70b2
msgctxt "hff0753afg8dd9g49aeg9a1bgead6f5d0aec7"
msgid "I was ready to cut and run back at the grove, but you had other ideas."
msgstr "그때 난 그냥 숲으로 도망갈 준비가 되어 있었는데, 네가 다른 생각을 품고 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 44ec6a72-cafb-bef3-a19a-1a2148bf65c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:44ec6a72-cafb-bef3-a19a-1a2148bf65c4
msgctxt "h47fe40a7g14bdg4208g92cdga19b356d1c2f"
msgid "I am getting tired of having to swoop in and rescue you all."
msgstr "너희 모두를 구하겠답시고 뻔질나게 돌아다녀야 하는 것도 이제 질렸다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 454ab983-3ab7-df9e-dab3-aa1ddb9fc566
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:454ab983-3ab7-df9e-dab3-aa1ddb9fc566
msgctxt "hd889722dg9bfag4216g8c87g3dabb05b0d28"
msgid "You bastard! I should turn your blood to fire."
msgstr "이 개새끼가! 그냥 널 태워버렸어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 473b83d0-4f8a-ec1a-830b-511522e7efd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:473b83d0-4f8a-ec1a-830b-511522e7efd9
msgctxt "h5f00f8adg8db5g47abgb766gb453f9b6450e"
msgid "I'm sorry."
msgstr "유감이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 5a0ca649-5c3f-9d75-c45e-fefd73c0db44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:5a0ca649-5c3f-9d75-c45e-fefd73c0db44
msgctxt "hd326a9e3ge27eg4dd5gbec1g966fd086fe6d"
msgid "The kid's right - you need to lay off the liquor."
msgstr "꼬맹이 말이 맞아, 술 좀 그만 마셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 5bcb2901-2d4e-989c-676c-e437425fb096
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:5bcb2901-2d4e-989c-676c-e437425fb096
msgctxt "hfd14159fgd3eeg49ecgaabagaca3b2088bb0"
msgid "Want to talk about your sorrows instead of drowning them?"
msgstr "비탄에 잠기는 것보다 털어놓는 게 낫지 않을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 5d0e8c5c-d041-bc0a-db20-3b6949082fce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_RolanAlert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:5d0e8c5c-d041-bc0a-db20-3b6949082fce
msgctxt "hfea5eb3fgd736g4d18gb1edgbddee2b6393b"
msgid ""
"If you find any more traitors, kill them quietly. I'm trying to enjoy my "
"drink."
msgstr "배신자를 또 찾아낸다면 조용히 좀 죽여. 지금 한창 즐기고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 5d4add1b-5fd4-e7a6-93d2-dd031b2992df
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:5d4add1b-5fd4-e7a6-93d2-dd031b2992df
msgctxt "h6ba79274g8933g44f9g9854g0703184e264f"
msgid "Carl and Liam? I don't think I know them."
msgstr "칼이랑 리암? 누군지 모르겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 62ff71e0-93fb-dc37-1fd7-9425b62a1b83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:62ff71e0-93fb-dc37-1fd7-9425b62a1b83
msgctxt "ha3e94b24g0a13g4a0cg8a52g94470ea69469"
msgid "I'd rather drown than talk to a sanctimonious prick like you."
msgstr "네놈 같은 위선자랑 얘기하느니 빠져 죽는 게 낫지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 66082d88-80fd-6ab4-96bf-a41665fb9030
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_Rolan(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Event_Intro = True
#.     - HAV_ProdigyLament_Knows_RolanAlive = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:66082d88-80fd-6ab4-96bf-a41665fb9030
msgctxt "h135d65adg6f68g43cega63cg391d93ab78fe"
msgid ""
"...There's another bottle of Arabellan Dry back there. Put it on the bar, "
"then piss off and leave me alone."
msgstr "...저기 아르벨란 드라이 한 병이 있어. 여기 놓고 꺼져 혼자 있게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 6d3d3848-3293-4976-5bf7-dac360eac2a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Rolan(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:6d3d3848-3293-4976-5bf7-dac360eac2a2
msgctxt "h1d4e3905g8603g4166gb85bg1d18217d5dfc"
msgid "I don't need your help, and I don't need your pity."
msgstr "네 도움 같은 거 필요도 없고 동정도 집어치워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 6d5574c0-61d1-2754-9eda-02c671827190
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_Rolan(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Event_Intro = True
#.     - HAV_ProdigyLament_Knows_RolanAlive = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:6d5574c0-61d1-2754-9eda-02c671827190
msgctxt "hab0fd8fcg226fg4748gae85g7e85740cde26"
msgid ""
"...There's another bottle of Arabellan Dry back there. Put it on the bar, "
"then piss off and leave me alone."
msgstr "...저기 아르벨란 드라이 한 병이 있어. 여기 놓고 꺼져 혼자 있게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Ide
#. NodeID = 73441975-c462-e92d-61b7-d4b436d26807
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:73441975-c462-e92d-61b7-d4b436d26807
msgctxt "h05801ed0g6c28g46c2g938agbb688c0a985f"
msgid ""
"Jaheira said we should serve drinks, but that we shouldn't serve drunks."
msgstr "자헤이라가 우리보고 사람들한테 술을 가져다줘야 한다고 했는데, 술주정뱅이한테는 주지 말랬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 7883d683-ba33-ff0a-99ef-7f4272e8cbc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:7883d683-ba33-ff0a-99ef-7f4272e8cbc8
msgctxt "h0effa13bg88e7g4003ga509g4c2c53d7c5f3"
msgid "I'd rather be torn limb from limb than give in to those bastards."
msgstr "그 새끼들한테 항복할 바에 찢겨 죽는 게 낫지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 7a534fd6-6d48-a760-f486-b822902eeb1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:7a534fd6-6d48-a760-f486-b822902eeb1f
msgctxt "h9f26b025gde02g4f15g926fge3d2c110ea47"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 7cca72dd-662b-29b3-bb2f-9c6f5ce89058
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:7cca72dd-662b-29b3-bb2f-9c6f5ce89058
msgctxt "hd294c4e4gfcbeg4b4cgb847g5d1ec5e9ddb8"
msgid "Myself? No, you god-bothering idiot, I blame <i>you</i>."
msgstr "자책한다고? 아니 머리에 신밖에 안 든 네놈을 원망하는 거야, <i>네놈</i>을 원망한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 8038c201-f2b9-381a-a543-5bed0150b40c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:8038c201-f2b9-381a-a543-5bed0150b40c
msgctxt "h489f3d81gedb1g48bagb8aag71d2eddbe69b"
msgid "Sorry won't bring them back."
msgstr "유감이 걔네를 다시 돌려주진 않지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 82688fe1-1ffc-ddd0-213b-208b9072e943
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = False
#.      - HAV_SavingPrisoners_Knows_CapturedTieflings = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:82688fe1-1ffc-ddd0-213b-208b9072e943
msgctxt "hfc9bc77dg547eg4e99gad72g809b9f3d2157"
msgid "What's wrong? Can I help?"
msgstr "무슨 문제 있나? 뭐 도와줘?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 8711f714-030c-f45f-ab26-65f48f914100
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = False
#.      - HAV_AlfiraTale_Knows_SavedByRolan = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:8711f714-030c-f45f-ab26-65f48f914100
msgctxt "h77a73987gb918g483fga4cfg98c73a9a2e22"
msgid "Alfira told me you already saved some of these people from the cult."
msgstr "네가 추종자 놈들한테서 사람들을 지켜냈다고 알피라가 말해주던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 887375b6-908d-1777-b6d2-ac44177909b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_State_ReturnCompleted = True
#.     - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:887375b6-908d-1777-b6d2-ac44177909b3
msgctxt "h563c3cd4g98d4g4e56g8711g73853fdab8b6"
msgid ""
"I'm sorry, Rolan - I couldn't save the prisoners at Moonrise. They're all "
"dead."
msgstr "미안해 롤란, 문라이즈에 잡혀간 사람들을 구할 수 없었어. 이미 죽었더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 89ae4ab1-c7ef-4ad9-f863-aeade18296cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = False
#.      - HAV_SavingPrisoners_Knows_CapturedTieflings = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:89ae4ab1-c7ef-4ad9-f863-aeade18296cb
msgctxt "h439f2d9cg51f3g4c8eg9e5cg29bb9ea7f447"
msgid "Cheer up, Rolan - no need to be glum."
msgstr "기운 내 롤란, 그렇게 축 처져 있지 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 89b8bc1f-5118-0642-2e83-28039bdd113f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_State_ReturnCompleted = True
#.     - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:89b8bc1f-5118-0642-2e83-28039bdd113f
msgctxt "h8862aee3gb7d5g4487ga51cga83cf5a2624c"
msgid "Nobody at Moonrise survived."
msgstr "문라이즈에 있던 누구도 살아남지 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 93360e9b-c14a-25f3-1fbb-3933fb57612d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Knows_SiblingsInMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:93360e9b-c14a-25f3-1fbb-3933fb57612d
msgctxt "h674b95e8ga2cfg45b6g8997g5a1bb9f6055e"
msgid "Do you know where they are?"
msgstr "걔넨 어디에 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 93749a33-66cb-36af-6fec-2a9d0f72d7ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:93749a33-66cb-36af-6fec-2a9d0f72d7ed
msgctxt "hadcf5841g191eg4582g8db3g71ced4f9dea4"
msgid "You saved the kid? Sounds like you deserve a drink."
msgstr "꼬맹이를 구했다며? 한잔해도 되겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = 93b46fbb-4163-80c0-a380-f14ed3b63837
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:93b46fbb-4163-80c0-a380-f14ed3b63837
msgctxt "h0e1f69beg344dg4ec9g8156gf2882e5808bc"
msgid "Simple - you kept up, or you died."
msgstr "간단하지, 계속 따라왔거나, 죽었거나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 94dbcc0c-ac89-f6fa-fffb-2596b527e417
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:94dbcc0c-ac89-f6fa-fffb-2596b527e417
msgctxt "hc1548245g77d5g4c34ga318g80f0b69c50f6"
msgid ""
"They were. And you should have been there to hear their screams when they "
"were dragged away."
msgstr "그렇지. 그 녀석들이 잡혀갈 때 거기서 비명이라도 들었어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 99917d6d-9352-afc8-3606-fefc40ef4442
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:99917d6d-9352-afc8-3606-fefc40ef4442
msgctxt "hf376cf22g2d12g4972g8164g8196340386f0"
msgid "You did what you could. I'm the one that should have done more."
msgstr "넌 할 만큼 했어. 더 노력해야 했던 사람은 나지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 9c077dc7-b8e6-0f2c-49f4-003d9eea104c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:9c077dc7-b8e6-0f2c-49f4-003d9eea104c
msgctxt "h029bc44fgd2fdg4853g912ag2c6e440141f6"
msgid "Oh, I will."
msgstr "아, 그럴 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 9cd2cd34-fcba-da45-8fa8-127c22b1cf41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:9cd2cd34-fcba-da45-8fa8-127c22b1cf41
msgctxt "ha826f188g0d98g4cc8ga9acg0e0ed8b2ead8"
msgid "That's all I wanted - back at the grove. But you had other ideas."
msgstr "내가 원했던 게 그거야, 숲으로 돌아가는 거. 그런데 네가 다른 생각을 품고 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = 9cfe41bf-a9b3-7f8a-4ca1-9b56a6c5bc4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:9cfe41bf-a9b3-7f8a-4ca1-9b56a6c5bc4f
msgctxt "h4bdcda05gfd58g43edgb7c6g24f11f003b22"
msgid "I tried. Maybe she'll write a ballad about me."
msgstr "그러긴 했지. 내 이야기를 발라드로 써줄지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = a3a11743-3c6b-d2d5-1a97-42cd63e90ca4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:a3a11743-3c6b-d2d5-1a97-42cd63e90ca4
msgctxt "hf3ddde1dgb676g400dgbd66g66647ff8531f"
msgid "Is that a joke? I wouldn't be here if it wasn't for you."
msgstr "지금 장난하는 거야? 너 아니었으면 여기 이러고 있지도 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = a6149217-20c0-904c-d821-a76696c3093d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#.      - HAV_ProdigyLament_State_Angered = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:a6149217-20c0-904c-d821-a76696c3093d
msgctxt "hb80b262eg2f53g460fg9033g8686edd31b5f"
msgid "Stay the hells away from me."
msgstr "저리 꺼져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = a8fe195e-8543-ea42-70df-5c4c86a41631
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Rolan(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:a8fe195e-8543-ea42-70df-5c4c86a41631
msgctxt "h76c1536dg9b39g4b41ga765gb644d9190092"
msgid ""
"I'm sure they're cowering in their heavily fortified tower knowing you're on "
"the way."
msgstr "네가 온다는 걸 알면 그놈들은 철통같이 요새화된 성에서 짱박혀 있을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = abff6673-7621-0179-553b-c61a32e8ffd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:abff6673-7621-0179-553b-c61a32e8ffd8
msgctxt "hcbc7adceg28d3g4ab0g8c9cgfa6f3a30065f"
msgid "Bullshit. If they're alive, I can save them."
msgstr "지랄 마. 걔들이 살아만 있다면, 내가 구할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = ad6c3792-faaa-bb3b-7b2a-6fc26d11b4c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:ad6c3792-faaa-bb3b-7b2a-6fc26d11b4c7
msgctxt "hef6315c7g3cfdg4ab7g9cffg0c500eb9fd2a"
msgid "Alfira said you risked everything to save her and the kids."
msgstr "알피라는 네가 엄청난 위협을 무릅쓰고 자기랑 애들을 구했다고 하던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = b13d10e8-af6d-8018-d634-c62f2fbacb6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_ProdigySiblingsFate = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:b13d10e8-af6d-8018-d634-c62f2fbacb6e
msgctxt "hac3f7c1bg1ea0g4160g96f0ge763676293db"
msgid "I heard your siblings were taken by the cult."
msgstr "네 형제들이 교단에 끌려갔다고 하던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = b1600025-1d5c-1f30-b769-adc163a26f9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:b1600025-1d5c-1f30-b769-adc163a26f9a
msgctxt "h0cdd729cge204g454ag9e15gaaf2338f372c"
msgid "I wanted to save everyone, but couldn't."
msgstr "난 모두를 구하고 싶었어, 그렇게 할 수 없었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = b347988f-5314-dc34-2cf2-1933544b1338
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#.      - HAV_SavingPrisoners_State_SisterReturned = True
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:b347988f-5314-dc34-2cf2-1933544b1338
msgctxt "hd34a33cbg86eag44eag9f8cg62e263d75f24"
msgid "I've thanked you once already. Don't be greedy."
msgstr "이미 고맙다고 했잖아. 욕심부리지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = bc9a8084-0e49-a996-8eea-3e895288c902
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:bc9a8084-0e49-a996-8eea-3e895288c902
msgctxt "h1a81f240g4e31g4802gb3dcgb2df28c637e0"
msgid "Look, I just want to get out of this cursed hellhole."
msgstr "난 그냥 이 저주받은 음침한 곳에서 빠져나가고 싶은 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = c11d0503-c48c-e29e-d74f-53431d8a37b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = False
#.      - HAV_AlfiraTale_Knows_ProdigySiblingsFate = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:c11d0503-c48c-e29e-d74f-53431d8a37b8
msgctxt "he05d221fg351dg4a41g8787g44db79e53591"
msgid "I heard your siblings were already taken by them."
msgstr "듣자 하니 형제들이 잡혀갔다며."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = c3159344-54d5-a40d-84f0-8fa6d143e5ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:c3159344-54d5-a40d-84f0-8fa6d143e5ff
msgctxt "h21235c9dg5d1cg40cdgac83g382f2d17afcf"
msgid "Nobody else is dying here."
msgstr "여기서 죽을 사람은 아무도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = c3173cf5-394e-d906-2b1c-a3cd0463be73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_AllPrisonersDied = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:c3173cf5-394e-d906-2b1c-a3cd0463be73
msgctxt "h79f215d2g9daag422agbe6dg9669233587bb"
msgid "Something's on your mind - spit it out."
msgstr "뭔가 할 말이 있는 거 같은데, 말해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = c5c79f0e-c8ad-057e-0487-40a3c5ab2396
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:c5c79f0e-c8ad-057e-0487-40a3c5ab2396
msgctxt "h846732abg8820g4d4ega27dg3095d386a360"
msgid "They died at Moonrise."
msgstr "그 친구들은 문라이즈에서 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = c60227c4-7ccc-549c-ba2c-b36de9a038c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:c60227c4-7ccc-549c-ba2c-b36de9a038c5
msgctxt "h44012c86g393eg4b7aga878g759653ef9d88"
msgid "Stop whining and do something about it."
msgstr "그만 징징거리고 뭐라도 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = c95f8480-272f-c102-c7a7-bd346e3107bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:c95f8480-272f-c102-c7a7-bd346e3107bb
msgctxt "h1cf13e64g6d06g4f9ag96e2g6a647a215873"
msgid ""
"Dead for all I know. Or in the cult's tower with the others who were taken."
msgstr "내가 아는 한 죽었거나 아니면 다른 사람들하고 같이 절대자의 성채에 끌려가 죽었겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = d17c24a8-41a2-1ead-37c0-57de64564ff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:d17c24a8-41a2-1ead-37c0-57de64564ff1
msgctxt "h4ba9f0b0g921eg4625g9d4fg747bf46e1afd"
msgid "I am absolutely going to gloat - I saved your life."
msgstr "아주 자랑스러워할 건데, 네 목숨을 구했으니까 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = d20f38ed-cf3d-69c6-f6a7-329c30aff3d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_EVIL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:d20f38ed-cf3d-69c6-f6a7-329c30aff3d0
msgctxt "h1ec9a791g6004g4d6egbaf3g04b17f25b775"
msgid ""
"Stop blaming yourself, it's pathetic. Accept the will of the gods - however "
"it falls."
msgstr "자책하지 마라, 한심하다. 신의 뜻을 받아들여, 나락으로 떨어진다 해도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = d20f38ed-cf3d-69c6-f6a7-329c30aff3d0
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_ILMATER
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:d20f38ed-cf3d-69c6-f6a7-329c30aff3d0
msgctxt "hd7217449g81a5g4a69ga03cg659130b5605a"
msgid "You must not blame yourself, Rolan. You have suffered plenty already."
msgstr "자책하지 마, 롤란. 수많은 고통을 겪었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = d20f38ed-cf3d-69c6-f6a7-329c30aff3d0
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:d20f38ed-cf3d-69c6-f6a7-329c30aff3d0
msgctxt "h71cdac48g58b4g4b38gbf47gf2c601489afc"
msgid "I sense your cup overflows with pain. Do not blame yourself, Rolan."
msgstr "아픔이 넘쳐흐르는 게 느껴져. 자책하지 마, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = d32dc142-e1ee-6be8-5cda-98b35e2e8607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:d32dc142-e1ee-6be8-5cda-98b35e2e8607
msgctxt "h42b94649g60c7g4d80ga5d6g1fb5a71c8617"
msgid "If they're alive, I'll rescue them."
msgstr "아직 살아있는 거라면 내가 구하러 갈 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = d7166e5b-b482-8c26-39ff-ed28195938c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:d7166e5b-b482-8c26-39ff-ed28195938c5
msgctxt "h031fea15g0647g4b32gabe0g5708be94670d"
msgid "I came to check on you, that's all."
msgstr "그냥 잘있나 보려고 온거야, 그게 다지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = dc6b809f-6c84-a4ea-a031-67991b764242
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Rolan(1) = True
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:dc6b809f-6c84-a4ea-a031-67991b764242
msgctxt "hc7d82608g66ccg48d6gaa2age140b619ff91"
msgid "Nobody else is dying. I'll deal with the cultists."
msgstr "아무도 죽진 않을 거야. 광신도 놈들은 내가 처리하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = dce40366-7891-b56c-78a9-be0ce0089319
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:dce40366-7891-b56c-78a9-be0ce0089319
msgctxt "hfea8ad03g9d80g489ag8d10g642f073d3df8"
msgid "Then it's done - I should have died with them."
msgstr "다 끝났군, 나도 같이 죽었어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = df77afe5-84d7-e80e-7fd3-81ae638ff115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:df77afe5-84d7-e80e-7fd3-81ae638ff115
msgctxt "h8e90f38fg4028g47cag8baeg7792a2861ed6"
msgid ""
"You go save the world, or your own arse, or whatever it is you do. I'll fix "
"this."
msgstr "넌 가서 세상이나 네 앞날을 구해, 네가 뭘 하든 간에 이건 내가 해결할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = e3cba26c-eed0-9cb7-0dcd-7b43106a8332
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Rolan(1) = True
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:e3cba26c-eed0-9cb7-0dcd-7b43106a8332
msgctxt "h1e1055d2gb3d2g4877g898dgcac1b1ea0ee0"
msgid "And you'll be too drunk to care when they cut your throat. Smart."
msgstr "그놈들이 와서 목을 베도 그때쯤이면 넌 거나하게 취해서 느끼지도 못하겠군. 똑똑한 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = e3cd62c6-6cb8-bbc3-3baf-d1a0ed409bf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:e3cd62c6-6cb8-bbc3-3baf-d1a0ed409bf9
msgctxt "h603631c4ga425g4a26g8465gfea4a6ef330e"
msgid ""
"Saving you from the shadows was a choice - what happened at Moonrise was an "
"accident."
msgstr "너를 그림자로부터 구한 건 선택이야, 문라이즈에서 일어난 일은 사고였고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = e4bce06a-b5da-a636-af4a-41d810a0ca1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:e4bce06a-b5da-a636-af4a-41d810a0ca1b
msgctxt "ha1892199gd93fg41bdg9b74g7f4198e09ce8"
msgid "It might not be too late for the others - let me help."
msgstr "다른 이들을 돕기에는 아직 늦진 않았을 거야, 내가 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = ec15a93d-e12d-6edb-9c5c-048840593e2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Rolan(1) = True
#.   Global:
#.      - HAV_ProdigyLament_State_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:ec15a93d-e12d-6edb-9c5c-048840593e2c
msgctxt "h88028970g9ab1g4306g9428g13dfcac5f3a8"
msgid "Scared? Maybe you should have surrendered when you had the chance."
msgstr "겁먹었나? 그러게, 기회가 있었을 때 항복하지 그랬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = ecf527dc-c2b4-1fd1-56d1-33f51023b7bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = False
#.      - HAV_SavingPrisoners_Knows_CapturedTieflings = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:ecf527dc-c2b4-1fd1-56d1-33f51023b7bd
msgctxt "h21e0b5d2gf97ag4c6aga6dag59afcdb84357"
msgid "I heard about the attack in the shadowlands. I'm here to help."
msgstr "그림자의 땅에서 공격 작전을 벌일 거라는 건 들었지. 도와주러 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = efcecb3f-8f7b-7d09-9203-8f8c073e41a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_RolanReturned(1) = True
#.   Global:
#.      - HAV_ProdigyLament_State_RolanReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:efcecb3f-8f7b-7d09-9203-8f8c073e41a9
msgctxt "h74415e65g55efg4724ga661g7d18fc3e0ca5"
msgid "Don't worry - I'm not going anywhere."
msgstr "걱정 마, 아무 데도 안 갈 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = f1ab8e34-0aec-7776-12d1-85996ecda95e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_State_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:f1ab8e34-0aec-7776-12d1-85996ecda95e
msgctxt "hb0cb701eg015bg4770g86fegdaaa4c55758b"
msgid ""
"Cal and Lia were taken in by your crap. You convinced them to play hero, and "
"now they're gone."
msgstr "칼하고 리아가 네 헛소리에 넘어가고. 그 잘난 영웅 놀이를 네가 부추겼지, 그리고 이제 그 녀석들은 여기 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = f23fdb59-5223-ef14-dd94-1d9b029916f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:f23fdb59-5223-ef14-dd94-1d9b029916f8
msgctxt "h6c86474dgc1b4g477fgb387gfdf27b1567ce"
msgid "They're <i>my </i>responsibility."
msgstr "그 녀석들은 <i>내가</i> 책임져야 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = f24313b5-726a-93d6-dd60-ccf2b2fa5131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:f24313b5-726a-93d6-dd60-ccf2b2fa5131
msgctxt "h349e886cg77e7g4fd9g9aaeg713338a35cd7"
msgid "Cheers."
msgstr "건배."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = f48c8f24-9b37-f267-8ecc-2f7f9000a6b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:f48c8f24-9b37-f267-8ecc-2f7f9000a6b3
msgctxt "h59b4c3d4g7a4ag42efg90a6g4e5b846cb8c5"
msgid ""
"That's the same mistake I made when they were taken. It's not a mistake I'll "
"make again."
msgstr "그 녀석들이 잡혀갔을 때 내가 저지른 실수와 똑같은 실수군. 다시 저지를 수도 없는 실수고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Player
#. NodeID = fcc2ccf4-e567-2dc0-5a95-baecdf3e3de8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_AlfiraTale_Knows_SavedByRolan = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:fcc2ccf4-e567-2dc0-5a95-baecdf3e3de8
msgctxt "h0b867bd7g4e7ag4263g8d94gda4871faec19"
msgid "Alfira told me you're the reason her and the kids escaped."
msgstr "알피라가 자기랑 얘들이 도망칠 수 있었던 게 너 덕분이라고 하던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan
#. Speaker = Rolan
#. NodeID = ffea80a4-3dd7-cfcc-af40-d7b7dfe28d01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_ProdigyLament_State_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Rolan:ffea80a4-3dd7-cfcc-af40-d7b7dfe28d01
msgctxt "hcc66ef76gec34g4ca7gb785g7b2c05c71996"
msgid ""
"If you hadn't filled their heads with all that self-righteous heroic crap at "
"the grove, none of this would have happened."
msgstr "그 숲에서 독선적인 영웅 놀이 헛소리로 그 녀석들을 부추기지만 않았다면 이런 일은 일어나지도 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 05c8ee89-b41f-9d84-f868-bb70c92493a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_ProdigyLament_State_ReunionDone = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigySister_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:05c8ee89-b41f-9d84-f868-bb70c92493a5
msgctxt "h9d887388g131fg4807g831cg37f8cdf71585"
msgid ""
"Half this place cleared out when the sky lit up. I'm staying put until I "
"know what's what - I suggest you do the same."
msgstr "하늘이 밝아지고선 여기 절반이 싹 쓸려나갔어. 뭐가 뭔지 알 때까지 가만히 있어야겠어. 너도 그러는 게 좋을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 13294b98-c330-4fa6-4c62-c541b712a992
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:13294b98-c330-4fa6-4c62-c541b712a992
msgctxt "h930f7f91gfe8eg4e80gba41gd68fa4cc2b2c"
msgid "Rolan is dead."
msgstr "롤란은 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 1777f649-948c-30bb-5c2f-daa3c275cf19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:1777f649-948c-30bb-5c2f-daa3c275cf19
msgctxt "hd1ef2481g6a33g4094gadc1g1a69b8c71f02"
msgid "Doesn't matter, does it? They're gone."
msgstr "그게 무슨 소용이야, 안 그래? 전부 죽어버렸잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 2430abcd-43ec-df94-70da-b9d93de79964
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:2430abcd-43ec-df94-70da-b9d93de79964
msgctxt "h63220589g06ffg4defg9033gc24780e46eed"
msgid ""
"You might have saved us, but that doesn't mean I won't beat you to a bloody "
"pulp."
msgstr "우리를 구해줬다고 해서 내가 널 피떡이 되도록 두들겨 패지 못할 거란 생각은 하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 35d5b030-c133-019e-ec85-e02feb046177
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Lia(1) = False
#.   Global:
#.      - HAV_ProdigyLament_State_ReunionDone = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Lia(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:35d5b030-c133-019e-ec85-e02feb046177
msgctxt "h9f30c136gc583g4edcg805bgb29c48527644"
msgid ""
"I'm not the best at showing it, but I love Cal and Rolan to death. They're "
"family - thank you for bringing us back together."
msgstr "잘 표현하진 못하지만, 칼과 롤란을 죽을 때까지 사랑해. 걔네는 가족이야. 우릴 다시 모아 줘서 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 387cd728-71fa-c3ff-6f92-aeea90f5ec1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:387cd728-71fa-c3ff-6f92-aeea90f5ec1c
msgctxt "hde30c62dgfa69g4478ga339g96f01dd55d7b"
msgid ""
"For what? If we hadn't stayed in the grove, if we hadn't listened to you, "
"Rolan might be alive."
msgstr "뭐? 만약 우리가 숲에 남지 않았다면, 만약 우리가 네 말을 듣지 않았다면, 롤란은 살아 있었을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 450714eb-899c-158a-0f02-1fbfc765fbe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:450714eb-899c-158a-0f02-1fbfc765fbe4
msgctxt "h379a7b87ge44dg4775ga037g21027bbf9d32"
msgid ""
"We never should have come here. Helping these people was a <i>mistake.</i>"
msgstr "애초에 여기에 오면 안 됐어. 이 사람들을 돕겠다고 나선 건 <i>실수였어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 48109f46-359a-7733-12e5-7386d8f8f798
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Lia(1) = True
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:48109f46-359a-7733-12e5-7386d8f8f798
msgctxt "h9c8f460cge09cg4801ga2b2g157c8f00767c"
msgid "Anyone gives you shit, come to me - I'll sort them out."
msgstr "누구든 너한테 뭐라 하면, 나한테 와. 정리해 줄 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Player
#. NodeID = 48522e31-ccbf-dd5a-eac1-1ec19db3b213
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:48522e31-ccbf-dd5a-eac1-1ec19db3b213
msgctxt "hc72cf35eg10eeg4cb8g8fc3g1f920ba0e01f"
msgid "I'm sorry."
msgstr "유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 5058dc35-c766-3323-9de4-ffd32f571659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Lia(1) = False
#.   Global:
#.      - HAV_ProdigyLament_Event_AngrySibling = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Lia(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:5058dc35-c766-3323-9de4-ffd32f571659
msgctxt "hc4db10cegba3cg4ac1gb67bg2939c4f1a096"
msgid ""
"<i>Don't. </i>I'm grateful you saved me, but I'm a hair's breadth from "
"pummelling everyone in this place. You can thank Rolan for that."
msgstr ""
"<i>하지 마.</i> 구해 준 건 고맙지만, 난 여깄는 사람 전부를 두들겨 패고 싶은 마음을 간신히 참고 있어. 그건 롤란한테 고마워해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 57e26f31-f2d0-dc04-89bb-57dfe7583f26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Sister_RolanDead_HasMet(1) = True
#.   Global:
#.      - GLO_Prodigy_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:57e26f31-f2d0-dc04-89bb-57dfe7583f26
msgctxt "h8f5f0a27geab2g4600g8ecfg33b2fbe53b27"
msgid "Do not try to stop me. I'm leaving and that's that."
msgstr "날 막지 마. 난 떠날 거고 그걸로 끝이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 585579cf-f030-95ef-99b9-e79d5c1f45c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Sister_RolanDead_HasMet(1) = False
#.   Global:
#.      - GLO_Prodigy_State_ToldSiblingsProdigyDead = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Sister_RolanDead_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:585579cf-f030-95ef-99b9-e79d5c1f45c2
msgctxt "hd5ee46e0gc13dg43adgbb45g2356cd67a1e0"
msgid "Now that I'm here, that I'm safe, it's finally sinking in."
msgstr "이제야 난 여기 있고, 안전하다는 사실이 실감이 되네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 5d2c746a-118a-9823-1067-008c34be4dfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:5d2c746a-118a-9823-1067-008c34be4dfc
msgctxt "he6ac6f40g86c1g4d89gb3degeef01e5836fa"
msgid "For what? I have nothing left."
msgstr "도대체 뭐에 대해서? 나에겐 이제 아무것도 남지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 5da3b99a-cbc9-ee0d-63ca-2377e042260e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigySister_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_ProdigyLament_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:5da3b99a-cbc9-ee0d-63ca-2377e042260e
msgctxt "hef3a99acg4482g4cfag9dedga6b0f5061f3e"
msgid "Maybe the light is good news, maybe not - who knows with this place?"
msgstr "저 불빛이 과연 좋은 소식일까, 나쁜 소식일까. 누군들 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 5ee0b241-60a1-05cc-ddc1-224ce1a58baf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:5ee0b241-60a1-05cc-ddc1-224ce1a58baf
msgctxt "h1c672f03gc18dg40b4g95d0gc39d082eee52"
msgid "We're done here."
msgstr "이제 그만두겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 63b6250b-ebf5-24df-2d7a-a869bd612738
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:63b6250b-ebf5-24df-2d7a-a869bd612738
msgctxt "h41b412cag9a6eg4b4bgaa66g601c975796b3"
msgid "You won't see me again."
msgstr "다시는 날 볼 일이 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 84ac349e-b250-8901-b16b-920f1f160187
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:84ac349e-b250-8901-b16b-920f1f160187
msgctxt "hde97d322g2841g4c3egabe7g510406fefab1"
msgid "Wasn't enough though, was it?"
msgstr "그것만으론 부족했던 거지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 91583dde-2a86-af8c-0791-0114fc3d207b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Lia(1) = True
#.   Global:
#.      - HAV_ProdigyLament_Event_AngrySibling = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:91583dde-2a86-af8c-0791-0114fc3d207b
msgctxt "hcd51fa9ag3612g4519g87eagc1049573595f"
msgid "Leave - I won't repeat myself."
msgstr "사라져, 두번은 말하지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = 96145e6e-6f72-e7d9-aea7-a43a55885985
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:96145e6e-6f72-e7d9-aea7-a43a55885985
msgctxt "h47d5ae4ega30ag449cgbad9g2f8993abc90e"
msgid "Just pray we never meet again - you slimy sack of <i>shit.</i>"
msgstr "다신 만나지 않길 빌기나 해라, 이 비열한 <i>개자식아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = a0e5db44-5d2f-8ea2-d309-4e9c05404881
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Lia(1) = False
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#.      - HAV_ProdigyLament_State_ReunionDone = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Lia(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:a0e5db44-5d2f-8ea2-d309-4e9c05404881
msgctxt "hebf5d8d0gd2b2g4456gac58gbc3c0d7bb210"
msgid ""
"Rolan and I were blessed with hot tempers, and without Cal... well, I'm glad "
"you talked sense into us. Thank you."
msgstr "롤란과 나는 다혈질을 타고났고, 칼 없이는...뭐, 우리에게 이성적으로 대해 줘서 다행이야. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = a893e6a0-ceb5-4720-fc2f-09d0e03852a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = False
#.      - GLO_Prodigy_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:a893e6a0-ceb5-4720-fc2f-09d0e03852a4
msgctxt "h728ca130gd536g4b84gad65g364198658828"
msgid "Where <i>is</i> Rolan? Godsdammit."
msgstr "롤란은 <i>대체</i> 어딨는 거야? 이런 젠장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = b1b9e15c-8757-5ce1-9a15-e6e20445f627
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_State_RolanMissing_HasMet_Lia(1) = False
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_State_RolanMissing_HasMet_Lia(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:b1b9e15c-8757-5ce1-9a15-e6e20445f627
msgctxt "h6909e13dg4a3bg4b27g9ac4g1e831c461547"
msgid "Cal dead, Rolan in the wind. This couldn't have gone more wrong."
msgstr "칼은 죽었고, 롤란도 가버렸어. 이보다 나쁠 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = ba985250-8729-050c-3388-2640643a5cff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_State_RolanMissing_HasMet_Lia(1) = False
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_State_RolanMissing_HasMet_Lia(1) = True
#.   Global:
#.     - HAV_ProdigyLament_Knows_RolanMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:ba985250-8729-050c-3388-2640643a5cff
msgctxt "haf21fe50g8af8g461fg8bd9g68b37fc52606"
msgid ""
"Of course Rolan went looking for us! If you see him, send his arse back here "
"- and fast."
msgstr "롤란이 그새를 못참고 우릴 찾으러 나갔군! 혹시 찾으면 얼른 여기로 튀어오라고 좀 전해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Player
#. NodeID = bdc3e270-01e7-5f84-b1f7-0bd2bb424279
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:bdc3e270-01e7-5f84-b1f7-0bd2bb424279
msgctxt "h4b0a3516g9046g4d23ga910g5a04eb91005d"
msgid "He died as he lived - stupidly."
msgstr "그의 삶만큼이나 바보같은 죽음이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = c0cbb7bf-622c-3ebc-44bc-36191b8cc9d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:c0cbb7bf-622c-3ebc-44bc-36191b8cc9d5
msgctxt "hf3fc4a02g28a0g4ea1gb894gf4acee73ba0b"
msgid "Everyone I've ever loved is dead. I did this - I failed them."
msgstr "내가 사랑했던 모든 사람이 다 죽었어... 다 내 탓이야. 내 잘못이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = c4fab459-98cb-72bc-577e-727a39b42518
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:c4fab459-98cb-72bc-577e-727a39b42518
msgctxt "h26ffd40dg62e8g4a4cgb4a2gbd53458ce3ed"
msgid ""
"It's my fault - we never should have stayed in the grove with these people. "
"They were doomed from the start."
msgstr "다 내 탓이야. 저들과 함께 숲에 머물러선 안 됐어. 애초에 파멸할 수밖에 없는 운명이었던 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = d2082d2f-be55-80d5-5f1c-32ef093a2dcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_Sister_RolanDead_HasMet(1) = False
#.   Global:
#.      - GLO_Prodigy_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_Sister_RolanDead_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:d2082d2f-be55-80d5-5f1c-32ef093a2dcd
msgctxt "hd30be903g4c06g413ega64eg74ecd1e9b33b"
msgid "I know. He's dead."
msgstr "나도 알아. 그는 죽었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Player
#. NodeID = d50a4672-1016-8325-0ad5-a1503f20436f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:d50a4672-1016-8325-0ad5-a1503f20436f
msgctxt "h5e6a3a25g6a7cg4dd1g84e7g03d3447afc0f"
msgid "I did what I could to save him."
msgstr "그를 구하려 최선을 다했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = edb6a0aa-16df-7f7a-db34-813de3490069
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_State_RolanMissing_HasMet_Lia(1) = True
#.   Global:
#.      - HAV_TieflingSurvivors_State_ProdigyLeftHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:edb6a0aa-16df-7f7a-db34-813de3490069
msgctxt "h28d6c6a0geb29g4989g9f5ag7984d143a5da"
msgid ""
"Where <i>is </i>Rolan? If he's not dead, I'll kill him myself - by the gods."
msgstr "<i>도대체</i> 롤란은 어디 있는 거야? 만약 안 죽었다면, 신께 맹세코 내 손으로 죽여버리겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Player
#. NodeID = ef994b8e-46c7-3cf0-9082-a86da4797bb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:ef994b8e-46c7-3cf0-9082-a86da4797bb3
msgctxt "h61ecd593g3b78g4174gb5bcg2ac367024de2"
msgid "A little gratitude would be nice."
msgstr "조금은 감사해 줬으면 좋겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister
#. Speaker = Lia
#. NodeID = f7095d5b-23c6-0107-eded-714ed5178356
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Sister:f7095d5b-23c6-0107-eded-714ed5178356
msgctxt "h97f12924g09a7g4f2ega708g7f7e4e02a78a"
msgid ""
"You and everyone in this dump can rot for all I damn care. And you will."
msgstr "쓰레기장에 있는 모두와 함께 썩어 뒈져버리시지! 그렇게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = 64ae6b94-fdc5-6eb3-fb4b-a0151a41ce01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Umi_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:64ae6b94-fdc5-6eb3-fb4b-a0151a41ce01
msgctxt "hb891852age306g49acga33cg45c6c66c5d3d"
msgid ""
"The sky looks so pretty with the light. Whoever it is must be good - they "
"<i>must </i>be."
msgstr "밝은 빛으로 일렁이는 하늘이 정말 아름다워. 누가 하늘을 밝혔는지는 모르지만, <i>분명</i> 좋은 사람일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = 67f4b9e7-a57d-2856-68a0-466f837c002e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Umi_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:67f4b9e7-a57d-2856-68a0-466f837c002e
msgctxt "h2b560247g0e7eg4085gbaaeg8fb7e6117be5"
msgid ""
"When it's quiet, I'm gonna follow the light. But I'll be safe - I promise."
msgstr "조용해지면, 나는 빛을 따라갈 거야. 하지만 난 안전할 거야. 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = 96ec071f-b770-2cda-eb2c-19624df19d80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_Event_Intro = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_Umi(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:96ec071f-b770-2cda-eb2c-19624df19d80
msgctxt "hcd636a9eg97acg43adgbc30g39836351d5a6"
msgid ""
"I tried telling Mr Rolan that he'd had enough too. He didn't like it then "
"either."
msgstr "롤란 씨에게 충분히 할 만큼 했었다고 말하려고 했어요. 그는 동의하지 않는 것 같았지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = a5adb7f6-f9a0-4d31-9698-88584c7fd73a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_UmiAlert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:a5adb7f6-f9a0-4d31-9698-88584c7fd73a
msgctxt "hae8ebf2cg77eag4c44gbb72gac673710df8b"
msgid "I miss home. I miss Elturel."
msgstr "집에 가고 싶어요. 엘투렐이 그리워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = aaae0ebb-da9e-f3e3-6b1f-4f070c6d25fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Umi(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:aaae0ebb-da9e-f3e3-6b1f-4f070c6d25fe
msgctxt "hb542875bg52d2g46d2ga736ga22897f161f4"
msgid ""
"This is easy. People just tell you what they want and you say 'I think you "
"had enough, mister.'"
msgstr "완전 식은 죽 먹기예요. 사람들이 뭣 좀 달라고 부탁하거든 이렇게 말하면 돼요. '자실 만큼 자셨는데요, 아저씨.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = af295872-a369-3ec2-379b-c3494ef97460
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TieflingSurvivors_State_PromisedToSaveMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:af295872-a369-3ec2-379b-c3494ef97460
msgctxt "h2a21717cg3667g4577g80a0g123a16396326"
msgid "We need Mol. <i>Please </i>get her back<i>. </i>"
msgstr "몰이 없으면 안 돼요. <i>제발</i>, 몰을 구해주세요<i>. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = b6ad529e-8653-c632-d0f3-4542536f6967
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_ProdigyLament_HasMet_Umi(1) = True
#.   Global:
#.      - HAV_ProdigyLament_Event_Intro = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:b6ad529e-8653-c632-d0f3-4542536f6967
msgctxt "hbb353160g8810g4ccdg92dcg3385c2d1d8c3"
msgid "Mr Rolan isn't in a very good mood."
msgstr "롤란 씨는 별로 기분이 좋지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = c49e8d87-24be-8b3f-4d1e-5729781f6a4d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_Umi(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:c49e8d87-24be-8b3f-4d1e-5729781f6a4d
msgctxt "h5cfec70eg5ef8g4833g9688gb686f7b54d97"
msgid "If you want wine, Mr Rolan's drunk most of it already."
msgstr "와인을 찾는 거라면, 이미 롤란 씨가 다 마셔버렸어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi
#. Speaker = Umi
#. NodeID = f9755b3b-e7a4-910f-aa49-c08fba0f65b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_ProdigyLament_HasMet_UmiAlert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_Umi:f9755b3b-e7a4-910f-aa49-c08fba0f65b3
msgctxt "h0b5bd477gbb90g4a60g9835ge74e088e4926"
msgid ""
"I thought we'd left the bad stuff in the grove. I thought we were "
"<i>safe.</i>"
msgstr "나쁜 일은 숲에서 다 끝난 줄 알았어요. 여기는 <i>안전</i>할 줄 알았는데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Manip Vidor
#. NodeID = 33c4e56c-e3b5-4527-80eb-979a38c087bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_A = True
#. SetFlags:
#.   Local:
#.     - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:33c4e56c-e3b5-4527-80eb-979a38c087bd
msgctxt "h5f68bcd5g9832g4d37g873aged1801961845"
msgid "J'ehlar is doing her best, but he shows no signs of waking."
msgstr "제라가 최선을 다하고 있지만 깨어날 기미도 안 보인다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Manip Vidor
#. NodeID = 3d339076-3604-3c93-913b-a8c203d6d7da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:3d339076-3604-3c93-913b-a8c203d6d7da
msgctxt "hf016c535gcae5g4350ga1c4g2d0de0f3d6b1"
msgid "But Baldur's Gate can't."
msgstr "하지만 발더스 게이트는 기다릴 수 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Manip Vidor
#. NodeID = 441d0ecb-606c-23ef-0c30-ac00f10ad1d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:441d0ecb-606c-23ef-0c30-ac00f10ad1d2
msgctxt "h6c528b0egbf2dg4904gba79g74be6bdd2919"
msgid ""
"I wouldn't go that far. But her focus is on stopping the cult, and I suspect "
"she'd sacrifice anyone to achieve that."
msgstr "그런 일 없으면 좋겠지만, 그 자는 교단을 막는 데에만 너무 급급해. 다른 이들이 희생양이 될 지도 모른다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Counsellor Florrick
#. NodeID = 4b0a5e27-88ae-1a2d-d30d-4588ea9f07a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:4b0a5e27-88ae-1a2d-d30d-4588ea9f07a7
msgctxt "hbd862991gfd95g41f4g86e0g32ed7574511b"
msgid "If you have an alternative in mind, please do propose it."
msgstr "다른 대안이 있다면, 부디 제시해주길 바라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Counsellor Florrick
#. NodeID = 60108c47-a140-4e7c-b4d5-104febfb3fd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_B = True
#. SetFlags:
#.   Local:
#.     - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:60108c47-a140-4e7c-b4d5-104febfb3fd5
msgctxt "ha4796cfdg6eaag4ac4g84aag58655fc4a0dd"
msgid "Patience. He may know a way through the curse."
msgstr "인내심을 가지게. 저주를 헤쳐나갈 방법을 알 수도 있잖은가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Manip Vidor
#. NodeID = 62791fff-4884-43b5-9f6e-fe155fe2d607
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:62791fff-4884-43b5-9f6e-fe155fe2d607
msgctxt "h61c1ddd3gad9dg410eg9c5cgdcd698383201"
msgid "Any help from Jaheira?"
msgstr "자헤이라의 도움은 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Counsellor Florrick
#. NodeID = 82a19b0e-64b7-285d-765d-aa2b03958acf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:82a19b0e-64b7-285d-765d-aa2b03958acf
msgctxt "hfae3d316gd346g4358g8633g2b6ea33cc763"
msgid "We can wait."
msgstr "우린 기다려야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Manip Vidor
#. NodeID = 89bef0cd-def0-48f2-961f-644fe75ad130
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_C = True
#. SetFlags:
#.   Local:
#.     - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_B = False
#.     - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_A = False
#.     - 99aa7b78-defd-57bc-eabf-a8aa43a030d9_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:89bef0cd-def0-48f2-961f-644fe75ad130
msgctxt "hfb4818begb89cg418cgba25g8a6ad45d864a"
msgid ""
"So the plan is to do <i>nothing? </i>Let the Duke rot in prison while "
"Baldur's Gate burns?"
msgstr "그래서 계획이란 게 <i>아무것도 </i>안 하는 거라고? 대공님이 감옥에서 썩는 동안 발더스 게이트가 불타게 두자고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Manip Vidor
#. NodeID = 9fd13cb8-fb86-e3ed-1b27-9ce357f074b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:9fd13cb8-fb86-e3ed-1b27-9ce357f074b9
msgctxt "h39d09260g67dfg4b16gb837g09dd2e915969"
msgid "But she doesn't care if the Grand Duke lives or dies."
msgstr "하지만 대공님이 죽든 말든 상관하지 않잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Counsellor Florrick
#. NodeID = a8639ecc-ed91-cfd9-1c61-a064bedc4db9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:a8639ecc-ed91-cfd9-1c61-a064bedc4db9
msgctxt "h6dbb50eag5b92g4baaga448g5a6435fb6f02"
msgid ""
"But we <i>do </i>know that anyone who goes charging into those shadows is "
"dead."
msgstr "하지만 저 그림자에 뛰어드는 자는 죽은 목숨이라는 건 <i>확실히</i> 알지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Counsellor Florrick
#. NodeID = abd4226b-b887-bf4f-610f-7b39029a8d0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:abd4226b-b887-bf4f-610f-7b39029a8d0e
msgctxt "h9ab1c769g964cg4f38gb0efg69b84b323b83"
msgid "She wants the same thing we do. To save the city."
msgstr "그녀와 우리의 목적은 같아. 발더스 게이트를 구하는 것이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Counsellor Florrick
#. NodeID = bf265654-18a6-42a9-a09d-a89342e32064
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:bf265654-18a6-42a9-a09d-a89342e32064
msgctxt "h13131e9fg7074g4800gb682g6a64aae878c7"
msgid "What I won't do is send any more of our people into the curse."
msgstr "그저 우리 사람들을 더는 그림자 저주로 보내지 않으려는 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Counsellor Florrick
#. NodeID = d836f0ef-a4eb-436d-9aa6-f6ba4545d502
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:d836f0ef-a4eb-436d-9aa6-f6ba4545d502
msgctxt "h6f811cdcg6530g47e0g9c84g76d847b11fb7"
msgid "Far from it. We need a way into the Towers. I intend to find one."
msgstr "그렇지 않아. 문라이즈 타워로 들어갈 방법을 찾아야 해. 내가 찾도록 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick
#. Speaker = Manip Vidor
#. NodeID = fa3a9cc9-874a-63c8-1d1e-30dd35f5557c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_ArguingWithFlorrick:fa3a9cc9-874a-63c8-1d1e-30dd35f5557c
msgctxt "h0e784366g4e8bg4938ga396g9a497e2e9b5b"
msgid "We don't even know if he'll ever recover."
msgstr "그가 회복할지 아닐지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_BrotherInspection
#. Speaker = Danis
#. NodeID = e2f614bb-b131-4623-9122-3ff08efa4d9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_BrotherInspection:e2f614bb-b131-4623-9122-3ff08efa4d9c
msgctxt "h7c929886gde50g4f0eg9dc7gc7c4877d0a0b"
msgid "I would tell you if I had one, I swear it!"
msgstr "내가 그걸 알았다면 말했을 거야, 맹세해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_RoofWatcher_Caster_InCombat
#. Speaker = Harper Terradissia
#. NodeID = 8167b18f-50ca-46b7-b53c-3351c6bcb89d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_RoofWatcher_Caster_InCombat:8167b18f-50ca-46b7-b53c-3351c6bcb89d
msgctxt "he9d15bb1g9290g45fag83f9g7f285611143f"
msgid "Hah. Just look at you."
msgstr "하. 네 놈 꼴을 봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_001_CouncillorDefeated
#. Speaker = Fist Thadwick
#. NodeID = 58cf99fb-f505-4e88-a4b6-6991130ee97c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_001_CouncillorDefeated:58cf99fb-f505-4e88-a4b6-6991130ee97c
msgctxt "h3d86926bgd44dg43ecg91bagb7871881f392"
msgid "The Cousellor's fallen - Fists, don't give up!"
msgstr "자문관이 쓰러졌다. 대원들이여, 동요하지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Desire_InCombat
#. Speaker = Counsellor Florrick
#. NodeID = 9d4ffb08-7a39-4233-abd2-529f1e31ca5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Desire_InCombat:9d4ffb08-7a39-4233-abd2-529f1e31ca5e
msgctxt "hf27252f6gb0c1g4cc8g804cg923424caa136"
msgid "Fists - to me!"
msgstr "대원들이여, 집합하라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_001_InCombat
#. Speaker = Fist Thadwick
#. NodeID = 759a6b1b-2f20-4e5c-8ef9-18aa052888f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_001_InCombat:759a6b1b-2f20-4e5c-8ef9-18aa052888f7
msgctxt "h857aa5d6gdd17g44d4gb929g928ae304ee84"
msgid "What is going on?"
msgstr "무슨 일인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_003_InCombat
#. Speaker = Fist Rahir
#. NodeID = 36947d7f-44d3-40f9-9629-cde9c5b1c599
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_003_InCombat:36947d7f-44d3-40f9-9629-cde9c5b1c599
msgctxt "h1b10fe31geb1dg4265g8221gcecc717ead3d"
msgid "Stand your ground."
msgstr "자리를 지켜라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_005_InCombat
#. Speaker = Fist Gretta
#. NodeID = 6ff3d108-9ae7-4e2e-a6c0-f71226bde487
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_005_InCombat:6ff3d108-9ae7-4e2e-a6c0-f71226bde487
msgctxt "h49b7d215gdba7g4f91ga5e9g0518f2287cb0"
msgid "The Flaming Fist bow to <i>no one.</i>"
msgstr "플레이밍 피스트는 <i>누구에게도</i> 굴복하지 않는다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_006_InCombat
#. Speaker = Fist Cyril
#. NodeID = 72d926a8-cc15-4c52-924c-978d273a4984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlamingFist_006_InCombat:72d926a8-cc15-4c52-924c-978d273a4984
msgctxt "had4ce527g16cdg4ae3ga91cg12b19be5614b"
msgid "Show no mercy!"
msgstr "자비를 보이지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlirtyInspection
#. Speaker = Lakrissa
#. NodeID = bf6de400-7e8e-458a-84d4-556b200e2e92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_FlirtyInspection:bf6de400-7e8e-458a-84d4-556b200e2e92
msgctxt "h0de16d27g2b4cg4120gaab0g26d81b9412fe"
msgid "These Flaming Fists don't take themselves half seriously, do they?"
msgstr "이 플레이밍 피스트 대원들은 자기 목숨을 조금도 아낄 줄 모르네, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Gnome01Inspection
#. Speaker = Nimble
#. NodeID = 4bbaea96-f1a5-4dbf-89c4-99eab13cd62e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Gnome01Inspection:4bbaea96-f1a5-4dbf-89c4-99eab13cd62e
msgctxt "h58e4272ag7467g4c41g9c90g367944e68454"
msgid "This is a waste of time - I certainly don't have one."
msgstr "이건 시간 낭비라고. 나한텐 한 마리도 없다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Gnome02Inspection
#. Speaker = Nickels
#. NodeID = 98cd06f5-4dfa-4b7c-a02f-961a3590a235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Gnome02Inspection:98cd06f5-4dfa-4b7c-a02f-961a3590a235
msgctxt "h07385dcdg2224g430bga40agc0d95f9e969a"
msgid "I want to go inside - to the wood and stone. Where it's quiet - safe."
msgstr "빨리 들어가고 싶어. 나무와 돌로 보호된 곳 말이야. 조용하고 안전하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Inspection
#. Speaker = Harper Arthus
#. NodeID = 0c1e4387-4152-0767-ee9a-0edf75bdb16c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Inspection:0c1e4387-4152-0767-ee9a-0edf75bdb16c
msgctxt "h935bf67dgd3dfg4a99g86f9g0c7f0be00943"
msgid "That's it, this won't take long."
msgstr "그렇지. 금방 끝날 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Inspection
#. Speaker = Harper Arthus
#. NodeID = 0fca7abd-922e-22fa-c6ba-6dcbcc9d9b7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Event_InspectionFinished = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_Inspection:0fca7abd-922e-22fa-c6ba-6dcbcc9d9b7d
msgctxt "h59b9d361ge04fg431cg85ffg324cec511518"
msgid "And you're clear. Welcome to Last Light."
msgstr "이상 없군. 최후의 빛을 찾아온 걸 환영하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_LoverInspection
#. Speaker = Danis
#. NodeID = d993733a-ea2f-4641-a958-9cd77b4be87e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_LoverInspection:d993733a-ea2f-4641-a958-9cd77b4be87e
msgctxt "h3e379d92g049eg43bdg8f7bgdbb32be2c8c5"
msgid "We have to worry about parasites now? Gods."
msgstr "이제 기생충까지 걱정해야 할 판이라고? 맙소사."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_SisterInspection
#. Speaker = Lia
#. NodeID = 7a075a1c-e52f-43f9-905e-5217319140ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_SisterInspection:7a075a1c-e52f-43f9-905e-5217319140ae
msgctxt "h0d77db56gdf60g4693g8d24g57903443a5a1"
msgid "Can we hurry this up? I need a drink. <i>Now.</i>"
msgstr "좀 서둘러 줄 수 없어? 한 잔 해야겠다고. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_WulbrenInspection
#. Speaker = Wulbren Bongle
#. NodeID = cd04fd15-ac5d-4c68-be0a-d1b9260c68de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_AD_WulbrenInspection:cd04fd15-ac5d-4c68-be0a-d1b9260c68de
msgctxt "h8281e9bagc3c6g422egb971g7f50ffdf2c76"
msgid "This is ridiculous - as if I'd let some <i>parasite</i> infect me."
msgstr "기가 찰 노릇이군. <i>기생충</i>을 순순히 받아들였을 리 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 00106905-57b8-b32f-28c0-839f7e7da53b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:00106905-57b8-b32f-28c0-839f7e7da53b
msgctxt "hc914da3fg4d62g4d4fgbc6cgc069ec056afe"
msgid ""
"Here, form a line. Let's see if the Absolute's little pet recognises any of "
"you."
msgstr "자, 줄을 서. 절대자의 애완견이 너희를 알아볼지 한번 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Narrator
#. NodeID = 0020ca91-1bda-02eb-a140-9cb75fa85cf1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:0020ca91-1bda-02eb-a140-9cb75fa85cf1
msgctxt "h6ee1fa17g33ebg4c9cg9ab6g21693eab24e5"
msgid "*Your journey through the darkness has brought you to land, at last.*"
msgstr "*어둠을 헤치고 마침내 육지에 도착했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 127b93e7-ebb7-2490-36fe-e714a16bbbaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:127b93e7-ebb7-2490-36fe-e714a16bbbaa
msgctxt "hb457bf59g7d5fg43eeg8250gb9e25ace22b4"
msgid "If what you've said is true, no one has anything to fear."
msgstr "당신이 말한 내용이 사실이면 아무것도 두려워할 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 1b5a84e3-c9e0-ff44-175c-5b1265030bb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:1b5a84e3-c9e0-ff44-175c-5b1265030bb8
msgctxt "h62c4c0d1gb008g4154g827bg47cdc65daa97"
msgid "No one gets in without being tested - Commander Jaheira's orders."
msgstr "누구도 검사를 받지 않고서는 여기 들어올 수 없어, 자헤이라 지휘관의 명령이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Nimble
#. NodeID = 1d592634-5b10-0a25-aaed-519dba350f45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:1d592634-5b10-0a25-aaed-519dba350f45
msgctxt "h2b20c6a7g9205g43b1g9384g2a7552eef381"
msgid "The Absolute's what? You lost your mind?"
msgstr "절대자의 뭐? 당신 미쳤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Player
#. NodeID = 252d2579-1def-80a4-1598-f087935a4414
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:252d2579-1def-80a4-1598-f087935a4414
msgctxt "h38e91d80g3dd7g4727gb926g40556bfafe91"
msgid "I passed your damn test already. I remember the vines vividly."
msgstr "그 망할 놈의 검문은 이미 통과했는데. 덩굴이 아직도 생생하게 기억난다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Player
#. NodeID = 30058b25-f659-bfc1-26f7-8273d5fdfb21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:30058b25-f659-bfc1-26f7-8273d5fdfb21
msgctxt "hd8e41628g3a15g4c77gb76cg734512b2b837"
msgid "Fine, test them."
msgstr "알겠어, 검문해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Nickels
#. NodeID = 39316ba8-8cbd-b844-ec20-1ea4e0e1bb50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:39316ba8-8cbd-b844-ec20-1ea4e0e1bb50
msgctxt "h20fedd9ag3dd6g46ebgafd6g3c8687bda976"
msgid "The what? You - you ain't serious?"
msgstr "뭐라고? 진심이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Player
#. NodeID = 4ec89243-f336-1cef-1ee9-47a562e26905
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:4ec89243-f336-1cef-1ee9-47a562e26905
msgctxt "hdfeb098eg2395g46cfga7afgbb1c37e2348c"
msgid "You didn't think you'd escaped, did you? No one escapes the Absolute."
msgstr "벗어났다고 생각한 건 아니지? 누구도 절대자로부터 벗어날 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Lia
#. NodeID = 561e2414-5a7c-eb7f-6aa0-ffba62220642
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:561e2414-5a7c-eb7f-6aa0-ffba62220642
msgctxt "ha1ff7f85g35ffg43a7gbd11g1d8f886cc442"
msgid "The Absolute's what? What are you talking about?"
msgstr "절대자의 뭐? 무슨 말을 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 6167d3cf-2727-2139-ad70-0fb8b0409eae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:6167d3cf-2727-2139-ad70-0fb8b0409eae
msgctxt "h7a75285egd46cg47bdg834dgf5130d81fec3"
msgid ""
"Hold there! You can't just land and start unloading strangers - there are "
"procedures, damn it."
msgstr "잠깐! 거기에 그냥 배를 대고 누군지도 모르는 사람을 내리면 안 된다고, 절차라는 게 있어, 젠장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Player
#. NodeID = 6414a004-f244-169d-d7b3-684a8db3b58e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:6414a004-f244-169d-d7b3-684a8db3b58e
msgctxt "habadabf9gb1e0g4f1fgb0fdge6f14c3e7dc5"
msgid "Just do as he says. Trust me, this is the easy way."
msgstr "그냥 시키는 대로 해. 나를 믿고, 이게 최선이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Player
#. NodeID = 6f15521d-735c-c4b0-9c4a-c7556b0240d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:6f15521d-735c-c4b0-9c4a-c7556b0240d7
msgctxt "h94589cfagd467g46b4g8977g7c7908343723"
msgid "Jaheira ordered all Harpers to let me come and go as needed."
msgstr "내가 자유롭게 드나들 수 있도록 자헤이라가 하퍼한테 명령했었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 704924a5-9431-4c1b-1095-81325454f829
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = False
#. SetFlags:
#.   Object:
#.     - HAV_EnteringHaven_Event_TrespasserSpotted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:704924a5-9431-4c1b-1095-81325454f829
msgctxt "hbedc0bddg4fb0g4e62gbe35ge85e14919207"
msgid ""
"We'll process this lot, but you need to come with me. The Commander will "
"want a word."
msgstr "이 일은 대부분 우리가 처리하겠지만, 당신은 같이 가줘야겠어. 지휘관께서 할 말이 있다고 하시니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Lakrissa
#. NodeID = 7636008f-61fb-1ded-91c3-126cf781abc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_9 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:7636008f-61fb-1ded-91c3-126cf781abc3
msgctxt "h6315cb1fg7ce8g4e9ag8260g5f8faed22e99"
msgid "The Absolute's pet? Tell me you're joking."
msgstr "절대자의 애완견? 농담이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Wulbren Bongle
#. NodeID = 7dc67456-330a-622c-f1a7-eb3db4361783
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:7dc67456-330a-622c-f1a7-eb3db4361783
msgctxt "he4836ef5geab1g433fgbed7g7031a5a923e1"
msgid "The Absolute's what? What are you doing?"
msgstr "잘대자의 뭐? 뭐 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 804d43f8-6bf7-08b5-236c-84233000bf0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:804d43f8-6bf7-08b5-236c-84233000bf0c
msgctxt "h467cad10g2e66g4a4dg8c28g59006ca6b637"
msgid "If not - well, we'll soon find out."
msgstr "사실이 아니라면, 뭐 알게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 8bb36abc-f327-0568-c4d4-bdad098c5e04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:8bb36abc-f327-0568-c4d4-bdad098c5e04
msgctxt "h20519476g073ag4bd1g921dg262d66a03ee0"
msgid "You did, but your friends did not."
msgstr "당신이 통과한 거지, 당신 친구들은 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Cal
#. NodeID = 8ee81170-6556-c913-7d4a-ef73dc5889cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:8ee81170-6556-c913-7d4a-ef73dc5889cd
msgctxt "h7c370ecfg8d27g491bga887ge8de95f3630c"
msgid "What do you mean? What 'pet'?"
msgstr "무슨 소리야? 애완견이라니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = 9b83c0cb-bed0-0828-f033-8e4a31a0278e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:9b83c0cb-bed0-0828-f033-8e4a31a0278e
msgctxt "hbdebee99g08f0g4273ga419gaacd9a0efc6d"
msgid ""
"Anyone could be infected, so we're checking all new faces. No exceptions."
msgstr "누구나 감염되어 있을 수 있어, 그러니까 새로 오는 사람은 다 확인해야 해. 예외는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = a071e34b-c353-7518-292b-948880780f50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:a071e34b-c353-7518-292b-948880780f50
msgctxt "h36616d1ag0245g4c20g967dg5d0bd594e39f"
msgid "The commander cleared you, not your friends."
msgstr "지휘관께서 당신만 통과시켜 준 거야, 저 친구들이 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = a12b9749-eb55-caf5-5c27-3c9cbb191ef4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_EnteringHaven_Event_TrespasserSpotted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:a12b9749-eb55-caf5-5c27-3c9cbb191ef4
msgctxt "h02f5a357gc005g4747ga530g87756045cb7f"
msgid ""
"I don't know who you are, but you're coming with me. The Commander will want "
"a word."
msgstr "당신이 누군지는 모르겠지만, 같이 가줘야겠어. 지휘관께서 할 말이 있다고 하시니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Narrator
#. NodeID = a6d72949-60b2-1c99-e38a-ddba6228f9e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:a6d72949-60b2-1c99-e38a-ddba6228f9e6
msgctxt "he3994b31gdec7g45fag872fg5459fadb874e"
msgid ""
"*You drift through the dark until time, skill, or luck brings you to Last "
"Light's dock.*"
msgstr "*당신은 어둠 속을 헤치고 나와 시간, 기술, 운이 따른 끝에 최후의 빛 선착장에 도착합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = a935cef5-36f4-65f8-b089-6552fe90198a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:a935cef5-36f4-65f8-b089-6552fe90198a
msgctxt "h26892aeage4afg42f2gb193g32934e0eb5b2"
msgid "Enough playing, True Soul. It's time to see what you've brought us."
msgstr "장난은 그만하지, 참된 영혼. 이제 당신이 데려온 것들을 확인해 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = b02258ff-2a45-6c70-068d-79a6d90bef12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:b02258ff-2a45-6c70-068d-79a6d90bef12
msgctxt "hb87d58b1g7068g48fdgbd26gde3ea4617a9e"
msgid "Now, form a line. I'll not ask again."
msgstr "자, 이제 일렬로 서. 두 번 말하진 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Player
#. NodeID = c798a0db-4fef-6e76-0c81-54f09fd2c698
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:c798a0db-4fef-6e76-0c81-54f09fd2c698
msgctxt "ha3033515g46edg426fgac44gd4140f3b54ff"
msgid ""
"We just escaped the Absolute - these people need sanctuary, not 'procedures'."
msgstr "우리는 방금 절대자 놈들한테서 벗어났어, 이 사람들에게 필요한 건 '절차'가 아니라 피난처야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Danis
#. NodeID = cd18a0c3-8c84-2404-e3ac-6f8a03b49774
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_8 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:cd18a0c3-8c84-2404-e3ac-6f8a03b49774
msgctxt "h940a6b4dg0e6cg4135gb6ecgb331f5b10a9e"
msgid "The Absolute's - what are you talking about?"
msgstr "절대자의, 뭐라고 하는 거야 지금?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Harper Arthus
#. NodeID = ce094e60-8018-2ce7-de55-80c07f7bb20a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:ce094e60-8018-2ce7-de55-80c07f7bb20a
msgctxt "h37167cc1g5ac1g40dbgb24ag743cc029acaf"
msgid "And they'll have it, once we know they're free from infection."
msgstr "저들이 감염되지 않았다는 것만 확인하면 그렇게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Player
#. NodeID = d1cbf817-cea4-9ab7-07dc-23ee4cb829d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:d1cbf817-cea4-9ab7-07dc-23ee4cb829d8
msgctxt "hb14ff276g1ad3g40f8g9002gb8f8d89cb1d9"
msgid "He only wants to see if you're infected. It's safe, I promise."
msgstr "당신이 감염됐는지 확인만 하는 거야. 안전해, 보장할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival
#. Speaker = Narrator
#. NodeID = db2f32ce-2568-b08a-be6c-3a361e7108ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = False
#.      - GEN_IsSpeakerPresent_4 = False
#.      - GEN_IsSpeakerPresent_3 = False
#.      - GEN_IsSpeakerPresent_8 = False
#.      - GEN_IsSpeakerPresent_6 = False
#.      - GEN_IsSpeakerPresent_9 = False
#.      - GEN_IsSpeakerPresent_5 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Arrival:db2f32ce-2568-b08a-be6c-3a361e7108ce
msgctxt "hba30167bg7ba6g4993g92d0g4928ea1601c4"
msgid "*Your arrival has not gone unnoticed.*"
msgstr "*당신의 도착을 아무도 눈치채지 못한 것 같습니다*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_ArrivalInspector
#. Speaker = Harper Arthus
#. NodeID = 68dae24e-ceb5-f024-c518-8fb1fb7bee42
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Inspector(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_ArrivalInspector:68dae24e-ceb5-f024-c518-8fb1fb7bee42
msgctxt "hd3535047gdb0eg4006gac1dgfefe3ce1f5fc"
msgid "Keep your distance. Let's not confuse the parasite."
msgstr "거리를 유지해. 기생충들을 혼란시키지는 말자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_ArrivalInspector
#. Speaker = Harper Arthus
#. NodeID = 6d9c941d-4d8a-4f84-9c5a-6488433bf985
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Inspector(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_ArrivalInspector:6d9c941d-4d8a-4f84-9c5a-6488433bf985
msgctxt "h1c061182gdc25g4f95gaeaeg379d0cad1e2e"
msgid "Now's not the time."
msgstr "지금은 아직 때가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_ArrivalInspector
#. Speaker = Harper Arthus
#. NodeID = 6d9c941d-4d8a-4f84-9c5a-6488433bf985
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Inspector(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_ArrivalInspector:6d9c941d-4d8a-4f84-9c5a-6488433bf985
msgctxt "h2eb05bfdg4d1cg4205gb472gd248f6e3efeb"
msgid "Do you mind?"
msgstr "그만 좀 해줄래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001
#. Speaker = Fist Thadwick
#. NodeID = 4abb6a5d-9961-43ca-bdd7-665eb74fdb18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_001_HasMet_Protected(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001:4abb6a5d-9961-43ca-bdd7-665eb74fdb18
msgctxt "h338c2eeegaaedg431fg92c2g66fc5943b87b"
msgid "This is no place for amateurs."
msgstr "아마추어들이 끼어들 자리가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001
#. Speaker = Fist Thadwick
#. NodeID = 7f92c317-24cc-4868-9eb9-ef894d490e44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_001_HasMet_Alert(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_001_HasMet_Alert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001:7f92c317-24cc-4868-9eb9-ef894d490e44
msgctxt "h6177b0ebg4821g4146ga4e8g333f234ca0d6"
msgid ""
"The cultists are among us, and you want to chat? Let the professionals "
"handle this."
msgstr "광신도들이 우리 사이로 잠입하고 있는데, 한가하게 수다를 떨자고? 전문가들이 상황을 처리하게 둬라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001
#. Speaker = Fist Thadwick
#. NodeID = bac2af3c-6df0-4e01-a201-f68556e12227
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_001_HasMet_Protected(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_001_HasMet_Protected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001:bac2af3c-6df0-4e01-a201-f68556e12227
msgctxt "h17b609c0g6c34g4e44gb4fdg0be3a4b968a4"
msgid "We're discussing Fist business - and you're no Fist."
msgstr "우린 플레이밍 피스트 일을 의논 중이야. 넌 피스트가 아니고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001
#. Speaker = Fist Thadwick
#. NodeID = c3eec5bc-849d-4297-a957-8ee916353c9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_001_HasMet_Alert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_001:c3eec5bc-849d-4297-a957-8ee916353c9b
msgctxt "h613ca60ag41fcg4a31g91e6g704720b05908"
msgid "Infected <i>and </i>a busybody? Why Jaheira let you in is beyond me."
msgstr "감염된 걸로도 모자라서 <i>참견까지?</i> 왜 자헤이라가 널 들여보낸 건지 이해가 안 가는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002
#. Speaker = Fist Aubree
#. NodeID = 7c4bfeb1-d8f7-4f7d-9cc4-a24c19d8a692
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_002_Hasmet_Protected(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002:7c4bfeb1-d8f7-4f7d-9cc4-a24c19d8a692
msgctxt "h2a091c74g40f5g47c6gb850gbcd2f241590f"
msgid "I've heard the stories about Moonrise. I hope the Duke is all right."
msgstr "문라이즈에 대한 얘기는 많이 들었지. 대공님이 괜찮으셔야 할 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002
#. Speaker = Fist Aubree
#. NodeID = a4f743a7-9281-4426-84aa-01eebd8ff746
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_002_Hasmet_Alert(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_002_Hasmet_Alert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002:a4f743a7-9281-4426-84aa-01eebd8ff746
msgctxt "h658cad32gf242g496cgb8fag0ca8d88552f9"
msgid ""
"Marcus was scum. But the rest of us are loyal to Duke Ravengard, loyal to "
"Baldur's Gate, I swear it."
msgstr "마커스는 쓰레기 자식이었어. 하지만 나머지 대원들은 레이븐가드 공작님께, 그리고 발더스 게이트에 맹세코 충성을 다하는 자들이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002
#. Speaker = Fist Aubree
#. NodeID = c84bdaf8-3e9c-43ea-a8b8-932c9513380f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_002_Hasmet_Protected(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_002_Hasmet_Protected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002:c84bdaf8-3e9c-43ea-a8b8-932c9513380f
msgctxt "h91b9e2e7gfd4cg4cc5ga533g0f3305a9c9da"
msgid ""
"An extra blade could be the difference between rescuing Duke Ravengard or "
"losing him forever. I hope you'll help us."
msgstr "단 한 칼날의 존재가 레이븐가드 대공님을 구하느냐 잃느냐를 가를 수 있지. 네가 꼭 도와줬으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002
#. Speaker = Fist Aubree
#. NodeID = dd5f9e7e-b21f-4ad1-aa2e-f3cf1670942b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_002_Hasmet_Alert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_002:dd5f9e7e-b21f-4ad1-aa2e-f3cf1670942b
msgctxt "hf97a07acgd5f3g421bgab1fg20f5747b37d9"
msgid ""
"Duke Ravengard is more than our leader, he's<i> family.</i> I can't believe "
"one of us would betray him."
msgstr "레이븐가드 대공님은 우리의 지도자뿐만 아니라 <i>가족</i>이야. 우리 중 누군가 그를 배신하다니 믿을 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003
#. Speaker = Fist Rahir
#. NodeID = 4a0ef1fd-df81-49e7-847e-b44a84cc1dcc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_003_HasMet_Protected(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003:4a0ef1fd-df81-49e7-847e-b44a84cc1dcc
msgctxt "h312d3cefga229g4a95gb304g41bcbd51faa9"
msgid "Nothing to be done here. The Duke's in the <i>Towers.</i>"
msgstr "여기선 할 일이 없어. 대공님은 <i>타워</i>에 계신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003
#. Speaker = Fist Rahir
#. NodeID = 748c21de-2b95-4d41-b9c7-76fee9522142
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_003_HasMet_Alert(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_003_HasMet_Alert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003:748c21de-2b95-4d41-b9c7-76fee9522142
msgctxt "h312a16f7gf4e6g4d12gaf67g8cab10336424"
msgid ""
"I've known Marcus for <i>years</i>, to think he would turn on us - on me... "
"you did well to defend Isobel."
msgstr "나는 <i>오랫동안</i> 마커스를 알았는데, 우리를, 나를 배신했다 생각하면...이소벨을 잘 지켜 줬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003
#. Speaker = Fist Rahir
#. NodeID = b32f1319-e137-427b-b725-90825c3bcdd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_003_HasMet_Protected(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_003_HasMet_Protected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003:b32f1319-e137-427b-b725-90825c3bcdd6
msgctxt "h5fa2a30bga503g4473ga5fag81e167e4f682"
msgid ""
"You're heading into the Towers, are you? Good. I pray it's not too late for "
"Duke Ravengard."
msgstr "타워로 가나 봐, 그렇지? 좋아. 레이븐가드 대공님께 가는 길이 너무 늦지 않았길 기도하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003
#. Speaker = Fist Rahir
#. NodeID = bb210b2a-75fa-4d4d-ab6c-93ab40d96ff1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_003_HasMet_Alert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_003:bb210b2a-75fa-4d4d-ab6c-93ab40d96ff1
msgctxt "h84eb1855gd16bg4b12gaef0g1da1a9a4254e"
msgid ""
"We rid ourselves of a traitor, but also someone I once called friend. Leave "
"me in peace, please."
msgstr "우린 변절자 한 명을 없앴지만, 내가 한때 친구라 부르던 사람이기도 해. 부디 날 조용히 내버려둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = 308ce888-5c95-4218-9bf1-e6feb00bd9ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_Protected(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#.      - SCL_AncientFist_ItemReturned = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:308ce888-5c95-4218-9bf1-e6feb00bd9ed
msgctxt "h461c1a34ga943g44b3gaa83g766551cd2689"
msgid "A hundred years locked away inside a curse - can you imagine?"
msgstr "저주 속에 갇혀 백 년을 지냈다니, 상상이 가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = 3b05292f-a7c2-82d9-3e76-6c57835e093c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_KilledAllGuardians(1) = True
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = False
#.      - SCL_AncientFist_ItemReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:3b05292f-a7c2-82d9-3e76-6c57835e093c
msgctxt "h6c7253f7g5cf6g4c7agbf77gc8cf872b45e6"
msgid "Halsin will come, won't he? Seems like he's the key to all of this."
msgstr "할신이 오겠지, 그렇지? 그 사람이 모든 일의 열쇠를 쥐고 있는듯해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = 586c0770-6f93-27e2-2bee-67d4fa6b87ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_HealedMart(1) = False
#.   Global:
#.      - SCL_AncientFist_ItemReturned = True
#.      - HAV_LiftingTheCurse_State_HalsinGoToLake = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_004_HasMet_HealedMart(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:586c0770-6f93-27e2-2bee-67d4fa6b87ee
msgctxt "hd1c387acg22a9g439dga011g32bd6990a7b4"
msgid ""
"I'll say a prayer to Tymora - for your good luck. A copper to the Lady "
"returns tenfold in gold - and maybe something that'll help you and Halsin, "
"too."
msgstr ""
"네게 행운이 따르도록 티모라 님께 기도를 올리겠어. 여신께 바친 구리 동전 하나는 금화 열 배로 돌아오고, 너와 할신을 도울 무언가도 "
"내려 주실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = 86967d7b-85f4-431e-970a-5cf00c75b73c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_Alert(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_004_HasMet_Alert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:86967d7b-85f4-431e-970a-5cf00c75b73c
msgctxt "h7ce0caa4g20afg482eg9c2eg44a5ede47188"
msgid ""
"We kept Art safe - that's what matters. Couldn't have done it without you."
msgstr "아트를 안전하게 지켜냈어. 그게 중요해. 너 없이는 할 수 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = a4f45692-6b21-765d-2ad5-8dc566f8ed57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_KilledAllGuardians(1) = False
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = False
#.      - SCL_AncientFist_ItemReturned = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_004_HasMet_KilledAllGuardians(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:a4f45692-6b21-765d-2ad5-8dc566f8ed57
msgctxt "hdbb7e0aeg1917g4496g837ag90ed96accc07"
msgid ""
"I knew Art had suffered, but I didn't realise the extent of it. And there's "
"a child lost in the shadows still. I hope you can help him."
msgstr ""
"아트가 고통받았다는 사실은 알았지만, 어느 정도인지는 몰랐어. 그리고 아직 그림자 안에 아이가 길 잃은 채 있어. 네가 도와줄 수 "
"있었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = abee9edf-1355-445e-ab01-79c2980664f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_Protected(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#.      - SCL_AncientFist_ItemReturned = False
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_004_HasMet_Protected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:abee9edf-1355-445e-ab01-79c2980664f0
msgctxt "h4c475b49g2d10g4ad9g99e0gea011e55fccf"
msgid ""
"You can help him, can't you? He deserves a life, after all he's been through."
msgstr "도와 줄 수 있어? 그 사람이 겪어 온 일을 생각하면, 살 수 있어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = d0db369a-89fa-4e01-1aee-dcdaa5b04911
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_HealedMart(1) = True
#.   Global:
#.      - SCL_AncientFist_ItemReturned = True
#.      - HAV_LiftingTheCurse_State_HalsinGoToLake = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:d0db369a-89fa-4e01-1aee-dcdaa5b04911
msgctxt "ha0466388g8b87g4af0gbd25g607794cd47a8"
msgid "He's looking well, isn't he? You've done so much for him. Thank you."
msgstr "아트는 괜찮아 보이지, 그렇지? 참 많은 걸 해 줬어. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = d1eea95e-318a-1bb8-ca0a-684b10838c6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_HalsinArrived(1) = True
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = True
#.      - HAV_LiftingTheCurse_State_HalsinGoToLake = False
#.   Tag:
#.      - REALLY_HALSIN(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:d1eea95e-318a-1bb8-ca0a-684b10838c6d
msgctxt "h83e5c3dega2ebg4b5bgb110g7b45ba84619d"
msgid "I hope Halsin can help."
msgstr "할신이 도울 수 있었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = db9e4e88-eb62-4902-8514-65a9ab9dfcff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_Alert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:db9e4e88-eb62-4902-8514-65a9ab9dfcff
msgctxt "h55f30fdagde9fg4488gae86g314dfda63acc"
msgid "He looks a little better, doesn't he? Art, that is."
msgstr "좀 나아 보이지 않아? 아트 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004
#. Speaker = Fist J'ehlar
#. NodeID = e7b87caa-ef2b-fa13-5944-012b7cfc7fb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_004_HasMet_HalsinArrived(1) = False
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = True
#.      - HAV_LiftingTheCurse_State_HalsinGoToLake = False
#.   Tag:
#.      - REALLY_HALSIN(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_004_HasMet_HalsinArrived(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_004:e7b87caa-ef2b-fa13-5944-012b7cfc7fb2
msgctxt "h155702f9g3138g4a9dgbc52g74b01628d813"
msgid "This is him - Halsin, right? The one Art's been asking for."
msgstr "이 사람이 그, 할신 맞지? 아트가 찾고 있던 사람."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005
#. Speaker = Fist Gretta
#. NodeID = 48b178ed-f38f-4b5f-86de-c674f76b2db3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_005_Protected(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005:48b178ed-f38f-4b5f-86de-c674f76b2db3
msgctxt "h5b0ac382g3bf9g499cg9e85g1586b43744ee"
msgid "Gods be with you."
msgstr "신들께서 함께 하시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005
#. Speaker = Fist Gretta
#. NodeID = 9c0c0547-58ad-462a-9c66-785c92513660
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_005_Alert(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_005_Alert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005:9c0c0547-58ad-462a-9c66-785c92513660
msgctxt "h0aea7997gc115g42d9gbb71ga62524677f65"
msgid "Good work rooting out the traitor."
msgstr "변절자들 뿌리 뽑느라 고생했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005
#. Speaker = Fist Gretta
#. NodeID = bff86c1a-cfcf-4bb6-9be6-6e1c3cc2a4d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_005_Protected(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_005_Protected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005:bff86c1a-cfcf-4bb6-9be6-6e1c3cc2a4d6
msgctxt "h0eae8b11g4ca4g483cg8a79g9605dd97601d"
msgid "Nice to see a friendly face come out of the shadows for once."
msgstr "이번만은 그림자에서 아는 얼굴이 튀어나와서 반갑구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005
#. Speaker = Fist Gretta
#. NodeID = cca1e66a-0e7b-40bb-a645-1fd4daf2b535
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_005_Alert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_005:cca1e66a-0e7b-40bb-a645-1fd4daf2b535
msgctxt "hfb16d3c9g8fd0g4e9bg88c9g4aced4118ac8"
msgid "That parasite of yours could prove useful. Until it kills you."
msgstr "네 기생충이 쓸모있을지도 모르지. 그게 널 죽이기 전까지는 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006
#. Speaker = Fist Cyril
#. NodeID = 5f816b07-044a-4c1b-b3f1-9ddbb16c15ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_006_Protected_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006:5f816b07-044a-4c1b-b3f1-9ddbb16c15ce
msgctxt "he3667a8ag8418g48bdg802ag4c00683b3092"
msgid ""
"I'd offer to help, but with Duke Ravengard missing, we can't spare anyone. "
"I'm sorry."
msgstr "돕고 싶지만, 레이븐가드 대공님이 실종된 지금은 여유가 없어. 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006
#. Speaker = Fist Cyril
#. NodeID = 8f0bc907-cce4-40f5-8f7f-0c4c8183b2f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_006_Alert_HasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_006_Alert_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006:8f0bc907-cce4-40f5-8f7f-0c4c8183b2f6
msgctxt "ha93a3589ga4dag4780g882bg5674ae08a98e"
msgid "I knew Marcus well - never suspected a thing."
msgstr "난 마커스를 잘 안다고 생각했어, 전혀 의심하지 않았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006
#. Speaker = Fist Cyril
#. NodeID = b9218277-7d8a-41ca-a861-3c4590755a13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_006_Protected_HasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_FlamingFist_006_Protected_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006:b9218277-7d8a-41ca-a861-3c4590755a13
msgctxt "he205cfedg53eag45f1gb1d4g492cf3c1aefa"
msgid ""
"If you're poking around this gods-forsaken place, you must have someone in "
"Moonrise, too. Hope you find them."
msgstr "이 저주받은 장소를 싸돌아다니고 있다면, 너도 문라이즈에 찾는 사람이 있는 모양이지. 꼭 만나기를 바란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006
#. Speaker = Fist Cyril
#. NodeID = bd1b7ec7-4013-42bd-b065-50f9c8e696e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_FlamingFist_006_Alert_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlamingFist_006:bd1b7ec7-4013-42bd-b065-50f9c8e696e8
msgctxt "h2dbd4c43g3f4ag4b92g8678g3180e4faf464"
msgid "Maybe we could've helped him. Marcus, I mean. Before... you know."
msgstr "도와줄 수 있었을 지도 몰라. 마커스를, 내 말은... 그렇게 되기 전에... 알지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 11ec5577-d08a-260d-5253-fa3bfcb429ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_FlirtyTiefling_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling:11ec5577-d08a-260d-5253-fa3bfcb429ad
msgctxt "h52e914a4g254eg42f6g9eeeg61c1dfd466d1"
msgid ""
"The light - it's happening. Ketheric is about to get a long overdue arse-"
"kicking - I can <i>feel </i>it."
msgstr "저 빛... 때가 왔어. 케서릭이 오랜만에 제대로 한방 먹겠는걸, 그럴 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 32b6a695-5bb4-4b10-84c8-969610d962aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Lakrissa(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling:32b6a695-5bb4-4b10-84c8-969610d962aa
msgctxt "h7ec4aa1ag68e8g4901gb833g79147ce6a42b"
msgid ""
"Things in Moonrise were... bad. Real bad. Thank you - for getting me out of "
"there."
msgstr "문라이즈에서 겪었던 일은... 안 좋았어. 엄청나게. 고마워, 날 그곳에서 꺼내줘서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 6627c984-3e4e-4298-b519-c79b3303f9ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Lakrissa(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling:6627c984-3e4e-4298-b519-c79b3303f9ad
msgctxt "h58d52f9ega582g4e2aga953g39a5c22a9336"
msgid ""
"You ever need a hand, you'll have me at your back - whether you like it or "
"not."
msgstr "도움이 필요하면, 내가 네 뒤에 있을게. 네가 좋든 싫든 간에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 78ab9215-9a34-77da-76c1-9459738605e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_FlirtyTiefling_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_FlirtyTiefling:78ab9215-9a34-77da-76c1-9459738605e4
msgctxt "h30af183dgf9d2g4d16g8345g481f8856bbd2"
msgid ""
"Whoever, or whatever, is causing that light is on our side, I have no doubt."
msgstr "누구든, 혹은 무엇이든, 저 빛을 일으키는 건 우리 편이야. 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 0320f1f2-cf5f-2662-7aa6-4c80a67ae9c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HealedWithMagic_Manip_HasMet(1) = True
#.   Global:
#.      - SCL_AncientFist_ItemReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:0320f1f2-cf5f-2662-7aa6-4c80a67ae9c8
msgctxt "h1916a3cfg9371g4d4egb56dg06dc2ce74f7c"
msgid ""
"You're on the right track with Flame Cullagh. He might be some use to us "
"after all."
msgstr "플레임 쿨라그를 도운 건 잘한 일이야. 결국 우리에게 도움을 줄 지도 모르는 일이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 23ef31db-ed98-bd97-932a-8edfc31ceb8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:23ef31db-ed98-bd97-932a-8edfc31ceb8f
msgctxt "h39577c61g0371g496fg84beg1d97794b3de0"
msgid "I can see that. But progress is progress."
msgstr "그건 그렇지. 그래도 성과는 있었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 2d053e1b-b8ba-f883-80eb-b6b57e6eb20f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HealedWithMagic_Manip_HasMet(1) = False
#.   Global:
#.      - SCL_AncientFist_ItemReturned = True
#. SetFlags:
#.   Dialog:
#.     - SCL_AncientFist_HealedWithMagic_Manip_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:2d053e1b-b8ba-f883-80eb-b6b57e6eb20f
msgctxt "hd1fcb9e2g8e71g452fgb9fdgd951f3f43bac"
msgid "Looks like the stump had some life in him yet - well done."
msgstr "그래도 몸 안에 생기가 남아있긴 했나 보군. 잘했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 2da9c12e-b390-7a5e-f2d7-b621412139c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Manip(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Manip(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:2da9c12e-b390-7a5e-f2d7-b621412139c8
msgctxt "h6ba34fe8g479ag44d5g8aaag1cbf940ca2f6"
msgid "Heard you're meant to be heading toward the Towers."
msgstr "네가 타워로 향할 셈이라 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 343efc6d-2f6b-1c0b-7871-6da414bd1465
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_Manip(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:343efc6d-2f6b-1c0b-7871-6da414bd1465
msgctxt "haf00046cgd161g4be1g8e3cg9720e9dac19b"
msgid "I'd rather lend you my blade, but you'll have to make do with my luck."
msgstr "마음같아선 손을 보태고 싶지만, 당장은 행운을 빌어주는 게 전부일 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 56ffa7eb-3916-5581-3857-ff7d4664c218
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:56ffa7eb-3916-5581-3857-ff7d4664c218
msgctxt "hb6c8086eg3c1dg4e6cgb258g66499a1dbc13"
msgid "We ought to be doing just that. Not babysitting this stump."
msgstr "그거야말로 우리가 할 일인데. 저 목석같은 놈이나 지키고 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = 586252af-fd48-07f1-5f86-8daa213de179
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:586252af-fd48-07f1-5f86-8daa213de179
msgctxt "heed3049dg9884g4a6bg824cg974f17fb89f8"
msgid "You heard right."
msgstr "맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 58e2d501-9bd6-0d6b-1678-6b3e2185df9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:58e2d501-9bd6-0d6b-1678-6b3e2185df9c
msgctxt "h1287b0f4g7c2dg4c7cg97bdg9d10e41b3a8a"
msgid ""
"'A good soldier knows when he isn't the man for the job.' So sayeth Florrick."
msgstr "'좋은 병사는 자신이 못 할 일을 알아보는 법이다.' 플로릭이 한 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 61c58b07-51fc-f7e8-5398-6565b74fefb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_Manip_HasMet_HalsinBusyWithQuest(1) = True
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:61c58b07-51fc-f7e8-5398-6565b74fefb1
msgctxt "hc41152a9g3990g4b80g902bg5be9c5929e5d"
msgid "Don't let me hold you up. You've got a curse to clear."
msgstr "나는 신경 쓰지 마. 어서 저주를 풀어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 65e4b46f-3008-138d-1de4-ed6a9d2513d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:65e4b46f-3008-138d-1de4-ed6a9d2513d4
msgctxt "h753b4d3egfd9bg451cg93fegb2f529934712"
msgid "And yet - orders are orders."
msgstr "하지만 명령은 명령이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 70aa1e04-3e15-385f-384e-840bd18f7989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:70aa1e04-3e15-385f-384e-840bd18f7989
msgctxt "hf281be42g548bg4f53gba30gd6014f6cd51b"
msgid ""
"I'm not as hopeful as Florrick. For my money, we're better off strategising "
"without him."
msgstr "나는 플로릭만큼 낙천적이지 않아. 내 생각에는 그를 제외하고 전략을 짜는 게 더 나을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = 75f2eeb4-ccc0-1f15-1d69-2b40a553339f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:75f2eeb4-ccc0-1f15-1d69-2b40a553339f
msgctxt "h5030264fga2a5g4d84g8b84g1666dd731ca6"
msgid "It's not over yet."
msgstr "아직 끝나지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 79e098a5-fe10-a389-5571-5432fee436d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_Manip_HasMet_HalsinBusyWithQuest(1) = False
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_Manip_HasMet_HalsinBusyWithQuest(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:79e098a5-fe10-a389-5571-5432fee436d6
msgctxt "hac28fc53g014fg4cc3g8194ga209754f14e2"
msgid "Looks like you might actually finish what we couldn't. I'm impressed."
msgstr "우리가 해내지 못한 일을 네가 해낸 것 같네. 감명받았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = 7c496f77-d476-50e2-6e20-3cef2dd36399
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:7c496f77-d476-50e2-6e20-3cef2dd36399
msgctxt "h7d3e974fgd4f8g486bg903cg44e922c13131"
msgid "<i>Thank</i> you."
msgstr "<i>고마워</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = 87a6b13a-2504-0638-8503-b97e40b80580
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:87a6b13a-2504-0638-8503-b97e40b80580
msgctxt "h3a56d131gf30dg4f0dgb3a5g2ffa85b04635"
msgid "Doing your job, you mean."
msgstr "너희 일을 대신 해주려는 셈이라는 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = 9e3b6a0b-329b-34a9-d956-0baebccb967b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_Manip(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:9e3b6a0b-329b-34a9-d956-0baebccb967b
msgctxt "hc64b4938g9a65g4e5dgacd0gfd379593e8bd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = b7ac099c-8432-073f-aec2-a50213e9d59c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:b7ac099c-8432-073f-aec2-a50213e9d59c
msgctxt "h19217526gf07eg4fb5g8623gfb23faa8ef12"
msgid ""
"If you find us a way into the Towers, we'll be there, shield to shield. "
"Until then... we wait."
msgstr "네가 타워로 들어가는 방법을 찾아내면, 우린 방패를 맞대고 단결하여 너와 함께 할 거야. 그때까진... 기다려야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = bc7124f1-0c5d-92bf-0eb2-8f1a64fc57f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:bc7124f1-0c5d-92bf-0eb2-8f1a64fc57f6
msgctxt "h135c61cegcffdg430dgb65dg7f423f6c8908"
msgid "Heard you're working on a way in yourselves."
msgstr "너희도 나름대로 들어갈 방법을 찾고 있다고 들었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = c6b5b716-8579-b03f-9ae3-9694ba7af1ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:c6b5b716-8579-b03f-9ae3-9694ba7af1ef
msgctxt "h25802410g7f3cg49a4g93b1g326ebd7d7468"
msgid "I'm glad you're enjoying spectating."
msgstr "재밌는 구경해서 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = ca74cc19-230d-5b99-252e-cd004878f9dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:ca74cc19-230d-5b99-252e-cd004878f9dc
msgctxt "h64410c5dg0774g4c3cgbc57g25b5d04f8b76"
msgid "I answer to Florrick. And she's told me to stand guard."
msgstr "난 플로릭 님의 지시하에 행동한다. 그분이 경비를 서라고 하셨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = d167fd8b-db05-aa96-18b6-515385085d56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:d167fd8b-db05-aa96-18b6-515385085d56
msgctxt "hfd985071g1d73g4fafg8a64geb1c33c4c837"
msgid ""
"That's right - but I've heard this bedridden fellow might be able to help."
msgstr "맞아. 하지만 여기 누워만 있는 친구가 도움이 될지도 모른다고 하던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = d4763b2d-79d9-71e1-dc12-2bb9ad70e842
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:d4763b2d-79d9-71e1-dc12-2bb9ad70e842
msgctxt "h0d790f9bga0c0g486ega656g8a94983ad081"
msgid "That makes you our best bet. Hope it's a good one."
msgstr "그럼 네가 우리에게 있어서는 최선의 선택이야. 좋은 선택이었기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = d7d93179-4f73-0ec5-c8ca-d860390a10bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:d7d93179-4f73-0ec5-c8ca-d860390a10bf
msgctxt "hd2ee04e2gb49bg46e1g9cc8g7a73f8d3ab64"
msgid "You've got a long road ahead of you yet. I wish you luck."
msgstr "긴 여정이 기다리고 있을 거야. 행운을 빌게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Player
#. NodeID = db80d836-e906-2a6a-3a8e-f7446b7ccab5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:db80d836-e906-2a6a-3a8e-f7446b7ccab5
msgctxt "h9df8f5aag0d84g45fbg9d33gdbed20f08644"
msgid "You're welcome."
msgstr "천만에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = e6bc41d8-73c2-f86f-8386-91ba1eb72d44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:e6bc41d8-73c2-f86f-8386-91ba1eb72d44
msgctxt "he9c805b2g681bg4bd0gbc72g6ed0cd6b1e50"
msgid ""
"Not sure I'd call it that myself. This fellow's in no condition to help "
"anyone."
msgstr "찾고 있는 게 맞나 싶은데. 이 친구는 누구한테 도움을 줄 수 있는 상태가 아니거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip
#. Speaker = Manip Vidor
#. NodeID = f374d689-0b35-3b81-8610-39342f5efaa4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_SavingPrisoners_Manip:f374d689-0b35-3b81-8610-39342f5efaa4
msgctxt "hdad2752fge5abg4be2gb13dg8da0622ba679"
msgid ""
"With a single word, Florrick could charge the Coast's most powerful force "
"with taking back the Grand Duke."
msgstr "플로릭 자문관의 말 한마디면 대공을 되찾는데 소드코스트의 가장 강력한 세력을 동원할 수 있단 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_AD_Jahiera
#. Speaker = Jaheira
#. NodeID = 7664aab3-3a69-5c97-abe7-468c506d6cb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_AD_Jahiera:7664aab3-3a69-5c97-abe7-468c506d6cb0
msgctxt "h00f59055g465eg4e65g8585gd14b4533264d"
msgid "Hold the line at all costs - be the cliff that breaks the sea!"
msgstr "어떤 경우라도 전선을 사수해라. 파도를 깨트리는 절벽이 되어라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_AD_Jahiera
#. Speaker = Jaheira
#. NodeID = 7664aab3-3a69-5c97-abe7-468c506d6cb0
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_AD_Jahiera:7664aab3-3a69-5c97-abe7-468c506d6cb0
msgctxt "h9998f813g1a2eg4077g9d8dg6dd142329bf8"
msgid ""
"Stand together! Protect one another! Arm in arm, the oaks outlast the storm!"
msgstr "뭉쳐라! 서로를 지켜라! 참나무는 서로 맞잡은 채 폭풍을 견뎌낸다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_AD_Jahiera
#. Speaker = Jaheira
#. NodeID = 7664aab3-3a69-5c97-abe7-468c506d6cb0
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_AD_Jahiera:7664aab3-3a69-5c97-abe7-468c506d6cb0
msgctxt "hd8948e7ag1b59g4df5g8ac5gf7cc546c0b55"
msgid ""
"Strike like lightning! Roar like thunder! Wash over them with a blizzard's "
"fury!"
msgstr "번개처럼 쳐라! 천둥처럼 울부짖어라! 눈보라의 분노로 놈들을 쓰러트려라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 015d6f9d-0285-a302-e647-3ace980a3425
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:015d6f9d-0285-a302-e647-3ace980a3425
msgctxt "h2cc27717g55d1g4f8cg8b9eg4fa10f585e5b"
msgid "He didn't - I had no idea."
msgstr "안 그랬습니다. 전 아무 것도 몰랐어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 01c36035-8dc6-f177-5802-688b52e805eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_DefendedIsobel = False
#.      - HAV_TakingIsobel_State_SpyIsDefeated = True
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#.   Object:
#.      - HAV_Jaheira_Knows_WasWarned(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:01c36035-8dc6-f177-5802-688b52e805eb
msgctxt "h53789952g83f9g4873ga6c8gc777c017448f"
msgid ""
"Marcus was a True Soul. He said he was taking Isobel to Ketheric Thorm, but "
"he died in the attempt. One of his ghouls grabbed her instead."
msgstr "마커스가 참된 영혼이었습니다. 이소벨을 케서릭 쏨에게 데려가려다 죽었고, 이소벨은 마커스의 구울에게 잡혀갔어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 04b55f10-d86b-7d7e-6cb6-ce5e2237b75c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:04b55f10-d86b-7d7e-6cb6-ce5e2237b75c
msgctxt "hbc8f5851gdf8fg4a52g8a00g9a1b786f032d"
msgid "I see little more than a cowardly deception at play."
msgstr "비겁한 술책으로밖에는 안 보이는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 17484207-20b1-4a20-a4df-86bdc1ef325c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_IsobelGaveMission = False
#.      - HAV_Jaheira_State_MissionGiven = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:17484207-20b1-4a20-a4df-86bdc1ef325c
msgctxt "h532aab73g3444g4168gb75ag41615b4f9bc5"
msgid ""
"Listen closely, for there's very little time. Even if Last Light falls, you "
"must destroy the cult of the Absolute."
msgstr "시간이 없으니, 잘 들어. 최후의 빛이 스러지더라도, 너는 반드시 절대자 교단을 쓰러트려야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 174a0e15-2bcf-6806-8d43-a9b9e2fbda5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:174a0e15-2bcf-6806-8d43-a9b9e2fbda5a
msgctxt "h408d746bg28a8g4b58gb84bgb2a6f8f1e49c"
msgid ""
"As impossible as that task sounds, there must be a way to break the spell "
"that makes him invincible. There are secrets in this ancient waste, hidden "
"from..."
msgstr "불가능한 임무 같더라도, 그를 지키는 주문을 파괴할 방법이 분명 있을 거야. 이 황무지에는 숨겨진 비밀들이..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 19594595-82e8-d2ba-ac38-01863ccb7679
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:19594595-82e8-d2ba-ac38-01863ccb7679
msgctxt "hecfc7d7fg97f6g4656ga017g04ab51d7d505"
msgid "It's happening. They'll all be taken by the shadows."
msgstr "예상대로군. 모두 그림자에 먹히고 말거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 1e9a736c-0464-2a7d-aff3-ec4e414e90f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:1e9a736c-0464-2a7d-aff3-ec4e414e90f8
msgctxt "h2a9b11fbg2621g476fg93f1g7afa7e23ded8"
msgid "Even so, you <i>must</i> find him and you <i>must</i> kill him."
msgstr "그럼에도, 그를 <i>반드시</i> 찾아서 <i>반드시</i> 죽여야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 24377860-3e3b-a448-81e4-f03696e1b5bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:24377860-3e3b-a448-81e4-f03696e1b5bb
msgctxt "he895544fg12f7g47eeg8e11g85c1b49f4118"
msgid ""
"I don't see how she... Unless some cultist sneaked in, but gods, we'll be "
"overrun!"
msgstr "하지만 어떻게... 교단 놈들이 숨어 들어온 게 아니라면 말이지. 신이시여, 이제 그림자가 몰려올 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 2bda07af-128c-aa3d-fdce-499f5ab272a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:2bda07af-128c-aa3d-fdce-499f5ab272a9
msgctxt "hba04790eg3ee8g486agbda9gd78641e82c7b"
msgid "I suppose I have no choice but to believe you."
msgstr "너를 믿을 수 밖에 없는 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 3678f6c7-d9be-7cfc-e2d7-b272fcd7eef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:3678f6c7-d9be-7cfc-e2d7-b272fcd7eef0
msgctxt "h2e722a07g826dg4f97gbddcg3ea8fb81f8c0"
msgid "Liar! It was you who killed her."
msgstr "거짓말! 네가 이소벨을 죽였잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 38fca9f7-7b4e-d9ce-302d-bf7ad350ffb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:38fca9f7-7b4e-d9ce-302d-bf7ad350ffb0
msgctxt "h0f299549g6407g4185gb6d4g26c2ceaf4553"
msgid "Until then: to battle!"
msgstr "그 전까진... 전투 개시!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 3a9382a3-25f0-039b-9cd8-30ee9d50d37b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:3a9382a3-25f0-039b-9cd8-30ee9d50d37b
msgctxt "h7c3153a2g3462g4e14ga96cgbdb05c44ad82"
msgid "But hark! Something stirs..."
msgstr "잠깐! 뭔가 온다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Gale
#. NodeID = 3c852be6-f488-e2e9-e7d6-887a71091261
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Siege_State_CanBlameForIsobelMurder(11) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:3c852be6-f488-e2e9-e7d6-887a71091261
msgctxt "hb4f41d68ge5b6g4e18g8813g2b467eb3897e"
msgid "Behold, the consequences of your actions."
msgstr "보시라, 네 행동의 결과를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Wyll
#. NodeID = 42699c80-51bc-efe4-fa47-928311fce547
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Siege_State_CanBlameForIsobelMurder(10) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:42699c80-51bc-efe4-fa47-928311fce547
msgctxt "h00627fe2gb4f3g439dg9976ge97ec116b247"
msgid "Shit. This was your doing. <i>All of it.</i>"
msgstr "젠장. 이건 네 탓이야. <i>전부 다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 481bc649-ba6e-cf45-b86c-be1519ff3587
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:481bc649-ba6e-cf45-b86c-be1519ff3587
msgctxt "h49d89e74gba80g4486g8430g299c245c7ba7"
msgid "<i>A little spat.</i>"
msgstr "<i>말싸움을 좀 했어요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 4a882dc8-c9a3-6226-1db3-9d7a406f1b51
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:4a882dc8-c9a3-6226-1db3-9d7a406f1b51
msgctxt "h3de73dfcg481dg4642gae14g192a75a83eca"
msgid ""
"There's no time for this, Jaheira; without Isobel, the shadows will overrun "
"this place."
msgstr "자헤이라, 이럴 시간 없어요. 이소벨이 없어졌으니, 이제 그림자가 몰려올 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 4ab6699d-5429-befa-dbf5-2c232fafe5a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:4ab6699d-5429-befa-dbf5-2c232fafe5a0
msgctxt "h53dc56aag8d49g48e1g9666g111d871790f6"
msgid "You're right. There's no stopping it now."
msgstr "그래. 이젠 멈출 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 4c5922f1-bd2a-df7d-699c-020ed3fab5cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:4c5922f1-bd2a-df7d-699c-020ed3fab5cf
msgctxt "hee298a75gf38cg4c28g98fag32c8d35dc26b"
msgid "Isobel and I got into a little spat."
msgstr "이소벨하고 말싸움을 좀 했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 4d74ecf8-1f94-bec7-2058-be8c8ceb24df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:4d74ecf8-1f94-bec7-2058-be8c8ceb24df
msgctxt "h47927c46g0598g4a3ega96ag7470a3695e3d"
msgid "He did. I thought it'd be fun to see what he had planned for you."
msgstr "그랬죠. 마커스가 당신에게 무슨 짓을 하는지 봐도 재밌을 것 같더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 58123bf8-638e-0a5c-55a7-f4f3685c959f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:58123bf8-638e-0a5c-55a7-f4f3685c959f
msgctxt "h3dc84a9bg52aag4fb3g967cgb828f003e703"
msgid "In this moment, you are the greater threat."
msgstr "지금 당장은, 네가 더 큰 위협이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 629e4de5-5ccc-14a3-5a3e-323281c1ef9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:629e4de5-5ccc-14a3-5a3e-323281c1ef9a
msgctxt "h15adbc35g88c3g4623g9411gb9c03abd9d13"
msgid ""
"And you had no idea? After Marcus vouched for you at the gate, he didn't "
"confide in you?"
msgstr "그리고 넌 그걸 몰랐다고? 마커스가 문에서 네 편을 들어주고는, 너를 끌어들인 게 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Gale
#. NodeID = 6952ea79-4368-4114-8aa3-14c8a45ec4a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Siege_State_CanBlameForIsobelMurder(11) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:6952ea79-4368-4114-8aa3-14c8a45ec4a4
msgctxt "hca2cf388g1a59g4eafg9a54g42835168dc66"
msgid "Behold, the consequences of your actions."
msgstr "보시라, 네 행동의 결과를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 71416f79-46d7-4dc5-b0fb-80d3dd073f62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:71416f79-46d7-4dc5-b0fb-80d3dd073f62
msgctxt "ha0f13a00gb308g4666gafc1gf3c86d8e09a7"
msgid ""
"I can't believe I didn't see you for what you are. A <i>murderer</i>. You "
"killed her, and in doing so you've spelled our doom."
msgstr ""
"네 정체를 알아보지 못했다니 믿을 수 없군. <i>살인자 자식</i>. 네가 이소벨을 죽이고, 동시에게 우리에게 파멸을 가져왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 732f3b72-b5b7-4c7b-a665-88e9b93af5e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:732f3b72-b5b7-4c7b-a665-88e9b93af5e6
msgctxt "hc5814d18g296eg4c85gb572g3c637d23f64d"
msgid "The Absolute's forces happened. Now we know what we're up against."
msgstr "절대자의 군대가 왔다 갔습니다. 이제 적이 어떤 존재인지 알게 되었군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 73d40a6d-b5ea-62ad-8876-741322dee00c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:73d40a6d-b5ea-62ad-8876-741322dee00c
msgctxt "h20705233g7706g48ecg8541gb22d43784146"
msgid "Gods spare us. Ketheric was planning our demise all along."
msgstr "신들이시여, 도우소서. 케서릭이 우리를 끝장낼 계획을 세우고 있었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 8088b9d1-94e5-b183-3ab2-8be0b840ecfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Siege_Intro_JaheiraAggroToPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:8088b9d1-94e5-b183-3ab2-8be0b840ecfd
msgctxt "h3dac1c6egb990g4ff9g9b8fg73d6b9dcadff"
msgid ""
"For a little while longer, you and I are destined to fight side by side, but "
"if the shades don't take you, I have the next claim on your head."
msgstr "우리는 잠깐 더 같은 편에서 싸울 운명인가보군. 하지만 그림자가 너를 데려가지 않는다면, 그땐 내가 네 머리를 가져가겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 83720821-dd47-21db-98b0-ecc5e95cfca2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:83720821-dd47-21db-98b0-ecc5e95cfca2
msgctxt "h29a6e2f1gba2dg46bbgbaddg4f1b3ecff5d9"
msgid "There's no time for this. We have a shadow curse to deal with."
msgstr "이럴 시간이 없습니다. 그림자 저주를 상대해야 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 84006c3a-0eff-0f7f-928b-3ec56e567eae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:84006c3a-0eff-0f7f-928b-3ec56e567eae
msgctxt "h6513f865gc40ag41c1g9756g588004a7c535"
msgid ""
"You wretch! To think you had my trust. If this be my last act, let it be in "
"service of strangling the life out of you."
msgstr "개 같은 놈! 내가 널 믿었다니. 여기서 죽더라도, 네 삶을 끝내놓고 죽겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 883531f4-63d4-525f-94ce-843e73d1674b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:883531f4-63d4-525f-94ce-843e73d1674b
msgctxt "h1fcbe4a7g2940g4178gbb7dgefea168d6795"
msgid ""
"Listen closely, for there's very little time. Even if Last Light falls, your "
"mission does not change: you must find Ketheric Thorm and you must kill him."
msgstr "시간이 없으니, 잘 들어. 최후의 빛이 스러지더라도, 네 임무는 그대로다. 케서릭 쏨을 찾아, 죽여야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 88d81889-664e-1d24-071f-232862cda010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:88d81889-664e-1d24-071f-232862cda010
msgctxt "h34fed322g5b8dg4139g9e9bgb0e54f4148b0"
msgid "Liar. Filthy liar."
msgstr "거짓말. 더러운 거짓말쟁이 놈."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 8908399e-a540-537d-4cd6-d6f7cabb2eb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:8908399e-a540-537d-4cd6-d6f7cabb2eb5
msgctxt "h640d8dfdgb1e0g4e61ga45ega652cfdb6c10"
msgid "Steel your hearts and steady your hands. To battle!"
msgstr "마음을 가다듬고 양손에 힘을 모으는 거다. 전투 개시!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Wyll
#. NodeID = 8ba289ca-27fb-43b4-b03b-645f69bb2485
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Siege_State_CanBlameForIsobelMurder(10) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:8ba289ca-27fb-43b4-b03b-645f69bb2485
msgctxt "h9cfd8e68g390fg4e3bgbdf5g971079ff890d"
msgid "Shit. This was your doing. <i>All of it.</i>"
msgstr "젠장. 이건 네 탓이야. <i>전부 다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Karlach
#. NodeID = 9223d5fc-654e-6ba4-7480-e2c2fcc25bfe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Siege_State_CanBlameForIsobelMurder(9) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:9223d5fc-654e-6ba4-7480-e2c2fcc25bfe
msgctxt "hce6cffe7gae49g4641g8d78gf7bdd7a7021b"
msgid "What were you thinking?! What are we <i>doing </i>here?"
msgstr "무슨 생각을 한 거야?! 우리가 여기서 <i>뭘 </i> 하는 거냐고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 92b2cbb6-7b44-0fab-ae1c-ca870bf8c9cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:92b2cbb6-7b44-0fab-ae1c-ca870bf8c9cb
msgctxt "h9eec02b2g4770g4742ga763g224d8b49fe5c"
msgid "He did, but I decided to handle him myself."
msgstr "그러려 했지요. 전 대신 마커스를 직접 처리하려 했고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 94565ec6-ad8a-7f7e-834e-01c744d3c600
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:94565ec6-ad8a-7f7e-834e-01c744d3c600
msgctxt "hc670c13cg6c5bg4a8ega2e2g0c109b75ee16"
msgid "Blackguard! You're viler than the worm that's consuming you."
msgstr "망할 놈! 너는 네 머릿속 벌레보다도 더러운 놈이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = 945b9cea-c0a6-5fef-82c8-45a042d7c9a8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:945b9cea-c0a6-5fef-82c8-45a042d7c9a8
msgctxt "h90d314fbg1b45g488eg9a9dg3529872fb00e"
msgid "It looks like one of our enemies got hold of her."
msgstr "우리의 적 중 하나가 그녀를 잡아간 것 같습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = 970542a4-814e-4589-ba0f-36b652472afc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:970542a4-814e-4589-ba0f-36b652472afc
msgctxt "h713b9cbeg188eg40e2g8643g349882cf8a09"
msgid ""
"It's happening. They'll all be taken by the shadows. Only by the grace of "
"Isobel's spell will we be spared the same fate."
msgstr "예상대로군. 모두 그림자에 먹히고 말거야. 이소벨의 주문이 아니었다면 우리도 같은 운명을 맞이했겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = a4241de0-2b9e-93ce-2582-a64f9ed4a816
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:a4241de0-2b9e-93ce-2582-a64f9ed4a816
msgctxt "h8f07a251g6a15g42bdgb30fg9c3f5ac71c94"
msgid "She was my sacrifice. It was a delight."
msgstr "이소벨을 내 제물로 삼았죠. 진미더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = b6da81b4-f7f8-cf31-d4a7-b75b23ca5414
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Siege_Intro_JaheiraAggroToPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:b6da81b4-f7f8-cf31-d4a7-b75b23ca5414
msgctxt "h66030a78g6850g4785g8beag392d39e9f399"
msgid "Harpers! We must cleanse..."
msgstr "하퍼즈! 우리는 반드시 정화해야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = b79d16b0-729d-ee94-2682-d56c401487a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:b79d16b0-729d-ee94-2682-d56c401487a1
msgctxt "ha887726dg033eg4858ga89bgd35fe2754df1"
msgid "Isobel! No! What in the Nine Hells happened?"
msgstr "이소벨! 안돼! 아홉 지옥이여, 무슨 일이 일어난 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = c15c327c-8c7e-9d5b-426e-fd922c8f07fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:c15c327c-8c7e-9d5b-426e-fd922c8f07fd
msgctxt "hf85ef383g62acg4278g9e18gc907b6bda288"
msgid ""
"Their leader is a man called Ketheric Thorm. He resides in Moonrise Towers, "
"and we've found him to be impervious to the blade, and to magic to boot."
msgstr "교단의 지도자는 케서릭 쏨이라는 사람이다. 문라이즈 타워에 머물고, 칼날도 마법도 그에게는 소용이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Karlach
#. NodeID = c199780e-17f1-451c-a28d-38cfba38f1e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Siege_State_CanBlameForIsobelMurder(9) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:c199780e-17f1-451c-a28d-38cfba38f1e9
msgctxt "h77a041c0g7ccdg49a8g8727g20f7e8bbc762"
msgid "What were you thinking?! What are we <i>doing </i>here?"
msgstr "무슨 생각을 한 거야?! 우리가 여기서 <i>뭘 </i> 하는 거냐고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = c379f2fe-f9a7-35a0-ec3a-d541669c4f71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:c379f2fe-f9a7-35a0-ec3a-d541669c4f71
msgctxt "h4f5f3346ge0c5g46f6gba41g828b9addda81"
msgid ""
"You don't get to decide. Not here. Not while I'm responsible for the lives "
"of the people at this inn."
msgstr "결정은 네가 내리는 게 아니야. 여기선 안돼. 이 여관 사람들의 생명에 대한 책임이 나에게 있는 한은, 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = cb3388be-b5a9-d7c7-3329-2ebd8386b92f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Siege_Intro_JaheiraAggroToPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:cb3388be-b5a9-d7c7-3329-2ebd8386b92f
msgctxt "h372beaa7g9ad0g4920g9f4ag07a8694daaee"
msgid ""
"Do you understand what you've done? Without Isobel, everyone in this inn is "
"as good as dead!"
msgstr "무슨 짓을 한 건지 이해는 해? 이소벨이 없으면, 이 여관의 사람들은 전부 죽은 거나 다름 없어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = cd501c4c-e7ab-4cf0-ac4e-0595009744ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_General_State_IsHostileToPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:cd501c4c-e7ab-4cf0-ac4e-0595009744ca
msgctxt "h852739e8g8a5bg409ag95bage30dfb0b8466"
msgid "So it begins. So it will end."
msgstr "이렇게 시작되는군. 이렇게 끝나겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = cd5c1e43-c439-b93e-1264-5d0b9547545a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:cd5c1e43-c439-b93e-1264-5d0b9547545a
msgctxt "h7e196654gdc5dg4fd1g991bgb98fb38be240"
msgid ""
"I gave you my trust too easily, but with the same ease I swear I'll strike "
"you down."
msgstr "너를 너무 쉽게 믿었군. 하지만 똑같이 쉽게 너를 쓰러트려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = d1c2b81a-99d5-797b-0652-096d5af7d6bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:d1c2b81a-99d5-797b-0652-096d5af7d6bc
msgctxt "hf4c836fag3ec7g4a40ga3c9g0847fdc53f99"
msgid ""
"I helped Marcus kidnap Isobel. And now I'm going to watch the shadows "
"consume you."
msgstr "마커스가 이소벨을 납치하는 걸 도와줬습니다. 이젠 여러분이 그림자에 먹히는 걸 감상하려고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = d409d060-c019-feef-3dae-c248b1119426
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:d409d060-c019-feef-3dae-c248b1119426
msgctxt "h8282c221gb91ag4795g94c7g87734ae563e4"
msgid "It looks like some kind of terrible accident."
msgstr "끔찍한 사고가 있었던 것 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = eadec235-5c26-0326-bfe9-b34feb942f42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:eadec235-5c26-0326-bfe9-b34feb942f42
msgctxt "h5c7635dcg51e1g4153gbdc9g1cffd7e9192f"
msgid "Isobel is gone. Soon the shadows will wash us all away."
msgstr "이소벨이 사라졌어. 곧 그림자가 우리를 쓸어내겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = eb3f1828-030c-484d-b4b6-f3f70048756b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_DefendedIsobel = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:eb3f1828-030c-484d-b4b6-f3f70048756b
msgctxt "hebb0f150gd66cg4e2ag890ag595e9e175330"
msgid "Marcus was a True Soul. He said he was taking Isobel to Ketheric Thorm."
msgstr "마커스가 참된 영혼이었습니다. 이소벨을 케서릭 쏨에게 데려간다더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = f2c604a8-e1bc-cf3f-5024-6df1eea1e37e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:f2c604a8-e1bc-cf3f-5024-6df1eea1e37e
msgctxt "h7fbf86e4g9dddg4c89g9cd4gef09d8e1a326"
msgid "I trusted you. Silvanus forgive me, I let you in."
msgstr "널 믿었는데. 실바누스여, 이 놈을 들여놓은 것을 용서하소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = f5193dc9-0c72-5c56-042f-5c455d08d655
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Siege_Intro_JaheiraAggroToPlayer = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:f5193dc9-0c72-5c56-042f-5c455d08d655
msgctxt "h40cf171cgb298g4689g9f3eg951a9ebfa5f3"
msgid ""
"We cannot hesitate. Not even for those we knew - those we cared for. They're "
"no longer who they were."
msgstr "머뭇거릴 틈이 없어. 한때 아는 사람이었더라도, 우리가 아끼는 이들이었더라도. 이젠 우리가 알던 이들이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Player
#. NodeID = fa376a78-3ddd-bdf0-d28b-5a0dd90d4fa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:fa376a78-3ddd-bdf0-d28b-5a0dd90d4fa1
msgctxt "hd101466fg7ef8g4ba1gadd9g2d9f9ed01d8b"
msgid "I was curious to see what you would do without her."
msgstr "이소벨이 없어지면 어떻게 하실까 궁금해서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro
#. Speaker = Jaheira
#. NodeID = fff58ceb-4880-406d-839c-9bdacd429380
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Intro:fff58ceb-4880-406d-839c-9bdacd429380
msgctxt "h4a5bc01agebfdg4a7ag93eag7a4f4611428e"
msgid "Isobel. <i>No! </i>What in the Nine Hells happened?!"
msgstr "이소벨. <i>안돼! </i> 아홉 지옥이여, 무슨 일이 일어난 거야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 007f22fb-1a2a-e8b9-a378-6e503a17f2f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:007f22fb-1a2a-e8b9-a378-6e503a17f2f3
msgctxt "h797af654gf367g4611g82d6g05712bf75d1e"
msgid ""
"You'll be happy to hear <i>my</i> mission was a success. I came to kidnap "
"Isobel, and so I did."
msgstr "좋은 소식이 있어, <i>내</i> 임무는 성공했거든. 난 이소벨을 납치하러 왔고 성공 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 01ed8ed6-58d4-33ae-d163-3d9d4c5d900c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 76360adc-4d04-946a-e7a3-5509f17b5913_RevealedDarkUrge = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:01ed8ed6-58d4-33ae-d163-3d9d4c5d900c
msgctxt "h30b37397gcd1dg40c5gb340g966aa453409c"
msgid ""
"No. To let you live would be beyond cowardice. You sowed these many dead - "
"now I will do the reaping."
msgstr ""
"아니. 널 살려서 보내면 겁쟁이라는 소리를 듣는 것으로 끝나지 않을 거야. 이렇게 많은 죽음이 네 손에서 기인하였으니, 이제 그 대가를 "
"치러야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 1326346f-638d-4b9e-4d94-2e8927fbdfca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:1326346f-638d-4b9e-4d94-2e8927fbdfca
msgctxt "h095c01dag51c9g4d6dg91a2g188b77a2eaec"
msgid "As long as there was light... But no longer."
msgstr "빛이 남아있었더라면... 하지만 더 이상 빛은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 1a640a91-bdc3-3ccf-0158-e5c4c274a542
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:1a640a91-bdc3-3ccf-0158-e5c4c274a542
msgctxt "h1bdfc347gf6b6g4f55ga5b7g4d51a1576c21"
msgid "Then by all means I'm a fool. But I'm not giving up."
msgstr "그렇다면 난 만용을 부리는 바보겠죠. 하지만 포기하지 않겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 1b8753eb-fb1d-4944-8c3a-fe1663e9bc96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:1b8753eb-fb1d-4944-8c3a-fe1663e9bc96
msgctxt "h17b4247egdc35g4f08gb983g2e580495f062"
msgid ""
"Perhaps it's right that you're not. You're twice blessed after all: by "
"Isobel and by your artefact. But as for myself, I don't see another option "
"than to make a desperate dash back to Baldur's Gate."
msgstr ""
"어쩌면 너는 포기하지 않는 것이 옳을지도. 너는 이소벨과 아티팩트를 통해 두 번이나 축복을 받았잖아. 하지만 나에게는, 필사적으로 발더스 "
"게이트를 향해 도망가는 길 밖에 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 1f83568f-e677-15b9-bb40-0193ba78c5f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:1f83568f-e677-15b9-bb40-0193ba78c5f8
msgctxt "h602ded6bgbdb4g4daag8914g52aa4d16300d"
msgid "Get a grip. This isn't over yet."
msgstr "정신 추스리십시오. 아직 끝나지 않았습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 23e101c5-be38-20d8-00e4-6ae697c8a364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:23e101c5-be38-20d8-00e4-6ae697c8a364
msgctxt "h0cecb1f6g3f98g459ag8b60ga7703b1b2f3b"
msgid "It's all over. They're all gone. My brave ones, my friends, my Harpers."
msgstr "다 끝났어. 모두 죽어버렸어. 나의 용맹한 이들, 친구들, 하퍼들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 23e7a934-a0a7-8fed-b942-8ed3be58b98f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:23e7a934-a0a7-8fed-b942-8ed3be58b98f
msgctxt "h95dc48c8g0d0ag41c1gac06g2f874362c77b"
msgid ""
"After such carnage you'd persist? Sometimes there's folly in such courage."
msgstr "이런 학살이 일어난 뒤에도 맞서겠다고? 만용이라는 게 있는 법이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 32113e64-5b82-58c1-ec7b-f4e9cad69e3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:32113e64-5b82-58c1-ec7b-f4e9cad69e3e
msgctxt "h82458a74gb065g4af6g8854g393d01057f31"
msgid "So where do we go from here?"
msgstr "그럼 이제 어디로 가죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 332c2a41-0003-0424-3153-dacbc74d0d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:332c2a41-0003-0424-3153-dacbc74d0d82
msgctxt "h7c3701a5g2c16g4228ga383ge5d714b00106"
msgid ""
"Yes. I adorn the crown of the Oak Father still, and as long as I do, there's "
"an ever so slim chance I could make it back to Baldur's Gate."
msgstr ""
"그래. 나는 여전히 참나무 아버지의 은총을 입고 있고, 이것과 함께하는 한 발더스 게이트에 도착할 가능성이 희박하게나마 있을지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 37beb269-742f-dff3-19ec-1c350b440c75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:37beb269-742f-dff3-19ec-1c350b440c75
msgctxt "hd24d8b65g1f69g45fegbf97g1ce29e90a8e0"
msgid ""
"Frankly I don't see another option than to make a desperate dash back to "
"Baldur's Gate."
msgstr "솔직히 발더스 게이트로 처절한 후퇴를 하는 것 말고는 다른 선택지가 떠오르지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 3e634d11-a4be-5998-e824-3f41139cb1cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 76360adc-4d04-946a-e7a3-5509f17b5913_RevealedDarkUrge = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:3e634d11-a4be-5998-e824-3f41139cb1cd
msgctxt "h2e23df93gae2eg4192g8149g043d9b03f89f"
msgid ""
"No. To let you live would be beyond cowardice. You sowed these many dead "
"indeed, but now I will do the reaping."
msgstr "아니. 난 널 살려서 보낼 만큼 한심한 겁쟁이가 아니야. 네가 이 많은 죽음의 씨앗을 뿌렸으니, 이제 내가 거둬드려야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 406a2a1e-dc14-ead8-a784-2e9339c049ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:406a2a1e-dc14-ead8-a784-2e9339c049ab
msgctxt "hc44e6086g674dg4ea2g8b3bgd59a0c695388"
msgid "No, Jaheira. You mistake your own fate for mine."
msgstr "틀렸어, 자헤이라. 네 운명을 내 것과 혼동하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 489484f0-247c-f76b-0836-d9ecda41f581
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:489484f0-247c-f76b-0836-d9ecda41f581
msgctxt "hca2064f7ga44ag42fega790ge7b8cf1190f6"
msgid ""
"I am fangs and teeth. I am bloodlust made flesh. You wouldn't understand."
msgstr "나는 송곳니이며 이빨이다. 피에 대한 욕망이 실체화 된 것이지. 너는 이해하지 못 할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 6af08fb2-fd86-0c2b-b936-228eae24c1ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_DarkUrge_State_KilledIsobel(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Local:
#.     - 76360adc-4d04-946a-e7a3-5509f17b5913_RevealedDarkUrge = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:6af08fb2-fd86-0c2b-b936-228eae24c1ca
msgctxt "hbbb16527gc347g4c9cgbc78g14c6c34bd230"
msgid ""
"To this glorious soil of carnage! Isobel I ripped, and now look at what I "
"reaped!"
msgstr "이 학살의 땅에 영광을! 이소벨의 목숨을 내가 거두었고, 이제 내가 무엇을 거두었는지 보아라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 6c8a4e41-b3fc-cab5-86f1-f7da9fe8e91a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Siege_State_RefusedJaheira = True
#.     - HAV_Siege_Intro_JaheiraAggroToPlayer = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:6c8a4e41-b3fc-cab5-86f1-f7da9fe8e91a
msgctxt "hff13fe83ga7d2g4ddfg8918g2595f3bc7f03"
msgid ""
"Whether the worm in your skull overwhelms you or not, your end will be a "
"vile one."
msgstr "네 머릿속 벌레가 널 압도하던 아니던, 네 최후는 끔찍할 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 726d7c2e-d4da-fe5f-b120-049ced5de923
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:726d7c2e-d4da-fe5f-b120-049ced5de923
msgctxt "hdc6456d3g7008g491cg9c39ga419f3b19f91"
msgid ""
"Chances are slim I'd survive the journey back, but if I can warn the dukes "
"an army of Absolutists is on the march, perhaps the city still stands a "
"fighting chance."
msgstr ""
"내가 살아남을 가능성은 희박하지만, 공작들에게 절대자의 군대가 진격해오고 있다는 걸 알릴 수만 있다면, 발더스 게이트는 아직 싸울 기회가 "
"있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 7dde20d6-b55a-bbaa-7994-a61b711de1b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:7dde20d6-b55a-bbaa-7994-a61b711de1b8
msgctxt "haf5952d6ga9c3g4d9ag9dd8ga7245124b879"
msgid ""
"That proud determination of yours should shame me, but it heartens me "
"instead. Pull aside the curtain of years and I can see myself echoing your "
"resolve."
msgstr ""
"너의 결의 넘치는 모습은 나를 부끄럽게 하기보다 오히려 나를 아프게 하는군. 오랜 세월이 흐르기 전, 너와 같은 결의를 가졌던 나를 "
"떠올리게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 7f861ad5-bd2c-d655-ee81-04181525c14d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:7f861ad5-bd2c-d655-ee81-04181525c14d
msgctxt "h57967386g5acfg4cceg8b7fg0f3f821afe72"
msgid "More leaves than one. You're still alive as well."
msgstr "마지막 잎새가 아니야. 너도 살아있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = 849cd98a-11f6-afdc-7503-d3aaeaff1706
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:849cd98a-11f6-afdc-7503-d3aaeaff1706
msgctxt "hc0b7ea1fg2189g476dgb4fbg696589c2eab6"
msgid "You're weak; exhausted. Walk away while you still can."
msgstr "넌 지쳤고 약해졌어. 할 수 있을 때 떠나라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 8b8e6876-c484-bfea-535b-0bd73d627e1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:8b8e6876-c484-bfea-535b-0bd73d627e1b
msgctxt "h6c0504d6g80b5g45efga8d4gcb703871c081"
msgid ""
"But you live. A single green leaf holding fast on a tree ravaged by winter."
msgstr "하지만 넌 살았지. 황폐해진 겨울나무에 꿋꿋이 버티고 있는 마지막 잎새와 같이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 96ca1999-4743-f64c-7c27-4e58cb68d31c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Jaheira_Event_GoToCamp(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:96ca1999-4743-f64c-7c27-4e58cb68d31c
msgctxt "h23eabb7dg10c6g43e3g9799g335046919198"
msgid ""
"Very well, I'll join you, and when Ketheric falls, I'll be there - for us, "
"for them, and for the ones we love back home."
msgstr ""
"좋아, 너와 함께 할께 그리고 케서릭이 쓰러질 때 나도 그 자리에 있겠어. 우리를 위해, 이 사람들을 위해, 그리고 고향에서 우리가 "
"사랑한 자들을 위해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 982517d4-fbc9-ad0e-30b0-4149334b4d11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:982517d4-fbc9-ad0e-30b0-4149334b4d11
msgctxt "hf9e3345fg7a7bg481bga4b0g52743d2c65c7"
msgid ""
"You... It was you after all? All along... How could I have missed such "
"madness?"
msgstr "너... 결국 너였어? 그동안... 내가 어떻게 이런 광기를 놓치고 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 9ad758fb-053e-631e-dd58-273dd6b046c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:9ad758fb-053e-631e-dd58-273dd6b046c8
msgctxt "hdf64b65fg94d2g4a20gb300g230ee86a72c4"
msgid "These many dead are yours. You will lie and rot among them."
msgstr "이 수많은 죽음은 너의 책임이야. 너도 그들과 함께 누워 썩게 해주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = 9b6ff323-2233-d960-d04c-27bdbf5c8dab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:9b6ff323-2233-d960-d04c-27bdbf5c8dab
msgctxt "h018e801fgc6b8g4997g898cg6dec5211e607"
msgid ""
"I'm tempted to take your word for it. You're twice blessed after all: by "
"Isobel and by your artefact. But as for myself, I don't see another option "
"than to make a desperate dash back to Baldur's Gate."
msgstr ""
"말은 참 잘하는군. 너는 이소벨과 아티팩트를 통해 두 번이나 축복을 받았잖아. 하지만 나에게는, 필사적으로 발더스 게이트를 향해 도망가는 "
"길 밖에 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = a3589df2-39f9-af16-0b29-e93f932a19f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:a3589df2-39f9-af16-0b29-e93f932a19f9
msgctxt "hfae3a78cg6407g45dbga9f1g54777d388de2"
msgid "You will lie and rot among them."
msgstr "너도 저들과 함께 누워 <b>썩게 해주지</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = a3ac2692-cc0a-19c1-6c88-6afceb7903f0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:a3ac2692-cc0a-19c1-6c88-6afceb7903f0
msgctxt "h16780347g4350g4904gafa5g355d5978b53a"
msgid "You bluff, I call. Let's see who has the upper hand."
msgstr "허세를 부리는군. 누가 우위인지 가려보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = a7ad2ca1-5033-df35-2314-2b9b5dd89160
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:a7ad2ca1-5033-df35-2314-2b9b5dd89160
msgctxt "h2f6888f5g8a48g4bf5g897dgeb198a1f7f9e"
msgid ""
"Your blood is beyond hope of redemption. May it water these accursed grounds "
"and grow the sickly roses that will mark your grave."
msgstr "네 피는 구제 받을 희망조차 없구나. 네 피가 이 저주 받은 땅을 적시고 네 무덤에 창백한 장미를 피우리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = b7eb3d99-d9ee-7540-31ea-4951580510d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_DarkUrge_State_KilledIsobel(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Local:
#.     - 76360adc-4d04-946a-e7a3-5509f17b5913_RevealedDarkUrge = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:b7eb3d99-d9ee-7540-31ea-4951580510d9
msgctxt "hb55b0c0eg8d66g4b49g8896g0fddf68bd02e"
msgid "I had to kill her... something compelled me from within."
msgstr "이소벨을 죽일 수밖에 없었어... 내 안에 있는 무엇인가가 나를 억지로 이끌었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = bb0b1e9d-ceb8-3466-fb8e-5798d3a1b9a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:bb0b1e9d-ceb8-3466-fb8e-5798d3a1b9a5
msgctxt "h2c5fd726g809cg4dc1g92c5g151123863c12"
msgid ""
"It is abominable that you still live - you who has cost us so much. The "
"murderer of light."
msgstr "우리에게 그런 짓을 해놓고도 살아있다니 가증스럽기 그지없군. 빛의 살인자여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = bb56ed96-c727-764b-d2fc-c28601f37353
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:bb56ed96-c727-764b-d2fc-c28601f37353
msgctxt "hd349ba63g267bg4f53g825dga867f958a938"
msgid "I am the damn light. Nothing can extinguish me."
msgstr "내가 그 망할 빛이다. 무엇도 날 꺼트릴 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = c149ad03-b226-1ef1-b00e-d4e40b2257b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:c149ad03-b226-1ef1-b00e-d4e40b2257b4
msgctxt "h4ddea2bfg7b4fg4133g8cd9g2832b5d2733e"
msgid ""
"There's no way forward, only the almost hopeless retreat back to Baldur's "
"Gate."
msgstr "나아갈 길은 없어, 발더스 게이트로 향하는 절망적인 퇴로만 있을 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = c2e473af-d0c6-5ee7-7dbe-51808747d29b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:c2e473af-d0c6-5ee7-7dbe-51808747d29b
msgctxt "h5da69e7dgfe75g439bgaa88g0e723c887260"
msgid "You were doomed to fail from the start. This was bound to happen."
msgstr "처음부터 예견된 실패입니다. 어쩔 수 없는 일이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = c843671f-553f-d9f4-fd1c-9a039b31b4c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:c843671f-553f-d9f4-fd1c-9a039b31b4c9
msgctxt "hefdd72c5g69b3g4784gad62g6b897dd105e8"
msgid "I'm truly sorry for your loss."
msgstr "진심으로 유감입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = c8e36f8a-c846-3b35-f793-06e41566bcf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:c8e36f8a-c846-3b35-f793-06e41566bcf2
msgctxt "h1d501ae0gf638g4893g8a9eg248bdd867151"
msgid ""
"Thank you, truly. May you succeed where I have failed. You are the stuff of "
"legends now. Pray that I live to tell your tale."
msgstr ""
"고마워, 진심으로. 나는 실패했지만 너는 꼭 성공 할 수 있을 거야. 너는 이제 전설의 주인공이잖아. 내가 살아서 너의 이야기를 전할 수 "
"있길 기도할 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = cac309b9-d5b1-141f-7c0c-5ac1706c3e30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:cac309b9-d5b1-141f-7c0c-5ac1706c3e30
msgctxt "h09458fe0gbb28g495cga903gfba0e22a89f2"
msgid ""
"These dead need not be buried. Beneath this canopy of darkness, all is one "
"yard of restless graves."
msgstr "시체를 묻을 필요 없다. 이 어둠의 장막 아래가 곧 안식 없는 묘지 그 자체니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = e6518738-971f-a5ca-53c9-5774bf163477
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Siege_State_RefusedJaheira = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:e6518738-971f-a5ca-53c9-5774bf163477
msgctxt "h436d777dg437fg42e4g84bcg71c4c8f6a636"
msgid "In that case, good luck and godsspeed."
msgstr "그렇다면, 행운과 신의 가호가 함께하길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = ea08bded-5f61-1114-1f9f-401d5509025e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:ea08bded-5f61-1114-1f9f-401d5509025e
msgctxt "hb5c431c6ga6adg4fd7gb32dgb96596170051"
msgid ""
"If I can warn the dukes an army of Absolutists is on the march, perhaps the "
"city still stands a fighting chance."
msgstr "공작들에게 절대자의 군대가 진격해오고 있다는 걸 알릴 수만 있다면, 발더스 게이트는 아직 싸울 기회가 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = f08b92a7-9b27-a42d-dad1-a4f06b1bba50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:f08b92a7-9b27-a42d-dad1-a4f06b1bba50
msgctxt "h1465280dge8bag4da0g9a65gc2035d88e61b"
msgid ""
"Oh, but I do. I travelled with one such as you once. I didn't see it at "
"first, but I do now: the galaxy of malice in your eyes."
msgstr ""
"아, 안타깝게도 잘 알고 있지. 이전에 너와 같은 놈과 여행해 본 적이 있거든. 처음엔 알아보지 못했지만 이젠 알아, 악의로 가득 찬 네 "
"눈빛을 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = f6d494bc-42f4-8977-8fb8-811e5e39384d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:f6d494bc-42f4-8977-8fb8-811e5e39384d
msgctxt "hd8b252d5g87f3g4b38g9070g52a2bab36acb"
msgid "I led them here - to this."
msgstr "내가 그들을 이 곳으로...죽음으로 이끌었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = f6dec2f8-a361-b949-9f32-9b7b1fea0374
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:f6dec2f8-a361-b949-9f32-9b7b1fea0374
msgctxt "h5abf0be2g5620g4fb8g8032g2d0063a401d7"
msgid ""
"I should end you, but my strength fails me. Perhaps I can outrun the shadows "
"- even as I pray they will creep into the very marrow of your bones."
msgstr ""
"널 끝장내야 하지만, 나의 힘이 날 저버리는구나. 아직은 그림자로부터 달아날 수 있을 것 같군. 그동안 네 골수까지 그림자가 파고들길 "
"기도하면서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = f77a888d-82b3-c738-323a-5f7d51b169ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:f77a888d-82b3-c738-323a-5f7d51b169ef
msgctxt "h6ec3c5fdg71c6g43d4ga98dg50eee930f1d7"
msgid ""
"We can weep and moan our hearts out later. Right now, we need to get out of "
"here."
msgstr "나중에 얼마든지 목놓아 울 수 있습니다. 지금은 여기서 벗어나야 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Player
#. NodeID = fbc91628-1fce-a06e-e118-cd02958f0320
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:fbc91628-1fce-a06e-e118-cd02958f0320
msgctxt "hb6989781g2152g468eg94e0g729198306c2c"
msgid ""
"The fight is here, with Ketheric. Join my camp and when the time comes we'll "
"face him together."
msgstr "케서릭과의 전투가 얼마 안 남았습니다. 내 야영지에 합류하세요. 그리고 때가 되면 케서릭과 함께 싸웁시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro
#. Speaker = Jaheira
#. NodeID = ffe45eed-8d7a-9c9a-4426-88685922cf0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_Outro:ffe45eed-8d7a-9c9a-4426-88685922cf0e
msgctxt "h710590aeg6899g4fc1g98c5g9b1af74057af"
msgid "Farewell."
msgstr "잘가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared
#. Speaker = Player
#. NodeID = 11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared:11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
msgctxt "h2736bff4g32ebg42beg9390g7d8446956409"
msgid "<i>Really?</i> I swear..."
msgstr "<i>말이 돼?</i> 맹세컨대 저런 건..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared
#. Speaker = Player
#. NodeID = 11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared:11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
msgctxt "h999e11e9g6de6g4b66g91a1gbc16f643b613"
msgid "Gods - that is <i>not</i> a pretty sight."
msgstr "신이시여, 아름다운 광경은 <i>아니군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared
#. Speaker = Player
#. NodeID = 11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared:11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
msgctxt "h0ac1da2egde95g4066g8890g2c7a509052c0"
msgid "What. The. Fuck."
msgstr "이게. 뭐야. 씨발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared
#. Speaker = Player
#. NodeID = 11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared:11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
msgctxt "h6a8232d2g0c72g4dcaga7aag4800833b87ed"
msgid "<i>Tsk'va</i> - the darkness takes form!"
msgstr "<i>츠크바</i>, 어둠이 형체를 갖춘다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared
#. Speaker = Player
#. NodeID = 11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared:11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
msgctxt "h9c72de63g86bcg4208ga84dg6555bb8495bd"
msgid "Hells. I had my fill of tentacles on the nautiloid."
msgstr "젠장. 노틸로이드 함선에서 촉수는 충분히 겪어봤다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared
#. Speaker = Player
#. NodeID = 11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared:11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
msgctxt "hf8245683g0096g4fafga8fbg1a66a30689d6"
msgid "Hells - what <i>is</i> that thing?"
msgstr "세상에, 저게 <i>대체</i> 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared
#. Speaker = Player
#. NodeID = 11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Siege_PAD_TentacleAppeared:11e9050a-8c2f-4f85-b62c-f7d9b1582f2e
msgctxt "hf106c1e1g61f1g4707gb89fgc99f2576dbcc"
msgid "What in the hells is <i>that</i>?"
msgstr "대체 <i>저게</i> 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy
#. Speaker = Isobel
#. NodeID = b4fa1ca7-65c8-4926-3318-eaf97690243d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelInRoom = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy:b4fa1ca7-65c8-4926-3318-eaf97690243d
msgctxt "haabce8cdg7992g4087gae01g1e485a7e4612"
msgid "Heed this prayer; protect us, Our Lady of Silver..."
msgstr "기도를 들어 주소서, 우리를 지켜 주소서, 은빛 여인이시여..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy
#. Speaker = Isobel
#. NodeID = b4fa1ca7-65c8-4926-3318-eaf97690243d
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelInRoom = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy:b4fa1ca7-65c8-4926-3318-eaf97690243d
msgctxt "h80c9b354geb42g4145g9cbfg08f795de5329"
msgid "Heed my cry, Moonmaiden, ever-changing..."
msgstr "간곡히 청하나이다, 영원히 변화하는 달처녀이시여..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy
#. Speaker = Isobel
#. NodeID = b4fa1ca7-65c8-4926-3318-eaf97690243d
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelInRoom = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy:b4fa1ca7-65c8-4926-3318-eaf97690243d
msgctxt "h41f5c450g889cg4df3g9c48g535d4b7fd6ba"
msgid "Moonmaiden, hear me..."
msgstr "달처녀이시여, 들어 주소서..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy
#. Speaker = Isobel
#. NodeID = f622b727-c8ef-f59d-c180-61129ec88e45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelInRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_BeforeFlamingSpy:f622b727-c8ef-f59d-c180-61129ec88e45
msgctxt "h56fa1715g28b7g4f66ga632g199af46ce653"
msgid "Hold on - where's Marcus?"
msgstr "잠시만, 마커스는 어디 있죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_CombatBetrayalReveal
#. Speaker = Isobel
#. NodeID = bc48a448-ded4-4895-84b4-ee92ec20425f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_CombatBetrayalReveal:bc48a448-ded4-4895-84b4-ee92ec20425f
msgctxt "h8d8a0b46g09fbg4d16g88e5g7b898f7070fb"
msgid "There are traitors among us - Marcus and the True Soul!"
msgstr "우리 중에 배신자가 있다. 마커스와 이 참된 영혼이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_FollowUp
#. Speaker = Jaheira
#. NodeID = 52043d74-137f-4bc8-a181-482386d38a3e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: ACT1_DEN_FAITHWARDEN
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_FollowUp:52043d74-137f-4bc8-a181-482386d38a3e
msgctxt "h722e2249g66c8g4db3ga3e7g37806d866060"
msgid "Faithwarden! What happened?"
msgstr "믿음지기여! 무슨 일이 있었던 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_FollowUp
#. Speaker = Jaheira
#. NodeID = 52043d74-137f-4bc8-a181-482386d38a3e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_FollowUp:52043d74-137f-4bc8-a181-482386d38a3e
msgctxt "h249b8278ge76eg4ea1g82ecgf46b29c3fe30"
msgid "You! What happened?"
msgstr "너! 무슨 일이 있었던 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_ReactingToRoofNoise
#. Speaker = Isobel
#. NodeID = 7cf076c5-cfd1-47ca-8978-839921bc1f78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_ReactingToRoofNoise:7cf076c5-cfd1-47ca-8978-839921bc1f78
msgctxt "h116e3951g5702g41b7gaf56g3ffcafc5bf8c"
msgid "Who's stomping around up there?"
msgstr "누가 위에서 쿵쿵거리는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyAtEntrance
#. Speaker = Fist Marcus
#. NodeID = 7e68817f-b348-4bf5-963c-3b590b8eeb6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyAtEntrance:7e68817f-b348-4bf5-963c-3b590b8eeb6a
msgctxt "hda78d7a4g3144g400agbfa7gf6cf991ac041"
msgid "Need to be back at my post."
msgstr "내 초소로 돌아가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyRemindsKO
#. Speaker = Fist Marcus
#. NodeID = 8dd22a4b-af90-4914-9d6d-6b32d49b9c4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyRemindsKO:8dd22a4b-af90-4914-9d6d-6b32d49b9c4a
msgctxt "h127d1bcag9536g441egb903gea127a58c919"
msgid "We need the cleric <i>alive.</i>"
msgstr "클레릭을 <i>산 채로</i> 데려가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyWaiting
#. Speaker = Fist Marcus
#. NodeID = 2b2af164-67c0-47e7-b076-4d73124ffa76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelInRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyWaiting:2b2af164-67c0-47e7-b076-4d73124ffa76
msgctxt "hd2755500g5815g4e41gb8a0g7a9a9176a212"
msgid "What's the hold-up?"
msgstr "뭘 기다리는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyWaiting
#. Speaker = Fist Marcus
#. NodeID = e242a054-8145-d29f-043e-ad56bd9a98a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelInRoom = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_AD_SpyWaiting:e242a054-8145-d29f-043e-ad56bd9a98a0
msgctxt "h3d8d453dg1bddg41aeg970agf28a0f6f4274"
msgid "I need to get back..."
msgstr "돌아가야겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 0180c24f-1dfc-f8da-6e66-1ef2849fd8a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(2) = True
#. SetFlags:
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#.     - HAV_TakingIsobel_Event_IsobelToRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:0180c24f-1dfc-f8da-6e66-1ef2849fd8a2
msgctxt "h153f2699g31f1g4fbeg8a36gdaf6756867ce"
msgid "And a <i>Sharran </i>one at that."
msgstr "게다가 <i>샤 신도</i>로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 0342ebba-b5b2-9f31-b0c0-827c12d9ce55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:0342ebba-b5b2-9f31-b0c0-827c12d9ce55
msgctxt "h742d58e5g022dg41e5gbfc2gfa31210b9166"
msgid "What I see is an ally dead, and a stranger standing over his corpse."
msgstr "내 눈엔 죽어 있는 동맹과, 그 시체를 밟고 서 있는 이방인만 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 03ef6844-4f8e-00e0-157c-d11ca5429a43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:03ef6844-4f8e-00e0-157c-d11ca5429a43
msgctxt "h5adce05fgf3a4g415cg8d8cg7020f8fd5286"
msgid ""
"If that were true, why wait to make his move? He'd had every opportunity."
msgstr "그게 사실이라면, 왜 행동할 때까지 기다렸던 거야? 마커스는 기회가 아주 많았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 04b6bd1c-bbdf-e565-64ef-5b96fbf4645c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelGaveMoonlantern = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:04b6bd1c-bbdf-e565-64ef-5b96fbf4645c
msgctxt "h0f9891f4g3025g40c5g9dacg5f40f519eeac"
msgid ""
"Well! If I'd have realised, I'd have spared the theatrics. In that case, you "
"should be able to navigate a path straight to your target. That's good - "
"very good."
msgstr ""
"이런! 미리 알았다면 이런 의식은 생략할 수 있었을 텐데. 뭐 그렇다면, 그대로 길을 돌파할 수 있겠구나. 좋아. 아주 좋은 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 05376e44-bbb9-ba42-49a0-d88ef1b674f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:05376e44-bbb9-ba42-49a0-d88ef1b674f2
msgctxt "ha0d452eege08bg4ddcgade0g954c8ec8900e"
msgid "I'm hungry for blood. And I want yours next."
msgstr "나는 피에 굶주려 있다. 다음은 네 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 05b36e99-cf75-c5ce-b90f-dab860e34cc7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:05b36e99-cf75-c5ce-b90f-dab860e34cc7
msgctxt "hbb5e290ege6b0g49b0ga4a0gd5b13a5291a0"
msgid "Let us hope Selûne's protection is worth the <i>sickly</i> radiance."
msgstr "셀루네의 보호가 이 <i>아픈</i> 광휘를 두를 가치가 있길 빌어야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 06b5d186-4b08-f352-28ea-319f17d35d1f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !CLERIC_SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:06b5d186-4b08-f352-28ea-319f17d35d1f
msgctxt "h5ac30a89gd43dg448egb0degb1d87c16d4d4"
msgid ""
"You must be a high cleric indeed to enjoy such direct blessings from Selûne."
msgstr "셀루네에게서 그런 축복을 직접 받다니 분명 고위 클레릭이겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 06b5d186-4b08-f352-28ea-319f17d35d1f
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:06b5d186-4b08-f352-28ea-319f17d35d1f
msgctxt "hf5b7fbe7g9b50g4406g9150ge405373d3b1c"
msgid ""
"You must be a high cleric indeed to enjoy such direct blessings from our "
"Lady."
msgstr "우리 여신께 그런 축복을 직접 받다니 분명 고위 클레릭이겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 0707fa35-900a-1673-f7eb-3bbe590b671c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:0707fa35-900a-1673-f7eb-3bbe590b671c
msgctxt "h8dd16403g9a77g4fd6gbbe7g3b6c68378ed7"
msgid ""
"For now, perhaps. But Shar can be fickle, and her love can prove fleeting. "
"Do not turn your back on an advantage you may need... even a Selûnite one."
msgstr ""
"지금은 그렇겠지. 하지만 샤는 언제든 변덕을 부리고, 샤의 사랑이란 덧없음의 증명이야. 필요할 수도 있는 유리함에 등 돌리지 마... "
"설령 셀루네의 것이라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 0ab58c43-f53c-7048-8eb6-e882006d26d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:0ab58c43-f53c-7048-8eb6-e882006d26d4
msgctxt "h587bc197g357ag4125g88cfgd217015081fa"
msgid "I wish you luck. The very best of it."
msgstr "행운을 빌어. 제일 강한 걸로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 0db15731-56a2-4ed1-34d9-bc1ec9bf1dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:0db15731-56a2-4ed1-34d9-bc1ec9bf1dd3
msgctxt "hd96fc578ge03eg4b91gbb3agf9ea25e6ff3e"
msgid "If that's true, then he was right."
msgstr "그게 사실이라면, 그의 말이 맞군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 0e34160a-9ef7-b536-cec2-2292a34a75e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:0e34160a-9ef7-b536-cec2-2292a34a75e5
msgctxt "h567f1557gcd88g4f56gb449gc79799db4883"
msgid "Selûne help you - you're mad."
msgstr "셀루네여 도우소서, 넌 미쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 0ea5b9e0-767e-dcd0-9757-fc5c501664ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = True
#.      - GLO_HAV_IsobelGaveMission = False
#.      - HAV_Jaheira_State_MissionGiven = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:0ea5b9e0-767e-dcd0-9757-fc5c501664ff
msgctxt "h30f50399gb263g4cccgb694g8e3b13d37638"
msgid "We need to talk about Ketheric Thorm."
msgstr "케서릭 쏨에 관해 얘기할 것이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 13853820-cc10-d4e2-bc9f-5f87fea8b9c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:13853820-cc10-d4e2-bc9f-5f87fea8b9c4
msgctxt "hae5fd2a2ga554g4479ga041g864dba35867c"
msgid "Ha ha."
msgstr "하 하 하."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 14326779-c475-a19a-c379-6db4030ef2dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:14326779-c475-a19a-c379-6db4030ef2dd
msgctxt "he30c79f5ge36cg494dg8f8fgb76d2f27ba68"
msgid ""
"Fair. I admit, Marcus waltzing around the place undetected bodes rather ill "
"for our defences, doesn't it?"
msgstr "그래. 인정하겠어, 마커스가 들키지 않은 채 춤추며 돌아다녔다는 사실이 우리 방어에 좀 문제가 있다는 징조란 말이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 17c06ac9-2f96-234e-abd7-99a0e1c3e0b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_SpyIsDefeatedInRoom = False
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#.   Tag:
#.      - MALE(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_ContinueFromBriefInRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:17c06ac9-2f96-234e-abd7-99a0e1c3e0b1
msgctxt "hc1fdd7d2g96d5g4ae3g8084g5d4f299efb06"
msgid ""
"While you're busy in the Towers, I'll be sure to - Marcus? What's wrong?"
msgstr "네가 탑에서 바쁘게 일하는 동안, 나는 확실히... 마커스? 무슨 일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 18b18be5-939e-d1f5-e310-411999acba5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:18b18be5-939e-d1f5-e310-411999acba5c
msgctxt "h9707a1c1g59b4g4b34gb681gdb713a0bcfc4"
msgid ""
"It's almost too good to be true. But I'd be a poor cleric indeed not to "
"avail of a blessing when I see one."
msgstr "사실이라기에는 너무 좋은 조건인걸. 하지만 가용한 모든 축복을 써먹지 못한다면 형편없는 클레릭이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 1b4b90ae-4b9b-14d1-aae5-60e24fd14f2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:1b4b90ae-4b9b-14d1-aae5-60e24fd14f2d
msgctxt "hba9048e7ga238g4b2fg8103gcda34e233fed"
msgid "I already exposed the traitor among your ranks - what more do you want?"
msgstr "이미 배신자를 밝혀내 주었는데, 뭘 더 원하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 1bb176fc-2e21-d93e-36ad-116e5d431450
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:1bb176fc-2e21-d93e-36ad-116e5d431450
msgctxt "hdbcdef16gc471g45e8g9be7gd7013eebf738"
msgid ""
"As long as I keep channelling her power, this inn stays un-cursed. A defence "
"to your offence."
msgstr "내가 그분의 힘을 불러내는 한, 이 여관은 저주의 영향을 받지 않아. 네가 공격이라면 난 방어인 셈이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 1bec9ac5-d5ce-0e77-5e40-6c32fb698590
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:1bec9ac5-d5ce-0e77-5e40-6c32fb698590
msgctxt "h6cf336f0ga46fg4235gbe35g50e269d96f86"
msgid "All things in her strength. That's how the old litany goes, after all."
msgstr "모든 것은 셀루네의 힘 안에. 결국 이게 오래 된 기도문에 든 뜻이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 1ec7eed8-dbad-dd81-53c7-9a5f3dbbcb24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:1ec7eed8-dbad-dd81-53c7-9a5f3dbbcb24
msgctxt "hb63a8dd3g332cg4e12ga07agbe9d9eee7ec1"
msgid ""
"I... No. I cannot. I simply impart the blessings the Moonmaiden provides me."
msgstr "난... 아니. 그럴 수 없어. 난 그저 달처녀가 내게 내린 축복을 나눠주고 있을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 222f440b-a5af-3713-9521-9bfaaf2bcc9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MALE(1) = False
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_ContinueFromBriefInRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:222f440b-a5af-3713-9521-9bfaaf2bcc9d
msgctxt "h5a994c71g1769g489bg94d7ga663a02d7bdc"
msgid ""
"While you're busy in the Towers, I'll keep the people here safe. If you find "
"a way in, we'll come to your aid. Until then: go well. Be safe. And if you "
"should meet Ketheric Thorm... be careful."
msgstr ""
"네가 탑에서 바쁘게 일하는 동안, 나는 여기 있는 사람들을 지키겠어. 만약 들어갈 방법을 찾으면, 우리가 너희를 도울게. 그 때까진, 잘 "
"가. 안전하길. 그리고 케서릭 쏨을 만나게 되면...조심하길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 234cebc7-920d-da16-e8af-6107f4f9745b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_State_DarkUrge_FeltUrgeBeforeIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:234cebc7-920d-da16-e8af-6107f4f9745b
msgctxt "hb4eadbcag8483g440cgaad5g3e315414ef1a"
msgid ""
"*The blessing falls uneasily over your tainted body. You can't help but "
"dream: to kill her would destroy all of Last Light. You yearn for it so "
"deeply...*"
msgstr ""
"*축복이 당신의 오염된 몸을 불쾌하게 감싸옵니다. 당신은 그녀를 살해하고 최후의 빛 여관의 모든 것을 파멸로 이끌고 싶어 참을 수 "
"없습니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 272faecc-6f72-018a-3596-bdd3ed2f6369
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:272faecc-6f72-018a-3596-bdd3ed2f6369
msgctxt "h0e679adbg71bcg42aeg9669g0280b5145131"
msgid "That's none of your concern."
msgstr "네가 상관할 바 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 291ff1f4-7039-8c67-7f28-a5acefd71047
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:291ff1f4-7039-8c67-7f28-a5acefd71047
msgctxt "h8f2310f6g76cag4cbdg8266gf631bd5ff6e9"
msgid "I've heard of you. You're protecting this inn - just not from Marcus."
msgstr "네 이야기를 들었어. 여관을 보호하고 있지. 마커스한테서는 보호하지 못했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 2b13e737-38ec-30aa-587a-180d6e511a25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:2b13e737-38ec-30aa-587a-180d6e511a25
msgctxt "hbbeeb7b9g18b5g4d1dg9760ge4cb2d0e9c48"
msgid "Not so much <i>high </i>as... necessary, perhaps."
msgstr "그럴 수 있을 정도로 <i>고위는</i> 아닐 거야...아마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 2ddbad62-94ff-4912-2407-d469d926600e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_ContinueFromBriefInRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:2ddbad62-94ff-4912-2407-d469d926600e
msgctxt "h0eae6227gb7d5g46a0gb48bgc34b27ba78f5"
msgid "...Where's Marcus?"
msgstr "...마커스는 어디 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 312910a5-a3b3-d333-911f-dad1a2feda9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelGaveMoonlantern = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:312910a5-a3b3-d333-911f-dad1a2feda9b
msgctxt "h606a7237g31b7g48d7g9b04g49684dfafffa"
msgid "Well! Now you have two. Just in case."
msgstr "좋아! 그럼 이제 두 개야. 혹시 모르니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 33dfbe2c-c8b7-e358-dae0-65f15ebf8024
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:33dfbe2c-c8b7-e358-dae0-65f15ebf8024
msgctxt "h09aa094ege2cdg47c9g86c9gde8d65b2f6bc"
msgid ""
"Myself and our Lady are doing what we can to hold the line. I hear you and "
"your tadpole will be our offence."
msgstr "나와 우리 여신님은 전선을 유지하기 위해 할 수 있는 걸 하고 있어. 너와 네 올챙이가 우리의 공격 수단이 될 거라고 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 344981e1-fe5f-c83c-617d-5f710f4a971e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:344981e1-fe5f-c83c-617d-5f710f4a971e
msgctxt "h0971f140g4d05g43e7g8384gf3e97c623e92"
msgid ""
"You're the True Soul from the gate, right? It's a good thing you were here. "
"I'm Isobel. And we have much to discuss."
msgstr "정문에 있던 참된 영혼이 너구나, 그렇지? 네가 있어서 다행이야. 난 이소벨이라고 해. 그리고 다뤄야 할 얘기가 아주 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 3680670e-c8c4-408c-9478-31d9645174d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:3680670e-c8c4-408c-9478-31d9645174d0
msgctxt "h94cd19f9g38b6g4fd0gac41gf78cc98ed906"
msgid ""
"*But was it truly <i>nothing</i>? The pain gripped you tight, robbing you of "
"all composure for a moment...*"
msgstr "*하지만 정말 <i>아무 것도</i> 아니었을까요? 고통은 당신을 꽉 휘어잡았고, 한순간 평정심을 잃을 정도였습니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 3704280f-a4bf-7f71-643a-1dc3a1b78c6c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_HAV_TakingIsobel_HasMet_BriefInRoom(2) = True
#.   Global:
#.     - HAV_TakingIsobel_HasMet_Isobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:3704280f-a4bf-7f71-643a-1dc3a1b78c6c
msgctxt "hfbb163bcg4333g4905ga679g3ed6aed3f291"
msgid "I didn't realise I had an audience."
msgstr "관객이 있는 줄은 몰랐는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 3863354b-8753-9728-9c09-f16bcb108be7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SELUNE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:3863354b-8753-9728-9c09-f16bcb108be7
msgctxt "h74a10b81g9295g4021gbf80g5b0cb3a380bc"
msgid "All things with her strength. You know the litany."
msgstr "모든 것은 셀루네의 힘과 함께하니. 너도 아는 기도문이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 3ae91d4f-01ba-c257-c8c6-3d5b51a309dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_ResistedIsobelKilling = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:3ae91d4f-01ba-c257-c8c6-3d5b51a309dd
msgctxt "h1b3609d8g8d2cg4277g8146gf8aac6d91dfb"
msgid "<i>Push your Urges down.</i>"
msgstr "<i>충동을 억누른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 3e05183c-66a1-bed3-652e-1274bd03df6d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - HAV_TakingIsobel_BriefInRoom_UserShorcut_Sharran(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:3e05183c-66a1-bed3-652e-1274bd03df6d
msgctxt "h3071a366g3379g4537gba38gb3e130468e93"
msgid ""
"Let me guess: Jaheira's sent you to beg a protection spell off her favourite "
"cleric."
msgstr "어디 보자. 본인의 가장 아끼는 클레릭한테서 보호의 주문을 받으라고 자헤이라 님이 보낸 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 3ebc614a-74e0-e86b-e0de-45db9f745e9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:3ebc614a-74e0-e86b-e0de-45db9f745e9a
msgctxt "h2a78137cgc98cg487fg8eeag427212c1cbf9"
msgid ""
"An unfortunate coincidence. I hope never to meet the wicked man who "
"haemorrhaged shadows over this peaceful village. I've heard you might be the "
"person to stop him."
msgstr ""
"이름이 같다니 유감스러운걸. 이 평화로운 마을을 그림자로 난도질한 사악한 사람과는 절대 만나지 않고 싶어. 어쩌면 너야말로 그 사람을 "
"막을 수 있을 거라고 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 41218edb-b240-126e-4641-10804d058bba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:41218edb-b240-126e-4641-10804d058bba
msgctxt "h24e50460gdd69g4518g87f5gdd89a8d18d0e"
msgid "How have you made this sanctuary in the dark?"
msgstr "어떻게 이 어둠 속에서 성역을 세운 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 41f01571-9ab4-a794-c5ab-279c75eefdbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:41f01571-9ab4-a794-c5ab-279c75eefdbb
msgctxt "hae2d1cd5gac96g49f9gbd31g3cffa59aaf5f"
msgid "I am already protected. My Lady shields me from the curse."
msgstr "이미 보호받고 있어. 내 여신께서 저주를 막아 주시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 43ddbd92-1403-56d2-ae75-57cface4bfa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:43ddbd92-1403-56d2-ae75-57cface4bfa6
msgctxt "h80f9fa4dg4ed8g4ea2g918dg280c139aacf9"
msgid "I just did you a favour. Marcus was a traitor."
msgstr "당신에게 좋은 일 해 준 거야. 마커스는 배신자였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 442f0e97-1e6d-e388-1e07-2428dd4e1f47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SELUNE(2) = True
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:442f0e97-1e6d-e388-1e07-2428dd4e1f47
msgctxt "hc3abb03cgac9eg41aega13cgd9a47633b5ca"
msgid ""
"I must say, it was incredible to see the Moonmaiden working through you."
msgstr "이 말은 꼭 해야겠어, 달처녀께서 너를 통해 역사하시는 모습을 보니 굉장했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 448562a6-64bd-84b2-1e0f-4d8a6f0ea390
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_HarpersReturnWithLantern = True
#.   Object:
#.      - SCL_Drider_State_HasDriderMoonlantern(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_IsobelGaveMoonlantern = True
#.   Object:
#.     - SCL_Drider_Event_GiveMoonlantern(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:448562a6-64bd-84b2-1e0f-4d8a6f0ea390
msgctxt "hb19c74c1g1293g43c7g954cgf04725a3e8d4"
msgid ""
"It won't be enough to protect you against areas of utter darkness, though - "
"where the curse is strongest. This lantern should, though."
msgstr "완전히 어둠에 잠식된, 저주가 가장 강력한 곳에선 효과가 없을지도 모르지만. 그땐 등불이 도움이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 44e17800-24c9-f7af-9f08-a454ba077b1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_SpyIsDefeatedInRoom = False
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#.   Tag:
#.      - MALE(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:44e17800-24c9-f7af-9f08-a454ba077b1d
msgctxt "hb9af7e00g5959g493dg93b9gc1b51eb0c0d0"
msgid "Wait - Marcus is a True Soul, you know. And not the good kind, like me."
msgstr "기다려 - 마커스는 참된 영혼이야. 나처럼 착하진 않은 쪽이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 47313bbf-822f-8938-2b8b-d6f6dbbbb67c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SELUNE(2) = False
#.      - CLERIC(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:47313bbf-822f-8938-2b8b-d6f6dbbbb67c
msgctxt "h504b19c1g81b7g4053gaf17gb598ab1145e8"
msgid ""
"To see another so in touch with divinity is rare. You have my thanks, "
"Selûnite."
msgstr "신성의 손길을 입은 다른 자를 보게 되다니 드문 일이네. 감사를 받아 줘, 셀루네의 신도여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 47926420-e647-5c71-40ab-0303ff5ace8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:47926420-e647-5c71-40ab-0303ff5ace8d
msgctxt "hbf4e654dg89b6g4877gb023g3a98baaa5437"
msgid ""
"Curious. Surely the Nightsinger could have shielded all her followers, and "
"made this place her domain long ago... yet she only acts now, and aids you "
"alone. I wonder why."
msgstr ""
"흥미로워. 나이트싱어라면 분명 추종자 모두를 보호하고, 오래 전에 여기를 샤의 영역으로 만들 수 있었을 텐데...하지만 이제서야 "
"행동하고, 너만을 돕고 있어. 이유가 궁금하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 4835448a-0c37-29a2-5762-a92c43b91271
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:4835448a-0c37-29a2-5762-a92c43b91271
msgctxt "heb08e094g9248g49b8g8090gf91a5e825a18"
msgid ""
"We've both got a bitter pill to swallow. When this is all over, we can spit "
"it back out."
msgstr "우리 둘 모두 참고 넘어가야 할 부분이 있어. 이게 다 끝나면, 그 때 끄집어내자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 49c12284-cd49-4f0a-ebe7-de3aa05b45a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:49c12284-cd49-4f0a-ebe7-de3aa05b45a0
msgctxt "h68fdb540g84a7g4839gb140gb4ccc2bec046"
msgid "There is, actually."
msgstr "사실, 있긴 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 49cf7080-38ef-dc11-9f24-f25671d61060
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:49cf7080-38ef-dc11-9f24-f25671d61060
msgctxt "h379e1dc5gbefbg4a66gb21eg79828f5aba4c"
msgid ""
"Imagine our luck. We set up a desperate camp in the middle of a curse, in "
"the heart of an evil cult - and who should emerge from the darkness but "
"<i>you</i>."
msgstr ""
"얼마나 행운인지 생각해 봐. 저주 한가운데, 악한 교단 중심지에 절망적인 야영지를 꾸리고 있었어. 그리고 어둠 속에서 누가 나왔느냐면, "
"<i>너야</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 4a035b19-6db2-52f0-1939-a8889e077364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:4a035b19-6db2-52f0-1939-a8889e077364
msgctxt "he5f19aa4g3786g4a5eg891fg575560533520"
msgid ""
"Needed here more than anywhere. This place is thick with Shar's curse. Can't "
"be easy for our Lady to penetrate, but she finds a way."
msgstr ""
"그 어느 곳보다 여기에 필요했어. 이 곳은 샤의 저주가 아주 짙어. 우리 여신께도 꿰뚫기는 쉽지 않지만, 여신께서는 길을 찾으시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 4a7c5b81-8a22-73eb-8ff3-e4eac9b052a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:4a7c5b81-8a22-73eb-8ff3-e4eac9b052a1
msgctxt "h6e2ef225ga440g4376gab86g34767253a3f2"
msgid "I may have the parasite of a True Soul, but not the mind of one."
msgstr "내가 참된 영혼의 기생충을 가지고 있을진 몰라도, 정신은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 4be008fe-4cf7-550f-aa8e-c26b10dd3b0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:4be008fe-4cf7-550f-aa8e-c26b10dd3b0b
msgctxt "h0d8ec18agcc1ag462egbf9ag19cdbf939ecb"
msgid "I thought I smelled a Selûnite."
msgstr "셀루네 신도의 느낌이 나더라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Fist Marcus
#. NodeID = 4e567836-f657-e6c7-9d16-dae94d24a047
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#.   Tag:
#.      - MALE(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_IsobelToRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:4e567836-f657-e6c7-9d16-dae94d24a047
msgctxt "h9bc3ba5cg3517g46adga772gca70723b57eb"
msgid "Isobel. This is -"
msgstr "이소벨. 여기는..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 51862612-c102-0c97-4012-c31857ad369b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:51862612-c102-0c97-4012-c31857ad369b
msgctxt "h03834036ga8f7g4bfag82d2gc9399769bb43"
msgid ""
"Well! If the Moonmaiden didn't strike me dead for blessing you, she must "
"rather approve of this little alliance."
msgstr "좋아! 내가 널 축복했다고 달처녀님께서 천벌을 내리시지는 않는 걸 보니, 이 작은 동맹을 허락하시나 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 521aeb9b-ea24-014a-9c32-26a849390cdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:521aeb9b-ea24-014a-9c32-26a849390cdc
msgctxt "h9007f127g885cg4682gbd59gd2529aba386b"
msgid "Perfect."
msgstr "완벽해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 5472e876-730c-8299-d942-19a6a8f0fa02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:5472e876-730c-8299-d942-19a6a8f0fa02
msgctxt "h07980885ge204g410cg83d7g427b8aa46e47"
msgid "Anything else I should know before heading off?"
msgstr "그럼 떠나기 전에 내가 더 알아야 할 게 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 54daee1d-b419-3873-d027-0a8f0588e274
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:54daee1d-b419-3873-d027-0a8f0588e274
msgctxt "h8382f857g80dfg4e74gb3f4gdd1a487539ef"
msgid ""
"Refreshingly pragmatic of you. I sense Shar has offered some amount of "
"protection to you already, but... well, no harm in extra precaution - even "
"from a Selûnite."
msgstr ""
"기대와 다르게 실용적인걸. 샤가 이미 어느 정도 널 보호해 준 걸 느끼지만, 그래도...뭐, 더 대비해서 나쁠 것 없지. 설령 셀루네의 "
"보호라 해도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 55b92fbf-2456-167a-ed68-382856f6cd00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:55b92fbf-2456-167a-ed68-382856f6cd00
msgctxt "hcb9a0157g534dg43begade4g564bf766df65"
msgid ""
"*Her breath catches; you notice a barely-perceptible shudder run through her "
"body.*"
msgstr "*그녀의 숨소리가 멈칫합니다. 당신은 그녀의 몸이 겨우 알아볼 정도로 떨리는 것을 알아챕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 56130806-7604-ec2e-bdcf-73eaf8364f48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:56130806-7604-ec2e-bdcf-73eaf8364f48
msgctxt "h7c4d9e16g1cf5g4ba5gbbb3g878a8d850beb"
msgid ""
"I suppose that would be wise. We have a common enemy, after all: Ketheric "
"Thorm."
msgstr "그게 현명하겠어. 어쨌거나 우린 공동의 적이 있어. 케서릭 쏨이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 56b493bd-6de8-dde6-44a2-a008436f5b88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:56b493bd-6de8-dde6-44a2-a008436f5b88
msgctxt "h95e9148bg3cf8g483dgb4bbg69b40528da6f"
msgid "You can tell my allegiance from a look?"
msgstr "본 것만으로 내 신앙을 알 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 57d90515-c3db-3b53-3ef3-fbd1c9fa2134
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:57d90515-c3db-3b53-3ef3-fbd1c9fa2134
msgctxt "h2c24b961gb6c1g4704g99a2g0b3a3ee31a31"
msgid ""
"This will block the lesser effects of the shadow curse, allowing you to "
"traverse the darkness outside... should Shar's own protection falter, that "
"is."
msgstr ""
"이게 그림자 저주의 작은 영향은 막아줄 테니, 바깥의 어둠 속을 돌아다닐 수 있을 거야. ...샤의 보호가 불안정해진다고 해도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 58383ac2-d96f-c0c1-1edf-195f945da894
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:58383ac2-d96f-c0c1-1edf-195f945da894
msgctxt "h61bfa646g51f3g4786gbca8g5db09f3a8e06"
msgid "Well, we live in strange times."
msgstr "뭐, 우린 생소한 시대에 살고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 59ba2d7b-c732-3d3e-85c9-60aeba765c68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:59ba2d7b-c732-3d3e-85c9-60aeba765c68
msgctxt "hd6d7416fg4b22g40b8g8c33gf2fb68e88504"
msgid "I need nothing from a Selûnite."
msgstr "셀루네 신도에게선 아무것도 받지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 59f1b918-a893-948d-1e85-3c7c466f573c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_NEUTRAL or CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:59f1b918-a893-948d-1e85-3c7c466f573c
msgctxt "h7737897eg9ca8g4269g86ceg39e18565961a"
msgid "Good luck, and may the Moonmaiden protect you - if you can stand it."
msgstr "행운을 빌어, 달처녀께서 보호해 주시길. 네가 버틸 수 있다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 59f1b918-a893-948d-1e85-3c7c466f573c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:59f1b918-a893-948d-1e85-3c7c466f573c
msgctxt "h953c1639g60bag41d9ga4a5g3e42c3e932e5"
msgid "Good luck, and may the Moonmaiden protect you."
msgstr "행운을 빌어, 달처녀께서 널 보호해 주시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 5abca551-1045-2673-c9e0-b0da3daaac92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:5abca551-1045-2673-c9e0-b0da3daaac92
msgctxt "h43518267gbc34g4136g95a3g9503a350c61b"
msgid ""
"*Her breath catches; you notice a barely-perceptible shudder run through her "
"body.*"
msgstr "*그녀의 숨소리가 멈칫합니다. 당신은 그녀의 몸이 겨우 알아볼 정도로 떨리는 것을 알아챕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 5b82f416-d148-5f69-f767-1074befa4c6a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - HAV_TakingIsobel_BriefInRoom_UserShorcut_Sharran(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:5b82f416-d148-5f69-f767-1074befa4c6a
msgctxt "h9c1d18f0g138ag4e85gb09cg9761014e51a2"
msgid "Speaking of - you must be here for the protection spell - yes?"
msgstr "말이 나와서 말인데, 넌 분명 보호 주문 때문에 왔겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 5d78daef-2f30-609e-53e7-1f4c4a016c9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:5d78daef-2f30-609e-53e7-1f4c4a016c9c
msgctxt "hf67370dbga9acg4975g849fg2c1260a59698"
msgid ""
"I may be a True Soul, but I'm not like Marcus. The parasite doesn't control "
"me."
msgstr "난 참된 영혼일지 몰라도, 마커스와는 달라. 이 기생충은 날 조종하지 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 5dc78b11-da01-7f85-ea74-7262cb606e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:5dc78b11-da01-7f85-ea74-7262cb606e3b
msgctxt "hacb24f79g29a4g4fb0g8cecg25a698c467e4"
msgid ""
"<i>Nod. Better to humour her than make an enemy of all in this place. Lady "
"Shar will understand.</i>"
msgstr "<i>끄덕인다. 여기 있는 모두를 적으로 돌리느니 웃으며 어울려 주는 편이 낫다. 샤 여신께서도 이해해 주시리라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 5e88babc-8518-7505-a5b9-735ba66b1096
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:5e88babc-8518-7505-a5b9-735ba66b1096
msgctxt "h7fc149cbg97e5g4e68gb30fg1606dffcbf0a"
msgid "Well. I won't make that mistake twice."
msgstr "글쎄. 난 같은 실수를 또 하진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 63253426-fddc-3bcb-fe6c-d17bd30742aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:63253426-fddc-3bcb-fe6c-d17bd30742aa
msgctxt "h716159fag8c42g41fbg8badgbb8d98303825"
msgid "If I didn't believe it before, I certainly do now."
msgstr "전에는 못 믿었지만, 이젠 확실히 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 6377a885-290b-4f93-a76f-1a87f977e216
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_SHADOWHEART(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6377a885-290b-4f93-a76f-1a87f977e216
msgctxt "h47cf0464g14fdg4a5cga2c4gc92760682b5b"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 640d6e1f-32c4-f333-7bb3-776babb24480
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:640d6e1f-32c4-f333-7bb3-776babb24480
msgctxt "h0b996b1cgcf07g46abg9e54g62d39f60ea1e"
msgid "What the <i>hells </i>is this?"
msgstr "<i>도대체</i> 이게 무슨 일이죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 6590e8b4-a056-d2a5-af56-69c2e3dcf0f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6590e8b4-a056-d2a5-af56-69c2e3dcf0f9
msgctxt "h48b9bf0egf776g48ebgbff8g454a343701f0"
msgid ""
"But there are places it won't help - places where the curse is darker. "
"Stronger."
msgstr "하지만 효과가 없는 곳도 있어. 저주가 더 짙고, 강한 곳."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 68ba9bae-a6a2-7464-a96d-16b56dbde679
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:68ba9bae-a6a2-7464-a96d-16b56dbde679
msgctxt "hfbfa8f9dg0bacg4326g9d54g84824e67d450"
msgid ""
"When you don't have eyes in the back of your head, it helps to have allies. "
"Allies like you."
msgstr "뒤통수에 눈이 달려 있지 않을 땐, 동맹이 있으면 도움이 돼. 너 같은 동맹."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 6a3e0014-aed6-9526-86df-2e947bd08cd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6a3e0014-aed6-9526-86df-2e947bd08cd7
msgctxt "h4b025646g030bg424fga011g602d41dc2ba6"
msgid "We'll be sure to free them - <i>after </i>Ketheric is dead."
msgstr "당연히 풀어줄 거야, 케서릭이 죽고난 <i>다음에 </i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 6b272c02-b346-5900-be5c-323cb1f44cde
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_LATHANDER
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6b272c02-b346-5900-be5c-323cb1f44cde
msgctxt "hfb130ed5g6bc8g4b22g8443g38a3731c5566"
msgid ""
"Our Lady has always admired the Morninglord - let's hope you prove her right."
msgstr "우리 여신께서는 늘 아침군주를 우러러보셨어. 셀루네께서 옳았음을 네가 증명하길 빌게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 6b272c02-b346-5900-be5c-323cb1f44cde
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6b272c02-b346-5900-be5c-323cb1f44cde
msgctxt "h2af0dfb3g9dd0g4c92g9c39g072d27c02dfa"
msgid ""
"With Mystra's sage guidance and our Lady's protection, I'd say you've a "
"better chance than most."
msgstr "미스트라님의 현명한 인도와 우리 여신님의 보호가 함께한다면, 대부분의 사람보다는 승산이 높겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 6b272c02-b346-5900-be5c-323cb1f44cde
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6b272c02-b346-5900-be5c-323cb1f44cde
msgctxt "h04087805gb030g4356ga4aage5262ca8edf5"
msgid ""
"I'm sure your god already grants you a great deal - but a little extra never "
"hurt."
msgstr "네가 섬기는 신께서 이미 많은 것을 하사하셨겠지만, 조금 더 추가한다고 나쁠 건 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 6d2a8e9d-5cc9-0797-5e31-37d9de2c7aff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6d2a8e9d-5cc9-0797-5e31-37d9de2c7aff
msgctxt "hfedbd545g08c2g4e41ga7c4gac9950dd849d"
msgid ""
"I just did you a favour. Marcus wished to betray you. And there are other "
"dark forces after you."
msgstr "그냥 널 도와준 거야. 마커스는 널 배신하길 원했어. 그리고 널 쫓는 다른 어둠의 세력이 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 6d8db063-3c92-4a53-395d-62fdb82d1bff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6d8db063-3c92-4a53-395d-62fdb82d1bff
msgctxt "h7d582525gdec0g4f8ag867fg55e92dd92bc6"
msgid ""
"An unfortunate coincidence. I hope never to meet the wicked man who "
"haemorrhaged shadows over this peaceful village. I've heard you might be the "
"person to stop him."
msgstr ""
"이름이 같다니 유감스러운걸. 이 평화로운 마을을 그림자로 난도질한 사악한 사람과는 절대 만나지 않고 싶어. 어쩌면 너야말로 그 사람을 "
"막을 수 있을 거라고 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 6ea6466a-127b-5ca1-7cfe-e725f753aae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6ea6466a-127b-5ca1-7cfe-e725f753aae7
msgctxt "h8927aab4ga08eg4b66g9b18ga8f38522b9c1"
msgid ""
"It'll make you immune to the lesser effects of the shadow curse, which will "
"get you closer to the Towers."
msgstr "이게 그림자 저주의 영향을 감쇄해 줄 거야, 이제 타워에 더 가까이 갈 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 6fe00dc2-3e05-bf1f-19ec-648dd6f17664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:6fe00dc2-3e05-bf1f-19ec-648dd6f17664
msgctxt "h55676b46g6e18g4b8dg8341gbf340f112b92"
msgid ""
"You seem to have a lot to say about my allegiance. Can we focus on the task "
"at hand?"
msgstr "내 신앙에 대해 할 말이 많아 보이네. 눈앞의 문제에 집중하면 안 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 7163ad13-ae7c-2f27-0e4b-d64120c2ed8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:7163ad13-ae7c-2f27-0e4b-d64120c2ed8f
msgctxt "h9c13823agec07g4865g9eb2g1ebcc01bd791"
msgid "Dark forces upon dark forces, so it seems."
msgstr "어둠의 세력 위에 어둠의 세력이라, 그래 보이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 74967547-95d7-ee59-e0e7-36c9b384d2a7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:74967547-95d7-ee59-e0e7-36c9b384d2a7
msgctxt "h63e02b63g13edg4cdegb52fg9465b41a682e"
msgid "He crowed about what fools you all were to trust him."
msgstr "자신을 믿다니 너희가 얼마나 멍청한지 떠들어대더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 75d9d826-6379-31a6-f844-d6b21b8ff769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:75d9d826-6379-31a6-f844-d6b21b8ff769
msgctxt "hcd96d9d1gc1e9g4aeeg935cg37e9f99883df"
msgid "Small inn."
msgstr "작은 여관이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 760cb311-57ab-9dba-3b9f-3d9b44bd7267
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Knows_MetIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:760cb311-57ab-9dba-3b9f-3d9b44bd7267
msgctxt "ha308de64gb3ccg44fegbe53g28e9ed267ed4"
msgid ""
"*The Urge deep within tingles. This is the one the Butler commanded you to "
"kill.*"
msgstr "*내면의 충동이 꿈틀댑니다. 집사가 죽이라고 했던 자입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 77eec407-7779-734c-cc8a-72bad4dca1ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyIsDead = True
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:77eec407-7779-734c-cc8a-72bad4dca1ff
msgctxt "h804b84a0g751cg4ed8gabc3g7446743c39c6"
msgid ""
"He was trying to kidnap you. When he died, a tadpole came out of his head."
msgstr "이 자는 당신을 납치하려고 했어. 놈이 죽었을 때 머릿속에서 올챙이가 기어나오더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Shadowheart
#. NodeID = 79b444dc-f5b7-bfe3-dbdd-c5055499d9d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:79b444dc-f5b7-bfe3-dbdd-c5055499d9d4
msgctxt "h218edf11g37c7g4e30gb399gda94154f50c5"
msgid "A gaudy display. Let's just hope it actually protects us."
msgstr "화려하구만. 저게 우릴 지켜주길 바라자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 7a6ba064-b224-f8eb-7b48-a22208fc2677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:7a6ba064-b224-f8eb-7b48-a22208fc2677
msgctxt "h548e142eg6279g4485g93adg0985c7786af1"
msgid ""
"But... no. There was no opportunity - no chance for him to become infected."
msgstr "하지만...아니. 기회가 없었어. 감염될 기회가 없었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 7ab18683-26a5-4f17-99b7-0914737e8652
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:7ab18683-26a5-4f17-99b7-0914737e8652
msgctxt "hacfd9cb9g4f95g42bdgb7a4g385dec308a6f"
msgid "<i>It was nothing. Put it out of your mind.</i>"
msgstr "<i>아무 일도 아니었다. 마음 속에서 치워 버린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 7ac1ebc2-1c75-a52f-953d-ef56caf32c09
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:7ac1ebc2-1c75-a52f-953d-ef56caf32c09
msgctxt "hb8045111g4889g4325gbf7agf8548f53fb1f"
msgid ""
"I'm a cleric of Our Lady of Silver - though I suppose you've surmised that "
"much already, my comrade in arms."
msgstr "나는 은의 여인의 클레릭이다. 나의 동포여, 그 정도는 이미 예측했으리라 생각한다만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 7ac1ebc2-1c75-a52f-953d-ef56caf32c09
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:7ac1ebc2-1c75-a52f-953d-ef56caf32c09
msgctxt "hc1820c67g96a7g4155g9bb0g8a6e93b09e94"
msgid "I'm a cleric of Our Lady of Silver - the moon goddess Selûne."
msgstr "나는 은의 여인, 달 여신 셀루네의 클레릭이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 7b385e6d-f6bf-901a-a5fb-0777f4e99e52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:7b385e6d-f6bf-901a-a5fb-0777f4e99e52
msgctxt "hfae46767g86cfg4960g9c0eg09525df6ad55"
msgid "I'd better be off, then."
msgstr "그럼 가야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 7daaa0ff-7d9a-d014-a8e2-6c74a453123f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:7daaa0ff-7d9a-d014-a8e2-6c74a453123f
msgctxt "ha72de426g2150g4cebg9cd0gefbd2bfc8e8d"
msgid "This Sharran exposed a traitor in your midst."
msgstr "이 샤의 신도는 너희 중에 있는 배신자를 찾아냈어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 81e1f6b6-4139-4b60-83a4-2ad24553c8d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:81e1f6b6-4139-4b60-83a4-2ad24553c8d5
msgctxt "h2c89034dge1f4g45c7gae5agefe142a37c87"
msgid "*She offers you nothing.*"
msgstr "*여신은 아무 것도 내려 주지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 82ea7cdd-90c0-5d9c-bd9d-121009226f5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:82ea7cdd-90c0-5d9c-bd9d-121009226f5f
msgctxt "h0db7d5fbg013cg436bg902eg312a1bde4864"
msgid ""
"Your trip to the Towers, for one. And what you plan to do there. A True Soul "
"with a mind of their own..."
msgstr "일단 문라이즈 타워로의 여정이라든가. 또 거기서의 계획이라든가 말이야. 참된 영혼이지만 자아를 유지한다니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 840886c1-31c0-4810-b8cc-2e6744838fa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:840886c1-31c0-4810-b8cc-2e6744838fa8
msgctxt "h4b303f7agbd58g48a9g9a25ga0a7fcc57d1e"
msgid ""
"*Is Lady Shar punishing you? Or perhaps testing you? Is it the tadpole, or a "
"curse? You cannot say.*"
msgstr ""
"*샤 여신님이 당신을 벌하고 있는 걸까요? 아니면 시험하고 있는 걸까요? 올챙이 때문일까요, 아니면 저주 때문일까요? 당신은 대답하지 "
"못합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 877716d5-6e6a-2d88-9ce2-83ec59cc11e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_Knows_KillIsobel = True
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:877716d5-6e6a-2d88-9ce2-83ec59cc11e6
msgctxt "h05ce98e1gf8bag413ega129gefafab29af83"
msgid ""
"*Your tingling Urge knows her face - this is the cleric Sceleritas sent you "
"to kill.*"
msgstr "*마구 일어오르는 당신의 충동은 이 여자의 얼굴을 알고 있습니다. 스켈레리타스가 죽이라고 했던 그 클레릭입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 88433fce-3cd3-7468-6345-edb7153e8072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:88433fce-3cd3-7468-6345-edb7153e8072
msgctxt "h1382b8e5g3fbcg4374g8e45g0631c751641f"
msgid "Save you? How do you figure that?"
msgstr "구해줄 거라고? 왜 그렇게 생각하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 89561ef8-2db4-899e-7595-2cb29094c15f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:89561ef8-2db4-899e-7595-2cb29094c15f
msgctxt "h334a14c3g1a74g4b9fg82f4gfcbe74594d34"
msgid "Oh, joy. The True Soul turned out to be a baddie after all."
msgstr "재밌네. 결국엔 이 참된 영혼이 나쁜 놈이었다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 8a6e302a-432d-553b-238d-910c3eb1b521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:8a6e302a-432d-553b-238d-910c3eb1b521
msgctxt "h50338e97gbae5g499fg8082gf5149692c433"
msgid "And I'm very grateful. But very needy, too."
msgstr "매우 감사하고 있어. 하지만 너희가 매우 필요하기도 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 8c6a29d3-892e-22f8-bf1e-ed5de1f64420
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:8c6a29d3-892e-22f8-bf1e-ed5de1f64420
msgctxt "h4c9df9b2g4706g4e44g8720gf5f21ff1665a"
msgid "You're not <i>serious</i>, are you?"
msgstr "지금 <i>농담</i>하는 거지, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 8d11d813-0bfa-8c67-5db0-ff306f39a2df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:8d11d813-0bfa-8c67-5db0-ff306f39a2df
msgctxt "h0cc5eb63gdd6cg4c5egb6eag7d0c3cecf7c4"
msgid "Only a fool would doubt it."
msgstr "바보만이 그걸 의심하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 8d57180b-8b47-d49c-95e2-3d1ca139b9d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:8d57180b-8b47-d49c-95e2-3d1ca139b9d8
msgctxt "hc534d241g719ag4733g9df7g618a769bf64c"
msgid ""
"I don't mind, though. I've been itching to gut a traitor. Ketheric's out of "
"reach, but here you are, right within striking distance."
msgstr ""
"하지만 상관없어. 배신자를 죽이고 싶어 참을 수가 없던 차였으니까. 케서릭은 손이 닿지 않는 곳에 있지만, 너는 바로 여기에, 공격할 수 "
"있는 거리에 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 8eeead1a-f2ea-82ac-921b-bed0400a05ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:8eeead1a-f2ea-82ac-921b-bed0400a05ee
msgctxt "h94068391ga08bg4b42g9295g408afa31f381"
msgid ""
"I don't think you can afford to be picky - no matter how distasteful your "
"god finds mine."
msgstr "지금 뭘 가릴 수 있는 처지는 아닐거야 - 그쪽 신이 내 신을 얼마나 경멸하더라도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 919f2e54-ea73-9f31-c035-3e0220b530f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:919f2e54-ea73-9f31-c035-3e0220b530f9
msgctxt "he2d08e2eg6510g4183g8310g90ddee954fa6"
msgid ""
"Our Lady has granted me the ability to protect these people. It isn't a "
"permanent fix, but it's what we've got."
msgstr "내 여신께서는 내게 이 사람들을 지키기 위한 능력을 부여했어. 근본적인 해결책은 아니더라도, 당장은 이게 우리가 가진 다야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 934c6ed8-58ec-134c-5a5a-e4f400e9d38f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:934c6ed8-58ec-134c-5a5a-e4f400e9d38f
msgctxt "hcc7b6c90gf2c4g4cd8g813cg36e7e9ce53bf"
msgid "Then again, the best defence is a good offence."
msgstr "하지만 최선의 방어는 공격이라고도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 937f13a4-4b2f-1120-7b82-85f579d95d10
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:937f13a4-4b2f-1120-7b82-85f579d95d10
msgctxt "ha98f003bg15c9g401agbd4dg4af4fcf249fa"
msgid "By our Lady's grace - I thank you."
msgstr "여신의 은혜여, 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 937f13a4-4b2f-1120-7b82-85f579d95d10
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:937f13a4-4b2f-1120-7b82-85f579d95d10
msgctxt "h181fc434g0176g439eg81e1g8313a8ab2b8e"
msgid "Thank you - now I must take my leave."
msgstr "고마워, 이제 가봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 9416dfd5-1421-56a4-6c98-89a830c6dac7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:9416dfd5-1421-56a4-6c98-89a830c6dac7
msgctxt "h5edea783g1a11g4387gb722gc16711747a8f"
msgid "In that case, I owe you a debt of gratitude."
msgstr "그렇다면, 너한테 신세를 진 셈이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 94f3ab4f-ab79-bab2-e1ea-108cd87aed08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:94f3ab4f-ab79-bab2-e1ea-108cd87aed08
msgctxt "h88114524g32b8g41c4gb0d1g11c015ef0c14"
msgid "I want nothing more than to cut you up and eat you raw!"
msgstr "난 그저 널 잘라서 생으로 먹고 싶을 뿐이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = 97bb6240-261b-5994-1213-72b26c6e47b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:97bb6240-261b-5994-1213-72b26c6e47b0
msgctxt "h7664d4a0gdc2eg465bg97b3g5663be44a309"
msgid ""
"*Isobel. The same name as Ketheric Thorm's daughter - the one whose "
"sarcophagus you found empty in the family mausoleum.*"
msgstr "*이소벨. 당신이 가족묘지에서 발견한 비어있던 석관의 주인, 케서릭 쏨의 딸 이름과 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 99419a68-fd42-5673-c688-0b3f041845a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_SpyIsDefeatedInRoom = False
#.   Tag:
#.      - MALE(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_ContinueFromBriefInRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:99419a68-fd42-5673-c688-0b3f041845a2
msgctxt "hcd2d8b7fg9f35g4b19gbcf3ga1c27d5872d5"
msgid ""
"While you're busy in the Towers, I'll be sure to - wait. Do you hear that? "
"Something's wrong..."
msgstr "네가 탑에서 바쁘게 일하는 동안, 나는 확실히... 잠깐. 저거 들려? 뭔가 잘못됐어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 9b2df909-825f-5985-8f82-90285f4b24e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_SpyIsDefeatedInRoom = False
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#.   Tag:
#.      - MALE(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:9b2df909-825f-5985-8f82-90285f4b24e2
msgctxt "h432edf63g2704g4561gb471g1d6c15cd4e3c"
msgid "Hold on - Marcus is a True Soul. He's here to kidnap you."
msgstr "기다려 - 마커스는 참된 영혼이야. 널 납치하려 하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 9b8a343a-58e1-f49c-dc7a-0c898b6f1819
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:9b8a343a-58e1-f49c-dc7a-0c898b6f1819
msgctxt "h3a91bc1dgdae5g468dg83d9gca7672b548c8"
msgid ""
"Now that you mention it... he was here before Jaheira caught that tadpole "
"she's been using."
msgstr "듣고 보니...마커스가 여기 있던 때는 자헤이라가 쓴 그 올챙이를 잡기 전이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 9f27daa0-99ed-daff-1c01-2a60488195f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:9f27daa0-99ed-daff-1c01-2a60488195f9
msgctxt "h1e2af6f7g72e5g4c53g9519g9cd6bb2f91ac"
msgid "Free from the Absolute's influence, yet able to walk among cultists."
msgstr "절대자의 영향력이 미치지 않지만, 사교도 사이를 거닐 수 있단 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = 9f503ef1-3c2d-c23c-f308-152680b1c87b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_State_IsobelToldAboutHarpers = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:9f503ef1-3c2d-c23c-f308-152680b1c87b
msgctxt "h3f46f394ga990g4f23g8bd2g9c3a4fe58a60"
msgid ""
"The cultists are able to traverse even the deepest shadows, though. I don't "
"know how - the Harpers are trying to figure it out."
msgstr "광신도들은 가장 깊은 그림자 속을 나아 갈 수 있는데, 그 방법은 모르겠어. 하퍼들이 알아내기 위해 노력 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = 9fab01f6-f065-8591-fad0-192d61b41b97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(2) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#. SetFlags:
#.   Global:
#.     - HAV_Isobel_State_ConfrontedAboutHerFather = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:9fab01f6-f065-8591-fad0-192d61b41b97
msgctxt "hc2d2fcb4g43d4g4b06ga858ge3b7fd1256cb"
msgid "Isobel - Isobel Thorm?"
msgstr "이소벨... 이소벨 쏨?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Shadowheart
#. NodeID = a0769229-f549-c9ee-fb26-6294b4b5a945
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a0769229-f549-c9ee-fb26-6294b4b5a945
msgctxt "hd1d3c496g8069g4c67ga3ffg72942b7eae6f"
msgid "Selûnite magic. Dark Lady forgive me."
msgstr "셀루네의 마법이라니. 어둠의 여신이시여 절 용서하소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = a096d718-4f34-d967-bef2-c2cd35f7936e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Drider_State_HasMoonlantern(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a096d718-4f34-d967-bef2-c2cd35f7936e
msgctxt "h05dac504gfa3bg41f0g9493gd8ac0a1e9724"
msgid "I do, though I already have a Moonlantern."
msgstr "그렇지, 내가 이미 달등불을 갖고 있긴 하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = a1b01c7b-a221-478d-b29e-799a29db3672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a1b01c7b-a221-478d-b29e-799a29db3672
msgctxt "h11a8a739g163bg4a26gbc15g5183dccc4eee"
msgid "<i>Try to understand what's happening.</i>"
msgstr "<i>무슨 일이 일어나는지 이해하려 애쓴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = a2b08972-b145-7250-0b02-f490b8208550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a2b08972-b145-7250-0b02-f490b8208550
msgctxt "h352ad7f5gc9f6g44dfga519g2df6853066a5"
msgid "Mustn't question the great shadow mother, must we?"
msgstr "위대하신 그림자 어머니께 여쭤보면 안 되겠다, 그치?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = a48dade9-eca3-a9ba-6f55-0ea873673b26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Drider_State_HasMoonlantern(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a48dade9-eca3-a9ba-6f55-0ea873673b26
msgctxt "h3ab06f6dgfd8bg4188ga7c4g2236e4db2ba1"
msgid "I already have a Moonlantern. I can safely travel the shadows."
msgstr "난 이미 달등불을 가지고 있어. 그림자를 안전하게 지나갈 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = a6fb61cb-3381-ea75-cb16-36a680fc1daf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a6fb61cb-3381-ea75-cb16-36a680fc1daf
msgctxt "hae83fd90g6baag4a4cg9383g8c3c802fb9e9"
msgid "It's an aura. Or a <i>lack </i>of one, really."
msgstr "그런 기운이 있어. 아니, 오히려 아무 <i>기운</i>도 느낄 수 없다고 해야 할지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = a7001bc8-beea-9b37-2eb1-a2e35997c734
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a7001bc8-beea-9b37-2eb1-a2e35997c734
msgctxt "h4c645fc5gf159g4aebgb982g59d9ea801d27"
msgid "Anything else I should know before heading off?"
msgstr "그럼 떠나기 전에 내가 더 알아야 할 게 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = a898aa5d-ce55-b65f-ec00-f63f83bbddde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a898aa5d-ce55-b65f-ec00-f63f83bbddde
msgctxt "h46b9f4c5gd59dg4356ga16cg6dafba525b36"
msgid "I want nothing more than to cut you up and eat you raw!"
msgstr "난 그저 널 잘라서 생으로 먹고 싶을 뿐이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = a89b2505-cd94-833b-a477-fa2c906ab9d6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a89b2505-cd94-833b-a477-fa2c906ab9d6
msgctxt "hd327e004gf14ag42e1g90f9gd5bf629a0413"
msgid "Moonmaiden! Guide my hand."
msgstr "달처녀이시여! 제 손을 인도해 주소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = a89f9973-737d-2667-0955-485084c8a80e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a89f9973-737d-2667-0955-485084c8a80e
msgctxt "h62db561cgba09g470fg8378g707847ea9ff7"
msgid ""
"Nice of you to show your colours, True Soul. Jaheira will be so disappointed "
"she trusted you."
msgstr "본색을 드러내주다니 고맙군, 참된 영혼. 자헤이라는 당신을 믿어준 걸 정말 후회하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = a9cb429f-f697-f115-b312-8980f1254219
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:a9cb429f-f697-f115-b312-8980f1254219
msgctxt "hc4694cfbgae52g4c33g97c1g0c74e7651af6"
msgid "The Dark Lady's works aren't for me to question."
msgstr "어둠의 여신님이 하신 일은 내가 감히 질문할 바가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ab5bb924-29e8-d09d-1cb6-2e2e65786f55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ab5bb924-29e8-d09d-1cb6-2e2e65786f55
msgctxt "h064ba83cg2f45g495eg9904g45b816e378a5"
msgid "I know your name, but little else. Care to enlighten me?"
msgstr "네 이름은 알지만 나머지는 거의 몰라. 내게 알려주겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ab94b7ac-810d-37bc-7b9b-fff5581eee59
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ab94b7ac-810d-37bc-7b9b-fff5581eee59
msgctxt "h259617a4g45cdg485fga52fg9327985cd3db"
msgid "I have no reason to lie. Marcus was a danger to you all."
msgstr "내가 거짓말을 할 이유가 없지. 마커스는 여기 있는 모두에게 위협이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ac965fad-d60c-31e2-79cd-368db11adcbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SELUNE(2) = False
#.      - CLERIC_GOOD(2) = True
#. TagRule: CLERIC_LATHANDER
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ac965fad-d60c-31e2-79cd-368db11adcbe
msgctxt "h23ae73b8g6c1bg47ecga702gf30df85af82a"
msgid ""
"Lathander's favour and Selûne's protection - darkness doesn't stand a chance."
msgstr "라샌더의 호의와 셀루네의 보호라니, 어둠은 아무 것도 못 하겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ac965fad-d60c-31e2-79cd-368db11adcbe
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SELUNE(2) = False
#.      - CLERIC_GOOD(2) = True
#. TagRule: CLERIC_MYSTRA
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ac965fad-d60c-31e2-79cd-368db11adcbe
msgctxt "h9481e97dgc87eg4c25gab1dgb370d2774e76"
msgid "Mystra and Selûne are close allies - I welcome her protection."
msgstr "미스트라와 셀루네는 가까운 동맹이지. 기꺼이 셀루네의 보호를 받아들이겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ac965fad-d60c-31e2-79cd-368db11adcbe
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SELUNE(2) = False
#.      - CLERIC_GOOD(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ac965fad-d60c-31e2-79cd-368db11adcbe
msgctxt "ha9f2edadg080ag4fb6gb645gf02a684f502b"
msgid "The Moonmaiden's protection is most welcome - thank you for this boon."
msgstr "달처녀의 보호는 매우 환영할 일이지. 이런 혜택을 줘서 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = b05b8157-dac3-1d66-52b7-36e2970f4add
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b05b8157-dac3-1d66-52b7-36e2970f4add
msgctxt "h7c7de99fg4737g4fdcg803cgd6a470c09b72"
msgid "I suppose you're right."
msgstr "그 말이 맞네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = b0aa840e-a065-bbb9-570f-34ccc9cac4b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b0aa840e-a065-bbb9-570f-34ccc9cac4b6
msgctxt "h46cf65b1gd695g4007g96b6ge17a69315b78"
msgid "I may have the parasite of a True Soul, but not the mind of one."
msgstr "내가 참된 영혼의 기생충을 가지고 있을진 몰라도, 정신은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = b0b3b018-45ff-1726-8b0b-03536b532e1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_ResistedIsobelKilling = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b0b3b018-45ff-1726-8b0b-03536b532e1a
msgctxt "hb1f662d6g47f0g4ba9g9324g205651882465"
msgid "<i>Push your Urges down.</i>"
msgstr "<i>충동을 억누른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = b134f3a1-7109-4f5b-4eeb-9bcd6d20fe3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = False
#.      - GLO_HAV_IsobelGaveMission = False
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.   Tag:
#.      - SHAR(2) = True
#.   User:
#.      - HAV_TakingIsobel_BriefInRoom_UserShorcut_Sharran(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b134f3a1-7109-4f5b-4eeb-9bcd6d20fe3c
msgctxt "hd0bdd1b7g6118g4921gb8efgce2291710473"
msgid ""
"The True Soul who's going to save us is a Sharran. Desperate times indeed."
msgstr "우리를 구할 참된 영혼이 샤의 신도라니. 절박한 시기로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = b21b0489-1247-54ab-a30c-38262c0f6d52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b21b0489-1247-54ab-a30c-38262c0f6d52
msgctxt "h7ec23c9agb120g40acg9bb5ga0c3e56a0027"
msgid "I've already been to Moonrise, but I have more work to do indeed."
msgstr "이미 문라이즈에는 다녀왔지만, 확실히 더 할 일이 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = b24e5d3d-15f0-8fac-383b-1cafb2257864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b24e5d3d-15f0-8fac-383b-1cafb2257864
msgctxt "h553e105cg054bg402ega1cege18d647cc328"
msgid "I'm glad you've remembered who needs whose help here."
msgstr "누구한테 누구 도움이 필요한지 기억해냈다니 기쁜데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = b2d8d25c-3c0f-b9cf-9405-4298f05569ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b2d8d25c-3c0f-b9cf-9405-4298f05569ca
msgctxt "h9e943866gdc42g42bfg9058g3ab21d748516"
msgid "A <i>tadpole</i>? Maiden's milk - how could that be?"
msgstr "<i>올챙이</i>라니? 달처녀이시여, 어떻게 그럴 수가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = b2f80c58-8464-f94e-9a5f-0f49b078a404
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b2f80c58-8464-f94e-9a5f-0f49b078a404
msgctxt "hd0a997ffgdeacg4f22g8918ga85f47ddffde"
msgid ""
"Frankly, I'm surprised you're willing to help us. Your kind aren't known for "
"their decency - particularly when a <i>Sharran curse </i>is our greatest "
"obstacle."
msgstr ""
"솔직히, 우릴 돕겠다고 해서 놀랐어. 너희는 체면을 모르는 족속인 줄 알았는데. 특히 <i>샤의 저주</i>가 가장 큰 난관일 때는 "
"말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = b5b8b098-623a-95b0-c193-bd2ecd7468e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b5b8b098-623a-95b0-c193-bd2ecd7468e7
msgctxt "h9fb57b84gf94ag42ebgbbedg8cf25062ecee"
msgid "Word gets around fast."
msgstr "소문 한번 빨리 퍼지는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = b67b51bb-57b5-9535-8472-ab1ce17ef969
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b67b51bb-57b5-9535-8472-ab1ce17ef969
msgctxt "h50105f9dg8843g4877gb329g4b1df80b16e7"
msgid "And that's what makes you essential."
msgstr "그게 네가 꼭 필요한 이유야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = b6875ef2-bb4b-95fc-2d82-c1713e0b74a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:b6875ef2-bb4b-95fc-2d82-c1713e0b74a8
msgctxt "h6b6d34a4g768eg4b91gb17fg6facebe566cb"
msgid "Very nice of you, but I've been to Moonrise Towers already."
msgstr "고마운걸. 근데 난 이미 문라이즈 타워에 다녀왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ba50eee0-6616-53b7-097a-7fb8a677b895
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ba50eee0-6616-53b7-097a-7fb8a677b895
msgctxt "h01a4f174gdb7dg4850ga8fag6a3734e84405"
msgid ""
"You must know this curse well to offer this blessing - can you tell me any "
"more about its unnatural source?"
msgstr "축복을 내릴 수 있다는 건 이 저주도 잘 알고 있다는 뜻이겠지 - 이 부자연스러운 근원에 대해서 더 말해줄 수 있는 게 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = c0a77f97-d4a0-1952-b6fd-a49c24ea1e8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyIsDead = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c0a77f97-d4a0-1952-b6fd-a49c24ea1e8f
msgctxt "h6ba00423g7c82g4c39gbb86ga242efc45105"
msgid "He was trying to kidnap you. I sensed the tadpole in his head."
msgstr "이 자는 당신을 납치하려고 했어. 놈의 머릿속에 있는 올챙이를 감지했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = c1583ecb-9c16-4da1-1914-505da66c87de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_NEUTRAL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c1583ecb-9c16-4da1-1914-505da66c87de
msgctxt "h9c5c1871g3dbag4618g819eg58a5d796301f"
msgid "Selûne's divinity is... strange to me, but her aid is welcome."
msgstr "셀루네의 신성은...내겐 생소하지만, 도움은 환영이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = c2a1522c-41a0-2594-c673-4784a764ebbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(2) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#. SetFlags:
#.   Global:
#.     - HAV_Isobel_State_ConfrontedAboutHerFather = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c2a1522c-41a0-2594-c673-4784a764ebbf
msgctxt "hab137622g5b64g45d3g9a32gd2b98c2955c2"
msgid "Isobel - Isobel Thorm?"
msgstr "이소벨... 이소벨 쏨?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = c37cc9e2-c9f2-f507-5b08-11c0aa063917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c37cc9e2-c9f2-f507-5b08-11c0aa063917
msgctxt "h968ed141gd944g447agb605g37a4b0127b06"
msgid "Speaking of blessings... you'll be needing my protection spell."
msgstr "축복 이야기를 했으니 말인데... 내 보호 주문이 필요할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = c567d503-2b24-0a94-d5e0-7c7bfce32fdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c567d503-2b24-0a94-d5e0-7c7bfce32fdf
msgctxt "hf3522775g85c8g4160g9d9egfbe9ae2d3780"
msgid "At your service."
msgstr "바로 여기 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = c5ae1695-b267-d6fb-30f6-49f77ef8fb93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_TakingIsobel_HeardOfIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c5ae1695-b267-d6fb-30f6-49f77ef8fb93
msgctxt "he7d6f72bg3c90g41b4g8b8agab02bcbf3bd8"
msgid ""
"And you. I've heard you're the protector of this inn - the banisher of "
"shadows."
msgstr "반갑군. 그쪽이 이 여관을 그림자로부터 보호하고 있다던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = c5b630d5-c727-340a-b9a4-c80da689727c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c5b630d5-c727-340a-b9a4-c80da689727c
msgctxt "h183cdce8g2398g4d4dga7ccg7c5c66cbc44a"
msgid "Bully for us."
msgstr "잘됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = c6db1aa0-c41d-8cbb-cdda-a4c18f430154
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c6db1aa0-c41d-8cbb-cdda-a4c18f430154
msgctxt "he3dd4f1cg68d7g4c14ga53fg94668c49a55f"
msgid "I suppose Shar is nothing if not mysterious."
msgstr "샤한테서 신비로움 빼면 뭐가 남겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = c9553dfe-f55f-3fab-2250-717e8c0f63a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:c9553dfe-f55f-3fab-2250-717e8c0f63a9
msgctxt "h5dd63ba0g0a89g495dga223g8f6316a0bfb5"
msgid "You're coming with me, cleric."
msgstr "넌 나와 함께 간다, 클레릭."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = caadc851-f01a-3ff9-a83a-cf5c72e52b20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:caadc851-f01a-3ff9-a83a-cf5c72e52b20
msgctxt "h53fcf0bfgb15fg4664g8eccg5d7bcb5d2733"
msgid "I will flay your skin and hang it over the balcony!"
msgstr "네 살가죽을 벗겨 발코니에 걸어주지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = ccf1545d-8ebd-7af5-9e2b-bc8aab6a2747
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = False
#.      - GLO_HAV_IsobelGaveMission = False
#.   Tag:
#.      - SHAR(2) = False
#.   User:
#.      - HAV_TakingIsobel_BriefInRoom_UserShorcut_Sharran(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ccf1545d-8ebd-7af5-9e2b-bc8aab6a2747
msgctxt "hfc3545cfg3938g4209g9b85gc10216ceb06f"
msgid ""
"You're here for the protection spell, right? Come on - let's get you fit for "
"purpose."
msgstr "보호 주문 때문에 왔겠지? 이리 와. 알맞게 도와 줄 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = ccf8ecbd-e937-423b-9b78-6e0e59eef755
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_SHADOWHEART(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ccf8ecbd-e937-423b-9b78-6e0e59eef755
msgctxt "h2207c327g2d06g441eg9385g8345c32b7114"
msgid ""
"*Pain bursts from the wound on your hand. You see yourself kneeling in a "
"dark hall, surrounded by initiates. A female voice preaches against Selûne "
"and all she stands for. You nod, rapt.*"
msgstr ""
"*당신 손에 난 상처에서 고통이 터져나옵니다. 당신은 어두운 홀 안에 무릎꿇은 채, 수습사제들에 둘러싸인 당신을 봅니다. 여성의 목소리가 "
"셀루네와 그 모든 상징에 대항하라 설교합니다. 당신은 끄덕이고, 몰입합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = cd770f4f-8b2b-9be0-966c-30d0c75ec1bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:cd770f4f-8b2b-9be0-966c-30d0c75ec1bb
msgctxt "h59665f0ag78a0g42b5gb598g5055af8f90be"
msgid "I won't be spoken to like that by a Selûnite."
msgstr "셀루네 신도 주제에 나에게 그런 식으로 말하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = cf51e331-fc3f-192a-57fe-2f6e4426b2f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:cf51e331-fc3f-192a-57fe-2f6e4426b2f2
msgctxt "he3452dbcg6baag49c1ga9begdf1e26287186"
msgid ""
"Are you faring all right? It can't be easy holding a lone candle in such "
"darkness."
msgstr "괜찮아? 이런 어둠 속에서 홀로 촛불 들고 있는 게 쉬운 일은 아닐 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Shadowheart
#. NodeID = cfe21807-3309-475e-a1ad-0f7308777979
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:cfe21807-3309-475e-a1ad-0f7308777979
msgctxt "h902a123dg1a1ag4dafg8248gbf54023d92ef"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = d4128968-38b5-010e-c3b1-6ba07b8987f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(2) = True
#. SetFlags:
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#.   Object:
#.     - HAV_Isobel_Knows_DiscussedPlayerPurpose(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:d4128968-38b5-010e-c3b1-6ba07b8987f6
msgctxt "hbea7c5bag2affg40f6g8c72g1e30be30429a"
msgid "A Sharran."
msgstr "샤의 신도로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = db7a4d9d-d9bd-149a-86ac-8e588f71127a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:db7a4d9d-d9bd-149a-86ac-8e588f71127a
msgctxt "he60edf2eg7d2bg41f2g98a5g29efed808913"
msgid "You're coming with me, cleric."
msgstr "넌 나와 함께 간다, 클레릭."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = dbef668b-789b-81a9-fc81-42f6ad97d2bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:dbef668b-789b-81a9-fc81-42f6ad97d2bf
msgctxt "h6e7ad6e9g8b35g4edeg8f9cg17d1bf15838b"
msgid "I don't know what to make of it myself."
msgstr "나도 어떻게 받아들여야 할지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = dc0772f3-cad7-5167-c242-242e4ddad825
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:dc0772f3-cad7-5167-c242-242e4ddad825
msgctxt "h93b81734g320eg4924g9cd6g57a9f40008df"
msgid "Good nose. Like a nasty little terrier."
msgstr "예민하네. 성격 나쁜 새끼 테리어 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = dd23acce-419a-c749-f8fb-ccdc4874f72d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:dd23acce-419a-c749-f8fb-ccdc4874f72d
msgctxt "hdde710ccgf8c5g4ec5gb916g0390a89322a8"
msgid ""
"You... have. Forgive me for gilding the lily. I suppose if Jaheira hasn't "
"gone tearing into the night, there's work to be done there yet."
msgstr ""
"다녀... 왔었구나. 내가 사족을 달고 있었네. 미안. 아직 자헤이라 님이 밤을 찢어버리러 나가지 않았다면, 아직 할 일이 남아있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = de70efd2-d88d-4771-9f2c-8be32b7f039b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:de70efd2-d88d-4771-9f2c-8be32b7f039b
msgctxt "h5985c4b5gdf43g4a55gbeaeg9e1b93d31f9e"
msgid "Let's not let an ancient squabble interfere with the task at hand."
msgstr "고대 신들의 다툼때문에 우리 눈앞의 일들을 흐리지 말자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = de9d6466-9642-c029-eab9-32c1086c676f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:de9d6466-9642-c029-eab9-32c1086c676f
msgctxt "hf6472161gde85g4952g8581g20c7418ef410"
msgid ""
"I'll stop needling you, though. You have more important things to do, after "
"all."
msgstr "이제 그만 괴롭힐게. 어쨌거나 너는 더 중요한 할 일이 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = e131c38e-80f4-61b0-b5bc-251ace4a5f09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:e131c38e-80f4-61b0-b5bc-251ace4a5f09
msgctxt "h4b6be8b3gbea0g4155gbcedg788faab553c8"
msgid "Oh - aren't you looking for a protection spell?"
msgstr "오, 보호 주문을 찾고 있지 않았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = e1e85297-a2f5-5075-6a9a-fd891916d1f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:e1e85297-a2f5-5075-6a9a-fd891916d1f4
msgctxt "hd087e6ebgf14bg4c74gb391gc129653dd5a4"
msgid "A True Soul with a soul. Imagine."
msgstr "영혼이 있는 참된 영혼이라. 상상해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = e39df99a-cdf1-dd92-ba07-28fd8e187c47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = True
#.      - GLO_HAV_IsobelGaveMission = False
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:e39df99a-cdf1-dd92-ba07-28fd8e187c47
msgctxt "h85727b8dgf78ag4d23gba28g61ee6c83d588"
msgid "I must stress how important it is that you defeat Ketheric Thorm."
msgstr "네가 케서릭 쏨을 물리치는 일이 얼마나 중요한지 꼭 얘기해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = e4535ea6-84d8-a0c7-7d59-79e158bdd713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:e4535ea6-84d8-a0c7-7d59-79e158bdd713
msgctxt "h2d393761gcaf9g4476g8c1fg76f9f6925166"
msgid "We've been waiting - hoping against hope - for someone like you."
msgstr "우린 포기하지 않고 너 같은 사람을 계속 기다려 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = e4c91365-3693-a2e8-6fa0-6efb15873376
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:e4c91365-3693-a2e8-6fa0-6efb15873376
msgctxt "h16cf6f06ga663g4363gad61g528f793b120b"
msgid ""
"Ketheric is a frightening man. But you have something he doesn't: allies "
"worth having."
msgstr "케서릭은 무시무시한 사람이야. 하지만 넌 케서릭이 가지지 못한 걸 갖고 있어, 가치있는 동료들 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = e906f3ac-ea0a-c41e-ba8a-4968a0524234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:e906f3ac-ea0a-c41e-ba8a-4968a0524234
msgctxt "h473b80b9gf73cg41b6ga38eg2a60a994533d"
msgid "A <i>traitor</i>?"
msgstr "<i>배신자</i>라니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = e935e359-d72e-4b40-e028-205e5c8d74bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(2) = False
#. SetFlags:
#.   Object:
#.     - HAV_Isobel_Knows_DiscussedPlayerPurpose(0) = True
#. TagRule: !(CLERIC_SHAR and PALADIN_SHAR)
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:e935e359-d72e-4b40-e028-205e5c8d74bc
msgctxt "hebf757bfgba9ag444ag8366g2b3356a15666"
msgid "The True Soul who's going to save us all. Pleased to meet you."
msgstr "우리 모두를 구할 참된 영혼이네. 만나서 반가워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = eaf91485-02b1-8d74-e552-76e08b6b1bda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:eaf91485-02b1-8d74-e552-76e08b6b1bda
msgctxt "h3f2771f5ge31bg4f26ga149g6e8eef2ee188"
msgid ""
"But any others who travel with you may not agree. Do it for them at least - "
"you will need all the help you can get out there."
msgstr "하지만 네 동행자들은 동의 못 할지도 모르지. 그 사람들을 위해서라도 해 봐. 저 바깥에선 받을 수 있는 모든 도움이 필요할걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = eb671df3-b8ee-e1c6-b783-3f051a25239c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:eb671df3-b8ee-e1c6-b783-3f051a25239c
msgctxt "h4770ba3eg0c4fg470eg9e85g5e0572e64480"
msgid "Believe it. He slipped through your fingers, but not mine."
msgstr "믿어 줘. 마커스는 널 속였지만, 날 속이진 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ec9368b2-56f7-ba60-bf90-ea0449f64d57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ec9368b2-56f7-ba60-bf90-ea0449f64d57
msgctxt "h4f632b49gd36dg4daeg9fc6ge37b7fad1be6"
msgid "Such as?"
msgstr "가령?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = edc0ea3b-2373-8ff0-c797-30d029e99938
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:edc0ea3b-2373-8ff0-c797-30d029e99938
msgctxt "hdee68bcag56f2g4472gb12cgc0b65a7c1210"
msgid ""
"If nothing else, it can aid any companions who travel with you - somehow I "
"doubt Shar's largesse was extended to them."
msgstr "적어도 너와 함께 여행하는 동료들은 도울 수 있겠지. 어쨌거나 난 샤가 동료한테까지 은혜를 베푸는지는 의심스럽거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = ede62252-c218-6eb1-d045-65e8ca03cb84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelGaveMoonlantern = True
#.      - GLO_Pixie_State_SeenPixie = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:ede62252-c218-6eb1-d045-65e8ca03cb84
msgctxt "h0d7d3319gb08fg4028gbe8egf69fd115339e"
msgid "A Moonlantern? Those are powered by trapped pixies, you know."
msgstr "달등불? 그거 픽시들 가둬놓고 동력으로 삼는 거, 너도 알텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Narrator
#. NodeID = eefe7fed-76e1-8a5b-71c7-52fdbba39eb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:eefe7fed-76e1-8a5b-71c7-52fdbba39eb1
msgctxt "hb1c92abbg8f21g40a0ga4a1gc2ca6b99e7a0"
msgid "*You choke down the obscene thoughts racking your body with a shiver.*"
msgstr "*당신은 몸을 떨게 만드는 불쾌한 상상을 꿀꺽 삼킵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = effb7db8-58f4-f759-0910-661040654fa3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:effb7db8-58f4-f759-0910-661040654fa3
msgctxt "h445b9b57gb072g4d1dg964fg1717870afe01"
msgid "You'll be needing the protection spell, I presume?"
msgstr "내 생각에 너희는 보호 주문이 필요하겠는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = f0211404-0720-2304-44f1-d562ad90a1b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:f0211404-0720-2304-44f1-d562ad90a1b5
msgctxt "h6b17f8f9g861eg40e2ga290gdb1649affc1f"
msgid "Not as ancient as you think."
msgstr "그렇게 고대의 일은 아니지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = f2140b94-42a9-6869-9d28-370a6d42c081
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - HAV_TakingIsobel_BriefInRoom_UserShorcut_Sharran(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:f2140b94-42a9-6869-9d28-370a6d42c081
msgctxt "h071b8c98gf34fg476dgab9aged8fd4b28c83"
msgid ""
"But if you are who I think you are, I'd be a fool to reject your help. The "
"True Soul with... well, a soul. Imagine."
msgstr ""
"하지만 네가 내가 생각하는 대로의 사람이라면, 네 도움을 거절하는 것은 바보 같은 일이겠지. 참된 영혼이지만... 영혼을 가지고 있다니. "
"상상해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = f2f0e903-ae65-b460-2ab8-1de5e03cebbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = False
#.      - GLO_HAV_IsobelGaveMission = False
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.   Tag:
#.      - SHAR(2) = True
#.   User:
#.      - HAV_TakingIsobel_BriefInRoom_UserShorcut_Sharran(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:f2f0e903-ae65-b460-2ab8-1de5e03cebbb
msgctxt "h6117853bge30fg42d6gadd0g54e7f8379ce8"
msgid ""
"You may be a Sharran, but you'll still be better off in those shadows with "
"my Lady's blessing. Just sit still for a moment, please."
msgstr "너는 샤의 신도일지 모르지만, 내 여신의 축복을 받고 저 그림자를 피하는 편이 더 나을 거야. 부디 잠시만 기다려 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = f4af3993-c8e6-8495-359b-381048ea63d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelGaveMoonlantern = True
#.      - GLO_Pixie_State_SeenPixie = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:f4af3993-c8e6-8495-359b-381048ea63d8
msgctxt "h17ecc267gec1bg4820g96a3g5160a8e61d25"
msgid "That Moonlantern - you know it's powered by trapped pixies, right?"
msgstr "달등불, 그거 픽시들 가둬놓고 동력으로 삼는 거, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = f8933ca0-2f84-6ee5-d517-67706bc4ecdc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(2) = False
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_IsobelToRoom = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:f8933ca0-2f84-6ee5-d517-67706bc4ecdc
msgctxt "hf472b335g6598g44f0g9b68ge3dbb6cce7c8"
msgid ""
"The True Soul who's going to save us all. I'm Isobel. Pleased to meet you."
msgstr "우리 모두를 구할 참된 영혼이네. 난 이소벨이라고 해. 만나서 반가워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = f90984f9-738e-5d68-b25c-2441a91ea88e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:f90984f9-738e-5d68-b25c-2441a91ea88e
msgctxt "h000ee7cfg6ae7g45e8g8d1eg8a48a98f429c"
msgid "I imagine so, if Jaheira hasn't gone tearing off into the night."
msgstr "그런 것 같아. 아직 자헤이라 님이 밤을 찢어버리러 나가지 않았다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Isobel
#. NodeID = fa9d5466-684e-0e18-bca6-68e4b1a19cbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:fa9d5466-684e-0e18-bca6-68e4b1a19cbc
msgctxt "h5fd8b32fg71b6g4692gbb41g0bde63364bb3"
msgid "And you mine - not many comprehend the task of steadfast faith."
msgstr "나 역시도 감사해. 굳건한 믿음의 직분을 이해하는 자는 많지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom
#. Speaker = Player
#. NodeID = fe6615c4-dc97-49a6-9c24-4b6d63eb1b2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_BriefInRoom:fe6615c4-dc97-49a6-9c24-4b6d63eb1b2e
msgctxt "h58454894g425dg4ce2ga90cg292f9cb2800a"
msgid "<i>Silently petition Lady Shar for guidance.</i>"
msgstr "<i>조용히 샤 여신의 인도를 청원한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_CoolingDown
#. Speaker = Isobel
#. NodeID = 3239703b-b049-4586-89cf-ae7c4520c7d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_CoolingDown:3239703b-b049-4586-89cf-ae7c4520c7d7
msgctxt "h790ff73dg2e91g437cg97cdg2e0d60a0f20e"
msgid "Where's Jaheira?"
msgstr "자헤이라는 어딨지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 00a2aa62-c4bf-e787-8233-4d9f1ee996a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:00a2aa62-c4bf-e787-8233-4d9f1ee996a3
msgctxt "h9f281914ga4c9g4447gbc81g17f340c0e05e"
msgid "Let's get moving, then."
msgstr "그럼, 가보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 04cbbd2e-c1ab-5fc7-f33a-d137b0570809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:04cbbd2e-c1ab-5fc7-f33a-d137b0570809
msgctxt "he7a8f7c6g8209g47bcgb09dg898b1f081e57"
msgid "My instructions are clear: bring her. Not you."
msgstr "내가 받은 지시는 명확해: 그 여자를 데려오라는 거지. 너 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 07e50405-c6c4-7977-fe8b-3809294957bd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:07e50405-c6c4-7977-fe8b-3809294957bd
msgctxt "h7d856094gbf53g4279gb26ag9b20959db2e5"
msgid ""
"I would have shared the glory of this mission with you. But maybe it's my "
"destiny to take it for myself."
msgstr "진심으로 이 임무를 완수하는 영광을 너와 함께 나누려고 했건만. 어쩌면 이 영광을 독차지하는 것이 내 운명인지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 0a8901ee-b816-1d8f-0128-026d77dafcea
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:0a8901ee-b816-1d8f-0128-026d77dafcea
msgctxt "ha435483dgb99eg4a4dgbca7gcfd4f3d4526a"
msgid "<i>Block him out: your mind is opaque.</i>"
msgstr "<i>접근을 막습니다. 당신의 마음을 흐릿하게 만듭니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 0c517193-e083-68a4-cb28-14a0b66bdd28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:0c517193-e083-68a4-cb28-14a0b66bdd28
msgctxt "h88a14738g1cb6g44d7g855cg655be5786241"
msgid "This is no time for petty jokes."
msgstr "이런 사소한 농담이나 할 때가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 18535e12-f2f9-5fbb-7d35-8e29f2a70110
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:18535e12-f2f9-5fbb-7d35-8e29f2a70110
msgctxt "hdec4691bg6108g41b9g92acg743be96b6174"
msgid "But I do."
msgstr "하지만 난 독차지 하고 싶은걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 1a0819cf-c8b6-8bbd-3b99-a313786f7c57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:1a0819cf-c8b6-8bbd-3b99-a313786f7c57
msgctxt "hde39f720gd95fg4a18g8d30g9184e33b84d1"
msgid "She's supposed to be captured, not killed?"
msgstr "생포하란 말이지, 죽이지 말고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 1b25b627-2d6a-ea2c-e19e-db7739973424
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:1b25b627-2d6a-ea2c-e19e-db7739973424
msgctxt "h730483d3g9bccg4527g91d4g81a350bc535a"
msgid "I've been told to capture Isobel."
msgstr "이소벨을 잡아오라고 하던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 25334bba-6f34-f0b4-5fae-451aa409e8ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:25334bba-6f34-f0b4-5fae-451aa409e8ee
msgctxt "ha18660d4gcb00g4c90g93d7g6d5a83587780"
msgid "I never fail."
msgstr "난 절대 실패하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 27f0da10-707d-2aa3-5bf0-18a3e57e7fd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:27f0da10-707d-2aa3-5bf0-18a3e57e7fd2
msgctxt "h6964437eg863cg49a2gaacbg9336eecdc912"
msgid "You can count me in."
msgstr "함께 하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 28172536-0884-4e04-ca31-0d86fc9045a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:28172536-0884-4e04-ca31-0d86fc9045a5
msgctxt "h8d089107g28cag42bega4c1g817c9edd7543"
msgid "You're lying..."
msgstr "거짓말..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 28c6ebd5-4edc-0904-81d7-0e396d76218f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:28c6ebd5-4edc-0904-81d7-0e396d76218f
msgctxt "h30460c54g63afg4caagb467g99e7ec9faeb0"
msgid ""
"But that's not my problem. The Absolute chose me to bring glory to this "
"place. The General must have sent you, too."
msgstr ""
"하지만 그건 내 알 바 아니고. 절대자님께서는 이곳에 영광을 나타내기 위해 날 선택하셨지. 장군께서도 분명 같은 이유로 널 보내셨겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 28dd2b05-97cc-51df-8f3d-063be62ce25c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:28dd2b05-97cc-51df-8f3d-063be62ce25c
msgctxt "h6b868862g83d5g46f0ga016g1d144ad60656"
msgid ""
"<i>Allow him to see what he wants to see: you were lying about the "
"artefact.</i>"
msgstr "<i>원하는 것을 보도록 내버려둡니다. 당신은 아티팩트에 대해 거짓말로 그를 속입니다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 2ecb6ec8-447c-f1ab-380c-48e97ab5ae24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:2ecb6ec8-447c-f1ab-380c-48e97ab5ae24
msgctxt "h1e410c38gb301g4366gb94fg8d73ead2ec84"
msgid ""
"I won't waste time in a petty tug-of-war. We'll do this together. We've got "
"the cleric alone. Now's the time."
msgstr ""
"쓸데없는 말싸움 하며 시간 낭비하고 있을 때가 아니네. 우리는 함께 싸울 거고 클레릭은 지금 혼자 남았지. 지금이 절호의 기회라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 3fd976e2-33c4-875d-47d1-cf8b04381da2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:3fd976e2-33c4-875d-47d1-cf8b04381da2
msgctxt "h2008687dgbee4g470cg8bd1g108ac7803401"
msgid ""
"So much good work undone by petty squabbling among the faithful. You "
"underestimate what true faith can do."
msgstr ""
"우리 추종자들 사이의 이런 불필요한 다툼 때문에 얼마나 많은 위업이 무산되는지 모르겠군. 너는 참된 믿음이 할 수 있는 일을 "
"과소평가하는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 419a2a0d-88ac-5940-4146-6d58c37ab30e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:419a2a0d-88ac-5940-4146-6d58c37ab30e
msgctxt "hb207d240gc204g4231g9791gbbb917cf5ae4"
msgid ""
"That's... that's the weapon the Absolute has been searching for. You're not "
"one of us. You're an abomination."
msgstr "그건... 그건 절대자께서 찾고 계신 무기로군. 넌 우리 편이 아니야. 혐오스러운 자식."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 47c2ccc5-c618-2fb6-3f08-d288ec01836b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#.   User:
#.      - HAV_TakingIsobel_UserShortcut_FlamingSpy(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:47c2ccc5-c618-2fb6-3f08-d288ec01836b
msgctxt "hd8daec89gcf50g474cg8d40g111fae40a689"
msgid "We're not done here."
msgstr "아직 안 끝났다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 493cdcf1-3507-ffed-35b1-4a4547c0b4b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:493cdcf1-3507-ffed-35b1-4a4547c0b4b9
msgctxt "hfe71557agca13g41fagbf08g8c2227a35fb7"
msgid "It's time. Let's go get Isobel."
msgstr "시간이 됐군. 이소벨을 데리고 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 4ba5a34e-f854-e3ae-fc08-f43757deca4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:4ba5a34e-f854-e3ae-fc08-f43757deca4f
msgctxt "h89906912g88cbg47c9g81e7g2532bbebdaf9"
msgid "Everyone believes what they most want to hear."
msgstr "누구나 자기가 듣고 싶은 말을 믿는 법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 50ae6fe8-53da-b2ad-f1ea-ff3e5fc22c67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:50ae6fe8-53da-b2ad-f1ea-ff3e5fc22c67
msgctxt "hbd70532ag20d9g407dga6bag3615af900f00"
msgid "Lucky for you. And perhaps for me."
msgstr "운이 좋았군. 어쩌면 나도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 54617821-bc56-6278-3de0-71eefcd3262b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:54617821-bc56-6278-3de0-71eefcd3262b
msgctxt "h52b79de5gd4aag4e8bgaa52gbcd0c0c4f19b"
msgid "I don't mind sharing the rewards."
msgstr "보상은 나눠가져도 상관없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 56d1593d-04dc-433a-aa95-dd0ddd30f73d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - HAV_TakingIsobel_UserShortcut_FlamingSpy(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:56d1593d-04dc-433a-aa95-dd0ddd30f73d
msgctxt "h5e948857g2ed7g47fcg89d0gae35b9c90206"
msgid ""
"I have orders from General Thorm in Moonrise Towers. We can work together. I "
"don't mind sharing the Absolute's glory."
msgstr ""
"난 문라이즈 타워에 있는 쏨 장군님의 명령을 받았어. 우리가 같이 일할 수도 있겠지. 난 절대자님의 영광을 독차지할 욕심은 없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 5e7a2c8b-b684-2c26-1c7f-6856fd7bdeba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:5e7a2c8b-b684-2c26-1c7f-6856fd7bdeba
msgctxt "hffdf0e3dg3302g44d8gb7c5g39017697de59"
msgid "Your vouching for me certainly helped. Thank you."
msgstr "네 보증이 확실히 도움이 됐지. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Narrator
#. NodeID = 5e9bdf2f-c4ec-18e7-057d-ddec3a74d16a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:5e9bdf2f-c4ec-18e7-057d-ddec3a74d16a
msgctxt "ha480aa14g7b65g458cg95e4gbb52a0a3e48a"
msgid ""
"*The soldier tries to force his way into your mind, searching for answers.*"
msgstr "*병사는 답을 찾기 위해 당신의 정신으로 침입하려 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 629953ae-57d7-743d-52ab-8eb04a1dc503
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_FlamingSpy_Event_AtDoor = True
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#.   User:
#.      - HAV_TakingIsobel_UserShortcut_FlamingSpy(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:629953ae-57d7-743d-52ab-8eb04a1dc503
msgctxt "hba0e09f1g0144g4731gb14ag648fd358acd9"
msgid "Hold on there."
msgstr "잠깐 기다려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 645d80a5-0a47-511d-a517-f5d8c62fe9f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:645d80a5-0a47-511d-a517-f5d8c62fe9f3
msgctxt "ha4dcda60ga669g4c39g9ad7g4347d942f119"
msgid ""
"Without her, everyone here - everyone scheming against General Ketheric - is "
"done for."
msgstr "즉 이소벨이 없어지면 케서릭 장군님을 음해하려는 이놈들은 모두 끝이라는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 64e578f1-df1d-40fa-bace-45478697b52b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:64e578f1-df1d-40fa-bace-45478697b52b
msgctxt "hcfaca718g2e55g4c2bga155gfddbc26be54b"
msgid "If the Absolute needs a cleric of Selûne, I'm right here."
msgstr "절대자에게 셀루네 클레릭이 필요하다면. 날 데려가면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 6922003a-6bdf-80f2-d6fd-32559b6e8a64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:6922003a-6bdf-80f2-d6fd-32559b6e8a64
msgctxt "h6848f969g0ea3g49dbg8e67gb3b68aa6c140"
msgid "When Ketheric Thorm speaks, we all listen."
msgstr "케서릭 쏨 장군님이 말씀하시면 우리는 순종 할 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 699c5221-6785-e4e0-bfa1-a5c0887e3333
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:699c5221-6785-e4e0-bfa1-a5c0887e3333
msgctxt "hdf55dcbfg29bag4467gbbafg5f3ac3ca8446"
msgid ""
"Isobel - the Selûnite cleric that guards this place. General Thorm wants her "
"alive."
msgstr "이소벨, 이곳을 지키는 셀루네 클레릭이지. 쏨 장군께서 생포해 오길 원하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 6a29fcb7-4e81-187f-eb85-ec1bc1e44146
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_SentToIsobel = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:6a29fcb7-4e81-187f-eb85-ec1bc1e44146
msgctxt "hf7243021gd2f1g44e4g8b8fgacac094bc18d"
msgid "Haven't heard of her."
msgstr "처음 들어보는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 709c04f3-6db9-db5c-1fe3-7b325ddd3f2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_AttackedMarcusDuringBrief = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:709c04f3-6db9-db5c-1fe3-7b325ddd3f2e
msgctxt "hc3b4e376g524bg45bbg92d6ge36a6a365fa0"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 7129681b-a992-a017-0007-51e98e758a74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:7129681b-a992-a017-0007-51e98e758a74
msgctxt "hb2988d8agfb0bg4f09g8ae0g1a6364b1338c"
msgid "Good - because I've been tasked with capturing Isobel."
msgstr "잘됐군. 난 이소벨을 잡아오라는 임무를 맡았거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 7a7c6bcd-551a-c9ac-fefc-514bba2d76b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:7a7c6bcd-551a-c9ac-fefc-514bba2d76b4
msgctxt "h790ec154g2f34g46ddg9ef5g1306fd32833f"
msgid "What is your mission here?"
msgstr "네 임무가 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 7ba614bd-9949-1201-83ad-bf4a96b990db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:7ba614bd-9949-1201-83ad-bf4a96b990db
msgctxt "h7e666c66g069cg41c1gbdddg5bad7b48a44d"
msgid "My pleasure, True Soul."
msgstr "도울수 있어 영광이지, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 7c472888-9f4c-d8c2-b3fa-c7b7f793c5e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:7c472888-9f4c-d8c2-b3fa-c7b7f793c5e1
msgctxt "hd784bc22gc3acg4a1eg9670g5f77640908d4"
msgid ""
"Aye. I hope she'll see reason, but if that fails, I'll have to initiate "
"more... extreme measures. And I'll expect your help in the fight."
msgstr ""
"그래, 난 이소벨이 이성적인 선택을 하길 바라지만 만약 설득이 실패한다면 조금 더 과격한 방법을 써야 할지도 모르겠군. 싸움이 난다면 "
"자네의 도움을 기대하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 843d4789-aa3d-f0f3-7006-f5ada210563c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:843d4789-aa3d-f0f3-7006-f5ada210563c
msgctxt "h98221d1cg0d55g47dcg9d6agf6cc5513c600"
msgid "Why that cleric specifically?"
msgstr "왜 하필 그 클레릭이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 8727fd87-6d1c-cf77-7e06-5825a0361f8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_RevealedArtifact = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:8727fd87-6d1c-cf77-7e06-5825a0361f8d
msgctxt "hbf97798fgb24cg4120gbffcg6ddf838a13bd"
msgid "<i>Glad to see you earned Jaheira's trust. That's no mean feat.</i>"
msgstr "<i>자헤이라의 신뢰를 얻다니. 아무나 할 수 있는 일은 아닌데.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 88474210-9aa9-41c5-bc14-38a4f984052f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:88474210-9aa9-41c5-bc14-38a4f984052f
msgctxt "h9b18fc7fgd96eg4c36g8dd5g5d84f018dc01"
msgid ""
"She's out there now - doing her moon magic and what-have-you. Keeps the "
"curse away from the inn."
msgstr "이소벨은 지금 저기 밖에서 달의 마법인가 뭐가 그런 걸 하고 있지. 여관으로 그림자 저주가 다가오지 못하도록 하는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 8b943ae8-bff8-f372-11dc-22af7b7509c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:8b943ae8-bff8-f372-11dc-22af7b7509c8
msgctxt "he5e1b697g22c0g44acg8104ge581871930b6"
msgid "My old friend. Very good to see you again."
msgstr "오랜 친구여. 다시 만나서 정말 반갑군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 8c45e59d-2db7-d0b5-a3e0-f390987215e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:8c45e59d-2db7-d0b5-a3e0-f390987215e6
msgctxt "h6ffaa15bgac2bg4f84g8e25g7e0470542b57"
msgid "Enough games. We have other business here."
msgstr "이만 하지. 다른 할일이 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Narrator
#. NodeID = 8cd88081-9d1b-477c-04b5-9d4da5cdba5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:8cd88081-9d1b-477c-04b5-9d4da5cdba5f
msgctxt "h8e09c931g2185g487eg8417geae59ef33f89"
msgid ""
"*This man takes orders from General Thorm, helping him may be just what you "
"need to gain deeper access to the cult.*"
msgstr "*이 자는 쏨 장군에게 명령을 받고 있고, 교단에 더 깊이 접근하려면 그를 돕는 것이 좋을 수도 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 8f1b0cb5-4093-0931-47ef-ec01c0e38baa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:8f1b0cb5-4093-0931-47ef-ec01c0e38baa
msgctxt "h7c4d642fg626dg4bafgae97g1d515f89a630"
msgid ""
"I suppose General Thorm sent you to help with my mission. That's all right. "
"I don't mind sharing the glory."
msgstr "쏨 장군께서 날 도우라고 널 보낸 것 같은데. 뭐 괜찮아. 공이야 나누면 그만이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = 93892108-b7b2-0e8d-4e20-97c5a65cc7e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:93892108-b7b2-0e8d-4e20-97c5a65cc7e9
msgctxt "hd6e83cc3geab1g4e9cg918bg7612f9c0f9ad"
msgid ""
"You've had the weapon this entire time. You're no True Soul. You're a "
"<i>traitor</i>!"
msgstr "지금까지 내내 그 무기를 갖고 있었군. 넌 참된 영혼이 아니다. <i>배신자</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = 9c84b350-ffcc-e043-5bd0-d864242c274a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:9c84b350-ffcc-e043-5bd0-d864242c274a
msgctxt "h5c43a65bg7e55g4c0egb422g8c600579e4e5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = a1049a56-9594-6231-26de-003e2885ad2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:a1049a56-9594-6231-26de-003e2885ad2f
msgctxt "h6a59c453ga0f1g49d1g8af1g3329b15b6390"
msgid "You'll help me, or you'll stay out of my way."
msgstr "날 도와줄 거 아니면, 내 앞길 막지 말아야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = af08de49-6c09-39dd-7f4e-3b37bc40a29c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:af08de49-6c09-39dd-7f4e-3b37bc40a29c
msgctxt "h0ebf01d2g191eg4cd6gbbf9g0a072c4ef3df"
msgid "I've heard enough - whatever your mission, it ends here."
msgstr "더 들을 것도 없군, 네 임무가 뭐든 간에, 여기서 끝낸다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = b9f9c595-6bca-ec7f-ca06-ae6a5d36fee0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:b9f9c595-6bca-ec7f-ca06-ae6a5d36fee0
msgctxt "h1b2918bcg74adg4388ga090g5935f1f738e9"
msgid "I can take the cleric myself."
msgstr "나 혼자서도 클레릭을 데려갈 수 있을 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = c3def964-08f4-5422-547b-f12c7bff3759
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:c3def964-08f4-5422-547b-f12c7bff3759
msgctxt "h2348d663ga0acg454cgb9c6g326c1b3ba801"
msgid "Sounds like this is your fight, not mine."
msgstr "내가 참견할 싸움이 아닌 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = c3e9a2ca-e912-d37c-37ef-5870042cae59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:c3e9a2ca-e912-d37c-37ef-5870042cae59
msgctxt "h45152f02g324bg4a7eg9798gc55746ac3f97"
msgid "Ruin this mission, and the General will take your head."
msgstr "이번 임무를 망치면, 장군께서 목을 베실 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = cae8408c-0e7a-2935-538d-c1029b4db9ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:cae8408c-0e7a-2935-538d-c1029b4db9ea
msgctxt "h9975236ege0c4g4d20gb9b0gebf58f787d1d"
msgid ""
"So the General got tired of waiting for me to deliver. No matter. I don't "
"mind sharing the glory."
msgstr "그렇다면 장군은 내가 데려오길 기다리다 지쳤단 말이군. 상관없어. 공이야 나눠도 그만이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = d50a1966-6407-076e-2522-f67db02b8ae8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Florrick_State_LeaveForCity = False
#.      - HAV_HavenOutcasts_State_FlamingFistsInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:d50a1966-6407-076e-2522-f67db02b8ae8
msgctxt "h525dbfd7gb89eg4178gb535g17852df19d07"
msgid "What are the Flaming Fist doing here?"
msgstr "플레이밍 피스트가 여기서 뭘 하고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = d74abc53-3989-2d50-a220-6ee2926d7945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:d74abc53-3989-2d50-a220-6ee2926d7945
msgctxt "h27f32a6bgf766g407bgb04bg63eeb10c45da"
msgid ""
"Working with the Counsellor to find their wayward Grand Duke Ravengard. He's "
"been taken to Moonrise Towers."
msgstr "플레이밍 피스트는 자문관을 도와 사라진 레이븐가드 대공을 찾고 있지. 대공은 문라이즈 타워로 잡혀갔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = d974b712-3ab9-e57d-1b61-b9890fa14f19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:d974b712-3ab9-e57d-1b61-b9890fa14f19
msgctxt "h126672b5g207bg40cfg8c83ga7d15ac1f64e"
msgid "For now."
msgstr "지금은 그렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = e1056cad-2285-346c-38e0-753945588a4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:e1056cad-2285-346c-38e0-753945588a4b
msgctxt "h7ca9461dgcb10g4e69g9812g39fd05163fd4"
msgid "Thanks for your help with Jaheira."
msgstr "이번 임무를 도와줘서 고맙군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = e310249d-897a-2819-98c2-9c4657d67bda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:e310249d-897a-2819-98c2-9c4657d67bda
msgctxt "h17b58cc3g5d2cg4d89g8090g821168efe16e"
msgid "The General speaks for the Absolute. And I don't question the Absolute."
msgstr "장군께선 절대자님을 대변하시지. 그리고 난 절대자님께 질문하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = e7fca4c2-16da-ee30-c987-55dffe78fc9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:e7fca4c2-16da-ee30-c987-55dffe78fc9a
msgctxt "h850a0af5g803dg4f38gae4dgdd2241056645"
msgid "It was no ruse. The object protects me from the Absolute's influence."
msgstr "작전 같은 건 아니었어. 이 아티펙트가 절대자의 영향력으로부터 날 지켜주거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = e980c350-e66f-6f2c-9ac0-f6a2973f996e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:e980c350-e66f-6f2c-9ac0-f6a2973f996e
msgctxt "h649dccf6g429bg42a4ga20ag70c4e4eb9e84"
msgid "Thanks for the information. I'll take your guts now."
msgstr "좋은 정보 고맙네. 이제 네 배를 갈라주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = ebd4a764-9be5-24fe-a96c-c09c5f628532
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:ebd4a764-9be5-24fe-a96c-c09c5f628532
msgctxt "h3ace954dgb304g4101g86cegc910eb171f59"
msgid "<i>Show him the truth: the artefact does what you say it does.</i>"
msgstr "<i>진실을 보여줍니다. 아티팩트는 정말로 당신이 말한 대로 작동합니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = f3389666-92bc-22d6-f48b-a296ed75f10c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:f3389666-92bc-22d6-f48b-a296ed75f10c
msgctxt "hc7bc57e8gce65g431dg8614g27b9bfc001e2"
msgid "Are we the only True Souls in this place?"
msgstr "여기 있는 참된 영혼은 우리가 다 인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = f3987a47-94e8-515d-a067-c36c86e59942
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:f3987a47-94e8-515d-a067-c36c86e59942
msgctxt "h2db6d02eg198eg40ebga0d8gedfc6075e13b"
msgid ""
"You're just like the others. While the Absolute wages the war of wars, Her "
"faithful waste time fighting each other."
msgstr "결국 너도 똑같구만. 절대자님께서 이 중요한 전쟁을 치르는 와중에 그분의 추종자들은 서로 싸우며 시간을 낭비하고 있다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = f5d9ee30-2a9d-712e-08d9-7c3c262f3a0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_RevealedArtifact = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:f5d9ee30-2a9d-712e-08d9-7c3c262f3a0b
msgctxt "hbc2a9296g7efag49f9g8422g04596199fd3a"
msgid ""
"<i>Clever ruse showing off your little 'artefact'. Jaheira was all too eager "
"to believe you.</i>"
msgstr "<i>너의 그 ‘아티팩트’를 보여준 건 꽤 영리한 작전이었어. 자헤이라는 그걸 보자마자 널 맹신하더군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Player
#. NodeID = f97affe5-526a-243d-6a7c-0d19c6b28dcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:f97affe5-526a-243d-6a7c-0d19c6b28dcc
msgctxt "hb59be288gad11g4a5fga6eegdc501164e954"
msgid "Failure won't be tolerated."
msgstr "실패는 용납되지 않겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy
#. Speaker = Fist Marcus
#. NodeID = fe035f0d-4868-5eb2-79af-0c481c4f39f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy:fe035f0d-4868-5eb2-79af-0c481c4f39f4
msgctxt "h96b6462cg4cfeg447bgac5ag5f63f524b0ac"
msgid ""
"Isobel's on the balcony - should be nearly done with her prayers. Let's go "
"say hello."
msgstr "이소벨은 발코니에 있어, 이제 슬슬 기도가 끝났을 거다. 인사하러 가볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 07ea6df1-ff3d-4931-80be-b6ec96f94991
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:07ea6df1-ff3d-4931-80be-b6ec96f94991
msgctxt "hd1e0b396gc35dg48f7g8205g1de150f22ef1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = 086bb674-e35a-43a0-8db6-07387ed4a5c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:086bb674-e35a-43a0-8db6-07387ed4a5c7
msgctxt "h1107ef27g8532g4aa0gad52g66b1c1571730"
msgid "*The corpse remains silent. It does not know.*"
msgstr "*시체가 침묵을 유지합니다. 알지 못합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = 1b30bf84-4cce-2e89-6eba-160dedc6070f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:1b30bf84-4cce-2e89-6eba-160dedc6070f
msgctxt "h92914047gdbfbg4c60ga6e3g2f25e28c0867"
msgid "Trusted... me..."
msgstr "날... 믿더군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 2677d3ec-f247-48b6-aa3d-bfe170a833bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_Knows_ImmortalitySource = False
#.      - GLO_Ketheric_Knows_AboutImmortality = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:2677d3ec-f247-48b6-aa3d-bfe170a833bd
msgctxt "h1818c629g832cg4254ga780gc72018725191"
msgid "What's making Ketheric invulnerable?"
msgstr "케서릭을 무적으로 만드는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = 4c301959-921c-b4ee-4eac-25542ae47a39
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_FlamingSpy_Knows_HiddenCorpse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:4c301959-921c-b4ee-4eac-25542ae47a39
msgctxt "hc8d3fb9bg63c6g42c5g9e64g5d3b3d0e7b5c"
msgid "Outside the inn... buried near graveyard... she found out..."
msgstr "여관 밖... 묘지 근처에 묻었다... 그녀가 찾아 낸..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = 5202adfa-8e79-7afc-172b-72e358935487
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_Knows_FlamingFistIsSpy = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:5202adfa-8e79-7afc-172b-72e358935487
msgctxt "h4f79873bg576eg47afg87e7g923daf497fd4"
msgid "How did you come to work for the Absolute?"
msgstr "어쩌다 절대자를 위해 일하게 되었지?"

