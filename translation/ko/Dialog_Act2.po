msgid "<i>Back away from them, palms up.</i>"
msgstr "<i>두 손을 든 채로 그들로부터 물러난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_HarperScouts_ShadowCreatures
#. Speaker = Harper Lassandra
#. NodeID = d5576761-73bc-49e2-2e00-4c4d96d25fa1
