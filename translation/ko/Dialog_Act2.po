msgctxt "hb3ac218ag9b05g48e8g89f9ga1248c7eed85"
msgid "*Sniff.*"
msgstr "*킁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 001fc870-b1b2-4fab-811f-b7996ae6dec0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HasTaggedItem_FOOD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:001fc870-b1b2-4fab-811f-b7996ae6dec0
msgctxt "hb32efe4fgf462g4fa6ga658g13f273d60995"
msgid "I'm a friend - I have some food to share."
msgstr "나는 네 친구야. 너에게 나눠줄 음식도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 05e49ef9-9f37-9ad0-0fa0-870acc38816f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_LoweredDC = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:05e49ef9-9f37-9ad0-0fa0-870acc38816f
msgctxt "h4f08f66dg6461g41dfg80cfg4094aa171da2"
msgid "<i>Snap off your best salute.</i>"
msgstr "<i>당신이 할 수 있는 최고의 경례 자세를 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 076dc757-37ec-aa14-9ac4-224a7e5fc126
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:076dc757-37ec-aa14-9ac4-224a7e5fc126
msgctxt "h31c8c444g8af5g47b3g87bdgad4969288026"
msgid "<i>Give her your best salute.</i>"
msgstr "<i>각 잡힌 자세로 경례한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 09d9cbb9-7666-4262-a5ee-6f90880633bd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:09d9cbb9-7666-4262-a5ee-6f90880633bd
msgctxt "h8935c89cge0abg44f1g8a23gb4a9b95dda51"
msgid "You stumble into trouble like a stray pup. My own litter were the same."
msgstr "무슨 길 잃은 강아지 마냥 사고를 치고 다니는 군. 내 새끼들도 그랬었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 0a06122c-213a-a274-fd55-1cb639c409c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:0a06122c-213a-a274-fd55-1cb639c409c0
msgctxt "h829f21d7gfe6eg42e0g8b20gc62f8560a822"
msgid "I'm sorry."
msgstr "유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 0b893f82-9f67-4884-b629-868dc44b334f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:0b893f82-9f67-4884-b629-868dc44b334f
msgctxt "h1885e706ge58cg4a35gb09cg795f1dfe97b7"
msgid ""
"*The growl only deepens. The hound isn't reassured - or perhaps it is simply "
"taking no chances.*"
msgstr "*으르렁거리는 소리가 더욱 거칠어집니다. 이 사냥개는 경계를 풀지 않습니다. 어쩌면 그냥 방심하지 않는 것일지도 모르죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 0c81316a-ad2c-4d4a-b041-46d3d444a770
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:0c81316a-ad2c-4d4a-b041-46d3d444a770
msgctxt "heb190f1fg4628g4e9fgbfc5g5e0b64b835e6"
msgid "Stand, soldier! These are the General's private quarters."
msgstr "멈춰라, 병사! 여긴 장군님의 사적인 공간이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 15218d46-09fa-484f-9087-06a1dd6c8aba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:15218d46-09fa-484f-9087-06a1dd6c8aba
msgctxt "hc31e60c6g6b9cg4058g962bg8f0dd62585fc"
msgid ""
"*...but it seems the touch is enough, and for a moment the undead beast is "
"just another dog happily wagging its tail.*"
msgstr ""
"*...하지만 작은 손길에도 만족하는 듯 보입니다. 적어도 이 순간 만큼은 이 언데드 짐승도 그저 행복하게 꼬리를 흔드는 한 강아지일 "
"뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 16a57665-17e5-868e-8d20-4ab4d328bd6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:16a57665-17e5-868e-8d20-4ab4d328bd6c
msgctxt "h05844213ga4f8g4e7dgaadbg61822bbb1fde"
msgid "But he brought me back. I will not fail him again."
msgstr "하지만 그분께서 날 되살려 주셨지. 다시는 그분을 실망시키지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 1d34d7fd-a5ea-4ba0-8d15-02614bc4a9e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HasTaggedItem_FOOD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:1d34d7fd-a5ea-4ba0-8d15-02614bc4a9e0
msgctxt "h736ccedag292ag485ega217g3c9f59f6e903"
msgid "<i>Offer up some food from your pack.</i>"
msgstr "<i>당신의 가방에서 음식을 조금 꺼내어 준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 21282ddc-f9c7-c330-35f2-e8e218ee2e30
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_LoweredDC = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:21282ddc-f9c7-c330-35f2-e8e218ee2e30
msgctxt "h30bf4f68g68f7g4fd9g9049g40247f42467d"
msgid "<i>It's a trained army hound - give it your best salute.</i>"
msgstr "<i>훈련된 군견이다. 당신이 할 수 있는 최고의 경례를 표한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 21621036-caa8-4680-8cd6-67de2a3af76a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:21621036-caa8-4680-8cd6-67de2a3af76a
msgctxt "h11ef9f66g4e9dg474ega6f8g3c700885ab1e"
msgid "Easy - I'm leaving."
msgstr "진정해. 난 이만 가볼테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 23ae90da-57c1-3355-377c-0e7ade8bf359
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_GiveOintment = True
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_SmelledBlessing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:23ae90da-57c1-3355-377c-0e7ade8bf359
msgctxt "h6bf85a02g38afg438egb615g48efb0b5b261"
msgid ""
"*And then it hesitates, gleaming muzzle sampling your scent as if in... "
"recognition?*"
msgstr "*그러다가 군견은 잠시 머뭇거리더니 마치... 익숙한 냄새가 난다는 듯이 코를 반짝이며 당신의 체취를 맡기 시작합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 2687175e-1d33-0af0-1a3b-ba90b33a10ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:2687175e-1d33-0af0-1a3b-ba90b33a10ef
msgctxt "h26bb8ef2g4e6eg4fd4g8c50g96ef2e2562e2"
msgid "Your master's beyond saving. I'm here to end him."
msgstr "네 주인은 구원받을 수 없는 지경에 이르렀어. 난 그를 끝장 낼 작정이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 26b7d56f-ea98-4cc2-93f2-75ba26121585
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_LoweredDC = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:26b7d56f-ea98-4cc2-93f2-75ba26121585
msgctxt "h6c39f0a7g976bg495ag8249g33584575023f"
msgid "<i>Lower your eyes - you're no threat.</i>"
msgstr "<i>시선을 낮춘다. 당신은 적이 아니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 27eb219b-4ddf-cf0f-0d3d-08f4d5fb4ef9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_LoweredDC = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:27eb219b-4ddf-cf0f-0d3d-08f4d5fb4ef9
msgctxt "hd0af657dg08ceg4ac7ga05egf1e563b1331a"
msgid "<i>Give the creature a snarl of your own.</i>"
msgstr "<i>이 생명체에게 나만의 으르렁 소리를 들려준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 2f738362-6b73-d971-d98a-907c0215defa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:2f738362-6b73-d971-d98a-907c0215defa
msgctxt "hf64b51c0gfe47g4d61g8526g9ed94b7f98a8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 32babe6a-1ade-7447-de12-39031a87d528
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_KethericHound_Hound_AskedAboutScent(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:32babe6a-1ade-7447-de12-39031a87d528
msgctxt "hdfa624f7ge901g4f3aga7cfg2c2c11b98a18"
msgid "My scent seemed to trigger a memory in you. What was it?"
msgstr "내 냄새를 맡고 뭔가 떠오른 모양이던데, 뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 3365e493-ee05-461d-a6e2-0d0aba5a6996
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_TameSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:3365e493-ee05-461d-a6e2-0d0aba5a6996
msgctxt "h25043f8agfdcbg4ce2g8ddaga6c0ccc3ec85"
msgid "*Smoky, unblinking eyes fix upon you.*"
msgstr "*연기가 나는, 부릅뜬 눈이 당신에게 고정됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 3c91cb08-7851-045d-669b-62d9f44d9233
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:3c91cb08-7851-045d-669b-62d9f44d9233
msgctxt "h3ceb33a1gfb79g4523ga133gc2d20dfcdad5"
msgid "Pass, then. But I will be watching."
msgstr "지나가도록. 하지만 계속 지켜보겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 437937c4-972a-4bcd-1e41-91365778981b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:437937c4-972a-4bcd-1e41-91365778981b
msgctxt "hb41ec25dgb6edg400bg9377g44fdc4695bea"
msgid ""
"*It turns away and utterly ignores you - as it would any lowly foot soldier.*"
msgstr "*군견은 돌아서더니 하급 병사를 대하듯 당신을 완전히 무시합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 4427e7ad-7a2d-44f7-1e4a-5aeede278491
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:4427e7ad-7a2d-44f7-1e4a-5aeede278491
msgctxt "h9b402197g6d10g4dd5gbe59g2593f2279c63"
msgid ""
"Ugh. The General has led many soldiers - and your form is by <i>far</i> the "
"sloppiest."
msgstr "으, 장군님 휘하의 수많은 병사들을 봐왔지만, 너만큼 자세가 <i>빠져있는</i> 녀석은 처음 보는 군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 485f9528-b9eb-47ff-9f15-fd10f4d7903a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:485f9528-b9eb-47ff-9f15-fd10f4d7903a
msgctxt "h0753971dge6b5g451agbd5eg74372d58f568"
msgid "I cannot tell if your stink is lies or stupidity. It doesn't matter."
msgstr "넌 거짓말에 재주가 없는 건지 아님 그냥 멍청한 건지 모르겠군. 아무래도 상관 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 49652938-44c4-2c4a-785c-76bd0776d0af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:49652938-44c4-2c4a-785c-76bd0776d0af
msgctxt "h7c95e021g72c2g4803gbcc8gb13cb0969f89"
msgid ""
"I do not know your face, but your scent... Selûnite magic. It used to fill "
"these halls, back when I was flesh."
msgstr ""
"네 얼굴은 처음이지만 냄새는 익숙해... 셀루네의 마법이로군. 내 뼈에 아직 살점이 붙어 있던 시절에는, 이 냄새가 전당을 가득 채우곤 "
"했었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 49c0ec25-226c-06a9-7585-38119a703f5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:49c0ec25-226c-06a9-7585-38119a703f5c
msgctxt "h4b630293gb48fg4cafgaaa3g5a213e43124d"
msgid ""
"*Suspicious, the creature leans in for another sniff - and for a moment, its "
"tail wags as if remembering a scent from long ago.*"
msgstr "*군견은 의심스러운 표정으로 한 번 더 냄새를 맡으려 몸을 숙이더니, 잠시 후 오래전 냄새를 기억한 듯 꼬리를 흔듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 4d34fa25-f254-c881-bef9-80100d84a16d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:4d34fa25-f254-c881-bef9-80100d84a16d
msgctxt "h44778e4egcf6eg4c63gb38fgd174f7d9aca1"
msgid ""
"Your scent is familiar to me, stranger - but I can still smell the lies "
"underneath."
msgstr "이방인, 네 냄새는 익숙하지만 - 그게 네 거짓말의 악취까지 숨기지는 못 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 55bbdbed-a86d-34f6-a376-a50c5eb5aaaf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_KethericHound_Hound_AskedAboutScent(1) = False
#.   Global:
#.      - MOO_KethericHound_State_SmelledBlessing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:55bbdbed-a86d-34f6-a376-a50c5eb5aaaf
msgctxt "hf3a7c225gb76dg494ag9fc6gd5aa05507255"
msgid "You seemed to know my scent. How?"
msgstr "제 냄새를 아시는 것 같더군요. 어째서죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 56e5baea-a383-481b-a9d2-bd91236910a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMANOID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:56e5baea-a383-481b-a9d2-bd91236910a2
msgctxt "h07509c50g18a9g4c45g8172g3523132ddfc0"
msgid "Would it be all right if I gave you a scratch?"
msgstr "등 좀 긁어드려도 괜찮겠습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 5a2acbf7-8d93-44ce-bce6-d37fb5e61a7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:5a2acbf7-8d93-44ce-bce6-d37fb5e61a7e
msgctxt "h31cc1143ge407g4db2g9887g19705c7ce312"
msgid ""
"But they are long dead, now. Mind where you stray, lest I send you to join "
"them."
msgstr "지금은 죽은 지 오래긴 하지만. 정신 똑바로 차리고 다니라고, 안 그러면 똑같은 신세로 만들어 줄 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 5c7d3d12-34e1-4d29-adc1-e36dbb13744b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:5c7d3d12-34e1-4d29-adc1-e36dbb13744b
msgctxt "hd1cc20f8g28c5g4eefg85f0g7458966864b9"
msgid "Leave."
msgstr "떠난다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 5d0def51-d553-9beb-69d4-b0e70bd37c15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:5d0def51-d553-9beb-69d4-b0e70bd37c15
msgctxt "h39771f12gd56bg4f2eg972eg76d97e89644c"
msgid ""
"Though whichever whelp owns that thing smells... happy. Safe. I have not "
"scented such a thing since I was flesh."
msgstr "그 공을 가지고 놀던 놈이 누군지는 모르겠지만... 행복하고, 안전한 냄새가 나는 군. 이런 냄새를 맡아본 건 참 오랜만이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 5fcdaadf-29b1-43d1-df51-cafd1b919ddb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TakingIsobel_State_HasSeluneOintment(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_SmelledBlessing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:5fcdaadf-29b1-43d1-df51-cafd1b919ddb
msgctxt "h8be74e18g02b9g403eg897bg8d53b6e51371"
msgid "<i>Stay still and let it sniff you.</i>"
msgstr "<i>가만히 서서 당신의 냄새를 맡게 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 5ffec326-014e-db60-d9b0-4626ed03d04f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:5ffec326-014e-db60-d9b0-4626ed03d04f
msgctxt "h56145f87g18e8g4a6cga7dag542d92906198"
msgid "*The dog relaxes, as if reassured by your observance of protocol.*"
msgstr "*군견은 당신의 규정 준수에 만족한다는 듯이 자세를 편안하게 풉니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 645155a8-57c8-ae5d-d071-548c454cd247
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:645155a8-57c8-ae5d-d071-548c454cd247
msgctxt "h73b029edg2df1g4e86gb5c3gc517d5e8fd88"
msgid "Just be about your task then - whatever it is."
msgstr "무슨 명령을 받았는 진 몰라도, 할 일에 집중하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 66d67cbf-5efc-ad66-7d4b-b64694bcb24a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:66d67cbf-5efc-ad66-7d4b-b64694bcb24a
msgctxt "ha41603d1gf828g482dgae47g134d01b03044"
msgid "I protect my master. What becomes of <i>his </i>master, I care not."
msgstr "난 내 주인님을 섬길 뿐. <i>그분의</i> 주인이 어찌 되는 지 따위는 내 알 바 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 6b865767-4808-3326-8879-16a5ddc33309
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:6b865767-4808-3326-8879-16a5ddc33309
msgctxt "hdec5622egea40g488eg82fagc4a27dd2c69f"
msgid ""
"I... died the same night she did, my master says. Trying to protect her. I "
"do not remember."
msgstr "주인님이 말씀하시기를.. 내가 그녀와 같은 밤에 죽었다 그랬어. 그녀를 지키다가 말이야. 자세한 기억이 안 나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 6bb6f8e7-89f6-425e-9e86-9071f180b4be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:6bb6f8e7-89f6-425e-9e86-9071f180b4be
msgctxt "h2a221258g89b8g46f2g8e87g7c6f7d9192b1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 6d243da2-e058-184d-3617-2cd9aa9392f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_Intimidated = True
#.      - MOO_KethericHound_State_TameSuccess = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:6d243da2-e058-184d-3617-2cd9aa9392f4
msgctxt "ha2255908gd40ag4ab0g9524gb241d3f57c0f"
msgid "I let you pass. Do not make me change my mind."
msgstr "통행을 허가해주지. 내 마음 바뀔 일 만들지 말도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 822296a1-ec5b-2c4d-0514-8107e365cffe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_GiveOintment = True
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_SmelledBlessing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:822296a1-ec5b-2c4d-0514-8107e365cffe
msgctxt "hf8033fc0g7cfdg4a8fgab54g635348d2c7ca"
msgid "...Wait. Something in your scent is... familiar."
msgstr "...잠깐. 너한테서 나는 냄새가 아주... 친숙한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 82493957-16ee-fc2b-b0fc-a0f490827bac
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_LoweredDC = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:82493957-16ee-fc2b-b0fc-a0f490827bac
msgctxt "h84fc0333g3565g49a6gb358g0609be1db9a2"
msgid "<i>Snarl at the beast's display of weakness.</i>"
msgstr "<i>이 짐승이 방심한 틈을 노려 그를 향해 울부짖는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 8721550f-e40d-4f24-9a07-9441bf5e5c7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:8721550f-e40d-4f24-9a07-9441bf5e5c7b
msgctxt "h921e80d6g647dg4b08gb2efgbfadd3674610"
msgid ""
"*Even stripped of flesh, the war-hound is formidable. Spectral eyes meet "
"yours as it growls a challenge.*"
msgstr ""
"*살이 벗겨진 상태에도 이 군견은 무시무시한 자태를 뽐냅니다. 군견은 싸우려는 듯 으르렁거리며 유령의 눈빛을 당신의 눈과 마주칩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 884fde5d-979c-457e-8532-e613c96f7d2d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_KethericHound_Event_GiveFood(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:884fde5d-979c-457e-8532-e613c96f7d2d
msgctxt "h07d6c5b6g1e98g4c38gb7d8gb84a92cac6d1"
msgid ""
"I've had no stomach to fill for some time. But you will find my teeth are "
"still sharp, stranger."
msgstr ""
"나에게 굶주림을 채울 배는 없어진 지 오래됐지. 하지만 내 이빨은 여전히 <b>날카롭다는 걸</b> 알게 될 거다, 이 수상한 녀석아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 8aac0d07-5aa2-802d-456a-250f4d1b5b63
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_HostileAfterTame = True
#.     - MOO_KethericHound_State_Intimidated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:8aac0d07-5aa2-802d-456a-250f4d1b5b63
msgctxt "hcf36f324gd0feg4ea4gbbd3gfec5a5775099"
msgid ""
"*This is not a creature easily cowed, but something in your display gives it "
"pause.*"
msgstr "*이 군견이 쉽게 겁을 먹는 생명체는 아니지만 당신 안에서 나온 무언가가 그를 멈칫하게 했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = 8bd48bad-857e-2360-3a65-00bfffa211cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:8bd48bad-857e-2360-3a65-00bfffa211cf
msgctxt "h881faed5g5da6g4202g818cgeb76fad558be"
msgid "*The growl withers to a whimper, and the hound turns away, sheepish.*"
msgstr "*으르렁거리는 소리가 낑낑대는 소리로 변하였고 사냥개는 순한 양처럼 돌아섭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = 8d70e5e0-9889-8d23-9a2e-502b785578c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:8d70e5e0-9889-8d23-9a2e-502b785578c5
msgctxt "h76bbeb37g00b9g4fc9gb6cegb1ec71c2af98"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = 93059ada-d3bc-fa5b-b8af-5134e8246fe9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_KethericHound_Hound_AskedAboutScent(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:93059ada-d3bc-fa5b-b8af-5134e8246fe9
msgctxt "h3f2f84bfg97a4g4d4bgaf96g8340992faf22"
msgid "My scent seemed to trigger a memory in you. What was it?"
msgstr "내 냄새를 맡고 뭔가 떠오른 모양이던데, 뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = a2a2bb9f-7155-8cb4-7c07-22539245b3af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TakingIsobel_State_HasSeluneOintment(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_SmelledBlessing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:a2a2bb9f-7155-8cb4-7c07-22539245b3af
msgctxt "h2184eb57gdfb4g48cag9cd7g532105ecd319"
msgid "<i>Stay still and let her smell you.</i>"
msgstr "<i>가만히 서서 냄새를 맡게 해준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = a48fd86b-855f-3716-f6fa-e162dc0daf0e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:a48fd86b-855f-3716-f6fa-e162dc0daf0e
msgctxt "h2c794337g90c5g40dbg9b3bg48f8cae2b588"
msgid "To serve Ketheric - as loyally as you do."
msgstr "너처럼 충성스럽게 케서릭 님을 섬기려는 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = abc1abdc-ee37-e594-52d7-a09af1a78d8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:abc1abdc-ee37-e594-52d7-a09af1a78d8b
msgctxt "hbb85c051gd62bg46b7gba07gf082d41eadd4"
msgid "Do you take me for a teething pup? Get that out of my face."
msgstr "내가 무슨 강아지인 줄 아나? 당장 저리 치워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = b1acf7b9-1629-63ac-7e5f-0a00eb858f95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:b1acf7b9-1629-63ac-7e5f-0a00eb858f95
msgctxt "h8664d5ccgda21g4a8cg85cbgd0ebaf95be59"
msgid ""
"Since my master brought me back... this place smells wrong. His family is "
"gone, replaced by bootlickers and beasts."
msgstr ""
"내 주인님께서 날 되살려 내신 이후로... 이 장소는 악취가 진동하기 시작했어. 그분의 가족들도 사라져 버렸고, 대신 아첨꾼과 짐승들 "
"따위가 그 자리를 대신 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = b41a3537-b517-fa3b-707b-c8d01b0e3fd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:b41a3537-b517-fa3b-707b-c8d01b0e3fd8
msgctxt "hbf4e25d4g1450g49adg93cfg02136f493c57"
msgid "To make sure your master dies. Screaming, preferably."
msgstr "네 주인의 숨통을 끊어 놓을 작정이지. 비명도 질러줬으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = b5dfacf0-3ebb-472c-af63-ebb15271ae53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:b5dfacf0-3ebb-472c-af63-ebb15271ae53
msgctxt "h1f312c67g5971g48bbg89a1gb14613cbbc0a"
msgid "You'd be the first of the General's soldiers brave enough to try."
msgstr "장군님의 병사 중 그걸 시도할 만큼 용감한 건 자네가 처음인 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = b7c0a606-fc13-554e-5227-71d67031bf60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_Intimidated = True
#.      - MOO_KethericHound_State_TameSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:b7c0a606-fc13-554e-5227-71d67031bf60
msgctxt "hd0bd7cc9ga4a8g43e5g89a8g9f4aa8b3f5b3"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = bb461d3c-e2ef-edcd-2539-996497eef182
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:bb461d3c-e2ef-edcd-2539-996497eef182
msgctxt "h5423e363g2e6fg4147ga5dagd0808591dfa1"
msgid ""
"There will be no screams from you, stranger - not when I take your throat."
msgstr "내가 네 숨통을 끊어 놓을 때는 - 어떤 비명도 울려 퍼지지 않을 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = bccd3690-10c0-5d4d-bd2f-59a00723e2d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:bccd3690-10c0-5d4d-bd2f-59a00723e2d6
msgctxt "h71c0aa83g6a66g4a04g968egd94340b35af3"
msgid ""
"No! He may have changed, but he is still my master. I cannot let you pass."
msgstr "절대 안 돼! 그분이 변하시긴 했지만, 그래도 여전히 내 주인님이야. 널 좌시할 수는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = bef08da8-24cf-450f-9c59-ed3a10122c27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:bef08da8-24cf-450f-9c59-ed3a10122c27
msgctxt "h821fd01cg0d23g4924g96f4g94f4ea6fc38a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = bf545575-38c1-e68e-cf8d-d8beffda83c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_LoweredDC = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:bf545575-38c1-e68e-cf8d-d8beffda83c5
msgctxt "h1f5a3d2cgda36g4a19gabd0ga7c4a4ec41fc"
msgid ""
"*Then the beast shakes its head, a ferocious war-hound once more. Though "
"perhaps not <i>quite</i> as ferocious as before.*"
msgstr ""
"*그러다가 이 맹수는 고개를 크게 흔들더니 다시 한번 사나운 군견의 모습이 됩니다. 그래도 어쩌면 <i>이전만큼</i> 사납지는 않은 것 "
"같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = c17b20cb-de20-13c0-1031-43dfbfe1a4f4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_LoweredDC = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:c17b20cb-de20-13c0-1031-43dfbfe1a4f4
msgctxt "hf9e4db05g313cg4182g9a33ga812d32efb72"
msgid "<i>Lower your eyes in respect.</i>"
msgstr "<i>존경을 담아 시선을 낮춘다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = c1a11e24-f573-b76c-46e3-df2f547fb87c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:c1a11e24-f573-b76c-46e3-df2f547fb87c
msgctxt "hf7030d67gbcc3g469dga42fg105092e93e66"
msgid "Hm. Hmmm... All right, that's enough."
msgstr "흠. 흐음... 좋아, 그만하면 됐다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = c1a12819-9dc6-4988-b38b-ce0fecb86532
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:c1a12819-9dc6-4988-b38b-ce0fecb86532
msgctxt "hef995caegb94eg4b6cga679g7844d7e277ed"
msgid ""
"*The hound relaxes, clearly accustomed to this show of deference within its "
"master's chamber.*"
msgstr "*사냥개는 경계를 풉니다. 분명히 이 군견은 주인의 방 안에서 이런 경의의 표시가 익숙한 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = c1c5399c-b3da-1452-b3ca-08943de00489
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:c1c5399c-b3da-1452-b3ca-08943de00489
msgctxt "ha42ce492gdf43g4963gb18fg3c825aee9608"
msgid ""
"*Perhaps your form was sloppy. Or perhaps the creature simply wants to taste "
"your blood.*"
msgstr "*어쩌면 당신의 경례 자세가 엉성했나 봅니다. 아니면 이 생명체가 단순히 당신의 피를 맛보고 싶은 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = c9149b12-8bfe-6791-70c9-bd3c62b1d167
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_KethericHound_State_HasScratchBall(1) = True
#.   Tag:
#.      - HUMANOID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:c9149b12-8bfe-6791-70c9-bd3c62b1d167
msgctxt "hf7877619g880fg4bf4g9065g4b13c1220420"
msgid "<i>Show her Scratch's ball.</i>"
msgstr "<i>스크래치의 공을 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = c9e3b090-2873-49b6-aac5-518351de51b9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:c9e3b090-2873-49b6-aac5-518351de51b9
msgctxt "h317ef752ge689g4018gb7a0g73845e51a20b"
msgid "I'm just exploring the tower. I mean no harm."
msgstr "그냥 탑을 돌아다니던 것뿐이야. 해칠 생각은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = ccfb48e5-33e7-54c4-ef33-4f2eb541d4df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:ccfb48e5-33e7-54c4-ef33-4f2eb541d4df
msgctxt "h3e1f941egcaeag480cg8075gb5df076b3d7f"
msgid "I only want to stop the Absolute."
msgstr "그저 절대자를 막고 싶은 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = d180e1d8-2d50-3bef-d0fc-bcfc068bf62e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:d180e1d8-2d50-3bef-d0fc-bcfc068bf62e
msgctxt "hb8cf3d03gcfd9g4c56g9d80g46e1492fa359"
msgid "You are neither. So tell me true - what is your purpose here?"
msgstr "근데 넌 둘 다 아닌 것 같군. 솔직히 말해 - 네 목적이 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = d576fedd-daf5-2b6e-4105-8f61cb157de3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_Intimidated = True
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:d576fedd-daf5-2b6e-4105-8f61cb157de3
msgctxt "h1012d351gaae3g4163ga078gba439554e25e"
msgid ""
"...Hmph. Walk carefully, then. Or I will learn exactly what True Soul tastes "
"like."
msgstr "...흥. 그럼 조심해서 돌아다니라고. 안 그러면 내 다음 식단에는 참된 영혼이 올라올 테니 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = d6870f17-a9f5-9909-e79b-caa9ff345552
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:d6870f17-a9f5-9909-e79b-caa9ff345552
msgctxt "h2efd4a39gb76fg4a66gbdbeg08a312bd20f2"
msgid ""
"*Warily, it watches you approach. There's no flesh or fur to scratch at, "
"only bone and cold metal...*"
msgstr "*조심스럽게, 개는 당신이 다가오는 것을 지켜봅니다. 긁을 살점이나 털은 없고, 오직 뼈와 차가운 금속만이 있습니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = d728783f-3389-3f17-e2ce-432fc349813d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:d728783f-3389-3f17-e2ce-432fc349813d
msgctxt "h6609bc10g7baeg4362gbfdfg61d56e8ba707"
msgid ""
"...I do not know which army you fight for, but it is <i>not</i> my master's."
msgstr "...네놈이 어느 부대 소속인지는 몰라도, 내 주인님의 부하는 <i>아닌 게</i> 분명하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = d92c7d15-6c8c-613e-2b63-e3fe7f573669
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_SmelledBlessing = True
#. SetFlags:
#.   Global:
#.     - MOO_KethericHound_State_TameSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:d92c7d15-6c8c-613e-2b63-e3fe7f573669
msgctxt "hf97c1a96gca03g4c47gaa43ga633a294cc7c"
msgid ""
"Good. Death itself cannot release you from that duty. Now be about your "
"business, whatever it is."
msgstr "좋은 대답이로군. 죽음조차도 충성의 의무를 끝내지는 못 하지. 무슨 일인지는 몰라도, 하던 거 마저 하도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = d96b53da-e6dd-740e-d48b-16ed343b986b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:d96b53da-e6dd-740e-d48b-16ed343b986b
msgctxt "h9f7fb7d7g543ag46afg8cf1g4ba5c80364b5"
msgid ""
"*Scratch's scent lies heavy on the toy - the scent of play, comfort, safety. "
"For a moment, the skeletal tail twitches.*"
msgstr ""
"*스크래치의 냄새가 장난감에 짙게 배 있습니다. 안전하고 편안하며 놀이의 추억이 담긴 냄새입니다. 잠깐이지만 뼈밖에 남지 않는 꼬리가 "
"씰룩거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = dab65619-cd2c-46cf-a955-993942aa7502
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:dab65619-cd2c-46cf-a955-993942aa7502
msgctxt "h9dfbd03eg4948g4852gb8a5g22787d80640d"
msgid "No. You are not."
msgstr "응. 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = daca1c6a-5f85-6046-36dd-eaf8fba3df01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:daca1c6a-5f85-6046-36dd-eaf8fba3df01
msgctxt "hbffd68efg3b99g4a5cgbbf7g36611df53d7e"
msgid ""
"Not <i>your</i> scent - Selûnite magic on your skin. The General once "
"smelled that way, when his daughter still lived."
msgstr ""
"<i>네</i> 냄새가 아니라 네 살갗에 묻은 셀루네의 마법 때문이야. 한때 장군님의 자녀가 살아 있을 적에, 장군님께서도 같은 냄새가 "
"났거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Narrator
#. NodeID = dd72abeb-d2dd-2bd8-82df-d81fb84a817e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_KethericHound_Event_GiveFood(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:dd72abeb-d2dd-2bd8-82df-d81fb84a817e
msgctxt "hf9468ca9g2c58g4b27g85cfg476d4ac703dc"
msgid ""
"*The dog's growl only deepens, echoing in the cavity where its stomach used "
"to be.*"
msgstr "*군견의 으르렁거리는 소리가 더욱 거칠어지며 원래 배가 있어야 했던 구멍에서 울려 퍼집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = dea1198f-8651-9a44-aed9-7ad03e77c91e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_SmelledBlessing = False
#.   Object:
#.      - MOO_KethericHound_State_HasScratchBall(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:dea1198f-8651-9a44-aed9-7ad03e77c91e
msgctxt "h0752e93cg7daag45fbg9268g32e39a6c940a"
msgid "<i>Wave Scratch's ball.</i>"
msgstr "<i>스크래치의 공을 이리저리 흔든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = edd87d09-c189-5093-c39d-12e6660873f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:edd87d09-c189-5093-c39d-12e6660873f3
msgctxt "h847b67e8gd1b9g4027gb44ag52bb1b9e1f4c"
msgid "You will not walk out again."
msgstr "다시는 걸어나가지 못하게 해주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = f3c08d17-8271-4e61-911a-c58d9432f930
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:f3c08d17-8271-4e61-911a-c58d9432f930
msgctxt "hb9f6b9b4g2682g46cagb164g4923fded821b"
msgid "<i>Gently reach out to pet the hound.</i>"
msgstr "<i>조심스럽게 손을 뻗어 군견을 쓰다듬는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Squire
#. NodeID = f4c8375a-8f31-4386-8b51-660e2c96e647
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_KethericHound_State_TameSuccess = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:f4c8375a-8f31-4386-8b51-660e2c96e647
msgctxt "h73aba07fgb0dcg4028gbfceg7210174a6410"
msgid "Yes, soldier?"
msgstr "왜 그러지, 병사?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = f6a7c720-75b4-3227-67c1-1941b0b244c4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:f6a7c720-75b4-3227-67c1-1941b0b244c4
msgctxt "hd21b8fd9ge9abg465fg85e0g858b8b73f908"
msgid "Down, lapdog. A True Soul walks where they please."
msgstr "얌전히 있어, 애완견. 참된 영혼인 이 몸께서 원하는 대로 드나들 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA
#. Speaker = Player
#. NodeID = f79a6f65-3698-459b-f909-6fe095adeab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_Hound_SwA:f79a6f65-3698-459b-f909-6fe095adeab3
msgctxt "hee71cc2fga8c5g4c5cga149g044d8278e141"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericRoom_AD_Minthara_EnteredKethericRoom
#. Speaker = Nightwarden Minthara
#. NodeID = 393cf092-05ff-9521-91ce-995eddcfef57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericRoom_AD_Minthara_EnteredKethericRoom:393cf092-05ff-9521-91ce-995eddcfef57
msgctxt "h37acc453g3943g44abg8b6ag28e58f5d0052"
msgid ""
"This is where the great General Thorm rests his bones? We should ransack it."
msgstr "여기가 위대한 쏨 장군이 뼈를 뉘는 곳이라고? 샅샅이 뒤져보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Ketheric_PAD_AstarionsComment
#. Speaker = Astarion
#. NodeID = 63276c67-fed9-196d-60f1-ffd20aead95f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Ketheric_PAD_AstarionsComment:63276c67-fed9-196d-60f1-ffd20aead95f
msgctxt "hcd3f7d64g7bd0g4543gbaa9g604a2deb277a"
msgid "<i>Finally</i>. Time to see the one controlling these parasites."
msgstr "<i>드디어</i>. 이 기생충을 조종하는 놈을 볼 시간이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Ketheric_PAD_AstarionsComment
#. Speaker = Astarion
#. NodeID = f7e9bb7a-65f8-60f4-7670-90cdb62dad68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Ketheric_PAD_AstarionsComment:f7e9bb7a-65f8-60f4-7670-90cdb62dad68
msgctxt "hb559b94bga701g48aag99b1g2f2862c9fcb9"
msgid "Maybe they can be controlled just as easily."
msgstr "어쩌면 놈들도 쉽게 조종할 수 있을지 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote
#. Speaker = Player
#. NodeID = bc1364fc-72d3-4358-97d6-3d382dcafa18
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote:bc1364fc-72d3-4358-97d6-3d382dcafa18
msgctxt "he4a4d0fbg7b37g4badgbff9g8a6d02a683a8"
msgid ""
"Why that's almost beautiful. Imagine what she'd think if she saw him now."
msgstr "정말이지 아름다운 내용이로군. 지금 케서릭의 모습을 본다면 어떤 생각이 들지 궁금한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote
#. Speaker = Player
#. NodeID = bc1364fc-72d3-4358-97d6-3d382dcafa18
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote:bc1364fc-72d3-4358-97d6-3d382dcafa18
msgctxt "hcf51f67bgb508g4266g979fg6de4df432490"
msgid ""
"It seemed Thorm's wife loved him deeply. Perhaps he was even a good man "
"once..."
msgstr "쏨의 부인은 그를 가슴 깊이 사랑했나봐. 그도 한때는 좋은 사람이었을지도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote
#. Speaker = Player
#. NodeID = bc1364fc-72d3-4358-97d6-3d382dcafa18
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote:bc1364fc-72d3-4358-97d6-3d382dcafa18
#, fuzzy
#| msgid ""
#| "Melania. Ketheric's wife. She loved him - before he sold himself to the "
#| "Absolute."
msgctxt "h295b5b72g2ef3g4f6ega137gc6c932898d6d"
msgid ""
"Melodia. Ketheric's wife. She loved him - before he sold himself to the "
"Absolute."
msgstr "멜라니아. 케서릭의 아내. 그를 사랑했군. 절대자에게 영혼을 팔기 전 얘기겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote
#. Speaker = Player
#. NodeID = bc1364fc-72d3-4358-97d6-3d382dcafa18
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote:bc1364fc-72d3-4358-97d6-3d382dcafa18
msgctxt "h3ad51da5g5acag44aagbc1eg5553cbdca0b0"
msgid "Bah - what use is love, when wasted on a husk like Ketheric Thorm?"
msgstr "사랑도 케서릭 쏨 같은 쓰레기에게 낭비돼서야 무슨 쓸모가 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote
#. Speaker = Player
#. NodeID = bc1364fc-72d3-4358-97d6-3d382dcafa18
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote:bc1364fc-72d3-4358-97d6-3d382dcafa18
msgctxt "hb1c35ff5g0739g4e5dgaeb4g0a0e920e7125"
msgid ""
"Seems like Ketheric's wife loved him very deeply. No accounting for taste."
msgstr "케서릭의 부인은 그를 매우 사랑했나보군. 하긴 각자 취향이 있으니까.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote
#. Speaker = Player
#. NodeID = bc1364fc-72d3-4358-97d6-3d382dcafa18
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote:bc1364fc-72d3-4358-97d6-3d382dcafa18
msgctxt "he0caf57fg633ag4855ga822g3cd4d3e45b51"
msgid "Ketheric's wife was clearly fond of him. How far he's fallen..."
msgstr "케서릭의 부인은 확실히 그에게 애정이 있었군. 대체 어디까지 타락한 걸까..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote
#. Speaker = Player
#. NodeID = bc1364fc-72d3-4358-97d6-3d382dcafa18
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericsChambers_PAD_ReadWifesNote:bc1364fc-72d3-4358-97d6-3d382dcafa18
msgctxt "h0fb63a19g04c9g47bagaddbg3e18cc7f7241"
msgid "A letter from Ketheric's wife. Sounds like she loved him very much."
msgstr "케서릭의 부인이 쓴 편지야. 남편을 매우 사랑했었나 보군.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kethetic_DaisyAD_AttackImmortal
#. Speaker = GROUP_Daisy
#. NodeID = efa22675-b8a2-4492-8ec6-a6f76af294fd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kethetic_DaisyAD_AttackImmortal:efa22675-b8a2-4492-8ec6-a6f76af294fd
msgctxt "he2493b71g0c4eg4f5egb3f5gb107d5cec5a3"
msgid ""
"He cannot die - we must find what gives him his invulnerability before we "
"strike!"
msgstr "그는 죽지 않아. 공격하기에 앞서 그 불사의 힘이 어디서 오는 지 알아내야만 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kethetic_DaisyAD_AttackImmortal
#. Speaker = GROUP_Daisy
#. NodeID = efa22675-b8a2-4492-8ec6-a6f76af294fd
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kethetic_DaisyAD_AttackImmortal:efa22675-b8a2-4492-8ec6-a6f76af294fd
msgctxt "h28d358b0g5b93g4cedgb73fg86205299d478"
msgid ""
"He cannot die - we must find what gives him his invulnerability before we "
"strike!"
msgstr "그는 죽지 않아. 공격하기에 앞서 그 불사의 힘이 어디서 오는 지 알아내야만 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kethetic_DaisyAD_AttackImmortalRepeated
#. Speaker = GROUP_Daisy
#. NodeID = b9cb1978-0f06-4172-9e80-fa92b391f763
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kethetic_DaisyAD_AttackImmortalRepeated:b9cb1978-0f06-4172-9e80-fa92b391f763
msgctxt "h619ed26fg39e2g4710g86f1gc734a12d4f9c"
msgid "It won't work - not until we find out what is keeping him from death!"
msgstr "소용 없어. 그가 죽음에 이르지 않게 막는 힘이 뭔지 알아내야만 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kethetic_DaisyAD_AttackImmortalRepeated
#. Speaker = GROUP_Daisy
