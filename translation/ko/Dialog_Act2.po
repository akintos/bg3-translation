msgctxt "hee856a87gdb49g4713g990ag0a3de38afdc9"
msgid "Cell Three"
msgstr "수감실 3"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Prison_AD_CellPlaque4
#. Speaker = Narrator
#. NodeID = a1ca77f7-dacc-4fb9-ad38-c24847aa312f
