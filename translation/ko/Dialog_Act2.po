#.   Local:
#.      - f4169abb-abdc-be87-1a9d-91387440472c_A = True
#. SetFlags:
#.   Local:
#.     - f4169abb-abdc-be87-1a9d-91387440472c_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon:e45abfa8-d26d-9024-01ca-273392aa1dbc
msgctxt "hb83016b0g178dg4c98gb76dg0447e0f13f8b"
msgid "Would that the sisters' incisions were soothing as mine."
msgstr "자매들의 절개가 나만큼 부드러웠더라면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon
#. Speaker = Malus Thorm
#. NodeID = e8d929a5-6068-4045-b5f3-771f47f05183
