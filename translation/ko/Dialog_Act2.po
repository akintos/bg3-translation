#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:85f185b6-4c4a-516d-5276-b49235b14906
msgctxt "h6d314411ga8c9g4295g8464gef9a4cb831a3"
msgid "Hold them off - I'll take care of the chains."
msgstr "시간 좀 끌어줘, 내가 사슬을 풀게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 8f5f56e2-365e-403f-853f-f1af29159124
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADGoingToBoat(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADGoingToBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:8f5f56e2-365e-403f-853f-f1af29159124
msgctxt "h04fa7f1cg088cg4d8agbf58g2d9134fcd460"
msgid "A boat! Let's grab it and get out of here."
msgstr "배다! 저걸 타고 여기서 나가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 9f252b4f-0c87-20cc-fe65-9a239a440591
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4951b7ce-8495-b2c8-badc-beaff0e3d807_A = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_B = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:9f252b4f-0c87-20cc-fe65-9a239a440591
msgctxt "h08894211gb24bg4575g9b96g13a47063744b"
msgid "Come on - <i>come on.</i>"
msgstr "제발, <i>제발 좀.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = b72b3568-d063-4ca9-8535-66187d71bcf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADGuardsReaction(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADGuardsReaction(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:b72b3568-d063-4ca9-8535-66187d71bcf5
msgctxt "h129b4a9cg0195g477egb7e1gf59418752d2c"
msgid "Damn it - keep them away from the boat!"
msgstr "젠장, 저놈들 배에서 떨어뜨려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = c3ec3209-fbc7-c3d3-b958-0135a96b853c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4951b7ce-8495-b2c8-badc-beaff0e3d807_D = True
