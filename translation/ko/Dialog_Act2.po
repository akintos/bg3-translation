#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:d02a10cb-7440-8e2e-7dfe-493edf6a3a41
msgctxt "h67ee7239g50dag4b90g8b18gf75cb9a69db0"
msgid "Where can I find this 'Little Kitty'?"
msgstr "'작은 고양이'는 어디서 찾을 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = e06f39f3-b08b-9d88-9b8b-68af6b6992f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:e06f39f3-b08b-9d88-9b8b-68af6b6992f0
msgctxt "h1cadee4ag0220g49afgbd3ag33fda28faee6"
msgid "Yes. Yes. <i>Please.</i>"
msgstr "좋다. 좋다. <i>제발.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = e347727a-4f2a-4d5c-a752-1fb438d463bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_Kitchen_Butcher_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - COL_Kitchen_Butcher_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:e347727a-4f2a-4d5c-a752-1fb438d463bd
msgctxt "ha5bf2adagb37dg4d0fg9630gb7271faa3afa"
msgid "..."
msgstr "..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = e7919336-4814-2d62-4aac-f90447db6cb5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:e7919336-4814-2d62-4aac-f90447db6cb5
msgctxt "h0c12061fg8f9fg44b3ga2eagd2665f437935"
msgid "Kill? Cut? Chop?"
msgstr "죽일까? 자를까? 썰을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = ea5e587b-8a1a-f329-55d8-34ee53ffa9ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:ea5e587b-8a1a-f329-55d8-34ee53ffa9ee
msgctxt "h7dded9b3g995eg492bg9e9dgb91cfe07b9f3"
msgid "<i>Bad</i> kitty. Sings wrong song. Must-fix."
msgstr "<i>나쁜</i> 고양이. 틀린 노래 부른다. 무조건 고쳐야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = eca5d906-5f66-c28c-95b4-b114b51ee2ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_State_UsInColony = True
#.      - COL_Morgue_State_UsFreed = False
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:eca5d906-5f66-c28c-95b4-b114b51ee2ed
msgctxt "ha856e650gb6bbg44ecg9a96g8d7212bb249f"
msgid "Same. Song. As you?"
msgstr "같다. 부른다. 너처럼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = eff9c688-c894-04c4-e24e-683a47645cc5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:eff9c688-c894-04c4-e24e-683a47645cc5
msgctxt "h09e205a7g5f19g441bgb7c1gbf67677b3ce4"
msgid "No. No. Must-fix. MUST-FIX!"
msgstr "안된다. 안된다. 무조건 고친다. <b>무조건 고친다!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = f0089f27-200b-dc02-ad8d-e8bc35fb5cce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:f0089f27-200b-dc02-ad8d-e8bc35fb5cce
msgctxt "h83920481g53f4g43f6g98acg5b8b56890c57"
msgid "OTHER. WRONG SONG!"
msgstr "<b>다르다. 틀린 노래!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Chop
#. NodeID = f4634a5b-bbf9-aa66-7694-ec0667db6cf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:f4634a5b-bbf9-aa66-7694-ec0667db6cf9
msgctxt "had33e753g9d1cg43abg987dg5b19de7d869e"
msgid "Locked. Up. <i>Bad</i> kitty. Thinks it is. <i>Other.</i>"
msgstr "갇혀있다. <i>나쁜</i> 고양이. 다른 고양이들과. <i>다르다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher
#. Speaker = Player
#. NodeID = fadf275c-4cd1-8283-d918-b5e4bb3548ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_Butcher_State_MentionedUs = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Kitchen_Butcher:fadf275c-4cd1-8283-d918-b5e4bb3548ae
msgctxt "h10740403g73e4g4456g8f96gf7f37b7397f5"
msgid "Let it come with me. We sing the same song."
msgstr "고양이를 데리고 갈 수 있게 해 줘. 우리는 똑같은 노래를 부르거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_AD_ButcherReadsManuscript
#. Speaker = Chop
#. NodeID = 0ea80621-fbc3-ab20-03b4-ba531e9ff037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_AD_ButcherReadsManuscript:0ea80621-fbc3-ab20-03b4-ba531e9ff037
msgctxt "h2972e94ag8899g44ceg8e14gc898cbb34b86"
msgid "Hm?"
msgstr "흠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 0c27e80a-5e86-3bd0-a952-e94879c8a0e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:0c27e80a-5e86-3bd0-a952-e94879c8a0e1
msgctxt "h45dc2398g203ag478egb0c8gbec595ead9f9"
msgid ""
"Mind flayer script, but I can read it perfectly. Another benefit from the "
"lodger in my skull, I suppose."
msgstr "마인드 플레이어가 쓴 글이지만 완벽히 읽히는군. 참나, 머리에 세입자를 잘 둔 덕인가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 0c27e80a-5e86-3bd0-a952-e94879c8a0e1
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:0c27e80a-5e86-3bd0-a952-e94879c8a0e1
msgctxt "hd8287bfegda55g46cfg8a20g9bfbdfde6912"
msgid "I can read <i>ghaik</i> script. Is this the tadpole's doing?"
msgstr "<i>게이크</i>의 글을 읽을 수 있군. 올챙이의 영향인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 0c27e80a-5e86-3bd0-a952-e94879c8a0e1
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:0c27e80a-5e86-3bd0-a952-e94879c8a0e1
msgctxt "hd510c8e3ge980g493dga213g376cbda1a434"
msgid ""
"Mind flayer script. I shouldn't be able to understand it... and yet I do? "
"Kudos to the tadpole, I suppose."
msgstr "마인드 플레이어가 쓴 글이야. 원래는 못 읽는 게 당연한데... 읽히네? 올챙이에게 칭찬을 해줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 0c27e80a-5e86-3bd0-a952-e94879c8a0e1
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:0c27e80a-5e86-3bd0-a952-e94879c8a0e1
msgctxt "h0e344367g818cg407cg9254g88d8842a0c8f"
msgid ""
"Mind flayer script - and it makes sense. Must be the tadpole acting as "
"translator."
msgstr "마인드 플레이어가 쓴 글인데, 무슨 내용인지 읽히는군. 올챙이가 번역기 역할을 하나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 0c27e80a-5e86-3bd0-a952-e94879c8a0e1
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:0c27e80a-5e86-3bd0-a952-e94879c8a0e1
msgctxt "hb92bcdebg2c5bg46f3g96cfgaa50d6ee4b44"
msgid ""
"Illithid symbols. My brain bug must be literate, as I can read them too."
msgstr "일리시드의 문자야. 나도 읽고 이해하는 거 보면, 머릿속 벌레 친구가 문해력이 좋은가 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 0c27e80a-5e86-3bd0-a952-e94879c8a0e1
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:0c27e80a-5e86-3bd0-a952-e94879c8a0e1
msgctxt "h1eab63ecg8299g4fb9ga6f4g748e32ae2763"
msgid "Funny. I can read this mind flayer script. Thanks, I guess, tadpole?"
msgstr "웃기네. 마인드 플레이어가 쓴 글이 읽혀. 참 고맙다, 올챙아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 0c27e80a-5e86-3bd0-a952-e94879c8a0e1
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:0c27e80a-5e86-3bd0-a952-e94879c8a0e1
msgctxt "h99a85aebg2f07g499cgb652gb458ec6071c3"
msgid "Seems I can understand illithid script. Thank you, tadpole."
msgstr "일리시드 문자가 읽히는데. 아주 감사합니다, 올챙이 씨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 204e4ff2-ee12-7b29-0ba5-0543bc6d2277
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:204e4ff2-ee12-7b29-0ba5-0543bc6d2277
msgctxt "h99f721bfgc1e7g4144g84f9gf1a3c3d90204"
msgid ""
"I've never seen these symbols before. So how in the hells can I understand "
"them?"
msgstr "이런 글자는 살면서 본적 없는데. 도대체 어떻게 이딴 글자 읽고 이해할 수 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 204e4ff2-ee12-7b29-0ba5-0543bc6d2277
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:204e4ff2-ee12-7b29-0ba5-0543bc6d2277
msgctxt "h8102facaga273g4d22g90d3gb840625b1e7c"
msgid "I've never seen symbols like this. But I still know them. <i>How?</i>"
msgstr "이런 글자는 본 적이 없을 텐데. 어째서 이해할 수 있는 거지. <i>어째서?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 204e4ff2-ee12-7b29-0ba5-0543bc6d2277
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:204e4ff2-ee12-7b29-0ba5-0543bc6d2277
msgctxt "hcd511200ga5f6g4f2bg8a08g0ef0fe7b64d7"
msgid ""
"This is gibberish... and yet somehow I understand it? Odd. Decidedly odd."
msgstr "모르는 말인데도... 어떻게든 이해가 가는데? 이상해. 확실히 이상해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 204e4ff2-ee12-7b29-0ba5-0543bc6d2277
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:204e4ff2-ee12-7b29-0ba5-0543bc6d2277
msgctxt "h8765da1fg0044g45begb868g2c93d39cc1c0"
msgid "This language is just gibberish... and yet strangely familiar also?"
msgstr "이해할 수 없는 말인데... 이상하게 친숙하네?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 204e4ff2-ee12-7b29-0ba5-0543bc6d2277
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:204e4ff2-ee12-7b29-0ba5-0543bc6d2277
msgctxt "h86d1780bgb407g47b2g97c6gca18b5bfb796"
msgid "This script is... familiar, somehow. If only I could make sense of it."
msgstr "이 글은... 왜 그런지 모르겠지만, 친숙하게 느껴져. 이해할 수만 있다면 좋을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 204e4ff2-ee12-7b29-0ba5-0543bc6d2277
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:204e4ff2-ee12-7b29-0ba5-0543bc6d2277
msgctxt "h67dd9c03g5ceag426eg84e3g6f04c637a3f4"
msgid "Don't know what's being said... but I think I can read this. Almost."
msgstr "뭐라는지 알 수가 없는걸... 근데, 거의 읽을 수 있긴 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 204e4ff2-ee12-7b29-0ba5-0543bc6d2277
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:204e4ff2-ee12-7b29-0ba5-0543bc6d2277
msgctxt "h0adb121fg11b3g45f4g8f21g3cd563a8b0fd"
msgid "These symbols are nonsense to me... so why can I read them?"
msgstr "이 글자들은 이해할 수가 없는데... 이걸 왜 읽을 수 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 3526f6f7-8547-9a67-7561-cd22b7d0218e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess_NonTadpoled = False
#.   Tag:
#.      - ILLITHID(0) = False
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:3526f6f7-8547-9a67-7561-cd22b7d0218e
msgctxt "hc3656677gd31dg4a01gbd9ag1b157badda80"
msgid ""
"Illithid writings - they might as well daub their tentacles in paint, for "
"all I can understand."
msgstr "일리시드가 쓴 글이야. 이해할 수 있는 건 놈들이 촉수로 물감을 칠했다는 것뿐이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 3526f6f7-8547-9a67-7561-cd22b7d0218e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MemoryLibrary_Manuscripts_ArcanaCheckSuccess_NonTadpoled = False
#.   Tag:
#.      - ILLITHID(0) = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts:3526f6f7-8547-9a67-7561-cd22b7d0218e
msgctxt "hf2e6dbb1g3e12g48b6g81ecg56f0ec37f1a9"
msgid "Perhaps someone knows what this means - but not me."
msgstr "아마 누군가는 읽을 수 있겠지만, 나는 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 3526f6f7-8547-9a67-7561-cd22b7d0218e
