#.     - 6966767e-f588-332a-5d7c-2c7917320c7b_C = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_IntellectDevourer_Interaction:bda9a530-d060-4af7-985a-bd97a89b0ce9
msgctxt "hf2803581ge044g4bf9gbfa2gb9a5eddb7320"
msgid "Must save, must protect!"
msgstr "구해야 해, 지켜야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_MidFight
#. Speaker = The Emperor
#. NodeID = 5754cf29-987f-4f53-bce2-d86b04602b28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_MidFight:5754cf29-987f-4f53-bce2-d86b04602b28
msgctxt "h80e5cb62gfbddg4376gb870g201be84c53c4"
msgid ""
"<i>I will not fight you. I am your <b>ally</b>. Cooperate with me, or lose "
"EVERYTHING.</i>"
msgstr "<i>자네와 싸울 생각은 없네. 난 그대의 <b>편</b>이라네. 내게 협력하게나 아니면 모든 것을 잃을 테니.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_MidFight
#. Speaker = The Emperor
#. NodeID = 5754cf29-987f-4f53-bce2-d86b04602b28
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_MidFight:5754cf29-987f-4f53-bce2-d86b04602b28
msgctxt "he6b106e4g21c6g4730gbc5fg698a7c3faec5"
msgid "<i>The guards are your enemy, not I. <b>I am on your side. </b></i>"
msgstr "<i>내가 아니라 친위대가 자네의 적일세. <b>난 자네의 편이라네. </b> </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat
#. Speaker = Prelate Lir'i'c
#. NodeID = 4252733f-1cff-466d-9816-f346b193e67d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_A = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat:4252733f-1cff-466d-9816-f346b193e67d
msgctxt "h47a9b569g9c10g47f1ga7ffg9581e41a35a2"
msgid "For Orpheus. <i>Htak'a!</i>"
msgstr "오르페우스를 위하여, <i>흐타카!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat
#. Speaker = Prelate Lir'i'c
#. NodeID = 4595ac3a-bfdb-455b-9128-14c8421078b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_A = True
#. SetFlags:
#.   Local:
#.     - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_B = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat:4595ac3a-bfdb-455b-9128-14c8421078b4
msgctxt "h60785875g8194g4f44gba95g018eecdd9569"
msgid "<i>Hta'lak k'rith ma'har!</i>"
msgstr "<i>흐탈락! 크리스 마하르!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat
#. Speaker = Prelate Lir'i'c
#. NodeID = 6caa40c8-c463-49ff-aecd-27d34aac1359
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_C = True
#. SetFlags:
#.   Local:
#.     - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_A = False
#.     - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_B = False
#.     - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_C = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat:6caa40c8-c463-49ff-aecd-27d34aac1359
msgctxt "h3ccac6cdgd51bg4d46gae43g915ff22deeb9"
msgid "<i>Htak'a!</i>"
msgstr "<i>하타카!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat
#. Speaker = Prelate Lir'i'c
#. NodeID = 9830e68b-2582-4fcd-abc9-fd0b03512d7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_B = True
#. SetFlags:
#.   Local:
#.     - 2a40d461-dd95-cfd5-d300-5ba88684a2a1_C = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_ReturnToAPCombat:9830e68b-2582-4fcd-abc9-fd0b03512d7f
msgctxt "h1275e28ega73eg4bf5ga6bfg6567c201dec6"
msgid "In the name of Gith!"
msgstr "기스의 이름으로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 01835c7f-967b-a280-8efb-7d018f79ad32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:01835c7f-967b-a280-8efb-7d018f79ad32
msgctxt "h4d8432a8gb7ccg4ccagbb1dg5584cabb2622"
msgid "<i>Alone, Orpheus will be much easier to control.</i>"
msgstr "<i>오르페우스 혼자라면 훨씬 제어하기가 쉽지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Gale
#. NodeID = 02f439f4-dda2-6a48-52c0-86868baded74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:02f439f4-dda2-6a48-52c0-86868baded74
msgctxt "h47c36d48g41beg4f5dga2a9gb48a4e42a734"
msgid "A fine idea. Or at least, an idea."
msgstr "좋은 생각이야. 적어도, 그냥 생각."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 0363f148-0c84-29b2-3320-b4c832b80314
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:0363f148-0c84-29b2-3320-b4c832b80314
msgctxt "h485d1442ga661g43ecg9392g73af2ae0c65c"
msgid ""
"<i>The moment I found it, I felt a change. My free will returning. I "
"followed the feeling inside -</i>"
msgstr "<i>이걸 찾은 순간, 변화를 느꼈다. 내 자유를 되찾을 수 있다는 느낌. 나는 내면의 느낌을 쫓아갔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 057e2181-9b3f-2309-face-da91f599ffab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:057e2181-9b3f-2309-face-da91f599ffab
msgctxt "h7b7a49c9g9a88g4dafg9cb1gf84f90970758"
msgid "<i>You continue to surprise me. </i>"
msgstr "<i>계속해서 날 놀라게 하는군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 06a874ce-69d4-a48b-9b7d-557abe512c5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:06a874ce-69d4-a48b-9b7d-557abe512c5a
msgctxt "h1219f3bdg25fag4853gb8fagd685e13b02ad"
msgid "<i>You absolute horror! </i>"
msgstr "<i>이런 혐오스러운 놈!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Jaheira
#. NodeID = 06c7bb8c-099a-9ac4-bc04-acfd85c321c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_JAHEIRA(10) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:06c7bb8c-099a-9ac4-bc04-acfd85c321c5
msgctxt "h0eac5adegc6d1g4941g95bcg1010447bb2da"
msgid "Take care. Illithids evolve nothing - they only enslave."
msgstr "조심해. 일리시드는 진화하는 게 아니라, 노예가 되는 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 06e0d682-5c63-f7e4-ed63-7cbecae8f232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:06e0d682-5c63-f7e4-ed63-7cbecae8f232
msgctxt "hcc2b4d4egeafag4a8fg9d0eg527b5a6cd510"
msgid ""
"<i>She kept him this way because she was reluctant to eradicate such power, "
"power that she might one day wish to take from him.</i>"
msgstr ""
"<i>블라키스가 오르페우스를 살려둔 이유는 이런 힘을 완전히 없애버리고 싶지 않았기 때문이다. 언젠가 그로부터 뽑아낼 수도 있을 "
"힘을.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 097ba943-cb12-0ddc-1a80-425ae922031a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_AstralPrison_State_SpokeWithDaisy = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:097ba943-cb12-0ddc-1a80-425ae922031a
msgctxt "h61c93f95g466dg43cdg9d1dg7dddd9706877"
msgid "Why did you deceive me all this time?"
msgstr "여태까지 날 속인 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 09eddb49-52a3-f47d-12ca-ddd94c5a1842
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_IsOnOrpheusPath = False
#.   Local:
#.      - f840b590-dc13-d3df-e03c-e58611d62e86_Finished = False
#. SetFlags:
#.   Local:
#.     - f840b590-dc13-d3df-e03c-e58611d62e86_Finished = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:09eddb49-52a3-f47d-12ca-ddd94c5a1842
msgctxt "h084ce822gfa1dg432egb21bg2a5048bfb3dc"
msgid ""
"<i>If the rest of your people ever find out what she has done, there will be "
"civil war. Your 'queen' will be finished.</i>"
msgstr "<i>블라키스가 저지른 일을 네 민족이 알게 된다면 내전이 일어날 것이고, 네 '여왕'은 끝장날 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 09eddb49-52a3-f47d-12ca-ddd94c5a1842
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_IsOnOrpheusPath = False
#.   Local:
#.      - f840b590-dc13-d3df-e03c-e58611d62e86_Finished = False
#. SetFlags:
#.   Local:
#.     - f840b590-dc13-d3df-e03c-e58611d62e86_Finished = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:09eddb49-52a3-f47d-12ca-ddd94c5a1842
msgctxt "h0a0980a6gd9f4g4e94gb6deg0397cdacbb4d"
msgid ""
"<i>If the githyanki ever find out what she has done, there will be civil "
"war. Vlaakith will be finished. </i>"
msgstr "<i>블라키스가 저지른 일을 기스양키들이 알게 된다면 내전이 일어날 것이고, 블라키스는 끝장날 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Halsin
#. NodeID = 0a5f7a57-45ce-36f5-87bd-f9c07cb7522d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(9) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:0a5f7a57-45ce-36f5-87bd-f9c07cb7522d
msgctxt "h8446f8bag5912g4550ga4c1gc9e4ecc8e879"
msgid ""
"Are you sure of this course? It is not one that can be reversed, I fear."
msgstr "이 길이 확실한가? 되돌아 올 수 없는 길이네. 우려스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 0a70114f-50ec-bbf3-8eee-7c0e6210265c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:0a70114f-50ec-bbf3-8eee-7c0e6210265c
msgctxt "h7cbc345agd0eag472ag8b3bg6fc0d2d05140"
msgid ""
"<i>I am relieved you have embraced your potential enough that you could help "
"me eliminate them.</i>"
msgstr "<i>놈들을 제거하기에 충분한 잠재력을 수용하고 나를 도왔다는 사실에 비로소 마음이 놓이는군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 0bd1c7d1-2218-1b31-cc8e-484dc721b978
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:0bd1c7d1-2218-1b31-cc8e-484dc721b978
msgctxt "h9a9ac0e0g0444g47f5g999ag0c4bff667fae"
msgid ""
"<i>Gortash sent me on a mission to retrieve the Astral Prism. I was one of "
"many, but the first to find it. </i>"
msgstr "<i>고타쉬가 아스트랄 프리즘을 되찾으라는 임무를 내렸다. 다른 여럿이 있었지만, 내가 가장 먼저 찾아냈지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 0cbd0313-7503-aaa1-4dbf-19b68b79a7f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:0cbd0313-7503-aaa1-4dbf-19b68b79a7f0
msgctxt "h42c01bc6g55afg4110gb2c6g0caf7b259fa8"
msgid "On reflection, I've changed my mind. Please don't evolve me."
msgstr "생각해봤는데, 마음을 바꿨어. 진화시키지 말아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 0f9d1e31-4f85-6477-e48b-1442e49fd371
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DAISY_DESIRETRACK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:0f9d1e31-4f85-6477-e48b-1442e49fd371
msgctxt "h06dd769egfff6g4fecg8274gefa9bab80d43"
msgid "<i>Your mind is - truly - something special. </i>"
msgstr "<i>네 정신은. 정말로. 특별하다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 100080a2-1f67-374a-79ef-00b8826d7a30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f840b590-dc13-d3df-e03c-e58611d62e86_LaezelInclusion2 = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:100080a2-1f67-374a-79ef-00b8826d7a30
msgctxt "h6491f129g027eg4f50gafc6ge13c3c122249"
msgid ""
"<i>There may come a time when that is necessary, but there is no guarantee "
"that his power would survive his passing. The risk is too great. </i>"
msgstr ""
"<i>언젠가는 그럴 필요가 있을지도 모르겠지만 이 자가 죽은 후에도 힘이 남아있으리라는 보장이 없다네. 너무 위험한 도박일세.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 1205483f-88d0-428e-65b5-f062399a291c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#.      - INT_EmperorRevealed_KnowsAboutBattle(1) = False
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1205483f-88d0-428e-65b5-f062399a291c
msgctxt "h47623f52gebaeg4694gb301g6436125e4dd2"
msgid "Lord Gortash was one of the Chosen in the colony..."
msgstr "고타쉬 경은 군락에 있던 선택받은 자 중 하나였는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 132b0b84-4c0c-fe1a-ba5e-6137365c31b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_FirstDaisyDream_AskedWhoAreYou(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:132b0b84-4c0c-fe1a-ba5e-6137365c31b8
msgctxt "h757289d7gde0cg474egb560g1c6bf3b35d0e"
msgid "<i>I was someone once. Someone just like you. </i>"
msgstr "<i>나도 한때는 누군가였다. 너와 똑같은 누군가.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 144930f3-9710-742b-405a-15f84fc78b12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:144930f3-9710-742b-405a-15f84fc78b12
msgctxt "hd9026b88gc3dbg49fcg8ffegd9c454834eb7"
msgid "<i>Not all mind flayers are alike.</i>"
msgstr "<i>모든 마인드 플레이어가 똑같진 않다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 1493679b-8e5a-a65f-56eb-9f1ca8b931e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Daisy_State_RejectedPartialIllithidTransformation(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1493679b-8e5a-a65f-56eb-9f1ca8b931e7
msgctxt "h062e7e34gfbe6g4043g9f53ga2f2cc57f771"
msgid ""
"*A wave of disappointment, stronger than any you've ever felt, and then - "
"stillness. You have resisted your illithid instincts. For now.*"
msgstr "*지금껏 경험했던 것보다 훨씬 강렬한 실망의 파도가 몰려오더니, 조용해집니다. 지금 당장은 일리시드 본능을 저항해냈습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 15fd24f6-eb59-fd20-3240-a86d4167fe4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DAISY_FEARTRACK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:15fd24f6-eb59-fd20-3240-a86d4167fe4f
msgctxt "h3417ee8fgd815g4d01g8f75g436e7bf88405"
msgid "<i>Well aren't you clever?</i>"
msgstr "<i>그래 정말 영리하군?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 165eea94-60d8-43c5-825a-10cc665c7ce0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:165eea94-60d8-43c5-825a-10cc665c7ce0
msgctxt "h11a70187g9baeg49d3g94aeg60209a949e0c"
msgid "Why do you say that?"
msgstr "왜 그런 말을 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 1670cbd6-5cc4-002d-269f-e47cf982d5de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1670cbd6-5cc4-002d-269f-e47cf982d5de
msgctxt "h68a927a3g5dfdg4171ga196g4910a38a7cd0"
msgid ""
"<i>Perhaps you will change your mind again when you see more of what our "
"enemy can do. </i>"
msgstr "<i>네 적들이 뭘 할 수 있는지 보게 되면 네 마음을 바꾸게 될 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 174f4547-fa0a-9f47-a342-f26d5dc4b732
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:174f4547-fa0a-9f47-a342-f26d5dc4b732
msgctxt "hb82e7fcag8ee7g41b3ga328gfb912d457b57"
msgid "<i>I shall look forward to sharing his downfall with you.</i>"
msgstr "<i>그의 몰락을 너와 함께 지켜보길 기대하겠다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 186ad6e6-6575-4fe3-ba73-f02ce11e5a61
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:186ad6e6-6575-4fe3-ba73-f02ce11e5a61
msgctxt "h09bce434gc380g4abdg9e03gb03e4797581b"
msgid ""
"<i>It is the same power that enabled his mother Gith to bring about the fall "
"of the Illithid Empire aeons ago, a power she passed on to him, and that I "
"leveraged for <b>you</b>.</i>"
msgstr ""
"<i>영겁의 시간 전에 그의 어머니가 일리시드 제국을 몰락시키게 해준 그 힘. 그녀가 그에게 물려주었고. 나는 <b>네게</b> "
"가져왔지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 186ad6e6-6575-4fe3-ba73-f02ce11e5a61
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:186ad6e6-6575-4fe3-ba73-f02ce11e5a61
msgctxt "hd0a7186dge411g4bbcg817fg03a0f56a815d"
msgid ""
"<i>It is the same power that enabled Orpheus' mother to bring about the fall "
"of the Illithid Empire aeons ago, a power she passed on to him, and that I "
"leveraged for <b>you</b>.</i>"
msgstr ""
"<i>영겁의 시간 전에 오르페우스의 어머니가 일리시드 제국을 몰락시키게 해준 그 힘. 그녀가 그에게 물려주었고. 나는 <b>네게</b> "
"가져왔지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 19adbbcb-c41d-5bec-5dc4-77f21b2d35f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:19adbbcb-c41d-5bec-5dc4-77f21b2d35f8
msgctxt "h268c240ag2376g43bdg9cc0g1bbad7b8ec2d"
msgid "<i>Thank you. That was too close. </i>"
msgstr "<i>고맙다. 아슬아슬했군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 1c971311-596b-8833-5199-05070556477a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1c971311-596b-8833-5199-05070556477a
msgctxt "heed255e4g5566g478cg8974ga167679da091"
msgid ""
"<i>It wants to evolve, but it cannot do so alone. It must commune with "
"another.</i>"
msgstr "<i>이건 진화하고 싶어 하지만, 혼자서는 못한다. 다른 개체와 협력해야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 1cbc4b65-3de9-4469-a35f-d9416ccdeefd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1cbc4b65-3de9-4469-a35f-d9416ccdeefd
msgctxt "h3fca7e5cg655bg4411gb236gfc293545e1c9"
msgid ""
"<i>Some of your people still revere him, in defiance of their teachings. "
"Vlaakith was safe as long as you believed him dead. But as you can see, he "
"is very much alive. </i>"
msgstr ""
"<i>네 민족 중 일부는 여전히 받은 가르침에 저항하고 그를 숭배한다. 블라키스에겐 그가 죽었다고 여겨지는 편이 안전하겠지. 그렇지만, "
"여기에 멀쩡히 살아있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 1cbc4b65-3de9-4469-a35f-d9416ccdeefd
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1cbc4b65-3de9-4469-a35f-d9416ccdeefd
msgctxt "hf0aeafa2ge851g40c3gad26g8efb8cb9a67b"
msgid ""
"<i>Some githyanki still revere him, in defiance of their teachings. Vlaakith "
"was safe as long as they believed him to be dead. But as you can see, he is "
"very much alive. </i>"
msgstr ""
"<i>기스양키들 중 일부는 여전히 받은 가르침에 저항하고 그를 숭배한다. 블라키스에겐 그가 죽었다고 여겨지는 편이 안전하겠지. 그렇지만, "
"여기에 멀쩡히 살아있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Astarion
#. NodeID = 1cfdf35a-8f03-48cb-b9ec-b7864007590e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1cfdf35a-8f03-48cb-b9ec-b7864007590e
msgctxt "h8394b7ecg165bg4070ga199gc886cb2f8a6a"
msgid "I owe everything to that? Oh I don't like this one bit."
msgstr "내가 저 것에 모든 걸 빚졌다고? 좀 싫은 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 1dc41d4c-ef5a-7243-a895-a9fc55e16103
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1dc41d4c-ef5a-7243-a895-a9fc55e16103
msgctxt "h4d7497degb06ag4b57g95dbg965b95c8247c"
msgid "<i>So - do you wish to evolve or not? </i>"
msgstr "<i>이제, 진화하고 싶은가?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 1e4647af-ce33-ac84-b3ce-1a0372d2c2e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1e4647af-ce33-ac84-b3ce-1a0372d2c2e4
msgctxt "hdc2676bbg3922g46c3g9775gb53512dd97ad"
msgid ""
"<i>Any advantage I could gain by restoring my original appearance, I already "
"had to hand in the form of magic, and that humanoid shape you've come to "
"know. </i>"
msgstr ""
"<i>내가 원래의 모습일 때 가지고 있었던 유일한 이점은 마법을 통해 손에 넣을 수 있었다. 네가 알던 인간형 모습 말이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 1e92a774-6774-ee52-a29c-2bb158e2d3dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:1e92a774-6774-ee52-a29c-2bb158e2d3dc
msgctxt "h6723e150g25d4g4c63gb892gb7a8bd07d605"
msgid ""
"<i>I sustained myself on criminals. Unglamorous, but there were plenty of "
"them, rarely missed, and they fuelled me while I did my work.</i>"
msgstr "<i>나는 범죄자들로 허기를 채웠다. 평범했지만, 수가 많았고, 잡기도 쉬운 데다, 내 일을 하면서 섭취할 수 있었지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Karlach
#. NodeID = 220b32cb-13e1-a8a3-47ec-bb3fcbe43856
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(8) = True
#.      - TADPOLE_REFUSAL(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:220b32cb-13e1-a8a3-47ec-bb3fcbe43856
msgctxt "haea90be7g6f48g4f23g97b2g25f8084f14df"
msgid ""
"Don't do it! This isn't evolution, it's... it's... I don't know what it is."
msgstr "하지 마! 이건 진화가 아니라, 이건... 이건... 이게 뭔지 잘 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 2274f3d5-35e2-55b8-fb3a-f02f7b33d31b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:2274f3d5-35e2-55b8-fb3a-f02f7b33d31b
msgctxt "he2fcec92g3f5dg4e8fgbaeag4f6f30177a64"
msgid "I'm no illithid, and never will be."
msgstr "난 일리시드가 아니야. 앞으로도 그럴 일은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 23abbc97-7888-bb8f-a036-51c10ad5808b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = False
#. SetFlags:
#.   Dialog:
#.     - INT_EmperorRevealed_KnowsAboutPrism(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:23abbc97-7888-bb8f-a036-51c10ad5808b
msgctxt "h13629fe2g971dg46fcgb2a0g83325c6f591c"
msgid "Were you imprisoned here too?"
msgstr "너도 여기에 감금돼 있던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 245d5f59-22ba-d8ed-0563-772aeb595ac2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:245d5f59-22ba-d8ed-0563-772aeb595ac2
msgctxt "h56f589b6g0a4ag4f39gafcdgf77907559dd2"
msgid ""
"*Even though he is subdued, you feel Orpheus' revulsion - a pulsing hatred "
"that cannot be contained. The Emperor is telling the truth. To him, you are "
"just another wretched illithid.*"
msgstr ""
"*제압되었음에도, 오르페우스의 혐오감을 느낄 수 있습니다. 참을 수 없이 고동치는 증오. 황제는 사실을 말하고 있습니다. 그에게 당신은 "
"그저 끔찍한 일리시드일 뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = 24dc87c9-0846-8493-ffc3-6af7ac1d30ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:24dc87c9-0846-8493-ffc3-6af7ac1d30ad
msgctxt "h006068c4gd8afg4ff6g84d7ged454b0da81d"
msgid "<i>Tsk'va! </i>Whatever this <i>ghaik</i> offers is no gift to you."
msgstr "<i>츠크바!</i> 이 <i>게이크</i>가 제안한 게 무엇이든지 선물은 아닐 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 251f2c66-d0d5-9bb6-87b0-b5eb9d259a72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:251f2c66-d0d5-9bb6-87b0-b5eb9d259a72
msgctxt "hbbd91ce2g0504g4609gb20egf9c4931dce9f"
msgid ""
"*Orpheus - Gith's son, the so-called 'traitor prince', slain by Kith'rak "
"Voss himself millennia ago. Or so you believed.*"
msgstr "*오르페우스. 기스의 아들이자, '반역자 왕자'라 불리고, 키스락 보스에 의해 천년 전에 살해당했다. 고 믿고 있었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 253783b1-d0b9-4f02-8a5d-ebd9caab022a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:253783b1-d0b9-4f02-8a5d-ebd9caab022a
msgctxt "hcb9bfc9dgaf9dg4567g9b5eg54c140fad20c"
msgid "I changed my mind. I don't want to do that right now."
msgstr "마음을 바꿨어. 지금은 그러고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 26d041de-0a37-a687-7506-2aa665ffee50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:26d041de-0a37-a687-7506-2aa665ffee50
msgctxt "h988a89daga557g4e51g8621gf816c34882ee"
msgid ""
"<i>Vlaakith wanted his power. He refused. And so she sealed him within this "
"Prism. His honour guard, ever loyal, followed him in.</i>"
msgstr ""
"<i>블라키스는 그의 힘을 원했지만, 오르페우스는 거부했다. 그 결과 자신의 충성스러운 친위대와 함께 이 프리즘 안에 봉인됐지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 2b2e826d-06dc-a69e-260e-649e8cc0afe5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:2b2e826d-06dc-a69e-260e-649e8cc0afe5
msgctxt "h361bcc9dg2387g415eg8607g1f8827ced86f"
msgid ""
"<i>I had the good fortune to meet Duke Stelmane. We formed a partnership, "
"and through her I became the governing force behind the Knights of the "
"Shield, the largest mercantile operation in Baldur's Gate. </i>"
msgstr ""
"<i>운 좋게도 공작 스텔메인을 만났다. 우린 협력관계를 맺었지. 그녀를 통해 난 발더스 게이트에서 가장 큰 상인 조직인 나이츠 오브 더 "
"실드를 이끄는 존재가 되었다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 2c429158-f096-a628-9f3d-a0cee6432ba7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Daisy_State_RejectedPartialIllithidTransformation(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:2c429158-f096-a628-9f3d-a0cee6432ba7
msgctxt "h671f289eg310bg4b30g88a2g608aacc913a2"
msgid ""
"<i>I understand. Let us hope, then, that your present self will be "
"sufficient to deal with three gods of death and a giant, magically enhanced "
"elder brain.</i>"
msgstr ""
"<i>알겠다. 그러면 지금의 너 자신만으로도 세 죽음의 신과, 마법으로 향상된 거대한 엘더 브레인을 처리할 수 있길 바라지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 2c535f9e-d316-1010-1624-a5bde0a4877f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Wisdom
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - TADPOLE_ASSIGNED(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:2c535f9e-d316-1010-1624-a5bde0a4877f
msgctxt "h95dcd0d4g5a42g40f6gbd26g47d9b78815d3"
msgid "No, I won't do it."
msgstr "아니, 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 2c9356df-a037-4cef-2e23-15ae3cf731eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:2c9356df-a037-4cef-2e23-15ae3cf731eb
msgctxt "h9ed2bacag6c0fg4a62gb14bg7cc5c8aacb1c"
msgid ""
"<i>You are already more illithid than you realise - it has improved you. </i>"
msgstr "<i>너는 네가 생각하는 것보단 더 일리시드다. 너를 개선시키고 있지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 2f035800-04ae-bafa-123b-0331681027d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:2f035800-04ae-bafa-123b-0331681027d7
msgctxt "h97de8307g451bg4f02gbcdfgcb83292c2fd9"
msgid ""
"<i>He tore me from my home and brought me back to the brain where I became a "
"slave once again. A slave he continued to call the Emperor. </i>"
msgstr ""
"<i>그는 날 집에서 끌어내어 엘더 브레인 앞으로 끌고 가서 다시 한번 노예가 되게 했다. 노예임에도 계속 황제라고 불렀다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 3029f18a-3ebc-e045-c88e-aee183bd1ab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3029f18a-3ebc-e045-c88e-aee183bd1ab1
msgctxt "hc02ce4eag2d0bg4ba1gb8c7gbda7e601a934"
msgid "We're alike in other ways too."
msgstr "우리가 서로 같은 점은 그 외에도 많지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 30e2961a-2766-b8aa-95f1-be9c527bdc6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:30e2961a-2766-b8aa-95f1-be9c527bdc6b
msgctxt "hafe70c87g2680g4d68gb53agc1bf74e13b80"
msgid "<i>A history writ by whose hand?</i>"
msgstr "<i>누구에 의해 쓰여진 역사인가?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 310f7831-c90c-d866-be57-19614d4cecdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:310f7831-c90c-d866-be57-19614d4cecdd
msgctxt "hcaef627bg8ca3g4d61g8e59g894666dbf442"
msgid ""
"<i>While my body was within the Prism's bounds, my mind was free. I could "
"resist the elder brain, the Chosen. Better yet, I could plan to overthrow "
"them.</i>"
msgstr ""
"<i>내 육체가 이 프리즘의 경계 안에 있는 한, 내 정신은 자유롭다. 엘더 브레인, 선택받은 자에게 저항할 수 있게 됐지. 더 나아가, "
"그들을 타도할 계획도 세웠다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Wyll
#. NodeID = 31d426e5-57c0-f6bd-1625-f0888e4f4ea7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:31d426e5-57c0-f6bd-1625-f0888e4f4ea7
msgctxt "ha1b1d835g5436g4b2ega6b2gbe94582b5133"
msgid "Well chosen. An accursed advantage - but an advantage all the same."
msgstr "잘 선택했어. 저주받은 이득이지만, 이득은 이득이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 330a9601-99be-d664-c56b-9335554dc235
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f840b590-dc13-d3df-e03c-e58611d62e86_LaezelInclusion2 = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:330a9601-99be-d664-c56b-9335554dc235
msgctxt "h919a73c3g3705g4199gb4cbg68211f368f5e"
msgid "<i>That would be a terrible idea. </i>"
msgstr "<i>그건 정말 안 좋은 생각이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 33990071-ac31-b085-46d3-e0e1036249a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:33990071-ac31-b085-46d3-e0e1036249a9
msgctxt "h6a955d92g73eeg4856gbdaagbc963952e1d0"
msgid ""
"<i>Do you know how hard it was to find that? To cultivate it to be safe for "
"communion? </i>"
msgstr "<i>그걸 찾는 게 얼마나 힘들었는지 아느냐? 교감으로부터 안전하게끔 기르고?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 3525e93f-cdf5-4454-38b2-05fbd6b82629
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3525e93f-cdf5-4454-38b2-05fbd6b82629
msgctxt "h9b1d44fbge642g4719ga835geac4db5bbe5c"
msgid "I don't like what you're implying..."
msgstr "네가 암시하는 거 별로 안 좋은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 378ef110-8845-f5a9-cdaa-de1eb2187553
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:378ef110-8845-f5a9-cdaa-de1eb2187553
msgctxt "h57f160bfg7153g4d8bg89cdga27012a57899"
msgid ""
"*The tadpole prickles with excitement, its thoughts rampant and chaotic in "
"its rush to communicate with you. It is impossible to discern any single "
"intention.*"
msgstr ""
"*올챙이는 흥분에 가득 차 움찔거리고, 서둘러 교신하려는 탓에 생각들이 마구잡이로 펴져 나갑니다. 단 하나의 의도를 알아내는 것도 "
"불가능합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 3807ed84-f3e4-e50c-4965-ae21ff5cd379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3807ed84-f3e4-e50c-4965-ae21ff5cd379
msgctxt "hef0ec449ge7e2g4766g8d5dgbd0239655722"
msgid "<i>If you let me, I can <b>evolve</b> you. </i>"
msgstr "<i>네가 허락한다면, 널 <b>진화</b>시켜주겠다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 38407cc8-e133-6dcc-acf2-0433ba3b1382
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:38407cc8-e133-6dcc-acf2-0433ba3b1382
msgctxt "h5d9adc01g4f42g493fg8186gb8b1352ac2a9"
msgid "Thank you for saving me."
msgstr "구해줘서 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 3a1f9112-3a65-2b91-feae-efb1ab07e5b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3a1f9112-3a65-2b91-feae-efb1ab07e5b4
msgctxt "he78b3998gbc20g48a4g9ff4ga0e1bd326947"
msgid ""
"<i>An adventurer. I came from Baldur's Gate, though I was never one to be "
"constrained by circumstance. I longed for more. </i>"
msgstr "<i>모험가. 발더스 게이트 출신. 난 한곳에 머무는 사람이 아니였지. 난 많은 걸 갈망했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 3a6ac426-8b74-8af3-57a5-f6d181149012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3a6ac426-8b74-8af3-57a5-f6d181149012
msgctxt "h2c08cf1dg3860g4bd0gb298ge9dc9b546f43"
msgid ""
"<i>I am a mind flayer, yes. Without me you would be a slave to the "
"Absolute.</i>"
msgstr "<i>그래. 난 마인드 플레이어다. 내가 없었다면 넌 절대자의 노예가 됐을 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 3c183ec5-63bb-6914-e31b-eb01d0183e6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3c183ec5-63bb-6914-e31b-eb01d0183e6e
msgctxt "h66e78dc1g04f6g499bga28fgaea68b49925e"
msgid "<i>Would you like to do it? Would you like to evolve? </i>"
msgstr "<i>받아드리겠나? 진화하고 싶은가?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 3c1a2256-8952-1b16-689c-5d39fde89be2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_Event_PlayerRefusedToHelpEmperor = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3c1a2256-8952-1b16-689c-5d39fde89be2
msgctxt "hd7ec28aeg933ag461fg8c15g894ea396a47d"
msgid ""
"<i>Your reluctance to help nearly cost us everything. You saw reason just in "
"time. </i>"
msgstr "<i>네 망설임이 모든 걸 망칠 뻔했지만 제때 정신을 찾았군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 3f52fe9b-4989-45d2-5d33-9b83a96167b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:3f52fe9b-4989-45d2-5d33-9b83a96167b5
msgctxt "h6e47f4afg6220g46a6g869fge08f08f273a0"
msgid "<i>And found Orpheus. </i>"
msgstr "<i>그리고 오르페우스를 발견했지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Karlach
#. NodeID = 42a857fb-d840-3abe-f8bf-074abdf46c6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:42a857fb-d840-3abe-f8bf-074abdf46c6f
msgctxt "h68f3fe52g4d01g45d1g97acg3656736b7ed0"
msgid ""
"I guess this is our best chance. You can handle it. And I'll still like you "
"just the same."
msgstr "이게 최선인 거 같네. 넌 감당할 수 있어. 난 여전히 널 좋아할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 42f88723-6e66-2ff0-027b-c31afe547c9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:42f88723-6e66-2ff0-027b-c31afe547c9a
msgctxt "h2af7c20dg8a59g44c1gb447g7857973db3ab"
msgid "<i>Now hold out your hand.</i>"
msgstr "<i>손을 내밀어 봐라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 43a1abd2-3082-97a9-f939-1237a3d7d80e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_State_SpokeToVlaakith = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:43a1abd2-3082-97a9-f939-1237a3d7d80e
msgctxt "hc9e30c38g455cg4473g9b12g6a80c262d8c0"
msgid ""
"*Your thoughts turn to the caged githyanki. Is <i>this</i> the target "
"Vlaakith asked you to slay?*"
msgstr "*당신의 생각이 갇혀있는 기스양키에게로 옮겨갑니다. 블라키스가 죽이라고 한 목표가 <i>이 자</i>일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 4437933e-9fb8-cd63-9b80-beca5975cfc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TADPOLE_ASSIGNED(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_Daisy_State_RejectedPartialIllithidTransformation(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:4437933e-9fb8-cd63-9b80-beca5975cfc3
msgctxt "h82d4c0eeg58b0g49d8gbe50gfadf53f49011"
msgid "Actually, I'd rather not."
msgstr "별로 그러고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 443c71e8-21ea-f7c8-c999-c1828392b036
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:443c71e8-21ea-f7c8-c999-c1828392b036
msgctxt "h2a205b1eg5c38g425eg84ccgd93f8c114bda"
msgid ""
"<i>For years I served the elder brain - the one you know as the Absolute. I "
"was a thrall like any other. But I was fortunate. I broke free, and started "
"a new life in my old city.</i>"
msgstr ""
"<i>수년간 네가 절대자로 알고 있는 엘더 브레인을 섬겼다. 다른 이들처럼 노예였지. 그런데 행운이 찾아왔고, 자유로워졌다, 내 오랜 "
"도시에서 새로운 삶을 시작했지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 447bdbf4-953e-6f22-0697-7796f39507a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:447bdbf4-953e-6f22-0697-7796f39507a3
msgctxt "h271156a8g87efg4080ga177g95c1ce1bd621"
msgid ""
"<i>His power has been the source of your continued protection against the "
"voice of the Absolute - the power to disrupt hivemind communication.</i>"
msgstr "<i>그의 힘이 절대자의 목소리에 대항하는 방어 수단의 원동력이다. 하이브마인드의 전달을 분열시키는 힘.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 4634b8a0-76ca-fb7c-5471-9cd29c095e67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:4634b8a0-76ca-fb7c-5471-9cd29c095e67
msgctxt "hf888c268g31a7g4120g838bg1b53f9357005"
msgid ""
"<i>If I'd known you would be so open-minded, I could have saved myself a lot "
"of effort. </i>"
msgstr "<i>네가 이렇게 열린 마음이라는 걸 미리 알았다면, 많은 노력을 절약할 수 있었을 텐데.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Shadowheart
#. NodeID = 48b8272a-1a49-1c12-f9f3-c3e9a93d6ccf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:48b8272a-1a49-1c12-f9f3-c3e9a93d6ccf
msgctxt "h76a82ad4g9d30g43a8g981fgb53e6e0158f2"
msgid "Well... certainly brave of you, I'll say that much."
msgstr "그래... 정말 용감하네. 여기까지만 말하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 498abc26-d3e2-ae65-0bc6-95f10f781d7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:498abc26-d3e2-ae65-0bc6-95f10f781d7a
msgctxt "hfb081a4bg0d03g4548ga067g4e03713887e4"
msgid ""
"<i>That longing brought me to Moonrise Towers on a search for treasure. To a "
"colony of mind flayers who caught me, changed me into what I am now. </i>"
msgstr ""
"<i>그 갈망에 이끌려 문라이즈 타워를 찾아가게 되었지. 그곳은 마인드 플레이어의 소굴이었고, 놈들에게 붙잡힌 결과 지금의 모습으로 "
"변화되었다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 4a9bd5ad-0ba2-0333-d5ee-9cee963d3769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:4a9bd5ad-0ba2-0333-d5ee-9cee963d3769
msgctxt "he8509beagefe2g46f4gb37eg2a80f87b7fab"
msgid "<i>Most certainly Orpheus. He is a threat to her reign.</i>"
msgstr "<i>오르페우스가 확실하다. 그녀의 통치에 위협이 되니까.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 4b5526a1-ddd3-6ce7-f28c-78bbcbf9bbdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TADPOLE_ASSIGNED(1) = False
#. SetFlags:
#.   Global:
#.     - GLO_Tadpole_Event_AstralTouchedTadpoleDestroyed = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:4b5526a1-ddd3-6ce7-f28c-78bbcbf9bbdd
msgctxt "h0d53be95g19e3g4184g9f49gb1b19baef607"
msgid "<i>Drop it on the ground and stomp on it.</i>"
msgstr "<i>땅에 떨어뜨리고 밟아버린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 4da0488c-de45-3e5d-e3b2-f74e0b9cba5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:4da0488c-de45-3e5d-e3b2-f74e0b9cba5c
msgctxt "he4ee8c57gcbdeg40f9gbbf4gd3e8780bf2aa"
msgid "<i>Open your mind to the tadpole.</i>"
msgstr "<i>올챙이에게 정신을 연다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 4e6d7615-2ae9-9d1d-f353-5e8d5a68a456
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:4e6d7615-2ae9-9d1d-f353-5e8d5a68a456
msgctxt "h271a2071g2d9cg48ecg8b3agbaa1e19d0c66"
msgid ""
"<i>The return of Gith's son would mean the end of Vlaakith. There is no "
"plainer truth.</i>"
msgstr "<i>기스의 아들의 귀환은 블라키스의 종말을 의미한다. 그보다 명백한 진실은 없어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 4f29b8c2-62c7-fbf7-ffc6-4d009c50b482
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Knows_AstraltouchedTadpoleReusable(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:4f29b8c2-62c7-fbf7-ffc6-4d009c50b482
msgctxt "h156e6fa6g63bcg447aga6e5gdbfb4dfb2d29"
msgid "<i>You or your allies - it has vitality enough for you all.</i>"
msgstr "<i>이 안에는 너와 네 동료들 모두를 감당할 생명력이 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 50ce79a5-c046-5495-6396-357bdde357e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:50ce79a5-c046-5495-6396-357bdde357e3
msgctxt "hf2990285g813fg4020g89b4g260a78f5e546"
msgid ""
"<i>As an illithid, I have far surpassed who I ever was before. You, too, "
"should embrace this change. </i>"
msgstr "<i>일리시드로서, 나는 이전의 나를 월등히 뛰어넘었다. 그리고 너 역시 이 변화를 수용해야만 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Gale
#. NodeID = 51fb979d-0e4b-8933-f948-da70d41f161c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(7) = True
#.      - TADPOLE_REFUSAL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:51fb979d-0e4b-8933-f948-da70d41f161c
msgctxt "h8bcb9bdegb2c2g495bg8ecdgef1143b9c6b5"
msgid "That's a bell you can't unring. Perhaps you should reconsider."
msgstr "되울릴 수 없는 초인종이야. 다시 한번 생각해보길 바란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 5256abd4-bdf7-7f89-5f46-f531e5d4c1ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_FirstDaisyDream_AskedWhoAreYou(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:5256abd4-bdf7-7f89-5f46-f531e5d4c1ae
msgctxt "h2247ac4cg7760g424cg9526g7797a68f0db1"
msgid "<i>It's like I said before - I'm just like you.</i>"
msgstr "<i>이전에도 한번 말했었지. 난 너랑 같다고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 54439d25-1769-a40a-5d15-964e739142cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:54439d25-1769-a40a-5d15-964e739142cb
msgctxt "hd9e26a7eg7e41g42d1g8cf6gdd2f756ee1ca"
msgid ""
"<i>I realised that returning to my former self would only impose "
"limitations. </i>"
msgstr "<i>내 이전 모습으로 돌아가는 건 스스로를 제한하는 것일 뿐임을 깨달았다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 54a124f2-1f5d-631e-ad54-81b4198fa015
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#.      - INT_EmperorRevealed_KnowsAboutBattle(1) = False
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = False
#.   Global:
#.      - GLO_Emperor_State_MetMindFlayerBefore = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:54a124f2-1f5d-631e-ad54-81b4198fa015
msgctxt "hec29e6bfge0c5g4f82ga5c4gb06d6a9057d4"
msgid "I didn't realise mind flayers could be independent thinkers."
msgstr "마인드 플레이어가 개별적인 사고를 할 수 있다는 건 몰랐는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 558393cd-1ec8-a27e-40eb-7d688775d248
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:558393cd-1ec8-a27e-40eb-7d688775d248
msgctxt "h3d5171c9ga2fbg42d0gafe8ged80b4cdc7af"
msgid ""
"<i>On the contrary, Vlaakith is quite fallible. Not all githyanki eyes are "
"so clouded as yours.</i>"
msgstr "<i>반대로, 블라키스가 완벽한 게 아닐 수도 있지. 모든 기스양키의 눈이 네 눈처럼 흐린 게 아니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 560719a9-ab31-ca86-8976-f2ba8248a8b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:560719a9-ab31-ca86-8976-f2ba8248a8b0
msgctxt "h37e387deg2dd9g4bcbga06bgaf88404b3fc1"
msgid "<i>I'm pleased to hear that. You will do very well as an illithid.</i>"
msgstr "<i>듣고 싶은 말이었다. 넌 일리시드로서 잘 해낼 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 563c5f44-6808-2516-ffee-db1012bde3a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:563c5f44-6808-2516-ffee-db1012bde3a0
msgctxt "h4ae4aad6gdebeg4c48ga007g70dad72b0062"
msgid ""
"<i>The return of Gith's son would mean the end of Vlaakith. There is no "
"plainer truth.</i>"
msgstr "<i>기스의 아들의 귀환은 블라키스의 종말을 의미한다. 그보다 명백한 진실은 없어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 58bdfde7-4cd4-2f80-68d2-f9fcda3eda6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:58bdfde7-4cd4-2f80-68d2-f9fcda3eda6c
msgctxt "ha1aa9cd5g7bc3g46c3ga0b8gb2eee7da06b6"
msgid ""
"<i>Like it or not, our chances of defeating the elder brain are "
"substantially improved if you embrace your latent illithid potential.</i>"
msgstr "<i>좋든 싫든, 너에게 잠재된 일리시드의 힘을 수용한다면 엘더 브레인을 이길 확률이 크게 증가한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 58de5042-e8aa-c906-4386-1414c0dd066e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:58de5042-e8aa-c906-4386-1414c0dd066e
msgctxt "h00aa48a1g2069g4bddgbd18g63f8e4ed6a55"
msgid ""
"<i>We may look different, but to the elder brain we are already the same - "
"thralls in its design. </i>"
msgstr "<i>우리는 다르게 보여도, 엘더 브레인에겐 이미 같다. 설계 속 노예로써.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 59255ee2-325c-9797-9fa2-2f8292f18093
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:59255ee2-325c-9797-9fa2-2f8292f18093
msgctxt "h8ec83233gc964g4612ga701g68288cb1d7eb"
msgid "*If you let it, it will evolve you, just as the Emperor said.*"
msgstr "*허락한다면, 당신을 진화시켜줄 것입니다. 황제가 말한 대로.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 5b1386d4-4751-fc4c-54e3-53452b07ff3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:5b1386d4-4751-fc4c-54e3-53452b07ff3f
msgctxt "hc16f38eeg7410g4c04g8f70ge4491e2adc57"
msgid "<i>I suppose if it works...</i>"
msgstr "<i>그렇게도 되는 것 같군...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 5b97d7a3-03e9-e475-b390-774d39c605f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = False
#. SetFlags:
#.   Dialog:
#.     - INT_EmperorRevealed_KnowsAboutPrism(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:5b97d7a3-03e9-e475-b390-774d39c605f9
msgctxt "hc86cc427g6684g4f66ga2a4g3088d6bc7d63"
msgid "How did you end up in here?"
msgstr "어쩌다 여기에 오게 됐어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 5d4872e8-f09c-a7c8-6886-d9d184327e9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:5d4872e8-f09c-a7c8-6886-d9d184327e9d
msgctxt "h25086327g032cg420cgbd21gf18092bb7302"
msgid ""
"*The tadpole screams for growth with painful intensity. It has been starved -"
" of life, of purpose. It welcomes your probing like a void waiting to be "
"filled.*"
msgstr ""
"*올챙이는 고통에 찬 간절함으로 성장을 울부짖습니다. 올챙이는 그동안 갈망해왔습니다. 삶을. 목적을. 당신의 탐사를 공허가 채워지길 "
"기다린 것처럼 반깁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 5d554a0f-1d74-9daf-a5d8-a284a20e4ff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:5d554a0f-1d74-9daf-a5d8-a284a20e4ff8
msgctxt "h96f0fbc5g3d93g4a2dgb5f8g813193a63c75"
msgid ""
"<i>The transformation will not be complete - the physical alteration in "
"particular will be only partial. But your potential will certainly be "
"amplified.</i>"
msgstr "<i>변형이 완벽하지는 않을 거다. 특히 물리적으론 일부만 변화할 것이다. 하지만 네 잠재력은 확실하게 증폭된다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Wyll
#. NodeID = 610c4cec-956f-8d3f-a665-a19e96713b00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#.      - TADPOLE_REFUSAL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:610c4cec-956f-8d3f-a665-a19e96713b00
msgctxt "hdc3049acg9e04g4818g9a99g46a51341de52"
msgid ""
"By Balduran's helm, only a fiend or fool would bargain with this damnable "
"creature."
msgstr "발더란의 투구에 걸고 말하건대, 마족이나 바보가 아니고서야 이런 빌어먹을 괴물하고는 거래하지 않을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 61176a71-824b-3ee3-5fa6-2092295c3632
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Event_GiveAstralTadpole(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:61176a71-824b-3ee3-5fa6-2092295c3632
msgctxt "h87d18665gc257g4648g9873g6b3a6a290346"
msgid "<i>You are not ready yet. Keep hold of it then, until you are. </i>"
msgstr "<i>아직 준비가 안 되었군. 준비될 때까지 가지고 있어라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 62657302-d458-f28a-265f-2d7cb5ed4858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:62657302-d458-f28a-265f-2d7cb5ed4858
msgctxt "hfe31adbbgcc9dg4c10g9823gdf4df1a9e5a1"
msgid ""
"<i>You have seen what I can do. Imagine yourself with the same strength. The "
"same intelligence. The same devastating beauty.</i>"
msgstr "<i>내가 뭘 할 수 있는진 너도 보았겠지. 같은 힘, 같은 지능, 같은 압도적인 아름다움을 가진 너를 상상해봐라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 62d0bcf3-73a4-7c71-706e-250460507a9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Laezel = False
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:62d0bcf3-73a4-7c71-706e-250460507a9d
msgctxt "h08e21b00g113ag43f7g9517g95ca98484830"
msgid "Why did Orpheus refuse to aid Vlaakith?"
msgstr "오르페우스가 블라키스를 돕는 걸 거부한 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 62d0bcf3-73a4-7c71-706e-250460507a9d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Laezel = False
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = False
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:62d0bcf3-73a4-7c71-706e-250460507a9d
msgctxt "h1d222e53g5792g46ffga4a1gadd315e4da61"
msgid "Why did Orpheus refuse to aid Queen Vlaakith?"
msgstr "오르페우스가 블라키스 여왕님을 돕는 걸 거부한 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 640db303-4d3d-6177-9857-957c939f5253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:640db303-4d3d-6177-9857-957c939f5253
msgctxt "hb18be855g2380g49b6gb231ge506db7129fc"
msgid ""
"<i>The moment he is free, he will attack you. Your only defence would be to "
"kill him. And in so doing, you would doom us both. </i>"
msgstr ""
"<i>그가 풀려난 순간, 널 공격할 거다. 네 유일한 방어는 그를 죽이는 것이 될 테고, 그렇게 되면 우리 둘 다 끝장이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 656f4499-700b-b37d-b4ee-16b25c39c6b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:656f4499-700b-b37d-b4ee-16b25c39c6b8
msgctxt "hdc5b8006g8a6dg47e3g9f7ag61ce37428322"
msgid ""
"<i>You heard the Chosen - the brain has gone to the city, and the army "
"marches to follow. </i>"
msgstr "<i>선택받은 자가 하는 말 들었지. 뇌는 도시로 갔고 군대도 그리로 행군하고 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 657da0c0-a294-4f56-856f-bbdc734772fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:657da0c0-a294-4f56-856f-bbdc734772fc
msgctxt "h7c3aba8bg8a9bg4f6dg8ad5g5c8b23deba3c"
msgid ""
"*The tadpole's essence courses through you - where it touches, your flesh, "
"glands, organs contract and flood with pure thought.*"
msgstr "*올챙이의 정수가 당신 안에서 흐르며 닿는 살, 분비 기관, 장기들이 수축하고 순수한 생각으로 넘쳐납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Astarion
#. NodeID = 67505656-c3c6-d680-fd4b-2b4048d9c39f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:67505656-c3c6-d680-fd4b-2b4048d9c39f
msgctxt "h95f38075gfdf7g4035ga16fg8696ef76d0fb"
msgid ""
"I'm happy to have more powerful friends, but... well, better you than me."
msgstr "더 강력한 친구를 두는 건 좋지만... 내가 아니라 너라서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 67addbc4-a163-b235-cb3b-bec401a2e6b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_General_State_SomeoneIsPartialCeremorph = True
#.   Object:
#.     - INT_EmperorRevealed_State_PartialCeremorph(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:67addbc4-a163-b235-cb3b-bec401a2e6b7
msgctxt "h3f1954afg5a56g485egb73ag39b82afcd6f0"
msgid ""
"*You feel... different. Your body has never felt more connected. Your mind "
"present in every flex of a joint or muscle.*"
msgstr "*뭔가... 달라졌습니다. 몸이 이렇게 연결되었다고 느낀 적은 처음입니다. 모든 관절과 근육이 정신과 연결되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 692117b6-99e6-cec9-d83b-f178c247a939
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:692117b6-99e6-cec9-d83b-f178c247a939
msgctxt "hd8603c37g11bfg4cf3g99ffgefec51d5114b"
msgid "<i>But in case you change your mind -</i>"
msgstr "<i>그런데 혹시라도 마음을 바꿨을 때를 위해서</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 69587795-1407-3559-6dde-9a171c898559
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:69587795-1407-3559-6dde-9a171c898559
msgctxt "hf5caaef3gee68g49fbg8f8agfe2b010237d4"
msgid ""
"<i>I have always valued freedom above all else. In my past life and present. "
"</i>"
msgstr "<i>난 언제나 자유를 제일 우선시했다. 과거의 삶에서나 지금이나.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 6976a5fc-503c-91ad-b7cb-f3ffcc42fb11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:6976a5fc-503c-91ad-b7cb-f3ffcc42fb11
msgctxt "h67e0018ag6d15g402fg9697g835f07a1a90e"
msgid "I would like that."
msgstr "기꺼이 그러지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 6a0795fb-de61-4a65-c58b-47770e1cea58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:6a0795fb-de61-4a65-c58b-47770e1cea58
msgctxt "hd96c5ea8g8f8eg47c6gb72bgf8de8f1fa64b"
msgid ""
"<i>It was necessary. Rare are those that would openly consider a partnership "
"with a mind flayer.</i>"
msgstr "<i>필요했기 때문이다. 마인드 플레이어와 열린 마음으로 협력할 사람은 흔하지 않다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 6a4ea247-625e-3893-974f-d8403b5f45d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:6a4ea247-625e-3893-974f-d8403b5f45d0
msgctxt "h83d78b87g87eeg4148ga7e2ga975ed4ea9ee"
msgid ""
"I'm trying to avoid becoming a mind flayer - I thought you agreed to protect "
"me."
msgstr "나는 마인드 플레이어가 되지 않게 노력하고 있다고. 네가 날 보호해주는 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 6af7680d-3dff-02cb-8981-9fadf9140df9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - INT_EmperorRevealed_Knows_AstraltouchedTadpoleReusable(1) = False
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Knows_AstraltouchedTadpoleReusable(1) = True
#.     - INT_EmperorRevealed_Event_GiveAstralTadpole(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:6af7680d-3dff-02cb-8981-9fadf9140df9
msgctxt "h6c896d8dgbf7dg4da9g8484g23a57dc83c89"
msgid ""
"<i>When your allies see what you can do... I hope you'll encourage them to "
"try it for themselves.</i>"
msgstr "<i>동료들이 네가 할 수 있는 일들을 보게 된다면 그들에게도 똑같이 권유하길 바란다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 6b93e336-54ad-152c-7388-b21e7f04b1d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:6b93e336-54ad-152c-7388-b21e7f04b1d4
msgctxt "h8b3c6b4cg7756g43c5g848dgce5760a60134"
msgid ""
"<i>There will be... physical alterations, of course. But only partial. You "
"will retain most of your current form. </i>"
msgstr "<i>신체적인 변형... 도 좀 있지. 허나 일부만이다. 네 현재 모습의 대부분은 유지될 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 6ca947aa-c597-c4f7-487c-c47f3f2ab7aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet = True
#.   Tag:
#.      - ILLITHID(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:6ca947aa-c597-c4f7-487c-c47f3f2ab7aa
msgctxt "h42274503gbfeag4508g8812g5edef7bcd6e2"
msgid ""
"<i>Go ahead - I cannot leave with you, but I will continue to protect the "
"infected. </i>"
msgstr "<i>가라. 너와 같이 갈 순 없지만, 감염자를 계속해서 보호할 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 6df8becf-d72f-d4e5-0bea-f90efb4849a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:6df8becf-d72f-d4e5-0bea-f90efb4849a0
msgctxt "h9af535ceg4251g4889gaf11g947b79fd7224"
msgid ""
"<i>Your trust in Vlaakith is understandable. Her lie is carved in your "
"people's slates, bold as truth - yet a lie it remains.</i>"
msgstr "<i>블라키스에 대한 네 믿음은 이해할 수 있다. 그녀의 거짓말이 네 종족의 석판에 새겨져있지. 하지만 거짓말이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 702a3475-2c64-9dbb-eefe-c563a1c47d5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:702a3475-2c64-9dbb-eefe-c563a1c47d5a
msgctxt "ha1a13716g4b0bg4db5g9fccgec55efad08bc"
msgid "<i>A very good question. One that I have been unable to answer.</i>"
msgstr "<i>아주 좋은 질문이다. 지금까지 나도 답을 알 수 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 718c49de-6f51-2d78-58ad-e0879deb759d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tadpole_Event_AstralTouchedTadpoleDestroyed = True
#.      - INT_EmperorRevealed_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:718c49de-6f51-2d78-58ad-e0879deb759d
msgctxt "h228ec933g858dg4f7bg9d91gfa38163d7f0c"
msgid ""
"<i>Since you destroyed my gift, there is nothing further I can do for you "
"right now. Proceed.</i>"
msgstr "<i>네가 내 선물을 부숴버렸으니, 지금 당장 네게 해줄 일은 없다. 진행하라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 74e9c627-5922-bedc-070f-587d133a08a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:74e9c627-5922-bedc-070f-587d133a08a9
msgctxt "hcf978987ga607g425cgb903gc0964865bc51"
msgid ""
"<i>Two - why would I? You have done well with the limited form you have, but "
"you would do far better as an illithid.</i>"
msgstr "<i>둘째. 왜 그래야 하지? 넌 너의 제한적인 형태로도 잘 해왔지만, 일리시드로는 훨씬 더 잘 해낼 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 759b07dd-012d-90df-dce6-b1d6ea74f099
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:759b07dd-012d-90df-dce6-b1d6ea74f099
msgctxt "h630b760eg8535g4602gb8feg2b61418755f4"
msgid ""
"*To owe your life to a deceitful illithid - you could never have imagined a "
"truth so obscene.*"
msgstr "*사악한 일리시드에게 목숨을 빚진다는 것. 진실이 이토록 외설적일 거라고는 상상조차도 하지 못했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 7664e665-7660-ed70-9bd8-10d96bc20f6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:7664e665-7660-ed70-9bd8-10d96bc20f6c
msgctxt "h40ee2b47ga4b9g4bb1g816cge7e2d3c4a35d"
msgid "The more I talk to you, the less you seem like a mind flayer."
msgstr "너랑 얘기할수록, 마인드 플레이어 같지 않아 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 7704d02f-da33-01d0-c9e3-fb1c3efad2d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:7704d02f-da33-01d0-c9e3-fb1c3efad2d4
msgctxt "h992064b5g03fag45a8g95cag9fc45bf7a2aa"
msgid ""
"<i>The name was intended as a slight - to remind me of the heights from "
"which I fell. But I have grown fond of it. It encapsulates well who I've "
"become. </i>"
msgstr ""
"<i>황제란 이름은 내가 얼마나 깊게 추락했는지 상기시켜 주는 모욕의 의미다. 하지만 그 이름이 마음에 들게 되었다. 내가 어떤 존재가 "
"되었는지 잘 요약해 주지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 777ceb25-9e14-892a-3163-fe20ff69c59e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:777ceb25-9e14-892a-3163-fe20ff69c59e
msgctxt "hdeba5ff4g87c5g4ac1g9831g4ab92a8eef56"
msgid ""
"<i>When Orpheus' mother left, a usurper took her place - Vlaakith declared "
"herself 'queen' of your people. </i>"
msgstr ""
"<i>오르페우스의 어머니가 떠나자, 한 강탈자가 그녀의 자리를 차지했지. 블라키스는 스스로를 기스양키의 '여왕'이라 칭했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 777ceb25-9e14-892a-3163-fe20ff69c59e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:777ceb25-9e14-892a-3163-fe20ff69c59e
msgctxt "h888d0ef7gbae8g4b2fg8e3fgfcda2f9be1c2"
msgid ""
"<i>When Orpheus' mother left, a usurper took her place - Vlaakith declared "
"herself 'queen' of the githyanki.</i>"
msgstr ""
"<i>오르페우스의 어머니가 떠나자, 한 강탈자가 그녀의 자리를 차지했지. 블라키스는 스스로를 기스양키의 '여왕'이라 칭했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = 77a4b523-775e-8131-679a-bf0ee8f8c04c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:77a4b523-775e-8131-679a-bf0ee8f8c04c
msgctxt "h1e71f58fg002bg4c86g8bbcg35c783ea38da"
msgid "No more lies, no more tricks. I <i>will</i> have answers!"
msgstr "더이상의 거짓말, 속임수는 그만. 나는 해답을 얻어낼 것이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 787b61c4-084a-36de-aba2-3d1cf482a85e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:787b61c4-084a-36de-aba2-3d1cf482a85e
msgctxt "h8f11b202gce86g4029gba52g8d8607f76eb8"
msgid "<i>But we mustn't lose focus. We need to resume our journey. </i>"
msgstr "<i>이제 다시 집중해서, 여행을 재개해야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 7a2b4d7f-be0e-962f-3190-4c08e2459c3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:7a2b4d7f-be0e-962f-3190-4c08e2459c3c
msgctxt "h5669677bgc815g4515g9e6eg72351f335d1f"
msgid ""
"<i>Even if my original body remained intact after I transformed, I would not "
"return to it. Doing so would only impose limitations. </i>"
msgstr "<i>내 원래 육체가 손상되지 않고 남아있었어도, 난 돌아가지 않았을 거다. 그건 오직 제한을 거는 것이니까.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 7f2241a4-4078-6d57-51f5-a39819ae6225
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:7f2241a4-4078-6d57-51f5-a39819ae6225
msgctxt "hb6d85a0bg7c14g470egb5ceg173638ccf342"
msgid "<i>Prince Orpheus, son of the first leader of the githyanki. </i>"
msgstr "<i>왕자 오르페우스. 기스양키 첫 번째 지도자의 아들.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 7f83083a-9a6c-97d5-d514-e8a2579aabe4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL_ORPHEUSPATH(1) = False
#.      - REALLY_LAEZEL(1) = True
#. SetFlags:
#.   Local:
#.     - f840b590-dc13-d3df-e03c-e58611d62e86_Finished = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:7f83083a-9a6c-97d5-d514-e8a2579aabe4
msgctxt "h60acd9deg564ag488ag88ccge403aa15068a"
msgid ""
"Vlaakith is eternal. My people would not be swayed by this false prince."
msgstr "블라키스는 영원하시다. 기스양키들은 이 가짜 왕자에게 동요되지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 80a4b0f6-6756-ee29-1d2a-c78f88848713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:80a4b0f6-6756-ee29-1d2a-c78f88848713
msgctxt "h5342eda4gf052g46abg9a3bg80cfe27a6699"
msgid "<i>But I'm glad you're not here to judge.</i>"
msgstr "<i>비난하지 않아줘서 기쁘군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 81563113-3645-b321-301d-f4a6ba06bbb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DAISY_REASONTRACK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:81563113-3645-b321-301d-f4a6ba06bbb0
msgctxt "h806b1617gaec4g4b42gaea1gd09a82e41250"
msgid ""
"<i>Even as you are, you have shown rationality that puts you far above your "
"kind. You will do well as an illithid.</i>"
msgstr "<i>네 현재 모습으로도, 동종을 훨씬 뛰어넘는 합리성을 보여주는군. 넌 일리시드로도 잘 해낼 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 82fd1803-ed9e-5a36-8003-225649dfe632
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsCeremorphosisIrreversible(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:82fd1803-ed9e-5a36-8003-225649dfe632
msgctxt "h9687c1eeg6ddcg476eg9283gce5dbd7bc419"
msgid "If you can evolve me, why can't you stop ceremorphosis altogether?"
msgstr "날 진화시켜줄 수 있다면, 그냥 뇌변이를 멈춰주면 되는 거 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 83079134-4b8b-1390-8412-bac7a2e378b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.   Global:
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:83079134-4b8b-1390-8412-bac7a2e378b0
msgctxt "h89791581gc37dg4c14g8efage6fc6cb948fe"
msgid ""
"Was it you or Orpheus that Queen Vlaakith wanted us to kill when she ordered "
"us inside the Prism?"
msgstr "여왕 블라키스께서 프리즘 안의 존재를 죽이라고 명령하셨는데 그게 너야 오르페우스야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 83079134-4b8b-1390-8412-bac7a2e378b0
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.   Global:
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:83079134-4b8b-1390-8412-bac7a2e378b0
msgctxt "hd314ad05gb8acg46f3ga9bcgeade03d21b75"
msgid ""
"Was it you or Orpheus that Vlaakith wanted us to kill when she ordered us "
"inside the Prism?"
msgstr "여왕 블라키스가 우리 보고 프리즘 안의 존재를 죽이라고 명령했는데 그게 너야 오르페우스야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = 84202675-48ae-4d2f-bab3-ba80612f4f59
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f840b590-dc13-d3df-e03c-e58611d62e86_LaezelInclusion2 = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:84202675-48ae-4d2f-bab3-ba80612f4f59
msgctxt "h4e0dad7eg2663g4732g8c6fg1797ba758119"
msgid "Control him? Bah - the traitor must be ripped apart, brain to belly!"
msgstr "그분을 제어한다고? 하. 이 배신자의 뇌부터 배까지 찢어버려야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8558d19f-e206-8c0f-00e5-84c41af8eb58
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - INT_EmperorRevealed_Event_SceneComplete = True
#.     - INT_EmperorRevealed_HasMet = True
#.     - INT_EmperorRevealed_State_AfterOrpheus = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8558d19f-e206-8c0f-00e5-84c41af8eb58
msgctxt "hbb936638gfeaeg4f1fg90fdg9770ea05ac42"
msgid ""
"<i>We must not let them reach it. We must find the brain, and bring it under "
"our control. </i>"
msgstr "<i>그들이 도달하게 해선 안 된다. 뇌를 찾아 </i>우리의<i> 통제하에 둬야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 856ee913-aa8d-2db1-f463-265b0030e7b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Knows_AstraltouchedTadpoleReusable(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:856ee913-aa8d-2db1-f463-265b0030e7b7
msgctxt "h6b67f7aag8bc5g401eg990ag43cd4b07d83f"
msgid ""
"<i>But if you had opened your mind to it rather than consuming it, your "
"allies could have taken advantage of its power as well.</i>"
msgstr "<i>그렇게 섭취해버릴 게 아니라 그냥 정신을 열기만 했어도, 네 동료들도 그 힘을 가질 수 있었을 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 85b45746-a9d0-def7-400f-282fdc6f58fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:85b45746-a9d0-def7-400f-282fdc6f58fd
msgctxt "h5b6247e4g9924g430bg886eg85dc968d12ed"
msgid ""
"<i>Indeed. His hubris knows no bounds. To enslave me, that was his nature. "
"But to enslave an elder brain? A questionable decision. </i>"
msgstr ""
"<i>그렇다. 그의 오만함엔 한계가 없다. 나를 노예로 만든 건 그의 본성이지만, 엘더 브레인을 노예화하는 건 의문스러운 판단이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 875458c7-cd28-f582-d338-60851f5bc6e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:875458c7-cd28-f582-d338-60851f5bc6e0
msgctxt "h6316b7d8g3100g446eg821fg7db88d706d3d"
msgid "<i>I realised what the Prism was for - containment.</i>"
msgstr "<i>이 프리즘의 용도를 깨닫게 되었다. 격리.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8845b751-a262-3463-1719-7e3f8c0e75d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8845b751-a262-3463-1719-7e3f8c0e75d7
msgctxt "hed2d23dag2b9dg4c1egb64ag9c4bf8be2250"
msgid ""
"<i>Bound by infernal chains, Orpheus could never leave. Bound by duty, his "
"guard never would.</i>"
msgstr "<i>지옥 족쇄에 속박되어, 오르페우스는 결코 떠날 수 없었다. 의무에 속박되어, 친위대도 결코 떠날 생각이 없었다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8859c340-c8fa-25cf-d24a-6560854ccca3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8859c340-c8fa-25cf-d24a-6560854ccca3
msgctxt "h1985896aga339g4cf4g9d26g54432c4c1a5c"
msgid ""
"<i>The moment his protection is gone, you would become enthralled to the "
"elder brain just as I would.</i>"
msgstr "<i>그의 보호가 없어지는 순간, 너도 나와 같이 엘더 브레인의 노예가 될 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 88fe1808-792c-3ae1-e57b-c288839215fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:88fe1808-792c-3ae1-e57b-c288839215fe
msgctxt "h48f2590cg22cag46c5g9a91g635693a09648"
msgid ""
"*A raging pain tears through your head as thoughts and instincts do battle "
"within it. Then - silence. Your mind opens, and all resistance evaporates...*"
msgstr ""
"*당신의 이성과 본능이 싸우는 격렬한 고통이 머릿속을 찢어놓습니다. 잠시 후, 정적. 당신의 정신은 열렸고, 모든 저항이 사라집니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 893bbd92-e0cd-ef11-9770-2bfcabd6eda2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:893bbd92-e0cd-ef11-9770-2bfcabd6eda2
msgctxt "hb8776116g91d9g4349g9837ge110f7c63258"
msgid ""
"<i>You grew attached to a mere disguise. But you judge without even knowing "
"me. </i>"
msgstr "<i>넌 단순한 변장에 애착을 가지게 됐다. 지금은 내 겉모습만 보고 판단하기도 하지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8a9120d8-7dc3-bd47-fe83-96a0a6243f6a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8a9120d8-7dc3-bd47-fe83-96a0a6243f6a
msgctxt "h7d646802gb137g47e7g86a9g6bcc5919828d"
msgid ""
"<i>All I needed to do was subdue Orpheus and find allies in the outer world. "
"You.</i>"
msgstr "<i>내가 해야 할 일은 오르페우스를 제압하고 바깥세상에서의 동맹을 찾는 거였지. 바로 너.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8b797bab-b673-a623-4d06-ea477a96e173
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8b797bab-b673-a623-4d06-ea477a96e173
msgctxt "h3868ce65gae49g45b9g9c5ag4789fda1e3d4"
msgid ""
"<i>Perhaps you will be more inclined to try it when you see more of what our "
"enemy can do.</i>"
msgstr "<i>네 적들이 뭘 할 수 있는지 보게 되면 마음을 바꾸게 될 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8be3a36c-25fa-1576-474e-e0f31a5f46af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8be3a36c-25fa-1576-474e-e0f31a5f46af
msgctxt "hf3514777g8ac4g4e0bgba08g939d8acf806b"
msgid ""
"<i>You seek to reverse an inevitable process, a process of evolution. When I "
"first escaped from the elder brain, I too railed against the change. But the "
"longer I have inhabited this form, the more it has grown on me.</i>"
msgstr ""
"<i>넌 피할 수 없는 과정을 거스르려 하고 있다. 진화의 과정을. 나 역시 처음 엘더 브레인에게서 도망쳤을 때 같은 과정을 겪었지. "
"하지만 이 형태로 오래 있을수록 점점 더 나에게 맞게 성장했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8c75f3f0-e1aa-4f46-82c1-252946cf380f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8c75f3f0-e1aa-4f46-82c1-252946cf380f
msgctxt "h34163415g9fc1g4e38ga5efg058d5ef88252"
msgid ""
"<i>Your histories are fabrications. The prince was not killed, as you can "
"very well see - he was imprisoned. </i>"
msgstr "<i>네 역사는 조작되었다. 너도 잘 볼 수 있듯이 왕자는 살해당하지 않고 구속당했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 8d09fdf7-61ac-a328-924d-8154f3003e11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8d09fdf7-61ac-a328-924d-8154f3003e11
msgctxt "ha018544cg9088g49ebg88a3g9396fdbab8d3"
msgid ""
"<i>I suppose it was considerate of you not to bring it up before. And I ask "
"that you do not judge me for it now. </i>"
msgstr ""
"<i>이전에 그 얘기를 하지 않은 건 이해심이 많은 거라고 여기겠다. 그리고 사실을 숨긴 걸로 날 비난하지도 말아줬으면 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 8d229654-de74-841e-9ec7-9c873ced2539
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#. SetFlags:
#.   Dialog:
#.     - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.     - INT_EmperorRevealed_KnowsAboutBattle(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:8d229654-de74-841e-9ec7-9c873ced2539
msgctxt "h069ecce7g706fg4312g97eege1ed63f1bee5"
msgid "That githyanki in the sphere - who is it?"
msgstr "공 안에 있는 기스양키는 누구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 900a0f45-c475-15ef-313b-17e35af7a325
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Daisy_State_RejectedPartialIllithidTransformation(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:900a0f45-c475-15ef-313b-17e35af7a325
msgctxt "h96b5186cg7738g417cg9e17g662a11c479ca"
msgid "No. No way."
msgstr "안 돼. 절대 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 911e8291-f21d-229b-64f3-d8d1ed8926a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:911e8291-f21d-229b-64f3-d8d1ed8926a9
msgctxt "hf4886ee5g5f74g439bgbc44ga7b2aa996da9"
msgid ""
"<i>But it was important enough to them that Gortash sent me to retrieve "
"it.</i>"
msgstr "<i>하지만 그들에게도 매우 중요한 것이라 고타쉬가 나를 보내서 확보하려 했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = 91871f3f-832c-abc4-f143-6020cf12579e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TADPOLE_ASSIGNED(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:91871f3f-832c-abc4-f143-6020cf12579e
msgctxt "he5ea257cg4867g4c27g952eg2ca1a06ba16f"
msgid ""
"*Even as you say the words, you feel a lurch of disappointment. Your mind "
"bristles with illithid potential. How could you be so cruel as to deny "
"yourself what you want most in the world?*"
msgstr ""
"그렇게 말은 했지만, 실망감이 물밀듯이 밀려왔습니다. 당신의 정신이 일리시드의 잠재력으로 곤두섭니다. 당신이 세상에서 가장 원하는 것을 "
"어떻게 그렇게 잔인하게 거절할 수 있죠?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 92f00ad0-d08e-d552-a17f-d13dc0f63d7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#.      - INT_EmperorRevealed_KnowsAboutBattle(1) = False
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:92f00ad0-d08e-d552-a17f-d13dc0f63d7e
msgctxt "h1a432274g9b81g48afg9824ge08d91f6ece8"
msgid "Did you have to eat criminals' brains?"
msgstr "정말 범죄자들의 뇌를 먹어야 했어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 932cf878-8caa-81e5-b046-0d58aafd8713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:932cf878-8caa-81e5-b046-0d58aafd8713
msgctxt "hb8ae8ce5g4149g41b9gbc65g5d630cba4388"
msgid ""
"<i>How Gortash or the other Chosen learned of its existence, I do not know. "
"</i>"
msgstr "<i>고타쉬와 선택받은 자들이 그 존재를 어떻게 알게 됐는지는 나도 모른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 9364a60f-ea41-f4db-d223-f8512a070c59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:9364a60f-ea41-f4db-d223-f8512a070c59
msgctxt "h98ab8551g02f0g461egbf3fg7a66c2ac4183"
msgid ""
"<i>I'm glad you think so. I agree. But there is one thing you have that I do "
"not.</i>"
msgstr "<i>그렇게 생각한다니 기쁘군. 동의한다. 하지만 너에겐 한 가지 내게 없는 게 있지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Karlach
#. NodeID = 93c85d1b-94b4-44f9-9bb4-9ec1bb4e60ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:93c85d1b-94b4-44f9-9bb4-9ec1bb4e60ff
msgctxt "ha9dfc67cg7475g4fcfga021g798eeefde7e2"
msgid "A mind flayer? How is this possible? Gods, we've been so... blind."
msgstr "마인드 플레이어? 어떻게 이럴 수가. 젠장, 우린 정말 눈이 멀었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 95d3075b-941f-9e1c-4f5a-e11b44581d73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:95d3075b-941f-9e1c-4f5a-e11b44581d73
msgctxt "h33af710dg9f2bg4690g840dga321028073e4"
msgid ""
"<i>They were close to breaking my hold on their prince - and if they had "
"succeeded, we would be lost.</i>"
msgstr "<i>친위대는 왕자에 대한 내 집중을 거의 깰 뻔했다. 성공했으면, 우린 졌겠지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 98430392-3f74-7fd6-8037-67c9dde849b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:98430392-3f74-7fd6-8037-67c9dde849b5
msgctxt "h705900a9g26c7g4446gbef0gf09797958af6"
msgid "<i>You have already benefited from that tadpole of yours. </i>"
msgstr "<i>넌 이미 네 올챙이가 주는 혜택을 누리고 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = 9ac7e20d-b7b9-7156-0e11-7bb27f13024c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:9ac7e20d-b7b9-7156-0e11-7bb27f13024c
msgctxt "h64b5a7e2gb1f0g4267ga153g665d474e06ac"
msgid "I always suspected you were a mind flayer."
msgstr "난 계속 네가 마인드 플레이어라고 추측하고 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = 9e51a807-a7ac-e197-928c-142d2d081571
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:9e51a807-a7ac-e197-928c-142d2d081571
msgctxt "ha1e76536g769cg49a7ga477gdf010515b07a"
msgid "<i>Rather them than potential future allies... like you.</i>"
msgstr "<i>미래에 동맹이 될만한... 너 같은 사람보단 낫겠지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = a005dbcc-9eaa-7380-1749-10ed0aa49ef3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet_GlobeReformed = True
#.   Tag:
#.      - AVATAR(1) = True
#. SetFlags:
#.   Global:
#.     - INT_EmperorRevealed_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:a005dbcc-9eaa-7380-1749-10ed0aa49ef3
msgctxt "h138f721dgb617g40c9ga1d1gcf192c28e151"
msgid "<i>Don't look at me like that. </i>"
msgstr "<i>그렇게 쳐다보지 마라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = a19a2666-8ba2-7e49-bd17-a662d6730a4c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Event_GiveAstralTadpole(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:a19a2666-8ba2-7e49-bd17-a662d6730a4c
msgctxt "hb277840fgbf7dg472bg82abgead33994e14f"
msgid "<i>Look after it. Use it when you are ready to evolve.</i>"
msgstr "<i>잘 돌봐주다가, 진화할 준비가 됐을 때 사용해라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = a245c6c2-5402-4ebe-b6e9-28f6afc2c18e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:a245c6c2-5402-4ebe-b6e9-28f6afc2c18e
msgctxt "hd12dfbd5g7a8eg4419ga295gde802befcffa"
msgid "<i>Do as it says.</i>"
msgstr "<i>손을 내민다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = a43eee9a-adad-5072-2c2d-99de9746b685
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:a43eee9a-adad-5072-2c2d-99de9746b685
msgctxt "h91f0fdc4g91a9g447aga17bgcc343c2eeda0"
msgid "<i>Probe at the tadpole's intentions.</i>"
msgstr "<i>올챙이의 의도를 탐사해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = a7238efb-47e3-41ce-3b25-6c247a7e0817
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = False
#. SetFlags:
#.   Global:
#.     - INT_EmperorRevealed_HasMet_GlobeReformed = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:a7238efb-47e3-41ce-3b25-6c247a7e0817
msgctxt "h7aead84fg243bg4f44ga699g5f01d0cfa229"
msgid ""
"<i>But you are not the one I wish to speak with. Bring me your leader.</i>"
msgstr "<i>그런데 내가 대화하고 싶은 건 너의 리더다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = a748b9ba-2604-c185-54fd-776367e7c716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:a748b9ba-2604-c185-54fd-776367e7c716
msgctxt "hefa1d4c4ge8b8g4117ga9dfg125e1ed15dd8"
msgid ""
"<i>It has been a burning need within me for as long as I can remember. </i>"
msgstr "<i>그건 내가 기억할 수 있는 가장 오랜 시절부터 내 안에 이글거리는 욕구다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = a9e79691-2527-a95b-8448-bde43b6119e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:a9e79691-2527-a95b-8448-bde43b6119e6
msgctxt "h91410c65g7febg478cgb376gc1ad95a474d6"
msgid "Do it. I'd like to evolve."
msgstr "<i>좋아. 난 진화하겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = ac0fbc9c-59c8-be32-48c1-f1d6dc64ede4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet = True
#.   Tag:
#.      - ILLITHID(1) = True
#.      - PARTIAL_CEREMORPH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ac0fbc9c-59c8-be32-48c1-f1d6dc64ede4
msgctxt "h0d837e19g6259g4dfegb247gb8ce0a208f57"
msgid ""
"<i>There is nothing further I can do for you right now. Consider using my "
"gift. </i>"
msgstr "<i>더이상 네게 해줄 일은 없다. 선물을 사용해라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = ac0fbc9c-59c8-be32-48c1-f1d6dc64ede4
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet = True
#.   Tag:
#.      - ILLITHID(1) = True
#.      - PARTIAL_CEREMORPH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ac0fbc9c-59c8-be32-48c1-f1d6dc64ede4
msgctxt "h5127a1cbge512g4a7aga8adg8e89dedf9fed"
msgid ""
"<i>Consider using the tadpole. Your evolution will be a benefit to us "
"both.</i>"
msgstr "<i>올챙이를 사용해라. 너의 진화는 우리 둘에게 도움이 될 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = ae785683-d390-cf6e-ff4e-63f195f4cd83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = False
#. SetFlags:
#.   Dialog:
#.     - INT_EmperorRevealed_KnowsAboutPrism(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ae785683-d390-cf6e-ff4e-63f195f4cd83
msgctxt "h1ab1b518ga4beg4959g848bg42275f92b0a9"
msgid "How did Gortash and the other Chosen find out about the Astral Prism?"
msgstr "고타쉬랑 다른 선택받은 자들이 어떻게 아스트랄 프리즘에 대해 알게 되었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = b03cbbb9-b8ed-97df-f7c7-84d2a7122dc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_FirstDaisyDream_AskedWhoAreYou(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b03cbbb9-b8ed-97df-f7c7-84d2a7122dc9
msgctxt "h5d2b8e45gea71g4af4g9ecegff8c07200777"
msgid "I ask again - who are you? And I'm going to need a name this time."
msgstr "한번 더 물어야겠네. 넌 누구야? 이번엔 이름을 대라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b055c368-ce8e-af3b-dc54-cde8b4c96730
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b055c368-ce8e-af3b-dc54-cde8b4c96730
msgctxt "h8433a22cg49d8g4486g9880g665ae566b394"
msgid ""
"<i>I do not have the privilege of knowing the answer, but the consequences "
"are clear enough. </i>"
msgstr "<i>그 대답을 알 기회는 없었지만, 따라온 결과는 분명하게 알 수 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b06efae3-c747-4629-b9dd-b673f07936e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Daisy_State_RejectedPartialIllithidTransformation(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b06efae3-c747-4629-b9dd-b673f07936e8
msgctxt "h6a391724g8ca9g4af3g8b64g53db616deb3c"
msgid "<i>Was it something I said? Never mind.</i>"
msgstr "<i>내가 말한 것 때문에 그런건가? 잊어버려라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b0e6e08d-6b80-0279-a9dc-fbdeca29b0d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b0e6e08d-6b80-0279-a9dc-fbdeca29b0d9
msgctxt "h78bffe63geab2g45efgb512g822d89b9fcfb"
msgid ""
"<i>I felt that. It's your nature. You cannot fight it, so - embrace it. </i>"
msgstr "<i>나도 느꼈다. 이건 네 본능이다. 저항할 수 없지. 받아들여라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = b24eae1d-09dc-582d-b617-961433f51cb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_AstralPrison_State_SpokeWithDaisy = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b24eae1d-09dc-582d-b617-961433f51cb0
msgctxt "hfa6347c9gdf02g4e90g8364g516f8abaf671"
msgid "You were in the Prism all this time? Why did you deceive me?"
msgstr "여태까지 계속 프리즘 속에 있었던 거야? 왜 날 속인 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b3543f0e-b297-4263-e085-3a71c260f92d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b3543f0e-b297-4263-e085-3a71c260f92d
msgctxt "hfe7a77cfga050g4e37gb132g7b7bd08981a1"
msgid ""
"<i>My original body was destroyed when I transformed. Yours continues to "
"limit you.</i>"
msgstr "<i>내 원래 육체는 탈바꿈하면서 파괴되었다. 네 육체는 너를 제한하고 있지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b57f9911-7f83-a17e-1d5c-93883c34688b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet_GlobeReformed = True
#.   Tag:
#.      - AVATAR(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b57f9911-7f83-a17e-1d5c-93883c34688b
msgctxt "haef8f873g1102g4046g8abcg475202164b89"
msgid "<i>You are not the leader. I will speak with your leader.</i>"
msgstr "<i>넌 리더가 아니다. 너의 리더와 대화하겠다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b57f9911-7f83-a17e-1d5c-93883c34688b
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet_GlobeReformed = True
#.   Tag:
#.      - AVATAR(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b57f9911-7f83-a17e-1d5c-93883c34688b
msgctxt "hfc200060g96ebg4fe9g925eg4119c5228eb8"
msgid "<i>Bring me your leader.</i>"
msgstr "<i>리더를 데려와라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b57f9911-7f83-a17e-1d5c-93883c34688b
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet_GlobeReformed = True
#.   Tag:
#.      - AVATAR(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b57f9911-7f83-a17e-1d5c-93883c34688b
msgctxt "h598557fdgb217g4c83g9764g134740e57718"
msgid "<i>I will only speak with the one in charge.</i>"
msgstr "<i>나는 책임자와만 대화할 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b681c4a3-ac46-4c0c-26a1-beb75559b640
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Laezel = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b681c4a3-ac46-4c0c-26a1-beb75559b640
msgctxt "hc4a18eddg2e4cg499dga925g5a626bc713ac"
msgid ""
"<i>Vlaakith wanted his power, but Orpheus rose against her. And so she "
"sealed him and his honour guard within this Prism.</i>"
msgstr ""
"<i>블라키스는 그의 힘을 원했다. 오르페우스는 대항했지만, 결국 이 프리즘 안에 봉인됐다. 그의 친위대들도 함께 구속됐지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = b7e0d1c3-e7b2-28ec-0cbf-b5a778bb7bc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:b7e0d1c3-e7b2-28ec-0cbf-b5a778bb7bc6
msgctxt "habcd4342gf2e0g42b7g9532g66edc194a525"
msgid ""
"<i>The answer is twofold. One - I can, but it would kill you. As I told you "
"before. </i>"
msgstr "<i>두 개의 답을 해줄 수 있겠군. 첫째. 할 수 있지만 널 죽이게 될 것이다. 예전에 말했었지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = bdd732ae-b38b-6a1d-32a5-a90a43ecbea3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:bdd732ae-b38b-6a1d-32a5-a90a43ecbea3
msgctxt "h6bab4eaag4f09g45f2gb5dcgb345b27de266"
msgid "<i>I appreciate that. But this is what I am. </i>"
msgstr "<i>고맙게 생각하지만, 나는 마인드 플레이어다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = be362b0d-ff05-66fa-e2b7-64e216a33938
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:be362b0d-ff05-66fa-e2b7-64e216a33938
msgctxt "hcfc15960g37fdg421aga7edg3fd2dddbb98e"
msgid "<i>We fought to tame Prince Orpheus, the son of Gith herself. </i>"
msgstr "<i>우린 오르페우스를 길들이려고 싸웠다. 그 기스의 아들이지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = bf86e128-e99c-7494-73a8-da72f0b8c80d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:bf86e128-e99c-7494-73a8-da72f0b8c80d
msgctxt "h5d099e16g60dcg4eabg96beg8a776889739d"
msgid ""
"<i>That Gortash and the Chosen found out about it... this is impossible to "
"explain.</i>"
msgstr "<i>고타쉬와 선택받은 자들이 알게 된 건... 설명이 불가능해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = c14791a1-c5b8-1466-7144-11368a799a6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c14791a1-c5b8-1466-7144-11368a799a6e
msgctxt "he2df93a2g6934g4923gbe8eg5b81b44a3a06"
msgid ""
"<i>On the contrary, Vlaakith is quite fallible. Not all githyanki eyes are "
"so clouded as yours.</i>"
msgstr "<i>반대로, 블라키스가 완벽한 게 아닐 수도 있지. 모든 기스양키의 눈이 네 눈처럼 흐린 게 아니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = c22eccd5-8a72-2b67-08de-554e0902dd1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c22eccd5-8a72-2b67-08de-554e0902dd1e
msgctxt "h89b70db7g4fb9g4c05ga77agc344a3c70ac6"
msgid "<i>You may call me the Emperor.</i>"
msgstr "<i>황제라고 불러도 좋다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = c3aa6ef6-0af4-493b-8cbb-8f42e1154781
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f840b590-dc13-d3df-e03c-e58611d62e86_LaezelInclusion2 = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c3aa6ef6-0af4-493b-8cbb-8f42e1154781
msgctxt "h98bb8375gd013g4979gaf35ga47af90ea1bc"
msgid "Control him? <i>Tsk'va</i> - you must return him to his people!"
msgstr "제어한다고? <i>츠크바</i>. 그를 우리 민족에게 돌려줘야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Gale
#. NodeID = c3ab79e0-fc33-457e-9209-19abb97ec548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c3ab79e0-fc33-457e-9209-19abb97ec548
msgctxt "h4c6da0dfgea48g4a16g9d7cge67f093715a4"
msgid "A mind flayer? Not the saviour I'd been hoping for."
msgstr "마인드 플레이어? 내가 기대했던 구세주는 아닌데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = c46f0fe4-805c-664e-e639-d6718253cbf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tadpole_Event_AstralTouchedTadpoleEaten = True
#.      - INT_EmperorRevealed_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c46f0fe4-805c-664e-e639-d6718253cbf5
msgctxt "h3ece42cdge695g4730gbf40gb17738ca1b67"
msgid ""
"<i>Since you ingested my gift instead of using it, there is nothing further "
"I can do for you right now. Proceed.</i>"
msgstr "<i>네가 내 선물을 사용하는 대신 소화해버렸으니, 지금 당장 네게 해줄 일은 없다. 진행하라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = c4bef31f-1cd8-982f-b06a-54b764b364b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DAISY_FEARTRACK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c4bef31f-1cd8-982f-b06a-54b764b364b6
msgctxt "h528f6d65ga5f1g4be1gb464g1dcc32c473db"
msgid ""
"<i>We have had our disagreements - but in the end you always do what needs "
"to be done.</i>"
msgstr "<i>의견 차이는 좀 있었지만, 결국 넌 언제나 해야 할 일을 하는군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = c5803d58-ce30-4e27-8116-6851c63ef937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c5803d58-ce30-4e27-8116-6851c63ef937
msgctxt "h0c57030fg2998g41cdg8511gfd6df2bfd0ee"
msgid "It's obscene - to owe my life to a damned <i>ghaik</i>."
msgstr "정말 불경하군. 내 목숨을 <i>게이크</i>에게 빚지다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = c6540f81-c2e4-248c-b61e-6bec90e293b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Tadpole_Event_AstralTouchedTadpoleEaten = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c6540f81-c2e4-248c-b61e-6bec90e293b9
msgctxt "ha0b9043fg6205g4251g8f0cge1c97291d327"
msgid "<i>Eat it.</i>"
msgstr "<i>먹는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = c76194e0-e674-cfc7-a84d-92ad935f0a0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c76194e0-e674-cfc7-a84d-92ad935f0a0d
msgctxt "h6b8075e9gbb9fg4234gad67gd495941e9693"
msgid "<i>Waste. Utter waste.</i>"
msgstr "<i>낭비. 절대적인 낭비다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = c7a6bb99-dde5-b142-16cd-3f6febc5903e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f840b590-dc13-d3df-e03c-e58611d62e86_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c7a6bb99-dde5-b142-16cd-3f6febc5903e
msgctxt "h323d2a0dg1285g44d9ga0e1g5835dbb9563d"
msgid "<i>Quite possible, I assure you.</i>"
msgstr "<i>가능하다. 내가 보장한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = c923f7ad-ff43-10d2-5a17-7a35135290ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:c923f7ad-ff43-10d2-5a17-7a35135290ce
msgctxt "h7ffd3c7eg189dg44bag87a6g31b976242fd3"
msgid "<i>No. </i>"
msgstr "<i>아니.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = ca139952-d55d-ca59-3371-db975a283c8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ca139952-d55d-ca59-3371-db975a283c8d
msgctxt "h1fc02713g5b14g4261ga487ge65bbe74bb89"
msgid "<i>Denial will change nothing. </i>"
msgstr "<i>부정은 아무것도 바꾸지 못해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = ca548811-1bfb-4518-99d0-d0f26802bdef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f840b590-dc13-d3df-e03c-e58611d62e86_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ca548811-1bfb-4518-99d0-d0f26802bdef
msgctxt "hb49833e2gda63g4b50gb7acg2e65ce300df0"
msgid ""
"Orpheus? <b>Impossible</b>. He was slain by <i>Jhe'stil Kith'rak</i> himself!"
msgstr "오르페우스? <b>불가능해.</b> 그는 <i>제스틸 키스락</i>에게 살해당했는데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = cb24a228-56bf-d752-b778-d2ce6c2214e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_State_PartialCeremorph(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:cb24a228-56bf-d752-b778-d2ce6c2214e4
msgctxt "h086e9300gfc9dg44f0g9217gb3aa18b79f95"
msgid ""
"*A coldness seeps through your veins as the tadpole awakens, its yearning "
"almost unbearable. Your mind is a veritable feast.*"
msgstr "*올챙이가 각성하며 냉기가 혈관을 타고 퍼집니다. 그 갈망이 너무나 강렬합니다. 당신의 정신은 풍성한 연회입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = cc34abb8-f7f7-7228-584b-f1e4c6ead0b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:cc34abb8-f7f7-7228-584b-f1e4c6ead0b1
msgctxt "haf731b1dga0a8g4312gadc3g5a109c63e2fe"
msgid ""
"<i>You carry a tadpole. As far as Orpheus is concerned, you are already "
"illithid - a sworn enemy. Just like me.</i>"
msgstr "<i>넌 올챙이를 지니고 있고, 오르페우스에겐 그저 숙적인 일리시드일 뿐이다. 나와 같지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = cf15ab94-ae2d-37fc-eba5-144c89a65183
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:cf15ab94-ae2d-37fc-eba5-144c89a65183
msgctxt "hc770633eg2250g4242g9995g45e5eb7580a3"
msgid ""
"<i>My needs were sated. I was... happy. For a while. Until my true nature "
"was discovered by the tyrant himself - Lord Gortash.</i>"
msgstr "<i>내 욕구는 충족됐다. 나는... 행복했지. 잠시 동안은. 그러다 내 정체를 폭군, 고타쉬가 알아냈다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = d28be1d0-3b82-d4ea-046a-6760ea65d6a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:d28be1d0-3b82-d4ea-046a-6760ea65d6a8
msgctxt "hb6002e37g613fg4f82g8f15g4c3421f774ab"
msgid "<i>What are you -</i>"
msgstr "<i>뭐하는...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = d2a409df-a319-eb14-83d6-37623543c5bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:d2a409df-a319-eb14-83d6-37623543c5bd
msgctxt "hd21237c8g65f1g468agb43fg0dda5402977c"
msgid ""
"<i>I believe we'll have a better chance of defeating the elder brain if you "
"embrace your latent illithid potential.</i>"
msgstr "<i>너에게 잠재된 일리시드의 힘을 수용한다면 엘더 브레인을 이길 확률이 증가할 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = d34f5165-69c9-8e03-aa8b-1117dafaa313
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:d34f5165-69c9-8e03-aa8b-1117dafaa313
msgctxt "h3d6921bbg8e41g4700ga9d5gda8cf0caaf79"
msgid "What is it?"
msgstr "이게 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = d38fc85c-23b4-4020-60e5-dd09e80240ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:d38fc85c-23b4-4020-60e5-dd09e80240ad
msgctxt "h213ae78dg7f3dg4044g9b64g407e4ba63537"
msgid "What would that entail?"
msgstr "그게 뭘 의미하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = d51c7099-7e0e-3a17-c1f8-d247dcb87bfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:d51c7099-7e0e-3a17-c1f8-d247dcb87bfb
msgctxt "h39e36e25gb232g4a37g9e47g226b63b7ec39"
msgid ""
"<i>And you will soon see that the benefits outweigh any perceived loss. </i>"
msgstr "<i>그리고 곧 눈에 띄는 손해를 훨씬 능가하는 이득을 보게 될 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = d57a426a-db35-13ec-9154-a22bb95b595d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:d57a426a-db35-13ec-9154-a22bb95b595d
msgctxt "h6c1d21b5gf70ag4452gbf66g5dc7af8195ba"
msgid ""
"<i>All I needed to do was subdue the githyanki and find allies in the outer "
"world. You.</i>"
msgstr "<i>내가 해야 할 일은 저 기스양키를 제압하고 바깥세상에서의 동맹을 찾는 거였지. 바로 너.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = daf47102-5d86-87f7-0df2-03325f919e73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet = True
#.   Tag:
#.      - ILLITHID(1) = True
#.      - PARTIAL_CEREMORPH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:daf47102-5d86-87f7-0df2-03325f919e73
msgctxt "h36f25920g4810g4d9eg9c8cg15ea0b1bc4ee"
msgid "<i>Feels wonderful, doesn't it? You wear it well. </i>"
msgstr "<i>훌륭한 기분이지, 안 그런가? 잘 적응했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = daf47102-5d86-87f7-0df2-03325f919e73
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_HasMet = True
#.   Tag:
#.      - ILLITHID(1) = True
#.      - PARTIAL_CEREMORPH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:daf47102-5d86-87f7-0df2-03325f919e73
msgctxt "h2a8cd147g925eg4a39ga919gc53463fc3f3d"
msgid "<i>Go to the city. Try out your new form. Enjoy it. </i>"
msgstr "<i>도시로 가서 새 형태를 시험해봐라. 즐겨라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = db163405-e75a-5db8-8aa7-21d266e99a94
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Event_GiveAstralTadpole(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:db163405-e75a-5db8-8aa7-21d266e99a94
msgctxt "ha1bbae05g0c36g4f02gb4f5g03d09f02a142"
msgid ""
"<i>Understandable. It's a big decision. Keep it until you're ready. </i>"
msgstr "<i>이해할 수 있다. 큰 결정이니, 준비될 때까지 가지고 있어라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Nightwarden Minthara
#. NodeID = dd5965b3-de07-9952-723a-ac52e855cb11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:dd5965b3-de07-9952-723a-ac52e855cb11
msgctxt "hf2a05d7dgaf6cg4637ga7f6g7242fc603dd1"
msgid "An unnerving revelation. But if this is our protector, so be it."
msgstr "힘빠지는 사실이군. 하지만 이게 우리의 수호자라면 그러라고 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = dec7a606-9230-4e7e-6464-6f3194d86d5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:dec7a606-9230-4e7e-6464-6f3194d86d5d
msgctxt "h675cab03g7da1g408ag9d00gab232d784fb8"
msgid "A <i>ghaik</i> illusion, an abomination - as I've suspected."
msgstr "<i>게이크</i> 환상, 혐오체. 내 예상대로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = df888c20-1c58-4e00-11ac-4d0e419ab3a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:df888c20-1c58-4e00-11ac-4d0e419ab3a9
msgctxt "hea48c717g3c2eg4c73gadbcge975b3b7ada2"
msgid ""
"<i>Perhaps you will be more inclined to try it when you see more of what our "
"enemy can do.</i>"
msgstr "<i>네 적들이 뭘 할 수 있는지 보게 되면 마음을 바꾸게 될 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = dfdedef8-5e4d-80cd-c5bd-773b929093ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:dfdedef8-5e4d-80cd-c5bd-773b929093ac
msgctxt "he657c0eegbc4bg48bbg8504g923248828608"
msgid ""
"*Your nature is no longer your own - you are well on your way to fulfilling "
"your illithid potential. You are ready to evolve.*"
msgstr ""
"*당신의 본성은 더 이상 당신의 것이 아닙니다 - 당신은 일리시드로서의 잠재력을 전부 발휘할 갈림길에 서 있습니다. 당신은 진화할 준비가 "
"되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = e3a78bd5-1c19-0621-f5ce-2b32d35ea4a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Knows_AstraltouchedTadpoleReusable(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:e3a78bd5-1c19-0621-f5ce-2b32d35ea4a7
msgctxt "h3bbd27e8g57ceg4b34g96fag4832deebdd37"
msgid ""
"<i>It has enough vitality to further your evolution and your allies'. </i>"
msgstr "<i>올챙이는 너와 네 동료 모두의 진화를 성장시킬만한 생명력이 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = e4a35d98-2b1e-58d5-b827-60ac14b34d36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.      - INT_EmperorRevealed_KnowsAboutBattle(1) = True
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:e4a35d98-2b1e-58d5-b827-60ac14b34d36
msgctxt "hae33afa8ge152g4e12g92d3gc2c091beb7c4"
msgid "What happens if we free Orpheus?"
msgstr "<i>오르페우스를 풀어주면 어떻게 되지?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = e56cd8d6-f300-1d98-a176-42a8dd89564f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:e56cd8d6-f300-1d98-a176-42a8dd89564f
msgctxt "hecac72eegad70g4343g8b2fgb90c1a1c4d95"
msgid "<i>Even those who are on a path of becoming one.</i>"
msgstr "<i>마인드 플레이어가 되어가고 있는 사람인데도 말이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = e5765136-d6c1-938f-4f69-7ad88eb4a331
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:e5765136-d6c1-938f-4f69-7ad88eb4a331
msgctxt "hdf85c611gf334g4545g9d50g3717698b4631"
msgid "Tell me everything."
msgstr "모든 걸 들을 준비 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Shadowheart
#. NodeID = e5798abd-80df-4e3d-8d48-ffd27e2736ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:e5798abd-80df-4e3d-8d48-ffd27e2736ef
msgctxt "h9f6601a6gc119g4becg898cgad570d265e54"
msgid "Of all the beings to be indebted to... a bloody mind flayer."
msgstr "모든 존재 중에서... 망할 마인드 플레이어에게 빚지다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Halsin
#. NodeID = e5fff949-a885-4fae-8940-256c433e0ad8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:e5fff949-a885-4fae-8940-256c433e0ad8
msgctxt "h4e1c5f23gf726g4879g9192g02ac2a637439"
msgid ""
"To owe one's life to a mind flayer? It seems to make mockery of this entire "
"struggle."
msgstr "마인드 플레이어에게 목숨을 빚졌다고? 이 모든 발버둥을 조롱하는 거 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = e740018e-54ab-4b3a-b0bd-fb8eada4f59c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:e740018e-54ab-4b3a-b0bd-fb8eada4f59c
msgctxt "h6d3cdd5ag2c23g4afdg97fbgd838eaf6ed7c"
msgid ""
"I don't understand. The histories claim the prince was burned to ash in the "
"skies."
msgstr "이해할 수 없군. 역사에서는 왕자가 하늘에서 불타 재가 되었다고 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Nightwarden Minthara
#. NodeID = eb732e82-1067-d9c4-5fd1-2fdf2c625d7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(12) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:eb732e82-1067-d9c4-5fd1-2fdf2c625d7e
msgctxt "h77ec4663g199cg4700g85adg03c84f34d0ec"
msgid ""
"A little more caution would be wise. Such power is tempting, but you risk "
"losing yourself."
msgstr "좀 더 신중히 하는 게 좋아 보인다. 그런 힘은 유혹적이지만 너 자신을 잃을 위험이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = eb88ea21-f635-4dfd-6351-a25ce9c9181b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:eb88ea21-f635-4dfd-6351-a25ce9c9181b
msgctxt "h4b294cccg838eg4b08gad28g13e2a577bfb6"
msgid "I prefer the other version of you."
msgstr "난 다른 버전의 네가 더 좋은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = ec065fe7-7d3c-cc63-03f0-6acb9f1e6980
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ec065fe7-7d3c-cc63-03f0-6acb9f1e6980
msgctxt "ha512ac18g6192g44fcg9d75g91546ab3e182"
msgid "Yes."
msgstr "그렇다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = ee9e3724-cb18-c9da-7f40-b09ede89ee9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.      - INT_EmperorRevealed_KnowsAboutBattle(1) = True
#.      - INT_EmperorRevealed_KnowsAboutPrism(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ee9e3724-cb18-c9da-7f40-b09ede89ee9e
msgctxt "h544f1df1g4fceg45f9gb1d9gdab92dc66829"
msgid "Could we kill Orpheus and seize his power?"
msgstr "오르페우스를 죽이고 힘을 가지면 안 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = ef83b3ab-7c9c-06a0-1d2a-44b16c0e1331
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:ef83b3ab-7c9c-06a0-1d2a-44b16c0e1331
msgctxt "h1eac9452gdf86g421agaa24g606fb44fbd7d"
msgid "<i>My original body was destroyed when I transformed. </i>"
msgstr "<i>내 원래 육체는 탈바꿈하면서 파괴되었다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f08d9ef7-d226-1a67-05fc-59be8c5c1be9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f08d9ef7-d226-1a67-05fc-59be8c5c1be9
msgctxt "h351d9c77g4406g4ffdg8416g30b8a631d17d"
msgid ""
"<i>When I first escaped from the elder brain, I searched for a new vessel. "
"But the longer I inhabited this one, the more it grew on me. </i>"
msgstr ""
"<i>처음 엘더 브레인으로부터 도망쳤을 때, 나는 새로운 그릇을 찾으려고 했다. 하지만 이 몸으로 오래 있을수록 점점 마음에 들기 "
"시작하더군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f0f1ebe1-6750-123a-a96d-6aca8d7531ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f0f1ebe1-6750-123a-a96d-6aca8d7531ff
msgctxt "h0137c708gf9b8g43fbg8a25gcb4392a81e13"
msgid ""
"<i>I've been studying you for a while now. I believe I can trigger the next "
"stage of your tadpole's lifecycle while continuing to preserve your "
"independence. </i>"
msgstr "<i>한동안 너를 관찰한 결과, 네 독립성을 유지하면서 올챙이의 생명 주기를 다음 단계로 촉발할 수 있다고 믿는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f1cca821-5d0e-642a-b5c9-a39590867ef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f1cca821-5d0e-642a-b5c9-a39590867ef0
msgctxt "h4ddf95feg7297g4cc2g82abg8217de98aab7"
msgid "<i>You are... exquisite. </i>"
msgstr "<i>넌... 훌륭해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f223d37a-fda4-cdd1-7a70-49c8c0407aa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f223d37a-fda4-cdd1-7a70-49c8c0407aa2
msgctxt "hd3d8b20cgfbfbg4849gb87fg9a7be77c79c3"
msgid "<i>You will be able to do things you never thought were possible. </i>"
msgstr "<i>이전엔 절대 불가능하다고 여겼던 것들을 할 수 있게 된다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Lae'zel
#. NodeID = f29e1501-61a2-499d-a839-c6866b0265f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f29e1501-61a2-499d-a839-c6866b0265f5
msgctxt "h1af2163agc915g41a1gb0f0gc6118a647384"
msgid ""
"Vlaakith is eternal! My people would not be swayed by this... this <i>false "
"prince</i>."
msgstr "블라키스 님은 영원하시다! 내 민족이 이.. 이 <i>가짜 왕자</i>에게 흔들릴 리가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f34eedf6-d5c8-663e-ae24-96fb83292b90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f34eedf6-d5c8-663e-ae24-96fb83292b90
msgctxt "h8eb433a8g02b4g496fgb113g5af3432e2324"
msgid "<i>And found the githyanki. </i>"
msgstr "<i>그리고 저 기스양키를 발견했지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = f40b8c9a-d1dc-9169-90ef-2a3e0506b321
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.      - INT_EmperorRevealed_KnowsAboutBattle(1) = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f40b8c9a-d1dc-9169-90ef-2a3e0506b321
msgctxt "h0a0d53b7gd1beg4e18g9160g977c6813358d"
msgid ""
"<i>Ghaik</i> lies, the whole lot. Orpheus is dead. The history is written!"
msgstr "<i>게이크</i>의 거짓말. 전부 다. 오르페우스는 죽었다. 역사가 말해준다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = f4a2d1c8-7632-7610-bfbc-756c73115f30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Laezel = True
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f4a2d1c8-7632-7610-bfbc-756c73115f30
msgctxt "h909ef358gce3cg41fdg9262g1f8a701464d8"
msgid "Why did Orpheus refuse to aid Vlaakith?"
msgstr "오르페우스가 블라키스를 돕는 걸 거부한 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = f4a2d1c8-7632-7610-bfbc-756c73115f30
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Laezel = True
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = False
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f4a2d1c8-7632-7610-bfbc-756c73115f30
msgctxt "h70df1850g860bg48b9g9f10g9dea31cd4169"
msgid "Why did Orpheus refuse to aid Queen Vlaakith?"
msgstr "오르페우스가 블라키스 여왕님을 돕는 걸 거부한 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f5cd2a18-449c-71ca-dec7-3621fe3b186a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - INT_EmperorRevealed_Event_PlayerRefusedToHelpEmperor = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f5cd2a18-449c-71ca-dec7-3621fe3b186a
msgctxt "h0a93f344ga3afg4b0dg9d97g08c1507be728"
msgid "<i>I am a mind flayer, yes. And the one who saved you. Again. </i>"
msgstr "<i>그래. 난 마인드 플레이어다. 그리고 널 구해줬지. 이번에도.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f6074e1f-809a-c93f-7f04-c363344f5925
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f6074e1f-809a-c93f-7f04-c363344f5925
msgctxt "ha238ea9bg999ag4f3bgb9c9gd5eaf499bcc5"
msgid "<i>Don't look at me like that.</i>"
msgstr "<i>그렇게 쳐다보지 마라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f60af87e-c283-2308-7a45-5c55d83d14b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f60af87e-c283-2308-7a45-5c55d83d14b0
msgctxt "hec8d8e8fgc5b2g4ec5gbfa7gac0b9d2ab278"
msgid ""
"<i>That Orpheus lives at all is ruinous to Vlaakith - she has done "
"everything in her power to keep his existence a secret.</i>"
msgstr ""
"<i>오르페우스의 생존은 블라키스에게 큰 해를 입힐 수 있지. 그녀는 모든 수단을 동원해서 그의 존재를 비밀에 부쳤을 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = f6e58b3b-554d-d275-1722-57e717769389
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - INT_EmperorRevealed_Knows_AstraltouchedTadpoleReusable(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f6e58b3b-554d-d275-1722-57e717769389
msgctxt "h162ce77ag7ba0g4c03ga86dg919b34e12c58"
msgid ""
"<i>You <b>and</b> your allies - it has enough vitality to nourish you all - "
"to further your evolution.</i>"
msgstr "<i>너<b>와</b> 네 동료. 올챙이는 모두의 진화를 성장시킬만한 생명력이 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = f9479fdc-7f9f-32c5-eb33-c417b44b823a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - INT_EmperorRevealed_KnowsOrpheus(1) = False
#.      - INT_EmperorRevealed_KnowsAboutBattle(1) = False
#. SetFlags:
#.   Dialog:
#.     - INT_EmperorRevealed_KnowsOrpheus(1) = True
#.     - INT_EmperorRevealed_KnowsAboutBattle(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f9479fdc-7f9f-32c5-eb33-c417b44b823a
msgctxt "hefa21a9dg33beg430bga8d9g97d04c246a65"
msgid "So are you going to tell me what this battle was about?"
msgstr "그래서 이 전투가 뭐에 대한 거였는지 알려줄 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Jaheira
#. NodeID = f9ef89ee-77cc-46bc-996d-abb129bc3b23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:f9ef89ee-77cc-46bc-996d-abb129bc3b23
msgctxt "h8eb92c05gd63ag4c78g9674g818286053b55"
msgid ""
"And so we should swoon and offer a kiss, abomination? I would not even know "
"where to plant it."
msgstr "그래서 우리가 매료되어서 키스라도 해야 하나, 혐오체? 어디다 해야 할지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Wyll
#. NodeID = fa8f64d9-171e-4745-a8bb-2eeec9b27d95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:fa8f64d9-171e-4745-a8bb-2eeec9b27d95
msgctxt "h8aa1b7ccgc012g4df1g9d71g9e8cd3214523"
msgid ""
"By the living gods - no more visions, no more lies. I expect answers. "
"<i>Now.</i>"
msgstr "맙소사. 더 이상의 환상이나 거짓말은 그만둬. 난 해답을 원해. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = fbb6f768-e102-34d5-8f63-fccc07d6d73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:fbb6f768-e102-34d5-8f63-fccc07d6d73c
msgctxt "h1aefd5a4g9419g424agbd25g903c55de829e"
msgid ""
"<i>People referred to me as the Emperor - such was my influence. Though, of "
"course, they had no idea what I really was.</i>"
msgstr "<i>사람들은 나를 황제라고 불렀고, 그게 내 영향력이었다. 물론 내 진짜 정체는 아무도 몰랐지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = The Emperor
#. NodeID = fbb92f62-f0d2-b15e-9cda-9793f8a4e600
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:fbb92f62-f0d2-b15e-9cda-9793f8a4e600
msgctxt "h5c81730fge3ebg46adgbd73g891efbba9b2e"
msgid ""
"<i>A tadpole, nurtured by the psionic energy of the Astral Plane. Cocooned "
"here for millennia, it has become extraordinary.</i>"
msgstr "<i>올챙이. 아스트랄 차원의 정신 에너지를 공급받으며 자랐지. 수천 년 동안 고치 상태로 있었기에 더 특출나다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Narrator
#. NodeID = fbf9bc67-b2d8-89e3-5ba3-9cf0d43da8cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:fbf9bc67-b2d8-89e3-5ba3-9cf0d43da8cb
msgctxt "h264f2dc1g9689g4856g8836g94c27e6435ce"
msgid ""
"*You may resist now, but it's too late. You already embraced the powers the "
"parasite gave you. You leveraged them to manipulate, to dominate, to "
"<i>survive</i>.*"
msgstr ""
"*저항하려면 할 수도 있겠지만, 이제는 너무 늦었습니다. 당신은 이미 기생충의 힘을 받아들였습니다. 조종하고, 지배하고,  "
"<i>살아남기</i> 위해서.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus
#. Speaker = Player
#. NodeID = fccdce01-f287-c687-83f5-3bc39a83411e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AfterOrpheus:fccdce01-f287-c687-83f5-3bc39a83411e
msgctxt "ha6319ea7g8e9eg474fgaf82g08da77037c8a"
msgid "I'm nothing like you."
msgstr "나는 너랑 달라."

