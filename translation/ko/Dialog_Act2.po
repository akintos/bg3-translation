msgctxt "h958adc68gf3bcg4597g9d7bg0144d95d799b"
msgid "Ketheric is vulnerable - all we need to do is strike."
msgstr "케서릭은 취약해졌어. 이제는 놈을 공격하기만 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
