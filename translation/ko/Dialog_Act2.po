#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_E = False
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_F = False
