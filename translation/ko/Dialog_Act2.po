#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:bd0397f0-13f2-0dc9-2725-96a99ba19a85
msgctxt "hcf8b27c8gd917g47d0g8c53g6f60380e6b11"
msgid "The boat is free. <i>Hurry.</i>"
msgstr "배 풀렸어. <i>서둘러.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
