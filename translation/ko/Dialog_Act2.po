msgid "The master surgeon's will is my honour."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_ResponseToSurgeon_003_Combat
#. Speaker = Sister Anya
#. NodeID = 215c319b-8d32-478c-8601-44528b22ced2
