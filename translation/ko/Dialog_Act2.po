msgctxt "hc111b85fgc4a6g4a98gb19eg6a5732c80d8b"
msgid "*Whine.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_FoodPrepComment
#. Speaker = Linsella
#. NodeID = 48d8541d-beda-40f8-a7cd-faf941968f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_FoodPrepComment:48d8541d-beda-40f8-a7cd-faf941968f9b
msgctxt "h2f7f13a6gcc1ag4a35g9a05gb17a078e834b"
msgid ""
"Much better, Tomelia! A little bloody for our tastes, but you're getting "
"there."
msgstr "훨씻 낫구나, 토밀리아! 약간은 피맛이 나긴 한다만, 그래도 나아지고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_FoodPrepComment
#. Speaker = Linsella
#. NodeID = 67caae7d-72b8-41af-9acf-fb2cbd05c493
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_FoodPrepComment:67caae7d-72b8-41af-9acf-fb2cbd05c493
msgctxt "h23b1145ag3083g4262gbb2bg1b8597ae7753"
msgid ""
"I still see some bone in there, my love - remember that we don't all have "
"teeth as big as yours."
msgstr "여전히 뼈가 좀 들어간 게 보이네. 모두가 너처럼 큰 이빨을 갖고 있지 않다는 걸 명심하렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_FoodPrepComment
#. Speaker = 'Tomelia'
#. NodeID = 67dde4a2-8e2f-4a9a-8199-f26ae69cc3e1
