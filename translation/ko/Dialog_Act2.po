#.     - ORI_Gale_BalthazarLab_Event_TakeIngredients(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:4eb508af-3c7b-639c-79cb-9d513de313d1
msgctxt "h987944f6gf376g43c4gbd8cgdaf76ca21729"
msgid "<i>Pick up the ingedients. Craft the Shadow Lantern.</i>"
msgstr "<i>재료를 집어 든 다음 그림자등불을 만든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 5c7207e6-9046-8336-0d00-929bc8dea5ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:5c7207e6-9046-8336-0d00-929bc8dea5ef
msgctxt "heb62173eg49f3g49bcga745g3634e3d2387d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = 6127d60d-103f-4a22-e508-d7077cefe40c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ORI_GALE_MYSTRABLESSED(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:6127d60d-103f-4a22-e508-d7077cefe40c
msgctxt "hf0cbd86eg554ag4ea7gabf9ga056160fcb70"
msgid ""
"*You feel a tingle run down your spine. A thrill, or a shudder? When such "
"power is now yours to command, does it really matter?*"
msgstr ""
"*당신은 등줄기에 퍼지는 오싹함을 느낍니다. 짜릿함일까요, 혹은 전율일까요? 이제 당신이 그런 힘을 휘두를 수 있는 상황에, 그게 정말 "
"중요한가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 61587f7d-6c7f-5239-b34a-46bb13ddb3a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
