msgid "The subject resists. Next instrument, good sister."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon_InstrumentRequest_003_Combat
#. Speaker = Sister Anya
#. NodeID = 9b195864-cd07-42fd-a115-6e2fb724a4a5
