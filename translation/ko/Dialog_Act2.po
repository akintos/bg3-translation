#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:e41199be-000a-4870-8f72-f9fa34042a33
msgctxt "h7f1aaec1gd06cg4f06g8312geeb7ff0e1b74"
msgid "These shadows will be the death of me..."
msgstr "이 그림자 때문에 죽게 생겼군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = e41199be-000a-4870-8f72-f9fa34042a33
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_B = True
#. SetFlags:
