msgctxt "h605974d8gc8feg45a3gb208gef87d9a9a402"
msgid "About damn time!"
msgstr "빨리 좀 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = bd1d93ef-028e-31c7-9190-fbfc54c56930
