msgctxt "h47987f61g44e6g484cg8dbfgbfbdb9442279"
msgid "<i>So</i> close. But I'm still winning."
msgstr "<i>아까워라</i>. 그래도 여전히 내가 이기고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Hiding
#. Speaker = Oliver
#. NodeID = b2349e9f-80f3-47fd-98fc-345624241de2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 670691d1-78cb-7a29-2c96-f537d9b6a439_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Hiding:b2349e9f-80f3-47fd-98fc-345624241de2
msgctxt "h5bcf69ebg4fefg4d74g8ec3g90432a424f59"
msgid "Hehe. Think you can find me...?"
msgstr "헤헤. 날 찾을 수 있으려나...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Hiding
#. Speaker = Oliver
#. NodeID = e8414afd-d180-41e4-8080-34263e9fa420
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 670691d1-78cb-7a29-2c96-f537d9b6a439_C = True
#. SetFlags:
#.   Local:
#.     - 670691d1-78cb-7a29-2c96-f537d9b6a439_A = False
#.     - 670691d1-78cb-7a29-2c96-f537d9b6a439_B = False
#.     - 670691d1-78cb-7a29-2c96-f537d9b6a439_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Hiding:e8414afd-d180-41e4-8080-34263e9fa420
msgctxt "h26fed6f8g8297g4842g916bg103393c1acf7"
msgid "Come on, are your eyes even open?"
msgstr "빨리, 눈을 뜨고 있긴 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied
#. Speaker = Oliver
#. NodeID = 011200a4-cc26-444d-9efa-f40d5ba79c14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 22cdc707-b62c-d042-aa54-66666b7f055f_A = True
#. SetFlags:
#.   Local:
#.     - 22cdc707-b62c-d042-aa54-66666b7f055f_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied:011200a4-cc26-444d-9efa-f40d5ba79c14
msgctxt "h86715efeg3502g4821g9622g344be6bbb16e"
msgid "Why can't you just play nice?"
msgstr "그냥 착하게 놀면 안 돼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied
#. Speaker = Oliver
#. NodeID = 8c852219-54c5-4082-a673-e629cfc84d3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 22cdc707-b62c-d042-aa54-66666b7f055f_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied:8c852219-54c5-4082-a673-e629cfc84d3d
msgctxt "he89a10d9g041fg4225g826bge5a1d05b613b"
msgid "No, you're ruining it!"
msgstr "안돼, 네가 다 망치고 있잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied
#. Speaker = Oliver
#. NodeID = ab6fea9b-75b2-47c9-8149-c20888a4349d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 22cdc707-b62c-d042-aa54-66666b7f055f_B = True
#. SetFlags:
#.   Local:
#.     - 22cdc707-b62c-d042-aa54-66666b7f055f_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied:ab6fea9b-75b2-47c9-8149-c20888a4349d
msgctxt "h8130d259g107ag42c4g96c1gd01963aefbbc"
msgid ""
"You don't deserve nice things. Maybe you'll get some not-so-nice things."
msgstr "넌 착하게 대해줄 필요가 없어. 나쁜 짓을 당해도 싸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied
#. Speaker = Oliver
#. NodeID = e8a2596b-5d52-4555-9c17-88b6cb3679b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 22cdc707-b62c-d042-aa54-66666b7f055f_C = True
#. SetFlags:
#.   Local:
#.     - 22cdc707-b62c-d042-aa54-66666b7f055f_A = False
#.     - 22cdc707-b62c-d042-aa54-66666b7f055f_C = False
#.     - 22cdc707-b62c-d042-aa54-66666b7f055f_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_PlushDied:e8a2596b-5d52-4555-9c17-88b6cb3679b3
msgctxt "h6e865d18g0579g49dfga869g286b0007f838"
msgid "Stop breaking my toys!"
msgstr "내 장난감을 부수지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_StartOfFight
#. Speaker = Oliver
#. NodeID = 4617d23e-4bfe-4d61-9526-ed052b1eb065
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_StartOfFight:4617d23e-4bfe-4d61-9526-ed052b1eb065
msgctxt "h0df6ca61geda6g4f1aga326g472f21a6879c"
msgid "Spoil my fun? I'll teach you a lesson - just you watch."
msgstr "내 놀이를 방해해? 후회하게 해줄게. 잘 보고 배워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_StartOfFight
#. Speaker = Oliver
#. NodeID = a7702a82-6d92-40c2-a335-15e4ac37295a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_StartOfFight:a7702a82-6d92-40c2-a335-15e4ac37295a
msgctxt "ha694a94eg6018g40c4g8dcdg0a2915fcac7f"
msgid "You should have just left me alone!"
msgstr "그냥 날 건들지 말았어야지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush
#. Speaker = Oliver
#. NodeID = 4f9897ca-e017-4033-adbf-1e2af05b680f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8f819d41-e936-8042-1935-56de252d6c7f_A = True
#. SetFlags:
#.   Local:
#.     - 8f819d41-e936-8042-1935-56de252d6c7f_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush:4f9897ca-e017-4033-adbf-1e2af05b680f
msgctxt "hab6ebccage517g483bgbe4dg3876640e64b4"
msgid "We're not done playing yet."
msgstr "우리 놀이는 아직 안 끝났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush
#. Speaker = Oliver
#. NodeID = 74a7826b-eec8-44b5-ac85-0810875e971b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8f819d41-e936-8042-1935-56de252d6c7f_B = True
#. SetFlags:
#.   Local:
#.     - 8f819d41-e936-8042-1935-56de252d6c7f_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush:74a7826b-eec8-44b5-ac85-0810875e971b
msgctxt "h087f3021g30c3g405bg9645g058857660edd"
msgid "Don't you like my toys? Give them another try."
msgstr "내 장난감이 마음에 안 들어? 다시 갖고 놀아봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush
#. Speaker = Oliver
#. NodeID = 971b081e-1353-4962-e254-345caaf002a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8f819d41-e936-8042-1935-56de252d6c7f_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush:971b081e-1353-4962-e254-345caaf002a9
msgctxt "h5ca34cd4g8d6ag4db9gb0b8g6d7dd4d2bf56"
msgid "You want to play? Let me show you my favourite toy."
msgstr "놀고 싶어? 내가 제일 좋아하는 장난감을 보여줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush
#. Speaker = Oliver
#. NodeID = f07007f7-858a-4132-ad85-d635c788d03a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8f819d41-e936-8042-1935-56de252d6c7f_C = True
#. SetFlags:
#.   Local:
#.     - 8f819d41-e936-8042-1935-56de252d6c7f_C = False
#.     - 8f819d41-e936-8042-1935-56de252d6c7f_B = False
#.     - 8f819d41-e936-8042-1935-56de252d6c7f_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_SummoningPlush:f07007f7-858a-4132-ad85-d635c788d03a
msgctxt "hd2809008g994bg4dfcg9015g06cd77410ca1"
msgid "I can do this forever and ever. Just you see."
msgstr "난 이걸 영원히 반복할 수 있어. 잘 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 0cf449be-b34d-abf4-5b4d-40def8824585
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:0cf449be-b34d-abf4-5b4d-40def8824585
msgctxt "hfe4a8dccg1b42g4f09g8d71ga381bb62cd4a"
msgid ""
"Of course he'll want you back - it's nature's will. You're meant to be "
"together."
msgstr "당연히 네가 돌아오길 원하지. 자연의 뜻이야. 너희는 함께할 운명이야. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 0e6a0b96-9cd8-269b-0ee0-250b12c24ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:0e6a0b96-9cd8-269b-0ee0-250b12c24ef1
msgctxt "hd6d91ad4g2753g4584g9df1g6f0582ab6019"
msgid "People are dying for the sake of your fun, kid."
msgstr "네 즐거움을 위해 사람이 죽어가고 있단다, 꼬마야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 1433d74c-eeb4-d016-422e-d96e4f4bd760
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:1433d74c-eeb4-d016-422e-d96e4f4bd760
msgctxt "h8a044a1agb47dg4a1fga8bcge0ce1aefc001"
msgid ""
"So I wouldn't have to be alone anymore? He'd stay with me? Play with me?"
msgstr "그럼 혼자 있을 필요 없어? 나랑 있어 줄까? 같이 놀아 줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 1b5d2803-da49-b9fc-234e-7d44284f1ccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:1b5d2803-da49-b9fc-234e-7d44284f1ccd
msgctxt "he7b356a6g8800g499dgabd4g84708bddb558"
msgid "Even when it was scary. Even when I was alone. I didn't give up."
msgstr "무서웠을 때도. 외로웠을 때도. 난 포기 안 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = 1d6e64b5-9ce0-cb38-b5cd-d01eeb9422ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:1d6e64b5-9ce0-cb38-b5cd-d01eeb9422ba
msgctxt "h0cd725dcgc5a7g42efgb762g13208ce43ce7"
msgid ""
"It's done, at last. Soon the land will be unshrouded. We should return to "
"Thaniel when we can."
msgstr "마침내 끝났군. 곧 이 땅에 드리운 그림자는 걷힐 걸세. 어서 테니엘한테 돌아가도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 29a9d6be-3189-9f43-8dc0-d590b7113dda
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_State_OliverAgreedToReturnToThaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:29a9d6be-3189-9f43-8dc0-d590b7113dda
msgctxt "h165a9ee6gb19bg44b5g99ebg783e05052bad"
msgid ""
"Maybe that's for the best. I'm tired. Nobody real wants to play me - they "
"only want Thaniel. They can have him."
msgstr "그게 제일 좋겠네. 난 지쳤어. 아무도 나랑 진짜 놀고 싶어 하지 않아. 테니엘만 원해. 이제 가질 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 2db84f60-262a-bf9b-40b1-b971266eba43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:2db84f60-262a-bf9b-40b1-b971266eba43
msgctxt "hf3b846cfgd6d2g4d08g8795g579fabc078f1"
msgid "Enough coddling. You're going back to Thaniel - now."
msgstr "달래주기도 지치는군. 테니엘한테 돌아가라. 지금 당장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 32651ec4-7aeb-424b-3208-2951fdf96e7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:32651ec4-7aeb-424b-3208-2951fdf96e7e
msgctxt "h1629487cg0ebag456dgbc7fg7c59cd8a9135"
msgid ""
"You're just a thieving shadow that thinks it's a child. Playtime's over - "
"Thaniel's waiting."
msgstr "넌 꼬마의 형체를 흉내 내는 그림자에 불과해. 놀이 시간은 끝이다. 테니엘이 기다려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 3923ae72-bc5f-f2d4-0081-874b912c94c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:3923ae72-bc5f-f2d4-0081-874b912c94c4
msgctxt "h4780c06cgd323g4035g9d22gf6c74503350a"
msgid ""
"I'd like that. And he would too, I think. All right, I'll do it. I <i>want </"
"i>to do it."
msgstr "좋아. 걔도 좋아하겠지. 그래, 나 할게. <i>하고 싶어</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 3a33798f-493b-0c15-bfd9-33b74d374574
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:3a33798f-493b-0c15-bfd9-33b74d374574
msgctxt "h0672c64eg207fg423dg9b20g79acbdab28e8"
msgid ""
"Change is good. That's what growing up is all about. Together, you two will "
"become more than you were before."
msgstr "변한다는 건 좋은 거야. 그게 성장이라는 거란다. 둘이 함께면 더욱 성장할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = 439ad1c6-5f34-97c5-8776-5cb39181123e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:439ad1c6-5f34-97c5-8776-5cb39181123e
msgctxt "h4ddbfecdg9e05g4ef1gae96g1ce4cab9ea33"
msgid ""
"But you need not be alone any longer. You need not invent friends. Thaniel "
"is back. He is waiting for you."
msgstr ""
"하지만 더 이상 네가 홀로 남아 있을 필요가 없다. 더 이상 상상의 친구를 만들어낼 필요도 없어. 테니엘이 돌아왔고, 널 기다리고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 4f33410c-7610-2c6d-aa7d-5a59da7dc4fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:4f33410c-7610-2c6d-aa7d-5a59da7dc4fc
msgctxt "h3a070f08g9cccg4973g8dd2gf21f59932107"
msgid ""
"You have what you want, but not what you need: Thaniel. He's your friend, "
"your kin - he's <i>you</i>."
msgstr "네가 가졌지만 너한텐 필요없는 게 있어. 테니엘이야. 걘 네 친구, 가족이야. 걘 <i>너</i>야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = 55ce947c-00c6-331f-396a-22602bbb0f7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:55ce947c-00c6-331f-396a-22602bbb0f7e
msgctxt "hefc5815egeae3g46efgb10ag77d690c6f39d"
msgid "I said <i>gentle</i>."
msgstr "<i>격식을 차려달라</i> 했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 5c72a61e-5890-6e3f-2a19-7f6d1d94519a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ec18c1a1-4a24-a06a-c5e1-1d1e0ca1051f_HalsinInclusionOccurred = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:5c72a61e-5890-6e3f-2a19-7f6d1d94519a
msgctxt "h86ca9d20gca01g4628gbfb2g63e885b8c878"
msgid ""
"Are you crying? You're a bit big to be crying... but I suppose that's okay."
msgstr "우는 거야? 덩치도 크면서... 그치만 울어도 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 67f8a20f-c39a-b788-0890-ce4db4a3ac0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:67f8a20f-c39a-b788-0890-ce4db4a3ac0b
msgctxt "h4a391c87gab8ag4e04gb1bdg90e53dda5f33"
msgid "But would he even want me back...? I've changed. A lot."
msgstr "그치만 걔가 날 받아들여 줄까...? 난 너무, 많이 변했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 6864cb96-86cb-6893-0ae5-bc0a8e1fb698
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:6864cb96-86cb-6893-0ae5-bc0a8e1fb698
msgctxt "h15116715gfd2eg4539g9b1fg31a3c2e4d2f4"
msgid ""
"I told you already - nobody dies here. They come back, over and over, a "
"little different every time."
msgstr "이미 말했잖아, 아무도 안 죽어. 그냥 돌아오는 거야, 계속, 매번 조금씩 다르게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 7d2c35fd-4ece-c217-44d1-949980a32f9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:7d2c35fd-4ece-c217-44d1-949980a32f9c
msgctxt "hcf18b09agf2c3g41b9g9a93g3ded63f8cdff"
msgid "Talk to him, Halsin. You know what needs to be said better than anyone."
msgstr "말씀하시지요, 할신. 당신이라면 무슨 말을 해야 할 지 누구보다 잘 알고 있을 테니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 814cc060-ad2a-12e7-fc9a-f1468b09d6be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:814cc060-ad2a-12e7-fc9a-f1468b09d6be
msgctxt "hf0da024dg4ab4g4f07ga01dg3c85aa32baf7"
msgid "I'm not leaving - you can't make me!"
msgstr "안 갈 거야. 무슨 말을 해도!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 8e16a856-883c-0880-8685-53e5163d7e1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:8e16a856-883c-0880-8685-53e5163d7e1e
msgctxt "h6131b20dg3283g4ebdg9c2ag79be294cae8f"
msgid "...Fine. I'll do it. It might be nice to be with him again."
msgstr "...알았어. 돌아갈게. 녀석과 다시 함께하게 된다면 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 8e2d3aec-4c5c-ca16-27e0-71a7b1c61937
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:8e2d3aec-4c5c-ca16-27e0-71a7b1c61937
msgctxt "h9162445fg1ea2g4ccega3b0g4f4e8690651a"
msgid "Of course he will. You're bound to each other - always."
msgstr "그럼 물론이지. 너희는 연결되어 있었단다. 언제나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 91267c37-888c-d497-c18e-992cab135574
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:91267c37-888c-d497-c18e-992cab135574
msgctxt "h809f3ebege610g4bc0ga791g4a394f2c3ab3"
msgid "Why should I go back to him? He abandoned me!"
msgstr "왜 내가 그 녀석한테 돌아가야 하는데요? 그 녀석은 절 버렸단 말이에요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 92f23c4c-31b1-e005-19cf-aceadec3b576
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_State_OliverAgreedToReturnToThaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:92f23c4c-31b1-e005-19cf-aceadec3b576
msgctxt "h6969b8d0g1b51g48bagbf63ge21963438b1a"
msgid "I hope you're nicer to Thaniel than you are to me."
msgstr "네가 테니엘에겐 좀 더 잘 대해주길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 9b46bac2-1e1c-b27c-63df-53d2a6fadb00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:9b46bac2-1e1c-b27c-63df-53d2a6fadb00
msgctxt "hc358b5f0g806eg4757ga373g076557d7c36e"
msgid ""
"You don't have to leave. All you have to do is lend Thaniel your strength."
msgstr "넌 떠나지 않아도 좋아. 그저 테니엘에게 네 힘을 빌려주기만 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = 9bc2a07c-9d2b-dd42-1508-0f2cc48e4548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:9bc2a07c-9d2b-dd42-1508-0f2cc48e4548
msgctxt "h6ab69c26g7880g4701ga970g246436db7018"
msgid ""
"Nobody's to blame here. The curse tore you two apart - now you can be "
"reunited."
msgstr "네 탓이 아니야. 저주가 둘을 갈라 놓은 거지. 이제 합칠 때가 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = 9cc67e16-81d1-3740-c184-0c4b0f3ba939
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:9cc67e16-81d1-3740-c184-0c4b0f3ba939
msgctxt "h2bd9c507g318cg4583ga29age36f1a14911c"
msgid ""
"You're a bad winner, but you're still a winner. I'll go - you've taken "
"everything that I cared about."
msgstr "넌 끔찍한 승자야, 그래도 승자는 승자니까. 가면 되잖아. 내가 아끼는 건 네가 다 가져갔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = a0e631a2-e8e4-c3d6-8ee4-b6bacfe49379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:a0e631a2-e8e4-c3d6-8ee4-b6bacfe49379
msgctxt "h099e9f8bg246dg4393gaf95g7525d6544233"
msgid ""
"But<i> I </i>don't change, not really. So maybe I won't come back. Maybe the "
"game will end with me."
msgstr "하지만 <i>나는</i> 그리 바뀌지 않아. 그러니 나는 돌아오지 못하겠지. 나와 함께 놀이도 끝나겠지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = a36d538d-3a5e-818b-064d-bb83538dc24c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:a36d538d-3a5e-818b-064d-bb83538dc24c
msgctxt "h472e0bccg9540g40dbgae96gdb4b66fc60b4"
msgid "It shall be done."
msgstr "그리하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = b070f722-3a64-d8e1-d172-6f62ff351cb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:b070f722-3a64-d8e1-d172-6f62ff351cb5
msgctxt "ha77eca11g960bg44ebg9f06g616a46a03f17"
msgid ""
"Thaniel was my friend also. I played with him, grew up while he stayed the "
"same. He made me who I am today, and then he was ripped away from me, same "
"as for you."
msgstr ""
"내게 있어서도 테니엘은 친구였다. 나는 테니엘과 함께 어울려 놀았었고, 녀석이 그 모습 그대로 남아있는 사이 나는 이렇게 자라 버렸지. "
"테니엘 덕분에 지금의 내가 있을 수 있었지만, 나도 너처럼 그를 잃고 말았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = b6d22405-ca11-bb0f-7d01-09f7a6d400e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:b6d22405-ca11-bb0f-7d01-09f7a6d400e6
msgctxt "hde97ba04g0c0fg475egbfb3g36aa4a62b299"
msgid ""
"Oliver. Nobody is making you leave - this is your <i>home</i>. But it is "
"dark, empty... lonely. I don't want you to be alone. I want you to be with "
"Thaniel."
msgstr ""
"올리버. 누구도 너를 이곳에서 쫓아내려 하는 게 아니다. 이곳은 네 <i>집</i>이야. 하지만 지금 이 곳은 어둡고, 공허하고... "
"쓸쓸하지. 난 네가 홀로 남기를 원하지 않는다. 난 네가 테니엘과 함께 있어 주길 바란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = bc0bf5d4-8a21-9f10-164d-eed23ed54a9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:bc0bf5d4-8a21-9f10-164d-eed23ed54a9b
msgctxt "h7a715b78gc3a2g4923gb647gf7f495b4edd6"
msgid ""
"So I wouldn't have to make up friends to play with anymore? I'd have someone "
"<i>real</i>?"
msgstr "그럼 이제 친구 지어내기 안 해도 되는 거야? <i>진짜</i> 친구 생기는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = c681413a-6ba7-cdaf-bd47-606f504fb21c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:c681413a-6ba7-cdaf-bd47-606f504fb21c
msgctxt "h2efa9cbfgfa96g4283gbf5bgfa585011591f"
msgid ""
"It's done. More cruelly than it needed to be, but done all the same. We "
"should return to Thaniel when we can."
msgstr "끝났군. 필요 이상으로 잔인하긴 했지만, 어쨌든 결과는 같네. 테니엘에게 돌아가서 뭘 할 수 있는지 살펴보세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = c8f9d80b-4648-5faa-06b4-17352914a08b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ec18c1a1-4a24-a06a-c5e1-1d1e0ca1051f_HalsinInclusionOccurred = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:c8f9d80b-4648-5faa-06b4-17352914a08b
msgctxt "h9d23ec87ge27ag48d3g87f0g724e2990fb04"
msgid "Well done."
msgstr "잘했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = c9cad21d-4dff-4ab5-4e16-70cf641951f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:c9cad21d-4dff-4ab5-4e16-70cf641951f5
msgctxt "h1522802fg6e79g4aa7g8eebg0dc6e5bfdfaa"
msgid ""
"He's nothing to me. He left me here, all this time. I had to do everything "
"for myself!"
msgstr "난 신경 안 써. 걘 여태 나를 여기 버렸어. 내 앞가림을 해줄 사람은 나밖에 없었어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Player
#. NodeID = cbc30fb5-9801-7d69-6bf6-abb60bbe58ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:cbc30fb5-9801-7d69-6bf6-abb60bbe58ab
msgctxt "ha4c37fe0g7035g4bcagaf5cg2c8aece4aa80"
msgid ""
"You were very brave and resourceful. Think of how much you'll be able to "
"help Thaniel."
msgstr "넌 아주 용감하고 똑똑했어. 네가 얼마나 테니엘을 도와 줄 수 있을지 생각해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = d4668dec-f15f-b59f-c33f-f5aee6769e21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:d4668dec-f15f-b59f-c33f-f5aee6769e21
msgctxt "h9441edf7ge4f3g4dafg9f5eg7003b246340f"
msgid "You didn't need to be so hard on him."
msgstr "그렇게 가혹하게 굴 필요는 없지 않았나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = d6977b53-54be-0b6c-4a76-01041ff859b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:d6977b53-54be-0b6c-4a76-01041ff859b9
msgctxt "ha6879e0bg09f9g4d1dga521gb2b8e44207f4"
msgid ""
"Nobody dies here. They always come back to play with me, just a little "
"different each time."
msgstr "아무도 안 죽어. 늘 나랑 놀러 다시 와 줘, 매번 조금씩만 달라져서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = d8c26d1a-4814-47d6-8902-9a7286fe3a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:d8c26d1a-4814-47d6-8902-9a7286fe3a56
msgctxt "h3de79ed9g491ag4ea3ga47ag96baaf270588"
msgid "Be gentle. He's much more than a child, but he doesn't truly know that."
msgstr "부드럽게 대해주게. 보통 꼬마애가 아니니까. 본인은 못 깨달았지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = d9bdbd1b-5107-2264-f267-ad8f9457521f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:d9bdbd1b-5107-2264-f267-ad8f9457521f
msgctxt "h834b05f2g7a59g4af1g9c70g48bbea133805"
msgid ""
"Why couldn't you just leave me alone? Why can't I just stay here, playing? I "
"had everything I've ever wanted, right here, and you've ruined it!"
msgstr "날 좀 내버려 두면 안 돼? 여기서 놀면서 지내면 좀 안 돼? 내가 원하는 건, 다 여기 있단 말야. 네가 망쳤어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Halsin
#. NodeID = e3dedcd8-cde8-1144-e67b-99eee037c406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:e3dedcd8-cde8-1144-e67b-99eee037c406
msgctxt "hb47f56ccg47c2g44fdgb054g23cc39854c62"
msgid ""
"No - you were stolen from each other. Neither of you are to blame. And I "
"know your pain. I truly do."
msgstr "그렇지 않아. 너희는 서로를 빼앗겨 버린 것이고, 어느 쪽에게도 그에 대한 책임은 없다. 난 네 고통을 이해한다. 진심으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance
#. Speaker = Oliver
#. NodeID = fe19d6f3-41e1-efce-2fd6-818c77b597b0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_State_OliverAgreedToReturnToThaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_Acceptance:fe19d6f3-41e1-efce-2fd6-818c77b597b0
msgctxt "h78d08734g8a4bg474cg8b66g22a8aae8e736"
msgid "Bye. And thank you for playing with me."
msgstr "안녕. 나랑 놀아줘서 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 1b676049-88ca-445e-a497-556ef20aefa2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:1b676049-88ca-445e-a497-556ef20aefa2
msgctxt "h46534bc1gb568g49e1ga336gf26dd9212788"
msgid ""
"Flowers blooming in darkness - the sign the musky bear-fellow mentioned."
msgstr "어둠 속에서 꽃이 피어나고 있어 - 북실거리는 곰 양반이 말한 징조야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 1b676049-88ca-445e-a497-556ef20aefa2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:1b676049-88ca-445e-a497-556ef20aefa2
msgctxt "hbfd307d5ge596g442dg9a07g1d14d6136d4b"
msgid "Flowers blooming in shadow. Exactly what Halsin said to look out for."
msgstr "그림자 속에서 피는 꽃. 할신이 찾아보라고 한 그 꽃이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 1b676049-88ca-445e-a497-556ef20aefa2
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#.   Tag:
#.      - REALLY_HALSIN(0) = False
#. SetFlags:
#.   Global:
#.     - SCL_LiftingTheCurse_Event_SpottedFlowers = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse:1b676049-88ca-445e-a497-556ef20aefa2
msgctxt "h4a20a5a4g4b29g4e68g9a8ag6c5907fb345b"
msgid ""
"A pocket of nature, thriving in the darkness. Just as Halsin predicted..."
msgstr "어둠 속에서 번성하는, 자연의 일부. 할신이 예측한 대로야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 1b676049-88ca-445e-a497-556ef20aefa2
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
