msgctxt "h98910018gb109g458cga25bg64d42f56faef"
msgid "*You try to hold it in, but that only makes it worse.*"
msgstr "*당신은 참으려고 하지만 자꾸 웃음이 새어나옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = f193b6a6-04c5-1867-f7d8-e36b95a85f8b
