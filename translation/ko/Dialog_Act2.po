msgctxt "h5d07d22ag5c36g46b7ga4d9g3f016bb90192"
msgid "There's truth in you, stranger."
msgstr "너에게 진실함이 있구나, 이방인."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = f5ae33a4-c991-956b-abd6-0e82700060aa
#. HandlePath = TaggedText[0].TagText[0]
