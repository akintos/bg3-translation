msgctxt "h3679eeb3g8c89g4bedgb515g5acbc1486e6f"
msgid "Intruder! COME!"
msgstr "침입자다! 이리로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_AD_Bark
#. Speaker = Squire
#. NodeID = e6b84425-d8f6-c3cb-b1d2-d8f0d1697084
