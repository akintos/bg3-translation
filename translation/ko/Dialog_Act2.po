msgctxt "h3f50118bgc6d3g4772gb142gb916aa3f0378"
msgid ""
"Dark Justiciars fell here. Those signs we saw before were no coincidence - "
"they led us here."
msgstr "다크 저스티시어 여럿이 이곳에서 목숨을 잃었어. 전에 보았던 징후는 우연이 아니었던 거야. 그자들이 우리를 이곳으로 인도했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_TempleSuspicion
#. Speaker = Shadowheart
#. NodeID = 1b85afb7-65c1-4c27-b86f-2b77ab81238f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_TempleSuspicion:1b85afb7-65c1-4c27-b86f-2b77ab81238f
msgctxt "h80a5db74g6919g499eg8e38g63c0383bd8d0"
msgid "Curious. Part of me thought there'd be more to this place..."
msgstr "흥미로운데. 확실하진 않지만 뭔가 더 있겠는걸..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains
#. Speaker = Shadowheart
#. NodeID = 5a66e1c8-cc2b-4ce1-8a4d-c3c9add19e20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_TownCorpseHint = True
#.   Object:
#.     - ORI_Shadowheart_HasMet_JusticiarRemains(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains:5a66e1c8-cc2b-4ce1-8a4d-c3c9add19e20
msgctxt "hcd52feb7g6998g4abdg8af1gff3233a50393"
msgid "A Dark Justiciar fell here, I'm certain of it..."
msgstr "다크 저스티시어 한 사람이 이곳에서 쓰러졌어. 분명해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains
#. Speaker = Shadowheart
#. NodeID = 6b610871-59f8-47cc-bd8f-e334ce7ef02a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - ORI_Shadowheart_Knows_JusticiarDream = True
#.   Object:
#.      - ORI_Shadowheart_HasMet_JusticiarRemains(0) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_TownCorpseHint = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains:6b610871-59f8-47cc-bd8f-e334ce7ef02a
msgctxt "h4d362e3fgb1deg4fb9g817fg252ac5511705"
msgid "More signs of Dark Justiciars. They must have had a stronghold nearby."
msgstr "다크 저스티시어의 징후가 더 있어. 분명 근처에 근거지가 있었을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains
#. Speaker = Shadowheart
#. NodeID = 9f61db0a-df94-4599-8dc9-8a79b3b004e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Shadowheart_HasMet_JusticiarRemains(0) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_TownCorpseHint = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains:9f61db0a-df94-4599-8dc9-8a79b3b004e9
msgctxt "h92a0146dg6b77g4205g97bcg7a426aa5a2ff"
msgid "More Dark Justiciar relics. This is no coincidence."
msgstr "다크 저스티시어 유물이 더 있어. 이건 우연이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains
#. Speaker = Shadowheart
#. NodeID = bbae798a-2ebd-4a9a-a1c7-8309d6a82324
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - ORI_Shadowheart_State_DarkJusticiarSuspicion = True
#.   Object:
#.      - ORI_Shadowheart_HasMet_JusticiarRemains(0) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_TownCorpseHint = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains:bbae798a-2ebd-4a9a-a1c7-8309d6a82324
msgctxt "heb6f6108g8121g46b2g84a1gd19f1fcf3be0"
msgid ""
"More signs of Dark Justiciars. Lady Shar is guiding us to something, but "
"what...? Got to keep looking."
msgstr "다크 저스티시어의 흔적이 더 있어. 샤님게서 우리를 무언가로 인도하는 거야. 하지만 대체 뭘까...? 계속 눈여겨봐야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_TempleSuspicion
#. Speaker = Shadowheart
#. NodeID = ca83ec39-bf25-4b57-8229-3145305433e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - ORI_Shadowheart_Knows_JusticiarDream = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_TempleSuspicion:ca83ec39-bf25-4b57-8229-3145305433e7
msgctxt "h89cd0ab8g15fdg4138gbec2g47de1baff451"
msgid ""
"There's more to this place, I'm sure of it. Lady Shar's presence is near..."
msgstr "이 장소엔 뭔가 더 있어, 확실해. 샤 여신님의 존재가 가까워..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains
#. Speaker = Shadowheart
#. NodeID = f0c41fbf-b6bd-4131-a070-0d0fae8f506f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - ORI_Shadowheart_Knows_JusticiarDream = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_TownCorpseHint = True
#.   Object:
#.     - ORI_Shadowheart_HasMet_JusticiarRemains(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Shadowheart_PAD_DarkJusticiarRemains:f0c41fbf-b6bd-4131-a070-0d0fae8f506f
msgctxt "h0656b0d1gf495g4df0g9c89gb2e23d247f8f"
msgid ""
"Signs of fallen Dark Justiciars. This can't be a coincidence - they must "
"have originated from somewhere nearby."
msgstr "쓰러진 다크 저스티시어의 흔적이 곳곳에 있어. 이게 우연일 리 없어. 이자들은 분명 가까이 있는 어딘가에서 왔을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SiegeRemains_State_PassedHistoryCheck = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
msgctxt "h696059cdg86dfg4f39gac62g160267e48554"
msgid ""
"These siege weapons are a good century old, I'd say. <i>Quite</i> the "
"vintage."
msgstr "이 공성 무기들은 나이로 치면 백 살은 먹은 것 같네. <i>아주</i> 푹 익었겠어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SiegeRemains_State_PassedHistoryCheck = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
msgctxt "h529f642cg3385g4ceega71dg22f53f6e82d6"
msgid "Siege weapons - centuries old from the looks of it."
msgstr "공성 무기다. 보아하니 백 년쯤은 된 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SiegeRemains_State_PassedHistoryCheck = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
msgctxt "h2846a371g30a8g4358gbb7eg1e87fce6ddda"
msgid ""
"These siege engines... it's like walking into a military history book. A "
"century old, I'd say."
msgstr "이 공성 병기들 좀 봐... 군사 역사책 속으로 걸어들어온 것 같군. 백 년쯤은 됐겠어.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SiegeRemains_State_PassedHistoryCheck = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
msgctxt "ha13060d9gefb7g45b3gae28gdfbaf7edb487"
msgid ""
"These war implements could go in a museum, if they weren't half-rotten. A "
"century old, I'd say."
msgstr "박물관에서나 볼법한 전쟁 무기들이로군. 여기 있는 것들은 반쯤 썩어버렸지만. 백 년은 됐겠는걸.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SiegeRemains_State_PassedHistoryCheck = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
msgctxt "h1d226e14g22e8g4c7eg96bbg61574b3a9350"
msgid ""
"Siege weapons like this have been out of use for a hundred years - maybe "
"more."
msgstr "이 공성 병기들은 마지막으로 쓰인 게 백 년도 넘은 거 같은데 - 더 오래됐을 수도 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SiegeRemains_State_PassedHistoryCheck = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
msgctxt "h0ee18b96g5b89g4253g99dbgf727d7c9ae65"
msgid "Siege weapons. Looks like they haven't been touched in a hundred years."
msgstr "공성 병기네. 백 년 동안은 쓰인 적이 없어 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SiegeRemains_State_PassedHistoryCheck = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:21eeb0d0-e206-41b8-89d0-ebd3f1c8483f
msgctxt "he9959cc0g02c6g4a33g9decgdb13bffae59e"
msgid ""
"Pickets, ballistas, siege engines... a little old-fashioned, too. A hundred "
"years? More?"
msgstr "말뚝, 노포, 공성 병기들... 좀 오래된 것 같은데. 백 년? 더 옛날인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 6d7ce90d-0c2b-6026-2c89-1a3fe79b200d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_JAHEIRA(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:6d7ce90d-0c2b-6026-2c89-1a3fe79b200d
msgctxt "hd8006a9agb9ceg4e1ega490g2a99ae386aaa"
msgid ""
"I remember this spot. Our siege engines stood on top of those towers, once."
msgstr "이 장소가 기억이 나는군. 한때 이 공성 병기들은 탑 위에 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = 83c3c1bb-13f9-eac0-3ba1-f537d7212979
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:83c3c1bb-13f9-eac0-3ba1-f537d7212979
msgctxt "hfd13a7a9g08bbg43fdg8d31gdc9ecc78eb24"
msgid ""
"The tools of warfare, left to rot... I remember when they were pristine. We "
"thought victory was close at hand."
msgstr "전장의 도구들이 썩어가고 있군... 이것들 멀쩡했던 때가 기억이 나. 승리가 눈앞에 있다고 생각했었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = f6e15250-d7e2-fe5c-c4d1-838b76d516b4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:f6e15250-d7e2-fe5c-c4d1-838b76d516b4
msgctxt "h4aa6579egd8d3g4d6dgbda7g1270a18ce719"
msgid "Old, decayed - with looks to match. How unfortunate."
msgstr "오래되고, 부패했군. 주변이랑 어울리긴 하네. 이리도 비참하다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = f6e15250-d7e2-fe5c-c4d1-838b76d516b4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:f6e15250-d7e2-fe5c-c4d1-838b76d516b4
msgctxt "h59a7ed0dg2cd1g488egb14cg717956aa0461"
msgid "These weapons look obsolete even by this plane's humble standards."
msgstr "황량하기 그지없는 이곳 기준으로도 이 무기들은 꽤나 구식으로 보이는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = f6e15250-d7e2-fe5c-c4d1-838b76d516b4
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:f6e15250-d7e2-fe5c-c4d1-838b76d516b4
msgctxt "he188d082g07e7g4d75ga91eg18b553361c03"
msgid ""
"This stuff's ancient. Abandoned to the elements for a long time, I'd say."
msgstr "고릿적 물건이야. 비바람에 노출된 채로 오랜 기간 버려져 있었던 것 같네.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = f6e15250-d7e2-fe5c-c4d1-838b76d516b4
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:f6e15250-d7e2-fe5c-c4d1-838b76d516b4
msgctxt "h41dd2680ga12dg40b0gbf94g4da9aca906e3"
msgid "Creaky old rubbish. Only useful as firewood now."
msgstr "다 낡아 해진 고물이야. 장작으로나 쓸모가 있겠군.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = f6e15250-d7e2-fe5c-c4d1-838b76d516b4
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:f6e15250-d7e2-fe5c-c4d1-838b76d516b4
msgctxt "h19e8a357ge045g49c0ga3b1g8338ff23970c"
msgid "These weapons look ancient. Who's using this stuff?"
msgstr "이 무기들은 굉장히 옛날 것 같은데. 누가 이런 걸 사용한담?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = f6e15250-d7e2-fe5c-c4d1-838b76d516b4
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:f6e15250-d7e2-fe5c-c4d1-838b76d516b4
msgctxt "h6fd3ccbcg479cg47e5gab7dga4769356b0bb"
msgid "This stuff is ancient."
msgstr "아주 오래 된 물건이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck
#. Speaker = Player
#. NodeID = f6e15250-d7e2-fe5c-c4d1-838b76d516b4
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SiegeRemains_AD_HistoryCheck:f6e15250-d7e2-fe5c-c4d1-838b76d516b4
msgctxt "hdda7bbe1gc811g4441g95e0g9d05e0912cb0"
msgid "This stuff's seen better days..."
msgstr "옛날엔 그래도 쓸모가 있는 물건이었겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Crossroads_AD_Sign
#. Speaker = Narrator
#. NodeID = a510d9ca-4422-4540-93e4-00a7c80bad60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Crossroads_AD_Sign:a510d9ca-4422-4540-93e4-00a7c80bad60
msgctxt "h8d005bc7g083ag42bbga294gcb9b7e50b202"
msgid ""
"*North - Last Light Inn\n"
"South - Risen Road\n"
"West - Reithwin Town*"
msgstr ""
"*북쪽 - 최후의 빛 여관\n"
"남쪽 - 치솟은 길\n"
"서쪽 - 라이스윈 마을*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Signpost_AD_BeforeTown
#. Speaker = Narrator
#. NodeID = 08328f5e-d510-4b6d-af26-33850f0b8b76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Signpost_AD_BeforeTown:08328f5e-d510-4b6d-af26-33850f0b8b76
msgctxt "h4e60bad3g9275g46cfgbf93g00d6b9c902f9"
msgid ""
"*North - Last Light Inn\n"
"South - Reithwin Town*"
msgstr ""
"*북쪽 - 최후의 빛 여관\n"
"남쪽 - 라이스윈 마을*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_AD_ReadTombstone
#. Speaker = Narrator
#. NodeID = 1c415f4d-149f-543f-1fa0-c07caa3b9597
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_State_TombstoneVariation = True
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_State_TombstoneVariation = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_AD_ReadTombstone:1c415f4d-149f-543f-1fa0-c07caa3b9597
msgctxt "h028acbb0g0b3cg4a5cg8722g48ac47cd94fe"
msgid "*'Ellie May'? You've seen this name before.*"
msgstr "*'엘리 메이'? 당신은 이 이름을 본 적이 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_AD_ReadTombstone
#. Speaker = Narrator
#. NodeID = 3bbcb1d9-507c-170c-b054-f58b2b99dacc
