#.     - SHA_Trials_State_FirstStatueUsed(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:79a4a074-c127-6b20-4332-3e81188fce16
msgctxt "h5ca16743g8d2dg4bfag914eg4f6abb1ca2e7"
msgid ""
"*The bowl contains an ancient, rust-coloured bloodstain. It forms a neat "
"disc, as if spilled calmly and willingly.*"
msgstr ""
"*그릇에는 아주 오래되어 갈변된 핏자국이 남아 있습니다. 핏자국은 마치 고요히, 자발적으로 방혈된 듯 깔끔한 형태로 남았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Narrator
#. NodeID = 858b844c-644d-13b2-64e3-9b56e275f150
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - SHA_Trials_Knows_LearnedAboutTrials = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:858b844c-644d-13b2-64e3-9b56e275f150
msgctxt "hb7603648g0a4dg4157g9654g2fe7487a13fa"
msgid ""
"*You recognise this as a trial, where initiates would prove themselves to "
"Lady Shar. This one would put their skills of stealth and infiltration to "
"the test.*"
msgstr ""
"*당신은 이것이 입회자가 샤에게 자신의 가치를 증명하기 위해 치른 일종의 시련이었음을 알아차립니다. 이 시련은 은밀함과 침투 기술을 "
"시험하기 위한 것이었을 터입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Player
#. NodeID = 9b71985d-d749-7fcb-5db3-b975a7a552f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_Trials_State_TrialInProgress(0) = False
#.      - SHA_Trials_Event_TrialPassed(0) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - SHA_SneakTrial_State_ShadowheartOffered = True
#.   Object:
#.     - ORI_Inclusion_End_ShadowHeart(1) = True
#.     - SHA_Trials_Event_StartTrial(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:9b71985d-d749-7fcb-5db3-b975a7a552f3
msgctxt "h854c7bb2gc6aag44e6g9a7egee051981b5a3"
msgid "<i>Offer your blood in Shar's name.</i>"
msgstr "<i>샤의 이름으로 피를 바친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Player
#. NodeID = af34c030-038a-4407-a37e-466d4afa2455
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_PermissionGranted = False
#.   Object:
#.     - ORI_Inclusion_End_ShadowHeart(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:af34c030-038a-4407-a37e-466d4afa2455
msgctxt "h48b4b7f0g6d70g42e5gb540g943680b95608"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = dd3dc0ff-6057-4db7-94d8-f864b305c085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:dd3dc0ff-6057-4db7-94d8-f864b305c085
msgctxt "h651e3561g5cd1g4c86g9fc6g9e091cdc62e0"
msgid "Try not to hit an artery."
msgstr "동맥을 절단하지 않게 조심해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Narrator
#. NodeID = dd4f8262-068c-fe83-d420-d737bf8ddd17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - SHA_Trials_Knows_LearnedAboutTrials = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:dd4f8262-068c-fe83-d420-d737bf8ddd17
msgctxt "hf1f99e0cgc5bag402dga28fgdffd671a8986"
msgid ""
"*Another trial, for Lady Shar's initiates. This one would put their skills "
"of stealth and infiltration to the test.*"
msgstr "*샤의 신도가 치르고는 했던 또다른 시련입니다. 이 시련은 은밀함과 침투 기술을 시험하는 것이었을 터입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = de06d819-45e4-0e49-d6f5-eb73cef1ebfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_Event_SHAskedtoDoTrial = True
#.      - SHA_SneakTrial_State_ShadowheartOffered = False
#.   Local:
#.      - 542ac950-9296-7fbb-0b0a-90a564091704_TrialRequested = False
#.   Object:
#.      - SHA_ObjectOfDarknessTrial_Event_RefusedSH(1) = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_TrialRequested = True
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_PermissionGranted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:de06d819-45e4-0e49-d6f5-eb73cef1ebfb
msgctxt "h0a3479afgaf68g4ad0gb239ge4eebbce5133"
msgid "Another trial. I should do this one as well."
msgstr "또다른 시련이야. 이번에도 내가 응해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Player
#. NodeID = e09bfd3b-cd40-de8d-d497-d6d938ddf713
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 542ac950-9296-7fbb-0b0a-90a564091704_PermissionGranted = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_NightsongPoint_AgreedToTrials = True
#.   Local:
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_PermissionGranted = False
#.   Object:
#.     - SHA_ObjectOfDarknessTrial_Event_RefusedSH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:e09bfd3b-cd40-de8d-d497-d6d938ddf713
msgctxt "h19d225ffg9386g4613g9a68g18e5b9296b90"
msgid "Fine, go ahead."
msgstr "알았어, 그럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Player
#. NodeID = e7186f4b-4c62-eaf4-4474-49a3d8232a5e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_ObjectOfDarknessTrial_Event_RefusedSH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:e7186f4b-4c62-eaf4-4474-49a3d8232a5e
msgctxt "h1b2b898dg6011g40aag88d9ge82348f03291"
msgid "No, stand down."
msgstr "아니, 가만히 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = f1c2978e-a269-f84d-2fc9-567d241985cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp2(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:f1c2978e-a269-f84d-2fc9-567d241985cb
msgctxt "h3f03f8c8g9ce4g411cg8e3cgfcdb6e87898c"
msgid ""
"This is no time to indulge your pettiness. These trials are important to me."
msgstr "지금은 네가 마음대로 시답잖게 굴 때가 아니야. 이 시련은 내게 중요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = f4a34ed9-34aa-4ce3-b48e-95a1647a3032
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_SneakTrial_State_ShadowheartOffered = False
#.   Local:
#.      - 542ac950-9296-7fbb-0b0a-90a564091704_TrialRequested = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - SHA_Trials_Event_SHAskedtoDoTrial = True
#.     - SHA_Trials_Knows_LearnedAboutTrials = True
#.   Local:
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_TrialRequested = True
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_PermissionGranted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:f4a34ed9-34aa-4ce3-b48e-95a1647a3032
msgctxt "h803b1000g320dg40abgbb2dgcd03b575f5fb"
msgid "This is one of Lady Shar's trials. Allow me - it's important."
msgstr "이건 샤님의 시련 중 하나야. 내가 할 수 있게 해줘. 내게는 중요한 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 02954db9-acd4-f228-52a5-e25677cc480c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:02954db9-acd4-f228-52a5-e25677cc480c
msgctxt "h6419a0c6g251eg471egaee8gb864eeebf17c"
msgid ""
"Back to the Hells with what we agreed! I have you now, Raphael. Pay the "
"debt, and I will make this quick."
msgstr "계약은 지옥으로 처넣으라고 해! 너 잘 왔다, 라파엘. 당장 빚을 갚지 않으면 끝장날 줄 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 09612d4a-52bb-b4b3-5e7d-3c404064230e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:09612d4a-52bb-b4b3-5e7d-3c404064230e
msgctxt "h3a752d18gf3f0g4d2fg806egd19ff5eee2d0"
msgid "It's wrong - even a beast like that shouldn't be treated in such a way."
msgstr "그건 잘못된 일이야 - 저런 짐승이라도 이런식으로 대해지면 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = 09bef34d-8add-3b8f-01dc-89a44ef067b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_State_ContractEnded = True
#.     - SHA_Orthon_Event_RaphaelAppears = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:09bef34d-8add-3b8f-01dc-89a44ef067b2
msgctxt "h01a19cb8ge66fg4457ga781gf2f19910f85a"
msgid ""
"I think 'free' might be rather overstating matters, Yurgir. Devil's in the "
"details, you see, and the details are in the fine print."
msgstr ""
"내 생각엔 '자유의 몸' 이라는 건 조금 과장이 아닌가 싶어, 유르기르. 계약에 중요한 건 디테일이잖아, 그리고 디테일은 작은 글씨로 "
"적혀 있기 마련이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 0a15521f-5629-bcbe-f0ac-01af4cf2bb83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:0a15521f-5629-bcbe-f0ac-01af4cf2bb83
msgctxt "hf3f7cd13g977fg4f77gbe3ag5b21517e729d"
msgid "You're lucky I came along to help. Now you owe me."
msgstr "내가 이곳을 찾아온 게 네겐 천운이었군. 내게 빚진거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 0b1c7083-4fe3-21d7-9278-4f9c2022e36f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Orthon_State_InformedOrthonOfJusticiar = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:0b1c7083-4fe3-21d7-9278-4f9c2022e36f
msgctxt "h92220692gb7adg452ag8932g043a7c32c1f5"
msgid ""
"The song remains. Seems you haven't dealt with this imaginary Justiciar of "
"yours."
msgstr "노랫소리가 아직도 남아있군. 아직도 그 존재하지도 않는 저스티시어를 찾지 못한 모양이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 0c76f035-0ea1-29ea-438e-0537dfd954cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_EngineIsGoingToExplode = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:0c76f035-0ea1-29ea-438e-0537dfd954cf
msgctxt "hea70b2c5g3861g4850g9d35g9bf8b24b958b"
msgid ""
"Only what I can smell. And whatever engine burns within you is grinding to "
"an inevitable explosion. Burning and fear - you <i>reek </i>with it."
msgstr ""
"냄새는 알지. 그리고 네 안에서 타고 있는 그 엔진은 폭발을 피할 수 없다는 것도. 너한테선 불과 공포의 <i>악취</i>가 난다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = 0f50b172-91f9-1b95-9f7e-1f1233eae999
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_State_ContractEnded = True
#.     - SHA_Orthon_Event_RaphaelAppears = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:0f50b172-91f9-1b95-9f7e-1f1233eae999
msgctxt "hfb67a8edg1686g4c3aga210g258c6f27d125"
msgid ""
"Few may walk away from you intact, Yurgir, but none walk away from me in "
"violation of their deal."
msgstr "유르기르, 널 보고도 살아 돌아간 자는 몇 있을지 몰라도, 나와의 계약을 어기고 빠져나간 자는 한 명도 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 10cb7ef4-bdfd-0f42-2b63-091f44f6edd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_AskedDisplacerCharmPotion(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_AskedDisplacerCharmPotion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:10cb7ef4-bdfd-0f42-2b63-091f44f6edd2
msgctxt "h391907f4gee48g4632g95f5gd76b3e1c827f"
msgid "Clever. I'd like to try that for myself."
msgstr "영리한데. 나도 직접 한번 해보고 싶을 정도야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 114d834a-6f7d-d6af-0c55-31fdf88aca3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Even_QueriedCharmedDisplacer(1) = False
#.   Global:
#.      - SHA_Displacer_Knows_CharmedFromMeat = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Even_QueriedCharmedDisplacer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:114d834a-6f7d-d6af-0c55-31fdf88aca3a
msgctxt "h9ae6acc2g456dg483bgb82fg0e84913bf5bf"
msgid ""
"I know what you're feeding that displacer charm potions. Curious way of "
"ensuring the beast's loyalty."
msgstr "네가 디스플레이서에게 매혹의 포션을 먹이고 있다는 건 알고 있어. 저 짐승의 충성을 유지하기에는 꽤 흥미로운 방법 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 19f18eda-4f39-7c70-06a4-f151db0bc0a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:19f18eda-4f39-7c70-06a4-f151db0bc0a5
msgctxt "h1a67b14ag9912g41fdg95dbg388294b7ebcb"
msgid "You'd imagine wrong. Nessa is as loyal as can be."
msgstr "틀렸다. 네사는 아주 충직한 종이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Narrator
#. NodeID = 1a786c9d-8e5f-b6fb-179b-5077d8277ae1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#.   Tag:
#.      - AVATAR(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:1a786c9d-8e5f-b6fb-179b-5077d8277ae1
msgctxt "h3f440cdag3840g4c82g8d5cge135a6824782"
msgid ""
"*You feel a telltale ache coming from the wound in your hand. Pain will soon "
"grip you - for what you have done.*"
msgstr "*손에 난 상처에서 숨길 수 없는 고통이 느껴집니다. 고통이 곧 당신을 사로잡을 겁니다. 당신이 한 일의 대가입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 1a961ba1-f2ef-a8c5-77e4-aac49cfe722a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:1a961ba1-f2ef-a8c5-77e4-aac49cfe722a
msgctxt "h1e2cca20gf671g489bga2aegaf12a16add37"
msgid ""
"<i>What...? </i>You think you can flaunt my prize - my freedom - under my "
"nose, then deny it?"
msgstr "<i>뭐라고...?</i> 감히 내 눈앞에 내 보상을 - 내 자유를 - 들이밀어 놓고 - 앗아가려는 게냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = 27df2d9d-a96b-7ca7-f8ad-d2eed1316ffa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:27df2d9d-a96b-7ca7-f8ad-d2eed1316ffa
msgctxt "h1ff5c1dcg0910g4d38g82bfg93a06e79f599"
msgid ""
"Unless, of course, you consider instead my infinite mercy. A new contract. A "
"chance to balance the books. Not to mention a welcome change of scenery."
msgstr ""
"하지만 물론, 난 무한히 자비로워. 새 계약의 시간이다. 네 잘못을 만회할 기회를 주지. 이곳에서 나가 주변 풍경도 바꿔볼 기회이고 "
"말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 29c2e8fe-56a8-73de-623f-89d2e6147de9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:29c2e8fe-56a8-73de-623f-89d2e6147de9
msgctxt "he991c4begff8bg4fdegbaf9g4adc85f2da35"
msgid ""
"But now the song has stopped - the contract is fulfilled. I suppose you "
"showing up at the same time is no coincidence..."
msgstr "하지만 이제 노랫소리는 멈췄고 - 계약은 완수되었다. 네가 이 시점에 나타난 것이 우연은 아닌 것 같군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 2ae4281c-3348-c1ae-dc7c-d7a4c35ba52b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_SearchAdvice(1) = False
#.   Global:
#.      - SHA_Orthon_State_ContractEnded = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_OrthonQuestionsSearch(1) = True
#.     - SHA_Orthon_Event_SearchAdvice(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:2ae4281c-3348-c1ae-dc7c-d7a4c35ba52b
msgctxt "h10382c86g5d62g4172g92eeg9ea57186f04c"
msgid "Any suggestions on where to look?"
msgstr "어딜 찾아봐야 할지 제안하는 곳 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 2e656cdf-abbb-5c31-fba0-dfdf91541ad9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:2e656cdf-abbb-5c31-fba0-dfdf91541ad9
msgctxt "h95a246a2ge79fg4e47g8586gaa7a8ba730f7"
msgid "I am a Dark Justiciar now. That makes you my enemy."
msgstr "내가 바로 다크 저스티시어다. 너는 내 적이라는 뜻이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 35c78b1c-9d95-00c1-19bf-30398e4529d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:35c78b1c-9d95-00c1-19bf-30398e4529d1
msgctxt "hce28ee10gc41dg460dgb1ddgfee13b15fd7e"
msgid "So you charm the displacer yourself?"
msgstr "네가 저 디스플레이서에게 직접 매혹을 거는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 38f21faa-d031-4d75-80de-5f206a24f73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:38f21faa-d031-4d75-80de-5f206a24f73c
msgctxt "h6c47ccbfgdd6eg4a52g8216ge0bb86e17a34"
msgid ""
"You'd better start taking this hunt more seriously, or you'll wish <i>you </"
"i>were a bloody rat!"
msgstr "진지하게 이 사냥에 임하는 게 좋을 거야, 아니면 <i>네놈이</i> 곧 차라리 이곳에 굴러다니는 쥐였기를 바라게 될테니까!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = 3c581838-dcc7-d328-d930-c0e0987fb2e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:3c581838-dcc7-d328-d930-c0e0987fb2e0
msgctxt "hdf2cff82g1f01g4532g8013gf2f221cadb65"
msgid ""
"Consider your position. You are about to forfeit what reputation you have "
"left. No contracts. No fame. No power. You'll be a streak of excrement even "
"lemures will slither away from."
msgstr ""
"잘 생각하는 게 좋을 거야. 넌 지금 네게 얼마 남지 않은 평판마저 망치려 하고 있어. 계약을 위반한다면. 명예도 땅에 떨어지고. 힘도 "
"잃겠지. 넌 레무어조차 피해 다닐 배설물 덩어리가 될 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 3dc8fbed-3c62-28ef-c6ee-5f6cdf64455a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:3dc8fbed-3c62-28ef-c6ee-5f6cdf64455a
msgctxt "h3399bdf4gc830g451eg8370g6220b6a06fbc"
msgid "Treated like what? Pampered? Fed? Given a master to <i>adore? </i>"
msgstr "이런식으로? 돌봐준 것? 먹여준 것? <i>존경</i>할 수 있는 주인을 만들어 준 것말이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 4253270d-ce2f-4e2c-9c60-70a6abdc9dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:4253270d-ce2f-4e2c-9c60-70a6abdc9dd3
msgctxt "h7cf2ceccg400dg4131g86e6g2ba096057fdc"
msgid ""
"You've got the stench of the Hells about you - the stench of home. And a "
"whiff of the surface besides."
msgstr "네게서 지옥의 냄새가 풍기는군 - 고향의 악취야. 거기에 조금 지상의 것도 섞여있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 47a9882b-d1b9-6229-c8cb-f30f971e55a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_OrthonQuestionsSearch(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_OrthonQuestionsSearch(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:47a9882b-d1b9-6229-c8cb-f30f971e55a0
msgctxt "h142c6a71gaaf9g4c7egb123g87d1bbef05c4"
msgid "Just getting my bearings. This place is confounding."
msgstr "그저 길을 좀 찾고 있을 뿐이야. 이곳은 좀 어지럽거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 49de3be6-629b-4e09-4f32-a1dba36c1566
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:49de3be6-629b-4e09-4f32-a1dba36c1566
msgctxt "h0f9454fcg7dacg41f7g9ac5gf549c30ce6bb"
msgid "Those who live to speak my name call me Yurgir."
msgstr "날 보고도 살아남은 놈들은 날 유르기르라 부르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 4acae64a-d3ca-b870-8279-98169b0def6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:4acae64a-d3ca-b870-8279-98169b0def6e
msgctxt "h4fd07851g66f1g4eb8ga3aag399a9f154abd"
msgid ""
"Give it a decade, or ten - then you'll know it like the back of your hand."
msgstr "십년, 백년만 이곳에 있어봐라 - 제 손바닥처럼 아주 속속히 알게 되지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 4cfbe2fa-8e90-d4fb-9bd6-fba9bb072d16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:4cfbe2fa-8e90-d4fb-9bd6-fba9bb072d16
msgctxt "h6e66bb2dgc487g428ag84e8gb5fc39bb85d6"
msgid "What do you know of infernal machinery?"
msgstr "지옥 기계에 대해 뭘 알고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 4e1c4232-cad2-2a77-3d2e-38dededb12dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:4e1c4232-cad2-2a77-3d2e-38dededb12dd
msgctxt "ha01850c6g31f0g44feg8fa3gfaa35f4a772f"
msgid ""
"You - tiefling. You've got the stench of the Hells about you - the stench of "
"home. And a whiff of the surface besides."
msgstr "거기 너 - 티플링. 지옥의 냄새가 풍기는군 - 고향의 악취야. 거기에 조금 지상의 것도 섞여있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 509aff9a-def7-3be3-fc10-46d55bafb181
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_OrthonQuestionsSearch(1) = False
#.      - SHA_Orthon_Event_MentionedBalthazar(1) = False
#.      - SHA_Necromancer_HasMet_AtTemple(1) = True
#.   Global:
#.      - SHA_Orthon_State_ContractEnded = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_OrthonQuestionsSearch(1) = True
#.     - SHA_Orthon_Event_MentionedBalthazar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:509aff9a-def7-3be3-fc10-46d55bafb181
msgctxt "ha17618f6g08aeg4013g8fd3ge6606d07ac83"
msgid ""
"Hardly - I already found a necromancer, Balthazar, elsewhere in the temple. "
"Perhaps he's the one you need to kill."
msgstr "이 신전 다른 곳에서 발타자르라 불리는 사령술사를 만났어. 어쩌면 그가 너의 사냥감일지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 55fc5e9d-6e98-09bb-d69b-8890446b8898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:55fc5e9d-6e98-09bb-d69b-8890446b8898
#, fuzzy
#| msgid ""
#| "But go on - spill some blood prove me wrong. If there truly is a justiciar, "
#| "the song will end and you will be vindicated."
msgctxt "hc7c47678g2ab7g4309gb623g58b649601015"
msgid ""
"But go on - spill some blood, prove me wrong. If there truly is a Justiciar, "
"the song will end and you will be vindicated."
msgstr "뭐 해봐 - 그놈의 피를 흘려서 증명해라. 정말로 저스티시어가 남아 있었다면, 노래가 멈추고 네가 옳았다는 게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 56fa4787-7112-f8bc-2cd9-1406d2088d34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:56fa4787-7112-f8bc-2cd9-1406d2088d34
msgctxt "h60666095gb2f8g40a7gb9bbg588b8e572b6f"
msgid "It seems you're free to go."
msgstr "넌 이제 자유의 몸인 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 59b71c6c-a490-16e1-5365-03d2c3510b7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:59b71c6c-a490-16e1-5365-03d2c3510b7c
msgctxt "hc497f40agce0dg40f6g904cg8109dbda1b65"
msgid "I'm done with Zariel. Dealt with enough devils to last a lifetime."
msgstr "자리엘과의 관계는 끝났어. 내 일생 데빌들과는 이미 충분히 엮였다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 5d4c0577-94e6-64e7-ee1e-c9abae7bf245
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Even_QueriedCharmedDisplacer(1) = True
#.      - SHA_Orthon_Event_AskedDisplacerCharmPotion(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_AskedDisplacerCharmPotion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:5d4c0577-94e6-64e7-ee1e-c9abae7bf245
msgctxt "h026635a1gee0bg4facg8528gac69786e5e7a"
msgid ""
"Those potions you use on the displacer - where might I get some of those?"
msgstr "저 디스플레이서에게 사용한 포션들 - 어디서 구할 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 5e13e127-ea20-6153-63ef-5ba22c7c4744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:5e13e127-ea20-6153-63ef-5ba22c7c4744
msgctxt "hfbe923bcg9267g40acg8b45g2b6f456d8d53"
msgid "No point, really. Forget it."
msgstr "아무것도 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 65a998ed-8239-139d-39a4-8c14e858a1a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:65a998ed-8239-139d-39a4-8c14e858a1a4
msgctxt "h3ba07b05gc217g41c0gb1adga0f274f6931d"
msgid ""
"No. You're here to solve my problem. I suggest you prove yourself useful."
msgstr "그래. 넌 내 문제를 해결하러 온거지. 당장 네 유능함을 증명하는 게 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 66f40d8b-2a96-edd8-2078-0b9c258ea06d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:66f40d8b-2a96-edd8-2078-0b9c258ea06d
msgctxt "h5353b7bfg6ea4g4aaag8741gc637492b70ee"
msgid ""
"Ensuring Nessa's loyalty is as important as having sharpened blades and an "
"oiled crossbow."
msgstr "네사의 충성을 관리하는 건 날카로운 칼이나 기름 먹인 활만큼이나 사냥에 중요한 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 6a82b222-87de-5e09-a4da-60c6fdfb63a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:6a82b222-87de-5e09-a4da-60c6fdfb63a9
msgctxt "hedffd0cfgd4b8g4318gba90g325d0d2a0fa1"
msgid ""
"I caught the scent of that bloated carcass already - he's no more alive than "
"the Dark Justiciars down here."
msgstr "그 부풀어오른 시체의 악취는 이미 맡았지. 그놈은 이미 여기 저스티시어들만큼이나 죽은 녀석이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 6cf21b5c-ac18-1283-bdde-623a921a2942
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_Event_ClearGemOwnership = True
#.   Object:
#.     - SHA_Orthon_Event_RaphaelNoShowFallback(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:6cf21b5c-ac18-1283-bdde-623a921a2942
msgctxt "he3946fa3gf281g4729g9be5gab3c1faa342d"
msgid "Now leave me. I must prepare for my return to Hell - <i>triumphant</i>."
msgstr "이제 사라져라. 난 지옥으로 돌아갈 준비를 해야하거든 - 승리자로서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 7058ed4b-c3e2-645f-ea12-db9ff417da6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Orthon_State_ContractEnded = False
#.      - SHA_Orthon_Event_RaphaelAppears = False
#.      - SHA_LastJusticiar_State_KilledJusticiar = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:7058ed4b-c3e2-645f-ea12-db9ff417da6b
msgctxt "h9f4e700eg4ac0g4389gb262gd6371660e1d8"
msgid "Wait... <i>quiet</i>..."
msgstr "잠깐... <i>조용하군</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 737db660-11f5-bbe8-349e-214397714a7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_MakeOrthonPartyHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:737db660-11f5-bbe8-349e-214397714a7e
msgctxt "hbf5327d1g491bg44a9gbdc7g915cb86c7f1e"
msgid ""
"So you're telling me you completed the rites? Congratulations, little "
"rabbit. I suppose I'd better kill you now."
msgstr "그렇다면 네놈이 의식을 마쳤다는 말인가? 축하한다, 작은 토끼야. 이제 그만 죽어줘야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 73bc993f-6ddb-f1f5-1022-7c58a89c82d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_EngineIsGoingToExplode = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:73bc993f-6ddb-f1f5-1022-7c58a89c82d5
msgctxt "hfb287894gf09cg454fgaf54gf6d6f4916d13"
msgid ""
"And a short one it will be, by the smell of that engine. What will it be - "
"hours? Days? Finish your search before we both run out of time."
msgstr ""
"그 엔진 악취로 봐서는 남은 일생도 오래가지 못하겠지만 말이지. 얼마나 남은 거지 - 몇 시간? 며칠? 우리 둘 다 시간이 없어지기 전에 "
"가서 수색을 마쳐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 75a2128e-f6ee-c809-7eeb-9a892c62da6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_AskedDisplacerCharmPotion(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_AskedDisplacerCharmPotion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:75a2128e-f6ee-c809-7eeb-9a892c62da6e
msgctxt "hfeff1b3cg65a3g4f58g92e5g756045954b8e"
msgid "Just admiring your enterprise. I'd like to try it out for myself."
msgstr "그 효율적인 방식이 부러울 뿐이야. 나도 한번 배워보고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 78c3ddd0-7ac3-4331-0044-b5ab0a3c98eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:78c3ddd0-7ac3-4331-0044-b5ab0a3c98eb
msgctxt "hd1a6d371g2ad7g4a79g9a31g25ad51beaa3a"
msgid ""
"You <i>what? </i>No new darkcloaks have been sworn in for years here - not "
"since I arrived."
msgstr "네가 <i>뭐라고?</i> 벌써 몇년이나 새 저스티시어가 생긴 적은 없어 - 적어도 내가 온 이후로는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 791fa792-91ec-a3c7-8f9b-36b55a38480c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_State_SpokeToOrthon = False
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_SpokeToOrthon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:791fa792-91ec-a3c7-8f9b-36b55a38480c
msgctxt "h971ea8bege795g4226g92f1g523830326a78"
msgid "An orthon. Fancy seeing one of you so far from the Hells."
msgstr "오르쏜이라니. 지옥에서 이리 멀리 떨어진 곳에서 보게되다니 놀라운걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = 7d2ffd66-d951-4a0b-fd0a-389c1f9ddc72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:7d2ffd66-d951-4a0b-fd0a-389c1f9ddc72
msgctxt "h08823752g2976g40aag8650gc38dc14cfa06"
msgid ""
"What's a contract without whimsy, I say, but fine: no more songs. Now off to "
"the House of Hope for cocktails and canapés - and a brand new signature on a "
"brand new deal."
msgstr ""
"그런 변화라도 없으면 계약에 재미가 없는데, 하지만 좋아: 노래는 빼도록 하지. 자, 이제 칵테일과 카나페가 기다리는 희망의 집으로 가자 "
"- 서명을 기다리는 새 계약서도 있고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 82b2c913-fa9d-d9cf-e5dd-e6f8ea29e28f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:82b2c913-fa9d-d9cf-e5dd-e6f8ea29e28f
msgctxt "h7039fe4cg680fg4617gb88cg558786564c04"
msgid ""
"What's the point in having lackeys if I've to do everything myself? The "
"quartermaster makes sure the displacer's meals are properly seasoned."
msgstr "하수인들이 있는데 내가 왜 그 짓을 해야하지? 보급관이 저 디스플레이서의 식사가 매번 잘 양념하고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 82c030c1-1649-e77e-87c7-ba41237c8873
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:82c030c1-1649-e77e-87c7-ba41237c8873
msgctxt "ha620c5a0g51e1g4944g83c5g2a76ba9003a6"
msgid "I'm not here to talk about Zariel."
msgstr "난 자리엘 얘기를 하기 위헤 온 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 840fb010-d6c0-9dfc-399e-27f6dc7facdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:840fb010-d6c0-9dfc-399e-27f6dc7facdf
msgctxt "hc1e83fecgd94bg4176g8dd0gc4f7b28b9bc1"
msgid ""
"See my quartermaster. It may have some spare potions to sell you - let you "
"experiment for yourself."
msgstr "보급관을 찾아가라. 몇 개 남는 포션이 있다면 네게 팔아줄 수도 있겠지 - 직접 실험해 보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 886e17e4-c25d-f8bd-5d2b-6fc5d55e306a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:886e17e4-c25d-f8bd-5d2b-6fc5d55e306a
msgctxt "h12c79934g3255g4a11g84ccg703d5504b071"
msgid "Do not provoke her. I am her master - all others are a potential meal."
msgstr "그녀석을 도발할 생각하지 마라. 내가 주인이고 - 그 외의 모든것은 식사거리일 뿐일테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 8883da03-68a4-f44a-a704-5c48bb2a0395
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:8883da03-68a4-f44a-a704-5c48bb2a0395
msgctxt "hca2eba2dg26e0g4ad8gb32dg022dc3682008"
msgid ""
"You're supposed to be searching these ruins, little rabbit. Given up already?"
msgstr "이 폐허를 탐험하고 있어야 하는 것 아니냐, 이 작은 토끼야. 벌써 포기한 게냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 8b43ac79-86f9-fdb0-6728-1daf1fb1b9df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:8b43ac79-86f9-fdb0-6728-1daf1fb1b9df
msgctxt "hae3151e3g92f8g4b95g9fcdg7c56193f16db"
msgid "...It's gone. The song is gone! <i>The contract is completed!</i>"
msgstr "...멈췄어. 노랫소리가 멈췄다고! <i>계약이 완료된거다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 8d760efd-e92c-1f24-cb75-da45c1dcaca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:8d760efd-e92c-1f24-cb75-da45c1dcaca8
msgctxt "hc178359fgb1f2g49cbg9923g267388d88178"
msgid "He is not the answer. He is not my prey."
msgstr "그놈은 아니야. 내 목표는 살아있는 놈이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 90e252c6-c7ab-50bb-6090-f74c1393967b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_OrthonQuestionsSearch(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:90e252c6-c7ab-50bb-6090-f74c1393967b
msgctxt "hba70dac8ge309g4752g8836ge27ff757b6ad"
msgid ""
"Now answer my question - are you still searching this place, or have you "
"failed already?"
msgstr "이제 내 질문에 답해라 - 아직도 수색중인 거냐 아니면 뭘 찾는데 실패하고 돌아온게냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 90fe5f3a-64c2-af08-3076-6eab8cb503b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_State_HasMet(1) = True
#.   Global:
#.      - SHA_Orthon_State_ContractEnded = False
#.      - SHA_Orthon_Event_RaphaelAppears = False
#.      - SHA_LastJusticiar_State_KilledJusticiar = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:90fe5f3a-64c2-af08-3076-6eab8cb503b9
msgctxt "hdd4770e1gabfeg44dfg9938gf864d2267775"
msgid "I found your quarry. But I will not harm him - nor will you."
msgstr "네 사냥감을 찾았어. 하지만 그를 해치진 않을 거야 - 네가 해치게 두지도 않을 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Karlach
#. NodeID = 9141c4d2-35a1-d91f-8d82-77d11ef66fc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_State_SpokeToOrthon = False
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_SpokeToOrthon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:9141c4d2-35a1-d91f-8d82-77d11ef66fc3
msgctxt "hec1cd7a2ga035g4513gaad7g25f59fcb89f2"
msgid ""
"Holy shit. An orthon. Powerful devils - I wouldn't get on their bad side "
"without a good reason."
msgstr "젠장. 오르쏜이잖아. 강력한 데빌이지 - 합당한 이유가 없다면 함부로 심기를 거스르지 않는 게 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 92e24784-2c21-cb3b-0ee9-f36ae5e33634
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Displacer_Knows_CharmedFromMeat = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:92e24784-2c21-cb3b-0ee9-f36ae5e33634
msgctxt "hfca95694g8b83g4df8g9816g1a69d760edea"
msgid "An impressive companion, your displacer. But a handful, I'd imagine."
msgstr "네 디스플레이서 꽤나 인상적인 동반자네. 하지만 다루기 힘들겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = 96034f99-bde1-b360-3a41-9f6114df4486
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_State_ContractEnded = True
#.     - SHA_Orthon_Event_RaphaelAppears = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:96034f99-bde1-b360-3a41-9f6114df4486
msgctxt "h0ee24768g027bg499cgbfd2g570e689bea22"
msgid ""
"Here I am, Yurgir, tongue and all, precisely on time for a lesson in "
"semantics."
msgstr "여기 왔다네, 유르기르, 의미론에 대해 가르침을 주기 위해 혀도 잘 챙겨왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 9838c6d8-91b0-ae4d-23b1-c5fa10af626c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:9838c6d8-91b0-ae4d-23b1-c5fa10af626c
msgctxt "hba387dc6g046ag4664g821cg3e9fba165acf"
msgid ""
"You've got the stench of the Hells about you - the stench of home. And a "
"whiff of the surface besides."
msgstr "네게서 지옥의 냄새가 풍기는군 - 고향의 악취야. 거기에 조금 지상의 것도 섞여있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = 98a09ce1-b358-8477-806a-9c2eb917fd4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:98a09ce1-b358-8477-806a-9c2eb917fd4d
msgctxt "h63c4492dg3eadg4c38g8d16g0314e4e4329e"
msgid "Who the Hells are you?"
msgstr "넌 대체 누구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = 9aada586-53e3-f3fa-96de-2426b57cf920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:9aada586-53e3-f3fa-96de-2426b57cf920
msgctxt "hc63e91d6g5394g480ag86fag0e0dab73d0d2"
msgid "Devil's in the details, you see, and the details are in the fine print."
msgstr "중요한 건 세부 사항이야, 그리고 세부 사항은 작은 글씨로 적혀 있기 마련이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = 9dbf5b98-a274-a565-9a47-1636be606575
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:9dbf5b98-a274-a565-9a47-1636be606575
msgctxt "h50230884ge35eg4e9bg83d1gab1cdb75ffe5"
msgid "Thought I smelled the stench of Avernus."
msgstr "어디선가 아베르누스의 악취가 느껴진다 했더니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = a0c209a5-80b2-ef00-cf60-f83c717d2be7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:a0c209a5-80b2-ef00-cf60-f83c717d2be7
msgctxt "h1ad4affeg52dfg4f4dg8c91g77e76f01066e"
msgid "Yes. Your point?"
msgstr "그래서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = a1f1734a-96c4-9340-6da2-cd1994f89656
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:a1f1734a-96c4-9340-6da2-cd1994f89656
msgctxt "ha1097b77g01c0g40fbga279g9cb11de23f52"
msgid ""
"You - tiefling. You've got the stench of the Hells about you - the stench of "
"home. And a whiff of the surface besides."
msgstr "거기 너 - 티플링. 지옥의 냄새가 풍기는군 - 고향의 악취야. 거기에 조금 지상의 것도 섞여있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = a4bb1265-7fe9-d7e1-5442-dcc27fa3eb93
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_Event_ClearGemOwnership = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:a4bb1265-7fe9-d7e1-5442-dcc27fa3eb93
msgctxt "hba493ff5g7c8ag4dd8g9c07g60e9089bb06d"
msgid "Anything I leave behind is yours. Pick over it however you like."
msgstr "내가 남겨두고 가는 건 다 가져가도 좋아. 얼마든지 뒤져보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = a98fb9c9-7e91-ecf3-9822-65326c53048c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_EngineIsGoingToExplode = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:a98fb9c9-7e91-ecf3-9822-65326c53048c
msgctxt "h96eab987g95cag4ed1g8cc3g39da7b7ac46a"
msgid ""
"Only what I can smell. And whatever engine burns within you is grinding to "
"an inevitable explosion. Burning and fear - it's all over you."
msgstr ""
"냄새는 알지. 그리고 네 안에서 타고 있는 그 엔진은 폭발을 피할 수 없다는 것도. 너한테선 불과 공포의 <i>악취</i>가 난다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Astarion
#. NodeID = acaf31c4-8fda-47d9-9798-15e7a73fafab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_GotQuestFromRaphael = True
#.   Object:
#.      - ORI_Astarion_Event_MetOrthon(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:acaf31c4-8fda-47d9-9798-15e7a73fafab
msgctxt "h86c913cfgf5afg4018ga32bg3e126db6c9e7"
msgid "Can we please kill it this time?"
msgstr "이제 그만 죽여버리면 안될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = aee16641-f7e1-238f-8e00-beb853915b6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:aee16641-f7e1-238f-8e00-beb853915b6a
msgctxt "h4379e689ga639g469eg8bc5g1c796836a762"
msgid ""
"I <i>suggest </i>you think twice before pestering me, or our truce may end "
"prematurely."
msgstr ""
"날 두번 귀찮게 하기 전에 곰곰히 다시 한번 생각해보는걸 <i>제안</i>하지, 아니라면 우리의 짧은 휴전도 곧 끝나게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = aee8d680-58ba-db95-330a-24fb96d19a08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:aee8d680-58ba-db95-330a-24fb96d19a08
msgctxt "h12936f70g32e3g43c6g8beag0c9c711f0c41"
msgid "<i>The rats? </i>Why would I pay attention to some puny vermin?"
msgstr "<i>쥐?</i> 내가 왜 그런 사소한 것들에게까지 신경을 써야하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = b2c02ff6-a415-00e7-c90c-03833f058190
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_OrthonQuestionsSearch(1) = True
#.      - SHA_Orthon_HasMet(1) = True
#.   Global:
#.      - SHA_Orthon_Event_SearchPersuasionSuccess = True
#.      - SHA_Orthon_State_ContractEnded = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:b2c02ff6-a415-00e7-c90c-03833f058190
msgctxt "hcafb64bbga3c3g4bd6gb273g58888ab2bacc"
msgid ""
"I still hear the song, which means you've achieved nothing. Keep looking, or "
"I'll decorate every corner of this place with pieces of you."
msgstr ""
"아직도 노랫소리가 들리는군, 네가 아무것도 해낸 게 없다는 뜻이야. 빨리 찾아내지 않으면 이 곳 구석구석을 네 조각들로 장식할테다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = b9330a5f-24f8-c383-b7fb-21b869255227
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:b9330a5f-24f8-c383-b7fb-21b869255227
msgctxt "hc67c79bbg906fg4d02ga896g20440baecda9"
msgid "Though in truth, you won't have that long. Not even close."
msgstr "사실 그렇게 오래 있지는 못할 거야. 빨리 하지 않으면 내가 죽여버릴테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = bd20f003-85aa-b936-1702-a65d3069c86c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_MakeOrthonPartyHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:bd20f003-85aa-b936-1702-a65d3069c86c
msgctxt "hb3466102gf55bg4b60g939cga79c7af11398"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = bdbb3dc5-9e58-2243-70a6-ea1ec3a4228a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_MakeOrthonPartyHostile = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:bdbb3dc5-9e58-2243-70a6-ea1ec3a4228a
msgctxt "h72461c4cg5ef0g4d9fg9a04g6b8e2097275f"
msgid "I will take care of him. After I've shown you your own heart."
msgstr "그놈은 내가 처리하도록 하지. 네 눈앞에 네놈 심장을 들이밀어 준 뒤에 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = be9857bc-f8d5-9178-f90b-e3f54deef754
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:be9857bc-f8d5-9178-f90b-e3f54deef754
msgctxt "h38693acdge822g4029ga9c0g59db4ed01fcf"
msgid ""
"There was one last Justiciar - dead now. Raphael helped him hide from you."
msgstr "마지막 저스티시어 한명이 있었어 - 이젠 죽었지만. 라파엘이 그가 숨는 걸 도와줬던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = c248999c-2677-dbab-e922-4bb86d940f45
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c248999c-2677-dbab-e922-4bb86d940f45
msgctxt "hc12dd05bg1a4ag4d10g910cg88e502415bc9"
msgid ""
"A servant of Zariel, if I'm not mistaken. I'd know the reek of her infernal "
"machinery anywhere."
msgstr "내가 착각하는 게 아니라면 자리엘의 종복이로군. 그 지옥 기계의 냄새는 어디서든 알아볼 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = c3895410-1b8d-9ba5-a3bd-b08217d2a9df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c3895410-1b8d-9ba5-a3bd-b08217d2a9df
msgctxt "hf3543d74g267ag4192g81f3gb52284301e04"
msgid "<i>Suggestions? </i>So much for your superior hunting skills."
msgstr "<i>제안? </i>네놈이 자랑하는 추적 기술이란 것도 거기까지인가보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = c555fc73-561d-4643-8358-74a1d9a3c619
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c555fc73-561d-4643-8358-74a1d9a3c619
msgctxt "hcf42e855gfc38g4566g8893g2dc3f3c1d2f3"
msgid ""
"But first, it would be only befitting if you reward your subcontractor. The "
"greater reward for the greater hunter."
msgstr "하지만 우선, 네가 하청을 준 자들에게 먼저 보상을 주는 게 옳지 않겠니. 위대한 사냥꾼에게 위대한 보상을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = c5901948-7e2f-5221-b4e0-483600732ac9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c5901948-7e2f-5221-b4e0-483600732ac9
msgctxt "he3f6544fg6c91g44eeg988ag34e256cca3bd"
msgid ""
"I was bid by Raphael to slay every Justiciar I found in this place. The "
"contract was a song, one stuck in my head until I finished the deed. I had "
"to hum that blasted tune for <i>years.</i>"
msgstr ""
"라파엘과 이 곳에 있는 모든 저스티시어를 제거하겠다는 계약을 했지. 계약서는 일을 완수할때까지 머릿속에 울리게 되어 있는 노래의 "
"형태였어. 그 망할 노래를 <i>몇 년이고</i> 흥얼거려야 했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = c5d222f4-b5c4-021f-663a-5a8a6a2ebdcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c5d222f4-b5c4-021f-663a-5a8a6a2ebdcb
msgctxt "h969560f0g9d3bg4114gbfccg6c44dc8512c0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = c6b35c1b-3070-3de6-00e1-32598832d973
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c6b35c1b-3070-3de6-00e1-32598832d973
msgctxt "hf44bfb2fg8643g4df3g866eg70154b266f24"
msgid ""
"That conniving sack of worms. I should've known. I've should've ripped his "
"tongue out before he even <i>spoke </i>of this contract."
msgstr "그 벌레자루같은 자식. 그럴 줄 알았어. 그놈이 이 계약에 대해 <i>입도 뻥긋하기 전에</i> 혀를 뽑아버렸어야 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Karlach
#. NodeID = c7bd999b-babc-8d10-9d88-18c944d17669
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c7bd999b-babc-8d10-9d88-18c944d17669
msgctxt "h6aee4dfcgc02eg4a63gadd4gc0c2c621b4de"
msgid "What do you know of infernal machinery?"
msgstr "지옥 기계에 대해 아는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = c98ec6c9-f920-9114-d491-c17d4386ee22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_OrthonQuestionsSearch(1) = True
#.      - SHA_Orthon_Event_MentionedBalthazar(1) = False
#.      - SHA_Necromancer_HasMet_AtTemple(1) = True
#.   Global:
#.      - SHA_Orthon_State_ContractEnded = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_MentionedBalthazar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:c98ec6c9-f920-9114-d491-c17d4386ee22
msgctxt "h7de44e3fg4238g4099gb990gd5ba503f3697"
msgid ""
"I met a necromancer, Balthazar, elsewhere in the temple. Perhaps he's the "
"one you need to kill."
msgstr "이 신전 다른 곳에서 발타자르라 불리는 사령술사를 만났어. 어쩌면 그가 너의 사냥감일지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = cad8f149-fea6-b73d-0e23-faae1fee192a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:cad8f149-fea6-b73d-0e23-faae1fee192a
msgctxt "hb005b877g0358g4ec1gbbebg6901f6cd8efa"
msgid ""
"Remember you said that, when you fail. You won't smile so easily when I peel "
"the face off your skull."
msgstr "네가 실패할 때 그 말 똑똑히 기억해라. 내가 그 얼굴을 두개골에서 떼어낼 때는 그렇게 헤실거리지 못할테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = cc290254-2043-0ef1-9ee3-6e5cf391c17b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:cc290254-2043-0ef1-9ee3-6e5cf391c17b
msgctxt "h59db9398gfaf0g40b8g934eg892b42e44cba"
msgid "...Bastard. Fine. On one condition - no more songs."
msgstr "...개자식. 좋다. 하지만 조건이 있어 - 더이상 노래는 안된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = cf052159-fb4b-c0d8-c7fe-94127f271f47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:cf052159-fb4b-c0d8-c7fe-94127f271f47
msgctxt "h280b142cg5ff4g441fgb386gcd1b70ce2545"
msgid "In short: you're in breach of contract, my friend. Oh dear."
msgstr "요약하자면: 넌 지금 계약을 어긴 거야, 친구. 오 저런."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = d7942e37-b622-8b7a-d7e9-f2ed9c7ddfee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:d7942e37-b622-8b7a-d7e9-f2ed9c7ddfee
msgctxt "he8502473g5fa9g4304ga353g5832e12201ed"
msgid "Don't insult me - I'd know if there was a Justiciar down there."
msgstr "지금 날 조롱하는 게냐 - 이곳에 저스티시어가 있다면 진작에 찾았을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = d7f44325-61c2-f728-c715-f5977f5e2d03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_Orthon_Event_RaphaelNoShowFallback(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:d7f44325-61c2-f728-c715-f5977f5e2d03
msgctxt "h2ef94d04gc124g41acg8da9g0ed88da7fe62"
msgid ""
"Away now. There is nothing more for you here, unless you're offering "
"yourself as hunting practice."
msgstr "꺼져라. 네놈이 사냥 연습대가 되어줄게 아니라면 더이상 볼일은 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Astarion
#. NodeID = da05295b-57dd-0e2a-9a4a-76a6334811f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_GotQuestFromRaphael = True
#.   Object:
#.      - ORI_Astarion_Event_MetOrthon(5) = False
#. SetFlags:
#.   Object:
#.     - ORI_Astarion_Event_MetOrthon(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:da05295b-57dd-0e2a-9a4a-76a6334811f9
msgctxt "hc979160egd3b5g4bf4gb351gb47beaa11325"
msgid ""
"This is what Raphael wants us to kill? Well, if that's what it takes to "
"figure out what these damn scars mean..."
msgstr "이게 라파엘이 우리에게 죽여달라고 한 건가? 이 망할 흉터들이 무슨 의미인지 알아내려면 어쩔수 없나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = daeea6d9-743e-8722-4cf2-ab2b21772389
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:daeea6d9-743e-8722-4cf2-ab2b21772389
msgctxt "h7b53d177g294eg461egadc7g9e79205f9a4f"
msgid "You're wasting time, little rabbit. Hoping I'll show mercy instead?"
msgstr "내 시간을 낭비하지 마라, 작은 토끼야. 내가 네게 자비를 보일 거라 기대하는 건 아니겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = de9b4e04-caab-a86a-d892-04e03663a7e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:de9b4e04-caab-a86a-d892-04e03663a7e7
msgctxt "hf6bbc73fg2d5eg4421g9207g78101ce8f173"
msgid ""
"For a moment, I thought you were going to challenge me. Wise, that you "
"didn't."
msgstr "순간 내게 반항하려는 줄 알았지 뭐냐. 안그러길 다행인 줄 알아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Karlach
#. NodeID = e15e0abb-e542-4f89-921c-9aa874f4eeb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_State_SpokeToOrthon = False
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_SpokeToOrthon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:e15e0abb-e542-4f89-921c-9aa874f4eeb1
msgctxt "h98ae69aagad4eg4ef0ga78dgceeabc41b291"
msgid ""
"Holy shit. An orthon. Powerful devils - I wouldn't get on their bad side "
"without a good reason."
msgstr "젠장. 오르쏜이잖아. 강력한 데빌이지 - 합당한 이유가 없다면 함부로 심기를 거스르지 않는 게 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Karlach
#. NodeID = e2be29e4-a865-df13-c6bd-d4a77a55ef91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:e2be29e4-a865-df13-c6bd-d4a77a55ef91
msgctxt "h1151d143g4e70g4146g8b50gf521ba590138"
msgid "What do you know of infernal machinery?"
msgstr "지옥 기계에 대해 뭘 알고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = e79cb54f-6f0d-5902-c262-58e9436823be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:e79cb54f-6f0d-5902-c262-58e9436823be
msgctxt "hb78046aag95d1g488dga630gbf3c0909a34b"
msgid ""
"Spare me your bleeding heart. Unless you'd like me to pluck it out and show "
"it to you."
msgstr "그딴 동정심 넘치는 심장은 아껴둬라. 내가 네 몸에서 직접 뜯어서 보여주기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = e981eaa3-38ab-68d8-70b1-71b8c7feaa08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:e981eaa3-38ab-68d8-70b1-71b8c7feaa08
msgctxt "h237ea2f7g91eeg4494gada5g38883f363211"
msgid "You're manipulating that creature."
msgstr "그 짐승을 맘대로 조종하고 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = eb5647fe-f266-8f24-b441-92d20ce1cf16
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_EngineIsGoingToExplode = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:eb5647fe-f266-8f24-b441-92d20ce1cf16
msgctxt "h84b2b01ag9d0ag479bgb175g3a443e569925"
msgid ""
"Only what I can smell. And whatever engine burns within you is grinding to "
"an inevitable explosion. Burning and fear - you <i>reek </i>with it."
msgstr ""
"냄새는 알지. 그리고 네 안에서 타고 있는 그 엔진은 폭발을 피할 수 없다는 것도. 너한테선 불과 공포의 <i>악취</i>가 난다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = eddd7fe9-53cd-786b-a53d-aa36b218c756
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:eddd7fe9-53cd-786b-a53d-aa36b218c756
msgctxt "h0570ec72gb331g4dd1gbe78gb455adaa441d"
msgid ""
"A servant of Zariel, if I'm not mistaken. I'd know the reek of her infernal "
"machinery anywhere."
msgstr "내가 착각하는 게 아니라면 자리엘의 종복이로군. 그 지옥 기계의 냄새는 어디서든 알아볼 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = f108b35b-862e-8fde-d329-4db1ee42e548
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:f108b35b-862e-8fde-d329-4db1ee42e548
msgctxt "h5be7531egd2c3g4e66g8cc2g6ea268fc12f0"
msgid "Song? Contract? What are you talking about?"
msgstr "노래? 계약? 무슨 소리를 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = f24ac7c8-53fd-01d2-37aa-f10bce831255
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:f24ac7c8-53fd-01d2-37aa-f10bce831255
msgctxt "hcef3f5c2gb76cg431agb972g7d404648e91f"
msgid ""
"Yes - I'd recognise it anywhere. Zariel. The oily <i>reek </i>of her "
"infernal machinery."
msgstr "그래 - 어디서든 알아볼 수 있지. 자리엘. 그 지옥 기계의 기름진 <i>악취</i>란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = f6e279a0-c1b4-17e8-849d-f17ef993b23e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_State_HasMet(1) = True
#.   Global:
#.      - SHA_Orthon_State_ContractEnded = False
#.      - SHA_Orthon_Event_RaphaelAppears = False
#.      - SHA_LastJusticiar_State_KilledJusticiar = False
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_State_InformedOrthonOfJusticiar = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:f6e279a0-c1b4-17e8-849d-f17ef993b23e
msgctxt "h28d5ae2bgc8bag4303gb48agc2daf066d792"
msgid ""
"I found one last Justiciar, hiding in plain sight. He's in a chamber right "
"below you."
msgstr "마지막 저스트시어를 찾았어, 잘 보이는 곳에 숨어 있던데. 바로 네 아래층에 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Raphael
#. NodeID = f90c227d-86a0-dc29-662b-8a7b572824c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:f90c227d-86a0-dc29-662b-8a7b572824c7
msgctxt "h781ac29dg52c0g4978ga4e4g8a0508e42ddd"
msgid ""
"You were to fulfil the deal. Nowhere does it stipulate you could subcontract "
"the last kill to the first adventurers' party that came trotting along."
msgstr "넌 계약을 직접 이행해야 했어. 어디에도 이곳에 기어 들어온 모험가들에게 마지막 임무를 위임해도 좋다고 쓰여 있지는 않았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = fd07c309-5e83-769c-b5aa-82f432efec73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:fd07c309-5e83-769c-b5aa-82f432efec73
msgctxt "h6b848632g654dg4dafga74fg1831744e6163"
msgid ""
"Curious? No - <i>effective</i>. A hunter needs to ensure his tools are "
"dependable."
msgstr "흥미롭다? 아니 - <i>효율적이지</i>. 사냥꾼이라면 도구를 잘 관리하는 게 중요하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = fe3df24d-5f2c-c204-23f1-35b9c2d01748
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_OrthonQuestionsSearch(1) = False
#.   Global:
#.      - SHA_Orthon_State_ContractEnded = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_OrthonQuestionsSearch(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:fe3df24d-5f2c-c204-23f1-35b9c2d01748
msgctxt "h43a754ebgc5d3g4b00g843cg9f452349469b"
msgid ""
"Not at all. I think I'll make short work of this - show you how it's done."
msgstr "아니, 전혀. 내가 이 모든걸 빨리 해결하는 방법을 알아 - 일이란 어떻게 하는 건지 내가 보여주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Player
#. NodeID = ff5ce5e0-9e13-4185-e35e-5aef27e49d3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_AskedOrthonAboutRats(1) = False
#.   Global:
#.      - SHA_LastJusticiar_State_RatsPanicked = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_AskedOrthonAboutRats(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:ff5ce5e0-9e13-4185-e35e-5aef27e49d3d
msgctxt "h694986b4ge6eag4082gb893gf49ddff5e086"
msgid "Have you noticed anything strange about the rats around here?"
msgstr "이 주변의 쥐들로부터 뭔가 이상하다 느낀 점은 없었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon
#. Speaker = Yurgir
#. NodeID = ffa06dea-85dc-54b8-ee80-daf7e3db527c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon:ffa06dea-85dc-54b8-ee80-daf7e3db527c
msgctxt "h5143afdcg8a0cg482cgbd90g65d711f62ef1"
msgid ""
"<i>Owe</i> you? Every breath you take from this moment on is my reward to "
"you. Few walk away from me intact."
msgstr "너에게 <i>빚을 져</i>? 네놈이 살아 숨 쉬는 매 순간이 내 보상이다. 나를 만나서 멀쩡히 돌아가는 사람은 거의 없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Player
#. NodeID = 1a653d5b-6a4f-4005-b578-79a87e09fdcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:1a653d5b-6a4f-4005-b578-79a87e09fdcb
msgctxt "h9ad7dd5dg1ffbg4db1gbbe7g215b6fde3bf2"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Player
#. NodeID = 1cae91aa-2205-4f94-bd0f-df613a6206f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:1cae91aa-2205-4f94-bd0f-df613a6206f9
msgctxt "h511e0546gdd96g4c92g9352gb43b96f2030e"
msgid "What was this place for?"
msgstr "여긴 뭐 하는 곳이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Player
#. NodeID = 2f2166d3-e288-47a4-bee3-d73b3e7bb5ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:2f2166d3-e288-47a4-bee3-d73b3e7bb5ad
msgctxt "hdca51748g163fg4001g94a8gf5c096641f0d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Orthon's Bed
#. NodeID = 382a99b3-90d5-4f42-a80f-7ce12f9d70a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_LastJusticiar_Knows_JusticiarStateBedReveal = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:382a99b3-90d5-4f42-a80f-7ce12f9d70a1
msgctxt "h66edf3eag5418g40c4gb151g6c735a17b468"
msgid "One. Scattered. Became many."
msgstr "하나. 흩어져. 여럿이 되었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Orthon's Bed
#. NodeID = 3dc5e575-81d3-477f-8df4-3c23a726135d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:3dc5e575-81d3-477f-8df4-3c23a726135d
msgctxt "h9d2f4f10g9bdag4c1cgb383g5bd624ca4fbe"
msgid "Served Shar."
msgstr "샤를 섬겼다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Player
#. NodeID = 487862e6-1df8-42e9-bab0-d7349d125bfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_OrthonAttack = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:487862e6-1df8-42e9-bab0-d7349d125bfa
msgctxt "h7bfb591fgb1d3g400cg833ag6a4ca1ba482c"
msgid "Did anyone survive, or escape the beast?"
msgstr "누구든 짐승으로부터 살아남거나 도망친 사람이 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Player
#. NodeID = 4a7ea124-6083-4870-af28-7c00c91faaca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:4a7ea124-6083-4870-af28-7c00c91faaca
msgctxt "h2ec8996cgd2aeg4a27gb664g3c3535ba8697"
msgid "What did you do in life?"
msgstr "살아있을 땐 무엇을 했지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Orthon's Bed
#. NodeID = 7eb283ca-9afc-4693-8d24-09e0a677bda1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:7eb283ca-9afc-4693-8d24-09e0a677bda1
msgctxt "h1aac7fafg5b2ag49f1gafd1g2c4ae1a2f0fc"
msgid "Training. Planning. Worship. The blooding of Shar's warriors."
msgstr "훈련. 계획. 숭배. 샤의 전사들이 치르는 성인식."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Player
#. NodeID = c0355c83-ac2e-4d02-b4ca-c383a7c562c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:c0355c83-ac2e-4d02-b4ca-c383a7c562c0
msgctxt "hc1b4af40ge381g4bbbga17ag0d11075431be"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Orthon's Bed
#. NodeID = cbaf0e86-8171-4617-ac6a-a8144f0cd850
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:cbaf0e86-8171-4617-ac6a-a8144f0cd850
msgctxt "h6495aca0gb226g47d5gb55dgdb7e2dd6049b"
msgid "Everywhere. We came from all corners. To serve."
msgstr "모든 곳. 우린 세상 각지에서 왔다. 섬기기 위해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Orthon's Bed
#. NodeID = cd7665d5-4b91-4bc9-ba73-27f06c8c3ebf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:cd7665d5-4b91-4bc9-ba73-27f06c8c3ebf
msgctxt "h5e8ffeceg98e0g4589g8cc4ge620c493970f"
msgid "Shar's servants. Dark Justiciars."
msgstr "샤의 종복. 다크 저시티시어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Narrator
#. NodeID = cf24ade0-a48e-4b39-b61d-338fc48dda8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:cf24ade0-a48e-4b39-b61d-338fc48dda8a
msgctxt "ha37b6f99gf236g4878ga83dg4ed361df01e2"
msgid "*The pile of corpses do not stir. They will answer no more questions.*"
msgstr "*시체 더미는 더 이상 움직이지 않습니다. 그들은 더 이상 질문에 대답하지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Narrator
#. NodeID = d79cf345-d3da-4256-84ca-1e6a9a6c904a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:d79cf345-d3da-4256-84ca-1e6a9a6c904a
msgctxt "h1a3001c0ge594g41b7gaa02gf8bbfd6915ba"
msgid "*The tangle of corpses gape at you lifelessly.*"
msgstr "*뒤엉킨 시체들이 생기 없는 눈으로 당신을 바라봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Player
#. NodeID = d8eb4d92-fab3-49ed-ba4c-59d96c5c9edf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:d8eb4d92-fab3-49ed-ba4c-59d96c5c9edf
msgctxt "h725091e4gf692g4b35g89adg348c113dcd56"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Orthon's Bed
#. NodeID = eb2cb8b8-cafd-46f9-b566-1e59907f83b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_OrthonAttack = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:eb2cb8b8-cafd-46f9-b566-1e59907f83b8
msgctxt "h9f6eea2cgd7ffg447eg8dd4g55b2f3bd5492"
msgid "The tusked beast. It attacked. It <i>slaughtered.</i>"
msgstr "어금니의 짐승. 공격했다. <i>학살했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Narrator
#. NodeID = f63f5a62-2264-4980-a5de-f663bc1cacbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:f63f5a62-2264-4980-a5de-f663bc1cacbb
msgctxt "h5692cee6g06b1g451ega371g70e55d18a71f"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead
#. Speaker = Narrator
#. NodeID = fb7d4466-93ac-4a88-92da-f1cdb2095311
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_Dead:fb7d4466-93ac-4a88-92da-f1cdb2095311
msgctxt "h7a14e3ddg1952g4b0bg81c3g5ff638ad5979"
msgid "*The corpses seem willing to speak - but not to their killer.*"
msgstr "*시체들은 말할 의지가 있지만, 자신들을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "he32792b0gaa16g4368ga918g0f3815966dec"
msgid "Points for style, but certainly not for comfort."
msgstr "생긴 건 멋진데, 결코 편안해 보이진 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "hbf3eac2cg06ebg488agb329g1ec4c0a15888"
msgid "A bed of corpses. Hellish, of course - but I respect the commitment."
msgstr "시체로 만들어진 침대라. 섬뜩하긴 하지만, 그 정성만은 인정해 줘야겠군.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "hf773ddc1g0003g44begb9b4g850f2dd97cbf"
msgid "Now that can't be comfortable. Especially for the corpses."
msgstr "확실히 편안해 보이지는 않네. 특히 시체들은 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "hd18ea64cgc065g4ae5g9f85g2afe0b4c83ed"
msgid "A bed made of severed heads? That can't be good for your back."
msgstr "잘린 머리로 만든 침대? 확실히 허리에는 안 좋을 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "h83806915g26a8g4f14gb93fgc80ebfb0546e"
msgid ""
"I've made beds out of moss, twigs, even mud and bark - but even I have my "
"limits."
msgstr "이끼, 나뭇가지, 진흙이나 나무껍질 같은 거로도 침대는 만들어봤지만 내게도 지킬 선은 있었건만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "hdc2cd2d9gec7bg4a27ga565g5f6109c95b61"
msgid "How very devilish."
msgstr "아주 데빌답구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "h6381a2ccg5b26g4526g8b56g5babada0935b"
msgid "Imagine choosing this as your place of rest..."
msgstr "이런 것에서 쉴 생각을 하다니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD
#. Speaker = Player
#. NodeID = ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonBed_PAD:ce90dbc0-6695-42b1-a237-7bfc05d8cbb4
msgctxt "hb8b53a80g3a3dg405fgac21gf49e09d6374d"
msgid "A bed made of corpses. Disgusting <i>and</i> uncomfortable."
msgstr "사체로 만든 침대라니. 역겨운 <i>데다가</i> 불편하기까지 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = 1e341689-d9d7-47ab-801e-2c88af3d7ff2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 11580029-0578-1ea8-3575-6a0f6020d1b2_A = True
#. SetFlags:
#.   Local:
#.     - 11580029-0578-1ea8-3575-6a0f6020d1b2_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:1e341689-d9d7-47ab-801e-2c88af3d7ff2
msgctxt "hfc05850ag27b5g4b18ga0ecg0b510aae6992"
msgid "Keep your weapons sharp - our prey could reveal itself any time."
msgstr "무기를 잘 갈아 둬라. 사냥감은 언제든지 나타날 수 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Merregon
#. NodeID = 1e783d4f-788c-6f10-794e-b68049e97cf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:1e783d4f-788c-6f10-794e-b68049e97cf0
msgctxt "hd7dd34b7g0821g436bgb1ffg4f3676bff8dc"
msgid "*Wheeze.*"
msgstr "*쉬익쉬익.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = 2c4421fa-6dbb-7d63-438d-f593edee1543
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:2c4421fa-6dbb-7d63-438d-f593edee1543
msgctxt "h125cd00fg7dfdg47f6ga0b9g0777fcd2fa22"
msgid "I may do it anyway - liven this place up."
msgstr "그냥 던져버릴 수도 있어. 분위기라도 띄워야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = 4f22009a-7a58-ea22-839b-c2f1d2dc3e22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:4f22009a-7a58-ea22-839b-c2f1d2dc3e22
msgctxt "h0438d002gedd9g4601gb392g543a94e34adc"
msgid "Useless."
msgstr "쓸모없는 놈."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = 55c041df-288b-4a42-c027-50cbc3e729ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:55c041df-288b-4a42-c027-50cbc3e729ff
msgctxt "h68f9ef16g55a8g441bga1d2g4db09008f059"
msgid "Even Nessa makes better conversation than you."
msgstr "네사가 너보다도 대화를 잘하겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Merregon
#. NodeID = 635c527a-8915-51dc-7b36-b513d540c250
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:635c527a-8915-51dc-7b36-b513d540c250
msgctxt "h17e79b84g32bcg44e8gbed1g4a238c01eebd"
msgid "*Chitter.*"
msgstr "*찍찍*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Merregon
#. NodeID = 6ffa6c2c-7d94-5023-de24-38cd61ca396f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:6ffa6c2c-7d94-5023-de24-38cd61ca396f
msgctxt "h0900a7adgc5e3g4d8eg83cag38057305a7cb"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = 71592db6-5ceb-49dd-bf06-9bc436bfcbe8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 11580029-0578-1ea8-3575-6a0f6020d1b2_B = True
#. SetFlags:
#.   Local:
#.     - 11580029-0578-1ea8-3575-6a0f6020d1b2_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:71592db6-5ceb-49dd-bf06-9bc436bfcbe8
msgctxt "hef4e5861gb3a9g4a69gb1f3gfe53578633c7"
msgid ""
"All this time with you dullards for company. It's a wonder I haven't cracked "
"up."
msgstr "한종일 이 머저리들과 함께라니. 내가 돌아버리지 않은 게 신기할 지경이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = a3ac97ab-a211-442b-bfce-ed83c2fdd2bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 11580029-0578-1ea8-3575-6a0f6020d1b2_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:a3ac97ab-a211-442b-bfce-ed83c2fdd2bc
msgctxt "he9f20cf9g6cb2g4edcga1b3gd7d58fba41d7"
msgid "Anything to report?"
msgstr "보고할 게 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = a77609a9-1586-0c9d-f7cd-b578d947a390
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:a77609a9-1586-0c9d-f7cd-b578d947a390
msgctxt "h0cd23a9ag10beg435cga2b4g8fd3d1d8db1f"
msgid "Be ready, or I'll kill you myself."
msgstr "지금 당장 준비하지 않으면 내가 널 직접 죽여버리겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Yurgir
#. NodeID = c3b2a66e-6de0-472d-9303-8a16c14523ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 11580029-0578-1ea8-3575-6a0f6020d1b2_C = True
#. SetFlags:
#.   Local:
#.     - 11580029-0578-1ea8-3575-6a0f6020d1b2_C = False
#.     - 11580029-0578-1ea8-3575-6a0f6020d1b2_A = False
#.     - 11580029-0578-1ea8-3575-6a0f6020d1b2_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:c3b2a66e-6de0-472d-9303-8a16c14523ba
msgctxt "hdd07e617gba0fg4017g8867gcc64a246650f"
msgid "Go and find something to do or I'll throw you off a ledge."
msgstr "당장 가서 뭐라도 하지 않으면 널 절벽에서 던져버릴테다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon
#. Speaker = Merregon
#. NodeID = f369cd7b-c2a7-e0da-b714-d2dab50d684a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_AD_MerregonAndOrthon:f369cd7b-c2a7-e0da-b714-d2dab50d684a
msgctxt "ha49d0d95g537dg4003g884fg20e9ec708996"
msgid "*Whimper.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck
#. Speaker = Player
#. NodeID = e514eb53-1bd1-2515-d519-716e15f08033
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck:e514eb53-1bd1-2515-d519-716e15f08033
msgctxt "hc5bbe8bcg2dd4g46d5g9472g608ac6392eb2"
msgid "I have a terribly familiar feeling. We're being watched..."
msgstr "아주 익숙한 기분이 드는걸. 누군가 우릴 지켜보고 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck
#. Speaker = Player
#. NodeID = e514eb53-1bd1-2515-d519-716e15f08033
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck:e514eb53-1bd1-2515-d519-716e15f08033
msgctxt "hd66280f9g1fd3g463bgae1cg5ce751aea033"
msgid "I have the miserable feeling of being prey. Something's on the hunt..."
msgstr "사냥감이 되버린 듯한 비참한 느낌이 드는데. 무언가가 노리고 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck
#. Speaker = Player
#. NodeID = e514eb53-1bd1-2515-d519-716e15f08033
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck:e514eb53-1bd1-2515-d519-716e15f08033
msgctxt "hac8dc89eg9923g4c34gb756ge14da7144a17"
msgid "Ambush - and a devil. I can feel it."
msgstr "매복이야 - 데빌이군. 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck
#. Speaker = Player
#. NodeID = e514eb53-1bd1-2515-d519-716e15f08033
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck:e514eb53-1bd1-2515-d519-716e15f08033
msgctxt "hefbee1ccg9e98g4b16g9b01gb8c21099dec4"
msgid "Someone - some<i>thing</i> - is watching."
msgstr "누군가 - <i>뭔가</i> - 지켜보고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck
#. Speaker = Player
#. NodeID = e514eb53-1bd1-2515-d519-716e15f08033
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck:e514eb53-1bd1-2515-d519-716e15f08033
msgctxt "h962db8d7g5066g47e9g92acg3f66f25241a6"
msgid "Something's wrong - this feels like a trap."
msgstr "뭔가 잘못됐어 - 함정 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck
#. Speaker = Player
#. NodeID = e514eb53-1bd1-2515-d519-716e15f08033
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck:e514eb53-1bd1-2515-d519-716e15f08033
msgctxt "hc10e1f35g3188g4e0dgaf93g821ceb38163f"
msgid ""
"Hells - I feel like a mouse caught in a trap. All that's missing is the "
"cheese."
msgstr "젠장 - 덫 속의 생쥐가 된 느낌인데. 치즈만 있으면 되겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck
#. Speaker = Player
#. NodeID = e514eb53-1bd1-2515-d519-716e15f08033
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_AmbushPerceptionCheck:e514eb53-1bd1-2515-d519-716e15f08033
msgctxt "hbd87e4f6g6cb6g4e2ag84a8g4ec512681edd"
msgid "There's something out there - I can <i>feel</i> it."
msgstr "저기 뭔가 있어 - <i>느껴져</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "h91b79cb1g692dg4ff6g9712gcae44f045197"
msgid "Odd to see a hellsbeast here. Still, at least it's dead."
msgstr "지옥의 짐승을 여기서 보게되다니 희한한데. 뭐 이제는 죽었지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "he741c833g07edg440cga165gdbbab3df63c9"
msgid "Good riddance. This is no place for a wardevil."
msgstr "잘됐군. 여기가 워데빌이 있을 곳은 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "hf075fc1dg0776g43acgb0c1gd3c8b4ebafdf"
msgid ""
"Curious to find an orthon here - perhaps there was an untold tale behind "
"that."
msgstr "왜 오르쏜이 여기에 있는지 궁금하네 - 아마 우리가 모르는 사정이 있었겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "h273a949cga6dbg4a7dg92dag18e1c079624a"
msgid "Good riddance. That devil had no right to be here."
msgstr "잘했어. 그 데빌은 여기 있을 자격이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "hc7577245g669eg4bb8gafe3gfdd0fa7b8673"
msgid ""
"I've rid the Coast of a fair few devils. But orthons are rare outside the "
"Hells."
msgstr "나도 데빌 몇은 죽여 봤지만. 오르쏜은 지옥 밖에선 드문데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "hf771ac37g4dafg408cga1afg7e22403c81e7"
msgid "Wonder what a big bruiser like that was doing out of the Hells."
msgstr "저런 덩치가 지옥 밖에서 뭘 하고 있던 건지 궁금한걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "hba39b2dcgfd2bg45d4gb90ag04161efad51e"
msgid "That orthon was far from his natural home. What was he doing here...?"
msgstr "저 오르쏜은 고향에서 멀리도 왔군. 여기서 뭘 하고 있던 거지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = 07bee509-79de-478d-8af1-1101f17e10c5
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:07bee509-79de-478d-8af1-1101f17e10c5
msgctxt "h30295094g0106g4f7eg9da3gfc2777c12010"
msgid ""
"I wonder what brought an orthon to a place like this? We'll never find out "
"now..."
msgstr "도대체 뭐 때문에 오르쏜이 이런 곳까지 오게 된 거지? 영영 알 길은 없겠군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "h7c479d97g4cf2g407cgb445g067dd391a2eb"
msgid "There, it's dead. Now Raphael had better deliver on his promise."
msgstr "좋아, 죽었군. 이제 라파엘이 약속을 지키는지 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "ha484e295g1d1ag40bcg9736geb676850e0d3"
msgid "A battle to remember. I'm sure Raphael will be pleased..."
msgstr "기억에 남을 전투로군. 분명 라파엘은 만족할 거 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "h222c63ccg7b72g4578g8c32ga621d12c9d61"
msgid ""
"Seems like we tied up a loose end for Raphael. Not sure if he'll be grateful "
"though..."
msgstr "라파엘이 부탁한 뒤처리는 해냈어. 그가 감사해할지는 모르겠지만 말이야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "h09c4b0e0g8f22g43d5g9b29g542c9631bba5"
msgid "Looks like we've done Raphael's dirty work for him."
msgstr "라파엘이 시킨 뒤 구린 일을 우리가 해낸 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "he0e935a7g5039g46beg8386g77eea924e718"
msgid "The devil's fallen. Raphael will be pleased."
msgstr "데빌은 죽었다. 라파일이 기뻐하겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "hbab0168cge2a9g4c01g9cbdg1e9c3ff7c6b7"
msgid ""
"Not in the business of doing devils favours, but I suppose Raphael will be "
"glad."
msgstr "데빌의 부탁을 들어주는 건 탐탁치 않지만, 이거면 라파엘은 만족하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "h57bf9831gffbcg490agb767g8eee465fbcd1"
msgid "The brute is slain - to Raphael's benefit, it seems."
msgstr "야수가 쓰러졌다. 라파엘이 바라던 대로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon
#. Speaker = Player
#. NodeID = a6b31d54-1edb-493c-ac7f-c72c48d18f55
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_DefeatedOrthon:a6b31d54-1edb-493c-ac7f-c72c48d18f55
msgctxt "hf8a3de86gc07eg45b7g98e8g769b892672ba"
msgid "I suppose Raphael will be pleased, if nothing else..."
msgstr "적어도 라파엘은 만족할 것 같군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "h0aefc967g853dg4090g9532g8ef525c82c77"
msgid "Oh, well this is... a lot. What a lot of blood..."
msgstr "오, 이건 뭐... 많네. 정말 피가 많아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "hd9db2ddegef4dg447ag9f8agbbdfbb1013a5"
msgid "My, this must be the proverbial lion's den. Or lion's abattoir, rather."
msgstr "이런, 이거야말로 속담에서 말하는 사자 굴이겠네. 아니면 사자의 도살장이거나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "h7458239bg1c9dg4b74g8f0eg5f24e47e8b01"
msgid "We need those gems. Of course."
msgstr "우린 저 보석이 필요해. 당연한 얘기지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "hc1215aafg96afg4f04gaa7bg6e63b7cf8fe8"
msgid "A dragon's lair worth of entrails. A shame I missed the battle."
msgstr "드래곤 둥지에나 어울릴 내장들이로군. 그 과정을 못 봐서 아쉬운걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "h21a00a41g590ag4c99g9874g869af290e759"
msgid ""
"You could almost row a boat through here, with all the blood that was "
"spilled. What happened?"
msgstr "보트를 타고 다닐 수 있을 정도로 피가 넘치는걸. 대체 무슨 일이 있던 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "h2b7f6583g1690g4e30gb80fg71d8d6cbc0b5"
msgid ""
"Even a dragon's corpse doesn't spill this much blood. What happened here?"
msgstr "드래곤도 이 정도의 피를 쏟아내진 못할 텐데. 여기 무슨 일이 있었던 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "h6eca0e02g976cg4afeg9ba0g85b194f9ec91"
msgid "<i>Chk</i>. Enough viscera to rival a githyanki sparring circle."
msgstr "<i>츠크</i>. 이 정도 내장이면 기스양키 대련장에 비할 정도는 되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair
#. Speaker = Player
#. NodeID = 6911a795-10d2-20d0-97ef-67c32f3cd025
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonLair_PAD_EnteredLair:6911a795-10d2-20d0-97ef-67c32f3cd025
msgctxt "he560dfe2g27d1g4994g85c9g83574093cc45"
msgid "So much blood... what the hells has been happening here?"
msgstr "피가 정말 많네... 도대체 여기서 무슨 일이 일어난 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD
#. Speaker = Yurgir
#. NodeID = 541f5fe2-3332-4bb6-b45e-6e4a5e7ef9ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_A = True
#. SetFlags:
#.   Local:
#.     - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD:541f5fe2-3332-4bb6-b45e-6e4a5e7ef9ef
msgctxt "h2168348dgacfbg4e1dgb0f8g2a7c305d5dd0"
msgid "<i>Silence all prayers; smother each rite... </i>blasted song!"
msgstr "<i>기도를 멈춰라; 모든 의식을 막아라... </i>이 망할 노래!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD
#. Speaker = Yurgir
#. NodeID = 6b97986d-fa76-42e3-93ad-bcc77c05ce99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_B = True
#. SetFlags:
#.   Local:
#.     - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD:6b97986d-fa76-42e3-93ad-bcc77c05ce99
msgctxt "h206f9e40gd371g40b9gb26cg032189fadc0d"
msgid "<i>Wander Shar's halls; hungry to slay...</i>"
msgstr "<i>샤의 복도를 걸어라, 피에 보아라...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD
#. Speaker = Yurgir
#. NodeID = a698d1b4-0189-43a3-9928-c55e86679d97
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD:a698d1b4-0189-43a3-9928-c55e86679d97
msgctxt "h8c69604ag44f3g43f8gb6e2g5b7f3467a223"
msgid "<i>Spill all the blood sworn to the night.</i>"
msgstr "<i>밤에게 맹세한 모든 피를 흘려라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD
#. Speaker = Yurgir
#. NodeID = c470a01d-3dd3-4b17-a358-310913264747
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_C = True
#. SetFlags:
#.   Local:
#.     - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_B = False
#.     - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_C = False
#.     - 3c55f670-825a-6a8d-9e7e-8a5b7aa2f852_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD:c470a01d-3dd3-4b17-a358-310913264747
msgctxt "hdc5dfd32gdcfcg4e37gb8f6g5de6767b788a"
msgid "Even a chorus of screams can't drown out the song."
msgstr "떼로 내지르는 비명마저도 노랫소리를 덮진 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_AmbushStartsAtUpperFloor
#. Speaker = Yurgir
#. NodeID = f35c14c7-f57a-6382-65da-20ed82718edf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_AmbushStartsAtUpperFloor:f35c14c7-f57a-6382-65da-20ed82718edf
msgctxt "hbf112473ga501g4b08gbc2ag1a9006eab1d4"
msgid ""
"Think you can get the drop on me? <i>Wrong</i>. Merregons - rip out their "
"lungs!"
msgstr "감히 날 기습할 수 있을 거라 생각했나? <i>어림도 없지</i>. 메레곤 - 저 놈들의 허파를 뜯어버려라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_BetrayedByDisplacer
#. Speaker = Yurgir
#. NodeID = 9c3b02e4-e033-5efc-3d81-9c8fad9cd3c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_BetrayedByDisplacer:9c3b02e4-e033-5efc-3d81-9c8fad9cd3c6
msgctxt "hb8041a17gf46cg4735ga792g734f914a4dee"
msgid "Nessa...? No! I'm your master!"
msgstr "네사...? 안돼! 난 네 주인이라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_DisplacerGrowl
#. Speaker = Displacer Beast
#. NodeID = e8785357-a904-4470-93b7-26f1788a1771
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_DisplacerGrowl:e8785357-a904-4470-93b7-26f1788a1771
msgctxt "h1de39b62g528dg4696g83b3gda60433b672a"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_FormLines
#. Speaker = Yurgir
#. NodeID = 1d8383b6-d55c-dabe-71f9-6b71b05d08fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_FormLines:1d8383b6-d55c-dabe-71f9-6b71b05d08fe
msgctxt "h89218077gca23g4f71g9624g1d4a9b05d2f7"
msgid "Form up ranks! Don't let anything get past you!"
msgstr "대열을 형성하라! 아무것도 놓치지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy
#. Speaker = Yurgir
#. NodeID = 45846298-e137-4915-9ece-4594298be6e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_A = True
#. SetFlags:
#.   Local:
#.     - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy:45846298-e137-4915-9ece-4594298be6e6
msgctxt "h76a7554cg5f37g4cf9g9ebcg2fa6aa62fc22"
msgid "Another kill for me - aren't you embarrassed?!"
msgstr "또 죽여버렸군 - 부끄럽지도 않은 게냐?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy
#. Speaker = Yurgir
#. NodeID = c81df2fe-c1b4-48be-8948-f35b575dc0e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_B = True
#. SetFlags:
#.   Local:
#.     - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy:c81df2fe-c1b4-48be-8948-f35b575dc0e7
msgctxt "hf3601072g0d7eg469ag826dg5b959a142332"
msgid "Where's the challenge? Should I blindfold myself? Use one arm?"
msgstr "그래서야 싸움이 되겠어? 눈이라도 가릴까? 팔 하나만 쓸까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy
#. Speaker = Yurgir
#. NodeID = dd1c16e9-bc4c-4ff2-82fb-c4925fdd7342
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy:dd1c16e9-bc4c-4ff2-82fb-c4925fdd7342
msgctxt "hfdf87a90g8a0ag4c8bga161g0aa8b0964a13"
msgid "Weaker than a lemure!"
msgstr "레무어보다도 약하군!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy
#. Speaker = Yurgir
#. NodeID = eefa1358-2b6b-4faa-be56-fdc337d1f895
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_C = True
#. SetFlags:
#.   Local:
#.     - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_A = False
#.     - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_C = False
#.     - be327b99-6d25-e0b1-7c31-cdaa0a7564e6_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_KilledEnemy:eefa1358-2b6b-4faa-be56-fdc337d1f895
msgctxt "h6587a5a8g90d0g4819gadbeg49d6104380bd"
msgid ""
"Pathetic. If you can't fight with style, at least <i>die </i>with style."
msgstr "애처롭군. 멋지게 싸울 수 없다면, 최소한 멋지게 <i>죽기라도</i> 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_MineClusterAbility
#. Speaker = Yurgir
#. NodeID = 2bc66558-96d6-f251-f1b1-81e02b36c10b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_MineClusterAbility:2bc66558-96d6-f251-f1b1-81e02b36c10b
msgctxt "hfbdfd6eeg95d1g404fgb47dgd222958c2155"
msgid "Let's see how many pieces can be blasted off you before you die."
msgstr "네놈이 죽기 전에 그 몸에서 살을 몇 점이나 떼어낼 수 있을지 보자꾸나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_MonitorLeaves
#. Speaker = Raphael
#. NodeID = 3f2d904a-61f3-4685-8f31-bac1cfae07e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_MonitorLeaves:3f2d904a-61f3-4685-8f31-bac1cfae07e3
msgctxt "h6c15c3adgc99eg4fa7ga05cg2c9195286869"
msgid "You're not worth the trouble."
msgstr "상대할 가치도 없군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_TransitionsToSecondPhase
#. Speaker = Yurgir
#. NodeID = 04793c9c-2343-58aa-f27b-98a1226647d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Event_ReachedHPThreshold = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_TransitionsToSecondPhase:04793c9c-2343-58aa-f27b-98a1226647d1
msgctxt "h19fcc4deg603bg4451ga44bg486ffd3331b2"
msgid ""
"Bravo - that almost stung. Perhaps I'll make a merregon of you, once you're "
"dead."
msgstr "괜찮네 - 조금 아플뻔했어. 네가 죽으면 메레곤으로 만드는 것도 괜찮을 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_TransitionsToSecondPhase
#. Speaker = Yurgir
#. NodeID = 11e23bb6-7583-6460-3afb-ba7830acd29d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Event_KilledMultipleMerregons = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_TransitionsToSecondPhase:11e23bb6-7583-6460-3afb-ba7830acd29d
msgctxt "hcdcb1f13g8e03g4412gafdcgcdec7fec2fff"
msgid "Had your fill of my merregons yet? I'm right here, if you dare."
msgstr "메레곤들로 만족했나? 난 여기 있으니 덤벼보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_TransitionsToSecondPhase
#. Speaker = Yurgir
#. NodeID = 9c21cd70-b9a5-5259-0644-693e8b4931ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_OrthonLair_Event_ReachedSpecifiedRound = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_TransitionsToSecondPhase:9c21cd70-b9a5-5259-0644-693e8b4931ec
msgctxt "hd3a01689ga8f1g4dd4ga69cgef6479a12643"
msgid ""
"Fight's gotten stale, little rabbit. Stop embarrassing yourself - let me end "
"this."
msgstr "하품이 나오는구나, 작은 토끼야. 추태를 부리는 것도 그쯤 하지. 내가 끝을 내주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_VictimStand
#. Speaker = Narrator
#. NodeID = 0667bd27-be1e-4383-9f4e-bfde96086f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_VictimStand:0667bd27-be1e-4383-9f4e-bfde96086f9b
msgctxt "hc739edd9g5266g4711g9ee9g8d0ee2d0b889"
msgid ""
"*A macabre arrangement of flesh. Only a truly depraved mind could dream of "
"such a thing.*"
msgstr "*살덩이가 섬뜩하게 배치되어 있습니다. 진정으로 타락한 정신만이 상상해낼 법한 모습입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_VictimStand
#. Speaker = Narrator
#. NodeID = 0667bd27-be1e-4383-9f4e-bfde96086f9b
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_VictimStand:0667bd27-be1e-4383-9f4e-bfde96086f9b
msgctxt "h4a4062f1g0b29g4113g810cgd94b2d892515"
msgid ""
"*A ghoulish display. It is clear the victim suffered greatly before dying "
"and being put on show.*"
msgstr "*엽기적인 광경입니다. 엄청난 고통에 시달리다 죽는 것이 분명한 희생자가 보란 듯 전시되어 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_VictimStand
#. Speaker = Narrator
#. NodeID = 0667bd27-be1e-4383-9f4e-bfde96086f9b
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_AD_VictimStand:0667bd27-be1e-4383-9f4e-bfde96086f9b
msgctxt "h99e77394g216ag401bg868bgde52211368b9"
msgid "*A foul totem of agony, mounted with sadistic relish.*"
msgstr "*역겨운 고통의 토템입니다. 가학적 희열이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "h797f4dcbgf550g4272gb5e1gca363bcbbf3c"
msgid "Well well - <i>someone's</i> an artist."
msgstr "이런 이런 - 여기 <i>예술가</i>가 있나 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "h8caabbfcg9cf0g4b21gb5ffg210716241039"
msgid "A gruesome display. Someone's idea of art, it seems."
msgstr "소름 끼치는 광경이군. 누군가는 예술 작품이라고 생각한 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "haeb707f7g6bfdg42aag9f55geac2a70dddc2"
msgid ""
"These corpses are arranged with some artistic flair - if you're a madman, "
"that is."
msgstr "이 시체들을 배치하면서 예술적 감각이라도 발휘한 것 같네. 물론 미친놈 기준이긴 하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "h269f400egd635g49cdg8fb8gb0966822276a"
msgid ""
"There's a grim sort of artistry in how these remains are laid out. Someone "
"has a creative streak..."
msgstr "뭔가 음침한 예술적 감각이 느껴져. 이 유해들이 펼쳐진 모습 말이야. 누군진 몰라도 창의적인 구석이 있나 본데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "h526ab151g8548g4765gbb72g771031ec710d"
msgid "Horrible slaughter made into a crude gallery."
msgstr "끔찍한 학살이 조잡한 작품으로 바뀌었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "h051f6f4fg600fg4eddg823ega8289711bc56"
msgid "That's just horrible."
msgstr "정말 끔찍하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "hb2216943ge64bg417agb449g475b8a33d1e1"
msgid ""
"Defiled corpses... there is almost a sort of vile artistry in how they are "
"displayed."
msgstr "시신들을 욕보이다니... 전시된 모습을 보니 일종의 혐오스러운 미적 감각마저 느껴질 정도일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = 405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:405fc0cc-f9e3-4f93-8b8f-ea95a2377fb8
msgctxt "he43a585agbc0dg4eb7g800bg7db1ac0c9f93"
msgid "A very gory idea of art."
msgstr "굉장히 잔인한 발상이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "h012099a5gdd27g4ebfgb417ged56c0072913"
msgid "Look at that - this orthon's not just a killer, but an artist!"
msgstr "이런 - 이 오르쏜은 단순한 살인마가 아니라 예술가인 모양이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "h7b137aabg846eg4b3eg9de7g94b9e55874c5"
msgid "It seems our orthon kills with a flair for art."
msgstr "우리 오르쏜은 예술에 대한 열정을 가지고 살인을 하나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "hfd1b93f9g9f2eg46bcg8bf0gd4ebd8bd9dca"
msgid ""
"That orthon shows some artistry in his corpse arrangements. I suppose he had "
"time to kill..."
msgstr "오르쏜이 시체를 배치하는데 예술적 감각이라도 발휘한 모양이군. 남아도는 시간도 죽일 겸..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "h852bf782gecf8g46b6g916dg8f7be27db087"
msgid ""
"The orthon's been having a little too much fun with these corpses, I think..."
msgstr "저 오르쏜은 시체들을 가지고 노는 게 좀 지나친 것 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "h3cd5ff81g793fg4f95gb70agff06643b14aa"
msgid ""
"Well - seems the orthon kills with substance <i>and</i> style. How charming."
msgstr "보아하니 오르쏜은 살해를 할 때 실속과 겉모습 <i>모두</i> 따지는 모양이야. 대단하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "h4c393ba4gd486g4811gac4dg52412958903d"
msgid "Just one example of why I'll never return to the Hells."
msgstr "내가 절대 지옥으로 돌아가고 싶지 않은 이유의 첫 번째 예시네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "h147e4cbegabbcg4497gbd55gb6593dbcd582"
msgid ""
"This orthon seems to show artistic flair in displaying his victims. A missed "
"calling, perhaps."
msgstr "이 오르쏜은 희생자를 전시하며 예술적 감각을 뽐내는 것 같군. 진로를 잘못 고른 모양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay
#. Speaker = Player
#. NodeID = ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_HasMet(0) = True
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_PAD_VictimsDisplay:ba242c5a-5234-4d49-9b11-dc7e5fd21d5f
msgctxt "hd66957a3g6c4eg422dg9770g4ca5b7a99bbd"
msgid "This orthon isn't just a killer. He's an artist, too."
msgstr "이 오르쏜은 단순한 살인마가 아니라 예술가이기도 한 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 0b02eb3d-23f7-94bd-d051-d19738f4ba01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:0b02eb3d-23f7-94bd-d051-d19738f4ba01
msgctxt "h4ac6dfcag3c64g4b27gade2gc2db891ae437"
msgid "Where is he? Spit it out - <i>Now.</i>"
msgstr "놈은 어디 있지? 말해라. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 0b2c2cf7-8e68-c2d3-37ba-0a4ee7ca2927
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_EngineIsGoingToExplode = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:0b2c2cf7-8e68-c2d3-37ba-0a4ee7ca2927
msgctxt "hf8534f84g8f8bg482dg89cbgde46892168c2"
msgid ""
"Only what I can smell. And whatever engine burns within you is grinding to "
"an inevitable explosion. Burning and fear - you <i>reek </i>with it."
msgstr ""
"난 냄새를 맡을 뿐이야. 그리고 네 엔진은 불가피한 폭발을 향해 달려가고 있군. 불꽃과 공포 - 너한테선 그런 <i>악취 </i>가 나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 0ba04a75-5a59-8287-e22e-6a14b56d6997
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:0ba04a75-5a59-8287-e22e-6a14b56d6997
msgctxt "h6440dd27g7eefg4cf0gb780gba737a0fa405"
msgid ""
"My dear hunter, isn't it obvious? You must kill yourself - then you'll be "
"free."
msgstr "친애하는 사냥꾼이여, 뻔하지 않나? 넌 스스로를 죽여야 해 - 그러면 자유가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 0e14026e-e093-d601-3552-f216bc0a7eb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:0e14026e-e093-d601-3552-f216bc0a7eb1
msgctxt "hbc9fee4dgc238g41edg87ccg3350e2c35003"
msgid "Stay very still, my beauty..."
msgstr "가만히 있으렴, 이쁜아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 0f199f5e-c7c8-3f84-c254-6233e75c590c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:0f199f5e-c7c8-3f84-c254-6233e75c590c
msgctxt "hf48e146cgbb2bg40a2gb752g73b06d439ef0"
msgid "Bold of you. Stupid, but bold."
msgstr "대담하구만. 멍청하게도. 하지만 확실히 대담해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 126cd966-9987-a66a-677a-0e3786e69c3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:126cd966-9987-a66a-677a-0e3786e69c3b
msgctxt "hdff5851dg39c4g4840ga33bgcb8c16b8c43b"
msgid "Bravo."
msgstr "브라보."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 13105ffd-39d7-a65f-01ae-03771117eca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:13105ffd-39d7-a65f-01ae-03771117eca8
msgctxt "haccb5c74ga682g4819g949bg381354c1f466"
msgid ""
"You're hardly free as it is, trapped here. Maybe you're better off indebted "
"to Raphael."
msgstr "여기에 갇혀있으니 지금도 딱히 자유롭진 않은 것 같은데. 차라리 라파엘에게 신세지는 게 낫지 않을까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Karlach
#. NodeID = 162cb9d7-3f7b-216b-1e1e-a6b5b01bed93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(13) = True
#.   Tag:
#.      - REALLY_KARLACH(13) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:162cb9d7-3f7b-216b-1e1e-a6b5b01bed93
msgctxt "h6ae5f598ga956g4895gb100g2a30e475666c"
msgid ""
"Not surprised this guy stomped all those Dark Justiciars. It's what orthons "
"<i>do.</i>"
msgstr "이 자식이 다크 저스티시어를 전부 뭉개버린 게 놀랍진 않네. 그게 오르쏜이 하는 <i>일이지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 17803ac6-2af2-914f-9297-e77dad8ce316
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_TrespassLair_Event_ContractMentioned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:17803ac6-2af2-914f-9297-e77dad8ce316
msgctxt "hcd887641g2672g4610gafe9g5f585fb5bbd1"
msgid "<i>Words</i>. A contract penned by that deceitful slug Raphael."
msgstr "<i>말</i>. 그 능구렁이 사기꾼 라파엘이 작성한 계약이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 17a86f70-e657-302a-24de-23329f23c809
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = False
#.     - SHA_Orthon_Event_SearchPersuasionSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:17a86f70-e657-302a-24de-23329f23c809
#, fuzzy
#| msgid ""
#| "<i>Haggling. </i>A grubby little trait. Fine, there's a gem I keep over by "
#| "my bed. Kill the justiciar, and it's yours."
msgctxt "hf26c1a69g2659g47d4ga01egdc91f6622f3d"
msgid ""
"<i>Haggling.</i> A grubby little trait. Fine, there's a gem I keep over by "
"my bed. Kill the Justiciar, and it's yours."
msgstr "<i>흥정이라.</i> 추잡한 특성이군. 알았다. 내 침대 곁에 보관하는 보석이 있어. 저스티시어를 죽이면 가져가도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 1b5c30fd-eeee-2637-2d73-f7188da544f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:1b5c30fd-eeee-2637-2d73-f7188da544f3
msgctxt "h0d56fcf0g1993g46f5gbe31g4a85a93a615b"
msgid ""
"Raphael made double-sure of that: I can't forget the damned thing so long as "
"my work's not finished."
msgstr "라파엘이 그걸 확실히 했지. 난 이 일이 끝나기 전까진 그 망할 노래를 잊을 수가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 1d7af040-7f3a-6988-4d23-b042a579e49e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#. SetFlags:
#.   Local:
#.     - 4b5335a8-f967-9b03-758f-682fa7b3fcbf_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:1d7af040-7f3a-6988-4d23-b042a579e49e
msgctxt "h1a21e759gaab3g4551g9491gf01d4c8e5590"
msgid "Perhaps I can help you escape his trap."
msgstr "어쩌면 내가 이 곳에서 탈출하는데 도와줄 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 1db94d81-ef91-4eb6-bf34-a4597739459c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:1db94d81-ef91-4eb6-bf34-a4597739459c
msgctxt "h9662b86eg0eb8g4d30gbdf3g4cd2be12de94"
msgid "...That's it."
msgstr "...이게 다야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Karlach
#. NodeID = 1ecc7a28-d514-906e-0758-fd7695b1ad65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:1ecc7a28-d514-906e-0758-fd7695b1ad65
msgctxt "hb66e2c18g6266g428dgbd3eg3b3c2fb569c8"
msgid ""
"Not surprised this guy single-handedly wiped out the Dark Justiciars here. "
"Fucker is <i>stacked.</i>"
msgstr "이 녀석이 여기서 혼자 다크 저스티시어를 쓸어버린 건 별로 놀랍진 않아. 좆같은 놈들, 아주 <i>떼로</i> 죽었네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 219eae64-b45d-69c0-3576-a41162490d7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:219eae64-b45d-69c0-3576-a41162490d7a
msgctxt "h98f5b77bg7cdag41cdg8a65gf981c0601eaa"
msgid "That perfumed trickster swindled me - <i>trapped </i>me."
msgstr "그 향수 냄새 풍기는 사기꾼 자식이 날 속였어. 여기 <i>가뒀다고</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 232721fb-211b-e922-046e-40181ae0ecc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:232721fb-211b-e922-046e-40181ae0ecc0
msgctxt "hcf2781a8gb4e1g4051gaae8g7aa805e9b8b5"
msgid ""
"Hah! Perhaps this is true of the mundane traps you know. But I am held here "
"by something stronger."
msgstr "하! 네녀석들의 보잘것없는 함정이라면 그렇겠지. 하지만 난 좀 더 강한 것에 의해 여기 묶여있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 257e65b6-8e85-0fc7-66c8-9feced64e937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:257e65b6-8e85-0fc7-66c8-9feced64e937
msgctxt "h14dcef14gd48cg432ag81a2g188e4291a2fa"
msgid ""
"<i>Bargaining</i>, are you? A Kara-Tur warlord once tried the same - I made "
"him watch as I ate his concubines and young, then fashioned a codpiece from "
"his skull."
msgstr ""
"<i>협상</i>하는 거냐? 전에 어떤 카라투어 장군이 그러려고 한 적이 있지. 놈의 첩과 새끼를 먹는 모습을 지켜보게 한 다음, 그놈 "
"두개골은 사타구니 가리개로 써 주었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 265bd43b-13ae-03fc-6902-3797846a88d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:265bd43b-13ae-03fc-6902-3797846a88d5
msgctxt "h595859begb982g4955gb57eg6a51ab133c52"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Astarion
#. NodeID = 2a915942-d2b2-ac39-6ceb-d9e4c192212d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_GotQuestFromRaphael = True
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(14) = True
#.   Tag:
#.      - REALLY_ASTARION(14) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2a915942-d2b2-ac39-6ceb-d9e4c192212d
msgctxt "hef384d92gc7feg4219ga27cg0e2b5c8ea397"
msgid "Does... does that count as us killing him? That had better count."
msgstr "저것도... 죽인 걸로 치는 거지? 그래야 할 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Lae'zel
#. NodeID = 2bdd9bc2-c109-9fb8-0507-027180876f58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.      - ORI_Shadowheart_RomancingShadowheart(11) = False
#.   Tag:
#.      - REALLY_LAEZEL(11) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2bdd9bc2-c109-9fb8-0507-027180876f58
msgctxt "h742db7c8gc505g4d16gb460g4c9790c9f0a1"
msgid ""
"Tell him, or don't - it doesn't matter, so long as you grant me the killing "
"blow."
msgstr "날려버릴 수 있게 해 준다면야, 대답하든 안 하든 아무 상관 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 2bf0bbd5-20a3-8358-9482-7aa77c016fae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_Knows_ContractClause = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2bf0bbd5-20a3-8358-9482-7aa77c016fae
msgctxt "h4d70d764g8e23g4646g8355g806e8697395e"
msgid ""
"I did as instructed, but the song still rattles about in my head - the "
"contract still stands, somehow. If I break it, I will become Raphael's slave "
"forever."
msgstr ""
"난 계약대로 했어, 그런데도 노래는 내 머릿속에서 울려 - 계약은 어떤 식으로든 끝나지 않았어. 만일 계약을 지키지 못하면, 난 영원히 "
"라파엘의 노예가 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 2cffcfd9-4445-2c16-c05b-7cfa45363857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2cffcfd9-4445-2c16-c05b-7cfa45363857
msgctxt "h01970540g9aa6g4d00gb390gf6bfed2846a7"
msgid "Such high confidence for someone who reeks so distinctively of fear."
msgstr "이렇게나 공포에 질린 냄새가 나는 주제에 말은 자신 있게도 잘 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 2eefc097-7946-7837-77e5-fa1abca2aebd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2eefc097-7946-7837-77e5-fa1abca2aebd
msgctxt "hb33cd8f8gf78fg4820g8fdfg75fc8e65af0f"
msgid ""
"<i>Leave none to hear it, then be set free; \n"
"This song is your oath, swear, swear it to me.</i>"
msgstr ""
"<i>들어본 이 하나 없게 하라, 그러면 자유가 되리니.\n"
"이 노래가 너의 계약이니, 맹세하라, 내게 맹세하라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = 2f1b77eb-cf28-9be8-2b39-0df814877ff0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_SongInsightSuccess(1) = True
#. TagRule: BARD
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2f1b77eb-cf28-9be8-2b39-0df814877ff0
msgctxt "h30aeacb3g22c8g4b3dga5a3g8092b08c254d"
msgid ""
"*This song differs from others you've studied. The final couplet contains a "
"trick: a clause not easily fulfilled.*"
msgstr "*당신이 공부하던 노래와는 다릅니다. 마지막 두 행에 함정이 있군요. 쉽게 충족할 수 없는 조항입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = 2f1b77eb-cf28-9be8-2b39-0df814877ff0
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_SongInsightSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2f1b77eb-cf28-9be8-2b39-0df814877ff0
msgctxt "h0b6b11a4g73e1g4168g9763gdbeb8303bf16"
msgid ""
"*The final lyrics linger in your mind. There is a trick buried within them - "
"a clause that cannot easily be fulfilled.*"
msgstr "*마지막 가사가 머릿속을 맴돕니다. 끝에 함정이 숨어있군요. 쉽게 충족할 수 없는 조항입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 2f82382e-1552-e8fe-85bc-dcabecbeaad3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:2f82382e-1552-e8fe-85bc-dcabecbeaad3
msgctxt "h98f46427g5cf1g4e03g8e62ga318c345decc"
msgid "Oh no, little rabbit. You don't get to just hop away."
msgstr "그렇겐 안 되지, 작은 토끼야. 어디로 깡총거리려는 게냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 31836c87-7a34-7aff-da74-1477b66083e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:31836c87-7a34-7aff-da74-1477b66083e1
msgctxt "hedfb314dgfe22g443fg89e9g0c4fe06ab391"
msgid ""
"Anyway, enough prattle. The lyrics are clear - all who hear the song must "
"die."
msgstr "어쨌든, 잡담은 그만. 가사는 명확해 - 노래를 듣는 사람은 모조리 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 31aa22f7-78e7-adaf-3c34-b0ea212be478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:31aa22f7-78e7-adaf-3c34-b0ea212be478
msgctxt "ha6faffb4ge710g438fg9522g91f3f6f3b6e1"
msgid "Then they failed her, and you never met a true servant of Shar."
msgstr "그렇다면 그분을 실망시킨 자들이군. 넌 진짜 샤의 종복을 만난 적이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 3378f9e2-4575-c1a3-8da2-83b74ea4d349
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:3378f9e2-4575-c1a3-8da2-83b74ea4d349
msgctxt "h9e8901c9gaa02g481bg91fagf915010beced"
msgid ""
"Raphael is no foolish story-devil, his mind is <i>different</i>. Sneaky. "
"Listen..."
msgstr "라파엘은 동화 속의 멍청한 데빌이 아니야. 그는 <i>달라</i>. 음흉하지. 들어라..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 3676a41b-fd00-ea2b-001e-a144b6faac6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:3676a41b-fd00-ea2b-001e-a144b6faac6a
msgctxt "hf2c1e242g6fd1g4c02gab2cgd6e34b819f2a"
msgid "You are mouthy, little rabbit. This will be -"
msgstr "말은 잘하는구나, 작은 토끼야. 널 그냥 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 37a101d9-1110-54be-85db-70ee248edb6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:37a101d9-1110-54be-85db-70ee248edb6c
msgctxt "h909a77eegc43ag4b7dgbe9fg57756fc37373"
msgid "I still hear it. Seems your theory is wrong."
msgstr "아직도 들려. 네 이론이 틀린 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 3acd8ab4-856e-3389-648b-6705ccdd3d6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:3acd8ab4-856e-3389-648b-6705ccdd3d6e
msgctxt "ha9498b00g503fg4b83g82e7g1dcf84315bef"
msgid ""
"I happen to be an expert in such deals - and there is <i>always </i>a "
"loophole."
msgstr "그런 거래라면 나도 일가견이 있어. 그리고 그 거래엔 <i>백이면 백</i> 허점이 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 3b86deab-7c75-3be7-266e-7b6749358474
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:3b86deab-7c75-3be7-266e-7b6749358474
msgctxt "hffc51625g27eeg413bg922bg1df62cfe0073"
msgid ""
"I deal in blood and bones - not cogs and wrenches. Tell me what I wish to "
"know, or you'll find that out first hand."
msgstr "난 피와 뼈를 다룬다. 톱니바퀴와 렌치가 아니라. 내가 알고자 하는 것을 말하지 않으면 직접 몸으로 느끼게 해 주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 3c756581-f6e5-a730-57c6-44e9238389b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:3c756581-f6e5-a730-57c6-44e9238389b6
msgctxt "h4390d415g9838g4cc4gbbc9gc81b32973823"
msgid "Time to die."
msgstr "죽을 시간이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 3ebaff44-bdd8-b66d-c552-2ae265a033ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:3ebaff44-bdd8-b66d-c552-2ae265a033ca
msgctxt "h818f44d4g717cg43ddg9a21gcb108be0d5fc"
msgid "I don't know what you mean."
msgstr "무슨 말을 하는지 모르겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 40584687-16fc-4c2f-f8dc-35d44d241ee1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:40584687-16fc-4c2f-f8dc-35d44d241ee1
msgctxt "hc4ee5683gd228g493cga119gc931459b060c"
msgid ""
"Go on then. But if you're lying - if you <i>run </i>- there'll be nowhere "
"that's safe for you."
msgstr "그럼 가봐. 하지만 만약 네가 거짓말을 하거나, <i>도망친다면</i> - 어디서든 안전하지 못할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 4077f73b-9d9e-3e48-8570-ee6ea39635db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4077f73b-9d9e-3e48-8570-ee6ea39635db
msgctxt "h691a7711g54d4g49ffg86cdg2c1b8ec23de4"
msgid "There's nothing stopping you from leaving. I know a way out."
msgstr "넌 언제든지 떠날 수 있어. 내가 나가는 길도 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 41871918-0efa-4a98-b83d-11dd6a424393
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(12) = True
#. TagRule: (CLERIC_EVIL or PALADIN_EVIL) and !(CLERIC_SHAR and PALADIN_SHAR)
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:41871918-0efa-4a98-b83d-11dd6a424393
msgctxt "hcf1632d9g9072g4bdegacd1g28647e5736cb"
msgid ""
"Shar is not my goddess, but I can respect her. I ought to kill you for what "
"you have done to her temple."
msgstr "난 샤를 섬기지는 않지만, 존중하는 편이다. 네가 샤 사원에 저지른 짓 때문에라도 널 죽여야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 419c3079-ec5c-4ed1-94ba-dc3bd209c8e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:419c3079-ec5c-4ed1-94ba-dc3bd209c8e3
msgctxt "he14019b1gd7c9g4481gab71gd5ddd3edcc30"
msgid ""
"Raphael could be anywhere. But let me go, and I'll free you from his grasp."
msgstr "라파엘은 어디에나 있을 수 있지. 하지만 날 보내주면 내가 그의 손아귀에서 널 풀어주도록 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 42246a95-fc04-4a97-d56d-c811a337062a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:42246a95-fc04-4a97-d56d-c811a337062a
msgctxt "h635ea7bcg79dcg4d73gaf52ga8d32f8dd703"
msgid "You blaspheme this holy place. I must strike you down."
msgstr "이 신성한 장소를 모독하다니. 널 쓰러트리겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Astarion
#. NodeID = 4235111b-a1f1-4cd8-bf10-52029715f549
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(14) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4235111b-a1f1-4cd8-bf10-52029715f549
msgctxt "hdc9deee7g6e8dg425fg9a66g4e0824c39d29"
msgid "So he's the one who slaughtered the Justiciars - we can kill him now?"
msgstr "저 녀석이 저스티시어들을 학살한 장본인이로군. 이제 그만 죽여도 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Gale
#. NodeID = 4239dfda-4307-8479-f66c-d98762ba004a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(16) = True
#.   Tag:
#.      - REALLY_GALE(16) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4239dfda-4307-8479-f66c-d98762ba004a
msgctxt "hfb4da6bfga733g499cgb284g0690a246e231"
msgid ""
"While two devils fight over a bone - well, we should just run away and let "
"them sort it among themselves."
msgstr "두 데빌이 뼛조각 하나를 두고 싸우는 동안... 흠, 우리는 그냥 도망가고 그들끼리 알아서 해결하라 하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 42654ac0-8472-aa8c-7e23-c772ec6a859d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:42654ac0-8472-aa8c-7e23-c772ec6a859d
msgctxt "h852c4830g4810g4b18gb610gf7dc2e2e9204"
msgid "Your words thrum with violence. Peace - let us speak."
msgstr "너의 말은 폭력으로 가득하구나. 평화롭게... 얘기 해 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 45a841dd-8642-a6d5-90bf-cb3942d1d5ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:45a841dd-8642-a6d5-90bf-cb3942d1d5ed
msgctxt "hde51a01ag3c39g4b06g90bfg65ca8cf539a3"
msgid ""
"What, they're no longer worth avenging? You're a fickle creature, little "
"Sharran."
msgstr "뭐야, 그러니까 이제는 복수할 가치가 없단 말인가? 변덕이 심하구나, 샤의 졸개야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 479f9fdb-ce94-c888-0bd8-3896613e7f7e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.   Tag:
#.      - RANGER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:479f9fdb-ce94-c888-0bd8-3896613e7f7e
msgctxt "h81555ff7g3d00g4de6g86d8gde222fa55a36"
msgid ""
"You're not finished yet - the displacer can hear you, can't she? Kill her."
msgstr "아직 끝난 게 아니야 - 디스플레이서도 들을 수 있잖아, 안 그래? 죽이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 4857df02-f9ed-d265-3eef-6709bf5a005a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4857df02-f9ed-d265-3eef-6709bf5a005a
msgctxt "h00ae60a6g5c20g4593g9014geeffb6e9cb6b"
msgid "Displacer hearing is notoriously sharp. You must kill her too."
msgstr "디스플레이서의 청각은 날카롭기로 악명높지. 그것도 죽여야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 48f2b11b-91c0-ba6c-3b1d-d849940b05d4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Knows_InfernalEngineExists = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:48f2b11b-91c0-ba6c-3b1d-d849940b05d4
msgctxt "hf5589f6fg316eg46b6gb188g8a89b1207f80"
msgid ""
"A servant of Zariel, if I'm not mistaken. I'd know the stench of her "
"infernal machinery anywhere."
msgstr "내가 착각한 게 아니라면, 자리엘의 종복이겠군. 그녀의 지옥 기계 악취는 어디서든 알아챌 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 490848b1-621f-bbda-4e1b-027cf386da86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:490848b1-621f-bbda-4e1b-027cf386da86
msgctxt "h9f146e4eg8db1g48cbg9d29g4a8a5fb6b299"
msgid "He wants you dead."
msgstr "그는 네가 죽기를 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 4967e9ac-063e-f379-c9b3-beb4d073f605
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4967e9ac-063e-f379-c9b3-beb4d073f605
msgctxt "hf6b5552egd894g44bagb062g87912e9f10ac"
msgid ""
"Quite bloodthirsty, as lyrics go. Have you considered some instrumental "
"accompaniment?"
msgstr "노래 가사치고는 꽤 잔인한데. 악기를 곁들여 보는 건 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 49f69e7f-a10e-8535-fc87-4b35ba6c3202
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:49f69e7f-a10e-8535-fc87-4b35ba6c3202
msgctxt "he3487804g3161g48a2gba6ega0bc92e99cbe"
msgid "Your contract is a song?"
msgstr "네 계약이 노래라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 4a199e79-977f-9ed0-40c4-6b498cf3dc64
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4a199e79-977f-9ed0-40c4-6b498cf3dc64
msgctxt "hbd697e76g4b61g4f6dg83e3gf5c98d88e3d2"
msgid "<i>Run.</i>"
msgstr "<i>도망친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 4b256c6f-9a09-5b9f-5be5-2bf99880854e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_State_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4b256c6f-9a09-5b9f-5be5-2bf99880854e
msgctxt "hfb1a8e76gf920g4027g8adeg0031942b0d9e"
msgid "Wait - there's one last Dark Justiciar. I met him."
msgstr "잠깐 - 마지막 다크 저스티시어가 있었는데. 만나본 적 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Astarion
#. NodeID = 4b34da7b-2874-670a-b527-0e3a97633f64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_GotQuestFromRaphael = False
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(14) = True
#.   Tag:
#.      - REALLY_ASTARION(14) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4b34da7b-2874-670a-b527-0e3a97633f64
msgctxt "hac602a3dg9ac7g4a8bgb43dgdbd510272cb6"
msgid "Well? Tell him. We owe the devil nothing."
msgstr "그래? 말해주라고. 우린 악마에게 빚진 게 없으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 4de8fba3-ef6d-f590-e4e3-e285eee13d72
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:4de8fba3-ef6d-f590-e4e3-e285eee13d72
msgctxt "h67852cf5g97c6g44feg918eg2ade508e8738"
msgid ""
"Maybe that's true, maybe not - but I don't have to let you live in order to "
"find out."
msgstr "그럴 수도 있고, 아닐 수도 있지 - 근데 그게 맞는지 알아보라고 널 살려둘 이유는 없는 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 50b25c71-2d24-ce0f-269a-3611bf1061f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:50b25c71-2d24-ce0f-269a-3611bf1061f6
msgctxt "h0b349b96g5e89g4c8cgba75g9dbcfb6cf749"
msgid "That was awful - perhaps you should stick to killing."
msgstr "노래 정말 못 부르네. 죽이는 거나 계속해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 51d8c3be-cfc3-a33a-d46b-6ef69fd513fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:51d8c3be-cfc3-a33a-d46b-6ef69fd513fe
msgctxt "h30b7290egd4a6g4f04gbfa7ga0b93ad2cbfb"
msgid ""
"The devil has been stalking my companions - what dealings do you have with "
"him?"
msgstr "그 데빌이 내 동료들을 따라다니긴 했지. 무슨 사연이 있는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 54db124b-e7c1-bcf0-3ce8-2aead88b649d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:54db124b-e7c1-bcf0-3ce8-2aead88b649d
msgctxt "h0fb45c98g33fdg4fa7ga59ag39410bb4aa4b"
msgid "Nicely played, Raphael. Bastard."
msgstr "훌륭하군, 라파엘. 개자식 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Karlach
#. NodeID = 551c1289-11c4-42d1-a6d7-139baaa22ee7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(13) = True
#.   Tag:
#.      - REALLY_KARLACH(13) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:551c1289-11c4-42d1-a6d7-139baaa22ee7
msgctxt "hc7b92c97gd9bfg4152g933cg4e96bd186d07"
msgid "Damn. Now there's something I never thought I'd see. Brutal."
msgstr "젠장. 이런 걸 볼 거라 상상도 못 했어. 잔인하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 56393b75-3aaa-bb2c-0c7d-885364fb00c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:56393b75-3aaa-bb2c-0c7d-885364fb00c8
msgctxt "h4819f86fgf5cfg4666gb420g9a12de51be9a"
msgid "I'll burrow my fist into your chest if you don't stop mouthing off."
msgstr "그 입을 다물지 않으면 네 가슴팍을 내 주먹으로 파 내주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 57710e36-0de2-ea27-b2c0-203f4c00c50f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_PLANAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:57710e36-0de2-ea27-b2c0-203f4c00c50f
msgctxt "h976826d4gb537g4043gbbd7g2719a2072569"
msgid "I may stink of the surface, but it's not where I hail from."
msgstr "나에게서 지표면의 악취가 날 수도 있겠지만, 내 출신지 때문은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = 5bf5da7e-d26c-7697-b855-05c07a7c6a02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:5bf5da7e-d26c-7697-b855-05c07a7c6a02
msgctxt "h9f435b66g43bfg43e2ga0e7g7a801cf7aa13"
msgid "*Well, that explains where all the Dark Justiciars went.*"
msgstr "*음, 다크 저스티시어들이 다 어디로 갔는지 알 것 같군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Gale
#. NodeID = 5d782522-d816-a0fb-7c0e-4ee179bef2b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(16) = True
#.   Tag:
#.      - REALLY_GALE(16) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:5d782522-d816-a0fb-7c0e-4ee179bef2b6
msgctxt "h00c62c45g85dag4cb3gaa2egf0819934a73e"
msgid ""
"So he's the one who killed all the Dark Justiciars. Alone. Might not want to "
"get on his bad side."
msgstr "그래서 저놈이 다크 저스티시어를 다 죽인 놈이었나 보네. 혼자서 말이지. 적으로 삼고 싶지는 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Lae'zel
#. NodeID = 60fa81e2-af00-49e4-a610-a2e3a633138f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.   Tag:
#.      - REALLY_LAEZEL(11) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:60fa81e2-af00-49e4-a610-a2e3a633138f
msgctxt "h81c1aa38g8909g4040g85b0g79b6111beb29"
msgid ""
"An acceptable conclusion. But it is a shame I won't know the pleasure of "
"executing a wardevil."
msgstr "납득할 만한 결과로군. 하지만 워데빌을 죽이는 기쁨을 알지 못하게 된 건 유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 66089d8a-27a1-b03e-eb2a-c962900211ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:66089d8a-27a1-b03e-eb2a-c962900211ce
#, fuzzy
#| msgid ""
#| "But go on - spill some blood prove me wrong. If there truly is a justiciar, "
#| "the song will end and you will be vindicated."
msgctxt "h89e072b4g689cg48fcg84ecg1f25ac3a58f7"
msgid ""
"But go on - spill some blood, prove me wrong. If there truly is a Justiciar, "
"the song will end and you will be vindicated."
msgstr "하지만 좋아 - 가서 내가 틀렸다는 걸 입증해 보라고. 만약 정말 저스티시어가 있었다면, 노래는 끝날 거고 너도 입증한 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 689342d7-b0d6-b073-d996-4dc30c3242e8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:689342d7-b0d6-b073-d996-4dc30c3242e8
msgctxt "h5031e700g747cg4788gb817g7b522fe02662"
msgid "I'm not your errand boy, or your butcher."
msgstr "난 네 심부름꾼이 아니야, 네놈의 도살자도 아니고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 689342d7-b0d6-b073-d996-4dc30c3242e8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:689342d7-b0d6-b073-d996-4dc30c3242e8
msgctxt "h2cfc8f6fg8e4fg425cgadb0g1fd0293ca0c7"
msgid "I'm not your errand girl, or your butcher."
msgstr "난 네 심부름꾼이 아니야, 네놈의 도살자도 아니고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 689342d7-b0d6-b073-d996-4dc30c3242e8
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:689342d7-b0d6-b073-d996-4dc30c3242e8
msgctxt "h7fd982bege227g4819gbccbg963b3ad863b7"
msgid "I'm not your errand-runner, or your butcher."
msgstr "난 네 심부름꾼이 아니야, 네놈의 도살자도 아니고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 6a4cda48-9a7c-45f2-6def-e69b4e3f10d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:6a4cda48-9a7c-45f2-6def-e69b4e3f10d4
msgctxt "hbf340650ge1f3g4032g97cega71eccaaa24d"
msgid ""
"You give them too much credit. And show more spine than they did - at least "
"until I flayed them."
msgstr "지나치게 좋게 포장하는군. 놈들보다는 더 기개를 보이기도 하고 - 내가 똑같이 가죽을 생으로 벗겨놓은 후에도 그럴까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Astarion
#. NodeID = 6b1af1dd-e6c2-9a6c-887a-b75938348aa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:6b1af1dd-e6c2-9a6c-887a-b75938348aa0
msgctxt "ha8fe303ag04cdg43dcgbf29gef636b9d34a9"
msgid ""
"Because if he doesn't die, then Raphael won't tell me a damn thing about my "
"scars."
msgstr "쟤를 안 죽이면, 라파엘은 내 망할 흉터에 대해 말해주지 않을 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 6b47fb59-4ff1-65cf-c6af-4898e1316d0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:6b47fb59-4ff1-65cf-c6af-4898e1316d0b
msgctxt "h7a916b06g4b02g45cag9915g016eb87f096c"
msgid ""
"The merregons? They barely have a thought to share among themselves... but "
"they do have ears."
msgstr "메레곤이? 이놈들은 다 합쳐도 한 사람분의 지능도 안 되건만... 귀가 있긴 하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 6cf75157-d6fe-0eaa-4f66-3801b561a8ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:6cf75157-d6fe-0eaa-4f66-3801b561a8ad
msgctxt "hdda1b7dbg5edeg47c1ga9cbg6b2286bd8083"
msgid "I don't keep company with devils."
msgstr "난 데빌과 같이 다니는 걸 좋아하진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 6cfdc701-6d62-b2a6-f9c3-b22605102ac2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:6cfdc701-6d62-b2a6-f9c3-b22605102ac2
msgctxt "hf9273ef2g64b4g466eg8074g30c9248ced50"
msgid "Well, allow me to hop to it - I want to talk."
msgstr "그럼 깡총하고 뛰게 해 줘. 나는 대화를 하고 싶거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 6e06dd31-199c-b067-6af0-e592c5b6f147
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:6e06dd31-199c-b067-6af0-e592c5b6f147
msgctxt "h921defdfg4ba5g4309gbb24g7f2d446b6d70"
msgid ""
"This 'rabbit' has hunted prey larger than you. I suggest you choose your "
"next words wisely."
msgstr "이 '토끼'께선 너보다도 큰 먹잇감을 사냥해 봤어. 다음에 할 말을 신중하게 고르는 게 좋을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 71297daf-bfa8-a8be-96ce-f2f4ba49aec3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:71297daf-bfa8-a8be-96ce-f2f4ba49aec3
msgctxt "h21479e00gf853g4cfcg8cdfg0b8fbb31518f"
msgid ""
"<i>Spill all the blood sworn to the night. \n"
"Silence all prayers; smother each rite.</i>"
msgstr ""
"<i>밤에 충성하는 피를 전부 흘려라.\n"
"기도는 침묵시키고, 의례는 짓밟으라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 73c4ac26-7be1-65a5-951b-51332056d029
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_Knows_ContractClause = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:73c4ac26-7be1-65a5-951b-51332056d029
msgctxt "h6fe855bfgcaacg4537ga8dfgc9ae22556b1c"
msgid ""
"Either I fulfil the contract, die trying... or forfeit my freedom. If I "
"leave this place now, I'll become Raphael's slave."
msgstr "계약을 이행하거나, 시도하다 죽거나... 아니면 자유를 포기하는 수밖에. 내가 여길 떠난다면 라파엘의 노예가 되고 만다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 74545ea0-835e-08ad-96a6-890bc9c14258
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(12) = False
#. TagRule: (CLERIC_EVIL or PALADIN_EVIL) and !(CLERIC_SHAR and PALADIN_SHAR)
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:74545ea0-835e-08ad-96a6-890bc9c14258
msgctxt "hbf31336bgd8a2g4710g99bbg50efb79a4c55"
msgid ""
"Shar is not my goddess, but I can respect her. I ought to kill you for what "
"you have done to her temple."
msgstr "난 샤를 섬기지는 않지만, 존중하는 편이다. 네가 샤 사원에 저지른 짓 때문에라도 널 죽여야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 7599190c-e185-ecf6-cc4c-58827d6e9044
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:7599190c-e185-ecf6-cc4c-58827d6e9044
msgctxt "h1dcce9e7g7c82g4dd5g9e76g01ba8b074b12"
msgid ""
"Parchment can burn. Oral agreements aren't worth the tongues they're waggled "
"out upon. A song <i>lingers.</i>"
msgstr "양피지는 태울 수 있다. 말로 한 협의는 그 말을 한 혀 이상의 가치가 없지. 하지만 노래는 <i>잔존한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 77d73dc7-93f8-de94-8f08-1ecbe6c0cbfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:77d73dc7-93f8-de94-8f08-1ecbe6c0cbfc
msgctxt "h87e0f961gf874g4fe6g8c45g5f3ea27fb89b"
msgid "It's Raphael you want, not me."
msgstr "네가 원하는 건 라파엘이지, 내가 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Lae'zel
#. NodeID = 79cf0bec-4f1c-313c-b3c6-e6d951c37120
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:79cf0bec-4f1c-313c-b3c6-e6d951c37120
msgctxt "h93056094gaaa9g4f4ag9e67gecc4bc0a1f47"
msgid "Well. There is always next time."
msgstr "뭐, 다음에 기회가 또 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 79d55e22-c881-0af7-0c41-a9c0bc25b112
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:79d55e22-c881-0af7-0c41-a9c0bc25b112
msgctxt "h5f7de6f3gea8eg45bdgbf48gad15d4d3ff66"
msgid ""
"Asking why doesn't get me paid - hunting and killing does. Raphael mentioned "
"something about an aasimar. Meant nothing to me."
msgstr ""
"이유를 묻는다고 내게 좋을 건 없다. 사냥하고 죽여야지. 라파엘이 아시마르 이야기를 한 적이 있긴 해. 내게는 아무런 의미 없는 소리였다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 7d4e3697-5771-2287-1a06-220985675f5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = False
#.     - SHA_Orthon_Event_SearchPersuasionSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:7d4e3697-5771-2287-1a06-220985675f5c
msgctxt "hf7050083gd14eg44d4g99e8g60f40569a8a0"
msgid "All right, leave it to me."
msgstr "좋아, 내게 맡겨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 80166571-2c4e-4f19-ad3c-286b726b3edd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:80166571-2c4e-4f19-ad3c-286b726b3edd
msgctxt "h5b81a7e1g73c5g4180g9061g20b1114731b5"
msgid ""
"...There's something else, almost hidden by your fear-stink... cherries, "
"musk... and <i>sulphur</i>."
msgstr "...네 두려움의 냄새에 거의 가려진 다른 뭔가가 있구나... 체리와, 사향... 그리고 <i>유황</i> 냄새가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 845ed1a4-6431-5315-fd74-3654cee074c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:845ed1a4-6431-5315-fd74-3654cee074c5
msgctxt "h166f86f0g523ag47b6g990bge8334450fdf6"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 84fc80fb-f54f-c04a-ec1d-491d36f5f4f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:84fc80fb-f54f-c04a-ec1d-491d36f5f4f4
msgctxt "h87270b78gbd95g407fga068ge3dd613c9048"
msgid "Stupid rabbit. Running can't save you."
msgstr "멍청한 토끼 같으니. 넌 이미 죽은 목숨이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 85bd6f87-e67c-f4b9-5452-2a8487cc3f97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:85bd6f87-e67c-f4b9-5452-2a8487cc3f97
msgctxt "haffda2e3g36a7g4decgae2eg3f1983cdc60b"
msgid "Kill yourselves - back to the hells with you."
msgstr "서로 죽여라. 지옥으로 돌아가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 880fc1f1-c1ef-e122-9599-03f3ec280ddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:880fc1f1-c1ef-e122-9599-03f3ec280ddc
msgctxt "h837c2b36gad4ag4a88g8ec2g286a2deba107"
msgid ""
"The likes of you is frightened of a contract? I find that hard to swallow."
msgstr "너 정도 되는 자가 계약을 무서워한다고? 납득하기 어려운 일이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Wyll
#. NodeID = 886c7188-4cc5-4129-b95f-1d2043814e42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(15) = True
#.   Tag:
#.      - REALLY_WYLL(15) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:886c7188-4cc5-4129-b95f-1d2043814e42
msgctxt "h9adc12acg135fg4d2dg814dg1a527bf4e140"
msgid ""
"Balduran's bones, what a performance - you'd put the Five Flagons to shame!"
msgstr "발더란의 뼈여, 대단한 공연이야... 파이브 플라곤스조차 상대가 안 되겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 88cc4395-a67f-bf60-ae00-44d09dd4f3c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:88cc4395-a67f-bf60-ae00-44d09dd4f3c9
msgctxt "h61a394fbgeb3dg4980g80b9g310819fc51ed"
msgid "Wait - you know Raphael?"
msgstr "잠깐 - 라파엘을 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 8962799c-7a90-f7fe-cb47-6673e2a6e56e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:8962799c-7a90-f7fe-cb47-6673e2a6e56e
msgctxt "h41a6b595gbd64g4471ga184g1c89d00ab5eb"
msgid "There must be something you missed. Let me search this place for you."
msgstr "분명 네가 놓친 게 있을 거야. 내가 이 장소를 수색하게 해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 89fa0602-ae48-2f0b-b5a2-77d240f1b075
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:89fa0602-ae48-2f0b-b5a2-77d240f1b075
msgctxt "h9df09200g241bg4e78gac0cg58544c5287ef"
msgid "I don't talk to prey, I -"
msgstr "난 사냥감과 대화하지 않아, 난 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 8ba77428-4d7e-40d6-1adc-a2043745cc72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:8ba77428-4d7e-40d6-1adc-a2043745cc72
msgctxt "h6f3f8cfegac58g4770gb3cbgf9ea25afa6a4"
msgid "What do you know about infernal machinery?"
msgstr "지옥의 기계에 대해 아는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 8c6da3ba-ef12-ab2b-d85b-9bfcd52a3f74
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_TrespassLair_Event_ContractMentioned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:8c6da3ba-ef12-ab2b-d85b-9bfcd52a3f74
msgctxt "h6d3479f7g406eg4c31gbfdag1568dc0d4a38"
msgid ""
"You can't help. It's not just walls that keep me here. Not the traps, the "
"dark or the creatures it hides. Something stronger holds me - a contract."
msgstr "넌 나를 도울 수 없어. 나를 가두는 건 이곳의 벽도, 함정도, 어둠 속에 숨어있는 생물들도 아니야. 더 강력한 것, 계약이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 8d76a811-b199-65c8-c602-5c918f14a8c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:8d76a811-b199-65c8-c602-5c918f14a8c4
msgctxt "h73e1bed0g9be6g4bc0ga168g8ca2f158c799"
msgid "A pact made from song? Quite quaint for a devil, I must say."
msgstr "노래로 만든 계약? 데빌치곤 특이하다고 말할 수밖에 없겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 909436f2-0c99-911f-3341-0df708c70f94
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:909436f2-0c99-911f-3341-0df708c70f94
msgctxt "h416ff560gd615g4924g9604g230be4cd62f6"
msgid "Kill yourself, coward. Then you'll return to Avernus. You'll be free."
msgstr "스스로를 죽여, 겁쟁이 자식아. 그럼 넌 아베르누스로 돌아가고. 자유가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 90c491b4-25d5-52c7-b6ae-30f104bbdba5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:90c491b4-25d5-52c7-b6ae-30f104bbdba5
msgctxt "hc8050384gf1d8g4e0bg8b18gb7b15956cd69"
msgid ""
"You desecrated Shar's temple? You slew her children? I ought to kill you."
msgstr "네가 샤의 신전을 더럽혔나? 네가 그녀의 아이들을 죽였나? 너를 죽이고 말겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 921ca6ad-bf77-b35e-fc89-9f6e01400a1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:921ca6ad-bf77-b35e-fc89-9f6e01400a1a
msgctxt "h37424e8bg3274g4905gaa46g026b9fec483a"
msgid "Help me with my infernal engine, and I'll tell you."
msgstr "내 지옥 엔진 문제를 도와주면, 나도 말해주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 92777255-5dd4-cc41-e04a-6303e4b48b24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:92777255-5dd4-cc41-e04a-6303e4b48b24
msgctxt "hb35e31d1ge007g4aa9g9410g34896e7ba781"
msgid ""
"I did my part - I filled these halls with ghosts. But Raphael's playing some "
"other game - one that involves stiffing me."
msgstr ""
"난 내 맡은 일을 했어. 이 복도를 유령으로 가득 채웠지. 하지만 라파엘은 뭔가 다른 속셈이 있던 모양이다. 난 아직도 붙잡혀 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Karlach
#. NodeID = 93f06dd7-e3b3-08f6-c313-8eb59bc57d2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(13) = True
#.   Tag:
#.      - REALLY_KARLACH(13) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:93f06dd7-e3b3-08f6-c313-8eb59bc57d2b
msgctxt "h8633fbbegc6c0g4882g8ec9g5882db0c753a"
msgid ""
"We piss off a devil no matter what we do. Pick your poison - we'll handle "
"the fallout like we always do."
msgstr "우리가 뭘 하든 데빌 하나는 열받겠네. 차악이라도 골라, 뒷처리는 우리가 언제나처럼 감당할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 94922677-31f6-f9ba-c416-33fd22c560c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:94922677-31f6-f9ba-c416-33fd22c560c7
msgctxt "h15d769dag2fa9g4f51ga120g9e6383551765"
msgid "<i>Run.</i>"
msgstr "<i>도망친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 95616e2c-8672-e5b8-9aba-71d9a0b4a6bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:95616e2c-8672-e5b8-9aba-71d9a0b4a6bf
msgctxt "h3a764e94g43cfg4e2bg80c2ge7e400ba981f"
msgid "My apologies. Try as I might, the surface-stink just won't wash off."
msgstr "미안하군. 노력해봤지만 지상의 악취는 사라지지 않더라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 9a9f3ed3-f689-97ef-d292-6c3420b39c32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:9a9f3ed3-f689-97ef-d292-6c3420b39c32
msgctxt "hc2f01239g6649g4f36g9286g48fef13a51d7"
msgid ""
"If you're wrong about this, I'll claw my way out of Avernus and eat you "
"alive - contract be damned."
msgstr "만약 네놈이 틀렸다면, 아베르누스를 찢고 나온 다음 네놈을 산 채로 먹어주겠다. 계약 따위는 집어치우고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 9ad1f373-d146-b6fb-c075-7f65c8f01566
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_UNDERDARK
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:9ad1f373-d146-b6fb-c075-7f65c8f01566
msgctxt "h24c37fa4gdcc2g4bccg9b11g28189d3f48ae"
msgid ""
"But you're too fresh for this place, aren't you? A dark-dweller you may be, "
"but there's a definite whiff of the surface to you..."
msgstr "하지만 넌 이곳에서 너무 지나치게 싱싱하군, 그렇지 않나? 어둠의 주민일 수도 있겠지만, 지표면의 냄새도 분명하게 나는군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 9ad1f373-d146-b6fb-c075-7f65c8f01566
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: UNDERDARK and !REALLY_UNDERDARK
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:9ad1f373-d146-b6fb-c075-7f65c8f01566
msgctxt "h3df5ad03g8c51g47f0g956fg8ac8043626d4"
msgid ""
"But you're too fresh for this place, aren't you? You may look like a dark-"
"dweller, but there's a whiff of the surface to you..."
msgstr "하지만 이곳에 온지는 얼마 안된 모양이군? 어둠의 주민 같이 생겼지만, 네게는 지상의 불쾌한 냄새가 맴돌아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 9ad1f373-d146-b6fb-c075-7f65c8f01566
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:9ad1f373-d146-b6fb-c075-7f65c8f01566
msgctxt "h4fa8bf41g5c31g410ag94bcg5585bb153c45"
msgid ""
"But you're too fresh for this place, aren't you? There's a whiff of the "
"surface to you..."
msgstr "하지만 이곳에 온지는 얼마 안된 모양이군? 네게는 지상의 불쾌한 냄새가 맴돌아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = 9e7b57c8-19e5-2c3d-5914-0092d8ed41b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:9e7b57c8-19e5-2c3d-5914-0092d8ed41b4
msgctxt "h95741634g07dbg4416g8e1cgcf46cd6ce615"
msgid "You trying to burrow back home, little rabbit?"
msgstr "땅 파서 고향까지 내려가려는 거냐, 작은 토끼야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = 9ec7b6c3-6781-57a9-424f-d7a6424f7c2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - RANGER(1) = False
#.      - BARD(1) = False
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:9ec7b6c3-6781-57a9-424f-d7a6424f7c2e
msgctxt "h89ddc796gbae6g4a37g93e7g4cc5c820ca63"
msgid "Put that thing down. I'm here to talk."
msgstr "그거 내려놔. 난 대화하러 온 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Wyll
#. NodeID = a0c340b2-61de-3156-173d-75f922c8bfe9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(15) = True
#.   Tag:
#.      - REALLY_WYLL(15) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:a0c340b2-61de-3156-173d-75f922c8bfe9
msgctxt "h714bb099g7977g457egb614g92dad2d75ff4"
msgid ""
"Go on, tell the bastard. All the better for us if he keeps Raphael - busy."
msgstr "그 망할 자식 말해 줘버려. 저놈이 라파엘을 성가시게 하는 것이 우리에게 이득이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = a1ba596a-ab1f-f2d2-12be-df36cf12ec43
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = False
#.     - SHA_Orthon_Event_SearchPersuasionSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:a1ba596a-ab1f-f2d2-12be-df36cf12ec43
msgctxt "h5e93a4e3g42afg4509gb4abg590531636393"
msgid ""
"I spent a century roaming these halls - I spilled every drop of Dark "
"Justiciar blood that there was to spill. And you think <i>you </i>can do "
"better?"
msgstr ""
"난 이곳을 한 세기를 떠돌았다. 다크 저스티시어의 피를 마지막 한 방울까지 뽑아냈지. <i>네가</i> 더 잘할 수 있을 것 같아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = a6259aa7-bc8b-d9f9-57c2-14f34e8a40ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_TrespassLair_Event_ContractMentioned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:a6259aa7-bc8b-d9f9-57c2-14f34e8a40ec
msgctxt "hc33212b1gf59dg4498gb1efg3004be8149de"
msgid ""
"Hah! There's my word. I agreed to a contract - one that hasn't yet been "
"fulfilled."
msgstr "하! 난 약속이 있다. 계약에 동의했지. 아직도 완수하지 못한 계약 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = a660fa50-a887-e7c1-4eee-05d258881255
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:a660fa50-a887-e7c1-4eee-05d258881255
msgctxt "h5e86d0a3g1b3eg443cgb1b3g85890f3a1b3c"
msgid "I don't serve Zariel. And I'm going up - not down."
msgstr "난 자리엘을 섬기지 않아. 그리고 올라가려는 거야, 내려가는 게 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = a7729bdf-ead3-9d6b-e1bf-6539c8736535
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_RaphaelHiredOrthonToKillJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:a7729bdf-ead3-9d6b-e1bf-6539c8736535
msgctxt "ha0f0f687g6e5dg4131ga1bbgf6c222013380"
msgid ""
"<i>Wander Shar's halls; hungry to slay; \n"
"Leave no Justiciar alive to obey.</i>"
msgstr ""
"<i>샤의 복도를 떠돌아라, 피에 굶주린 채로.\n"
"충성하는 저스티시어는 남기지 마라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = a8ab1c81-6c74-8863-ac57-472c4442b621
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:a8ab1c81-6c74-8863-ac57-472c4442b621
msgctxt "hec386001g8852g4e3bg81ddg3d7621c8de77"
msgid "What's this? <i>Fresh entertainment.</i>"
msgstr "이게 뭐야? <i>싱싱한 놀잇감이군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = a97771d2-9fe3-a6a7-9089-a04784610353
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:a97771d2-9fe3-a6a7-9089-a04784610353
msgctxt "ha64f326aga877g4b06gaf15g0e03c4b9b986"
msgid "I'd never ally myself with such a fiend."
msgstr "난 절대 그런 마족과 손을 잡지 않는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Karlach
#. NodeID = ada27695-7a51-401e-a5bd-e14f2cf3411c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(13) = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_SpokeToOrthon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ada27695-7a51-401e-a5bd-e14f2cf3411c
msgctxt "h6c0b6bc3g3873g491cg8ad1g69c30b04ece3"
msgid ""
"Holy shit. An orthon. Powerful devils - I wouldn't get on their bad side "
"without a good reason."
msgstr "이런 젠장. 오르쏜이잖아. 강력한 데빌이지 - 합당한 이유가 없으면 놈들과 척을 지진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = afb6cea2-a5e8-06e5-cc5a-48e0759827ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:afb6cea2-a5e8-06e5-cc5a-48e0759827ce
msgctxt "h10952997gf130g4ddcg9974gbdbf79cb7d3d"
msgid "I don't want to make it pretty - I want to silence it."
msgstr "난 이 노래를 감미롭게 하고 싶은 게 아니라, 없애고 싶은 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = b14f3c6a-bff9-bb94-920e-30a3cf75fc49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = False
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b14f3c6a-bff9-bb94-920e-30a3cf75fc49
msgctxt "h19f3f894g4052g4251gbb0agbf5550cb2bca"
msgid "Show me this contract. Perhaps there's something you missed."
msgstr "계약을 보여줘. 아마 뭔가 네가 놓친 게 있을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = b2a850ca-9dbf-3ffa-1146-e11958b5c568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b2a850ca-9dbf-3ffa-1146-e11958b5c568
msgctxt "hc61a4535g0eacg495cga26dg4315beec1931"
msgid ""
"I would sniff you out in an instant. Prey like you always has a most "
"distinctive scent, it's like..."
msgstr "순식간에 냄새를 맡았을 거다. 너 같은 먹잇감은 항상 독특한 냄새를 풍기거든, 마치..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = b39df119-596f-47de-28ca-77f40e76ac98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b39df119-596f-47de-28ca-77f40e76ac98
msgctxt "h57863b1dg4770g4ce5g887egc6426d73cee3"
msgid ""
"If you won't speak, then you don't need to draw breath. Tell me what I want, "
"or I'll feed you to my pet over a tenday, and keep you alive to watch."
msgstr ""
"더 말할 게 없다면 숨 쉴 필요도 없겠지. 내가 원하는 말이 나오지 않는다면 널 내 애완동물에게 먹이고 그걸 산 채로 지켜보게 하겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = b6b0f970-15d1-bf0a-35ce-017fc41857bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b6b0f970-15d1-bf0a-35ce-017fc41857bb
msgctxt "he07fab36g0b05g4917g8490g48ea7ae4250c"
msgid "...Kill Nessa?"
msgstr "...네사를 죽이라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = b6b2f5b9-05d9-3dd9-bd68-3a0c760b06c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b6b2f5b9-05d9-3dd9-bd68-3a0c760b06c2
msgctxt "h4f6811fdg135bg4529gb648g060af3745d14"
msgid "Raphael wanted you to kill Dark Justiciars? Why?"
msgstr "라파엘이 네가 다크 저스티시어를 죽이길 원했다고? 어째서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = b77e18b9-7a85-926c-59d5-7fae66bbb142
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_SongInsightSuccess(1) = True
#.   Tag:
#.      - WARLOCK_FIEND(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b77e18b9-7a85-926c-59d5-7fae66bbb142
msgctxt "hba2e0b96gacb6g4563g9006g25c48450ed3d"
msgid "Fiendish Aid"
msgstr "마족의 도움"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = b77e18b9-7a85-926c-59d5-7fae66bbb142
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_SongInsightSuccess(1) = True
#.   Tag:
#.      - WARLOCK_FIEND(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b77e18b9-7a85-926c-59d5-7fae66bbb142
msgctxt "h1ce91f41ga6d6g4c34g933ag10bb273c08e7"
msgid ""
"<b><i>You</i> always hear the song, orthon. Kill yourself, be reborn in the "
"Hells, break the contract.</b>"
msgstr "<b><i>네가</i> 항상 노래를 듣고 있잖아. 스스로를 죽여, 지옥에서 다시 태어나, 계약을 깨뜨리라고.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = b888b794-431e-67dd-2ef1-b92c4268a914
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:b888b794-431e-67dd-2ef1-b92c4268a914
msgctxt "ha9e9585fg6883g48a0g9d74g49785dfcb53d"
msgid "<i>Do nothing.</i>"
msgstr "<i>아무것도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = ba9e69b5-d5b9-669f-0068-b66f8b60a046
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ba9e69b5-d5b9-669f-0068-b66f8b60a046
msgctxt "he10ce1beg4d0eg4e4ag9701gff5884865d68"
msgid "I'll have both, if I wish."
msgstr "내가 바란다면, 둘 다 가질 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = c059b701-0ac5-8259-99b0-aabfd37d4054
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c059b701-0ac5-8259-99b0-aabfd37d4054
msgctxt "hcdac3d89geac1g4762g9394g526748b1b831"
msgid ""
"Something tells me you aren't going anywhere at all. You must know it too, "
"reeking of fear as you do."
msgstr "무언가가 너는 아무 데도 가지 않을 거란 걸 말해주는구나. 너도 알고 있을 거야, 두려움의 냄새를 풍기고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = c0e46a42-bf2f-1c0b-ae1f-1f6fccc27c9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c0e46a42-bf2f-1c0b-ae1f-1f6fccc27c9c
msgctxt "h216e62ffg00c2g43dfgb297ga09e5fe28147"
msgid "No trap is inescapable, trust me."
msgstr "도망칠 수 없는 함정은 없지, 날 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = c11b51f7-ddd8-d6a0-cfc4-0c777e8a8e55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c11b51f7-ddd8-d6a0-cfc4-0c777e8a8e55
msgctxt "h482dd941g3600g4bc6g9621g56a8a8ce0bf2"
msgid "<i>I still hear it!</i>"
msgstr "<i>아직도 노래가 들려!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = c19d02a6-44bc-8a41-4afd-a4e4995637c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c19d02a6-44bc-8a41-4afd-a4e4995637c4
msgctxt "h26225665g750bg4b16gbddbgcfb06d3f6d90"
msgid ""
"Ought you? The Dark Justiciars all failed - and made the most "
"<i>interesting</i> noises as they died. Some even called out to other gods "
"for help..."
msgstr ""
"해볼 테냐? 다크 저스티시어들은 실패했지 - 그것들이 죽을 땐 아주 <i>재미있는</i> 비명을 내던데. 몇몇은 다른 신들에게 구해달라 "
"빌기도 했었지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = c415de21-c966-9fe3-4d1b-abbcc465832a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c415de21-c966-9fe3-4d1b-abbcc465832a
msgctxt "h697de021g2a3ag4388g8709g1b146fc6855d"
msgid "Oh, I intend to. The lyrics are clear - all who hear the song must die."
msgstr "아, 그럴 작정이다. 가사의 지시는 명백해. 노래를 들은 자는 모두 죽어야 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Shadowheart
#. NodeID = c4e980a1-cc90-403a-a1b8-4559e4380984
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(12) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c4e980a1-cc90-403a-a1b8-4559e4380984
msgctxt "h5b5a267egda4dg4894gac33g0a6a59ba9ac1"
msgid ""
"That silver tongue of yours is dangerous - bravo. I can't believe you "
"actually pulled that off..."
msgstr "네 경이로운 혓바닥은 위험한 수준이네 - 네가 정말 해냈다는 게 믿기지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = c596dfe5-00ce-a406-5bb6-d8165578d24a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c596dfe5-00ce-a406-5bb6-d8165578d24a
msgctxt "hcae2bd27g3bc5g42d7ga609g76b12b79641d"
msgid ""
"You've got the stench of the Hells about you - the stench of home. And a "
"whiff of the surface besides."
msgstr "너에게서 지옥의 악취가 나는구나... 고향의 악취가 나. 게다가 지표면의 냄새도 풍기는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = c5b7b95a-0194-4bae-0f25-617ec066b9c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c5b7b95a-0194-4bae-0f25-617ec066b9c1
msgctxt "h0cb58a52g3151g47e6gb663ged8eface5404"
msgid ""
"*Both far away and all too close, you feel your patron's grin. A job well "
"done.*"
msgstr "*멀고도 가까운 곳에서, 당신 후원자의 미소가 느껴집니다. 훌륭하게 해냈군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = c88f0d49-cf02-9f50-aa89-88a44345d9d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c88f0d49-cf02-9f50-aa89-88a44345d9d4
msgctxt "he33b7d2fgd22eg488cgad40gf17d7768fedf"
msgid "Don't insult me - I'd know if there was a Justiciar down there."
msgstr "나를 모욕하지 않는 게 좋을 거다 - 저 아래 저스티시어가 있다면 내가 모를 리 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = c93ba542-fbb9-c152-0209-c1f89d9a5d99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_State_SpokeToOrthon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:c93ba542-fbb9-c152-0209-c1f89d9a5d99
msgctxt "ha8241b22g8d5eg4e9cgba1dg28b747fe22e8"
msgid ""
"But you're too fresh for this place, aren't you? You've got the stench of "
"the Hells about you - the stench of home. And a whiff of the surface besides."
msgstr ""
"하지만 넌 이곳에서 너무 지나치게 싱싱하군, 그렇지 않나? 너에게서 지옥의 악취가 나는구나... 고향의 악취가 나. 게다가 지표면의 "
"냄새도 풍기는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Karlach
#. NodeID = cbb16a94-5acb-4cab-bc9e-d1a8e0b29209
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:cbb16a94-5acb-4cab-bc9e-d1a8e0b29209
msgctxt "h726d9dfdg0946g4584g961eg58a832a05248"
msgid ""
"I'm not one to placate a devil, but the last thing we need is an orthon for "
"an enemy. Fought one once, and my back has never been the same."
msgstr ""
"내가 데빌을 두둔하는 사람은 아니지만, 우리의 적들에게 필요한 마지막 방편은 오르쏜이야. 한번 싸운 적이 있는데, 몸이 예전 같진 "
"않더라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = ccb4a26b-87bc-f559-87d5-c4cfb5b9414e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ccb4a26b-87bc-f559-87d5-c4cfb5b9414e
msgctxt "h5481eebega70fg4dfag839fgc5eae2f385d4"
msgid ""
"I caught the scent of that bloated carcass already - he's no more alive than "
"the Dark Justiciars down here."
msgstr "그 불어 터진 시체의 냄새는 이미 맡았다 - 하지만 그놈은 이미 여기 다크 저스티시어들 만큼이나 죽어있는 상태지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Astarion
#. NodeID = cd330933-f479-b42b-7c4f-3dd1c6f56c26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(14) = True
#.   Tag:
#.      - REALLY_ASTARION(14) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:cd330933-f479-b42b-7c4f-3dd1c6f56c26
msgctxt "ha53352fdg26fdg4badg99f9gf6218bbd8aff"
msgid "Pretty tune for a contract that says 'kill all Justiciars'."
msgstr "'저스티시어를 죽여라' 라는 내용의 계약 치고는 예쁜 음색이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Gale
#. NodeID = cf72087a-c44d-472e-8de5-992a4421f733
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(16) = True
#.   Tag:
#.      - REALLY_GALE(16) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:cf72087a-c44d-472e-8de5-992a4421f733
msgctxt "h93613f3dg33c7g4d1bgbab3g781c43057bf4"
msgid ""
"I see the art of eloquence is alive and well. I'm awed, impressed, and a "
"little bit scared of you right now."
msgstr "웅변의 예술이 생생히 살아 숨 쉬네. 나는 지금 네가 경이롭고 감동적이며, 조금 겁나는 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = cfb8d6a2-2333-e365-2ed8-1472cd51faf6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:cfb8d6a2-2333-e365-2ed8-1472cd51faf6
msgctxt "h87797f8eg9028g4162gbd50g45fddc480af8"
msgid ""
"My dear hunter, isn't it obvious? You must kill yourself - then you'll be "
"free."
msgstr "친애하는 사냥꾼이여, 뻔하지 않나? 넌 스스로를 죽여야 해 - 그러면 자유가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = d1868f0d-3968-2fb1-abc5-def7afa6f2a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:d1868f0d-3968-2fb1-abc5-def7afa6f2a1
msgctxt "hb50e33e9ga0e5g4a64gb430gfb7c36281806"
msgid ""
"Diabolic deals in legend always have loopholes - we just need to find it."
msgstr "동화 속 악마의 거래엔 항상 허점이 있지 - 그걸 찾아내면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Karlach
#. NodeID = d22ad0ab-2ddb-5808-b6eb-9745285b558b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:d22ad0ab-2ddb-5808-b6eb-9745285b558b
msgctxt "h5f42e109gf4b2g4793gbc95g6f58bbbf0126"
msgid "What do you know of infernal machinery?"
msgstr "지옥의 기계들에 대해 아는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = d3a5687a-0a34-cd74-e6be-4a68603620ed
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:d3a5687a-0a34-cd74-e6be-4a68603620ed
msgctxt "hf91e8377g2843g41degac3bgf8cdbe75092f"
msgid ""
"Exactly. Kill yourself, complete the contract, and you'll be reborn in "
"Avernus. Free."
msgstr "바로 그거야. 스스로를 죽여, 계약을 완수하라고, 그럼 넌 아베르누스에서 다시 환생할 거야. 자유롭게 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = d6283e35-1450-9977-4b70-5e6b27424da2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:d6283e35-1450-9977-4b70-5e6b27424da2
msgctxt "h8e04c743gb042g4084g8ddege445f8e7bdd0"
msgid ""
"*Especially one with a built-in loophole. The song's last couplet is a "
"clause that's near impossible to fulfil.*"
msgstr "*특히나 근간부터 허점이 들어있는 계약이니 말이죠. 노래의 마지막 두 행은 사실상 이행하기가 불가능한 조항입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = d82184df-3c00-9d46-5cf8-f536de72ed6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:d82184df-3c00-9d46-5cf8-f536de72ed6a
msgctxt "h87cc952bgc35bg4652g9462g1a48d08cb285"
msgid ""
"I'm <i>never </i>going back to Avernus. But I'd be happy to send <i>you "
"</i>there."
msgstr "난 <i>절대로 </i>아베르누스로 돌아가지 않을 거야. 하지만 기꺼이 <i>너를 </i>그곳으로 돌려보내 주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Shadowheart
#. NodeID = d9756be9-b269-7b68-b91b-9e03a3d90299
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(12) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:d9756be9-b269-7b68-b91b-9e03a3d90299
msgctxt "h6f3af61ag969bg4b5ag8efbg8f87e2f5573b"
msgid ""
"So he's responsible for the carnage down here. All those Dark Justiciars... "
"slaughtered."
msgstr "저게 이곳에 재앙을 불러온 장본인이란 말이지. 그 많은 다크 저스티시어들이... 학살당한."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Astarion
#. NodeID = d9949134-bf7a-45cf-9f74-943379133987
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(14) = True
#. SetFlags:
#.   Object:
#.     - ORI_Astarion_Event_MetOrthon(14) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:d9949134-bf7a-45cf-9f74-943379133987
msgctxt "h96d4c780gd96bg4874g9cfag4143bb6d1e71"
msgid ""
"What are you doing? The devil told us to kill this thing, so let's stop "
"chatting and <i>kill it.</i>"
msgstr "뭐 하는 거야? 그 데빌은 저놈을 죽이라고 했잖아, 그러니 그만 떠들고 <i>죽이자고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = da1db322-1bf9-8401-9267-dc317ad375dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:da1db322-1bf9-8401-9267-dc317ad375dc
msgctxt "h63836b10g5bcdg44a5g8818gd77cf5b039d3"
msgid "<i>Raphael! </i>I can smell him all over you. Where is he?!"
msgstr "<i>라파엘! </i>너에게서 놈의 냄새가 진동하는군. 놈은 어디 있나?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = da1dc29a-64d5-d11a-05eb-5ad33f80b145
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:da1dc29a-64d5-d11a-05eb-5ad33f80b145
#, fuzzy
msgctxt "h8b3ae272gd5e7g4af8g9e81g115160bf244e"
msgid "You are star-touched that is true, but..."
msgstr "다른 별에서 온 자이긴 하군, 하지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = da4de57f-77d1-d7dc-c2b4-ebd600cf380c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:da4de57f-77d1-d7dc-c2b4-ebd600cf380c
msgctxt "hc27e1d55gde75g459eg884fg1e1fff089b9c"
msgid ""
"Wait! You might have missed something, and I'm uniquely good at tracking "
"things down."
msgstr "잠깐! 네가 뭔가 놓친 걸지도 몰라, 그리고 난 뭔가를 추적하는 데에는 유별난 능력이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = dadd3fdf-28a8-92c0-8c34-b8bdd5637f4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:dadd3fdf-28a8-92c0-8c34-b8bdd5637f4d
msgctxt "hcdb826f7g4708g4248g97bcg7385e3321566"
msgid "Maybe you'll find a crossbow bolt down your throat easier to manage."
msgstr "네 놈 목구멍에 박힐 쇠뇌 볼트 관리하는 일은 납득하기 쉬울 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = df08502e-3b19-c782-2196-ee84d9404dd4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:df08502e-3b19-c782-2196-ee84d9404dd4
msgctxt "hfed24856g7ec2g4e4bga7a0gd1f16835e9b6"
msgid "Kill yourself, coward. Then you'll return to Avernus. You'll be free."
msgstr "스스로를 죽여, 겁쟁이 자식아. 그럼 넌 아베르누스로 돌아가고. 자유가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = e027df1d-78b3-3b83-a287-73e5aa64d225
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e027df1d-78b3-3b83-a287-73e5aa64d225
msgctxt "h1f1458b7g2886g4ef9gb6aeg7e12d39ca444"
msgid ""
"Raphael is a devil like all your kind - he deals in tricks. You probably "
"missed a loophole in your contract."
msgstr "라파엘은 너와 같은 부류의 속임수를 쓰는 데빌이잖아. 아마 네가 놓친 계약의 허점이 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = e115d5e9-7c71-a070-bfe6-70b61f290cf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_TrespassLair_Event_ContractMentioned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e115d5e9-7c71-a070-bfe6-70b61f290cf3
msgctxt "hde77be45g7599g459egb458gf5af453ba102"
msgid "Besides, I told you already - I'm bound to this place."
msgstr "게다가, 이미 말했을 텐데 - 난 이곳에 묶여 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = e2df176c-abc3-81bf-f319-03c99029797f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e2df176c-abc3-81bf-f319-03c99029797f
msgctxt "hda1c5183gaed3g4422g80c3g4a13f1914a71"
msgid ""
"<i>Pathetic. </i>A dusk hag once claimed she dreamt of a future where I "
"spared her, but even her weaselling is no match for yours. This ends now."
msgstr ""
"<i>하찮군. </i> 내가 자기를 살려주는 미래를 꿈에서 보았다던 황혼 해그가 있었지. 하지만 그년의 변명도 너보다는 나았다. 이제 "
"끝장내주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = e469c1a4-7bc6-d424-b034-58c48a7257e7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_SongInsightSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e469c1a4-7bc6-d424-b034-58c48a7257e7
msgctxt "hdeeb8a93ga0f7g4afagbb1fg09efb74641a7"
msgid ""
"The lyrics are a trick. You've always had an audience - your followers. Get "
"rid of them."
msgstr "그 가사는 속임수야. 넌 언제나 청중을 데리고 있잖아 - 네 추종자들. 그들을 죽여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = e4974e60-d0f9-c6bb-0bd0-a1b0542a36a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4b5335a8-f967-9b03-758f-682fa7b3fcbf_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e4974e60-d0f9-c6bb-0bd0-a1b0542a36a6
msgctxt "h48634d50g9090g4c93gbfbcg6526f885543d"
msgid "I've said too much already."
msgstr "이미 말을 너무 많이 한 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = e49edfec-2040-9561-0f23-86fefa6fdaed
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e49edfec-2040-9561-0f23-86fefa6fdaed
msgctxt "hc202032cg267ag440dg8055gd98072313745"
msgid ""
"Exactly. Kill yourself, complete the contract, and you'll be reborn in "
"Avernus. Free."
msgstr "바로 그거야. 스스로를 죽여, 계약을 완수하라고, 그럼 넌 아베르누스에서 다시 환생할 거야. 자유롭게 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Lae'zel
#. NodeID = e50d1cb9-a43b-c872-1aa8-c32dfed49b81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.      - ORI_Shadowheart_RomancingShadowheart(11) = True
#.   Tag:
#.      - REALLY_LAEZEL(11) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e50d1cb9-a43b-c872-1aa8-c32dfed49b81
msgctxt "h805dc652g0abfg4c5dgb439gf1fa4f771c04"
msgid ""
"<i>He</i> killed Shar's faithful? Then he's due our congratulations before "
"we butcher him."
msgstr "<i>저놈이</i> 샤 신도들을 죽였단 말이지? 우리가 토막내기 전에 칭찬이라도 해 줘야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = e56b2463-838e-bf39-5cf2-7f7c8038a7c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4b5335a8-f967-9b03-758f-682fa7b3fcbf_PlayerOfferedHelp = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e56b2463-838e-bf39-5cf2-7f7c8038a7c4
msgctxt "h3fc23434ge1a7g4198gb118g24065ce5a204"
msgid "I've got nothing to spit out - not for you, anyway."
msgstr "난 말할 게 없어. 특히 너에게는 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = e7b76fc9-7357-c55d-d3e1-3795d8be8809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e7b76fc9-7357-c55d-d3e1-3795d8be8809
msgctxt "h8d3fa82dg1224g4d81g8055g652cfa8fd547"
msgid ""
"Go on then - I'll enjoy watching you fail. But try to run, and you <i>will </"
"i>regret it."
msgstr "그럼 가보라고 - 네놈의 실패를 만끽할 준비를 하고 있을 테니. 하지만 도망가려 한다면, <i>후회하게</i> 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = e8992a86-476d-03f6-f33d-34b518bed3c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e8992a86-476d-03f6-f33d-34b518bed3c6
msgctxt "ha39c10f4g7412g47ccgaf45g6f405b770a4b"
msgid ""
"It's been some time since I had an audience. Any who hear it tend to die."
msgstr "관객이 생긴 건 오랜만이군. 이 노래를 들은 놈은 곧 죽거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = e8eb4cf5-3736-8ddc-ceca-db4d5f32d346
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_MentionedBalthazar(1) = False
#.      - SHA_Necromancer_HasMet_AtTemple(1) = True
#.   Global:
#.      - SHA_Necromancer_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_MentionedBalthazar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e8eb4cf5-3736-8ddc-ceca-db4d5f32d346
msgctxt "h19b8e05fg1b0ag4553gb0d9g9712646c2d26"
msgid ""
"There's a necromancer called Balthazar elsewhere in the temple - perhaps "
"he's the one you need to kill."
msgstr "발타자르라는 사령술사가 이 신전 어딘가에 있어. 어쩌면 그놈도 네가 죽여야 할 사람일지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Shadowheart
#. NodeID = e970d7bb-5dbb-b80e-5a54-ca250c847200
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(12) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e970d7bb-5dbb-b80e-5a54-ca250c847200
msgctxt "ha951480bg5bf6g4d2ag8260gac9a925967c8"
msgid "Careful -  I'm not sure we want Raphael as an enemy."
msgstr "잘 생각해 - 정말 라파엘을 적으로 돌리는 게 맞는 일인지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = e99212f0-a615-925a-dc8b-619cab99fdcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_SongInsightSuccess(1) = True
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e99212f0-a615-925a-dc8b-619cab99fdcd
msgctxt "haf752caag5a84g4d7bgb479gb4331b6eebf1"
msgid ""
"*You feel a chuckle of crackling fire in the back of your mind - it seems "
"your patron enjoys a cleverly constructed contract.*"
msgstr ""
"*머릿속 한켠에서 이글거리는 불길과도 같은 웃음소리가 들려옵니다... 당신의 후원자는 교묘하게 만들어진 계약을 보니 즐거운 모양이군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = e99212f0-a615-925a-dc8b-619cab99fdcd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_SongInsightSuccess(1) = True
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e99212f0-a615-925a-dc8b-619cab99fdcd
msgctxt "hae9e3cf7gd62eg488fg9aefgca04c5e6a5b9"
msgid ""
"*There is an almost <i>admiring</i> thrum in the back of your mind. Your "
"patron seems to enjoy a well-crafted contract.*"
msgstr "*머릿속 한켠에서 거의 <i>감탄하는</i> 소리가 들려옵니다. 당신의 후원자는 잘 작성된 계약을 보니 즐거운 모양이군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = e99212f0-a615-925a-dc8b-619cab99fdcd
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Orthon_Event_SongInsightSuccess(1) = True
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:e99212f0-a615-925a-dc8b-619cab99fdcd
msgctxt "hd9622d5agefccg4a47g8a9cg0744681bb4fe"
msgid ""
"*A fey giggle sounds in the back of your mind - seems as though your patron "
"enjoys a tricksy contract.*"
msgstr "*머릿속 한켠에서 페이가 킥킥거리는 소리가 들려옵니다. 당신의 후원자는 골탕먹이는 계약을 보니 즐거운 모양이군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Astarion
#. NodeID = eaff893e-8708-4729-bb6d-41016f8a3ed5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_GotQuestFromRaphael = False
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(14) = True
#.   Tag:
#.      - REALLY_ASTARION(14) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:eaff893e-8708-4729-bb6d-41016f8a3ed5
msgctxt "h22e5e81fg632ag45ffg8762g073a47d6890e"
msgid ""
"That was incredible - I'm actually impressed! You have a wicked little mind."
msgstr "대단했어! 나 정말로 놀랐다고! 너 머리 진짜 잘 돌아가네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = eb198c9d-3696-9cd0-be6e-904eba33f2ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:eb198c9d-3696-9cd0-be6e-904eba33f2ed
msgctxt "h2565a744ga8c8g43e7g8e9cg8ec420a9d122"
msgid "If I was burrowing, you'd never find me."
msgstr "만약 내가 작정하고 왔다면, 찾지도 못했을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Wyll
#. NodeID = ec8fac7c-adf4-f540-23e5-47f0328f3249
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(15) = True
#.   Tag:
#.      - REALLY_WYLL(15) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ec8fac7c-adf4-f540-23e5-47f0328f3249
msgctxt "he60a5257gf150g4e9dgbfdfge1cdcfac160b"
msgid ""
"So this was the wardevil who slaughtered Shar's faithful. At Raphael's "
"urging, no less."
msgstr "그래서 이 워데빌이 샤의 신도들을 모두 학살한 거였군. 역시나, 라파엘의 독촉에 따라서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = ecfa66d8-81d5-1ce0-0e7b-cb8193bb46cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ecfa66d8-81d5-1ce0-0e7b-cb8193bb46cc
msgctxt "h71991699g0814g480ag8f8fg1235b1361bb2"
msgid ""
"Let's share our experiences about Raphael. Perhaps we can help each other."
msgstr "우리가 라파엘과 어떻게 엮이게 됐는지 공유해보지. 어쩌면 서로를 도울 수도 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Narrator
#. NodeID = edf810ec-565b-6bc9-e71d-9cc7865c9cc0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK_FIEND(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:edf810ec-565b-6bc9-e71d-9cc7865c9cc0
msgctxt "hfe8c66feg273eg4722gabcdg18c7e117a250"
msgid ""
"*You feel your patron's prickling flame at the back of your mind - and its "
"diabolic words on your tongue. It wants to <i>help</i>.*"
msgstr "*머릿속에서 당신 후원자의 화염이 따끔거리고, 악마의 말이 혀를 간지럽힙니다. <i>돕고</i> 싶어하는군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = ef2c8740-b38d-4774-8f05-654d569d78a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ef2c8740-b38d-4774-8f05-654d569d78a0
msgctxt "he32f5363gecebg4a61gb54egaaa265e06444"
msgid "I'll spare your life - that's ample reward."
msgstr "네 목숨을 살려주지. 충분한 대가야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = f00a4fd5-8913-7373-0ef4-fb4f18cee89c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:f00a4fd5-8913-7373-0ef4-fb4f18cee89c
msgctxt "hc86195efg429bg4672gb4d1gb6d3c07b0786"
msgid ""
"I may be trapped here, but I'm not without friends. If you break your word, "
"they'll hunt you down and make your final moments a symphony of agony."
msgstr "나는 여기 갇혀있을지 몰라도, 친구는 있다. 약속을 어긴다면 녀석들이 널 쫓아가 고통의 교향곡으로 네 마지막을 장식해 주겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = f014599d-befa-59b6-4605-71f3600230de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:f014599d-befa-59b6-4605-71f3600230de
msgctxt "h328e0545gb04fg497cg9d30gabe7a1323c8b"
msgid ""
"You wouldn't say that if you truly knew his mind. Just listen to the terms "
"he gave me."
msgstr "그놈의 생각을 정말로 알았다면 그런 말은 안 나올 거다. 놈이 준 계약 조건을 들어봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = f16db198-7791-40ec-5c39-fbeea66d46c6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Event_HostileAfterAmbushDialog = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:f16db198-7791-40ec-5c39-fbeea66d46c6
msgctxt "h61eeb370g194dg48eega745g915ef2e9e53b"
msgid ""
"I already have plenty of lackeys. All you have to offer me is your death."
msgstr "난 이미 졸개는 많다. 네가 줄 수 있는 건 죽음뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = f299dfc3-c0d2-f0b6-4a3e-67d1c46dd919
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:f299dfc3-c0d2-f0b6-4a3e-67d1c46dd919
msgctxt "h7af30524ge57bg4a1bga6a4g59277ec53042"
msgid "Do I look like I'm offering charity? What will you give me in return?"
msgstr "내가 자선 사업을 하는 것 같나? 대가로 뭘 줄거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = f50e4743-4ad7-e0ba-45af-cc832e3cdd01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = False
#. SetFlags:
#.   Local:
#.     - 4b5335a8-f967-9b03-758f-682fa7b3fcbf_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:f50e4743-4ad7-e0ba-45af-cc832e3cdd01
msgctxt "hc337a227g43dbg4769g9edfga967553d5ef1"
msgid "I've had dealings with that devil. Maybe we can help each other."
msgstr "나도 그 데빌과 엮여본 적이 있지. 우리가 서로를 도울 수 있을지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = f6204cd3-74ff-d128-e96c-2b3ebba7bc94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:f6204cd3-74ff-d128-e96c-2b3ebba7bc94
msgctxt "hac6f96a4g0496g4c7ag8affgf2ddf0ab8c27"
msgid "<i>Lies! </i>My nose would recognise him anywhere."
msgstr "<i>거짓말! </i>난 놈의 냄새를 어디서든 맡을 수 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = f64e6745-7622-b6ac-3aef-b2165471c8fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:f64e6745-7622-b6ac-3aef-b2165471c8fc
msgctxt "h6b9463d1g43d7g4c16g9666g3a6c82217bfc"
msgid "No. He is not the answer. He is not my prey."
msgstr "아니. 놈은 답이 아니다. 내 사냥감이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = fbfd7f2e-797b-1678-9d08-f529026a5651
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_End_Karlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:fbfd7f2e-797b-1678-9d08-f529026a5651
msgctxt "hf3e5fc03g1fc5g4b61gace6gdfe549bdce2e"
msgid "A new arrival, then. You burrowed too deep, little rabbit..."
msgstr "그럼, 새롭게 도착한 자여. 너무 깊게 내려온 거다, 작은 토끼야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = fd15aab8-c5ee-ba5e-8644-bb0c1c6a8249
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - SHA_Orthon_Event_SongInsightSuccess(1) = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:fd15aab8-c5ee-ba5e-8644-bb0c1c6a8249
msgctxt "hc436b342g5bfcg4ddcgaf02g3b4e69129dfe"
msgid ""
"Raphael's a sly lyricist - he tricked you. Your followers heard your song "
"and still live."
msgstr "라파엘은 음흉한 작사가지. 널 속인 거야. 네 부하들이 그 노래를 듣고도 아직 살아있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = fdb75741-6eb7-8ec6-a7b6-99f2ce58d804
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(13) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:fdb75741-6eb7-8ec6-a7b6-99f2ce58d804
msgctxt "h4006bb8ag67bfg4ec0gbd83ga5d442c919aa"
msgid ""
"You - tiefling. You've got the stench of the Hells about you - the stench of "
"home. And a whiff of the surface besides."
msgstr "거기 - 티플링. 네게선 지옥의 악취가 나는군 - 고향의 악취야. 거기다 지상의 불쾌한 냄새도 나는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Player
#. NodeID = ff493b4b-006c-b2a9-58bb-1789f257f1c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ff493b4b-006c-b2a9-58bb-1789f257f1c5
msgctxt "h8dfe9fd2g11d3g4deaga762g485ea5e1d0a1"
msgid "A deception. The Dark Lady would approve of them trying to sway you."
msgstr "속임수야. 어둠의 여신께서는 널 흔들리게 하려는 그 시도를 높게 사셨을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair
#. Speaker = Yurgir
#. NodeID = ff7634cc-daec-1abc-b2ea-4d035fa7c4f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Orthon_TrespassLair:ff7634cc-daec-1abc-b2ea-4d035fa7c4f8
msgctxt "h2ea9a10fga6b4g47c0gae3aga2909186e007"
msgid "I smell the depths below that is true, but..."
msgstr "그래, 깊은 지하의 냄새가 느껴지는군, 하지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonsLair_PAD_Plaque
#. Speaker = Narrator
#. NodeID = 0a9b7c96-42d8-a145-d084-660fc6feddd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_OrthonsLair_PAD_Plaque:0a9b7c96-42d8-a145-d084-660fc6feddd6
msgctxt "h6963b89eg874fg4b5ag941dgaf3913b0d0ec"
msgid "*Chambers of Penance.*"
msgstr "*참회의 방.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_OnEnter
#. Speaker = Player
#. NodeID = 16e5d747-5b69-8c30-2029-e1c6672899c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_OnEnter:16e5d747-5b69-8c30-2029-e1c6672899c4
msgctxt "h676016c9g06d4g404egb559g0afe18b6b700"
msgid "Dark and freezing. What's hidden down here?"
msgstr "어두운데다 냉골이라니. 여긴 뭐가 숨겨져 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_OnEnter
#. Speaker = Player
#. NodeID = b5b79159-4414-8fa2-93b1-54dc1fe39843
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or DRUID or RANGER or WOODELF
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_OnEnter:b5b79159-4414-8fa2-93b1-54dc1fe39843
msgctxt "ha94d1858gc468g446ag8b1eg7fc8bba84cf3"
msgid ""
"A century's dust on this bridge. But something just sent a chill up my spine."
msgstr "백 년은 족히 된 것 같은 다리로군. 근데 방금 뭔가가 내 뒷목을 서늘하게 만들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_OnEnter
#. Speaker = Player
#. NodeID = b5b79159-4414-8fa2-93b1-54dc1fe39843
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_UNDERDARK
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_OnEnter:b5b79159-4414-8fa2-93b1-54dc1fe39843
msgctxt "h9f4060ecg23ffg43dag9ed3g38cd9bd3b81e"
msgid "True darkness. I can almost relax."
msgstr "진정한 어둠이라. 맘 놓고 쉴 수도 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_Sarcophagus1Plaque
#. Speaker = Narrator
#. NodeID = 923ca3ef-7c67-4fe8-e6eb-7787e3649595
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_Sarcophagus1Plaque:923ca3ef-7c67-4fe8-e6eb-7787e3649595
msgctxt "h629c7089gd7edg4785g8dfeg8d98cfd6a25d"
msgid "*In darkness, beauty is equal and wealth unseen.*"
msgstr "*어둠 속에서, 아름다움은 평등하고 부는 보이지 않으니.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_Sarcophagus2Plaque
#. Speaker = Narrator
#. NodeID = 369def72-c922-6d78-c92c-7281581278e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PAD_Sarcophagus2Plaque:369def72-c922-6d78-c92c-7281581278e3
msgctxt "hebc4edb0g0b94g4d90gb32cga8dc3604b96e"
msgid "*The reign of night comes in a thousand falling leaves.*"
msgstr "*밤의 치세는 천 개의 떨어지는 잎들과 함께 찾아오리니.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Narrator
#. NodeID = 116e78d2-6b18-0c66-9ba9-ddf257547512
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_StatueUsed = False
#. SetFlags:
#.   Global:
#.     - SHA_Trials_State_StatueUsed = True
#.   Object:
#.     - SHA_Trials_State_FirstStatueUsed(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:116e78d2-6b18-0c66-9ba9-ddf257547512
msgctxt "h168c0c69gf488g43ccgbf95g9e89d2efc2c9"
msgid ""
"*The bowl contains an ancient, rust-coloured bloodstain. It forms a neat "
"disc, as if spilled calmly and willingly.*"
msgstr ""
"*그릇에는 아주 오래되어 갈변된 핏자국이 남아 있습니다. 핏자국은 마치 고요히, 자발적으로 방혈된 듯 깔끔한 형태로 남았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = 1f452226-72e4-ab94-0aac-f6960aac8d05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_Trials_State_TrialInProgress(0) = False
#.      - SHA_Trials_Event_TrialPassed(0) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - SHA_DarknessTrial_State_ShadowheartOffered = True
#.   Object:
#.     - ORI_Inclusion_End_ShadowHeart(1) = True
#.     - SHA_Trials_Event_StartTrial(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:1f452226-72e4-ab94-0aac-f6960aac8d05
msgctxt "h7a9de583g7795g4dcegb514ge3330770622c"
msgid "<i>Offer your blood in Shar's name.</i>"
msgstr "<i>샤의 이름으로 피를 바친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Narrator
#. NodeID = 22f23fc8-da65-c1b9-e223-add705fddff8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - SHA_Trials_Knows_LearnedAboutTrials = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:22f23fc8-da65-c1b9-e223-add705fddff8
msgctxt "he9f1a2edg18a9g4486gadd5g115666478476"
msgid ""
"*Another trial, to judge the mettle of Lady Shar's initiates. This one would "
"test their ability to navigate her sacred darkness.*"
msgstr ""
"*새로 입회한 샤 신도의 기개를 시험하기 위해 마련된 또다른 시험입니다. 이 시련에서는 신도가 샤의 성스러운 어둠을 헤아려 앞으로 "
"나아가는 능력을 가릴 터입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = 421bab56-eb6a-ffca-756b-46ae75d0fb32
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_DarknessTrial_State_ShadowheartOffered = True
#.     - ORI_Shadowheart_State_NightsongPoint_AgreedToTrials = True
#.   Object:
#.     - SHA_PathOfDarkness_Event_RefusedSH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:421bab56-eb6a-ffca-756b-46ae75d0fb32
msgctxt "ha0ca74d2g673dg4f51gaa26gc5ec4a5f47b9"
msgid "Go on."
msgstr "좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = 443ecc82-705e-bfa7-1d1c-36ead309f3b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp2(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:443ecc82-705e-bfa7-1d1c-36ead309f3b1
msgctxt "h97713988gd82ag48f2g9553g5fd8990c26cc"
msgid "I'll remember that, should you ever need something of me."
msgstr "이번에 내 부탁을 거절한 것 기억하겠어. 네가 나한테 뭔가를 원할 때 두고 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Shar
#. NodeID = 58df515a-0b71-4a33-9a27-f34e90c427d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:58df515a-0b71-4a33-9a27-f34e90c427d2
msgctxt "hb25c8911g2705g4bcdg8ee2g44055f14b7d1"
msgid "Navigate the darkness to feel my embrace."
msgstr "어둠을 헤치고 나의 품으로 들어오거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = 5e5dab62-14c6-76b7-f71f-f86091810c3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_DarknessTrial_State_ShadowheartOffered = False
#.      - SHA_Trials_Event_SHAskedtoDoTrial = True
#.   Local:
#.      - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialRequested = False
#.   Object:
#.      - SHA_PathOfDarkness_Event_RefusedSH(1) = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialDenied = True
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialRequested = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:5e5dab62-14c6-76b7-f71f-f86091810c3a
msgctxt "h0c340175g711cg4facgbaaegbd727500ff84"
msgid "Another trial. Allow me - please."
msgstr "또 다른 시련이야. 내가 하게 해줘. 부탁이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Narrator
#. NodeID = 869cb51e-ea0b-8030-2fcd-d63cebdd9ff6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_StatueUsed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:869cb51e-ea0b-8030-2fcd-d63cebdd9ff6
msgctxt "h84437c4ag08ccg49d8g93b1gaaadc2e9ce14"
msgid "*Another bowl, bearing the stains of an ancient blood offering.*"
msgstr "*아주 오래전, 피의 공물을 헌납했던 흔적이 남은 또다른 그릇입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = 9fcee7b3-13d0-81e1-11ec-82a6e87b6043
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialDenied = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_NightsongPoint_AgreedToTrials = True
#.   Local:
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialDenied = False
#.   Object:
#.     - SHA_PathOfDarkness_Event_RefusedSH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:9fcee7b3-13d0-81e1-11ec-82a6e87b6043
msgctxt "h9add0d48gf5bag46e4g8058gec1b28abbe8f"
msgid "Fine, have it your way."
msgstr "어쩔 수 없지. 네 마음대로 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = bdaa1707-9c0b-730d-b8fc-034de6e99f6c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_PathOfDarkness_Event_RefusedSH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:bdaa1707-9c0b-730d-b8fc-034de6e99f6c
msgctxt "h0be2e00ag22ebg4716g8a7bg48806714f7f9"
msgid "No, you're not doing this."
msgstr "아니, 이번엔 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Narrator
#. NodeID = bf7cc83c-7b06-c8b3-9155-a7628b888241
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - SHA_Trials_Knows_LearnedAboutTrials = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:bf7cc83c-7b06-c8b3-9155-a7628b888241
msgctxt "h2a82af3cge63ag4b55gb722g0b31bbda760a"
msgid ""
"*You recognise this as a trial, where initiates would prove themselves to "
"Lady Shar. This one would test their ability to navigate her sacred "
"darkness.*"
msgstr ""
"*당신은 이것이 일종의 시련임을 알아차립니다. 새로이 신도가 된 입회자들이 자신의 능력을 샤에게 증명하기 위한 장인 것입니다. 이 "
"시험에서는 신도가 샤의 성스러운 어둠을 헤치고 길을 찾는 능력을 가릴 터입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = e4cf34ca-05b1-400f-8249-1b5292e5d7bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:e4cf34ca-05b1-400f-8249-1b5292e5d7bd
msgctxt "h46c4c61bg918dg4c00g9a95g4e9787d165c0"
msgid "<i>Meet the statue's gaze.</i>"
msgstr "<i>석상과 눈을 맞춘다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = f17bc6cc-e2a6-4a45-b5db-742f0ab7a393
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_Trials_State_TrialInProgress(0) = False
#.      - SHA_Trials_Event_TrialPassed(0) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_End_ShadowHeart(1) = True
#.     - SHA_Trials_Event_StartTrial(0) = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:f17bc6cc-e2a6-4a45-b5db-742f0ab7a393
msgctxt "hbbc6d8a2g3cc7g4b14g88b3gfc139f8edb1b"
msgid "<i>Offer your blood in Shar's name.</i>"
msgstr "<i>샤의 이름으로 피를 바친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = f17bc6cc-e2a6-4a45-b5db-742f0ab7a393
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_Trials_State_TrialInProgress(0) = False
#.      - SHA_Trials_Event_TrialPassed(0) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_End_ShadowHeart(1) = True
#.     - SHA_Trials_Event_StartTrial(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:f17bc6cc-e2a6-4a45-b5db-742f0ab7a393
msgctxt "hbb23cb2age87cg4c34g92c0g27333da47b44"
msgid "<i>Spill some of your blood in the bowl.</i>"
msgstr "<i>그릇에 피를 약간 흘려넣는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = f1e43ec2-9459-9ffe-cbd0-5bccf07fc880
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_DarknessTrial_State_ShadowheartOffered = False
#.      - SHA_Trials_Event_SHAskedtoDoTrial = True
#.   Local:
#.      - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialRequested = False
#.   Object:
#.      - SHA_PathOfDarkness_Event_RefusedSH(1) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialDenied = True
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialRequested = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:f1e43ec2-9459-9ffe-cbd0-5bccf07fc880
msgctxt "hc3e0c6deg14e2g4139gaac6g4bc105697bf5"
msgid "We're wasting time. Please, just let me do this."
msgstr "시간이 낭비되고 있잖아. 부탁이니 그냥 내가 하게 해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = f81397f4-97ef-3a7c-5a59-0d0250071861
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp2(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:f81397f4-97ef-3a7c-5a59-0d0250071861
msgctxt "h786fd1a2g2d2ag478cg8b54g8e091f7bb8dd"
msgid "Seems your determined to put our mutual trust to the test. Pity."
msgstr "우리 사이에 쌓인 신뢰를 기어이 시험하려고 용을 쓰는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Player
#. NodeID = f8bffdb2-6db9-4400-8167-9b76278e07a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialDenied = False
#.   Object:
#.     - ORI_Inclusion_End_ShadowHeart(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:f8bffdb2-6db9-4400-8167-9b76278e07a1
msgctxt "h4907f156g7447g4a63g8d7eg042a641c7b7f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = ff89e7c3-7a6f-4be2-a898-b9eef3c79895
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_DarknessTrial_State_ShadowheartOffered = False
#.   Local:
#.      - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialRequested = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - SHA_Trials_Event_SHAskedtoDoTrial = True
#.     - SHA_Trials_Knows_LearnedAboutTrials = True
#.   Local:
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialDenied = True
#.     - 2444ce8c-3c13-e785-9df7-edfea6e75c33_TrialRequested = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_PathOfDarknessTrial:ff89e7c3-7a6f-4be2-a898-b9eef3c79895
msgctxt "hb46393cdg15c1g47bcg9634g161d2037f67d"
msgid "This is one of Lady Shar's trials. Allow me - please."
msgstr "이건 샤님의 시험 중 하나야. 내가 하게 해줘. 부탁이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 06dc2273-d98a-86f5-ee3f-8b2e740b508a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:06dc2273-d98a-86f5-ee3f-8b2e740b508a
msgctxt "h6f4b8a17g06beg4502gb1a3g4888a19ae5cb"
msgid ""
"What's not to like? We kill some horrible beastie, and I get what I want in "
"return. Everyone's happy."
msgstr "뭘 마다하겠어? 그 끔찍한 짐승 친구를 죽이고 대가로 원하는 걸 얻을 수 있다. 모두한테 좋은 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 09f9d10a-5c9e-9b34-37d1-2c6e5eb5eae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:09f9d10a-5c9e-9b34-37d1-2c6e5eb5eae7
msgctxt "h695cdefcg1848g4971g8619g5b601a45727a"
msgid "Getting warmer, warmer, <i>hot.</i>"
msgstr "그보다 따뜻하고, 덥고, <i>뜨거운</i> 존재이지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 0a135a8c-5acd-4975-0adf-7ab82bb0ea25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:0a135a8c-5acd-4975-0adf-7ab82bb0ea25
msgctxt "ha5ab1273ge153g4379gb33dgc8937e35ef2b"
msgid "Deal - we'll help you, if you help Astarion."
msgstr "거래 완료야. 네가 아스타리온을 도와주면, 우리도 너를 돕는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 0b384514-34ce-3f26-6f35-52fb8b773709
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Monitor_State_AttackedMonitor = True
#. SetFlags:
#.   Global:
#.     - GLO_Monitor_State_AttackedMonitor = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:0b384514-34ce-3f26-6f35-52fb8b773709
msgctxt "hc44e5c5cg2e2cg4481g827cg93e2a1b2bdbb"
msgid ""
"Given your appalling behaviour when we last met, I really shouldn't be "
"helping you. But I can't resist. You're just so <i>fascinating</i>."
msgstr ""
"저번에 만났을 때 당신이 제게 하셨던 그 무례한 행동 때문에 정말 도와드리고 싶지 않지만, 이거 거부할 수가 없군요. 당신은 정말 "
"<i>환상적이거든요</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 0bc8a0a8-2ca0-2ca6-37a9-f4d6f04ddb8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:0bc8a0a8-2ca0-2ca6-37a9-f4d6f04ddb8f
msgctxt "h83fe01a0g00e8g4665g90c3g91ffede7d572"
msgid "And it's all for a good cause - me."
msgstr "서로 좋자고 하는 거지, 물론 나를 위해서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 0e62fd92-a946-f735-9b21-6cf15b244ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:0e62fd92-a946-f735-9b21-6cf15b244ff4
msgctxt "h4774680cg030dg41edga037g52155f1879f1"
msgid ""
"Its actors dwell there still, mired in the languor of their long-tired "
"scenes."
msgstr "배우들도 여전히 그곳에 있지만, 그들은 이 길고 지루한 연극이 가져온 권태에 허우적대고 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 0f3cb250-7a04-839b-2c28-4c8fc79bebb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:0f3cb250-7a04-839b-2c28-4c8fc79bebb3
msgctxt "hcdd27a6fg2390g406eg885dgcdd1bfe2294b"
msgid "Then we have an understanding. I look forward to our next meeting."
msgstr "합의된 거 같군요. 다음에 만나길 고대하고 있겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 14ac869b-9457-04fb-24c2-36e6c2c35c0f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:14ac869b-9457-04fb-24c2-36e6c2c35c0f
msgctxt "he64e0987g32f7g4cfcg9faag8827d0a446d3"
msgid "A new grave they dug, which he himself fed."
msgstr "그들이 판 새로운 무덤에, 자신 스스로 삼켜진 셈이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 14ac869b-9457-04fb-24c2-36e6c2c35c0f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:14ac869b-9457-04fb-24c2-36e6c2c35c0f
msgctxt "hdc0c9e26g47b5g422bgad08gdfc90394b969"
msgid "A new grave they dug, which she herself fed."
msgstr "그들이 판 새로운 무덤에, 자신 스스로 삼켜진 셈이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 14ac869b-9457-04fb-24c2-36e6c2c35c0f
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:14ac869b-9457-04fb-24c2-36e6c2c35c0f
msgctxt "hf5a1c8bfgdc13g4dadg8beaga2688489eb90"
msgid "A new grave they dug, which they themselves fed."
msgstr "그들이 판 새로운 무덤에, 자신 스스로 삼켜진 셈이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 170614d6-d4d5-1784-aa56-bfea7b6067cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:170614d6-d4d5-1784-aa56-bfea7b6067cf
msgctxt "h2fefc877g4c28g40fegb6d2g808bda653858"
msgid ""
"Don't pout, spawn. Just destroy the beast and I'll happily reveal your "
"secrets instead of your skin."
msgstr "시무룩해 하지 마시죠. 그저 저 괴물만 죽여준다면, 기쁜 마음으로 당신의 옷 대신 비밀을 벗겨 드리죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 195e5fee-b39d-2e80-bdcb-0fe6b919797f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:195e5fee-b39d-2e80-bdcb-0fe6b919797f
msgctxt "h011cedc0g7210g4f85gbe37g68b5cd72f22a"
msgid "I always knew you're a coward at heart."
msgstr "네가 본심은 겁쟁이라는 걸 항상 알고 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 1af2b0a3-f738-423d-f2af-bbf46ec98a24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:1af2b0a3-f738-423d-f2af-bbf46ec98a24
msgctxt "h9ef68e0fg2607g4b82gaf9dgd30992c58b05"
msgid "Intrepid as ever."
msgstr "정말 겁도 없군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 20819b98-482a-d44f-4abd-10f56520904a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:20819b98-482a-d44f-4abd-10f56520904a
msgctxt "h287c7265gdcc8g4c7dg9aa0g523f0ca89f85"
msgid ""
"You're welcome to give it your best shot, of course. It's just that, well, "
"the man has proven to be more or less resilient to death."
msgstr "물론 그 일에 최선을 다하는 것도 좋죠. 뭐, 문제는 그 사람이 죽음에 어느 정도 내성이 있다는 것뿐입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 25816598-cd91-33d0-c42a-d210a9150de5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:25816598-cd91-33d0-c42a-d210a9150de5
msgctxt "h4b0b7d1cga06bg4927g9160g8ddb871836b0"
msgid "Spell. It. Out."
msgstr "자세히. 말. 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 25e5cfad-51e4-5c17-c538-0bebd3037483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:25e5cfad-51e4-5c17-c538-0bebd3037483
msgctxt "h6b8dcc9bgf100g493bgaaefg508f8c8b2625"
msgid "Let's not be so hasty - we might enjoy doing the devil's dirty work."
msgstr "그렇게 성급히 굴지 말자고, 데빌의 추잡한 뒤처리가 사실 재밌을 수도 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 272b0fad-23ce-8b09-1028-ca50137ae307
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_GotQuestFromRaphaelAtMasoleum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:272b0fad-23ce-8b09-1028-ca50137ae307
msgctxt "h1bdb13c9g911fg4e67g9da8g90d544c6744d"
msgid ""
"Speaking of my tale, I do have one thing to ask you. A proposal of sorts."
msgstr "내 얘기가 나와서 말인데, 부탁할 게 하나 있어. 제안 같은 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 2cc8dd42-460d-c5c6-e37d-c4e1dc9f7d0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:2cc8dd42-460d-c5c6-e37d-c4e1dc9f7d0c
msgctxt "h00b3ac7dge537g488bg90b1g374567417c8b"
msgid "Really? That is suspiciously fair."
msgstr "진심이야? 수상할 정도로 공평한 제안인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 2d673ba1-b7f3-5648-b7e0-ba92d4cbfc07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:2d673ba1-b7f3-5648-b7e0-ba92d4cbfc07
msgctxt "h5ea3ffbag6f1dg4654ga2feg107443d504f4"
msgid "Then we have an understanding. I look forward to our next meeting."
msgstr "합의된 거 같군요. 다음에 만나길 고대하고 있겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 2f57b3db-71cc-ad08-428b-001ba3788b9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:2f57b3db-71cc-ad08-428b-001ba3788b9d
msgctxt "hdef521d5g7665g417dgb995g038c4ed5981d"
msgid ""
"It would be pointless of me to try to bar you from entering, but I can... "
"set the scene as it were. Prepare you for your role."
msgstr "당신이 들어가는 것을 막는 건 무의미하지만, 제가... 당신이 대비할 수 있도록 저 앞이 어떤지 설명해 드릴 수는 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 30e0aae6-85f5-d913-c37c-816bdb9c405f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:30e0aae6-85f5-d913-c37c-816bdb9c405f
msgctxt "h9d01e957g4d85g4c39g9d27g8843295d2ec7"
msgid ""
"I - perhaps I should have, but I'm not used to asking for help and being met "
"with, well... help."
msgstr ""
"아- 어쩌면 미리 말했어야 했을지 모르지. 그렇지만 난 도와달라고 말해본 적이 별로 없어서 말이야. 도움을 받아본 적도... 그렇고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 31fb37ab-d057-8daf-57a7-3686534feed7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:31fb37ab-d057-8daf-57a7-3686534feed7
msgctxt "h642d1bdbg3b9fg49f9gbaceg33a0a8e364ed"
msgid "Chances are many more graves than yours alone will soon be fed."
msgstr "곧 당신 뿐만 아니라 훨씬 많은 이들을 위한 무덤이 주인을 찾을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 33c85ae7-6513-d60b-ec97-d967f834053c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:33c85ae7-6513-d60b-ec97-d967f834053c
msgctxt "h19b13b67g455fg4a6cgba8fgb22dd2451a9c"
msgid "How do you even know there's danger ahead?"
msgstr "어떻게 저 앞이 위험하다는 걸 알고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 34670dec-c52a-9431-c393-9997c3df3be0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:34670dec-c52a-9431-c393-9997c3df3be0
msgctxt "hf6bc18a2g23e0g4d5eg8142ga0e91563682f"
msgid ""
"I already did. If through the dark you go creeping and awake what is "
"sleeping..."
msgstr "이미 그렇게 하고 있습니다. 당신이 저 어둠 속으로 몰래 들어가서 그곳에 잠들어 있는 존재를 깨운다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 35b40c4c-37f3-7e53-ac99-1e5c4d1ed762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:35b40c4c-37f3-7e53-ac99-1e5c4d1ed762
msgctxt "h4e621017g33ebg4cf0gb84dg836883fb7ee4"
msgid "Sounds like an acquaintance I'd quite like to make actually."
msgstr "그렇게 말하니까 그 친구 한번 만나보고 싶어지는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 38ff9f61-59e2-da32-f8f0-c4a1a152e4a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:38ff9f61-59e2-da32-f8f0-c4a1a152e4a3
msgctxt "hcf7bd87bg475ag4605gaac2g6a240650d8ae"
msgid "Did you now? And what danger would that be?"
msgstr "이제 와서? 그래서 어떤 위험이 도사리고 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 39627b55-2e8f-5ce4-6074-ff2709a85f89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:39627b55-2e8f-5ce4-6074-ff2709a85f89
msgctxt "hf922be8agbc03g47cfg8518g4edc3fe9868d"
msgid ""
"It's something of great importance to your master. But is it a love letter, "
"a warning, or a deed of ownership? I can give you all the gory details."
msgstr ""
"당신의 주인에게 매우 중요한 거겠지요. 연애편지이려나? 아니면 경고문? 소유권 증서? 내가 그 피 냄새 가득한 내용을 알려 줄 순 "
"있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 39f10587-4b3f-b43e-478d-732d80a6354a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:39f10587-4b3f-b43e-478d-732d80a6354a
msgctxt "hc30c9f8dg8f8bg4a37g8909gbc14d2a55685"
msgid "Hardly, this is something else entirely."
msgstr "전혀, 그거랑 완전 다른 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 3a150b61-16de-c616-65ef-62bb1eab7b87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:3a150b61-16de-c616-65ef-62bb1eab7b87
msgctxt "h5b592ab0g051fg4901ga448g43f7d05dbeb0"
msgid "You're a terrible poet."
msgstr "시 한번 더럽게 못 쓰는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 3d367d2a-7c08-d8aa-3b9a-1b4d0ef1b4dc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_RaphaelRevealedScarsToParty = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:3d367d2a-7c08-d8aa-3b9a-1b4d0ef1b4dc
msgctxt "h76bc31bega3c1g4822g8980g5417c50424e9"
msgid ""
"Scars often tell such wonderful stories - I think yours might be truly "
"exquisite."
msgstr "흉터는 때때로 아주 놀라운 이야기를 말해주죠. 당신의 것은 아마 굉장히 매혹적일 거 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 409ba9b7-4b2c-85c7-744f-f39d350c7bfe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_Knows_RaphaelWillMeetAtCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:409ba9b7-4b2c-85c7-744f-f39d350c7bfe
msgctxt "hf0d9fa6fg5f73g4221g8935g3f19a4de7f93"
msgid ""
"You have it in you to author a thrilling finale, if... if you heed this "
"warning:"
msgstr "당신은 이 이야기를 멋진 피날레로 마무리하는 작가가 될 수도 있지. 만약... 만약 이 경고를 새겨 듣는다면 말이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 43e3f6ea-9b16-6ccc-77fb-cc332b3ee103
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:43e3f6ea-9b16-6ccc-77fb-cc332b3ee103
msgctxt "h802be010gf4cag4ea9ga2cage49cf41b8c34"
msgid ""
"If you, however, through the dark go creeping and awake what is sleeping..."
msgstr "하지만, 당신이 저 어둠 속으로 몰래 들어가서 그곳에 잠들어 있는 존재를 깨운다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 456733b7-b9bc-8e11-eadb-2bf2ba9efd77
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - 94726285-a32b-9d8e-579f-5aa051e986b7_Picture = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:456733b7-b9bc-8e11-eadb-2bf2ba9efd77
msgctxt "hc28d8f0dg50a8g4608g98b1g7f1a8fb4d9de"
msgid "Paint me a <i>clearer</i> picture than that."
msgstr "그것보다 더 <i>제대로</i> 설명해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 474132cb-bf9d-eb48-410a-95170334cc78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:474132cb-bf9d-eb48-410a-95170334cc78
msgctxt "h80e47f95gf163g467cga73bg373dbccc9439"
msgid ""
"I had an inkling that was one of your main motivators. Delighted to see it "
"confirmed."
msgstr "당신의 목적이 그것이란 걸 어렴풋이는 알고 있었습니다만, 확실히 알게 돼서 좋군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 4c2f5bf8-8888-6882-5caa-de29802cf37d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:4c2f5bf8-8888-6882-5caa-de29802cf37d
msgctxt "h204138c2gf137g487eg8742g41736cc952c1"
msgid "All I know is you have us doing odd jobs for a devil."
msgstr "확실한 건 이제 네 덕분에 데빌의 부탁을 들어줘야 한다는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 4cf75c4d-11fd-c825-6d0c-9b1575c7b6c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:4cf75c4d-11fd-c825-6d0c-9b1575c7b6c7
msgctxt "hb22d1a95g33dag44a1g9d4bgc191f9e44c3b"
msgid "Well. Now you know."
msgstr "뭐, 이제 너도 알게 됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 4edf3b38-b762-ba4d-a454-bc843d1a9ec7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:4edf3b38-b762-ba4d-a454-bc843d1a9ec7
msgctxt "hba767d86gb870g47c0gbbadg2a230f833272"
msgid ""
"Should it make its way out through the very doors you are about to brazenly "
"swing open, you'll have unleashed a pestilence upon this realm."
msgstr "당신이 뻔뻔하게 열어젖히려 하는 바로 그 문으로 그게 빠져나간다면 이 세상에 질병을 퍼트리게 되는 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 5081dfa8-a04c-7bb5-3f26-f7baf36ba016
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:5081dfa8-a04c-7bb5-3f26-f7baf36ba016
msgctxt "hd1088a0ag0c53g4415g8481gca7d5c6d6d01"
msgid ""
"My dear friend, I think you'll find I play my part in many a plot indeed."
msgstr "친애하는 친구여, 당신은 제가 정말 많은 이야기에서 등장한다는 것을 아시게 될 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 50bca01b-532c-aabb-094a-da7320d96489
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:50bca01b-532c-aabb-094a-da7320d96489
msgctxt "h77fa640ag467cg4743g9677g276dc954004f"
msgid "Let's just go. Standing here chatting gets us nowhere."
msgstr "그냥 넘어가자. 여기서 서서 얘기하는 건 아무 의미 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 551c895c-6d30-6fe4-48d2-20d9cbd6de82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:551c895c-6d30-6fe4-48d2-20d9cbd6de82
msgctxt "hc2b623f3g315cg4b11gbf9fgba0191a75f7d"
msgid "Cannot the same be said for you these days, True Soul?"
msgstr "요즘의 당신도 똑같지 않나요, 참된 영혼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 579b08c8-01ec-6d13-1285-a18f82a0e667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:579b08c8-01ec-6d13-1285-a18f82a0e667
msgctxt "hf966c10bg2cedg40beg90d7g43b4db15d0c8"
msgid "Except the beastie."
msgstr "짐승 친구한테는 안 좋은 일이겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 585d1c6e-f7e1-08c2-da10-a5febdae14a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:585d1c6e-f7e1-08c2-da10-a5febdae14a5
msgctxt "hdee9efd6g69fbg4bfegaadfg1c69eae7b878"
msgid "Until then - adieu."
msgstr "그때까지 - 아듀."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 5ce64fe9-23e1-c36f-7b53-36d2056da396
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:5ce64fe9-23e1-c36f-7b53-36d2056da396
msgctxt "hd4260cb9g5b04g41b2gb247ga8be461f358e"
msgid ""
"There is a stage down in the dark upon which a great drama has suspended "
"itself in time."
msgstr "저 어둠 아래에는, 위대한 연극이 펼쳐졌던 무대가 중단된 채 시간 속에 묻혀 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 5d81dfe4-789c-cdcb-8320-2fc1e8253632
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: OATHBREAKER
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:5d81dfe4-789c-cdcb-8320-2fc1e8253632
msgctxt "hcd88f84bgc2f7g41f2ga441g0b5a2b6a1265"
msgid ""
"I'd never think us allies, oathbreaker. Perish the thought - and the devil "
"too, if you'd be so kind."
msgstr "동맹이라 생각한 적 따위 없습니다. 맹세파기자여. 생각 정리 좀 하시죠. 가능하다면 데빌도 좀 정리해주시고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 5d81dfe4-789c-cdcb-8320-2fc1e8253632
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:5d81dfe4-789c-cdcb-8320-2fc1e8253632
msgctxt "h9387849agdf53g43f7g85f1g1c85a44cfb91"
msgid ""
"I'd never think us allies, paladin. Perish the thought - and the devil too, "
"if you'd be so kind."
msgstr "동맹이라 생각한 적 따위 없습니다. 팔라딘이여. 생각 정리 좀 하시죠. 가능하다면 데빌도 좀 정리해주시고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 60ba6d4d-5c62-69fc-7fc7-78d638016528
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:60ba6d4d-5c62-69fc-7fc7-78d638016528
msgctxt "hd007d362g4f0cg4644ga34cg3a5636b95595"
msgid ""
"I'm a mentor, not your mother. I don't wax poetic about boogeymen to keep "
"you on the straight and narrow."
msgstr "저는 멘토지 엄마가 아닙니다. 당신을 바르게 키우려고 귀신 얘기 따위를 꾸며내는 짓거리는 하지 않는다는 말이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 61024dcc-25de-86a8-c8a2-abceca2f4098
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:61024dcc-25de-86a8-c8a2-abceca2f4098
msgctxt "h92096a9fg5cc0g4db5g9c99g312434c8287e"
msgid "I'll consider my actions when I get there."
msgstr "저기서 어떻게 행동할지는 내가 정하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 62e1d3c0-83ad-923b-7746-980955df70eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:62e1d3c0-83ad-923b-7746-980955df70eb
msgctxt "hfa8145fcgfe9bg4ff1g914fg70aff4295ce8"
msgid "Anything else I need to know?"
msgstr "내가 더 알아야 할 게 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 663b9dc4-9ce0-ef6a-850a-00d1b0d90913
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:663b9dc4-9ce0-ef6a-850a-00d1b0d90913
msgctxt "hf4be3bc7gf296g4a22ga469g633bc36026e4"
msgid "Are you <i>afraid</i> of this creature, Raphael?"
msgstr "그 괴물이 <i>두렵나</i>, 라파엘?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 6f185a5a-4232-f745-bcfa-8ca91c7e04ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:6f185a5a-4232-f745-bcfa-8ca91c7e04ae
msgctxt "h3202ec57g3d7bg41bagb288g6efbf42e9687"
msgid "Why not let them see? Don't be shy."
msgstr "이분들에게 보여드리는 게 어떻습니까? 부끄러워하지 마시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 6fb7c98c-6a06-ce70-69b1-ab4f000b4364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:6fb7c98c-6a06-ce70-69b1-ab4f000b4364
msgctxt "h4ab9a3b7g212cg43bbg8dfagfe5d1f0a0f57"
msgid ""
"Do not underestimate this opponent. At best you will have the blink of an "
"eye to strike."
msgstr "이 괴물을 과소평가하지 마시오. 당신을 기껏해야 눈 한번 깜빡할 사이에 해치울 존재요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 72848478-2ccf-780a-a6c4-8f5c395b541e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:72848478-2ccf-780a-a6c4-8f5c395b541e
msgctxt "h825b16afg04fbg4b66g98fbgfb58ec1d0c7d"
msgid "What are we talking here? Lemure? Pit fiend? Orthon?"
msgstr "도대체 어떤 괴물을 말하는 거야. 레무어? 심연의 마족? 오르쏜? 이런 녀석들?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 757f97ee-4054-404e-ac45-395a6ee415ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:757f97ee-4054-404e-ac45-395a6ee415ae
msgctxt "h9321e72ag7520g450ag9fc6g6da6090da026"
msgid ""
"After all, if there is one rule I hold dear, it's that one must always give "
"the devil his due."
msgstr "어쨌든, 제가 중요하게 여기는 규칙이 있다면, 데빌에게는 언제나 제 값을 치러줘야 한다는 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 763b8555-6130-83d2-5bf0-d6d8924775a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:763b8555-6130-83d2-5bf0-d6d8924775a7
msgctxt "h78ba5aaag1566g4305g9cd3g745500077331"
msgid ""
"There is a creature that lurks in silence and shadow - a creature who, like "
"me, is very much of the infernal persuasion."
msgstr ""
"저 곳엔 어둠과 적막 속에 도사리고 있는 괴물이 있습니다. 그것은 지옥의 정수를 타고났다고 할 수 있죠. 마치 저 처럼 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 766b41ad-ad87-7b35-d76e-79575f10b9c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:766b41ad-ad87-7b35-d76e-79575f10b9c8
msgctxt "hc5e7b8ffgeabcg4f9fgb5c5g49e142e37361"
msgid "Which is not the only obstacle you're likely to face..."
msgstr "당신을 방해할 걸림돌은 그뿐만이 아니랍니다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 7a76e3cc-2e11-0029-1f99-3fa2880c2013
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:7a76e3cc-2e11-0029-1f99-3fa2880c2013
msgctxt "h114ab18ag1f7fg46efgb2f1g30f49cadc5d8"
msgid "A fairer deal than I expected."
msgstr "생각보다 공평한 제안인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 7ebb08ef-400a-07ca-e132-5153b77eb0f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:7ebb08ef-400a-07ca-e132-5153b77eb0f3
msgctxt "h480729edga574g4b2eg8d4fgd29ee5ea1509"
msgid ""
"Before you go - what can you tell me about the Infernal scars on my back?"
msgstr "가기 전에 - 내 등에 있는 빌어먹을 흉터가 뭔지 말해줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 80664315-a20b-7992-4ead-446a903dcff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:80664315-a20b-7992-4ead-446a903dcff4
msgctxt "h1b82ab30gb8fcg48abgab06gb5a01954f13f"
msgid "What do you think, Astarion?"
msgstr "어떻게 생각해, 아스타리온?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 8108e01b-e9ca-5ca6-ec12-9a8555d8b0e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:8108e01b-e9ca-5ca6-ec12-9a8555d8b0e4
msgctxt "hbf810d4fg6b85g41e8gb817g18bf7bf39f4c"
msgid "Enough of your jibber-jabber. Begone."
msgstr "쓸데없는 소리는 그만해. 꺼져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 8383421e-7a28-0898-fdef-cd92c6929c21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:8383421e-7a28-0898-fdef-cd92c6929c21
msgctxt "hb09f194egd35eg4401g8322g0ffae2385db7"
msgid ""
"And I will - once the beast that lurks below is vanquished, and sent back to "
"the Hells."
msgstr "물론 이 땅 아래에 숨어있는 짐승이 패배해서 지옥으로 되돌아가고 나서 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 886d7cc5-3136-2f84-516d-3b281ae9c15e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:886d7cc5-3136-2f84-516d-3b281ae9c15e
msgctxt "h7d41f9f6g6b91g4c1egb09bg5c3b6078dbe7"
msgid ""
"I've grown quite fond of you, you know - in my way. I thought it only fair "
"to warn you about the dangers ahead."
msgstr ""
"제 나름대로 당신에게 꽤 정이 들어버려서 말이죠. 그래서 저 앞에 도사리고 있는 위험에 대해 경고해드리는 게 옳다고 생각되는군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 893edf9f-31e8-153f-7758-3f36a858951c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:893edf9f-31e8-153f-7758-3f36a858951c
msgctxt "hebd1296eg8823g4c21ga1a8g9ea1a353e3aa"
msgid "Gods damn it."
msgstr "아... 젠장할."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Karlach
#. NodeID = 8a2474b7-57e2-87a4-b173-fa040dfec8ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:8a2474b7-57e2-87a4-b173-fa040dfec8ed
msgctxt "hea98ff90g3112g4c1eg97c2gaabad8a8b266"
msgid "What are we talking here? Lemure? Pit fiend? Orthon?"
msgstr "도대체 어떤 괴물을 말하는 거야. 레무어? 심연의 마족? 오르쏜? 이런 녀석들?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 8a986849-7c1d-4680-9b30-a0da6ef0de8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:8a986849-7c1d-4680-9b30-a0da6ef0de8c
msgctxt "hc56ed5a6g1e59g4e99gb810gc4b2ff47f69e"
msgid "Believe me, I am not telling you half of what I know."
msgstr "절 믿으시죠. 전 아는 것의 반만 말하지 않았습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 8c283d12-4b26-d02e-ab87-9898f49bd612
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:8c283d12-4b26-d02e-ab87-9898f49bd612
msgctxt "hec0c2bd8g1c76g401dg8927g6ce0e3b41681"
msgid ""
"This creature and I go back a long way. I admit it would be in my best "
"interest as well should it remain trapped in the dark, or misplace its head "
"perhaps."
msgstr ""
"이 괴물과 저는 인연이 깊죠. 그것이 계속 어둠 속에 파묻히게 두거나 목이 날아가 여기저기 굴러다닌다면 정말 즐거울 것 같긴 하군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 8e0c51ae-f206-4967-206f-e3f58b074559
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:8e0c51ae-f206-4967-206f-e3f58b074559
msgctxt "h135392c2g8cd2g4065ga1d9gca64d080275b"
msgid "A warning, no less. Don't tell me you're worried about me."
msgstr "이런, 경고라니. 날 걱정해주는 건 아니지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 94e28cc5-d38f-d1b8-274c-505dcfb5762f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:94e28cc5-d38f-d1b8-274c-505dcfb5762f
msgctxt "hef41fab6g38aag4d22gaa38gfa723b431600"
msgid "You wound me, spawn. I always deal fairly."
msgstr "저에게 상처를 주는군요. 스폰. 전 언제나 공평한 제안을 하는걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 96a15a96-4ffb-8db2-ddb0-b931ef889864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:96a15a96-4ffb-8db2-ddb0-b931ef889864
msgctxt "ha1d75f37g7effg4fd7g84ffg0e95e1688d65"
msgid ""
"Cazador worked on it from dusk until dawn, all with an ancient blade he "
"called his 'needle'. Cutting and tearing, starting over if I screamed or "
"winced too much."
msgstr ""
"카사도어가 해 질 녘부터 동틀 때까지 '바늘'이라고 하는 고대 단검으로 새겨넣었지. 비명을 지르거나 너무 움찔거리면 처음부터 또 살을 "
"자르고 찢었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 96e2fc04-7a35-a431-21e4-8a092840f0e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:96e2fc04-7a35-a431-21e4-8a092840f0e7
msgctxt "he5e98e02g2b07g438ag9727g90377c5c7bf5"
msgid ""
"By all means, stray. Explore. Hunt. Just don't indulge in the illusion that "
"you're the greater hunter."
msgstr "마음껏 여기저기 돌아다니고, 탐험하고, 사냥하시죠. 다만 당신이 위대한 사냥꾼이라는 환상 따위에는 빠지지 마시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 98cae62f-0e96-da06-7805-4d2740824525
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 94726285-a32b-9d8e-579f-5aa051e986b7_RaphaelRemovedClothing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:98cae62f-0e96-da06-7805-4d2740824525
msgctxt "h84312ecag2bdcg4730ga178g1e77c5909068"
msgid ""
"You haven't told them? And you've kept your clothes on this whole time? How "
"unlike you."
msgstr "말 안 해 줬군요? 여행하는 내내 옷도 계속 입고 있었고? 참 당신답지 않군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 9a3b162f-805f-23fa-cf8a-8fef21f5127a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9a3b162f-805f-23fa-cf8a-8fef21f5127a
msgctxt "h0901ac80g8fbfg4c18g87fcg0a22c728d479"
msgid ""
"A proposal? If you're hoping to taste my blood, little vampling, think "
"again. It burns hotter than Wyvern Whiskey."
msgstr ""
"제안이라? 만약 제 피를 마시고 싶은 거라면, 어리석은 뱀플링이여, 생각을 바꾸시죠. 그랬다간 와이번 위스키보다 더 뜨겁게 타오를 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 9a48542e-6086-e3cd-cffe-8b7cf957c73a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9a48542e-6086-e3cd-cffe-8b7cf957c73a
msgctxt "hf2f7f09bg0c0bg4eb3ga76eg0ee4a25a5f63"
msgid ""
"This is no night you can sleepwalk through, somnambulist, you must be wide, "
"wide awake to survive."
msgstr ""
"이 밤은 몽유병 걸린 사람 마냥 졸면서 걸어 다닐 수 있는 밤 정도가 아닙니다, 살아남으려면 아주 말똥 말짱하게 깨어 있어야 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 9b1b9799-930f-5767-49f9-672717b14333
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9b1b9799-930f-5767-49f9-672717b14333
msgctxt "h05322101gc879g49ebg93bfg542d9daefc0a"
msgid "It was a rough night."
msgstr "힘든 밤이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = 9c9810dc-dd6b-071b-e3c1-c693965b4a23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9c9810dc-dd6b-071b-e3c1-c693965b4a23
msgctxt "hb20104begea29g440cg82b7g41e73907f92f"
msgid "Merely protecting my assets."
msgstr "제게 넘어올 자산을 지켜야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = 9cc9f471-41ae-e761-d2e8-606400a88f0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9cc9f471-41ae-e761-d2e8-606400a88f0a
msgctxt "h2806ce7cga344g48b6g8eb0g5b84608f3ee5"
msgid ""
"My old - well, a long time ago someone carved some runes into my back. I'd "
"rather like to know what they say."
msgstr "내 오랜 - 아니, 아주 오래전에, 누군가 내 등에 룬 문자를 새겨놨어. 그 문자들이 무얼 뜻하는지 알고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 9ea2f2fb-e91d-4b15-761d-324b6492e6dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9ea2f2fb-e91d-4b15-761d-324b6492e6dd
msgctxt "h664ca6dfg640cg445bg9841g4901a627ea04"
msgid "Gods... the carving must have been excruciating."
msgstr "맙소사... 그거 새기는데 완전 고문이었겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 9ec414a1-3800-de40-485e-aadda5dd8b62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9ec414a1-3800-de40-485e-aadda5dd8b62
msgctxt "h96203b97g7b69g4a68ga75cg36598e3106ba"
msgid "Fair enough."
msgstr "나쁘지 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = 9f74f197-04d8-da32-a852-5b2ed735c5b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:9f74f197-04d8-da32-a852-5b2ed735c5b6
msgctxt "h9f47d238g8734g49c3g9d2ag3ec89bc1a0cb"
msgid "We're not doing your dirty work, Raphael."
msgstr "우린 네 더러운 부탁은 받지 않아. 라파엘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = a2787a06-fbed-4b34-add9-73e409c87363
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:a2787a06-fbed-4b34-add9-73e409c87363
msgctxt "hee8d7fe6gb893g4f8cg8d38g2846685709b3"
msgid "Very well."
msgstr "좋습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = a395cbf9-773e-b7ef-8c6a-cf26a12b3ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:a395cbf9-773e-b7ef-8c6a-cf26a12b3ae1
msgctxt "h6dbf812cg1258g4e27g9831gb910059984be"
msgid "Although I should probably get dressed first..."
msgstr "일단 옷을 먼저 입어야 하겠지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = a412d360-f3df-25cc-ef1f-db0f3d7e955b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:a412d360-f3df-25cc-ef1f-db0f3d7e955b
msgctxt "h755c31e5gcb54g4776g93e0g5fab5af4ec8b"
msgid ""
"Through the dark he went creeping,\n"
"And awoke what was sleeping..."
msgstr ""
"그자는 어둠 속을 기어들어가,\n"
"잠들어 있던 존재를 깨웠으니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = a412d360-f3df-25cc-ef1f-db0f3d7e955b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:a412d360-f3df-25cc-ef1f-db0f3d7e955b
msgctxt "hff0f944cg1115g4bd9gb2eage2cdd3f58b50"
msgid ""
"Through the dark she went creeping,\n"
"And awoke what was sleeping..."
msgstr ""
"그자는 어둠 속을 기어들어가,\n"
"잠들어 있던 존재를 깨웠으니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = a412d360-f3df-25cc-ef1f-db0f3d7e955b
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:a412d360-f3df-25cc-ef1f-db0f3d7e955b
msgctxt "h3e67739fg830ag4067g9702ge20fc639226b"
msgid ""
"Through the dark they went creeping,\n"
"And awoke what was sleeping..."
msgstr ""
"그자는 어둠 속을 기어들어가,\n"
"잠들어 있던 존재를 깨웠으니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = a42ce9c3-9f50-5c18-0172-b53e85d6d7ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:a42ce9c3-9f50-5c18-0172-b53e85d6d7ac
msgctxt "h81d76330g9e52g4997gbc86gc398e5b23c8e"
msgid "Ah, greed. My favourite virtue."
msgstr "아, 탐욕. 제가 가장 좋아하는 덕목이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = a6cf02c8-8365-a747-98fa-fda30da5c32a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:a6cf02c8-8365-a747-98fa-fda30da5c32a
msgctxt "hdd0ff41ag2f2cg45adg84c9gc932cd940722"
msgid "How long have you been standing around practicing that little recital?"
msgstr "얼마나 오랫동안 그 짧은 대사를 연습하면서 여기에 서 있었던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = ac0de39f-dc08-cabc-65ac-c5bdf53c15c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:ac0de39f-dc08-cabc-65ac-c5bdf53c15c4
msgctxt "h806ed58egb409g4761g878bga514b7aaa722"
msgid ""
"Scars often tell such wonderful stories - I think yours might be truly "
"exquisite."
msgstr "흉터는 때때로 아주 놀라운 이야기를 말해주죠. 당신의 것은 아마 굉장히 매혹적일 거 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = ae6b8e52-2f84-7145-4b23-13d24e9000bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:ae6b8e52-2f84-7145-4b23-13d24e9000bd
msgctxt "hd6e9175ag6794g43fdga2c1g87f7b51bf336"
msgid "I'll deal with this menace, but do not think us allies, fiend."
msgstr "이 일을 처리하지. 그렇다고 우리가 동맹이라는 건 아니다. 이 마족아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = b07a67b9-ed36-d2d6-fcc4-4338d90f3668
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:b07a67b9-ed36-d2d6-fcc4-4338d90f3668
msgctxt "h1fa9cedfgf503g490cg93d2g3f9e7f18429c"
msgid ""
"Strike first. Strike true. Defy the odds, for they are distinctly in its "
"favour. That much I owe the bastard to concede."
msgstr ""
"먼저 공격하고, 진심으로 공격하시오. 승산을 따지지 마시오. 승산은 확실히 저쪽에 있으니까. 승산이 저 빌어먹을 괴물한테 있다는 걸 "
"인정하지 않을 수가 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = b225e3e1-0e52-cbff-b01e-07989fb68e76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:b225e3e1-0e52-cbff-b01e-07989fb68e76
msgctxt "h2b56d200gb1e9g47cagb125g481cb511dc85"
msgid ""
"Long ago, some Infernal runes were cut into my back. I'd rather like to know "
"what they say."
msgstr "오래전에 내 등에 지옥의 룬이 새겨졌어. 이제라도 이게 무슨 의미인지 알고 싶거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = b3e0311a-60eb-06fd-d17a-cf59d3068263
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:b3e0311a-60eb-06fd-d17a-cf59d3068263
msgctxt "he3e89dcag5369g4815ga12cgd3dcf18847a9"
msgid ""
"All right, a different question - can you tell me what the Infernal scars on "
"my back mean?"
msgstr "좋아, 그럼 다른 질문 - 내 등에 있는 빌어먹을 흉터가 어떤 의미인지 말해줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = b8c1444c-da83-89b7-833e-aa0abe2e414a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_State_PartySawScars = False
#.      - ORI_Astarion_State_RaphaelRevealedScarsToParty = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:b8c1444c-da83-89b7-833e-aa0abe2e414a
msgctxt "hca0758d0gc4f9g4c5ag8e4bg8bb73e12af6f"
msgid "What are you talking about, Astarion? What scars?"
msgstr "무슨 소리 하는 거야 아스타리온? 무슨 흉터?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = c0937aa1-75fc-3b50-1203-bfa2cdf66db1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c0937aa1-75fc-3b50-1203-bfa2cdf66db1
msgctxt "hc09d16e1g30c6g4f43gb6f7gf1f97be06f3d"
msgid "Yes, fine, we'll kill this damn creature of yours."
msgstr "좋아, 네 빌어먹을 괴물을 죽여주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = c1ae4159-f2c7-992c-78b1-2edb9f4a0747
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c1ae4159-f2c7-992c-78b1-2edb9f4a0747
msgctxt "h69723b7ag8290g4fb6g82b5g6254566e57fc"
msgid ""
"And we'll close this particular deal soon enough - vanquish the beast, and "
"all will be revealed."
msgstr "그리고 우리는 이 특별한 거래를 끝마칠 수 있겠지요. 괴물들을 물리치시오, 그러면 모든 것이 밝혀질 것입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = c294904b-49a3-fd13-df59-6c489382035d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c294904b-49a3-fd13-df59-6c489382035d
msgctxt "he6155c9cg7701g40f7gb09fgdd341d4dad85"
msgid "Don't be absurd."
msgstr "농담 마시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = c4a2d406-5ffe-789b-a067-69a94a105743
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c4a2d406-5ffe-789b-a067-69a94a105743
msgctxt "h6d4f2466g7eddg4f2cga2b1g139d6041b268"
msgid "This is serious business, devil."
msgstr "진지하게 말하는 거야, 데빌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = c56db764-fe6f-2a22-e59b-5e6ea673cfdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c56db764-fe6f-2a22-e59b-5e6ea673cfdb
msgctxt "h17d3cb88gf116g4e98ga085ge3beca79df20"
msgid ""
"And once the deed is done, our next meeting will be most productive, "
"Astarion."
msgstr "그 일이 끝난 후의 다음번 만남은 아주 유용할 겁니다, 아스타리온."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = c704afba-6551-14c7-4f90-9e6ed67268d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c704afba-6551-14c7-4f90-9e6ed67268d9
msgctxt "haadb6be3gb6a7g410cg96d8g8862eed8dcba"
msgid "I should not relish its reacquaintance. Let's leave it at that."
msgstr "저는 이것과의 재회가 달갑지 않습니다. 그렇게만 말하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = c722b5b3-3642-a294-2580-488135060d28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c722b5b3-3642-a294-2580-488135060d28
msgctxt "hd3354735gb475g43dfga2e8ga8cc42080ddb"
msgid ""
"But what's done is done, so how about we stop discussing it and just kill "
"this beast?"
msgstr "아무튼 지난 일은 지난 일이고, 이제 우리 대화는 그만 하고 그냥 괴물을 죽이러 가는 건 어떨까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = c95535ff-c67d-1900-b1ac-94431ea1c369
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_MolsDeal_State_Lanceboard_ThreeWay_AstarionAskedRaphael = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_GotQuestFromRaphaelAtMasoleum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:c95535ff-c67d-1900-b1ac-94431ea1c369
msgctxt "h706fdd6fg88e6g41ddga008gdd7586b14f5b"
msgid "And don't think I've forgotten <i>your</i> tale, Astarion."
msgstr "그리고 제가 <i>당신의</i> 이야기를 잊었을 거라 생각하지 마세요. 아스타리온."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = cb256252-ef58-95d4-6e48-729b4e220da6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:cb256252-ef58-95d4-6e48-729b4e220da6
msgctxt "h0cb601d5g3da7g4133g959age24842e93864"
msgid ""
"Listen to your friend. What I'm asking isn't unreasonable - when you meet "
"the beast, you'll realise that killing it is the wisest course."
msgstr ""
"친구 말 좀 들어보시길. 저는 무리한 부탁을 하는 게 아니랍니다, 그냥 그 짐승을 만나면 죽이는 게 가장 현명한 선택이라는 걸 알게 될 "
"겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = cb267a19-8540-131e-8f13-aca6431071da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:cb267a19-8540-131e-8f13-aca6431071da
msgctxt "h9ff1b15eg60d6g40ffg8c72g56cc2a27f92c"
msgid "I admit, it isn't my primary interest. Not by any stretch."
msgstr "인정하죠, 제 분야는 아닙니다. 전혀 아니죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = ccc2be27-dc09-655c-b2b1-d92cfa71818c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:ccc2be27-dc09-655c-b2b1-d92cfa71818c
msgctxt "h7123c782g10e2g41f9gaac3ga5d29034601b"
msgid "Go on then. Spit it out."
msgstr "그럼 말해봐. 씨부려보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = cd209e71-88b6-2eb0-f763-64a56bdc15d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:cd209e71-88b6-2eb0-f763-64a56bdc15d8
msgctxt "hc637a49dg0256g48d2ga8a6g14018bdb46a0"
msgid "Until it was perfect."
msgstr "완벽해질 때까지 했지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = d0dbd110-7186-e2a0-1825-13e544b53119
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:d0dbd110-7186-e2a0-1825-13e544b53119
msgctxt "hcb1e987dg1d23g44ffgbc7bgcdf1b5683aae"
msgid "As you wish."
msgstr "원하시는 대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = d488a5ab-9f26-6498-34fd-6c78e322f84c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:d488a5ab-9f26-6498-34fd-6c78e322f84c
msgctxt "h4ac0279cg59e5g4435g9bd5g00f57db3adac"
msgid "What dangers are those?"
msgstr "어떤 위험이길래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = d52817fe-f7d6-7497-cf38-cf4cdfe73309
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:d52817fe-f7d6-7497-cf38-cf4cdfe73309
msgctxt "h1bb4c46dg215dg4f70gb20eg6f339dcada48"
msgid ""
"It could be infinitely worse. We seem to be rather good at killing things."
msgstr "이 정도면 그래도 괜찮은 거야. 뭘 죽이는 건 우리가 잘 하는 것 같으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = d58bb2e5-6baa-184f-b4ac-0507834f309f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:d58bb2e5-6baa-184f-b4ac-0507834f309f
msgctxt "hfd076c0cg4053g476agacfdgcbdd8e1e2cd5"
msgid "I can handle myself, Raphael."
msgstr "내 일은 내가 알아서 해, 라파엘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = d79a9c39-6111-4bf4-ef9b-448121fd3c11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:d79a9c39-6111-4bf4-ef9b-448121fd3c11
msgctxt "h2da7b657gb316g44a2g8b40g4a2a4892105c"
msgid "I'm not afraid of the dark."
msgstr "난 어둠이 무섭진 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = dbad4dfd-05cd-a4ed-b7ec-251c6a61291a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:dbad4dfd-05cd-a4ed-b7ec-251c6a61291a
msgctxt "he23e5042gd200g49f6gacaaga764dbf700d3"
msgid ""
"Decorum, Karlach. A modicum, I beg of you. Especially considering what "
"awaits you."
msgstr "예의를 지키시죠, 칼라크, 조금이라도 말입니다. 당신이 곧 마주할 재밌는 결말도 생각해보고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = dbbaa692-efda-4c93-5619-8f032bd4fada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:dbbaa692-efda-4c93-5619-8f032bd4fada
msgctxt "hd816ba03gecb9g42b0g898dgdbf929190522"
msgid "Why didn't you tell me earlier?"
msgstr "왜 말하지 않았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Karlach
#. NodeID = dd19f626-9096-450d-a0c1-36eba37988c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:dd19f626-9096-450d-a0c1-36eba37988c8
msgctxt "h6299b4bege9aeg4f35gb0d5g530958343663"
msgid "Ooh, spooky."
msgstr "오, 소름끼쳐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = dd56cb20-8be7-3a12-70e1-b670e3240b73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:dd56cb20-8be7-3a12-70e1-b670e3240b73
msgctxt "hd95eb727g73b4g45fagba15ga189734ead1d"
msgid "So you expect me to turn and walk away?"
msgstr "그래서 나보고 그대로 뒤 돌아서 떠나라는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Astarion
#. NodeID = dd9bfd33-87b9-eabc-07da-837084407d13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_State_GotQuestFromRaphaelAtMasoleum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:dd9bfd33-87b9-eabc-07da-837084407d13
msgctxt "h34806c2egd196g4cfdg8d45g8944c3604c87"
msgid "Wait! Before you go, I have a proposal of my own."
msgstr "잠깐! 가기 전에, 하고 싶은 제안이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = ddc92217-bcd9-4ed4-7834-c4eb9fd15eb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:ddc92217-bcd9-4ed4-7834-c4eb9fd15eb2
#, fuzzy
#| msgid "On the other hand, the enemy of my enemy etcetera."
msgctxt "hc47029b1gdc4ag4802ga3dag1037f623f900"
msgid "On the other hand, the enemy of my enemy, et cetera."
msgstr "그 말은, 내 적의 적이라는 소리군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = e21697e9-ee78-b17d-bb70-383a5bd63f34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:e21697e9-ee78-b17d-bb70-383a5bd63f34
msgctxt "h94b19600g731bg4e95g9356g3b8850846016"
msgid "So indulge me. And I'll indulge you."
msgstr "그러니 저를 즐겁게 해 주시죠. 그러면 저도 즐겁게 해드리죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = e52160b3-e2fd-a779-6e42-5a2bc2f70aeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_Knows_Existence = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:e52160b3-e2fd-a779-6e42-5a2bc2f70aeb
msgctxt "h37350082g25d3g47edga715g1cd728a6d06e"
msgid "I know my role even if you don't: it is to kill Ketheric."
msgstr "너는 모르겠지만 난 내 임무를 알고 있어. 케서릭을 죽이는 것이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = e5893acc-f030-7d4d-8972-1a0984bc78d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_Knows_RaphaelWillMeetAtCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:e5893acc-f030-7d4d-8972-1a0984bc78d2
msgctxt "h3310dcfbgd201g468dga24dg1335c106205c"
msgid ""
"I'll be pleased to follow up on your little escapades in your camp one of "
"these nights. Should you live to tell <i>your</i> tale, that is."
msgstr ""
"언젠가 밤에 야영지에서 당신의 소박한 모험에 대해 들을 기회가 있으면 좋겠군요. 당신이 <i>살아서</i> 이야기를 할 수 있다면 "
"말이죠. 그것뿐입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = e60ff4ed-e013-e856-59f9-1282f9a4e42a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_Astarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:e60ff4ed-e013-e856-59f9-1282f9a4e42a
msgctxt "h85c2dbe2g4548g467cgb58eg8232914857c6"
msgid ""
"Our hero thought but of treasure ahead,\n"
"Did not consider the peace of the dead..."
msgstr ""
"우리의 영웅께서는 저 앞의 보물에 정신이 팔려있으니,\n"
"죽은 자들의 평화엔 관심이 없도다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = e80d0f2e-9364-ab8a-c215-d9daaa8f1b43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:e80d0f2e-9364-ab8a-c215-d9daaa8f1b43
msgctxt "h85d844bag960eg4175gb8b2g0c372259d918"
msgid ""
"When the beast is dead, I'll consider that payment enough to translate those "
"scars of yours."
msgstr "그 괴물을 죽여준다면, 그 대가로 당신의 흉터를 해석해드리는 걸 고려해보도록 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = eb27bb53-a9e4-f473-6bd1-9e5f546bdee9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 94726285-a32b-9d8e-579f-5aa051e986b7_Picture = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:eb27bb53-a9e4-f473-6bd1-9e5f546bdee9
msgctxt "hf513e9cfg07deg438ag8d7dg2300657d86a0"
msgid "Fine, paint me a picture."
msgstr "좋아, 설명해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = eb4062f8-1524-c6c8-6898-5e23598c66de
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Orthon_Knows_RaphaelWillMeetAtCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:eb4062f8-1524-c6c8-6898-5e23598c66de
msgctxt "h3dfd17d4gb760g413fga022gbdc3b2b7d815"
msgid ""
"In truth, it is carnage incarnate. So if you meet the devil of which I "
"speak, kill it. Consider no other course of action."
msgstr ""
"사실, 저 괴물은 살육의 현신이라고 할 수 있습니다. 그러니 제가 말하는 데빌을 만난다면, 죽이세요. 다른 방도는 고민조차 하지 마시고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = ec3c02df-e509-0b1c-95e4-c14bcb4130b2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:ec3c02df-e509-0b1c-95e4-c14bcb4130b2
msgctxt "h0fd886d2g9967g4ed4gba93ge8ee7e640706"
msgid "You're still only telling me half of what you really know. I can tell."
msgstr "여전히 넌 아는 것의 절반만 말하고 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = ed4259c6-d58a-a009-bd2d-6227c0543da3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:ed4259c6-d58a-a009-bd2d-6227c0543da3
msgctxt "h87211ea4gc82ag4734g9438g323dd20aa1a0"
msgid "Just cut to the chase, will you."
msgstr "그냥 바로 본론으로 들어가. 부탁하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = f2788a77-0b53-d444-a6ea-9ec6a1ca92ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:f2788a77-0b53-d444-a6ea-9ec6a1ca92ac
msgctxt "ha1152990g232cg46abgb8a9gb54b9a3fab70"
msgid ""
"I'd rather you stick to my script, but you do have an unfortunate tendency "
"to improvise."
msgstr "당신이 제 각본을 따르기를 바라지만, 불행하게도 당신은 제멋대로 하는 경향이 있죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = f8a0ed3e-69f0-fbc0-f752-8901a9e75a55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:f8a0ed3e-69f0-fbc0-f752-8901a9e75a55
msgctxt "h47248f60g8533g4054ga046ge526be3d6164"
msgid "Oh, we both know they are soon to be revealed."
msgstr "아, 그게 머지않아 드러나게 되리란 걸 저희 둘 다 알고 있잖습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = fc3e68ff-a093-50e4-1410-a0f7342fa40d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:fc3e68ff-a093-50e4-1410-a0f7342fa40d
msgctxt "h397e3b2ag0dd5g4cfeg8795g44f24567cb1e"
msgid "Are you saying there's treasure ahead?"
msgstr "그래서 이 앞에 보물이 있다는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Raphael
#. NodeID = fe56e6ed-fbd0-e7a6-bbe4-76977c41ff90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:fe56e6ed-fbd0-e7a6-bbe4-76977c41ff90
msgctxt "hf7a7e70fgd2c6g4939gb905ga3bca884a05c"
msgid "Listen here, pipsqueak."
msgstr "똑똑히 들으시오. 햇병아리."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael
#. Speaker = Player
#. NodeID = ffdc15b8-f46f-f937-0369-7619e25da120
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Raphael:ffdc15b8-f46f-f937-0369-7619e25da120
msgctxt "ha7adaeacgbe38g4400ga82eg6db7e14ca1a8"
msgid ""
"How long were you skulking there, practicing that rhyme before I arrived?"
msgstr "내가 올 때까지 그 시를 연습하면서 기다리고 있었던 거야? 얼마나 오랫동안?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Shadowheart
#. NodeID = 0c01c84f-702b-2cea-5836-e306cc21c4dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:0c01c84f-702b-2cea-5836-e306cc21c4dd
msgctxt "h940b3c11g0daeg4193g92bbg5ece82534530"
msgid "My lady... forgive me..."
msgstr "여인이시여... 용서해 주세요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Shadowheart
#. NodeID = f5d0a04a-a44d-4936-8fdd-2b7ded04fce4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:f5d0a04a-a44d-4936-8fdd-2b7ded04fce4
msgctxt "hcd083c6dg1e1bg4755g9a84g5345ddc5725e"
msgid "Please, my lady... forgive me..."
msgstr "부디, 여인이시여... 용서해 주세요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Player
#. NodeID = fd72e8bd-9b27-4c34-ad0e-dc70cc163939
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:fd72e8bd-9b27-4c34-ad0e-dc70cc163939
msgctxt "h0878ea2ag2600g400cga716g59baa7c433dd"
msgid "There you are! I was very close to worrying about you, Shadowheart."
msgstr "거기 있었구나! 걱정되기 시작하던 참이었다고, 섀도하트."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Player
#. NodeID = fd72e8bd-9b27-4c34-ad0e-dc70cc163939
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:fd72e8bd-9b27-4c34-ad0e-dc70cc163939
msgctxt "h9d8efb13gc861g4715g88f0gc3b304b120c1"
msgid "Hm. So what kept you, Shadowheart?"
msgstr "흐음. 무슨 일로 늦어졌던 거지, 섀도하트?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Player
#. NodeID = fd72e8bd-9b27-4c34-ad0e-dc70cc163939
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:fd72e8bd-9b27-4c34-ad0e-dc70cc163939
msgctxt "hbea818c0g595cg4986g9cd9g3220e6954638"
msgid ""
"Something's amiss. Shadowheart - what happened? Why did you vanish like that?"
msgstr "뭔가 켕기는 게 있어. 섀도하트, 어떻게 된 거야? 왜 그렇게 갑자기 사라진 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Player
#. NodeID = fd72e8bd-9b27-4c34-ad0e-dc70cc163939
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:fd72e8bd-9b27-4c34-ad0e-dc70cc163939
msgctxt "h3a7383a8g4317g4789gb499gdca33d014e0c"
msgid "Glad to have you back, Shadowheart. What's been keeping you?"
msgstr "돌아와서 다행이야, 섀도하트. 왜 지체된 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Player
#. NodeID = fd72e8bd-9b27-4c34-ad0e-dc70cc163939
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:fd72e8bd-9b27-4c34-ad0e-dc70cc163939
msgctxt "h50739b86gdc22g46ddg8344g4ff3e655345f"
msgid "Shadowheart? You all right?"
msgstr "섀도하트? 괜찮아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Player
#. NodeID = fd72e8bd-9b27-4c34-ad0e-dc70cc163939
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:fd72e8bd-9b27-4c34-ad0e-dc70cc163939
msgctxt "hc3eec345g2289g46d4ga371g05560fdcb68e"
msgid ""
"What wickedness befell you, Shadowheart? We emerged, but you were not with "
"us."
msgstr "무슨 악독한 일을 겪은 것인가, 섀도하트여? 우리가 지상에 올라올 때 그대는 함께 있지 않았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns
#. Speaker = Player
#. NodeID = fd72e8bd-9b27-4c34-ad0e-dc70cc163939
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: !(REALLY_JAHEIRA and REALLY_SHADOWHEART)
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SharWrath_PAD_ShadowheartReturns:fd72e8bd-9b27-4c34-ad0e-dc70cc163939
msgctxt "h0918f131ga1a1g4439g99ffgde2ec74bdbec"
msgid "Shadowheart? What happened? You were missing for a moment."
msgstr "섀도하트? 무슨 일이야? 잠깐 종적을 감췄었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_AD_RiddlePlaque
#. Speaker = Narrator
#. NodeID = 4227d9e1-827e-411d-a9ed-a5faa2895ae8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_AD_RiddlePlaque:4227d9e1-827e-411d-a9ed-a5faa2895ae8
msgctxt "h253d2332g8d93g4345g973eg057e1b860911"
msgid "*'What can silence the Nightsong?'*"
msgstr "*'무엇이 밤의 노래를 침묵하게 할 수 있는가?'*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_AD_SilencePlayer
#. Speaker = GROUP_SHA_Librarians
#. NodeID = d450ab34-cb8f-2581-eb21-9b14de32a22f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_AD_SilencePlayer:d450ab34-cb8f-2581-eb21-9b14de32a22f
msgctxt "he93fe8ceg87c4g4163gb651ga3ab188779d8"
msgid "<i>You disturb the silence. Hush.</i>"
msgstr "<i>너희는 침묵을 깨뜨리고 있다. 정숙하라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "hf6c41ba4gefbeg45e1gad42g563f70a4fce3"
msgid "And it's easy as that."
msgstr "참 간단하게도 풀렸군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "h065eb4a1ge63bg4a6bgbfccgfe32f62d1609"
msgid "Access."
msgstr "됐다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "hd2b55b45gaa02g4205g8f8cg2061bda1f010"
msgid "That did the trick."
msgstr "방금 걸로 됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "h6d672f90g73bag42fbgbb1ag2d96d533cef0"
msgid "That worked. The door's open."
msgstr "통했네. 문이 열렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "hbdf13c2ag07a7g4eaagb38ag0c72aa24c5cf"
msgid "And that's that."
msgstr "딱 됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "h93159df3g2b84g45cegaae3g27bdd48c004c"
msgid "That did it."
msgstr "방금 그걸로 됐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "h34cc9a8agea5dg40b5gb71eg4d62044f7e49"
msgid "That seems to have worked."
msgstr "통한 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor
#. Speaker = Player
#. NodeID = caaf2874-e282-423d-b589-2388693fabf9
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_OpenedScrollDoor:caaf2874-e282-423d-b589-2388693fabf9
msgctxt "h2947152bgc23ag4988g9f32ged32e28faf85"
msgid "Seemed to work."
msgstr "통한 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h04343e66gc790g4961g8d35gcdab480e886a"
msgid "A beautiful spear. I wonder if it's the same one Shadowheart needed."
msgstr "아름다운 창이야. 섀도하트에게 필요한 그 창이 맞는지 궁금해지는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h8aeaa56bg2330g4a53gbeabgebfe53e70a5f"
msgid "What an unusual spear. Is this the one Shadowheart seeks?"
msgstr "무척이나 비범한 창이군. 이게 바로 섀도하트가 찾고 있던 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h6c7f03ecg1f25g419eg861dg0ceb1068c6ca"
msgid ""
"A remarkable spear. The very one that Shadowheart wishes to claim, no doubt."
msgstr "아주 인상적인 창이야. 분명 섀도하트가 손에 넣기를 원한 물건이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h74392dcfg114fg49a7gb04bg9f1f64e30052"
msgid ""
"This has to be it. This has to be the Spear of Night. The weapon Lady Shar "
"bid me to wield."
msgstr "이게 분명해. 바로 이게 밤의 창일 거야. 샤님께서 내게 내리신 무기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h32ea7994g238dg4f6bgbc3eg2f0fbcca4be6"
msgid "Quite an unusual spear."
msgstr "꽤 비범한 창이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h33509895g1732g4837g9b13g8e7cc97d4d4f"
msgid "This has got to be the spear Shadowheart's after."
msgstr "분명 이게 섀도하트가 찾던 그 창일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h02403c73g1a20g46adg8d3egf803a55483f6"
msgid ""
"Fascinating spear. I'd wager a bottle of Thayan Red this is the one "
"Shadowheart wants."
msgstr "아주 훌륭한 창이군. 이게 섀도하트가 찾던 그 무기라는 데 테이 산 적포도주 한 병을 걸겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "h168695c0gbbc1g49f3g9ac8g178cde47a13b"
msgid "An uncommon spear. The one Shadowheart seeks, no doubt."
msgstr "비범한 창이로군. 분명 섀도하트가 찾던 물건일 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_NeedSpear = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:14e5f30a-e7d0-48ba-a3e4-3f1f9564261c
msgctxt "he15168eagbc3fg48f8g97f1g48ba8f2b2e8d"
msgid ""
"This is no common spear... It must be the one that Shadowheart is supposed "
"to find."
msgstr "보통 창이 아니야... 이게 바로 섀도하트가 찾던 물건이 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "h52b217d0g38d4g41b4gb100g34f761a66a86"
msgid "Oh, this is beautiful. A fine weapon."
msgstr "오, 거참 아름답네. 훌륭한 무기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "h1f7872e4g9b68g474bg8740g86a016aaf078"
msgid "Quite the spear. Keen point, hardy shaft - a good weapon to keep handy."
msgstr "썩 훌륭한 창이로군. 날 부분은 예리하고 자루는 견고해. 요긴하게 쓰일 만한 무기야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "hf7319ec3g24dcg4ae2gbb35g28f47700f088"
msgid "Interesting spear. Deadly-looking, but interesting."
msgstr "독특한 창이네. 겉보기로는 무시무시해 보이지만 독특해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "h2926e44fg49b3g4be5gbafbg537b9038c9dd"
msgid "This is no ordinary spear... it may be important. Best keep it close."
msgstr "이건 보통 창이 아니야... 중요한 것인지도 몰라. 간직해 두는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "h57de59d5gad9bg4820gad4ege3bdeb08a3dd"
msgid "Nice. A spear of this caliber's got plenty of gutting potential."
msgstr "훌륭하군. 이렇게 빼어난 창이라면 적을 쉬이 도륙할 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "hbbafc75eg1bacg4387ga2d0gad27f851f600"
msgid "Whey, would you get a load of that? What a spear."
msgstr "와아, 이것 좀 보게? 엄청 훌륭한 창이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "h31290cf1g0374g41acg8f90gb17e050c182a"
msgid ""
"A curious spear - and perhaps an important one, for it to be hidden like so."
msgstr "비범한 창이로군. 이렇게 숨겨져 있던 것을 보면 중요한 것인지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot
#. Speaker = Player
#. NodeID = 6d9d2ec7-1246-4c50-9086-097dbcd72c1b
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SilentLibrary_PAD_SpearLoot:6d9d2ec7-1246-4c50-9086-097dbcd72c1b
msgctxt "h135269ffgd868g4df6g9e7eg651e0a91bb41"
msgid "Quite a spear. Why hide it away...?"
msgstr "인상적인 창이로군. 어째서 숨겨 두었을까...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Lae'zel
#. NodeID = 09c61899-d3fe-92e2-4fc5-b2f1c4eb7acf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_LAEZEL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:09c61899-d3fe-92e2-4fc5-b2f1c4eb7acf
msgctxt "h3c086afbgf9ecg4683gb375gea4a74ab3cde"
msgid ""
"<i>Chk. </i>Once that poison's worn off, remind me to tell you that you had "
"it coming."
msgstr "<i>츠크. </i>독기가 좀 빠지면 나한테 말해. 다 네가 자초한 일이라고 알려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Karlach
#. NodeID = 0e924683-316a-49c9-9b2f-4af754e6e30e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:0e924683-316a-49c9-9b2f-4af754e6e30e
msgctxt "h63785f2fg783eg435cgb94fgc5d02bf08bbe"
msgid "Do I smell beef?"
msgstr "이거 소고기 냄새야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Lae'zel
#. NodeID = 104a508a-f295-4f10-9496-c27030eb559c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_LAEZEL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:104a508a-f295-4f10-9496-c27030eb559c
msgctxt "h5ae6639bgce51g473bga194gf323fb672170"
msgid ""
"Reddened cheeks, wild eyes - I know that look. And you best keep this... "
"little problem to yourself."
msgstr "홍조를 띤 볼에, 사나워진 눈빛이라. 그 표정 잘 알지. 아무튼 네가 겪고 있는 그 문제는... 스스로 해결하는 게 좋을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Wyll
#. NodeID = 13fc65bf-8572-470a-8d30-dfc7f85f3994
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:13fc65bf-8572-470a-8d30-dfc7f85f3994
msgctxt "hbc9d7a7agfad5g4e2bg94acgfbfe3c1f396b"
msgid "My, my - is it me, or do I see a bit of flush in those cheeks?"
msgstr "이런, 이런. 지금 볼 빨개진 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Shadowheart
#. NodeID = 14858be1-c421-5187-cd2c-e23998197dbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:14858be1-c421-5187-cd2c-e23998197dbe
msgctxt "hb8a5db49gadf2g4643g9218g459103d1f686"
msgid ""
"Honestly, what did you think was going to happen? You'd develop a taste for "
"it?"
msgstr "무슨 일이 일어날 거라 생각한 거야? 혹시 입맛에 맞을까 봐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 184c361c-b402-61f8-4aa4-0fb6f3d920c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_Displacer_State_StudiedMeat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:184c361c-b402-61f8-4aa4-0fb6f3d920c1
msgctxt "h79cb1eafg4d91g4fbfg8f53gd5c541e49789"
msgid ""
"*Fresh bite marks, an old puncture wound, and a faint pulse of something not "
"entirely natural.*"
msgstr "*생긴 지 얼마 안 된 씹은 자국, 오래된 뚫린 상처, 거기에 부자연스러운 뭔가의 희미한 맥박이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 1a856601-7fda-f055-d2ca-aea1fbdd81d0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Object:
#.      - SHA_Displacer_State_StudiedMeat(1) = True
#.      - SHA_Displacer_State_MeatArcanaCheckFailed(1) = False
#.      - SHA_Displacer_State_MeatArcanaCheckSuccess(1) = False
#.   Tag:
#.      - SORCERER(1) = False
#.      - WARLOCK(1) = False
#.      - WIZARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:1a856601-7fda-f055-d2ca-aea1fbdd81d0
msgctxt "h1d231d68g8ed2g4b37gacddg5dfac7848d58"
msgid "<i>Scan the meat for signs of magical interference.</i>"
msgstr "<i>고기에서 마법적 간섭의 흔적을 찾는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 1b5d8fa3-91dd-8c52-a8b0-8aa24519d0f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:1b5d8fa3-91dd-8c52-a8b0-8aa24519d0f7
msgctxt "h27eb2ca6g873eg49b1g9e09gb6e7c616f043"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 1d5c5477-7256-c17f-66e8-c838a585ae94
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_MeatPoisoned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:1d5c5477-7256-c17f-66e8-c838a585ae94
msgctxt "h6eda66a5g5b61g474eg8a03g4191b72c6f95"
msgid ""
"*In amongst the rot is an unmistakable sweetness - succubus spittle. The "
"meat is <i>charmed</i>.*"
msgstr "*떫은 맛 가운데 분명 뭔가 달콤함이 있습니다. 서큐버스의 침입니다. 이 고기는 <i>매혹된</i> 상태입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Karlach
#. NodeID = 27fa89b6-fd7d-49ce-9ca1-a537b4d23e1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:27fa89b6-fd7d-49ce-9ca1-a537b4d23e1d
msgctxt "hd0e9a16cge54ag4419ga60bg3d3ca773c760"
msgid "Haha! Go on, give us a turn next."
msgstr "하하! 계속해, 다음은 우리 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Shadowheart
#. NodeID = 29c93032-50e0-458b-a921-61e7e75b238a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:29c93032-50e0-458b-a921-61e7e75b238a
msgctxt "ha12ac510gfa67g4355gb857gfaeff20f4a7f"
msgid "Why are you looking at that dead spider... coquettishly?"
msgstr "왜 그 죽은 거미를... 요염한 눈빛으로 보는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Astarion
#. NodeID = 2a232424-f1dd-2ebd-c131-44bf5b3ba220
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:2a232424-f1dd-2ebd-c131-44bf5b3ba220
msgctxt "hb4499070ge507g4ad4g8093g9ea804bc8ac4"
msgid "Well, that's what you get for being greedy."
msgstr "뭐, 욕심부리면 그렇게 되는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 2ef42b8c-613a-e259-46ce-a7beee97a89a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_SpiderMeatHunk_Event_PoisonPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:2ef42b8c-613a-e259-46ce-a7beee97a89a
msgctxt "ha130f145gacd0g49d4gbbe6g1b1715d7843b"
msgid ""
"*You feel hot bile rising in your throat as your body breaks into a sweat. "
"Your vision blurs and your legs threaten to give in.*"
msgstr "*식도로 뜨거운 위액이 올라오고, 땀이 흐르기 시작합니다. 시야가 흐려지고, 다리가 후들거려 쓰러질 것만 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Lae'zel
#. NodeID = 328615a3-0675-4d32-8213-a706ffe07603
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_LAEZEL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:328615a3-0675-4d32-8213-a706ffe07603
msgctxt "hc30df74cgab9cg40a0gbcd5gad13a7916d80"
msgid "Ugh. Have you considered <i>not</i> tonguing rotten spider-flesh?"
msgstr "으윽. 썩은 거미 고기를 <i>안</i> 핥는 건 고려해보지 않았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Wyll
#. NodeID = 33c14090-5a24-431c-ac23-14caf9d40590
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:33c14090-5a24-431c-ac23-14caf9d40590
msgctxt "h6f881ae9ge7ffg4dcag9f3ag692684ca7a79"
msgid "What is it they say? Ah yes - 'Curiosity killed the kobold.'"
msgstr "뭐라고 하더라? 아 맞다, '호기심이 코볼트를 죽인다.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 3be200aa-fcb3-da33-35f1-ad4f936168db
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:3be200aa-fcb3-da33-35f1-ad4f936168db
msgctxt "hd49f983eg882ag47dag9b48gd9a3da9a56e3"
msgid "<i>Inhale the noxious aroma.</i>"
msgstr "<i>끔찍한 향기를 들이마신다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 3be200aa-fcb3-da33-35f1-ad4f936168db
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:3be200aa-fcb3-da33-35f1-ad4f936168db
msgctxt "h5747ffa9gae3dg489ag9cfdg674677f90a4c"
msgid "<i>Take a good long sniff.</i>"
msgstr "<i>충분히 깊게 냄새를 맡아본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 4bd00761-2e34-1141-73d1-8510a0dd87e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:4bd00761-2e34-1141-73d1-8510a0dd87e2
msgctxt "h47161f7bg9965g4cbdg9c3agcd5aa3465108"
msgid ""
"*A cavalcade of nasty smells rises from the corpse - but one of them is "
"familiar. The prickling, metallic whiff of magic.*"
msgstr "*시체에서 다양한 끔찍한 냄새가 올라옵니다. 그러나 그 중 익숙한 냄새가 섞여 있습니다. 따가운 금속성 냄새, 마법입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 4d213c53-d497-6de4-347f-a7a0f49411de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_SpiderMeatHunk_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:4d213c53-d497-6de4-347f-a7a0f49411de
msgctxt "h1f344735g8d41g4e0dg8cf5gd5aa0b72bc1c"
msgid "*The carcass continues to leak.*"
msgstr "*시체에서 뭔가 계속 새어 나옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Gale
#. NodeID = 4e714a40-ec08-4aa7-9b89-c3810bd1ebad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_GALE(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:4e714a40-ec08-4aa7-9b89-c3810bd1ebad
msgctxt "h095fd735gff2ag4142gb364gc6954d90cab1"
msgid ""
"If what is happening is what I think is happening, and it's because you "
"licked a dead spider - the time might just have come when you and I should "
"split ways."
msgstr ""
"지금 일어나고 있는 일이 내가 생각하고 있는 일이고, 그게 죽은 거미를 핥아서 일어난 일이라면, 너랑 내가 서로 갈 길을 갈 때가 온 것 "
"같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 54bbb790-3fa4-b467-99d9-9932f33bc576
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_SpiderMeatHunk_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:54bbb790-3fa4-b467-99d9-9932f33bc576
msgctxt "heec86f86g57f5g4df3ga539g80a8079d9b64"
msgid "*A well-chewed spider carcass oozes on the ground.*"
msgstr "*몇 번 씹힌 거미 시체에서 뭔가 스며 나옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 554ee541-44e7-1f1e-4b69-09fa9c776af8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:554ee541-44e7-1f1e-4b69-09fa9c776af8
msgctxt "h558528e2gbf63g4c17g9549gad6071dd982c"
msgid ""
"*Your guts cramp, your stomach churns, and your nerves burn with a pain that "
"would almost be pleasurable were it not so savage.*"
msgstr ""
"*위가 경련을 일으키고, 속이 뒤집어집니다. 당신의 신경이 고통으로 타오릅니다. 고통을 즐기는 편이긴 하나, 그 강도가 너무 맹렬합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Karlach
#. NodeID = 55994695-82aa-bc01-9532-1bef8daa0388
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:55994695-82aa-bc01-9532-1bef8daa0388
msgctxt "he74e9137ga1ffg4223g8a26gfe6480293048"
msgid "All right there, mate? Yeah, you're all right."
msgstr "너 괜찮아? 그래, 괜찮네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 588ebb3f-1b86-c063-431d-7a28a9dcf567
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Object:
#.      - SHA_Displacer_State_StudiedMeat(1) = True
#.      - SHA_Displacer_State_MeatArcanaCheckFailed(1) = False
#.      - SHA_Displacer_State_MeatArcanaCheckSuccess(1) = False
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:588ebb3f-1b86-c063-431d-7a28a9dcf567
msgctxt "h5f2efd26gf155g47deg9effg2a0c06a4ae15"
msgid "Wizard"
msgstr "위저드"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 588ebb3f-1b86-c063-431d-7a28a9dcf567
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Object:
#.      - SHA_Displacer_State_StudiedMeat(1) = True
#.      - SHA_Displacer_State_MeatArcanaCheckFailed(1) = False
#.      - SHA_Displacer_State_MeatArcanaCheckSuccess(1) = False
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:588ebb3f-1b86-c063-431d-7a28a9dcf567
msgctxt "h772b1badga2b7g409bga7efg962069774e19"
msgid "<i>Scan the meat for signs of magical interference.</i>"
msgstr "<i>고기에서 마법적 간섭의 흔적을 찾는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 63eff74e-57ce-3d6d-c3bd-003140901fde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_Displacer_State_StudiedMeat(1) = True
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = True
#. TagRule: DRUID
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:63eff74e-57ce-3d6d-c3bd-003140901fde
msgctxt "hf8cf95a2ge1e4g4213gb0aeg971ba0dbe6cc"
msgid ""
"<i>Inspect the bite marks more closely to see if you can identify what made "
"them.</i>"
msgstr "<i>무엇이 씹은 자국인지 알아내기 위해 흔적을 자세히 살펴본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Astarion
#. NodeID = 67ccdd46-8c89-4042-802a-df092c0df438
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:67ccdd46-8c89-4042-802a-df092c0df438
msgctxt "h100258d5ga40eg4462gb91eg410fd4a9ae8d"
msgid "Rotten meat? That's what gets you going? Well, to each their own."
msgstr "썩은 고기? 그런 게 좋은 거야? 뭐, 각자 취향이란 게 있는 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Shadowheart
#. NodeID = 69b1bee0-5c8e-432b-a14f-d11daec7275d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:69b1bee0-5c8e-432b-a14f-d11daec7275d
msgctxt "h849a9770gfa71g49dcgbb54g383645160e68"
msgid "What the...? You can't just go around <i>licking things, </i>you know."
msgstr "이게 무슨...? 아무 거나 막 <i>핥고</i> 그러면 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 6a799161-e99d-363a-214d-40d684c66da8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_SpiderMeatHunk_HasLickedAgain(1) = False
#.      - SHA_SpiderMeatHunk_HasLicked(1) = True
#. SetFlags:
#.   Object:
#.     - SHA_SpiderMeatHunk_HasLickedAgain(1) = True
#.     - SHA_SpiderMeatHunk_Event_PoisonPlayer(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:6a799161-e99d-363a-214d-40d684c66da8
msgctxt "he03288e5ga71cg40d4gbd83g817ffa06adbc"
msgid "<i>Sup once more upon the flesh.</i>"
msgstr "<i>살점을 다시 한번 핥짝인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 6a799161-e99d-363a-214d-40d684c66da8
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_SpiderMeatHunk_HasLickedAgain(1) = False
#.      - SHA_SpiderMeatHunk_HasLicked(1) = True
#. SetFlags:
#.   Object:
#.     - SHA_SpiderMeatHunk_HasLickedAgain(1) = True
#.     - SHA_SpiderMeatHunk_Event_PoisonPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:6a799161-e99d-363a-214d-40d684c66da8
msgctxt "h4c521e26g46acg4c63g9bebg2c43a5d9ec81"
msgid "<i>Lick it again.</i>"
msgstr "<i>다시 핥는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 6d5f29fc-ac05-ce30-9ac9-ec5771d34f3d
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Object:
#.      - SHA_Displacer_State_StudiedMeat(1) = True
#.      - SHA_Displacer_State_MeatArcanaCheckFailed(1) = False
#.      - SHA_Displacer_State_MeatArcanaCheckSuccess(1) = False
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:6d5f29fc-ac05-ce30-9ac9-ec5771d34f3d
msgctxt "h33013d30g81d2g4749gaac3g00b4630dcd59"
msgid "Sorcerer"
msgstr "소서러"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Player
#. NodeID = 6d5f29fc-ac05-ce30-9ac9-ec5771d34f3d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Object:
#.      - SHA_Displacer_State_StudiedMeat(1) = True
#.      - SHA_Displacer_State_MeatArcanaCheckFailed(1) = False
#.      - SHA_Displacer_State_MeatArcanaCheckSuccess(1) = False
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:6d5f29fc-ac05-ce30-9ac9-ec5771d34f3d
msgctxt "hf6fd1030g7fbbg4602gbb41g3ec36e07dd6b"
msgid "<i>Scan the meat for signs of magical interference.</i>"
msgstr "<i>고기에서 마법적 간섭의 흔적을 찾는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Wyll
#. NodeID = 79094914-1a63-82d8-5ae6-1ef8f8384853
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:79094914-1a63-82d8-5ae6-1ef8f8384853
msgctxt "hdc096587gca3cg403ag8ae3g96756a6064e2"
msgid "Bad luck. Let's call this... a learning moment."
msgstr "운이 나빴네. 이 경험으로... 뭔가 배웠다 치자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 85086467-92e6-cd05-cd64-184428883fc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:85086467-92e6-cd05-cd64-184428883fc7
msgctxt "h7db41c43g05b8g41f1gbe9bg7a6b555210d4"
msgid ""
"*The meat tastes of rot and sour milk. Your stomach lurches, but your loins "
"<i>tingle</i>. Was that <i>arousal</i>...?*"
msgstr ""
"*고기에서는 썩은 음식과 상한 우유 맛이 납니다. 속이 뒤틀리지만, 당신의 가랑이는 <i>움찔댑니다</i>. 방금 그건 "
"<i>흥분</i>이었나요...?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 86af2128-71a7-a79e-f09b-3a267dd9718a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_Displacer_State_MeatArcanaCheckFailed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:86af2128-71a7-a79e-f09b-3a267dd9718a
msgctxt "hc41394d0g1b9dg4948gb391g2b4bc69250e1"
msgid "*There appears to be nothing out of the ordinary.*"
msgstr "*이상한 점이 전혀 보이지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Gale
#. NodeID = 8c23d309-e322-43d5-a421-4c4af4c7661c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:8c23d309-e322-43d5-a421-4c4af4c7661c
msgctxt "h828ad63fg9dd2g429dgb84fgb0e1b315d4ae"
msgid ""
"I think we need to get you some air and perhaps have a long talk about "
"unresolved childhood issues."
msgstr "우리 말이지, 신선한 공기부터 좀 마시고, 어린 시절 있었던 일들에 대해서 대화를 해봐야 할 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 923f5f1f-5ca7-1c16-e552-57a64f5bff39
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_MeatPoisoned = True
#.   Object:
#.     - SHA_Displacer_State_MeatArcanaCheckSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:923f5f1f-5ca7-1c16-e552-57a64f5bff39
msgctxt "h17958950ge6b8g436fgbe70g09f8af560bed"
msgid ""
"*The meat is oozing, but not with blood - it's been dosed with a "
"<i>potion</i>.*"
msgstr "*고기에서 스며 나오는 것은 피가 아닙니다. 이 고기에는 <i>물약</i>이 섞여 들어가 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Gale
#. NodeID = 9b2c9361-c3dc-d0c5-319e-a97ee016238d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_GALE(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:9b2c9361-c3dc-d0c5-319e-a97ee016238d
msgctxt "h41214659gf63ag4fbbgace7g1dbb3e6cfedb"
msgid "Stop licking the damn thing!"
msgstr "그것 좀 그만 핥아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Narrator
#. NodeID = 9c46b285-f5dd-9651-3410-d53a377f7115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:9c46b285-f5dd-9651-3410-d53a377f7115
msgctxt "h3a68e0ddgcf7cg439egbc47gfab0367c5fd9"
msgid ""
"*Sulphur, decay, and a thin whiff of something unexpectedly <i>fragrant</i>.*"
msgstr "*유황, 부패, 그리고 희미하지만 의외로 <i>향긋한</i> 냄새가 납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk
#. Speaker = Gale
#. NodeID = a866e081-caf1-413b-b3d5-0d88b81ad98b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_GALE(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_SpiderMeatHunk:a866e081-caf1-413b-b3d5-0d88b81ad98b
