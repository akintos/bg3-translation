#.      - HAV_Mood_State_Unprotected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_HasMet_EntranceGuards_Caster_HighElf_Unprotected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:ed45b4aa-156c-448e-bd3e-28ae64f622ac
msgctxt "h4adb3f65g0e34g4e16g99fag288e06e31c0b"
msgid ""
"My hands might be trembling, but don't worry - I'll protect this place with "
"my life."
msgstr "내 손이 떨리고 있을지 모르지만, 걱정 마세요. 목숨을 걸고 이곳을 지킬 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Player
#. NodeID = f815044a-a65e-0edb-e8fa-f9660b499249
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:f815044a-a65e-0edb-e8fa-f9660b499249
msgctxt "hfd161861g1a67g4e30g8eefg6cb065318a36"
msgid "I've tried waking him - to no avail."
msgstr "깨워 보려 했지만 - 소용 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Harper Tumeril
#. NodeID = fec9a654-9096-0c3c-0733-d55e1eef3524
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:fec9a654-9096-0c3c-0733-d55e1eef3524
msgctxt "h14c0a045g3f78g4c89gb042g91f6f52a0f65"
msgid ""
"Judging by his uniform he's someone of import - he was here, fresh from the "
"shadows, when Isobel banished the curse here."
msgstr "이소벨이 이곳에서 저주를 내쫓았을 때 그림자에서 막 벗어난 채로 여기 있었다고 하더군, 제복을 보아하니 중요한 사람 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Halfling_Melee
#. Speaker = Harper Callie
#. NodeID = 4bba4fc5-0491-457b-9721-65b2f8bbd86d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_EntranceGuards_Halfling_Melee_Protected(1) = True
