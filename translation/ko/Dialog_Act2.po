msgctxt "h2bb0c068g7cf9g4b83ga2fdgd389fb01a093"
msgid "<i>Reach out with your powers to summon the guide.</i>"
msgstr "<i>힘을 사용하여 안내자를 소환한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Narrator
