msgctxt "h0f81127aga5bbg4d5eg8b5bgd11fde5e9efa"
msgid "Pops? Say something - anything!"
msgstr "아빠? 대답 좀 해주세요... 아무 말이라도요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_AD_Arabella
#. Speaker = Arabella
#. NodeID = e788389a-702f-5af5-cc6b-36812d034c65
