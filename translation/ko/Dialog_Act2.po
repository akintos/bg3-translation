#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:86a7b9e0-9abd-47fe-bb5a-78f0815a3ea9
msgctxt "h15ee3d9fg51dag4638ga05ege195bcb2388c"
msgid ""
"Those beasts still prowl the eternal night, but at least they're afraid of "
"the fire."
msgstr "저 짐승들은 영원한 밤을 아직도 돌아다니고 있지만, 일단 불을 무서워하기는 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = True Soul Korliss
#. NodeID = bd0535f9-2af3-442d-654c-3c9376ca1790
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_MastiffPoachers_Knows_ContinualFlame = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:bd0535f9-2af3-442d-654c-3c9376ca1790
msgctxt "hd1533c77g7cc2g4f51ga192g1e02e600be72"
msgid "Spell... Continual Flame..."
msgstr "주문... 영원의 불꽃..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = Astarion
#. NodeID = c56153b8-db95-4fff-a04f-7258262b2a51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:c56153b8-db95-4fff-a04f-7258262b2a51
msgctxt "h0feb769ag8b05g44cfg96c0g1812207dcd83"
msgid ""
"Well, we can be grateful for the torches. Without them, those beasts would "
"be on us in no time."
msgstr "음, 횃불에 고마워해야겠네. 그게 없으면, 저 짐승들이 곧바로 우리한테 올 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = True Soul Korliss
#. NodeID = cd359dc5-7749-b0c7-0244-6e81f6bc2d73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:cd359dc5-7749-b0c7-0244-6e81f6bc2d73
msgctxt "h3028b2beg663ag4ec0gb74ega829c5993d96"
msgid "Destroy torches..."
msgstr "횃불을 부숴..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = Player
#. NodeID = cfa11088-5c09-4c8c-9bfc-6a5c876ce4b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:cfa11088-5c09-4c8c-9bfc-6a5c876ce4b7
msgctxt "hf3f3f1feg7d70g4fe7g8731gadbbc4b84541"
msgid "How did you end up here?"
msgstr "어쩌다 여기까지 오게 된 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = True Soul Korliss
#. NodeID = d05ec9ab-4b2a-4f49-86c1-bb50c53abbb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:d05ec9ab-4b2a-4f49-86c1-bb50c53abbb3
msgctxt "hc9b291b3g1bf4g4c03g8cc9gfe794f8f8c0a"
msgid "To Waterdeep born... to Moonrise called..."
msgstr "워터딥에서 태어나... 문라이즈의 부름을..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = True Soul Korliss
#. NodeID = da868f1d-05bb-4449-b64d-0a619c0c578c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 87ad1079-e513-626d-3cb4-289939042144_PoacherTrueSoul = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:da868f1d-05bb-4449-b64d-0a619c0c578c
msgctxt "hf16e231fg3792g427fg8252g72bb583dcbfa"
msgid "True Soul of the Absolute... Korliss by name..."
msgstr "절대자의 참된 영혼... 이름은 코를리스..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = Narrator
#. NodeID = e08099a0-8e76-4469-8174-ed378aec874c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:e08099a0-8e76-4469-8174-ed378aec874c
msgctxt "hd1a03fbbgec4dg4bb9g8699g0bada48147f6"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = Narrator
#. NodeID = e3a55328-c5b8-45ca-92c8-f8de22743fb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:e3a55328-c5b8-45ca-92c8-f8de22743fb0
msgctxt "h2bf463f7gd3cag4481gb2c4g007895749cd1"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = Player
#. NodeID = e9e7727e-9cb3-4587-9eea-9593215d78ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:e9e7727e-9cb3-4587-9eea-9593215d78ce
msgctxt "h7b2b584dg4decg4cd8g8812gc5cbbc1af514"
msgid "Who were you in life?"
msgstr "넌 누구였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = True Soul Korliss
#. NodeID = ee8299e0-dea5-4c09-9370-9bb5b368a126
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 87ad1079-e513-626d-3cb4-289939042144_KnowTorches = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:ee8299e0-dea5-4c09-9370-9bb5b368a126
msgctxt "h22963306g220bg4cf3gb6ccg3426c984ac78"
msgid "Trapped... shadow mastiffs... repelled them with flame..."
msgstr "포위됐어... 그림자 마스티프 떼를... 불로 쫓아냈지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = Narrator
#. NodeID = f73f9949-f847-4e5f-bcde-bec9cce56035
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:f73f9949-f847-4e5f-bcde-bec9cce56035
msgctxt "hd3b4c2b0g80a5g46b7gbf3cge78e0d8c54c9"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = True Soul Korliss
#. NodeID = fbcfe53a-004f-48e8-bd32-fd5bc9673e57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:fbcfe53a-004f-48e8-bd32-fd5bc9673e57
msgctxt "h08ccc323gc2a5g4c38g9449gb73ca6a83bc7"
msgid "Unslaked hunger... unquenched thirst..."
msgstr "채울 수 없는 허기... 해소할 수 없는 갈증..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead
#. Speaker = Narrator
#. NodeID = fea7b6ea-7647-42ff-bbe8-4d7bc6dea35f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MastiffPoachers_TrueSoul_Dead:fea7b6ea-7647-42ff-bbe8-4d7bc6dea35f
msgctxt "h20c3d5edg6f29g4fc9gb174g05f99a0ce272"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Nightwarden Minthara
#. NodeID = 0e066ac6-6d77-999b-f2e8-be6c10e517bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:0e066ac6-6d77-999b-f2e8-be6c10e517bb
msgctxt "h6b3f4b91g0094g46adg9faeg0201cb73438d"
msgid ""
"I do not. All that I did before you rescued me was as a puppet of the "
"Absolute - it is behind me. Until Ketheric falls, only vengeance remains."
msgstr ""
"난 아니야. 네가 구해주기 전까지 난 절대자의 꼭두각시로 살았어. 이제 그 생활도 끝났으니, 내게 남아있는 건 오직 케서릭이 쓰러질 "
"때까지 복수하는 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Halsin
#. NodeID = 4af2a8db-5599-4c99-bae4-649893a633d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:4af2a8db-5599-4c99-bae4-649893a633d3
msgctxt "h73046ceag333eg4204gb457g9a9cf829356a"
msgid ""
"I cannot venture back with you - now that I am in a position to fight the "
"curse, I must stay here and see it through."
msgstr "난 자네와 함께 돌아갈 수 없네. 이제 저주에 맞서야 하는 위치에 있으니, 여기에 남아 지켜봐야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Nightwarden Minthara
#. NodeID = 10baca68-a484-4866-a4c3-a7b0ddbd24dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_State_Dead = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:10baca68-a484-4866-a4c3-a7b0ddbd24dd
msgctxt "hc6870e32ga0e2g4329gb7dbg7f280dd39a53"
msgid ""
"If you intend to stray from Moonrise while Ketheric still lives, I shall "
"remain at camp, strategising his downfall."
msgstr "만약 케서릭을 처리하지 않고 문라이즈에서 떠날 생각이라면, 난 차라리 야영지에 남아서 그를 몰락시킬 방법을 계획하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Player
#. NodeID = 789bc276-c078-4ada-b189-b3486678ded1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:789bc276-c078-4ada-b189-b3486678ded1
msgctxt "ha0571173g982fg46d4gbe0dga410b7b72894"
msgid ""
"Have it your way, then. Find somewhere safe to camp and I'll see you when I "
"return."
msgstr "그럼 그렇게 하시지요. 안전하게 야영하고 계시면 돌아와서 보러 가겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Player
#. NodeID = 13b7ae65-c435-4b0a-9034-86c4842b9850
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:13b7ae65-c435-4b0a-9034-86c4842b9850
msgctxt "h96c28d23gf98fg4ddeg823eg30abb44aced6"
msgid "Go to camp, then. I'll see you soon."
msgstr "그럼, 야영지에서 기다려. 곧 갈 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Player
#. NodeID = 9a93c4ee-6de6-43c1-a77a-a91cb230369e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:9a93c4ee-6de6-43c1-a77a-a91cb230369e
msgctxt "h6c1eedcbgfb4fg4879g94bdgc946614b123e"
msgid "Very well, I'll remain here with you."
msgstr "좋아요, 여기 당신과 함께 있겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Player
#. NodeID = 3dfb3632-14cc-4007-8506-f2c5274cc327
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:3dfb3632-14cc-4007-8506-f2c5274cc327
msgctxt "h37e26536g3196g4ec1gb8cbgdddf58de2bdc"
msgid "Very well. We shan't go back."
msgstr "좋아. 돌아가지 말자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Nightwarden Minthara
#. NodeID = 4031c539-3761-965e-04da-337a3cd31fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:4031c539-3761-965e-04da-337a3cd31fb2
msgctxt "hf7820a0cg7b65g419cgb8c6g3cda1ff2ce0f"
msgid ""
"Good. If we return to the tower entrance and head north, we will find the "
"Risen Road. The way should be clear now that the army has marched."
msgstr "좋아. 탑 입구로 돌아가 북쪽으로 향하면, 치솟은 길이 나올 거야. 군대가 진군했으니 길이 정리되어 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Player
#. NodeID = 442f5d15-349b-8013-3f66-e02f4c19e055
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:442f5d15-349b-8013-3f66-e02f4c19e055
msgctxt "hb6e546adg06c3g443fga015ge1e2d7bc0037"
msgid "I have unfinished business to attend to before dealing with Ketheric."
msgstr "케서릭을 상대하기 전에 처리해야 할 일이 좀 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Nightwarden Minthara
#. NodeID = 87b198d7-8ef8-8fed-9805-0261f5c56a9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:87b198d7-8ef8-8fed-9805-0261f5c56a9b
msgctxt "h1e280f01g45d7g44b6ga571g04266bfe3c8d"
msgid ""
"Our enemies lie to the west, in Baldur's Gate. Do you intend to retreat from "
"them?"
msgstr "우리의 적은 서쪽, 발더스 게이트에 있어. 후퇴할 생각인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Halsin
#. NodeID = a86c8bea-848d-4bb1-a1c1-f118baed0e88
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCL_Event_TravelBackToAct1(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:a86c8bea-848d-4bb1-a1c1-f118baed0e88
msgctxt "h2f62ac51gbb1dg4c24g84e1g7d0b2d9007ed"
msgid ""
"Very well. I shall seek out your camp as soon as you find yourself amidst "
"the curse again."
msgstr "좋네. 자네가 저주 한가운데 다시 뛰어들면 야영지를 찾도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Nightwarden Minthara
#. NodeID = b98169c1-d6b0-48ef-84aa-9b239bc7abfc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCL_Event_TravelBackToAct1(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:b98169c1-d6b0-48ef-84aa-9b239bc7abfc
msgctxt "h7b4ac11bg85eeg4c28gb36cge4ced8575799"
msgid "As you wish. Do not tarry long."
msgstr "바라는 대로. 너무 오래 기다리게 하진 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Player
#. NodeID = bac90a22-e2d6-8a74-f513-5a2a85693602
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:bac90a22-e2d6-8a74-f513-5a2a85693602
msgctxt "h8a22ff4fg9fb4g49c7ga342g27b0af190c5c"
msgid "I have unfinished business to attend to before heading to the city."
msgstr "발더스 게이트로 떠나기 전에 처리해야 할 일이 좀 남았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL
#. Speaker = Halsin
#. NodeID = bfd6cb6e-08ad-4ccd-9f00-6f61f219ded0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Halsin_StayInSCL:bfd6cb6e-08ad-4ccd-9f00-6f61f219ded0
msgctxt "h299b8bfbgff33g41c2g8f5dg5eacfcebfce6"
msgid ""
"Thank you. I would hate to have to flee from the shadow curse once again."
msgstr "고맙네. 또 한 번 그림자 저주로부터 도망쳐야만 하는 상황은 싫으니 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Nightwarden Minthara
#. NodeID = c27d6275-5308-4125-bc57-d5950912ca29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:c27d6275-5308-4125-bc57-d5950912ca29
msgctxt "h072edfcdg8b50g420dgb817g332c0863f2e0"
msgid "Good. We must press onwards."
msgstr "좋아. 이대로 계속 앞으로 나아가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Nightwarden Minthara
#. NodeID = f1257780-ea4f-6086-d814-5c6aa6ddf17b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCL_Event_TravelBackToAct1(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:f1257780-ea4f-6086-d814-5c6aa6ddf17b
msgctxt "ha8132619g6875g4ac0g8c22gaf400a6d649f"
msgid ""
"I do not - I will return to camp and plan for the journey ahead. Find me "
"there when you are ready."
msgstr "난 아니야. 그럼 난 야영지로 돌아가서 앞으로의 계획을 짤게. 준비되면 날 찾아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL
#. Speaker = Player
#. NodeID = fa03ad86-a353-331f-ba16-a29ba864992b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Minthara_StayInSCL:fa03ad86-a353-331f-ba16-a29ba864992b
msgctxt "h2b4a1559ga595g4ba1gbb29g42c072761ba9"
msgid "No. Let's move on to the city."
msgstr "아니. 발더스 게이트로 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "hbffc0ae5g7bacg4eeagb213g4b03e4233931"
msgid ""
"This battlefield must've ran slick with blood - I can taste it in the air, "
"even after so long."
msgstr "이 전장에선 수많은 피가 흩뿌려졌나 보네. 긴 시간이 지났음에도, 공기 중에 피 냄새가 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h793d6cf7gdfb7g4366g8437gac889ebff1df"
msgid ""
"There was a great battle here. The ground stained red with blood long dried."
msgstr "이곳에서 큰 전투가 벌어졌군. 땅에 넘치던 피가 오랜 시간 지나 말라붙었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h10410b34gba4dg4407g80c6gd0c2426b6599"
msgid ""
"The site of no ordinary skirmish. This was once a battlefield, and a bloody "
"one too, judging by the number of bodies."
msgstr "평범한 접전이 아니었군. 수많은 시체들을 보아, 피비린내 나는 대규모 전투가 벌어진 곳 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h98f0c70dg8158g4cd3g9dfdg16afb30482d4"
msgid ""
"These aren't the remains of some skirmish - whole armies clashed here once."
msgstr "이건 단순한 전투의 흔적이 아냐. 양측 군대가 대규모로 격전을 펼쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h690dc9b5g886bg4d56g81f4g5fba85c093bf"
msgid ""
"A great battle was fought here - I can practically hear the din of blade "
"against blade, axe against shield."
msgstr "엄청난 전투가 여기서 벌어졌군. 칼과 칼이 서로 부딪히는 소리가, 도끼가 방패에 박히는 소리가 들릴 정도야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "hbe215558gb144g4293g9ee4g41003bfee130"
msgid "This is a battlefield. An old one, but still."
msgstr "여긴 전쟁터야. 오래 전 일이긴 하지만, 아무튼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h28a269fdge1c1g4eaaga315g94a4253507e8"
msgid ""
"Forces from the Emerald Grove. Many stood against Ketheric - only we lucky "
"few survived him."
msgstr "에메랄드 숲의 세력이었어. 많은 이들이 케서릭에 맞서 싸웠지만, 극소수만이 살아남았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h4e60acecg8f5fg4da4g862dga644cf09a0da"
msgid ""
"A great many druids once stood here to fight Ketheric Thorm. Few ever left."
msgstr "한때 수많은 드루이드들이 이곳에서 케서릭 쏨에 맞섰지. 극소수만이 살아남았다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h2b8c55e7gc2aeg450fgbc52g8b3fa50b69d9"
msgid "Remains of those who stood against Ketheric in the past."
msgstr "과거 케서릭에 맞서 싸웠던 이들의 흔적이로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids
#. Speaker = Player
#. NodeID = f6401516-0540-442b-b6b9-16d754e2b6a1
#. HandlePath = TaggedText[9].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_DeadDruids:f6401516-0540-442b-b6b9-16d754e2b6a1
msgctxt "h4c4fa3d9g4679g4f85g9868g07c157cfdfc8"
msgid "There was a battle here once - a large one."
msgstr "여기서 전투가 벌어졌었군. 아주 큰 전투가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "haeea7356g6259g468bgbdaeg85b260080a27"
msgid ""
"Rather a rustic burial - but I suppose it's better than no burial at all."
msgstr "어지간히 촌스러운 매장법이지만, 아예 묻히지 않는 것보단 낫겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "h4e63a07bgbf74g4766g9927gac7cd7358333"
msgid ""
"It is good to see the fallen buried well. Especially in this cursed land."
msgstr "쓰러진 자들이 제대로 묻혀 있어 다행이군. 특히 이 저주받은 땅에서는 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "h42f45926g7ff3g4cf5gad4bgb09a781dc5eb"
msgid ""
"A hasty burial is still a burial. A small mercy, but one these fallen would "
"have been grateful for."
msgstr "급하게 매장됐지만 그럭저럭 모습은 갖췄군. 보잘것없는 배려긴 해도 죽은 자들은 감사히 여길 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "h33c14bcfgc9a5g4d1cgba69g35319e7c0752"
msgid "Hastily buried - but at least they <i>were </i>buried, I suppose."
msgstr "급하게 매장되긴 했지만, 그래도 <i>묻어 준</i> 게 어디겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "hcb816a70gb319g42fagba4dgbaeef804db9b"
msgid "Victims of the curse. At least they were granted a proper burial."
msgstr "저주에 희생당한 자들이로군. 그래도 적절한 대우를 받아 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "h51e6ddb2g267dg4853g9fd9g3b137b990bf0"
msgid "Glad to see someone in this place got a proper burial."
msgstr "이런 장소에서조차 누군가 제대로 묻힌 모습을 보니 마음이 놓여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "h0ce10550g87a4g4fe5gbb34gde94b1a502fa"
msgid ""
"We laid what Harpers we could to rest in this place - before the shadows "
"fell."
msgstr "우린 이곳에 하퍼들이 쉴 수 있는 장소를 만들었지. 그림자가 드리우기 전에 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "ha1a23c79gf9c6g4cdbg8156g2471cfb5cb3d"
msgid "At least the shadow curse was not allowed to claim these dead."
msgstr "그림자 저주가 적어도 이들에게만은 마수를 뻗치지 못한 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "h235c2debg4dfag4ce9g9eeeg0fcbcfb3b0a4"
msgid ""
"Undisturbed graves. A rare sight in these lands, where the dead are so "
"restless."
msgstr "불청객 없는 무덤이라. 죽은 자들이 불안에 떠는 이 땅에서는 보기 드문 광경이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "hba0f8cf8ge88ag4278ga42bg533e6d43cf8f"
msgid ""
"The Gate was my hunting ground. I might be responsible for some of these."
msgstr "발더스 게이트는 내 사냥터였지. 이들 가운데 몇몇은 내 책임일지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = 90f6d5f7-5c96-470a-85dc-5adbc6832e1a
#. HandlePath = TaggedText[10].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:90f6d5f7-5c96-470a-85dc-5adbc6832e1a
msgctxt "h6f551898g5936g4437gb707g7c709e66208b"
msgid "Victims of the shadow curse. At least they were afforded a burial."
msgstr "그림자 저주에 희생당한 자들이다. 적어도 그들은 적절한 대우를 받았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "h10f8209dgbedcg4538g96cbg6a2e07d76afd"
msgid ""
"Rather a rustic burial - but I suppose it's better than no burial at all."
msgstr "매장을 꽤나 서두른 모양이군. 아예 안 한 것 보다는 나으려나. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "he100a20agcf6dg45fegbc3dg0442edf6db6d"
msgid ""
"It is good to see the fallen buried well. Especially in this cursed land."
msgstr "쓰러진 자들이 제대로 묻혀 있어 다행이군. 특히 이 저주받은 땅에서는 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "h3c67c21bg58a1g41a0gb41cgb704af5c3a7c"
msgid ""
"A hasty burial is still a burial. A small mercy, but one these fallen would "
"have been grateful for."
msgstr "급하게 했다고 해서 매장이 아닌 건 아니지. 작은 배려긴 해도 죽은 자들은 감사히 여길 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "h6cd865e7g93ccg457dg8017gff975f17b480"
msgid "Hastily buried - but at least they <i>were </i>buried, I suppose."
msgstr "급하게 매장됐군. 어쨌든 묻히긴 <i>했으니</i> 그걸로 된 걸까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "h693fa0f5g1d79g4123gbcafg4df33b10a73a"
msgid "Victims of the curse. At least they were granted a proper burial."
msgstr "저주에 희생당한 자들이로군. 그래도 적절한 대우를 받아 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "h59a04b56g2f02g4d2dg8778g93bb0203b1ed"
msgid "Glad to see someone in this place got a proper burial."
msgstr "이런 곳에서 누군가 제대로 묻힌 걸 보게 되다니 좋군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "h52526f79g6d19g4c5dgb8f0g7e89e38c03cf"
msgid ""
"We laid what Harpers we could to rest in this place - before the shadows "
"fell."
msgstr "우린 이곳에 하퍼들이 쉴 수 있는 장소를 만들었지. 그림자가 드리우기 전에 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "he73a9f9aga79fg4402g9a50gbc79c0ab3189"
msgid "At least the shadow curse was not allowed to claim these dead."
msgstr "그림자 저주가 적어도 이들에게만은 마수를 뻗치지 못한 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "ha05fdbe0g3935g4798gb31cgdb3ac0063f0c"
msgid ""
"Undisturbed graves. A rare sight in these lands, where the dead are so "
"restless."
msgstr "멀쩡한 무덤이라. 죽은 자들조차 쉬지 못하는 이 곳에서는 보기 드문 광경이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard
#. Speaker = Player
#. NodeID = da8801e4-4b17-9330-cbda-798ab557fbf3
#. HandlePath = TaggedText[9].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_Graveyard:da8801e4-4b17-9330-cbda-798ab557fbf3
msgctxt "hce2a7721g3ce0g4f92ga1ffg0149d1c88d64"
msgid "Victims of the shadow curse. At least they were afforded a burial."
msgstr "그림자 저주에 희생당한 자들이야. 적어도 매장은 해줬군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "hef417935g46c2g4551g8204g7405794f0176"
msgid "A curse that desecrates the ground itself? Almost impressive."
msgstr "땅 자체를 모독하는 저주라고? 그것 참 인상적인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "hd24286b2gc30cg4e0agb97eg3918183aedac"
msgid "How can a curse wear away the very ground?"
msgstr "땅 자체를 시들게 만드는 저주라니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "heedaad53g415bg42a5gbe5bg6588ab8182c4"
msgid ""
"The very plates of the earth have been shattered by the magic of the shadow "
"curse. Utterly fascinating - unless you happened to be standing on it, of "
"course."
msgstr ""
"대지 자체가 그림자 저주의 마법으로 인해 산산이 부서졌어. 대단히 흥미롭군. 물론 그 위에 서 있어야 하는 경우라면 얘기가 다르겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "h9716639eg18b4g4395gb980g97b385185e66"
msgid "The shadows have upended the ground itself. Such power..."
msgstr "그림자가 땅 그 자체를 뒤집어 놓았군. 대단한 힘이야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "hb210eb43gc6a5g4c16g9d8dg2bf65654a38c"
msgid ""
"Hells. Is the curse so powerful that it can rip apart the earth beneath it?"
msgstr "세상에. 저주가 얼마나 강력하기에 저 아래 대지마저 갈라놓는단 말인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "h10361c2fg904bg4997g82fagc092f522d58b"
msgid "Even the ground's been ground away. How?"
msgstr "말 그대로 땅이 꺼져버렸네. 대체 어떻게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "h5d2a5776g4239g4c78g8829g99b25f5ed52d"
msgid ""
"The curse did not stop at ground level. It pierced the very skin of the "
"earth."
msgstr "저주는 지표면에서 그치지 않았네. 대지의 살갗을 꿰뚫어 버렸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "ha1c99ea6gc99cg4b15g9bbagffe40950c8e3"
msgid "Silvanus guard us - the curse has churned up the very land itself..."
msgstr "실바누스께서 굽어살피시길. 저주가 대지 그 자체를 뒤틀어버렸군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "h392fa754g3e09g4889g9039g8438299f8d21"
msgid "The curse caused the ground to give way... such power."
msgstr "저주로 인해 땅마저 그 기운을 잃었군... 대단한 힘이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation
#. Speaker = Player
#. NodeID = 02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
#. HandlePath = TaggedText[9].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Misc_PAD_ShadowlandDevastation:02e43d79-03c0-4aa8-adfe-aa21d7a6ac03
msgctxt "h05c1af1bg4b6fg4e53gb71egeb6d5caee002"
msgid "Hells. The curse has torn open the ground itself..."
msgstr "젠장. 저주가 지반까지 갈라놓고 말았군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MonkAmulet_AD_ShadowlandsComment
#. Speaker = Sentient Amulet
#. NodeID = 2f9d3aba-ce68-edd8-c817-6ead9e4a4fe3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_MonkAmulet_AD_ShadowlandsComment:2f9d3aba-ce68-edd8-c817-6ead9e4a4fe3
msgctxt "h432a7d49g3dd6g47f6ga40egfd261e8abacd"
msgid ""
"Darkness. Desolation. The Dark Lady's hand at work, mayhaps? HahaHA-HEE!"
msgstr "암흑. 황폐. 어둠의 여신의 작품이 아니신지? 하!하하!-히!!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = 33b6c56f-e765-443a-a0e5-c606eb44c151
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = True
#.   Local:
#.      - 8baf8087-81b0-de5d-3efa-f74769a625f4_A = True
#. SetFlags:
#.   Local:
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:33b6c56f-e765-443a-a0e5-c606eb44c151
msgctxt "h066e0ae8gf997g4d1fga355g96bdd3ac933c"
msgid "You were good. But just you wait - I'll get <i>better</i>."
msgstr "잘하던데. 그치만 두고봐. 내가 더 <i>잘해질</i> 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = 349a2558-6006-40b4-ae07-2cb873e72325
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = True
#.   Local:
#.      - 8baf8087-81b0-de5d-3efa-f74769a625f4_B = True
#. SetFlags:
#.   Local:
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:349a2558-6006-40b4-ae07-2cb873e72325
msgctxt "h243cbe8dg1dd1g444agbc5cg227192d4118e"
msgid "I didn't think anyone would ever actually find me..."
msgstr "그 누구도 날 찾지 못할 거라고 생각했는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = 370f9924-12f6-e212-1f5d-ff950c91a504
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = False
#.   Local:
#.      - 8baf8087-81b0-de5d-3efa-f74769a625f4_B = True
#. SetFlags:
#.   Local:
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:370f9924-12f6-e212-1f5d-ff950c91a504
msgctxt "hc2b92a4egf676g428bgb5edg4f3c47536386"
msgid "You need <i>a lot</i> more practice before you can beat me."
msgstr "날 이기려면 <i>훨씬 더</i> 연습을 많이 해야 할 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = 3c10e2b9-2fd5-3b0a-4404-02e1769e0f25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = False
#.   Local:
#.      - 8baf8087-81b0-de5d-3efa-f74769a625f4_A = True
#. SetFlags:
#.   Local:
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:3c10e2b9-2fd5-3b0a-4404-02e1769e0f25
msgctxt "hbed83568gfaccg46bdgaddcg0b94339789cc"
msgid "I win, again. I <i>always </i>win."
msgstr "또 이겼다. 난 <i>항상</i> 이기거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = 52e4abc3-9abf-6a9a-924c-5761255ae56a
