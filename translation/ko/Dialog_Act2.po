msgctxt "h8fc9d655g6bbeg42e4g8582ge547f56600c3"
msgid "Decapitated - but still warm."
msgstr "목이 잘렸지만 온기가 남아 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act3/Wyrm/WYR_SmugglersCave_PAD_FoundDeadBody
#. Speaker = Player
#. NodeID = d4ff4f7b-6fb2-d712-d841-140587106d35
