#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes:b4a6f24a-7619-4c1d-88f9-765086aa7ae6
msgctxt "hfefd7655g0c3bg417bg91fbg76f53fb9cee8"
msgid "That thing's not going to hold together much longer."
msgstr "이거 얼마 못 버틸 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes
#. Speaker = Gale
#. NodeID = b66dce12-54dc-49ae-9349-c50ef18e6cf0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes:b66dce12-54dc-49ae-9349-c50ef18e6cf0
msgctxt "h8702bb0ag1666g42dbga09dg9f33d4e41014"
msgid "That orb's about to explode - and I speak from some experience."
msgstr "내 경험으로 말하자면, 보주가 곧 폭발할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes
#. Speaker = Astarion
#. NodeID = fe310448-0c48-4251-ba5f-337fc3b856ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes:fe310448-0c48-4251-ba5f-337fc3b856ee
msgctxt "hd49986a8gc223g4a19gb128g4949db5ceeee"
msgid "That orb's going to blow - and soon."
msgstr "보주가 폭발할 거야. 조만간 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes
#. Speaker = Halsin
#. NodeID = ff695a9b-c652-420d-9b98-3bf6366c0c35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_HALSIN(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes:ff695a9b-c652-420d-9b98-3bf6366c0c35
msgctxt "ha77b9ef1g0cfbg4884gbed9g50e505073033"
msgid "Silvanus preserve us - that orb's about to shatter!"
msgstr "실바누스가 우릴 가호 하시길, 저 보주가 곧 깨질 걸세!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "h3e496ea0g4bc8g4ee4g8b31gb43b3a8d1349"
msgid "I can't hurt him. How disappointing."
msgstr "티끌도 다치게 할 수 없다니. 이 것 참 아쉽네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "ha7376dbfgfa35g4b35gabfag00396513c9ef"
msgid "It's no use. The prince is unreachable."
msgstr "무의미 하다. 왕자에게 접근할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "h163309fcgdc53g4982gac68g2f0e01f129c1"
msgid "Those chains don't just bind him - they protect him. He's invulnerable."
msgstr "사슬이 왕자를 구속할 뿐만 아니라 보호하고 있기도 해. 무적인 셈이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "hcbb5e778g4821g46e8ga607g4c2c8d26f7c2"
msgid "It's no use. He's beyond reach, for now."
msgstr "무의미 한 짓이야. 당장은 어쩔 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "h9ecc15a4g96a3g4b74g9760gdb4625972129"
msgid "Forget it. We won't make so much as a dent."
msgstr "흠집도 낼 수 없을 거야. 그냥 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "h2bb13f6agb135g45bbg80b1g410872bcb71c"
msgid "It's no use. He's invulnerable."
msgstr "쓸모 없는 짓이야. 안 통한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "h462cf539gb283g412bgad00g782823fa11a9"
msgid "Pointless. That which binds him protects him, too."
msgstr "구속구가 보호구이기도 해. 무의미한 짓이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "hcfbc6178g0da1g48dcg9197g05e2f6637b9b"
msgid "No use. He cannot be harmed, or freed."
msgstr "왕자는 해방 될 수도 없고 해를 입을 수도 없네, 소용 없는 짓이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus
#. Speaker = Player
#. NodeID = 0d99a73d-7a06-4ae0-b621-c2842dcedce2
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_AttemptToAttackOrpheus:0d99a73d-7a06-4ae0-b621-c2842dcedce2
msgctxt "h8774123cg7285g4312g8e06g80daaa54ed06"
msgid "It's no use. Can't reach him like this."
msgstr "소용없어. 이렇게는 통하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_FirstTimeInAstralPrison
#. Speaker = Player
#. NodeID = 26d4446d-41b4-42aa-92e7-ec24ed6d6b74
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_FirstTimeInAstralPrison:26d4446d-41b4-42aa-92e7-ec24ed6d6b74
msgctxt "h6cf6b935g0ad8g4b09gbaaaga34552ebbffe"
msgid "Where's our dream guardian?"
msgstr "우리 꿈 수호자는 어디에 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_FirstTimeInAstralPrison
#. Speaker = Player
#. NodeID = 26d4446d-41b4-42aa-92e7-ec24ed6d6b74
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_FirstTimeInAstralPrison:26d4446d-41b4-42aa-92e7-ec24ed6d6b74
msgctxt "h12a613f0gecc8g46d6gb8ecg14eeaf9e7ee7"
msgid "Where's our dream guardian?"
msgstr "우리 꿈 수호자는 어디에 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_FirstTimeInAstralPrison
#. Speaker = Player
#. NodeID = 26d4446d-41b4-42aa-92e7-ec24ed6d6b74
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_FirstTimeInAstralPrison:26d4446d-41b4-42aa-92e7-ec24ed6d6b74
