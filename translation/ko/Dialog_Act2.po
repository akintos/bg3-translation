msgctxt "h25321490g9cbbg4313ga8feg9c86363036db"
msgid "I thought we were safe here. More fool me."
msgstr "이곳은 안전할 줄 알았는데. 어리석었군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_003
