#.     - e96d7fc6-1b8c-da21-4777-4f1471441ed3_OneDrinkServed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:e87c776c-4afe-fafe-ab3f-1b8d8140b510
msgctxt "h4b48353cge7abg4504g9308g6a178eca924b"
msgid "<i>Mime drinking.</i>"
msgstr "<i>마시는 척 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = ea916421-5f93-dbc8-e308-88bb7b1ad371
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Constitution
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Local:
#.     - e96d7fc6-1b8c-da21-4777-4f1471441ed3_TwoDrinksServed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:ea916421-5f93-dbc8-e308-88bb7b1ad371
msgctxt "h3524eee9g728bg4d62g89f5gfb97484d791d"
msgid "<i>AGAIN! DRINK!</i>"
msgstr "<b><i>한 잔 더! 마시자!</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = eaa0e581-d4bd-2496-75e4-eb1e184c66ca
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#.      - GLO_Hag_Knows_HagIsHag = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:eaa0e581-d4bd-2496-75e4-eb1e184c66ca
msgctxt "h8eed2b8cg3a3ag4279g962bga756c2e30c1e"
msgid "I slayed a hideous, pustule-ridden hag. She died a gruesome death."
msgstr "고름이 들끓는 흉측한 해그를 죽였던 적이 있어. 아주 고통스럽게 죽었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = ec80068f-3f7e-a6f7-f934-6886ae5ee1d0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Constitution
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Local:
#.     - e96d7fc6-1b8c-da21-4777-4f1471441ed3_OneDrinkServed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:ec80068f-3f7e-a6f7-f934-6886ae5ee1d0
msgctxt "h6f7a13d2gba1dg44e1gbc87g329c70ca86d6"
msgid "<i>CHUG THE BEER.</i>"
msgstr "<i><b>맥주를 단숨에 들이마신다.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Thisobald Thorm
#. NodeID = ee941bcb-b080-3c5f-ef56-fb8459d35575
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Distillery_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:ee941bcb-b080-3c5f-ef56-fb8459d35575
msgctxt "h583ee066g77fag4c8egbf98g49b124a19d45"
msgid "You. Will. Regret."
msgstr "너. 후회. 할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Thisobald Thorm
#. NodeID = f0a1195c-a420-416b-d15f-0f53c1e5adfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f0a1195c-a420-416b-d15f-0f53c1e5adfe
msgctxt "h67f33143g4f30g4dcagb66dg51c1226b7b43"
msgid "The customer is always right but also <b>wrong</b>."
msgstr "손님은 항상 옳지만 <b>잘못</b>도 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Narrator
#. NodeID = f1c31460-d80d-0cb4-b26a-929819429878
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e96d7fc6-1b8c-da21-4777-4f1471441ed3_Drinkonce = True
#. SetFlags:
#.   Local:
#.     - e96d7fc6-1b8c-da21-4777-4f1471441ed3_Drinktwice = True
#.   Object:
#.     - TWN_Distillery_Event_DrankTwice(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f1c31460-d80d-0cb4-b26a-929819429878
msgctxt "h56e8240aga88eg43b5ga77agefd7d6e4ef77"
msgid ""
"*The second drink hits you even harder. Nausea overwhelms you and it takes "
"dire effort not to throw up all over the floor.*"
msgstr "*두 번째 잔은 더 강하게 느껴집니다. 메스꺼움에 압도당하고 바닥에 토하지 않도록 안간힘을 써야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = f2363fe8-d7f9-6d00-6e29-e06010c0452f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f2363fe8-d7f9-6d00-6e29-e06010c0452f
msgctxt "hdc2a7fe7g92e0g4d4dg9482g6617967912a6"
msgid "From aboard a mind flayer vessel, I've witnessed the Hells themselves."
msgstr "마인드 플레이어 함선에 승선해 있을 때, 지옥 그 자체를 목도했었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Thisobald Thorm
#. NodeID = f23894f6-dee3-609f-ce6c-2d8de3282722
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TWN_Distillery_State_PassedDrinkingCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f23894f6-dee3-609f-ce6c-2d8de3282722
msgctxt "h0f1f5c9cg0650g4602g993egfcdb9f789838"
msgid "I - I know you. I knew, I know, I am knowing."
msgstr "나, 나 널 알고 있어. 알고 있었지, 알고 있고, 알아갈 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = f26e4098-f00e-6d86-536e-0c40a439ec84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f26e4098-f00e-6d86-536e-0c40a439ec84
msgctxt "h5db32c82g543bg4ea5g9126g0b24f76c9422"
msgid "What in all Nine Hells are you?"
msgstr "아홉 지옥 맙소사, 넌 대체 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Thisobald Thorm
#. NodeID = f2f95f04-6f10-98c9-c8f4-2b0646f890e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f2f95f04-6f10-98c9-c8f4-2b0646f890e4
msgctxt "h0c13a397gfb0cg40afg920cg4bd06fd18e41"
msgid ""
"Go on. Drink, make it drank, be <b>drunk</b>. You and I both, to our <b>good "
"health</b>."
msgstr "자. 마셔, 더 마시고, <b>취하자</b>. 우리 둘 모두의, <b>건강</b>을 위하여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = f4925603-e708-bcc4-31ac-44eca131e407
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Global:
#.      - UND_Bulette_State_HasBeenPermaDefeated = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f4925603-e708-bcc4-31ac-44eca131e407
msgctxt "h61099424g7ac3g4d58gb63dg4ac3f27f810e"
msgid "A bulette made me its prey, but proved no match for me."
msgstr "불레트 한 마리가 날 먹이로 삼으려 했지만, 내 상대가 안 되더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Lae'zel
#. NodeID = f51745a9-d227-4407-8e7b-e730b7c655aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f51745a9-d227-4407-8e7b-e730b7c655aa
msgctxt "hba26167fgf72dg4e1egbbb1g7bf72c91d6ec"
msgid "Hells. The curse has twisted this man beyond measure..."
msgstr "젠장. 저주가 이 남자를 한없이 비틀어 놓았군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Karlach
#. NodeID = f5d994af-70a5-3d80-2ebf-ac1474cf0150
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f5d994af-70a5-3d80-2ebf-ac1474cf0150
msgctxt "h92b94b9agfd4fg4b62g86fdg8f0acaa0e22a"
msgid "Ew, gods, I do not want whatever's inside that guy all over me."
msgstr "으, 망할, 저 남자 안에 있는 게 뭐든지 내 위로는 안 쏟아졌으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Thisobald Thorm
#. NodeID = f6e6022b-ad4c-1e8a-559f-43cf96a981ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f6e6022b-ad4c-1e8a-559f-43cf96a981ad
msgctxt "h4f34e8a5g65d3g413bgb0a5g28ffc9e865f7"
msgid "Father Ketheric's laughter. Not joy, not ever-never. Only laughter."
msgstr "아버지 케서릭의 웃음거리. 자랑거리 아니다. 절대-결코 아니다. 단지 웃음거리다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = f7d0cd26-2048-c612-d5c0-f2be2882de2b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f7d0cd26-2048-c612-d5c0-f2be2882de2b
msgctxt "h62af2abfgc5ddg4e7dg9ac1gacaabdae2772"
msgid ""
"I made a deal with a creature of purest sin and took its power as my own."
msgstr "가장 순수한 죄를 지닌 생물과 계약을 맺어 그 힘을 내 것으로 삼았었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = f7d0cd26-2048-c612-d5c0-f2be2882de2b
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f7d0cd26-2048-c612-d5c0-f2be2882de2b
msgctxt "h48f89c56g2a08g48c8ga2bfgc17c0345dd47"
msgid "I gained the faerie favour of a creature from another plane."
msgstr "다른 차원의 존재로부터 요정의 조력을 얻어냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = f7d0cd26-2048-c612-d5c0-f2be2882de2b
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:f7d0cd26-2048-c612-d5c0-f2be2882de2b
msgctxt "h9c41739bg037cg49cegb175g17f73ea4c7a0"
msgid "I am the favoured vessel of an unknowably ancient creature."
msgstr "나는 알려지지 않은 고대의 존재의 총애를 받은 그릇이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = fa56e9d3-3bb2-6080-6db6-10f78dceb306
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_State_GolemPermaDefeated = True
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:fa56e9d3-3bb2-6080-6db6-10f78dceb306
msgctxt "h208e4dd1gb252g4a3bg96d6g3e9d83fc25c5"
msgid ""
"A towering creature rose from molten lava. I felled it with great wit and "
"might."
msgstr "우뚝 솟은 괴물이 들끓는 용암에서 솟구쳐 올랐지. 놈을 무시무시한 재치와 힘으로 쓰러뜨렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Shadowheart
#. NodeID = fae18852-7fa0-936a-fc23-2077eb2b0821
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:fae18852-7fa0-936a-fc23-2077eb2b0821
msgctxt "h56b03d96g58bag486fg9ac2gf170cabd96b4"
msgid ""
"He looks set to burst - and we'll probably be left hip-deep in his juices."
msgstr "곧 터질 것처럼 보이네. 그리고 우린 저 남자의 즙에 엉덩이까지 빠지겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Thisobald Thorm
#. NodeID = fc947dce-99f4-e190-9db2-0ba529b17487
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:fc947dce-99f4-e190-9db2-0ba529b17487
msgctxt "h421e211dg3202g450dg8f12gb3a943d8f712"
msgid "Now drink it deep."
msgstr "이제 한 잔 쭉 들이켜라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Narrator
#. NodeID = fd6559f0-d4c9-b5d0-67bb-e58a53efd0b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e96d7fc6-1b8c-da21-4777-4f1471441ed3_OneDrinkServed = True
#.   Object:
#.     - TWN_Distillery_State_DrankBrewersPoisonAndSucceededOnSave(1) = True
#.     - TWN_Distillery_State_DrankBrewersPoison(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:fd6559f0-d4c9-b5d0-67bb-e58a53efd0b5
msgctxt "h3eaf522eg4c32g48f5gbe4dga2c8a304e6e2"
msgid ""
"*Each swig is as painful as the last, but you remain in otherwise sound mind "
"and body.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Player
#. NodeID = fd9b87cd-cb4e-9bb1-1eac-9a6adbb5db1d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = False
#. SetFlags:
#.   Object:
#.     - TWN_Distillery_State_TriedFakingDrinking(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:fd9b87cd-cb4e-9bb1-1eac-9a6adbb5db1d
msgctxt "h3b9a4a61g23dag4ad9g8106ga15b4c9b58b0"
msgid "<i>Mime drinking.</i>"
msgstr "<i>마시는 척한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer
#. Speaker = Thisobald Thorm
#. NodeID = ff03869f-f7e0-6502-c507-715aa779540a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer:ff03869f-f7e0-6502-c507-715aa779540a
msgctxt "h8e5e6f21gd9c1g4dcbg9196ga1d3afb134a7"
msgid ""
"How I long for a <b>feast</b>. Eating, filling, gorging. Oh, to dine with "
"devils!"
msgstr "정말 <b>연회</b>에 가고 싶군. 먹고, 채우고, 게걸스레 먹고. 아, 데빌과 만찬을 든다면!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Blighted Barman
#. NodeID = 083d3c5f-421b-4f3c-954f-52d2d8753379
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Distillery_HasMet_Zombie_01(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_Distillery_HasMet_Zombie_01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:083d3c5f-421b-4f3c-954f-52d2d8753379
msgctxt "h95c4ed0bg1009g46e2gae07g89fc270bc0d8"
msgid ""
"Haul yourself up chum, and let the old whiskey jug b-b-bite you. So what'll "
"it be?"
msgstr "친구, 와서 한 잔 하세요. 토-토-톡 쏘는 오래된 위스키 좀 마셔보세요. 그럼 무엇을 드릴까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Blighted Barman
#. NodeID = 0d726cca-1077-a5a5-ef4e-e9032bd81298
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:0d726cca-1077-a5a5-ef4e-e9032bd81298
msgctxt "hdb3460fag7a24g48d1g9811g23ba35d19246"
msgid "Ch-chum yourself up, and whisk the old luggy j-jug bug you. So be what?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Blighted Barman
#. NodeID = 0f9b0223-10cc-f118-3121-8fb488aeebff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:0f9b0223-10cc-f118-3121-8fb488aeebff
msgctxt "hf693b981g19a4g4b80ga697g1d16c72cc1f4"
msgid ""
"M-moon Mountain Dark, coming righ-righ-right up. A man of proper t-taste!"
msgstr "무-문 마운틴 다크, 바로 대령하겠습니다. 취향이 제대로시군요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 1009bbed-a413-5c18-e21b-e8ead0336233
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:1009bbed-a413-5c18-e21b-e8ead0336233
msgctxt "hda48656bg4ec1g4802g88a5g664fc6cf23bb"
msgid "Nothing for me, thanks."
msgstr "고맙지만 난 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Blighted Barman
#. NodeID = 17f13373-5e9c-60f3-e126-de4f7defb59f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Distillery_HasMet_Zombie_01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:17f13373-5e9c-60f3-e126-de4f7defb59f
msgctxt "h5799c046g4718g407fg9e7cgbba0ee36d218"
msgid "Dark Mountain Right, moonin' come up. Proper t-taste m-man!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 238bfd25-5b65-bfb1-4bfa-d7f96afcb971
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Distillery_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:238bfd25-5b65-bfb1-4bfa-d7f96afcb971
msgctxt "h6d8540bbg863eg41e4g92ccg68b29165551f"
msgid "'Be will it what'? What are you saying?"
msgstr "'뭐가 될까요'라니? 무슨 소리야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 2bc6ac00-5d0b-4f65-2592-c30a6c961369
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Distillery_State_PeacefulResolution = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:2bc6ac00-5d0b-4f65-2592-c30a6c961369
msgctxt "hf7771df8gb010g44fegbddag90f65a763b37"
msgid "Who's the bloated carcass behind the bar?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Karlach
#. NodeID = 360c9c13-9a39-4715-aa6c-6407aa35b0f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:360c9c13-9a39-4715-aa6c-6407aa35b0f6
msgctxt "hfdf5cb01gf6d8g4b14ga68ag6cc5db1b26c9"
msgid "So be what indeed, my friend. So be what indeed."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Lae'zel
#. NodeID = 4940329c-6b96-4bec-8c97-783b3246880c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:4940329c-6b96-4bec-8c97-783b3246880c
msgctxt "hff74809agecd6g4574g8538g64fb30df9e13"
msgid ""
"<i>Chk. </i>The curse has left him with as much sense as a newborn slug."
msgstr "<i>츠크. </i>그림자 저주가 놈에게 민달팽이만큼의 지능밖에 남겨놓지 않은 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 53c8e9b5-d954-e92e-800a-694de3af97ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:53c8e9b5-d954-e92e-800a-694de3af97ca
msgctxt "h5d41ca82gf07dg4ef9gb0dag7ac140745c2d"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Blighted Barman
#. NodeID = 5c1325dd-d980-f6c4-6940-fc2beaf56e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:5c1325dd-d980-f6c4-6940-fc2beaf56e70
msgctxt "h114695cage291g42feg8556g16202411e27c"
msgid "Now settle your mind, chum, and get your shine on. Be will it what?"
msgstr "친구, 마음 가라앉히시고, 눈감아 주세요. 뭐가 될까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Wyll
#. NodeID = 5e63d056-7bb9-45b7-94fa-c2836468405c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:5e63d056-7bb9-45b7-94fa-c2836468405c
msgctxt "h94130205g152ag4604g884cg49ae905c8c33"
msgid "I'd say you broke the poor fellow, but I wager he came that way."
msgstr "네가 저 불쌍한 녀석을 망가뜨렸다고 하고 싶지만, 분명 저 녀석은 늘 이랬겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 691898fd-247c-56d6-993b-54d3bdc0fd54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:691898fd-247c-56d6-993b-54d3bdc0fd54
msgctxt "hcb3de34ag88e5g4fcbg881eg9ab02fa6b3a0"
msgid "I didn't order anything."
msgstr "난 주문한 적 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Shadowheart
#. NodeID = 6926ab01-dd3f-4f75-8f0f-224b23d1997f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:6926ab01-dd3f-4f75-8f0f-224b23d1997f
msgctxt "h866636f3gdc6cg4aecgb27eg26724df87b33"
msgid ""
"I think your witty remarks were too much for him - he's a blubbering wreck."
msgstr "네 재치 있는 입담이 그에게는 과했나 봐. 완전 울고 있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 73ce1c3f-ecef-9f6a-3c89-19257b6aa67a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Distillery_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:73ce1c3f-ecef-9f6a-3c89-19257b6aa67a
msgctxt "h817db844g42e1g4f43ga2b4g1e883f78c969"
msgid "Judging by the mess, I doubt there's much drink left."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Blighted Barman
#. NodeID = 74c96e41-d1ae-ce90-7501-23d5305033f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Distillery_HasMet_Zombie_01(1) = True
#.   Global:
#.      - TWN_Distillery_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:74c96e41-d1ae-ce90-7501-23d5305033f9
msgctxt "h46dcaa43g6062g4e2bg9c8dga8ae31d7a655"
msgid ""
"Thisobald, you say? Indisposed, apologies is the master distiller "
"c-currently."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Blighted Barman
#. NodeID = 77e58bd2-b0b3-0ec8-f212-996aa35e5e0a
