msgctxt "h60ad3486gec32g4d26ga581gdfe737598b59"
msgid "I will!"
msgstr "당연하지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
#. Speaker = Mirkon
#. NodeID = 1682b48f-168f-4c61-af80-7b28678efae0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HarperGuard_002_AD_WithMirkon:1682b48f-168f-4c61-af80-7b28678efae0
msgctxt "h7dbf61dfg51d5g4cfbg8b51g21ddaa79a755"
msgid "I haven't found anything yet, but I will! I can feel it."
msgstr "아직 아무것도 못 찾았지만, 곧 찾을 수 있을 거야! 느낌이 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
#. Speaker = Harper Bor
#. NodeID = 1e9dfa4a-3a6f-785f-5028-af1def263a92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HarperGuard_002_AD_WithMirkon:1e9dfa4a-3a6f-785f-5028-af1def263a92
msgctxt "h437e6d62gfea2g4398g91a9gc405bd092ad3"
msgid "Heh. I promise, kid."
msgstr "하! 약속하마, 꼬마야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
#. Speaker = Harper Bor
#. NodeID = 3929a933-c661-4a63-8160-3f76bf2f0956
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HarperGuard_002_AD_WithMirkon:3929a933-c661-4a63-8160-3f76bf2f0956
msgctxt "hb22515f3g4af6g4c53g8cfbgb3709180db33"
msgid "No doubt. Just keep your eyes peeled."
msgstr "그렇겠지. 계속 잘 찾아보기나 하라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
#. Speaker = Harper Bor
#. NodeID = 49293c6b-bbe1-d0fc-f41c-49160cce0c38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HarperGuard_002_AD_WithMirkon:49293c6b-bbe1-d0fc-f41c-49160cce0c38
msgctxt "h3891b756g6eb4g48eag85ceg8c9b0628d41e"
msgid "Can't say I have, but if I do, you'll be the first to know."
msgstr "아직 보지는 못했는데, 만약 찾게되면 너한테 제일 먼저 알려주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
