msgctxt "h2dea60fdga48bg4c3agb0bdg59c2b7f05abb"
msgid "<i>What are you doing? Stop!</i>"
msgstr "<i>뭐 하는 건가? 멈춰라!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_EmperorAD_StopHittingMeAfterOrpheus
