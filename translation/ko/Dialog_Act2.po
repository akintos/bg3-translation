msgctxt "h720c5297gbab1g4821g8bbegc3821192bf7d"
msgid "There's something off about your fellow ox over there."
msgstr "네 친구 황소에게 뭔가 이상한 점이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
