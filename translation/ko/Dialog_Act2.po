msgctxt "h3e417b1dgc05dg4c66g87e8g0fb809bb7093"
msgid "Patrols report more activity among the cultists, ma'am."
msgstr "정찰병들이 교단의 움직임이 커지고 있다고 보고하고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Harper Callie
#. NodeID = 4b3f4527-63e4-1e3c-c7a5-e445b20f9238
