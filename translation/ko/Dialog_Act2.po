msgctxt "h4b9c3ff0g900ag4556g93bfgc81cd34b6ee6"
msgid "Gored by some manner of horn. An ox got rambunctious."
msgstr "뿔에 찔렸군. 황소가 난동을 부렸던 모양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedTiefling
