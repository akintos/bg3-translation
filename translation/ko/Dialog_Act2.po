msgctxt "h05140561gc5a7g4435ga4c9gc2071bb8626f"
msgid "Preparing to march, I wager."
msgstr "진군을 준비하고 있다는 데 걸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport
#. Speaker = Quartermaster Talli
#. NodeID = 6d1e78f9-650b-491f-8769-ae2d31db35a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport:6d1e78f9-650b-491f-8769-ae2d31db35a0
msgctxt "hd34884a1gde28g4284g99b8g9ff66fe7ba9f"
msgid "Burning through our oil, but it should just about do."
msgstr "기름을 무지하게 쓰고 있지만, 거의 충분할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport
#. Speaker = Harper Callie
#. NodeID = 90008b16-37f0-48d8-bec5-5cd4a669b4c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport:90008b16-37f0-48d8-bec5-5cd4a669b4c8
msgctxt "h59408da7g665fg4347g9451g96c325806497"
msgid "Just about?"
msgstr "거의라니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport
#. Speaker = Quartermaster Talli
#. NodeID = 922e9558-e910-49b3-9e91-7148004215f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport:922e9558-e910-49b3-9e91-7148004215f3
msgctxt "h8dae9080g5ad5g4ffdgb99bgac9ee0b98b46"
msgid "Just about. We shouldn't hang around too long, though."
msgstr "그래 거의. 그래도 여기 너무 오래 있으면 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport
#. Speaker = Harper Callie
#. NodeID = d7e5c59f-7dcd-4304-9a1a-f2da5d96e90b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_QuartermasterReport:d7e5c59f-7dcd-4304-9a1a-f2da5d96e90b
msgctxt "hec17420cg7f5dg4d3bgb668ga7070d68666e"
msgid "Jaheira wants to know about supplies. Will we make it home?"
msgstr "자헤이라 님께서 보급 사정에 대해 알고 싶어 하셔, 돌아갈 때까지 충분할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_BarricadeGuards_Caster_WoodElf
