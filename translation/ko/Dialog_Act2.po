msgctxt "h81a7ab30gb810g45e3g99fegfa4636d20748"
msgid "<i>Veritas ab carne!</i>"
msgstr "<i>베리타스 아브 카르네!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Haruspicy
