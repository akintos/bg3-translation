msgctxt "h0bdc8b57gaae5g4746g8a02g55d35b2b649f"
msgid "That thing's about to blow!"
msgstr "저거 폭발하려나 봐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes
#. Speaker = Lae'zel
#. NodeID = 8a73eba1-140d-4b8d-9d9b-e7cc0b092d9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
