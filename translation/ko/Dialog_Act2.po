msgctxt "h6b21c2a1gf2c5g4700g98bag4c65b66c7fb3"
msgid "Ellie May's ring? Better me than him, I suppose."
msgstr "엘리 메이의 반지인가? 차라리 내가 갖는 게 낫겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = bc404d44-0d39-4610-bfd6-7230aeb7342b
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:bc404d44-0d39-4610-bfd6-7230aeb7342b
msgctxt "hf32d97a4gbcdcg4150ga434g96d15d9bafab"
msgid "Well I'll be - he wanted Ellie May's ring."
msgstr "저런. 엘리 메이의 반지를 원했을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = bc404d44-0d39-4610-bfd6-7230aeb7342b
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:bc404d44-0d39-4610-bfd6-7230aeb7342b
msgctxt "h01338cd9g62e6g4abbga19dg16aa01fde0df"
msgid "Ellie May's ring? Guess I got there before him."
msgstr "엘리 메이의 반지인가? 내가 먼저 찾아낸 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = c4927df7-2e16-46b7-8755-21d09941a636
