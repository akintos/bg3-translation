#.     - 2f161555-aab8-00cd-063a-8a03f5954c3e_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_AD_VanishingJusticiarChanting:ac9387bb-8298-443e-a5ec-ce8b55d37536
msgctxt "h24b17806g2cd1g4c4fg9cbeg0c911aa4943f"
msgid "Descend to her."
msgstr "그분께 내려가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_AD_VanishingJusticiarChanting
