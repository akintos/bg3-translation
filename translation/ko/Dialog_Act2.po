#, fuzzy
msgctxt "hc3f41ea4gdc2eg4760g8baag7955faa47ab9"
msgid "<i>Channel the power of your oath, making it a call - a beacon.</i>"
msgstr "<i>맹세의 힘으로 길을 연결한다, 그것이 호출이 된다, 봉화가 된다.</i>"

