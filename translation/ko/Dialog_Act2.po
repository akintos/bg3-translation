msgctxt "hdc3f0e2dg71d0g447bga649gd9fbec636e9e"
msgid "<i>Give it a scratch behind the ears.</i>"
msgstr "<i>귀 뒤를 긁어줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
