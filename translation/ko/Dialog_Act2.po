#.      - HAV_Mood_State_Alert = True
#.   Local:
#.      - 44060298-4dbf-d240-f4ac-efdffab5e199_HAV_HavenOutcasts_RoofWatcherCaster_HasMet_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster:c204a1b8-b640-4282-afb3-8998a7b60aee
msgctxt "h18df1179g377fg4a25ga4e2gd9f7422a42b5"
msgid "Don't get too close to me, all right?"
msgstr "너무 가까이 오진 말라고, 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/GEB_MOO_Jailbreak_AD_SpottedMissingPrisoners
#. Speaker = GROUP_Guards
#. NodeID = 7044f5f7-77ac-4a52-a224-111b0d0548dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/GEB_MOO_Jailbreak_AD_SpottedMissingPrisoners:7044f5f7-77ac-4a52-a224-111b0d0548dd
msgctxt "h574bed3fgd20ag4700g97bcgb3c9e4492cc1"
msgid "Get the Warden - the prisoners have escaped!"
msgstr "간수장님을 데려와, 죄수들이 탈옥했다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Narrator
#. NodeID = 0ef91441-5ef7-a672-414e-07ec143c1cdb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Alarm_HasMet_Eye(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:0ef91441-5ef7-a672-414e-07ec143c1cdb
msgctxt "h74b160e3g505dg4e31g8fcfgbbdfccb9b4bd"
msgid "*A lifeless eye stares at you.*"
msgstr "*생기 없는 눈이 당신을 응시합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Player
#. NodeID = 186ca527-9c6d-bd11-b03e-d8056ba7d4cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:186ca527-9c6d-bd11-b03e-d8056ba7d4cd
msgctxt "h9438b568g7818g48ddgb744gd768d55e8449"
msgid "Anybody in there?"
msgstr "거기 누구 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Narrator
#. NodeID = 30380d88-ed51-c450-797d-10cb762951a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:30380d88-ed51-c450-797d-10cb762951a8
msgctxt "h96444741g07d5g465ag956bg7fb97b202e61"
msgid ""
"*A spark glows within the heart of the construct - someone, or something, "
"watches you from beyond.*"
msgstr "*구성체의 중심에서 불꽃이 반짝입니다, 누군가, 혹은 무엇인가가, 너머에서 당신을 지켜보고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Player
#. NodeID = 3ea93cde-8b0c-8a16-1e92-695f4a6d586d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:3ea93cde-8b0c-8a16-1e92-695f4a6d586d
msgctxt "h22cda0b6g9063g43d6g8985g49b8a9d430db"
msgid "<i>Examine the eye.</i>"
msgstr "<i>눈을 조사한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Narrator
#. NodeID = 699d1b76-29e2-4b64-880e-9da92e6de6ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Alarm_HasMet_Eye(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:699d1b76-29e2-4b64-880e-9da92e6de6ef
msgctxt "h3a1b952cge2fdg4175g8dd1g50dfcb3c9c43"
msgid "*The eye focuses on you, taking in every detail of your appearance.*"
msgstr "*눈이 당신을 주시합니다, 자세한 당신의 모습을 포착합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Narrator
#. NodeID = 7c1c26a0-ebeb-66ff-80e6-799dd98dc9cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:7c1c26a0-ebeb-66ff-80e6-799dd98dc9cf
msgctxt "h0b5798fcg5d80g46ffgb084gaa486b500402"
msgid "*It simply watches you.*"
msgstr "*그저 당신을 지켜볼 뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Narrator
#. NodeID = 81194833-b148-fe1d-56c9-674cf356f5d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:81194833-b148-fe1d-56c9-674cf356f5d1
msgctxt "h2c13ce0ag68c6g491bgb073g1373757c7123"
msgid ""
"*As far as you can tell, it is a simple construct designed to provide "
"additional security.*"
msgstr "*당신이 알 수 있는 건, 이건 추가적인 보안을 제공하기 위해 만들어진 간단한 구조물이라는 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye
#. Speaker = Player
#. NodeID = f9852517-f8d8-87c6-e7a6-2dae2d90e545
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Alarm_Eye:f9852517-f8d8-87c6-e7a6-2dae2d90e545
msgctxt "h006f51bagc132g4c9eg8f7egcc8cc7244615"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual
#. Speaker = Player
#. NodeID = 31cd6582-1b2f-4042-b363-2651d605d5b7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual:31cd6582-1b2f-4042-b363-2651d605d5b7
msgctxt "hb2066357g7156g4d98g97c5g10b01fa21f15"
msgid "'Take on the Apostle's form'? What in the hells is Ketheric planning?"
msgstr "'사도의 형상을 취한다'? 대체 케서릭은 무슨 생각인 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual
#. Speaker = Player
#. NodeID = 31cd6582-1b2f-4042-b363-2651d605d5b7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual:31cd6582-1b2f-4042-b363-2651d605d5b7
msgctxt "h7480a006g9ed2g4ac6g9993g9cc59fb464b3"
msgid ""
"Something about taking on the apostle's form... Just what is Ketheric Thorm "
"planning?"
msgstr "사도의 형상을 취한다는 얘기를 한 것 같은데... 대체 케서릭의 계획은 뭐란 말인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual
#. Speaker = Player
#. NodeID = 31cd6582-1b2f-4042-b363-2651d605d5b7
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual:31cd6582-1b2f-4042-b363-2651d605d5b7
msgctxt "hcc146586g7132g4e06gaa3fgc1d63b604727"
msgid "Ketheric got up to something dark - very dark."
msgstr "케서릭에게 뭔가 어두운 꿍꿍이가 있는 게 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual
#. Speaker = Player
#. NodeID = 31cd6582-1b2f-4042-b363-2651d605d5b7
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual:31cd6582-1b2f-4042-b363-2651d605d5b7
msgctxt "h7882a522g3319g4ed2ga057ga91e0b896c3a"
msgid "Who is this 'Apostle'? The Absolute - or something even more insidious?"
msgstr "이 '사도'란 건 대체 누구지? 절대자인가 - 아니면 그보다도 더 간악한 존재인건가?\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual
#. Speaker = Player
#. NodeID = 31cd6582-1b2f-4042-b363-2651d605d5b7
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual:31cd6582-1b2f-4042-b363-2651d605d5b7
msgctxt "h87919018g1e0dg40begb6a6ge35746c5c5a0"
msgid ""
"A ritual. Doesn't seem related to Shar or Selûne... what's Ketheric been up "
"to?"
msgstr "의식이로군. 샤나 셀루네와 연관된 건 아닌 것 같은데... 케서릭의 꿍꿍이는 대체 뭐지?\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual
#. Speaker = Player
#. NodeID = 31cd6582-1b2f-4042-b363-2651d605d5b7
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual:31cd6582-1b2f-4042-b363-2651d605d5b7
msgctxt "h7c0a165bga61cg44f3ga7cbgf1f10c1d7548"
msgid ""
"'Apostle's final form?' Either Ketheric's got a flair for poetry, or he's "
"planning some ghastly ritual."
msgstr "'사도의 최종 형상?' 케서릭이 글재주를 발휘해 시라도 지은 게 아닌 이상, 뭔가 끔찍한 의식을 계획하고 있는 거겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual
#. Speaker = Player
#. NodeID = 31cd6582-1b2f-4042-b363-2651d605d5b7
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_ApostleEntry_PAD_Ritual:31cd6582-1b2f-4042-b363-2651d605d5b7
msgctxt "ha9a4128cgc4d6g48a1ga009g09efefc19966"
msgid ""
"Ketheric's been studying something called the Apostle... but of which god?"
msgstr "케서릭은 사도라 불리는 뭔가에 몰두하고 있었군... 대체 어느 신을 섬기는 걸까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_AccessCultistCombat
#. Speaker = Radija
#. NodeID = f7be909a-1ede-4c3c-80a3-0c25e03f7a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_AccessCultistCombat:f7be909a-1ede-4c3c-80a3-0c25e03f7a4f
msgctxt "h2054a701g0803g4483gbcc4g47adb29bc729"
msgid ""
"You'll die before you reach my lord. Perhaps then you will be "
"<i>obedient.</i>"
msgstr "주인님께 도착하기도 전에 넌 죽을 것이다. 죽으면 너도 <i>복종하겠지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_BarnabusCombat
#. Speaker = 'Barnabus'
#. NodeID = 6ca8001c-53c3-44e4-9177-a87cebfed1ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_BarnabusCombat:6ca8001c-53c3-44e4-9177-a87cebfed1ab
msgctxt "hc6d8f490g1c5bg4069g854bg23c9f8e16186"
msgid "*Howl.*"
msgstr "*울부짖는다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_BarnabusCombat
#. Speaker = 'Barnabus'
#. NodeID = a87240f7-c48e-4436-9920-c855d5285f83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Kitchen_State_GnollsAreFree = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_BarnabusCombat:a87240f7-c48e-4436-9920-c855d5285f83
msgctxt "h54f41ab7gf29dg4edag9338g0760e7cd3ef6"
msgid "Baar-NA-buuuuus. <i>Kill!</i>"
msgstr "바아아<b>나</b>부우우우우스. <i>죽인다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 4a3cff74-9a06-43b2-aca2-3b7c85806514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_GuardJumper:4a3cff74-9a06-43b2-aca2-3b7c85806514
msgctxt "h892d9cb8g408ag4448gbd15g80815dacdb20"
msgid "Can't believe you'd betray the Absolute. Idiot."
msgstr "절대자님을 배신하다니 믿을 수 없군. 멍청한 자식."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = fe575bf2-f9ec-775d-bd3d-3811aebf3d9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_GuardJumper_FixedMind = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_GuardJumper:fe575bf2-f9ec-775d-bd3d-3811aebf3d9d
msgctxt "h49f9ffc8gfb2cg480dg8f20gf2ef51c88d3f"
msgid "Believe - can't. Idiot! The Absolute... be-tray."
msgstr "믿을수, 없다, 멍청이! 절대자님을... 배신하다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 630dfa18-e836-4f3b-87be-334172aaa073
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_GuardObserver:630dfa18-e836-4f3b-87be-334172aaa073
msgctxt "hce1d4a97g6e2eg4bf3gbf7dgc65f11af2c72"
msgid "Come at me - come on, then!"
msgstr "이리와, 덤벼보라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraFollowerLeave
#. Speaker = Jaheira
#. NodeID = cda38fba-04d4-4b56-9926-3607c04a0f9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_JaheiraWarnedPlayer = True
#. SetFlags:
#.   Global:
#.     - MOO_Assault_State_JaheiraWarnedPlayer = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraFollowerLeave:cda38fba-04d4-4b56-9926-3607c04a0f9e
msgctxt "h1420c5fcga67bg481agb880g29c3a6c5a3b7"
msgid "Where are we going? The battle is back the other way."
msgstr "어디 가는 거지? 전투는 저기 반대편에서 일어나고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraFollowerLeave
#. Speaker = Jaheira
#. NodeID = e5d7c201-c6ff-4012-9f56-b8253266c425
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_Assault_State_JaheiraLeftParty(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraFollowerLeave:e5d7c201-c6ff-4012-9f56-b8253266c425
msgctxt "h4c179096ge77cg4352ga537g5c9027e2aff3"
msgid ""
"Ketheric will not wait on our pleasure, nor jump on his sword without our "
"aid. I go back to the battle - find me when you are ready to fight."
msgstr ""
"케서릭은 우리가 기뻐하도록 내버려두지 않을 거다. 우리가 나서지 않는 한, 스스로 삶을 포기하지도 않겠지. 난 다시 전투에 나서겠다. "
"싸울 준비가 되면 찾아오도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward
#. Speaker = Jaheira
#. NodeID = 3e855e84-8072-f5c8-3058-48bbf964fa32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_FlamingFistSupport = True
#.      - MOO_Assault_State_AllActiveHarpersDefeated = True
#.      - MOO_Assault_State_AllActiveFlamingFistDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward:3e855e84-8072-f5c8-3058-48bbf964fa32
msgctxt "h7981e727gb387g47bfg9ad2gb2aeb39bbd5c"
msgid "Hold every exit - let none escape to warn the army of our assault."
msgstr "모든 출구를 봉쇄하라. 그 누구도 탈출하지 못하게 해. 본대에 이 습격이 알려져선 안된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward
#. Speaker = Jaheira
#. NodeID = 4e84f500-a0be-504d-133c-866777715904
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_AllActiveHarpersDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward:4e84f500-a0be-504d-133c-866777715904
msgctxt "ha74da2deg59d5g4b19ga0f2g15869a08f01a"
msgid ""
"Hold this floor, Harpers! Let none escape the tower. We're about to trap the "
"spider in its own web."
msgstr "이 층을 점거해라, 하퍼 요원들! 그 누구도 빠져나가지 못하게 해라. 이제 거미를 거미줄에 가두는 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward
#. Speaker = Jaheira
#. NodeID = 710263e0-bc14-548a-33fb-925678b8c98a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward:710263e0-bc14-548a-33fb-925678b8c98a
msgctxt "h65ed0532gcb1bg4159gb667g93c3cffdf734"
msgid "We've taken the tower. No doubt its master waits to greet us above."
msgstr "우리가 타워를 장악했다. 당연하게도 타워의 주인이 위에서 우릴 기다리고 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward
#. Speaker = Jaheira
#. NodeID = b3cff7e9-de7d-d97d-5dad-28b173e76897
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_FlamingFistSupport = True
#.      - MOO_Assault_State_AllActiveHarpersDefeated = False
#.      - MOO_Assault_State_AllActiveFlamingFistDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraMoveForward:b3cff7e9-de7d-d97d-5dad-28b173e76897
msgctxt "hdb9a50dbgdda9g4633gb976g3b51568ff1bf"
msgid ""
"Harpers - hold this floor. Let none escape to warn the army - not until "
"we've put Ketheric down."
msgstr "하퍼 요원들 - 이 층을 점거해라. 케서릭을 해치우기 전까지 그 누구도 병력을 요청하러 빠져나가지 못하게 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo
#. Speaker = Jaheira
#. NodeID = 09ffeeee-c376-4439-9e05-68f560557ff9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_MainFloorEnemiesDefeated = True
#.   Local:
#.      - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = True
#. SetFlags:
#.   Local:
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo:09ffeeee-c376-4439-9e05-68f560557ff9
msgctxt "h8500ccf3gdcc7g463egad85g391f7825f194"
msgid "Here we stand in the lion's den, but the lions are you and I."
msgstr "사자의 소굴에 당당히 입성했군. 하지만 사자는 다른 누구도 아닌 자네와 나일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo
#. Speaker = Jaheira
#. NodeID = 43e1f5cb-f358-4d4b-b464-29c7fd42ba25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_MainFloorEnemiesDefeated = True
#. SetFlags:
#.   Local:
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo:43e1f5cb-f358-4d4b-b464-29c7fd42ba25
msgctxt "ha893229fg90d0g4844g8d93g3cd6b25b690c"
msgid ""
"Come what may, we'll be the tempest that blows clear this accursed place."
msgstr "그 어떤 어려움이 닥치더라도, 우리는 이 저주받은 땅을 정화할 폭풍이 될 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo
#. Speaker = Jaheira
#. NodeID = 59791142-9e27-48ae-9a2b-6ca651f2a74a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo:59791142-9e27-48ae-9a2b-6ca651f2a74a
msgctxt "ha89b424agfa1fg4dd9gb267g95a4d6f83828"
msgid "Once more unto battle. Once more to save Baldur's Gate."
msgstr "또 다시 전장으로. 다시 한 번 발더스 게이트를 구하는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo
#. Speaker = Jaheira
#. NodeID = 93ad2910-b0d8-4ade-b9dd-c05570565b76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_MainFloorEnemiesDefeated = True
#.   Local:
#.      - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_B = True
#.      - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = True
#. SetFlags:
#.   Local:
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_B = False
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo:93ad2910-b0d8-4ade-b9dd-c05570565b76
msgctxt "h2df3bc02gb382g4abbg98f1g2291b57ae8d4"
msgid "At long last, the dynasty of Thorms shall be dethroned."
msgstr "비로소, 쏨 일가를 권좌에서 몰아낼 수 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo
#. Speaker = Jaheira
#. NodeID = b8e191f4-2544-453b-87f4-87b2c1a508fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_B = True
#.      - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = True
#. SetFlags:
#.   Local:
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_B = False
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo:b8e191f4-2544-453b-87f4-87b2c1a508fa
msgctxt "h3f04ee6eg80c5g498dgb5ceg2344fd359018"
msgid "Shadow to shadow. Soon the final reckoning."
msgstr "모든 것은 그림자에서 그림자로. 곧 최후의 심판이 시작되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo
#. Speaker = Jaheira
#. NodeID = f6989b35-99eb-4329-99ae-93304dd2aa1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_A = True
#. SetFlags:
#.   Local:
#.     - a63e4af2-6edc-188a-efdf-b9ffc5460fc5_LOCAL_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_JaheiraSolo:f6989b35-99eb-4329-99ae-93304dd2aa1f
msgctxt "had402f03g5579g4236ga116g7a5e0515b523"
msgid ""
"My blade will taste of your flesh, Ketheric, and so settle a century-old "
"score."
msgstr "내 칼이 네놈의 살점을 파고들 것이다, 케서릭. 100년 묵은 원한을 드디어 갚겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_PrisonWarden
#. Speaker = The Warden
#. NodeID = 158a172a-2c45-42ea-8922-e47b9a4cfd42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_PrisonWarden:158a172a-2c45-42ea-8922-e47b9a4cfd42
msgctxt "h9d608994gcb8cg44dagaed6g54114e4d4a3b"
msgid "I'll smear your entrails on these walls. In Her name!"
msgstr "네놈의 내장을 벽에다 칠해주마. 그 분의 이름으로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting
#. Speaker = The Warden
#. NodeID = 2ea4441e-2b66-41a9-829d-6af17897514c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting:2ea4441e-2b66-41a9-829d-6af17897514c
msgctxt "h91452ddcgb02ag48f7gb82bg5ab728ead30d"
msgid "Z'rell best handle them quickly."
msgstr "즈렐이 놈들을 빨리 처리해야 할 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting
#. Speaker = The Warden
#. NodeID = 3e5e79dc-85e8-40a4-bf01-58843bf1a209
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_A = True
#. SetFlags:
#.   Local:
#.     - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting:3e5e79dc-85e8-40a4-bf01-58843bf1a209
msgctxt "hf4c21dfcgdcc8g4337gae21gdc48f60da0e0"
msgid "I didn't sign up to face a contingent of rabid do-gooders."
msgstr "입만 산 극렬 사회운동가들하고 싸우자고 이 직업을 고른 건 아닌데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting
#. Speaker = The Warden
#. NodeID = 9242895c-8179-4723-88f2-aebec3ebd067
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_C = True
#. SetFlags:
#.   Local:
#.     - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_B = False
#.     - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_C = False
#.     - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting:9242895c-8179-4723-88f2-aebec3ebd067
msgctxt "h51e6f6efg983ag4ae5g8355g31b5e7742aea"
msgid "What's taking so long?!"
msgstr "대체 뭐 때문에 이렇게 늦는 거야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting
#. Speaker = The Warden
#. NodeID = d339af67-1984-4fe4-9592-225c9bec317a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_B = True
#. SetFlags:
#.   Local:
#.     - ddb63ed1-6bbb-2251-c4d6-b1c59315e195_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_WardenWaiting:d339af67-1984-4fe4-9592-225c9bec317a
msgctxt "h4c5a7738g01dbg4664g8742gc3187a4158fb"
msgid ""
"I almost hope they break through. It'll make a change from beating on "
"prisoners."
msgstr "제발 여기까지 와줬으면 싶을 정도야. 죄수들 패는 건 이제 질려서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout
#. Speaker = Disciple Z'rell
#. NodeID = 07d29944-1d08-490c-8974-e3372f876d82
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f946743b-ea76-19e0-1409-d5a51002bf4c_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout:07d29944-1d08-490c-8974-e3372f876d82
msgctxt "hb8f2da14g1ab7g4815gb0d5g8e68d63124d5"
msgid "What are you waiting for?"
msgstr "뭘 기다리느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout
#. Speaker = Disciple Z'rell
#. NodeID = 73e71fb0-e081-4023-a323-f5e5beef1242
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f946743b-ea76-19e0-1409-d5a51002bf4c_A = True
#. SetFlags:
#.   Local:
#.     - f946743b-ea76-19e0-1409-d5a51002bf4c_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout:73e71fb0-e081-4023-a323-f5e5beef1242
msgctxt "hcc49836fg3bedg40c0gb988ge6c92e7708d5"
msgid "Come on - face me."
msgstr "덤벼라. 대면하거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout
#. Speaker = Disciple Z'rell
#. NodeID = 9c15b45f-8530-439e-9c8b-4180cf387002
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f946743b-ea76-19e0-1409-d5a51002bf4c_C = True
#. SetFlags:
#.   Local:
#.     - f946743b-ea76-19e0-1409-d5a51002bf4c_A = False
#.     - f946743b-ea76-19e0-1409-d5a51002bf4c_B = False
#.     - f946743b-ea76-19e0-1409-d5a51002bf4c_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout:9c15b45f-8530-439e-9c8b-4180cf387002
msgctxt "h707978c0g304bg4374gb419g34007856cd44"
msgid "Your corpses will look magnificent hanging from the parapets."
msgstr "네 시체를 난간에 매달아 놓으면 볼만 하겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout
#. Speaker = Disciple Z'rell
#. NodeID = e7ce6506-d6a1-4627-9152-d3623bcffac3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f946743b-ea76-19e0-1409-d5a51002bf4c_B = True
#. SetFlags:
#.   Local:
#.     - f946743b-ea76-19e0-1409-d5a51002bf4c_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCallout:e7ce6506-d6a1-4627-9152-d3623bcffac3
msgctxt "hf225c59dgdb2cg414cgbda5g9bd34c65056d"
msgid "The Absolute guides our swords. You have <i>nothing</i>."
msgstr "절대자께서 우리의 검을 인도하신다. 네겐 <i>아무것도</i> 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCombat
#. Speaker = Disciple Z'rell
#. NodeID = 4b0b029a-e817-4515-b8a1-8733173cdb5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellCombat:4b0b029a-e817-4515-b8a1-8733173cdb5b
msgctxt "hf93d6aa2g9279g417cg9100g0105a5e62b53"
msgid "I'll strip your bones clean."
msgstr "네 뼈는 깨끗이 발라주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt
#. Speaker = Disciple Z'rell
#. NodeID = 14cf020b-6bad-4d39-a38f-761b582e34dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7cd519b5-df41-47c0-1d53-6c315224e489_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt:14cf020b-6bad-4d39-a38f-761b582e34dd
msgctxt "hd5337ccbg2348g4339g92bcga2e078450bd1"
msgid "Make your move!"
msgstr "움직여라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt
#. Speaker = Disciple Z'rell
#. NodeID = 30f5b37e-7f9f-49a9-ade0-a9add5e1fb67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cd519b5-df41-47c0-1d53-6c315224e489_A = True
#. SetFlags:
#.   Local:
#.     - 7cd519b5-df41-47c0-1d53-6c315224e489_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt:30f5b37e-7f9f-49a9-ade0-a9add5e1fb67
msgctxt "h13bd96c9g1d1eg450bg813dg3f5118564bff"
msgid "What's the matter? Are you frightened of your fate?"
msgstr "무슨 일이지? 네 운명이 두려워졌나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt
#. Speaker = Disciple Z'rell
#. NodeID = 4a603e4c-20e7-4317-b8dc-8d2a6ae66ead
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cd519b5-df41-47c0-1d53-6c315224e489_C = True
#. SetFlags:
#.   Local:
#.     - 7cd519b5-df41-47c0-1d53-6c315224e489_C = False
#.     - 7cd519b5-df41-47c0-1d53-6c315224e489_B = False
#.     - 7cd519b5-df41-47c0-1d53-6c315224e489_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt:4a603e4c-20e7-4317-b8dc-8d2a6ae66ead
msgctxt "h599c38e4g5959g4c77gac78g50c0ae0f6530"
msgid "You can't stall forever."
msgstr "언제까지고 시간 끌 순 없을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt
#. Speaker = Disciple Z'rell
#. NodeID = b434a151-d050-4ae1-b228-f0382369fedc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cd519b5-df41-47c0-1d53-6c315224e489_B = True
#. SetFlags:
#.   Local:
#.     - 7cd519b5-df41-47c0-1d53-6c315224e489_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AD_ZrellTaunt:b434a151-d050-4ae1-b228-f0382369fedc
msgctxt "h1e34a625g4456g40aaga369g966c12fda86c"
msgid "Poor little infidel afraid to face the one true god."
msgstr "유일신과 마주하는 것을 두려워하는 불쌍한 불신자 자식."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001
#. Speaker = Fist Nipawa
#. NodeID = 55450921-4b74-45e8-a1b4-04af74d31f4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_001_ThroneRoomDefeated_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_001_ThroneRoomDefeated_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001:55450921-4b74-45e8-a1b4-04af74d31f4b
msgctxt "h3dcb482ag7f48g4ae8gab17gfc3b3364938b"
msgid "Watching gods. These poor bastards actually die believing."
msgstr "방관하는 신들이라니. 이 불쌍한 놈들은 죽어가면서도 믿음을 잃지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001
#. Speaker = Fist Nipawa
#. NodeID = 6400d594-11bf-4022-b96a-99b824f5af14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_001_PostAssualt_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_001_PostAssualt_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001:6400d594-11bf-4022-b96a-99b824f5af14
msgctxt "h1190057eg3ac9g4574g8d1bg52ae0df23bb0"
msgid ""
"I only took this expedition for the hazard pay. I'd say we've earned it."
msgstr "난 위험수당때문에 이 원정에 자원한 거야. 우린 받을 자격이 있다고 생각해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001
#. Speaker = Fist Nipawa
#. NodeID = 9925ecca-e684-408c-ae4f-6bfd976621aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_001_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001:9925ecca-e684-408c-ae4f-6bfd976621aa
msgctxt "h10371dbfg521fg4faegb618gbc74938159cb"
msgid "Enough. We need to put an end to this."
msgstr "그만. 이만 종지부를 찍자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001
#. Speaker = Fist Nipawa
#. NodeID = bc9c65d3-5047-47ea-9a84-b261a057a42a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_001_HasMet(1) = False
#. SetFlags:
