msgid "Mind flayer script. Meaningless to me."
msgstr "마인드 플레이어가 쓴 글이네. 쓸모없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
#. Speaker = Player
#. NodeID = 4084d2c3-0567-4d91-823e-490c4b62afad
