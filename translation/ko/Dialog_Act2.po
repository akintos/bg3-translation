msgctxt "hcedc47fag7177g485cg9311g3ef8b1795386"
msgid "Enough interference! <i>Let me be</i>."
msgstr "그만 방해해! <i>날 내버려 둬</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
