msgctxt "h2fede916gfa11g4febgb581g38c56852db89"
msgid "Perimeter's clear, ma'am."
msgstr "근방에 이상 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Jaheira
#. NodeID = e29d54bc-ddbe-40fa-9582-33f1b02df595
