#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Cat:f0ed7f92-bee6-4c22-fbbd-092a0cf99198
msgctxt "h87d59b48gbf2cg4f44g8208g87bb321f27e9"
msgid "*RIAOW!*"
msgstr "*냐앙!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Cat
#. Speaker = His Majesty
#. NodeID = f11b734b-91a6-51ec-5733-60815d56db40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Cat:f11b734b-91a6-51ec-5733-60815d56db40
msgctxt "h9a0a7698g8661g441dgbd1bg158d98bc9e92"
msgid ""
"You know, I think it's time I move somewhere better-suited to my lifestyle."
msgstr "마침 내 생활방식에 맞는 곳으로 옮길까 하던 참이긴 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Cat
#. Speaker = His Majesty
#. NodeID = f336a064-6d6a-5f80-9086-ab45a2d76414
#. HandlePath = TaggedText[0].TagText[0]
