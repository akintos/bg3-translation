#.      - REALLY_SHADOWHEART(1) = False
#. SetFlags:
#.   Object:
#.     - SHA_Trials_Event_StartTrial(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:4c516674-8a50-4eac-994c-c67b86da8f15
msgctxt "hf9c8656dg1d5fg46a6g9131g0da7bc52706b"
msgid "<i>Spill some of your blood in the bowl.</i>"
msgstr "<i>그릇에 피를 약간 흘려넣는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = 4c805ab5-3fbd-13c5-e953-5ae96cae6112
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_Event_SHAskedtoDoTrial = True
#.      - SHA_SneakTrial_State_ShadowheartOffered = False
#.   Local:
#.      - 542ac950-9296-7fbb-0b0a-90a564091704_TrialRequested = False
#.   Object:
#.      - SHA_ObjectOfDarknessTrial_Event_RefusedSH(1) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_TrialRequested = True
#.     - 542ac950-9296-7fbb-0b0a-90a564091704_PermissionGranted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:4c805ab5-3fbd-13c5-e953-5ae96cae6112
msgctxt "h09f378e1g326bg45ffga617g502c5139c159"
msgid ""
"If you're going to hesitate, just stand aside and let me do the trial myself."
msgstr "주저할 거라면, 그냥 물러나서 내가 직접 시련을 치를 수 있게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Shadowheart
#. NodeID = 52564af3-fbc5-540f-bcdc-6d5f3748b229
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp2(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:52564af3-fbc5-540f-bcdc-6d5f3748b229
msgctxt "h40d6f56dg9bbdg42f4gb41egc2b3d5276418"
msgid ""
"These trials mean something to me, don't you understand? I thought I could "
"rely on you."
msgstr "이 시련은 나한테 특별한 의미가 있는 거란 말이야, 이해가 안 돼? 난 너는 의지할 수 있다고 생각했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Narrator
#. NodeID = 67ea657e-c9c2-0a15-8265-b998b6005be8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_StatueUsed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:67ea657e-c9c2-0a15-8265-b998b6005be8
msgctxt "h8bf1035dg35b2g4585gb4acg3dbece50fb6a"
msgid "*Another bowl, bearing the stains of an ancient blood offering.*"
msgstr "*아주 오래전, 피의 공물을 헌납했던 흔적이 남은 또다른 그릇입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Narrator
#. NodeID = 79a4a074-c127-6b20-4332-3e81188fce16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_StatueUsed = False
#. SetFlags:
