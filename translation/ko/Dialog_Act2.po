msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Player
#. NodeID = af9d73ee-6071-074f-bc6c-f2a5477a15ab
