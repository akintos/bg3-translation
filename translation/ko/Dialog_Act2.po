msgctxt "habce2514gf730g49ecga612g949443bbb001"
msgid "This is Mol's eyepatch - what's become of her?"
msgstr "여기 몰의 안대가 있어, 몰한테 무슨 일이 일어난 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = ac9e8214-30d4-d3d2-c814-435034cdda7b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch:ac9e8214-30d4-d3d2-c814-435034cdda7b
msgctxt "hfc0bee97g9a93g4ce2g9899gb3a6abd97520"
msgid "An eyepatch? I swear, if there are pirates here too..."
msgstr "안대인가? 맹세하건대, 여기에 해적들도 있는 게 아니라면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = ac9e8214-30d4-d3d2-c814-435034cdda7b
