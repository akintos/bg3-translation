#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_AD_IsobelsPlaque:a9125d4a-338a-5904-fbd6-e55c21e35e9a
msgctxt "h952cfa40ge26bg46a0gae6eg50f5aa762434"
msgid ""
"*It seems a name was once carved beside the inscription, but it has been "
"scratched away by vermin or vandalism.*"
msgstr "*한때는 비문 옆에 이름도 새겨져 있었던 걸로 보이나, 동물 혹은 고의적인 훼손에 의해 지금은 지워진 상태입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate
#. Speaker = Player
#. NodeID = 672c28c2-4f58-4a89-a602-4cd1cbb19ced
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate:672c28c2-4f58-4a89-a602-4cd1cbb19ced
msgctxt "h9396812cg7e84g4b26ga977gc6a310b45469"
msgid ""
"Shi- oh. Nothing? Either the trap's broken or someone's already disarmed it."
msgstr "쌰...오. 아무 일도 안 일어나네? 함정이 망가졌거나 누가 이미 해체했나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate
#. Speaker = Player
#. NodeID = 672c28c2-4f58-4a89-a602-4cd1cbb19ced
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate:672c28c2-4f58-4a89-a602-4cd1cbb19ced
msgctxt "ha3b985deg539dg4f31g8feegf74958e28ad6"
msgid "A pressure plate... but unarmed. Why is that?"
msgstr "압력판이야...하지만 해제되었군. 왜 그럴까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate
#. Speaker = Player
#. NodeID = 672c28c2-4f58-4a89-a602-4cd1cbb19ced
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate:672c28c2-4f58-4a89-a602-4cd1cbb19ced
msgctxt "ha0b06b2eg9a3fg40e2g962dgc0f5587e592e"
msgid ""
"Disarmed traps. My lucky day. Unless something terrifying already tripped "
"them."
msgstr "해제된 함정이야. 운이 좋은 날인걸. 아니면 무서운 뭔가가 이미 거쳐갔든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate
#. Speaker = Player
#. NodeID = 672c28c2-4f58-4a89-a602-4cd1cbb19ced
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate:672c28c2-4f58-4a89-a602-4cd1cbb19ced
msgctxt "h8ab8a4d4g6737g4d5bg9935gd8ec886e420e"
msgid "Not so much as a poison arrow. The trap's been disarmed - or broken."
msgstr "독화살 하나 없군. 이 함정은 해제되었거나, 망가졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate
#. Speaker = Player
#. NodeID = 672c28c2-4f58-4a89-a602-4cd1cbb19ced
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate:672c28c2-4f58-4a89-a602-4cd1cbb19ced
msgctxt "h6524f2d8g5665g448fga78fg5d68e981e6a5"
msgid "I thought my luck had run out for a moment. Trap must be disarmed."
msgstr "잠깐 운이 다한 줄 알았어. 해제한 함정인가 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate
#. Speaker = Player
#. NodeID = 672c28c2-4f58-4a89-a602-4cd1cbb19ced
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate:672c28c2-4f58-4a89-a602-4cd1cbb19ced
msgctxt "he231adb4g06c5g4cafgb42bg7f509c43f00f"
msgid ""
"Hm - shouldn't something have happened? Fireballs or poisoned spikes, maybe?"
msgstr "흠, 뭔가 일어났어야 하지 않나? 화염구나 독 묻은 가시 같은?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate
#. Speaker = Player
#. NodeID = 672c28c2-4f58-4a89-a602-4cd1cbb19ced
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_DisarmedPressurePlate:672c28c2-4f58-4a89-a602-4cd1cbb19ced
msgctxt "h2ecbd7e6g9338g446eg8ac5gd26202fc59c0"
msgid "Nothing - it must have been disarmed."
msgstr "아무 것도 아냐. 분명 해제되었겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:044c4ca4-1a07-40ca-b419-0c57d8345a3e
msgctxt "h8d5adeafg9d1cg4deega36cgd393291baf34"
msgid "That disc looks like it could take us somewhere. But where?"
msgstr "저 원판이 우릴 어딘가로 데려다 줄 것 같은데, 그게 어디일까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:044c4ca4-1a07-40ca-b419-0c57d8345a3e
msgctxt "h4b99804eg1547g4797gb7ebg8434838cca12"
msgid "That disc is the way forward. I should see where it takes me."
msgstr "저 원판이 앞으로 가는 길이다. 어디로 통하는지 알아봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:044c4ca4-1a07-40ca-b419-0c57d8345a3e
msgctxt "h916dd110gbac0g4418g8a36g0145e14a20fe"
msgid "That disc will lead somewhere, I'll wager."
msgstr "저 원판이 우리를 데려다 줄 거야. 장담해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:044c4ca4-1a07-40ca-b419-0c57d8345a3e
msgctxt "h101e5835g6c17g4d60g9ebdg4e407456130e"
msgid "Those are statues of Lady Shar... what lies down here?"
msgstr "저건 샤 여신님의 조각상이야... 여기엔 뭐가 잠들어 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:044c4ca4-1a07-40ca-b419-0c57d8345a3e
msgctxt "hf067c162g1a07g49a3g91d8g9a0b9f44d55f"
msgid "That's no mere disc - it's a lift. I've found the way forward."
msgstr "저건 단순한 원판이 아니야. 승강기지. 앞으로 향하는 길을 찾았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:044c4ca4-1a07-40ca-b419-0c57d8345a3e
msgctxt "hbf176629g838cg4ebdg8490g545b72442354"
msgid "That thing looks mobile. Maybe it can bring us somewhere."
msgstr "저거 움직일 것처럼 보이는데. 우릴 어딘가로 데려다줄지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:044c4ca4-1a07-40ca-b419-0c57d8345a3e
msgctxt "h7881e7e2g356bg407fgb378g7471b6ab2b8b"
msgid "That disc can move, I'll wager. But where does it lead?"
msgstr "분명 저 원판은 움직이겠지. 하지만 어디로 이어질까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = 044c4ca4-1a07-40ca-b419-0c57d8345a3e
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
