#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:559a6457-b8c6-c6c6-6b6a-e4e2a8cd9181
msgctxt "h9ce9820dgfd27g4f5cgae13g7788dd4bd6f0"
msgid "Don't know how much longer I'll last in this darkness."
msgstr "이 어둠 속에서 내가 얼마나 버틸 수 있을지 모르겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 559a6457-b8c6-c6c6-6b6a-e4e2a8cd9181
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:559a6457-b8c6-c6c6-6b6a-e4e2a8cd9181
msgctxt "h066f3db2gcb25g4c41gaddag43453e1cfd56"
msgid "The curse will consume me entirely if I linger much longer."
msgstr "오래 머뭇거리면 저주가 날 완전히 집어삼킬 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 559a6457-b8c6-c6c6-6b6a-e4e2a8cd9181
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:559a6457-b8c6-c6c6-6b6a-e4e2a8cd9181
msgctxt "hc1cb1caegb61ag444cg84f1ga2006ffc9abe"
msgid "My life's bleeding away. This curse, it's - it's too much."
msgstr "내 생명력이 빠져나가고 있어. 이 저주는, 이건.. 좀 심한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 7473f5f2-a0e1-d031-4c4d-8a131b03982a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_CurseResistant = True
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:7473f5f2-a0e1-d031-4c4d-8a131b03982a
msgctxt "h7212c265g108eg4af6gaf77gd948cecf773e"
msgid "The shadows are hungry here. Doesn't seem to affect me though..."
msgstr "그림자들이 굶주렸어. 하지만 내게는 영향이 없는 모양이야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 7593bc17-9775-a3f3-74a9-82d24f5701a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:7593bc17-9775-a3f3-74a9-82d24f5701a3
msgctxt "ha254f608ge90eg443ega816gaf110bacd646"
msgid "The darkness is encroaching. Can't linger here - not like before."
msgstr "어둠이 잠식하고 있어. 전처럼 여기서 꾸물댈 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "h5be10028g9eedg4ddagbf89g0b367e531c17"
msgid "Anything to keep those shadows at bay."
msgstr "그림자를 막을 수 있다면 무엇이든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "h7618cb1cge8ccg491egb846g75061511c978"
msgid "Yes, light. Before we are consumed entirely."
msgstr "맞아, 빛. 우리가 완전히 거덜 나기 전에 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "h406b8574g937bg4d6dga3e4g7a77ce470f21"
msgid "Light - yes. Something to make the shadows retreat."
msgstr "빛... 그래. 그림자를 물러나게 할 뭔가가 필요하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "hbcc4b83fg37ffg4727gbf65g8a573f5ec054"
msgid "Yes - light. Something to cast off the cursed shadows."
msgstr "맞아... 빛. 저주받은 그림자를 걷어내기 위한 뭔가가 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "hf2c41465g20cdg4275g9282g438818035e15"
msgid ""
"Yes, you need some light. Keep whatever you find. I'm... unaffected, so far."
msgstr "맞아, 넌 빛이 좀 필요해. 뭐든 찾으면 가지고 있어. 난... 아직까진, 아무 영향을 받지 않네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "hbf312793g4441g43f4gb2f8gdcc80c21e25e"
msgid "Light's a good idea. Might protect us against this darkness."
msgstr "빛, 좋은 생각이야. 이 어둠으로부터 우리를 보호해 줄지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "ha71f0b0fga791g410fgbd88g1ed9196d2a35"
msgid "A torch, campfire, candle - anything to force the shadows to retreat."
msgstr "횃불, 모닥불, 촛불... 그림자를 강제로 물러나게 할 어떤 것이든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 812a23a3-7107-fa95-716d-322fdcab9d18
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:812a23a3-7107-fa95-716d-322fdcab9d18
msgctxt "he7785f50ga63ag4243g874fgcf1506779a6c"
msgid "Light, yes. Something to burn the cursed shadows away."
msgstr "빛, 그래. 저주받은 그림자를 불태울 수 있는 무언가가 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 88f8541c-e9c1-bb40-af0e-9105066d6cb7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:88f8541c-e9c1-bb40-af0e-9105066d6cb7
msgctxt "h4bac6da0gaf56g437fga5bcg0aaa461ddcc3"
msgid "I just need some light... just need to be free of this dark..."
msgstr "당장 빛이 필요해... 어둠에서 벗어나야 해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 88f8541c-e9c1-bb40-af0e-9105066d6cb7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:88f8541c-e9c1-bb40-af0e-9105066d6cb7
msgctxt "he3d13285g0de7g4f06ga8c0g087f3d41abdd"
msgid "Please... some light... dispel the darkness..."
msgstr "제발... 빛 좀... 어둠을 걷어내..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 88f8541c-e9c1-bb40-af0e-9105066d6cb7
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:88f8541c-e9c1-bb40-af0e-9105066d6cb7
msgctxt "hb2f8fab0g186eg4c6fg9de4g31c5a7363af8"
msgid "<i>Tsk'va</i> - I barely have the strength to move forward..."
msgstr "<i>츠크바.</i> 나아갈 힘이 없다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 88f8541c-e9c1-bb40-af0e-9105066d6cb7
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:88f8541c-e9c1-bb40-af0e-9105066d6cb7
msgctxt "h76c5f318g802eg4711g8913gd7d33cba68fb"
msgid "Please - out of the dark, before it claims me..."
msgstr "제발, 어둠에서 벗어나. 그게 날 원하기 전에..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 88f8541c-e9c1-bb40-af0e-9105066d6cb7
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:88f8541c-e9c1-bb40-af0e-9105066d6cb7
msgctxt "he764bc55g70bcg437agbd7bg7509bfac2bfe"
msgid ""
"I'm running out of steam here. I need to get out of these shadows, or find "
"some light."
msgstr "힘이 바닥나고 있어. 이 그림자에서 벗어나던지, 빛을 찾아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 88f8541c-e9c1-bb40-af0e-9105066d6cb7
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:88f8541c-e9c1-bb40-af0e-9105066d6cb7
msgctxt "hda192f09g1759g44e3g813ag07b85c050e6e"
msgid "The shadow curse claws at me. Need some light."
msgstr "그림자 저주가 날 찢어발기고 있네. 빛이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 88f8541c-e9c1-bb40-af0e-9105066d6cb7
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:88f8541c-e9c1-bb40-af0e-9105066d6cb7
msgctxt "h8a5f418agfd8bg4451g8efbgeaad2dbfa382"
msgid "Please - I can't go much further. Light up the darkness..."
msgstr "제발, 이대로 멀리 갈 순 없어. 어둠을 밝혀줘..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 9fa4fb25-93a2-1227-536f-1fe048a911e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:9fa4fb25-93a2-1227-536f-1fe048a911e2
msgctxt "h970146c0g01f8g4f79gb5b6g70f1b6ebc610"
msgid "The curse is feeding on me - Shar's withdrawn her protection."
msgstr "저주가 날 먹어치우고 있어. 샤님이 보호를 철회하신 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = a57d4c02-ec3c-7864-ef22-dce705d9f424
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_CurseResistant = True
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = False
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:a57d4c02-ec3c-7864-ef22-dce705d9f424
msgctxt "h29af24c5g4a6eg458dga8f9g69e9aab2557b"
msgid "These cursed shadows. I can see your strength wilting by the moment."
msgstr "이 저주받은 그림자들. 지금도 네 힘이 빠져나가는 게 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = b514b8db-57fd-08a7-b020-b05d0f88bae6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:b514b8db-57fd-08a7-b020-b05d0f88bae6
msgctxt "hd99ee606gebcfg475ag83f7g32319b36d062"
msgid "Urgh, this darkness is gnawing at me."
msgstr "으윽, 이 어둠이 나를 갉아먹고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = b514b8db-57fd-08a7-b020-b05d0f88bae6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:b514b8db-57fd-08a7-b020-b05d0f88bae6
msgctxt "h180592b9g67b3g463aga94fgc0c6d5922850"
msgid "This darkness - it's too much. I won't last long like this."
msgstr "이 어둠은 지나치군. 이대로는 오래 버티지 못 하고 말 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = b514b8db-57fd-08a7-b020-b05d0f88bae6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:b514b8db-57fd-08a7-b020-b05d0f88bae6
msgctxt "h85578bb7g3a0fg4a58ga8b8gdc0149c43884"
msgid "Agh... I'll be sucked dry of all life if I linger here..."
msgstr "으윽... 여기 오래 있다간 모든 생명이 빨려 먹히겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = b514b8db-57fd-08a7-b020-b05d0f88bae6
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:b514b8db-57fd-08a7-b020-b05d0f88bae6
msgctxt "hdec99041g2d0bg4ef1g9dbcg69f2479aa202"
msgid "<i>Ngh. </i>This bloody darkness is sapping the life right out of me."
msgstr "<i>으윽.</i> 이 빌어먹을 어둠이 내 생명을 뽑아내고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = b514b8db-57fd-08a7-b020-b05d0f88bae6
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:b514b8db-57fd-08a7-b020-b05d0f88bae6
msgctxt "h0d898850g13f1g4b3cgb3b9g8341e4f7602b"
msgid "This isn't right. I feel like absolute shit in this darkness."
msgstr "이건 아냐. 이 어둠 속은 완전 개똥 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = b514b8db-57fd-08a7-b020-b05d0f88bae6
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:b514b8db-57fd-08a7-b020-b05d0f88bae6
msgctxt "hc42f61dcgb4adg4267g83a1g17203f1eed99"
msgid "The darkness is hungry here. I can feel them sapping my strength."
msgstr "이곳 어둠은 굶주렸다네. 내 힘을 갉아먹는 게 느껴지는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = b514b8db-57fd-08a7-b020-b05d0f88bae6
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:b514b8db-57fd-08a7-b020-b05d0f88bae6
msgctxt "h627d3d84g6564g47b0g9678ga5d0b83764b0"
msgid "My energy's draining. The darkness is taking its toll."
msgstr "내 힘이 고갈되고 있어. 이 어둠이 피해를 주는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd194751-2ab0-899f-3373-5c05816f87ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(0) = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd194751-2ab0-899f-3373-5c05816f87ac
msgctxt "hb1591b6dg3465g479cg9650ga4806a031e70"
msgid "The darkness is encroaching. Can't linger here - not like before."
msgstr "어둠이 잠식하고 있어. 전처럼 여기서 꾸물댈 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h3a288572ga810g41c9ga5c7g06d88fc98dad"
msgid "I've never felt so drained..."
msgstr "이렇게 기운 빠지는 건 처음인데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h6004aac7ga5e8g4750g8aaeg929fd08c338c"
msgid "Not sure... how much farther I can go..."
msgstr "내가... 얼마나 더 걸을 수 있을 지 모르겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h98c100e9gc704g4ae5g9ef2g8a4af7c4060f"
msgid "My breath is... ragged. We mustn't fall to the curse..."
msgstr "숨이... 거칠어지는군. 저주 속에 있으면 안돼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h260537dagb6beg44e1gbd9dgf36067f29045"
msgid "I - I can't go on much longer."
msgstr "난... 난 더는 못 버티겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h19e3c6b0gb76dg4d37ga204gf41843ae442b"
msgid "The shadows are sparing me - but we need to get you some help."
msgstr "그림자는 나를 해치지 않아, 하지만 좀 도와주면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h5373dc4ag9bf0g4cd6gb461g6ea24e0c3084"
msgid "I... I won't last much longer."
msgstr "난... 오래 버티진 못할 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h865b4accgf8f7g4ae4gad46gc7e3de1a7359"
msgid "I cannot... cannot continue much longer."
msgstr "난... 오래 버틸 수 없을 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = bd1f31da-0eac-4555-bf3e-86f790764260
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:bd1f31da-0eac-4555-bf3e-86f790764260
msgctxt "h5a9bc292g0a88g4b28g9524gefc736425f43"
msgid "Can't... can't continue like this..."
msgstr "이렇게... 계속 갈 수는 없어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "h8f63f09fg9726g4203gbde8ge1eb3d695098"
msgid "We just need some light... banish this darkness..."
msgstr "빛만 좀 있으면 돼... 이 어둠을 없애려면 말이야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "h83e6619dg386ag45c1gbd96g4f85c2a43aea"
msgid "We need to escape these shadows, while we still have the strength."
msgstr "아직 우리에게 힘이 남아있는 동안, 이 그림자에서 벗어나야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "h34e32a33gfc91g489bg9496g9bda4d26c5d2"
msgid "We must chase the darkness away, or we are lost."
msgstr "우리가 이 어둠을 쫓아내야 한다, 그렇지 않으면 실패하게 될 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "hbca0507bgf14ag4da5ga46bga29b8bef18eb"
msgid "The darkness will take our very life force, as long as we're in it."
msgstr "우리가 이 어둠 속에 있는 한, 생명력을 계속 빼앗기게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "hcef7fb54gfbbeg4715g9056gb07d384077f2"
msgid "I'm not affected... curious."
msgstr "난 영향을 받지 않아... 기이하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "h59c494aeg22c2g4f79gaf54g05ea244e8728"
msgid "We need something to get rid of these shadows."
msgstr "이 그림자를 제거할 무언가가 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "h2e8e688bgd645g4a26g815cg6bfb7531309b"
msgid "We must dispel the shadows if we are to survive."
msgstr "우리가 살아남으려면 이 그림자를 쫓아버려야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = cbd6953b-fcde-089e-2fa1-fef6bbf0a368
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:cbd6953b-fcde-089e-2fa1-fef6bbf0a368
msgctxt "hb4f663b1g0eefg42bdgaf87gff6db942962c"
msgid "We've got to dispel these shadows... somehow."
msgstr "어떻게든... 이 그림자를 쫓아버려야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ddb7d8b9-412e-c14b-6a9c-99fb31e9272a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(0) = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ddb7d8b9-412e-c14b-6a9c-99fb31e9272a
msgctxt "h75596320g4682g4d81gb02bga353cdb59fa1"
msgid "The curse is feeding on me - Shar's withdrawn her protection."
msgstr "저주가 날 먹어치우고 있어. 샤님이 보호를 철회하신 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = e028050e-e730-2889-6687-dc15b0ae7f1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:e028050e-e730-2889-6687-dc15b0ae7f1f
msgctxt "h6bc81f77g65dag4be9g93f7g137f87b88f9d"
msgid "I can't - I can't take this darkness. I need some light."
msgstr "나... 나는 이 어둠을 버틸 수 없어. 빛이 좀 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = e028050e-e730-2889-6687-dc15b0ae7f1f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:e028050e-e730-2889-6687-dc15b0ae7f1f
msgctxt "hda91165ag9a1bg4eabg87c5g63cf1766562a"
msgid ""
"The darkness is <i>in</i> me. Clotting my blood, dissolving my bones. We "
"need light."
msgstr "어둠이 <i>내게</i> 스며들고 있다. 내 피가 멎고, 뼈가 산산조각 나는 느낌이야. 빛이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = e028050e-e730-2889-6687-dc15b0ae7f1f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:e028050e-e730-2889-6687-dc15b0ae7f1f
msgctxt "h92facf97g90b6g4faagab50g8579a66274da"
msgid "These shadows will be the death of me. We need light..."
msgstr "이 그림자는 우리에게 치명적이야. 빛이 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = e028050e-e730-2889-6687-dc15b0ae7f1f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:e028050e-e730-2889-6687-dc15b0ae7f1f
msgctxt "h1136f486gedddg46b3ga204g7560f173f1ba"
msgid ""
"The air reeks of death. Not sure how long I can hold out. We need light..."
msgstr "죽음의 악취가 나. 내가 얼마나 버틸 수 있을지 모르겠군. 빛이 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = e028050e-e730-2889-6687-dc15b0ae7f1f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:e028050e-e730-2889-6687-dc15b0ae7f1f
msgctxt "hbd5e4864g8ee6g4292gabefgcd90d933c807"
msgid "I swear, these shadows are eating my soul. We need light..."
msgstr "맹세하건대, 이 그림자가 내 영혼을 먹어 치우고 있어. 빛이 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = e028050e-e730-2889-6687-dc15b0ae7f1f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:e028050e-e730-2889-6687-dc15b0ae7f1f
msgctxt "h88f3ba26g4e88g4be2g9367g799dca38d272"
msgid ""
"The longer I stay here, the more the shadows will take from me. We need "
"light..."
msgstr "여기 오래 있을수록, 그림자가 내게서 더 많은 것을 빼앗아 갈 거야. 빛이 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = e028050e-e730-2889-6687-dc15b0ae7f1f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:e028050e-e730-2889-6687-dc15b0ae7f1f
msgctxt "hc5b23b8fgf6adg4ae2g8289g4f2f36423515"
msgid ""
"This darkness is suffocating. I - I can barely catch my breath. We need "
"light..."
msgstr "어둠을 버틸 수가 없어, 난... 난 간신히 숨 쉬고 있다고. 빛이 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ec8e0c69-578b-2c3e-c62d-312c51e9aa02
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ec8e0c69-578b-2c3e-c62d-312c51e9aa02
msgctxt "h43318740g2e6dg480egb75dg42f7649c05de"
msgid "You're all too right... I can feel it clawing at me."
msgstr "네가 전적으로 옳았군... 이게 날 찢어발기는 게 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ec8e0c69-578b-2c3e-c62d-312c51e9aa02
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ec8e0c69-578b-2c3e-c62d-312c51e9aa02
msgctxt "hf7e59454g2219g4f67g9c44g54b6ed633f18"
msgid "I need light... the darkness is consuming me..."
msgstr "빛이 필요해... 어둠이 날 먹어치우고 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ec8e0c69-578b-2c3e-c62d-312c51e9aa02
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ec8e0c69-578b-2c3e-c62d-312c51e9aa02
msgctxt "h0839b507g2d9ag45e4gb848gcca9fe43a218"
msgid "Please - I need light, or the darkness will take me..."
msgstr "제발, 빛이 필요해. 어둠이 날 데려갈 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ec8e0c69-578b-2c3e-c62d-312c51e9aa02
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ec8e0c69-578b-2c3e-c62d-312c51e9aa02
msgctxt "hc8768902g349eg4d57gb455ge578faf0c7de"
msgid "Please - the dark has nearly drained me. We need light."
msgstr "부탁이야, 어둠이 날 거의 집어삼켰어. 빛이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ec8e0c69-578b-2c3e-c62d-312c51e9aa02
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ec8e0c69-578b-2c3e-c62d-312c51e9aa02
msgctxt "h4e1c99a8g9ec8g44a8g8a90g384820b7e73f"
msgid "I think I'm 'most'."
msgstr "나 거의 '다된' 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ec8e0c69-578b-2c3e-c62d-312c51e9aa02
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ec8e0c69-578b-2c3e-c62d-312c51e9aa02
msgctxt "haca62df3g79afg44cdg895fg1837abe52995"
msgid "I cannot survive long without a light source."
msgstr "나는 광원 없이 오래 살아남을 수 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = ec8e0c69-578b-2c3e-c62d-312c51e9aa02
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:ec8e0c69-578b-2c3e-c62d-312c51e9aa02
msgctxt "h0cf78bbcg65ccg4209g9f8cgf30dee40ebbd"
msgid "Please, we've got to get to light..."
msgstr "제발, 우린 빛이 있는 곳으로 가야 해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = f30526fc-26df-71fa-7081-d67bc6565eb2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:f30526fc-26df-71fa-7081-d67bc6565eb2
msgctxt "h59914ab8g6425g474egbdeegafe3258668f5"
msgid "Alas, not all of us are so lucky."
msgstr "가엾게도, 우리 모두가 그렇게 운이 좋진 않네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = f30526fc-26df-71fa-7081-d67bc6565eb2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:f30526fc-26df-71fa-7081-d67bc6565eb2
msgctxt "h1c860e6dg4dbbg4968gbfb6gbb83585f5c86"
msgid "It's my spirit draining... only light drives the shadows away..."
msgstr "내 영혼이 빨려나가고 있어... 빛만이 그림자를 걷어낼 수 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = f30526fc-26df-71fa-7081-d67bc6565eb2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:f30526fc-26df-71fa-7081-d67bc6565eb2
msgctxt "h8f0578a5geea2g4e97gb290g252a19788f8b"
msgid ""
"How grand for you. They're draining me dry - I can barely catch a breath."
msgstr "거참 대단하군. 난 빨아 먹히고 있다... 숨도 겨우 쉴 지경이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = f30526fc-26df-71fa-7081-d67bc6565eb2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:f30526fc-26df-71fa-7081-d67bc6565eb2
msgctxt "h0b11472fg6159g4974gb64ege92430e119ba"
msgid ""
"I can't say the same. My self, my <i>spirit</i>, is being leeched out of me."
msgstr "난 아니야. 내 <i>영혼</i>이 빨려 나가는 느낌이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = f30526fc-26df-71fa-7081-d67bc6565eb2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:f30526fc-26df-71fa-7081-d67bc6565eb2
msgctxt "hfa91a501gd38dg4130g976ag047604d8cd4e"
msgid "Luck you."
msgstr "운 좋네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = f30526fc-26df-71fa-7081-d67bc6565eb2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:f30526fc-26df-71fa-7081-d67bc6565eb2
msgctxt "h4e37c75agc29ag47a7gb7e4g041b0461cba5"
msgid "I feel the curse... it's draining me..."
msgstr "저주가 느껴져... 나를 빨아 먹고 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = f30526fc-26df-71fa-7081-d67bc6565eb2
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:f30526fc-26df-71fa-7081-d67bc6565eb2
msgctxt "hefec98b3ga347g4f95g8247gb8fb76755b04"
msgid "I feel it, though. My very being, draining out of me."
msgstr "나는 아니라고. 내 존재가 자체가 빨려나가고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = fa4e98f7-fc6d-0682-f473-f60ead96723b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(0) = True
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:fa4e98f7-fc6d-0682-f473-f60ead96723b
msgctxt "hfacd750fgf546g42e3g91bag2959fc17b518"
msgid ""
"The shadows are draining me - I can't just walk through them like before."
msgstr "그림자가 날 집어삼키고 있어. 전처럼 그저 걸어서 지나갈 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = fb0000c4-cb32-c343-5c09-59d7c9110d22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_B = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_CurseResistant = True
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:fb0000c4-cb32-c343-5c09-59d7c9110d22
msgctxt "hce948e87gba1cg449bg8b6fg6a86606b4ffd"
msgid "Most would be unwise to linger in these shadows."
msgstr "사람들 대부분에게 이 그림자 속에서 꾸물거리는 건 현명하지 못한 일이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Karlach
#. NodeID = 237c493f-3276-4da3-b086-b42fad5a8832
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:237c493f-3276-4da3-b086-b42fad5a8832
msgctxt "h6742f2fag685cg4ed8gb917g44d31830c488"
msgid "Stand by me if you need to keep warm in this awful place."
msgstr "이 끔찍한 곳에서 온기를 유지하고 싶으면 내 옆에 있으라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Lae'zel
#. NodeID = 59b9c33c-6162-41a8-9ed8-963baeb6df65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(1) = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:59b9c33c-6162-41a8-9ed8-963baeb6df65
msgctxt "hf0fe8a0dg2798g43aag9b58g6791c914b832"
msgid ""
"Do you feel it? The chill on your skin, in your lungs? This darkness is "
"diseased."
msgstr "느껴지나? 네 폐와 살갗을 타고 흐르는 냉기가? 이 어둠은 우릴 병들게 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Wyll
#. NodeID = 6f5659e9-0385-4224-a4f8-7c9eef91446d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:6f5659e9-0385-4224-a4f8-7c9eef91446d
msgctxt "h873af900g0b78g4957g9eb7g701443dd0412"
msgid "A grim sight indeed. My lungs already grow heavy with shadow."
msgstr "실로 암담한 광경이군. 벌써 그림자 때문에 숨쉬기 힘들어지고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Shadowheart
#. NodeID = ae46e0f3-c674-4927-8093-08dde11ef5aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:ae46e0f3-c674-4927-8093-08dde11ef5aa
msgctxt "haf313a7cgb98eg4fdcg8230g5862fa9813fc"
msgid ""
"Those shadows; there's power coursing through them... oddly familiar. Better "
"stay on alert."
msgstr "어둡기만 한 게 아니야. 그림자에 힘이 흐르고 있어… 왜 익숙한 거지? 조심해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Gale
#. NodeID = b898a621-d6e6-4080-b0ba-6bb39c726f27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:b898a621-d6e6-4080-b0ba-6bb39c726f27
msgctxt "h834b9bfdg7187g4dccg9c58g18978ffbd2fb"
msgid "Better be careful around here..."
msgstr "여기선 조심하는 게 좋겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "h1cfa0c26gc658g419aga0d7gf1342d151c68"
msgid "What in the Hells is that? I'm not sure I want to step in there."
msgstr "도대체 저게 뭐지? 발을 들이고 싶지도 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "h88bff042g4a28g4fc5g9a5dg78b8e117d251"
msgid ""
"An entire domain, wrapped in shadow. This feels more like a god's work than "
"man's. I'm not sure I want to step in there."
msgstr "이 땅이 통째로 그림자에 둘러싸여 있어. 인간이 아니라 신이 벌인 일인 것 같군. 발을 들이고 싶지 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "h4b3c096cgf323g4d05gae3bg09d771a7e66e"
msgid ""
"Gods, what is this place? Looks like some dark god sneezed and this is what "
"was left behind. I'm not sure I want to step in there."
msgstr "맙소사, 여긴 대체 뭐야? 무슨 어둠의 신이 재채기하고 남은 흔적 같군. 발들이고 싶지 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "hb29cdeb2ge39ag45e8gabfdg5e8facad6c5d"
msgid ""
"<i>Tsk'va! </i>What is this ghastly place? I'm not sure I want to step in "
"there."
msgstr "<i>츠크바!</i> 이 무시무시한 곳은 무엇이냐? 발을 들이고 싶지도 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "h47cae608g4c67g4191g9436gfa7c35c5987e"
msgid ""
"Hells... that's quite a view. What happened here? I'm not sure I want to "
"step in there."
msgstr "맙소사... 놀라운 광경인데. 무슨 일이 있었던 거야? 발을 들이고 싶지도 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "h86e551deg1654g4263gbbccg7c5c034ae5b4"
msgid ""
"By Balduran's bones - the land is swallowed in shadow... I'm not sure I want "
"to step in there."
msgstr "발더란의 뼈다귀여, 저주가 이 땅을 집어삼켰어... 발을 들이고 싶지도 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "h0920bcb4g3b0fg4b89g819bg155089cf45a5"
msgid ""
"What is this place? The extent of the corruption here is... almost "
"impressive. I'm not sure I want to step in there."
msgstr "대체 이곳은 뭐지? 오염의 정도가...인상 깊을 지경이군. 발을 들이고 싶지도 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d0ff3584-725c-c790-31a7-b5993e08c4ac
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_UNDERDARK
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d0ff3584-725c-c790-31a7-b5993e08c4ac
msgctxt "hd882b98fg2c57g43c1g9ad0g48bc04e5bff3"
msgid ""
"What is this place? Makes the Underdark look like a sunlit meadow... I'm not "
"sure I want to step in there."
msgstr "대체 이곳은 뭐지? 언더다크가 햇볕 쬐는 초원처럼 보일 정도로군... 발을 들이고 싶지도 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "hed20c88cg8245g4126g96f2gfebf14a269fb"
msgid "Hells. I knew the land was cursed, but this is impressive."
msgstr "젠장. 이 땅이 저주받았단 건 알았지만, 이건 좀 인상적이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "h03bc56feg50ecg496egbbc6geab4932984fb"
msgid ""
"An entire domain, ensconced in shadow curse. That's quite the enchantment."
msgstr "지역 전체가 그림자 저주에 갇히다니. 심상치 않은 사술이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "h5161be89g0199g4f72gbc44g8ec16e89d1db"
msgid "I don't know what I expected, but damn - this place is <i>cursed.</i>"
msgstr "나도 내가 뭘 기대했는지 잘 모르겠지만, 젠장. 여긴 끔찍하게 <i>저주받았어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "h6889e380gd0e6g43dag831fg9372c34106a2"
msgid "<i>Tsk'va! </i>Is this the shadow curse? Most ghastly. Most impressive."
msgstr "<i>츠크바!</i> 이게 그림자 저주란 말이냐? 더없이 무시무시하고 더없이 인상적이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "he1018e3fg8598g453dgb0a1gcff5c5efb425"
msgid ""
"The shadow curse. I tried to picture it in my head, but <i>this</i>... this "
"is a lot."
msgstr "그림자 저주야. 내 머릿속으로 그려보려 했지만, <i>이건</i>... 상상 이상이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "h1ba2c1dcgfc5cg4c8cga4a3gfc3e78dcd097"
msgid ""
"By Balduran's bones - Halsin spoke true. The land is swallowed by curse."
msgstr "발더란의 뼈다귀여, 할신이 옳았어. 저주가 이 땅을 집어삼켰어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "he64d57fdg6ffbg40adgbd76g52187cedadcc"
msgid ""
"So this is the shadow curse. The scale of the corruption here is... "
"impressive."
msgstr "이게 바로 그림자 저주로군. 오염의 규모가...참 인상적이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Player
#. NodeID = d157bddc-1042-834e-dfe2-910683f66b95
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_ShadowCurse = True
#.      - IMPOSSIBLE = True
#. TagRule: REALLY_UNDERDARK
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:d157bddc-1042-834e-dfe2-910683f66b95
msgctxt "hf9d87458g4ccag4ec6gb6d4gc3d0f050775a"
msgid ""
"The shadow-cursed lands... makes back home in the Underdark seem quaint."
msgstr "그림자 저주를 받은 땅이라... 언더다크의 고향이 생각나는 묘한 풍경이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Astarion
#. NodeID = ea2f9c0b-6d37-4d72-b5c3-27156233191c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:ea2f9c0b-6d37-4d72-b5c3-27156233191c
msgctxt "h1be5b6f3g4dd6g4491ga87egcc90ff404c86"
msgid "I won't have to worry about the sun, at least."
msgstr "적어도 햇빛 걱정은 할 필요 없겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark
#. Speaker = Narrator
#. NodeID = fcb8f87d-8305-7294-907c-e0f8f27924d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_Underdark:fcb8f87d-8305-7294-907c-e0f8f27924d5
msgctxt "hd9ef1cdeg3590g4245gb907gb757c6500e19"
msgid ""
"*This is no ordinary darkness. It feels powerful... and familiar. These "
"lands have been blessed by Lady Shar. You must learn more about her presence "
"here.*"
msgstr ""
"*일반적인 어둠이 아닙니다. 강하며... 친숙합니다. 샤 여신의 축복을 받은 땅입니다. 여신의 존재에 대해 더 알아봐야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_AD_MountainPassSignpost
#. Speaker = Narrator
#. NodeID = 4ae9c85c-936e-44cf-a325-22e9950c3c3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_AD_MountainPassSignpost:4ae9c85c-936e-44cf-a325-22e9950c3c3a
msgctxt "h37262f79g6eceg4d24g9758gb30120ecee12"
msgid "*Chionthar Mountain Pass - East. Reithwin and Moonrise Towers - West.*"
msgstr "*치온타르 산길 - 동쪽. 라이스윈 및 문라이즈 타워 - 서쪽.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_AD_Signpost
#. Speaker = Narrator
#. NodeID = 0e57e9d3-71f8-49be-8db2-f1ef08a9c4ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_AD_Signpost:0e57e9d3-71f8-49be-8db2-f1ef08a9c4ec
msgctxt "h31e1c1bbged59g48a3g9a41g3bde7e5fe188"
msgid "*Last Light Inn, west. Moonrise Towers, southwest.*"
msgstr "*최후의 빛 여관, 서쪽. 문라이즈 타워, 남동쪽.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_PAD_HalsinBridge
#. Speaker = Halsin
#. NodeID = bc8bc5bf-aa3b-4c15-9f81-f571626b5662
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_PAD_HalsinBridge:bc8bc5bf-aa3b-4c15-9f81-f571626b5662
msgctxt "h3a0c84f8ged5fg4b47g8dafg45b8ebad0ba3"
msgid ""
"This town - I remember it too well. Much druid and Harper blood was spilled "
"in taking it... only to lose it again."
msgstr "이 마을... 기억이 아직도 생생하군. 여길 확보한다고 드루이드와 하퍼가 피를 많이도 흘렸지... 결국엔 잃어버렸지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_VB_RoadToPlains
#. Speaker = Player
#. NodeID = 177efe88-bc03-b5bd-ff97-6cfc1d908d2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_General_VB_RoadToPlains:177efe88-bc03-b5bd-ff97-6cfc1d908d2f
msgctxt "haf8368c2g207fg4824gb2e1gefa536851fc0"
msgid "It's brighter up ahead. Looks like the plains."
msgstr "저 앞에 밝은 곳이 보이는 군. 평원 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_GithCreche_GithExplorer_Dead
#. Speaker = Player
#. NodeID = 03ab39a0-970f-4a2a-a5c8-b27e862290ff
