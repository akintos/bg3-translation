#.     - MOO_Jailbreak_Event_ADEscaping(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:79d44293-3ce7-4362-b9d5-e941bd387d92
msgctxt "hacf8ad75g507eg4381g916eg8554a4dbb0cb"
msgid "Musn't stop. Musn't look."
msgstr "멈추지 마. 듣지도 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = 8680db28-a746-9c19-3911-2e4308e2c4e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:8680db28-a746-9c19-3911-2e4308e2c4e8
msgctxt "h9fc88431g86d7g427fg9717gd260983092fb"
msgid "Stop the evil ones. Stone - help me free the boat."
msgstr "사악한 무리를 막아라. 돌이여 배를 움직일 수 있도록 도와주소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = 95835958-f466-3d16-21b0-7bb8247ff084
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_OneChainLeft = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:95835958-f466-3d16-21b0-7bb8247ff084
msgctxt "h6c5f7b45g02b8g475dg86f8gdc9453f795ba"
msgid "The boat is nearly free - do not fail now."
msgstr "배가 거의 준비됐어. 조금만 더 버텨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = 9a2a1cc2-c6e1-4a6f-9b75-1179dd849904
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADGoingToBoat(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADGoingToBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:9a2a1cc2-c6e1-4a6f-9b75-1179dd849904
msgctxt "hf7dbb44ag0696g48e9g8df6gf97bf9a3e5d6"
msgid "The stone says the boat - the boat is the way!"
msgstr "돌이 배를 가리킨다. 배가 곧 길이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = bd0397f0-13f2-0dc9-2725-96a99ba19a85
