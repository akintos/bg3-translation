msgctxt "h9ef4bd9fgc368g4215g80c4g68db370baed8"
msgid "Eh... moo."
msgstr "어... 무우."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Player
#. NodeID = c99d676f-0b7d-9df7-1550-3a5f8cdc2a04
