#.     - CAMP_Jergal_Event_ResurrectPlayer_3 = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:46bc06f0-aefe-ba11-4c44-f0c6b70d648c
msgctxt "h3cc0a668g3acbg43ccg9e1cgc805d0e73e88"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 497251b7-822a-971c-da8e-7f26cc038dd4
