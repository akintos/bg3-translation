#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:6e6366a2-83a6-4680-a912-628e6ba49e90
msgctxt "hcacb8ffag439cg41c8gb3c6g8537921762c9"
msgid "I need to find new hiding spots."
msgstr "숨을 곳을 새로 찾아봐야겠어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = f78b7a47-6196-4d2a-89b4-d6ca9944e5ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = True
#.   Local:
#.      - 8baf8087-81b0-de5d-3efa-f74769a625f4_C = True
#. SetFlags:
#.   Local:
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_B = False
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_C = False
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:f78b7a47-6196-4d2a-89b4-d6ca9944e5ce
msgctxt "hf5975f13gd902g44e8gb0d4gc5a3a7049ba3"
msgid "Maybe I should be quieter when I'm hiding..."
msgstr "숨어 있을 때는 좀 더 조용히 해야겠어…."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = ff9413a9-269b-a916-2515-0e0e0e7b7d4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = False
#. SetFlags:
#.   Local:
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:ff9413a9-269b-a916-2515-0e0e0e7b7d4a
msgctxt "hfca5097cg4a1fg4af6gab90g9500735897ad"
msgid "Not very sneaky, are you?"
msgstr "살금살금 하는 데에는 소질이 없나 봐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Dome25PercentHP
#. Speaker = Oliver
#. NodeID = 0fc63c53-ab48-c8be-7388-2de7750b172e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Dome25PercentHP:0fc63c53-ab48-c8be-7388-2de7750b172e
msgctxt "h0df83c44g37deg4dfag99fag3830df7f0bd0"
msgid "Why are you doing this? All I wanted to do was play!"
msgstr "너 도대체 왜 이러는 거야? 난 그냥 놀고 싶었다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Dome50PercentHP
#. Speaker = Oliver
#. NodeID = 888ba162-48a2-ab4a-1394-35be0d54e1fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Dome50PercentHP:888ba162-48a2-ab4a-1394-35be0d54e1fc
msgctxt "h12bb5a5cge4f4g464dga9cdg7eab444449d7"
msgid "You're spoiling my fun! Stop it right now, or you'll be sorry!"
msgstr "네가 내 놀이를 망치고 있잖아! 당장 그만두지 않으면 후회하게 될 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Dome75PercentHP
#. Speaker = Oliver
#. NodeID = 4dbed217-fbe4-adba-7dac-807007ec1c0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Dome75PercentHP:4dbed217-fbe4-adba-7dac-807007ec1c0c
msgctxt "hb01eb7f2g520eg4fa2g8ed3g765663f95fa9"
msgid "Stop that! You're supposed to be playing, not breaking things!"
msgstr "그만해! 나랑 놀지도 않고, 다 망가뜨리면 어떡해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_FriendsSummoned
#. Speaker = Oliver
#. NodeID = c99de3a3-6fba-91fb-b57e-6e46ef94aab9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_FriendsSummoned:c99de3a3-6fba-91fb-b57e-6e46ef94aab9
msgctxt "hf50f78d2g9797g4108g8833gddbb114f02fc"
msgid "I'll make my own fun if I have to - and my own <i>friends</i>."
msgstr "필요하면 내 마음대로 놀이를 만들어 낼 거야. <i>친구들도</i> 만들어내고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Hiding
#. Speaker = Oliver
#. NodeID = 51a74484-350d-4073-8847-62675cd8eb36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 670691d1-78cb-7a29-2c96-f537d9b6a439_A = True
#. SetFlags:
#.   Local:
#.     - 670691d1-78cb-7a29-2c96-f537d9b6a439_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Hiding:51a74484-350d-4073-8847-62675cd8eb36
msgctxt "hb1061205g319fg46cfgaa17ge7bb61a8cf0d"
msgid "Come on, are you even looking?"
msgstr "빨리, 찾고 있긴 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_Hiding
#. Speaker = Oliver
#. NodeID = 8252b2fb-bc88-4928-8b34-937c15e295c4
