#.     - SHA_Displacer_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:331a05c8-6d9f-d024-4767-8e46816c79dc
msgctxt "h11eb37b5gbb14g48b1ga7f2g31822201a38e"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 3521d65d-096a-914c-2fa9-2e88ff845038
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:3521d65d-096a-914c-2fa9-2e88ff845038
msgctxt "h2c893d6bge6e2g45e1g9e6bg4936d727edac"
msgid "Slave? You dare call master's heart-jewel a <i>slave</i>?"
msgstr "노예라고? 감히 주인님의 진심 어린 보석에게 <i>노예</i>라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 39873249-b26f-9643-c3de-96a0567dd787
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:39873249-b26f-9643-c3de-96a0567dd787
msgctxt "h1bf218fegf1d2g47e5ga9a5g1eeb4f9456a5"
msgid ""
"*You see nothing nearby that might appeal to a displacer beast's desires.*"
msgstr "*근처에 디스플레이서 비스트의 욕망에 끌릴만한 것은 보이지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 3b39c3e5-6bad-c3dd-6089-5b90455e68eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:3b39c3e5-6bad-c3dd-6089-5b90455e68eb
msgctxt "h20e763c4g9948g476dgba99gae9b45e20e8c"
msgid "I'll not start the fight but I'll help you end it."
msgstr "내가 싸움을 시작하지는 않겠지만 끝낼 수 있도록 도와주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 3d43b32f-b7a4-2667-9dc9-95c1727239e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:3d43b32f-b7a4-2667-9dc9-95c1727239e8
msgctxt "h699d1612g82c6g47c6g9467g252b3d0eabe7"
msgid "Live and let love, I suppose."
msgstr "사랑하며 살아가는 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 3d5e3c72-3ab9-4b58-8231-22ea38636f77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:3d5e3c72-3ab9-4b58-8231-22ea38636f77
msgctxt "h7f9f8d48gc195g4863g8657g93ddb6da8d38"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 3d73a1eb-7359-1799-ca4c-b77b094fd678
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:3d73a1eb-7359-1799-ca4c-b77b094fd678
msgctxt "h7256a2c5g8138g46cdg87ddg3104833909b4"
msgid "My claws itch, my blood burns."
msgstr "내 발톱이 근질근질하고, 피가 끓어오르는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 42d8d997-a521-7465-2e9c-ff5ee880f393
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:42d8d997-a521-7465-2e9c-ff5ee880f393
msgctxt "hc725227bg8c9dg4416g866eg1da9360d8bd8"
msgid "Now let that silence stick."
msgstr "계속 그렇게 입다물고 있는 게 좋을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 4380f3ae-7583-4b8d-8dd5-95c93d23b1a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_Event_AnimalHandlingSuccess(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:4380f3ae-7583-4b8d-8dd5-95c93d23b1a6
msgctxt "h7fc6aee2gcc77g41c9g9e69g9a7e93cbe457"
msgid "*The beast stares at you.*"
msgstr "*짐승이 당신을 응시합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 449b39ed-9ca7-5eef-3368-7f4590254309
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:449b39ed-9ca7-5eef-3368-7f4590254309
msgctxt "h5a3980bbge77bg46b3g96cbg399dd43f51e3"
msgid "But it's <i>ridiculous</i>."
msgstr "하지만 <i>웃기잖아</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 465d7288-253b-f4b3-a642-dddd03caafe8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_HasMet(1) = False
