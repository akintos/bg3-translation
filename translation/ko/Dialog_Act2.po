msgctxt "hf785d15dg4753g4db0g8683gab84127a4e13"
msgid "A most excellent choice, master."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon
#. Speaker = Malus Thorm
