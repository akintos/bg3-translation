msgctxt "h3c6e3cabgee76g41aeg8f7dg07e137833ea4"
msgid "Stay lit, you useless stick!"
msgstr "꺼지지 말라고, 이 쓸모없는 작대기야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
