#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_HarperQuartermaster:77cd1a18-4eeb-1a12-e718-89f418c0f2f4
msgctxt "h04788031g7126g4f7cg8a9dg3c926cefcaa2"
msgid "Anything I could take off your hands at no cost to myself?"
msgstr "아무거나 공짜로 줄 만한 거 뭐 없나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_HarperQuartermaster
#. Speaker = Quartermaster Talli
#. NodeID = b4cf6761-411f-4e68-ad17-a737be93465a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_HarperQuarterMaster_HasMet_Alert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_HarperQuartermaster:b4cf6761-411f-4e68-ad17-a737be93465a
msgctxt "hd688012dg8488g491aga791gf6a8f55ece6b"
msgid ""
"See if there's anything you need. We don't know when the next blow might "
"land."
msgstr "필요한 게 있나 확인해 봐. 다음 공격이 언제 닥칠지 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_HarperQuartermaster
#. Speaker = Player
#. NodeID = b8e32bdc-d8dc-aeea-1cde-46c02661db65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_HarperQuartermaster:b8e32bdc-d8dc-aeea-1cde-46c02661db65
msgctxt "h5cbfb5f1g87e0g492bg8d42gaa6a4b8ef27d"
msgid "Let's see your wares."
msgstr "물건 좀 봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_HarperQuartermaster
#. Speaker = Quartermaster Talli
#. NodeID = be690a38-22b2-469d-acf9-be01f8c485ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_HarperQuarterMaster_HasMet_Protected(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_HarperQuarterMaster_HasMet_Protected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_HarperQuartermaster:be690a38-22b2-469d-acf9-be01f8c485ce
msgctxt "h1dd3c4bag5a56g4112gb7f1gf826069b1751"
msgid ""
"Stock up while you can. I only hope I've brought enough to see us through."
msgstr "챙길 수 있을 때 챙기라고. 내가 가져온 게 충분했으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_HarperQuartermaster
#. Speaker = Quartermaster Talli
#. NodeID = db920197-e7ae-f787-f7da-7e4427e9b581
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_HarperQuartermaster:db920197-e7ae-f787-f7da-7e4427e9b581
msgctxt "hec5ff519ga40eg4e49g8c92gf397ba593f34"
msgid "Sorry; if it costs me, it costs you."
msgstr "미안; 나도 돈 주고 산 거니까, 너도 돈 주고 사야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_HarperQuartermaster
#. Speaker = Quartermaster Talli
#. NodeID = ebd879f4-bbb0-a1fd-f985-da15c9a9ceef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_HarperQuartermaster:ebd879f4-bbb0-a1fd-f985-da15c9a9ceef
msgctxt "h139cf8d6g71abg40dbg8a37gc3025a38f2f5"
msgid "Take care now."
msgstr "몸 조심해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_RoofWatcher_Caster
#. Speaker = Harper Terradissia
#. NodeID = 11310101-1499-ba93-db45-42b1ca71a00d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
