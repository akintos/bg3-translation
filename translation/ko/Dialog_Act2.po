msgctxt "h6004b91cg4dc5g4198g9f4dg79b3eb1dd597"
msgid "Meenlocks. Just what we needed."
msgstr "민록이야. 적재적소에 나타나 주시는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
