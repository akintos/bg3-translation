msgctxt "hdfb477d4g1244g4115gbc43gf0831c4d20ca"
msgid "No flame can withstand the shadow curse. Torches are useless here."
msgstr "어떤 불도 그림자 저주를 버틸 수 없네. 횃불은 여기서 쓸모가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 4ef4b11f-4366-4107-9062-539d468fc2b6
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Local:
