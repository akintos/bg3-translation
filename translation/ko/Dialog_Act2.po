msgctxt "hca7a3911g9f9ag4c6cg8ff4g35d8b1b99a5f"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Astarion
#. NodeID = c9430b3e-36cc-49d7-aa11-6d9dc8ebd6c5
