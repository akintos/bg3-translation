msgctxt "h7e7d192bgfd05g46ccg9181gdf615b018d46"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = ec5a60ed-cd5a-43a8-858a-3cc79541f1d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:ec5a60ed-cd5a-43a8-858a-3cc79541f1d1
msgctxt "h677ea83eg8ed5g4ba8g9fe3ga16638801255"
msgid "Who are you?"
msgstr "넌 누구냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = f15d4bdc-ba8a-4b4a-9ffa-91ef70b6daa5
