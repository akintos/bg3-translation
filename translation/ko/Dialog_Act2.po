#. NodeID = 530411f6-e612-597e-6347-49848d1e6107
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_TadpoledSkeletons_Scouts:530411f6-e612-597e-6347-49848d1e6107
msgctxt "h52b44090g21c8g4234g8b9fg1526a4928557"
msgid ""
"Yet the Absolute has blessed you. Perhaps you will be useful. Present "
"yourself at my camp and -"
msgstr "허나 절대자께서 너를 축복하셨다. 아마 너는 쓸모가 있겠지. 내 야영지에 네 모습을 보이고..."

