msgctxt "h61423733g70b2g4f0dga133g6139c04cc9fa"
msgid "What was that? I feel strange... <i>clear</i>."
msgstr "뭐였지? 이상한 기분이야... <i>맑은 기분</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 05a5deee-df33-ab5f-8b11-ee6efe4fadf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:05a5deee-df33-ab5f-8b11-ee6efe4fadf8
msgctxt "hbaf66278g344cg4409gbe78gfcff40933b78"
msgid ""
"*The only paw prints you can see belong to the beast itself - it has neither "
"mate nor litter.*"
msgstr "*저 짐승의 발자국 외에는 보이지 않습니다... 짝도 없고 새끼도 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 07f77bad-9a86-7640-dea0-98619cfe239c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:07f77bad-9a86-7640-dea0-98619cfe239c
msgctxt "h10ce8125g9187g4e3egaf78g1e270435a416"
msgid "I doubt he loves you back."
msgstr "그도 너를 사랑할지 의심스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
