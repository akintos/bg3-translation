msgctxt "h07ff7586g1246g40d3ga7d3g02b7475021fb"
msgid "*Chitter*"
msgstr "*크릉*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kitchen_AD_Gnoll02
#. Speaker = 'Tomelia'
#. NodeID = a5fb392e-82b9-4d94-b191-9d61e9cab4da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kitchen_AD_Gnoll02:a5fb392e-82b9-4d94-b191-9d61e9cab4da
msgctxt "h3ca25f19g7fdcg4296gbf83g7941ac352ad1"
msgid "*Snarl*"
msgstr "*으르렁*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Library_AD_Minthara_EnteredLibrary
#. Speaker = Nightwarden Minthara
#. NodeID = ac923101-5fc5-5a51-708d-8300b012d334
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Library_AD_Minthara_EnteredLibrary:ac923101-5fc5-5a51-708d-8300b012d334
msgctxt "hdfc2c133gfac3g459fg86ddg59330e3a26fd"
msgid "Security is tight here. Z'rell made this library her command post."
msgstr "경비가 삼엄하군. 즈렐이 이 도서관을 지휘 본부로 만들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_FailedInterrogation
#. Speaker = Nightwarden Minthara
#. NodeID = e8526af2-560f-3c91-5085-9827b4f12a1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_FailedInterrogation:e8526af2-560f-3c91-5085-9827b4f12a1d
msgctxt "h7c523a09g47c9g4c23gb695ga1d8f964194c"
msgid "You should have let me pass - now, you'll die."
msgstr "순순히 지나가게 하는 게 좋았을걸 - 그렇게 원한다면 죽여주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_AttackedTorturers
#. Speaker = Nightwarden Minthara
#. NodeID = 5c36ffb0-e5f0-4131-a298-9f25c631941d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_AttackedTorturers:5c36ffb0-e5f0-4131-a298-9f25c631941d
msgctxt "heb7816fagb517g4d0dgad6fgdc38a780a9db"
msgid "You dared scar my mind, I will gut you."
msgstr "네 따위가 감히 내 정신을 희롱하려 들다니, 갈기갈기 찢어 줄 테다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_FailedInterrogation
#. Speaker = Nightwarden Minthara
#. NodeID = e8526af2-560f-3c91-5085-9827b4f12a1d
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_FailedInterrogation:e8526af2-560f-3c91-5085-9827b4f12a1d
msgctxt "haff87974gdf7eg41d0ga9b9gbaa2c4d6dd1a"
msgid "Let us free them of their god - and of their lives."
msgstr "저들을 신에게서 해방해 주자고 - 인생에서도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_FailedInterrogation
#. Speaker = Nightwarden Minthara
#. NodeID = e8526af2-560f-3c91-5085-9827b4f12a1d
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_FailedInterrogation:e8526af2-560f-3c91-5085-9827b4f12a1d
msgctxt "ha3097616gb5b4g4959gb55cg68435d800225"
msgid "Break them, before they call for help."
msgstr "저 녀석들이 지원군을 불러오기 전에 처치해 버리자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation
#. Speaker = Nightwarden Minthara
#. NodeID = 50dd934f-0e22-b599-32dd-00300169c18f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation:50dd934f-0e22-b599-32dd-00300169c18f
msgctxt "h27537c1fg61b4g4d9dg8211g5b46a1f5ed72"
msgid "Hmph. I would have preferred to bleed them."
msgstr "흠, 나라면 베어버렸을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation
#. Speaker = Nightwarden Minthara
#. NodeID = 50dd934f-0e22-b599-32dd-00300169c18f
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation:50dd934f-0e22-b599-32dd-00300169c18f
msgctxt "hbd8726bfg5d1eg4546g8fdagb362d4f7fa27"
msgid "You really do have a way with words."
msgstr "정말 말로 헤쳐나가는 방법을 잘 아는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation
#. Speaker = Nightwarden Minthara
#. NodeID = 50dd934f-0e22-b599-32dd-00300169c18f
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation:50dd934f-0e22-b599-32dd-00300169c18f
msgctxt "ha6c4088ega680g4ba2gb971g345d7c13b74e"
msgid "Their death is merely delayed - we will return and kill them all."
msgstr "그 녀석들의 삶이 조금 연장된 것뿐이야 - 돌아가서 다 쓸어버리자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation
#. Speaker = Nightwarden Minthara
#. NodeID = 50dd934f-0e22-b599-32dd-00300169c18f
#. HandlePath = TaggedText[0].TagText[3]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_PassedInterrogation:50dd934f-0e22-b599-32dd-00300169c18f
msgctxt "h795b8461g81d0g45b8g8f15g415cc0c22479"
msgid "We must leave quickly - I cannot hold my fury for long."
msgstr "빨리 이곳을 벗어나자 - 지금이라도 돌아가서 다 쓸어버리고 싶으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 02f3f07a-b3e8-4e98-b118-4af2c727eb31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 421668a5-7b68-9e8b-977b-522b4a071156_A = True
#. SetFlags:
#.   Local:
#.     - 421668a5-7b68-9e8b-977b-522b4a071156_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:02f3f07a-b3e8-4e98-b118-4af2c727eb31
msgctxt "h67629c83gc842g44d2ga5cagee1f7cfec7ea"
msgid "Queen of Spiders, I beseech of you the strength to destroy my foes."
msgstr "거미의 여왕이여, 당신의 힘으로 적들을 쓸어버리길 간청드립니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Sumera
#. NodeID = 14089257-a680-48ae-8580-13ac7fd8b63d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:14089257-a680-48ae-8580-13ac7fd8b63d
msgctxt "he7b18cbfgad31g4898g82ddgca42c71762c5"
msgid "We will cleanse you."
msgstr "네 존재를 지워 주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Sumera
#. NodeID = 292674be-2dc4-4589-94bf-d0a3db565ef3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:292674be-2dc4-4589-94bf-d0a3db565ef3
msgctxt "ha528f386g5a16g4443g8186g4991b2fa793e"
msgid "Lolth cannot hear you. She has forsaken you."
msgstr "롤쓰는 네년의 간청을 들을 수 없다. 넌 버려졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Sumera
#. NodeID = 3358f0ed-331e-4098-99e0-f00104cd067d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:3358f0ed-331e-4098-99e0-f00104cd067d
msgctxt "hefabe0d5gc3b1g4d55gb1fbg30c21f75165c"
msgid "Blasphemer!"
msgstr "신성 모독이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 38d161fb-55fb-47ac-8acc-468f383da2ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:38d161fb-55fb-47ac-8acc-468f383da2ae
msgctxt "h8cc5a30bg5767g4c45gaccfg71871deee5b3"
msgid "It is no god."
msgstr "신이... 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Sumera
#. NodeID = 40876a13-f1ea-4bd2-b8a5-5b019b515e28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 421668a5-7b68-9e8b-977b-522b4a071156_B = True
#. SetFlags:
#.   Local:
#.     - 421668a5-7b68-9e8b-977b-522b4a071156_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:40876a13-f1ea-4bd2-b8a5-5b019b515e28
msgctxt "h44789083g5a56g445aga52dg226e2f2c7d50"
msgid "You are despised, Minthara."
msgstr "네년은 멸시받아 마땅하다, 민타라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Jasin
#. NodeID = 48627d5d-30c6-4198-a1f9-bbba29f6cd0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:48627d5d-30c6-4198-a1f9-bbba29f6cd0b
msgctxt "h325ca588g46d9g48acg94a8g8efea61515d1"
msgid "A blemish in the Absolute's design."
msgstr "절대자님의 계획에 오점을 남기다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Jasin
#. NodeID = 4cfc30ec-f8ec-41a3-9b7f-99289721b0a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:4cfc30ec-f8ec-41a3-9b7f-99289721b0a4
msgctxt "hf4121c08g6627g4b06g82f0gb29772b8d825"
msgid "There are no gods left to you, Minthara. You are alone."
msgstr "네년을 구해 줄 신 따윈 없다, 민타라. 넌 혼자야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 69701cfa-fe3d-4b11-b1ce-f3698dc818b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:69701cfa-fe3d-4b11-b1ce-f3698dc818b5
msgctxt "ha799cd41g8e4cg4a26g82c5g1afc0e13177c"
msgid "Minthara Baenre."
msgstr "민타라 베인레."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Jasin
#. NodeID = 82bfbf42-0f3d-4f34-a30b-82c359116abd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 421668a5-7b68-9e8b-977b-522b4a071156_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:82bfbf42-0f3d-4f34-a30b-82c359116abd
msgctxt "h6435dde7ge888g4e71gb111g4dab18694bb9"
msgid "Do you yet recall your name, prisoner?"
msgstr "아직도 네 이름을 기억하나, 죄수?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Sumera
#. NodeID = 99440b61-a751-4b46-9da6-07d7ce42d85d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:99440b61-a751-4b46-9da6-07d7ce42d85d
msgctxt "h56e6c375gb5c0g497bgaf5egbe05caf31d3e"
msgid "We will take it from you soon."
msgstr "금방 다 지워 주도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture
#. Speaker = Questioner Jasin
#. NodeID = b7599174-f27f-4eac-ab4d-cac24f0daa06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 421668a5-7b68-9e8b-977b-522b4a071156_C = True
#. SetFlags:
#.   Local:
#.     - 421668a5-7b68-9e8b-977b-522b4a071156_A = False
#.     - 421668a5-7b68-9e8b-977b-522b4a071156_C = False
#.     - 421668a5-7b68-9e8b-977b-522b4a071156_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_Torture:b7599174-f27f-4eac-ab4d-cac24f0daa06
msgctxt "h04d30a09gbaa9g4421g9689g22a19e68c42e"
msgid "How can you hope to resist the voice of a god?"
msgstr "어찌 감히 신의 목소리에 저항하려 하느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Jasin
#. NodeID = 0441083b-28a3-49f7-9359-15eb71be7c51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:0441083b-28a3-49f7-9359-15eb71be7c51
msgctxt "h7667a35fg5d32g40ddgaa3cgadd01563e00b"
msgid "I wish we could go upstairs to watch."
msgstr "우리도 참관시켜 주신다면 좋을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Jasin
#. NodeID = 20c4be8f-c5e9-46f0-9c6d-f13fa05846fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:20c4be8f-c5e9-46f0-9c6d-f13fa05846fc
msgctxt "h72bbd967g2a5cg482dg9b35g49aa41d98ae6"
msgid "Always."
msgstr "언제나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Jasin
#. NodeID = 2e4cc614-d1f5-4fa4-acae-18ac7531c61b
