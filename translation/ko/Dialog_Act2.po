msgctxt "hfec0138ag1fd7g4194g9694gb08ddb3bfb4c"
msgid "The flames have been extinguished. A torch is no good in this place."
msgstr "불이 꺼졌어. 여기선 횃불이 쓸모가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
