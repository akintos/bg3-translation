#.      - HAV_HarperScouts_Harper_001_HasMet_Unprotected(1) = False
#.   Global:
#.      - HAV_Mood_State_Unprotected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HarperScouts_Harper_001_HasMet_Unprotected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001:ee0c4483-7e50-42c4-9ec4-abfa14b67434
msgctxt "h0c4124c3g3f42g47a1gbf4eg825f85938880"
msgid "I don't care what it takes; this place will <i>not </i>fall."
msgstr "무슨 수를 써도 상관없어. 이곳은 무너지지 <i>않을</i> 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001
#. Speaker = Player
#. NodeID = f0953aae-877f-5790-6b7b-010527e1becc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GRUUMSH or CLERIC_TEMPUS
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001:f0953aae-877f-5790-6b7b-010527e1becc
msgctxt "h826948a0gc4deg49d4gb634g312b93595483"
msgid "He died in battle - his valiant soul will heed your prayers."
msgstr "그는 싸우다 죽었어. 그의 용맹한 영혼이 네 기도를 들을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001
#. Speaker = Player
#. NodeID = f0953aae-877f-5790-6b7b-010527e1becc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_HELM and CLERIC_ILMATER and CLERIC_TYR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001:f0953aae-877f-5790-6b7b-010527e1becc
msgctxt "ha8ebaa7fg6dfag41fbga741gd43cec3b134a"
msgid "Keep lending his soul your prayers. The Triad listens. Always."
msgstr "그 자의 영혼을 위해서 계속 기도를 올려줘, 삼선신은 언제나 귀 기울여 듣고 계셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001
#. Speaker = Player
#. NodeID = f0953aae-877f-5790-6b7b-010527e1becc
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: CLERIC
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001:f0953aae-877f-5790-6b7b-010527e1becc
msgctxt "hbc473433gb436g49fegb23agb274be7c1b20"
msgid "Your prayers will honour his immortal soul - wherever it is."
msgstr "당신의 기도는 그 자의 불멸의 영혼이 어디에 있든 그 영혼을 기리게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001
#. Speaker = Player
#. NodeID = f0953aae-877f-5790-6b7b-010527e1becc
#. HandlePath = TaggedText[3].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_001:f0953aae-877f-5790-6b7b-010527e1becc
msgctxt "hd4b232c9g3b7eg48f6gbd72g4c2216a15ee1"
msgid "I'm sure he'd appreciate your prayers."
msgstr "그는 네 기도에 고마워할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_003
