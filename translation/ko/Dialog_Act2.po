#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:021fc0a0-d05a-d1e1-d7ae-90dca526d4e5
msgctxt "h3d7918d6g30dbg41a0g9ecag6ea8a3f2511c"
msgid ""
"<i>Despite knowing you're under the effects of a drug, try to deny the "
"tadpole has any influence over you.</i>"
msgstr "<i>약효가 도는 걸 알고 있음에도, 올챙이가 당신에게 전혀 영향을 미치지 않는다고 부정한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 0267a290-695f-ae3e-7b01-8e2e5b7c614c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:0267a290-695f-ae3e-7b01-8e2e5b7c614c
msgctxt "hb597ac1cg37a9g4069gb72fgc86e608f8129"
msgid ""
"The cult of the Absolute is spreading through the city - quietly, quickly, "
"and with unsettling deliberation."
msgstr "절대자의 교단이 도시 전체에 퍼지고 있어. 조용하지만, 빠르게, 그리고 불편할 정도로 신중하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 031c2df9-d12b-7da2-ba8b-4eaedb130aa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:031c2df9-d12b-7da2-ba8b-4eaedb130aa8
msgctxt "hf6d6eab6gf371g4082g9000g1a9f935a0ade"
msgid "Is this meant to be some kind of joke?"
msgstr "지금 농담하자는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 041c6585-c86d-de5a-5ee2-055812978e7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:041c6585-c86d-de5a-5ee2-055812978e7e
msgctxt "h14c507aeg4a6eg42d5gbcedged09e85110da"
msgid ""
"You'll have to sing that one for me, when all of this is done. In any case, "
"it was a lifetime ago by now. And for all our victories, we remain on the "
"back foot."
msgstr ""
"그럼 이 일이 끝나고 나면, 자네가 한 번 불러보지 그러나. 하여튼 지금은 다 지난 일이야. 과거에 무슨 일이 있었건 간에, 지금은 "
"궁지에 몰린 신세이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 048ed1a4-ff38-8ba7-e309-a30605d2a81e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:048ed1a4-ff38-8ba7-e309-a30605d2a81e
msgctxt "h478c6ffcg6350g4539gacb1g023e19019cf8"
msgid "My pleasure. Now - drink."
msgstr "별 말씀을. 이제 들이켜."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 05098319-5bdc-d1fd-539d-99e475312283
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:05098319-5bdc-d1fd-539d-99e475312283
msgctxt "hcd9771bagd18cg4307gbdbege091a3151874"
msgid ""
"I'm not always in control of my magic - who knows what will happen if I "
"drink this?"
msgstr "전 제 마법을 항상 통제할 수 있는 게 아니에요. 이걸 마셨다가 무슨 일이 일어날지 누가 알겠어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 05a646c8-7867-6532-4813-0b6cfe6e84f4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:05a646c8-7867-6532-4813-0b6cfe6e84f4
msgctxt "hf0464401gd3c4g44e9gad53g0c73ac52b05e"
msgid "<i>Smell the wine first.</i>"
msgstr "<i>먼저 와인 냄새를 맡는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 05e4b502-34c6-fd16-307e-ed1969d535dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:05e4b502-34c6-fd16-307e-ed1969d535dd
msgctxt "hb1c4a9e7gc236g4084gb197gaa37dce0aa19"
msgid "If it will help. Only remember:"
msgstr "그래야 한다면야. 다만 기억하게:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 06d00d46-54bf-f268-7274-b75b32aa65b1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:06d00d46-54bf-f268-7274-b75b32aa65b1
msgctxt "hd4ca1d6agece2g403dg972bg213416ec9f3c"
msgid ""
"But... so be it. It is you who has the key to Moonrise, not I. Do what you "
"must - if it rids us of this cult, we'll consider the price well-paid."
msgstr ""
"하지만... 어쩔 수 없군. 열쇠를 쥔 것은 내가 아니라 너지. 해야 할 일을 해라. 이 사교도 놈들만 없애준다면, 감수할 만한 "
"위험이었다고 여길 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = 09ad8480-8036-ca0a-cebd-2bb27983d11b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:09ad8480-8036-ca0a-cebd-2bb27983d11b
msgctxt "h1756ce14g99dag4093g96e1gc886c05e8f02"
msgid ""
"*You want to deny the parasite has any sort of hold on you, but somehow you "
"can't. Jaheira spots your confusion and her eyes narrow.*"
msgstr ""
"*당신은 기생충의 영향력을 부인하고 싶지만, 어째서인지 그럴 수가 없습니다. 자헤이라는 당신의 혼란을 알아채고 눈을 가늘게 뜹니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 09f2de2d-01f8-aab9-2fc3-f690a2fa9f29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:09f2de2d-01f8-aab9-2fc3-f690a2fa9f29
msgctxt "hdd84c7d9ga713g4a19g9c31ge6cb37fb9763"
msgid "I'm not doing this."
msgstr "난 빠지겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 0a2a72ed-673d-cac1-534d-9cb3738ca468
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:0a2a72ed-673d-cac1-534d-9cb3738ca468
msgctxt "h8dbf9494gb325g456fga8c1gdb8b56755048"
msgid "Volothamp Geddarm? That old fraud should be dust a century past."
msgstr "볼로뎀프 게담? 그 사기꾼 늙은이 진즉에 죽은 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 0b308464-afbf-fdea-24bd-afc5a0245b2f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - HAV_TakingIsobel_UserShortCut_SkipWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:0b308464-afbf-fdea-24bd-afc5a0245b2f
msgctxt "h398a65aag73c1g4137g9a68geed1a8cb3cee"
msgid "Good. I will take your word for it. And hold you to it, too."
msgstr "좋아. 네 말을 믿을게. 너도 계속 저항해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 0b5704c9-de33-42bb-5966-c10800c22f52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:0b5704c9-de33-42bb-5966-c10800c22f52
msgctxt "hf1b1064bg57fcg4d23gae24g43bdedc587ef"
msgid ""
"There is only one outcome that interests me - killing Ketheric Thorm, and "
"ensuring that it <i>sticks</i> this time."
msgstr "내가 관심 있는 건 하나뿐이다. 케서릭 쏨을 죽이는 거지. 그리고 이번에야말로 <i>다시 일어나지 못하게</i> 만들 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 0bb461c9-dda5-b085-baae-3115e1785fe5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:0bb461c9-dda5-b085-baae-3115e1785fe5
msgctxt "h19af95c7g94c4g447dgbd2dge671137a9ef5"
msgid ""
"Hope is an illusion - one easily shattered. I deal in action, so tell me - "
"what's the plan?"
msgstr "희망은 환상일 뿐입니다. 쉽게 흩어지죠. 전 행동하는 쪽입니다. 그래서 계획이 뭡니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 0c8d5ce5-5f80-92e4-03f7-3a2d14d5bbd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:0c8d5ce5-5f80-92e4-03f7-3a2d14d5bbd3
msgctxt "h3c92926cga9f6g4242g829age1292dff0ed8"
msgid "Perhaps we can force it out of him once we have him up against a wall."
msgstr "일단 놈을 궁지로 몰고나면, 전부 털어놓도록 만들 수 있을지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 0eaa1666-f6b4-85a2-b638-0396c77aa8b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:0eaa1666-f6b4-85a2-b638-0396c77aa8b7
msgctxt "hb0121768gcc79g4aa9g809dg5f12cac84b05"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 10bb1783-654e-0b51-973f-646e456af305
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:10bb1783-654e-0b51-973f-646e456af305
msgctxt "h3c9e32dbg6bdfg47edg9ef5g5d17ad0e6ebd"
msgid "You're quite serious, aren't you?"
msgstr "상당히 진지하군, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 12626c8e-7a2f-5717-38d4-2e04379a6318
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:12626c8e-7a2f-5717-38d4-2e04379a6318
msgctxt "h6d2f23f3g089bg4275ga6dbg66fc1394dffd"
msgid ""
"'The Glorious True Soul [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]"
"' will be the performance of a lifetime."
msgstr ""
"'영광스러운 참된 영혼 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]'. 이건 "
"일생일대의 공연이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 12a0c200-89d8-606e-f228-d9e93cc7cd18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:12a0c200-89d8-606e-f228-d9e93cc7cd18
msgctxt "hacf75c84g71d4g48fcga99dg6ec52ce936f3"
msgid ""
"From there, I made some inquiries of my own - saw first-hand how easily the "
"cult could turn friend to foe, with but the twist of a tadpole."
msgstr ""
"그 이후로 나는 혼자 몇 가지 조사를 실시했고 - 올챙이 한 마리가 얼마나 간단히 친구와 적들을 뒤바꿔 놓을 수 있는지 알게 됐지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 12fc1385-2d68-8e41-9833-7f20894c1082
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:12fc1385-2d68-8e41-9833-7f20894c1082
msgctxt "h62e1969cgf284g47b2g9ac3g4f9634ea946a"
msgid "We'll see."
msgstr "보면 알겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 132767cb-cdd7-6769-acf0-aee6548c5fe7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#. TagRule: PALADIN_ANCIENTS
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:132767cb-cdd7-6769-acf0-aee6548c5fe7
msgctxt "h482eaf73g53ebg4b70gbec0ga2c8f358f94d"
msgid ""
"This is pointless - I am bound by oath to protect both life and nature. I am "
"no threat to you."
msgstr "이럴 필요 없으십니다. 저는 자연과 생명을 수호하는 맹세에 몸바쳤습니다. 당신의 적이 아닙니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 132767cb-cdd7-6769-acf0-aee6548c5fe7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#. TagRule: PALADIN_DEVOTION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:132767cb-cdd7-6769-acf0-aee6548c5fe7
msgctxt "h92878e60gea9ag4046gafbeg1b7d3aaecd73"
msgid ""
"This is pointless. I am bound by oath to protect the weak and uphold justice "
"- I am no threat to you."
msgstr "이럴 필요 없으십니다. 저는 정의를 수호하고 약한 이를 보호하는 맹세에 몸바쳤습니다. 당신의 적이 아닙니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 132767cb-cdd7-6769-acf0-aee6548c5fe7
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#. TagRule: PALADIN_VENGEANCE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:132767cb-cdd7-6769-acf0-aee6548c5fe7
msgctxt "h59446551g09a0g4b85gb9b5g6e2a9374998f"
msgid ""
"This is pointless. Unless you've committed a grevious sin, I am no threat to "
"you."
msgstr "이럴 필요 없으십니다. 당신이 통탄할 죄를 짓지 않는 이상 저는 당신의 적이 아닙니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 134fd9f2-f09c-f71e-173c-52b91b724256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:134fd9f2-f09c-f71e-173c-52b91b724256
msgctxt "ha28fca8cg7b9cg446bg960agdabee6eb56e9"
msgid ""
"The same way Harpers learn of anything - poking noses where they don't "
"belong."
msgstr "하퍼들이 뭘 캐내는데 별다른 수법이 있겠나. 아무 데나 들쑤시고 다니는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 13a09256-1286-ee7e-e4dd-0daa2abca78e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:13a09256-1286-ee7e-e4dd-0daa2abca78e
msgctxt "h63eea7e8g1f9ag497dgb24dgf90944cf2afd"
msgid ""
"The same way he dealt with my arrow in his eye, I suspect. Much as I share "
"your desire for a simple life - we must try another way."
msgstr "내 화살이 눈에 박혔을 때랑 똑같겠지. 나도 너처럼 단순한 삶을 지향하지만 - 이번에는 다른 방법을 찾아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 13fbc1b7-004c-12c3-182e-c23bd0849f04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:13fbc1b7-004c-12c3-182e-c23bd0849f04
msgctxt "h7b2c91a3gafdeg4442g804bgc09ff90f86af"
msgid "Seems like I'll be doing most of the heavy lifting."
msgstr "제가 가장 막중한 임무를 짊어지는 것 같군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 14371d70-64a1-52a7-edc3-385f7d8cdfaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:14371d70-64a1-52a7-edc3-385f7d8cdfaf
msgctxt "hfceef2bege919g4155ga3e3g01925a1dd697"
msgid "It's more than that. She was dead, and something brought her back."
msgstr "그보다 더합니다. 그녀는 죽었어요, 그런데 알 수 없는 힘이 그녀를 되살려냈고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 14532ccb-a37a-3a7e-7c8c-4e91463f7551
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:14532ccb-a37a-3a7e-7c8c-4e91463f7551
msgctxt "hc3fa8149gd8dbg4492gac1egb0630c877f32"
msgid "It seems likely. Which means he isn't working alone."
msgstr "그래, 그런 것 같더군. 그리고 그 말은 놈이 혼자 이 일을 꾸민게 아니란 이야기지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 14d7a248-9dd1-9812-25fa-fec2442a0ddb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_DiscussMarcus = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:14d7a248-9dd1-9812-25fa-fec2442a0ddb
msgctxt "hf0a56b8cg0bfag49a9ga4edgea25cff5c501"
msgid "You did well bringing this to me - thank you."
msgstr "훌륭한 정보를 가져다 줬군 - 고맙네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 15f67618-fe47-2b4d-0a0b-23eeeac7c0e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:15f67618-fe47-2b4d-0a0b-23eeeac7c0e7
msgctxt "h8326c53ega577g47acga381gfe124e4e55cf"
msgid ""
"If you had nothing to do with it - and I want to believe you didn't - you "
"have nothing to fear from me."
msgstr "자네가 아무런 연관이 없다면 - 그리고 나도 그렇게 믿고 싶네 - 걱정할 것 하나 없다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 171ecbf2-e2e9-50f0-7db6-ca155cad3c51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_ConfrontedAboutHerFather = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:171ecbf2-e2e9-50f0-7db6-ca155cad3c51
msgctxt "h521ac70fg30b9g49fagbb11g4a9830047edb"
msgid "I tried to talk to her about it. She won't tell me anything."
msgstr "이 일에 대해 대화를 좀 하려 했지만, 아무 이야기도 안 해주더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 175a59f6-a8a8-dc80-6b06-d8f71de07478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:175a59f6-a8a8-dc80-6b06-d8f71de07478
msgctxt "h3036bb31g81f6g4ed4ga64fg172b85f8e753"
msgid "And now we are the best of friends. You see? The power of trust."
msgstr "그리고 이제는 둘도 없는 친구가 됐지. 이게 바로 믿음이 힘이야. 좀 알겠나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 177ba7e6-f9f1-a115-91ce-f45f837d463a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_WasWarned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:177ba7e6-f9f1-a115-91ce-f45f837d463a
msgctxt "hc8624038g9d83g491agacc8g2289040dccd2"
msgid "We should have taken Marcus while we had the chance."
msgstr "기회가 있었을 때 마커스를 끝장내야 했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 198289d9-b40a-36b4-2749-e3d33e4860b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:198289d9-b40a-36b4-2749-e3d33e4860b3
msgctxt "h5ce6011bg803cg4e57gbaf8gb4bb5a958417"
msgid "If we're to survive, I have no choice but to trust you. Can I?"
msgstr "우리가 살아남으려면, 너를 믿을 수 밖에 없겠군. 다른 수가 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 19b109fc-ea39-2ede-ef7a-e2d4087a427d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:19b109fc-ea39-2ede-ef7a-e2d4087a427d
msgctxt "hda5d5b3cg442bg4269g8dbfgbda36db5358e"
msgid ""
"You're the only one who can get inside the Towers. You were born for this "
"mission - or <i>made </i>for it, rather."
msgstr ""
"넌 탑으로 들어갈 수 있는 유일한 사람이야. 이번 임무를 위해 태어났다고 볼 수 있지. 아니, <i>만들어졌다</i>고 하는 편이 "
"맞으려나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 1b24208d-b30b-7b7b-ac1b-125ac54e84e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:1b24208d-b30b-7b7b-ac1b-125ac54e84e1
msgctxt "h55f31808g1774g4f04g84f8g6dc09dc06d6b"
msgid "And you face Ketheric <i>alone.</i>"
msgstr "그리고 <i>홀로</i> 케서릭을 상대하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 1bb0f5ef-3d54-2c9d-74ba-f196e8971f3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = False
#.      - Hav_Jaheira_JaheiraDrinksWine = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:1bb0f5ef-3d54-2c9d-74ba-f196e8971f3c
msgctxt "hbf7c0a76gbf84g4444gb71cgf089d2282dfd"
msgid ""
"But you're far from the most eccentric drinking companion I've had. I'd like "
"to know more. Cheers."
msgstr "그렇지만 넌 내가 만나보았던 괴짜 술친구하고는 대단히 동떨어져 있지. 나는 더 알아야겠어. 건배."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 1e83724f-51ea-71f8-6abb-4dddc58fc056
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:1e83724f-51ea-71f8-6abb-4dddc58fc056
msgctxt "hd3ffe6e8g9495g49b7g8a20g155f30b8ff90"
msgid "Yes."
msgstr "네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 1f30750f-151e-fa1f-95c6-d7a604e0e1f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_GiveOintment = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:1f30750f-151e-fa1f-95c6-d7a604e0e1f5
msgctxt "hc20d2016g96f8g431dgbdddg6be2d572700c"
msgid "Before you go, there's somebody else you should meet."
msgstr "떠나기 전에, 자네가 만나야 할 사람이 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 1f54d3a1-4926-56bc-f5c9-a4e93d0f0d18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = False
#.   Object:
#.      - GLO_TadpoledCount3(1) = True
#.      - HAV_Jaheira_State_DrankWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:1f54d3a1-4926-56bc-f5c9-a4e93d0f0d18
msgctxt "h91013e1dgfa22g419fg9699ga94361cfb3d3"
msgid ""
"It's trying to change me, to win me over, but I'm resisting its temptations."
msgstr "그것이 날 변화시키려 하고, 나의 신뢰를 얻으려 하고 있죠. 하지만 그 유혹에는 저항하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 1fd113bf-4d84-ccd1-2f3e-d3c9c0b921fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:1fd113bf-4d84-ccd1-2f3e-d3c9c0b921fd
msgctxt "h93f649fbg6b65g47cdg9a42g148e7add6da5"
msgid "Just answer the question."
msgstr "대답이나 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 2013ea5f-9786-0351-34b9-32e3e3928def
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2013ea5f-9786-0351-34b9-32e3e3928def
msgctxt "h2c3d603age007g47cdgbebfg05a4d7b84113"
msgid "I do."
msgstr "난 된다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 205d86fd-cdc7-484c-6c1b-71d75cdfe1d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:205d86fd-cdc7-484c-6c1b-71d75cdfe1d7
msgctxt "hace1d0fbg5f7bg4c21gba92g3751ac5562ac"
msgid "I heard it was both."
msgstr "둘 다라고 들었습니다만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 20d57a6a-ba3b-9dfa-de72-49cdafb2a93b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#. SetFlags:
#.   User:
#.     - HAV_Jaheira_Knows_SentToKidnapIsobel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:20d57a6a-ba3b-9dfa-de72-49cdafb2a93b
msgctxt "h0ac32cd2gabd7g4962g99cfg33b9e6f1d6ed"
msgid ""
"And I'll drink to the darkness that will soon fall when I drag Isobel all "
"the way to Moonrise Towers."
msgstr "문라이즈 타워에 이소벨을 끌고 갈 때 짙게 깔릴 어둠을 위하여 건배."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 223215ee-0480-55aa-e711-04e3b2d67596
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:223215ee-0480-55aa-e711-04e3b2d67596
msgctxt "hf03de6b5gf3b6g4cafg9641gc2b5ad8505de"
msgid ""
"Trust doesn't matter. I'll get the job done - that's all you need to know."
msgstr "신뢰 같은 건 상관없어요. 제가 임무를 완수해 내리라는 것만 기억하시면 됩니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 22c3ca9b-d1d0-1b47-780d-b9b40736331f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:22c3ca9b-d1d0-1b47-780d-b9b40736331f
msgctxt "hbfd4688ag676cg4511gb919g28568dea06b1"
msgid "And you're certain you will continue to resist?"
msgstr "앞으로도 계속 저항할 건가, 확실해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 22e7e4fd-a83a-d340-4b20-7b1e4dc22214
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:22e7e4fd-a83a-d340-4b20-7b1e4dc22214
msgctxt "ha0855539g616eg43b5g8c80gf05fa9ad2629"
msgid ""
"A Harper's gaze can only be turned by proof. By the looks of it, a tall tale "
"is all you have to offer."
msgstr "오직 증거만이 하퍼의 시선을 돌릴 수 있지, 자네는 믿기 힘든 이야기만 하고 있잖나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 2357c245-760c-cf99-924d-e6fa673a4c45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2357c245-760c-cf99-924d-e6fa673a4c45
msgctxt "hcda950f4gf414g4558ga210g69a4e560378e"
msgid "Invincibility? That's powerful magic - thankfully, I have my own."
msgstr "무적? 그것 참 강력한 마법이군요. 다행스럽게도, 저도 가지고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 235db402-c242-4b4d-2d3e-c9b934e3bed2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:235db402-c242-4b4d-2d3e-c9b934e3bed2
msgctxt "hb64481bfg4a91g4481g98dfgb8df928867e6"
msgid "No need of that. Every Harper is a bard unto themselves, I'm afraid."
msgstr "그럴 필요도 없지. 유감스럽게도, 하퍼 녀석들은 하나같이 바드가 따로 없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 2371c1ef-522b-9aff-1db9-84ce3dfbf6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2371c1ef-522b-9aff-1db9-84ce3dfbf6ea
msgctxt "h15db20c5g6e5dg4c26gaea5gdff7dcb86222"
msgid ""
"Well spotted, but if I wanted you dead, I'd have crushed you with my vines."
msgstr "이런 들켰군, 하지만 자네를 죽일 생각이었으면 덩굴로 진작에 뭉개버렸을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 23acaa9d-8c41-db61-c828-03213e103954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:23acaa9d-8c41-db61-c828-03213e103954
msgctxt "h19483d27gc982g4520g8dddg65e3d14663bc"
msgid ""
"Whatever magic Ketheric's using to control these tadpoles, it must be at "
"Moonrise."
msgstr "올챙이들을 조종하는 데 케서릭이 쓴 마법이 뭐든 간에, 그 해답은 분명 문라이즈에 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 23b71aa9-c5e7-e740-111b-29ec921b804f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_WasWarned = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:23b71aa9-c5e7-e740-111b-29ec921b804f
msgctxt "h07fdaad3g2a2ag463dga6fdg8c34c20e677f"
msgid "You should have seen this coming."
msgstr "이 정도는 예측하셨어야죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 23b846ab-f70b-2d76-8463-50cd6bfb13b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:23b846ab-f70b-2d76-8463-50cd6bfb13b7
msgctxt "hacad8b36g0164g4445g8cecgd1ed46890307"
msgid "I hope I'm not mistaken."
msgstr "내가 착각한 게 아니었으면 좋겠군그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 28e183bb-d226-c3aa-0f95-289d537a48ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:28e183bb-d226-c3aa-0f95-289d537a48ea
msgctxt "he81c04e2g37a5g4025gb6e6gc55d9ac0fd5f"
msgid ""
"And the wit to know when it will not avail you, I think. We must try another "
"way."
msgstr "그리고 그게 도움이 되지 않을 때를 아는 지혜도 있지. 다른 방법을 찾아보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 293ef4c6-a1bd-df4d-7749-11b3ea3c128d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:293ef4c6-a1bd-df4d-7749-11b3ea3c128d
msgctxt "h8b816d52gfb40g47fdga1deg2850012baa2c"
msgid "We were all caught off-guard."
msgstr "우리 모두 방심했으니 어쩔 수 없는 일입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 29c7a960-2528-309a-890f-634e9a550115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:29c7a960-2528-309a-890f-634e9a550115
msgctxt "hb70c8c20g1201g4cbfg9115g7b238e231c66"
msgid "Not good enough."
msgstr "믿음만으로는 부족합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = 2a25ef1c-0881-21e2-276b-7e72eac34867
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2a25ef1c-0881-21e2-276b-7e72eac34867
msgctxt "h4387d43egc54dg4a4egaf12ge827ceff3da1"
msgid ""
"*Not every knave prefers a blade in the ribs or arrow in the back. Some "
"prefer <i>poison</i>.*"
msgstr ""
"*모든 악당이 등 뒤에서 화살을 쏴버리거나 가슴에 칼을 박는 수법을 쓰진 않습니다. 어떤 이들은 <i>독</i>을 선호하기도 하죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 2a3f2281-bcdd-6ff2-fa3c-22d1cc1f2e0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2a3f2281-bcdd-6ff2-fa3c-22d1cc1f2e0e
msgctxt "h24cc0acdg7e51g4bd8gb9b7gc0b1aff0f25c"
msgid "Besides, you need this. You need to heal yourself of your infection."
msgstr "게다가, 자네도 그만한 동기가 있지 않나. 자네도 치료 받고 싶을 테니 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 2b13df76-8ac9-6e07-b831-5be76173a61f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Jaheira_State_ReactedToAbduction(1) = False
#.   Global:
#.      - HAV_TakingIsobel_Event_MolKidnapped = True
#.      - HAV_TakingIsobel_Event_AbductionAttempted = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Jaheira_State_ReactedToAbduction(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2b13df76-8ac9-6e07-b831-5be76173a61f
msgctxt "hb621cf1fg4c8cg417eg9c22g3ff1b2f59df6"
msgid ""
"Traitors among us, a child taken... and still I can only feel <i>relief</i>. "
"If they had taken Isobel too..."
msgstr ""
"우리 사이에 배신자가 있었군, 아이가 납치당했는데... 느껴지는 건 <i>안도감</i> 뿐이라니. 만일 놈들이 이소벨마저 데려갔다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 2b4b7ab1-34fb-6029-b3ec-57ce7ffe56ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2b4b7ab1-34fb-6029-b3ec-57ce7ffe56ed
msgctxt "hfb7721ffg8aecg4222gaae4ge2cfdb5c3791"
msgid "You are right. She is."
msgstr "자네 말이 옳아. 그자의 딸이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 2ba5358d-7a21-0df8-c32f-00bf3abf6a43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2ba5358d-7a21-0df8-c32f-00bf3abf6a43
msgctxt "h83110098gb912g4967g8569gaa7821641da7"
msgid "Remove her from her bonds, or kill her, maybe. I haven't done either."
msgstr "구속을 풀어주거나, 아니면 죽이던 가겠죠. 아직 아무것도 하지 않았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 2e3d0c87-f43c-fd1f-df8b-00c83e2da167
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2e3d0c87-f43c-fd1f-df8b-00c83e2da167
msgctxt "h9fc3aeabg5762g4762g85efg7880801109e9"
msgid ""
"What?! So all this time, he has been leeching his life from an immortal? The "
"man is more parasite than that thing in your head."
msgstr "뭐라고?! 그렇다면 그 긴 시간 동안, 불멸자로부터 생명력을 빨아내고 있었다는 건가? 네 머릿속의 기생충보다도 더한 놈이로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 2e411573-3764-aacb-3251-34ca6359e328
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2e411573-3764-aacb-3251-34ca6359e328
msgctxt "h9a6a351bg7516g467ag9718g8d7ba7fd8de8"
msgid "Invincible? Please - let's see how he deals with decapitation."
msgstr "무적이라고? 놈이 모가지가 떨어지면 어떻게 될지 봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 2e56b41d-9eb8-1b17-b7ae-d2ce3244b950
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:2e56b41d-9eb8-1b17-b7ae-d2ce3244b950
msgctxt "h5a3cfe36g63c7g4a92g834eg929f3380e6e0"
msgid "You don't know what you're missing."
msgstr "네가 뭘 놓친 건지도 모를 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 306b6654-b506-b9cd-8c11-5276742487f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Ketheric_Knows_HasSeen = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:306b6654-b506-b9cd-8c11-5276742487f8
msgctxt "h605235d3g3252g446eg8c9dg9ccc197a9c53"
msgid "Ketheric Thorm. I encountered him in Moonrise Towers."
msgstr "케서릭 쏨. 문라이즈 타워에서 봤습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 33e25815-d568-4957-5fcf-1dddf9ffe36f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_AbductionAttempted = False
#.      - HAV_TakingIsobel_State_SpyIsPermaDefeated = False
#.      - HAV_TakingIsobel_State_SpyConfrontationStarted = False
#.      - GLO_HAV_IsobelGaveMission = False
#.      - HAV_Jaheira_State_MissionGiven = True
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#.      - HAV_TakingIsobel_Event_GiveOintment = False
#.   Object:
#.      - SCL_Drider_State_HasMoonlantern(1) = False
#.      - HAV_Jaheira_State_TriedConvinceFlamingSpy(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:33e25815-d568-4957-5fcf-1dddf9ffe36f
msgctxt "hcd6604bbg99e8g4c2dgb357g6a867d45099d"
msgid "Isobel's in her room upstairs - she'll be expecting you."
msgstr "이소벨은 위층의 자기 방에 있어. 널 기다리고 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 342441bc-4f66-f59e-a59b-87f3b7890230
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:342441bc-4f66-f59e-a59b-87f3b7890230
msgctxt "h7b395ef5gbf9bg42e2g949dg98da29038a7b"
msgid "Exactly the point, wouldn't you say?"
msgstr "바로 그거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 346e8c86-35dc-64e5-5ee7-7a86ee75a263
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Necromancer_Knows_InvulnerabilitySource = True
#.      - GLO_Ketheric_Knows_ImmortalitySource = False
#.      - MOO_BalthazarsSecrets_Knows_NightsongSecret = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:346e8c86-35dc-64e5-5ee7-7a86ee75a263
msgctxt "had692c60g7b2dg44a7ga8dcg0de709405e04"
msgid ""
"Ketheric's power stems from the Nightsong -  a relic which his necromancer, "
"Balthazar, is trying to reach."
msgstr "밤의 노래가 바로 케서릭의 힘의 근원입니다 - 발타자르라는 놈의 사령술사가 그걸 손에 넣으려 하고 있고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 34b9dae3-592e-0d9f-fad8-0d9c34100154
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:34b9dae3-592e-0d9f-fad8-0d9c34100154
msgctxt "h9ee4f076g5c31g4a2bg90b6gcd7f6a52371e"
msgid "Then speak."
msgstr "말해보게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 34c3f389-5cd3-62af-a143-03d6c22f66f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_AbductionAttempted = False
#.      - HAV_Jaheira_State_MissionGiven = False
#.   User:
#.      - HAV_TakingIsobel_UserShortCut_SkipWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:34c3f389-5cd3-62af-a143-03d6c22f66f5
msgctxt "hcaf3b096g7aedg405bg8781g58a9c3ef3f82"
msgid ""
"There is a grave threat to us all, stretching as far as Baldur's Gate, and I "
"need your help."
msgstr "발더스 게이트까지 나아가는 길 위에 심각한 위협이 있지. 그리고 난 네 도움이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 36fed477-a4ae-57dd-478c-82249a725dd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:36fed477-a4ae-57dd-478c-82249a725dd2
msgctxt "h6644e822g3009g4f7eg8e87g9d4a18935550"
msgid ""
"A Harper's gaze can only be turned by proof. By the looks of it, a tall tale "
"is all you have to offer."
msgstr "하퍼의 눈길은 증거 없이 움직이지 않는다. 보아하니 네가 제시할 건 그 과장된 허풍 뿐이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 374b3939-4db9-c4da-580f-36a86bd2a300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:374b3939-4db9-c4da-580f-36a86bd2a300
msgctxt "hc19e0597gdaccg493agb825g630c0db3e821"
msgid "Well, consider this an experiment, then."
msgstr "그럼, 이참에 실험한다고 생각해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 3a3498b8-0f15-4c13-0a54-d55f5e67370e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:3a3498b8-0f15-4c13-0a54-d55f5e67370e
msgctxt "hfcfd0b1egd1f2g4804g952fgdf27ff574b1e"
msgid "You utter bastard."
msgstr "진짜 씹새끼 같은 놈이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 3aef74f2-920e-2ca0-8557-8666566b1a27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:3aef74f2-920e-2ca0-8557-8666566b1a27
msgctxt "hc09171b5g8217g4e8fgac59g061029f1717a"
msgid ""
"I thought I was prepared for treachery. But an all-out assault... I "
"blundered into their trap like a fool."
msgstr "배신자 정도는 염두에 두고 있었지. 하지만 이런 총공격이라니... 얼간이처럼 놈들의 함정에 빠지고 말았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 3b1d43a2-9c4a-b629-a0ec-7c80e7e97100
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Ketheric_Knows_HasSeen = False
#.      - GLO_SCL_Ketheric_State_PlayerKnowsKethericHistory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:3b1d43a2-9c4a-b629-a0ec-7c80e7e97100
msgctxt "h94a3e701g80b8g45a8ga790g03cb9cb1eac3"
msgid "Ketheric Thorm, I presume."
msgstr "케서릭 쏨이겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 3d44a3e4-76b8-1463-e376-d4586893bf56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - SORCERER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:3d44a3e4-76b8-1463-e376-d4586893bf56
msgctxt "ha387867ag9fbeg4f1bg9a5bgb8fd9cdfdb09"
msgid "You think I can kill him?"
msgstr "제가 녀석을 죽일 수 있을 거라 생각하십니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 3e20b5a2-6e87-c343-77a1-b8f13df54b81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:3e20b5a2-6e87-c343-77a1-b8f13df54b81
msgctxt "h9498396dg0086g4befgabe6ga2c7244cd8f8"
msgid ""
"<i>'Chosen'.</i> That's three masters Ketheric has served. Our paladin isn't "
"very picky."
msgstr "<i>선택받은 자</i>라고. 그걸로 케서릭은 주인이 세 명이나 됐겠구만. 우리 팔라딘께선 참 쉽기도 하셔라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 3f56c2c0-98d4-4165-bbd2-34ca4daefd9f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:3f56c2c0-98d4-4165-bbd2-34ca4daefd9f
msgctxt "h1bd8da5fg6983g49e2gad01g479f57b388ba"
msgid ""
"I take the knife from his throat - and then he bares his back for the "
"killing blow."
msgstr "그의 목에서 칼을 거두면 무방비로 나에게 등을 노출하겠지. 치명타를 꽂아 넣을 수 있게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 3f7fd7a4-2fdf-b338-bc74-f136f88ca615
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:3f7fd7a4-2fdf-b338-bc74-f136f88ca615
msgctxt "hefcd7bc6g03e8g4b1egba52g2f6a58d0bf98"
msgid ""
"I have every reason to be cautious. I've traced people like you, people with "
"parasites in their brains, all the way here from Baldur's Gate."
msgstr ""
"내가 경계하는 데에는 다 이유가 있어. 발더스 게이트에서부터 이곳까지, 너와 같은 사람들을 추적해 왔지. 뇌에 기생충이 박힌 사람들 "
"말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 402b449f-c186-ac14-bf13-dec44b55c2a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:402b449f-c186-ac14-bf13-dec44b55c2a8
msgctxt "h8146b9d9g6ef4g4f12gbe4fgc0687895d81d"
msgid "I don't need to explain myself to you."
msgstr "설명할 필요는 없다고 보는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 4051e289-751f-5361-34f2-a2183c22c05d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_GiveOintment = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4051e289-751f-5361-34f2-a2183c22c05d
msgctxt "h38beacbcg42b4g41b0g9967gc0aa788c526d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 40b9d9a9-12a5-4d2a-a102-a12c9f9ac45e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 6
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:40b9d9a9-12a5-4d2a-a102-a12c9f9ac45e
msgctxt "h5274a9f5g8560g457dgaccdg27d409f98045"
msgid "<i>Meet her stare head on as you examine her body language.</i>"
msgstr "<i>자헤이라의 몸짓 언어를 분석하며 그 눈빛을 마주봅니다</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 431f103d-9be8-9ffa-18d1-53dd5fbec6ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:431f103d-9be8-9ffa-18d1-53dd5fbec6ec
msgctxt "h5ea9b932gd853g47d7g8fdbg92c0e729aa34"
msgid ""
"This place is crawling with Harpers. If Marcus managed to get himself "
"infected, we would've known the same minute."
msgstr "여긴 하퍼들이 득실대는 곳이야. 마커스가 감염되었다면, 우리가 진즉에 눈치 챘겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 43eae95d-d860-42c1-eec6-9e452bf4f31d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Drider_State_HasMoonlantern(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:43eae95d-d860-42c1-eec6-9e452bf4f31d
msgctxt "hc82a2449g0be8g4bffg984egcf50548f6839"
msgid "I already have a lantern that protects me from the darkness."
msgstr "어둠 속에서 제 신변을 지켜 줄 등불이라면 이미 하나 가지고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 449b7844-af69-567c-07e7-f09938dc04d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#.   Object:
#.      - HAV_Jaheira_State_DiscussIsobelFather(1) = False
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_State_DiscussIsobelFather(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:449b7844-af69-567c-07e7-f09938dc04d3
msgctxt "hb9b3ea7ag0cdfg4ce7gbf4dga9168faf8e7b"
msgid ""
"It's worse than you know. I have reason to believe that Isobel is Ketheric's "
"daughter."
msgstr "그것보다 최악입니다. 이소벨은 케서릭의 딸인 듯 하더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 44a5468e-09c7-a0d9-c70d-6c9655c90474
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:44a5468e-09c7-a0d9-c70d-6c9655c90474
msgctxt "h0f363717geff4g4732ga87bg781927c828b6"
msgid "Some crusty ballad-monger, I expect."
msgstr "떠돌이 가수들한테 들어봤겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 45206abc-9918-73fe-9242-2c9348f93ea0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:45206abc-9918-73fe-9242-2c9348f93ea0
msgctxt "he4ef84b1ga8d6g46c9g8d27gda30e0db1920"
msgid ""
"I choose to take it. I choose to trust. And not <i>just</i> because I have "
"no other choice."
msgstr "그리고 난 그녀를 믿고, 그 도움을 받아들일 생각이야. 다른 선택지가 <i>없어서</i> 그렇다는 착각은 하지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 45d34836-2be8-5d41-004d-7154cff54225
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:45d34836-2be8-5d41-004d-7154cff54225
msgctxt "h9b242cf4g1550g4618g9e37g4b9e73da4c8d"
msgid ""
"I had hoped undoing his protection might loosen the shadows' grip on this "
"land, too - give us some means to move against him in force."
msgstr "난 그놈의 보호막을 없애면 이 땅을 그림자의 속박에서 해방시키고 - 우리가 그놈에게 대항할 방법을 얻게 될 것으로 기대했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 47001c04-98bc-b621-ca96-88728ce4562f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:47001c04-98bc-b621-ca96-88728ce4562f
msgctxt "h4644debbgf375g45feg882dg0b309108bc6c"
msgid "Ignore me, then. It's your own funeral."
msgstr "못 믿겠다면 마음대로 하시죠. 어차피 당신 손해니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 47247dcb-a04f-7e38-2cc7-3ba0e83c3cb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyIsPermaDefeated = False
#.      - HAV_TakingIsobel_State_SpyConfrontationStarted = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#.   Object:
#.      - HAV_Jaheira_State_TriedConvinceFlamingSpy(1) = False
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_Knows_WasWarned(0) = True
#.     - HAV_Jaheira_State_TriedConvinceFlamingSpy(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:47247dcb-a04f-7e38-2cc7-3ba0e83c3cb5
msgctxt "h10833962g6262g42eeg8225g9aec6bab7801"
msgid ""
"There's something you should know - Marcus, the Flaming Fist upstairs, is a "
"True Soul. He wants to kidnap Isobel."
msgstr "네가 알아야 할 게 있어 - 위층에 있는 마커스라는 플레이밍 피스트야, 참된 영혼이지. 그가 이소벨을 납치하려고 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 481a146a-bf71-fdce-f581-2e3aeb6a2931
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:481a146a-bf71-fdce-f581-2e3aeb6a2931
msgctxt "hf85f881dg2c39g4e11gab38g317b566b6d95"
msgid ""
"I won't begrudge you that. But our interests align, and I hope no loyalty of "
"that <i>thing </i>in your head to the Absolute will interfere with our "
"salvation."
msgstr ""
"뭐라 하진 않겠어. 하지만 우리의 이해관계는 일치해. 네 머릿속<i> 그 녀석</i>의 절대자에 대한 충성심이 우리를 방해하지 않았으면 "
"바랄 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 492eb1c5-a26a-e804-c6b4-3357a9377b48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:492eb1c5-a26a-e804-c6b4-3357a9377b48
msgctxt "h4afdac84ge0d1g40b9g9148gd5f7df761948"
msgid "Answer me true and do not lie: the parasite is changing you, isn't it?"
msgstr "거짓말 말고 진실만을 대답해, 기생충이 널 변화시키는 중 아냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 49440abf-9176-870e-174d-3171b4c54bfd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DRUID or MONK
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:49440abf-9176-870e-174d-3171b4c54bfd
msgctxt "h350108eeg300dg4c79gb0fag35464cb4e871"
msgid "The flowing river changes. It is still a river. I am still <i>me</i>."
msgstr "흐르는 강물은 변하는 법이지. 하지만 여전히 강물일 뿐이야. 난 여전히 <i>나</i>야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 4ac48baa-9ccc-f365-797c-515a640a99c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4ac48baa-9ccc-f365-797c-515a640a99c4
msgctxt "h003d8179gb0e3g4159g89c7g164697c3b516"
msgid ""
"I've traced people like you, people with parasites in their brains, all the "
"way here from Baldur's Gate."
msgstr "발더스 게이트에서부터 이곳까지, 너와 같은 사람들을 추적해 왔어. 뇌에 기생충이 박힌 사람들 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 4afc7c30-48dc-5138-7e73-dc0f67e713d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4afc7c30-48dc-5138-7e73-dc0f67e713d3
msgctxt "hde81b3ebg7e31g456eg88d0g6b0df13a01cb"
msgid ""
"I'm interested in saving my own skin, not yours. Whether you trust me is "
"immaterial."
msgstr "당신네들보단 제 껍데기를 지키는데 더 관심 있거든요. 당신이 저를 믿을지 말지는 중요하지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 4ba1ca4c-e81b-9434-1c28-f9ac7bb397ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4ba1ca4c-e81b-9434-1c28-f9ac7bb397ca
msgctxt "h1d3f89b3gbe15g49a4g87e4g78f15137c8f5"
msgid "<i>Decline to drink.</i>"
msgstr "<i>마시기를 거부한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 4d45d1ae-4664-fd24-ae45-670cbc9c640e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4d45d1ae-4664-fd24-ae45-670cbc9c640e
msgctxt "ha9ae17aagce98g4b02gb1ddgf35fd2cb3587"
msgid "So which was it?"
msgstr "그래서 어느 쪽이 사실입니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 4e055b5d-49e0-7628-0fe7-53b72cf1c160
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4e055b5d-49e0-7628-0fe7-53b72cf1c160
msgctxt "h6fb69801ge612g4094g9627g0daac36a04e9"
msgid ""
"You know more of the herb than I do, it seems. Except for how it tastes, "
"perhaps?"
msgstr "보아하니 이 약초에 대해 나보다 더 잘 아는 것 같은데. 맛은 어떤지 모르겠지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 4effbb06-b5e4-86e6-354e-807963d7c65b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_WasWarned = True
#.   Object:
#.     - HAV_Jaheira_Knows_WasWarned(0) = True
#.     - HAV_Jaheira_State_TriedConvinceFlamingSpy(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4effbb06-b5e4-86e6-354e-807963d7c65b
msgctxt "h0948d2d5g8df8g42a3g93adgc3cee122ccd3"
msgid ""
"Wait. there's a Flaming Fist upstairs - Marcus. He's a True Soul with plans "
"to kidnap Isobel."
msgstr "잠시만요. 위층에 있는 플레이밍 피스트, 마커스는 이소벨을 납치하려는 참된 영혼입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 4fbc6bf7-536e-5c91-385e-0e117f78c995
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4fbc6bf7-536e-5c91-385e-0e117f78c995
msgctxt "h89aeb8a9g1c75g4b4cg9cd5gdc58b17df796"
msgid "I was actually wondering if it would effect me. Poisons often struggle."
msgstr "제게 효과가 있을지 궁금하군요. 가끔 독이 안 듣거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 4fe3b5d3-9a1e-38ed-7f23-220c28737e2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:4fe3b5d3-9a1e-38ed-7f23-220c28737e2c
msgctxt "h48f4696dgad48g4cfag84e4g6aec614d9ee3"
msgid ""
"Please - drink. You'll tolerate what I have to say better after a glass or "
"two."
msgstr "마셔 봐. 한 두잔 하고나면 내가 하는 헛소리를 조금은 견딜 수 있게 될테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 5072f348-47e4-925c-48c8-db6f1633e258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5072f348-47e4-925c-48c8-db6f1633e258
msgctxt "hd12a8672g2d79g48bcgaac0g3b1b962a8651"
msgid ""
"You've come from the shadows and wasted no time accusing one of our "
"companions of treason. It's all a little... odd."
msgstr "그림자를 뚫고 나와서는 숨도 쉬지 않고 우리의 동료를 고발했지. 모든 것이…이상해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 52381e2f-2873-8766-1e7d-56d80490ba29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:52381e2f-2873-8766-1e7d-56d80490ba29
msgctxt "hd68ec532g2e2eg4e06gac64g1f20238a2cec"
msgid "Let me guess - I'm 'someone else'."
msgstr "그럼 제가 그 '누군가' 겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 5436fdc7-8f73-2ce8-c91f-7db6cd9dd150
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5436fdc7-8f73-2ce8-c91f-7db6cd9dd150
msgctxt "h717c72a3g3663g4d89g9620g58dd2e29764d"
msgid "I promise I will do everything I can to make sure you survive this."
msgstr "자네가 살아남을 수 있도록 내 전력을 다하리라 맹세하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 54f3ad0f-9ae9-7934-5de9-b31412e2d3bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:54f3ad0f-9ae9-7934-5de9-b31412e2d3bd
msgctxt "hff3e0d12gcc2cg49ebgbda9g555594032ebb"
msgid ""
"If she wished to see us drowned in darkness, Isobel needn't have lifted a "
"finger. Instead, she holds out her hand."
msgstr "우리가 어둠에 갇혀 죽는 꼴을 보고 싶다면, 그녀는 손가락 하나 까딱 할 필요 없어. 하지만 그녀는 우리들을 돕고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 551d5f49-f9e9-6cce-d161-ca672e57088e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:551d5f49-f9e9-6cce-d161-ca672e57088e
msgctxt "h5dbbfa56g9f11g42c8ga453g775ed23bbb53"
msgid "I see now why you spiked my wine."
msgstr "이제야 와인에 뭘 탄 이유를 알겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 5698a548-588a-20c1-dc62-6098e00cc882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5698a548-588a-20c1-dc62-6098e00cc882
msgctxt "hdd9a3d6ege413g430bga66dg069a11af2180"
msgid ""
"All right. He's in Isobel's room upstairs. Play along with his ruse for now "
"while I gather a few trusted Harpers - but don't let him get his hands on "
"Isobel!"
msgstr ""
"좋아. 마커스는 위층 이소벨의 방에 있어. 내가 특별히 신뢰하는 하퍼들을 모으는 동안 놈의 계획에 어울리는 척을 하고 있으라고. 그렇지만 "
"놈이 이소벨에게 손 대게 두면 안 돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 570b8256-881d-7ba9-15e2-48222a8b6ceb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Charisma
#. DifficultyClass: 6
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Object:
#.      - HAV_Jaheira_State_DrankWine(1) = True
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:570b8256-881d-7ba9-15e2-48222a8b6ceb
msgctxt "he4dce68dg4c4cg43f8g8832gb8b73ffd36e4"
msgid ""
"<i>Suppress the truth-compelling drug with your innate magic. Lie to her. "
"</i>"
msgstr "<i>타고난 마법으로 약효를 몰아내 진실을 억누른다. 거짓을 말한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 5720ffe2-f299-2059-deb0-ba91763ab18a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(1) = True
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5720ffe2-f299-2059-deb0-ba91763ab18a
msgctxt "h5585ca64ga3b9g49d0gbb1bgfd9b1dc9ba68"
msgid "It's rare people look at me and see 'hope'."
msgstr "사람들이 절 보고 '희망' 을 느끼는 일은 흔하지 않은데 말이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 577dab26-d2e2-5744-3f81-5f13e0ae68b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:577dab26-d2e2-5744-3f81-5f13e0ae68b2
msgctxt "hce7ddf3cg7494g43ddg96b1gd22069e26e14"
msgid ""
"Look around you. You shall have to learn to live with 'not good enough', I'm "
"afraid."
msgstr "주변을 좀 둘러보게나. 유감이지만, 자네는 '부족함' 을 견디는 법을 배워야 할걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 57bf885a-ce4b-6437-b090-dc0e8025d2d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:57bf885a-ce4b-6437-b090-dc0e8025d2d5
msgctxt "hceb6a34cg9842g464bg9136g5bab47c2e9b8"
msgid ""
"You've learned so much? That tadpole in your head already begins to pay "
"dividends."
msgstr "거기까지 알아냈나? 자네 머릿속의 올챙이가 확실히 쓸모는 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 58ac0b4a-1fa9-c931-74fa-216897786a05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:58ac0b4a-1fa9-c931-74fa-216897786a05
msgctxt "hbe35133bgca37g43e0gb327g707617589387"
msgid ""
"You were the one who rescued those the Absolute had imprisoned. You were "
"courageous to brave the depths of Ketheric's stronghold."
msgstr "자네는 절대자가 감금해 두었던 사람들을 풀어줬지. 케서릭의 요새 한복판까지 들어갈 만큼 배짱도 두둑하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 5ab0c355-0371-69d6-cd7d-82006c0057fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5ab0c355-0371-69d6-cd7d-82006c0057fc
msgctxt "hbdb31802g765dg475eg9369g3d9ce27eeba9"
msgid ""
"If he's back, perhaps you should have hit him harder in the first place."
msgstr "그자가 살아 돌아왔다면, 애초에 더 확실하게 죽여놔야 했을지도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 5af5b4df-0520-bc62-2582-90afe3807be4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5af5b4df-0520-bc62-2582-90afe3807be4
msgctxt "hb373a8ebg8987g435ega24fgb7a154bb68da"
msgid "Not yet. Parts of the Towers aren't open to me yet."
msgstr "아뇨. 아직 탑으로 갈 방법을 모르겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 5c16f12a-e944-f43c-9773-ed15f63ca567
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5c16f12a-e944-f43c-9773-ed15f63ca567
msgctxt "h54c3f04agbbcbg4c72g8e9ag6234d1f424ea"
msgid "No, but it spoils my trust."
msgstr "그렇겠죠. 대신 제 신뢰가 변질되는군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 5c2cb6d2-2890-23b4-2c67-9b0e1b643fa2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5c2cb6d2-2890-23b4-2c67-9b0e1b643fa2
msgctxt "h0dc1f623gf800g4b49gb19eg15ed1d61cc95"
msgid "Let's kick Ketheric's arse - together."
msgstr "그럼 같이 케서릭의 볼기짝을 걷어차 주자고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 5e2b74c1-d5ce-cae9-5299-164b643fb815
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5e2b74c1-d5ce-cae9-5299-164b643fb815
msgctxt "h0935924dg5f4cg4aecg8aa3g3b7ae6687ea7"
msgid ""
"You know me already. But you'll have the honour of making up for my blunder "
"here."
msgstr "날 아주 잘 아는구만. 하지만 내 실수를 만회하는 역할은 자네가 해줘야겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 5e861bbc-e420-8504-bb90-33f65fbfe6bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5e861bbc-e420-8504-bb90-33f65fbfe6bb
msgctxt "hb041320bgea35g45efgb5edg8367b98f2dfb"
msgid "Let's just focus on defeating Ketheric."
msgstr "그보다 케서릭을 쓰러트리는 데 집중하도록 하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = 5ea3c716-1c1e-3b8b-17f9-f90dff7a2c73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5ea3c716-1c1e-3b8b-17f9-f90dff7a2c73
msgctxt "hb0ab706fg553fg40adg88dagb0bf0a2f6e81"
msgid ""
"*You perceive inviting hints of cedar wood and blackberry. Nothing out of "
"the ordinary.*"
msgstr "*당신은 삼나무와 블랙베리 향을 맡습니다. 그 무엇도 특이할 것이 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 5f108806-d501-5010-5d2c-d5843310b38c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:5f108806-d501-5010-5d2c-d5843310b38c
msgctxt "h4cb6c206ga988g40e2g88cbg745e5ee89ff8"
msgid "Perhaps she chooses to do, rather than say."
msgstr "말하는 것 보다 행동으로 보여주는 게 낫다고 생각한 모양이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 601c51dd-7193-556c-0268-a9918b23370f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:601c51dd-7193-556c-0268-a9918b23370f
msgctxt "h2f108b37gb931g43a2ga353gc748ebfc80e4"
msgid "To your very good health."
msgstr "자네의 건강을 위하여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 606509fe-35a4-c2b2-07e1-b75ef0f187d6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_HAV_TakingIsobel_HeardOfIsobel = True
#.     - HAV_Jaheira_SentToIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:606509fe-35a4-c2b2-07e1-b75ef0f187d6
msgctxt "hd813d67cg8009g4004gaaa2ga6282902e8ac"
msgid ""
"She's upstairs in her chambers. Tell her I sent you and she'll see you "
"through the shadows safely."
msgstr "윗층의 자기 방에 있을 거야. 내가 보냈다고 말해주면 그림자 속을 안전히 돌아다닐 수 있는 방법을 알려줄 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 61468b3a-75df-55c1-6997-14854391bcbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#.      - HAV_Jaheira_Knows_ToldKethericImmortalitySource = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:61468b3a-75df-55c1-6997-14854391bcbd
msgctxt "h3d379af3g8c67g4041gb807gc95814411ef2"
msgid "I trust that you will."
msgstr "그러리라 믿고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 6167d89d-c09f-da81-7bba-d3d7e9e1ebca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6167d89d-c09f-da81-7bba-d3d7e9e1ebca
msgctxt "h5b49a395gd7e0g4e30ga015gd0b94a246d93"
msgid ""
"Something malign? Or some blessing of Selûne, perhaps? I do not know what "
"restored Isobel's life to her. But I can see what she is doing with it."
msgstr ""
"어떤 사악한 힘에 의한 건지, 아니, 어쩌면 셀루네의 축복은 아닐지 모르잖나? 나도 무엇이 이소벨을 되살려냈는지는 몰라. 하지만 그녀가 "
"새로 얻은 목숨으로 뭘 하는지는 잘 알고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 62f09494-d2f8-fde7-7487-79d1bbcbebcf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_Knows_ImmortalitySource = True
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_ToldKethericImmortalitySource = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:62f09494-d2f8-fde7-7487-79d1bbcbebcf
msgctxt "h62b06cbdgee9fg46dag9f19gd692e1ed9234"
msgid ""
"I've discovered the source of Ketheric's invulnerability: a woman called the "
"Nightsong."
msgstr "케서릭을 불멸로 만들어주는 근원을 알아냈어. 밤의 노래라는 여자야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 6348cd6a-2e85-315e-dc2a-6ac40fb881a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6348cd6a-2e85-315e-dc2a-6ac40fb881a6
msgctxt "hdb494053g9deag4d8fg80dag9f6aadf8a637"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 6358f32f-65d6-bb5d-5217-73a43fcad298
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6358f32f-65d6-bb5d-5217-73a43fcad298
msgctxt "h22e5a605g233dg427cg8b71g510bbdbcf5db"
msgid "A paralysing agent? I do not think we're quite so far gone - yet."
msgstr "마비시키는 것? 우리가 그럴 사이는 아니지 - 아직은."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 6499a1b6-6091-c99e-5b3d-439c0bf73ad8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6499a1b6-6091-c99e-5b3d-439c0bf73ad8
msgctxt "hfbd03bfcg8542g4914gaf00ge7924c558ada"
msgid "I am prone to dizziness and fainting. Is it safe?"
msgstr "전 어지럼증이랑 기절에 약합니다. 안전한 거 맞나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 66d3b56f-ed58-31e2-1c78-bceb71ab1b0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:66d3b56f-ed58-31e2-1c78-bceb71ab1b0c
msgctxt "h6bfc20b8g896bg4b9ag8bc6gb04c3868e8ab"
msgid ""
"You'll have to pardon my friend Karlach. She's very excited to meet you."
msgstr "제 친구 칼라크를 이해해주시면 좋겠어요. 당신을 만난다고 엄청 들떴거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 67343a96-c542-2c18-ec6b-a987e20c6d32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:67343a96-c542-2c18-ec6b-a987e20c6d32
msgctxt "h712ebbbbg14f4g4322g9f57g851eb956f823"
msgid ""
"I suppose you know about Ketheric, then. His invincibility. That we'll never "
"cleanse this place until he's made to bleed."
msgstr "그렇다면 케서릭과, 놈의 불멸성에 대해서도 알고 있겠군. 놈을 처리할 방법을 찾기 전까지는, 이곳을 정화할 방법도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 67996b18-1979-5fcb-d95a-7c480f765d9f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:67996b18-1979-5fcb-d95a-7c480f765d9f
msgctxt "hb870bc1eg152eg47f9gb85ag6d9ecea2e3b2"
msgid "Absolutely not. Marcus is a danger to you all."
msgstr "전혀 아닙니다. 마커스는 당신들 모두에게 위험이 될 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 679df9e1-d149-328e-151e-caa0469a7778
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(1) = False
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:679df9e1-d149-328e-151e-caa0469a7778
msgctxt "he2ef367egc5f4g463egb617g2f92f1b99e0b"
msgid "It's rare people look at me and see 'hope'."
msgstr "사람들이 절 보고 '희망' 을 느낀다는 게 그리 흔한 경험은 아니군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 6943ad04-1bce-370b-ddbb-1585e317e4db
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 6
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6943ad04-1bce-370b-ddbb-1585e317e4db
msgctxt "heaf49179g0348g48cag9205g19fc8440528d"
msgid "<i>Smell the wine.</i>"
msgstr "<i>와인 냄새를 맡는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 694f9de0-2530-db81-c3c8-875741049845
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_StartedMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:694f9de0-2530-db81-c3c8-875741049845
msgctxt "h48d72230gf3a4g40fbga945gefe0d21842f5"
msgid ""
"Protected by your artefact, you can infiltrate his forces at Moonrise "
"Towers, posing as a True Soul."
msgstr "아티팩트의 보호 덕분에, 자네는 문라이즈에 주둔 중인 놈의 군대에 참된 영혼 행세를 하며 잠입할 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 6a695adf-9b61-469d-a2a6-3c562f080bad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6a695adf-9b61-469d-a2a6-3c562f080bad
msgctxt "h1133bdf3g9b20g4a06g8dd7g927e02aea3d4"
msgid ""
"Believe me - he was well and truly dead. I locked his corpse in the Thorm "
"mausoleum myself."
msgstr "당시에는 진짜로 죽었어. 내가 직접 쏨 가문의 영묘에 녀석의 시체를 묻어 버렸다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 6c3bceca-26b0-1ff7-478a-5b35fbe82d42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6c3bceca-26b0-1ff7-478a-5b35fbe82d42
msgctxt "hbf60b5a4g7fc2g4b8fgac48g5e62e283cea0"
msgid "I'm still investigating that."
msgstr "아직 알아보는 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 6c62fc03-c153-f97c-f68b-7a0f996f9bf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6c62fc03-c153-f97c-f68b-7a0f996f9bf3
msgctxt "h8dd1fca6g90bcg4b0bgb747gf5142b54c964"
msgid ""
"But if Ketheric fears her... all the better. It means whatever he's planning "
"can still be stopped."
msgstr "하지만 케서릭이 그녀를 두려워 한다는 건... 장점이로군. 놈의 계획이 뭔지는 몰라도, 아직 막을 수 있다는 소리니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 6d50879c-fcf7-a198-44a8-08e42a2d1905
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6d50879c-fcf7-a198-44a8-08e42a2d1905
msgctxt "he1eb12b0g74cdg4f52gb174g5481eb022167"
msgid "I'll taste of the General's blood before all of this is done."
msgstr "마침내 장군의 피를 맛보게 되겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 6ec6a082-5fa1-13f8-202e-1952f13bf4a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6ec6a082-5fa1-13f8-202e-1952f13bf4a9
msgctxt "h059cb220gf97bg4baag8afagae38f986c9f4"
msgid "It controlled me once, but I am free of its influence now."
msgstr "통제권을 빼앗겼던 적이 있긴했지, 그래도 지금은 그 영향에서 벗어났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 6f551669-4e22-79f9-6a80-d8cab8356116
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:6f551669-4e22-79f9-6a80-d8cab8356116
msgctxt "h6288e292g9318g4a1bgae26g4e8ecee52280"
msgid "I wanted to ask you about something."
msgstr "여쭤보고 싶은 게 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = 70abf695-59fd-91ca-29a7-3c4509c5f10b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_TruthSerum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:70abf695-59fd-91ca-29a7-3c4509c5f10b
msgctxt "h8518bb27gdd9cg41ddgac06g3d7cedd2a230"
msgid ""
"*You perceive a faint hint of Klauthgrass, a herb that is said to elicit the "
"truth. Jaheira smiles at you knowingly.*"
msgstr ""
"*당신은 클로스 풀의 희미한 흔적을 알아챕니다. 진실을 내뱉게 하는 약초이죠. 자헤이라는 다 알고 있다는 듯 당신에게 미소 지어 "
"보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 70af1b26-214b-2b49-e3be-2eafa9867a20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:70af1b26-214b-2b49-e3be-2eafa9867a20
msgctxt "h1b8dec48gb73cg4896ga6c1g03cf159719e0"
msgid "He's aligned himself with mind flayers, but I cannot see what he gains."
msgstr "거기에 마인드 플레이어들과도 붙어먹고 있지만, 거기서 무슨 이득을 취하는지는 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 7140e770-0534-0b90-7174-d23acb4319e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7140e770-0534-0b90-7174-d23acb4319e4
msgctxt "hbae79f66g89afg4c7dgbe8cg2759c85dbd08"
msgid "Still not quite so sure about you, though."
msgstr "그건 그렇고, 아직 너에 대한 확신이 생기지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 71957ae3-9846-4c90-cf8a-0fc68fc5601f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:71957ae3-9846-4c90-cf8a-0fc68fc5601f
msgctxt "he95ffd11g6ce4g46b0gb597g0c0c7d3f8604"
msgid "<i>Sniff the wine to see if it's been tampered with.</i>"
msgstr "<i>와인의 냄새를 맡아보고, 이상이 없는지 확인한다</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 7359248c-31e5-26d1-d0c1-ae759418c62d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Hav_Jaheira_JaheiraDrinksWine = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7359248c-31e5-26d1-d0c1-ae759418c62d
msgctxt "h33cdd2f2g7cddg4998gbdccg02ae4f211719"
msgid ""
"You might be... eccentric, but you're still our best hope of finishing off "
"Ketheric Thorm."
msgstr "자네는 좀... 괴팍하군, 그래도 케서릭 쏨을 끝장낼 수 있는 우리의 유일한 희망이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 74232d4c-e3cc-8e15-3ed9-a1171d8c288f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:74232d4c-e3cc-8e15-3ed9-a1171d8c288f
msgctxt "h5ff7419bg54ebg486eg8f56g87209c69f199"
msgid ""
"There are as many versions of a tale as there are people to tell it. Let "
"that satisfy you. And anyway, the heroics of old have done seemingly little "
"to safeguard the present."
msgstr ""
"수많은 이야기꾼들이 저마다 이야기를 달리 하니, 자네 취향대로 골라잡게. 게다가, 과거에 있었던 영웅적 행위 따위 지금은 별 도움도 되지 "
"않으니 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 74fefef6-3a5b-3b3d-70ac-90591d36fa70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Jaheira_State_ReactedToAbduction(1) = False
#.   Global:
#.      - HAV_TakingIsobel_Event_MolKidnapped = False
#.      - HAV_TakingIsobel_Event_AbductionAttempted = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Jaheira_State_ReactedToAbduction(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:74fefef6-3a5b-3b3d-70ac-90591d36fa70
msgctxt "h209d90fagb4afg4851g8c4eg15464f756685"
msgid ""
"Traitors among us, and still I can only feel <i>relief</i>. If we had lost "
"Isobel..."
msgstr "배신자가 우리 사이에 있었는데, 오히려 <i>안심</i>하게 되는군. 만일 이소벨이 잡혀갔다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 7529bf44-8172-44a8-d5ec-d6b8fc8d5b35
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_General_State_IsHostileToPlayers = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7529bf44-8172-44a8-d5ec-d6b8fc8d5b35
msgctxt "h3c09d1e5ga51ag416eg84f9g85771851b82b"
msgid ""
"I was a fool to trust you. For the last time. Harpers! There's a traitor "
"among us."
msgstr "조금이라도 널 믿은 내 잘못이다. 하퍼들이여! 우리 중에 배신자가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 758ae56f-a1c2-4f0d-58b0-c1ecc103b203
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:758ae56f-a1c2-4f0d-58b0-c1ecc103b203
msgctxt "h24e7e527g1e9fg4822g9c71g662e668a1ae5"
msgid ""
"Let's be discreet about this. If Marcus is what you say, there's no telling "
"what kind of reinforcements he might be able to summon."
msgstr "이 건은 신중해야 해. 만약 네가 말한 대로라면, 마커스 저 자가 어떤 지원군을 불러올지도 도통 짐작이 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 75eb8226-d3a5-550f-a7aa-e12c4928ba39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:75eb8226-d3a5-550f-a7aa-e12c4928ba39
msgctxt "h35840870g8a6ag4335gba96gec1b7611b68e"
msgid ""
"If we can discover the source of his immortality... why, the potential is "
"endless."
msgstr "그 불멸의 근원을 밝혀낼 수만 있다면... 잠재력은 그야말로 무한에 가깝겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 76d498c5-5af7-4d21-4075-7a09fb81efc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:76d498c5-5af7-4d21-4075-7a09fb81efc8
msgctxt "h6c31464fg2bfag4e54ga8cfgc8319807597e"
msgid ""
"A search burdened by unnatural darkness, but don't let that discourage you."
msgstr "정체를 알 수 없는 어둠 속을 뒤져야 하겠지만, 그것 때문에 용기를 잃지는 말게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 76d9a7fa-56a9-0e7e-ef7f-684a9a0a46c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:76d9a7fa-56a9-0e7e-ef7f-684a9a0a46c9
msgctxt "h15c44c34g34f7g4c45ga562g30e596286796"
msgid ""
"You've been to the Towers? Incredible. Your parasite has already served you "
"well."
msgstr "탑에 다녀왔다고? 굉장하군. 그 기생충이 아주 유용한걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 792b5808-632a-3e27-a5f5-7d724a816f33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:792b5808-632a-3e27-a5f5-7d724a816f33
msgctxt "hefceddefg4cf1g4e06g9cbcg4c9dabaaaeee"
msgid ""
"He healed right in front of me, and chased us into the shadows. Things "
"looked hopeless, but experience has taught me that no matter how bleak "
"things look, there's always hope."
msgstr ""
"그는 내 눈앞에서 회복하더니 그림자 속으로 우릴 추격해 왔어. 절망적인 광경이었지만 내가 경험으로 배운 게 있다면, 상황이 얼마나 암울해 "
"보이더라도 항상 희망은 있다는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 793d949b-2833-3975-b5b7-a0c1a08ed848
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:793d949b-2833-3975-b5b7-a0c1a08ed848
msgctxt "h25c7728age6b7g4f0bga8adgd4b77c279d40"
msgid ""
"I'm your only hope to infiltrate the cult. You don't get to question how I "
"do it."
msgstr "나만이 교단에 잠입할 수 있는 유일한 희망일텐데. 내 방식은 묻지 말아줬으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 79850f57-a1d6-5ab6-2db0-76e2427ebabd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:79850f57-a1d6-5ab6-2db0-76e2427ebabd
msgctxt "hd303e386g81a6g4029g950ag9a41acca4141"
msgid ""
"You've come from the shadows and wasted no time accusing one of our "
"companions of treason. It's all a little... odd."
msgstr "그림자를 뚫고 나와서는 숨도 쉬지 않고 우리의 동료를 고발했지. 모든 것이…이상해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 7b438b63-a253-2f5e-ca05-4edb177bdd7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7b438b63-a253-2f5e-ca05-4edb177bdd7d
msgctxt "hbed5cbd1g73feg41ddga94ag2b7fe075744e"
msgid "Is this some kind of test? Or a <i>game</i>, perhaps?"
msgstr "날 시험이라도 하려는 건가? 아니면 무슨 <i>장난</i> 인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 7d5b3cd9-c98d-e1a7-9a84-7639dcbef667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7d5b3cd9-c98d-e1a7-9a84-7639dcbef667
msgctxt "h79290e28g6e50g4f92ga1beg4c6f5fd14985"
msgid ""
"People tend to lose more than just flavour when illithids get their hands on "
"them. I speak from experience."
msgstr "일리시드가 인간의 통제권을 잡았을 때, 단순히 미각만 잃지는 않아. 경험해 봐서 알지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 7df89772-b38f-184d-37a2-312256bcebde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_State_AtCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7df89772-b38f-184d-37a2-312256bcebde
msgctxt "h2424c9eagafb7g4bf6ga634g04ab65f6b087"
msgid "I feel your pain - my companion Volo is loose with the truth too."
msgstr "그 기분 잘 알지. 내 동료인 볼로도 사실에 대한 관념이 느슨하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 7e218b95-6244-03cc-34fc-d65ce5fa6eec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7e218b95-6244-03cc-34fc-d65ce5fa6eec
msgctxt "hfa9ceb53gd085g4f8ag864bg414b0f40647d"
msgid "Sounds like necromancy at play."
msgstr "사령 마법이라도 쓴 모양이군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 7f8d4ff5-c994-5766-866b-04bb53fb753c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7f8d4ff5-c994-5766-866b-04bb53fb753c
msgctxt "hbff8bf02g144dg4fd5g833dged8ddb9d952f"
msgid ""
"Marcus? If he'd managed to get himself infected without a single Harper "
"noticing, I'd be... <i>very </i>surprised."
msgstr "마커스가? 그자가 그 어떤 하퍼에게도 들키지 않고 전향했다면야, 나는…<i>대단히</i> 놀라울 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 7fcdc715-5190-f014-08b4-e82a0af75584
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Constitution
#. DifficultyClass: 6
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Object:
#.      - HAV_Jaheira_State_DrankWine(1) = True
#.   Tag:
#.      - SORCERER(1) = False
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:7fcdc715-5190-f014-08b4-e82a0af75584
msgctxt "h9ca2cf2cgfc2bg41cdg88ceg27def0b69b36"
msgid "<i>Cloud your thoughts with your madness. Weave a lie.</i>"
msgstr "<i>머릿속을 광기로 뒤덮는다. 거짓말을 자아낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 802d97b5-5d51-319e-9f2a-46d26d5d6b33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = False
#.   Object:
#.      - HAV_Jaheira_State_DrankWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:802d97b5-5d51-319e-9f2a-46d26d5d6b33
msgctxt "hfcf76493g0066g44beg977cg5be4a7260dca"
msgid "The answer is no. It has no influence on me whatsoever."
msgstr "대답은 아니요. 전혀 영향을 미치지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 809e0040-5be8-b012-93af-148b743d583c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:809e0040-5be8-b012-93af-148b743d583c
msgctxt "he925235cge2c6g4ddfgafadgbeda23a502ea"
msgid ""
"Find out what it is that makes him invincible so we can strip him of his "
"advantage."
msgstr "도대체 뭐가 놈을 무적으로 만든 건지 밝혀내서, 놈의 그 이점을 없애버리는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 81d21d35-a923-2738-ca1f-6c1828e08127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:81d21d35-a923-2738-ca1f-6c1828e08127
msgctxt "h7d583b9dgc583g4b4bg9b40g9df4d5dc1cbe"
msgid ""
"Once Ketheric is without his shield, the sword: together we assault his "
"tower, and put a final end to this blight."
msgstr "일단 케서릭의 손에서 놈의 칼과 방패를 빼앗아 버리고 나면: 함께 놈의 탑을 공격하고, 마침내 이 재앙에 종지부를 찍는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 8495d767-afe6-f6e8-3e5b-cea54a40f8fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8495d767-afe6-f6e8-3e5b-cea54a40f8fe
msgctxt "h6bab2bd9g391cg430fga219g701637fd36cf"
msgid "And you strike that blow <i>alone.</i>"
msgstr "그 치명타는 너 <i>혼자</i> 꽂아 넣겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 85ad435a-93df-a6b5-e324-3f8a38522a0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:85ad435a-93df-a6b5-e324-3f8a38522a0b
msgctxt "h20d0c5bcg6e95g45b7g9b36g77018ac965a7"
msgid "I have to say, it's an honour to drink with you, ma'am. Cheers."
msgstr "당신과 함께 잔을 나누게 되어 영광입니다. 건배."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 85ee4262-4db9-378e-cbe7-73bac7ac8b0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:85ee4262-4db9-378e-cbe7-73bac7ac8b0e
msgctxt "ha11d184ag7f9eg4448gbfecgd21748a3e9d9"
msgid ""
"We fight, we die, and we just hope that when our time comes, there is "
"someone else to take our place."
msgstr "우린 싸우고, 죽어나갈 뿐, 그러다 우리가 갈 때가 되면, 누군가가 우리의 자리를 대신 해주길 바랄 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 86432bc4-dc49-67ac-cf0c-7a957b240129
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:86432bc4-dc49-67ac-cf0c-7a957b240129
msgctxt "hb516ee0dg93dcg4cddg8a4cg65974310a422"
msgid "All right, then. Trust it is."
msgstr "믿음이라, 좋습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 864ea5da-5c3f-792c-7044-4b6a4413853b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:864ea5da-5c3f-792c-7044-4b6a4413853b
msgctxt "h875baf20g1b97g44a7gb281gf8dd748f20aa"
msgid "Bottoms up."
msgstr "쭉 들이켜."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 87217153-31cc-10ed-4ec6-bac484038344
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:87217153-31cc-10ed-4ec6-bac484038344
msgctxt "h0e025e51g5bd1g41ecg88c2gfeaa5497a7ea"
msgid ""
"Then by all means, don't let me keep you. We can't end this until Ketheric "
"can bleed. I await your next report."
msgstr "그럼 지체하지 말고 어서 가 보게. 이 모든 게 끝나려면 케서릭이 피를 흘리는 몸이 되어야 해. 다음 보고를 기다리지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 87e60a15-0aa7-daf1-85cb-7a2fe9cd83f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:87e60a15-0aa7-daf1-85cb-7a2fe9cd83f1
msgctxt "he4ee11fag5961g4abbgb17fgc51ce907e2ea"
msgid ""
"Such a sharp tongue. Perhaps I'll stuff it in your ear, so you might enjoy "
"your own wit in death."
msgstr "혓바닥 한번 잘 굴러가는군. 귀에 쑤셔 박아서 죽어가면서도 자신의 재치를 즐길 수 있게 해줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 88234bb8-0f2c-dd22-b9e7-65cfcda9d1f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:88234bb8-0f2c-dd22-b9e7-65cfcda9d1f2
msgctxt "hd612e2b1g9f39g41abg8117ga87bf333c4ed"
msgid "Ketheric's days are numbered - I'll make sure of it."
msgstr "케서릭의 살날은 얼마 남지 않았습니다. 내가 꼭 그렇게 만들 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 88cbb0ae-0f67-86eb-4b17-632070c4edb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:88cbb0ae-0f67-86eb-4b17-632070c4edb2
msgctxt "hd0747437g12b3g4bccgb3cag4c53f64111c3"
msgid ""
"She cast the moon shield around the inn. It's the only reason we're still "
"alive."
msgstr "그녀가 여관 주변에 달의 장막을 펼쳐놓았네. 덕분에 우리가 아직 살아있는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 890afc1e-dc85-da62-3cb0-785711cec167
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:890afc1e-dc85-da62-3cb0-785711cec167
msgctxt "haf84108dgc64eg47e9gb617g27d911aba2f3"
msgid ""
"What?! So all this time, he has been leeching his life from an immortal? The "
"man is more parasite than anything in his True Souls' heads."
msgstr "뭐라고?! 그렇다면 그 긴 시간 동안, 불멸자로부터 생명력을 빨아내고 있었다는 건가? 네 머릿속의 기생충보다도 더한 놈이로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 89e8140e-52de-bb79-f225-3ea95d7361ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:89e8140e-52de-bb79-f225-3ea95d7361ff
msgctxt "h94f63a27ge6f7g40b2g964bg03dd84c8e06d"
msgid ""
"I prefer using Venian's Breath for interrogations - it doesn't carry a scent."
msgstr "저는 신문할 때 베니안의 숨결을 더 선호합니다. 아무 향도 안 나거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8a4386de-c7c3-e1e5-8101-e2dcdf86c803
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8a4386de-c7c3-e1e5-8101-e2dcdf86c803
msgctxt "h45bda205g222bg4057g9eaag43ff17fd1280"
msgid "Not with, er... absolute certainty."
msgstr "완전히... 확답은 못하겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Karlach
#. NodeID = 8a5efd4f-2f2f-d423-4434-8b95e159a154
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8a5efd4f-2f2f-d423-4434-8b95e159a154
msgctxt "h08ed370fgb878g4824ga503ge4fd4ab54899"
msgid "Tsh. Yeah. I mean, it's an honour. M'lady."
msgstr "크흐. 예. 아, 영광입니다. 부인."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8a7896d2-5ee9-4177-dea8-71c4e362285a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_State_DrankWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8a7896d2-5ee9-4177-dea8-71c4e362285a
msgctxt "h7d07ecc2g1318g4884g9be5g60351c69c7d1"
msgid "<i>Drink the wine.</i>"
msgstr "<i>와인을 들이킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 8b494fbd-ae66-55e8-0230-0ad35ffe5a13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8b494fbd-ae66-55e8-0230-0ad35ffe5a13
msgctxt "h288c2a7bg13e7g46begaf98g37403b7b9f67"
msgid ""
"Because it isn't my tale to tell. And because, in truth, I do not know the "
"half of it. Only this:"
msgstr "내가 할 얘기가 아니니까. 그리고 솔직히 난 이야기의 절반도 몰라. 그래도 이건 확실해:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 8b61de5e-b2b2-556f-5b87-36820fe030eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8b61de5e-b2b2-556f-5b87-36820fe030eb
msgctxt "hcfe4e303g27f1g4cfdg8455gdaac77162800"
msgid ""
"Well done. Did you learn how we might untether Ketheric from this Nightsong?"
msgstr "잘했어. 케서릭을 이 밤의 노래란 것으로부터 어떻게 떼어낼지도 알아냈어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8b928827-0526-c479-12e3-f5a5148e0418
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8b928827-0526-c479-12e3-f5a5148e0418
msgctxt "h068dfa37g1716g4913gb887g1ace9f699fda"
msgid "No, to yours. You don't know what it means to me to meet you."
msgstr "아니, 당신의 건강을 위하여. 당신을 만난 게 저한테 어느 정도의 의미인지 모르실걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8bf2bb10-6e29-632f-f8de-6635989e8779
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8bf2bb10-6e29-632f-f8de-6635989e8779
msgctxt "h2084bae6gc7eeg4754gbdf0g40df545e10ea"
msgid "A solid plan. Except it puts me right in the line of fire."
msgstr "탄탄한 계획이네. 내가 사선 한가운데에 놓이는 걸 제외하면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 8c610738-630f-fc48-5f8f-fedf10e055b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8c610738-630f-fc48-5f8f-fedf10e055b7
msgctxt "hcf40293fgca50g46d0gb719g0c039ee8bb02"
msgid ""
"Without a cure for your infection, your days are numbered too, yet you "
"selflessly offer to spend them fighting alongside us. I like you."
msgstr ""
"감염에 대한 치료제 없인 네 시간도 얼마남지 않았을 텐데, 그 시간을 우리 곁에서 싸우면서 보내고 싶다는 이타적인 제안을 하다니. 네가 "
"좋아지는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8d27981b-f500-1ced-c40f-f77bf73c6de2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8d27981b-f500-1ced-c40f-f77bf73c6de2
msgctxt "hf1953c61gfd48g43cega618g126cddc85c29"
msgid ""
"Trust me. This way, I get past the tower's defences - straight to the heart "
"of the enemy."
msgstr "날 믿어. 이 방법으로 타워의 방어체계를 지나쳐 적의 심장부로 바로 향할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 8dbb9012-36a6-8ba2-ef1a-fa3061c29da6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8dbb9012-36a6-8ba2-ef1a-fa3061c29da6
msgctxt "hc7766e39gb58ag4a38g8e94gf5f777a9a01d"
msgid ""
"I'm sure it's very fine. But lanterns have a tricky habit of going out when "
"you need them.\n"
"\n"
msgstr ""
"그래, 분명 좋은 등불이겠지. 하지만 등불은 이상하게도 꼭 중요할 때 나가버리곤 하잖아.\n"
"\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8dec776e-ddd5-ffae-cd49-e8e21ea1707e
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = True
#.      - HAV_Jaheira_State_DrankWine(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8dec776e-ddd5-ffae-cd49-e8e21ea1707e
msgctxt "he818e67cge9f6g4e71gbc11g0a1f13e417ea"
msgid "You've been indulging your illithid powers"
msgstr "일리시드의 힘을 맘껏 즐기고 있나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8dec776e-ddd5-ffae-cd49-e8e21ea1707e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = True
#.      - HAV_Jaheira_State_DrankWine(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8dec776e-ddd5-ffae-cd49-e8e21ea1707e
msgctxt "h5583a570g003bg436dg986dga7de124ac7a3"
msgid ""
"It's trying to change me, to win me over, but I'm resisting its temptations."
msgstr "그것이 날 변화시키려 하고, 나의 신뢰를 얻으려 하고 있죠. 하지만 그 유혹에는 저항하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 8e2571dd-bf59-fa06-056b-5845f1f76740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:8e2571dd-bf59-fa06-056b-5845f1f76740
msgctxt "hfba49562g308dg4ec0g9566gaebbe28cb71e"
msgid "You don't seem overly pleased to be remembered."
msgstr "별로 기쁘지 않은 모양이군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 9057bb87-03d7-494e-fa1d-e1b06c911172
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9057bb87-03d7-494e-fa1d-e1b06c911172
msgctxt "h13243846ga117g43fdg81c1g52cd4ec84631"
msgid "How did the Harpers first learn of the Absolute?"
msgstr "애초에 하퍼들은 어떻게 절대자에 대해 알게 된 겁니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 94a91e1e-88f5-6206-82a0-d5cac320b2b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:94a91e1e-88f5-6206-82a0-d5cac320b2b3
msgctxt "h39eb55d6gdfe0g4d3bg9994ge070623b9cd8"
msgid ""
"And <i>I </i>do not need to suffer a stranger in our midst, gambling with "
"our very lives without explaining <i>why.</i>"
msgstr "<i>나도 설명</i>도 없이 우리들의 목숨을 가지고 도박하는 이방인은 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 956dcdb4-2085-97eb-60f8-5ff8074a16be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:956dcdb4-2085-97eb-60f8-5ff8074a16be
msgctxt "h04d964f8g5690g491ag9150g7661b52dd899"
msgid "You are that hope."
msgstr "네가 그 희망이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 95746f2d-ad5b-358e-950f-c793d41e290e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:95746f2d-ad5b-358e-950f-c793d41e290e
msgctxt "hbf169f5ag00e1g4694g8834g19facb0a986f"
msgid ""
"Klauthgrass? I suppose I should be grateful you didn't use Venian's Breath."
msgstr "클로스 풀? 당신이 베니안의 숨결을 쓰지 않았다는 걸 기뻐해야 되겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 96c4c645-8b09-51a0-9e8c-8b4ef7c8a2fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:96c4c645-8b09-51a0-9e8c-8b4ef7c8a2fd
msgctxt "h5268b8f1g26c6g4570ga569gfb12139078ce"
msgid "I find that decidedly hard to believe."
msgstr "그건 정말 믿기 힘든데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 9781d895-a7f6-95e6-0542-0c6631321be8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Ketheric_Knows_ImmortalitySource = True
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_ToldKethericImmortalitySource = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9781d895-a7f6-95e6-0542-0c6631321be8
msgctxt "h40ef2b1ag1653g4bdcg925dgd3c1db3f4d75"
msgid ""
"I've already discovered the source of Ketheric's invulnerability: a "
"celestial called the Nightsong."
msgstr "이미 케서릭이 가진 불멸성의 근원은 알아냈어. 밤의 노래라는 천족이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 97ca07ee-4120-d118-3be2-cf427f331bdf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:97ca07ee-4120-d118-3be2-cf427f331bdf
msgctxt "h44a654beg3ad5g4260ga98ag290d09213e1a"
msgid ""
"Don't threaten me. Only one of us has the means to finish Ketheric, and it "
"isn't you."
msgstr "날 협박하려 들지 마. 우리 중 하나만이 케서릭을 끝장낼 수단을 가지고 있지, 그리고 그건 네가 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 97fc25d0-7592-4eeb-5404-b0bc9ace7f5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Jaheira_Knows_Jaheira = False
#. SetFlags:
#.   Global:
#.     - GLO_Jaheira_Knows_Jaheira = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:97fc25d0-7592-4eeb-5404-b0bc9ace7f5c
msgctxt "h6f4c5f9dga6cag47f4gb3a9gb290f431172b"
msgid "I've heard your name before. Where?"
msgstr "어딘가에서 당신의 이름을 들어본 것 같습니다만?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 995c0bb6-9892-f8eb-9f95-8d59075f659d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_SentNightsongBackToKetheric = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:995c0bb6-9892-f8eb-9f95-8d59075f659d
msgctxt "h4cb22b03gd009g4084ga895g659417f5998c"
msgid "No. I sent the Nightsong back to Ketheric."
msgstr "아니. 밤의 노래는 케서릭에게 돌려보냈어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 9a98b224-de68-8a4e-e48b-1a09b1d436fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9a98b224-de68-8a4e-e48b-1a09b1d436fd
msgctxt "he2bad10ag277fg4a2bg886ege417a110fd14"
msgid "Hope is my speciality. How can I help?"
msgstr "희망은 제 전문 영역이죠. 어떻게 하면 됩니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 9c0dc1ef-3755-2e3d-3902-cd55c669836b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_GiveOintment = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9c0dc1ef-3755-2e3d-3902-cd55c669836b
msgctxt "ha67a0453gbebcg44c5g9899gbfbda73b4b4b"
msgid "How do I reach him? The Towers are surrounded by shadows."
msgstr "놈에게는 어떻게 접근해야 합니까? 탑 전체가 그림자에 둘러쌓여 있던데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 9e06be36-3baa-d966-bc35-59be1d1e9f2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9e06be36-3baa-d966-bc35-59be1d1e9f2a
msgctxt "h76a75c02g5f3cg4c72g8944gdb4646bfdad9"
msgid "I don't think so."
msgstr "별로 공감은 안 되는데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 9e812a11-dfb0-45c9-0fdc-6411cb710a2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9e812a11-dfb0-45c9-0fdc-6411cb710a2e
msgctxt "h13a725bfg7f4cg4d62g9720ga3a3045c78cc"
msgid "If I drink this, how long before the poison you've added kills me?"
msgstr "이걸 마시면 당신이 탄 독이 저를 죽이기까지 얼마나 걸립니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 9ecb8582-5196-ee08-4bad-8eb2381e65be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9ecb8582-5196-ee08-4bad-8eb2381e65be
msgctxt "h4c3ebf28gdd3dg40c7gb6fbgd499560fb7db"
msgid "Any cure starts with understanding the disease."
msgstr "질병을 치료하려면, 먼저 그걸 이해해야 하는 법이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = 9f6f2c5b-dbc7-5638-3c06-923840c64d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9f6f2c5b-dbc7-5638-3c06-923840c64d7e
msgctxt "hf25c10cfg3526g4b9bg8f18gfd354bf3fbfb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = 9f9a1536-94ce-a050-19d3-fc527656ff56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:9f9a1536-94ce-a050-19d3-fc527656ff56
msgctxt "h0f415aa6g87a9g4518gb0bcgbb964d0af594"
msgid "Good. Because I'll cross your heart myself if you break it."
msgstr "다행이군. 안 그러면 내가 직접 네 심장을 그어버릴 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a0690403-cd73-59a4-b00a-4599cb8cec1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a0690403-cd73-59a4-b00a-4599cb8cec1c
msgctxt "h8f331aabgb01cg48c6g937cg483d8d6f3e0f"
msgid ""
"Let's be discreet about this. If Marcus is what you say, there's no telling "
"what kind of reinforcements he might be able to summon."
msgstr ""
"이 이야기는 조금 조용히 나눌 필요가 있을 것 같군. 자네 말이 사실이라면, 놈이 무슨 지원군들을 불러낼지 모르는 일이니까 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a0ddb260-c739-2785-6a4e-3248f9802f42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a0ddb260-c739-2785-6a4e-3248f9802f42
msgctxt "h4043c764g0b9bg45d3gb61dgfecd1e021646"
msgid ""
"It means you've found an old woman down to her last idea - drinking with a "
"mind flayer's infectee."
msgstr "네가 마지막 수단을 쓰는 늙은이를 만났다는 거지. 마인드 플레이어 감염자와 술을 마시는 것 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a1bd7ae7-b970-6205-f3d9-741b257b407a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a1bd7ae7-b970-6205-f3d9-741b257b407a
msgctxt "h23886160g41b7g40d2gb05ag185c99c7bf0d"
msgid "Not immediately."
msgstr "당장은 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = a31476e8-edd2-3faa-31be-7bb36fe52a55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_State_DrankWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a31476e8-edd2-3faa-31be-7bb36fe52a55
msgctxt "hdf9eab0ag32c4g4430gb2acg45eaefdc0e28"
msgid "<i>CHUG THE WINE.</i>"
msgstr "<i>와인을 마신다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = a40cd656-c510-89d6-ddbf-fcb7cf36142d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a40cd656-c510-89d6-ddbf-fcb7cf36142d
msgctxt "hc3daf3bdg034bg4d6dg9f92g0ba6f29d7aaa"
msgid "I have proof, if you'll just come upstairs and look."
msgstr "증거라면 있습니다. 위로 올라와서 직접 보시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a44e96e7-91d8-9681-53fd-b54292d6a573
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a44e96e7-91d8-9681-53fd-b54292d6a573
msgctxt "h95cabeeegc5b6g4e6ag9eb1gd9c9e0b560b0"
msgid ""
"Justify it whatever way you wish. The fact remains that I placed our lives "
"in your hands, and you tossed them down as a wager in some game of your own."
msgstr "네 맘대로 정당화하시지. 난 우리 모두의 목숨을 맡겼는데, 네가 너만의 꿍꿍이로 도박을 걸었다는 사실은 변하지 않으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = a46c57c5-71e0-3b46-36b9-5bb9229b30ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a46c57c5-71e0-3b46-36b9-5bb9229b30ea
msgctxt "ha01e21d1gb000g45b4g8163g796bbcbb9423"
msgid "You already knew. Why didn't you tell me?"
msgstr "이미 알고 있었군요. 어째서 진작에 알려주지 않은 겁니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a47e8384-4790-33d9-d739-a97b9f520291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a47e8384-4790-33d9-d739-a97b9f520291
msgctxt "h5763ee5bg2285g4293g8f44g0a223b9f1a37"
msgid ""
"Honesty will serve you better than charity. I blundered into their trap, and "
"it cost us."
msgstr "이럴 때는 동정심보다 정직함이 낫네. 내가 놈들의 함정에 빠졌고, 결국 우리 모두가 대가를 치르는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a5143454-acc9-ae43-f5fd-8692eb7003d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a5143454-acc9-ae43-f5fd-8692eb7003d0
msgctxt "h3f2013c1gcc34g4d95g8724g075f59e6fa08"
msgid ""
"You might be... eccentric, but you're still our best hope of finishing off "
"Ketheric Thorm."
msgstr "너는…괴짜지만, 그럼에도 아직은 케서릭 쏨을 끝장낼 우리 최고의 희망이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a52938ca-78b8-ee1e-ab5e-0d3bb4ae8b13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a52938ca-78b8-ee1e-ab5e-0d3bb4ae8b13
msgctxt "h32c1b4c0gbba1g46dfgb576g1314351fd1e1"
msgid "You were the last to be alone with her. And just like that, she's gone."
msgstr "그녀와 마지막으로 함께 했던건 자네였어. 그리고 그 이후로 그녀는 사라졌고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a88f5bae-a432-78c0-3c6b-1d88487537ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a88f5bae-a432-78c0-3c6b-1d88487537ed
msgctxt "h4d98810bgcfdcg420agbaedg530e590210a2"
msgid ""
"The light is rather dim, out here in the shadowlands. The point remains:"
msgstr "뭐, 이 그림자의 땅에서는 뭘 보기가 힘들긴 하지. 그래도 핵심은 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a8c9c056-66ce-d928-9bb5-bd47254e3da5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_SCL_Ketheric_State_PlayerKnowsKethericHistory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a8c9c056-66ce-d928-9bb5-bd47254e3da5
msgctxt "haf29f732g69abg4aacg886aga9138b2534ba"
msgid ""
"But he's returned. Not only does General Ketheric Thorm live again, it seems "
"he is no longer mortal. He has become, in fact, invincible."
msgstr "하지만 그가 돌아왔지. 케서릭 쏨 장군으로 살아돌아온 것뿐만 아니라, 더 이상 필멸자도 아닌 것 같아. 사실상 무적이 된 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = a8f4b389-617a-247e-db25-230d0800fa1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Jaheira_State_DrankWine(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a8f4b389-617a-247e-db25-230d0800fa1b
msgctxt "h7e3dfdd2gfdcfg4e62gb4b3gb72a1e882421"
msgid "The answer is no. It has no influence on me whatsoever."
msgstr "대답은 아니요. 전혀 영향을 미치지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a932d115-ddce-1733-4fd2-557dd5c34934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a932d115-ddce-1733-4fd2-557dd5c34934
msgctxt "h9e9eef40g861eg42dcg999cg8e5e2fa21b1c"
msgid ""
"Not, but it <i>does</i> leave the subject paralysed. Whatever comes after, I "
"would have you standing on your own two feet."
msgstr ""
"그렇지. 그렇지만 그건 대상을 <i>마비시키거든</i>. 이 다음에 나올 말이 뭐가 되었든, 네가 두 발로 서 있어야 내가 편해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = a963115b-ff33-5f03-83e1-e8ac9f061841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:a963115b-ff33-5f03-83e1-e8ac9f061841
msgctxt "h87bbe79cgc53bg4a7dga7f3g55475fc05614"
msgid "Criterion two: survive that thing in your skull."
msgstr "두번째 조건: 머릿속의 존재로부터 살아남기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ac4cf5c7-b85c-e747-6e94-67f682b271a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ac4cf5c7-b85c-e747-6e94-67f682b271a9
msgctxt "hc4d7b5e4g52c1g46aaga6a9gb8c950ff2730"
msgid ""
"The one and only. He was a Sharran, then. We caught him building an army of "
"Dark Justiciars. With the local druids, we made a powerful alliance and put "
"him down."
msgstr ""
"바로 그놈이지. 당시에는 샤 신도였어. 다크 저스티시어로 이루어진 군대를 조직하고 있길래, 주변의 드루이드들과 힘을 합쳐 동맹을 맺고 "
"놈을 쓰러트려야만 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = ac8015ad-643b-8b72-a7cf-bef79c48e87c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ac8015ad-643b-8b72-a7cf-bef79c48e87c
msgctxt "ha887be0fg470bg423bg9498ge1170142caa8"
msgid "Absolutely not. Marcus is a danger to you all."
msgstr "진심으로 하는 얘기예요. 마커스는 배신자입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ada5a373-514e-1589-3495-3dd12f44aab9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ada5a373-514e-1589-3495-3dd12f44aab9
msgctxt "h702aada9g5940g4d13g8ac4g5921f5806681"
msgid ""
"All right. He's in Isobel's room upstairs. Play along with his ruse for now "
"while I gather a few trusted Harpers - but don't let him get his hands on "
"Isobel!"
msgstr ""
"좋아. 놈은 지금 윗층에 있는 이소벨의 방에 있어. 내가 믿을 수 있는 하퍼들을 모아오는 동안 놈의 연기에 적당히 맞장구 쳐 주도록 - "
"하지만 절대 놈이 이소벨에게 손을 대게 해서는 안 돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ade26d70-9ba7-887f-33d8-580f4b37d321
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ade26d70-9ba7-887f-33d8-580f4b37d321
msgctxt "hcf16c0ceg7362g420bgb95dgb09f5f6a423a"
msgid "I assure you, it's quite safe."
msgstr "내 보증하지. 안전해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = af553365-be8b-0137-d5ea-b2355cdcb296
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:af553365-be8b-0137-d5ea-b2355cdcb296
msgctxt "h5631976cgc12fg476bgb41bg45a388c8201e"
msgid ""
"We sent an agent to infiltrate this cult - the latest fad among the city's "
"bored nobility, I thought."
msgstr "이 광신도들 사이에 잠입해 보라고 요원을 보냈지 - 처음에는 그냥 사는 게 지루한 귀족 양반들의 장난쯤 되는 줄 알았거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = b08fbfaa-b9ae-f394-ec12-b8c5e9e32f60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#.      - HAV_TakingIsobel_State_IsobelTakenAway = False
#.   User:
#.      - HAV_Jaheira_Knows_SentToKidnapIsobel(1) = False
#. SetFlags:
#.   User:
#.     - HAV_Jaheira_Knows_SentToKidnapIsobel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b08fbfaa-b9ae-f394-ec12-b8c5e9e32f60
msgctxt "h1d48dd14ged68g4c8bgb9d8g783832bba383"
msgid ""
"Ketheric wants Isobel brought to him - that might be a way to get further "
"inside."
msgstr "케서릭은 이소벨을 되찾고 싶어하더군요 - 그걸 이용할 수 있을 것 같습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b0f58d60-0f53-f358-1557-89ccdf8bc91c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b0f58d60-0f53-f358-1557-89ccdf8bc91c
msgctxt "h2262951agf27cg4327ga3fag32dff837d493"
msgid "Was there anything else?"
msgstr "다른 소식은 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = b2aaa181-e700-6cf1-61af-757aa6ef21b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b2aaa181-e700-6cf1-61af-757aa6ef21b1
msgctxt "h0517fd17g5f81g4b62ga681g459a7aa44251"
msgid "You can trust me."
msgstr "저를 믿으셔도 됩니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b2ef878d-565b-b5fb-ee3f-8dde03ceb124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b2ef878d-565b-b5fb-ee3f-8dde03ceb124
msgctxt "h9febfe07g4654g4c27ga133gb8a1581099c0"
msgid ""
"When I asked your aid, I did not think you the type to balance our lives on "
"petty intrigue."
msgstr "네게 도움을 청했을 때는 우리 목숨을 네 꿍꿍이와 저울질하는 부류라고 생각하지 않았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b32baed1-42c3-b32d-12e6-60832f72d313
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b32baed1-42c3-b32d-12e6-60832f72d313
msgctxt "h013aa905g09c5g4b95g9520gb97cb7871de3"
msgid "You will be refreshed, and I will be reassured."
msgstr "넌 기운을 되찾게 될 거고, 난 안심하게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b3c5f838-8955-551f-d046-c107f7c5311a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b3c5f838-8955-551f-d046-c107f7c5311a
msgctxt "h2d9066e5g36ceg4e3fg9701g355e54a60bce"
msgid "Isobel - a faithful cleric of Selûne, and a light in the darkness."
msgstr "이소벨 - 셀루네의 신실한 클레릭이자, 이 어둠을 밝혀주는 불빛이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b52be293-685f-ac0d-2069-f8cff40d33b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b52be293-685f-ac0d-2069-f8cff40d33b8
msgctxt "h47a0acc2g8e41g423bga2c7g8d1f74c6a1d2"
msgid ""
"Infiltrate the Towers, and Ketheric's downfall begins. What's more - you'll "
"find the cure for that thing in your head."
msgstr ""
"탑에 잠입하는데 성공하면, 케서릭의 몰락은 따놓은 당상이야. 어쩌면 자네 머릿 속의 그 문제에 대한 치료법을 찾을 수 있을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b53bc533-c0e7-809d-7206-9a6eeaa5f522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b53bc533-c0e7-809d-7206-9a6eeaa5f522
msgctxt "hcfa746d4g5ec9g446fg8d8dge9bfc1707e66"
msgid ""
"You seem like a good kid. But I'm going to hold you to that - with my "
"scimitar, if needed."
msgstr "너는 좋은 아이 같아 보이는구나. 하지만 난 계속 너를 지켜보고 있을 거란다. 필요하다면, 내 시미터를 들고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b563d612-9e95-7b0d-4d8e-8d7c01c20009
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b563d612-9e95-7b0d-4d8e-8d7c01c20009
msgctxt "h9969997cgcf27g4274gb9ceg5314f8b98e35"
msgid "You're quite serious, aren't you?"
msgstr "진심으로 하는 말이로군?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = b74e99d4-0d67-e865-fe9c-622f6ce01d19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b74e99d4-0d67-e865-fe9c-622f6ce01d19
msgctxt "h7382a5a0gc0fcg4ab7gae2bg24dc9c8f109f"
msgid "Who was - is - he?"
msgstr "그게 도대체 누굽니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b831b670-7bad-ad37-cde1-87a8772bb6c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b831b670-7bad-ad37-cde1-87a8772bb6c4
msgctxt "h3bf95e91g99a8g48dcga359g73828afc54a1"
msgid ""
"I'm not ignoring you - I just see no evidence of your rather outlandish "
"claim."
msgstr "널 무시하는 게 아니야. 그저 네 해괴한 주장에 증거가 없는 듯 보일 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b956d165-83ae-6765-09bf-d639e5847878
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b956d165-83ae-6765-09bf-d639e5847878
msgctxt "ha1f9af00g1a6cg4208ga72cga66ce37fbd24"
msgid "I will gladly drink to your health as well, Karlach."
msgstr "칼라크, 자네의 건강을 위해서도 기꺼이 한 잔 마시겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b96d183c-30fc-cbf2-6985-3e8f7ce9985d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b96d183c-30fc-cbf2-6985-3e8f7ce9985d
msgctxt "h45f304b4g8573g4e4fgab56g53c2d9521cee"
msgid ""
"General Ketheric Thorm. Remember that name. He's the leader of the "
"Absolutists."
msgstr "케서릭 쏨 장군. 이 이름을 기억하도록 해. 그자가 절대자 신도의 우두머리야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = b9c2773c-bd4d-8167-942d-d068e970cdd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:b9c2773c-bd4d-8167-942d-d068e970cdd8
msgctxt "h7c33edc5g3f98g477eg8066gaaa1e6ee5366"
msgid ""
"It was a lifetime ago. And for all our victories, the world is no more "
"balanced than when we began."
msgstr "옛날 얘기니까 말이지. 게다가 그렇게 거둬낸 승리에도 불구하고, 지금 돌아보면 그때보다 세상에 더 균형 잡히진 않은 것 같거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = ba23513b-2ae4-ab3c-e8b3-e6080ec87127
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DRAGONBORN
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ba23513b-2ae4-ab3c-e8b3-e6080ec87127
msgctxt "hf2ee6ea1gadcag403agaeffg04d83cca2edb"
msgid "*Her stare must be due to your rather impressive and rare physique.*"
msgstr "*자헤이라의 시선은 당신의 인상적이고 희귀한 체격 때문일 겁니다.\""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = ba23513b-2ae4-ab3c-e8b3-e6080ec87127
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ba23513b-2ae4-ab3c-e8b3-e6080ec87127
msgctxt "hbcbc2e28ga187g4608g8181gc6e598b2ea59"
msgid ""
"*You're used to this kind of stare. Perhaps she's never seen a githyanki "
"before.*"
msgstr "*당신은 이런 시선에 익숙합니다, 아마 자헤이라는 기스양키를 본 적이 없는 것 같습니다.\""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = ba23513b-2ae4-ab3c-e8b3-e6080ec87127
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: UNDERDARK
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ba23513b-2ae4-ab3c-e8b3-e6080ec87127
msgctxt "h1ea89fe0gf207g4464g8c72g6088bd8f42f1"
msgid ""
"*You're used to stares of this nature - not many have seen under-dwellers "
"before.*"
msgstr "*당신은 이런 시선에 익숙합니다, 지하에 사는 자들을 만난 적이 있는 사람은 많지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = ba23513b-2ae4-ab3c-e8b3-e6080ec87127
#. HandlePath = TaggedText[3].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ba23513b-2ae4-ab3c-e8b3-e6080ec87127
msgctxt "h526b0600gc97ag427cgad9dgc4e6a49e7a11"
msgid "*Her gaze betrays nothing.*"
msgstr "*자헤이라의 시선에 배신의 낌새는 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ba8e18ae-cf25-339c-7dd7-b48b240a2e10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ba8e18ae-cf25-339c-7dd7-b48b240a2e10
msgctxt "h40b108ddge833g45b5ga1ccga0a5e7108ec1"
msgid "But then, lies live forever, and he's half-made of the stuff."
msgstr "하지만 뭐, 거짓말은 원래 영원한 법이지. 게다가 녀석은 절반 쯤 거짓부렁으로 가득 찬 존재고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = bab55018-c517-14bc-02a7-4b50c7fb2b30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bab55018-c517-14bc-02a7-4b50c7fb2b30
msgctxt "h686447d5gd66cg44cdg8f74g843d7d6bd7ba"
msgid ""
"Tales of the undead are often exaggerated. You're <i>sure</i> you killed him?"
msgstr "언데드와 관련된 이야기는 자주 과장되곤 하죠. <i>정말로</i> 놈이 죽었는지 확인하셨습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = baee6a73-9067-fa68-86de-7931370c6654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:baee6a73-9067-fa68-86de-7931370c6654
msgctxt "h5e2a5fb9gfef8g428agba5fg8e41e9311fc4"
msgid ""
"He was a Sharran, once - took to building an army of Dark Justiciars beneath "
"this very village. Alongside the local druids, we made it our business to "
"see him deposed - dead and buried."
msgstr ""
"놈은 한때 샤 신도였어. 이 마을 바로 아래서 다크 저스티시어의 군대를 일으켰지. 이 땅의 드루이드들과 힘을 합쳐 그를 몰아낸 뒤, "
"죽이고 묻었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = bb358429-6095-28d5-9c5a-7fc0e4fdd8cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bb358429-6095-28d5-9c5a-7fc0e4fdd8cb
msgctxt "h3a769d2cgc160g4eedg9671g937818c3c6fa"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = bb60859c-f63f-ab59-92b2-e72785b6f6d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bb60859c-f63f-ab59-92b2-e72785b6f6d7
msgctxt "h8cb41172g0217g4b33g8a40g9eaca3eb5148"
msgid ""
"Help me root out this cult, and they can spin stories about <i>you </i>for a "
"change."
msgstr "자네가 날 도와 이 사교도들을 물리치고 나면, 녀석들이 <i>자네</i>에 대한 이야기들을 떠들어 댈지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = bbcdbb5f-a42e-0017-d55d-fe5423240178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bbcdbb5f-a42e-0017-d55d-fe5423240178
msgctxt "hf8f8d4bfg8ddfg4cbfga85ag61ba944be1a4"
msgid "Ketheric is calling himself a 'Chosen of the Absolute' now."
msgstr "케서릭은 스스로를 '절대자의 선택받은 자' 라고 칭하더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = bc5f23e9-2f02-8ece-1154-a2e900e7eaeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bc5f23e9-2f02-8ece-1154-a2e900e7eaeb
msgctxt "h6ea7e26bg3dc5g448fgb1c4ga9db3d308c9c"
msgid ""
"Klauthgrass - a rare specimen found in the Moonshae Isles that must be shorn "
"under a full moon. I'm honoured you'd go to such efforts for me."
msgstr "클로스 풀이라. 문셰이 섬에서 보름날 밤에만 채취할 수 있는 귀한 물건이군요. 저를 위해 이렇게나 애쓰시다니 영광입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = bdc3c740-0ef2-59a1-bb0f-4505b1c25bb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bdc3c740-0ef2-59a1-bb0f-4505b1c25bb2
msgctxt "h5af34a82gf357g48f7g976dgc9dd1081d6a9"
msgid ""
"Druids and Harpers reuniting to fight Ketheric once more - it is fitting. We "
"will free this land of him."
msgstr "케서릭에 대항해 드루이드와 하퍼가 다시 힘을 모았으니, 상황이 나쁘지 않아. 놈을 이 땅에서 몰아내자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = bddfcf46-dc74-5416-5c80-47acac92d4a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bddfcf46-dc74-5416-5c80-47acac92d4a9
msgctxt "h6cc75f95g97feg4bbdga605g384f5a316441"
msgid "I am glad ours ended on friendlier terms."
msgstr "자네와의 만남은 좀 더 좋게 끝나서 다행이라고 생각하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = bea62c81-fe07-12d6-7530-b1e8af9e0f32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:bea62c81-fe07-12d6-7530-b1e8af9e0f32
msgctxt "h4a22acf0g099ag4138g9498g61d9384b35da"
msgid ""
"Not an option. Even if Isobel were willing, the inn would not survive "
"without her."
msgstr "불가. 이소벨이 동의한다 하더라도 안 돼. 그녀 없이 여관은 버티지 못 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = c09118f1-5152-e920-4735-e352ce0fefbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c09118f1-5152-e920-4735-e352ce0fefbf
msgctxt "hfde42abdgef7cg4c86g9722gd90830a9039b"
msgid "Stirring words. Is that how you inspire your Harpers?"
msgstr "좋은 말이로군요. 그렇게 하퍼들의 사기를 고취시키는 겁니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = c0b0ec93-83b4-02e1-5ad9-15f1d5ae6861
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Necromancer_Knows_InvulnerabilitySource = True
#.      - GLO_Ketheric_Knows_ImmortalitySource = False
#.      - MOO_BalthazarsSecrets_Knows_NightsongSecret = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c0b0ec93-83b4-02e1-5ad9-15f1d5ae6861
msgctxt "h387eea39gc100g4446gb5acg44d21dc9e024"
msgid ""
"Ketheric's power stems from a relic in a Sharran temple: his pet necromancer "
"is trying to reach it."
msgstr "샤 신전에 숨겨진 유물이 케서릭의 힘의 근원인 것 같더군요: 놈의 애완 사령술사가 그걸 손에 넣으려 하고 있고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = c0ced6f6-fe5c-3239-26e9-8d03ec2ca546
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c0ced6f6-fe5c-3239-26e9-8d03ec2ca546
msgctxt "hc4afbdc3gd69eg45f3g80cegf446060df839"
msgid ""
"And you trust her? She's all that stands between us and the shadow curse."
msgstr "그녀를 신뢰하십니까? 그녀가 바로 그림자 저주와 우리 사이를 가로막고 있는 장애물입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = c141254e-5159-7087-a3a4-dc11966fc40f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c141254e-5159-7087-a3a4-dc11966fc40f
msgctxt "h27605dcag1c21g46f3ga796g5fc761a94fd3"
msgid ""
"The songs would have you believe we saved the Realms entire. Perhaps we did."
msgstr "노래들에 따르면,우리가 세상을 구했다고 하더군. 뭐, 그랬을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = c3f1375e-a1a7-2c65-9793-e693c513679f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c3f1375e-a1a7-2c65-9793-e693c513679f
msgctxt "h214663d6g7e41g4efbgba4bg6c47535d8733"
msgid "Did you learn anything more?"
msgstr "뭔가 알아낸게 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = c41b26f3-9534-0c84-32e0-bda694d0dd2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#.      - HAV_Jaheira_Knows_ToldKethericImmortalitySource = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c41b26f3-9534-0c84-32e0-bda694d0dd2c
msgctxt "hdcf22da0g5f14g46e5g871egc8fffe16b7ab"
msgid "The Nightsong. Have you learned anything more?"
msgstr "밤의 노래에 대해 알아낸 게 좀 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = c5f6d898-afa5-bc43-6f35-31f55f276620
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_IsobelGaveMission = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c5f6d898-afa5-bc43-6f35-31f55f276620
msgctxt "h98ddff9ege55cg45f3g8a59g74227ec13edf"
msgid ""
"She'll extend that protection to you too, if you see her. You've shown me "
"how well you can sniff out secrets - I'd like to see you turn that nose upon "
"Ketheric Thorm."
msgstr ""
"그녀는 자네에게도 자신의 보호를 제공할 거야. 이제 자네의 비밀 캐내는 솜씨가 얼마나 대단한지는 잘 알았으니 - 케서릭에게도 그 실력을 "
"좀 보여주는 게 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = c641b9cb-b5a1-cc1a-9547-e6852c159d43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c641b9cb-b5a1-cc1a-9547-e6852c159d43
msgctxt "haf5648fbg279bg40c7gba58g09e107d25a64"
msgid "It doesn't spoil the taste, if that's what you're wondering."
msgstr "궁금해 하는 게 뭔진 몰라도, 맛이 변하거나 하지는 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = c6fe2dd0-e997-c6dd-e275-8fe362b1172b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_Knows_TruthSerum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c6fe2dd0-e997-c6dd-e275-8fe362b1172b
msgctxt "h563fb9a1g2b6bg435bga272g9a07397f3e8e"
msgid "Until then, we'll keep drinking wine when we meet."
msgstr "그전까지는 아까 마시던 술이나 마저 마셔야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = c72cfe34-fbcd-842e-9403-9b23f03aa339
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_AbductionAttempted = True
#.      - GLO_HAV_IsobelGaveMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c72cfe34-fbcd-842e-9403-9b23f03aa339
msgctxt "h43b9a783g433eg4ffdgbf63g3ca611d2a3c3"
msgid "You've got a Thorm to undo."
msgstr "쏨을 처리할 방도를 찾아야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = c73ddf4d-14fc-ee29-8c38-d7a33433eeba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c73ddf4d-14fc-ee29-8c38-d7a33433eeba
msgctxt "h001b6284g307cg4f44g9595g59ff9978b445"
msgid "Surely you made more of a difference than that."
msgstr "그것보다는 이뤄낸 게 더 많을 것 같은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = c82c96c1-1a7b-2d4f-56a3-3979acad493b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c82c96c1-1a7b-2d4f-56a3-3979acad493b
msgctxt "h3a5f6c89g88e7g4efegaa02g496bfbbabc6f"
msgid "Nothing new to report yet, but the search continues."
msgstr "별로 보고할 내용은 없군요. 아직 조사중입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Narrator
#. NodeID = c8d31caa-fd42-cb03-4a01-0db11618b88e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:c8d31caa-fd42-cb03-4a01-0db11618b88e
msgctxt "h915f9e35g0ee9g448eg9708gaa0de08fddab"
msgid ""
"*She is anxious for you to drink the wine first - and it's an anxiety you "
"recognise.*"
msgstr "*자헤이라는 당신이 먼저 와인을 마시길 바라고 있으며, 당신이 그 사실을 알아챌까 불안해 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = cb2d081f-a6b0-9b36-20b6-38ed619a8feb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:cb2d081f-a6b0-9b36-20b6-38ed619a8feb
msgctxt "h9fe28d87g83dfg490bgbee8gb4ef69fde8f0"
msgid ""
"But a river can flood and break its banks. If the parasite changes you - "
"tries to break you - could you resist?"
msgstr "하지만 범람하는 강은 둑을 무너뜨리기도 하지. 그 기생충이 널 망가뜨리고, 변이시키려고 해도 저항할 수 있겠나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = cb35fed4-340e-efd5-3287-4ef77f6cec63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:cb35fed4-340e-efd5-3287-4ef77f6cec63
msgctxt "h3ab1cb5dg6704g4680g8727gdda0829dc374"
msgid ""
"Then you're a stronger soul than I. I at least have had <i>time </i>to "
"prepare that high-minded little speech. Still, if your faith ever wavers:"
msgstr ""
"자네는 나보다 더 강하군. 난 방금 그 연설을 떠올리느라 <i>애 </i> 좀 먹었는데 말이야. 이후로 자네의 믿음이 흔들린다면:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = cb3d075f-c748-e342-1c10-59e200a1ac79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:cb3d075f-c748-e342-1c10-59e200a1ac79
msgctxt "h75d03b27gf66cg4583g8921g38f0e50c2301"
msgid ""
"That was my failing. I thought to turn their trap to my advantage, and wound "
"up snaring us all the tighter."
msgstr "내 실수일세. 놈들의 함정을 우리에게 유리하도록 이용하려 했는데, 결국 우리 목만 더 조이는 신세가 되어버렸군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = cb8c038b-3877-d1a4-5e7b-644de4a31ce4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = False
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:cb8c038b-3877-d1a4-5e7b-644de4a31ce4
msgctxt "h0834f865g5bc3g4b8bg8a91gd9ea154c3604"
msgid ""
"How many will die if we storm the tower? This way, I'm welcomed as a hero."
msgstr "우리가 탑에 쳐들어가면 얼마나 많이 죽을지 생각해봤나? 이렇게 하면, 날 영웅으로 맞이할 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = cc12ddd4-1b01-38b1-6579-d911738daaf0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Ketheric_Knows_HasSeen = False
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:cc12ddd4-1b01-38b1-6579-d911738daaf0
msgctxt "h869e6477g5d02g40b4gb192g6b8fd9385eab"
msgid "Ketheric Thorm. He and I have history."
msgstr "케서릭 쏨. 그와의 과거가 있었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ccbedd3f-e9d9-e140-ed35-421c4a7e8770
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ccbedd3f-e9d9-e140-ed35-421c4a7e8770
msgctxt "h46358905ge3feg4772g80f5g14a158416564"
msgid "Let's not spurn what few gifts the gods choose to give us, hm?"
msgstr "신이 우리에게 준 몇 안 되는 선물을 거부하진 말자고, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = ccd9281a-841b-33da-de24-7acd109591b7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ccd9281a-841b-33da-de24-7acd109591b7
msgctxt "h31fb0801gc56bg4942g878agd6c22fb17bae"
msgid "I have proof, if you'll just come upstairs and look."
msgstr "증거가 있습니다. 위층으로 올라오시지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ce05763c-69ff-9244-4c0d-22187a3e9061
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ce05763c-69ff-9244-4c0d-22187a3e9061
msgctxt "h20fce271g0e9bg4976gb793g04dcb00c5cf5"
msgid "Do you. Well, let us not leave you in suspense, then."
msgstr "그러신가? 뭐, 너무 긴장하지 말도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = cf813136-3cb0-50c1-30b5-3e46dd6e85d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:cf813136-3cb0-50c1-30b5-3e46dd6e85d1
msgctxt "h36239bb4g50c2g4ea2ga9fbg5ae4e6ea7484"
msgid ""
"Now. You've shown me how well you can sniff out secrets. It's time you "
"turned that nose upon Ketheric, no?"
msgstr "이제 자네의 비밀 캐내는 솜씨는 잘 알겠으니, 그걸 케서릭에게 써보는 건 어떤가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d030f59f-1755-ef9c-a3a4-47e40bde2d78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d030f59f-1755-ef9c-a3a4-47e40bde2d78
msgctxt "h5b5b6bb0gac6eg4f30gb6c0g013d2d74bd13"
msgid ""
"I appreciate your enthusiasm. Just be sure it doesn't make you leap before "
"you look."
msgstr "열정이 넘치는 건 보기 좋지만. 그거 때문에 사고 치는 일은 없도록 조심하라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d09cb730-4735-7a9a-5dff-406fa5c4a6e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = False
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d09cb730-4735-7a9a-5dff-406fa5c4a6e1
msgctxt "hf6651d37g3b2fg4d67gb2bbg0682d188ac9d"
msgid ""
"Discover Ketheric's secret. Find out what it is that makes him invincible so "
"we can strip him of his advantage."
msgstr "케서릭의 비밀을 밝혀내게. 무엇이 놈을 무적으로 만들어주는지 알아내서, 그 힘의 근원을 제거해야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = d12270b8-5725-4f1c-100c-19bfae76fb73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d12270b8-5725-4f1c-100c-19bfae76fb73
msgctxt "h14f053f2g344ag41edg93bfg7d4338a3eb80"
msgid "<i>'Trust'? </i>You tried to kill me the first time we met."
msgstr "<i>'믿음'이라고요? </i> 절 처음 만나자마자 죽이려 하셨잖습니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = d1f99357-b97e-8c43-1df0-0b908e272c3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#.   Object:
#.      - HAV_Jaheira_State_DiscussIsobelFather(1) = False
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_State_DiscussIsobelFather(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d1f99357-b97e-8c43-1df0-0b908e272c3e
msgctxt "h63909567g4633g4895gab24g5dbcd79febb4"
msgid ""
"I've been looking into Ketheric. I suspect Isobel might be his daughter."
msgstr "케서릭에 대해 조사해 보았습니다. 이소벨이 그의 여식인 듯 하더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Karlach
#. NodeID = d2920a8f-91de-456f-9d65-6a8c8d841da4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d2920a8f-91de-456f-9d65-6a8c8d841da4
msgctxt "hf4b41765gd02fg428cg97bdg5ab025f82d15"
msgid "Oh my <i>gods!</i>"
msgstr "와 이런 <i>세상에!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = d2d42c27-4965-89f4-661f-31d594108146
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d2d42c27-4965-89f4-661f-31d594108146
msgctxt "hbe22d832gf5f7g453egba6fg3a3af03abb1f"
msgid "You want to make use of my infection - I want to be cured of it."
msgstr "감염된 내 상태를 이용하고 싶은 건가요? 난 그 상태를 치료하고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d33d8db6-7358-05b9-efca-326af5077f6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d33d8db6-7358-05b9-efca-326af5077f6a
msgctxt "h392485e4gbe37g4164g8382gf210c4d234ab"
msgid ""
"I'll wager it's the source of his invulnerability. He'd protect that at "
"<i>any </i>cost."
msgstr "바로 그게 놈의 무적의 힘의 근원일꺼야. 그걸 <i>어떠한</i> 대가를 치뤄서라도 지키려 하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = d3ef783c-9908-53b9-4af4-92d0ecbf1fae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d3ef783c-9908-53b9-4af4-92d0ecbf1fae
msgctxt "h3cf33172g6179g4a4dga88fg7673021dd04b"
msgid ""
"I've done so much since the crash, who's to say it's the tadpole that "
"changed me?"
msgstr "내가 함선에서 추락한 이후로 많은 걸 해냈는데, 누가 올챙이가 날 변이시켰다고 할 수 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d4071706-ad31-3adc-6f84-605b8b64d821
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_TruthSerum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d4071706-ad31-3adc-6f84-605b8b64d821
msgctxt "h5b6a1811gcf7fg4cb8ga494gff835e0b34c1"
msgid "It's the wine. I added a herb to your cup that betrays your lie."
msgstr "와인 때문이야. 네 잔에 거짓말을 드러내는 약초를 넣었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d485d255-4e27-7a6a-818a-709374bd023c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d485d255-4e27-7a6a-818a-709374bd023c
msgctxt "h4a534709g32d9g4dd4g8a7egbdf4f2db37e9"
msgid "That was a public display of hope, despite private reservations."
msgstr "희망사항을 말한 것뿐이었어. 개인적으로 의구심이 들긴 했지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d64459bf-ca70-1d35-e441-d74acc3ffefe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d64459bf-ca70-1d35-e441-d74acc3ffefe
msgctxt "h0c8f373dg88f4g408eg8dffgad0a8cd8b557"
msgid "There's an air about you. Something - alien."
msgstr "그런 분위기가 네게서 풍겨 나온다. 무언가 - 이질적인."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = d67bbfd1-0356-51eb-8826-afda0b9caf35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d67bbfd1-0356-51eb-8826-afda0b9caf35
msgctxt "hf8f8a518ga532g439agb2cege3fd2c83ae7f"
msgid "I'm not thirsty."
msgstr "목 마르지 않습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d688d106-9101-de20-c284-9dc8ad1e2d00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d688d106-9101-de20-c284-9dc8ad1e2d00
msgctxt "h66c4023cg5fd0g4525ga133gf3d02647b854"
msgid ""
"I'm not ignoring you - I just see no evidence of your rather outlandish "
"claim."
msgstr "널 무시하는 게 아니야. 그저 네 해괴한 주장에 아무런 증거가 없어 보일 뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d72035f1-3c17-9c50-ea56-a62a3cf796a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d72035f1-3c17-9c50-ea56-a62a3cf796a4
msgctxt "h1f4ecf5fg02f8g4fa8gae3dg75c6ab55d04c"
msgid ""
"We tracked them to this ancient village only to be faced with a man we "
"killed and buried over a century ago."
msgstr "교단 놈들을 추적해서 이 오래된 마을까지 왔고, 백 년도 더 전에 우리가 한번 죽여서 묻어버렸던 놈을 마주하게 되었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = d7436483-020f-4606-a828-8d5b37b2f467
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Drider_State_HasMoonlantern(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d7436483-020f-4606-a828-8d5b37b2f467
msgctxt "hc656942cg3269g4a91g9a9agb90ad80d0a92"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = d84cf729-09de-bd10-50a9-d8a08e2744d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:d84cf729-09de-bd10-50a9-d8a08e2744d1
msgctxt "h47152ba2g678dg46dagb9a7g8ecf434cb82f"
msgid ""
"<i>'Sent'? </i>Meaning you had the source of all of Ketheric's power in your "
"grasp, and you gave it <i>back</i> to him?"
msgstr "<i>'보냈어'?</i> 케서릭의 힘의 근원을 확보했는데, 그에게 <i>도로</i> 줬다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = dc111fa4-ca0d-8502-9f67-9da981981a2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:dc111fa4-ca0d-8502-9f67-9da981981a2a
msgctxt "h57f5abfbgc07fg454dg8627g85a9e7bf56cb"
msgid "Gruesome, isn't it? I'm glad you survived the encounter, at least."
msgstr "끔찍하지? 놈을 만나고도 살아남았다니 다행이로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = dc16d4be-c6b5-f763-5969-57028afe250b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:dc16d4be-c6b5-f763-5969-57028afe250b
msgctxt "h9b341815g07e5g4045g9fb7g64d3a912b6c9"
msgid "I hope I'm not mistaken."
msgstr "내가 실수한 게 아니길 바라지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = dcd06d73-9b66-57d3-acd4-9040e111019f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_DiscussMarcus = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:dcd06d73-9b66-57d3-acd4-9040e111019f
msgctxt "hb1634b5dg3815g464cgbc28gff1fcd5bc4c1"
msgid "You did well bringing this to me - thank you."
msgstr "내게 말해 주어서 큰 도움이 되었군. 고맙다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = dda823f6-c058-7f0f-34c2-f9f0091388c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_AbductionAttempted = False
#.      - HAV_Jaheira_State_MissionGiven = False
#.   User:
#.      - HAV_TakingIsobel_UserShortCut_SkipWine(1) = False
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Event_DrankWithJaheira = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:dda823f6-c058-7f0f-34c2-f9f0091388c7
msgctxt "h6cc301b5g5841g43c6gadc4gb75259b47bbe"
msgid "Please, be welcome. Have a drink."
msgstr "어서와. 한 잔 마셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = de2170ca-376f-e7f5-bf6e-bda5dc09e7aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#.     - ORI_Laezel_State_StartedMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:de2170ca-376f-e7f5-bf6e-bda5dc09e7aa
msgctxt "hf70c52f6g1bdbg42e9gb2d7g42b788e6e407"
msgid ""
"This relic must be your focus instead, then. Find it. Strip him of its power."
msgstr "이 유물을 찾는데 집중하도록 하게. 그걸 찾아내서, 놈의 힘을 빼앗는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e1a970fd-dbcf-e9fe-df81-aeed35a2dede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e1a970fd-dbcf-e9fe-df81-aeed35a2dede
msgctxt "h04c43457gbc99g463egb193ge96cae4f8d27"
msgid "Find what makes him vulnerable. It remains the only way."
msgstr "놈의 약점이 뭔지 밝혀내게. 그게 유일한 방도야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e2fce053-53f5-684f-f4f1-08782bc16d87
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_StartedMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e2fce053-53f5-684f-f4f1-08782bc16d87
msgctxt "h8a81e7ffge0f8g4ceag9adagaf371a802066"
msgid ""
"Agreed. We must end the threat at Moonrise altogether. With your help, we "
"stand every chance of doing just that."
msgstr "동감일세. 모두 함께 힘을 합쳐 문라이즈의 위협을 끝장내야만 해. 자네의 도움이 있다면, 가능성은 충분하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e35a04a9-6e47-2e06-0e57-166a9d701213
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e35a04a9-6e47-2e06-0e57-166a9d701213
msgctxt "h36b39b55gffc9g4dbeg8e04g2b765abd57b1"
msgid "That remains to be seen. Criterion number one: make Ketheric bleed."
msgstr "그건 두고 볼 일이지. 첫번째 조건: 케서릭의 계획 망치기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = e3c7e10a-2c78-5d4c-2d95-2d4b6921076a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e3c7e10a-2c78-5d4c-2d95-2d4b6921076a
msgctxt "he6c0c4b8g7e40g438agbcf9gbe3f54c06b15"
msgid "You can, ma'am. I wouldn't lie to you."
msgstr "믿으셔도 됩니다, 선생님. 실망시켜드리지 않을게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e4f273a2-9ad1-6b33-f96a-89c4294c86e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e4f273a2-9ad1-6b33-f96a-89c4294c86e3
msgctxt "h15676443g1b67g4ad5g999bg7485fb7c7b55"
msgid "And so I gathered my Harpers and came to the source - Moonrise Towers."
msgstr "그래서 내 휘하의 하퍼들을 이끌고 그 근원 - 문라이즈 타워로 향한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = e541f70f-7454-96aa-bffd-4feeffdd9f0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyConfrontationStarted = False
#.      - HAV_TakingIsobel_State_SpyIsDefeated = False
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#.   Object:
#.      - HAV_Jaheira_State_TriedConvinceFlamingSpy(1) = False
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_Knows_WasWarned(0) = True
#.     - HAV_Jaheira_State_TriedConvinceFlamingSpy(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e541f70f-7454-96aa-bffd-4feeffdd9f0b
msgctxt "h1a1c3705gc06fg4b98g81dbgffb4cf266fdb"
msgid ""
"Jaheira, there's something you need to know: Marcus is a True Soul, and he's "
"planning to kidnap Isobel."
msgstr "자헤이라, 얘기 좀 하죠: 마커스는 참된 영혼입니다, 녀석은 이소벨을 납치할 음모를 꾸미고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = e545e4bd-f57b-4167-0f5c-b8bd64ee75b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(1) = False
#.      - MONK(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e545e4bd-f57b-4167-0f5c-b8bd64ee75b4
msgctxt "h5c9f3c54g13f9g4351gb1ffgfdec027d2784"
msgid "What do you have in mind?"
msgstr "계획이라도 있습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = e618495f-fdcc-0551-469f-9c0859a8f490
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_State_DrankWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e618495f-fdcc-0551-469f-9c0859a8f490
msgctxt "hef9b0442ge7d7g4622gb1a8g90e850860745"
msgid "To your very good health."
msgstr "건강을 위하여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e6593f7e-b69e-0026-fc09-0325f41e074f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e6593f7e-b69e-0026-fc09-0325f41e074f
msgctxt "h874ef06dgc31eg4e9dg8999ga6a2aa7f6093"
msgid "Pick one. Whichever is quicker. And do it <i>now</i>."
msgstr "더 빠른 방식으로 처리하도록 해. 지금 <i>당장</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e67a54f4-12f8-cb72-c163-8683877149a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e67a54f4-12f8-cb72-c163-8683877149a7
msgctxt "hb072b0e9ga968g4c64gb388g5db3bfadf0db"
msgid "You're not our only secret weapon."
msgstr "우리의 비밀 병기가 자네 혼자만은 아니거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e6d4f1fe-66ab-8dad-956b-5651feaf5edc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_Knows_TruthSerum = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e6d4f1fe-66ab-8dad-956b-5651feaf5edc
msgctxt "h98bd3d6fg7d5dg4faagb084g6a27b6520a61"
msgid ""
"I've only added a touch of Klauthgrass - a quaint herb that encourages truth-"
"telling."
msgstr "클라우스 풀만 살짝 넣었지, 진실을 말하게 해주는 신기한 약초야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e72d5f91-ff54-dac8-2cd7-d53adce17da5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e72d5f91-ff54-dac8-2cd7-d53adce17da5
msgctxt "h7b747b70g08e0g4beag8627g120cb14a4ee2"
msgid ""
"The great General is paranoid. Good - that means he's protecting something."
msgstr "대장군께서 피해망상에 빠지셨다라. 좋은 소식이군 - 무언가를 지키려 한다는 뜻일테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = e88cd22c-4248-22ac-c5ea-9d6cb94354c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_AbductionAttempted = False
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:e88cd22c-4248-22ac-c5ea-9d6cb94354c6
msgctxt "h493d337bg2bcbg46d7gb4ffg36c768dcca68"
msgid "The shadows haven't consumed you. Good."
msgstr "아직 그림자에 잡아먹히지는 않았군. 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = ea3cdbe3-119d-e10b-ed42-cf254607ef9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ea3cdbe3-119d-e10b-ed42-cf254607ef9d
msgctxt "hc40d7d2bg7e74g41c2gbf89g0f961950303a"
msgid "What happened to me being the godsend you've been praying for?"
msgstr "나더러 당신이 바라던 신의 선물이라 할 땐 언제고요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = eada4839-ee91-34a9-0b13-868ebe9e03a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#.   Object:
#.      - HAV_Jaheira_State_DiscussIsobelFather(1) = False
#. SetFlags:
#.   Object:
#.     - HAV_Jaheira_State_DiscussIsobelFather(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:eada4839-ee91-34a9-0b13-868ebe9e03a6
msgctxt "h8dc2c2a8g9ec0g480ega820g2618ff6f154c"
msgid ""
"Jaheira, you should know - I have reason to believe Isobel could be a Thorm. "
"Ketheric's daughter."
msgstr "자헤이라, 아셔야 할 게 있어요. 이소벨이 쏨이라 생각합니다. 케서릭의 딸 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = eddbc7ec-fb86-f32e-b86e-18b4fac1f210
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:eddbc7ec-fb86-f32e-b86e-18b4fac1f210
msgctxt "h0f7cb8afg61b5g4f3ega3e1gbd9a6aae1895"
msgid "I'm trying my best to be..."
msgstr "노력은 하고 있습니다만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ee0d6c24-6c20-0f7f-192d-f40969e3041c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ee0d6c24-6c20-0f7f-192d-f40969e3041c
msgctxt "hfef88aebg49d5g47a4ga8e5g74d6a66a3e25"
msgid "A noble proclamation. It must have you made you quite thirsty."
msgstr "선언 한 번 고결하시군. 떠드느라 목이 꽤 컬컬할 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = ee598b6a-334e-65a1-013e-05e55513864e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 25f33ec7-32d6-6965-4cdd-ccd20416be5b_once = True
#.      - 25f33ec7-32d6-6965-4cdd-ccd20416be5b_once_again = False
#. SetFlags:
#.   Local:
#.     - 25f33ec7-32d6-6965-4cdd-ccd20416be5b_once_again = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ee598b6a-334e-65a1-013e-05e55513864e
msgctxt "hb3a2e5b8g5ca6g406cgae99g16b34317767c"
msgid "Questions about Isobel? What do you mean?"
msgstr "이소벨에 대해 물어볼 게 있다고요? 무슨 소립니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ee5b9418-ce23-2df7-b61a-7180ea7c6670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ee5b9418-ce23-2df7-b61a-7180ea7c6670
msgctxt "hc75c1fa4g26c9g49b1gb6fdge35ca74e32dc"
msgid ""
"Until that same agent returned and tried to plant a knife in my neck. My "
"first encounter with a True Soul."
msgstr "뭐, 그 요원이 돌아와서 칼을 들고 내 목을 따려고 하기 전 까지는 말이야. 그게 내 참된 영혼과의 첫 만남이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = ee781a13-cb9d-619e-14ac-e630773b0e99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ee781a13-cb9d-619e-14ac-e630773b0e99
msgctxt "hc30811b2g6482g480egb26eg6531ba6814cb"
msgid "I assume you have some payback in mind?"
msgstr "놈들에게 보복할 계획은 있는 거겠죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = eefe2443-c047-e84d-48fb-c94912e80dbc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - Hav_Jaheira_JaheiraDrinksWine = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:eefe2443-c047-e84d-48fb-c94912e80dbc
msgctxt "h48298e51g7034g4755gb881g6a84299cce01"
msgid "Well over a century old and yet it hasn't lost a hint of flavour."
msgstr "이건 100년이 지났는데도 아직 맛이 변할 기미가 안보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ef34ab9e-eede-c614-8638-9889173d1599
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ef34ab9e-eede-c614-8638-9889173d1599
msgctxt "hb7fb617fga487g47e0g962eg9f208596680b"
msgid "They have me slaying gods or laying with them, depending on the bard."
msgstr "바드 녀석들, 내가 신을 죽였다느니, 아니면 놈들과 잠을 잤다느니 하는 이야기를 퍼뜨리고 다니더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = f1c6b0da-de45-9ff0-5035-ce94c0a7d4d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_ConfrontedAboutHerFather = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f1c6b0da-de45-9ff0-5035-ce94c0a7d4d8
msgctxt "h9591b0e0g436cg46b5g8395g8ba93fde6927"
msgid "I'll need to speak to her myself."
msgstr "그녀와 직접 이야기를 해야겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = f2decea8-8aa4-3987-eb6b-7e6b9bab07bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f2decea8-8aa4-3987-eb6b-7e6b9bab07bc
msgctxt "h28c27f1fgb2e1g4d64gad47g5a259b8733c8"
msgid ""
"Yes. The parasite is giving me powers I never had before. It's changing me "
"for the better."
msgstr "그래요. 기생충이 전에 없던 힘을 줍니다. 날 더 좋게 변화 시키고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = f39691d3-0440-9656-2430-b2cb9c8f2935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f39691d3-0440-9656-2430-b2cb9c8f2935
msgctxt "h55953717g77d3g42fag8d19gd4aeb9f6f231"
msgid ""
"Ketheric has the knowledge to save me. You're just a ruined old woman hiding "
"in a ruined old inn."
msgstr "케서릭은 날 구할 방법을 알고 있어. 넌 쓰러져 가는 여관에 숨어 지내는 쓰러져 가는 늙은이일 뿐이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = f44e2d4a-7e44-0c3d-ad26-4db652a81ecd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f44e2d4a-7e44-0c3d-ad26-4db652a81ecd
msgctxt "h6d13e998g5cccg49f9g9621ge760ce4de032"
msgid "You have the honour of making up for my mistake."
msgstr "자네가 내 실수를 만회해줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = f75daa10-cb9b-86c4-1d5b-b11b8854c5bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f75daa10-cb9b-86c4-1d5b-b11b8854c5bc
msgctxt "h98b18b06g214ag4411gb33ege6a70ea741b7"
msgid ""
"You speak frivolously. I do not believe you grasp the <i>cost</i> of what "
"we're dealing with."
msgstr "가볍게도 말하는군. 아직 <i>상황</i> 파악이 제대로 안 된 모양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = f80e950b-69a1-2ca4-72c2-a3a56052fc4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f80e950b-69a1-2ca4-72c2-a3a56052fc4f
msgctxt "h67267fedgf13eg473eg94d9ge1787c4b694b"
msgid "They simply refuse to <i>stay </i>saved."
msgstr "하지만 세상은 그렇게 구해진 상태로 <i>머무르는 걸</i> 별로 좋아하지 않더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = f9099533-56ad-dab9-1467-c9be5013f8df
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f9099533-56ad-dab9-1467-c9be5013f8df
msgctxt "h6f7ff323g4b04g462fgb293g7b5d9aba5b1b"
msgid "Ignore me, then. It's your own funeral."
msgstr "그럼 무시하시죠. 관짝에 들어가시게 생겼군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = f91188b1-6cf7-0dc9-5b4a-d3da4621be8a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - HAV_TakingIsobel_UserShortCut_SkipWine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f91188b1-6cf7-0dc9-5b4a-d3da4621be8a
msgctxt "h2ea162b8g61cbg4b16g9073g4b6292a19963"
msgid ""
"Look around you: good men, good women, stranded here - two feet in the grave."
msgstr "네 주변을 한번 봐봐. 훌륭한 사람들, 좋은 사람들이 오도 가도 못하고 있어. 자기 무덤이 될지도 모르는 곳에서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = f94184ce-85f4-26ff-ce91-cd93aeaf4e76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f94184ce-85f4-26ff-ce91-cd93aeaf4e76
msgctxt "hdbda6eafg3a71g433ag84eag21f90d1df6e2"
msgid ""
"We met him on the road here - commanding an army of the Absolute, intent on "
"destroying Baldur's Gate. I put an arrow through his eye myself, only to "
"watch him pluck it out like a splinter."
msgstr ""
"여기로 오던 길에 놈과 한 번 마주쳤지. 발더스 게이트를 무너뜨리겠다면서, 절대자의 군대를 지휘하고 있었어. 그래서 녀석의 눈구멍에 직접 "
"화살을 박아줬는데, 아무렇지도 않다는 듯 그냥 뽑아내더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = f9e9e9ca-2ba6-b2d1-194a-0cdfe68bacd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:f9e9e9ca-2ba6-b2d1-194a-0cdfe68bacd9
msgctxt "hca1c9a6cg2771g4421ga94dg01159c5693d7"
msgid ""
"It's trying to change me, to win me over, but I'm resisting its temptations."
msgstr "그것이 날 변화시키려 하고, 나의 신뢰를 얻으려 하고 있죠. 하지만 그 유혹에는 저항하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = fc366df2-24bf-0d7a-9b49-7df42ede8192
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.      - GLO_TadpoledCount3(1) = True
#.      - HAV_Jaheira_State_DrankWine(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:fc366df2-24bf-0d7a-9b49-7df42ede8192
msgctxt "h9a161bd6gd69fg4302gbd06g57de4b8b6fc5"
msgid ""
"It's trying to change me, to win me over, but I'm resisting its temptations."
msgstr "그것이 날 변화시키려 하고, 나의 신뢰를 얻으려 하고 있죠. 하지만 그 유혹에는 저항하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ff01faf4-427e-b2b1-67b0-8317b6a3bd79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ff01faf4-427e-b2b1-67b0-8317b6a3bd79
msgctxt "hc64c703eg6169g40a1g8c2fg79c1db852f0d"
msgid ""
"Why would you take the knife from our enemy's throat? Unless, perhaps, he is "
"not <i>your </i>enemy at all."
msgstr "어째서 적의 목에 들이댄 칼을 거두는 거지? 그가 <i>너의</i> 적이 아니고서야 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ff2664d4-77b9-efb4-9d4f-f105d97a7604
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ff2664d4-77b9-efb4-9d4f-f105d97a7604
msgctxt "heb46e81eg3439g4b89ga7e6ge336bbc67078"
msgid ""
"I bear more blame for the shadow curse than Isobel does. And she can no more "
"control her parentage than you can that thing in your head."
msgstr ""
"이 그림자 저주에 대해서는 그녀보다 내 책임이 더 커. 게다가 자네 머릿 속의 그 괴물처럼, 그녀의 가정사도 어찌 할 도리가 없는 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ff572e61-e515-afd3-6957-acd102acdcdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ff572e61-e515-afd3-6957-acd102acdcdd
msgctxt "hd36b863agf630g4fc0gbb0dg4de92ae28482"
msgid ""
"When I find myself needing a reminder of just who Isobel Thorm is, I simply "
"step outside and look up."
msgstr "난 이소벨 쏨이라는 여자가 도대체 누구인지 의문이 들 때면, 밖으로 나가 하늘을 쳐다본다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Jaheira
#. NodeID = ff9e41bf-5727-49ba-c436-b139d8b54901
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ff9e41bf-5727-49ba-c436-b139d8b54901
msgctxt "hfaf89ce3g30d4g45aagba58g63cbc35f9fe3"
msgid ""
"Without a cure to your infection, that lifetime might become rather limited."
msgstr "감염을 치료하지 않는 이상, 그 일생도 얼마 남지 않게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira
#. Speaker = Player
#. NodeID = ffe49543-bbc7-15e5-d374-6f5d62fac99d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericRegenerated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira:ffe49543-bbc7-15e5-d374-6f5d62fac99d
msgctxt "h7701d427g9be5g40bagaa7bg369e6e418ded"
msgid "I saw Ketheric. He regenerated before my eyes."
msgstr "케서릭을 직접 만났습니다. 재생을 하더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint
#. Speaker = Jaheira
#. NodeID = 6b86a9dc-868a-bdf9-7b39-c972f13225e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_B = False
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_A = True
#. SetFlags:
#.   Local:
#.     - 711e258b-bc7b-91ef-6f55-978cf278df6a_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint:6b86a9dc-868a-bdf9-7b39-c972f13225e1
msgctxt "h3e4c9dabg31f3g4423ga9a8g2b0a2f6a891a"
msgid ""
"If you see movement, don't be too quick to shoot. Friend and foe look alike "
"in the deep shadows."
msgstr "움직임이 보여도 섣불리 행동하지 마. 어둠 속에선 아군도, 적군도 구분이 힘드니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint
#. Speaker = Jaheira
#. NodeID = 9421f8a5-ebca-e201-2387-1b6fc8fd8fb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_B = False
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_A = False
#. SetFlags:
#.   Local:
#.     - 711e258b-bc7b-91ef-6f55-978cf278df6a_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint:9421f8a5-ebca-e201-2387-1b6fc8fd8fb8
msgctxt "h39653560g708fg4778g98b8g0383afb95b92"
msgid ""
"Look for torch fire in the distance, but do not venture out. Wave the patrol "
"over to safety."
msgstr "저 멀리서 횃불이 피어오르는 지 확인하되, 출정하지는 말게. 정찰대에게 손을 흔들어 안전한 곳까지 인도하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint
#. Speaker = Jaheira
#. NodeID = c0bc54a7-87a0-2d4c-f98f-292d1f0ef278
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_B = True
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_A = False
#. SetFlags:
#.   Local:
#.     - 711e258b-bc7b-91ef-6f55-978cf278df6a_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint:c0bc54a7-87a0-2d4c-f98f-292d1f0ef278
msgctxt "hc0d1e77bgd193g4d4eg96d4g5e4d9cb2f4de"
msgid ""
"They'll be back, don't you worry. Lighter than the dark, faster than the "
"shadows - that is how they move."
msgstr "돌아올테니 걱정마. 어둠보다 가볍게, 그림자보다 빠르게 움직이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint
#. Speaker = Jaheira
#. NodeID = ee8c7eaa-e04f-670a-180d-ff634a9e6116
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_B = True
#.      - 711e258b-bc7b-91ef-6f55-978cf278df6a_A = True
#. SetFlags:
#.   Local:
#.     - 711e258b-bc7b-91ef-6f55-978cf278df6a_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_AtCheckpoint:ee8c7eaa-e04f-670a-180d-ff634a9e6116
msgctxt "hd1c0ce0dg7bb7g4b4cg8517g7ec4d097d697"
msgid ""
"They're taking their sweet time, aren't they, Harpers? Must be some good "
"picnic spots out there."
msgstr "좋은 시간 보내나 봐, 안 그래, 하퍼들아? 나들이하기 좋은 곳이 있나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_Attention
#. Speaker = Jaheira
#. NodeID = 1ec58118-774f-c682-a687-ca66bc03df14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_Attention:1ec58118-774f-c682-a687-ca66bc03df14
msgctxt "h3406c39aga6e2g442cgadf5g712d979904fc"
msgid "Don't wander far - we need to talk."
msgstr "멀리 가진 마. 할 얘기가 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_CombatTaunts
#. Speaker = Jaheira
#. NodeID = 1b902899-765d-4ca5-a5f4-990c474f57aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d3d3855d-6721-b089-5c1e-d6d255a46fdc_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_CombatTaunts:1b902899-765d-4ca5-a5f4-990c474f57aa
msgctxt "h9d8b57daged4eg4251g805eg5930f133fc4f"
msgid "Serene she might seem, but nature has fangs!"
msgstr "고요해 보이지만, 자연도 이빨을 드러낼 줄 알지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_CombatTaunts
#. Speaker = Jaheira
#. NodeID = c8fc38d4-3537-457c-bea7-4ba9f8e8c55d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d3d3855d-6721-b089-5c1e-d6d255a46fdc_A = True
#. SetFlags:
#.   Local:
#.     - d3d3855d-6721-b089-5c1e-d6d255a46fdc_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_CombatTaunts:c8fc38d4-3537-457c-bea7-4ba9f8e8c55d
msgctxt "hf4efe81dgd346g49ecgb329g4aa70ad678d5"
msgid "For the fallen!"
msgstr "쓰러진 자들을 위하여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_CombatTaunts
#. Speaker = Jaheira
#. NodeID = f7132a11-e65e-4ca0-bdea-748802ba7373
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d3d3855d-6721-b089-5c1e-d6d255a46fdc_B = True
#. SetFlags:
#.   Local:
#.     - d3d3855d-6721-b089-5c1e-d6d255a46fdc_A = False
#.     - d3d3855d-6721-b089-5c1e-d6d255a46fdc_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_CombatTaunts:f7132a11-e65e-4ca0-bdea-748802ba7373
msgctxt "hfe83e192g96b0g4a49ga733g544b2a22dd05"
msgid "You are scarcely fit to feed the earth."
msgstr "이 땅의 거름으로도 못 쓸 놈 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Harper Callie
#. NodeID = 005033d8-ed29-8b62-5060-2e1290c9cc1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0b4277d-abc9-9593-3198-42731945d50e_C = False
#.      - d0b4277d-abc9-9593-3198-42731945d50e_A = True
#.      - d0b4277d-abc9-9593-3198-42731945d50e_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:005033d8-ed29-8b62-5060-2e1290c9cc1c
msgctxt "h31f73792ge63eg4b8ag8383gb03b19e689b3"
msgid "Do you think any of the other Flaming Fist are compromised?"
msgstr "저희를 배신한 플레이밍 피스트가 또 있을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Jaheira
#. NodeID = 563cae5a-9ad0-35d2-dcae-3de20b47160e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d0b4277d-abc9-9593-3198-42731945d50e_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:563cae5a-9ad0-35d2-dcae-3de20b47160e
msgctxt "h05d7d921gbe34g4c98gb71ag3275eebf33b0"
msgid "Just Marcus. At least that's what our new friend tells me."
msgstr "마커스뿐이야. 적어도 이 친구는 그렇게 말하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Jaheira
#. NodeID = 5747b8dd-6781-bbe0-d2c7-5944a3de945b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0b4277d-abc9-9593-3198-42731945d50e_C = False
#.      - d0b4277d-abc9-9593-3198-42731945d50e_A = False
#.      - d0b4277d-abc9-9593-3198-42731945d50e_B = False
#. SetFlags:
#.   Local:
#.     - d0b4277d-abc9-9593-3198-42731945d50e_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:5747b8dd-6781-bbe0-d2c7-5944a3de945b
msgctxt "h089e9648gc000g4c87g9878g8c01406f41fe"
msgid ""
"Cultists, fiends, and now a traitor in our midst. Some things never change."
msgstr "광신도, 마족, 이젠 배신자까지. 변하지 않는 것들도 있다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Jaheira
#. NodeID = a6f2fc53-1434-e9d9-825f-69e238b19a63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0b4277d-abc9-9593-3198-42731945d50e_C = False
#.      - d0b4277d-abc9-9593-3198-42731945d50e_A = True
#.      - d0b4277d-abc9-9593-3198-42731945d50e_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:a6f2fc53-1434-e9d9-825f-69e238b19a63
msgctxt "h613a03ecgc1d9g4b27g8ff4gef3de970b2ff"
msgid ""
"Listen. Marcus is a traitor. He's with the Absolute. We have to be ready to "
"move in before he can stage an attack."
msgstr "잘 들어. 마커스는 배신자야. 절대자와 손을 잡았지. 놈이 공격하기 전에 대비하는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Harper Callie
#. NodeID = cd1f69a7-c2ce-39d2-599f-34956c9fdd24
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d0b4277d-abc9-9593-3198-42731945d50e_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:cd1f69a7-c2ce-39d2-599f-34956c9fdd24
msgctxt "h14cea745gb2ceg41c2gb6aeg2c77881566e7"
msgid ""
"We've been infiltrated? Thank the gods you found him out. Give the order. "
"I'm with you."
msgstr "놈이 잠입한 거로군요? 밝혀내서 정말 다행이에요. 명령만 내리세요. 함께하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Jaheira
#. NodeID = e031d2f0-79c5-409d-76d6-644d0617cce0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:e031d2f0-79c5-409d-76d6-644d0617cce0
msgctxt "h4703b9bfg46a1g4fd2gb977g8b7e7e8708c4"
msgid ""
"Haven't you noticed how close an eye he keeps on Isobel? Think about it: no "
"Isobel, no Last Light."
msgstr "놈이 이소벨을 얼마나 주시하고 있는지 몰랐어? 생각해봐, 이소벨 없이는 최후의 빛도 끝이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Harper Callie
#. NodeID = f3e6b2d8-f613-8084-4e0a-bf61849ff764
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0b4277d-abc9-9593-3198-42731945d50e_C = True
#.      - d0b4277d-abc9-9593-3198-42731945d50e_A = True
#.      - d0b4277d-abc9-9593-3198-42731945d50e_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:f3e6b2d8-f613-8084-4e0a-bf61849ff764
msgctxt "hc4f1baf7ga1f2g4566gbf4ag5d36f93784a6"
msgid "But what does Marcus want? What's his target?"
msgstr "하지만 마커스가 원하는 게 뭐죠? 뭘 노리는 걸까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus
#. Speaker = Harper Callie
#. NodeID = fcbc72bd-cd8a-c7e7-27a6-4a1175a49c7c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d0b4277d-abc9-9593-3198-42731945d50e_C = False
#.     - d0b4277d-abc9-9593-3198-42731945d50e_A = False
#.     - d0b4277d-abc9-9593-3198-42731945d50e_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_DiscussingMarcus:fcbc72bd-cd8a-c7e7-27a6-4a1175a49c7c
msgctxt "h4c0d6f06gb8c1g4a89gb5e9g425bdabb1458"
msgid ""
"Isobel... of course! We have to apprehend him now, before he can strike."
msgstr "이소벨이라... 역시! 녀석이 공격하기 전에 당장 붙잡아야겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_PlayersAttackJaheira
#. Speaker = Jaheira
#. NodeID = 8417a0dc-4cd6-4bd9-97e5-0793344f8ffc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_AD_PlayersAttackJaheira:8417a0dc-4cd6-4bd9-97e5-0793344f8ffc
msgctxt "h42b7d527gc1c0g47f1gba1ag8fa2c7b809b6"
msgid "Harpers, to me! We have a True Soul to crush."
msgstr "하퍼들이여, 내게로 오라! 여기 쓰러뜨려야 되는 참된 영혼이 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 0362a2d9-7902-4bb2-942a-797eeb97bec8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:0362a2d9-7902-4bb2-942a-797eeb97bec8
msgctxt "h5885f17agaf12g41d6gb2c2g6e4b2541f1f7"
msgid ""
"And I hope that we shall have that chance. But not at the expense of the "
"world entire."
msgstr "나도 우리에게 그 기회가 왔으면 좋겠네. 하지만 온 세상을 희생할 필요까지는 없었으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 07c6cfb5-8f8d-42d8-ab04-0ebcea5530a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:07c6cfb5-8f8d-42d8-ab04-0ebcea5530a3
msgctxt "h01b0bf85gb502g4290g818bg9d4c3148b6a5"
msgid ""
"Don't I? We both left this land with a half-victory in hand at most - but "
"only one of us settled for it."
msgstr "그렇나? 우리 둘 다 기껏해야 반쪽짜리 승리를 거머쥐고 여길 떠났지만, 하지만 그걸로 만족 한 사람은 둘 중 한 명뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 21f948e2-ab8d-956d-034b-3734def46f7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:21f948e2-ab8d-956d-034b-3734def46f7a
msgctxt "h034dcc19g8ae7g47a1g915dg8b1acbf76c27"
msgid ""
"Those of us who saw the birth of the shadow curse seem doomed to return, and "
"bear witness to its work again."
msgstr "그림자 저주의 탄생을 본 자들이 결국 다시 돌아와 이 저주가 가져올 참상을 목격할 운명에 처한 듯 하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 3b0d999e-176a-a679-3236-663fd2becbb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:3b0d999e-176a-a679-3236-663fd2becbb6
msgctxt "h9121eb58g1991g4a75gb5f1g7634bf074972"
msgid ""
"Your stewardship of the Emerald Grove has made for something of a story "
"among the circles."
msgstr "당신이 에메랄드 숲을 보살피던 시절 무용담이 드루이드 회합에서 자주 돌더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 4ac3f2ab-eca6-451a-974b-17ee7b0c63c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:4ac3f2ab-eca6-451a-974b-17ee7b0c63c8
msgctxt "hef8004c4g791fg430bgb18fg7f7286050bd3"
msgid ""
"The Archdruid Halsin. Do not be surprised that I know your name - you fit a "
"rather singular description."
msgstr "대드루이드 할신이라니. 내가 이름을 안다고 놀라진 마 - 한 눈에 알아보게 생겼으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 508b1a23-90ff-1ab7-b062-b56048be13fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:508b1a23-90ff-1ab7-b062-b56048be13fd
msgctxt "h61546e4aga858g4eeegba9fg8bb2d8850b41"
msgid ""
"The apprentice who survived the shadow curse, and carried his masters home "
"on his back. Who was raised their master in turn, and searches still for a "
"way to save what was lost."
msgstr "그림자 저주에서 살아남은 제자가 스승들을 구해내 돌아왔군. 이제는 그들을 간호하며 잃어버린 것을 되찾으려 노력한다고 들었네. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 6ad30df4-5b02-7d35-d74f-3784b9ae1748
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:6ad30df4-5b02-7d35-d74f-3784b9ae1748
msgctxt "h33fbb9cdg6a05g44cfg9820gf8c701a0b9d6"
msgid "Not the battle, nor what came after."
msgstr "그 전투도, 그 후에 일어난 일도 결코 잊을 수 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Player
#. NodeID = 73b7a48a-e581-4e49-93fb-2fd29c831a39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:73b7a48a-e581-4e49-93fb-2fd29c831a39
msgctxt "h4ed72831g5b1eg4283gaf7dgf4963dfbd866"
msgid "We owe a debt to this land. To finish what we started."
msgstr "이 대지에는 큰 빚을 졌습니다. 이제는 모든 일을 매듭 지을 순간이지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Player
#. NodeID = 87f90fbb-ce2f-4f91-a148-059bf60d1d15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:87f90fbb-ce2f-4f91-a148-059bf60d1d15
msgctxt "h1dc6ecc1gd1ceg4392g9ad5ga23ad930e36d"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Player
#. NodeID = 8e03bda6-f743-402d-8d5b-4973373eb48e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:8e03bda6-f743-402d-8d5b-4973373eb48e
msgctxt "hd62463e6gd2bdg4b70ga571g55356cff84d7"
msgid "I mean to do both."
msgstr "저는 양쪽 모두를 해결하고자 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = 9e382407-07fc-4aac-972c-f09a325d3ceb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Jaheira_HasMet_Halsin(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:9e382407-07fc-4aac-972c-f09a325d3ceb
msgctxt "h1fb4334bg7841g4ecbg8978g5ab50fbbe779"
msgid "Archdruid. May the Oakfather raise the road before you."
msgstr "최고 드루이드여. 부디 아버지 떡갈나무가 그대의 앞길을 보살피시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = ab43b3c4-0ee2-3b9d-d631-25aa28533610
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:ab43b3c4-0ee2-3b9d-d631-25aa28533610
msgctxt "h3ef8faacg38d4g4b38gada0g279fa7b36219"
msgid ""
"It has become my way, perhaps, to always have one eye on the next fight. For "
"better or worse, that is the cult."
msgstr "요즘 들어서는 곧 벌어질 전투만 대비하며 살아가는 것 같네. 좋건 나쁘건, 교단에게는 그렇게 맞설 수밖에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Player
#. NodeID = acbe5019-c5e7-3bff-e646-1e32d08afd18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:acbe5019-c5e7-3bff-e646-1e32d08afd18
msgctxt "h85ce6286g9172g4cf8g8b8bg4d6046d5f19d"
msgid "It is an honour to see you again, High Harper."
msgstr "다시 보게 되어 영광이군, 고위 하퍼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = aef67f84-ca2f-996a-87b7-da21b08689b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:aef67f84-ca2f-996a-87b7-da21b08689b6
msgctxt "he08ab61agd50cg4b17ga461g57f2fa00113d"
msgid "And one survivor of the shadow curse's fall ought to know another."
msgstr "게다가 그림자 저주에서 살아남은 사람이라면 서로 알아보는 법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = af5b0ab7-ff28-1dfe-cb8b-80a1c5474917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:af5b0ab7-ff28-1dfe-cb8b-80a1c5474917
msgctxt "h74fe6e1eg916cg434cga6b7ged58a2bfbee1"
msgid ""
"Though I will not be the one to fight it, I think. The one you journey with -"
" we have already spoken of infiltrating Moonrise."
msgstr "하지만 전투를 벌일 사람은 내가 아닐 거 같군. 자네와 함께 여행하는 사람과 이미 문라이즈에 잠입하는 계획에 대해 이야기했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Player
#. NodeID = bbd71af7-b5e6-48cb-2981-98579c4e9805
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:bbd71af7-b5e6-48cb-2981-98579c4e9805
msgctxt "hd0a04cefgcd04g4cd3gab6egbd82d3d28459"
msgid "No one who witnessed that battle is likely to forget it."
msgstr "전투를 직접 봤다면 잊기 힘들지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = c47de813-eb44-78c0-514e-34039066b65a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:c47de813-eb44-78c0-514e-34039066b65a
msgctxt "hdecb515bgc2fdg47f9gbd9fg15c4db301258"
msgid ""
"No need for titles. You may call me Jaheira, so long as you are content to "
"be known as Halsin. And the honour is mine."
msgstr "격식은 치우지. 네가 할신이라 불리는한, 자헤이라라고 불러도 돼. 오히려 영광이라구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = c563ea23-0290-48ca-9447-26faed6ed4cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:c563ea23-0290-48ca-9447-26faed6ed4cd
msgctxt "h66f0a511g6259g47b6g90d1ga7d72cd68e4f"
msgid ""
"Then I'll pray for the Oakfather to raise the road before you, but my battle "
"is with the Absolute."
msgstr "그렇다면 참나무 아버지께 당신 앞길이 순탄하길 빌어주지, 난 절대자를 상대하러 왔으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Player
#. NodeID = de788e6a-610f-4b66-9854-4b2e893de52d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:de788e6a-610f-4b66-9854-4b2e893de52d
msgctxt "h616c98cdgb5a4g441fgad4dge85089b29376"
msgid "You don't have to explain yourself to me."
msgstr "저한테 굳이 설명하지 않아도 됩니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = e7562fc0-9c9c-4aa9-6e8a-7982b4b0ac3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:e7562fc0-9c9c-4aa9-6e8a-7982b4b0ac3d
msgctxt "h87694778g5beeg43ccgb5e5g77508d19fde4"
msgid ""
"One carrying a tadpole - a True Soul - might be able to reach Ketheric. And "
"then... perhaps we will find a way to fight <i>both</i> our battles."
msgstr "올챙이를 지닌 참된 영혼이라면, 케서릭을 만나게 해 줄 거야. 그럼 ... <i>전부</i> 처리할 방법을 찾을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Player
#. NodeID = e820e811-25c2-f970-cd79-e9b808277739
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:e820e811-25c2-f970-cd79-e9b808277739
msgctxt "h2a71851fg8c02g42adg9fb0g68b3270b4ff3"
msgid "We never actually got to meet, when fighting Ketheric that first time."
msgstr "케서릭과 처음 싸운 당시에는 제대로 인사하지 못했죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = f2f811d9-e2d4-d248-f106-c84b6fbdb13b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:f2f811d9-e2d4-d248-f106-c84b6fbdb13b
msgctxt "h2780ca93g2619g48d1g89dcg91961c9f09bd"
msgid ""
"But I ought to warn you, Halsin. Much as it shames me - it is not the curse "
"I come to cleanse, but the cult."
msgstr "하지만 할신, 안타깝게도 하나 얘기해 주자면, 난 저주를 정화하러 온 게 아니라 교단을 없애러 온 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = f71c3cb4-dcfe-b08e-e197-696ca6016d46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:f71c3cb4-dcfe-b08e-e197-696ca6016d46
msgctxt "hc6b79cc3gb3ecg493fgac67g1b5be2ddfca4"
msgid "No. We were a host hundreds strong, after all. Until we were not."
msgstr "그래. 우린 수백으로 이루어진 군대였으니까. 결국엔 몇 명 안 남았지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin
#. Speaker = Jaheira
#. NodeID = f7920e0e-c4ae-c0c7-dc76-ba12608b02fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_MeetsHalsin:f7920e0e-c4ae-c0c7-dc76-ba12608b02fd
msgctxt "h1ded8002g5c5ag45e1gaab4gafda40e70084"
msgid ""
"Though I will not be the one to fight it, I think. The one you journey with -"
" we ought to speak."
msgstr "하지만 맞설 사람은 내가 아닐 것 같군. 너와 함께 다니는 저 사람과 얘기 좀 해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_OutOfPosition
#. Speaker = Jaheira
#. NodeID = 1729bb0e-0657-46b8-2ddd-6997cb0677d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_DiscussMarcus = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_OutOfPosition:1729bb0e-0657-46b8-2ddd-6997cb0677d6
msgctxt "h95bfb331ga3d0g4549g9df2g2fa769774233"
msgid "Bear with me for a moment, there are better places to talk."
msgstr "잠깐만, 여기서 할 얘기는 아닌 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Jaheira_OutOfPosition
#. Speaker = Jaheira
#. NodeID = 1c3bdf01-231d-1167-4c2c-b6bc84a96501
