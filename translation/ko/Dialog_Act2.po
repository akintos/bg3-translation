#.     - 40f1f8f3-bb4c-5f25-6d22-2ad9120959c2_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_GEN_AD_IntellectDevourer:c6ed59a2-19c6-4d99-a689-bac9baa745ce
msgctxt "hf073b288g98afg438eg8d6ag3373cf917c9a"
msgid "So many lonely souls, waiting to become us."
msgstr "우리처럼 되고 싶은 외로운 영혼들이 너무 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_GEN_AD_IntellectDevourer
