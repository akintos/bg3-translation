#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:adcb4df0-cbd8-e5b5-2ff5-4c432f21e0e4
msgctxt "h98dc6555ged1dg4da9gbc98g74b992e5073c"
msgid "What happens to the bodies of those that 'ascend'?"
msgstr "그 '승천'이란걸 한 이들의 육체는 어떻게 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Goblin
#. NodeID = b8719bd4-2eb9-f515-f610-9e02af7d771d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Oubliette_CorpseMembranes_Dead_Asked_Flesh(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:b8719bd4-2eb9-f515-f610-9e02af7d771d
msgctxt "h8b64ec0ag719fg46d4g9f94g070364587380"
msgid "Left flesh... joined with Her... eternally..."
msgstr "육신을 버리고... 그분과 함께한다... 영원히..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Player
#. NodeID = c4973490-3801-449b-b19f-5dc0138eb717
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Oubliette_CorpseMembranes_Dead_Asked_Ascended(1) = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:c4973490-3801-449b-b19f-5dc0138eb717
msgctxt "hbc81e5begdd61g4cf9gba57gf00d40ee174a"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Narrator
#. NodeID = cbe440db-fa3a-4283-9b3e-35eb0d7bb7b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:cbe440db-fa3a-4283-9b3e-35eb0d7bb7b4
msgctxt "hd72b93d7ga72bg42c9g869fg2cfe480a4e99"
msgid ""
"*The corpse remains silent. That was more of a comment than a question, "
"really.*"
msgstr "*시체가 침묵을 유지합니다. 당신의 말은 질문이라기보다는 논평에 가깝습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Goblin
#. NodeID = d30d0c6b-5bfa-4032-be2c-4c22267be1a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:d30d0c6b-5bfa-4032-be2c-4c22267be1a8
msgctxt "h9dcf7e6ege769g467cgbf69geff62348846d"
msgid "Vermit... True Soul..."
msgstr "버미트... 참된 영혼... "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Narrator
#. NodeID = d895cba3-e7f5-402c-828b-9328650ecd62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:d895cba3-e7f5-402c-828b-9328650ecd62
msgctxt "h4f6f9ff9gb69eg4667g92a9ga7fa69f1bcf5"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Narrator
#. NodeID = da9b2577-bc2e-4419-b414-5356b09dcb7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:da9b2577-bc2e-4419-b414-5356b09dcb7d
msgctxt "hfc0db68dgea59g4425gbb7dg9db66f131668"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Player
#. NodeID = daf4c101-3e1e-452e-bc5a-a9685a5d9b67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:daf4c101-3e1e-452e-bc5a-a9685a5d9b67
msgctxt "hc0f833fega869g4378g99ddgf7afe70fcff3"
msgid "Who are you?"
msgstr "당신은 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Goblin
#. NodeID = e1627005-81ac-4957-a2bf-fb15438f0909
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Oubliette_CorpseMembranes_Dead_Asked_Ascended(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:e1627005-81ac-4957-a2bf-fb15438f0909
msgctxt "h19f9f0f7gb1cag4be8gbe1bg9e426cea4c74"
msgid "Saw Absolute... Ascended..."
msgstr "절대자님을 봤다... 난 승천했다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Narrator
#. NodeID = e3ddf0d4-b7e7-4624-8956-e8a9666404f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:e3ddf0d4-b7e7-4624-8956-e8a9666404f9
msgctxt "h14f4b51cgd919g4c0eg84acgeaaeef140553"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Goblin
#. NodeID = eba8ef5e-212c-4179-a235-8c25c6ca86e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Oubliette_CorpseMembranes_Dead_Asked_Ascended(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:eba8ef5e-212c-4179-a235-8c25c6ca86e0
msgctxt "hfb21a677g4968g44e4gab29gfbe9e884ebf4"
msgid "Not Killed... <i>Ascended</i>..."
msgstr "살해당한 게 아냐... <i>승천한거야</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead
#. Speaker = Narrator
#. NodeID = f3daa7bb-84fc-47a4-8063-d17d8c61851d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_CorpseMembranes_Dead:f3daa7bb-84fc-47a4-8063-d17d8c61851d
msgctxt "hae3c25e2g84a9g48cbgb118gec475a4d5bca"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "h3813811eg89b8g4f8cg91a9g0fa1d3daf94c"
msgid "Look - something behind that window. Shame we can't reach it."
msgstr "저길 봐, 창문 뒤에 뭐가 있어. 못 간다니 아쉽네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "hb6f13253ga444g4d74gab85g28dc272413c4"
msgid "Something's behind the window. But how to reach it?"
msgstr "창문 너머에 뭔가가 있다. 하지만 어떻게 저곳에 도달하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "hb99b19e2g8c18g4fc6g9cc3gd852f6a2901c"
msgid ""
"A strange vista through that window... Unreachable from here, I'd surmise, "
"but there must be another way down."
msgstr "저 창문 너머에서 기묘한 풍경이 보여... 짐작건대, 이쪽에서는 도달할 수 없겠지만 분명 다른 길을 통해서 갈 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "h1f37daa4g0501g4fd4ga7b7g63196dc7e71b"
msgid ""
"Looks like there's something through there. Can't reach it from here, though."
msgstr "저 너머에 뭔가 있는 것 같아. 여기서는 넘어갈 수 없긴 하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "h181dcb8bg4f19g4d6dg8e13g3e9eb9cb93ec"
msgid "There's something back there. I just need to find a way to it."
msgstr "저 뒤에 뭔가 있어. 통하는 길만 찾으면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "h5a679b11ga5d5g4872gbcafgf81d61a535d4"
msgid ""
"Hey - there's something beyond here. No way of getting through from this "
"pit, though."
msgstr "이봐, 저 너머에 뭔가 있어. 다만 거기까지 비집고 들어갈 방법이 없어 보이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "hceb7a4bbgbd8eg4be4gbb48gd6ea4e435f4d"
msgid ""
"I can almost see something beyond there... unreachable from here, however."
msgstr "저 너머로 뭔가 보이는 것 같은데... 안타깝게도 갈 방법이 없는 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment
#. Speaker = Player
#. NodeID = 9dba736b-289b-4d16-bfec-c2baffd94ef3
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_ColonyComment:9dba736b-289b-4d16-bfec-c2baffd94ef3
msgctxt "h796752f9gf42cg4be6g8af4g16f930013206"
msgid ""
"Look - there's something on the other side. No way through from here though."
msgstr "저길 보게. 저기 반대편에 뭔가 있어. 다만 여기서는 갈 방법이 없는 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = e311a606-d7e6-494f-8961-d124b03c1a00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Oubliette_State_HasEntered(0) = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:e311a606-d7e6-494f-8961-d124b03c1a00
msgctxt "h11cb151fg821dg4856ga005ge2204f7abc98"
msgid "I bet it's cold too. Such a pity."
msgstr "차갑게 식은 것 같은데. 아까워라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = e311a606-d7e6-494f-8961-d124b03c1a00
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Oubliette_State_HasEntered(0) = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:e311a606-d7e6-494f-8961-d124b03c1a00
msgctxt "h743fa149g9855g43e3g9eddg93e1435ae413"
msgid "Yet another unwelcome opportunity to contemplate this ghastly abattoir."
msgstr "결코 바라지 않았건만, 또다시 이 기분 나쁜 도살장을 목도하게 됐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = e311a606-d7e6-494f-8961-d124b03c1a00
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Oubliette_State_HasEntered(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:e311a606-d7e6-494f-8961-d124b03c1a00
msgctxt "h8d8c820ag2c9cg4347g8927g4d98785e94e8"
msgid "Not this place again."
msgstr "또 여기라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = e311a606-d7e6-494f-8961-d124b03c1a00
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Oubliette_State_HasEntered(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:e311a606-d7e6-494f-8961-d124b03c1a00
msgctxt "h1b3ce770g6896g4820g9565g599ef5be0417"
msgid "Here again? I thought one visit was <i>quite</i> enough."
msgstr "또 여긴가? 한 번이면 <i>족하다</i> 싶은 곳이었는데 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = e311a606-d7e6-494f-8961-d124b03c1a00
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Oubliette_State_HasEntered(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:e311a606-d7e6-494f-8961-d124b03c1a00
msgctxt "hba97f7b2g849cg4b68g814eg34be0bdbd01a"
msgid "This place again. I'd rather not put my stomach to the test."
msgstr "또 여기로군. 내 위장이 시험대에 오르는 꼴을 보긴 싫은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = e311a606-d7e6-494f-8961-d124b03c1a00
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Oubliette_State_HasEntered(0) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:e311a606-d7e6-494f-8961-d124b03c1a00
msgctxt "h9e34623agdd79g452fgae0cgf7049c8d8497"
msgid "Hells - I'd thought I'd left this place behind."
msgstr "젠장, 다시는 이곳에 올 일이 없을 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = e311a606-d7e6-494f-8961-d124b03c1a00
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Oubliette_State_HasEntered(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:e311a606-d7e6-494f-8961-d124b03c1a00
msgctxt "hf0bfc119g171dg4a4aga270g960bbdba12d7"
msgid "Every bit as disgusting as the first time."
msgstr "구석구석이 역겹군. 처음 왔을 때랑 똑같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = f4d86f60-dd62-1507-d54b-7de52fc30a86
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:f4d86f60-dd62-1507-d54b-7de52fc30a86
msgctxt "h11f0fa58g2906g4777g9fa9gb9c4dfba5905"
msgid "I'm all for blood, but a whole lake? That's just wasteful."
msgstr "나도 피를 좋아하는 편이긴 한데, 피로 된 강이라니? 그건 그냥 낭비라고. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = f4d86f60-dd62-1507-d54b-7de52fc30a86
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:f4d86f60-dd62-1507-d54b-7de52fc30a86
msgctxt "h9f9044dag05eag4ca6g857bgff9dc5c1456b"
msgid "Look at it... This must be the place where sanity comes to drown."
msgstr "저것 좀 봐... 여기야말로 이성이 급류에 휩쓸리듯 사라지는 곳이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = f4d86f60-dd62-1507-d54b-7de52fc30a86
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:f4d86f60-dd62-1507-d54b-7de52fc30a86
msgctxt "hc8181af4gac38g47cagab98gabb71912596e"
msgid "What a nightmare."
msgstr "악몽이 따로 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = f4d86f60-dd62-1507-d54b-7de52fc30a86
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:f4d86f60-dd62-1507-d54b-7de52fc30a86
msgctxt "h4320e650g4246g4911g954cga3bf4ffebb50"
msgid "Smells of blood - old and new. This place has seen death."
msgstr "피 냄새가 난다. 오래된 것도 있고 신선한 것도 있군. 이곳은 죽음으로 가득해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = f4d86f60-dd62-1507-d54b-7de52fc30a86
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:f4d86f60-dd62-1507-d54b-7de52fc30a86
msgctxt "hc0eb52fdg38f6g4bbag94bcg5ffab18952b4"
msgid "So much blood. I'm almost dizzy with the smell of it."
msgstr "이리 피가 많다니. 냄새에 어지러울 지경인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = f4d86f60-dd62-1507-d54b-7de52fc30a86
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:f4d86f60-dd62-1507-d54b-7de52fc30a86
msgctxt "h02b11253gb701g4d61gb47agc62ab1bc564f"
msgid "What living nightmare is <i>this</i>?"
msgstr "이 생생한 악몽은 <i>대체</i> 뭐란 말인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry
#. Speaker = Player
#. NodeID = f4d86f60-dd62-1507-d54b-7de52fc30a86
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Entry:f4d86f60-dd62-1507-d54b-7de52fc30a86
msgctxt "h065c5aa0gb34fg435bg9fa0g6cbeb656adc9"
msgid "What the hells is this place?"
msgstr "대체 여긴 뭐하는 곳이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape
#. Speaker = Player
#. NodeID = ebfc9601-438b-4b17-a414-66f309d78c65
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape:ebfc9601-438b-4b17-a414-66f309d78c65
msgctxt "hcf884366g49cag4fb4gbb84g406dbe4e359a"
msgid "I swear, there's congealed blood between my toes."
msgstr "아무래도 발가락 사이에 엉겨 붙은 피가 묻은 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape
#. Speaker = Player
#. NodeID = ebfc9601-438b-4b17-a414-66f309d78c65
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape:ebfc9601-438b-4b17-a414-66f309d78c65
msgctxt "heb5e14bfg382fg4dd3g9ca7g380605e9d505"
msgid "What was that place...?"
msgstr "대체 그 장소는 뭐였지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape
#. Speaker = Player
#. NodeID = ebfc9601-438b-4b17-a414-66f309d78c65
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape:ebfc9601-438b-4b17-a414-66f309d78c65
msgctxt "h3ff81e0eg4997g4a41gacfegd990ff998e36"
msgid "Let's leave that horror show behind."
msgstr "저 끔찍한 광경은 이제 잊어버리자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape
#. Speaker = Player
#. NodeID = ebfc9601-438b-4b17-a414-66f309d78c65
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape:ebfc9601-438b-4b17-a414-66f309d78c65
msgctxt "h67796460g9903g4709g8a7bge5b368ea286e"
msgid ""
"<i>Chk.</i> The stench of death I can endure. The excrement? Not so much."
msgstr "<i>츠크.</i> 죽음의 악취는 견딜 수 있다. 하지만 배설물이라니? 도저히 못참겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape
#. Speaker = Player
#. NodeID = ebfc9601-438b-4b17-a414-66f309d78c65
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape:ebfc9601-438b-4b17-a414-66f309d78c65
msgctxt "h97670886gc607g48d7g8b0egef428b906921"
msgid "Ugh, I need a bath. Or several."
msgstr "윽, 목욕을 좀 하고 싶은데. 한 번으론 부족하려나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape
#. Speaker = Player
#. NodeID = ebfc9601-438b-4b17-a414-66f309d78c65
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape:ebfc9601-438b-4b17-a414-66f309d78c65
msgctxt "h31f54386g0d94g415fgadc7gb49875e971c0"
msgid ""
"Damn - that place has me stinking worse than the wrong end of a cave troll."
msgstr "젠장. 저기서 좀 굴렀다고 나한테서 동굴 트롤 항문보다도 고약한 냄새가 나잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape
#. Speaker = Player
#. NodeID = ebfc9601-438b-4b17-a414-66f309d78c65
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_Escape:ebfc9601-438b-4b17-a414-66f309d78c65
msgctxt "h95d97d9cgd441g437agaadcgb84b81b86665"
msgid "The stink of that place might never wash out."
msgstr "이곳의 냄새는 절대 빠지지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "h40bed435gcc9ag4886ga2c7ge10c8b7ed389"
msgid "I remember that noise from the Underdark - another bloody hook horror."
msgstr "언더다크에서 들어본 적 있는 소리야. 또 망할 후크 호러구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "hda2063ffg9389g4c77ga686g3ad138738c59"
msgid ""
"So there's a hook horror down here. This is truly the pit that keeps on "
"giving."
msgstr "이 아래에는 후크 호러도 있구나. 정말 없는 게 없는 구덩이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "h98347bc8gc9efg48a3g9e13gd225ba9831f3"
msgid "Oh no. The big hook lads."
msgstr "이런. 갈고리 달린 놈들이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "hebcedc94gddc3g4ad3ga884gaaf4c0471507"
msgid "A hook horror? Let it know death."
msgstr "후크 호러인가? 죽음을 맞이하게 해줘야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "hd7708b9cg7e35g4e33ga302g1f65cf3b7dee"
msgid "A hook horror, by the sounds of it."
msgstr "소리가 후크 호러인 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "ha799413ega243g40a5g9e61ga7b5c268968d"
msgid "Either that was a hook horror, or I ate too much pea soup last night."
msgstr "후크 호러네. 내가 어제 콩 수프를 너무 많이 먹은 걸 수도 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "h6f856c54gaaf9g46f0gb871g2b2a88665598"
msgid "Hook horror. A worthy kill."
msgstr "후크 호러군. 가치 있는 사냥감이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = 3fceab6b-0937-4ee2-8c2e-fd470d65da8c
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_HookHorrors_Knows_SeenHookHorrors(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:3fceab6b-0937-4ee2-8c2e-fd470d65da8c
msgctxt "hb1ce8e19ga0f7g401cga7bcg8dde003973a3"
msgid "Hook horror. Wonderful."
msgstr "후크 호러야. 끝내주네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = c8a5ebad-e0c1-bd93-3142-fa148de925a1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:c8a5ebad-e0c1-bd93-3142-fa148de925a1
msgctxt "h52e5bf56gb9c1g4c09g9305g1ca186f867d8"
msgid "I don't know what that was, but it sounds decidedly unpleasant."
msgstr "무슨 소리였는진 몰라도, 정말이지 불쾌한 소리야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = c8a5ebad-e0c1-bd93-3142-fa148de925a1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:c8a5ebad-e0c1-bd93-3142-fa148de925a1
msgctxt "hbc078ae2gd786g49b1gabc6g1e80f3f3f200"
msgid "My, the local fauna sounds appropriately terrifying."
msgstr "이런, 이 지역의 동물군은 소리마저 공포스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = c8a5ebad-e0c1-bd93-3142-fa148de925a1
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:c8a5ebad-e0c1-bd93-3142-fa148de925a1
msgctxt "hd4236800g6a03g4906g9595g258ea6bff1ef"
msgid "Stay far, far away from whatever that was."
msgstr "저게 뭐였는지는 몰라도, 멀리 떨어지는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = c8a5ebad-e0c1-bd93-3142-fa148de925a1
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:c8a5ebad-e0c1-bd93-3142-fa148de925a1
msgctxt "hb52a8071ga125g4ea7ga05eg2b328ca72549"
msgid "Something stirs. Let it taste death."
msgstr "뭔가가 움직이는군. 죽음의 맛을 보여 줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = c8a5ebad-e0c1-bd93-3142-fa148de925a1
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:c8a5ebad-e0c1-bd93-3142-fa148de925a1
msgctxt "h019c8e09g564dg461cg800fg0e48a79c9566"
msgid "Sounds like something's angry - or maybe hungry. Best steer clear."
msgstr "뭔가가 화가 난 모양이야. 배가 고픈 걸 수도 있고. 떨어지는 편이 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = c8a5ebad-e0c1-bd93-3142-fa148de925a1
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:c8a5ebad-e0c1-bd93-3142-fa148de925a1
msgctxt "h06599773gd448g40c3gbc81g470c04b82c59"
msgid "Hells. I'm going to pretend I didn't hear that."
msgstr "이런. 난 못 들은 척 해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech
#. Speaker = Player
#. NodeID = c8a5ebad-e0c1-bd93-3142-fa148de925a1
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Oubliette_PAD_HorrorScreech:c8a5ebad-e0c1-bd93-3142-fa148de925a1
msgctxt "h8aadf305g67b0g41e7g92e8gdc6b8d09a39a"
msgid "Something's alive down here. I'm not sure I want to meet it."
msgstr "뭔가 살아있는 것이 있군. 직접 보고 싶은지는 잘 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Outcast_AD_KethericCombat
#. Speaker = Ketheric Thorm
#. NodeID = 67f82628-cc7b-4dac-a595-190480c1ba8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Outcast_AD_KethericCombat:67f82628-cc7b-4dac-a595-190480c1ba8e
msgctxt "h5726fdebga0b6g4256gb9c2g604e75f87283"
msgid "Take your penance - in Her name."
msgstr "속죄해라. 그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Outcast_AD_ZrellCombat
#. Speaker = Disciple Z'rell
#. NodeID = e297c679-d2c4-47fb-9629-a870e236a781
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Outcast_AD_ZrellCombat:e297c679-d2c4-47fb-9629-a870e236a781
msgctxt "h1105da63gfbd6g4d08ga679g7d4e30e0a112"
msgid "What a disappointment you are."
msgstr "참으로 실망스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Prison_AD_CellPlaque1
#. Speaker = Narrator
#. NodeID = 56821917-f906-42fe-b609-1bfa467309e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Prison_AD_CellPlaque1:56821917-f906-42fe-b609-1bfa467309e3
msgctxt "h1412c509g2df3g4428g8a32g281c0c0ad13f"
msgid "Cell One"
msgstr "수감실 1"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Prison_AD_CellPlaque2
