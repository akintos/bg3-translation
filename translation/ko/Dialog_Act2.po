msgctxt "hd1e2af2agbbe4g4176g901ag21a4abebb72b"
msgid "Capture... Selûne's... cleric..."
msgstr "셀루네... 클레릭... 생포..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = e4725426-b843-4fc6-86b3-f7aa85ea1a10
#. HandlePath = TaggedText[0].TagText[0]
