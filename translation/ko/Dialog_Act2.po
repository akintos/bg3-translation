#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:e4b222a1-689f-435b-bd74-507fba9c43a3
msgctxt "h04abc1fdg4bb0g4405g85b5gc485d41120e9"
msgid ""
"Well that's disturbing. Still better than having an actual conversation with "
"him, though."
msgstr "조금 불편하긴 하지만 이 녀석과 제대로 된 대화를 나누는 것보다 차라리 이게 나은 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = ea1b37e3-9e8d-5fb5-211b-62e48f15b875
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:ea1b37e3-9e8d-5fb5-211b-62e48f15b875
msgctxt "h5a448125g4ecag4a9cg8456g5f5c6f01efed"
msgid "Hello? Are you all right?"
msgstr "저기, 너 괜찮은 거 맞아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02
#. Speaker = Blighted Patron
#. NodeID = 11b4b548-1c6e-4075-9e39-0725710b5560
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Distillery_HasMet_Zombie_02(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_Distillery_HasMet_Zombie_02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02:11b4b548-1c6e-4075-9e39-0725710b5560
msgctxt "hf70d7fc8g8df5g4a95g869bgff766683b0e0"
msgid "I don't know you... perhaps I forgot you."
msgstr "당신 처음 보는데요... 내가 기억을 못하는 건가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02
#. Speaker = Blighted Patron
#. NodeID = 5e8f98d3-ff62-92ff-4baf-97ec568454c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Distillery_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02:5e8f98d3-ff62-92ff-4baf-97ec568454c8
msgctxt "hb2fe6d75g0008g43b7gb3abgd0d26289d4c7"
msgid "The distiller was here... now he's gone. Such is the way."
msgstr "양조자 양반이 있었는데... 가버렸네. 인생이 그렇지 뭐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02
#. Speaker = Blighted Patron
#. NodeID = caad4a43-582e-4acb-a935-125001199213
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Distillery_HasMet_Zombie_02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02:caad4a43-582e-4acb-a935-125001199213
msgctxt "ha19d6dabg80d2g4618g84e0g000e169c708d"
msgid "Maybe another sip would jog my memory..."
msgstr "한 잔 더 마시면 기억이 날 지도 몰라..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02
#. Speaker = Blighted Patron
#. NodeID = cb732b55-a2bc-e023-f8d4-6c8cbdab101d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Distillery_HasMet_Zombie_02(1) = False
#.   Global:
#.      - TWN_Distillery_State_PeacefulResolution = True
#. SetFlags:
#.   Dialog:
#.     - TWN_Distillery_HasMet_Zombie_02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_02:cb732b55-a2bc-e023-f8d4-6c8cbdab101d
msgctxt "h2d2639dcga2fcg44bbg8c03g52385711f4a2"
msgid "He served us... but will be forgotten soon."
msgstr "일을 잘 했는데... 이제 곧 잊혀지겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_03
#. Speaker = Blighted Troubador
#. NodeID = 0a1e968b-d1ff-486d-a1bc-f34adcc265ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Distillery_HasMet_Zombie_03(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_03:0a1e968b-d1ff-486d-a1bc-f34adcc265ae
msgctxt "hec5530e4gbc60g4360g865cg88951422347e"
msgid ""
"No time to waste, we should be drinkin' \n"
"Hey! for the pub \n"
"Ho! for the pub \n"
"We'll soon be stinkin' drunk!"
msgstr ""
"낭비할 시간 없네, 한 잔하러 가세나\n"
"헤이! 펍에서 한 잔\n"
"호우! 펍에서 한 잔\n"
"만취한 우리 무리, 곧 쓰러진 다네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_03
#. Speaker = Blighted Troubador
#. NodeID = 6dfab765-441c-8199-dcdd-a75456453c3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Distillery_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_03:6dfab765-441c-8199-dcdd-a75456453c3a
msgctxt "h589296a1g47abg4867ga208g4f37061f9cc4"
msgid ""
"The brew-man's popped, the floors are spattered \n"
"Say, hey, for the pub! \n"
"Drain your mug like nothing matters \n"
"Say, hey, for the pub!"
msgstr ""
"술집 양반 폭발하고, 바닥이 흥건해졌다네\n"
"자, 자, 한 잔 하자고!\n"
"별 일 없다는 듯 잔을 비워\n"
"자, 자, 한 잔 하자고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_03
#. Speaker = Blighted Troubador
#. NodeID = e2007ed4-80ee-62e4-cac1-4a36bcae9915
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - TWN_Distillery_HasMet_Zombie_03(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_03:e2007ed4-80ee-62e4-cac1-4a36bcae9915
msgctxt "h637e795egae2eg45e7g9146g384c159d5d10"
msgid ""
"The payday gold in my pouch is clinkin' \n"
"Say, hey, for the pub! \n"
"A single thought is what I'm thinkin' \n"
"Say, hey, for the pub!"
msgstr ""
"월급 받아 돈주머니가 짤랑거린다네\n"
"자, 자, 한 잔 하자고!\n"
"지금 생각나는 건 단 하나라네\n"
"자, 자, 한 잔 하자고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Blighted Actor
#. NodeID = 5769f12c-b228-73af-70bb-3eb323973964
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04:5769f12c-b228-73af-70bb-3eb323973964
msgctxt "h173fc26dg8aa4g43b2gb439gab19786657f2"
msgid ""
"How dare you! I'm an... actor! Yes! That's the word. A proper job, not some "
"jester."
msgstr "그런 심한 말을! 나는... 배우라고! 그래! 그 단어였지. 제대로 된 직업이지, 광대 따위가 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Blighted Actor
#. NodeID = 5d24bd5d-0d8a-42a3-8086-581b0845d115
#. HandlePath = TaggedText[0].TagText[0]
