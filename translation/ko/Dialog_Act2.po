#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "h4ac22d65g6887g4cb5gaf21g7cdcab32b92c"
msgid "Well, she's back with Ketheric."
msgstr "이제 케서릭과 함께하게 됐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "h60ee2d93gc92bg4f14g8536gcee8b0651de0"
msgid "Better sent to Moonrise than left to rot down here. I hope."
msgstr "여기서 썩는 것보다야 문라이즈로 보내지는 게 더 낫겠지, 아무래도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "h4a43c78bg1744g4521gb624g5a81c5f7bf44"
msgid ""
"Ketheric has taken the aasimar for his own once more. Perhaps our help will "
"buy us some advantage."
msgstr "케서릭이 다시금 아시마르를 차지하게 됐군. 우리의 도움이 우리에게 이점을 가져다줄지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "h161fdb76g8096g473dg87c2g78edd8852fc0"
msgid "Doomed to suffer. A tragedy many times over."
msgstr "고통받을 수밖에 없는 운명이라니. 그야말로 비극이로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "hd8904cd3gf0f2g46b7g80e2gb4abdd78fbdf"
msgid "Hope that wasn't a huge mistake."
msgstr "큰 실수를 한 게 아니였으면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "h114ecf07gf56ag4312gba75g00fcb830ddaf"
msgid "I doomed her - and empowered Ketheric Thorm."
msgstr "그녀를 내버리고 케서릭 쏨을 키워주고 말았구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "hac7ad6e1gf569g45aag9763ga3f75e3bfe05"
msgid ""
"That was a mistake. I did not join you to continue my service to Ketheric."
msgstr "지금 실수한 거야. 케서릭을 다시 섬기기 위해 너와 함께하기로 한 건 아니였는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:a576119f-2f5b-4661-a472-6c5cca26ff52
msgctxt "h4572e466g0e14g4ad2g8750gc1b9b8572a2d"
msgid "It's done."
msgstr "끝났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "ha2f31f43ge7ebg488dgbbe6g7cd22c9f518e"
msgid ""
"What a hellish place to be locked up. It almost makes Cazador feel "
"accommodating."
msgstr "이런 지옥같은 곳에 갇힌다고 생각하니 아찔한데. 카사도어가 친절했다고 여겨질 정도야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "hd77271b0g914cg49b7g9d4cg2f911fc16493"
msgid "Nothing more to be done here."
msgstr "여기서 더 볼 일은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "hecdf8e7cgaf72g411fg9896ga2ce864e7031"
msgid "A dire prison for any being..."
msgstr "정말이지 혹독한 감옥이로군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "hc597fafagb9abg49adg834fgbd3dc5bd48b3"
msgid "No point in lingering here."
msgstr "여기 더 머무를 이유는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "h96adee8bg0e14g4decgb699gadb4d94b95e2"
msgid ""
"A terrible contraption by all estimations. All that pain, for the sake of "
"Ketheric's enduring power."
msgstr "모로 보나 끔찍하고도 기묘한 구속 장치야. 이 모든 고통이 오로지 케서릭의 영생을 위해서라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "hb802baa1g7655g4237gacabg4dd7b11b46ad"
msgid "What an awful place to be trapped."
msgstr "갇혀 있기엔 정말 끔찍한 장소로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "h4197459fg4062g4971ga403g51b368413d69"
msgid "What a wretched place. I should leave."
msgstr "몹시 불쾌한 곳이네. 어서 떠나야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "h411e62d0g89d3g4a43ga55ag022748c87e0b"
msgid ""
"If we remain in the Shadowfell too long, we will lose ourselves and become "
"hollow."
msgstr "섀도펠에 너무 오래 머무른다면, 우린 스스로를 잃고 텅 빈 껍데기만 남게 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = bd4e002a-5622-43f2-9210-2ba878678727
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:bd4e002a-5622-43f2-9210-2ba878678727
msgctxt "h932cbcfagd124g420egbdf1g92878f68bad0"
msgid "Such a terrible place. I should leave."
msgstr "끔찍한 곳이로군. 어서 떠나야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "h8c199d23g7028g4cd4g849dgd8b45a598870"
msgid ""
"Almost makes you grateful to have a vampire's immortality. I only had to "
"come back once."
msgstr "뱀파이어가 된 게 더 낫다는 생각이 들 정도잖아. 같은 불사라도 난 한 번만 되살아나면 됐거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "hed9165a6g1738g4c82ga9ecgefd5b385c22a"
msgid "When she resurrects, she'll have no interest in helping me."
msgstr "부활하고 나서는 날 도와줄 생각은 전혀 없겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "ha1bdca11g67fag4b0fg9c22g0c8b0f4701e2"
msgid "She must have been killed a thousand times by now."
msgstr "지금까지 못 해도 천 번은 죽임을 당했겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "hcbdfdbfdg1332g432fga69cg36e1291b9916"
msgid "By the gone gods, I've made a mistake."
msgstr "이런 세상에, 내가 실수를 저질렀군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "hc647cb7dg2012g4533g972bga175fde64862"
msgid "That was a mistake. Damn."
msgstr "방금 건 실수였어. 젠장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "hc62361a3g7c6cg4ae4g8363g61b4de197658"
msgid "She must have been murdered then brought back, a thousand times - more."
msgstr "지금껏 천 번도 넘게 살해당하고 되살려지길 반복했겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "ha8708a79g52c3g4795g9526g25cd538403e1"
msgid ""
"Apologies have never been my strong suit. You do the talking when she "
"awakens."
msgstr "사과는 내 장기와는 거리가 멀다. 그녀가 깨어나면 대화는 네가 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:c4ed6cc9-32e0-4971-963e-9c3c36ab9a09
msgctxt "h85b29e08gbc19g4738gb110g6932bd01479c"
msgid "I wonder how many times she's been killed down here."
msgstr "그녀가 여기서 몇 번이나 죽었을지 궁금한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = cbc25c71-31a4-488b-80ae-7c14168bb1ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_ShadowheartKilledNightsong = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:cbc25c71-31a4-488b-80ae-7c14168bb1ae
msgctxt "hea640d2fg3a98g49acga1cdg214c0e132737"
msgid "It is done. Lady Shar has blessed me."
msgstr "끝났어. 샤 여신께서 내게 축복을 내리셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = d2913a9a-e650-43f9-a971-bd5b1d248742
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:d2913a9a-e650-43f9-a971-bd5b1d248742
msgctxt "h57c725d4g73b6g4b18ga42cg713a0d3823a3"
msgid ""
"But there is more of her work to be done. More of her foes to be cast down."
msgstr "하지만 그분의 과업은 이제 시작이다. 멸해야 할 여신님의 적들이 아직도 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = e97c8656-ab2f-4b30-96c2-c4219e18160c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:e97c8656-ab2f-4b30-96c2-c4219e18160c
msgctxt "h2766ad28g7e12g4edagb7d2g4c9c541c6eb2"
msgid "Lady Shar... what will she do to me...?"
msgstr "샤 여신이시여... 그분이 내게 어떤 처분을 내리실까...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "h273958b3g2b43g4986ga75cgdc2cf99ffd39"
msgid "Now, that will be a nice surprise for Ketheric."
msgstr "케서릭이 아주 깜짝 놀라겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "hf05b11ceg0db3g4ebega6f0gfda1456f1088"
msgid ""
"Finally, the heavens are on my side. Or at least, one very irritated Aasimar."
msgstr "드디어, 천상이 내 편에 섰군. 화가 잔뜩 난 아시마르 하나 뿐이긴 하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "hf843280ag64bdg4ea6gb504g9784d482560b"
msgid "Dame Aylin is a powerful ally. We did well to free her."
msgstr "여기사 에일린은 큰 힘이 될 거다. 그녀를 풀어준 건 잘 한 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "h6d0a5d38g7c67g45e1g85d4g2562006a64a1"
msgid "Damn - she's quite something."
msgstr "맙소사, 정말 대단하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "hc64a25aegb1b9g42b9ga76fg7dd8541f99a3"
msgid "Gods... she's incredible."
msgstr "세상에... 엄청나잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "h7e1eb21fgbcb2g4c96gb60dg26164b833a82"
msgid "An aasimar at my side. Few can claim such an ally."
msgstr "아시마르와 한 편이라니. 이런 아군을 얻을 수 있는 자는 몇 안될 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "h8c713bb6g0e3bg4b97ga1fdg2282d882f0f8"
msgid "A righteous and furious ally. Impressive."
msgstr "정의롭고 분노에 가득찬 아군이라. 인상적이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = f5732ee6-dbb1-4696-82c6-8207ef82a313
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:f5732ee6-dbb1-4696-82c6-8207ef82a313
msgctxt "h2bad3fe7gd2fbg4825g84fbg0847335187a0"
msgid "I've made a powerful ally today."
msgstr "강한 아군을 얻었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer
#. Speaker = Shadowheart
#. NodeID = 0e9d8604-f690-4bfa-93e0-1b358581643f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 199a746e-309f-52f0-1a47-0375711725cb_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer:0e9d8604-f690-4bfa-93e0-1b358581643f
msgctxt "hbe9ee189g66efg49aagb171gf8bfad05b0d3"
msgid ""
"Just a little bit farther. See my actions, Lady Shar. Hear my words of faith."
msgstr "조금만 더 가면 돼. 보소서, 샤 여신이시여. 제 믿음의 기도를 들으소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer
#. Speaker = Shadowheart
#. NodeID = 0fafa54a-6c4c-4b5e-bfd2-936333fac4f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 199a746e-309f-52f0-1a47-0375711725cb_A = True
#. SetFlags:
#.   Local:
#.     - 199a746e-309f-52f0-1a47-0375711725cb_B = True
