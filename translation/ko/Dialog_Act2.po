#. Speaker = Gerringothe Thorm
#. NodeID = 34043ba4-77fb-4bc6-2d56-82d11e38a7b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:34043ba4-77fb-4bc6-2d56-82d11e38a7b7
msgctxt "hfae7e4c0g890fg4b08g9028gf53ebff435c0"
msgid ""
"THE GOLD IS NOT FOR ME. THE GOLD IS FOR THE TOLL. I COLLECT THE TOLL. I "
"COLLECT THE GOLD."
msgstr "나를 위해 금을 받지 않는다. 금은 통행료다. 나는 통행료를 받는다. 나는 금을 받는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
