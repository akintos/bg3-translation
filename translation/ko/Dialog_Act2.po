msgctxt "hc07bc024gc000g42e1g890dg1c7a2368ca47"
msgid "...But you don't appeal to <i>my</i> tastes."
msgstr "...너는 <i>내</i> 취향에 맞지 않는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = f148dbba-52bc-003d-cd3c-6b184dc24361
