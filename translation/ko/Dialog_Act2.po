#.     - b8101d0a-5473-efd1-1d12-719d504d60b8_A = False
#.     - b8101d0a-5473-efd1-1d12-719d504d60b8_C = False
#.     - b8101d0a-5473-efd1-1d12-719d504d60b8_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_NightsongAttacked:a8edce58-85ae-4406-bd0e-117bbb8d394b
msgctxt "h7c0a856bgdd4fg4fedg8259g4e540fc209f8"
msgid "I've known worse pain than this. Far worse."
msgstr "나는 이보다 더한 고통도 겪어 보았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Shar
#. NodeID = 19bc82dd-741f-2c5b-b4f9-11a588aa6926
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial:19bc82dd-741f-2c5b-b4f9-11a588aa6926
msgctxt "h22f2609fg92b5g4793g8aadg2a553685439d"
msgid "Reach the other side to receive my gift."
msgstr "나의 은총을 받고자 하거든 반대쪽 끝에 닿도록 하여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
