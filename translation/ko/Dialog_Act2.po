#. CheckFlags:
#.   Global:
#.      - SHA_Mausoleum_State_PassedMyrkulReligionCheck = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol:64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
msgctxt "hfe9d12e7gbc73g4ba3g8c7fg4fb1d04c3a6a"
msgid "That's the symbol of Myrkul."
msgstr "저건 머큘의 상징이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol
#. Speaker = Player
#. NodeID = 969a6201-7ede-0f98-d6c3-9ae10bd6ec36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MYRKUL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol:969a6201-7ede-0f98-d6c3-9ae10bd6ec36
msgctxt "hb71c2df5g0002g4098g97feg5ba912a57773"
msgid "Myrkul's holy symbol. He must have had a follower come to this place."
msgstr "머큘의 상징이군. 자신의 추종자로 하여금 이곳까지 오게 한 모양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom
#. Speaker = Player
#. NodeID = c4ce2b05-3280-4504-a51b-92afa4a539db
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom:c4ce2b05-3280-4504-a51b-92afa4a539db
msgctxt "h142d9445gba81g4917g97b9ge8f26e93a2ad"
msgid "Bodies, bodies, everywhere. Yet not a drop to drink."
msgstr "시체가 아주 사방에 있지만, 내가 마실 거라곤 하나도 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom
#. Speaker = Player
#. NodeID = c4ce2b05-3280-4504-a51b-92afa4a539db
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom:c4ce2b05-3280-4504-a51b-92afa4a539db
msgctxt "h5d27dc8bg3724g4ecega760g8c4aae6f1059"
msgid ""
"All these bone arrangements reek of dark magic afoot - necromancy, I'll "
"wager."
msgstr "뼈들의 배열을 보아하니 사악한 마법을 준비했나보군. 예측컨대 사령술이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom
#. Speaker = Player
#. NodeID = c4ce2b05-3280-4504-a51b-92afa4a539db
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom:c4ce2b05-3280-4504-a51b-92afa4a539db
msgctxt "h0ce3eadag8f9fg495egafe7g764c3420029d"
msgid "Shouldn't all these bones be tucked away neatly in their tombs?"
msgstr "이 유골들, 각자 무덤에 가지런히 안치되어 있어야 하는 거 아냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom
#. Speaker = Player
#. NodeID = c4ce2b05-3280-4504-a51b-92afa4a539db
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom:c4ce2b05-3280-4504-a51b-92afa4a539db
msgctxt "he57f005dg7341g425dg8427g479bbd35ba12"
msgid "Bones on display, but not as trophies. Some form of dark ritual."
msgstr "유골들이 펼쳐져 있군. 전시 목적은 아니야. 어둠의 의식을 위한 것으로 보인다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom
#. Speaker = Player
#. NodeID = c4ce2b05-3280-4504-a51b-92afa4a539db
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom:c4ce2b05-3280-4504-a51b-92afa4a539db
msgctxt "h0c9bb4e4gaea0g428ag87dcg91821872b720"
msgid ""
"All these bones. Seems there's been a graverobber at work here, and an "
"artful one at that."
msgstr "이 유골들 좀 봐. 도굴꾼이 아주 바쁘게 일을 한 모양이야. 미적 감각도 있는 도둑이라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom
#. Speaker = Player
#. NodeID = c4ce2b05-3280-4504-a51b-92afa4a539db
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom:c4ce2b05-3280-4504-a51b-92afa4a539db
msgctxt "h5cf66cfcg6534g44b8ga38cgaf96d9e2137c"
msgid "By the gods, all these bones. No dignity for the dead here."
msgstr "신들이여 맙소사, 뼈 더미들이 가득해. 죽은 자에 대한 존엄성이라곤 전혀 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom
#. Speaker = Player
#. NodeID = c4ce2b05-3280-4504-a51b-92afa4a539db
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_NecromancersRoom:c4ce2b05-3280-4504-a51b-92afa4a539db
msgctxt "heff0fe23gb75ag43ecgb124ge815d18f909e"
msgid "Bones everywhere... Someone's been engaging in dark rituals here."
msgstr "사방에 뼈가 가득해... 누군가 여기서 음산한 의식을 치르고 있었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb
#. Speaker = Player
#. NodeID = 7354a725-309d-49ab-a3be-936b78eadf41
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb:7354a725-309d-49ab-a3be-936b78eadf41
msgctxt "h5f88ccffg808eg4b75g96aag42a5e721780b"
msgid "An open, empty tomb - seems someone went for a stroll."
msgstr "파헤쳐진, 빈 무덤이라. 누가 산책 나갔나 본데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb
#. Speaker = Player
#. NodeID = 7354a725-309d-49ab-a3be-936b78eadf41
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb:7354a725-309d-49ab-a3be-936b78eadf41
msgctxt "hbbc59556gd0dfg4022ga622g1ca7e131b717"
msgid "This tomb lies open and empty. Did anyone say 'undead'?"
msgstr "이 무덤은 파헤쳐졌고 비었어. 누가 '언데드' 이야기 했어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb
#. Speaker = Player
#. NodeID = 7354a725-309d-49ab-a3be-936b78eadf41
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb:7354a725-309d-49ab-a3be-936b78eadf41
msgctxt "h42f71eddg8c84g44b5g92c2gd46aeef1dc26"
msgid "An open tomb. What could be horrifying about that?"
msgstr "파헤쳐진 무덤이라. 이게 뭐가 무섭겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb
#. Speaker = Player
#. NodeID = 7354a725-309d-49ab-a3be-936b78eadf41
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb:7354a725-309d-49ab-a3be-936b78eadf41
msgctxt "h36a864abg1348g4a1egb319gcc08ef3c7136"
msgid "An open tomb. Perhaps the occupant was restless."
msgstr "파헤쳐진 무덤이라. 묻힌 사람이 아주 활기찼나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb
#. Speaker = Player
#. NodeID = 7354a725-309d-49ab-a3be-936b78eadf41
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb:7354a725-309d-49ab-a3be-936b78eadf41
msgctxt "h22aee4d9g96b8g4557ga4b1g2b3889b80dda"
msgid "An open tomb. Something tells me this wasn't plundered by graverobbers."
msgstr "파헤쳐진 무덤이라. 도굴꾼이 약탈한 무덤은 아닌 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb
#. Speaker = Player
#. NodeID = 7354a725-309d-49ab-a3be-936b78eadf41
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb:7354a725-309d-49ab-a3be-936b78eadf41
msgctxt "h784db6b5g97dcg4b5cgbb6fg91eae8597405"
msgid ""
"Empty tomb. Either cleaned out by thieves, or - well, I'd rather not think "
"about it."
msgstr "빈 무덤이로군. 도적들이 싹 쓸어갔거나, 아니면... 음, 생각 않을래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb
#. Speaker = Player
#. NodeID = 7354a725-309d-49ab-a3be-936b78eadf41
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_OpenTomb:7354a725-309d-49ab-a3be-936b78eadf41
msgctxt "h728ac924gc639g4646gb679g29a934ce158b"
msgid "An open tomb - empty. Not ominous in the slightest."
msgstr "파헤쳐진 무덤이야. 비었군. 조금도 불길하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "h52b91aa2g2e5dg482dgb43cgfbfb945fb144"
msgid ""
"Ketheric's pet necromancer, Balthazaar. I wonder if he's as powerful as he "
"is ugly."
msgstr "케서릭의 애완 사령술사, 발타자르로군. 추하게 생긴 외모만큼 강력할지 궁금하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "h15c529d5g1babg4780gbb83ge8f1b409ed2a"
msgid "Balthazar. Ketheric's necromancer lies ahead of us."
msgstr "발타자르다. 케서릭의 사령술사가 이 앞에 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "h7f900adcg3a45g42dag8d7eg0e4f21d865d1"
msgid "Balthazar. Ketheric Thorm's necromancer of choice. He must be close."
msgstr "발타자르. 케서릭 쏨의 총애를 받는 사령술사지. 그가 가까이에 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "hc9be2174g180ag492eg9d44gd0a42ad4093a"
msgid "Balthazar - Ketheric Thorm's pet necromancer."
msgstr "발타자르, 케서릭 쏨의 애완 사령술사야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "hdcfef21cg259ag4adbgb470ga03c8b42720a"
msgid "Balthazar? Ketheric Thorm's necromantic master lies just ahead."
msgstr "발타자르? 케서릭 쏨의 사령술 대가가 이 앞에 있다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "hfecc4d9dgfefeg4df5gb3b3g2a9b18072598"
msgid ""
"Balthazar. That's Ketheric's right hand. But I've never been afraid of a "
"necromancer or two."
msgstr "발타자르. 케서릭의 오른팔이잖아. 하지만 나는 고작 사령술사 한둘 때문에 겁을 먹진 않는다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "hf24d794fg1f2fg476cga354g8ddf54f1f8a8"
msgid "Balthazar, a necromancer crony of Thorm's."
msgstr "발타자르. 쏨의 최측근 사령술사다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "h39424133g7f92g4f0ega3f1g99fb5ce0d7dd"
msgid ""
"Balthazar is expecting me, it seems. Good. I look forward to bursting his "
"maggot-infested gut."
msgstr "발타자르가 날 기다리고 있는 것 같은데. 좋아. 어서 그 구더기로 들끓는 내장을 끄집어내 주고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = 4e626a59-7d39-3dc2-5630-6a9ef4ead97d
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:4e626a59-7d39-3dc2-5630-6a9ef4ead97d
msgctxt "haffef433gc73cg4d22gac75ga9aa3699df2b"
msgid "Balthazar, a necromancer lap dog of Ketheric Thorm's."
msgstr "발타자르, 케서릭 쏨의 충견 노릇을 하는 사령술사다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "hc020bab9gd1aag4095g95b8g5d267980cf6d"
msgid "Wouldn't want to be caught unawares down here."
msgstr "이런 곳에서 무방비 상태로 기습당해선 안 돼. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h088ba851g0483g4e06g8d59ge83de650edbf"
msgid ""
"Let's assume the defensive position until we have determined the best "
"offence."
msgstr "방어 태세를 유지하는 게 좋겠어. 최선의 공격 방식을 결정하기 전까진 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h940db878g0c23g431bgb655gfcded47c01fb"
msgid "Let's keep sharp."
msgstr "정신 바짝 차려.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h79be039eg81e0g47a8g9208g6dddd9da2cd4"
msgid "Better stay alert."
msgstr "주변을 경계해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h22b144b0gd06fg41a4g81ecgc4be26edac15"
msgid ""
"Every strike needs to count. It's time to make the undead, <i>re</i>-dead."
msgstr "모든 공격에 진심을 담아야 해. 죽음에서 일어난 자를 <i>다시</i> 눕혀줄 시간이야.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h7035d6deg6220g40d1g8c91g2374b9146842"
msgid "I'll stay on my guard. We're on the back foot down here."
msgstr "경계 태세를 유지할게. 여긴 위치상 우리가 불리하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h528e1772g3562g4dc1ga4dagee70e595a6d6"
msgid "We must be cautious."
msgstr "조심해야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h8765a5b8g0133g4c62g866cg9075d7374944"
msgid ""
"We must be cautious. There are enough bones here for him to raise an army."
msgstr "조심해야 해. 여기 있는 유골들만 해도 군대를 일으킬 정도니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = cf126f2b-3a19-0754-03ea-b278009baf7e
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:cf126f2b-3a19-0754-03ea-b278009baf7e
msgctxt "h76ce3fd7g2315g4f98gadbcg04ac7e9e3bcd"
msgid "We need to stay alert."
msgstr "경계 태세를 유지해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "hcbe68260g20c2g42aeg8cc8gba95e4646a73"
msgid "Wouldn't want to be caught unawares down here."
msgstr "이런 곳에서 무방비 상태로 기습당해선 안 돼. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "hc78f5713g426dg4edag8f2dg3037a57abfe5"
msgid ""
"I have no desire to fall victim to a lack of caution in this lightless place."
msgstr "이렇게 어두운 곳에서 경계를 소홀히 했다간 낭패에 빠질 것이다. 난 그럴 생각은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "h10e36b53g12f0g47cbg8a8agca3bb4b12327"
msgid "Who knows what tricks he keeps up his rotten sleeve."
msgstr "그 문드러진 소매 아래로 또 뭘 감추고 있을지 누가 알겠냐고.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "h66722e85g80d6g458bg876dg3976af76bf6d"
msgid "Who knows what that corpse-botherer will have in store for us."
msgstr "그 시체나 만지작거리는 놈이 우릴 위해 뭘 준비했을지 궁금하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "h5855fd56g237dg4c0dgaad1g3567a8ee1449"
msgid "Be on your guard - but do not let up, once the first blow has landed."
msgstr "경계 태세를 유지해. 전투가 시작됐다고 해서 경계를 늦춰선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "h938c3408g3251g43e6gbcfcgded235938573"
msgid "Aye. Eyes up, weapons ready."
msgstr "자, 눈 크게 뜨고, 무기 들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "h9972176bg1937g438ag8cf2gd56cb9755af3"
msgid "Who knows what unnatural trickery awaits us."
msgstr "자연을 거스르는 술책이 우릴 기다리고 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "hee754953gbcd9g4442g8690ge5cb1b02223f"
msgid ""
"He's as corpulent as he is servile, but we cannot underestimate his command "
"of the dead."
msgstr "비대한 몸집만큼이나 비굴한 놈이지만, 놈이 이끄는 죽은 자들을 과소평가해서는 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro
#. Speaker = Player
#. NodeID = f2341f87-ac93-4d61-8fce-59d7cbb86174
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_SkullBalthazaarIntro:f2341f87-ac93-4d61-8fce-59d7cbb86174
msgctxt "h7583ec70g8c83g4a95g908eg65f9f035bc74"
msgid "Who knows what he may have up his rotten sleeve."
msgstr "그 썩어빠진 소매 아래로 또 뭘 감추고 있을지 누가 알겠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Narrator
#. NodeID = 03720945-056d-5d89-c052-17986cc4858d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Merregon_000_HasMet(1) = False
#.      - SHA_Merregon_Event_DetectThoughtsSuccess(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Merregon_000_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:03720945-056d-5d89-c052-17986cc4858d
msgctxt "h856e477fg5c9cg4540g8e11gaee5b9112e23"
msgid ""
"*This merregon seems faintly more alive than the others - beckoning you to "
"look at its wares.*"
msgstr "*이 메레곤은 다른 개체들보다 미세하게 생기가 있어 보입니다. 메레곤이 상품을 확인하라는 듯 손짓합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Hoarding Merregon
#. NodeID = 03e7d2e5-a974-fe6e-cf91-76b08eab2adb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:03e7d2e5-a974-fe6e-cf91-76b08eab2adb
msgctxt "he1bf6c38ga4aeg47d6ga47dge277a21441c8"
msgid "*Sigh.*"
msgstr "*한숨.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Player
#. NodeID = 14f57232-a657-469f-9c41-d49321e6c300
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Merregon_State_AskedForPotions = False
#.   Local:
#.      - 989f8f48-9328-2eca-3aa2-15007aabd48b_MindHasBeenRead = True
#. SetFlags:
#.   Global:
#.     - SHA_Merregon_State_AskedForPotions = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:14f57232-a657-469f-9c41-d49321e6c300
msgctxt "h0b216d35gb911g45e6g9b36ge3cb9c9de895"
msgid "I am to tend to your master's beast now. Give me the potions."
msgstr "이제 내가 네 주인의 야수를 돌보게 되었다. 나에게 포션을 넘겨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Narrator
#. NodeID = 23c3286d-64c4-d5d7-1eb8-2d23fbf8bcde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_HasMet(1) = False
#.   Global:
#.      - SHA_OrthonLair_Knows_MeatPoisoned = False
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_MeatPoisoned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:23c3286d-64c4-d5d7-1eb8-2d23fbf8bcde
msgctxt "h4e7150dfgcfe5g47d4gb706g1160cbe5e452"
msgid ""
"*It seems this merregon is using potions to charm a beast on behalf of its "
"master.*"
msgstr "*이 메레곤은 자신의 주인을 대신해 포션으로 야수를 매혹하는 것으로 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Hoarding Merregon
#. NodeID = 2a7fc815-062f-4fd4-88a3-65876e7a37af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_Merregon_Event_GavePotions(1) = False
#. SetFlags:
#.   Local:
#.     - 989f8f48-9328-2eca-3aa2-15007aabd48b_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:2a7fc815-062f-4fd4-88a3-65876e7a37af
msgctxt "h92cc14fdg7f3eg415fgbb2fgdb56209b225f"
msgid ""
"<i>Fill master's coffers. Tend to his beast. Feed it potions. Keep it "
"charmed.</i>"
msgstr "<i>주인님의 궤짝을 채운다. 야수를 돌본다. 포션을 먹인다. 매혹 상태를 유지한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Narrator
#. NodeID = 3b7408dd-d158-2ee9-08fc-47e7dccec727
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_HasMet(1) = True
#.   Global:
#.      - SHA_OrthonLair_Knows_MeatPoisoned = False
#. SetFlags:
#.   Global:
#.     - SHA_OrthonLair_Knows_MeatPoisoned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:3b7408dd-d158-2ee9-08fc-47e7dccec727
msgctxt "hba585a5ag85c6g44eagb86cg5c1e401be0e0"
msgid ""
"*This merregon is charming the displacer, for its master. It has potions to "
"control the beast's behaviour.*"
msgstr "*이 메레곤은 자기 주인을 위해 디스플레이서 비스트를 매혹합니다. 야수의 행동을 통제하는 포션을 갖고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Narrator
#. NodeID = 3eaec674-100f-5438-71a5-2b8b615a9f26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_HasMet(1) = False
#.   Global:
#.      - SHA_OrthonLair_Knows_MeatPoisoned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:3eaec674-100f-5438-71a5-2b8b615a9f26
msgctxt "h92fe6d49g1059g42c9g9864ge6207026555f"
msgid ""
"*This merregon is the one who applied potions to the spider carcass - to "
"charm a beast for its master.*"
msgstr "*이 메레곤이 바로 거미 시체에 포션을 바른 장본인입니다. 자신의 주인을 위해 야수를 매혹하고자 했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Player
#. NodeID = 6ffa10fe-d183-4f22-8dec-a4b8180fbac3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 989f8f48-9328-2eca-3aa2-15007aabd48b_MindHasBeenRead = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:6ffa10fe-d183-4f22-8dec-a4b8180fbac3
msgctxt "h0cd03439g3de6g46f8g923fge3d193a744f5"
msgid "*Probe the merregon's mind.*"
msgstr "*메레곤의 정신을 탐색한다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Hoarding Merregon
#. NodeID = 7e1e9874-9edf-60a8-8c50-cd90108597e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:7e1e9874-9edf-60a8-8c50-cd90108597e8
msgctxt "h06c840e8gc299g4acbg9fd2g9e111e1b9f45"
msgid "*Groan.*"
msgstr "*그어어.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000
#. Speaker = Player
#. NodeID = 899ae586-54bb-1781-6d06-afe762943ab6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_000:899ae586-54bb-1781-6d06-afe762943ab6
msgctxt "hb8ed44bfgd524g431bga9adg7d3807fd97c4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

