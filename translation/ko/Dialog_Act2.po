msgctxt "hd838c13bgffe3g4de4g8b5eg4a15f29bfb3e"
msgid "Resist it!"
msgstr "저항하세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = 1f0edd6b-00f7-cc7b-a292-d9888085f179
