msgctxt "hfbbd6eb7g6aacg4da3gbf12gc7599b401bbe"
msgid "Now. Hour comes."
msgstr "지금이야. 때가 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_HavenOutcasts_DockGuard_Left_Ranger
#. Speaker = Harper Lymn
#. NodeID = b00dabba-d7b0-e838-a704-e5d090e07857
