msgctxt "h8dd21a93g9f95g48a6gb8e8g96ca7031444c"
msgid "You dare? YOU DARE?!"
msgstr "감히? 네가 감히?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Drider_AD_Combat
#. Speaker = Kar'niss
#. NodeID = 536d6b6a-53ae-463f-b8ac-ccd08f2c77b7
