msgctxt "h551a3d28ge2f2g4011gbaa5g6a52688b7c23"
msgid "<i>Chk! </i>That orb is about to erupt."
msgstr "<i>츠크! </i> 보주가 터지려고 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes
#. Speaker = Wyll
#. NodeID = 95bb4645-24c7-43dc-abd3-b5a3bbbb827a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes:95bb4645-24c7-43dc-abd3-b5a3bbbb827a
msgctxt "h67e349ecge228g4ce6ga28cg14f5fb71ab69"
msgid "<i>Gods</i> - any moment now, that orb is going to explode."
msgstr "<i>신들이시여</i>, 곧 보주가 폭발할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_OrbExplodes
#. Speaker = Shadowheart
#. NodeID = b4a6f24a-7619-4c1d-88f9-765086aa7ae6
