#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:c9430b3e-36cc-49d7-aa11-6d9dc8ebd6c5
msgctxt "h11ad929agd637g47cbg9d76g0b00107e684b"
msgid "Strange little beast. I would've made short work of it, once."
msgstr "작고 이상한 짐승이네. 나라면 한 번에 빨리 끝내 줬을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Gale
#. NodeID = d0cd2535-b27d-4e2b-bbb2-cc5aeaa3964e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:d0cd2535-b27d-4e2b-bbb2-cc5aeaa3964e
msgctxt "hfafab860g65e8g4c0ag9d4bg044c4fc138a1"
msgid "Defiant little fellow. Seems oddly... purposeful."
msgstr "반항심 넘치는 작은 친구일세. 뭔가... 목적의식이 있는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Narrator
#. NodeID = d6cd1cff-a748-34eb-7366-d9aa94d51cf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:d6cd1cff-a748-34eb-7366-d9aa94d51cf0
msgctxt "h0ebce030g5dfdg463aga56bgb89ba81412b0"
msgid "*Nothing stands out to you.*"
msgstr "*특이한 점은 보이지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Astarion
#. NodeID = e1dbc06d-7453-4a67-98f0-6b4cf2fe8a3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsCalm_Event_CompanionSuggestsLeave(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:e1dbc06d-7453-4a67-98f0-6b4cf2fe8a3e
msgctxt "hc13751adg8fceg475fg875bge03675728b7c"
msgid ""
"Are you really being waylaid by a snack? Let's just look around, vermin be "
"damned."
msgstr "진짜 저런 한 입 거리도 안 되는 놈 때문에 멈춰 설 거야? 어서 둘러보자. 쥐 따위 알 게 뭐람."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = e5894af5-2311-80f5-10d4-27d9c09238cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:e5894af5-2311-80f5-10d4-27d9c09238cf
msgctxt "hc776fd56g1de1g4606g8a6cg3b8079fdf957"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = e72177c2-0c58-49e9-5862-c2ab2c0ac4f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:e72177c2-0c58-49e9-5862-c2ab2c0ac4f6
msgctxt "hcc068d2bg4499g4da9g8572ge4378aa45ec5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = e8f59d81-a9f0-e5e0-e895-991e70e81f1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:e8f59d81-a9f0-e5e0-e895-991e70e81f1d
msgctxt "h526884b2g6d5bg4b0dga410ge80eb3052c68"
msgid "Try it. Lot more guts than you'd expect. <i>A lot more!</i>"
msgstr "해보든가. 생각보다 더 많이 묻게 될걸. <i>훨씬 더 많이!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = ec595d71-709a-1b71-ab5e-9f96d65c1d30
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsCalm_Event_AttemptedAnimalHandling(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsCalm_Event_AttemptedAnimalHandling(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:ec595d71-709a-1b71-ab5e-9f96d65c1d30
msgctxt "hb8513a50gcd83g4948g80bag78aac82b3c76"
msgid "<i>Observe the rat's behaviour.</i>"
msgstr "<i>쥐의 행동을 관찰한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = ed364f64-1a5b-fc1b-d1c1-1b4f0b6eb765
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Local:
#.     - df19817d-fc15-a495-a022-40aadef838cc_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:ed364f64-1a5b-fc1b-d1c1-1b4f0b6eb765
msgctxt "h5673d578g358bg4a13g8c5dgefbc5de635f5"
msgid "Unworthy! Unworthy to walk among friendly bones! <i>Leave!</i>"
msgstr "자격이 없는 놈! 친구들의 뼈 사이를 거닐 자격이 없다! <i>떠나라!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = f0831da8-9a21-6a81-f938-b8768f8ee1d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - df19817d-fc15-a495-a022-40aadef838cc_E = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Local:
#.     - df19817d-fc15-a495-a022-40aadef838cc_E = False
#.     - df19817d-fc15-a495-a022-40aadef838cc_F = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:f0831da8-9a21-6a81-f938-b8768f8ee1d6
msgctxt "h0939746bgd6d9g44c4gab72g42d62d627dec"
msgid "Join an army. Became an army. <i>Leave!</i>"
msgstr "군대에 들어왔다. 군대가 되었다. <i>떠나라!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = f6fe49a7-7e83-aa5e-d967-e2e758557582
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsCalm_Event_AnimalHandlingSuccees(1) = True
#.      - SHA_LastJusticiar_RatsCalm_Knows_RatsUncooperative(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsCalm_Knows_RatsUncooperative(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:f6fe49a7-7e83-aa5e-d967-e2e758557582
msgctxt "h58988125gd1c3g4405g988bgbce01d371fb3"
msgid ""
"<i>The rodent needs a lesson in humility. Shoo it away, aggressively.</i>"
msgstr "<i>이 설치류는 겸손에 대해 배울 필요가 있다. 거칠게 쫓아낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Astarion
#. NodeID = f78edfc0-838a-46f3-8f8d-dd7d1636beb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:f78edfc0-838a-46f3-8f8d-dd7d1636beb6
msgctxt "ha2da1eabg0fafg4d47g9657g68e3a9f5c4bc"
msgid ""
"You're being held up by a snack. Leave the rodent and let's look around."
msgstr "한 입 거리도 안 되는 놈한테 붙들려 있다니. 쥐는 내버려 둬. 어서 둘러보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = ffa2b695-9776-4d90-e7c3-2e0949c2ecab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:ffa2b695-9776-4d90-e7c3-2e0949c2ecab
msgctxt "hdf60554bgff19g40e1g80dcgbc75f21cfd06"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 01f3ddee-822e-965b-16c9-618e28211383
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:01f3ddee-822e-965b-16c9-618e28211383
msgctxt "h4406a413gddbfg431dg99aag5e152094cb32"
msgid "No, you cannot leave - not without your word. Not without peace."
msgstr "아니, 떠날 수 없어. 약속 없이는, 평화 없이는 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 021bab27-5142-25f6-efc9-8b64fc64f649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:021bab27-5142-25f6-efc9-8b64fc64f649
msgctxt "hbd4128b7g9039g4517ga6aag37f2681e0213"
msgid ""
"Every little death fills my head with more thoughts. It's too much - too "
"painful. Kill one more of us, and you will pay."
msgstr ""
"모든 죽음 하나 하나가 내 머리에 더 많은 생각을 집어 넣어. 너무 많아, 너무 고통스러워. 우리를 한 명이라도 더 죽이면, 대가를 "
"치르게 해주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 03305894-c683-c882-65a5-962436e617a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:03305894-c683-c882-65a5-962436e617a0
msgctxt "hfdc12527g63a9g48b1g96afg632256c4de09"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 04c7285a-1c71-9962-6475-5323c2f5a04a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:04c7285a-1c71-9962-6475-5323c2f5a04a
msgctxt "h1efc3778g3cf9g4bb6gb6e7gcb0dd4e1ca98"
msgid ""
"There are treasures. Useless to us now, but once they had value - "
"<i>meaning. </i>We hid them away, untouched for a lifetime."
msgstr ""
"보물이 있어. 이제 우리에겐 쓸모 없지만, 한때는 가치가, <i>의미가</i> 있었지. 우린 보물을 숨기고, 평생 동안 지켜왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 05a8cb1b-e28a-9e62-c1d4-e7a78a8311b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:05a8cb1b-e28a-9e62-c1d4-e7a78a8311b5
msgctxt "h5b284daeg65cag432agbba2g5d2e5fb561c1"
msgid ""
"You kill many, but many remain. <i>Stop</i>. Spare our lives, or face my "
"teeth and claws."
msgstr "넌 많이 죽였지만, 아직 많이 남았어. <i>멈춰</i>. 우리를 살려주지 않으면, 내 이빨과 발톱에 맞서야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 08af5b49-e679-ad1f-28cb-67cc01ec347c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:08af5b49-e679-ad1f-28cb-67cc01ec347c
msgctxt "hc8ef4592g3a23g4c30g929age935bc485ec1"
msgid "*Squeak!*"
msgstr "*찍찍!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 0b8af5a1-f8be-a1ad-81c5-f037dbccb2f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:0b8af5a1-f8be-a1ad-81c5-f037dbccb2f1
msgctxt "h82f3ecb5gf071g413eg83d3g059c6870e46f"
msgid "An ordinary rat alone. But together? Something more."
msgstr "혼자서는 평범한 쥐 한 마리야. 하지만 함께 한다면? 그 이상이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 0d0de8d3-0eb4-e1d1-6c9c-00ec55902e5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:0d0de8d3-0eb4-e1d1-6c9c-00ec55902e5f
msgctxt "h1f399dc8g1834g4528gb94dgcbb2c924de59"
msgid ""
"*The rat seems agitated, like it doesn't want you to leave. Not without "
"getting what it wants.*"
msgstr "*쥐가 불안해 보입니다. 당신이 떠나지 않길 바라는 것 같습니다. 원하는 게 따로 있는 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 174dafe0-05f5-a822-3ca6-a5f54aeb1cd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:174dafe0-05f5-a822-3ca6-a5f54aeb1cd9
msgctxt "hb86f9163g1600g426fga2f3gb3aa1120c784"
msgid ""
"It shouldn't be. We should be one, long dead. Instead we are many - "
"scurrying, hiding, surviving."
msgstr "그래선 안 되지. 우린 하나여야 하고, 오래 전에 죽었어야 해. 대신 우리는 많아. 종종 거리고, 숨고, 살아남아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 225aa19e-c75e-6cf0-06e7-df698a903a7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiate_Knows_RatsAreJusticiar(1) = True
#.   Global:
#.      - SHA_Orthon_Knows_ContractClause = True
#.      - SHA_Orthon_State_Defeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:225aa19e-c75e-6cf0-06e7-df698a903a7d
msgctxt "h81e91396g763bg45d8ga652g0e153c2bad2e"
msgid ""
"There's an infernal bounty hunter seeking Dark Justiciars. Seems he missed a "
"target."
msgstr "다크 저스티시어를 쫓는 지옥의 현상금 사냥꾼이 있어. 그는 목표를 놓친 셈이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 239171ab-085e-40f6-b729-3d645a3ea75f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:239171ab-085e-40f6-b729-3d645a3ea75f
msgctxt "hac49c354g35a1g4934g849dg0689fa809446"
msgid ""
"We are just crumbs of a life. Harmless nothings, unless you test us. Leave "
"us in peace."
msgstr "우린 그저 생명의 부스러기야. 아무런 해도 없지, 네가 우릴 시험하지 않는 한. 우릴 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 242ab5e9-6b8e-782a-a601-e3bf624d28c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_LastJusticiar_State_StudiedDiplorat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:242ab5e9-6b8e-782a-a601-e3bf624d28c5
msgctxt "h4232fe55g6fd2g4bfaga9ddg0cc036c9e4d5"
msgid "*It wants you to stop killing its fellow rats. Understandable enough.*"
msgstr "*쥐는 당신이 더 이상 다른 쥐들을 죽이지 않길 바랍니다. 그럴만도 하죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 2b7a5c53-dabb-7418-d597-d491247f7a69
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:2b7a5c53-dabb-7418-d597-d491247f7a69
msgctxt "h207973dag432ag4e7fg9150g9740a88dabdd"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 2c5d019e-f85b-a8be-ec61-73f2094f57a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:2c5d019e-f85b-a8be-ec61-73f2094f57a9
msgctxt "hd6d043bbg6f74g426fgbb97g3ac26f8aa7d7"
msgid ""
"The horned beast. He killed many, now you kill more. Leave us. <i>Please</i>."
msgstr "그 뿔난 짐승. 우릴 많이 죽였지만, 이젠 네가 더 많이 죽였어. 우릴 내버려둬. <i>제발</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 3a861077-7c40-81e1-56ad-c00b5a5b1cbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet(1) = True
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet2(1) = True
#.     - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:3a861077-7c40-81e1-56ad-c00b5a5b1cbe
msgctxt "hf56b8d6bg8d41g473dg9130gb1932d33689e"
msgid "*The rat's beady eyes hold your gaze intently. What does it want?*"
msgstr "*쥐의 부리부리한 눈이 당신을 바라봅니다. 뭘 원하는 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 4cb3fb42-d89c-cf69-507a-c9cb5b3487dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:4cb3fb42-d89c-cf69-507a-c9cb5b3487dd
msgctxt "hcf5ffc65g01e1g4648g82f6g05b1504b8dab"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 4d686fe1-d28a-8899-b0f5-ffc0e053884b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiate_Event_RatOfferedTreasure(1) = True
#.      - SHA_LastJusticiar_RatsNegotiate_State_AcceptedTreasureOffer(1) = False
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiate_State_AcceptedTreasureOffer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:4d686fe1-d28a-8899-b0f5-ffc0e053884b
msgctxt "h2c49bf77gb82eg4f7fg9c8cg798636b2930d"
msgid "All right. Your lives for this treasure. You'd better be level with me."
msgstr "좋아. 널 살려줄 테니 보물을 받아가마. 거짓말은 하지 않는 게 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 4dbfd083-8d04-3212-539c-ccf27cbeb5c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_LastJusticiar_State_RitualCircleDiplorat = True
#. SetFlags:
#.   Object:
#.     - SHA_LastJusticiar_State_StudiedDiplorat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:4dbfd083-8d04-3212-539c-ccf27cbeb5c4
msgctxt "hb1548247g37a4g4f64g8bc2g89187ac93c79"
msgid "*It wants for you to leave it and its fellow rats in peace.*"
msgstr "*쥐는 당신이 다른 쥐들을 내버려 두길 원합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 51a7841e-5a19-52fa-a29a-22fbfa3f3ffe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:51a7841e-5a19-52fa-a29a-22fbfa3f3ffe
msgctxt "haa87915bge64bg4b31ga1ceg686d4315e340"
msgid "I am harmless - until we are cornered."
msgstr "난 무해해. 궁지에 몰리지 않는 이상은."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 531eaca3-644b-5736-ec4e-545bbc607437
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiate_Knows_RatsAreJusticiar(1) = True
#.   Global:
#.      - SHA_Orthon_Knows_ContractClause = True
#.      - SHA_Orthon_State_Defeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:531eaca3-644b-5736-ec4e-545bbc607437
msgctxt "h382e75acg4704g4127g9d09gbe495361226c"
msgid ""
"There was an infernal bounty hunter seeking Dark Justiciars. Seems he missed "
"a target."
msgstr "다크 저스티시어를 쫓는 지옥의 현상금 사냥꾼이 있었어. 그는 목표를 놓친 셈이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 5688c9db-3391-4263-02e1-283fa6062cca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:5688c9db-3391-4263-02e1-283fa6062cca
msgctxt "h0433d673g8e6dg479bgbf77ged5fcbb3c380"
msgid ""
"*Beady, malicious eyes stare at you. The rat probably wants to feast on your "
"corpse along with its friends.*"
msgstr "*적의로 반짝이는 두 눈이 당신을 바라봅니다. 아무래도 다른 쥐들과 함께 당신의 시체를 파먹고 싶은 모양입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 58b86312-2fba-c62f-7af5-ec157cc789b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:58b86312-2fba-c62f-7af5-ec157cc789b0
msgctxt "hc664bbedg8923g4b0fgab29gfd4fb23e1e39"
msgid "All right - a truce, then."
msgstr "좋아. 더는 건드리지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 61a2dc57-a9cb-c4af-af5b-c1ce4a86126d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:61a2dc57-a9cb-c4af-af5b-c1ce4a86126d
msgctxt "hcc3ab344g0fa9g46bfg984agca3b84baa0db"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 63d5fe9a-e99b-7c76-de97-0b47fc8155be
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_LastJusticiar_State_PlayerTruce = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:63d5fe9a-e99b-7c76-de97-0b47fc8155be
msgctxt "hd3b9b54fgc37bg447eg90a3g0eaa8d833730"
msgid ""
"At last, you see sense. Fetch your reward and leave us. Do not come back."
msgstr "마침내, 분별력을 보이는군. 보상을 챙기고 우릴 내버려 둬. 돌아오지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 658572a4-0751-0a97-9d6f-ffc3e4f73280
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiate_Knows_RatsAreJusticiar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:658572a4-0751-0a97-9d6f-ffc3e4f73280
msgctxt "h62108062g7e31g4704g8ff5g4426c0ac6dee"
msgid ""
"*The rat sounds like it's describing Sharran rites of initiation - those of "
"the Dark Justiciars.*"
msgstr "*샤 신도들이 행하는 다크 저스티시어 입단 의식에 대해 말하고 있는 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 69b0a4a0-b66c-ff5a-c2ff-44d1e37f26c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:69b0a4a0-b66c-ff5a-c2ff-44d1e37f26c9
msgctxt "hc6d5a3a5gf596g48f0gb900g546715a98fc4"
msgid ""
"*The rat's eyes gleam with uncanny intelligence. It seems to grasp your "
"gesture, and accept it.*"
msgstr "*쥐의 눈이 기묘한 총명함으로 번뜩입니다. 당신의 몸짓을 이해하고 그 뜻을 받아들인 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = 69c4ae24-4213-e54a-b621-6c364c4bc3f9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiate_Knows_RatsAreJusticiar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:69c4ae24-4213-e54a-b621-6c364c4bc3f9
msgctxt "h706e3a6bg1bffg4f2cg8a68g576026bdf3d5"
msgid ""
"*The rat sounds like it's describing the sacred rites of Shar's Dark "
"Justiciars.*"
msgstr "*쥐는 다크 저스티시어의 종교의식을 묘사하는 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 6b0d9f4a-bc2b-8c3e-0900-0fb30e966196
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:6b0d9f4a-bc2b-8c3e-0900-0fb30e966196
msgctxt "h789e8f90g6038g4f80g98c3g85e1f3f10eac"
msgid ""
"Fool. We gave you every opportunity, but still you choose death. So be it."
msgstr "바보 자식. 모든 기회를 줬건만, 죽음을 고르다니. 그럼 죽어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 6e94e2bc-4b80-872f-1b9b-405c8b4212ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:6e94e2bc-4b80-872f-1b9b-405c8b4212ed
msgctxt "h44290ff8g6f56g4f23g92b8g96844158cb60"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 706a6c16-5992-41ec-d6ec-69aa15344064
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:706a6c16-5992-41ec-d6ec-69aa15344064
msgctxt "hc62f07b6g679bg4732gad39g87ccada98875"
msgid "<i>Yell at the rat. Frighten it away.</i>"
msgstr "<i>쥐에게 소리 지른다. 겁을 줘서 쫓아낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 7434ee13-32d9-9568-aa01-d55f75065dce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_LastJusticiar_State_PlayerTruce = True
#.     - SHA_LastJusticiar_State_SharedTreasure = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:7434ee13-32d9-9568-aa01-d55f75065dce
msgctxt "h3b0caaa6g0375g451ag8a79g9d56b6f5c3ae"
msgid ""
"And you better be true to your word. I am small, but we are many. Now fetch "
"your prize, and leave."
msgstr "네 말을 지키는 게 좋을 거야. 나는 작지만, 우리는 많지. 이제 보상을 챙겨서, 떠나버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 9613d07a-f731-37fa-fc25-43535ae7ece5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_LastJusticiar_Knows_RatsAreMany = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:9613d07a-f731-37fa-fc25-43535ae7ece5
msgctxt "hd3b23076ge192g4c66gb9e5gdfc804c2a93c"
msgid "But we all remember a name. <i>Lyrthindor</i>. We share who he was."
msgstr "하지만 우리 모두가 이름을 기억해. <i>리씬도르</i>. 우리는 그가 누구였는지 공유하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 9a08cac8-4721-b3db-a241-3fcb7a11faaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:9a08cac8-4721-b3db-a241-3fcb7a11faaa
msgctxt "h4bbbecc9g56f5g4f61g9c17g98f6ce23d6c2"
msgid ""
"Some remember turning away from the sun. Some remember donning a black "
"cloak. Some remember plunging a blade into an innocent heart."
msgstr "몇몇은 태양을 등지던 걸 기억해. 몇몇은 검은 망토를 입던 걸 기억해. 몇몇은 무고한 심장에 칼날을 찔러 넣던 걸 기억해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = 9ad40fc3-32f5-9ef2-a4da-8b5f46b277a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:9ad40fc3-32f5-9ef2-a4da-8b5f46b277a4
msgctxt "hb5964e2fgc910g46e3ga839gd98551f5295d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = 9b605684-ae1e-1231-ea91-fce70162c49a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:9b605684-ae1e-1231-ea91-fce70162c49a
msgctxt "h4594d3c2g15fag4655g9e24g8b8c520f4e32"
msgid "*Squeeeee!*"
msgstr "*찌이이!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = a88cf469-60b3-e6f9-06c9-73550499f3d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = True
#.      - SHA_LastJusticiar_State_RitualCircleDiplorat = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:a88cf469-60b3-e6f9-06c9-73550499f3d2
msgctxt "hf13f28b5gdd0fg4c88gab6cg43b977e94885"
msgid "Remember your word - spare us, leave this place. Your reward awaits."
msgstr "네 약속을 기억해. 우릴 살려주고, 이 곳을 떠나. 네 보상이 기다려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = a8ea42a4-4417-c15c-0dbf-f138100449f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Orthon_Knows_ContractClause = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiate_Knows_RatsAreJusticiar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:a8ea42a4-4417-c15c-0dbf-f138100449f8
msgctxt "h409bbe61gee46g4c50g9f10g0369f89fe0e5"
msgid ""
"*The rats are describing a Dark Justiciar's memories. The orthon's quarry "
"was here all along, scattered and hidden in plain sight.*"
msgstr ""
"*쥐들은 한 다크 저스티시어의 기억들을 묘사하고 있습니다. 오르쏜의 사냥감은 일반적인 시야에서 흩어지고 숨겨져, 줄곧 이곳에 있었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = abf9ede0-16fd-af0c-31f8-5a51e74fd6bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiate_Event_QuestionedStrangeness(1) = True
#.      - SHA_LastJusticiar_RatsNegotiate_Knows_RatsAreJusticiar(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:abf9ede0-16fd-af0c-31f8-5a51e74fd6bf
msgctxt "hdaa06badg2a10g4b5bg8c40g267dfe4955c9"
msgid ""
"Are you telling me you're one person turned into a swarm of rats? How can "
"that be?"
msgstr "네가 한 사람이었는데 쥐 무리로 변했단 말이야? 어떻게 그럴 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = b9e3b0f8-ef32-4675-2f69-f0cfb9854616
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:b9e3b0f8-ef32-4675-2f69-f0cfb9854616
msgctxt "hb107fc83g9128g4827g890agc5d19832f59d"
msgid "<i>Scowl at the rat and shoo it away.</i>"
msgstr "<i>쥐를 노려보며 손을 휘저어 쫓아낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = ba9edabe-914c-d1d1-9595-78b4e7c4bc7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet2(1) = True
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:ba9edabe-914c-d1d1-9595-78b4e7c4bc7d
msgctxt "h8b2816b2ga25eg4f2cg9329gcb43eadc13da"
msgid "A final warning - offer us peace, now, or be devoured."
msgstr "마지막 경고야. 지금 당장 화평을 맺든가, 아니면 잡아먹히든가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = bd5d9f82-3c71-8ec7-443c-5e947b529b15
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:bd5d9f82-3c71-8ec7-443c-5e947b529b15
msgctxt "h8e768dfegffa3g4a9ag90e8g2e372503d1c0"
msgid "<i>Study the rat. Try to figure out what it wants.</i>"
msgstr "<i>쥐를 관찰한다. 뭘 원하는 것일지 추측해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = bdb4a3e4-c726-bd5b-c49c-7976fb85df15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiate_Event_RatOfferedTreasure(1) = False
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiate_Event_RatOfferedTreasure(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:bdb4a3e4-c726-bd5b-c49c-7976fb85df15
msgctxt "hbf33c592g2083g4209gb574g02ed0b4c6232"
msgid ""
"I don't usually bargain with rats. If I let you live, what's in it for me?"
msgstr "난 보통 쥐와 거래하진 않아. 내가 널 살려주면, 무슨 이득이 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = bf8bf8b1-9d05-25d3-af11-5ebaadc0a0e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiate_Event_QuestionedStrangeness(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiate_Event_QuestionedStrangeness(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:bf8bf8b1-9d05-25d3-af11-5ebaadc0a0e5
msgctxt "h04c1f9aegad8eg4c42g8bbag752caa6aa69f"
msgid "You're no ordinary rat, are you? None of you are."
msgstr "넌 평범한 쥐가 아니로군, 그렇지? 너희 중 그 누구도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = c48f21f8-2ad6-403d-2f17-13860a39291f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_LastJusticiar_State_StudiedDiplorat(1) = True
#. SetFlags:
#.   Global:
#.     - SHA_LastJusticiar_State_PlayerTruce = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:c48f21f8-2ad6-403d-2f17-13860a39291f
msgctxt "hfd91e292g62e4g4f63g8895g73a9a322fe79"
msgid "<i>Hold up your hands in peace.</i>"
msgstr "<i>평화의 의미로 손을 들어 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = ccc9f5cd-8688-378f-3f6f-0df41eacbb18
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:ccc9f5cd-8688-378f-3f6f-0df41eacbb18
msgctxt "h85f63a21gb2e7g4e61ga360gb47b80e8e0ce"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = dd66cddf-f124-d90b-e43c-0e2fbd2d0382
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:dd66cddf-f124-d90b-e43c-0e2fbd2d0382
msgctxt "ha55e1c3ag51c4g460cg8878gc1695335b0ec"
msgid "*The rat stares at you. It almost seems like it wants your attention.*"
msgstr "*쥐가 당신을 바라봅니다. 당신의 관심을 바라는 것 처럼 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = e0921ce8-1080-754d-5dbc-370c79521af2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet(1) = True
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet2(1) = True
#.     - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:e0921ce8-1080-754d-5dbc-370c79521af2
msgctxt "h3382c2afg6b4bg4a58g8bb4g13997687f1a6"
msgid "We only seek peace. Kill no more, and we will let you live."
msgstr "우리는 평화를 원해. 더 죽이지 않으면 살려주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = e9d897c0-7bc0-28fe-c474-df54368d538c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:e9d897c0-7bc0-28fe-c474-df54368d538c
msgctxt "he11e1669gca57g4fa5gbd94gbd61523e1cf5"
msgid "Keep your word, and we will reveal them to you."
msgstr "네 말을 지키면, 우리가 보물이 어딨는지 알려주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = e9e5f41b-027b-582c-e73c-354b0727278f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:e9e5f41b-027b-582c-e73c-354b0727278f
msgctxt "ha957b15dgd67fg4468g8eeeg919dd1bdbf5a"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = ebc841f1-4163-88ab-9aa9-f2cd126909af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:ebc841f1-4163-88ab-9aa9-f2cd126909af
msgctxt "h55cdf592g1c6cg4827gb8d7g004bd9e4650d"
msgid "I'm not cutting deals with vermin. Do your worst."
msgstr "쥐 따위랑 거래를 하진 않겠다. 어디 마음대로 해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Rat
#. NodeID = f3d0e3aa-3507-4f22-3fc6-4159e7581769
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiation_Event_Hasmet2(1) = True
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:f3d0e3aa-3507-4f22-3fc6-4159e7581769
msgctxt "h4ca71ce2g5dc3g4743ga85ag2b715b841307"
msgid "*Squeeeak!*"
msgstr "*찌이익!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Narrator
#. NodeID = f939db13-f158-81cf-4e17-00908fd1fdb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_LastJusticiar_State_PlayerTruce = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:f939db13-f158-81cf-4e17-00908fd1fdb8
msgctxt "he3e38732g0eb7g4e7bg9ebegf6d605e4a161"
msgid "*The rat watches intently, as if eager for you to leave.*"
msgstr "*쥐가 뚫어져라 쳐다봅니다. 당신이 떠나길 바라는 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate
#. Speaker = Player
#. NodeID = fb1a8785-91cc-fa43-864b-25c3ffa85b31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsNegotiate_Event_QuestionedStrangeness(1) = True
#.      - SHA_LastJusticiar_RatsNegotiate_Knows_RatsAreJusticiar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsNegotiate:fb1a8785-91cc-fa43-864b-25c3ffa85b31
msgctxt "h2e8aed78g8fb9g40c4gb0d6g226258b7f809"
msgid "One Shar follower turned into scores of rats? How can that be?"
msgstr "샤 추종자 하나가 쥐 떼로 변했다고? 어떻게 그럴 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Player
#. NodeID = 00890d08-de30-0781-61e6-52b38de07c1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:00890d08-de30-0781-61e6-52b38de07c1f
msgctxt "h2483dedfg9b60g458fg8fb1gcb95b5e5ba16"
msgid "<i>Shoo the rat away.</i>"
msgstr "<i>쥐를 쫓아낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Rat
#. NodeID = 03f38234-3103-ba76-2c1f-ad748be5a0d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:03f38234-3103-ba76-2c1f-ad748be5a0d9
msgctxt "hd93b957dg9beeg4999g9908g3e565c16d93e"
msgid ""
"I mourn them. I mourn <i>me</i>. It's your fault - you filled my skull with "
"full of pain and dead mens' faces."
msgstr "나는 그들을 추모해. <i>나를</i> 추모해. 네 탓이야, 네가 내 두개골를 고통과 죽은 자들의 얼굴로 가득 채웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Player
#. NodeID = 058808a7-d818-dcb4-5f38-b35d6d253803
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsPanicked_State_SaysRatsDiseased(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsPanicked_State_SaysRatsDiseased(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:058808a7-d818-dcb4-5f38-b35d6d253803
msgctxt "h9a2104adgc95eg4e17g9c92g8fdc42257ce8"
msgid ""
"You're babbling - probably diseased. I should just put you out of your "
"misery."
msgstr "되는대로 지껄이고 있네, 아마 병든 거겠지. 널 고통에서 해방해 주는 게 낫겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Rat
#. NodeID = 23581c7a-2276-160b-0c9d-d85c3fb3c51e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:23581c7a-2276-160b-0c9d-d85c3fb3c51e
msgctxt "h950e57ddgf740g4458g9f15gd7ca9ce9e272"
msgid "*Squeee!*"
msgstr "*뀌이익!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Rat
#. NodeID = 2381bcaf-6e34-ddea-b387-bbfe6920a196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:2381bcaf-6e34-ddea-b387-bbfe6920a196
msgctxt "hfc2064d5ge05ag4728g8e45gcd06b5dd9d1c"
msgid ""
"Then my misery becomes another's! More fear, more pain, more <i>memories!</i>"
msgstr "그러면 내 고통은 다른 이의 것이 되어버려! 더 많은 공포, 더 많은 고통, 더 많은 <i>기억!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Player
#. NodeID = 2e1abedd-af1c-9932-64e9-6ccbc0cff22a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:2e1abedd-af1c-9932-64e9-6ccbc0cff22a
msgctxt "h2ba22863g7597g4b04gb657gce35878d9ccf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Karlach
#. NodeID = 30d1efdf-f6ca-4975-b0b3-c9cfdd754c52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsPanicked_Event_CompanionInclusionTriggered(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:30d1efdf-f6ca-4975-b0b3-c9cfdd754c52
msgctxt "hbc68733dga9d7g490cga2dfgc1b610b97e53"
msgid ""
"There's something highly suspicious about these ever-more-eloquent rats."
msgstr "이 말도 안 되게 유창한 쥐들은 뭔가 굉장히 수상쩍은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Player
#. NodeID = 30f9e0a9-cb16-926d-41d8-67bf141de7ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsPanicked_State_SaysNoOrdinaryRat(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsPanicked_State_SaysNoOrdinaryRat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:30f9e0a9-cb16-926d-41d8-67bf141de7ea
msgctxt "h5c2c0391gd855g4554gbd7fg8ff811f29c0e"
msgid "You're no ordinary rat, are you?"
msgstr "넌 평범한 쥐가 아니구나, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Lae'zel
#. NodeID = 31a02a67-8baa-4f32-94b6-1c7eb0e3449e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_HasMet = True
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsPanicked_Event_CompanionInclusionTriggered(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:31a02a67-8baa-4f32-94b6-1c7eb0e3449e
msgctxt "haf341d73g0fdfg4abfgb5ddg47c46810c3dd"
msgid ""
"These rats paint a vivid picture, do they not? Volo might learn a thing or "
"two."
msgstr "이 쥐들은 꽤 생생한 그림을 그려주는군, 안 그런가? 볼로가 몇 가지 배울 점이 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Rat
#. NodeID = 404aa4e0-a9e7-7692-6b0b-e2417cef7ab6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a7515c86-de40-c19f-34fb-2dd693bbb8b2_D = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Local:
#.     - a7515c86-de40-c19f-34fb-2dd693bbb8b2_D = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:404aa4e0-a9e7-7692-6b0b-e2417cef7ab6
msgctxt "h17ac5643g33a3g49abga480g57fe52b17728"
msgid "I was promised me a home, not a hunting ground. But who promised?"
msgstr "내가 약속받은 건 집이지, 사냥터가 아니었어. 그런데 누가 약속한 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Player
#. NodeID = 43cbe3be-b757-f84e-08db-4c4e6e661cb5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 21
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsPanicked_Event_PassedPassiveCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:43cbe3be-b757-f84e-08db-4c4e6e661cb5
msgctxt "haffdc052gca94g4d42gbbb6ga2db78e5c1a6"
msgid "<i>Raise your palms to the rat peacefully.</i>"
msgstr "<i>차분하게 손바닥을 쥐에게 내민다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Rat
#. NodeID = 446ea5ec-fdf5-10c5-cc6c-9ecdfe9b3a10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:446ea5ec-fdf5-10c5-cc6c-9ecdfe9b3a10
msgctxt "h52b7b19bg704fg434dgac33g1cad95f293c8"
msgid ""
"Fiend! Bloodspiller! Unworthy wretch! Attack one, and you make foes of "
"<i>ALL!</i>"
msgstr "악마! 살인자! 가치 없는 하찮은 놈! 한 명을 공격하면 우릴 <i>전부 다</i> 적으로 돌리는 거다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Wyll
#. NodeID = 5020c8c9-fa4d-4d6e-99ed-ec1169598a7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsPanicked_Event_CompanionInclusionTriggered(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:5020c8c9-fa4d-4d6e-99ed-ec1169598a7d
msgctxt "h8697269cge4e1g4d74gb559gdf6ad167254a"
msgid "Is it just me, or are the rats here surprisingly... eloquent?"
msgstr "나만 그런 건진 몰라도, 여기 쥐들은 놀랄만큼... 유창한걸?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Rat
#. NodeID = 59f8157f-e787-9a6d-c872-c215b6b955f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:59f8157f-e787-9a6d-c872-c215b6b955f2
msgctxt "h71b7a499ge20eg4706gb016g3dcada7f5655"
msgid "*Squeak!*"
msgstr "*찍찍!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Rat
#. NodeID = 7b3bc4f2-8b76-bfb2-78c2-bf417fa48f5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked:7b3bc4f2-8b76-bfb2-78c2-bf417fa48f5e
msgctxt "h3835c2efg266fg4daaga7fdgff57783ea003"
msgid "You make my head ache. You make me miss things I never had!"
msgstr "넌 내 머리를 아프게 해. 넌 없었던 것도 그립게 만들어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsPanicked
#. Speaker = Lae'zel
#. NodeID = 80956d14-cf98-b912-474b-3cbe56915a69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
