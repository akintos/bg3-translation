msgctxt "h233bf99eg3f00g4c55g8752g837a4ffd6898"
msgid "Until such time, be availed of my services."
msgstr "답을 알게 될 때까지, 나의 힘을 이용하도록 하거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = b33e01b2-d716-9112-aa99-683b5d2ed023
