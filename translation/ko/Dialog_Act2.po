msgctxt "hd5d4a1f6g883eg4e5bgafc0g69e895f73815"
msgid "Meenlocks. Wretched beasts."
msgstr "민록이다. 야비한 짐승들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
