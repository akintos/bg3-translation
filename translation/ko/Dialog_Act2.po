msgctxt "hca9d455bg018dg4a7bg9c43g5f95e5c4d3da"
msgid "ANOTHER."
msgstr "<b>더.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
msgctxt "h378083e6g1577g47e1gb3a9g9c88debf3611"
msgid "AGAIN!"
msgstr "<b>더!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
msgctxt "hac77338fg13a0g4ba2gb140gbd4f79204a83"
msgid "MORE!"
msgstr "<b>더!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
#. HandlePath = TaggedText[0].TagText[3]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
msgctxt "h0def5272g0726g4defg8993g5eedfbf66301"
msgid "MORE GOLD!"
msgstr "<b>더 많은 금!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
#. HandlePath = TaggedText[0].TagText[4]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:bf66f319-a4fd-40b8-8a1e-7b4b0841f2f6
msgctxt "h6460506fgf576g4332g966ag090dfcb2fabe"
msgid "I REQUIRE MORE!"
msgstr "<b>더 필요하다!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = c011a6f6-c38f-cde8-e6db-c7c5e020514c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:c011a6f6-c38f-cde8-e6db-c7c5e020514c
msgctxt "hd07b1478g4d9eg4000g90e9g0daf073d2989"
msgid ""
"THE GOLD IS NOT FOR ME! NOR YOU! THE GOLD IS FOR THE TOLL! DON'T YOU SEE?! "
"DON'T YOU SEE?!"
msgstr "<b>금은 나를 위한 것이 아니다! 너를 위한 것도 아니다! 금은 통행료다! 알아들었나?! 알아들었나?!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = c22e5e88-181e-0112-7543-f897d946f885
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:c22e5e88-181e-0112-7543-f897d946f885
msgctxt "hc75d2269gc2a8g4203g8446g1e55c71c7140"
msgid "NO! I COLLECT THE TOLL. MORE GOLD - NOW!"
msgstr "싫다! 난 통행료를 거둔다. 더 많은 금화, 당장!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = c266b329-7251-edf2-75ef-1f7daadafba1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Tollhouse_State_TollPaid = True
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_Event_GaveEnoughCoins = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:c266b329-7251-edf2-75ef-1f7daadafba1
msgctxt "h60cd7ac4g6a9eg496ag875dg8996edb06ac6"
msgid "ENOUGH. YES. YOU MAY PASS."
msgstr "<b>충분하다. 좋아. 지나가도 좋다.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = c29876aa-0ee8-b3ad-846d-7a140ac59ee7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:c29876aa-0ee8-b3ad-846d-7a140ac59ee7
msgctxt "hd6c57b88g4d88g4699gb7ffged65cd3b857d"
msgid "STAND... DOWN? BUT... <i>GOLD</i>."
msgstr "물러... 서? 하지만... <i>금화를</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = c567b545-2610-a6c5-53af-0b6bf39ca211
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:c567b545-2610-a6c5-53af-0b6bf39ca211
msgctxt "h34f93c6cg977fg473fg9c03ge48f5219ae99"
msgid "You dare to question their decision? Leave this place at once!"
msgstr "감히 상부의 지시에 의문을 제기하는 거냐? 당장 여기서 떠나라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = c70a6ede-5605-4af0-241d-6c79b5584681
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:c70a6ede-5605-4af0-241d-6c79b5584681
msgctxt "h1d21820dgd105g4ff3gb166gf39688e65e96"
msgid "REPLACE... ME? NO... I REQUIRE GOLD!"
msgstr "<b>나를... 대체해? 아니야... 금이 필요하다!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = c7680e63-d069-4d75-b777-842b0bd2e78b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:c7680e63-d069-4d75-b777-842b0bd2e78b
msgctxt "h85795a88g4c98g445dga08eg3ace2549f4a5"
msgid "YOU MAY PASS THE RIVER. BUT FIRST YOU MUST PAY."
msgstr "<b>강을 지나가도 좋다. 하지만 금부터 내야 한다.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = d4872947-5dc8-c46e-5e10-363a23600c59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:d4872947-5dc8-c46e-5e10-363a23600c59
msgctxt "hd6d81ff7gb397g4589ga5a4gfc7c8f53fd26"
msgid "I have no more gold."
msgstr "돈 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = dbd340f6-a351-47ae-ad44-38ed996e4e0f
