msgctxt "h4c4876fbg1d44g4c48gab53g63c963da0575"
msgid "Decapitated - but still warm. This happened recently."
msgstr "목이 잘렸군. 하지만 아직 온기가 남아있다. 방금 벌어진 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act3/Wyrm/WYR_SmugglersCave_PAD_FoundDeadBody
#. Speaker = Player
#. NodeID = 743a2007-30eb-4157-9315-eb8058c16178
