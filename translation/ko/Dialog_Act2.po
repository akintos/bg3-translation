#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_SpotGem:fa42ac69-6167-36ce-d85e-a68a135813f2
msgctxt "h94842032g8c22g4458g9ceeg1da94c9f8a1f"
msgid "Another gem. This'll need to go in a socket later."
msgstr "또 다른 보석이군. 제단에 끼울 때 필요하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_SpotGem
#. Speaker = Player
#. NodeID = fa42ac69-6167-36ce-d85e-a68a135813f2
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Trials_PAD_SpotGem_Event_FirstGemSeen(0) = True
#.   Global:
#.      - SHA_Disc_Altar_Knows_GemsRequired = True
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_SpotGem:fa42ac69-6167-36ce-d85e-a68a135813f2
msgctxt "h0c88ce3fgb8aag4dccga650gc04dee70b781"
msgid "Another gem. There must be one for each trial."
msgstr "또 다른 보석이군. 한 시험에 하나씩인 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow
#. Speaker = Player
#. NodeID = b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow:b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
msgctxt "hdc9d4e35g14c1g46bbg8ee4g5a39c5f03e1f"
msgid "Well. This looks familiar."
msgstr "이런, 익숙한 감각인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow
#. Speaker = Player
#. NodeID = b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow:b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
msgctxt "heb21b724g004eg4ef6g83bag2dced4707147"
msgid "Damn - back to the beginning."
msgstr "젠장, 처음으로 돌아왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow
#. Speaker = Player
#. NodeID = b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow:b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
msgctxt "h2bbad1f2gc78bg4043g846fgf7c8340e1b57"
msgid "Dammit. One step forward, a bunch back."
msgstr "제기랄. 몇 발짝 나갔다고 이러는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow
#. Speaker = Player
#. NodeID = b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow:b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
msgctxt "hb50a6f3egd802g47eegbeeag544b2169ab7b"
msgid "Really - back to the beginning? Vlaakith, grant me patience..."
msgstr "설마. 출발점으로 돌아왔다고? 블라키스여, 인내심을 주소서..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow
#. Speaker = Player
#. NodeID = b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow:b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
msgctxt "h277b6f7cg38d4g47f9g9c1fg600d3b19777c"
msgid "Blast it. Got to try again - and not be seen this time."
msgstr "제기랄. 다시 시도해야 해. 이번엔 들키지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow
#. Speaker = Player
#. NodeID = b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow:b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
msgctxt "hb07e772dge644g4937g8061g5bd3851f3ec2"
msgid "Damn shade. Looks like I need to give this another go."
msgstr "망할 그림자 같으니. 한 번 더 시도해 봐야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow
#. Speaker = Player
#. NodeID = b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TeleportedByShadow:b1cb0f55-0c0f-48ba-9c0e-c8d0988914af
msgctxt "he1143d21gcabbg4b51g966aged979b1fa4c3"
msgid "Damn. That shade knocked me right back to the start."
msgstr "젠장. 저 시커먼 놈이 처음으로 되돌려 놨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TortureRoomPlaque
#. Speaker = Narrator
#. NodeID = 9305278d-de3d-d399-f1fd-e961e0f07f9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_TortureRoomPlaque:9305278d-de3d-d399-f1fd-e961e0f07f9a
msgctxt "hd2f0adaeg6fabg4fa5g936ag553367021986"
msgid "*Her Most Hallowed Mercy*"
msgstr "*그분의 가장 거룩한 자비*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Baptism
#. Speaker = Shar
#. NodeID = 5fd7f339-5eb5-a0df-02f0-814b7817e3cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Baptism:5fd7f339-5eb5-a0df-02f0-814b7817e3cb
msgctxt "h251110cdg8493g4958g87bage07818ea64dd"
msgid "The end draws near. You show great potential - do not falter now."
msgstr "끝이 다가온다. 네게는 크나큰 잠재력이 있구나. 이제 와서 주춤하지 말거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Baptism
#. Speaker = Shar
#. NodeID = b6d76fc9-f95a-e81b-fdd0-bf1c478b1d57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_TooManyFailures = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Baptism:b6d76fc9-f95a-e81b-fdd0-bf1c478b1d57
msgctxt "hf361f214g5716g4d8agae1eg75d15968e45c"
msgid "You persevere, though you struggled in my trials. Admirable, perhaps."
msgstr "설령 나의 시련에서 분투하였을지언정 너는 인내하는구나. 어쩌면 칭찬할 만한지도 모른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Baptism
#. Speaker = Shar
#. NodeID = e0eeb0b5-4fae-deb9-a576-8959ddafe82e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Baptism:e0eeb0b5-4fae-deb9-a576-8959ddafe82e
msgctxt "h5069db63g6370g4cb0gbe07g2d1e01b1e3c2"
msgid ""
"One more test awaits. Descend to the Nightsong. Make a sacrifice. Rise again "
"a Dark Justiciar."
msgstr "하나의 시험이 남아 있다. 밤의 노래가 있는 곳으로 강하하여 희생의 공물을 바치거라. 다크 저스티시어로 다시금 서거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_ProgressionCommentary
#. Speaker = Shar
#. NodeID = 114cb904-dc07-8dfc-38f7-b6036888ccc0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_TooManyFailures = True
#.   Local:
#.      - 874b04d9-bc87-4871-16c6-976712142be3_CommentedOnFailure = False
#. SetFlags:
#.   Local:
#.     - 874b04d9-bc87-4871-16c6-976712142be3_CommentedOnFailure = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_ProgressionCommentary:114cb904-dc07-8dfc-38f7-b6036888ccc0
msgctxt "hc2d87b2dg65d7g4fa2g9a86g330cccb4048b"
msgid "A poor effort. Perhaps you are not worthy of my embrace, child."
msgstr "서투르구나. 너는 나의 포용을 받을 자격이 없는지도 모르겠다, 아이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_ProgressionCommentary
#. Speaker = Shar
#. NodeID = bfc26a5f-927a-33f3-ba93-fb8812545d1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_PassedAnyTrial = True
#.      - SHA_Trials_State_AllTrialsPassed = False
#.   Local:
#.      - 874b04d9-bc87-4871-16c6-976712142be3_CommentOnPassingOne = False
#. SetFlags:
#.   Local:
#.     - 874b04d9-bc87-4871-16c6-976712142be3_CommentOnPassingOne = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_ProgressionCommentary:bfc26a5f-927a-33f3-ba93-fb8812545d1b
msgctxt "hbe99617bgc9d1g427eg8a55g945186605dc4"
msgid ""
"The first trial completed. The first sign you are worthy. Continue - do not "
"fail me."
msgstr "첫 번째 시련이 끝났구나. 네가 가치 있다는 첫 징후로다. 계속하거라. 날 실망시키지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_ProgressionCommentary
#. Speaker = Shar
#. NodeID = e60bb0d7-e34e-b60d-044d-cdcae4a7ef4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_AllTrialsPassed = True
#.   Local:
#.      - 874b04d9-bc87-4871-16c6-976712142be3_CommentedOnPassingAll = False
#. SetFlags:
#.   Local:
#.     - 874b04d9-bc87-4871-16c6-976712142be3_CommentedOnPassingAll = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_ProgressionCommentary:e60bb0d7-e34e-b60d-044d-cdcae4a7ef4e
msgctxt "h21e05161gbe81g4725g836ag00ec0970d7a0"
msgid ""
"You have triumphed at every turn. Seek out my inner sanctum - the final test "
"awaits."
msgstr "너는 매번 성공을 거두었다. 나의 내밀한 성소를 찾거라. 마지막 시험이 기다린다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_TrialIntro
#. Speaker = Shar
#. NodeID = 59917840-d6e8-edb0-27d5-a0479d886e01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_TrialIntro:59917840-d6e8-edb0-27d5-a0479d886e01
msgctxt "h3ae523c5g350dg49c1ga6f7g82cff3e0391c"
msgid "Nothing of value comes easy. Overcome my trials, and win my embrace."
msgstr "가치 있는 것은 쉽게 오지 않으리. 시련을 극복하고 나의 품에 들거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Welcome
#. Speaker = Shar
#. NodeID = ae5fd3e0-089f-e474-47bf-51353fe0f345
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_AD_Welcome:ae5fd3e0-089f-e474-47bf-51353fe0f345
msgctxt "hbbeaf1bfgee73g4c2egbce1g9913181f379f"
msgid "Welcome, child. Follow my voice, and prove your worth."
msgstr "환영한다, 아이야. 내 목소리를 따라가 네 가치를 증명하기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "h49935d1agad5eg4b44gbf0bg880395817003"
msgid "That voice, it's - Shar? It can't be..."
msgstr "이 목소리는, 설마 샤님인가? 그럴 리가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "hf50fd9a4g9934g4b2ag8393g7fbf89d97202"
msgid "That voice - could it be the Dark Goddess herself?"
msgstr "저 목소리... 설마 암흑신이 직접 말한 것인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "h4e186da3gbbecg430bgb124g5989632ba97d"
msgid "No earthly voice... I think the Lady Shar speaks to us..."
msgstr "이 세상의 목소리가 아니야... 아무래도 샤가 우리에게 직접 말하는 것 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[3].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "h62b20ca6g5458g4e04gbf76g39e2bf069b20"
msgid "That voice... is that <i>Lady Shar...? </i>"
msgstr "저 목소리... 설마 <i>샤님인가...?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[4].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "h9e8868a1gd498g4fc1gac1fg38bce96d033e"
msgid "Curious. I shouldn't wonder if that was the voice of Shar herself."
msgstr "희한하군. 방금 그 목소리가 샤 본인의 소리였는지 의심해서는 안 되는 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[5].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "he7923029gdde3g49a8g8878g7faef4d475f2"
msgid "That couldn't have been Shar, could it?!"
msgstr "샤가 직접 우리한테 말을 건 건 아니지, 설마 그런가?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[6].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "h64c871bfg51d6g43b0g9af5g554d67b8b93f"
msgid "That voice... could it be Shar herself? The gods are watching us."
msgstr "저 목소리... 설마 샤 본인인 건가? 신들이 우리를 내려다보고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[7].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "h94c6e8aagddf4g4089gb183ga98b9489e802"
msgid "That voice... could it be Shar herself? Or some magic echo?"
msgstr "저 목소리... 설마 샤 본인인 건가? 아니면 마법적인 메아리일까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction
#. Speaker = Player
#. NodeID = 378cf30a-3e8f-45e8-8671-f7956b01be75
#. HandlePath = TaggedText[8].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_HeardSharVoice = True
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_VoiceOfShar_PAD_VoiceReaction:378cf30a-3e8f-45e8-8671-f7956b01be75
msgctxt "h49175b64g65bfg4c10ga129gcb66da4f8ce1"
msgid "A voice... is that Shar herself, who speaks...?"
msgstr "저 목소리... 샤 본인이 말하는 걸까...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/TWN_Shadowheart_PAD_StatueSight
#. Speaker = Shadowheart
#. NodeID = 313d48c6-69ef-45e3-982e-786720dc3c77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_SCL_Ketheric_State_PlayerKnowsKethericHistory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/TWN_Shadowheart_PAD_StatueSight:313d48c6-69ef-45e3-982e-786720dc3c77
msgctxt "h9a0699b5gf6c6g4282gaf3bgd8f02888bc44"
msgid ""
"Ketheric Thorm, shown in Selûnite armour. Is there any god that turncoat "
"<i>hasn't </i>bowed to?"
msgstr "케서릭 쏨, 셀루네의 갑옷을 걸쳤군. 그 변절자가 충성을 <i>바치지 않은</i> 신이 있기는 한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/TWN_Shadowheart_PAD_StatueSight
#. Speaker = Shadowheart
#. NodeID = 6ba65a8e-3992-44a7-9f2e-f2ca2d68b4f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
