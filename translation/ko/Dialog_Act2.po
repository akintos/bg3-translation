msgctxt "hf8fe03b2gb680g46d7g8a40gb382fdcd666e"
msgid "How goes the treasure hunt?"
msgstr "보물찾기는 어떻게 돼가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HarperGuard_002_AD_WithMirkon
