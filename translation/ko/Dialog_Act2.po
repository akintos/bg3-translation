#.     - MOO_Assault_AssaultFlamingFist_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001:bc9c65d3-5047-47ea-9a84-b261a057a42a
msgctxt "h3055426bgcd2ag4ad5g9380g1450696b4871"
msgid "These cult-nutters don't die easy. We've lost a few of ours already."
msgstr "이 교단병자놈들은 잘 죽지도 않아. 이미 우리도 손실이 생겼고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001
#. Speaker = Fist Nipawa
#. NodeID = cd4d8f10-c8ea-4846-b28f-07db0c94298c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_001_HasMet(1) = True
#. SetFlags:
