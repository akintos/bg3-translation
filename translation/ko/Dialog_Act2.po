#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer:c056d99b-93ae-49d7-b8b0-03a80e4ca545
msgctxt "hf0631012g18ecg4387g8800g1e322086c4de"
msgid "Lady Shar's will shall be done. As sure as night will fall."
msgstr "샤 여신의 뜻은 반드시 이루어질 것입니다. 해가 지고 밤이 내리듯이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer
#. Speaker = Shadowheart
#. NodeID = c8ee888d-d13b-43f6-bb3b-ab2d15512cf8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 199a746e-309f-52f0-1a47-0375711725cb_E = True
#. SetFlags:
#.   Global:
#.     - SHA_NightsongPrison_State_FinalPrayer = True
#.   Local:
#.     - 199a746e-309f-52f0-1a47-0375711725cb_F = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer:c8ee888d-d13b-43f6-bb3b-ab2d15512cf8
msgctxt "h6c07faabgc616g41fega8fagecf0b62466c0"
msgid "Cloak me in your shadow. Guide me to your victory."
msgstr "당신의 그림자로 나를 숨기소서. 당신의 승리로 나를 인도하소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer
#. Speaker = Shadowheart
#. NodeID = d2b1cd3c-783c-45b8-8350-e71b0b487218
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 199a746e-309f-52f0-1a47-0375711725cb_B = True
#. SetFlags:
#.   Local:
#.     - 199a746e-309f-52f0-1a47-0375711725cb_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer:d2b1cd3c-783c-45b8-8350-e71b0b487218
msgctxt "he3d352e5g6ee3g4c0bga9a5g55d9cbae0d08"
msgid "I have emptied my hearts of falsehoods."
msgstr "거짓으로 가득 찬 나의 마음을 비웠나이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_FalseNightSpear
#. Speaker = Shadowheart
#. NodeID = 0c7ee04d-c0ab-4c4e-8e25-c1e5941e81cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_FalseNightSpear:0c7ee04d-c0ab-4c4e-8e25-c1e5941e81cf
msgctxt "h7d09e336g21d9g4b79ga43bg0f7ca2a8290f"
msgid ""
"Used by initiates for the final step to becoming Dark Justiciar... not all "
"were worthy of the Spear of Night, it seems."
msgstr "다크 저스티시어가 되는 마지막 시험에서 사용된 창... 모두가 밤의 창을 받을 자격이 있었던 건 아니었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_ShadowfellEntrance
#. Speaker = Shadowheart
#. NodeID = 3329cfea-7cc4-4eab-8b11-c405225f12c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_ShadowfellEntrance:3329cfea-7cc4-4eab-8b11-c405225f12c4
msgctxt "h9100fba2gf132g4b2cg91feg54e0cf242463"
msgid ""
"This must be where initiates undertook their final preparations. The end is "
"near."
msgstr "여긴 입회자들이 마지막 준비를 하는 장소일 거야. 의식의 끝에 가까워지고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_ShadowheartBaptism
#. Speaker = Shadowheart
#. NodeID = 0729a0b1-08a0-46a2-af24-235b81a50601
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_ShadowheartBaptism:0729a0b1-08a0-46a2-af24-235b81a50601
msgctxt "h9d566705ga99fg41ffg85bfg42b3626d23a9"
msgid "Almost there. I will not fail you, my lady."
msgstr "거의 다 왔어. 여신이시여, 당신을 실망시키지 않겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_TauntPlayer
#. Speaker = Nightsong
#. NodeID = 508b69e2-3451-4484-a973-e0cbb75e03cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cf6069c-f0dc-482c-bf10-eea39f59d778_A = True
#. SetFlags:
#.   Local:
#.     - 7cf6069c-f0dc-482c-bf10-eea39f59d778_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_TauntPlayer:508b69e2-3451-4484-a973-e0cbb75e03cd
msgctxt "hcdaba8f2gad67g42dfg877eg59fe0326087c"
msgid "What are you afraid of? Your own wicked heart?"
msgstr "뭘 두려워하고 있는 게냐? 네 자신의 비틀어진 마음을?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_NightsongAttacked
#. Speaker = Nightsong
#. NodeID = 06827347-41cc-4634-9ae2-6ed457e3eec4
