msgctxt "h2d1310e5g42c1g407eg95c7gdf26b4d4442a"
msgid "He seems angry."
msgstr "화난 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 104fbfaa-87d1-af02-04b5-a7a71dd6df28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:104fbfaa-87d1-af02-04b5-a7a71dd6df28
msgctxt "h9dd5ca3cgb21ag41afg8150g8379787cc0de"
msgid "<i>Requiescant in tumultu.</i>"
msgstr "<i>레퀴에스칸트 인 투물투.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 1a998fef-0281-2681-1d17-d00e86e683ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:1a998fef-0281-2681-1d17-d00e86e683ca
msgctxt "h12f93028g1b87g4c58g8f1ag801d774e6f0f"
msgid ""
"The first time I died, it took an army to put me in the ground. What chance "
"do you have?"
msgstr "내가 처음 죽었을 땐, 나 하나 쓰러뜨리겠다고 군대가 동원됐었지. 너에게 승산이 있다고 생각하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 2806cbd6-a894-6172-4d44-92e55a241c8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:2806cbd6-a894-6172-4d44-92e55a241c8c
msgctxt "ha96c450eg9ab4g4ae5g9678gee20716727c3"
msgid "I suppose it doesn't. Z'rell: Kill this fool."
msgstr "상관없는 것 같군. 즈렐, 이 멍청이를 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 3157ce72-cb89-7870-78d7-806bff55d9dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#. SetFlags:
#.   Global:
#.     - MOO_Execution_Event_CombatTransgression = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:3157ce72-cb89-7870-78d7-806bff55d9dc
msgctxt "hc867857cg6a07g4705g855ag144083eab3d8"
msgid "What is your name, True Soul?"
msgstr "네 이름이 무엇이냐, 참된 영혼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 3626990a-e75a-1b8b-8995-af5d29dc8877
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:3626990a-e75a-1b8b-8995-af5d29dc8877
msgctxt "hcb5fdd8cge873g4303g85f7g3cd3bfca4716"
msgid "<i>Mortem amplecteris.</i>"
msgstr "<i>모르템 암플렉테리스.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 6bd5144b-33b3-4ac4-e443-8b49e4362900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:6bd5144b-33b3-4ac4-e443-8b49e4362900
msgctxt "h5bbc0570g9f4eg4684g8817gaa08d088ec1b"
msgid ""
"<i>You. </i>Impossible. You should never have come back here. Z'rell - kill "
"this wastrel."
msgstr "<i>너였나.</i> 믿기지 않는군. 넌 여기로 돌아와서는 안됐어. 즈렐, 이 부랑자를 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 7550bcb4-927d-e357-a3c1-8005418cef5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:7550bcb4-927d-e357-a3c1-8005418cef5c
msgctxt "hb71d8d3cg5a09g44a2g970bg77a2924e0003"
msgid "<i>Ad pulvis.</i>"
msgstr "<i>아드 풀비스.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 78b36698-1ac2-27fe-98ec-ae163873bdf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:78b36698-1ac2-27fe-98ec-ae163873bdf6
msgctxt "h93263109g44c3g4781g9549g0d9257cda925"
msgid "Death comes to all, and all that die come to me."
msgstr "죽음은 모두에게 찾아온다. 그리고 죽은 자들은 내게로 오지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Disciple Z'rell
#. NodeID = 872e37d8-d177-10d9-e560-d6b33db529ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:872e37d8-d177-10d9-e560-d6b33db529ea
msgctxt "h3bb244c3g5701g4c45ga1a0g79e3657387dd"
msgid "With pleasure, General."
msgstr "기꺼이 하겠습니다, 장군님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Player
#. NodeID = 874debd3-3552-3bf7-4b7f-71d96ffd6dd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:874debd3-3552-3bf7-4b7f-71d96ffd6dd3
msgctxt "h3cfe1d18gc59bg4628g963ag87774cedb435"
msgid "I'm called [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = af16d612-a285-90a1-9d0b-f1eeb5bfc3b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:af16d612-a285-90a1-9d0b-f1eeb5bfc3b8
msgctxt "hded6c097gcb60g4692gad6dg6d147c0d5810"
msgid ""
"My army will march. The city will burn. Death's design will be complete."
msgstr "내 군대가 진군하면, 도시는 불탈 것이다. 죽음의 설계가 곧 완성된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = bb097b07-df32-e203-93bc-c6225b5b8f4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:bb097b07-df32-e203-93bc-c6225b5b8f4f
msgctxt "h140fd04dg2d01g423cg804age846ead075e9"
msgid "Funny - you know, I don't know why I asked. Z'rell: Kill this fool."
msgstr "웃기는군, 그래, 나도 왜 물어봤는지 모르겠다. 즈렐, 이 멍청이를 죽여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Player
#. NodeID = bce2133b-ef54-9b40-98f7-d756fe569c36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:bce2133b-ef54-9b40-98f7-d756fe569c36
msgctxt "h566344aeg7966g4fdbga587g740c72b8d782"
msgid "What does it matter?"
msgstr "무슨 상관이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = c825e14f-16b0-b996-091c-8ba65202fbaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:c825e14f-16b0-b996-091c-8ba65202fbaf
msgctxt "h2d630778g41d8g4379gafe8g0f9d8fd4a35b"
msgid ""
"Every battle I fight provides fresh recruits for my army of the dead. Soon, "
"we will be legion."
msgstr "전투를 치를 때마다, 내 망자들의 군대에는 신병이 보충된다. 머잖아 우리는 군단이 될 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Disciple Z'rell
#. NodeID = d594cd10-0c27-2042-4311-8ed9ac77700a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:d594cd10-0c27-2042-4311-8ed9ac77700a
msgctxt "h3480adeag3999g4abfg9e29gaff035c4584e"
msgid ""
"I don't know who you think you are to disturb these proceedings, but I will "
"exact your contrition from your <i>flesh</i>."
msgstr "네놈이 대체 뭐라고 이 집행 절차를 방해하는지는 모르겠다만, 내가 직접 네 <i>육신</i>에서 회개를 끌어내 주겠다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Player
#. NodeID = e8a246c7-adba-2699-22be-da256bc02b7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:e8a246c7-adba-2699-22be-da256bc02b7f
msgctxt "he7e9015aga12ag4b79gb397g583ec09d3298"
msgid "You can call me 'The Death of Ketheric Thorm.'"
msgstr "'케서릭 쏨의 죽음'이라고 불러라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Player
#. NodeID = ea6e08bc-c21a-1a72-1940-5903230bbc1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DARK_URGE(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:ea6e08bc-c21a-1a72-1940-5903230bbc1e
msgctxt "h5da4b6c4g019bg44d5gbd57g5ba3a200215a"
msgid "I'm called [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = f4127a09-f59f-8a02-7555-6e2ab3fa02cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:f4127a09-f59f-8a02-7555-6e2ab3fa02cc
msgctxt "hb8690f64g6943g4d5fga085ga1261ba6134e"
msgid "<i>Spiritus ex sepulcro.</i>"
msgstr "<i>스피리투스 엑스 세풀크로.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption
#. Speaker = Ketheric Thorm
#. NodeID = fb563afa-bd56-6e28-8862-aedb1cecb1e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_CombatInterruption:fb563afa-bd56-6e28-8862-aedb1cecb1e2
msgctxt "hf9e0f34agdd6bg437bg98d1g7e38d67a160a"
msgid "Funny. And sad. Z'rell: Kill this fool."
msgstr "웃기군. 슬프기도 하고. 즈렐, 이 멍청이를 죽여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_DaisyAD_PostExecution
