#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:0104696f-54b9-4b2f-32ab-7827f4d8cbdc
msgctxt "hcf1a2b63gfd9eg4546ga274gec99aab1ee21"
msgid "You are a hunter, like me - swift and true. They'll never catch you."
msgstr "넌 나와 같은 사냥꾼이야. 신속하고 정확하지. 놈들은 널 붙잡지 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 01a67cfc-a52d-9aae-987f-ffe6b7b752d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_Event_StartCaravanEscort = True
#.      - SCL_Drider_State_WaitAtCaravanStart = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:01a67cfc-a52d-9aae-987f-ffe6b7b752d3
msgctxt "h2da74eaagce5dg4c1fgb3e6gf8ff2fe0339c"
msgid "Depends. Why are you here all alone?"
msgstr "아직 모를 일이지. 왜 여기 혼자 나와 있니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 106aa1f6-083e-3178-40a7-cafb7b2775ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:106aa1f6-083e-3178-40a7-cafb7b2775ad
msgctxt "hf1b18628g339bg40f5ga810g834baf856b68"
msgid "You deserve to be beaten. I've never met such a weakling."
msgstr "맞을 만했네. 너 같은 약골은 처음 보거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = 106d2c65-9552-1757-0965-8a60893f4065
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Hyena_Event_Flees = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:106d2c65-9552-1757-0965-8a60893f4065
msgctxt "hfdc4d51dgf477g4df9gba73g376536c9a402"
msgid "*He flees, more terrified of you than the goblins.*"
msgstr "*녀석이 달아납니다. 고블린들보다 당신이 더 두려웠나 봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 11206d54-e1c8-2b08-f226-d954683e8aab
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:11206d54-e1c8-2b08-f226-d954683e8aab
msgctxt "h46eb2cf6gf983g43bag8064g6717f3744817"
msgid "Get out of here, or I'll beat you senseless - stupid mutt."
msgstr "꺼져, 아니면 정신을 못 차릴 정도로 두들겨 패 주지. 멍청한 개새끼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = 127806fc-d30f-4fb1-8049-aef6de97a97d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Hyena_Event_Flees = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:127806fc-d30f-4fb1-8049-aef6de97a97d
msgctxt "h6dbe59b3g034fg4c70gb08ag91577a49f7ad"
msgid ""
"*His voice is filled with determination as he prepares to flee - thankful to "
"have found you, a friend.*"
msgstr "*도망칠 준비를 마친 녀석의 목소리에서 결연한 의지가 느껴집니다. '널 만나 정말 다행이었어, 친구야.'*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 13792e72-08ae-2c5b-e5a9-9983e2ef214d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:13792e72-08ae-2c5b-e5a9-9983e2ef214d
msgctxt "h3f55b1ebg7405g4aa6g9c1eg39d6979568aa"
msgid "Let them try - I am nature's guardian. And I will <i>not </i>back down."
msgstr "어디 마음대로 해 보라지. 나는 자연의 수호자란다. 결코 물러서는 법이 <i>없지</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 15f3a2a0-07d9-4d55-71f9-a868fcb5cd48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:15f3a2a0-07d9-4d55-71f9-a868fcb5cd48
msgctxt "hcceab568g6a86g4704g942dga41c95eab2d1"
msgid "Fine. Stay here then."
msgstr "좋아. 그럼 여기 있으라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 20e6e77c-8b90-4ffc-9c4c-61c6bf29f07e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:20e6e77c-8b90-4ffc-9c4c-61c6bf29f07e
msgctxt "ha360c672ga666g4ddfgb72bg2419d585476b"
msgid "*Bark.*"
msgstr "*컹.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 221d8018-8487-b20a-5007-4e1a12e537ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:221d8018-8487-b20a-5007-4e1a12e537ca
msgctxt "h667c972dg6a3ag41b7gbc1fg89fe46ac6977"
msgid "The goblins left me behind. I'm a bad hyena."
msgstr "고블린들이 날 버렸어. 난 나쁜 하이에나야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 222547c5-30d4-982a-e1f7-25c46c1e1762
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: DRUID or RANGER
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:222547c5-30d4-982a-e1f7-25c46c1e1762
msgctxt "h6103cbf9g2dc5g46fcg9989g88215230e707"
msgid "You belong to the wild, little one. Go and be free."
msgstr "작은 이여, 넌 자연의 일부란다. 자유를 위해 떠나렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = 2539d501-556b-6bf6-7f93-2b96f0492ef3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:2539d501-556b-6bf6-7f93-2b96f0492ef3
msgctxt "h8101ff71g522cg447ag8465gde2772dfcc62"
msgid "*The creature cowers, too afraid to move.*"
msgstr "*하이에나는 두려움에 움직이지도 못하고 움츠러듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = 25c76e63-46f8-4b27-857e-fed1cbadb908
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_State_AnimalHandlingFailed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:25c76e63-46f8-4b27-857e-fed1cbadb908
msgctxt "h32c1af68gd131g451fgbd04g6c47c2745c4e"
msgid "*The hyena shirks from you, afraid.*"
msgstr "*하이에나는 두려움에 당신을 피합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 28310d19-edfd-e608-86f5-f88b30f9a7e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_State_Sad(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:28310d19-edfd-e608-86f5-f88b30f9a7e8
msgctxt "h644a056bg19a3g4efdgbd50g32d32c810cc5"
msgid "Please don't talk to me. Or the goblins will be mad."
msgstr "제발 나한테 말 걸지 마. 고블린들이 화낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 2e71a21d-eb6f-5e15-0345-393569a5fb6a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Hyena_Event_Flees = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:2e71a21d-eb6f-5e15-0345-393569a5fb6a
msgctxt "hc7284284gaa04g40bfg99ccg5a447518feb1"
msgid "Thank you. Goodbye, new friend."
msgstr "고마워. 잘 가, 친구야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 2eb96ead-db8d-8c1b-5879-125b6434c2ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_State_Upset(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:2eb96ead-db8d-8c1b-5879-125b6434c2ba
msgctxt "hb175355cg979ag4e14g97dbg0694b7ea4290"
msgid "Leave me <i>alone.</i>"
msgstr "날 <i>내버려 둬.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 2f876960-86e9-64f8-b9c3-c0ce41eefa7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:2f876960-86e9-64f8-b9c3-c0ce41eefa7e
msgctxt "h42e7436dg1535g4c9cga01fgdea860ccb0e0"
msgid ""
"But - but the goblins said I must stay here. Or they'll cut me. <i>Kill "
"</i>me."
msgstr "하지만- 고블린들이 난 여기 있어야 한다고 했어. 안 그러면 베어 버리겠다고. 날 <i>죽일 거야</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 32a69dff-d25b-2e8b-cf50-ce8c9c7ed9ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:32a69dff-d25b-2e8b-cf50-ce8c9c7ed9ac
msgctxt "h357fd783gf27ag415egb085g48373e48db6e"
msgid "The goblins say I can't be a predator."
msgstr "고블린들이 난 포식자가 될 수 없을 거라고 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 33af5afa-9f5a-d442-e86d-e6848fbec646
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_State_Upset(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:33af5afa-9f5a-d442-e86d-e6848fbec646
msgctxt "h8280651bg1027g4d75g9bb6g3301eb81bf72"
msgid "No, no, they're trying to help me - you're the problem! Get away!"
msgstr "아냐, 아냐, 날 도우려는 거야 - 네가 문제지! 저리 가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 3695e768-3db0-ae21-74f9-a4e3de3198e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:3695e768-3db0-ae21-74f9-a4e3de3198e0
msgctxt "hbf2c6b7bg4514g4965g8993g88e16e7c1219"
msgid ""
"They beat me because I am weak. Because I am soft. Even though I try my best."
msgstr "내가 약해 빠졌다며 두들겨 팼어. 물렁하기 짝이 없대. 난 최선을 다했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = 3b0c0653-9d9a-ad24-9158-d877cb782e96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:3b0c0653-9d9a-ad24-9158-d877cb782e96
msgctxt "hb0b09ccfg159dg43cagb41cg7cd6ebeb50da"
msgid ""
"*The hyena watches you, and the surrounding camp, with eyes burdened by "
"fear. He appears terrified.*"
msgstr "*하이에나가 두려움 가득한 눈빛으로 당신과 주위 야영지를 지켜봅니다. 잔뜩 겁먹은 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 3d8253e8-33dc-c69a-b8bc-2da70ff98012
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_State_AnimalHandlingFailed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:3d8253e8-33dc-c69a-b8bc-2da70ff98012
msgctxt "h6d3875aagad25g4adfg833dg1608e7218da3"
msgid "*Whimper.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 41dd8ea4-617d-4d06-8ffa-51871a9ed558
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:41dd8ea4-617d-4d06-8ffa-51871a9ed558
msgctxt "h447da85fg620eg4571ga20egd6576fa071c4"
msgid "*Bark.*"
msgstr "*컹.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 46165b0f-46b2-2d92-f414-aa45eae468f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_Event_StartCaravanEscort = True
#.      - SCL_Drider_State_WaitAtCaravanStart = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:46165b0f-46b2-2d92-f414-aa45eae468f6
msgctxt "h8c751c44g1388g448eg9222gdedb245bfe79"
msgid "Without the goblins here, you can do whatever you want."
msgstr "고블린들만 사라지면, 넌 뭐든 할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 479b7077-18a3-4911-9460-42ad8ff4a78c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_State_AnimalHandlingSuccess(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:479b7077-18a3-4911-9460-42ad8ff4a78c
msgctxt "h7348bf7dg6c55g46caga1b1g9f25e18b0f6a"
msgid "*Yip.*"
msgstr "*끼잉*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 4b1f4679-1f36-724c-4b89-894aa4437453
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - SCL_EntryPoint_Event_HyenaGoblinScene = True
#.   Local:
#.      - 19c0fac1-22da-332f-a8ec-4dca8dc35951_examinedhyena = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:4b1f4679-1f36-724c-4b89-894aa4437453
msgctxt "hfe7f4942gffc2g4b7egbe62g60b548e4031f"
msgid ""
"You deserve to be out in the wild, not tormented by a goblin with a bone. Go "
"on - go!"
msgstr "넌 저 고블린 놈의 뼈다귀를 피해 야생에서 뛰놀 자격이 있어. 어서, 도망쳐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 4d5ea32a-856a-75c1-9ed6-969c3f9a3d4f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:4d5ea32a-856a-75c1-9ed6-969c3f9a3d4f
msgctxt "hcbac723dgb804g4333gaed0g6505aa867397"
msgid "You belong to the wild, not to the goblins. Go and be free."
msgstr "넌 고블린들이 아니라 자연에 속하는 존재란다. 가서 자유를 되찾으렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 51eb2090-bf45-23bb-e661-fe1164609a2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:51eb2090-bf45-23bb-e661-fe1164609a2e
msgctxt "hae1e0cb1gf496g4644g9704g58365c8f4927"
msgid "Are - are you a friend?"
msgstr "넌... 넌 친구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = 57a0beba-3284-8b17-cce3-7d3cadee017a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 19c0fac1-22da-332f-a8ec-4dca8dc35951_examinedhyena = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:57a0beba-3284-8b17-cce3-7d3cadee017a
msgctxt "hbc8ffa22gc581g4ac2g8070g310bc7ec01a7"
msgid ""
"*Judging by his bowed head, fearful nature, and underweight physique, this "
"hyena is being abused by his goblin owners.*"
msgstr "*숙인 머리, 겁 많은 천성, 저체중의 몸집으로 미루어 짐작컨대, 이 하이에나는 고블린 주인들에 의해 학대받고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 582bab06-2adc-d37e-49cd-26f711b62086
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - SCL_EntryPoint_Event_HyenaGoblinScene = False
#.   Local:
#.      - 19c0fac1-22da-332f-a8ec-4dca8dc35951_examinedhyena = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:582bab06-2adc-d37e-49cd-26f711b62086
msgctxt "he2029f5cg0651g4117g8964gd28927b64377"
msgid "You deserve to be out in the wild, not abused by goblins. Go on - go!"
msgstr "넌 고블린들의 학대를 피해 야생에서 뛰놀 자격이 있어. 어서, 도망쳐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 611dc7d0-d9d6-9b32-d7e3-d87d8df6aba4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:611dc7d0-d9d6-9b32-d7e3-d87d8df6aba4
msgctxt "h388081f2g6390g44a5ga3f0ged94b8dacf07"
msgid "What's this sad act? You're a <i>predator.</i>"
msgstr "왜 이리 찌질하게 굴어? 넌 <i>포식자라고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 68b5eb90-c521-0aa7-bb02-99a3bca3100f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_EntryPoint_Event_HyenaGoblinScene = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:68b5eb90-c521-0aa7-bb02-99a3bca3100f
msgctxt "hfccd46fbg288fg4947g81e0g9dadbee36bac"
msgid ""
"Do you want to be here, boy? If not, you should get out of here. Go on! Go!"
msgstr "여기 머무르고 싶니, 얘야? 아니라면 당장 여길 떠나렴. 어서! 빨리!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 83e0d79d-2f11-3a6d-5737-60ad00d2e0a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_State_Sad(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:83e0d79d-2f11-3a6d-5737-60ad00d2e0a0
msgctxt "h8d1a9121g9ef0g461bgac9bgd141f2cc20d0"
msgid "Sorry..."
msgstr "미안..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 877efcb2-5f52-4bfa-aad6-d3df4008f3b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:877efcb2-5f52-4bfa-aad6-d3df4008f3b1
msgctxt "h8d8212aagf0efg45e4g8e19gf5901100c3f1"
msgid "He... he did? Then I must have been bad."
msgstr "그... 그랬어? 그럼 내가 못된 짓을 저질렀나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 92c32b9f-716a-e2c9-8f76-90df71c9c126
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:92c32b9f-716a-e2c9-8f76-90df71c9c126
msgctxt "h41221199g5119g444fga018g5c730a565b12"
msgid "I'll slit their necks if they so much as try."
msgstr "그랬다간 내 칼에 모조리 도륙 나고 말걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = 99bffe99-93a9-5432-7404-3058b46550fd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:99bffe99-93a9-5432-7404-3058b46550fd
msgctxt "h5477f02bg6adcg46d0g8a84g9daf8594fcd0"
msgid "If not now, when? Go on - while you still can."
msgstr "지금이 아니면 기회는 없어. 어서 이곳을 떠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = 9fc33b63-5f4a-ba97-4e5e-b796f35b916a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:9fc33b63-5f4a-ba97-4e5e-b796f35b916a
msgctxt "he2e5a97cgfc31g456ag82dfg3cef2affee20"
msgid "*Bark!*"
msgstr "*컹컹!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = a702cb50-68df-e7f3-cb17-ee415f10942e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - SCL_EntryPoint_Event_HyenaGoblinScene = True
#.   Local:
#.      - 19c0fac1-22da-332f-a8ec-4dca8dc35951_examinedhyena = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:a702cb50-68df-e7f3-cb17-ee415f10942e
msgctxt "h754b4e9cg9fc6g4663ga6c6gb559d57fdc49"
msgid ""
"You deserve to be out in the wild, not tormented by a goblin with a bone. Go "
"on - go!"
msgstr "넌 저 고블린 놈의 뼈다귀를 피해 야생에서 뛰놀 자격이 있어. 어서, 도망쳐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = b050ced0-65f2-97df-c962-97c06802ab72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:b050ced0-65f2-97df-c962-97c06802ab72
msgctxt "h277cb9a5geb1ag4356gb0c4ge6b982c32fb0"
msgid "You would fight the goblins? For <i>me?</i>"
msgstr "고블린들이랑 싸울 생각이야? <i>날</i> 위해서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = b8df2b62-a654-1879-a81b-b8f60987417f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:b8df2b62-a654-1879-a81b-b8f60987417f
msgctxt "h93d53e50g1c74g4430g8940g93209b6d27cf"
msgid ""
"I - I'm scared. But I don't want them to hurt me anymore. Maybe I should "
"go..."
msgstr "무... 무서워. 하지만 여기 남아 괴롭힘당하고 싶진 않아. 떠나는 게 좋겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = baf8f1cb-4c41-42d2-9c7d-b644dd2336c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 19c0fac1-22da-332f-a8ec-4dca8dc35951_examinedhyena = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:baf8f1cb-4c41-42d2-9c7d-b644dd2336c8
msgctxt "hc0036905g37cdg4d32g85dbg6f3a4b1a6ab3"
msgid "<i>Examine the animal.</i>"
msgstr "<i>동물의 행동을 조사한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = bb76720b-c4f7-5ad9-91f8-dd0c2d855ac9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:bb76720b-c4f7-5ad9-91f8-dd0c2d855ac9
msgctxt "haa3b51d8g69abg415ag86f3g521705b47185"
msgid ""
"I could never! I do what the goblins tell me - I want to be a good hyena."
msgstr "그럴 수 없어! 난 고블린들이 시키는 대로 할 거야. 착한 하이에나가 되고 싶다구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = bd0f13e5-06ac-4ebd-8639-be954db05060
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:bd0f13e5-06ac-4ebd-8639-be954db05060
msgctxt "h0e788da1g5fb2g4bd4g9e8dg9408fe71a1c6"
msgid "I could never be friends with such a pathetic creature."
msgstr "한심한 짐승 따위랑 친구 먹긴 힘들겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = cd1fee85-7b32-47cb-8789-61c4ee8a388a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_State_AnimalHandlingFailed(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:cd1fee85-7b32-47cb-8789-61c4ee8a388a
msgctxt "hbc351bf2g78dcg48fagbb82ge205a2e6e64e"
msgid "<i>Hold out your hand, letting it sniff.</i>"
msgstr "<i>냄새를 맡을 수 있도록 손을 내민다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = cd5c1995-78a3-fa74-95da-b0afd392ac8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:cd5c1995-78a3-fa74-95da-b0afd392ac8f
msgctxt "h32e749a8g5496g4f91g95d5gc67d34c7c0ad"
msgid ""
"That makes me happy. I like the goblins, but the goblins... don't like me."
msgstr "그거 기분 좋아. 난 고블린들 좋아하는데, 고블린들은... 내가 싫은가 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = cf08c01d-4e73-8562-737d-7ebe44c1af47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:cf08c01d-4e73-8562-737d-7ebe44c1af47
msgctxt "hc5165da0g0621g448ag9a7cga95fc0ffa4d9"
msgid "*For a moment, it appears the hyena's fear is too great, but then...*"
msgstr "*하이에나는 잠시 공포에 짓눌리지만, 어느 순간 갑자기...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = d0c84e4c-c92d-441d-4488-23ef0f40e90c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_State_Sad(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:d0c84e4c-c92d-441d-4488-23ef0f40e90c
msgctxt "hb2607a5dg6fbfg4a68g8272g75430dcfd0b6"
msgid "No, no it's too risky. I can't - I <i>can't.</i>"
msgstr "아, 안 돼. 너무 위험해. 난 못 가. <i>못 간다구.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Narrator
#. NodeID = d0f35344-5436-4fe7-ab25-37f47524dd28
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_State_AnimalHandlingSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:d0f35344-5436-4fe7-ab25-37f47524dd28
msgctxt "h9d685d2agf17bg43dfg8a83gd2868c40d113"
msgid "*The hyena brightens, cautiously pleased.*"
msgstr "*하이에나가 조심스럽게 기뻐하며, 낯빛이 밝아집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = d22a221d-9961-432d-ba48-e2a80d08afab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:d22a221d-9961-432d-ba48-e2a80d08afab
msgctxt "hd1bb4c2eg6a74g4b31gae4dg7b17267e98d6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = e38dc11a-df4f-4bd1-952d-38ff7e18664d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:e38dc11a-df4f-4bd1-952d-38ff7e18664d
msgctxt "h32513c62g80a8g4ca3g842dgcc46aebd4998"
msgid "You'll be a good boy for the Absolute, won't you?"
msgstr "절대자 님을 잘 섬기겠구나, 착한 아이 같으니. 안 그러니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = e67b8a78-fe9f-41e3-add7-435559e0e438
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_State_Upset(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:e67b8a78-fe9f-41e3-add7-435559e0e438
msgctxt "hdf7e94dcg01c8g414bgb276g5552ccf00390"
msgid "Oh..."
msgstr "오우..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = e68fa6fc-1e61-444f-a054-98bf7198e13a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_HasMet_SpeakWithAnimals(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_HasMet_SpeakWithAnimals(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:e68fa6fc-1e61-444f-a054-98bf7198e13a
msgctxt "h696a1b10g78a1g4119gb7eeg85d31c4dd9db"
msgid "*Whine.* I don't know your smell."
msgstr "*끼잉.* 너 낯선 냄새 나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = e69d4325-2ed1-40c9-8ba3-5f3abbca2436
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_EntryPoint_Event_HyenaGoblinScene = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:e69d4325-2ed1-40c9-8ba3-5f3abbca2436
msgctxt "he04492f1g46f1g4603g853agf82a971d5dd5"
msgid ""
"I'm more of a friend than the goblin with the bone. You know he tried to "
"kill you?"
msgstr "저 뼈다귀 든 고블린보다야 나은 친구지. 놈이 널 죽이려 했다는 거 알고 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = ee77284a-1a9d-479f-ad84-324e82222617
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_HasMet_SpeakWithAnimals(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:ee77284a-1a9d-479f-ad84-324e82222617
msgctxt "h101a2e05g92e6g49d2gb3c9g10c0d574a8b5"
msgid "You came back? Am I - are you a friend?"
msgstr "돌아왔어? 내가 너의... 우리 친구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = f014c3c5-a1fd-344f-9cb5-1075f282de1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_Event_StartCaravanEscort = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:f014c3c5-a1fd-344f-9cb5-1075f282de1c
msgctxt "h706b3602g5349g4ce4gbfb5ge3a0d83cce25"
msgid "Fight back. Hurt the goblins like they hurt you."
msgstr "맞서 싸워. 놈들이 널 괴롭혔으니 똑같이 갚아 주라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = f13378c1-3c49-a29c-50b6-8b50b961f25b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:f13378c1-3c49-a29c-50b6-8b50b961f25b
msgctxt "he267ee84gb4c2g4c64gb498g9752f7372f3e"
msgid "You're right. The goblins are cruel."
msgstr "네 말이 옳아. 고블린들은 잔인해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = f1ca18be-5b62-4b5b-8ce3-0fda9e9ff948
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:f1ca18be-5b62-4b5b-8ce3-0fda9e9ff948
msgctxt "hbe3c599bgd523g4e55g89b7g79324365d37e"
msgid "Of course I am."
msgstr "물론이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Player
#. NodeID = f5ae2d82-abac-4ebb-a826-ceaf7846275b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:f5ae2d82-abac-4ebb-a826-ceaf7846275b
msgctxt "hbe72dccagabceg45bfgba0fg4c4f1e283a66"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena
#. Speaker = Hyena
#. NodeID = fa2a73e8-2d17-4de8-9884-80885399f6b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Hyena_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_Hyena_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena:fa2a73e8-2d17-4de8-9884-80885399f6b8
msgctxt "h7e5da835g2d0fg4908g9104g1d89c101f15c"
msgid "*Whine.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD
#. Speaker = Hyena
#. NodeID = 291e7598-8616-4f9e-80d1-814a7c15299b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 04b27924-92c3-9347-991f-ff7e116d80fb_A = True
#. SetFlags:
#.   Local:
#.     - 04b27924-92c3-9347-991f-ff7e116d80fb_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD:291e7598-8616-4f9e-80d1-814a7c15299b
msgctxt "h875ba33cg2adfg4237ga199g941dfa46b39b"
msgid "*Snarl.*"
msgstr "*으르렁*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD
#. Speaker = Hyena
#. NodeID = 844c1b2a-8d6d-4fca-ab65-a88272543171
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 04b27924-92c3-9347-991f-ff7e116d80fb_B = True
#. SetFlags:
#.   Local:
#.     - 04b27924-92c3-9347-991f-ff7e116d80fb_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD:844c1b2a-8d6d-4fca-ab65-a88272543171
msgctxt "he96596b1g0cc8g4aa3gab81gf8d4a7374378"
msgid "*Grrr.*"
msgstr "*그르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD
#. Speaker = Hyena
#. NodeID = d827b23d-d3c4-4ccd-aef8-949947b418b1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 04b27924-92c3-9347-991f-ff7e116d80fb_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD:d827b23d-d3c4-4ccd-aef8-949947b418b1
msgctxt "h028f21f4g9637g481agbb37gc5706a917a5e"
msgid "*Sniff sniff.*"
msgstr "*킁킁 킁킁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD
#. Speaker = Hyena
#. NodeID = f66122d7-f9ce-47fa-95eb-2d576b38e57c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 04b27924-92c3-9347-991f-ff7e116d80fb_C = True
#. SetFlags:
