#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_NightsongAttacked:06827347-41cc-4634-9ae2-6ed457e3eec4
msgctxt "hb6d9dc60g592ag4a0aga15bg4be3d9bec248"
msgid "Unleash your wrath! It only fuels my fury."
msgstr "분노를 쏟아내라! 내 격노에 불을 지필 뿐이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_TauntPlayer
#. Speaker = Nightsong
#. NodeID = 8f59ca10-fa20-4c22-8de1-e74e1f396971
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
