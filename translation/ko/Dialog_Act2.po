msgctxt "h94331493gbb83g4966g9a3cgc84b4604e0bf"
msgid "Grggg - gng - nng..."
msgstr "그륵 - 끙 - 읍..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Player
#. NodeID = 009d808e-d04f-3b38-ade3-ec2f94cd7cbc
