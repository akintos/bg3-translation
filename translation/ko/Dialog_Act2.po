msgctxt "hc4420f74gd7d0g4df1ga9a9g2960a80fb43d"
msgid "Must be Arabella's father. Poor man. Hope he rests in peace."
msgstr "아라벨라의 아버지가 분명해. 불쌍한 사람. 편히 잠들길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Locke
#. NodeID = e5d3dbdb-4b01-4e88-8ba7-1b10d268b770
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:e5d3dbdb-4b01-4e88-8ba7-1b10d268b770
msgctxt "h7dad4c57gfdf9g402bg8c71g03a15fc902c0"
msgid "Ran... into... shadows..."
msgstr "그림자...속으로...달려갔다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Astarion
#. NodeID = e7a023c5-ffd4-4eb1-9b89-9bcadc472ddc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_RecognisedParents = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:e7a023c5-ffd4-4eb1-9b89-9bcadc472ddc
msgctxt "h76185d30g24a4g40abgb70egaa1b25a29821"
msgid ""
"Arabella's father. First the druids, now this - our little idol thief has no "
"luck at all."
msgstr "아라벨라의 아버지야. 처음엔 드루이드와 한바탕 하고, 이젠 이런 일을 당하다니... 우리 우상 도둑 꼬마는 운이라곤 없구먼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Narrator
#. NodeID = e947ecd5-9865-4c1a-a112-7b069efeb5b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:e947ecd5-9865-4c1a-a112-7b069efeb5b2
msgctxt "h497ef9b8gabb5g4d91g9c0fg331ef053e74e"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Locke
#. NodeID = ea189e45-fdc9-4424-b74e-b47e72a491fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:ea189e45-fdc9-4424-b74e-b47e72a491fc
msgctxt "hed3b2a5eg898bg49c9g9ed5g15f6332b9a1d"
msgid "Surgeon... sisters..."
msgstr "의사...수녀들..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Wyll
#. NodeID = ee012ecf-3560-9c5b-3625-256ea7f9bc3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_RecognisedParents = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:ee012ecf-3560-9c5b-3625-256ea7f9bc3e
msgctxt "h5061259egc40ag4214g95d8gd8528fefc70c"
msgid "The tiefling's seen better days. Arabella's father, I wager."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Narrator
#. NodeID = fa0ff30a-8ed7-420d-9052-fae42ecf923d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:fa0ff30a-8ed7-420d-9052-fae42ecf923d
msgctxt "h929ae3eegdf62g49e9g9836gf91538d166a0"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Shadowheart
#. NodeID = fbd5ab3c-927f-a5be-ce4e-8d46e169f2e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_RecognisedParents = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:fbd5ab3c-927f-a5be-ce4e-8d46e169f2e0
msgctxt "h367e3225g4e6eg4bc7g8329g640848252e91"
msgid ""
"A tiefling. That's Arabella's father, I wager - or <i>was </i>Arabella's "
"father."
msgstr "티플링. 아라벨라의 아버지야, 확실해, 아버지 <i>였던 것</i>이든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead
#. Speaker = Player
#. NodeID = fc0f2490-781c-ff40-fecf-c0a32fd8a02a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsSceneStarted = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ParentA_Dead:fc0f2490-781c-ff40-fecf-c0a32fd8a02a
msgctxt "h6605779eg7656g4a60gb46fg66ef4d7a2af2"
msgid "Remind me - who are you?"
msgstr "당신이 누구였는지 말해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 00d84c28-4472-59c8-fe9d-8258a2e904f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:00d84c28-4472-59c8-fe9d-8258a2e904f2
msgctxt "ha607fc38g7f62g4f33gb93egfcd895230401"
msgid "I'll think about it. My hands are full with these cultists."
msgstr "생각해 볼게. 사교도들 때문에 바빠서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 04d65ed4-0dce-21c0-3546-76091cf78ec1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_ToldParentsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:04d65ed4-0dce-21c0-3546-76091cf78ec1
msgctxt "h96947a0bg1ec0g42b3g8cd8g37d492a39e25"
msgid "You lie! They're out there. And if you won't find 'em, I will!"
msgstr "거짓말! 저기 있는 게 분명한데. 당신이 안 하겠다면, 내가 갈 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 0541f67f-cee9-e839-875d-78e02d886ab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:0541f67f-cee9-e839-875d-78e02d886ab1
msgctxt "he2897a53gc22cg4601g8b95gdeaebaf2d8bc"
msgid ""
"You're trying to scare me... to see if I'm tough enough to make it out there."
msgstr "지금 이거 겁주려고 하는 소리죠... 이 바깥에서 살아남을 수 있는지 보려고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Shadowheart
#. NodeID = 05928ac8-3010-66f6-6452-4c9a5ea71b4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:05928ac8-3010-66f6-6452-4c9a5ea71b4c
msgctxt "h6b17c081g7763g4dd7g8305g0d61ae022c84"
msgid "Isn't that Arabella? The little girl Kagha nearly killed?"
msgstr "아라벨라 아니야? 카그하가 거의 죽이려고 했던 여자애?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 05f54c92-ecb8-b8df-171d-1d2d7dd42b27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:05f54c92-ecb8-b8df-171d-1d2d7dd42b27
msgctxt "h3fb1008bgfa0eg4d67ga763ge7d07286d5f8"
msgid "You're going to get yourself killed. I'll find them, all right?"
msgstr "그러면 넌 죽게 될 거야. 내가 모셔올게, 그럼 됐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Lae'zel
#. NodeID = 0697689c-b04f-0187-9a26-192e29266f8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:0697689c-b04f-0187-9a26-192e29266f8d
msgctxt "hac9eb2c2g619ag4533gad13ga8c2b96848b7"
msgid "Impressive. Last I saw this child, she was cowed to Kagha's snake."
msgstr "인상적이군. 마지막으로 저 애를 봤을 땐 카그하의 뱀 때문에 겁에 질린 모습이었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 096a0af2-51b4-9e26-f182-01e85832343a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:096a0af2-51b4-9e26-f182-01e85832343a
msgctxt "h7296c904g218fg485fg9431gb07b5b13f847"
msgid "Tell you what - I'll teach you the vine trick. Maybe some others."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 09c3cd27-6550-4e11-895a-26a774d22c80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ae7cdec0-d910-909b-ac90-f536300a1602_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:09c3cd27-6550-4e11-895a-26a774d22c80
msgctxt "h674ec941g7d26g4678ga736g163686ef4585"
msgid ""
"Your parents are with you always, in memory. Join my camp, let me help you."
msgstr "네 부모님은 언제나 네 곁에 계실 거야, 기억 속에서 말이지. 내 야영지에 오렴. 널 돕게 해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 0c299c26-9d1c-10cb-b19f-6f329625ab20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:0c299c26-9d1c-10cb-b19f-6f329625ab20
msgctxt "hfc635a4fg8347g4b02ga4f3g6eea2fb8cf15"
msgid "You do that, kid."
msgstr "그래라, 꼬마야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 0df94c73-ce81-1c62-9994-0717ac57df9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:0df94c73-ce81-1c62-9994-0717ac57df9a
msgctxt "h16490b43gb444g4062gae16gf29355d4a939"
msgid "I'd be more impressed if you'd actually killed it."
msgstr "정말로 죽였다면 더 감명받았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 127160c8-e77a-7edb-e69e-99251e67024c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:127160c8-e77a-7edb-e69e-99251e67024c
msgctxt "h491bb04ag13beg49efgb1b9g775dd5e48afd"
msgid ""
"People die, and that's that. You can stay in my camp, if you quit your "
"blubbering."
msgstr "사람은 죽어. 그게 다야. 징징대는 걸 그만두겠다면 내 야영지에서 머물러도 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 156e8d3d-80e6-4eaf-ef85-220c827ec88c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_BothParentsDead = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:156e8d3d-80e6-4eaf-ef85-220c827ec88c
msgctxt "h8879a79dga9e3g430ag8025g1fd16099e519"
msgid "I was just poking at the rancid dog-meat of your parents' corpses."
msgstr "방금 막 썩은 개밥이 된 네 부모 시체를 쑤셔보고 오는 길인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 163689f5-5d42-4b96-8da1-9290db1e2b2a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ae7cdec0-d910-909b-ac90-f536300a1602_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:163689f5-5d42-4b96-8da1-9290db1e2b2a
msgctxt "h9eaf5766gb7d2g4184gac6agb9b91187f383"
msgid "<i>Pops can't be dead. He said he'd never leave me, no matter what.</i>"
msgstr "<i>아빠가 죽었을 리 없어. 무슨 일이 있어도 내 곁에 있겠다고 했는걸.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 1b12a1b6-2e6f-b957-93fc-f92bffa04456
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ParentsFoundDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:1b12a1b6-2e6f-b957-93fc-f92bffa04456
msgctxt "h8394b580g7104g4627g8636gb711e19adba7"
msgid "Arabella? You should be with your parents."
msgstr "아라벨라? 부모님 옆에 있어야 하지 않니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Astarion
#. NodeID = 211f985b-a64f-e4d3-4bae-5c5525d6bfea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:211f985b-a64f-e4d3-4bae-5c5525d6bfea
msgctxt "h8440459eg4fbag4225gb341gf733cc2634ca"
msgid ""
"I do like her spirit. I don't like her chances, but her spirit? Excellent."
msgstr "쟤의 태도가 마음에 들어. 살아남을 확률은 별로 없겠지만, 기백만큼은 끝내주는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 239529b6-e387-4b65-8ba6-06a3f6c04f52
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - ae7cdec0-d910-909b-ac90-f536300a1602_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:239529b6-e387-4b65-8ba6-06a3f6c04f52
msgctxt "hc683611cgabc8g45cdg8af0g12cef758b016"
msgid "<i>Detect Arabella's thoughts.</i>"
msgstr "<i>아라벨라의 생각을 읽는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 26713ded-2355-7833-db39-68b729dd932c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedToLearn(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:26713ded-2355-7833-db39-68b729dd932c
msgctxt "h2d7031ceg6b18g4b8dgb917gb8580f511c89"
msgid "And then you'll teach me those powers of yours?"
msgstr "그렇게 하면 네 힘을 나한테도 가르쳐 줄 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 294ac4ab-d60d-45ca-5ea1-53e576979f46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingArabella = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:294ac4ab-d60d-45ca-5ea1-53e576979f46
msgctxt "hc6579b45ga6c4g41c8gb10dg4f9507ea4b18"
msgid "'Specially since mum and pops - After Zevlor - When he -"
msgstr "특히나 지금 엄마랑 아빠가... 제블로어가... 그때..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Lae'zel
#. NodeID = 2c7235ca-3e64-c1e4-6f03-54089b554f75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:2c7235ca-3e64-c1e4-6f03-54089b554f75
#, fuzzy
msgctxt "h1ce95f99g4b01g41e8gb2b7g8a7f9a672aef"
msgid ""
"Capricious child. She almost got herself killed once. Seems she's intent on "
"finishing the job."
msgstr "변덕스러운 꼬마 녀석. 한 번은 죽을 고비를 넘겼지만, 결국은 끝장을 보려고 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 2ec12f38-73db-317c-c60b-0f7187c52961
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedToLearn(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:2ec12f38-73db-317c-c60b-0f7187c52961
msgctxt "h5a66c06dge6aag420cga62ag756d39ae772e"
msgid "And how much gold will you give me in return?"
msgstr "그 대가로 금은 얼마나 줄 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 2f6f6b19-cc28-570f-b15b-bd9765e468d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:2f6f6b19-cc28-570f-b15b-bd9765e468d7
msgctxt "he509654cg85b6g461dgba88gde82369e40f1"
msgid "Of course. You can stay in my camp."
msgstr "물론이지. 내 야영지에 머물러도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 2f704fb6-3eff-626a-e5ec-6270a8896556
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:2f704fb6-3eff-626a-e5ec-6270a8896556
msgctxt "h8d4fb861g9f68g4635g8f3fg3d9fcd5ad8ee"
msgid "What are you doing out here? It's not safe."
msgstr "여기서 뭐 하는 거니? 여긴 위험해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 2fdaa357-fd61-b718-9ce2-0382ec378367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:2fdaa357-fd61-b718-9ce2-0382ec378367
msgctxt "h60e78891g7504g460dgb2f8gaf8a23f7e1aa"
msgid "Forget it, kid. You can take care of yourself, from the looks of it."
msgstr "잊어버려라, 꼬마야. 보아하니 넌 혼자서도 충분히 살아갈 수 있겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 34c89dbc-c292-6324-0d4d-bb70f5963644
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_BothParentsDead = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_ResistedUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:34c89dbc-c292-6324-0d4d-bb70f5963644
msgctxt "hb4c71477g7fe3g4420g8d06g106800607704"
msgid "<i>Muster some kindness for once. Offer her shelter.</i>"
msgstr "<i>일말의 친절을 베푼다. 아이에게 야영지를 알려준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Astarion
#. NodeID = 35016962-166a-6145-0782-678b353b8336
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:35016962-166a-6145-0782-678b353b8336
msgctxt "hf979b919g4858g4d31g8de8g33e3ccf926c2"
msgid "Pity, I kind of liked her. Oh well."
msgstr "안타깝네, 꽤 마음에 드는 애였는데. 어쩌겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 3770f9e6-65a3-0d31-c6ed-d0f129a5c9c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_BothParentsDead = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:3770f9e6-65a3-0d31-c6ed-d0f129a5c9c9
msgctxt "h5557fb15g8b79g4a60gb259g74552c198f7b"
msgid ""
"I've rarely seen corpses as violated as theirs are - it was quite the sight."
msgstr "그만큼 박살 난 시체는 드문데. 네 부모는 제법 볼만한 광경이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 3887d381-d12c-d50c-cb3b-241641956788
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_ArabellaPowers_State_StayedAtTown = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:3887d381-d12c-d50c-cb3b-241641956788
msgctxt "h1d11c963g0ad0g4ab2g9852ga5540534e545"
msgid "Hmph!"
msgstr "흥!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Karlach
#. NodeID = 3ee3d0aa-c9ae-cad4-c307-f796afb5e0c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:3ee3d0aa-c9ae-cad4-c307-f796afb5e0c5
msgctxt "hba04bcc5gfa1bg4393g98adg34f1651de591"
msgid ""
"Hey! That's Arabella. Kid from the druid's grove. That snake woman nearly "
"did her in. Looks like she's learned a thing or two."
msgstr "이봐! 저기 아라벨라잖아. 그 뱀 여자가 거의 해칠 뻔했던 꼬맹이. 보아하니 한두 가지를 새로 배운 모양인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 3fa89fab-1434-e899-a6ea-6359d97cc397
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:3fa89fab-1434-e899-a6ea-6359d97cc397
msgctxt "hd6db64fdg5e0bg4d91ga92cgcd6221550d84"
msgid ""
"Nature's magic only grows stronger with age, little one. Learn to control it "
"now, while you still can."
msgstr "자연의 마법은 시간이 갈수록 강력해질 거란다, 꼬마야. 아직 가능할 때 그 마법을 통제하는 법을 배워 놔야 해. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 42f3ba69-852e-8e08-ff15-91d42e06917a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = False
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Dialog:
#.     - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:42f3ba69-852e-8e08-ff15-91d42e06917a
msgctxt "h6e784f56g9ba9g4ba1g9f1eg64e701f5ed7d"
msgid "You've learnt magic like my own, child. Who taught you druidcraft?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 442d8c0f-f7f7-44cb-b957-07904dc9cae5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:442d8c0f-f7f7-44cb-b957-07904dc9cae5
msgctxt "h259a6fbcg2056g4040g833fga2a34e185fce"
msgid ""
"You're right. If I do something stupid and end up dead, there'll be nobody "
"to remember them."
msgstr "맞는 말이네요. 내가 바보짓을 해서 죽어버리면 엄마 아빠를 기억해 줄 사람이 없어지겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Narrator
#. NodeID = 4920c097-ae17-943f-26fc-09ac93fd5475
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:4920c097-ae17-943f-26fc-09ac93fd5475
msgctxt "ha641aa6fga1edg4f37g98dcg4e7b89110d1c"
msgid ""
"*You notice the girl shivering in fear and anger. She is not yet ready to "
"hear the truth of her parents' fate.*"
msgstr "*당신은 아이가 공포와 분노로 떨고 있는 것을 알아차립니다. 아직 부모님의 운명에 대한 진실을 들을 준비가 되지 않았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Wyll
#. NodeID = 49c61575-bec4-7cbb-14af-853eb321a6e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.      - Approval_AtLeast_0_For_Sp2(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:49c61575-bec4-7cbb-14af-853eb321a6e0
msgctxt "h40419be0g7961g4f1cgabd0g9b2ca4f9d823"
msgid ""
"Sending a child out there to die? Damned spiteful. Figured you better than "
"that."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 4a84b2ec-2cf3-e7b2-3b65-19e7676f93f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:4a84b2ec-2cf3-e7b2-3b65-19e7676f93f9
msgctxt "hb7f7a9dag9742g4fd4gacedg3d23a0c2d83d"
msgid "Yeah. All right. If that's what I gotta do."
msgstr "그래요. 알았어요. 그래야 한다면요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 4a8b9905-def2-8fc4-b81e-a363372f721a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:4a8b9905-def2-8fc4-b81e-a363372f721a
msgctxt "hf6e6a3eeg8965g4babg9b30gbe2663349704"
msgid "Mm. Maybe. But you gotta help me first."
msgstr "음. 그럴까요. 하지만 날 먼저 도와줘야 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 4ceba03f-c380-2083-dc7c-f1f6416d7163
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:4ceba03f-c380-2083-dc7c-f1f6416d7163
msgctxt "h504279fbg2c7bg4276gbc70gc59c4749a254"
msgid "I'm telling the truth: you don't want to find them."
msgstr "내가 진실을 말해주지. 넌 네 부모를 찾고 싶지 않은 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 51566e63-eafb-11aa-1e8b-0e51e21f3d81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:51566e63-eafb-11aa-1e8b-0e51e21f3d81
msgctxt "hb94a0328gc30ag462ag896ag8614f927b2f3"
msgid ""
"The vines won't last forever. I don't - I don't s'pose I can stay with you?"
msgstr "이 덩굴들이 언제까지나 유지되진 않을 거예요. 저, 저도 같이 다니면 안 돼요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 5974e97f-2202-4550-da89-417079d2efaf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_ParentsFoundDead = True
#. SetFlags:
#.   Global:
#.     - TWN_ArabellaPowers_Event_AskedForHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:5974e97f-2202-4550-da89-417079d2efaf
msgctxt "hf86736a8g4eb4g4e89gbd62gbb9a02f6cff1"
msgid ""
"Still can't find 'em - but I bet you can. You'll help me, I just know it!"
msgstr "아직도 어디에 있는지 모르겠어요. 하지만 당신은 찾을 수 있을 거예요. 도와줄 거죠, 그냥 알아요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 599f9e1c-5eca-273d-b278-741f1b94794c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_BothParentsDead = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_ResistedUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:599f9e1c-5eca-273d-b278-741f1b94794c
msgctxt "h3f6b0983ge3d6g4684g9235g3003e66252a7"
msgid "<i>Suppress your delight in her parents' death. Offer her shelter.</i>"
msgstr "<i>아라벨라의 부모가 죽었다는 사실에 기뻐 들뜬 마음을 억누른다. 아이에게 피난처를 제공한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 5c231c28-0f6f-a19f-59f2-6cccc3e9acc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:5c231c28-0f6f-a19f-59f2-6cccc3e9acc7
msgctxt "h1bbf78e0ga616g4ad9gac28gdfa50f21c3e0"
msgid "Well. There was an ambush. Mum yelled 'run!' So we ran."
msgstr "그러니까. 습격이 있었어요. 엄마가 \"도망쳐!\" 하고 소리쳤죠. 그래서 도망쳤어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 606a5379-2d63-987b-4478-09e81a53b85b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:606a5379-2d63-987b-4478-09e81a53b85b
msgctxt "hc5ac9509g4b5bg4959ga80ag14748e79e7b1"
msgid "I think real hard and say some loud words and then it happens. Mostly."
msgstr "엄청 집중해서 뭔가 큰 소리로 단어를 말하면 되더라고요. 대부분은요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 6234e613-069c-edff-2a71-453e7fa03a6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:6234e613-069c-edff-2a71-453e7fa03a6d
msgctxt "h5f4b3d15g5636g4b83gababg99fa75bec91c"
msgid "I could hear 'em running behind me. 'Til I couldn't."
msgstr "엄마랑 아빠가 절 따라 달리는 소리를 들었어요. 나중엔 들리지 않았지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 62a759bf-f319-0015-deb5-53099ae8a1e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:62a759bf-f319-0015-deb5-53099ae8a1e0
msgctxt "h66df28d9g942dg447eg9f86g58a3ef7acbfc"
msgid "Good. To the hells with you."
msgstr "좋아. 당신은 지옥에나 떨어지라지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 67ffd70f-0356-0c52-4634-6224c577c2bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = False
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Dialog:
#.     - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:67ffd70f-0356-0c52-4634-6224c577c2bb
#, fuzzy
msgctxt "hbf0f484ag7fb1g4db8gac8fged226164fc9e"
msgid "You've learnt magic like my own, child. Who taught you druidcraft?"
msgstr "나와 같은 마법을 배웠구나, 꼬마야. 누가 너에게 드루이드의 기술을 가르쳐 주었니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 69d6c765-78ca-ccb1-d01d-f3eac2241703
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:69d6c765-78ca-ccb1-d01d-f3eac2241703
msgctxt "haa47812ag36e3g482aga6a8g67a92934aa01"
msgid ""
"You're right. If I become strong, they will look on me with pride from "
"beyond."
msgstr "당신 말이 맞아요. 내가 강해지면 분명 엄마 아빠도 하늘에서 날 자랑스럽게 여길 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 6a0fa48b-b26a-5542-024a-d9788bbb22e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = False
#.   Tag:
#.      - WIZARD(1) = True
#. SetFlags:
#.   Dialog:
#.     - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:6a0fa48b-b26a-5542-024a-d9788bbb22e6
msgctxt "ha9e60b7eg5906g4206g94e4g7f335ff55cd6"
msgid "And no wonder. You could hurt yourself with magic that wild."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 6b64f0dd-d133-c00b-2542-c18726c65306
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingArabella = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:6b64f0dd-d133-c00b-2542-c18726c65306
msgctxt "he455d74cg5611g45cbg9514g58c32866fabb"
msgid ""
"That's who I'm looking for. Mum and pops, I mean. When Zevlor - when he -"
msgstr "찾고 있어요. 그러니까 엄마 아빠 말이에요. 제블로어가... 그때..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 6e0b7306-2423-8870-a6c7-53770774e5d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:6e0b7306-2423-8870-a6c7-53770774e5d9
msgctxt "ha4717ccag24c5g4fcbgb343gced4bf506a88"
msgid "All right. I'll go to the camp, like you said. Just..."
msgstr "알았어요. 야영지로 갈게요. 그냥..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 71f785a0-da01-b88c-cd8f-3e0fddda1f76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingArabella = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:71f785a0-da01-b88c-cd8f-3e0fddda1f76
msgctxt "h849650e6gb4cfg4125gb2feg84bea7a36ac2"
msgid "Me and mum and pops, we followed Zevlor out here. Then he - he -"
msgstr "저는 엄마, 아빠와 함께 제블로어를 따라서 왔어요. 그리고... 그리고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = 72163836-ca42-d2ee-be3d-d038cf6d91f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_ArabellasPowers_State_BothParentsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:72163836-ca42-d2ee-be3d-d038cf6d91f3
msgctxt "h1ff81f4dg318ag4379g8a7cgea9a1e377766"
msgid "Their corpses, maybe. Your parents are dead."
msgstr "시체는 찾을 수도 있겠지. 네 부모는 죽었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 73237657-764c-4b92-c6be-8137347d11b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:73237657-764c-4b92-c6be-8137347d11b9
msgctxt "h7c964f33ge3b4g49a3g86e2gcd2615abf945"
msgid "I don't think so. I'm good. Well, kinda good."
msgstr "그럴 것 같진 않아요. 전 괜찮거든요. 뭐, 그럭저럭 괜찮아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 74ba5ed9-3366-e9b6-7936-bb0892b4c571
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_ArabellaPowers_State_MovedToCamp = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:74ba5ed9-3366-e9b6-7936-bb0892b4c571
msgctxt "he64ffc65gf0a5g4284g8849g49b9a4b1261c"
msgid "So you send mum and pops <i>there</i>. I'll be waiting, hero-man!"
msgstr "엄마와 아빠를 <i>거기로</i> 보내주세요. 기다리고 있을께요, 영웅 아저씨!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 74ba5ed9-3366-e9b6-7936-bb0892b4c571
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_ArabellaPowers_State_MovedToCamp = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:74ba5ed9-3366-e9b6-7936-bb0892b4c571
msgctxt "h44e9427agcfa8g42b8g8cd6g60df2a73ce51"
msgid "So you send mum and pops <i>there</i>. I'll be waiting, hero-lady!"
msgstr "엄마와 아빠를 <i>거기로</i> 보내 주세요. 기다리고 있을게요, 영웅 언니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Arabella
#. NodeID = 74ba5ed9-3366-e9b6-7936-bb0892b4c571
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
