msgctxt "h1e66908cgede7g4d8fgb901ga8503a9bfecb"
msgid ""
"Plucked from Kagha's talons, only to run to the shadows. Fickle, the both of "
"you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
