msgctxt "hd520e111g9139g4c97gb540g676def7e076e"
msgid "Good. We'll leave soon - and we don't want any surprises."
msgstr "좋아. 곧 여기를 뜰 테니 예상치 못한 상황이 없어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Jaheira
#. NodeID = 4053c04f-b071-4b44-8e0e-33504ea6bf3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_JaheiraReport:4053c04f-b071-4b44-8e0e-33504ea6bf3c
msgctxt "h1077e011g7d8cg4767g8929g3fa3980419b9"
msgid "Find out who it is. And bring them to me."
msgstr "누군지 찾아내서 내 앞으로 데려와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Harper Callie
#. NodeID = 426a8aa8-e57e-4376-a092-b97f7ce186f4
