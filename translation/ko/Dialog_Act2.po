msgid "I'll end you!"
msgstr "끝장을 내주마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HavenOutcasts_AD_Combat_HarperQuartermaster
#. Speaker = Quartermaster Talli
#. NodeID = 7321f706-16cc-4ba5-91e1-b234d3ca5989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HavenOutcasts_AD_Combat_HarperQuartermaster:7321f706-16cc-4ba5-91e1-b234d3ca5989
msgctxt "hc6a8000ag64a8g42b4g9fbfgb0090fc8877d"
msgid "Get back in the trash pile where you belong!"
msgstr "네가 온 쓰레기 더미로 돌아가라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HavenOutcasts_AD_Combat_RoofWatcher_Caster
#. Speaker = Harper Terradissia
#. NodeID = 8b4d892c-d59c-4863-ab77-05df832cd848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HavenOutcasts_AD_Combat_RoofWatcher_Caster:8b4d892c-d59c-4863-ab77-05df832cd848
msgctxt "h178d7af3ga2e5g463ag8320ge32a69262fea"
msgid "Stay back!"
msgstr "물러서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_FlamingSpy_IsobelCombat_000
#. Speaker = Fist Marcus
#. NodeID = 2b750200-546f-4327-b777-312d7fafcd4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_FlamingSpy_IsobelCombat_000:2b750200-546f-4327-b777-312d7fafcd4d
msgctxt "h2f673673g2050g4f82ga857gb429404d68f0"
msgid "Come along, Isobel."
msgstr "이소벨, 같이 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_FlamingSpy_IsobelCombat_001
#. Speaker = Fist Marcus
#. NodeID = f72722d8-33e6-4c7b-842f-dc08c3c67a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_FlamingSpy_IsobelCombat_001:f72722d8-33e6-4c7b-842f-dc08c3c67a68
msgctxt "h7906d79egc302g4944ga789g4d99b2641228"
msgid "General Ketheric wants her alive - at any cost!"
msgstr "케서릭 장군께서 저 여자를 살려서 데려오길 원하신다! 무조건!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_FlamingSpy_IsobelCombat_002
#. Speaker = Fist Marcus
#. NodeID = 7c09281a-9190-4af4-942f-9b7c4e45d45f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_FlamingSpy_IsobelCombat_002:7c09281a-9190-4af4-942f-9b7c4e45d45f
msgctxt "hc41b6e8cgd692g475eg8be4gc550cb60b414"
msgid "The General will be pleased if you go quietly."
msgstr "얌전히 따라온다면 장군께서 흡족해 하실 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_IsobelCombat_000
#. Speaker = Jaheira
#. NodeID = 85de47d3-c0c7-48b0-8993-f2afb6b13dd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_IsobelCombat_000:85de47d3-c0c7-48b0-8993-f2afb6b13dd0
msgctxt "h44f4be8ag2669g4fb2g9226g31b7572915e0"
msgid "If Isobel falls, we all die."
msgstr "이소벨이 실패한다면, 우리는 모두 죽는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_IsobelCombat_001
#. Speaker = Jaheira
#. NodeID = cf8351ae-796e-40d0-9f93-80e256d95b0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_IsobelCombat_001:cf8351ae-796e-40d0-9f93-80e256d95b0f
msgctxt "h60c9edf8gd00bg4459g8aebgce05d258cfca"
msgid "Get these monsters <i>out</i>!"
msgstr "이 괴물들을 <i>쫒아내라</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_IsobelCombat_002
#. Speaker = Jaheira
#. NodeID = ef29ff2a-53be-4e0e-8c93-f8e76572af12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_IsobelCombat_002:ef29ff2a-53be-4e0e-8c93-f8e76572af12
msgctxt "h95ff4cb5g3ab6g43a3gafb9g3c83e87ef83b"
msgid "Rout the Absolute's poison from this place."
msgstr "절대자가 이 땅에 뿌린 독을 몰아내야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_SiegeCombat_000
#. Speaker = Jaheira
#. NodeID = e9454c75-d921-46f8-8a85-adeeff1a8b26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_SiegeCombat_000:e9454c75-d921-46f8-8a85-adeeff1a8b26
msgctxt "hecb0ca57g7917g408dgb8e3g10fb40fb041a"
msgid "This fight is winnable. Do not stop!"
msgstr "이길 수 있는 싸움이다. 멈추지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_SiegeCombat_001
#. Speaker = Jaheira
#. NodeID = 48158398-3d03-427e-83f2-2d52749f9f98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_SiegeCombat_001:48158398-3d03-427e-83f2-2d52749f9f98
msgctxt "h85559aa2ga88bg4248ga56dgd592d5d59f89"
msgid "These shades are nothing to Those Who Harp."
msgstr "하프를 연주하는 이들에게 이까짓 그림자는 아무것도 아니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_SiegeCombat_002
#. Speaker = Jaheira
#. NodeID = 362635a5-4f48-4a1a-b24e-cb60849fe2db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Haven_AD_Jaheira_SiegeCombat_002:362635a5-4f48-4a1a-b24e-cb60849fe2db
msgctxt "h44b04348g11b5g4252gba47g9ca9d1e145eb"
msgid "If we fall, the Absolute wins!"
msgstr "우리가 실패한다면, 절대자 교단이 승리하는 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 0052e7c9-c456-53c8-62af-d61c4fa1c4a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Isobel_NightsongFreedHasmet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:0052e7c9-c456-53c8-62af-d61c4fa1c4a1
msgctxt "h97f76504gf3b4g4677gbf60g58856f913413"
msgid "Moonmaiden protect and guide you."
msgstr "달처녀께서 그대들을 보우하시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 028f4450-1d84-b6da-dd82-56d6de9d3beb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:028f4450-1d84-b6da-dd82-56d6de9d3beb
msgctxt "hdbd65438g46fbg403egb028gf9dc4e028f63"
msgid "End this. Now. We're all counting on you."
msgstr "이제 끝장내줘. 우리 모두 너를 믿고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 0619739d-11f5-b397-bc88-dc306180a6f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:0619739d-11f5-b397-bc88-dc306180a6f5
msgctxt "h4716ea1egde15g4274g9d4agfb091798516b"
msgid ""
"Curious though you may be, if you're an enemy to Ketheric, you can take your "
"rest here."
msgstr "넌 좀 특이한 사람인 것 같긴 해. 하지만 케서릭의 적이라면 여기서 쉬고 가도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 072d043e-9947-d973-5fa6-336a8a06f603
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:072d043e-9947-d973-5fa6-336a8a06f603
msgctxt "hea5bf37cg0132g41deg9309ga7a0e50e5207"
msgid ""
"Our fighting forces led by the Harpers have gone straight to the Towers to "
"face Ketheric down."
msgstr "하퍼들이 이끄는 우리 병력은 케서릭 쏨과 맞서기 위해 바로 타워로 향했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 08965cee-9534-0eae-ce54-92850b7bdceb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:08965cee-9534-0eae-ce54-92850b7bdceb
msgctxt "h2fce355egfa00g4cc8g98efg8153ed75e1e9"
msgid "Could be entertaining."
msgstr "그것도 재밌겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 090f4098-c3bb-b9a4-d9de-b14259728b80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_MentionedKethericAlready = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:090f4098-c3bb-b9a4-d9de-b14259728b80
msgctxt "hd8bcc193gcf7cg4ebega182g94224ac39650"
msgid ""
"I have news about Ketheric. I've been tasked with retrieving something "
"important to him - seems like a good lead."
msgstr "케서릭에 관한 소식이 있어. 그자한테 중요한 무언가를 나보고 회수해오라고 하더라고. 큰 건을 잡은 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 09726fd4-48b7-8f05-76d7-9f22a3549c62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:09726fd4-48b7-8f05-76d7-9f22a3549c62
msgctxt "h0e6eb081gad36g475cg8ad0g63d2411edc8e"
msgid "BASH YOU! EAT YOU! FLAY! <i>FLAY!</i>"
msgstr "부숴버릴 거야! 먹어버릴 거야! 가죽을! <i>도려낼 거야!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 09d25d26-8af3-68a3-bbee-7132639b6476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:09d25d26-8af3-68a3-bbee-7132639b6476
msgctxt "h39a5ef52g8929g41aaga9cbg5cf321b19a7c"
msgid "I can't believe there's an end in sight. <i>Thank </i>you."
msgstr "드디어 끝이 보인다니 믿을 수 없어. <i>정말</i> 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 12dbd4e6-4692-89bb-1024-5ace01aad9f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:12dbd4e6-4692-89bb-1024-5ace01aad9f1
msgctxt "hb09ac670g0ee8g4a46g8da5g1f2642350f72"
msgid "It was a team effort."
msgstr "그건 모두가 노력한 덕분이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 1515b7ae-85b3-811e-a311-eb7ae12f33d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:1515b7ae-85b3-811e-a311-eb7ae12f33d3
msgctxt "h31677225g4284g4b2bg9c30g817f8ce227cf"
msgid "Why don't you go yourself?"
msgstr "직접 가볼 생각은 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 16b5f994-6f6b-339f-7f4d-ed96d353d2e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:16b5f994-6f6b-339f-7f4d-ed96d353d2e7
msgctxt "h226fc170g9383g4fe9g8f61ge43b36cd136d"
msgid ""
"That was quite the feat. It'd be hard enough to get into the Towers "
"unshackled, much less getting back out."
msgstr "그건 대단한 일이었어. 붙잡히지 않고 타워에 들어가기도 어려울 텐데, 나오는 것도 만만치 않았을 것 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 19b5db50-5ab1-63bf-5d0c-39fe80796d73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:19b5db50-5ab1-63bf-5d0c-39fe80796d73
msgctxt "hedad357fge0c5g445fg8c29ga0101691f928"
msgid ""
"I saw them flying - the path of light. They seemed headed straight for "
"Moonrise Towers."
msgstr "나도 그 빛의 길을 봤어. 그건 문라이즈 타워로 향하는 것 같았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 1b329ff9-2af7-922a-264b-4541ddcaab6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:1b329ff9-2af7-922a-264b-4541ddcaab6e
msgctxt "hf1e2e49ag76bbg4a8aga3e2gee2d58716f53"
msgid ""
"*Her breath catches; you notice a barely-perceptible shudder run through her "
"body.*"
msgstr "*그녀의 숨소리가 멈칫합니다. 당신은 그녀의 몸이 겨우 알아볼 정도로 떨리는 것을 알아챕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 1b40d911-5301-e475-3092-19728558ffcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:1b40d911-5301-e475-3092-19728558ffcf
msgctxt "h394983f0g64ccg4f2fga4f0gb700ae293edd"
msgid ""
"An immortal. But... it couldn't possibly be... never mind. It doesn't "
"matter. What matters is you have him in a corner."
msgstr "불멸자라. ...그럴 리가 없을 텐데... 아니야. 상관없어. 중요한 건 케서릭을 궁지에 몰아넣었다는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 1c478508-a13a-bb97-9e2a-f6c08bfe17c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:1c478508-a13a-bb97-9e2a-f6c08bfe17c2
msgctxt "h96969544gf574g4859g8e2ag0833b64e3d5e"
msgid "Let things begin again, as long as you keep the peace in Last Light."
msgstr "네가 이곳의 평화를 깨트리지 않는다면, 처음부터 다시 시작하는 걸로 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 1ca0a0ed-b32a-e63b-ab5e-c920360c2042
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:1ca0a0ed-b32a-e63b-ab5e-c920360c2042
msgctxt "h4fe619a2g6612g49b2gb2c5gbf4caae28652"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 20deba9e-5b39-c26b-080d-b7a538fc3e84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:20deba9e-5b39-c26b-080d-b7a538fc3e84
msgctxt "h223a54c7ga19dg480ega122g101529fe0a69"
msgid "*The moment you even began to think of it, it was already over.*"
msgstr "*당신이 생각을 시작하자마자, 그것은 이미 지나가 있었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 24abea92-ff2d-b9eb-3335-acfb3ae91ac3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:24abea92-ff2d-b9eb-3335-acfb3ae91ac3
msgctxt "hec06b5cbgbb74g441dgbcdbgc2d21435b488"
msgid ""
"*Her breath catches; you notice a barely-perceptible shudder run through her "
"body.*"
msgstr "*그녀의 숨소리가 멈칫합니다. 당신은 그녀의 몸이 겨우 알아볼 정도로 떨리는 것을 알아챕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 24d13bcb-cdad-52e1-2bd1-c13c8251b248
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:24d13bcb-cdad-52e1-2bd1-c13c8251b248
msgctxt "hff69f0b3gc587g4a54gbac9g971962b3a3f8"
msgid ""
"Sometimes life forces us to choose sides. Luckily, sometimes the choice is "
"obvious."
msgstr "때때로 삶은 우리에게 한쪽 편을 들라고 종용하지. 운 좋게도, 때때로 그 선택은 자명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 2645ae35-1a0c-9fa0-40e8-5ac3110e1d96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:2645ae35-1a0c-9fa0-40e8-5ac3110e1d96
msgctxt "hde949539gbd35g4230g8897g8df8da136d9a"
msgid ""
"I'm the one who freed the aasimar who carved a path of light through the "
"shadow curse."
msgstr "그림자 저주 사이로 빛의 길을 낸 아시마르를 구출한 사람이 바로 나야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 29360b45-8e7d-3505-7796-b2fd4e93ae3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SHAR(1) = False
#.      - CLERIC_SELUNE(1) = False
#.      - PALADIN_SHAR(1) = False
#.      - REALLY_SHADOWHEART(1) = False
#.      - PALADIN_SELUNE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:29360b45-8e7d-3505-7796-b2fd4e93ae3d
msgctxt "hcc3fd707g376bg40d3ga190gddff8e58b856"
msgid "I'm not overly familiar with Selûne and Shar. Could you enlighten me?"
msgstr "내가 셀루네와 샤에 대해서 아주 잘 아는 건 아니어서 말이야. 가르쳐 줄 수 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 375fdc23-5cd8-7846-1863-6f722ad08e48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:375fdc23-5cd8-7846-1863-6f722ad08e48
msgctxt "h3167d8dega5c6g4527ga00ag458f2668f4c1"
msgid ""
"*There is something about her... it would be wonderful to kill her. A "
"perfect tragedy.*"
msgstr "*그녀에게 무언가를 느낍니다... 죽여버리면 아주 환상적이겠군요. 완벽한 비극입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 379d4cf9-f8e8-5543-3fa7-c71eb800b4b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Isobel_HasMetPrisonersSaved(1) = False
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Isobel_HasMetPrisonersSaved(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:379d4cf9-f8e8-5543-3fa7-c71eb800b4b8
msgctxt "h72960a08g99a9g4b13g8ea4gd795d817b4fb"
msgid ""
"You did well to help those people escape Ketheric. Every soul saved is a "
"blessing, and you're raining them upon us."
msgstr ""
"그들이 케서릭으로부터 벗어날 수 있도록 도운 건 잘한 일이야. 구원된 모든 영혼은 축복이며 너로 인해 우리 모두는 축복받은 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 37e10f45-cec7-dec9-8f96-a3135af96411
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:37e10f45-cec7-dec9-8f96-a3135af96411
msgctxt "h0029d4f1ga7a1g4a2ag924cg07ec35288793"
msgid ""
"Like most things in life. My thanks to your team. You work well together."
msgstr "대부분의 일들이 그렇지. 너와 네 동료들에게 감사를 표할게. 일 처리가 훌륭한걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 38a0befe-388c-1f66-a8c3-8fa1c0ced5f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:38a0befe-388c-1f66-a8c3-8fa1c0ced5f4
msgctxt "hd8e7b4abg1fbbg44deg8d54g35997420becc"
msgid "<i>Attack her. The Urge aches for it.</i>"
msgstr "<i>공격한다. 충동이 당신을 들쑤신다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 398c23c4-5313-ff49-ecaa-7e24d1789349
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:398c23c4-5313-ff49-ecaa-7e24d1789349
msgctxt "h41c950degdf2fg4212gb734g33d4f5eb6b64"
msgid "May we be lucky enough to see many more."
msgstr "우리가 그런 일들을 더더욱 많이 볼 만큼 운이 좋기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 3a2bb926-3b7b-22ae-2c84-12daffa0bd76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:3a2bb926-3b7b-22ae-2c84-12daffa0bd76
msgctxt "hedef2833gbca5g47a8gb5dcg2249ee8bae0e"
msgid "Call me mad, but I believe you."
msgstr "미쳤다고 해도 좋아. 그래도 난 널 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 3d213474-5934-17da-355f-bba1fc7a10af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:3d213474-5934-17da-355f-bba1fc7a10af
msgctxt "h9bc22bf5g88f2g4bbcg8edeg1aec811fb832"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 3f7b144b-4b1c-1715-985e-4800cece0af5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:3f7b144b-4b1c-1715-985e-4800cece0af5
msgctxt "h27155c33g47cfg4fbcg8cd9g238ef8b1fd0c"
msgid ""
"True enough. I won't keep you - but I'm glad to see these people looking so "
"well."
msgstr "정곡을 찌르는걸. 더 이상 붙잡진 않을게. 그래도 이 사람들이 멀쩡한 것을 보니 너무 기뻐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 3fba11e7-02e5-0dc8-11a5-1349ae452105
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:3fba11e7-02e5-0dc8-11a5-1349ae452105
msgctxt "h4a7db544gcfe9g4394g96c4g11f0f4a712e5"
msgid "I could ask you the same."
msgstr "나도 같은 걸 물어보려 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 4008a4ec-a172-03a6-cbfe-d12bf12848a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:4008a4ec-a172-03a6-cbfe-d12bf12848a8
msgctxt "he60c9875g0658g49degbdefge56709f2425b"
msgid "Not yet, but I think I'm on the right track."
msgstr "아직. 그래도 곧 뭔가 나올 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 417f6280-6226-4ca0-2190-faeb9436121d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:417f6280-6226-4ca0-2190-faeb9436121d
msgctxt "h50cec203gf925g4646gb4d2g928e9125d193"
msgid "I am going to save these lands. I- I mean you no harm."
msgstr "난 이 땅을 구원하려 해. ㄴ- 너에게 해를 끼칠 생각은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 43696d8c-33a1-749e-edca-221de44bd184
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:43696d8c-33a1-749e-edca-221de44bd184
msgctxt "h5d9788aagd25dg465dga5bag073bd1901494"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 48b9e608-718e-202a-3c07-0679be6e129d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:48b9e608-718e-202a-3c07-0679be6e129d
msgctxt "h7b85c896g0361g45bcgba2cgf8da51e94dbe"
msgid "Whoever she is, she's got a serious bone to pick with Ketheric."
msgstr "그녀가 누구든, 케서릭에게 따질 게 많은 모양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 4b94ac7a-2b41-2597-516f-1e2670a2ca0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Jaheira_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:4b94ac7a-2b41-2597-516f-1e2670a2ca0b
msgctxt "h9d6cd0c0g5a67g48a4ga349g9b009b5df880"
msgid ""
"Jaheira and every fighting body in this place have gone to Moonrise Towers "
"to face Ketheric down. She's waiting for you there."
msgstr "자헤이라를 비롯한 모든 전투 인원들이 케서릭을 물리치기 위해 문라이즈 타워로 향했어. 거기서 기다리고 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 4e15857e-494c-e129-5e06-ffca91db7229
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:4e15857e-494c-e129-5e06-ffca91db7229
msgctxt "hd574da8aga408g4966gab7eg296ca21c8ea4"
msgid "You'll know when I've found anything."
msgstr "뭔가를 찾게 되면 너도 알게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 55e6799b-a047-1530-adc8-db0e045647b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:55e6799b-a047-1530-adc8-db0e045647b1
msgctxt "hdf15f3ddg3b2fg42dcg9a1fg97f1e4c1b847"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 5681e1b9-4bf1-0e92-0b0d-a0222745ce4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5681e1b9-4bf1-0e92-0b0d-a0222745ce4f
msgctxt "h96452d46g3af0g403dg8495gbcea1ed31b5c"
msgid ""
"An unfortunate coincidence. I hope never to meet the wicked man who "
"haemorrhaged shadows over this peaceful village. I pray only for his end."
msgstr ""
"이름이 같다니 유감스러운걸. 이 평화로운 마을을 그림자로 난도질한 사악한 사람과는 절대 만나지 않고 싶어. 그자가 끝장나기를 기도할 "
"뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 57c2b85a-063f-27a9-512c-4de2e9486c3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Isobel_AskedHerAboutKethericDaughter(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:57c2b85a-063f-27a9-512c-4de2e9486c3d
msgctxt "h15256755g9323g4133g8841g7a02cc74fba5"
msgid ""
"Isobel. I found the empty sarcophagus of an Isobel Thorm - Ketheric's "
"daughter."
msgstr "이소벨. 케서릭의 딸인 이소벨 쏨의 비어있는 석관을 발견했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 584115e5-1e05-0339-bfe9-943e4a5e9361
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:584115e5-1e05-0339-bfe9-943e4a5e9361
msgctxt "h1aeed55agdfe6g450eg87d4g1568c70f6504"
msgid ""
"Right place, right time. When a cleric of Selûne stumbles into a Sharran "
"shadow, she's bound to set it to rights - at any cost."
msgstr ""
"알맞은 때에, 알맞은 장소로 온 거야. 셀루네의 클레릭이 샤의 그림자와 맞닥뜨리면, 그걸 올바르게 돌려놔야 할 의무가 생기거든. 어떤 "
"대가를 치르더라도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 588d17ad-0ba0-4ac0-e448-ae8d4e40d410
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:588d17ad-0ba0-4ac0-e448-ae8d4e40d410
msgctxt "hd2c44331g294fg4996g80b5g78db90b64bb7"
msgid ""
"I'm the one who freed those prisoners from Moonrise and brought them here."
msgstr "문라이즈에 갇혀있던 사람들을 탈출시켜 이곳으로 인도한 사람이 바로 나야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 5a5cb190-48a7-2f93-438b-5d4d358e8b82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Isobel_AskedHerAboutKethericDaughter(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5a5cb190-48a7-2f93-438b-5d4d358e8b82
msgctxt "hf4a8df97g2f42g4432gaa31g4398340d1413"
msgid ""
"Isobel. I found the empty sarcophagus of an Isobel Thorm - Ketheric's "
"daughter."
msgstr "이소벨. 케서릭의 딸인 이소벨 쏨의 비어있는 석관을 발견했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 5ae2ece9-951b-bff3-0756-304cf28ed6b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5ae2ece9-951b-bff3-0756-304cf28ed6b4
msgctxt "hab20c70bgf818g4d5ag8fdfg75447dce2c65"
msgid "I'm cursed with spells of madness, forgive me what I said."
msgstr "난 광기를 불러오는 저주에 걸려 있어. 내가 했던 말들에 대해서 사과를 구할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 5b88b1c2-9fd3-6dfd-1006-368ad48eab0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5b88b1c2-9fd3-6dfd-1006-368ad48eab0c
msgctxt "h18e656e1gfe7bg4ed5g95b3g435d0c5004b9"
msgid "In fact, I'm the one who set her free."
msgstr "사실, 내가 풀어준 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 5bb4cb11-85fd-9d37-28ce-f6ff7cb77b19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5bb4cb11-85fd-9d37-28ce-f6ff7cb77b19
msgctxt "h9348d06eg0ca7g4756gbbccg81075e97e66f"
msgid ""
"An unfortunate coincidence. I hope never to meet the wicked man who "
"haemorrhaged shadows over this peaceful village."
msgstr "이름이 같다니 유감스러운걸. 이 평화로운 마을을 그림자로 난도질한 사악한 사람과는 절대 만나지 않고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 5bb4d46c-3cc1-6724-1838-7371702cf453
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5bb4d46c-3cc1-6724-1838-7371702cf453
msgctxt "he771bec2g2ac5g46b6gac6bg4ebb345446ac"
msgid ""
"*Her breath catches; you notice a barely-perceptible shudder run through her "
"body.*"
msgstr "*그녀의 숨소리가 멈칫합니다. 당신은 그녀의 몸이 겨우 알아볼 정도로 떨리는 것을 알아챕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 5c762e8d-0dac-6bd3-bf63-83b8c79d2b78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Isobel_NightsongFreedHasmet(1) = False
#.   Global:
#.      - HAV_IsobelGaveOintment = True
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Isobel_NightsongFreedHasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5c762e8d-0dac-6bd3-bf63-83b8c79d2b78
msgctxt "h0dead82ag7d3fg405fgbcd0g5dad51687dab"
msgid ""
"There you are. What's happening out there? Who was that, streaking across "
"the sky?"
msgstr "너구나. 밖에서 무슨 일이 벌어지고 있는 거야? 하늘을 가로지르는 저 사람은 누구고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 5f5abf1c-a022-c561-4c77-75183c3b48af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:5f5abf1c-a022-c561-4c77-75183c3b48af
msgctxt "ha783b17cg958ag4af7g9f96gb28cd81496de"
msgid "I won't let that happen."
msgstr "그런 일이 발생하도록 두지는 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 6067752a-b739-9318-222d-e2081c51b2f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:6067752a-b739-9318-222d-e2081c51b2f3
msgctxt "h1713ed3eg3b76g4d11ga70eg894ca3c3bea5"
msgid "That's fantastic. Well done."
msgstr "굉장해! 잘했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 62484dc7-e66b-9c87-85e1-b6a9951468c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:62484dc7-e66b-9c87-85e1-b6a9951468c9
msgctxt "hc85a2b82g455dg4baagb109gbe8bd48d9382"
msgid ""
"*The Urge within does not want to talk. The restless Urge starts to scream.*"
msgstr "*내면의 충동은 대화를 원하지 않습니다. 쉼 없는 충동은 비명을 지르기 시작합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 63a31892-bb53-564e-30c9-44290b87c2a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Isobel_HasMetDefault(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_Isobel_KidnappingQuestions_DarkUrge(1) = True
#.     - HAV_Isobel_HasMetDefault(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:63a31892-bb53-564e-30c9-44290b87c2a9
msgctxt "h14ebb04cg140cg45edg996ag71fcc5f1182b"
msgid ""
"On with you. Unless you want to come back to a gaggle of shadow-cursed "
"Harpers."
msgstr "듣고 있어. 네가 그림자 저주에 먹힌 하퍼들에 대해 다시 조잘거리고 싶은 게 아니라면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 6b3c9069-239e-06b4-71b4-23d56a117fd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:6b3c9069-239e-06b4-71b4-23d56a117fd9
msgctxt "h247dc38ag9787g4f32ga84egac295bcbea22"
msgid ""
"This could all be over soon. If you can lend a hand at the Towers, I hope "
"you will."
msgstr "이 모든 게 곧 끝날 수 있어. 네가 타워 쪽에 힘을 빌려준다면 말이야. 난 네가 그럴 거라고 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 6d82244a-7904-636c-ada9-b58262d6ae93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:6d82244a-7904-636c-ada9-b58262d6ae93
msgctxt "h0327a7bagae84g4dd3g8c69gb38ea11a2b1e"
msgid ""
"There we are. The <i>real </i>you. Your - affliction, is it? - doesn't rule "
"you, does it."
msgstr "돌아왔구나. <i>진짜</i> 네가. 너의... 병? 맞지? 그건 너를 규정하지 못해. 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 6e856995-02f8-5982-1269-f826dabb2db6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Isobel_AskedHerAboutKethericDaughter(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:6e856995-02f8-5982-1269-f826dabb2db6
msgctxt "h77938a97gb7a3g43efg9673ga8b5d7e5d86d"
msgid ""
"Isobel. I found the empty sarcophagus of an Isobel Thorm - Ketheric's "
"daughter."
msgstr "이소벨. 케서릭의 딸인 이소벨 쏨의 비어있는 석관을 발견했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 6e9e5762-7b54-e01d-92d9-3cc9d2bb7cab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:6e9e5762-7b54-e01d-92d9-3cc9d2bb7cab
msgctxt "h92f05768g7d82g4aa4g8989g398de371778b"
msgid "Almost laughable, that he sees himself fit to judge anyone."
msgstr "웃겨 죽겠는걸. 스스로가 누군가를 재판할 깜냥이 된다고 보다니 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 6eb4ea37-aa5d-a2a2-9060-71f603940a63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_IsobelKillOrder = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:6eb4ea37-aa5d-a2a2-9060-71f603940a63
msgctxt "hba9c73cdgc8f0g4034g9c3bg37db1a86bcbe"
msgid ""
"*This is the one Sceleritas sent you to kill. Every scrap of your marrow "
"yearns to end her.*"
msgstr "*스클레리타스가 죽이라고 한 사람이 바로 이 사람입니다. 골수 조각 하나하나가 그녀를 끝장내기만을 갈망하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 6ee78bcc-a2d9-ed9f-96ad-f478a49dcf21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:6ee78bcc-a2d9-ed9f-96ad-f478a49dcf21
msgctxt "h830f518eg3399g49f2gb7ebg77f144d6ab2f"
msgid "I don't know much about you. Care to fill in the blanks?"
msgstr "너에 대해 잘 몰라. 그 빈 부분을 좀 채워봐도 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 71059487-0aa6-197a-8d8d-37138c5d1bdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:71059487-0aa6-197a-8d8d-37138c5d1bdd
msgctxt "h097ef29fg2c15g4d9ag9cffgb38b5deef3f7"
msgid "<i>Retreat into your mind. Fester in the Urges.</i>"
msgstr "<i>마음속으로 침잠합니다. 충동 속에서 부대낍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 7256ca6d-063a-e4c6-45ff-8cba02c2a433
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = True
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_MentionedKethericAlready = False
#.   Object:
#.      - HAV_Isobel_Event_MentionedKetheric(1) = False
#. SetFlags:
#.   Local:
#.     - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_MentionedKethericAlready = True
#.   Object:
#.     - HAV_Isobel_Event_MentionedKetheric(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:7256ca6d-063a-e4c6-45ff-8cba02c2a433
msgctxt "heb64407bg20c0g48c2g84a7g741802ca9f4f"
msgid "I saw Ketheric at Moonrise Towers. He was presiding over a trial."
msgstr "문라이즈 타워에서 케서릭을 봤어. 재판을 주재하고 있던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 741952d7-dee4-2abe-bfc7-75eda5f21eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFateDecided = True
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:741952d7-dee4-2abe-bfc7-75eda5f21eeb
msgctxt "h2a65dd88g27acg4378gbbdeg8b401898725e"
msgid ""
"I found the source of Ketheric's immortality - an immortal from whom he "
"draws power. She's been taken back to Moonrise Towers."
msgstr "케서릭의 불멸성의 근원을 찾았어. 어떤 불멸자로부터 힘을 끌어오고 있던데. 그녀는 문라이즈 타워로 이송됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 78b354e3-0fd1-3083-afb7-847902f4e87d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:78b354e3-0fd1-3083-afb7-847902f4e87d
msgctxt "h37d77abbgf68dg4091ga7e6g168903a5f728"
msgid "And yet you hesitate."
msgstr "그리고 넌 아직 주저하고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 79159bfd-282a-01db-f9cc-9e106ba7b540
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:79159bfd-282a-01db-f9cc-9e106ba7b540
msgctxt "h526e2882g325ag44d3ga292gcfaa2bea9f09"
msgid ""
"*She doesn't believe you will do it. You can see, she wants to believe there "
"is mercy in all, even in the worst.*"
msgstr ""
"*그녀는 당신이 저질러버릴 것이라고는 생각하지 않습니다. 모든 상황, 심지어 최악의 상황에서도 자비가 있을 것이라 믿는 것 같군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 79464405-1e1b-e21a-39d9-e838b91fc381
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:79464405-1e1b-e21a-39d9-e838b91fc381
msgctxt "h7c73466cg5777g44f6gb067g81102e50ec9a"
msgid "My blood... it's telling me to kill you."
msgstr "내 피가... 너를 죽이라고 하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 79ac954e-772f-421e-86d9-f0d5386f2f84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:79ac954e-772f-421e-86d9-f0d5386f2f84
msgctxt "hf5e284cfgd830g41ddga100gba3179bff010"
msgid ""
"That's incredible news. I won't ask for specifics as to how you uncovered "
"that... but I'm grateful you've done whatever it takes."
msgstr "그거 대단한 소식인데. 어떻게 알게 됐는지 자세한 건 묻지 않겠지만... 무엇이었든 간에 그걸 해냈다는 데에 감사함을 느껴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 7a88731a-77c0-e8f8-0f7c-fc063785ec4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:7a88731a-77c0-e8f8-0f7c-fc063785ec4f
msgctxt "h9bf485e4g4507g422dg9500ga33fd718a6ec"
msgid ""
"Rest here, if you need. Then finish this. None of us will be safe while "
"Ketheric is alive."
msgstr "필요하다면 쉬다 가. 그러고는 마무리를 내. 케서릭이 살아있다면 우리 중 누구도 안전하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 7ad0b8c2-4ab3-f276-bf33-46f137874231
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:7ad0b8c2-4ab3-f276-bf33-46f137874231
msgctxt "h6b3939ceg2dcag426ega47cg084538b72a03"
msgid ""
"Though if it were my place to ask why she let Ketheric turn; why she allowed "
"this village to rot at his hands - believe me, I would."
msgstr ""
"물론 내가 만약 왜 케서릭이 변절하도록 두었는지, 왜 이 마을이 그의 손아귀에서 썩어가게 내버려 두었는지 여쭤볼 수 있는 입장이었다면, "
"진짜로 그렇게 물어봤을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 7f39532f-68d0-32a8-3031-7f8279acf1a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_Isobel = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Isobel_AskedHerAboutKethericDaughter(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:7f39532f-68d0-32a8-3031-7f8279acf1a9
msgctxt "h2c49d763gd22fg49ffg8e75ge5adab788657"
msgid ""
"Isobel. I found the empty sarcophagus of an Isobel Thorm - Ketheric's "
"daughter."
msgstr "이소벨. 케서릭의 딸인 이소벨 쏨의 비어있는 석관을 발견했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 88a3bf2f-8d8f-ea17-9251-fb572abdbdad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:88a3bf2f-8d8f-ea17-9251-fb572abdbdad
msgctxt "h7579051egec7eg4bbdgbcb0g9462fbfea5ae"
msgid "An immortal. But it couldn't possibly be..."
msgstr "불멸자라. ...그럴 리가 없을 텐데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 898d9462-c1f6-4769-2137-be98b2117d98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:898d9462-c1f6-4769-2137-be98b2117d98
msgctxt "h5885b421g8f62g48a7g8081gc67915e5faec"
msgid ""
"This curse seems incredibly powerful. What more can you tell me about it?"
msgstr "이 저주는 어마어마하게 강력해 보이는데. 더 설명해 줄 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 8e5e5e4f-bc25-b9ab-3072-aa7aa199b8b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:8e5e5e4f-bc25-b9ab-3072-aa7aa199b8b1
msgctxt "hfffc76f4g4db5g40d5gb89cge4a147da419a"
msgid ""
"I have my reasons. And anyway - there are civilians to protect. Without me, "
"this inn would fall to shadow."
msgstr "이유가 있어서 그래. 그리고 뭐, 지켜야 할 시민들도 있잖아. 내가 없으면 이 여관은 그림자에 먹힐 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 8ec3415f-3c08-abab-4bbf-a373229cb29d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:8ec3415f-3c08-abab-4bbf-a373229cb29d
msgctxt "h8aa49b05gbecdg454bg944egc6b020fb6550"
msgid "I still have a few questions."
msgstr "물어볼 게 좀 더 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 911691a3-3de9-7b9c-d7b8-cbcef3a816a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:911691a3-3de9-7b9c-d7b8-cbcef3a816a8
msgctxt "h79b26630g5cd2g4ac3g9bd6g71ea1dc9ae44"
msgid "So glad you're on our side."
msgstr "네가 우리 편이라 정말 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 92a59fd4-cfda-1f7e-a449-4cd5f5ef1c5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:92a59fd4-cfda-1f7e-a449-4cd5f5ef1c5f
msgctxt "h9700b5a2gcb50g4894g9b4agf322899cd670"
msgid "Promise not to die, and we'll celebrate with our life stories."
msgstr "죽지 않겠다고 약속해. 그날이 오면 살아왔던 이야기를 하며 축하할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 9ae52785-4e8b-de31-866e-b7cc86d5c0c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:9ae52785-4e8b-de31-866e-b7cc86d5c0c9
msgctxt "h19d04123g176eg4c5cgba32gdf92d62900e4"
msgid "I'm not going to follow my order. You will live."
msgstr "내 안의 명령은 따르지 않겠어. 넌 안전해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 9bb82c26-4771-9e28-8d44-51d1ef818c9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_IsobelKillOrder = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:9bb82c26-4771-9e28-8d44-51d1ef818c9a
msgctxt "h6dcb3bbdg252dg419ag9cb1g1b49523b905c"
msgid ""
"*Every scrap of your marrow yearns to end her. Dooming the village would "
"bring foul glory. You can almost taste it.*"
msgstr ""
"*골수 조각 하나하나가 그녀를 끝장내기만을 갈망하고 있습니다. 마을의 파멸은 더러운 영광을 가져올 것입니다. 벌써 맛이 느껴지는 것 "
"같군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = 9c36390c-dcef-ac44-01c0-8381ec65da46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:9c36390c-dcef-ac44-01c0-8381ec65da46
msgctxt "he7eb28f1ge194g470cgb0a1g8a176ac1d3ee"
msgid "I won't harm you... I don't know what came over me."
msgstr "널 해치지 않을게... 무슨 감정이었는지도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 9d6fe3f0-b4d7-4a65-0d51-18a310f081c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:9d6fe3f0-b4d7-4a65-0d51-18a310f081c7
msgctxt "h9a88c314gba06g42efg8facg8a1c6300cd9b"
msgid ""
"Moon and shadow - light and dark. Divine sisters, ever at war. And this "
"place has become one more battlefield."
msgstr "달과 그림자, 빛과 어둠. 언제나 전쟁 중인, 신성한 자매지. 그리고 이곳도 그 전장 중 하나가 되었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = 9e71b336-4f28-595b-b3b1-b1fea0e6d389
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:9e71b336-4f28-595b-b3b1-b1fea0e6d389
msgctxt "h66db54bag1425g46aag82f8g44be8efca958"
msgid ""
"*Your body yearns to kill this cleric, more than anything else. You know it, "
"deep down, in your writhing intestines.*"
msgstr ""
"*다른 그 어떤 것보다도, 당신의 몸은 이 클레릭을 죽이기만을 갈망합니다. 저 깊은 곳, 꿈틀거리는 내장 속에서부터 그것이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = 9fe8dd51-0774-76db-168b-68eb964fd2ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:9fe8dd51-0774-76db-168b-68eb964fd2ce
msgctxt "h6be019a2g6b22g4c94gb9e9g01ccd68ae3c8"
msgid "Go on, then."
msgstr "말해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = a9b6121a-5c0d-68f9-b1ff-f4ae54980088
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Local:
#.     - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:a9b6121a-5c0d-68f9-b1ff-f4ae54980088
msgctxt "h923d8a81gdc9cg47e8gbcf2gc1f89c9be8a2"
msgid "Why don't we try again, then? Who are you?"
msgstr "그럼 다시 해보는 게 어때? 넌 누구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = acc3be80-db42-7473-318c-884cd0dc52c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:acc3be80-db42-7473-318c-884cd0dc52c8
msgctxt "h3b87e683g1c66g415fga7aegfb850dc33ab0"
msgid ""
"I'm glad you've made progress. Protecting this inn - well, it takes it out "
"of you. I'll hold out as long as I can. By the sound of things, we'll have a "
"more permanent solution soon."
msgstr ""
"진전이 있었다니 기뻐. 이 여관을 지키는 게... 널 못살게 굴고 있지만 말이야. 내가 버틸 수 있는 만큼 버텨볼게. 돌아가는 걸 "
"들어보니, 조만간 더 영구적인 해결책을 얻을 수 있을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = af55488d-bb59-9997-ca25-de44257e053e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:af55488d-bb59-9997-ca25-de44257e053e
msgctxt "h9ee841b1g98b7g449cg9b30g1d802cab3fd4"
msgid ""
"Her name is Nightsong. An immortal Ketheric had trapped within the "
"Shadowfell."
msgstr "그녀의 이름은 밤의 노래야. 케서릭이 섀도펠에 가둬놨던 불멸자지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = afb63298-e908-5464-2dc3-b74d7125cd76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:afb63298-e908-5464-2dc3-b74d7125cd76
msgctxt "h0e2d7308gf883g4c0dg8602g6a87c222080b"
msgid ""
"It's incredibly powerful. We'll have our work cut out for us trying to shift "
"the thing, but I believe we - you - can do it."
msgstr "이건 굉장히 강력해. 이걸 없애기 위해서는 할 일이 쌓여있지만, 우리, 그리고 너라면 할 수 있을 거라고 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = b2b820f7-3094-8522-2cce-60c9a763a873
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:b2b820f7-3094-8522-2cce-60c9a763a873
msgctxt "h2d066710g7062g476dgbba8g6fb948e9f8f2"
msgid "I suppose they didn't defeat him quite hard enough."
msgstr "확실하게 숨통을 끊어놓은 게 아니었나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = b3132aaf-ef90-c120-b270-00906f1274cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Isobel_AskedHerAboutKethericDaughter(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:b3132aaf-ef90-c120-b270-00906f1274cd
msgctxt "head3e3e5gb75fg417ag8fcdg05f1dff3a2e3"
msgid ""
"Isobel. I found the empty sarcophagus of an Isobel Thorm - Ketheric's "
"daughter."
msgstr "이소벨. 케서릭의 딸인 이소벨 쏨의 비어있는 석관을 발견했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = b45d3bce-947c-6d38-f3f4-b7b5e101e8e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:b45d3bce-947c-6d38-f3f4-b7b5e101e8e9
msgctxt "hdd3c4f2fg288eg4f1ag8ea3gbac5942a7f9a"
msgid ""
"I've a great number of questions for you, in that case. But those can wait "
"until Ketheric is dead. While he lives, we're all on borrowed time."
msgstr ""
"만약 그렇다면 너한테 물어볼 게 정말 많은 걸. 하지만 그건 케서릭이 죽을 때까지 기다릴 수 있어. 그가 살아있는 동안엔, 우린 모두 "
"외줄을 타고 있는 거니까 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = b5be5a9a-4ab5-b1d4-42a2-5bb08ef81e4c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:b5be5a9a-4ab5-b1d4-42a2-5bb08ef81e4c
msgctxt "h91e242ceg5695g47f8gb524g66e1b0d55ba4"
msgid ""
"It belongs to Shar - all the more surprising you're interested in lifting "
"it. According to the Harpers, it fell here when they defeated - or thought "
"they defeated - one of her disciples, Ketheric Thorm."
msgstr ""
"이건 샤의 것이야. 그래서 더욱더 네가 이걸 제거하려 한다는 것이 놀라워. 하퍼들에 의하면, 그들이 그녀의 신봉자 중 하나인 케서릭 쏨을 "
"물리쳤을 때 이곳에 흩뿌려졌다고 해. 혹은 그렇다고 생각했을 때 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = b5be5a9a-4ab5-b1d4-42a2-5bb08ef81e4c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:b5be5a9a-4ab5-b1d4-42a2-5bb08ef81e4c
msgctxt "hf40242a1gaca0g4f98ga3ccgca3558886d4d"
msgid ""
"It belongs to the goddess Shar - according to the Harpers, it fell here when "
"they defeated - or thought they defeated - one of her disciples, Ketheric "
"Thorm."
msgstr ""
"이건 여신 샤의 것이야. 하퍼들에 의하면, 그들이 그녀의 신봉자 중 하나인 케서릭 쏨을 물리쳤을 때 이곳에 흩뿌려졌다고 해. 혹은 "
"그렇다고 생각했을 때 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = ba417134-eb84-ec20-808e-141888561879
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:ba417134-eb84-ec20-808e-141888561879
msgctxt "hf5aef50eg2563g47c6g8d64g10a715e60a5d"
msgid ""
"Maybe she was waiting for one of us to find this place ourselves. Free will, "
"and all that."
msgstr "어쩌면 그분께서는 우리가 스스로 이곳을 찾아내기를 기다리고 계셨을지도 모르지. 자유의지, 뭐 그런 것들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = ba4d332a-a012-a4bd-8b37-0992f86da47f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:ba4d332a-a012-a4bd-8b37-0992f86da47f
msgctxt "h79ad99e5g0438g4629g9c69g1945fcac689e"
msgid "I did. And I'm on my way to the Towers now to see Ketheric finished."
msgstr "봤어. 그리고 케서릭의 마지막을 보기 위해 타워로 가는 길이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = c09fc955-7ca7-6165-6643-d98da783ce26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:c09fc955-7ca7-6165-6643-d98da783ce26
msgctxt "h607cf495g3c11g42c2g9c3agaaf5cd99094c"
msgid "I'll put an end to him - to all of this."
msgstr "그 녀석과 이 모든 것의 끝을 내주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = c7329d78-7501-0d25-e047-323b59fc0c1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:c7329d78-7501-0d25-e047-323b59fc0c1d
msgctxt "h97474f6dg626bg4c34g9ea3g132b87e0006e"
msgid "<i>Chase away your putrid desires.</i>"
msgstr "<i>당신의 구역질 나는 욕구를 쫓아냅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = c79bc5d9-cb5a-3dd4-c5be-1e909e9f0d16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:c79bc5d9-cb5a-3dd4-c5be-1e909e9f0d16
msgctxt "h1707d2fdg8004g4154g9564g43b8a59c311d"
msgid ""
"An unfortunate coincidence. I hope never to meet the wicked man who "
"haemorrhaged shadows over this peaceful village."
msgstr "이름이 같다니 유감스러운걸. 이 평화로운 마을을 그림자로 난도질한 사악한 사람과는 절대 만나지 않고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = cca7863d-2b8e-0b97-1211-eac6b02d19d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Isobel_HasMetPrisonersSaved(1) = True
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:cca7863d-2b8e-0b97-1211-eac6b02d19d8
msgctxt "hbb96550bg9497g46d3gbb20ge2ecbf39ccfb"
msgid "What's on your mind?"
msgstr "무슨 일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = cdbb56ba-be47-34c3-1d8c-1024e385d8e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_AbductionAttempted = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:cdbb56ba-be47-34c3-1d8c-1024e385d8e5
msgctxt "h8e271773gd88ag40ecg98f7g30052db882c5"
msgid ""
"It belongs to Shar - all the more surprising you're interested in lifting "
"it. According to the Harpers, it fell here when they defeated Ketheric, the "
"one who tried to have me kidnapped."
msgstr ""
"이건 샤의 것이야. 그래서 더욱더 네가 이걸 제거하려 한다는 것이 놀라워. 하퍼들에 의하면, 그들이 그녀의 신봉자 중 하나인 케서릭을 "
"물리쳤을 때 이곳에 흩뿌려졌다고 해. 이 케서릭이 날 납치하려 했던 그 녀석이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = cdbb56ba-be47-34c3-1d8c-1024e385d8e5
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_AbductionAttempted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:cdbb56ba-be47-34c3-1d8c-1024e385d8e5
msgctxt "hc8986b38gb4ccg49ffgacceg8acaef964bce"
msgid ""
"It belongs to the goddess Shar - according to the Harpers, it fell here when "
"they defeated Ketheric - the one who tried to have me kidnapped."
msgstr ""
"이건 여신 샤의 것이야. 하퍼들에 의하면, 그들이 그녀의 신봉자 중 하나인 케서릭을 물리쳤을 때 이곳에 흩뿌려졌다고 해. 이 케서릭이 날 "
"납치하려 했던 그 녀석이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = ce35255b-b913-6d69-b869-9dba0429650a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BalthazarsSecrets_Knows_NightsongSecret = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:ce35255b-b913-6d69-b869-9dba0429650a
msgctxt "hbc09a544g386ag4e49g9743g441a8e2ab2e3"
msgid ""
"I think I know the source of his invulnerability: a relic called the "
"Nightsong."
msgstr "그의 불멸성의 원천을 찾은 것 같아. 바로 밤의 노래라고 불리는 유물이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = d0fd8541-48d6-f5c4-b80e-16730b7ce62d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:d0fd8541-48d6-f5c4-b80e-16730b7ce62d
msgctxt "hd6f2fd44g9ecbg4921g8ea3g11eb52814dd7"
msgid ""
"Your mission is more urgent than ever. I can hardly fathom what Ketheric has "
"become. Free the immortal - and stop him. <i>Please.</i>"
msgstr ""
"네 임무는 그 어느 때보다도 중요해졌어. 케서릭이 무엇이 되었는지 짐작조차도 어려운걸. 불멸자를 해방하고, 그를 막아줘. "
"<i>부탁이야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = d185bee9-d649-6a13-b287-9ed68c7e1b1b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:d185bee9-d649-6a13-b287-9ed68c7e1b1b
msgctxt "h3f0666b6g2e9ag4e54g94b3g7e8fcc23418f"
msgid ""
"Why has the Moonmaiden waited until now to take an interest in this curse?"
msgstr "어째서 달처녀께서 지금까지 이 저주에 관심을 갖지 않고 기다리신 걸까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = d2a282bb-9ae0-9e6a-b1aa-a2ef824e2214
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:d2a282bb-9ae0-9e6a-b1aa-a2ef824e2214
msgctxt "hc869b146g5831g4d54g9f52g24720635f947"
msgid ""
"*Her breath catches; you notice a barely-perceptible shudder run through her "
"body.*"
msgstr "*그녀의 숨소리가 멈칫합니다. 당신은 그녀의 몸이 겨우 알아볼 정도로 떨리는 것을 알아챕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = db851e10-962c-a206-02a4-b87554392c73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:db851e10-962c-a206-02a4-b87554392c73
msgctxt "hc93127f4g4d9eg4dfegbf20g465812360fb3"
msgid ""
"You'd be a bit late to the party if you did. Ketheric Thorm done for. Or "
"didn't you see that angel carving a path straight toward Moonrise Towers?"
msgstr ""
"만약 그렇다면 파티에 좀 늦은 것 같은데. 케서릭 쏨은 분명 끝장날 거야. 아니면, 문라이즈 타워를 향해 길을 수놓던 그 천사를 못 "
"보기라도 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = dcecc601-6a71-d797-f52d-39dcdb84a72d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:dcecc601-6a71-d797-f52d-39dcdb84a72d
msgctxt "h6e1d319cga69cg47bbgb693gc0ba99695255"
msgid "Moonmaiden - have mercy on this poor soul."
msgstr "달처녀시여, 이 불쌍한 영혼에게 자비를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = e0298fc5-688c-1b1d-e558-78fa41a8d280
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e0298fc5-688c-1b1d-e558-78fa41a8d280
msgctxt "h364165ecgfb8ag4328gb7e4g0247ef2454ed"
msgid "Still plenty to do to stop Ketheric."
msgstr "케서릭을 막기 위해서는 아직 할 게 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = e2b91ae2-fff2-689c-950a-d166e9bf3239
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e2b91ae2-fff2-689c-950a-d166e9bf3239
msgctxt "h3161e2cega1f5g4c04g9af2ga942eb0c6ec9"
msgid "She can join the club."
msgstr "같이 가면 되겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = e404a97f-f574-7f84-355e-18475d0b6155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e404a97f-f574-7f84-355e-18475d0b6155
msgctxt "h4ac4c4d7gf889g4729ga8adg3e07b1e43b71"
msgid "Did you learn anything about how we might defeat him?"
msgstr "어떻게 케서릭을 물리칠지에 대해서는 뭐 알아낸 거 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = e408d6f5-64ea-51c5-ad8c-26eff17138f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Isobel_NightsongFreedHasmet(1) = False
#.   Global:
#.      - HAV_IsobelGaveOintment = False
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Isobel_NightsongFreedHasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e408d6f5-64ea-51c5-ad8c-26eff17138f5
msgctxt "h3dcbd9a1g9cfag4695gbfb4g50ad5560a0f9"
msgid "Hold - who are you, and what are you doing here?"
msgstr "멈춰. 누구야? 그리고 여기서 뭐 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = e71b1439-3725-7c89-2c27-2986f0ba25dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e71b1439-3725-7c89-2c27-2986f0ba25dc
msgctxt "h7aef80e1ge19bg4b3fg82b4g97ac3ee6d044"
msgid ""
"In that case... you're very welcome here. But I urge you to be careful. "
"Ketheric is a dangerous man. His devotion to the so-called 'Absolute' has "
"taken whatever nobility of soul remained to him."
msgstr ""
"그렇다면... 널 환영할게. 하지만 조심하길 바라. 케서릭은 위험한 사람이야. 그의 영혼에 남아있던 고귀함이 얼마였든 간에, 이른바 "
"'절대자'에 대한 헌신이 그걸 죄다 앗아갔거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = e84101b0-2efe-ae43-4792-7a9126ecaedf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e84101b0-2efe-ae43-4792-7a9126ecaedf
msgctxt "h68d9f6d2ga5aeg4048gb91fg1a4c26bec8ab"
msgid "How did you come to this place?"
msgstr "어쩌다 여기로 오게 된 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = e9496b98-488e-63d3-226b-235ccac819a4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e9496b98-488e-63d3-226b-235ccac819a4
msgctxt "hbe0e75f6gd637g4482gaed4g1829872c4904"
msgid "Oddly enough, Sharran, I believe you."
msgstr "샤 신도야, 아주 묘하게도, 난 널 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = e9496b98-488e-63d3-226b-235ccac819a4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e9496b98-488e-63d3-226b-235ccac819a4
msgctxt "hb4fea6c7gd121g4f9aga964g028b181b75d7"
msgid ""
"I trust you. You had good enough taste to choose our Lady for a patron, "
"after all."
msgstr "널 믿어. 어쨌든, 우리 여신님을 후원자로 둘 만큼 안목이 좋잖아 넌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = e9496b98-488e-63d3-226b-235ccac819a4
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:e9496b98-488e-63d3-226b-235ccac819a4
msgctxt "h671861cdg29b8g4c52g96aag96208e4ed769"
msgid "I know you won't."
msgstr "알아. 믿고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = ec677b32-57b4-1023-abd6-01537f742233
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:ec677b32-57b4-1023-abd6-01537f742233
msgctxt "hd25cad62ga0d4g45a1g8e67g198e57b0c7f6"
msgid ""
"I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]. I mean you no "
"harm."
msgstr "난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]. 널 해칠 의도는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = ee4b282a-00bc-8c48-890d-d309baabe5f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:ee4b282a-00bc-8c48-890d-d309baabe5f0
msgctxt "hc830f2e0g24fdg456bg90e4gbf05415b32d5"
msgid ""
"If you've done it once, no doubt you can do it again. While Ketheric lives, "
"we're all on borrowed time."
msgstr "한번 성공 해봤다면, 다시 할 수도 있을 거야. 뭐, 케서릭이 살아있는 동안엔, 우린 모두 외줄을 타고 있는 거지만 말이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = efe0d988-8929-8ae0-c1de-32738c653e7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:efe0d988-8929-8ae0-c1de-32738c653e7d
msgctxt "h5d9f4bdcgad2dg407fgb8a2g62052ed2ff3e"
msgid "This might all be over soon. But Ketheric won't go down easily."
msgstr "어쩌면 이 모든 게 곧 끝날지도 몰라. 하지만 케서릭은 쉽게 물러나지 않을 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = f0828bfc-5664-857c-de40-fa6cfed726e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_Isobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f0828bfc-5664-857c-de40-fa6cfed726e1
msgctxt "h73eaf81dgc75fg448cgbb33g5ced69956d1b"
msgid ""
"I'm Isobel. Servant of the Moonmaiden. Protector of this inn and those who "
"seek shelter here. Your turn."
msgstr "난 이소벨이야. 달처녀님의 종복이지. 이 여관으로 대피해 온 모든 사람의 수호자이기도 해. 네 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = f22e4088-4d28-91bb-b018-1cd69476fb38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f22e4088-4d28-91bb-b018-1cd69476fb38
msgctxt "hb273aed6gb89cg410fgb010gdf465fb211ea"
msgid "I trust so. Thank you."
msgstr "그렇게 믿을게. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Narrator
#. NodeID = f429cc2c-46fd-c710-b78b-b007cb933f35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f429cc2c-46fd-c710-b78b-b007cb933f35
msgctxt "hb1e444c3g94dcg4a15g9395g24ab0d4eb2ff"
msgid ""
"*As suddenly as it started, you have tamed the Urge. It slumbers again.*"
msgstr "*그렇게 하자마자 곧바로, 충동을 다스리는 데 성공합니다. 다시 잠에 들었군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = f433a097-85ee-6018-780d-cc127b2318bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f433a097-85ee-6018-780d-cc127b2318bd
msgctxt "hff813a69g9a31g4f1bgaa78gbd3848460fe4"
msgid ""
"An unfortunate coincidence. I hope never to meet the wicked man who "
"haemorrhaged shadows over this peaceful village."
msgstr "이름이 같다니 유감스러운걸. 이 평화로운 마을을 그림자로 난도질한 사악한 사람과는 절대 만나지 않고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = f512aa65-07ca-d32b-8220-4a6678c852d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Isobel_HasMetDefault(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f512aa65-07ca-d32b-8220-4a6678c852d9
msgctxt "he29966e6g7922g449ag8c27gff60538dd3bf"
msgid "Don't let Jaheira catch you dawdling."
msgstr "자헤이라 님이 너 빈둥대는 거 알아채겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = f6396e01-ca53-f189-f556-46c5266d8cd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f6396e01-ca53-f189-f556-46c5266d8cd3
msgctxt "hee451989gd6d3g4f62gae47gec4dbd313db0"
msgid ""
"I could say the same. But perhaps we should save the trivia 'til we're on "
"the other side of this thing."
msgstr "그 말 똑같이 돌려줄 수도 있겠지. 하지만 이 사태의 최종 국면을 넘기기 전까지는 어쩌면 신변잡기는 아껴둬야 할지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = f6589f6e-0c23-7e8f-5727-9dd2b60758f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f6589f6e-0c23-7e8f-5727-9dd2b60758f3
msgctxt "h901963cdg1e31g478aga1dcgba0620c3ea0d"
msgid ""
"Don't jest. We're all closer to oblivion than you might think. And when "
"we're gone, there'll be no one left to stop Ketheric."
msgstr ""
"헛소리하지 마. 파멸은 네가 생각하는 것보다 우리 코앞에 있어. 그리고 우리가 쓰러지면, 케서릭을 막을 수 있는 사람은 단 하나도 없을 "
"거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = f8feae75-7bb9-a3f3-3d87-f0d3938fac3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f8feae75-7bb9-a3f3-3d87-f0d3938fac3a
msgctxt "hd7c7b100ge156g407ag8b48gca6f4d2f4cfa"
msgid "All in a day's work."
msgstr "일상적인 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = f958b44f-d233-c1a4-e879-7c18e86e3f14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c76693dc-e4a4-5631-a9b5-8abc6b4ab36e_DarkUrgeThreatened = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:f958b44f-d233-c1a4-e879-7c18e86e3f14
msgctxt "h911b64b7g9d9eg402ag9caegd7de10a3a364"
msgid "<i>Forsake your truce. Kill her.</i>"
msgstr "<i>휴전 상태를 파기하고 죽인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Isobel
#. NodeID = fa0a0102-e6fd-e224-97f7-7ea16883b3cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:fa0a0102-e6fd-e224-97f7-7ea16883b3cf
msgctxt "h390b0aa5g6e1cg42c3g97f4gccab4961c014"
msgid ""
"You aren't the first to threaten me. But I know the eyes of a killer when I "
"see them. You mean me no harm. Do you? An experienced cleric can tell such "
"things."
msgstr ""
"내가 위협받은 게 이번이 처음은 아니야. 하지만 난 살인자의 눈을 알아. 넌 나를 해칠 의도가 없어, 맞지? 숙련된 클레릭이라면 그런 걸 "
"알아볼 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel
#. Speaker = Player
#. NodeID = fc89e3f5-cd23-9ea6-85bc-a08f87c00b69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel:fc89e3f5-cd23-9ea6-85bc-a08f87c00b69
msgctxt "h787df1d8g61a1g41e4gb77cgb77af8b35be0"
msgid "Your blood is my offering, my oblation, my gift."
msgstr "네 피야말로 나의 공물이요, 제물이며, 선물이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_AtSpyCorpse
#. Speaker = Isobel
#. NodeID = 7819ea5e-28bc-4359-b442-3dd880448b31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_AtSpyCorpse:7819ea5e-28bc-4359-b442-3dd880448b31
msgctxt "h061f2d79gfe99g4b3bg9de7g03e334626b6a"
msgid "Marcus! Oh, gods..."
msgstr "마커스! 오 신이시여..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_KethericBust
#. Speaker = Narrator
#. NodeID = 66602d2b-27d4-4e91-a2a5-b4af7d35396d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_KethericBust:66602d2b-27d4-4e91-a2a5-b4af7d35396d
msgctxt "h4870db0fg7120g419agadc6g7f44bc748dd0"
msgid ""
"*A bust of Ketheric Thorm as he once was, a devotee of Selûne, just like his "
"daughter, Isobel.*"
msgstr "*케서릭 쏨의 흉상입니다. 딸 이소벨처럼 셀루네의 신자였던 때의 모습입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_KethericBust
#. Speaker = Narrator
#. NodeID = d1a3c180-e8d3-43cd-9d8e-1217ead115cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_KethericBust:d1a3c180-e8d3-43cd-9d8e-1217ead115cb
msgctxt "he6508e2dgacd0g4b4ega223g64360075457d"
msgid "*A bust of Ketheric Thorm as he once was, a devotee of Selûne.*"
msgstr "*케서릭 쏨의 흉상입니다. 셀루네의 신자였던 때의 모습입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric
#. Speaker = Isobel
#. NodeID = 0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric:0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
msgctxt "h081e011dgf9ceg4543g82f1ge75920860fa5"
msgid "What <i>happened </i>to you?"
msgstr "<i>무슨</i> 일이 벌어진 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric
#. Speaker = Isobel
#. NodeID = 0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric:0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
msgctxt "hb00d2b34g783ag43a2gbcd1g189fbc50d5c4"
msgid "When did you turn? Why?"
msgstr "언제 변절한 거야? 대체 왜?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric
#. Speaker = Isobel
#. NodeID = 0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric:0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
msgctxt "hc66b763ag526ag461cg903fg48aec9824073"
msgid "A tragedy. Worse than that - a crime."
msgstr "비극이군. 아니, 더 심하지. 범죄야 이건."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric
#. Speaker = Isobel
#. NodeID = 0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
#. HandlePath = TaggedText[0].TagText[3]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric:0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
msgctxt "h981aca0bg999ag4157g9412g8d4939ad138b"
msgid "I pity you. Truly."
msgstr "널 불쌍히 여겨. 정말로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric
#. Speaker = Isobel
#. NodeID = 0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
#. HandlePath = TaggedText[0].TagText[4]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_LookKetheric:0c9a8dc6-e9ac-73fa-79ca-3077bbf9b0ae
msgctxt "h725881eag5b55g4a47g9ac5g213e1b8e20cd"
msgid "What other sins have you been cooking up?"
msgstr "또 무슨 죄를 더 꾸미고 있던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_MarcusDefeated
#. Speaker = Isobel
#. NodeID = 40b041cf-193a-42d4-f0f3-74aa6ff57541
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_MarcusDefeated:40b041cf-193a-42d4-f0f3-74aa6ff57541
msgctxt "h6058912cga11cg45c6gb5d3g249a997ac92a"
msgid "Marcus..."
msgstr "마커스..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Isobel_AD_Prayer
#. Speaker = Isobel
#. NodeID = 12688c4b-40ae-4933-99bb-f4741b0e54e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 00271a97-6d2c-02c1-7090-cc4adcfde462_B = True
#.      - 00271a97-6d2c-02c1-7090-cc4adcfde462_A = True
