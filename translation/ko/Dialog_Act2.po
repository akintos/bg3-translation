#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - ORI_Shadowheart_Knows_JusticiarDream = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc:ddb78491-6ccd-3ecd-34a6-14a5da624195
msgctxt "hea67c3abg0e71g4a75ga514g4866cacbbd48"
msgid "This must be it. This must lead to where the Dark Justiciars came from."
msgstr "이거야. 이걸 통하면 다크 저스티시어들이 태어나는 곳으로 갈 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc
#. Speaker = Player
#. NodeID = e0585886-e6ee-7325-97b7-2b34ab0e4b55
