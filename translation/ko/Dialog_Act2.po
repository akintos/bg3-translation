#.     - SCL_BalthazarLab_Circle_Event_Use(1) = True
#.     - ORI_Gale_BalthazarLab_Event_TakeIngredients(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:62861835-bf58-613b-31d6-e9dfcecefead
msgctxt "h20addd5agdd64g4c4bg8d31g2e74ce8b4c3e"
msgid "<i>Pick up the ingedients. Craft the Shadow Lantern.</i>"
msgstr "<i>재료를 집어 든 다음 그림자등불을 만든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = 6410139c-2e38-457b-d592-1905f690abd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:6410139c-2e38-457b-d592-1905f690abd4
msgctxt "h3c3bd201g06deg45afg8be1g94685369ce42"
msgid ""
"The discarded pixie corpses might still contain enough essence, and with one "
"of the broken lantern casements..."
msgstr "버려진 픽시 시체가 아직 충분한 정수를 갖고 있을지도 모르고, 부서진 등불 용기 하나랑 같이 쓰면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = 66ac2ff4-34e5-dc59-5002-93ca959f4e81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:66ac2ff4-34e5-dc59-5002-93ca959f4e81
msgctxt "hf135cf7dgffc6g49dcgbf7ag3f68b77b9847"
msgid ""
"*Though its power is weakened, you could still use the shattered pixies "
"Balthazar discarded to craft one final lantern - not to repel the shadows, "
"but to wield them.*"
msgstr ""
"*마법진의 힘은 약해졌지만 발타자르가 버리고 간 픽시를 이용해 마지막 등불 하나를 만들 수 있습니다. 그림자를 쫓는 등불이 아닌 그림자를 "
"휘두르는 등불 말입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = 66b5666b-9da0-ddaa-84cd-f3c24a7670b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:66b5666b-9da0-ddaa-84cd-f3c24a7670b1
msgctxt "h690f5dc1g28efg4293ga7f7g39662ec49120"
msgid "<i>Really?</i> Sometimes your lack of impetus is quite astonishing."
msgstr "<i>정말?</i> 가끔 네 추진력 부족은 꽤 놀라워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = 69031018-6371-3d4d-b7c6-981ebb01894b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:69031018-6371-3d4d-b7c6-981ebb01894b
msgctxt "h24d92ab7g16b6g44d4ga2f6g3c146ad6f14b"
msgid "Some room then, if you please."
msgstr "그럼 자리 좀 비켜줄래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 6cc3857b-eafc-8dba-c7c7-f1e56156db7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:6cc3857b-eafc-8dba-c7c7-f1e56156db7d
msgctxt "hae191244geef9g4c26g89d3g22e79a8591f6"
msgid "<i>Leave it be.</i>"
msgstr "<i>내버려 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = 71a73e0e-3368-ee2b-a29c-72e5ae2772fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Knows_BalthazarCircle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:71a73e0e-3368-ee2b-a29c-72e5ae2772fd
msgctxt "h4cdb729cg082fg4b96gb09dg880fdd29c094"
msgid ""
"*Mystra forbids the use of such magic. She would insist the sigils be "
"destroyed, the circle's evil dissipated. But she is not here, and you are.*"
msgstr ""
"*미스트라는 이런 마법을 쓰는 것을 허락하지 않았습니다. 그녀라면 표식을 파괴하고 악을 내뿜는 마법진을 없애라고 말할 것입니다. 그렇지만 "
"미스트라는 지금 여기 없습니다. 여기엔 당신만 있을 뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = 72ff4d37-0917-ee89-6f34-0b7bf1e76a7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:72ff4d37-0917-ee89-6f34-0b7bf1e76a7f
msgctxt "h3a8ddf89g5e40g4d64g81ecg8227eeecf842"
msgid ""
"It's inert, if that's what you mean. But it still reeks of the Shadow Weave, "
"and its polluting magic will continue to escape for as long as it lies "
"abandoned here."
msgstr ""
"뭔가 일어나느냐는 뜻이라면, 비활성 상태야. 하지만 여전히 그림자 위브를 풍겨대고 있고, 여기 계속 버려두면 마법 오염이 계속 "
"빠져나가겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = 7726ff2d-d0c2-1a4c-6f3b-e00e14c926f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:7726ff2d-d0c2-1a4c-6f3b-e00e14c926f1
msgctxt "hfe295062g0dfeg4b90gb2d1g1ec6cc95d120"
msgid ""
"It was a quite fascinating design, though the version created here is a "
"strange corruption of the Weavepasha's original intent."
msgstr "꽤 훌륭한 설계였어. 비록 여기서 만든 변형은 위브파샤의 원래 의도를 이상하게 오염시켜 놨지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 79922d4b-acc5-2539-3141-c802cc9e4cd7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 30
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_BalthazarLab_State_IngredientsGone = True
#.      - ORI_BalthazarLab_Circle_State_PassedCheck = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:79922d4b-acc5-2539-3141-c802cc9e4cd7
msgctxt "heeca6d28ga541g4dc2ga94bgbface206c4c2"
msgid "<i>Attempt to craft the shadow lantern yourself.</i>"
msgstr "<i>직접 그림자 등불 제작을 시도해 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = 7dbcf9c4-bbc5-d1a9-2d33-f3f724d5a9f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_BalthazarLab_Circle_State_Ruined = False
#.      - ORI_Gale_Knows_BalthazarCircle = False
#.   Tag:
#.      - REALLY_GALE(1) = False
#. TagRule: WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:7dbcf9c4-bbc5-d1a9-2d33-f3f724d5a9f6
msgctxt "h6a9569f8g7201g4e77g9f8cg9b6c29295100"
msgid ""
"*Carved into the bench's rotted surface is some kind of ritual circle, its "
"sigils half-faded. Darkness and decay hangs in the air around it.*"
msgstr ""
"*작업대의 썩은 표면에는 일종의 의식 마법진이 새겨져 있고, 그 문양은 반쯤 희미해져 있습니다. 그 주변에는 어둠과 부패가 떠다닙니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = 7dbcf9c4-bbc5-d1a9-2d33-f3f724d5a9f6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_BalthazarLab_Circle_State_Ruined = False
#.      - ORI_Gale_Knows_BalthazarCircle = False
#.   Tag:
#.      - REALLY_GALE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:7dbcf9c4-bbc5-d1a9-2d33-f3f724d5a9f6
msgctxt "ha0cf1282g845eg4cc9ga747g6b3af73f97ad"
msgid ""
"*Carved into the bench's rotted surface are strange, half-faded sigils. A "
"magic circle of some kind, thick with darkness and decay.*"
msgstr "*작업대의 썩은 표면에는 반쯤 지워진 기묘한 문양이 새겨져 있습니다. 어둠과 부패가 짙게 드리워진 일종의 마법진입니다*."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 814f108c-ff00-51ab-1d68-76ba6a0f858b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:814f108c-ff00-51ab-1d68-76ba6a0f858b
msgctxt "h41a6527dg239bg4582gbea9g3d4e31f00b2f"
msgid "We shouldn't interfere with it. Leave it alone."
msgstr "우리가 건드려서는 안 돼. 그냥 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = 8bd05187-97ea-2ea2-0c44-b153b32425db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_BalthazarLab_Circle_State_Ruined = False
#.      - ORI_Gale_Knows_BalthazarCircle = True
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:8bd05187-97ea-2ea2-0c44-b153b32425db
msgctxt "hf00e4f38g1b3ag4f1cg809ag57dae9f1104b"
msgid "*The circle's power remains. To be used, or destroyed.*"
msgstr "*마법진에 아직 힘이 남아 있습니다. 사용되거나, 파괴되기를 기다리며.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 90c9902a-c400-cdbc-28e8-31591def5cbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:90c9902a-c400-cdbc-28e8-31591def5cbf
msgctxt "h168c671bgcd04g4366ga5b8geb76d4aa41f1"
msgid "Destroy this foul thing, before it pollutes any further."
msgstr "더 이상 오염되기 전에 이 사악한 것을 파괴해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 91ff546b-f40e-11c7-2e66-8127c5c22de5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 30
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_BalthazarLab_State_IngredientsGone = True
#.      - ORI_BalthazarLab_Circle_State_PassedCheck = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:91ff546b-f40e-11c7-2e66-8127c5c22de5
msgctxt "h1d0a8204g503cg4f85g941egf0200c11902c"
msgid "<i>Attempt to craft the shadow lantern yourself.</i>"
msgstr "<i>직접 그림자 등불 제작을 시도해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = 9428899a-7c37-969c-6fb1-390616c5cc02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:9428899a-7c37-969c-6fb1-390616c5cc02
msgctxt "h0b1dcbb9g816bg4f58gb8dcge9100c69fc7e"
msgid "If you think you know best, go right ahead."
msgstr "네가 그렇게 잘 안다고 생각한다면, 한번 해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 94739862-172f-078e-4644-da74a0161d47
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCL_BalthazarLab_Circle_Event_Use(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:94739862-172f-078e-4644-da74a0161d47
msgctxt "hcfd113beg3b9dg4a82gbb23gd495d1099f0c"
msgid "Mystra's not here, and I am. I say you go for it. Craft the lantern."
msgstr "미스트라는 여기 없고, 나는 있지. 한번 해봐. 등불을 만들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 964c3732-0dce-b436-49f3-e9bccf5e2c63
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 30
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_BalthazarLab_State_IngredientsGone = True
#.      - ORI_BalthazarLab_Circle_State_PassedCheck = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#.      - WIZARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:964c3732-0dce-b436-49f3-e9bccf5e2c63
msgctxt "hb6fe4da7gc066g4160gb894ge8744d6b933d"
msgid ""
"<i>Attempt to use the ritual circle yourself. Craft the shadow lantern.</i>"
msgstr "<i>의식 마법진을 직접 사용하려고 시도해봅니다. 그림자 등불을 제작합니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 9bbca6d8-d094-f095-9005-5be546aa0228
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:9bbca6d8-d094-f095-9005-5be546aa0228
msgctxt "ha578026fgecd8g431dgade9ge49389a09c7c"
msgid "I think you should forge the lantern, Gale."
msgstr "네가 등불을 만들어야 할 것 같아, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = 9d5a38ad-47f0-37d1-8c48-b2b0793a335f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:9d5a38ad-47f0-37d1-8c48-b2b0793a335f
msgctxt "h97ac268eg6558g4380gac48gd444eb0701da"
msgid ""
"Though... Mystra's eyes may be upon me, and she'd forbid me dabbling with "
"such magic. She'd want it destroyed. Wasted, arguably."
msgstr ""
"비록...미스트라가 나를 보고 있을 테고, 그런 마법에 관심 갖길 금하겠지만 말이야. 아마 그런 마법은 부수라고 하겠지. 높은 확률로, "
"버리라고 할 테고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = ad98e88e-7145-2a34-e1c6-2cbf0014a1c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:ad98e88e-7145-2a34-e1c6-2cbf0014a1c6
msgctxt "h0212cb9egec12g42dagbebeg26543d4c030b"
msgid ""
"Deal with it how? I hate to pull rank, but I was once Mystra's Chosen. "
"Destroying magic like this was my bread and butter."
msgstr "처리한다고? 어떻게? 이런 말 하기 싫지만 나는 한때 미스트라에게 선택받은 자였어. 이런 마법을 파괴하는 게 내 일이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = b1b5438e-3da3-f7f5-67a4-0e6b91602ef1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_BalthazarLab_Circle_State_Ruined = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:b1b5438e-3da3-f7f5-67a4-0e6b91602ef1
msgctxt "h08655970ge201g468aga370g703776169689"
msgid "*The circle is broken. Nothing but scuff marks on rotted wood.*"
msgstr "*마법진은 망가졌습니다. 썩은 나무 위엔 긁힌 자국만이 남아 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = b3d4348d-d181-f09c-81e5-9f357d13f95e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:b3d4348d-d181-f09c-81e5-9f357d13f95e
msgctxt "hfbb8c93ege945g4ce2g994egb512f88f3981"
msgid "Let's just leave the thing be."
msgstr "그냥 이대로 두자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = bb996027-ee74-0bf3-98ea-47057083e379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:bb996027-ee74-0bf3-98ea-47057083e379
msgctxt "hd75c027dg7e1eg453aga41ag7e2686c36a97"
msgid "Gods, you're obstinate."
msgstr "세상에, 너 정말 벽창호구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = bc69dea3-9602-cb41-cf7c-a4370c7971c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:bc69dea3-9602-cb41-cf7c-a4370c7971c2
msgctxt "h1c393693gf72eg4393gaf6ag079ac795ed9b"
msgid ""
"There's a reason you're Mystra's <i>former</i> Chosen. So let me handle it."
msgstr "미스트라의 <i>전</i> 선택받은 자인 이유가 있었네. 내가 해 보겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = c006560a-ad4e-7099-b901-122dc05f185b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:c006560a-ad4e-7099-b901-122dc05f185b
msgctxt "he49bbfdbgc9a9g42d3ga01ag5c3b0f41325a"
msgid "It's time. Destroy the ritual circle, Gale."
msgstr "시간이 됐어. 의식 마법진을 파괴해, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = c7878efd-96dc-bbbe-2d74-2c3bbe4c4093
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:c7878efd-96dc-bbbe-2d74-2c3bbe4c4093
msgctxt "ha8693ae8g8cc8g49c8ga6b9gf58888fcdee1"
msgid "Can we use it?"
msgstr "우리가 사용할 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = c80f2376-5fa8-5908-0e8d-9c7291ff64af
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Gale_Knows_BalthazarCircle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:c80f2376-5fa8-5908-0e8d-9c7291ff64af
msgctxt "h5e86b7a3gb595g4a78g85c6g715d09512fcd"
msgid ""
"A ritual circle... and a complex one, at that. I've seen such a construction "
"before, in the writings of the Weavepasha of Almraiven, though his vision "
"was not so... tainted."
msgstr ""
"의식 마법진... 그것도 복잡한 것이군. 암레이븐의 위브파샤가 쓴 글에서 이런 구조를 본 적이 있지만, 그건 이렇게... 오염되어 있지는 "
"않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = d395712d-63e8-81c3-f254-c8c2fa224e0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = False
#. SetFlags:
#.   Global:
#.     - SCL_BalthazarLab_Circle_State_Ruined = True
#.   Object:
#.     - ORI_Gale_State_BalthazarCircleUserWaitingForReaction(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:d395712d-63e8-81c3-f254-c8c2fa224e0b
msgctxt "h233e89cbgfd63g49afg8018g565c281b6b6e"
msgid "<i>Erase the shadow sigils.</i>"
msgstr "<i>그림자 표식을 지운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = dea546a4-4e6f-2f01-e57d-ae501abcd8c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:dea546a4-4e6f-2f01-e57d-ae501abcd8c0
msgctxt "hbd447025gf906g40c5gbed8g3902c1d43d3d"
msgid "Very well. Destroy the circle Gale."
msgstr "아주 좋아. 의식의 진을 파괴해, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = df44c43d-fea3-1134-9987-85737402e70d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:df44c43d-fea3-1134-9987-85737402e70d
msgctxt "h6ebf9a6dga8f1g41edg9119g16b30c60c2ec"
msgid ""
"It's been mostly drained, but even now contains a powerful dose of Shadow "
"Weave."
msgstr "거의 다 빨려나갔지만, 아직도 상당한 그림자 위브가 들어 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = e1ed533a-3f0c-429c-d88f-3f68fc08a19c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:e1ed533a-3f0c-429c-d88f-3f68fc08a19c
msgctxt "h444a0bf7gb1efg4c7dg8c35g252b45d4d3c6"
msgid "Fine. Go ahead Gale - craft this lantern of yours."
msgstr "좋아. 그럼 해 봐, 게일. 너만의 등불을 만들어 보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = e5872d4c-17e7-c3bd-b55b-a378dff7ec54
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_BalthazarLab_Circle_State_Ruined = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:e5872d4c-17e7-c3bd-b55b-a378dff7ec54
msgctxt "h767db536ga342g4889g8387g5f025b156b4f"
msgid "Not how I would have done it."
msgstr "내가 쓰려던 방법은 아니었네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = f35f7924-4de7-a2e8-0820-4966d999b4d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:f35f7924-4de7-a2e8-0820-4966d999b4d5
msgctxt "h46b3db3bg6287g492cg826egcc009aaa3e3b"
msgid "What is its purpose?"
msgstr "용도가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = f530a714-583b-c2a8-8cca-8259facc18ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:f530a714-583b-c2a8-8cca-8259facc18ed
msgctxt "hc765b119g2979g4a7aga75bg742aa63c5a9c"
msgid "Very well. Stand back, if you please."
msgstr "그럼 좋아. 부디, 물러나 주시지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = f59f1e11-5944-9f15-c355-7ffc759ed693
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 30
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_BalthazarLab_State_IngredientsGone = False
#.      - ORI_BalthazarLab_Circle_State_PassedCheck = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:f59f1e11-5944-9f15-c355-7ffc759ed693
msgctxt "h945111d4g3770g4b5cga2bbgc213d0e6d66d"
msgid ""
"<i>Pick up the ingredients and attempt to craft the shadow lantern "
"yourself.</i>"
msgstr "<i>재료를 집어 들고 직접 그림자 등불을 만들어 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = f5ba0cc0-b2dc-77ab-17d3-0b61fcea12cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#. SetFlags:
#.   Global:
#.     - SCL_BalthazarLab_Circle_State_Ruined = True
#.   Object:
#.     - ORI_Gale_Event_DestroyBalthazarCircle(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:f5ba0cc0-b2dc-77ab-17d3-0b61fcea12cc
msgctxt "h802be6c8gbd79g46ceg83c1gc9ccf54e0fd1"
msgid "<i>Erase the shadow sigils.</i>"
msgstr "<i>그림자 표식을 지운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Narrator
#. NodeID = f7439f51-3f4e-7213-3184-d64e36a79eaa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_BalthazarLab_Circle_State_Ruined = False
#.      - ORI_Gale_Knows_BalthazarCircle = False
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:f7439f51-3f4e-7213-3184-d64e36a79eaa
msgctxt "h39bc58cbg64c5g4884g8059gee6e32ed861a"
msgid ""
"*A ritual circle. Judging by the shadow sigils inscribed, it was used in the "
"creation of Balthazar's Moonlanterns.*"
msgstr "*의식 마법진입니다. 그림자 표식이 그려진 걸 보니 발타자르가 여기서 달등불을 만든 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Shadowheart
#. NodeID = fd4f450e-8772-4cbf-b48f-6914b96a38c4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:fd4f450e-8772-4cbf-b48f-6914b96a38c4
msgctxt "hd5b998c1g540bg4650gbe5eg063021cec29c"
msgid ""
"And rightly so. The last thing we need is someone of your potential becoming "
"enthralled with Shar's magic, Gale."
msgstr "마땅히 그래야지. 너처럼 잠재력 있는 사람이 샤의 마법에 홀려서는 안 돼, 게일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Shadowheart
#. NodeID = fd4f450e-8772-4cbf-b48f-6914b96a38c4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:fd4f450e-8772-4cbf-b48f-6914b96a38c4
msgctxt "h5d5fcafag2e97g4751g9f7eg133bd3a1c3d9"
msgid ""
"Forget what Mystra wants - think about yourself, and what Lady Shar's power "
"could do for you, Gale. Make the Lantern - spread her will."
msgstr ""
"미스트라의 의향은 잊어버려. 너 자신을, 그리고 샤 여신의 힘이 네게 무엇을 해 주실지를 생각해, 게일. 랜턴을 만들어. 샤님의 뜻을 "
"전파해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Gale
#. NodeID = ff2c4e16-3ca7-19bb-ff7e-f2d129424228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:ff2c4e16-3ca7-19bb-ff7e-f2d129424228
msgctxt "he37e21bag153ag497ag8486g119761a2889a"
msgid ""
"The sigils are written in a curious mix of tongues - ancient Calishite, "
"Netherese, and something else I can't quite make out. If I'm reading it "
"correctly - it was used in the creation of Moonlanterns."
msgstr ""
"흥미로운 언어 조합으로 인장을 써 놨네. 고대 칼림샨어, 네더릴어, 그리고 내가 잘 모르겠는 다른 것들도. 내가 제대로 읽었다면, 이건 "
"달등불을 만드는 데 사용했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "h6ed9d113g9fd5g4324g92f2g1a30bb31fe0a"
msgid "If we can find it, perhaps we can use it to destroy Ketheric."
msgstr "우리가 만약 밤의 노래를 찾을 수 있다면, 케서릭을 처치하는데 쓸 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "hc045d281gbd1fg46c0gbca3g192c90535a48"
msgid ""
"Its powers could prove useful. Especially if turned against Ketheric himself."
msgstr "그 힘은 쓸모가 있을지도 몰라. 특히 케서릭을 역으로 공격하는 데 쓰인다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "h5d6a6961ga1f1g46e3g9f70g84a9a2435e53"
msgid "If we find it, we might turn it against him."
msgstr "그걸 찾는다면 놈에게 역으로 사용할 수 있을지도 모른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "he363fafdg0f69g479fg9ec1g21d0e7736b47"
msgid ""
"Sounds powerful, no matter the name. If we find it, we can turn it against "
"him."
msgstr "이름과는 별개로 강력한 힘을 가진 모양이군. 찾아내면 케서릭에게 역으로 사용할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "h6cca3610ga3a3g4337g9e68g5d6bb6f097ee"
msgid "If we find it, we can use it against Thorm, perhaps."
msgstr "만약 그걸 찾아내면, 쏨에게 역으로 사용할 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "h896791c1g5af0g4a68g9ff1g17f58f569823"
msgid "Maybe we can turn it against Ketheric. Or destroy it."
msgstr "어쩌면 케서릭에게 역으로 사용할 수 있을지도. 부숴버릴 수도 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "h846857ebg4504g4504g844dg6ec577e3775f"
msgid "Perhaps there is a way to turn it against Ketheric Thorm."
msgstr "이것을 케서릭 쏨에게 역으로 사용할 방법이 있을지도 모르네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 0d2b865f-4109-4925-8f11-7ed6c94ca531
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:0d2b865f-4109-4925-8f11-7ed6c94ca531
msgctxt "h4e078a6ag7ea0g4fccg9989g858cea11ca2f"
msgid "If we find it, maybe we can turn it against him?"
msgstr "이걸 찾아내면, 케서릭에게 역으로 사용할 수 있을지도?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "hff88bc9agccfdg4af7gb1b2gb261bb19efd2"
msgid ""
"Assuming we can find it. Anything that powerful <i>will</i> be protected."
msgstr "그걸 찾을 수 있다면 말이지. 그렇게 강력한 거라면 <i>분명</i> 보호받고 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "he6f7a0a2gc626g4f2bgb5c7g1670dc719d07"
msgid ""
"First, we have to find it. And I suspect he keeps it very, very well hidden."
msgstr "우선, 그걸 찾아야 해. 하지만 케서릭이 아주, 아주 잘 숨겨놓았을 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "h47e3cd1bgca09g4095ga4eeg203061c332a1"
msgid ""
"We'll need to explore thoroughly. I doubt Ketheric leaves the means to his "
"downfall out in the open."
msgstr "철저히 수색해야 한다. 케서릭이 자신이 몰락할 가능성을 쉽게 드러냈을 리 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "h2d0052bag6d1dg4e7agbc6agf7001495dc7b"
msgid "Then we better get searching. Shall we?"
msgstr "그러면 수색해보는 게 좋겠군. 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "hdd58bbcegab58g44ecga66ag186cc00444ec"
msgid "We'd need to find it, first of all. No simple feat."
msgstr "우선은 그걸 찾아야 해. 쉬운 일이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "hada4dba3gf7a8g400fga394ge19db6badfb2"
msgid "Let's get looking. Something that valuable won't be easy to reach."
msgstr "한번 찾아보자고. 그렇게 귀한 거면 손 닿는 곳에 있진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "h6e074a88gb58ag4d3fga628g7ff0df9ce08d"
msgid "It must be found, first of all. No easy feat."
msgstr "일단은 그걸 찾아야만 하겠지. 쉬운 일이 아닐세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 30caab0a-2827-4933-acfe-1c047734b1b6
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:30caab0a-2827-4933-acfe-1c047734b1b6
msgctxt "h027277f1g22e5g420dg93a2gc65330aa2f53"
msgid "<i>If </i>we find it. I doubt he's just left it lying around."
msgstr "그걸 <i>찾는다면</i> 말이지. 케서릭이 그냥 땅바닥에 굴러다니게 놔뒀을 린 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 48c5d815-2f94-4e66-b930-05f1a96c8061
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:48c5d815-2f94-4e66-b930-05f1a96c8061
msgctxt "had472bf6g6cb8g40e6gb2b7g79ba38558ac5"
msgid "So, the Nightsong is key to Ketheric's invulnerability."
msgstr "밤의 노래가 바로 케서릭의 불멸의 비결이었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 48c5d815-2f94-4e66-b930-05f1a96c8061
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:48c5d815-2f94-4e66-b930-05f1a96c8061
msgctxt "h953d4e3dgf44cg44c3g844ag89575f0c706b"
msgid "This 'Nightsong' is the source of Ketheric's invulnerability."
msgstr "이 '밤의 노래'가 케서릭의 불멸의 원천이었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 48c5d815-2f94-4e66-b930-05f1a96c8061
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo:48c5d815-2f94-4e66-b930-05f1a96c8061
msgctxt "he8a7e487ge0d7g481dgba50gd99d15d8ae42"
msgid "The Nightsong must be the source of Ketheric's life force."
msgstr "밤의 노래가 분명 케서릭의 생명력의 근원일 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarsSecrets_PAD_NightsongInfo
#. Speaker = Player
#. NodeID = 48c5d815-2f94-4e66-b930-05f1a96c8061
