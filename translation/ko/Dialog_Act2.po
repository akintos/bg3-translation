msgctxt "hcc2fbfc0gcc49g475cgb7b7gcc4b2ecebcf4"
msgid "The shadows - arm yourselves!"
msgstr "그림자가 온다, 장비 챙겨!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
msgctxt "h44bcdd45g9ac3g4684g8c5ag4f43c16651d7"
msgid "The shadows are coming alive. We've got a fight on our hands!"
msgstr "그림자의 움직임이 활발해지고 있어. 한바탕 해야 할 모양인데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
msgctxt "hb65797fegd340g40dcga429g18136cc3e9cf"
msgid ""
"Those damn shadows. We're going to have to fight our way out of this one."
msgstr "빌어먹을 그림자 같으니. 이 상황을 벗어나려면 싸울 수밖에 없겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
msgctxt "h6f96a947g2af7g4734g84a1g11cbcb037c0a"
msgid "Ready your weapons - darkness comes!"
msgstr "전투 준비! 어둠이 몰려온다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
msgctxt "ha81a12c4g583fg42b1g8976g5db61e73cf83"
msgid "Shadow beings - out for blood."
msgstr "그림자 괴물들이야. 피를 보고 싶어 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
msgctxt "hb9f1fa31g4533g4212g81c1gf7f97a5f5723"
msgid "Shadow beings. Strike them down!"
msgstr "그림자 괴물들이다. 전부 없애버려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:0afd1ce1-a6cf-48b0-92a2-b77f5aba83f5
msgctxt "ha9b31495gcf5dg485cgbb9dgcac983bc2ca4"
msgid "It's those damn shadows. Be ready!"
msgstr "젠장맞을 그림자가 온다, 준비해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 36358255-c69c-45af-bd64-47de1f11b8ce
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:36358255-c69c-45af-bd64-47de1f11b8ce
msgctxt "h87a828a1gfdd3g4c86g9d00g4d4faa6dcf6a"
msgid "The shades are long dead - no need to show any mercy."
msgstr "그림자는 진작에 나자빠진 놈들일 뿐이야. 자비를 보이지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 36358255-c69c-45af-bd64-47de1f11b8ce
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:36358255-c69c-45af-bd64-47de1f11b8ce
msgctxt "h3d7d2f9ag1a27g4751gb11bg69dbbe29a99b"
msgid "All we can give them is a second, final death."
msgstr "우리가 저놈들에게 줄 수 있는 건 마지막일, 두 번째 죽음뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 36358255-c69c-45af-bd64-47de1f11b8ce
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:36358255-c69c-45af-bd64-47de1f11b8ce
msgctxt "hd2a886a3g9818g47b6g9a01g6a46548b2a81"
msgid "They're already gone - don't hesitate!"
msgstr "저건 이미 죽은 놈들일 뿐이야. 망설이지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 36358255-c69c-45af-bd64-47de1f11b8ce
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:36358255-c69c-45af-bd64-47de1f11b8ce
msgctxt "h309bf1b6gccbag4a1cg867dg8b14df215665"
msgid "Cursed creatures. They will not escape me!"
msgstr "저주받은 괴물 놈들이군. 녀석들은 내게서 벗어날 수 없을 거다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 36358255-c69c-45af-bd64-47de1f11b8ce
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:36358255-c69c-45af-bd64-47de1f11b8ce
msgctxt "h88308e0dg213bg44c9g8245gabad3ed862b7"
msgid "Kill them quickly, or we'll end up just the same."
msgstr "신속하게 처치해. 그렇잖으면 우리도 같은 운명을 맞을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 36358255-c69c-45af-bd64-47de1f11b8ce
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:36358255-c69c-45af-bd64-47de1f11b8ce
msgctxt "h63f2967dg1c0cg4ba5g85deg582b50dcc8ca"
msgid "No holding back. They're lost to the curse!"
msgstr "주저하지 마. 이미 저주에 삼켜진 것들이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat
#. Speaker = Player
#. NodeID = 36358255-c69c-45af-bd64-47de1f11b8ce
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_VB_ShadowSiege_PlayerEntersCombat:36358255-c69c-45af-bd64-47de1f11b8ce
msgctxt "hbda7539cgc7a5g4ffagb856g16db1b102ef5"
msgid "No hesitation - these people are long dead."
msgstr "망설이지 마, 오래전에 죽은 사람들이야."

