#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:3949aaae-9d0f-8308-2bc7-ee199ca604e6
msgctxt "hba0e7a47gf3b8g47b2g9817g08b8e47403c8"
msgid "Go, go, GO!"
msgstr "가자, 가, <b>얼른</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 3fb27a1d-2858-41d1-97ca-4abde9121225
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4951b7ce-8495-b2c8-badc-beaff0e3d807_E = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_F = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:3fb27a1d-2858-41d1-97ca-4abde9121225
msgctxt "h2321dcc0gc1d3g44b4g8b23g0911541087e4"
msgid "The sooner the boat leaves the better."
msgstr "배가 빨리 출발 했으면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 4361c077-5adb-43a6-a488-fddc0ffc2756
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADLeaving(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADLeaving(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:4361c077-5adb-43a6-a488-fddc0ffc2756
msgctxt "h08ed2143gb349g4390ga537gc37d95d29fa9"
msgid "It's just ahead - I can see the way out!"
msgstr "바로 앞이야, 나가는 길이 보여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 45a80e12-a3d6-6acd-eeec-ec0b4de0e1fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4951b7ce-8495-b2c8-badc-beaff0e3d807_C = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_D = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:45a80e12-a3d6-6acd-eeec-ec0b4de0e1fe
msgctxt "he2eec7ccge287g4b87ga647g73b8dc060021"
msgid "Almost... got it..."
msgstr "거의... 다 왔어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 61efaa26-451b-4363-adcc-5447416f02b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADAlarmReaction(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADAlarmReaction(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:61efaa26-451b-4363-adcc-5447416f02b7
msgctxt "hd7c3054bg5d53g435ega9a0ge226273bc221"
msgid "What in the hells? Damn it all - they'll be here soon. Hurry!"
msgstr "어떻게 된 거야? 망할, 놈들이 곧 올 거야. 서둘러!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 6ad931a3-8dff-427f-21a8-3eef54386f05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_C = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:6ad931a3-8dff-427f-21a8-3eef54386f05
msgctxt "h5c6e6d53g6902g4c7cga4afg0d8c89a5bd04"
msgid "This thing is chained up tight - hold on."
msgstr "꽉 묶여 있잖아, 잠깐만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 7511bac1-1eeb-4852-8d2d-77ec07398743
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADBoatMissed(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADBoatMissed(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:7511bac1-1eeb-4852-8d2d-77ec07398743
msgctxt "hc434ce80g09a5g49a7gb3f1g01544307c43f"
msgid "Think. <i>Think - </i>there must be a way around."
msgstr "생각해. <i>생각해 - </i>분명 길이 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 81a5bb56-ed49-a707-c4f9-151cf6f8476a
