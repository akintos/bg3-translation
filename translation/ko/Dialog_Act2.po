msgctxt "h19591596g22aeg4f2cg8362gfe2ece95cd2f"
msgid "A torch will not avail us here."
msgstr "횃불은 이곳에서 도움이 되지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 54306cf7-cf07-4023-81fe-146d27ea0b54
