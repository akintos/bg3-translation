msgid ""
"*East - Reithwin \n"
"West - Baldur's Gate*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquareSignpost_AD
#. Speaker = Narrator
#. NodeID = e71f0b33-1356-4111-b4ab-be7fe98be0c4
