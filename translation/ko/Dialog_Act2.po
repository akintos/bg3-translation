msgctxt "h7e09fb04g4493g4089g8c59g6f59304cd2c9"
msgid "How are we supposed to see if torches won't work here?"
msgstr "횃불이 소용없으면 여기서 어떻게 보라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 4ef4b11f-4366-4107-9062-539d468fc2b6
