msgid ""
"O U R - L \n"
"M I S T R \n"
"W H E N - N I \n"
"T H O R M -"
msgstr ""
"우 리 의 \n"
"고 통 의\n"
"어 둠 이\n"
"쏨 은 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_Plaque_003_AD
#. Speaker = Plaque
#. NodeID = 892cbaa0-aacc-4757-a2b3-0db60b4167b3
#. HandlePath = TaggedText[0].TagText[0]
