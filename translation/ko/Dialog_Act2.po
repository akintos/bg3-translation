msgctxt "hdab46b0ag0f37g4760g9599gf6da2d18bf91"
msgid "Promise?"
msgstr "정말? 약속이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_BarricadeGuards_Melee_Dwarf_JaheiraDefeated
#. Speaker = Harper Darragh
