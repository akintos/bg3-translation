msgctxt "hce0a33abg6338g40c3g9dc1g798157a3b35f"
msgid "Is that all?!"
msgstr "그게 전부냐?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_TauntPlayer
#. Speaker = Nightsong
#. NodeID = dd9b9fb1-0f6f-4ebb-9042-c20464a34cf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cf6069c-f0dc-482c-bf10-eea39f59d778_C = True
#. SetFlags:
