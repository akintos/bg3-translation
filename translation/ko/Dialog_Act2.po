msgctxt "h20beae68g23b4g4f97gb4b0gad6c6c5d6dc8"
msgid "Ellie May? I'm sure I saw that name on a tombstone..."
msgstr "엘리 메이? 분명 어느 묘비에서 그 이름을 본 것 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = c4927df7-2e16-46b7-8755-21d09941a636
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:c4927df7-2e16-46b7-8755-21d09941a636
msgctxt "h43dd2da9ga976g48bdg922agc771dbfcbf90"
msgid "Ellie May. Passed by her grave earlier."
msgstr "엘리 메이. 아까 지나친 무덤 주인이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = c4927df7-2e16-46b7-8755-21d09941a636
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:c4927df7-2e16-46b7-8755-21d09941a636
msgctxt "hb7553eb7gbe65g44c5g8d0eg1a24e839b26f"
msgid "Ellie May - wasn't that name on one of the tombstones I read?"
msgstr "엘리 메이. 아까 어느 묘비에 적혀있던 이름 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = c4927df7-2e16-46b7-8755-21d09941a636
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:c4927df7-2e16-46b7-8755-21d09941a636
msgctxt "h23478f0fgeb9ag4558g8613ge444e7ffea7e"
msgid "Ellie May - I've seen that name, etched on a tombstone."
msgstr "엘리 메이. 본 적 있는 이름이다. 묘비에 새겨져 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = c4927df7-2e16-46b7-8755-21d09941a636
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:c4927df7-2e16-46b7-8755-21d09941a636
msgctxt "he8ab7161gaff7g485bgb526g15c77afeffa6"
msgid "Ellie May. Same name as the tombstone."
msgstr "엘리 메이. 묘비에 적힌 이름과 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = c4927df7-2e16-46b7-8755-21d09941a636
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:c4927df7-2e16-46b7-8755-21d09941a636
msgctxt "hc48dbb82gffddg40b1gbc2ag019dd5d1a58c"
msgid "Ellie May - the name on the tombstone..."
msgstr "엘리 메이. 묘비에도 그 이름이 있었지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = c4927df7-2e16-46b7-8755-21d09941a636
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:c4927df7-2e16-46b7-8755-21d09941a636
msgctxt "h68d8bcf4g65bfg41f9gbaeag41890ee4bd13"
msgid "Ellie May - I think I read that name on a tombstone."
msgstr "엘리 메이. 같은 이름을 어느 묘비에서 본 것 같은데. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_EntranceSharPlaque
#. Speaker = Narrator
#. NodeID = b85322c2-d2c4-499e-a3b5-6a849f1a1324
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_EntranceSharPlaque:b85322c2-d2c4-499e-a3b5-6a849f1a1324
msgctxt "h724b7ba9gca4bg4dfdg9ad1g1133b44e0990"
msgid "*Shar. Singer of Eternal Night. Protector of the lost and forgotten.*"
msgstr "*샤. 영원한 밤을 노래하는 자. 길 잃고 잊힌 이들의 수호자.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_HQ_Plaque1
#. Speaker = Narrator
#. NodeID = c655b17e-456b-49c7-866a-89331d483e30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_HQ_Plaque1:c655b17e-456b-49c7-866a-89331d483e30
msgctxt "h0e32a003gd781g4c00ga9b9gc3a26db1d459"
msgid "*Chamber of Command.*"
msgstr "*지휘실.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_NightsongPrison_Plaque1
#. Speaker = Narrator
#. NodeID = 4171979d-d22d-44fe-9f7f-379451c3b617
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_NightsongPrison_Plaque1:4171979d-d22d-44fe-9f7f-379451c3b617
msgctxt "h2fd68a67g2fb5g4d37gbb19g6cd3c3b9afc4"
msgid "*'Pierce the moon.'*"
msgstr "*'달을 꿰뚫으라.'*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_OathPlaque
#. Speaker = Narrator
#. NodeID = 27c1fffb-ca86-465e-bcef-4367a3b00087
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_OathPlaque:27c1fffb-ca86-465e-bcef-4367a3b00087
msgctxt "h6cc984aag1dfcg4ab2g9559g7a1aeca6df42"
msgid ""
"*Cross from light into darkness;\n"
"give your life to the shadows.*"
msgstr ""
"*빛을 건너 어둠으로\n"
"그림자에 너의 생명을 바쳐라.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_OathPlaque2
#. Speaker = Narrator
#. NodeID = 2ca5b930-ea77-4034-975c-5561f4c31afe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_OathPlaque2:2ca5b930-ea77-4034-975c-5561f4c31afe
msgctxt "h581c5141g054eg4eb8ga4dagafd1aeb46616"
msgid "*Offer your pain to Shar's embrace. Hear the Nightsong.*"
msgstr "*너의 고통을 샤의 품에 바쳐라. 밤의 노래를 들으라.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_TrialsPlaque1
#. Speaker = Narrator
#. NodeID = 1f111669-f0af-4e46-820e-2bc73f2dd0da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AD_TrialsPlaque1:1f111669-f0af-4e46-820e-2bc73f2dd0da
msgctxt "h620d9d41g1634g43f5ga154g22ad0e03f508"
msgid ""
"*Brave the Gauntlet of Lady Shar. Test body, mind, and spirit with Her "
"trials. Glory awaits the few who succeed.*"
msgstr "*샤님의 역경을 감내하라. 그분이 내리신 시련으로 신체와 정신, 기백을 시험하라. 성공을 거둔 소수의 이들은 영광을 거머쥐리.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 0137df67-f37e-2f1b-dc4d-7e1b23d91b19
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasStatus(1) = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:0137df67-f37e-2f1b-dc4d-7e1b23d91b19
msgctxt "h8b83d241g84f9g4608g861bgd2a7e13fd932"
msgid "<i>Feign a prayer while your patron thieves the altar's magic.</i>"
msgstr "<i>후원자가 제단의 마력을 훔치는 사이에 기도하는 흉내를 낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 092a63bd-cf69-214a-8031-cf58245cd7ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:092a63bd-cf69-214a-8031-cf58245cd7ea
msgctxt "h2f070c57g3046g46f2g8698g0eeffde1838f"
msgid "<i>Offer prayer and devotion to the Dark Lady.</i>"
msgstr "<i>어둠의 여인께 기도와 함께 헌신하겠다는 뜻을 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 23da4853-0acc-caf0-bf46-a0c5aa349b01
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasStatus(1) = False
#.   Tag:
#.      - SELUNE(1) = False
#.      - REALLY_SHADOWHEART(1) = False
#.      - SHADOWHEART_ENEMYOFSHARPATH(2) = True
#.      - CLERIC_EVIL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:23da4853-0acc-caf0-bf46-a0c5aa349b01
msgctxt "h5dc8ac0agf057g4523gbb58g4b95a94b7b8e"
msgid "<i>Pray at the altar.</i>"
msgstr "<i>제단에 기도를 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = 28b3bce1-779b-9aec-e98b-99bbb71212ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:28b3bce1-779b-9aec-e98b-99bbb71212ba
msgctxt "h0eddcf4cgbcd1g4b9fg9746ga3539a38a7d4"
msgid ""
"*Your patron tugs briefly at the back of your mind - Lady Shar has left a "
"boon in this altar for her faithful.*"
msgstr ""
"*당신의 후원자가 마음 한가닥을 한순간 잡아챕니다. 샤는 자신을 따르는 신실한 신도들을 위하여 이곳에 은혜를 베풀어 두었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 2d6b0417-9b2b-3016-1644-87eac989be59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasStatus(1) = False
#.   Tag:
#.      - SELUNE(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:2d6b0417-9b2b-3016-1644-87eac989be59
msgctxt "h52052972gf00cg4e74ga243g2f2ab3a14e48"
msgid ""
"<i>Selûne's rival, but also her sister. Offer a prayer of reconciliation.</i>"
msgstr "<i>샤는 셀루네님의 대적자이지만, 그분의 자매이기도 하다. 화합을 기원하며 기도를 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = 2f142531-fb64-b92b-0958-b5193687403d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:2f142531-fb64-b92b-0958-b5193687403d
msgctxt "h3ba1563eg07a9g4e98gadffg8f59f9efa4f3"
msgid ""
"*Nothing. No instruction or encouragement from the Dark Lady. The silence "
"devours all.*"
msgstr "*어떤 응답도 전해지지 않습니다. 어둠의 여인께서 주시는 지시도, 격려도 없이 오로지 침묵만이 가득합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 3233d5c7-17a4-7204-29f4-a2512e275d98
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - SHA_AcademyAltar_Event_ShadowheartInteraction(1) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:3233d5c7-17a4-7204-29f4-a2512e275d98
msgctxt "hde8bb750g550bg4cefg91c6g8a958d00df71"
msgid ""
"<i>Silently swear your body and soul to Shar. Give yourself over "
"entirely.</i>"
msgstr "<i>샤님께 몸과 영혼을 온전히 다할 것임을 고요히 서약한다. 자신을 오롯이 그분께 바친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = 33caec83-34bb-6d14-7ef3-2d926dbd5b58
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_AcademyAltar_Event_GiveBuff(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:33caec83-34bb-6d14-7ef3-2d926dbd5b58
msgctxt "h8007948bgc76dg43b4g9675gdf9ea8f26cc7"
msgid ""
"*The faintest sensation of approval quickens your heart. A hard-won blessing "
"from your Mistress.*"
msgstr "*지극히 희미하지만, 인정을 받았다는 감각이 마음에 명멸합니다. 힘겹게도 당신이 섬기는 신에게 축복을 구한 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = 33d8241c-2001-c2c9-afa8-b6b76d53f0d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasDebuff(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:33d8241c-2001-c2c9-afa8-b6b76d53f0d8
msgctxt "h57222b57g7edag4ab2g9484g7c07fef37675"
msgid "*A small prickle of dread finds your heart as you look upon the altar.*"
msgstr "*제단을 바라보자니 두려움이 엄습하여 날카롭게 마음 한구석을 찌르는 듯한 느낌이 듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 55764e6f-f632-75f7-b92a-6a7729be259e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasStatus(1) = False
#.   Tag:
#.      - SELUNE(1) = False
#.      - REALLY_SHADOWHEART(1) = False
#.      - SHADOWHEART_ENEMYOFSHARPATH(2) = False
#.      - CLERIC_EVIL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:55764e6f-f632-75f7-b92a-6a7729be259e
msgctxt "h9e6df063g0c77g4564g8d44geb44405ba371"
msgid "<i>Pray at the altar.</i>"
msgstr "<i>제단에 기도를 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Shadowheart
#. NodeID = 5ed19a25-aed3-be39-5588-d1fdd5a1a34b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:5ed19a25-aed3-be39-5588-d1fdd5a1a34b
msgctxt "hc2187dd7g3d73g4a7eg811fg62f44eb715dd"
msgid ""
"Such a noble shrine. I fail to understand why some speak ill of Shar. She "
"radiates grace."
msgstr ""
"참으로 숭고한 분위기를 풍기는 성소야. 어째서 어떤 이들이 샤님을 못되게 말하는지 이해할 수가 없어. 그분은 은총을 온 세상에 발하시는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 61add1a6-15fa-9001-4c99-b7a55d210957
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:61add1a6-15fa-9001-4c99-b7a55d210957
msgctxt "h8567f088gf718g407bgb767ge0e7ecd98e0c"
msgid "<i>Bow your head and listen for Shar's presence.</i>"
msgstr "<i>고개를 조아리고 샤의 존재감에 귀를 기울인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = 6d2d12a1-685c-e954-52bd-a845ff3b6231
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasBuff(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:6d2d12a1-685c-e954-52bd-a845ff3b6231
msgctxt "h9161fa24g3637g4f33gbf62gf761a648cd43"
msgid "*A contented emptiness washes over you as you gaze upon the altar.*"
msgstr "*제단을 바라보니 만족스러운 공허감이 당신을 휩쓸고 지나가는 듯한 느낌이 듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = 7c26025a-4791-846e-b7ea-d512a0c19184
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasBuff(1) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:7c26025a-4791-846e-b7ea-d512a0c19184
msgctxt "h4a9218adg1d3dg47b0g99e0gbd902441ef9b"
msgid ""
"*A flicker of anxiety comes to you as you look upon the altar. Why was it so "
"difficult to receive Shar's blessing...?*"
msgstr "*제단을 바라보자니 희미하게 불안감이 피어오릅니다. 어째서 샤의 축복을 구하는 것은 그렇게나 힘겨운 일이었을까요...?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = 824411bd-6245-ce33-bde5-bb6feff945d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_AcademyAltar_Event_GiveBuff(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:824411bd-6245-ce33-bde5-bb6feff945d1
msgctxt "h9d87ad75g64f7g47e0gb15bg05601f05bd25"
msgid ""
"*A pleasurable shiver runs down your spine. You feel as though you've "
"unburdened a troubling thought and forgotten it forever.*"
msgstr "*만족스러운 전율로 등골이 오싹해집니다. 근심과 걱정거리가 한순간에 흩어져 영원히 잊히는 듯한 느낌이 듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = 8340c336-b130-3754-0de3-6d866da3bc5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasStatus(1) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#.      - SHADOWHEART_ENEMYOFSHARPATH(2) = False
#.      - CLERIC_EVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:8340c336-b130-3754-0de3-6d866da3bc5f
msgctxt "h2f6baca9g125eg4563g9201g549524d35bf5"
msgid ""
"<i>Shar is not your mistress, but she is worthy of respect. Offer her a "
"prayer.</i>"
msgstr "<i>샤는 당신이 섬기는 신이 아니지만, 공경해 마땅한 대상이다. 샤에게 기도를 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = a4c9420c-d985-59c3-e3ba-0cde382f8cff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasStatus(1) = False
#.   Tag:
#.      - SELUNE(1) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:a4c9420c-d985-59c3-e3ba-0cde382f8cff
msgctxt "h63473a63g49d9g43b8gaf0dg8f6e966b8212"
msgid ""
"<i>Selûne's rival, but also her sister. Offer a prayer of reconciliation.</i>"
msgstr "<i>샤는 셀루네님의 대적자이지만, 그분의 자매이기도 하다. 화합을 기원하며 기도를 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = a81dfea5-843e-6309-5444-9f3e850bf09d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasStatus(1) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#.      - SHADOWHEART_ENEMYOFSHARPATH(2) = True
#.      - CLERIC_EVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:a81dfea5-843e-6309-5444-9f3e850bf09d
msgctxt "h06208647gf1d2g4d5egbbbdgd7681b83eec7"
msgid ""
"<i>Shar is not your mistress, but she is worthy of respect. Offer her a "
"prayer.</i>"
msgstr "<i>샤는 당신이 섬기는 신이 아니지만, 공경해 마땅한 대상이다. 샤에게 기도를 올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = b236af76-4ca4-2157-852b-30edc8cbc656
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:b236af76-4ca4-2157-852b-30edc8cbc656
msgctxt "h016b8248gb7d6g484eg95b6gc24370f939a5"
msgid ""
"*An overwhelming satisfaction - both innate and exterior - runs across your "
"being. Your patron is pleased.*"
msgstr "*압도적인 만족감이 안팎을 가리지 않고 당신 존재의 전체에 퍼집니다. 후원자가 만족스러워 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Shadowheart
#. NodeID = b78ee42a-bd78-441c-a1d4-05ea49e5e6f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:b78ee42a-bd78-441c-a1d4-05ea49e5e6f3
msgctxt "hf8dba157gfad6g44deg8806g00ff94933e60"
msgid "A place of offering to the Dark Lady. May she embrace the entire world."
msgstr "어둠의 여인께 바치는 공물을 올리던 곳이야. 그분께서 온 세상을 감싸안으시기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Player
#. NodeID = cf36537f-a599-e9bd-eae9-1b4241de5dd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:cf36537f-a599-e9bd-eae9-1b4241de5dd2
msgctxt "hefe60f83g2c49g482cg800ega65dbb33db5b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = d3876b44-4327-702e-5eaf-90ee00ca1e98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_SHADOWHEART(1) = False
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:d3876b44-4327-702e-5eaf-90ee00ca1e98
msgctxt "hbdea6fecg5509g4bf7gbf3ag43cd1de04ff0"
msgid ""
"*You feel a dancing fey smirk - to steal a blessing from Shar's faithful "
"would be <i>most </i>mischevious.*"
msgstr ""
"*페이의 짖궂은 미소가 한가득 퍼지는 것이 느껴집니다. 샤의 신도에게서 축복을 훔치는 건 <i>무척이나</i> 인상적인 장난이 될 "
"것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = d3876b44-4327-702e-5eaf-90ee00ca1e98
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_SHADOWHEART(1) = False
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:d3876b44-4327-702e-5eaf-90ee00ca1e98
msgctxt "h7b54fb36gf2acg4dbbgbc62g1a5d379a0f4f"
msgid ""
"*A deep, ancient contempt wells within you - to steal a boon from these "
"upstart gods would only be right.*"
msgstr "*당신 안에 지극히 오래된 경멸이 그득히 채워집니다. 이 그릇된 신의 은혜 따위는 가로채어야 마땅할 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = d3876b44-4327-702e-5eaf-90ee00ca1e98
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_SHADOWHEART(1) = False
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:d3876b44-4327-702e-5eaf-90ee00ca1e98
msgctxt "hb2714563gb35bg4e19g99begfc38269153ab"
msgid ""
"*A fiendish chuckle sounds throughout your very soul - to steal the blessing "
"of a god could be <i>most </i>delicious.*"
msgstr "*영혼에 악마적인 웃음 소리가 한가득 울려퍼집니다. 신이 내린 축복을 훔치는 건 <i>정말이지</i> 즐거운 일일 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = e5b3cc4e-3612-b53f-6f42-dce01585baca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SHA_AcademyAltar_State_HasDebuff(1) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:e5b3cc4e-3612-b53f-6f42-dce01585baca
msgctxt "h86c55740gb999g4a7dga4dbged465f015dc7"
msgid ""
"*A wave of anxiety washes over you as you look upon the statue. Why did Shar "
"withhold her blessing?*"
msgstr "*석상을 바라보자 불안감이 물밀듯이 밀려옵니다. 어째서 샤는 축복을 내리지 않은 것일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = e8933d15-deeb-2d06-4e69-4a0dc98e3971
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_AcademyAltar_Event_GiveDebuff(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:e8933d15-deeb-2d06-4e69-4a0dc98e3971
msgctxt "h99b184b5g82a0g473fga3f3g5d9042b80123"
msgid "*Your show of fidelity is answered by silence. Your heart numbs.*"
msgstr "*충절을 바치겠다는 서원에도 돌아오는 것은 침묵뿐입니다. 마음이 무디고 굳어져 갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = faea2b4a-703d-4cca-89fe-ea69db37ec93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:faea2b4a-703d-4cca-89fe-ea69db37ec93
msgctxt "h29a9ae69g1b90g40f8g988ag14aab2bb2756"
msgid ""
"*Your prayers fade away. Nothing comes to you in return - no soothing "
"presence, no spiritual embrace. Only darkness and silence.*"
msgstr ""
"*당신의 기도는 금세 흩어집니다. 보답으로 돌아오는 것 따위는 없습니다. 위무가 되는 존재감도, 영적인 안도감도 존재하지 않습니다. "
"오로지 어둠과 침묵뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = fb43d537-2c14-805b-d763-de7802e432d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_AcademyAltar_Event_ShadowheartInteraction(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:fb43d537-2c14-805b-d763-de7802e432d3
msgctxt "hdc370502gdef4g4837gb8cag05f51a587067"
msgid ""
"*Your efforts must be inadequate. You must do more to please Shar, going "
"forward.*"
msgstr "*당신의 노력이 부족한 것임이 분명합니다. 반드시 앞으로 나아가 샤님을 만족시켜 드려야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar
#. Speaker = Narrator
#. NodeID = ffa2aa97-f18e-28d2-143f-9ec81879cf65
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SHA_AcademyAltar_Event_GiveDebuff(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar:ffa2aa97-f18e-28d2-143f-9ec81879cf65
msgctxt "h1211e5abg9f08g45efgbe9aga83ed1475593"
msgid ""
"*Your silent gesture vanishes into a pitiless, dark void. Your heart aches "
"faintly with an inexplicable feeling of loss.*"
msgstr "*당신의 고요한 기도는 무자비하고 칠흑 같은 어둠에 휩쓸려 파묻힙니다. 가슴 한 켠이 불가해한 상실감으로 저려 옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_ShadowheartVista
#. Speaker = Shadowheart
#. NodeID = c9015169-6060-4eaa-acb7-2e897d900863
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_ShadowheartVista:c9015169-6060-4eaa-acb7-2e897d900863
msgctxt "habceaf2cg8f7ag42a9gb175gedb0581ed04c"
msgid ""
"Lady Shar... so many must have toiled to make a visage so grand. It's "
"<i>beautiful</i>..."
msgstr "샤 여신이시여... 엄청난 노력이 필요했겠지. 저렇게나 거대한 입상이라니. 정말 <i>아름다워</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar_PAD_RatsAltar
#. Speaker = Shadowheart
#. NodeID = 2c638512-2b4b-4ab2-ab23-6ce52b02da7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_AcademyAltar_PAD_RatsAltar:2c638512-2b4b-4ab2-ab23-6ce52b02da7c
msgctxt "hbece55fagbac4g413ag8d8dg549165ac2b23"
msgid "Even the rats have the good sense to pay homage to Lady Shar."
msgstr "한낱 쥐들마저도 샤 여신께 경의를 표할 줄 알다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Barracks_AD_Plaque
#. Speaker = Narrator
#. NodeID = 0ed064bb-700a-b6fe-db3d-6792da6f2588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Barracks_AD_Plaque:0ed064bb-700a-b6fe-db3d-6792da6f2588
msgctxt "he2a6dec6gc169g4d68g9765g6f9f925d07df"
msgid ""
"*Feed your bodies and rest your minds. Lady Shar needs her warriors strong "
"and ready.*"
msgstr "*육신을 배불리 먹이고 마음을 안온히 누이기를. 샤님은 자신의 전사들이 강인하고 준비가 되어 있기를 바라신다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows
#. Speaker = Player
#. NodeID = cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows:cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
msgctxt "h04a18a0ag6b62g41a4g8a58gd42a3a2626cd"
msgid "Something's coming. Something dark."
msgstr "뭔가 오고 있어. 어두운 무언가가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows
#. Speaker = Player
#. NodeID = cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows:cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
msgctxt "h29079bcfg7701g4354g8c7agddfb28b1a31d"
msgid "It's cold in this... grave. The shadows darken. Some horror is at hand."
msgstr "냉기가 느껴져... 이 무덤. 그림자가 짙어진다. 손 끝에 오싹함이 감도는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows
#. Speaker = Player
#. NodeID = cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows:cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
msgctxt "h875fb600g87f4g4e36ga958g66e57113eee4"
msgid "Cold, check. Looming dread, check. Brace yourselves."
msgstr "냉기, 확인. 스며드는 공포감, 확인. 마음 단단히들 먹어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows
#. Speaker = Player
#. NodeID = cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows:cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
msgctxt "h9265b485gd8b9g4b48gbb7agc06160e09dba"
msgid ""
"My blood freezes and my bones chill. Something's coming - I can feel it..."
msgstr "피가 얼어붙고 뼈가 떨리는 느낌이군. 뭔가 오고 있어. 느껴진다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows
#. Speaker = Player
#. NodeID = cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows:cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
msgctxt "h561c08a2gdb46g480bg8828g24012e7d7c43"
msgid ""
"Gods... there's something worse than the cold and the corpses in this pit. I "
"can feel it."
msgstr "세상에... 여기엔 냉기나 시체보다도 끔찍한 뭔가가 있어. 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows
#. Speaker = Player
#. NodeID = cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows:cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
msgctxt "h4daf9c59ga1ffg45d1ga6d2g47c1062e69e1"
msgid "Hells - I feel the cold closing in. Something's coming. Something bad."
msgstr "젠장. 냉기가 다가오는 게 느껴진다. 뭔가 오고 있어. 좋지 않은 무언가가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows
#. Speaker = Player
#. NodeID = cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_CorpsePit_PAD_TriggeredShadows:cf80f1ac-9f7a-47f1-816a-1d9c57fa12e3
msgctxt "h8e47fdbbg8c5ag4793gbd4dg8717584acf75"
msgid "So cold... there's something coming. I can feel it in the shadows..."
msgstr "몹시 춥군... 뭔가 오고 있다. 그림자 속에 뭔가 있는 게 느껴져..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull
#. Speaker = Herald of Balthazar
#. NodeID = 1a5b2273-32b2-479f-b080-f40a32d4657e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull:1a5b2273-32b2-479f-b080-f40a32d4657e
msgctxt "h4ecf0e0egd0a1g4b60gbeebg3d9824a51a0f"
msgid "Not wanted. Not needed. <i>Leave</i>."
msgstr "원치도 필요치도 않다. 떠나라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull
#. Speaker = Herald of Balthazar
#. NodeID = 626e3d3f-a677-4ba7-866c-879a03cb42d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_A = True
#. SetFlags:
#.   Local:
#.     - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull:626e3d3f-a677-4ba7-866c-879a03cb42d2
msgctxt "hd278a8fbg6047g4549g8bd7g90b9c37e2045"
msgid "This place is not for you. Go no farther."
msgstr "네가 갈 장소가 아니다. 더 가지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull
#. Speaker = Herald of Balthazar
#. NodeID = a5292a49-ab5c-4b16-9d78-db33586317bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_C = True
#. SetFlags:
#.   Local:
#.     - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_B = False
#.     - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_A = False
#.     - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull:a5292a49-ab5c-4b16-9d78-db33586317bc
msgctxt "h9dafc987ga7f3g4e0dgb09egbf09df855a59"
msgid "All is at hand. Your presence is not required."
msgstr "모든 것이 갖춰졌다. 너는 더 이상 필요 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull
#. Speaker = Herald of Balthazar
#. NodeID = af61b7c3-747e-4a67-b8b9-cbc3ca812917
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_B = True
#. SetFlags:
#.   Local:
#.     - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull:af61b7c3-747e-4a67-b8b9-cbc3ca812917
msgctxt "h1e640683g911fg4c32g8e73ga199287d68f2"
msgid "The work must not be interrupted. Away!"
msgstr "과업을 방해해서는 안된다. 가거라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull
#. Speaker = Herald of Balthazar
#. NodeID = af863180-fe7b-420a-9dfa-ce0b90f2761a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_PlayedOnce = False
#. SetFlags:
#.   Local:
#.     - 4a8285f1-6d42-51cd-6803-92696f6e8f7d_PlayedOnce = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_AD_MagicSkull:af863180-fe7b-420a-9dfa-ce0b90f2761a
msgctxt "h63e9d29dg9ff8g44f3gacb6g3d53a5ead766"
msgid ""
"Nere, Z'rell, Minthara - Whoever you are, leave. I shall carry out General "
"Thorm's will alone."
msgstr "니어, 즈렐, 민타라... 누가 됐든, 떠나시오. 쏨 장군의 의지는 내가 수행할 것이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_HQ_AD_ShutteredMirrorOfLoss
#. Speaker = Narrator
#. NodeID = b185f67c-4c47-4259-9f43-f6d9c9279475
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_HQ_UsedShatteredMirrorOfLoss = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_HQ_AD_ShutteredMirrorOfLoss:b185f67c-4c47-4259-9f43-f6d9c9279475
msgctxt "h79de5258g89e7g4a0fgaa2cg623d9ab23281"
msgid "*The mirror is shattered and beyond any use.*"
msgstr "*거울은 산산조각 나 있어서 아무 쓸모 없어 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor
#. Speaker = Player
#. NodeID = d662a93a-d12f-44ba-9a06-06ba2cfd62cc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor:d662a93a-d12f-44ba-9a06-06ba2cfd62cc
msgctxt "h6ca70f8fgad98g4f5eg8c8dg53216a6e5118"
msgid "A magic lock - no amount of picking will pop that."
msgstr "마법 자물쇠야. 자물쇠 따기로는 열 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor
#. Speaker = Player
#. NodeID = d662a93a-d12f-44ba-9a06-06ba2cfd62cc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor:d662a93a-d12f-44ba-9a06-06ba2cfd62cc
msgctxt "hecdd9bc1g1a1bg499ag871bgd816a13aea80"
msgid ""
"The Weave here won't budge. Must be a powerful spell that keeps it in place."
msgstr "위브가 꿈쩍도 안 해. 강력한 주문이 잡아두고 있는 게 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor
#. Speaker = Player
#. NodeID = d662a93a-d12f-44ba-9a06-06ba2cfd62cc
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor:d662a93a-d12f-44ba-9a06-06ba2cfd62cc
msgctxt "hf6507eedg4304g4bbfg88eeg1e1a98a39d86"
msgid "Magical lock. Will need to get clever here."
msgstr "마법 자물쇠로군. 영리하게 행동해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor
#. Speaker = Player
#. NodeID = d662a93a-d12f-44ba-9a06-06ba2cfd62cc
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor:d662a93a-d12f-44ba-9a06-06ba2cfd62cc
msgctxt "he627fb8eg9cb6g428cga8d4g261d7bab19d5"
msgid "Blocked by magic. I will not let it stand in my way."
msgstr "마법에 가로막혔군. 날 방해하게 두진 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor
#. Speaker = Player
#. NodeID = d662a93a-d12f-44ba-9a06-06ba2cfd62cc
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor:d662a93a-d12f-44ba-9a06-06ba2cfd62cc
msgctxt "hc03c9ec7g3c0dg446agba9dg938d0aefbe2e"
msgid ""
"Sealed with magic. It'll take more than nimble fingers and a lockpick to get "
"past this..."
msgstr "마법으로 봉해졌어. 재빠른 손과 자물쇠 따개로는 지나갈 수 없겠네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor
#. Speaker = Player
#. NodeID = d662a93a-d12f-44ba-9a06-06ba2cfd62cc
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor:d662a93a-d12f-44ba-9a06-06ba2cfd62cc
msgctxt "h7c9e0b60g4770g4efeg8e75g70b87099a8ce"
msgid "Well I'm not getting through here. Not just yet, anyway."
msgstr "여길 지나갈 수는 없겠는데. 지금 당장은 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor
#. Speaker = Player
#. NodeID = d662a93a-d12f-44ba-9a06-06ba2cfd62cc
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_MagicLockedDoor:d662a93a-d12f-44ba-9a06-06ba2cfd62cc
msgctxt "h01097efbgcbebg46b6g8d24g2ce81888eef5"
msgid "Some sort of magic blocking the way."
msgstr "마법의 일종이 길을 막고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Shadowheart
#. NodeID = 3e2f4a68-b6c3-187f-adf3-5154e3acecde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_SHPushBackReact = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. SetFlags:
#.   Global:
#.     - SHA_Crypt_State_SHPushBackReact = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:3e2f4a68-b6c3-187f-adf3-5154e3acecde
msgctxt "hdb79e279g59bdg419aga71ag7e0cde05d1fb"
msgid ""
"The Dark Lady's path lies in darkness. Perhaps that is how I can proceed."
msgstr "어둠의 여신의 길은 어둠 속에 있어. 그리해야 내가 나아갈 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "h5bb0c3a8gd14ag44b8g82e9gd1aea4533b78"
msgid "Gods, not again. I can't get near that gem if I can't see the ring."
msgstr "제발, 이제 그만. 고리가 안 보이면 저 보석에 가까이 갈 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "hc6cdc0c4g646ag4343g804bg179c2ba31e75"
msgid ""
"I will not be bested by some Sharran trap. There's something about that "
"ring..."
msgstr "샤의 함정에 지지 않겠다. 저 고리에 무언가 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "h5d7d2460g2a79g4863g85dfg2121310fab8f"
msgid "Defied once more. That ring must be some form of Sharran defence."
msgstr "한 번 더 거절당했군. 저 고리는 샤의 어떤 방어 형태임에 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "h89a00ca5g215dg4f3eg973egb88ccaec277b"
msgid "Repulsed again... but that glowing ring I saw may show the way."
msgstr "또 튕겨냈어... 하지만 내가 본 반짝이는 고리가 길을 보여 주겠지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "h814e7e91g0a11g4550g90e3g7eb56d432d7b"
msgid ""
"Well, enough of that. That glowing ring's the key to this whole thing..."
msgstr "뭐, 이 정도면 충분해. 저 반짝이는 고리가 이 모든 것의 열쇠야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "h174fce1dg988cg41a4g8628geb64739c90dc"
msgid "No more getting knocked down. That ring's the key."
msgstr "더는 넘어지지 않겠어. 저 고리가 열쇠야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "h60c5fb07gd434g4585g87cdga3f3cccb435f"
msgid "The ring will lend a path. Why fall once again?"
msgstr "고리가 길을 알려줄 텐데. 왜 또 넘어지지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "hd59292e4gc930g4d67gb9d6ga56eb1dae869"
msgid ""
"Another bruising setback - yet that glowing ring may suggest a safe course "
"forward..."
msgstr "또 방해받아 멍이 들겠군. 허나 저 빛나는 고리가 나아가는 안전한 길을 보여 줄 걸세..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "hd45febc7g2d2fg4272g845dgd0848bdfe030"
msgid ""
"Blundering forward will only see me on my back again. That glowing ring may "
"point the way..."
msgstr "무턱대고 돌진만 해서는 되돌아오기만 하겠지. 저 빛나는 고리가 길을 가르쳐 줄지도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 597c69e8-802f-69e9-5efa-18a1d3ba7b8d
#. HandlePath = TaggedText[9].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_Event_SawRing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:597c69e8-802f-69e9-5efa-18a1d3ba7b8d
msgctxt "h65dd0c9fgdc46g4478gbdfeg37459d8a37c4"
msgid ""
"That glowing ring seems promising. Better than getting laid out on my back "
"again."
msgstr "저 빛나는 고리가 확실해 보이는걸. 다시 내팽개쳐져 드러눕기보다는 낫겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 61777591-6b0f-5047-16f2-79d3095a03fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_InnerRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByInnerRing(0) = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:61777591-6b0f-5047-16f2-79d3095a03fc
msgctxt "h3a6e7d4bg7e35g4b04gab36gf47fca5541fe"
msgid "I almost had it! I just need to watch my step..."
msgstr "거의 다 했어! 이제 조심해서 가기만 하면 돼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
