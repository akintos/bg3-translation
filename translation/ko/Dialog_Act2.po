msgctxt "h23a34456gc305g4f20ga519g4cf12b345398"
msgid "Come children, one and all. Come, and know peace."
msgstr "얘들아, 모두 모이세요. 와서, 평화를 누려요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = bfde60e6-adad-4150-bc22-8f47224d9ab7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:bfde60e6-adad-4150-bc22-8f47224d9ab7
msgctxt "h53fa763bgcd5cg444dg9c32g960618c828e6"
msgid "May he rest in shadow."
msgstr "그림자 속에서 편히 쉬시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = f9b7aba2-79fd-490d-96e2-3bfeed7dc7c4
