msgctxt "hfb27db77g4062g4c5bg864fg4d554e531e2e"
msgid "It is done."
msgstr "이제 끝났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = c5685a53-495c-458e-91ea-7236c6676dbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADGuardsReaction(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADGuardsReaction(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:c5685a53-495c-458e-91ea-7236c6676dbf
msgctxt "h01fb8f37g2062g48c7gb93bgd5914b8c584c"
msgid "I - I won't let you near the boat. <i>Ever.</i>"
msgstr "너, 널 배 가까이 가지 못하게 할 거야. <i>절대로.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = d5470519-9594-45de-a080-b2570ad2c7bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADEscaping(0) = True
#. SetFlags:
#.   Local:
#.     - 00a82e63-fae8-cc02-0b2b-314c9d21ce6c_G = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADEscaping(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:d5470519-9594-45de-a080-b2570ad2c7bf
msgctxt "hd69f8811gac9bg4edbg89e1gb5656df3f3b7"
msgid "Stone shakes and screams. Don't listen."
msgstr "돌이 흔들리면서 소리를 내는 거야. 듣지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = e45a7b09-d0ba-4ec5-b005-bbfd877a0202
