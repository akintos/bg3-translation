msgctxt "h677a5b9dgd656g459bg8b47gf9ee0d74e1a2"
msgid "*Hiss.*"
msgstr "*시이익*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = f039ee5b-be97-d583-dd2a-fcce4c9359dc
#. HandlePath = TaggedText[0].TagText[0]
