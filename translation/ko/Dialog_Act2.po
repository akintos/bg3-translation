msgctxt "hae7418ddg910dg4ff3g9997g55a89157e395"
msgid "Only with unwavering hand can we show our subject mercy."
msgstr "오로지 떨림 없는 손으로만 피험체에게 자비를 베풀 수 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 1b01a23d-7859-4c94-9cf1-c8f4cfc82de5
