msgctxt "hff576531g27b9g4e84g8736g81e938a5849b"
msgid "The Weaver's servant. Abhorrent - and <i>captivating.</i>"
msgstr "롤쓰의 종복이다. 혐오스럽고, <i>매력적이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
