msgctxt "h03b6e63ega5f1g45b8gb3e9gfe5d2c38092e"
msgid "<i>Stay silent.</i>"
msgstr "<i>침묵한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Harper Tumeril
#. NodeID = d44ab375-3dbb-4b72-832a-037f89d7efa5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcast_HasMet_EntranceGuards_Caster_HighElf_Alert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:d44ab375-3dbb-4b72-832a-037f89d7efa5
msgctxt "hf6944eb7g1c6dg48e3g9c0agcef89e8a00f0"
msgid "I question who is really on our side. Give me no reason to doubt you."
msgstr "누가 진짜 우리 편입니까. 저를 의심하게 하지 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Harper Tumeril
#. NodeID = dd440996-182f-de35-cdfd-4626cda30818
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HavenOutcasts_HasMet_EntranceGuards_Caster_HighElf_Freed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:dd440996-182f-de35-cdfd-4626cda30818
msgctxt "h3cc47ae2g6169g4f24g8994ge0ada18ddacc"
msgid "Be ready for anything at Moonrise - Ketheric won't go down easy."
msgstr "문라이즈에서의 모든 상황에 대비하세요. 케서릭은 쉽게 굴복하지 않을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Harper Tumeril
#. NodeID = dff08a83-8411-1e88-0f4e-109c9483c18f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:dff08a83-8411-1e88-0f4e-109c9483c18f
msgctxt "h469f66a7ge5b6g4929g95d8g634c36eba63d"
msgid ""
"Trot on if you want, or you could see if a friendly face'd do him any good."
msgstr "가고 싶다면 가도 돼, 아니면 그 사람에게 친절함을 베푸는 게 도움이 될지 봐도 되고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Player
#. NodeID = e9383b9f-8330-0856-87fe-2ec158082ba0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:e9383b9f-8330-0856-87fe-2ec158082ba0
msgctxt "hea71bc76g0cd3g4311g9da4gbb67a5151ee0"
msgid "I should hope so."
msgstr "그거 참 다행이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Harper Tumeril
#. NodeID = eaa4b934-94c2-8f2a-bf12-12aa89bd16f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf:eaa4b934-94c2-8f2a-bf12-12aa89bd16f5
msgctxt "haa879f37g691fg473fga084g931def6a16ee"
msgid ""
"Jaheira warned the others to steer clear, hence why I'm on door duty. You, "
"on the other hand..."
msgstr "자헤이라 님께서 다른 이들에게 접근하지 말라 경고했고, 그래서 내가 문을 지키고 서있는 거지. 당신의 경우는 다르지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Caster_HighElf
#. Speaker = Harper Tumeril
#. NodeID = ed45b4aa-156c-448e-bd3e-28ae64f622ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HavenOutcasts_HasMet_EntranceGuards_Caster_HighElf_Unprotected(1) = False
