#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001:4004de56-4d52-4912-9bbc-f9c964ab992c
msgctxt "haeaa8d24g26dag4fefg8730gd7900bc2f5d7"
msgid ""
"The General's advisor is back. Anyone left in the cells better start praying."
msgstr "장군님의 고문이 돌아왔다. 감옥에 남은 사람들은 기도해야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001
#. Speaker = Adept Mola
#. NodeID = 7a66dcdb-41ad-4e5a-ab93-8d6d5b57c1ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_001_Hasmet(1) = False
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_001_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001:7a66dcdb-41ad-4e5a-ab93-8d6d5b57c1ea
msgctxt "hf718ec27gfca3g426fgb707g0f09cddcacb8"
msgid "Best get yourself ready. Order's come down - we march."
msgstr "준비에 만전을 기해라. 명령이 내려왔다, 진군이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001
#. Speaker = Adept Mola
#. NodeID = 82601e6d-5878-44d7-82f6-085eb485aed1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_001_Hasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_001_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001:82601e6d-5878-44d7-82f6-085eb485aed1
msgctxt "he1f4692agc85eg421fg83cegb5601dfdcb84"
msgid ""
"You're not the first to brave the dark for the Absolute. The war camps are "
"full to bursting."
msgstr "절대자님을 위해 어둠에 맞서는 자가 네가 처음은 아니야. 주둔지는 이미 꽉 차서 터질 지경이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001
#. Speaker = Adept Mola
#. NodeID = d22f9a59-8841-4b26-9657-784f1cad6fcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_001_Hasmet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_001_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001:d22f9a59-8841-4b26-9657-784f1cad6fcb
msgctxt "h5e9203abgf3fbg4d4fgb334ga0bf5a1b440e"
msgid ""
"I've never been to Baldur's Gate. Make sure to leave some standing for us, "
"eh?"
msgstr "난 발더스 게이트에 가본 적 없어. 우릴 위한 자리도 좀 남겨달라고, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001
#. Speaker = Adept Mola
#. NodeID = d68c8d1e-3df1-422a-991a-f5d98f948ee8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingPathOpen = True
#.      - MOO_MutuallyExclusive_State_BalthazarReturn = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001:d68c8d1e-3df1-422a-991a-f5d98f948ee8
msgctxt "h58376b20g7f27g4739gbff1g0e9d6a1983f7"
msgid ""
"The General's advisor is back. He won't be happy to find empty cells below."
msgstr "장군님의 고문이 돌아왔다. 감옥이 비어있는 걸 보면 기뻐하진 않겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001
#. Speaker = Adept Mola
#. NodeID = fecbded4-30e8-48b0-9b34-433cfcee81af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_001_Hasmet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_001_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_001:fecbded4-30e8-48b0-9b34-433cfcee81af
msgctxt "h1ea326e7gbf3eg4aeeg84b6gf2134cd44987"
msgid ""
"Step wise around the Disciple - I've seen her do some dark things in this "
"room."
msgstr "신봉자 주변에선 조심해, 그녀가 이 방에서 뭔가 사악한 짓을 하는 걸 봤거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002
#. Speaker = Zealot Niram
#. NodeID = 083f9dc9-6c52-4368-8758-683f873822c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_002_Hasmet(1) = False
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_002_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002:083f9dc9-6c52-4368-8758-683f873822c7
msgctxt "hf6333e13g23bcg41d0ga22dg55fc0a7fe5c5"
msgid "To the city, True Soul! The waiting's done."
msgstr "도시로 간다, 참된 영혼! 기다림은 끝났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002
#. Speaker = Zealot Niram
#. NodeID = 4e0ea724-f015-4491-af4c-8c5634398c9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_002_Hasmet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_002_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002:4e0ea724-f015-4491-af4c-8c5634398c9a
msgctxt "hc2f4d8dbg6df4g4266g8750g4e9de7c82b9d"
msgid "In Her name."
msgstr "그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002
#. Speaker = Zealot Niram
#. NodeID = 51bf1864-6c0c-4cb5-8b1b-e47824f6e052
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_002_Hasmet(1) = True
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_002_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002:51bf1864-6c0c-4cb5-8b1b-e47824f6e052
msgctxt "hd9f966bdg9e50g4c7cga1d8g45b8ba6b5bcc"
msgid "Her eyes upon us all."
msgstr "그 분께서 모두를 지켜보신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002
#. Speaker = Zealot Niram
#. NodeID = 544611c5-7ad0-4e23-b3ac-48321510eb1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_002_Hasmet(1) = False
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_002_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002:544611c5-7ad0-4e23-b3ac-48321510eb1b
msgctxt "h8d32c5c7g9810g4cf9g8d63g1ca46e85225d"
msgid "You bested the Selûnite. You'll have to regale us all over drinks."
msgstr "셀루네 신도에게 이겼군. 우리 모두에게 술 한잔씩 돌리면서 이야기 해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002
#. Speaker = Zealot Niram
#. NodeID = 67f46d90-dc5e-40f8-acf4-f9ef93fdfa34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_002_Hasmet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_002_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002:67f46d90-dc5e-40f8-acf4-f9ef93fdfa34
msgctxt "h924bcd17g5786g42f2g85a8g646dbfe83ddb"
msgid "You'll be the General's favourite after this."
msgstr "이번 일이 끝나면 넌 장군님의 총애를 받게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002
#. Speaker = Zealot Niram
#. NodeID = db956d2a-2e3f-4e5e-abea-97321831cea2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_002_Hasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_002_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_002:db956d2a-2e3f-4e5e-abea-97321831cea2
msgctxt "h69188f93g95b8g4ffbg9029g177f48730f94"
msgid "Good luck, True Soul. The Disciple demands much of those who serve her."
msgstr "행운을 빈다, 참된 영혼. 신봉자는 자기를 섬기는 자에게 많은 걸 요구하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003
#. Speaker = Zealot Falla
#. NodeID = 01606184-8c01-aa3c-c409-a54a66257472
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_003_Hasmet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_003_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003:01606184-8c01-aa3c-c409-a54a66257472
msgctxt "ha816e743gc77ag4293gb15bg6eafa40289f9"
msgid "In Her name, Her design."
msgstr "그분의 이름으로, 그분의 계획대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003
#. Speaker = Zealot Falla
#. NodeID = 3ec8d406-e8ba-ce6e-f84b-49691713c36e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_003_Hasmet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_003_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003:3ec8d406-e8ba-ce6e-f84b-49691713c36e
msgctxt "h1bc872a5g3841g4daag8804ga47f883e1d22"
msgid "Can't say I'll miss this place. Absolute deserves a church, not a ruin."
msgstr "여기가 그립진 않을 거다. 절대자께선 이런 폐허보다는 교회가 더 어울리시니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003
#. Speaker = Zealot Falla
#. NodeID = 640882e8-846a-a419-0cc1-2517c30d2c44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_003_Hasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_003_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003:640882e8-846a-a419-0cc1-2517c30d2c44
msgctxt "h58c17dc8g9cc8g44fdgabcbgce2aecde0b7f"
msgid ""
"You'll find traders in the entrance hall. Absolute draws coin as well as "
"pilgrims, eh?"
msgstr "현관에서 상인들을 찾을 수 있을 거야. 절대자께선 순례자만 끌어들이시는 게 아니라 동전도 끌어들이시는구만, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003
#. Speaker = Zealot Falla
#. NodeID = f5de5b11-0b65-d902-0aa4-810e18e2c599
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_003_Hasmet(1) = False
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_003_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_003:f5de5b11-0b65-d902-0aa4-810e18e2c599
msgctxt "hb0831e61g2acag4b38gaca8g203dd3d7327c"
msgid "It's bloody happening. We're finally <i>going.</i>"
msgstr "이제야 실현되는군. 드디어 <i>가게 됐어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004
#. Speaker = Zealot Munish
#. NodeID = 2403f439-1428-524c-a82d-5861abb60f0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_004_Hasmet(1) = True
#.   Global:
#.      - MOO_Necromancer_State_AtMoonrise = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_004_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004:2403f439-1428-524c-a82d-5861abb60f0f
msgctxt "h814df3b0g3a34g4daega345g77156cf29742"
msgid "All things in Her design."
msgstr "모든 것은 그분의 계획대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004
#. Speaker = Zealot Munish
#. NodeID = 80eca9dd-c7dc-a325-8df4-9f00f63ee6af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_004_Hasmet(1) = False
#.   Global:
#.      - MOO_Necromancer_State_AtMoonrise = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_004_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004:80eca9dd-c7dc-a325-8df4-9f00f63ee6af
msgctxt "h0cea8907g250ag45f4ga1c7gd09b2fc12bb7"
msgid ""
"You rescued the General's advisor? Can't say I missed the screaming from his "
"chambers."
msgstr "장군님의 고문을 구출했다면서? 그의 방에서 들리던 비명이 그립진 않았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004
#. Speaker = Zealot Munish
#. NodeID = 8a9d8a9c-8499-c99d-0fbd-59bf009dfeda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_004_Hasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_004_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004:8a9d8a9c-8499-c99d-0fbd-59bf009dfeda
msgctxt "h4646f44cg2f8bg4b42ga9e3gb70106144ee4"
msgid "An honour, True Soul."
msgstr "영광이군, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004
#. Speaker = Zealot Munish
#. NodeID = bff35e18-927f-6762-274d-ef96ff0175ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_004_Hasmet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_004_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004:bff35e18-927f-6762-274d-ef96ff0175ce
msgctxt "ha4438099g6c52g420aga1e3g7e1db9b0a73c"
msgid "In Her name."
msgstr "그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004
#. Speaker = Zealot Munish
#. NodeID = de8ba7d7-4f8d-ca67-7298-8be0d6af06a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_004_Hasmet(1) = False
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_004_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004:de8ba7d7-4f8d-ca67-7298-8be0d6af06a3
msgctxt "he03df6d7ga509g45e0gad39g4cca785dc846"
msgid ""
"See you in the city, True Soul. My family's bakery will be spared - we'll "
"have ourselves a feast."
msgstr "도시에서 보자고, 참된 영혼. 우리 가족 빵집은 무사할 거야. 가서 축제를 열어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004
#. Speaker = Zealot Munish
#. NodeID = faabb76b-4eaa-de27-258e-8fa230fa0d60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_004_Hasmet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_004_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_004:faabb76b-4eaa-de27-258e-8fa230fa0d60
msgctxt "h690f719cgd7e8g4486gaf6cg8b0322e61c27"
msgid "I won't keep you, True Soul. Always Her work to be done."
msgstr "널 더 잡아두진 않겠다, 참된 영혼. 언제나 그 분의 일이 우선이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005
#. Speaker = Adept Nola
#. NodeID = 3586d1e8-15fb-4866-c1b9-5c57539294a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_005_Hasmet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_005_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005:3586d1e8-15fb-4866-c1b9-5c57539294a8
msgctxt "h3c731a8bg0157g461bgbf99g102b6b26b165"
msgid "Aye?"
msgstr "응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005
#. Speaker = Adept Nola
#. NodeID = 65907deb-a580-4c1d-f115-76120f8af1a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_005_Hasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_005_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005:65907deb-a580-4c1d-f115-76120f8af1a7
msgctxt "h87b32666g1c08g49d6gadb7gae80360bcfa3"
msgid ""
"Don't try giving orders, True Soul. Everyone here answers directly to Z'rell."
msgstr "명령을 내리려 하지 마라, 참된 영혼. 우리 모두는 즈렐에게 직접 보고한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005
#. Speaker = Adept Nola
#. NodeID = 6ef8b849-bbdf-f267-201c-e28561ff881a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_005_Hasmet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_005_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005:6ef8b849-bbdf-f267-201c-e28561ff881a
msgctxt "h874d12a0ga901g4840g9b28g9b7eebe5947e"
msgid ""
"I expect to be made True Soul myself by the time the fighting's done. Watch "
"me."
msgstr "전투가 끝날때 쯤엔 나도 참된 영혼이 되어있었으면 좋겠군. 지켜보라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005
#. Speaker = Adept Nola
#. NodeID = b7fdedd1-f1f1-bcad-7af7-d4d7d550e8e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_005_Hasmet(1) = False
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_005_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_005:b7fdedd1-f1f1-bcad-7af7-d4d7d550e8e9
msgctxt "h7d185942g7c39g49eeg93dfg6d3ff7c95cc4"
msgid "Settle your affairs, True Soul. The waiting's almost over."
msgstr "일을 마저 끝내라, 참된 영혼. 기다림의 시간이 끝나간다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006
#. Speaker = Zealot Rylveth
#. NodeID = 096f1691-6ec9-8bbf-d14c-2aec9a9f8308
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_006_Hasmet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_006_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006:096f1691-6ec9-8bbf-d14c-2aec9a9f8308
msgctxt "h09a30456g209bg46c3ga2b2gd4aa990e521e"
msgid ""
"I swore myself to Lolth for years. But <i>she</i> never let me sack a city."
msgstr "난 수년 동안 롤쓰를 섬겼지. 하지만 <i>그녀</i>는 절대 도시를 약탈하지 못하게 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006
#. Speaker = Zealot Rylveth
#. NodeID = 23e559b7-d16f-a580-f1c4-beff88153edb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_006_Hasmet(1) = False
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_006_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006:23e559b7-d16f-a580-f1c4-beff88153edb
msgctxt "h2cedb49eg352ag48acg8048g33c2cc5ed475"
msgid "Show no mercy in the battles to come. The Absolute watches us all."
msgstr "다가올 전투에선 자비를 보이지 마라. 절대자께서 우릴 지켜보고 계실 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006
#. Speaker = Zealot Rylveth
#. NodeID = beab1b22-98c9-fc3e-b646-2f7ca376c644
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_006_Hasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_006_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006:beab1b22-98c9-fc3e-b646-2f7ca376c644
msgctxt "h38d7ad20gd465g4488gb9c4gfe0763bc7103"
msgid ""
"No feuding under this roof, True Soul. We're all one under the Absolute - "
"more's the pity."
msgstr "여기서는 불화를 일으키지 마, 참된 영혼. 우리 모두 절대자님 아래에서 하나니까. 불행하게도 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006
#. Speaker = Zealot Rylveth
#. NodeID = c32a1c00-ed66-db61-5a09-34ae31b74d17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Execution_Guard_006_Hasmet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Execution_Guard_006_Hasmet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Execution_Guard_006:c32a1c00-ed66-db61-5a09-34ae31b74d17
msgctxt "h57a555bag10acg467cg9ee9g094f7042d075"
msgid ""
"I'd stick to your own provisions. They've got gnolls working the kitchens "
"here."
msgstr "직접 갖고 온 식량만 먹는 게 좋을 거야. 여기 주방에서는 요리를 놀들이 하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 027603d2-67ff-1ae8-9f24-5d22bd2f05a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:027603d2-67ff-1ae8-9f24-5d22bd2f05a7
msgctxt "h2a15c898gb890g4c08g9c96g78b0e9221b21"
msgid ""
"...and before I even ordered you to do so. Trying to make me look bad, True "
"Soul...?"
msgstr "내가 시키기도 전에 말이야. 날 무능해 보이게 하려는 건가, 참된 영혼...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 02ef6731-5d02-6d75-42fc-a24a33d01278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:02ef6731-5d02-6d75-42fc-a24a33d01278
msgctxt "hed3eeebdga72fg46f3g9fb4gada630928e24"
msgid "As if you did nothing to <i>prevent</i> it, perhaps?"
msgstr "마치 거기서 마커스의 실패를 <i>막지</i> 않은 것처럼 말이야, 안 그런가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 03dcdb41-f9c4-620d-1d5c-7699be7e577a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:03dcdb41-f9c4-620d-1d5c-7699be7e577a
msgctxt "ha9271520g1a27g490fg8804g80b822cea7c0"
msgid ""
"A worm that knows it is a worm. Had you only revealed it sooner, I would "
"have entrusted this task to someone worthy."
msgstr "자기가 벌레인 줄은 아는 벌레군. 좀 더 일찍 알았다면, 이 임무는 더 가치있는 자에게 맡겼을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 06071daa-5287-4430-6974-fa2f24c1762c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_DrowPartnerChosen(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:06071daa-5287-4430-6974-fa2f24c1762c
msgctxt "h5f36991fg1e91g4ee6g9a00g1e943b96f253"
msgid "<i>Distract her with thoughts of your night with Minthara.</i>"
msgstr "<i>민타라와의 밤을 떠올려 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 06c90802-bc75-fff9-df06-86250992b7b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:06c90802-bc75-fff9-df06-86250992b7b5
msgctxt "h01c1bb09gf960g453ag8a8cgc706ee15a6d8"
msgid ""
"*She sees the goblins walking free, and a burning rage fans across your mind "
"like wildfire.*"
msgstr "*그녀는 고블린이 무사히 풀려난 모습을 봅니다, 불타는 분노가 들불처럼 당신의 정신에 퍼져나갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 07f849c0-3596-40e7-afea-bb399106b9ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_KethericNeedsArtifact = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:07f849c0-3596-40e7-afea-bb399106b9ef
msgctxt "h4b4970cag9ca4g41c1ga37ag0a29c37e6307"
msgid ""
"The relic is vital to Ketheric's plans - you should be giving me more "
"support."
msgstr "유물은 케서릭의 계획에 필수적이야. 지원이 좀 더 있으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 088619f8-efcf-8c57-ff9e-b78385723dde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:088619f8-efcf-8c57-ff9e-b78385723dde
msgctxt "h9839eec5g4233g4c80g93a2gffa67d5fbe2a"
msgid ""
"Even so... you served the General well in this matter of the Nightsong. The "
"final judgement should be his."
msgstr "그렇지만... 너는 밤의 노래 건에서 장군님의 뜻을 잘 수행해냈지. 최종적으론 장군께서 판단하실 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 08c71693-7a49-0655-fff2-2e6bb948fd8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Event_AskedToKidnapIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:08c71693-7a49-0655-fff2-2e6bb948fd8c
msgctxt "h0641bd72gf0b4g4abfgafe9g336cd64b1a2b"
msgid ""
"Go to the inn, seize Isobel, and bring her back here - <i>alive</i>. Then "
"you will stand before the Absolute."
msgstr "여관으로 가서, 이소벨을 붙잡아 여기로 데려와라. <i>산 채로</i>. 그럼, 절대자님을 뵐 수 있을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 0af7c6a3-f290-1340-001a-7e159abb0186
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:0af7c6a3-f290-1340-001a-7e159abb0186
msgctxt "h0a17a729g2be0g4f1egb98cg2b8dedb1090d"
msgid "Unless I am sensing... <i>doubt</i>?"
msgstr "지금 느껴지는 게... <i>의심</i>이 아니라면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 0b7a18c6-e7ce-5bd3-5e10-1a01ad66b7c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:0b7a18c6-e7ce-5bd3-5e10-1a01ad66b7c6
msgctxt "haa7d4cc0gfa65g42dagbf6bgad7552d2f4bf"
msgid "So why are you here instead of out there, looking for him?"
msgstr "그래서 왜 발타자르를 찾지 않고, 여기에 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 0ba76b94-20d8-7710-d766-34622ea9126c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Executioner_State_AnnoyedAtPlayer(1) = True
#.      - MOO_Executioner_HasMet(1) = True
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:0ba76b94-20d8-7710-d766-34622ea9126c
msgctxt "hd9129dccg5a51g4d43ga8feg28cfe262d192"
msgid ""
"The great liberator. You should go and join your goblin friends out in the "
"curse."
msgstr "해방자 납셨군. 나가서 저주 받으면서 고블린 친구들과 놀지 그러나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 0be4a67b-1215-4ed1-4acf-d9a1a5bf6ed8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_UsedIllithidPowers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:0be4a67b-1215-4ed1-4acf-d9a1a5bf6ed8
msgctxt "h29d2adfeg44a2g43a2gb890g6384df59211d"
msgid ""
"*A pool of warmth spreads through your mind as she settles on the memory of "
"you commanding the goblins to die.*"
msgstr "*그녀가 당신이 고블린들에게 죽음을 명령하는 기억을 찾아내고, 당신의 정신 속에 따스함이 퍼져 나갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 0be89e10-c884-3f0e-e061-d8bd90caa90a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:0be89e10-c884-3f0e-e061-d8bd90caa90a
msgctxt "h1d6b6f9cgf93eg4808gaa59g7a9b6850b1c8"
msgid "Your confidence is delicious."
msgstr "자신감이 대단하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 0ddb6fe6-bc25-1671-0eef-677e2bbaef8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:0ddb6fe6-bc25-1671-0eef-677e2bbaef8c
msgctxt "h9d58be18g151dg4634ga50bgef5e866cd837"
msgid "Freedom? Your only purpose is to serve Ketheric and the Absolute."
msgstr "자유? 너의 존재의의는 케서릭과 절대자를 섬기는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 0f288007-8f2a-635d-dc8f-e5eadf2af278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:0f288007-8f2a-635d-dc8f-e5eadf2af278
msgctxt "h1bd34d71gf1cbg4d59g9b3dg808af6be6c09"
msgid "I am in awe of the power the relic must hold to be of such importance."
msgstr "이 중요한 유물이 가지고 있을 힘에 대한 경외심 때문이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 12126c2e-69b8-0507-5732-7ea2e0621a3e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_DrowPartnerChosen(1) = False
#.      - CAMP_GoblinHunt_State_ShadowheartPartnerChosen(1) = False
#.      - CAMP_GoblinHunt_State_WyllPartnerChosen(1) = False
#.      - CAMP_GoblinHunt_State_LaezelPartnerChosen(1) = False
#.      - CAMP_GoblinHunt_State_AstarionPartnerChosen(1) = False
#.      - CAMP_GoblinHunt_State_GalePartnerChosen(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:12126c2e-69b8-0507-5732-7ea2e0621a3e
msgctxt "h04bbb19dgff8ag4b2cgb678g098244b75a7d"
msgid "<i>Distract her with thoughts of your romantic desires.</i>"
msgstr "<i>연애에 대한 열망을 떠올려 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 127248be-7ac4-a28f-74e2-7330780833d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:127248be-7ac4-a28f-74e2-7330780833d5
msgctxt "hc5dd372agd377g4938g9a7eg9db50bf28633"
msgid "Hmmmm. You have used the wizard well."
msgstr "흐으음. 위저드를 잘 이용했군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 12751d19-c49b-83b8-64e7-1741fe7eb753
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:12751d19-c49b-83b8-64e7-1741fe7eb753
msgctxt "h11773b5cgbce6g44d0g9c62ge17914860c71"
msgid "My anger outweighs my love, but it's directed toward Her enemies."
msgstr "내 분노가 사랑보다 크긴 하지만, 그건 그 분의 적들에 대한 분노야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 137fda31-4b9b-5873-ba15-93d9789dcb83
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#.     - GLO_Event_SetSurprisedNextCombat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:137fda31-4b9b-5873-ba15-93d9789dcb83
msgctxt "hd9944817ge3c1g4427gbc95g9a78bb288531"
msgid ""
"A spy? Say a last prayer to your god, if you have one. You belong to us now."
msgstr "첩자인가? 믿는 신이 있다면 마지막 기도나 올려라. 넌 이제 우리 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1586c001-9be3-2118-5442-d2db13ada512
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1586c001-9be3-2118-5442-d2db13ada512
msgctxt "h016ea39egd20bg4c12g9157g3bc1e4086452"
msgid ""
"The relic is beneath the Thorm family mausoleum - that is where you will "
"find Balthazar."
msgstr "유물은 쏨 가문의 영묘 밑에 있다. 발타자르는 거기에 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 15fbe0c2-303a-25ef-b062-b5af348633bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:15fbe0c2-303a-25ef-b062-b5af348633bf
msgctxt "hf3c3359ag27afg4342g903eg1676b8c639ba"
msgid ""
"You serve General Thorm. A soldier does not question orders, or choose "
"whether to accept them."
msgstr "너는 쏨 장군을 섬긴다. 병사는 명령에 토를 달지도, 수행할지를 결정하지도 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 16248960-9826-4e4e-7eb0-a407da9c8802
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:16248960-9826-4e4e-7eb0-a407da9c8802
msgctxt "h118e75cdg3536g4adag98aeg5f451ae7fcb4"
msgid ""
"*There is a tremor of shared ecstasy as she finds a mirror to her own "
"desire.*"
msgstr "*그녀는 자신의 욕망을 똑같이 비추는 거울을 발견하고는 황홀경에 빠져 전율합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 165ad978-eefa-2989-91dc-f8ae0505c925
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_HasPartner(1) = True
#.      - CAMP_GoblinHunt_State_WentToBedAlone(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:165ad978-eefa-2989-91dc-f8ae0505c925
msgctxt "h65fddb83gdbbbg4a59g9206g02bc5e227c9f"
msgid ""
"You are desired, yet you choose to sleep alone. Are you sure you're not one "
"of Balthazar's walking corpses?"
msgstr "너를 원하는 이가 있는데, 너는 혼자 잠자리에 드는구나. 혹시 너도 발타자르의 걸어다니는 시체인 건 아니겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 166c1b95-6e6f-a2d2-7abc-f58638acfcec
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingLaezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:166c1b95-6e6f-a2d2-7abc-f58638acfcec
msgctxt "h1e8c347ag8531g4657g99adgb9f51d4ea51c"
msgid "<i>Distract her with thoughts of your dalliance with Lae'zel.</i>"
msgstr "<i>레이젤과 노닥거리던 기억을 떠올려 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 170ff10f-8493-c72d-b0c3-7a834919aef2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:170ff10f-8493-c72d-b0c3-7a834919aef2
msgctxt "h5b39c16bgd668g451ega3d0ge89aef42f2eb"
msgid ""
"Incapacitate the cleric, and our forces will seize her. They wait in the "
"shadows, ready to pounce."
msgstr "클레릭을 무력화시키면, 우리 병사들이 진입해 데리고 오겠다. 그림자 속에서, 칠 때만을 기다리고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 171478ea-5e84-7407-1398-f95fe814b0ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:171478ea-5e84-7407-1398-f95fe814b0ed
msgctxt "h43903313gce4dg4c21gbb92g9ab27d7e893e"
msgid ""
"The fact that you seem to know this place, these people, should make your "
"task all the easier."
msgstr "장소와 사람 모두 이미 알고 있는 것 같으니, 너에겐 쉬운 임무가 되겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 187f99c9-308d-4d76-b995-202de6bf1da5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Knows_KethericNeedsArtifact = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:187f99c9-308d-4d76-b995-202de6bf1da5
msgctxt "h23ddb996g2c7dg47dbgabb5g60a7aef30f60"
msgid ""
"<i>Whatever Balthazar is looking for, it's crucial to the war effort.</i>"
msgstr "<i>발타자르가 뭘 찾고 있었는지는 몰라도, 전쟁에 아주 중요한 물건이야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 1a258000-bdb4-2390-5907-13b3aa7b4673
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1a258000-bdb4-2390-5907-13b3aa7b4673
msgctxt "he33ecaedgbe9cg49eagbec2gf8ff94620590"
msgid "Dead, they're a waste. Free, they spread the word of the Absolute."
msgstr "죽인다면, 쓸모가 없지. 풀어주면, 절대자의 말씀을 전파하며 다닐테고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1a62d90d-f3a3-4d6e-0ec2-e2b40b52d3b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1a62d90d-f3a3-4d6e-0ec2-e2b40b52d3b1
msgctxt "h0ce26328g31bag4470ga0e3g340311a2d1aa"
msgid "...So you're not an incompetent, but an infidel. Oh, good."
msgstr "...그러니까 넌 무능한 게 아니라, 불신자인 거군. 오, 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1ba61b23-c782-3e64-f494-28a4963df386
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1ba61b23-c782-3e64-f494-28a4963df386
msgctxt "h78daf104g2e74g4a3egba46gc3f7234b5537"
msgid "It will likely be the last thing you do."
msgstr "그게 네 마지막 일이 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 1bc777df-b130-9d61-3b47-79d9b6b7b223
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1bc777df-b130-9d61-3b47-79d9b6b7b223
msgctxt "ha8e3f2c7g688dg4d17gade1g0d9efac71282"
msgid "Why not ask Marcus yourself? I'll send you to join him."
msgstr "본인에게 직접 물어보지 그래? 마커스 곁으로 보내 주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1d2a3ef8-8437-ffca-bc90-b6472b0687c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1d2a3ef8-8437-ffca-bc90-b6472b0687c9
msgctxt "h6341f468g99b0g4d55g93aag21368a606907"
msgid ""
"Let's see if there's <i>anything</i> interesting in this brain of yours."
msgstr "그럼 네 머릿속에 <i>뭔가</i> 재밌는 건 없는지 한번 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1d37c9b7-a500-246b-4aa6-882b58ac7869
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1d37c9b7-a500-246b-4aa6-882b58ac7869
msgctxt "h33376c8ag7c3eg4b3ag9baage51bdf0e0fdc"
msgid "Yes. Word of the Absolute's mercy - and mercy is not in Her vocabulary!"
msgstr "그래. 절대자님의 자비를 전하겠지. 그리고 절대자님의 사전에 자비란 없어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1d408c16-cbd0-abdb-4db7-74640d58977f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Executioner_HasMet(1) = True
#.   Global:
#.      - MOO_Executioner_State_DeadSpyQuip = True
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_State_DeadSpyQuip = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1d408c16-cbd0-abdb-4db7-74640d58977f
msgctxt "hc217f40cg1763g43f8gbd02g35ad10576a05"
msgid ""
"You haven't disappointed me yet, True Soul. I hope, for your sake, you're on "
"Balthazar's trail."
msgstr "난 아직 너에게 실망하지 않았어, 참된 영혼. 너를 위해서라도, 네가 발타자르를 쫓고 있었으면 하는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 1e5f09f9-ae4e-c295-2abb-98448f65ec07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedAboutNecromancer = False
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Event_AskedAboutNecromancer = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1e5f09f9-ae4e-c295-2abb-98448f65ec07
msgctxt "h0e0241f3g2aadg4f89gb50cg8a0faab169a8"
msgid "What if Balthazar's already dead?"
msgstr "발타자르가 이미 죽었으면 어떻게 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1efa0b21-022e-7d3e-5745-96f0dba41d0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1efa0b21-022e-7d3e-5745-96f0dba41d0a
msgctxt "hd9a7fb0bg9cb4g4f1dg9d88g7c019839f253"
msgid ""
"Thanks to your interference, she is dead, and the General is most displeased."
msgstr "네가 방해한 덕분에, 그녀가 죽었고, 장군께선 아주 불만이셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 1f3a7b32-e080-1407-e562-1fea3443d510
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1f3a7b32-e080-1407-e562-1fea3443d510
msgctxt "hd34feb65g55acg47a7gad0dg0e444b29027b"
msgid "Whatever has become of him, it is the relic that matters."
msgstr "그가 어떻게 되었든, 중요한 건 유물이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 1fb1d7aa-0559-ff65-7cfd-9cb65e7e0115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:1fb1d7aa-0559-ff65-7cfd-9cb65e7e0115
msgctxt "h220e960dgd2a2g4683g8bd2gcd62e09e19ed"
msgid "What if Balthazar's dead?"
msgstr "발타자르가 죽었으면 어떻게 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 20b8b37b-75e8-60d5-0a4d-c586835d3ab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:20b8b37b-75e8-60d5-0a4d-c586835d3ab3
msgctxt "hdff38bf6g6019g4b3ag90fegedb0af19f058"
msgid "Or She will consume you."
msgstr "그렇지 않으면 그분께서 널 잡아먹으실테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 222c3f04-0f8d-5e10-a290-c0391796652a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:222c3f04-0f8d-5e10-a290-c0391796652a
msgctxt "h51b93069gbc8ag4fe0gb342g0f0760f069ab"
msgid ""
"How curious - I've only ever known Minthara to moan with pleasure when "
"somebody's losing a limb."
msgstr "놀라워라. 민타라는 누구 팔다리가 잘려나갈 때만 그렇게 신음하는 줄 알았는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 227ffc5a-d095-f3ff-4fd9-ce4cb8dad21d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:227ffc5a-d095-f3ff-4fd9-ce4cb8dad21d
msgctxt "hdd12d9f2g0fcag42d7ga7fbg662c45c57215"
msgid "I enjoy killing those <i>so</i> much more."
msgstr "불신자를 죽이는 게 <i>훨씬</i> 재밌거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 22a5ec49-b194-3b16-329c-551c8d059e5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:22a5ec49-b194-3b16-329c-551c8d059e5d
msgctxt "h640ddee6g4810g4267gb76ag3afbc401d6be"
msgid ""
"Balthazar is still missing. Your success with Isobel will count for little "
"if you don't find him."
msgstr "발타자르는 여전히 실종 상태다. 그를 찾아 오지 않으면 네가 이소벨을 데려온 것도 별 소용이 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 22b219ad-b88b-ae49-6e12-473ed14d83db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_IsobelDebrief = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:22b219ad-b88b-ae49-6e12-473ed14d83db
msgctxt "h0d812740g8cc7g4e1fg930dg38f3ad385b08"
msgid ""
"And as you've already seen to Isobel's rescue, there's no need for me to "
"keep you any longer... though I could think of a thing or two..."
msgstr "그리고 이미 이소벨을 구출했으니, 널 더이상 데리고 있을 필요도 없어졌어... 뭐 한 두가지 떠오르는 건 있지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 22fc611a-8b90-1b73-6bac-64a3bc53cd5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:22fc611a-8b90-1b73-6bac-64a3bc53cd5e
msgctxt "h94b8a82dg58b8g470dg9511g854d23748997"
msgid "By serving General Thorm - I have a mission for you."
msgstr "쏨 장군을 섬기면 된다, 내가 임무를 하나 주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 2318d0ae-ca8a-a6b2-7528-d359b536bc54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2318d0ae-ca8a-a6b2-7528-d359b536bc54
msgctxt "hdda0009dg484dg4d3ega2b6g74373fa578ab"
msgid ""
"Either you show patience, or I'll show you some of my talents in the "
"dungeons. The Absolute's bidding <i>will be done</i>."
msgstr "네가 인내심을 보이지 않으면, 내가 지하 감옥에서 뭘 하는지 보여주겠다. 절대자님의 명령은 <i>이행될 것이다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 23722378-0392-0306-4fa9-b79e1e2d9281
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Audience_State_GrantedPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:23722378-0392-0306-4fa9-b79e1e2d9281
msgctxt "h69f0ed67gdbe2g4942gb83bg088302dc8abc"
msgid ""
"To be precise, <i>General Thorm</i> ordered that you bring her here alive. I "
"am merely an instrument of his will."
msgstr "정확히는, <i>쏨 장군님</i>께서 생포해 오라셨지. 난 그저 그분의 의지를 대행할 뿐이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 24f8e4b4-be0e-3a7a-8a8c-83a6a661b918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:24f8e4b4-be0e-3a7a-8a8c-83a6a661b918
msgctxt "h8550e7b0g0fbfg41efgb271g0b94b20546bb"
msgid ""
"*You feel her grasp within your thoughts for familiar, roiling zealotry. It "
"finds no purchase.*"
msgstr "*그녀가 당신의 생각 속에서 요동치는 광신을 찾는 것이 느껴집니다. 그녀는 아무것도 찾지 못합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Astarion
#. NodeID = 253d7ccb-f066-9f0d-426c-273cd0eaa55d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 2812a3a3-b4ef-20ce-cc3e-e5a9315568eb_GotAstarionInclusion = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:253d7ccb-f066-9f0d-426c-273cd0eaa55d
msgctxt "hb7fe6bc5g40b1g4b8fg88f2geb5f0d8531a3"
msgid "Warm bodies <i>and</i> quick minds? We might have to meet you halfway."
msgstr "따뜻한 몸이랑 빠른 정신 <i>둘 다</i>? 둘 다는 힘든데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 25c701ba-c53f-dd80-d826-cdfebce049e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_FightGoblins = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:25c701ba-c53f-dd80-d826-cdfebce049e1
msgctxt "h50e90cefg09deg4250gbcb6g6ad80d3a780a"
msgid ""
"*Tongues of psychic flame lap at the memory of the goblins dying by your "
"hand.*"
msgstr "*당신이 고블린들을 살해하는 기억에, 정신의 불길이 솟구쳐 오릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 280db0bc-ad95-2aec-9078-eafed2ba461c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingShadowheart(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:280db0bc-ad95-2aec-9078-eafed2ba461c
msgctxt "h87cfabceg8ca8g4e99gbf8ag345076f2828c"
msgid "<i>Distract her with thoughts of your care for Shadowheart.</i>"
msgstr "<i>섀도하트에 대한 연민을 떠올려 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 2918a600-8654-4b6b-98d5-a775f836c8a4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_AboutArtefact = False
#.      - MOO_Executioner_Knows_KethericNeedsArtifact = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2918a600-8654-4b6b-98d5-a775f836c8a4
msgctxt "h4f2fcb4ag4551g4eb2gace3gb64e2fbf7132"
msgid ""
"<i>She became anxious when you asked about the relic - probe her "
"thoughts.</i>"
msgstr "<i>그녀는 유물에 대해 질문을 받고는 불안해 했다. 그녀의 생각을 들여다본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 29a9a975-b7ad-cb9d-2ffe-e5b2ff550085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:29a9a975-b7ad-cb9d-2ffe-e5b2ff550085
msgctxt "hfd62ff1dg37a6g4b01ga198gad72cd9bd806"
msgid "Yes. I have an eye on your position."
msgstr "그래. 네 자리에 관심이 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 2a124ff6-6e6c-d64a-6931-d047cffdc2e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Executioner_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2a124ff6-6e6c-d64a-6931-d047cffdc2e4
msgctxt "h06833e7ag4cc0g4fb8g8835ge0693d011b70"
msgid "The goblins - tell me how they suffered."
msgstr "그 고블린들에게, 어떤 고통을 주었는지 말해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 2a4a3c2a-b131-e197-42ef-339bebf8f830
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#.      - MOO_Isobel_State_AtMoonrise = True
#.      - HAV_Isobel_State_IsDead = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Executioner_HasMet(1) = True
#.   Global:
#.     - MOO_Execution_Event_IsobelDebrief = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2a4a3c2a-b131-e197-42ef-339bebf8f830
msgctxt "h4b1bef87gcc6fg4d5fg8897g123424fe4db6"
msgid ""
"I see you've taken it upon yourself to rescue Isobel for General Thorm..."
msgstr "직접 쏨 장군님을 위해 이소벨을 구출해 온 모양이더군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 2aef3cfc-c306-ad8c-2f8c-9366d7102a9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2aef3cfc-c306-ad8c-2f8c-9366d7102a9d
msgctxt "hbbbc646fg1077g4718g9bafg798c573ac400"
msgid ""
"*For a moment, there is ecstasy as she finds a mirror to her own desire, but "
"then your mind is pulled taut, stretched thin.*"
msgstr "*잠시 동안, 그녀는 자신의 욕망을 똑같이 비추는 거울을 발견하고는 황홀경에 빠집니다. 하지만 곧 당신의 정신은 흐트러집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 2b661f1b-118a-3694-fc3b-466011f83f16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Event_GuardDies = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2b661f1b-118a-3694-fc3b-466011f83f16
msgctxt "h509cb010gaa5cg4279g9c15g9fe7383242d9"
msgid "She gave me the power to cut the thread of life with a thought."
msgstr "그 분께서는 내게 생각만으로 생명의 끈을 끊어버릴 힘을 주셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 2cc07bec-e894-f352-76a5-a19b901fa07d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2cc07bec-e894-f352-76a5-a19b901fa07d
msgctxt "hd08e26c4ga372g4485gb581ga9263ffd15c4"
msgid ""
"This place is full of lackeys you can send on errands - I want what was "
"promised."
msgstr "심부름 시킬 아랫것들은 잔뜩 있잖아. 약속했던 걸 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 2ec39c39-bc07-5c83-0dd7-1f863a78b9ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Executioner_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2ec39c39-bc07-5c83-0dd7-1f863a78b9ef
msgctxt "h39e4b908gd26bg4fd0gbefegaaf594e92e01"
msgid ""
"General Thorm's prayers and preparations must not be disturbed. The rooftop "
"is off-limits to everyone."
msgstr "쏨 장군님의 기도와 준비는 방해해서는 안된다. 지붕 위엔 아무도 올라가선 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 2fe89425-f82d-4ba3-7a9a-83ad5b2412de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:2fe89425-f82d-4ba3-7a9a-83ad5b2412de
msgctxt "h05bb92ddg6de6g420dg9608g25b723ba5e7e"
msgid "<i>Distract her by drawing her toward your hunger for power.</i>"
msgstr "<i>힘에 대한 당신의 갈망으로 그녀를 교란한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 307a6016-7ec4-caf0-32e3-d0d7476ff5c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:307a6016-7ec4-caf0-32e3-d0d7476ff5c9
msgctxt "h8cf441d3g5ffeg4c59gaae5g13325d805ea2"
msgid "Oh, I <i>like</i> you. That was inventive, and efficient."
msgstr "아, 너 <i>맘에 들었어</i>. 창의적이고, 효율적인 처분이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 316ea61a-7e87-bd6d-25f7-38c38f789435
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:316ea61a-7e87-bd6d-25f7-38c38f789435
msgctxt "h6e85014dg3fa9g44e4ga228g1373ddefc285"
msgid ""
"Lies. You would harm Her if you could - I see that clearly. But you'll never "
"have the chance."
msgstr "거짓말. 할 수만 있다면 그분을 해치려 하는군, 내가 똑똑히 봤어. 하지만 네겐 기회조차 오지 않을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 3175f37f-24db-f1a0-f271-0473ebc53780
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Audience_State_GrantedPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3175f37f-24db-f1a0-f271-0473ebc53780
msgctxt "h81d9e776gd435g447fg915dgeede290dbc4c"
msgid ""
"General Thorm waits at the top of the tower. Hurry on, or he may be tempted "
"to throw you over the edge."
msgstr "쏨 장군님은 탑 꼭대기에서 기다리신다. 서둘러, 아니면 장군님께서 널 절벽으로 던져버리려 하실지도 모르니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 32a160e0-75d5-5082-b900-99ff17b9edb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:32a160e0-75d5-5082-b900-99ff17b9edb5
msgctxt "h661c587bgf784g4df4gb6e2g1a91de00751c"
msgid "It was not my doing - the shadows consume all in their path."
msgstr "내가 한 거 아니야, 그림자는 자기 가는 길에 있는 걸 다 삼켜버리잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 332f897b-0cc7-582c-0b4a-1e87bd241f2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:332f897b-0cc7-582c-0b4a-1e87bd241f2e
msgctxt "hed34c2cag7ba9g493dgbad1g684b72d858ac"
msgid "Got any more for me to punish?"
msgstr "내가 처벌해야 할 게 더 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 33bf583a-d777-c02b-4a98-6bb35b2d5917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:33bf583a-d777-c02b-4a98-6bb35b2d5917
msgctxt "hee531b9fg7561g4759g99d1g8fb3c747b23d"
msgid ""
"*Her mind enters yours abruptly, flickering across your memories in a blaze "
"of excitement.*"
msgstr "*그녀의 정신이 당신의 정신으로 불쑥 들어와, 흥분한 듯 당신의 기억을 훑어봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 33e0cc67-78b5-2b4e-a5bb-491aa2869eb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:33e0cc67-78b5-2b4e-a5bb-491aa2869eb8
msgctxt "hbb3de09dgaeb9g48e8gaef6g1ac52932d606"
msgid "Good for you. How do I get what <i>I</i> want?"
msgstr "잘됐네. <i>내가</i> 원하는 건 어떻게 얻을 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 33efae7c-ae38-8e97-f2a3-f85eb77c9275
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:33efae7c-ae38-8e97-f2a3-f85eb77c9275
msgctxt "h53b17cc3g91b9g4e13g8e4bgf7b9bcbf3ed9"
msgid "And done <i>quickly</i>, I trust."
msgstr "<i>빨리</i> 했으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 35a29dc2-d81a-a668-e44b-287fe1137b41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:35a29dc2-d81a-a668-e44b-287fe1137b41
msgctxt "hfc433287g24f5g474egb3acgecbaa8d7adb1"
msgid ""
"Aside from her heresy? Every soul sworn to another god is stolen from ours."
msgstr "그녀가 이단이란 걸 제외하면? 다른 신을 섬기는 영혼은 모두 원래 우리의 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 35a7ebea-de8c-f216-fcaf-11dbd2dd278d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:35a7ebea-de8c-f216-fcaf-11dbd2dd278d
msgctxt "hfd556a3bgf2a2g4013g9e0ag41bb2168601b"
msgid ""
"<i>Think in Thieves' Cant, masking your true thoughts as Absolutist "
"zealotry.</i>"
msgstr "<i>도둑의 은어로 생각해, 당신의 생각을 절대자 광신으로 위장한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 360edc9e-44c8-dafd-26d3-7782429fc526
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:360edc9e-44c8-dafd-26d3-7782429fc526
msgctxt "h46505a89g1e39g45f8g962cg40eb041b26d4"
msgid ""
"You can be among them. I have a mission that will earn you the General's "
"favour."
msgstr "너도 함께할 수 있어. 네게 줄 임무가 있다. 수행하면 장군님의 총애를 받을 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 3719a804-ebcb-c43f-17e0-4dee139863c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3719a804-ebcb-c43f-17e0-4dee139863c8
msgctxt "ha8acb76egfa30g4140gb0ddg91635abfe6e6"
msgid "Sounds like being your underling would be quite enjoyable."
msgstr "네 부하가 되는 건 꽤나 즐거울 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 383188ae-fc97-5a26-c748-3be1c569db45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:383188ae-fc97-5a26-c748-3be1c569db45
msgctxt "h1ba50603g5e7eg42f6gaf36g1ee9a129c02f"
msgid "Oh, good. I love answering questions."
msgstr "오, 좋아. 내가 대답하는 걸 참 좋아하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 38e4e25e-d4f0-114e-5819-09ef1bbecb69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:38e4e25e-d4f0-114e-5819-09ef1bbecb69
msgctxt "h192b0a6cg90acg479ag8278gf8a436936573"
msgid "<i>Empty your mind. Show her a perfect, harmonious soul. </i>"
msgstr "<i>정신을 비운다. 완벽하고 조화로운 영혼을 보여준다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 39508097-51b2-01f8-dc76-f1b0206adbf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:39508097-51b2-01f8-dc76-f1b0206adbf4
msgctxt "h36ee3c09g4490g46aeg9b31ga4429fb97ed9"
msgid "For a while. But I get bored of people awfully quickly."
msgstr "잠깐은 그렇지. 근데 난 사람에게 엄청 빨리 질리는 편이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 397827be-5641-ea5c-3baf-724a1bb92631
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Executioner_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:397827be-5641-ea5c-3baf-724a1bb92631
msgctxt "h78f31fd5gf9dfg4a12gabecg4795ea2ea346"
msgid ""
"I already gave orders to your companions - find the necromancer Balthazar. I "
"spoke slowly, to make sure they'd understand."
msgstr "난 이미 네 동료들에게 명령을 내렸다. 사령술사 발타자르를 찾아오라고 말이야. 확실히 이해하도록, 천천히 말했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 3c4e562e-2ef9-6568-f5e5-0faccaf047b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3c4e562e-2ef9-6568-f5e5-0faccaf047b8
msgctxt "h96e5d27bg0c35g49c3g8a24gdca509efabf9"
msgid "*You feel her mind recoil from yours... disappointed.*"
msgstr "*그녀의 정신이 당신에게서 떨어져 나가는 것이, 실망이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 3c4e9db8-cb45-21cd-ce32-b7d27060074e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3c4e9db8-cb45-21cd-ce32-b7d27060074e
msgctxt "hcb327a26gf05cg460cgbbf4g73bb3fc2469f"
msgid "The Absolute doesn't demand celibacy - only obedience to Her design."
msgstr "절대자께서는 순결을 요구하지 않으신다. 그분의 설계에 대한 순종만 있으면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 3d1b91ee-e6aa-e792-4760-8acff80baee8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3d1b91ee-e6aa-e792-4760-8acff80baee8
msgctxt "h25d27b9ag5c50g4f31ga5c4gcad097f25ebb"
msgid "Go and snuff it."
msgstr "가서 꺼버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 3d348742-f164-ef75-48d2-02c7d41ff34a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3d348742-f164-ef75-48d2-02c7d41ff34a
msgctxt "h5b96c510g76f7g4e1bgab95gaaa91f42a695"
msgid "And enjoyable. Got any more minions to punish?"
msgstr "재미도 있지. 또 처벌할 놈들 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 3d5f9b33-16bb-51d1-c618-e868ac4d6f05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3d5f9b33-16bb-51d1-c618-e868ac4d6f05
msgctxt "h433cdc66gde07g4bf7g9683g1b4380c23993"
msgid ""
"Rescued, abducted, pleasure, pain... All a matter of perspective. This is "
"where she belongs - with General Thorm."
msgstr "구출이니, 납치니, 기쁨이니, 고통이니... 전부 관점의 차이지. 그녀가 있을 곳은 여기, 쏨 장군 곁이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 3d9790a7-6913-cd9d-5957-aeb4813cbdef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3d9790a7-6913-cd9d-5957-aeb4813cbdef
msgctxt "h15f2ec9dgb046g4d34g8394gc37031890ec6"
msgid "A child could have done it."
msgstr "어린애도 할 수 있는 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 3dab185c-c34f-374d-3d88-6a41086f07e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_State_AnnoyedAtSomeone = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:3dab185c-c34f-374d-3d88-6a41086f07e9
#, fuzzy
msgctxt "ha0d83eefge2bcg4ca5gb40bgd1309bd76be4"
msgid ""
"I've dealt with too much ineptitude already today, and my patience is "
"wearing thinner than a necromancer's bedmate."
msgstr "오늘 무능한 놈들을 너무 많이 봐서, 인내심이 사령술사의 파트너보다도 말라 붙을 지경이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 405939b1-88a3-666b-7073-a1fec7e3dafd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Wisdom
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:405939b1-88a3-666b-7073-a1fec7e3dafd
msgctxt "h4269f776g6c6bg4747gbf65g2772abf10ea7"
msgid ""
"<i>Bring to mind your years of rigorous combat training - show her the "
"depths of your dedication. </i>"
msgstr "<i>당신의 몇 년에 걸친 체계적 전투 훈련을 떠올린다. 당신의 헌신의 깊이를 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 414fd91f-ffe7-50f4-da82-d6afa6e62738
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:414fd91f-ffe7-50f4-da82-d6afa6e62738
msgctxt "h5d97d9b3g7a65g42f2gba4fgf7fde16bd24b"
msgid ""
"An eye accompanied him - it was destroyed shortly after he left Moonrise."
msgstr "눈 하나가 그와 동행했다. 그가 문라이즈를 떠난 직후에 파괴되었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = 41b5efe0-c6f2-396c-7d75-defaa94e0a4a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:41b5efe0-c6f2-396c-7d75-defaa94e0a4a
msgctxt "h868d31a7gc733g4779gb101g374cd126986c"
msgid "You're so close. Don't lapse now."
msgstr "거의 다 왔어요. 여기서 실수해선 안 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = 41b5efe0-c6f2-396c-7d75-defaa94e0a4a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:41b5efe0-c6f2-396c-7d75-defaa94e0a4a
msgctxt "heaa4c4b9g0fcbg4ba2g918bg7ec74951bc68"
msgid "You're so close. Don't lapse now."
msgstr "거의 다 왔어요. 여기서 실수해선 안 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 4346b774-e097-88ea-5bd0-c23b3de8c03d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Isobel_State_AtMoonrise = True
#.      - HAV_Isobel_State_IsDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:4346b774-e097-88ea-5bd0-c23b3de8c03d
#, fuzzy
msgctxt "hce7096b6ga1f5g4d20g83e1g9638fd03a33b"
msgid ""
"Plus, if that wasn't enough, you've already rescued Isobel from Last Light. "
"What an eager little thing you are."
msgstr "게다가, 그걸론 충분하지 않았는지, 이미 이소벨을 최후의 빛에서 구출해 오기까지 했지. 참 열성적인 녀석이로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 43e73c4a-2b18-3104-96fa-90fe9d61f927
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:43e73c4a-2b18-3104-96fa-90fe9d61f927
msgctxt "hbef268a5gb20bg4379ga333gb462c8aba9cc"
msgid "*She pushes into your mind violently, touching your wants and hopes.*"
msgstr "*그녀가 당신의 정신 속으로 거칠게 들어와, 당신의 욕망과 소망을 어루만집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 441137f2-0c09-c3de-f004-de4cef3054b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:441137f2-0c09-c3de-f004-de4cef3054b7
msgctxt "h8f05dcf8gc082g488dg8311g66f02f996ac2"
msgid "Insolence bores me. It is obedience I require."
msgstr "불손함에는 관심 없다. 내가 원하는 것은 복종이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 4532f031-4902-a781-48da-98f4b713bfd3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Knows_AboutArtefact = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:4532f031-4902-a781-48da-98f4b713bfd3
msgctxt "h41cf828cge4dfg4131gac17ge2016130c82f"
msgid ""
"*She's suddenly nervous - on edge. Talking about the relic makes her "
"anxious.*"
msgstr "*그녀가 갑자기 초조해합니다. 그녀는 유물에 대해 말하는 것을 불안해합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 45ea9763-4333-2336-582c-2765d6b46fea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:45ea9763-4333-2336-582c-2765d6b46fea
msgctxt "he82ec09dg1744g401bg978fgb9a1a992696a"
msgid "Let's see if <i>you</i> can hold my interest."
msgstr "<i>네가</i> 내 관심을 잡아둘 수 있을지 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = 461e935f-37fb-b521-6541-81adfcbaa28d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:461e935f-37fb-b521-6541-81adfcbaa28d
msgctxt "hbbc0cb25g5130g4eaega8c9gfdec4554bd2b"
msgid "Yes, this is it!"
msgstr "좋아요, 바로 이거예요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = 461e935f-37fb-b521-6541-81adfcbaa28d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:461e935f-37fb-b521-6541-81adfcbaa28d
msgctxt "had365b96g9dbeg4556gbdfdgf057f3849d05"
msgid "Yes, this is it!"
msgstr "좋아요, 바로 이거예요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 469da99e-aa5a-e204-1c66-b3f6b4d5bb2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:469da99e-aa5a-e204-1c66-b3f6b4d5bb2a
msgctxt "hb7fbf682g1afbg40c5g8c55ge151efb9566f"
msgid ""
"*You feel her presence in your head again. She grips your mind, squeezing "
"until your vision blurs with pain.*"
msgstr ""
"*당신의 머리 속에 그녀의 존재가 다시 한 번 느껴집니다. 그녀가 당신의 정신을 쥐고, 고통으로 당신의 시야가 흐려질 때까지 쥐어 "
"짭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 47fe222e-1903-b6eb-301a-9e78d3ffdae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:47fe222e-1903-b6eb-301a-9e78d3ffdae7
msgctxt "h07d82897g3579g4f5bgabf5gf21fc3ce7bc1"
msgid "I knew you'd see sense."
msgstr "사리분별은 할 줄 아는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 488b86a2-bff2-3d55-404a-e7f9361b374b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:488b86a2-bff2-3d55-404a-e7f9361b374b
msgctxt "h9e94d891gd68ag4958g92c3g591ddcc1e56f"
msgid ""
"Eager, motivated - call it what you like. So long as you give me what was "
"promised."
msgstr "열성적이든, 적극적이든, 맘대로 불러. 약속한 걸 주기만 한다면야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 48cd2871-51b9-8f75-4d2b-aa8f182a2c09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:48cd2871-51b9-8f75-4d2b-aa8f182a2c09
msgctxt "h1bf60bb2g0f4dg4d7fg81b6gc0370fb671fa"
msgid ""
"With the Absolute, your fantasies can become more real than flesh. The "
"pleasures of the mind can surpass those of the body."
msgstr "절대자님과 함께라면, 네 환상은 육신보다 더 현실에 가까워질 수 있다. 정신적 쾌락이 육체적 쾌락을 뛰어넘을 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 4a97ffeb-5b6b-0963-88b4-38e43e3f6ede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:4a97ffeb-5b6b-0963-88b4-38e43e3f6ede
msgctxt "hf75ec499gef66g4ae8ga091g03b383c85b06"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 4bdeb966-1d46-ec6f-4966-fbe8a32f92e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithKarlach(1) = False
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:4bdeb966-1d46-ec6f-4966-fbe8a32f92e9
msgctxt "hddeea085ge61bg4fb9gb9d8ga8bf76f6a69b"
msgid ""
"You have quite the imagination. But that's all it can ever be with you two. "
"<i>Imagination</i>. The Absolute offers the real."
msgstr "상상력이 대단하군. 하지만 너희 둘 사이는 그걸로 끝이지. <i>상상</i>. 절대자께서 주시는 것은 현실이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 4cbd49dc-8a3c-1403-b348-94e64ea5fc07
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:4cbd49dc-8a3c-1403-b348-94e64ea5fc07
#, fuzzy
msgctxt "hc2741fcfg2103g4d4fgb7f5g9503f161336b"
msgid ""
"Forget your love. I have seventeen husbands, scattered across the Coast's "
"shores. They are mere meat."
msgstr "네 애인은 잊어라. 난 코스트 전역에 남편만 17명이 있어. 전부 고깃덩이에 불과하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 4d19765f-91e3-1d18-47fd-56103d8b9cde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:4d19765f-91e3-1d18-47fd-56103d8b9cde
#, fuzzy
msgctxt "h0d3a2575g509cg4f0fg901eg31867b30dde9"
msgid ""
"Never trust an ancient and mysterious curse to do what you could do with "
"your own mind. Or a knife."
msgstr "잘 알지도 못하는 고대의 저주를 믿느니 직접 네 정신으로 해결하는 게 나아. 칼이나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 4eaf1620-c739-71ea-b04a-0a9bc596a6ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:4eaf1620-c739-71ea-b04a-0a9bc596a6ae
msgctxt "h3d3a062dg3a8eg4570g94bbgd14a3db9b3bf"
msgid "Consider it done."
msgstr "그렇게 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 50e750ac-2c48-869f-365f-5b1883d9ba11
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Knows_KethericNeedsArtifact = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:50e750ac-2c48-869f-365f-5b1883d9ba11
msgctxt "h1b8fa87dgdd9fg4c73g87a8g19df5c15fe32"
msgid "General Thorm will not leave Moonrise without it."
msgstr "쏨 장군께서는 그것 없이 문라이즈를 떠나지 않으려 하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 52335b53-82cc-0757-0249-98f56fc6a172
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Audience_State_GrantedPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:52335b53-82cc-0757-0249-98f56fc6a172
msgctxt "h41d98d45g80dbg4179ga1eege32568749abc"
msgid "Go on, now. The General is not a man to keep waiting."
msgstr "이제 가봐. 장군님께선 기다리시는 분이 아니거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5298496c-8ae2-145e-02c5-cb83bc893b7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5298496c-8ae2-145e-02c5-cb83bc893b7e
msgctxt "h2eda7502g511ag4e4fg8557g70fcbac2847c"
msgid "Traitorous dog."
msgstr "개같은 반역자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 52d654f6-6734-1407-caac-81140d5c9210
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:52d654f6-6734-1407-caac-81140d5c9210
msgctxt "hb9ae4189g1293g4a1dg8d61g56a0a990da9c"
msgid ""
"But I will let the General explain that to you. You served him well in the "
"matter of the Nightsong, after all."
msgstr "하지만 밤의 노래 건은 잘 처리했으니까, 그건 장군님께서 직접 설명하시도록 두지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 52fc32c0-6fad-4d39-7e75-96330669f59e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:52fc32c0-6fad-4d39-7e75-96330669f59e
msgctxt "h75701fc6gc7e3g4ca3g8d27g8243b2dd1125"
msgid ""
"I choose to serve, and I am glad to. Your words are dangerously close to "
"heresy, True Soul."
msgstr "그건 내가 선택한 것이고, 나는 섬길 수 있어 기쁘다. 너의 말은 위험할 정도로 이단에 가깝구나, 참된 영혼이여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 537433f4-efa7-ba40-917e-48c209960ff3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:537433f4-efa7-ba40-917e-48c209960ff3
msgctxt "h974851bag1c9fg4053g9d58g28f545e2f329"
msgid ""
"East, in a blemish of moonsglow, piercing the dark - it is aptly named, this "
"Last Light."
msgstr "동쪽. 달빛의 흠집 속에, 어둠을 꿰뚫는 곳이다. 이 최후의 빛이라는 이름이 어울리는 곳이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 556dbc77-4e76-e37b-8ad8-de5164d5f8f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:556dbc77-4e76-e37b-8ad8-de5164d5f8f6
msgctxt "hfff181a3gd32eg40bdgaf3fgd3bd86521f68"
msgid ""
"No doubt he's chasing after Balthazar in the dark. I hope he finds him. "
"They're likely to tear one another to pieces."
msgstr "아마 어둠 속에서 발타자르를 쫓고 있겠지. 니어가 발타자르를 찾아내면 좋을 텐데. 아마 서로를 찢어버릴 테니까 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 55be5a60-69b6-77da-fd26-236f43da135d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:55be5a60-69b6-77da-fd26-236f43da135d
msgctxt "h8ad9b059g43e2g42bcgb53agd758f32500c0"
msgid "I see you like to handle underlings physically? So do I."
msgstr "부하를 물리적으로 다루는 걸 선호하나 봐? 나도 그런데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 5616c657-d535-3f4a-b3a6-d2c9e51e4ff6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5616c657-d535-3f4a-b3a6-d2c9e51e4ff6
msgctxt "h0770ec09g6568g4c1aga996g44cbd4531c1e"
msgid "It will be done."
msgstr "그렇게 하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 567167de-5043-7a12-3138-597e794c82d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:567167de-5043-7a12-3138-597e794c82d3
msgctxt "h917f3a54g760bg4a8cg88a0g7c8e18523ce5"
msgid ""
"The General is the Absolute's Chosen. Serving him is a great privilege - one "
"that I'm beginning to doubt you deserve."
msgstr "장군께서는 절대자님의 선택을 받았어. 그 분을 섬기는 것은 특권이야. 네게 그럴 자격이 있는지 의심이 드는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 57c44627-4b20-9967-810b-cc8da6ad8cb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_GuardDies = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:57c44627-4b20-9967-810b-cc8da6ad8cb2
msgctxt "h5cf684ffgb38fg4b6cgbca5g5a76ce15114b"
msgid "That was a bit excessive. Will nobody miss the ogre?"
msgstr "좀 심한 거 같은데. 누가 저 오우거를 그리워하지 않을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5a413d39-daa8-f5ba-b4e3-8d9c24b5c652
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5a413d39-daa8-f5ba-b4e3-8d9c24b5c652
msgctxt "h0838b333gf124g473fgbae1g25e2c570b223"
msgid ""
"The Absolute fills your mind... but you have doubt and anger in your heart, "
"not love."
msgstr "절대자께서 네 정신을 채우신다... 하지만 네 마음속엔 의심과 분노가 있구나, 사랑이 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5ab24c61-1081-5d4e-f018-2ceedffb08bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5ab24c61-1081-5d4e-f018-2ceedffb08bc
msgctxt "hb556586ag693cg4e8bga64fgd12d10599141"
msgid "Let's see if <i>you</i> can hold my interest."
msgstr "<i>넌</i> 내 관심을 잡아둘 수 있을지 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 5be54b48-5f5e-8350-ae20-e3e61cd72ff0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5be54b48-5f5e-8350-ae20-e3e61cd72ff0
msgctxt "hddefe65fgcd35g4d6eg9c4ag1b4310dc3fd6"
msgid "Of course I did. They were enemies of the Absolute."
msgstr "물론 그랬지. 걔네들은 절대자의 적이었으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 5dd96f33-dc50-6a33-b7db-ebc30409d9f9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_AboutArtefact = True
#.   Local:
#.      - 2812a3a3-b4ef-20ce-cc3e-e5a9315568eb_AskedAboutNerves = False
#. SetFlags:
#.   Local:
#.     - 2812a3a3-b4ef-20ce-cc3e-e5a9315568eb_AskedAboutNerves = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5dd96f33-dc50-6a33-b7db-ebc30409d9f9
msgctxt "hf31f5ffcg7ec0g4d55g98fdga8d4adffdc35"
msgid "You don't like talking about the relic. Why is that?"
msgstr "유물에 대해 말하기 꺼려하는 것 같은데. 왜지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5e4b0639-7d14-b1c2-eb2c-94731cf6712d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5e4b0639-7d14-b1c2-eb2c-94731cf6712d
#, fuzzy
msgctxt "hdf66313ag2f8eg4b6fgbff5gf2d7b7f240a8"
msgid ""
"Control your emotions. When you come to Her, you must allow Her love to push "
"out all other feeling."
msgstr "감정을 통제하도록. 그분을 뵐때는, 그분의 사랑이 다른 모든 감정보다 우선하도록 해야한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5e960080-7e07-480e-857f-ff02eee98bbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5e960080-7e07-480e-857f-ff02eee98bbc
msgctxt "he518c9b3gc0e1g4520ga7b2ged617f911873"
msgid "I don't get anxious - I get impatient. You have your mission."
msgstr "난 불안해하지 않아. 인내심이 바닥났을 뿐이지. 너에겐 임무가 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5f5bac08-b77b-5f9f-bed8-644696a4bc06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5f5bac08-b77b-5f9f-bed8-644696a4bc06
msgctxt "h16ca64f1g5fdeg4596g8a2fg2dc5e213809c"
msgid ""
"But the desperate one who would love such a pathetic man must hunger for "
"greater delights, deep down."
msgstr "하지만 이런 한심한 남자를 사랑할 정도로 절박한 사람이라면, 마음 속 깊은 곳에 더 큰 쾌락에 대한 갈망이 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5f8200ff-0337-faad-6e7b-c18a3e8963c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5f8200ff-0337-faad-6e7b-c18a3e8963c1
msgctxt "h45ae59eag25bbg4896gab09gc98f560c7ac1"
msgid ""
"And this is where <i>you </i>belong - standing before me, ready to do more "
"of the Absolute's work."
msgstr "그리고 여기는 <i>네</i>가 있을 곳이지. 내 앞에 서서, 절대자님을 위한 일을 하는 것 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 5fe74f9c-1a02-73ad-26cb-16f2b9b4eec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:5fe74f9c-1a02-73ad-26cb-16f2b9b4eec4
msgctxt "hdfa752b9g72d0g4273g97d4gbad7508bccfc"
msgid "Would you prefer that I spared the denizens of Last Light?"
msgstr "최후의 빛 사람을 좀 남겨놨으면 더 좋았을 거라는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 6047b014-6652-9da9-53ad-26447c0d1c8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:6047b014-6652-9da9-53ad-26447c0d1c8e
msgctxt "he5a11a13gc629g4edcg8204gc0a9b5948ceb"
msgid "She gave me <i>everything</i> I wanted."
msgstr "그분께선 내가 바라던 <i>모든 것</i>을 주셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 62147ac1-9c8b-119b-bfe7-82221953e429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:62147ac1-9c8b-119b-bfe7-82221953e429
msgctxt "h52dbfde3gc6b5g4df0g9f39g0987538cd986"
msgid ""
"Hardly a surprise - we are protected here, but outside, the shadows are "
"hungry."
msgstr "놀라운 일은 아니야. 이 안은 보호받는 상태지만, 저 밖의 그림자들은 굶주려 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 63d035cc-3a8d-e476-07ea-a01b289968d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:63d035cc-3a8d-e476-07ea-a01b289968d9
msgctxt "hfff509f9g4fddg4157g92f8g93525149cb81"
msgid "I'll pass - I'm busy enough already."
msgstr "미안, 내가 좀 바빠서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 651815b9-ad54-a394-f7c6-07e926b38261
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:651815b9-ad54-a394-f7c6-07e926b38261
msgctxt "h73d3d8a5g20bcg439cga424gb767be33056b"
msgid ""
"My orders come directly from the General. By all means, go to the rooftop "
"and explain to him why you ignored them."
msgstr "내 명령은 쏨 장군님께서 직접 지시하신 거다. 원한다면, 옥상으로 가서 네가 왜 우리 명령을 무시했는지 설명하든가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 65cf61de-59d6-0a3a-e507-92bc50b8c8ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:65cf61de-59d6-0a3a-e507-92bc50b8c8ea
msgctxt "h251bfd87g3492g4796g8230g0bb1296f3d74"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 67edaf4c-614e-b50b-842a-717abe125db3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:67edaf4c-614e-b50b-842a-717abe125db3
msgctxt "h6785af52g9e0fg4bd0gaedag07b5020ed2b8"
msgid "But <i>your </i>utility to our cause has only just begun."
msgstr "하지만 우리에게 있어 <i>네</i> 유용함은 이제 시작이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 685588ff-01fc-7faf-f0dd-a34262ca6315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:685588ff-01fc-7faf-f0dd-a34262ca6315
msgctxt "hf070ab1dgfb25g4f7dga55cg3a9bb9ecf37b"
msgid ""
"*She parts the folds of your mind again, touching your wants and hopes. "
"Tasting them.*"
msgstr "*그녀가 당신의 정신을 다시끔 헤집어봅니다, 당신의 욕망과 소망을 어루만집니다. 음미합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Astarion
#. NodeID = 685ec602-5391-4abd-ab43-524960bdd329
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:685ec602-5391-4abd-ab43-524960bdd329
msgctxt "h21319448g9381g40f7gb1d6g42c97e78e63f"
msgid "You, maybe. I'm more than ready."
msgstr "넌 그럴지도 모르지. 난 충분히 준비 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 698d2fd2-4c51-5af7-4e46-a7024d8b058e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:698d2fd2-4c51-5af7-4e46-a7024d8b058e
msgctxt "h7f9c2300gc60dg421eg8fefg21c08e4d3ef0"
msgid "No. Better yet - <i>show me</i>."
msgstr "아니. 그러지 말고, <i>보여줘</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 699aae24-ac3a-d5eb-3ead-3eccabfdba59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:699aae24-ac3a-d5eb-3ead-3eccabfdba59
#, fuzzy
msgctxt "hd1170cfag7f26g4900gbc87g17bd93befc44"
msgid "<i>Everyone.</i> Keep watch, and ensure that nobody passes."
msgstr "<i>아무도.</i> 눈 크게 뜨고, 아무도 못 지나가게 하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 69acb40f-f691-3aa9-d247-480228efdd95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:69acb40f-f691-3aa9-d247-480228efdd95
msgctxt "h0e5ba131g10b6g40e5g96dcg4763ac5ffacc"
msgid ""
"Such single-minded focus... Perfect to be guided by the Absolute's loving "
"hand."
msgstr "놀라울 정도의 몰입이로군... 절대자님의 인도를 받기에 완벽해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 6bc89d2e-b491-a401-490f-fca9354acd42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:6bc89d2e-b491-a401-490f-fca9354acd42
msgctxt "hf8806bc7g15fcg4f4dgacfbg92a1b83b619a"
msgid "Sounds good. How do I get what I want?"
msgstr "멋진데. 그럼 내가 원하는 건 어떻게 얻지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 6c4e5e7f-34e4-19da-6d39-23675574a9a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:6c4e5e7f-34e4-19da-6d39-23675574a9a6
msgctxt "h43f15e3bg3f1cg4c17g8d2bgc80f6d031fd5"
msgid "I've never been more ready for anything in my life."
msgstr "살면서 지금처럼 준비된 적은 없었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 6c50fb03-db2b-b151-c1b1-4669cee36389
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:6c50fb03-db2b-b151-c1b1-4669cee36389
#, fuzzy
msgctxt "hb6646c58g2dcfg48b8g84a2gb93941d3faf1"
msgid "Is it true that General Thorm is invulnerable?"
msgstr "쏨 장군께선 무적이시라는 게 사실인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 6cecb9a3-0823-215b-ad4f-9c2f277a0e9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:6cecb9a3-0823-215b-ad4f-9c2f277a0e9d
msgctxt "hd667392eg2e19g4b05gb5dcg281b3c1657d3"
msgid "But enough of my daydreaming - General Thorm is ready to see you."
msgstr "하지만 내 공상은 이걸로 충분해, 쏨 장군님께서 널 보고자 하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 6e217794-7806-092b-98a0-a8e17b8a89a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_BalthazarsSecrets_Knows_Chambers = True
#.   Object:
#.     - MOO_Executioner_Event_GiveBalthazarKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:6e217794-7806-092b-98a0-a8e17b8a89a3
msgctxt "hfdfd15dfg1e03g487dg8847gb76a358e670a"
msgid ""
"The shadows around the Mausoleum are deep and hungry - you will need a "
"Moonlantern to survive them."
msgstr "영묘 주변의 그림자는 깊고도 굶주렸다. 살아남으려면 달등불이 필요할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 6fce5989-9a7a-8ad4-a3e6-76b8651848d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:6fce5989-9a7a-8ad4-a3e6-76b8651848d6
msgctxt "h706633bcg0026g4b74ga63bg02b7557308b9"
msgid ""
"We are instruments of Her design. We do not question our role - we simply "
"fulfil it."
msgstr "우리는 그분의 설계의 도구일 뿐이다. 우리는 우리의 역할에 질문을 하지 않아. 단지 수행할 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 727b6220-d8bd-1417-a3b0-bdd5a198eddb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_MentionedBalthazar = True
#.      - UND_TheDrowNere_Event_ToldGeneral = True
#.   Object:
#.      - MOO_Executioner_ToldAboutNere(1) = False
#. SetFlags:
#.   Object:
#.     - MOO_Executioner_ToldAboutNere(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:727b6220-d8bd-1417-a3b0-bdd5a198eddb
msgctxt "hdcd21b14g1242g4d9ag967cgc771c9d375cf"
msgid ""
"I aided Nere in the Underdark - he sought the same thing Balthazar does."
msgstr "언더다크에서 니어를 도왔는데, 발타자르가 찾는 것과 똑같은 걸 찾고 있더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 741ad8b4-d150-354d-a303-62c546ee50bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#.      - MOO_Isobel_State_AtMoonrise = True
#.      - HAV_Isobel_State_IsDead = False
#.      - MOO_Necromancer_State_AtMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:741ad8b4-d150-354d-a303-62c546ee50bf
msgctxt "h02e1adb2gfe45g44e7g9597g65e8be077af4"
msgid ""
"Ah, True Soul. The rescue of Isobel went as planned, I hear - how eager you "
"are, in service of the Absolute."
msgstr "아, 참된 영혼. 이소벨 구조는 계획대로 되었다더군, 절대자님을 섬기는데 네가 얼마나 열성적인지 알겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 7451fb7d-e676-b819-9004-8bdf08bb4144
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:7451fb7d-e676-b819-9004-8bdf08bb4144
msgctxt "h369cd63egba3cg4b0ag832cgc2ddb3b8a895"
msgid ""
"'I did what I had to... I was only following orders... I had no choice.'"
msgstr "'해야 할 일을 했을 뿐... 명령에 따랐을 뿐... 선택의 여지가 없었다.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 74a221fa-bc5f-4b4e-f8c5-f5a54aa16a5e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:74a221fa-bc5f-4b4e-f8c5-f5a54aa16a5e
msgctxt "hd30dbe42g7a07g44begb06ag3099a8ff6d7e"
msgid ""
"I see you have been rejected in the past. Do not worry - the Absolute loves "
"you, and that is all that truly matters."
msgstr "한 번 차인 경험이 있나보군. 걱정하지 않아도 된다. 절대자님은 널 사랑하시고, 중요한 건 그것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 74b23d28-2983-a6b5-d79c-8b4182258aad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:74b23d28-2983-a6b5-d79c-8b4182258aad
msgctxt "h9fa2cdbdgae2fg4118ga635gaa2cf6640339"
msgid "I live to serve. What do I need to do?"
msgstr "섬기는 거야말로 내 삶의 이유야. 내가 뭘 하면 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 74f2ea77-1a91-98ec-7ae3-52db08913933
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:74f2ea77-1a91-98ec-7ae3-52db08913933
msgctxt "hb540a24dg2e38g4c3eg8918g4495d7106d45"
msgid ""
"I can see why the Absolute might be hungry to dig deeper into that mind of "
"yours. I certainly am."
msgstr "왜 절대자께서 네 마음 깊이 들어가보고 싶어하시는지 알겠어. 나도 진짜 그러고 싶거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 752341a8-3e19-8f08-52a2-2ec418ce7a5d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingAstarion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:752341a8-3e19-8f08-52a2-2ec418ce7a5d
msgctxt "h86a030e2gcce0g42dfgb36bg3d240c8da6e0"
msgid "<i>Distract her with your lusts for Astarion.</i>"
msgstr "<i>아스타리온에 대한 욕정으로 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 765a76a3-731e-93e6-7558-ca46c8bfdc92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:765a76a3-731e-93e6-7558-ca46c8bfdc92
msgctxt "hf1bca56fg35ffg47a9g93cdgbda528bd9e62"
msgid "I think I've had enough of running errands."
msgstr "심부름은 충분히 한 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 7757b9d8-775c-4a31-4dfd-5d6744f9f295
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:7757b9d8-775c-4a31-4dfd-5d6744f9f295
msgctxt "he812b009g75dag4341g8745g37fe12e5dbe2"
msgid "I didn't expect you to do <i>that</i>."
msgstr "<i>그렇게</i> 할 줄은 몰랐지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 78485f21-5aa7-6783-fccd-30235f833612
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Executioner_State_AnnoyedAtPlayer(1) = True
#.   Global:
#.     - MOO_Executioner_State_AnnoyedAtSomeone = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:78485f21-5aa7-6783-fccd-30235f833612
msgctxt "ha3b42b96g62a2g4801g9f22g5bfc67024d91"
msgid ""
"I was hoping you'd be able to help with something more important - but "
"you're only fit to muck out the jail cells."
msgstr "네가 더 중요한 일에 도움이 되지 않을까 생각했는데, 감옥 청소에나 어울리는 녀석이었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 788bf204-567b-e885-eca1-f15765653831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:788bf204-567b-e885-eca1-f15765653831
msgctxt "hba4df25eg4210g4a31g8b4cg1bb48cda7716"
msgid "There's nothing I could do to make <i>you </i>look bad."
msgstr "내가 뭘 해도 <i>너</i>를 무능해 보이게 할 수는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 7905269d-a0e6-ffac-f6d8-72118869a177
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Charlatan_GoblinExecutionLie = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:7905269d-a0e6-ffac-f6d8-72118869a177
msgctxt "he0cc566fgaeb7g4389g8cc1g6694250aefa7"
msgid "Very pragmatic. But very boring."
msgstr "아주 실용적이지만. 아주 지루하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 793b6beb-35dd-2983-2049-6201c7b7c128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:793b6beb-35dd-2983-2049-6201c7b7c128
msgctxt "h3c15a9d3g9f23g420ag8b4ag42bf0ad3b06a"
msgid ""
"Indeed - the Absolute's love for him has made him more than mortal. He is "
"unstoppable."
msgstr "그래. 장군께서는 절대자님에 대한 사랑으로 필멸을 넘어서셨지. 아무것도 그 분을 막을 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 7cf732ce-c538-1257-6115-0481d266c8aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:7cf732ce-c538-1257-6115-0481d266c8aa
#, fuzzy
msgctxt "hdbe95050gf4a3g483dgbbe2g8c6e1ffab9a5"
msgid ""
"She must have liked you - such a shame she'll never smile again. But I'll "
"enjoy the memory of this moment..."
msgstr "널 좋아했었나 보군. 다시 웃지 않을 거라니 유감이야. 하지만 이 순간의 기억은 즐겨야겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 7d303088-cd49-ac08-e463-abce07490f7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Executioner_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:7d303088-cd49-ac08-e463-abce07490f7f
msgctxt "h3abee229g84f5g4177gade0g88b6b13c049f"
msgid ""
"Are you here to impress me, True Soul? I hope so, because I have a mission "
"for you."
msgstr "내게 인상을 남기러 왔나, 참된 영혼? 그랬으면 좋겠군. 너에게 줄 임무가 있어서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 805d5694-27e4-fecf-1d38-4b2e1cfa46f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:805d5694-27e4-fecf-1d38-4b2e1cfa46f6
msgctxt "h36934f93ga28cg451fgb6c0g65d141b8783e"
msgid ""
"To take without asking, to feel without doubting, and to kill without "
"consequence."
msgstr "묻지 않고 얻고, 의심없이 느끼며, 대가 없이 죽이는 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 81611f74-6531-8316-2ad1-d09e70910cae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:81611f74-6531-8316-2ad1-d09e70910cae
msgctxt "hbe2e5eccg1148g479dgaea4g77c8b2af3b2c"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 82e7520a-f0ae-1019-90b3-c5005141a8d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:82e7520a-f0ae-1019-90b3-c5005141a8d1
msgctxt "ha447bc64g744ag4b0ag9d58g4131cf6998e9"
msgid "Simply... void. But why? Why would you not embrace her? Worship her?"
msgstr "완전히... 비었군. 왜지? 왜 그녀를 받아들이지 않지? 왜 숭배하지 않지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 833b441a-8440-6072-f63d-7fc94c82dc47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:833b441a-8440-6072-f63d-7fc94c82dc47
msgctxt "h1e7ebd84gf4abg401fgb4a2gb2c0ac4c70c8"
msgid ""
"As you should be - and you have an opportunity to impress General Thorm. I "
"have a mission for you."
msgstr "물론 그래야지. 마침 쏨 장군님께 좋은 인상을 남길 기회가 있다. 네게 줄 임무가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 840f53ee-8519-ae33-6b62-8d58b995927d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:840f53ee-8519-ae33-6b62-8d58b995927d
msgctxt "he2c8f73eg48aeg428cg803dg08da6aed377f"
msgid "Of course not. I will do as you ask."
msgstr "물론 아니지. 요청대로 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 85a1577e-33db-7328-a703-6f4bb98974e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:85a1577e-33db-7328-a703-6f4bb98974e1
msgctxt "h2c15174bgf829g4c97gbf09g0fbbee07e82d"
msgid ""
"Are you trying to impress me with your dalliances? Please - I've lain with "
"everything from an ogre to an ooze."
msgstr "지금 네가 노닥거리는 걸 보고 내가 감명이라도 받길 원하는 건가? 난 오우거에 우즈, 그 사이 모든 것과도 자봤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 88097bc2-e857-e0a5-e349-ca662f0dc904
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:88097bc2-e857-e0a5-e349-ca662f0dc904
msgctxt "hdfe9a25ag452ag4d71g8e71gba91c70d10e6"
msgid ""
"...You're rather familiar with the details of his failure. As if you were "
"there to witness it."
msgstr "...꽤 자세히 알고 있군. 마치 그 자리에 있었던 사람처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 89099090-21ae-8548-c3e6-20fca8856169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:89099090-21ae-8548-c3e6-20fca8856169
msgctxt "h34293a02g4cd8g492bga9d3gf20c55e8d326"
msgid ""
"I hope you're a better fighter than you are a lover - I have a mission for "
"you, direct from General Thorm."
msgstr "사랑보단 싸움을 잘하는 편이었으면 좋겠군. 쏨 장군께서 네게 내리신 임무가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 89b72045-b970-1677-afa0-9f87caa35a1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:89b72045-b970-1677-afa0-9f87caa35a1a
msgctxt "h38f82e0dgf742g4be1g8853ga1b60964fd47"
msgid "Fine. I'll retrieve Isobel."
msgstr "알겠어. 이소벨을 데려오지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 8a549dea-c921-7e0e-2628-2bf313e51d21
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_AboutArtefact = True
#.   Local:
#.      - 2812a3a3-b4ef-20ce-cc3e-e5a9315568eb_AskedAboutNerves = False
#. SetFlags:
#.   Local:
#.     - 2812a3a3-b4ef-20ce-cc3e-e5a9315568eb_AskedAboutNerves = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8a549dea-c921-7e0e-2628-2bf313e51d21
msgctxt "h8adabd80g6d4bg4215gbcb8g824dccf72a3d"
msgid "Talking of this relic makes you anxious - why is that?"
msgstr "유물에 대해 말하는 걸 불안해 하는 거 같던데, 왜지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 8a7ed637-5ab2-a858-e6b1-84e3f3fbda29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8a7ed637-5ab2-a858-e6b1-84e3f3fbda29
msgctxt "he4c4f6c6g65c6g42d5ga526g27466f72bc50"
msgid "Understood - I'm ready to head out."
msgstr "이해했어. 그럼 난 가 볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 8cb5bb76-c9a7-ad60-aa06-b10c00fb3e78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8cb5bb76-c9a7-ad60-aa06-b10c00fb3e78
msgctxt "hed355d48g76f6g4075gb567g0120e6b5e10c"
msgid ""
"Are you ready to stand by his side, in the presence of the <i>Absolute "
"Herself</i>?"
msgstr "그 분 곁에 서서, <i>절대자 본인</i>과 함께 할 준비가 되었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 8d2db4da-370a-ff2c-e4df-3087455b6e69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8d2db4da-370a-ff2c-e4df-3087455b6e69
msgctxt "h73f21db5g3da1g443dga986g9b32dde7ad98"
msgid "Not in the slightest."
msgstr "전혀 준비되지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = 8dd9403b-4ece-3b9d-8d6e-b7ef929093d6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8dd9403b-4ece-3b9d-8d6e-b7ef929093d6
msgctxt "h72e95df5g5912g437ag8d92g1fa7f1ec5a64"
msgid ""
"We're not the most welcome guests, but Ketheric and the Absolute are waiting "
"for us. Be ready for anything."
msgstr "우리가 귀빈은 아니지만, 케서릭과 절대자가 우릴 기다립니다. 대비하고 계십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = 8dd9403b-4ece-3b9d-8d6e-b7ef929093d6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8dd9403b-4ece-3b9d-8d6e-b7ef929093d6
msgctxt "h1e35b6e7ge8d6g4150g87e2ge3ac13a71533"
msgid ""
"We're not the most welcome guests, but Ketheric and the Absolute are waiting "
"for us. Be ready for anything."
msgstr "우리가 귀빈은 아니지만, 케서릭과 절대자가 우릴 기다립니다. 대비하고 계십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 8def53e2-d770-9933-3ae3-2b29727ef279
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8def53e2-d770-9933-3ae3-2b29727ef279
msgctxt "hf68642ccg7676g4933ga8acgc0c28a408f27"
msgid ""
"Of course - and when Baldur's Gate falls, it won't be long until those that "
"serve General Thorm well will rule the Sword Coast alongside him."
msgstr "물론이지. 발더스 게이트가 무너지면, 머지 않아 쏨 장군을 섬기는 이들이 그 분 옆에서 소드 코스트를 지배하게 될 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 8e0f8b79-f5cc-74c1-574d-2152fb716d0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8e0f8b79-f5cc-74c1-574d-2152fb716d0f
#, fuzzy
msgctxt "h11f6ae99g8fabg433cg87c9gf9b0f0860e22"
msgid "And why should I serve General Thorm?"
msgstr "내가 왜 쏨 장군을 섬겨야 하는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 8f4cdbf2-f861-e377-d4ec-cd83868172cc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8f4cdbf2-f861-e377-d4ec-cd83868172cc
#, fuzzy
msgctxt "h12b3bef0gd444g4bf4ga340gedde91a21a8b"
msgid "<i>Lash her with the atrocities you've conducted.</i>"
msgstr "<i>당신이 저지른 악행을 그녀에게 휘갈긴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 8f578ac5-af5c-e693-9efe-6533849fb6db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8f578ac5-af5c-e693-9efe-6533849fb6db
msgctxt "h07b05086g6063g4602g9502gfb0aa2fc972b"
msgid "You don't measure up to either."
msgstr "넌 그 둘보다 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 8f6039e2-9706-8b3b-50c2-3db3fe22787d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:8f6039e2-9706-8b3b-50c2-3db3fe22787d
msgctxt "hd3fb552ag13e1g4b93g84b9g26fd56b8d483"
msgid "But unfortunately it is not all you have done."
msgstr "하지만 유감스럽게도 이것만 해낸 게 아니더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 902fdabf-f08f-5e20-e0ff-ae0a2b16bc18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:902fdabf-f08f-5e20-e0ff-ae0a2b16bc18
msgctxt "h79b02a37g58ffg4babg8460g1602ffce008d"
msgid "What now?"
msgstr "이제 뭘 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 904c259a-cae2-b7bb-90af-ac06fac2c039
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:904c259a-cae2-b7bb-90af-ac06fac2c039
msgctxt "h8ab7cc71gbb18g4427gbf87g6ede9885e734"
msgid "Good - I'll free the rest of the prisoners while I'm down there."
msgstr "좋아, 내려가서 나머지 포로들도 다 풀어 줘야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 9056ee99-d9b8-c952-5acf-65b7647d01c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CAMP_GoblinHunt_State_AstarionRejected(1) = False
#.      - CAMP_GoblinHunt_State_WyllRejected(1) = False
#.      - CAMP_GoblinHunt_State_ShadowheartRejected(1) = False
#.      - CAMP_GoblinHunt_State_LaezelRejected(1) = False
#.      - CAMP_GoblinHunt_State_GaleRejected(1) = False
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:9056ee99-d9b8-c952-5acf-65b7647d01c4
msgctxt "h852a4e6fgf1abg4e3fg9433g6d55528b97ec"
msgid ""
"You long to be touched. A shame we're preparing for war, or I might find "
"time for you - but all you truly need is the Absolute."
msgstr ""
"너는 손길을 원하는군. 전쟁 준비를 하고 있는 게 아니었다면, 네게 시간을 내 줄 수도 있었을 텐데. 하지만 네게 정말 필요한 건 "
"절대자님 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 90c14644-9a8f-5d2e-2b90-ed3a844e314f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:90c14644-9a8f-5d2e-2b90-ed3a844e314f
msgctxt "h3498b8fdg9bd6g469cga2feg875d2442d2e8"
msgid ""
"That won't keep my blade from your throat if you continue to disappoint me."
msgstr "날 계속 실망시킨다면 참된 영혼이란 이름도 네 목을 지켜주진 못할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 913b2c9f-d119-51e1-2e30-0b2180569037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:913b2c9f-d119-51e1-2e30-0b2180569037
msgctxt "hc7236b80g91d8g47f5gb6c3g57c466e24809"
msgid "The General does not ask. He speaks his will, and it is so."
msgstr "장군께선 요청하지 않으신다. 그 분이 원하는 것을 말씀하시면, 그렇게 되는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 913f6451-da17-bb71-5e0e-6f0acdb27b56
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:913f6451-da17-bb71-5e0e-6f0acdb27b56
msgctxt "hc0d0054agd519g4edfgb6cfg82c81c68ad4b"
msgid "Guards!"
msgstr "경비병!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 9161df3d-76cf-d256-c5fc-dd1f11d9c327
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:9161df3d-76cf-d256-c5fc-dd1f11d9c327
#, fuzzy
msgctxt "h94122260gaac3g41e5ga009g45abfcc334bb"
msgid "Please. I've been inside you. You're ready."
msgstr "이봐. 내가 보기엔. 넌 준비됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 920e1fdc-b728-0e4f-1573-722f7c1fcfd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:920e1fdc-b728-0e4f-1573-722f7c1fcfd0
msgctxt "h3f715b22gb7d3g477cg9be5g49481f7f0939"
msgid "You said you lost contact - what do you mean?"
msgstr "연락이 끊겼다는 게 정확히 무슨 뜻이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 9240d86a-6015-5e9c-4ee2-029be225ed76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:9240d86a-6015-5e9c-4ee2-029be225ed76
#, fuzzy
msgctxt "hdbcf706cg653bg4764gaadbgfd82379233cf"
msgid "And? They reject the god who raised you."
msgstr "그래서? 너를 세운 신을 거부하는 자들이잖나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 92e14476-06a7-99ec-ec41-ebf63d1f7b43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:92e14476-06a7-99ec-ec41-ebf63d1f7b43
msgctxt "h7e2070c8g428bg4c03ga9bfgd91f48a18b7b"
msgid ""
"Oh, do you? Perhaps I'll let you try taking it from me, someday. I think I'd "
"enjoy watching you struggle. And <i>beg</i>."
msgstr "오, 그런가? 언젠가 내 자리를 쟁취하게 해 줄 수도 있겠지. 네가 몸부림치고, <i>비는</i> 꼴도 재미있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 93a33fcb-899b-97e1-1f08-63b08073198f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:93a33fcb-899b-97e1-1f08-63b08073198f
msgctxt "ha2672fb5gbe79g4b99g9580g8bdaa2890a71"
msgid "I had a few more questions about the mission."
msgstr "임무에 관해 몇 가지 질문들이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 9428e435-ba87-47f2-9dec-da5b88988c6f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_State_SpecialStashAccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:9428e435-ba87-47f2-9dec-da5b88988c6f
#, fuzzy
msgctxt "h1264f3b3gcc66g446agabdcgcf3e3a3fa7cc"
msgid ""
"Fine. Talk to the bugbear quartermaster - tell him he's to share my secret "
"stash with you."
msgstr "좋다. 버그베어 병참장교와 대화하도록. 내 비밀 물품을 너에게 보여주라 했다고 말해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 943cab5c-3409-9e9c-6f86-e7ce066f087e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:943cab5c-3409-9e9c-6f86-e7ce066f087e
msgctxt "h454c6dfcg8cb2g44a0g95a8g0d11b5e89158"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 954820c1-8eb6-8595-ecb7-ee2f2f22e901
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#.     - GLO_Event_SetSurprisedNextCombat(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:954820c1-8eb6-8595-ecb7-ee2f2f22e901
msgctxt "h0a2d794ag7237g4f5fg9633g7e3540d7c1cf"
msgid "Who <i>are</i> you? Guards!"
msgstr "넌 대체 <i>누구야?</i> 경비병!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = 958fd179-3ed2-103b-03e0-4ac8e7920b91
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_State_ReactedToGoblins = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:958fd179-3ed2-103b-03e0-4ac8e7920b91
msgctxt "hb845765egeef8g4952g877ag70e84d82f75a"
msgid ""
"*Every emotion soaks into her mind's palate, but there is purpose to her "
"exploration - she is searching for proof of your faith.*"
msgstr "*모든 감정이 그녀의 정신으로 흡수되지만, 이번 조사는 목적이 있습니다, 당신의 믿음을 증명할 것을 찾는 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 9847e8a1-d9d5-eefb-9634-395e5d758e81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:9847e8a1-d9d5-eefb-9634-395e5d758e81
msgctxt "h8c836f41g1aaeg4535g9920g15e87b044eac"
msgid ""
"He blundered in and got killed. I could hardly report back if I'd done the "
"same."
msgstr "마커스는 어설프게 굴다 죽었어. 내가 똑같이 했으면 나도 여기에 없었을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 98e52f59-1fe6-b0fa-754a-5ba3fd8dbab1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_IsDead = True
#.      - MOO_Necromancer_State_AtMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:98e52f59-1fe6-b0fa-754a-5ba3fd8dbab1
msgctxt "h3e4a8802ge61cg4911gaa3agfe4ea4e92da1"
msgid ""
"You've been busy, True Soul. I heard how you helped Balthazar. He's returned "
"to Moonrise, with the Nightsong in his possession."
msgstr "바쁘구만, 참된 영혼. 발타자르를 도와줬단 이야기 들었어. 밤의 노래를 갖고 문라이즈로 돌아왔던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = 9afae0f3-2246-47fe-9806-3c8a88d4fcd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:9afae0f3-2246-47fe-9806-3c8a88d4fcd2
msgctxt "h0d219ed6g7867g401cg8529gab97990b0e4d"
msgid "I'm done with following your orders. I want to see General Thorm."
msgstr "네 명령을 따르는 건 끝이다 . 쏨 장군을 만나게 해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 9f8742dc-2870-0b0b-1b5e-631b1ee12e82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:9f8742dc-2870-0b0b-1b5e-631b1ee12e82
msgctxt "h5a8e99a8ge521g495ag9f4egfb7a69825901"
msgid "Nothing but battle in that brain of yours - typical soldier."
msgstr "네 머릿속에는 전투 생각만 가득하군. 전형적인 군인이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a00b338c-8574-2e2a-0bb4-56883798d01e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a00b338c-8574-2e2a-0bb4-56883798d01e
msgctxt "h690f5b51g1b90g4bfcgbb96g5c9053e5078b"
msgid ""
"It does not matter what I prefer, it matters what the General commands. And "
"his orders were that the cleric Isobel be brought to Moonrise <i>alive</i>."
msgstr "좋고 말고가 아니다, 장군님의 명령에 대한 거지. 장군께서 클레릭 이소벨을 <i>산 채로</i> 데려오라 명하셨을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a02bfbcc-ec37-4a0e-a15c-de191b82e1bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a02bfbcc-ec37-4a0e-a15c-de191b82e1bc
msgctxt "h61837933g814bg4ac9g8098gfecad0a2b46e"
msgid ""
"And what a fine child it would be. But you didn't come here to tear the "
"wings off insects."
msgstr "그렇담 휼륭한 아이겠지. 그건 그렇고 벌레 날개나 떼면서 놀러 온 건 아닐테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = a0b6c3b2-5aad-b750-a9e6-c46a81336780
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a0b6c3b2-5aad-b750-a9e6-c46a81336780
msgctxt "h03ecf8a9g8e5bg49d9gac64g3e0fec7d48fa"
msgid "I don't understand why the General is so interested in her."
msgstr "장군이 왜 그렇게 그녀에게 관심을 갖는지 이해가 안되는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a28626f6-8786-2f30-4d75-fca07b5e08eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a28626f6-8786-2f30-4d75-fca07b5e08eb
msgctxt "hd86d91eagf6ffg4d3bgb653gfb9a4439be8e"
msgid ""
"Don't fret about what you do and do not understand - General Thorm will tell "
"you whatever you need to know. He is ready to see you."
msgstr "이해가 안되는 걸 이해하려 조바심 낼 필요없다, 쏨 장군님께서 네가 알아야 할 건 알려주실테니. 장군께서 널 보고자 하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = a37f7e17-654d-0406-b380-bdd95a80ab68
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingWithWyll(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a37f7e17-654d-0406-b380-bdd95a80ab68
msgctxt "h6b04b34aga299g4fc4gaecfg12bd0434fad7"
msgid "<i>Distract her with thoughts of your sweet moments with Wyll.</i>"
msgstr "<i>윌과의 달콤했던 순간을 떠올려 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = a417a9ef-0fc4-069d-faac-455ef86453ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a417a9ef-0fc4-069d-faac-455ef86453ae
msgctxt "hf3293430g5da9g4790g9db8g71f996e62306"
msgid "I did what I had to - Marcus didn't seem capable."
msgstr "내가 해야 할 일을 했을 뿐. 마커스는 그럴 능력이 없어 보여서 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a41c6228-7cf4-d8e1-e005-c89ffba0463d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Audience_State_GrantedPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a41c6228-7cf4-d8e1-e005-c89ffba0463d
msgctxt "hb364a168gf630g4579g9672gae38108bcf2f"
msgid ""
"Go to the rooftop chapel. Retrieving the Nightsong has earned you an "
"audience with General Thorm, and you can explain your failing on the other "
"matter in person."
msgstr "옥상 예배당으로 가라. 밤의 노래를 챙겨왔으니 쏨 장군님을 알현할 자격은 있으니, 가서 직접 네 실패를 해명해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a548c754-931d-9b55-927c-70c166b69725
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a548c754-931d-9b55-927c-70c166b69725
msgctxt "h22fece0fgf32eg4c8egb26dg8a876a6744c1"
msgid ""
"But don't pry - the last person who snooped into his secrets lost their "
"head. I believe he uses it as a chamber pot."
msgstr ""
"하지만 너무 많은 걸 캐내려 하지는 마라. 발타자르의 비밀을 염탐하던 사람 하나는 머리가 잘렸어. 발타자르는 그걸 요강으로 쓰는 "
"모양이더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = a580ecc3-4382-6890-cd78-bdfbcac6e5cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a580ecc3-4382-6890-cd78-bdfbcac6e5cf
msgctxt "h4c5243e9g8cdbg4121g9ae7g02e80c506bb3"
msgid "You saw the truth - I'm going to put an end to your so-called god."
msgstr "제대로 봤군. 네가 섬기는 이 소위 신이란 놈을 끝장내러 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a5f4564b-8a45-583e-4c95-92379a3b5bae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a5f4564b-8a45-583e-4c95-92379a3b5bae
msgctxt "he475fafdg84b6g4f50g8a2ag7d183d93fc9e"
msgid ""
"That may be, but General Thorm wanted one of them returned to Moonrise "
"<i>alive</i>. The Cleric Isobel."
msgstr "그랬을 수도 있어, 하지만 쏨 장군께서 <i>생포</i>해오라 하신 자가 있지. 이소벨이라는 클레릭."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = a6224202-768e-26f3-6e73-e9701e8e835f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a6224202-768e-26f3-6e73-e9701e8e835f
msgctxt "h6893c491g19d6g44cdga083g56e85cff3a0d"
msgid "Enough words - time to die."
msgstr "잡담은 여기까지. 이제 죽어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Astarion
#. NodeID = a681b2c2-2112-476c-b339-5062c93d3c26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a681b2c2-2112-476c-b339-5062c93d3c26
msgctxt "h646cb429g462fg4994g925bg4dda31a0920f"
msgid "You're not the only one. We've waited long enough."
msgstr "너만 그런게 아니야. 우리 모두가 이미 충분히 많이 기다렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a6b16be3-64a7-8406-5b3c-484c7854fe89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a6b16be3-64a7-8406-5b3c-484c7854fe89
msgctxt "h6c94130fga7ccg451cg909fgc306bef88242"
msgid ""
"General Thorm will be most pleased... but there is one more task remaining, "
"before your audience with the Absolute."
msgstr "쏨 장군님께서 아주 기뻐하실 거야... 하지만 절대자님을 알현하기 전에, 할 일이 하나 더 남았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = a756ec37-3847-0cbd-f6d4-d4721ef1fa29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a756ec37-3847-0cbd-f6d4-d4721ef1fa29
msgctxt "h8091fef0gaea4g416fg979bg0cad39c214c7"
msgid ""
"*You feel her mind tremble with surprise. She wasn't expecting to see "
"that... but she <i>likes </i>it.*"
msgstr "*그녀의 정신이 놀라움에 떨리는 것이 느껴집니다. 그녀가 예상했던 것은 아니지만... <i>마음에 든</i> 모양입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a8dce79c-04c3-231a-5e7a-3cd59d86843c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a8dce79c-04c3-231a-5e7a-3cd59d86843c
msgctxt "h72741d6dga79dg4d65gb800gdfe7c910549c"
msgid ""
"However, a blunt implement can still be of use. General Thorm has a mission "
"for you."
msgstr "하지만, 뭉툭한 도구라도 쓸 곳은 있는 법이지. 쏨 장군께서 네게 임무를 내리셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = a8deb0d3-95fb-c2a3-c343-f0344e727c39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a8deb0d3-95fb-c2a3-c343-f0344e727c39
msgctxt "ha8f97060g93e5g40a2g836dg768013a2e89a"
msgid ""
"The Absolute's blessings have far greater value than any price you could "
"name. Be wise - <i>obey</i>."
msgstr "절대자의 축복은 네가 알고 있는 그 어떤 것 보다 훨씬 값어치 있다. 잘 생각하고, <i>복종해라</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = a977d9d9-0895-3f6f-66ed-c8a9bb09bf33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:a977d9d9-0895-3f6f-66ed-c8a9bb09bf33
msgctxt "hc273c519gddeeg4478ga952gaeb8476e47a5"
msgid "I'll take that chance."
msgstr "그렇다면 가야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = aa54fe19-dc2d-faba-f2a3-0c1d58b99ded
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:aa54fe19-dc2d-faba-f2a3-0c1d58b99ded
msgctxt "h53dad641gfc37g4c81g9eb8gcad621af5f13"
msgid "Why would a cleric of Selûne belong here?"
msgstr "왜 셀루네의 클레릭이 여기 있어야 하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = aaace9f7-cc78-3f72-9ec5-949294761c76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:aaace9f7-cc78-3f72-9ec5-949294761c76
msgctxt "h53edb6f9geec3g404aga07eg1298a7af80c8"
msgid "In other words: you have no idea."
msgstr "다시 말해, 너도 모른다는 거군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = aab8f2f1-18c1-d20e-0ae4-81b1c4dabc56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:aab8f2f1-18c1-d20e-0ae4-81b1c4dabc56
msgctxt "hf408fe02g9c3ag42a2gb8e7g3d3810b99a22"
msgid ""
"Perhaps I'll take you to my chambers one evening - give you some inspiration."
msgstr "언제 저녁에 한 번 널 내 방에 데려가야겠어.격려를 해주려고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ac813095-d661-851f-615f-86b34d5a07f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_ZrellBriefing_Event_CultistLeaves = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ac813095-d661-851f-615f-86b34d5a07f5
msgctxt "h51fb7cfcg3d81g4e26gac61g053c52fd837d"
msgid "Excellent timing, True Soul."
msgstr "딱 맞춰 왔군, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = acfaaed5-76e8-8a74-a7ca-a72d02265a5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Necromancer_State_AtMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:acfaaed5-76e8-8a74-a7ca-a72d02265a5a
msgctxt "h96f2a2c9g2f35g4478gb3afg63ab3ebf47f8"
msgid "The General has high expectations of you. You're exceeding them."
msgstr "장군께서 네게 거는 기대가 높아. 넌 그 기대를 넘었고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = adee8d67-f56b-c24d-2645-d8923fcd9047
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:adee8d67-f56b-c24d-2645-d8923fcd9047
msgctxt "h0089c4f1gddecg4a54g911cgf63d8a025653"
msgid "Don't you aspire to rule rather than serve?"
msgstr "섬기는 것보다는 지배하는 게 낫지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ae12a944-72b8-424f-2ce0-8796022e5a35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ae12a944-72b8-424f-2ce0-8796022e5a35
msgctxt "h46ce026bgaaadg4e74gbb64gc82a109ec098"
msgid ""
"But I can caress as well as cut. That's why you should stay on my good side."
msgstr "하지만 나는 끊어내는 것뿐 아니라 어루만지는 것도 할 수 있지. 그러니 내게 잘 보이는 편이 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ae2041dd-c973-39dd-183e-6a07a0e1d72a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyIsDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ae2041dd-c973-39dd-183e-6a07a0e1d72a
msgctxt "ha6e37efbgf58fg475cga8e3gac5c48ab4b46"
msgid "One True Soul already failed in this next task - you must do better."
msgstr "참된 영혼 하나가 이미 이 임무에 실패했어. 넌 더 잘할 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = afbe9e97-69c2-57de-3968-31878ab0ad02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:afbe9e97-69c2-57de-3968-31878ab0ad02
msgctxt "h99e9acf3gb1a6g4c2cgb2bfg97674a50d4e9"
msgid "Not doubt. I've just had enough of running your errands."
msgstr "의심이 아니야. 그냥 네 심부름은 충분히 한 것 같거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = b0b01196-0043-3ef3-9bb5-1fc656a543bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_AboutArtefact = False
#.   Object:
#.      - MOO_Executioner_Event_AskedAboutRelic(1) = False
#. SetFlags:
#.   Object:
#.     - MOO_Executioner_Event_AskedAboutRelic(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b0b01196-0043-3ef3-9bb5-1fc656a543bb
msgctxt "had9be432g84f7g43f6ga6acge7a6b33ee784"
msgid "Balthazar was looking for a relic - what is it?"
msgstr "발타자르는 유물을 찾고 있었어, 그게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = b37dd2b4-53d5-ef35-71e7-5a24ebcd5b10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_MentionedBalthazar = True
#.      - UND_TheDrowNere_Event_ToldGeneral = True
#.   Object:
#.      - MOO_Executioner_ToldAboutNere(1) = False
#. SetFlags:
#.   Object:
#.     - MOO_Executioner_ToldAboutNere(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b37dd2b4-53d5-ef35-71e7-5a24ebcd5b10
msgctxt "h8e865cacg7d01g4435ga1f3g35ba6a58eb3c"
msgid ""
"I aided True Soul Nere in the Underdark - I believe he sought the same relic "
"Balthazar is after?"
msgstr "언더다크에서 참된 영혼 니어를 도왔어. 그가 찾는 유물이 발타자르가 찾는 것과 같은 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = b4aa7ea2-bd0d-1623-9141-02afc7fed3dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b4aa7ea2-bd0d-1623-9141-02afc7fed3dd
msgctxt "h844c2a20g911ag47a8gb368g17bed4323143"
msgid "That is for General Thorm to say. He is ready to see you."
msgstr "그건 쏨 장군님께서 결정하실 일이야. 널 보고자 하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = b71c55b6-d305-52b0-2816-ce381306ca89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b71c55b6-d305-52b0-2816-ce381306ca89
msgctxt "hae31f472g3645g4983g87a1ge6a870d64b12"
msgid ""
"But some missions require warm bodies, and quick minds. That's why I need "
"you."
msgstr "하지만, 따뜻한 몸과 빠른 정신이 필요한 임무도 있는 법이지. 그래서 네가 필요한 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = b71ef238-2e8e-acbc-f167-c3a84107921f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Audience_State_GrantedPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b71ef238-2e8e-acbc-f167-c3a84107921f
msgctxt "h7d42c1e7gd867g40a9gb25bg822f90631cf0"
msgid "Find him on the roof. And pray that he is forgiving."
msgstr "옥상에서 장군님께 보고해라. 그분이 용서해 주시길 빌라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = b78b3e72-ff9d-5fdc-36d8-bb4738e79e71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b78b3e72-ff9d-5fdc-36d8-bb4738e79e71
msgctxt "h848bcebcg87bdg4e6ag800egb24884e867d9"
msgid "What can I say? I'm good at what I do."
msgstr "내가 뭐라고 하겠어? 난 그냥 일을 잘해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = b7b0f753-ab79-813b-4504-80c398e1ca98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b7b0f753-ab79-813b-4504-80c398e1ca98
msgctxt "h55d1662egd3acg4557g8dc1g562b6c13ca87"
msgid "'Rescue' is one way of putting it. I abducted her."
msgstr "'구출'이라고 볼 수도 있겠군. 내가 한 건 납치야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = b8971174-f1fc-5d3b-97b9-7a536f22e1c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b8971174-f1fc-5d3b-97b9-7a536f22e1c7
msgctxt "h94a75644ge5f6g4dc0gb879ga7e9282a9772"
msgid "You said I could do whatever I wanted with them - so I did."
msgstr "마음대로 하라고 해서, 그렇게 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = b916c5f7-b4c2-9201-89ec-8e21003f4ea2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b916c5f7-b4c2-9201-89ec-8e21003f4ea2
msgctxt "hf5895dabgec52g4db6g80c4g7b374eebcddb"
msgid ""
"<i>Overwhelm her by unleashing a wave of hatred as you prepare to attack.</i>"
msgstr "<i>강력한 증오를 발산해 그녀를 제압하고, 공격할 준비를 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = b92e0c18-49ac-734a-1a88-9dcad5b5f1c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b92e0c18-49ac-734a-1a88-9dcad5b5f1c8
msgctxt "h822d589dg69ddg44aaga41cg8af9ae40790f"
msgid ""
"Get over yourself. I have questions about our mission to find Balthazar."
msgstr "그건 이제 좀 잊어. 발타자르를 찾는 임무에 대한 질문이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = b9c46e49-de84-dc38-9677-5edbbb6e91f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:b9c46e49-de84-dc38-9677-5edbbb6e91f7
msgctxt "hcd037f32g3776g477ega6ecgc14b23b4db7d"
msgid "Pity. I thought you had a little more use in you."
msgstr "유감이군. 널 써먹을 곳이 좀 더 있을까 했는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = ba2df870-7b27-6bcd-b469-e4e6e8a4db06
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ba2df870-7b27-6bcd-b469-e4e6e8a4db06
msgctxt "hf3f6210bg278cg433agb22fg51c3899870ce"
msgid ""
"They won't get far. Let the curse take them, and save us the job of cleaning "
"up their innards."
msgstr "어차피 멀리가진 못해. 저주가 처리하게 두면, 굳이 우리가 시체를 치울 필요가 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = ba4686f3-6fea-bc32-c1f7-27761591881f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ba4686f3-6fea-bc32-c1f7-27761591881f
msgctxt "h0b1fe726g3502g4cd7gb5ffg5ba545f8d5db"
msgid "Isobel's a cleric of Selûne. What does the Absolute want with her?"
msgstr "이소벨은 셀루네의 클레릭인데. 절대자는 뭘 하려는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = bae4de34-cc30-8b21-ab0b-616f612a4064
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bae4de34-cc30-8b21-ab0b-616f612a4064
msgctxt "h4d3dc39bgeb76g4be3g9016g3e7ffb6234af"
msgid ""
"Go to the rooftop chapel - you have still earned your audience, and you can "
"explain your failing in person."
msgstr "옥상 예배당으로 가라, 아직 알현할 자격은 남아있으니, 가서 너의 실패를 직접 해명할 수 있을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = baeb23f3-b9b6-780b-9694-4273641908bf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:baeb23f3-b9b6-780b-9694-4273641908bf
msgctxt "he6233573g4b5bg460fg9982g3121d21ea6c3"
msgid ""
"You took pity on one of Shar's sorry little followers - or was it genuine "
"affection? Let's take a closer look."
msgstr "불쌍한 샤의 추종자에게 연민을 품은 모양이군. 아니면 정말로 좋아하는 건가? 한 번 자세히 보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = bb0bf8dd-7421-d59f-54f3-1e96878cab49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bb0bf8dd-7421-d59f-54f3-1e96878cab49
msgctxt "h946f6647g5876g41a6gae57g02cdc5373bd6"
msgid "I need an idea of what to do next."
msgstr "이 다음에 뭘 해야 할지 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = bb6a6b91-1d7d-6007-166e-9a71b061e4d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Executioner_HasMet(1) = True
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bb6a6b91-1d7d-6007-166e-9a71b061e4d8
msgctxt "had36a4bbge1a3g41a5g94a9gbeea19a67444"
msgid ""
"The tower doesn't stink like an overstuffed cemetery - which means Balthazar "
"hasn't returned."
msgstr "탑에서 정원 초과 공동묘지 같은 냄새가 나지 않는다는 건, 아직 발타자르가 돌아오지 않았단 뜻이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = bbf6b81a-75f4-b254-b1b2-4a7974cd3534
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#.      - HAV_Isobel_State_IsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bbf6b81a-75f4-b254-b1b2-4a7974cd3534
msgctxt "h1931f2cfg0b6ag42c1g85f7g2886b22e57ac"
msgid ""
"The shadows have swallowed Last Light, but the cleric Isobel is not with us. "
"I ordered you to bring her here alive."
msgstr "그림자가 최후의 빛을 삼켰는데, 클레릭 이소벨은 같이 오지 않았군. 분명 생포해 오라고 했을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = bc3d5b94-4497-8d8b-cc70-f890d702e391
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bc3d5b94-4497-8d8b-cc70-f890d702e391
msgctxt "h48d6da9ega1d1g4673g8764g19d13073b316"
msgid "Now? General Thorm is ready to see you."
msgstr "이제? 쏨 장군께서 널 보고자 하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = bc570bb8-765a-9e79-f281-80daf6e13229
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bc570bb8-765a-9e79-f281-80daf6e13229
msgctxt "ha206098fgdb2fg4bd0gaf89g8f1f6ba85717"
msgid ""
"She'll be back on her feet soon. The General often prefers the dead to the "
"living - they're more malleable."
msgstr "곧 다시 일어날거야. 장군께서는 종종 산 자보다 죽은 자를 더 좋아하시지. 더 말을 잘 듣거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = bcbb00d1-e51d-900d-917c-af35788a033a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bcbb00d1-e51d-900d-917c-af35788a033a
#, fuzzy
msgctxt "h2c8f200bge1bag4ba9g8a9eg2f13bf010098"
msgid ""
"Death would not silence Balthazar for long. But dead or alive, he is lost."
msgstr "죽음도 발타자르를 오래 침묵시키진 못할 거다. 하지만 그가 죽었든 살았든, 실종 상태인 건 변하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = bcda7711-c31a-3982-c72b-6c3e7f7d9001
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bcda7711-c31a-3982-c72b-6c3e7f7d9001
msgctxt "he2f3dcbag8089g4c39g9a53gea4e3f037929"
msgid "That's a little abstract - show me something real."
msgstr "좀 추상적인데, 뭔가 실질적인 걸 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = bdd308fe-501d-4259-1f56-4ff506f20ed9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bdd308fe-501d-4259-1f56-4ff506f20ed9
msgctxt "h6bd5b86ag6c9bg40a5gaa5ag3f5f74e11820"
msgid "<i>Fake it - fill your mind with love for the Absolute.</i>"
msgstr "<i>가짜로라도, 정신을 절대자에 대한 사랑으로 가득 채운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = be19ff9a-3688-3649-6c8d-ed39f80a43a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:be19ff9a-3688-3649-6c8d-ed39f80a43a8
msgctxt "h82b73ba5g6e28g40d8ga54fg7582fc4191b4"
msgid ""
"Lackey's words - leave them to the thralls and goblins downstairs. You are a "
"<i>True Soul</i>, and there is more work to be done befitting your station."
msgstr ""
"아랫 것들이나 하는 소리지. 그런 말은 아래층 노예들이나 고블린들이 하게 둬라. 너는 <i>참된 영혼</i>이고, 네 자리에 걸맞는 일이 "
"아직 남아 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = be80330d-298f-25e9-d066-b9d1147790a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:be80330d-298f-25e9-d066-b9d1147790a5
msgctxt "h976eb5f9g927bg468ag9e5age3a35763d0df"
msgid "Whatever it takes."
msgstr "무슨 일이든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = bf533fef-3f44-43c4-ab67-a7824eaddf1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bf533fef-3f44-43c4-ab67-a7824eaddf1e
msgctxt "h34a09beag3ed0g46f6gb2e7ge53e5d3bff60"
msgid "Where will I find this inn?"
msgstr "여관은 어디에 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = bf6a28cc-15ef-b667-29d2-155793537b01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Necromancer_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bf6a28cc-15ef-b667-29d2-155793537b01
msgctxt "h1a9a9177gfffbg4e50g9549g1d19222c5e75"
msgid "I already met Balthazar."
msgstr "발타자르는 이미 만났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = bff10dea-0859-f620-cb60-c6c4c06e29c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:bff10dea-0859-f620-cb60-c6c4c06e29c1
msgctxt "hfef8b367g1bbfg4bc7g8267g6c7e4c4a4742"
msgid "I've been to Last Light. Without Isobel, everyone there will die."
msgstr "최후의 빛에 가본 적 있지. 이소벨이 없으면, 거기 있는 사람들은 전부 죽을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = c05d6947-cfd0-66fb-585c-7a83aff7e1fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_KethericNeedsArtifact = True
#.      - MOO_Executioner_State_SpecialStashAccess = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c05d6947-cfd0-66fb-585c-7a83aff7e1fb
msgctxt "haf18c6f7g64a0g4366g9b78g97c80537543f"
msgid ""
"The relic is vital to Ketheric's plans - you should be giving me more "
"support."
msgstr "유물은 케서릭의 계획에 필수적이야. 지원이 좀 더 있으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = c08ffd2c-77c1-db4d-2a6f-643fbc86362c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c08ffd2c-77c1-db4d-2a6f-643fbc86362c
msgctxt "h8d2e67eag89ebg42a5gb45cgbd6ab12f1432"
msgid ""
"No... just a jumble of nonsense. Shame, I didn't have you pegged as a "
"simpleton."
msgstr "이런... 전부 헛소리 뿐이군. 네가 멍청이인 줄은 몰랐는데, 유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = c1588956-e14e-385d-5c76-dd9cd7ef88ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c1588956-e14e-385d-5c76-dd9cd7ef88ef
msgctxt "h95edcb00gdc25g4070g8a04g10616be1255d"
msgid "My words were a test of your faith. I, too, am glad to serve."
msgstr "너의 믿음을 시험하려고 한 말이야. 나도 섬길 수 있어 기뻐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = c19e19ac-1117-22cd-cf26-228d979c610c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c19e19ac-1117-22cd-cf26-228d979c610c
msgctxt "hd73976c8g4898g4880g8999ge5e19cdef2ba"
msgid "Show some respect - I'm a True Soul."
msgstr "존중해주시지, 난 참된 영혼이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = c42ff6a9-28f6-bdaf-66f8-9d4c3e2685d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c42ff6a9-28f6-bdaf-66f8-9d4c3e2685d9
msgctxt "h109a2308gde39g4f68ga0dcg455b90d84c81"
msgid "How confident. We could have had fun, you and I... but duty calls."
msgstr "자신감이 넘치네. 우리 둘이 재미를 좀 볼 수도 있을 텐데... 할 일은 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = c4af1d00-a59b-e166-feec-ca54aac224e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_PartneredWithKarlach(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c4af1d00-a59b-e166-feec-ca54aac224e5
msgctxt "h33dc102eg79a1g4016g9cbdgb706fc49f7a7"
msgid ""
"She's formidable. But how many days of passion will you get out of her? How "
"many nights? The Absolute will give you something that can last."
msgstr ""
"그녀는 어마어마하군. 하지만 열정을 끌어낼 수 있는 날이 얼마나 될까? 그런 밤이 계속될까? 절대자께선 영원히 지속될 무언가를 주실 수 "
"있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = c58d4834-f7be-1ff0-f4f5-0a419ad37f6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c58d4834-f7be-1ff0-f4f5-0a419ad37f6c
#, fuzzy
msgctxt "h2b75c134g7d17g4963g9293g5779b17239ec"
msgid "I have already been blessed to stand in Her presence. It was bliss."
msgstr "난 이미 그분의 존재를 대리하는 축복을 받았다. 더없는 행복이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = c5d90950-2092-7304-94b0-c52f22b3b3b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c5d90950-2092-7304-94b0-c52f22b3b3b5
msgctxt "haab9de88g7a72g49b0g87f2g722fde57a712"
msgid "Guards!"
msgstr "경비병!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Radija
#. NodeID = c7ced241-07c2-39a5-8893-ca67801ccd9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c7ced241-07c2-39a5-8893-ca67801ccd9a
msgctxt "h2f6679bagb9a7g40e3gb35bg6a96af425c48"
msgid "Even you, Disciple Z'rell?"
msgstr "신봉자 즈렐, 당신도 말인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = c973648b-b664-a720-a780-88c55414a88e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingKarlach(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:c973648b-b664-a720-a780-88c55414a88e
msgctxt "h870a3038g87d7g4e82g85efg22b81cf98fbc"
msgid "<i>Distract her with thoughts of your aching for Karlach.</i>"
msgstr "<i>칼라크에 대한 애절한 감정을 떠올려 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = cc150941-4886-118f-a70e-94f654a8b2c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:cc150941-4886-118f-a70e-94f654a8b2c9
msgctxt "h5d95d109ge128g47d6g9ac0g770690e76c9d"
msgid "Apologies. What do I need to do?"
msgstr "미안하군. 내가 뭘 하면 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = cce3f6d6-ce3d-a18b-02ca-ae10506caba7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:cce3f6d6-ce3d-a18b-02ca-ae10506caba7
msgctxt "h867d35a5g37dag4063g9cfege9fc9213b540"
msgid "She's offering a way forward. You would be wise to play along."
msgstr "그녀는 우리에게 길을 열어주고 있어요. 협조하는 척 하는 게 좋을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = cce3f6d6-ce3d-a18b-02ca-ae10506caba7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:cce3f6d6-ce3d-a18b-02ca-ae10506caba7
msgctxt "h139b4d65gbf14g4168ga361g04fcab5c358a"
msgid "She's offering a way forward. You would be wise to play along."
msgstr "그녀는 우리에게 길을 열어주고 있어요. 협조하는 척 하는 게 좋을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d128d9bd-ff4b-a2a4-f28c-eb129bc32342
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Executioner_State_AnnoyedAtPlayer(1) = True
#.      - MOO_Executioner_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d128d9bd-ff4b-a2a4-f28c-eb129bc32342
msgctxt "hc482bff2ga6f0g404agb3aeg2147d7ca2894"
msgid ""
"The great liberator. You should go and join your goblin friends out in the "
"curse."
msgstr "해방자 납셨군. 나가서 저주 받으면서 고블린 친구들과 놀지 그러나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d1839562-2d53-b413-20b7-dddfa366db8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d1839562-2d53-b413-20b7-dddfa366db8c
msgctxt "h5144c86dg13e7g4e53g9ce9gec74c62e4829"
msgid "But later, perhaps. General Thorm is ready to see you."
msgstr "다음에 하면 되겠지. 쏨 장군께서 널 보자신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d18c4ee6-2dcc-fc35-6105-f08428cbcac4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Audience_State_GrantedPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d18c4ee6-2dcc-fc35-6105-f08428cbcac4
msgctxt "h317ec3dfg14bbg455dga4dfgd6355872822c"
msgid ""
"A pity. I was starting to like you. Go to the roof - the General awaits."
msgstr "안타까워. 이제 네가 좋아질 참이었는데. 옥상으로 가라, 장군께서 기다리신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d1e52f23-b596-0bdf-d685-f667ec3ff4e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d1e52f23-b596-0bdf-d685-f667ec3ff4e6
msgctxt "h58575d8eg56a3g4a80ga08ag2b3c3c7eb444"
msgid ""
"You visited Last Light. And you brought about the deaths of everyone who "
"sheltered there."
msgstr "최후의 빛에 갔다던데. 그리고 거기 사는 사람들 모두 죽여버렸다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d28f0447-dd44-58a7-59f6-de9808702e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d28f0447-dd44-58a7-59f6-de9808702e3b
msgctxt "h885f4c4ag4b82g458dgaaecg5a8e6256d741"
msgid ""
"Oh, why not? What's the point in power if you don't get to have a little fun "
"every now and again?"
msgstr "오, 좋아. 가끔 재미도 못 보면 힘이 무슨 소용이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = d44e62d4-798f-0d12-d854-945cb9d20631
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d44e62d4-798f-0d12-d854-945cb9d20631
msgctxt "hd627b5dfga36ag4e2eg8dc6g8ff023cf8774"
msgid ""
"*She draws in your fury, and turns it back against you in a tide of raw "
"emotion.*"
msgstr "*그녀가 당신의 분노를 흡수해, 날것 그대로의 감정으로 당신에게 돌려줍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d68a2507-23fa-d7e4-1031-91d6124a44a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d68a2507-23fa-d7e4-1031-91d6124a44a6
msgctxt "h29e2c1e1g2c2bg41dag9acagcbaf1efb783d"
msgid ""
"And the best way to do that is to serve General Thorm. I have a mission for "
"you."
msgstr "그리고 그러는 가장 좋은 방법은 쏨 장군을 섬기는 것이지. 너에게 줄 임무가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d6d6fca3-4450-c102-2629-589a52717093
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d6d6fca3-4450-c102-2629-589a52717093
msgctxt "hb56e9232g64c2g405fgbd95g9f49c7d566a2"
msgid ""
"My, my. Your lust for the neck-pricker is succulent - I'd like to take a "
"bite out of him myself."
msgstr "이런, 이런. 목을 무는 자에 대한 네 욕정은 참 먹음직스럽구나. 나도 그를 한 입 하고 싶은데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = d7a3e9d9-4d9f-3f7b-2ee4-515bbcce3eb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d7a3e9d9-4d9f-3f7b-2ee4-515bbcce3eb9
msgctxt "h1a367b78g8d76g45abg8f15gbd1436a16a45"
msgid ""
"*Her presence fills your mind, caressing, stroking, kissing... then clawing, "
"biting, cutting.*"
msgstr "*그녀의 존재가 당신의 정신을 채워, 당신을 어루만지고, 쓰다듬고, 입을 맞추다... 할퀴고, 물고, 베어냅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = d7bd7428-66c7-b250-f57c-30a6de713714
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d7bd7428-66c7-b250-f57c-30a6de713714
#, fuzzy
msgctxt "h52c6af71g0827g49bdga107g531ef976f907"
msgid "I know - I've yet to kill you, and all the other vermin in this place."
msgstr "알아. 너랑, 여기 벌레 새끼들을 아직 안 죽였잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d9288104-bda6-2512-82c8-c5ffcce67268
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Knows_BalthazarIsMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d9288104-bda6-2512-82c8-c5ffcce67268
msgctxt "hcf77055dgc79ag4755g8f8eg7485d9a521af"
msgid ""
"But we have lost contact with him - go there, aid Balthazar if you can, and "
"bring the relic home."
msgstr "하지만 그와의 연락이 끊겼어. 거기로 가서, 할 수 있다면 발타자르를 보조하고, 유물을 가져와라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d99b4967-2d30-1a90-7a96-52ba07e08cc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d99b4967-2d30-1a90-7a96-52ba07e08cc5
msgctxt "hb128c705g11e2g49e7gaf86gaa7d33341443"
msgid ""
"Yes, and he failed to find it. Little wonder he hasn't returned here - you "
"have seen how the General deals with incompetents. They bleed."
msgstr ""
"그래, 그는 실패했지. 돌아오지 않은 것도 당연한 일이야. 장군께서 무능한 자를 어떻게 다루시는지는 봤겠지. 피를 흘리게 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d9e83e4b-6bed-b142-8fd9-bdb2e7152a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:d9e83e4b-6bed-b142-8fd9-bdb2e7152a56
msgctxt "h5a4c6a76gaf91g4688g90b0gab01d67bcaa1"
msgid ""
"She gave me the power to delight with a thought - or to kill. So stay on my "
"good side."
msgstr "그 분께서는 내게 생각만으로 기쁨을 줄, 그리고 죽일 힘을 주셨다. 그러니 내게 잘 보이는 편이 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = dce584ef-87c3-37ed-a54a-edad04f636ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:dce584ef-87c3-37ed-a54a-edad04f636ec
msgctxt "h4ca8c305g8d74g40deg98fag22baf84016d2"
msgid "But not before time. There is more work for you yet."
msgstr "하지만 때가 되기 전엔 안돼. 아직 네가 해야 할 일이 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = dcece8fd-2e4e-47be-ac68-a3c80421ba43
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:dcece8fd-2e4e-47be-ac68-a3c80421ba43
msgctxt "hc5b67573g3f66g4076gb6efg2db23d1cf634"
msgid ""
"That's it - play along. The closer you can get to the General, the closer "
"you'll be to the answers you seek."
msgstr "좋아요, 협조하는 척 하세요. 장군에게 가까워질수록, 당신이 찾는 답에 가까워질 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = dcece8fd-2e4e-47be-ac68-a3c80421ba43
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:dcece8fd-2e4e-47be-ac68-a3c80421ba43
msgctxt "h5665b936g3cf6g4e6egbfaag56fa38c61bf1"
msgid ""
"That's it - play along. The closer you can get to the General, the closer "
"you'll be to the answers you seek."
msgstr "좋아요, 협조하는 척 하세요. 장군에게 가까워질수록, 당신이 찾는 답에 가까워질 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = dd304c7d-c93f-7db6-4b71-e3b16638fb50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:dd304c7d-c93f-7db6-4b71-e3b16638fb50
msgctxt "h70054f3ag01b0g4509gb41cg14a1ff49059c"
msgid ""
"Rescued, abducted, pleasure, pain... All a matter of perspective. This is "
"where she belongs - with General Thorm."
msgstr "구출이니, 납치니, 기쁨이니, 고통이니... 전부 관점의 차이지. 그녀는 여기 쏨 장군님과 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = de8f2b88-6808-f744-b4b9-06650291a105
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:de8f2b88-6808-f744-b4b9-06650291a105
#, fuzzy
msgctxt "h1dc1351dg440ag44e2g8319gcf56e9d619c9"
msgid "Forgive me, Disciple. I have no excuse."
msgstr "죄송합니다, 신봉자님. 면목이 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = df88d205-95c8-be2d-80c3-9c6744645b3c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Executioner_Event_AskedToKidnapIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:df88d205-95c8-be2d-80c3-9c6744645b3c
msgctxt "h157716cag1538g4b41g8655g0a198842536a"
msgid ""
"There is an old inn nearby called Last Light. Some rabble are sheltering "
"there, along with a cleric named Isobel. We have a friend on the inside, "
"watching her."
msgstr ""
"근처에 최후의 빛이라는 낡은 여관이 있다. 폭도들이 진을 치고 있는데, 이소벨이라는 클레릭이 같이 있지. 내부에 그 여자를 감시할 첩자도 "
"심어 놨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = dfad6543-c4b6-4a73-933c-eb06f1f93fa0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:dfad6543-c4b6-4a73-933c-eb06f1f93fa0
msgctxt "h8917a80bgaf14g4980g90b2gaef744485a97"
msgid ""
"True Souls share thoughts - they do not steal them. Guards! We have a spy."
msgstr "참된 영혼은 생각을 공유하지, 훔치지 않아. 경비병! 첩자가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = dfde2d51-92e2-3134-2699-21e1ab3e8f7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:dfde2d51-92e2-3134-2699-21e1ab3e8f7a
msgctxt "h7b31c04dg77b9g41b6ga822gce26f7a8047d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e2bbdfe0-f366-d2be-fe47-cc87e0c0018c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e2bbdfe0-f366-d2be-fe47-cc87e0c0018c
msgctxt "h7a7e9c48g0417g45fegb895g2de1a5cdda98"
msgid ""
"I can see... Makes me wonder how deep and dark those talents of yours run..."
msgstr "그렇군... 네가 가진 재능이 얼마나 깊고 어두운지 궁금해지는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e2bcf98b-42c8-c30f-4622-dce935be47ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e2bcf98b-42c8-c30f-4622-dce935be47ae
msgctxt "h885b4841g350eg4a2dga50egaef09ce3880b"
msgid ""
"There is a relic that General Thorm requires - he sent his most trusted "
"advisor, Disciple Balthazar, to retrieve it."
msgstr "쏨 장군께서 필요로 하시는 유물이 있다. 장군께서는 가장 신뢰하는 고문인 신봉자 발타자르에게 그걸 회수해 오라고 하셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e2d869a2-0a00-fe12-31da-d31a1d3d6711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e2d869a2-0a00-fe12-31da-d31a1d3d6711
msgctxt "hd1ac31dbg0082g4f5agaf9ag1524a086c868"
msgid ""
"General Thorm has his precious cleric of Selûne by his side, but he's still "
"short a necromancer."
msgstr "쏨 장군님 곁에 그 분의 소중한 셀루네의 클레릭이 있긴 하지만, 아직 사령술사가 하나 부족해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = e305abcd-8742-bf49-d0a7-16431c0eeaa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e305abcd-8742-bf49-d0a7-16431c0eeaa6
msgctxt "h3c2e351fg445ag4f24gb117gd0b6b10bc10d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e32c5d25-3ed9-d55a-5e4a-b1bb6358d853
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e32c5d25-3ed9-d55a-5e4a-b1bb6358d853
msgctxt "h8b8e89d4g807eg4489g9ca8gab1f8999fb98"
msgid "Plenty. But I hoped someone of your talents would be more ambitious."
msgstr "많지. 하지만 너 같은 재능을 가진 자라면 더 야심찬 사람일 거라 기대했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e36a1cfb-4b32-b195-2131-3d004cc1844c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e36a1cfb-4b32-b195-2131-3d004cc1844c
msgctxt "hc7d34071gaf15g4a45g8614gcc2c3d163ef9"
msgid "I'm going to have to teach you some obedience."
msgstr "넌 복종하는 법을 좀 배워야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e556306e-6420-9132-6b1a-b6b46ef14da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e556306e-6420-9132-6b1a-b6b46ef14da0
msgctxt "h901fd9aag300eg4985g9096gc356477c85f2"
msgid "Take one from Balthazar's chambers."
msgstr "발타자르의 방에서 하나 가져가도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e55a16a7-424b-ec64-7f0c-3c040fbe89a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e55a16a7-424b-ec64-7f0c-3c040fbe89a1
msgctxt "h65a735c1g64ceg4d69g9b0eg65d0c36c6f88"
msgid ""
"Not all. The cleric Isobel held the shadows from Last Light, and General "
"Thorm wanted her returned to Moonrise alive."
msgstr "다는 아니야. 클레릭 이소벨이 최후의 빛을 지키고 있으니까, 그래서 쏨 장군께서 그녀를 산 채로 잡아오길 원하시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = e7c459a0-3643-fc15-90c2-d9e6f53c076d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyIsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e7c459a0-3643-fc15-90c2-d9e6f53c076d
msgctxt "hc4597432g73abg4d0bg97f3gc38e9a5bf5de"
msgid "Marcus is dead. Isobel won't let her guard down again."
msgstr "마커스가 죽었어. 이소벨이 경계를 푸는 일은 없을 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = e83c93fa-e997-5f58-c2b1-d9cb6cc58170
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e83c93fa-e997-5f58-c2b1-d9cb6cc58170
msgctxt "h10dbd6f8g9ae1g4c64ga97cg208c5f6878c4"
msgid "I'm at your service - tell me what to do."
msgstr "좋아, 뭘 해야 할지 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = e846a593-3982-bbd7-38a3-311a5c98d5a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e846a593-3982-bbd7-38a3-311a5c98d5a3
msgctxt "h9bd32184gcbd9g4936gac71gc3cdb7f842bd"
msgid "Show me the power She gave you."
msgstr "네가 받은 그 힘을 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e9356a17-a162-4ac4-5f26-8619ae37fedb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e9356a17-a162-4ac4-5f26-8619ae37fedb
msgctxt "h36d6b524gf694g47d9gb873gaee5fcba1b1a"
msgid ""
"Go and retrieve Isobel from Last Light. There is nothing else to discuss "
"until it is done."
msgstr "최후의 빛으로 가서 이소벨을 데려와. 그 전까진 너와 할 말은 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e965a517-27c4-5d9b-cefe-05fe14b8019c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e965a517-27c4-5d9b-cefe-05fe14b8019c
msgctxt "h5fa25904g5903g48e2g91fag79ba55590059"
msgid ""
"It is something that General Thorm desires, and that he has ordered us to "
"retrieve. That is all you need to know."
msgstr "쏨 장군께서 원하시고, 찾아오라는 명령을 내리신 물건이지. 알아야 하는 건 그게 다다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = e9c21ea9-25b3-e968-5f54-a5139b0c5348
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:e9c21ea9-25b3-e968-5f54-a5139b0c5348
msgctxt "h5872c7e2g5903g4430gaee7g68a8827d7ef6"
msgid ""
"Then he must have failed to make the urgency of his mission clear. I do not "
"want to see you again until the relic is secure at Moonrise."
msgstr "그럼 그가 임무가 얼마나 중요한지 설명하지 못했나 보군. 유물이 문라이즈에 확보되기 전까진 내 앞에 나타나지 말도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = eb06a42f-6086-5bcf-b257-2a2baf979b5d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - ORI_State_DatingGale(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:eb06a42f-6086-5bcf-b257-2a2baf979b5d
msgctxt "h6fe4123bg27d4g4e6fgbcdfg887b9bad1b62"
msgid "<i>Distract her with your yearning for Gale.</i>"
msgstr "<i>게일에 대한 간절한 생각으로 그녀를 교란시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = eba93149-1566-7b94-0b27-fa0f12659c5a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_AboutArtefact = True
#.   Local:
#.      - 2812a3a3-b4ef-20ce-cc3e-e5a9315568eb_MindHasBeenRead = False
#. SetFlags:
#.   Local:
#.     - 2812a3a3-b4ef-20ce-cc3e-e5a9315568eb_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:eba93149-1566-7b94-0b27-fa0f12659c5a
msgctxt "hc3f6fd02g76a5g4cc3gb1e8g7f358856874d"
msgid ""
"<i>She became anxious when you asked about the relic - probe her "
"thoughts.</i>"
msgstr "<i>그녀는 유물에 대해 질문을 받고는 불안해 했다. 그녀의 생각을 들여다본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ec25c465-d4ca-01a9-8d49-831afcfdf57e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ec25c465-d4ca-01a9-8d49-831afcfdf57e
msgctxt "hab64d437g599cg4e61gbe55gce6d738b8ca3"
msgid ""
"I've never lain with a githyanki. It looks like this one nearly broke you in "
"half - how invigorating."
msgstr "난 기스양키와는 자 본 적 없어. 넌 허리가 나갈 뻔 했나 보군. 참 정력적이구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ec8c5cee-e362-3338-de57-7cac8c7a26fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ec8c5cee-e362-3338-de57-7cac8c7a26fd
msgctxt "h0ba8e0f3g23e6g481eg88c4g3e4c5f5a192c"
msgid ""
"I hear Balthazar has returned, and more importantly, the Nightsong is with "
"him."
msgstr "발타자르가 돌아왔다던데, 게다가, 밤의 노래를 가져왔다더라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = ee25f90d-6088-4ebf-a56a-f8846482e29f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ee25f90d-6088-4ebf-a56a-f8846482e29f
msgctxt "h7432d622gc68cg44b0g8183g864a4aff8109"
msgid "Why does the Absolute want her alive?"
msgstr "절대자는 왜 그녀를 생포해 오라는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ef4829b9-1e1b-f84c-a7d4-21972f779333
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ef4829b9-1e1b-f84c-a7d4-21972f779333
msgctxt "h62c8ff65g44feg4149gb8b2geabe3e210628"
msgid ""
"Perfect. You crave what all True Souls should - to be touched by the "
"Absolute."
msgstr "완벽해. 참된 영혼이라면 모두 원하는, 절대자님의 손길을 갈망하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ef920668-61cd-5f25-92d2-3f948b88f06f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ef920668-61cd-5f25-92d2-3f948b88f06f
msgctxt "he1430b39g367fg4c35g9deeg77160e9eac4b"
msgid ""
"Exquisite. You're brimming with power already. But the Absolute can give you "
"even more."
msgstr "놀랍군. 넌 이미 힘으로 가득 차있어. 하지만 절대자께서는 훨씬 더 많은 것을 줄 수 있으시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = f316b2fa-7746-e435-306c-544e38af4ed0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f316b2fa-7746-e435-306c-544e38af4ed0
msgctxt "h16b8f950g0ab0g4d7cgb160g02bd9eaad392"
msgid ""
"A waste of my time - I didn't come here to clean up other people's mistakes."
msgstr "시간 낭비야. 난 여기에 다른 사람 뒤치다꺼리나 하러 온 게 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f32c5cd0-8b76-3f6a-233e-ced96d59024d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f32c5cd0-8b76-3f6a-233e-ced96d59024d
#, fuzzy
msgctxt "h1e3f80e8g9a8bg4772g833dgf34fd9b3913b"
msgid ""
"Then go purge those nerves - kill something, or hump something, or both. The "
"general will not tolerate any doubt in his servants."
msgstr "그럼 긴장을 좀 풀고 와, 뭘 죽이든지, 박든지, 아니면 둘다 하든지. 장군님께선 종복들의 의심을 용납하지 않으실테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = f361396b-2173-abc1-9a0c-0b5ceba34655
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f361396b-2173-abc1-9a0c-0b5ceba34655
#, fuzzy
msgctxt "h48f2a048gc661g4818gbc90g9a175c3c0fc2"
msgid ""
"*Your pulse races, your heart strains, then as suddenly as it began, the "
"pain becomes overwhelming pleasure.*"
msgstr ""
"*당신의 맥박이 빨라지고, 심장에 압박이 가해집니다. 그러다, 시작되었을 때만큼 갑작스럽게, 고통이 압도적인 쾌락으로 변합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = f4e99639-55b5-4e01-8c05-fe4d75396364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f4e99639-55b5-4e01-8c05-fe4d75396364
msgctxt "h1cb8df50gdbc2g4141gb89dg7805546216ec"
msgid "Oh, do you? Well, it so happens that I have a price."
msgstr "아, 그러셔? 근데 난 무급으로 일하진 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f4f2aa7d-719c-c7ca-bbe3-d2a546cf54af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f4f2aa7d-719c-c7ca-bbe3-d2a546cf54af
#, fuzzy
msgctxt "hacd09b5ag7eb1g4530g989bg8bc96119a590"
msgid ""
"Have I not been clear? Find Balthazar - and more importantly, the relic he "
"holds. Neither of which, you'll notice, are <i>here.</i>"
msgstr "내가 말하지 않았나? 발타자르를 찾아라. 더 구체적으로, 그가 가진 유물을 찾아. 보다시피, 둘 다 여기 <i>없거든.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = f55b617c-53dc-557e-7a4c-f4cb83289e1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f55b617c-53dc-557e-7a4c-f4cb83289e1c
msgctxt "h930eb91egc3d8g4e63g8b59g29a0f9cd0b9b"
msgid "Everything? What exactly do you want?"
msgstr "모든 것? 정확히 뭘 바랐는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f6a88ef2-6730-7f83-561f-c990d4fd376d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f6a88ef2-6730-7f83-561f-c990d4fd376d
msgctxt "h25b97211gb05fg4aa6ga909g638e922e1d1c"
msgid ""
"Caution... hesitation. You fear power, even when it is offered freely. Would "
"you waste the Absolute's gifts as well?"
msgstr "신중함... 망설임. 너는 힘이 거저 주어질 때조차도 힘을 두려워하는군. 절대자님의 선물도 낭비할 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = f6d4af5b-09cb-ada6-6dae-92d3d69958e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SpyIsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f6d4af5b-09cb-ada6-6dae-92d3d69958e3
msgctxt "h53e92483gffc5g404ag9561g662765f6118e"
msgid "Marcus is already dead. Isobel won't let her guard down again."
msgstr "마커스는 이미 죽었어. 이소벨이 또 방비를 허술하게 할 것 같진 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f802ec87-5403-3229-af8f-479abe55dd22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f802ec87-5403-3229-af8f-479abe55dd22
msgctxt "h61a4b60dg350eg4384gb0fege3ad2b10e8b1"
msgid "In a word - freedom."
msgstr "한마디로, 자유."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f8b70ed1-8139-f4cb-c4fd-8ce09f4aeca6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f8b70ed1-8139-f4cb-c4fd-8ce09f4aeca6
#, fuzzy
msgctxt "hff3d68ccga503g4efcga8f6g3289f7f66367"
msgid ""
"Death would not silence Balthazar for long. But dead or alive, he is lost."
msgstr "죽음도 발타자르를 오래 침묵시키진 못할 거다. 하지만 그가 죽었든 살았든, 실종 상태인 건 변하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f8f2e47e-8241-b0e0-8101-6f285abe3a21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f8f2e47e-8241-b0e0-8101-6f285abe3a21
msgctxt "h12cd992cg6f4eg4be6g8a2egfce58bdb2908"
msgid ""
"How easily you forgive yourself, with no <i>concept </i>of what your failure "
"means."
msgstr "자신에게 정말 관대하군. 자기가 실패했다는 게 무슨 의민지 <i>알지도</i> 못하면서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = f92a3125-d6ec-4e2a-fa0d-441b3a65499d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f92a3125-d6ec-4e2a-fa0d-441b3a65499d
msgctxt "h4e5d80f6g2d20g495cg8c4eg3e9fcaaed14f"
msgid "'Rescued' isn't the word I'd use. I abducted her."
msgstr "난 '구출'한다고 한 적 없는데. 납치해온 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f9af6190-1998-49cd-a8ba-cf93d97002cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f9af6190-1998-49cd-a8ba-cf93d97002cb
msgctxt "hec56854eg5050g49cag9b39g4701f99ed4d3"
msgid ""
"You came here to answer the Absolute's call. Let's see what you're made of."
msgstr "절대자께서 부르셔서 여기 왔으니. 네가 어떤 사람인지 한 번 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Narrator
#. NodeID = f9ba4cf6-055a-027e-e6a0-bb504043de34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Background_Urchin_BlockedZrellMindMeld = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f9ba4cf6-055a-027e-e6a0-bb504043de34
msgctxt "hdda11ba0g75d0g4c9eg8c59gce54bb5181c9"
msgid ""
"*She has opened her mind fully, expecting to find adoration and faith. Your "
"fury hits her like a bolt in the throat.*"
msgstr "*그녀는 애정과 믿음을 기대하고, 정신을 활짝 열어두었습니다. 당신의 분노가 목에 박힌 화살처럼 그녀를 강타합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = f9fafb60-52b3-9a93-8069-193a987fed62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:f9fafb60-52b3-9a93-8069-193a987fed62
msgctxt "h111687b2g0c12g48e0g8a8ag8e6944002da5"
msgid ""
"If they do, Balthazar will pull himself back together again. Nere won't - "
"his usefulness has expired."
msgstr "그렇게 되면, 발타자르는 스스로를 도로 짜 맞출거다. 니어는 그러지 못하겠지. 그 놈은 더 이상 유용하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = faf78341-5d72-9668-6997-8315bc2f4248
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:faf78341-5d72-9668-6997-8315bc2f4248
msgctxt "h7de16a41gc5d5g40b6ga530gd592e11b5a48"
msgid "What exactly was this relic he was sent to retrieve?"
msgstr "발타자르가 찾아야 한다는 이 유물이 정확히 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = fc951c98-867b-b155-c81c-4f753298d255
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:fc951c98-867b-b155-c81c-4f753298d255
msgctxt "he1ccc59cg9f2cg4059g8655g4abdc1a90bae"
msgid ""
"We're not the most welcome guests, but Ketheric and the Absolute are waiting "
"for us. Be ready for anything."
msgstr "우리가 귀빈은 아니지만, 케서릭과 절대자가 우릴 기다립니다. 대비하고 계십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = GROUP_Daisy
#. NodeID = fc951c98-867b-b155-c81c-4f753298d255
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:fc951c98-867b-b155-c81c-4f753298d255
msgctxt "hcddcdf6cga59eg4564g9d7eg691562189d6c"
msgid ""
"We're not the most welcome guests, but Ketheric and the Absolute are waiting "
"for us. Be ready for anything."
msgstr "우리가 귀빈은 아니지만, 케서릭과 절대자가 우릴 기다립니다. 대비하고 계십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Player
#. NodeID = fd4b8a7f-5303-31f4-be52-5fe99048f52b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:fd4b8a7f-5303-31f4-be52-5fe99048f52b
msgctxt "h113a8d1dgcee5g479bg806dg21cd0ac511aa"
msgid "I think so. A little nervous, perhaps."
msgstr "그런 거 같아. 어쩌면, 조금 긴장했을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = ff3d9c34-1e31-7dba-b9e5-dea3b8987ceb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Executioner:ff3d9c34-1e31-7dba-b9e5-dea3b8987ceb
msgctxt "h62e703feg309cg4534g8f0eg45b632a3ab71"
msgid "Explain yourself."
msgstr "설명해 봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 01f22a51-5629-bf48-ed6e-fb94ef6f6b76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:01f22a51-5629-bf48-ed6e-fb94ef6f6b76
msgctxt "h0d9a4933gd796g46c9g8cadgae4ad0967949"
msgid "Sorry. Fresh out of rotting flesh."
msgstr "미안하군. 썩어가는 살점 속에서 막 나온 참이라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 08173bfa-a107-2a9f-7930-c9b3c7c0b5f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:08173bfa-a107-2a9f-7930-c9b3c7c0b5f7
msgctxt "hc8c40fc4ge5c3g4fd1g9fddg02acb9fa7535"
msgid "You... would not. <i>Could </i>not. I..."
msgstr "너... 아니잖아. <i>그럴리</i> 없어. 난... "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 0924e102-15c4-fb9e-38aa-8f867a7e928a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:0924e102-15c4-fb9e-38aa-8f867a7e928a
msgctxt "hcc611fb3g1258g4403gb332gfbc77382a3de"
msgid ""
"We <i>hunger</i>, True Soul. The Absolute promised us a feast of corpses, "
"and still we <i>starve!</i>"
msgstr ""
"우린 <i>굶주렸다</i>, 참된 영혼. 절대자께서 시체로 잔치를 열어주겠다 약속했는데, 우린 여전히 <i>배가 고프다고!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 1429dcd9-2e6e-4bce-8ebf-f79b8e67f9b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_FlyingGhouls_Event_GhoulsTurned = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:1429dcd9-2e6e-4bce-8ebf-f79b8e67f9b3
msgctxt "h4e596f2bg0ffdg42afg9a20gd4f2e07ef070"
msgid "They would never -"
msgstr "저들이 그럴리가 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 14c66ce3-0930-9488-f506-b369fa29b03a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:14c66ce3-0930-9488-f506-b369fa29b03a
msgctxt "h1d6cc316gb539g4434gaa2eg5164a1eae819"
msgid "<i>SILENCE!</i>"
msgstr "<i>조용!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = 19261740-3ce1-40c6-b186-40fdbb4672da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:19261740-3ce1-40c6-b186-40fdbb4672da
msgctxt "h05efccd1g536cg4eb3g8ed2gae7ddaab74b3"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 1d42e14d-05c2-85a3-e1e2-e3419f0cf4d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_FlyingGhouls_Knows_CorpsesBelow = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:1d42e14d-05c2-85a3-e1e2-e3419f0cf4d8
msgctxt "hc115af06gac3ag42b1g8700gbe60f8a9d4dd"
msgid ""
"They drop corpses down into the tunnels below the tower. Enough to feed an "
"army of us!"
msgstr "시체를 타워 아래 터널로 던져 넣고 있어. 우리 전부를 배불리 먹이고도 남을 양이라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 1dd604c1-1c18-94f0-a996-03d0b15948b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:1dd604c1-1c18-94f0-a996-03d0b15948b3
msgctxt "h8d08647fga1dcg46c7g9a56gced56a78b31b"
msgid "The Absolute owes you nothing. <i>You</i> owe <i>Her </i>your faith."
msgstr "절대자께서 네게 뭘 바치는 게 아니야. <i>네가</i> 믿음을 <i>그분</i>께 바치는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 22e2d760-0e06-167f-5718-0f2f9604ffd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:22e2d760-0e06-167f-5718-0f2f9604ffd6
msgctxt "h07f06ed4g6b24g4eb2gac59gb73f9cc66255"
msgid "<i>Foot flesh?!</i>"
msgstr "<i>발 고기?!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 2434e70d-e851-7abe-70db-44e282346af7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:2434e70d-e851-7abe-70db-44e282346af7
msgctxt "h9b5abe74gf9d3g4221g9763gbcb9caf2ae90"
msgid "Have patience. There's a lot of flesh waiting in Baldur's Gate."
msgstr "인내심을 가져. 발더스 게이트에 널린 게 살코기다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 27d57105-9e90-5927-05fb-c3d71459564d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:27d57105-9e90-5927-05fb-c3d71459564d
msgctxt "h1b00657bg9b1ag4b8bgb94egb7cac0af5820"
msgid "Yes... so much flesh. A <i>mountain</i> of it... Fine."
msgstr "그래... 너무나 많겠지. <i>산</i>처럼 쌓여있을 거야... 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 2c9983a3-f45a-bfee-c263-06f51f082b0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:2c9983a3-f45a-bfee-c263-06f51f082b0c
msgctxt "hdb7d9a17g90c3g4f0fg8242g7e9fe097927a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = 2cbc988f-23d3-4f92-8189-419ffea8d4cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:2cbc988f-23d3-4f92-8189-419ffea8d4cf
msgctxt "hf49f412cg734bg40c1g845ag263f9679ad1e"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = 2f8a09f8-b75b-4451-9ca1-69926297bc79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:2f8a09f8-b75b-4451-9ca1-69926297bc79
msgctxt "h2d902770g5646g49c0g9ff4ge6bc9b33654a"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 31802159-4e9c-1eb7-80d6-c4904d894ee5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_FlyingGhouls_Knows_CorpsesBelow = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:31802159-4e9c-1eb7-80d6-c4904d894ee5
msgctxt "h6c967176gb8dag4f8cgb476g6cd1d8e19b23"
msgid ""
"Liar! They drop corpses beneath the tower. Some beast in the tunnels gets "
"fat, while we go hungry!"
msgstr "거짓말! 시체를 타워 아래로 던지고 있어. 터널에 사는 짐승들은 살을 찌우는데, 우리는 굶고 있잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 329c6c7f-8179-4654-9652-7805d2044fc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:329c6c7f-8179-4654-9652-7805d2044fc6
msgctxt "h3cd2ae00ga7e6g4398gb544ga89d72fdf0d7"
msgid ""
"Your friends seem faithful enough. So they may start by feeding on <i>your</"
"i> flesh."
msgstr "네 친구들은 꽤나 신실해 보이는데. 이러다 <i>네가</i> 쟤네 먹이가 될 수도 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 34294263-c0a3-5004-97e6-e03c13d1a7cc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:34294263-c0a3-5004-97e6-e03c13d1a7cc
msgctxt "h7cc31838g30a4g426ega874g22738b71276c"
msgid "No. You do not stink as much as we like... but you will do. FEED!"
msgstr "멈춰. 우리가 좋아하는 만큼 냄새가 많이 나진 않지만... 이 정도면 되겠지. 식사다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 3c94040d-4b3f-4d37-ad3f-19099551f170
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:3c94040d-4b3f-4d37-ad3f-19099551f170
msgctxt "h98ef89d9g4077g4b02g86d7g56c90fe0ae60"
msgid "But you... you look so much juicier. FEED!"
msgstr "하지만 넌... 꽤 먹음직스러워 보이는군. 식사다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 405ed72b-dbad-f353-bd38-c57c09900274
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:405ed72b-dbad-f353-bd38-c57c09900274
msgctxt "h0a89adcegc59fg4c23g9115g167ef9fd6fb9"
msgid "Enough. I wish to taste True Soul. FEED!"
msgstr "그쯤 해둬. 참된 영혼은 어떤 맛일지 궁금하군. 식사다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 436e526f-0847-8ad6-9e29-52d9be9789e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:436e526f-0847-8ad6-9e29-52d9be9789e7
msgctxt "h5abbaba0g4357g4cbagbb39g033e34d06620"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 630b81fb-ef9a-5731-1f02-bc25dd20b061
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:630b81fb-ef9a-5731-1f02-bc25dd20b061
msgctxt "hddce11f7g4de8g4e13ga5e3gf2bd268f369d"
msgid ""
"The ones below are kept starving and stupid<i>.</i> But not I - I know where "
"the real feast is."
msgstr "저 밑에 있는 놈들은 굶주린데다 멍청하지만, 난 아니야. 난 진짜 축제가 어디서 벌어지는 지 알지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 664d75a1-3ca4-c9f1-5155-680a5db1f654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:664d75a1-3ca4-c9f1-5155-680a5db1f654
msgctxt "h6ab175d0gaa5bg4da4g896dgc167abbcd708"
msgid "She had it - until She kept the <i>real </i>feast from us!"
msgstr "믿음은 충분히 바쳤다. <i>진짜</i> 축제를 앗아가기 전까진 말이지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 66cb3305-4bc9-6096-550c-3f02721f4ac3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:66cb3305-4bc9-6096-550c-3f02721f4ac3
msgctxt "h93e466b9gf13fg40ceg8bf5ge06c5337069f"
msgid "No! Get away!"
msgstr "안돼! 저리 가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = 6937f9cf-3add-43f7-8a8d-d745c6f014a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:6937f9cf-3add-43f7-8a8d-d745c6f014a7
msgctxt "ha97f6fcag7010g4f55ga968g0463eab6fdc2"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 6a06848a-af41-c853-0c93-324aac8330d9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:6a06848a-af41-c853-0c93-324aac8330d9
msgctxt "h50ec387dg99eeg4ff6ga0bfg7fefe8394f4b"
msgid "I've never eaten ghoul before. For you, I might make an exception."
msgstr "아직 구울을 먹어본 적은 없는데. 네가 처음이 될 수도 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = 71cc9056-87f0-2cbd-64a8-5acfd5d967ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:71cc9056-87f0-2cbd-64a8-5acfd5d967ad
msgctxt "h7f7d2f47gdfc8g43bcga947g10e216194714"
msgid "I honestly didn't know your kind could string a sentence together."
msgstr "구울이 제대로 된 문장을 구사할 줄도 알다니 정말 놀랍군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 7366ba69-ff98-fe51-d0e8-93dfbfe91ae2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:7366ba69-ff98-fe51-d0e8-93dfbfe91ae2
msgctxt "hde90421fgda93g48b8gbe4fg30ad8c92c1fa"
msgid "<i>Foot-flesh!</i>"
msgstr "<i>발-고기!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 843d81f8-fc80-fb8c-3b66-e3a845fb19ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_FlyingGhouls_Event_FlyAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:843d81f8-fc80-fb8c-3b66-e3a845fb19ea
msgctxt "h91e5ce32ge267g46bag8699gc34ba33d2b6e"
msgid "We will wait, True Soul. But only a little <i>longer</i>. Come!"
msgstr "기다리겠다, 참된 영혼이여. 아주 <i>조금만</i> 더 참아 보겠어. 가자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 8ce1eb73-4a85-60fc-26f0-5d5c75c69e7f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_FlyingGhouls_Knows_CorpsesBelow = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:8ce1eb73-4a85-60fc-26f0-5d5c75c69e7f
msgctxt "hcee585fagc006g4a8fga6f6g5a5e31c9e840"
msgid ""
"Scraps! The real feast is below. They drop corpses down into the tunnels - "
"enough to feed an army of us."
msgstr "찌꺼기잖아! 진짜 축제는 저 밑에 있다. 시체를 죄다 터널로 던져 버린단 말이지. 우리 전부가 먹고도 남을 양을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = 92643f05-c220-4cf3-943c-18b65550f8f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:92643f05-c220-4cf3-943c-18b65550f8f4
msgctxt "h1e9d0f14ga675g4cc1g8b57ga739c25cdbf5"
msgid ""
"If the Absolute will not share Her dead flesh... we will tear it from the "
"backs of the <i>living.</i>"
msgstr "절대자께서 시체 고기를 우리와 나누지 않는다면... 우리가 직접 <i>산 자</i>들을 덮칠 수밖에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = b64e68cb-fe78-4dda-9ae3-ee5824ace07b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:b64e68cb-fe78-4dda-9ae3-ee5824ace07b
msgctxt "he7a4a290g6890g4f40gaf9ag57a08cf316fb"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = b994e2d1-96bc-b9ba-d940-29440de58110
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:b994e2d1-96bc-b9ba-d940-29440de58110
msgctxt "h07d391dag4cd5g4bc6ga6b4g2da6cd88bef2"
msgid "The feet are mine!"
msgstr "이 발은 내 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = da500f2f-0db5-41a5-a2da-fbfa8316360d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:da500f2f-0db5-41a5-a2da-fbfa8316360d
msgctxt "hdb247a6bg3b5dg4bb5g91beg42608788b324"
msgid ""
"Your friends seem faithful enough. So they may start by feeding on <i>your</"
"i> flesh."
msgstr "네 친구들은 꽤나 신실해 보이는데. 이러다 <i>네가</i> 쟤네 먹이가 될 수도 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = db9c4fbb-b6ec-4d43-8148-6dd72e3e8a11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:db9c4fbb-b6ec-4d43-8148-6dd72e3e8a11
msgctxt "h150e0cebg94aag46a2g87cbg30ca4a107d59"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = e212100a-4906-44fc-80b3-f6fac0a04a46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:e212100a-4906-44fc-80b3-f6fac0a04a46
msgctxt "h906a394dg6f1eg4748gb2a6g3a2c1930a1ef"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = e47cbed2-45f0-4050-9d5a-a690afd3bd50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:e47cbed2-45f0-4050-9d5a-a690afd3bd50
msgctxt "h99321262g0a1dg45e9gbe2dge94401320dc3"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Winged Horror
#. NodeID = e60a74c0-43fb-0c75-4b04-4fc135a98b1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:e60a74c0-43fb-0c75-4b04-4fc135a98b1a
msgctxt "hf72130b7ga560g4e8cga904g435ffed13e19"
msgid "<i>Flesh! Flank-flesh!</i>"
msgstr "<i>고기! 냄새나는-고기!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = eb607977-7eed-4c99-9fdb-2d5e042b563e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:eb607977-7eed-4c99-9fdb-2d5e042b563e
msgctxt "h8bced5bag7f8bg4290g8237g89ce7db729d7"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Player
#. NodeID = efd5dd8d-0e2b-4cc9-cd2f-bdc9dc159220
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HasTaggedItem_FOOD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:efd5dd8d-0e2b-4cc9-cd2f-bdc9dc159220
msgctxt "h054431c6g88cag409fg9b6fg924e325b6134"
msgid "I have something in my pack, if you'd like?"
msgstr "가진 게 좀 있긴 한데, 이거라도 먹을래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul
#. Speaker = Narrator
#. NodeID = f42f1d81-5af9-47a9-a4cb-6b95c71bbd4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul:f42f1d81-5af9-47a9-a4cb-6b95c71bbd4c
msgctxt "h31a0b24fg761fg479cg9c70ged246092e896"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = 1290b771-ead2-4104-9ef0-093fc6cc472b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 375a6f59-375f-f5eb-5f42-60de2dc6aa6b_A = False
#. SetFlags:
#.   Local:
#.     - 375a6f59-375f-f5eb-5f42-60de2dc6aa6b_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:1290b771-ead2-4104-9ef0-093fc6cc472b
msgctxt "hb70ddb41g504eg4a0fgb732g619232830607"
msgid "Caat? Taake flesh from <i>caaat</i>?"
msgstr "고양이? <i>고양이</i>한테서 고기를 취하자고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = 2d55f325-37fe-43d2-ab25-98b30f20ae06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:2d55f325-37fe-43d2-ab25-98b30f20ae06
msgctxt "h324fc11egef76g4666gbba6g2119b62e555c"
msgid "But... it is all full of little <i>bones</i>."
msgstr "하지만... <i>잔뼈</i>가 너무 많단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = 695cb23f-87a8-4919-9f1a-57f3b8ce5a98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:695cb23f-87a8-4919-9f1a-57f3b8ce5a98
msgctxt "h1401ff18g843bg4a54gb736g4d1f5b927f3f"
msgid "Strange. <i>Foreign.</i>"
msgstr "이상해. <i>이질적이야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = 6c58b145-fec3-3ed2-2432-c46a321ee108
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:6c58b145-fec3-3ed2-2432-c46a321ee108
msgctxt "h22f13dc6g4795g42c9gb8f5gb263eafa25f5"
msgid "Yes, good crunch! And sooo salty, <i>too</i>."
msgstr "그래서 바삭하잖아! <i>덤으로</i> 짭짤하기도 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = 7c48c4a8-cd2d-4d4e-9c13-7a89e03ad92a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:7c48c4a8-cd2d-4d4e-9c13-7a89e03ad92a
msgctxt "h8251be17g789fg498bgacd3g9dbb0e804d55"
msgid "A great hunter. To be <i>feeaared</i>."
msgstr "위대한 사냥꾼이지. 아주 <i>공포스럽다니까</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = a4f9cf96-adaf-460f-92df-b92ca9c299b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 375a6f59-375f-f5eb-5f42-60de2dc6aa6b_A = False
#.     - 375a6f59-375f-f5eb-5f42-60de2dc6aa6b_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:a4f9cf96-adaf-460f-92df-b92ca9c299b3
msgctxt "hfe2677a4g5802g4441g8415g5741cc8c6bff"
msgid "Do you smell it, siblings? The meat below the tower?!"
msgstr "냄새가 나지 않나, 형제들이여? 타워 아래에서 풍기는 고기의 냄새가?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = ba6ab0fa-684a-4f66-9545-25e4407a8e8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:ba6ab0fa-684a-4f66-9545-25e4407a8e8b
msgctxt "h87eddfdcg652ag42fag8de4g6ef50940831f"
msgid "NO! Not again - my flesh still stings from her claws!"
msgstr "아니! 절대 안돼. 그 발톱에 당한 상처가 아직도 시리다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = c2fa7e32-097d-4c16-bf5f-9647b09cf1a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 375a6f59-375f-f5eb-5f42-60de2dc6aa6b_B = False
#. SetFlags:
#.   Local:
#.     - 375a6f59-375f-f5eb-5f42-60de2dc6aa6b_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:c2fa7e32-097d-4c16-bf5f-9647b09cf1a0
msgctxt "h200cf27agb430g41d8g90f0g032b8e1e4426"
msgid "Why foot-flesh?"
msgstr "왜 하필 발-고기야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = cd6cc56f-ac26-4e85-ad75-2c3fb4bf09b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:cd6cc56f-ac26-4e85-ad75-2c3fb4bf09b5
msgctxt "hc05445c0g4138g4291gb6deg939bf12ed93b"
msgid "<i>Hrnng, chewy.</i> <i>Best </i>flesh."
msgstr "<i>씹는 맛이 있어.</i> <i>최고의</i> 부위지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry
#. Speaker = Winged Horror
#. NodeID = fb1c0fd4-ad9e-4c11-8b32-ae49d30b2c8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_FlyingGhoul_AD_Hungry:fb1c0fd4-ad9e-4c11-8b32-ae49d30b2c8b
msgctxt "h257f08f8gafb1g4870gb402g8573a2d87f3d"
msgid "So <i>much</i>. And not all dead. It smells..."
msgstr "냄새가 <i>진동을 한다고</i>. 전부가 시체는 아니야. 냄새가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard01
#. Speaker = Acolyte Kimmeral
#. NodeID = d08d2f71-5012-47d4-97c3-15c82d14478e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_GuardRoom_HasMet_Guard01(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_GuardRoom_HasMet_Guard01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard01:d08d2f71-5012-47d4-97c3-15c82d14478e
msgctxt "h7a1694a1g0b5eg4ee6gbbf4gf25c75002f87"
msgid ""
"Don't mind Mig and her 'meat sounds'. It's just her brain slopping around in "
"her skull."
msgstr "미그가 말하는 '고기 소리'는 신경 쓰지마. 자기 뇌가 두개골 안에서 철벅거리는 소리니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard01
#. Speaker = Acolyte Kimmeral
#. NodeID = fc0cdca0-ec1c-4e17-bbf5-a29af9e9b671
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard01:fc0cdca0-ec1c-4e17-bbf5-a29af9e9b671
msgctxt "h11055bc8g9432g46a6gb691ge93a283d67d4"
msgid "Watch yourself with the ogre. She's a hugger."
msgstr "오거랑 같이 있을 땐 조심해. 포옹을 좋아하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard02
#. Speaker = Zealot Iogar
#. NodeID = 41500f9b-f707-5639-d0ee-ab96f818049a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard02:41500f9b-f707-5639-d0ee-ab96f818049a
msgctxt "h4b72554fg04f3g441ag83d9gfab946427f07"
msgid ""
"I know we're all one under the Absolute, but you do <i>not</i> want to bunk "
"with an ogre."
msgstr "우리 모두 절대자님의 아래에 하나이긴 하지만, 오거랑 같은 침대를 쓰고 싶은 건 <i>아니잖아</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard02
#. Speaker = Zealot Iogar
#. NodeID = b3cc557d-649e-4141-895f-541d1c1dbe12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_GuardRoom_HasMet_Guard02(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_GuardRoom_HasMet_Guard02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard02:b3cc557d-649e-4141-895f-541d1c1dbe12
msgctxt "h2f02eac5g6a1eg41deg9a0bgc9411d071466"
msgid "You'd find better lodgings out in the war camp, True Soul."
msgstr "주둔지에선 더 나은 숙소를 찾을 수 있을 거야, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard02
#. Speaker = Zealot Iogar
#. NodeID = c399cea6-57d6-4be7-8a4d-7abeea547414
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_GuardRoom_Guard02:c399cea6-57d6-4be7-8a4d-7abeea547414
msgctxt "h8a61fcc9g17c9g4faagb9fag48d4743c8b29"
msgid ""
"Better to bunk with a beast than do battle with one, I suppose. Praise the "
"Absolute."
msgstr "짐승과 싸우는 것보단 같은 침대에서 자는 게 더 낫겠지, 아마. 절대자님을 찬양하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker
#. Speaker = Player
#. NodeID = cc27e82a-c421-4856-8f0c-c480c94380ac
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker:cc27e82a-c421-4856-8f0c-c480c94380ac
msgctxt "hdad87170g1709g4110g9722gf2074d5f5731"
msgid ""
"Interesting map. Especially that nice, big X at the base of Moonrise Towers."
msgstr "흥미로운 지도로군. 특히 문라이즈 타워 지하에 큼지막한 X 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker
#. Speaker = Player
#. NodeID = cc27e82a-c421-4856-8f0c-c480c94380ac
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker:cc27e82a-c421-4856-8f0c-c480c94380ac
msgctxt "he9efbd65g73abg4d0bg8c17g63708e4d6ac4"
msgid "Looks like this marks the base of Moonrise Towers."
msgstr "보아하니 문라이즈 타워에 표시가 돼 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker
#. Speaker = Player
#. NodeID = cc27e82a-c421-4856-8f0c-c480c94380ac
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker:cc27e82a-c421-4856-8f0c-c480c94380ac
msgctxt "hcd400a02g5f11g4836g8919g146db6cd56ae"
msgid "A red 'x'. I know what that means."
msgstr "빨간 'X'. 난 이게 뭔 뜻인지 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker
#. Speaker = Player
#. NodeID = cc27e82a-c421-4856-8f0c-c480c94380ac
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker:cc27e82a-c421-4856-8f0c-c480c94380ac
msgctxt "h7f39d61bga3ffg48e3gb540gad5e5467321f"
msgid "How quaint - a treasure map. The base of Moonrise is marked."
msgstr "기묘하군 - 보물 지도야. 문라이즈 지하에 표시돼있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker
#. Speaker = Player
#. NodeID = cc27e82a-c421-4856-8f0c-c480c94380ac
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker:cc27e82a-c421-4856-8f0c-c480c94380ac
msgctxt "hc04e7af4ga224g43b3g8d50g536f03aedeae"
msgid "Someone marked a spot here - right at the base of Moonrise Towers."
msgstr "누가 여기 표시를 해놨어 - 바로 문라이즈 타워 지하에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker
#. Speaker = Player
#. NodeID = cc27e82a-c421-4856-8f0c-c480c94380ac
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker:cc27e82a-c421-4856-8f0c-c480c94380ac
msgctxt "h1a2a4489gcb37g48c5g89b9g13793082b19a"
msgid "X marks the spot. Destination: the base of Moonrise Towers."
msgstr "X 가 쳐져 있군. 목적지, 문라이즈 타워 지하."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker
#. Speaker = Player
#. NodeID = cc27e82a-c421-4856-8f0c-c480c94380ac
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_MapMarker:cc27e82a-c421-4856-8f0c-c480c94380ac
msgctxt "h0beadddfgfcc5g4621gaa71g455e54028487"
msgid "Someone's marked a spot at the base of Moonrise Towers. Worth a look."
msgstr "누가 문라이즈 타워 지하에 표시해놨군. 살펴봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered
#. Speaker = Player
#. NodeID = 77c20839-ced1-4a3d-9c45-569f7968eefe
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered:77c20839-ced1-4a3d-9c45-569f7968eefe
msgctxt "hb7afcdadg8f4ag4e29gb9d6gae2b600daa00"
msgid "This looks familiar. Is it the spot marked on that map?"
msgstr "익숙해 보이는데. 이게 그 지도에 표시된 장소인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered
#. Speaker = Player
#. NodeID = 77c20839-ced1-4a3d-9c45-569f7968eefe
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered:77c20839-ced1-4a3d-9c45-569f7968eefe
msgctxt "h5f5fa88bg6fbeg4f92gb36ag6c08028fe800"
msgid "Hmm... that map had marked this spot."
msgstr "흠... 지도엔 여기가 표시되어 있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered
#. Speaker = Player
#. NodeID = 77c20839-ced1-4a3d-9c45-569f7968eefe
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered:77c20839-ced1-4a3d-9c45-569f7968eefe
msgctxt "h8a323ddegcbffg4ba3g896cgd1dede054ab9"
msgid "Didn't we see a red 'x' right here? On that map?"
msgstr "여기에 빨간 'X' 있지 않았어? 그 지도에?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered
#. Speaker = Player
#. NodeID = 77c20839-ced1-4a3d-9c45-569f7968eefe
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered:77c20839-ced1-4a3d-9c45-569f7968eefe
msgctxt "h7fc18e63g94d0g4c77g9e0dg79a0d7759e1a"
msgid "That map marked this very spot. I should scan the area."
msgstr "그 지도는 바로 이곳을 표시했어. 이 장소를 살펴봐야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered
#. Speaker = Player
#. NodeID = 77c20839-ced1-4a3d-9c45-569f7968eefe
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered:77c20839-ced1-4a3d-9c45-569f7968eefe
msgctxt "h648a5415g9bb8g4ff9g9661g5506de899812"
msgid "This is the spot that was marked on that map before."
msgstr "여기가 그 지도 위에 표시된 장소야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered
#. Speaker = Player
#. NodeID = 77c20839-ced1-4a3d-9c45-569f7968eefe
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered:77c20839-ced1-4a3d-9c45-569f7968eefe
msgctxt "hecdb5798g5d87g49e1gaf5dg44233d4b3fbd"
msgid ""
"The treasure map pointed to this spot. I should keep my good eye peeled."
msgstr "보물 지도는 이곳을 가리키는군. 눈을 부릅뜨고 있어야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered
#. Speaker = Player
#. NodeID = 77c20839-ced1-4a3d-9c45-569f7968eefe
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_HiddenTreasure_PAD_TreasureDiscovered:77c20839-ced1-4a3d-9c45-569f7968eefe
msgctxt "h4047d92eg07feg4875gb3dfg72555fc9e34a"
msgid "This is the spot that's marked on that map."
msgstr "여기가 그 지도 위에 표시된 장소야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 03bcfff2-15f1-4bd6-88c5-e8f0b89817e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_HasMet_Vendor(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:03bcfff2-15f1-4bd6-88c5-e8f0b89817e9
msgctxt "h9e225c1bg5cf7g4305gb017g62c673d5b132"
msgid "Welcome back, True Soul."
msgstr "돌아왔구나, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 076d9afc-e4fc-a77c-211e-d9a2230ddcac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:076d9afc-e4fc-a77c-211e-d9a2230ddcac
msgctxt "h81670a5eg9d76g43f8g857dg61f01159862c"
msgid "Not to your taste?"
msgstr "입에 안 맞아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 0debdaf9-07a1-139c-528b-32ae2f93e22b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:0debdaf9-07a1-139c-528b-32ae2f93e22b
msgctxt "h600de7d5g483bg4906g8955gf64e97b6f714"
msgid "You <i>want </i>to be bitten?"
msgstr "물리고 <i>싶다</i>고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 0eae3e99-a06a-fd0d-62b2-70837791f1f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:0eae3e99-a06a-fd0d-62b2-70837791f1f1
msgctxt "h9a44a089g1a71g4649ga26dgc6b1c0f8c4a7"
msgid "I'm not certain I'll have time."
msgstr "시간이 될지 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 0efea75d-0a64-b0ea-313f-b59e41fff1e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:0efea75d-0a64-b0ea-313f-b59e41fff1e9
msgctxt "h5dff1a25gbd64g40d3gbfbcg318e776dbda0"
msgid "I hope you find it as satisfying as I found this."
msgstr "나만큼 너도 만족했으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 100c3ad5-ec38-72da-1453-6c7b7ca384c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_State_AskedAboutName(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:100c3ad5-ec38-72da-1453-6c7b7ca384c8
msgctxt "h9910a051gfa05g4531g9fa8ga151c40d4e2d"
msgid "Thankfully, I wasn't in it at the time."
msgstr "다행히도, 난 그때 거기 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 10fa1ca0-6ac1-7f65-4e22-679fdcb9291b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:10fa1ca0-6ac1-7f65-4e22-679fdcb9291b
msgctxt "h006b3faagb577g481ag993bge0206f949965"
msgid "YHURGH!"
msgstr "으악!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 12f03065-7344-a3e3-4b2b-0a7c30a75459
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:12f03065-7344-a3e3-4b2b-0a7c30a75459
msgctxt "hef46ad6eg248dg4463g88f1g91d8e4645928"
msgid "What kind of proposal?"
msgstr "무슨 볼일인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 14225ce3-4b02-ea60-24b8-ac3a19ec8349
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:14225ce3-4b02-ea60-24b8-ac3a19ec8349
msgctxt "h5412e629g6b7eg4326g8c59g6d010e2bbb25"
msgid ""
"'Many hearts, one soul' - isn't that how the blessing goes? We are all one "
"under the Absolute."
msgstr "'수많은 마음, 하나의 영혼', 그게 축복이 말하는 바 아니겠어? 우린 절대자님 아래에서 다 똑같다구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 14d8c948-3044-565f-070c-9eb27c193026
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:14d8c948-3044-565f-070c-9eb27c193026
msgctxt "h6bb314dfg51a6g48f9g9ad6g141396bfb4cc"
msgid "Do you have a name, spawn?"
msgstr "이름이 있어, 스폰?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 169c1c4b-15c2-8177-dcdf-d33cd61723e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:169c1c4b-15c2-8177-dcdf-d33cd61723e0
msgctxt "h4f5e58b0ge78ag4bbfg824agfa29a189e1d6"
msgid "Incredible. Incredible!"
msgstr "믿을 수 없어. 너무 대단해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 1a313c58-0794-0b0b-2fbd-42615c287c71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:1a313c58-0794-0b0b-2fbd-42615c287c71
msgctxt "h39bcb1b1g4590g4aabga8ddga86656092d89"
msgid "Speak to me again if you'd like to hear more. I'll be waiting."
msgstr "더 들어볼 생각 있으면 다시 말해줘. 기다릴게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 1b394fbc-4a8b-40c9-9758-7e36e40be807
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_HasMet_Vendor(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:1b394fbc-4a8b-40c9-9758-7e36e40be807
msgctxt "h9e1dedbbg6888g49bcg90a3g070cfcbe9316"
msgid "I just want to see your normal stock for now."
msgstr "그냥 일반적인 물품이 보고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 1b56687a-4e93-e4c4-1863-de7318c105b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:1b56687a-4e93-e4c4-1863-de7318c105b3
msgctxt "h2da16324g2cfcg432bg942cgb0f9639c3e7f"
msgid "You aren't working for Cazador, are you?"
msgstr "너 카사도어의 부하는 아니지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 1d3954ba-fb38-8344-5ab3-3ff68ef8ed6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:1d3954ba-fb38-8344-5ab3-3ff68ef8ed6d
msgctxt "h7a32813ag2231g4164gb26bgb22803f1a0e4"
msgid "Well - it'll certainly do <i>something</i>, my most noble vindicator."
msgstr "글쎄. 확실한 건 <i>뭔가</i> 일어나긴 할 거라는 거야. 고귀한 수호자여. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 1e96c54f-f813-2088-a9e8-bc7b6fd05ace
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:1e96c54f-f813-2088-a9e8-bc7b6fd05ace
msgctxt "h1e4b20c4g905eg4dcaga487g8353a67abec0"
msgid ""
"Now, now. A True Soul ought to know their doctrine. I've picked a little up "
"in my time here."
msgstr "자, 자. 참된 영혼이면 교리정도는 알아야지. 내가 여기 있으면서 조금 배웠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 1fc012e9-0098-e288-484b-15b060914a03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:1fc012e9-0098-e288-484b-15b060914a03
msgctxt "hde6f7f62g7d5fg4667gb0b0g90c4861a487c"
msgid ""
"'Unnatural' - are we not all one under the Absolute, True Soul? Surely "
"there's <i>nothing</i> more natural than sharing our resources."
msgstr ""
"'비정상적'이라, 우리 모두 절대자님의 아래에서 평등한 것 아니었나, 참된 영혼? 분명 서로 가진 것을 공유하는 것 만큼 자연스러운 건 "
"<i>없다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 209f8970-5b32-741e-0698-5d5c5d15fe6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_State_OfferedBribe = True
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_Event_ReceiveGold(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:209f8970-5b32-741e-0698-5d5c5d15fe6e
msgctxt "hea2cfc53g1b78g428dga57bg68f93158ffb5"
msgid "A little pain for a lot of gold. And..."
msgstr "금화 더미를 위한 작은 고통이야. 그리고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 295bc7da-e3c6-273e-df83-0f119f721601
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:295bc7da-e3c6-273e-df83-0f119f721601
msgctxt "h7d0bc147gf9eeg4ab2gad77gc8d4fc5f24cc"
msgid "<i>Bite her.</i>"
msgstr "<i>문다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 2abc6bed-2551-771c-841a-1d856356cff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:2abc6bed-2551-771c-841a-1d856356cff1
msgctxt "h5435b284gf15fg461bg8714gd13ea2e480bb"
msgid ""
"Oh? I'm afraid I have quite enough for my purposes - from you, at least."
msgstr "오? 이미 내 목적은 충분히 달성했는데 어쩌지, 적어도 너한테서는 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 309c7d69-4b89-aec8-e9ed-1302a5cde2ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:309c7d69-4b89-aec8-e9ed-1302a5cde2ee
msgctxt "h9fcf565dgc3d4g43f4g9eedge450927d995a"
msgid "Oh I'd prefer if you did."
msgstr "아 난 물어줬으면 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 3200b970-e4bd-c010-1d2f-f038613de15d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:3200b970-e4bd-c010-1d2f-f038613de15d
msgctxt "h1c8cdf01g30d2g4e20gbe7bge54a963bdba4"
msgid ""
"Rest and return. I'll feel better buying your blood when I know you can "
"actually <i>spare</i> it."
msgstr "쉬고나서 다시 와. 네가 진짜로 피를 <i>나눠</i>줄 수 있을 때 사는 게 더 나을 것 같으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 36768f78-1901-efde-1140-aae5f07a02d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_Knows_Identity = True
#.   Object:
#.      - MOO_InfernalVendor_HasMet_Vendor(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:36768f78-1901-efde-1140-aae5f07a02d0
msgctxt "hfd5bc395gd7bcg4ce5g9b62g3b61db14d386"
msgid "Welcome back, True Soul! You've come in the spirit of trade, I hope?"
msgstr "돌아왔구나, 참된 영혼. 거래하려고 온 거, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 3aaf65b6-099f-9993-9938-5637ce6576ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Astarion = True
#.      - MOO_BloodMerchant_State_BloodMerchantAskedAstarionToBiteHer = False
#.      - MOO_BloodMerchant_State_GaveAstarionQuest = False
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_State_SoldBlood(1) = True
#.     - MOO_InfernalVendor_State_ConsentedLowHealth(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:3aaf65b6-099f-9993-9938-5637ce6576ab
msgctxt "hd00642cag4a4bg4b6eg85b8g79768d2b3294"
msgid "There we are. All of your very best traits in a bottle. Use it well!"
msgstr "됐다. 정말 최고의 특성들을 담은 병이야. 잘 써!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 3b557580-6e97-c112-7698-68a5d0ae0f70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:3b557580-6e97-c112-7698-68a5d0ae0f70
msgctxt "ha154de5ag2bd0g41b5g8d9agba4215d371e2"
msgid "What kind of potion can you make?"
msgstr "어떤 물약을 만들 수 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 3cb86e41-f4a9-a04d-ac89-786f77001631
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_InfernalVendor_State_AskedAboutDeals = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:3cb86e41-f4a9-a04d-ac89-786f77001631
msgctxt "h5ff9f826g295fg43c3g9d6dg7c6d562890e2"
msgid ""
"With one drop, I can brew a rather potent potion for you. The rest, I keep "
"for myself."
msgstr "한 방울이면, 엄청 강한 물약을 만들어 줄 수 있거든. 나머지는, 내가 가지고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 3ea17812-e62a-7b35-0e62-7896776c3220
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_State_OfferedBribe = False
#.      - MOO_InfernalVendor_Knows_Identity = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:3ea17812-e62a-7b35-0e62-7896776c3220
msgctxt "h03760b34gc756g4f6agb291g2db9cf02987d"
msgid "It's not 'True Soul' blood you want. It's illithid-tainted blood."
msgstr "네가 원하는 건 '참된 영혼'의 피가 아니야. 일리시드에 오염된 피지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 401ce2c2-ce74-3a70-a4b7-e8e004a9cb89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:401ce2c2-ce74-3a70-a4b7-e8e004a9cb89
msgctxt "hd59e5fd1gbce7g4adfg85d7g2f43a64d7866"
msgid "It's not for sale, but it's yours if you bite me."
msgstr "이건 파는 게 아니야, 근데 네가 날 물어주면 네 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 416202d2-4d81-c300-c719-c81406960910
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:416202d2-4d81-c300-c719-c81406960910
msgctxt "h65af2fcbg2861g4ec2g9392g650e825567a9"
msgid "I gave you my answer."
msgstr "방금 대답했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 41a3c1c7-6d7a-e57e-2b3e-de05051586ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:41a3c1c7-6d7a-e57e-2b3e-de05051586ba
msgctxt "hf360ec9ag68f4g4f78g8edagbbf57467968a"
msgid "All right. Let's do it."
msgstr "좋아. 해보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 42837600-00ba-ab40-9bc7-108ca88a2106
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_State_HasEnoughHealth(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:42837600-00ba-ab40-9bc7-108ca88a2106
msgctxt "h377823d4g3e6eg454fg8dbagb0b7220a8795"
msgid "Just a little prick and it's all over. Close your eyes."
msgstr "살짝만 찌르고 끝낼거야. 눈 감아봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 45bf31e6-493e-b339-a0a3-5981117679fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_BloodMerchant_State_AstarionAvatarRefusedToBite(1) = True
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:45bf31e6-493e-b339-a0a3-5981117679fb
msgctxt "h5eff92adg4003g4c99gaef0g072cb6a234aa"
msgid "I've changed my mind - I will bite you."
msgstr "맘이 바뀌었어, 널 물어주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 4e034082-e218-b26b-bd4b-d8688ad7a304
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:4e034082-e218-b26b-bd4b-d8688ad7a304
msgctxt "he0c2c82bg63bag4784ga8edg1aa51bb7419d"
msgid ""
"And if I may - would you have a moment to discuss another more <i>personal</"
"i> matter."
msgstr "괜찮으면, 다른 <i>개인적인</i> 문제에 대해 이야기하고 싶은데 시간 괜찮을까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 4f9497c7-daf7-d8f4-c90f-d0908facc7b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_State_AskedAboutName(1) = False
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:4f9497c7-daf7-d8f4-c90f-d0908facc7b5
msgctxt "hc62fe4c7g8dcfg4664gb34bg2d14a797e273"
msgid "Oblodra? That House was destroyed a century ago."
msgstr "오블로드라? 그 가문은 100년전에 사라졌을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 5015300e-f21e-d056-d982-f90985a30c99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5015300e-f21e-d056-d982-f90985a30c99
msgctxt "h4b836b6cg70aag4841g8418gd4b52d727512"
msgid "Should you be interested, I have a particular offer I'd like to make."
msgstr "관심만 있다면 말이야, 특별한 제안을 하고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Narrator
#. NodeID = 5056023e-1d68-b0aa-38fe-8c275504757b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5056023e-1d68-b0aa-38fe-8c275504757b
msgctxt "h7ee5b7f3gbd54g4b68g8277gb57bbc0861c8"
msgid ""
"*Realisation washes over you. Every drow knows of the purge of House Oblodra "
"- but you remember the whispers of <i>why</i>.*"
msgstr ""
"*깨달음이 스쳐지나갑니다. 모든 드로우들은 오블로드라 가문의 숙청에 대해 알고 있습니다, 하지만 그 <i>이유</i>에 대해선 희미한 "
"기억만 남아있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Narrator
#. NodeID = 50e95eb5-3a59-2bb5-4f26-c1dd87a1ffae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_InfernalVendor_Knows_Identity = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:50e95eb5-3a59-2bb5-4f26-c1dd87a1ffae
msgctxt "h1e857c5fg9b45g4b27gb155g4878839f1321"
msgid ""
"*Among the many crimes tallied against them - their reckless experimentation "
"with illithid breeding-stock.*"
msgstr "*그 가문이 행한 수많은 죄들 중에는, 일리시드 종축장을 만들어 무모한 실험을 했다는 것도 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 517e632b-d151-cc51-c15c-6d636032c95a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:517e632b-d151-cc51-c15c-6d636032c95a
msgctxt "h6f0bda29g8823g4e17ga1d5ge8ceef27a517"
msgid ""
"No one <i>gave</i> it to me. Rather ironically, it runs in the bloodline. We "
"Oblodras are naturally curious folk. Always have been."
msgstr ""
"누가 <i>준 게</i>아니야. 좀 역설적이긴 한데, 혈통계승이라는 거지. 우리 오블로드라들은 원래부터 별난 사람들이었어. 언제나 그랬지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 53ea0e0a-ba8b-d5d5-4d5d-4d9d47c504c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:53ea0e0a-ba8b-d5d5-4d5d-4d9d47c504c2
msgctxt "h0f2e8b54g93afg470ag9ed0gfe6eab4cad26"
msgid ""
"Very well, if that's your answer. But you know where to find me if you "
"change your mind."
msgstr "그렇다면 알았어. 마음이 바뀌면 난 여기 있을 테니 날 다시 찾아와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 55cbe44d-fae3-c178-b3c3-c9370223093d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:55cbe44d-fae3-c178-b3c3-c9370223093d
msgctxt "h7902203cgfa9bg461fg8fbfg2d23213db389"
msgid "Very well. If there's anything else you need, let me know."
msgstr "잘 알겠어. 다른 거 필요한 것 있으면, 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 55ffca65-4843-d742-2afb-e78c22fd7fca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:55ffca65-4843-d742-2afb-e78c22fd7fca
msgctxt "h0d11de3cgd8b5g4257gb39fg68a2375d6de0"
msgid "I- I must prepare myself for his arrival..."
msgstr "그, 그럼 준비를 좀 해야겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 5cc912d5-662e-9486-6945-8f442f42e4be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5cc912d5-662e-9486-6945-8f442f42e4be
msgctxt "h7e880f58g7473g45cfg9907g8770894638aa"
msgid ""
"To feel your life's blood slipping away? To dance on the edge between life "
"and death? Yes, I want it."
msgstr "생명의 피가 빠져나가는 걸 느끼고 싶냐고? 삶과 죽음의 경계에서 춤추고 싶냐고? 그래, 그러고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 5cf474f4-f5dd-d425-9081-8e90a98ef5e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5cf474f4-f5dd-d425-9081-8e90a98ef5e7
msgctxt "h1720e490g24f0g4844ga1d4g256e9373d094"
msgid "You're <i>really</i> a vampire? At least one of their spawn..."
msgstr "<i>진짜</i> 뱀파이어 맞지? 적어도 뱀파이어 스폰이기라도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 5e169722-a8b1-20db-1248-140b31054b88
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BloodMerchant_State_AstarionAvatarRefusedToBite(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5e169722-a8b1-20db-1248-140b31054b88
msgctxt "h75cea249g85a2g4bb5gaa07g2d8248ec0cf6"
msgid "Absolutely not."
msgstr "절대 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 5e979171-65ce-cac5-c282-911b0e9e4eea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_HasMet_Vendor(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5e979171-65ce-cac5-c282-911b0e9e4eea
msgctxt "h2b85f44fgf5fdg482dga4d0gefe902c5c980"
msgid "Show me your stock."
msgstr "갖고 있는 걸 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 5ee6e9dd-a60b-69f6-e7e9-c029b7a76bc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5ee6e9dd-a60b-69f6-e7e9-c029b7a76bc8
msgctxt "h8d12ac25g8d19g4997g9cd2gd56457d50cb8"
msgid ""
"That is not a name which has ever passed my lips. I am a friend to you, I "
"wish to be a friend to him."
msgstr "한번도 내 입에서 나온 적 없는 이름이네. 난 네 친구고, 그의 친구가 되고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 5f94f456-2f1a-db25-346f-ba804092f8be
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_InfernalVendor_State_OfferedBribe = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:5f94f456-2f1a-db25-346f-ba804092f8be
msgctxt "hf2751075ga12cg4adeg96edg5711ea1e6ef3"
msgid ""
"So let me adjust my offer. Your blood and your <i>silence</i> in exchange "
"for the potions I mention - and<i> </i>a tidy pile of gold besides."
msgstr ""
"그럼 내 제안을 수정해보지. 네 피와 네 <i>침묵</i>을 대가로 내가 말했던 물약과, <i> </i>상당한 금화더미도 같이 주도록 "
"하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 625e8e44-7eee-b4cc-d8bf-ad947f6ebe21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:625e8e44-7eee-b4cc-d8bf-ad947f6ebe21
msgctxt "h46b1d2e9g7be7g4b6cgb4eeg0e7bcea019e2"
msgid ""
"To feel your life's blood slipping away? To dance on the edge between life "
"and death? Yes, I want it."
msgstr "생명의 피가 빠져나가는 걸 느끼고 싶냐고? 삶과 죽음의 경계에서 춤추고 싶냐고? 그래, 그러고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 6b1e2ae1-6b2c-b068-1842-a70d04f6a679
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_State_SoldBlood(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:6b1e2ae1-6b2c-b068-1842-a70d04f6a679
msgctxt "h87f5132fg3a4dg49a2gb166g2bf319fe7ea8"
msgid "I want to trade my blood for a potion."
msgstr "내 피를 물약이랑 거래하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 6be9ce53-6627-e29e-d0ca-8021ee6e6535
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:6be9ce53-6627-e29e-d0ca-8021ee6e6535
msgctxt "h04a4698bg668ag4128ga023g9239db5b6aa8"
msgid "We can learn exactly what that means together, hm?"
msgstr "약효가 무엇이 될 지는 우리 함께 알아보는 거야, 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Narrator
#. NodeID = 6dd25f1e-1060-a38f-3c1e-d90522d72291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:6dd25f1e-1060-a38f-3c1e-d90522d72291
msgctxt "h14278734g5ecag4974g9b13g95de05afe980"
msgid ""
"*You realise why the name rings familiar: House Oblodra was purged a century "
"ago by an alliance of rival drow houses.*"
msgstr "*그 이름이 익숙한 이유를 깨닫습니다.백년 전 경쟁자였던 드로우 가문들의 연합이 오블로드라 가문을 숙청했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 7091ce30-44d0-7ebc-4a5f-53c81aeb107c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:7091ce30-44d0-7ebc-4a5f-53c81aeb107c
msgctxt "hbccc9736g50b6g469dg90bag578614e28dc5"
msgid ""
"...'Blessed' by the Absolute, but not blinded by it? Now I simply <i>must</"
"i> study you."
msgstr "...'축복'은 받았지만, 눈까지 멀진 않았다? 이제 진짜로 널 연구<i>해봐야</i> 겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Narrator
#. NodeID = 71b109c8-b77b-1b1a-b2a8-d9651e42f230
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:71b109c8-b77b-1b1a-b2a8-d9651e42f230
msgctxt "he8e5e49cg9118g447bga738g484ddd321469"
msgid ""
"*As her blood seeps between your lips, you realise something's off. Her "
"blood is rancid, tainted by unnatural experiments.*"
msgstr ""
"*그녀의 피가 당신의 입술에 스밉니다, 뭔가 이상하다는 걸 느낍니다. 그녀의 피는 비정상적인 실험으로 오염되어 썩은 내가 납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 767cfff6-831d-570f-ff5f-5725b2d59290
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:767cfff6-831d-570f-ff5f-5725b2d59290
msgctxt "hc2516d66g6f2ag4056gbebcg791a5904d05f"
msgid "I know you travel with a delightful night-walker in your retinue."
msgstr "밤에 돌아다니는 유쾌한 동료와 함께 여행하고 있다는 걸 알고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 788b43d4-01c9-f96c-8216-bed65f750ca2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_State_HasEnoughHealth(1) = False
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_State_ConsentedLowHealth(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:788b43d4-01c9-f96c-8216-bed65f750ca2
msgctxt "h4318699agd277g4fe6g972ag4079e29c3892"
msgid "Ah, well... if you don't mind me saying, you don't look entirely well."
msgstr "어, 음... 한마디 하자면, 너 지금 엄청 안 좋아 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 78df659f-eb86-d7f0-2911-c246936777f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:78df659f-eb86-d7f0-2911-c246936777f3
msgctxt "he330b7dbg4a48g46b0gb908gb2a783be0626"
msgid ""
"Good. Now, Astarion, I've dreamt of being bitten by a vampire since I was a "
"young girl."
msgstr "좋아. 그럼, 아스타리온, 난 어릴 때부터 뱀파이어한테 물리는 게 꿈이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 847fff19-7fa6-899f-c548-79c78936c6a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:847fff19-7fa6-899f-c548-79c78936c6a7
msgctxt "he0377150gbd19g4b48ga9c9gf058c9e545c8"
msgid ""
"Excuse me? This is a once-in-a-lifetime opportunity and you're squandering "
"it."
msgstr "뭐라고? 이건 일생일대의 기회인데 넌 그걸 놓치는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 88c00c79-5739-a438-89b7-88127e27c213
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:88c00c79-5739-a438-89b7-88127e27c213
msgctxt "h1f5ee789g83f3g4a86gbe2egb73e90f726de"
msgid ""
"My cousins did like to boast about their view over the Clawrift. Now their "
"bones decorate the bottom."
msgstr "내 사촌들은 클로리프트 너머의 풍경을 자랑하곤 했지. 지금은 사촌들의 뼈가 바닥을 장식하고 있지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 89069974-3e65-9bae-e8ea-934ce892ee3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_State_OfferedBribe = True
#. SetFlags:
#.   Global:
#.     - MOO_InfernalVendor_State_Rejected = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:89069974-3e65-9bae-e8ea-934ce892ee3e
msgctxt "h0226e5e9g14ccg4ac8gbd49g89666615fb3c"
msgid "Keep your gold. I want to see what the cult does to non-believers."
msgstr "금화는 넣어둬. 교단이 불신자를 어떻게 대우하는지 보고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 8c3ac15c-4fd8-3b71-c7ee-f136a4e77bd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - OOM(0) = True
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:8c3ac15c-4fd8-3b71-c7ee-f136a4e77bd0
msgctxt "h111dd485g2ee0g40d0g9b75gdf472e1a7433"
msgid ""
"Araj Oblodra, trader in blood and the sanguineous arts. But you, True Soul..."
msgstr "아라즈 오블로드라, 피와 핏빛예술 상인이야. 근데 넌, 참된 영혼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 8d6ef901-b296-a9b4-05a7-266fa2a56a99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:8d6ef901-b296-a9b4-05a7-266fa2a56a99
msgctxt "hf55b72e3g5d65g438cgb035g126025ace33e"
msgid ""
"Goodness, no. Nothing so <i>unsanitary</i>. The Oblodras clan practise their "
"own form of blood alchemy."
msgstr "맙소사, 아니야. 그런 <i>불결한</i>게 아니야. 오블로드라 일족들은 고유의 피 연금술을 행한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 8fabe897-9477-ee63-1374-9623316d23b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:8fabe897-9477-ee63-1374-9623316d23b6
msgctxt "h5a06851cg4bd8g4721gbe4fg96e17427cfd1"
msgid ""
"If you know of any other True Souls willing to aid my research, though, do "
"send them my way."
msgstr "그래도 내 연구를 도와줄 다른 참된 영혼을 알고 있으면, 나한테 보내주면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 9123d581-726e-65af-6155-29bd8df23c9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:9123d581-726e-65af-6155-29bd8df23c9e
msgctxt "ha8e19107ge574g46d7g813bgf1b564d15589"
msgid "Research, naturally. We Oblodras are simply curious by nature."
msgstr "당연히 연구지. 우리 오블로드라들은 선천적으로 호기심이 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 92c6ba20-bd70-1c71-5cb5-fee5866f2c61
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:92c6ba20-bd70-1c71-5cb5-fee5866f2c61
msgctxt "h350c4feag89dcg4fbeg876cga94c774be8ab"
msgid "I will have to decline."
msgstr "거절해야겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 94602823-79fa-c717-f4a0-81cbe4012310
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_ANCIENTS(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:94602823-79fa-c717-f4a0-81cbe4012310
msgctxt "h5cc3fe95g9c2cg4203gab8fg2a8de5d271fb"
msgid "Blood rituals? Unnatural heresy. I will not."
msgstr "피의 의식? 비정상적인 이단이로군. 하지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 996affa2-f10e-3033-239e-0f9785723695
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_BloodMerchant_State_BloodMerchantAskedAstarionToBiteHer = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:996affa2-f10e-3033-239e-0f9785723695
msgctxt "hcf274fa8gb2e7g464bg82d2ge50929ebba9d"
msgid ""
"Ever since I was a young girl I have dreamt of being bitten by a vampire."
msgstr "어릴 때부터 난 뱀파이어한테 물리는 게 꿈이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = 9dfee670-9f5f-5d62-ddcf-858d196e2a7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_InfernalVendor_HasMet_Vendor(1) = False
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_HasMet_Vendor(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:9dfee670-9f5f-5d62-ddcf-858d196e2a7c
msgctxt "h2b62dce8g151ag43f4gb15agaf24d46161e7"
msgid ""
"Araj Oblodra, trader in all things occult. A very great pleasure to meet "
"you, True Soul."
msgstr "아라즈 오블로드라, 온갖 초자연적인 것들의 상인이야. 정말로 만나서 반가워, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = 9f6c580f-9223-cda6-ef59-453a446dc3e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_State_AskedAboutDeals = True
#.   Object:
#.      - MOO_InfernalVendor_State_AskedAboutBloodDeals(1) = True
#.      - MOO_InfernalVendor_State_SoldBlood(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:9f6c580f-9223-cda6-ef59-453a446dc3e7
msgctxt "hc4ebb965g0eecg4c5fg9814gb1126f3baf0d"
msgid "I want to trade my blood for a potion."
msgstr "내 피를 물약이랑 거래하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = a3136fb0-309d-c1ab-3d9f-583d936a6fb9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_HasMet_Vendor(1) = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:a3136fb0-309d-c1ab-3d9f-583d936a6fb9
msgctxt "h39e2762fg2cfag483fgb796gfea76a22fff5"
msgid "Don't worry, we're all friends under the Absolute. I won't bite."
msgstr "걱정마, 절대자님 아래서 우린 모두 친구니까. 물지 않을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = a7652bed-a53f-f8b5-c92a-3f26b0c882f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_Knows_Identity = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:a7652bed-a53f-f8b5-c92a-3f26b0c882f0
msgctxt "h7877ff77g1e99g4114gbd23g8553a5423728"
msgid "This is blasphemy. My blood is sacred."
msgstr "신성모독이다. 내 피는 신성하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = a7bf6eac-1711-999f-8a25-6f3c17fd33d6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:a7bf6eac-1711-999f-8a25-6f3c17fd33d6
msgctxt "h327d38d5g9549g4b62g8fa6g351ccf02896a"
msgid "I'm sorry? You want to be bitten?"
msgstr "뭐? 물리고 싶다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = a9d293d5-b2d2-7a4b-5e93-5d563cde9026
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:a9d293d5-b2d2-7a4b-5e93-5d563cde9026
msgctxt "h87fd8a8bgbcf3g4560gb518g5e953f01f0c4"
msgid ""
"It was everything I imagined. And then more. I'll be able to put this to "
"good use."
msgstr "내가 상상하던 것 이상이었어. 잘 쓸 수 있을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = a9e138f8-3347-27e7-d042-4d1e438f49b1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:a9e138f8-3347-27e7-d042-4d1e438f49b1
msgctxt "hbc798c8cgc13fg4f29gb465g469ad44876c2"
msgid "Astarion, but hold on-"
msgstr "아스타리온, 근데 잠깐만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = abe01ff2-55fc-49b4-3327-cfd32611ce74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:abe01ff2-55fc-49b4-3327-cfd32611ce74
msgctxt "hb4587b23g25d3g44f8g8efeg688619edbfec"
msgid "My vampiric friend? Sure, I can bring him here."
msgstr "우리 뱀파이어 친구? 그래, 데리고 올 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = ac12724e-cb3e-8348-7443-46f28fbf0fa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_Knows_Identity = False
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:ac12724e-cb3e-8348-7443-46f28fbf0fa3
msgctxt "hdb8da1b4g5cf2g4293g8f20g82b0e0259fc6"
msgid "Blood magic is an... <i>unusual </i>talent. Who gave it to you?"
msgstr "혈마법은... <i>흔치않은</i> 재능이지. 누구한테 받은 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = ad66b8f0-81db-1eee-96fa-2254a32a3fc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:ad66b8f0-81db-1eee-96fa-2254a32a3fc9
msgctxt "h8ae513fcg5169g4417g9060g97cd0f8959d2"
msgid ""
"Just a little, I promise. I have a 'special offer' of sorts for True Souls. "
"It might interest you."
msgstr "조금만 가져갈게, 약속해. 참된 영혼을 위한 '특별한 제안'이 있거든. 관심이 갈 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = adddb8a3-27a3-49b6-92c6-a587dc8702aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:adddb8a3-27a3-49b6-92c6-a587dc8702aa
msgctxt "h2d5067b8g2f95g41d3gaac1g59b7d177796c"
msgid "Come back any time."
msgstr "언제든 다시 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = aec526f2-6103-c6d9-03d1-697ced73864d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_VENGEANCE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:aec526f2-6103-c6d9-03d1-697ced73864d
msgctxt "h9dd657b4g6f24g4820g897fgbfbc7ca5bc20"
msgid "If it'll help me vanquish my foes - fine."
msgstr "나의 적들을 물리치는 데 도움만 된다면, 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = b7984bdc-340b-7703-1567-f2f0880785ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:b7984bdc-340b-7703-1567-f2f0880785ff
msgctxt "h32bc5dc8g5fc0g48b7g85a4gf61b780b1841"
msgid ""
"Put plainly - I'd like your blood. A vial of <i>True Soul's </i>blood, "
"specifically."
msgstr "솔직히 말할게, 네 피가 필요해. 정확히는 <i>참된 영혼의</i> 피 한 병."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = b7a6d11b-01eb-7011-c185-8c815d50268b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:b7a6d11b-01eb-7011-c185-8c815d50268b
msgctxt "h0ba5f8c1g3f51g464dgaecaged04f8733900"
msgid "It's not for sale, but it's yours if you bite me."
msgstr "이건 파는 게 아니야, 근데 네가 날 물어주면 네 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = b88dadfd-6f5b-aa64-788c-58ddf002f9c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:b88dadfd-6f5b-aa64-788c-58ddf002f9c1
msgctxt "h675847b4gb803g41d9g83d7g5dd78312387d"
msgid "Don't say such a thing. Don't dash my hope."
msgstr "그런 말은 하지 마. 내 희망을 꺾지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = b89696ff-4481-c3d7-b6b8-fe0730aa5ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:b89696ff-4481-c3d7-b6b8-fe0730aa5ce5
msgctxt "haad5e4c9gc62ag4e51g9fccg8e46b8b3a80c"
msgid ""
"I will speak of it when he is here. Not before. But it will be to your "
"advantage, I promise."
msgstr "그 남자가 오면 이야기할게. 그전엔 안 돼. 너한테 좋은 일일 거라는 건 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = bb804ae6-3220-2a4e-11bc-0825a50cc30f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:bb804ae6-3220-2a4e-11bc-0825a50cc30f
msgctxt "h3f8f5c15ge621g48cfg9ef8gbfaa684b2a0f"
msgid "I'm not sure - my blood is <i>exceptionally </i>sought after."
msgstr "잘 모르겠는데, 내 피가 <i>유난히</i> 수요가 많아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = bd77b394-e390-b5bc-230a-1c9c070b7d37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:bd77b394-e390-b5bc-230a-1c9c070b7d37
msgctxt "h716e46a3g04b5g4a71g8c9eg9d1579c7016d"
msgid "Never mind. I'm not interested."
msgstr "됐어. 관심없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = bfc156de-5836-fcb2-92e2-185fa6b781ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:bfc156de-5836-fcb2-92e2-185fa6b781ad
msgctxt "h3830c3fbgc7e6g4609gba25g839ce29efd02"
msgid ""
"The beings you speak of have no use for gods - and yet here we stand in a "
"church of their making."
msgstr "네가 말한 존재들은 신을 필요로 하지 않아, 그렇다고 하더라도 우리는 지금 그들이 만든 교회에 서 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = cb449868-cc5e-a724-c942-18723ec05a2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:cb449868-cc5e-a724-c942-18723ec05a2d
msgctxt "hd383a525ga793g4e9cg9b9ag91cc9e680f1f"
msgid "There is malice in this blood. It boils, churns, and whispers to me."
msgstr "이 피 속에는 악의가 들어있다. 끓어오르고, 뒤틀리며, 나에게 속삭이기까지 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = cda8f8ea-efa4-0518-9909-080ff0f716bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:cda8f8ea-efa4-0518-9909-080ff0f716bd
msgctxt "hf5e70582g6605g44e5ga2f9g7808d3085024"
msgid ""
"Well, that's why we're trading, no? I assure you, the potions are more than "
"worth their weight."
msgstr "뭐, 그래서 거래하는 거 아니겠어? 장담하는데, 그 물약은 부르는 게 값이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = ce480f3d-60ce-7e12-f63c-5c832b5a0e0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_State_AskedAboutDeals = True
#.   Object:
#.      - MOO_InfernalVendor_State_AskedAboutBloodDeals(1) = False
#.      - MOO_InfernalVendor_State_SoldBlood(1) = False
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_State_AskedAboutBloodDeals(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:ce480f3d-60ce-7e12-f63c-5c832b5a0e0c
msgctxt "ha97eb391gf4b9g4b8cgb35cgd58a2946dcf3"
msgid "I hear you trade potions for True Soul blood."
msgstr "참된 영혼의 피와 물약을 교환해준다던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = ce50a6dd-a2a2-c12b-f2e9-c6da19a241dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:ce50a6dd-a2a2-c12b-f2e9-c6da19a241dd
msgctxt "h1470210bgcceag4b0cgb195g955804b430b8"
msgid ""
"Unless <i>they</i> are not the makers, but simply the means. Wouldn't that "
"be a secret worth knowing?"
msgstr "만약 <i>그들</i>이 창조자가 아니라, 단순히 매개체일 뿐이라면. 그건 우리가 알아내야 할 비밀이 아닐까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d0de04d4-6fe5-82b7-db92-21dc8200be3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d0de04d4-6fe5-82b7-db92-21dc8200be3b
msgctxt "hf4434488gbd83g4e81gab5egd98d111c3e67"
msgid "And now here I stand before one. Can you make my dream come true?"
msgstr "그리고 지금 내 앞에 한 명 있네. 내 꿈을 이루어 줄래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = d1af2568-30a7-4e68-a421-0d3c6f909ca0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_State_AskedAboutDeals = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d1af2568-30a7-4e68-a421-0d3c6f909ca0
msgctxt "h2026b681ge245g4bebg907bgff6638622970"
msgid "Let's hear about this special offer of yours."
msgstr "그 특별한 제안이란 걸 들어볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d2577806-c2dd-1305-4c6b-118112e65af5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d2577806-c2dd-1305-4c6b-118112e65af5
msgctxt "h13ec7d56gd652g417cgba55gdb8d65919c5e"
msgid "Excellent! I knew you'd come around."
msgstr "아주 좋아! 네가 다시 올 줄 알았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d38cd960-9735-a5ee-74e7-c24f714e561c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d38cd960-9735-a5ee-74e7-c24f714e561c
msgctxt "h0fc3757bgd2c8g44b0g9206g517c3a139d18"
msgid ""
"Truth be told, I heard tell of your coming before you arrived. Ketheric's "
"dogs prowl far and wide round the Tower."
msgstr "사실은, 네가 오기 전에 네 소식을 이미 들었어. 케서릭의 개들이 타워 주변을 배회하고 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = d3eb4963-9f97-8835-f329-f7405bade187
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_Knows_Identity = False
#.   Object:
#.      - MOO_InfernalVendor_Knows_AskedAboutResearch(1) = False
#. SetFlags:
#.   Object:
#.     - MOO_InfernalVendor_Knows_AskedAboutResearch(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d3eb4963-9f97-8835-f329-f7405bade187
msgctxt "h6b06f9e8g759bg4e88ga93eg0591ea5f48c0"
msgid "And what exactly are you planning to do with your share?"
msgstr "그럼 남은 걸로는 정확히 뭘 할 생각인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d5c1651d-1d57-ee60-19c1-f21f8572c2e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_InfernalVendor_State_AstarionOrphanRefusedToBite = True
#.     - MOO_BloodMerchant_State_BloodMerchantAskedAstarionToBiteHer = True
#.   Object:
#.     - MOO_InfernalVendor_HasMet_Vendor(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d5c1651d-1d57-ee60-19c1-f21f8572c2e1
msgctxt "h2f58c23fg962cg479fg97bcgaccaba604023"
msgid ""
"How unfortunate. But if you won't take my blood, then perhaps I could have "
"yours?"
msgstr "참으로 안타까워. 내 피를 받지 않겠다면, 내가 네 피를 받아가도 되겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d782e718-6c6b-e485-5e03-b1187470e413
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BloodMerchant_Event_GiveLegendaryPotion(1) = True
#.     - MOO_BloodMerchant_State_AstarionAvatarRefusedToBite(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d782e718-6c6b-e485-5e03-b1187470e413
msgctxt "hd365eaf4ga3f0g4058g8c97g0264505e5040"
msgid "I feel exquisite though - so here's my part of the bargain."
msgstr "더없이 훌륭한 기분이야, 그럼 이제 내가 약속한 부분을 줄 차례네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d9032b2f-0e2d-0f1b-8b67-ece41201a309
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d9032b2f-0e2d-0f1b-8b67-ece41201a309
msgctxt "hcd6a51e7g4078g4750g9e34gf54aeede024a"
msgid ""
"I'll even compensate you - a potion of legendary power that forever "
"increases the strength of the one who consumes it."
msgstr "물론 보상해 줄게, 마신 사람의 힘을 영구히 증가시켜주는 전설적인 물약이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d9130c55-312d-c86c-6cd8-b6e01467f0f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_BloodMerchant_State_GaveAstarionQuest = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d9130c55-312d-c86c-6cd8-b6e01467f0f1
msgctxt "h86d9a192gf23dg4751g80aeg2865c09b4916"
msgid "Please. I have a proposal for him. I will reward you both, handsomely."
msgstr "부탁할게. 나 그 남자에게 볼일이 있어. 둘 다한테 후한 보상을 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = d9e7b6c1-2636-bf65-ff06-f08881b0d17f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:d9e7b6c1-2636-bf65-ff06-f08881b0d17f
msgctxt "h00539dd3g1869g4577g8631g3b00d71fb6ef"
msgid ""
"I read about your kind for so many years, but never thought I'd find one in "
"real life. And to find such a fine specimen..."
msgstr "수많은 시간동안 너 같은 사람들에 대해 읽어봤는데, 진짜로 만나게 될 거란 생각은 못했었어. 게다가 이렇게 좋은 견본이라니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = db217c1f-ffb0-9dac-4469-1596f1f21709
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:db217c1f-ffb0-9dac-4469-1596f1f21709
msgctxt "ha384e3f5ge91eg49d2gb267g2b928fea8d97"
msgid ""
"I'll even compensate you - a potion of legendary power that forever "
"increases the strength of the one who consumes it."
msgstr "물론 보상해 줄게, 마신 사람의 힘을 영구히 증가시켜주는 전설적인 물약이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = e52c58e0-5a83-0187-c35d-d81d273ce96c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_InfernalVendor_Knows_Identity = False
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:e52c58e0-5a83-0187-c35d-d81d273ce96c
msgctxt "hfcf75ca3g88f3g498agaa8cge669e2d1a57e"
msgid "A Zhengyian blood mage? Unusual for you to be so far from Vaasa."
msgstr "젠기 혈마법사가 여기에? 바사에서 이렇게 멀리 나와있다니 이례적인 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = e8ce6382-e4bd-b43a-db48-f3375d3afe51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:e8ce6382-e4bd-b43a-db48-f3375d3afe51
msgctxt "he62f65f0g1f70g4714g890dg1653730123b8"
msgid ""
"No idea! But it will be unique to you - your blood essence and the "
"Absolute's blessing intertwined."
msgstr "모르지! 근데 너만의 특별한 물약이 될 거야, 네 피의 정수랑 절대자님의 축복이 서로 얽히는 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Player
#. NodeID = ec7d753e-3af2-4a9a-951f-9897743ba8c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:ec7d753e-3af2-4a9a-951f-9897743ba8c9
msgctxt "h7123c5b1gc773g46bdga2eegf7b27d0c5719"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = f4988b41-ac88-6147-4ae3-cd924a58b656
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:f4988b41-ac88-6147-4ae3-cd924a58b656
msgctxt "hbc0fde79g06ecg4c12g9b4ag871124607518"
msgid ""
"I have a project to complete - and <i>you </i>are far too unique a specimen "
"to risk."
msgstr "난 이 연구의 끝을 봐야 해. 그리고 <i>넌</i> 위험을 무릅쓸 수 없을 정도로 너무나 특별한 표본이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = fae492a3-bf9e-a48e-30d6-e002140b865e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:fae492a3-bf9e-a48e-30d6-e002140b865e
msgctxt "h665ed185gbd29g40b0g9973g85955d3cfdd9"
msgid "That, I cannot allow. For <i>either </i>of us."
msgstr "그럴 수는 없어. 우리 <i>모두를</i> 위해서라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor
#. Speaker = Araj Oblodra
#. NodeID = ff7a73b0-c901-e8d4-9cff-5ba1e4fa7ca4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor:ff7a73b0-c901-e8d4-9cff-5ba1e4fa7ca4
msgctxt "h9103089bg1300g428cg9042g1f24dce11066"
msgid ""
"If you can't be reasonable, I'll just have to observe your development from "
"afar. For now."
msgstr "합리적인 판단이 안 된다니 어쩔 수 없지. 그저 멀리서 그 과정을 지켜보는 수밖에. 당장은 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = 1376ef59-8bc9-48bf-944d-3051c71f52c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BloodMerchant_State_ConvincedAstarionToDrinkBlood = True
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:1376ef59-8bc9-48bf-944d-3051c71f52c8
msgctxt "hfb45da5fg73f8g4b84g9d05gaadfb29dda27"
msgid "Hm. Tremors - like a child at her first <i>illiyitrii.</i>"
msgstr "흐음. 전율이 흐르는군 마치 어린 아이의 첫 <i>일리이트리 무도회</i>처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = 1fe14fea-210c-42ba-95fe-dab89a5cc9f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BloodMerchant_State_ConvincedAstarionToDrinkBlood = True
#.   Local:
#.      - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_C = True
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_B = False
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_A = False
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:1fe14fea-210c-42ba-95fe-dab89a5cc9f7
msgctxt "h1ec2ace4g039ag4ed1gbc06gc7a39eb0b617"
msgid "If only he had gone further..."
msgstr "그 녀석이 조금만 더 버텼더라면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = 7c324fbe-1170-4814-b67d-aa6947f78811
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_C = True
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_B = False
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_A = False
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:7c324fbe-1170-4814-b67d-aa6947f78811
msgctxt "h34bbef4bgbf93g4d32g9d75g70825f8445d9"
msgid "The Chosen's blood... now <i>that</i> would be a prize sample."
msgstr "선택받은 자의 피라... <i>그건</i> 좀 가치 있는 샘플이 되겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = 969f0249-1b28-4089-8924-17ab05dd7598
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BloodMerchant_State_ConvincedAstarionToDrinkBlood = True
#.   Local:
#.      - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_B = True
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:969f0249-1b28-4089-8924-17ab05dd7598
msgctxt "h51e8dbb5g025cg40fbga892g488f46ab8d9c"
msgid "You haven't felt like prey in many moons, Araj..."
msgstr "오랜만에 먹잇감이 된 기분이군, 아라즈..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = 9a0abbd3-eeb3-49b1-9c6e-3ffc3d734947
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:9a0abbd3-eeb3-49b1-9c6e-3ffc3d734947
msgctxt "hbace133ag7d33g47ccgadb8g82c6e9d667e2"
msgid "Hmm. That smells... interesting."
msgstr "흠. 재밌는... 냄새가 나네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = d9347841-79cb-44ef-a268-bad721dda019
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_B = True
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:d9347841-79cb-44ef-a268-bad721dda019
msgctxt "h7cc94e30g891eg49bfg96e5gda2fe5e76053"
msgid "Bah, the reaction failed. Perhaps I can pawn it off as a luck potion."
msgstr "으, 실험 실패군. 어쩌면 이걸 행운의 물약으로 포장해서 팔 수 있을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = d9f18083-be22-4c67-8974-eed243072ed1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BloodMerchant_State_ConvincedAstarionToDrinkBlood = True
#.   Local:
#.      - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_A = True
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:d9f18083-be22-4c67-8974-eed243072ed1
msgctxt "h171cefe3gbc04g497eg8f56g7ff42dd4bca9"
msgid "A little saliva from the wound... saving that..."
msgstr "상처에서 체액이 조금 흘러나오는군... 이건 보관하고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling
#. Speaker = Araj Oblodra
#. NodeID = f492f48c-d286-4171-a0e4-3c50820a6aea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_A = True
#. SetFlags:
#.   Local:
#.     - b51dde9e-312e-56f2-9b3d-e1d409a56805_MOO_InfernalVendor_Local_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_AD_Idling:f492f48c-d286-4171-a0e4-3c50820a6aea
msgctxt "h32d0760cgd752g4e3eg9f33g0cfac3b976dd"
msgid "Just a pinch of... ah. Is this... hallucinogenic?"
msgstr "한 꼬집만... 아. 이거... 환각제인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 41bca524-f10a-4576-808b-efda7cd4047b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_PAD_FeelingSick:41bca524-f10a-4576-808b-efda7cd4047b
msgctxt "h1daef54fgbea7g456cg97ecg96bfa4564f36"
msgid "Gods damn it. What was in that potion?"
msgstr "이런 젠장. 물약에 대체 뭐가 든 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 41bca524-f10a-4576-808b-efda7cd4047b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_PAD_FeelingSick:41bca524-f10a-4576-808b-efda7cd4047b
msgctxt "h7576eb31ge422g445ag9c97g2ef64ab4dc4e"
msgid "Offfph... I feel less-than-well..."
msgstr "어후... 몸이, 좋지, 않아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 41bca524-f10a-4576-808b-efda7cd4047b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_InfernalVendor_PAD_FeelingSick:41bca524-f10a-4576-808b-efda7cd4047b
msgctxt "h3166ea59g5916g4353ga6acg78082e895a7d"
msgid "Oh gods - my stomach's in <i>bits.</i>"
msgstr "으악, 위장이 <i>요동을 치는구먼.</i>"

