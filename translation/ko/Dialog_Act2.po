msgctxt "hd5da07efg20dfg478dgad9ag5f3f3a8a4ce5"
msgid "What is a healer with no patient to tend?"
msgstr "돌볼 환자 없는 치유사에 무슨 의미가 있단 말인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon
#. Speaker = Malus Thorm
#. NodeID = c7a445d1-cef0-4edf-8d15-51436b8bfd26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f4169abb-abdc-be87-1a9d-91387440472c_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon:c7a445d1-cef0-4edf-8d15-51436b8bfd26
msgctxt "h1d08d64bg0017g410cg8f67g2bf9fe118034"
msgid "Witness the solace of the Lady's whispers with each slice."
msgstr "한 번 자를 때마다 여신께서 위안의 휘파람을 불어주시는 모습을 보게나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon
#. Speaker = Malus Thorm
#. NodeID = c9978e2b-ccba-af4b-7d24-2d5fad8cd5b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
