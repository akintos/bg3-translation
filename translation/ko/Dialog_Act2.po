msgctxt "ha6ea4ba1g7b82g492cg97bdgd3f0ce47f2b3"
msgid "Ketheric Thorm. Looks like he's mourning his daughter."
msgstr "케서릭 쏨이야, 딸의 죽음을 애도하는 모습 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_Mural_001
#. Speaker = Player
#. NodeID = e14a8c9c-4874-4248-9875-4179224d9134
