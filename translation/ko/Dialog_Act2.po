#. CheckFlags:
#.   Global:
#.      - MOO_Audience_State_Ready = True
#.   Local:
#.      - 550fa509-db7a-cd6d-0854-705de6d21f37_A = True
#. SetFlags:
#.   Local:
#.     - 550fa509-db7a-cd6d-0854-705de6d21f37_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:bb8ef48f-624f-4ea5-923d-98c25e3029e6
msgctxt "hdd1e73e0gcbacg412egb2c3g55e792664922"
msgid "Our victory is assured. In Her name."
msgstr "우리의 승리는 예견되었다. 그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
#. NodeID = cc3885b7-d239-4b67-95ca-95f515a3acdc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 550fa509-db7a-cd6d-0854-705de6d21f37_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:cc3885b7-d239-4b67-95ca-95f515a3acdc
msgctxt "h404f785dg9253g4544g9e4cg53e5faa271eb"
msgid "Shelter from the shadows a while, true soul."
msgstr "잠시나마 그림자로부터 벗어나 쉬게, 참된 영혼이여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
#. NodeID = ecbc0694-d372-4fe5-af76-14c38d84195c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#.   Local:
#.      - 550fa509-db7a-cd6d-0854-705de6d21f37_A = True
#. SetFlags:
#.   Local:
#.     - 550fa509-db7a-cd6d-0854-705de6d21f37_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:ecbc0694-d372-4fe5-af76-14c38d84195c
msgctxt "h7e9ce1cag43c7g4a1eg9276gbb5b00e7d7f2"
msgid ""
"You should report to the throne room. Z'rell likes to greet all true souls "
"on arrival."
msgstr "알현실로 가서 보고하도록. 즈렐 님께서는 찾아오는 모든 참된 영혼을 맞이하고자 하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
#. NodeID = fcbae4af-3281-412b-8641-ad988ceb4aa1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#. SetFlags:
#.   Local:
#.     - 550fa509-db7a-cd6d-0854-705de6d21f37_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:fcbae4af-3281-412b-8641-ad988ceb4aa1
msgctxt "hb04afb3fgedcdg4090gbe40g6a2a8446dcf2"
msgid ""
"General Thorm is in the throne room, passing judgement on some of the "
"troops. Doesn't look good for them."
msgstr "쏨 장군님은 알현실에 계시다. 병사 몇명에게 심판을 내리는 중이지. 그리 유쾌해 보이진 않더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Adept Merim
#. NodeID = 08f1e75d-33b0-4dda-bde2-032b17872d7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:08f1e75d-33b0-4dda-bde2-032b17872d7f
msgctxt "h4a2bc315gdb88g49ffg9a23g834804dabf3b"
msgid "I'd prefer you to speak sense."
msgstr "알아들을 수 있게 말해주지 않으련."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = 0c8825d8-1595-4527-8c09-49367fbd9e09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:0c8825d8-1595-4527-8c09-49367fbd9e09
msgctxt "h1236a13egd323g4c97g955bg2b76bca12b82"
msgid "I was speaking figuratively."
msgstr "비유적으로 한 말이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Adept Merim
#. NodeID = 11708929-e104-45ce-a31d-5e0574a45521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:11708929-e104-45ce-a31d-5e0574a45521
msgctxt "hbdc0518dg11cdg452fgb015g778b7e1fd178"
msgid "It's not the worst thing out there."
msgstr "저보다 끔찍한 것들이 한무더기는 더 있을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = 154111b9-d3ad-4c40-9e44-ff99524458af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:154111b9-d3ad-4c40-9e44-ff99524458af
msgctxt "h3086c943g01a5g4b5bg8469g58f56ed10bbf"
msgid "Yes?"
msgstr "왜?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = 1dfb02a1-2921-40f7-8d00-9bce3cf59bc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:1dfb02a1-2921-40f7-8d00-9bce3cf59bc0
msgctxt "h46c2da7dg16b1g4c31ga846g033cb84f5a38"
msgid "Who were you before?"
msgstr "전엔 뭐 하고 살았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = 7bf950d1-e163-40d0-bdbc-6b9d7c91268f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:7bf950d1-e163-40d0-bdbc-6b9d7c91268f
msgctxt "hb33e0717g856cg4fa7g9599ge9115a882b64"
msgid "Aye. At least it's on our side."
msgstr "그러네. 저건 우리 편이기라도 하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = 81ac95d7-684d-4386-b092-d67c9766953f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:81ac95d7-684d-4386-b092-d67c9766953f
msgctxt "h03893b8eg2134g4604gab38gdaad6475bd5d"
msgid "Before the Absolute? I was nobody."
msgstr "절대자님을 섬기기 전에? 별 볼 일 없는 놈이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = 85d16642-f774-40da-97db-188b289d7ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:85d16642-f774-40da-97db-188b289d7ef1
msgctxt "hf5918a10ge19fg4247g905fgb55cb1a2b756"
msgid "I hear we march come first light."
msgstr "날이 밝으면 진격할 거라고 들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Adept Merim
#. NodeID = e81a9804-2825-419b-921c-fd3d63730ebf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:e81a9804-2825-419b-921c-fd3d63730ebf
msgctxt "h63ba9fbfg915ag4b0cgb102g28db71e07461"
msgid "There is no light here."
msgstr "여긴 빛 같은 거 안 들어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = f06d650e-409f-4964-a44d-f8adf5f12175
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:f06d650e-409f-4964-a44d-f8adf5f12175
msgctxt "he4fed528g87d9g4332g9cbdg1c5d729b0122"
msgid "Malik?"
msgstr "말릭?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards
#. Speaker = Zealot Malik
#. NodeID = f308b4ff-cff2-4a99-8e3f-473a6ac080b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guards:f308b4ff-cff2-4a99-8e3f-473a6ac080b8
msgctxt "h2ca0681dge404g4955gbcbbg0dc91b55e77d"
msgid ""
"I'll never get used to seeing that drider scuttling out of the darkness."
msgstr "드라이더가 어둠 속에서 종종걸음으로 튀어나오는 모습은 절대 익숙해지지 않을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_DaisyAD_Approach
#. Speaker = GROUP_Daisy
#. NodeID = 0537d66a-9347-488e-9407-c55f8db0212e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_DaisyAD_Approach:0537d66a-9347-488e-9407-c55f8db0212e
msgctxt "h1503f7afg9923g463ag812dg9bd00a341816"
msgid "We're close. I can feel it - the Absolute. Its power is strong here."
msgstr "가까워지고 있군. 절대자, 그 힘이 이곳에서 강하게 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_DaisyAD_Approach
#. Speaker = GROUP_Daisy
#. NodeID = 0537d66a-9347-488e-9407-c55f8db0212e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_DaisyAD_Approach:0537d66a-9347-488e-9407-c55f8db0212e
msgctxt "h2200cb11g687bg4321g9ca9g5550cea2c1aa"
msgid "We're close. I can feel it - the Absolute. Its power is strong here."
msgstr "가까워지고 있군. 절대자, 그 힘이 이곳에서 강하게 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider
#. Speaker = Adept Merim
#. NodeID = 0fd1deae-cf39-52ce-a75b-06f2caf9b1fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider:0fd1deae-cf39-52ce-a75b-06f2caf9b1fa
msgctxt "h30156f13g3e07g4999ga0a9g3fc1f999433d"
msgid "Rest of you - head on in."
msgstr "나머지는 전부 안으로 가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider
#. Speaker = Brawler Vez
#. NodeID = 12e80a55-0077-1a88-4dc0-8e940fffe199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider:12e80a55-0077-1a88-4dc0-8e940fffe199
msgctxt "he56bd195ge952g46f6g8f7bg639ebd750c6b"
msgid "Aye."
msgstr "그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider
#. Speaker = Zealot Malik
#. NodeID = 1717216b-08d9-f59b-7c09-3a523f518d71
