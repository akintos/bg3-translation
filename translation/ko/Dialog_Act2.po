#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:0c48fc99-965f-4f5a-8b79-8a4e174d9e38
msgctxt "h5ef9cda9gce2ag459ag8b1bgc8b4011eef1c"
msgid "Monster lives in this tower. Something<i> big.</i>"
msgstr "이 탑에 괴물이 있다. 뭔가 <i>큰 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Acolyte Kimmeral
#. NodeID = 17ac2385-000e-4aac-bf6a-c7498374e98d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 0e791991-068a-3008-e14c-d70ae36d240f_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:17ac2385-000e-4aac-bf6a-c7498374e98d
msgctxt "hff6980aagff4fg4315gba6ag3ba83f829412"
msgid "Now Mig, come on - we told you there's nothing there."
msgstr "이봐 미그, 좀 - 아무것도 없다고 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Mig
#. NodeID = 1bffde79-94a8-48c7-a48a-eb642ed346e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:1bffde79-94a8-48c7-a48a-eb642ed346e7
msgctxt "h86559970gb1d8g4d85gb939g007bd5ffb0d7"
msgid "NO! Mig good. Behave."
msgstr "안돼! 미그 착하다. 얌전해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Zealot Iogar
#. NodeID = 2d2b047e-22f4-4ca6-b05d-be75bbe83044
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:2d2b047e-22f4-4ca6-b05d-be75bbe83044
msgctxt "ha9f92784gd4fag471eg867fgcd751f063019"
msgid "That's a stone bloody wall. Have a taste if you don't believe us."
msgstr "피 묻은 돌벽일 뿐이야. 못 믿겠으면 맛이라도 보던가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Mig
#. NodeID = 5b6e822f-e12b-47a4-b0ce-2761c03775c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:5b6e822f-e12b-47a4-b0ce-2761c03775c1
msgctxt "h52cf674bgce00g4c85g8960g7a357eec5f1a"
msgid "Not afraid. <i>Hungry.</i>"
msgstr "무서운 게 아니다. <i>배고픈 거다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Acolyte Kimmeral
#. NodeID = 6cf9710a-0758-485f-9fc3-eebbec8829be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:6cf9710a-0758-485f-9fc3-eebbec8829be
msgctxt "ha6e6354bg71fdg4de2g8951g5365b99e1ef9"
msgid ""
"Hah. Don't blame you for wanting to steer clear. Some truly gruesome sorts "
"gathered down there."
msgstr "하. 가고 싶지 않은 게 정상이긴 하지. 아주 끔찍한 놈들만 모여있는 곳이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Mig
#. NodeID = 8f47f4bc-0ca1-4dcc-ad2c-3e6f12c94434
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:8f47f4bc-0ca1-4dcc-ad2c-3e6f12c94434
msgctxt "h5bdde79egdcc1g4833gbf77g66530e2b69f3"
msgid "Mig hear meat. Mig <i>knows.</i>"
msgstr "미그 고기소리 들었다. 미그 <i>알고 있다</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Acolyte Kimmeral
#. NodeID = c82f1a36-4ad0-42ab-b511-98509eb75241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:c82f1a36-4ad0-42ab-b511-98509eb75241
msgctxt "hcf8d214dgfe0fg4954gb247gf5637f7382ab"
msgid "You're the biggest thing here. Nothing to be afraid of, lass."
msgstr "여기선 네가 제일 커. 무서워 할 거 없다고, 아가씨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt
#. Speaker = Zealot Iogar
#. NodeID = cb4de687-6c2e-4adf-ad39-4136db065bd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0e791991-068a-3008-e14c-d70ae36d240f_B = True
#. SetFlags:
#.   Global:
#.     - MOO_GuardRoom_Event_InterruptOgre = True
#.   Local:
#.     - 0e791991-068a-3008-e14c-d70ae36d240f_A = False
#.     - 0e791991-068a-3008-e14c-d70ae36d240f_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_GuardsInterrupt:cb4de687-6c2e-4adf-ad39-4136db065bd9
msgctxt "h74631cb2gfb5bg4495ga64eg1d6575ac6a20"
msgid ""
"If you're hearing things, maybe we ought to send you back to the war camp..."
msgstr "자꾸 뭔가 들린다면, 널 다시 전쟁 막사로 보내야 할지도 모르겠네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "h31029ed3g127bg4bd6gb593gc6c7ab2086e5"
msgid ""
"Urgh, it's full of dripping... goo? Slime? Whatever it is, it's coming from "
"higher up the tower."
msgstr "어으, 뭔가 떨어지고 있는데.... 점액? 슬라임인가? 뭐든 간에 탑 위쪽에서 떨어지고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "h3c3d21d2g78ebg470dgaafbg3d60dbd635ce"
msgid "There's something above. Moist and... organic. Ugh."
msgstr "이 위에 뭔가 있어. 촉촉하고... 살아있는 거네. 어으."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "hbb26daafg710dg411bg989fg7aec60fbbfa3"
msgid "Whatever's dripping from the walls is... alive. Organic, anyway."
msgstr "뭐든 간에 벽에서 떨어지고 있는 건... 살아있어. 뭐든 간에 유기체라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "hf8915ee8g1972g4b79gbb43gc8ffa98d1de7"
msgid "Is this - blood dripping from above? No. It's more viscous than that."
msgstr "이건 - 피가 위에서 떨어지는 건가? 아니. 좀 더 끈적한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "h13e30485g8b5dg4203g8219g054b25eede9b"
msgid "Something's dripping from the rafters. Not sure I want to look up."
msgstr "뭔가 지붕에서 떨어지고 있는데. 올려다 보고 싶지는 않네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "h2cd60af1gc364g4503g91cbg7a1ad6501574"
msgid "Something's dripping from above. I think the technical term is 'goo'."
msgstr "뭔가 위에서 떨어지고 있어. 전문 용어로 하면 '점액'이겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "he0a363b3g17b5g4f97g8475g0e564e7a331f"
msgid ""
"Living flesh - or some residue of it. Perhaps something nests in the rafters "
"above."
msgstr "살아있는 살덩어리 - 혹은 그것의 잔해. 뭐든 간에 지붕 위에 둥지를 틀고 있는 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft
#. Speaker = Player
#. NodeID = 245740f2-227e-48f7-b3e1-265d69c7304e
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_AD_TentacleShaft:245740f2-227e-48f7-b3e1-265d69c7304e
msgctxt "h1c90bff4g7665g4f6ega1bdg63b334ccfd1e"
msgid "Something <i>slimy </i>seems to be dripping from the rafters above."
msgstr "뭔가 <i>끈적한</i> 것이 지붕 위에서 떨어지고 있는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 31a3d02c-6162-c2c9-0f49-464b2e387d7f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Daisy_Interacted = True
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:31a3d02c-6162-c2c9-0f49-464b2e387d7f
msgctxt "he9a5a522gebeeg403cgb64eg1bf2f872b6f0"
msgid "Careful. It nearly had you."
msgstr "조심하세요. 하마터면 잡힐 뻔했습니다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 31a3d02c-6162-c2c9-0f49-464b2e387d7f
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Daisy_Interacted = True
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:31a3d02c-6162-c2c9-0f49-464b2e387d7f
msgctxt "h1064da2bg288dg461cga3b8g3c2870384df6"
msgid "Careful. It nearly had you."
msgstr "조심하세요. 하마터면 잡힐 뻔했습니다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 35a68a63-a828-ac0b-be30-ba5bbb2b4898
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:35a68a63-a828-ac0b-be30-ba5bbb2b4898
msgctxt "hb8e4d263g116ag452egb416g728413c2d8c5"
msgid ""
"Whatever that creature was, its telepathic force was unlike anything I've "
"ever encountered. It <i>must </i>be the source of the Absolute."
msgstr ""
"방금 본 생명체가 무엇인지는 잘 모르겠지만, 그것이 가진 텔레파시 힘은 지금까지 느껴본 그 어떤 것과도 차원이 달랐습니다. "
"<i>틀림없이</i> 절대자의 근원일 것입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 35a68a63-a828-ac0b-be30-ba5bbb2b4898
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:35a68a63-a828-ac0b-be30-ba5bbb2b4898
msgctxt "h527db9f4g1a1ag4290g8249g37f8e405a772"
msgid ""
"Whatever that creature was, its telepathic force was unlike anything I've "
"ever encountered. It <i>must</i> be the source of the Absolute."
msgstr ""
"방금 본 생명체가 무엇인지는 잘 모르겠지만, 그것이 가진 텔레파시 힘은 지금까지 느껴본 그 어떤 것과도 차원이 달랐습니다. "
"<i>틀림없이</i> 절대자의 근원일 것입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 5b87c094-db0d-9d03-d2f8-b1af79fe4ecc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Daisy_Interacted = True
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:5b87c094-db0d-9d03-d2f8-b1af79fe4ecc
msgctxt "hd190bac0g6546g487bgb22fgb6786c77cfea"
msgid ""
"So that creature is the source of the Absolute... You must be more careful. "
"Its telepathic force was greater than anything I've ever encountered."
msgstr ""
"그러니까 저 괴물이 절대자의 근원이로군요... 극도로 주의할 필요가 있겠어요. 그것의 텔레파시 힘은 지금까지 느껴본 그 어떤 것보다도 "
"강력했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 5b87c094-db0d-9d03-d2f8-b1af79fe4ecc
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Daisy_Interacted = True
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:5b87c094-db0d-9d03-d2f8-b1af79fe4ecc
msgctxt "hc4ab9961gffdcg4ba3gb569gd5cc4fe10683"
msgid ""
"So that creature is the source of the Absolute... You must be more careful. "
"Its telepathic force was greater than anything I've ever encountered."
msgstr ""
"그러니까 저 괴물이 절대자의 근원이로군요... 극도로 주의할 필요가 있겠어요. 그것의 텔레파시 힘은 지금까지 느껴본 그 어떤 것보다도 "
"강력했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 67dda126-c249-e619-e3cd-25951f702597
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:67dda126-c249-e619-e3cd-25951f702597
msgctxt "h6a0b1defg0056g4de0g99b1g0123f2dfd7fd"
msgid "It said it was enslaved, but who could enslave such a thing?"
msgstr "노예가 됐다는 말을 했는데, 대체 누가 이런 괴물을 노예로 부릴 수 있을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = 67dda126-c249-e619-e3cd-25951f702597
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:67dda126-c249-e619-e3cd-25951f702597
msgctxt "h6f38a6d2gdce6g48e9g930bgd79852a68ba8"
msgid "It said it was enslaved, but who could enslave such a thing?"
msgstr "노예가 됐다는 말을 했는데, 대체 누가 이런 괴물을 노예로 부릴 수 있을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 0b8e6212-16cf-4eb3-ad1a-7644b11a556a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_WallTentacle_HasMet_Mig(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:0b8e6212-16cf-4eb3-ad1a-7644b11a556a
msgctxt "h3dbaa7b6gf98cg4febga9fag922d4bdafcfe"
msgid "Hush! Meat sounds above. Hear?"
msgstr "쉿! 위에서 고기 소리 난다. 들려?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 1307e09a-8356-e3cf-6934-7c74e175e3e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:1307e09a-8356-e3cf-6934-7c74e175e3e7
msgctxt "h981798b4g2ecbg4f65gae51gd77f5a0949f5"
msgid "Mig join up for food. If god is made of meat... it all make sense now."
msgstr "미그는 음식 때문에 왔다. 만약 신이 고기라면... 말이 된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 16e07bc4-ec1d-4bf1-6873-4a09d71062f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:16e07bc4-ec1d-4bf1-6873-4a09d71062f2
msgctxt "h3a444b3cg34fbg4565g9340g2ea7d821f579"
msgid ""
"In walls above. Loudest near kitchens, but maybe whole tower. Like... like..."
msgstr "벽 위에다. 부엌 근처에서 제일 크다, 근데 탑 전체에서 들리는 걸 수도 있다. 마치... 마치..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Narrator
#. NodeID = 2afd28cb-e870-74a2-0602-bef8810f2f8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Knows_Tentacle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:2afd28cb-e870-74a2-0602-bef8810f2f8e
msgctxt "h0a0e831bg675dg4fd7g9c0cg02e12aadccf6"
msgid ""
"*And for a moment, you <i>do</i> hear it - the brain tendril you "
"encountered, shifting through the tower walls.*"
msgstr "*그리고 잠시 동안, <i>정말로</i> 그 소리가 들립니다. 당신이 마주쳤던 뇌 덩굴손이, 탑 벽 속에서 움직이고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 2f19e89c-e81e-0dfd-e07a-ac7d88b6cfd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:2f19e89c-e81e-0dfd-e07a-ac7d88b6cfd6
msgctxt "h39143e4ag04e5g4057ga3aeg62e1b2a27574"
msgid "Praise Absolute!"
msgstr "절대자를 찬양하라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 3d47394b-3589-b867-428a-388ebd7447a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Knows_MigTentacle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:3d47394b-3589-b867-428a-388ebd7447a5
msgctxt "h553e4470g6070g41e6g83cdg98b2a17fa8aa"
msgid "Absolute... is <i>god</i>-meat?"
msgstr "절대자님은... 고깃덩어리 <i>신</i>이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = 4bb3637e-79e8-c547-ccf3-0850f4417719
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:4bb3637e-79e8-c547-ccf3-0850f4417719
msgctxt "h42f11e9eg70e7g4d3eg9a09gac0fed62feb0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = 4e69292e-4a9d-a97d-1908-1af8a97ff837
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:4e69292e-4a9d-a97d-1908-1af8a97ff837
msgctxt "h0aa41323gd5dbg4b8fgb389gab0680bd9755"
msgid "I think you might just be hearing things."
msgstr "헛것을 듣나 본데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 5243d3bd-4321-3d3b-0193-2a5d107d862e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:5243d3bd-4321-3d3b-0193-2a5d107d862e
msgctxt "h69f24a35g94d2g41b4gb149g9672ea84a91c"
msgid ""
"<i>No! </i>Mig only small. This huge. In walls above. Maybe whole tower."
msgstr "<i>아니! </i> 미그 작을 뿐이다. 이거 무지 크다. 벽 위쪽. 어쩌면 탑 전체."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = 600ce8ff-e700-0dd0-bca9-3c78289c2d1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:600ce8ff-e700-0dd0-bca9-3c78289c2d1a
msgctxt "hea03eb29gc0a8g4618g8225g35907f22fc68"
msgid "It's the Absolute, Mig."
msgstr "절대자야, 미그."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = 6416c075-ca52-fcac-a301-76faf0b6a535
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:6416c075-ca52-fcac-a301-76faf0b6a535
msgctxt "h18639f84g1ecdg46a2g98ceg363ecaf682d9"
msgid "There's a being living within the walls."
msgstr "벽 속에 살아있는 존재가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 70ec0165-8c00-a02d-14a1-d2cb4c60f5a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Knows_BadTaste = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:70ec0165-8c00-a02d-14a1-d2cb4c60f5a2
msgctxt "ha53d6827gc79ag4a67g81cbg82e1ae5294bc"
msgid "Foe-flesh only for Mig."
msgstr "미그는 적 고기만 먹는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 85486a44-f7bb-2201-d1cf-33ad97e22d2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_WallTentacle_HasMet_Mig(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:85486a44-f7bb-2201-d1cf-33ad97e22d2e
msgctxt "h600e00d6g3955g49b9g8e6cga635c8342a0d"
msgid "Sh! You loud. <i>Clumsy.</i>"
msgstr "쉿! 시끄럽다. <i>어설프다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = 88d34abb-aaea-91b1-b71c-0aac236a0409
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Knows_Tentacle = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:88d34abb-aaea-91b1-b71c-0aac236a0409
msgctxt "h1a3d73d5gd52fg49a9gbd0dgc4ab6378d61c"
msgid "Where did you hear the meat-sounds, again?"
msgstr "고기 소리가 어디서 들렸다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 8f453d3c-d8b0-eb8e-5e8a-c07d187a104f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:8f453d3c-d8b0-eb8e-5e8a-c07d187a104f
msgctxt "h7d3ad11ag2b72g4b59gb722gab01b16c4cd9"
msgid "Uh-huh. Okay. But... how <i>taste?</i>"
msgstr "어-허. 알겠어. 하지만... <i>맛</i>은?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 8fa85d63-ed8a-3ed4-3037-90ff96b9a6d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:8fa85d63-ed8a-3ed4-3037-90ff96b9a6d7
msgctxt "h12a27025g0de0g4483gb3b3g7edb27be21aa"
msgid "Bah. Mig thought True Souls was <i>brave.</i>"
msgstr "으엑. 미그 참된 영혼 <i>용감하다</i> 생각했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = 943b609f-30c5-94bb-d4a1-1017c6ded876
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:943b609f-30c5-94bb-d4a1-1017c6ded876
msgctxt "h3ab31c3ag25ffg4492g9e24gdfa99fb2bf28"
msgid "Something in the walls? What is it?"
msgstr "벽 속에 뭔가 있다고? 그게 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = 9ea6e4d0-85da-3037-3bdd-47751c8f9b22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:9ea6e4d0-85da-3037-3bdd-47751c8f9b22
msgctxt "h4308afbag2bc6g4522g8221g6b2d1aeb873e"
msgid "Blech. No. Mig stick to foe-flesh - nice and sweet."
msgstr "으웩. 아니. 미그 적 고기나 계속 먹는다. 달고 맛있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = a2f1f896-2fa2-b18b-1802-5ef1cd9752a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:a2f1f896-2fa2-b18b-1802-5ef1cd9752a7
msgctxt "he51be035ge30cg4b83g94fcg96091fdc02f7"
msgid "...like we <i>inside</i> meat. Mig eat meat... or meat eat Mig...?"
msgstr "...마치 우리가 고기 <i>안</i>에 있는 거 같다. 미그는 고기 먹는다... 고기가 미그를 먹나...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = bd3ec5b7-7e47-9d27-1b19-5b09ae728779
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:bd3ec5b7-7e47-9d27-1b19-5b09ae728779
msgctxt "ha70c4c55g3f47g4eb4gb63aga57781df04cf"
msgid "It's some kind of illithid being."
msgstr "일종의 일리시드야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = cbc8b3bc-730f-08c3-700e-3f4eefc4c27d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Knows_MigTentacle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:cbc8b3bc-730f-08c3-700e-3f4eefc4c27d
msgctxt "h256fdbd3gbd2fg495aga611g50ef519ab915"
msgid "Praise Absolute!"
msgstr "절대자 찬양!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = cd0cfecf-5a69-63ef-3b5b-d3c52217ef78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:cd0cfecf-5a69-63ef-3b5b-d3c52217ef78
msgctxt "h4cbe0182g2ab2g473fgb2b1g4a6aef823088"
msgid "<i>Big. </i>In walls above. Maybe whole tower."
msgstr "<i>크다.</i> 벽 위쪽. 어쩌면 탑 전체."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = ce1de84b-3fc5-1c7c-8b72-eafba4b6dbc0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Knows_Tentacle = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:ce1de84b-3fc5-1c7c-8b72-eafba4b6dbc0
msgctxt "h45db74d1g479dg4c2cg9261g959b53f737f9"
msgid "I encountered the being living in the walls."
msgstr "벽 속에 살고 있는 거랑 마주쳤었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = cef1d4a3-1d2a-3c1c-720b-83149c398b6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:cef1d4a3-1d2a-3c1c-720b-83149c398b6f
msgctxt "haf0acb6egb4d8g4828g912eg14214ad950de"
msgid "Is it you...?"
msgstr "네 소리 아냐...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = d17b16dc-7833-82f5-4705-3f2b08d08790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:d17b16dc-7833-82f5-4705-3f2b08d08790
msgctxt "h2d1eda75g8726g4ea8ga20dg9c2efbac58f0"
msgid "You find meat? You SHARE."
msgstr "너 고기 찾았어? 너 <b>나눠준다</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = d3c17e69-b93e-971e-146f-def79ae517dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:d3c17e69-b93e-971e-146f-def79ae517dd
msgctxt "h611c7358gae77g401eg9113g0e05ae77793d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = d7d6c285-153b-cdf4-63da-cc28a107f27f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:d7d6c285-153b-cdf4-63da-cc28a107f27f
msgctxt "h932c0f5ag5bceg43e6gaf4ag72bcba788bcd"
msgid "Being? Telling! Tell Mig!"
msgstr "존재? 뭔데! 미그에게 말해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = e7a73468-43ba-627e-3565-68d26560657c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Knows_LookInWalls = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:e7a73468-43ba-627e-3565-68d26560657c
msgctxt "h0bd67decg488fg41a0g8fd1g270fe2addea3"
msgid "Loudest near kitchen, but Mig banned. Not allowed to pet gnolls."
msgstr "부엌 근처에서 제일 시끄럽다, 하지만 미그 못 들어간다. 놀 쓰다듬는 거 금지다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = eec1ec61-6380-5ec9-11d8-c8e5adc31994
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Knows_BadTaste = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:eec1ec61-6380-5ec9-11d8-c8e5adc31994
msgctxt "h761823d5g022eg41e5g9a7eg4336181259e4"
msgid "Salty, probably."
msgstr "아마 짭짤하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = f18831c9-f6ca-4343-8f61-9b9adc07bb54
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Knows_BadTaste = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:f18831c9-f6ca-4343-8f61-9b9adc07bb54
msgctxt "hcc088237gd18fg4298gaeacg2b560536139b"
msgid "I didn't <i>lick </i>it."
msgstr "그걸 <i>핥진</i> 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Narrator
#. NodeID = f5c10ed4-7f69-db32-9b96-c6c42b490c5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:f5c10ed4-7f69-db32-9b96-c6c42b490c5c
msgctxt "h9d523916gd843g4934g81e5gf6b9d9e9c21e"
msgid ""
"*For a moment, you <i>do</i> hear it - flesh sliding on stone, like a living "
"being extending through the walls.*"
msgstr ""
"*잠시 동안, <i>정말로</i> 그 소리가 들립니다. 벽 속에 살아있는 무언가가 늘어나는 마냥, 살덩이가 돌 위를 지나가는 소리입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Mig
#. NodeID = f91e81b8-c1bd-53ca-cb72-95291f550002
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:f91e81b8-c1bd-53ca-cb72-95291f550002
msgctxt "heed45e12g5494g4ad0gbc5dg04061466edf3"
msgid ""
"No! Mig know meat. This <i>big </i>meat. In walls above. Maybe whole tower."
msgstr "아냐! 미그 고기 안다. 이거 <i>큰</i> 고기다. 벽 위쪽. 어쩌면 탑 전체."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre
#. Speaker = Player
#. NodeID = faa5d030-b813-9371-bce4-a4ad35bbc119
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Ogre:faa5d030-b813-9371-bce4-a4ad35bbc119
msgctxt "h3aed907cg5052g48a2gba6eg8a7be9110c10"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 01c7cb48-840e-d82a-b17c-1b65b1b55e6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:01c7cb48-840e-d82a-b17c-1b65b1b55e6b
msgctxt "hb2c96589g65e7g47ecg8370gc1ed04acabcc"
msgid ""
"*The presence is no longer approaching you, but encircling you. "
"<i>Observing</i> you.*"
msgstr "*그 존재는 더 이상 당신에게 다가오지 않습니다, 하지만 당신을 둘러싸며. <i>관찰하고 있습니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 01ed6193-4d3c-de67-a242-fa06520f6c41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:01ed6193-4d3c-de67-a242-fa06520f6c41
msgctxt "h86a72549gbdccg4536gb675gf25c233f2a5c"
msgid ""
"*Tendrils snap like iron cords around your wrist. That presence in your mind "
"looms large, closer now.*"
msgstr "*촉수가 철로 된 듯 단단히 당신의 손목을 휘감습니다. 당신의 마음 속의 존재가 점점 다가옵니다, 더 가까워집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Player
#. NodeID = 0231bad8-86fb-e1c6-fc8e-daf15f6500b5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:0231bad8-86fb-e1c6-fc8e-daf15f6500b5
msgctxt "h9ae62410g1fe7g4e21g8da7g192e50f98070"
msgid "<i>Search for some leverage to slide your arm out.</i>"
msgstr "<i>팔을 빼내기 위한 지렛대로 삼을만한 것을 찾아본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = 0a032b8b-1c02-7305-c450-8857ab996ac7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:0a032b8b-1c02-7305-c450-8857ab996ac7
msgctxt "h84bf6474gbd68g4de0g912dg98fc01d99411"
msgid ""
"      -why---\n"
"-WHAT-----<b>\n"
"</b>                 ---<b>who</b> are you-"
msgstr ""
"      ...왜.........\n"
"...뭐지............<b>\n"
"</b>                 .........-<b>누구</b> 냐 넌..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Lae'zel
#. NodeID = 0c031aef-0316-1d36-63e4-3391b30091dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:0c031aef-0316-1d36-63e4-3391b30091dd
msgctxt "h631940adgfe0bg403bgaec6gdf42d1c66544"
msgid ""
"Next time, stay your hand. The Absolute may be keen to speak, but I don't "
"share Her enthusiasm."
msgstr "다음번엔, 자제해라. 아마도 절대자는 말을 걸고 싶어 안달 났겠지, 하지만 그 열정에 놀아날 생각은 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Karlach
#. NodeID = 0fe80ae1-2d93-a73f-4651-9e7797b745a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:0fe80ae1-2d93-a73f-4651-9e7797b745a4
msgctxt "h48a4002fg9aadg4450gb3adga4298ee62b23"
msgid "Let me try it next time. Looked fun."
msgstr "다음엔 내가 해볼래. 재밌어 보였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Absolute Voice
#. NodeID = 119f92bd-7f85-7255-4416-41f07c40b04b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:119f92bd-7f85-7255-4416-41f07c40b04b
msgctxt "h0fd4ab9fga199g4208g94a2ga063d6101068"
msgid ""
"<b><i>You are the flaw in their design. The single thread that could unravel "
"everything they've planned.</i></b>"
msgstr "<b><i>그들의 설계에서 넌 결함이었다. 그들의 계획을 들추어낼 수 있는 하나의 실이라고 할 수 있지.</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Narrator
#. NodeID = 12c3b573-4cf8-4601-7c6b-40a665136705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_WallTentacle_HasReachedIn(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:12c3b573-4cf8-4601-7c6b-40a665136705
msgctxt "h4e8f6791ge8a7g406fgb955gd321028a4ceb"
msgid ""
"*Again, the sickening slither of flesh on stone - barely an arm's-length "
"away.*"
msgstr "*다시 한 번, 팔만 뻗으면 닿을 거리에 소름 끼치는 살점이 미끄러지듯 벽돌을 타고 지나갔습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = Disembodied Voice
#. NodeID = 1b626f22-0272-3205-838f-a7c8df9d9ecc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_WallTentacle_Event_ZappedToPrison = True
#.   Object:
#.     - MOO_WallTentacle_State_IsDestroyed(0) = True
#.     - MOO_WallTentacle_Event_PlayerInjured(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle:1b626f22-0272-3205-838f-a7c8df9d9ecc
msgctxt "hf07024b2g44f8g47e5g8d10g52daafae970a"
msgid "<b>--COME</b>---    -<b>BECOME-</b>"
msgstr "<b>......와라</b>.........    ...<b>되어라...</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_Tentacle
#. Speaker = GROUP_Daisy
#. NodeID = 1b9f5890-c792-ac82-a7b7-a34afbf1fe9f
