#.     - 888c185b-e241-7afb-8ea1-40b76a26f3e4_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Alfira:c4a86a1a-545c-98e1-3a39-8c56c61e1003
msgctxt "h40940dc3gfa77g4b8cgb02cg9a0d18d75195"
msgid "I could tell them a story? No, that's stupid."
msgstr "아이들을 위해 이야기를 들려줄까? 아니, 멍청한 생각이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Alfira
#. Speaker = Alfira
#. NodeID = dddea1d1-2bde-43ed-dcc1-04d3e560fdbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 888c185b-e241-7afb-8ea1-40b76a26f3e4_A = True
#. SetFlags:
#.   Local:
#.     - 888c185b-e241-7afb-8ea1-40b76a26f3e4_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Alfira:dddea1d1-2bde-43ed-dcc1-04d3e560fdbc
msgctxt "hcc108e30g2b58g424cg8155gb329076418af"
msgid "I could perform for the kids? But they've seen that plenty of times..."
msgstr "아이들을 위해 공연을? 하지만 이미 여러 번 봤을 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Alfira
#. Speaker = Alfira
#. NodeID = fe5f4405-a219-b480-716b-49d45b9b3911
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 888c185b-e241-7afb-8ea1-40b76a26f3e4_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Alfira:fe5f4405-a219-b480-716b-49d45b9b3911
msgctxt "he84993a4g8d99g40dbg8a35g68dda4ec4f4a"
msgid "Poor kids - I should try to cheer them up."
msgstr "불쌍한 아이들 - 기운을 차리게 좀 도와줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys
#. Speaker = Cerys
#. NodeID = 09cf322d-1a71-4f68-9189-b6d60aa6c738
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cc578350-8b3c-fc87-c521-26ca7e5e5d93_A = True
#. SetFlags:
#.   Local:
#.     - cc578350-8b3c-fc87-c521-26ca7e5e5d93_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys:09cf322d-1a71-4f68-9189-b6d60aa6c738
msgctxt "h136b99c8gc6d7g45e1gb995gd80caabbe4e4"
msgid "What will we do once we reach the city? No - one problem a time."
msgstr "도시에 도착하면 뭘 할까? 아냐-한 번에 하나씩만 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys
#. Speaker = Cerys
#. NodeID = 3718ab77-ab69-48ce-af01-9f85e80e3924
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cc578350-8b3c-fc87-c521-26ca7e5e5d93_B = True
#. SetFlags:
#.   Local:
#.     - cc578350-8b3c-fc87-c521-26ca7e5e5d93_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys:3718ab77-ab69-48ce-af01-9f85e80e3924
msgctxt "h5602e35ag8253g4529gb59egda13a06239b3"
msgid "Zevlor - we'd such high hopes for you, Hellrider."
msgstr "제블로어- 너에게 거는 기대가 컸건만, 지옥기수."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys
#. Speaker = Cerys
#. NodeID = 3c266fb1-2d93-4529-bdbe-c7502ed77a33
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cc578350-8b3c-fc87-c521-26ca7e5e5d93_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys:3c266fb1-2d93-4529-bdbe-c7502ed77a33
msgctxt "h25cf9ac0gb3c6g4075gbe0fg1a1113a166b4"
msgid "We'll need food, medicine, some bedrolls if we're feeling luxurious..."
msgstr "음식과 약이 필요해. 여유가 된다면 침낭도 산다면 좋겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys
#. Speaker = Cerys
#. NodeID = 55bc8ad1-430f-49dc-ac89-06d69c55708e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cc578350-8b3c-fc87-c521-26ca7e5e5d93_C = True
#. SetFlags:
#.   Local:
#.     - cc578350-8b3c-fc87-c521-26ca7e5e5d93_B = False
#.     - cc578350-8b3c-fc87-c521-26ca7e5e5d93_C = False
#.     - cc578350-8b3c-fc87-c521-26ca7e5e5d93_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Cerys:55bc8ad1-430f-49dc-ac89-06d69c55708e
msgctxt "h99e07676g3e74g4cf2gbbcbg41e2cd2747ea"
msgid ""
"Maybe we can pawn off some of the stuff we find here - we could use the coin."
msgstr "여기서 찾은 물건 몇 가지는 전당포에 맡길 수도 있겠어-돈이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide
#. Speaker = Ide
#. NodeID = 3a6c40ae-a111-42e2-beb7-a3f3bf87aa8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#.   Local:
#.      - 876dbe2e-5070-a2c1-0148-cc993aa62289_A = True
#. SetFlags:
#.   Local:
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide:3a6c40ae-a111-42e2-beb7-a3f3bf87aa8e
msgctxt "h257d660dg01d8g44ccgb178g55d67e8f7de9"
msgid "Mol is gonna be waiting for us at the gates of the city - I know it."
msgstr "도시 입구에서 몰이 우릴 기다리고 있을 거야- 분명히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide
#. Speaker = Ide
#. NodeID = 4b8867f7-e9fb-4753-af29-98ee7eae9892
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#.   Local:
#.      - 876dbe2e-5070-a2c1-0148-cc993aa62289_B = True
#. SetFlags:
#.   Local:
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_B = False
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide:4b8867f7-e9fb-4753-af29-98ee7eae9892
msgctxt "h920df070g97d5g438egbf29g9a575bb38dd1"
msgid "We're coming Mol - don't you worry."
msgstr "지금 간다, 몰-걱정하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide
#. Speaker = Ide
#. NodeID = 54ec6931-f069-911f-6680-0729d9f3019a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide:54ec6931-f069-911f-6680-0729d9f3019a
msgctxt "h817ddfd5gf0d0g469fg8941g3461a77e0219"
msgid "Urgh - where <i>is </i>she?"
msgstr "윽- 걘 어디 <i>있는 </i> 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide
#. Speaker = Ide
#. NodeID = 6f49be2a-aa82-4694-9e26-3de2ac1a9f4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#. SetFlags:
#.   Local:
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide:6f49be2a-aa82-4694-9e26-3de2ac1a9f4a
msgctxt "h56278a27g4b49g449egb708ged7e23936667"
msgid "Stupid eyepatch means nothing - Mol is fine."
msgstr "멍청한 안대 따위 상관 없어- 몰은 괜찮다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide
#. Speaker = Ide
#. NodeID = a067a041-bf85-737c-9a18-32ab6b7871b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 876dbe2e-5070-a2c1-0148-cc993aa62289_A = True
#. SetFlags:
#.   Local:
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide:a067a041-bf85-737c-9a18-32ab6b7871b1
msgctxt "h86d7c598g9f28g4796gb613gc88900211b73"
msgid "We beat the baddies - Mol should be here by now."
msgstr "나쁜놈들을 물리쳤다- 몰이 지금쯤이면 왔어야 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide
#. Speaker = Ide
#. NodeID = c79136bc-37ff-2397-dc4e-fc93c3d4794b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 876dbe2e-5070-a2c1-0148-cc993aa62289_B = True
#. SetFlags:
#.   Local:
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_B = False
#.     - 876dbe2e-5070-a2c1-0148-cc993aa62289_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Ide:c79136bc-37ff-2397-dc4e-fc93c3d4794b
msgctxt "hd31a588dg156cg4e1ag97f6g443f25c862d4"
msgid "What's taking Mol so long?"
msgstr "몰이 왜 이렇게 오래 걸리지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis
#. Speaker = Mattis
#. NodeID = 5c2f0d29-f036-895a-3d11-62a05892b5ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#. SetFlags:
#.   Local:
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis:5c2f0d29-f036-895a-3d11-62a05892b5ec
msgctxt "h73af4349g49b2g4664gb176g1dca37bc08fe"
msgid "Just focus on packing - don't think about Mol."
msgstr "짐 싸는 데만 집중해- 몰은 그만 생각하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis
#. Speaker = Mattis
#. NodeID = 6c585382-231d-05ab-0435-b4317dfc38db
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis:6c585382-231d-05ab-0435-b4317dfc38db
msgctxt "h363d2a06g8b0ag4f91g80aage2a1c6437e1d"
msgid "This place is a goldmine - I'm gonna make a killing in the city."
msgstr "여긴 금광이나 다름없네-도시에서 떼돈을 벌겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis
#. Speaker = Mattis
#. NodeID = 6e6065e5-4759-c159-ebad-b42c59b4e363
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1fb21305-2e50-068c-0243-64536fe2bd6c_A = True
#. SetFlags:
#.   Local:
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis:6e6065e5-4759-c159-ebad-b42c59b4e363
msgctxt "h2539da35g5cceg4847gaa3dg23a56658f299"
msgid "What to pack and what to dump? Mol would know."
msgstr "뭘 챙기고 뭘 버리지? 몰이라면 알았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis
#. Speaker = Mattis
#. NodeID = 7dbe6ade-32f0-bc38-4104-86df3336a3e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1fb21305-2e50-068c-0243-64536fe2bd6c_B = True
#. SetFlags:
#.   Local:
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_B = False
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis:7dbe6ade-32f0-bc38-4104-86df3336a3e3
msgctxt "h6c66eaf2g39b1g4f72g85f9g5af10a7d91f7"
msgid "Why are we still here? Grown-ups take <i>forever.</i>"
msgstr "왜 아직도 여기 있는 거야? 어른들은 <i>너무</i> 느려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis
#. Speaker = Mattis
#. NodeID = b472219b-e845-48f9-21ea-2a4528ae353e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#.   Local:
#.      - 1fb21305-2e50-068c-0243-64536fe2bd6c_B = True
#. SetFlags:
#.   Local:
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_B = False
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis:b472219b-e845-48f9-21ea-2a4528ae353e
msgctxt "h4096131cgfce3g4896ga7f9g6bfbf0122730"
msgid "What did Mol always say? 'One problem at a time.'"
msgstr "몰이 늘 뭐라고 했지? '문제는 한 번에 하나씩 해결한다.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis
#. Speaker = Mattis
#. NodeID = f6388a86-50a6-888c-3d8e-b28917bc8da6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#.   Local:
#.      - 1fb21305-2e50-068c-0243-64536fe2bd6c_A = True
#. SetFlags:
#.   Local:
#.     - 1fb21305-2e50-068c-0243-64536fe2bd6c_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Mattis:f6388a86-50a6-888c-3d8e-b28917bc8da6
msgctxt "h1c0f4615g9b0cg43f9gbc95gc3e6417ec797"
msgid "Mol is fine - the eyepatch means <i>nothing.</i>"
msgstr "몰은 괜찮아- 안대는 <i>아무것도</i> 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels
#. Speaker = Nickels
#. NodeID = 0e076871-0b61-4673-8462-d06962028416
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_A = True
#. SetFlags:
#.   Local:
#.     - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels:0e076871-0b61-4673-8462-d06962028416
msgctxt "h9b0e96a8g776ag4fb0g81b6gde2d67b3f29b"
msgid "Nimble, where is my... oh."
msgstr "님블, 내 그거 어디... 음."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels
#. Speaker = Nickels
#. NodeID = 76b4c07b-9cef-4fe5-b07e-42d7b8598ea7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_B = True
#. SetFlags:
#.   Local:
#.     - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels:76b4c07b-9cef-4fe5-b07e-42d7b8598ea7
msgctxt "h2605655ag7eb1g4344gb65age47d73fabae0"
msgid "The stone is quiet. So why am I so sad?"
msgstr "돌이 조용해. 근데 나는 왜 이리 슬프지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels
#. Speaker = Nickels
#. NodeID = cf44fe17-37b9-405e-bfbd-0ecbed6c9818
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels:cf44fe17-37b9-405e-bfbd-0ecbed6c9818
msgctxt "hd06acba1g265cg404bga27dg2fce9d835b4d"
msgid "Why does my stomach hurt? Ah. I haven't eaten today."
msgstr "왜 배가 아프지? 아, 오늘 아무것도 안 먹었구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels
#. Speaker = Nickels
#. NodeID = e31c8c54-4295-489a-bab5-2cc647e17c35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_C = True
#. SetFlags:
#.   Local:
#.     - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_C = False
#.     - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_B = False
#.     - 8ab0520b-3a8d-822f-1934-336e2d24e0a0_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nickels:e31c8c54-4295-489a-bab5-2cc647e17c35
msgctxt "h27c2999dg30a6g4471g824fg45421806b6fb"
msgid "Nimble would be happy we did it. I should be happy."
msgstr "우리가 해낸 걸 봤다면 님블이 기뻐했겠지. 나도 그래야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble
#. Speaker = Nimble
#. NodeID = 167e8b52-bdf8-0123-7eab-05a8b2726294
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_C = True
#. SetFlags:
#.   Local:
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_C = False
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_A = False
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble:167e8b52-bdf8-0123-7eab-05a8b2726294
msgctxt "hc0abcc06gbcf8g40dagbe65gae9c49d16ba4"
msgid "Wulbren will get us to the city - I know it."
msgstr "울브렌이 우린 도시로 데리고 갈 거야- 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble
#. Speaker = Nimble
#. NodeID = 42136ed5-0fb0-46e4-9210-f00329cd2d2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#.   Local:
#.      - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_A = True
#. SetFlags:
#.   Local:
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble:42136ed5-0fb0-46e4-9210-f00329cd2d2d
msgctxt "h0a2ee63eg923bg4682ga6e1g73e28203b76f"
msgid "What will happen to the Ironhands now?"
msgstr "이제 아이언핸드 노움들은 어떻게 되는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble
#. Speaker = Nimble
#. NodeID = 4c9a1705-f613-46de-b24a-230fa274addb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#.   Local:
#.      - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_B = True
#. SetFlags:
#.   Local:
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_A = False
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble:4c9a1705-f613-46de-b24a-230fa274addb
msgctxt "h33fce1a6g4c91g4499g8677gd9f5b91afbb7"
msgid "I failed you, Wulbren. I failed the Ironhands."
msgstr "내가 널 실망시켰어, 울브렌. 아이언핸드 마저."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble
#. Speaker = Nimble
#. NodeID = 70e5059c-2426-402c-a37e-93e9a9880ed5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#. SetFlags:
#.   Local:
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble:70e5059c-2426-402c-a37e-93e9a9880ed5
msgctxt "hf7595e12ge4fdg4753gb97dge00c5a1c36cf"
msgid "Years of planning... for nothing."
msgstr "수년간의 계획이... 물거품이 됐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble
#. Speaker = Nimble
#. NodeID = a9f5186f-9458-f595-1313-ffb7074a945c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_B = True
#. SetFlags:
#.   Local:
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble:a9f5186f-9458-f595-1313-ffb7074a945c
msgctxt "h4bc5dc1dg5593g4a0eg9051g4d1fe667f8b0"
msgid "If only Nickels could see us now..."
msgstr "니클스가 지금 우리를 볼 수 있었다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble
#. Speaker = Nimble
#. NodeID = cac9f644-344e-004f-8cd4-687b35e01486
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble:cac9f644-344e-004f-8cd4-687b35e01486
msgctxt "h04eb6439g3abcg45d4g94b3g6423bca5cee3"
msgid "Supplies - sorted. Gear - repaired. All right."
msgstr "보급품 - 분류 완료. 장비 - 수리 완료. 좋았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble
#. Speaker = Nimble
#. NodeID = cca3e581-54d2-5edd-67cf-a32e58fb13b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_A = True
#. SetFlags:
#.   Local:
#.     - 3f91174f-4526-9d0a-ae1f-e2fdfdd464f6_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Nimble:cca3e581-54d2-5edd-67cf-a32e58fb13b9
msgctxt "h06a8db2ag66a8g4997gb464g8204e6d75645"
msgid "Nickels, have you seen my hammer - oh."
msgstr "니클스, 혹시 내 망치 봤어 -아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nimble
#. NodeID = 09bfa659-8ef4-4cd6-bdb9-0a541314cf3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 60fd5d70-5b4e-a402-a770-2f28f81d0d6d_A = False
#. SetFlags:
#.   Local:
#.     - 60fd5d70-5b4e-a402-a770-2f28f81d0d6d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:09bfa659-8ef4-4cd6-bdb9-0a541314cf3f
msgctxt "h4a3f8952g2c73g4962gafebg87207938f061"
msgid "You need to eat before we head off, all right?"
msgstr "출발하기 전에 꼭 뭘 먹도록 해, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nimble
#. NodeID = 23fd80df-ae26-4b66-97a1-6bc52a2d4688
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:23fd80df-ae26-4b66-97a1-6bc52a2d4688
msgctxt "h77f781degca8ag4448g8c05ge172eaa32225"
msgid "Do you have anything to eat?"
msgstr "먹을 거 갖고 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nickels
#. NodeID = 60f2a1f0-4d7a-4412-8f51-af2d7917d2a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:60f2a1f0-4d7a-4412-8f51-af2d7917d2a5
msgctxt "h77457c9fg40d8g4ccdg882eg9bb60d56aaab"
msgid "Yes."
msgstr "맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nickels
#. NodeID = 78ac1328-5c01-b09a-f54f-ce5027ff30f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:78ac1328-5c01-b09a-f54f-ce5027ff30f2
msgctxt "h56840978gc3e0g418fg86dbge65cffbda34e"
msgid "The stone says it is one floor down to the left."
msgstr "돌에는 왼쪽 방향 한 층 아래라고 쓰여 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nickels
#. NodeID = 7e92aec5-fc81-4227-a0e0-9ca2084541a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:7e92aec5-fc81-4227-a0e0-9ca2084541a3
msgctxt "h0cfd2ad1g357dg4f46gba8dgef127a62c2a7"
msgid "You are welcome."
msgstr "천만에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nickels
#. NodeID = 83986a54-6b9f-dc59-8117-217906af4e89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:83986a54-6b9f-dc59-8117-217906af4e89
msgctxt "h15458db2gf8bcg4a65gae7fg340a510c6756"
msgid "No."
msgstr "아니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nickels
#. NodeID = b86c6c2f-a2aa-43ab-8a92-4047b0a6b0d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:b86c6c2f-a2aa-43ab-8a92-4047b0a6b0d4
msgctxt "h8e253adfge149g4eaega2acgfabd7ad9762f"
msgid "The way is clear - the light has shown the way."
msgstr "빛이 보여줘서 길이 어딘지는 알고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nimble
#. NodeID = d844d10e-8803-4027-9e99-469658158c38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:d844d10e-8803-4027-9e99-469658158c38
msgctxt "h066c3e3bg2281g4a43ga715g7575a0b7b3e6"
msgid "Hah - thanks Nickels. And the stone."
msgstr "하-고맙다, 니클스. 돌맹이도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nimble
#. NodeID = e44fa337-ea37-4a9b-affd-f97b31339556
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 60fd5d70-5b4e-a402-a770-2f28f81d0d6d_B = False
#.     - 60fd5d70-5b4e-a402-a770-2f28f81d0d6d_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:e44fa337-ea37-4a9b-affd-f97b31339556
msgctxt "h2ba5bb52gd2adg4636g84acgd2a6d1e456c3"
msgid "Where did I leave that damn hammer?"
msgstr "망할 망치를 어디 뒀더라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nimble
#. NodeID = f190be40-cd68-4441-b160-2caa7d7840a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:f190be40-cd68-4441-b160-2caa7d7840a3
msgctxt "h2752b6acgff03g4e23g99a8g6348fef50752"
msgid "Good. The sooner we get out of here the better."
msgstr "좋아. 빨리 여기서 나갈 수록 좋지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels
#. Speaker = Nimble
#. NodeID = fa0e5ad1-149b-479b-a896-fd6895d1abb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 60fd5d70-5b4e-a402-a770-2f28f81d0d6d_B = False
#. SetFlags:
#.   Local:
#.     - 60fd5d70-5b4e-a402-a770-2f28f81d0d6d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_NimbleAndNickels:fa0e5ad1-149b-479b-a896-fd6895d1abb1
msgctxt "hdbf04a9fgcc89g423fg8a08g9d71e09d1451"
msgid "I'll sort you out for dinner. How does the stone read?"
msgstr "저녁은 내가 마련해 줄게. 돌에는 뭐라고 써 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi
#. Speaker = Umi
#. NodeID = 3195ee55-eba2-4caa-18ba-b07b5e1e5fc3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 55452e03-17c6-9a9d-072b-80043381c98b_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi:3195ee55-eba2-4caa-18ba-b07b5e1e5fc3
msgctxt "hc0024a46gd907g4b96gb1e1g4875513edf01"
msgid "Maybe I should ask the grown-ups to look for Mol again."
msgstr "몰을 찾아달라고 어른들에게 다시 부탁해야 할까 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi
#. Speaker = Umi
#. NodeID = 3c4082e7-31ae-054a-8732-d0a9a9cfe39a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#. SetFlags:
#.   Local:
#.     - 55452e03-17c6-9a9d-072b-80043381c98b_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi:3c4082e7-31ae-054a-8732-d0a9a9cfe39a
msgctxt "hce9eac24gbcf0g4935gbbfbg02f2bf38103b"
msgid "Mol is fine - she <i>promised </i>she would be."
msgstr "몰은 괜찮아- 그럴 거라고 <i>약속했거든</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi
#. Speaker = Umi
#. NodeID = 68031c1d-d8d6-ac04-369a-f34c5e1cec22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 55452e03-17c6-9a9d-072b-80043381c98b_B = True
#. SetFlags:
#.   Local:
#.     - 55452e03-17c6-9a9d-072b-80043381c98b_A = False
#.     - 55452e03-17c6-9a9d-072b-80043381c98b_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi:68031c1d-d8d6-ac04-369a-f34c5e1cec22
msgctxt "h5039ec53g8addg4b5agbd0ag4e044d169b92"
msgid "I miss Mol..."
msgstr "몰이 보고싶어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi
#. Speaker = Umi
#. NodeID = 803c8c20-8080-a688-ffd7-8edef0338285
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#.   Local:
#.      - 55452e03-17c6-9a9d-072b-80043381c98b_A = True
#. SetFlags:
#.   Local:
#.     - 55452e03-17c6-9a9d-072b-80043381c98b_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi:803c8c20-8080-a688-ffd7-8edef0338285
msgctxt "hd9209a47g2a09g4977g8477g6357d1e61db1"
msgid "I want to leave this stupid, creepy place."
msgstr "이 소름끼치고 재수 없는 곳에서 빨리 나가고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi
#. Speaker = Umi
#. NodeID = d98b2520-fa17-a10e-ef20-adb49de79a8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 55452e03-17c6-9a9d-072b-80043381c98b_A = True
#. SetFlags:
#.   Local:
#.     - 55452e03-17c6-9a9d-072b-80043381c98b_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Umi:d98b2520-fa17-a10e-ef20-adb49de79a8b
msgctxt "h1087af0dg510dg4e10g9242ge3c7b641496f"
msgid "Mol is gonna come through the doors, any moment now..."
msgstr "몰이 저 문을 열고 들어 올 거야, 조금만 있어 봐..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3a484fd4-19c3-42d4-8573-12673ef4ced1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_A = True
#. SetFlags:
#.   Local:
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome:3a484fd4-19c3-42d4-8573-12673ef4ced1
msgctxt "h40e4c2a6gbe43g4961g9b8bgfc977ea67112"
msgid "Curse this heart of mine."
msgstr "이 심장을 저주해 주시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3b957a6e-bc80-4f06-852a-dccd16e33a65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_B = True
#. SetFlags:
#.   Local:
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_B = False
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome:3b957a6e-bc80-4f06-852a-dccd16e33a65
msgctxt "h145754abg70b3g4e15gb3b2g9c683ead2e68"
msgid ""
"A thousand days of darkness on the Ironhands for dragging him into this."
msgstr "울브렌을 끌어들인 아이언핸드에게 천 일의 어둠이 내리길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4bd011a1-2cdf-4365-8134-be709785e943
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#.   Local:
#.      - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_A = True
#. SetFlags:
#.   Local:
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome:4bd011a1-2cdf-4365-8134-be709785e943
msgctxt "h6ecfa651g9a85g413cgb1b1gd800ce393b13"
msgid ""
"I should contact Wulbren's family - though they won't relish hearing from me."
msgstr "울브렌의 가족에게 알려야겠어. 나한테 듣는 걸 원하지 않겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 689d0557-179e-4789-92b2-8c11e7c37547
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome:689d0557-179e-4789-92b2-8c11e7c37547
msgctxt "h4a352b66gd937g4997ga4c6ga00008bf4bf5"
msgid "'Go home, Barcus', he says. Pah!"
msgstr "'집으로 돌아가, 바커스'라고 했지. 쳇!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c16d3cdc-c1c6-443c-9e31-537b50cac361
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#.   Local:
#.      - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_B = True
#. SetFlags:
#.   Local:
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_B = False
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome:c16d3cdc-c1c6-443c-9e31-537b50cac361
msgctxt "hde8064fbge3c1g4282g9e27gf4f2ab0717d6"
msgid "Oh, Wulbren. Why didn't you just <i>listen</i>?"
msgstr "오, 울브렌. 그냥 내 말 좀 <i>듣지</i> 그랬어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c721b357-ab85-4d13-bde7-89de638b77c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#. SetFlags:
#.   Local:
#.     - d3eb78cf-ff8c-1e7a-7df7-4b6a04226b17_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_UnfortunateGnome:c721b357-ab85-4d13-bde7-89de638b77c5
msgctxt "hbe9e9b24gf164g48b3g9688ge5218222191e"
msgid ""
"The city - yes, that's top priority. Wulbren's affairs need to be... "
"organised."
msgstr "물론 도시가 가장 중요하지. 울브렌에 대한 건... 좀 정리해 봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 55c4804c-3939-91db-a6fa-901f4eec1ec1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren:55c4804c-3939-91db-a6fa-901f4eec1ec1
msgctxt "h54fa1cb5g774ag4f9dga530g4a2d8a98d74d"
msgid "It's finally time for the Ironhand Gnomes to come <i>home.</i>"
msgstr "마침내 아이언핸드 노움이 <i>집</i>으로 돌아갈 시간이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7b7544c7-63a4-611b-6da6-f8132884143e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_GnomeFollowUp_Wulbren_State_AtStoneWork = True
#.   Local:
#.      - d2eeb9af-9d20-919f-5bcf-63b09a554a90_A = True
#. SetFlags:
#.   Local:
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren:7b7544c7-63a4-611b-6da6-f8132884143e
msgctxt "h6078bde3ge50ag48abga103g6622e536eebb"
msgid ""
"Perhaps the Ironhands could return here in the future - claim it as an "
"outpost?"
msgstr "어쩌면 나중에 아이언핸드가 여기로 돌아와서 주둔지로 차지할 수 있을지도?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 82c39884-1a3e-3d5b-af7a-4c1eebea8a73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d2eeb9af-9d20-919f-5bcf-63b09a554a90_B = True
#. SetFlags:
#.   Local:
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren:82c39884-1a3e-3d5b-af7a-4c1eebea8a73
msgctxt "h9b3bab76gb2f0g4c03g9511g0fa5909c17e0"
msgid "It's all coming together - I can hardly believe it."
msgstr "모든 게 원하던 대로 되고 있어 - 정말 믿을 수가 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 8caee829-f1d4-142e-7907-334e3c634ce7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d2eeb9af-9d20-919f-5bcf-63b09a554a90_C = True
#. SetFlags:
#.   Local:
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_B = False
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_C = False
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren:8caee829-f1d4-142e-7907-334e3c634ce7
msgctxt "hab11e453g3695g40d7ga82eg61f6c21194c4"
msgid "The Absolute has delayed my plans but only that - nothing changes."
msgstr "절대자 덕분에 계획이 조금 늦춰졌지만 변한 건 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c843e613-6695-8fbd-ebf5-75c58bb535da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_GnomeFollowUp_Wulbren_State_AtStoneWork = True
#. SetFlags:
#.   Local:
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren:c843e613-6695-8fbd-ebf5-75c58bb535da
msgctxt "h11d07865gd453g4a55gb59bg408c50f1d87b"
msgid "The stonework is sublime - it's almost a shame to leave this place."
msgstr "석조 공예 솜씨가 탁월해 - 떠나는 게 아쉬울 정도야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = caa50d17-a37a-61a3-6b47-62da331e68ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_GnomeFollowUp_Wulbren_State_AtStoneWork = True
#.   Local:
#.      - d2eeb9af-9d20-919f-5bcf-63b09a554a90_B = True
#. SetFlags:
#.   Local:
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_B = False
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren:caa50d17-a37a-61a3-6b47-62da331e68ef
msgctxt "h57b3b91dgb390g49ecgb446gf26fb0015220"
msgid ""
"Then again, these towers are much like the Absolute - all flash and no "
"substance."
msgstr "한편으론, 이 탑들은 마치 절대자 같아 - 실체만 있지 본질은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d970cb46-f7d4-0f10-852d-efd89e7417e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d2eeb9af-9d20-919f-5bcf-63b09a554a90_A = True
#. SetFlags:
#.   Local:
#.     - d2eeb9af-9d20-919f-5bcf-63b09a554a90_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_AD_Wulbren:d970cb46-f7d4-0f10-852d-efd89e7417e4
msgctxt "hb7ade7f5g366cg4bbbg8ec6gf4033c8ec826"
msgid "We will save Baldur's Gate - I know it."
msgstr "우린 발더스 게이트를 지킬 거야 - 틀림없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 01ca7e1d-3cdf-b30e-da19-3463ab8647be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:01ca7e1d-3cdf-b30e-da19-3463ab8647be
msgctxt "h4115ac19g38cbg4276g99e5g1ae989830dae"
msgid "Like I'm humouring you in this conversation?"
msgstr "지금 내가 네 기분을 맞춰주듯이?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 0bdc6968-1b95-476f-7776-d8d92f856929
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:0bdc6968-1b95-476f-7776-d8d92f856929
msgctxt "h39b19275gcf67g4b51g80a9geee1c02b0959"
msgid ""
"True - my instinct is to rush in and try to make everything better, you know?"
msgstr "맞아요 - 전 본능적으로 달려들어 뭐든 나아지게 하려는 편이에요, 아시죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 10337fb0-8609-01a9-40e6-8e3175df895a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Alfira_State_RequestedBard = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:10337fb0-8609-01a9-40e6-8e3175df895a
msgctxt "h3873b372g699eg42d9g84a4gde067b4a5f1d"
msgid ""
"I'm sure I'll find someone else  to play with - maybe in the city. Until "
"then, all I can do is be here for them."
msgstr "함께 연주할 누군가를 분명 찾게 되겠죠. - 도시에서라도요. 그때까지는 아이들과 함께 있어줄 수밖에 없겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 14634e94-0124-fda5-db1a-a4996de01137
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:14634e94-0124-fda5-db1a-a4996de01137
msgctxt "h1158980bgc6f3g439ag87ceg3f2354765a55"
msgid "Their friend is gone - give them time."
msgstr "친구가 사라졌잖아 - 시간을 좀 주는 게 어때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 17c4c9c4-3d1b-18f6-63ef-114ffd5867b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:17c4c9c4-3d1b-18f6-63ef-114ffd5867b8
msgctxt "h44b98274ge3bbg48d0ga4d3g7eacf3a460e2"
msgid "Thank you - you always know just what to say."
msgstr "늘 내가 듣고 싶은 말만 골라 해줘서 고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 1e53dab4-a14a-362e-ca6c-0fb4d0db0ad6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:1e53dab4-a14a-362e-ca6c-0fb4d0db0ad6
msgctxt "h3acb7afcgd599g4c12gac31g8eaf78c106bf"
msgid ""
"The kids have been really down - I figured a concert would cheer them up. Or "
"distract them, at least. What do you say?"
msgstr ""
"아이들의 기분이 정말 좋지 않았어요. 음악회를 열면 좋아하겠다는 생각이 들었죠. 적어도 기분 전환은 되잖아요. 당신 생각은 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 2337bacb-6a58-bc09-e765-ceaa22ecab54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:2337bacb-6a58-bc09-e765-ceaa22ecab54
msgctxt "h627c7981gc3e5g4b5eg956eg88d07b13143f"
msgid "It'd be like a private concert, just for them - they'd love it!"
msgstr "아이들만을 위한 전용 음악회 같은 거예요. 분명 좋아하겠죠!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 25d031f2-355d-44c7-26b2-b04d0c308976
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:25d031f2-355d-44c7-26b2-b04d0c308976
msgctxt "hf7393376g403fg4fcdg805bgd9deb724bd7e"
msgid ""
"Sorry, I didn't mean to snub you, I'm just worried about the kids. Mol is "
"still missing, and they haven't taken it too well."
msgstr "죄송해요, 꼽주려는 건 아니었어요. 아이들이 걱정돼서요. 몰이 아직도 실종 상태거든요. 애들도 그 때문에 힘들어 하고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 279b95d1-8004-9d71-029c-892b22f46ced
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Alfira_Event_RefusedShiningDawn(1) = True
#.   Global:
#.      - SCE_Alfira_State_RequestedBard = True
#.      - SCE_Alfira_Event_GaveShiningDawn = False
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:279b95d1-8004-9d71-029c-892b22f46ced
msgctxt "h6e568e3ega2bdg4776g9cc3g13ba94685f5d"
msgid "Sorry, now is not a good time - the kids need me."
msgstr "죄송해요. 지금은 안 되겠어요. 아이들에겐 당신이 필요해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 2b72ef11-7d83-4ad7-efc2-de6e699238d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:2b72ef11-7d83-4ad7-efc2-de6e699238d7
msgctxt "hb7ce130bgcf0fg4274gb82ag7524f2369a03"
msgid "Let's see what you've got."
msgstr "네 실력 좀 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 2d0a4468-47e6-be87-2985-dd8cba6f00d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:2d0a4468-47e6-be87-2985-dd8cba6f00d0
msgctxt "hf9c254dfgd4a8g47a3ga7d6gfc42cc134600"
msgid "No thanks."
msgstr "사양할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 33518868-72a7-0b46-7a0e-0e7c97a56711
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Alfira_Event_GaveShiningDawn = True
#.   Object:
#.     - SCE_TieflingFollowUp_Event_GiveShiningDawn(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:33518868-72a7-0b46-7a0e-0e7c97a56711
msgctxt "h30a6ac51g8ad7g46f9g9476g1cd55a759505"
msgid "Hah! Just try and keep up."
msgstr "하! 잘 따라오라고요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 33586616-0871-0b0b-1f71-f64fcf1d449d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:33586616-0871-0b0b-1f71-f64fcf1d449d
msgctxt "h7c46de88g9a6cg4c0dg9ba6gdd4ec7bb44d6"
msgid ""
"Exactly! They've never had time to <i>be</i> kids. And who knows when "
"they'll get a chance again..."
msgstr "맞아요! 진짜 애들처럼 <i>굴</i> 시간도 전혀 없었죠. 이런 기회가 언제 다시 찾아올지 누가 알겠어요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 351d0337-eecc-7267-add5-25cf06a1ac36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:351d0337-eecc-7267-add5-25cf06a1ac36
msgctxt "h6902a9deg38f3g4b99g924bgacb218866398"
msgid "Oh, oh! I have an idea - why don't we play together?"
msgstr "앗! 좋은 생각이 났어요. 같이 연주하는 건 어때요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 44ddfbef-2402-b47b-e1ed-045db5ca4ae5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_Alfira_State_RequestedBard = True
#.      - SCE_Alfira_Event_GaveShiningDawn = False
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:44ddfbef-2402-b47b-e1ed-045db5ca4ae5
msgctxt "hceb586adg61d1g4cd3ga3f0g56120fd6508f"
msgid ""
"Ah! A fellow bard. Sorry to ask out of the blue, but would you like to play "
"together?"
msgstr "앗! 바드 동료잖아. 갑자기 물어봐서 죄송한데, 같이 공연하지 않을래요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 47cd3193-9d5e-bbc6-1046-e9211efe8363
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:47cd3193-9d5e-bbc6-1046-e9211efe8363
msgctxt "h8df74916g709eg4787g829fg2e265455200f"
msgid ""
"Well, brainy-breeches, I did have a better idea - a private concert, just "
"for the kids! Alas, you're no bard."
msgstr "이봐요, 똑똑 씨, 제게 더 좋은 생각이 있어요. 아이들만을 위한 음악회 어때요? 아참, 당신은 바드가 아니군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 4e0b5e57-5409-cb81-3bda-d05f59cbc593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:4e0b5e57-5409-cb81-3bda-d05f59cbc593
msgctxt "hf6490433g6d4eg476cg9972ge7294f49eb7a"
msgid ""
"I've been trying to cheer them up, but I think they're just humouring me..."
msgstr "아이들 기분을 좀 띄워주려고 노력 중인데, 걔들이 그냥 제 기분을 맞춰주고 있는 것 같아요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 5025fd78-0d4d-1de3-53ec-2942dd96b3b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:5025fd78-0d4d-1de3-53ec-2942dd96b3b4
msgctxt "h6c4375d3gc32eg4ff8g8448g286154b6c9ba"
msgid "Are you all right?"
msgstr "너 괜찮니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 52b421e0-e23c-726c-2d9b-bbb77daf0835
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:52b421e0-e23c-726c-2d9b-bbb77daf0835
msgctxt "h69736950g9bacg409fga085g256101948b2c"
msgid "But you're right - I should give them some space."
msgstr "하지만 당신 말도 맞아요. 아이들에게 시간을 좀 주는 것도 좋겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 57388ff6-8945-b28e-3d0e-56b68b7eff48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:57388ff6-8945-b28e-3d0e-56b68b7eff48
msgctxt "hf0726094g8e0eg48acgaa95g196344c074f7"
msgid ""
"Well, brainy-breeches, I have a better idea, and I'm so glad you volunteered "
"to help."
msgstr "이봐요, 똑똑 씨, 제게 더 좋은 생각이 있어요. 당신이 자원해서 돕겠다니 너무 기쁜걸요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 5af65cab-e3f3-d44a-1691-9ee5a5348270
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:5af65cab-e3f3-d44a-1691-9ee5a5348270
msgctxt "h886a5ef5gabf3g4ff5g94e9g631806cc2fd9"
msgid "You and me, battling it out - bard to bard. What do you say?"
msgstr "당신이랑 저랑 대결을 하는 거예요. 바드 대 바드로요. 어때요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 5cd5814f-36c6-e0c5-5513-70aed291ea3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:5cd5814f-36c6-e0c5-5513-70aed291ea3f
msgctxt "he48fe362g63c5g4ed1gb442g008a6d265742"
msgid ""
"Maybe... I'd love to put on a show - just for them. But it's boring if I'm "
"the only one playing."
msgstr "그럴지도요... 아이들만을 위한 공연을 당장 하고 싶지만... 저만 연주한다면 분명 지루할 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 62996481-7a4f-b543-d97b-a75d5ae90165
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:62996481-7a4f-b543-d97b-a75d5ae90165
msgctxt "h47510749g15cag406cg94e2g6e0f9f9aa0a5"
msgid "I just killed an immortal, and that's all you have to say?"
msgstr "방금 불멸자를 죽였는데, 할 말이 고작 그거니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 69dce37e-74a2-6366-1389-19be41ce840f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:69dce37e-74a2-6366-1389-19be41ce840f
msgctxt "hf62e875eg83c5g4e0fga1e3g6b5df2bebc5a"
msgid "Keep trying - they need some fun right now."
msgstr "계속 노력해 봐 - 뭔가 재밌는 일이 필요한 때니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 6fd6ed03-8f46-b7f6-7eb1-b4c87107cee1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:6fd6ed03-8f46-b7f6-7eb1-b4c87107cee1
msgctxt "h3a6532f6g56deg4fe0g9beagc80a6df715c9"
msgid ""
"I've been trying to cheer them up, we're writing a song together. But I "
"think they're just humouring me..."
msgstr ""
"아이들의 기분을 띄우려고 노력 중이에요. 같이 노래도 하나 쓰고 있죠. 근데 걔들이 그냥 제 기분을 맞춰주고 있는 것 같아요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 7c5915a8-3589-c0c6-2545-834036591c21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:7c5915a8-3589-c0c6-2545-834036591c21
msgctxt "h8291125bg31e2g44b5g910eg2257dbf8edff"
msgid "Writing a song is hardly going to distract them."
msgstr "노래를 쓴다고 기분 전환이 될 리가 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = 7e137a4d-c08c-cc53-63c5-95daf0881efc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:7e137a4d-c08c-cc53-63c5-95daf0881efc
msgctxt "h7212b868g658ag429bg993ag92d2e17a25c1"
msgid "I was expecting a little more enthusiasm."
msgstr "좀 더 열렬히 반겨주길 기대했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 89edb756-398c-dc94-de3f-904682673966
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Alfira_State_RequestedBard = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:89edb756-398c-dc94-de3f-904682673966
msgctxt "h9fd3d350ge099g4b49ga91cg6d9afee587ba"
msgid ""
"I need another bard - maybe I'll find one in the city. Until then - the kids "
"and I shall work on our masterpiece!"
msgstr "다른 바드가 필요해요. 도시에서는 만날 수 있을지도 몰라요. 그때까지는 아이들과 명곡 작업에 몰두해야겠어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 911c7b65-4e5c-c51c-2993-2e800ab84e2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:911c7b65-4e5c-c51c-2993-2e800ab84e2c
msgctxt "h51df787egc2d2g4516g8928gde852347616f"
msgid ""
"You and me performing, a private concert - just for the kids. They'd love "
"it, I'm sure!"
msgstr "당신과 제가 아이들만을 위한 음악회를 여는 거죠. 분명 좋아할 거예요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = 9b4ebc56-da48-ab07-5b66-1894a40760bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:9b4ebc56-da48-ab07-5b66-1894a40760bf
msgctxt "h7c0ab758g14b2g4b21g9341gf4c61cf8076a"
msgid ""
"True. You know what would be amazing? A concert - just for the kids. Problem "
"is, it's boring if it's just me playing."
msgstr ""
"맞아요. 진짜 멋진 일이 뭔지 아세요? 바로 음악회예요. 아이들만을 위해서 여는 거죠! 문제는 저만 연주하면 무척 지루하단 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = a43d7d79-91b5-75f6-da75-f59c0ec76ec4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_AlfiraTale_HasMet(1) = True
#.   Global:
#.      - SCE_Alfira_State_RequestedBard = True
#.      - SCE_Alfira_Event_GaveShiningDawn = False
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:a43d7d79-91b5-75f6-da75-f59c0ec76ec4
msgctxt "hd1c16ad4gec9cg4876gb14fga830ed43659d"
msgid ""
"I hope I'll find a bard in the city. The kids would love a little show, I'm "
"sure of it!"
msgstr "도시에서 바드를 찾게 되면 좋겠네요. 공연을 하면 아이들이 분명 무척 좋아할 거예요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = bc1b0097-f002-51b7-9ab1-73919c3e4af1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_Alfira_Event_GaveShiningDawn = True
#.   Object:
#.      - SCE_TieflingFollowUp_Event_GiveShiningDawn(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:bc1b0097-f002-51b7-9ab1-73919c3e4af1
msgctxt "h2db2e75fgdb38g462bg88cag373f63d96cb0"
msgid ""
"You're lucky to be travelling with such a talented musician - I hope I run "
"into you both in the city."
msgstr "그런 재능있는 음악가와 함께 여행하는 게 행운인 줄 알아요. 도시에서 당신 둘을 다시 만나면 좋겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = bf7aa090-b69a-1af9-0d21-2bc3b52b78e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_Alfira_Event_RefusedShiningDawn(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:bf7aa090-b69a-1af9-0d21-2bc3b52b78e4
msgctxt "hc213c471g9661g434cg878bg0744ac95f859"
msgid "Oh, I thought... all right. No problem."
msgstr "아, 전 당신이... 알았어요. 괜찮아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = c02f6776-923c-a0f3-0466-76fe7060176c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:c02f6776-923c-a0f3-0466-76fe7060176c
msgctxt "h7cdbf752gdf90g4a87g9a25g173a4fd7d887"
msgid "Like I'm humouring you by having this conversation?"
msgstr "지금 내가 네 기분을 맞춰주듯이?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = c37644fc-a5ac-d537-19ae-5076ffde1737
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Alfira_Event_GaveShiningDawn = True
#.   Object:
#.     - SCE_TieflingFollowUp_Event_GiveShiningDawn(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:c37644fc-a5ac-d537-19ae-5076ffde1737
msgctxt "h9bb6a821gade9g4b87g823dgaa1b1ffa1933"
msgid "Yes! I've missed this. If you can't keep up, don't take it to heart."
msgstr "좋아요! 이 기분 정말 그리웠어요. 절 따라오지 못하겠더라도 너무 속상해 하지 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = c75fefa1-54b1-5333-80dc-cc7dd048c6b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:c75fefa1-54b1-5333-80dc-cc7dd048c6b8
msgctxt "h14c852e2g77ecg4d23gad60geb14b7e1ac78"
msgid "You know what, you're right. So let's give them a real show, shall we?"
msgstr "당신 말이 맞아요. 아이들에게 진짜 공연을 보여주자고요, 어때요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = c8962814-bc23-2597-e5ff-300c812bdd43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:c8962814-bc23-2597-e5ff-300c812bdd43
msgctxt "hef6a2e20gdcbeg4f09gaf2ag3720641ba577"
msgid ""
"Sorry, I'm just worried about the kids. Mol is still missing, and they "
"haven't taken it too well."
msgstr "죄송해요, 아이들이 걱정돼서 그랬어요. 몰이 아직도 실종 상태거든요. 그 때문에 아이들도 힘들어 하고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = c951e57b-9784-ee97-82c7-eb58250ea2f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:c951e57b-9784-ee97-82c7-eb58250ea2f0
msgctxt "ha70eb8cdg8b0ag4f80g96cbgc2e143a01d7b"
msgid "I'm sure they appreciate it."
msgstr "아이들도 분명 고맙게 생각하고 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = c9f8cf77-2d5a-e16b-61ef-60269de0103f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_AlfiraTale_HasMet(1) = True
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:c9f8cf77-2d5a-e16b-61ef-60269de0103f
msgctxt "h6a68facbg1879g4feaga34dg72eac40a6ba5"
msgid "I'll keep an eye on the kids, don't you worry."
msgstr "제가 아이들을 지켜볼게요. 당신은 걱정 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = ca337ac8-4ce4-389f-4e44-253b015ce2f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:ca337ac8-4ce4-389f-4e44-253b015ce2f5
msgctxt "hd7132ddcg2a5bg4a51g9a4egcee3468e0c1c"
msgid "Rude as ever I see. Don't know why I bother."
msgstr "변함없이 무례하군요. 제가 뭐하러 귀찮게 하나 싶네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = d023f338-72c9-22c2-4cdd-9a9529fc59d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_Alfira_Event_GaveShiningDawn = True
#.   Object:
#.      - SCE_TieflingFollowUp_Event_GiveShiningDawn(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:d023f338-72c9-22c2-4cdd-9a9529fc59d8
msgctxt "he6103663g48c4g41cbgaf48gaea31cf66375"
msgid ""
"That was a blast - thank you! I hope we get to play again sometime soon."
msgstr "졍말 신났어요. 고마워요! 조만간 또 함께 연주할 수 있으면 좋겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Player
#. NodeID = e7b0f112-720b-8f19-4758-c79fcd83a6c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:e7b0f112-720b-8f19-4758-c79fcd83a6c9
msgctxt "h9a2184a2gca70g4f59ga16bgb77b7c4c135c"
msgid "Sure. Ready when you are."
msgstr "물론이지. 너만 준비되면 시작해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = f1b46334-1b8d-cf6e-8221-ba4ecd371f8f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_AlfiraTale_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:f1b46334-1b8d-cf6e-8221-ba4ecd371f8f
msgctxt "h7fabf423g057eg4b58g8cedg97abf78964b8"
msgid "You're here! Good... that's good."
msgstr "오셨군요! 좋아... 잘됐어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira
#. Speaker = Alfira
#. NodeID = f81c30b0-18e5-d6d3-bcae-a307e305c3a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Alfira:f81c30b0-18e5-d6d3-bcae-a307e305c3a8
msgctxt "h0d61ce50gedd1g46e4g9d8fg6defb9417930"
msgid ""
"Me? Oh, I'm fine. I'm just worried about the kids. Mol is still missing, and "
"they haven't taken it too well."
msgstr "저요? 아, 전 괜찮아요. 아이들이 걱정돼서 그랬어요. 몰이 아직도 실종 상태거든요. 그 때문에 아이들도 힘들어 하고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 01c0f6cc-b143-f1ed-c630-9119b6dc6a3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:01c0f6cc-b143-f1ed-c630-9119b6dc6a3a
msgctxt "hd4133747g6eb7g4ce7gb9b5g9dc762c71867"
msgid "Zevlor let you down - but he did his best."
msgstr "제블로어는 널 실망시켰지만 최선을 다했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 03373100-4405-4e69-afe4-800e3b3c6778
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_Event_ReleasePods = True
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:03373100-4405-4e69-afe4-800e3b3c6778
msgctxt "hfc834f11g9e62g40a9gb344g4f98ac6a07d9"
msgid ""
"I freed Zevlor from the colony. I wouldn't be surprised if he made it out."
msgstr "내가 제블로어를 군락에서 구해줬어. 살아서 빠져나왔어도 이상하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 0888c235-6207-1e9e-703f-bbc7e57536d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:0888c235-6207-1e9e-703f-bbc7e57536d3
msgctxt "hd15c9377gc825g4ffbgb0b4gef799507d6da"
msgid ""
"If I had coin, I wouldn't be travelling overland through a cursed warzone."
msgstr "내가 가진 돈이 있다면, 이렇게 저주받은 전쟁터 위를 헤매고 있겠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 113b1e1b-bf1d-969d-f6c7-7450dffebc75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:113b1e1b-bf1d-969d-f6c7-7450dffebc75
msgctxt "h25d71c4dgb2e8g4857ga471g9c2c8c604d5a"
msgid ""
"There are less mouths to feed now, but we still need supplies for the road. "
"We'll scavenge what we can."
msgstr "이젠 먹일 입도 줄었어, 그래도 길에서 사용할 보급품은 아직 필요해. 할 수 있는 만큼 모아 봐야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 2c6e3681-e726-00ad-9f32-c5437fc5c5cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:2c6e3681-e726-00ad-9f32-c5437fc5c5cc
msgctxt "h3d456bcbge2eag4505g89ffg8f1d49199846"
msgid "I'll give you a pass for now, but you owe me."
msgstr "당장은 그냥 넘어가겠지만, 나한테 한 번 빚진 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 4348a56b-2fcf-cc43-e808-dd85d02b9400
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:4348a56b-2fcf-cc43-e808-dd85d02b9400
msgctxt "h301c582ag09b1g4fb3gadf4g3b6147154eb4"
msgid "True enough. He wouldn't follow me into battle."
msgstr "맞는 말이야. 날 따라 전쟁터로 오진 않았겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 45a1fa65-5ec3-293a-0b15-d04034dd145e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:45a1fa65-5ec3-293a-0b15-d04034dd145e
msgctxt "h3a94bc30ga6a7g4011g90c4g9cbe9b001690"
msgid ""
"But the best leaders know they're only as good as the people around them. "
"Zevlor told me that."
msgstr "하지만 우수한 지도자는 자신의 역량이 주변 사람들에게 달려있단 걸 알지. 제블로어가 해줬던 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 4982b7d1-54e4-8252-f590-89a791cd972b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_TadpolingCentre_Event_ReleasePods = True
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:4982b7d1-54e4-8252-f590-89a791cd972b
msgctxt "h0ff02d55ge3ceg41c3gb3b0g752da1f3788e"
msgid ""
"I freed Zevlor down in the colony.  I wouldn't be so quick to write him off "
"as dead."
msgstr "전에 내가 제블로어를 구해줬었어. 그를 죽었다고 여기며 섣불리 단념하지 않았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 57f7baac-2d55-d626-079d-f6c78add9666
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:57f7baac-2d55-d626-079d-f6c78add9666
msgctxt "hd0ebbe52gbc4ag4e6bgb121g1e7ccf313d78"
msgid "I couldn't have done it without Jaheira, and the Harpers."
msgstr "자헤이라와 하퍼들이 없었다면 해내지 못했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 5e63f5ce-27e9-742e-1a73-27c71f71d3c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:5e63f5ce-27e9-742e-1a73-27c71f71d3c8
msgctxt "hcb84f08egdab3g425cg89d6g4f2c9f8bcb5a"
msgid ""
"Turns out the people around him were better than him. Guess he got what was "
"coming to him."
msgstr "알고 보니 주변 사람들이 그보다 뛰어나더군. 그는 마땅한 운명을 맞이한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Narrator
#. NodeID = 6b2b8a5b-46d6-06f1-215f-21e20fdb06e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:6b2b8a5b-46d6-06f1-215f-21e20fdb06e1
msgctxt "h170af1f1g29cbg4259g9373g6a113b987128"
msgid "*The briefest hesitation, as Cerys wars with old loyalties. And wins.*"
msgstr "*세리스가 케케묵은 충성심과 싸우며 아주 잠시 망설입니다. 그리고 결국 이깁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 6c5afba7-db83-d78e-a708-ecec0bda97cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:6c5afba7-db83-d78e-a708-ecec0bda97cb
msgctxt "h380632e2g2c6eg45fegbd47g9d769d9bc3ed"
msgid "I'm just glad you're safe."
msgstr "네가 무사해서 기쁠 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 7843c09a-807e-0c52-e999-fd1302ae317a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:7843c09a-807e-0c52-e999-fd1302ae317a
msgctxt "h6c6db02bg5db8g4453g9c5cgdbe10cfa2aff"
msgid "If you ever need help again - ask somebody else."
msgstr "또 다시 도움이 필요하게 되면 - 다른 사람에게 부탁해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 789e5ee4-482f-0f34-d3f6-d41eaca75ebb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:789e5ee4-482f-0f34-d3f6-d41eaca75ebb
msgctxt "h9d3db0c8g9b94g4ed2g878fged3e48f7511b"
msgid ""
"I looked up to him - we all did. But he let us down when we needed him most."
msgstr "나는 제블로어를 존경했어 - 우리 모두 그랬지. 하지만 가장 절실할 때 그는 우릴 저버렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 7ed90146-05af-20cc-dd93-7e3e2278769b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:7ed90146-05af-20cc-dd93-7e3e2278769b
msgctxt "h6960580cgcce9g4797g8818g8c838a4998f0"
msgid "I wouldn't be so sure Zevlor's dead."
msgstr "나라면 제블로어의 죽음을 단정짓지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 8826be1d-904d-f3d3-90e2-c14b6af77903
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: ROGUE
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:8826be1d-904d-f3d3-90e2-c14b6af77903
msgctxt "hb07da730gf16dg4560g9bb2g422e3fce9cdf"
msgid ""
"I'm glad we agree it was a job - I don't tend to do those for free, you know."
msgstr "우리 둘 다 이게 '일'이라는 데 동의하고 있다니 기쁘군 - 내가 무료 봉사는 하지 않는다는 거 너도 알지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = 8826be1d-904d-f3d3-90e2-c14b6af77903
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:8826be1d-904d-f3d3-90e2-c14b6af77903
msgctxt "h5d37a1cdg9bf6g460dg959fg4e833d6edcd9"
msgid "People get paid for doing jobs - cough up the coin."
msgstr "사람들은 일을 하면 돈을 받아 - 동전을 좀 뱉어 놓으시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 88db926e-9ca9-023f-f3ac-0cb6e40f277d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:88db926e-9ca9-023f-f3ac-0cb6e40f277d
msgctxt "h1f334436g5fe3g4ed9ga3f0gd9d1a368076a"
msgid ""
"It might not last. They looked up to Zevlor too - until he left them for "
"dead. Guess he got what was coming to him."
msgstr ""
"그리 오래 가지 않을 거야. 사람들을 죽게 내버려 두고 떠나기 전까진 다들 제블로어를 존경했지. 그가 마땅한 운명을 맞은 걸지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 8ccfb12b-2ab3-3723-8358-a91ca9553789
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_BackupLeader_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_BackupLeader_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:8ccfb12b-2ab3-3723-8358-a91ca9553789
msgctxt "h4c67cecegc8c1g405dg8833gef4b18fa6e20"
msgid ""
"Back in Last Light, I was racking my brains - how the hells do we get past "
"the curse?"
msgstr "최후의 빛 여관에 있을 때 골똘히 생각해 봤는데, 우리가 대체 어떻게 그 저주를 통과했던 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = 9db30ea5-7c04-9ca6-8289-336965cbc17d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:9db30ea5-7c04-9ca6-8289-336965cbc17d
msgctxt "h06ba82abgde86g44c7g9b3bgf86747b8ff1b"
msgid ""
"Didn't think we'd make it without the old Hellrider to lead us. But you did "
"a damn fine job."
msgstr "지옥기수의 도움 없이 성공할 거라곤 생각 못했는데. 네가 일을 기가 막히게 처리했더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = a554cb4e-8983-bab9-f470-de83a4a29c9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:a554cb4e-8983-bab9-f470-de83a4a29c9d
msgctxt "h704092cdgbe2ag4061g8d46ga45096518331"
msgid "You're too humble."
msgstr "지나치게 겸손하게 구는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = a5a8d356-6a6b-dcfc-a685-72c52c88638e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_TieflingFollowUp_Cerys_HasMet_Angry(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:a5a8d356-6a6b-dcfc-a685-72c52c88638e
msgctxt "hdedc9e78g349fg4d61g871bg5831b3cb2f54"
msgid ""
"You're worse than Zevlor - at least he didn't put a price on our survival."
msgstr "넌 제블로어보다 더한 놈이구나 - 적어도 그는 우리 생존에 값을 매기진 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = b9409f86-025c-1825-a151-aa6cd9431fd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:b9409f86-025c-1825-a151-aa6cd9431fd7
msgctxt "h06bdd9f8gb2ffg49fcga012g132cd6af872a"
msgid "Only joking - my good heart will be the death of me one day."
msgstr "농담이야 - 난 너무 착해 빠져서 언젠가 된통 당할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = babdc5c8-1c9a-65e5-42b9-ba0cf2ac9ef7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:babdc5c8-1c9a-65e5-42b9-ba0cf2ac9ef7
msgctxt "hd4fe4ecfg65d1g4a1fga673g7c79e1b40b98"
msgid "You're better off without Zevlor - good riddance."
msgstr "제블로어는 없는 게 더 나아 - 후련하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = bd4013c4-cef3-462c-a678-2fc86d15791f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:bd4013c4-cef3-462c-a678-2fc86d15791f
msgctxt "h738b80bagcdb0g4c04gac49g4a98ddafc68d"
msgid "You deserve some of the credit - they look up to you."
msgstr "너의 공도 칭찬 받아 마땅해- 사람들은 널 우러러보고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = be91118e-49ea-c1e3-fe8d-464e8f61a0c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:be91118e-49ea-c1e3-fe8d-464e8f61a0c6
msgctxt "hb617ccf0g3375g4414g9615ga1677c816eb7"
msgid "Good riddance."
msgstr "잘 된 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = c0d42861-e662-b7e9-29ae-0809dbfc1ac2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:c0d42861-e662-b7e9-29ae-0809dbfc1ac2
msgctxt "heb1877f0g040dg4365g9e05gb18aa18c5c10"
msgid ""
"I won't feel safe until we're behind city walls. With Zevlor gone, it's up "
"to me to make sure the survivors reach Baldur's Gate."
msgstr ""
"도시의 성벽에 도달할 때까진 안심할 수 없을 거야. 제블로어도 가버렸으니, 생존자들을 발더스 게이트로 이끄는 것도 다 내 책임이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = c33ed35d-ef61-3236-5615-d269522ef232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:c33ed35d-ef61-3236-5615-d269522ef232
msgctxt "h81555448g7a63g48d0g9da7g67d388ebddad"
msgid "I would. He didn't have any fight left in him."
msgstr "글쎄. 그에겐 싸울 의지가 전혀 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = c4b3519a-2fbf-33f3-6400-222a4e764028
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:c4b3519a-2fbf-33f3-6400-222a4e764028
msgctxt "h24fc8d3bgaa10g4f9egbff3g461a83c5ff00"
msgid "You shouldn't speak ill of the dead - Zevlor did his best."
msgstr "고인을 모욕해선 안 돼 - 제블로어는 최선을 다했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = c770aa2e-aa0e-75d0-49e0-62682661bebe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_BackupLeader_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:c770aa2e-aa0e-75d0-49e0-62682661bebe
msgctxt "hb164369cg20f0g447eg8308g7989cb1a8cc8"
msgid ""
"Baldur's Gate lies ahead, we just need to avoid an army, the remnants of the "
"curse, and whatever else wants to eat us alive."
msgstr "발더스 게이트가 앞에 있어. 부대 하나, 남아 있는 저주, 그리고 우릴 산 채로 먹으려고 드는 그 밖의 것들만 피하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = d14d5038-c6d5-aa7d-4ef2-a129a0adcbc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:d14d5038-c6d5-aa7d-4ef2-a129a0adcbc7
msgctxt "h2953ce2age906g4a07ga5e2g1bf73b7e1db7"
msgid "I wish things had ended differently for him."
msgstr "그가 다른 운명을 맞이했길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = d3b9d4f7-7041-5930-725f-c855da284b82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:d3b9d4f7-7041-5930-725f-c855da284b82
msgctxt "h5b72adcfga7a6g478agb73aga327dc513f1d"
msgid ""
"I'm going to scavenge what supplies I can to make sure my people are fed on "
"the road."
msgstr "사람들이 길에서 굶지 않게 챙길 수 있는 뭐라도 있나 뒤지러 가보겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = d724ca9a-259a-cfba-43cc-c62108420759
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:d724ca9a-259a-cfba-43cc-c62108420759
msgctxt "h25bb6fd9g6b6dg411fga183gb08ac2087b11"
msgid ""
"And then, a blinding light cuts through the darkness, like a blade through "
"butter. All thanks to you, I hear."
msgstr "그러고 나서 눈부신 빛이 마치 버터를 자르는 칼날처럼 어둠을 가로질렀지. 듣기론 모두 네 덕분이었다던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = e09ac780-8510-aa9e-c3d8-fd11683d4d8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:e09ac780-8510-aa9e-c3d8-fd11683d4d8d
msgctxt "h1383160dg97b3g4376g8c0dg44ebb6e46973"
msgid "<i>Let it lie.</i>"
msgstr "<i>거짓말을 하게 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = e1a4837d-59c7-892e-2d42-376fc415d50d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:e1a4837d-59c7-892e-2d42-376fc415d50d
msgctxt "h3255ad4bg052bg4c09ga5a9gbb1d17925f43"
msgid "Hopefully we'll see you again in the city."
msgstr "도시에서 다시 만나길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = f0eaf070-6d01-477f-605a-0d6cf0daf583
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:f0eaf070-6d01-477f-605a-0d6cf0daf583
msgctxt "h1c12a012g43f2g4bf9ga512g7251a8c000b8"
msgid "I hope not. Good hearts deserve long lives."
msgstr "안 그러길 바라. 착한 사람은 상을 받아야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = f1a30899-16e0-fe34-5ccf-1f207ec85fb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:f1a30899-16e0-fe34-5ccf-1f207ec85fb4
msgctxt "h34fdca84gcae2g4526g88e1g581f72b4108a"
msgid "Nightsong's the real hero here - she was the light in the darkness."
msgstr "진짜 영웅은 밤의 노래지 - 어둠 속의 빛 그 자체였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Cerys
#. NodeID = f5a6aa14-99c0-5939-c49e-1f314d50e352
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_BackupLeader_HasMet(1) = True
#.      - SCE_TieflingFollowUp_Cerys_HasMet_Angry(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:f5a6aa14-99c0-5939-c49e-1f314d50e352
msgctxt "h1b07e06cg627cg4912g8272g26a4c8c23c82"
msgid ""
"Clear off. I have enough friends to help me survive the road - I don't need "
"mercenaries."
msgstr "꺼져. 도로에서 살아남도록 도울 친구는 이미 많아 - 용병은 필요 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys
#. Speaker = Player
#. NodeID = f97527f5-7e35-58ca-609c-71ef5164f286
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Cerys:f97527f5-7e35-58ca-609c-71ef5164f286
msgctxt "h2017c7a1gc663g4c3cg843dg3f602758f5fe"
msgid "He went his own way. I don't think he could face me - or all of you."
msgstr "자기 길을 택한 거야. 생존자들이나 내 얼굴을 똑바로 쳐다 볼 수 없었겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 03fed373-f21e-e5fd-34df-d0bc984366fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:03fed373-f21e-e5fd-34df-d0bc984366fc
msgctxt "h1337012eg3478g4bd4gad01g4b6bfea09c96"
msgid "Ketheric was never my concern - I wanted to help Thaniel."
msgstr "케서릭은 내 알 바가 아니었고 - 테니엘을 돕고 싶었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 04628f78-ed4f-05bd-d0f1-d3d201a6d212
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:04628f78-ed4f-05bd-d0f1-d3d201a6d212
msgctxt "hed24cff0gc156g433fg9d9ag84b3a256be56"
msgid "What about you?"
msgstr "너는 어쩌려고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 050c3b08-e7cf-0242-c76b-78ed5fdbd6e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:050c3b08-e7cf-0242-c76b-78ed5fdbd6e8
msgctxt "h124a4f99gb81fg4ab8g84dfgdc27d214bf91"
msgid ""
"Duke Eltan would be proud of what the order has become. A pity they cannot "
"spare the resources to help you with Thaniel."
msgstr "엘탄 공이 용병단의 현재 모습을 본다면 자랑스러워하겠지. 테니엘을 위해 내줄 수 있는 여력이 없다니 아쉽구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 0523ab89-8211-03ae-b320-b78bcfebcfd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#.      - SCE_AncientFist_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:0523ab89-8211-03ae-b320-b78bcfebcfd3
msgctxt "hc1a993aeg7784g4255gba53g916716ba5f95"
msgid "Thank you, my friend. Maybe we'll meet again, in another life."
msgstr "고마워, 나의 친구여. 다른 생에서 다시 만날 수 있길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 06530dcd-bc6d-3867-0962-6a5c9fad1279
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:06530dcd-bc6d-3867-0962-6a5c9fad1279
msgctxt "h93ab6e5ega35bg494fg932cgb9decaa44d83"
msgid "I heard about the Dead Three. And, more importantly, Duke Ravengard."
msgstr "삼악신에 대해 들었어. 그 보다 더 중요한 레이븐가드 공에 대해서도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 0b4948c0-57bc-3e95-fabb-0b75dc3df570
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:0b4948c0-57bc-3e95-fabb-0b75dc3df570
msgctxt "hc79fe9c4gdda6g4780ga01dg4619af0020c2"
msgid "You don't have to worry about me."
msgstr "내 걱정은 하지 않아도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 0ff01d3b-8d0f-f676-2ec4-bd35ab2717a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:0ff01d3b-8d0f-f676-2ec4-bd35ab2717a5
msgctxt "h36074d6ag65f1g499egbf1fgc8c8789a5361"
msgid "You're alive - isn't that something to be grateful about?"
msgstr "지금 살아 있잖아 - 감사해야 할 일이지 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 11272064-f239-80f7-f1fc-18f5879ebc87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = False
#.      - GLO_LiftingtheCurse_State_ThanielReleased = True
#.      - SCE_AncientFist_HasMet_Epilogue = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:11272064-f239-80f7-f1fc-18f5879ebc87
msgctxt "h26be0f9fg67e8g4aaeg84b2g046d616fcece"
msgid "Don't worry about me, please focus on saving Thaniel."
msgstr "내 걱정은 말고, 테니엘을 구하는 데 집중해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 11d5ce64-ac7e-cbda-2e48-4e9548670dd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:11d5ce64-ac7e-cbda-2e48-4e9548670dd0
msgctxt "h475fc346ga78fg4349ga18cgbcfa46a28ccb"
msgid ""
"So consider this a dying man's wish. Help Duke Ravengard... save the city. "
"Please."
msgstr "망자의 소원이라 생각하고 레이븐가드 공을 도와줘. 도시를 구해줘. 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 1a4497f3-ce60-4a7d-30b2-b443f991a2c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:1a4497f3-ce60-4a7d-30b2-b443f991a2c9
msgctxt "hb4c42eb8gdd01g4c73gacbdgc75e09bfa8f0"
msgid "It's only fair I stay here and wait for him to awaken."
msgstr "여기 남아 그가 깨어나길 기다려야 공평하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 2336fa86-61ad-8801-3f47-f8bf98675793
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:2336fa86-61ad-8801-3f47-f8bf98675793
msgctxt "hc2f3730bgb18ag4ee0ga82ag0c9bc9a6c7c0"
msgid "How did you make it here?"
msgstr "넌 어쩌다 여기 오게 된 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 28ee1edf-80a1-2024-fbaf-a49df9625678
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:28ee1edf-80a1-2024-fbaf-a49df9625678
msgctxt "h7d05fb9dgde62g4ffagba17g77d3b5508ad5"
msgid "Maybe. I don't know what this Duke Ravengard is like."
msgstr "그런가. 레이븐가드 공이 어떤지는 나도 잘 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 3102ffb7-d733-42f1-4154-5164daacf60a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinInShadowfell = True
#.      - SCE_AncientFist_HasMet_Epilogue = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:3102ffb7-d733-42f1-4154-5164daacf60a
msgctxt "h8dfb8d94g6b13g4ff7gb43cg4711d778eb9b"
msgid "Thaniel..."
msgstr "테니엘..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 36986b22-3c27-2ad3-f2bc-015525a46bf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:36986b22-3c27-2ad3-f2bc-015525a46bf2
msgctxt "h0aa0cdf4ga9ceg488dgb6e7g960e5cd0f035"
msgid "You saved Thaniel, lifted the curse, and killed an immortal."
msgstr "넌 테니엘을 구했고, 저주를 풀었으며 불멸자를 멸했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 39888a0b-a0c9-9bae-e410-eea9dc06695a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:39888a0b-a0c9-9bae-e410-eea9dc06695a
msgctxt "h36d1598ag68e3g4d2fg8901g6c181bbed47f"
msgid "I hoped to save Thaniel, as he saved me. But it was all for nothing."
msgstr "테니엘이 날 구했듯, 나도 구해주고 싶었어. 하지만 다 허사였지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 3d6ea6a3-6755-8032-d0bf-0071d0d44b40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:3d6ea6a3-6755-8032-d0bf-0071d0d44b40
msgctxt "hd84302c2g1173g4ce5gb7abg3622205285fb"
msgid ""
"My friend is gone - lost to the darkness. And I... I think I am too. I feel "
"it - deep inside."
msgstr "내 친구가 떠났어 - 어둠 속으로 사라졌다고. 나도... 그런 거 같아. 내 안에서 어둠이 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 3db26e07-eb15-f5be-d011-2cf77b8af23c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:3db26e07-eb15-f5be-d011-2cf77b8af23c
msgctxt "hdf19756fgb915g40d7ga1dbg22ba07d3fbd3"
msgid ""
"I don't know if this Duke Ravengard the same, but I will say this - the "
"Flaming Fist are the cornerstone of the city, and the Dukes are its "
"foundation."
msgstr ""
"우리가 같은 레이븐가드 공을 말하는 건지 잘 모르겠지만, 이 점은 분명해 - 플레이밍 피스트가 도시의 주춧돌이고 공작이 그 토대야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 3e0726b2-1919-986e-35ca-d7c90abe6f71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:3e0726b2-1919-986e-35ca-d7c90abe6f71
msgctxt "h64e48d03gd929g4a4fg94b4gc77337ee0a8b"
msgid ""
"Luck and stubbornness. I'm still weak, so the walk took... longer than I'd "
"like to admit. But my health can wait."
msgstr "운과 고집 덕분이었지. 아직 몸이 약한 상태라 걷는 데 무척 오래 걸렸어. 그래도 당장은 건강을 신경 쓸 겨를이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 44c0818e-e637-b8db-5b7b-2ebf30c0bd56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:44c0818e-e637-b8db-5b7b-2ebf30c0bd56
msgctxt "h5df78579gcd4ag4b0dga5cdgdd7aa02cad7c"
msgid "You too, my friend. Thank you - from Thaniel and I."
msgstr "너도 행운을 빌어, 친구. 테니엘과 내가 정말 고맙게 생각하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 48550faa-41a7-b72a-b90d-e57f9b818409
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:48550faa-41a7-b72a-b90d-e57f9b818409
msgctxt "h541fb933g6240g4a65gbae2ga32eaa725df8"
msgid ""
"When this land fell to the curse, I should have gone with it - Thaniel is "
"the only reason I survived."
msgstr "이 땅이 저주와 함께 스러진다면, 나도 따라가야겠지 - 살아갈 이유라곤 테니엘뿐이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 5c842cce-ff01-65e7-7db7-cc53838304bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:5c842cce-ff01-65e7-7db7-cc53838304bf
msgctxt "h474d6311g638ag444bga2efg1a210bc0bf03"
msgid ""
"The truth is... the Shadowfell broke something inside me - something no "
"healer can fix. I don't know how long I have."
msgstr "사실... 섀도펠 때문에 내 안의 뭔가가 파괴되었어. 어떤 치유사도 고칠 수 없지. 내게 시간이 얼마나 남았을지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 63342344-f7ee-4a99-3457-ae303ff344e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:63342344-f7ee-4a99-3457-ae303ff344e2
msgctxt "h27c39940g2bc6g4cb8g8c31g48186c9bd135"
msgid "Sorry, I didn't mean - I'm just worried."
msgstr "미안해, 나쁜 의도는 아니었어. 걱정이 되서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 648f3091-0ade-bac2-9fe7-a973d66b7f56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:648f3091-0ade-bac2-9fe7-a973d66b7f56
msgctxt "hab9e185dga823g4465ga84eg943678e8edd1"
msgid ""
"The Flaming Fist are the cornerstone of Baldur's Gate - and the Dukes are "
"its foundation. I hope you can save him."
msgstr "하지만 플레이밍 피스트는 도시의 주춧돌이지, 공작이 그 토대이고. 네가 그를 구할 수 있길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 688944ed-8865-076a-976c-79c77d68ea36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:688944ed-8865-076a-976c-79c77d68ea36
msgctxt "hbe8f70b7ga2fag4a0ag89b3ga4014d8252e2"
msgid ""
"Thank you, for trying to help us. I'm sure Thaniel would feel the same - "
"wherever he is now."
msgstr "우리 도와주려 노력해줘서 고마워. 테니엘도 지금 어딘가에서 분명 같은 마음일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 6a2515d8-6afc-6641-8608-ede9df2f60a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:6a2515d8-6afc-6641-8608-ede9df2f60a9
msgctxt "h61c72704ge1d0g4a91ga47cgf722bb5be9c7"
msgid "I know foggy fragments of Eltan - all tall tales. What was he like?"
msgstr "엘탄 공에 대해 아는 게 거의 없어. 그는 어떤 사람이었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 6a2515d8-6afc-6641-8608-ede9df2f60a9
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:6a2515d8-6afc-6641-8608-ede9df2f60a9
msgctxt "h392cb278g9171g4c5cgbcdag2114594bf687"
msgid ""
"I grew up hearing stories of Duke Eltan - I'm curious about what he was like."
msgstr "자라며 엘탄 공에 대한 이야기를 들었지 - 어떤 사람이었는지 궁금하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 6c85e4ea-0343-44c5-5129-f21b7f3cf10e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:6c85e4ea-0343-44c5-5129-f21b7f3cf10e
msgctxt "he195a762gb42eg47ebga1e2g212022470e0b"
msgid ""
"I can't make you - nor can I go in your place. In truth... I do not know how "
"much longer I will live. The Shadowfell's damage runs deep I fear."
msgstr ""
"네게 강요할 순 없지 - 네 자리에 대신 설 수도 없고. 사실... 얼마나 더 살 수 있을지도 모르겠어. 섀도펠이 준 피해가 두렵도록 "
"깊게 자리잡았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 6d887cbc-032e-2e0a-6839-d3ea8cc518e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:6d887cbc-032e-2e0a-6839-d3ea8cc518e3
msgctxt "h374c692fg4e90g458egadcfg89b0e345915e"
msgid "I am, please don't mistake that. But saving me was in vain."
msgstr "물론 기뻐, 오해 마. 근데 날 구한 건 헛된 짓이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 6dd41ad1-66b8-c579-ad0d-2353d0a5f8c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:6dd41ad1-66b8-c579-ad0d-2353d0a5f8c1
msgctxt "h61443762g7123g4f55ga09dgeb5ddd873528"
msgid "Thank you - it would have been an honour to serve under Duke Eltan."
msgstr "고마워 - 엘탄 공을 위해 복무했다면 영광이었을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 75eb28a1-1271-802f-9001-5d710e59d89a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_HavenOutcasts_State_FlamingFistsInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:75eb28a1-1271-802f-9001-5d710e59d89a
msgctxt "h4a6bfbe8g52bfg4021gaee7g7901772c6d83"
msgid "What about the Flaming Fist you've met here? What do you think of them?"
msgstr "여기서 만난 플레이밍 피스트 단원들은 어떻게 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 78d907ac-49bb-59cf-96b2-97cd337f5454
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:78d907ac-49bb-59cf-96b2-97cd337f5454
msgctxt "h35152230g99d1g44ffgba4fg361f5178f6cf"
msgid "I'm sorry."
msgstr "정말 유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 84ffbb56-51b7-a227-1e63-013c30e0df54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinWaitingInCamp = True
#.      - SCE_AncientFist_HasMet_Epilogue = False
#. SetFlags:
#.   Global:
#.     - SCE_AncientFist_HasMet_Epilogue = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:84ffbb56-51b7-a227-1e63-013c30e0df54
msgctxt "hf3e08408g12abg40fag907cg7922008c5838"
msgid "Any word on Thaniel? And the curse?"
msgstr "테니엘 소식은 없나? 저주는?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 89aa5628-12a7-ba3f-5296-3233fd10fe98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:89aa5628-12a7-ba3f-5296-3233fd10fe98
msgctxt "h2dab111fg9bccg4077gacd4gbd1414f7ac43"
msgid "I have enough to deal with - some useless duke isn't my problem."
msgstr "이미 신경쓸 게 차고 넘쳐 - 쓸모없는공작 따위를 떠맡긴 싫다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 8c097bd9-9060-fe84-f20f-26faa568872d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:8c097bd9-9060-fe84-f20f-26faa568872d
msgctxt "hde72ecd1g5df6g46a7g908bg5a895b574147"
msgid "I beat Ketheric - that's something."
msgstr "난 케서릭을 없앴어 - 대단한 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 8fbb64d8-7e96-22ad-82dc-fe4c81d37dea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:8fbb64d8-7e96-22ad-82dc-fe4c81d37dea
msgctxt "h5dfddb17gd823g4218g9480g026189fb9bda"
msgid ""
"But - because of you, Thaniel is safe. Because of you, I could help him, as "
"he helped me. So thank you, my friend, and know that I have no regrets."
msgstr ""
"하지만 네 덕분에 테니엘은 안전해. 네 덕분에 그에게 받았던 도움에 보답할 수 있었어. 고마워, 친구여, 후회는 없단 걸 알아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 9179c62a-1eeb-33b9-05bd-1f942dc26ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:9179c62a-1eeb-33b9-05bd-1f942dc26ef1
msgctxt "h38995a36g43e7g4533ga3d8g4390f1cb96f7"
msgid ""
"I heard about Duke Ravengard capture. If his soldiers are anything to go by, "
"he is a man to admire and respect."
msgstr "레이븐가드 공의 점령에 대한 얘기를 들었어. 그의 병사들만 놓고 본다면, 존경과 경의를 받을 만한 사람이 맞지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 93522b08-29e5-fcaf-08f9-64969cb04cd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:93522b08-29e5-fcaf-08f9-64969cb04cd4
msgctxt "h4dd8461eg7dd7g4c5ag806ag736798567e47"
msgid ""
"And Thaniel has been trapped in that cursed darkness even longer than I. "
"Please, help him. <i>Please.</i>"
msgstr "테니엘은 나보다 훨씬 더 오래 저주받은 어둠 속에 갇혀 있었어. 제발 그를 도와줘. <i>제발.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 9a28aa9b-a3d2-7ba3-20ae-28d548db719d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#.      - SCE_AncientFist_ToldStory = False
#. SetFlags:
#.   Global:
#.     - SCE_AncientFist_ToldStory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:9a28aa9b-a3d2-7ba3-20ae-28d548db719d
msgctxt "h91c8a01fg9a86g47efgbb1bg50a40410978a"
msgid ""
"When Duke Eltan formed the Flaming Fist, he sought out people of courage and "
"honour to fill its ranks."
msgstr "엘탄 공이 플레이밍 피스트를 창단했을 때, 단원으로 용맹하고 명예로운 자를 뽑으려 심혈을 기울였었대."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = 9a2a5e64-149f-c12b-4e54-fe11e27f2e59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:9a2a5e64-149f-c12b-4e54-fe11e27f2e59
msgctxt "hc6427e61gf057g4bbcgae65g59c56bd4d81d"
msgid "And after Thaniel awakens?"
msgstr "테니엘이 깨어난 후엔 어쩔 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 9b4cea28-1f11-3d44-6c75-621999b77ac6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinInShadowfell = True
#.      - SCE_AncientFist_HasMet_Epilogue = False
#. SetFlags:
#.   Global:
#.     - SCE_AncientFist_HasMet_Epilogue = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:9b4cea28-1f11-3d44-6c75-621999b77ac6
msgctxt "hc80c94d4g0071g4292g8143g5d2e9f061067"
msgid "He's gone, I can feel it."
msgstr "테니엘이 죽었어. 그게 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = a05801ce-9a2c-cc2e-ba93-f383df1134b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_HavenOutcasts_State_FlamingFistsInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:a05801ce-9a2c-cc2e-ba93-f383df1134b2
msgctxt "hec6442cbg4d5bg42b4ga9e1gb443b3703f3f"
msgid ""
"But I've seen the respect he inspires in the Flaming Fist - and that tells "
"me all I need about him as a leader."
msgstr "플레이밍 피스트 내부에서 그가 모두의 존경심을 이끌어 내는 걸 봤어 - 지도자의 자질은 충분한 것 같더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = a7538d21-afa5-7b09-c772-a08efa820638
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:a7538d21-afa5-7b09-c772-a08efa820638
msgctxt "h6f496cdbg7250g4790g9ee9g5479808678aa"
msgid "I'm working on it."
msgstr "알아 보고 있는 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = abf09bb0-0e52-be18-17d0-9c868433a168
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:abf09bb0-0e52-be18-17d0-9c868433a168
msgctxt "h8b400ebbg6c21g43b0gb9f8gcaa875abd49a"
msgid "Please, hurry. I don't know how much longer Thaniel can last."
msgstr "제발 서둘러 줘. 테니엘이 얼마나 더 버틸 수 있을지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = aebd3374-acca-7d6b-7b88-96ddc75a38af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:aebd3374-acca-7d6b-7b88-96ddc75a38af
msgctxt "hc8fa5e39g7d18g4de1ga569gdd2b9bccca33"
msgid "I did."
msgstr "난 많았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = b3090640-d3d9-a6a7-a25a-96d7f4134350
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:b3090640-d3d9-a6a7-a25a-96d7f4134350
msgctxt "hae577228gac2eg4cabg90c3g1b20183b9ce9"
msgid ""
"Gruff. And intimidating. But he had the courage of ten men - and a love for "
"Baldur's Gate few could match."
msgstr "거칠지. 위협적이고. 남자 열 명에 맞먹는 배짱을 가졌었어. 발더스 게이트를 향한 애정은 누구보다 컸고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = b4217593-8a6a-0b97-0f36-7dad657599f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:b4217593-8a6a-0b97-0f36-7dad657599f4
msgctxt "h0a8a00dbg538cg4d7cg8ba0g8e6d35095de7"
msgid "It's safe to say, you'd have been recruited in an instant."
msgstr "너라면 당장에 채용되었다고 봐도 무방하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = b6e899a5-fffa-701a-d3ce-e94575015888
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:b6e899a5-fffa-701a-d3ce-e94575015888
msgctxt "hcebfba8dgbefag47bfg85f0g305b7352831e"
msgid "Then I wish you luck. Thank you for your help."
msgstr "그럼 행운을 빌게. 도와줘서 고맙다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = b9ab8d86-e8f7-a478-943f-8595c1855f39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:b9ab8d86-e8f7-a478-943f-8595c1855f39
msgctxt "h1a547316g4276g4d48g86e7gbedbff18f406"
msgid "I hope you can save Duke Ravengard - for the good of Baldur's Gate."
msgstr "발더스 게이트를 위해 네가 레이븐가드 공을 구할 수 있길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = c03600fe-6f03-eac9-66e7-8aa53f317585
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:c03600fe-6f03-eac9-66e7-8aa53f317585
msgctxt "h395264b8g27f1g4c13gbf84gf8efcba06206"
msgid "Once we leave, this place will be pretty empty. Will you be all right?"
msgstr "우리가 떠나고 나면, 여긴 휑할 텐데. 그래도 괜찮겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = c0d00f80-e4e7-5f3b-56c8-740127ed2348
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:c0d00f80-e4e7-5f3b-56c8-740127ed2348
msgctxt "hd972b842gf45ag46ccg9c53gf587a7f767c4"
msgid ""
"They are... different to what Duke Eltan envisioned.  And I can't comment on "
"Duke Ravengard himself."
msgstr "엘탄 공이 의도했던 모습과는... 다른 것 같더군. 레이븐가드 공에 대해선 평가할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = c5d92c8c-0b6d-cec4-03ac-3709129b3ba3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:c5d92c8c-0b6d-cec4-03ac-3709129b3ba3
msgctxt "h56f87f76gbb51g4c9fg8138gd8de8fd181e5"
msgid ""
"Besides - Thaniel should have someone here when he wakes up. It's the least "
"I can do."
msgstr "게다가 테니엘이 깨어났을 때 누군가는 여기 있어야 해. 내가 해줄 수 있는 건 그뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = c9aab55d-0f54-039b-908f-0680e777b7bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:c9aab55d-0f54-039b-908f-0680e777b7bb
msgctxt "h6b5356cag82f5g44b3g97d2gfb5483389397"
msgid "No. When I first awoke, I felt him. Here. But that's faded."
msgstr "없어, 처음 깨어났을 때는 그가 느껴졌지. 여기에서. 하지만 이젠 희미하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = c9b0ea86-7a3b-e42a-7dd5-8b36c4e2a934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:c9b0ea86-7a3b-e42a-7dd5-8b36c4e2a934
msgctxt "he3cc6a4cg1035g43e7gab03gfdb67eea3cf6"
msgid "I just killed Ketheric and this is all you have to say?"
msgstr "방금 케서릭을 죽였는데, 고작 할 말이 그건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = cccd7440-964b-1f1d-f32d-deed37b92d53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:cccd7440-964b-1f1d-f32d-deed37b92d53
msgctxt "hb4cfe162gc418g4897gbf50ga20ffa4b20b3"
msgid ""
"Don't be. The Shadowfell claims everyone in the end - it just took its time "
"with me."
msgstr "그러지 마. 결국 섀도우펠은 모두를 앗아가지 - 난 시간이 좀 더 걸리는 것뿐이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = cea7dcc5-c0c9-a8ab-3a18-b47e8b926211
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:cea7dcc5-c0c9-a8ab-3a18-b47e8b926211
msgctxt "hb4e7e9e0g6baeg4567g93cfg2b02de2e4107"
msgid "What are you talking about?"
msgstr "그게 무슨 말이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d0721f19-3fbe-bdf1-8a12-e0c3f918e8d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:d0721f19-3fbe-bdf1-8a12-e0c3f918e8d2
msgctxt "h4eb27522g5733g44dbga4e3g460f6e51416a"
msgid "Thaniel is gone... and with him, any chance of breaking the curse."
msgstr "테니엘이 죽었어... 저주를 깰 수 있는 기회도 함께 사라졌지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d7dd00a3-589b-35a8-7377-1fc535f2cf1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_HavenOutcasts_State_FlamingFistsInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:d7dd00a3-589b-35a8-7377-1fc535f2cf1f
msgctxt "h49c8b588g57f3g41aaga2f5g7b75a6e30769"
msgid ""
"A Flaming Fist - a novice, actually. She dropped everything to make sure I "
"made it here safe."
msgstr "플레이밍 피스트의 신출내기 단원이 내가 여기까지 무사히 올 수 있도록 만사 제치고 도와줬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = db4db2b4-fb78-636c-a2af-651f93d6c611
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:db4db2b4-fb78-636c-a2af-651f93d6c611
msgctxt "hacce8e6cgffc2g4b03ga94dgb93331e33acb"
msgid "I never really cared about Thaniel anyway."
msgstr "어차피 테니엘에겐 별로 관심 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = dec6b84c-8a8d-492d-83e1-8e152ab60a11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:dec6b84c-8a8d-492d-83e1-8e152ab60a11
msgctxt "hc4f71198ga237g4e05g81d7g2c7df3fe2fb6"
msgid "Last I saw you were bed-bound. How did you make it here?"
msgstr "널 마지막으로 봤을 땐 설 수도 없을 지경이었는데. 여기 어떻게 온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = dfda7fb9-83ef-288a-5abc-dbb04f06818b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:dfda7fb9-83ef-288a-5abc-dbb04f06818b
msgctxt "h8c0c5365gcf44g4cf9gacd9g90485821338c"
msgid ""
"Of course, I have no idea what life is like under Duke Ravengard's rule."
msgstr "물론이지, 레이븐가드 공의 치하에서 겪는 삶이 어떤지는 전혀 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = e1771651-610e-a886-d2a1-9c471fc220fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:e1771651-610e-a886-d2a1-9c471fc220fe
msgctxt "h48f699fbgd1e1g42c3ga870gd80a8ac48c50"
msgid "I hope you can save him - for the good of Baldur's Gate."
msgstr "발더스 게이트를 위해 네가 레이븐가드 공을 구할 수 있길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = e3db5a12-98a8-fa5f-2958-bc6b68d2ba49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:e3db5a12-98a8-fa5f-2958-bc6b68d2ba49
msgctxt "h7faa103dg7e8cg4ce1g927egd54bc6bd9835"
msgid "I don't think there will be an after."
msgstr "그 후라는 건 없을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = e619188b-88f6-160b-2487-ed1a2189a818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:e619188b-88f6-160b-2487-ed1a2189a818
msgctxt "h08a85c79g9be3g4780ga72bg47ffe6764ebe"
msgid ""
"I didn't want to tell you in Last Light, but the Shadowfell... broke "
"something in me - something no healer can fix."
msgstr "최후의 빛에서는 말하고 싶지 않았지만, 섀도우펠은... 내 안의 뭔가를 파괴했고, 그 어떤 치료사도 그걸 되돌릴 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = ed295b43-f91b-6843-4478-a56288b2ce10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:ed295b43-f91b-6843-4478-a56288b2ce10
msgctxt "he0647a85g62dfg4591gaa24g6961d42e8b09"
msgid ""
"Please, - I don't know how much longer Thaniel can last in the Shadowfell. "
"Help him - and hurry."
msgstr "섀도펠에서 테니엘이 얼마나 더 버틸 수 있을지 모르겠어. 제발 서둘러 그를 도와줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = f02cf1fa-c34f-0698-b128-70dc2bb88fa4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:f02cf1fa-c34f-0698-b128-70dc2bb88fa4
msgctxt "h8d8b22e1g360bg490cg806bgbea8e19f0341"
msgid ""
"Thank you, but look at me - I am a relic: a glimpse of history barely strong "
"enough to stand on his own two feet."
msgstr "고마워, 하지만 내 꼴을 봐 - 거의 유물이나 다름없지. 혼자 힘으로는 두 발로 설 수도 없이 약한 과거의 흔적일 뿐이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = f3692e13-00cf-b1c6-67ce-9353c1c85850
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:f3692e13-00cf-b1c6-67ce-9353c1c85850
msgctxt "h68f7bcd8geb41g4d9cgab81g5c11f0453b76"
msgid "Surely there's something we can still do."
msgstr "아직 할 수 있는 게 분명 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = f4608705-ea7e-df26-e0ec-5cbe04bf0bdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:f4608705-ea7e-df26-e0ec-5cbe04bf0bdc
msgctxt "hc8ecb21egdabfg4528g9e3agbac9994f5d9a"
msgid "Come with me - I could use a Flaming Fist by my side."
msgstr "나와 함께 가자 - 플레이밍 피스트 동료라면 든든할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = f4707dd3-147e-ee4f-4544-fa37e43842ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:f4707dd3-147e-ee4f-4544-fa37e43842ba
msgctxt "h64b256fcge6cag47eeg8f9bga91cd690e2c3"
msgid ""
"But the Flaming Fist are the cornerstone of the city, and the Dukes are the "
"foundation."
msgstr "하지만 플레이밍 피스트는 도시의 주춧돌이지, 공작이 그 토대이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Art Cullagh
#. NodeID = f92d5b0d-d4af-0668-4eec-3111cbc4a2db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:f92d5b0d-d4af-0668-4eec-3111cbc4a2db
msgctxt "h0d5da40ag06f3g4411gb4c7g7eea8601a62e"
msgid ""
"With great difficulty. Even after all that rest, I... don't seem to be "
"getting better."
msgstr "무척 힘들게 왔지. 그렇게 오래 쉬었는데도... 나아지는 기미가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist
#. Speaker = Player
#. NodeID = fe6de86b-e364-23e2-23a6-dd5a148a279d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_CursedFist:fe6de86b-e364-23e2-23a6-dd5a148a279d
msgctxt "h32e87e1bg5653g442agb618g79bb161e7278"
msgid "The Flaming Fist are nothing but mercenaries now. Immoral ones at that."
msgstr "이제 플레이밍 피스트는 한낱 용병단에 불과해. 게다가 부도덕하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Jaheira
#. NodeID = 24a3063c-5b1a-4b14-b341-a901642ffa3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f8e3175b-5587-d6cd-2174-e5a3e9ca4890_A = False
#. SetFlags:
#.   Local:
#.     - f8e3175b-5587-d6cd-2174-e5a3e9ca4890_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:24a3063c-5b1a-4b14-b341-a901642ffa3e
msgctxt "h50149f41g673ag414dgb9f8g608485be7a85"
msgid "Is it true you were a member of the Absolute cult, drow?"
msgstr "절대자의 추종자였다는 게 사실인가, 드로우?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Jaheira
#. NodeID = 56e39196-e2f1-4d0c-9bfb-e38557bb0571
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:56e39196-e2f1-4d0c-9bfb-e38557bb0571
msgctxt "h70c146f1g358fg4b4cgbe03g9aef62c9b048"
msgid "No. I mean to learn from you."
msgstr "아니. 좀 배우려고 물어봤지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Nightwarden Minthara
#. NodeID = 5b7483d3-e87c-4303-9d57-ae59e1d311da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:5b7483d3-e87c-4303-9d57-ae59e1d311da
msgctxt "h3e2eca5fg3b98g418dg9262g6eee4f730c6a"
msgid "Do you mean to judge me if I were, <i>darthiir</i>?"
msgstr "그랬다면 뭐라고 할 셈인가? <i>다르시어</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Jaheira
#. NodeID = 654c989c-53b9-48eb-a72e-f5e2a6cc3a21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:654c989c-53b9-48eb-a72e-f5e2a6cc3a21
msgctxt "h42fe8c48gd9a1g4ad6gaadagc919d564862b"
msgid "There is little love for her on the surface anymore."
msgstr "이젠 지상에서도 사랑 받지 못하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Jaheira
#. NodeID = 7c9badef-0e4c-4dc7-b504-8736b974043b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:7c9badef-0e4c-4dc7-b504-8736b974043b
msgctxt "ha58411e5gbeb3g41e6g8e5eg21465d60c575"
msgid "Not for me. They would die for peace."
msgstr "그러진 않을 거야. 대신 평화를 위해서 라면 목숨을 걸겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Nightwarden Minthara
#. NodeID = 95dc658c-5287-420c-a773-27bcfd738cd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:95dc658c-5287-420c-a773-27bcfd738cd9
msgctxt "h8c25e351gefdag4d73gac7bg21a3c894c7fd"
msgid ""
"An exile from Lolth, much like myself. There is no love for her in the "
"Underdark."
msgstr "나 같은 롤쓰님께 버림받은 자야. 언더다크에서도 사랑받지 못했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Jaheira
#. NodeID = a3026cda-0ee8-4972-8dd3-62f50d3e0939
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f8e3175b-5587-d6cd-2174-e5a3e9ca4890_B = False
#.     - f8e3175b-5587-d6cd-2174-e5a3e9ca4890_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:a3026cda-0ee8-4972-8dd3-62f50d3e0939
msgctxt "h0829acf0gd896g4715ga049gf6cf3fb6c991"
msgid ""
"I travelled with a drow of Menzoberranzan once - Viconia DeVir. Do you know "
"of her?"
msgstr "한번은 멘조베란잔의 드로우와 함께 탐험 다닌 적이 있지 - 비코니아 드비어. 혹시 그녀를 아나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Nightwarden Minthara
#. NodeID = c907d4b4-a921-482f-9b19-dd6a89eace12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:c907d4b4-a921-482f-9b19-dd6a89eace12
msgctxt "h8bc421f2g78bcg4231g9fffg03eae38c5066"
msgid "Hmph. It is better to kill for it."
msgstr "흥. 평화를 위해서 라면 차라리 죽이는 게 낫겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara
#. Speaker = Nightwarden Minthara
#. NodeID = d4e3d56c-b5a4-44f8-b708-f49c5294c34f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f8e3175b-5587-d6cd-2174-e5a3e9ca4890_B = False
#. SetFlags:
#.   Local:
#.     - f8e3175b-5587-d6cd-2174-e5a3e9ca4890_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Debrief_AD_JaheiraAndMinthara:d4e3d56c-b5a4-44f8-b708-f49c5294c34f
msgctxt "he5807c64g6c00g4c05g9474g173ce3ec6ee3"
msgid "These Harpers of yours. Would they die for you?"
msgstr "당신의 하퍼들 말이야. 당신을 위해 목숨을 걸 수 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 1c251761-3351-553a-6534-41f2be8a6329
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001:1c251761-3351-553a-6534-41f2be8a6329
msgctxt "hd5a96cdfg4eb0g4cb3ga3ebg7aa9e02be7f8"
msgid "Gods. What will I tell the others?"
msgstr "신이시여. 다른 사람들에겐 뭐라 해야 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 63dea494-58ae-8080-329a-3dce041e070d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_HasMet_GnomePrisoner_001(0) = False
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - SCE_HasMet_GnomePrisoner_001(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001:63dea494-58ae-8080-329a-3dce041e070d
msgctxt "h256b2fc1g440dg46e2g903cg12dbd844999b"
msgid "Moonrise has been cleansed - Baldur's Gate is next."
msgstr "문라이즈는 정화되었어 - 다음은 발더스 게이트야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 6feb0664-6e10-3e79-8d91-646e469921f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_HasMet_GnomePrisoner_001(0) = True
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001:6feb0664-6e10-3e79-8d91-646e469921f4
msgctxt "hb7c77334gc917g4b72g91dcg3fdb345f8eb6"
msgid "I just - I don't know what to do."
msgstr "난 그저 - 뭘해야 할지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 76da8e68-0e86-db02-c68e-58722dda4d6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_HasMet_GnomePrisoner_001(0) = True
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001:76da8e68-0e86-db02-c68e-58722dda4d6c
msgctxt "h29aaade5g95c2g44b5g9b37g0be04191ab3e"
msgid "I can't believe Wulbren managed to get us through this."
msgstr "울브렌이 우릴 이 난관에서 구해주다니 믿어지지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 7dfe8618-4210-6a89-52c2-d3909f023deb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_HasMet_GnomePrisoner_001(0) = False
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - SCE_HasMet_GnomePrisoner_001(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_001:7dfe8618-4210-6a89-52c2-d3909f023deb
msgctxt "h112de4d8g96deg4f59ga180g49f1a1cb670b"
msgid ""
"I can't believe Wulbren's gone. Reviving the Ironhands, returning to "
"Baldur's Gate - it all rested on him."
msgstr "울브렌이 죽었다니, 믿어지지 않아. 아이언핸드의 부활과 발더스 게이트로 귀환 하는 일 전부 그에게 달렸는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 2d669f57-844b-f1c3-b45f-aec932605095
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:2d669f57-844b-f1c3-b45f-aec932605095
msgctxt "hb0280f2dg9a1cg4a12gbf52g2dbf1a0e960a"
msgid "Blissful silence. The stone's at peace."
msgstr "황홀한 침묵이야. 돌이 드디어 평안을 찾았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 2d669f57-844b-f1c3-b45f-aec932605095
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:2d669f57-844b-f1c3-b45f-aec932605095
msgctxt "hab971bf8g2da2g49d7g893cg8bad7671e5ca"
msgid "Feel that calm? The stone's free at last."
msgstr "이 고요함이 느껴지나? 돌이 드디어 자유로워졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 2d669f57-844b-f1c3-b45f-aec932605095
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:2d669f57-844b-f1c3-b45f-aec932605095
msgctxt "h63db3e57gc937g4a39g8981g8dfc65cd4e48"
msgid "It'll take time, but this tower's stone will heal."
msgstr "시간이 걸리겠지만, 이 탑의 돌도 차츰 회복될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 7103c548-2de9-7688-55df-2438f2430e1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_GnomePrisoner001_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:7103c548-2de9-7688-55df-2438f2430e1e
msgctxt "h1d677418g437bg4f54gbd07g1f4fd74e4cc5"
msgid "Nimble. She's gone..."
msgstr "님블... 님블이 죽었어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 7103c548-2de9-7688-55df-2438f2430e1e
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - MOO_GnomePrisoner001_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:7103c548-2de9-7688-55df-2438f2430e1e
msgctxt "hc4a20361g6cbfg44a4gb906g4aa2c956fb29"
msgid "I'm all alone. Just me and the stones."
msgstr "이제 혼자야. 나하고 돌들밖에 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 7103c548-2de9-7688-55df-2438f2430e1e
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - MOO_GnomePrisoner001_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:7103c548-2de9-7688-55df-2438f2430e1e
msgctxt "hd42562f6g7ad5g411fg8927gf1dc789d6479"
msgid "I feel so lost."
msgstr "어떻게 해야 할지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 71eaf6ae-c4e8-a532-3add-eb45d42ce5ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:71eaf6ae-c4e8-a532-3add-eb45d42ce5ee
msgctxt "hed908872gb948g4bb7ga797g2197c7cc2054"
msgid "We needed Wulbren. Nimble needed him."
msgstr "우리에겐 울브렌이 필요했어. 님블에게 울브렌이 필요했고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 71eaf6ae-c4e8-a532-3add-eb45d42ce5ee
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:71eaf6ae-c4e8-a532-3add-eb45d42ce5ee
msgctxt "h06dea960g706dg41cbg8e4cg50dcd11b520d"
msgid "Nimble's sad. Even the stones are sad."
msgstr "님블이 슬퍼하고 있어. 심지어 돌들도 슬퍼하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 71eaf6ae-c4e8-a532-3add-eb45d42ce5ee
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - GLO_Wulbren_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_GnomePrisoner_002:71eaf6ae-c4e8-a532-3add-eb45d42ce5ee
msgctxt "hff9c9a48gae21g4607g9e2cg2e70847cfc55"
msgid "Where do we go now? Where's home?"
msgstr "이제 어디로 가야 하지? 고향은 어딜까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 02274045-731d-c400-3534-b929de5b79b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:02274045-731d-c400-3534-b929de5b79b5
msgctxt "h6f672228gb926g4bbfgbf72g4cec488407f2"
msgid "Once Thaniel's essence is found, what then?"
msgstr "테니엘의 정수를 발견하고 그 후엔?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 05fe4167-df1d-b14a-57eb-e6ce49678395
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:05fe4167-df1d-b14a-57eb-e6ce49678395
msgctxt "h25e9b714gc741g4bf9gb684g7a169870c060"
msgid "Stay here, for now."
msgstr "당분간은 여기 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 0b17cb48-02a3-decd-11a7-5a93c264fbc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Origin_BlockWaitInCampOption(0) = False
#.      - ORI_State_Recruited(0) = True
#. SetFlags:
#.   Object:
#.     - OriginRemoveFromPartyAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:0b17cb48-02a3-decd-11a7-5a93c264fbc1
msgctxt "h30e8c62bg3b77g4b4fg90beg6ee27760bc5a"
msgid "I need you to remain at camp for now."
msgstr "지금은 야영지에 남아 있어줬으면 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 0b7fac88-5821-4ffd-87aa-efb7d212ebf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:0b7fac88-5821-4ffd-87aa-efb7d212ebf0
msgctxt "h548ee964g72ebg46c7g9d58ge7626d633740"
msgid ""
"The shadows rended him in two when they bore him away to the Shadowfell. "
"Half of his essence remained here, amidst the curse."
msgstr "테니엘이 섀도펠로 끌려갔을 때 그림자가 그를 둘로 쪼갰지. 영혼의 절반은 저주에 둘러싸인 채 여기 남아있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 0b9cbfd2-1a16-c287-a628-287cbc090a94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:0b9cbfd2-1a16-c287-a628-287cbc090a94
msgctxt "h5d983afbg1f8cg423agbddeg1427e19d7c45"
msgid ""
"No. If you linger, you'll only jeopardise your own mission. This is my "
"burden alone now until either the curse is lifted, or I breathe my last."
msgstr "아니, 이 이상 머뭇거리면, 네 임무가 위험해져. 저주가 풀릴 때까지 혹은 내 숨이 멎을 때까지 이건 나만의 책임이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 0d77c683-e674-8aea-c1f2-3208f384e43c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:0d77c683-e674-8aea-c1f2-3208f384e43c
msgctxt "h852a30ecg4b7eg48e9gba53g4536bc3b9e45"
msgid "How do you know this?"
msgstr "이런 걸 어떻게 아는 거예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 1243ecfc-61b9-158b-5e88-17e0facb7ec6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:1243ecfc-61b9-158b-5e88-17e0facb7ec6
msgctxt "hc64d8073ga468g49bdg9489g7fc1199feb83"
msgid "Tell me how I can help."
msgstr "어떻게 하면 도움이 될까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 16366c42-d6cd-4204-3b76-744322c4c7c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:16366c42-d6cd-4204-3b76-744322c4c7c6
msgctxt "h9194b709ga3b6g4732gb139ga54592e973ed"
msgid "All right, leave it to me."
msgstr "좋아, 내게 맡겨요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 1bd5ea44-42a6-5cc1-505d-74543c2ba4a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:1bd5ea44-42a6-5cc1-505d-74543c2ba4a3
msgctxt "h24e7414ag2bc9g4e56ga306gba411e26df04"
msgid ""
"In fact, I saw just the sort before, not long after we first came within "
"reach of the shadow curse. Fool that I am, I did not grasp their "
"significance at the time."
msgstr "사실 전에 무척 비슷한 걸 봤어. 그림자 저주가 닿은 곳에 막 도착했을 때였는데, 바보처럼 그땐 그 의미를 알아차리지 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 1ecb2cde-9678-51f2-fb6e-2b91716c07d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:1ecb2cde-9678-51f2-fb6e-2b91716c07d6
msgctxt "hc722b72bg3681g459fgba96g18176f1a17af"
msgid "The shadow curse was always your burden - not mine."
msgstr "그림자의 저주는 쭉 네 책임이었지 - 내것이 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 21fe5bac-0f55-b879-86f4-455c73a34c93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:21fe5bac-0f55-b879-86f4-455c73a34c93
msgctxt "hd4c06a1bgd7b1g40dcgaa66g320ccde4788b"
msgid ""
"I knew something was wrong when he didn't wake up, but now I'm even more "
"certain."
msgstr "깨워도 일어나지 않아서 뭔가 잘못되었단 걸 알았지. 이젠 완전히 확신하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 26e2f04e-77f3-5166-4a37-e5b83785b5f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:26e2f04e-77f3-5166-4a37-e5b83785b5f6
msgctxt "h418baeb8g2b73g4762gac48gf5351c9383cd"
msgid "I'll be ready."
msgstr "준비하고 있을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 26ff222c-8aa6-a82b-07b4-126ff69888e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_CurseLiftedHasmet(1) = True
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:26ff222c-8aa6-a82b-07b4-126ff69888e5
msgctxt "hfaada303gf2d6g4490gad61g866c7ac7bb2d"
msgid ""
"I swear I can already feel a change in the air - like the curse itself knows "
"its time is short."
msgstr "공기 속에서 뭔가 변한 게 느껴져 - 마치 저주가 남은 시간이 동났다는 걸 아는 듯하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 2ad8ad47-d3f7-3249-3c6f-5c7100525a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:2ad8ad47-d3f7-3249-3c6f-5c7100525a68
msgctxt "h5186c29fgc76dg4f27g9eb2g9ba043a0dd72"
msgid ""
"Still, I would like to return here some day. See Thaniel and Oliver again - "
"in my meditations, or perhaps in person, if the Oak Father wills it. I hope "
"he does."
msgstr ""
"그래도, 언젠가 여기 돌아오고 싶어. 명상 속에서나 현실에서 테니엘과 올리버를 만나고 싶군. 참나무 아버지가 허락하신다면 말이야. 그래 "
"주신다면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 2c01c4da-7bb3-e6bf-c996-c23c5106cc6f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_LiftingTheCurse_State_HalsinRecruitable = True
#.   Object:
#.     - OriginAddToParty(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:2c01c4da-7bb3-e6bf-c996-c23c5106cc6f
msgctxt "h55d2ced6gc784g449fg8489g07de22711fd4"
msgid "Gladly. Let's put an end to this, once and for all."
msgstr "물론이지. 이번에야말로 이 일을 마무리짓자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 2df4dfad-273c-7782-c68d-7151003fcc47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:2df4dfad-273c-7782-c68d-7151003fcc47
msgctxt "h6bf7c0f4g9ec0g411bg91dagda31f11ac496"
msgid ""
"Once the curse is lifted, they can stand as one or as a pair. Whatever they "
"wish."
msgstr "일단 저주가 걷히면, 하나가 되거나 한쌍으로 살아갈 수 있어. 본인들이 바라는 대로 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 3066629b-0c78-f67a-28fa-78b62f2bae02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:3066629b-0c78-f67a-28fa-78b62f2bae02
msgctxt "h6ff75446g4404g45d7g994eg98f2cff6b43d"
msgid ""
"Perhaps it can be reasoned with, but I'm not hopeful. Reason is not "
"something that thrives amidst the shadow curse."
msgstr "정수를 설득할 수 있을지도 모르지만 큰 기대는 없어. 그림자의 저주 한가운데서 이성을 붙들고 있기란 어려운 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 306baec3-0f62-194f-e7a8-acaf04a0fb88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:306baec3-0f62-194f-e7a8-acaf04a0fb88
msgctxt "hb46d2b66ga02fg42feg8a18ga656670473d4"
msgid ""
"I can't say for certain, but we'll see it come to pass long before this "
"place recedes behind us. Don't worry - all is at hand. We can depart "
"whenever you're ready."
msgstr ""
"확답을 줄 순 없지만, 우리가 여길 떠나 이곳이 더는 보이지 않을 때쯤 저주도 풀릴 걸세. 걱정 말게. 다 잘 돼 가고 있으니. 자네만 "
"준비됐다면 언제든 떠날 수 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 327763f1-2cd3-fccc-ae79-7279693b1272
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:327763f1-2cd3-fccc-ae79-7279693b1272
msgctxt "h9c6b8791ga701g407cg8bd6g30ce6e2a1e46"
msgid ""
"No matter how it's been twisted by the shadows, it is still part of "
"Thaniel's essence - it will resemble him somehow, and may show signs of his "
"power."
msgstr "그림자들에 의해 얼마나 뒤틀렸든, 그건 여전히 테니엘의 한 부분이야. 모습을 닮았을 수도, 같은 힘을 보여줄 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 494f907e-5c49-7b42-58ad-a982768019df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:494f907e-5c49-7b42-58ad-a982768019df
msgctxt "h818ca38dg802fg4091g83a1g86b05f4634ea"
msgid ""
"It's both simple and not - we need to find Thaniel's missing half, and make "
"him whole again."
msgstr "간단하기도 복잡하기도 해. 우린 테니엘의 잃어버린 일부를 찾아야 해. 다시 완전하게 만들어야 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 4ce140fb-cdb9-99cf-7a14-827ee07fa30c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:4ce140fb-cdb9-99cf-7a14-827ee07fa30c
msgctxt "h283b0259gf9b1g4d8dgbcbbg97cd9b3f843f"
msgid ""
"Look for life in the darkness. Wildflowers, where everything else is dead. "
"The curse cannot subdue the power Thaniel bears. Not entirely."
msgstr "어둠 속에서 생명을 찾아. 다른 모든 게 죽은 자리에 핀 야생화처럼. 저주는 테니엘이 지닌 힘을 완전히 억누르지 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 530f977e-0be6-4099-5ac2-89a513092b2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:530f977e-0be6-4099-5ac2-89a513092b2b
msgctxt "h3915a4dbg1564g462cga6fbg8ad6fc8c2b6d"
msgid ""
"No more than my right hand can absorb my left. Oliver is helping Thaniel to "
"recover; they both lie dormant, like trees awaiting spring."
msgstr ""
"오른손이 왼손을 흡수할 수 없듯, 두 사람도 마찬가지지. 올리버는 테니엘이 회복하는 걸 돕고 있어. 봄을 기다리는 나무처럼, 둘다 휴면 "
"상태야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 5346b875-7c01-8fd6-a310-e9d999dbbb91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:5346b875-7c01-8fd6-a310-e9d999dbbb91
msgctxt "h7ec362d9g7912g452cg9c3ag5fb4958a5314"
msgid "Join me."
msgstr "함께 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 546bd4ca-ab08-33cd-bcc2-50bb626789f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:546bd4ca-ab08-33cd-bcc2-50bb626789f4
msgctxt "hc3f4eb72ga406g41f3g9d2cg642ceb98341f"
msgid ""
"Let me help you then. Every moment counts, and I've asked much of you "
"already without being at your side."
msgstr "내가 돕겠어. 매 순간이 중요해. 함께 해주지도 못했는데, 이미 너무 많은 부탁을 한 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 551f2c4b-6ab4-e604-b79d-8de57be71af8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:551f2c4b-6ab4-e604-b79d-8de57be71af8
msgctxt "h35af5f56g88beg4627gb522gd166978823dd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 563cbfca-e95f-e5bb-88b8-e5ddcb79d851
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_AskedAboutOliver(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedAboutOliver(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:563cbfca-e95f-e5bb-88b8-e5ddcb79d851
msgctxt "hea831235ga90bg4016gb65cg9a5eb404a3e9"
msgid "What happened to Oliver, exactly? Did Thaniel... absorb him?"
msgstr "올리버에게 정확히 무슨 일이 있었던 거지? 테니엘이... 그를 흡수한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 5bfa6337-a9a0-4030-9249-d1ceba573b8f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_CurseFailHasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:5bfa6337-a9a0-4030-9249-d1ceba573b8f
msgctxt "h52ec1d40g5431g4bfag8994g30735f78275b"
msgid ""
"You prevailed, my friend. Now your path takes you to Baldur's Gate... but I "
"cannot join you."
msgstr "승리했군, 친구여. 이제 다음 행선지는 발더스 게이트겠지... 하지만 난 함께 갈 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 5ce6e79a-8bb2-5f22-55ce-192d4765bb13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_PermaDefeated = True
#.      - SCL_AncientFist_Knows_WasInCurse = True
#.      - HAV_LiftingTheCurse_State_KnowsBreathLocation = False
#.      - GLO_LiftingTheCurse_Event_TravelToLakeside = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:5ce6e79a-8bb2-5f22-55ce-192d4765bb13
msgctxt "h08e02ac3g9c16g4661gb376g3316307ebd95"
msgid "I found a Flaming Fist who escaped the Shadowfell - but he's dead."
msgstr "섀도펠에서 탈출한 플레이밍 피스트 한 명을 찾았는데, 죽었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 5fb87d12-e749-4f5e-a287-3dc3a2106bef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_ToldHalsinAboutOliver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:5fb87d12-e749-4f5e-a287-3dc3a2106bef
msgctxt "hee6b8543gf6fbg494cg8b73gc59aca33f0f6"
msgid ""
"We need to find Oliver and get him to return to Thaniel. Otherwise this "
"curse will never be lifted."
msgstr "올리버를 찾아서 테니엘에게 돌려보내줘야 해. 안 그러면 이 저주는 절대 풀리지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 61cf9fa4-7d05-19a6-7197-cad6eb4257c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_HalsinRecruitable = True
#.   Object:
#.      - ORI_State_Recruited(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:61cf9fa4-7d05-19a6-7197-cad6eb4257c1
msgctxt "hf2844c85g448fg4136gae58g000f97cd794c"
msgid "Come with me. I might need you out there."
msgstr "함께 해주세요. 당신이 필요해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 65afa1fe-e48b-7339-370c-a19dd0c825da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:65afa1fe-e48b-7339-370c-a19dd0c825da
msgctxt "h174d5cfcg46e2g4271g9874gf16ee3f027f4"
msgid ""
"This place needs me. I wish it were different - I truly do. As long as the "
"curse remains, so must I."
msgstr "이곳에는 내가 필요해. 사실 그렇지 않길 진심으로 바랐었지. 저주가 남아있는 한, 나도 그래야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 6c3d20f7-fdd4-e9a2-f0f3-592454f5ec8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:6c3d20f7-fdd4-e9a2-f0f3-592454f5ec8f
msgctxt "h58c58b4egdabag44e1ga006gd819a4264c83"
msgid "I'm glad I could help."
msgstr "도울 수 있어 기쁘군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 6d515349-98e5-a62a-b353-a8aaa22715f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:6d515349-98e5-a62a-b353-a8aaa22715f8
msgctxt "h1a416363g7aa5g4349gac13g3175c8672687"
msgid "This isn't what I wish. It's simply the way it has to be - I'm sorry."
msgstr "내가 원해서 이렇게 된 게 아니라, 그렇게 해야 할 뿐이지 - 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 6e5ea5da-743b-1b50-8054-6e71b4208c41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:6e5ea5da-743b-1b50-8054-6e71b4208c41
msgctxt "h9618d90cg1ad0g4220gb007g9e145fb3d260"
msgid ""
"No, my friend. The only thing I ask of you is to allow me by your side on "
"the road ahead. I still owe you a debt, and I intend to pay."
msgstr ""
"아니야, 친구. 내가 바라는 건 계속해서 나란히 함께 여행하는 것밖에 없어. 자네에게 갚지 못한 빚이 아직 있지, 그걸 갚을 셈이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 6f4243ce-c67d-0f99-bb04-29a3927c76d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_CurseFailHasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:6f4243ce-c67d-0f99-bb04-29a3927c76d5
msgctxt "h44204219g32afg4364g84c5gb49ee983ddd3"
msgid ""
"I will miss you, my friend. Perhaps our paths will cross again some day, if "
"the sun ever shines on this place once more."
msgstr "그리울 거야, 친구. 이곳에 다시 볕이 내리게 된다면, 언젠가 우리 여정도 다시 엊갈리게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 7018d69e-e98b-ea82-0764-93cd613cadfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:7018d69e-e98b-ea82-0764-93cd613cadfd
msgctxt "h745bc6feg1780g4c99g858bgb468efb531be"
msgid ""
"You flirting with me, big man? Why not spare the talk and get straight to "
"the sweaty part?"
msgstr "나를 꼬시려는 건가, 덩치? 잡담은 그만 하고, 끈적한 단계로 곧장 넘어가는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 729d39f4-d6a8-817f-78fb-fe219b2327a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:729d39f4-d6a8-817f-78fb-fe219b2327a9
msgctxt "he2d03eedgbc48g4a9fga346gfc642919c033"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 79345a1d-27ca-9e63-3d88-ea476aaf3e5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:79345a1d-27ca-9e63-3d88-ea476aaf3e5b
msgctxt "h1a9beb67g1389g4cbfg867dgc891e1622e19"
msgid ""
"This doesn't have to be your burden alone. Every moment counts, and I've "
"asked much of you already without being at your side."
msgstr "이 무거운 짐을 홀로 지지는 마. 매 순간이 중요해. 게다가 난 함께 해주지도 못했는데, 너무 많은 부탁을 한 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 79ab6e92-53d6-603a-fd56-aed449b2298c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:79ab6e92-53d6-603a-fd56-aed449b2298c
msgctxt "h58e2825eg2fbeg42b8gb655gd4fa6246b6c3"
msgid ""
"What stayed behind would have been the strongest part of him. But after all "
"these years left in darkness, corruption must have taken hold."
msgstr "남겨진 절반이 테니엘의 가장 강한 부분이었을 거야. 하지만 어둠 속을 몇 년이나 헤매고 난 뒤에 어느 정도는 오염되었을 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 81798e07-9c20-25da-c463-8bb6485ab548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:81798e07-9c20-25da-c463-8bb6485ab548
msgctxt "h8402c716g650eg4730gb03egb2341e215911"
msgid ""
"Yes, and so it must remain. I wish you success on your path. Had things been "
"different, I might have walked it with you."
msgstr "맞아, 앞으로 그래야지. 네 여정의 성공만을 빌겠어. 상황이 달랐다면, 너와 함께 했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 835e1c12-8c2b-fcb0-63fc-1e778bceea5b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_LiftingTheCurse_State_HalsinRecruitable = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:835e1c12-8c2b-fcb0-63fc-1e778bceea5b
msgctxt "h3280f4afg66d0g4cc0gb477gda3a7a3da562"
msgid ""
"If you want me, I'm yours. Against the curse, against the Absolute - "
"anything. Just say the word."
msgstr "원한다면 함께 하지. 저주든, 절대자든 무엇에게라도 맞서겠어. 언제든 불러줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 83b85f0f-c866-192a-569e-1c7a530d4ec7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:83b85f0f-c866-192a-569e-1c7a530d4ec7
msgctxt "h68fe6d2cg12c1g427dgbe4bg3e8efac617f0"
msgid ""
"Good - this is what we've been lacking. Now there's a chance we can find "
"Thaniel, and bring him home."
msgstr "좋군 - 우리에게 필요하던 거야. 이제 테니엘을 찾아서 집에 데려올 수 있는 기회가 생겼어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 8624e2ab-ef82-4c40-c03b-a57d67086af7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_PermaDefeated = True
#.      - HAV_LiftingTheCurse_State_KnowsBreathLocation = True
#.      - GLO_LiftingTheCurse_Event_TravelToLakeside = False
#. SetFlags:
#.   Global:
#.     - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:8624e2ab-ef82-4c40-c03b-a57d67086af7
msgctxt "h252603fbgbe43g45a1ga77fg4d216e672df1"
msgid "<i>Share what you learned of Thaniel's presence in the Shadowfell.</i>"
msgstr "<i>섀도펠에서 테니엘의 존재로부터 얻은 정보를 알려준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 88c76f5c-d031-4fd2-9a0a-825fe5207006
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:88c76f5c-d031-4fd2-9a0a-825fe5207006
msgctxt "hb5e3805egac86g4f90g86e1gaa79052ec711"
msgid ""
"Thaniel still suffers. There'll be no improvement until his essence is "
"restored, I fear."
msgstr "테니엘은 여전히 고통받고 있어. 그의 영혼이 회복되기 전까지 어떠한 호전도 기대할 수 없을까 걱정이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 89edf81b-7de1-fba6-5b6c-09112266a265
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_OliversDiary_Event_RestoreAtHouse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:89edf81b-7de1-fba6-5b6c-09112266a265
msgctxt "h72c6700ag0750g4939g877bgd471a14bfbe6"
msgid ""
"Perhaps not - if he truly is a part of Thaniel, then he is beyond life and "
"death. More likely he's just hiding. We should return to where you saw him."
msgstr ""
"죽지 않았을 거야 - 그 애가 테니엘의 일부라면, 생사는 초월했을 테니까. 그냥 숨어 있을 가능성이 크지. 네가 그 애를 본 장소로 "
"가봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 8b8859cf-1dcf-29e7-ae04-0a4cdc7427ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_MaxPlayerCountReached = True
#. SetFlags:
#.   Global:
#.     - GLO_Tutorials_FullPartyRejection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:8b8859cf-1dcf-29e7-ae04-0a4cdc7427ca
msgctxt "ha2d8117dg5ed1g4dafga9d2g0ed5887a1ee3"
msgid ""
"Seems your ranks are quite packed. If some space frees up, I'll be ready for "
"you."
msgstr "일행이 꽉 찬 것 같군. 자리가 나면, 합류하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 8d371168-d40c-72d2-9db9-f3ffada3bbdb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:8d371168-d40c-72d2-9db9-f3ffada3bbdb
msgctxt "h7cebc216gc6c1g4db1g864agccb988eefa69"
msgid "I'll see what I can do, but no promises."
msgstr "뭘 할 수 있을지 보겠지만, 장담은 못 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 9082659c-6977-7c89-d175-f315566a4afa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:9082659c-6977-7c89-d175-f315566a4afa
msgctxt "hfcf83b59g0a3dg4993gb593g09f6b6eb240d"
msgid "I knew I could put my faith in you. If only we had met sooner."
msgstr "너를 믿기로 했던 내 결정이 옳았군. 더 빨리 만났다면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 90d9a312-eaad-20ab-1400-444c85813d76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:90d9a312-eaad-20ab-1400-444c85813d76
msgctxt "h36a94f56g6a18g4c77gb89dg7538002369c7"
msgid ""
"And I truly mean <i>we</i>. Every moment counts, and I've asked much of you "
"already without being at your side."
msgstr "<i>함께</i> 가겠단 건 진심이네. 매 순간이 중요해. 그간 함께 해주지도 못했는데, 이미 네게 너무 많은 걸 부탁했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 934b5c97-cf02-c6fc-d646-a0aa3e099bac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Origin_BlockWaitInCampOption(0) = False
#.      - ORI_State_Recruited(0) = True
#. SetFlags:
#.   Object:
#.     - OriginRemoveFromPartyAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:934b5c97-cf02-c6fc-d646-a0aa3e099bac
msgctxt "hb2c20c3bg0931g4930g8f96gfa59e5c85220"
msgid "I need you to remain at camp for now."
msgstr "잠시 야영지에 머물러 줘요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 9a81da08-1343-1915-911b-0eda8b3b306a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:9a81da08-1343-1915-911b-0eda8b3b306a
msgctxt "h686eff4cg1f7eg41fega57fg960763ea62b7"
msgid "This 'more' that you want. What is it?"
msgstr "원하는 게 '더' 있다니 그게 뭐죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 9b4c87a5-a311-e986-158b-0ee555dadfc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:9b4c87a5-a311-e986-158b-0ee555dadfc1
msgctxt "h5fe39d72ge210g4618g91aag6aa06ada20de"
msgid "I'm glad to have you."
msgstr "다시 함께하게 되서 기쁘군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 9bda4ca3-d936-f79d-b529-0920d4d238b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:9bda4ca3-d936-f79d-b529-0920d4d238b4
msgctxt "hf2660448gd2f5g4d0fgbc1fg35314e61a0e9"
msgid ""
"And you saw this boy yourself? That can't be a coincidence - but we need to "
"be sure."
msgstr "그 아이를 직접 본 건가? 우연일 리가 없어 - 하지만 그래도 확실히 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = 9c89d664-ec53-237e-73fe-110fb156dcb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_AskedWhatsNext(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhatsNext(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:9c89d664-ec53-237e-73fe-110fb156dcb0
msgctxt "h888aa833g35c5g40b7ga18bg602dbc612470"
msgid "What now? You've got what you wanted, after all."
msgstr "또 뭐죠? 결국 당신이 원하는 걸 얻었잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = 9dae217f-b8f5-7aa4-ba88-e7e7911b788a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:9dae217f-b8f5-7aa4-ba88-e7e7911b788a
msgctxt "he802f438g7f9bg4368g83a7gd781d8eaa78a"
msgid ""
"Perhaps there's still a way to learn something from him - the dead can't "
"deny their knowledge, if asked the right question."
msgstr "그래도 그에게서 얻을 만한 정보가 있겠지 - 망자에게 질문만 제대로 하면, 모른다고 하진 못할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = a03fb34c-e669-cea2-1ffd-4a5d2bedb0b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_State_HalsinGoToLake = True
#.     - GLO_LiftingTheCurse_Event_TravelToLakeside = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:a03fb34c-e669-cea2-1ffd-4a5d2bedb0b9
msgctxt "he64663ecg6066g4e6cg866ag20006fdea386"
msgid ""
"What comes next will prove dangerous. Meet me by the shore outside Last "
"Light - we can do our work there without imperilling others."
msgstr "위험한 일이 우릴 기다리고 있군. 피해를 끼치지 않고 일을 진행할 수 있도록 최후의 빛 여관 밖 호숫가에서 만나세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = a0819600-c83b-4d5e-8a2a-f511cc9b9eb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_CurseLiftedHasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:a0819600-c83b-4d5e-8a2a-f511cc9b9eb1
msgctxt "h3078de61g17e4g4926g8136g584e7bcea9f5"
msgid ""
"Thaniel rests well. He's healing very rapidly, now that Oliver has returned "
"to him."
msgstr "테니엘은 잘 쉬고 있어. 이제 올리버가 돌아왔으니 , 더 빠르게 회복하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = a8cb9795-9934-659f-3406-2a6441787ed6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:a8cb9795-9934-659f-3406-2a6441787ed6
msgctxt "hc63d1203ge96fg43a3ga054gcfef9e32dbc8"
msgid "Not what. <i>Who.</i> But all in due course."
msgstr "물건이 아니라 <i>사람</i>이야. 하지만 때가 되면 말해주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = af4db53e-2434-a2d7-3928-f0e56c2d4794
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_Event_AddOliversHouseToMap = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:af4db53e-2434-a2d7-3928-f0e56c2d4794
msgctxt "h3afa5712g5290g456dg88f0g8f3632815c12"
msgid ""
"There is a ruin, some way outside of Last Light. I caught a glimpse of fresh "
"blooms there, but did not investigate further. I shall mark it upon your map."
msgstr ""
"최후의 빛에서 멀지 않은 곳에 폐허가 하나 있다네. 거기서 생생하게 핀 꽃을 스치듯 봤지만, 더 조사해 보진 않았어. 자네 지도에 표시해 "
"줌세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = afd9b377-4f99-51d5-dfcc-491c04bc3e27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_HalsinRecruitable = True
#.   Object:
#.      - ORI_State_Recruited(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:afd9b377-4f99-51d5-dfcc-491c04bc3e27
msgctxt "he29523fagfd70g41cbga15eg4999e7889fb9"
msgid "Join me."
msgstr "함께 가요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = b44ddea6-5543-8d51-ac29-a96f7ef87e82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:b44ddea6-5543-8d51-ac29-a96f7ef87e82
msgctxt "h689259bbgd5ecg4bc4gb411gb9416eb48d60"
msgid ""
"The same. I had hoped I might have been able to stay by your side, to help "
"however I could. But the Oak Father has spoken - my place is here."
msgstr ""
"동감이네. 네 옆에 계속 함께하며 힘 닿는 대로 도울 수 있기를 바랐어. 하지만 참나무 아버지께서 내 자리는 여기라고 말씀하셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = b728cbdf-64cb-b1dd-5e07-3c07bc5a09a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:b728cbdf-64cb-b1dd-5e07-3c07bc5a09a9
msgctxt "h4f9a4e83g5165g4d66g9822g220cb85092e2"
msgid "Do as you wish."
msgstr "원하는 대로 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = babd1ae0-d3e5-5c70-f0ea-1c7431a0d7f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = False
#. SetFlags:
#.   Dialog:
#.     - CAMP_Halsin_Event_AskedForAdviceFindingHeart(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:babd1ae0-d3e5-5c70-f0ea-1c7431a0d7f7
msgctxt "hb4a596dcgec4eg412dgb1c8g20f96e77d20c"
msgid "Any ideas on how to find this missing half?"
msgstr "잃어버린 반쪽을 어떻게 찾을지 생각해 봤나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = c5408667-f9c6-e6c8-5a3c-d96513c966f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = True
#. SetFlags:
#.   Global:
#.     - GLO_LiftingTheCurse_State_ToldHalsinAboutOliver = True
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:c5408667-f9c6-e6c8-5a3c-d96513c966f6
msgctxt "h7f46693ag6e9fg4a6eg9d9bgca68e800de9c"
msgid ""
"I met a shadow child named Oliver, resembling Thaniel - but he's dead now."
msgstr "테니엘을 닮은 올리버란 이름의 그림자 아이를 만난 적 있어요 - 지금은 죽었지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = c6be5c7d-9cc9-76a8-7792-4893e7dcc483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:c6be5c7d-9cc9-76a8-7792-4893e7dcc483
msgctxt "h8b5b8831g17c1g4ac6g978cge9c75389e1b1"
msgid ""
"Only, the missing half may not come willingly. The curse will have sunk its "
"tendrils deep, twisting Thaniel's essence into something... else."
msgstr ""
"하지만, 잃어버린 반쪽은 스스로 돌아오지 않을 수도 있어. 저주가 그 뿌리를 깊이 내리고, 테니엘의 본질을 다른... 무엇으로 왜곡했을 "
"거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = d2b70ca8-ee8c-e6b1-c4a5-b334d2ecc3b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:d2b70ca8-ee8c-e6b1-c4a5-b334d2ecc3b4
msgctxt "h65f90bb2g30a2g443bg8f2bg1822d95e0840"
msgid ""
"I hope they will remain as a pair. It would be good for them both to have a "
"friend, once I'm gone."
msgstr "난 그들이 한 쌍으로 남기를 바라네. 내가 떠나고 나서도 서로 친구가 되는 것이 그 둘에게도 좋을 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = d684f9fd-e437-60f8-6f8a-a0a61b0aa552
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_PlayerReactiontoCurseSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:d684f9fd-e437-60f8-6f8a-a0a61b0aa552
msgctxt "hfcd52154g2c18g4573g8df2g86d819b7b14e"
msgid ""
"I hope you've no more requests - I need to take care of my own problems."
msgstr "이제 부탁은 그만 해주면 좋겠군요 - 해결해야 할 일이 있어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = d7e028ab-29e2-5442-cab8-e99198965a07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:d7e028ab-29e2-5442-cab8-e99198965a07
msgctxt "h8f6b5ca1gc883g474eg8732gf5810938d3af"
msgid "I'm sorry things didn't turn out differently."
msgstr "일이 이렇게 풀려서 유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = d87486af-d465-5357-0516-a429a755d4d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:d87486af-d465-5357-0516-a429a755d4d2
msgctxt "ha3eb90f8g7a29g450ega32agbd9d4cecd0ed"
msgid "You have to come - I need you."
msgstr "함께 가야 해 - 네가 필요하다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = d90b60cc-5021-cbc0-f33d-c29abd4dc692
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:d90b60cc-5021-cbc0-f33d-c29abd4dc692
msgctxt "hd76d7325gda20g44f5gb080ga2bc59474b08"
msgid "And I'm glad to be had - glad to be with you, I mean."
msgstr "나야말로 받아줘서... 아니, 함께 해주어 다행이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = e1352bd7-cadf-8e82-bad0-7da30736d3ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:e1352bd7-cadf-8e82-bad0-7da30736d3ee
msgctxt "hcf791cdfgf256g4041g9719g42e62b427d7c"
msgid ""
"In truth, I'm not sure. This is beyond all reckoning. It's still part of "
"Thaniel, deep down, but it may not recognise that, or <i>want </i>to "
"recognise that."
msgstr ""
"솔직히 잘 모르겠어. 추측하기 무척 어려운 일이지. 그 정수는 테니엘의 일부일지라도, 내면으론 깨닫지 못하고 있을 수도, <i>깨닫고 "
"싶어 할 수도</i> 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = e158aad9-e45f-ed40-027a-355d11eecb25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:e158aad9-e45f-ed40-027a-355d11eecb25
msgctxt "h2bda45fcg7932g4933g88e9g933e254b358a"
msgid "Perhaps we can still do something to lift the curse."
msgstr "저주를 풀 기 위해 뭔가를 더 해볼 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = e5f642e5-39c5-3700-d56a-69be64d1e6d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:e5f642e5-39c5-3700-d56a-69be64d1e6d5
msgctxt "hab7a1f28gc4c1g459agbcc4g4ecc9d2cf18b"
msgid ""
"Poor soul... but in truth, if I had to choose between death and the "
"Shadowfell, I'd choose death."
msgstr "가련한 영혼이여... 솔직히 섀도펠과 죽음 사이에서 골라야 한다면 난 죽음을 택하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = e8a17725-a255-d018-7655-f9e149b9e2fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_Event_OliverAppears = True
#.      - SCL_OliversDiary_State_DefeatedAtHouse = False
#. SetFlags:
#.   Global:
#.     - GLO_LiftingTheCurse_State_ToldHalsinAboutOliver = True
#.     - SCL_ShadowCurse_Knows_Oliver_Is_Thaniel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:e8a17725-a255-d018-7655-f9e149b9e2fa
msgctxt "h306f0cb0g1c0eg429eg9607gef5f1e3b53b8"
msgid ""
"I met a sort of shadow child before - a little boy named Oliver. Around "
"Thaniel's age."
msgstr "전에 그림자 아이와 비슷한 아이를 봤어요. 테니엘 또래의 올리버란 남자 아이였죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = e969d9a3-a088-abab-b347-49035ca7061a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:e969d9a3-a088-abab-b347-49035ca7061a
msgctxt "hb99e9898g523fg4b94gb422g89a7ac374836"
msgid ""
"Anyway, once the curse is lifted, nature can take its course without me. I "
"belong at your side."
msgstr "아무튼, 저주가 일단 풀리면, 자연이 알아서 길을 찾을 거야. 이제 네 곁에 머물 생각이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = eaffa79d-2894-38c5-d9f5-d00459aa3f28
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - OriginAddToParty(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:eaffa79d-2894-38c5-d9f5-d00459aa3f28
msgctxt "ha942a0fag25bdg43beg871cg4f3558c92818"
msgid "Good. Now our roots can deepen - together."
msgstr "좋아, 이제 우리의 뿌리가 함께 깊어지겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = ec1cb263-95b6-e52b-5c97-7c2851128658
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:ec1cb263-95b6-e52b-5c97-7c2851128658
msgctxt "h72838e2eg50a3g4b0bg8240g96858d38ce3c"
msgid ""
"By now, we should have seen some small glimmer of Thaniel's power - a sign "
"that the land is healing. New growth, flowers in bloom. But there has been "
"nothing."
msgstr ""
"지금쯤이면 테니엘의 힘이 조금이나마 돌아왔어야 해 - 새싹이 트고, 꽃이 피는 것처럼, 이 땅이 치유되고 있다는 신호도. 하지만 전혀 "
"없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = ef0ab69f-defd-c887-ec91-77dc722295c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:ef0ab69f-defd-c887-ec91-77dc722295c6
msgctxt "h908d277agffe9g48afga989g629bfb4a9c99"
msgid ""
"Out there the curse still thrives. I failed this place - now I must remain "
"behind, and stand watch over it."
msgstr "밖에는 여전히 저주가 기승을 부리는데, 난 여길 구하지 못했어 - 남아서 계속 지켜봐야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = f231e9b1-41e0-1457-c1e7-5d9be476b1bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:f231e9b1-41e0-1457-c1e7-5d9be476b1bf
msgctxt "h2e29f936g6024g472egbf81gb3bfbd4c84d9"
msgid ""
"You are not bound by social niceties, I see. I like that. Perhaps I can show "
"you just how much, another time."
msgstr "사교적인 예의에 매달리지 않는 편이군. 맘에 들어. 나중에 기회가 되면 나의 그런 면도 보여주겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = f562128c-4a51-462d-bc78-5664fd72ffb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinWaitingInCamp = True
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_Knows_SeekingBreath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:f562128c-4a51-462d-bc78-5664fd72ffb4
msgctxt "h83271cb2ga7d1g4f0eg9785g50b53eb8e095"
msgid "Thaniel rests still, but it's no easy slumber."
msgstr "테니엘은 조용히 쉬고 있지만, 절대 편안한 휴식은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = f8c45110-8eba-6d37-3a82-524c7d561de2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_FlirtHint(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:f8c45110-8eba-6d37-3a82-524c7d561de2
msgctxt "h21b34439gfa62g4de7gba57g85daf526cd42"
msgid "I have. But perhaps there is more that I want..."
msgstr "그랬지. 근데 원하는 게 더 있는 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = f8ed5b1e-593c-6b3e-0ed1-5034fa8680b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:f8ed5b1e-593c-6b3e-0ed1-5034fa8680b8
msgctxt "h8444c3c4g0dd9g4fa8g974eg9b062d3ea9e7"
msgid "Can it be undone?"
msgstr "되돌릴 수 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Player
#. NodeID = faa1cffd-aca1-3eaa-b150-d53b673ac60b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Halsin_Event_AskedWhenCurseWillLift(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCE_Halsin_Event_AskedWhenCurseWillLift(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:faa1cffd-aca1-3eaa-b150-d53b673ac60b
msgctxt "hbab65f5bg1a86g4516g8e8bg69d2a33d7def"
msgid "So when will the curse actually be lifted?"
msgstr "그래서 저주는 언제 실제로 풀리는 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin
#. Speaker = Halsin
#. NodeID = fd530fdb-c14a-c575-d4f3-a1f6872a877c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Halsin:fd530fdb-c14a-c575-d4f3-a1f6872a877c
msgctxt "h1c57cbb6g0d7eg4868g9d0dgd8a2050334a8"
msgid "Perhaps - if we can find Thaniel's lost half, and make him whole again."
msgstr "가능해 - 잃어버린 반쪽을 찾아 그를 완전하게 만들 수 있다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 0478c8ef-c064-1a6e-4539-a52ca1e95d7b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_TieflingFollowUp_Knows_MeanAboutMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:0478c8ef-c064-1a6e-4539-a52ca1e95d7b
msgctxt "hbc39a667g60b8g40b1gb6eag5fc5feac04a1"
msgid ""
"And I bet you'll be dead in a ditch before you even <i>smell </i>Baldur's "
"Gate! Go away!"
msgstr "넌 발더스 게이트의 <i>냄새</i>도 맡기 전에 어디 흙더미에서 죽게 될 거야! 저리 가버려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Player
#. NodeID = 16b0d304-6ff3-8b74-eb4b-8bf14e4198c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:16b0d304-6ff3-8b74-eb4b-8bf14e4198c5
msgctxt "ha7f6e1fdg39b4g42aagaf65gbbbbf3f27eb0"
msgid ""
"Somewhere unpleasant. But I didn't see Mol - she's probably safe somewhere."
msgstr "불쾌한 곳이었어. 하지만 몰은 안 보였어 - 아마 어딘가에 안전하게 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 3cc48a58-718c-d145-070f-80618b965357
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:3cc48a58-718c-d145-070f-80618b965357
msgctxt "h4c878b28gc4e4g4f31g8c15gc7b87626f7e9"
msgid ""
"'Course she is! You hang onto that - I bet Mol'll be angry at you for "
"touching her stuff."
msgstr "당연하죠! 잘 챙겨두세요. 몰은 분명히 자기 물건 건드렸다고 화낼거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 434a57fd-dedc-84af-dbdc-bef57bf99607
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_TieflingFollowUp_Ide_HasMet(1) = True
#.   Global:
#.      - SCE_BackupLeader_State_Dead = True
#.      - SCE_BackupLeader_State_AtEpilogue = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:434a57fd-dedc-84af-dbdc-bef57bf99607
msgctxt "h3e0164f0g8360g41e0gb492g870eb0c98214"
msgid "Mattis'll get us to Baldur's Gate - I know it. And Mol'll be there!"
msgstr "매티스가 우릴 발더스 게이트로 데려갈 거예요 - 몰도 거기 있을 거고요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 46a15e71-31d9-2e38-4925-f170a2d64a9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_TieflingFollowUp_Ide_HasMet(1) = True
#.   Global:
#.      - DEN_TieflingBard_State_Unavailable = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:46a15e71-31d9-2e38-4925-f170a2d64a9f
msgctxt "h779ae46dgc4c3g4c3bg985cg1f2af029acd6"
msgid ""
"If Mol were here, she'd have cracked Ketheric's skull before you even got "
"close to him."
msgstr "몰이 있었다면 당신보다 먼저 케서릭의 머리를 깨버렸을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 4e99e51d-cc35-397d-dc29-84e09f4e8bc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#.      - SCE_TieflingFollowUp_Knows_MeanAboutMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:4e99e51d-cc35-397d-dc29-84e09f4e8bc9
msgctxt "h631ae01bg4fe0g4724gab66g8ee10aa37850"
msgid "<i>Gha sha chydd!</i> Leave us alone!"
msgstr "<i>가 샤 쉬드!</i> 우릴 내버려 둬!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 67240439-59ad-0767-b751-e4f451ea3f28
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:67240439-59ad-0767-b751-e4f451ea3f28
msgctxt "he6c064cagba7eg408fg99e0gc199dc916922"
msgid "This <i>is</i> Mol's... Where did you find it?"
msgstr "<i>이건</i> 정말 몰의 것인데... 어디서 찾았죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 6823eda5-9932-a09d-c043-dbd12321261e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_BackupLeader_State_Dead = True
#.      - SCE_BackupLeader_State_AtEpilogue = True
#. SetFlags:
#.   Dialog:
#.     - SCE_TieflingFollowUp_Ide_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:6823eda5-9932-a09d-c043-dbd12321261e
msgctxt "hb0a9225eg09cfg4702g9e21g633f0b25ced0"
msgid ""
"Now you've smashed Ketheric, Mattis said it's safe to go to Baldur's Gate - "
"thank you!"
msgstr "당신이 케서릭을 뭉개버린 덕분에, 매티스가 우린 발더스 게이트로 안전하게 갈 수 있대요 - 고마워요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 7c8952e6-e085-ad55-220f-64007f344e3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_TieflingFollowUp_Ide_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:7c8952e6-e085-ad55-220f-64007f344e3a
msgctxt "hd030400eg6144g44b1g8d6bga36b8b853293"
msgid "When did singing ever save anyone anyway?"
msgstr "노래가 누굴 구한 적이 있기나 해요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = 98125d0f-8701-b8fe-da76-3caa3b18ff5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_Unavailable = True
#. SetFlags:
#.   Dialog:
#.     - SCE_TieflingFollowUp_Ide_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:98125d0f-8701-b8fe-da76-3caa3b18ff5e
msgctxt "hc8cb8777g8cc2g4f96ga9d3gc2731f2957fe"
msgid ""
"You did it! You squished Ketheric! I knew you could do it - even if Mol said "
"you couldn't."
msgstr "해냈군요! 케서릭을 물리쳤어요! 전 해낼 거라 믿었어요 - 몰은 못해낼 거라고 했지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = a95611ac-1cca-744a-e860-2cd7038ee737
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_TieflingFollowUp_Ide_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:a95611ac-1cca-744a-e860-2cd7038ee737
msgctxt "h58967b6dg924ag4454gbe9dg05cc66e06aef"
msgid ""
"Alfira's writing us a song - a stupid song won't bring Mol back! Tell her, "
"won't you?"
msgstr "알피라가 우릴 위한 노래를 만들고 있어요 - 바보같은 노래가 몰이 돌아오게 해주는 것도 아닌데! 가서 말 좀 해주겠어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Player
#. NodeID = abe284f4-1c27-d9fe-b664-ff546d09f9a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:abe284f4-1c27-d9fe-b664-ff546d09f9a4
msgctxt "hf94639d5g1970g4e36g93a8g38e1ab776702"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = c38c711d-dba2-0a05-9033-96d812326522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:c38c711d-dba2-0a05-9033-96d812326522
msgctxt "h24eb2cd7g329ag441cg82cfg98841b0f2ab1"
msgid ""
"Just because you found that somewhere spooky doesn't mean she's dead - "
"you'll see!"
msgstr "기분 나쁜 곳에서 그걸 찾았다는 게 몰이 죽었다는 의미는 아니에요 - 두고 봐요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Player
#. NodeID = c54290d6-b242-993a-368c-25017d56ba3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:c54290d6-b242-993a-368c-25017d56ba3c
msgctxt "h1aa93088gf474g4ba5ga089g6acac9721c22"
msgid "In a place filled with death. Mol's gone - I'm sorry."
msgstr "시체가 가득한 곳에서 찾았어. 몰은 죽었어 - 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Player
#. NodeID = c7578e61-3baa-b984-6e93-ed3b37e04b5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:c7578e61-3baa-b984-6e93-ed3b37e04b5d
msgctxt "h7e2f14caged7bg486cg93bbg500bfc4c7a11"
msgid "I found Mol's eyepatch."
msgstr "몰의 안대를 찾았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Player
#. NodeID = d8a33ed5-5ad7-086d-4546-d3476ee268ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:d8a33ed5-5ad7-086d-4546-d3476ee268ae
msgctxt "h1a97a306g499fg4403gb5b1ga8cc761d0465"
msgid "What does it matter? Your friend's dead anyway."
msgstr "무슨 상관이야? 어쨌거나 네 친구는 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide
#. Speaker = Ide
#. NodeID = dbb4e5e1-130a-cb02-7ffb-467fc2b591c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_TieflingFollowUp_Ide_HasMet(1) = True
#.   Global:
#.      - SCE_TieflingFollowUp_Knows_MolMissingEyepatch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Ide:dbb4e5e1-130a-cb02-7ffb-467fc2b591c9
msgctxt "h7238021dgb863g4d4dg93cbg3685a1cd079d"
msgid ""
"Mol's probably already at Baldur's Gate - she'll tell you where to stick "
"that eyepatch when you get there."
msgstr "몰은 아마 벌써 발더스 게이트에 도착했을 거예요. 도착하시면 그 안대를 어디다 붙일지 알려 줄 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 0128aac9-c8ff-c5d0-564e-aac9433d3139
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:0128aac9-c8ff-c5d0-564e-aac9433d3139
msgctxt "h540d7f8bg4dd1g49aega385ge18d5d98ea56"
msgid "Yes - but I'll expect you to share what you claim to know about me."
msgstr "그러지 - 대신 나에 대해 알고 있는 것들을 다 이야기해줘야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 052d0ce6-e6cd-a1cb-cad3-e3bd3c1a0d53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:052d0ce6-e6cd-a1cb-cad3-e3bd3c1a0d53
msgctxt "hfbf5e44cg9e4cg41bfga735g95e643c89a1c"
msgid ""
"I'm here. A-and so are you. And my father, he - he can't hurt us any longer."
msgstr "여기 있어.. 너와 함께.. 아버지는.. 그 사람은 더 이상 우릴 해치지 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 0589c7c1-7a53-e26f-6f53-4315fe53a2fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:0589c7c1-7a53-e26f-6f53-4315fe53a2fa
msgctxt "ha5acbac3g6961g49d1g801bgee9b342833be"
msgid "We have met. The instigator of my despair - and then my elation."
msgstr "이미 만난 사이야. 나에게 절망과 기쁨을 안긴 사람이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 0c30c2db-62bb-d3da-9430-3a3a424d7ef3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:0c30c2db-62bb-d3da-9430-3a3a424d7ef3
msgctxt "h533cb3abg7144g4c80gb85cg18626e783643"
msgid ""
"I gave my word, and I will keep it. By the fires of your camp's hearth, we "
"will discuss all we must."
msgstr "내가 약속했으며, 반드시 지키겠다. 야영지의 모닥불에서, 우리에게 필요한 모든 것을 논의하기로 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 14707c12-9b92-21b4-bd5e-939de228ddeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:14707c12-9b92-21b4-bd5e-939de228ddeb
msgctxt "ha82181efgbc64g4342ga2bcg69de8f68020f"
msgid "Very good. We look forward to it."
msgstr "좋아. 기대하고 있을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 16079e1e-a79b-1491-21b1-e6bde91dd1ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:16079e1e-a79b-1491-21b1-e6bde91dd1ca
msgctxt "hcd0f95e5g8295g40c8gba21gde688383a005"
msgid "If we meet again, it will be my pleasure."
msgstr "다시 만날 수 있다면, 전 기쁠 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 1d86895b-3595-4c1d-54e3-aef7b12b3196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:1d86895b-3595-4c1d-54e3-aef7b12b3196
msgctxt "hdfa1ad2eg75cag48f0ga57cge4affe110a1c"
msgid "<i>Sorry.</i>"
msgstr "<i>미안해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 203390e3-4bf4-b27e-0b42-aba43bd3b25a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:203390e3-4bf4-b27e-0b42-aba43bd3b25a
msgctxt "h592e932bg0872g4584g85a0g03c84582d951"
msgid ""
"Now - you will leave us. We must take succour in one another's bodies and "
"words."
msgstr "이제 - 우릴 내버려 둬. 우린 몸과 마음을 다해 서로를 위로해야 하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 2bbe3cbd-7c34-6154-098d-a464de215143
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:2bbe3cbd-7c34-6154-098d-a464de215143
msgctxt "h10317b81g07f1g4d0dg9b62g8b6e576c2fbe"
msgid "No - if you have something to say to me, say it now."
msgstr "아니 - 말할 게 있다면, 지금 바로 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 2d72299a-a6e8-5275-2398-99d3338f87f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:2d72299a-a6e8-5275-2398-99d3338f87f6
msgctxt "h0f8ff19cg61cbg476eg9ac1ga3d314d608f2"
msgid "We'll make our visit brief. Cleric's honour."
msgstr "오래 머물진 않을 거예요. 클레릭의 명예를 걸고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 399f4790-5651-6568-11bc-e68fefe69511
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:399f4790-5651-6568-11bc-e68fefe69511
msgctxt "hdb102618g0f42g4129gbe33ge3bcb8e08cac"
msgid ""
"But Dame Aylin's life is neverending. And she does not forget. Now - I "
"believe Isobel asked a question of you. We will meet you in your camp - is "
"it agreed?"
msgstr ""
"하지만 나, 여기사 에일린의 삶은 영원하고, 잊어버리진 않을 거야. 자 - 이소벨이 네 의견을 물었지. 네 야영지에서 만나자는 제안 - "
"동의하는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 3cac883a-f877-0c84-c26a-f33713e512f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:3cac883a-f877-0c84-c26a-f33713e512f6
msgctxt "h1c23c4d1g4bdcg4a2dga9cagd404bcddaa78"
msgid ""
"I am. And I'm glad he's dead. But this is precisely what I want to speak to "
"you about later. It'll keep, I promise."
msgstr "맞아요. 그리고 그가 죽어서 기쁘죠. 하지만 이 얘긴 나중에 해도 늦지 않아요. 제가 약속하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 3feadbd5-a72d-d185-923e-1cdedbcf8a27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:3feadbd5-a72d-d185-923e-1cdedbcf8a27
msgctxt "h917a19f4g9218g4c04gb7b5g20f2f1ea9930"
msgid "My love... you were dead. I saw your body..."
msgstr "내 사랑... 넌 죽었었는데... 분명 시체를 봤어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 40fa058b-c265-c8ad-18ce-1e1f7b140c7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:40fa058b-c265-c8ad-18ce-1e1f7b140c7b
msgctxt "h9f9e8aefgdfaag431eg8805g15a54208f43a"
msgid ""
"We must watch this one closely, Isobel. Their motivations are suspect - aye, "
"suspect indeed."
msgstr "우린 이 자를 주의 깊게 지켜봐야 해, 이소벨. 그 동기가 의심스럽거든 - 그래, 정말로 의심스럽지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 42bcce78-cae8-db9f-e3c5-64c7b631e25c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:42bcce78-cae8-db9f-e3c5-64c7b631e25c
msgctxt "hd831e0d1g7fc5g49d5g9659gb1f785429e79"
msgid ""
"Firstly, allow me to apologise to Dame Aylin. My actions were strategy - not "
"personal."
msgstr "먼저 에일린에게 사과하고 싶어. 내 선택은 전략에 불과했을 뿐 개인적인 감정은 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 484c8794-e203-796b-dd86-53499ca7fa65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:484c8794-e203-796b-dd86-53499ca7fa65
msgctxt "h7d0e78f9g73cdg43eeg8fd8g27c08fbacf62"
msgid "I doubt that. You go your way, and I'll go mine."
msgstr "글쎄. 그냥 서로 갈 길을 가는 게 어때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 4ae7f9ca-d9f6-f7b5-ab5b-32f21a205302
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:4ae7f9ca-d9f6-f7b5-ab5b-32f21a205302
msgctxt "h68c79ef6g311ag4355g8b71g4c03ed67c920"
msgid ""
"I dreamt every night that you'd come back to me. That somehow it was all a "
"nightmare dawn would undo."
msgstr "매일 밤 네가 돌아오는 꿈을 꿨어. 모든 게 다가오는 아침이 깨워줄 악몽이라고 생각했었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 4fb29914-ee41-4c51-8d9b-43777b46aa61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:4fb29914-ee41-4c51-8d9b-43777b46aa61
msgctxt "h285b734fg4095g41c3gba2fge75f5115f910"
msgid ""
"Ahem. Listen, we need time to figure out what the hells has happened. I "
"thought Aylin dead. She thought the same of me."
msgstr ""
"에헴. 들어봐요, 그간 대체 무슨 일이 있었는지 돌이켜볼 필요가 있어요. 전 에일린이 죽었다고 생각했고. 그녀는 제가 죽었다고 생각했었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 671e3cac-f99b-09d8-857d-571b3475d496
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:671e3cac-f99b-09d8-857d-571b3475d496
msgctxt "hdcbd1207g39c5g4967gbcf9g171f7eb41637"
msgid "I'd like to hear why you lied to me about being Ketheric's daughter."
msgstr "당신이 케서릭의 딸이라는 사실을 숨긴 이유를 알려 줬으면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 6898fd10-7e3c-10d0-7251-71a494f6900f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:6898fd10-7e3c-10d0-7251-71a494f6900f
msgctxt "hcd38462fgaa6dg401agaeb7gdd6ffba6483b"
msgid "Did I hear you correctly before? Are you Ketheric Thorm's daughter?"
msgstr "내가 제대로 들은 게 맞아? 네가 케서릭 쏨의 딸이라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 69977a83-7c25-514c-f55d-49681b884ee5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:69977a83-7c25-514c-f55d-49681b884ee5
msgctxt "hefdc9e13g9cebg40b8ga950g50347660e60b"
msgid ""
"His soul was poisoned by the god of death. His sick devotion ruined him."
msgstr "그의 영혼은 죽음의 신에게 잠식당했어. 병적인 헌신이 그를 망쳤지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 76e895e7-66e2-e4be-dcff-bbb8e3527fa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:76e895e7-66e2-e4be-dcff-bbb8e3527fa8
msgctxt "h82387479gf881g4d77g877cg4dc330e2a0a0"
msgid ""
"Do not speak so abruptly to the mate of Dame Aylin, daughter of the "
"Moonmaiden, paladin of -"
msgstr "격식을 갖추어 말하거라, 감히 여기사 에일린, 달처녀의 딸이며 팔라딘인 나의 반려에게-"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 790de0a5-0555-bb1c-88c3-d63219a8c063
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelNightsongReunion_Followup_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:790de0a5-0555-bb1c-88c3-d63219a8c063
msgctxt "h2d8bc6acg2a94g4af3g9416g3d676db2f72e"
msgid "Begone! I must admire Isobel's fulsome beauty away from prying eyes."
msgstr "물러가라! 나는 엿보는 눈들을 피해서 이소벨의 충만한 아름다움을 찬미해야겠구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 7d341875-88ca-5b51-0d23-2df01d4eb54d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:7d341875-88ca-5b51-0d23-2df01d4eb54d
msgctxt "h49a2b527g7719g46b0gb81fg98a4421c0b5b"
msgid ""
"A hundred years hasn't changed you at all, my love. As for you - if we "
"aren't to meet again, I'll say my thank-yous. And my goodbyes."
msgstr ""
"백 년의 세월도 당신을 변케 하지 못했네요, 내 사랑. 그리고 당신 - 앞으로 다시 만날 일이 없다면, 미리 말해둘게요. 고맙습니다. "
"부디 안녕히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 85264710-5230-7768-bb2a-d07fdbd9ee5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:85264710-5230-7768-bb2a-d07fdbd9ee5d
msgctxt "he675a281g896dg4335gb820g809acc76dddb"
msgid "It's a little crowded already."
msgstr "지금도 약간 붐비는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 86503e44-4e63-8d91-cbbc-45826c0efcc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:86503e44-4e63-8d91-cbbc-45826c0efcc0
msgctxt "h9b336219g9606g4d93gab6bg62a1703b8c8c"
msgid ""
"We are not welcome, my love. No matter. We will hie us to the Hill of the "
"Headless Dancer and bare our flesh beneath the cleansing light of the moon's "
"soft gaze."
msgstr ""
"우릴 환영해주지 않는군, 내 사랑. 상관 없지. 우리 서둘러 머리 없는 무희의 언덕으로 향하자. 어서 달빛의 부드러운 눈길, 순결한 빛 "
"속에 서로의 살을 드러내자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 867e98d1-fa52-db2c-8774-e82f47aa40f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:867e98d1-fa52-db2c-8774-e82f47aa40f4
msgctxt "hfd96c04age106g48f0g87c5g8d11a29108d1"
msgid "You'd be most welcome."
msgstr "물론이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = 870c1b6b-cb7a-d43b-ff37-159517f00d05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_IsobgelNightsongReunion_HasMet = False
#. SetFlags:
#.   Global:
#.     - SCE_IsobgelNightsongReunion_HasMet = True
#.     - SCE_IsobelNightsongReunion_State_ReunionHappened = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:870c1b6b-cb7a-d43b-ff37-159517f00d05
msgctxt "hf2e00b55g3991g48cagac6cg15143f7c2943"
msgid "Aylin."
msgstr "에일린."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 872d21d6-d3d8-3396-fe21-bbe66a2e0f41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:872d21d6-d3d8-3396-fe21-bbe66a2e0f41
msgctxt "h6b7b01c4g01f3g4842g8628gf6267c398d3b"
msgid ""
"Ho! But we have met. This is the soldier that freed me most valiantly from "
"the Shadowfell."
msgstr "아, 이미 만난 적 있어. 여기 용사께서 섀도펠로부터 나를 용맹하게 구해냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 88629232-cfdd-700d-8ae1-96ea61230dd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:88629232-cfdd-700d-8ae1-96ea61230dd1
msgctxt "h3e28cce7g37d4g41b0g8a03gbe739486704f"
msgid ""
"They watched my boot crush the very brain of villainy - and fought well "
"against your changèd father."
msgstr "내 발이 악당들의 머리를 으깨는 것을 보았으며- 당신의 변해버린 아버지와도 훌륭히 싸웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = 92b26921-f6ed-62ff-df75-450cd3738372
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:92b26921-f6ed-62ff-df75-450cd3738372
msgctxt "hdeb43d44g3126g4abcgbdefg52c9d2f51953"
msgid "Fine. I'll see you at camp."
msgstr "좋아요. 그럼 야영지에서 봐요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 97fe5717-7f0d-d138-6e00-3a36e65cd4d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:97fe5717-7f0d-d138-6e00-3a36e65cd4d9
msgctxt "he297f665g6f33g4cbbg825eg477c8a65b1ef"
msgid "Isobel."
msgstr "이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = 98dd8007-3b5a-3387-b88d-69583f71e28d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:98dd8007-3b5a-3387-b88d-69583f71e28d
msgctxt "h2fd3224cg8f1eg4a08g917bgeeb74ad76364"
msgid "In this moment, I want for nothing."
msgstr "지금 이 순간만큼은, 다른 아무 것도 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = ab106aba-e511-419a-9ab9-261bb122d28f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:ab106aba-e511-419a-9ab9-261bb122d28f
msgctxt "hef86f273g781bg4354g94d5g0ce8dbb1466a"
msgid ""
"You there, Sharran - by the fires of your camp's hearth, we will discuss all "
"we must."
msgstr "거기 있었군, 샤의 추종자. 너희 야영지의 모닥불이라도 쬐면서 우리 일들을 논의해보도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = ac14a90c-ea46-3de0-9313-fdc4b6349191
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:ac14a90c-ea46-3de0-9313-fdc4b6349191
msgctxt "h73a47967ge92dg4dedgb53fgc1f5e08f8b4e"
msgid ""
"My forgiveness will be the same. I'd be a fool to turn down a powerful ally -"
" especially one who has earned the trust of fair Isobel."
msgstr "사과를 받도록 하지. 강력한 동맹을 마다하는 것은 바보 같은 짓이니까. 하물며 공명정대한 이소벨의 신임을 얻은 사람임에야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = b03d7a5e-a2e2-e86c-9fa1-d750d69d4d35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:b03d7a5e-a2e2-e86c-9fa1-d750d69d4d35
msgctxt "h8e297b19gd74eg4e3egb473g4e16c9d14564"
msgid "May he rest in peace at last, now that he's dead."
msgstr "그 분도 편히 쉬시길 바라요, 이젠 돌아가셨으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = b0faa231-a491-c02c-e694-40fbce35c27f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:b0faa231-a491-c02c-e694-40fbce35c27f
msgctxt "h0cd9da17g9a3fg4889ga94ag85326e96f3bf"
msgid ""
"Hmm - it sounds like we have much to discuss. Perhaps we could join you in "
"your camp later?"
msgstr "흠- 의논할 일이 상당히 많아 보이는군요. 당신의 야영지에서 뵈어도 괜찮을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = c4d03316-7d8f-ca9c-5957-4c1668d266b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:c4d03316-7d8f-ca9c-5957-4c1668d266b4
msgctxt "h24f1cbaegd3dag4860gab5ageb9dc880019a"
msgid ""
"Let us join you later. I'm sure we'd have much of interest to say to one "
"another."
msgstr "이따 뵙기로 하죠. 서로 나눌 말들이 많을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = c55d21a1-03ac-09b5-37dd-73f7b9e1dea6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFreed = True
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:c55d21a1-03ac-09b5-37dd-73f7b9e1dea6
msgctxt "h701046cfgfd9bg4594g9412g26bca5ae5a58"
msgid ""
"This so-called Sharran is known to me. I thought she'd run me through, but "
"she set me free instead."
msgstr "이 샤의 추종자와는 구면이야. 날 죽일 줄 알았는데, 거꾸로 나를 구해줬지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = cb4af101-ba36-bd06-ff6b-17981ffdf4cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:cb4af101-ba36-bd06-ff6b-17981ffdf4cb
msgctxt "had20c446g5a65g4c49g9072g0d60f15ceefc"
msgid ""
"That's a very good question. I know some parts. Some I haven't quite figured "
"out. But I'd like to tell you everything I know, if you'll have us at your "
"camp later."
msgstr ""
"좋은 질문이에요. 알고 있는 것도 있고. 아직 파악하지 못한 부분도 있어요. 제가 알고 있는 모든 건, 나중에 야영지에서 알려드릴게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = cf1fa12a-f665-1244-75b9-9d6bd67fb0ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:cf1fa12a-f665-1244-75b9-9d6bd67fb0ff
msgctxt "h2d248e22gfc08g4054gb2c7g6361f375b526"
msgid "I will be. And you?"
msgstr "괜찮아질 거야. 너는?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = d66ee5a8-2e54-2251-3098-3ee3ceee97e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_HasMet(2) = True
#.      - SCE_IsobelNightsongReunion_Followup_HasMet(2) = False
#.   Global:
#.      - SCE_IsobgelNightsongReunion_HasMet = True
#. SetFlags:
#.   Dialog:
#.     - SCE_IsobelNightsongReunion_Followup_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:d66ee5a8-2e54-2251-3098-3ee3ceee97e3
msgctxt "h2c7cc172gbe23g4b84gb1ccgb3a4d0a3a96d"
msgid "Ah! There you are. This is Aylin. Aylin, this is -"
msgstr "아! 여기 있었군요. 이쪽은 에일린이에요. 에일린, 이쪽은 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Shadowheart
#. NodeID = d7113eac-fb1f-2621-480f-c7cd26207a42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:d7113eac-fb1f-2621-480f-c7cd26207a42
msgctxt "h4fe4f499g2874g4438g9d98g0ef818b27d02"
msgid "I'll be ready. Whatever you have to say had better be worth your life."
msgstr "기다리고 있을게. 거기서 무슨 이야기를 하든 네 목숨을 걸 가치가 있어야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = dc109ead-b42c-dd4a-6000-680bfda35804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:dc109ead-b42c-dd4a-6000-680bfda35804
msgctxt "hf39d6d7bg8cd6g4ad5g8f58gf0682e4dca45"
msgid "You deserve to know that much - and more. It'll keep. I promise."
msgstr "당신은 그 정도 - 아니 그보다 더 알 자격이 있어요. 나중에 이야기해드릴게요. 약속해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = dcd22f80-ac5e-4c7d-90be-8a83edeb1496
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:dcd22f80-ac5e-4c7d-90be-8a83edeb1496
msgctxt "h430ebcb5g37c6g43e5g99c5g2fc64999db2d"
msgid "If Isobel has something to say to me, she can say it now."
msgstr "이소벨이 하고 싶은 얘기가 있다면, 지금 바로 해도 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = dcfccc4c-e07e-4fbf-923c-ce1315fb09c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:dcfccc4c-e07e-4fbf-923c-ce1315fb09c1
msgctxt "hb4e8a7c9g0c97g4535g8dcag5c2e8ec58e6d"
msgid "We look forward to it."
msgstr "기대하고 있을게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = e1755530-98a0-4c2b-332b-914932482075
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:e1755530-98a0-4c2b-332b-914932482075
msgctxt "h72432be1g1fb1g4b25ga33eg7894bf3868b8"
msgid ""
"I had no dreams at all. Nothing but darkness. And when I awoke, my father "
"said you were dead."
msgstr "난 전혀 꿈을 꾸지 못했어. 어둠 뿐이었지. 깨어나자, 아버지는 네가 죽었다고 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Nightsong
#. NodeID = e7b272b8-70b8-1844-da64-576bc48fffdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:e7b272b8-70b8-1844-da64-576bc48fffdc
msgctxt "h50f9e3cag7732g4db3g8e04g02dc52bf0bb4"
msgid "But for all his sins, he brought you back to me. Are you all right?"
msgstr "그러나 그의 모든 죄악으로, 내게 돌아왔구나. 괜찮아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = ee676613-a54a-fe23-4c1d-fcbdc6a2e930
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:ee676613-a54a-fe23-4c1d-fcbdc6a2e930
msgctxt "hed411ef8gae9dg4265gb510gf02d49aea2a4"
msgid ""
"I have more to thank you for than I knew. And we have much to discuss. "
"Perhaps we could join you in your camp later?"
msgstr "제 생각보다도 감사할 일이 많았네요. 의논할 일도 많을 것 같아요. 혹시 당신의 야영지에 우리를 초대해 주실 수 있을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = f276d1e7-eea7-7d54-70d5-030db5eb1200
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelNightsongReunion_Followup_HasMet(2) = False
#.   Global:
#.      - SCE_IsobgelNightsongReunion_HasMet = True
#. SetFlags:
#.   Dialog:
#.     - SCE_IsobelNightsongReunion_FirstTimeMeetingIsobel(2) = True
#.     - SCE_IsobelNightsongReunion_Followup_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:f276d1e7-eea7-7d54-70d5-030db5eb1200
msgctxt "h6a62fdc7gb31cg4a0cg8b96g3038989db558"
msgid ""
"Ah! It's you, isn't it? You're the talk of this place, you know. I'm Isobel, "
"and this is -"
msgstr "아, 당신이군요. 오늘의 주인공. 아시다시피 저는 이소벨이고, 이쪽은..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Player
#. NodeID = f884a585-fd74-9386-a9f2-447a54f3bf14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelNightsongReunion_FirstTimeMeetingIsobel(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:f884a585-fd74-9386-a9f2-447a54f3bf14
msgctxt "hb72e6a47g1226g4005gb956g4551f597a44c"
msgid "I hardly know you - what's your role in all this?"
msgstr "처음 뵙는 것 같군요 - 이 번 사건과는 어떤 관련이 있으신거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion
#. Speaker = Isobel
#. NodeID = fa9f73e4-3359-7e0a-8719-fbc1a4ccab02
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_IsobelNightsongReunion_JoiningCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelNightsongReunion:fa9f73e4-3359-7e0a-8719-fbc1a4ccab02
msgctxt "ha9f8e51agb652g43f8gb7bbg71d47d61db34"
msgid "<i>Aylin. </i>We'll see you later."
msgstr "<i>에일린!</i> 나중에 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 0efc90b9-3a22-491b-d779-22c544ac9a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:0efc90b9-3a22-491b-d779-22c544ac9a49
msgctxt "hda1e8758g1bcag4a73g999egb4142b4183b3"
msgid "That doesn't lessen your victory. Well done."
msgstr "그렇다고 승리가 빛바래는 건 아니죠. 잘하셨어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = 14e68e92-8fdb-d98a-55d3-a5be08cc9075
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:14e68e92-8fdb-d98a-55d3-a5be08cc9075
msgctxt "h8f5eb741gc4afg443cga48egb68ef4bf693c"
msgid "I had plenty of help."
msgstr "도움을 많이 받았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 29a303bd-3f59-a7a9-e926-d7abd4a10a7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:29a303bd-3f59-a7a9-e926-d7abd4a10a7e
msgctxt "hafd1beebg94ffg43b6ga722g619f9efb3bff"
msgid ""
"That you're an independent True Soul, and you saved this place from Ketheric "
"Thorm. The stories you must be able to tell."
msgstr "절대자의 명령을 따르지 않는 참된 영혼이라고들 하더군요. 케서릭 쏨에게서 이곳을 구해냈다던데 당신 입으로 직접 들어야겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 2e070cec-3b4d-6bf4-5cb6-f0b535fbcb7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:2e070cec-3b4d-6bf4-5cb6-f0b535fbcb7c
msgctxt "h9929b93eg3409g44f3g9e9bge99e1a77cb65"
msgid ""
"I was hoping to get a quiet moment with you, actually. There are some things "
"I thought you might care to know. Perhaps I could drop by your camp later?"
msgstr ""
"실은 당신과 조용히 이야기를 나누고 싶었어요. 당신이 몇 가지 알아둘 것들이 있다고 생각했거든요. 이따 야영지에 좀 들러도 될까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 462a68f2-1c65-7c1e-603c-69e1bde06fb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:462a68f2-1c65-7c1e-603c-69e1bde06fb3
msgctxt "he5d6888agf827g4ad3gac7egd23e85c9519e"
msgid ""
"There's much I'd like to discuss with you, actually. Perhaps I could join "
"you in your camp later?"
msgstr "실은 당신과 의논하고 싶은 문제가 많아요. 이따 야영지에 좀 들러도 될까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 4e1397c1-911e-d0a3-d8e8-4336145808b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:4e1397c1-911e-d0a3-d8e8-4336145808b0
msgctxt "h7155a79bg4714g462eg951bg9c7a506c4d6b"
msgid "I'll make it brief. Cleric's honour."
msgstr "클레릭의 명예를 걸고 빨리 끝내드릴게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = 4e8a0ef2-95bb-b4da-7e98-de318dee3a81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:4e8a0ef2-95bb-b4da-7e98-de318dee3a81
msgctxt "h3b0e52d8g6374g4764g98bfg090bd64d5652"
msgid "I don't think so."
msgstr "싫은데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 53d0e7c5-e0f3-aa71-2ab2-25e343953020
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:53d0e7c5-e0f3-aa71-2ab2-25e343953020
msgctxt "he8771947ga060g49c7g910ag3523f05800c7"
msgid ""
"A little time to rest and reflect, and I'll be ready to go at it anew. What "
"say you?"
msgstr "약간의 휴식과 반성의 시간이 필요해요. 금방 다시 돌아올게요. 괜찮죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = 56390eea-add2-494c-638c-47b55bcedaf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:56390eea-add2-494c-638c-47b55bcedaf3
msgctxt "h001ff47ag032bg47f1g9be3g47d04247888d"
msgid "I'd like to hear why you lied to me about being Ketheric's daughter."
msgstr "설명을 좀 들어야겠는데요, 케서릭의 하나뿐인 따님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 59db9e06-460c-539b-a4c9-c00cd57949c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_HasMet(1) = True
#.      - SCE_IsobelNightsongReunion_SoloIsobel_HasMet(1) = False
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - SCE_IsobelNightsongReunion_SoloIsobel_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:59db9e06-460c-539b-a4c9-c00cd57949c3
msgctxt "h47f02f38gf4d6g435ag8639g5835dbae271b"
msgid "You did it. I knew you would."
msgstr "해내셨군요. 해낼 줄 알았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = 643b24be-f1be-8350-e7a5-174a1aff8d17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:643b24be-f1be-8350-e7a5-174a1aff8d17
msgctxt "h9d65ca56g113dg4dc2ga576g33dd5769f414"
msgid "Yet you don't seem glad."
msgstr "그런데 영 기뻐 보이지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = 6c3a7613-dfe9-02d7-c867-d42ce22987cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:6c3a7613-dfe9-02d7-c867-d42ce22987cb
msgctxt "hc78f499bg9e0eg401cg8376g93a4b0319a61"
msgid "I'd like that."
msgstr "좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 71b2506e-8678-8c9c-9786-a8da1938d00b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_IsobelNightsongReunion_JoiningCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:71b2506e-8678-8c9c-9786-a8da1938d00b
msgctxt "had68c0abgd14eg434cg845bg6250b64213a1"
msgid "As would I. I'll see you later. Looking forward to it."
msgstr "알겠어요. 나중에 보죠. 기대하고 있겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = 74ef5393-d192-bbcb-8fb8-25807dcf7ad5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:74ef5393-d192-bbcb-8fb8-25807dcf7ad5
msgctxt "hcd1b094fg7d00g4a55ga852geeb5372f3ebf"
msgid "My camp's a little crowded already."
msgstr "야영지가 이미 사람들로 복잡해서 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = 9078e603-a530-3baa-5631-f6592d1004eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:9078e603-a530-3baa-5631-f6592d1004eb
msgctxt "h6a245957g1cb4g46ecg8702ge99156004389"
msgid ""
"To be perfectly frank, I'm exhausted. It feels a bit as though I've been "
"dropped into another dimension."
msgstr "솔직히 말하자면 진이 다 빠져버렸어요. 꼭 다른 차원으로 집어 던져진 것 같은 기분이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = 99aa20b7-aebb-06ac-3f9a-225fe705b25e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:99aa20b7-aebb-06ac-3f9a-225fe705b25e
msgctxt "h76b76bf5g73fcg4003gbb69gdda04cf90781"
msgid "It's not over yet. A nautiloid is on its way to Baldur's Gate."
msgstr "아직 끝난게 아냐. 노틸로이드가 발더스 게이트로 향하고 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = a2537305-2bb7-be96-1797-d80dbecb76f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:a2537305-2bb7-be96-1797-d80dbecb76f1
msgctxt "hdf566477g0646g43bagac8cg6df699975653"
msgid "Why wait?"
msgstr "지금 얘기하는 건 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = a78532d8-f631-5f02-c9d5-e81d20855d95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_HasMet(1) = False
#.      - SCE_IsobelNightsongReunion_SoloIsobel_HasMet(1) = False
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - SCE_IsobelNightsongReunion_SoloIsobel_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:a78532d8-f631-5f02-c9d5-e81d20855d95
msgctxt "hdf6555a0g5f3dg475eg8d34g920bd1ae65fb"
msgid ""
"Ah! It's you, isn't it? You're the talk of this place, you know. I'm Isobel."
msgstr "아! 당신, 맞죠? 당신은 지금 장안의 화제예요. 저는 이소벨이라고 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = aecec86f-46fa-7f5a-4fa0-c0e47d01b882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:aecec86f-46fa-7f5a-4fa0-c0e47d01b882
msgctxt "h09f0ebf1gbf14g4a1fg9162g583ecb2d8f30"
msgid ""
"And you. If what they say about you is true, you're the only reason most of "
"us are alive."
msgstr "저도요. 당신에 관한 이야기들이 사실이라면 당신 덕에 우리가 살아 있는 거네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = b124986b-ec7a-6955-e700-b93a2eff25dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:b124986b-ec7a-6955-e700-b93a2eff25dc
msgctxt "hab8eb3ffg2365g4379g8c69g04c42e62a1ef"
msgid "Nice to meet you."
msgstr "만나서 반가워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = b5a2495d-8058-850f-87ac-4dc96c7b520c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:b5a2495d-8058-850f-87ac-4dc96c7b520c
msgctxt "h21fe358bg0abfg474fgb78bg1a30087ed795"
msgid ""
"It's actually... quite a story. One I'd love to take a little time to share "
"with you. Perhaps I could visit your camp later - a drink and a fire might "
"help the tale."
msgstr ""
"그게... 사실 좀 긴 이야기야. 잠시 시간을 내서 당신과 나누고 싶은 이야기지. 나중에 야영지에 들러도 될까? 술 한 잔하고 모닥불이 "
"있으면 이야기를 쉽게 할 수 있을 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = bbe81a3c-bc87-1beb-f2c4-41d621de3198
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:bbe81a3c-bc87-1beb-f2c4-41d621de3198
msgctxt "hd6c481c8gcbe2g44a1ga739g697e2ebc2cf7"
msgid "What have you heard?"
msgstr "어떤 소문을 들었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = bcdfa5d6-1f8e-3f45-54a6-be2803de2cc9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_IsobelNightsongReunion_JoiningCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:bcdfa5d6-1f8e-3f45-54a6-be2803de2cc9
msgctxt "h00828560gd882g4d23g9326gccf16215201f"
msgid "Good. Very good. Until then. And thank you, if I haven't said it yet."
msgstr "좋아. 아주 좋아. 그럼 나중에 만나. 그리고 혹시 말 안 했을지 몰라서 그런데, 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = c13a1e60-958c-2bd5-7cc5-680a4a237e1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:c13a1e60-958c-2bd5-7cc5-680a4a237e1c
msgctxt "h853e830fgc0f3g4a4bga860g2bbbf5923e75"
msgid ""
"Oh, I am. It's a momentous day. I suppose I need to catch my breath or the "
"momentum will outpace me."
msgstr "아니에요! 전 진심으로 기뻐요. 기념비적인 날이니까요. 이렇게라도 진정하려 애쓰지 않으면 정신줄을 놓을지도 몰라요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = c6af20d2-4b61-611d-6bab-c2afcebef9c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:c6af20d2-4b61-611d-6bab-c2afcebef9c6
msgctxt "h74b7f5b8g7615g42fbgbc2fg8d16138bff4b"
msgid "Where did you come from?"
msgstr "정확히 어디 출신이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Player
#. NodeID = dd42750c-8909-6fcf-f73d-c4a18bea3ef8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:dd42750c-8909-6fcf-f73d-c4a18bea3ef8
msgctxt "h7fa0d5d0g5778g40a1g80c4ge1537d1f70fe"
msgid "All right. See you later."
msgstr "알겠어. 나중에 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = de9ae89b-2b52-bf87-07b7-5ffab93d3f6a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_IsobelNightsongReunion_SoloIsobel_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:de9ae89b-2b52-bf87-07b7-5ffab93d3f6a
msgctxt "h2412752bg7942g4b51g8082g91e72602de94"
msgid "Take it easy, hmm? You deserve it."
msgstr "당당하게 어깨 펴세요. 당신은 자격이 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = e1844e1a-bba6-deea-41cd-97cbdca3a86a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:e1844e1a-bba6-deea-41cd-97cbdca3a86a
msgctxt "hbafa71c8g67ffg4eb7gb5cag391621184949"
msgid "You deserve to know that much - and more."
msgstr "당신이라면 알 자격이 충분하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = e1b4a526-fc20-9df8-34a0-09b143f1c31e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:e1b4a526-fc20-9df8-34a0-09b143f1c31e
msgctxt "h6231e7f9g556cg4041ga84fg2e77de1079f2"
msgid ""
"Pity. But I suppose you have your path, and I have mine. Perhaps they'll "
"meet again. I won't rue the day."
msgstr "아쉽네. 하지만 너도 네 갈 길이 있고 나도 내 갈 길이 있겠지. 언젠가 다시 만날 수 있을 거야. 후회하진 않을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion
#. Speaker = Isobel
#. NodeID = ee32fc3d-73e7-c57b-9792-c1b65f95cf6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_IsobelSoloReunion:ee32fc3d-73e7-c57b-9792-c1b65f95cf6c
msgctxt "hd07b9214gc6f5g4c98ga728g0c73c70b72ef"
msgid ""
"Gods. One day, you go to sleep and everything's square. Then you wake up, "
"and it's a dodecahedron. With tentacles."
msgstr "맙소사. 잠들 때까지만 해도 세상이 정돈되어 있었는데 일어나니 개판이 되어 있네요. 게다가 여기저기 촉수도 흩뿌려져 있고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_AD_EpilogueIntro
#. Speaker = Jaheira
#. NodeID = 56248783-2ebe-28d9-50a6-7d31eb25e563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_AD_EpilogueIntro:56248783-2ebe-28d9-50a6-7d31eb25e563
msgctxt "h32dbc365gb145g4523g8cdege296516299fb"
msgid ""
"I've been thinking on all that you learned below. If you've caught your "
"breath, we ought to discuss our next steps."
msgstr "자네가 저 밑에서 알아낸 사실을 곱씹어보고 있었어. 이제 숨 좀 돌렸으면 다음 단계에 대해 의논하는 게 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_AD_EpilogueIntro
#. Speaker = Jaheira
#. NodeID = 791e4ece-cb8d-8ac5-4ea3-015a921e46b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Jaheira = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_AD_EpilogueIntro:791e4ece-cb8d-8ac5-4ea3-015a921e46b5
msgctxt "h24409243g6247g429dgaf9cgdb21d5b1e1c1"
msgid ""
"I've been thinking on all that we learned below. If you've caught your "
"breath, we ought to discuss our next steps."
msgstr "아래에서 우리가 알게 된 것들에 대해 생각하던 중이었어. 한숨 돌렸다면 이제 앞으로의 계획에 대해 의논하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 00cfea11-e7ef-3f0f-25aa-34330be68809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:00cfea11-e7ef-3f0f-25aa-34330be68809
msgctxt "h07512d8cg83e4g4a19ga1bag7e23a626645e"
msgid "The city needs me - the Harpers know their tasks."
msgstr "도시가 나를 필요로 하지 - 하퍼즈는 나 없이도 소임을 다 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 01441701-f4db-f63c-76a6-2f6651240fde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:01441701-f4db-f63c-76a6-2f6651240fde
msgctxt "hbbe122f1gdfb4g4024g9aecgdc06167d5bd0"
msgid "You almost seem like you're enjoying yourself."
msgstr "이제는 이 상황을 즐기는 것처럼 들리는데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 055ee2df-eadf-5cac-8009-ec07531bc976
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:055ee2df-eadf-5cac-8009-ec07531bc976
msgctxt "hd86b64beg173ag4f67gb0c7g3638f11d1278"
msgid ""
"Extensively. Mind flayers too - but I never dreamed of seeing gods and "
"illithids working in consort."
msgstr ""
"셀 수도 없을 정도지. 마인드 플레이어와도 겨뤄 본 적 있고. 하지만 신과 일리시드가 서로 협력하는 모습은 상상해 본 적도 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 0f5d2098-b8e5-0292-5462-9661ea28d9a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:0f5d2098-b8e5-0292-5462-9661ea28d9a9
msgctxt "h85dcecc0g340fg412cgacddg7e4eb7be2ada"
msgid "But you convinced me otherwise."
msgstr "하지만 자네가 내 생각을 바꿨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 121136fb-be6e-82a1-a82b-7a63158928eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:121136fb-be6e-82a1-a82b-7a63158928eb
msgctxt "ha9ce1badg5955g4d62gb38ag66c3d3dcafa0"
msgid "I've got a parasite in my brain - makes it hard to enjoy anything."
msgstr "제 뇌에 기생충이 있어서, 무턱대고 즐기기는 힘드네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 17daf573-ec46-e8c9-3271-c6c035bfeb3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:17daf573-ec46-e8c9-3271-c6c035bfeb3a
msgctxt "h87fd4357gc395g4a9cgaefegc219983a335a"
msgid "You want to join me?"
msgstr "같이 가시겠습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 2405d32b-24e5-8cff-2033-202cc11ee070
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Jaheira_Event_ToldToLeave = True
#.   Object:
#.     - ORI_Jaheira_Event_GoToCamp(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:2405d32b-24e5-8cff-2033-202cc11ee070
msgctxt "h92088f44g54a3g45feg8b6ag26ad4f5e8f77"
msgid ""
"One awkward evening in camp, until we are free of this place. And then you "
"will be free of me."
msgstr "이 어색한 밤이 한 번만 지나면, 이곳으로 부터도 안녕이겠군, 나도 더 보지 않아도 되고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 269171ca-87e0-226c-bce5-944883dd4f88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:269171ca-87e0-226c-bce5-944883dd4f88
msgctxt "hbad3752fg772ag4bd1g9523gee50ca18680c"
msgid ""
"We ventured into darkness together - now we've come out the other side, I'd "
"say I'm feeling a little refreshed."
msgstr "우린 함께 과감히 어둠 속으로 뛰어들었지 - 그곳에서 빠져나오고 나니, 꽤 상쾌한 기분인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 295fe695-8078-e160-2981-8b75999d5ebe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - OriginRemoveFromPartyAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:295fe695-8078-e160-2981-8b75999d5ebe
msgctxt "h312048b2gd957g48f3g8065g9723b8fc6a1e"
msgid "How does it compare to a shadow-cursed inn?"
msgstr "그림자 저주에 둘러싸였던 여관과 비교하면 어떤가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 2a12ac10-0dc7-8c82-9123-78bcbe566c98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:2a12ac10-0dc7-8c82-9123-78bcbe566c98
msgctxt "ha883d086g531ag442agab85g23c415a70a48"
msgid ""
"Beyond that, our course is yours to set. I can recall how to take orders, as "
"well as give them."
msgstr "그 후의 목표는 자네가 결정하게. 난 명령을 내리는 만큼이나, 명령을 받는 데에도 익숙하니 신경 쓰지 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 2d27618a-ac48-61d0-e057-e8ae2a7c6ce1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:2d27618a-ac48-61d0-e057-e8ae2a7c6ce1
msgctxt "h66440bfdgd472g48f0gb76ag4528fb0a996a"
msgid "I don't think so, Jaheira. Go your own way."
msgstr "제 생각은 달라요, 자헤이라. 당신은 당신의 길을 가세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 2dfcc29e-9117-13b6-a174-e398f5157b4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCE_Jaheira_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:2dfcc29e-9117-13b6-a174-e398f5157b4c
msgctxt "h6d87778aga0d9g473cg946dgceb34a5c8a7a"
msgid "If you have business to conclude before we march, have it done."
msgstr "떠나기 전에 마무리해야 할 일이 있다면, 끝마치고 오게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 3511545b-0697-5b60-2725-377bc9f7986e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:3511545b-0697-5b60-2725-377bc9f7986e
msgctxt "h2939d5cdgab94g4912g82a4g0bcbca2fe449"
msgid "I'm having the time of my life."
msgstr "인생 최고의 시간을 만끽하는 중이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 3c9a9d1d-8a7b-c2eb-c61a-35b2a4079afb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:3c9a9d1d-8a7b-c2eb-c61a-35b2a4079afb
msgctxt "h7e514e92ga8d3g4125g8e44g9db7cdad99bd"
msgid "Spent a lot of time in mind flayer colonies, have you?"
msgstr "마인드 플레이어 군락지에서 꽤 많은 시간을 보내셨나 보네요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 479ebe06-d06b-79ad-0072-14394922883c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:479ebe06-d06b-79ad-0072-14394922883c
msgctxt "had356a0bga14ag42c5g82e5g97398277a50a"
msgid "Now, I've slipped free of the trap and rediscovered my claws."
msgstr "하지만 이젠 그 덫에서 탈출해 내 발톱을 되찾았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 48aba751-fa57-b038-6e6d-b6641b6a4758
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Jaheira_Debrief_Event_PartyFull = True
#.     - GLO_Jaheira_State_HasBeenRecruited = True
#.   Object:
#.     - ORI_Jaheira_Event_GoToCamp(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:48aba751-fa57-b038-6e6d-b6641b6a4758
msgctxt "h0725d192gc189g4992g96f8g2e4f83d05419"
msgid "I'll see you at camp."
msgstr "야영지에서 뵐게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 4ae53f01-3603-e435-6a88-179dcc52e8ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GEN_MaxPlayerCountReached = True
#. SetFlags:
#.   Global:
#.     - SCE_Jaheira_Debrief_Event_PartyFull = True
#.     - GLO_Tutorials_FullPartyRejection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:4ae53f01-3603-e435-6a88-179dcc52e8ef
msgctxt "hc7de0e20g62ddg4583g9c64ga4ed92edefd8"
msgid ""
"You're amply reinforced already. I'll let the new blood do all the running "
"around, for now."
msgstr "이미 충분한 지원군을 데리고 있군. 일단은 젊은이들을 믿고 모든 걸 맡기도록 하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 4c08f5c1-97b1-a73b-b686-edd0fab18949
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:4c08f5c1-97b1-a73b-b686-edd0fab18949
msgctxt "h6447b2beg5c2eg4fc6gb372gef5d0b674ef0"
msgid "How nice to be wanted."
msgstr "찾아주는 사람이 있다니 기쁘군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 4c23315f-40f4-451d-9d19-437758919f73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:4c23315f-40f4-451d-9d19-437758919f73
msgctxt "hee38ee82g3560g4c4egb23dg2f27375d33e8"
msgid "The road to Baldur's Gate is long."
msgstr "발더스 게이트로 가는 길은 멀고 험해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 4eec65d6-d69d-654c-c6ed-642b6875ab78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:4eec65d6-d69d-654c-c6ed-642b6875ab78
msgctxt "hbf261d0cge808g4f78ga58fgd6653a11d46f"
msgid ""
"Falling foul of Ketheric convinced me that my grand adventures were behind "
"me - that even <i>if</i> I survived, I should hang up my blades."
msgstr ""
"케서릭의 술수에 당하는 순간 내 웅장한 모험이 끝난 줄 알았네. <i>만일</i> 살아남더라도, 앞으로는 더 이상 칼을 쥘 수 없으리라 "
"생각했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 4f957395-c419-3c50-545d-e49cf67f7cf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:4f957395-c419-3c50-545d-e49cf67f7cf5
msgctxt "h89ea713eg1766g4c1ega251gc4e8065ca76d"
msgid "I'll be glad to have you by my side."
msgstr "당신이 함께한다면 정말 기쁠 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 52f1fa28-2255-360b-ac7f-c8930b6e70c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:52f1fa28-2255-360b-ac7f-c8930b6e70c8
msgctxt "h881f8daeg5606g464dgbd92g86d32917a14a"
msgid "Of course."
msgstr "물론이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 56d5a0d7-3ee1-6ed2-e0d8-1442f3531bb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Siege_State_NoProtection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:56d5a0d7-3ee1-6ed2-e0d8-1442f3531bb2
msgctxt "h3807a747g1f86g420fg9a8agfe0c1eb448db"
msgid "Don't the Harpers need you?"
msgstr "하퍼즈에겐 당신이 필요하지 않나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 5bf55049-17a2-2f9f-8979-47f83968f075
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:5bf55049-17a2-2f9f-8979-47f83968f075
msgctxt "h3b346f53g5a2bg4eefg869eg4ec491f6be72"
msgid "And the city needs us."
msgstr "그리고 그 도시엔 우리가 필요하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 5e50f97f-e355-d5ce-ddf2-cf7750583696
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:5e50f97f-e355-d5ce-ddf2-cf7750583696
msgctxt "h0e13ce29gcf9fg4ddcg8b6egedeb5cce3242"
msgid ""
"These <i>Chosen</i> have reason to fear you - and I would like to be at your "
"side when you confront them."
msgstr "이 <i>선택받은 자</i>들이 널 두려워 할 이유가 되는 거지. 그리고 난 네가 그들과 맞설 때 그 옆에 있고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 6169d283-5117-e699-0356-419b1880a045
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:6169d283-5117-e699-0356-419b1880a045
msgctxt "h2d757126gac43g4bfcgbac8g58ff635bd7f3"
msgid ""
"An elder brain, bound by lost Netherese magic, with servants of the Dead "
"Three holding the chain."
msgstr "엘더 브레인이 사라진 네더릴 마법에 구속되어 삼악신 수하들의 통제를 받고 있다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 673b5ee0-331e-7b8b-f9e4-9ac69e48620a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:673b5ee0-331e-7b8b-f9e4-9ac69e48620a
msgctxt "h2a5d5612g6cbcg457eg8cbbg38bd46f35196"
msgid ""
"You came here in search of a cure, but found a conspiracy instead - I can "
"see how that would be disheartening."
msgstr "넌 치료법을 찾으러 왔지만, 대신에 음모와 마주했지. 그게 얼마나 실망스러운지 이해해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 7b4c098d-3876-ea0e-c16b-27798d57f048
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:7b4c098d-3876-ea0e-c16b-27798d57f048
msgctxt "h9cbf83begd56ag472cgb19fg1fa15b333d42"
msgid "Of course. I already told you - you're welcome in my party."
msgstr "당연하죠. 이미 말했듯이, 당신은 언제나 환영입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 840d3faa-5992-728f-c669-f8a25ceeab0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:840d3faa-5992-728f-c669-f8a25ceeab0d
msgctxt "hc6f1821bgcf6ag4cdegb908g949ba3a09853"
msgid "You have a Netherstone, and you're on the scent of two more."
msgstr "자네에겐 네더스톤이 하나 있고, 나머지 두 개의 발자취를 쫒고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = 8bf2a7aa-8a44-7ec8-7933-bc8da410f4df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:8bf2a7aa-8a44-7ec8-7933-bc8da410f4df
msgctxt "h93807fd2g0af8g4582g87b2g536afe8c117e"
msgid "You've tangled with the Dead Three before?"
msgstr "이전에도 삼악신과 싸웠던 적이 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 8e9b70b3-b7ab-d9c5-eaca-be1bb64b4001
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:8e9b70b3-b7ab-d9c5-eaca-be1bb64b4001
msgctxt "h9d52b9e4gd5b4g4baega326gb9afc64297c8"
msgid "Aren't you?"
msgstr "자네는 안 그렇고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = 9ddda9dc-4ff3-50d3-cfbe-6752dd4050ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:9ddda9dc-4ff3-50d3-cfbe-6752dd4050ee
msgctxt "h5583395bg5becg48dbgae1ag001757039a43"
msgid ""
"More than anyone should. But I never dreamed I'd see the Dead Three working "
"in consort with illithids."
msgstr "누구보다 더 오래 있었지. 하지만 삼악신이 일리시드와 협력하는 모습을 보게 될 거라고는 상상해 본 적도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = a98b5a76-a3a4-6a30-571a-0b78821c91a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:a98b5a76-a3a4-6a30-571a-0b78821c91a3
msgctxt "h08295ae8g7223g4903ga51fgc70f1e2fcbce"
msgid "Reminds me of old times."
msgstr "옛날 생각이 나는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = aaa8caf0-4f03-297c-2f52-03d3d533eae5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:aaa8caf0-4f03-297c-2f52-03d3d533eae5
msgctxt "h7bc80014g128cg48cdgb585g1fdec4cb1d37"
msgid ""
"It is good to savour the moment of victory - but pace yourself. Our fight is "
"just beginning."
msgstr "승리를 만끽하는 것도 좋지만, 다시 마음을 추슬러야 할 거야. 우리의 싸움은 이제 막 시작했으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = ada47b20-43f0-ffb3-e720-10892cd2d142
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:ada47b20-43f0-ffb3-e720-10892cd2d142
msgctxt "h1f39ee01g0472g4b01g8a70g7b9d059de7bc"
msgid "It's time for me to hunt <i>my</i> prey."
msgstr "드디어 <i>사냥의 시간</i>이 온 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = b1050b34-9699-076a-dd8c-f76f4cec8889
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:b1050b34-9699-076a-dd8c-f76f4cec8889
msgctxt "hce7a7a83gbc87g4339ga4a8gb90eb817eee2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = b8b6c53c-74ce-abef-2115-72604c8aa015
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:b8b6c53c-74ce-abef-2115-72604c8aa015
msgctxt "hc4420110gef43g40fcgb8e6gb66546126054"
msgid "It is most disturbing."
msgstr "정말 충격적인 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = c5b0c05e-6792-0ca1-93fc-d65cccb58424
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:c5b0c05e-6792-0ca1-93fc-d65cccb58424
msgctxt "hc5ee9415gde5fg4465g9a1ag2802f5430d5a"
msgid "Glad to be there."
msgstr "기꺼이 함께하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = c738b6bf-0e8b-1ded-ee08-e938d97ce9a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:c738b6bf-0e8b-1ded-ee08-e938d97ce9a7
msgctxt "h8971b11ag400fg4b40g8991ge20658fd05f2"
msgid "My place is with you."
msgstr "나는 그대와 동행할 운명이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = c8cee5c0-1e82-2b31-3475-edd70b567ddf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCE_Debrief_State_PartyDebriefed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:c8cee5c0-1e82-2b31-3475-edd70b567ddf
msgctxt "ha9decadcg1f22g4e85g98f9g354657a61dfe"
msgid ""
"When we reach Baldur's Gate, there will be even darker paths to tread. I "
"will follow you wherever they lead."
msgstr "발더스 게이트에 도착하면, 어두운 길이 더욱 많이 도사리고 있을 걸세. 그들이 있는 곳으로 이끌어만 준다면 어디든 따라가겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = d4d9f539-ed4e-6dc6-31af-3f23d5472bc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:d4d9f539-ed4e-6dc6-31af-3f23d5472bc0
msgctxt "h9a888d66g045fg4341g9247g9502cc73c3ac"
msgid "On second thought - no, Jaheira. Best we part ways."
msgstr "생각해 봤는데요, 자헤이라. 여기서 헤어지는 게 좋겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = d5f8a323-1564-fba0-8c9b-1347ddc20acb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCE_Jaheira_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:d5f8a323-1564-fba0-8c9b-1347ddc20acb
msgctxt "hdf10ae71ge6b0g4d3egacecg2c5beba5e014"
msgid ""
"Our enemies spread like rub-rot - treat one patch, and two more bloom in its "
"place."
msgstr "우리의 적은 문지르면 번지는 상처처럼 퍼지고 있네. 한 곳을 치료하면, 그 자리에 두 개가 더 피어오르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = d83c3e59-c33a-179e-4823-263348548b24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:d83c3e59-c33a-179e-4823-263348548b24
msgctxt "ha4d95698gfa7eg450bg8e4bg6812d37f9ac1"
msgid ""
"With the Absolute's army gone, the Risen Road should be clear - we can "
"follow it all the way to Baldur's Gate."
msgstr "절대자의 군대가 사라졌으니, 이제 치솟은 길은 안전하겠지. 발더스 게이트까지 길을 따라 갈 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = d8e7a3ae-d369-4387-4719-9f954336766e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:d8e7a3ae-d369-4387-4719-9f954336766e
msgctxt "h891c9e2bgbeacg4c63g8340ge19d5c8eb18e"
msgid ""
"Your way <i>is</i> my way, just as your fight is my fight. But suit yourself."
msgstr "니가 가는 길이 곧 <i>내가</i> 가는 길이고, 니가 맞이할 전투가 곧 나의 전투야. 그래도 뭐, 좋을 대로 하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = e073242e-553c-c6ac-a760-9f2e9f5bc738
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#. SetFlags:
#.   Global:
#.     - GLO_Jaheira_State_HasBeenRecruited = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:e073242e-553c-c6ac-a760-9f2e9f5bc738
msgctxt "h7401ef30g6fa8g4f65g995eg3e5e1e3ef1e4"
msgid "Join me."
msgstr "함께하시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = e7f504e3-3371-b390-055e-fdc932e802c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:e7f504e3-3371-b390-055e-fdc932e802c7
msgctxt "h8adff77agdbf1g4c27ga0dbgba1d3fcf3d68"
msgid ""
"But take courage - we have killed a man who could not die, and stripped the "
"Absolute's army of its general."
msgstr "하지만 용기를 가져. 우린 죽지 않는 자를 죽였고, 절대자의 군대를 이끌 장군을 없애 버렸잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = e94cc3b8-1ccf-5a40-e7a0-ee4e92f9d701
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:e94cc3b8-1ccf-5a40-e7a0-ee4e92f9d701
msgctxt "h3b7e218cgdb25g453fg9f6fg94e8d4ab9cea"
msgid ""
"And I know my calling. I thought my grand adventures were behind me, but I "
"should have known better."
msgstr "나는 내 소명을 알고있지. 위대한 모험의 날들은 끝난 줄 알았건만, 잘못 생각하고 있었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = e9d0237c-34ee-259f-dff5-b464d6afe91d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:e9d0237c-34ee-259f-dff5-b464d6afe91d
msgctxt "h866aba6fg807eg4912g8f69g479a78a881f0"
msgid "I'm beginning to."
msgstr "저도 슬슬 그래요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = edff1f98-9df7-1581-723f-00cb7135eedc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:edff1f98-9df7-1581-723f-00cb7135eedc
msgctxt "h5c96d86dg1bf9g471bg8099g6d8ca66d10fa"
msgid "You ventured into the heart of darkness when I could not."
msgstr "내가 그러지 못할 때 넌 어둠의 심장부로 향했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Player
#. NodeID = efa8e7ad-2825-61ac-0123-f02284620d48
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Jaheira_State_HasBeenRecruited = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:efa8e7ad-2825-61ac-0123-f02284620d48
msgctxt "he3ececf7g03a0g4472g9e90gbc7be103d800"
msgid "Join me now."
msgstr "지금 같이 가시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = f30a8945-3866-68ef-a530-6fb7f3854818
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Jaheira_Knows_HarpersAtDanthelon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:f30a8945-3866-68ef-a530-6fb7f3854818
msgctxt "h819f24b5gb577g4484ga8c6g0cf933d6815b"
msgid ""
"There's a Harper safe-house in Wyrm's Crossing - Danthelon's Dancing Axe. "
"We'd do well to check in with them before entering the city proper."
msgstr "고룡 다리 쪽, 단셀론의 춤추는 도끼에 하퍼 은신처가 있어. 도시 내부로 진입하기 전에 그 쪽을 먼저 살펴보는 게 좋을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = f540d156-6232-e7b4-d17d-7e15b77f21ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - OriginAddToParty(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:f540d156-6232-e7b4-d17d-7e15b77f21ce
msgctxt "h419c7cd2gf80ag4196gbcefg781805baaec5"
msgid "By your command."
msgstr "분부대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief
#. Speaker = Jaheira
#. NodeID = f6deb815-99e2-2f85-3954-bf0b5052c336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jaheira_Debrief:f6deb815-99e2-2f85-3954-bf0b5052c336
msgctxt "hb513d310gd631g485dgb961g9cd1c09f8097"
msgid ""
"When we met, I was licking my wounds - an old bear with her leg caught in "
"the hunter's snare."
msgstr "우리가 만났을 때, 나는 상처를 핥고 있었지. 사냥꾼이 놓은 덫에 걸려버린 늙은 곰처럼 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD
#. Speaker = Withers
#. NodeID = 0e313d8e-af07-45a0-b16e-8e2d8204f292
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_A = True
#. SetFlags:
#.   Local:
#.     - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD:0e313d8e-af07-45a0-b16e-8e2d8204f292
msgctxt "h77a20d0egef5eg4d32g80e9gb1e0c2e6df11"
msgid "Make haste. I would have words with you."
msgstr "서두르게나. 그대와 할 말이 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD
#. Speaker = Withers
#. NodeID = 76eb8d6b-24d9-495a-926c-9ae0cb9352c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_B = True
#. SetFlags:
#.   Local:
#.     - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD:76eb8d6b-24d9-495a-926c-9ae0cb9352c8
msgctxt "h20434f82g53cag4ec3g9902gac6b1639594c"
msgid "New perils await, beyond the horizon."
msgstr "지평선 넘어 새 위협이 도사리고 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD
#. Speaker = Withers
#. NodeID = 8955b906-ba06-45ed-a256-eafc780a2ed9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD:8955b906-ba06-45ed-a256-eafc780a2ed9
msgctxt "h1009fda7gdffdg4e6egb88eg625d60bb67c3"
msgid "Come. There are important matters to discuss."
msgstr "와라. 논의해야 할 중요한 사안이 있도다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD
#. Speaker = Withers
#. NodeID = feb9131c-8bc8-4125-8ac6-47f0c9295955
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_C = True
#. SetFlags:
#.   Local:
#.     - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_C = False
#.     - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_A = False
#.     - 3bb3c4b2-e62d-80c1-df00-dc7a6ab2a18f_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD:feb9131c-8bc8-4125-8ac6-47f0c9295955
msgctxt "h85781856g87a2g4eccg9912g741415686229"
msgid "Thou dawdlest while time is precious. Let us speak."
msgstr "시간은 소중한데 그대는 어찌 꾸물거리고 있는가. 어서 대화해보세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD_EpilogueIntro
#. Speaker = Withers
#. NodeID = 8ca0fdb3-88a9-44b4-a991-616f7d35484e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_AD_EpilogueIntro:8ca0fdb3-88a9-44b4-a991-616f7d35484e
msgctxt "h45b03eebg667eg425ag87e0g169f17273783"
msgid ""
"Against all odds, thou hast survived. Wilt thou reflect with me upon thy "
"triumph?"
msgstr "그대는 모든 역경을 딛고 살아남았구나. 그대의 승리를 나와 함께 되돌아보지 않겠는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 05f05b58-5ac2-64ae-1768-db90b37403dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:05f05b58-5ac2-64ae-1768-db90b37403dc
msgctxt "h48eae06dgde36g4440g8af9g04374eea8acc"
msgid "For sake of convenience, thou shalt call me Withers."
msgstr "편의를 위한 것이니, 그대는 나를 위더스로 불러 주게나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 072d650a-582a-8744-4032-d93942207c37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:072d650a-582a-8744-4032-d93942207c37
msgctxt "h0f3285afg6835g424ag944fg87173596c245"
msgid "Where matters of balance are concerned, I am eternally called."
msgstr "균형에 문제가 생기는 곳에, 나는 영원히 부름 받는다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 0770ced6-9612-edc8-0f8c-ea95b70e0100
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:0770ced6-9612-edc8-0f8c-ea95b70e0100
msgctxt "hf6e4a243g6cbeg4577g8ab1g717de1340421"
msgid "Impossible. Thy party is full."
msgstr "불가능하네. 그대의 일행이 가득 찼다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 0a2ec480-1964-3b93-d9d9-84b356f643d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCE_JergalDebrief_Event_WhyHere(1) = False
#.      - CHA_Jergal_HasMet(1) = False
#.      - CAMP_Jergal_HasMet(1) = True
#. SetFlags:
#.   Object:
#.     - SCE_JergalDebrief_Event_WhyHere(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:0a2ec480-1964-3b93-d9d9-84b356f643d4
msgctxt "h6e5dc741gfa58g4b5ag94adg87b9720c4257"
msgid "I'm surprised to see you. Why are you here?"
msgstr "여기서 보게 돼서 놀랐네요. 왜 여기 계신 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 0ca162be-52ba-69b5-8f89-95e8ec864b5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCE_JergalDebrief_Event_WhyHere(1) = False
#.      - CHA_Jergal_HasMet(1) = False
#.      - CAMP_Jergal_HasMet(1) = False
#. SetFlags:
#.   Object:
#.     - SCE_JergalDebrief_Event_WhyHere(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:0ca162be-52ba-69b5-8f89-95e8ec864b5c
msgctxt "h8533c5f9ge58fg411cg98afga23669e9ecff"
msgid "Who are you? What are you doing here?"
msgstr "당신은 누구시죠? 여기서 뭘 하고 있는 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 0d0ee7e4-0734-4a1a-d559-ebc540a1053a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:0d0ee7e4-0734-4a1a-d559-ebc540a1053a
msgctxt "h1d316a7dg751ag487bgbbb2gebda99eaf45b"
msgid "Thou canst not hire allies. I must speak with thy leader."
msgstr "자네는 동료를 모집할 권한이 없다네. 난 그대의 지도자와 이야기 해야만 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 0db1407e-96ed-0e04-ead9-7509f0a400da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_Event_ResurrectedSomeoneOnce = False
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - CAMP_Jergal_Event_ResurrectedSomeoneOnce = True
#.     - CAMP_Jergal_Event_ResurrectPlayer_2 = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:0db1407e-96ed-0e04-ead9-7509f0a400da
msgctxt "hfc4720c9gd33bg48c6gb15fge9decd9cae65"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 112f1454-a289-f43a-1d7a-c05fb20cce20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:112f1454-a289-f43a-1d7a-c05fb20cce20
msgctxt "h0302bbeeg3cc0g4372g8132g55923031f278"
msgid "A mending of the threads between life and death."
msgstr "삶과 죽음 사이의 실타래를 다시금 잇는 것이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 12621d2a-b723-b977-e9b6-8f9fcfb80e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:12621d2a-b723-b977-e9b6-8f9fcfb80e03
msgctxt "h8851bbb0g327eg4e86g982ag0dae44dc94cc"
msgid ""
"The alliance is reforged, mortal. The planes thus quake, and the gods "
"shudder."
msgstr "동맹이 재건되었으니, 필멸자여. 이로 인해 차원이 뒤틀리고, 신들이 몸서리치는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 134f0b62-c9ea-ee9e-b31e-9e801b85cd7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_Event_ResurrectedSomeoneOnce = False
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Global:
#.     - CAMP_Jergal_Event_ResurrectedSomeoneOnce = True
#.     - CAMP_Jergal_Event_ResurrectAllDead = True
#.   Object:
#.     - GEN_TransferNPCPayment_2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:134f0b62-c9ea-ee9e-b31e-9e801b85cd7d
msgctxt "h172b93d9geee5g4c8dg9dffg23b80422208b"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 135fdf23-6773-682c-66d8-8867f7d45ad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:135fdf23-6773-682c-66d8-8867f7d45ad4
msgctxt "hf3d7c2c0g539cg456fgbe97g7a7754ed4c32"
msgid "For the divine appointees of Ao, even death can be overcome."
msgstr "Ao에게 신성을 부여 받은 자는, 죽음도 넘어설 수 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 2ae5b470-7292-d83b-656a-d897b8b5b837
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:2ae5b470-7292-d83b-656a-d897b8b5b837
msgctxt "h48a32936ga705g40c3gb185gf976cabc9512"
msgid ""
"Thou hast seen with thine own eyes and felt in thine Urges: the Dead Three "
"unite."
msgstr "그대의 두 눈으로 직접 보았고 또한 그대의 충동으로 느껴졌으리라. 삼악신이 힘을 모았느니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 2ba1a7f9-a276-26c1-7611-b8757d1d789e
