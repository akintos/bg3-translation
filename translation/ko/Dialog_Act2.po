msgctxt "hf8cee483g322fg452fgbd9fg11ff10244f79"
msgid ""
"*Your rage echoes throughout the darkness - and it makes a connection. "
"Something <i>notices</i> you.*"
msgstr "*당신의 분노가 어둠 속을 메아리칩니다, 그리고 연결합니다. 무언가가 당신의 존재를 <i>알아챕니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 4db5db2e-25e7-ace9-5902-fa9cd8fef910
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:4db5db2e-25e7-ace9-5902-fa9cd8fef910
msgctxt "h3079590dg40ceg4ddbg8ab0gc34270c9932c"
msgid "Just passing through, really."
msgstr "지나가는 길이야, 진짜로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 4f265943-4c49-250c-3034-eae8a932239e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:4f265943-4c49-250c-3034-eae8a932239e
msgctxt "h6c73fe0agebf1g4c5fga691gc87d40b0bd47"
msgid "If you want a tune, I know plenty."
msgstr "한 곡조 듣고 싶나? 많이 알긴 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Narrator
#. NodeID = 50417222-ecaf-60ed-078e-b97f4a555407
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:50417222-ecaf-60ed-078e-b97f4a555407
msgctxt "h8f17486dg84cbg4568g8eadg3a54fda6f983"
msgid ""
"*Your music echoes through the darkness - and it makes a connection. "
"Something <i>notices</i> you.*"
msgstr "*당신의 음악이 어둠 속을 메아리칩니다, 그리고 연결합니다. 무언가가 당신의 존재를 <i>알아챕니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 50957fe8-bc7c-23e4-9656-57f8e47b05e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:50957fe8-bc7c-23e4-9656-57f8e47b05e5
msgctxt "ha2e85fd3g978dg421fgbfbdgaa90eabc3f01"
msgid "This land is weak, primed to be preyed upon."
msgstr "이 땅은 약해, 먹히기 쉬운 상태야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 54cc15e3-4506-39e0-4635-0d045e8020cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:54cc15e3-4506-39e0-4635-0d045e8020cf
msgctxt "heeba3082g0934g4e59g90fcg498d28af21bf"
msgid "You treacherous dog!"
msgstr "이 배신자 자식!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Brawler Vez
#. NodeID = 56257479-f818-9a66-ca3d-d33a32bf475d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:56257479-f818-9a66-ca3d-d33a32bf475d
msgctxt "h89ddd191g8e8ag4f4dga3e8g3c4a41515a14"
msgid "Wha'?"
msgstr "엉?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Brawler Vez
#. NodeID = 59310df9-f705-5275-b9df-75be1e232d77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:59310df9-f705-5275-b9df-75be1e232d77
msgctxt "hed19c35cgf91ag426cgac09g9db0a4ddb6ac"
msgid "But sooner's better, yeah?"
msgstr "하지만 일찍 오는 게 좋을 거야, 엉?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 5a4f1569-44fa-b4ce-60a0-cfe860a3b632
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:5a4f1569-44fa-b4ce-60a0-cfe860a3b632
msgctxt "h96b165d9g7afeg419dg9ca7gf527045693bd"
msgid "Ah, you do have it!"
msgstr "아, 가지고 계셨군요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kar'niss
#. NodeID = 61aee8e0-f72b-8a3d-ad65-df5fd8938b17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:61aee8e0-f72b-8a3d-ad65-df5fd8938b17
msgctxt "hc2f0e01fg3456g4979g9151g998673937020"
msgid "Yes. We will stay. We will wait."
msgstr "그래요. 여기 있겠습니다. 기다리겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kar'niss
#. NodeID = 61ba8a8f-8c4f-ca82-41af-aa959933eac4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:61ba8a8f-8c4f-ca82-41af-aa959933eac4
msgctxt "h2f543024g584dg4e52ga2f8g4208ad4d4b22"
msgid "New flesh for you, my queen. But, who are they?"
msgstr "여왕이시여, 당신을 위한 새로운 생명체입니다. 하지만, 저 사람들은 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Narrator
#. NodeID = 6239a972-2aae-73f9-8648-fa329ed4283a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:6239a972-2aae-73f9-8648-fa329ed4283a
msgctxt "haa71ac26gf903g4bcbg9a3cgcffb33dfe6f1"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 624a78e4-d13e-2cb7-0006-eedfdfda5536
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:624a78e4-d13e-2cb7-0006-eedfdfda5536
msgctxt "h392c6262g1d5fg4317gbe12g0fa5b29d69ca"
msgid "Of course, we await your pleasure."
msgstr "물론, 당신이 원하는 대로 기다리겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 65b1016c-17da-cd96-7abf-fa0ccb5eb01a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:65b1016c-17da-cd96-7abf-fa0ccb5eb01a
msgctxt "h535a18ebg7917g494fg8210g4fca91ce61ce"
msgid "<i>Reach out with your powers to summon the guide.</i>"
msgstr "<i>힘을 사용하여 안내자를 소환한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 662f6da2-41ce-cda7-fa03-6a80a6c06fe3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:662f6da2-41ce-cda7-fa03-6a80a6c06fe3
msgctxt "hde1335c6g5810g41bcg9c60ga5c6f1a565c0"
msgid "I'm not ready to summon the guide just yet."
msgstr "아직 안내자를 소환할 준비가 안됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 6b91024f-072e-a63a-812a-e375cb143b17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:6b91024f-072e-a63a-812a-e375cb143b17
msgctxt "h807299f8g155ag430ag9039g526e951652ed"
msgid ""
"Forgive me True Soul, we are simply eager to reach Moonrise as soon as we "
"can."
msgstr "용서하십시오, 참된 영혼이시여, 그저 문라이즈에 최대한 빨리 가고 싶은 것뿐입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Narrator
#. NodeID = 77a42698-bd33-13d3-7ecb-92b24d917ff9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:77a42698-bd33-13d3-7ecb-92b24d917ff9
msgctxt "hc7e3e42fgcccfg422bg967cg4576d26375f8"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Narrator
#. NodeID = 79a5a8aa-dc93-f65b-76fc-97fa0d888816
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:79a5a8aa-dc93-f65b-76fc-97fa0d888816
msgctxt "h912987f1g57b6g4877g85f7g79d3c9737b4f"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Narrator
#. NodeID = 7c49179f-d4a1-d670-c94e-edadf1235e5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:7c49179f-d4a1-d670-c94e-edadf1235e5c
msgctxt "h9ddf2f0cgb459g441egbee4g8cac378b451d"
msgid ""
"*Your power echoes through the darkness - and makes a connection. Something "
"<i>notices</i> you.*"
msgstr "*당신의 힘이 어둠 속을 메아리칩니다, 그리고 연결합니다. 무언가가 당신의 존재를 <i>알아챕니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 7c727054-3b0a-b85f-6a07-0d859da46093
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckHasItemTemplate = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:7c727054-3b0a-b85f-6a07-0d859da46093
msgctxt "h31096327g7bdag495agb9b1gd3b6f7183272"
msgid "And where can I find this lyre?"
msgstr "그럼 리라는 어디서 구할 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Narrator
#. NodeID = 7d7dc076-10bf-0129-488b-d982c0815948
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:7d7dc076-10bf-0129-488b-d982c0815948
msgctxt "h671cffcdg4555g4832g91c7ge0080ded56d1"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 7dd5ce1a-16c7-efee-d511-77a7e5cb53cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckHasItemTemplate = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:7dd5ce1a-16c7-efee-d511-77a7e5cb53cf
msgctxt "ha6f0de33gf44dg490dga2b9gce5ad964a0ca"
msgid "And where's this lyre again?"
msgstr "그래서 리라는 어디 있다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 7dfdfd8a-7e6f-e5be-db4c-36d39659f2e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Drider_State_AttemptedToSummonDrider(1) = False
#.   Script:
#.      - GEN_CheckHasItemTemplate = False
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:7dfdfd8a-7e6f-e5be-db4c-36d39659f2e5
msgctxt "h293ffe00gfe18g4df0g9f77g15f852fdd99a"
msgid "We've no need of magic strings. I will summon the guide myself."
msgstr "마법의 현 같은 건 필요없어.내 힘으로 안내자를 불러낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kar'niss
#. NodeID = 844a88a4-27f9-a2e3-7152-33d22cdf95ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_CaravanStart_DriderSummoned(1) = True
#.   Global:
#.     - SCL_Drider_Event_StartCaravanEscort = True
#.     - SCL_Drider_State_WaitAtCaravanStart = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:844a88a4-27f9-a2e3-7152-33d22cdf95ac
msgctxt "h707d2bd4g2c3dg4d96g8738g510257b0a58f"
msgid ""
"Yes, I hear them, your majesty. Calling us. Their god and their guide, "
"together."
msgstr "네, 들립니다, 위대하신 자여. 그들의 신과 그들의 안내자를 함께 부르고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kar'niss
#. NodeID = 8fcf647a-ebf6-f3d5-dc73-3d87a662d04f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_State_PlayedHarpBadly(1) = True
#.     - SCL_Drider_CaravanStart_DriderSummoned(1) = True
#.   Global:
#.     - SCL_Drider_Event_StartCaravanEscort = True
#.     - SCL_Drider_State_WaitAtCaravanStart = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:8fcf647a-ebf6-f3d5-dc73-3d87a662d04f
msgctxt "h6aff92fagf03dg44ccgafe1g3aaf721df884"
msgid "Your lyre, mistress! What are they doing to it?"
msgstr "주인이시여, 당신의 리라가! 저들이 그걸로 뭘 하는 걸까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 906232fd-80fa-ee77-9f11-da8a60cf6f95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:906232fd-80fa-ee77-9f11-da8a60cf6f95
msgctxt "h7d9f9c9cgbae2g45b3gaadbgaa562c560242"
msgid "I seek my old home - for that I must pass through to Baldur's Gate."
msgstr "옛날에 살던 집을 찾고 있지, 그러려면 발더스 게이트를 지나야해서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 92bb3c9f-b1b6-7d1a-10fe-a5f6d637c315
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:92bb3c9f-b1b6-7d1a-10fe-a5f6d637c315
#, fuzzy
msgctxt "ha28c3f08g57e0g4ba5gaea7g5da72453014a"
msgid "<i>Open your mouth and ROAR - your anger a call. A summons.</i>"
msgstr "<i>입을 열고 포효한다, 분노가 호출이 된다. 소환장이 된다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 954bddf8-f001-0ec2-9a1c-6520c0e723d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:954bddf8-f001-0ec2-9a1c-6520c0e723d5
msgctxt "h0055d511gb38dg45e3gb45eg669b37593cd4"
msgid "Good, we were told to expect you."
msgstr "좋습니다, 당신을 기다리란 말을 들었어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Player
#. NodeID = 9909d148-e230-245c-0abd-63bb7fc69a2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
