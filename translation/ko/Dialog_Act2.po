#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_EntranceGuards_Halfling_Melee:4bba4fc5-0491-457b-9721-65b2f8bbd86d
msgctxt "h0103422eg8192g4233g9c54g16426db628b4"
msgid "Keep your eyes sharp out there, yeah?"
msgstr "저 밖에서는 조심히 다니라고, 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_EntranceGuards_Halfling_Melee
#. Speaker = Harper Callie
#. NodeID = 5c8b52a0-989b-4649-84bd-8f509012d989
