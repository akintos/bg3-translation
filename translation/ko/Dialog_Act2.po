msgctxt "h881fef4aga657g4c1dg9249g52876736576c"
msgid "Close - but not close enough. Again!"
msgstr "가까워, 하지만 좀 더 가까이 가야 해. 다시!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 61777591-6b0f-5047-16f2-79d3095a03fc
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
