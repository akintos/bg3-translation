msgctxt "h683a613agde02g4d92gba21g3ea1bbb9c739"
msgid "Still yourself. The saw's teeth will open the way for her shadow."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_AD_TollhouseMaster_Vulnerable_Combat
#. Speaker = Gerringothe Thorm
#. NodeID = 6c23db7e-485f-4e51-bff6-8d2a92bb3d44
