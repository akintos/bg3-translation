msgctxt "h90b25d32gcd7bg4e4dg9703g18c6b7e3dc41"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kar'niss
#. NodeID = 26819548-0b99-305e-ec6d-9e5ea028f3c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCL_Drider_State_AttemptedToSummonDrider(1) = True
