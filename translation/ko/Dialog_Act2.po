msgctxt "h743e9889ge62cg4053g9626g175de4d99262"
msgid "Blood has pooled in the brain. I must open the cranium!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon_SuccessfulSurgery_Combat
#. Speaker = Malus Thorm
#. NodeID = 4b6a30f5-2e30-4d5e-bfb6-73eb5094dc0c
