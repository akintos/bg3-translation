msgctxt "hb3269e0egdb7cg430dg9831gecfaeb5df0cb"
msgid "A successful procedure, Shar be praised!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon_Leech_Combat
