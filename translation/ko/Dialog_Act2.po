msgctxt "h7657d042gaea5g4c66gb3edgb3a14430dc29"
msgid "To each their own."
msgstr "각자 하기 나름이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Ox
