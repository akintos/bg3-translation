msgctxt "h9288e394g65e9g4df9g880cg3565519e584f"
msgid "What are you waiting for?"
msgstr "왜 꾸물거리는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
