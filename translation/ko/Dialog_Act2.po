msgctxt "h9242ebeeg9428g4455ga724gaf2652750ee0"
msgid "Go, go, GO."
msgstr "가자, 어서, <b>가</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = a3a5d590-155d-4a89-a5e3-883c953ae611
