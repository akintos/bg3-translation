msgctxt "h351fa88bge364g4e97gb2abg7245e14e6a6a"
msgid "[DRUID][RANGER]"
msgstr "[드루이드][레인저]"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 11f8696e-0983-44ce-48b4-54d80c0beb0c
