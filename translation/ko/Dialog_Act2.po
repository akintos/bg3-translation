msgctxt "hf6f04ed9gc491g44a5g99c7ga0a0568b30da"
msgid "An eyepatch. But whose?"
msgstr "안대야. 누구 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = ac9e8214-30d4-d3d2-c814-435034cdda7b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
