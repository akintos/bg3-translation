msgctxt "h0a3b73c7g3795g417aga4f2g23e4d5f2b56f"
msgid "The boat's ready! Come on!"
msgstr "배는 준비됐어! 얼른 와!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = cc85200e-a916-d36d-c9a4-8102119c7140
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
