msgctxt "h6a6a48ebgd5f7g437bga7e5g014f90bd785e"
msgid "That disc must be the way forward."
msgstr "저 원판으로 나아갈 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 8d8d45ed-1d96-44da-a07a-5ef781d606be
