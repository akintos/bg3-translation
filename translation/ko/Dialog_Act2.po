msgctxt "hbf52255dg8cd0g4a2dg898bg2ec57fa9e2ec"
msgid "Whose orders are you following?"
msgstr "누구의 명령이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
