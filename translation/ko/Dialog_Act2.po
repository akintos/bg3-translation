#. CheckFlags:
#.   Local:
#.      - 2fb08ca0-df67-8450-3f01-c1e1c2a78b59_C = True
#. SetFlags:
#.   Local:
#.     - 2fb08ca0-df67-8450-3f01-c1e1c2a78b59_C = False
#.     - 2fb08ca0-df67-8450-3f01-c1e1c2a78b59_A = False
#.     - 2fb08ca0-df67-8450-3f01-c1e1c2a78b59_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint:c456bd19-1017-4ab7-9132-c9c170fcdec2
msgctxt "hcdc8ba14g9ee9g404agbe35gfb40cbe0ee94"
msgid "You can be right unkind, you know that?"
msgstr "너 정말 못되게 구는구나, 알지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Brawler Vez
#. NodeID = e630479d-ba79-a534-2485-8d2a2a6aa4c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint:e630479d-ba79-a534-2485-8d2a2a6aa4c9
msgctxt "hf7d09a6fg9629g40f9g869eg063fbd51ab21"
msgid "Aw. Hugs and kisses when we get back to Moonrise then, yeah?"
msgstr "아. 그럼 문라이즈에 도착하면 포옹과 키스를 해줄게, 알겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000
#. Speaker = Brawler Vez
#. NodeID = 709bd916-97d3-a6ec-1556-6053de9ef829
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinMelee_000(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanGoblinMelee_000(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000:709bd916-97d3-a6ec-1556-6053de9ef829
msgctxt "hdf7728deg69e0g4608ga579g138571f14a47"
msgid ""
"Can we get movin'? Nabbed these boots from a gnome, and they don't bloody "
"fit."
msgstr "이제 좀 가면 안 돼? 이 신발 노움한테서 가져온건데, 겁나 불편하다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000
#. Speaker = Brawler Vez
#. NodeID = d04dabf3-bb97-2339-34aa-11233bd38cd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinMelee_000(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000:d04dabf3-bb97-2339-34aa-11233bd38cd5
msgctxt "h10e76dfbga976g448cga21agf3625eb755c1"
msgid "We going or what? Shadows ain't gettin' any friendlier."
msgstr "출발하긴 하는 거야? 그림자랑 친구 먹으려는 것도 아니고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000_AtTower
#. Speaker = Brawler Vez
#. NodeID = b699ebc4-2ebd-44a5-a537-57703944c888
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinMelee_000(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000_AtTower:b699ebc4-2ebd-44a5-a537-57703944c888
msgctxt "h07fdbc4ag9f67g4a7cgaf1aga42f32860467"
msgid "Wish we was assigned to the war camp. Beer's surely better down there."
msgstr "군영에 배치됐으면 좋았을걸. 거기 맥주가 훨씬 나을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000_AtTower
#. Speaker = Brawler Vez
#. NodeID = ed0d8736-4dae-44e0-a642-19b61bb3c685
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinMelee_000(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanGoblinMelee_000(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_000_AtTower:ed0d8736-4dae-44e0-a642-19b61bb3c685
msgctxt "h8a3a3d65g09c6g45bbg9d56g9dfa35c4e225"
msgid ""
"We scratch our arses down 'ere while that leggy freak gets rewarded above? "
"'S bollocks."
msgstr "우린 여기서 엉덩이나 긁고 있는데, 그 다리 긴 괴물은 상을 받는다고? 개소리가 따로 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001
#. Speaker = Warrior Gronag
#. NodeID = 05c6715a-2d92-40b7-a1da-88bf7262ad39
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanGoblinMelee_001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001:05c6715a-2d92-40b7-a1da-88bf7262ad39
msgctxt "h74af15fcg8c1cg41d9g98b8gde55dee25bba"
msgid "Piss off. I'm busy."
msgstr "꺼져. 난 바빠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001
#. Speaker = Warrior Gronag
#. NodeID = 659cf10a-caf6-426f-a3e8-9626676c0d7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinMelee_001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001:659cf10a-caf6-426f-a3e8-9626676c0d7b
msgctxt "he65b4b06g2a67g4354g9309g0038bce2e2ab"
msgid "What part of 'piss off' weren't clear?"
msgstr "'꺼져' 라는 말을 못 알아들었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint
#. Speaker = Warrior Gronag
#. NodeID = 0eb6fd0d-fc73-48a8-947b-0b2af8801a08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8d01f1f3-ee86-692f-7463-701080213a57_A = True
#. SetFlags:
#.   Local:
#.     - 8d01f1f3-ee86-692f-7463-701080213a57_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint:0eb6fd0d-fc73-48a8-947b-0b2af8801a08
msgctxt "hbf42e549g6147g4d10ga391g3e5e916e24f9"
msgid "Wassat? Hm..."
msgstr "저건 뭐야? 흠..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint
#. Speaker = Warrior Gronag
#. NodeID = 1bc1fc90-7f21-42de-8c70-151dac8faeeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8d01f1f3-ee86-692f-7463-701080213a57_B = True
#. SetFlags:
#.   Local:
#.     - 8d01f1f3-ee86-692f-7463-701080213a57_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint:1bc1fc90-7f21-42de-8c70-151dac8faeeb
msgctxt "h7d5b39e7g9417g4427g8fd0g466b823bc5b5"
msgid "Anyone else pops out unannounced, I'll feed 'em an arrow!"
msgstr "누구든 예고 없이 튀어나오면, 화살을 먹여주마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint
#. Speaker = Warrior Gronag
#. NodeID = 42d47a47-a25c-416e-ac96-3276ee6dfe6e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8d01f1f3-ee86-692f-7463-701080213a57_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint:42d47a47-a25c-416e-ac96-3276ee6dfe6e
msgctxt "hcb5f19feg3188g47abgb37ag8c1d877c0d8c"
msgid "Oi! Someone out there?"
msgstr "어이! 거기 누구 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint
#. Speaker = Warrior Gronag
#. NodeID = 47a5ba1c-5c0e-4880-8361-c0a0085f7159
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8d01f1f3-ee86-692f-7463-701080213a57_C = True
#. SetFlags:
#.   Local:
#.     - 8d01f1f3-ee86-692f-7463-701080213a57_B = False
#.     - 8d01f1f3-ee86-692f-7463-701080213a57_C = False
#.     - 8d01f1f3-ee86-692f-7463-701080213a57_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AD_AtCheckpoint:47a5ba1c-5c0e-4880-8361-c0a0085f7159
msgctxt "hb551babag1746g4cc7gbf6fgaaefa8bd3c04"
msgid "That freak best be ready to guide us when it's time."
msgstr "그 괴물이 때가 되면 우리를 안내할 준비가 되어 있어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AtTower
#. Speaker = Warrior Gronag
#. NodeID = 5eba5e22-0046-42d1-aaae-59164e2a5b96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinMelee_001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AtTower:5eba5e22-0046-42d1-aaae-59164e2a5b96
msgctxt "h974b6c6fg6a80g4a1agb0c5gad1b750d1385"
msgid ""
"Absolute's blessing on ya. Maybe Her design will throw us together again "
"sometime."
msgstr "절대자님의 축복이 있기를. 그분의 설계가 허락하신다면 언젠가 또 만날지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AtTower
#. Speaker = Warrior Gronag
#. NodeID = fe8562b9-3b5b-409c-9c4f-9cf877c7d329
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinMelee_001(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanGoblinMelee_001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinMelee_001_AtTower:fe8562b9-3b5b-409c-9c4f-9cf877c7d329
msgctxt "h021e795dg474dg4dd3gb9c7gceb13dad580a"
msgid ""
"Look busy if y'can, True Soul. I hear the Disciple ain't long putting idle "
"hands to work."
msgstr "바쁜 척이라도 하라고, 참된 영혼. 한가하게 있으면 신봉자가 일을 시킨다고 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger
#. Speaker = Sharp-Eye Lora
#. NodeID = b20372a8-4425-9f17-a5b7-4d108122fe81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanGoblinRanger(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger:b20372a8-4425-9f17-a5b7-4d108122fe81
msgctxt "h95bf89b8ge8fbg4e4ag8a44g4bb63971211e"
msgid "I miss the camp. It's too quiet out here."
msgstr "야영지가 그리워. 여긴 너무 조용해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger
#. Speaker = Sharp-Eye Lora
#. NodeID = be5e16d3-6f73-4860-35a4-029a8b04ca55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinRanger(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger:be5e16d3-6f73-4860-35a4-029a8b04ca55
msgctxt "hbcca8fbcgc1a1g468agae04ga5c93bba1bf7"
msgid "Wish I had a drink..."
msgstr "한 잔 마시고 싶은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger_AtTower
#. Speaker = Sharp-Eye Lora
#. NodeID = 24eaaff2-2fd4-4705-9ab6-3ecb163613f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinRanger(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger_AtTower:24eaaff2-2fd4-4705-9ab6-3ecb163613f0
msgctxt "h24a6bc10gd8cbg492agad5eg9bd9c4ef7779"
msgid ""
"No food waiting for us? 'S barbaric. They got plenty of prisoners for the "
"roasting."
msgstr "준비해 둔 음식이 없다니? 말도 안 돼. 죄수가 저렇게 많은데 좀 구우면 되겠구먼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger_AtTower
#. Speaker = Sharp-Eye Lora
#. NodeID = aabf507d-0036-4a57-a754-2c52d031d775
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_Drider_HasMet_CaravanGoblinRanger(1) = False
#. SetFlags:
#.   Dialog:
#.     - SCL_Drider_HasMet_CaravanGoblinRanger(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_GoblinRanger_AtTower:aabf507d-0036-4a57-a754-2c52d031d775
msgctxt "he847cf41g1e4cg4fadg9af9gb3d51fa240c6"
msgid "Good luck inside the tower, boss. Better you than me."
msgstr "타워 안에서도 행운이 따르길 빌게, 형씨. 내가 아니라 다행이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 00dd83a3-7c2b-aa2b-bd37-b8b8f70f15e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:00dd83a3-7c2b-aa2b-bd37-b8b8f70f15e6
msgctxt "he98f63bagc5cbg40a4g90ecg8c991343e949"
msgid "I'll be damned."
msgstr "이런 망할."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 0180f9fc-20ba-95b3-b365-bc087e531b4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster:0180f9fc-20ba-95b3-b365-bc087e531b4c
msgctxt "h26ab3b12g69f2g44e1g964dgfd84a57a4c0e"
msgid "As the Absolute wills. We'll wait."
msgstr "절대자의 뜻대로. 기다리지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_HalfOrcCaster
#. Speaker = Kansif
#. NodeID = 024b6b21-87f6-7e6b-98ad-0ab71da3630f
#. HandlePath = TaggedText[0].TagText[0]
