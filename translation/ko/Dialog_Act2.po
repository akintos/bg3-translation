msgid "Cell Two"
msgstr "수감실 2"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Prison_AD_CellPlaque3
#. Speaker = Narrator
#. NodeID = cc08dd17-3848-493f-b2b4-808f88cbe52f
