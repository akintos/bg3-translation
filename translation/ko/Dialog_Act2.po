msgctxt "h91aa57b6ge3c0g4b4fg83b0ga98aad862ecf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar
#. Speaker = Player
#. NodeID = 27b288a7-59e4-e5cd-a349-7954750904e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CentralSquare_State_AltarDesecrated = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar:27b288a7-59e4-e5cd-a349-7954750904e2
msgctxt "hcba2a0a6gf13dg4bc8g9a24g83d93a3d6de1"
msgid "<i>The dagger won't be missed - take it.</i>"
msgstr "<i>단검을 놓칠 순 없다, 가져간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar
#. Speaker = Player
#. NodeID = 3ab2fa52-5255-26e3-477e-1dc2848b02dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_RecitedDogmas = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR or REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar:3ab2fa52-5255-26e3-477e-1dc2848b02dd
msgctxt "h27373b0ag18e3g4107g8f72gc2cf987240f5"
msgid ""
"<i>Take up the dagger, recite Shar's wisdom and offer blood from your "
"arm.</i>"
msgstr "<i>단검을 집어들고, 샤의 지혜를 암송한 뒤 팔에서 피를 바친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar
#. Speaker = Narrator
#. NodeID = 4b14a1ba-e0db-eb82-3b69-2a0c34b8ecaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar:4b14a1ba-e0db-eb82-3b69-2a0c34b8ecaf
msgctxt "h1e10413ag6c49g4681g8108g3ed000962f58"
msgid ""
"*The altar's purpose is unclear - but the dagger upon it looks valuable.*"
msgstr "*제단의 목적은 불분명합니다만, 놓여있는 단검은 값비싸 보이는군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar
#. Speaker = Narrator
#. NodeID = 54893f80-4b5b-92d1-f889-39bf2efbb4c9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - TWN_CentralSquare_SharAltar_Event_PassedPassiveReligion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar:54893f80-4b5b-92d1-f889-39bf2efbb4c9
msgctxt "h1589f533g4cf5g480fg9793g885bb68adec3"
msgid ""
"*An altar to Shar. It appears to seek pray, and a blood offering - your "
"blood.*"
msgstr "*샤에게 바치는 제단입니다. 희생양과 피의 공물을 원하는 듯합니다. 바로 당신의 피를요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar
#. Speaker = Player
#. NodeID = 66f393bc-f823-069b-a54f-a09e5b345d3f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CentralSquare_State_RecitedDogmas = True
#. TagRule: !(CLERIC_SHAR and PALADIN_SHAR and REALLY_SHADOWHEART)
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar:66f393bc-f823-069b-a54f-a09e5b345d3f
msgctxt "h175ab7bbg2149g4566g9c40ga79181558a95"
msgid "<i>Take up the dagger, recite Shar's dogma, and cut your arm.</i>"
msgstr "<i>단검을 집어들고, 샤의 교리를 암송한 뒤, 팔을 벤다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar
#. Speaker = Narrator
#. NodeID = 7c486075-4c0b-9aed-b342-553f1e5a7989
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(1) = True
#. SetFlags:
#.   Dialog:
#.     - TWN_CentralSquare_SharAltar_Event_PassedPassiveReligion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar:7c486075-4c0b-9aed-b342-553f1e5a7989
msgctxt "h0374b301g255cg47d1gb8a8g51a3c29161ae"
msgid ""
"*Though you are outcast, Shar's dogma remains firmly entrenched in your "
"mind. You know what this altar seeks - blood.*"
msgstr "*배교자일지언정, 샤의 교리는 확고하게 당신 마음 속에 남아 있습니다. 당신은 이 제단이 무엇을 원하는지 압니다. 피입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_DistillerySignpost_AD
#. Speaker = Narrator
#. NodeID = 3194e9e2-fc4d-4487-8110-ac7630faad3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_DistillerySignpost_AD:3194e9e2-fc4d-4487-8110-ac7630faad3f
msgctxt "hcff3793fg921dg484fg813cg534f59aa276d"
msgid ""
"*Here - The Waning Moon \n"
"North - Central Square \n"
"East - Reithwin Tollhouse*"
msgstr ""
"*이 곳 - 기우는 달\n"
"북 - 중앙 광장\n"
"동 - 라이스윈 통행료 징수"

