msgctxt "h0523c86aga07ag46e3g809fgc0f54e3aad64"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_Zevlor_Dead
#. Speaker = Zevlor
#. NodeID = f0535e05-d420-24fb-3b16-972e4a7ccd23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_Zevlor_Dead:f0535e05-d420-24fb-3b16-972e4a7ccd23
msgctxt "hfc329045g22f0g4ea7gad24gbd9f31d14d67"
msgid "No... we are... sainted... safe... <b>home</b>..."
msgstr "아니다... 우리는... 거룩해졌다... 안전하다... <b>고향</b>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_Zevlor_Dead
#. Speaker = Narrator
#. NodeID = ff452cd1-f9c3-4803-bb3a-68a6b38b41c8
