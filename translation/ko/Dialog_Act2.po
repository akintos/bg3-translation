msgctxt "ha527aa17g3e45g4b98g839cg507656ed8e45"
msgid "Marcus Falgor... raised in... Baldur's Gate..."
msgstr "마커스 팔고어...발더스 게이트... 출신..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = cd4dc2a7-42c6-48b2-9efa-4e5a735c04f5
