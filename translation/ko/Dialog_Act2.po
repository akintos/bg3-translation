msgctxt "hde461c68ga4e2g4fa3g945dgeb58d162e3cd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_Zevlor_Dead
#. Speaker = Zevlor
