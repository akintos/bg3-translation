#.      - HAV_Mood_State_Unprotected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:3c5bf484-81fc-48f7-aa4a-cf6760e07d57
msgctxt "h0adc6aacgabf3g4e03g817cgbe55ebffb179"
msgid "Not now."
msgstr "지금은 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
#. Speaker = Fist Ulthred
