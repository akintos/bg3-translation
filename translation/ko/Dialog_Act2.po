msgid "*Bark.*"
msgstr "*컹.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_FoodPrepComment
#. Speaker = 'Tomelia'
#. NodeID = 3d8bfd34-52d7-461d-81de-559144a0e29c
#. HandlePath = TaggedText[0].TagText[0]
