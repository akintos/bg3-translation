msgctxt "ha8acf442g7495g4280ga433g097d9f7c5f8a"
msgid "It won't budge. Seems I'll have to fight my way out."
msgstr "꿈쩍도 안 해. 싸워서 길을 뚫어야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked
#. Speaker = Player
#. NodeID = 50d0d5df-6961-45cc-9662-55119fa0f362
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked:50d0d5df-6961-45cc-9662-55119fa0f362
msgctxt "hb190c821g4832g4b6fga6cag9b17641c05fc"
msgid "It's stuck. Nothing for it but to stand my ground in battle. \n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_ExitLocked
#. Speaker = Player
#. NodeID = 50d0d5df-6961-45cc-9662-55119fa0f362
