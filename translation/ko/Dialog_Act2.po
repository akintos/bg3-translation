msgctxt "h07b52a13gbb42g4c05gb487g47279b62c9a7"
msgid "The Absolute will not win this day."
msgstr "오늘이 절대자가 이기는 날은 아닐 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Harper Callie
#. NodeID = 15c32e83-f5e0-4a7d-bbcd-2cc0b45c3c4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_AD_JaheiraReport:15c32e83-f5e0-4a7d-bbcd-2cc0b45c3c4d
msgctxt "h9cb9e5d4g58b4g4a4dg8790gba66f7018728"
msgid "Maybe not, ma'am."
msgstr "아닌 것 같습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_JaheiraReport
#. Speaker = Jaheira
#. NodeID = 33e0d9c4-f521-408c-9f91-9b29cceefb37
#. HandlePath = TaggedText[0].TagText[0]
