#.      - 8baf8087-81b0-de5d-3efa-f74769a625f4_C = True
#. SetFlags:
#.   Local:
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_B = False
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_C = False
#.     - 8baf8087-81b0-de5d-3efa-f74769a625f4_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek:52e4abc3-9abf-6a9a-924c-5761255ae56a
msgctxt "h606a4b04g0adbg438egbfdeg135af80afb4d"
msgid "Better luck next time."
msgstr "다음엔 더 잘해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_AD_AfterHideAndSeek
#. Speaker = Oliver
#. NodeID = 6e6366a2-83a6-4680-a912-628e6ba49e90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_OliversDiary_State_FoundAgain = True
#. SetFlags:
