#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:19762847-81a4-9461-cef5-0c3c3a8c5daa
msgctxt "he86e8176g3120g41f8gbedegadb61abd7c78"
msgid ""
"Is that Arabella's mother she's tending? Our little idol thief has some "
"terrible luck."
msgstr "저 여자가 돌보는 사람 아라벨라의 어머니 아닌가? 우리 귀여운 우상 도둑은 진짜 운이 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Player
#. NodeID = 1d9b92b9-369c-d3bd-0531-498b68821199
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CorpseTender_State_PassedCorpseCheck = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:1d9b92b9-369c-d3bd-0531-498b68821199
msgctxt "hebd7e64eg848cg43f3g9224g255f971c98fd"
msgid "I see you have medical supplies on hand. Can you spare any?"
msgstr "의약품이 있는 것 같은데. 나눠줄 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = 1eae18d6-5f73-d4c0-9ade-055b6b74b7f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:1eae18d6-5f73-d4c0-9ade-055b6b74b7f9
msgctxt "h68156df3g846fg4bb6gb687ge06e58ede639"
msgid ""
"You must be mistaken - the doctor would have informed us of such an "
"arrangement."
msgstr "잘못 알고 계신 거예요. 근무 조정이 있었으면 선생님께서 진작 통보하셨을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Player
#. NodeID = 244cc52d-d64f-4ee1-c5c6-620f0ec49a78
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
