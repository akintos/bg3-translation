#. SetFlags:
#.   Dialog:
#.     - HAV_FountainGuards_Melee_1_Siege_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:61ad60de-f6c8-453f-8c72-c896384d9cdd
msgctxt "hea84d6b9g831fg4255g8ddagc918f0cd857c"
msgid "Here to help, I hope."
msgstr "도우러 온 거길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
