msgctxt "hdbf93902gad0ag46b5g8ee0g2ac985d8fe83"
msgid "Remarkable. Truly."
msgstr "정말이지, 대단해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_KethericShowdown_CrownController
#. Speaker = Player
