msgctxt "h9aee2a9bgf5e5g45c9g9e98gb2fbd95b47c1"
msgid "Strong, silent type, are you? Half right, anyway."
msgstr "강한데 말은 없는 부류인가? 둘 중 하나는 맞겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_003
