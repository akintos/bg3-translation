#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_004_PostAssault_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004:5473159e-7fb7-a937-dd77-8afb7a72905a
msgctxt "hbd6bf34bg972ag4dc9g8ca8g2f5e625bd94a"
msgid "Good luck."
msgstr "행운을 빌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004
#. Speaker = Fist Hadenwell
#. NodeID = 68b25928-54ef-4dce-8353-d0a32cbed461
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_004_ThroneRoomDefeated_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_004_ThroneRoomDefeated_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004:68b25928-54ef-4dce-8353-d0a32cbed461
msgctxt "he4e85447g603ag4819gb394gf5167df3cd37"
msgid "Bloody. Steps. Give me a level battlefield any time."
msgstr "빌어먹을 계단. 평지 싸움은 언제나 환영인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004
#. Speaker = Fist Hadenwell
#. NodeID = 6fdf43dc-bccc-d487-044b-1e9626102df4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_004_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004:6fdf43dc-bccc-d487-044b-1e9626102df4
msgctxt "hf6bf427fg825cg42c3g8d03gb82435fca05b"
msgid "Little farther still."
msgstr "아직 좀 더 남았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004
#. Speaker = Fist Hadenwell
#. NodeID = 8540c417-e25d-40d2-b200-3c450b3ebe73
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_004_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004:8540c417-e25d-40d2-b200-3c450b3ebe73
msgctxt "h1f860c9bgd447g4afaga8ffgedea96a40f4b"
msgid "Ready to move, boss. At your command."
msgstr "다 준비됐으니, 명령만 내려달라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004
#. Speaker = Fist Hadenwell
#. NodeID = d442b685-1a27-42a4-8d74-e495b7510c51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_004_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_004_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004:d442b685-1a27-42a4-8d74-e495b7510c51
msgctxt "h17a24375g8852g4743g83cdg98a9580bc29b"
msgid ""
"Gods, but I hate fighting cultists. Godsick fools never think to surrender."
msgstr "젠장, 난 추종자랑 싸우는 게 싫어. 미친놈들이 항복은 안중에도 없다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = 1cf76dca-9711-4d04-80ec-9fc764a05a2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_001_ThroneRoomDefeated_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_001_ThroneRoomDefeated_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:1cf76dca-9711-4d04-80ec-9fc764a05a2b
msgctxt "hae7de8ebg5733g43c5g85edg44028e3a1a7e"
msgid "Onwards. Ketheric can't hide from us now!"
msgstr "전진하라. 케서릭은 우리로부터 숨을 수 없을 것이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = 2020c08b-b2a5-4b5b-bbfe-355ec37f8b79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_001_PostAssault_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_001_PostAssault_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:2020c08b-b2a5-4b5b-bbfe-355ec37f8b79
msgctxt "h168bb337gba15g4485g8cd1gf8edab137448"
msgid "That light below... We've already weakened Shar's hold here."
msgstr "저기 저 빛 좀 봐... 이 곳에서 샤의 영향력은 이미 약화됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = 2f696bd0-8bf6-7c4c-8695-452781e58686
#. HandlePath = TaggedText[0].TagText[0]
