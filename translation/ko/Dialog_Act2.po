msgctxt "h16429c66g3d8bg4f13g8c0cg1b3328bec350"
msgid ""
"I want to resurrect [CAMP_Jergal_PlayerToResurrect_3_56966d5e-534d-4930-264e-"
"050a2345db3d]."
msgstr ""
"[CAMP_Jergal_PlayerToResurrect_3_56966d5e-534d-4930-264e-050a2345db3d]을(를) "
"부활시키고 싶어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = b26db2cd-b099-4de9-867b-0ec5fa8605a6
