msgctxt "heb99a55dg4a0eg48aeg9b33gb3009ebf0ff0"
msgid "*Howl!*"
msgstr "*아우우!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Kitchen_AD_Gnoll01
#. Speaker = 'Barnabus'
#. NodeID = bc9aae45-d250-4265-988f-4bfd74f141ff
