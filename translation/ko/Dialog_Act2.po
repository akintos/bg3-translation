msgctxt "h4be77d0cg19d1g4b4bg8ee4gecdf75e2761c"
msgid "Sending a child out there to die? Damned spiteful - even for you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Gale
#. NodeID = fbda73cb-e175-af70-6520-647a6b1b4ea3
#. HandlePath = TaggedText[0].TagText[0]
