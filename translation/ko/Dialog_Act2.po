msgctxt "h3be57444g516fg465fga0b7g2636c3c7d07d"
msgid ""
"I'm practicing my audition! Go away! Unless you're buying the next round..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Player
#. NodeID = 6c76fdaf-a1d0-f477-bf15-31b89e30b01a
