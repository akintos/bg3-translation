msgid "Count your lucky stars."
msgstr "그러니까 여길 다행으로 생각하셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_FountainGuards_Melee_2_InCombat
