#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1:62820087-e33d-5548-8e2b-3febbd9b116b
msgctxt "hd85d975egc898g4defga7e2gd25ecd6a4524"
msgid "No more waiting, no more hiding. This is it."
msgstr "더 이상 기다리지도, 숨지도 않아. 때가 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_FountainGuards_Melee_1
