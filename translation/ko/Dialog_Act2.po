msgctxt "h28d9a2abg491ag4dd3gbfeagef1e810a63fe"
msgid "Gored to death, by the look of it."
msgstr "겉보기에는 찔려 죽은 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedTiefling
