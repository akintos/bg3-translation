msgctxt "h9a35d458gb6b6g49a0g9bcag4c4e54a788ee"
msgid "Go on, toy soldier. Run me through!"
msgstr "어서, 장난감 병정아. 날 죽여 보란 말이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_NightsongAttacked
#. Speaker = Nightsong
#. NodeID = a8edce58-85ae-4406-bd0e-117bbb8d394b
