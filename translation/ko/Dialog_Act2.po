#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:67524c95-f850-4dc3-a55e-62f026b24fbe
msgctxt "hca94eaedg7e36g4be8gb3dagadb030f2b034"
msgid "I... what have I done?"
msgstr "난... 무슨 짓을 한 거지? "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = a576119f-2f5b-4661-a472-6c5cca26ff52
