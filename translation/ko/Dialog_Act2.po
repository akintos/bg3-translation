#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByInnerRing(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:61777591-6b0f-5047-16f2-79d3095a03fc
msgctxt "h8b0cb442g2af9g4324g8a9fg9b3d84eec6a1"
msgid "Dammit! Thought I had it."
msgstr "썅! 통과한 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 61777591-6b0f-5047-16f2-79d3095a03fc
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_InnerRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByInnerRing(0) = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:61777591-6b0f-5047-16f2-79d3095a03fc
msgctxt "ha402989fg1804g4e56gb02ag793dd645a327"
msgid "Again. Until the challenge is equalled."
msgstr "다시 해 보자. 될 때까지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 61777591-6b0f-5047-16f2-79d3095a03fc
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_InnerRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByInnerRing(0) = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:61777591-6b0f-5047-16f2-79d3095a03fc
msgctxt "he5374c77gc6a1g4ebdg85degd3bb00d26548"
msgid "Thwarted at the final hurdle. Next time..."
msgstr "마지막 단계에서 막혔군. 다음 기회엔..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 61777591-6b0f-5047-16f2-79d3095a03fc
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_InnerRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByInnerRing(0) = True
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:61777591-6b0f-5047-16f2-79d3095a03fc
msgctxt "h737cf107g8c85g4bd6g832ag34314fcfe82b"
msgid "Close... I just need to take more care at the last."
msgstr "다 왔어... 마지막에 조금만 신중하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 61777591-6b0f-5047-16f2-79d3095a03fc
#. HandlePath = TaggedText[9].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_InnerRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByInnerRing(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:61777591-6b0f-5047-16f2-79d3095a03fc
msgctxt "h87caca8egb88dg4021g9829g5e4a41482596"
msgid "Almost made it that time - just have to watch my step."
msgstr "거의 다 했었는데. 내 걸음만 조심하면 되겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "h5b9db093g8722g4388g8145g900bf4ed2cae"
msgid "What in the wretched hells was that?"
msgstr "대체 저 망할 건 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "hb50d8ce1g60dfg467cg9f4fg49bd66556e6d"
msgid "<i>Tsk'va</i>. A force as powerful as it was unexpected."
msgstr "<i>츠크바</i>. 예상 못한 만큼 강한 힘이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "h494f5342g7d14g4114g9056g2add3ceca000"
msgid "Hell of a breeze down here. What in Faerûn was that?"
msgstr "바람이 세차게도 부는군. 방금 그건 대체 뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "h7668fdaag3254g4c55gb6cfgb3a0e269ec1a"
msgid "Well that left me winded."
msgstr "이거 숨차게 해주는걸. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "hea4a4a97gad22g4429gb2a5g4806aa6678a1"
msgid "Hells. Knocked the wind right out of me."
msgstr "젠장. 바람이 날 바로 날려버렸네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "h663e47f9gfd7eg4eb6g90afgcd3fed647d5e"
msgid "Whoa, what was that?"
msgstr "와, 저게 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "hc923fa8cgb2c5g4bd5g8f0eg5416a7dc1bc8"
msgid "Ooft. Why do dungeons always have a way of bruising buttocks?"
msgstr "으윽. 왜 던전엔 늘 엉덩이에 멍드는 길이 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "h33713a9fga11bg4a0cg8669g816f513d4d0d"
msgid "Such a force... what caused it?"
msgstr "저런 힘이라니... 어디서 나왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "h978a9d74g9578g4444g9a21g6abdc140b551"
msgid "Straj. The centre of the room is protected."
msgstr "스트라지. 방 중앙부는 보호받고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = 7746fa33-99fe-824b-6194-a6d8fe2a2f0d
#. HandlePath = TaggedText[9].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:7746fa33-99fe-824b-6194-a6d8fe2a2f0d
msgctxt "h29c7030age333g462egbd82g0429613b970f"
msgid "What the hells was that...?"
msgstr "대체 뭐였지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "h29fd6e64gaef6g47e8g9557gf979120b15c4"
msgid "Well that didn't work. There must be a way around it..."
msgstr "이런, 통하지 않았군. 갈 수 있는 방법이 분명 있겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
