#.     - 40f1f8f3-bb4c-5f25-6d22-2ad9120959c2_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_GEN_AD_IntellectDevourer:e2646bc6-4e5e-46a0-85bc-fe262e06b00e
msgctxt "h40fbc0dbg5d89g4da5g9589g9aa15a2cf339"
msgid "Down. Down. Down. She waits."
msgstr "내려가. 내려가. 내려가. 그녀가 기다려."

