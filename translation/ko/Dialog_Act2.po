msgctxt "he52579b2g3c5bg454egb2feg622ef5c31b41"
msgid "Break already!"
msgstr "이미 부서졌어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = d1286750-2af1-4a70-99c6-bdca321dd41c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADGuardsReaction(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADGuardsReaction(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister:d1286750-2af1-4a70-99c6-bdca321dd41c
msgctxt "h5511b283g570cg4be8gb01bg3880a5f2e52d"
msgid "I'll die before I let you near the boat. Come on!"
msgstr "널 배에 접근하게 두느니 죽겠어. 덤벼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = df3572ac-ec21-4679-b6ef-8873f8769ff5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADEscaping(0) = True
#. SetFlags:
#.   Local:
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_G = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADEscaping(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister:df3572ac-ec21-4679-b6ef-8873f8769ff5
msgctxt "h82bbbddfg4101g45degb8e7g95b3eda30896"
msgid "Run. RUN."
msgstr "뛰어. <b>뛰라고</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = e2629ea6-0e3e-45d0-b365-2b36bf43481a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0276d317-8b34-66e2-48e2-6b9d69d6830b_C = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_D = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister:e2629ea6-0e3e-45d0-b365-2b36bf43481a
msgctxt "h0e43bb6cg4bf7g4075ga57bg020a4df01789"
msgid "What are these chains made of?! <i>Argh.</i>"
msgstr "이 사슬은 대체 뭘로 만든거야?! <i>아악.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = ef4d1960-e6aa-9e22-69bb-ee78a5a28273
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Local:
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_H = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister:ef4d1960-e6aa-9e22-69bb-ee78a5a28273
msgctxt "h98b95430gc328g4082gb25cg2fd978f73808"
msgid "We can't wait - get to the boat, or we leave without you!"
msgstr "더는 못 기다려, 빨리 타, 아니면 두고 갈 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = f1eb3120-2ad9-4ede-b667-44574802b07f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_C = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister:f1eb3120-2ad9-4ede-b667-44574802b07f
msgctxt "h44f638dfg05bag42e9g82c8gf05b8841167c"
msgid "Bloody thing is chained up<i>, </i>hang on."
msgstr "망할 이거 묶여 있잫아<i>, </i>기다려봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = f270a320-6b0a-4e8d-76c8-0fa880b846bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Local:
#.      - 0276d317-8b34-66e2-48e2-6b9d69d6830b_H = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_ForceBoatLeave = True
#.   Local:
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_H = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister:f270a320-6b0a-4e8d-76c8-0fa880b846bb
msgctxt "h3d4cb35bgd268g4f62g8529gf4af929bea7c"
msgid "There's no more time."
msgstr "더 이상 시간이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = f7b797be-4b7a-421f-8e54-2bc8b46e5a85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_E = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister:f7b797be-4b7a-421f-8e54-2bc8b46e5a85
msgctxt "h411e6138g9e9ag4ba5g9bd2gee3ed757261f"
msgid "I need to leave this stinking hellspit. <i>Now.</i>"
msgstr "이 지독한 지옥구덩이에서 벗어나야 해. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 048333ae-d4e1-2dc7-e9c1-1d6bb796880f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:048333ae-d4e1-2dc7-e9c1-1d6bb796880f
msgctxt "h0a2641b0ga769g4400g85afg60b15518f2b8"
msgid "She already has."
msgstr "이미 막으셨는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Lakrissa
#. NodeID = 277cf228-43ca-0507-845e-09e7ae5d89a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:277cf228-43ca-0507-845e-09e7ae5d89a9
msgctxt "he43fd557g54abg4b14ga564g255cc8b32b8e"
msgid "Keep walking."
msgstr "가던 길 가시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 3963e94a-d49e-f6de-b435-f4b65090702b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:3963e94a-d49e-f6de-b435-f4b65090702b
msgctxt "h339a5d34g07a8g4563g887eg2c1f963849aa"
msgid ""
"A now I have the undying love of the Absolute. I pity you will  never know "
"that feeling."
msgstr "난 이제 절대자님의 불멸의 사랑을 얻었다. 네가 이 감정을 평생 알지 못할 거라 생각하니 딱하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Danis
#. NodeID = 3994dd8b-30d2-bcda-73c3-d32665fba725
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:3994dd8b-30d2-bcda-73c3-d32665fba725
msgctxt "h43256174g7a7fg4e1eg97bdg80cd44ccf221"
msgid "Leave me alone. Please."
msgstr "날 내버려둬. 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Lia
#. NodeID = 4026e535-0c76-3b13-d718-76f2b61f771c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:4026e535-0c76-3b13-d718-76f2b61f771c
msgctxt "h869786c7g5baag4bc6g8796gcb494b0c4b11"
msgid ""
"I've found peace. I feel it every time I close my eyes and imagine slitting "
"your throat."
msgstr "난 이미 평온한데. 눈을 감고 네 목을 베는 상상을 할때마다 평온함을 느껴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 76180eb9-b4ef-c467-47ba-08ef63904289
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:76180eb9-b4ef-c467-47ba-08ef63904289
msgctxt "hdb5d968fgb2c4g4882ga2a5gf96ac469d063"
msgid ""
"You're a lost cause. I only pray you're more useful dead than you were alive."
msgstr "넌 쓸모 없어. 네가 죽었을 때가 살아있을 때보다 더 쓸모 있길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 7806754b-dcf9-e985-b8b5-b7e1bb6f1bb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4466a73c-607a-4a7e-c1e5-94d549e8f23d_A = True
#. SetFlags:
#.   Local:
#.     - 4466a73c-607a-4a7e-c1e5-94d549e8f23d_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:7806754b-dcf9-e985-b8b5-b7e1bb6f1bb2
msgctxt "h3a917fc7ga904g4fb5g8583g4746cd705442"
msgid ""
"You're lucky, you know. It's rare that Disciple Balthazar takes a personal "
"interest in prisoners."
msgstr "너는 운이 좋군. 신봉자 발타자르가 죄수에게 개인적으로 관심을 갖는 일은 드물거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Cal
#. NodeID = 783c89cc-fb83-294f-5fc3-0126982b1c02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:783c89cc-fb83-294f-5fc3-0126982b1c02
msgctxt "h0db241bag195cg457cg8af7gd89a05aad0fc"
msgid "You know, the rest I can understand, but you're one of <i>us.</i>"
msgstr "이봐, 다른 사람이라면 이해해도, 너는 <i>우리</i> 편이었잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 86ae7c49-df94-0eac-ecf8-32abe69a1fe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:86ae7c49-df94-0eac-ecf8-32abe69a1fe1
msgctxt "h2ac05432gb407g48aegadc5g47f72f552d46"
msgid ""
"I am doing this <i>because </i>of Elturel. We were driven out of our homes "
"because we're weak."
msgstr "내가 이러는 건 엘투렐 <i>때문이다</i>. 우리가 약했기 때문에 우리의 고향에서 쫓겨난 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 86e1c596-7614-8e8b-8e0b-4bd6a436b24a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:86e1c596-7614-8e8b-8e0b-4bd6a436b24a
msgctxt "hc05c671agac19g4541g8a80g06e31d1edd01"
msgid ""
"Or, if you're very lucky, perhaps he will split you open and sew in a new "
"one."
msgstr "아니면 네가 운이 매우 좋다면, 아마도 그가 널 쪼개고 다시 새롭게 만들어 줄 지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 9236704b-ae5b-cb10-e6b3-38a6851850f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:9236704b-ae5b-cb10-e6b3-38a6851850f0
msgctxt "h420ad9b7gcf02g4db3gb7a3g845cba935e8c"
msgid ""
"The Absolute gave me a new name, a new life. She can do the same for you."
msgstr "절대자께서 내게 새로운 이름, 새로운 삶을 내려주셨다. 너에게도 같은 걸 해주실 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = 94d2ba20-e0c2-058d-b287-9cf18045c2f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:94d2ba20-e0c2-058d-b287-9cf18045c2f5
msgctxt "hade0a76dg414fg417fg88c7g1ce628269c83"
msgid ""
"Through the Absolute, we will be weak no more. You should be grateful to be "
"part of that."
msgstr "절대자님을 통하면, 우린 더이상 약해지지 않을 것이다. 그 일원이 되는 것에 감사해야 할 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = a02efb58-c20e-dd19-f236-393cc2d4cf93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:a02efb58-c20e-dd19-f236-393cc2d4cf93
msgctxt "h3bdd79d5gea86g4f85g8739g9b3f507d63b5"
msgid "*Sigh.* You'll see the truth soon enough, whether you like it or not."
msgstr "*휴.* 곧 진실을 알게 될 거다, 네가 원하든 원치않든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Lia
#. NodeID = a49673c0-362e-b63d-6133-5be34ea5e02d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:a49673c0-362e-b63d-6133-5be34ea5e02d
msgctxt "h261cc389g6a3cg45f4ga11bg8c5aa7fae6bb"
msgid ""
"Pray I never get out of here, Warden - the Absolute won't stop me, or my "
"blade."
msgstr "내가 여길 나가지 않길 기도해, 간수장. 절대자는 나와 내 칼날을 막지 못 할걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = acea7365-8f2a-5cdd-09e2-9a3bd8b83402
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:acea7365-8f2a-5cdd-09e2-9a3bd8b83402
msgctxt "ha0067a26ge12fg4e7ag967dg495824b4fb69"
msgid ""
"Were you as strong as you claim, you wouldn't be here. Neither would your "
"brother."
msgstr "네가 말하는 것 만큼 강했더라면 여기 있지도 않았어. 네 형제 마저도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = cda12949-9464-0921-fed5-6293a9d033a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:cda12949-9464-0921-fed5-6293a9d033a8
msgctxt "h838cdfdeg844eg4396g97f4g92cf6bb26481"
msgid "A nice play, but everyone I loved died screaming in Avernus."
msgstr "잘하는 걸, 하지만 내가 사랑했던 모든 사람들은 아베르누스에서 비명을 지르며 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = cf776a22-7764-1f11-a4e9-611bd6683bd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:cf776a22-7764-1f11-a4e9-611bd6683bd7
msgctxt "hfecfb65bge9e6g4120g9f7cgc5f4a13b3608"
msgid ""
"I am far gentler than Disciple Balthazar. You wish to live? Grow a spine."
msgstr "난 신봉자 발타자르보다 훨씬 친절하다구. 살고 싶어? 그럼 근성을 키워야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = d3b9c75e-ed1f-5e3a-5129-8b2986ddfb27
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4466a73c-607a-4a7e-c1e5-94d549e8f23d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:d3b9c75e-ed1f-5e3a-5129-8b2986ddfb27
msgctxt "h5505f447g7b26g42cfg9d3eg6fc1fe390f93"
msgid ""
"Few survive Disciple Balthazar's experiments. This is your chance to submit "
"to the Absolute - to find peace."
msgstr "신봉자 발타자르의 실험에서 살아남은 사람은 거의 없어. 이건 절대자를 받아들이고 평온함을 찾을 기회다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Lia
#. NodeID = e56b0d8b-e782-5465-9943-41eb6e8bf24b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:e56b0d8b-e782-5465-9943-41eb6e8bf24b
msgctxt "hd2946ba8g400eg4ca2gba3fgf8d6f136a4e5"
msgid "Fuck. Off."
msgstr "꺼.져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Cal
#. NodeID = e5c07741-f2b0-8b25-61da-a9dd27932eb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:e5c07741-f2b0-8b25-61da-a9dd27932eb3
msgctxt "hfd8ae4fage928g4683gb60cg4b1f61ad314b"
msgid "Nice speech, but take it elsewhere."
msgstr "멋진 연설인데, 다른데 가서 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = e5ceabcc-554c-4144-6dc4-45faa3a6fb67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:e5ceabcc-554c-4144-6dc4-45faa3a6fb67
msgctxt "hcd1a00b5gbe20g4b4eg807fg819459d69d85"
msgid ""
"I am <i>not</i> one of you. Elturel proved what we knew all along - these "
"horns and tail are a curse."
msgstr "난 너희랑 <i>달라.</i> 애써 부정했지만 결국 엘투렐이 증명한 거야. 뿔과 꼬리는 저주에 불과해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = The Warden
#. NodeID = efd64fbf-eb26-8bac-610c-5f1995d9b8cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4466a73c-607a-4a7e-c1e5-94d549e8f23d_B = True
#. SetFlags:
#.   Local:
#.     - 4466a73c-607a-4a7e-c1e5-94d549e8f23d_A = False
#.     - 4466a73c-607a-4a7e-c1e5-94d549e8f23d_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:efd64fbf-eb26-8bac-610c-5f1995d9b8cf
msgctxt "h4bfdc2f3g8f6ag46e8g9f95gd203039c6e01"
msgid ""
"I used to be like you - weak. <i>Frail.</i> But then I found the Absolute. "
"She can help you."
msgstr "나도 너 같을 때가 있었지, 약하고. <i>여렸지.</i> 하지만 절대자님을 만났지. 그분께서 널 도와주실 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Danis
#. NodeID = f14d3e30-71d1-1088-17a1-0a12dac0e264
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:f14d3e30-71d1-1088-17a1-0a12dac0e264
msgctxt "h43a0b639g2b54g4381g83bfg043a4e8daae8"
msgid "Please, don't do this. Please."
msgstr "제발, 이러지 마, 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Lakrissa
#. NodeID = f31f9bd6-f6d2-3b23-62d6-4932d84b2968
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:f31f9bd6-f6d2-3b23-62d6-4932d84b2968
msgctxt "h938e243bg82e8g4908g906dgff33bab19b7f"
msgid ""
"You're from Elturel, aren't you? Why in the hells are you doing this to us?!"
msgstr "너 엘투렐 출신 맞지? 근데 도대체 여기서 우리에게 왜 이러는 건데?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Cal
#. NodeID = f51a0979-3afc-ad16-71e0-0e8166c398c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:f51a0979-3afc-ad16-71e0-0e8166c398c8
msgctxt "hfeabdc15gf345g41e3g93edg19c7acb94429"
msgid ""
"Maybe a part of you was always missing, but the Absolute has broken you - "
"throughly."
msgstr "전부터 어딘가 결함이 있었을지도 모르지. 하지만 절대자는 널 완전히 망가뜨려 버렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Danis
#. NodeID = fd974575-9433-d5e0-8228-07bb6a916a13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:fd974575-9433-d5e0-8228-07bb6a916a13
msgctxt "h0a1029d8g8524g43a0gaa5bg705efd4a1a4c"
msgid "You saw how they treated us in Elturel. You should be helping us!"
msgstr "엘투렐에서 놈들이 우릴 어떻게 대했는지 너도 알잖아. 우리 도와줬어야지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection
#. Speaker = Lakrissa
#. NodeID = fedee5d3-b750-e0a6-0c5b-b42ac97d7fac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingInspection:fedee5d3-b750-e0a6-0c5b-b42ac97d7fac
msgctxt "hdd823636gad45g4e1fg914bg1cae7e13327f"
msgid ""
"Someone must have loved you - a mother, a father, a lover. What would they "
"say now, if they saw you?"
msgstr "분명 널 사랑해주던 사람도 있었겠지, 어머니, 아버지, 연인. 그 사람들이 지금 네 모습을 보면 뭐라고 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 035a1fc3-7b12-99ab-138f-6184b32c2f32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_H = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:035a1fc3-7b12-99ab-138f-6184b32c2f32
msgctxt "hc5cec310g4567g465dgb6e8gdb21d8c4f2e4"
msgid "We don't have time. Get to the boat, or we leave!"
msgstr "시간 없어. 지금 안타면, 우린 갈 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 0bcfcd1c-4ff2-14f9-ed45-46c4872ea610
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Local:
#.      - 4951b7ce-8495-b2c8-badc-beaff0e3d807_H = True
