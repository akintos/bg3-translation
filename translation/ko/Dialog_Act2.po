msgctxt "h2154304dgeeaeg43cbg944fga805155f9e3e"
msgid "You were the one who took down Marcus, yeah? Nasty work."
msgstr "네가 마커스를 쓰러뜨린 사람 맞지? 힘들었겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_DockGuard_Melee
#. Speaker = Harper Hangfar
#. NodeID = d4f22a1a-db38-48e0-a8db-7780b3e81322
