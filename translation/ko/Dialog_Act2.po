#.      - 00a82e63-fae8-cc02-0b2b-314c9d21ce6c_H = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_ForceBoatLeave = True
#.   Local:
#.     - 00a82e63-fae8-cc02-0b2b-314c9d21ce6c_A = False
#.     - 00a82e63-fae8-cc02-0b2b-314c9d21ce6c_H = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:fcacf9a7-63cd-9dfe-7e5d-e1e45088e6a5
msgctxt "hedd26091ga48eg421eg994fg304071056717"
msgid "I - I cannot wait."
msgstr "나, 난 기다릴 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Nimble
#. NodeID = 05fd82c3-0e5f-9de0-6271-27c63f50bbea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:05fd82c3-0e5f-9de0-6271-27c63f50bbea
msgctxt "h63b27ce5g3119g458aga68cg0bf0ce0bd328"
msgid "We'll get you to Baldur's Gate, sir - I swear it."
msgstr "저희가 반드시 발더스 게이트까지 모셔다드리겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Nimble
#. NodeID = 072c458f-5cef-eded-c4fb-147715eaaace
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:072c458f-5cef-eded-c4fb-147715eaaace
msgctxt "h508286acg84f7g4976g9833g9751fb0c20f5"
msgid "This could be our chance, sir."
msgstr "지금이 기회입니다, 선생님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Nimble
#. NodeID = 0ca94282-b5d3-48c7-8d13-9e7dc9d4c42f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 74d25b24-618f-3f38-da72-8fbb9f6a8385_B = True
#. SetFlags:
#.   Local:
#.     - 74d25b24-618f-3f38-da72-8fbb9f6a8385_A = False
#.     - 74d25b24-618f-3f38-da72-8fbb9f6a8385_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:0ca94282-b5d3-48c7-8d13-9e7dc9d4c42f
msgctxt "h51166ebdg7e22g446cg81c9g8e2ca5b5d38b"
msgid "We should leave - and soon."
msgstr "가야합니다, 지금요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Wulbren Bongle
#. NodeID = 479899d7-e477-fc7b-ec01-898e2f27ebbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:479899d7-e477-fc7b-ec01-898e2f27ebbf
msgctxt "hfb88daceg8db1g4d6egaddcg83319caa3590"
msgid "I'd bet my last copper there's a pier nearby."
msgstr "저 근처에 부두가 있는다는 것에 내 마지막 동전을 걸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Wulbren Bongle
#. NodeID = 4e13f12c-9d96-2038-3685-8711ee0a8a9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:4e13f12c-9d96-2038-3685-8711ee0a8a9c
msgctxt "h9a2cafcegef76g480fgaffag3da4644a2d9d"
msgid "That is the plan, Nickels."
msgstr "그게 계획이다, 니켈스."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Nickels
#. NodeID = 95399ae7-dbc5-7145-334d-efbf6d5f53fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:95399ae7-dbc5-7145-334d-efbf6d5f53fc
msgctxt "h19e1d5f7gd03dg4e6bgac1dg451f391e5bb7"
msgid "There's something evil here. Below, down, down... argh!"
msgstr "여기 뭔가 사악한 것이 있어. 아래에, 밑에, 밑에... 으악!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Nickels
#. NodeID = abc1e391-a8af-f9d7-f9f9-4d8d48d784ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 74d25b24-618f-3f38-da72-8fbb9f6a8385_A = True
#. SetFlags:
#.   Local:
#.     - 74d25b24-618f-3f38-da72-8fbb9f6a8385_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:abc1e391-a8af-f9d7-f9f9-4d8d48d784ec
msgctxt "hbe1ab129gdb55g4368g94d4ge13dcb802d3e"
msgid ""
"The stone - I feel it. Hollow behind the back wall, and beyond... water?"
msgstr "바위 쪽에 뭔가 있는데. 벽 너머에 공간이 있어요. 그리고... 물이 흐르네?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Wulbren Bongle
#. NodeID = d7605447-6ebe-de02-d238-b651a3bccc96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:d7605447-6ebe-de02-d238-b651a3bccc96
msgctxt "h82a5d8b4gefbeg4225gb4a8g8a8193bd7955"
msgid ""
"Damn straight - without me everything will be for naught. The Ironhand "
"Gnomes <i>must </i>succeed."
msgstr "맞는 말이다, 나 없이는 전부 헛수고가 될 거야. 아이언핸드 노움은 <i>반드시 </i>성공한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Wulbren Bongle
#. NodeID = eb069d0d-d008-3ed8-9bbf-7778f25917c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:eb069d0d-d008-3ed8-9bbf-7778f25917c7
msgctxt "hd3e9bf62g0ae7g4f67g9df8g7182af32bab6"
msgid ""
"Unless this 'evil' can get us out of here, I don't want to hear about it."
msgstr "'악'이 우릴 여기서 나가게 해주지 않는 이상, 난 듣지 않을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Wulbren Bongle
#. NodeID = ef4e7fd0-e702-736f-0a34-963a8a9e6f87
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 74d25b24-618f-3f38-da72-8fbb9f6a8385_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:ef4e7fd0-e702-736f-0a34-963a8a9e6f87
msgctxt "h26812491gaa0bg4bcag9f4bgaf3bc2c9cf5f"
msgid ""
"It's only a matter of time 'til we're served up to the necromancer on a "
"platter."
msgstr "한 끼 식사처럼 대접에 담겨 사령술사에게 바쳐지는 것도 시간문제겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail
#. Speaker = Nimble
#. NodeID = f60bba40-2de6-149d-292f-8f5d13c75cbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GnomesInJail:f60bba40-2de6-149d-292f-8f5d13c75cbf
msgctxt "he59bae3ag7edeg4f33gad59g8ba30ab796bd"
msgid "Breathe - I've got you."
msgstr "숨 쉬어, 내가 잡았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GoToTieflings
#. Speaker = Wulbren Bongle
#. NodeID = 274012df-73ea-4cfc-b4b0-da1731752a85
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_SaveTieflings = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_GoToTieflings:274012df-73ea-4cfc-b4b0-da1731752a85
msgctxt "hf296d57fg0d5bg4e30ga850gbf8f7c1a446b"
msgid ""
"Break the wall and go - if the tieflings can't keep up, it's their problem."
msgstr "벽을 부수고 가자, 티플링들이 따라오지 못하는 건, 우리가 신경쓸 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Cal
#. NodeID = 0acd00da-3b04-491c-9b91-5b32161bcf40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:0acd00da-3b04-491c-9b91-5b32161bcf40
msgctxt "h045af47eg0afdg4950g939eg0ac466f3348f"
msgid "I know. And I'll be right alongside you if it comes to that."
msgstr "알아. 그리고 그런 일이 생긴다면 난 네 바로 옆에 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Cal
#. NodeID = 3dc4a6ae-3bae-4be3-8903-62c185a3d2f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:3dc4a6ae-3bae-4be3-8903-62c185a3d2f2
msgctxt "h3d386044gb8e3g4a83g8f4eg2561e84f0d3f"
msgid "Fair point."
msgstr "좋은 지적이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Lia
#. NodeID = 4f81fc1b-419a-44f2-b9f2-e9b2d46a4883
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Prodigy_State_ToldSiblingsProdigyDead = False
#.   Local:
#.      - 3174fc37-851b-0494-321e-b606f7e43901_A = True
#. SetFlags:
#.   Local:
#.     - 3174fc37-851b-0494-321e-b606f7e43901_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:4f81fc1b-419a-44f2-b9f2-e9b2d46a4883
msgctxt "hf32fdfb0gda62g47e4gb9ccg7f6a7589e21f"
msgid "Rolan better be all right."
msgstr "롤란이 괜찮아야 할텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Cal
#. NodeID = 857b1619-5381-d22a-5da9-a13dac20154d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:857b1619-5381-d22a-5da9-a13dac20154d
msgctxt "h4f7ab9a3g8239g40c2gb47ag9f8ba220e632"
msgid "You're right. Let's... let's talk about something else."
msgstr "네 말이 맞아. 그럼... 이제 다른 얘기 하는 게 어때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Lia
#. NodeID = 93e478b1-9a4d-4385-a8f1-b34d932ca09b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:93e478b1-9a4d-4385-a8f1-b34d932ca09b
msgctxt "ha03a8cb5g2f74g4ec8g9cf3gec25fd7d67b3"
msgid "Have you?"
msgstr "넌 잤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Cal
#. NodeID = a2578fe1-9a2b-5c64-61c5-9fbdeb27584a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Prodigy_State_ToldSiblingsProdigyDead = True
#.   Local:
#.      - 3174fc37-851b-0494-321e-b606f7e43901_A = True
#. SetFlags:
#.   Local:
#.     - 3174fc37-851b-0494-321e-b606f7e43901_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:a2578fe1-9a2b-5c64-61c5-9fbdeb27584a
msgctxt "h482cb3b2g87fcg4884ga29ageb69f27bdb30"
msgid "I can't believe Rolan is gone. Gods, just saying it out loud..."
msgstr "롤란이 죽었다니 믿을 수 없어. 신이시여, 입밖으로 꺼내는 것 만으로도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Cal
#. NodeID = ac15eda1-80aa-45d8-9489-c2f4a007ab20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3174fc37-851b-0494-321e-b606f7e43901_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:ac15eda1-80aa-45d8-9489-c2f4a007ab20
msgctxt "h6148d8efg72bcg43a4ga0d5g72e070f63144"
msgid "Have you slept at all?"
msgstr "좀 잤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Lia
#. NodeID = bc69af11-25c3-4b57-91c0-6050405d32e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:bc69af11-25c3-4b57-91c0-6050405d32e6
msgctxt "hee4704e4g419bg48d2ga24egb49d2c588e10"
msgid "We won't let them win. Not now, not ever."
msgstr "그놈들이 이기게 두지 않겠어. 지금도, 앞으로도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Lia
#. NodeID = cc4d75d1-2cd6-4831-9179-804cb24a58e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:cc4d75d1-2cd6-4831-9179-804cb24a58e8
msgctxt "h044ea924ga9f0g45b1g8305gd69b5606f454"
msgid "I bloody hope not. If he saves us, I'll never hear the end of it."
msgstr "그러지는 않았으면 좋겠는데. 만약 롤란이 우릴 구해주면, 죽을 때까지 그 이야길 들어야 할 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Lia
#. NodeID = cdaf30b9-4858-4e1e-8079-c1e18d2d36c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3174fc37-851b-0494-321e-b606f7e43901_B = True
#. SetFlags:
#.   Local:
#.     - 3174fc37-851b-0494-321e-b606f7e43901_A = False
#.     - 3174fc37-851b-0494-321e-b606f7e43901_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:cdaf30b9-4858-4e1e-8079-c1e18d2d36c4
msgctxt "he3f65ef8ge758g4251g8fa5g7b8d241b8c60"
msgid ""
"I'll get us out of here, Cal - even if I need to kill every bastard in this "
"hellspit."
msgstr "칼, 난 모두를 여기서 구해낼 거야, 이 지옥구덩이에 있는 모든 개자식들을 다 죽여버려야 한다고 해도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Cal
#. NodeID = e44db6cf-6645-401c-a2f6-d540a2ea8181
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:e44db6cf-6645-401c-a2f6-d540a2ea8181
msgctxt "he8766bb3g8e20g45f8g9f8dg514326fb153e"
msgid ""
"It's Rolan - he's probably holed up somewhere planning to burst in, spells "
"ablaze, and rescue us."
msgstr "롤란이잖아, 아마 어디 숨어있다가 불쑥 나타나 주문으로 우릴 구해줄 계획을 짜고 있을 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Lia
#. NodeID = fd5c6afb-0969-60d8-8469-1971121e9f9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:fd5c6afb-0969-60d8-8469-1971121e9f9e
msgctxt "ha86191f6g457bg4513g8b3egdbc707241b69"
msgid "We'll give Rolan the send off he deserves - when we're both safe."
msgstr "우리 둘다 안전해지면, 롤란에게 작별인사를 해줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail
#. Speaker = Lia
#. NodeID = fed96c0b-67da-c567-c83b-f07007acd9a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigiesInJail:fed96c0b-67da-c567-c83b-f07007acd9a7
msgctxt "h436b7851gd53dg4c13ga5a8g0b59cfb0aa05"
msgid "Let's focus on escaping, all right?"
msgstr "지금은 탈출하는데 집중하자구, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother
#. Speaker = Cal
#. NodeID = 032ef225-3907-42e4-9381-480b14e1914f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_ProdigyLament_Event_ToldDeadSiblings = True
#.   Local:
#.      - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_E = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_F = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother:032ef225-3907-42e4-9381-480b14e1914f
msgctxt "hc56571ceg4841g443eg9e9fga53a71803570"
msgid "I can't stand this place. What's the hold up?"
msgstr "더 이상 여기 있기 싫어. 뭘 꾸물거리는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother
#. Speaker = Cal
#. NodeID = 09c79ad9-4cef-a2a7-5be2-21ec4ffe880e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_PlayersCanUseBoat = True
#.   Local:
#.      - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_B = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_BoatReady = True
#.   Local:
#.     - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_B = False
#.     - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_A = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother:09c79ad9-4cef-a2a7-5be2-21ec4ffe880e
msgctxt "h72577df1gda54g481dg9b51g707cf9257eff"
msgid "Boat's free - let's go!"
msgstr "배를 풀었어, 가자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother
#. Speaker = Cal
#. NodeID = 0b2cc075-d721-097c-4a78-37c499fa46d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Local:
#.     - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_H = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother:0b2cc075-d721-097c-4a78-37c499fa46d0
msgctxt "ha572aa5agc662g4a45ga378g9de3b27ada6f"
msgid "Get to the boat, or we leave without you!"
msgstr "얼른 타, 아니면 두고 갈 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother
#. Speaker = Cal
#. NodeID = 2d6cb2ea-8299-4727-07f6-ba8a0c950b11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_E = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_F = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother:2d6cb2ea-8299-4727-07f6-ba8a0c950b11
msgctxt "h2b1df6e4g8625g449cgad85g2cfaa8327b25"
msgid "I hope Rolan is all right... Please, let's just get out of here."
msgstr "롤란이 무사했으면 좋겠어... 제발, 그냥 여기서 나가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother
#. Speaker = Cal
#. NodeID = 2e512db9-d9d5-11fb-ee95-70b7b1441775
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_B = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_ForceBoatLeave = True
#.   Local:
#.     - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_B = False
#.     - 8f847adf-7b8a-3551-cfc0-4ea0c66a999a_A = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother:2e512db9-d9d5-11fb-ee95-70b7b1441775
msgctxt "h1e0a16d9g4c75g49dega170g177a954c4021"
msgid "Go, GO, GO!"
msgstr "가, 어서, 빨리!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigyBrother
#. Speaker = Cal
#. NodeID = 3dcf01ba-ef39-4085-8498-c39a72995aa4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADLeaving(0) = True
#. SetFlags:
