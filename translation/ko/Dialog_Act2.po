#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "haaeb7c99g0398g4e77gb024g7e00e4235374"
msgid ""
"Gods, I need to rest. Maybe the world will feel less insane in the morning."
msgstr "진짜 좀 쉬어야겠어. 아침에 일어나면 세상이 좀 덜 잔인하게 느껴질지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "had1c958egeb8eg43d1gb0dcg8a6c8d517e3e"
msgid "We should rest, mind and muscle both."
msgstr "몸과 마음 모두 휴식을 취해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "hb78b2526g8db8g4fe3g8726gf6d988461785"
msgid ""
"I feel my bedroll calling. Time for some well earned sleep. Dreamless, "
"preferably."
msgstr "침낭이 날 부르고 있는 것만 같아. 단잠을 잘 시간이로군, 되도록이면 꿈도 없이 자고 싶네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "h4ea515bfgf9a7g480bg8b78g35a719207b1e"
msgid "Some rest is in order. And dreamless rest, hopefully."
msgstr "휴식이 필요해. 가능하다면 꿈도 없이 푹 자고 싶네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "h0bb1bd58g4f8bg467fgbea1gf38e0a13538c"
msgid "I'm knackered. Tomorrow, we plan. Tonight, we rest."
msgstr "너무 피곤하군. 계획은 내일 짜고 오늘 밤은 쉬자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "h120dff5dg0d11g4973ga444g018ce13505ef"
msgid "I'm bushed. Let's get some sleep."
msgstr "나 완전 피곤해. 좀 자자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "hc7eeede5gae65g408dgb7bag1a2da060f351"
msgid ""
"To bed. Should anyone else wish to kill us in our sleep, I might as well die "
"comfortable."
msgstr "누가 자고 있을 때 우릴 죽이려고 한다면 그냥 편하게 죽는 게 낫겠군. 자러 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "h3c9217aag29b8g40c8gbe5ag51049adfd917"
msgid "That was ample excitement for one evening. We should rest."
msgstr "하룻밤 치고는 너무 많은 일이 있었군. 이제 쉬어야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest
#. Speaker = Player
#. NodeID = 0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_LetsJustRest:0ad13c33-8b45-40d0-ba1d-9c2a9899a5fb
msgctxt "hfbd0226ag1793g4cfdg8183g29f3decccd92"
msgid "An eventful night. Time to get some rest, I think."
msgstr "정신 없는 밤이었어. 이제 좀 쉬어야 할 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NonTadpoledReactToVoA
#. Speaker = Player
#. NodeID = c54e988d-4cc3-410b-a088-db7ab3f70e96
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NonTadpoledReactToVoA:c54e988d-4cc3-410b-a088-db7ab3f70e96
msgctxt "h3e86a295geac9g41f3g8e9egd9d425413741"
msgid "What's happening to you?"
msgstr "무슨 일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NonTadpoledReactToVoA
#. Speaker = Player
#. NodeID = c54e988d-4cc3-410b-a088-db7ab3f70e96
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NonTadpoledReactToVoA:c54e988d-4cc3-410b-a088-db7ab3f70e96
msgctxt "h2a70d6cag3a25g4f50g9b55gad642c076fb9"
msgid "What's happening - are you hurt?"
msgstr "무슨 일이지? 다친 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "h4814b50egd67ag42d8g8c0dga1bfed1ea3c2"
msgid "Those figures were just githyanki? I was so sure I saw demons."
msgstr "그 것들이 그냥 기스양키였다고? 분명 데몬일 거라 생각 했는데 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "h4e8c4e79gf3c4g4619g9befgad91e7a8e0cd"
msgid "What we saw weren't demons - they were <i>githyanki.</i>"
msgstr "우리가 본 것들은 데몬들이 아니라 <i>기스양키</i>였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "h022669b9g937eg4641g8452ged345c812b8e"
msgid "Those demonic figures we saw were githyanki, then. Barely recognisable."
msgstr "간신히 알아 볼 수 있었지만, 우리가 본 것들은 데몬이 아니라 기스양키였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "he58304c9gb999g40d3ga065gef909e969f5e"
msgid "Not demons after all. Just githyanki."
msgstr "결국 데몬이 아니라 기스양키들이었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "hd9a69407g8c79g4f33gabdagf04ea7225bcd"
msgid "I thought they were demons of some sort - not <i>githyanki</i>."
msgstr "일종의 데몬이라고 생각 했는데, <i>기스양키</i>였을 줄이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "h0b77f7f4gce75g44bcga45bg28bd991774d3"
msgid "No demons, thank the gods. Just gith."
msgstr "데몬이 아니라 그냥 기스였어. 진짜 다행이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "hd0b3c16dg6753g4d1dga34bgbedd039add22"
msgid "Then it was not demons you saw - but githyanki warriors."
msgstr "그럼 자네가 본 것들은 데몬이 아니라 기스양키 전사들이었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "h7a72062fgcba5g41ffga715gb8a1b7679eb2"
msgid "Not demons then, but githyanki."
msgstr "그렇다면 그게 데몬이 아니라 기스양키였군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith
#. Speaker = Player
#. NodeID = 9ada488b-1611-4448-a055-83aeacd7eab7
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_NotDemonsButGith:9ada488b-1611-4448-a055-83aeacd7eab7
msgctxt "hb2d7f82egb0a1g4780g8823g7d5e5a8a45f0"
msgid "So the demonic figures we saw were <i>githyanki</i> all along?"
msgstr "우리가 본 데몬 같았던 형체는 그냥 처음부터 기스양키였다는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "hfd8b0432g94e8g42dbg86c0g7c85dfd9c33f"
msgid "Those rocks look ancient - they won't be cracked open by force."
msgstr "굉장히 오래되어 보이는 바위 같은데, 힘으로 깨지지는 않을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "h2c585cc4g3ebcg4a65g96b2gee7d1eeb5eb1"
msgid ""
"I don't recognise these rocks. They are too strong to break by force alone."
msgstr "이 바위가 뭔지 모르겠군. 힘만으로 부수기에는 너무 단단해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "h1b1d024fg668eg402cgae14g0c17774cad84"
msgid ""
"Bound with the bedrock of the Astral Plane itself. No ordinary magic will "
"sever such ties."
msgstr "아스트랄 차원의 기반 자체에 결속되어 있어. 평범한 마법으로는 이 결속을 끊을 수 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "h31a87443gf072g4297gbe3dg757ab8f4dd27"
msgid ""
"Whatever those rocks are, I doubt any tool or weapon of ours will break them."
msgstr "이 바위들이 뭐든 간에 우리가 가진 도구나 무기로는 부술 수 없을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "h0eb97abeg8b86g44edga709gc45757eb6392"
msgid "It would take one special hammer to shatter these rocks."
msgstr "이 바위들을 부수려면 특별한 망치가 필요하겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "ha1a60381g4620g4f8dg8a2eg90b5aacaf50a"
msgid "Whatever these rocks are, I can't smash 'em myself."
msgstr "요 바위들이 뭐든 간에 내가 깨지는 못할걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "h6c22d585g3275g40b4g83a0g1351e401697c"
msgid "No mundane stone - and no mundane means to break it, I'd wager."
msgstr "이건 평범한 돌이 아니야, 분명 부수는 방법도 평범하게는 안 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "he2c7c13agfd5eg463ega4c7gbaba64c5669e"
msgid "These rocks are not natural. They will not yield to any strike."
msgstr "이 바위는 자연적이지 않네. 어떤 타격에도 꿈쩍 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks
#. Speaker = Player
#. NodeID = 7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_PAD_ReactingToOrpheusRocks:7dc1e0c8-e1c8-4f00-b7b2-784e95f90f8e
msgctxt "h9ca89026gfceeg4861g98ecgfc145a54a700"
msgid "These rocks look ancient. Not sure I could break them if I tried."
msgstr "굉장히 오래되어 보이는 바위야, 부수려 해봐도 가능할지는 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_VB_CantSleep
#. Speaker = Player
#. NodeID = c48cbbbe-4623-42da-b658-3674d4d453b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_VB_CantSleep:c48cbbbe-4623-42da-b658-3674d4d453b0
msgctxt "h26a82f53g6af5g4113ga432gff45a05b0540"
msgid "This would be the worst time to take a nap."
msgstr "지금이 한숨 자기에는 가장 나쁜 상황이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 014d8bb5-4697-8530-2591-ac9b85c11ac1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#.      - GEN_IsSpeakerPresent_4 = False
#.      - GEN_IsSpeakerPresent_3 = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:014d8bb5-4697-8530-2591-ac9b85c11ac1
msgctxt "h772aeb9eg8de7g4d11gbff7g8ef1f5f5ef0e"
msgid ""
"I will heed my companions' needs - I would not have made it this far without "
"them."
msgstr "동료들이 필요로 하는 것에 귀 기울이겠어. 동료들이 없었다면 여기까지 오지도 못했을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 0459ae1f-2769-c45f-d46c-b3ed617e035b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:0459ae1f-2769-c45f-d46c-b3ed617e035b
msgctxt "hb86969b8g6ef0g479bga7cdg40d52758e52a"
msgid ""
"I will reap a savage fate on this world unlike any that has ever been seen."
msgstr "누구도 여지껏 보지 못했던 야만적인 운명을 이 세상에 가져다 주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Disembodied Voice
#. NodeID = 0550eacd-81bb-8ffb-392d-255d2e749677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:0550eacd-81bb-8ffb-392d-255d2e749677
msgctxt "hcd1ba9c4g707dg465bg8abagd51db6cf5705"
msgid "<b><i>March. Join my power. </i></b>"
msgstr "<b><i>진군해라. 내 군세에 합류해라. </i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 17c09356-23e9-64d7-587e-cc82a209e474
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_WYLL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:17c09356-23e9-64d7-587e-cc82a209e474
msgctxt "hd5e851ceg2b6cg4f69gaae5g1b13aefe11d0"
msgid "First, I will save my father. Nothing else matters right now."
msgstr "아버지부터 구하겠다. 당장 그 외에는 무엇도 중요하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 18015341-79fd-e958-c4a2-3e7fb5851ecc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:18015341-79fd-e958-c4a2-3e7fb5851ecc
msgctxt "he4693357gb94eg48c2ga1ffgbfed56f5b85a"
msgid ""
"*And what then? You are prone to impulses as uncontrollable as the gods "
"themselves. Will you even have a say in what you do?*"
msgstr ""
"*그리고 그 다음은요? 당신은 신들 자신처럼 통제불능의 충동에 휩싸이기 쉽습니다. 당신이 하는 일에 스스로의 의지 자체가 있나요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 1e64ad50-f0b2-52bd-3f4a-8a39604c936c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:1e64ad50-f0b2-52bd-3f4a-8a39604c936c
msgctxt "h56848479g2047g4cbeg89f4g8059cbfaaf6a"
msgid "When the moment comes, I'll do what feels right."
msgstr "결단의 순간이 오면, 옳다고 느껴지는 행동을 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 20dc942f-c112-3260-72da-d4463ddb21cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:20dc942f-c112-3260-72da-d4463ddb21cf
msgctxt "h0c4da427ge962g43afg9c1fg111000e939a7"
msgid ""
"*Lady Shar sent you on this mission - did she know that this is where it "
"would lead?*"
msgstr "*당신을 임무에 보낸 샤 여신께서는 이렇게 될 것을 알고 계셨을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 245dd488-f7fd-d5b6-f75a-844b304539fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_GALE(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:245dd488-f7fd-d5b6-f75a-844b304539fd
msgctxt "haa26a183gc4c4g423fg9502g39fb577cc608"
msgid ""
"*That you remain alive is a failure to Mystra. But if you were to lay hands "
"on that Crown... might she have reason to forgive you then? Would you even "
"need her forgiveness?*"
msgstr ""
"*당신이 살아 있다는 건 미스트라에게는 실패라는 의미입니다. 하지만 왕관을 손에 쥘 수만 있다면... 미스트라가 당신을 용서할 이유가 "
"있을까요? 아니 용서가 필요하기는 할까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 2bb3966c-6d0c-3dbe-5da4-0e0f2dda4923
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:2bb3966c-6d0c-3dbe-5da4-0e0f2dda4923
msgctxt "hf2bcdb45g9af3g4192ga35fg1c4dc88c8709"
msgid ""
"I will free everyone of this evil - I will be the one to cleanse this plane "
"of the Absolute."
msgstr "이 악으로부터 모두를 해방하고 절대자의 차원을 정화한 자가 되겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 2bb3966c-6d0c-3dbe-5da4-0e0f2dda4923
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:2bb3966c-6d0c-3dbe-5da4-0e0f2dda4923
msgctxt "h954c3b7fgb7c2g4825g9d9agfb8b9cd0bdef"
msgid ""
"I will free everyone of this evil - I will be the hero that saves Baldur's "
"Gate."
msgstr "이 악으로부터 모두를 해방시키고 발더스 게이트를 구한 영웅이 될 테야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 2f99d48c-30da-565a-80c5-9af188937d0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_MetVossInAct2 = True
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_LAEZEL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:2f99d48c-30da-565a-80c5-9af188937d0f
msgctxt "h5b0ed60cgcfe4g43degbbc2gf3e03dc15ba5"
msgid "*The very same visitor who Vlaakith seems so eager to kill.*"
msgstr "*블라키스가 그렇게나 죽이고 싶어했던 그 방문자 말입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 419e8598-c90f-d877-d0f8-82b3f386875c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = True
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_LAEZEL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:419e8598-c90f-d877-d0f8-82b3f386875c
msgctxt "hf2a36217g231bg4ba7gb86cgf4bc03a89cc6"
msgid ""
"*The very same visitor who Vlaakith seems so eager to kill - and Voss seems "
"so eager to free.*"
msgstr "*블라키스가 그렇게 죽이고 싶어 했고 보스가 그렇게 풀어주고 싶어했던 그 방문자 말입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Disembodied Voice
#. NodeID = 41b23bb0-d811-3437-edfa-12c0d788bee9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:41b23bb0-d811-3437-edfa-12c0d788bee9
msgctxt "h38ca7fc6gf8ddg4f0dg994fg839d42e0028b"
msgid "<b><i>Hear me. Gather. The reckoning is upon us. </i></b>"
msgstr "<b><i>듣거라. 모이거라. 심판이 다가오고 있으니. </i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 426cbeec-77f6-c98d-d145-6b4de5bf9303
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:426cbeec-77f6-c98d-d145-6b4de5bf9303
msgctxt "h20067e80g4449g46e2gb9ebg2158c4d52720"
msgid ""
"*Even as you utter the words to yourself, you know it is but an intention. "
"And these dark desires of yours have little regard for your intentions.*"
msgstr ""
"*혼자 그 말을 되뇌어 봐도 그건 단지 당신의 의사에 지나지 않는다는 걸 알고 있습니다. 이 어두운 욕망은 당신의 의사에는 별 관심이 "
"없죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 42cf47e2-5f5a-dd2f-7052-1b578b8a28dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_ASTARION(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:42cf47e2-5f5a-dd2f-7052-1b578b8a28dd
msgctxt "habc1d8bfgd196g4913gb7a9gc025d456cfa7"
msgid ""
"*You know servitude better than anyone - you have been denied freedom for "
"nearly two centuries, and are denied it still.*"
msgstr "*2세기 가까이 자유를 얻지 못했고 지금도 마찬가지인 당신은 노예가 된다는 게 어떤 것인지를 누구보다도 잘 알고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 4eb0bf4a-5d4c-c684-2e9d-ccdd3a9f82f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:4eb0bf4a-5d4c-c684-2e9d-ccdd3a9f82f6
msgctxt "h75c26ad5g75feg4d79gb25bg96447e7dab48"
msgid ""
"*Together, you have the power to thwart the Dead Three. If you follow this "
"path to its end, the elder brain will not answer to the Chosen. It will "
"answer to you.*"
msgstr ""
"*방문자와 함께라면 당신에게는 삼악신을 좌절시킬 힘이 있습니다. 이대로 계속 나아간다면 엘더 브레인은 선택받은 자들이 아니라 당신의 "
"명령에 답하게 될 것이고요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 558644e4-0735-caa1-1f83-37a41fc592e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_MizorasPact_State_WyllReleasedFromPact = False
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:558644e4-0735-caa1-1f83-37a41fc592e5
msgctxt "hf43689afg7e0ag455cg8654ge53720f34a74"
msgid "*You who are a plaything for a cambion.*"
msgstr "*캠비온의 놀잇감인 당신이요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 6058491b-7d96-91cf-4cea-45f87a1e0cb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:6058491b-7d96-91cf-4cea-45f87a1e0cb8
msgctxt "h50a8a8ffgc1e4g49f2g81b3g42817f05e16a"
msgid ""
"*This would have been your fate too, were it not for the dream visitor's "
"protection.*"
msgstr "*꿈의 방문자의 보호가 없었다면, 당신도 그렇게 될 운명이었겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 652d0449-b6de-aae7-b2a4-76f90f3564f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:652d0449-b6de-aae7-b2a4-76f90f3564f5
msgctxt "h11c36896gd681g4b57ga0a5gd93288ddc0df"
msgid ""
"*Will you liberate the True Souls from their parasites and their religious "
"delusions? Or will you use the power you gain for your own purposes?*"
msgstr "*기생충과 종교적 망상으로부터 참된 영혼들을 해방할 건가요? 아니면 스스로의 목적을 위해 새로 얻은 힘을 활용할 건가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 65b895db-10e4-25c2-0dbb-e8775889e8ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_AstralPrison_State_SpokeWithDaisy = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:65b895db-10e4-25c2-0dbb-e8775889e8ed
msgctxt "hf93a72e2gc04fg4dbfgba28g7b2178ab2ba3"
msgid ""
"*This would have been your fate too, were it not for the Astral Prism and "
"the mysterious visitor inside of it.*"
msgstr "*아스트랄 프리즘과 그 안에 있는 수수께끼의 방문자가 아니었다면 당신도 그렇게 될 운명이었겠죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 69dc93ef-13f7-9aee-4193-8b46c57edc9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_ASTARION(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:69dc93ef-13f7-9aee-4193-8b46c57edc9d
msgctxt "h137e20c3gb930g48b6gaa6ag2273b9f33b1f"
msgid "I will have my vengeance. Cazador will be dust."
msgstr "복수를 쟁취하고 말겠다. 카사도어는 먼지가 되리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 72d4b35f-7ef6-1339-53da-13cb92752f77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_WYLL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:72d4b35f-7ef6-1339-53da-13cb92752f77
msgctxt "h8b6d176fg0545g4bb2g9d9ag8e7fdac7781d"
msgid ""
"*If the dream visitor speaks true, then the entire Sword Coast is under "
"threat. It will take a true hero to save it. But is that really you?*"
msgstr ""
"*꿈의 방문자의 말이 사실이라면, 소드 코스트 전역이 위험에 빠진 것입니다. 소드 코스트를 구할 진정한 영웅이 필요하지만 그것이 진짜 "
"당신인가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 7a2ba18a-5690-255b-7041-0cb3417bf589
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:7a2ba18a-5690-255b-7041-0cb3417bf589
msgctxt "h244c08a5gbcb2g4fe9gbbb3g2517409cc74f"
msgid ""
"*The events of the last days weigh heavily upon you. Sleep's rest is slow to "
"come to one whose mind is so full.*"
msgstr "*지난 날의 일들이 당신을 무겁게 짓누릅니다. 생각할 거리가 많은 이들에게는 잠의 안식이 쉬이 찾아오지 않는 법이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 7a903ef0-f15b-5d7a-7f8a-d38eb2f42900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:7a903ef0-f15b-5d7a-7f8a-d38eb2f42900
msgctxt "hc7df35c9g8711g4d45gb9f2g2c663775afe9"
msgid "*A thrill courses through you at the thought.*"
msgstr "*그 생각을 하자 전율감이 몸을 타고 흐릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 7c91e2de-6038-004c-ad89-220898c500fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_SHADOWHEART(0) = True
#. TagRule: SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:7c91e2de-6038-004c-ad89-220898c500fb
msgctxt "h4bb56ebbg6325g4ed2g847cg7e0a2f2428e4"
msgid ""
"I will confront the Mother Superior and her Sharran lackeys. Then I will "
"free my parents."
msgstr "수도원장과 샤의 종들과 대면할 테야. 그리고 부모님을 풀어주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 7c91e2de-6038-004c-ad89-220898c500fb
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:7c91e2de-6038-004c-ad89-220898c500fb
msgctxt "h02e95ad9ge16fg477cg9938gd19882a38819"
msgid ""
"I will continue in Lady Shar's service. She will never know a more loyal "
"follower. Nor a stronger one."
msgstr "샤 여신을 계속해서 섬기겠어. 그 분께서는 나보다 더 충성스럽고 강한 신도를 보지 못하시겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 87fdc827-0726-8618-39bf-049e0c22fafa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:87fdc827-0726-8618-39bf-049e0c22fafa
msgctxt "h40e2e8fagb1c6g4ee4g8542g4538a4f497f8"
msgid ""
"*All who carry the tadpole are governed by the brain, and by extension, the "
"Chosen. It will take but one order to transform them into an army of mind "
"flayers.*"
msgstr ""
"*뇌에 올챙이를 지니고 있는 모든 이들은 엘더 브레인에 의해 지배 당합니다. 나아가서는 선택받은 자들에게도요. 단 한번의 명령으로 그 "
"자들은 마인드 플레이어의 군대로 변하게 될겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 8d120fbb-4e34-a315-18ca-c886c755857c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:8d120fbb-4e34-a315-18ca-c886c755857c
msgctxt "h0712549bg1041g4c59ga977gba551201385f"
msgid ""
"*With her help, you have uncovered the cult for what it really is - a plan "
"of conquest orchestrated by the gods of death themselves.*"
msgstr ""
"*그녀의 도움으로 당신은 절대자 교단의 실체가 무엇인지도 알아낼 수 있었습니다. 바로 삼악신이 직접 입안한 정복 계획이라는걸요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 8d120fbb-4e34-a315-18ca-c886c755857c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_MALE
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:8d120fbb-4e34-a315-18ca-c886c755857c
msgctxt "h57f1292fg7a79g484fgba43gf251c090218e"
msgid ""
"*With his help, you have uncovered the cult for what it really is - a plan "
"of conquest orchestrated by the gods of death themselves.*"
msgstr "*그의 도움으로 당신은 절대자 교단의 실체가 무엇인지도 알아낼 수 있었습니다. 바로 삼악신이 직접 입안한 정복 계획이라는걸요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 8d120fbb-4e34-a315-18ca-c886c755857c
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:8d120fbb-4e34-a315-18ca-c886c755857c
msgctxt "h377b0420g4877g4d25g8d7ag2a76351cfa9e"
msgid ""
"*With their help, you have uncovered the cult for what it really is - a plan "
"of conquest orchestrated by the gods of death themselves.*"
msgstr ""
"*그들의 도움으로 당신은 절대자 교단의 실체가 무엇인지도 알아낼 수 있었습니다. 바로 삼악신이 직접 입안한 정복 계획이라는걸요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 8d86552c-7962-c952-3aee-91a59744fa12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:8d86552c-7962-c952-3aee-91a59744fa12
msgctxt "h2edcd626g2195g4e0aga417ga19642b24c71"
msgid ""
"*Right now, your resolve feels firm. But there is no knowing how you will "
"feel when the moment comes.*"
msgstr "*지금으로서는 그 결심이 확고해 보입니다. 하지만 그 순간이 왔을 때 당신이 어떤 생각을 하게 될지는 알 수 없는 일이죠.* "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = 8eb52d12-e15f-e391-81c7-64c817e8cb61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:8eb52d12-e15f-e391-81c7-64c817e8cb61
msgctxt "h50f42b10g6bb2g4d50gb089ge496ab99802a"
msgid "*And what role will you play?*"
msgstr "*그리고 당신의 역할이란 무엇일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 8ee12478-c349-e834-6326-4ba6f4c5c43a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_GALE(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:8ee12478-c349-e834-6326-4ba6f4c5c43a
msgctxt "h7e8140eegd595g4b53ga6e6g938bd9988030"
msgid ""
"I've witnessed the Heart of the Absolute. I'm going the learn the secrets of "
"that crown..."
msgstr "절대자의 본질이 무엇인지 보았지. 왕관의 비밀을 알아내고 말겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 90d0a619-39e7-8f6e-2dad-251e7fa1cd04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_MetVossInAct2 = True
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_LAEZEL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:90d0a619-39e7-8f6e-2dad-251e7fa1cd04
msgctxt "had2b2132gf7c8g4a3ag81a2g4647f4eb6ad7"
msgid ""
"I will do as Voss asked. I will protect the Astral Prism and free the one "
"inside."
msgstr "보스가 말한 대로 하리라. 아스트랄 프리즘을 보호하고 그 안에 있는 자를 해방시키겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = 933981b6-b322-b26e-3e9d-11db28f9a91c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:933981b6-b322-b26e-3e9d-11db28f9a91c
msgctxt "h53a93eb3g27fdg46c8g826bg0beb0aa7c251"
msgid ""
"All I want is to be free of this parasite. I will do what is necessary to "
"make that happen."
msgstr "내가 바라는 건 그저 이 기생충으로부터 자유로워지는 거야. 그걸 이루기 위해서라면 뭐든지 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = a643bb90-05a4-22c9-bf37-9736083717f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#.      - AVATAR(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:a643bb90-05a4-22c9-bf37-9736083717f1
msgctxt "hbf17d368g55f9g48a8g87d4g288bfde7110f"
msgid "First, Gortash. Then, the rest of my life."
msgstr "먼저 고타쉬를 처리하고, 그 다음은 나머지 인생을 챙겨야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = a76ea019-2e7f-8fb7-0914-68c3f267f1ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:a76ea019-2e7f-8fb7-0914-68c3f267f1ab
msgctxt "h2f9991cdg9652g4fe9g80f5g8c85e6e9dcf0"
msgid "*Your blood swims hot at the very prospect.*"
msgstr "*그 전망에 당신의 피가 뜨겁게 흐릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = aa5e6741-47f7-c67d-eff5-ee5364cfcf04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:aa5e6741-47f7-c67d-eff5-ee5364cfcf04
msgctxt "h15e0b0fcg48e9g4044gbacbgd2c152931a0e"
msgid "I will find a way to rid myself of these disturbing impulses."
msgstr "이 불안정한 충동에서 벗어날 방법을 알아내고 말거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = af017073-c502-800f-a5d7-4ceb80b118c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:af017073-c502-800f-a5d7-4ceb80b118c4
msgctxt "hc56c2535g6c7fg47d5g9d99g9836e363abc5"
msgid ""
"*You are hungry beyond blood, beyond lust, beyond your unliving life itself.*"
msgstr "*흡혈과 욕정을 넘어, 살아 있는 것조차 아닌 삶을 넘어 당신은 무언가에 굶주려 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = af099a0c-509b-97a8-59b5-45370e728536
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:af099a0c-509b-97a8-59b5-45370e728536
msgctxt "h6a8013c2g09ceg4fabga2d9g251f1db5be7b"
msgid "*And when you complete it, what will you do then?*"
msgstr "*그리고 임무를 완수하고 나면, 그 다음에는 어떻게 할 건가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = af312379-4891-980c-2441-cd81a1003ecc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:af312379-4891-980c-2441-cd81a1003ecc
msgctxt "h6955d7ddgeb85g47dcgb183g148ef681f34b"
msgid ""
"*The Absolute is not a god, but an elder brain controlled by the Chosen of "
"the Dead Three. They mean to use it to take control of the Sword Coast.*"
msgstr ""
"*절대자는 신이 아니었습니다. 삼악신의 선택 받은 자들이 소드 코스트를 지배하기 위한 수단으로 통제하는 엘더 브레인이었던겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = afbb7a7b-e0a3-ea6e-c6d3-30e8511ae4d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_LAEZEL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:afbb7a7b-e0a3-ea6e-c6d3-30e8511ae4d5
msgctxt "ha5a73bb4g6b0bg44c6g889fg8c5bb5f42640"
msgid ""
"*A heavy burden indeed. After all, the artefact that protects you came from "
"your own people. What role have they to play in this plane's existence?*"
msgstr ""
"*참으로 무거운 짐입니다. 당신을 지키는 이 아티팩트는 결국 당신 동족으로부터 온 것이니까요. 이 차원의 존재에서 그들이 수행해야 할 "
"역할이란 무엇일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = ba41c883-b77d-f2df-9375-278e2a188311
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:ba41c883-b77d-f2df-9375-278e2a188311
msgctxt "h5819bc99gbcb6g4eddgad0ag99261e4dbbfe"
msgid "*You will not have long to wait. All you need to do now is sleep...*"
msgstr "*그리 오래 기다리지 않아도 될 겁니다. 지금은 잠이 먼저입니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = c73ce286-ff92-be22-ce65-cfff9228b451
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:c73ce286-ff92-be22-ce65-cfff9228b451
msgctxt "hf27dcd4cg0fdeg41d8g9320ga0c857277915"
msgid ""
"*And what of the True Souls? Will you liberate them from their parasites and "
"religious delusions? Or will you use the power for your own gain?*"
msgstr ""
"*그리고 남아있는 참된 영혼들은요? 그들을 기생충, 종교적 망상으로 부터 해방시켜 줄 건가요? 아니면 그들의 힘을 당신 뜻 대로 휘두를 "
"건가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = c7dae8c7-cda4-910f-7ea9-82ee9dd06788
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:c7dae8c7-cda4-910f-7ea9-82ee9dd06788
msgctxt "hfb2cd9b4gf5c9g4306ga43fg76468f44170c"
msgid ""
"*Will you liberate them from their parasites and their religious delusions? "
"Or will you use the power you gain for your own purposes?*"
msgstr "*그들을 기생충과 종교적 망상으로 부터 해방시키고 풀어 줄 건가요? 아니면 그들의 힘을 당신을 위해 사용 할 건가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = d07e91d4-e209-6199-1124-62a7197f50e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:d07e91d4-e209-6199-1124-62a7197f50e4
msgctxt "h23c87959g5f69g4f9bg9943gefe5ed7263d5"
msgid "I will succeed where the Chosen will fail. I will dominate the world."
msgstr "선택받은 자들은 실패한 것을 내가 성공시키겠어. 난 세상을 지배할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = da054f6c-acb4-58c6-39bc-0e9dd22f9c49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:da054f6c-acb4-58c6-39bc-0e9dd22f9c49
msgctxt "h55607acbgc61bg4920ga8a4gc14bfdd668ee"
msgid "*But sleep is not for you.*"
msgstr "*하지만 지금은 잘 수 없겠네요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = e1114802-f64a-7275-2e4a-701951b0d9b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:e1114802-f64a-7275-2e4a-701951b0d9b4
msgctxt "h38ce4b7cg86b7g45c9ga1d1g6dcf5f0d0a34"
msgid ""
"*And what of your father? Will you tear him away from the elder brain's "
"clutches, or allow him to suffer?*"
msgstr "*당신의 아버지는요? 그를 엘더 브레인의 손아귀에서 풀어 줄 건가요? 아니면 그가 고통받게 내버려 둘건가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Disembodied Voice
#. NodeID = e5903464-13c9-5bc6-642b-107e03f211c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:e5903464-13c9-5bc6-642b-107e03f211c8
msgctxt "hfde7008fgaf14g4e5dga068g7f21060bda87"
msgid "<b><i>The city thirsts for domination. </i></b>"
msgstr "<b><i>도시가 지배해 달라며 소리 치고 있다.</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = f396375f-d898-f55e-3b32-4d418e58cf5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#.      - AVATAR(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:f396375f-d898-f55e-3b32-4d418e58cf5c
msgctxt "h66499204g5263g44a1g8a83g156acd71ec36"
msgid ""
"*You will finally have the chance to destroy Gortash. But what then? What "
"fires will still burn in you when he is extinguished?*"
msgstr ""
"*당신은 드디어 고타쉬를 무찌를 기회를 얻게 되겠죠. 그런데 그 뒤론? 고타쉬를 향한 복수심이 꺼지면 당신 안엔 뭐가 남아있을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Narrator
#. NodeID = f87cb1ea-3554-d798-8e96-d1cb3ca25936
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_State_IsDevil = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:f87cb1ea-3554-d798-8e96-d1cb3ca25936
msgctxt "h863fe78fge143g4391gb52egd0a07f237492"
msgid "*You who bear the face of a devil.*"
msgstr "*데빌의 얼굴을 한 당신이요?.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO
#. Speaker = Player
#. NodeID = fb08c9bd-2619-b16a-a3d8-e478b48c4e9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_LAEZEL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_WokenUpAtNight_SCO:fb08c9bd-2619-b16a-a3d8-e478b48c4e9d
msgctxt "h89da7c65gb909g468cg99f0g8d8d4eab5c8e"
msgid "I will fulfil my duty to my queen. I will ascend!"
msgstr "난 여왕님을 위해 내 의무를 다 하겠노라. 난 승천할 것이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo
#. Speaker = Karlach
#. NodeID = 19c4eaec-68d1-4e33-bcb0-730b1ac95915
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo:19c4eaec-68d1-4e33-bcb0-730b1ac95915
msgctxt "h48abe127gd89dg4ef7g8e33g3d48db88f04c"
msgid ""
"Gods, I could sleep for a hundred years. Looks safe enough for a night, I "
"reckon."
msgstr "맙소사, 지금 잠들면 백 년은 자겠네. 이 정도면 안전해보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo
#. Speaker = Lae'zel
#. NodeID = 2c5fbbfb-bd25-4c16-a3e6-a8095da511db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo:2c5fbbfb-bd25-4c16-a3e6-a8095da511db
msgctxt "h9db24f69g1327g4a4bga0cdgd3d6e21f080a"
msgid "Let us make camp, before the sun yields to the stars."
msgstr "태양이 별빛에 가리기 전에 야영지를 설치해야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo
#. Speaker = Wyll
#. NodeID = 48d27d26-d9a8-4f91-89e0-2cc66ac013a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_WYLL(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo:48d27d26-d9a8-4f91-89e0-2cc66ac013a6
msgctxt "h3be586e7gf8ddg41bdgbe9cgc22bcfd9b3b6"
msgid "Let's make camp. My muscles are stiffer than a stuffed cat."
msgstr "야영지를 설치하자. 난 근육이 돌보다 딱딱하게 뭉쳐 있는 거같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo
#. Speaker = Shadowheart
#. NodeID = a7a7301a-e44d-44b8-9c99-5271bdba464a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo:a7a7301a-e44d-44b8-9c99-5271bdba464a
msgctxt "h355e3bc6ge6a3g4f5cg8e03gae5ad8426487"
msgid "This should do nicely for a camp."
msgstr "이 정도면 야영지로 나쁘지 않겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo
#. Speaker = Gale
#. NodeID = b82ef521-0d8c-4a07-967a-362e9cb92f53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_GALE(9) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo:b82ef521-0d8c-4a07-967a-362e9cb92f53
msgctxt "h2f03c3f7g353cg4754gb451gb52f00adf5bf"
msgid "This will suffice as a camp - I could sleep standing up just now."
msgstr "이 정도면 야영지로 쓸 만 하겠지 - 난 서서도 잠들 수 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo
#. Speaker = Narrator
#. NodeID = dc2aebe7-99f1-2b74-2e5f-3882f510c354
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo:dc2aebe7-99f1-2b74-2e5f-3882f510c354
msgctxt "h46fe16aag540eg4fd0gbc7cg721a5793569c"
msgid ""
"*Beyond the campsite, the city waits in uneasy silence - one sleep away.*"
msgstr "*야영지 너머로, 도시가 불길한 침묵 속에 기다리고 있습니다 - 이제 다 왔습니다. *"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo
#. Speaker = Astarion
#. NodeID = f6a4179e-64cd-42dd-a468-226ba1eaeccc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_ASTARION(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_GithyankiAmbush_ArriveIntermezzo:f6a4179e-64cd-42dd-a468-226ba1eaeccc
msgctxt "h2b7ca553gf44eg451bgb46eg7fcdc49ab91f"
msgid ""
"Best to rest now, while we still can. Who knows what's waiting in Baldur's "
"Gate."
msgstr "쉴 수 있을 때 쉬어 둬야 해. 발더스 게이트에서 뭐가 우릴 기다릴지 누가 알겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Flaming Fist Sergeant
#. NodeID = 03b1239c-e7b1-ce78-4b5b-8abfbf63f1bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:03b1239c-e7b1-ce78-4b5b-8abfbf63f1bf
msgctxt "hc87e3525g5ae9g44eag9797g9adfea3a3bc6"
msgid ""
"Forgive me, my Lord... but there is panic in the streets. The people are "
"afraid."
msgstr "죄송합니다, 주군... 허나 거리에 공황이 벌어지고 있습니다. 시민들이 겁에 질려 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Orin
#. NodeID = 185e0e02-211a-b496-9891-3fd63a7ca893
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:185e0e02-211a-b496-9891-3fd63a7ca893
msgctxt "h02bf6ab0g3123g40e7gbc93g847f5ff010b2"
msgid ""
"But tomorrow, and tomorrow, and tomorrow, and tomorrow, my blades will "
"thirst again."
msgstr "하지만 내일도, 모레도, 글피도, 그 다음날도, 내 칼날은 또 목말라하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Orin
#. NodeID = 1f0ff277-8d42-c071-0001-e29bbe94acba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:1f0ff277-8d42-c071-0001-e29bbe94acba
msgctxt "h5359be90g1bc9g4ee4gb233g208138441207"
msgid ""
"Your plan is falling apart, lordling. Give me a reason not to cut you to "
"ribbons."
msgstr "네 계획이 어그러지고 있다, 작은 영주 나리. 내가 잘게 썰어버리지 않을 이유 하나만 대 보거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Lord Enver Gortash
#. NodeID = 330b81a9-bc43-5b8c-04c4-52d432653585
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:330b81a9-bc43-5b8c-04c4-52d432653585
msgctxt "h95a19e2bg0191g41efgad2bgf709a3d8752f"
msgid ""
"Neither of us expected the Prism-bearers to kill Ketheric. They'll be "
"travelling to the city. Let's make sure we give them a Baldurian welcome."
msgstr ""
"프리즘을 지닌 자가 케서릭을 죽일 거라고는 우리 둘 다 예상하지 못했잖아. 녀석들은 도시로 올 거야. 발더식 환영 인사로 맞이해주자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Flaming Fist Sergeant
#. NodeID = 3f818e1d-c4fc-c950-0f70-64be8f4a4d63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:3f818e1d-c4fc-c950-0f70-64be8f4a4d63
msgctxt "h8b8213a8g85deg4860gadbag62fee5503eda"
msgid ""
"No, Lord Gortash. We were interrupted... another quake in the Lower City. "
"More severe this time."
msgstr "아닙니다, 고타쉬 경. 방해가 있었습니다... 하부 도시에서 또 지진이 일어났습니다. 이번엔 더 강도가 심했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Lord Enver Gortash
#. NodeID = 51b2364c-db09-88ba-aa1f-7c2be4293c67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:51b2364c-db09-88ba-aa1f-7c2be4293c67
msgctxt "hf7c4056dgdb25g4bf7ga94cg3ed93032ebf4"
msgid ""
"Perhaps the people would be calm if you kept your nerve. I expect better "
"from the Flaming Fist than to run scared from a slight tremor in the earth."
msgstr ""
"자네가 침착함을 유지한다면 시민들도 평온해질 테지. 플레이밍 피스트 정도라면 그저 땅이 조금 흔들린다고 겁에 질려 도망치지는 않을 거라 "
"기대했는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Orin
#. NodeID = 521993f3-7008-d7e5-ddaf-9332ea98452d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:521993f3-7008-d7e5-ddaf-9332ea98452d
msgctxt "h0a82ca60g4937g40eagb38egb225882626ae"
msgid ""
"Barely. I made mince of their ugly mind matter, and if they dare return, I "
"will strip out their offal."
msgstr ""
"목숨만 부지했지. 내가 그 역겨운 정신을 짓뭉개 놨거든. 그럼에도 감히 돌아온다면, 내가 친히 그 자식의 내장을 끄집어내 주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Lord Enver Gortash
#. NodeID = 5ba6e713-3126-bcb6-10b2-ad65fb139d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:5ba6e713-3126-bcb6-10b2-ad65fb139d7e
msgctxt "hfe80ed0ege486g457fg84f3ge0396b3e69c9"
msgid ""
"Sergeant. If you are here, I presume Wyrm's Rock is secure, and preparations "
"for my inauguration are complete?"
msgstr "하사관. 자네가 여기 있다는 건, 고룡 바위의 안전이 확보됐고 내 취임식 준비가 끝났다는 뜻이겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Orin
#. NodeID = 7abb1598-59f8-41f7-e0c7-047a49609774
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_DarkUrge = True
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:7abb1598-59f8-41f7-e0c7-047a49609774
msgctxt "hae98aca5g5ea3g428egaaa1g63f75d10ca02"
msgid "My prodigal blood-kin is among them."
msgstr "그 중 나의 방탕한 혈족도 섞여 있더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Lord Enver Gortash
#. NodeID = 82dbc1e3-1b7e-aeeb-f5dd-611a466a4ddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:82dbc1e3-1b7e-aeeb-f5dd-611a466a4ddb
msgctxt "h2caf215cg90bcg4b7cg9aa7g2fb09a249dd4"
msgid "They live?"
msgstr "그 녀석이 살아 있다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Lord Enver Gortash
#. NodeID = 99cdba83-4f0a-a93c-cd7a-c75c736f6e7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:99cdba83-4f0a-a93c-cd7a-c75c736f6e7d
msgctxt "hc60c0cfdgac1bg4e86g9f00g271f919da6e2"
msgid "Get back to your duties."
msgstr "자네 근무로 돌아가게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Orin
#. NodeID = a3c1e3a6-9b9b-67d2-4e56-f45a3755f409
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:a3c1e3a6-9b9b-67d2-4e56-f45a3755f409
msgctxt "h815268aeg47f5g496ag9f4fgd0a584e97055"
msgid ""
"I itch to peel you, to split your skin, to see your skull shine in the "
"light, little tyrant."
msgstr "네 가죽을 벗기고, 살갗을 찢고, 두개골을 빛 아래에 비춰보고 싶어서 참을 수가 없단다. 작은 폭군아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Orin
#. NodeID = b59d7a6e-c3c9-9036-8f0f-ce5f1a7fe0a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:b59d7a6e-c3c9-9036-8f0f-ce5f1a7fe0a5
msgctxt "h6e1cd191gd67eg43e3ga2aeg07c66175ec84"
msgid ""
"Lucky for you, I harvested a whole family of living-flesh in Rivington at "
"Highsun. They will sate my blade-thirst tonight."
msgstr ""
"너는 운도 좋지. 하이선 절기에, 살아 숨쉬는 육신을 지닌 가족 하나를 리빙턴에서 수확했단다. 오늘 밤엔 내 칼날의 갈증을 그 자들이 "
"채워줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Lord Enver Gortash
#. NodeID = ba6d90fd-bf22-24fe-f844-f70fb30b8c11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:ba6d90fd-bf22-24fe-f844-f70fb30b8c11
msgctxt "h2eaa378fg7ed8g430cg9913g0e26c81d143d"
msgid ""
"So you came cowering to my chambers? I'm flattered, Sergeant, but even I "
"cannot command natural phenomena to cease."
msgstr ""
"그래서 겁먹은 채 내 방에 온 건가? 하사관, 아무리 나라고 해도 자연 현상을 멈출 수는 없다네. 그리 우러러 봐준다니 영광이긴 하네만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Flaming Fist Sergeant
#. NodeID = e3258038-f87e-160d-aaca-80e950722019
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:e3258038-f87e-160d-aaca-80e950722019
msgctxt "he3f40ce2g6841g4066gb1fdg311f7d5e4293"
msgid ""
"Duties, duties, duties.<b> </b>Patrolling and saluting and following and "
"bowing and scraping and 'yes, sir, no, sir, rip and cut your throat, sir'."
msgstr ""
"그놈의 근무, 근무, 근무.<b></b>순찰 돌고 경례하고 따라다니고 절 하고 긁어대며 '예, 주군. 아닙니다, 주군. 당신 목을 찢고 "
"자르겠습니다, 주군.'이라 지껄이는 꼴이라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity
#. Speaker = Lord Enver Gortash
#. NodeID = f0b4f5c7-662c-7252-acaf-612e6b3db2b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_MeanwhileInTheCity:f0b4f5c7-662c-7252-acaf-612e6b3db2b3
msgctxt "h14ccc00fg4ac3g4623gb0f2gc03c0e969cd8"
msgid ""
"Control yourself, Orin. We need to focus on reuniting the stones, or the "
"brain will break free. These quakes are just the start."
msgstr ""
"자제 좀 해, 오린. 돌을 다시 모으는 데 집중해야 해. 모으지 못하면 엘더 브레인이 풀려나고 말 테지. 이 지진은 시작에 불과하다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/ORI_Laezel_AD_PartySupressionIntermezzoAfterEmperor
#. Speaker = Lae'zel
#. NodeID = 63e7e1ee-3c22-d82e-7778-41cca75e17c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/ORI_Laezel_AD_PartySupressionIntermezzoAfterEmperor:63e7e1ee-3c22-d82e-7778-41cca75e17c6
msgctxt "h6f7ee634gacecg4161gb31cg160b557c4f86"
msgid "Out of here, quickly. We'll speak after."
msgstr "빨리 벗어나자, 대화는 나중이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/ORI_Laezel_AD_PartySupressionIntermezzoBeforeEmperor
#. Speaker = Lae'zel
#. NodeID = ad8b965f-2a8a-2361-a7f1-dc9486540e7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/ORI_Laezel_AD_PartySupressionIntermezzoBeforeEmperor:ad8b965f-2a8a-2361-a7f1-dc9486540e7b
msgctxt "h723a595bgc2bbg4b58g87efg0b8ac42a3c91"
msgid "Forward. Kill who you must to survive  - even githyanki."
msgstr "가자. 살기 위해 죽여야 하는 놈들은 죽여야 한다.. 그게 비록 기스양키 일지라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/ORI_Minthara_AD_EnteredAstralPlane
#. Speaker = Nightwarden Minthara
#. NodeID = 4adbbb38-5f8a-7325-c9d7-ca6303683afb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/ORI_Minthara_AD_EnteredAstralPlane:4adbbb38-5f8a-7325-c9d7-ca6303683afb
msgctxt "h494e7b88gaeb5g4c46g884fg0a661f11be7c"
msgid "This is incredible... are we inside the Prism?"
msgstr "말도 안 돼... 우리 프리즘 안에 들어온거야?"
