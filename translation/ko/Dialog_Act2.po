#. SetFlags:
#.   Local:
#.     - b8101d0a-5473-efd1-1d12-719d504d60b8_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_NightsongAttacked:4477c499-fc71-4a08-881b-cc5ef173d5f7
msgctxt "hfb012bb1gbf86g407fga2a0ga650e103d3a7"
msgid "I <i>cannot </i>be broken."
msgstr "난 <i>쓰러질 수 없다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_TauntPlayer
#. Speaker = Nightsong
#. NodeID = 964e52dc-f981-45af-8b55-0312e0ab5d19
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7cf6069c-f0dc-482c-bf10-eea39f59d778_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_TauntPlayer:964e52dc-f981-45af-8b55-0312e0ab5d19
msgctxt "h88d31539g1316g4958gb3a6g1169e1bf38e0"
msgid "Strike me down, if you dare."
msgstr "그럴 깜냥이 된다면 어디 날 쓰러뜨려 봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_NightsongAttacked
#. Speaker = Nightsong
#. NodeID = 82cdecf9-566c-4db3-9df3-ee084e893d57
