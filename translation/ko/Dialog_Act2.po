msgctxt "h2da6b0bcge808g4b65gb0a9ga89c751ec9ad"
msgid "No use. Flames can't hold up to this curse."
msgstr "소용없어. 불이 저주를 버텨내질 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
