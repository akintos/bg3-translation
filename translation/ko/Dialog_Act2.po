msgctxt "h6b24c0c3gd956g4948g92d4g12af256d7e0b"
msgid "Stop!"
msgstr "멈춰!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
#. Speaker = Player
#. NodeID = 2e2cbd02-79b8-8d1c-7308-7b5c66b1a99b
#. HandlePath = TaggedText[0].TagText[0]
