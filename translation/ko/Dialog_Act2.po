msgctxt "h8be1a90eg97aag4d79gaf96g9e099412d824"
msgid "Don't like all this quiet."
msgstr "이렇게 완전 조용한 건 별로야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = 429360ef-eb34-4fe2-8ff3-9f35cabcbe0c
