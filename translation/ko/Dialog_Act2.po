#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "hb56ed7bag9182g4e85g89acg40130f2311ba"
msgid "Think, Lae'zel, think. There must be a way around it."
msgstr "생각해, 레이젤, 생각해. 갈 수 있는 길이 분명 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "h6afeadcbgc98bg4f28gacb1g85775e263528"
msgid "Blasted ring. Won't be getting past that easily."
msgstr "망할 고리. 쉽게 통과하긴 어렵겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "hac2535a7g98edg43ecg9dafgc4c7eeffbedc"
msgid "I can't just blunder forward - need to find a way around this ring..."
msgstr "그냥 비집고 나아갈 수는 없어, 이 고리를 둘러 지나갈 방법을 찾아야 해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "hc1896719g06eeg42b4gaff4g5821032ffee6"
msgid "Damn ring. There's got to be <i>some</i> way around it."
msgstr "젠장할 고리. 통과할 수 있는 <i>어떤</i> 길이 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "h723707e7g52deg4264g86aeg99617cb2273c"
msgid "Gotta be a way around that ring, right? The centre's so close..."
msgstr "저 고리를 통과할 방법이 있겠지? 중심은 아주 가까운데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "hc3f6f97dg303eg4290g838eg0d56d31813e3"
msgid "Look out. We can find safe passage to the centre."
msgstr "잘 살펴봐. 중심으로 가는 안전한 길을 찾을 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "h771355f8gf18bg4880gb678g785d53569b01"
msgid "I must find a safe way to reach the centre..."
msgstr "중심으로 가는 안전한 길을 찾아야 해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "hd8391e22g7bdag4bc0gb5afg775c71070c3b"
msgid ""
"Even Shar's traps are underhand and undignified. There must be a way to "
"avoid them."
msgstr "샤는 함정마저도 비열하고 품위가 없군. 피할 수 있는 방법이 분명 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing
#. Speaker = Player
#. NodeID = a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
#. HandlePath = TaggedText[9].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Crypt_State_OuterRingVisible = True
#.      - SHA_Crypt_Event_SawRing = True
#.   Object:
#.      - SHA_Crypt_Event_PushedByOuterRing(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PushedByRing:a9ed48c0-ca9a-41d6-89b9-215be2bb18fa
msgctxt "h252d85deg3666g42d1gb0e2gbf13432c367f"
msgid "I need to be more careful. There must be a way around the ring..."
msgstr "좀 더 신중해야 해. 분명 고리를 통과할 방법이 있을 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PuzzlePlaque
#. Speaker = Narrator
#. NodeID = 88c95ea3-3d8c-b538-8425-864de0e76570
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_PuzzlePlaque:88c95ea3-3d8c-b538-8425-864de0e76570
msgctxt "h080d1cc8ga7cag4698gb32fg14e9a85a43b6"
msgid "*The answer lies in darkness.*"
msgstr "*어둠 속에 답이 있나니.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "h6aa967dfg572bg4e89g867dgca0cdd194a63"
msgid "The voice of Shar herself. Well I'll be damned."
msgstr "샤의 목소리를 듣다니. 이런 세상에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "he57aa924g6c0fg44b5gbb2agd1bdbd41b7a0"
msgid "The voice of Shar herself. Fascinating."
msgstr "샤 자신의 목소리라니. 흥미롭군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "h75751b5dgd5c3g43a6g97e1ge802ef846e69"
msgid "Shar speaks, but why to us?"
msgstr "샤가 왜 우리에게 말을 하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "h5367f6c4g256ag4364gbd03ga43ccfd41a08"
msgid ""
"Lady Shar speaks...? But just some echo, surely. A guiding voice in stone."
msgstr "샤 여신께서 말씀을...? 분명 메아리같은 거겠지. 석상에서 나오는 인도의 목소리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "h12dd3f05ge73fg4b64ga3e7g74b5f1493c1d"
msgid "The voice of the Dark Goddess herself."
msgstr "어둠의 여신 본인의 목소리로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "h145d7151gfdcdg480ega2c2g823060269bb2"
msgid "Is that Shar? <i>The </i>Shar?"
msgstr "방금 그거 샤야? <i>그</i> 샤?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "hb5ab6341gd0e6g4debgb20cgf0edaf051dbf"
msgid ""
"The voice of Shar...? Is she truly present, or a mere illusion for the ears?"
msgstr "샤의 목소리라니...? 진짜로 여기에 있는 건가? 아니면 그저 환청일 뿐인 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "hb8699388ga3bcg45ddgbb1cgee7f1c80ee66"
msgid ""
"Shar. Her presence lingers here, among the dust and bones of her faithful. "
"She is watching."
msgstr "샤. 그녀의 존재가 느껴져. 샤를 섬기던 자들의 뼈와 먼지만이 전부가 아니야. 우릴 지켜보고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_MINSC
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "hb3392a49g0515g498dgae75gb7de17986db3"
msgid ""
"That voice! It reminds me of a drow I once knew... always whispering prayers "
"to Shar."
msgstr "저 목소리! 전에 알던 한 드로우가 생각이 나는군... 언제나 샤를 향해 기도를 속삭였었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction
#. Speaker = Player
#. NodeID = b835299c-c38b-4243-a96f-286c9c1a5985
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_StatueTalksReaction:b835299c-c38b-4243-a96f-286c9c1a5985
msgctxt "h98888999gd7d9g4c31gb472g01a4206446c2"
msgid "Is that Shar's voice? Not present in person, surely..."
msgstr "샤의 목소리인가? 사람의 모습으로 나타나진 않은 것 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_Welcomed
#. Speaker = Shadowheart
#. NodeID = 4709d88f-9589-482f-99b5-aea1df1fa050
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Crypt_PAD_Welcomed:4709d88f-9589-482f-99b5-aea1df1fa050
msgctxt "h4e57daffg2655g477ag83eeg86c06f185f03"
msgid "I hear you, Lady Shar. I shall not fail."
msgstr "들립니다, 샤 여신이시여. 실패하지 않겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 0d6f6a28-9a8f-8775-ea42-23eee41fd7de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:0d6f6a28-9a8f-8775-ea42-23eee41fd7de
msgctxt "h59c884b3g70d2g4fc2ga95dg3c16de51a63f"
msgid ""
"If I prove myself to Lady Shar, she'll bless me with power - power we can "
"use to take on the Absolute and rid ourselves of these parasites, once and "
"for all. Let's explore."
msgstr "샤님께 나를 증명한다면, 힘을 내려주실 거야. 마침내 절대자를 물리치고 머릿속의 기생충을 없앨 힘을 말이야. 어서 둘러보자.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 15499834-ad24-2806-b88a-e2449d537c2d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Event_AttemptedHistoryCheck(1) = False
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - SHAR(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_AttemptedHistoryCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:15499834-ad24-2806-b88a-e2449d537c2d
msgctxt "heed6a683gc9adg44d5g818cg8086270fc333"
msgid ""
"<i>Search your memories. Do you know anything of the Dark Justiciars?</i>"
msgstr "<i>기억을 더듬는다. 다크 저스티시어에 대해서 무언가 알고 있나?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 18ba4da0-14f5-abca-d395-a690cd723885
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_AllTrialsPassed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:18ba4da0-14f5-abca-d395-a690cd723885
msgctxt "h02db0d9eg6686g4d0fga0fdgb013a55ed76e"
msgid ""
"We should be able to proceed now - the trials are all complete. Lady Shar's "
"final task is near."
msgstr "이제 나아갈 수 있을 거야, 모든 시련을 극복했어. 샤 여신님의 마지막 임무가 머지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 23f6c468-c25b-9788-ba76-b3cbad066f56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:23f6c468-c25b-9788-ba76-b3cbad066f56
msgctxt "hc4c5d5c6g5fcfg44e2gb83cgcec34b1693bd"
msgid "You don't understand - this will help free us from our infection."
msgstr "이해를 못 했나 본데, 이게 우리를 감염에서 해방해 줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 27323361-11cd-6297-f823-be4381294fc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:27323361-11cd-6297-f823-be4381294fc6
msgctxt "hd0881e42g1740g4875gb1e8gfa582fbe5341"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 2f60ef1a-02c6-89d8-a999-3ada035316c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = False
#.      - SHA_Disc_Altar_Event_DiscoveredSHFaithInSharTemple = True
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:2f60ef1a-02c6-89d8-a999-3ada035316c7
msgctxt "h41cf8a55gff2fg407dgbfbeg36eb411f9a69"
msgid ""
"The Dark Justiciars were the Nightsinger's most trusted warriors - <i>this </"
"i>is where they earned their place."
msgstr "다크 저스티시어들은 나이트싱어의 가장 신뢰받는 전사들이었지. <i>이곳에서</i> 그 자리를 얻은 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 32e0e09b-e916-449d-1a48-4149aa374b91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_Knows_ReadJusticiarBook = True
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:32e0e09b-e916-449d-1a48-4149aa374b91
msgctxt "ha566135fg26cfg44e7g8e97ga49b492453b9"
msgid "<i>Recall the contents of the book you found about Dark Justiciars.</i>"
msgstr "<i>다크 저스티시어에 관한 책에 적혀있던 내용을 기억해 낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 39572a82-f01b-b744-af69-018ccabab078
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Disc_Altar_Event_DiscoveredSHFaithInSharTemple = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:39572a82-f01b-b744-af69-018ccabab078
msgctxt "h2cbfa80bgc53dg44b5g9853gba058bf4046a"
msgid ""
"You've been keeping secrets from me - is helping you in my best interest?"
msgstr "나에게서 비밀을 가지고 있었잖아. 너를 돕는 게 맞는 걸까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 3a4ec8b2-3926-b614-27fa-eecb112d8a2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:3a4ec8b2-3926-b614-27fa-eecb112d8a2c
msgctxt "h43fbc8aag1fccg488fg9394gd02fb55a0401"
msgid "I'm sorry I kept it from you. It's not a secret to be shared lightly."
msgstr "숨겨서 미안해. 가볍게 말할 수 있는 비밀이 아니었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 3dcea034-db28-5077-62a8-c312fc8343b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_Knows_JusticiarDream = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:3dcea034-db28-5077-62a8-c312fc8343b7
msgctxt "h5963ee57g9badg4c62gbfe7ge8ef135d72df"
msgid ""
"*Your convictions have proven true. This is <i>the </i>Gauntlet of Lady "
"Shar. Perhaps here, you can show yourself to be worthy. A Dark Justiciar, at "
"last.*"
msgstr ""
"*당신의 예상은 적중하였습니다. 이곳이 바로 <i>그</i> 샤의 건틀릿입니다. 어쩌면 여기서 자신의 가치를 증명할 수 있을지도 "
"모릅니다. 드디어 다크 저스티시어가 될 기회입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 42bcf8c2-0747-2f8e-7f6f-980cc8a6967f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:42bcf8c2-0747-2f8e-7f6f-980cc8a6967f
msgctxt "h9ed2f2dbga6f3g4157g86a3gfba4d2ffdaf3"
msgid ""
"*Lady Shar's values are clear - her children must excel in stealth, combat "
"and navigating her sacred darkness.*"
msgstr "*샤 여신의 기준은 명확합니다. 샤의 아이들은 은신, 전투, 그리고 그녀의 거룩한 어둠을 탐색하는데 뛰어나야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 42bcf8c2-0747-2f8e-7f6f-980cc8a6967f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:42bcf8c2-0747-2f8e-7f6f-980cc8a6967f
msgctxt "h92bd5081gd610g4695gad95gcb5c2ea86fd1"
msgid ""
"*No doubt they test the unseemly virtues Sharrans hold dear - stealth, "
"violence, skulking in darkness, and other such craven pursuits.*"
msgstr ""
"*샤 신도들이 끔찍이 따르는 그 꼴사나운 덕목들을 시험하는 것이 틀림없습니다. 은신, 폭력, 어둠 속의 잠행 등의 비겁한 일들입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 42bcf8c2-0747-2f8e-7f6f-980cc8a6967f
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:42bcf8c2-0747-2f8e-7f6f-980cc8a6967f
msgctxt "h246babfdg3a36g4b37g9890g7994ffb44b2d"
msgid ""
"*Shar worshippers value traits like stealth, martial prowess, and navigating "
"their goddess' darkness. The trials may test such skills.*"
msgstr ""
"*샤의 추종자들은 은신, 무력, 그리고 여신의 어둠 속을 탐색하는 능력을 중요시합니다. 시련에서 그러한 능력을 시험받을지도 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 4ab4a19e-5daf-d4d3-0d8c-e5c8c9d5a8d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:4ab4a19e-5daf-d4d3-0d8c-e5c8c9d5a8d6
msgctxt "h4b89bea3gb307g49e0g8806g5949a6b2ef73"
msgid "*Nothing comes to you.*"
msgstr "*아무것도 알아낼 수 없었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 507a7cb9-7252-9e0f-4889-812f4b4e8fdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:507a7cb9-7252-9e0f-4889-812f4b4e8fdd
msgctxt "h09f51f9cg1a13g4fdagbfcdgc99e7b307b6d"
msgid ""
"If I become a Dark Justiciar, I'll have Lady Shar's highest blessing, and "
"her arsenal at my disposal. This will be good for all of us. Let's explore."
msgstr ""
"내가 다크 저스티시어가 된다면, 샤 여신님의 고귀한 축복을 받을 것이고, 그녀의 무기를 휘두를 수 있게 될 거야. 우리 모두에게 이득이 "
"될 거지. 어서 둘러보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 53beccf2-3877-8dcc-097f-7ba11c1cfc9e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Event_AttemptedHistoryCheck(1) = False
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - SHAR(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_AttemptedHistoryCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:53beccf2-3877-8dcc-097f-7ba11c1cfc9e
msgctxt "h8bffd63dg7d33g4badg808cg9dcd440de2ae"
msgid "<i>Search your memories. What do you know of the Dark Justiciars?</i>"
msgstr "<i>기억을 더듬는다. 다크 저스티시어에 대해서 무엇을 알고 있지?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 55b3d546-affb-1eb3-9017-840b392b57d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Event_AskedSHAboutDarkJusticiars(1) = False
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#.      - SHA_Shadowheart_State_FoundDiscAltar = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_AskedSHAboutDarkJusticiars(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:55b3d546-affb-1eb3-9017-840b392b57d3
msgctxt "h66d07083g1831g4698gb6a1g77ba463042d3"
msgid "Hold on - are you telling me you worship Shar, Shadowheart?"
msgstr "잠깐만. 지금 네가 샤를 숭배한다는 거야, 섀도하트?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 5c3d0ad1-2c3e-d544-ceb6-d795635656ff
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:5c3d0ad1-2c3e-d544-ceb6-d795635656ff
msgctxt "h1bca8503gb51eg4500gac7fgade6184e8702"
msgid ""
"I'm glad we can face them together. If we become Dark Justiciars, we'll have "
"Lady Shar's highest blessing, and her arsenal at our disposal. Let's explore."
msgstr ""
"함께 시련에 맞서게 돼서 기뻐. 우리가 다크 저스티시어가 된다면, 샤 여신께서 최고의 축복을 내리시겠지. 그분의 무기를 휘두를 수 있게 "
"되는 거야. 어서 가자.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 5c3d0ad1-2c3e-d544-ceb6-d795635656ff
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:5c3d0ad1-2c3e-d544-ceb6-d795635656ff
msgctxt "hd06ace8bg7396g47edga3cag38e251d64dc6"
msgid ""
"Thank you. If I become a Dark Justiciar, I'll have Lady Shar's highest "
"blessing, and her arsenal at my disposal. This will be good for all of us. "
"Let's explore."
msgstr ""
"고마워. 내가 다크 저스티시어가 된다면, 샤 여신님의 고귀한 축복을 받을 것이고, 그녀의 무기를 휘두를 수 있게 될 거야. 우리 모두에게 "
"이득이 될 거지. 어서 둘러보자.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 63fada9c-a412-2f57-cb1b-f1f4c81112ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:63fada9c-a412-2f57-cb1b-f1f4c81112ab
msgctxt "hb4cd272dg3a70g451dg81d2g2de043f47e90"
msgid ""
"What does it mean? It means we'll have power - power we can use to take on "
"the Absolute and rid ourselves of these parasites, once and for all."
msgstr "무슨 의미냐고? 우리가 힘을 가진다는 의미지. 마침내 절대자를 물리치고, 이 기생충을 없앨 힘을 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 648219e3-b1ba-b95d-cc35-fc3f2ae20352
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:648219e3-b1ba-b95d-cc35-fc3f2ae20352
msgctxt "h85e08194g89e9g486fga83ag9172c3d336c9"
msgid ""
"*A shiver of revulsion passes through you. Many enemies of the Moonmaiden "
"must have been indoctrinated in this place.*"
msgstr "*증오의 소름이 등골을 타고 오릅니다. 달처녀의 수많은 적이 이곳에서 세뇌당하였음이 분명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 65ef42a0-70c6-db92-31bf-c1dc0d10b4b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = False
#.      - SHA_Trials_Knows_ReadTrialsBook = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:65ef42a0-70c6-db92-31bf-c1dc0d10b4b1
msgctxt "h4dc794aege21fg4ff1g85a5g420e653e0597"
msgid "<i>Recall what you read before about the Trials of Shar.</i>"
msgstr "<i>샤의 시련에 대해서 읽었던 내용을 기억해 낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 66d17efa-6390-d36b-fec6-ed5db02dff2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(2) = True
#. SetFlags:
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#.     - SHA_Disc_Altar_Event_DiscoveredSHFaithInSharTemple = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:66d17efa-6390-d36b-fec6-ed5db02dff2a
msgctxt "h20e5db96gfdf9g4ecagae09ge8e5499ab33d"
msgid ""
"Not the place or manner in which I thought you'd learn it, but yes - I "
"worship the Dark Lady."
msgstr "이런 곳에서 이렇게 알려주게 될 줄은 몰랐지만, 맞아. 나는 어둠의 여신을 따르고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 690ac0e6-5c6d-e267-9221-7ec03a8ed8fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_Event_AllGemsFound = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:690ac0e6-5c6d-e267-9221-7ec03a8ed8fc
msgctxt "hf93cf6b9g5549g4b96gbb94gcd111fb87809"
msgid "We have all the gems - let's put them to use and continue onwards."
msgstr "보석을 모두 모았어. 이걸 사용해서 앞으로 나아가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 6cdb8401-450b-84d4-a960-e7cc86279fcb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:6cdb8401-450b-84d4-a960-e7cc86279fcb
msgctxt "h24aa5593ge7b2g4dd3ga976geb4536c14b5c"
msgid ""
"In order to join Lady Shar's elite, you had to pass her trials, then make a "
"sacrifice in her innermost sanctum - one revealed only when you've proven "
"yourself. Very few made it that far."
msgstr ""
"샤 여신님의 정예군에 들어가기 위해서는 시련들을 통과해야 하고, 가장 깊숙한 성소에서 희생해야 해. 성소는 자기 자신을 증명해야 비로소 "
"나타나지. 거기까지 도달한 자는 거의 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 78c78bfc-3352-ff5e-4414-955cf0338596
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Knows_GemsRequired = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:78c78bfc-3352-ff5e-4414-955cf0338596
msgctxt "h09095d42g0b56g4fefg9bf4g900848705809"
msgid ""
"*There are recesses on the altar that look intended to house something. "
"Another such receptacle already contains a gemstone.*"
msgstr "*무언가를 담는 용도로 보이는 홈이 있습니다. 다른 비슷한 그릇에는 보석이 들어있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 8b794399-5a7c-9a19-7a65-1c4e305bdf0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - ORI_COM_ShadowHeart.LearnedMemorySupressed(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:8b794399-5a7c-9a19-7a65-1c4e305bdf0a
msgctxt "h3cbd5bbfg50e1g4da5gba3cgbcc19f67dc7f"
msgid ""
"<i>The Gauntlet of Shar. </i>This place is legendary - I surrendered most of "
"my memories to help protect Shar's secrets, yet I still remember the stories "
"of the Gauntlet..."
msgstr ""
"<i>샤의 건틀릿.</i> 전설적인 장소야. 그동안 샤님의 비밀을 수호하기 위해 내 수많은 기억을 바쳤지만, 이 시련은 여전히 기억나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 8c46ef57-5d2d-d367-3eec-1d139bd080df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_20_For_Sp2(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:8c46ef57-5d2d-d367-3eec-1d139bd080df
msgctxt "h5ab20d05g5730g4539ga127ge0968c54ad7a"
msgid ""
"Yes. I've had some doubts in the past... but surely that's normal for such a "
"monumentous step."
msgstr "그래. 과거엔 의심도 했었지만... 그래도 이렇게 큰 성장을 눈앞에 두면 당연한 건지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 8d86af8d-57a2-0540-540a-fc08f665c4d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Knows_BecomeJusticiar = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:8d86af8d-57a2-0540-540a-fc08f665c4d8
msgctxt "hec36a74dg3e75g45acga63ag72348e9ef730"
msgid ""
"I've dreamed of this place. This is my destiny - I must complete the trials."
msgstr "이곳을 계속 꿈꿔왔어. 이게 내 운명이야, 시련을 통과하고 말겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 91d29ed3-603a-ca66-cb9b-37aa9fb5a81b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_40_For_Sp2(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:91d29ed3-603a-ca66-cb9b-37aa9fb5a81b
msgctxt "hc7834befg4cdag4763g8ffagc4e6c26e03e8"
msgid "You know me better than most - but I need to find out if I'm worthy."
msgstr "넌 나를 웬만한 사람보다 잘 알지. 하지만 나는 내가 자격이 있는지 알아야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 97b2ad6f-363e-457d-cb57-105f64c09dc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_DarkJusticiarSuspicion = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:97b2ad6f-363e-457d-cb57-105f64c09dc3
msgctxt "hd73febdag8066g441bg8537ga6bc08e0c72f"
msgid ""
"*Your suspicions have proven true. This is <i>the </i>Gauntlet of Lady Shar. "
"Perhaps here, you can show yourself to be worthy. A Dark Justiciar, at last.*"
msgstr ""
"*당신의 의심은 맞았습니다. 이곳이 바로 <i>그</i> 샤의 건틀릿입니다. 어쩌면 어기서 자신의 가치를 증명할 수 있을지도 모릅니다. "
"드디어 다크 저스티시어가 될 기회입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 995fcf4d-1586-fc4c-de14-e41a22b02c82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:995fcf4d-1586-fc4c-de14-e41a22b02c82
msgctxt "hde1941ccgb05bg4a35gb769gda2f4ee1ff60"
msgid "*The inscription's challenge remains the same.*"
msgstr "*비문에 새겨진 글은 여전히 전과 동일합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = 9a19c675-fc71-4fae-a45a-e2e8104e8251
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Shadowheart_State_FoundDiscAltar = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:9a19c675-fc71-4fae-a45a-e2e8104e8251
msgctxt "h77a64ed3gf167g40c3g8db3gbb1e563c69e3"
msgid ""
"The Dark Lady's finest warriors arose from this place - and now <i>I'm "
"</i>here."
msgstr "여둠의 여신님이 가진 최고의 전사들이 이곳에서 탄생했어. 그리고 이제 <i>내가</i> 여기에 있다니. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 9b7a2a94-ee7a-1abe-3539-74ebdbd2d0b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SELUNE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:9b7a2a94-ee7a-1abe-3539-74ebdbd2d0b6
msgctxt "h886b6c5dgc999g470ag8f66g4a36af50fb30"
msgid "I've no intention of letting you prove your fanaticism to Shar."
msgstr "샤에게 네가 광신도라고 증명하는 걸 도울 생각 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 9b8ff1e0-3f7a-c0d2-70e5-3f1f2f911deb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Upper_State_DiscUnlocked = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_ExamineAltar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:9b8ff1e0-3f7a-c0d2-70e5-3f1f2f911deb
msgctxt "h2187c7bfg7667g4bf5ga990g4d0723c87b13"
msgid "<i>Examine the altar.</i>"
msgstr "<i>제단을 조사한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = 9cbb8530-13f8-09bc-d434-803174d59c4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:9cbb8530-13f8-09bc-d434-803174d59c4b
msgctxt "he0d74cbeg84bdg43e4ga009ge2f072d46884"
msgid "What does becoming a Dark Justiciar mean?"
msgstr "다크 저스티시어가 된다는 게 무슨 의미지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = 9f39e5b0-a76e-4df7-b0c9-d0f554e93259
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:9f39e5b0-a76e-4df7-b0c9-d0f554e93259
msgctxt "h9d84d24fg67d0g425bgb9baga72d38167f9e"
msgid "*The name seems familiar, but nothing comes to you.*"
msgstr "*들어본 적 있는 것 같은 명칭이지만, 아무것도 떠오르지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = a086de35-adf4-466f-73eb-fb6d3196b716
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - SHA_Shadowheart_State_FoundDiscAltar = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:a086de35-adf4-466f-73eb-fb6d3196b716
msgctxt "h0b7316a7g3611g434dg90afgdce6885a99d9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = a0ad2c5a-7cc5-1eeb-18b3-c4947e1d94e3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Event_AttemptedReligionCheck(1) = False
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - SHAR(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_AttemptedReligionCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:a0ad2c5a-7cc5-1eeb-18b3-c4947e1d94e3
msgctxt "he854793cgf30eg46deg870eg519545188a07"
msgid ""
"<i>The inscription spoke of the trials of Shar. Ask yourself what those "
"could be.</i>"
msgstr "<i>비문에는 샤의 시험이라는 말이 있었다. 그게 뭔지 스스로에게 물어본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = ab12aa06-afa4-bf2f-a96c-29da643929de
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ab12aa06-afa4-bf2f-a96c-29da643929de
msgctxt "h12db816eg5fcag4423g8671gcf4a28888a7f"
msgid ""
"Honouring the Dark Lady is important, yes... but shouldn't we stay focused "
"on finding a cure?"
msgstr "어둠의 여신을 섬기는 건 중요하지, 그래... 그래도 치유법을 찾는 데에 집중해야 하지 않을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = ab12aa06-afa4-bf2f-a96c-29da643929de
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ab12aa06-afa4-bf2f-a96c-29da643929de
msgctxt "h34d2b0b4g3400g4e5cg8f2fgc9265aa827bc"
msgid "This is a distraction. We need to stay focused on finding a cure."
msgstr "이건 방해가 될 뿐이야. 우리는 치료법을 찾는 데 집중해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = ac417158-ecfe-9af3-32f7-464500957fdb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Event_AttemptedReligionCheck(1) = False
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.   Tag:
#.      - SHAR(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_AttemptedReligionCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ac417158-ecfe-9af3-32f7-464500957fdb
msgctxt "he9f69de9g5d3dg44d7gac10g82778ec18075"
msgid ""
"<i>The trials of Lady Shar. Recall what they are - you must know, surely.</i>"
msgstr "<i>샤의 시련. 그것이 무엇인지 기억해 낸다. 분명 알고 있을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = aca2f8bc-e413-8ac4-16db-b5dcd58c8b56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Event_AskedSHAboutDarkJusticiars(1) = False
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = False
#.      - SHA_Shadowheart_State_FoundDiscAltar = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_AskedSHAboutDarkJusticiars(1) = True
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:aca2f8bc-e413-8ac4-16db-b5dcd58c8b56
msgctxt "h3eaec179g55f6g4c72ga369g75a3f3709ef9"
msgid ""
"It seems to be Lady Shar's will - but what are these Dark Justiciar trials, "
"Shadowheart?"
msgstr "그게 샤 여신의 목적인 듯하네. 그런데 이 다크 저스티시어 시련이라는 건 뭐지, 섀도하트?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = aca2f8bc-e413-8ac4-16db-b5dcd58c8b56
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Disc_Altar_Event_AskedSHAboutDarkJusticiars(1) = False
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = False
#.      - SHA_Shadowheart_State_FoundDiscAltar = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Event_AskedSHAboutDarkJusticiars(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:aca2f8bc-e413-8ac4-16db-b5dcd58c8b56
msgctxt "h55977879gf088g437bg80e0g7689f8e73056"
msgid "What are these trials, Shadowheart?"
msgstr "섀도하트, 이 시험은 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = ad2ba237-2aca-b902-9a0e-afa0f674d800
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = True
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ad2ba237-2aca-b902-9a0e-afa0f674d800
msgctxt "h6811edfagfd60g4b77gaa81gb8b79c4e7543"
msgid ""
"*Lastly, she asks for a sacrifice. To become a Dark Justiciar, one must "
"spill the blood of a Selûnite.*"
msgstr "*마지막으로, 그녀는 희생을 요구할 것입니다. 다크 저스티시어가 되기 위해서는 셀루네 신도의 피를 흘려야 할 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = ad2ba237-2aca-b902-9a0e-afa0f674d800
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = True
#. TagRule: SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ad2ba237-2aca-b902-9a0e-afa0f674d800
msgctxt "h3c94970eg739ag4d7fg8938g948b8e6a45ad"
msgid ""
"*The depravities don't end there - the Sharrans then sacrifice a follower of "
"the Moonmaiden in order to complete their initiation.*"
msgstr "*하지만 타락은 여기서 멈추지 않습니다. 이어서 샤 신도들은 달처녀의 추종자를 희생하여 비로소 입단을 완료합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = ad2ba237-2aca-b902-9a0e-afa0f674d800
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ad2ba237-2aca-b902-9a0e-afa0f674d800
msgctxt "hcf9ff3ebgf15dg4aedg96f5g7b7cba58793e"
msgid ""
"*It seems they would complete their initiation with the blood sacrifice of a "
"Selûnite.*"
msgstr "*셀루네 신도를 희생하여 입단을 완료할 것으로 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = ae59f4a5-912e-ba40-ee79-bb48441da3ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ae59f4a5-912e-ba40-ee79-bb48441da3ce
msgctxt "h7a4b56c3g5afcg4a14g9b8bg4c82f621a31c"
msgid "Are you sure this is what you want?"
msgstr "이게 정말로 네가 바라는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = bd33753c-fc12-027f-82ae-722f8338fd56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_30_For_Sp2(2) = False
#. SetFlags:
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#.     - SHA_Disc_Altar_Event_DiscoveredSHFaithInSharTemple = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:bd33753c-fc12-027f-82ae-722f8338fd56
msgctxt "hf49aa91eg10afg4ecbg9b9dg72e4c9363bde"
msgid ""
"Frankly I'm amazed you didn't work it out for yourself already. I'm not sure "
"if that makes you highly respectful or deeply ignorant."
msgstr ""
"솔직히 네가 아직도 알아차리지 못했다는 게 놀라워. 이걸 예의가 있다고 해야 할지, 아니면 눈치가 없다고 해야 할지 잘 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = c3708472-3ef2-cb96-c5b3-ab366b1c86b2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:c3708472-3ef2-cb96-c5b3-ab366b1c86b2
msgctxt "he379aa80gcb68g4c21g8201gabe61e05357b"
msgid ""
"Don't worry, I won't sacrifice you. I think Lady Shar would want a more "
"impressive offering."
msgstr "걱정하지 마, 널 희생하진 않을 거야. 샤 여신님은 더 인상 깊은 제물을 바라실 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = c7203523-b5b8-e838-527a-ca0296ae4413
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = True
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:c7203523-b5b8-e838-527a-ca0296ae4413
msgctxt "hac70eeb3g9103g47acga585g8318908f305f"
msgid ""
"*The Dark Lady's cadre of elite warriors. The most faithful. The most "
"envied. The most ruthless.*"
msgstr "*어둠의 여신을 따르는 정예 전사들입니다. 누구보다 신실하며, 모두가 선망하는, 무자비한 집단이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = c7203523-b5b8-e838-527a-ca0296ae4413
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = True
#. TagRule: SELUNE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:c7203523-b5b8-e838-527a-ca0296ae4413
msgctxt "hb61a3ae6ge7ecg40dcg9247g02a48d409837"
msgid "*You recall stories of elite Sharran warriors - ruthless fanatics.*"
msgstr "*정예 샤 전사들에 대한 이야기가 기억이 납니다. 무자비한 광신도들입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = c7203523-b5b8-e838-527a-ca0296ae4413
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Disc_Altar_Event_LearnedOfDarkJusticiars = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:c7203523-b5b8-e838-527a-ca0296ae4413
msgctxt "h60c1d345g6732g40c3g815eg6c429aac5720"
msgid ""
"*You recall them being an inner circle of Shar followers - elite warriors, "
"loyal to their last breath.*"
msgstr "*샤 추종자들 내부의 핵심 집단을 이르는 명칭입니다. 그들은 정예 전사들로써, 숨이 다하는 날까지 충성을 바칩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = ccbfcb87-289e-96a0-e05e-94cd628fa2fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ccbfcb87-289e-96a0-e05e-94cd628fa2fe
msgctxt "h60b7e3cdg620bg4143gb000ga8fa38936c84"
msgid ""
"*Your breath catches. The Gauntlet of Lady Shar - where her Dark Justiciars "
"of old proved their mettle, through gruelling trial and sacrifice. Perhaps "
"you can join their ranks.*"
msgstr ""
"*숨이 멎습니다. 샤의 건틀릿, 오래전 다크 저스티시어들이 가혹한 시련과 희생을 통해 자신의 가치를 증명했던 곳입니다. 어쩌면 당신도 "
"그들과 함께할 수 있을지도 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = d10e4172-da42-0f86-c7c0-60237dbf8214
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - ORI_COM_ShadowHeart.LearnedMemorySupressed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:d10e4172-da42-0f86-c7c0-60237dbf8214
msgctxt "h4aa7afdag001fg4193g8b3cg939feb26c5df"
msgid ""
"<i>The Gauntlet of Shar.</i>This place is legendary - even with half my "
"memories locked away, I still remember the stories..."
msgstr "<i>샤님의 시련.</i> 전설적인 장소야. 내 기억의 반쪽은 아직 묶여있지만, 이건 여전히 기억나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = d14d3287-2ccf-5668-bfb6-14ce6fe93aae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:d14d3287-2ccf-5668-bfb6-14ce6fe93aae
msgctxt "h19a5a545g745dg4887gb241g04528e86fbea"
msgid ""
"We can discuss your hurt feelings later. If we want to make progress in this "
"place, we have to do the trials."
msgstr "네 상처받은 마음에 대해선 나중에 이야기하자고. 여기서 나아가기 위해서는 시련을 통과해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = d4f9fef4-7566-ba0f-a4b9-3924f5e05345
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Disc_Altar_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:d4f9fef4-7566-ba0f-a4b9-3924f5e05345
msgctxt "hcc2362a9g5ae4g4cacga8ddg900561d0c9ab"
msgid "*Upon the altar is an inscription.*"
msgstr "*제단에 비문이 새겨져 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = de85b49b-6e24-3d26-4bff-fe3dead3c70e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_NightsongPoint_AgreedToTrials = True
#. TagRule: SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:de85b49b-6e24-3d26-4bff-fe3dead3c70e
msgctxt "hb17fe496g17adg46e1ga19eg2e93018e9341"
msgid ""
"Of course - we are Lady Shar's children, both. The trials must be completed."
msgstr "당연하지, 우리는 둘 다 샤 여신님의 아이들이니까. 시련은 완료되어야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = de85b49b-6e24-3d26-4bff-fe3dead3c70e
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_NightsongPoint_AgreedToTrials = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:de85b49b-6e24-3d26-4bff-fe3dead3c70e
msgctxt "h9fe3a28eg5952g46f5gaf4cgc2430fa49a23"
msgid "All right, I'll help if I can."
msgstr "알겠어, 가능하면 도울게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = ed210630-50a6-4c2c-ae94-f74442077537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:ed210630-50a6-4c2c-ae94-f74442077537
msgctxt "h9a72fc88g0396g4f0fgbbadgdea6333b34a5"
msgid "Do you really need to ask? It's all I've ever wanted."
msgstr "꼭 물어봐야지만 알겠어? 이건 내가 그 무엇보다 바라던 일이었는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Shadowheart
#. NodeID = eece7d08-c025-0d99-cfc0-7512dea78692
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Trials_State_AllTrialsPassed = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:eece7d08-c025-0d99-cfc0-7512dea78692
msgctxt "hdc0f7cc1g2c12g4344g88b7gfed194ddd858"
msgid ""
"There's nothing more for us to do here - not until we complete Lady Shar's "
"trials."
msgstr "우리가 여기서 할 수 있는 건 없어. 샤님의 시련을 마치기 전까지는 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Narrator
#. NodeID = f9e7c50d-8796-81f1-b606-553998763f48
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Trials_Knows_SeenAltarInscription = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:f9e7c50d-8796-81f1-b606-553998763f48
msgctxt "h4cc13a31g0b2cg41bag9644gd994bf6ffef1"
msgid ""
"*Brave the Gauntlet of your Lady Shar. Surmount her trials, and rise a Dark "
"Justiciar.*"
msgstr "*샤님의 시련을 감내하라. 그 분이 내리신 시험을 극복하라. 다크 저스티시어로서 일어나라.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar
#. Speaker = Player
#. NodeID = fd016aae-bbcf-3dbd-68c4-f66c75f78f3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_Altar:fd016aae-bbcf-3dbd-68c4-f66c75f78f3e
msgctxt "hdb1d6d6eg0f28g418ag8976g61b71ab13018"
msgid ""
"We're here to gain Ketheric Thorm's trust and uncover the Absolute's secrets "
"- nothing more."
msgstr "우리는 케서릭 쏨의 신뢰를 얻고 절대자의 비밀을 밝히기 위해서 여기에 온 거야. 그뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_ShadowheartIntro
#. Speaker = Shadowheart
#. NodeID = d4fd8444-1565-4d5d-b0e8-682ddf2dbb66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Trials_PAD_ShadowheartIntro:d4fd8444-1565-4d5d-b0e8-682ddf2dbb66
msgctxt "h5ddedbc6gff0ag4ae5g9975gb782b99dc7b8"
msgid "I shall prove myself worthy, Lady Shar."
msgstr "샤 여신이시여, 제 가치를 증명해 보이겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_Unlocked
#. Speaker = Player
#. NodeID = 6ccc82a0-d6f5-f958-a901-875658950554
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_Unlocked:6ccc82a0-d6f5-f958-a901-875658950554
msgctxt "h6e50f93ege87dg451cgb966gde9a3fa01986"
msgid ""
"The disc's on the move, hopefully leading to the end of this bloody Gauntlet."
msgstr "원반이 움직이네, 이 빌어먹을 건틀릿 끝으로 가는 거면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_Unlocked
#. Speaker = Player
#. NodeID = 6ccc82a0-d6f5-f958-a901-875658950554
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Disc_Altar_Event_LearnedOfDarkJusticiarTrials = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_Unlocked:6ccc82a0-d6f5-f958-a901-875658950554
msgctxt "h0ea0ec49g5e53g4759gbec9g553a89f8741a"
msgid "The disc is moving - Shar's trials must continue wherever it leads."
msgstr "원반이 움직이네. 어디로 데려가든 샤의 시련이 이어지겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_Unlocked
#. Speaker = Player
#. NodeID = 6ccc82a0-d6f5-f958-a901-875658950554
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
