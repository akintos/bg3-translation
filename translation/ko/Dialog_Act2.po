msgctxt "h981de720g7601g4e6ag88eegd90c6c5373c4"
msgid "Help us. Save us."
msgstr "도와줘. 구해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_IntellectDevourer_Interaction
