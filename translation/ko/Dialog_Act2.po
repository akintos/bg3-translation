msgctxt "ha944f60cg42d0g458fga6cfge18b6cea4648"
msgid "This might be the only peaceful spot for a league."
msgstr "여기가 요 일대에서 유일하게 안전한 곳일지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_003
