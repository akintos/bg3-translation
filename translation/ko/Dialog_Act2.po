msgctxt "hf66f0ad7gc981g4580gb168gd43447beb232"
msgid "Flesh met horn - and flesh lost."
msgstr "살덩이와 뿔이 부딪혔고, 살이 졌군.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedTiefling
