msgctxt "hce7b941bgc556g48c3ga667g57725df28a24"
msgid "Moonrise... granted audience... the others..."
msgstr "문라이즈가... 받아들였다... 다른 이들을..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_Zevlor_Dead
