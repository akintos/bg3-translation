msgctxt "h5e8f5249g0c17g4a8dga25dg91abc9b74a64"
msgid "I didn't come here to fight gods - I just want my parasite removed."
msgstr "신들과 싸우려 온 건 아니야. 그저 기생충을 없애고 싶을 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_KethericShowdown_CrownController
#. Speaker = GROUP_Daisy
#. NodeID = c76080fd-4fda-8535-8717-c08bb67af4a4
