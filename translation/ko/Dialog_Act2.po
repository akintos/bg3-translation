msgctxt "h16bc042ag3c95g4b00gbe30g5fcd4b274aa4"
msgid "I admit I haven't thought about it."
msgstr "생각해본 적이 없다는 걸 인정해야겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
