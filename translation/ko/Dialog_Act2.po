msgctxt "h05f997cag12f6g4681g8ddfg62951cde4fa2"
msgid "Thing's been consumed by the shadows. Poor fella."
msgstr "그림자에게 제대로 먹혀버렸네. 불쌍한 녀석."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowBirds_PAD_Approach
