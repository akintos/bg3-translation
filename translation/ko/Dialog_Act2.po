msgctxt "h697174eag7345g401fgada9gcce2c7c14432"
msgid "The Elder stirs. Awakes!"
msgstr "엘더가 움직여. 깨어났어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_GEN_AD_IntellectDevourer
