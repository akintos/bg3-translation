#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:0bcfcd1c-4ff2-14f9-ed45-46c4872ea610
msgctxt "hfa2236e8g7e22g403dg9f53g45ef5c3c5350"
msgid "Go, go!"
msgstr "가자, 어서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 3949aaae-9d0f-8308-2bc7-ee199ca604e6
