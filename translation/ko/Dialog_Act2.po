msgid "Sister. The first instrument, if I may."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon_InstrumentRequest_002_Combat
#. Speaker = Malus Thorm
#. NodeID = e4c288e3-d54f-4811-8e8f-02decd3c4a36
