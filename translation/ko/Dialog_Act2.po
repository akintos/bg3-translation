#.      - MOO_Assault_AssaultHarper_001_SCE_HasMet(1) = True
#.   Global:
#.      - SCE_Epilogue_State_HasStarted = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:2f696bd0-8bf6-7c4c-8695-452781e58686
msgctxt "h6edd5273gbd96g4229gb582g6734a7fcacba"
msgid ""
"Selûne willing, we'll get the order to move soon. I don't like camping above "
"a godsdamned illithid nest."
msgstr "별일이 없다면, 곧 이동하라는 명령이 하달되겠지. 빌어먹을 일리시드 둥지 위에서 야영하긴 싫거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = 4630c800-e53c-690c-fc12-b603d37dff54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCE_Epilogue_State_HasStarted = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_001_SCE_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:4630c800-e53c-690c-fc12-b603d37dff54
msgctxt "hef237c98ga9cfg4ae2ga0a5g73e1115a06ee"
msgid ""
"A colony. A godsdamned <i>elder brain</i>. I faced a lone mind flayer, once, "
"and it slaughtered half my squad."
msgstr "망할 <i>엘더 브레인</i> 식민지라니. 딱 한번 혼자 있는 마인드 플레이어를 만나봤는데, 내 분대 절반을 쓸어버렸다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = 77b97865-eded-46c9-b0b1-f685b22c2353
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:77b97865-eded-46c9-b0b1-f685b22c2353
msgctxt "h9d911cddgd8eeg4671gb09eg15ecbd8f8bfd"
msgid "That figure... Selûne herself fights with us."
msgstr "마치... 셀루네께서 우리와 함께 싸우는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = 8d992d38-5cb1-4c66-9528-dc11fbd33137
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:8d992d38-5cb1-4c66-9528-dc11fbd33137
msgctxt "he48482d5g7431g4bfcga02fg1867a922daf4"
msgid "We're in it now, whatever comes."
msgstr "한배를 탄 셈이로군. 어떻게든 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = a4189464-6790-49ba-acc2-fe3d565920e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_001_PostAssault_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:a4189464-6790-49ba-acc2-fe3d565920e4
msgctxt "h3a8c9d99ge057g49edgbb83g1c9e5393c183"
msgid "Finish it."
msgstr "끝내버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001
#. Speaker = Harper Lanni
#. NodeID = f2938ac7-c574-ee66-1e56-d1bac2fd4c42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_001_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_001:f2938ac7-c574-ee66-1e56-d1bac2fd4c42
msgctxt "ha36acc43g5324g45f7gaad9g466802fa89fe"
msgid "Let's get the bastard - lead the way."
msgstr "그 개자식을 잡으러 가자고 - 앞장서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002
#. Speaker = Harper Grenywald
#. NodeID = 12044b8f-4d1b-4d85-bbb7-0dc159a04230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_002_ThroneRoomDefeated_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_002_ThroneRoomDefeated_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002:12044b8f-4d1b-4d85-bbb7-0dc159a04230
msgctxt "hcc706521g8833g48d7g8ac4g32eb98863188"
msgid "This place is all dark corners. Stay sharp, eh?"
msgstr "여긴 죄다 어두컴컴하니까, 정신 바짝 차리라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002
#. Speaker = Harper Grenywald
#. NodeID = 1e86b9bf-56e1-43f9-8c5f-9ac212054a86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_002_PostAssault_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_002_PostAssault_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002:1e86b9bf-56e1-43f9-8c5f-9ac212054a86
msgctxt "hb4534a60gf7d5g4f3bgaf4cg7d1c8ddc57c2"
msgid "I hope... I hope we get a chance to see to the dead."
msgstr "부디... 죽은 자들을 돌아볼 시간이 났으면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002
#. Speaker = Harper Grenywald
#. NodeID = 4c45e85d-69d3-4850-bd68-3b43658041f9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_002_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002:4c45e85d-69d3-4850-bd68-3b43658041f9
msgctxt "hc630ed7fg5bf0g4daeg9f3bga5277cbf20ab"
msgid "Ilmater's ashes, but I hope you're half the fighter you look."
msgstr "일메이터시여. 당신이 겉보기 만큼이나 싸움에도 능했으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002
#. Speaker = Harper Grenywald
#. NodeID = 728548a4-990e-dffd-5304-bc1e0ae1988f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_002_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002:728548a4-990e-dffd-5304-bc1e0ae1988f
msgctxt "h85bc0e14g028ag4546gaf9fg59115b39e721"
msgid "We'll hold the rear - you charge ahead."
msgstr "우리가 후방을 맡을테니, 당신은 전진하시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002
#. Speaker = Harper Grenywald
#. NodeID = 8f52bc84-fec3-4702-9502-ea19f0b090d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_002_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_002_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002:8f52bc84-fec3-4702-9502-ea19f0b090d7
msgctxt "hd2275739ge07cg44f5gbe15g008d4fd4ae8c"
msgid "Lead, and we'll follow."
msgstr "앞장서, 그대로 따를테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002
#. Speaker = Harper Grenywald
#. NodeID = fb2f1b68-26f4-4197-910b-addf0447ef9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_002_PostAssault_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_002:fb2f1b68-26f4-4197-910b-addf0447ef9b
msgctxt "h28eedfbbg18a9g4b80g9bc1gcc6598a1a11c"
msgid "Press on. Make this worth it."
msgstr "계속해. 끝장을 봐야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003
#. Speaker = Harper Lilineth
#. NodeID = 0b88569f-51cd-412e-ad9e-9520aad1908d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_003_ThroneRoomDefeated_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_003_ThroneRoomDefeated_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003:0b88569f-51cd-412e-ad9e-9520aad1908d
msgctxt "h26752dc7gb156g4afdgb332g85053179faf5"
msgid ""
"This place... stinks of blood and fear. That is all the <i>Absolute</i> "
"offers."
msgstr "여긴... 피와 공포로 가득하군. <i>절대자</i>한테 달리 기대할 게 있겠냐마는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003
#. Speaker = Harper Lilineth
#. NodeID = 214730c4-3a05-4c6b-b77c-ef692ea2cf7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_003_PostAssault_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_003_PostAssault_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003:214730c4-3a05-4c6b-b77c-ef692ea2cf7c
msgctxt "h842dfd6bg07a9g495ag870cg08b9894398ec"
msgid "Go and do what you must. We'll guard your back."
msgstr "가서 해야 할 일을 해. 우리가 뒤를 보고 있을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003
#. Speaker = Harper Lilineth
#. NodeID = 599925e5-df28-4376-9817-7b57c5eb52c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_003_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003:599925e5-df28-4376-9817-7b57c5eb52c5
msgctxt "h3ca616f4g8fd2g465dg8324g1de259582684"
msgid ""
"A lot of Harpers died stopping Ketheric the first time around. We'll make it "
"stick this time."
msgstr "전에 케서릭을 저지하기 위해 많은 하퍼들이 죽었어. 이번엔 해낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003
#. Speaker = Harper Lilineth
#. NodeID = 76d3e2cc-2717-3eef-c9e6-49e129382816
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_003_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003:76d3e2cc-2717-3eef-c9e6-49e129382816
msgctxt "h68d56a31g00a5g4fcfg9da5g42fef0ba2878"
msgid "I hate it here."
msgstr "맘에 안 드는 곳이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003
#. Speaker = Harper Lilineth
#. NodeID = da46edf0-0d23-4f10-9962-bffc775cd6b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_003_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_003_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003:da46edf0-0d23-4f10-9962-bffc775cd6b6
msgctxt "h616371b4g7ae0g4046ga094g5d89e5028d63"
msgid "We follow."
msgstr "우리는 명을 따른다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003
#. Speaker = Harper Lilineth
#. NodeID = f8d069b5-2cc7-4a09-83c5-72eed5918852
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_003_PostAssault_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_003:f8d069b5-2cc7-4a09-83c5-72eed5918852
msgctxt "h876aeab4g5320g4ab7g8af4ge08a361e08f1"
msgid "Ketheric can hide from us no longer."
msgstr "케서릭은 더 이상 숨을 수 없을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004
#. Speaker = Harper Olys
#. NodeID = 016e7a6d-6167-42bf-9fff-d2189d902916
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_004_ThroneRoomDefeated_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_004_ThroneRoomDefeated_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004:016e7a6d-6167-42bf-9fff-d2189d902916
msgctxt "h1fe824bbgb52bg4dc9ga61fgaa2d6ea15080"
msgid "Gods above, the tadpoles. I think I saw one crawl out of a corpse."
msgstr "신이시여, 올챙이잖아. 시체에서 한 마리가 기어 나오는 걸 본 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004
#. Speaker = Harper Olys
#. NodeID = 050897ab-795e-4c6d-8fc3-7e2b51abcae1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_004_PostAssault_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_004_PostAssault_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004:050897ab-795e-4c6d-8fc3-7e2b51abcae1
msgctxt "hba78da5eg37d3g44f9g8ef2g23d2dc818a86"
msgid "If that army outside stirs, we'll keep them off your back."
msgstr "밖에 모인 군대가 혹시 이쪽으로 움직여도, 우리가 후방을 지켜주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004
#. Speaker = Harper Olys
#. NodeID = 9da0cc4e-d65e-4591-b6e9-c63f437a8ba5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_004_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004:9da0cc4e-d65e-4591-b6e9-c63f437a8ba5
msgctxt "h0f1daa9fg6800g4e42g91b8gf7205bcc12ee"
msgid "Wish I'd used the latrine. Always need to, before a battle."
msgstr "화장실에 좀 갔다올 걸 그랬군. 전투 전에는 항상 볼일을 봐야하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004
#. Speaker = Harper Olys
#. NodeID = b63a28e1-d52b-4096-9b2b-338288d62478
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_004_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultHarper_004_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004:b63a28e1-d52b-4096-9b2b-338288d62478
msgctxt "h82f41f3fgfd1bg4966g86adg5aedbd310562"
msgid "I'll stand, don't you worry. Jaheira's watching, after all."
msgstr "자리를 굳게 지킬테니, 걱정 마. 자헤이라가 지켜보고 있는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004
#. Speaker = Harper Olys
#. NodeID = bd7f7394-e038-6009-04ee-6d51380c6fa0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_004_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004:bd7f7394-e038-6009-04ee-6d51380c6fa0
msgctxt "hbbfa03c2g529bg426dg8de7gd821526c15ff"
msgid ""
"Can't believe you've got one of those worms in your head. Lucky for us "
"you're on our side."
msgstr "너도 머릿속에 벌레가 들어있다는 게 믿기지 않네. 우리 편이라서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004
#. Speaker = Harper Olys
#. NodeID = f03a5fc0-8199-4836-ac7c-57444ab1943a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultHarper_004_PostAssault_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultHarper_004:f03a5fc0-8199-4836-ac7c-57444ab1943a
msgctxt "hf2181563geaddg4af4g85b1g2c8c81efafff"
msgid "Put an end to this. Please."
msgstr "이걸 끝내줘. 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 001d6f52-2331-04a3-d407-f5f396eb9d16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:001d6f52-2331-04a3-d407-f5f396eb9d16
msgctxt "hf55b1a83ge9c7g4568g8fb2g54b06f27209b"
msgid "Wait - Ketheric has surrendered."
msgstr "잠깐, 케서릭은 항복했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 079ebd67-1771-5a60-60e3-986d585750fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:079ebd67-1771-5a60-60e3-986d585750fa
msgctxt "h811a2d7egfdb8g420cg91b2gf32f6e4c54b1"
msgid ""
"You who have begged, stolen, killed - same as I - to make it to this tower?"
msgstr "넌 이곳에 오기까지 빌고, 훔치고, 살인을 저질렀다. 나와 다를 바 없는 네가 결정하겠다는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 07f5f878-0a5b-8524-d126-b01016c081c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:07f5f878-0a5b-8524-d126-b01016c081c7
msgctxt "h7b49f710g0f8cg4378g9831g2896679557a6"
msgid "Seeing one's enemies cowed never gets old."
msgstr "적이 겁에 질린 모습을 보는 건 항상 즐겁다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 09e54f12-ff1c-1ef7-7824-6da6f404f2ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:09e54f12-ff1c-1ef7-7824-6da6f404f2ab
msgctxt "h27f46a7fgeff1g4477gb38bg99b061510d4e"
msgid ""
"You desecrate my halls. Kill my faithful. What heresy twists inside you?!"
msgstr "넌 내 회랑을 더럽히고. 내 종복들을 죽였다. 대체 어떤 이단이 네놈 속에 도사리고 있는 것이냐?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 0aa4dbff-c311-af9a-7676-5e3f5d848bff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:0aa4dbff-c311-af9a-7676-5e3f5d848bff
msgctxt "hcf3094fcgd84ag4f30g9edbg53dc8901614e"
msgid "The gods... We are so little before them. So small."
msgstr "신들... 그들에 비하면 우린 너무 작아. 너무나도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = 1470a968-6d61-f587-66f7-0215e28d2537
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - MOO_Assault_Event_NightsongArrivedRoof = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:1470a968-6d61-f587-66f7-0215e28d2537
msgctxt "hcee11631g78e2g4244gbfe5ge2bec2665187"
msgid "KETHERIC THORM!"
msgstr "<b>케서릭 쏨</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 1a207205-1af0-d515-6d28-83bc0111c359
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:1a207205-1af0-d515-6d28-83bc0111c359
msgctxt "he32b709ag4e51g4135g852bg57e850372fda"
msgid "I am the Chosen - the Chosen. Did you know that?"
msgstr "난 선택받은 자다. 선택받은 자란 말이다. 알고 있었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 1ae2040b-296b-3853-ed1f-523f42584245
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:1ae2040b-296b-3853-ed1f-523f42584245
msgctxt "hf1ae3ee4gf831g4cb8g9952g4c6a6745be0b"
msgid "Aylin. I was hoping you'd come."
msgstr "에일린. 네가 오길 기대하고 있었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = 1d4c90d7-15f0-a0be-d615-f3179bd98791
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:1d4c90d7-15f0-a0be-d615-f3179bd98791
msgctxt "h0b5aca1eg6395g4958gacf8geceb9176fe4a"
msgid "THE GODS FIGHT AT OUR SIDE!"
msgstr "<b>신들께서 우리와 함께 싸울 것이다!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 2525211e-fd07-f45f-49cc-fca66ff3f140
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:2525211e-fd07-f45f-49cc-fca66ff3f140
msgctxt "h5b531023g5408g4c1agb570g0112563cdd0c"
msgid "You're wrong, Ketheric. It isn't too late for you."
msgstr "틀렸어, 케서릭. 아직 늦지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 27380c16-ec8c-1ff5-4f8d-140266cc866f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:27380c16-ec8c-1ff5-4f8d-140266cc866f
msgctxt "h98cea0c8gb3b6g445ag8602g51a7a4d2905a"
msgid "You did this to yourself."
msgstr "네가 자초한 일이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 2e3d2257-b56d-e166-4a55-79481e89bd07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:2e3d2257-b56d-e166-4a55-79481e89bd07
msgctxt "h687f6959g8cddg49c6g9051g6677d98285ef"
msgid ""
"Do what I say. Prostrate yourself before me. For if you do not, your "
"suffering will be worse."
msgstr "내가 시키는 대로 해라. 내 앞에 엎드려 절해. 그렇지 않으면, 고통만 더해질 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 2e66dcb6-670a-d182-f97c-8f10d4e34685
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Assault_State_ConvincedKetheric = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:2e66dcb6-670a-d182-f97c-8f10d4e34685
msgctxt "hf0fdb858gec56g45fdgbec7g3d5c4d396ad6"
msgid "It doesn't make sense. I - I don't understand."
msgstr "말이 안 돼. 난... 난 이해가 가지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 2f419460-f286-4259-5fa3-093be54d088c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:2f419460-f286-4259-5fa3-093be54d088c
msgctxt "h8503d295g2fe8g4f04g999fga79507849b71"
msgid "You're mortal again, Thorm. I've come to finish you."
msgstr "다시 필멸자가 되었구나, 쏨. 널 끝장내러 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 319f9c37-a945-329e-067a-ed3c74b9f411
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:319f9c37-a945-329e-067a-ed3c74b9f411
msgctxt "h12fbe770g5232g4deaga848gb2a3aed45527"
msgid "You were feeding off Nightsong for a century. No longer."
msgstr "넌 밤의 노래를 백 년 동안 뽑아먹었지. 더는 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 3388e107-f2cb-3200-ed18-6e043f3aa841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:3388e107-f2cb-3200-ed18-6e043f3aa841
msgctxt "h218e0fa7gf296g40bdgb230g2b657cef5a76"
msgid "It is better that you bow. Do you hear me? <b><i>BOW!</i></b>"
msgstr "고개를 조아리는 편이 좋을 거다. 알겠나? <b><i>복종해!</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = 39303293-c3d8-d0d6-4340-c0495d2faff1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Global:
#.     - MOO_Assault_Event_NightsongArrivedRoof = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:39303293-c3d8-d0d6-4340-c0495d2faff1
msgctxt "h43b061bagb4adg4d37g98cdgf874326f21a4"
msgid "KETHERIC THORM!"
msgstr "<b>케서릭 쏨</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 40c49029-33b6-1089-b70a-75c53f01c771
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:40c49029-33b6-1089-b70a-75c53f01c771
msgctxt "h32f2ae57g3752g45fdg85a8gff02198ee213"
msgid "Unlike Isobel, he could not be brought back."
msgstr "이소벨과 달리, 그는 되살릴 수 없었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 44e6c7b5-b032-3100-22a5-9a33070c22cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:44e6c7b5-b032-3100-22a5-9a33070c22cc
msgctxt "h841945efg64d3g479bga98bg69a53ef6cfc0"
msgid "Your word's as good as mine, it seems. Very well."
msgstr "네 말도 나의 것만큼이나 일리가 있는 것 같군. 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 44fb8558-bab6-45bd-3c13-384141947c01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:44fb8558-bab6-45bd-3c13-384141947c01
msgctxt "hddef0cb1g1023g48b6g8483g186d843568bd"
msgid "<i>Aylin.</i>"
msgstr "<i>에일린.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 4706b075-88ea-ef26-8971-b421fc0e1099
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:4706b075-88ea-ef26-8971-b421fc0e1099
msgctxt "h64ed5296g9b6bg4383gaa9dg7be193dd7d1f"
msgid "And yet... you have beaten me."
msgstr "하지만 결국... 네가 이겼군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 4866fe41-62f5-4bcd-dfcd-0d6ec675ee7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:4866fe41-62f5-4bcd-dfcd-0d6ec675ee7d
msgctxt "hc2d76635gf8d5g4b3agad5ege2eb1d6ef0b5"
msgid ""
"It has taken a century of misfortune. A century of loss. A century of regret."
msgstr "한 세기의 불운이 이어졌다. 한 세기의 상실이. 한 세기의 후회가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 48db010d-3f6a-856b-da90-e4e0b802d667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:48db010d-3f6a-856b-da90-e4e0b802d667
msgctxt "h66c8b635gbb41g4414g8e71ge6f2b5bf73ab"
msgid "I wish it could be so. I do."
msgstr "나도 그랬으면 좋겠군. 정말로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 4c55f66b-0801-cd7a-6992-c46a46a8c77e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:4c55f66b-0801-cd7a-6992-c46a46a8c77e
msgctxt "he850445dg2a5dg41c0g987cg652e46f73bd2"
msgid "Surrender now, and I'll consider letting you live."
msgstr "지금 항복하면, 너를 살려둘지 고려해 보겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 4dbde33f-e35b-7dfc-a48f-8c8f06f50a78
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:4dbde33f-e35b-7dfc-a48f-8c8f06f50a78
msgctxt "hf0547519g4d43g46e4gb62fg7cb6f50d356e"
msgid ""
"I may or I may not. But if you try to attack me, I <i>will </i>crush your "
"skull."
msgstr "그럴지도, 아닐지도 모르지. 하지만 날 공격하려 했다간, 네 머리를 박살 내주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 4dc5ac07-3ebc-e7a5-81cc-a9a89fb0e5f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:4dc5ac07-3ebc-e7a5-81cc-a9a89fb0e5f4
msgctxt "ha91d5b17g7b34g4b4eg84b6geb4337d55be3"
msgid "I was given - I was told -"
msgstr "내가 받은 건... 내가 들은 건..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 5051f78e-4b9b-566a-ff6b-41850aa55ebb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:5051f78e-4b9b-566a-ff6b-41850aa55ebb
msgctxt "h316bac9dg015bg4836g8793g719bcb922828"
msgid "Nothing frightens me. Not anymore."
msgstr "아무것도 두렵지 않다. 더는 두렵지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 52a5658a-d838-73b0-0547-0b15de9fc3e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:52a5658a-d838-73b0-0547-0b15de9fc3e4
msgctxt "he34060efg6019g4b6dg8d1fgca62d6883df2"
msgid ""
"I was a fool to hesitate. Power like mine cannot be hidden, cannot be cowed. "
"But power like mine has a price. A price I am destined to pay."
msgstr ""
"망설이다니 내가 바보였어. 내가 가진 힘은 숨길 수도 굴복시킬 수도 없지. 하지만 이런 힘에는 대가가 있고. 필연적으로 대가를 치르게 "
"되어 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 541da085-4d21-12ae-f376-6ee44b43cf12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:541da085-4d21-12ae-f376-6ee44b43cf12
msgctxt "h6ae0a64eg6e70g4533g8688g9fde61eff6a6"
msgid ""
"It was destined to come to this. The power I've accrued. The enemies I've "
"cowed. Returned to me at last. Returned to me for the final time."
msgstr "결국 이렇게 될 운명이었다. 내가 얻은 힘. 내가 굴복시킨 적. 마침내 내게 돌아왔군. 마지막으로 돌아왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 583d357e-f315-249a-f8a1-4a02afca18d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:583d357e-f315-249a-f8a1-4a02afca18d3
msgctxt "hb38a6de5g6357g4dd2g933ageaf0f3568acd"
msgid "I can help you, Ketheric - if you let me."
msgstr "내가 당신을 도울 수 있어, 케서릭. 허락하기만 한다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 5d29fa8a-f775-97c3-0e15-8b05b980c6b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:5d29fa8a-f775-97c3-0e15-8b05b980c6b0
msgctxt "h53c1ae09g47f2g4cefgbbbcgdbfb39182677"
msgid "This is no spectacle. This is payment."
msgstr "이건 과시가 아니야. 지불이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 5d456f7c-ddba-4945-8b57-f69d3327dd4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:5d456f7c-ddba-4945-8b57-f69d3327dd4f
msgctxt "hd4be408dg22fag4a37g9ea5ga787d63cc40f"
msgid ""
"My life was dismantled piece by piece. First my wife was taken - my <i>wife</"
"i>! And then my beautiful daughter. My life was forfeit. Gone. Finished."
msgstr ""
"내 삶은 갈가리 조각났다. 처음엔 내 아내를 데려갔지, 내 <i>아내</i>를! 그다음은 내 아름다운 딸이었어. 내 삶은 몰수당했다. "
"사라졌지. 완전히 끝장났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 5e4ceeae-0f57-4bb7-f463-ee9138b0de12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:5e4ceeae-0f57-4bb7-f463-ee9138b0de12
msgctxt "h92d2ac5eg1058g4aa3gbb03g476764cac3f2"
msgid "And <i>you </i>will decide what is right?"
msgstr "뭐가 옳다고 생각하는 건 <i>네가 </i> 결정하고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 61119adf-469a-172f-1f08-4bc49604e918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:61119adf-469a-172f-1f08-4bc49604e918
msgctxt "hbf1f0752gcbbag44d0g8f54gf947f517ed8b"
msgid ""
"The Prism. You've had it all this time - you <i>worm</i>! You will bow "
"before me. And if you will not bow, you will <i>break</i>."
msgstr ""
"프리즘. 여태껏 네가 갖고 있었군, 이 <i>벌레새끼</i> 같으니! 내 앞에 무릎 꿇으라. 꿇지 않는다면, <i>쓰러질</i> 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = 6473cf05-78ec-2b5d-d78a-a3ffdf701d1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:6473cf05-78ec-2b5d-d78a-a3ffdf701d1e
msgctxt "h2597c0dcg5f07g43f6ga99bg38a14d241a33"
msgid ""
"Ha! Ha! Free from your shackles; free from the pets you sicced on me for a "
"hundred years. Do I frighten you, old man?"
msgstr "하! 하! 백 년 동안 날 통제하던 족쇄, 날 괴롭히던 네 애완동물로부터 풀려났다. 내가 두려운가, 늙은이?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 649209a2-4d31-2e3b-f96f-1e1a0d3a68a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:649209a2-4d31-2e3b-f96f-1e1a0d3a68a9
msgctxt "hc2331f70gec02g4a4bgbea8g5006e195c406"
msgid "This is your end, General Thorm. Face me, and die with dignity."
msgstr "이게 네 끝이다, 쏨 장군. 나에게 맞서고, 품위를 지키며 죽어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 650b4c1f-b505-2888-c84e-dba3e46c7827
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:650b4c1f-b505-2888-c84e-dba3e46c7827
msgctxt "h765e600cga0ceg4a4dgb702g20d56096785f"
msgid "And now... perhaps it is over."
msgstr "그리고 이젠... 이젠 끝인지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 68912cc7-a888-a917-d4a4-a4eb5881f5a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:68912cc7-a888-a917-d4a4-a4eb5881f5a5
msgctxt "hb2520e1bg48ddg4f40gaba4g39eec3cb72b7"
msgid ""
"The Prism. You've had it all this time - you <i>worm</i>! You will bow "
"before me. And if you will not bow, you will <i>break</i>."
msgstr ""
"프리즘. 여태껏 네가 갖고 있었군, 이 <i>벌레새끼</i> 같으니! 내 앞에 무릎 꿇으라. 꿇지 않는다면, <i>쓰러질</i> 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 6903cd73-921f-4357-36c8-f4f693f85a97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:6903cd73-921f-4357-36c8-f4f693f85a97
msgctxt "hd49fea1fg5757g486dgbbb8g544dec110efc"
msgid "Enough! This ends here and now - at last."
msgstr "그만! 마침내, 지금 여기서 모든 걸 끝내겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 6aaecd98-3603-d470-edba-d9585957a443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:6aaecd98-3603-d470-edba-d9585957a443
msgctxt "he1423359g57efg4d8fg88dcgf1da9ec3aae4"
msgid ""
"How dare you interfere? You are like the digits of a hand - it is for you to "
"<i>act</i>, not to <i>decide</i>."
msgstr "네가 감히 방해해? 넌 장기 말에 불과해, 넌 <i>시키는 대로</i> 할 뿐이다, <i>결정</i>을 내리는 게 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 6ff0f9ea-fe43-4b5f-f450-d834fc9a3472
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:6ff0f9ea-fe43-4b5f-f450-d834fc9a3472
msgctxt "h3ba3a447g05cag4bdbga245g3f140d755ae8"
msgid "We are copper pieces in their belts. Tokens to be traded for scraps."
msgstr "우린 그들의 허리띠에 있는 구리 조각에 불과해. 고철로 팔려나가는 징표일 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 7100a17e-878e-ac7d-adfb-95a06f24370e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:7100a17e-878e-ac7d-adfb-95a06f24370e
msgctxt "h310c94f4g4476g46f6g8920g456f866cc486"
msgid ""
"You serve the Absolute. You. Serve. ME! Bow, you dog. <b><i>BOW!</i></b>"
msgstr "너는 절대자를 섬긴다. <b>나를</b>. 섬긴단. 말이다! 고개를 숙여라, 이 개자식아. <b><i>복종해라!</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 71a6bba1-d61a-3a91-74f1-77779ab4a8bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:71a6bba1-d61a-3a91-74f1-77779ab4a8bc
msgctxt "h61ca776age682g46bag9ef6g6578988d2cb2"
msgid ""
"But the Moonmaiden did not intervene when my life was dismantled piece by "
"piece."
msgstr "하지만 내 삶이 처참히 조각날 때, 달처녀는 관여하지 않았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 7295d20a-a187-317e-dee1-ebb28ffd83fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:7295d20a-a187-317e-dee1-ebb28ffd83fd
msgctxt "h60c9e360gdb06g4919gadb3g0484f939557e"
msgid ""
"Let us finish this, Aylin. I have a price to pay for my power. It will cost "
"me your life - for my own, I have already paid."
msgstr "여기서 끝을 보자, 에일린. 난 내 힘의 대가를 치러야 해. 네 삶을 바쳐야 한다. 나의 삶은 이미 바쳤으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 755dada4-7210-6e6f-bf85-3d202700f089
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Assault_Event_BossFightDialogStarted = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:755dada4-7210-6e6f-bf85-3d202700f089
msgctxt "hb367d6d9gc152g4798g86d0gbad0be1eada8"
msgid "YOU! What have you done?! What have you done to me?!"
msgstr "<b>너!</b> 무슨 짓을 한 거냐?! 나한테 무슨 짓을 한 거야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 7881e327-0dbc-4773-7217-88cdde7ffbd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:7881e327-0dbc-4773-7217-88cdde7ffbd7
msgctxt "h09dc4a4bg98bdg4225g8383gb981630d8d32"
msgid ""
"If Melodia could see all I've done, she'd know... she'd know her husband "
"died long ago, with Isobel."
msgstr ""
"멜로디아가 내가 벌인 모든 일들을 본다면, 그녀는 깨달을 거야... 그녀의 남편은 이미 오래 전, 이소벨과 함께 세상을 떠났다는 것을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 791ad352-1ed3-6740-3997-7cf2ed934dd4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Assault_State_ConvincedKetheric = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:791ad352-1ed3-6740-3997-7cf2ed934dd4
msgctxt "hc549fa8dg5bcdg4560gb2cegdc32ab00f4e0"
msgid ""
"We're not so different, it seems. We both want what we want, and no "
"opposition, no resistance will prevent us."
msgstr "결국, 우리 둘은 그리 다르지 않은 것 같군. 원하는 것은 얻어야 하는 거야, 어떤 반대도, 어떤 저항도 우릴 막을 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 7a4b7f34-6170-6d72-5660-6344b4b84850
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_InProgress = True
#. SetFlags:
#.   Global:
#.     - MOO_Assault_Event_BossFightDialogStarted = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:7a4b7f34-6170-6d72-5660-6344b4b84850
msgctxt "h1c355c2dg1bfdg41bcgb9b5gad22c60d69bd"
msgid "YOU! What have you done?! What have you done to me?!"
msgstr "<b>너!</b> 무슨 짓을 한 거냐?! 나한테 무슨 짓을 한 거야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 7a6c88f7-68dc-dcbd-4ed5-deb7ca583827
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:7a6c88f7-68dc-dcbd-4ed5-deb7ca583827
msgctxt "h05050efbg487cg49a0g89d7g8bcb531dc713"
msgid "Come quietly, and you'll be spared."
msgstr "조용히 따라오면, 목숨은 살려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 8bb71256-d22c-dcd3-ee00-60c09c55d804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:8bb71256-d22c-dcd3-ee00-60c09c55d804
msgctxt "hc1ea417cgff45g40c2gb154g7eec74f013a5"
msgid "And mine."
msgstr "그리고 나의 것이기도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = 8d5d5087-861d-8bf0-14f0-1026ed06a184
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:8d5d5087-861d-8bf0-14f0-1026ed06a184
msgctxt "hbc88209agc602g4b0dg841ag4a2a7373adf0"
msgid "Rise, you dog! Retribution has come, and her sword is my sword!"
msgstr "일어나, 이 개자식! 응징이 찾아왔다, 그리고 그녀의 검이 나의 검이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 91198cf6-f9c0-0218-cd9d-bb37a8344249
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:91198cf6-f9c0-0218-cd9d-bb37a8344249
msgctxt "h3ca05b3fg2a3bg428fg888eg2a26f882f1a0"
msgid "It isn't too late, Ketheric. Your story doesn't end here."
msgstr "아직 늦지 않았어, 케서릭. 당신 이야기는 아직 끝나지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = 99ca871c-dfac-b34b-31a5-581c126e8815
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:99ca871c-dfac-b34b-31a5-581c126e8815
msgctxt "h081a036bg1d87g4275ga791gb1422ac001f7"
msgid "I'm not like you, Ketheric. My only interest is what is <i>right</i>."
msgstr "난 당신과 달라, 케서릭. 난 <i>옳은</i> 일을 할 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 9c4b9925-3578-5e2b-cea3-be4779576a54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:9c4b9925-3578-5e2b-cea3-be4779576a54
msgctxt "h02ecda35g6d77g40c8gb4cag328910f5be6f"
msgid ""
"<i>Live? </i>You misunderstand me, True Soul. And it will be your undoing."
msgstr "<i>살려줘? </i>나를 모르는군, 참된 영혼. 그리고 그게 바로 네 파멸의 원인이 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = 9d6d8dcf-d7fa-ca07-0223-b174c6f5312e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Assault_Event_NightsongArrivedRoof = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:9d6d8dcf-d7fa-ca07-0223-b174c6f5312e
msgctxt "hf4de3920gd9f0g42c2ga37dg94f3b7dc51b3"
msgid ""
"How good it is to see you again, Ketheric. At last you've found a god-master "
"that suits you, it seems."
msgstr "널 다시 보니 얼마나 기쁜지 몰라, 케서릭. 보아하니 드디어 네게 어울리는 주인 신을 정했나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = 9ecc536e-a07b-1000-bcab-8640c54f9fb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:9ecc536e-a07b-1000-bcab-8640c54f9fb7
msgctxt "h5b62519fg37edg4297gbeabg4c05cbfa14bb"
msgid "And when I tried to buy it back, it cost me everything - everything."
msgstr "그리고 그 삶을 되찾으려 했을 때, 그 대가로 난 모든 것을 바쳤어. 모든 것을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = a1b9a11b-163a-357c-4e90-16f687954348
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:a1b9a11b-163a-357c-4e90-16f687954348
msgctxt "h93049530gfc9dg4de1g9f58g9378cce4426b"
msgid ""
"You've come this far. You've stripped your enemy of his advantage. Why would "
"you show mercy now?"
msgstr "여기까지 와놓고, 승리를 코 앞에 뒀는데. 어째서 지금 자비를 보이겠다는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = a2a7f96e-4ca8-7f2f-f201-3989b7746e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:a2a7f96e-4ca8-7f2f-f201-3989b7746e3b
msgctxt "he455c646gd3aag45d2gaefagf96db72513ed"
msgid ""
"You dare to speak her name? After your crimes innumerable, you would evoke "
"her before <i>me</i>?"
msgstr "감히 그녀의 이름을 입에 담아? 그토록 많은 범죄를 저지르고도, 감히 <i>내</i> 앞에서 그녀의 이름을 말해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = a3f51079-36c8-4514-16e7-c0010dca3640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:a3f51079-36c8-4514-16e7-c0010dca3640
msgctxt "h28522fcdge085g4b55g9c3fg0258103ffaed"
msgid "You have beaten me, True Soul. But the gods beat me first."
msgstr "네가 날 무너뜨렸다, 참된 영혼. 하지만 난 이미 신들의 손에 무너졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = a4ad50b8-2683-855d-fc00-dcaf295bc8c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:a4ad50b8-2683-855d-fc00-dcaf295bc8c1
msgctxt "h4306d115g4e34g49d3ga520g1ffe44dcb718"
msgid "<i>Stand back and watch.</i>"
msgstr "<i>물러서서 지켜본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = a59eda65-dd42-5cec-7f43-123c7f6bff7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:a59eda65-dd42-5cec-7f43-123c7f6bff7a
msgctxt "hc91cdb88gcbd2g4d5fg8b2bgfe52005ab284"
msgid ""
"I gave up everything. My family. My life. I cannot stop here. I must finish "
"what I started. One way or another."
msgstr "난 모든 것을 포기했어. 내 가족. 내 삶. 여기서 멈출 수는 없다. 내가 시작한 일을 끝내야 해. 어떻게 해서든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = a80f5ccd-fc40-621b-28bf-3a5cb4fd5b54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:a80f5ccd-fc40-621b-28bf-3a5cb4fd5b54
msgctxt "h69022352gb817g4298g98fag094e4add36d9"
msgid ""
"The Prism. You've had it all this time - you <i>worm</i>! You will bow "
"before me. And if you will not bow, you will <i>break</i>."
msgstr ""
"프리즘. 여태껏 네가 갖고 있었군, 이 <i>벌레새끼</i> 같으니! 내 앞에 무릎 꿇으라. 꿇지 않는다면, <i>쓰러질</i> 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = a8cebf13-d5da-111c-4c6f-155e801a40f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:a8cebf13-d5da-111c-4c6f-155e801a40f8
msgctxt "ha1b53b31g20beg44dagabb5gbcb502cf7b40"
msgid "He will crumble at the power of your touch - give him all you have."
msgstr "그는 네가 가진 힘에 무너질거야. 너의 모든 것을 쏟아부어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = abb19de6-7ced-f4ac-f81e-77088878b8a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:abb19de6-7ced-f4ac-f81e-77088878b8a1
msgctxt "he0506131g4102g4caagb76cgda2918d7bd58"
msgid ""
"You attempt to intrude upon my heart? To destroy me from within? No, True "
"Soul. You forget yourself."
msgstr "내 마음에 침입하려고 시도하는 것인가? 내면에서 나를 파괴하려고? 아니, 참된 영혼이여. 주제를 모르는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = abe3cc68-26af-de70-7f45-a28000c8add6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:abe3cc68-26af-de70-7f45-a28000c8add6
msgctxt "h550c1c2bg4052g4e5egad05ga4575fee8149"
msgid "<i>Liar!</i>"
msgstr "<i>거짓말!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = b1d9e418-248b-c2d0-b9bf-27e4e8e36639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:b1d9e418-248b-c2d0-b9bf-27e4e8e36639
msgctxt "h9a1d6b05g1ee4g476dgb5a8g152dcb53fa19"
msgid ""
"I will not be threatened by a thrall. A slave. A mere finger in the fist "
"that will crush who and when <i>I demand</i>."
msgstr ""
"노예 따윈 내게 위협이 되지 않는다, 졸개여. 손가락 하나만 까딱하면 누구든 <i>명령하는</i> 즉시 부숴버릴 수 있단 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = b5869df6-e1f8-ebdb-4b4a-0d73f389be20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:b5869df6-e1f8-ebdb-4b4a-0d73f389be20
msgctxt "h4e1dadc5ge6cdg4d29gaa13g21535efd0345"
msgid "I haven't forgotten her embrace. Melodia's. Nor Selûne's."
msgstr "멜로디아의 포옹은 잊지 않았다. 셀루네도 마찬가지지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = bef5572e-8d6c-5cd5-90b6-630a085dc4c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:bef5572e-8d6c-5cd5-90b6-630a085dc4c3
msgctxt "hc1e2ae91g85c3g4337g8378g68147d02de4c"
msgid "Impossible. You are a thrall - a slave!"
msgstr "말도 안 돼. 네놈은 노예다. 졸개란 말이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = bfa038d3-cd9c-4578-9ec1-543d33d8ace0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:bfa038d3-cd9c-4578-9ec1-543d33d8ace0
msgctxt "hac247726ga2f5g4736g9866g95085184a102"
msgid ""
"Aylin. The <i>thief</i>. You stole Isobel from me, and now you think you'll "
"take my life in the bargain?"
msgstr "에일린. 망할 <i>도둑년</i>. 이소벨을 내게서 훔쳐가더니, 이제 내 목숨까지 거둬갈 생각인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = c43eb66f-915f-69e4-21ab-cd1a47b635db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:c43eb66f-915f-69e4-21ab-cd1a47b635db
msgctxt "h2de7472bg96bbg4c8agbdaagf0c64b5b498e"
msgid ""
"Melodia is waiting for you in the afterlife. Return to Selûne, and your "
"souls will be reunited."
msgstr "멜로디아가 죽음 후의 세상에서 널 기다리고 있어. 셀루네에게 돌아가, 그러면 너희 영혼이 재결합할 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = c5c14630-3884-4cdd-b313-1a43a0b4b197
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - MOO_KethericsChambers_Knows_KethericsWife = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:c5c14630-3884-4cdd-b313-1a43a0b4b197
msgctxt "hb9a1aaaag9e60g4dacgb144gcba6dfc09237"
msgid ""
"Melodia wanted more for you than this, Ketheric. Stop, and you may redeem "
"yourself yet."
msgstr "멜로디아는 네게 이런 모습을 원치 않았어, 케서릭. 멈춰. 아직 너 스스로를 구원할 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = c858ffaa-59d5-0571-1f3b-6638ea8dc5ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:c858ffaa-59d5-0571-1f3b-6638ea8dc5ba
msgctxt "h443a5e65g69ceg420ag9771g0e409dedf0f2"
msgid "Listen to yourself. A mouse who fancies itself an eagle."
msgstr "허튼소리 마라. 생쥐가 독수리인 척을 하고 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = c9a1d905-edfe-1424-abe6-846315f1c3fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:c9a1d905-edfe-1424-abe6-846315f1c3fe
msgctxt "h332b507agb3b1g4716g85acgabc0cb73c20b"
msgid "<i>You.</i>"
msgstr "<i>네놈.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = db169485-0420-7b30-9db4-61861dfb1197
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:db169485-0420-7b30-9db4-61861dfb1197
msgctxt "h2aeb8bfdg6862g47ffgb4b0g01d1e1cea0d3"
msgid "A higher power wants you to live."
msgstr "더 높은 힘이 당신을 살려두길 원해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = dc56d784-c9c8-38fb-c18b-9a529de9ee3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:dc56d784-c9c8-38fb-c18b-9a529de9ee3f
msgctxt "he339d590g2746g41d1gb175g2373f84fff8e"
msgid "So you'll continue this spectacle of violence? To what end?"
msgstr "그래서 이렇게 폭력을 계속 과시하겠다고? 어째서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = decf0fb0-4732-9e1f-b6e3-63ce0a3ee608
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:decf0fb0-4732-9e1f-b6e3-63ce0a3ee608
msgctxt "he7332505g4ea7g49b7ga6a6g0d6487c32ebc"
msgid ""
"I think not, True soul. You serve the Absolute. You serve <i>me</i>. Bow, "
"you dog. <b><i>BOW!</i></b>"
msgstr ""
"그렇지 않다, 참된 영혼. 절대자에게 복종해라. 넌 <i>내게</i> 복종해야 한다. 꿇어라, 이 개자식아. "
"<b><i>꿇어!</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = e2838f8a-f22b-13ef-a421-ece442cef02f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Assault_State_ConvincedKethericWithMelodia = True
#.     - MOO_Assault_State_ConvincedKetheric = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:e2838f8a-f22b-13ef-a421-ece442cef02f
msgctxt "he1cac7dcg05ceg4ea1gb74agdaccd7ddb587"
msgid "There is no redemption. Can't you see? It is too late."
msgstr "구원 따위 없어. 모르겠나? 이미 너무 늦었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = e50bb4e7-b7db-3550-1a94-a31a5966b32c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:e50bb4e7-b7db-3550-1a94-a31a5966b32c
msgctxt "h61ef0cd5gb43eg4c74gb7cagbc9b73f8213c"
msgid ""
"Haven't you figured it out by now, True Soul? I do not serve the Absolute. "
"The Absolute serves <i>me</i>. Bow, you dog. <b><i>BOW!</i></b>"
msgstr ""
"아직도 모르겠나, 참된 영혼? 난 절대자를 섬기지 않는다. 절대자가 <i>나를</i> 섬기지. 고개를 조아려라, 개자식. "
"<b><i>복종하란 말이다!</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = e63821cb-53b5-48ff-3489-72dd7ed37287
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:e63821cb-53b5-48ff-3489-72dd7ed37287
msgctxt "h5ee90065g671eg471eg9108g330d71a21428"
msgid "Bow before me - before the Absolute! <b><i>BOW!</i></b>"
msgstr "내 앞에 고개를 조아려라, 절대자 앞에 무릎 꿇으란 말이다! <b><i>복종해!</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = eea0ec66-bdb1-16e7-b6b2-d8f58c4113be
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Assault_State_ConvincedKetheric = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:eea0ec66-bdb1-16e7-b6b2-d8f58c4113be
msgctxt "h94cf12aeg72c1g437egbe26g6add763b285a"
msgid ""
"Who decides what is right? The gods did not care for right and wrong when "
"they dismantled my life piece by piece."
msgstr "무엇이 옳은지는 누가 결정하지? 내 삶을 무참히 조각날 때, 신들은 뭐가 옳고 그른지 따위는 관심도 주지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = f158c53a-6fc3-d4f8-ea5b-4df00a5815ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:f158c53a-6fc3-d4f8-ea5b-4df00a5815ea
msgctxt "h5e3f6376g1879g4c78gaf86gfca3334a7a8c"
msgid "A <i>pawn</i> cannot lecture the Chosen of the gods."
msgstr "<i>장기 말</i> 따위가 신들에게 선택받은 자에게 설교할 수는 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Ketheric Thorm
#. NodeID = f314d2ee-452b-8d40-c9d8-30ec11259d01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:f314d2ee-452b-8d40-c9d8-30ec11259d01
msgctxt "h4b80126ege5b7g4cbbg8ba9g184f245c5a98"
msgid ""
"You have one last chance to bow. Once it's gone, I'll have no choice but to "
"destroy you both. Do you hear?! <b><i>BOW!</i></b>"
msgstr ""
"마지막으로 고개를 숙일 기회를 주지. 이번에도 따르지 않겠다면, 너희 둘 다 파괴하는 수 밖에. 알겠나?! "
"<b><i>복종해라!</i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Player
#. NodeID = f475f158-baee-3dcf-6a04-42ca2917d5dc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:f475f158-baee-3dcf-6a04-42ca2917d5dc
msgctxt "ha993ba8bg58ffg442bg98begaf6f84989dea"
msgid ""
"You've seen what I'm capable of. Surrender now, and I'll consider letting "
"you live."
msgstr "내가 뭘 할 수 있는지 봤을 테지. 지금 항복하면 널 살려주는 걸 진지하게 고민해볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro
#. Speaker = Nightsong
#. NodeID = fab77c55-2877-0c4e-0a48-1c24b1b1111f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_BossFightIntro:fab77c55-2877-0c4e-0a48-1c24b1b1111f
msgctxt "h8aef41d7gf8cfg44aaga3ecgfc404de421cc"
msgid ""
"Ha! Ketheric Thorm would sooner die than lay down his rank cause. Isn't that "
"right, <i>General</i>?"
msgstr "하! 케서릭 쏨은 자기 목적을 포기하느니 죽어버릴 거야. 그렇지 않나, <i>장군</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA
#. Speaker = Narrator
#. NodeID = 3250f8ba-7280-00a8-34df-e63be1f46b19
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_HasMet_KethericHound(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA:3250f8ba-7280-00a8-34df-e63be1f46b19
msgctxt "h1e139dc6g30b3g4fd8gbeafg1684f33cdd70"
msgid ""
"*Her mournful eyes take in every detail of the room, but the hound looks "
"right through you. She's lost in thoughts and memories.*"
msgstr ""
"*슬픔에 잠긴 그녀의 눈길이 방 구석구석을 살핍니다. 그러나 사냥개는 당신을 꿰뚫어봅니다. 그녀는 상념과 추억에 잠겨 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA
#. Speaker = Squire
#. NodeID = 541dfce7-5b47-3771-1ee6-4363351d603e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_HasMet_KethericHound(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA:541dfce7-5b47-3771-1ee6-4363351d603e
msgctxt "hf66a7afag177dg4ab3gafd6g41b5629caebd"
msgid "That scent - the Selûnite magic on your skin - it fills this place."
msgstr "그 냄새, 셀루네 마법이로군. 피부를 감싼 그 냄새가 이 곳을 가득 채우고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA
#. Speaker = Squire
#. NodeID = 702017b8-3a30-b408-c949-adeeee47c70b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA:702017b8-3a30-b408-c949-adeeee47c70b
msgctxt "h2e25de93gd7b4g4d0fgafc7g0b324df709a2"
msgid ""
"It fills my head with things I miss. I cannot remember them, but I do miss "
"them."
msgstr "내 머리 속도 그리운 무언가로 가득 채워지고 있군. 뭔지는 기억이 안나지만, 정말 그리워하던 것들이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA
#. Speaker = Narrator
#. NodeID = dcd5e929-f1f8-2ab0-19eb-7dd17b7c1488
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_HasMet_KethericHound(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA:dcd5e929-f1f8-2ab0-19eb-7dd17b7c1488
msgctxt "h2aac6b64gdcadg43afga00fgf03dba6417b0"
msgid ""
"*The sounds of battle do not disturb the creature. She seems to be in "
"another time, another place.*"
msgstr "*전투의 소음은 이 크리쳐를 방해하지 못합니다. 마치 다른 시간, 다른 장소에 있는 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA
#. Speaker = Squire
#. NodeID = f88521a7-0547-75eb-d604-0ae20874b7d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_HasMet_KethericHound(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_CrestfallenHound_SwA:f88521a7-0547-75eb-d604-0ae20874b7d7
msgctxt "h9599bbb1gbc81g422cgaeffg46af565f4e5d"
msgid ""
"I know the battle is outside, but there's peace here. And I'm tired of "
"fighting."
msgstr "밖에서 전투가 벌어지고 있다는 건 알지만, 여긴 평화롭지. 이제 싸우는 건 질색이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = e5131e13-0b08-4913-ad51-644e6c72c138
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:e5131e13-0b08-4913-ad51-644e6c72c138
msgctxt "h18598f31g464eg4b1cg9dccg0507756755f2"
msgid "Careful. Whatever that was, it was immensely powerful."
msgstr "조심해. 뭔지는 몰라도, 어마어마하게 강력했으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric
#. Speaker = GROUP_Daisy
#. NodeID = 60433bb9-aa9f-ea2b-5874-735300f68399
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Daisy_Interacted = True
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric:60433bb9-aa9f-ea2b-5874-735300f68399
msgctxt "h17182fc8gf560g4ab3gb2bbg7f10931a09c9"
msgid ""
"That tentacle was colossal. The same creature we encountered before. We must "
"follow where it went."
msgstr "저 촉수는 정말 거대했어. 이전에 맞닥뜨린 괴물이었지. 저 괴물을 뒤쫒아가야해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise
#. Speaker = GROUP_Daisy
#. NodeID = e5131e13-0b08-4913-ad51-644e6c72c138
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_WallTentacle_DaisyAD_FeignSuprise:e5131e13-0b08-4913-ad51-644e6c72c138
msgctxt "h30f55c98g8d2eg4bb1g835fg51cf50783dab"
msgid "Careful. Whatever that was, it was immensely powerful."
msgstr "조심해. 뭔지는 몰라도, 어마어마하게 강력했으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric
#. Speaker = GROUP_Daisy
#. NodeID = 60433bb9-aa9f-ea2b-5874-735300f68399
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Daisy_Interacted = True
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric:60433bb9-aa9f-ea2b-5874-735300f68399
msgctxt "h368f01fagab9eg4e8eg9cc4g474a1e928fbc"
msgid ""
"That tentacle was colossal. The same creature we encountered before. We must "
"follow where it went."
msgstr "저 촉수는 정말 거대했어. 이전에 맞닥뜨린 괴물이었지. 저 괴물을 뒤쫒아가야해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric
#. Speaker = GROUP_Daisy
#. NodeID = ad2531e0-0b18-4336-9a0f-b29d31904dda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Daisy_Interacted = False
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric:ad2531e0-0b18-4336-9a0f-b29d31904dda
msgctxt "hd2ffc533gb83bg4a20ga34fg6023f7e3169b"
msgid "That tentacle was colossal. How can such a thing be possible?"
msgstr "엄청 큰 촉수였는데. 어떻게 그런 일이 가능하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric
#. Speaker = GROUP_Daisy
#. NodeID = ad2531e0-0b18-4336-9a0f-b29d31904dda
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Daisy_Interacted = False
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DaisyAD_FollowKetheric:ad2531e0-0b18-4336-9a0f-b29d31904dda
msgctxt "h1cfa6ae9g6412g403fga5e7g311e7412f87f"
msgid "That tentacle was colossal. How can such a thing be possible?"
msgstr "엄청 큰 촉수였는데. 어떻게 그런 일이 가능하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder
#. Speaker = Sceleritas Fel
#. NodeID = 04da3409-9d69-7a72-d813-ddec2fa745b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_DarkUrge_Butler_HasMet(1) = False
#.   Object:
#.      - ORI_DarkUrge_State_ButlerKiller(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_DarkUrge_Butler_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder:04da3409-9d69-7a72-d813-ddec2fa745b5
msgctxt "hfbe93146g7e1fg41c6g8f8dg9e0cbc9e8ddc"
msgid "Fine day to storm a tower! Carry on! Don't mind a frail old Butler."
msgstr "타워를 공격하기에 딱 좋은 날입니다! 계속하십시오! 늙고 허약한 집사는 신경 쓰지 마십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder
#. Speaker = Sceleritas Fel
#. NodeID = 175f3cc2-7602-d80f-80d4-3f33a19f997a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_DarkUrge_Butler_HasMet(1) = True
#.   Object:
#.      - ORI_DarkUrge_State_ButlerKiller(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder:175f3cc2-7602-d80f-80d4-3f33a19f997a
msgctxt "h4b33c2aagc95fg4bedg8f16gae7b60501134"
msgid "I'll be no trouble! Back on the warpath with you!"
msgstr "전 신경 쓰지 마세요! 어서 전장으로 돌아가세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder
#. Speaker = Sceleritas Fel
#. NodeID = 96c0a0a4-1c68-732d-345f-6f3d2f2e96c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_DarkUrge_State_ButlerKiller(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_State_ButlerKiller(1) = False
#.   User:
#.     - ORI_DarkUrge_Knows_ButlerDiedReaction(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder:96c0a0a4-1c68-732d-345f-6f3d2f2e96c4
msgctxt "haa5b970dg48c7g44c1g8157g3d888749a082"
msgid ""
"That was rather rude, wasn't it? To assume I am content to be killed by one "
"of low breeding."
msgstr "꽤나 무례한 짓이라고 생각하지 않나? 이 몸이 천한 잡종 손에 죽으리라 생각했다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder
#. Speaker = Sceleritas Fel
#. NodeID = a6c7a3a6-70d1-7747-1f65-86f61fa9cd49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_DarkUrgeButlerReminder:a6c7a3a6-70d1-7747-1f65-86f61fa9cd49
msgctxt "h63ede6c0g32aeg495fg949bg9512d9ebad3b"
msgid "I want you to go away, and think about what you did."
msgstr "저리 가서 스스로 무슨 짓을 한 건지 돌아보도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 0d433d33-a6d1-4735-6ba4-0d4f93a56664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:0d433d33-a6d1-4735-6ba4-0d4f93a56664
msgctxt "hbc75fdffg45b5g45begab87g40a172c8e9bb"
msgid ""
"How funny. How <i>sad</i>. You think you're going to survive this, don't you?"
msgstr "얼마나 웃기는지. 얼마나 <i>가련한지.</i> 살아남을 수 있을 거라고 생각하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = 14174c81-d5b8-5fb9-343d-d803639e8edb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:14174c81-d5b8-5fb9-343d-d803639e8edb
msgctxt "h9d6e88b8g4dd8g45b6ga3b9gd22c83799d09"
msgid "Ketheric is already in hiding. He left you to die."
msgstr "케서릭은 이미 숨었다. 너를 죽게 버려둔 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 16f21488-9151-9182-a0f9-b7b7ab7bc514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:16f21488-9151-9182-a0f9-b7b7ab7bc514
msgctxt "hfb6ffe7dga335g4928g806dgf1a241e2fa7d"
msgid ""
"You hid it well. I thought you'd be another notch on my bedpost, but instead "
"I'll make a trophy of your bones."
msgstr ""
"진의를 잘도 숨겼구나. 원래 나는 네가 내 침대 머리맡에 새겨놓는 빗금 한 줄로 생을 마감하리라 생각했다만. 그 대신에 네 뼈를 "
"전리품으로 삼아야겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Nightwarden Minthara
#. NodeID = 1968e34d-6e0c-c040-67c3-2938964f2d08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:1968e34d-6e0c-c040-67c3-2938964f2d08
msgctxt "h4b97bd37g1677g402fgbe87ge86fdd552b1f"
msgid ""
"There will be no retribution, Z'rell. Only vengeance - and that shall be "
"mine."
msgstr "처벌 따윈 없어, 즈렐. 복수뿐이지 - 그리고 그건 내 복수가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Nightwarden Minthara
#. NodeID = 1b33108a-db40-582d-cca3-81ad6301624b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:1b33108a-db40-582d-cca3-81ad6301624b
msgctxt "hc1bc08e3g58abg466bg9146g8830b9875372"
msgid "The Absolute's regard is poison, Z'rell."
msgstr "절대자의 고평가는 독이 될 뿐이야, 즈렐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = 1f52f835-621c-be21-2f23-ec59f8af7dbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:1f52f835-621c-be21-2f23-ec59f8af7dbf
msgctxt "h07560fb9gb961g40b7ga770gfbcf7bbb100e"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 2241a702-c0de-be92-be82-023f5eae19a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:2241a702-c0de-be92-be82-023f5eae19a4
msgctxt "hdd4fa3eeg10dfg49aegb314gfd6e60ca5f25"
msgid ""
"You've turned your back on our Chosen in the most heinous way. And our "
"retribution will be terrible."
msgstr "가장 악랄한 방식으로 우리의 선택받은 자를 배신했군. 끔찍한 처벌이 있을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 4913bfb5-0546-3bfd-bbb8-69e74b96b96c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:4913bfb5-0546-3bfd-bbb8-69e74b96b96c
msgctxt "he5b436f8gb9e7g430cg9bddg2c56c34ff9af"
msgid "Surrender, and I'll kill you <i>quickly.</i>"
msgstr "네가 항복해라, 그럼 넌 <i>빠르게</i> 죽여주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 4e184000-d7b8-6bb8-7266-3daae1ebb8b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:4e184000-d7b8-6bb8-7266-3daae1ebb8b1
msgctxt "hd45aa911g331ag46b9gaa41g46b2c80ce145"
msgid "You - you <i>freed</i> the Nightsong?"
msgstr "너 - 네놈이 밤의 노래를 <i>풀어줬다고?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 5f4dff33-63e8-4e88-4ddd-26d6faaa4eff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:5f4dff33-63e8-4e88-4ddd-26d6faaa4eff
msgctxt "hfdd2293fg4ac0g44ecg9b36g903097abace3"
msgid "Cut this fool down."
msgstr "이 멍청이를 죽여줘라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 69630e40-d29a-a34f-4327-77e3590293bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:69630e40-d29a-a34f-4327-77e3590293bb
msgctxt "hd868cd7fgae94g433agb8b2gae8ade2a228f"
msgid "Where's the fun in that?"
msgstr "비키라고 비키면 그게 무슨 재미인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 6c2f09e4-62d5-b4d0-3292-99b8b7a5d60d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:6c2f09e4-62d5-b4d0-3292-99b8b7a5d60d
msgctxt "hb3bfac55g2ea8g48f8gb63cg02b7350b5716"
msgid "How could you do this to us? To Ketheric? To the <i>Absolute?</i>"
msgstr "네가 어떻게 우리에게 이럴 수가 있지? 케서릭 님께? <i>절대자님께?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = 8237e7af-32c0-8718-7f9b-1840721e8aea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:8237e7af-32c0-8718-7f9b-1840721e8aea
msgctxt "h08ec0f78g9b8ag4be8g807eg7ec87f92c7f5"
msgid "Step aside, Z'rell."
msgstr "비켜라, 즈렐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 84172787-482a-4252-714f-dcefe9e23b7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:84172787-482a-4252-714f-dcefe9e23b7b
msgctxt "h12305f66ga7c1g4e21g9892g35696beeb6ae"
msgid "Boys - make them bleed."
msgstr "얘들아, 피 맛을 보여줘라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 89481c90-4275-c6e6-01b9-ee54b5c284b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:89481c90-4275-c6e6-01b9-ee54b5c284b4
msgctxt "hcebb0b79g983bg4c02gb483g154914aa5efe"
msgid ""
"You have betrayed me, you have betrayed General Thorm - you have betrayed "
"our god!"
msgstr "넌 나를 배신했고, 쏨 장군을 배신했고, 우리의 신을 배신했어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 93b51cf2-6e24-3d34-a154-d25e25cbb5f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_ShadowheartKilledNightsong = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:93b51cf2-6e24-3d34-a154-d25e25cbb5f3
msgctxt "hf7c568e5gc223g4608g94ddg319bb8779112"
msgid "It was you. You destroyed the Nightsong."
msgstr "너였군. 네가 밤의 노래를 파괴했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 9491e904-c96d-1371-ef88-3a2aae76678d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:9491e904-c96d-1371-ef88-3a2aae76678d
msgctxt "hc97ac2dfg92e4g45dag873fg208d6eb2d6e3"
msgid ""
"Fascinating to see someone so favoured squander the regard of the Absolute. "
"How very sad."
msgstr "절대자의 신뢰를 이렇게 허비하다니, 안타까울지고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = 949da2fe-5780-3ac8-ea18-cf1e7f0979b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:949da2fe-5780-3ac8-ea18-cf1e7f0979b0
msgctxt "hbcc530c8gaf8bg4d5fga190gbd3a3e01becc"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = 97308ec9-56f6-2414-4b59-4d31935c41bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Executioner_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:97308ec9-56f6-2414-4b59-4d31935c41bc
msgctxt "he83a28eeg167ag4f81ga99ag13568a8a222e"
msgid "Stand aside, Z'rell."
msgstr "비켜라, 즈렐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = 9a0c26e2-3a2b-ebbf-ae0d-97f73bc4cb5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Executioner_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:9a0c26e2-3a2b-ebbf-ae0d-97f73bc4cb5e
msgctxt "hf6069743ge44fg40a8g857dg5473b64cf539"
msgid "Boys - make this traitor bleed."
msgstr "얘들아, 이 배신자 놈이 피를 흘리게 만들어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = 9b5baa7e-ac49-6d8a-cd4f-4e601c0782fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:9b5baa7e-ac49-6d8a-cd4f-4e601c0782fb
msgctxt "h7e6c94f2g1a4bg4adag922eg4e79b6a97d8c"
msgid "I've looked forward to killing you since the moment we met."
msgstr "처음 만난 순간부터 널 죽이기를 학수고대하고 있었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = b478eca2-2403-c59a-c867-c188a22e2f2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:b478eca2-2403-c59a-c867-c188a22e2f2b
msgctxt "h71911c2cgf922g43bcg9a67gba309519e14b"
msgid "Step aside, Z'rell."
msgstr "물러서라, 즈렐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = bd799612-12bf-fe52-1e1d-600441b72607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:bd799612-12bf-fe52-1e1d-600441b72607
msgctxt "h72bce2e2g9f93g43d7g8313g34690b031e0c"
msgid ""
"The General is not hiding - he is preparing the next stage of our "
"conquest<i>. </i>You really have no idea what's coming, do you?"
msgstr ""
"장군께선 숨은 게 아니야. 그분은 우리의 정복에 대한 다음 계획을 준비하고 계신다. <i>넌 정말 무슨 일이 일어날지 모르는구나?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Nightwarden Minthara
#. NodeID = c5ba9c17-9312-f8cc-b384-13d7a3616dec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:c5ba9c17-9312-f8cc-b384-13d7a3616dec
msgctxt "h85019035gc093g4e23g818bg51873a5db4b1"
msgid ""
"I will never serve the Absolute again, Z'rell, and I will take your "
"prattling tongue as a reminder of this moment."
msgstr "난 다시는 절대자를 섬기지 않을 거야, 즈렐. 헛소리하는 네 혀는 이 순간을 기억하기 위해 챙겨둬야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = c7c6b3a2-50b7-7e44-06c6-a2df24566de5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_JaheiraJoined = True
#.      - HAV_Siege_Event_SiegeStart = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:c7c6b3a2-50b7-7e44-06c6-a2df24566de5
msgctxt "h4a4536edged28g4640gba30gf7847ed52883"
msgid ""
"And for what? These Harpers? Moonrise will be their tomb - and in death, you "
"will all serve the Absolute."
msgstr "도대체 뭘 위해서? 하퍼들? 문라이즈는 그들의 무덤이 될 거야. 죽음을 통해 너희 모두는 절대자님을 섬기게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = d819557f-6578-1227-ea77-eb071e47ab15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:d819557f-6578-1227-ea77-eb071e47ab15
msgctxt "h535706acgb1b0g436ag8e64g9b3c376592ee"
msgid "You dare show yourself here, after all you've done?"
msgstr "그런 짓을 저지르고도 여기 나타났군?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = da9c5444-3267-8862-09f1-9229ac9b881c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:da9c5444-3267-8862-09f1-9229ac9b881c
msgctxt "ha6aa167egb0cdg4a9bg8499g164345e01edd"
msgid "Surrender, and I'll let you live."
msgstr "항복해, 그럼 목숨은 살려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = db1b19fe-0172-03de-6389-aed214b9f04d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:db1b19fe-0172-03de-6389-aed214b9f04d
msgctxt "h465a2287g4af4g4c96g939cg5ceca7233943"
msgid "Like a kitten roaring at a tiger."
msgstr "호랑이에게 으르렁대는 새끼 고양이가 따로 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Player
#. NodeID = e7102d17-5019-aebe-b66a-d1193bfaeb65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:e7102d17-5019-aebe-b66a-d1193bfaeb65
msgctxt "h69964678g73f8g448cgbf6fg303a46770202"
msgid "Surrender, and I'll let you live."
msgstr "항복해, 그럼 목숨은 살려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner
#. Speaker = Disciple Z'rell
#. NodeID = fb9af144-1f6a-7493-774a-80d15d39f031
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_Executioner:fb9af144-1f6a-7493-774a-80d15d39f031
msgctxt "hdcd857bdg3d34g4779gb423g76d503c69619"
msgid ""
"And for what? That little firefly buzzing around overhead? I'll crush you "
"first, then her - and in death, you will all serve the Absolute."
msgstr ""
"도대체 뭘 위해서? 저 윙윙거리는 반딧불이 같은 녀석 때문인가? 널 먼저 짓밟고, 그다음에 저 년을 짓밟아 죽이면, 너희 모두 절대자님을 "
"섬기게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 01ba59f0-55c2-7071-c51c-efed2b4090ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:01ba59f0-55c2-7071-c51c-efed2b4090ee
msgctxt "h3b38f5d8gd797g49e5gbe6bg7b82693145c1"
msgid ""
"Enough. You know as well as I that you cannot harm me. I am your superior in "
"every way."
msgstr "그만. 너도 날 해칠 수 없다는 걸 알 텐데. 난 너보다 모든 면에서 우월하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 032d6aea-cbba-70b1-6a46-3e5052c993f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Isobel_State_IsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:032d6aea-cbba-70b1-6a46-3e5052c993f3
msgctxt "h7539ebe2gb721g4587g8cf9g13b1174b090c"
msgid ""
"You must return to your prison. And my daughter must be reborn - one last "
"time."
msgstr "넌 네 감옥으로 돌아가야 한다. 그리고 내 딸은 다시 태어나야 해, 마지막으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 0c3d1679-a405-7869-89f2-4a2735ae4eea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_InProgress = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:0c3d1679-a405-7869-89f2-4a2735ae4eea
msgctxt "he23ba61fgc344g40acgbdfag6ae18443c720"
msgid "Enough. My Lord beckons me."
msgstr "그만. 주군께서 나를 부르신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 59fa5d2c-e6c4-d22b-a774-c0de805d0b14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:59fa5d2c-e6c4-d22b-a774-c0de805d0b14
msgctxt "h241aa46cg7b53g4f0cg8273gc6fed36d1633"
msgid "Bow before me, and I may finish you <i>quickly</i>."
msgstr "머리를 조아려라, 그럼 <i>빠르게</i> 끝내주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 80ae9806-f142-3a6e-0951-6f190fcd842b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:80ae9806-f142-3a6e-0951-6f190fcd842b
msgctxt "h7366bf85gba4dg4ed8gae4cg7cbc006dcf36"
msgid "You will fall as sure as she. This has only begun."
msgstr "네놈 또한 저년처럼 쓰러지리라. 이건 시작일 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Nightsong
#. NodeID = 83739743-6b22-0436-83ac-e929d59b1b8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:83739743-6b22-0436-83ac-e929d59b1b8d
msgctxt "h1be02e68gab0cg4773ga071g6bfcabeffc45"
msgid "Your daughter - Isobel?!"
msgstr "네 딸이라니 - 이소벨?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 89cf6347-c010-fc23-4b7b-009fa050cfb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:89cf6347-c010-fc23-4b7b-009fa050cfb6
msgctxt "hcff2d489g89e4g487fg86f7g51d9bb1b4c7d"
msgid ""
"You have no idea what you're meddling with. You're a pawn - a slave - to "
"forces you cannot comprehend."
msgstr "지금 무슨 일에 끼어든 건지 전혀 모르는군. 넌 하수인에 불과해 - 이해조차 불가능한 힘을 따르는 노예일 뿐이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = 94d24afb-7663-ad06-c14d-330ce3b30cc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Nightsong_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:94d24afb-7663-ad06-c14d-330ce3b30cc9
msgctxt "h3b4530c5gcf56g4274gbff7g4b2d64ff3ee3"
msgid "My Lord beckons me."
msgstr "주군께서 나를 부르신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = a29943c0-dc8e-584e-fd7b-146eecae6c87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_InProgress = True
#.      - MOO_Assault_State_NightsongDowned = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:a29943c0-dc8e-584e-fd7b-146eecae6c87
msgctxt "h05c7de2ega585g4980ga273g08b1633ba5b9"
msgid "Enough. My Lord beckons me."
msgstr "그만. 주군께서 나를 부르신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = a7326054-6bf2-c8eb-3c27-aaf146e4dcd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:a7326054-6bf2-c8eb-3c27-aaf146e4dcd6
msgctxt "ha1a6dd93gd3e2g4814g9fc7g135ea1c601ed"
msgid "I am the Chosen, and you are nothing. Follow. <i>See.</i>"
msgstr "난 선택받았다. 넌 아무것도 아니야. 따라와라. <i>보여주지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = d251983d-8f2d-8ac7-1b79-e4fc3c923421
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Isobel_State_AtMoonrise = False
#.      - HAV_Isobel_State_IsDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:d251983d-8f2d-8ac7-1b79-e4fc3c923421
msgctxt "ha75e5e21g2ee8g4991g9250g39a32aeaa7fe"
msgid "You must return to your prison. And my daughter must be reclaimed."
msgstr "넌 다시 원래대로 감옥에 갇히게 될 것이다. 그러고 난 뒤에 내 딸을 되찾겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = d39b1c6c-c718-3a71-cfb0-e5fada868383
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:d39b1c6c-c718-3a71-cfb0-e5fada868383
msgctxt "h89b24d41gf198g4c7eg8ef8g5b5551f93010"
msgid "<i>The Prism!</i> You've had it this whole time, you <i>rat</i>."
msgstr "<i>프리즘!</i> 내내 그걸 가지고 있었군. <i>쥐새끼 같은 놈</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption
#. Speaker = Ketheric Thorm
#. NodeID = da251827-a051-fb70-8034-a626b372808e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Isobel_State_AtMoonrise = True
#.      - HAV_Isobel_State_IsDead = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_FirstKethericInterruption:da251827-a051-fb70-8034-a626b372808e
msgctxt "h89f89cffg4e45g4067gb6f7ge5f899a83025"
msgid "You must return to your prison. And I must return to my daughter."
msgstr "넌 다시 원래대로 감옥에 갇히게 될 것이다. 그러고 나서 내 딸에게로 돌아가겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_HavenOutcasts_BarricadeRunners_Ranger
#. Speaker = Harper Antony
#. NodeID = 129a71ec-f592-44e0-8dfb-70b0a67e64c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
