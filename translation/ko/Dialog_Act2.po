msgctxt "hd8d92ed0g3bf4g445egb6a3gea51f8d0fda5"
msgid "Damn it, what are these chains made of?"
msgstr "젠장, 이 사슬 대체 뭘로 만든거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome01
