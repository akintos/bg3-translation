msgctxt "h05bcdb99gaa8cg460egbaceg947c7e9e7db1"
msgid "One day I'll get there... one day..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Blighted Actor
#. NodeID = 697821f3-9679-44cc-807d-cf4a4c42eb1c
#. HandlePath = TaggedText[0].TagText[0]
