msgctxt "h5e5d591ag1743g4a99g9d79gfe264d589188"
msgid "This darkness bites back. Will have to make do without a torch."
msgstr "어둠이 날뛰는군. 횃불 없이 가야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
