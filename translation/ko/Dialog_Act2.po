msgid "The disc is moving. This must lead to the next part of Shar's Gauntlet."
msgstr "원반이 움직여. 샤의 건틀릿 다음 단계로 인도하겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Disc_PAD_Unlocked
#. Speaker = Player
#. NodeID = 9aaa1b75-d9c8-49a3-b237-85ebfe06fb4a
#. HandlePath = TaggedText[0].TagText[0]
