msgctxt "h40cb6ff6g7e56g47e8gb897gebc433cb4b87"
msgid "Dark. Cold. As if all the life is being sucked out of me."
msgstr "어둡고, 추워. 마치 내 모든 생명이 빨려나가는 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 3bd911a5-9d47-4d24-b7c0-34083a66bbf1
