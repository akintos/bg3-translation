#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_Entrance_2P:8b971134-63e6-4c66-9f6b-1651dde3d3d0
msgctxt "hd14f4bc8g227fg49dcga6fagc9bfc3721890"
msgid "There might be something useful in there - seized goods and the like."
msgstr "저기 있는 건 뭔가 유용할지도 몰라. 압수한 물건들이나 그런 것들.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_Entrance_2P
#. Speaker = Player
#. NodeID = 8b971134-63e6-4c66-9f6b-1651dde3d3d0
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_Entrance_2P:8b971134-63e6-4c66-9f6b-1651dde3d3d0
msgctxt "h71b156f0gde85g418ega2a5g8487435994d9"
msgid ""
"Enormous, for a tollhouse. Must've teemed with merchants, back in the day."
msgstr "통행료 징수소 치고는 꽤 크네. 옛날에는 상인들로 북적였을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_Entrance_2P
#. Speaker = Player
#. NodeID = 8b971134-63e6-4c66-9f6b-1651dde3d3d0
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: BALDURIAN
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_Entrance_2P:8b971134-63e6-4c66-9f6b-1651dde3d3d0
msgctxt "h435823c7gedf2g4930g8456gfc93e7bb2448"
msgid "Impressive. I don't think even Baldur's Gate's is so large."
msgstr "인상적이야. 발더스 게이트에 있는 것도 이렇게 크지는 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_Entrance_2P
#. Speaker = Player
#. NodeID = 8b971134-63e6-4c66-9f6b-1651dde3d3d0
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_Entrance_2P:8b971134-63e6-4c66-9f6b-1651dde3d3d0
msgctxt "hd8c3e780g8b4fg458eg96c9gd651f6878d4a"
msgid "Surprisingly spacious. Must have been quite active in its heyday."
msgstr "깜짝 놀랄 정도로 넓어. 전성기에는 분명 꽤 활발했을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate
#. Speaker = Player
#. NodeID = a28be895-31d7-4b44-bd38-46201e42a684
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate:a28be895-31d7-4b44-bd38-46201e42a684
msgctxt "hacef6b4agdc46g4d8dg9906g9ccfd1152546"
msgid "Gems from Thay. Or <i>gem</i>, rather..."
msgstr "테이의 보석들이군. 아, <i>보석</i>, 이라 하는 게 맞겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate
#. Speaker = Player
#. NodeID = a28be895-31d7-4b44-bd38-46201e42a684
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate:a28be895-31d7-4b44-bd38-46201e42a684
msgctxt "h276fd5b7g87c9g4843g82bfg8a1df287d12b"
msgid "Gems from Thay. Looks like the looters were less than thorough..."
msgstr "테이의 보석들이군. 도둑들이 철저하지 못했던 것 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate
#. Speaker = Player
#. NodeID = a28be895-31d7-4b44-bd38-46201e42a684
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate:a28be895-31d7-4b44-bd38-46201e42a684
msgctxt "hb5cc7a1cgda44g4b6dgbda7gc19b24e0d44f"
msgid "Gems from Thay. Only one left."
msgstr "테이의 보석들이야. 하나만 남아있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate
#. Speaker = Player
#. NodeID = a28be895-31d7-4b44-bd38-46201e42a684
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate:a28be895-31d7-4b44-bd38-46201e42a684
msgctxt "h4e5b106bgc841g4c04g9b42gc6a78b3a458d"
msgid "A crate from Thay, picked clean. Well - almost, anyway."
msgstr "테이에서 온 상자군, 깔끔하게 털렸어. 거의 - 털렸다고 해야하나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate
#. Speaker = Player
#. NodeID = a28be895-31d7-4b44-bd38-46201e42a684
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate:a28be895-31d7-4b44-bd38-46201e42a684
msgctxt "h4022d696g5d31g4362g870cgf5d928a39c5e"
msgid ""
"From Thay. Whoever looted this must've been in a hurry - they missed a gem."
msgstr "테이 것이군. 누가 훔쳐 갔는지 몰라도 꽤 서둘렀나 봐. 보석 하나를 놓고 갔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate
#. Speaker = Player
#. NodeID = a28be895-31d7-4b44-bd38-46201e42a684
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate:a28be895-31d7-4b44-bd38-46201e42a684
msgctxt "h02e96642g2786g40efgbf8bgcc5a36ae3bb5"
msgid "Thay's emblem? Magical items, then. And a little souvenir."
msgstr "테이의 상징? 마법 물품이군. 작은 기념품도 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate
#. Speaker = Player
#. NodeID = a28be895-31d7-4b44-bd38-46201e42a684
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_ThayCrate:a28be895-31d7-4b44-bd38-46201e42a684
msgctxt "h7880ee8bgfd78g43d2gbcacgd25d28136b78"
msgid ""
"All the way from Thay. Jewels and gems, probably - one's still in there."
msgstr "테이에서 여기까지 왔군. 장신구와 보석류가 있었을 거야, 하나가 남아있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "haf690fc2g064dg404cgb356g7fa706a9bf0f"
msgid "Poor thing. You can hardly blame her for loving gold..."
msgstr "불쌍하군. 금을 좋아한다고 그녀를 비난할 순 없지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "h5934848fg3691g4b90g8af8g32d54a95c43c"
msgid "Dead, finally - and better off for it."
msgstr "드디어, 죽었어 - 잘 됐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "hd81352f6gb0a7g44d0g9211g5e71db153115"
msgid ""
"These shadows made her something worse than her vices. What would it make of "
"us, if we stay here too long?"
msgstr "그림자가 그녀를 제 악행보다 더 끔찍한 모습으로 변모시켰군. 우리가 여기 너무 오래 있으면, 어떻게 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "hcc7ace71gec39g43d3g857bg524c4dbc214e"
msgid "Dead. All the gold in the world can't keep your heart beating."
msgstr "죽었군. 이 세상의 모든 금도 네 심장이 멈추는 건 막을 수 없나 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "hef7b4ca8gbd18g4ba5gb8cfg36be0b2419b3"
msgid ""
"The curse made her a creature of sheer greed. May her soul finally be at "
"rest."
msgstr "저주가 그녀를 탐욕의 괴물로 만들었군. 그녀의 영혼이 마침내 안식을 찾기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "h32dd6d32g3aaag4fcbg962dg84a0c250a8bd"
msgid "Whatever monster she became, she was a person, once. Before this curse."
msgstr "어떤 괴물로 변했건 간에, 그녀는 한때, 사람이었어. 저주에 걸리기 전까지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "h90219aecg74e5g41e6g819fgcefb966f20cc"
msgid "Vanquished. Let us strip whatever valuables remain from her corpse."
msgstr "이겼군. 이제 저 시체에 남아있는 귀중품을 전부 뜯어가도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "h7b51cf13g5f28g44c8gb467g7281d0eab9cb"
msgid "The shadow curse warped her utterly - death was a kindness."
msgstr "그림자 저주가 그녀를 완전히 뒤틀어 놓았군 - 죽음은 은혜였을 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead
#. Speaker = Player
#. NodeID = aa881a38-2e27-493a-a431-b00ee465b273
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_TollmasterDead:aa881a38-2e27-493a-a431-b00ee465b273
msgctxt "h4be96a84gacb8g4fa8gbac5gfeb3e6569fa0"
msgid "Free from the curse, now - perhaps she'll find peace."
msgstr "저주에서 자유로워졌군, 이제서야 - 평안을 찾을 수 있을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 019612bc-7f95-3334-bf97-0f22ebb8ef62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_EVIL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:019612bc-7f95-3334-bf97-0f22ebb8ef62
msgctxt "h7ccdcc00gebacg419agaf4ag28cb1621abf6"
msgid "Pain, grief, loss, chaos - the list is endless."
msgstr "고통, 비애, 상실, 혼돈 - 목록이야 끝도 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 019612bc-7f95-3334-bf97-0f22ebb8ef62
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_NEUTRAL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:019612bc-7f95-3334-bf97-0f22ebb8ef62
msgctxt "hd1c96f84gc742g4f43g9d79g22d188f4d9e9"
msgid "Whatever my god requires."
msgstr "나의 신께서 원하신다면 무엇이든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 019612bc-7f95-3334-bf97-0f22ebb8ef62
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_GOOD
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:019612bc-7f95-3334-bf97-0f22ebb8ef62
msgctxt "h3d249a10gb76ag4217gb843g4b33532a83c6"
msgid "Peace and comfort, I hope."
msgstr "바라건대, 평화와 안식이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 0258cd77-5a9a-bdb2-b923-53de06a41734
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:0258cd77-5a9a-bdb2-b923-53de06a41734
msgctxt "h85a085e3gfb78g41f0gb0e3g3fbf9c827cc2"
msgid "Says who? Seems to me there's no one here to oversee you."
msgstr "누가 시켰는데? 이제 감시하는 상사도 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 03afc4e4-3b3b-a8ac-97d8-41b06f1413a1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:03afc4e4-3b3b-a8ac-97d8-41b06f1413a1
msgctxt "hecc94985ge40bg458ag8665g0d41da643c85"
msgid ""
"Your obsession with gold is hurting you. If you leave this place, maybe you "
"can still be saved."
msgstr "금에 대한 집착은 너 자신에게 해가 될 뿐이다. 이 장소를 떠난다면, 아직 구원받을 수 있을지도 모른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 04d9b6a6-8311-4603-a5b6-bd276a3ad019
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:04d9b6a6-8311-4603-a5b6-bd276a3ad019
msgctxt "hdc4c416fgbc1cg424fgb638gb27f0e2b04f0"
msgid "I bring <i>you </i>death."
msgstr "너의 죽음을 가져왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 062c6902-82b6-0ba6-3732-1b2cb665aa24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ddb7b36b-bce2-d66f-3a9a-f7aca0af4545_TWN_Tollhouse_State_AskedHowMuch = False
#. SetFlags:
#.   Local:
#.     - ddb7b36b-bce2-d66f-3a9a-f7aca0af4545_TWN_Tollhouse_State_AskedHowMuch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:062c6902-82b6-0ba6-3732-1b2cb665aa24
msgctxt "h890dedbege731g46deg8ad3g116981e87e7a"
msgid "How much do you want, exactly?"
msgstr "정확히 얼마나 원하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 0c2f17b9-65e5-6e8f-8cd6-5ad310572c07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:0c2f17b9-65e5-6e8f-8cd6-5ad310572c07
msgctxt "h2df9075agca9bg4c00gae51g11abd4d12203"
msgid "ALL THAT YOU HAVE!"
msgstr "<b>네가 가진 전부</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 0f6d8a68-7306-072f-4187-ab65238de3d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:0f6d8a68-7306-072f-4187-ab65238de3d5
msgctxt "ha371651dgcfe3g49fegaa34g95ed43cdf5e7"
msgid "NO! NO! YOU MUST PAY - YOU MUST PAY THE TOLL!"
msgstr "<b>아니! 아니! 내야 해 - 넌 통행료를 내야 해</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 1023ae3e-e71a-4e42-8ea3-1755033e09b3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:1023ae3e-e71a-4e42-8ea3-1755033e09b3
msgctxt "ha5d92c93g9d26g4af7g8017g8f0f7e8bb8ce"
msgid ""
"I'm afraid I'm actually your replacement. You've been fired as toll "
"collector - terribly sorry."
msgstr "미안한데, 내가 사실 네 대체자야. 넌 통행료 징수원으로서 짤렸어, 정말 안타깝게 생각해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 10433958-29a6-4424-bc74-d5561354b3b0
#. HandlePath = TaggedText[0].TagText[0]
