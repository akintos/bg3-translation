msgctxt "ha44a7485g8330g4530g953dg804f2294f1f3"
msgid "This pit is making my skin crawl. Isn't it time to go?"
msgstr "구덩이 때문에 소름이 돋는데. 갈 시간 안됐어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 844e3e12-93b5-48d0-9550-e4aaab1d8145
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
