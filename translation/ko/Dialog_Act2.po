msgctxt "h68d2cfa0gd623g47d8gac60g6f895846f6a1"
msgid "It drains power from a host. Fittingly parasitical."
msgstr "숙주에게서 동력을 흡수하는 것 같군. 이보다 더 기생적일 수 없겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = df542562-f6f2-cf5f-8893-6ac4153eadf0
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_RegenStations_State_UsedOnce = True
#.      - COL_RegenStation_State_CheckSuccess = True
