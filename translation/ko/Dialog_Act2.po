#.     - MOO_Jailbreak_Event_ADEscaping(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:844e3e12-93b5-48d0-9550-e4aaab1d8145
msgctxt "h27b4ea1cg7a1cg4e80gb4a1g83e232055579"
msgid "Gods, where are we?"
msgstr "이런, 여기가 어디지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 85f185b6-4c4a-516d-5276-b49235b14906
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_A = True
