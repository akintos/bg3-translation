#. CheckFlags:
#.   Object:
#.      - TWN_Tollhouse_State_HasAlcohol(1) = True
#.   Tag:
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:dbd340f6-a351-47ae-ad44-38ed996e4e0f
msgctxt "ha9c52515g4a51g4049gaad2g9c76d4299d8e"
msgid "I bring... wine?"
msgstr "와인...을 가져왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = dc9f6505-7954-0a1f-e755-753f5ccf1d52
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
