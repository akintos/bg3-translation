msgctxt "h2c676431g8140g4317g83cbgc07bf7ca2435"
msgid "I don't answer to you, <i>prey</i>."
msgstr "너에게는 대답하지 않겠다, <i>먹잇감아</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = c5bc194f-851b-d499-4f1d-4bd23c151e1b
#. HandlePath = TaggedText[0].TagText[0]
