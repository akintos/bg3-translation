msgctxt "h0b665cc8g830eg4d27gb0bfg805435d36a25"
msgid "Light in the sky. Light at last."
msgstr "빛이다. 마침내 빛이 나타났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_HavenOutcasts_DockGuard_Left_Ranger
#. Speaker = Harper Lymn
