msgctxt "h2446692egfc09g451dg81f1gc9aabb21c5bf"
msgid "Illithid writing. Meaningless to me."
msgstr "일리시드의 글이군. 쓸모없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod
#. Speaker = Mizora
#. NodeID = 7fe8319e-9991-2f09-9e6f-3b8cac99e93f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod:7fe8319e-9991-2f09-9e6f-3b8cac99e93f
msgctxt "hc5c9e78bg372dg4b65ga67fg004ab91beda3"
msgid "Damn it all, where <i>is</i> he?"
msgstr "다 집어치워, 그 자식 <i>어디</i> 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod
#. Speaker = Mizora
#. NodeID = 7fe8319e-9991-2f09-9e6f-3b8cac99e93f
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod:7fe8319e-9991-2f09-9e6f-3b8cac99e93f
msgctxt "h7ee1c432gc4a3g435fg83b5g33387fb30c88"
msgid "By Aldinach's arse, get me out of here."
msgstr "젠장 알디나크시여, 어서 날 꺼내줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod
#. Speaker = Mizora
#. NodeID = 7fe8319e-9991-2f09-9e6f-3b8cac99e93f
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod:7fe8319e-9991-2f09-9e6f-3b8cac99e93f
msgctxt "h6deba4fbgb046g442aga97cg0df4d5c986ea"
msgid "Trapped like a rat. Humiliating."
msgstr "쥐새끼처럼 갇혀버렸군. 굴욕적이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod
#. Speaker = Mizora
#. NodeID = 7fe8319e-9991-2f09-9e6f-3b8cac99e93f
#. HandlePath = TaggedText[0].TagText[3]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod:7fe8319e-9991-2f09-9e6f-3b8cac99e93f
msgctxt "ha2035767gabbeg4af2gb391g9e81fdac0b09"
msgid "Hello? Anyone out there?"
msgstr "이봐? 거기 아무도 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod
#. Speaker = Mizora
#. NodeID = 7fe8319e-9991-2f09-9e6f-3b8cac99e93f
#. HandlePath = TaggedText[0].TagText[4]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod:7fe8319e-9991-2f09-9e6f-3b8cac99e93f
msgctxt "ha755aae6gf978g42f3g97a1g2759bcf72b7e"
msgid "Flaming Hells. Time's running out."
msgstr "불타는 지옥이여, 젠장. 시간이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod
#. Speaker = Mizora
#. NodeID = 7fe8319e-9991-2f09-9e6f-3b8cac99e93f
#. HandlePath = TaggedText[0].TagText[5]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MizoraRescue_AD_MizoraInPod:7fe8319e-9991-2f09-9e6f-3b8cac99e93f
msgctxt "hda83c4cag7d57g42d7g90ffgedf187555eaa"
msgid "Bastards. Can't conjure so much as a fireball in this thing."
msgstr "개자식들. 여기선 간단한 화염구조차 못쓰겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_SpotUs
#. Speaker = Chop
#. NodeID = aad93119-2314-461c-8c56-c7d80fb7fb55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_SpotUs:aad93119-2314-461c-8c56-c7d80fb7fb55
msgctxt "h133114c8gb695g4b2eg8eb6gf725d63f9ac6"
msgid "No! Bad kitty! Back in cage!"
msgstr "안돼! 나쁜 고양이! 우리 안에 들어가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_CombatEnter
#. Speaker = Chop
#. NodeID = 7c7a6f51-cade-4b74-83e4-d4646fae2c8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_CombatEnter:7c7a6f51-cade-4b74-83e4-d4646fae2c8f
msgctxt "hf7c1bba6g0d6ag42dbg9245gf31a2bb7de12"
msgid "Living meat? Not for long. Time for chop."
msgstr "살아있는 고기? 이제 곧. 썰 시간이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_CombatTurn001
#. Speaker = Chop
#. NodeID = cfd714b4-cc22-46d4-b5d5-8c21a1300e4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_CombatTurn001:cfd714b4-cc22-46d4-b5d5-8c21a1300e4c
msgctxt "hcb305524g5d78g460dga9cbgf62f55e23e50"
msgid "Head full of red. No want chop. Make it stop. Make <i>me </i>stop."
msgstr "머리가 빨간색으로 가득 찼다. 더 썰기 싫다. 멈춰. <i>나를</i> 멈춰줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_CombatTurn002
#. Speaker = Chop
#. NodeID = a80f5a9f-2d31-4eb5-a27c-10341fc76232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_CombatTurn002:a80f5a9f-2d31-4eb5-a27c-10341fc76232
msgctxt "he041e222g4a16g4fa8g8c79g48abec5fefc6"
msgid "<i>Kill me. </i>No more voices. No more red. Only peace. Only dead."
msgstr "<i>죽여줘.</i> 목소리 싫다. 빨간색 싫다. 평화만. 죽음만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Death
#. Speaker = Chop
#. NodeID = 4e975746-5c4c-4be3-81d4-fea0905483d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Death:4e975746-5c4c-4be3-81d4-fea0905483d4
msgctxt "hbd1961d5g2845g413bgab8agf3eb0bb5142b"
msgid "Death. Free at last. No more chop, chop, <i>chop...</i>"
msgstr "죽음. 드디어 자유. 더 이상 안 썬다. 안 썰어도 된다. <i>안 썰어도...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle
#. Speaker = Chop
#. NodeID = 3a2264b5-6fe9-d707-db29-efe6e4519038
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_B = True
#.      - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_A = True
#. SetFlags:
#.   Local:
#.     - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_B = False
#.     - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle:3a2264b5-6fe9-d707-db29-efe6e4519038
msgctxt "hc6617580g014dg4dbfga380gcd51f686d9cc"
msgid ""
"Pretty faces go chop... <i>faces? </i>No - no faces, only meat. Never think, "
"never stop. Only chop. <i>Chop</i>. CHOP."
msgstr ""
"예쁜 얼굴 썬다... <i>얼굴?</i> 아니다. 얼굴 싫다. 고기만 있다. 생각 안 한다, 안 멈춘다. 오로지 썬다. <i>썬다</"
"i>. <b>썬다.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle
#. Speaker = Chop
#. NodeID = 45529cc9-d569-2b4d-732f-cac203bf69d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_B = False
#.      - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_A = True
#. SetFlags:
#.   Local:
#.     - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_B = True
#.     - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle:45529cc9-d569-2b4d-732f-cac203bf69d5
msgctxt "h18e97a56g9cb0g4f79ga3c5g97987f2bc9fd"
msgid "Steel loves meat. It sings chop, chop, chop."
msgstr "칼은 고기를 사랑한다. 숭덩, 숭덩, 숭덩, 노래 부른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle
#. Speaker = Chop
#. NodeID = ceda179f-1514-c0fb-0894-e378f744a035
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_B = True
#.      - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_A = False
#. SetFlags:
#.   Local:
#.     - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle:ceda179f-1514-c0fb-0894-e378f744a035
msgctxt "h8199447cgd9d1g4fb5g8bb0g71d0e2d10e4e"
msgid ""
"Pretty red. Pretty pink. Make more. Never think. Always chop, chop, chop."
msgstr "예쁜 빨간색. 예쁜 분홍색. 더 만든다. 생각 안 한다. 계속 썰고, 썰고, 썬다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle
#. Speaker = Chop
#. NodeID = f716c17c-7cdb-b020-a9f4-47b057768420
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4e0374ac-a5d9-0d5a-7efb-d6bca6e2f78d_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Butcher_Idle:f716c17c-7cdb-b020-a9f4-47b057768420
msgctxt "h9fe209d1gbd76g422bg88a2g5d0196a50a2a"
msgid "Chop, chop, chop."
msgstr "숭덩, 숭덩, 숭덩."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Us_Attacked
#. Speaker = Us
#. NodeID = 1f6b145a-b9c9-47d1-9f88-cb4c21170180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Us_Attacked:1f6b145a-b9c9-47d1-9f88-cb4c21170180
msgctxt "he3013048gf49dg4abcgbf0bg95c9e252f53f"
msgid "<i>No, friend - do not harm Us! Please!</i>"
msgstr "<i>안 돼, 친구! 우리를 때리지 마! 제발!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Minthara_EnteredRoom
#. Speaker = Nightwarden Minthara
#. NodeID = 79f52522-a4f4-2245-a434-192910e4b456
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Minthara_EnteredRoom:79f52522-a4f4-2245-a434-192910e4b456
msgctxt "h2ba1f182g5d19g4ce1g9383gd6a98e0164c1"
msgid ""
"Fresh recruits for Ketheric's army. To a necromancer, a morgue is a muster "
"yard."
msgstr "케서릭 부대의 신병이네. 네크로멘서에게는 시체안치실이 곧 신병모집소나 다름없겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Us_FollowPlayer
#. Speaker = Us
#. NodeID = 794ce583-0049-43fe-4ffe-434da01989cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_AD_Us_FollowPlayer:794ce583-0049-43fe-4ffe-434da01989cf
msgctxt "hb3b01637g61d0g47d6gb9e1gc16f8efc0f04"
msgid "<i>We must flee - lead Us to safety, friend.</i>"
msgstr "<i>우리는 도망쳐야 해. 우리를 안전한 곳으로 인도해 줘, 친구.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 05cc1633-59cd-ee49-9d42-729864e7f8f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_State_UsFreed = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:05cc1633-59cd-ee49-9d42-729864e7f8f7
msgctxt "h890aaafdgc6bbg4f50ga822g6749fb773946"
msgid "NO! No touch. It is wrong - <i>Other.</i>"
msgstr "안된다! 건드리지마라. 나쁘다 - <i> 남이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 088f20e8-1f6c-4e70-a3d4-6ff369a6c3b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_Morgue_Butcher_State_ConvincedReleaseUs = True
#.   Object:
#.     - COL_Morgue_Butcher_Event_ReceiveUsKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:088f20e8-1f6c-4e70-a3d4-6ff369a6c3b9
msgctxt "hbfef65dfg092ag4113g9c3fg0244bd60f1e2"
msgid "It sings... wrong song. But... <i>same </i>song - as you?"
msgstr "노래 잘못...부른다. 그런데... 너랑 <i>같은</i> 노래다?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = 0bd3dc74-7321-e4d4-d53c-fab4a39e7514
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:0bd3dc74-7321-e4d4-d53c-fab4a39e7514
msgctxt "hd4e52544g7379g417cg8727gdea381e7b1e4"
msgid "You're right. It is 'other' - so let me take it away."
msgstr "네 말이 맞아. '다를' 뿐이지. 그러니 내가 데려가게 해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 36254a9c-bdd3-63af-5d1e-6c72a385a43a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:36254a9c-bdd3-63af-5d1e-6c72a385a43a
msgctxt "hc6eec596gce99g4fdegabe4g38228f638c36"
msgid "Die. Die. Die?"
msgstr "죽어. 죽어. 죽어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = 4052b216-0b82-4088-a130-2f71ab6726d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_Butcher_State_MentionedUs = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:4052b216-0b82-4088-a130-2f71ab6726d5
msgctxt "h2a03bf23g63cbg4debgbaafg42a0a5fabf03"
msgid "We are alike. It belongs with me."
msgstr "우리는 서로 비슷해. 그러니 내가 데려가겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 48489cd3-e1e2-3da5-e56b-e83c70b575fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:48489cd3-e1e2-3da5-e56b-e83c70b575fd
msgctxt "hefec735fg5096g4a91gbe66gcd288c9e16ef"
msgid "No look. No touch. No <i>smell</i> or <i>taste.</i>"
msgstr "보지도 마라. 건드리지 마라. 냄새나 <i>맛도</i> 보지 <i>마라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = 64fc41af-5292-96fb-1120-82963d113d3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:64fc41af-5292-96fb-1120-82963d113d3b
msgctxt "hbbe70e02g9dc3g43b4ga25bg1bd8765156ae"
msgid "Why do you care?"
msgstr "왜 미련을 가지지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 6898c9dc-9b2d-3372-30ed-341d61940a72
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_Morgue_Event_ButcherCancelHostility = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:6898c9dc-9b2d-3372-30ed-341d61940a72
msgctxt "h81c60c68gca18g4d24g85f5g1bdc8025be26"
msgid "... no. Please. I hear. I obey."
msgstr "아니다. 제발. 나는 들을 수 있다. 나는 따르겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = 69e4d0e6-597e-e33f-9b92-21a082af6613
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:69e4d0e6-597e-e33f-9b92-21a082af6613
msgctxt "h7576ceeag5462g4410g817bg53315aa4c258"
msgid "Shall I 'fix' you as well?"
msgstr "너도 똑같이 '고쳐'줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 80c3d355-9229-483c-6b72-d4bd564a5d59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:80c3d355-9229-483c-6b72-d4bd564a5d59
msgctxt "h75f7fc5cg83b7g48a1g8febg6cc2d85fd18a"
msgid "Sing other song together, then - but AWAY from here."
msgstr "그렇다면 다른 노래를 같이 불러라. 하지만 멀리 떨어져서 불러라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 8ab0e305-a4c5-a108-f39a-cb0db0227eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_State_Us_IsDead = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:8ab0e305-a4c5-a108-f39a-cb0db0227eeb
msgctxt "h3ccb8d53gc336g4900g8266gf0b55875286f"
msgid "NO! Creature was wrong - <i>Other. </i>But <i>mine</i> to fix."
msgstr "안 돼! 잘못 창조되었다. <i>다르다. </i>하지만 <i>내가</i> 고친다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 9059a10a-cb89-4b71-fdde-5313706a6b51
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_Morgue_Event_ButcherCancelHostility = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:9059a10a-cb89-4b71-fdde-5313706a6b51
msgctxt "h943fbf4fg537eg4ba7g9a0dgcdca1b57dbf3"
msgid "No look. No touch. No more<i> warning.</i>"
msgstr "보지마라. 만지지 마라. 마지막<i> 경고다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = 94092b48-256a-8d0d-dab5-ec8ddeaa9440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:94092b48-256a-8d0d-dab5-ec8ddeaa9440
msgctxt "h95046c84g4283g48bdg9b13gdd26d282a91a"
msgid "Stand aside or die."
msgstr "비키지 않으면 죽어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 994ad6a6-a53b-a63a-cd5e-a7bd58efa884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:994ad6a6-a53b-a63a-cd5e-a7bd58efa884
msgctxt "hbee075e1g82e0g4f2bg87e2g7f2f527420c1"
msgid "No. NO! <i>CHOP</i> FIX."
msgstr "안 돼, 안 돼! <i>자른다!</i> 고쳤다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 9a00ffaf-a3bb-7f24-8f12-563439426f4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:9a00ffaf-a3bb-7f24-8f12-563439426f4b
msgctxt "hadd16220g8426g49c6g80d8gf4ca5702bdf8"
msgid "Part of One Mind. <i>Us. </i>Even if... wrong."
msgstr "<i>우리의 </i> 일부다. 비록...잘못되었을지라도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = 9bc1d9d0-ded5-6d45-0f34-c02354ad5a36
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:9bc1d9d0-ded5-6d45-0f34-c02354ad5a36
msgctxt "hfe8acb3dg52f3g4794g88a8g62ede102dd09"
msgid "NO! Back in cage. It is wrong. Sings wrong. <i>Other.</i>"
msgstr "안돼! 우리로 돌아가라. 잘못됐어. 노래가 잘못됐어. <i>다르다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = a417846c-5781-ed68-ef03-0fe38c48fdcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:a417846c-5781-ed68-ef03-0fe38c48fdcb
msgctxt "h50bfda54g4742g400egb1a1g1c86478b17f8"
msgid "Yes - <i>PLEASE!</i>"
msgstr "그래 - <i>그래줘!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = b394da48-6f85-e598-9d69-7ec2ca1e8eec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_Morgue_Butcher_State_ConvincedReleaseUs = True
#.   Object:
#.     - COL_Morgue_Butcher_Event_ReceiveUsKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:b394da48-6f85-e598-9d69-7ec2ca1e8eec
msgctxt "hd527092ag60a8g4a80gbfa8gf48a4a89529e"
msgid "You sing wrong song too. In wrong voice."
msgstr "너도 잘못된, 노래 부른다. 음정도, 틀렸다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = c6e46e00-c76e-4a6d-b6ed-c5e9eabb43f3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_Butcher_State_MentionedUs = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:c6e46e00-c76e-4a6d-b6ed-c5e9eabb43f3
msgctxt "h32b824d5g68a2g4738gbdf8g9a21e4d4e1c2"
msgid "We are alike. It belongs with me."
msgstr "우리는 서로 비슷해. 그러니 내가 데려가겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = c736aab6-4d37-031c-6f26-c5039ef09353
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_Morgue_State_TriedDenyingCrime(1) = False
#. SetFlags:
#.   Dialog:
#.     - COL_Morgue_State_TriedDenyingCrime(1) = True
#.   Global:
#.     - COL_Morgue_Event_ButcherCancelHostility = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:c736aab6-4d37-031c-6f26-c5039ef09353
msgctxt "h137342c6g3d85g447dgad44g38df413bb909"
msgid "No touch. I was just taking a look."
msgstr "안건드려. 그냥 보는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = cad6799e-6849-46d0-1847-c9eb149b7f6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:cad6799e-6849-46d0-1847-c9eb149b7f6a
msgctxt "he7583a62ge66ag4ab6g8381ga101d062abbf"
msgid "I'll send you to join it then."
msgstr "너도 같이 보내주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Narrator
#. NodeID = d387d70c-a0b8-4a42-ba21-2c1855ac90bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:d387d70c-a0b8-4a42-ba21-2c1855ac90bb
msgctxt "h77e52818gc7c4g41efg9786g58732c9c1c34"
msgid ""
"*You focus on the source of the power, but it is quiet and still. It needs "
"to rest.*"
msgstr "*힘의 원천인 존재에 정신을 집중하지만, 응답이 없습니다. 휴식이 필요한 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = d8d5f474-5a43-4054-b9ea-87fec5590126
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:d8d5f474-5a43-4054-b9ea-87fec5590126
msgctxt "hab4a9077g4c06g41eeg912eg898c591c10c3"
msgid "I am a True Soul. Are you questioning my will?"
msgstr "나는 참된 영혼이다. 감히 나의 의지를 시험하려 드는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Player
#. NodeID = dae476bd-6bff-74a6-549c-c9e22ee9f5aa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - COL_Morgue_State_TriedDenyingCrime(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:dae476bd-6bff-74a6-549c-c9e22ee9f5aa
msgctxt "hcb1c9062g4c21g479ag9e4bgae541a26ed91"
msgid "No touch. I was just taking a look."
msgstr "안만졌어. 그냥 보기만 한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = e1eb6ff7-309d-da53-b56d-5ef82f336ef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:e1eb6ff7-309d-da53-b56d-5ef82f336ef0
msgctxt "he6465785gdbb3g45b6gb5bfgf6d9a5d63475"
msgid "No TOUCH. No LOOK. No MORE!"
msgstr "만지지 마라. 보지도 마라. 아무것도 하지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Chop
#. NodeID = ee8d93ba-903e-b44b-5488-0c461344ded6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:ee8d93ba-903e-b44b-5488-0c461344ded6
msgctxt "hf5cd54f1gb416g45c5g8bc1g92ac43025d6d"
msgid "No! Wrong - ALL WRONG!"
msgstr "아니다! 틀렸다, <b>전부 틀렸다!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs
#. Speaker = Narrator
#. NodeID = fac79eee-4dd3-47e0-869a-32ec1813eeb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Butcher_FreedUs:fac79eee-4dd3-47e0-869a-32ec1813eeb0
msgctxt "h55689878g36b3g44f4g948bgfa90a3cca311"
msgid ""
"*You focus on the source of the power, but it is quiet and still. It needs "
"to rest.*"
msgstr "*힘의 원천인 존재에 정신을 집중하지만, 응답이 없습니다. 휴식이 필요한 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 02d6bef4-9fb6-d6d6-8297-6fbea82c3a30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_Morgue_HasMet_Us(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:02d6bef4-9fb6-d6d6-8297-6fbea82c3a30
msgctxt "h907a9a40g2ce3g4697g8cffg646ec168f810"
msgid ""
"<i>They wish to repurpose Us - destroy what they cannot fix. Please, help Us "
"escape harm!</i>"
msgstr "<i>그들은 우리를 고치길 원하고 있어. 만약 그러지 못한다면 파괴해버리겠지. 제발, <b>우리</b>를 구해줘!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 0f3677a8-8ccc-29c4-5a95-af73efb6fbf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:0f3677a8-8ccc-29c4-5a95-af73efb6fbf0
msgctxt "he0369840g654cg43b0gbd22g5658820fd371"
msgid ""
"<i>They are not kind to Us here. We are different, they say. Aberrant.</i>"
msgstr "<i>여기 사람들은 어스에게 친절하지 않아. 어스가 다르고, 비정상이래.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 1babffb9-96fd-68fe-5dca-cec8c4199246
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:1babffb9-96fd-68fe-5dca-cec8c4199246
msgctxt "hdd1f5cc6g918ag4b9cgae2ag01b036fdc2b3"
msgid ""
"<i>But perils remain, near and far - better to stay together. You and Us - "
"WE.</i>"
msgstr "<i>가까이에도, 멀리에도 모두 위험하니깐, 같이 다니자. 너와 어스, <b>우리 모두</b>.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 1d464581-10c3-c663-1b66-10a0972e187a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_Morgue_HasMet_Us(1) = False
#. SetFlags:
#.   User:
#.     - COL_Morgue_User_HasMet_Us(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:1d464581-10c3-c663-1b66-10a0972e187a
msgctxt "h0f6d709dg21efg44e0ga3f3g03acb88759ad"
msgid "<i>Friend! You found the helm!</i>"
msgstr "<i>친구야! 조타실을 찾았구나!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 36ac0c1e-1b2e-ca17-ec5c-d1ce2cab85c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:36ac0c1e-1b2e-ca17-ec5c-d1ce2cab85c6
msgctxt "h95bff6a9g6ed4g42e8g986bgb0041c86188d"
msgid ""
"<i>Oh, thank you, thank you! You are a good friend - no, more. Rescuer.</i>"
msgstr "<i>고마워, 진짜 고마워! 너는 좋은 친구라는 말로는 부족해. 구세주야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Player
#. NodeID = 3a163165-7848-8715-13c3-09098931adb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:3a163165-7848-8715-13c3-09098931adb6
msgctxt "hfb42fa93g2bceg4d92gb19bge2bac67ad266"
msgid "Not my concern."
msgstr "그건 내 알 바가 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 3e10ad1c-716d-f402-d8e2-7367e5f0dcfe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_State_UsFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:3e10ad1c-716d-f402-d8e2-7367e5f0dcfe
msgctxt "hda905c4bgf4b9g45c9g9db0g230bbc8b3e01"
msgid "<i>We are loose, but not safe - time to flee!</i>"
msgstr "<i>탈출은 했지만 아직 위험해. 도망치자!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 41622e69-b7f4-03ae-e7b1-e44d5b501eff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:41622e69-b7f4-03ae-e7b1-e44d5b501eff
msgctxt "hca3e1597g33aeg4706g8ef3g4d09c3ebb74d"
msgid ""
"<i>But we need your help! Friend is not kind. Friend is perhaps no friend at "
"all...</i>"
msgstr "<i>하지만 <b>우린</b> 네 도움이 필요한걸! 친구가 도와주지 않아. 어쩌면 친구가 아닐지도 몰라...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Player
#. NodeID = 62f90d20-c259-a688-22e1-3621bd6dd990
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:62f90d20-c259-a688-22e1-3621bd6dd990
msgctxt "h2d241993g34ceg47caga727g86fac5441ed1"
msgid "I'll free you."
msgstr "내가 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 6f854b01-53d8-16d9-268e-1108392f562a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:6f854b01-53d8-16d9-268e-1108392f562a
msgctxt "h19603f2cg0f93g42a8g88a0g62ab066cc294"
msgid ""
"<i>We remember you well. You saved Us once. Perhaps you can do it again?</i>"
msgstr "<i><b>우린</b> 너 기억하고 있어. <b>우리</b>를 한 번 구해준 적 있지. 혹시 또 구해줄 수 있을까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = 74bc2c18-1783-2c98-1565-060cd6335a9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Morgue_State_UsSaved = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:74bc2c18-1783-2c98-1565-060cd6335a9d
msgctxt "hadff6e2dg551bg40c1ga200g69e82ce9c2fc"
msgid "<i>We are free! Thank you, friend.</i>"
msgstr "<i><b>우리는</b> 자유다! 친구야, 고마워.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = ad62ed5b-ed60-5f4d-d039-e0e3be96447a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - COL_Morgue_Event_ReceiveUsSavedReward(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:ad62ed5b-ed60-5f4d-d039-e0e3be96447a
msgctxt "h55d716a0gb2a4g4a2cg9bd7gefdcea62693d"
msgid "<i>We will remain with you. Call Us, and we will be at your side.</i>"
msgstr "<i><b>어스</b>가 네 곁에 남아있을게. 불러준다면, 네 옆에 있을게.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Player
#. NodeID = b8f7646c-5ad6-778c-7dcd-6c3b62f494a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:b8f7646c-5ad6-778c-7dcd-6c3b62f494a2
msgctxt "hb0ca6bd8g2254g4628g951egac8263c8b107"
msgid "Let me think about it."
msgstr "생각 좀 해보고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us
#. Speaker = Us
#. NodeID = c6a02769-12d6-67a1-173b-0c835a18a846
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - COL_Morgue_User_HasMet_Us(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Morgue_Us:c6a02769-12d6-67a1-173b-0c835a18a846
msgctxt "hd46d121bga8f7g4e92g93aeg40e13df8d0e4"
msgid "<i>Friend, help Us! Free Us!</i>"
msgstr "<i>친구야, <b>어스</b>를 도와줘! <b>어스</b>를 풀어줘!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "hfd6341edgad65g4457g8011g927f364dd8e9"
msgid "To enthral so many that you need a nautiloid fleet... My word."
msgstr "노예를 그렇게 많이 부리려면 노틸로이드 함대가 필요할텐데... 맙소사."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "h81206f8cg6254g4049g99a8g282e5290227e"
msgid ""
"A fleet of nautiloids... I dread to think how many True Souls that equates "
"to."
msgstr "노틸로이드 함대라니... 참된 영혼을 대체 몇 명이나 만들었을지 생각하기도 싫군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "h38403e46g916eg4ff8g9739g3422cfb3f655"
msgid "A whole armada of nautiloids... enough for an army of 'True Souls'..."
msgstr "이게 다 노틸로이드 함대라니... '참된 영혼'으로 군대를 만들고도 남겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "h106aac75g66f3g4553g88a3g8e96fd9b623c"
msgid "A whole fleet of nautiloids. Here, on the Sword Coast."
msgstr "노틸로이드 대 함대가. 바로 여기 소드 코스트에 있다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "hef1c311bg7d72g4fdfgaec0gf920be089408"
msgid ""
"A whole fleet of <i>ghaik</i> nautiloids. How many thralls has the "
"'Absolute' infected?"
msgstr "<i>게이크</i> 노틸로이드 함대라니. '절대자'가 노예들을 얼마나 감염시킨 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "hcf4ba3a3g4e20g4b75gb38egc2b5594c5655"
msgid ""
"Nautiloids... a whole bloody <i>fleet</i> of them. They must have shipped "
"thousands of 'True Souls' through here."
msgstr "노틸로이드... 아주 그냥 함대를 만들었군. '참된 영혼'도 수없이 많이 데려왔을 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "h2455b735ge5aag41e4ga2a3gc2ff26a65e72"
msgid "A whole fleet of nautiloids. Enough for an army of True Souls."
msgstr "노틸로이드 함대라니. 참된 영혼으로 군대를 만들고도 남겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD
#. Speaker = Player
#. NodeID = d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Nautiloid_PAD:d0e3e55b-13bb-4ef2-a54b-15dfbf6dc790
msgctxt "hc2a75579ge6b1g4df5g850dg5a6db59521ca"
msgid ""
"A whole fleet of nautiloids. How many 'True Souls' have passed through this "
"place?"
msgstr "노틸로이드 함대라니. 얼마나 많은 '참된 영혼'이 여기에 내린 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_AD_Minthara_WitnessedBrainDevice
#. Speaker = Nightwarden Minthara
#. NodeID = 9ba44c2a-bbb1-801a-cc49-411d9b34aa51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_AD_Minthara_WitnessedBrainDevice:9ba44c2a-bbb1-801a-cc49-411d9b34aa51
msgctxt "h73665947gad80g4662gb04egf876a8983771"
msgid "A splendid device. All the benefits of a cleric, no gods required."
msgstr "뛰어난 장치군. 클레릭의 장점은 다 누리면서, 신을 모실 필요가 없다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Disembodied Voice
#. NodeID = 6bada9dd-3acd-733f-4b13-acacb4fb7746
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:6bada9dd-3acd-733f-4b13-acacb4fb7746
msgctxt "he0d9ca06g79d1g4f89g8083gb11c9361276b"
msgid ""
"-taken-\n"
"           -corrupted-\n"
"<b>-GONE-</b>"
msgstr ""
"-빼앗겼다-\n"
"           -더럽혀졌다-\n"
"<b>-사라졌다-</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Disembodied Voice
#. NodeID = 85cb556d-0cae-5a86-5768-8ea6b8cfc70b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:85cb556d-0cae-5a86-5768-8ea6b8cfc70b
msgctxt "hb114da97gb4adg4b3fg9bdcgf66148862d19"
msgid ""
"<b>-</b>every plane-\n"
"          <b>-AS ONE-\n"
"</b>-every being-\n"
"          <b>-IN THEIR PLACE</b>-"
msgstr ""
"<b>-</b>모든 차원-\n"
"          <b>-하나로-\n"
"</b>-모든 존재를-\n"
"          <b>-모든 곳에서</b>-"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Narrator
#. NodeID = b7d345ad-7650-4cbc-1673-83919665a18c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:b7d345ad-7650-4cbc-1673-83919665a18c
msgctxt "ha9fa42e6gb1beg42b1ga941gf6b2912cc829"
msgid "*That loss blooms into a sudden fury, burying claws in your mind.*"
msgstr "*상실감이 갑작스런 분노로 피어나고, 당신의 마음에 발톱을 박아 넣습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Lae'zel
#. NodeID = cace0bf4-0fc5-41a9-ad36-182ff549fb17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - COL_NecroLab_GrandDesignSculpture_HasMet_LaezelInclusion(1) = False
#. SetFlags:
#.   User:
#.     - COL_NecroLab_GrandDesignSculpture_HasMet_LaezelInclusion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:cace0bf4-0fc5-41a9-ad36-182ff549fb17
msgctxt "h1faae97cg68e1g4c48gaca5g3ccd9d04e842"
msgid ""
"<i>The Grand Design</i>. It is every githyanki's duty to ensure the "
"<i>ghaik</i> empire is never reborn."
msgstr "<i>원대한 설계</i>. <i>게이크</i>의 제국이 다시는 부활하지 못하도록 막는 것이 모든 기스양키의 의무지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Narrator
#. NodeID = d7f7cc67-7048-1e12-18cd-8a0f78441022
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:d7f7cc67-7048-1e12-18cd-8a0f78441022
msgctxt "he4838503g7c0dg4581g93d8g79fc1c399eab"
msgid ""
"*Your tadpole <i>echoes</i>. Not with presence, but memory - tinged with "
"loss.*"
msgstr "*당신의 올챙이가 <i>공명합니다</i>. 제단이 아니라, 기억과 공명합니다. 상실의 기미를 띤 기억입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Disembodied Voice
#. NodeID = d867790a-a599-39c5-1dcd-444a8c63acbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:d867790a-a599-39c5-1dcd-444a8c63acbc
msgctxt "hc0cd34cfgb9dcg42d0gabd7g0be15b28b93d"
msgid ""
"-<b>OUR-\n"
"</b>                     -destiny-\n"
"<b>-DESIGN-\n"
"                 </b>-downfall-"
msgstr ""
"-<b>우리의-\n"
"</b>                     -운명-\n"
"<b>-설계-\n"
"                 </b>-몰락-"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Narrator
#. NodeID = dcd3ed1c-8a85-b8fc-a31e-7305c4f807d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:dcd3ed1c-8a85-b8fc-a31e-7305c4f807d5
msgctxt "h56275c74g4236g4190g90degdbedfbedd8b8"
msgid ""
"*And just as suddenly, pain and memory are gone - leaving only stone once "
"more.*"
msgstr "*그리고는 갑자기, 고통과 기억들이 사라집니다. 오직 제단만이 남아 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Narrator
#. NodeID = e547e778-b1c6-aca2-f2e4-7e113341c677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:e547e778-b1c6-aca2-f2e4-7e113341c677
msgctxt "h26e293a9g74d3g4d59gac5dg3506792e73aa"
msgid ""
"*You know the scene. You've seen its like before. An altar to the Grand "
"Design - as close to god worship as any illithid colony gets.*"
msgstr ""
"*당신이 알고 있는 광경입니다. 이와 유사한 것을 본 적이 있습니다. 원대한 설계를 위한 제단입니다. 모든 일리시드 군락지의 신앙과 같은 "
"것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture
#. Speaker = Disembodied Voice
#. NodeID = f8aa34f0-f84f-4029-7089-3abbba9529a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecroLab_GrandDesignSculpture:f8aa34f0-f84f-4029-7089-3abbba9529a3
msgctxt "hba5d9fcbg2e61g4c8eg8aedgd172b67b94d7"
msgid ""
"<b>-THE GRAND DESIGN-\n"
"             -</b>order-\n"
"-perfection-\n"
"                <b>-UNITY-</b>"
msgstr ""
"<b>-원대한 설계-\n"
"             -</b>질서-\n"
"-완성-\n"
"                <b>-통합-</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_AD_AstarionImmune
#. Speaker = Astarion
#. NodeID = 2c959543-dfad-84c0-ef01-6bc96c8b142d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_AD_AstarionImmune:2c959543-dfad-84c0-ef01-6bc96c8b142d
msgctxt "h226f57edga0d9g4447g81b7g82ee09f9bddb"
msgid "Magic that drains life? Oh dear, someone's out of luck."
msgstr "생명력을 흡수하는 마법이라고? 세상에, 누군가는 아주 재수가 없었겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_AD_MintharaEntersLab
#. Speaker = Nightwarden Minthara
#. NodeID = 6b8f083d-652b-3cee-c5c8-967901336e34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_AD_MintharaEntersLab:6b8f083d-652b-3cee-c5c8-967901336e34
msgctxt "hab8aa6afgae97g4d36ga644gacb76b24539a"
msgid ""
"Whatever experiments Balthazar performed here, I fear he made more than "
"thralls and ghouls."
msgstr "발타자르가 여기서 무슨 실험을 했는지는 모르겠지만 노예나 구울보다 더한 걸 만들어낸 게 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_AD_Zombie
#. Speaker = Cal
#. NodeID = cdf55da2-b121-404c-a317-e34b8db9edc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_AD_Zombie:cdf55da2-b121-404c-a317-e34b8db9edc2
msgctxt "hc9534364gdc6ag48f0gb5b8gb2e4661fe75f"
msgid "*Groan.*"
msgstr "*그어어.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "haece39eeg52e4g4b21g9562gdceaf87a1701"
msgid ""
"I don't know what's happening there, but I'm glad it's not happening to me."
msgstr "저기서 무슨 일이 일어지고 있는지 모르겠지만, 나한테는 그런 일이 일어나지 않아서 다행이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "h5f660dbcgaaefg4cd5gab13g70ea0625d89c"
msgid "I'm not sure what this is, but I am very sure it's not good."
msgstr "이게 뭔지는 모르겠는데, 좋은 게 아니란 건 확실해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "h6769c2f3g4d6ag4662g8622gb1a06b37d377"
msgid "A foul-seeming place. Nothing good can come from lingering here."
msgstr "추악한 장소로군. 여기 있어봤자 좋은 일은 없겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "hd890cf2ag5a24g4318g987cgfbb9d52aa908"
msgid "That doesn't look good."
msgstr "좋아 보이지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "hc1b1ec2age1e8g4a23g9207g63b732cb32a5"
msgid "I do not know what this magic is. And I am in no hurry for answers."
msgstr "이게 무슨 마법인지 모르겠네. 그래도 당장 무엇인지 알아야 할 필요는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "ha96537f4g1af1g4989g8b2bg9da1a324a1f9"
msgid "Not sure what this is... but I don't think I'm in a rush to find out."
msgstr "무슨 마법인지 잘 모르겠지만... 어떤 마법인지 서둘러 알아야 할 필요는 없어 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "ha251d2ccg45dcg4f75g9a6cg770a7ae4a55c"
msgid "Steer clear. Whatever this is, we want no part of it."
msgstr "피해서 가자. 뭐가 됐던 간에, 엮이지 않는 게 상책이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "hd5d68135g96aag4f6ag9adegcebc0707fbeb"
msgid "What in the deepest Hells is going on here?"
msgstr "이 깊은 지옥에서 도대체 무슨 일이 벌어지고 있는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 2d3f5766-dccc-4b25-b55b-3180b1ce9012
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:2d3f5766-dccc-4b25-b55b-3180b1ce9012
msgctxt "h42d67adcgb344g4226g8966g447c19e5cd22"
msgid "Curious setup. Think I'll keep my distance."
msgstr "이상한 구조야. 거리를 둬야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "h81c662bdgb0a3g488dg9adfg5d8315962d85"
msgid ""
"Good old-fashioned necromancy - draining people of life until they're just "
"undead husks."
msgstr "오래됐지만 괜찮은 사령술이야. 언데드가 될 때까지 생명력을 빨아들이는 마법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "h44d9f197gf43ag4574ga948g8638d9be608b"
msgid ""
"Necromancy. Looks like the victims are being drained of life and put to work."
msgstr "사령술이야. 희생자의 생명력을 빨아들인 뒤에 조종하는 용도로 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "h0502ff9cg26e0g49c4g9f95g95c50b85e0df"
msgid ""
"Necromantic rites. The victims are being leached of all life, and left as "
"undead slaves."
msgstr "사령술 의식입니다. 희생자들은 모든 생명력을 빼앗기고 언데드 노예가 됩니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "hc6598f2ag5b37g45ebgaa0ag9138b4b1fef6"
msgid ""
"It's a necromantic ritual. Drains the life out of people and leaves them as "
"mindless undead."
msgstr "이건 사령술 의식이야. 사람들의 생명력을 뽑아내고 의지 없는 언데드로 만들지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "h23ef5ce5g6894g4a14g9631g52599c7f0f68"
msgid ""
"Ritual necromancy - essence is drained from the living to turn them undead."
msgstr "사령술 의식이야. 살아있는 생명체를 언데드로 만들기 위해 정기를 뽑아내지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "h240abd80gdb28g407eg8d1aga0af8f696b55"
msgid "Looks like necromancy - smells like it too. Turning people into undead."
msgstr "냄새도 그렇고, 사령술 같아 보이는데. 사람들을 언데드로 만드는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "hcb8e73d0g4f4fg4225gb9e9g43852292cb8d"
msgid "Deplorable. The living are made undead, without even dying first."
msgstr "통탄스럽도다. 아직 죽지도 않은 사람들을 언데드로 만들어 버리다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#. TagRule: CLERIC_MYRKUL or PALADIN_MYRKUL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "hfc427990g70bdg41e6ga585g113977d2ea28"
msgid "This is meant to render people undead - <i>glorious!</i>"
msgstr "사람들을 언데드가 되게 하는 술식이군. <i>거룩하도다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea
#. Speaker = Player
#. NodeID = 97678dae-7927-daf0-2b0e-6684312f0f4f
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_NecromancerLab_State_PassedRitualArcana = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_NecromancerLab_PAD_RitualArea:97678dae-7927-daf0-2b0e-6684312f0f4f
msgctxt "h210ceb7fg9ce2g41b6g90fegbfd63e2544a7"
msgid "A ritual space. To turn the living undead, looks like."
msgstr "살아있는 사람을 언데드로 만들기 위한 마법 의식 공간으로 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_ResendZombie
#. Speaker = Balthazar
#. NodeID = 57afee96-a173-e2f9-b69a-79d94bbc0b38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9d0ddaf8-3f55-4255-3297-42521cfb8a5c_HappenedOnce = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_ResendZombie:57afee96-a173-e2f9-b69a-79d94bbc0b38
msgctxt "h859570beg6e2dg43cfg8115ga8e1e9d96eb8"
msgid "Relight the candles - go!"
msgstr "촛불을 다시 켜라, 어서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_ResendZombie
#. Speaker = Balthazar
#. NodeID = 9f8271f1-61e6-4e51-8ddd-85ed90896d6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9d0ddaf8-3f55-4255-3297-42521cfb8a5c_HappenedOnce = False
#. SetFlags:
#.   Local:
#.     - 9d0ddaf8-3f55-4255-3297-42521cfb8a5c_HappenedOnce = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_ResendZombie:9f8271f1-61e6-4e51-8ddd-85ed90896d6e
msgctxt "hb98c7e47gf21ag4433gbc7bg9007461697af"
msgid "Don't just stand there - get those candles lit!"
msgstr "멀뚱히 서 있지 말고, 가서 촛불을 켜!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_SendZombie
#. Speaker = Balthazar
#. NodeID = 16e1b3ff-e15c-4452-9fbe-ba69e2c3304f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_NecromancerLab_State_CandleLighterChosen = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_SendZombie:16e1b3ff-e15c-4452-9fbe-ba69e2c3304f
msgctxt "h6925f0dcg361ag4b46gb212g61afe8f264a3"
msgid "Go, light the candles!"
msgstr "가서 초에 불을 붙이라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_SteelWatchers
#. Speaker = Balthazar
#. NodeID = c1efa1cf-bb41-a956-7986-0dea50ca1463
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Combat_SteelWatchers:c1efa1cf-bb41-a956-7986-0dea50ca1463
msgctxt "h24d6dc74g4358g407ag9d65g230eb073e898"
msgid ""
"Unafraid of a fight - good. Perhaps we'll salvage your remains for a Steel "
"Watcher."
msgstr "싸움을 두려워하지 않다니, 좋다. 네 시체를 스틸 워치로 만들어주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Haruspicy
#. Speaker = Balthazar
#. NodeID = 2bc95026-d77c-45e6-8bfb-3884d04cb408
