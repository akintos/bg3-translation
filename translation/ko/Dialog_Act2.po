#.     - MOO_Assault_AssaultFlamingFist_001_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001:cd4d8f10-c8ea-4846-b28f-07db0c94298c
msgctxt "h490954deg9f8eg436fg80c0g6be96fbbb33b"
msgid "Give no quarter. The time for that's passed."
msgstr "자비를 베풀지 마라. 그럴 시간은 이미 지나갔으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001
#. Speaker = Fist Nipawa
#. NodeID = f5eb6bc9-764b-405c-9521-706ff97c2ca8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_001_PostAssualt_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_001:f5eb6bc9-764b-405c-9521-706ff97c2ca8
msgctxt "hbde55945g050bg4b05gabe6gb444f84a4d97"
msgid ""
"Seems you'll be the one to save the Duke. Maybe we can split the bonus, hm?"
msgstr "대공을 구하게 될 사람은 바로 너일 것 같은데. 보상을 나눠 갖는 건 어때, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002
#. Speaker = Fist Helena
#. NodeID = 04e86789-0863-4bf3-9df3-432e3285387e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_002_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_002_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002:04e86789-0863-4bf3-9df3-432e3285387e
msgctxt "h1c047515gd3c3g405cg8b1bgc8a4e2060c54"
msgid "Come on. Plenty more to do yet."
msgstr "서둘러. 아직 할 일이 많다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002
#. Speaker = Fist Helena
#. NodeID = 21eb2a9b-1d16-4616-96ee-b7d131c965a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_002_PostAssault_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_002_PostAssault_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002:21eb2a9b-1d16-4616-96ee-b7d131c965a8
msgctxt "h8ed0950cg7cc1g479fgaecbga8a17340c225"
msgid ""
"That can't be the last of them. Wherever they're hiding, we'll root them out."
msgstr "저게 전부일 리가 없어. 어디 숨어 있는 지는 몰라도, 우리가 뿌리를 뽑아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002
#. Speaker = Fist Helena
#. NodeID = 340e947c-62ff-42c4-8566-80892b125178
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_002_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002:340e947c-62ff-42c4-8566-80892b125178
msgctxt "hbedd0ad4g1e43g4a49gbc3ag3387446337f6"
msgid "<i>Break</i> them."
msgstr "<i>부숴버려.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002
#. Speaker = Fist Helena
#. NodeID = d8320f57-a804-4a9f-b8fb-f229a7d1ecb1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_002_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002:d8320f57-a804-4a9f-b8fb-f229a7d1ecb1
msgctxt "hb0b847dag26afg4f50gb8fegacc060d2cae6"
msgid "Taking on a tower with no siege engines. Wonderful."
msgstr "공성 무기 없이 탑을 점령했네. 멋져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002
#. Speaker = Fist Helena
#. NodeID = e72d63ab-cb68-4db4-b365-02c231b79663
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_002_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_002_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002:e72d63ab-cb68-4db4-b365-02c231b79663
msgctxt "hd1bd84d5gbe0fg48c5gb90bga58e2e4abb81"
msgid ""
"We have the High Harper. I suppose that's almost as good as a trebuchet."
msgstr "우리한테는 고위 하퍼가 있지. 이제 보니 트레뷰셋 만큼이나 효과적인 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002
#. Speaker = Fist Helena
#. NodeID = f3f7b8a9-72fa-4566-8652-53410146d1f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_002_PostAssault_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_002:f3f7b8a9-72fa-4566-8652-53410146d1f1
msgctxt "he6232735g7e2ag41b2g92e6g3dccf14dc846"
msgid "Stay sharp. All it takes is one stray arrow."
msgstr "정신 바짝 차려. 눈먼 화살 한 방이면 누구든 저세상 가는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003
#. Speaker = Fist Rhed
#. NodeID = 1d6f3880-dffd-4ce2-99d8-891ca1443b6a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_003_ThroneRoomDefeated_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_003_ThroneRoomDefeated_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003:1d6f3880-dffd-4ce2-99d8-891ca1443b6a
msgctxt "h80ff2780g1e7eg4cedg9a52gfbcb5a03e08c"
msgid "Upwards!"
msgstr "윗층으로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003
#. Speaker = Fist Rhed
#. NodeID = 7f7aa008-c2a0-4112-a880-4dd6d2a8cc69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_003_PostAssualt_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_003_PostAssualt_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003:7f7aa008-c2a0-4112-a880-4dd6d2a8cc69
msgctxt "hf5ceb100g13a9g4902gbe68g604f08895cf1"
msgid ""
"I hope you find whatever rock Ketheric has crawled under. This land deserves "
"to see the light again."
msgstr "케서릭이 숨은 곳을 찾길 바라. 이 땅은 다시 빛을 볼 자격이 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003
#. Speaker = Fist Rhed
#. NodeID = be7f03a3-6b49-4ecd-95c3-c6541bb0a0a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_003_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_003_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003:be7f03a3-6b49-4ecd-95c3-c6541bb0a0a2
msgctxt "hd4f8750dg83e2g427egaad5g7ee2d57779cf"
msgid ""
"That thing that cut a trail for us... I almost forgot what true light looked "
"like."
msgstr "우리에게 길을 열어준 그 존재 말이야... 진짜 빛이 어떤 느낌이었는지조차 까먹을 뻔했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003
#. Speaker = Fist Rhed
#. NodeID = e3875945-24d2-4798-8b26-6070ed4a2e36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_003_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_003_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003:e3875945-24d2-4798-8b26-6070ed4a2e36
msgctxt "h1a031c30g3e76g4c01gbe87g1827b06eafa2"
msgid "I'll fight my way to the tower-top, if only to see that light again."
msgstr "그 빛을 다시 볼 수 있다면, 탑 꼭대기까지 싸우겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003
#. Speaker = Fist Rhed
#. NodeID = e7a5a3ce-9bd5-4fb0-b638-e65f8a479183
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_003_PostAssualt_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003:e7a5a3ce-9bd5-4fb0-b638-e65f8a479183
msgctxt "hc90c5de7gbbaag46e7g91e4ga1c18ad1e909"
msgid "May Tyr guide you true."
msgstr "티르가 인도하기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003
#. Speaker = Fist Rhed
#. NodeID = f80854b0-07ee-b27a-9e06-8d9db042d24b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_003_ThroneRoomDefeated_HasMet(1) = True
#.   Global:
#.      - MOO_Assault_State_ThroneRoomDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_003:f80854b0-07ee-b27a-9e06-8d9db042d24b
msgctxt "hbf5fe1d9g0e4ag475dg9840g6ba541939abd"
msgid "You lead - we'll follow."
msgstr "앞장서 - 따라갈게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004
#. Speaker = Fist Hadenwell
#. NodeID = 0a71aac2-244c-4037-889f-82b207bc5b25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Assault_AssaultFlamingFist_004_PostAssault_HasMet(1) = False
#.   Global:
#.      - MOO_Assault_Event_KethericTeleportedAway = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Assault_AssaultFlamingFist_004_PostAssault_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004:0a71aac2-244c-4037-889f-82b207bc5b25
msgctxt "h9811a3b6g5621g4cb6ga291g18213942f656"
msgid "We'll hold this point. Give Ketheric our regards, aye?"
msgstr "우린 여길 지키고 있을게. 케서릭한테 대신 안부나 좀 전해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Assault_AssaultFlamingFist_004
#. Speaker = Fist Hadenwell
#. NodeID = 5473159e-7fb7-a937-dd77-8afb7a72905a
