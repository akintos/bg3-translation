msgctxt "hd52c8820gb751g4392gb430g6ab939e1505f"
msgid "What's this place? It's been spared the shadow curse..."
msgstr "여긴 뭐지? 그림자 저주가 들어오지 못하는군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_EnteredSanctuary
#. Speaker = Player
#. NodeID = 2ad4b496-33c7-4ee7-8493-36533fa9fe16
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_EnteredSanctuary:2ad4b496-33c7-4ee7-8493-36533fa9fe16
msgctxt "h130273ebg5321g4a3eg80f2gb1bfcb9d8229"
msgid "No curse in here. Wonder why."
msgstr "여긴 저주가 안 통하네. 이유가 뭘까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_EnteredSanctuary
#. Speaker = Player
#. NodeID = 2ad4b496-33c7-4ee7-8493-36533fa9fe16
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_PAD_EnteredSanctuary:2ad4b496-33c7-4ee7-8493-36533fa9fe16
msgctxt "hbd6be49dge494g4c92gad52ge10e7e343cea"
