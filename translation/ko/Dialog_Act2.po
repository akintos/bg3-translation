msgctxt "h3f6f3d0fg4a31g4566gac31g1b991cd08bb6"
msgid "We will tear them, Majesty! RIP THEM!"
msgstr "갈가리 찢어버리겠습니다, 폐하! 죽여라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Drider_AD_Combat
#. Speaker = Kar'niss
#. NodeID = 7929ea51-d898-4582-91c5-489fde407705
