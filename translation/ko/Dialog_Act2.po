msgid "*Hiss.*"
msgstr "*시이익.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = f845e2cf-4d21-f765-04a7-8b37109004b7
