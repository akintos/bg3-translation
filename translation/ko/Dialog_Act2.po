msgctxt "h1c8ad9ddg0c9ag4661g8a1eg8d7e5051b62c"
msgid "*An illithid console, dull and inert - to you, at least.*"
msgstr "*일리시드 콘솔 하나가 전력 없이 잠들어 있습니다. 적어도 당신에게는 그렇습니다.*"

