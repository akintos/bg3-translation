msgctxt "h460f582agef23g4ccag9657gd0fa3aa844df"
msgid "Who put you in that pod?"
msgstr "누가 당신을 저 포드에 넣었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_TadpolingCentre_Zevlor_Dead
