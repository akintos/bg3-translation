msgctxt "hb54c6965g2481g4d21g9a9ag48e91d0c5748"
msgid "I do."
msgstr "난 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_FountainGuards_ThreeWay
#. Speaker = Harper Essius
#. NodeID = fed54c7d-5dca-6844-8922-7e10d7d64e79
