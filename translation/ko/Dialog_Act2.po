msgctxt "he55eb549g2616g44d5gbfa1g319fc525feaf"
msgid "The boat! Get to the damn boat!"
msgstr "배! 망할 배에 타!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ProdigySister
#. Speaker = Lia
#. NodeID = b80536e1-1e50-4ede-9488-3366a9106956
