msgctxt "h3ae4c077gb7c8g4c86gb1b7gabbfd6465023"
msgid "That disc can move, I'll wager."
msgstr "저 원판은 움직일 거야. 내가 장담하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 8d8d45ed-1d96-44da-a07a-5ef781d606be
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players:8d8d45ed-1d96-44da-a07a-5ef781d606be
msgctxt "ha7fa02b9g90d0g4fe8gb4afg56d5971cd01c"
msgid "That disc looks like it can move - a way forward?"
msgstr "원판이 움직일 것 같아 보이는데, 저게 길인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 90bc4890-500a-4084-8994-ebbf5f78dea4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players:90bc4890-500a-4084-8994-ebbf5f78dea4
msgctxt "h2c16c1d1gf305g4578ga43ege9a1860f3085"
msgid "But where will it take us?"
msgstr "근데 어디로?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_FoundDisc_2Players
#. Speaker = Player
#. NodeID = 90bc4890-500a-4084-8994-ebbf5f78dea4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
