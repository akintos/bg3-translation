msgctxt "hcb582597g0332g4cc1ga1f9g187c86c4e82b"
msgid "The General has descended from his chapel."
msgstr "장군께서 예배당으로 내려오셨군 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Sumera
#. NodeID = 3ea7b946-570c-4ac7-9be9-08f6c5786198
