msgctxt "h7524178ag87cdg4ce8g9c3dg13518c05f2b3"
msgid ""
"*The mind is connected to another - it can only sustain a single connection "
"at a time.*"
msgstr "*장치의 정신이 다른 곳에 연결되어있습니다 - 정신은 한 번에 하나의 연결만 유지할 수 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Vault_Puzzle
#. Speaker = Narrator
#. NodeID = bf4ad687-96a7-00ef-aa57-f46cb5bc842a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Vault_Puzzle:bf4ad687-96a7-00ef-aa57-f46cb5bc842a
msgctxt "hc8615985gc49cg41a0g9705g68a241d693e0"
msgid ""
"*It is... incomplete. It yearns to connect - but needs you to guide the "
"process, linking each part of your mind to its like.*"
msgstr "*아직... 불완전합니다. 장치의 정신은 연결을 갈망하며, 당신의 마음 각 부분을 장치에 알맞게 연결해줄 지시를 기다립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Vault_Puzzle
#. Speaker = Narrator
#. NodeID = d6d3132a-fcb2-8ac2-68ae-0fcea04cfa99
