msgctxt "hdac52e92g6c7dg42begb097g8249676a8c3e"
msgid "The shadows are hungry - and Shar won't help me now."
msgstr "그림자가 굶주렸어. 그리고 이제 샤님은 날 돕지 않으실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 531682ca-cc74-d4b2-0507-d7a6a828e455
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:531682ca-cc74-d4b2-0507-d7a6a828e455
msgctxt "h335d4ad2g60c2g40adga153ga40daa1698cb"
msgid "The dark feels hungry - like it'd drain you dry."
msgstr "어둠이 굶주린 게 느껴져... 다 빨아먹을 기세야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 531682ca-cc74-d4b2-0507-d7a6a828e455
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4ca7d7ab-9b51-31d8-22be-0e26b2a7f3ed_A = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:531682ca-cc74-d4b2-0507-d7a6a828e455
msgctxt "h28c4c0fcg60c1g438ag9e2fg3ddcc75ed5d7"
msgid "The shadows... feels like they're gnawing at my very being."
msgstr "이 그림자가... 내 존재 자체를 갉아먹는 것처럼 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 531682ca-cc74-d4b2-0507-d7a6a828e455
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
