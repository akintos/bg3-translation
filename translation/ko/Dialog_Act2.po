msgctxt "h7c0d1af6g4816g483cg8ab2g7bae05fef995"
msgid "Can't keep anything lit in this curse."
msgstr "이 저주 안에선 아무것도 불붙일 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
