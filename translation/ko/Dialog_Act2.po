#.   Tag:
#.      - ILLITHID_HIDDEN_CHECK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:643fbd80-9f45-c410-2d01-383bb8180a35
msgctxt "hc2660c51gf210g4b7cg976dg755fa3fb0c87"
msgid "I seek your blessing."
msgstr "전 당신의 축복을 구하고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Kressa Bonedaughter
#. NodeID = 6f968e0c-ad0c-451b-9ff7-615b160a6bbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:6f968e0c-ad0c-451b-9ff7-615b160a6bbd
msgctxt "h759c5830g5aa6g4045g8d5fg75f38688c411"
msgid "You are on sanctified ground. Speak only if you must."
msgstr "넌 신성한 땅 위에 서 있어. 꼭 필요한 말만 하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Player
#. NodeID = 70bd8535-5947-8e1a-6e2a-4f780557fa15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - COL_Barracks_State_CharacterWasBlessed(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:70bd8535-5947-8e1a-6e2a-4f780557fa15
msgctxt "h2fe2a502ga900g4d1dga12dg4ab114e3e5d8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Player
#. NodeID = b74fb1bb-f5c6-0204-a94a-dfe09979ae7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:b74fb1bb-f5c6-0204-a94a-dfe09979ae7e
msgctxt "h1628afe0g70e7g45c5g87e4gbc011916de44"
msgid "I must find General Thorm."
msgstr "전 쏨 장군을 찾아야만 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Kressa Bonedaughter
#. NodeID = c5d54213-1f38-5f66-1394-1c67bb0f863b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - COL_Barracks_State_CharacterWasBlessed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:c5d54213-1f38-5f66-1394-1c67bb0f863b
msgctxt "hb0cfa048g3d10g4095g8730gbe0f21954568"
msgid "His shadow falls across you. Go forth and reap."
msgstr "그분의 그림자가 너를 향해 드리웠다. 나아가라 그리고 쟁취하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Kressa Bonedaughter
#. NodeID = dc5129bf-a1dc-d3bb-1ebf-1fc842d86a3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:dc5129bf-a1dc-d3bb-1ebf-1fc842d86a3c
msgctxt "h991999f9g4f47g4032g884egcad177f1d644"
msgid ""
"It is not <i>my </i>blessing - I am merely a vessel for our Lord Myrkul's "
"will."
msgstr "<i>나</i>의 축복이 아니다. 난 그저 머큘님의 의지를 담는 그릇에 불과할 뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 18b7e7b6-6f09-4be0-5686-2b2b76f51edc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:18b7e7b6-6f09-4be0-5686-2b2b76f51edc
msgctxt "h2ef580e3gaf2dg4a9dg9ab0g07c988f3c224"
msgid "Come - I will make better use of your bones than you do."
msgstr "이리와, 네놈의 뼈를 내가 지금보다 훨씬 더 유용하게 써주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Kressa Bonedaughter
#. NodeID = 0fe3765b-a053-480f-bb1f-f95d9bd702a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:0fe3765b-a053-480f-bb1f-f95d9bd702a9
msgctxt "h71131c65ge77dg469fgb634gca0e6bdb2b07"
msgid ""
"I shall present your bones to General Thorm as retribution for what you did "
"to him."
msgstr "네가 그에게 한 짓에 대한 대가로 네놈의 뼈를 쏨 장군께 선물로 바치겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 1af9de5d-384f-81ed-c662-fccd47f5e645
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:1af9de5d-384f-81ed-c662-fccd47f5e645
msgctxt "hb5fb5c25gfb3ag41d7ga0ecg856c91ad0cba"
msgid "And yet I have noticed you, and I do not like what I see."
msgstr "그럼에도 나는 내게 관심을 가졌는데, 네가 맘에 안 드는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Kressa Bonedaughter
#. NodeID = 2efb7fff-d24b-4dc9-9348-14245d5710fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:2efb7fff-d24b-4dc9-9348-14245d5710fb
msgctxt "h3db05c34gda8dg4d5cga530ga9c1e31e6dd2"
msgid "<i>Lies!</i>"
msgstr "<i>거짓말!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Player
#. NodeID = 3a3167c5-c1f6-aed5-3bbe-12746fca89fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID_HIDDEN_CHECK(1) = True
#. SetFlags:
#.   Global:
#.     - COL_Barracks_State_InterruptConvinced = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:3a3167c5-c1f6-aed5-3bbe-12746fca89fa
msgctxt "h6e6e8b95g08e9g4ef6g914dgaf6d77f90a8a"
msgid "I am a True Soul."
msgstr "나는 참된 영혼이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Player
#. NodeID = 34b42cc7-8945-4520-a0f6-f23d97969982
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID_HIDDEN_CHECK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:34b42cc7-8945-4520-a0f6-f23d97969982
msgctxt "had0ac79cgaf4eg410bga967g7cd2276ad4e8"
msgid "You should be careful, throwing such accusations at a True Soul."
msgstr "조심하는 게 좋을 거다. 참된 영혼에게 그런 혐의를 제기한다니.."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Player
#. NodeID = 448ae3cd-4b1b-a91d-7124-5da04c17d1c3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:448ae3cd-4b1b-a91d-7124-5da04c17d1c3
msgctxt "h1f66d3f2g4241g469ega16cgc9f084a1109f"
msgid "I am unworthy of your notice - a nobody."
msgstr "난 관심 가질 만한 가치가 없어. 난 아무도 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Player
#. NodeID = 43b243ef-09b5-4314-9626-9d0748ed8ea1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:43b243ef-09b5-4314-9626-9d0748ed8ea1
msgctxt "hd6b28722g2f9ag448agbf8bgc728fa856cd4"
msgid ""
"This is a misunderstanding. I was sent to support you with the eradication "
"of these traitors."
msgstr "오해다. 난 이 반역자들을 박멸하는 것을 돕기 위해서 파견된 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 6f81ad8d-746d-6a39-d75f-5daf8610aa2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:6f81ad8d-746d-6a39-d75f-5daf8610aa2c
msgctxt "h7b0d7b57gbdefg47edgb564g5f186fc6a255"
msgid ""
"The order to leave has been given, True Soul. Report to the ships and leave "
"us be."
msgstr "철수 명령이 내려졌다, 참된 영혼이여. 우리는 내버려두고 함선에 가서 보고하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Kressa Bonedaughter
#. NodeID = 57aed9d1-8e37-4100-851e-491da43e24ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:57aed9d1-8e37-4100-851e-491da43e24ac
msgctxt "h36cf0d84g186dg4f63gb5deg1c398a65dece"
msgid ""
"Trying to pull <i>rank</i>? And yet not a word of concern for our dear "
"General."
msgstr "<i>계급</i>으로 밀어붙이는 건가? 그런데도 경애하는 장군님을 걱정하는 말 한마디가 없구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 947f7eff-60ad-50f4-6668-e46ff773828d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Necromancer_State_AtMoonrise = True
#. SetFlags:
#.   Dialog:
#.     - COL_Barracks_Mistress_Knows_ThinksPlayerIsThrall(1) = True
#.   Global:
#.     - COL_Barracks_State_InterruptConvinced = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:947f7eff-60ad-50f4-6668-e46ff773828d
msgctxt "h227f165agd208g4998gbe8bgd77695722fbf"
msgid "Return to Balthazar - he may be able to correct your defects."
msgstr "발타자르에게 가보거라, 네 결함을 고쳐줄 수도 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Kressa Bonedaughter
#. NodeID = 93ced493-b790-4bf4-a457-fc3b95ab55f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Necromancer_State_AtMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:93ced493-b790-4bf4-a457-fc3b95ab55f1
msgctxt "h6338e649g4dc4g41edg84bcgb13b7abf6a18"
msgid "Go find Balthazar - he always has use for another body."
msgstr "발타자르를 찾아가라. 그는 항상 시체를 필요로 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 9ca9be91-bba1-a10c-0d04-829ae94ddb52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:9ca9be91-bba1-a10c-0d04-829ae94ddb52
msgctxt "hac206faagf79bg4c6aga357gcd6ddd122bbc"
msgid "Tsk. A defective thrall that should have had its tongue removed."
msgstr "쯧. 혀를 뽑아버려야 할 결함을 가진 노예로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Kressa Bonedaughter
#. NodeID = b6c8a9a2-80c4-4646-beb7-96ef66ca4fc4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_Barracks_Mistress_Knows_ThinksPlayerIsThrall(1) = True
#.   Global:
#.     - COL_Barracks_State_InterruptConvinced = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:b6c8a9a2-80c4-4646-beb7-96ef66ca4fc4
msgctxt "hfda91353g81b2g442bg90bege67320e74cc5"
msgid "I have no need for a thrall - you would merely get in the way."
msgstr "노예는 필요 없다. 넌 방해만 될 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = b24dece1-6a6a-bd5b-fdd0-41f387ca24ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_Barracks_Mistress_Knows_ThinksPlayerIsThrall(1) = True
#.   Global:
#.     - COL_Barracks_State_InterruptConvinced = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:b24dece1-6a6a-bd5b-fdd0-41f387ca24ee
msgctxt "h76ff7fdfg2c61g4f92g98adgd4e5516fa2e6"
msgid "We are preparing to leave. Make yourself useful below."
msgstr "우린 막 떠나려는 참이다. 당장 내려가서 너의 유용함을 증명하거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Kressa Bonedaughter
#. NodeID = bdc99b8e-e048-4d38-adc5-d1df9fbf416b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:bdc99b8e-e048-4d38-adc5-d1df9fbf416b
msgctxt "hc1ec9707gab50g4f37ga1eag8c12a03ff49f"
msgid ""
"Go on, make yourself useful somewhere. If you cannot manage that, just stay "
"out of the way."
msgstr "가라, 다른 곳에서 네 유용함을 증명해라. 그렇게 못하겠다면, 그냥 다른 데 박혀 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Kressa Bonedaughter
#. NodeID = e0d0393d-f96e-4d80-bca8-64953052b869
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:e0d0393d-f96e-4d80-bca8-64953052b869
msgctxt "he74ddc0bgbf7eg4fc5ga78eg1fe2c9d1112a"
msgid ""
"General Thorm was attacked, the order to evacuate given. You should not be "
"here. I conclude you are one of the attackers."
msgstr ""
"쏨 장군이 공격 당했고 퇴각 명령이 내려졌지. 그렇기에 이곳에 있으면 안돼. 그렇다면 네놈이 습격자들 중 한 명이라고 결론지어 지는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Player
#. NodeID = e2e53cb6-f575-4d5e-3778-5ac1cd94c650
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:e2e53cb6-f575-4d5e-3778-5ac1cd94c650
msgctxt "hce4efdffg3edag4d7dg9a24g7c8c02032d0d"
msgid "Let's find out how 'undying' you really are."
msgstr "그럼 정말로 '불멸'인지 확인해볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert
#. Speaker = Player
#. NodeID = e87b80f0-d690-47bb-8005-95d278b0be66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_HighAlert:e87b80f0-d690-47bb-8005-95d278b0be66
msgctxt "hc89564b2g3f73g4dc8g9545g717f24c672c3"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Player
#. NodeID = 123ec3df-3dd4-c5d0-0b23-68e7863ae7e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:123ec3df-3dd4-c5d0-0b23-68e7863ae7e9
msgctxt "hb4574df8gc583g4d45g8189g640f37586b3c"
msgid "Apologies - I didn't mean to interrupt."
msgstr "사과하지, 방해할 생각은 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 571d53bb-5330-7294-3a45-6e9791f66465
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:571d53bb-5330-7294-3a45-6e9791f66465
msgctxt "hea8e0736gb527g41bbg94a3gb6a8996a73b9"
msgid ""
"Halt. Who are you, pretty dead thing, that interrupts this consecration of "
"the undying?"
msgstr "멈춰라. 불멸의 의식을 방해하는, 거의 죽은 자인 너는 누구인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 627901bd-13a1-a04b-d406-3f6233eb5bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:627901bd-13a1-a04b-d406-3f6233eb5bb6
msgctxt "ha82510ebg4c27g477fgba9dg3eaee2295056"
msgid "And yet you did. Answer me - who are you?"
msgstr "그럼에도 방해를 했구나. 대답해라, 넌 누구냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = 87617505-e1af-2583-5f02-44027aea8a45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:87617505-e1af-2583-5f02-44027aea8a45
msgctxt "ha9e19bf2g05f5g4b96gb345gb54e4afeac44"
msgid "A defective thrall."
msgstr "고장이 난 노예로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing
#. Speaker = Kressa Bonedaughter
#. NodeID = ea407155-46db-4322-9faf-07145a9da991
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_InterruptBlessing:ea407155-46db-4322-9faf-07145a9da991
msgctxt "h8743c9ccg156fg43edgaf76gd27bf8af153f"
msgid ""
"Halt. Who are you, warm of blood and quick of heart, that interrupts this "
"consecration of the undying?"
msgstr "멈춰라. 따뜻한 피와 뛰는 심장을 가지고 불멸의 의식을 방해하는 너는 누구인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 043397fa-5591-41cd-f8e3-9586b845c959
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:043397fa-5591-41cd-f8e3-9586b845c959
msgctxt "hdf1e94d4gcecag468fgbbe1g4a2a3d6b814f"
msgid "Why bother to tell you this, though? You surely can't understand."
msgstr "너에게 왜 설명 해줘야 하지? 어차피 알아듣지 못 할텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 069fa306-09a1-4eb4-1f43-ed8f25c952b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:069fa306-09a1-4eb4-1f43-ed8f25c952b2
msgctxt "h7039cdddgd6d8g48c7ga5b2g82b44e3584e5"
msgid ""
"I remember finding you close to death, beaten black and blue on the floor of "
"this sanctum. It must have been a few hours after the tadpole was placed in "
"your skull."
msgstr ""
"성소 바닥에 온 몸에 멍을 달고 죽기 직전이던 너를 찾던 때가 기억나는군. 올챙이가 너의 머리에 들어가고 몇 시간 지나지 않아서였겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 07060e50-b3e9-0cb3-4931-f2b904000b2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:07060e50-b3e9-0cb3-4931-f2b904000b2e
msgctxt "h2e4cfcceg646dg415dg9014gb57a0802f118"
msgid ""
"This won't hurt a bit, though I don't suppose you can feel much now, anyway."
msgstr "조금도 아프지 않을 거야, 어차피 지금 감각이 별로 없겠지만 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 0ab525d3-6122-a88e-7edf-5ba1a32b8164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:0ab525d3-6122-a88e-7edf-5ba1a32b8164
msgctxt "hf08eb571g2271g43acg88b6gf6555672ab2e"
msgid "The most important work, the nature of which I only heard whispers of."
msgstr "가장 중요한 일이나, 그 본질은 은밀히 전해지는 소문으로만 들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = GROUP_ORI_DU
#. NodeID = 128a162e-968d-0ca8-06d7-62e0aa9df166
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:128a162e-968d-0ca8-06d7-62e0aa9df166
msgctxt "h83f5ac0ag757cg45f4g9384gc110fa16abe0"
msgid ""
"<i>Play dumb - let her believe you lost your wits along with your memory.</i>"
msgstr "<i>바보 행세를 한다- 그녀로 하여금 내가 기억과 함께 잔머리도 잃어버린 것처럼 믿게 만든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 12edd764-c384-42e9-8f51-2c20163c0dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:12edd764-c384-42e9-8f51-2c20163c0dd3
msgctxt "h44b59bafg2de7g4cbdg87a5gf0f7875832ec"
msgid ""
"I don't know what you're talking about, but you're going to tell me "
"everything."
msgstr "네가 무슨 소리를 하는지 잘 모르겠지만, 모조리 털어놔야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 12fa985a-98a4-faca-d234-7bc19638360e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:12fa985a-98a4-faca-d234-7bc19638360e
msgctxt "h691b2127ge44bg4aacgbbafgff7bf642c55f"
msgid "Wait... By the Bone Lord, it's you!"
msgstr "잠깐... 뼈의 군주님 맙소사, 너구나!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 1973f164-278a-475d-8f6b-bf28bfb7d8fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:1973f164-278a-475d-8f6b-bf28bfb7d8fc
msgctxt "h757b41a7g8651g4ec8g913bg52110ff1ca5c"
msgid ""
"Poor, stupid thing. Why is it even here? I thought we sent its pod away so "
"it could be used elsewhere."
msgstr "불쌍하고 멍청한 녀석. 도대체 이게 왜 여기 있는 거야? 다른 곳에서 쓰이게끔 포드를 보냈다고 생각했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 1d888274-d867-2b48-2eca-4f874de24786
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:1d888274-d867-2b48-2eca-4f874de24786
msgctxt "h9d788b25g5ca8g4365g8692g736f1455791b"
msgid "Did... you... hurt... me...?"
msgstr "나... 를... 해친... 거야...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Narrator
#. NodeID = 20aa040a-d18d-dbb2-7d59-4a7d82d5427b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:20aa040a-d18d-dbb2-7d59-4a7d82d5427b
msgctxt "hdbf6789dg3448g43e4ga6c4g71a750bc79a7"
msgid "*Her experiments may well have made the damage worse.*"
msgstr "*그녀의 실험으로 상처가 더욱 악화된 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 2a8134a1-a45d-237a-f997-de6ba490a54c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:2a8134a1-a45d-237a-f997-de6ba490a54c
msgctxt "h221d91a5g64e7g4b54gad82g9c5da8fece52"
msgid "My mind may be gone, but my blade is sharp!"
msgstr "내가 정신은 나갔을지 몰라도, 아직 내 칼날은 날카롭지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 2d013aab-606c-8ce7-0f20-5702f579b7a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:2d013aab-606c-8ce7-0f20-5702f579b7a8
msgctxt "he36f3dc8g6fdeg4a95g816cgce61e9ddfc9e"
msgid "This is where I was left after someone infected me?"
msgstr "여기가 누군가 나를 감염시킨 후 버려두고 간 곳인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Narrator
#. NodeID = 32a7b418-ff3d-fd48-97d4-3d0ccc73a1a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:32a7b418-ff3d-fd48-97d4-3d0ccc73a1a7
msgctxt "h96e39c8agd43ag426cg9787g0ff6d437e963"
msgid ""
"*You were no Myrkul cultist, that much is sure. You sense in your soul you "
"were something far greater.*"
msgstr "*당신은 머큘의 신도가 아니였습니다, 그건 확실하게 느껴지네요. 당신의 영혼은 훨씬 더 대단한 무언가였던 것이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 349fbcbb-7425-d4f8-4f9b-879314bab837
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:349fbcbb-7425-d4f8-4f9b-879314bab837
msgctxt "h8b1b0c4eg006fg4ccega3a8g58b40ad32c57"
msgid "<i>Scowl: She didn't do a great job of fixing me.</i>"
msgstr "<i>찡그리며: 그녀의 치료가 별 도움이 되지 않았어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 35436f51-b419-3b18-5e44-19982a221641
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:35436f51-b419-3b18-5e44-19982a221641
msgctxt "h5ad21fd1g4659g4264g948ag7a68b299cf0a"
msgid "I kept you as mine until you were needed by our superiors."
msgstr "상급자들이 널 필요로 하기 전에는 넌 내 소유였었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 3ec0d483-5795-00f9-6db4-90610e81e59e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:3ec0d483-5795-00f9-6db4-90610e81e59e
msgctxt "h0cf06059g8effg41b5ga238g9b5e593829f3"
msgid "Oh, but what an arresting voice you have!"
msgstr "아, 하지만 너의 목소리는 참으로 매력적이구나!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 402fc194-f2f4-d1cb-9839-a9bd2a093786
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:402fc194-f2f4-d1cb-9839-a9bd2a093786
msgctxt "hce878c6eg7f4ag4032g8b46gb07075ec54c5"
msgid "Missed you..."
msgstr "보고 싶었어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 4196f9c3-e343-7547-ffca-c0c233f69e32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:4196f9c3-e343-7547-ffca-c0c233f69e32
msgctxt "he4912135ga075g477bg9804g84037d096071"
msgid ""
"It has never been the same with another... All the other victims who come "
"here just meekly obey. You thrashed, you fought, you were <i>indomitable</i>."
msgstr "다른... 아니 모든 희생자들과 넌 달랐어. 그들은 온순하게 복종했지만 넌 때리고, 싸우고, <i>굴복</i>하지 않았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 47baa9c7-7618-b6bf-87a3-b0d9ee17d51a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:47baa9c7-7618-b6bf-87a3-b0d9ee17d51a
#, fuzzy
#| msgid "Ketheric needed me? For what?"
msgctxt "he2bf17ebg2c27g4564gaddcg8cf9be1cb506"
msgid "I was 'needed' in the Absolute's plan? For what?"
msgstr "케서릭이 날 찾았다고? 무엇 때문이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 4facf8c9-735d-a2e3-df28-e5600808864e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:4facf8c9-735d-a2e3-df28-e5600808864e
msgctxt "h7683e216gf420g4425g832egd46f8f5a29c3"
msgid ""
"Truthfully, I'm not surprised to see you found your way back here all by "
"yourself. I always knew you were clever."
msgstr "솔직히, 네가 누구의 도움 없이 혼자 돌아온 걸 보고도 난 놀라지 않았어. 네가 영리하다는 걸 늘 알고 있었거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 5026ab84-25ad-fc07-e907-6ac34b1693ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:5026ab84-25ad-fc07-e907-6ac34b1693ea
msgctxt "h49704646ge2b9g4876gb0c0g7ee992a4470d"
msgid "I wanted to keep you for myself but they shipped you away."
msgstr "내가 널 차지하려 했는데 그들이 널 보내버렸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 535d6096-5e94-3ff0-1905-d4908fe879c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:535d6096-5e94-3ff0-1905-d4908fe879c9
msgctxt "hf0f4c12fg5d8bg425cg9362g3fa93e8c9bcc"
msgid "<i>Keep me?</i> What did you <i>do </i>to me?"
msgstr "<i>차지해?</i> 나에게 <i>무슨 짓</i>을 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 61453009-33bf-0ff8-8560-0824ced15eea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:61453009-33bf-0ff8-8560-0824ced15eea
msgctxt "h962f0201g6932g411dga69eg82d1908b35f5"
msgid "You talk? And you are aware? How is that possible?"
msgstr "말을 하다니, 게다가 의식도 있어? 이게 어찌 된 일이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Narrator
#. NodeID = 6412ef8c-2270-6906-b79a-15534eab036c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:6412ef8c-2270-6906-b79a-15534eab036c
msgctxt "h2b719a6eg39b8g4029gb01egda4fbbf4dd8e"
msgid ""
"*Someone else must have attacked you, in the midst of whatever you were "
"doing down here.*"
msgstr "*당신이 여기서 뭐라도 하고 있는 동안, 다른 누군가 당신을 공격한 게 분명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 6496f216-03a9-be5a-2052-e085c230ac21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:6496f216-03a9-be5a-2052-e085c230ac21
msgctxt "hf6751b1ag7b84g4bdcg9615g1691428a99ee"
msgid "I thought I'd never see you again ..."
msgstr "널 다시는 못 볼 줄 알았는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 66f5fd7e-fc0f-92f7-e8b5-f66ef3601657
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:66f5fd7e-fc0f-92f7-e8b5-f66ef3601657
msgctxt "hd728a1ddg0986g4903gb99dga1fa2ab50b03"
msgid "You will die for what you did to me."
msgstr "내게 한 짓 때문에 넌 죽게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 688c3a72-0c06-94c3-401f-f2f9a5bc2174
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:688c3a72-0c06-94c3-401f-f2f9a5bc2174
msgctxt "h70c4283dg5771g4f2dg8194gf7062f88273e"
msgid ""
"Bone Lord... you're the perfect man... All that is unnecessary stripped "
"away... Primal... innocent... pure..."
msgstr "뼈의 군주시여... 당신은 완벽한 남자입니다. 불필요한 모든 것들을 벗어버린... 원시적이고.... 순결하며... 깨끗하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 688c3a72-0c06-94c3-401f-f2f9a5bc2174
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:688c3a72-0c06-94c3-401f-f2f9a5bc2174
msgctxt "h28af1b45gf39bg494eg8313g7210b93eb53e"
msgid ""
"Bone Lord... you're the perfect woman... All that is unnecessary stripped "
"away... Primal... innocent... pure..."
msgstr "뼈의 군주시여... 당신은 완벽한 여자입니다. 불필요한 모든 것들을 벗어버린... 원시적이고.... 순결하며... 깨끗하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 688c3a72-0c06-94c3-401f-f2f9a5bc2174
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:688c3a72-0c06-94c3-401f-f2f9a5bc2174
msgctxt "h57a2ae3bgc6edg4329gae77g958113ae09a0"
msgid ""
"Bone Lord... you're the perfect being... All that is unnecessary stripped "
"away... Primal... innocent... pure..."
msgstr "뼈의 군주시여... 당신은 완벽한 존재입니다. 불필요한 모든 것들을 벗어버린... 원시적이고.... 순결하며... 깨끗하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 69625e3f-5c3c-5aaf-3f25-798f1d9ca542
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:69625e3f-5c3c-5aaf-3f25-798f1d9ca542
msgctxt "hb1f6d32bge9d6g48a2g935dg0db10ee88522"
msgid ""
"Lashers... bring this one back to my table! And prepare my knives for a long "
"night of <i>experiments</i>!"
msgstr "체벌자들아... 이 놈을 내 실험대에 다시 두어라! 그리고 오늘 밤에 있을 길고 긴 <i>실험을</i> 위해 칼을 준비하도록!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 6ded0ec7-65ac-ff2d-92ef-3a18528e3240
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:6ded0ec7-65ac-ff2d-92ef-3a18528e3240
msgctxt "h0532a3a8ga27eg493egae31g050cb1b5a352"
msgid "<i>Try to remember the attack.</i>"
msgstr "<i>공격당했던 걸 기억해 보려 애쓴다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 6f026c6b-17ab-cf92-4302-6c91d17b292f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:6f026c6b-17ab-cf92-4302-6c91d17b292f
msgctxt "h9ab8c764gb44eg4cbcg8b6bg42025b7541b9"
msgid ""
"Something must have gone wrong for you to have wandered all the way back "
"here... even if it is pleasant to be reunited."
msgstr "여기로 다시 돌아온 걸 보니, 분명 무언가 잘못된 거구나. 비록 다시 만나서 기쁘긴 하지만 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Narrator
#. NodeID = 7afc72a9-51ff-16f1-969f-0c4b174260e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_Barracks_State_MistressDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:7afc72a9-51ff-16f1-969f-0c4b174260e6
msgctxt "h3a1b54caga728g4e71g99e5ge3a9e7f2fbb6"
msgid ""
"*She is but the hack-doctor who half-pieced you together, after whatever "
"caused your head to get in this mess.*"
msgstr "*당신의 머리가 이 지경에 이르게 된 원인이 무엇이든, 그녀는 당신을 대충 조각처럼 이어 붙인 별 볼일 없는 의사일 뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 7be3fa0e-bcb1-a2c7-7f9b-c5561db486b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:7be3fa0e-bcb1-a2c7-7f9b-c5561db486b7
msgctxt "h59f1afaeg5e32g42e7gaddbg02807956f474"
msgid ""
"Oh, it pains to hear you speak such words against one who adored tending to "
"you so."
msgstr "널 몹시 아끼던 자에게 그런 말을 하다니 듣기 고통스럽구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 7e030485-e395-8a53-46de-173c55d5425b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:7e030485-e395-8a53-46de-173c55d5425b
msgctxt "h43a757fbga854g4f3dga828gbe1c2ee9693c"
msgid "You talk? How is that possible? Something must've gone wrong."
msgstr "말을 하다니? 어떻게 된 거지? 분명 무언가가 잘못됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = 8bd4cac5-9520-6e1d-fcbb-9eddfa24cbcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:8bd4cac5-9520-6e1d-fcbb-9eddfa24cbcc
msgctxt "hced75d03ge420g4a7aga572g0d88143688fd"
msgid "Who was I to you when I was here? Before I was infected?"
msgstr "네가 여기 있을 때 난 너에게 뭐였지? 내가 감염되기 전에?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 9ae4bf91-56bd-a385-13af-59aee89d740f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:9ae4bf91-56bd-a385-13af-59aee89d740f
msgctxt "h6213b635g7d52g4324g87a9gdcba6b53ddcb"
msgid ""
"How you got here was a total mystery, but I stitched you up just enough to "
"keep you alive, then placed you within your crib."
msgstr "네가 여기 어떻게 왔는지는 정말 불가사의한 일이야. 하지만 내가 목숨은 건질 정도로 널 치료해서 침대에 눕혔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = 9be77148-6145-73d8-f175-c5b10790e8c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:9be77148-6145-73d8-f175-c5b10790e8c1
msgctxt "h3bc82c5dg0adbg4e95g927dg42ca0d20804c"
msgid ""
"You were my very first, after all. I learnt everything about the parasites "
"from you."
msgstr "어쨌든 넌 나의 첫 번째였으니까. 기생충에 관한 모든 걸 너한테 배웠거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = b1c77f2e-b7ac-1839-a2ff-3938f7644aab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:b1c77f2e-b7ac-1839-a2ff-3938f7644aab
msgctxt "h8cafe433g5e4dg43f7g95cagd8fae9eea67c"
msgid ""
"Adorable... I did miss it. Its simplicity, its fear, it thrashing its own "
"head against its pod, cracking its skull again and again in a futile attempt "
"to escape."
msgstr ""
"사랑스럽군... 정말 그립긴 했어. 그 단순함, 공포, 자기 머리를 포드에 갖다 박는 것도, 탈출하기 위한 헛된 노력으로 계속해서 "
"두개골을 깨부수는 것도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = bac05985-8148-b06e-7287-6632d30c2363
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:bac05985-8148-b06e-7287-6632d30c2363
msgctxt "hacef82cbg4bb0g4f13g90e7g5a3a7eab8a6a"
msgid ""
"But as special as you are, you shouldn't be swanning around here, acting as "
"if free will is yours again."
msgstr "하지만 네가 특별한 만큼, 네가 자유 의지를 되찾은 것 마냥 이곳 여기저기를 돌아다녀선 안 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Narrator
#. NodeID = bf9637e2-2305-124e-9845-f4754cb567eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:bf9637e2-2305-124e-9845-f4754cb567eb
msgctxt "hc62c64e1g9dd8g4991g961dgb7ede7995271"
msgid ""
"*This necromancer was a grunt in the scheme of the horrors enacted against "
"you. That attacker is the source.*"
msgstr "*이 사령술사는 당신에게 행해진 공포스러운 계획에서 하찮은 역할을 한 사람일 뿐입니다. 그 공격자가 진짜 원인입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = c7178f1c-b1f0-737a-b714-73ccb74e224e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:c7178f1c-b1f0-737a-b714-73ccb74e224e
msgctxt "hecc4ac54gf6a3g494ega0b3gb7b14a5e737b"
msgid ""
"I was not behind it - I do not know. But whoever did it, I'm so glad they "
"left you here for me."
msgstr "그 일의 배후는 내가 아냐 - 나도 누군지 몰라. 하지만 누가 그랬든, 날 위해 널 여기 두고 가다니 무척 기뻐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = c9263f67-9404-66a4-c4fa-d4b44e3400c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:c9263f67-9404-66a4-c4fa-d4b44e3400c6
msgctxt "h4829dabeg2650g49aaga5bag4ae9cfe22e7d"
msgid ""
"We're going to kill you, sweet one. But I promise I will stay with you "
"afterwards."
msgstr "우린 널 죽일 거야, 귀여운 것. 하지만 그 후에 네 곁에 머물겠다고 약속할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Narrator
#. NodeID = ce2435e5-89ac-eb49-7506-d0a3d98929a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:ce2435e5-89ac-eb49-7506-d0a3d98929a7
msgctxt "h8406117fg413eg4637gb0a4g30c4de571315"
msgid ""
"*In the heart of all these membranes, there was a dagger awaiting you all "
"along. But from who?*"
msgstr "*이 모든 세포막의 중심에, 내내 당신 기다리고 있던 단검 한 자루가 놓여 있었습니다. 하지만 누가 가져다 둔 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = d49e7eb1-11b5-c79a-45e3-92c8fa21dce6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Quest_MistressOfSouls = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:d49e7eb1-11b5-c79a-45e3-92c8fa21dce6
msgctxt "hbd72ae52g3390g43b1g9126gfc5f74b7417f"
msgid ""
"We had such a close bond. I opened you up endlessly with my scalpels, and "
"got lost in your insides."
msgstr "우리의 유대는 정말 강렬했어. 나는 메스로 끊임없이 널 갈랐고, 네 안에서 길을 잃었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = d55d5cc7-c5cf-2a25-cd9f-4c09d3d4daef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:d55d5cc7-c5cf-2a25-cd9f-4c09d3d4daef
msgctxt "h69321fabg777ag4fafgb4c1g426c6fdb766a"
msgid "<i>Ponder why you were down here before.</i>"
msgstr "<i>전에 왜 이곳에 왔었는지 떠올려본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Player
#. NodeID = df1781e3-4e5e-5ccd-74be-cbbd90dca03c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:df1781e3-4e5e-5ccd-74be-cbbd90dca03c
msgctxt "h0fbb07b9g827eg46f3gb446g409795936d1b"
msgid "<i>Move on.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = ebe50681-40b9-dc93-6027-13407fc5814c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:ebe50681-40b9-dc93-6027-13407fc5814c
msgctxt "h84b50862g53fcg42f9gbb46g27d2254a1c8d"
msgid ""
"You're not supposed to be here, special one. That's not right. But I don't "
"want to damage you."
msgstr "특별한 아이야, 넌 여기 있어선 안 돼. 옳지 않은 일이지. 하지만 너를 훼손하긴 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = f201f89d-7240-6923-fbe0-bde0558fc6f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Knows_BrainDamage = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:f201f89d-7240-6923-fbe0-bde0558fc6f5
msgctxt "hb0c76af0g6d21g4d8cgb114gbf5a95cf20c5"
msgid ""
"How precious - sweeter than any man who still has his brain! The things I'd "
"do with you, if I were in command of the parasite piloting you."
msgstr ""
"정말 소중하구나. 뇌를 잃지 않은 그 어떤 남자보다 다정해! 네 안을 휘젓고 다니는 기생충이 내 명령을 따랐다면, 정말 수많은 짓을 네게 "
"저질렀을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = f201f89d-7240-6923-fbe0-bde0558fc6f5
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Knows_BrainDamage = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:f201f89d-7240-6923-fbe0-bde0558fc6f5
msgctxt "h982b9590gc0b7g4a1bgb4f6gd6572a11e7c4"
msgid ""
"How precious - sweeter than any woman who still has her brain! The things "
"I'd do with you, if I were in command of the parasite piloting you."
msgstr ""
"정말 소중하구나. 뇌를 잃지 않은 그 어떤 여자보다 다정해! 네 안을 휘젓고 다니는 기생충이 내 명령을 따랐다면, 정말 수많은 짓을 네게 "
"저질렀을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = f201f89d-7240-6923-fbe0-bde0558fc6f5
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Knows_BrainDamage = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:f201f89d-7240-6923-fbe0-bde0558fc6f5
msgctxt "hb8233fffg97f8g441dg8e45gb2a82c135d78"
msgid ""
"How precious - sweeter than any person who still has their brain! The things "
"I'd do with you, if I were in command of the parasite piloting you."
msgstr ""
"정말 소중하구나. 뇌를 잃지 않은 그 어떤 사람보다 다정해! 네 안을 휘젓고 다니는 기생충이 내 명령을 따랐다면, 정말 수많은 짓을 네게 "
"저질렀을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = fb1a46c8-60ca-2aaf-8bd4-fffd6a5ca416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:fb1a46c8-60ca-2aaf-8bd4-fffd6a5ca416
msgctxt "ha28cedd3g8a4dg47afga52agc5cc4dbff444"
msgid "I think we have to put you down, though, dear one."
msgstr "하지만 우린 널 재워야 할 것 같아, 자기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge
#. Speaker = Kressa Bonedaughter
#. NodeID = fcca9b34-cad9-7bd3-e981-b7bc90c320d6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls_RecognizeDarkUrge:fcca9b34-cad9-7bd3-e981-b7bc90c320d6
msgctxt "hfdf28645g7c44g422cg8277gf670930db9e5"
msgid ""
"Urgh, Lashers, Balthazar let one of his walking carcasses lapse from his "
"control... Let's ferry them back."
msgstr "으, 체벌자들, 발타자르가 산 송장 중 하나를 통제에서 벗어나게 둔 모양이야. 빨리 되돌려 보내자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_001
#. Speaker = Hairy Henry
#. NodeID = 6aad2230-7c4e-ee9b-17f5-c85e70b5e656
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_Barracks_SkullLasher_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_001:6aad2230-7c4e-ee9b-17f5-c85e70b5e656
msgctxt "hb5cbf525gef8eg45a0ga1e7g0fe7a37768db"
msgid "Heed the Mistress. She is blessed."
msgstr "여신님의 말을 들어. 그녀는 축복받았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_002
#. Speaker = Ironfinger
#. NodeID = 1fb529de-e664-57a3-e467-2e2377bc4fd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_Barracks_SkullLasher_002_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_002:1fb529de-e664-57a3-e467-2e2377bc4fd2
msgctxt "hcfd74793g976dg4585g8f7ag49f49223f627"
msgid "We are fortunate to live in the end-times. Pray with me."
msgstr "우린 마지막까지 살아있는 게 운 좋은 거야. 나와 같이 기도하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_002
#. Speaker = Ironfinger
#. NodeID = 9d8a04b9-ccb0-48da-9ae4-cc38301660d6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_Barracks_SkullLasher_002_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_002:9d8a04b9-ccb0-48da-9ae4-cc38301660d6
msgctxt "h77a5d902g7a06g4fbdga32fgf7c655e1556d"
msgid "The end is coming - do you feel it?"
msgstr "끝이 다가오고 있다- 느껴지는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_003
#. Speaker = Maghtew Budj
#. NodeID = 6ca2fe07-4a2b-2421-64e2-fffa91359ead
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_Barracks_SkullLasher_003_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_003:6ca2fe07-4a2b-2421-64e2-fffa91359ead
msgctxt "haa76d4d6gafe7g46deg9dd1g30f780a44b48"
msgid "Your bones be blessed."
msgstr "너의 뼈에 축복을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_001
#. Speaker = Hairy Henry
#. NodeID = a89dbbc1-52e0-4b44-a622-c22f9ae160e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_Barracks_SkullLasher_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_001:a89dbbc1-52e0-4b44-a622-c22f9ae160e5
msgctxt "h38328904g4bf7g4990g96cdgd61805226196"
msgid "Walk in shadow."
msgstr "그림자 속을 걸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_003
#. Speaker = Maghtew Budj
#. NodeID = ab70c6e3-f646-41b9-bc36-7981de443067
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_Barracks_SkullLasher_003_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_SkullLasher_003:ab70c6e3-f646-41b9-bc36-7981de443067
msgctxt "hb88036e6g0061g417dg85abg8466f8c6c5b1"
msgid "May death claim you soon."
msgstr "죽음이 머지않아 널 거두길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Player
#. NodeID = 03417ba6-eef7-88d1-6451-b6190465ad7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:03417ba6-eef7-88d1-6451-b6190465ad7a
msgctxt "h027ff8fcga2bdg4fe8g8aacg72faa04e2e24"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Slack-Skinned Head
#. NodeID = 314fb0f7-019a-c674-af71-65b6bbad1af8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:314fb0f7-019a-c674-af71-65b6bbad1af8
msgctxt "h56036c23g6e3cg421cgbf62g4a9972b15f39"
msgid "Late? No, mate - I was watching. Learning."
msgstr "늦었다고? 아니네, 친구 - 난 지켜보고, 배우고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Player
#. NodeID = 6959f9db-2e14-f18e-a4ed-a27ef019d1e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:6959f9db-2e14-f18e-a4ed-a27ef019d1e7
msgctxt "h093593b8g6207g4ba4gacc0gba985765efc4"
msgid "Smart. Right. Use our brains."
msgstr "똑똑하군. 맞아. 우리 머리를 써."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Slack-Skinned Head
#. NodeID = 7db2dbaf-9815-0c8e-e4f8-3c41eb2fdd4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:7db2dbaf-9815-0c8e-e4f8-3c41eb2fdd4d
msgctxt "h5467591cg7b9eg4230g8199gc70d665cb2e3"
msgid "If we're going to escape, we have to be smart."
msgstr "우리가 탈출할 거라면, 영리하게 굴어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Slack-Skinned Head
#. NodeID = 864fbb1b-9e9d-f495-6555-d5dba14d5090
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:864fbb1b-9e9d-f495-6555-d5dba14d5090
msgctxt "he87dd3ebge677g47cega534g935f88de8a2c"
msgid ""
"Wait. How did <i>you</i> get in here? Away, SLAVE! They might have taken "
"your mind, but they won't have MINE!"
msgstr ""
"잠깐. <i>네가</i> 어떻게 여기 들어온 거지? 떨어져라, 노예야! 그들이 네 정신을 빼앗아 갔을지는 몰라도, 내 것은 가져가지 "
"못한다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Slack-Skinned Head
#. NodeID = c88d1912-4526-4660-858b-5f30c382d708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:c88d1912-4526-4660-858b-5f30c382d708
msgctxt "h2fe7e262gdcbeg46ffgbfb0g5f4a8d13d17f"
msgid "<i>Ssssshhhh. </i>This place listens. It <i>knows.</i>"
msgstr "<i>쉬이이잇.</i> 여기는 귀가 달렸어. <i>알아 듣는다고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Slack-Skinned Head
#. NodeID = cd8fb5a0-963b-2733-3522-0f79f3d9da52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:cd8fb5a0-963b-2733-3522-0f79f3d9da52
msgctxt "h0865cd5bg46b5g422cga214g328f9b1ee23f"
msgid "Right - you <i>get it.</i> I've been watching. Learning."
msgstr "맞아- 너는 <i>아는 구나.</i> 난 계속 지켜보고, 배워왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Slack-Skinned Head
#. NodeID = e0277e5c-53ee-5216-5fc4-d53eb760d598
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:e0277e5c-53ee-5216-5fc4-d53eb760d598
msgctxt "h91f124d3g7360g4010ga5adgd84e8d9108dc"
msgid ""
"This place is <i>alive</i>. A big, thinking thing - and it needs our flesh "
"to grow. I've seen them put corpses in the walls - and they just melt away."
msgstr ""
"이곳은 <i>살아있어</i>. 거대하고 생각하는 장소야. 그리고 우리의 육체가 자라나길 원하지. 그들이 벽에 시체를 두는 걸 본 적 "
"있어. 금방 녹아 없어지더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Player
#. NodeID = e128ea0b-6af6-76df-53b3-c7490f5df8ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:e128ea0b-6af6-76df-53b3-c7490f5df8ef
msgctxt "h838a6a2cg09e2g49b7ga336g863a6334aff6"
msgid "I think your escape plan might be coming a little late."
msgstr "아무래도 네 탈출 계획은 조금 늦은 게 아닌가 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Player
#. NodeID = e31e611e-55ad-eeb5-a37f-84e689e0f00e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:e31e611e-55ad-eeb5-a37f-84e689e0f00e
msgctxt "h67ce701fgef9cg4c55g91e0gebfb45dffe6c"
msgid "You know a way out?"
msgstr "나가는 길을 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors
#. Speaker = Slack-Skinned Head
#. NodeID = e8eb0e10-4df8-1e8e-67d8-3f075b88a5d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_ButcherDoors:e8eb0e10-4df8-1e8e-67d8-3f075b88a5d2
msgctxt "he7f4edaagcfa8g4e89g97bdg7a5402e27ccd"
msgid ""
"So we've got to trick it, see? Make it think we're <i>part</i> of it. That's "
"why the doors only open for..."
msgstr "그러니 우린 속임수를 써야 해, 알겠어? 우리가 이곳의 <i>일부</i>라고 믿게 만들어. 그 때문에 이 문이 열리는 때가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 0ebcd4c6-83b7-8530-dcd0-ff7d2cd76a0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:0ebcd4c6-83b7-8530-dcd0-ff7d2cd76a0d
msgctxt "h933704d6g4b88g406eg9fe1gc2c1c61cc6c5"
msgid "No fooling me. Patience - you'll hear it when Lord Gortash does."
msgstr "날 속일 생각 마. 기다려-고타쉬 경께서 말씀하셔야 너도 듣게 될 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 0fb3a1ea-0ffc-32ae-5a4d-a94daf5e2cdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:0fb3a1ea-0ffc-32ae-5a4d-a94daf5e2cdb
msgctxt "hd6f25df8g235dg4ab6g834ag21c4f7a48454"
msgid ""
"Could do with a bit of natural light, all right. But you know these nobles - "
"odd as fae folk."
msgstr "약간의 자연광이 있는 게 좋겠지. 하지만 너도 알다시피 이 귀족들은 페이들만큼 이상해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 1d2f5dc3-707a-b1ee-907f-fc65cef41570
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:1d2f5dc3-707a-b1ee-907f-fc65cef41570
msgctxt "h9407d3d3gfdf1g4a23gb866g276ba6dcbf65"
msgid "Acoustics are a little off in here. Which is... where, exactly?"
msgstr "여기 음향이 좀 이상한데. 이게... 정확히 어디야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = 2b224b1e-eb34-c033-f4be-dea5f616dcab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:2b224b1e-eb34-c033-f4be-dea5f616dcab
msgctxt "h6b6776dbg209eg4bccgb87dg7950bfbf1efb"
msgid "Never mind that. Tell me about this Lord Gortash."
msgstr "그건 됐고. 고타쉬에 대해 얘기해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = 371a2a67-3fa2-f854-36c1-945f3e121375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:371a2a67-3fa2-f854-36c1-945f3e121375
msgctxt "hfc168404gec08g4e31g88a2g7207c82f989c"
msgid "An illithid colony. But don't worry - just your brain is here."
msgstr "일리시드 군집. 하지만 걱정 마-여긴 네 뇌만 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 46e725a9-5ce8-2b03-8e1e-c9495dc1cec1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_BrainReader_Memory_DeviceExplained_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:46e725a9-5ce8-2b03-8e1e-c9495dc1cec1
msgctxt "h2edd5483g4fccg4ba8g99cfg25fd50cbd2d6"
msgid "The owlbear <i>bore</i> Auril's <i>icy ire</i>."
msgstr "아울베어가 아우릴의 <i>차가운 분노</i>를 <i> 머금고 있다. </i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 501d8d1a-83e9-8546-dd89-ff7db7d64769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:501d8d1a-83e9-8546-dd89-ff7db7d64769
msgctxt "hbc6c8d16g2c44g41bdgb57dg0c1cbfab4167"
msgid ""
"He heard me singing in Beggar's Rest. Said he needed someone to 'give voice "
"to lost knowledge'."
msgstr "거지의 안식처에서 내가 노래하는 걸 들었어. '잃어버린 지식에 목소리를 부여해줄' 누군가가 필요하다고 하셨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 559bc6a4-27dc-108f-4ea6-72c8a89c919b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:559bc6a4-27dc-108f-4ea6-72c8a89c919b
msgctxt "h34a8d512g8ed1g4519g8466g6d21894a4402"
msgid ""
"Right. A jester, are you? You must be vying for the lord's patronage too."
msgstr "그래. 너 광대야? 너도 고타쉬 경의 후원을 받으려고 여기 왔구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 6410ccbb-5d74-4dbf-4abd-77e253dc21d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:6410ccbb-5d74-4dbf-4abd-77e253dc21d6
msgctxt "h4b0930e7g5322g440ega795gd4d0b0aaf481"
msgid "..."
msgstr "..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 6b8d469a-7f2e-4790-afd5-f7935e124e35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:6b8d469a-7f2e-4790-afd5-f7935e124e35
msgctxt "hbb0ca43bg92a9g4056g8759gf25a0063ec8d"
msgid ""
"Truly? Hah! And my ma said the singing would come to naught. Thank you. "
"<i>Thank you.</i>"
msgstr "진짜로? 하! 우리 엄마는 나한테 백 날 노래해봐야 도움 하나 안될 거라고 했는데. 고마워. <i>정말 고마워.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = 8434b609-7d05-4cf6-1acd-d41c33604ddd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:8434b609-7d05-4cf6-1acd-d41c33604ddd
msgctxt "h895993c0g8698g4b54g9219g5959d4426cc8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = 860f24c1-2dc4-088c-1f5c-8ddc138892a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:860f24c1-2dc4-088c-1f5c-8ddc138892a2
msgctxt "he0a0d81ag4cbeg4983g9ff8g59068bb528eb"
msgid "No need. I think you got the part."
msgstr "걱정하지 마. 내 생각에 넌 잘 해낼 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = 86edb6c1-a82f-5028-d5db-971fa86fa45a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:86edb6c1-a82f-5028-d5db-971fa86fa45a
msgctxt "hbd8eb9f1gaa89g4b9aga019ge1b09d99ee54"
msgid "Now, I need to prepare. Wish me luck!"
msgstr "이제, 준비해야겠어. 행운을 빌어줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = 8905482f-4a3e-1981-c590-8569349155fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:8905482f-4a3e-1981-c590-8569349155fd
msgctxt "h9ee6eb15g70deg4784g9bc1gd6585f66a60d"
msgid "Snap out of it - and <i>look around you.</i>"
msgstr "정신 차려 - 그리고 <i>주변을 봐.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = 9f39cc01-4c8f-982e-881d-32ab9950c199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:9f39cc01-4c8f-982e-881d-32ab9950c199
msgctxt "h32ea4dedgd75bg43eagbe01g028b1d51c269"
msgid "Go ahead. I'm sure you'll be performing soon."
msgstr "계속해. 분명 곧 무대에 오를거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = a2fe97ad-f42a-6ca0-951b-690d8bd263e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_BrainReader_Memory_DeviceExplained_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:a2fe97ad-f42a-6ca0-951b-690d8bd263e2
msgctxt "h218ef513g27b6g4cdfga6b7g32ca1de2b347"
msgid ""
"Pardon! Wouldn't do to phlegm all over Lord Gortash during my first "
"performance, would it?"
msgstr "실례! 내 첫 공연에서 고타쉬 경에게 가래를 뒤집어씌우면 안 되겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = bb1662f7-c7c1-0919-7ed3-6e11bb421cd4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:bb1662f7-c7c1-0919-7ed3-6e11bb421cd4
msgctxt "h36c9889cg6bfbg40d7g823ag96b3cfa352a9"
msgid "What did you plan on singing? It ought to be remembered."
msgstr "무슨 노래를 부르려고? 기억해 놔야 하잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Player
#. NodeID = bb581f96-2258-d407-c9f7-86a204f3e2a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:bb581f96-2258-d407-c9f7-86a204f3e2a7
msgctxt "h5d54209aga586g4bc4g8f8agee1299450d9e"
msgid "Are you some kind of performer?"
msgstr "무슨 연주자라도 돼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = c4a882b6-a6c5-fc0b-89b0-3aa31f379089
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:c4a882b6-a6c5-fc0b-89b0-3aa31f379089
msgctxt "h2e3156cdg6ea9g4628g8b4fg48dc14b9b6b1"
msgid "Just a serving girl with notions - 'til I met Lord Gortash."
msgstr "그냥 생각 많은 여종이었어 - 고타쉬 경을 만나기 전까진."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = ce75e6db-2e5c-5ea4-86f1-f550f9dd31fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:ce75e6db-2e5c-5ea4-86f1-f550f9dd31fb
msgctxt "h86679da9gf60eg425dg8a4eg58592507c455"
msgid ""
"A little over my head, being honest, but the lord has gold. I trust he knows "
"his business. Now - I'd best warm up."
msgstr "솔직히 조금 주제넘긴 하지만, 주인님께선 돈이 많으시니까. 한 만큼 보상해 주시리라 믿어. 이제 - 슬슬 목 좀 풀어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = f7c88af9-b9bb-81d8-45b4-d18e346ca598
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:f7c88af9-b9bb-81d8-45b4-d18e346ca598
msgctxt "h350f55a7gfed7g4096g813dgbb1ab37d20c8"
msgid ""
"I have just the thing prepared - my ma used to sing it when I'd come crying "
"about monsters. Wish me luck!"
msgstr "내가 딱 준비해둔 노래가 있어. 내가 괴물 때문에 울면서 왔을 때 어머니가 불러주던 노래야. 행운을 빌어줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained
#. Speaker = Slack-Skinned Head
#. NodeID = ff09e217-8957-7380-29dc-9386451dc9b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_DeviceExplained:ff09e217-8957-7380-29dc-9386451dc9b4
msgctxt "h2f73760dged3fg46f0gaffag71f34433e920"
msgid ""
"Oddly sentimental. Or <i>mayhaps </i>you're just looking for an edge on the "
"competition, eh?"
msgstr "이상하게 감상적이군. <i>어쩌면</i> 넌 경쟁에서 우위를 차지하려고 할 뿐일지도?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Foreshadowing
#. Speaker = Slack-Skinned Head
#. NodeID = 363e2cef-4f45-d68b-56db-4e519b9e4735
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_BrainReader_Memory_Foreshadowing_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Foreshadowing:363e2cef-4f45-d68b-56db-4e519b9e4735
msgctxt "h456094f9gf1cfg4acdgb022gad49955038bf"
msgid "Won't be laughing. Won't be laughing when I'm a watchman."
msgstr "웃지 않을 거야. 내가 경비병인데 웃을 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Foreshadowing
#. Speaker = Slack-Skinned Head
#. NodeID = 86e44db4-4aae-4c52-9b0b-c53c201b8606
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Foreshadowing:86e44db4-4aae-4c52-9b0b-c53c201b8606
msgctxt "hdaf3fcbcg2120g43b3gba0fg86d65cfb1247"
msgid ""
"This Gortash fella's got an idea. Kind of a training camp. Don't know how it "
"gets me into the watch, but he seems the smart sort..."
msgstr ""
"고타쉬 녀석의 생각이었어. 훈련소 같은걸 만들었지. 내가 어쩌다 거기서 감시병이 됐는지는 모르겠지만, 고타쉬 그놈 꽤 똑똑하더라고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Foreshadowing
#. Speaker = Slack-Skinned Head
#. NodeID = b5701cfc-7bc3-48f5-b87e-3b3945c39fb6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_BrainReader_Memory_Foreshadowing_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Foreshadowing:b5701cfc-7bc3-48f5-b87e-3b3945c39fb6
msgctxt "hf1d6eca1g0df4g42a1g9c55g6860e8258051"
msgid ""
"They won't be laughing much longer. Won't be any more of this 'No gnomes in "
"the City Watch, Brevin'."
msgstr "놈들이 웃을 날도 얼마 안남았어. '브레빈, 노움은 도시 경비대에 들어갈 수 없어.'라는 말도 더는 못할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_None
#. Speaker = Slack-Skinned Head
#. NodeID = d38401a1-bb2a-46d0-a0ec-fb81bbefb536
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_None:d38401a1-bb2a-46d0-a0ec-fb81bbefb536
msgctxt "hda4a8149g4659g4fc6ga10ag3304bb81a14a"
msgid ""
"<i>... empty vessel ... nothing more...\n"
"... lending voice... to elder lore...</i>"
msgstr ""
"<i>... 텅 빈 그릇 ... 아무것도 없네...\n"
"... 엘더의 오래된 이야기에... 목소리를 빌려주네...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 03b2da16-8295-64a5-d9c2-daa31e46ca3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:03b2da16-8295-64a5-d9c2-daa31e46ca3b
msgctxt "hd9cca7ffg6931g4365g8637gaef5cb1863ca"
msgid "You should! We can talk in the morning."
msgstr "그렇게 해봐! 아침에 이야기 해보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = 07e471cf-a3db-beff-d9f7-dc1bc712e34e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:07e471cf-a3db-beff-d9f7-dc1bc712e34e
msgctxt "h96899f40g3fa5g4706gb69cg6cf192a09a73"
msgid "I am very much <i>not </i>your mother."
msgstr "난 <i>절대 </i>니 엄마가 아니란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = 2170823a-0018-1474-8802-0cf04fd8a7ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:2170823a-0018-1474-8802-0cf04fd8a7ab
msgctxt "h692bf715gb9cag41a6g84e0g8a994d4df91c"
msgid "Uh, sure. Go right on back to sleep."
msgstr "으, 좋아. 잠이나 자러가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 2e2fe957-6ca1-3f01-e989-2cfdd8ce5315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:2e2fe957-6ca1-3f01-e989-2cfdd8ce5315
msgctxt "hfaa6982egd39fg4585gad03g493ecd6cdd9d"
msgid "W-what? You're scaring me!"
msgstr "뭐-뭐야? 놀랐잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 447f0efb-7220-8baa-285d-9d56a8aba5d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:447f0efb-7220-8baa-285d-9d56a8aba5d4
msgctxt "h162fff02gd1f2g48e9g991dgcffd169e8bda"
msgid "We saw a big spiky snail that fell out of the sky!"
msgstr "하늘에서 크고 뾰족 뾰족한 달팽이들이 막 떨어지더라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 5031fec1-af6b-76fa-3a93-034ac2de83b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_BrainReader_Memory_Raptured_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:5031fec1-af6b-76fa-3a93-034ac2de83b6
msgctxt "h3dee178fg36c1g4705gb6d0g55c3aa05e4b6"
msgid "Sleepy... mummy..."
msgstr "졸려... 엄마..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = 602f39e4-c2cc-307d-e552-833936233de7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:602f39e4-c2cc-307d-e552-833936233de7
msgctxt "h6d6188f2g05ccg429cg8306g1be9f5d64fac"
msgid "How did you get here?"
msgstr "여긴 어떻게 들어왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = 69010420-25e1-2f38-eeb4-7ab17f0126ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:69010420-25e1-2f38-eeb4-7ab17f0126ad
msgctxt "hf35c05c4ge25fg4844gb3c4g2fe4afe434fd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = 6b2c4962-eb0d-0e26-2087-5d61cf927988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:6b2c4962-eb0d-0e26-2087-5d61cf927988
msgctxt "h1c0a667cg9b17g4ea6g8f2fgf628cdbedf49"
msgid "You'll never wake again, little one."
msgstr "다신 일어날 일 없을 거란다, 아가야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 6ce7b6c7-f9a9-685a-03cb-f3f31d78eeb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:6ce7b6c7-f9a9-685a-03cb-f3f31d78eeb7
msgctxt "h38255881gf0f3g4999g81bagafaab1c78a4e"
msgid "I live here. This is my house. <i>Our </i>house. Right, mummy?"
msgstr "여긴 내가 사는 내 집이야.<i>우리</i>집이라고. 맞지, 엄마?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = 7a684642-6496-05c3-2ea9-52be99aefcb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:7a684642-6496-05c3-2ea9-52be99aefcb6
msgctxt "hcbd06459gd4c0g4cb0g8c8ag480e49c43b7c"
msgid "Well this is <i>deeply </i>unsettling."
msgstr "이거 좀 <i>많이</i> 재수없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 80657730-bf1e-217a-83f9-e2e4083f0d4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:80657730-bf1e-217a-83f9-e2e4083f0d4e
msgctxt "hb4e55b9ag5d41g4d63ga224g90ec9576e767"
msgid "Night night, mummy. Love you."
msgstr "잘자, 엄마, 사랑해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 878ab53d-1e08-902e-dda1-09721ea2ac1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:878ab53d-1e08-902e-dda1-09721ea2ac1a
msgctxt "hf4d56582g4cfag4b00ga85ag672b37536d5b"
msgid "Can I go back to bed, mummy?"
msgstr "나 이제 자러 가도 돼 엄마?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 9285a299-52c4-809e-7bd7-0ee91ec8145b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:9285a299-52c4-809e-7bd7-0ee91ec8145b
msgctxt "hf9b239c3gc836g4b03g9708g519601ab0224"
msgid "Why are you being so mean, mummy? Go away!"
msgstr "나한테 왜 이렇게 못되게 굴어 엄마? 저리 가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = 9a7cbafa-2219-7648-5e2e-a236d4d7bf69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:9a7cbafa-2219-7648-5e2e-a236d4d7bf69
msgctxt "h98d91176g6fb1g46degb07cg07f80be17e7b"
msgid "I'm <i>sleepy</i>, mummy. You must stop waking me up."
msgstr "나 <i>졸리단</i>말이야 엄마. 이제 그만 좀 깨워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = a980f433-bbaa-4006-2669-d6cf75e88f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:a980f433-bbaa-4006-2669-d6cf75e88f9b
msgctxt "ha4124ffegcb60g479fga432g95628e758519"
msgid "Big spiky snail...?"
msgstr "크고 뾰족한 달팽이...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = acd02b58-958b-5db0-4ddd-d6f56ab17abf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:acd02b58-958b-5db0-4ddd-d6f56ab17abf
msgctxt "hea87bfa7g2756g4226g8cc6g855e6de27f3e"
msgid "Time to go back to sleep, then. Good night... <i>you</i>."
msgstr "다시 자러 갈 시간이야, 그럼 잘자... <i>너도</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = b551e7e4-42ee-44ca-9248-ae62ce6481e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_BrainReader_Memory_Raptured_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:b551e7e4-42ee-44ca-9248-ae62ce6481e9
msgctxt "h2cf835d3g2714g4ceagabd7gdf9b2528d803"
msgid "My head hurts..."
msgstr "나 머리가 아파..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = c5c78fc7-4c34-a22c-1eb7-697a3d04e18d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:c5c78fc7-4c34-a22c-1eb7-697a3d04e18d
msgctxt "h757fb686g41fag459agb36cg224df483843b"
msgid "With big wiggly legs!"
msgstr "크고 꾸물거리는 다리도 달렸어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = d2f3b9d0-d4d4-98d2-8499-3ce20f4024c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:d2f3b9d0-d4d4-98d2-8499-3ce20f4024c3
msgctxt "h0b0104b5g9f41g4f95g822cgdc6ea218212f"
msgid "Funny mummy!"
msgstr "엄마 재밌어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Player
#. NodeID = df395364-3573-bc43-0d9a-c53d116af251
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:df395364-3573-bc43-0d9a-c53d116af251
msgctxt "heeee571eg387eg46deg918fge1831979aad1"
msgid "I meanwhile am never going to sleep again."
msgstr "난 다신 자지 말아야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = df46fa2a-ad4c-0146-a1ee-2ff9e426d536
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:df46fa2a-ad4c-0146-a1ee-2ff9e426d536
msgctxt "hce79dfbag8dfbg481egb3ccgab2c4af921d9"
msgid "I don't know what that means..."
msgstr "그게 무슨 소린지 모르겠어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = efa272de-02a3-a8c8-8808-f78ce7e63771
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:efa272de-02a3-a8c8-8808-f78ce7e63771
msgctxt "hb485ac73geccbg491dg8d61gc217cf75fcaf"
msgid "I had the dream again. The big spiky snail that came from the sky."
msgstr "나 또 꿈을 꿨는데. 막 하늘에서 크고 뾰족 뾰족한 달팽이들이 내려왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured
#. Speaker = Slack-Skinned Head
#. NodeID = fd047877-7b6a-8864-6211-4de9ff447d4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_Raptured:fd047877-7b6a-8864-6211-4de9ff447d4b
msgctxt "h878c6a09g3428g42b0g93b6gdb0400395fc6"
msgid "I'm just very sleepy, mummy... I wish you'd stop waking me up so much."
msgstr "나 진짜 졸리단 말이야, 엄마... 이제 그만 좀 깨웠으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Player
#. NodeID = 0f98f580-9c66-b45d-4d47-f7b481b85a55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:0f98f580-9c66-b45d-4d47-f7b481b85a55
msgctxt "h2c079c66g9017g4289gad34g63dc03d176b8"
msgid "It's the third day."
msgstr "셋째날."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 0fddffd4-9c7c-d25c-9e4f-103119020bbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:0fddffd4-9c7c-d25c-9e4f-103119020bbc
msgctxt "h456a0efeg5a4ag4677g90dbg85d1d7b38230"
msgid ""
"The first, yes! Five days since he put that thing in my eye, but the first "
"day he came to visit."
msgstr "첫째, 그래! 그가 내 눈에 뭔가를 넣은 지 5일째, 날 찾아온 첫째 날."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 37c6e27e-3f7f-c148-edca-baf292598d88
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_BrainReader_Memory_TrueSoul_MentionedOthers(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:37c6e27e-3f7f-c148-edca-baf292598d88
msgctxt "h75d1284ag1398g4a71gad34g920b62860a53"
msgid "She whispers in my mind. She <i>sings.</i>"
msgstr "그녀가 내 정신에 속삭여. 그녀가 <i>노래해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 537927b5-97be-687a-692f-8fd9829f4305
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:537927b5-97be-687a-692f-8fd9829f4305
msgctxt "h39708a40gf180g4c07gb2a6g9f4b232010ee"
msgid ""
"He's given me a place of honour, so he can repeat his miracle. And a name:"
msgstr "그가 내게 영광스러운 자리를 주셨어, 그가 다시 기적을 행하실 수 있도록. 그리고 내게 이름을 주셨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 67a495a4-94d5-5376-401c-8f8a966a2488
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:67a495a4-94d5-5376-401c-8f8a966a2488
msgctxt "h4ef08beag8987g4106g8737g54ca1c06247b"
msgid "I want to tell, but... I am confused. Which... which day is it?"
msgstr "말하고 싶은데, 난... 잘 모르겠어. 며... 며칠째야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 6fef160a-51ea-735c-7422-f6ed3b8a3e44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:6fef160a-51ea-735c-7422-f6ed3b8a3e44
msgctxt "h4239be68g4e93g4a01g822eg144636fb7908"
msgid "Lord Gortash."
msgstr "고타쉬 경."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Player
#. NodeID = 85a7b346-2446-e329-f9eb-f593919a95f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:85a7b346-2446-e329-f9eb-f593919a95f9
msgctxt "hf3a72858g6b89g41a8ga626gc63c11d01fe0"
msgid "Who is this 'he' you're talking about?"
msgstr "네가 말하는 '그' 가 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Player
#. NodeID = 87ed478c-2f13-ac81-3930-2399a08174d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:87ed478c-2f13-ac81-3930-2399a08174d6
msgctxt "h329f3ac7g252bg4506gaf41ga8fcbbf68942"
msgid "It's the second day."
msgstr "둘째날."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 8806a694-22f1-6196-fee4-1b0e49f66b08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:8806a694-22f1-6196-fee4-1b0e49f66b08
msgctxt "hb97194e2ge13ag48f1gaee0g49c4cc7fdd44"
msgid "Separate cells - I never saw them. But when they changed..."
msgstr "독방을 썼어. 한번도 본 적은 없어. 하지만 그들이 변했을 땐..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 94bb044e-2bde-a07e-d052-b7b4def747a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_BrainReader_Memory_TrueSoul_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:94bb044e-2bde-a07e-d052-b7b4def747a8
msgctxt "hab4502c5g132ag41baga2bcgd84ca9513735"
msgid "Which is it? Which <i>day?</i>"
msgstr "며칠째야? <i>며칠째</i>냐고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = 94e51620-b2a4-1c32-d462-d389daeb8003
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_BrainReader_Memory_TrueSoul_MentionedOthers(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:94e51620-b2a4-1c32-d462-d389daeb8003
msgctxt "ha80313d0g339dg40e4g8202gc683ede34269"
msgid ""
"Eye hurts. Head hurts. But he says I am past the worst of it - that I won't "
"change like the others."
msgstr "눈이 아파. 머리가 아파. 하지만 그는 최악은 지나갔다고 해. 내가 다른 사람들처럼 변하지는 않을 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Player
#. NodeID = 961e06ad-140b-ad50-6388-ca26b1539020
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_BrainReader_Memory_TrueSoul_MentionedOthers(2) = True
#. SetFlags:
#.   Dialog:
#.     - COL_BrainReader_Memory_TrueSoul_MentionedOthers(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:961e06ad-140b-ad50-6388-ca26b1539020
msgctxt "h389022ddg2f38g42b4gb257gf4b440e1e55a"
msgid "Tell me about these others."
msgstr "그 다른 사람들에 관해서 말해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Player
#. NodeID = a6744eff-3c78-4291-f278-2fcbb19573e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:a6744eff-3c78-4291-f278-2fcbb19573e1
msgctxt "hd8cf7d97g4fa3g45f6g9bf5ge4d0b90af06e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = ab46f9fb-5d47-35a8-89b3-a0ffc508a0eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:ab46f9fb-5d47-35a8-89b3-a0ffc508a0eb
msgctxt "hd9f3fa68g792dg4cbcg8a3dgd719f2dd48e5"
msgid "<i>'True Soul.'</i>"
msgstr "<i>'참된 영혼.'</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = c1cd51c8-594d-a280-6e1b-37b6e55178bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:c1cd51c8-594d-a280-6e1b-37b6e55178bc
msgctxt "hc4a61f8bg3f04g482dgabbcg1e4926be6e4d"
msgid "We are his pets. <i>His</i> plan."
msgstr "우린 그의 애완동물이야. <i>그</i>의 계획이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = d7d2722c-abc5-4459-91ba-0dd3d19d90d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_BrainReader_Memory_TrueSoul_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:d7d2722c-abc5-4459-91ba-0dd3d19d90d8
msgctxt "h972c7138g2c6ag403eg95a8ga831cf3a47d6"
msgid "Every day he comes. Every day for three days, to ask me how I feel."
msgstr "그가 매일 와. 3일 동안 매일 와서, 내 상태를 물어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Player
#. NodeID = f0b819c0-34c1-9a7a-54d8-7732fcbdc38b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:f0b819c0-34c1-9a7a-54d8-7732fcbdc38b
msgctxt "hf6ff25ccg7e48g4118gba58g7514c58c6888"
msgid "It's the first day."
msgstr "첫째날."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = fb0d08ab-15c6-b08e-a659-6429edd7f997
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:fb0d08ab-15c6-b08e-a659-6429edd7f997
msgctxt "hfa2e5ddbg4df6g469cg8cdbg95e809406559"
msgid "MY HEAD! <i>I CAN FEEL THEM IN MY HEAD!</i>"
msgstr "머리 속에! <i>그 자식들이 내 머리 속에 있어!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = fb728a91-75c2-1c04-d55d-eb58dd511be9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_BrainReader_Memory_TrueSoul_MentionedOthers(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:fb728a91-75c2-1c04-d55d-eb58dd511be9
msgctxt "hd4f33eabgfe14g42f6gb61fg7abff09b9149"
msgid "He says I am the last. That the other subjects have all changed."
msgstr "내가 마지막이래. 다른 실험체들은 전부 변했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul
#. Speaker = Slack-Skinned Head
#. NodeID = fe4e33eb-ddf2-9e0d-d27b-ad30ac27ffbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TrueSoul:fe4e33eb-ddf2-9e0d-d27b-ad30ac27ffbf
msgctxt "ha51b6362g55ccg4bf8gba3dg2f1aa4265c43"
msgid "<i>Praise the Absolute.</i>"
msgstr "<i>절대자를 찬양하라.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark
#. Speaker = Slack-Skinned Head
#. NodeID = 0c204584-c8cb-ded7-3087-75883cc24e1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark:0c204584-c8cb-ded7-3087-75883cc24e1e
msgctxt "h08f91fa2g53fcg47bagb090gb70d78b0cdc7"
msgid ""
"<i>And if you choose another\n"
"What's more loving than a brother\n"
"Yes, a stand-up, homely, gentle sort of guy.</i>"
msgstr ""
"<i>만약 네가 다른 사람을 택한다면\n"
"그게 내 형 따위보다 더 좋은 사람이라면\n"
"좋겠지, 듬직하고 가정적이고 다정한 남자라면!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark
#. Speaker = Slack-Skinned Head
#. NodeID = 1d22b1bc-2a16-4512-adae-43b8f803bc82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark:1d22b1bc-2a16-4512-adae-43b8f803bc82
msgctxt "ha67ead17g4c11g458cg9a18g2adc1e535053"
msgid ""
"<i>But my brother, he's a loser\n"
"And I take you for a chooser\n"
"So perhaps one day you'll leave him high and dry.</i>"
msgstr ""
"<i>하지만 우리 형은 머저리야\n"
"그리고 너는 선택을 내리는 자리야\n"
"언젠가 형을 버리고 떠날지도 모르는 일이야</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark
#. Speaker = Slack-Skinned Head
#. NodeID = 7b4afd75-df0b-3520-3f0b-06368c502dfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_BrainReader_Memory_TutorialDark_Hasmet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark:7b4afd75-df0b-3520-3f0b-06368c502dfd
msgctxt "h00c8cc65gc4e9g44f9gbff8gd593fddb2ab9"
msgid "*Humming.*"
msgstr "*흥얼거린다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark
#. Speaker = Slack-Skinned Head
#. NodeID = 8c75a7b7-989c-487b-9df9-7d19c5308dd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark:8c75a7b7-989c-487b-9df9-7d19c5308dd7
msgctxt "ha18c6bcbg7f50g4a3ega54age4e0ca12020e"
msgid ""
"<i>And when you two are wed\n"
"Well, my heart will be but dead\n"
"For my sister you will sadly, surely be.</i>"
msgstr ""
"<i>그리고 너희 둘이 결혼할 때\n"
"내 마음은 다만 죽어버릴 것이야\n"
"슬프게도, 당연히 넌 내 형수가 될 테니까</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark
#. Speaker = Slack-Skinned Head
#. NodeID = c74bfb73-6c97-4504-91c1-d411053e49b1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_BrainReader_Memory_TutorialDark_Hasmet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialDark:c74bfb73-6c97-4504-91c1-d411053e49b1
msgctxt "hdd28ba43g846ag444agbc5dg901da3eaa226"
msgid ""
"<i>Oh, my darling Carolina\n"
"how I'd love to wine and dine ya\n"
"but you chose my foolish brother over me...</i>"
msgstr ""
"<i>아, 내 사랑 카롤리나!\n"
"맛있는 술과 음식으로 네게 구애하려 했건만\n"
"너는 나대신 내 멍청이 형을 택했지</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialSlave
#. Speaker = Slack-Skinned Head
#. NodeID = 1dba19c9-7ff9-4d54-aee6-2420e5e31059
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialSlave:1dba19c9-7ff9-4d54-aee6-2420e5e31059
msgctxt "hc83fa353g74b7g4649gab76g3be581ed34e3"
msgid ""
"Am I dead? I don't want to die. But I don't want to live. Not like this."
msgstr "난 죽은 건가? 죽기 싫어. 그런데 이런 식으로 살기도 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialSlave
#. Speaker = Slack-Skinned Head
#. NodeID = 6ac7e680-cc0e-43c1-baf6-fe6f2081db4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialSlave:6ac7e680-cc0e-43c1-baf6-fe6f2081db4f
msgctxt "h70cdb2c6g0ad3g4828g9f88g373be2e159a9"
msgid ""
"They're... in yours too. It won't be long now. Until we're <i>changed.</i>"
msgstr "니 속에도... 그것들이 있구나. 우리 둘 다<i>변하기</i>전까지 얼마 남지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialSlave
#. Speaker = Slack-Skinned Head
#. NodeID = ec746555-5f22-453d-9cb6-38b6959dc636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_BrainReader_Memory_TutorialSlave:ec746555-5f22-453d-9cb6-38b6959dc636
msgctxt "haac7d449gbc38g4a6ag8d03g5e663dbed234"
msgid "They're in my head - THEY'RE IN MY HEAD."
msgstr "내 머리속 - <b>내 머리 속에 있다고</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 0688d0ed-c682-aa27-65ae-43c066210d8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Githzerai_Knows_Githzerai = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:0688d0ed-c682-aa27-65ae-43c066210d8d
msgctxt "h7441cd09gdb0eg4456g928fg212aef206e73"
msgid ""
"How did you end up in that vault? Aren't you <i>zerai</i> ultimate warriors?"
msgstr "어쩌다 보관실에 놓이게 됐지? 넌 위대한 용사인 <i>제라이</i>가 아니던가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 0688d0ed-c682-aa27-65ae-43c066210d8d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Githzerai_Knows_Githzerai = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:0688d0ed-c682-aa27-65ae-43c066210d8d
msgctxt "h941f2129g0b28g4328g8f31g160dd8225ee4"
msgid ""
"How did you end up in that vault? Githzerai are supposed to be ultimate "
"warriors."
msgstr "어쩌다 보관실에 놓이게 된 거야? 기스저라이는 위대한 용사여야 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 08fe961d-0cfe-b965-b21a-d114cfd1aeb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_BrainReader_Memory_Vault_AskedAid(2) = False
#.      - COL_Brainreader_Memory_HasMet_Vault(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:08fe961d-0cfe-b965-b21a-d114cfd1aeb2
msgctxt "h6c53a4b5g1a16g4d63gaf48g11d84a4c9d07"
msgid ""
"Come now. You're as much a prisoner of this place as I. Let us aid one "
"another."
msgstr "어서 와. 너도 나처럼 이곳의 죄수로구나. 함께 돕도록 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 0cf7ce46-51f9-6472-bb68-75787a01f398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:0cf7ce46-51f9-6472-bb68-75787a01f398
msgctxt "h05070c8fgc8e3g4d44gba28g20b07de47cfb"
msgid "Or perhaps not. Death, freedom - they are one and the same."
msgstr "혹은 아닐 수도 있지. 죽음과 자유- 그 둘은 같은 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 1a17b579-7a16-e34d-0510-e0e496295f46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 23a3676c-6216-6b8b-02c7-c1d076a98d54_KnowsLying = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:1a17b579-7a16-e34d-0510-e0e496295f46
msgctxt "h2a9e54a5gac80g4bc5g9122ga97915f8cddd"
msgid "If you want my help, then tell me the truth."
msgstr "내 도움을 원한다면, 진실을 말해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 2101b89a-56b7-76e3-0f62-48b368947824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:2101b89a-56b7-76e3-0f62-48b368947824
msgctxt "he6d01e76g8b09g4c04gbf0dg21d22aa947c8"
msgid ""
"My people dwell in Limbo - a realm of pure, chaotic thought. With my mind "
"gone, perhaps my soul will return there."
msgstr "내 종족은 망각에 머무르고 있어- 순수하고, 혼돈된 생각의 영역이지. 내 정신이 사라지면 내 영혼이 그곳으로 돌아갈지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 22fefc2a-1b8f-6095-164b-0616fb646a31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:22fefc2a-1b8f-6095-164b-0616fb646a31
msgctxt "h6f8d7f62g0582g4fe6g8b91g9207977b7383"
msgid "I'm not sure I can - I have no psionic power."
msgstr "할 수 있을지 잘 모르겠어- 나에겐 사이오닉의 힘이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 2d888741-622c-d915-bdc7-f4fe4447e1eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:2d888741-622c-d915-bdc7-f4fe4447e1eb
msgctxt "hbba65953g0a1ag480fgb7a5g6f69ed759e2c"
msgid ""
"Warriors of the <i>mind. </i>Oh, there's some physical prowess involved, but "
"the battlefield on which we truly fight the <i>ghaik </i>is their own."
msgstr ""
"<i>강인한 정신력</i>을 가진 전사지. 오, 물론 신체적인 능력도 중요하지만 <i>게이크</i>와의 진정한 전투는 머리 속에서 "
"벌어지거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 3141d926-cb97-e37f-0230-c9b025b73fbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:3141d926-cb97-e37f-0230-c9b025b73fbd
msgctxt "h2e32118ag14ccg4601gaad5g372440338e10"
msgid "Why? This form fits you so much better, cousin."
msgstr "어째서? 사촌한테는 이 모습이 더 잘 어울리는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 317bc48c-31a2-4e3d-1ac7-cc9be5c82d04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:317bc48c-31a2-4e3d-1ac7-cc9be5c82d04
msgctxt "h980ad2cbg10afg48c9g8357g4953e4f8b341"
msgid ""
"Well, a githyanki skull would be too tight a fit, <i>cousin</i>. Your people "
"shunned psionics, after all - while mine mastered them."
msgstr ""
"뭐, 기스양키의 두개골은 너무 꽉 낄 것 같군, <i>사촌</i>. 네 종족은 어쨌든 사이오닉을 멀리했어-반면에 우린 그걸 숙달했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 3aed174f-e76f-42c8-b008-882aa9e374f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:3aed174f-e76f-42c8-b008-882aa9e374f2
msgctxt "hb2a68733gc71eg426cgbf5ag9ecbf0f0614d"
msgid "<i>Reach out and erase her mind.</i>"
msgstr "<i>손을 뻗어 그녀의 정신을 지운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 3b291410-9c69-85a6-0413-3129be0d95cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Githzerai_Knows_Githzerai = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:3b291410-9c69-85a6-0413-3129be0d95cd
msgctxt "hd4832e93g09e1g44ebga39ag19e766ff547d"
msgid ""
"*The monk-like githzerai, sibling-race to the warrior githyanki. Their "
"contempt for one another is eclipsed only by their shared hatred of the "
"illithids.*"
msgstr ""
"*기스양키가 전사라면, 형제 뻘 되는 종족인 기스저라이는 몽크입니다. 서로를 한없이 경멸하는 두 종족이지만, 일리시드를 세상에서 제일 "
"증오하는 것만큼은 둘이 닮았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 3feff9ea-516e-993a-c6ab-61144bcf0750
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:3feff9ea-516e-993a-c6ab-61144bcf0750
msgctxt "heacf59d4g8aabg4295ga4eag07785034e089"
msgid "Thank you, I - <i>wait.</i>"
msgstr "고마워, 난... <i>잠깐.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 49a255d5-ca0a-b3a4-326f-390f7fa8eda2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:49a255d5-ca0a-b3a4-326f-390f7fa8eda2
msgctxt "h28dc54cbg2107g45a4ga456g75e180d1000f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 4e65534f-b18d-2504-e974-18d5c573a561
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:4e65534f-b18d-2504-e974-18d5c573a561
msgctxt "h5babcb59ga198g4a6fga45bge69bd6666886"
msgid "You want me to kill you. What if I can free you instead?"
msgstr "널 죽여 달라는 거군. 대신 널 해방시켜 줄 수 있다면 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 53b8440c-e484-3f5c-7d83-c0d5ebf345bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:53b8440c-e484-3f5c-7d83-c0d5ebf345bc
msgctxt "hf5c57645g6a95g4e42gb469gf07f7e12c0d3"
msgid ""
"Pretty enough for a flesh-prison - if not the noble githzerai features I was "
"born with."
msgstr "육체로 된 감옥치고는 꽤 예쁘장하군- 나처럼 귀족적인 기스저라이의 모습으로 태어나지는 않았지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 5e6d4d09-aff0-c04d-67ef-4d5e34c75460
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:5e6d4d09-aff0-c04d-67ef-4d5e34c75460
msgctxt "hf2d16d95g98beg4e16gb408gf5bf609e7c4a"
msgid ""
"...All right. I... the <i>ghaik</i> did not find my monastery. <i>I led them "
"there.</i>"
msgstr "알았어... 그게... <i>게이크</i>가 우리 수도원을 찾아낸 게 아냐. <i>내가 그들을 그곳으로 안내했어</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 670f1e0d-7399-3f23-7d5c-20240ce0ef34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Githzerai_Knows_Githzerai = False
#.   Tag:
#.      - REALLY_GITHYANKI(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:670f1e0d-7399-3f23-7d5c-20240ce0ef34
msgctxt "h1fb80793g13e4g4d78ga849ge007adc597f4"
msgid "You called yourself 'githzerai'. Is that some kind of githyanki?"
msgstr "너는 네가 '기스저라이'라고 했지. 기스양키랑 비슷한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 6941ea92-f8c8-c815-02be-10226d1d074a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_BrainReader_Memory_Vault_MindWiped = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:6941ea92-f8c8-c815-02be-10226d1d074a
msgctxt "h3971814cgd29dg481ag86bbgc3bf1d040a4e"
msgid "..."
msgstr "..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 6a2915c5-916a-6e6b-9497-74163b99f2ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:6a2915c5-916a-6e6b-9497-74163b99f2ed
msgctxt "h4e52470fg1353g4f2cg9270gb47f489b9d90"
msgid "PLEASE!"
msgstr "제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 74fb511b-642b-a361-0a01-df0a4aa006dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:74fb511b-642b-a361-0a01-df0a4aa006dd
msgctxt "hcd1dc0c6ga390g441dga626gee8043a2eae4"
msgid ""
"Touch my mind, and <i>purge</i> it - at the very moment you do, I will make "
"my knowledge yours."
msgstr "내 정신을 어루만져, <i>씻어내 버려</i>. 그러는 순간 내 지식은 네 것이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 7a3a164c-0667-4caf-37be-f333b5f0fb82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:7a3a164c-0667-4caf-37be-f333b5f0fb82
msgctxt "h7d603ff0gd6aeg48ccgb3e3g558f46cf5523"
msgid "<i>Reach out and purge her mind.</i>"
msgstr "<i>힘을 뻗어 정신을 씻어낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 7a95f351-151b-2018-f9f7-6fdfb8f41190
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:7a95f351-151b-2018-f9f7-6fdfb8f41190
msgctxt "h4001ebc0gc840g4b8aga999g248b9ca454be"
msgid "Return with one who bears this gift, then. <i>Please.</i>"
msgstr "그럼 이 선물을 견딜 수 있는 누군가를 데리고 다시 와 줘, <i>제발.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 7c70b228-2708-1e3f-f029-2f74451e97bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_Brainreader_Memory_HasMet_Vault(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:7c70b228-2708-1e3f-f029-2f74451e97bc
msgctxt "he8ae7b4ag8a8cg444cg8409g3150c13beec4"
msgid "HmmMM... fine bones... sharp jaw... some variety of elf?"
msgstr "흠... 썩 좋은 뼈로군... 턱도 날렵해... 엘프의 변종인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 7cd0adfa-1f7b-09da-024d-418e3be9e062
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:7cd0adfa-1f7b-09da-024d-418e3be9e062
msgctxt "h38cdf04eg0415g49eaga99ageb3dfa66d939"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 7f6442a5-4b1c-e534-ea51-8de486344069
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:7f6442a5-4b1c-e534-ea51-8de486344069
msgctxt "h95c27e61g0fdbg468bg974cg23c9e2207a97"
msgid ""
"...A terrible fate, to be born without a high-mind. It was the one gift the "
"<i>ghaik</i> truly gave us."
msgstr "고결한 정신 없이 태어나다니, 정말 지독한 운명이지. <i>게이크</i>가 우리에게 내린 단 하나의 진정한 선물이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 812aefc6-69dd-bfda-2dd9-e91f4d96aef2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_BrainReader_Memory_Vault_MindWiped = True
#.   Object:
#.     - COL_BrainReader_Memory_Vault_ReceiveReward(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:812aefc6-69dd-bfda-2dd9-e91f4d96aef2
msgctxt "hb531640agc6eag4fa4ga02dgeb6b3279b6e3"
msgid "No. NO. PLEASE!"
msgstr "아니. 안 돼. 제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 814208b7-81c0-b1c7-fc6f-4b771275dcae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:814208b7-81c0-b1c7-fc6f-4b771275dcae
msgctxt "he81fafecg91fbg4cd8g9e14g75bdebcbba28"
msgid ""
"*As her agitation swells, so does her latent psionic power. To your tadpole, "
"that guilt and terror are almost... <i>fragrant.</i>*"
msgstr ""
"*그녀가 더욱 크게 동요할 수록, 그녀 안에 잠재된 사이오닉 능력도 요동칩니다. 당신의 올챙이에게 그 죄책감과 공포심은 거의 "
"<i>향기롭기</i>까지 합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 81819379-8cc3-ed9c-0d1e-adef3e7264f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 23a3676c-6216-6b8b-02c7-c1d076a98d54_KnowsLying = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:81819379-8cc3-ed9c-0d1e-adef3e7264f5
msgctxt "h1024241fgb8deg4a7cga8f7g7f97d878e916"
msgid "*You catch the lie - the monk isn't telling everything.*"
msgstr "*당신은 거짓말을 눈치챕니다- 몽크가 숨기고 있는 것이 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 85253c7c-f1cf-02b5-4b41-1fbe16fb04a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:85253c7c-f1cf-02b5-4b41-1fbe16fb04a6
msgctxt "hc283af60gaeb9g4880ga046g1292f8c2b5f4"
msgid ""
"*You realise the illithids locked her away not as a trophy, but as a fine "
"vintage.*"
msgstr "*당신은 일리시드가 그녀를 전리품으로 가둬 둔 게 아니라, 훌륭한 고급품으로 전시했다는 걸 깨닫습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 86eb891b-ea4f-9805-7bca-5894a0f76d4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(2) = True
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:86eb891b-ea4f-9805-7bca-5894a0f76d4b
msgctxt "h61a3cf72g0f74g4febga6c3ga617892bae05"
msgid ""
"*A prickling flame runs across the back of your mind and the edge of your "
"soul.*"
msgstr "*오싹한 화염이 당신 마음의 뒤편과 영혼의 가장자리를 훑고 갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 86eb891b-ea4f-9805-7bca-5894a0f76d4b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(2) = True
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:86eb891b-ea4f-9805-7bca-5894a0f76d4b
msgctxt "h1dd5dfacg0d4cg4c6dgb4ecgccd13676a8f0"
msgid ""
"*An unusually cautious faerie tickle runs across the back of your mind and "
"the edge of your soul.*"
msgstr "*유별나게 조심스러운 요정의 간지럼이 당신 마음 뒤편과 영혼의 가장자리를 훑고 갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 86eb891b-ea4f-9805-7bca-5894a0f76d4b
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(2) = True
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:86eb891b-ea4f-9805-7bca-5894a0f76d4b
msgctxt "h89271990g68f3g4c83ga4f0g0d0e06b71029"
msgid ""
"*You feel the oncoming void tug at the back of your mind and the edge of "
"your soul.*"
msgstr "*당신은 공허가 당신의 정신과 영혼의 끝자락을 끌어당기며 다가오는 것을 느낍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = 874069d9-79c7-7fec-6c6a-34d73da5080c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:874069d9-79c7-7fec-6c6a-34d73da5080c
msgctxt "h88ecdf9ag8f8ag4a76g93eeg9b814f554ef8"
msgid "I'm listening. What aid are you offering?"
msgstr "듣고 있어. 어떤 도움을 줄 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = 8d52c7e4-963b-629c-094b-7385cf163411
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:8d52c7e4-963b-629c-094b-7385cf163411
msgctxt "h9132fec4g324bg4d66gbdf2g86041412d2ab"
msgid ""
"*It fades beneath your touch, but you feel something left behind. A "
"fragment.*"
msgstr "*그것은 당신의 손길 아래로 서서히 사라집니다. 하지만 뭔가 남아 있는 게 느껴집니다. 파편 하나군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = 9b1caf47-e284-bc46-fbca-2b3cb1db7169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:9b1caf47-e284-bc46-fbca-2b3cb1db7169
msgctxt "h37d43663g3c5eg456egbb25gb68bf7ed2559"
msgid ""
"<i>Please -</i> touch my mind, and purge it. The moment you do, my knowledge "
"will be yours."
msgstr "<i>부탁할게,</i> 내 정신을 어루만져 씻어내 줘. 그러는 순간 내 지식은 네 것이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = a1588926-81b1-1255-0422-6c2b0aa8477d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - COL_BrainReader_Memory_Vault_AskedAid(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:a1588926-81b1-1255-0422-6c2b0aa8477d
msgctxt "hce38b574g615eg49a7g85eag2943561fff84"
msgid "Use your tadpole. Erase me - and I will pass my technique onto you."
msgstr "네 올챙이를 사용해서 날 지워- 그럼 내 기술을 너에게 물려줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = a58d4628-ab04-4c0e-5b9b-ac0aee250cb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:a58d4628-ab04-4c0e-5b9b-ac0aee250cb6
msgctxt "hd040eeabg5fc8g4a3cg9aacg6782514e67e3"
msgid ""
"*The awareness that floods you is nothing like the tadpole. It is tentative, "
"and tinged with the loneliness of aeons.*"
msgstr "*당신을 향해 쇄도하는 이 의식은 올챙이와 전혀 다릅니다. 그것은 머뭇거리며, 영겁에 이르는 외로움의 색채를 띠고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = b42cdb4b-24c1-dce2-b2eb-11c4986ea081
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:b42cdb4b-24c1-dce2-b2eb-11c4986ea081
msgctxt "h4ab3743dgb857g4916gaf08gb2b181956adf"
msgid "It is my mind they enslave. It is my mind that must die."
msgstr "그들이 노예로 삼은 건 내 정신이야. 죽어야 하는 것도 내 정신이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = b6cec753-9ae4-9c3a-a815-b10cfbc70c47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:b6cec753-9ae4-9c3a-a815-b10cfbc70c47
msgctxt "h1d797867g2950g4887gb39fgebc0433d66b2"
msgid "Only because I haven't told you how you will benefit."
msgstr "네가 얻을 이익이 무엇인지 아직 말해주지 않아서겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = c3cc3ce6-aff7-a7b1-6ed4-50d20e89e6e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:c3cc3ce6-aff7-a7b1-6ed4-50d20e89e6e7
msgctxt "h57b8ad6ag852fg4d5bg81adgb4d15e7c9a68"
msgid ""
"Warriors of the <i>mind, </i>cousin. A discipline unknown to your kind - and "
"the very reason we were attacked."
msgstr "<i>마음</i>의 전사들이지. 너희들에게는 알려지지 않은 규율이다 - 바로 그점 때문에 공격을 받았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = c7d2387f-a31e-e930-e8ed-1444ebcaa6d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:c7d2387f-a31e-e930-e8ed-1444ebcaa6d6
msgctxt "h6b1dc83bg9184g4fafg866bg3fcc2baf8330"
msgid "I'm not interested."
msgstr "관심 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = c94d5a9a-7813-0567-fe5a-880cbcef57f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Githzerai_Knows_Githzerai = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:c94d5a9a-7813-0567-fe5a-880cbcef57f6
msgctxt "h79d32f1cg2eb4g4039g94b5gb542e7c5bf8e"
msgid ""
"*The monk-like githzerai, sibling race to your own githyanki. The only "
"beings your people hate more are the illithids themselves.*"
msgstr ""
"*당신이 속한 기스양키의 형제뻘 종족인, 몽크 같은 기스저라이입니다. 당신의 종족이 이들보다 더 증오하는 존재는 일리시드밖에 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = ca07f0a0-f72e-77cb-1760-2be07ee334fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:ca07f0a0-f72e-77cb-1760-2be07ee334fd
msgctxt "h334dafedga657g4870gb1d3gbaa43d07e077"
msgid "I'll do it."
msgstr "그렇게 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = cce16d81-c88d-91cc-cef1-509283654bd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:cce16d81-c88d-91cc-cef1-509283654bd2
msgctxt "he8710307g7cf2g4d36g9048g57e14e3de5d2"
msgid ""
"My order taught a psionic technique much-feared by the <i>ghaik.</i> They "
"destroyed us for it, and kept me as a trophy."
msgstr ""
"우리 조직은 <i>게이크</i>들이 무척 두려워하던 사이오닉 기술을 가르쳤어. 그래서 그들이 우릴 멸망시켰고, 나를 전리품으로 삼았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = cda271d1-727a-15f8-0184-a0074be400f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:cda271d1-727a-15f8-0184-a0074be400f7
msgctxt "h6520a49dge17fg48bbg81e6gefb795d22405"
msgid ""
"They promised me immortality. And they gave it - I have been their rotting "
"trophy for <i>centuries.</i>"
msgstr "그들이 나에게 불멸을 약속했어. 그리고 진짜 주었지. 나는 <i>몇 세기</i> 동안이나 그들의 썩어가는 전리품인 채로 지냈어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = d2a59a88-e58c-c18d-136e-717b86e027fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:d2a59a88-e58c-c18d-136e-717b86e027fe
msgctxt "h8904b6aag451fg4e4ag8559g311d7aba3e33"
msgid ""
"...I do not. The <i>ghaik</i> have been warping flesh for millennia - who "
"knows what damage they can undo."
msgstr ""
"...아니. <i>게이크</i>는 몇 천년간 육체를 타락시켜 왔어- 훼손된 것 중 무엇을 원 상태로 돌릴 수 있는지 누가 알겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = d5f64b96-acd8-f6e5-0bb0-79de7f32c89b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:d5f64b96-acd8-f6e5-0bb0-79de7f32c89b
msgctxt "hf76a8b50gba6ag4606g889cgd92a3ec73c9a"
msgid ""
"Only we <i>zerai </i>continue the war to end the <i>ghaik</i> forever. Only "
"<i>we</i> fight them their own battlefield - the mind."
msgstr ""
"우리 <i>저라이</i>들만 <i>게이크</i>를 영원히 끝장내기 위한 전쟁을 계속했지. 오직 <i>우리</i>만이 그들이 만든 전쟁터- "
"즉 정신 속에서 그들과 맞서 싸웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = d81c0f29-4192-860e-963c-2f84478bdb60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:d81c0f29-4192-860e-963c-2f84478bdb60
msgctxt "h1aff5057gb901g4530g98b9g682742f248a0"
msgid ""
"When you say 'erase' your mind - do by any chance mean 'smash your brain to "
"bits'?"
msgstr "네 마음을 '지워 달라'고 말하는 게 혹시 '뇌를 조각조각 때려 부수라'는 뜻이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = dcc07d52-6832-d9a9-d79a-7e6e23816982
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:dcc07d52-6832-d9a9-d79a-7e6e23816982
msgctxt "h5d9b5a8fge867g4af3gba3ege9fda19ae573"
msgid ""
"It is only knowledge yet, without comprehension. But when you use it, you "
"will... see..."
msgstr "이해 없이는 아직 단순한 지식일 뿐이지. 하지만 그걸 사용하면, 넌... 알게 될 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = de3606fc-3899-4658-d47b-a3b1f8c6cec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:de3606fc-3899-4658-d47b-a3b1f8c6cec4
msgctxt "hc447a166gc1b3g4eeeg878dgfc2f8e5f5a3a"
msgid ""
"I'd guess you're no willing guest of the <i>ghaik</i> either.<i> </i>Perhaps "
"we might aid one another."
msgstr "아마 너도 <i>게이크</i>에게 자의로 찾아온 손님은 아닐 거야. 어쩌면 우리가 서로 도울 수 있을 지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Narrator
#. NodeID = dfaa86f5-3289-aa2c-d7c7-bffb631f74c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 23a3676c-6216-6b8b-02c7-c1d076a98d54_KnowsLying = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:dfaa86f5-3289-aa2c-d7c7-bffb631f74c7
msgctxt "hb4aa1c3bg5c4eg4b24ga4e3gce9a3081f6f2"
msgid ""
"*Your patron bids you caution before agreeing to this pact. The monk isn't "
"telling you everything.*"
msgstr "*당신의 후원자가 이 맹세에 동의하기 전에 주의할 것을 경고합니다. 몽크가 말해주지 않은 게 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = dfdd677d-78f9-f409-9a06-eacb033973e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:dfdd677d-78f9-f409-9a06-eacb033973e7
msgctxt "h84cac06dg3340g47e8ga150g0b489b15190e"
msgid ""
"A githzerai's mind is not so easily cracked. Our discipline was the very "
"reason we were attacked."
msgstr "기스저라이의 마음은 쉽게 깨지지 않아. 우리가 공격 당했던 건 바로 이 자제력 때문이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = e4752092-7755-7e77-df18-0764173ccaaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:e4752092-7755-7e77-df18-0764173ccaaa
msgctxt "h59a39543ge796g4e7dgbb8dgeb13d4d52e71"
msgid "You're remarkably sane for a pickled brain."
msgstr "병 안에 든 뇌 치고는 놀랍게도 제정신이구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = ec4e6227-e833-5d9f-1bbc-fdf9a3413141
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:ec4e6227-e833-5d9f-1bbc-fdf9a3413141
msgctxt "h229f0d14gb058g4a42g981dgc303f6501e80"
msgid "I'm not sure I can - I have no psionic power."
msgstr "할 수 있을지 모르겠어- 난 사이오닉 능력이 없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = efb2974e-2b92-0013-7cc6-b0f48049f0b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_BrainReader_Memory_Vault_MindWiped = True
#.   Object:
#.     - COL_BrainReader_Memory_Vault_ReceiveReward(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:efb2974e-2b92-0013-7cc6-b0f48049f0b4
msgctxt "h2947262bg126fg4694gb8e6g244925bbb180"
msgid "And I... I see..."
msgstr "그리고... 나도 알게 되지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Player
#. NodeID = f46ead4a-de02-88e1-c7b3-56d6382946cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:f46ead4a-de02-88e1-c7b3-56d6382946cb
msgctxt "hf877e1e1ge816g4445ga399g14b159b8d6a8"
msgid "<i>Reach out and consume her mind.</i>"
msgstr "<i>힘을 뻗어 정신을 흡수한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = f5f3447f-db09-5228-da42-b1712441a6fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - COL_BrainReader_Memory_Vault_AskedAid(2) = True
#.      - COL_Brainreader_Memory_HasMet_Vault(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:f5f3447f-db09-5228-da42-b1712441a6fd
msgctxt "hb0c492dcg6a4eg406ag878dgeb79b6121f19"
msgid "Erase me. <i>Please</i>. My knowledge will be yours."
msgstr "날 지워, <i>제발</i>. 내 지식은 네 것이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = f6454f80-522a-cec0-3fe7-21d817fc29a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:f6454f80-522a-cec0-3fe7-21d817fc29a7
msgctxt "hd2e2684cgdcbeg4abagb355ga09dcb01b7f1"
msgid ""
"I never broke, but... I've spent all these centuries awake. <i>Aware.</i> So "
"here is my offer:"
msgstr ""
"난 굴복하지 않았어, 하지만... 수 세기를 각성 상태인 채로 보냈지. <i>의식이 있었어</i>. 그러니 내가 제안할 것이 있어:"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault
#. Speaker = Slack-Skinned Head
#. NodeID = f923add8-847e-8a5b-e976-7a715f005f11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Brainreader_Memory_Vault:f923add8-847e-8a5b-e976-7a715f005f11
msgctxt "h37a2fb29g0447g4c3ag9001gc8b0118af5da"
msgid ""
"Oh, for a set of hands to slap your face. The <i>yanki</i> lost their way "
"the moment Gith threw down the <i>ghaik </i>empire."
msgstr ""
"아, 네 두 뺨을 후려칠 두 손이 있었다면. <i>기스양키들</i>은 기스가 <i>게이크</i> 제국을 전복시킨 그때 길을 잃었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = 04eeb43e-eb3a-4ca3-ad81-06f340c19069
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:04eeb43e-eb3a-4ca3-ad81-06f340c19069
msgctxt "hc198101ega8e4g4724gaa05g2b226f558f8a"
msgid "Where did you come from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = 0bde70d5-14b9-4010-af45-6fc6f254bd75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b951f0e6-65af-843d-a666-f5284343cc67_MentionedSawAbsolute = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:0bde70d5-14b9-4010-af45-6fc6f254bd75
msgctxt "h59e9a74egc9c7g4020ga96fg2730b1190e56"
msgid "What were your final thoughts?"
msgstr "마지막으로 했던 생각은 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = 12cc435f-e66f-559e-3e0b-1c14535fc3f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:12cc435f-e66f-559e-3e0b-1c14535fc3f5
msgctxt "h7325ac59ga091g45f2g95c3g0bd0f22701d8"
msgid "She was... IT was... <i>wrong...</i>"
msgstr "그분은... <b>그것</b>은... <i>잘못됐어...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = 17bb6b5d-1177-4b66-98be-c4fc54eda43e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:17bb6b5d-1177-4b66-98be-c4fc54eda43e
msgctxt "haa8fa291g380fg4ef5gb901g837332b39031"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = 271608d3-3303-45cf-9006-26ee5fdf0ca7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b951f0e6-65af-843d-a666-f5284343cc67_MentionedSawAbsolute = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:271608d3-3303-45cf-9006-26ee5fdf0ca7
msgctxt "h9c6495efg03bdg4ccdgb974gda77bb7b388c"
msgid "To see Her design... to see... <i>HER</i>..."
msgstr "그분의 설계를 목도하고... <i><b>그분을</b></i> 뵙고자..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = 2dc967fb-0da2-49f2-84d2-c5952266ef16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b951f0e6-65af-843d-a666-f5284343cc67_MentionedReward = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:2dc967fb-0da2-49f2-84d2-c5952266ef16
msgctxt "hd7523777gb449g4d5cg957cgcf3d777013ac"
msgid "And what was this reward?"
msgstr "그래서 받은 보상이 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = 44c55422-7d44-78fb-e3a1-47f05d4a035a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b951f0e6-65af-843d-a666-f5284343cc67_MentionedSawAbsolute = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:44c55422-7d44-78fb-e3a1-47f05d4a035a
msgctxt "hb1cd2095g3145g464cg811agd137e7bc9f76"
msgid "You saw the Absolute? Tell me what She looked like."
msgstr "절대자를 직접 봤다고? 어떻게 생겼는지 말해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = 71ef02f3-1b9c-43eb-b9a3-a9ea634cb5e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:71ef02f3-1b9c-43eb-b9a3-a9ea634cb5e9
msgctxt "h1ea03cefg6236g47d8g83ccgc95a7ac10429"
msgid "Mother... would be... proud..."
msgstr "어머니께서... 자랑스러워... 하시겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = 8c36c564-db6f-4918-b168-6bb3d4be7a7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - b951f0e6-65af-843d-a666-f5284343cc67_MentionedReward = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:8c36c564-db6f-4918-b168-6bb3d4be7a7f
msgctxt "h5dea2236g78fag4784gb735gd750c9c2d36f"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = 90192841-6758-113b-be8c-505020dd8d3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b951f0e6-65af-843d-a666-f5284343cc67_MentionedTrueSoul = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:90192841-6758-113b-be8c-505020dd8d3f
msgctxt "hc07a75ddgc269g44f1g82d7g897c48012d74"
msgid "Before the Absolute - who were you?"
msgstr "절대자를 믿기 전에 넌 뭐 하는 사람이었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = abd58005-fa6d-4e4b-b15e-0cb9a60f4c2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b951f0e6-65af-843d-a666-f5284343cc67_MentionedReward = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:abd58005-fa6d-4e4b-b15e-0cb9a60f4c2f
msgctxt "h6847246cg4e93g424eg8615g676caffb2d98"
msgid "Your reward for what?"
msgstr "무엇에 대한 보상인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = ad45a1a6-ec97-4ea4-bc70-7fc77aeeea75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:ad45a1a6-ec97-4ea4-bc70-7fc77aeeea75
msgctxt "h90979838g5d8bg488eg9f50g9031294a662e"
msgid "Elturgard... She spoke... in my dreams..."
msgstr "엘투르가르드... 그분께서... 내 꿈 속에서... 말씀하셨다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = b3e25d72-bfe8-4550-94c8-fb4d8e7315f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:b3e25d72-bfe8-4550-94c8-fb4d8e7315f1
msgctxt "hc712a641g04fbg4937gaf48g761f47ea7b64"
msgid "Nimias... <i>True Soul</i>..."
msgstr "니미아스... <i>참된 영혼</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = b51d02ba-b328-a5ee-4113-d080063441d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:b51d02ba-b328-a5ee-4113-d080063441d5
msgctxt "hf229576fgc8bfg4e08g981fgc63d6b086c14"
msgid "No... <i>NO!</i>"
msgstr "안 돼... <i><b>안 돼!</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Narrator
#. NodeID = b728dbc6-3cbe-4014-92a9-e81437b992bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:b728dbc6-3cbe-4014-92a9-e81437b992bf
msgctxt "hdc689943g3951g4900g8829g7c9b770abea2"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Narrator
#. NodeID = c4948e35-f588-4cc8-b0e5-cbdac14ca326
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:c4948e35-f588-4cc8-b0e5-cbdac14ca326
msgctxt "hb1372ef6g826bg4e66g9123g699dbcebcaa1"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Player
#. NodeID = ca9afdd5-2be5-4d7e-af3e-3dc915f1c164
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - b951f0e6-65af-843d-a666-f5284343cc67_MentionedTrueSoul = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:ca9afdd5-2be5-4d7e-af3e-3dc915f1c164
msgctxt "h3150777dg20f3g4781g8c0fg185d33e9f0cd"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = cd273039-e972-4665-979c-126afa2d803e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:cd273039-e972-4665-979c-126afa2d803e
msgctxt "he70d1bf9gfc13g4ebeg91d8gb555f3b69910"
msgid "...I brought... converts... young souls... for the <i>Absolute</i>..."
msgstr "...개종할 자들을... 데리고 왔지... 어린 영혼들... <i>절대자</i>께 바칠..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Narrator
#. NodeID = d0f0a51c-0eae-4566-abe8-6aec1ec0d849
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:d0f0a51c-0eae-4566-abe8-6aec1ec0d849
msgctxt "h811c2758g58e8g4a7cg8caagec905b9a227f"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = e491bd42-599f-4196-b816-2d3e874d09ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:e491bd42-599f-4196-b816-2d3e874d09ec
msgctxt "hdc6f609dg08abg436bgbb38g9ee954fd472a"
msgid "Altar... rooftop... my <i>reward</i>..."
msgstr "제단... 옥상... 내가 받을 <i>보상</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Corpse
#. NodeID = f385c941-7d5f-a08e-b2c9-b7086ca882ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:f385c941-7d5f-a08e-b2c9-b7086ca882ae
msgctxt "hff1d589cg2eadg4642g90ebgfc4265c69f9f"
msgid "Nimias... <i>schoolteacher</i>..."
msgstr "니미아스... <i>학교 선생</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead
#. Speaker = Narrator
#. NodeID = f3a7a210-5974-455a-b443-786d809cb902
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_Corpse_Dead:f3a7a210-5974-455a-b443-786d809cb902
msgctxt "h0cf18b9cgd257g4aebgb718g280841023114"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "h0d3094d3ga011g4db6gbfc8g329ffa3f14cf"
msgid "So this is where Moonrise dumps its waste."
msgstr "문라이즈 쓰레기 처리장이 여기군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "h65bdb403g1391g4e8fg8b71gd4fd6b177a20"
msgid "Oh joy. Leftovers from Moonrise Towers."
msgstr "끝내주는구만. 문라이즈 타워에서 버린 자들이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "hb356ef5cg6f45g4b01g8107gc44e4903c10f"
msgid "Tsk. Whoever that was, this place chewed them up and spit them out."
msgstr "쯧. 누군지는 모르겠지만, 이 장소가 씹어먹고 뱉은 찌꺼기군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "h0b8ff107gad6ag46e6g904ag9a6442142ba5"
msgid "A victim dumped from Moonrise. And hardly the first."
msgstr "문라이즈에서 버림받은 희생자로군. 이 자 말고도 많겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "h1184ac3ag5571g4c20ga188g67dd891ecd2c"
msgid "Leftovers from Moonrise. Not a peaceful death..."
msgstr "문라이즈에서 버린 것이군. 평온한 죽음은 아니야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "h4c622ea1g8e44g4299gbe58g445ac1a6303c"
msgid "Ugh. Plopped right down from the tower."
msgstr "어휴. 탑에서 바로 떨어뜨렸군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "h59f79ccdg66b0g4718ga036gcaea841dde3f"
msgid "A supplicant whose soul was not true enough, I take it."
msgstr "영혼이 충분히 참되지 못한 신자였던 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "hc2753384gfbd7g4d3dgabcfgccdf98fbb6fa"
msgid "A victim of Moonrise Towers. Nothing is sacred in that place."
msgstr "문라이즈 타워의 희생자야. 그 장소는 전혀 신성한 곳이 아니군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD
#. Speaker = Player
#. NodeID = e5786663-0d0c-426d-bd86-56785663a313
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD:e5786663-0d0c-426d-bd86-56785663a313
msgctxt "hc20f843cg4cb5g46f2g8d93g4d906e89305c"
msgid "An offering from Moonrise Towers."
msgstr "문라이즈 타워에서 바친 공물이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "h97fb7bcbgcf8bg41b8gaf30g66448b7c2209"
msgid "Delightful! I prefer it fresh, but still - beggars, choosers, all that."
msgstr "아주 좋아! 신선한걸 더 좋아하긴 하지만, 어쩌겠어 - 찬밥 더운 밥 가릴 때가 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "hc5d0e5e8g0c4cg4248g873fg512c8420fd7f"
msgid "Wonderful. I was just thinking I was far too clean."
msgstr "환상적이군. 마침 내가 너무 깔끔한 거 아닌가 생각하고 있었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "h9d281da1g989eg45a0g9ecbg13faee573b31"
msgid "Ugh. As if we won't be covered in it soon enough."
msgstr "으. 어차피 좀 있으면 다 뒤집어 썼을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "he8d58bc7gfe85g4df1gac64gba0b84a57835"
msgid "Hmm. Tastes like dwarf."
msgstr "흐음. 드워프 맛이 나는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "h0447312egec84g4f30g80adgfb65ce480ede"
msgid "Wonderful. Just fantastic."
msgstr "아주 좋아. 정말 죽여주는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "hf497c119g3e9cg4c3bg9325gc50e89119ab0"
msgid "Wonderful. Now I'm splattered like a sloppy butcher."
msgstr "아주 좋아. 실력 없는 도살자 마냥 온통 뒤집어 썼는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "hda092917gf2bag4dacg8ea6gf04b829e420d"
msgid "Ugh! Gods, now I'm soaked in it!"
msgstr "으! 신이시여, 완전 뒤집어 썼잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "hc74a5d93g449eg43c7gbb58g65e8767d1ea8"
msgid "Damn. Now I smell like a wolf pack's supper..."
msgstr "젠장. 이제 늑대 점심밥 같은 냄새가 나겠군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower
#. Speaker = Player
#. NodeID = 19aed420-f82e-4c28-9c5c-c2544f649f8d
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_CleansingChute_PAD_BloodShower:19aed420-f82e-4c28-9c5c-c2544f649f8d
msgctxt "hed4f8165gc18ag4bb3gbfbegdf300b84259b"
msgid "Nine Hells, it's <i>everywhere</i>!"
msgstr "아홉 지옥같은, <i>온 사방</i>에 가득하잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_ElderBrain_AD_Rapid01
#. Speaker = Disembodied Voice
#. NodeID = 167e420c-a3e4-4aa7-9493-8c8810bf6ac1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_ElderBrain_AD_Rapid01:167e420c-a3e4-4aa7-9493-8c8810bf6ac1
msgctxt "hbeffb430gbf08g4dfcg9d01g1fce10570c36"
msgid "---<b><i>DESCEND</i>---</b>"
msgstr "---<b><i>내려오라</i>---</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_ElderBrain_AD_Rapid02
#. Speaker = Disembodied Voice
#. NodeID = 32225202-58b9-4637-8aa4-93569099490d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_ElderBrain_AD_Rapid02:32225202-58b9-4637-8aa4-93569099490d
msgctxt "h08fe137bgbc08g4372g943bg709e4e1ddd82"
msgid "---<b><i>ASSEMBLE</i>---</b>"
msgstr "---<b><i>모여라</i>---</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_ElderBrain_AD_Rapid03
#. Speaker = Disembodied Voice
#. NodeID = 8f4a8e50-75f5-4ba3-9374-74c1b378caa3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_ElderBrain_AD_Rapid03:8f4a8e50-75f5-4ba3-9374-74c1b378caa3
msgctxt "hbda2de7dgddecg4958g9256g764420d6a81e"
msgid "---<b><i>PREPARE</i>---</b>"
msgstr "---<b><i>준비하라</i>---</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_ElderBrain_AD_Rapid04
#. Speaker = Disembodied Voice
