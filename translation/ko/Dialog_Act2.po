#.      - COL_Barracks_State_CharacterWasBlessed(1) = False
#.   Tag:
#.      - ILLITHID_HIDDEN_CHECK(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls:4f4a3987-4f70-bdaa-ff2f-9f6b3479378f
msgctxt "h5e9602e5g71a2g4b24g8511g0380869cc62c"
msgid "I seek your blessing."
msgstr "전 당신의 축복을 구합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Barracks_MistressOfSouls
#. Speaker = Player
#. NodeID = 5dd35bcf-7ba7-5f83-73eb-c7d9c8a57b61
