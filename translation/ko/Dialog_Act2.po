msgctxt "h32480cc3gb129g41edg8c09g47998ac77882"
msgid "It needs to be powered. However you do that..."
msgstr "동력을 공급해야 해. 너만 원한다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_RegenStation_PAD
#. Speaker = Player
#. NodeID = f941e883-b0c6-2be6-cf2f-f4d710cb521c
