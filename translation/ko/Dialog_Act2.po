msgctxt "hccdd36e9gd4adg4acdg84ccg69c8889b606b"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Hyena_AD_CaravanLeaves
#. Speaker = Warrior Gronag
