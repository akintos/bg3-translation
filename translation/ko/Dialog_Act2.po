#.     - 5b1ec9d1-cec5-2107-d929-f1af9c05d5d9_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse:f18eb56c-47b3-440a-b1c2-d4376296a923
msgctxt "h6a187e70g6f52g43c8g8a66g86802111b1c4"
msgid "The shadows are hungry - and Shar won't help me now."
msgstr "그림자가 굶주렸어. 그리고 이제 샤님은 날 돕지 않으실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight
#. Speaker = Player
#. NodeID = a815734f-7f0e-4dc6-80c1-5c795c28b2f2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight:a815734f-7f0e-4dc6-80c1-5c795c28b2f2
msgctxt "h664727c9ge00dg4cd5g9f02g31a842e0b15b"
msgid "I can feel the curse withering. It must be the light..."
msgstr "저주가 약해지는 게 느껴져. 분명 빛 때문이겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight
#. Speaker = Player
#. NodeID = a815734f-7f0e-4dc6-80c1-5c795c28b2f2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight:a815734f-7f0e-4dc6-80c1-5c795c28b2f2
msgctxt "h92ebc080g4539g47bag8bfcgdaa701c276a6"
msgid "Look at that. In this light there is shelter from the shadows."
msgstr "저것 좀 봐. 이 빛 안에서만큼은 그림자로부터 안전해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight
#. Speaker = Player
#. NodeID = a815734f-7f0e-4dc6-80c1-5c795c28b2f2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight:a815734f-7f0e-4dc6-80c1-5c795c28b2f2
msgctxt "h22095fd1g63b2g49f2g99eag7bf812344fe0"
msgid "Hey - light seems to protect against the shadows."
msgstr "이것 봐, 빛이 그림자로부터 우릴 보호해 주는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight
#. Speaker = Player
#. NodeID = a815734f-7f0e-4dc6-80c1-5c795c28b2f2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight:a815734f-7f0e-4dc6-80c1-5c795c28b2f2
msgctxt "h600ce442g5e11g4b2agba6eg26e2798837f5"
msgid "The light - the curse cannot penetrate its glow."
msgstr "그 빛. 저주도 그 불빛만큼은 어쩌지 못하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight
#. Speaker = Player
#. NodeID = a815734f-7f0e-4dc6-80c1-5c795c28b2f2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight:a815734f-7f0e-4dc6-80c1-5c795c28b2f2
msgctxt "h99c1d389gc4afg4bedgab4eg550cef6f3d56"
msgid "The light - it's warding off the curse."
msgstr "그 빛, 그게 저주를 막아주고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight
#. Speaker = Player
#. NodeID = a815734f-7f0e-4dc6-80c1-5c795c28b2f2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight:a815734f-7f0e-4dc6-80c1-5c795c28b2f2
msgctxt "hd96ec4b0gb538g439fg9fb0geda5dcf8ff4c"
msgid "I'll be. The light wards off the shadows."
msgstr "이런 세상에. 빛이 그림자를 막아주고 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight
#. Speaker = Player
#. NodeID = a815734f-7f0e-4dc6-80c1-5c795c28b2f2
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_CurseRemovedByLight:a815734f-7f0e-4dc6-80c1-5c795c28b2f2
msgctxt "h3c9c2f07geddeg4c18g94f3g2acfc91e652f"
msgid "That light - it's protecting me from the curse."
msgstr "저 빛이... 저주를 막아줄 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "h295afae5g396eg45e2g8e36g7cc7eecf738e"
msgid "I feel it too... draining me dry..."
msgstr "나도 느껴져... 고갈되는 느낌이야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "h12d7c593g455eg4e1ega2dbgb3a101606e54"
msgid ""
"I can barely think straight... this place saps the very thoughts from your "
"mind."
msgstr "생각을 제대로 할 수가 없네... 이 공간이 마음속에 있는 생각을 지워버리고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "hf8963605g91cdg4492ga84dg5b438b4a3ef9"
msgid "I feel it too. My very essence... draining away."
msgstr "나도 그렇게 느낀다. 내 정수 자체가... 빠져나가고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "ha37c0d8fge07bg44a0g969eg6ccea4424b71"
msgid "The shadows will not consume me - I am shielded by Lady Shar."
msgstr "그림자는 날 집어삼키지 못해. 난 샤 여신님의 가호를 받고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "hf9950a5fg126ag4b41g9533g0871a1deb1e0"
msgid "Same here. I feel... cold."
msgstr "나도 마찬가지야. 느낌이... 추워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "h314722fbg80cdg476ag9920gf5733dd7e006"
msgid "Me too. So <i>cold.</i>"
msgstr "나도 그래. 너무 <i>추워.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "hf1715adag62fag4cb9ga43eg4c1562a2e487"
msgid "I feel it also. Energy fading... I won't last long here."
msgstr "나도 똑같이 느껴진다네. 에너지가 사라지는군... 여기선 오래 못 버틸걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 0613a4fc-dfda-a931-754b-1f2896626fd7
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:0613a4fc-dfda-a931-754b-1f2896626fd7
msgctxt "h9698e726g4bf4g4b91gabb4g50739d187034"
msgid "I feel it too. Losing energy... losing focus..."
msgstr "나도 그렇게 느껴져. 에너지를 잃고 있고... 집중력을 잃고 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 13263d80-32be-21d7-c0d0-0740a2fc192b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:13263d80-32be-21d7-c0d0-0740a2fc192b
msgctxt "h13e16be3g3346g40bag9acbg232bf9560013"
msgid "It affects me just fine. I need some light..."
msgstr "나는 영향을 아주 잘 받는다고. 빛이 좀 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 13263d80-32be-21d7-c0d0-0740a2fc192b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:13263d80-32be-21d7-c0d0-0740a2fc192b
msgctxt "h29e5ec61gcbe9g4064g97fbgdadd05e457a2"
msgid "They feed on me instead... I need light..."
msgstr "대신 나를 잡아먹는군... 빛이 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 13263d80-32be-21d7-c0d0-0740a2fc192b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:13263d80-32be-21d7-c0d0-0740a2fc192b
msgctxt "ha6d1a03ag092bg42afgad95ga0b7f3887ad6"
msgid "<i>Chk</i>. And I'm losing strength with every step through the dark."
msgstr "<i>츠크</i>. 나는 어둠 속으로 내딛는 매 발걸음마다 힘을 잃고 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 13263d80-32be-21d7-c0d0-0740a2fc192b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:13263d80-32be-21d7-c0d0-0740a2fc192b
msgctxt "h8b8c385bg006cg4193g9ae7g2221162883e6"
msgid ""
"Well - I've got to dispel these shadows, before I fall to this damned curse."
msgstr "이런... 이 망할 저주에 빠지기 전에, 이 그림자를 몰아내야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 13263d80-32be-21d7-c0d0-0740a2fc192b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:13263d80-32be-21d7-c0d0-0740a2fc192b
msgctxt "hf3801d2cg5febg4103g8790g791598442d5d"
msgid "Speak for yourself. I feel awful."
msgstr "너나 그렇지. 난 끔찍한 느낌이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 13263d80-32be-21d7-c0d0-0740a2fc192b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:13263d80-32be-21d7-c0d0-0740a2fc192b
msgctxt "h278468c8gf7a7g44b6ga839g088b3b669a87"
msgid "I do not share in your fortune - the shadows hunt me. I need a torch."
msgstr "자네의 행운이 내게는 적용되지 않는 모양일세, 그림자가 나를 해치고 있어. 횃불이 필요하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 13263d80-32be-21d7-c0d0-0740a2fc192b
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters:13263d80-32be-21d7-c0d0-0740a2fc192b
msgctxt "h2f863902g1c28g493aga38cg738650037459"
msgid "I'm not so lucky. Got to dispel these shadows... somehow..."
msgstr "난 그렇게 운이 좋진 못한 것 같네. 어떻게든... 이 어둠을 몰아내야 해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse_2Characters
#. Speaker = Player
#. NodeID = 1d62b08c-bb36-ddb7-a84c-0a5b370626e0
