msgctxt "h04e68292gcbfeg4ad8gbf4eg61928decfc4c"
msgid "What have you got?"
msgstr "뭐뭐가 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = ba2b07d8-a7ff-8d83-ab99-9adafb3ecb3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01:ba2b07d8-a7ff-8d83-ab99-9adafb3ecb3e
msgctxt "h857651e5g4d76g462ag9398gc0157859ff41"
msgid "Fine. How much do I owe you?"
msgstr "좋아. 얼마면 되는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Astarion
#. NodeID = e4b222a1-689f-435b-bd74-507fba9c43a3
