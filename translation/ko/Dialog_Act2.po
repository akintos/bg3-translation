msgctxt "h6a3d4666g56e3g4987g88dcgbc64718a907e"
msgid "Glad to see you made it. I am, indeed I am."
msgstr "네가 무사하다니 기쁘네, 기뻐. 정말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
