#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#.   Local:
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_C = False
#.     - 0276d317-8b34-66e2-48e2-6b9d69d6830b_D = False
