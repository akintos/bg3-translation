#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:c92a1c3d-5d51-968a-72a0-f7e2cbd8b1bf
msgctxt "h55ad5caag90a0g49c0gb3b3g0ff021e0cda9"
msgid ""
"Ugh - I know that corpse. Arabella's mother's met a most unpleasant end."
msgstr "으, 저 시체가 누군지 알겠어. 아라벨라의 어머니가 아주 불쾌한 최후를 맞았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Gale
#. NodeID = c9b32339-b0eb-3333-9357-6e9fe514e755
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:c9b32339-b0eb-3333-9357-6e9fe514e755
msgctxt "h7e041cadge3e2g480dgb77bge1d4272cb046"
msgid ""
"A dead tiefling. Arabella's father, no doubt. The horror of his end I "
"daren't contemplate."
msgstr "죽은 티플링. 의심할 여지없이 아라벨라의 아버지로군. 그 죽음의 공포를 감히 상상하지도 못하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Wyll
#. NodeID = cb4b396a-8b35-e47f-b7c7-16da0b948bbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:cb4b396a-8b35-e47f-b7c7-16da0b948bbe
msgctxt "h0a365069gca85g4d03g9e45gb64b33431e38"
msgid "That tiefling's seen better days. Arabella's mother, I wager."
msgstr "저 티플링도 좋은 시절이 있었겠지. 틀림없는 아라벨라의 어머니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = cda08ab8-b650-7835-5528-9928e906cddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:cda08ab8-b650-7835-5528-9928e906cddc
msgctxt "hf238b02fg60b6g463fgb01ag0c92bd648f24"
msgid "Not dead, merely medicated. To ease the pain."
msgstr "죽은 게 아니라, 약효가 도는 거예요. 고통을 완화해야 하거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Gale
#. NodeID = ce632889-5271-4ffe-b22a-423507489fd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:ce632889-5271-4ffe-b22a-423507489fd9
msgctxt "h095749f8g75bcg4809g9670g23be6a68a122"
msgid ""
"This corpse... It's Arabella's father. The horror of his end I daren't "
"contemplate."
msgstr "이 시체... 아라벨라의 아버지로군. 그 죽음의 공포를 감히 상상하지도 못하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Player
#. NodeID = dcca5342-3b11-992c-09fa-7e322a47e8d1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_Reception_CorpseTender_PassedDruidCheck(1) = False
#.      - TWN_CorpseTender_Event_PassedMedicine(1) = False
#.   Tag:
#.      - MONK(1) = True
#. SetFlags:
#.   Dialog:
#.     - TWN_CorpseTender_Event_PassedMedicine(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:dcca5342-3b11-992c-09fa-7e322a47e8d1
msgctxt "h19593f34ga30fg46d3ga756g8c1816144dfd"
msgid ""
"I know this stillness - his body is simply conserving energy as he heals. "
"The patient is stable."
msgstr "이 상태 잘 알지. 신체가 치유를 위해 힘을 비축하느라 인기척이 없어. 환자는 안정된 상태야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = dcfb167c-53c8-983f-f00c-364d9665a992
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:dcfb167c-53c8-983f-f00c-364d9665a992
msgctxt "h98baabd2g0e3bg42e2g99e4gb2a32b48557b"
msgid "Your untrained eyes deceive you."
msgstr "비전문가의 식견엔 그렇게 보이나 보군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = dd1bf724-c921-4d3d-beb3-6102feea7434
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:dd1bf724-c921-4d3d-beb3-6102feea7434
msgctxt "hfa1f568cg105dg4c56gbfb5g08f17fa9f3b4"
msgid ""
"Oh, you're a patient. This is the children's ward - triage is back that way."
msgstr "아, 환자시군요. 여긴 어린이 병동이에요, 부상자는 저쪽으로 가시면 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Astarion
#. NodeID = e49fdf23-0d89-49b8-81b8-f63272f7220a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:e49fdf23-0d89-49b8-81b8-f63272f7220a
msgctxt "h68c4fe27g9351g4502gafdegd08a6b42080e"
msgid ""
"Is that Arabella's father she's tending? Our little idol thief has some "
"terrible luck."
msgstr "저 여자가 돌보는 사람 아라벨라의 아버지 아닌가? 우리 귀여운 우상 도둑은 진짜 운이 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = e8f6689a-bc5d-e89f-ef69-7c95b2408f45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:e8f6689a-bc5d-e89f-ef69-7c95b2408f45
msgctxt "h73481fd6gb553g4334g9894g61f04af1a65c"
msgid "The patient is asleep. The sedative is quite strong, you see."
msgstr "환자분은, 수면 상태, 라니깐요. 진정제가 꽤 세서 그렇다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = ec0bbf67-b6f2-4bd6-be54-f2bd20514898
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_SurgeonPermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - TWN_CorpseTender_HasMet2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:ec0bbf67-b6f2-4bd6-be54-f2bd20514898
msgctxt "h0b35289bgdad0g4021ga563g7037cd8c6794"
msgid ""
"The doctor's found oblivion... well. No time to mourn. I'll fix this without "
"him."
msgstr "선생님께선 사라지셨지만... 그래도. 슬퍼할 때가 아니야. 그 분이 없어도 내가 고칠 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Gale
#. NodeID = ef5619fd-f8e6-e20c-dfe9-70dce9810fe5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:ef5619fd-f8e6-e20c-dfe9-70dce9810fe5
msgctxt "h8652946dg7285g4cb8g98deg16b438545927"
msgid ""
"This corpse... It's Arabella's mother. The horror of her end I daren't "
"contemplate."
msgstr "이 시체... 아라벨라의 어머니로군. 상상조차 못할 죽음의 공포를 느꼈겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Narrator
#. NodeID = f7fa6481-a98f-ace1-0c42-bc3771b4d355
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:f7fa6481-a98f-ace1-0c42-bc3771b4d355
msgctxt "h9e4b0003g2f19g4cc2g9cb4ga635a2f4edea"
msgid "*You recognise the corpse being tended - the girl Arabella's mother.*"
msgstr "*진료를 받는 시체가 누구인지 알아챕니다, 그 소녀 아라벨라의 어머니입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Narrator
#. NodeID = f8302098-fba3-63eb-e1f5-14c215396b33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:f8302098-fba3-63eb-e1f5-14c215396b33
msgctxt "hb4444df5g5730g4eb0gacbcga4db0a78d2dd"
msgid ""
"*The corpse is a tiefling woman - the girl Arabella's mother, presumably.*"
msgstr "*시체는 티플링 여성입니다, 짐작건대, 그 소녀 아라벨라의 어머니인듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = f91519e1-46ea-ced4-9dc3-bb7b18b173a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_CorpseTender_State_PassedCorpseCheck = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:f91519e1-46ea-ced4-9dc3-bb7b18b173a7
msgctxt "hd8681d04geeb5g405bga01fgfb61fe223dfb"
msgid ""
"Yes, yes! I knew these hands would not fail me. The patient is sure to "
"recover."
msgstr "네, 맞아요! 제 손으로도 해낼 줄 알았다니까요. 환자분은 분명 곧 회복되실 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = fe8165a0-91f2-89cb-70b9-7366c765afee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e165ff5e-f019-e71d-3546-cdf71c4ef8a7_AskedForTradeReaction = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:fe8165a0-91f2-89cb-70b9-7366c765afee
msgctxt "h3378d913gb3deg4678gbf73g2e9f377f264c"
msgid "Still not feeling better? Let's see if I can help you."
msgstr "아직도 몸이 편찮으셔요? 도움이 됐으면 좋겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 04ac8fe6-0260-ea77-77fc-e96e31b3bb3d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:04ac8fe6-0260-ea77-77fc-e96e31b3bb3d
msgctxt "h6894650fgad7fg49dbg9de3ge2d7e8d91dc4"
msgid ""
"I'm sick with a deep malaise, one that came from a place beyond the stars."
msgstr "난 지금 별 너머의 공간에서 온 깊은 무기력함에 시달리고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 04ac8fe6-0260-ea77-77fc-e96e31b3bb3d
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:04ac8fe6-0260-ea77-77fc-e96e31b3bb3d
msgctxt "h32ebafd9g4935g4050g8a1fg69372b9805cd"
msgid ""
"I've broken out in weird, singing hives - a sure sign of faerie infection."
msgstr "이상한, 노래하는 두드러기가 올라왔어. 요정 감염의 확실한 징후지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 04ac8fe6-0260-ea77-77fc-e96e31b3bb3d
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:04ac8fe6-0260-ea77-77fc-e96e31b3bb3d
msgctxt "h9f51dbb7g2537g4dcdg965fg507e7c9b60ea"
msgid "I've picked up a diabolic disease - the symptoms are quite hellish."
msgstr "악마의 병에 걸렸어. 증상이 꽤나 지옥 같더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 0c5c17ab-cfda-5b15-3842-04ad53584072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:0c5c17ab-cfda-5b15-3842-04ad53584072
msgctxt "h1993468eg4696g447fga0b2gdcce55db89bb"
msgid "Poor dear. Poor, poor dear. Who did this to you?"
msgstr "불쌍한 것. 정말 불쌍한 것. 누가 이런 짓을 했어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 0f0f6ea7-516f-164d-ad1b-865d455fd81a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:0f0f6ea7-516f-164d-ad1b-865d455fd81a
msgctxt "h3ed40977gb29eg44d6gb2ebg3b7794ebe933"
msgid "Sisters! Protect the patients!"
msgstr "자매들이여! 환자들을 보호하세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 11eafb0a-9db5-b818-8a40-e97a125c2a28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_SurgeonPermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:11eafb0a-9db5-b818-8a40-e97a125c2a28
msgctxt "h758404ccg3b4eg4b5egb142g3e2e7b08e8f4"
msgid "The doctor is absent today. Come back another time."
msgstr "의사 선생님이 오늘 안 계시네요. 나중에 다시 찾아와주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 122d1454-573f-3819-b007-46ae1493b7c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:122d1454-573f-3819-b007-46ae1493b7c7
msgctxt "hc9d4633fg0d49g479bgbd3ag1bd9d336eb4e"
msgid "Down to the theatre, be swift, be saved."
msgstr "수술실로 내려가세요, 빠를수록 좋습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 1860ea4c-4bb5-2e55-0edf-bd69b8b83ad8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:1860ea4c-4bb5-2e55-0edf-bd69b8b83ad8
msgctxt "h6f73b7b0g05b3g4620gaedbg95e5b45beb39"
msgid "Join the line - you <i>will</i> be seen."
msgstr "줄을 서 주세요. 선생님이 곧 봐주실 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 19bb086b-d08e-1007-36e7-ac84b776ece6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_Reception_State_InLine = False
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:19bb086b-d08e-1007-36e7-ac84b776ece6
msgctxt "hb824580dg8d7fg4af8gbdc8g73b08353391b"
msgid "No thanks, I'll take my chances out there."
msgstr "고맙지만, 다른 곳을 찾아볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 1abf725d-6147-b1bd-909d-d19b353e4f48
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:1abf725d-6147-b1bd-909d-d19b353e4f48
msgctxt "h5acdbabfg1bb9g4089g8f68g0feff13d13c1"
msgid "<b><i>ROAR AT THIS INJUSTICE. </i></b>"
msgstr "<b><i>이 불공평함에 포효한다. </i></b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 1b17c316-c35a-574c-3110-b6ca0f46cd01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:1b17c316-c35a-574c-3110-b6ca0f46cd01
msgctxt "hbed0924fg70adg404cg8170gea5954c8e749"
msgid "Yes yes, but all must wait. The doctor's hands are <i>full</i>."
msgstr "네 네, 하지만 다 기다려야 해요. 의사 선생님은 이미 <i>바쁘세요</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 1f3a39d3-36d0-c6d2-94d7-96fb929ae78c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - TWN_Hospital_Reception_Receptionist_FailedPersuasion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:1f3a39d3-36d0-c6d2-94d7-96fb929ae78c
msgctxt "h77f530aag74efg423cgaed9g8cfa7cfbaf17"
msgid ""
"Quiet! <i>Quiet!</i> Everyone must wait their turn, wait in line... Doctor's "
"orders."
msgstr "조용! <i>조용!</i> 모두 차례를 기다리고 줄 서서 기다려야 해요... 의사 선생님의 명령이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 23964e7a-ad05-33fd-2618-c28e1ac2a636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:23964e7a-ad05-33fd-2618-c28e1ac2a636
msgctxt "hf3a571d7g2927g4fe3gaf93g59f12324be9e"
msgid "Get away from me!"
msgstr "내게서 떨어져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 26808e44-baf0-85bc-9058-24e2d1eebd5b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:26808e44-baf0-85bc-9058-24e2d1eebd5b
msgctxt "h1a4007bbg6580g4412g9052gb4837a95b016"
msgid ""
"<i>Mimic the symptoms of </i>Assassin's Blood,<i> a well-known poison.</i>"
msgstr "<i>잘 알려진 독극물인 </i>암살자의 피의 증상을<i> 흉내낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 2c03c807-dc3d-f5fc-2131-a78c05c7873c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:2c03c807-dc3d-f5fc-2131-a78c05c7873c
msgctxt "h6ba16a60g7887g45dcg9ba4g209a2f713101"
msgid "I'm not a patient - I've been hired as a new healer."
msgstr "난 환자가 아니야. 새 치유사로 고용된 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 2df8c4f8-c8fb-fe3f-930c-4b240efe0ca9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:2df8c4f8-c8fb-fe3f-930c-4b240efe0ca9
msgctxt "h1dcf1ef7g97e1g422agb395g06dd430dffde"
msgid ""
"I am but a nurse here, the Surgeon... he will be able to examine you in full."
msgstr "전 간호사일 뿐이에요, 외과의 선생님은... 전부 진찰할 수 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 2e83c2f7-3e6e-0fb5-2957-a0fbbaea5acd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ASTARION(1) = True
#.      - REALLY_ASTARION(1) = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:2e83c2f7-3e6e-0fb5-2957-a0fbbaea5acd
msgctxt "hd7cf26bbg6c37g48b3g9792gd754268eecf2"
msgid "My dear lady - look at my complexion. I am at death's door."
msgstr "간호사씨, 내 안색을 봐. 죽음의 문턱에 다다른 것 같잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 2fd0c7ac-f647-baa4-cedd-7a90206e955f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:2fd0c7ac-f647-baa4-cedd-7a90206e955f
msgctxt "h4fc2620bg0aeeg4e21g99degba5657c566ee"
msgid "Enough of this - I'm going in."
msgstr "이제 그만 - 난 들어가겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 3342a30f-45fd-dfab-cfab-642e06344d25
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - TWN_Hospital_Reception_Receptionist_FailedPersuasion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:3342a30f-45fd-dfab-cfab-642e06344d25
msgctxt "h62af2397ga21eg42f0g948cg7a0406333677"
msgid "Such cruelty, such callousness. And in our time of need. <i>Away</i>."
msgstr "이렇게 잔인하게 굴 건가요? 이렇게 매정하게 굴 건가요? 지금 매우 간절한 상황인데. <i>사라지세요</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 37544833-5d8d-0d45-6d71-be29be368457
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:37544833-5d8d-0d45-6d71-be29be368457
msgctxt "h0fcbf586gcca1g4474gba15gd2bf9cd8cc6c"
msgid "BARD"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 37544833-5d8d-0d45-6d71-be29be368457
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:37544833-5d8d-0d45-6d71-be29be368457
msgctxt "h44949806g45e4g4cffgbec7g3fd653402056"
msgid "<i>Feign the symptoms of a disease most terrible.</i>"
msgstr "<i>가장 끔찍한 질병의 증상인 척한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 3830fe89-de2b-1a7b-ed50-d37d38434aa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:3830fe89-de2b-1a7b-ed50-d37d38434aa9
msgctxt "hebf05de5gb246g45acgabe9g34481026c910"
msgid "My mind is full of holes, and some of them are still being punched."
msgstr "내 정신은 구멍투성이야, 몇몇은 지금도 뚫리고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 3d96eca7-d38e-05a4-d0a4-16c86cd6d3a6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:3d96eca7-d38e-05a4-d0a4-16c86cd6d3a6
msgctxt "h605b2c40g50b4g44e6gba0eg2aadeae42409"
msgid "The unseen wounds of war - the doctor's hand will close them."
msgstr "전쟁의 보이지 않는 상처. 의사 선생님의 손길이 봉합해 줄 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 401f3f4f-1556-5b4f-4d0c-6921e102fe05
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:401f3f4f-1556-5b4f-4d0c-6921e102fe05
msgctxt "h9c1d64a7g0697g41bagae14g148314480a39"
msgid "The doctor will see you. The doctor will soothe."
msgstr "의사 선생님이 당신을 봐줄 거예요. 의사 선생님이 위로해줄 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 45a1026e-51eb-8baf-9e14-8fe8629af6a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - TWN_Hospital_Reception_Receptionist_FailedPersuasion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:45a1026e-51eb-8baf-9e14-8fe8629af6a1
msgctxt "ha0dba414gde14g43c1ga982ge5bfea0e5ec8"
msgid "You endanger the sick!"
msgstr "아픈 사람을 위험에 빠뜨렸어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 4b51b01d-bee1-d15d-e609-9499321e5859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:4b51b01d-bee1-d15d-e609-9499321e5859
msgctxt "h7f21e558g2d98g43dcg9699g145f08b9189f"
msgid "Plague! Pest! In line, or <i>leave</i>."
msgstr "역병! 해충! 줄 서세요! 아니면 <i>떠나세요</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 4dea850a-c95c-81b2-1995-223b55356a8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:4dea850a-c95c-81b2-1995-223b55356a8c
msgctxt "h25cd3cd5gcff8g42c7gad39g7a4bb0147239"
msgid "The doctor will see you now."
msgstr "의사 선생님이 당신을 봐주실 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 512d60e2-adcb-44e0-6370-0f329c4b464e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:512d60e2-adcb-44e0-6370-0f329c4b464e
msgctxt "he2318963g6929g486ega2fag5ccddbfb2880"
msgid "What is the primary symptom?"
msgstr "초기 증상이 뭐였나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 611d97a4-dddd-c7b4-4861-381df8b4597f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:611d97a4-dddd-c7b4-4861-381df8b4597f
msgctxt "ha2f4de8eg421dg4973ga410g19e2b0d5c2d7"
msgid "I'm only truly <i>happy </i>when I'm ending someone's life."
msgstr "누군가를 끝장낼 때만 <i>진정으로</i> 행복을 느껴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 6178b2da-0436-9c90-35af-716c24b3f7c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:6178b2da-0436-9c90-35af-716c24b3f7c0
msgctxt "hec56be7fgfe0bg41feg9296gfc32850c611b"
msgid "Poor creature - so sad, so sick."
msgstr "불쌍한 사람 - 너무 슬프고, 너무 아파요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 6191f2bf-fabd-3b7e-e626-9022c91b37bb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:6191f2bf-fabd-3b7e-e626-9022c91b37bb
msgctxt "h29cd8f97g0bbdg4a98ga64ag99d541a8cf77"
msgid "<i>Pretend to be ill.</i>"
msgstr "<i>아픈 척을 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 65a389b1-682f-c15c-12a3-92b4478c5cc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:65a389b1-682f-c15c-12a3-92b4478c5cc7
msgctxt "h1a404545g01b1g4b3eg9c77g26703b959f11"
msgid "Join the line - you <i>will</i> be seen."
msgstr "줄을 서 주세요. 선생님이 곧 봐주실 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 7d0210b7-9ba0-e434-895d-fa01e39c0d30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:7d0210b7-9ba0-e434-895d-fa01e39c0d30
msgctxt "hed41bc00g6bd8g4523g8a4dg2f46a10db899"
msgid "Down the corridor. Down to theatre you go."
msgstr "통로를 따라 가시면 수술실로 내려가실 수 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 830fff1d-3a26-50fd-338a-a935a4b5495d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:830fff1d-3a26-50fd-338a-a935a4b5495d
msgctxt "h267b48a5g801ag4347g831ag35b355bb2a63"
msgid ""
"Every monster you can imagine, man or beast, has tried to kill me. I should "
"really see the doctor."
msgstr "네가 상상할 수 있는 모든 괴물이, 사람이건 짐승이건, 날 죽이려 들었어. 진짜 의사를 만나봐야 한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 83b55c89-8a41-0d96-753b-f48536f26489
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:83b55c89-8a41-0d96-753b-f48536f26489
msgctxt "hdc8e59c3ge299g4af4ga4b8gc9af7766ee46"
msgid "Hrm, hrm. Let me check, let me check."
msgstr "흠, 흠. 어디 보자, 어디 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 8a49813d-ceb6-6497-3af7-8ca937cd0b62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_Reception_Receptionist_HasMet(1) = True
#.      - TWN_Hospital_Reception_Receptionist_FailedPersuasion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:8a49813d-ceb6-6497-3af7-8ca937cd0b62
msgctxt "h4af341eeg6edbg4b4aga61dg4a436c037820"
msgid "Not sick, not welcome!"
msgstr "아프지 않으면, 환영하지 않아요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 8e1adbc0-33e3-6d93-926d-698e2508695d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_Reception_State_LowHP = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:8e1adbc0-33e3-6d93-926d-698e2508695d
msgctxt "h4eead200g700eg45dagb4c2g6b5db4937962"
msgid ""
"Not so well. But well enough to wait. Join the line, and you will be seen."
msgstr "상태가 안 좋아 보이지만, 충분히 기다리실 수 있을 거 같네요. 줄 서서 기다리시면 선생님이 봐드릴 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 8ff4a6cb-f80f-409f-9ad5-b557876b1a06
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:8ff4a6cb-f80f-409f-9ad5-b557876b1a06
msgctxt "h69aa04b4gc020g4e14g8681g8540711b550f"
msgid "I am no patient - I've been hired as a spiritual advisor."
msgstr "난 환자가 아니야. 영적 자문가로 고용되었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = 920ccec0-e602-b6be-4421-55a2c718f161
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:920ccec0-e602-b6be-4421-55a2c718f161
msgctxt "h36b06a5eg43efg465cg821fgaae391f0e096"
msgid "Let me examine your skull."
msgstr "당신의 머리를 검사해볼게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = 9ff48b81-3ff4-a8ba-1205-2edd1281a671
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:9ff48b81-3ff4-a8ba-1205-2edd1281a671
msgctxt "hf7efff89ga240g4c8cg872fgadd3fa8d6dfa"
msgid "What in the Hells can you see?"
msgstr "뭐가 보이는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = a363b9c1-700a-3635-982a-f147ce8b3d05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:a363b9c1-700a-3635-982a-f147ce8b3d05
msgctxt "h7d0ee329g5cf1g4d55gb40cg51840f3289a8"
msgid "Everything. I lose control of myself, and kill without command."
msgstr "전부 다. 통제력을 잃고, 마음대로 살인을 저질러."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = a5e3e897-f990-1bef-a2c1-6f3cf02cb642
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:a5e3e897-f990-1bef-a2c1-6f3cf02cb642
msgctxt "h0c98358bgac42g430cgb802g612b24134172"
msgid "The Surgeon will be <i>most interested </i>in you."
msgstr "외과의 선생님이 당신을 <i>가장 흥미로워할</i> 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = a75ea482-d6d2-9d6b-e531-c01e5e482a3c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_InLine = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:a75ea482-d6d2-9d6b-e531-c01e5e482a3c
msgctxt "ha740a796ga9afg4878gb642g798a8beb2bc0"
msgid "Be patient, be well."
msgstr "조금만 참아요, 곧 돌아올게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = a7d9df91-6d41-2f03-6042-aa5e362700dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:a7d9df91-6d41-2f03-6042-aa5e362700dd
msgctxt "h965a0d0egeeceg4ddag9580g4773006d6195"
msgid "As pale as a ghost. You must see the doctor <i>immediately</i>."
msgstr "유령처럼 창백하군요. 당장 의사 선생님을 <i>만나봐야</i> 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = a95a8636-bb41-592b-5554-3b0a2bbc9a2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_Reception_State_InLine = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:a95a8636-bb41-592b-5554-3b0a2bbc9a2b
msgctxt "h101fca4eg9416g4101gbc3cge0ba37a8f68a"
msgid "Fine fine. I'll get in line."
msgstr "알겠어요 알겠어. 줄 설게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = ade16ef4-63b5-b12a-5327-a2bc912869ea
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:ade16ef4-63b5-b12a-5327-a2bc912869ea
msgctxt "h269c3d58gd421g4ef1ga8d7ge0c5f5681dc4"
msgid ""
"Wait! My wounds may not be visible on the outside, but I still need help."
msgstr "잠깐! 내 상처는 겉으로 잘 보이지 않지만, 아직 도움이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = b341b2e9-6ab7-a10a-3a58-104ec28a52b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:b341b2e9-6ab7-a10a-3a58-104ec28a52b0
msgctxt "had70009cg3b38g4a8fg9f78gc7f19e0a8bf8"
msgid ""
"There is no shame in an end. All things come to be lost. But if you wish to "
"be examined..."
msgstr "끝나는 건 부끄러운 것이 아니에요. 모든 것은 사라지니까요. 하지만 검사를 받고 싶으시다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = b78a785c-9208-ce71-8508-bf469c580af6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_Reception_State_LowHP = True
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:b78a785c-9208-ce71-8508-bf469c580af6
msgctxt "h371b9a97gb1a0g43a4g8eb9g0cd5dbf74de0"
msgid "Poorly, quite poorly indeed..."
msgstr "불쌍해요, 너무 불쌍해요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = b84c14d0-9bfd-3008-501a-3843f355a4e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_Reception_State_InLine = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:b84c14d0-9bfd-3008-501a-3843f355a4e2
msgctxt "h6a551da0g7b33g44f0g97e2g06faf8a840ae"
msgid "Fine, fine. I'll get back in line."
msgstr "알겠어, 알겠어. 줄 다시 설게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = bb4caae6-f92e-6ed5-dcab-ba7b3960e40a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_Reception_Receptionist_HasMet(1) = True
#.   Global:
#.      - TWN_Hospital_Reception_State_InLine = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:bb4caae6-f92e-6ed5-dcab-ba7b3960e40a
msgctxt "h38498e02g1ea9g49a4gb228ge400863e2962"
msgid "You're not sick, not sick at all. Wait in line."
msgstr "당신은 아프지 않아요, 전혀 아프지 않아요. 줄을 서세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = becc4a5b-5938-ee42-e07c-61f990726e0d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:becc4a5b-5938-ee42-e07c-61f990726e0d
msgctxt "he53f4d84g54c7g4293g9eadg534c638c35a0"
msgid ""
"You can let me in or I can burn, electrify, or freeze this place - maybe "
"even all three. Your choice."
msgstr "들여보내 주지 않으면 불태워 버리거나, 감전시키거나, 얼리거나, 셋 중 하나일 거야. 셋 다일 수도 있고. 네 선택이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = d07daba1-10b2-5ee4-2c4f-7d6673a97318
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:d07daba1-10b2-5ee4-2c4f-7d6673a97318
msgctxt "h5e5a3206g8ef4g4948g94d8g4812f5831277"
msgid ""
"Too many thoughts - a thrice-cursed ailment. The emptiness you yearn for "
"will be yours again."
msgstr "생각이 너무 많네요. 세 번씩이나 저주 받은 질병입니다. 당신이 갈망하는 공허함이 다시 당신의 것이 될 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = d6131a56-6cc9-6140-0389-211ee61efe5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:d6131a56-6cc9-6140-0389-211ee61efe5f
msgctxt "h3c8b27fag0e83g44aegb132ga118e1b1a1e8"
msgid "I'm sick as a dog - dark compulsions addle my mind."
msgstr "난 몹시 아파 - 어두운 강박에 시달리고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = d9135d04-d8f4-3857-3af2-f4ecc2ef0e51
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#.      - WIZARD(1) = False
#.      - MONK(1) = False
#. TagRule: ROGUE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:d9135d04-d8f4-3857-3af2-f4ecc2ef0e51
msgctxt "h4d53d5a3g470fg4deegbbb9gd874856b327e"
msgid ""
"I'm no patient, your surgeon heard I have the steadiest hand this side of "
"Faerûn."
msgstr "난 환자가 아니야, 당신네 의사가 내가 페이룬의 이쪽 끝에서 보기 드문 실력을 갖추고 있다 했을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = d9135d04-d8f4-3857-3af2-f4ecc2ef0e51
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#.      - WIZARD(1) = False
#.      - MONK(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:d9135d04-d8f4-3857-3af2-f4ecc2ef0e51
msgctxt "h7a23d8f1g4c57g416fg9eacga5d048a1c33b"
msgid "I'm not a patient - I'm the doctor's new assistant."
msgstr "난 환자가 아니야. 난 새로 온 조수야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = dd0d28c7-9108-f999-0ff8-0dd23cf6da11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:dd0d28c7-9108-f999-0ff8-0dd23cf6da11
msgctxt "hd057fe66ge9eeg4cd5gb1bcga34ad00bf608"
msgid "Pestilence! Pestilence and sin!"
msgstr "역병! 역병과 죄악이여!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = e5344322-47a2-4eb6-900e-5b9cc8cef875
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_Reception_Receptionist_HasMet(1) = True
#.      - TWN_Hospital_Reception_Receptionist_FailedPersuasion(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:e5344322-47a2-4eb6-900e-5b9cc8cef875
msgctxt "h2c5d1b12g33f7g445ag9ccbge0d432b24e02"
msgid "No worse, no better, no need to be here."
msgstr "더 나빠지지 않았고, 더 좋아지지도 않았어요, 여기 있을 필요도 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = e85aea40-39bd-6e3d-3bad-d90e5f938f9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_Reception_Receptionist_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_Hospital_Reception_Receptionist_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:e85aea40-39bd-6e3d-3bad-d90e5f938f9b
msgctxt "hbe0fa152gf40bg4339g9ba4g7495cfcbcd70"
msgid ""
"Here to see the doctor? Are we poorly? Are we <i>desperately </i>poorly?"
msgstr "의사를 보러 오셨나요? 어딘가 아프세요? <i>아주 심하게</i> 안 좋은가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = e8d694d3-4d1e-b8da-86c9-08d5c2024917
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:e8d694d3-4d1e-b8da-86c9-08d5c2024917
msgctxt "h837651e4g5bc5g4de7gb427g81b2a650c67b"
msgid "An answer to our prayers!"
msgstr "우리 기도에 대한 응답이군요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = ebf14a53-9c9d-e244-31fd-2c2aae2e373b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:ebf14a53-9c9d-e244-31fd-2c2aae2e373b
msgctxt "h5c6e0d23g78a4g4948g8685g3e79da1a3839"
msgid "A most impatient patient... Very well. Still your cries, restless soul."
msgstr "가장 성질 급한 환자시군요... 알겠어요. 울지 말아요, 휴식하지 못하는 영혼이여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Narrator
#. NodeID = ee72ca7f-271a-abd8-a210-ba09f7c8c215
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:ee72ca7f-271a-abd8-a210-ba09f7c8c215
msgctxt "h117344a1g5285g4177ga143g46e533949633"
msgid "*There's a hint of recognition in her eyes as she studies you.*"
msgstr "*당신을 바라보는 그녀의 눈이 무언가를 인지한 듯 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Sister Sinda
#. NodeID = f3e9cc97-8977-91c0-ebee-9b9ebfaf5764
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Reception_State_GainedAcess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:f3e9cc97-8977-91c0-ebee-9b9ebfaf5764
msgctxt "ha1db7b47g5ae1g4acaga3a0gf0210ff0edea"
msgid ""
"A unique disease - one which has never passed through this institution "
"before."
msgstr "독특한 질병이에요 - 이 기관에서 다뤄진 적이 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = f4919e09-5134-03c4-5262-41cc477869de
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:f4919e09-5134-03c4-5262-41cc477869de
msgctxt "he4fb2ca7g656dg48d7gb46fg99efaf3bf14d"
msgid ""
"I am no patient - I've just been hired as an expert in maladaptive "
"necromantic malaise."
msgstr "난 환자가 아니야. 나는 부적응적인 괴저불안증 환자 전문의로 고용되었을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = f8c62338-e0e3-8a26-2b52-92ddcdaa4920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:f8c62338-e0e3-8a26-2b52-92ddcdaa4920
msgctxt "h63d0e778gf222g4cfcgb391g2c5b36a93119"
msgid "When I try to sleep I am plagued by distressing sights."
msgstr "잠이 들려고 하면 고통스러운 광경이 눈앞에 아른거려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = fd672591-91c0-91d6-33dc-cd6db1d24c7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:fd672591-91c0-91d6-33dc-cd6db1d24c7c
msgctxt "h2d64a905g92f6g4bf1ga31dgd385964e599e"
msgid "I don't have time to wait - I need to see the doctor right now."
msgstr "기다릴 시간 없어, 지금 당장 의사를 만나야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist
#. Speaker = Player
#. NodeID = fdf078af-518c-bcc3-7166-b4a76d162c47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_Reception_State_InLine = False
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_Receptionist:fdf078af-518c-bcc3-7166-b4a76d162c47
msgctxt "he5d5d520g8963g4cbbgb572g1c028e606092"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 01a398d0-fb3b-178a-842d-093a54ddc191
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:01a398d0-fb3b-178a-842d-093a54ddc191
msgctxt "h9f85adc5g5087g4ccfg84efg34e75d1197b0"
msgid "Yes... For are we not all in need of a cure?"
msgstr "그렇군... 우리 모두 치료를 받아야 하니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 058e0923-c9f4-3b03-f772-5b75ae39e650
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:058e0923-c9f4-3b03-f772-5b75ae39e650
msgctxt "h0aab8262g9cfcg44c7ga314g66160b1d8c84"
msgid "Your diligence is exemplary. Very well: your own scalpel you will be."
msgstr "타의 모범이 되는 근면함이군. 좋네. 스스로 수술 칼이 되도록 하게나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 0688781e-7f23-983d-0b98-edf224574db7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:0688781e-7f23-983d-0b98-edf224574db7
msgctxt "h8a159accg187fg4d98gab36g7055cfe69942"
msgid "You teach Shar's ways with grace, for such an... altered being."
msgstr "저렇게...변한 존재에게 샤의 은총을 논하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 07025782-1013-160e-f318-86a0ebf95029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:07025782-1013-160e-f318-86a0ebf95029
msgctxt "ha208ca76g911cg409cg933fgf6aac7a33f67"
msgid "Just kill them already - all this torture is pointless."
msgstr "그냥 빨리 죽여. 이런 고문은 의미 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 0c05bd79-6427-34aa-aede-89aa701f579c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:0c05bd79-6427-34aa-aede-89aa701f579c
msgctxt "h82126d7cg9fa2g4492g81b2g0809319a0a7a"
msgid ""
"There is misdirection in your words. You seek to linger in your sickness."
msgstr "말에 속임수가 있군. 자네는 병에서 벗어나려는 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 0c1dfcf5-85aa-ac61-2d54-b7de587154f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ac9c3420-a495-34da-8db7-367091a13044_PassedReligion = True
#. SetFlags:
#.   Object:
#.     - TWN_Hospital_State_QuotedShar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:0c1dfcf5-85aa-ac61-2d54-b7de587154f1
msgctxt "h700047dag0490g45c8ga7f7g692fb81dcad0"
msgid ""
"Your subject is tainted. Shar's succour must only be granted to the willing."
msgstr "그 실습 환자는 오염됐어. 샤의 구원은 원하는 자에게만 내려야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 0cb12b34-7433-ace6-9a8c-7501e05861fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:0cb12b34-7433-ace6-9a8c-7501e05861fd
msgctxt "hfb29c5b4g4c43g4d9aga737g8f4bfed71aed"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 104ec543-4b7b-ff5f-81ae-514698e4b23a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:104ec543-4b7b-ff5f-81ae-514698e4b23a
msgctxt "hbcf3bb2dg6a7bg4330g886ag7bd811640cf4"
msgid "In my experience, torture is usually more pain and less proselytising."
msgstr "내 경험상 고문은 고통만 심하고, 전도에는 별로인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 10c7d94a-5740-602b-ea31-7d9ce1de8e1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:10c7d94a-5740-602b-ea31-7d9ce1de8e1b
msgctxt "h22a0d848g177ag4af5gba6eg4102e8669306"
msgid "The crux of our worship."
msgstr "교리의 핵심을 알려주고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 12a1e16e-20af-286c-cef0-d3fa6c5a9d62
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:12a1e16e-20af-286c-cef0-d3fa6c5a9d62
msgctxt "he7b3ed8eg3cbag470fg8d24g94509160d212"
msgid "The goddess has greater plans for me than to submit to your scalpels."
msgstr "여신님께서는 나를 수술 실습용 환자가 아니라 더 원대한 계획에 쓰려고 하셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 144fbf9c-c757-2d6a-e2b6-f57b88685658
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:144fbf9c-c757-2d6a-e2b6-f57b88685658
msgctxt "hc9223095g1dceg4ec6gac80g1c3f75404935"
msgid ""
"You do me an honour, but I am not worthy. Show me the way of Shar - I beg of "
"you."
msgstr "영광이긴 한데, 난 자격이 없어. 부탁이니 샤님의 가르침을 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 14fc11ef-ac4d-09fe-82e9-a3750fabfe6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:14fc11ef-ac4d-09fe-82e9-a3750fabfe6a
msgctxt "h4c4b1b5cg5deeg49d7g8de8g6b3b957dd51e"
msgid "You will stop this sick spectacle at once."
msgstr "이런 끔찍한 짓은 당장 그만둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 16e6dfed-f028-493c-44ab-ced7184dbc3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:16e6dfed-f028-493c-44ab-ced7184dbc3f
msgctxt "hd2f79c0cg1408g4ffag8f6fg068a03faaf58"
msgid ""
"If light is the symptom, then darkness is the cure, for in light there is "
"presence, but in darkness there is absence."
msgstr "빛이 증상이라면, 어둠은 치료제지. 빛 속에는 존재가 있지만, 어둠 속에는 부재가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 197e7c61-cdbd-4559-1a79-1f65dca9d165
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:197e7c61-cdbd-4559-1a79-1f65dca9d165
msgctxt "h199be2bcg2233g40cag916eg1cfb6a39dd11"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 1d35e319-60d0-0360-1c4f-a740d99fc2ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:1d35e319-60d0-0360-1c4f-a740d99fc2ab
msgctxt "h99cace49ge0ccg4094g9b9agd19ef1a062d6"
msgid ""
"I rather think <i>your</i> sacrifice will be quite masterful enough for our "
"purposes."
msgstr "우리의 학습 목적은 <i>자네</i>의 희생으로도 충분히 달성할 것 같네만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 213c1824-0017-dfea-13d2-4406ae7fd7de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:213c1824-0017-dfea-13d2-4406ae7fd7de
msgctxt "h79c06d30gb29fg4a84gb915gfb43bbe5e87b"
msgid "Perhaps it is our unexpected audience that makes you quiver."
msgstr "예정에 없던 참관인 때문에 자네 손이 떨렸나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 21f8e15a-3c83-2c3f-d4ba-07797db39be7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:21f8e15a-3c83-2c3f-d4ba-07797db39be7
msgctxt "ha1c2e2e0ge572g4988g8f07g4dc380ea48cc"
msgid ""
"'Only with sacrifice is mastery gained.' For the sisters to learn, you must "
"submit."
msgstr "'희생이 있어야만 통달할 수 있다.' 본인을 바쳐서 간호사들이 배우게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Narrator
#. NodeID = 22331524-1e09-0a1c-2f6a-14bbdf6bb5e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:22331524-1e09-0a1c-2f6a-14bbdf6bb5e0
msgctxt "h2407f47cga02fg47c1g8702gd4612b5ffc19"
msgid ""
"*Although you're well acquainted with most blades - implements of medicine "
"aren't really your speciality.*"
msgstr "*칼에 대해서라면 많이 알아도, 약물 처방은 당신의 전문이 아닙니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 227d44db-09df-0afb-f0dd-fe355d73ce02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:227d44db-09df-0afb-f0dd-fe355d73ce02
msgctxt "h6f4d76ebgcb78g4c6dg8241g28bc2bfe03e9"
msgid ""
"You are to be commended for their graduation - rewarded with the promised "
"cure."
msgstr "우리 자매들이 졸업할 수 있게 해주었으니 약속했던 치료로 보답하겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 249397e2-208c-6b5c-9e71-1a9d1ae2e45f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:249397e2-208c-6b5c-9e71-1a9d1ae2e45f
msgctxt "h3ec3e6c6g79a7g4b22g999eg581afff73902"
msgid "Then I dub thee master."
msgstr "그러면 자네를 스승으로 삼도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 2538f0de-a32f-0bd4-ad67-b0a3947da6d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:2538f0de-a32f-0bd4-ad67-b0a3947da6d1
msgctxt "h0f6cab11g5c5ag4947g86deg2a991cf2ee24"
msgid ""
"See? What is the light of eyes but the cancer that causes one to witness the "
"laceration of being?"
msgstr "알겠나? 존재가 찢겨나가는 걸 보게 만드는 빛은 암일 뿐이라는 걸?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 25f0cea8-a7a8-48d4-7c54-ddad4c4f6d04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:25f0cea8-a7a8-48d4-7c54-ddad4c4f6d04
msgctxt "haf6f3a34ge82ag4fa5ga9ccg442493b9ea8b"
msgid "Observe - then succeed me, into the succour of Shar."
msgstr "잘 보고 나를 따라 샤님의 구원으로 오시게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 29f06776-8f34-f1d4-6025-6b69a31d08c7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:29f06776-8f34-f1d4-6025-6b69a31d08c7
msgctxt "h273c2d0bge939g4111gb79dge4e5d6d5799a"
msgid "<i>Cast your gaze over the blades of the sisters.</i>"
msgstr "<i>간호사가 쥔 칼로 시선을 돌린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 2a052c72-e173-898c-cf61-6f256b433b83
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:2a052c72-e173-898c-cf61-6f256b433b83
msgctxt "h555025cfg7496g4f14g8320g90bbf1239416"
msgid "Why not have them hone their skills on each other?"
msgstr "서로에게 기술을 실습하게 하는 건 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 2dc08ad2-da70-0140-36b0-ec4bdbd1cd4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:2dc08ad2-da70-0140-36b0-ec4bdbd1cd4e
msgctxt "hbb92a2bcg9c1ag4e83g8289g06d019761c1e"
msgid "What lesson are you teaching these sisters?"
msgstr "이 수녀들에게 뭘 가르치는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 2e8c73ab-bd2d-7ee6-f1c9-6e8bcb5a353c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:2e8c73ab-bd2d-7ee6-f1c9-6e8bcb5a353c
msgctxt "h7e8c4932g6ec9g420egac8bg36ffffff0f53"
msgid "Loss."
msgstr "상실."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 302235c2-35fa-958b-aebc-fcca9e13142f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(CLERIC_SHAR and PALADIN_SHAR and REALLY_SHADOWHEART)
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:302235c2-35fa-958b-aebc-fcca9e13142f
msgctxt "hc5258d7dgd31ag4556gb9b8g2aedf5ce4788"
msgid ""
"But you: look how the succour of Shar eludes you. See how painfully present "
"you remain..."
msgstr "헌데... 자네에게는 샤님의 구원이 닿지 않는군. 지금 고통 속에 두고 계시는 걸 보니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 341d8e9d-901e-df00-02d5-7e72f78dfbef
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = False
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:341d8e9d-901e-df00-02d5-7e72f78dfbef
msgctxt "ha9a884efg790dg4499g92edge67271330ad8"
msgid ""
"I take joy in performing with a master of my craft - I'm sure the sisters "
"are the same. Why don't <i>you </i>volunteer?"
msgstr "난 연주 분야의 대가와 합주하면 기분이 좋더라고. 간호사들도 똑같겠지. <i>직접</i> 희생하지 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Sister Hunna
#. NodeID = 34bcdd88-0db5-4c6c-ce9d-d9bbf88156a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:34bcdd88-0db5-4c6c-ce9d-d9bbf88156a5
msgctxt "h7a0d49a8g13a3g4ac4g8004g8358e515b7dd"
msgid "In light is presence; in darkness, absence."
msgstr "빛 속에는 존재하고, 어둠에는 부재하니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 354b6087-d812-c218-ddfd-a022553d8154
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:354b6087-d812-c218-ddfd-a022553d8154
msgctxt "h949257aegd6e2g4b73gaa54ge531545770e6"
msgid "And the rough vessels that are yours."
msgstr "자네의 거친 손도 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 36e55bd9-41e2-f45c-fa7c-0fd26245e3c7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR or REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:36e55bd9-41e2-f45c-fa7c-0fd26245e3c7
msgctxt "he23e7964g1714g4d15gb5fdg4a7c05a413dc"
msgid ""
"But you: look how the succour of Shar eludes even you, one who walks "
"faithfully in her shadow. See how painfully present you remain..."
msgstr "헌데... 샤님의 그림자를 충성스럽게 따르는 자네에게도 샤님의 구원이 닿지 않는군. 지금 고통 속에 두고 계시는 걸 보니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 381fc069-99c6-2917-09c6-86b71ff98635
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. TagRule: SORCERER or WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:381fc069-99c6-2917-09c6-86b71ff98635
msgctxt "h8e833322g960cg4f77g8b8dg99106f7d5d86"
msgid ""
"My magic has blinded me - I see now that Shar is the only path. Show me how -"
" I beg of you."
msgstr "마법에 눈이 멀었었나 봐. 이제야 샤님이 유일한 길이라는 걸 깨달았어. 부탁이니 방법을 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 3a0db0d4-26a2-71d4-c0f9-6b2fb33ab84d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:3a0db0d4-26a2-71d4-c0f9-6b2fb33ab84d
msgctxt "h256058c7geadeg4a78gad85gbb091cf1e04f"
msgid "A student, yes. Do please enlighten me."
msgstr "네, 학생이에요. 부디 깨우쳐 주시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 3b90318e-03ab-dec2-647e-3a29f5b3c439
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ONEEYED(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:3b90318e-03ab-dec2-647e-3a29f5b3c439
msgctxt "h62cadd01g1822g402bg8f05g3403445ae306"
msgid ""
"You are well on your way. But one white orb disfigures you still. Let us "
"finish the cure."
msgstr "가르침을 잘 따르고 있네만, 아직 흰 공 하나가 남아서 보기 안 좋군. 치료를 마저 끝내주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Narrator
#. NodeID = 3f878029-2716-3f9c-cec9-562c931e7f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:3f878029-2716-3f9c-cec9-562c931e7f59
msgctxt "h1af46577gfd77g4724g9e92g3c6caf6193d1"
msgid "*Try as you might, you can't think of any relevant teachings.*"
msgstr "*노력해봤지만, 관련 있는 가르침이 떠오르지 않는군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 40ab79ae-da40-b59e-8e4d-493aaa2fd5a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:40ab79ae-da40-b59e-8e4d-493aaa2fd5a9
msgctxt "hc3245ca5g2113g472dg8e79g6cf6606639dc"
msgid "It is the scalpel-led journey that leads from pain to peace."
msgstr "고통에서 평화로 수술 칼을 따라가는 여정인 게지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Narrator
#. NodeID = 41dd44aa-f904-463d-696b-445853042485
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ac9c3420-a495-34da-8db7-367091a13044_PassedInvestigation = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:41dd44aa-f904-463d-696b-445853042485
msgctxt "hfafc42e0ge244g4607gbfcag685bfd27ae63"
msgid ""
"*The sisters' blades are bloodied and dull. Only the most measured hand "
"could make a clean incision.*"
msgstr "*간호사의 칼은 피가 묻었고 무딥니다. 최고로 정확하게 움직여야만 깔끔하게 절개할 수 있겠네요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 472240f4-522d-741d-1581-8faf20e635dc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_Event_MakeNursesKillEachOther = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:472240f4-522d-741d-1581-8faf20e635dc
#, fuzzy
msgctxt "hc65543ffg1e98g4bc6g8874gcc59f9f93db6"
msgid "Absence, sisters. Acquaint yourselves."
msgstr "자매들이여, 부재에 스스로를 맡기시게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 48e07330-4f2c-6efc-de09-26fd33b2f174
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = False
#.   Tag:
#.      - WIZARD(1) = False
#.      - BARD(1) = False
#.      - MONK(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:48e07330-4f2c-6efc-de09-26fd33b2f174
msgctxt "hd884e11dg3050g4388g8757gfd0f0f2114cf"
msgid ""
"They need a better subject to practise on first. Not a student, but a master."
msgstr "더 좋은 환자를 대상으로 실습해야지. 학생 말고 스승 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 4c054b38-524c-8660-9b0d-d5277cff6582
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:4c054b38-524c-8660-9b0d-d5277cff6582
msgctxt "hf0cd0791g055cg4282ga628g04db23622a02"
msgid ""
"I am but a fumbling squire before a master swordsman. Please, demonstrate so "
"that I might learn."
msgstr "난 검의 대가가 아니라 어설픈 견습일 뿐이야. 좀 배우게 시범을 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Sister Hunna
#. NodeID = 4e88433b-9e1b-f518-25be-ebedd0b7bbc8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:4e88433b-9e1b-f518-25be-ebedd0b7bbc8
msgctxt "hb31e087fgbf66g4e32ga40bgbcbd1fc08af4"
msgid ""
"The scalpel soothes. Come sing its song. We would hear your melody of mercy."
msgstr "수술 칼은 고통을 잠재웁니다. 어서 노래를 불러주세요. 위안을 얻은 그 목소리를 듣고 싶어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Karlach
#. NodeID = 4fa30250-372c-4e14-b331-260e636179e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_KARLACH(9) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:4fa30250-372c-4e14-b331-260e636179e9
msgctxt "h0a8aed8egc88ag4c05gbef0g8e630d8f70d8"
msgid "What the fuck is this loon talking about."
msgstr "이 정신병자가 무슨 개소리를 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 4fa65c38-b9d1-0a15-7b26-57d2e98b19b9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:4fa65c38-b9d1-0a15-7b26-57d2e98b19b9
msgctxt "haa1cc0f5g70b0g43cegb05fgc55ca430edb4"
msgid "Sparring is vital to progress. Have them practice on each other."
msgstr "발전하려면 겨루기가 중요하지. 서로의 몸에 연습하게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 4fda4fa8-531c-5b11-6297-c13d92e3f0c5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:4fda4fa8-531c-5b11-6297-c13d92e3f0c5
msgctxt "hcbab384cg6cbdg408cgbc9ag665ed0c5ca4a"
msgid "The sisters aren't ready. They'll make me sick instead of curing me."
msgstr "간호사들이 아직 미숙해서 치료가 아니라 병을 줄 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 5340aca1-d9be-ef59-c539-6b70ea4c943d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = False
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:5340aca1-d9be-ef59-c539-6b70ea4c943d
msgctxt "hd40a0ab5g6f71g458agb7f9gbf37c4a1444f"
msgid ""
"There is no greater joy than watching a master at work. You are their "
"teacher - who better to volunteer?"
msgstr "스승이 일하는 걸 보는 것만큼 좋은 일은 없지. 당신이 선생이니 이만한 적임자가 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 535b2fa8-45a8-2e1b-4891-5aca428135e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:535b2fa8-45a8-2e1b-4891-5aca428135e7
msgctxt "h6684d9f6g0859g4823g84e3g6b823b8a0d86"
msgid "How to steady their hands, I wonder."
msgstr "저 손 떨림을 어떻게 잡아야 할지 의문이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 53f84b60-e88f-4024-fbc4-cca401b9837c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:53f84b60-e88f-4024-fbc4-cca401b9837c
msgctxt "hc6c304cagcd02g48b7gbde9g4b8e7ba17538"
msgid "The final lesson. Yes. For to teach absence, one must become absent."
msgstr "마지막 수업이라. 그래. 부재를 가르치려면 누군가 사라져야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Lae'zel
#. NodeID = 57a11188-aeee-483d-b45a-e3b785638766
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_LAEZEL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:57a11188-aeee-483d-b45a-e3b785638766
msgctxt "hed210cbag6bf6g4f23g9fc8g5d737674dbe0"
msgid ""
"Only a beast of a man toys with his victim. Entertaining, if not efficient."
msgstr "짐승같은 놈이나 희생자를 갖고 놀잖아. 효율적이진 않지만 재미는 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 59074213-60f9-07bd-a21c-4155074b3c53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:59074213-60f9-07bd-a21c-4155074b3c53
msgctxt "h6f623387gc635g43acgb8a5g62757d3695c7"
msgid ""
"And yet, these sisters must exercise their gifts, for the art of absence "
"lies in its execution."
msgstr "하지만 여기 간호사분들에겐 훈련 과정이 필요합니다. 수술을 통해서 부재의 기술을 연마할 수 있으니 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 5a3b15c3-5530-f40f-0122-f11f4289f343
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:5a3b15c3-5530-f40f-0122-f11f4289f343
msgctxt "hcf1abc2fg37a5g42f8gb46egd14b3ba7f449"
msgid ""
"See how the patient reacts when I but stroke the right nerve. Hear its "
"comfort. Hear the very melody of mercy."
msgstr "올바른 신경만 잘랐을 때 환자의 반응이 보이나? 이 편안해진 소리를 들어보게. 이게 바로 자비의 멜로디지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 5adba34c-2466-b148-70ef-17d1058efae9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:5adba34c-2466-b148-70ef-17d1058efae9
msgctxt "h0a2cfa53g146ag4860g87aegabe4f7435fb6"
msgid ""
"I sought purpose in the natural world - I see now that Shar is the only "
"path. Show me how - I beg of you."
msgstr "난 자연에서 목적을 추구했지만, 이제 샤님을 따르는 게 유일한 길이라는 걸 깨달았어. 부탁이니 방법을 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 5dde890a-c45f-7ac4-d3a6-5bd6b70f05d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:5dde890a-c45f-7ac4-d3a6-5bd6b70f05d8
msgctxt "hb3e5ebbdgbdc2g4140g9883g2db0fed37e46"
msgid ""
"How your sickness misdirects you! Blinded by luminous eyes. What say you to "
"this, dear sisters?"
msgstr "그대의 병이 얼마나 그대를 잘못 인도하고 있는지! 빛나는 눈에 멀어 버렸구나. 사랑하는 자매들이여, 어찌 생각하는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Narrator
#. NodeID = 60037c4b-c3fb-cb30-21fd-11c69f18a912
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ac9c3420-a495-34da-8db7-367091a13044_PassedInvestigation = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:60037c4b-c3fb-cb30-21fd-11c69f18a912
msgctxt "h83962b6dg03f0g4872gb69ega857b88df4b3"
msgid ""
"*The sisters' blades are unkempt, rusted with blood. Even in your skilled "
"hands, a clean cut would be difficult.*"
msgstr "*간호사의 칼은 더럽고, 피로 얼룩졌습니다. 당신의 숙련된 솜씨로도 깔끔하게 자르는 건 어렵겠어요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 6229dffa-3419-1bd5-7934-2a8e33bfdd27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - WIZARD(1) = False
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:6229dffa-3419-1bd5-7934-2a8e33bfdd27
msgctxt "h2d109464gbcfcg4c4bgb57dgb4f76fe26f39"
msgid "What wrong has this man done to deserve such torture?"
msgstr "이 남자가 뭘 잘못했길래 이런 고문을 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 6449aa35-4eaf-5904-e2d1-f27d544f9fed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:6449aa35-4eaf-5904-e2d1-f27d544f9fed
msgctxt "h6c8b9a02gea29g4811g8131g4d2655eac9a0"
msgid "I don't wish to study, only to lift the curse on this land."
msgstr "공부하고 싶지는 않고, 이 땅의 저주나 풀고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 66d48e27-92a4-f045-397b-e26abf5f0c42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:66d48e27-92a4-f045-397b-e26abf5f0c42
msgctxt "he9ba2fd1gd9b4g4f2agb5c6g867836dcfc42"
msgid "Sick. Quite. But on the cusp of a cure:"
msgstr "그래. 끔찍하지만, 치료의 전환점이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Sister Hunna
#. NodeID = 68f50ee7-637e-ffa2-ee5c-04c22cc9cbd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:68f50ee7-637e-ffa2-ee5c-04c22cc9cbd7
msgctxt "h10d3b9b6gd202g4492g8c9bg3d146e90de99"
msgid "Absence."
msgstr "부재."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 6a09f1c2-77c6-6e8a-d93b-fa3ee0ea3a7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:6a09f1c2-77c6-6e8a-d93b-fa3ee0ea3a7a
msgctxt "h72a1ba65gf2a3g413eg8426g0f264a20d883"
msgid "And how gracious of you, master, to tender your own flesh."
msgstr "스스로의 살을 내준다니 이 얼마나 고귀한 스승의 자세인가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 716e7faa-d816-d43c-0e29-253c89e98bad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:716e7faa-d816-d43c-0e29-253c89e98bad
msgctxt "hafd4ec4fgc149g4b30g9d0fg756ff9621524"
msgid "Come, sisters. Soothe me."
msgstr "자, 자매들이여. 내 고통을 덜어 줘라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 7800f5f9-7d95-df98-c2fb-981a2c2cd823
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:7800f5f9-7d95-df98-c2fb-981a2c2cd823
msgctxt "hfbc42cf0g3bceg4f7dgb9e1g1f12a40de0e4"
msgid "Sisters, what say we to such wretches?"
msgstr "자매들이여, 이 고통받는 자를 어째야겠는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 794839ed-d794-54ce-ee3f-029352755eff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:794839ed-d794-54ce-ee3f-029352755eff
msgctxt "hf1fa7ef7gb91ag4e6bgb37cg02d62a34ae7e"
msgid "I suffer from boredom. The cure is ripping you apart."
msgstr "지겨워 죽는 병에 걸렸네. 널 찢어서 치료해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Wyll
#. NodeID = 7a297866-e855-41d6-af3b-76138e788ce9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.   Tag:
#.      - REALLY_WYLL(11) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:7a297866-e855-41d6-af3b-76138e788ce9
msgctxt "h484a0c4dg7af6g4bb4g88cbg521e18f0e721"
msgid "Hells. Only a monster would inflict misery and call it medicine."
msgstr "세상에. 고통을 주면서 약이라고 하는 놈은 그냥 괴물이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 7c50e81b-42f3-6911-670e-741982db7747
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:7c50e81b-42f3-6911-670e-741982db7747
msgctxt "h6d9e3cd9g34afg4a96g9e4egea0c2f434e6f"
msgid ""
"Hmmm. 'Only the willing may know the Lady's embrace.' You know her teachings "
"well."
msgstr "흠.... '자발적인 사람만이 여신의 은총을 알게 되리라.' 그 가르침을 잘 알고 계시는군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 803ce6c2-f3e1-2461-0982-79a8547f8992
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = False
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:803ce6c2-f3e1-2461-0982-79a8547f8992
msgctxt "h6c470321g714ag4f63g8b1fg3c22fd389f2c"
msgid ""
"When the fist trembles, sometimes another is needed to steady it. A good "
"master would volunteer themselves."
msgstr "떨리는 주먹을 진정시키려고 다른 손으로 잡을 때도 있지. 좋은 스승은 스스로 모범을 보이고 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 825bcee8-f2a4-b574-ce20-d219dbe16f07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:825bcee8-f2a4-b574-ce20-d219dbe16f07
msgctxt "ha1deacc5g96ecg49c6g84adgdc5ca0f4ff01"
msgid ""
"You are the cause of the only suffering here - I am duty-bound to end you."
msgstr "여기서 고통을 유발하는 건 너 뿐이니 널 끝장내는 게 의무겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Shadowheart
#. NodeID = 82766f3b-5144-4689-8fb4-968ea093dc11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:82766f3b-5144-4689-8fb4-968ea093dc11
msgctxt "hf52c1a01g3748g4bf8g900ega112f6cc399f"
msgid "A stinging truth - but a truth nonetheless."
msgstr "뼈아픈 말이지만 진실이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 862e5662-829c-4cf7-a3ae-745dd0f6e868
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:862e5662-829c-4cf7-a3ae-745dd0f6e868
msgctxt "h1ed5e8d8g3123g4737gb598gc4f52a8337f4"
msgid "Darkness."
msgstr "어둠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 8cc5c679-6671-a74e-0c4a-0d3f649f0b96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:8cc5c679-6671-a74e-0c4a-0d3f649f0b96
msgctxt "h0e780babgdb33g4b4fgab9dg9a547a2cf098"
msgid "Sisters. Speak the truth that I have taught you."
msgstr "간호사 여러분. 저에게서 배운 진실을 얘기해주시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 8f0d8d6a-3405-b1bd-0e4f-dd9e205ae693
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SHAR(1) = False
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:8f0d8d6a-3405-b1bd-0e4f-dd9e205ae693
msgctxt "hcf1da589g0729g4368g8dedgd19810f7678f"
msgid "<i>Recall what you know of Shar's blasphemous teachings.</i>"
msgstr "<i>불경한 샤의 가르침을 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 91d9f2a9-bddf-a538-6e45-47bf8c12d868
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#.      - SORCERER(1) = False
#.      - FIGHTER(1) = False
#.      - WIZARD(1) = False
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:91d9f2a9-bddf-a538-6e45-47bf8c12d868
msgctxt "hb4e54181g9a81g477bg96fcge3379d81a0dd"
msgid "I would rather acquaint myself - if you show me how."
msgstr "방법을 알려주면 내가 스스로 알아볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 96a4a2f2-f6df-c13e-37e2-7094dedcd06e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:96a4a2f2-f6df-c13e-37e2-7094dedcd06e
msgctxt "hd49832f3gee4eg4449ga2a8gf2ee9e0fc578"
msgid "May Shar guide your blessing hands."
msgstr "샤께서 축복으로 당신의 손을 인도하시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 9c531111-fcf2-e201-08b6-9c9559ca9b97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:9c531111-fcf2-e201-08b6-9c9559ca9b97
msgctxt "hfc734ce4g424ag47d5gb67cgc0a538ef6f6d"
msgid "Secrecy."
msgstr "은밀함."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = 9d12dcf3-345c-fd76-b5dc-1dc2a3ddfdde
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:9d12dcf3-345c-fd76-b5dc-1dc2a3ddfdde
msgctxt "h62e02ba9gbe48g4de9ga43bg8b5b797293da"
msgid ""
"I have read your treatise. Initiate the final lesson, or die by my hand."
msgstr "당신 논문 읽었어. 마지막 수업을 진행하든지, 내 손에 죽어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 9d1fa149-ed4b-4243-e61d-21d2b4069e0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:9d1fa149-ed4b-4243-e61d-21d2b4069e0b
msgctxt "h0464c4a8g6b83g40f6gaecag57dfa9da4882"
msgid ""
"It is a proud moment when one sees one's teachings so lovingly taken to "
"heart."
msgstr "가르친 걸 마음을 다해 이리 잘 새긴 제자들을 보면 참 뿌듯하다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 9d8f5101-92a2-1a1b-6dbb-8fd11085e9d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:9d8f5101-92a2-1a1b-6dbb-8fd11085e9d7
msgctxt "h08ec19b4g0001g494bg9e13g7123a54aa388"
msgid ""
"Go on. Acquaint the face of ignorance with the true object of our studies."
msgstr "어서. 저 무지한 자에게 우리 연구의 진정한 목적을 알려주세나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 9ee8d3a6-2f53-fbd4-aaf3-3814187bc28a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:9ee8d3a6-2f53-fbd4-aaf3-3814187bc28a
msgctxt "h5f34c510ga28eg46c6ga561ge6da73046647"
msgid "A curse? Nay, a cure that leads to the very pinnacle of being:"
msgstr "저주라니? 그럴 리가. 존재의 정점으로 향하는 치료라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = 9f6ddc94-f466-8948-0e9f-fe510ce78192
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:9f6ddc94-f466-8948-0e9f-fe510ce78192
msgctxt "h0df89843g1a46g42d5g898fg01d0b8565cbf"
msgid "I see now. By example I must edify and quell the light that blinds us."
msgstr "알겠다. 내가 본보기가 되어 우리 앞을 가로막는 빛을 잠재워야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = a0ddd0a7-d933-d1e9-8693-672844e0dc66
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:a0ddd0a7-d933-d1e9-8693-672844e0dc66
msgctxt "h78c10581g94acg491cgb80fgcc2a0b015451"
msgid ""
"I am not worthy! Please, show me how a master works - I would be honoured."
msgstr "내가 어찌 감히! 대가가 시범을 보여준다면 정말 영광일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = a1da61a2-022a-f4b8-19a2-b8f49d9692b9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:a1da61a2-022a-f4b8-19a2-b8f49d9692b9
msgctxt "h0f946a34g56f5g4f84gb1dbg5af40ae5f702"
msgid "The sisters require a willing volunteer, a master of the art."
msgstr "간호사들에게는 자발적 지원을 해줄 대가가 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = a38eead9-c759-aa67-bdbf-bcdc7507dc9f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:a38eead9-c759-aa67-bdbf-bcdc7507dc9f
msgctxt "h0922218fgc2d8g4e5eg9e3bg7464dee48955"
msgid "<i>Examine the sisters and their implements.</i>"
msgstr "<i>간호사와 도구를 살펴본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = a7f3afe8-f0b0-1051-65c1-b5496f695538
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:a7f3afe8-f0b0-1051-65c1-b5496f695538
msgctxt "h5e9d594bg736cg46e6g8528gf17929e564d0"
msgid "What say you to the master, sisters?"
msgstr "간호사 여러분, 교수님에게 할 말 있으신가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Narrator
#. NodeID = a9cd8744-77f0-8f51-4710-b36e9db210e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ac9c3420-a495-34da-8db7-367091a13044_PassedReligion = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:a9cd8744-77f0-8f51-4710-b36e9db210e4
msgctxt "h054c94a1gf2abg4f58ga459g3b313cf50133"
msgid ""
"*You remember a Sharran maxim: 'Go forth and sow doubt, but do not compel it "
"- for only the willing may know the Lady's embrace.'*"
msgstr "*샤 신앙의 격언 하나가 기억납니다. '나아가 의심을 심되, 강요는 하지 말라. 구하려는 자만이 여신의 은총을 알리라.'*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Gale
#. NodeID = ad502a6e-1e9d-4497-bac0-c6fcdaefa97d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_GALE(12) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:ad502a6e-1e9d-4497-bac0-c6fcdaefa97d
msgctxt "he0584690gf167g4a82gb3b8gc2d8cbfe6a7b"
msgid "Gods, what living nightmare is this?"
msgstr "이런, 악몽이 따로 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = ad7d68b3-c3b5-c8a9-cad7-2569bab104b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:ad7d68b3-c3b5-c8a9-cad7-2569bab104b8
msgctxt "hf02330b3g3b68g40dbg80d4g493af12e7293"
msgid "I am a scholar, this is true - just not in the study of torture."
msgstr "내가 학자인 건 맞아. 연구 분야가 고문은 아니지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = add2556f-15ee-5090-6083-fc703b02e64f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:add2556f-15ee-5090-6083-fc703b02e64f
msgctxt "ha3a369a1g82edg445fga8deg9cb96c101e34"
msgid "Precisely."
msgstr "그렇다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = af785672-5f3e-cc9b-c13f-3bc8a53c64c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:af785672-5f3e-cc9b-c13f-3bc8a53c64c8
msgctxt "haad31a99g9b07g43ffgb5f4g10f9c03551ae"
msgid "Tell me, what is the guiding principle of the goddess?"
msgstr "말해보게. 샤님의 핵심 교리가 뭔가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b10d8343-d5c6-e7dd-325b-eb723251536e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b10d8343-d5c6-e7dd-325b-eb723251536e
msgctxt "h64432e3cg1e7ag43e8g8aa1g600e6a5b088a"
msgid ""
"The objective of the scalpel, sisters, is to soothe, for the scalpel, "
"indeed, is an extension of Shar."
msgstr "자매들이여, 수술 칼은 고통을 더는 것이 목적이며, 그 자체가 샤님의 손길이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b15ed449-4ce7-5d3b-64af-44158cda445e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b15ed449-4ce7-5d3b-64af-44158cda445e
msgctxt "h2a60885fg85e0g4b4cg8a0fg3ecbc7202f20"
msgid ""
"Not altered, sister - <i>elevated</i>. Long have I basked in Shar's embrace. "
"A vessel of her will I have become."
msgstr "변한 게 아니네, 자매여. <i>진화</i>한 거지. 오래 샤님의 품에 안겨 있었네. 샤님의 의지를 담은 그릇이 된 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b24c25db-77b3-f4e3-3829-74d7f88c4e6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b24c25db-77b3-f4e3-3829-74d7f88c4e6c
msgctxt "h3c3fa86dg9d0eg4fb0gbc1fga84f7fa6b781"
msgid "Come, I will acquaint you with the Lady's dark-fingered embrace."
msgstr "오게, 샤님의 어둠의 손길에 깃든 은총을 알려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b3e5a475-68bb-05bd-1f5f-d2a5345a4ff6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR or REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b3e5a475-68bb-05bd-1f5f-d2a5345a4ff6
msgctxt "hd904fb73g3239g44cbgbf5cg86ba43246e5c"
msgid ""
"Come. Step forward. I can see the love of Shar darken your eyes. Be welcome."
msgstr "앞으로 오시게. 눈에 샤님의 사랑이 주신 어둠이 보이는군. 환영하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = b3f583d7-4065-4609-a56d-3292124925d0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b3f583d7-4065-4609-a56d-3292124925d0
msgctxt "h40c97fa3g2c15g43e9g9990g110cdd8dba68"
msgid ""
"Practice - that's how I got good with a blade. They should spar each other."
msgstr "연습이지. 나도 그렇게 칼을 잘 다루게 됐고. 서로 겨루게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b697fc83-0be5-5081-2aa3-bb33b797177a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b697fc83-0be5-5081-2aa3-bb33b797177a
msgctxt "hde82f049g1ae8g4320g9c25g3454e8d2c6b2"
msgid "Absence. No other word captures the heart of Shar so very perfectly."
msgstr "부재. 이보다 샤님의 마음을 완벽히 표현하는 말은 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b6c16547-1024-f3c2-06ae-21b4f6543d0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b6c16547-1024-f3c2-06ae-21b4f6543d0b
msgctxt "hfe60533cg7af8g4933gb7b8gec797d981500"
msgid "I profess there is another more profound."
msgstr "더 큰 가르침이 있다는 걸 알려주고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = b77872ec-0c71-6348-8469-646016090d74
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b77872ec-0c71-6348-8469-646016090d74
msgctxt "h930bc527gc291g4ea9g87bdg1a9b423611ac"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = b8cc005d-7bd0-18d7-4f4c-0696ad411abd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_KnowsSurgeonTeachingMethods = False
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b8cc005d-7bd0-18d7-4f4c-0696ad411abd
msgctxt "h5b33c5a3gc44dg420dg9b84g8ca8bb3d32c6"
msgid ""
"In my years of study, I have found no better teacher than example. Perhaps "
"<i>you</i> could volunteer?"
msgstr "내가 공부할 때는, 사례보다 더 좋은 가르침이 없더라고. <i>직접</i> 모범을 보이지 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b995c48e-7014-a5ce-4eb7-10f2f1ba824c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b995c48e-7014-a5ce-4eb7-10f2f1ba824c
msgctxt "h51a9bc67ge77cg4b56g8ea2g4d85b41002fa"
msgid ""
"Oh, but the final lesson is hardly at hand. Would you deny my sisters the "
"full breadth of my teachings?"
msgstr "아, 아직 마지막 수업을 할 때는 아니라네. 우리 자매들이 내 가르침을 다 못 받게 하려는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = b9e379eb-99c4-6c2e-7a01-e43df3b9493c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:b9e379eb-99c4-6c2e-7a01-e43df3b9493c
msgctxt "hd713f48cg1e9bg4334gbc71g0e56dde494c5"
msgid "We do not wish to see you suffer so. Let us cure you."
msgstr "그런 고통을 우리가 놔둘 수는 없지. 치료해주겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = bc1d01ca-4b0b-929c-3156-4027ea05bced
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(CLERIC_SHAR and PALADIN_SHAR and REALLY_SHADOWHEART)
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:bc1d01ca-4b0b-929c-3156-4027ea05bced
msgctxt "hd7a9f44fg08f6g453fg98f0g42bf4473fe71"
msgid ""
"Come. Step forward. You are no sister, but that matters none. Every student "
"is welcome."
msgstr "앞으로 오시게. 자매는 아니지만 아무 상관 없지. 어떤 학생이든 환영한다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = bd1d3255-d45b-ef3c-7679-eeaff760ce0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:bd1d3255-d45b-ef3c-7679-eeaff760ce0d
msgctxt "h047b1f1fg24e2g4b20gb2a4gf65ccbdce555"
msgid "Yes. Submit I must, into the Lady's dark-fingered embrace."
msgstr "그래. 샤님께서 어둠의 손길로 주신 은총에 나를 바쳐야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = bf3672c9-bda4-457d-07d0-e0acbfe91651
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:bf3672c9-bda4-457d-07d0-e0acbfe91651
msgctxt "h3f388cb3gac63g4ed2g91b8g933012088c5b"
msgid ""
"Stop. Stay your hand, for it slaps where it should stroke. We can hardly "
"hear the patient's sighs of solace."
msgstr "그만. 멈추게. 칼을 그어야지 때리면 쓰나. 환자의 안도의 한숨이 안 들리잖나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = bfb9f6a4-9097-f103-194e-01b28bb93194
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:bfb9f6a4-9097-f103-194e-01b28bb93194
msgctxt "h4aef8ecfgd620g4fc0gb5b3gd37fe7b857a4"
msgid ""
"Another absence is your fate? But if you are not here to be cured, how will "
"my sisters learn?"
msgstr "또 다른 부재가 자네 운명인가? 치료받으러 온 게 아니라면 우리 자매들은 뭘로 배운단 말인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = c3a83302-ebfc-d6d6-4cb5-40969bf13cb1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:c3a83302-ebfc-d6d6-4cb5-40969bf13cb1
msgctxt "h25d48a1fg83e4g4368g9fe8g60eb73509737"
msgid "Oh but hush. Hold still. Let there be an end to your suffering."
msgstr "헛소린 그만하시죠. 가만히 계세요. 고통을 없애 드리겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = c6bb5bef-43bd-9484-d669-b767d670335e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:c6bb5bef-43bd-9484-d669-b767d670335e
msgctxt "h71f1112cg79bag4522gbb60gca74f8a3f5e1"
msgid ""
"The scalpel does not discriminate. Let each and every one of you partake in "
"its soothing journey."
msgstr "칼은 사람을 가리지 않지. 각자 모두가 고통에서 해방되는 여정에 참여하도록 하시게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = c7e1bc23-849e-eee4-9773-56dc398c69a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ac9c3420-a495-34da-8db7-367091a13044_PassedInvestigation = True
#. TagRule: ROGUE
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:c7e1bc23-849e-eee4-9773-56dc398c69a4
msgctxt "h95fd6ca2g36d6g4a54g9d84g2e921eabca62"
msgid ""
"Your blades are in an atrocious condition - no way you'd make a clean cut "
"with those."
msgstr "칼 상태가 끔찍한데. 그런 걸로 깔끔하게 잘릴 리가 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = c7e1bc23-849e-eee4-9773-56dc398c69a4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ac9c3420-a495-34da-8db7-367091a13044_PassedInvestigation = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:c7e1bc23-849e-eee4-9773-56dc398c69a4
msgctxt "h172ab571g76efg41f8gbe03g5849fb64f30c"
msgid ""
"Their blades are uneven. Efficient surgery will require further training."
msgstr "수녀들 칼이 삐뚤어졌어. 효율적으로 수술하려면 연습 더 해야겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = c8979044-d622-08d1-0ee8-420306982529
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:c8979044-d622-08d1-0ee8-420306982529
msgctxt "hd1a2afd8g79fcg4921g9a34g21e83fa1a5d1"
msgid "Absence."
msgstr "부재."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = c9aaf765-e507-70c9-f5b3-4a325a051f5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:c9aaf765-e507-70c9-f5b3-4a325a051f5d
msgctxt "h4fabe3d7g1639g4c76g8761gcdb1a48a741f"
msgid "I will make you intimately familiar."
msgstr "아주 익숙하게 만들어 주겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = cda30967-30bb-5be0-e1df-7c5a0217de21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:cda30967-30bb-5be0-e1df-7c5a0217de21
msgctxt "he89dfaddg52b8g42dbgb6dfgfff2f46cce17"
msgid ""
"Their incisions are, as yet, still streaked with imprecision - that much I "
"must concede."
msgstr "자매들의 절개술이 아직은 많이 미숙하지. 그건 인정하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = d38c42a1-794d-e2e5-3b1a-90ae48d2aaa3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Hospital_State_HostileResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:d38c42a1-794d-e2e5-3b1a-90ae48d2aaa3
msgctxt "hd475809bg81c5g442egb95fge7ac7fdd0b5b"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Astarion
#. NodeID = d7802546-57cf-4537-9e6d-649f8efd1318
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_ASTARION(10) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:d7802546-57cf-4537-9e6d-649f8efd1318
msgctxt "hc2a79daeg7037g4076gbbfcg90d6b1ac5f14"
msgid "He's just like Cazador - utterly insane."
msgstr "카사도어랑 똑같네. 완전히 미쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = dc49d7b5-5ce5-8f55-7896-c8344c851af3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:dc49d7b5-5ce5-8f55-7896-c8344c851af3
msgctxt "hac8356dfg9441g4f14gbb6eg1cba04639705"
msgid "Pray, sister, show us the extent of your beneficence."
msgstr "부탁하네, 자매여. 있는 힘껏 선행을 베풀어 주게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Narrator
#. NodeID = dfb2c0f6-cce7-af82-5ced-3099159457ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:dfb2c0f6-cce7-af82-5ced-3099159457ba
msgctxt "h2e97b144gafd0g47a6g9d46g17bb2a44a524"
msgid "*You note nothing unusual about the sisters, aside from their menace.*"
msgstr "*무섭다는 것 외에 간호사에게 이상한 점은 안 보이네요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = ee56d32f-4492-4579-c08b-ff74b3356b26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:ee56d32f-4492-4579-c08b-ff74b3356b26
msgctxt "h49b7ac89g04a1g41bcg96acgd0ed49297d53"
msgid ""
"Behold, sisters, the very face of ignorance - one who mistakes tenderness "
"for torture."
msgstr "자매들이여, 보게. 고문과 친절함을 착각하는, 무지한 저 얼굴을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = f3f18524-912e-e999-c340-b111b4df1f4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:f3f18524-912e-e999-c340-b111b4df1f4e
msgctxt "h86a1540dg1b05g4daeg9a7ag822027fd489d"
msgid "I confess I'm unfamiliar with the ritual you're practising."
msgstr "사실 지금 하는 의식이 나에게는 생소한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = f4667701-c114-7f42-21e7-80b8900500b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:f4667701-c114-7f42-21e7-80b8900500b6
msgctxt "hf0186844g66fdg4cc0g9c2dg3e1da89dec85"
msgid "Forgetfulness."
msgstr "망각."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = f5510350-fa87-d06a-4930-20221cd5d1da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:f5510350-fa87-d06a-4930-20221cd5d1da
msgctxt "hc1fc813dgffadg47acg8924g597a464eac1d"
msgid "How to proceed, I wonder."
msgstr "어떻게 진행해야 할지 모르겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = f73c27fe-8ea8-feb1-52cd-40afac8b77ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:f73c27fe-8ea8-feb1-52cd-40afac8b77ce
msgctxt "hba55bbedg1f8bg488cgb9f1gbd80c8b7f6a9"
msgid ""
"I am no student, I seek knowledge of the curse. It is a blight on this land."
msgstr "학생은 아니고, 저주에 관한 정보를 찾고 있다. 이 땅을 좀먹고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Player
#. NodeID = f809b098-ef5d-6584-a639-dd8865f0df7c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:f809b098-ef5d-6584-a639-dd8865f0df7c
msgctxt "h30d8bb2cg6a8bg4d34g9b1fgd34a58a3cf66"
msgid "<i>Recall what you know of Shar's teachings.</i>"
msgstr "<i>샤의 가르침에 대해 아는 걸 떠올린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon
#. Speaker = Malus Thorm
#. NodeID = fd94f30f-1384-6a65-7733-a3598199945b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Surgeon:fd94f30f-1384-6a65-7733-a3598199945b
msgctxt "hcd0d44f5g661dg4f62g86c4g62cd13e19e29"
msgid "Hush. Fret not so. You are quite ready, aren't you, sisters?"
msgstr "조용. 그리 걱정 말게. 준비는 다 됐잖은가, 자매들이여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000
#. Speaker = Sister Hunna
#. NodeID = ce670348-8976-e7ed-e7f2-fc58e520bf9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_HasMet_Nurse000(1) = False
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#. SetFlags:
#.   Dialog:
#.     - TWN_Hospital_HasMet_Nurse000(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000:ce670348-8976-e7ed-e7f2-fc58e520bf9e
msgctxt "hd87bca0cg605ag4c4bg94aeg7cb7c2aa4f91"
msgid "The great cure. Final, final. Forever."
msgstr "위대한 치료제. 최후에, 최후에. 영원히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000
#. Speaker = Sister Hunna
#. NodeID = fa20d058-7880-69c0-76b7-f33eda5916bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_HasMet_Nurse000(1) = True
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000:fa20d058-7880-69c0-76b7-f33eda5916bb
msgctxt "hbe1ca2afg5f6fg40acgb8f9gfc485a2bc0d8"
msgid "He is... absent. At peace."
msgstr "그는... 부재해요. 안식해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000
#. Speaker = Sister Hunna
#. NodeID = fddc0bd7-d587-46db-734e-48768f6da865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000:fddc0bd7-d587-46db-734e-48768f6da865
msgctxt "h584f98a7ge598g4ee9g822ege505af2428ab"
msgid "Loss... shadows... yes, yes."
msgstr "상실... 그림자... 그래요, 그래요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000_AD
#. Speaker = Sister Hunna
#. NodeID = 1c067965-a46d-49cd-bc81-83bd145f2c1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#.   Local:
#.      - 37bcd3f0-13ae-c327-1fd3-4c07bb84eee4_C = True
#. SetFlags:
#.   Local:
#.     - 37bcd3f0-13ae-c327-1fd3-4c07bb84eee4_A = False
#.     - 37bcd3f0-13ae-c327-1fd3-4c07bb84eee4_B = False
#.     - 37bcd3f0-13ae-c327-1fd3-4c07bb84eee4_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000_AD:1c067965-a46d-49cd-bc81-83bd145f2c1b
msgctxt "h6c07edd3g75bcg4b9agae29gcd24e791d016"
msgid "The gift of... nothing. Her gift."
msgstr "무의... 선물. 그녀의 선물."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000_AD
#. Speaker = Sister Hunna
#. NodeID = 3fa4ab1d-9521-4f7d-97d0-aa2251d6e978
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_SurgeonPermaDefeated = True
#.   Local:
#.      - 37bcd3f0-13ae-c327-1fd3-4c07bb84eee4_A = True
#. SetFlags:
#.   Local:
#.     - 37bcd3f0-13ae-c327-1fd3-4c07bb84eee4_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000_AD:3fa4ab1d-9521-4f7d-97d0-aa2251d6e978
msgctxt "hd4e34d59g587bg45c4gae2bg93f4f151b96c"
msgid "Absence, there is... cure. Cure."
msgstr "부재, 거기에... 치료제. 치료제."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_000_AD
#. Speaker = Sister Hunna
#. NodeID = 6930b826-e838-3dd7-1002-d45f06827f52
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
