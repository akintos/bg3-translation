msgctxt "h2140a72dgcbb3g487dg9607g09a557a1a87c"
msgid "Can you understand me?"
msgstr "내 말을 이해하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Merregon_002
#. Speaker = Narrator
#. NodeID = 938b8c2b-d5af-4321-80d3-f338250e7362
