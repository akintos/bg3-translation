msgctxt "h54d7b233g68efg418cgaf71g04e14dd4c35b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 8f241f76-1c29-0888-57a0-f8fd2ba2af32
#. HandlePath = TaggedText[0].TagText[0]
